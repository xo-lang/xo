use std/json

/// A user profile as served by the profile API.
pub struct Profile {
  pub id: Int
  pub name: Str
  pub email: Str?
} derive Json

/// Errors from `fetch_profile`.
pub enum ProfileErr {
  /// The HTTP request failed (after retries).
  Fetch(from FetchErr)
  /// The body was not a valid profile.
  Decode(from json.DecodeErr)
}

pub fn (e: ProfileErr) display() -> Str {
  match e {
    Fetch(inner) => "fetch profile: ${inner}"
    Decode(inner) => "decode profile: ${inner}"
  }
}

/// Loads the profile of `user_id` from `${base_url}/users/${user_id}`.
pub fn fetch_profile(
  net: Net,
  clock: Clock,
  rand: Rand,
  base_url: Str,
  user_id: Int,
  policy: RetryPolicy = RetryPolicy{},
) -> Profile ! ProfileErr
  uses (net.dial, clock, rand)
  requires user_id > 0
{
  let body = get_with_retry(net, clock, rand, "${base_url}/users/${user_id}", policy)?
  json.decode[Profile](body)?
}
