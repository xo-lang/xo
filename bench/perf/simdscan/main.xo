// simdscan: the byte-heavy std paths a SIMD survey ranks (Xo Lang 1,
// 2026-11-06), each over 64 buffers of 4 KiB (and a 64 byte variant where
// short inputs matter), against Go (twin.go.txt). Usage: `<program>
// WORKLOAD`; prints `<workload> <checksum>`, the same line as the twin.
use std/base64
use std/crc32
use std/crypto


fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

/// n bytes: ASCII letters, or with mixed set every 7th byte a 2 or 3 byte
/// UTF-8 sequence.
fn buf(seed: Int, n: Int, mixed: Bool) -> Bytes {
  var r = seed
  var bb = BytesBuilder.with_capacity(n + 4)
  var k = 0
  while k < n {
    r = next(r)
    if mixed && (r >> 8) % 7 == 0 {
      let t = if (r >> 12) % 2 == 0 { "é" } else { "日" }
      bb.write_str(t)
      k += t.len()
    } else {
      bb.write_byte(UInt8(97 + (r >> 8) % 26))
      k += 1
    }
  }
  bb.freeze()[0..n]
}

fn bufs(n: Int, mixed: Bool) -> List[Bytes] {
  var out: List[Bytes] = []
  for i in 0..64 {
    out.push(buf(i + 1, n, mixed))
  }
  out
}

/// big's buffers as text with the byte c at every k-th place: lines (c
/// a newline every 80 bytes) and fields (a comma every 6 or 200 bytes).
fn seps(big: List[Bytes], k: Int, c: Int) -> List[Str] {
  var out: List[Str] = []
  for b in big {
    var bb = BytesBuilder.with_capacity(b.len())
    for (i, x) in b.indexed() {
      bb.write_byte(if i % k == k - 1 { UInt8(c) } else { x })
    }
    out.push(bb.freeze().to_str() ?? "")
  }
  out
}

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "none"
  // passes: the second argument, 400 by default
  let passes = Int.parse(os.env.args().get(1) ?? "400") ?? 400
  let big = bufs(4096, false)
  let mix = bufs(4096, true)
  let small = bufs(64, false)
  var sum = 0
  match w {
    "utf8_ascii" => {
      for _ in 0..passes {
        for b in big {
          sum += if b.to_str().is_some() { 1 } else { 0 }
        }
      }
    }
    "utf8_mixed" => {
      for _ in 0..passes {
        for b in mix {
          sum += if b.to_str().is_some() { 1 } else { 0 }
        }
      }
    }
    "index_byte" => {
      // absent: the whole buffer is scanned
      for _ in 0..passes {
        for b in big {
          sum += b.find(b"#") ?? -1
        }
      }
    }
    "index_byte_64" => {
      for _ in 0..passes * 32 {
        for b in small {
          sum += b.find(b"#") ?? -1
        }
      }
    }
    "equal" => {
      var copies: List[Bytes] = []
      for b in big {
        var cb = BytesBuilder.with_capacity(b.len())
        cb.write(b)
        copies.push(cb.freeze())
      }
      for _ in 0..passes {
        for (i, b) in big.indexed() {
          sum += if b == copies[i] { 1 } else { 0 }
        }
      }
    }
    "compare" => {
      // the same text but the last byte
      var ss: List[Str] = []
      var ts: List[Str] = []
      for b in big {
        ss.push(b.to_str() ?? "")
        ts.push((b[0..b.len() - 1].to_str() ?? "") + "~")
      }
      for _ in 0..passes {
        for (i, s) in ss.indexed() {
          sum += if s < ts[i] { 1 } else { 0 }
        }
      }
    }
    "fold" => {
      // ASCII case insensitive equality of a buffer and its upper case
      var ups: List[Bytes] = []
      for b in big {
        ups.push(b.to_upper())
      }
      for _ in 0..passes {
        for (i, b) in big.indexed() {
          sum += if b.equal_fold(ups[i]) { 1 } else { 0 }
        }
      }
    }
    "fold_32" => {
      // header name sized: 32 bytes
      var lows: List[Bytes] = []
      var ups: List[Bytes] = []
      for b in small {
        lows.push(b[0..32])
        ups.push(b[0..32].to_upper())
      }
      for _ in 0..passes * 64 {
        for (i, b) in lows.indexed() {
          sum += if b.equal_fold(ups[i]) { 1 } else { 0 }
        }
      }
    }
    "lower" => {
      var ups: List[Bytes] = []
      for b in big {
        ups.push(b.to_upper())
      }
      for _ in 0..passes / 4 {
        for b in ups {
          sum += Int(b.to_lower()[7])
        }
      }
    }
    "hex" => {
      for _ in 0..passes / 4 {
        for b in big {
          sum += b.to_hex().len()
        }
      }
    }
    "base64_enc" => {
      for _ in 0..passes / 4 {
        for b in big {
          sum += base64.encode(b).len()
        }
      }
    }
    "base64_dec" => {
      var es: List[Str] = []
      for b in big {
        es.push(base64.encode(b))
      }
      for _ in 0..passes / 4 {
        for e in es {
          sum += (base64.decode(e).ok() ?? b"").len()
        }
      }
    }
    "crc32" => {
      for _ in 0..passes {
        for b in big {
          sum += crc32.checksum(b) % 1000003
        }
      }
    }
    "sha256" => {
      for _ in 0..passes / 8 {
        for b in big {
          sum += Int(crypto.sha256(b)[0])
        }
      }
    }
    "sha1" => {
      for _ in 0..passes / 8 {
        for b in big {
          sum += Int(crypto.digest(crypto.Hash.Sha1, b)[0])
        }
      }
    }
    "sha512" => {
      for _ in 0..passes / 8 {
        for b in big {
          sum += Int(crypto.digest(crypto.Hash.Sha512, b)[0])
        }
      }
    }
    "hmac256" => {
      // short messages: each MAC is single block writes (the pads)
      let key = b"0123456789abcdef0123456789abcdef"
      for _ in 0..passes {
        for b in big {
          sum += Int(crypto.hmac_sha256(key, b[0..32])[0])
        }
      }
    }
    "find_common" => {
      // an absent needle whose first byte is a common letter (a start
      // to test every 26 bytes) and one whose first byte never occurs
      let ts = seps(big, 1000000, 32)
      for _ in 0..passes {
        for t in ts {
          sum += if t.contains("ezzzq") { 1 } else { 0 }
        }
      }
    }
    "find_rare" => {
      let ts = seps(big, 1000000, 32)
      for _ in 0..passes {
        for t in ts {
          sum += if t.contains("#needle") { 1 } else { 0 }
        }
      }
    }
    "count_nl" => {
      let ts = seps(big, 80, 10)
      for _ in 0..passes {
        for t in ts {
          sum += t.count("\n")
        }
      }
    }
    "count_dense" => {
      let ts = seps(big, 6, 44)
      for _ in 0..passes / 4 {
        for t in ts {
          sum += t.count(",")
        }
      }
    }
    "count_rare" => {
      let ts = seps(big, 1000000, 10)
      for _ in 0..passes {
        for t in ts {
          sum += t.count("\n")
        }
      }
    }
    "split_csv" => {
      let ts = seps(big, 6, 44)
      for _ in 0..passes / 4 {
        for t in ts {
          sum += t.split(",").len()
        }
      }
    }
    "split_long" => {
      let ts = seps(big, 200, 44)
      for _ in 0..passes {
        for t in ts {
          sum += t.split(",").len()
        }
      }
    }
    "quote" => {
      // strconv.Quote of printable ASCII: one run of span class 1
      var ss: List[Str] = []
      for b in big {
        ss.push(b.to_str() ?? "")
      }
      for _ in 0..passes {
        for s in ss {
          sum += s.quote().len()
        }
      }
    }
    "rune_count" => {
      // utf8.RuneCountInString of mixed text: a count of continuation bytes
      var ss: List[Str] = []
      for b in mix {
        ss.push(b.to_str() ?? "")
      }
      for _ in 0..passes {
        for s in ss {
          sum += s.rune_count()
        }
      }
    }
    _ => {}
  }
  os.stdio.println("${w} ${sum}")
}
