// Many short tasks in a scope: 200 rounds of 1000 tasks whose handles
// are discarded, each adding to an Atomic (spawn and join overhead).
fn work() -> Str {
  let count = Atomic[Int].new(0)
  for _ in 0..200 {
    scope s {
      for i in 0..1000 {
        s.spawn(fn() { count.add(i) })
      }
    }
  }
  "spawn ${count.get()}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
