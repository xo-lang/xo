// Fan out and join: 100 rounds of 1000 tasks returning a value, each
// handle awaited in order and summed.
fn work() -> Str {
  var total = 0
  for r in 0..100 {
    let sum = scope s {
      var hs: List[Task[Int, Never]] = []
      for i in 0..1000 {
        hs.push(s.spawn(fn() { i * 2 + r }))
      }
      var acc = 0
      for h in hs {
        acc += h.await
      }
      acc
    }
    total += sum
  }
  "fanout ${total}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
