// A parallel map: 20 rounds of mapping 0..200,000 through a Collatz step
// count in 64 chunks, one task per chunk, results awaited and summed.
fn steps(x: Int) -> Int {
  var n = x
  var c = 0
  while n > 1 {
    if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
    c += 1
  }
  c
}

fn work() -> Str {
  let size = 200000
  let chunks = 64
  var total = 0
  for r in 0..20 {
    let sum = scope s {
      var hs: List[Task[Int, Never]] = []
      for k in 0..chunks {
        hs.push(s.spawn(fn() {
          var acc = 0
          var i = k * size / chunks
          let hi = (k + 1) * size / chunks
          while i < hi {
            acc += steps(i + r)
            i += 1
          }
          acc
        }))
      }
      var acc = 0
      for h in hs {
        acc += h.await
      }
      acc
    }
    total += sum
  }
  "pmap ${total}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
