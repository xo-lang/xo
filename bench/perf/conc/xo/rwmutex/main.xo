// A contended readers and writer lock: 64 tasks each make 4,000
// accesses, one in four a write that holds the lock for a Collatz step
// count (about 111 steps), the others reads. Waiters park, so this
// measures waking (decisions 0082, 0118), not just the uncontended path.
fn steps(x: Int) -> Int {
  var n = x
  var c = 0
  while n > 1 {
    if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
    c += 1
  }
  c
}

fn work() -> Str {
  let m = Mutex[Int].new(0)
  let odd = Atomic[Int].new(0)
  scope s {
    for t in 0..64 {
      s.spawn(fn() {
        for i in 0..4000 {
          if (i + t) % 4 == 0 {
            m.with(fn(var c) { c += 1 + steps(27 + c % 2) / 1000 })
          } else {
            let v = m.with_read(fn(c) { c })
            if v < 0 { odd.add(1) }
          }
        }
      })
    }
  }
  let n = m.with_read(fn(c) { c })
  "rwmutex ${n} ${odd.get()}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
