// Collection performance workloads. Usage: perf <workload>
// Each workload prints "<workload> <checksum> <elapsed microseconds>"; the checksum
// must match the Go version in ../go.

const N = 3000000
const KEYS = 50000

fn build(n: Int) -> Map[Int, Int] {
  var m: Map[Int, Int] = {}
  for i in 0..n {
    m.put(i, i)
  }
  m
}

fn put_get() -> Int {
  var m: Map[Int, Int] = {}
  for i in 0..N {
    m.put(i % KEYS, i)
  }
  var sum = 0
  for i in 0..N {
    sum += m.get(i % KEYS) ?? 0
  }
  sum
}

fn get_only(m: Map[Int, Int]) -> Int {
  var sum = 0
  for i in 0..N {
    sum += m.get(i % KEYS) ?? 0
  }
  sum
}

fn push_sum() -> Int {
  var xs: List[Int] = []
  for i in 0..N {
    xs.push(i)
  }
  var sum = 0
  for x in xs {
    sum += x
  }
  sum
}

fn update_loop() -> Int {
  var m: Map[Int, Int] = {}
  for i in 0..N {
    m.update(i % KEYS, 0, fn(var v) { v += 1 })
  }
  m.get(7) ?? 0
}

fn iterate(m: Map[Int, Int]) -> Int {
  var sum = 0
  for _ in 0..60 {
    for (k, v) in m {
      sum += k + v
    }
  }
  sum
}

// Copy a 50k map, mutate every key of the copy, read every key of the
// original; ten rounds from the same original.
fn copy_mutate(m: Map[Int, Int]) -> Int {
  var sum = 0
  for _ in 0..10 {
    var c = m
    for k in 0..KEYS {
      c.put(k, k * 2)
    }
    for k in 0..KEYS {
      sum += m.get(k) ?? 0
    }
    sum += c.get(KEYS - 1) ?? 0
  }
  sum
}

// Many one-key branches from the same 50k map.
fn branch(m: Map[Int, Int]) -> Int {
  var sum = 0
  for i in 0..2000 {
    var c = m
    c.put(KEYS + i, i)
    sum += c.len() + (c.get(i) ?? 0)
  }
  sum
}


// ---------------------------------------------------------------------------
// List writes (bench/results/perf-list-2026-10-08.md)

const LN = 50000

fn sum_list(xs: List[Int]) -> Int {
  var t = 0
  for x in xs {
    t += x
  }
  t
}

// 3M element reads and writes of a 50k list.
fn set_at() -> Int {
  var xs: List[Int] = []
  for i in 0..LN {
    xs.push(i)
  }
  for i in 0..N {
    xs[i % LN] = xs[(i * 7) % LN] + i % 13
  }
  sum_list(xs)
}

// A stack: 2M pushes and 1M pops interleaved.
fn stack() -> Int {
  var xs: List[Int] = []
  var sum = 0
  for i in 0..N {
    if i % 3 == 2 {
      sum += xs.pop() ?? 0
    } else {
      xs.push(i)
    }
  }
  sum + xs.len()
}

struct Particle {
  x: Int
  y: Int
  vx: Int
  vy: Int
  mass: Int
}

// 3M field updates of elements of a list of 1000 structs.
fn fields() -> Int {
  var ps: List[Particle] = []
  for i in 0..1000 {
    ps.push(Particle{x: i, y: 0, vx: i % 7, vy: 1, mass: 1})
  }
  for i in 0..N {
    let j = i % 1000
    ps[j].x += ps[j].vx
    ps[(i * 13) % 1000].y = ps[j].x % 1000
  }
  var sum = 0
  for p in ps {
    sum += p.x + p.y
  }
  sum
}

// 3M writes into a 300 x 300 List[List[Int]], plus 300 row pushes.
fn grid() -> Int {
  var g: List[List[Int]] = []
  for i in 0..300 {
    var row: List[Int] = []
    for j in 0..300 {
      row.push(i + j)
    }
    g.push(row)
  }
  for i in 0..N {
    g[i % 300][(i * 7) % 300] += 1
  }
  for i in 0..300 {
    g[i].push(i)
  }
  var sum = 0
  for row in g {
    sum += sum_list(row)
  }
  sum
}

// 20k inserts into the middle of a growing list, then 20k removals from
// the middle: O(n) shifts, as on a Go slice.
fn ins_rem() -> Int {
  var xs: List[Int] = []
  for i in 0..20000 {
    xs.insert(xs.len() / 2, i)
  }
  var sum = 0
  for _ in 0..20000 {
    sum += xs.remove_at(xs.len() / 2)
  }
  sum + xs.len()
}

// 200 rounds: copy a 50k list, write one element of the copy, read the
// original: each write after a copy copies the list once (Go: a clone).
fn copy_set() -> Int {
  var base: List[Int] = []
  for i in 0..LN {
    base.push(i)
  }
  var sum = 0
  for r in 0..200 {
    var c = base
    c[r] = -1
    c[r + 1] = -2
    sum += base[r] + c[r] + c.len()
  }
  sum
}

// ---------------------------------------------------------------------------
// Generic workloads (bench/results/perf-mono-2026-10-08.md)

const SORT_N = 5000
const LOOKUPS = 3000000
const HOF_N = 1000000

fn lcg(s: Int) -> Int { (s * 1103515245 + 12345) % 2147483648 }

// A sorted container over any Ord type: binary search, sorted insert.
struct Sorted[T: Ord] {
  items: List[T]
}

fn (s: Sorted[T]) search(x: T) -> Int {
  var lo = 0
  var hi = s.items.len()
  while lo < hi {
    let mid = (lo + hi) / 2
    if s.items[mid] < x {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo
}

fn (var s: Sorted[T]) insert(x: T) {
  let i = s.search(x)
  s.items.insert(i, x)
}

fn (s: Sorted[T]) contains(x: T) -> Bool {
  let i = s.search(x)
  i < s.items.len() && s.items[i] == x
}

struct Point {
  x: Int
  y: Int
} derive Ord

fn sorted_int() -> Int {
  var s = Sorted[Int]{items: []}
  var seed = 1
  for _ in 0..SORT_N {
    seed = lcg(seed)
    s.insert(seed % 1000000)
  }
  var found = 0
  for _ in 0..LOOKUPS {
    seed = lcg(seed)
    if s.contains(seed % 1000000) {
      found += 1
    }
  }
  found * 1000000 + s.items.len()
}

fn sorted_point() -> Int {
  var s = Sorted[Point]{items: []}
  var seed = 1
  for _ in 0..SORT_N {
    seed = lcg(seed)
    let r = seed % 1000000
    s.insert(Point{x: r % 1000, y: r / 1000})
  }
  var found = 0
  for _ in 0..LOOKUPS {
    seed = lcg(seed)
    let r = seed % 1000000
    if s.contains(Point{x: r % 1000, y: r / 1000}) {
      found += 1
    }
  }
  found * 1000000 + s.items.len()
}

fn hof_chain(xs: List[Int]) -> Int {
  var sum = 0
  for _ in 0..10 {
    sum += xs.map(fn(x) { x * 3 }).filter(fn(x) { x % 2 == 0 }).fold(0, fn(a, x) { a + x })
  }
  sum
}

struct Item {
  id: Int
  score: Int
  name: Str
}

fn max_by[T, K: Ord](xs: List[T], key: fn(T) -> K) -> T? {
  let first = xs.first()?
  var best = first
  var best_k = key(best)
  for x in xs {
    let k = key(x)
    if k > best_k {
      best = x
      best_k = k
    }
  }
  best
}

fn max_by_loop(items: List[Item]) -> Int {
  var sum = 0
  for i in 0..20 {
    let by_score = max_by(items, fn(it) { it.score })
    let by_name = max_by(items, fn(it) { it.name })
    if let Some(a) = by_score {
      sum += a.id
    }
    if let Some(b) = by_name {
      sum += b.id
    }
    sum += i
  }
  sum
}

interface Shape {
  fn area(self) -> Int
}

struct Rect {
  w: Int
  h: Int
}

fn (r: Rect) area() -> Int { r.w * r.h }

fn total_area[T: Shape](xs: List[T]) -> Int {
  var s = 0
  for x in xs {
    s += x.area()
  }
  s
}

fn iface_loop(rects: List[Rect]) -> Int {
  var sum = 0
  for _ in 0..20 {
    sum += total_area(rects)
  }
  sum
}

fn main(os: Os) {
  let args = os.env.args()
  let w = args.get(0) ?? "putget"
  let base = build(KEYS)
  var ints: List[Int] = []
  var items: List[Item] = []
  var rects: List[Rect] = []
  match w {
    "hof" => {
      for i in 0..HOF_N {
        ints.push(i)
      }
    }
    "maxby" => {
      var seed = 7
      for i in 0..HOF_N {
        seed = lcg(seed)
        items.push(Item{id: i, score: seed % 1000003, name: "n${seed % 999983}"})
      }
    }
    "iface" => {
      for i in 0..HOF_N {
        rects.push(Rect{w: i % 100, h: i % 37})
      }
    }
    _ => {}
  }
  let t = os.clock.now()
  let sum = match w {
    "putget" => put_get()
    "get" => get_only(base)
    "push" => push_sum()
    "update" => update_loop()
    "iter" => iterate(base)
    "copymut" => copy_mutate(base)
    "branch" => branch(base)
    "sortint" => sorted_int()
    "sortpt" => sorted_point()
    "hof" => hof_chain(ints)
    "maxby" => max_by_loop(items)
    "iface" => iface_loop(rects)
    "setat" => set_at()
    "stack" => stack()
    "fields" => fields()
    "grid" => grid()
    "insrem" => ins_rem()
    "copyset" => copy_set()
    _ => -1
  }
  let us = os.clock.since(t).nanos() / 1000
  os.stdio.println("${w} ${sum} ${us}")
}
