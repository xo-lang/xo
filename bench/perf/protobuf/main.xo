// protobuf: std/protobuf (derive Proto) on a 12 KB document (150 records of ints, bytes, text,
// repeated text, doubles, a bool and a nested message with a repeated and an optional field, built
// by the generated Go code of the twin), 1000 passes, against google.golang.org/protobuf with
// protoc-gen-go output (twin.go.txt).
// Usage: `<program> unmarshal|marshal|none` (unmarshal decodes the document each pass; marshal
// writes it once decoded; none: the setup alone).
// Prints `<workload> <checksum>`; the twin prints the same.
use std/protobuf

struct Nested {
  a proto "1": Int
  b proto "2": List[Int]
  c proto "3": Int?
} derive Proto

struct Rec {
  id proto "1": Int
  blob proto "2": Bytes
  name proto "3": Str
  tags proto "4": List[Str]
  ratio proto "5": Float
  score proto "6": Float
  active proto "7": Bool
  nested proto "8": Nested
} derive Proto

struct Doc {
  title proto "1": Str
  records proto "2": List[Rec]
} derive Proto

fn doc() -> Bytes {
  Bytes.from_hex("")
}

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "unmarshal"
  let data = doc()
  var sum = data.len()
  if w == "unmarshal" {
    for _ in 0..1000 {
      match protobuf.unmarshal[Doc](data) {
        Ok(d) => sum += d.records.len() + d.title.len()
        Err(_) => {}
      }
    }
  } else if w == "marshal" {
    let d = protobuf.unmarshal[Doc](data).ok() ?? fault("unmarshal")
    for _ in 0..1000 {
      sum += protobuf.marshal(d).len()
    }
  }
  os.stdio.println("${w} ${sum}")
}
