0\x9e\xe1\xdf\x39"
    _ => b""
  }
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  var sum = 0
  let q = if w == "enc1" { 1 } else if w == "enc6" { 6 } else if w == "enc11" { 11 } else { -1 }
  if q >= 0 {
    let input = brotli.decode(stream("html")).or_fault("html")
    // an optional second argument repeats the encodes (an --ab run
    // needs over 100 ms per run: "too short" otherwise)
    let rep = Int.parse(os.env.args().get(1) ?? "1") ?? 1
    let n = rep * (if q == 1 { 100 } else if q == 6 { 20 } else { 2 })
    for i in 0..n {
      let out = brotli.encode(input, q)
      sum += out.len() + Int(out[i % out.len()])
    }
    os.stdio.println("${w} ${sum}")
    return
  }
  let s = stream(w)
  if !s.is_empty() {
    for i in 0..200 {
      match brotli.decode(s) {
        Ok(out) => {
          sum += out.len() + Int(out[i % out.len()])
        }
        Err(e) => {
          os.stdio.println(e.display())
          return
        }
      }
    }
  }
  os.stdio.println("${w} ${sum}")
}
