// Str.trim_chars, trim_start_chars and trim_end_chars workloads against
// Go's strings.Trim, TrimLeft and TrimRight (the twin is twin.go.txt):
// texts and cutsets chosen so each of Go's trim paths runs, an ASCII
// cutset (the bitmap), a one byte cutset, a Unicode cutset, an empty one.
// The workload is picked once, outside the loop: a `w == "trim"` compare
// inside it measured Xo's Str equality, not the trim (2026-10-23).
// Usage: trimperf <workload>; prints "<workload> <checksum>", the same
// line the Go twin prints.

const N = 200000

const TEXTS: List[Str] = [
  "  the quick brown fox jumps over the lazy dog  ",
  "***********  a  ***********",
  "héllo, wörld, ça va, 日本語 テキスト   ",
  "  \t  mixed ascii and ✓ unicode ✓  ",
  "abcabcabcabcabcabcabc",
  "   ",
]

const CUTSETS: List[Str] = [" ", "*", " \t", "é✓", "abc", "", "!"]

fn trim_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].trim_chars(CUTSETS[i % CUTSETS.len()]).len()
  }
  n
}

fn trim_start_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].trim_start_chars(CUTSETS[i % CUTSETS.len()]).len()
  }
  n
}

fn trim_end_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].trim_end_chars(CUTSETS[i % CUTSETS.len()]).len()
  }
  n
}

// index_all is the loop's own cost, the two table lookups and the
// lengths, with no trim, so a trim row can be read net of it.
fn index_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].len() + CUTSETS[i % CUTSETS.len()].len()
  }
  n
}

fn main(os: Os) {
  let args = os.env.args()
  let w = if args.len() > 0 { args[0] } else { "none" }
  var n = 0
  if w == "trim" {
    n = trim_all()
  } else if w == "trim_start" {
    n = trim_start_all()
  } else if w == "trim_end" {
    n = trim_end_all()
  } else if w == "index" {
    n = index_all()
  }
  os.stdio.println("${w} ${n}")
}
