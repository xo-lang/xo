// errframes: the error path of `?` with large parameters (decision 0632).
// big: N errors (default 20000) propagated through three `?` frames
// whose parameter is a struct of about 5,000 words (40 KB, like gcp
// aiplatform's request structs); small: the same with a 4-word
// parameter; none: the setup alone. Usage: `<program> big|small|none
// [N]`. Prints `<workload> <errors>`. No Go twin: Go records no frames.
struct Wide {
  a0: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int, a6: Int, a7: Int,
  a8: Int, a9: Int, b0: Int, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int,
  b6: Int, b7: Int, b8: Int, b9: Int, c0: Int, c1: Int, c2: Int, c3: Int,
  c4: Int, c5: Int, c6: Int, c7: Int, c8: Int, c9: Int, d0: Int, d1: Int, d2: Int
}
struct Big {
  w0: Wide, w1: Wide, w2: Wide, w3: Wide, w4: Wide, w5: Wide, w6: Wide, w7: Wide, w8: Wide, w9: Wide,
  x0: Wide, x1: Wide, x2: Wide, x3: Wide, x4: Wide, x5: Wide, x6: Wide, x7: Wide, x8: Wide, x9: Wide,
  y0: Wide?, y1: Wide?, y2: Wide?, y3: Wide?, y4: Wide?, y5: Wide?, y6: Wide?, y7: Wide?, y8: Wide?, y9: Wide?
}
struct Huge { name: Str, b0: Big, b1: Big, b2: Big, b3: Big, b4: Big? }
struct Small { id: Int, name: Str, n: Int }
enum Fail { No(i: Int) }

fn wide(k: Int) -> Wide {
  Wide{a0: k, a1: k, a2: k, a3: k, a4: k, a5: k, a6: k, a7: k, a8: k, a9: k, b0: 1, b1: 2, b2: 3, b3: 4, b4: 5, b5: 6, b6: 7, b7: 8, b8: 9, b9: 10, c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0, c8: 0, c9: 0, d0: 0, d1: 0, d2: 0}
}

fn big(k: Int) -> Big {
  let w = wide(k)
  Big{w0: w, w1: w, w2: w, w3: w, w4: w, w5: w, w6: w, w7: w, w8: w, w9: w, x0: w, x1: w, x2: w, x3: w, x4: w, x5: w, x6: w, x7: w, x8: w, x9: w, y0: Some(w), y1: None, y2: Some(w), y3: None, y4: Some(w), y5: None, y6: Some(w), y7: None, y8: Some(w), y9: None}
}

fn check(i: Int) -> Int ! Fail {
  if i >= 0 {
    return Err(Fail.No(i: i))
  }
  i
}

fn h1(h: Huge, i: Int) -> Int ! Fail { check(i)? + h.b0.w0.a0 }
fn h2(h: Huge, i: Int) -> Int ! Fail { h1(h, i)? + 1 }
fn h3(h: Huge, i: Int) -> Int ! Fail { h2(h, i)? + 1 }
fn s1(s: Small, i: Int) -> Int ! Fail { check(i)? + s.id }
fn s2(s: Small, i: Int) -> Int ! Fail { s1(s, i)? + 1 }
fn s3(s: Small, i: Int) -> Int ! Fail { s2(s, i)? + 1 }

fn main(os: Os) {
  let a = os.env.args()
  let w = if a.is_empty() { "big" } else { a[0] }
  let n = if a.len() > 1 { Int.parse(a[1]) ?? 20000 } else { 20000 }
  let b = big(3)
  let h = Huge{name: "req", b0: b, b1: b, b2: b, b3: b, b4: Some(b)}
  let s = Small{id: 7, name: "req", n: 3}
  var errs = 0
  for i in 0..n {
    let r = if w == "big" { h3(h, i) } else if w == "small" { s3(s, i) } else { Ok(0) }
    if r.is_err() {
      errs += 1
    }
  }
  os.stdio.println("${w} ${errs}")
}
