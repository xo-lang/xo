// idna: std/idna against golang.org/x/net's idna (twin.go.txt), the Lookup
// profile: ToASCII of 8 plain ASCII names 20000 times; ToASCII and ToUnicode
// of 8 names with non ASCII labels and punycode labels 4000 times; ToASCII
// of 4 names with 60 character labels 1000 times; `none` is the setup alone.
// Usage: `<program> none|ascii|mixed|long`. Prints `<workload> <checksum>`
// (the sum of the lengths of the results); the twin prints the same.
use std/idna

fn names(w: Str) -> List[Str] {
  if w == "ascii" {
    ["www.example.com", "api.v2.service.internal.example.org", "a-b-c.example.net", "EXAMPLE.COM", "cdn1.static-assets.example.io", "mail.example.co.uk", "x.y.z", "localhost"]
  } else if w == "mixed" {
    ["bücher.example.com", "例え.jp", "правда.рф", "faß.de", "München.Straße.de", "xn--bcher-kva.example.com", "xn--80aswg.xn--p1ai", "ΕΛΛΗΝΙΚΑ.gr"]
  } else {
    ["ééééééééééééééééééééééééééééééaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語.jp", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com", "ЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖЖ.рф"]
  }
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  var sum = 0
  if w != "none" {
    let ns = names(w)
    let rounds = if w == "ascii" { 20000 } else if w == "mixed" { 4000 } else { 1000 }
    for _ in 0..rounds {
      for n in ns {
        sum += (idna.to_ascii(n).ok() ?? "").len()
        if w == "mixed" {
          sum += (idna.to_unicode(n).ok() ?? "").len()
        }
      }
    }
  }
  os.stdio.println("${w} ${sum}")
}
