// String churn: interpolation, a List[Str] filled and popped empty each
// round, and a string grown with `acc = acc + w` (appended in place
// when the string is unique, under reference counting).
fn work() -> Str {
  var total = 0
  for round in 0..10 {
    var words: List[Str] = []
    for i in 0..200000 {
      words.push("w${i % 1000}-${round}")
    }
    var acc = ""
    var k = 0
    while words.len() > 0 {
      if let Some(w) = words.pop() {
        if k % 10 == 0 {
          acc = acc + w
        }
        k += 1
        total += w.len()
      }
    }
    total += acc.len()
  }
  "strings ${total}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
