// Sieve of Eratosthenes over a List[Bool]: element writes in place.
fn sieve(n: Int) -> Int {
  var flags: List[Bool] = []
  for _ in 0..n + 1 {
    flags.push(true)
  }
  var count = 0
  for i in 2..n + 1 {
    if flags[i] {
      count += 1
      var j = i * i
      while j <= n {
        flags[j] = false
        j += i
      }
    }
  }
  count
}

fn work() -> Str {
  var total = 0
  for _ in 0..5 {
    total += sieve(10000000)
  }
  "sieve ${total}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
