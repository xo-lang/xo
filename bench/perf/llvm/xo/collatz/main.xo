// Collatz step counts: a tight loop of checked Int arithmetic that the
// range analysis cannot prove safe.
fn steps(start: Int) -> Int {
  var n = start
  var s = 0
  while n != 1 {
    if n % 2 == 0 {
      n = n / 2
    } else {
      n = 3 * n + 1
    }
    s += 1
  }
  s
}

fn work() -> Str {
  var total = 0
  var best = 0
  for i in 1..3000000 {
    let s = steps(i)
    total += s
    best = best.max(s)
  }
  "collatz ${total} ${best}"
}

fn main(os: Os) {
  // REPEAT, the second argument (default 1; task #686), runs the same work
  // that many times so a timed run is long enough for a wall verdict; every
  // run must print the first run's line.
  let reps = Int.parse(os.env.args().get(1) ?? "1") ?? 1
  let first = work()
  for _ in 1..reps {
    if work() != first {
      os.stdio.println("repeat: a run printed something else")
      os.proc.exit(1)
    }
  }
  os.stdio.println(first)
}
