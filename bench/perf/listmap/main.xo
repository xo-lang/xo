// List.map on lists of one size (decision 0508): `small` maps 4 Ints and
// 2 Strs 2M times, `mid` 32 and 31 Ints 300k times (around the in-place
// threshold), `big` 1M Ints 20 times, each a list nothing else holds;
// `sortby` sorts 100k (Int, Str) records by their Int 10 times and
// `sortby_small` 4 records 300k times (List.sort_by in place); `reverse`
// reverses 1M Ints 20 times and 8 Strs 1M times.
fn main(os: Os) {
  let args = os.env.args()
  let mode = if args.is_empty() { "big" } else { args[0] }
  var total = 0
  if mode == "small" {
    var xs = [1, 2, 3, 4]
    for i in 0..2_000_000 {
      let ys = xs.map(fn(v) { v + i })
      total += ys[3]
      let ss = ["a", "b"].map(fn(s) { s.len() })
      total += ss[1]
    }
  } else if mode == "mid" {
    for i in 0..300_000 {
      let ys = (0..32).to_list().map(fn(v) { v + i })
      total += ys[31]
      let zs = (0..31).to_list().map(fn(v) { v * 2 })
      total += zs[30]
    }
  } else if mode == "sortby" {
    // records sorted by a key, 100k of them 10 times
    for r in 0..10 {
      var rs: List[(Int, Str)] = []
      var x = 777 + r
      for i in 0..100_000 {
        x = (x * 1103515245 + 12345) % 2147483648
        rs.push((x, "r${i}"))
      }
      let sorted = rs.sort_by(fn(t) { t.0 })
      total += sorted[50_000].0
    }
  } else if mode == "reverse" {
    // 1M Ints reversed 20 times, and 8 Strs 1M times
    var xs = (0..1_000_000).to_list()
    for _ in 0..20 {
      xs = xs.reverse()
    }
    total += xs[0]
    for i in 0..1_000_000 {
      let ss = ["a", "b", "c", "d", "e", "f", "g", "${i % 3}"].reverse()
      total += ss[0].len()
    }
  } else if mode == "sortby_small" {
    for i in 0..300_000 {
      let rs = [(3 + i, "c"), (1, "a"), (2, "b"), (i % 5, "d")]
      total += rs.sort_by(fn(t) { t.0 })[0].0
    }
  } else {
    for r in 0..20 {
      var b = Buf[Int].with_capacity(1_000_000)
      var x = 12345 + r
      for _ in 0..1_000_000 {
        x = (x * 1103515245 + 12345) % 2147483648
        b.push(x)
      }
      let ys = b.freeze().map(fn(v) { v + 1 })
      total += ys[500_000]
    }
  }
  os.stdio.println("${mode} ${total}")
}
