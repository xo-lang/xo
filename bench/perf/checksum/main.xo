// checksum: std/crc32, crc64, fnv and adler32 against Go's hash/crc32,
// hash/crc64, hash/fnv and hash/adler32 (twin.go.txt): each hashes a 4 KB
// buffer of generated bytes 20,000 times (adler32 and crc32 over the whole
// buffer, fnv's 32 and 64 bit 1a over it, crc64 with the ISO table); `none`
// is the setup alone. Usage: `<program> none|crc32|crc64|crc64nvme|fnv32a|fnv64a|adler32`.
// Prints `<workload> <checksum>`; the twin prints the same.
use std/adler32
use std/crc32
use std/crc64
use std/fnv

fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  var b = BytesBuilder.with_capacity(4096)
  var r = 7
  for _ in 0..4096 {
    r = next(r)
    b.write_byte(UInt8((r >> 8) & 255))
  }
  let data = b.freeze()
  var sum = 0
  for i in 0..20000 {
    if w == "crc32" {
      sum += crc32.checksum(data) % 1000003
    } else if w == "crc64" {
      sum += (crc64.checksum(data) & 0x7fffffffffffffff) % 1000003
    } else if w == "crc64nvme" {
      sum += (crc64.checksum(data, crc64.Poly.Nvme) & 0x7fffffffffffffff) % 1000003
    } else if w == "fnv32a" {
      sum += fnv.sum32a(data) % 1000003
    } else if w == "fnv64a" {
      sum += (fnv.sum64a(data) & 0x7fffffffffffffff) % 1000003
    } else if w == "adler32" {
      sum += adler32.checksum(data) % 1000003
    } else {
      sum += data.len() + i % 3
    }
  }
  os.stdio.println("${w} ${sum}")
}
