// A loopback HTTP/1.1 server's small responses to keep-alive clients: the
// server's per-request read and write path (hconn recv and send), for
// `xo bench --ab`. Prints the response bytes received.
//
// One listener per two clients: std/http's client pool keeps 2 idle
// HTTP/1.1 connections per address (Go's DefaultMaxIdleConnsPerHost), so
// 32 clients of one address closed and redialed a connection about every
// 35 requests on a many-core host (27,500 sockets left in TIME_WAIT per
// run, the host's port range full after four runs; 2026-11-14,
// gotchas/loopback-stress-ephemeral-ports.md).
use std/http

const CLIENTS = 32
const REQUESTS = 30000

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /u", fn(_req) { http.text(200, "{\"id\":1,\"name\":\"a\"}") })
  r
}

fn main(os: Os) {
  var srvs: List[http.Server] = []
  var urls: List[Str] = []
  for _ in 0..(CLIENTS + 1) / 2 {
    let l = os.net.listen("127.0.0.1:0").or_fault("listen")
    srvs.push(http.server(l, routes()))
    urls.push("http://${l.addr()}/u")
  }
  let total = Mutex[Int].new(0)
  scope s {
    for srv in srvs {
      s.spawn_background(fn() { srv.serve().ignore_err("the bench's server") })
    }
    scope c {
      for k in 0..CLIENTS {
        let url = urls[k / 2]
        c.spawn(fn() {
          let cl = http.client(os.net, timeout: 30s)
          var n = 0
          for _ in 0..REQUESTS {
            n += cl.get(url).or_fault("get").body.len()
          }
          total.with(fn(var t) { t += n })
        })
      }
    }
    s.cancel()
  }
  os.stdio.println("${total.with(fn(var t) { t })}")
}
