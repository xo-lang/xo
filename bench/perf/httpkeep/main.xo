// A loopback HTTP/1.1 server's small responses to keep-alive clients: the
// server's per-request read and write path (hconn recv and send), for
// `xo bench --ab`. Prints the response bytes received.
use std/http

const CLIENTS = 32
const REQUESTS = 3000

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /u", fn(_req) { http.text(200, "{\"id\":1,\"name\":\"a\"}") })
  r
}

fn main(os: Os) {
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l, routes())
  let url = "http://${l.addr()}/u"
  let total = Mutex[Int].new(0)
  scope s {
    s.spawn_background(fn() { srv.serve().ignore_err("the bench's server") })
    scope c {
      for _ in 0..CLIENTS {
        c.spawn(fn() {
          let cl = http.client(os.net, timeout: 30s)
          var n = 0
          for _ in 0..REQUESTS {
            n += cl.get(url).or_fault("get").body.len()
          }
          total.with(fn(var t) { t += n })
        })
      }
    }
    s.cancel()
  }
  os.stdio.println("${total.with(fn(var t) { t })}")
}
