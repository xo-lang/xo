// x509: std/x509 against Go's crypto/x509 (twin.go.txt): parse a three
// certificate chain (www.google.com, GTS CA 1C3, GTS Root R1, from Go's
// verify_test.go, Copyright 2009 The Go Authors, BSD-style license) from
// PEM 20,000 times, and verify it 5,000 times at Go's test time with its
// DNS name, make an Ed25519 self-signed certificate 20,000 times, and
// parse a CRL of 100 revoked certificates (derCRLBase64 of Go's
// x509_test.go) 20,000 times; `none` is the setup alone. Usage:
// `<program> none|parse|verify|create|crl`. Prints `<workload> <checksum>`; the twin prints the
// same.
use std/base64
use std/crypto
use std/x509

const KEY: Bytes = b"\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x70\x04\x22\x04\x20\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

