// png: std/png encode and decode of four 256x256 images (opaque RGBA, NRGBA
// with alpha, Gray, 16 color Paletted; a gradient with a little noise), 8
// passes, against Go's image/png (twin.go.txt). Usage: `<program>
// encode|decode|none` (none: the setup alone, which builds the images and
// encodes them once). Prints `<workload> <checksum>`; the twin prints the same.
use std/png

fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

fn make(model: png.Model, w: Int, h: Int, seed: Int) -> png.Image {
  var img = png.image(w, h, model)
  var r = seed
  let bpp = model.bytes_per_pixel()
  var bb = BytesBuilder.with_capacity(w * h * bpp)
  var pal: List[Int] = []
  if model == png.Model.Paletted {
    for i in 0..16 {
      pal.push(((i * 16) << 24) | ((255 - i * 16) << 16) | ((i * 7) << 8) | 255)
    }
  }
  for y in 0..h {
    for x in 0..w {
      r = next(r)
      let noise = (r >> 8) % 5
      match model {
        png.Model.Gray => bb.write_byte(UInt8((x + y + noise) % 256))
        png.Model.Paletted => bb.write_byte(UInt8(((x / 16) + (y / 16) + (if noise == 0 { 1 } else { 0 })) % 16))
        png.Model.RGBA => {
          bb.write_byte(UInt8((x + noise) % 256))
          bb.write_byte(UInt8((y + noise) % 256))
          bb.write_byte(UInt8((x + y) / 2 % 256))
          bb.write_byte(UInt8(255))
        }
        _ => {
          let a = 128 + (x + y) / 4 % 128
          bb.write_byte(UInt8((x + noise) % a))
          bb.write_byte(UInt8((y + noise) % a))
          bb.write_byte(UInt8((x + y) / 2 % a))
          bb.write_byte(UInt8(a))
        }
      }
    }
  }
  img.pix = bb.freeze()
  img.palette = pal
  img
}

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "encode"
  var imgs: List[png.Image] = []
  imgs.push(make(png.Model.RGBA, 256, 256, 1))
  imgs.push(make(png.Model.NRGBA, 256, 256, 2))
  imgs.push(make(png.Model.Gray, 256, 256, 3))
  imgs.push(make(png.Model.Paletted, 256, 256, 4))
  var files: List[Bytes] = []
  for im in imgs {
    files.push(png.encode(im).ok() ?? b"")
  }
  var sum = 0
  for f in files {
    sum += f.len()
  }
  if w == "encode" {
    for _ in 0..8 {
      for im in imgs {
        let e = png.encode(im).ok() ?? b""
        sum += e.len() + Int(e[e.len() - 1])
      }
    }
  } else if w == "decode" {
    for _ in 0..8 {
      for f in files {
        let im = png.decode(f).ok()
        match im {
          Some(i) => sum += i.width * i.height + Int(i.pix[i.pix.len() - 1])
          None => {}
        }
      }
    }
  }
  os.stdio.println("${w} ${sum}")
}
