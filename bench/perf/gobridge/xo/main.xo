// gobridge: the `use go` bridge's call overhead (std/go, ADR 0655 rule 7)
// against a Go twin making the same calls (../twin.go.txt). `use go` builds
// only on the Go backend (decision 0248), where a bridge call is a Go call
// plus the conversion of each value at the boundary, not cgo, so the twin
// is plain Go: a Str in and an Int out (strings.Index), Bytes in
// (bytes.IndexByte), an Int in and a Str out (strconv.Itoa), each on a
// short value, so the calls' cost is the bridge's. The sums wrap
// (wrapping_add), as Go's `+` does: the rows time the calls, not Xo's
// overflow checks (owner 2026-11-20, xw decision #207, task #423: checked
// adds were 0.08 of the str row). The default N makes each row about
// 100 ms of Go, so that the start of the program (Xo's is about 1 ms
// over Go's) is under a hundredth of it. Three kinds of row are
// diagnostics, listed in the evidence and not judged (scripts/stdproven
// perfDiag): diag_startup (N = 0: the start and end of the program
// alone) and diag_none_checked, diag_str_checked, diag_bytes_checked
// (the same loops with Xo's checked `+`; the Go twin's are its plain
// loops again). Usage:
// `<program> none|str|bytes|int|diag_... [N]`. Prints `<workload> <checksum>`.
// In xo/, not main.xo: the native checks of every bench/perf/*/main.xo
// (cmd/xo TestVetCostStd) cannot build a `use go` program.
use go "strings"
use go "bytes"
use go "strconv"

fn main(os: Os) {
  let a = os.env.args()
  let w = if a.is_empty() { "str" } else { a[0] }
  let dn = if w == "diag_startup" {
    0
  } else if w == "none" || w == "diag_none_checked" {
    200000000
  } else if w == "int" {
    10000000
  } else {
    50000000
  }
  let n = if a.len() > 1 { Int.parse(a[1]) ?? dn } else { dn }
  let s = "the quick brown fox jumps over z"
  let b = s.bytes()
  // the workload as a number, chosen once: a match on w in the loop
  // compared the name on every iteration, and the two sides' compares
  // cost differently by name (2026-11-20: the Go twin's bytes loop took
  // 111 ms as "bytes" and 184 ms as "diag_bytes_checked")
  let k = if w == "str" {
    1
  } else if w == "bytes" {
    2
  } else if w == "int" {
    3
  } else if w == "diag_str_checked" {
    4
  } else if w == "diag_bytes_checked" {
    5
  } else if w == "diag_none_checked" {
    6
  } else {
    0
  }
  var sum = 0
  for i in 0..n {
    match k {
      1 => sum = sum.wrapping_add(strings.index(s, "z").wrapping_add(i % 3))
      2 => sum = sum.wrapping_add(bytes.index_byte(b, UInt8(122)).wrapping_add(i % 3))
      3 => sum = sum.wrapping_add(strconv.itoa(i).len())
      4 => sum += strings.index(s, "z") + i % 3
      5 => sum += bytes.index_byte(b, UInt8(122)) + i % 3
      6 => sum += i % 3
      _ => sum = sum.wrapping_add(i % 3)
    }
  }
  os.stdio.println("${w} ${sum}")
}
