// Bytes find_any, rfind_any, contains_any, contains_rune, cut, cut_prefix,
// cut_suffix and split_after workloads against Go's bytes package (the twin
// is twin.go.txt): texts and sets chosen so an empty set, a one byte set, a
// set with a multi byte rune and an invalid byte (U+FFFD), the ASCII fast
// path (a set of ASCII and a value over 8 bytes), a found and an absent
// separator, and invalid UTF-8 in the value all run. The workload is picked
// once, outside the loop.
// Usage: bytessearch <workload>; prints "<workload> <checksum>", the same
// line the Go twin prints.

const N = 200000

const TEXTS: List[Bytes] = [
  b"  the quick brown fox, jumps over the lazy dog  ",
  b"1,2,3,4",
  b"héllo, wörld, ça va, 日本語 テキスト   ",
  b"  \t  mixed ascii and ✓ unicode ✓  ",
  b"abcabcabcabcabcabcabc",
  b"a\xffb, c\x80 ,",
]

const SEPS: List[Bytes] = [b",", b" ", b"abc", b"", b"✓", b":"]
const CHARS: List[Str] = ["aπ☺", "xyz", "", "\u{fffd}b", ":,✓"]
const RUNES: List[Rune] = ['a', Rune(0xFFFD), 'π', 'z']

fn index_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].len()
  }
  n
}

fn find_any_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].find_any(CHARS[i % CHARS.len()]) ?? -1
  }
  n
}

fn rfind_any_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].rfind_any(CHARS[i % CHARS.len()]) ?? -1
  }
  n
}

fn contains_any_all() -> Int {
  var n = 0
  for i in 0..N {
    if TEXTS[i % TEXTS.len()].contains_any(CHARS[i % CHARS.len()]) {
      n += 1
    }
  }
  n
}

fn contains_rune_all() -> Int {
  var n = 0
  for i in 0..N {
    if TEXTS[i % TEXTS.len()].contains_rune(RUNES[i % RUNES.len()]) {
      n += 1
    }
  }
  n
}

fn cut_all() -> Int {
  var n = 0
  for i in 0..N {
    let (x, y) = TEXTS[i % TEXTS.len()].cut(SEPS[i % SEPS.len()]) ?? (b"", b"")
    n += x.len() + y.len()
  }
  n
}

fn cut_prefix_all() -> Int {
  var n = 0
  for i in 0..N {
    n += (TEXTS[i % TEXTS.len()].cut_prefix(SEPS[i % SEPS.len()]) ?? b"").len()
  }
  n
}

fn cut_suffix_all() -> Int {
  var n = 0
  for i in 0..N {
    n += (TEXTS[i % TEXTS.len()].cut_suffix(SEPS[i % SEPS.len()]) ?? b"").len()
  }
  n
}

fn split_after_all() -> Int {
  var n = 0
  for i in 0..N {
    for p in TEXTS[i % TEXTS.len()].split_after(SEPS[i % SEPS.len()]) {
      n += p.len()
    }
  }
  n
}

fn main(os: Os) {
  let args = os.env.args()
  let w = if args.len() > 0 { args[0] } else { "none" }
  var n = 0
  if w == "find_any" {
    n = find_any_all()
  } else if w == "rfind_any" {
    n = rfind_any_all()
  } else if w == "contains_any" {
    n = contains_any_all()
  } else if w == "contains_rune" {
    n = contains_rune_all()
  } else if w == "cut" {
    n = cut_all()
  } else if w == "cut_prefix" {
    n = cut_prefix_all()
  } else if w == "cut_suffix" {
    n = cut_suffix_all()
  } else if w == "split_after" {
    n = split_after_all()
  } else if w == "index" {
    n = index_all()
  }
  os.stdio.println("${w} ${n}")
}
