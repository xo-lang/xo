// sha3: std/crypto's SHA3-256 against Go's crypto/sha3 (twin.go.txt):
// `big` hashes 1 MiB of generated bytes 40 times, `small` 200,000 short
// messages (0 to 149 bytes, the padding and the calls); `none` is the
// setup alone. arm64 runs the SHA3 extension's Keccak rounds (cpu.xo
// keccak_f1600), as Go's keccakF1600NEON. Usage: `<program>
// none|big|small`. Prints `<workload> <checksum>`; the twin prints the
// same.
use std/crypto

fn data(n: Int) -> Bytes {
  var b = BytesBuilder.with_capacity(n)
  var r = 1
  for _ in 0..n {
    r = (r * 1103515245 + 12345) % 2147483648
    b.write_byte(UInt8((r >> 16) & 255))
  }
  b.freeze()
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  let d = data(1 << 20)
  var s = 0
  if w == "big" {
    for _ in 0..40 {
      let h = crypto.digest(crypto.Hash.Sha3_256, d)
      s += Int(h[0]) + Int(h[31])
    }
  } else if w == "small" {
    for i in 0..200000 {
      let h = crypto.digest(crypto.Hash.Sha3_256, d[i % 1000..i % 1000 + i % 150])
      s += Int(h[0])
    }
  }
  os.stdio.println("${w} ${s}")
}
