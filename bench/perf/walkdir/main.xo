// walkdir: walk_dir against Go's filepath.Walk and walk_dir_entries
// against filepath.WalkDir (twin.go.txt; Walk since 2026-11-07, as
// walk_dir stats each entry for its FileInfo): a tree
// of 20 directories of 20 directories of 3 files (1,620 entries) made
// under the scratch directory, then walked 200 times, the directories
// named b7 skipped (SkipDir); `none` is the setup alone. The tree is in
// a new directory under $TMPDIR (else /tmp), removed at the end. Usage:
// `<program> none|walk|walk_info|walk_entries|walk_entries_info` (walk_info also reads each entry's
// info, which both FileInfos hold already; walk_entries and walk_entries_info are the same two with walk_dir_entries, decision 0483, info being the lazy stat). Prints `<workload> <checksum>`; the twin prints
// the same.

fn main(os: Os) ! {
  let w = os.env.args().get(0) ?? "none"
  let tmp = os.fs.sub(os.env.get("TMPDIR") ?? "/tmp")
  let name = "xo-walkdir-${os.rand.int(0, 1000000000)}"
  tmp.create_dir_all(name)?
  let fs = tmp.sub(name)
  for i in 0..20 {
    for j in 0..20 {
      let d = "t/a${i}/b${j}"
      fs.create_dir_all(d)?
      for k in 0..3 {
        fs.write("${d}/f${k}", b"x")?
      }
    }
  }
  var s = 0
  if w == "walk" || w == "walk_info" {
    for _ in 0..200 {
      let seen = walk_dir(fs, "t", fn(fi) { if fi.name == "b7" { WalkStep.SkipDir } else { WalkStep.Continue } })?
      for fi in seen {
        s += fi.path.len()
        if w == "walk_info" && fi.is_dir {
          s += 1
        }
      }
    }
  }
  if w == "walk_entries" || w == "walk_entries_info" {
    for _ in 0..200 {
      let seen = walk_dir_entries(fs, "t", fn(e) { if e.name == "b7" { WalkStep.SkipDir } else { WalkStep.Continue } })?
      for e in seen {
        s += e.path.len()
        if w == "walk_entries_info" {
          let fi = e.info(fs)?
          if fi.is_dir {
            s += 1
          }
        }
      }
    }
  }
  tmp.remove_all(name)?
  os.stdio.println("${w} ${s}")
}
