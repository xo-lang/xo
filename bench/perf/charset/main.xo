// charset: std/charset against golang.org/x/text's encoding/unicode and
// charmap (twin.go.txt): a 1 MiB text of mixed ASCII, Latin-1, general
// punctuation and astral characters is encoded to UTF-16LE and a 1 MiB
// buffer of windows-1252 bytes (no unassigned ones) decoded, 20 times each,
// and the same buffers the other way (UTF-16LE decoded, windows-1252
// encoded); `none` is the setup alone. Usage: `<program>
// none|utf16_encode|utf16_decode|w1252_decode|w1252_encode`. Prints
// `<workload> <checksum>`; the twin prints the same.
use std/charset

/// A text of about 1 MiB: a deterministic mix, 7 in 10 characters ASCII.
fn text() -> Str {
  var b = StrBuilder.new()
  var r = 1
  for _ in 0..600000 {
    r = (r * 1103515245 + 12345) % 2147483648
    let k = (r >> 16) % 20
    if k < 14 {
      b.write("${Rune(32 + (r >> 8) % 95)}")
    } else if k < 17 {
      b.write("${Rune(0xA0 + (r >> 8) % 96)}")
    } else if k < 19 {
      b.write("${Rune(0x20AC)}")
    } else {
      b.write("${Rune(0x10000 + (r >> 8) % 0x1000)}")
    }
  }
  b.freeze()
}

/// 1 MiB of windows-1252 bytes without the five unassigned ones.
fn bytes1252() -> Bytes {
  var b = BytesBuilder.with_capacity(1048576)
  var r = 7
  for _ in 0..1048576 {
    r = (r * 1103515245 + 12345) % 2147483648
    var v = (r >> 16) & 255
    if v == 0x81 || v == 0x8D || v == 0x8F || v == 0x90 || v == 0x9D {
      v = 0x41
    }
    b.write_byte(UInt8(v))
  }
  b.freeze()
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  var sum = 0
  if w == "utf16_encode" {
    let t = text()
    for _ in 0..20 {
      let e = charset.encode(t, charset.Charset.Utf16Le).ok() ?? fault("encode")
      sum += e.len() + Int(e[e.len() - 3])
    }
  } else if w == "utf16_decode" {
    let e = charset.encode(text(), charset.Charset.Utf16Le).ok() ?? fault("encode")
    for _ in 0..20 {
      let t = charset.decode(e, charset.Charset.Utf16Le).ok() ?? fault("decode")
      sum += t.len()
    }
  } else if w == "w1252_decode" {
    let b = bytes1252()
    for _ in 0..20 {
      let t = charset.decode(b, charset.Charset.Windows1252).ok() ?? fault("decode")
      sum += t.len()
    }
  } else if w == "w1252_encode" {
    let t = charset.decode(bytes1252(), charset.Charset.Windows1252).ok() ?? fault("decode")
    for _ in 0..20 {
      let e = charset.encode(t, charset.Charset.Windows1252).ok() ?? fault("encode")
      sum += e.len() + Int(e[e.len() - 1])
    }
  } else if w == "none" {
    sum = text().len() + bytes1252().len()
  }
  os.stdio.println("${w} ${sum}")
}
