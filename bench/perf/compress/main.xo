// compress: std/compress against Go's compress/gzip and compress/flate
// (twin.go.txt): 40 buffers of about 32 KB of generated text (words from a
// small vocabulary, so they compress), gzip at the default level and at
// BestSpeed, gunzip, deflate and inflate, 10 passes each; `none` is the
// setup alone. Usage: `<program> none|gzip|gzip1|gunzip|deflate|inflate`.
// Prints `<workload> <checksum>`; the twin prints the same.
use std/compress

const WORDS: List[Str] = ["the", "cache", "stores", "every", "entry", "once", "by", "key", "and", "reads", "it", "back", "with", "a", "check", "of", "its", "version", "before", "use", "\n"]

fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

fn inputs() -> List[Bytes] {
  var out: List[Bytes] = []
  var r = 777
  for _ in 0..40 {
    var b = BytesBuilder.with_capacity(33000)
    while b.len() < 32768 {
      r = next(r)
      b.write_str(WORDS[(r >> 8) % 21])
      b.write_byte(32)
    }
    out.push(b.freeze())
  }
  out
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  let ins = inputs()
  var sum = 0
  if w == "gzip" || w == "gzip1" || w == "deflate" {
    for _ in 0..10 {
      for s in ins {
        let c = if w == "gzip" { compress.gzip(s) } else if w == "gzip1" { compress.gzip(s, compress.Level.BestSpeed) } else { compress.deflate(s) }
        sum += c.len() + Int(c[c.len() - 1])
      }
    }
  } else if w == "gunzip" || w == "inflate" {
    var cs: List[Bytes] = []
    for s in ins {
      cs.push(if w == "gunzip" { compress.gzip(s) } else { compress.deflate(s) })
    }
    for _ in 0..10 {
      for c in cs {
        let d = (if w == "gunzip" { compress.gunzip(c) } else { compress.inflate(c) }).ok() ?? fault("decompress")
        sum += d.len() + Int(d[d.len() - 1])
      }
    }
  } else {
    for s in ins {
      sum += s.len() + Int(s[s.len() - 1])
    }
  }
  os.stdio.println("${w} ${sum}")
}
