// blake2b: std/crypto's BLAKE2b against x/crypto's blake2b
// (twin.go.txt): `big` hashes 1 MiB of generated bytes 40 times with
// BLAKE2b-256, `big512` the same with BLAKE2b-512, `small` 200,000 short
// messages (0 to 149 bytes, the padding and the calls) with BLAKE2b-256,
// `keyed` the small messages with a 32 byte key (blake2b_hasher); `none`
// is the setup alone. Usage: `<program> none|big|big512|small|keyed`.
// Prints `<workload> <checksum>`; the twin prints the same.
use std/crypto

fn data(n: Int) -> Bytes {
  var b = BytesBuilder.with_capacity(n)
  var r = 1
  for _ in 0..n {
    r = (r * 1103515245 + 12345) % 2147483648
    b.write_byte(UInt8((r >> 16) & 255))
  }
  b.freeze()
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  let d = data(1 << 20)
  var s = 0
  if w == "big" || w == "big512" {
    let h = if w == "big" { crypto.Hash.Blake2b_256 } else { crypto.Hash.Blake2b_512 }
    for _ in 0..40 {
      let x = crypto.digest(h, d)
      s += Int(x[0]) + Int(x[31])
    }
  } else if w == "small" {
    for i in 0..200000 {
      let x = crypto.digest(crypto.Hash.Blake2b_256, d[i % 1000..i % 1000 + i % 150])
      s += Int(x[0])
    }
  } else if w == "keyed" {
    let key = d[0..32]
    for i in 0..200000 {
      var x = crypto.blake2b_hasher(32, key) ?? e => fault(e.msg)
      x.write(d[i % 1000..i % 1000 + i % 150])
      s += Int(x.sum()[0])
    }
  }
  os.stdio.println("${w} ${s}")
}
