// netip against Go's net/netip (twin.go.txt). Usage: `<program> none|parse4|parse6|display4|display6|compare|mixed`
// (parse4 and parse6 parse one address a call, display4 and display6 print one,
// compare sorts 10,000 addresses, mixed is the first workload of the row: two
// parses, is_private and two displays). Prints `<workload> <checksum>`; the twin prints the same.
use std/netip

const ADDRS: List[Str] = ["10.1.2.3", "192.168.77.200", "2001:db8::1:2:3", "fe80::a:b:c:d", "::ffff:1.2.3.4", "fd12:3456:789a::1", "8.8.8.8", "2606:4700:4700::1111"]

const V4: List[Str] = ["10.1.2.3", "192.168.77.200", "8.8.8.8", "172.16.254.1"]

const V6: List[Str] = ["2001:db8::1:2:3", "fe80::a:b:c:d", "fd12:3456:789a::1", "2606:4700:4700::1111"]

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "mixed"
  var n = 0
  if w == "mixed" {
    for i in 0..200000 {
      let a = netip.parse_addr(ADDRS[i % 8]).ok() ?? fault("parse")
      let b = netip.parse_addr(ADDRS[(i + 3) % 8]).ok() ?? fault("parse")
      if a.is_private() {
        n += 1
      }
      n += a.display().len() + b.display().len()
    }
  } else if w == "parse4" {
    for i in 0..400000 {
      let a = netip.parse_addr(V4[i % 4]).ok() ?? fault("parse")
      n += a.bits
    }
  } else if w == "parse6" {
    for i in 0..400000 {
      let a = netip.parse_addr(V6[i % 4]).ok() ?? fault("parse")
      n += a.bits
    }
  } else if w == "display4" || w == "display6" {
    let xs = (if w == "display4" { V4 } else { V6 }).map(fn(s) { netip.parse_addr(s).ok() ?? fault("parse") })
    for i in 0..400000 {
      n += xs[i % 4].display().len()
    }
  } else if w == "compare" {
    var xs: List[netip.Addr] = []
    for i in 0..10000 {
      xs.push(netip.parse_addr(ADDRS[i % 8]).ok() ?? fault("parse"))
      var bb = BytesBuilder.with_capacity(16)
      bb.write(b"\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
      bb.write_byte(UInt8(i / 256))
      bb.write_byte(UInt8(i % 256))
      xs.push(netip.addr_from_bytes(bb.freeze()) ?? fault("bytes"))
    }
    for _ in 0..20 {
      let s = xs.sort()
      n += s.len() + s[0].bits
    }
  }
  os.stdio.println("${w} ${n}")
}
