// cbor: std/cbor on a 20 KB document (150 records of ints, floats, text, byte
// strings, lists and nested maps, built with fxamacker/cbor's deterministic
// encoder), 100 passes, against github.com/fxamacker/cbor/v2 (twin.go.txt).
// Usage: `<program> decode|encode|canon|none` (decode builds the generic tree
// of each pass; encode writes the tree once decoded with the preferred
// serialization, canon with deterministic map order; none: the setup alone).
// Prints `<workload> <checksum>`; the twin prints the same.
use std/cbor

fn doc() -> Bytes {
  Bytes.from_hex("") ?? b""
}

fn count(v: cbor.Value) -> Int {
  match v {
    cbor.Value.Array(items) => {
      var n = 1
      for it in items {
        n += count(it)
      }
      n
    }
    cbor.Value.Map(pairs) => {
      var n = 1
      for p in pairs {
        n += count(p.0) + count(p.1)
      }
      n
    }
    cbor.Value.ByteString(b) => 1 + b.len()
    cbor.Value.TextString(s) => 1 + s.len()
    _ => 1
  }
}

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "decode"
  let data = doc()
  var sum = data.len()
  let v = cbor.decode(data).ok() ?? cbor.Value.Null
  if w == "decode" {
    for _ in 0..100 {
      match cbor.decode(data) {
        Ok(x) => sum += count(x)
        Err(_) => {}
      }
    }
  } else if w == "encode" || w == "canon" {
    for _ in 0..100 {
      match cbor.encode(v, deterministic: w == "canon") {
        Ok(b) => sum += b.len()
        Err(_) => {}
      }
    }
  }
  os.stdio.println("${w} ${sum}")
}
