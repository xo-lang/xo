use std/time
use std/timego

fn main(os: Os) {
  let args = os.env.args()
  let mode = if args.len() > 0 { args[0] } else { "none" }
  let utc = time.utc()
  // translated once, as hot code does
  let iso = timego.layout("2006-01-02T15:04:05Z07:00").or_fault("layout")
  let rfc = timego.layout("Mon, 02 Jan 2006 15:04:05 MST").or_fault("layout")
  var n = 0
  if mode == "format" {
    for i in 0..300000 {
      let t = Time.from_unix(1760000000 + i * 37)
      n += iso.format(t, utc).len()
      n += rfc.format(t, utc).len()
    }
  }
  if mode == "parse" {
    for i in 0..300000 {
      let s = "2026-10-${10 + i % 20}T12:34:56Z"
      let t = iso.parse(s, utc).ok() ?? fault("parse")
      n += t.unix() % 7
    }
  }
  os.stdio.println("${mode} ${n}")
}
