// A loopback HTTP server's streamed responses (http.stream) under keep-alive
// clients: BodyWriter's write and flush path, for `xo bench --ab`.
use std/http

const CLIENTS = 8
const REQUESTS = 4000
const WRITES = 16
const CHUNK = 4096

fn routes() -> http.Router {
  let chunk = "x".repeat(CHUNK).bytes()
  var r = http.router()
  r.handle("GET /s", fn(_req) {
    http.stream(200, fn(w) {
      for i in 0..WRITES {
        w.write(chunk)?
        if i % 4 == 3 {
          w.flush()?
        }
      }
    }).with_header("Content-Type", "text/plain")
  })
  r
}

fn main(os: Os) {
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l, routes())
  let url = "http://${l.addr()}/s"
  let total = Mutex[Int].new(0)
  scope s {
    s.spawn_background(fn() { srv.serve().ignore_err("the bench's server") })
    scope c {
      for _ in 0..CLIENTS {
        c.spawn(fn() {
          let cl = http.client(os.net, timeout: 30s)
          for _ in 0..REQUESTS {
            let resp = cl.get(url).or_fault("get")
            total.with(fn(var t) { t += resp.body.len() })
          }
        })
      }
    }
    s.cancel()
  }
  os.stdio.println("${total.with(fn(var t) { t })}")
}
