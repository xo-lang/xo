// The context record's hot paths (decision 0229; the zero-C audit's
// B17): deferred code's shields, cancellation points, and Mutex holding,
// in a program that runs tasks (so its deferred code is shielded).
// Usage: ctx <workload>. Workloads: defer (2,000,000 calls of a function
// with a defer), mutex (2,000,000 uncontended Mutex.with), spawn (20,000
// tasks spawned and joined in scopes of 10), budget (a loop of 20,000,000
// iterations under task.with_budget, which polls the budget at each:
// rt.tick), none (the setup alone).
// Each prints "<workload> <checksum>".
use std/task

fn bump(a: Atomic[Int], i: Int) -> Int {
  defer {
    let _ = a.add(1)
  }
  i + 1
}

fn count(n: Int) -> Int {
  var s = 0
  for i in 0..n {
    s += i & 3
  }
  s
}

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "none"
  let a = Atomic[Int].new(0)
  var sum = 0
  if w == "defer" {
    for i in 0..2000000 {
      sum += bump(a, i) & 1
    }
    sum += a.get()
  } else if w == "mutex" {
    let m = Mutex[Int].new(0)
    for _ in 0..2000000 {
      m.with(fn(var c) { c += 1 })
    }
    sum = m.with_read(fn(c) { c })
  } else if w == "budget" {
    match task.with_budget(os.clock, task.budget(steps: 1000000000), fn() -> Int { count(20000000) }) {
      Ok(v) => sum = v
      Err(_) => sum = -1
    }
  } else if w == "spawn" {
    for _ in 0..2000 {
      scope s {
        for _ in 0..10 {
          s.spawn(fn() {
            let _ = a.add(1)
          })
        }
      }
    }
    sum = a.get()
  } else {
    // a task, so the program is concurrent in every workload
    scope s {
      s.spawn(fn() {
        let _ = a.add(1)
      })
    }
  }
  os.stdio.println("${w} ${sum}")
}
