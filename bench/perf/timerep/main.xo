// timerep: the cost of Go's wide Time representation (seconds since year 1 plus nanoseconds,
// two words) against Xo's one word (nanoseconds since 1970) on the hot paths: now, add, sub,
// compare and sort, and RFC 3339 format. WIDE picks the representation; the two builds run
// the same workloads. Prints `<workload> <checksum>`.

const WIDE: Bool = false

// seconds from 0001-01-01 to 1970-01-01 (Go's unixToInternal)
const UNIX_TO_INTERNAL: Int = 62135596800

struct W {
  sec: Int
  nsec: Int
} derive Eq, Ord

fn w_from_unix_nanos(n: Int) -> W {
  var s = n / 1000000000
  var ns = n % 1000000000
  if ns < 0 {
    ns += 1000000000
    s -= 1
  }
  W{sec: s + UNIX_TO_INTERNAL, nsec: ns}
}

// Go's Time.Add
fn w_add(t: W, d: Duration) -> W {
  let dn = d.nanos()
  var s = t.sec + dn / 1000000000
  var ns = t.nsec + dn % 1000000000
  if ns >= 1000000000 {
    s += 1
    ns -= 1000000000
  } else if ns < 0 {
    s -= 1
    ns += 1000000000
  }
  W{sec: s, nsec: ns}
}

// Go's Time.Sub (saturating at the Duration range)
fn w_sub(a: W, b: W) -> Duration {
  let ds = a.sec - b.sec
  if ds > 9223372036 || ds < -9223372036 {
    return Duration.from_nanos(if ds > 0 { Int.max } else { Int.min })
  }
  Duration.from_nanos(ds * 1000000000 + (a.nsec - b.nsec))
}

fn w_before(a: W, b: W) -> Bool { a.sec < b.sec || (a.sec == b.sec && a.nsec < b.nsec) }

fn pad(var b: BytesBuilder, v: Int, n: Int) {
  var d = 1
  for _ in 1..n {
    d *= 10
  }
  var x = v
  while d > 0 {
    b.write_byte(UInt8.wrapping_from(48 + (x / d) % 10))
    d /= 10
  }
}

// RFC 3339 in UTC from days since 1970 and the nanoseconds of the day (Hinnant's civil_from_days)
fn fmt_days(days: Int, sod: Int, ns: Int) -> Str {
  let z = days + 719468
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  var b = BytesBuilder.new()
  pad(b, y, 4)
  b.write_byte(45)
  pad(b, m, 2)
  b.write_byte(45)
  pad(b, d, 2)
  b.write_byte(84)
  pad(b, sod / 3600, 2)
  b.write_byte(58)
  pad(b, sod / 60 % 60, 2)
  b.write_byte(58)
  pad(b, sod % 60, 2)
  b.write_byte(46)
  pad(b, ns, 9)
  b.write_byte(90)
  b.freeze().to_str() ?? ""
}

fn fmt_one(n: Int) -> Str {
  var days = n / 86400000000000
  var rest = n % 86400000000000
  if rest < 0 {
    rest += 86400000000000
    days -= 1
  }
  fmt_days(days, rest / 1000000000, rest % 1000000000)
}

fn fmt_w(t: W) -> Str {
  let u = t.sec - UNIX_TO_INTERNAL
  var days = u / 86400
  var sod = u % 86400
  if sod < 0 {
    sod += 86400
    days -= 1
  }
  fmt_days(days, sod, t.nsec)
}

fn nanos(t: Time) -> Int { (t - Time.UNIX_EPOCH).nanos() }

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "add"
  let n0 = 4000000
  let n = if w == "add" || w == "sub" { n0 * 20 } else { n0 }
  var sum = 0
  let base = Time.from_unix(1700000000) + 123456789ns
  if w == "now" {
    for _ in 0..n {
      if WIDE {
        let t = w_from_unix_nanos(nanos(os.clock.now()))
        sum += t.nsec & 1
      } else {
        sum += nanos(os.clock.now()) & 1
      }
    }
    sum = 1
  } else if w == "add" {
    if WIDE {
      var t = w_from_unix_nanos(nanos(base))
      for i in 0..n {
        t = w_add(t, Duration.from_nanos(1500000001 - (i & 7) * 300000000))
      }
      sum = t.sec + t.nsec
    } else {
      var t = base
      for i in 0..n {
        t = t + Duration.from_nanos(1500000001 - (i & 7) * 300000000)
      }
      let x = nanos(t)
      sum = x / 1000000000 + UNIX_TO_INTERNAL + x % 1000000000
    }
  } else if w == "sub" {
    var ts: List[Time] = []
    for i in 0..1000 {
      ts.push(base + Duration.from_nanos(i * 987654321))
    }
    if WIDE {
      var ws: List[W] = []
      for t in ts {
        ws.push(w_from_unix_nanos(nanos(t)))
      }
      for i in 0..n {
        sum += w_sub(ws[i % 1000], ws[(i * 7) % 1000]).nanos() & 1023
      }
    } else {
      for i in 0..n {
        sum += (ts[i % 1000] - ts[(i * 7) % 1000]).nanos() & 1023
      }
    }
  } else if w == "sort" {
    var seed = 12345
    var ts: List[Time] = []
    for _ in 0..200000 {
      seed = (seed * 1103515245 + 12345) & 2147483647
      ts.push(base + Duration.from_nanos(seed * 1000003))
    }
    for _ in 0..5 {
      if WIDE {
        var ws: List[W] = []
        for t in ts {
          ws.push(w_from_unix_nanos(nanos(t)))
        }
        let s = ws.sort()
        sum += s[100].nsec & 1023
      } else {
        var ns: List[Time] = []
        for t in ts {
          ns.push(t)
        }
        let s = ns.sort()
        sum += nanos(s[100]) % 1000000000 & 1023
      }
    }
  } else if w == "format" {
    for i in 0..n / 4 {
      let t = base + Duration.from_nanos(i * 1234567891)
      let s = if WIDE { fmt_w(w_from_unix_nanos(nanos(t))) } else { fmt_one(nanos(t)) }
      sum += s.len() + Int(s.bytes()[18])
    }
  }
  os.stdio.println("${w} ${sum}")
}
