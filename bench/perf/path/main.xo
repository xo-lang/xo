// path: std/path against Go's path package (twin.go.txt): clean, join,
// the parts (split, dir, base, ext) and is_match (path.Match) over a fixed
// list of paths and patterns, 200,000 passes each. Usage:
// `<program> clean|join|parts|match`. Prints `<workload> <checksum>`; the
// twin prints the same.
use std/path

const PATHS: List[Str] = [
  "/a/b/../c/./d//e",
  "a/b/c/d.txt",
  "../../x/y/./z/",
  "/usr/local/share/man/man1/ls.1.gz",
  "dir//sub/./file.tar.gz",
  "/",
  "a",
  "/a/b/c/../../../../d",
]

const PATS: List[Str] = ["*.txt", "a/*/c?", "[a-z]*.gz", "/usr/*/share/*", "file.[tc]*", "*"]

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "clean"
  var sum = 0
  for i in 0..200000 {
    let p = PATHS[i % 8]
    if w == "clean" {
      sum += path.clean(p).len()
    } else if w == "join" {
      sum += path.join(p, PATHS[(i + 3) % 8]).len()
    } else if w == "parts" {
      let sp = path.split(p)
      sum += sp.0.len() + sp.1.len() + path.dir(p).len() + path.base(p).len() + path.ext(p).len()
      if path.is_abs(p) {
        sum += 1
      }
    } else {
      if path.is_match(PATS[i % 6], PATHS[(i + 1) % 8]).ok() ?? false {
        sum += 1
      }
      sum += i % 3
    }
  }
  os.stdio.println("${w} ${sum}")
}
