// Files and the clock over the OS layers in Xo (decisions 0206 and 0213):
// std/native/llrt/sysio.xo over linux.xo, darwin.xo, or windows.xo
// against their C path (XO_LLRT_C=sysio), and on Linux with XO_NOLIBC=1
// against the C library.
// Usage: sysio <workload> <scratch dir>, the directory only for this
// program. Workloads: read (os.fs.read of a 4 KiB file 20,000 times),
// read_big (a 1 MiB file 300 times), write (20,000 writes of a 100 byte
// file), stat (50,000 stats), clock (500,000 Clock.now), chan (200,000
// values from one task to another over an unbuffered channel: the
// runtime's threads, locks, and futex waits, decision 0206 stage 2),
// sleep (20,000 sleeps of 1us: the monotonic clock of the timers, work
// item B01), none (the setup alone). The Fs operations of
// std/native/llrt/fsops.xo (work item B16): dir (2,000 read_dir of 100
// files), lines (read_line over 200,000 lines of 40 bytes, 20 times),
// handle (20,000 open, read, close of the 4 KiB file), rename (20,000
// renames), lock (20,000 try_lock and unlock), tree (2,000
// create_dir_all and remove_all of a three level tree), copy (5,000
// copies of the 4 KiB file), mode (20,000 mode and set_mode). Each
// prints "<workload> <checksum>".
fn main(os: Os) ! {
  let args = os.env.args()
  let w = args.get(0) ?? "none"
  let fs = os.fs.sub(args.get(1) ?? "sysio-scratch")
  var small = BytesBuilder.new()
  for i in 0..4096 {
    small.write_byte(UInt8(97 + i % 26))
  }
  fs.write("small", small.freeze())?
  var sum = 0
  if w == "read" {
    for _ in 0..20000 {
      sum += fs.read("small")?.len()
    }
  } else if w == "read_big" {
    var big = BytesBuilder.new()
    for i in 0..(1 << 20) {
      big.write_byte(UInt8(i % 251))
    }
    fs.write("big", big.freeze())?
    for _ in 0..300 {
      sum += fs.read("big")?.len()
    }
  } else if w == "write" {
    let data = "x".repeat(100).bytes()
    for i in 0..20000 {
      fs.write("w${i % 8}", data)?
      sum += 1
    }
  } else if w == "stat" {
    for _ in 0..50000 {
      if let Some(fi) = fs.stat("small")? {
        sum += fi.size
      }
    }
  } else if w == "clock" {
    let t0 = os.clock.now()
    for _ in 0..500000 {
      if os.clock.now() >= t0 {
        sum += 1
      }
    }
  } else if w == "sleep" {
    for _ in 0..20000 {
      os.clock.sleep(1us)
      sum += 1
    }
  } else if w == "dir" {
    fs.create_dir_all("d")?
    for i in 0..100 {
      fs.write("d/f${i}", b"x")?
    }
    for _ in 0..2000 {
      sum += fs.read_dir("d")?.len()
    }
  } else if w == "lines" {
    var text = BytesBuilder.new()
    for i in 0..200000 {
      text.write_str("line ${i % 1000} of the lines workload..\n")
    }
    fs.write("lines", text.freeze())?
    for _ in 0..20 {
      let f = fs.open("lines")?
      while let Some(l) = f.read_line()? {
        sum += l.len()
      }
      f.close()?
    }
  } else if w == "handle" {
    for _ in 0..20000 {
      let f = fs.open("small")?
      sum += (f.read(8192)? ?? b"").len()
      f.close()?
    }
  } else if w == "rename" {
    fs.write("r0", b"x")?
    for i in 0..20000 {
      fs.rename("r${i % 2}", "r${(i + 1) % 2}")?
      sum += 1
    }
  } else if w == "lock" {
    for _ in 0..20000 {
      if let Some(l) = fs.try_lock("app.lock")? {
        l.unlock()
        sum += 1
      }
    }
  } else if w == "tree" {
    for _ in 0..2000 {
      fs.create_dir_all("t/a/b")?
      fs.remove_all("t")?
      sum += 1
    }
  } else if w == "copy" {
    for _ in 0..5000 {
      fs.copy("small", "copied")?
      sum += 1
    }
  } else if w == "mode" {
    for i in 0..20000 {
      fs.set_mode("small", if i % 2 == 0 { 0o600 } else { 0o644 })?
      sum += fs.mode("small")?
    }
  } else if w == "chan" {
    let ch = Chan[Int].new()
    sum = scope s {
      s.spawn(fn() {
        for i in 0..200000 {
          ch.send(i % 7)
        }
        ch.close()
      })
      var got = 0
      for v in ch {
        got += v
      }
      got
    }
  }
  os.stdio.println("${w} ${sum}")
}
