// csv: std/csv against Go's encoding/csv (twin.go.txt): 20,000 rows of six
// fields (quoted fields, a doubled quote, an empty field) parsed 10 times,
// the same rows formatted 10 times, and the same text read 10 times from a
// file one record at a time (`reader`); `none` is the text build alone.
// Usage: `<program> none|parse|format|reader`. Prints `<workload> <checksum>`; the
// twin prints the same.
use std/csv

fn text() -> Str {
  var b = StrBuilder.new()
  for i in 0..20000 {
    b.write("${i},name${i % 97},\"quoted, field ${i}\",,\"say \"\"hi\"\" ${i % 13}\",tail${i % 7}\n")
  }
  b.freeze()
}

fn main(os: Os) uses stdio, env, fs.read, fs.write {
  let w = os.env.args().get(0) ?? "none"
  let t = text()
  var sum = t.len()
  if w == "parse" {
    for _ in 0..10 {
      let rows = csv.parse(t).ok() ?? fault("parse")
      sum += rows.len() + rows[rows.len() - 1].len()
    }
  } else if w == "format" {
    let rows = csv.parse(t).ok() ?? fault("parse")
    for _ in 0..10 {
      sum += csv.format(rows).len()
    }
  }
  if w == "reader" {
    os.fs.write("csv_reader.tmp", t.bytes()).ok() ?? fault("write")
    for _ in 0..10 {
      let f = os.fs.open("csv_reader.tmp").ok() ?? fault("open")
      var r = csv.reader(f)
      var n = 0
      var last = 0
      while true {
        match r.read() {
          Ok(Some(rec)) => {
            n += 1
            last = rec.len()
          }
          Ok(None) => break
          Err(_) => fault("read")
        }
      }
      f.close().ignore_err("a read only handle")
      sum += n + last
    }
    os.fs.remove("csv_reader.tmp").ignore_err("scratch file")
  }
  os.stdio.println("${w} ${sum}")
}
