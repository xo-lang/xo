// RSA signatures and verifications (std/native/llrt/rsa.xo over
// bigmod.xo's Montgomery arithmetic) through internal.crypto_op, for
// the TLS server's RSA keys and certificate checks: PKCS #1 v1.5 with
// SHA-256 on fixed test keys of 2048 and 4096 bits (made by Go's
// crypto/rsa; test keys, not secrets). Usage: rsaperf <workload> with N
// in the environment (default 50); each workload prints "<workload>
// <checksum>": the signatures equal Go's, the verifications all pass.
use std/internal
use std/crypto

const PRIV2048 = ""
const PUB2048 = ""
const SIG2048 = ""
const PRIV4096 = ""
const PUB4096 = ""
const SIG4096 = ""

fn h(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

fn main(os: Os) {
  let w = os.env.args().get(0) ?? "none"
  let n = Int.parse(os.env.get("N") ?? "") ?? 50
  let digest = crypto.sha256(b"bench/perf/rsa")
  let sha256 = b"\x00"
  var ok = 0
  var last = b""
  match w {
    "sign2048" | "sign4096" => {
      let key = h(if w == "sign2048" { PRIV2048 } else { PRIV4096 })
      let want = h(if w == "sign2048" { SIG2048 } else { SIG4096 })
      for _ in 0..n {
        last = internal.crypto_op("rsa.sign_pkcs1", sha256, key, digest, b"")
        if last == want {
          ok += 1
        }
      }
    }
    "verify2048" | "verify4096" => {
      let key = h(if w == "verify2048" { PUB2048 } else { PUB4096 })
      let sig = h(if w == "verify2048" { SIG2048 } else { SIG4096 })
      for _ in 0..n {
        last = internal.crypto_op("rsa.verify_pkcs1", sha256, key, digest, sig)
        if last == b"\x01" {
          ok += 1
        }
      }
    }
    _ => {}
  }
  os.stdio.println("${w} ${ok} of ${n}")
}
