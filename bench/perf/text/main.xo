// Text workloads of the native runtime port (decision 0193): the number
// and time text (std/native/llrt/text.xo) against its C path
// (XO_LLRT_C=text), the Str operations (strings.xo, XO_LLRT_C=strings),
// the number text (num.xo, XO_LLRT_C=num), the leaf text of Debug
// (show.xo, XO_LLRT_C=show), and the zone rules of std/time (tz.xo,
// XO_LLRT_C=tz). Usage: textperf <workload>. Each workload prints
// "<workload> <checksum> <elapsed microseconds>"; the checksum must be
// the same on every backend (the Go backend is the reference).
use std/json
use std/time

/// A record whose Debug text has Runes and UInt64s in nested
/// collections (the debug workload).
struct Rec {
  id: UInt64
  mark: Rune
  runes: List[Rune]
  sizes: Map[Str, UInt64]
  pair: (Rune, UInt64)
}

const ROUNDS = 200

/// h and s mixed into a checksum.
fn mix(h: Int, s: Str) -> Int {
  let b = s.bytes()
  var x = (h * 31 + b.len()) % 1000000007
  if b.len() > 0 {
    x = (x * 31 + Int(b[b.len() / 2])) % 1000000007
  }
  x
}

/// n pseudo random values in 0..m (a linear congruential sequence).
fn values(n: Int, m: Int) -> List[Int] {
  var out: List[Int] = []
  var x = 12345
  for _ in 0..n {
    x = (x * 1103515245 + 12345) % 2147483648
    out.push(x % m)
  }
  out
}

fn parse_int(texts: List[Str]) -> Int {
  var sum = 0
  for _ in 0..ROUNDS {
    for t in texts {
      sum = (sum + (Int.parse(t) ?? 7)) % 1000000007
    }
  }
  sum
}

fn dur_fmt(ds: List[Duration]) -> Int {
  var h = 0
  for _ in 0..ROUNDS {
    for d in ds {
      h = mix(h, "${d}")
    }
  }
  h
}

fn dur_parse(texts: List[Str]) -> Int {
  var sum = 0
  for _ in 0..ROUNDS {
    for t in texts {
      match Duration.parse(t) {
        Ok(d) => sum = (sum + d.nanos() % 1000003) % 1000000007
        Err(_) => sum += 1
      }
    }
  }
  sum
}

fn time_fmt(ts: List[Time]) -> Int {
  var h = 0
  for _ in 0..ROUNDS {
    for t in ts {
      h = mix(h, "${t}")
    }
  }
  h
}

fn time_parse(doc: Str) -> Int {
  var sum = 0
  for _ in 0..ROUNDS / 4 {
    match json.decode_str[List[Time]](doc) {
      Ok(ts) => {
        for t in ts {
          sum = (sum + (t - Time.UNIX_EPOCH).nanos() % 1000003) % 1000000007
        }
      }
      Err(_) => sum += 1
    }
  }
  sum
}

fn quote(strs: List[Str], bs: List[Bytes]) -> Int {
  var h = 0
  for _ in 0..ROUNDS / 4 {
    for s in strs {
      h = mix(h, s.debug())
    }
    for b in bs {
      h = mix(h, b.debug())
    }
  }
  h
}

fn split(rows: List[Str]) -> Int {
  var h = 0
  for _ in 0..ROUNDS / 4 {
    for r in rows {
      let f = r.split(",")
      h = mix(h, f[f.len() / 2]) + f.len()
    }
  }
  h
}

fn lines(doc: Str) -> Int {
  var h = 0
  for _ in 0..ROUNDS * 2 {
    let ls = doc.lines()
    h = mix(h, ls[ls.len() / 3]) + ls.len()
  }
  h
}

fn replace(strs: List[Str]) -> Int {
  var h = 0
  for _ in 0..ROUNDS / 4 {
    for s in strs {
      h = mix(h, s.replace(" ", "_"))
      h = mix(h, s.replace("zz", "y"))
    }
  }
  h
}

fn trim(padded: List[Str]) -> Int {
  var h = 0
  for _ in 0..ROUNDS {
    for s in padded {
      h = mix(h, s.trim())
      h = mix(h, s.trim_end())
    }
  }
  h
}

fn rune_count(strs: List[Str]) -> Int {
  var sum = 0
  for _ in 0..ROUNDS {
    for s in strs {
      sum += s.rune_count()
    }
  }
  sum
}

fn int_fmt(xs: List[Int]) -> Int {
  var h = 0
  for _ in 0..ROUNDS {
    for x in xs {
      h = mix(h, "${x}")
    }
  }
  h
}

fn float_fmt(fs: List[Float]) -> Int {
  var h = 0
  for _ in 0..ROUNDS {
    for f in fs {
      h = mix(h, "${f}")
    }
  }
  h
}

fn float_parse(texts: List[Str]) -> Int {
  var h = 0
  for _ in 0..ROUNDS {
    for t in texts {
      let g = (Float.parse(t) ?? 0.5).abs()
      let big = if g > 1.0 { 7 } else { 3 }
      let frac = if g < 1e18 { Int((g - g.floor()) * 1000000.0) } else { 0 }
      h = (h * 31 + frac + big) % 1000000007
    }
  }
  h
}

fn base64(bs: List[Bytes]) -> Int {
  var h = 0
  for _ in 0..ROUNDS / 2 {
    for b in bs {
      let t = b.to_base64()
      h = mix(h, t)
      h = h + (Bytes.from_base64(t) ?? b"").len()
    }
  }
  h
}

fn hex(bs: List[Bytes]) -> Int {
  var h = 0
  for _ in 0..ROUNDS / 2 {
    for b in bs {
      let t = b.to_hex()
      h = mix(h, t)
      h = h + (Bytes.from_hex(t) ?? b"").len()
    }
  }
  h
}

fn debug(recs: List[Rec]) -> Int {
  var h = 0
  for _ in 0..ROUNDS / 4 {
    for r in recs {
      h = mix(h, r.debug())
    }
  }
  h
}

/// The zones of the zone workloads: DST in both hemispheres, a 30 minute
/// DST, odd offsets, historical rules, a negative DST.
fn zones() -> List[time.Zone] {
  var out: List[time.Zone] = []
  for r in [time.zone("Europe/Berlin"), time.zone("America/New_York"), time.zone("Australia/Lord_Howe"), time.zone("Asia/Kathmandu"), time.zone("America/Sao_Paulo"), time.zone("Europe/Dublin")] {
    match r {
      Ok(z) => out.push(z)
      Err(_) => {}
    }
  }
  out
}

fn zone_offset(ts: List[Time]) -> Int {
  let zs = zones()
  var h = 0
  for _ in 0..ROUNDS / 6 {
    for z in zs {
      for t in ts {
        h = (h * 31 + z.offset_at(t).nanos() / 1000000000) % 1000000007
      }
    }
  }
  h
}

fn zone_fmt(ts: List[Time]) -> Int {
  let zs = zones()
  var h = 0
  for _ in 0..ROUNDS / 24 {
    for z in zs {
      for t in ts {
        h = mix(h, time.format(t, z, time.RFC1123))
      }
    }
  }
  h
}

fn zone_civil(ts: List[Time]) -> Int {
  let zs = zones()
  var h = 0
  for _ in 0..ROUNDS / 24 {
    for z in zs {
      for t in ts {
        let c = time.civil(t, z)
        match time.instant(c.date, c.time, z, time.Ambiguity.Earlier) {
          Ok(back) => h = (h * 31 + back.unix() % 1000003) % 1000000007
          Err(_) => h += 1
        }
      }
    }
  }
  h
}

fn zone_load(names: List[Str]) -> Int {
  var h = 0
  for _ in 0..ROUNDS * 5 {
    for n in names {
      match time.zone(n) {
        Ok(z) => h = mix(h, z.name())
        Err(_) => h += 1
      }
    }
  }
  h
}

fn main(os: Os) {
  let args = os.env.args()
  let w = args.get(0) ?? "parse_int"
  let vs = values(1000, 1000000000)
  var ints: List[Str] = []
  var ds: List[Duration] = []
  var dtexts: List[Str] = []
  var ts: List[Time] = []
  var strs: List[Str] = []
  var bs: List[Bytes] = []
  var xs: List[Int] = []
  var fs: List[Float] = []
  var ftexts: List[Str] = []
  let scales = [1.0, 0.001, 0.000000001, 1000000000000.0, 1e-310, 1e300, 0.5, 3.0e-5]
  var i = 0
  for v in vs {
    // magnitudes from 1 to 10 digits, both signs
    let k = v % 10
    var x = v
    for _ in 0..k {
      x = x / 10
    }
    ints.push(if i % 2 == 0 { "${x}" } else { "-${x}" })
    // durations from nanoseconds to days
    var d = v
    for _ in 0..(i % 5) {
      d = d * 37
    }
    ds.push(Duration.from_nanos(if i % 3 == 0 { d / 1000 * 1000 } else { d }))
    dtexts.push(if i % 4 == 0 { "${x % 100}h${x % 60}m${x % 7}.5s" } else { "${Duration.from_nanos(d)}" })
    ts.push(Time.UNIX_EPOCH + Duration.from_nanos(v * 1700000003 + (if i % 2 == 0 { v } else { 0 })))
    strs.push(if i % 3 == 0 { "plain text ${v}" } else if i % 3 == 1 { "quote \"${v}\"\n\ttab é ${v}" } else { "ünï ${v} 日本語\u{1}\u{fffd}" })
    bs.push("bytes ${v} \u{1}".bytes())
    // Ints of 1 to 19 digits, both signs
    xs.push(if i % 4 == 3 { v * 9000000007 } else if i % 2 == 0 { x } else { 0 - x })
    // Floats from subnormal to 1e308, short and long digit strings
    let f = if i % 3 == 0 { Float(x) } else { Float(v) / Float(1 + i % 97) }
    fs.push(f * scales[i % 8])
    ftexts.push(if i % 5 == 0 { "${x}.${v % 1000}e${i % 40 - 20}" } else { "${f * scales[i % 8]}" })
    i += 1
  }
  let doc = json.encode_str(ts)
  var rows: List[Str] = []
  var padded: List[Str] = []
  for k in 0..1000 {
    rows.push(ints[k] + "," + strs[k] + ",x,," + dtexts[k] + ",tail")
    padded.push(if k % 2 == 0 { "  ${strs[k]} \t" } else { "\u{3000}${ints[k]}\n" })
  }
  let text = rows.join("\r\n")
  var recs: List[Rec] = []
  var zts: List[Time] = []
  let runes: List[Rune] = ['a', 'é', '\n', '€', '😀', '\'', 'Z', '日']
  let big: UInt64 = 18446744073709551615
  for k in 0..1000 {
    let v = vs[k]
    let u = UInt64(v) * UInt64(1 + v % 9000000000)
    var rl: List[Rune] = []
    for j in 0..(4 + k % 5) {
      rl.push(runes[(k + j) % 8])
    }
    recs.push(Rec{id: if k % 3 == 0 { big - u } else { u }, mark: runes[k % 8], runes: rl, sizes: {"a": u, "b": big / (u + 1)}, pair: (runes[(k + 3) % 8], UInt64(v))})
    // 1900 to 2100: historical transitions, the footer, and now
    zts.push(Time.UNIX_EPOCH + Duration.from_secs_int(v * 6 - 2208988800 + (if k % 4 == 0 { 0 } else { 3600 * (k % 24) })))
  }
  let znames = ["Europe/Berlin", "America/New_York", "Australia/Lord_Howe", "Asia/Kathmandu", "America/Sao_Paulo", "Europe/Dublin", "Mars/Olympus"]
  let t = os.clock.now()
  let sum = match w {
    "parse_int" => parse_int(ints)
    "dur_fmt" => dur_fmt(ds)
    "dur_parse" => dur_parse(dtexts)
    "time_fmt" => time_fmt(ts)
    "time_parse" => time_parse(doc)
    "quote" => quote(strs, bs)
    "split" => split(rows)
    "lines" => lines(text)
    "replace" => replace(strs)
    "trim" => trim(padded)
    "rune_count" => rune_count(strs)
    "int_fmt" => int_fmt(xs)
    "float_fmt" => float_fmt(fs)
    "float_parse" => float_parse(ftexts)
    "base64" => base64(bs)
    "hex" => hex(bs)
    "debug" => debug(recs)
    "zone_offset" => zone_offset(zts)
    "zone_fmt" => zone_fmt(zts)
    "zone_civil" => zone_civil(zts)
    "zone_load" => zone_load(znames)
    _ => -1
  }
  let us = os.clock.since(t).nanos() / 1000
  os.stdio.println("${w} ${sum} ${us}")
}
