// bench/perf/llvm/xo/sieve with the marking loop in its own function:
// the caller allocates and fills the List (Go code in a hybrid build),
// `mark` writes it in place without allocating, so `xo build --hybrid`
// compiles it to Go assembler (decision 0084). Same output as sieve.
fn mark(var flags: List[Bool], n: Int) -> Int {
  var count = 0
  for i in 2..n + 1 {
    if flags[i] {
      count += 1
      var j = i * i
      while j <= n {
        flags[j] = false
        j += i
      }
    }
  }
  count
}

fn sieve(n: Int) -> Int {
  var flags: List[Bool] = []
  for _ in 0..n + 1 {
    flags.push(true)
  }
  mark(flags, n)
}

fn main(os: Os) {
  var total = 0
  for _ in 0..5 {
    total += sieve(10000000)
  }
  os.stdio.println("sieve ${total}")
}
