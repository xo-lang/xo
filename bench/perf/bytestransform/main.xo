// Bytes.replace, replace_n, to_lower, to_upper, equal_fold and repeat
// workloads against Go's bytes package (the twin is twin.go.txt): texts
// with ASCII, multi byte, invalid UTF-8 and empty values, old and new of
// every kind (an absent one, an empty one, a multi byte one), and counts
// of every kind. The workload is picked once, outside the loop.
// Usage: bytestransform <workload>; prints "<workload> <checksum>", the
// same line the Go twin prints.

const N = 200000

const TEXTS: List[Bytes] = [
  b"  the quick brown fox, jumps over the lazy dog  ",
  b"1,2,3,4",
  b"héllo, wörld, ça va, 日本語 テキスト   ",
  b"  \t  mixed ascii and ✓ unicode ✓  ",
  b"abcabcabcabcabcabcabc",
  b"a\xffb, c\x80 ,",
]

const OLDS: List[Bytes] = [b"a", b",", b"abc", b"", b"\xff"]
const NEWS: List[Bytes] = [b"", b"X", b"<>", b"é"]
const FOLDS: List[Bytes] = [b"HELLO", b"1,2,3,4", b"ABCABCABCABCABCABCABC", b"✓", b"\xfe"]
const NS: List[Int] = [1, 0, -1, 2, 1000]
const REPEATS: List[Int] = [0, 1, 2, 3]

fn replace_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].replace(OLDS[i % OLDS.len()], NEWS[i % NEWS.len()]).len()
  }
  n
}

fn replace_n_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].replace_n(OLDS[i % OLDS.len()], NEWS[i % NEWS.len()], NS[i % NS.len()]).len()
  }
  n
}

fn lower_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].to_lower().len()
  }
  n
}

fn upper_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].to_upper().len()
  }
  n
}

fn fold_all() -> Int {
  var n = 0
  for i in 0..N {
    if TEXTS[i % TEXTS.len()].equal_fold(FOLDS[i % FOLDS.len()]) {
      n += 1
    }
  }
  n
}

fn repeat_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].repeat(REPEATS[i % REPEATS.len()]).len()
  }
  n
}

// index_all is the loop's own cost, the two table lookups and the lengths,
// with no transform, so a row can be read net of it.
fn index_all() -> Int {
  var n = 0
  for i in 0..N {
    n += TEXTS[i % TEXTS.len()].len() + OLDS[i % OLDS.len()].len()
  }
  n
}

fn main(os: Os) {
  let args = os.env.args()
  let w = if args.len() > 0 { args[0] } else { "none" }
  var n = 0
  if w == "replace" {
    n = replace_all()
  } else if w == "replace_n" {
    n = replace_n_all()
  } else if w == "lower" {
    n = lower_all()
  } else if w == "upper" {
    n = upper_all()
  } else if w == "fold" {
    n = fold_all()
  } else if w == "repeat" {
    n = repeat_all()
  } else if w == "index" {
    n = index_all()
  }
  os.stdio.println("${w} ${n}")
}
