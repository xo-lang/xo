// crc32: std/crc32 against Go's hash/crc32 (twin.go.txt), decision 0616's
// perf kind for std/crc32: crc32 and crc32c checksum a 64 KiB buffer 2,000
// times (the crc32 rows of bench/perf/hash), keys and keysc checksum
// 2,000,000 keys of 8 to 40 bytes (the short input path), and update
// feeds the 64 KiB buffer in 1 KiB chunks 2,000 times (IEEE); `none` is
// the setup alone. Usage: `<program> none|crc32|crc32c|keys|keysc|update`.
// Prints `<workload> <checksum>`; the twin prints the same.
use std/crc32

fn buffer(n: Int) -> Bytes {
  var b = BytesBuilder.new()
  var x = 12345
  for _ in 0..n {
    x = (x * 1103515245 + 12345) % 2147483648
    b.write_byte(UInt8((x >> 16) & 255))
  }
  b.freeze()
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "none"
  let big = buffer(65536)
  let keys = buffer(4096)
  var sum = 0
  if w == "crc32" || w == "crc32c" {
    let p = if w == "crc32" { crc32.Poly.Ieee } else { crc32.Poly.Castagnoli }
    for i in 0..2000 {
      sum = sum ^ crc32.checksum(big, p) ^ i
    }
  } else if w == "keys" || w == "keysc" {
    let p = if w == "keys" { crc32.Poly.Ieee } else { crc32.Poly.Castagnoli }
    for i in 0..2000000 {
      let at = i % 4000
      sum = sum ^ crc32.checksum(keys[at..at + 8 + i % 33], p)
    }
  } else if w == "update" {
    for i in 0..2000 {
      var c = 0
      var at = 0
      while at < big.len() {
        c = crc32.update(c, big[at..at + 1024])
        at += 1024
      }
      sum = sum ^ c ^ i
    }
  } else {
    sum = big.len() + keys.len()
  }
  os.stdio.println("${w} ${sum}")
}
