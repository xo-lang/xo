// std/protowire (internal to std/protodesc, std/protowkt and
// std/protojson; its pub functions only) against
// google.golang.org/protobuf/encoding/protowire: a flat message of 30,000
// fields (a varint of up to five bytes, a string and a varint that is
// negative on every seventh, ten bytes) written 300 times (`write`) and
// walked 300 times (`walk`: the fields, the varint fields and the bytes of
// the string fields as checked UTF-8 text); `none` is the setup alone.
// Usage: `<program> none|write|walk`. Prints `<workload> <checksum>`; the
// twin (twin.go.txt) prints the same.
use std/protowire

fn doc() -> Bytes {
  var o = BytesBuilder.with_capacity(256 * 1024)
  for i in 0..10000 {
    protowire.wi(o, 1, i * i * 37)
    protowire.ws(o, 2, "record ${i}")
    protowire.wia(o, 3, if i % 7 == 0 { -i } else { i % 3 })
  }
  o.freeze()
}

fn walk(b: Bytes) -> Int {
  let fs = protowire.walk(b).ok() ?? fault("walk")
  var sum = fs.len()
  for f in fs {
    if protowire.is_v(f) {
      sum += 1
    } else if protowire.is_s(f) {
      sum += (protowire.text(f).ok() ?? fault("text")).len()
    }
  }
  sum
}

fn main(os: Os) uses stdio, env {
  let w = os.env.args().get(0) ?? "walk"
  let data = doc()
  var sum = data.len()
  if w == "write" {
    for _ in 0..300 {
      sum += doc().len()
    }
  } else if w == "walk" {
    for _ in 0..300 {
      sum += walk(data)
    }
  }
  os.stdio.println("${w} ${sum}")
}
