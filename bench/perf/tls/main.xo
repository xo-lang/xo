// The client of bench/perf/tls (TLS performance, decision 0202): N
// requests with std/http's client over TLS to the listener of serve/
// for workload W, at 127.0.0.1 on PORT plus its offset. A handshake
// workload (x25519, x25519only, p256, p384, p521, rsa2048, ed25519, tls12) gets /hs, a
// connection and full handshake each; a bulk workload (aes128, aes256,
// chacha over TLS 1.2, aes128tls13) gets /big with SIZE bytes, so the
// records' decryption is the measured work. The CA is the PEM file CA.
// Prints the bytes of the bodies it got.
use std/http

fn offset(w: Str) -> Int {
  match w {
    "x25519" | "x25519only" => 0
    "p256" => 1
    "p384" => 2
    "rsa2048" => 3
    "ed25519" => 4
    "tls12" => 5
    "aes128" => 6
    "aes256" => 7
    "chacha" => 8
    "aes128tls13" => 9
    "p521" => 10
    _ => -1
  }
}

fn main(os: Os) ! {
  let w = os.env.get("W") ?? "x25519"
  let n = Int.parse(os.env.get("N") ?? "10") ?? 10
  let port = Int.parse(os.env.get("PORT") ?? "18120") ?? 18120
  let size = Int.parse(os.env.get("SIZE") ?? "16777216") ?? 16777216
  let ca = os.fs.read(os.env.get("CA") ?? "ca.pem")?
  let c = http.client(os.net).with_roots(ca).or_fault("roots")
  let off = offset(w)
  if off < 0 {
    os.stdio.println("error: unknown workload ${w}")
    return
  }
  let path = if off >= 6 && off <= 9 { "big?n=${size}" } else { "hs" }
  let url = "https://127.0.0.1:${port + off}/${path}"
  var total = 0
  for _ in 0..n {
    match c.get(url) {
      Ok(r) => total += r.body.len()
      Err(e) => {
        os.stdio.println("error: ${e}")
        return
      }
    }
  }
  os.stdio.println("${total}")
}
