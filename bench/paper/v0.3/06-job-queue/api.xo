// HTTP API over the queue.

use std/http
use std/json

struct EnqueueReq {
  payload: Bytes
  priority: Int = 0
  idempotency_key: Str?
} derive Json

struct EnqueueResp {
  id: Str
} derive Json

struct JobView {
  id: Str
  state: JobState
  attempts: Int
  last_error: Str?
} derive Json

enum ApiErr {
  BadRequest(from json.DecodeErr)
  QueueOp(from QueueErr)
}

fn (e: ApiErr) status() -> Int {
  match e {
    BadRequest(_) => 400
    QueueOp(NotFound(..) | NotDead(..)) => 404
    QueueOp(StaleToken(..)) => 409
  }
}

fn (e: ApiErr) display() -> Str {
  match e {
    BadRequest(inner) => "invalid request body: ${inner}"
    QueueOp(inner) => inner.display()
  }
}

pub fn routes(q: Queue) -> http.Router uses clock {
  var r = http.router()
  r.handle("POST /jobs", fn(req) -> http.Response ! ApiErr {
    let body = req.json[EnqueueReq]()?
    let res = q.enqueue(body.payload, body.priority, idempotency_key: body.idempotency_key)
    let status = if res.created { 201 } else { 200 }
    http.json(status, EnqueueResp{id: res.id})
  })
  r.handle("GET /jobs/{id}", fn(req) -> http.Response ! ApiErr {
    let job = q.get(req.param("id"))?
    http.json(200, JobView{
      id: job.id,
      state: job.state,
      attempts: job.attempts,
      last_error: job.last_error,
    })
  })
  // GUESS: a handler that cannot fail infers E = Never, and Never satisfies
  // the `E: Error` bound of `handle` (6.2 subsumption covers values, not bounds).
  r.handle("GET /stats", fn(_req) { http.json(200, q.stats()) })
  r.handle("POST /dead/{id}/retry", fn(req) -> http.Response ! ApiErr {
    let id = req.param("id")
    q.retry_dead(id)?
    http.json(200, {"id": id, "state": "Queued"})
  })
  r
}
