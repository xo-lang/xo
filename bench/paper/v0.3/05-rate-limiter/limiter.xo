use std/http
use std/log

/// Bucket size and refill speed for one client key.
pub struct Limit {
  pub capacity: Int
  pub refill_per_sec: Float
}

pub const DEFAULT_LIMIT = Limit{capacity: 20, refill_per_sec: 5.0}
pub const IDLE_TTL = 10m
pub const EVICT_EVERY = 1m

/// Token bucket. `last` is the last refill time, which is also the last
/// time the bucket was used.
pub struct Bucket {
  capacity: Int
  tokens: Float
  refill_per_sec: Float
  last: Time
} invariant tokens >= 0.0 && tokens <= Float(capacity)

pub fn new_bucket(limit: Limit, now: Time) -> Bucket
  requires limit.capacity > 0
  requires limit.refill_per_sec > 0.0
{
  Bucket{
    capacity: limit.capacity,
    tokens: Float(limit.capacity),
    refill_per_sec: limit.refill_per_sec,
    last: now,
  }
}

fn (var b: Bucket) refill(now: Time) {
  let elapsed = now - b.last
  if elapsed > 0s {
    b.tokens = (b.tokens + elapsed.seconds() * b.refill_per_sec).min(Float(b.capacity))
    b.last = now
  }
}

/// Refills based on elapsed time, then consumes one token if available.
pub fn (var b: Bucket) take(now: Time) -> Bool {
  b.refill(now)
  if b.tokens >= 1.0 {
    // GUESS: `-=` exists; the spec only shows `+=` (core 3.1).
    b.tokens -= 1.0
    true
  } else {
    false
  }
}

/// Whole seconds until one token is available, at least 1.
pub fn (b: Bucket) retry_after() -> Int {
  let need = 1.0 - b.tokens
  Int((need / b.refill_per_sec).ceil()).max(1)
}

pub enum Decision {
  Allowed
  Limited(retry_after: Int)
}

pub struct Limiter {
  buckets: Mutex[Map[Str, Bucket]]
  limits: Map[Str, Limit]
  default_limit: Limit
}

pub fn new_limiter(limits: Map[Str, Limit] = {}, default_limit: Limit = DEFAULT_LIMIT) -> Limiter {
  Limiter{buckets: Mutex.new({}), limits: limits, default_limit: default_limit}
}

pub fn (l: Limiter) limit_for(key: Str) -> Limit {
  l.limits.get(key) ?? l.default_limit
}

/// Takes one token from the bucket for `key`, creating it on first use.
pub fn (l: Limiter) check(key: Str, now: Time) -> Decision {
  let limit = l.limit_for(key)
  l.buckets.with(fn(var m) {
    m.update(key, new_bucket(limit, now), fn(var b) {
      if b.take(now) {
        Decision.Allowed
      } else {
        Decision.Limited(retry_after: b.retry_after())
      }
    })
  })
}

/// Removes buckets idle for more than `idle`. Returns how many were removed.
pub fn (l: Limiter) evict_idle(now: Time, idle: Duration) -> Int {
  l.buckets.with(fn(var m) {
    let before = m.len()
    m = m.filter(fn(_key, b) { now - b.last <= idle })
    before - m.len()
  })
}

pub fn (l: Limiter) size() -> Int {
  l.buckets.with(fn(m) { m.len() })
}

/// Evicts idle buckets every EVICT_EVERY. Runs until its task is cancelled
/// (the sleep unwinds on cancellation).
pub fn run_evictor(l: Limiter, clock: Clock) uses clock {
  while {
    clock.sleep(EVICT_EVERY)
    let n = l.evict_idle(clock.now(), IDLE_TTL)
    if n > 0 {
      log.info("evicted idle buckets", {"count": n})
    }
  }
}

/// The client key: the X-Api-Key header, or the remote IP if missing.
pub fn client_key(req: http.Request) -> Str {
  req.header("X-Api-Key") ?? req.remote_ip
}

// GUESS: a pub fn that only builds and returns a closure needs no `uses`
// clause itself; the effect lives in the returned function type (core 6.2
// does not say whether creating a closure counts as performing its effects).
pub fn rate_limit(l: Limiter, clock: Clock) -> fn(http.Request, http.Next) -> http.Response uses clock {
  fn(req, next) {
    match l.check(client_key(req), clock.now()) {
      Allowed => next(req)
      Limited(retry_after: secs) => http.json(429, {"error": "rate limited"})
        .with_header("Retry-After", "${secs}")
    }
  }
}
