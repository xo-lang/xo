use std/http
use std/log

fn routes(l: Limiter, clock: Clock) -> http.Router uses clock {
  var r = http.router()
  r.wrap(rate_limit(l, clock))
  r.handle(r"GET /hello", fn(_req) { http.json(200, {"msg": "hi"}) })
  r
}

fn main(os: Os) ! {
  let custom = {
    "partner-key": Limit{capacity: 100, refill_per_sec: 50.0},
  }
  let limiter = new_limiter(DEFAULT_LIMIT, custom)
  let srv = http.server(os.net.listen(":8080")?, routes(limiter, os.clock))
  log.info("listening", {"addr": ":8080"})
  // GUESS: the spec does not say how a process signal (SIGTERM) stops
  // `serve`; assumed the runtime cancels the root scope, so `serve` returns
  // Ok(()), the body ends, and the background evictor is cancelled with it.
  scope s {
    s.spawn_background(fn() { run_evictor(limiter, os.clock) })
    srv.serve()?
  }
}
