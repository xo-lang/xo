use std/http
use std/log

/// Per key limit: bucket size and refill rate in tokens per second.
pub struct Limit {
  pub capacity: Int
  pub refill_per_sec: Float
} invariant capacity > 0 && refill_per_sec > 0.0

pub const DEFAULT_LIMIT = Limit{capacity: 20, refill_per_sec: 5.0}
pub const IDLE_TTL = 10m
pub const EVICT_EVERY = 1m

/// A token bucket. `tokens` is fractional so slow refill rates accumulate.
pub struct Bucket {
  pub capacity: Float
  pub tokens: Float
  pub refill_per_sec: Float
  pub last: Time
} invariant tokens >= 0.0 && tokens <= capacity

pub fn new_bucket(limit: Limit, now: Time) -> Bucket {
  let cap = Float(limit.capacity)
  Bucket{capacity: cap, tokens: cap, refill_per_sec: limit.refill_per_sec, last: now}
}

fn (var b: Bucket) refill(now: Time) {
  if now > b.last {
    let gained = (now - b.last).seconds() * b.refill_per_sec
    // GUESS: Float is Ord (std 1 says "builtin scalar types" are Ord), so
    // `min` exists on Float even though NaN has no ordering.
    b.tokens = (b.tokens + gained).min(b.capacity)
    b.last = now
  }
}

/// Refills from elapsed time, then consumes one token if available.
pub fn (var b: Bucket) take(now: Time) -> Bool {
  b.refill(now)
  if b.tokens >= 1.0 {
    b.tokens -= 1.0
    true
  } else {
    false
  }
}

/// Whole seconds until one token is available, at least 1.
pub fn (b: Bucket) retry_after_secs() -> Int {
  let wait = (1.0 - b.tokens) / b.refill_per_sec
  Int(wait.ceil()).max(1)
}

pub enum Decision {
  Allowed
  Denied(retry_after: Int)
}

/// One bucket per client key, shared across request tasks.
pub struct Limiter {
  buckets: Mutex[Map[Str, Bucket]]
  default_limit: Limit
  custom: Map[Str, Limit]
}

pub fn new_limiter(default_limit: Limit, custom: Map[Str, Limit]) -> Limiter {
  Limiter{buckets: Mutex.new({}), default_limit: default_limit, custom: custom}
}

// GUESS: touching a Mutex is not an effect, so a pub fn that only locks a
// Mutex needs no `uses` clause (6.1 calls such a function "pure").
pub fn (l: Limiter) check(key: Str, now: Time) -> Decision {
  let limit = l.custom.get(key) ?? l.default_limit
  l.buckets.with(fn(var m) {
    m.update(key, new_bucket(limit, now), fn(var b) {
      if b.take(now) {
        Decision.Allowed
      } else {
        Decision.Denied(retry_after: b.retry_after_secs())
      }
    })
  })
}

/// Removes buckets whose last refill is more than `idle` before `now`.
/// Returns how many were removed.
pub fn (l: Limiter) evict_idle(now: Time, idle: Duration) -> Int {
  l.buckets.with(fn(var m) {
    let before = m.len()
    m = m.filter(fn(_key, b) { now - b.last <= idle })
    before - m.len()
  })
}

pub fn (l: Limiter) keys() -> List[Str] {
  l.buckets.with(fn(m) { m.keys() })
}

/// Evicts idle buckets every EVICT_EVERY. Runs until its task is cancelled:
/// `clock.sleep` unwinds the task on cancellation (core 7.2).
pub fn run_evictor(l: Limiter, clock: Clock) uses clock {
  while {
    clock.sleep(EVICT_EVERY)
    let n = l.evict_idle(clock.now(), IDLE_TTL)
    if n > 0 {
      log.debug("evicted idle buckets", {"count": n})
    }
  }
}

/// Client key: the X-Api-Key header, or the remote IP when missing.
fn client_key(req: http.Request) -> Str {
  req.header("X-Api-Key") ?? req.remote_ip
}

/// Middleware that answers 429 with Retry-After when the client's bucket is empty.
pub fn rate_limit(l: Limiter, clock: Clock) -> fn(http.Request, http.Next) -> http.Response uses clock {
  fn(req, next) {
    match l.check(client_key(req), clock.now()) {
      Allowed => next(req)
      Denied(retry_after) => {
        let resp = http.json(429, {"error": "rate limit exceeded"})
        resp.with_header("Retry-After", "{retry_after}")
      }
    }
  }
}
