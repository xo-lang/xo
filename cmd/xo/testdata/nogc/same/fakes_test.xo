// MemFs, FakeProc, and os.tasks in native test binaries (decisions 0107,
// 0108, 0109): the report is the Go backend's, line for line.

fn save(fs: Fs, name: Str, text: Str) -> () ! FsErr uses fs.write {
  fs.write("data/${name}", text.bytes())
}

test "memfs writes, reads, lists" {
  os.fs.write("a/b/c.txt", b"hi")?
  expect(os.fs.read_text("a/b/c.txt")?) == "hi"
  expect(os.fs.exists("a/b")?)
  expect(os.fs.exists("a/zz")?) == false
  let sub = os.fs.sub("a")
  expect(sub.read_text("b/c.txt")?) == "hi"
  expect(sub.read("../x")) == Err(FsErr.Denied(path: "../x"))
  os.fs.fail_next(testing.FsOp.Write, "a/*.txt", FsErr.Io(path: "a", msg: "disk full"))
  expect(os.fs.write("a/x.txt", b"1")) == Err(FsErr.Io(path: "a", msg: "disk full"))
  os.fs.write("a/x.txt", b"1")?
  expect(os.fs.files().keys()) == ["a/b/c.txt", "a/x.txt"]
  os.fs.rename("a/x.txt", "a/y.txt")?
  expect(os.fs.read_dir("a")?.map(fn(f) { f.name })) == ["b", "y.txt"]
  expect(os.fs.walk("")?.map(fn(f) { "${f.path} ${f.is_dir} ${f.size}" })) == ["a true 0", "a/b true 0", "a/b/c.txt false 2", "a/y.txt false 1"]
  expect(os.fs.remove("a")) == Err(FsErr.NotEmpty(path: "a"))
  expect(os.fs.remove("nope")) == Err(FsErr.NotFound(path: "nope"))
  os.fs.remove_all("a")?
  expect(os.fs.files().is_empty())
  expect(os.fs.stat("missing")?) == None
}

test "memfs errors and views" {
  os.fs.write("f", b"x")?
  expect(os.fs.write("f/g", b"y")) == Err(FsErr.NotDir(path: "f"))
  expect(os.fs.read_dir("f")) == Err(FsErr.NotDir(path: "f"))
  expect(os.fs.read("")) == Err(FsErr.IsDir(path: ""))
  expect(os.fs.read_only().write("z", b"1")) == Err(FsErr.Denied(path: "z"))
  expect(os.fs.write_only().read("f")) == Err(FsErr.Denied(path: "f"))
  os.fs.create_dir_all("d/e")?
  let t = os.fs.create_temp("d", "tmp")?
  expect(t) == "d/tmp000001"
  expect(os.fs.create_temp("nope", "x")) == Err(FsErr.NotFound(path: "nope"))
  os.fs.rename("d", "moved")?
  expect(os.fs.files().keys()) == ["f", "moved/tmp000001"]
  let st = os.fs.stat("moved/e")?
  expect(st.map(fn(i) { "${i.name} ${i.path} ${i.is_dir}" })) == Some("e moved/e true")
  os.fs.set_modified("f", Time.from_unix(5))?
  expect((os.fs.stat("f")?).map(fn(i) { i.modified.unix() })) == Some(5)
  save(os.fs, "one.txt", "1")?
  expect(os.fs.read_text("data/one.txt")?) == "1"
  expect(os.fs.case_sensitive())
  os.fs.set_case_sensitive(false)
  expect(os.fs.read_text("DATA/ONE.TXT")?) == "1"
  os.fs.fail_next(testing.FsOp.Read, "data/one.txt", FsErr.Canceled)
  expect(os.fs.read("data/one.txt")) == Err(FsErr.Canceled)
  let denied = os.fs.sub("d2").sub("../..")
  expect(denied.read("x")) == Err(FsErr.Denied(path: "x"))
}

test "memfs modified time is the virtual clock" {
  os.clock.sleep(3s)
  os.fs.write("t.txt", b"")?
  let info = os.fs.stat("t.txt")?
  expect(info.map(fn(i) { "${i.modified}" })) == Some("2026-01-01T00:00:03Z")
}

test "fake proc run" {
  os.proc.on_run("git", ProcOutput{code: 0, stdout: b"abc\n", stderr: b""})
  let out = os.proc.run("git", ["rev-parse", "HEAD"])?
  expect(out.stdout) == b"abc\n"
  expect(out.code) == 0
  expect(os.proc.run("make", [])) == Err(ProcErr.NotFound(cmd: "make"))
  os.proc.on_run("git", ProcOutput{code: 2, stdout: b"", stderr: b"bad"})
  expect((os.proc.run("git", [])?).code) == 2
}

fn num(s: Str) -> Int ! Str {
  match Int.parse(s) {
    Some(n) => n
    None => Err("not a number: ${s}")
  }
}

test "os.tasks ends with the test" {
  os.tasks.spawn_background(fn() {
    os.clock.sleep(1h)
  })
  let h = os.tasks.spawn(fn() { 4 })
  expect(h.await) == 4
  let ch = Chan[Int].new(1)
  os.tasks.spawn(fn() ! {
    ch.send(num("6")?)
  })
  expect(ch.recv()) == Some(6)
}

test "a failing os.tasks task fails the test" {
  os.tasks.spawn(fn() ! {
    os.clock.sleep(1s)
    let _n = num("x")?
  })
  expect(true)
}

test "memfs symbolic links" {
  os.fs.write("d/f.txt", b"data")?
  os.fs.symlink("f.txt", "d/l")?
  os.fs.symlink("/d", "top")?
  expect(os.fs.read_link("d/l")?) == Some("f.txt")
  expect(os.fs.read_link("top")?) == Some("/d")
  expect(os.fs.read_link("d/f.txt")?) == None
  expect(os.fs.read_link("nope")) == Err(FsErr.NotFound(path: "nope"))
  expect(os.fs.read_text("d/l")?) == "data"
  expect(os.fs.stat("d/l")?.map(fn(f) { "${f.name} ${f.path} ${f.is_dir} ${f.size}" })) == Some("l d/l false 4")
  expect(os.fs.stat("top")?.map(fn(f) { "${f.name} ${f.path} ${f.is_dir}" })) == Some("top top true")
  expect(os.fs.symlink("x", "d/l")) == Err(FsErr.Exists(path: "d/l"))
  os.fs.symlink("gone", "d/dead")?
  expect(os.fs.exists("d/dead")?) == false
  os.fs.symlink("b", "a")?
  os.fs.symlink("a", "b")?
  expect(os.fs.stat("a")?) == None
  let sub = os.fs.sub("d")
  expect(sub.read_link("l")?) == Some("f.txt")
  expect(sub.symlink("/x", "m")) == Err(FsErr.Denied(path: "m"))
  expect(sub.symlink("../f.txt", "n")) == Err(FsErr.Denied(path: "n"))
}

/// The error of a result whose value is a handle: a File or FileLock has
/// no equality (decision 0112, XO0404), so the error is compared alone.
fn err_of[T](r: Result[T, FsErr]) -> FsErr? {
  match r {
    Ok(_) => None
    Err(e) => Some(e)
  }
}

test "memfs open, create, and open_append" {
  os.fs.write("h/a.txt", b"one\ntwo\r\nthree")?
  let r = os.fs.open("h/a.txt")?
  expect(r.read_line()?) == Some("one")
  expect(r.read(2)?) == Some(b"tw")
  expect(r.read_line()?) == Some("o")
  expect(r.read(0)?) == Some(b"")
  expect(r.read(100)?) == Some(b"three")
  expect(r.read(100)?) == None
  expect(r.read_line()?) == None
  expect(r.write(b"x")) == Err(FsErr.Io(path: "h/a.txt", msg: "file is open for reading"))
  r.close()?
  r.close()?
  expect(r.read(1)) == Err(FsErr.Io(path: "h/a.txt", msg: "file already closed"))
  expect(err_of(os.fs.open("h/none"))) == Some(FsErr.NotFound(path: "h/none"))
  expect(err_of(os.fs.open("h"))) == Some(FsErr.IsDir(path: "h"))
  let w = os.fs.create("h/new/b.txt")?
  w.write(b"ab")?
  expect(os.fs.read_text("h/new/b.txt")?) == "ab"
  w.write(b"cd")?
  expect(w.read(1)) == Err(FsErr.Io(path: "h/new/b.txt", msg: "file is open for writing"))
  w.close()?
  expect(os.fs.read_text("h/new/b.txt")?) == "abcd"
  let t = os.fs.create("h/new/b.txt")?
  t.close()?
  expect(os.fs.read_text("h/new/b.txt")?) == ""
  // a write handle writes again after a remove (std/rt memFileH.write)
  let gone = os.fs.create("h/gone.txt")?
  os.fs.remove("h/gone.txt")?
  gone.write(b"back")?
  gone.close()?
  expect(os.fs.read_text("h/gone.txt")?) == "back"
  let ap = os.fs.open_append("h/a.txt")?
  ap.write(b"!")?
  ap.close()?
  expect(os.fs.read_text("h/a.txt")?) == "one\ntwo\r\nthree!"
  expect(err_of(os.fs.create("h"))) == Some(FsErr.IsDir(path: "h"))
  expect(err_of(os.fs.create("h/a.txt/x"))) == Some(FsErr.NotDir(path: "h/a.txt"))
  // a read handle keeps the contents at open
  let snap = os.fs.open("h/a.txt")?
  os.fs.write("h/a.txt", b"changed")?
  expect(snap.read(100)?) == Some(b"one\ntwo\r\nthree!")
  os.fs.fail_next(testing.FsOp.Read, "h/*", FsErr.Io(path: "h", msg: "bad sector"))
  expect(err_of(os.fs.open("h/a.txt"))) == Some(FsErr.Io(path: "h", msg: "bad sector"))
  os.fs.fail_next(testing.FsOp.Write, "h/*", FsErr.Io(path: "h", msg: "disk full"))
  expect(err_of(os.fs.create("h/c.txt"))) == Some(FsErr.Io(path: "h", msg: "disk full"))
  os.fs.symlink("a.txt", "h/l")?
  let via_link = os.fs.open("h/l")?
  expect(via_link.read(100)?) == Some(b"changed")
}

test "memfs append" {
  os.fs.append("p/log.txt", b"a")?
  os.fs.append("p/log.txt", b"b")?
  expect(os.fs.read_text("p/log.txt")?) == "ab"
  expect(os.fs.append("p", b"x")) == Err(FsErr.IsDir(path: "p"))
  os.fs.fail_next(testing.FsOp.Write, "p/*", FsErr.Io(path: "p", msg: "disk full"))
  expect(os.fs.append("p/log.txt", b"c")) == Err(FsErr.Io(path: "p", msg: "disk full"))
  expect(os.fs.read_only().append("p/log.txt", b"c")) == Err(FsErr.Denied(path: "p/log.txt"))
}

test "memfs copy" {
  os.fs.write("c/a.txt", b"data")?
  os.fs.set_mode("c/a.txt", 0o600)?
  os.fs.copy("c/a.txt", "c/sub/b.txt")?
  expect(os.fs.read_text("c/sub/b.txt")?) == "data"
  expect(os.fs.mode("c/sub/b.txt")?) == 0o600
  expect(os.fs.copy("c/none", "c/x")) == Err(FsErr.NotFound(path: "c/none"))
  expect(os.fs.copy("c", "c/x")) == Err(FsErr.IsDir(path: "c"))
  os.fs.symlink("a.txt", "c/l")?
  os.fs.copy("c/l", "c/via")?
  expect(os.fs.read_text("c/via")?) == "data"
  os.fs.symlink("loop2", "c/loop1")?
  os.fs.symlink("loop1", "c/loop2")?
  expect(os.fs.copy("c/loop1", "c/y")) == Err(FsErr.Io(path: "c/loop1", msg: "too many levels of symbolic links"))
  os.fs.fail_next(testing.FsOp.Read, "c/a.txt", FsErr.Io(path: "c", msg: "bad sector"))
  expect(os.fs.copy("c/a.txt", "c/z")) == Err(FsErr.Io(path: "c", msg: "bad sector"))
}

test "memfs mode and set_mode" {
  os.fs.write("m/f", b"x")?
  expect(os.fs.mode("m/f")?) == 0o644
  expect(os.fs.mode("m")?) == 0o755
  os.fs.set_mode("m/f", 0o4751)?
  expect(os.fs.mode("m/f")?) == 0o751
  os.fs.set_mode("m", 0o700)?
  expect(os.fs.mode("m")?) == 0o700
  expect(os.fs.mode("m/none")) == Err(FsErr.NotFound(path: "m/none"))
  expect(os.fs.set_mode("m/none", 0o600)) == Err(FsErr.NotFound(path: "m/none"))
  os.fs.symlink("f", "m/l")?
  os.fs.set_mode("m/l", 0o640)?
  expect(os.fs.mode("m/f")?) == 0o640
  os.fs.fail_next(testing.FsOp.Write, "m/f", FsErr.Io(path: "m", msg: "disk full"))
  expect(os.fs.set_mode("m/f", 0o600)) == Err(FsErr.Io(path: "m", msg: "disk full"))
}

test "memfs glob" {
  os.fs.write("g/a.txt", b"")?
  os.fs.write("g/b.md", b"")?
  os.fs.write("g/.hidden.txt", b"")?
  os.fs.write("g/sub/c.txt", b"")?
  os.fs.write("g/sub/deep/d.txt", b"")?
  expect(os.fs.glob("g/*.txt")?) == ["g/a.txt"]
  expect(os.fs.glob("g/**/*.txt")?) == ["g/a.txt", "g/sub/c.txt", "g/sub/deep/d.txt"]
  expect(os.fs.glob("g/.*")?) == ["g/.hidden.txt"]
  expect(os.fs.glob("g/?.md")?) == ["g/b.md"]
  expect(os.fs.glob("g/[ab].*")?) == ["g/a.txt", "g/b.md"]
  expect(os.fs.glob("nope/*")?) == []
  expect(os.fs.glob("g/sub")?) == ["g/sub"]
  expect(os.fs.glob("g/[")) == Err(FsErr.Io(path: "g/[", msg: "bad pattern: syntax error in pattern"))
  expect(os.fs.sub("g").glob("*.md")?) == ["b.md"]
}

test "memfs lock and try_lock" {
  let l = os.fs.lock("k/app.lock")?
  expect(os.fs.exists("k/app.lock")?)
  expect(os.fs.try_lock("k/app.lock")?.is_some()) == false
  l.unlock()
  l.unlock()
  let l2 = os.fs.try_lock("k/app.lock")? ?? fault("not free")
  l2.unlock()
  expect(err_of(os.fs.lock("k"))) == Some(FsErr.IsDir(path: "k"))
  expect(err_of(os.fs.lock("k/app.lock/x"))) == Some(FsErr.NotDir(path: "k/app.lock"))
  os.fs.fail_next(testing.FsOp.Write, "k/*", FsErr.Io(path: "k", msg: "disk full"))
  expect(err_of(os.fs.lock("k/other"))) == Some(FsErr.Io(path: "k", msg: "disk full"))
  // a held lock makes another task wait until it is unlocked
  let held = os.fs.lock("k/w")?
  let ch = Chan[Str].new(2)
  let h = os.tasks.spawn(fn() {
    let mine = os.fs.lock("k/w").or_fault("lock")
    ch.send("waiter")
    mine.unlock()
  })
  os.clock.sleep(1s)
  ch.send("holder")
  held.unlock()
  h.await
  expect(ch.recv()) == Some("holder")
  expect(ch.recv()) == Some("waiter")
}
