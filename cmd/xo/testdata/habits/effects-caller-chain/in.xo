fn leaf(clock: Clock[clock]) -> Int uses () {
  clock.now().unix()
}

fn mid(clock: Clock[clock]) -> Int uses () {
  leaf(clock) + 1
}

fn helper(clock: Clock[clock]) -> Int {
  mid(clock)
}

pub fn top(clock: Clock[clock]) -> Int uses () {
  helper(clock) * 2
}

fn main(os: Os) {
  os.stdio.println("${top(os.clock)}")
}
