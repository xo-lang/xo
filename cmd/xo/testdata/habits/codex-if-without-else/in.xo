fn tally(statuses: List[Int]) -> (Int, Int) {
  let created = Atomic[Int].new(0)
  let conflicts = Atomic[Int].new(0)
  scope s {
    for status in statuses {
      s.spawn(fn() {
        if status == 201 {
          created.add(1)
        } else if status == 409 {
          conflicts.add(1)
        }
      })
    }
  }
  (created.get(), conflicts.get())
}
