fn save(s: Secrets, name: Str, v: Bytes) -> Bool ! KeyErr uses secrets {
  match s.keyring() {
    None => Ok(false)
    Some(k) => {
      let r = k.user_persistent()?
      let _ = k.add(r, "user", name, v)?
      Ok(true)
    }
  }
}

fn load(s: Secrets, name: Str) -> Bytes? ! KeyErr uses secrets {
  match s.keyring() {
    None => Ok(None)
    Some(k) => {
      let r = k.user_persistent()?
      match k.search(r, "user", name) {
        Ok(id) => Ok(Some(k.read(id)?))
        Err(KeyErr.NotFound) => Ok(None)
        Err(e) => Err(e)
      }
    }
  }
}

fn main(os: Os) {
  os.stdio.println("main")
}

test "save then load" {
  expect(save(os.secrets, "tok", b"abc")?)
  expect(load(os.secrets, "tok")? == Some(b"abc"))
  expect(save(os.secrets, "tok", b"xyz")?)
  expect(load(os.secrets, "tok")? == Some(b"xyz"))
  let k = os.secrets.keyring() ?? fault("keyring")
  let r = k.user_persistent()?
  let id = k.search(r, "user", "tok")?
  k.unlink(id, r)?
  expect(load(os.secrets, "tok")? == None)
}

test "each test starts empty" {
  expect(load(os.secrets, "tok")? == None)
  expect(save(os.secrets, "tok", b"1")?)
}

test "only([]) has no keyring" {
  expect(!save(os.secrets.only([]), "tok", b"1")?)
}

test "run_main sees the fake" {
  expect(save(os.secrets, "shared", b"s")?)
  let code = testing.run_main(fn(o: Os) -> () ! Error {
    let v = load(o.secrets, "shared")?
    if v != Some(b"s") { o.stdio.println("missing") }
  }, os)
  expect(code == 0)
  expect(!os.stdio.output().contains("missing"))
}

test "keychain generic passwords" {
  let c = os.secrets.keychain() ?? fault("keychain")
  expect(c.get_generic("svc", "acct")? == None)
  c.set_generic("svc", "acct", b"one")?
  expect(c.get_generic("svc", "acct")? == Some(b"one"))
  c.set_generic("svc", "acct", b"two")?
  expect(c.get_generic("svc", "acct")? == Some(b"two"))
  expect(c.get_generic("svc", "other")? == None)
  // the keyring does not see the keychain's items
  expect(load(os.secrets, "acct")? == None)
  c.delete_generic("svc", "acct")?
  c.delete_generic("svc", "acct")?
  expect(c.get_generic("svc", "acct")? == None)
}

test "only narrows the keychain" {
  expect(os.secrets.only(["keyring"]).keychain() == None)
  expect(os.secrets.only(["keychain"]).keyring() == None)
  expect(os.secrets.only(["keychain"]).keychain() != None)
  expect(KeychainErr{status: -25293, msg: "denied"}.display() == "keychain: denied (-25293)")
}

test "dpapi fake round trip" {
  let d = os.secrets.dpapi() ?? fault("dpapi")
  let blob = d.protect(b"secret", b"e")?
  expect(blob != b"secret")
  expect(!blob.to_str_lossy().contains("secret"))
  expect(d.unprotect(blob, b"e")? == b"secret")
  expect(d.unprotect(d.protect(b"")?)? == b"")
  match d.unprotect(blob) {
    Ok(_) => expect(false)
    Err(e) => expect(e.code == 13)
  }
  expect(d.unprotect(b"junk").is_err())
  expect(os.secrets.only(["keychain"]).dpapi() == None)
  expect(os.secrets.only(["dpapi"]).dpapi() != None)
  expect(DpapiErr{code: 5, msg: "Access is denied."}.display() == "dpapi: Access is denied. (5)")
}

test "local_app_data from the FakeEnv" {
  expect(os.env.local_app_data().is_err())
  os.env.set("LOCALAPPDATA", "C:\\Users\\t\\AppData\\Local")
  expect(os.env.local_app_data()? == "C:/Users/t/AppData/Local")
  expect(os.env.only([]).local_app_data()? == "C:/Users/t/AppData/Local")
}
