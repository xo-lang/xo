// The DWARF sections of a linux/arm64 or linux/amd64 executable (decision 0239): the
// inputs' .debug_line, .debug_abbrev, and .debug_info, which classify
// leaves unplaced (not loaded), joined per section and kept in the
// output as sections not loaded. Their relocations: a symbol in one of
// these sections (the arm64 emitter's compile unit names its line table
// and abbreviations by labels there) is the offset of its object's
// chunk in the joined section; any other symbol is its address. Each xo
// compile unit (compiler/arm64 debug.xo, producer "xo" at byte 33) also
// gives a .debug_aranges set, from its low_pc and high_pc (bytes 17 and
// 25), which debuggers map addresses to units by.

/// The output's debug sections: (name, contents), none when no input
/// has DWARF.
fn (var l: ELinker) debug_sections() -> List[(Str, Bytes)] {
  // every .debug_ section of the inputs (an LLVM object's also have
  // .debug_str, .debug_str_offsets, .debug_addr, ...), the line,
  // abbreviation, and info sections first (their indexes below)
  var names = [".debug_line", ".debug_abbrev", ".debug_info"]
  var index: Map[Str, Int] = {}
  for (k, nm) in names.indexed() {
    index[nm] = k
  }
  // each name's chunks (object, section) in link order, in one pass over
  // the sections (a pass per name was 12% of an HTTP edit link from
  // std's half, 2026-10-30)
  var chunks: List[List[(Int, Int)]] = [[], [], []]
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for (sk, s) in l.objs[o].sects.indexed() {
      if !s.name.starts_with(".debug_") || s.dead {
        continue
      }
      let k = match index.get(s.name) {
        Some(x) => x
        None => {
          index[s.name] = names.len()
          names.push(s.name)
          chunks.push([])
          names.len() - 1
        }
      }
      chunks[k].push((o, sk))
    }
  }
  // per section: per object, the chunk's offset (the first of its
  // sections of that name)
  var at: List[Map[Int, Int]] = []
  var sizes: List[Int] = []
  for k in 0..names.len() {
    var offs: Map[Int, Int] = {}
    var n = 0
    for (o, sk) in chunks[k] {
      if !offs.contains(o) {
        offs[o] = n
      }
      n += l.objs[o].sects[sk].data.len()
    }
    at.push(offs)
    sizes.push(n)
  }
  if sizes[2] == 0 {
    return []
  }
  // each section's chunks written whole with their relocations as
  // patches (write_patched), no byte list: a List[Int] per chunk joined
  // with `+` was 32 ms of a 100 ms separately compiled HTTP server's link
  // on Linux (2026-10-28)
  var out: List[(Str, Bytes)] = []
  var info = "".bytes()
  for (k, nm) in names.indexed() {
    var buf = BytesBuilder.with_capacity(sizes[k])
    for (o, sk) in chunks[k] {
      let s = l.objs[o].sects[sk]
      if o < l.prog_from {
        // where std's chunk is, for std's half (elfhalf.xo)
        l.dbg_at[(o, sk)] = buf.len()
      }
      var ps: List[BytePatch] = List.with_capacity(s.relocs.len())
      for r in s.relocs {
        let sym = l.objs[o].syms[r.sym]
        var v = r.addend
        var debug_sym = false
        if sym.shndx > 0 && sym.shndx < l.objs[o].sects.len() {
          if let Some(j) = index.get(l.objs[o].sects[sym.shndx].name) {
            v += (at[j].get(o) ?? 0) + sym.value
            debug_sym = true
          }
        }
        if !debug_sym {
          let (d, i) = l.def_of(o, r.sym)
          if d >= 0 {
            v += l.sym_addr(d, i)
          }
        }
        // an x86_64 object's too (2026-10-20: its addresses were left 0,
        // and no pc found a line or a variable)
        let width = if r.typ == R_AARCH64_ABS64 || r.typ == R_X86_64_64 { 8 } else if r.typ == R_AARCH64_ABS32 || r.typ == R_X86_64_32 { 4 } else { 0 }
        if width == 0 || r.off + width > s.data.len() {
          continue
        }
        ps.push(BytePatch{at: r.off, n: width, v: v})
      }
      write_patched(buf, s.data, ps)
    }
    let d = buf.freeze()
    if l.prog_from >= 0 {
      l.dbg_out[nm] = d
    }
    if k == 2 {
      info = d
    }
    out.push((nm, d))
  }
  // .debug_aranges: a set per xo compile unit
  var ar: List[Int] = []
  for (_, off) in at[2] {
    if off + 36 > info.len() || info[off + 33] != 120 || info[off + 34] != 111 || info[off + 35] != 0 {
      continue
    }
    let lo = rd64(info, off + 17)
    let hi = rd64(info, off + 25)
    let a0 = ar.len()
    for _ in 0..48 {
      ar.push(0)
    }
    le_put(ar, a0, 4, 44)
    ar[a0 + 4] = 2
    le_put(ar, a0 + 6, 4, off)
    ar[a0 + 10] = 8
    le_put(ar, a0 + 16, 8, lo)
    le_put(ar, a0 + 24, 8, hi - lo)
  }
  if !ar.is_empty() {
    // after the inputs' own sets, if they have any
    var merged = false
    for (k, (nm, d)) in out.indexed() {
      if nm == ".debug_aranges" {
        var all = BytesBuilder.with_capacity(d.len() + ar.len())
        all.write(d)
        all.write(bytes_of(ar))
        out[k] = (nm, all.freeze())
        merged = true
      }
    }
    if !merged {
      out.push((".debug_aranges", bytes_of(ar)))
    }
  }
  // sections the inputs only declared (empty) are left out
  var kept: List[(Str, Bytes)] = []
  for (nm, d) in out {
    if !d.is_empty() {
      kept.push((nm, d))
    }
  }
  kept
}

fn bytes_of(b: List[Int]) -> Bytes {
  var o = new_out(b.len())
  for c in b {
    o.u8(c)
  }
  o.done()
}

fn le_put(var b: List[Int], o: Int, n: Int, v: Int) {
  for k in 0..n {
    b[o + k] = (v >> (8 * k)) & 255
  }
}
