// The DWARF of one COFF object, read where the object itself puts its code
// (design note: Xo Lang 2's pdb-cache-design.md, tier 2, step 1): the
// first step to CodeView made per object and merged by the PE linker, so
// an edit rebuilds the CodeView of the parts it assembles, not of the whole
// image. An object's relocations are applied against bases of its own
// (its code sections laid end to end from 0, its other sections in a
// range of their own), so the result depends on the object's bytes alone,
// not on where a link places it.

use github.com/xo-lang/xo/compiler/debug

/// Where obj_dwarf puts the sections that hold no code (data the DWARF
/// names, such as a global's address): far past any object's code.
const CVOBJ_DATA_BASE: Int = 1099511627776

/// The base of each section of o (in o.sects' order): code sections end
/// to end from 0, each 16 aligned; the others the same way from
/// CVOBJ_DATA_BASE; debug sections 0 (a reference into one is an offset).
pub fn obj_bases(o: CObj) -> List[Int] {
  var code = 0
  var data = CVOBJ_DATA_BASE
  var out: List[Int] = []
  for s in o.sects {
    if s.name.starts_with(".debug_") {
      out.push(0)
    } else if (s.chars & IMAGE_SCN_CNT_CODE) != 0 {
      out.push(code)
      code = (code + s.size + 15) & -16
    } else {
      out.push(data)
      data = (data + s.size + 15) & -16
    }
  }
  out
}

/// o's DWARF sections with its relocations applied against obj_bases:
/// an ADDR64 is the target's base plus the symbol's value plus the addend
/// the contents hold, a SECREL the symbol's value plus the addend (an
/// offset in the debug section it names), an ADDR32NB as ADDR64 in four
/// bytes. Format "pe", as debug.sections names an image's.
pub fn obj_dwarf(o: CObj) -> debug.Sections ! Str {
  let bases = obj_bases(o)
  var s = debug.Sections{format: "pe"}
  var any = false
  for sec in o.sects {
    if !sec.name.starts_with(".debug_") {
      continue
    }
    let data = relocated(o, bases, sec)?
    match sec.name.trim_prefix(".debug_") {
      "info" => s.info = data
      "abbrev" => s.abbrev = data
      "str" => s.str = data
      "line_str" => s.line_str = data
      "str_offsets" | "str_offs" => s.str_offsets = data
      "addr" => s.addr = data
      "loclists" => s.loclists = data
      "rnglists" => s.rnglists = data
      "line" => s.line = data
      _ => {}
    }
    any = true
  }
  if !any || s.info.is_empty() {
    return Err("${o.path}: no .debug_info")
  }
  Ok(s)
}

/// sec's contents with each relocation's value written in place.
fn relocated(o: CObj, bases: List[Int], sec: CSect) -> Bytes ! Str {
  if sec.relocs.is_empty() {
    return Ok(sec.data)
  }
  let rs = sec.relocs.sort_by(fn(r: CReloc) { r.addr })
  var b = BytesBuilder.with_capacity(sec.data.len())
  var last = 0
  for r in rs {
    var n = 0
    if r.typ == IMAGE_REL_AMD64_ADDR64 {
      n = 8
    } else if r.typ == IMAGE_REL_AMD64_SECREL || r.typ == IMAGE_REL_AMD64_ADDR32NB {
      n = 4
    } else {
      return Err("${o.path}: ${sec.name}: relocation type ${r.typ} at ${r.addr} in DWARF")
    }
    if r.addr < last || r.addr + n > sec.data.len() || r.sym < 0 || r.sym >= o.syms.len() {
      return Err("${o.path}: ${sec.name}: a bad relocation at ${r.addr}")
    }
    let sym = o.syms[r.sym]
    var addend = 0
    for k in 0..n {
      addend = addend | Int(sec.data[r.addr + k]).wrapping_shl(8 * k)
    }
    var v = sym.value + addend
    if r.typ != IMAGE_REL_AMD64_SECREL && sym.sect >= 1 && sym.sect <= bases.len() {
      v = v + bases[sym.sect - 1]
    }
    b.write(sec.data[last..r.addr])
    for k in 0..n {
      b.write_byte(UInt8((v >> (8 * k)) & 255))
    }
    last = r.addr + n
  }
  b.write(sec.data[last..sec.data.len()])
  Ok(b.freeze())
}

/// The DWARF facts of a function the PDB is made from, relative to its
/// start: its size, its inlined calls' depths and ranges, its variables'
/// names, and its line rows' offsets, files and lines.
fn fn_facts(f: debug.Func, lns: debug.Lines) -> Str {
  var b = StrBuilder.new()
  b.write("size ${f.hi - f.lo}")
  for c in f.inlined {
    b.write(" call ${c.name} depth ${c.depth} line ${c.call_line}")
    for (lo, hi) in c.ranges {
      b.write(" [${lo - f.lo},${hi - f.lo})")
    }
  }
  for v in f.vars {
    b.write(" var ${v.name}")
  }
  for r in lns.rows {
    if !r.end && r.addr >= f.lo && r.addr < f.hi {
      b.write(" row ${r.addr - f.lo}:${if r.file >= 0 && r.file < lns.files.len() { lns.files[r.file] } else { "?" }}:${r.line}")
    }
  }
  b.freeze()
}

/// XO_PDB_OBJ_CHECK (tier 2, step 1): each function of each object read
/// from the object's own DWARF (obj_dwarf) against the same function in
/// the image's DWARF, which pe_pdb reads: "N functions, M differ" and the
/// first differences, or why an object could not be read.
pub fn obj_check(img: Bytes, objs: List[CObj]) -> Str {
  let s = match debug.sections(img) {
    Ok(x) => x
    Err(e) => return "the image's DWARF: ${e}"
  }
  let info = debug.read(s)
  let lns = debug.lines(s)
  var want: Map[Str, Str] = {}
  for f in info.funcs {
    if f.hi > f.lo {
      want[f.name] = fn_facts(f, lns)
    }
  }
  var n = 0
  var bad = 0
  var first: List[Str] = []
  for o in objs {
    let os = match obj_dwarf(o) {
      Ok(x) => x
      Err(_) => continue
    }
    let oi = debug.read(os)
    let ol = debug.lines(os)
    for f in oi.funcs {
      if f.hi <= f.lo {
        continue
      }
      n += 1
      let got = fn_facts(f, ol)
      let w = want.get(f.name) ?? "(not in the image)"
      if got != w {
        bad += 1
        if first.len() < 3 {
          first.push("${f.name} in ${o.path}:\n  object ${got}\n  image  ${w}")
        }
      }
    }
  }
  "${n} functions, ${bad} differ${if first.is_empty() { "" } else { ":\n" + first.join("\n") }}"
}

/// How one object's own addresses and DWARF offsets (obj_dwarf's) map to
/// the image's: each section's base in the object, size and image
/// address (-1: not placed), and where its .debug_info and .debug_line
/// start in the image's.
struct ObjMap {
  bases: List[Int]
  sizes: List[Int]
  at: List[Int]
  info: Int
  line: Int
  // the sections with bytes but debug's, by base (addr and placed search
  // them: a scan of every section for each address, with an atoms mode
  // object's section per function, was most of pre_procs_store), and
  // each placed one's end (the first section's in object order)
  order: List[Int]
  ends: Map[Int, Int]
}

fn obj_map(o: CObj, oi: Int, layout: PELayout) -> ObjMap {
  var ks: List[Int] = []
  for si in 0..o.sects.len() {
    ks.push(si)
  }
  obj_map_k(o, ks, oi, layout)
}

/// An object of std's store (coffstore.xo): its split sections (the
/// shells: name, characteristics, size), which its PDB part's addresses
/// are against, and each one's section in the compacted object pelink
/// linked (-1: stripped).
pub struct StoreMap {
  pub secs: List[CSect]
  pub newk: List[Int]
}

/// obj_map of a store object: the split object's sections placed where
/// pelink put their compacted ones.
fn obj_map_store(sm: StoreMap, oi: Int, layout: PELayout) -> ObjMap {
  obj_map_k(CObj{path: "", sects: sm.secs, syms: []}, sm.newk, oi, layout)
}

/// obj_map with section si of o linked as layout's section ks[si] of
/// object oi (-1: not linked).
fn obj_map_k(o: CObj, ks: List[Int], oi: Int, layout: PELayout) -> ObjMap {
  let bases = obj_bases(o)
  var sizes: List[Int] = []
  var at: List[Int] = []
  var info = 0
  var line = 0
  for (si, s) in o.sects.indexed() {
    sizes.push(s.size)
    let p = if ks[si] < 0 { PEPlace{out: -1, off: 0} } else { layout.places[oi][ks[si]] }
    if p.out < 0 {
      at.push(-1)
    } else if s.name.starts_with(".debug_") {
      at.push(-1)
      if s.name == ".debug_info" {
        info = p.off
      } else if s.name == ".debug_line" {
        line = p.off
      }
    } else {
      at.push(layout.base + layout.rva[p.out] + p.off)
    }
  }
  var order: List[Int] = []
  var ends: Map[Int, Int] = {}
  for (si, s) in o.sects.indexed() {
    if s.size > 0 && !s.name.starts_with(".debug_") {
      order.push(si)
    }
    if at[si] >= 0 && !ends.contains(bases[si] + s.size) {
      ends[bases[si] + s.size] = si
    }
  }
  ObjMap{bases: bases, sizes: sizes, at: at, info: info, line: line, order: order.sort_by(fn(i: Int) { bases[i] }), ends: ends}
}

/// The section holding address a (-1: none).
fn (m: ObjMap) holding(a: Int) -> Int {
  // the last section whose base is at most a
  var lo = 0
  var hi = m.order.len()
  while lo < hi {
    let mid = (lo + hi) / 2
    if m.bases[m.order[mid]] <= a {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo == 0 {
    return -1
  }
  let i = m.order[lo - 1]
  if a < m.bases[i] + m.sizes[i] { i } else { -1 }
}

/// a, an address in the object (obj_bases), in the image; a itself when no
/// placed section holds it.
fn (m: ObjMap) addr(a: Int) -> Int {
  let i = m.holding(a)
  if i >= 0 && m.at[i] >= 0 {
    return m.at[i] + (a - m.bases[i])
  }
  // the end of a section (a range's hi)
  if let Some(e) = m.ends.get(a) {
    return m.at[e] + m.sizes[e]
  }
  a
}

fn (m: ObjMap) ty(t: Int) -> Int { if t < 0 { t } else { t + m.info } }

/// Whether a placed section holds address a (a function that is linked).
fn (m: ObjMap) placed(a: Int) -> Bool {
  let i = m.holding(a)
  i >= 0 && m.at[i] >= 0
}

fn (m: ObjMap) var_of(v: debug.Var) -> debug.Var {
  var locs: List[debug.Loc] = []
  for l in v.locs {
    var pieces: List[debug.Piece] = []
    for pc in l.pieces {
      pieces.push(match pc.place {
        Addr(a) => debug.Piece{place: debug.Place.Addr(addr: m.addr(a)), size: pc.size}
        _ => pc
      })
    }
    let every = l.lo == 0 && l.hi == -1
    locs.push(debug.Loc{lo: if every { 0 } else { m.addr(l.lo) }, hi: if every { -1 } else { m.addr(l.hi) }, pieces: pieces})
  }
  v with {ty: m.ty(v.ty), locs: locs}
}

fn (m: ObjMap) ranges(rs: List[(Int, Int)]) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  for (lo, hi) in rs {
    out.push((m.addr(lo), m.addr(hi)))
  }
  out
}

/// The image's DWARF facts as debug.read and debug.lines give them,
/// made from each object's own (obj_dwarf) and the link's layout: the
/// functions, globals and line tables in object order (the image's
/// .debug_info and .debug_line are the objects' in that order),
/// addresses and DWARF offsets moved to where the link placed them, the
/// files numbered in the order they first appear.
pub fn merge_facts(objs: List[CObj], layout: PELayout) -> (debug.Info, debug.Lines) {
  var info = debug.Info{}
  var lns = debug.Lines{}
  var file_at: Map[Str, Int] = {}
  for (oi, o) in objs.indexed() {
    let s = match obj_dwarf(o) {
      Ok(x) => x
      Err(_) => continue
    }
    let m = obj_map(o, oi, layout)
    let oinfo = debug.read(s)
    let olns = debug.lines(s)
    merge_info(oinfo, m, info)
    // the object's files by the merged numbering
    var fmap: List[Int] = []
    for f in olns.files {
      if let Some(i) = file_at.get(f) {
        fmap.push(i)
      } else {
        file_at[f] = lns.files.len()
        fmap.push(lns.files.len())
        lns.files.push(f)
      }
    }
    for r in olns.rows {
      lns.rows.push(r with {addr: m.addr(r.addr), file: if r.file >= 0 && r.file < fmap.len() { fmap[r.file] } else { r.file }})
    }
    for (u, fs) in olns.unit_files {
      var g: List[Int] = []
      for x in fs {
        g.push(if x >= 0 && x < fmap.len() { fmap[x] } else { x })
      }
      lns.unit_files[u + m.line] = g
    }
  }
  (info, lns)
}

/// oinfo's functions, globals and types, moved by m, appended to info.
fn merge_info(oinfo: debug.Info, m: ObjMap, var info: debug.Info) {
  for f in oinfo.funcs {
    var inl: List[debug.Inlined] = []
    for c in f.inlined {
      var vs: List[debug.Var] = []
      for v in c.vars {
        vs.push(m.var_of(v))
      }
      inl.push(c with {ranges: m.ranges(c.ranges), unit_line: if c.unit_line < 0 { c.unit_line } else { c.unit_line + m.line }, vars: vs})
    }
    var vs: List[debug.Var] = []
    for v in f.vars {
      vs.push(m.var_of(v))
    }
    info.funcs.push(f with {lo: m.addr(f.lo), hi: m.addr(f.hi), vars: vs, inlined: inl})
  }
  for g in oinfo.globals {
    info.globals.push(m.var_of(g))
  }
  for (off, t) in oinfo.types {
    var ms: List[debug.Member] = []
    for mb in t.members {
      ms.push(mb with {ty: m.ty(mb.ty)})
    }
    info.types[m.ty(off)] = t with {of: m.ty(t.of), members: ms}
  }
}

/// A function's PDB rows and inline sites, made from its own object
/// (obj_pdb): addresses the object's, files numbered by the object's line
/// tables.
struct ObjFn {
  name: Str
  lo: Int
  hi: Int
  rows: List[(Int, Int, Int, Bool)]
  /// its inline sites with their locals made (no vars)
  sites: List[PdbSite]
  /// its locals (cv_locals_at: types DWARF offsets, section offsets the
  /// object section's), and its own offset in that section
  locals: List[PdbLocal]
  sect_off: Int
}

/// What one object brings to the PDB, from its bytes alone: its DWARF
/// facts, its line tables' files, and each function's rows and inline
/// sites (pe_pdb's per-function work).
pub struct ObjPdb {
  /// the types by offset, and every variable's type in cv_types' order
  types: Map[Int, debug.Type]
  tys: List[Int]
  /// tys by function, in order: each function's first address and how
  /// many of tys are its (a link through the store counts only the live
  /// functions', as the image's DWARF has only theirs)
  fn_tys: List[(Int, Int)] = []
  files: List[Str]
  fns: List[ObjFn]
  /// read lazily (dec_obj_pdb_lazy): the encoding, and each function's
  /// first address, record place and length in it, fns left empty
  raw: Bytes = "".bytes()
  fn_index: List[(Int, Int, Int)] = []
}

/// o's part of the PDB, made as pe_pdb makes a function's rows and inline
/// sites, from o's own DWARF.
pub fn obj_pdb(o: CObj) -> ObjPdb ! Str {
  let s = obj_dwarf(o)?
  let info = debug.read(s)
  let lns = debug.lines(s)
  var keyed: List[(Int, Int)] = []
  for (i, r) in lns.rows.indexed() {
    if !r.end && r.file >= 0 {
      keyed.push((r.addr, i))
    }
  }
  let by_addr = keyed.sort()
  var file_of: Map[Str, Int] = {}
  for (i, f) in lns.files.indexed() {
    file_of[f] = i
  }
  // the object's sections as the image's are to cv_locals (debug sections
  // hold no code: empty)
  let bases = obj_bases(o)
  var osects: List[PdbSect] = []
  for (i, sc) in o.sects.indexed() {
    osects.push(PdbSect{rva: bases[i], vsize: if sc.name.starts_with(".debug_") { 0 } else { sc.size }, chars: 0, header: b""})
  }
  var fns: List[ObjFn] = []
  for f in info.funcs {
    if f.hi <= f.lo {
      continue
    }
    var calls: List[(List[(Int, Int)], Int, Int)] = []
    for c in f.inlined {
      if c.depth == 1 {
        let cf = file_of.get(lns.call_file(c.unit_line, c.call_file)) ?? -1
        calls.push((c.ranges, cf, c.call_line))
      }
    }
    var sites = inline_sites(lns, by_addr, file_of, f)
    for i in 0..sites.len() {
      var st = sites[i]
      st.locals = cv_locals_at(st.vars, st.ranges, osects, 0)
      st.vars = []
      sites[i] = st
    }
    let (_, so) = seg_off(osects, f.lo)
    fns.push(ObjFn{name: f.name, lo: f.lo, hi: f.hi, rows: fn_rows(lns, by_addr, f.lo, f.hi, calls), sites: sites, locals: cv_locals_at(f.vars, [(f.lo, f.hi)], osects, 0), sect_off: so})
  }
  var fn_tys: List[(Int, Int)] = []
  for f in info.funcs {
    var k = f.vars.len()
    for c in f.inlined {
      k += c.vars.len()
    }
    fn_tys.push((f.lo, k))
  }
  Ok(ObjPdb{types: info.types, tys: var_tys(info), fn_tys: fn_tys, files: lns.files, fns: fns})
}

/// The PDB's inputs from the objects' parts (obj_pdb) and the link's
/// layout: the types (offsets the image's), every variable's type in
/// cv_types' order, the files in the order they first appear, and each
/// function's PdbProc at the image's addresses (its locals' types and
/// section offsets still the object's: pe_pdb_facts finishes them).
pub struct PreProcs {
  info: debug.Info
  tys: List[Int]
  files: List[Str]
  procs: List[PdbProc]
  /// std's part's types (pre_procs_std): those at offsets below std_off
  /// and tys[0..std_tys] make their CodeView records first; -1: one run
  std_off: Int = -1
  std_tys: Int = 0
  /// how many of procs are std's (pre_procs_std), whose PDB records a
  /// link from std's half reuses (PdbStd)
  pub std_procs: Int = 0
  /// std's functions left out of procs (dec_pre_procs_lazy): only a
  /// PdbStd, which has them placed, makes the PDB from this
  std_lazy: Bool = false
}

/// pp (pre_procs_from over std's store parts) marked as std's part: the
/// PDB made from it, or from a result resumed from it, lists std's types
/// first (cv_types_split).
pub fn pre_procs_std(pp: PreProcs) -> PreProcs {
  var top = 0
  for (off, _) in pp.info.types {
    if off + 1 > top {
      top = off + 1
    }
  }
  pp with {std_off: top, std_tys: pp.tys.len(), std_procs: pp.procs.len()}
}

pub fn pre_procs(parts: List[ObjPdb?], objs: List[CObj], layout: PELayout) -> PreProcs { pre_procs_store(parts, objs, layout, [], true) }

/// pre_procs with the first smaps.len() objects std's store's (their parts
/// against their split sections, StoreMap), whose stripped functions are
/// left out.
pub fn pre_procs_store(parts: List[ObjPdb?], objs: List[CObj], layout: PELayout, smaps: List[StoreMap], trim_types: Bool) -> PreProcs { pre_procs_from(parts, objs, layout, smaps, trim_types, None, 0, parts.len()) }

/// pre_procs_store over parts[lo..hi] only, continuing from, the result
/// over parts[0..lo] (None when lo is 0): a link from std's half resumes
/// from std's parts' result (enc_pre_procs), which its pins keep the same.
pub fn pre_procs_from(parts: List[ObjPdb?], objs: List[CObj], layout: PELayout, smaps: List[StoreMap], trim_types: Bool, from: PreProcs?, lo: Int, hi: Int) -> PreProcs {
  var info = debug.Info{}
  var tys: List[Int] = []
  var files: List[Str] = []
  var file_at: Map[Str, Int] = {}
  var procs: List[PdbProc] = []
  var std_off = -1
  var std_tys = 0
  var std_procs = 0
  var std_lazy = false
  if let Some(f) = from {
    info = f.info
    tys = f.tys
    files = f.files
    procs = f.procs
    std_off = f.std_off
    std_tys = f.std_tys
    std_procs = f.std_procs
    std_lazy = f.std_lazy
    for (i, x) in files.indexed() {
      file_at[x] = i
    }
  }
  for oi in lo..hi {
    let po = parts[oi]
    let part = match po {
      Some(x) => x
      None => continue
    }
    let m = if oi < smaps.len() { obj_map_store(smaps[oi], oi, layout) } else { obj_map(objs[oi], oi, layout) }
    var pfns = part.fns
    if !part.fn_index.is_empty() {
      for (lo, at, _) in part.fn_index {
        if m.placed(lo) {
          pfns.push(part_fn(part, at))
        }
      }
    }
    // a store part's types: only those its live functions' variables
    // reach (a std part holds every std function's; in an XO_SEPCOMP HTTP
    // server 1865 of 6317 were reachable); trim_types false: all of them
    // (XO_STD_STORE_CHECK's PDB check, against the image's whole DWARF)
    let trim = trim_types && oi < smaps.len()
    var reach: Set[Int] = #{}
    if trim {
      var work: List[Int] = []
      var at = 0
      for (lo, k) in part.fn_tys {
        if m.placed(lo) {
          for j in at..at + k {
            work.push(part.tys[j])
          }
        }
        at += k
      }
      for fnp in pfns {
        if !m.placed(fnp.lo) {
          continue
        }
        for l in fnp.locals {
          work.push(l.ty)
        }
        for st in fnp.sites {
          for l in st.locals {
            work.push(l.ty)
          }
        }
      }
      while let Some(t) = work.pop() {
        if reach.contains(t) {
          continue
        }
        reach.add(t)
        if let Some(ty) = part.types.get(t) {
          work.push(ty.of)
          for mb in ty.members {
            work.push(mb.ty)
          }
        }
      }
    }
    for (off, t) in part.types {
      if trim && !reach.contains(off) {
        continue
      }
      var ms: List[debug.Member] = []
      for mb in t.members {
        ms.push(mb with {ty: m.ty(mb.ty)})
      }
      info.types[m.ty(off)] = t with {of: m.ty(t.of), members: ms}
    }
    if oi < smaps.len() {
      // only the live functions' variables
      var at = 0
      for (lo, k) in part.fn_tys {
        if m.placed(lo) {
          for j in at..at + k {
            tys.push(m.ty(part.tys[j]))
          }
        }
        at += k
      }
    } else {
      for ty in part.tys {
        tys.push(m.ty(ty))
      }
    }
    var fmap: List[Int] = []
    for f in part.files {
      if let Some(i) = file_at.get(f) {
        fmap.push(i)
      } else {
        file_at[f] = files.len()
        fmap.push(files.len())
        files.push(f)
      }
    }
    let gf = fn(x: Int) -> Int { if x >= 0 && x < fmap.len() { fmap[x] } else { x } }
    for fnp in pfns {
      if oi < smaps.len() && !m.placed(fnp.lo) {
        continue
      }
      var rows: List[(Int, Int, Int, Bool)] = []
      for (off, f, l, st) in fnp.rows {
        rows.push((off, gf(f), l, st))
      }
      var sites: List[PdbSite] = []
      for st in fnp.sites {
        var es: List[(Int, Int, Int)] = []
        for (a, f, l) in st.entries {
          es.push((m.addr(a), gf(f), l))
        }
        sites.push(st with {ranges: m.ranges(st.ranges), entries: es, locals: locals_ty(st.locals, m)})
      }
      procs.push(PdbProc{name: fnp.name, seg: 0, off: 0, size: fnp.hi - fnp.lo, rows: rows, lo: m.addr(fnp.lo), sites: sites, locals: locals_ty(fnp.locals, m), sect_off: fnp.sect_off})
    }
  }
  PreProcs{info: info, tys: tys, files: files, procs: procs, std_off: std_off, std_tys: std_tys, std_procs: std_procs, std_lazy: std_lazy}
}

/// pp as cache bytes (dec_pre_procs reads them back): an ObjPdb's
/// encoding, its procs as functions from lo to lo + size.
pub fn enc_pre_procs(pp: PreProcs) -> Bytes {
  var fns = List[ObjFn].with_capacity(pp.procs.len())
  for p in pp.procs {
    fns.push(ObjFn{name: p.name, lo: p.lo, hi: p.lo + p.size, rows: p.rows, sites: p.sites, locals: p.locals, sect_off: p.sect_off})
  }
  enc_obj_pdb(ObjPdb{types: pp.info.types, tys: pp.tys, files: pp.files, fns: fns})
}

/// dec_pre_procs without std's functions (only counted, std_lazy), for a
/// PDB whose writer's std part (PdbStd) has them placed.
pub fn dec_pre_procs_lazy(b: Bytes) -> PreProcs? {
  let o = dec_obj_pdb_lazy(b, true) ?? return None
  Some(pre_procs_std(PreProcs{info: debug.Info{types: o.types}, tys: o.tys, files: o.files, procs: []}) with {std_procs: o.fn_index.len(), std_lazy: true})
}

/// enc_pre_procs' bytes read back; None when they are damaged.
pub fn dec_pre_procs(b: Bytes) -> PreProcs? {
  let o = dec_obj_pdb(b) ?? return None
  var procs = List[PdbProc].with_capacity(o.fns.len())
  for f in o.fns {
    procs.push(PdbProc{name: f.name, seg: 0, off: 0, size: f.hi - f.lo, rows: f.rows, lo: f.lo, sites: f.sites, locals: f.locals, sect_off: f.sect_off})
  }
  Some(pre_procs_std(PreProcs{info: debug.Info{types: o.types}, tys: o.tys, files: o.files, procs: procs}))
}

const PDBSTD_MAGIC = "xo pdbstd 2\n"

/// std as cache bytes (dec_pdb_std reads them back).
pub fn enc_pdb_std(std: PdbStd) -> Bytes {
  var w = new_out(64 * 1024)
  w.bytes(PDBSTD_MAGIC.bytes())
  w.pint(std.names.len())
  for n in std.names {
    w.pstr(n)
  }
  w.pint(std.types.recs.len())
  for (i, r) in std.types.recs.indexed() {
    w.pint(r.len())
    w.bytes(r)
    w.pint(std.types.hashes[i])
  }
  w.pint(std.types.of.len())
  for (k, v) in std.types.of {
    w.pint(k)
    w.pint(v)
  }
  w.pint(std.types.fwd.len())
  for (k, v) in std.types.fwd {
    w.pstr(k)
    w.pint(v)
  }
  w.pint(std.files.len())
  for f in std.files {
    w.pstr(f)
  }
  w.pint(std.fidx.len())
  for (f, i) in std.fidx {
    w.pint(f)
    w.pint(i)
  }
  w.pint(std.inlinees.len())
  for (n, f, l) in std.inlinees {
    w.pstr(n)
    w.pint(f)
    w.pint(l)
  }
  w.pint(std.recs.len())
  w.bytes(std.recs)
  w.pint(std.at.len())
  for a in std.at {
    w.pint(a)
  }
  w.pint(std.lines.len())
  w.bytes(std.lines)
  w.done()
}

/// enc_pdb_std's bytes read back; None when they are damaged.
pub fn dec_pdb_std(b: Bytes) -> PdbStd? {
  let m = PDBSTD_MAGIC.bytes()
  if b.len() < m.len() || b[0..m.len()] != m {
    return None
  }
  var r = PRd{b: b, at: m.len()}
  let nn = r.count()
  var names = List[Str].with_capacity(nn)
  for _ in 0..nn {
    names.push(r.str())
  }
  let nr = r.count()
  var trecs = List[Bytes].with_capacity(nr)
  var hashes = List[Int].with_capacity(nr)
  for _ in 0..nr {
    trecs.push(r.raw())
    hashes.push(r.int())
  }
  var of: Map[Int, Int] = {}
  for _ in 0..r.count() {
    let k = r.int()
    of[k] = r.int()
  }
  var fwd: Map[Str, Int] = {}
  for _ in 0..r.count() {
    let k = r.str()
    fwd[k] = r.int()
  }
  let nf = r.count()
  var files = List[Str].with_capacity(nf)
  for _ in 0..nf {
    files.push(r.str())
  }
  let nx = r.count()
  var fidx = List[(Int, Int)].with_capacity(nx)
  for _ in 0..nx {
    let f = r.int()
    fidx.push((f, r.int()))
  }
  let ni = r.count()
  var inl = List[(Str, Int, Int)].with_capacity(ni)
  for _ in 0..ni {
    let n = r.str()
    let f = r.int()
    inl.push((n, f, r.int()))
  }
  let recs = r.raw()
  let na = r.count()
  var at = List[Int].with_capacity(na)
  for _ in 0..na {
    at.push(r.int())
  }
  let lines = r.raw()
  if r.bad || r.at != b.len() {
    return None
  }
  Some(PdbStd{names: names, types: CvTypes{recs: trecs, hashes: hashes, of: of, fwd: fwd}, files: files, fidx: fidx, inlinees: inl, recs: recs, at: at, lines: lines})
}

/// ls with their types' offsets the image's.
fn locals_ty(ls: List[PdbLocal], m: ObjMap) -> List[PdbLocal] {
  var out = List[PdbLocal].with_capacity(ls.len())
  for l in ls {
    out.push(l with {ty: m.ty(l.ty)})
  }
  out
}

// ---- an object's PDB part as cache bytes (enc_obj_pdb, dec_obj_pdb)

const OBJPDB_MAGIC = "xo objpdb 3\n"

fn (var w: Out) pstr(s: Str) {
  let b = s.bytes()
  let _n = w.sleb(b.len())
  w.bytes(b)
}

fn (var w: Out) pint(v: Int) {
  let _n = w.sleb(v)
}

fn enc_locals(var w: Out, ls: List[PdbLocal]) {
  w.pint(ls.len())
  for l in ls {
    w.pstr(l.name)
    w.pint(l.ty)
    w.pint(if l.param { 1 } else { 0 })
    w.pint(l.defs.len())
    for (kind, b) in l.defs {
      w.pint(kind)
      w.pint(b.len())
      w.bytes(b)
    }
  }
}

/// p as bytes for the back-end cache (dec_obj_pdb reads them back).
pub fn enc_obj_pdb(p: ObjPdb) -> Bytes {
  var w = new_out(4096)
  w.bytes(OBJPDB_MAGIC.bytes())
  w.pint(p.types.len())
  for (off, t) in p.types {
    w.pint(off)
    w.pint(t.tag)
    w.pstr(t.name)
    w.pint(t.size)
    w.pint(t.enc)
    w.pint(t.of)
    w.pint(t.count)
    w.pint(t.members.len())
    for m in t.members {
      w.pstr(m.name)
      w.pint(m.ty)
      w.pint(m.offset)
    }
  }
  w.pint(p.tys.len())
  for x in p.tys {
    w.pint(x)
  }
  w.pint(p.fn_tys.len())
  for (lo, k) in p.fn_tys {
    w.pint(lo)
    w.pint(k)
  }
  w.pint(p.files.len())
  for f in p.files {
    w.pstr(f)
  }
  w.pint(p.fns.len())
  for f in p.fns {
    // its first address and its record's length, so a reader may skip it
    // (coff_store_pdb_read: only the live functions' are decoded)
    let fb = enc_fn(f)
    w.pint(f.lo)
    w.pint(fb.len())
    w.bytes(fb)
  }
  w.done()
}

/// One function's record of enc_obj_pdb.
fn enc_fn(f: ObjFn) -> Bytes {
  var w = new_out(256)
  {
    w.pstr(f.name)
    w.pint(f.lo)
    w.pint(f.hi)
    w.pint(f.sect_off)
    w.pint(f.rows.len())
    for (off, fi, line, st) in f.rows {
      w.pint(off)
      w.pint(fi)
      w.pint(line)
      w.pint(if st { 1 } else { 0 })
    }
    w.pint(f.sites.len())
    for s in f.sites {
      w.pstr(s.name)
      w.pint(s.parent)
      w.pint(s.ranges.len())
      for (lo, hi) in s.ranges {
        w.pint(lo)
        w.pint(hi)
      }
      w.pint(s.entries.len())
      for (a, fi, line) in s.entries {
        w.pint(a)
        w.pint(fi)
        w.pint(line)
      }
      enc_locals(w, s.locals)
    }
    enc_locals(w, f.locals)
  }
  w.done()
}

/// A reader of enc_obj_pdb's bytes; bad once it read past the end.
struct PRd {
  b: Bytes
  at: Int = 0
  bad: Bool = false
}

fn (var r: PRd) int() -> Int {
  var v = 0
  var shift = 0
  while {
    if r.at >= r.b.len() {
      r.bad = true
      return 0
    }
    let byte = Int(r.b[r.at])
    r.at += 1
    if shift < 63 {
      v = v | ((byte & 127) << shift)
    }
    shift += 7
    if (byte & 128) == 0 {
      if shift < 64 && (byte & 64) != 0 {
        v = v | (-1 << shift)
      }
      return v
    }
  }
}

/// A count: a negative one or one longer than what is left is bad.
fn (var r: PRd) count() -> Int {
  let n = r.int()
  if n < 0 || n > r.b.len() - r.at {
    r.bad = true
    return 0
  }
  n
}

fn (var r: PRd) raw() -> Bytes {
  let n = r.count()
  let b = r.b[r.at..r.at + n]
  r.at += n
  b
}

fn (var r: PRd) str() -> Str { r.raw().to_str() ?? "" }

fn dec_locals(var r: PRd) -> List[PdbLocal] {
  let n = r.count()
  var out = List[PdbLocal].with_capacity(n)
  for _ in 0..n {
    let name = r.str()
    let ty = r.int()
    let param = r.int() != 0
    let nd = r.count()
    var defs = List[(Int, Bytes)].with_capacity(nd)
    for _ in 0..nd {
      let kind = r.int()
      defs.push((kind, r.raw()))
    }
    out.push(PdbLocal{name: name, ty: ty, param: param, defs: defs})
  }
  out
}

/// enc_obj_pdb's bytes read back (None: not such bytes).
pub fn dec_obj_pdb(b: Bytes) -> ObjPdb? { dec_obj_pdb_lazy(b, false) }

/// dec_obj_pdb; lazy: the functions' records left in raw, by fn_index.
pub fn dec_obj_pdb_lazy(b: Bytes, lazy: Bool) -> ObjPdb? {
  let m = OBJPDB_MAGIC.bytes()
  if b.len() < m.len() || b[0..m.len()] != m {
    return None
  }
  var r = PRd{b: b, at: m.len()}
  var types: Map[Int, debug.Type] = {}
  for _ in 0..r.count() {
    let off = r.int()
    let tag = r.int()
    let name = r.str()
    let size = r.int()
    let enc = r.int()
    let of = r.int()
    let cnt = r.int()
    let nm = r.count()
    var ms = List[debug.Member].with_capacity(nm)
    for _ in 0..nm {
      let mn = r.str()
      let mt = r.int()
      ms.push(debug.Member{name: mn, ty: mt, offset: r.int()})
    }
    types[off] = debug.Type{tag: tag, name: name, size: size, enc: enc, of: of, members: ms, count: cnt}
  }
  let nt = r.count()
  var tys = List[Int].with_capacity(nt)
  for _ in 0..nt {
    tys.push(r.int())
  }
  let nft = r.count()
  var fn_tys = List[(Int, Int)].with_capacity(nft)
  for _ in 0..nft {
    let lo = r.int()
    fn_tys.push((lo, r.int()))
  }
  let nf = r.count()
  var files = List[Str].with_capacity(nf)
  for _ in 0..nf {
    files.push(r.str())
  }
  let nfn = r.count()
  var fns = List[ObjFn].with_capacity(if lazy { 0 } else { nfn })
  var index = List[(Int, Int, Int)].with_capacity(if lazy { nfn } else { 0 })
  for _ in 0..nfn {
    let lo = r.int()
    let n = r.count()
    if lazy {
      index.push((lo, r.at, n))
      r.at += n
      continue
    }
    let end = r.at + n
    let f = dec_fn(r)
    if r.at != end {
      return None
    }
    fns.push(f)
  }
  if r.bad || r.at != b.len() {
    return None
  }
  Some(ObjPdb{types: types, tys: tys, fn_tys: fn_tys, files: files, fns: fns, raw: if lazy { b } else { "".bytes() }, fn_index: index})
}

/// A function's record (enc_fn) at r.
fn dec_fn(var r: PRd) -> ObjFn {
  {
    let name = r.str()
    let lo = r.int()
    let hi = r.int()
    let so = r.int()
    let nr = r.count()
    var rows = List[(Int, Int, Int, Bool)].with_capacity(nr)
    for _ in 0..nr {
      let off = r.int()
      let fi = r.int()
      let line = r.int()
      rows.push((off, fi, line, r.int() != 0))
    }
    let ns = r.count()
    var sites = List[PdbSite].with_capacity(ns)
    for _ in 0..ns {
      let sn = r.str()
      let parent = r.int()
      let nrg = r.count()
      var ranges = List[(Int, Int)].with_capacity(nrg)
      for _ in 0..nrg {
        let a = r.int()
        ranges.push((a, r.int()))
      }
      let ne = r.count()
      var es = List[(Int, Int, Int)].with_capacity(ne)
      for _ in 0..ne {
        let a = r.int()
        let fi = r.int()
        es.push((a, fi, r.int()))
      }
      sites.push(PdbSite{name: sn, parent: parent, ranges: ranges, entries: es, locals: dec_locals(r)})
    }
    ObjFn{name: name, lo: lo, hi: hi, rows: rows, sites: sites, locals: dec_locals(r), sect_off: so}
  }
}

/// The function of a lazily read part (fn_index) at its record's place.
fn part_fn(p: ObjPdb, at: Int) -> ObjFn {
  var r = PRd{b: p.raw, at: at}
  dec_fn(r)
}
