// Reading COFF x86-64 objects (decision 0254 stage 6b, step 4: Xo's own
// PE linker): the file header, the sections with their contents and
// relocations, the symbol table with its auxiliary records, and the
// string table, as coff.xo writes them and as clang writes the zone
// data's and `use c`'s objects.

/// A section of a COFF object: its name, characteristics, contents (empty
/// for uninitialized data, whose size is size), and relocations.
pub struct CSect {
  pub name: Str
  pub chars: Int
  pub data: Bytes
  pub size: Int
  pub relocs: List[CReloc]
}

/// A relocation: at offset addr of its section, of type typ, to symbol
/// table entry sym.
pub struct CReloc {
  pub addr: Int
  pub sym: Int
  pub typ: Int
}

/// A symbol table entry (auxiliary records are kept as entries of kind
/// aux, so indexes are the file's): its name, value, section number (1
/// based; 0 undefined, -1 absolute, -2 debug), storage class, and for a
/// weak external (class 105) its default's index.
pub struct CSym {
  pub name: Str
  pub value: Int
  pub sect: Int
  pub class: Int
  pub aux: Bool = false
  pub weak_default: Int = -1
}

/// A COFF object.
pub struct CObj {
  pub path: Str
  pub sects: List[CSect]
  pub syms: List[CSym]
}

const IMAGE_SYM_CLASS_WEAK_EXTERNAL = 105

/// A name of 8 bytes at b[at..], NUL padded, or `/N` for offset N of the
/// string table (a section's long name), or for a symbol a zero first
/// word and the offset in the second.
fn coff_name(b: Bytes, at: Int, strtab: Int, sym: Bool) -> Str {
  if sym && rd32(b, at) == 0 {
    return coff_cstr(b, strtab + rd32(b, at + 4))
  }
  var end = at
  while end < at + 8 && b[end] != 0 {
    end += 1
  }
  let s = b[at..end].to_str() ?? ""
  if !sym && s.starts_with("/") {
    let off = Int.parse(s.trim_prefix("/")) ?? 0
    return coff_cstr(b, strtab + off)
  }
  s
}

fn coff_cstr(b: Bytes, at: Int) -> Str {
  var end = at
  while end < b.len() && b[end] != 0 {
    end += 1
  }
  b[at..end].to_str() ?? ""
}

/// read_coff: the object b (from path, for messages), or why it is not
/// an x86-64 COFF object.
pub fn read_coff(path: Str, b: Bytes) -> Result[CObj, Str] {
  if b.len() < 20 || rd16(b, 0) != IMAGE_FILE_MACHINE_AMD64 {
    return Err("${path}: not an x86-64 COFF object")
  }
  let nsect = rd16(b, 2)
  let symtab = rd32(b, 8)
  let nsym = rd32(b, 12)
  let opt = rd16(b, 16)
  let strtab = symtab + 18 * nsym
  if strtab > b.len() {
    return Err("${path}: the symbol table is past the end")
  }
  var sects: List[CSect] = []
  for i in 0..nsect {
    let h = 20 + opt + 40 * i
    let size = rd32(b, h + 16)
    let ptr = rd32(b, h + 20)
    let rptr = rd32(b, h + 24)
    let nrel = rd16(b, h + 32)
    let chars = rd32(b, h + 36)
    let uninit = (chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0
    var relocs: List[CReloc] = []
    for k in 0..nrel {
      let r = rptr + 10 * k
      relocs.push(CReloc{addr: rd32(b, r), sym: rd32(b, r + 4), typ: rd16(b, r + 8)})
    }
    sects.push(CSect{name: coff_name(b, h, strtab, false), chars: chars, data: if uninit || ptr == 0 { "".bytes() } else { b[ptr..ptr + size] }, size: size, relocs: relocs})
  }
  var syms: List[CSym] = []
  var i = 0
  while i < nsym {
    let e = symtab + 18 * i
    var sect = rd16(b, e + 12)
    if sect >= 0x8000 {
      sect = sect - 0x10000
    }
    let class = Int(b[e + 16])
    let naux = Int(b[e + 17])
    var s = CSym{name: coff_name(b, e, strtab, true), value: rd32(b, e + 8), sect: sect, class: class}
    if class == IMAGE_SYM_CLASS_WEAK_EXTERNAL && naux > 0 {
      s.weak_default = rd32(b, e + 18)
    }
    syms.push(s)
    for _ in 0..naux {
      syms.push(CSym{name: "", value: 0, sect: 0, class: 0, aux: true})
    }
    i += 1 + naux
  }
  Ok(CObj{path: path, sects: sects, syms: syms})
}

/// The linker options of an object's .drectve section, split at spaces
/// (quoted parts kept whole).
pub fn coff_directives(o: CObj) -> List[Str] {
  var out: List[Str] = []
  for s in o.sects {
    if s.name != ".drectve" {
      continue
    }
    let t = s.data.to_str() ?? ""
    let bs = t.bytes()
    var start = -1
    var quoted = false
    var i = 0
    while i <= bs.len() {
      let end = i == bs.len()
      let c = if end { UInt8(0) } else { bs[i] }
      if !end && c == '"' {
        quoted = !quoted
      } else if end || ((c == ' ' || c == 0) && !quoted) {
        if start >= 0 {
          out.push((bs[start..i].to_str() ?? "").replace("\"", ""))
          start = -1
        }
      } else if start < 0 {
        start = i
      }
      i += 1
    }
  }
  out
}
