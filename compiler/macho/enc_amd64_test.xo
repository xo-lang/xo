  ("vinserti128 $1, 16(%rax), %ymm2, %ymm3", "c4e36d38581001"),
  ("vextracti128 $1, %ymm1, %xmm2", "c4e37d39ca01"),
  ("vextracti128 $1, %ymm9, %xmm10", "c4437d39ca01"),
  ("vextracti128 $1, %ymm2, 16(%rax)", "c4e37d39501001"),
  ("vbroadcasti128 (%rax), %ymm1", "c4e27d5a08"),
  ("vbroadcasti128 16(%r9), %ymm10", "c4427d5a5110"),
  ("vmovdqu (%rax), %ymm1", "c5fe6f08"),
  ("vmovdqu 32(%r9), %ymm10", "c4417e6f5120"),
  ("vmovdqu %ymm1, (%rax)", "c5fe7f08"),
  ("vmovdqu %ymm10, 32(%r9)", "c4417e7f5120"),
  ("vmovdqu %ymm1, %ymm2", "c5fe6fd1"),
  ("vmovdqu %ymm9, %ymm2", "c57e7fca"),
  ("vzeroupper", "c5f877"),
  ("pinsrq $1, %rax, %xmm0", "66480f3a22c001"),
  ("pinsrq $0, %r9, %xmm10", "664d0f3a22d100"),
  ("pextrq $1, %xmm0, %rax", "66480f3a16c001"),
  ("pextrq $0, %xmm11, %r12", "664d0f3a16dc00"),
  ("pinsrd $2, %eax, %xmm1", "660f3a22c802"),
  ("pextrd $3, %xmm1, %ecx", "660f3a16c903"),
  ("btq $62, %rax", "480fbae03e"),
  ("btq %rcx, %rdx", "480fa3ca"),
  ("shldq $5, %rax, %rbx", "480fa4c305"),
  ("shrdq %cl, %rax, %rbx", "480fadc3"),
  ("rep bsfq %rax, %rbx", "f3480fbcd8"),
  ("syscall", "0f05"),
  ("cpuid", "0fa2"),
  ("stc", "f9"),
  ("clc", "f8"),
  ("roundsd $9, %xmm1, %xmm2", "660f3a0bd109"),
  ("roundsd $10, %xmm9, %xmm3", "66410f3a0bd90a"),
  ("roundss $11, 8(%rax), %xmm4", "660f3a0a60080b"),
  ("shrdq $13, %rax, %rbx", "480facc30d"),
  ("rorl $7, %ecx", "c1c907"),
  ("popcntq %r9, %r10", "f34d0fb8d1"),
]

fn hex_bytes(b: List[Int]) -> Str {
  let digits = "0123456789abcdef"
  var s = StrBuilder.new()
  for v in b {
    s.write(digits[(v >> 4) & 15..((v >> 4) & 15) + 1])
    s.write(digits[v & 15..(v & 15) + 1])
  }
  s.freeze()
}

test "every amd64 form encodes as clang's assembler encodes it" {
  var bad: List[Str] = []
  for (ins, want) in AMD64_ENCODINGS {
    let r = encode_x86_line(ins.bytes())
    let got = if r.err.is_empty() { hex_bytes(r.b) } else { "error: ${r.err}" }
    if got != want {
      bad.push("${ins}: got ${got}, want ${want}")
    }
  }
  if bad.len() > 40 {
    bad = bad[0..40] + ["... ${bad.len() - 40} more"]
  }
  expect(bad) == []
}

test "forms with no encoding are refused, not encoded as an address" {
  // 2026-10-20: both came out of x86_const_imm and were assembled as
  // loads from address 0 and 1
  for ins in ["imulq $48, $0, %r11", "movq $1, %xmm14", "movd $1, %xmm0", "movq %xmm1, $3"] {
    let r = encode_x86_line(ins.bytes())
    expect(r.err.is_empty()) == false
  }
  // the valid three operand imul stays
  expect(encode_x86_line("imulq $48, %r11, %r11".bytes()).err) == ""
}

test "every amd64 form round trips through its XInst (decision 0274 step 2)" {
  // parse, print, and encode the printed text: the same bytes; and
  // encode_x86_inst of the parsed XInst gives them too
  var bad: List[Str] = []
  for (ins, want) in AMD64_ENCODINGS {
    match parse_x86_line(ins.bytes()) {
      Ok(x) => {
        let text = print_x86(x)
        let r = encode_x86_line(text.bytes())
        let got = if r.err.is_empty() { hex_bytes(r.b) } else { "error: ${r.err}" }
        let r2 = encode_x86_inst(x)
        let got2 = if r2.err.is_empty() { hex_bytes(r2.b) } else { "error: ${r2.err}" }
        if got != want || got2 != want {
          bad.push("${ins}: printed `${text}`, got ${got} and ${got2}, want ${want}")
        }
      }
      Err(why) => bad.push("${ins}: ${why}")
    }
  }
  if bad.len() > 40 {
    bad = bad[0..40] + ["... ${bad.len() - 40} more"]
  }
  expect(bad) == []
}

test "xo_preempt_stub's instructions encode as clang's (decision 0286 step 3)" {
  // clang -c --target=x86_64-unknown-linux-gnu, llvm-objdump -d
  let want: List[(Str, Str)] = [
    ("pushfq", "9c"),
    ("popfq", "9d"),
    ("andq $-16, %rsp", "4883e4f0"),
    ("leaq -8(%rbp), %rsp", "488d65f8"),
    ("movups %xmm15, 344(%rsp)", "440f11bc2458010000"),
  ]
  var bad: List[Str] = []
  for (ins, w) in want {
    let r = encode_x86_line(ins.bytes())
    let got = if r.err.is_empty() { hex_bytes(r.b) } else { "error: ${r.err}" }
    if got != w {
      bad.push("${ins}: got ${got}, want ${w}")
    }
  }
  expect(bad) == []
}
