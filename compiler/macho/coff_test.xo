// The COFF writer (coff.xo, decision 0254 6b step 3) against the object
// `llvm-mc -triple=x86_64-pc-windows-msvc -filetype=obj` (LLVM 23.1.3,
// winxc) writes for the same text: a function with landing pad data
// (.seh_handler, .seh_handlerdata), a call, rip relative data and a
// thread local through @SECREL32, .rdata, .data with an address, .tls$
// and a .drectve. scripts/coff-compare.sh checks every golden's
// windows/amd64 assembly the same way.

const COFF_SAMPLE = r#"	.text
	.globl f
	.p2align 4
f:
.Lf_begin:
	.seh_proc f
	.seh_handler xo_x_personality, @unwind, @except
	pushq %rbp
	.seh_pushreg %rbp
	movq %rsp, %rbp
	pushq %rbx
	.seh_pushreg %rbx
	subq $24, %rsp
	.seh_stackalloc 24
	.seh_endprologue
.Lcs0:
	callq g
.Lcs1:
	leaq msg(%rip), %rax
	movq tab(%rip), %rcx
	movl _tls_index(%rip), %eax
	leaq xo_tlocal@SECREL32(%rax), %rax
	addq $24, %rsp
	popq %rbx
	popq %rbp
	retq
.Lpad:
	ud2
	.seh_handlerdata
	.byte 255
	.byte 255
	.byte 1
	.uleb128 .Lcse-.Lcsb
.Lcsb:
	.uleb128 .Lcs0-.Lf_begin
	.uleb128 .Lcs1-.Lcs0
	.uleb128 .Lpad-.Lf_begin
	.byte 0
.Lcse:
	.text
	.seh_endproc
	.section .rdata,"dr"
msg:
	.ascii "hi"
	.data
	.globl tab
	.p2align 3
tab:
	.quad f
	.section .tls$,"dw"
	.globl xo_tlocal
xo_tlocal:
	.quad 0
	.section .drectve,"yn"
	.ascii " /alternatename:weak=xo_absent"
"#

const COFF_SAMPLE_OBJ = ""

test "the COFF sample assembles to llvm-mc's object" {
  match assemble_coff_amd64_raw(COFF_SAMPLE.bytes()) {
    Ok(o) => {
      let got = hex_of(o)
      var i = 0
      while i < got.len() && i < COFF_SAMPLE_OBJ.len() && got[i..i + 1] == COFF_SAMPLE_OBJ[i..i + 1] {
        i += 1
      }
      expect(i / 2) == COFF_SAMPLE_OBJ.len() / 2
      expect(got.len()) == COFF_SAMPLE_OBJ.len()
    }
    Err(e) => expect(e) == ""
  }
}

test "a COFF unwind code needs a .seh_proc" {
  match assemble_coff_amd64("\t.text\nf:\n\t.seh_pushreg %rbp\n".bytes()) {
    Ok(_) => expect(false) == true
    Err(e) => expect(e.contains("outside a .seh_proc")) == true
  }
}

test "JamCRC: zero bytes are 0, as LLVM's COFF checksums" {
  expect(jamcrc("".bytes())) == 0
  expect(jamcrc(int_bytes([0, 0, 0, 0, 0, 0, 0, 0]))) == 0
}

test "a section with more than 65535 relocations keeps them all (extended relocations)" {
  // 70000 calls of an external function: 70000 REL32 relocations in .text,
  // past the section header's 16 bit count (0.25.1's xo.exe lost those
  // past 65536 and faulted in every build)
  var b = StrBuilder.new()
  b.write("\t.text\n\t.globl f\nf:\n")
  for _ in 0..70000 {
    b.write("\tcallq ext\n")
  }
  b.write("\tretq\n")
  let obj = match assemble_coff_amd64_raw(b.freeze().bytes()) {
    Ok(o) => o
    Err(e) => fault(e)
  }
  let c = match read_coff("t.obj", obj) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  var text = -1
  for (i, s) in c.sects.indexed() {
    if s.name == ".text" {
      text = i
    }
  }
  expect(text >= 0) == true
  expect(c.sects[text].relocs.len()) == 70000
  expect((c.sects[text].chars & IMAGE_SCN_LNK_NRELOC_OVFL) != 0) == true
  // each relocation at its call's field (the first at byte 1)
  expect(c.sects[text].relocs[0].addr) == 1
  expect(c.sects[text].relocs[69999].addr) == 5 * 69999 + 1
}

test "a section with few relocations has no extended relocation entry" {
  let obj = match assemble_coff_amd64("\t.text\n\t.globl f\nf:\n\tcallq ext\n\tretq\n".bytes()) {
    Ok(o) => o
    Err(e) => fault(e)
  }
  let c = match read_coff("t.obj", obj) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  for s in c.sects {
    if s.name == ".text" {
      expect(s.relocs.len()) == 1
      expect((s.chars & IMAGE_SCN_LNK_NRELOC_OVFL) != 0) == false
    }
  }
}

test "a prologue past 255 bytes is an error, not a wrapped UNWIND_INFO" {
  // an x86 frame probed a page at a time: 20 pages, about 300 bytes
  var b = StrBuilder.new()
  b.write("\t.text\n\t.globl f\nf:\n\t.seh_proc f\n\tpushq %rbp\n\t.seh_pushreg %rbp\n")
  for _ in 0..20 {
    b.write("\tsubq $4096, %rsp\n\tmovq $0, (%rsp)\n")
  }
  b.write("\t.seh_stackalloc 81920\n\t.seh_endprologue\n\tretq\n\t.seh_endproc\n")
  match assemble_coff_amd64(b.freeze().bytes()) {
    Ok(_) => fault("assembled a prologue past 255 bytes")
    Err(e) => expect(e.contains("UNWIND_INFO")) == true
  }
}

// COFF atoms (decision 0388): with `.subsections_via_symbols` a branch or a
// reference to another function of the section, or to a label inside one,
// is a relocation naming that function, so pelink may strip by atom;
// without it they are resolved in place, as before.
fn coff_atoms_src(directive: Bool) -> Bytes {
  "${if directive { "\t.subsections_via_symbols\n" } else { "" }}\t.text\n\t.globl f\nf:\n\tcallq g\n\tjmp .Lout\n.Lout:\n\tjmp .Lin\n\tleaq .Lin(%rip), %rax\n\tretq\n\t.globl g\ng:\n\tnop\n.Lin:\n\tretq\n".bytes()
}

fn coff_text_relocs(src: Bytes) -> List[Str] {
  let obj = match assemble_coff_amd64(src) {
    Ok(o) => o
    Err(e) => fault(e)
  }
  let c = match read_coff("t.obj", obj) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  var out: List[Str] = []
  for s in c.sects {
    if s.name == ".text" {
      for r in s.relocs {
        out.push(c.syms[r.sym].name)
      }
    }
  }
  out
}

test "COFF atoms: references into another function are relocations to it" {
  // callq g, jmp .Lin and leaq .Lin: all name g (.Lin is in g's atom);
  // jmp .Lout stays in f's atom, resolved
  expect(coff_text_relocs(coff_atoms_src(true))) == ["g", "g", "g"]
}

test "COFF without atoms: the same references are resolved in place" {
  expect(coff_text_relocs(coff_atoms_src(false))) == []
}
