// The COFF writer (coff.xo, decision 0254 6b step 3) against the object
// `llvm-mc -triple=x86_64-pc-windows-msvc -filetype=obj` (LLVM 23.1.3,
// winxc) writes for the same text: a function with landing pad data
// (.seh_handler, .seh_handlerdata), a call, rip relative data and a
// thread local through @SECREL32, .rdata, .data with an address, .tls$
// and a .drectve. scripts/coff-compare.sh checks every golden's
// windows/amd64 assembly the same way.

const COFF_SAMPLE = r#"	.text
	.globl f
	.p2align 4
f:
.Lf_begin:
	.seh_proc f
	.seh_handler xo_x_personality, @unwind, @except
	pushq %rbp
	.seh_pushreg %rbp
	movq %rsp, %rbp
	pushq %rbx
	.seh_pushreg %rbx
	subq $24, %rsp
	.seh_stackalloc 24
	.seh_endprologue
.Lcs0:
	callq g
.Lcs1:
	leaq msg(%rip), %rax
	movq tab(%rip), %rcx
	movl _tls_index(%rip), %eax
	leaq xo_tlocal@SECREL32(%rax), %rax
	addq $24, %rsp
	popq %rbx
	popq %rbp
	retq
.Lpad:
	ud2
	.seh_handlerdata
	.byte 255
	.byte 255
	.byte 1
	.uleb128 .Lcse-.Lcsb
.Lcsb:
	.uleb128 .Lcs0-.Lf_begin
	.uleb128 .Lcs1-.Lcs0
	.uleb128 .Lpad-.Lf_begin
	.byte 0
.Lcse:
	.text
	.seh_endproc
	.section .rdata,"dr"
msg:
	.ascii "hi"
	.data
	.globl tab
	.p2align 3
tab:
	.quad f
	.section .tls$,"dw"
	.globl xo_tlocal
xo_tlocal:
	.quad 0
	.section .drectve,"yn"
	.ascii " /alternatename:weak=xo_absent"
"#

const COFF_SAMPLE_OBJ = ""

test "the COFF sample assembles to llvm-mc's object" {
  match assemble_coff_amd64(COFF_SAMPLE.bytes()) {
    Ok(o) => {
      let got = hex_of(o)
      var i = 0
      while i < got.len() && i < COFF_SAMPLE_OBJ.len() && got[i..i + 1] == COFF_SAMPLE_OBJ[i..i + 1] {
        i += 1
      }
      expect(i / 2) == COFF_SAMPLE_OBJ.len() / 2
      expect(got.len()) == COFF_SAMPLE_OBJ.len()
    }
    Err(e) => expect(e) == ""
  }
}

test "a COFF unwind code needs a .seh_proc" {
  match assemble_coff_amd64("\t.text\nf:\n\t.seh_pushreg %rbp\n".bytes()) {
    Ok(_) => expect(false) == true
    Err(e) => expect(e.contains("outside a .seh_proc")) == true
  }
}

test "JamCRC: zero bytes are 0, as LLVM's COFF checksums" {
  expect(jamcrc("".bytes())) == 0
  expect(jamcrc(int_bytes([0, 0, 0, 0, 0, 0, 0, 0]))) == 0
}
