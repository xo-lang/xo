// The dSYM of an executable (decision 0239): the inputs' DWARF sections
// (__DWARF,__debug_line, __debug_abbrev, __debug_info), which the link
// leaves out of the executable as ld64 does, joined per section with
// their addresses relocated, in a Mach-O file of type MH_DSYM with the
// executable's LC_UUID, which lldb and the profiler find at
// PROG.dSYM/Contents/Resources/DWARF/PROG.
//
// The arm64 emitter's compile units (compiler/arm64 debug.xo, producer
// "xo") give their abbreviations' and line program's offsets as 0 within
// their object; here each is moved by where its object's chunk lands:
// the abbreviation offset at byte 8 of the unit, DW_AT_stmt_list, the
// unit's first attribute, at byte 13, and DW_AT_loclists_base and
// DW_AT_addr_base at bytes 38 and 42 (decision 0252: its variables'
// location lists, and the address table dsymutil's rewrite needs), and
// DW_AT_comp_dir at byte 46 and the line table's directories at its
// bytes 34 and 38 (DW_FORM_strp into __debug_str's path slots). Its low_pc and high_pc
// (bytes 17 and 25) make .debug_aranges, which lldb maps addresses to
// units by.

const MH_DSYM = 0xa

/// The DWARF sections joined, in this order (the executable's __DWARF
/// segment and the dSYM's).
fn dwarf_names() -> List[Str] { ["__debug_line", "__debug_abbrev", "__debug_info", "__debug_aranges", "__debug_loclists", "__debug_addr", "__debug_str", "__debug_line_str"] }

/// The sizes dwarf_data's sections will have, known before the
/// relocations (layout reserves the executable's __DWARF segment): the
/// inputs' sections joined, and .debug_aranges a 48 byte set more per
/// compile unit of the arm64 emitter's; all 0 when no input has DWARF.
fn (l: Linker) dwarf_sizes() -> List[Int] {
  let names = dwarf_names()
  var sizes: List[Int] = []
  for _ in names {
    sizes.push(0)
  }
  var any = false
  for o in 0..l.objs.len() {
    if !l.objs[o].live || !l.xo_dwarf(o) {
      continue
    }
    for s in l.objs[o].sects {
      if s.seg != "__DWARF" {
        continue
      }
      for (i, nm) in names.indexed() {
        if s.name == nm {
          sizes[i] = sizes[i] + s.data.len()
          any = true
          if i == 2 {
            // its unit's address range set (dwarf_data)
            sizes[3] = sizes[3] + 48
          }
        }
      }
    }
  }
  if !any {
    return []
  }
  sizes
}

/// The DWARF sections of dwarf_names, joined (empty when no input has
/// DWARF): dwarf_write's output cut at its sections' lengths.
fn (var l: Linker) dwarf_data() -> List[Bytes] {
  var b = BytesBuilder.new()
  let ns = l.dwarf_write(b)
  let all = b.freeze()
  var data: List[Bytes] = []
  var at = 0
  for n in ns {
    data.push(all[at..at + n])
    at += n
  }
  data
}

/// The dSYM file, or empty bytes when no input has DWARF.
fn (var l: Linker) dsym() -> Bytes {
  let data = l.dwarf_data()
  if data.is_empty() {
    return zeros(0)
  }
  l.dsym_file(data)
}

/// The DWARF sections of dwarf_names, joined and written to out one
/// after another (the executable's __DWARF segment, with no copy of its
/// own): each object's section copied as one piece around its patches,
/// not byte by byte (a std sized link spent about 13 ms of CPU in the
/// byte lists, 2026-10-27). The sections' lengths, none when no input
/// has DWARF.
fn (var l: Linker) dwarf_write(var out: BytesBuilder) -> List[Int] {
  // only the arm64 emitter's objects (a compile unit with producer
  // "xo"): another compiler's Mach-O DWARF refers between its sections by
  // offsets in its own object, with no relocations, which joining would
  // break (ld64 leaves them in the objects for dsymutil)
  let names = dwarf_names()
  // per section: its pieces (object, section index) and per object the
  // piece's offset in the joined section
  var parts: List[List[(Int, Int)]] = []
  var at: List[Map[Int, Int]] = []
  var any = false
  for nm in names {
    var ps: List[(Int, Int)] = []
    var offs: Map[Int, Int] = {}
    var n = 0
    for o in 0..l.objs.len() {
      if !l.objs[o].live || !l.xo_dwarf(o) {
        continue
      }
      for (k, s) in l.objs[o].sects.indexed() {
        if s.seg != "__DWARF" || s.name != nm {
          continue
        }
        any = true
        offs[o] = n
        ps.push((o, k))
        n += s.data.len()
      }
    }
    parts.push(ps)
    at.push(offs)
  }
  if !any {
    return []
  }
  var lens: List[Int] = []
  // the xo compile units' address ranges, one set each (.debug_aranges,
  // after its pieces)
  var sets = BytesBuilder.new()
  l.dw_dead_zero = true
  for (i, ps) in parts.indexed() {
    let start = out.len()
    for (o, k) in ps {
      let s = l.objs[o].sects[k]
      var ch: List[BytePatch] = []
      // the 64 bit addresses (.quad label): relocated
      for r in s.relocs {
        if r.typ != R_UNSIGNED || r.len != 3 || r.pcrel {
          continue
        }
        let t = l.target(o, r, rd64(s.data, r.addr))
        if t.imp >= 0 {
          continue
        }
        ch.push(BytePatch{at: r.addr, n: 8, v: t.addr})
      }
      if i == 2 {
        dw_unit(o, s, ch, at, out.len() - start, sets, if l.objs[o].subsections { l.live_text(o) } else { None })
      } else if i == 0 {
        dw_line(s.data, ch, at[7].get(o) ?? 0)
      }
      write_patched(out, s.data, ch)
    }
    if i == 3 {
      out.write(sets.freeze())
      sets = BytesBuilder.new()
    }
    lens.push(out.len() - start)
  }
  l.dw_dead_zero = false
  lens
}

/// The patches of an xo compile unit (one per object, at the start of
/// its __debug_info piece s, placed at off in the joined section): its
/// abbreviation, line, loclists, addr and comp_dir offsets moved by where
/// the object's pieces of those sections went, and its address range
/// set appended to sets.
fn dw_unit(o: Int, s: ISect, var ch: List[BytePatch], at: List[Map[Int, Int]], off: Int, var sets: BytesBuilder, live: (Int, Int)?) {
  let d = s.data
  if d.len() < 36 || Int(d[33]) != 120 || Int(d[34]) != 111 || Int(d[35]) != 0 {
    return
  }
  ch.push(BytePatch{at: 8, n: 4, v: rd32(d, 8) + (at[1].get(o) ?? 0)})
  ch.push(BytePatch{at: 13, n: 4, v: rd32(d, 13) + (at[0].get(o) ?? 0)})
  if d.len() >= 46 {
    ch.push(BytePatch{at: 38, n: 4, v: rd32(d, 38) + (at[4].get(o) ?? 0)})
    ch.push(BytePatch{at: 42, n: 4, v: rd32(d, 42) + (at[5].get(o) ?? 0)})
  }
  if d.len() >= 50 {
    // DW_AT_comp_dir, DW_FORM_strp
    ch.push(BytePatch{at: 46, n: 4, v: rd32(d, 46) + (at[6].get(o) ?? 0)})
  }
  // low_pc and high_pc, relocated
  var lo = rd64(d, 17)
  var hi = rd64(d, 25)
  for p in ch {
    if p.at == 17 && p.n == 8 {
      lo = p.v
    } else if p.at == 25 && p.n == 8 {
      hi = p.v
    }
  }
  if let Some((llo, lhi)) = live {
    // an object split into atoms (strip.xo): the unit covers its live
    // functions, placed together, not its first and last label, which
    // may be gone (decision 0388)
    var kept: List[BytePatch] = []
    for p in ch {
      if !(p.n == 8 && (p.at == 17 || p.at == 25)) {
        kept.push(p)
      }
    }
    kept.push(BytePatch{at: 17, n: 8, v: llo})
    kept.push(BytePatch{at: 25, n: 8, v: lhi})
    ch = kept
    lo = llo
    hi = lhi
  }
  // a set: length, version 2, the unit's offset, address size 8,
  // segment size 0, padding to 16, (low, length), (0, 0)
  var a = new_out(48)
  a.u32(44)
  a.u16(2)
  a.u32(off)
  a.u8(8)
  a.zeros(16 - a.n)
  a.u64(lo)
  a.u64(hi - lo)
  a.zeros(48 - a.n)
  sets.write(a.done())
}

/// The live functions' text of object o (a split one): from the first
/// placed __TEXT,__text atom's address to the last one's end, or None.
fn (l: Linker) live_text(o: Int) -> (Int, Int)? {
  var lo = -1
  var hi = -1
  for s in l.objs[o].sects {
    if s.out < 0 || s.seg != "__TEXT" || s.name != "__text" {
      continue
    }
    let a = l.osects[s.out].addr + s.off
    if lo < 0 || a < lo {
      lo = a
    }
    if a + s.size > hi {
      hi = a + s.size
    }
  }
  if lo < 0 { None } else { Some((lo, hi)) }
}

/// The patches of a __debug_line piece d: the paths (DW_FORM_line_strp
/// into the object's __debug_line_str slots, 2026-10-22) moved by so,
/// where the object's __debug_line_str went: the line table's
/// directories at bytes 34 and 38 (their count at 33, the form at 32) and
/// the file names.
fn dw_line(d: Bytes, var ch: List[BytePatch], so: Int) {
  if d.len() < 38 || Int(d[32]) != 0x1f {
    return
  }
  ch.push(BytePatch{at: 34, n: 4, v: rd32(d, 34) + so})
  let nd = Int(d[33])
  if nd == 2 && d.len() >= 42 {
    ch.push(BytePatch{at: 38, n: 4, v: rd32(d, 38) + so})
  }
  // the file names (line_strp since 2026-10-22, after the slots):
  // format count 2, (path, line_strp), (directory index, udata), the
  // count, then each name's offset and its directory index
  var p = 34 + 4 * nd
  if p + 5 > d.len() || Int(d[p]) != 2 || Int(d[p + 1]) != 1 || Int(d[p + 2]) != 0x1f {
    return
  }
  p += 5
  let (n, q) = get_uleb(d, p)
  p = q
  for _ in 0..n {
    if p + 4 > d.len() {
      break
    }
    ch.push(BytePatch{at: p, n: 4, v: rd32(d, p) + so})
    let (_, r) = get_uleb(d, p + 4)
    p = r
  }
}

/// The dSYM file of the joined DWARF data.
fn (var l: Linker) dsym_file(data: List[Bytes]) -> Bytes {
  let names = dwarf_names()
  // MH_DSYM: header, LC_UUID, the executable's segments and sections
  // without contents (lldb maps addresses through them, as in a dSYM of
  // dsymutil), then LC_SEGMENT_64 __DWARF with the DWARF sections
  let nsect = names.len()
  var segs: List[OSeg] = []
  var vend = 0
  for g in l.segs {
    // (the executable's own __DWARF, decision 0346, is this file's)
    if g.name != "__LINKEDIT" && g.name != "__DWARF" {
      segs.push(g)
    }
    if g.vmaddr + g.vmsize > vend {
      vend = g.vmaddr + g.vmsize
    }
  }
  var cmds = 24 + 72 + 80 * nsect
  var ncmds = 2
  for g in segs {
    cmds += 72 + 80 * g.sects.len()
    ncmds += 1
  }
  var hdr = new_out(4096)
  hdr.u32(MH_MAGIC_64)
  hdr.u32(CPU_TYPE_ARM64)
  hdr.u32(0)
  hdr.u32(MH_DSYM)
  hdr.u32(ncmds)
  hdr.u32(cmds)
  hdr.u32(0)
  hdr.u32(0)
  hdr.u32(LC_UUID)
  hdr.u32(24)
  hdr.bytes(l.uuid)
  for g in segs {
    hdr.u32(LC_SEGMENT_64)
    hdr.u32(72 + 80 * g.sects.len())
    hdr.name(g.name, 16)
    hdr.u64(g.vmaddr)
    hdr.u64(g.vmsize)
    hdr.u64(0)
    hdr.u64(0)
    let prot = if g.name == "__PAGEZERO" { 0 } else if g.name == "__TEXT" { 5 } else { 3 }
    hdr.u32(prot)
    hdr.u32(prot)
    hdr.u32(g.sects.len())
    hdr.u32(0)
    for si in g.sects {
      let s = l.osects[si]
      hdr.name(s.name, 16)
      hdr.name(s.seg, 16)
      hdr.u64(s.addr)
      hdr.u64(s.size)
      hdr.u32(0)
      hdr.u32(s.align)
      hdr.u32(0)
      hdr.u32(0)
      hdr.u32(s.flags)
      hdr.u32(s.reserved1)
      hdr.u32(s.reserved2)
      hdr.u32(0)
    }
  }
  let start = 32 + cmds
  var total = 0
  for d in data {
    total += d.len()
  }
  hdr.u32(LC_SEGMENT_64)
  hdr.u32(72 + 80 * nsect)
  hdr.name("__DWARF", 16)
  let dwbase = (vend + 0xfff) / 0x1000 * 0x1000
  hdr.u64(dwbase)
  hdr.u64((total + 0xfff) / 0x1000 * 0x1000)
  hdr.u64(start)
  hdr.u64(total)
  hdr.u32(7)
  hdr.u32(3)
  hdr.u32(nsect)
  hdr.u32(0)
  var off = start
  var addr = dwbase
  for (i, nm) in names.indexed() {
    hdr.name(nm, 16)
    hdr.name("__DWARF", 16)
    hdr.u64(addr)
    hdr.u64(data[i].len())
    hdr.u32(off)
    hdr.u32(0)
    hdr.u32(0)
    hdr.u32(0)
    hdr.u32(S_ATTR_DEBUG_FLAG)
    hdr.u32(0)
    hdr.u32(0)
    hdr.u32(0)
    off += data[i].len()
    addr += data[i].len()
  }
  for d in data {
    hdr.bytes(d)
  }
  hdr.done()
}

/// Whether object o's __debug_info is the arm64 emitter's (debug.xo).
fn (l: Linker) xo_dwarf(o: Int) -> Bool {
  for s in l.objs[o].sects {
    if s.seg == "__DWARF" && s.name == "__debug_info" {
      return s.data.len() > 36 && Int(s.data[33]) == 120 && Int(s.data[34]) == 111 && Int(s.data[35]) == 0
    }
  }
  false
}

/// The ULEB128 at b[o] and the offset after it.
fn get_uleb(b: Bytes, o: Int) -> (Int, Int) {
  var v = 0
  var sh = 0
  var p = o
  while p < b.len() {
    let c = Int(b[p])
    p += 1
    v = v | shl(c & 0x7f, sh)
    sh += 7
    if c < 0x80 {
      break
    }
  }
  (v, p)
}
