// The store's format-neutral core (decision 0388 stage 4): what an
// object format's adapter hands store_write (store.xo is Mach-O's; a
// COFF adapter goes beside it). An object is split into atoms by its
// adapter; each atom carries its bytes, its relocation records (opaque,
// a fixed size per format: field 0, a u32, its address in the atom),
// the DWARF runs it is cut into (dwtrim.xo) and its edges as store atom
// numbers. The file's layout is store.xo's (STORE_REC, STORE_SYM).

/// A cut run's record in the data region (store_write, cut).
const STORE_RUN = 28

/// An atom (or a section kept whole) for store_write.
pub struct CoreSect {
  pub seg: Str
  pub name: Str
  pub align: Int
  pub flags: Int
  pub addr: Int
  pub size: Int
  pub data: Bytes
  /// its relocation records and their count (none when it has runs)
  pub relocs: Bytes
  pub nrel: Int
  /// a cut DWARF section's runs, each with its own relocation records
  pub runs: List[CoreRun] = []
  /// the store atoms it reaches
  pub edges: List[Int] = []
}

/// A run of a cut DWARF section (dwtrim.xo DwSeg): its bytes, its
/// function's store atom (-1: always kept) and its relocation records,
/// by address.
pub struct CoreRun {
  pub start: Int
  pub end: Int
  pub fn_atom: Int
  /// a type's or an abstract subprogram's run: kept when a kept run
  /// refers to it (dwtrim.xo dw_keep)
  pub typ: Bool = false
  /// its unit relative references: each field's place, its target
  pub refs: List[(Int, Int)] = []
  pub relocs: Bytes
  pub nrel: Int
}

/// A symbol: its name, the format's type, section ordinal (an atom's,
/// 1 based; 0 for none), desc and value.
pub struct CoreSym {
  pub name: Bytes
  pub typ: Int
  pub sect: Int
  pub desc: Int
  pub value: Int
}

/// An object: its atoms, its symbols, its split map (an original
/// section's ordinal -> its atoms' start addresses and ordinals) and the
/// store atoms of the functions its xo unit describes when the unit goes
/// with them (dwtrim.xo dw_droppable).
pub struct CoreObj {
  pub path: Str
  pub sects: List[CoreSect]
  pub syms: List[CoreSym]
  pub split: Map[Int, List[(Int, Int)]]
  pub unit_fns: List[Int]
}

/// The store of objs, with defs, the global definitions (name, store
/// atom; the adapter chose between a weak and a strong one).
pub fn store_write(objs: List[CoreObj], defs: List[(Bytes, Int)]) -> Bytes {
  var total = 0
  for ob in objs {
    total += ob.sects.len()
  }
  var hb = BytesBuilder.new()
  var db = BytesBuilder.new()
  sw32(hb, objs.len())
  sw32(hb, total)
  // the section names (segment, section), once each
  var name_ix: Map[Str, Int] = {}
  var names: List[(Str, Str)] = []
  for ob in objs {
    for s in ob.sects {
      let key = "${s.seg},${s.name}"
      if !name_ix.contains(key) {
        name_ix[key] = names.len()
        names.push((s.seg, s.name))
      }
    }
  }
  sw32(hb, names.len())
  for (sg, nm) in names {
    swbytes(hb, sg.bytes())
    swbytes(hb, nm.bytes())
  }
  // the global definitions sorted by name, for the link's binary search
  let sorted = defs.sort_by(fn(d: (Bytes, Int)) -> Str { bstr(d.0) })
  sw32(hb, sorted.len())
  for (nm, atom) in sorted {
    sw32(hb, db.len())
    sw32(hb, nm.len())
    db.write(nm)
    sw32(hb, atom)
  }
  for ob in objs {
    swbytes(hb, ob.path.bytes())
    sw32(hb, ob.sects.len())
    // a record of STORE_REC bytes a section
    for s in ob.sects {
      sw32(hb, name_ix.get("${s.seg},${s.name}") ?? 0)
      sw32(hb, s.align)
      sw32(hb, s.flags)
      sw32(hb, db.len())
      sw32(hb, s.data.len())
      db.write(s.data)
      sw32(hb, db.len())
      sw32(hb, s.nrel)
      db.write(s.relocs)
      // its runs, in the data region
      var gb = BytesBuilder.new()
      // (STORE_RUN bytes each: start, end, the function's atom, or
      // 0xffffffff always kept, 0xfffffffe a type's; relocations' place
      // and count; references' place and count, 8 bytes each)
      for x in s.runs {
        sw32(gb, x.start)
        sw32(gb, x.end)
        sw32(gb, if x.fn_atom >= 0 { x.fn_atom } else if x.typ { 0xfffffffe } else { 0xffffffff })
        sw32(gb, db.len())
        db.write(x.relocs)
        sw32(gb, x.nrel)
        sw32(gb, db.len())
        for (pos, t) in x.refs {
          sw32(db, pos)
          sw32(db, t)
        }
        sw32(gb, x.refs.len())
      }
      sw32(hb, s.runs.len())
      sw32(hb, db.len())
      db.write(gb.freeze())
      sw64(hb, s.addr)
      sw64(hb, s.size)
    }
    // the symbols as STORE_SYM byte records, names in the data region
    sw32(hb, ob.syms.len())
    for s in ob.syms {
      sw32(hb, db.len())
      sw32(hb, s.name.len())
      db.write(s.name)
      sw32(hb, s.typ)
      sw32(hb, s.sect)
      sw32(hb, s.desc)
      sw64(hb, s.value)
    }
    let keys = ob.split.keys().sort()
    sw32(hb, keys.len())
    for k in keys {
      let atoms = ob.split.get(k) ?? []
      sw32(hb, k)
      sw32(hb, atoms.len())
      for (a, ord) in atoms {
        sw64(hb, a)
        sw32(hb, ord)
      }
    }
    sw32(hb, ob.unit_fns.len())
    for id in ob.unit_fns {
      sw32(hb, id)
    }
    // each atom's edges
    for s in ob.sects {
      sw32(hb, s.edges.len())
      for id in s.edges {
        sw32(hb, id)
      }
    }
  }
  var out = BytesBuilder.new()
  out.write(STORE_MAGIC.bytes())
  let h = hb.freeze()
  sw32(out, h.len())
  out.write(h)
  out.write(db.freeze())
  out.freeze()
}

/// A store, read in place: the header's places (store_view). The
/// adapter decodes what it keeps (relocation records in its own shape).
pub struct StoreView {
  pub b: Bytes
  /// the data region's start
  pub data0: Int
  /// the objects, and the atoms in all
  pub n: Int
  pub total: Int
  /// the section names (segment, section) records index
  pub names: List[(Str, Str)]
  /// the global definitions' table: its place and length
  dt: Int
  ndefs: Int
  /// per object: its path, first section record, section count, first
  /// symbol record, symbol count, split map, droppable unit's function
  /// atoms, first atom number
  pub paths: List[Str]
  pub recs: List[Int]
  pub nsects: List[Int]
  pub syms_at: List[Int]
  pub nsyms: List[Int]
  pub splits: List[List[(Int, List[(Int, Int)])]]
  pub unit_fns: List[List[Int]]
  pub base: List[Int]
  /// each atom's edges' place
  edge_at: List[Int]
}

/// The store's header read (no section, symbol or relocation decoded),
/// or why it is not one.
pub fn store_view(store: Bytes) -> Result[StoreView, Str] {
  if store.len() < 12 || bstr(store[0..8]) != STORE_MAGIC {
    return Err("not an xo std store")
  }
  let data0 = 12 + rd32(store, 8)
  // (read in place: a slice is a copy)
  var r = SR{b: store, at: 12}
  let n = r.u32()
  let total = r.u32()
  var names: List[(Str, Str)] = []
  for _ in 0..r.u32() {
    let sg = bstr(r.bytes())
    names.push((sg, bstr(r.bytes())))
  }
  let ndefs = r.u32()
  let dt = r.at
  r.at += 12 * ndefs
  var v = StoreView{b: store, data0: data0, n: n, total: total, names: names, dt: dt, ndefs: ndefs, paths: List.with_capacity(n), recs: List.with_capacity(n), nsects: List.with_capacity(n), syms_at: List.with_capacity(n), nsyms: List.with_capacity(n), splits: List.with_capacity(n), unit_fns: List.with_capacity(n), base: List.with_capacity(n), edge_at: List.with_capacity(total)}
  for _ in 0..n {
    v.base.push(v.edge_at.len())
    v.paths.push(bstr(r.bytes()))
    let ns = r.u32()
    v.nsects.push(ns)
    v.recs.push(r.at)
    r.at += STORE_REC * ns
    let nsym = r.u32()
    v.nsyms.push(nsym)
    v.syms_at.push(r.at)
    r.at += STORE_SYM * nsym
    let nsplit = r.u32()
    var sp: List[(Int, List[(Int, Int)])] = List.with_capacity(nsplit)
    for _ in 0..nsplit {
      let k = r.u32()
      let na = r.u32()
      var atoms: List[(Int, Int)] = List.with_capacity(na)
      for _ in 0..na {
        let a = r.u64()
        atoms.push((a, r.u32()))
      }
      sp.push((k, atoms))
    }
    v.splits.push(sp)
    let nfn = r.u32()
    var ufns: List[Int] = []
    for _ in 0..nfn {
      ufns.push(r.u32())
    }
    v.unit_fns.push(ufns)
    for _ in 0..ns {
      v.edge_at.push(r.at)
      r.at += 4 + 4 * rd32(store, r.at)
    }
  }
  if v.edge_at.len() != total {
    return Err("a damaged xo std store")
  }
  Ok(v)
}

/// The store atom of the global definition named name, -1 for none.
pub fn (v: StoreView) def(name: Bytes) -> Int {
  store_def(v.b, v.data0, v.dt, v.ndefs, name)
}

/// The atoms reachable from roots and from the sections never_strip
/// says nothing may strip (seg, name, flags), by the edges.
pub fn (v: StoreView) walk(roots: List[Int], never_strip: fn(Str, Str, Int) -> Bool) -> List[Bool] {
  var live: List[Bool] = List.with_capacity(v.total)
  for _ in 0..v.total {
    live.push(false)
  }
  var work: List[Int] = []
  for id in roots {
    if id >= 0 && !live[id] {
      live[id] = true
      work.push(id)
    }
  }
  for i in 0..v.n {
    for k in 0..v.nsects[i] {
      let q = v.recs[i] + STORE_REC * k
      let (sg, nm) = v.names[rec_name(v.b, q)]
      if never_strip(sg, nm, rec_flags(v.b, q)) && !live[v.base[i] + k] {
        live[v.base[i] + k] = true
        work.push(v.base[i] + k)
      }
    }
  }
  while let Some(id) = work.pop() {
    let e = v.edge_at[id]
    for j in 0..rd32(v.b, e) {
      let t = rd32(v.b, e + 4 + 4 * j)
      if !live[t] {
        live[t] = true
        work.push(t)
      }
    }
  }
  live
}

/// Per object: whether its xo unit describes only dead functions (its
/// DWARF goes: dwtrim.xo dw_droppable).
pub fn (v: StoreView) dw_dropped(live: List[Bool]) -> List[Bool] {
  var out: List[Bool] = []
  for fs in v.unit_fns {
    out.push(!fs.is_empty() && !fs.any(fn(id: Int) -> Bool { live[id] }))
  }
  out
}

/// A cut DWARF section (its record at q; loclists: __debug_loclists):
/// its bytes, the runs of live functions and the others with the unit
/// length (and the lists' offsets) patched, and each kept relocation
/// record's place in the store with its new address.
pub fn (v: StoreView) cut(q: Int, live: List[Bool], loclists: Bool) -> (Bytes, List[(Int, Int)]) {
  let store = v.b
  let ns = rec_nseg(store, q)
  let ga = v.data0 + rec_seg_at(store, q)
  var segs: List[DwSeg] = List.with_capacity(ns)
  for i in 0..ns {
    let g = ga + STORE_RUN * i
    let gf = rd32(store, g + 8)
    var refs: List[(Int, Int)] = []
    let ra = v.data0 + rd32(store, g + 20)
    for j in 0..rd32(store, g + 24) {
      refs.push((rd32(store, ra + 8 * j), rd32(store, ra + 8 * j + 4)))
    }
    // a function's run: its store atom in fo (dw_keep asks live)
    segs.push(DwSeg{start: rd32(store, g), end: rd32(store, g + 4), fo: if gf < 0xfffffffe { gf } else { -1 }, typ: gf == 0xfffffffe, refs: refs})
  }
  let keep = dw_keep(segs, fn(g: DwSeg) -> Bool { live[g.fo] })
  let (at, n) = dw_new_starts(segs, keep)
  var b = BytesBuilder.with_capacity(n)
  let da = v.data0 + rec_data_at(store, q)
  dw_write_runs(b, store, da, loclists, n, segs, keep, at)
  var rels: List[(Int, Int)] = []
  for (i, g) in segs.indexed() {
    if !keep[i] {
      continue
    }
    let gr = v.data0 + rd32(store, ga + STORE_RUN * i + 12)
    for j in 0..rd32(store, ga + STORE_RUN * i + 16) {
      let rq = gr + 12 * j
      rels.push((rq, rd32(store, rq) - g.start + at[i]))
    }
  }
  (b.freeze(), rels)
}

/// The kinds of a symbol for keep_syms (the adapter's reading of its
/// type): in a section, undefined, a debugger entry, or other (absolute).
pub enum SymKind {
  InSect
  Undef
  Stab
  Other
}

/// Object i's symbols as compacted (each one's new index, -1 dropped):
/// kept are those of kept sections (newk), those a kept relocation names
/// (named), a debugger entry, an absolute one, a dead atom's external
/// definition a kept relocation anywhere names (elsewhere: the names of
/// the undefined symbols named), and an undefined one only when named
/// or defined nowhere in the store (an import).
pub fn (v: StoreView) keep_syms(i: Int, newk: List[Int], named: List[Bool], elsewhere: Set[Bytes], kind: fn(Int) -> SymKind, external: fn(Int) -> Bool) -> List[Int] {
  let nsym = v.nsyms[i]
  var symnew: List[Int] = List.with_capacity(nsym)
  var kept = 0
  for j in 0..nsym {
    let q = v.syms_at[i] + STORE_SYM * j
    let typ = rd32(v.b, q + 8)
    let sect = rd32(v.b, q + 12)
    let na = v.data0 + rd32(v.b, q)
    let keep = named[j] || match kind(typ) {
      SymKind.Stab => true
      SymKind.Other => true
      SymKind.Undef => v.def(v.b[na..na + rd32(v.b, q + 4)]) < 0
      SymKind.InSect => sect < 1 || newk[sect - 1] >= 0 || (external(typ) && elsewhere.contains(v.b[na..na + rd32(v.b, q + 4)]))
    }
    if keep {
      symnew.push(kept)
      kept += 1
    } else {
      symnew.push(-1)
    }
  }
  symnew
}

/// Symbol j of object i: its name, type, section ordinal, desc, value.
pub fn (v: StoreView) sym(i: Int, j: Int) -> CoreSym {
  let q = v.syms_at[i] + STORE_SYM * j
  let na = v.data0 + rd32(v.b, q)
  CoreSym{name: v.b[na..na + rd32(v.b, q + 4)], typ: rd32(v.b, q + 8), sect: rd32(v.b, q + 12), desc: rd32(v.b, q + 16), value: rd64(v.b, q + 20)}
}
