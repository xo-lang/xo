// The ARM64 COFF writer (coffa64.xo, coffseh64.xo, decision 0569 stage 3)
// against the object Apple clang 21 (`clang --target=aarch64-pc-windows-msvc
// -c`) writes for the same text: a function with landing pad data
// (.seh_handler, .seh_handlerdata) and an epilog, a call, page relative
// data for an add and a load, a thread local through :secrel_hi12: and
// :secrel_lo12:, .rdata, .data with an address and .tls$, then a packed
// function with a branch resolved in place. scripts/coff-compare-arm64.sh
// checks every golden's windows/arm64 assembly the same way.

const A64_COFF_SAMPLE = r#"	.text
	.globl f
	.p2align 2
f:
.Lf_begin:
	.seh_proc f
	.seh_handler xo_x_personality, @unwind, @except
	stp x29, x30, [sp, #-32]!
	.seh_save_fplr_x 32
	str x19, [sp, #16]
	.seh_save_reg x19, 16
	mov x29, sp
	.seh_set_fp
	.seh_endprologue
.Lcs0:
	bl g
.Lcs1:
	adrp x0, msg
	add x0, x0, :lo12:msg
	adrp x1, tab
	ldr x1, [x1, :lo12:tab]
	adrp x10, _tls_index
	ldr w10, [x10, :lo12:_tls_index]
	add x0, x0, :secrel_hi12:xo_tlocal
	add x0, x0, :secrel_lo12:xo_tlocal
	.seh_startepilogue
	ldr x19, [sp, #16]
	.seh_save_reg x19, 16
	ldp x29, x30, [sp], #32
	.seh_save_fplr_x 32
	.seh_endepilogue
	ret
.Lpad:
	brk #1
	.seh_handlerdata
	.byte 255
	.byte 255
	.byte 1
	.uleb128 .Lcse-.Lcsb
.Lcsb:
	.uleb128 .Lcs0-.Lf_begin
	.uleb128 .Lcs1-.Lcs0
	.uleb128 .Lpad-.Lf_begin
	.byte 0
.Lcse:
	.text
	.seh_endproc
	.globl h
	.p2align 2
h:
	.seh_proc h
	stp x29, x30, [sp, #-16]!
	.seh_save_fplr_x 16
	mov x29, sp
	.seh_set_fp
	.seh_endprologue
	cbz x0, .Lh1
	bl f
.Lh1:
	.seh_startepilogue
	ldp x29, x30, [sp], #16
	.seh_save_fplr_x 16
	.seh_endepilogue
	ret
	.seh_endproc
	.section .rdata,"dr"
msg:
	.ascii "hi"
	.data
	.globl tab
	.p2align 3
tab:
	.quad f
	.section .tls$,"dw"
	.globl xo_tlocal
xo_tlocal:
	.quad 0
"#

const A64_COFF_SAMPLE_OBJ = ""

test "the ARM64 COFF sample assembles to clang's object" {
  match assemble_coff_arm64(A64_COFF_SAMPLE.bytes()) {
    Ok(o) => {
      let got = hex_of(o)
      var i = 0
      while i < got.len() && i < A64_COFF_SAMPLE_OBJ.len() && got[i..i + 1] == A64_COFF_SAMPLE_OBJ[i..i + 1] {
        i += 1
      }
      expect(i / 2) == A64_COFF_SAMPLE_OBJ.len() / 2
      expect(got.len()) == A64_COFF_SAMPLE_OBJ.len()
    }
    Err(e) => expect(e) == ""
  }
}

// DWARF sections as compiler/arm64 debug.xo writes them on windows/arm64:
// `.secrel32` offsets between .debug sections (SECREL) and the sections
// discardable, as clang 21 marks a .debug section whatever its flags.
const A64_COFF_DEBUG_SAMPLE = r#"	.text
	.globl g
	.p2align 2
g:
	ret
	.section .debug_abbrev,"dr"
.Labbrev:
	.byte 1
	.byte 0
	.section .debug_str,"dr"
.Lname:
	.asciz "g"
	.section .debug_info,"dr"
	.long 12
	.short 5
	.secrel32 .Labbrev
	.secrel32 .Lname
	.quad g
"#

const A64_COFF_DEBUG_SAMPLE_OBJ = ""

test "ARM64 COFF .debug sections and .secrel32 assemble to clang's object" {
  match assemble_coff_arm64(A64_COFF_DEBUG_SAMPLE.bytes()) {
    Ok(o) => expect(hex_of(o)) == A64_COFF_DEBUG_SAMPLE_OBJ
    Err(e) => expect(e) == ""
  }
}

test "ARM64 load scale: the access size of an unsigned offset load or store" {
  expect(a64_ldst_scale(0xf9400000)) == 3 // ldr x0, [x0]
  expect(a64_ldst_scale(0xb9400000)) == 2 // ldr w0, [x0]
  expect(a64_ldst_scale(0x39400000)) == 0 // ldrb w0, [x0]
  expect(a64_ldst_scale(0x3dc00000)) == 4 // ldr q0, [x0]
  expect(a64_is_add_imm(0x91000000)) == true // add x0, x0, #0
  expect(a64_is_add_imm(0xf9400000)) == false
}

// A function over 0xffffc bytes: its unwind data in two segments, as
// llvm-mc 23 writes them (ARM64FindSegmentsInFunction). The second
// segment's codes start with end_c (0xe5), and .pdata has an entry per
// segment, the second at the function plus 0xffffc. The epilog at the
// boundary moves wholly into the second segment.
fn big_a64_source() -> Bytes {
  let lim = 0xffffc / 4
  var b = BytesBuilder.with_capacity(8 * lim)
  b.write_str("\t.text\n\t.globl big2\n\t.p2align 2\nbig2:\n\t.seh_proc big2\n")
  b.write_str("\tstp x29, x30, [sp, #-32]!\n\t.seh_save_fplr_x 32\n\tstr x19, [sp, #16]\n\t.seh_save_reg x19, 16\n")
  b.write_str("\tmov x29, sp\n\t.seh_set_fp\n\t.seh_endprologue\n")
  let epi = "\t.seh_startepilogue\n\tldr x19, [sp, #16]\n\t.seh_save_reg x19, 16\n\tldp x29, x30, [sp], #32\n\t.seh_save_fplr_x 32\n\t.seh_endepilogue\n\tret\n"
  for _ in 0..(lim - 2) {
    b.write_str("\tnop\n")
  }
  b.write_str(epi)
  for _ in 0..(lim + 50 - (lim - 2) - 3) {
    b.write_str("\tnop\n")
  }
  b.write_str(epi)
  b.write_str("\t.seh_endproc\n")
  b.freeze()
}

test "a windows/arm64 function over 0xffffc bytes gets two unwind segments, as llvm-mc writes them" {
  match assemble_coff_arm64(big_a64_source()) {
    Ok(o) => {
      let got = hex_of(o)
      // .xdata: segment 1 (no epilog of its own but the one moved out),
      // then segment 2 with end_c and its two epilogs
      expect(got.contains("ffff0310e1d00283e4e3e3e3380080100100800035008000e5e1d00283e4e3e3")) == true
      // .pdata: big2+0 -> .xdata+0, big2+0xffffc -> .xdata+0xc
      expect(got.contains("0000000000000000fcff0f000c000000")) == true
    }
    Err(e) => expect(e) == ""
  }
}

test "a64_segments ends a segment before an epilog that would cross 0xffffc" {
  var w = A64Win{sect: 0, begin: 0, end: 3 * 0xffffc - 8}
  let epi = [A64Ins{op: U_END}, A64Ins{op: U_END}, A64Ins{op: U_END}]
  w.epis = [A64Epi{start: 400, ins: epi}, A64Epi{start: 0xffffc - 4, ins: epi}, A64Epi{start: 2 * 0xffffc + 8, ins: epi}]
  let s = a64_segments(w, w.end)
  expect(s.len()) == 3
  expect(s[0].len) == 0xffffc - 4
  expect(s[0].epis) == [0]
  expect(s[1].off) == 0xffffc - 4
  expect(s[1].epis) == [1]
  expect(s[2].off) == 2 * 0xffffc - 4
  expect(s[2].epis) == [2]
  expect(s[2].pro) == false
  expect(s[0].pro) == true
}

// Atoms mode (.subsections_via_symbols, std's store parts): a branch to
// another atom of the section is a relocation, since coff_split lays the
// atoms out anew; one inside its own atom stays resolved (2026-11-10: a
// resolved `bl` kept its old distance and windows/arm64 programs built
// against std's store branched into .rdata).
const A64_COFF_ATOMS_SAMPLE = r#"	.subsections_via_symbols
	.text
	.globl f
	.p2align 2
f:
	bl g
	cbz x0, .Lf_out
	b .Lg_mid
.Lf_out:
	ret
	.globl g
	.p2align 2
g:
	nop
.Lg_mid:
	ret
"#

test "an ARM64 COFF object in atoms mode relocates branches between atoms" {
  match assemble_coff_arm64(A64_COFF_ATOMS_SAMPLE.bytes()) {
    Ok(o) => match read_coff("atoms.obj", o) {
      Ok(ob) => {
        var text = -1
        for (i, s) in ob.sects.indexed() {
          if s.name == ".text" {
            text = i
          }
        }
        expect(text >= 0) == true
        // bl g at 0 and b .Lg_mid at 8 (another atom): relocated; the
        // cbz to .Lf_out at 4 (its own atom): resolved in place
        var at: List[Int] = []
        for r in ob.sects[text].relocs {
          at.push(r.addr)
        }
        expect(at.sort()) == [0, 8]
        let w = get_le(ob.sects[text].data, 4, 4) & 0xffffffff
        expect((w >> 5) & 0x7ffff) == 2
      }
      Err(e) => expect(e) == ""
    }
    Err(e) => expect(e) == ""
  }
}
