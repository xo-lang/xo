/// The words of form f, a numeric branch or jump target resolved as
/// llvm-mc resolves it (an offset from the instruction).
fn rv_form_words(f: Str) -> List[Int]? {
  let b = f.bytes()
  var k = 0
  while k < b.len() && !is_space(b[k]) {
    k += 1
  }
  let e = rv_encode(bstr(b[0..k]), split_operands(b[k..]))
  if !e.ok {
    return None
  }
  var ws = e.words
  if e.fx == FX_RV_B || e.fx == FX_RV_J {
    let d = parse_int(e.name) ?? 0
    ws[0] = ws[0] | (if e.fx == FX_RV_B { rv_b_imm(d) } else { rv_j_imm(d) })
  }
  Some(ws)
}

test "every riscv64 form encodes as llvm-mc encodes it" {
  var bad: List[Str] = []
  for (f, want) in RV64_FORMS {
    match rv_form_words(f) {
      Some(ws) => if ws != want {
        bad.push("${f}: ${ws} want ${want}")
      }
      None => bad.push("${f}: not encoded")
    }
  }
  expect(bad) == []
}
