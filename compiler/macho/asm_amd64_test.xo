fn hex_of(b: Bytes) -> Str {
  var l: List[Int] = []
  for v in b {
    l.push(Int(v))
  }
  hex_bytes(l)
}

test "each amd64 test file assembles to clang's ELF object" {
  var bad: List[Str] = []
  for (name, src, want) in AMD64_OBJECTS {
    match assemble_elf_amd64_raw(src.bytes()) {
      Ok(o) => {
        let got = hex_of(o)
        if got != want {
          // the first differing byte
          var i = 0
          while i < got.len() && i < want.len() && got[i..i + 1] == want[i..i + 1] {
            i += 1
          }
          bad.push("${name}: differs at byte ${i / 2} (${got.len() / 2} bytes, want ${want.len() / 2})")
        }
      }
      Err(e) => bad.push("${name}: ${e}")
    }
  }
  expect(bad) == []
}

test "an x86-64 static link: EM_X86_64, weak hooks a nop and a ret, GOT and initial exec TLS relaxed" {
  // decision 0254 stage 4: the program's own _start; __hook_a called and
  // __hook_b tail called, both weak and undefined; a GOT load of helper;
  // an initial exec load of tv relaxed to local exec
  let src = "\t.text\n\t.globl _start\n\t.type _start,@function\n_start:\n\tcallq helper\n\tcallq __hook_a\n\tmovq helper@GOTPCREL(%rip), %rax\n\tmovq tv@GOTTPOFF(%rip), %r9\n\tjmp __hook_b\n\t.type helper,@function\nhelper:\n\tretq\n\t.weak __hook_a\n\t.weak __hook_b\n\t.section .tdata,\"awT\",@progbits\n\t.p2align 3\ntv:\n\t.quad 7\n"
  let obj = assemble_elf_amd64(src.bytes()).or_fault("assemble")
  let exe = match link_elf([LinkInput{path: "s.o", data: obj}], ElfLinkOpts{static: true}) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  expect(rd16(exe, 18)) == 62
  let off = rd64(exe, 24) - ELF_BASE
  // callq helper: e8 to helper, past 5 + 7 + 7 + 5 bytes (the jmp to an
  // undefined symbol is the rel32 form)
  expect(Int(exe[off])) == 0xe8
  expect(rd32(exe, off + 1)) == 24
  // callq __hook_a: a 5 byte nop
  expect(Int(exe[off + 5])) == 0x0f
  expect(Int(exe[off + 6])) == 0x1f
  // movq tv@GOTTPOFF(%rip), %r9 -> movq $-8, %r9 (49 c7 c1 f8 ff ff ff)
  expect(Int(exe[off + 17])) == 0x49
  expect(Int(exe[off + 18])) == 0xc7
  expect(Int(exe[off + 19])) == 0xc1
  expect(rd32(exe, off + 20)) == 0xfffffff8
  // jmp __hook_b: a ret
  expect(Int(exe[off + 24])) == 0xc3
}

test "the amd64 emitter's forms: leave, cvttsd2siq, a jump table in .text, one STT_FILE per .file" {
  // xo-fa's first emitter text (2026-10-17): its jump tables are .long
  // label differences in the code; each `.file` is its own STT_FILE
  // symbol before the locals after it, as LLVM's
  let src = "\t.file \"prog.s\"\n\t.text\n.La:\n\tleave\n\tcvttsd2siq %xmm9, %r10\n\t.p2align 2\n.Ljt:\n\t.long .Lb-.Ljt\n.Lb:\n\tretq\n\t.file \"prog.s\"\nloc:\n\tretq\n"
  let obj = assemble_elf_amd64(src.bytes()).or_fault("assemble")
  // leave, cvttsd2siq (f2 4d 0f 2c d1), a 2 byte nop pad to 8, the table entry 4
  expect(has_bytes(obj, [0xc9, 0xf2, 0x4d, 0x0f, 0x2c, 0xd1, 0x66, 0x90, 0x04, 0x00, 0x00, 0x00, 0xc3])) == true
}

fn has_bytes(b: Bytes, want: List[Int]) -> Bool {
  if b.len() < want.len() {
    return false
  }
  for i in 0..b.len() - want.len() + 1 {
    var ok = true
    for (k, w) in want.indexed() {
      if Int(b[i + k]) != w {
        ok = false
        break
      }
    }
    if ok {
      return true
    }
  }
  false
}

test "an x86-64 glibc link: crt1 _start, PLT stubs through GOT slots, GLIBC_2.2.5 and later versions" {
  // decision 0254 stage 4: main calls puts (a stub) and reads stdout
  // through the GOT; the loader and versions are x86-64's
  let src = "\t.text\n\t.globl main\n\t.type main,@function\nmain:\n\tpushq %rax\n\tmovq stdout@GOTPCREL(%rip), %rax\n\tcallq puts@PLT\n\tcallq memcpy@PLT\n\txorl %eax, %eax\n\tpopq %rcx\n\tretq\n"
  let obj = assemble_elf_amd64(src.bytes()).or_fault("assemble")
  let exe = match link_elf([LinkInput{path: "m.o", data: obj}], ElfLinkOpts{}) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  expect(rd16(exe, 18)) == 62
  expect(has(exe, "/lib64/ld-linux-x86-64.so.2")) == true
  expect(has(exe, "GLIBC_2.2.5")) == true
  // memcpy's x86-64 default version
  expect(has(exe, "GLIBC_2.14")) == true
  expect(has(exe, "__libc_start_main")) == true
  // _start: xorl %ebp, %ebp; movq %rdx, %r9 (the entry's file offset
  // through its PT_LOAD)
  let entry = rd64(exe, 24)
  var off = -1
  for k in 0..rd16(exe, 56) {
    let ph = 64 + 56 * k
    let va = rd64(exe, ph + 16)
    if rd32(exe, ph) == PT_LOAD && entry >= va && entry < va + rd64(exe, ph + 32) {
      off = rd64(exe, ph + 8) + entry - va
    }
  }
  expect(Int(exe[off])) == 0x31
  expect(Int(exe[off + 1])) == 0xed
  expect(Int(exe[off + 2])) == 0x49
  // stat wraps __xstat with version 1
  expect(nonshared("stat", true)) == Some("\t.globl stat\n\t.type stat,@function\nstat:\n\tmovq %rsi, %rdx\n\tmovq %rdi, %rsi\n\tmovl $1, %edi\n\tjmp __xstat\n")
}
