// Dead stripping by atom (decision 0388 stage 4, std's indexed store): an
// object made with `.subsections_via_symbols` (MH_SUBSECTIONS_VIA_SYMBOLS)
// splits into atoms at its symbols, as ld64 splits one, and the link keeps
// only the atoms the entry and the other objects reach through
// relocations. A compact unwind entry or an FDE stays with its function's
// atom and roots the function's LSDA; a CIE always stays. An object
// without the flag is kept whole, as before, and roots what it names.

/// S_ATTR_NO_DEAD_STRIP: a section kept whatever reaches it.
const S_ATTR_NO_DEAD_STRIP = 0x10000000

/// The ordinal of the atom of split section ordinal (of object o) that
/// holds address a; ordinal itself when the section was not split.
fn atom_ordinal(o: IObj, ordinal: Int, a: Int) -> Int {
  match o.split.get(ordinal) {
    Some(l) => {
      var lo = 0
      var hi = l.len()
      while lo < hi {
        let m = (lo + hi) / 2
        if l[m].0 <= a {
          lo = m + 1
        } else {
          hi = m
        }
      }
      if lo == 0 { l[0].1 } else { l[lo - 1].1 }
    }
    None => ordinal
  }
}

/// Whether a section is never split: the linker's own (__LD), DWARF, and
/// sections with no symbols to split at (literals).
fn whole_sect(s: ISect) -> Bool {
  s.seg == "__LD" || s.seg == "__DWARF" || (s.flags & S_ATTR_DEBUG_FLAG) != 0 || is_eh(s)
}

/// __eh_frame: never split and never walked (its FDEs name every
/// function); after the walk eh_live writes it again without the dead
/// functions' FDEs (arm64; an x86_64 object's stays whole, and there a
/// dead function's FDE points to 0, which __unwind_info never names).
fn is_eh(s: ISect) -> Bool {
  s.seg == "__TEXT" && s.name == "__eh_frame"
}

/// Splits each splittable section of object o into atoms at its defined
/// symbols (and at its start); __eh_frame into its CIE and FDE records.
fn (var l: Linker) atomize(o: Int) {
  let ob = l.objs[o]
  var by_sect: List[List[Int]] = []
  for _ in ob.sects {
    by_sect.push([])
  }
  for s in ob.syms {
    if (s.typ & N_STAB) == 0 && (s.typ & N_TYPE) == 0x0e && s.sect >= 1 && s.sect <= ob.sects.len() {
      by_sect[s.sect - 1].push(s.value)
    }
  }
  var sects: List[ISect] = []
  var split: Map[Int, List[(Int, Int)]] = {}
  for (k, s) in ob.sects.indexed() {
    var starts: List[Int] = []
    if !whole_sect(s) {
      starts.push(s.addr)
      for v in by_sect[k].sort() {
        if v > s.addr && v < s.addr + s.size && v != starts[starts.len() - 1] {
          starts.push(v)
        }
      }
    }
    if starts.len() <= 1 {
      sects.push(s)
      split[k + 1] = [(s.addr, sects.len())]
      continue
    }
    var atoms: List[(Int, Int)] = []
    for (i, a) in starts.indexed() {
      let e = if i + 1 < starts.len() { starts[i + 1] } else { s.addr + s.size }
      var t = ISect{seg: s.seg, name: s.name, addr: a, size: e - a, align: s.align, flags: s.flags, data: if s.data.is_empty() { s.data } else { s.data[a - s.addr..e - s.addr] }}
      for r in s.relocs {
        let at = r.addr + s.addr
        if at >= a && at < e {
          var r2 = r
          r2.addr = at - a
          t.relocs.push(r2)
        }
      }
      sects.push(t)
      atoms.push((a, sects.len()))
    }
    split[k + 1] = atoms
  }
  // each defined symbol moves to the atom holding it
  var syms = ob.syms
  for i in 0..syms.len() {
    let s = syms[i]
    if (s.typ & N_STAB) == 0 && (s.typ & N_TYPE) == 0x0e && s.sect >= 1 {
      syms[i].sect = atom_ordinal(IObj{path: "", split: split}, s.sect, s.value)
    }
  }
  l.objs[o].sects = sects
  l.objs[o].syms = syms
  l.objs[o].split = split
}

/// The start addresses of __eh_frame's records (a CIE or an FDE each).
fn eh_records(s: ISect) -> List[Int] {
  var out: List[Int] = []
  var off = 0
  while off + 4 <= s.data.len() {
    let len = rd32(s.data, off)
    if len == 0 || len == 0xffffffff {
      break
    }
    out.push(s.addr + off)
    off += 4 + len
  }
  out
}

/// The (object, section) a relocation of object o reaches, (-1, -1) for an
/// import or an absolute symbol.
fn (l: Linker) reloc_sect(o: Int, s: ISect, r: IReloc) -> (Int, Int) {
  if r.typ == R_ADDEND {
    return (-1, -1)
  }
  if r.ext {
    let (d, i) = l.def_of(o, r.sym)
    if d < 0 {
      return (-1, -1)
    }
    let t = l.objs[d].syms[i]
    if (t.typ & N_TYPE) != 0x0e || t.sect < 1 {
      return (-1, -1)
    }
    return (d, t.sect - 1)
  }
  // a section relative reference: the atom of the address the content
  // holds (a pointer), else every atom of that section
  let ord = r.sym
  if l.objs[o].split.contains(ord) {
    if r.typ == R_UNSIGNED && r.len == 3 {
      return (o, atom_ordinal(l.objs[o], ord, rd64(s.data, r.addr)) - 1)
    }
    return (o, -1 - ord)
  }
  (o, ord - 1)
}

/// What each function atom's FDE, compact unwind entry and unsafe range
/// record name besides the function (its LSDA, its personality, its
/// table): live with the function. Keyed by the function's (object,
/// section).
fn (l: Linker) unwind_refs() -> Map[(Int, Int), List[(Int, Int)]] {
  var unw: Map[(Int, Int), List[(Int, Int)]] = {}
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for (k, s) in l.objs[o].sects.indexed() {
      if is_eh(s) && l.objs[o].x86 {
        // x86_64: an FDE points at its function and LSDA pc relative,
        // with no relocation (link.xo x86_eh_frame), so its references
        // are read from the pointers; without them every LSDA atom was
        // dead and no fault was caught (darwin/amd64 atoms, 2026-10-28)
        var cies: Map[Int, (Int, Int)] = {}
        for rec in eh_records(s) {
          let at = rec - s.addr
          if s.data.len() < at + 8 {
            continue
          }
          let id = rd32(s.data, at + 4)
          if id == 0 {
            cies.put(at, cie_encodings(s.data, at + 8))
            continue
          }
          let (fenc, lenc) = cies.get(at + 4 - id) ?? (0x10, -1)
          let fn_t = l.x86_eh_atom(o, s, at + 8, fenc)
          var other: List[(Int, Int)] = []
          if lenc >= 0 {
            let t = l.x86_eh_atom(o, s, skip_leb(s.data, at + 8 + 2 * enc_size(fenc)), lenc)
            if t.0 >= 0 {
              other.push(t)
            }
          }
          var e = unw.get(fn_t) ?? []
          unw[fn_t] = e + other
        }
      } else if is_eh(s) {
        for rec in eh_records(s) {
          let at = rec - s.addr
          if s.data.len() < at + 8 || rd32(s.data, at + 4) == 0 {
            continue
          }
          var fn_t = (-1, -1)
          var other: List[(Int, Int)] = []
          for r in s.relocs {
            if r.addr >= at + 8 && r.addr < at + 4 + rd32(s.data, at) + 4 && r.typ != R_SUBTRACTOR {
              if r.addr == at + 8 {
                fn_t = l.reloc_sect(o, s, r)
              } else {
                other.push(l.reloc_sect(o, s, r))
              }
            }
          }
          var e = unw.get(fn_t) ?? []
          unw[fn_t] = e + other
        }
      } else if s.name == "xounsafe" && l.objs[o].subsections {
        // a function's unsafe range index record (decision 0388): live
        // with the function its first word names, with its table
        var fn_t = (-1, -1)
        var other: List[(Int, Int)] = [(o, k)]
        for r in s.relocs {
          if r.addr == 0 {
            fn_t = l.reloc_sect(o, s, r)
          } else {
            other.push(l.reloc_sect(o, s, r))
          }
        }
        var e = unw.get(fn_t) ?? []
        unw[fn_t] = e + other
      } else if s.seg == "__LD" && s.name == "__compact_unwind" {
        var by_entry: Map[Int, (Int, Int)] = {}
        for r in s.relocs {
          if r.addr % 32 == 0 {
            by_entry[r.addr] = l.reloc_sect(o, s, r)
          }
        }
        for r in s.relocs {
          if r.addr % 32 != 0 {
            let f2 = by_entry.get(r.addr / 32 * 32) ?? (-1, -1)
            var e = unw.get(f2) ?? []
            e.push(l.reloc_sect(o, s, r))
            unw[f2] = e
          }
        }
      }
    }
  }
  unw
}

/// The atom an x86_64 __eh_frame pointer at offset at (encoding enc,
/// pc relative, no relocation) points into, (-1, -1) for none or null.
fn (l: Linker) x86_eh_atom(o: Int, s: ISect, at: Int, enc: Int) -> (Int, Int) {
  if (enc & 0x70) != 0x10 {
    return (-1, -1)
  }
  for r in s.relocs {
    if r.addr == at {
      return (-1, -1)
    }
  }
  let size = enc_size(enc)
  if at + size > s.data.len() {
    return (-1, -1)
  }
  let v = if size == 8 { rd64(s.data, at) } else { sext32(rd32(s.data, at)) }
  if v == 0 {
    return (-1, -1)
  }
  let t = s.addr + at + v
  for (k, x) in l.objs[o].sects.indexed() {
    if t >= x.addr && t < x.addr + x.size && !is_eh(x) {
      return (o, k)
    }
  }
  (-1, -1)
}

/// dead_strip: atomizes the objects made with .subsections_via_symbols and
/// marks every atom no root reaches dead (place skips it).
fn (var l: Linker) dead_strip() {
  var any = false
  for o in 0..l.objs.len() {
    if l.objs[o].live && l.objs[o].subsections {
      l.atomize(o)
      any = true
    }
  }
  if !any {
    return
  }
  var live: List[List[Bool]] = []
  for ob in l.objs {
    var row: List[Bool] = []
    for _ in ob.sects {
      row.push(false)
    }
    live.push(row)
  }
  var work: List[(Int, Int)] = []
  let unw = l.unwind_refs()
  // the roots: every section of a whole object, the sections nothing may
  // strip, CIEs, and the entry's atom
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for (k, s) in l.objs[o].sects.indexed() {
      // DWARF and __eh_frame name every function: never walked
      if s.seg == "__LD" || s.seg == "__DWARF" || (s.flags & S_ATTR_DEBUG_FLAG) != 0 || is_eh(s) {
        continue
      }
      let keep = !l.objs[o].subsections || (s.flags & S_ATTR_NO_DEAD_STRIP) != 0 || (s.flags & 0xff) == S_MOD_INIT_FUNC_POINTERS
      if keep {
        live[o][k] = true
        work.push((o, k))
      }
    }
  }
  if let Some((eo, ei)) = l.globals.get(l.opts.entry.bytes()) {
    let es = l.objs[eo].syms[ei]
    if es.sect >= 1 && !live[eo][es.sect - 1] {
      live[eo][es.sect - 1] = true
      work.push((eo, es.sect - 1))
    }
  }
  while let Some((o, k)) = work.pop() {
    let s = l.objs[o].sects[k]
    var refs: List[(Int, Int)] = []
    for r in s.relocs {
      refs.push(l.reloc_sect(o, s, r))
    }
    // what the function's FDE and unwind entry name (LSDA, personality)
    for t in unw.get((o, k)) ?? [] {
      refs.push(t)
    }
    for (d, j) in refs {
      if d < 0 {
        continue
      }
      if j < 0 {
        // every atom of a split section, for a reference by section
        let ord = -1 - j
        for (_, n) in l.objs[d].split.get(ord) ?? [] {
          if !live[d][n - 1] {
            live[d][n - 1] = true
            work.push((d, n - 1))
          }
        }
        continue
      }
      if !live[d][j] {
        live[d][j] = true
        work.push((d, j))
      }
    }
  }
  // the dead atoms, the compact unwind entries of dead functions, and
  // their subprograms and line sequences (dwtrim.xo)
  for o in 0..l.objs.len() {
    if !l.objs[o].live || !l.objs[o].subsections {
      continue
    }
    let segs = l.dw_all_segs(o)
    if l.dw_drop(o, segs, live) {
      // its unit describes only dead functions: no DWARF at all
      for k in 0..l.objs[o].sects.len() {
        if l.objs[o].sects[k].seg == "__DWARF" {
          l.objs[o].sects[k].data = "".bytes()
          l.objs[o].sects[k].size = 0
          l.objs[o].sects[k].relocs = []
        }
      }
    } else {
      for (k, g) in segs {
        l.objs[o].sects[k] = dw_cut(l.objs[o].sects[k], g, live)
      }
    }
    for k in 0..l.objs[o].sects.len() {
      let s = l.objs[o].sects[k]
      if s.seg == "__LD" && s.name == "__compact_unwind" {
        l.objs[o].sects[k] = l.live_unwind(o, s, live)
      } else if is_eh(s) && !l.x86 {
        l.objs[o].sects[k] = l.eh_live(o, s, live)
      } else if !live[o][k] && !whole_sect(s) {
        l.objs[o].sects[k].dead = true
      }
    }
  }
  // the imports again, from what the kept atoms name
  l.stripped = true
  l.collect_imports()
}

/// Object o's __eh_frame without the FDEs of dead functions (decision
/// 0388: a store link's std kept about 3300 of them, pointing at 0, and
/// __eh_frame was 4 times a whole program's). An FDE whose pc begin names
/// a function's own symbol (no offset into it) goes with that function's
/// atom; the records after it move back, so each moved field's addend
/// (an offset from the section's start, cfi.xo: the SUBTRACTOR's ltmp)
/// and each FDE's CIE pointer are written again. Left whole when a symbol
/// other than the start's is in it (the assembler makes none).
fn (l: Linker) eh_live(o: Int, s: ISect, live: List[List[Bool]]) -> ISect {
  let d = s.data
  var recs: List[Int] = []
  for a in eh_records(s) {
    recs.push(a - s.addr)
  }
  if recs.is_empty() {
    return s
  }
  // the SUBTRACTOR pairs' fields, and every subtrahend at the section's
  // start: otherwise the section is left whole
  var sub_at: Set[Int] = #{}
  for r in s.relocs {
    if r.typ == R_SUBTRACTOR {
      if !r.ext || r.len != 3 {
        return s
      }
      let y = l.objs[o].syms[r.sym]
      if y.sect < 1 || y.value != s.addr || l.objs[o].sects[y.sect - 1].name != s.name {
        return s
      }
      sub_at.add(r.addr)
    }
  }
  for y in l.objs[o].syms {
    if (y.typ & N_STAB) == 0 && (y.typ & N_TYPE) == 0x0e && y.sect >= 1 && y.sect <= l.objs[o].sects.len() && is_eh(l.objs[o].sects[y.sect - 1]) && y.value != s.addr {
      return s
    }
  }
  // each FDE's function pointer's relocation, found by its place once
  // (a scan of every relocation per record was most of eh_live: about
  // 1.5 ms of an HTTP store link, 2026-10-29); the last at a place wins,
  // as the scan's did
  var fn_rel: Map[Int, IReloc] = {}
  for r in s.relocs {
    if r.typ == R_UNSIGNED && r.ext {
      fn_rel[r.addr] = r
    }
  }
  var keep: List[Bool] = []
  var dropped = false
  for rec in recs {
    var k = true
    if rec + 16 <= d.len() && rd32(d, rec + 4) != 0 {
      if let Some(r) = fn_rel.get(rec + 8) {
        if sub_at.contains(rec + 8) && rd64(d, rec + 8) + rec + 8 == 0 {
          // the function's own atom in this object (an FDE describes
          // this object's code; the name may resolve to another
          // object's copy of a weak definition)
          let y = l.objs[o].syms[r.sym]
          let (t, j) = if (y.typ & N_TYPE) == 0x0e && y.sect >= 1 { (o, y.sect - 1) } else { l.reloc_sect(o, s, r) }
          k = t < 0 || j < 0 || live[t][j]
        }
      }
    }
    keep.push(k)
    dropped = dropped || !k
  }
  if !dropped {
    return s
  }
  // each record's new place
  var at: Map[Int, Int] = {}
  var n = 0
  var last_kept = -1
  for (i, rec) in recs.indexed() {
    at[rec] = n
    if keep[i] {
      n += 4 + rd32(d, rec)
      last_kept = i
    }
  }
  // the records' bytes stay a multiple of the section's alignment: the
  // link pads between objects' sections with zeros, which a reader takes
  // for the terminator (every later FDE was lost); the last kept record
  // grows by DW_CFA_nop bytes (0) instead
  let unit = 1 << s.align
  let pad = (unit - n % unit) % unit
  let last = recs[recs.len() - 1]
  let tail = last + 4 + rd32(d, last)
  // the record holding an offset (by binary search of the starts), -1 past the last
  let rec_of = fn(off: Int) -> Int {
    if off >= tail {
      return -1
    }
    var lo = 0
    var hi = recs.len()
    while lo < hi {
      let m = (lo + hi) / 2
      if recs[m] <= off {
        lo = m + 1
      } else {
        hi = m
      }
    }
    if lo > 0 { lo - 1 } else { -1 }
  }
  var b = BytesBuilder.with_capacity(n + d.len() - tail)
  for (i, rec) in recs.indexed() {
    if !keep[i] {
      continue
    }
    let len = 4 + rd32(d, rec)
    let na = at.get(rec) ?? 0
    let shift = na - rec
    var body = d[rec..rec + len]
    let grow = if i == last_kept { pad } else { 0 }
    if rd32(d, rec + 4) != 0 {
      // the CIE pointer: from this field back to its CIE
      let cie = rec + 4 - rd32(d, rec + 4)
      var cb = BytesBuilder.with_capacity(len)
      cb.write(d[rec..rec + 4])
      sw32(cb, na + 4 - (at.get(cie) ?? 0))
      cb.write(d[rec + 8..rec + len])
      body = cb.freeze()
    }
    if shift != 0 {
      // the fields that subtract the section's start: their addend is
      // minus their own offset
      var fb = BytesBuilder.with_capacity(len)
      var pos = 0
      for f in sub_at.to_list().sort() {
        if f >= rec && f + 8 <= rec + len {
          fb.write(body[pos..f - rec])
          sw64(fb, rd64(body, f - rec) - shift)
          pos = f - rec + 8
        }
      }
      fb.write(body[pos..len])
      body = fb.freeze()
    }
    if grow > 0 {
      var gb = BytesBuilder.with_capacity(len + grow)
      sw32(gb, len - 4 + grow)
      gb.write(body[4..len])
      for _ in 0..grow {
        gb.write_byte(0)
      }
      body = gb.freeze()
    }
    b.write(body)
  }
  // the terminator and anything after the records, as they were
  b.write(d[tail..d.len()])
  var out = s
  out.data = b.freeze()
  out.size = out.data.len() + (s.size - d.len())
  out.relocs = []
  for r in s.relocs {
    let i = rec_of(r.addr)
    if i < 0 {
      var r2 = r
      r2.addr = r.addr - (tail - n - pad)
      out.relocs.push(r2)
    } else if keep[i] {
      var r2 = r
      r2.addr = r.addr + ((at.get(recs[i]) ?? 0) - recs[i])
      out.relocs.push(r2)
    }
  }
  out
}

/// A compact unwind section with only the entries of live functions.
fn (l: Linker) live_unwind(o: Int, s: ISect, live: List[List[Bool]]) -> ISect {
  var keep: List[Int] = []
  for r in s.relocs {
    if r.addr % 32 == 0 {
      let (d, j) = l.reloc_sect(o, s, r)
      if d >= 0 && j >= 0 && live[d][j] {
        keep.push(r.addr)
      }
    }
  }
  var out = s
  var b = BytesBuilder.new()
  out.relocs = []
  for (n, at) in keep.indexed() {
    b.write(s.data[at..at + 32])
    for r in s.relocs {
      if r.addr >= at && r.addr < at + 32 {
        var r2 = r
        r2.addr = r.addr - at + 32 * n
        out.relocs.push(r2)
      }
    }
  }
  out.data = b.freeze()
  out.size = 32 * keep.len()
  out
}
