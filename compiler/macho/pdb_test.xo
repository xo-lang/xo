// Tests of the PDB writer (pdb.xo, decision 0344). llvm-pdbutil reads
// what it writes (dump --all, lookups by name through the GSI hash) and
// llvm-symbolizer names a program's functions from the PDB alone; these
// check the container and the orders the readers rely on.

use github.com/xo-lang/xo/compiler/debug

/// The streams of an MSF file, read back: the superblock's block size and
/// directory, each stream's blocks.
fn msf_read(f: Bytes) -> List[Bytes] {
  let bs = le_b(f, 32, 4)
  let dir_size = le_b(f, 44, 4)
  let map = le_b(f, 52, 4)
  var dir = BytesBuilder.new()
  for k in 0..(dir_size + bs - 1) / bs {
    let blk = le_b(f, map * bs + 4 * k, 4)
    dir.write(f[blk * bs..blk * bs + bs])
  }
  let d = dir.freeze()
  let n = le_b(d, 0, 4)
  var at = 4 + 4 * n
  var out: List[Bytes] = []
  for i in 0..n {
    let size = le_b(d, 4 + 4 * i, 4)
    var s = BytesBuilder.new()
    for k in 0..(size + bs - 1) / bs {
      let blk = le_b(d, at, 4)
      at += 4
      let e = if size - k * bs < bs { size - k * bs } else { bs }
      s.write(f[blk * bs..blk * bs + e])
    }
    out.push(s.freeze())
  }
  out
}

test "the MSF container holds each stream, past a block and empty ones" {
  var big = BytesBuilder.new()
  for i in 0..10000 {
    big.write_byte(UInt8(i % 251))
  }
  let streams = [b"", b"abc", big.freeze(), b""]
  let f = msf(streams)
  expect(f.len() % PDB_BLOCK) == 0
  expect(f[0..24].to_str() ?? "") == "Microsoft C/C++ MSF 7.00"
  let got = msf_read(f)
  expect(got.len()) == 4
  for i in 0..4 {
    expect(got[i] == streams[i]) == true
  }
}

test "no stream block lands on a free block map's" {
  expect(free_from(1)) == 3
  expect(free_from(4097)) == 4099
  expect(free_from(5)) == 5
}

test "a GSI bucket's records are in gsi_less order" {
  expect(gsi_less("ab", "abc")) == true
  expect(gsi_less("ABD", "abc")) == false
  expect(gsi_less("abc", "ABD")) == true
  expect(gsi_less("a", "a")) == false
}

test "the PDB string hash is case insensitive in its low bits" {
  // hashStringV1 ORs 0x20 into every byte of the folded word, so names
  // differing only in ASCII case land in the same bucket
  expect(hash_v1("Poke") % 4096) == hash_v1("poke") % 4096
  expect(hash_v1("") >= 0) == true
}

test "a function's rows: its own file, inlined code at the call's line" {
  // files: 0 main.xo (home), 1 callee.xo; rows at 0x100 (a prologue row
  // in the callee's file, outside any call), 0x104 main:3, 0x108 and
  // 0x10c in an inlined call (called at main:4), 0x110 main:5
  let lns = debug.Lines{
    rows: [
      debug.Row{addr: 0x100, file: 1, line: 9, stmt: true, end: false},
      debug.Row{addr: 0x104, file: 0, line: 3, stmt: true, end: false},
      debug.Row{addr: 0x108, file: 1, line: 20, stmt: true, end: false},
      debug.Row{addr: 0x10c, file: 1, line: 21, stmt: true, end: false},
      debug.Row{addr: 0x110, file: 0, line: 5, stmt: true, end: false},
      debug.Row{addr: 0x120, file: 0, line: 5, stmt: false, end: true},
    ],
    files: ["main.xo", "callee.xo"],
  }
  var keyed: List[(Int, Int)] = []
  for (i, r) in lns.rows.indexed() {
    if !r.end {
      keyed.push((r.addr, i))
    }
  }
  let rows = fn_rows(lns, keyed.sort(), 0x100, 0x120, [([(0x108, 0x110)], 0, 4)])
  expect(rows) == [(4, 0, 3, true), (8, 0, 4, true), (0x10, 0, 5, true)]
}

test "the /names table finds each string by its hash" {
  let (t, at) = names_table(["a.xo", "b.xo", "c.xo"])
  // header 12, strings "\0a.xo\0b.xo\0c.xo\0" (16), buckets
  let nb = le_b(t, 12 + 16, 4)
  expect(nb) == 7
  for (i, s) in ["a.xo", "b.xo", "c.xo"].indexed() {
    var k = hash_v1(s) % nb
    while le_b(t, 32 + 4 * k, 4) != at[i] && le_b(t, 32 + 4 * k, 4) != 0 {
      k = (k + 1) % nb
    }
    expect(le_b(t, 32 + 4 * k, 4)) == at[i]
  }
  expect(le_b(t, 32 + 4 * nb, 4)) == 3
}

test "an inline site's annotations: offsets from the function, lines from its first" {
  // one range [0x110, 0x130) of a function at 0x100: entries at 0x110
  // (line 7, the inlinee's first) and 0x118 (line 8), file 0
  let st = PdbSite{name: "f", parent: -1, ranges: [(0x110, 0x130)], entries: [(0x110, 0, 7), (0x118, 0, 8)]}
  let a = annotations(0x100, st, ("f", 0, 7), {0: 0})
  // ChangeLineOffset 0 (the first entry's line), ChangeCodeOffset (3,
  // not ChangeCodeOffsetBase 2) 0x10, then a combined op (line +1 is 2
  // encoded, code +8), the range's length 0x18, zeros to 4 bytes
  expect(a) == b"\x06\x00\x03\x10\x0b\x28\x04\x18"
}

test "compressed annotation numbers" {
  var w = new_out(8)
  ba_op(w, 0x7f)
  ba_op(w, 0x80)
  ba_op(w, 0x4000)
  expect(w.done()) == b"\x7f\x80\x80\xc0\x00\x40\x00"
}

test "CodeView registers, primitives, numeric leaves and ranges" {
  // rax, rdx, rbp, r8, r15, xmm0, xmm8; an unknown register
  expect([cv_reg(0), cv_reg(1), cv_reg(6), cv_reg(8), cv_reg(15), cv_reg(17), cv_reg(25), cv_reg(99)]) == [328, 331, 334, 336, 343, 154, 252, 0]
  // Int, UInt8, Bool, Float64, Int32, a rune
  expect([primitive(5, 8), primitive(8, 1), primitive(2, 1), primitive(4, 8), primitive(5, 4), primitive(0x10, 4)]) == [0x76, 0x69, 0x30, 0x41, 0x74, 0x7b]
  var w = new_out(8)
  numeric(w, 0x7fff)
  numeric(w, 0x8000)
  expect(w.done()) == b"\xff\x7f\x04\x80\x00\x80\x00\x00"
  // a range past 0xffff bytes is split; outside the sections, none
  let sects = [PdbSect{rva: 0x1000, vsize: 0x30000, chars: 0, header: b""}]
  expect(cv_ranges(sects, 0x140000000, 0x140001010, 0x140021010)) == [(0x10, 1, 0xffff), (0x1000f, 1, 0xffff), (0x2000e, 1, 2)]
  expect(cv_ranges(sects, 0x140000000, 0x150000000, 0x150000010)) == []
}

test "a place's ranges merged, written with gaps, cut at 0xffff bytes" {
  expect(merge_spans([(10, 20), (20, 30), (40, 50), (45, 60), (5, 5)])) == [(10, 30), (40, 60)]
  let sects = [PdbSect{rva: 0x1000, vsize: 0x30000, chars: 0, header: b""}]
  let b = 0x140000000
  // two ranges with a hole: one record, one gap
  expect(cv_spans(sects, b, [(b + 0x1010, b + 0x1020), (b + 0x1030, b + 0x1040)])) == [(0x10, 1, 0x30, [(0x10, 0x10)])]
  // a range past 0xffff bytes: cut, the rest a record of its own
  expect(cv_spans(sects, b, [(b + 0x1000, b + 0x11000)])) == [(0, 1, 0xffff, []), (0xffff, 1, 1, [])]
}

test "a PDB std part's bytes read back as the same functions, files and types" {
  let ty = debug.Type{tag: 0x13, name: "S", size: 16, enc: 0, of: 0, members: [debug.Member{name: "a", ty: 40, offset: 8}]}
  let loc = PdbLocal{name: "x", ty: 40, param: true, defs: [(0x1141, b"\x01\x02")]}
  let site = PdbSite{name: "inl", parent: -1, ranges: [(0x1010, 0x1020)], entries: [(0x1010, 1, 7)], locals: [loc]}
  let p = PdbProc{name: "main.f", seg: 0, off: 0, size: 48, rows: [(0, 0, 3, true), (16, 1, 7, false)], lo: 0x1000, sites: [site], locals: [loc], sect_off: 32}
  var types: Map[Int, debug.Type] = {}
  types[40] = ty
  let pp = PreProcs{info: debug.Info{types: types}, tys: [40, 40], files: ["a.xo", "b.xo"], procs: [p]}
  let b = enc_pre_procs(pp)
  let back = match dec_pre_procs(b) {
    Some(x) => x
    None => fault("the std part does not decode")
  }
  expect(enc_pre_procs(back) == b) == true
  expect(back.files) == ["a.xo", "b.xo"]
  expect(back.tys) == [40, 40]
  expect(back.procs.len()) == 1
  expect(back.procs[0].size) == 48
  expect(back.procs[0].lo) == 0x1000
  expect(back.procs[0].sect_off) == 32
  expect(back.procs[0].sites[0].entries) == [(0x1010, 1, 7)]
  expect(back.info.types.get(40) is Some(_)) == true
  expect(dec_pre_procs(b[0..b.len() - 1]) is None) == true
}

test "a PDB writer's std part reads back" {
  var types = CvTypes{}
  let _i = add_type(types, 0x1503, b"\x01\x00\x00\x00", -1)
  types.of[40] = 0x1000
  types.fwd["S"] = 0x1000
  let std = PdbStd{names: ["std.f", "std.g"], types: types, files: ["a.xo"], fidx: [(0, 0)], inlinees: [("inl", 0, 7)], recs: b"\x01\x02\x03\x04", at: [16, 64], lines: b"\x05\x06\x07\x08"}
  let b = enc_pdb_std(std)
  let back = match dec_pdb_std(b) {
    Some(x) => x
    None => fault("the writer's std part does not decode")
  }
  expect(enc_pdb_std(back) == b) == true
  expect(back.names) == ["std.f", "std.g"]
  expect(back.inlinees) == [("inl", 0, 7)]
  expect(back.types.recs.len()) == 1
  expect(back.types.hashes) == types.hashes
  expect(back.types.of.get(40)) == Some(0x1000)
  expect(back.types.fwd.get("S")) == Some(0x1000)
  expect(back.at) == [16, 64]
  expect(back.recs == b"\x01\x02\x03\x04") == true
  expect(dec_pdb_std(b[0..b.len() - 2]) is None) == true
}
