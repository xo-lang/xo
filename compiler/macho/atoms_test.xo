// The assembler's atoms mode (`.subsections_via_symbols`, decision 0388's
// std store): a branch between two functions of one section is a
// relocation, so the linker may place them apart or drop one; without the
// directive it is patched in place, as before.

fn atoms_src(directive: Bool) -> Bytes {
  "${if directive { "\t.subsections_via_symbols\n" } else { "" }}\t.text\n\t.globl _f\n_f:\n\tbl _g\n\tb Lout\nLout:\n\tb _g\n\t.globl _g\n_g:\n\tret\n".bytes()
}

fn text_relocs(src: Bytes) -> (Int, Int) {
  let b = match assemble(src) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  let o = match parse_object("t.o", b) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  var n = 0
  for s in o.sects {
    if s.name == "__text" {
      for r in s.relocs {
        if r.typ == R_BRANCH26 {
          n += 1
        }
      }
    }
  }
  (n, rd32(b, 24))
}

test "atoms mode relocates a branch to another atom of the section" {
  let (n, flags) = text_relocs(atoms_src(true))
  // `bl _g` and `b _g`; `b Lout` stays in _f's atom, patched
  expect(n) == 2
  expect(flags & 0x2000) == 0x2000
}

test "without the directive a branch in its section is patched" {
  let (n, flags) = text_relocs(atoms_src(false))
  expect(n) == 0
  expect(flags & 0x2000) == 0
}

fn strip_link(directive: Bool) -> Bytes {
  let src = "${if directive { "\t.subsections_via_symbols\n" } else { "" }}\t.text\n\t.globl _main\n\t.p2align 2\n_main:\n\tbl _used\n\tmov x0, #0\n\tret\n\t.globl _used\n\t.p2align 2\n_used:\n\tret\n\t.globl _unused_fn\n\t.p2align 2\n_unused_fn:\n\tmov x0, #7\n\tmov x1, #8\n\tret\n".bytes()
  let ob = match assemble(src) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  match link([LinkInput{path: "s.o", data: ob}], LinkOpts{name: "s", embed_dwarf: false}) {
    Ok(x) => x
    Err(e) => fault(e)
  }
}

test "atoms mode: the link strips a function nothing reaches" {
  let kept = strip_link(false)
  let stripped = strip_link(true)
  // the unused function's name and its 12 bytes are gone
  expect(kept.find("_unused_fn".bytes()) != None) == true
  expect(stripped.find("_unused_fn".bytes()) == None) == true
  expect(stripped.find("_used".bytes()) != None) == true
}

fn asm_or_fault(src: Str) -> Bytes {
  match assemble(src.bytes()) {
    Ok(x) => x
    Err(e) => fault(e)
  }
}

test "a link through the store is the link of the store's objects" {
  // std's part: one function the program calls, one it reaches through
  // it, one nothing reaches; the program's object is kept whole
  let part = asm_or_fault("\t.subsections_via_symbols\n\t.text\n\t.globl _used\n\t.p2align 2\n_used:\n\tbl _inner\n\tret\n\t.globl _unused_fn\n\t.p2align 2\n_unused_fn:\n\tmov x0, #7\n\tret\n\t.globl _inner\n\t.p2align 2\n_inner:\n\tadrp x0, _tab@PAGE\n\tret\n\t.section __DATA,__data\n\t.globl _tab\n_tab:\n\t.quad _inner\n\t.globl _dead_tab\n_dead_tab:\n\t.quad _unused_fn\n")
  let prog = asm_or_fault("\t.text\n\t.globl _main\n\t.p2align 2\n_main:\n\tbl _used\n\tmov x0, #0\n\tret\n")
  let opts = LinkOpts{name: "s", embed_dwarf: false}
  let want = match link([LinkInput{path: "part.o", data: part}, LinkInput{path: "prog.o", data: prog}], opts) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  let store = match store_encode([LinkInput{path: "part.o", data: part}]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  let got = match link_store([LinkInput{path: "prog.o", data: prog}], store, opts) {
    Ok((x, _)) => x
    Err(e) => fault(e)
  }
  expect(got == want) == true
  // and the stripped function is gone from both
  expect(got.find("_unused_fn".bytes()) == None) == true
  expect(got.find("_dead_tab".bytes()) == None) == true
  expect(got.find("_inner".bytes()) != None) == true
}

test "a weak definition in two objects links once (std's object and a program's)" {
  let a = asm_or_fault("\t.text\n\t.globl _main\n\t.p2align 2\n_main:\n\tbl _xo_hshared\n\tmov x0, #0\n\tret\n\t.globl _xo_hshared\n\t.weak_definition _xo_hshared\n\t.p2align 2\n_xo_hshared:\n\tret\n")
  let b = asm_or_fault("\t.text\n\t.globl _xo_hshared\n\t.weak_definition _xo_hshared\n\t.p2align 2\n_xo_hshared:\n\tret\n")
  match link([LinkInput{path: "a.o", data: a}, LinkInput{path: "b.o", data: b}], LinkOpts{name: "w", embed_dwarf: false}) {
    Ok(_) => {}
    Err(e) => fault(e)
  }
  // two strong ones stay an error
  let c = asm_or_fault("\t.text\n\t.globl _xo_hshared\n\t.p2align 2\n_xo_hshared:\n\tret\n")
  let d = asm_or_fault("\t.text\n\t.globl _main\n\t.p2align 2\n_main:\n\tbl _xo_hshared\n\tret\n\t.globl _xo_hshared\n\t.p2align 2\n_xo_hshared:\n\tret\n")
  match link([LinkInput{path: "d.o", data: d}, LinkInput{path: "c.o", data: c}], LinkOpts{name: "w", embed_dwarf: false}) {
    Ok(_) => fault("two strong definitions linked")
    Err(e) => expect(e.contains("duplicate symbol _xo_hshared")) == true
  }
}

test "defined_symbols names an object's external definitions" {
  let a = asm_or_fault("\t.text\n\t.globl _f\n\t.p2align 2\n_f:\n\tbl _g\n\tret\nLlocal:\n\tret\n")
  match defined_symbols("a.o", a) {
    Ok(names) => expect(names) == ["_f"]
    Err(e) => fault(e)
  }
}
