// arm64 instruction encoding: the mnemonics and operand forms the arm64
// emitter writes, encoded as LLVM's assembler encodes them (aliases such
// as mov, cmp, cset, lsl resolved to the same instruction).

const NOP = 0xd503201f

/// Register kinds.
pub const RX = 0
pub const RW = 1
pub const RD = 2
pub const RS = 3
pub const RSP = 4
/// A 128 bit SIMD and floating point register (q0 to q31).
pub const RQ = 5

/// A register operand: its number (31 for xzr, wzr, sp) and kind; kind
/// -1 when the operand is not a register.
fn reg(b: Bytes) -> (Int, Int) {
  if b.len() < 2 {
    return (0, -1)
  }
  if b.len() == 2 && b[0] == 's' && b[1] == 'p' {
    return (31, RSP)
  }
  if b.len() == 3 && b[1] == 'z' && b[2] == 'r' {
    if b[0] == 'x' {
      return (31, RX)
    }
    if b[0] == 'w' {
      return (31, RW)
    }
    return (0, -1)
  }
  let k = match b[0] {
    'x' => RX
    'w' => RW
    'd' => RD
    's' => RS
    'q' => RQ
    _ => -1
  }
  if k < 0 {
    return (0, -1)
  }
  var n = 0
  for i in 1..b.len() {
    let c = b[i]
    if c < '0' || c > '9' {
      return (0, -1)
    }
    n = n * 10 + Int(c - '0')
  }
  if b.len() > 3 || n > 31 || (n == 31 && (k == RX || k == RW)) {
    return (0, -1)
  }
  (n, k)
}

/// The condition codes.
fn cond(b: Bytes) -> Int {
  match bstr(b) {
    "eq" => 0
    "ne" => 1
    "hs" | "cs" => 2
    "lo" | "cc" => 3
    "mi" => 4
    "pl" => 5
    "vs" => 6
    "vc" => 7
    "hi" => 8
    "ls" => 9
    "ge" => 10
    "lt" => 11
    "gt" => 12
    "le" => 13
    "al" => 14
    "nv" => 15
    _ => -1
  }
}

/// An immediate operand `#N`.
fn imm(b: Bytes) -> Int? {
  if b.len() < 2 || b[0] != '#' {
    return None
  }
  parse_int(b[1..])
}

/// A shift operand `lsl #N` (also lsr, asr): (kind 0 lsl, 1 lsr, 2 asr;
/// amount), or None.
fn shift_op(b: Bytes) -> (Int, Int)? {
  if b.len() < 5 {
    return None
  }
  let k = match bstr(b[0..3]) {
    "lsl" => 0
    "lsr" => 1
    "asr" => 2
    _ => -1
  }
  if k < 0 {
    return None
  }
  match imm(trim(b[3..])) {
    Some(n) => Some((k, n))
    None => None
  }
}

/// A label operand with an optional relocation operator: (name, op) with
/// op "" or "PAGE", "PAGEOFF" (ELF's `:lo12:` prefix is PAGEOFF).
fn label_op(b: Bytes) -> (Bytes, Str) {
  if b.len() > 6 && bstr(b[0..6]) == ":lo12:" {
    return (b[6..], "PAGEOFF")
  }
  // ELF's GOT slot of a symbol (decision 0232), as Mach-O's
  // @GOTPAGE and @GOTPAGEOFF
  if b.len() > 5 && bstr(b[0..5]) == ":got:" {
    return (b[5..], "GOTPAGE")
  }
  if b.len() > 10 && bstr(b[0..10]) == ":got_lo12:" {
    return (b[10..], "GOTPAGEOFF")
  }
  // ELF's local exec thread local offsets (decision 0212)
  if b.len() > 12 && bstr(b[0..12]) == ":tprel_hi12:" {
    return (b[12..], "TPREL_HI12")
  }
  if b.len() > 15 && bstr(b[0..15]) == ":tprel_lo12_nc:" {
    return (b[15..], "TPREL_LO12")
  }
  for i in 0..b.len() {
    if b[i] == '@' {
      return (b[0..i], bstr(b[i + 1..]))
    }
  }
  (b, "")
}

fn (var a: Asm) word(w: Int) {
  a.sects[a.cur].words.push(w)
}

/// A word with a label fixup.
fn (var a: Asm) word_fix(w: Int, kind: Int, name: Bytes) {
  let s = a.label_sym(name)
  a.register(s)
  a.fixes.push(Fix{sect: a.cur, at: a.sects[a.cur].words.len(), kind: kind, sym: s, line: a.line})
  a.sects[a.cur].words.push(w)
}

fn (var a: Asm) bad(m: Str, ops: List[Bytes]) {
  var parts: List[Str] = []
  for o in ops {
    parts.push(bstr(o))
  }
  a.fail("unsupported instruction: ${m} ${parts.join(", ")}")
}


/// The N:immr:imms field (13 bits) of a logical immediate of a register
/// of size bits, or None when v is not one.
fn logical_imm(v0: Int, size: Int) -> Int? {
  var v = v0
  if size == 32 {
    v = v & 0xffffffff
    // the 32 bit pattern repeated, so the element search below sees it
    v = v | shl(v, 32)
  }
  if v == 0 || v == -1 {
    return None
  }
  var bits: List[Int] = []
  for i in 0..64 {
    bits.push((v >> i) & 1)
  }
  // the smallest element size whose repetition is v
  var e = 2
  while e < 64 {
    var ok = true
    for i in 0..64 {
      if bits[i] != bits[i % e] {
        ok = false
        break
      }
    }
    if ok {
      break
    }
    e = e * 2
  }
  if size == 32 && e == 64 {
    return None
  }
  // the element must be one run of ones, rotated: find where it starts
  var ones = 0
  for i in 0..e {
    ones += bits[i]
  }
  if ones == 0 || ones == e {
    return None
  }
  var p = -1
  for i in 0..e {
    if bits[i] == 1 && bits[(i + e - 1) % e] == 0 {
      p = i
      break
    }
  }
  for k in 0..ones {
    if bits[(p + k) % e] != 1 {
      return None
    }
  }
  let immr = (e - p) % e
  var nbit = 0
  var imms = 0
  if e == 64 {
    nbit = 1
    imms = ones - 1
  } else {
    imms = ((~(e * 2 - 1)) & 0x3f) | (ones - 1)
  }
  Some(nbit * 4096 + immr * 64 + imms)
}

/// A general register of a data processing instruction, of kind k
/// numbered n: x (sf 1) or w (sf 0), sp allowed when sp_ok; (number, sf),
/// or (-1, 0).
fn gp(n: Int, k: Int, sp_ok: Bool) -> (Int, Int) {
  if k == RX {
    return (n, 1)
  }
  if k == RW {
    return (n, 0)
  }
  if k == RSP && sp_ok {
    return (31, 1)
  }
  (-1, 0)
}

/// The word of add, adds, sub, or subs m of d (kind kd) and s (kind ks)
/// with x, an immediate or a register, and sh, an optional shift (no
/// relocation: addsub handles a page offset), -1 when there is none.
fn addsub_word(m: Str, rd: Int, kd: Int, rs: Int, ks: Int, x: Operand, sh: List[Operand]) -> Int {
  var sub = m == "sub" || m == "subs"
  let flags = m == "adds" || m == "subs"
  if !(m is "add" | "adds" | "sub" | "subs") {
    return -1
  }
  let (d, sfd) = gp(rd, kd, !flags)
  let (s, sfs) = gp(rs, ks, true)
  if d < 0 || s < 0 || sfd != sfs {
    return -1
  }
  let sf = sfd
  let fl = if flags { 0x20000000 } else { 0 }
  var sk = 0
  var amt = 0
  var shifted = false
  if sh.len() == 1 {
    match sh[0] {
      Shift(k, a) => {
        sk = k
        amt = a
        shifted = true
      }
      Reg(..) | VReg(..) | Imm(..) | MemOp(..) | Cond(..) | Sym(..) | Raw(..) => return -1
    }
  } else if sh.len() > 1 {
    return -1
  }
  match x {
    Imm(v0) => {
      // an immediate, with an optional lsl #12
      var v = v0
      var h = 0
      if shifted {
        if sk != 0 || !(amt is 0 | 12) {
          return -1
        }
        h = if amt == 12 { 1 } else { 0 }
      }
      if v < 0 && h == 0 {
        // add #-n is sub #n
        v = 0 - v
        sub = !sub
      }
      if h == 0 && v > 4095 && v % 4096 == 0 && v / 4096 <= 4095 {
        v = v / 4096
        h = 1
      }
      if v < 0 || v > 4095 {
        return -1
      }
      let base = if sub { 0x51000000 } else { 0x11000000 }
      return base | (sf * 0x80000000) | fl | (h * 0x400000) | (v * 0x400) | (s * 32) | d
    }
    Reg(rn, kr) => {
      // a shifted register
      let (r, sfr) = gp(rn, kr, false)
      if r < 0 || sfr != sf {
        return -1
      }
      if amt < 0 || amt > (if sf == 1 { 63 } else { 31 }) {
        return -1
      }
      if kd == RSP || ks == RSP {
        // the extended register form, uxtx (lsl) #amt
        if sk != 0 || amt > 4 {
          return -1
        }
        let base = if sub { 0x4b200000 } else { 0x0b200000 }
        return base | (sf * 0x80000000) | fl | (r * 0x10000) | ((2 + sf) * 0x2000) | (amt * 0x400) | (s * 32) | d
      }
      let base = if sub { 0x4b000000 } else { 0x0b000000 }
      return base | (sf * 0x80000000) | fl | (sk * 0x400000) | (r * 0x10000) | (amt * 0x400) | (s * 32) | d
    }
    VReg(..) | Shift(..) | MemOp(..) | Cond(..) | Sym(..) | Raw(..) => return -1
  }
}

/// A vector register operand `vN.<arrangement>`: (N, the arrangement
/// text), or (-1, "").
fn vreg(b: Bytes) -> (Int, Str) {
  if b.len() < 4 || b[0] != 'v' {
    return (-1, "")
  }
  var n = 0
  var i = 1
  while i < b.len() && b[i] >= '0' && b[i] <= '9' {
    n = n * 10 + Int(b[i] - '0')
    i += 1
  }
  if i == 1 || i > 3 || n > 31 || i >= b.len() || b[i] != '.' {
    return (-1, "")
  }
  (n, bstr(b[i + 1..]))
}

/// A memory operand: [base], [base, #imm], [base, #imm]! (pre), or
/// [base, Rm{, lsl #s}]; post indexing is the next operand.
pub struct Mem {
  pub base: Int
  /// 0 offset, 1 pre index, 2 post index, 3 register offset
  pub mode: Int
  pub off: Int
  pub rm: Int = 0
  /// the shift of a register offset, -1 for none
  pub sh: Int = -1
  pub ok: Bool
  /// an offset written out, `[x0, #0]` (the Op prints it back as written,
  /// decision 0274 step 3)
  pub explicit: Bool = false
}

fn mem_op(ops: List[Bytes], at: Int) -> Mem {
  let bad = Mem{base: 0, mode: 0, off: 0, ok: false}
  if at >= ops.len() {
    return bad
  }
  let b0 = ops[at]
  var b = b0
  var pre = false
  if b.len() > 0 && b[b.len() - 1] == '!' {
    pre = true
    b = b[0..b.len() - 1]
  }
  if b.len() < 3 || b[0] != '[' || b[b.len() - 1] != ']' {
    return bad
  }
  let parts = split_operands(b[1..b.len() - 1])
  let (base, kb) = reg(parts[0])
  if kb != RX && kb != RSP {
    return bad
  }
  if parts.len() == 1 {
    if pre {
      return bad
    }
    if at + 1 < ops.len() {
      // post index: [base], #imm
      match imm(ops[at + 1]) {
        Some(v) => return Mem{base: base, mode: 2, off: v, ok: at + 2 == ops.len()}
        None => return bad
      }
    }
    return Mem{base: base, mode: 0, off: 0, ok: true}
  }
  if at + 1 != ops.len() {
    return bad
  }
  match imm(parts[1]) {
    Some(v) => {
      if parts.len() != 2 {
        return bad
      }
      return Mem{base: base, mode: if pre { 1 } else { 0 }, off: v, ok: true, explicit: true}
    }
    None => {}
  }
  if pre {
    return bad
  }
  let (rm, km) = reg(parts[1])
  if km != RX {
    return bad
  }
  var sh = -1
  if parts.len() == 3 {
    match shift_op(parts[2]) {
      Some((0, s)) => sh = s
      _ => return bad
    }
  } else if parts.len() != 2 {
    return bad
  }
  Mem{base: base, mode: 3, off: 0, rm: rm, sh: sh, ok: true}
}

/// The word of load or store m of register t (kind kt) at memory operand
/// mo, -1 when there is none (decision 0274: the encoding of an Op's
/// operands, shared by the text path, ldst, and encode_op).
fn ldst_word(m: Str, t: Int, kt: Int, mo: Mem) -> Int {
  // size (log2 bytes), V (fp), opc for a load
  var size = 3
  var v = 0
  let load = m.starts_with("ld")
  var opc = if load { 1 } else { 0 }
  match m {
    "ldr" | "str" | "ldur" | "stur" => {
      if kt == RX {
        size = 3
      } else if kt == RW {
        size = 2
      } else if kt == RD {
        size = 3
        v = 1
      } else if kt == RS {
        size = 2
        v = 1
      } else if kt == RQ {
        // a 128 bit register: size 0 and opc 2 or 3
        size = 0
        v = 1
        opc = opc + 2
      } else {
        return -1
      }
    }
    "ldrb" | "strb" => {
      if kt != RW {
        return -1
      }
      size = 0
    }
    "ldrh" | "strh" => {
      if kt != RW {
        return -1
      }
      size = 1
    }
    "ldrsw" => {
      if kt != RX {
        return -1
      }
      size = 2
      opc = 2
    }
    _ => return -1
  }
  // a q register: a register offset, or an unsigned offset in 16 byte
  // units (the unrolled AES rounds of decision 0231)
  if !mo.ok || (kt == RQ && !((mo.mode == 3 && mo.sh < 0) || mo.mode == 0)) {
    return -1
  }
  let head = (size * 0x40000000) | 0x38000000 | (v * 0x4000000)
  let scale = if kt == RQ { 16 } else { pow2(size) }
  let rn = mo.base * 32
  if mo.mode == 3 {
    // register offset, lsl #0 or #size (S)
    var s = 0
    if mo.sh >= 0 {
      if mo.sh == size {
        s = 1
      } else if mo.sh != 0 {
        return -1
      }
      // ldrb with an explicit lsl #0 sets S
      if size == 0 && mo.sh == 0 {
        s = 1
      }
    }
    return head | (opc * 0x400000) | 0x200000 | (mo.rm * 0x10000) | (3 * 0x2000) | (s * 0x1000) | 0x800 | rn | t
  }
  if mo.mode == 1 || mo.mode == 2 {
    if mo.off < -256 || mo.off > 255 {
      return -1
    }
    let idx = if mo.mode == 1 { 0xc00 } else { 0x400 }
    return head | (opc * 0x400000) | ((mo.off & 0x1ff) * 0x1000) | idx | rn | t
  }
  let unscaled = m == "ldur" || m == "stur"
  if !unscaled && mo.off >= 0 && mo.off % scale == 0 && mo.off / scale <= 4095 {
    return head | 0x1000000 | (opc * 0x400000) | ((mo.off / scale) * 0x400) | rn | t
  }
  if mo.off < -256 || mo.off > 255 {
    return -1
  }
  head | (opc * 0x400000) | ((mo.off & 0x1ff) * 0x1000) | rn | t
}

/// The word of ldp or stp m of registers t1 and t2 (kinds k1, k2) at
/// memory operand mo, -1 when there is none.
fn ldstp_word(m: Str, t1: Int, k1: Int, t2: Int, k2: Int, mo: Mem) -> Int {
  if k1 != k2 || !(m is "ldp" | "stp") {
    return -1
  }
  // opc and V: x 10/0, w 00/0, d 01/1, q 10/1
  var opc = 0
  var v = 0
  var scale = 8
  if k1 == RX {
    opc = 2
  } else if k1 == RQ {
    opc = 2
    v = 1
    scale = 16
  } else if k1 == RW {
    scale = 4
  } else if k1 == RD {
    opc = 1
    v = 1
  } else {
    return -1
  }
  if !mo.ok || mo.mode == 3 || mo.off % scale != 0 || mo.off / scale < -64 || mo.off / scale > 63 {
    return -1
  }
  let mode = match mo.mode {
    0 => 0x1000000
    1 => 0x1800000
    _ => 0x800000
  }
  let l = if m == "ldp" { 0x400000 } else { 0 }
  (opc * 0x40000000) | 0x28000000 | (v * 0x4000000) | mode | l | (((mo.off / scale) & 0x7f) * 0x8000) | (t2 * 0x400) | (mo.base * 32) | t1
}
