// The PDB of a windows/amd64 executable (decision 0344): after Xo's PE
// linker (pelink.xo) has written the image with a debug directory whose
// CodeView (RSDS) record names the PDB, pe_pdb reads the image's DWARF
// back (compiler/debug, the readers of `xo debug` and `xo dev
// symbolize`) and writes the PDB WinDbg, cdb and Visual Studio read,
// and the record's GUID, a hash of the image, so a build stays
// reproducible and the two files agree.
//
// Stage 1: the MSF 7.0 container (4096 byte blocks, the free block map,
// the stream directory) holding the PDB info stream (the GUID, age, the
// named stream /names), empty TPI and IPI streams, the DBI stream (one
// module, its section contribution, the section map, the optional debug
// header naming the section header stream), the module's symbols
// (S_GPROC32 and S_END for each DWARF function, named as the traceback
// names it), the publics (S_PUB32 for each COFF function symbol, their
// GSI hash and address map) and globals (S_PROCREF of each function).
// Layouts from LLVM's PDB documentation (llvm.org/docs/PDB) and its
// reader, llvm-pdbutil, which checks them.

use github.com/xo-lang/xo/compiler/debug
use std/crypto

const PDB_BLOCK = 4096

/// The streams, by index.
const PS_INFO = 1
const PS_TPI = 2
const PS_DBI = 3
const PS_IPI = 4
const PS_NAMES = 5
const PS_MOD = 6
const PS_SECTHDR = 7
const PS_PUBLICS = 8
const PS_GLOBALS = 9
const PS_SYMS = 10
/// the IPI stream's hash values and index offsets
const PS_IPIHASH = 11
/// the TPI stream's hash values and index offsets
const PS_TPIHASH = 12
const PS_COUNT = 13

/// CodeView symbol kinds.
const S_END = 0x0006
const S_OBJNAME = 0x1101
const S_PUB32 = 0x110e
const S_GPROC32 = 0x1110
const S_PROCREF = 0x1125
const S_INLINESITE = 0x114d
const S_INLINESITE_END = 0x114e

/// LF_FUNC_ID, an IPI record naming an inlined function.
const LF_FUNC_ID = 0x1601

/// The binary annotations of an inline site (cvinfo.h; ChangeCodeOffset
/// is 3: 2 is ChangeCodeOffsetBase, which LLVM's reader ignores when it
/// looks for the site holding an address
/// BinaryAnnotationOpcode).
const BA_CODE_OFFSET = 3
const BA_CODE_LENGTH = 4
const BA_FILE = 5
const BA_LINE_OFFSET = 6
const BA_CODE_AND_LINE = 0xb

/// IMAGE_DEBUG_TYPE_CODEVIEW, and the RSDS record's size before its path.
const DEBUG_TYPE_CODEVIEW = 2
const RSDS_FIXED = 24

/// A function of the module: its name, section (1 based) and offset
/// there, its size, and its line rows (offset in the function, file (an
/// index of the DWARF's files), line, whether a statement starts).
struct PdbProc {
  name: Str
  seg: Int
  off: Int
  size: Int
  rows: List[(Int, Int, Int, Bool)] = []
  /// its first address and its inline sites, parents before children
  lo: Int = 0
  sites: List[PdbSite] = []
  locals: List[PdbLocal] = []
  /// made from its object (pre_procs): its offset in the object's section,
  /// by which its locals' section offsets move
  sect_off: Int = -1
}

/// A call inlined into a function: the callee's name, the enclosing
/// site (-1: the function), its address ranges, and its line entries
/// (address, file (a DWARF file index), line), the code of a call
/// inlined into it at that call's line.
struct PdbSite {
  name: Str
  parent: Int
  ranges: List[(Int, Int)]
  entries: List[(Int, Int, Int)]
  /// the call's variables (debug.Inlined.vars), then their locals
  vars: List[debug.Var] = []
  locals: List[PdbLocal] = []
}

/// The C13 subsection kinds.
const DEBUG_S_LINES = 0xf2
const DEBUG_S_FILECHKSMS = 0xf4
const DEBUG_S_INLINEELINES = 0xf6

/// A PE section as the PDB needs it: its address (RVA), size in memory,
/// characteristics, and the raw 40 byte header.
struct PdbSect {
  rva: Int
  vsize: Int
  chars: Int
  header: Bytes
}

/// The image img with its RSDS record's GUID and the debug directory's
/// time stamp set, and its PDB; an error when img has no CodeView debug
/// directory or no DWARF.
pub fn pe_pdb(img: Bytes) -> Result[(Bytes, Bytes), Str] { pe_pdb_facts(img, None, None) }

/// pe_pdb with the DWARF facts given (merge_facts: made from each
/// object's own DWARF and the link's layout) instead of read from img.
/// With pre (pre_procs: each function's rows and inline sites made from
/// its own object), only the locals, the types and the file are made here.
pub fn pe_pdb_facts(img: Bytes, facts: (debug.Info, debug.Lines)?, pre: PreProcs?) -> Result[(Bytes, Bytes), Str] { pe_pdb_seeded(img, facts, pre, b"") }

/// The image img with its PDB's GUID and time stamp in its debug
/// directory's CodeView record and header, and the hash they come from:
/// the seed's, else the image's (its GUID and time stamp still zero).
/// Nothing in it depends on the PDB, so the image can be written before
/// the PDB is made (ld.xo PdbLater: `xo run` and `xo test` make it while
/// the program runs).
pub fn pe_pdb_stamped(img: Bytes, seed: Bytes) -> Result[(Bytes, Bytes), Str] {
  if img.len() < 64 || img[0] != 77 || img[1] != 90 {
    return Err("not a PE image")
  }
  let pe = le_b(img, 60, 4)
  let coff = pe + 4
  let opt = coff + 20
  let nsec = le_b(img, coff + 2, 2)
  let sec = opt + le_b(img, coff + 16, 2)
  // the debug directory (data directory 6, at 112 + 8 * 6 of PE32+'s
  // optional header): its file offset from its RVA
  let drva = le_b(img, opt + 112 + 48, 4)
  if drva == 0 {
    return Err("the image has no debug directory")
  }
  let dfile = rva_file(img, sec, nsec, drva)
  if dfile < 0 || le_b(img, dfile + 12, 4) != DEBUG_TYPE_CODEVIEW {
    return Err("the image's debug directory has no CodeView record")
  }
  let rsds = le_b(img, dfile + 24, 4)
  let h = if seed.is_empty() { crypto.sha256(img) } else { crypto.sha256(seed) }
  var b = BytesBuilder.with_capacity(img.len())
  b.write(img[0..dfile + 4])
  b.write(h[16..20])
  b.write(img[dfile + 8..rsds + 4])
  b.write(h[0..16])
  b.write(img[rsds + 20..img.len()])
  Ok((b.freeze(), h))
}

/// pe_pdb_facts with the GUID and time stamp from seed (what made the
/// image: its objects' cache keys and the link's options, ld.xo pdb_seed)
/// instead of the image's own hash; an empty seed hashes the image.
pub fn pe_pdb_seeded(img: Bytes, facts: (debug.Info, debug.Lines)?, pre: PreProcs?, seed: Bytes) -> Result[(Bytes, Bytes), Str] {
  let (out, h) = match pe_pdb_stamped(img, seed) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let (sects, base) = pe_pdb_sects(img)
  let guid = h[0..16]
  let stamp = le_b(h, 16, 4)
  if let Some(pp) = pre {
    if pp.std_lazy {
      return Err("the PDB: std's functions were not read (a lazy std part without the writer's)")
    }
    let (pdb, _) = pdb_of_pre(img, guid, stamp, sects, base, pp, None)
    return Ok((out, pdb))
  }
  pe_pdb_dwarf(img, facts, out, guid, stamp, sects, base)
}

/// pe_pdb_seeded from pre's functions, with std's part of the PDB from
/// std (the PdbStd an earlier link from std's same half made) when given;
/// also std's part as this PDB made it (None: no std part, or std given).
pub fn pe_pdb_std(img: Bytes, pp: PreProcs, seed: Bytes, std: PdbStd?) -> Result[(Bytes, Bytes, PdbStd?), Str] {
  if pp.std_lazy && std is None {
    return Err("the PDB: std's functions were not read (a lazy std part without the writer's)")
  }
  let (out, h) = match pe_pdb_stamped(img, seed) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let (sects, base) = pe_pdb_sects(img)
  let (pdb, made) = pdb_of_pre(img, h[0..16], le_b(h, 16, 4), sects, base, pp, std)
  Ok((out, pdb, made))
}

/// The image's sections for the PDB, and its image base.
fn pe_pdb_sects(img: Bytes) -> (List[PdbSect], Int) {
  let pe = le_b(img, 60, 4)
  let coff = pe + 4
  let opt = coff + 20
  let nsec = le_b(img, coff + 2, 2)
  let base = le_b(img, opt + 24, 8)
  let sec = opt + le_b(img, coff + 16, 2)
  var sects: List[PdbSect] = []
  for i in 0..nsec {
    let h = sec + 40 * i
    sects.push(PdbSect{rva: le_b(img, h + 12, 4), vsize: le_b(img, h + 8, 4), chars: le_b(img, h + 36, 4), header: img[h..h + 40]})
  }
  (sects, base)
}

/// The PDB from pp's functions (pe_pdb_seeded's pre path; pe_pdb_std).
fn pdb_of_pre(img: Bytes, guid: Bytes, stamp: Int, sects: List[PdbSect], base: Int, pp: PreProcs, std: PdbStd?) -> (Bytes, PdbStd?) {
  // std's types from std, else made (and kept for the PdbStd made)
  var std_types = CvTypes{}
  var types = CvTypes{}
  match std {
    Some(s) => {
      types = s.types
      cv_types_rest(types, pp.info, pp.tys, pp.std_off, pp.std_tys)
    }
    None => if pp.std_off >= 0 {
      std_types = cv_types_std(pp.info, pp.tys, pp.std_off, pp.std_tys)
      types = std_types
      cv_types_rest(types, pp.info, pp.tys, pp.std_off, pp.std_tys)
    } else {
      types = cv_types_split(pp.info, pp.tys, -1, 0)
    }
  }
  var procs: List[PdbProc] = []
  // std's placed functions from std, or counted as they are placed
  var from = 0
  var pstd = 0
  match std {
    Some(s) => {
      // only their names are read (sym_records, gsi): the rest is in s
      procs = List.with_capacity(s.names.len() + pp.procs.len())
      for n in s.names {
        procs.push(PdbProc{name: n, seg: 0, off: 0, size: 0})
      }
      // (a lazy pp has only the program's)
      from = if pp.std_lazy { 0 } else { pp.std_procs }
      pstd = s.names.len()
    }
    None => {}
  }
  for i in from..pp.procs.len() {
    let p0 = pp.procs[i]
    {
      let (seg, off) = seg_off(sects, p0.lo - base)
      if seg > 0 {
        let delta = off - p0.sect_off
        var sites = p0.sites
        for i in 0..sites.len() {
          var st = sites[i]
          st.locals = locals_placed(st.locals, types, pp.info, delta, seg)
          sites[i] = st
        }
        procs.push(p0 with {seg: seg, off: off, sites: sites, locals: locals_placed(p0.locals, types, pp.info, delta, seg)})
        if std is None && i < pp.std_procs {
          pstd += 1
        }
      }
    }
  }
  var pubs: List[PdbProc] = []
  for (a, n) in debug.tables(img).syms {
    let (seg, off) = seg_off(sects, a - base)
    if seg > 0 {
      pubs.push(PdbProc{name: n, seg: seg, off: off, size: 0})
    }
  }
  let (pdb, made) = pdb_file(guid, stamp, sects, procs, pubs, pp.files, types, pstd, std)
  (pdb, match made {
    Some(m) => Some(m with {types: std_types})
    None => None
  })
}

/// pe_pdb_seeded from the image's DWARF (facts, or read from img).
fn pe_pdb_dwarf(img: Bytes, facts: (debug.Info, debug.Lines)?, out: Bytes, guid: Bytes, stamp: Int, sects: List[PdbSect], base: Int) -> Result[(Bytes, Bytes), Str] {
  // the functions: DWARF's, by name as the traceback shows them
  let (info, lns) = match facts {
    Some(f) => f
    None => {
      let s = match debug.sections(img) {
        Ok(x) => x
        Err(e) => return Err("the image's DWARF: ${e}")
      }
      (debug.read(s), debug.lines(s))
    }
  }
  // the line rows by address (a sequence's end row starts no code)
  var keyed: List[(Int, Int)] = []
  for (i, r) in lns.rows.indexed() {
    if !r.end && r.file >= 0 {
      keyed.push((r.addr, i))
    }
  }
  let by_addr = keyed.sort()
  var file_of: Map[Str, Int] = {}
  for (i, f) in lns.files.indexed() {
    file_of[f] = i
  }
  var types = cv_types(info)
  var procs: List[PdbProc] = []
  for f in info.funcs {
    if f.hi <= f.lo {
      continue
    }
    let (seg, off) = seg_off(sects, f.lo - base)
    if seg > 0 {
      // the calls inlined into f itself (depth 1): their code is at the
      // call's line in f's own lines (stage 3 describes them inside)
      var calls: List[(List[(Int, Int)], Int, Int)] = []
      for c in f.inlined {
        if c.depth == 1 {
          let cf = file_of.get(lns.call_file(c.unit_line, c.call_file)) ?? -1
          calls.push((c.ranges, cf, c.call_line))
        }
      }
      var sites = inline_sites(lns, by_addr, file_of, f)
      for i in 0..sites.len() {
        var st = sites[i]
        st.locals = cv_locals(types, info, st.vars, st.ranges, sects, base)
        sites[i] = st
      }
      procs.push(PdbProc{name: f.name, seg: seg, off: off, size: f.hi - f.lo, rows: fn_rows(lns, by_addr, f.lo, f.hi, calls), lo: f.lo, sites: sites, locals: cv_locals(types, info, f.vars, [(f.lo, f.hi)], sects, base)})
    }
  }
  // the publics: the COFF symbol table's functions
  var pubs: List[PdbProc] = []
  for (a, n) in debug.tables(img).syms {
    let (seg, off) = seg_off(sects, a - base)
    if seg > 0 {
      pubs.push(PdbProc{name: n, seg: seg, off: off, size: 0})
    }
  }
  let (pdb, _) = pdb_file(guid, stamp, sects, procs, pubs, lns.files, types, 0, None)
  Ok((out, pdb))
}

/// ls (made from an object, pre_procs) with their CodeView types and
/// their records moved delta bytes into section seg.
fn locals_placed(ls: List[PdbLocal], var types: CvTypes, info: debug.Info, delta: Int, seg: Int) -> List[PdbLocal] {
  var out = List[PdbLocal].with_capacity(ls.len())
  for l in ls {
    // (the records move as write_local writes them: a copy of each was
    // most of the PDB's time in a separately compiled HTTP server's link)
    out.push(l with {ty: cv_index(types, info, l.ty), delta: delta, seg: seg})
  }
  out
}

/// The inline sites of f (decision 0344 stage 3): each inlined call,
/// its parent the call of one less depth whose ranges hold its first
/// address, in address order with parents first; each site's entries
/// its ranges' rows as fn_rows maps a function's.
fn inline_sites(lns: debug.Lines, by_addr: List[(Int, Int)], file_of: Map[Str, Int], f: debug.Func) -> List[PdbSite] {
  // the calls by depth, then by first address
  var order: List[(Int, Int, Int)] = []
  for (i, c) in f.inlined.indexed() {
    if !c.ranges.is_empty() {
      order.push((c.depth, c.ranges[0].0, i))
    }
  }
  var idx: List[Int] = []
  for (_, _, i) in order.sort() {
    idx.push(i)
  }
  // each call's parent (an index of f.inlined, -1: f)
  var parent: Map[Int, Int] = {}
  for i in idx {
    let c = f.inlined[i]
    var p = -1
    if c.depth > 1 {
      let a = c.ranges[0].0
      for j in idx {
        let d = f.inlined[j]
        if d.depth == c.depth - 1 {
          for (rlo, rhi) in d.ranges {
            if a >= rlo && a < rhi {
              p = j
            }
          }
        }
      }
      if p < 0 {
        // no enclosing call: not placed
        continue
      }
    }
    parent[i] = p
  }
  // each call's children in idx order: one depth, so by first address
  var kids: Map[Int, List[Int]] = {}
  for i in idx {
    if parent.contains(i) {
      let p = parent.get(i) ?? -2
      var l = kids.get(p) ?? []
      l.push(i)
      kids[p] = l
    }
  }
  // the sites in depth first order, each parent before its children
  var out: List[PdbSite] = []
  site_walk(lns, by_addr, file_of, f, kids, -1, -1, out)
  out
}

/// Appends the sites whose parent is call p (site index ps) and their
/// children.
fn site_walk(lns: debug.Lines, by_addr: List[(Int, Int)], file_of: Map[Str, Int], f: debug.Func, kids: Map[Int, List[Int]], p: Int, ps: Int, var out: List[PdbSite]) {
  for i in kids.get(p) ?? [] {
    let c = f.inlined[i]
    // the calls inlined into this one: their code at their call's line
    var calls: List[(List[(Int, Int)], Int, Int)] = []
    for j in kids.get(i) ?? [] {
      let d = f.inlined[j]
      calls.push((d.ranges, file_of.get(lns.call_file(d.unit_line, d.call_file)) ?? -1, d.call_line))
    }
    let ranges = spans_sorted(c.ranges)
    var entries: List[(Int, Int, Int)] = []
    for (rlo, rhi) in ranges {
      let rows = fn_rows(lns, by_addr, rlo, rhi, calls)
      for (k, (off, file, line, _)) in rows.indexed() {
        // the range's first entry at its start
        entries.push((if k == 0 { rlo } else { rlo + off }, file, line))
      }
    }
    if entries.is_empty() {
      continue
    }
    let me = out.len()
    out.push(PdbSite{name: c.name, parent: ps, ranges: ranges, entries: entries, vars: c.vars})
    site_walk(lns, by_addr, file_of, f, kids, i, me, out)
  }
}

/// The rows of [lo, hi) (by_addr: the rows' addresses and indexes, in
/// address order), as offsets from lo; a function whose first row is
/// past lo starts with the row before it, at offset 0. A row in the code
/// of a call inlined into the function (calls: its ranges, the call's
/// file and line) takes the call's file and line, so the function's rows
/// are its own lines, as Windows' tools read them; a run of rows on one
/// line is one row. Only the function's home file (the one most rows
/// name) is kept: a reader opens every file's block at the function's
/// start (LLVM's SymbolCache::findLineTable, as MSVC's tools), so a
/// second block (a prologue row in an inlined callee's file, outside the
/// call's range) hid the first; a dropped row's code takes the line
/// before it.
fn fn_rows(lns: debug.Lines, by_addr: List[(Int, Int)], lo: Int, hi: Int, calls: List[(List[(Int, Int)], Int, Int)]) -> List[(Int, Int, Int, Bool)] {
  // the first row at or past lo
  var a = 0
  var b = by_addr.len()
  while a < b {
    let m = (a + b) / 2
    let (ad, _) = by_addr[m]
    if ad < lo {
      a = m + 1
    } else {
      b = m
    }
  }
  var raw: List[(Int, Int, Int, Bool)] = []
  if a > 0 && (a == by_addr.len() || by_addr[a].0 > lo) {
    let r = lns.rows[by_addr[a - 1].1]
    raw.push((lo, r.file, r.line, r.stmt))
  }
  var k = a
  while k < by_addr.len() && by_addr[k].0 < hi {
    let r = lns.rows[by_addr[k].1]
    raw.push((r.addr, r.file, r.line, r.stmt))
    k += 1
  }
  var mapped: List[(Int, Int, Int, Bool)] = []
  var count: Map[Int, Int] = {}
  for (addr, f0, l0, stmt) in raw {
    var f = f0
    var l = l0
    for (ranges, cf, cl) in calls {
      for (rlo, rhi) in ranges {
        if addr >= rlo && addr < rhi && cf >= 0 {
          f = cf
          l = cl
        }
      }
    }
    mapped.push((addr, f, l, stmt))
    count[f] = (count.get(f) ?? 0) + 1
  }
  var home = -1
  var best = 0
  for (_, f, _, _) in mapped {
    let c = count.get(f) ?? 0
    if c > best {
      best = c
      home = f
    }
  }
  var out: List[(Int, Int, Int, Bool)] = []
  for (addr, f, l, stmt) in mapped {
    if f != home {
      continue
    }
    let off = addr - lo
    if !out.is_empty() {
      let (po, pf, pl, _) = out[out.len() - 1]
      if pf == f && pl == l {
        continue
      }
      // one row per offset: the last of several at one address
      if po == off {
        out.pop()
      }
    }
    out.push((off, f, l, stmt))
  }
  out
}

/// The little endian number of n bytes at o.
fn le_b(b: Bytes, o: Int, n: Int) -> Int {
  var v = 0
  for k in 0..n {
    v = v | (Int(b[o + k]) << (8 * k))
  }
  v
}

/// The file offset of an RVA, or -1.
fn rva_file(img: Bytes, sec: Int, nsec: Int, rva: Int) -> Int {
  for i in 0..nsec {
    let h = sec + 40 * i
    let va = le_b(img, h + 12, 4)
    if rva >= va && rva < va + le_b(img, h + 8, 4) {
      return le_b(img, h + 20, 4) + rva - va
    }
  }
  -1
}

/// The section (1 based; 0: none) holding RVA rva, and the offset in it.
fn seg_off(sects: List[PdbSect], rva: Int) -> (Int, Int) {
  for (i, s) in sects.indexed() {
    if rva >= s.rva && rva < s.rva + s.vsize {
      return (i + 1, rva - s.rva)
    }
  }
  (0, 0)
}

/// What std's functions make of a PDB, the same in every link from std's
/// half (decision 0409 on PE: they keep their places): the first pstd
/// placed functions' names (all the global symbols need of them), the
/// files and inlined functions they name first (in first use order),
/// their module records (from the stream's offset 16) with each one's
/// offset, and their line blocks.
pub struct PdbStd {
  names: List[Str]
  /// std's CodeView types (cv_types_std)
  types: CvTypes
  files: List[Str]
  fidx: List[(Int, Int)]
  inlinees: List[(Str, Int, Int)]
  recs: Bytes
  at: List[Int]
  lines: Bytes
}

fn std_names(procs: List[PdbProc]) -> List[Str] {
  var out = List[Str].with_capacity(procs.len())
  for p in procs {
    out.push(p.name)
  }
  out
}

/// The files procs' rows and sites name that files (fidx: a DWARF file's
/// index among them) does not have yet, added in first use order.
fn pdb_files_add(procs: List[PdbProc], dfiles: List[Str], var files: List[Str], var fidx: Map[Int, Int]) {
  for p in procs {
    for (_, f, _, _) in p.rows {
      if !fidx.contains(f) {
        fidx[f] = files.len()
        files.push(dfiles[f])
      }
    }
    for st in p.sites {
      for (_, f, _) in st.entries {
        if !fidx.contains(f) {
          fidx[f] = files.len()
          files.push(dfiles[f])
        }
      }
    }
  }
}

/// The inlined functions procs' sites call that fid (each one's
/// LF_FUNC_ID) does not have yet, added in first use order with their
/// first site's first entry.
fn pdb_inlinees_add(procs: List[PdbProc], var fid: Map[Str, Int], var inlinees: List[(Str, Int, Int)]) {
  for p in procs {
    for st in p.sites {
      if !fid.contains(st.name) {
        fid[st.name] = 0x1000 + inlinees.len()
        let (_, f, l) = st.entries[0]
        inlinees.push((st.name, f, l))
      }
    }
  }
}

/// The PDB's bytes: its streams in the MSF container. The first pstd of
/// procs are std's: their part is std's when given, else made and
/// returned (None when pstd is 0 or std was given).
fn pdb_file(guid: Bytes, stamp: Int, sects: List[PdbSect], procs: List[PdbProc], pubs: List[PdbProc], dfiles: List[Str], types: CvTypes, pstd: Int, std: PdbStd?) -> (Bytes, PdbStd?) {
  var streams: List[Bytes] = []
  for _ in 0..PS_COUNT {
    streams.push(b"")
  }
  // the files the line rows name, in first use order, and each one's
  // index among them; each inlined function's LF_FUNC_ID (its type index)
  // and its first site's first entry: the file and line its sites'
  // annotations start from (DEBUG_S_INLINEELINES); std's first
  var files: List[Str] = []
  var fidx: Map[Int, Int] = {}
  var fid: Map[Str, Int] = {}
  var inlinees: List[(Str, Int, Int)] = []
  match std {
    Some(s) => {
      files = s.files
      for (f, i) in s.fidx {
        fidx[f] = i
      }
      inlinees = s.inlinees
      for (i, (n, _, _)) in inlinees.indexed() {
        fid[n] = 0x1000 + i
      }
    }
    None => {
      pdb_files_add(procs[0..pstd], dfiles, files, fidx)
      pdb_inlinees_add(procs[0..pstd], fid, inlinees)
    }
  }
  let std_files = files
  var std_fidx: List[(Int, Int)] = []
  if std is None && pstd > 0 {
    for (f, i) in fidx {
      std_fidx.push((f, i))
    }
  }
  let std_inlinees = inlinees
  let prog = procs[pstd..procs.len()]
  pdb_files_add(prog, dfiles, files, fidx)
  pdb_inlinees_add(prog, fid, inlinees)
  let (names, name_at) = names_table(files)
  // std's line blocks and module records, then the program's after them
  let (slines, srecs, sat) = match std {
    Some(s) => (s.lines, s.recs, s.at)
    None => {
      let (r, a) = proc_records(procs[0..pstd], 16, fid, inlinees, fidx)
      (proc_lines(procs[0..pstd], fidx), r, a)
    }
  }
  let c13 = c13_lines(slines + proc_lines(prog, fidx), fidx, name_at, inlinees)
  let (precs, pat) = proc_records(prog, 16 + srecs.len(), fid, inlinees, fidx)
  let modsyms = module_stream(srecs + precs, c13)
  let proc_at = sat + pat
  let made = if std is None && pstd > 0 { Some(PdbStd{names: std_names(procs[0..pstd]), types: CvTypes{}, files: std_files, fidx: std_fidx, inlinees: std_inlinees, recs: srecs, at: sat, lines: slines}) } else { None }
  let (recs, pub_at, ref_at) = sym_records(procs, proc_at, pubs)
  streams[PS_INFO] = info_stream(guid, stamp)
  let (tpi, tpihash) = type_stream(types.recs, types.hashes, PS_TPIHASH)
  streams[PS_TPI] = tpi
  streams[PS_TPIHASH] = tpihash
  let (ipi, ipihash) = ipi_stream(inlinees)
  streams[PS_IPI] = ipi
  streams[PS_IPIHASH] = ipihash
  streams[PS_NAMES] = names
  streams[PS_MOD] = modsyms
  var sh = BytesBuilder.new()
  for s in sects {
    sh.write(s.header)
  }
  streams[PS_SECTHDR] = sh.freeze()
  streams[PS_SYMS] = recs
  streams[PS_PUBLICS] = publics_stream(pubs, pub_at)
  var pnames: List[Str] = []
  for p in procs {
    pnames.push(p.name)
  }
  streams[PS_GLOBALS] = gsi(pnames, ref_at)
  streams[PS_DBI] = dbi_stream(sects, modsyms.len() - c13.len(), c13.len(), files)
  (msf(streams), made)
}

// ---------------------------------------------------------------------------
// The streams

/// The PDB info stream: version VC70, the signature (a time stamp's
/// place), age 1, the GUID, the named stream map (/names), and the
/// VC140 feature (the IPI stream is present).
fn info_stream(guid: Bytes, stamp: Int) -> Bytes {
  var w = new_out(64)
  w.u32(20000404)
  w.u32(stamp)
  w.u32(1)
  w.bytes(guid)
  // the map's string buffer, then its hash table: size 1, capacity 1,
  // the present bit vector (one word, bucket 0), no deleted words, and
  // the entry (the name's offset, the stream)
  w.u32(7)
  w.bytes(b"/names\0")
  w.u32(1)
  w.u32(1)
  w.u32(1)
  w.u32(1)
  w.u32(0)
  w.u32(0)
  w.u32(PS_NAMES)
  w.u32(20140508)
  w.done()
}

/// A TPI or IPI stream with no records: its header (version V80, the
/// first and end type index 0x1000, no hash stream).
fn tpi_stream() -> Bytes {
  var w = new_out(56)
  w.u32(20040203)
  w.u32(56)
  w.u32(0x1000)
  w.u32(0x1000)
  w.u32(0)
  w.u16(0xffff)
  w.u16(0xffff)
  w.u32(4)
  w.u32(0x3ffff)
  w.zeros(24)
  w.done()
}

/// The /names string table of strs: its header (signature, hash version
/// 1, the strings' size), the strings (the empty one first), the hash
/// table (each string's offset at hash_v1 % buckets, the next free
/// bucket on a collision; 0 is empty), and the count of names; and each
/// string's offset.
fn names_table(strs: List[Str]) -> (Bytes, List[Int]) {
  var buf = new_out(64)
  buf.u8(0)
  var at: List[Int] = []
  for s in strs {
    at.push(buf.n)
    buf.bytes(cstr_bytes(s))
  }
  let data = buf.done()
  let nb = if strs.is_empty() { 1 } else { 2 * strs.len() + 1 }
  var buckets: List[Int] = []
  for _ in 0..nb {
    buckets.push(0)
  }
  for (i, s) in strs.indexed() {
    var k = hash_v1(s) % nb
    while buckets[k] != 0 {
      k = (k + 1) % nb
    }
    buckets[k] = at[i]
  }
  var w = new_out(24 + data.len() + 4 * nb)
  w.u32(0xeffeeffe)
  w.u32(1)
  w.u32(data.len())
  w.bytes(data)
  w.u32(nb)
  for x in buckets {
    w.u32(x)
  }
  w.u32(strs.len())
  (w.done(), at)
}

/// The module's C13 line information: the file checksums subsection
/// (each file's /names offset, no checksum) and a lines subsection per
/// function with rows (its offset, segment and size, then a block per
/// run of rows in one file: the file's checksum entry, the rows' offsets
/// and lines with the statement bit).
fn c13_lines(lines: Bytes, fidx: Map[Int, Int], name_at: List[Int], inlinees: List[(Str, Int, Int)]) -> Bytes {
  var w = new_out(1024)
  var ck = new_out(8 * name_at.len())
  for off in name_at {
    ck.u32(off)
    ck.u8(0)
    ck.u8(0)
    ck.u16(0)
  }
  subsection(w, DEBUG_S_FILECHKSMS, ck.done())
  if !inlinees.is_empty() {
    // the inlinees' source lines: the signature (0), then each one's
    // LF_FUNC_ID, file (its checksum entry) and first line
    var il = new_out(4 + 12 * inlinees.len())
    il.u32(0)
    for (i, (_, f, l)) in inlinees.indexed() {
      il.u32(0x1000 + i)
      il.u32(8 * (fidx.get(f) ?? 0))
      il.u32(l)
    }
    subsection(w, DEBUG_S_INLINEELINES, il.done())
  }
  w.bytes(lines)
  w.done()
}

/// The DEBUG_S_LINES subsections of procs (c13_lines'), each a multiple
/// of 4 bytes: a run of procedures' depends only on them and fidx.
fn proc_lines(procs: List[PdbProc], fidx: Map[Int, Int]) -> Bytes {
  var w = new_out(1024)
  for p in procs {
    if p.rows.is_empty() {
      continue
    }
    var b = new_out(16 + 12 * p.rows.len())
    b.u32(p.off)
    b.u16(p.seg)
    b.u16(0)
    b.u32(p.size)
    var i = 0
    while i < p.rows.len() {
      let f = p.rows[i].1
      var j = i
      while j < p.rows.len() && p.rows[j].1 == f {
        j += 1
      }
      b.u32(8 * (fidx.get(f) ?? 0))
      b.u32(j - i)
      b.u32(12 + 8 * (j - i))
      for k in i..j {
        let (off, _, line, stmt) = p.rows[k]
        b.u32(off)
        b.u32((line & 0xffffff) | (if stmt { 0x80000000 } else { 0 }))
      }
      i = j
    }
    subsection(w, DEBUG_S_LINES, b.done())
  }
  w.done()
}

/// A C13 subsection: its kind, length and data, padded to 4 bytes.
fn subsection(var w: Out, kind: Int, data: Bytes) {
  w.u32(kind)
  w.u32(data.len())
  w.bytes(data)
  w.pad(4)
}

/// An empty string table (the DBI's EC names): the header, the empty
/// string, a one bucket hash table and no names.
fn names_stream() -> Bytes {
  var w = new_out(32)
  w.u32(0xeffeeffe)
  w.u32(1)
  w.u32(1)
  w.u8(0)
  w.u32(1)
  w.u32(0)
  w.u32(0)
  w.done()
}

/// A symbol record: its length (after the length field, padded to 4
/// bytes), kind and body.
fn sym_record(var w: Out, kind: Int, body: Bytes) {
  let len = 2 + body.len()
  let padded = (len + 2 + 3) / 4 * 4 - 2
  w.u16(padded)
  w.u16(kind)
  w.bytes(body)
  w.zeros(padded - len)
}

fn cstr_bytes(s: Str) -> Bytes {
  var b = BytesBuilder.new()
  b.write(s.bytes())
  b.write_byte(0)
  b.freeze()
}

/// The module's stream: the CodeView signature (4, C13), S_OBJNAME, and
/// each function's S_GPROC32, its inline sites (S_INLINESITE, nested as
/// the calls are, each closed by S_INLINESITE_END), and S_END; the C13
/// line information c13; the global references' size (0). Also each
/// S_GPROC32's offset. A procedure's and a site's parent and end are the
/// offsets of the enclosing record and of their closing one.
fn module_stream(recs: Bytes, c13: Bytes) -> Bytes {
  // the signature and S_OBJNAME (12 bytes), then the procedures' records
  // (proc_records from offset 16)
  var w = new_out(16 + recs.len() + c13.len() + 4)
  w.u32(4)
  rec_head(w, S_OBJNAME, 7)
  w.u32(0)
  w.bytes(cstr_bytes("xo"))
  w.zeros(rec_pad(7))
  w.bytes(recs)
  w.bytes(c13)
  w.u32(0)
  w.done()
}

/// The records of procs (module_stream's), the first at offset base of
/// the module stream: each procedure's and site's parent and end are
/// offsets in that stream. Also each S_GPROC32's offset. A run of
/// procedures' records depends only on them and base, so std's are the
/// same in every link from its half.
fn proc_records(procs: List[PdbProc], base: Int, fid: Map[Str, Int], inlinees: List[(Str, Int, Int)], fidx: Map[Int, Int]) -> (Bytes, List[Int]) {
  // Two passes over the same walk (2026-10-27: a body per record joined
  // at the end, and the procedures' and sites' copied again to put their
  // parent and end in front, were a fifth of the PDB's time). The first
  // finds each record's body size, the record holding its parent and its
  // closing record, so the second writes every record once, in place.
  // the records' count first, so the lists never grow (growth takes the
  // runtime's slow path while the link's other threads live)
  var nrec = 0
  var nsites = 0
  for p in procs {
    nrec += 2
    for l in p.locals {
      nrec += 1 + l.defs.len()
    }
    for st in p.sites {
      nrec += 2
      nsites += 1
      for l in st.locals {
        nrec += 1 + l.defs.len()
      }
    }
  }
  var sizes = List[Int].with_capacity(nrec)
  var parents = List[Int].with_capacity(nrec)
  var ends = List[Int].with_capacity(nrec)
  // each site's annotations, made once
  var anns = List[Bytes].with_capacity(nsites)
  var proc_rec = List[Int].with_capacity(procs.len())
  for p in procs {
    let pr = sizes.len()
    proc_rec.push(pr)
    // parent, end, next, code size, debug start and end, type, offset
    // (8 words), segment, flags, the name and its zero
    sizes.push(36 + p.name.len())
    parents.push(-1)
    ends.push(-1)
    for l in p.locals {
      local_sizes(l, sizes, parents, ends)
    }
    // the sites: a stack of open ones (site index, record)
    var open: List[(Int, Int)] = []
    for (si, st) in p.sites.indexed() {
      while !open.is_empty() && open[open.len() - 1].0 != st.parent {
        let (_, r) = open.pop() ?? (0, 0)
        ends[r] = sizes.len()
        sizes.push(0)
        parents.push(-1)
        ends.push(-1)
      }
      let enclosing = if open.is_empty() { pr } else { open[open.len() - 1].1 }
      let a = annotations(p.lo, st, inlinees[(fid.get(st.name) ?? 0x1000) - 0x1000], fidx)
      anns.push(a)
      let r = sizes.len()
      // parent, end, the inlinee, the annotations
      sizes.push(12 + a.len())
      parents.push(enclosing)
      ends.push(-1)
      open.push((si, r))
      for l in st.locals {
        local_sizes(l, sizes, parents, ends)
      }
    }
    while !open.is_empty() {
      let (_, r) = open.pop() ?? (0, 0)
      ends[r] = sizes.len()
      sizes.push(0)
      parents.push(-1)
      ends.push(-1)
    }
    ends[pr] = sizes.len()
    sizes.push(0)
    parents.push(-1)
    ends.push(-1)
  }
  // the records' offsets (from base)
  var offs = List[Int].with_capacity(sizes.len())
  var o = base
  for n in sizes {
    offs.push(o)
    o += (4 + n + 3) / 4 * 4
  }
  var w = new_out(o - base)
  var i = 0
  var ai = 0
  for p in procs {
    rec_head(w, S_GPROC32, sizes[i])
    w.u32(rec_off(offs, parents[i]))
    w.u32(rec_off(offs, ends[i]))
    w.u32(0)
    w.u32(p.size)
    w.u32(0)
    w.u32(p.size)
    w.u32(0)
    w.u32(p.off)
    w.u16(p.seg)
    w.u8(0)
    w.bytes(p.name.bytes())
    w.u8(0)
    w.zeros(rec_pad(sizes[i]))
    i += 1
    for l in p.locals {
      i = write_local(w, l, i)
    }
    var open: List[(Int, Int)] = []
    for (si, st) in p.sites.indexed() {
      while !open.is_empty() && open[open.len() - 1].0 != st.parent {
        let _o = open.pop()
        rec_head(w, S_INLINESITE_END, 0)
        i += 1
      }
      rec_head(w, S_INLINESITE, sizes[i])
      w.u32(rec_off(offs, parents[i]))
      w.u32(rec_off(offs, ends[i]))
      w.u32(fid.get(st.name) ?? 0)
      w.bytes(anns[ai])
      w.zeros(rec_pad(sizes[i]))
      ai += 1
      open.push((si, i))
      i += 1
      for l in st.locals {
        i = write_local(w, l, i)
      }
    }
    while !open.is_empty() {
      let _o = open.pop()
      rec_head(w, S_INLINESITE_END, 0)
      i += 1
    }
    rec_head(w, S_END, 0)
    i += 1
  }
  var at: List[Int] = []
  for r in proc_rec {
    at.push(offs[r])
  }
  (w.done(), at)
}

/// A symbol record's length and kind for a body of n bytes (sym_record's
/// header).
fn rec_head(var w: Out, kind: Int, n: Int) {
  w.u16((2 + n + 2 + 3) / 4 * 4 - 2)
  w.u16(kind)
}

/// Record i's offset (0 for none, -1).
fn rec_off(offs: List[Int], i: Int) -> Int {
  if i >= 0 { offs[i] } else { 0 }
}

/// The zeros after a body of n bytes (sym_record's padding).
fn rec_pad(n: Int) -> Int {
  (2 + n + 2 + 3) / 4 * 4 - 2 - (2 + n)
}

/// The sizes of a local's records (S_LOCAL: its type, flags, a
/// parameter 1, its name; then its S_DEFRANGEs), for module_stream's
/// first pass.
fn local_sizes(l: PdbLocal, var sizes: List[Int], var parents: List[Int], var ends: List[Int]) {
  // type, flags, the name and its zero
  sizes.push(7 + l.name.len())
  parents.push(-1)
  ends.push(-1)
  for (_, b) in l.defs {
    sizes.push(b.len())
    parents.push(-1)
    ends.push(-1)
  }
}

/// A local's records written in place; the next record's index.
fn write_local(var w: Out, l: PdbLocal, i: Int) -> Int {
  let n = 7 + l.name.len()
  rec_head(w, S_LOCAL, n)
  w.u32(l.ty)
  w.u16(if l.param { 1 } else { 0 })
  w.bytes(l.name.bytes())
  w.u8(0)
  w.zeros(rec_pad(n))
  var j = i + 1
  for (k, b) in l.defs {
    if l.seg > 0 {
      def_record_moved(w, k, b, l.delta, l.seg)
    } else {
      sym_record(w, k, b)
    }
    j += 1
  }
  j
}

/// sym_record of a def's record (cv_locals_at) moved by delta bytes in
/// its section, which is seg (its section offset and section rewritten),
/// with no copy of b.
fn def_record_moved(var w: Out, kind: Int, b: Bytes, delta: Int, seg: Int) {
  let at = if kind == S_DEFRANGE_REGISTER { 4 } else { 8 }
  let len = 2 + b.len()
  let padded = (len + 2 + 3) / 4 * 4 - 2
  w.u16(padded)
  w.u16(kind)
  for i in 0..at {
    w.u8(Int(b[i]))
  }
  w.u32((le_b(b, at, 4) + delta) & 0xffffffff)
  w.u16(seg)
  for i in at + 6..b.len() {
    w.u8(Int(b[i]))
  }
  w.zeros(padded - len)
}

/// An inline site's binary annotations, as LLVM's MCCodeView encodes
/// them: from the function's start, the inlinee's first file and line
/// (inl), each entry a code offset and line delta (one combined op when
/// both are small), a file change before an entry in another file, and
/// each range's end as its code length; zeros to 4 bytes.
fn annotations(flo: Int, st: PdbSite, inl: (Str, Int, Int), fidx: Map[Int, Int]) -> Bytes {
  var w = new_out(8 + 4 * st.entries.len())
  let (_, f0, l0) = inl
  var cur_off = 0
  var cur_line = l0
  var cur_file = f0
  var ei = 0
  var first = true
  for (rlo, rhi) in st.ranges {
    var any = false
    while ei < st.entries.len() && st.entries[ei].0 < rhi {
      let (addr, file, line) = st.entries[ei]
      ei += 1
      if addr < rlo {
        continue
      }
      any = true
      if file != cur_file {
        ba_op(w, BA_FILE)
        ba_op(w, 8 * (fidx.get(file) ?? 0))
        cur_file = file
      }
      let ld = line - cur_line
      let enc = if ld >= 0 { ld << 1 } else { ((0 - ld) << 1) | 1 }
      let cd = addr - flo - cur_off
      if enc < 8 && cd <= 15 {
        ba_op(w, BA_CODE_AND_LINE)
        ba_op(w, (enc << 4) | cd)
      } else {
        // the first entry's line even when unchanged: LLVM's reader
        // (NativeInlineSiteSymbol::getLineOffset) takes a site's line from
        // its first line operation, and skips a frame without one
        if ld != 0 || first {
          ba_op(w, BA_LINE_OFFSET)
          ba_op(w, enc)
        }
        ba_op(w, BA_CODE_OFFSET)
        ba_op(w, cd)
      }
      cur_line = line
      cur_off = addr - flo
      first = false
    }
    if any {
      ba_op(w, BA_CODE_LENGTH)
      ba_op(w, rhi - flo - cur_off)
      cur_off = rhi - flo
    }
  }
  w.pad(4)
  w.done()
}

/// A binary annotation's compressed number: 1 byte under 0x80, 2 under
/// 0x4000, else 4, big endian with the length in the top bits.
fn ba_op(var w: Out, v: Int) {
  if v < 0x80 {
    w.u8(v)
  } else if v < 0x4000 {
    w.u8((v >> 8) | 0x80)
    w.u8(v & 0xff)
  } else {
    w.u8(((v >> 24) & 0x1f) | 0xc0)
    w.u8((v >> 16) & 0xff)
    w.u8((v >> 8) & 0xff)
    w.u8(v & 0xff)
  }
}

/// The IPI stream of the inlinees' LF_FUNC_ID records (no parent scope,
/// no type), its header naming the hash stream, and the hash stream: each
/// record's JamCRC (LLVM hashTypeRecord) modulo the buckets, then the
/// index offsets (the first record's).
fn ipi_stream(inlinees: List[(Str, Int, Int)]) -> (Bytes, Bytes) {
  var recs = new_out(32 * inlinees.len())
  var hashes: List[Int] = []
  for (name, _, _) in inlinees {
    var r = new_out(16 + name.len())
    r.u32(0)
    r.u32(0)
    r.bytes(cstr_bytes(name))
    // LF_PAD bytes (0xf0 plus the bytes left) to 4
    let len = 2 + r.n
    let padded = (len + 2 + 3) / 4 * 4 - 2
    var whole = new_out(padded + 2)
    whole.u16(padded)
    whole.u16(LF_FUNC_ID)
    whole.bytes(r.done())
    var left = padded - len
    while left > 0 {
      whole.u8(0xf0 + left)
      left -= 1
    }
    let rec = whole.done()
    hashes.push(jam_crc(rec) % 0x3ffff)
    recs.bytes(rec)
  }
  let body = recs.done()
  var h = new_out(4 * hashes.len() + 8)
  for x in hashes {
    h.u32(x)
  }
  if !hashes.is_empty() {
    h.u32(0x1000)
    h.u32(0)
  }
  let hash = h.done()
  var w = new_out(56 + body.len())
  w.u32(20040203)
  w.u32(56)
  w.u32(0x1000)
  w.u32(0x1000 + inlinees.len())
  w.u32(body.len())
  w.u16(if hashes.is_empty() { 0xffff } else { PS_IPIHASH })
  w.u16(0xffff)
  w.u32(4)
  w.u32(0x3ffff)
  // hash values, index offsets, hash adjusters: offset and length each
  w.u32(0)
  w.u32(4 * hashes.len())
  w.u32(4 * hashes.len())
  w.u32(if hashes.is_empty() { 0 } else { 8 })
  w.u32(hash.len())
  w.u32(0)
  w.bytes(body)
  (w.done(), hash)
}

/// CRC-32 (reflected, 0xedb88320) from 0 with no final inversion: LLVM's
/// JamCRC(0).
fn jam_crc(b: Bytes) -> Int {
  var crc = 0
  for x in b {
    crc = crc ^ Int(x)
    for _ in 0..8 {
      crc = if (crc & 1) != 0 { (crc >> 1) ^ 0xedb88320 } else { crc >> 1 }
    }
  }
  crc & 0xffffffff
}

/// The symbol record stream: each public's S_PUB32 (a function), then
/// each function's S_PROCREF (module 1, its S_GPROC32's offset); and the
/// offsets of both.
fn sym_records(procs: List[PdbProc], proc_at: List[Int], pubs: List[PdbProc]) -> (Bytes, List[Int], List[Int]) {
  var w = new_out(64 * (procs.len() + pubs.len()))
  var pub_at: List[Int] = []
  for p in pubs {
    pub_at.push(w.n)
    var b = new_out(16 + p.name.len())
    b.u32(2)
    b.u32(p.off)
    b.u16(p.seg)
    b.bytes(cstr_bytes(p.name))
    sym_record(w, S_PUB32, b.done())
  }
  var ref_at: List[Int] = []
  for (i, p) in procs.indexed() {
    ref_at.push(w.n)
    var b = new_out(16 + p.name.len())
    b.u32(0)
    b.u32(proc_at[i])
    b.u16(1)
    b.bytes(cstr_bytes(p.name))
    sym_record(w, S_PROCREF, b.done())
  }
  (w.done(), pub_at, ref_at)
}

/// The publics stream: its header (the GSI's size, the address map's),
/// the GSI of the publics, and the address map (their record offsets by
/// section and offset).
fn publics_stream(pubs: List[PdbProc], at: List[Int]) -> Bytes {
  var names: List[Str] = []
  var keyed: List[(Int, Int, Int)] = []
  for (i, p) in pubs.indexed() {
    names.push(p.name)
    keyed.push((p.seg, p.off, i))
  }
  let hash = gsi(names, at)
  var w = new_out(28 + hash.len() + 4 * pubs.len())
  w.u32(hash.len())
  w.u32(4 * pubs.len())
  w.zeros(20)
  w.bytes(hash)
  for (_, _, i) in keyed.sort() {
    w.u32(at[i])
  }
  w.done()
}

/// The GSI hash of records named names at offsets at: its header, the
/// hash records (offset + 1, a reference count of 1) by bucket
/// (hash_v1 % 4096), each bucket's in gsi_less order, the bitmap of the
/// buckets in use, and each used bucket's first record (times 12, the
/// size of the old in-memory record).
fn gsi(names: List[Str], at: List[Int]) -> Bytes {
  var buckets: List[List[Int]] = []
  for _ in 0..4096 {
    buckets.push([])
  }
  for (i, n) in names.indexed() {
    let k = hash_v1(n) % 4096
    buckets[k].push(i)
  }
  var order: List[Int] = []
  var starts: List[Int] = []
  var used: List[Bool] = []
  for k in 0..4096 {
    var l = buckets[k]
    // insertion sort by gsi_less: buckets hold few records
    var j = 1
    while j < l.len() {
      var m = j
      while m > 0 && gsi_less(names[l[m]], names[l[m - 1]]) {
        let t = l[m]
        l[m] = l[m - 1]
        l[m - 1] = t
        m -= 1
      }
      j += 1
    }
    buckets[k] = l
    used.push(!l.is_empty())
    if !l.is_empty() {
      starts.push(order.len())
    }
    for i in l {
      order.push(i)
    }
  }
  let bitmap_words = (4096 + 1 + 31) / 32
  var w = new_out(16 + 8 * order.len() + 4 * bitmap_words + 4 * starts.len())
  w.u32(0xffffffff)
  w.u32(0xeffe0000 + 19990810)
  w.u32(8 * order.len())
  w.u32(4 * bitmap_words + 4 * starts.len())
  for i in order {
    w.u32(at[i] + 1)
    w.u32(1)
  }
  for wi in 0..bitmap_words {
    var v = 0
    for bit in 0..32 {
      let k = 32 * wi + bit
      if k < 4096 && used[k] {
        v = v | (1 << bit)
      }
    }
    w.u32(v)
  }
  for s in starts {
    w.u32(12 * s)
  }
  w.done()
}

/// The PDB's string hash (LLVM hashStringV1): the name's little endian
/// words, a 2 byte and a 1 byte rest xored, lowered, folded.
pub fn hash_v1(s: Str) -> Int {
  let b = s.bytes()
  var r = 0
  var i = 0
  while i + 4 <= b.len() {
    r = r ^ (Int(b[i]) | (Int(b[i + 1]) << 8) | (Int(b[i + 2]) << 16) | (Int(b[i + 3]) << 24))
    i += 4
  }
  if b.len() - i >= 2 {
    r = r ^ (Int(b[i]) | (Int(b[i + 1]) << 8))
    i += 2
  }
  if b.len() - i == 1 {
    r = r ^ Int(b[i])
  }
  r = r | 0x20202020
  r = r ^ (r >> 11)
  (r ^ (r >> 16)) & 0xffffffff
}

/// The GSI bucket order (LLVM gsiRecordCmp): a shorter name first, then
/// ASCII names case insensitively, else by bytes.
fn gsi_less(a: Str, b: Str) -> Bool {
  if a.len() != b.len() {
    return a.len() < b.len()
  }
  let x = a.bytes()
  let y = b.bytes()
  var ascii = true
  for c in x {
    ascii = ascii && c < 128
  }
  for c in y {
    ascii = ascii && c < 128
  }
  for k in 0..x.len() {
    var p = Int(x[k])
    var q = Int(y[k])
    if ascii {
      p = lower(p)
      q = lower(q)
    }
    if p != q {
      return p < q
    }
  }
  false
}

fn lower(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// The DBI stream: its header, the one module's entry, the section
/// contributions (the module's: the first code section), the section
/// map, the file info (the module's files), the EC names, and the
/// optional debug header (the section header stream).
fn dbi_stream(sects: List[PdbSect], symsize: Int, c13size: Int, files: List[Str]) -> Bytes {
  // the module: its first code section
  var text = 0
  for (i, s) in sects.indexed() {
    if text == 0 && (s.chars & 0x20000000) != 0 {
      text = i + 1
    }
  }
  let tsize = if text > 0 { sects[text - 1].vsize } else { 0 }
  let tchars = if text > 0 { sects[text - 1].chars } else { 0 }
  var mi = new_out(128)
  mi.u32(0)
  contrib(mi, text, tsize, tchars)
  mi.u16(0)
  mi.u16(PS_MOD)
  // the symbols' size with the signature (the stream less the C13 data
  // and the global references' size), no C11 lines, the C13's, the files
  mi.u32(symsize - 4)
  mi.u32(0)
  mi.u32(c13size)
  mi.u16(files.len())
  mi.u16(0)
  mi.u32(0)
  mi.u32(0)
  mi.u32(0)
  mi.bytes(cstr_bytes("xo"))
  mi.bytes(cstr_bytes("xo"))
  mi.pad(4)
  let modi = mi.done()
  var sc = new_out(32)
  sc.u32(0xeffe0000 + 19970605)
  contrib(sc, text, tsize, tchars)
  let scs = sc.done()
  // the section map: each section, then the absolute entry
  var sm = new_out(4 + 20 * (sects.len() + 1))
  sm.u16(sects.len() + 1)
  sm.u16(sects.len() + 1)
  for (i, s) in sects.indexed() {
    var fl = 0x108
    if (s.chars & 0x40000000) != 0 {
      fl = fl | 1
    }
    if (s.chars & 0x80000000) != 0 {
      fl = fl | 2
    }
    if (s.chars & 0x20000000) != 0 {
      fl = fl | 4
    }
    sm.u16(fl)
    sm.u16(0)
    sm.u16(0)
    sm.u16(i + 1)
    sm.u16(0xffff)
    sm.u16(0xffff)
    sm.u32(0)
    sm.u32(s.vsize)
  }
  sm.u16(0x208)
  sm.u16(0)
  sm.u16(0)
  sm.u16(sects.len() + 1)
  sm.u16(0xffff)
  sm.u16(0xffff)
  sm.u32(0)
  sm.u32(0xffffffff)
  let smap = sm.done()
  // the file info: one module, its files (their names' offsets, then
  // the names)
  var nb = new_out(64)
  var noff: List[Int] = []
  for f in files {
    noff.push(nb.n)
    nb.bytes(cstr_bytes(f))
  }
  var fi = new_out(8 + 4 * files.len() + nb.n)
  fi.u16(1)
  fi.u16(files.len() & 0xffff)
  fi.u16(0)
  fi.u16(files.len() & 0xffff)
  for o in noff {
    fi.u32(o)
  }
  fi.bytes(nb.done())
  fi.pad(4)
  let finfo = fi.done()
  // the optional debug header: FPO, exception, fixup, omap to and from,
  // section headers, token map, xdata, pdata, new FPO, original headers
  var dh = new_out(22)
  for k in 0..11 {
    dh.u16(if k == 5 { PS_SECTHDR } else { 0xffff })
  }
  let dbg = dh.done()
  // the EC names (a string table, as /names: the module's PDB file name
  // index 0 is its empty string)
  let ec = names_stream()
  var w = new_out(64 + modi.len() + scs.len() + smap.len() + finfo.len() + ec.len() + dbg.len())
  w.u32(0xffffffff)
  w.u32(19990903)
  w.u32(1)
  w.u16(PS_GLOBALS)
  // build number: the new format, version 14.0
  w.u16(0x8e00)
  w.u16(PS_PUBLICS)
  w.u16(0)
  w.u16(PS_SYMS)
  w.u16(0)
  w.u32(modi.len())
  w.u32(scs.len())
  w.u32(smap.len())
  w.u32(finfo.len())
  w.u32(0)
  w.u32(0)
  w.u32(dbg.len())
  w.u32(ec.len())
  w.u16(0)
  w.u16(0x8664)
  w.u32(0)
  w.bytes(modi)
  w.bytes(scs)
  w.bytes(smap)
  w.bytes(finfo)
  w.bytes(ec)
  w.bytes(dbg)
  w.done()
}

/// A section contribution of module 0: the section, offset 0, size and
/// characteristics, no CRCs.
fn contrib(var w: Out, sect: Int, size: Int, chars: Int) {
  w.u16(sect)
  w.u16(0)
  w.u32(0)
  w.u32(size)
  w.u32(chars)
  w.u16(0)
  w.u16(0)
  w.u32(0)
  w.u32(0)
}

// ---------------------------------------------------------------------------
// The MSF container

/// Whether block i is a free block map's (blocks 1 and 2 of every 4096).
fn fpm_block(i: Int) -> Bool { i % PDB_BLOCK == 1 || i % PDB_BLOCK == 2 }

/// The first block from i on that is not a free block map's.
fn free_from(i: Int) -> Int {
  var k = i
  while fpm_block(k) {
    k += 1
  }
  k
}

/// The MSF file of streams: the superblock (block 0), the free block
/// maps, each stream's blocks, the stream directory, and the block
/// holding the directory's block numbers.
fn msf(streams: List[Bytes]) -> Bytes {
  var next = 3
  var blocks: List[List[Int]] = []
  for s in streams {
    var l: List[Int] = []
    for _ in 0..(s.len() + PDB_BLOCK - 1) / PDB_BLOCK {
      next = free_from(next)
      l.push(next)
      next += 1
    }
    blocks.push(l)
  }
  var d = new_out(4 + 8 * streams.len())
  d.u32(streams.len())
  for s in streams {
    d.u32(s.len())
  }
  for l in blocks {
    for k in l {
      d.u32(k)
    }
  }
  let dir = d.done()
  var dir_blocks: List[Int] = []
  for _ in 0..(dir.len() + PDB_BLOCK - 1) / PDB_BLOCK {
    next = free_from(next)
    dir_blocks.push(next)
    next += 1
  }
  let map_block = free_from(next)
  let nblocks = map_block + 1
  var file: List[Bytes] = []
  for _ in 0..nblocks {
    file.push(b"")
  }
  var sb = new_out(PDB_BLOCK)
  // the magic: "Microsoft C/C++ MSF 7.00\r\n", 0x1a, "DS", three zeros
  sb.bytes("Microsoft C/C++ MSF 7.00".bytes())
  for c in [13, 10, 0x1a, 68, 83, 0, 0, 0] {
    sb.u8(c)
  }
  sb.u32(PDB_BLOCK)
  sb.u32(1)
  sb.u32(nblocks)
  sb.u32(dir.len())
  sb.u32(0)
  sb.u32(map_block)
  file[0] = sb.done()
  // the free block map (bit set: free): every block below nblocks used;
  // byte j of the map is in interval j / 4096's first map block
  let intervals = (nblocks + PDB_BLOCK - 1) / PDB_BLOCK
  for iv in 0..intervals {
    var m = BytesBuilder.with_capacity(PDB_BLOCK)
    for j in 0..PDB_BLOCK {
      var v = 0
      for bit in 0..8 {
        if 8 * (PDB_BLOCK * iv + j) + bit >= nblocks {
          v = v | (1 << bit)
        }
      }
      m.write_byte(UInt8(v))
    }
    let fm = m.freeze()
    if PDB_BLOCK * iv + 1 < nblocks {
      file[PDB_BLOCK * iv + 1] = fm
    }
    if PDB_BLOCK * iv + 2 < nblocks {
      file[PDB_BLOCK * iv + 2] = fm
    }
  }
  for (si, l) in blocks.indexed() {
    for (k, blk) in l.indexed() {
      let a = PDB_BLOCK * k
      let e = if a + PDB_BLOCK < streams[si].len() { a + PDB_BLOCK } else { streams[si].len() }
      file[blk] = streams[si][a..e]
    }
  }
  for (k, blk) in dir_blocks.indexed() {
    let a = PDB_BLOCK * k
    let e = if a + PDB_BLOCK < dir.len() { a + PDB_BLOCK } else { dir.len() }
    file[blk] = dir[a..e]
  }
  var mb = new_out(4 * dir_blocks.len())
  for k in dir_blocks {
    mb.u32(k)
  }
  file[map_block] = mb.done()
  var w = BytesBuilder.with_capacity(PDB_BLOCK * nblocks)
  var zb = BytesBuilder.with_capacity(PDB_BLOCK)
  for _ in 0..PDB_BLOCK {
    zb.write_byte(0)
  }
  let zero = zb.freeze()
  for blk in file {
    w.write(blk)
    if blk.len() < PDB_BLOCK {
      w.write(zero[0..PDB_BLOCK - blk.len()])
    }
  }
  w.freeze()
}
