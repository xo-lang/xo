// Unwind information from the .cfi_ directives, as LLVM's MC layer
// writes it for arm64 Mach-O: a __LD,__compact_unwind entry per
// function, and an __TEXT,__eh_frame CIE and FDE for each function whose
// compact encoding is DWARF mode.

/// Compact unwind modes and register pairs (mach-o/compact_unwind_encoding.h).
const UNWIND_ARM64_MODE_FRAMELESS = 0x02000000
const UNWIND_ARM64_MODE_DWARF = 0x03000000
const UNWIND_ARM64_MODE_FRAME = 0x04000000
const UNWIND_X86_64_MODE_RBP_FRAME = 0x01000000
const UNWIND_X86_64_MODE_DWARF = 0x04000000

/// The DWARF register number of a .cfi_ register operand: x and w n,
/// sp 31, d n 64 + n.
fn dwarf_reg(b: Bytes) -> Int {
  let (n, k) = reg(b)
  if k == RX || k == RW {
    return n
  }
  if k == RSP {
    return 31
  }
  if k == RD || k == RS {
    return 64 + n
  }
  -1
}

fn (var a: Asm) cfi(d: Str, rest: Bytes) {
  if a.cur < 0 || !a.sects[a.cur].code {
    a.fail("${d} outside __text")
    return
  }
  let here = a.code_len(a.cur)
  if d == ".cfi_startproc" {
    if a.open {
      a.fail("nested .cfi_startproc")
      return
    }
    a.open = true
    a.frame = Frame{sect: a.cur, start: here, atom: a.sects[a.cur].last_atom}
    // x86-64: the CFA is %rsp + 8 at entry (the return address)
    a.cfa_off = 8
    return
  }
  if !a.open {
    a.fail("${d} outside .cfi_startproc")
    return
  }
  let ops = split_operands(rest)
  match d {
    ".cfi_endproc" => {
      a.frame.end = here
      a.frames.push(a.frame)
      a.open = false
    }
    ".cfi_def_cfa_offset" | ".cfi_adjust_cfa_offset" => {
      let off = parse_int(rest) ?? MIN_INT
      if off == MIN_INT {
        return a.fail("bad ${d} ${bstr(rest)}")
      }
      a.cfa_off = if d == ".cfi_def_cfa_offset" { off } else { a.cfa_off + off }
      a.frame.insts.push(Cfi{at: here, op: 2, reg: 0, off: a.cfa_off})
    }
    ".cfi_escape" => {
      var raw: List[Int] = []
      for o in ops {
        let v = parse_int(o) ?? -1
        if v < 0 || v > 255 {
          return a.fail("bad ${d} ${bstr(rest)}")
        }
        raw.push(v)
      }
      a.frame.insts.push(Cfi{raw: raw, at: here, op: 5, reg: 0, off: 0})
    }
    ".cfi_restore" => {
      let r = if a.amd64 { x86_dwarf_reg(trim(rest)) } else { dwarf_reg(trim(rest)) }
      if r < 0 {
        return a.fail("bad ${d} ${bstr(rest)}")
      }
      a.frame.insts.push(Cfi{at: here, op: 4, reg: r, off: 0})
    }
    ".cfi_def_cfa_register" => {
      let r = if a.amd64 { x86_dwarf_reg(trim(rest)) } else { dwarf_reg(trim(rest)) }
      if r < 0 {
        return a.fail("bad ${d} ${bstr(rest)}")
      }
      a.frame.insts.push(Cfi{at: here, op: 3, reg: r, off: 0})
    }
    ".cfi_def_cfa" | ".cfi_offset" => {
      if ops.len() != 2 {
        return a.fail("${d} takes a register and an offset")
      }
      let r = if a.amd64 { x86_dwarf_reg(ops[0]) } else { dwarf_reg(ops[0]) }
      let off = parse_int(ops[1]) ?? MIN_INT
      if r < 0 || off == MIN_INT {
        return a.fail("bad ${d} ${bstr(rest)}")
      }
      if d == ".cfi_def_cfa" {
        a.cfa_off = off
      }
      a.frame.insts.push(Cfi{at: here, op: if d == ".cfi_def_cfa" { 0 } else { 1 }, reg: r, off: off})
    }
    ".cfi_personality" | ".cfi_lsda" => {
      if ops.len() != 2 {
        return a.fail("${d} takes an encoding and a symbol")
      }
      let enc = parse_int(ops[0]) ?? -1
      if enc < 0 || enc > 255 {
        return a.fail("bad ${d} encoding")
      }
      let s = a.sym(ops[1])
      if d == ".cfi_personality" {
        a.frame.pers = s
        a.frame.pers_enc = enc
      } else {
        a.frame.lsda = s
        a.frame.lsda_enc = enc
      }
    }
    _ => a.fail("unsupported directive ${d}")
  }
}

/// LLVM's AArch64 generateCompactUnwindEncoding: frame mode when the CFA
/// is fp with lr and fp saved at its base and callee saved pairs below
/// them, frameless with no directives, else DWARF mode; always DWARF
/// with a personality other than ___gxx_personality_v0.
fn (a: Asm) compact_encoding(f: Frame) -> Int {
  if a.amd64 {
    return a.x86_compact_encoding(f)
  }
  let ins = f.insts
  if ins.is_empty() {
    return UNWIND_ARM64_MODE_FRAMELESS
  }
  if f.pers >= 0 && bstr(a.syms[f.pers].name) != "___gxx_personality_v0" {
    return UNWIND_ARM64_MODE_DWARF
  }
  var enc = 0
  var cur = 0
  var has_fp = false
  var i = 0
  let e = ins.len()
  while i < e {
    let c = ins[i]
    if c.op == 0 {
      if c.reg != 29 || i + 2 >= e {
        return UNWIND_ARM64_MODE_DWARF
      }
      let lr = ins[i + 1]
      let fp = ins[i + 2]
      i += 2
      if lr.op != 1 || fp.op != 1 || fp.off + 8 != lr.off {
        return UNWIND_ARM64_MODE_DWARF
      }
      cur = fp.off
      if lr.reg != 30 || fp.reg != 29 {
        return UNWIND_ARM64_MODE_DWARF
      }
      enc = enc | UNWIND_ARM64_MODE_FRAME
      has_fp = true
    } else {
      // a pair of saved registers
      if i + 1 == e {
        return UNWIND_ARM64_MODE_DWARF
      }
      if cur != 0 && c.off != cur - 8 {
        return UNWIND_ARM64_MODE_DWARF
      }
      cur = c.off
      let c2 = ins[i + 1]
      i += 1
      if c2.op != 1 || c2.off != cur - 8 {
        return UNWIND_ARM64_MODE_DWARF
      }
      cur = c2.off
      let r1 = c.reg
      let r2 = c2.reg
      if r1 == 19 && r2 == 20 && (enc & 0xf1e) == 0 {
        enc = enc | 0x1
      } else if r1 == 21 && r2 == 22 && (enc & 0xf1c) == 0 {
        enc = enc | 0x2
      } else if r1 == 23 && r2 == 24 && (enc & 0xf18) == 0 {
        enc = enc | 0x4
      } else if r1 == 25 && r2 == 26 && (enc & 0xf10) == 0 {
        enc = enc | 0x8
      } else if r1 == 27 && r2 == 28 && (enc & 0xf00) == 0 {
        enc = enc | 0x10
      } else if r1 == 72 && r2 == 73 && (enc & 0xe00) == 0 {
        enc = enc | 0x100
      } else if r1 == 74 && r2 == 75 && (enc & 0xc00) == 0 {
        enc = enc | 0x200
      } else if r1 == 76 && r2 == 77 && (enc & 0x800) == 0 {
        enc = enc | 0x400
      } else if r1 == 78 && r2 == 79 {
        enc = enc | 0x800
      } else {
        return UNWIND_ARM64_MODE_DWARF
      }
    }
    i += 1
  }
  if !has_fp {
    // a frameless function with saved registers: not written by the
    // emitter; LLVM would encode the stack size of .cfi_def_cfa_offset
    return UNWIND_ARM64_MODE_DWARF
  }
  enc
}

/// Adds a section the unwind information fills (not laid out from items).
fn (var a: Asm) add_raw_section(seg: Str, name: Str, flags: Int, align: Int) -> Int {
  a.switch_section(seg, name, flags)
  let i = a.cur
  // the start symbol is the section's only label
  a.flush_pend()
  a.sects[i].items = []
  a.sects[i].align = align
  a.sects[i].raw = true
  i
}

/// The compact unwind and eh_frame sections, sized (the eh_frame filled:
/// its contents depend only on offsets within it).
fn (var a: Asm) unwind_sections() {
  if a.frames.is_empty() {
    return
  }
  for i in 0..a.frames.len() {
    a.frames[i].enc = a.compact_encoding(a.frames[i])
  }
  var ncu = 0
  for f in a.frames {
    if a.cu_entry(f) {
      ncu += 1
    }
  }
  if ncu > 0 {
    let cu = a.add_raw_section("__LD", "__compact_unwind", S_ATTR_DEBUG, 3)
    a.sects[cu].size = 32 * ncu
    a.cu_sect = cu
  }
  if a.amd64 {
    return a.x86_eh_frame()
  }
  var dwarf: List[Frame] = []
  for f in a.frames {
    if f.enc == UNWIND_ARM64_MODE_DWARF {
      dwarf.push(f)
    }
  }
  if dwarf.is_empty() {
    return
  }
  let eh = a.add_raw_section("__TEXT", "__eh_frame", S_COALESCED + S_ATTR_NO_TOC + S_ATTR_STRIP_STATIC_SYMS + S_ATTR_LIVE_SUPPORT, 3)
  a.eh_sect = eh
  // FDEs grouped by CIE (LLVM sorts them stably by the CIE key, no
  // personality first)
  let sorted = dwarf.sort_by(fn(f: Frame) -> Int { if f.pers < 0 { -1 } else { f.pers } })
  var o = new_out(64 * sorted.len())
  var relocs: List[Reloc] = []
  let ltmp = a.sects[eh].ltmp
  // the CIE of each (personality, lsda encoding), by offset
  var cies: Map[(Int, Int, Int), Int] = {}
  for f in sorted {
    let key = (f.pers, f.pers_enc, f.lsda_enc)
    var cie = -1
    match cies.get(key) {
      Some(c) => cie = c
      None => {
        cie = o.n
        cies.put(key, cie)
        a.write_cie(o, relocs, f)
      }
    }
    // the FDE
    var body = new_out(64)
    // CIE pointer: from this field back to the CIE
    let start = o.n
    body.u32(start + 4 - cie)
    // pc begin, pc relative: atom - (eh_frame + field) + offset
    let pc_field = start + 8
    var atom = f.atom
    if atom < 0 {
      atom = a.sects[f.sect].ltmp
    }
    let delta = f.start - a.syms[atom].off
    body.u64(delta - pc_field)
    relocs.push(Reloc{addr: pc_field, typ: R_SUBTRACTOR, pcrel: false, len: 3, sym: ltmp})
    relocs.push(Reloc{addr: pc_field, typ: R_UNSIGNED, pcrel: false, len: 3, sym: atom})
    a.syms[atom].used = true
    a.syms[ltmp].used = true
    body.u64(f.end - f.start)
    if f.lsda >= 0 {
      body.uleb(8)
      let lf = start + 4 + body.n
      body.u64(0 - lf)
      relocs.push(Reloc{addr: lf, typ: R_SUBTRACTOR, pcrel: false, len: 3, sym: ltmp})
      relocs.push(Reloc{addr: lf, typ: R_UNSIGNED, pcrel: false, len: 3, sym: f.lsda})
      a.syms[f.lsda].used = true
    } else {
      body.uleb(0)
    }
    cfa_insts(body, f, -8)
    // padded with DW_CFA_nop so the next entry is 8 byte aligned
    while (start + 4 + body.n) % 8 != 0 {
      body.u8(0)
    }
    o.u32(body.n)
    o.bytes(body.done())
  }
  a.sects[eh].bytes = o.done()
  a.sects[eh].size = a.sects[eh].bytes.len()
  a.sects[eh].relocs = relocs
}

/// The call frame instructions of f, each after an advance to its
/// offset; register offsets factored by the data alignment factor.
fn cfa_insts(var body: Out, f: Frame, factor: Int) {
  var loc = f.start
  for c in f.insts {
    let delta2 = c.at - loc
    if delta2 > 0 {
      if delta2 < 64 {
        body.u8(0x40 | delta2)
      } else if delta2 < 256 {
        body.u8(0x02)
        body.u8(delta2)
      } else if delta2 < 65536 {
        body.u8(0x03)
        body.u16(delta2)
      } else {
        body.u8(0x04)
        body.u32(delta2)
      }
      loc = c.at
    }
    if c.op == 0 {
      // DW_CFA_def_cfa
      body.u8(0x0c)
      body.uleb(c.reg)
      body.uleb(c.off)
    } else if c.op == 2 {
      // DW_CFA_def_cfa_offset
      body.u8(0x0e)
      body.uleb(c.off)
    } else if c.op == 3 {
      // DW_CFA_def_cfa_register
      body.u8(0x0d)
      body.uleb(c.reg)
    } else if c.op == 4 {
      // DW_CFA_restore
      body.u8(0xc0 | c.reg)
    } else if c.op == 5 {
      for v in c.raw {
        body.u8(v)
      }
    } else {
      let fo = c.off / factor
      if fo < 0 {
        // DW_CFA_offset_extended_sf
        body.u8(0x11)
        body.uleb(c.reg)
        body.sleb(fo)
      } else if c.reg < 64 {
        body.u8(0x80 | c.reg)
        body.uleb(fo)
      } else {
        // DW_CFA_offset_extended
        body.u8(0x05)
        body.uleb(c.reg)
        body.uleb(fo)
      }
    }
  }
}

/// A CIE: augmentation "zR", or "zPLR" (and "zPR", "zLR") with a
/// personality reached through the GOT and a pc relative LSDA.
fn (var a: Asm) write_cie(var o: Out, var relocs: List[Reloc], f: Frame) {
  var body = new_out(32)
  body.u32(0)
  body.u8(1)
  var aug = "z"
  if f.pers >= 0 {
    aug = aug + "P"
  }
  if f.lsda >= 0 {
    aug = aug + "L"
  }
  aug = aug + "R"
  body.bytes(aug.bytes())
  body.u8(0)
  // code alignment 1, data alignment -8, return address x30
  body.uleb(1)
  body.sleb(-8)
  body.uleb(30)
  var adata = new_out(16)
  var pers_at = -1
  if f.pers >= 0 {
    adata.u8(f.pers_enc)
    pers_at = adata.n
    adata.u32(0)
  }
  if f.lsda >= 0 {
    adata.u8(f.lsda_enc)
  }
  // the FDE pointers: pc relative, 8 bytes
  adata.u8(0x10)
  body.uleb(adata.n)
  let adata_at = body.n
  let ad = adata.done()
  body.bytes(ad)
  // DW_CFA_def_cfa sp, 0
  body.u8(0x0c)
  body.u8(31)
  body.u8(0)
  while (body.n + 4) % 4 != 0 {
    body.u8(0)
  }
  let start = o.n
  var bb = body.done()
  if pers_at >= 0 {
    // the personality: ARM64_RELOC_POINTER_TO_GOT, pc relative; the
    // field holds what LLVM writes (minus its offset, minus 2^30)
    let field = start + 4 + adata_at + pers_at
    relocs.push(Reloc{addr: field, typ: R_POINTER_TO_GOT, pcrel: true, len: 2, sym: f.pers})
    a.syms[f.pers].used = true
    var patched = new_out(bb.len())
    let v = (0 - field - 0x40000000) & 0xffffffff
    let at = adata_at + pers_at
    patched.bytes(bb[0..at])
    patched.u32(v)
    patched.bytes(bb[at + 4..])
    bb = patched.done()
  }
  o.u32(bb.len())
  o.bytes(bb)
}

/// The compact unwind entries, once the text address is known: start
/// (section relative), length, encoding, personality, LSDA.
fn (var a: Asm) unwind_relocs() {
  if a.cu_sect < 0 {
    return
  }
  if a.amd64 {
    a.x86_patch_eh_frame()
  }
  var o = new_out(32 * a.frames.len())
  var relocs: List[Reloc] = []
  for f in a.frames {
    if !a.cu_entry(f) {
      continue
    }
    let at = o.n
    o.u64(a.sects[f.sect].addr + f.start)
    relocs.push(Reloc{addr: at, typ: R_UNSIGNED, pcrel: false, len: 3, sym: f.sect + 1, sect: true})
    o.u32(f.end - f.start)
    o.u32(f.enc)
    if f.enc != a.dwarf_mode() && f.pers >= 0 {
      relocs.push(Reloc{addr: at + 16, typ: R_UNSIGNED, pcrel: false, len: 3, sym: f.pers})
      a.syms[f.pers].used = true
    }
    o.u64(0)
    if f.enc != a.dwarf_mode() && f.lsda >= 0 {
      relocs.push(Reloc{addr: at + 24, typ: R_UNSIGNED, pcrel: false, len: 3, sym: f.lsda})
      a.syms[f.lsda].used = true
    }
    o.u64(0)
  }
  a.sects[a.cu_sect].bytes = o.done()
  a.sects[a.cu_sect].relocs = relocs
}

/// The compact unwind mode that defers to DWARF.
fn (a: Asm) dwarf_mode() -> Int {
  if a.amd64 { UNWIND_X86_64_MODE_DWARF } else { UNWIND_ARM64_MODE_DWARF }
}

/// Whether frame f has a __compact_unwind entry: always on arm64; on
/// x86_64 not with encoding 0 and no personality or LSDA (a function
/// with no CFI instructions: its FDE alone describes it).
fn (a: Asm) cu_entry(f: Frame) -> Bool {
  !a.amd64 || f.enc != 0 || f.pers >= 0 || f.lsda >= 0
}

/// The compact register number of a DWARF x86_64 register (rbx 1, r12 to
/// r15 2 to 5, rbp 6), or -1.
fn x86_cu_reg(r: Int) -> Int {
  match r {
    3 => 1
    12 => 2
    13 => 3
    14 => 4
    15 => 5
    6 => 6
    _ => -1
  }
}

/// LLVM's X86 generateCompactUnwindEncoding for x86_64: an rbp frame
/// (push rbp, its offset, mov rsp to rbp, the pushed callee saved
/// registers next to it), 0 with no instructions, else DWARF (any other
/// directive, `.cfi_def_cfa` among them, and frames without rbp).
fn (a: Asm) x86_compact_encoding(f: Frame) -> Int {
  if f.insts.is_empty() {
    return 0
  }
  if f.pers >= 0 && bstr(a.syms[f.pers].name) != "___gxx_personality_v0" {
    return UNWIND_X86_64_MODE_DWARF
  }
  var saved: List[Int] = []
  var min_abs = 1 << 40
  var has_fp = false
  for c in f.insts {
    if c.op == 3 {
      if c.reg != 6 {
        return UNWIND_X86_64_MODE_DWARF
      }
      has_fp = true
      saved = []
      min_abs = 1 << 40
    } else if c.op == 2 {
      // the stack size: only a frameless function's
    } else if c.op == 1 {
      if saved.len() == 5 {
        return UNWIND_X86_64_MODE_DWARF
      }
      saved.push(c.reg)
      let ab = if c.off < 0 { 0 - c.off } else { c.off }
      min_abs = min_abs.min(ab)
    } else {
      return UNWIND_X86_64_MODE_DWARF
    }
  }
  if !has_fp {
    // frameless: the emitter makes none with saved registers
    return UNWIND_X86_64_MODE_DWARF
  }
  if !saved.is_empty() && min_abs != 24 {
    return UNWIND_X86_64_MODE_DWARF
  }
  var regs = 0
  for (i, r) in saved.indexed() {
    let n = x86_cu_reg(r)
    if n < 0 {
      return UNWIND_X86_64_MODE_DWARF
    }
    regs = regs | (n << (3 * i))
  }
  UNWIND_X86_64_MODE_RBP_FRAME | ((saved.len() & 0xff) << 16) | (regs & 0x7fff)
}

/// x86_64's __eh_frame, as LLVM writes it for Mach-O: an FDE for every
/// frame (in order), under one CIE per (personality, encodings); the pc
/// begin and LSDA fields pc relative and resolved in this object (no
/// relocations: ld64 reads the FDEs), so x86_patch_eh_frame fills them
/// once the sections have addresses. The personality's word is a GOT
/// relocation.
fn (var a: Asm) x86_eh_frame() {
  let eh = a.add_raw_section("__TEXT", "__eh_frame", S_COALESCED + S_ATTR_NO_TOC + S_ATTR_STRIP_STATIC_SYMS + S_ATTR_LIVE_SUPPORT, 3)
  a.eh_sect = eh
  var o = new_out(64 * a.frames.len())
  var relocs: List[Reloc] = []
  var cies: Map[(Int, Int, Int), Int] = {}
  // FDEs grouped by CIE: LLVM sorts them stably by the CIE key, no
  // personality first
  var idx: List[Int] = []
  for fi in 0..a.frames.len() {
    idx.push(fi)
  }
  let frames = a.frames
  let order = idx.sort_by(fn(i: Int) -> Int { if frames[i].pers < 0 { -1 } else { frames[i].pers } })
  for fi in order {
    let f = a.frames[fi]
    let key = (f.pers, f.pers_enc, f.lsda_enc)
    var cie = -1
    match cies.get(key) {
      Some(c) => cie = c
      None => {
        cie = o.n
        cies.put(key, cie)
        a.x86_write_cie(o, relocs, f)
      }
    }
    var body = new_out(64)
    let start = o.n
    body.u32(start + 4 - cie)
    a.frames[fi].pc_field = start + 8
    body.u64(0)
    body.u64(f.end - f.start)
    if f.lsda >= 0 {
      body.uleb(8)
      a.frames[fi].lsda_field = start + 4 + body.n
      body.u64(0)
    } else {
      body.uleb(0)
    }
    cfa_insts(body, f, -8)
    while (start + 4 + body.n) % 8 != 0 {
      body.u8(0)
    }
    o.u32(body.n)
    o.bytes(body.done())
  }
  a.sects[eh].bytes = o.done()
  a.sects[eh].size = a.sects[eh].bytes.len()
  a.sects[eh].relocs = relocs
}

/// An x86_64 CIE: "zR" (or with P and L), code alignment 1, data
/// alignment -8, return address 16 (rip), the CFA rsp + 8 and the return
/// address at CFA - 8.
fn (var a: Asm) x86_write_cie(var o: Out, var relocs: List[Reloc], f: Frame) {
  var body = new_out(32)
  body.u32(0)
  body.u8(1)
  var aug = "z"
  if f.pers >= 0 {
    aug = aug + "P"
  }
  if f.lsda >= 0 {
    aug = aug + "L"
  }
  aug = aug + "R"
  body.bytes(aug.bytes())
  body.u8(0)
  body.uleb(1)
  body.sleb(-8)
  body.uleb(16)
  var adata = new_out(16)
  var pers_at = -1
  if f.pers >= 0 {
    adata.u8(f.pers_enc)
    pers_at = adata.n
    // the GOT relocation's field: pc relative from the field's end, as
    // LLVM writes it (4)
    adata.u32(4)
  }
  if f.lsda >= 0 {
    adata.u8(f.lsda_enc)
  }
  adata.u8(0x10)
  body.uleb(adata.n)
  let adata_at = body.n
  body.bytes(adata.done())
  // DW_CFA_def_cfa rsp, 8; DW_CFA_offset rip, 1
  body.u8(0x0c)
  body.u8(7)
  body.u8(8)
  body.u8(0x90)
  body.u8(1)
  while (body.n + 4) % 4 != 0 {
    body.u8(0)
  }
  let start = o.n
  if pers_at >= 0 {
    let field = start + 4 + adata_at + pers_at
    relocs.push(Reloc{addr: field, typ: R_POINTER_TO_GOT, pcrel: true, len: 2, sym: f.pers})
    a.syms[f.pers].used = true
  }
  o.u32(body.n)
  o.bytes(body.done())
}

/// Fills the FDEs' pc begin and LSDA fields: the target's address less
/// the field's.
fn (var a: Asm) x86_patch_eh_frame() {
  if a.eh_sect < 0 {
    return
  }
  let eh = a.eh_sect
  let base = a.sects[eh].addr
  var b = a.sects[eh].bytes
  var o = new_out(b.len())
  var patches: List[(Int, Int)] = []
  for f in a.frames {
    if f.pc_field >= 0 {
      patches.push((f.pc_field, a.sects[f.sect].addr + f.start - (base + f.pc_field)))
    }
    if f.lsda_field >= 0 {
      let l = a.syms[f.lsda]
      patches.push((f.lsda_field, a.sects[l.sect].addr + l.off - (base + f.lsda_field)))
    }
  }
  let sorted = patches.sort_by(fn(p: (Int, Int)) -> Int { p.0 })
  var at = 0
  for (field, v) in sorted {
    o.bytes(b[at..field])
    o.u64(v)
    at = field + 8
  }
  o.bytes(b[at..b.len()])
  a.sects[eh].bytes = o.done()
}
