// Code size by cause (decision 0443): cause labels split each function's
// bytes, and change none of the object's.

fn causes_src(tags: Bool) -> Bytes {
  let t = fn(l: Str) -> Str { if tags { "${l}:\n" } else { "" } }
  var b = StrBuilder.new()
  b.write("\t.section __TEXT,__text,regular,pure_instructions\n\t.globl _f\n\t.p2align 2\n_f:\n")
  b.write(t("Lf1_x1_dc0"))
  b.write("\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n")
  b.write(t("Lf1_x0_dc1"))
  b.write("\tadd x0, x0, #1\n\tadd x0, x0, #2\n\tadd x0, x0, #3\n")
  b.write(t("Lf1_x6_dc2"))
  b.write("\tbl _xo_release\n")
  b.write(t("Lf1_x1_dc3"))
  b.write("\tldp x29, x30, [sp], #16\n\tret\n")
  b.write("\t.globl _g\n\t.p2align 2\n_g:\n\tret\n")
  b.write(t("Lf2_x4_dc0"))
  b.write("\tbl _xo_fault\n\tbrk #1\n")
  b.freeze().bytes()
}

test "the bytes of each function by cause" {
  let (_, rows) = assemble_causes(causes_src(true), false).or_fault("assemble")
  expect(rows) == "_f\t0\t12\n_f\t1\t16\n_f\t6\t4\n_g\t0\t4\n_g\t4\t8\n"
}

test "cause labels change no byte of the object" {
  let with = assemble(causes_src(true)).or_fault("with")
  let without = assemble(causes_src(false)).or_fault("without")
  expect(with == without) == true
}

test "only cause labels name a cause" {
  expect(cause_of_label("LnSf12_x6_dc40")) == 6
  expect(cause_of_label(".LnSf12_x10_dc0")) == 10
  expect(cause_of_label("LnSf12_el_x9_dc0")) == 9
  expect(cause_of_label("LnSf12_dl4")) == -1
  expect(cause_of_label("LnSf12_x6_dc")) == -1
  expect(cause_of_label("LnSf12_x_dc4")) == -1
}
