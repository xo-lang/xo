// Little endian output: the bytes of object files and their parts.

struct Out {
  b: BytesBuilder
  n: Int = 0
}

fn new_out(cap: Int) -> Out {
  Out{b: BytesBuilder.with_capacity(cap)}
}

fn (var o: Out) u8(v: Int) {
  o.b.write_byte(UInt8(v & 255))
  o.n += 1
}

/// v as n little endian bytes.
fn (var o: Out) le(v: Int, n: Int) {
  for i in 0..n {
    o.b.write_byte(UInt8((v >> (8 * i)) & 255))
  }
  o.n += n
}

fn (var o: Out) u16(v: Int) {
  o.le(v, 2)
}

fn (var o: Out) u32(v: Int) {
  o.b.write_byte(UInt8(v & 255))
  o.b.write_byte(UInt8((v >> 8) & 255))
  o.b.write_byte(UInt8((v >> 16) & 255))
  o.b.write_byte(UInt8((v >> 24) & 255))
  o.n += 4
}

fn (var o: Out) u64(v: Int) {
  o.le(v, 8)
}

/// v as a big endian 32 bit word (code signatures).
fn (var o: Out) be32(v: Int) {
  o.b.write_byte(UInt8((v >> 24) & 255))
  o.b.write_byte(UInt8((v >> 16) & 255))
  o.b.write_byte(UInt8((v >> 8) & 255))
  o.b.write_byte(UInt8(v & 255))
  o.n += 4
}

fn (var o: Out) be64(v: Int) {
  o.be32((v >> 32) & 0xffffffff)
  o.be32(v & 0xffffffff)
}

fn (var o: Out) bytes(d: Bytes) {
  o.b.write(d)
  o.n += d.len()
}

/// s padded with zeros to n bytes (segment and section names).
fn (var o: Out) name(s: Str, n: Int) {
  let d = s.bytes()
  for i in 0..n {
    o.b.write_byte(if i < d.len() { d[i] } else { 0 })
  }
  o.n += n
}

fn (var o: Out) zeros(n: Int) {
  for _ in 0..n {
    o.b.write_byte(0)
  }
  o.n += n
}

/// Zeros up to a multiple of al.
fn (var o: Out) pad(al: Int) {
  while o.n % al != 0 {
    o.b.write_byte(0)
    o.n += 1
  }
}

/// v as a ULEB128; the number of bytes.
fn (var o: Out) uleb(v: Int) -> Int {
  var x = v
  var k = 0
  while {
    let byte = x & 127
    x = lsr(x, 7)
    k += 1
    if x == 0 {
      o.u8(byte)
      return k
    }
    o.u8(byte | 128)
  }
}

/// v as a SLEB128; the number of bytes.
fn (var o: Out) sleb(v: Int) -> Int {
  var x = v
  var k = 0
  while {
    let byte = x & 127
    x = x >> 7
    k += 1
    if (x == 0 && (byte & 64) == 0) || (x == -1 && (byte & 64) != 0) {
      o.u8(byte)
      return k
    }
    o.u8(byte | 128)
  }
}

fn (var o: Out) done() -> Bytes {
  o.b.freeze()
}

/// A change to a section's bytes: n little endian bytes of v at offset
/// at (relocations, patched offsets; write_patched).
struct BytePatch {
  at: Int
  n: Int
  v: Int
}

/// d written to out with the patches ps in place of the bytes they cover,
/// d copied as slices between them, never a byte at a time (the Mach-O
/// linker's DWARF join, 2026-10-27). ps need not be sorted (in order or
/// in reverse, as Mach-O lists relocations, it is not sorted again); a
/// patch that overlaps an earlier one is skipped.
/// ps by address. Usually a few runs in order: a section's relocations
/// (up or down), then a DWARF unit's or line table's header fields
/// (dsym.xo dw_unit, dw_line: one per file name). Each run is kept and
/// the runs merged, stable, not the whole list sorted (std's store link:
/// 2.5 ms of a merge sort's copies, 2026-10-28); past 8 runs, a sort.
fn patches_in_order(ps: List[BytePatch]) -> List[BytePatch] {
  if ps.len() < 2 {
    return ps
  }
  // the runs as index ranges (a slice is a copy): start, end, down (no
  // two patches of a descending run share an address)
  var runs: List[(Int, Int, Bool)] = []
  var i = 0
  while i < ps.len() {
    var j = i + 1
    let down = j < ps.len() && ps[j].at < ps[i].at
    while j < ps.len() && (if down { ps[j].at < ps[j - 1].at } else { ps[j].at >= ps[j - 1].at }) {
      j += 1
    }
    runs.push((i, j, down))
    if runs.len() > 8 {
      return ps.sort_by(fn(p: BytePatch) -> Int { p.at })
    }
    i = j
  }
  if runs.len() == 1 {
    return if runs[0].2 { ps.reverse() } else { ps }
  }
  // each run's next patch: taken from the run with the lowest address,
  // the earliest run on a tie (a stable sort's order)
  var next: List[Int] = []
  for (s0, e0, d0) in runs {
    next.push(if d0 { e0 - 1 } else { s0 })
  }
  var out: List[BytePatch] = List.with_capacity(ps.len())
  while out.len() < ps.len() {
    var best = -1
    for (k, (s0, e0, d0)) in runs.indexed() {
      let n = next[k]
      if (if d0 { n < s0 } else { n >= e0 }) {
        continue
      }
      if best < 0 || ps[n].at < ps[next[best]].at {
        best = k
      }
    }
    out.push(ps[next[best]])
    next[best] = if runs[best].2 { next[best] - 1 } else { next[best] + 1 }
  }
  out
}

fn write_patched(var out: BytesBuilder, d: Bytes, ps: List[BytePatch]) {
  // d once, then each patch stored in place (BytesBuilder.put_le,
  // decision 0399): it was d sliced between patches (each slice a copy)
  // and each patch a byte at a time, half of a windows link's layout
  let base = out.len()
  out.write(d)
  let sorted = patches_in_order(ps)
  var prev = 0
  for p in sorted {
    if p.at < prev {
      continue
    }
    out.put_le(base + p.at, p.v, p.n)
    prev = p.at + p.n
  }
}
