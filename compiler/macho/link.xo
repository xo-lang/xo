// The linker of decision 0182: arm64 Mach-O objects (the program's, the
// C runtime's, archive members) into a position independent MH_EXECUTE
// for macOS, as `ld` links them for `cc` (x86_64 ones too, decision 0254
// stage 6a: x86_reloc, x86_eh_frame, 6 byte stubs):
//
// - input sections concatenated into output sections by name (no dead
//   stripping, no literal merging);
// - global symbols resolved across objects, archive members taken when
//   they define a needed symbol, the rest imported (from libSystem by
//   two level namespace ordinal 1, or by flat lookup when more dylibs
//   are linked);
// - calls to imports through __stubs, GOT loads and personality
//   pointers through __got, thread local variables through their
//   descriptors (the TLVP load turned into an add);
// - absolute pointers rebased and imports bound by chained fixups
//   (DYLD_CHAINED_PTR_64_OFFSET);
// - __unwind_info built from the objects' compact unwind entries, DWARF
//   mode entries pointing at their FDE in the merged __eh_frame;
// - an ad hoc code signature (sign.xo).

use std/crypto

const IMAGE_BASE = 0x100000000
const PAGE = 0x4000

/// The reach of an arm64 bl or b (BRANCH26): ±128 MiB.
const BRANCH_REACH = 0x8000000
const MH_EXECUTE = 2
const MH_NOUNDEFS = 0x1
const MH_DYLDLINK = 0x4
const MH_TWOLEVEL = 0x80
const MH_PIE = 0x200000
const MH_HAS_TLV_DESCRIPTORS = 0x800000
const LC_LOAD_DYLIB = 0xc
const LC_RPATH = 0x8000001c
const LC_LOAD_DYLINKER = 0xe
const LC_UUID = 0x1b
const LC_CODE_SIGNATURE = 0x1d
const LC_MAIN = 0x80000028
const LC_DYLD_EXPORTS_TRIE = 0x80000033
const LC_DYLD_CHAINED_FIXUPS = 0x80000034
const SG_READ_ONLY = 0x10
const INDIRECT_SYMBOL_LOCAL = 0x80000000
const REFERENCED_DYNAMICALLY = 0x10
const S_ATTR_DEBUG_FLAG = 0x02000000

/// What the linker writes: the output's file name (the code signature's
/// identifier), the macOS versions of LC_BUILD_VERSION, the dylibs, the
/// entry point.
pub struct LinkOpts {
  pub name: Str
  pub minos: (Int, Int) = (11, 0)
  pub sdk: (Int, Int) = (11, 0)
  pub dylibs: List[Str] = ["/usr/lib/libSystem.B.dylib"]
  /// The run path searched for a dylib named @rpath/... (LC_RPATH), in
  /// order: --race's ThreadSanitizer runtime (decision 0273)
  pub rpaths: List[Str] = []
  pub entry: Str = "_main"
  /// No local symbols in the symbol table (`xo build -s`, as `ld -x`):
  /// the exports, the imports, and __mh_execute_header stay
  pub strip: Bool = false
  /// A --release link keeps the local symbols in __TEXT,__text only:
  /// those are the function names std/native/llrt's prof reads for a
  /// traceback. The other local symbols (data, TLS) are dropped: nothing
  /// looks them up, the loader uses the rebase and bind tables. A debug
  /// link keeps them all. 67 LSDA symbols were the largest block before
  /// 2026-10-25 (compiler/arm64 emit.xo lsda_label made them local).
  pub release: Bool = false
  /// The reach of a bl or b the branch islands assume, 0 for the
  /// instruction's ±128 MiB (BRANCH_REACH): a test's smaller value makes
  /// islands in a small program
  pub branch_reach: Int = 0
  /// The DWARF in the executable's own __DWARF segment (decision 0346),
  /// uncompressed, before __LINKEDIT, mapped with no access
  pub embed_dwarf: Bool = true
  /// link_debug also gives the dSYM's DWARF file (`--dsym`)
  pub dsym: Bool = false
}

/// An input file: its path (for messages) and contents.
pub struct LinkInput {
  pub path: Str
  pub data: Bytes
  /// an archive's every member, referenced or not (ld's --whole-archive:
  /// ThreadSanitizer's runtime, whose __tsan_init a .preinit_array of a
  /// member no symbol reaches calls; the ELF linker)
  pub whole: Bool = false
}

/// An output section.
struct OSect {
  seg: Str
  name: Str
  flags: Int
  align: Int = 0
  size: Int = 0
  addr: Int = 0
  fileoff: Int = 0
  /// the input sections placed in it: (object, section)
  chunks: List[(Int, Int)] = []
  /// the contents of a synthetic section, before patches
  synth: Bytes = "".bytes()
  reserved1: Int = 0
  reserved2: Int = 0
  /// the final contents
  bytes: Bytes = "".bytes()
}

struct OSeg {
  name: Str
  prot: Int
  flags: Int = 0
  sects: List[Int] = []
  vmaddr: Int = 0
  vmsize: Int = 0
  fileoff: Int = 0
  filesize: Int = 0
}

/// A word of the output replaced: 4 or 8 bytes at a virtual address.
struct Patch {
  addr: Int
  size: Int
  value: Int
}

/// A pointer for dyld: a rebase to a virtual address, or a bind of an
/// import plus an addend.
struct Fixup {
  addr: Int
  bind: Bool
  target: Int
  addend: Int = 0
}

/// A compact unwind entry of an object, resolved.
struct UEntry {
  func: Int
  len: Int
  enc: Int
  /// the GOT slot address of the personality, 0 for none
  pers: Int = 0
  lsda: Int = 0
}

/// A relocation target: an address, or an import.
struct RelocTarget {
  imp: Int = -1
  addr: Int = 0
}

struct Linker {
  opts: LinkOpts
  objs: List[IObj] = []
  globals: Map[Bytes, (Int, Int)] = {}
  imports: List[Bytes] = []
  /// the imports every reference to which is weak (N_WEAK_REF, decision
  /// 0232): bound as weak imports, which dyld leaves 0 when no image
  /// defines them
  weak_imports: Set[Bytes] = #{}
  import_ix: Map[Bytes, Int] = {}
  /// GOT slots, by import or by defined symbol (obj, sym)
  got_imp: Map[Int, Int] = {}
  got_def: Map[(Int, Int), Int] = {}
  /// each slot: (import, obj, sym) with -1 for the absent parts
  got: List[(Int, Int, Int)] = []
  stub_ix: Map[Int, Int] = {}
  stubs: List[Int] = []
  osects: List[OSect] = []
  segs: List[OSeg] = []
  patches: List[Patch] = []
  fixups: List[Fixup] = []
  uentries: List[UEntry] = []
  tlv_start: Int = -1
  has_tlv: Bool = false
  s_stubs: Int = -1
  s_got: Int = -1
  s_unwind: Int = -1
  s_eh: Int = -1
  /// the size of the header and load commands
  cmds_size: Int = 0
  /// the output's LC_UUID (write), which its dSYM carries too
  uuid: Bytes = zeros(0)
  /// the __DWARF segment's sections' sizes (dwarf_sizes; empty: none)
  dw_sizes: List[Int] = []
  /// an x86_64 link (every object x86_64)
  x86: Bool = false
  /// branch islands (islands): the __text output section, each island's
  /// input section (object, section), its veneers by branch_key, the
  /// island each __text input section's far branches use, and the
  /// veneers written
  isl_text: Int = -1
  isl_sects: List[(Int, Int)] = []
  isl_ix: List[Map[Str, Int]] = []
  isl_of: Map[(Int, Int), Int] = {}
  isl_done: Set[Int] = #{}
  /// while the DWARF is written: an address in a stripped atom is 0
  dw_dead_zero: Bool = false
  err: Str = ""
}

/// link: the executable of the inputs (objects and archives), or the
/// first error.
pub fn link(inputs: List[LinkInput], opts: LinkOpts) -> Result[Bytes, Str] {
  match link_debug(inputs, opts) {
    Ok((exe, _)) => Ok(exe)
    Err(e) => Err(e)
  }
}

/// link_debug: the executable and, with opts.dsym, its dSYM's DWARF file
/// (dsym.xo; empty without it or when no input has DWARF sections), or
/// the first error.
pub fn link_debug(inputs: List[LinkInput], opts: LinkOpts) -> Result[(Bytes, Bytes), Str] {
  var l = Linker{opts: opts}
  match parse_inputs(inputs) {
    Ok(x) => l.objs = x
    Err(e) => return Err(e)
  }
  if !l.objs.is_empty() {
    l.x86 = l.objs[0].x86
    for ob in l.objs {
      if ob.x86 != l.x86 {
        return Err("${ob.path}: an ${if ob.x86 { "x86_64" } else { "arm64" }} object in an ${if l.x86 { "x86_64" } else { "arm64" }} link")
      }
    }
  }
  l.resolve()
  if !l.err.is_empty() {
    return Err(l.err)
  }
  // decision 0388 stage 4: objects made with .subsections_via_symbols
  // keep only the atoms the link reaches
  l.dead_strip()
  if !l.err.is_empty() {
    return Err(l.err)
  }
  l.link_rest()
}

/// The objects of the inputs: each object, and each archive's members
/// (not live until resolve takes them).
fn parse_inputs(inputs: List[LinkInput]) -> Result[List[IObj], Str] {
  var objs: List[IObj] = []
  for inp in inputs {
    if inp.data.len() >= 8 && bstr(inp.data[0..8]) == "!<arch>\n" {
      match parse_archive(inp.path, inp.data) {
        Ok(ms) => objs = objs + ms
        Err(e) => return Err(e)
      }
    } else {
      match parse_object(inp.path, inp.data) {
        Ok(o) => objs.push(o)
        Err(e) => return Err(e)
      }
    }
  }
  Ok(objs)
}

/// The link after the strip: placing, layout, relocation, the output
/// (and with opts.dsym the dSYM's DWARF).
fn (var l: Linker) link_rest() -> Result[(Bytes, Bytes), Str] {
  l.place()
  l.scan()
  if !l.err.is_empty() {
    return Err(l.err)
  }
  l.layout()
  l.islands()
  if !l.err.is_empty() {
    return Err(l.err)
  }
  l.relocate()
  l.dw_dead_zero = false
  if !l.err.is_empty() {
    return Err(l.err)
  }
  l.synthesize()
  if !l.err.is_empty() {
    return Err(l.err)
  }
  let out = l.write()
  if !l.err.is_empty() {
    return Err(l.err)
  }
  let dsym = if l.opts.dsym { l.dsym() } else { zeros(0) }
  if !l.err.is_empty() {
    return Err(l.err)
  }
  Ok((out, dsym))
}

fn (var l: Linker) fail(why: Str) {
  if l.err.is_empty() {
    l.err = why
  }
}

/// Whether name (with or without the platform's leading `_`) is the Xo
/// runtime's (`xo_...`): no library defines one, so one still undefined
/// is an error at link time, not an import dyld fails on at run time.
pub fn xo_runtime_name(name: Str) -> Bool {
  name.trim_prefix("_").starts_with("xo_")
}

/// The words an undefined runtime symbol's error adds: `xo_NAME` is what
/// a call of `rt.NAME` becomes, and std/native/rt.xo declares some rt
/// functions only for the paths that lower them (2026-10-24: a direct
/// `rt.rs_push_rune` linked, and dyld said "Symbol not found:
/// _xo_rs_push_rune" when the program ran).
pub fn rt_hint(name: Str) -> Str {
  let n = name.trim_prefix("_")
  if !n.starts_with("xo_") {
    return ""
  }
  let r = n.trim_prefix("xo_")
  ": `rt.${r}` (std/native/rt.xo) has no lowering on this backend when called directly; call the std function that wraps it"
}

fn is_ext(s: ISym) -> Bool {
  (s.typ & N_EXT) != 0 && (s.typ & N_STAB) == 0
}

fn is_defined(s: ISym) -> Bool {
  (s.typ & N_STAB) == 0 && ((s.typ & N_TYPE) == N_SECT || (s.typ & N_TYPE) == N_ABS)
}

// ---------------------------------------------------------------------------
// Symbols

/// Takes the global definitions of the live objects, then archive members
/// that define what is still undefined; the rest are imports.
fn (var l: Linker) resolve() {
  for o in 0..l.objs.len() {
    if l.objs[o].live {
      l.add_globals(o)
    }
  }
  var changed = true
  while changed {
    changed = false
    for o in 0..l.objs.len() {
      if !l.objs[o].live {
        continue
      }
      for s in l.objs[o].syms {
        if !is_ext(s) || is_defined(s) || l.globals.contains(s.name) {
          continue
        }
        // a member of an archive defining it
        for m in 0..l.objs.len() {
          if l.objs[m].live {
            continue
          }
          if l.objs[m].syms.any(fn(t: ISym) -> Bool { is_ext(t) && is_defined(t) && t.name == s.name }) {
            l.objs[m].live = true
            l.add_globals(m)
            changed = true
            break
          }
        }
      }
    }
  }
  // common symbols (tentative definitions) no object defines: zero
  // filled in __DATA,__common, the largest size and alignment of each
  var commons: Map[Bytes, (Int, Int)] = {}
  var corder: List[Bytes] = []
  for o in l.objs {
    if !o.live {
      continue
    }
    for s in o.syms {
      if is_ext(s) && !is_defined(s) && s.value != 0 && !l.globals.contains(s.name) {
        let al = (s.desc >> 8) & 15
        match commons.get(s.name) {
          Some((sz, a)) => commons.put(s.name, (if s.value > sz { s.value } else { sz }, if al > a { al } else { a }))
          None => {
            commons.put(s.name, (s.value, al))
            corder.push(s.name)
          }
        }
      }
    }
  }
  if !corder.is_empty() {
    var c = IObj{path: "<common symbols>"}
    var off = 0
    var maxal = 0
    for n in corder {
      let (sz, al) = commons.get(n) ?? (0, 0)
      let a = pow2(al)
      off = (off + a - 1) / a * a
      c.syms.push(ISym{name: n, typ: N_SECT | N_EXT, sect: 1, desc: 0, value: off})
      off += sz
      if al > maxal {
        maxal = al
      }
    }
    c.sects.push(ISect{seg: "__DATA", name: "__common", addr: 0, size: off, align: maxal, flags: S_ZEROFILL, data: "".bytes()})
    l.objs.push(c)
    l.add_globals(l.objs.len() - 1)
  }
  l.section_bounds()
  // the imports, sorted by name
  var names: Set[Bytes] = #{}
  var strong: Set[Bytes] = #{}
  for o in l.objs {
    if !o.live {
      continue
    }
    for s in o.syms {
      if is_ext(s) && !is_defined(s) && !l.globals.contains(s.name) {
        names.add(s.name)
        if (s.desc & 0x40) == 0 {
          strong.add(s.name)
        }
      }
    }
  }
  for n in names {
    if !strong.contains(n) {
      l.weak_imports.add(n)
    } else if xo_runtime_name(bstr(n)) {
      var from = ""
      for o in l.objs {
        if !o.live {
          continue
        }
        for s in o.syms {
          if s.name == n && is_ext(s) && !is_defined(s) && from.is_empty() {
            from = o.path
          }
        }
      }
      l.fail("${bstr(n)} is not defined (referenced from ${from})${rt_hint(bstr(n))}")
    }
  }
  l.imports = names.to_list().sort_by(fn(n: Bytes) -> Str { bstr(n) })
  for (i, n) in l.imports.indexed() {
    l.import_ix.put(n, i)
  }
}

/// section$start$SEG$SECT and section$end$SEG$SECT, as ld64 defines
/// them: an empty marker section each, placed first or last in the output
/// section (place), which a symbol at offset 0 names (decision 0388: the
/// gathered unsafe range index).
fn (var l: Linker) section_bounds() {
  var want: List[Bytes] = []
  for o in l.objs {
    if !o.live {
      continue
    }
    for s in o.syms {
      let n = bstr(s.name)
      if is_ext(s) && !is_defined(s) && !l.globals.contains(s.name) && (n.starts_with("section$start$") || n.starts_with("section$end$")) && !want.contains(s.name) {
        want.push(s.name)
      }
    }
  }
  if want.is_empty() {
    return
  }
  var c = IObj{path: "<section bounds>"}
  for n in want {
    let parts = bstr(n).split("$")
    if parts.len() != 4 {
      l.fail("${bstr(n)}: want section$start$SEG$SECT")
      return
    }
    c.sects.push(ISect{seg: parts[2], name: parts[3], addr: 0, size: 0, align: 0, flags: 0, data: "".bytes()})
    c.syms.push(ISym{name: n, typ: N_SECT | N_EXT, sect: c.sects.len(), desc: 0, value: 0})
  }
  l.objs.push(c)
  l.add_globals(l.objs.len() - 1)
}

fn (var l: Linker) add_globals(o: Int) {
  for (i, s) in l.objs[o].syms.indexed() {
    if is_ext(s) && is_defined(s) {
      match l.globals.get(s.name) {
        Some((o2, i2)) => {
          // a weak definition gives way; two strong ones are an error
          let weak_old = (l.objs[o2].syms[i2].desc & 0x80) != 0
          let weak_new = (s.desc & 0x80) != 0
          if !weak_old && !weak_new {
            l.fail("duplicate symbol ${bstr(s.name)} in ${l.objs[o2].path} and ${l.objs[o].path}")
            return
          }
          if weak_old && !weak_new {
            l.globals.put(s.name, (o, i))
          }
        }
        None => l.globals.put(s.name, (o, i))
      }
    }
  }
}

/// The definition a symbol of an object refers to: (obj, sym), or (-1,
/// import) for an import.
fn (l: Linker) def_of(o: Int, i: Int) -> (Int, Int) {
  let s = l.objs[o].syms[i]
  if is_defined(s) {
    if is_ext(s) {
      // a global defined more than once (weak): the chosen definition
      return l.globals.get(s.name) ?? (o, i)
    }
    return (o, i)
  }
  match l.globals.get(s.name) {
    Some(d) => d
    None => (-1, l.import_ix.get(s.name) ?? -1)
  }
}

/// The address of a defined symbol.
fn (l: Linker) sym_addr(o: Int, i: Int) -> Int {
  let s = l.objs[o].syms[i]
  if (s.typ & N_TYPE) == N_ABS {
    return s.value
  }
  let sect = l.objs[o].sects[s.sect - 1]
  if sect.out < 0 {
    // a stripped atom's symbol (strip.xo), which only DWARF names
    return 0
  }
  l.osects[sect.out].addr + sect.off + (s.value - sect.addr)
}

/// Whether output section out is __TEXT,__text: the only place a
/// --release link keeps a local symbol (a function's name, which the
/// traceback reads).
fn (l: Linker) is_text_sect(out: Int) -> Bool {
  if out < 0 || out >= l.osects.len() {
    return false
  }
  let s = l.osects[out]
  s.seg == "__TEXT" && s.name == "__text"
}

/// The output address of an object address in a section of the object
/// (non extern relocations).
fn (var l: Linker) translate(o: Int, ordinal0: Int, a: Int) -> Int {
  // a split section's ordinal names its atom holding a (strip.xo)
  let ordinal = if l.objs[o].split.is_empty() { ordinal0 } else { atom_ordinal(l.objs[o], ordinal0, a) }
  if ordinal < 1 || ordinal > l.objs[o].sects.len() {
    l.fail("${l.objs[o].path}: relocation to section ${ordinal}")
    return 0
  }
  let sect = l.objs[o].sects[ordinal - 1]
  if sect.out < 0 {
    if sect.dead && l.dw_dead_zero {
      // DWARF of a stripped atom: its addresses are 0
      return 0
    }
    l.fail("${l.objs[o].path}: relocation into ${sect.seg},${sect.name}")
    return 0
  }
  l.osects[sect.out].addr + sect.off + (a - sect.addr)
}

// ---------------------------------------------------------------------------
// Sections

/// The output segment and the place in it of an input section; "" to drop
/// it.
fn out_name(seg: Str, name: Str, flags: Int) -> (Str, Str) {
  if seg == "__LD" || (flags & S_ATTR_DEBUG_FLAG) != 0 || seg == "__DWARF" {
    return ("", "")
  }
  if seg == "__DATA" && name == "__const" {
    return ("__DATA_CONST", "__const")
  }
  (seg, name)
}

/// The output order of sections in each segment.
fn sect_rank(seg: Str, name: Str) -> Int {
  let order = ["__TEXT,__text", "__TEXT,__stubs", "__TEXT,__gcc_except_tab", "__TEXT,__const", "__TEXT,__cstring", "__TEXT,__literal4", "__TEXT,__literal8", "__TEXT,__literal16", "__TEXT,__unwind_info", "__TEXT,__eh_frame", "__DATA_CONST,__got", "__DATA_CONST,__const", "__DATA,__data", "__DATA,__thread_vars", "__DATA,__thread_data", "__DATA,__thread_bss", "__DATA,__bss", "__DATA,__common"]
  let k = "${seg},${name}"
  match order.index_of(k) {
    Some(i) => i * 10
    // unknown sections after the known ones of their segment
    None => {
      if seg == "__TEXT" {
        95
      } else if seg == "__DATA_CONST" {
        115
      } else {
        // zerofill must stay last
        135
      }
    }
  }
}

fn seg_rank(seg: Str) -> Int {
  match seg {
    "__TEXT" => 0
    "__DATA_CONST" => 1
    "__DATA" => 2
    _ => 3
  }
}

fn (var l: Linker) osect(seg: Str, name: Str, flags: Int) -> Int {
  for (i, s) in l.osects.indexed() {
    if s.seg == seg && s.name == name {
      return i
    }
  }
  l.osects.push(OSect{seg: seg, name: name, flags: flags})
  l.osects.len() - 1
}

/// Puts every live input section in its output section, and makes the
/// synthetic ones.
fn (var l: Linker) place() {
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for k in 0..l.objs[o].sects.len() {
      let s = l.objs[o].sects[k]
      let (seg, name) = out_name(s.seg, s.name, s.flags)
      if seg.is_empty() || s.dead {
        continue
      }
      let oi = l.osect(seg, name, s.flags & 0xffffff00 | (s.flags & 0xff))
      if s.align > l.osects[oi].align {
        l.osects[oi].align = s.align
      }
      l.osects[oi].chunks.push((o, k))
      l.objs[o].sects[k].out = oi
      if (s.flags & 0xff) == S_THREAD_LOCAL_VARIABLES {
        l.has_tlv = true
      }
    }
  }
  // section$start$ markers first in their output sections, section$end$
  // last (section_bounds)
  for i in 0..l.osects.len() {
    var first: List[(Int, Int)] = []
    var mid: List[(Int, Int)] = []
    var last: List[(Int, Int)] = []
    for (o, k) in l.osects[i].chunks {
      if l.objs[o].path == "<section bounds>" {
        let n = bstr(l.objs[o].syms[k].name)
        if n.starts_with("section$start$") {
          first.push((o, k))
        } else {
          last.push((o, k))
        }
      } else {
        mid.push((o, k))
      }
    }
    if !first.is_empty() || !last.is_empty() {
      l.osects[i].chunks = first + mid + last
    }
  }
}

/// Collects the stubs and GOT slots the relocations need, and the
/// compact unwind entries' personalities.
fn (var l: Linker) scan() {
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for s in l.objs[o].sects {
      let unwind = s.seg == "__LD" && s.name == "__compact_unwind"
      if s.out < 0 && !unwind {
        continue
      }
      for r in s.relocs {
        if !r.ext {
          continue
        }
        let (d, i) = l.def_of(o, r.sym)
        if d < 0 && i < 0 {
          l.fail("${l.objs[o].path}: undefined symbol ${bstr(l.objs[o].syms[r.sym].name)}")
          return
        }
        if (r.typ == R_BRANCH26 || r.typ == RX_BRANCH) && d < 0 {
          l.need_stub(i)
        } else if r.typ == RX_GOT_LOAD || r.typ == RX_GOT {
          // the slot even for a symbol of the image (ld relaxes a movq of
          // one to a leaq; the load through the GOT is the same value)
          l.need_got(d, i)
        } else if (r.typ == RX_TLV || r.typ == RX_SIGNED || r.typ == RX_SIGNED_1 || r.typ == RX_SIGNED_2 || r.typ == RX_SIGNED_4) && d < 0 {
          l.fail("${l.objs[o].path}: a pc relative reference to the import ${bstr(l.imports[i])}")
          return
        } else if r.typ == R_GOT_LOAD_PAGE21 || r.typ == R_GOT_LOAD_PAGEOFF12 || r.typ == R_POINTER_TO_GOT {
          l.need_got(d, i)
        } else if unwind && r.addr % 32 == 16 {
          // a personality: reached through the GOT
          l.need_got(d, i)
        }
      }
    }
  }
  if !l.got.is_empty() {
    l.s_got = l.osect("__DATA_CONST", "__got", S_NON_LAZY_SYMBOL_POINTERS)
    l.osects[l.s_got].align = 3
    l.osects[l.s_got].size = 8 * l.got.len()
  }
  if !l.stubs.is_empty() {
    l.s_stubs = l.osect("__TEXT", "__stubs", S_SYMBOL_STUBS + S_ATTR_PURE_INSTRUCTIONS + S_ATTR_SOME_INSTRUCTIONS)
    let size = l.stub_size()
    l.osects[l.s_stubs].align = if l.x86 { 1 } else { 2 }
    l.osects[l.s_stubs].size = size * l.stubs.len()
    l.osects[l.s_stubs].reserved2 = size
  }
  // the unwind info: sized from the entries now
  l.count_unwind()
  // the order of the output sections
  l.osects = l.osects
  var order: List[Int] = []
  for i in 0..l.osects.len() {
    order.push(i)
  }
  let os = l.osects
  order = order.sort_by(fn(i: Int) -> Int { seg_rank(os[i].seg) * 1000 + sect_rank(os[i].seg, os[i].name) })
  // renumber: the input sections and the synthetic indexes follow
  var newix: List[Int] = []
  for _ in order {
    newix.push(0)
  }
  var sorted: List[OSect] = []
  for (k, i) in order.indexed() {
    newix[i] = k
    sorted.push(os[i])
  }
  l.osects = sorted
  for o in 0..l.objs.len() {
    for k in 0..l.objs[o].sects.len() {
      let out = l.objs[o].sects[k].out
      if out >= 0 {
        l.objs[o].sects[k].out = newix[out]
      }
    }
  }
  l.s_got = if l.s_got >= 0 { newix[l.s_got] } else { -1 }
  l.s_stubs = if l.s_stubs >= 0 { newix[l.s_stubs] } else { -1 }
  l.s_unwind = if l.s_unwind >= 0 { newix[l.s_unwind] } else { -1 }
  for (i, s) in l.osects.indexed() {
    if s.seg == "__TEXT" && s.name == "__eh_frame" {
      l.s_eh = i
    }
  }
}

/// The size of a stub: adrp, ldr, br (arm64); jmp *slot(%rip) (x86_64).
fn (l: Linker) stub_size() -> Int {
  if l.x86 { 6 } else { 12 }
}

fn (var l: Linker) need_stub(imp: Int) {
  if l.stub_ix.contains(imp) {
    return
  }
  l.stub_ix.put(imp, l.stubs.len())
  l.stubs.push(imp)
  l.need_got(-1, imp)
}

fn (var l: Linker) need_got(d: Int, i: Int) {
  if d < 0 {
    if !l.got_imp.contains(i) {
      l.got_imp.put(i, l.got.len())
      l.got.push((i, -1, -1))
    }
  } else if !l.got_def.contains((d, i)) {
    l.got_def.put((d, i), l.got.len())
    l.got.push((-1, d, i))
  }
}

fn (l: Linker) got_addr(d: Int, i: Int) -> Int {
  let k = if d < 0 { l.got_imp.get(i) ?? 0 } else { l.got_def.get((d, i)) ?? 0 }
  l.osects[l.s_got].addr + 8 * k
}

/// Sizes the output sections, then places the segments: __TEXT from the
/// start of the file (the header first), each segment 16 KiB aligned.
fn (var l: Linker) layout() {
  for i in 0..l.osects.len() {
    if l.osects[i].chunks.is_empty() {
      continue
    }
    var off = 0
    for (o, k) in l.osects[i].chunks {
      let s = l.objs[o].sects[k]
      let al = pow2(s.align)
      off = (off + al - 1) / al * al
      l.objs[o].sects[k].off = off
      off += s.size
    }
    l.osects[i].size = off
  }
  // segments
  var names: List[Str] = []
  for s in l.osects {
    if !names.contains(s.seg) {
      names.push(s.seg)
    }
  }
  l.segs = [OSeg{name: "__PAGEZERO", prot: 0}]
  for n in ["__TEXT", "__DATA_CONST", "__DATA"] {
    if n == "__TEXT" || names.contains(n) {
      var g = OSeg{name: n, prot: if n == "__TEXT" { 5 } else { 3 }, flags: if n == "__DATA_CONST" { SG_READ_ONLY } else { 0 }}
      for (i, s) in l.osects.indexed() {
        if s.seg == n {
          g.sects.push(i)
        }
      }
      l.segs.push(g)
    }
  }
  // the DWARF (decision 0346): a segment of its own before __LINKEDIT,
  // not an output section (its addresses are absolute, with no fixups)
  if l.opts.embed_dwarf {
    l.dw_sizes = l.dwarf_sizes()
    if !l.dw_sizes.is_empty() {
      l.segs.push(OSeg{name: "__DWARF", prot: 0})
    }
  }
  l.segs.push(OSeg{name: "__LINKEDIT", prot: 1})
  // the header and load commands (sizes only)
  var ns = 0
  for g in l.segs {
    ns += g.sects.len()
  }
  ns += l.dw_sizes.len()
  var cmds = 72 * l.segs.len() + 80 * ns + 16 + 16 + 24 + 80 + 32 + 24 + 24 + 24 + 16
  for d in l.opts.dylibs {
    cmds += align_up(24 + d.len() + 1, 8)
  }
  for r in l.opts.rpaths {
    cmds += align_up(12 + r.len() + 1, 8)
  }
  l.cmds_size = cmds
  // __TEXT's sections start after room for the __DWARF segment's command
  // with all its sections, whether it is written or not, so a build
  // with debug information and one without (-s, --release) have their
  // code at the same addresses (decision 0252's gate,
  // TestDebugInfoSameCode; the command moved __text by 712 bytes,
  // gotchas/dwarf-segment-moved-text.md)
  let dw_cmd = if l.dw_sizes.is_empty() { 0 } else { 72 + 80 * l.dw_sizes.len() }
  let hdr = 32 + cmds - dw_cmd + 72 + 80 * dwarf_names().len()
  var vm = IMAGE_BASE
  var fo = 0
  for gi in 1..l.segs.len() - 1 {
    var g = l.segs[gi]
    g.vmaddr = vm
    g.fileoff = fo
    if g.name == "__DWARF" {
      var total = 0
      for n in l.dw_sizes {
        total += n
      }
      g.vmsize = align_up(total, PAGE)
      g.filesize = align_up(total, PAGE)
      l.segs[gi] = g
      vm += g.vmsize
      fo += g.filesize
      continue
    }
    var a = if g.name == "__TEXT" { hdr } else { 0 }
    var filesz = a
    for i in g.sects {
      let s = l.osects[i]
      let al = pow2(s.align)
      a = (a + al - 1) / al * al
      l.osects[i].addr = vm + a
      let zero = (s.flags & 0xff) == S_ZEROFILL || (s.flags & 0xff) == S_THREAD_LOCAL_ZEROFILL
      l.osects[i].fileoff = if zero { 0 } else { fo + a }
      a += s.size
      if !zero {
        filesz = a
      }
      if (s.flags & 0xff) == S_THREAD_LOCAL_REGULAR || (s.flags & 0xff) == S_THREAD_LOCAL_ZEROFILL {
        if l.tlv_start < 0 {
          l.tlv_start = vm + (a - s.size)
        }
      }
    }
    g.vmsize = align_up(a, PAGE)
    g.filesize = align_up(filesz, PAGE)
    l.segs[gi] = g
    vm += g.vmsize
    fo += g.filesize
  }
  let le = l.segs.len() - 1
  l.segs[le].vmaddr = vm
  l.segs[le].fileoff = fo
  l.segs[0].vmsize = IMAGE_BASE
}

// ---------------------------------------------------------------------------
// Relocations

/// The instruction word at an offset of an input section.
fn word_at(s: ISect, off: Int) -> Int {
  rd32(s.data, off)
}

fn (var l: Linker) patch(addr: Int, size: Int, value: Int) {
  l.patches.push(Patch{addr: addr, size: size, value: value})
}

/// The target of a relocation: the symbol's address (or its stub for a
/// call to an import), with the addend.
fn (var l: Linker) target(o: Int, r: IReloc, addend: Int) -> RelocTarget {
  if !r.ext {
    return RelocTarget{addr: l.translate(o, r.sym, addend)}
  }
  let (d, i) = l.def_of(o, r.sym)
  if d < 0 {
    return RelocTarget{imp: i, addr: addend}
  }
  RelocTarget{addr: l.sym_addr(d, i) + addend}
}

/// Applies the relocations of every placed input section: patches of
/// instruction immediates and data words, and fixups for dyld.
fn (var l: Linker) relocate() {
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for k in 0..l.objs[o].sects.len() {
      let s = l.objs[o].sects[k]
      if s.out >= 0 && l.x86 && s.seg == "__TEXT" && s.name == "__eh_frame" {
        l.x86_eh_frame(o, k)
      }
      if s.out < 0 || s.relocs.is_empty() {
        continue
      }
      // a stripped function's FDE (strip.xo): its addresses are 0
      l.dw_dead_zero = is_eh(s)
      let base = l.osects[s.out].addr + s.off
      let tvars = (s.flags & 0xff) == S_THREAD_LOCAL_VARIABLES
      var addend = 0
      var has_addend = false
      var sub = RelocTarget{}
      var has_sub = false
      for r in s.relocs {
        let p = base + r.addr
        if r.typ == R_ADDEND {
          addend = sext24(r.sym)
          has_addend = true
          continue
        }
        if r.typ == R_SUBTRACTOR {
          sub = l.target(o, r, 0)
          has_sub = true
          continue
        }
        if r.typ >= 64 {
          l.x86_reloc(o, s, r, p)
          if !l.err.is_empty() {
            return
          }
          continue
        }
        let ins = if r.len == 2 { word_at(s, r.addr) } else { 0 }
        if r.typ == R_UNSIGNED {
          let content = if r.len == 3 { rd64(s.data, r.addr) } else { sext32(rd32(s.data, r.addr)) }
          let t = l.target(o, r, if r.ext { content } else { content })
          if has_sub {
            if t.imp >= 0 || sub.imp >= 0 {
              l.fail("${l.objs[o].path}: a difference with an import")
              return
            }
            // ext: S - B + content; the non extern target holds the content already
            let v = if r.ext { t.addr - sub.addr } else { t.addr - sub.addr }
            l.patch(p, if r.len == 3 { 8 } else { 4 }, v)
            has_sub = false
          } else if tvars && r.addr % 24 == 16 {
            // a descriptor's offset in the thread local template
            l.patch(p, 8, t.addr - l.tlv_start)
          } else {
            if r.len != 3 {
              l.fail("${l.objs[o].path}: a 32 bit absolute pointer in ${s.seg},${s.name}")
              return
            }
            if t.imp >= 0 {
              l.fixups.push(Fixup{addr: p, bind: true, target: t.imp, addend: t.addr})
            } else {
              l.fixups.push(Fixup{addr: p, bind: false, target: t.addr})
            }
          }
        } else if r.typ == R_BRANCH26 {
          var t = l.target(o, r, if has_addend { addend } else { 0 })
          var dest = t.addr
          if t.imp >= 0 {
            dest = l.stub_addr(t.imp)
          }
          var d = dest - p
          if d < -l.reach() || d >= l.reach() {
            d = l.veneer(o, k, r, if has_addend { addend } else { 0 }, dest) - p
          }
          if d < -l.reach() || d >= l.reach() {
            l.fail("${l.objs[o].path}: branch out of range")
            return
          }
          l.patch(p, 4, (ins & 0xfc000000) | ((d / 4) & 0x3ffffff))
        } else if r.typ == R_PAGE21 || r.typ == R_GOT_LOAD_PAGE21 || r.typ == R_TLVP_LOAD_PAGE21 {
          var dest = 0
          let t = l.target(o, r, if has_addend { addend } else { 0 })
          if r.typ == R_GOT_LOAD_PAGE21 {
            let (d, i) = l.def_of(o, r.sym)
            dest = l.got_addr(d, i)
          } else {
            if t.imp >= 0 {
              l.fail("${l.objs[o].path}: a page reference to the import ${bstr(l.imports[t.imp])}")
              return
            }
            dest = t.addr
          }
          let delta = (dest >> 12) - (p >> 12)
          if delta < -1048576 || delta >= 1048576 {
            l.fail("${l.objs[o].path}: adrp out of range")
            return
          }
          let imm = delta & 0x1fffff
          l.patch(p, 4, (ins & 0x9f00001f) | ((imm & 3) * 0x20000000) | ((imm >> 2) * 32))
        } else if r.typ == R_PAGEOFF12 || r.typ == R_GOT_LOAD_PAGEOFF12 || r.typ == R_TLVP_LOAD_PAGEOFF12 {
          var dest = 0
          let t = l.target(o, r, if has_addend { addend } else { 0 })
          var w = ins
          if r.typ == R_GOT_LOAD_PAGEOFF12 {
            let (d, i) = l.def_of(o, r.sym)
            dest = l.got_addr(d, i)
          } else {
            if t.imp >= 0 {
              l.fail("${l.objs[o].path}: a page offset of the import ${bstr(l.imports[t.imp])}")
              return
            }
            dest = t.addr
            if r.typ == R_TLVP_LOAD_PAGEOFF12 {
              // the descriptor is in the image: ldr xd, [xn, #off] becomes
              // add xd, xn, #off
              if (w & 0xffc00000) != 0xf9400000 {
                l.fail("${l.objs[o].path}: a TLV load that is not an ldr")
                return
              }
              w = 0x91000000 | (w & 0x3ff)
            }
          }
          let lo = dest & 0xfff
          var scale = 0
          if (w & 0x3b000000) == 0x39000000 {
            // a load or store with an unsigned offset: scaled by its size
            scale = (w >> 30) & 3
            if (w & 0x04800000) == 0x04800000 {
              scale = 4
            }
          }
          if lo % pow2(scale) != 0 {
            l.fail("${l.objs[o].path}: misaligned page offset for a ${pow2(scale)} byte access")
            return
          }
          l.patch(p, 4, (w & 0xffc003ff) | ((lo >> scale) * 0x400))
        } else if r.typ == R_POINTER_TO_GOT {
          let (d, i) = l.def_of(o, r.sym)
          let g = l.got_addr(d, i)
          if r.pcrel && r.len == 2 {
            l.patch(p, 4, (g - p) & 0xffffffff)
          } else if !r.pcrel && r.len == 3 {
            l.fixups.push(Fixup{addr: p, bind: false, target: g})
          } else {
            l.fail("${l.objs[o].path}: ARM64_RELOC_POINTER_TO_GOT of length ${r.len}")
            return
          }
        } else {
          l.fail("${l.objs[o].path}: relocation type ${r.typ} in ${s.seg},${s.name}")
          return
        }
        has_addend = false
      }
    }
  }
  // the GOT: rebases of defined symbols, binds of imports
  for (k, (imp, d, i)) in l.got.indexed() {
    let a = l.osects[l.s_got].addr + 8 * k
    if imp >= 0 {
      l.fixups.push(Fixup{addr: a, bind: true, target: imp})
    } else {
      l.fixups.push(Fixup{addr: a, bind: false, target: l.sym_addr(d, i)})
    }
  }
  // the stubs: adrp x16, slot@PAGE; ldr x16, [x16, slot@PAGEOFF]; br x16,
  // or jmp *slot(%rip)
  if l.s_stubs >= 0 && l.x86 {
    var o = new_out(6 * l.stubs.len())
    for (k, imp) in l.stubs.indexed() {
      let p = l.osects[l.s_stubs].addr + 6 * k
      o.u8(0xff)
      o.u8(0x25)
      o.u32((l.got_addr(-1, imp) - (p + 6)) & 0xffffffff)
    }
    l.osects[l.s_stubs].synth = o.done()
  } else if l.s_stubs >= 0 {
    var o = new_out(12 * l.stubs.len())
    for (k, imp) in l.stubs.indexed() {
      let p = l.osects[l.s_stubs].addr + 12 * k
      let g = l.got_addr(-1, imp)
      let delta = ((g >> 12) - (p >> 12)) & 0x1fffff
      o.u32(0x90000010 | ((delta & 3) * 0x20000000) | ((delta >> 2) * 32))
      o.u32(0xf9400210 | (((g & 0xfff) / 8) * 0x400))
      o.u32(0xd61f0200)
    }
    l.osects[l.s_stubs].synth = o.done()
  }
}

/// The identity of a branch's target, the same before and after the
/// islands move the addresses: the symbol (or import, or section) and the
/// addend.
fn (l: Linker) branch_key(o: Int, r: IReloc, addend: Int) -> Str {
  if !r.ext {
    return "s${o}.${r.sym}+${addend}"
  }
  let (d, i) = l.def_of(o, r.sym)
  if d < 0 {
    return "i${i}+${addend}"
  }
  "d${d}.${i}+${addend}"
}

/// The reach of a bl or b (LinkOpts.branch_reach, BRANCH_REACH).
fn (l: Linker) reach() -> Int {
  if l.opts.branch_reach > 0 { l.opts.branch_reach } else { BRANCH_REACH }
}

/// Branch islands (ld64's): an arm64 __text past 7/8 of a branch's reach
/// gets a section of veneers after each half reach of its input sections,
/// for the bl and b whose target is past the reach (xo with every
/// optional pass off: 182 MB of text, 2026-10-22). Each island follows
/// the input section that ends past the next half reach and holds a
/// veneer for every target of a branch in the sections before it (the
/// last ones: the island before them) farther than the reach less 1/8
/// before the islands go in; the islands together stay under that 1/8,
/// the most they move a target. Then the output is laid out again.
fn (var l: Linker) islands() {
  if l.x86 {
    return
  }
  let slack = l.reach() / 8
  let spacing = l.reach() / 2
  let far = l.reach() - slack
  var ti = -1
  for (i, s) in l.osects.indexed() {
    if s.seg == "__TEXT" && s.name == "__text" {
      ti = i
    }
  }
  if ti < 0 || l.osects[ti].size <= l.reach() - slack {
    return
  }
  let chunks = l.osects[ti].chunks
  // the input sections each island follows
  var cuts: List[Int] = []
  var next = spacing
  for (j, (o, k)) in chunks.indexed() {
    let s = l.objs[o].sects[k]
    if s.off + s.size >= next && j < chunks.len() - 1 {
      cuts.push(j)
      next = s.off + s.size + spacing
    }
  }
  if cuts.is_empty() {
    return
  }
  var region = 0
  for (j, (o, k)) in chunks.indexed() {
    l.isl_of.put((o, k), imin(region, cuts.len() - 1))
    if region < cuts.len() && j == cuts[region] {
      region += 1
    }
  }
  // the far branches' targets, by island
  var ix: List[Map[Str, Int]] = []
  for _ in cuts {
    ix.push({})
  }
  let base = l.osects[ti].addr
  for (o, k) in chunks {
    let s = l.objs[o].sects[k]
    let isl = l.isl_of.get((o, k)) ?? 0
    var addend = 0
    var has_addend = false
    for r in s.relocs {
      if r.typ == R_ADDEND {
        addend = sext24(r.sym)
        has_addend = true
        continue
      }
      if r.typ == R_BRANCH26 {
        let a = if has_addend { addend } else { 0 }
        let t = l.target(o, r, a)
        let dest = if t.imp >= 0 { l.stub_addr(t.imp) } else { t.addr }
        let d = dest - (base + s.off + r.addr)
        if d <= -far || d >= far {
          let key = l.branch_key(o, r, a)
          if !ix[isl].contains(key) {
            ix[isl].put(key, ix[isl].len())
          }
        }
      }
      has_addend = false
    }
  }
  // the islands: input sections of an object of their own, after their
  // cuts
  let (o0, k0) = chunks[0]
  var iobj = IObj{path: "<branch islands>"}
  var total = 0
  for m in ix {
    let n = 12 * m.len()
    total += n
    iobj.sects.push(ISect{seg: "__TEXT", name: "__text", addr: 0, size: n, align: 2, flags: l.objs[o0].sects[k0].flags, data: zeros(n), out: ti})
  }
  if total >= slack {
    l.fail("branch islands of ${total} bytes (more than ${slack})")
    return
  }
  let io = l.objs.len()
  l.objs.push(iobj)
  var nc: List[(Int, Int)] = []
  var c = 0
  for (j, ch) in chunks.indexed() {
    nc.push(ch)
    if c < cuts.len() && j == cuts[c] {
      nc.push((io, c))
      l.isl_sects.push((io, c))
      c += 1
    }
  }
  l.osects[ti].chunks = nc
  l.isl_text = ti
  l.isl_ix = ix
  l.tlv_start = -1
  l.layout()
}

/// The address of the veneer for a far branch of input section (o, k) to
/// dest (islands), written once: adrp x16, add x16, br x16 (x16 is the
/// intra procedure call scratch register a call may clobber). dest itself
/// when there is none.
fn (var l: Linker) veneer(o: Int, k: Int, r: IReloc, addend: Int, dest: Int) -> Int {
  let isl = l.isl_of.get((o, k)) ?? -1
  if isl < 0 {
    return dest
  }
  let n = l.isl_ix[isl].get(l.branch_key(o, r, addend)) ?? -1
  if n < 0 {
    return dest
  }
  let (io, ik) = l.isl_sects[isl]
  let v = l.osects[l.isl_text].addr + l.objs[io].sects[ik].off + 12 * n
  if !l.isl_done.contains(v) {
    l.isl_done.add(v)
    let imm = ((dest >> 12) - (v >> 12)) & 0x1fffff
    l.patch(v, 4, 0x90000010 | ((imm & 3) * 0x20000000) | ((imm >> 2) * 32))
    l.patch(v + 4, 4, 0x91000210 | ((dest & 4095) * 1024))
    l.patch(v + 8, 4, 0xd61f0200)
  }
  v
}

fn (l: Linker) stub_addr(imp: Int) -> Int {
  l.osects[l.s_stubs].addr + l.stub_size() * (l.stub_ix.get(imp) ?? 0)
}

/// An x86_64 relocation of a 32 bit pc relative field at p (output
/// address), as ld64 reads them: the target plus the field's content, less
/// the address after the field; a section relocation's field is the
/// displacement in the object's layout (SIGNED_n's n bytes of immediate
/// after it included).
fn (var l: Linker) x86_reloc(o: Int, s: ISect, r: IReloc, p: Int) {
  let path = l.objs[o].path
  if !r.pcrel || r.len != 2 {
    l.fail("${path}: x86_64 relocation type ${r.typ - 64} of length ${r.len} in ${s.seg},${s.name}")
    return
  }
  let field = sext32(rd32(s.data, r.addr))
  var dest = 0
  if r.typ == RX_SIGNED || r.typ == RX_SIGNED_1 || r.typ == RX_SIGNED_2 || r.typ == RX_SIGNED_4 || r.typ == RX_BRANCH {
    let n = if r.typ == RX_SIGNED_1 { 1 } else if r.typ == RX_SIGNED_2 { 2 } else if r.typ == RX_SIGNED_4 { 4 } else { 0 }
    if !r.ext {
      // the target in the object's layout, moved as its section moved
      let t = l.translate(o, r.sym, s.addr + r.addr + 4 + n + field)
      l.x86_patch(path, p, t - (p + 4 + n))
      return
    }
    let t = l.target(o, r, 0)
    dest = if t.imp >= 0 { l.stub_addr(t.imp) } else { t.addr }
  } else if r.typ == RX_GOT_LOAD || r.typ == RX_GOT {
    let (d, i) = l.def_of(o, r.sym)
    dest = l.got_addr(d, i)
  } else if r.typ == RX_TLV {
    // the descriptor is in the image: movq x@TLVP(%rip), %reg becomes
    // leaq (the descriptor's address, which the thunk call takes)
    if r.addr < 2 || s.data[r.addr - 2] != 0x8b {
      l.fail("${path}: a TLV load that is not a movq")
      return
    }
    l.patch(p - 2, 1, 0x8d)
    dest = l.target(o, r, 0).addr
  } else {
    l.fail("${path}: x86_64 relocation type ${r.typ - 64} in ${s.seg},${s.name}")
    return
  }
  l.x86_patch(path, p, dest + field - (p + 4))
}

fn (var l: Linker) x86_patch(path: Str, p: Int, d: Int) {
  if d < -2147483648 || d > 2147483647 {
    l.fail("${path}: a pc relative reference out of range")
    return
  }
  l.patch(p, 4, d & 0xffffffff)
}

/// An x86_64 object's __eh_frame: the FDEs' function and LSDA pointers are
/// pc relative with no relocation (resolved in the object, as LLVM writes
/// them), so each moves with the section it points into.
fn (var l: Linker) x86_eh_frame(o: Int, k: Int) {
  let s = l.objs[o].sects[k]
  let b = s.data
  let base = l.osects[s.out].addr + s.off
  var relocated: Set[Int] = #{}
  for r in s.relocs {
    relocated.add(r.addr)
  }
  // each CIE's pointer encodings: (FDE pointers, LSDA or -1 for none)
  var cies: Map[Int, (Int, Int)] = {}
  var off = 0
  while off + 8 <= b.len() {
    let len = rd32(b, off)
    if len == 0 {
      break
    }
    if len == 0xffffffff {
      l.fail("${l.objs[o].path}: 64 bit DWARF in __eh_frame")
      return
    }
    let id = rd32(b, off + 4)
    if id == 0 {
      cies.put(off, cie_encodings(b, off + 8))
    } else {
      let (fenc, lenc) = cies.get(off + 4 - id) ?? (0x10, -1)
      var at = off + 8
      l.x86_eh_pointer(o, s, base, relocated, at, fenc)
      at += 2 * enc_size(fenc)
      if lenc >= 0 {
        // the augmentation's length, then the LSDA pointer
        at = skip_leb(b, at)
        l.x86_eh_pointer(o, s, base, relocated, at, lenc)
      }
    }
    off += 4 + len
  }
}

/// One pc relative pointer of an x86_64 __eh_frame at offset at, moved
/// with the object section it points into (none for a null LSDA).
fn (var l: Linker) x86_eh_pointer(o: Int, s: ISect, base: Int, relocated: Set[Int], at: Int, enc: Int) {
  if relocated.contains(at) || (enc & 0x70) != 0x10 {
    return
  }
  let size = enc_size(enc)
  let v = if size == 8 { rd64(s.data, at) } else { sext32(rd32(s.data, at)) }
  if v == 0 {
    return
  }
  let t = s.addr + at + v
  var ord = 0
  for (k, os) in l.objs[o].sects.indexed() {
    if t >= os.addr && t < os.addr + os.size {
      ord = k + 1
    }
  }
  if ord == 0 {
    l.fail("${l.objs[o].path}: an __eh_frame pointer outside the object's sections")
    return
  }
  let p = base + at
  l.patch(p, size, (l.translate(o, ord, t) - p) & (if size == 8 { -1 } else { 0xffffffff }))
}

/// A 24 bit field as a signed Int.
fn sext24(v: Int) -> Int {
  if v >= 8388608 { v - 16777216 } else { v }
}

// ---------------------------------------------------------------------------
// Contents

/// Builds the bytes of every output section with the patches and the
/// chained fixups applied, then the unwind info.
fn (var l: Linker) synthesize() {
  l.chain_fixups()
  let ps = l.patches.sort_by(fn(p: Patch) -> Int { p.addr })
  var pi = 0
  for i in 0..l.osects.len() {
    let s = l.osects[i]
    let zero = (s.flags & 0xff) == S_ZEROFILL || (s.flags & 0xff) == S_THREAD_LOCAL_ZEROFILL
    if zero || i == l.s_unwind {
      continue
    }
    var o = new_out(s.size)
    // the pieces of the section: chunks, or the synthetic contents
    var pieces: List[(Int, Bytes)] = []
    if s.chunks.is_empty() {
      pieces.push((0, s.synth))
    } else {
      for (ob, k) in s.chunks {
        pieces.push((l.objs[ob].sects[k].off, l.objs[ob].sects[k].data))
      }
    }
    if i == l.s_got {
      pieces = [(0, zeros(s.size))]
    }
    while pi < ps.len() && ps[pi].addr < s.addr {
      pi += 1
    }
    for (off, data) in pieces {
      o.zeros(off - o.n)
      let base = s.addr + off
      var at = 0
      while pi < ps.len() && ps[pi].addr < base + data.len() {
        let p = ps[pi]
        let rel = p.addr - base
        if rel < at {
          l.fail("overlapping patches at ${p.addr}")
          return
        }
        o.bytes(data[at..rel])
        o.le(p.value, p.size)
        at = rel + p.size
        pi += 1
      }
      o.bytes(data[at..])
    }
    o.zeros(s.size - o.n)
    l.osects[i].bytes = o.done()
  }
  if l.s_unwind >= 0 {
    l.unwind_info()
  }
}

fn zeros(n: Int) -> Bytes {
  var o = new_out(n)
  o.zeros(n)
  o.done()
}

/// The chained fixups as patches: each pointer holds its target and the
/// distance to the next fixup of its page.
fn (var l: Linker) chain_fixups() {
  let fs = l.fixups.sort_by(fn(f: Fixup) -> Int { f.addr })
  l.fixups = fs
  for (k, f) in fs.indexed() {
    if f.addr % 8 != 0 {
      l.fail("a pointer at ${f.addr} is not 8 byte aligned")
      return
    }
    var next = 0
    if k + 1 < fs.len() {
      let n = fs[k + 1]
      if n.addr / PAGE == f.addr / PAGE && l.seg_of(n.addr) == l.seg_of(f.addr) {
        next = (n.addr - f.addr) / 4
      }
    }
    var v = 0
    if f.bind {
      if f.addend < 0 || f.addend > 255 {
        l.fail("a bind addend of ${f.addend}")
        return
      }
      v = f.target | (f.addend * 16777216) | shl(next, 51) | MIN_INT
    } else {
      v = (f.target - IMAGE_BASE) | shl(next, 51)
    }
    l.patch(f.addr, 8, v)
  }
}

fn (l: Linker) seg_of(addr: Int) -> Int {
  for (i, g) in l.segs.indexed() {
    if addr >= g.vmaddr && addr < g.vmaddr + g.vmsize {
      return i
    }
  }
  -1
}

// ---------------------------------------------------------------------------
// The file

/// The executable: the segments' contents, then __LINKEDIT (chained
/// fixups, exports trie, symbols, indirect symbols, names, signature).
fn (var l: Linker) write() -> Bytes {
  // __LINKEDIT
  let le = l.segs.len() - 1
  let le_off = l.segs[le].fileoff
  var link = new_out(4096)
  let fixups = l.fixups_blob()
  let fixups_off = le_off
  link.bytes(fixups)
  link.pad(8)
  let trie_off = le_off + link.n
  let trie = exports_trie()
  link.bytes(trie)
  link.pad(8)
  // symbols: locals, the defined externals, the imports
  let (symtab, strtab, nloc, next, nund, indirect) = l.symbols()
  let sym_off = le_off + link.n
  link.bytes(symtab)
  let ind_off = le_off + link.n
  link.bytes(indirect)
  let str_off = le_off + link.n
  link.bytes(strtab)
  link.pad(16)
  let sig_off = le_off + link.n
  let sig_size = signature_size(sig_off, l.opts.name)
  let link_bytes = link.done()
  l.segs[le].filesize = link_bytes.len() + sig_size
  l.segs[le].vmsize = align_up(l.segs[le].filesize, PAGE)

  // the contents of the segments before __LINKEDIT, after the header
  // and load commands (hl bytes, written last): one buffer, so the file
  // is one more copy, not three (a 3 MB program spent about 4.6 ms of a
  // 21 ms link in fresh buffers, 2026-10-28)
  let hl = 32 + l.cmds_size
  var body = Out{b: BytesBuilder.with_capacity(le_off + link_bytes.len() - hl), n: hl}
  for gi in 1..le {
    let g = l.segs[gi]
    if g.name == "__DWARF" {
      body.zeros(g.fileoff - body.n)
      let lens = l.dwarf_write(body.b)
      for (i, n) in lens.indexed() {
        if i >= l.dw_sizes.len() || n != l.dw_sizes[i] {
          l.fail("internal: DWARF section ${i} is ${n} bytes, ${if i < l.dw_sizes.len() { l.dw_sizes[i] } else { 0 }} reserved")
          return "".bytes()
        }
        body.n += n
      }
      body.zeros(g.fileoff + g.filesize - body.n)
      continue
    }
    for i in g.sects {
      let s = l.osects[i]
      if s.fileoff == 0 {
        continue
      }
      body.zeros(s.fileoff - (body.n + 0))
      body.bytes(s.bytes)
    }
    body.zeros(g.fileoff + g.filesize - body.n)
  }
  body.bytes(link_bytes)
  let rest = body.done()
  // the UUID: a hash of everything but the header (as zeros)
  var uh = crypto.hasher(crypto.Hash.Sha256)
  uh.write(zeros(hl))
  uh.write(rest)
  let uuid = uh.sum()[0..16]
  l.uuid = uuid

  var h = new_out(32 + l.cmds_size)
  var flags = MH_NOUNDEFS + MH_DYLDLINK + MH_TWOLEVEL + MH_PIE
  if l.has_tlv {
    flags += MH_HAS_TLV_DESCRIPTORS
  }
  let ncmds = l.segs.len() + 9 + l.opts.dylibs.len() + l.opts.rpaths.len()
  h.u32(MH_MAGIC_64)
  h.u32(if l.x86 { CPU_TYPE_X86_64 } else { CPU_TYPE_ARM64 })
  h.u32(if l.x86 { 3 } else { 0 })
  h.u32(MH_EXECUTE)
  h.u32(ncmds)
  h.u32(l.cmds_size)
  h.u32(flags)
  h.u32(0)
  for g in l.segs {
    if g.name == "__DWARF" {
      // no access (as Go's), its sections the joined DWARF, each with
      // S_ATTR_DEBUG
      let names = dwarf_names()
      h.u32(LC_SEGMENT_64)
      h.u32(72 + 80 * names.len())
      h.name(g.name, 16)
      h.u64(g.vmaddr)
      h.u64(g.vmsize)
      h.u64(g.fileoff)
      h.u64(g.filesize)
      h.u32(0)
      h.u32(0)
      h.u32(names.len())
      h.u32(0)
      var off = g.fileoff
      for (i, nm) in names.indexed() {
        h.name(nm, 16)
        h.name("__DWARF", 16)
        h.u64(g.vmaddr + off - g.fileoff)
        h.u64(l.dw_sizes[i])
        h.u32(off)
        h.u32(0)
        h.u32(0)
        h.u32(0)
        h.u32(S_ATTR_DEBUG_FLAG)
        h.u32(0)
        h.u32(0)
        h.u32(0)
        off += l.dw_sizes[i]
      }
      continue
    }
    h.u32(LC_SEGMENT_64)
    h.u32(72 + 80 * g.sects.len())
    h.name(g.name, 16)
    h.u64(g.vmaddr)
    h.u64(g.vmsize)
    h.u64(g.fileoff)
    h.u64(g.filesize)
    h.u32(if g.name == "__PAGEZERO" { 0 } else if g.name == "__TEXT" { 5 } else if g.name == "__LINKEDIT" { 1 } else { 3 })
    h.u32(g.prot)
    h.u32(g.sects.len())
    h.u32(g.flags)
    for i in g.sects {
      let s = l.osects[i]
      h.name(s.name, 16)
      h.name(s.seg, 16)
      h.u64(s.addr)
      h.u64(s.size)
      h.u32(s.fileoff)
      h.u32(s.align)
      h.u32(0)
      h.u32(0)
      h.u32(s.flags)
      h.u32(s.reserved1)
      h.u32(s.reserved2)
      h.u32(0)
    }
  }
  h.u32(LC_DYLD_CHAINED_FIXUPS)
  h.u32(16)
  h.u32(fixups_off)
  h.u32(fixups.len())
  h.u32(LC_DYLD_EXPORTS_TRIE)
  h.u32(16)
  h.u32(trie_off)
  h.u32(trie.len())
  h.u32(LC_SYMTAB)
  h.u32(24)
  h.u32(sym_off)
  h.u32(symtab.len() / 16)
  h.u32(str_off)
  h.u32(strtab.len())
  h.u32(LC_DYSYMTAB)
  h.u32(80)
  h.u32(0)
  h.u32(nloc)
  h.u32(nloc)
  h.u32(next)
  h.u32(nloc + next)
  h.u32(nund)
  h.u32(0)
  h.u32(0)
  h.u32(0)
  h.u32(0)
  h.u32(ind_off)
  h.u32(indirect.len() / 4)
  h.u32(0)
  h.u32(0)
  h.u32(0)
  h.u32(0)
  h.u32(0)
  h.u32(0)
  // LC_LOAD_DYLINKER
  h.u32(LC_LOAD_DYLINKER)
  h.u32(32)
  h.u32(12)
  h.name("/usr/lib/dyld", 20)
  // LC_UUID
  h.u32(LC_UUID)
  h.u32(24)
  h.bytes(uuid)
  // LC_BUILD_VERSION: macOS, no tools
  h.u32(LC_BUILD_VERSION)
  h.u32(24)
  h.u32(1)
  let (mj, mn) = l.opts.minos
  h.u32(mj * 65536 + mn * 256)
  let (sj, sn) = l.opts.sdk
  h.u32(sj * 65536 + sn * 256)
  h.u32(0)
  // LC_MAIN
  h.u32(LC_MAIN)
  h.u32(24)
  let entry = match l.globals.get(l.opts.entry.bytes()) {
    Some((o, i)) => l.sym_addr(o, i) - IMAGE_BASE
    None => {
      l.fail("undefined entry point ${l.opts.entry}")
      0
    }
  }
  h.u64(entry)
  h.u64(0)
  // LC_LOAD_DYLIB of each dylib
  for d in l.opts.dylibs {
    let size = align_up(24 + d.len() + 1, 8)
    h.u32(LC_LOAD_DYLIB)
    h.u32(size)
    h.u32(24)
    h.u32(2)
    // the current and compatibility versions: any current version
    // works, 1.0.0 is the compatibility version of every system dylib
    h.u32(if d.contains("libSystem") { 1356 * 65536 } else { 65536 })
    h.u32(65536)
    h.name(d, size - 24)
  }
  // LC_RPATH of each run path entry
  for r in l.opts.rpaths {
    let size = align_up(12 + r.len() + 1, 8)
    h.u32(LC_RPATH)
    h.u32(size)
    h.u32(12)
    h.name(r, size - 12)
  }
  // LC_CODE_SIGNATURE
  h.u32(LC_CODE_SIGNATURE)
  h.u32(16)
  h.u32(sig_off)
  h.u32(sig_size)
  if h.n != 32 + l.cmds_size {
    l.fail("internal: load commands are ${h.n - 32} bytes, expected ${l.cmds_size}")
    return "".bytes()
  }
  // the header and load commands fill the start of __TEXT's first page
  let head = h.done()
  let text = l.segs[1]
  let sig = code_signature(head, rest, l.opts.name, text.fileoff, text.filesize)
  var file = BytesBuilder.with_capacity(head.len() + rest.len() + sig.len())
  file.write(head)
  file.write(rest)
  file.write(sig)
  file.freeze()
}

/// The exports trie: __mh_execute_header at offset 0.
fn exports_trie() -> Bytes {
  var o = new_out(32)
  // root: no terminal, one edge
  o.u8(0)
  o.u8(1)
  o.bytes("__mh_execute_header".bytes())
  o.u8(0)
  o.uleb(23)
  // the node: terminal (flags 0, address 0), no children
  o.u8(2)
  o.u8(0)
  o.u8(0)
  o.u8(0)
  o.pad(8)
  o.done()
}

/// The symbol table (local functions and data, the defined externals and
/// __mh_execute_header, the imports), its names, the counts, and the
/// indirect symbol table of __stubs and __got.
fn (var l: Linker) symbols() -> (Bytes, Bytes, Int, Int, Int, Bytes) {
  var locs: List[(Bytes, Int, Int)] = []
  var exts: List[(Bytes, Int, Int)] = []
  for o in 0..l.objs.len() {
    if !l.objs[o].live {
      continue
    }
    for (i, s) in l.objs[o].syms.indexed() {
      if !is_defined(s) || (s.typ & N_TYPE) != N_SECT || s.name.is_empty() {
        continue
      }
      let c = s.name[0]
      if c == 'l' || c == 'L' {
        continue
      }
      // a part's text markers (arm64 apreempt.xo unsafe_table) share
      // their address with a function, and atos names no symbol at an
      // address with two (xo_f_main, the first function, gave
      // "0x100000948 (in hello)", 2026-10-22)
      if s.name.len() > 10 && s.name[4] == 'u' && (bstr(s.name[0..10]) is "_xo_utext_" | "_xo_utend_") {
        continue
      }
      let sect = l.objs[o].sects[s.sect - 1]
      if sect.out < 0 {
        continue
      }
      let a = l.sym_addr(o, i)
      if is_ext(s) && (s.typ & N_PEXT) == 0 {
        if l.globals.get(s.name) == Some((o, i)) {
          exts.push((s.name, sect.out + 1, a))
        }
      } else if !l.opts.strip {
        // a --release link keeps the local names a traceback reads (the
        // functions in __TEXT,__text) and drops the other local symbols
        if l.opts.release && !l.is_text_sect(sect.out) {
          continue
        }
        locs.push((s.name, sect.out + 1, a))
      }
    }
  }
  exts.push(("__mh_execute_header".bytes(), 1, IMAGE_BASE))
  exts = exts.sort_by(fn(e: (Bytes, Int, Int)) -> Str { bstr(e.0) })
  var st = new_out(16 * (locs.len() + exts.len() + l.imports.len()))
  var names = new_out(64 * (locs.len() + exts.len() + l.imports.len()))
  names.u8(32)
  names.u8(0)
  for (n, sect, a) in locs {
    st.u32(names.n)
    names.bytes(n)
    names.u8(0)
    st.u8(N_SECT)
    st.u8(sect)
    st.u16(0)
    st.u64(a)
  }
  for (n, sect, a) in exts {
    st.u32(names.n)
    names.bytes(n)
    names.u8(0)
    st.u8(N_SECT | N_EXT)
    st.u8(sect)
    st.u16(if bstr(n) == "__mh_execute_header" { REFERENCED_DYNAMICALLY } else { 0 })
    st.u64(a)
  }
  let flat = l.opts.dylibs.len() > 1
  for n in l.imports {
    st.u32(names.n)
    names.bytes(n)
    names.u8(0)
    st.u8(N_EXT)
    st.u8(0)
    // the library ordinal in the high byte (flat lookup: 0xfe), and
    // N_WEAK_REF for a weak import
    st.u16((if flat { 0xfe00 } else { 0x100 }) | (if l.weak_imports.contains(n) { 0x40 } else { 0 }))
    st.u64(0)
  }
  names.pad(8)
  let undef0 = locs.len() + exts.len()
  // the indirect symbols: the stubs, then the GOT slots
  var ind = new_out(4 * (l.stubs.len() + l.got.len()))
  if l.s_stubs >= 0 {
    l.osects[l.s_stubs].reserved1 = 0
    for imp in l.stubs {
      ind.u32(undef0 + imp)
    }
  }
  if l.s_got >= 0 {
    l.osects[l.s_got].reserved1 = l.stubs.len()
    for (imp, _, _) in l.got {
      ind.u32(if imp >= 0 { undef0 + imp } else { INDIRECT_SYMBOL_LOCAL })
    }
  }
  (st.done(), names.done(), locs.len(), exts.len(), l.imports.len(), ind.done())
}

/// LC_DYLD_CHAINED_FIXUPS: the header, the starts of each segment's
/// pages, the imports, and their names.
fn (l: Linker) fixups_blob() -> Bytes {
  // the starts in image: one entry per segment
  var starts = new_out(256)
  let nseg = l.segs.len()
  starts.u32(nseg)
  var seg_infos: List[Bytes] = []
  var offs: List[Int] = []
  var at = 4 + 4 * nseg
  for (gi, g) in l.segs.indexed() {
    var fs: List[Fixup] = []
    for f in l.fixups {
      if f.addr >= g.vmaddr && f.addr < g.vmaddr + g.vmsize && gi > 0 {
        fs.push(f)
      }
    }
    if fs.is_empty() {
      offs.push(0)
      continue
    }
    let pages = g.vmsize / PAGE
    var firsts: List[Int] = []
    for _ in 0..pages {
      firsts.push(0xffff)
    }
    for f in fs {
      let pg = (f.addr - g.vmaddr) / PAGE
      if firsts[pg] == 0xffff {
        firsts[pg] = (f.addr - g.vmaddr) % PAGE
      }
    }
    at = align_up(at, 8)
    offs.push(at)
    var si = new_out(24 + 2 * pages)
    si.u32(22 + 2 * pages)
    si.u16(PAGE)
    // DYLD_CHAINED_PTR_64_OFFSET
    si.u16(6)
    si.u64(g.vmaddr - IMAGE_BASE)
    si.u32(0)
    si.u16(pages)
    for f in firsts {
      si.u16(f)
    }
    let b = si.done()
    seg_infos.push(b)
    at += b.len()
  }
  for x in offs {
    starts.u32(x)
  }
  var pos = 4 + 4 * nseg
  var k = 0
  for x in offs {
    if x == 0 {
      continue
    }
    starts.zeros(x - pos)
    starts.bytes(seg_infos[k])
    pos = x + seg_infos[k].len()
    k += 1
  }
  let sb = starts.done()
  // the imports and their names
  let flat = l.opts.dylibs.len() > 1
  var imps = new_out(4 * l.imports.len())
  var names = new_out(32 * l.imports.len())
  names.u8(0)
  for n in l.imports {
    let ord = if flat { 0xfe } else { 1 }
    // DYLD_CHAINED_IMPORT: the ordinal, weak_import, the name's offset
    imps.u32(ord | (if l.weak_imports.contains(n) { 256 } else { 0 }) | (names.n * 512))
    names.bytes(n)
    names.u8(0)
  }
  let ib = imps.done()
  let nb = names.done()
  var o = new_out(32 + sb.len() + ib.len() + nb.len())
  let starts_off = 32
  let imports_off = align_up(starts_off + sb.len(), 4)
  let symbols_off = imports_off + ib.len()
  o.u32(0)
  o.u32(starts_off)
  o.u32(imports_off)
  o.u32(symbols_off)
  o.u32(l.imports.len())
  // DYLD_CHAINED_IMPORT, uncompressed names
  o.u32(1)
  o.u32(0)
  o.zeros(starts_off - o.n)
  o.bytes(sb)
  o.zeros(imports_off - o.n)
  o.bytes(ib)
  o.bytes(nb)
  o.pad(8)
  o.done()
}
