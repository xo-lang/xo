  ("fabs d0, d1", 0x1e60c020),
  // the exclusive loops of the linux emitter and the outline atomics
  ("ldxr x10, [x9]", 0xc85f7d2a),
  ("ldaxr x1, [x0]", 0xc85ffc01),
  ("stxr w11, x10, [x9]", 0xc80b7d2a),
