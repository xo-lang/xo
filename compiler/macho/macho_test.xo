// Tests of the assembler. The comparison with the system assembler on
// every arm64 golden and on xo1's own assembly is scripts/macho-compare.py
// (decision 0182).

/// The first word of __text of src assembled.
fn first_word(src: Str) -> Int {
  match assemble(src.bytes()) {
    Ok(obj) => {
      // __text is the first section of the one segment
      let off = rd32(obj, 32 + 72 + 48)
      rd32(obj, off)
    }
    Err(e) => fault("does not assemble: ${e}")
  }
}

