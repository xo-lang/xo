test "every instruction encodes as the system assembler encodes it" {
  var bad: List[Str] = []
  for (ins, want) in ENCODINGS {
    let got = first_word("\t${ins}\nL:\n")
    if got != want {
      bad.push("${ins}: got ${hex32(got)}, want ${hex32(want)}")
    }
  }
  expect(bad) == []
}

fn hex32(v: Int) -> Str {
  let digits = "0123456789abcdef"
  var s = ""
  for i in 0..8 {
    let d = (v >> (4 * (7 - i))) & 15
    s = s + digits[d..d + 1]
  }
  s
}

test "logical immediates" {
  expect(logical_imm(0xff, 64)) == Some(0x1007)
  expect(logical_imm(1, 64)) == Some(0x1000)
  expect(logical_imm(0x5555555555555555, 64)) == Some(0x3c)
  expect(logical_imm(0, 64)) == None
  expect(logical_imm(-1, 64)) == None
  expect(logical_imm(5, 64)) == None
  expect(logical_imm(0xffff, 32)) == Some(0xf)
}

test "integers parse in decimal and hex, to the 64 bit extremes" {
  expect(parse_int("-9223372036854775808".bytes())) == Some(MIN_INT)
  expect(parse_int("9223372036854775807".bytes())) == Some(9223372036854775807)
  expect(parse_int("9223372036854775808".bytes())) == None
  expect(parse_int("0xff".bytes())) == Some(255)
  expect(parse_int("-0x10".bytes())) == Some(-16)
  expect(parse_int("12a".bytes())) == None
}

test "a frame with lr and fp at its base is compact, the emitter's frames are DWARF" {
  let leaf = "_f:\n\t.cfi_startproc\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\tldp x29, x30, [sp], #16\n\tret\n\t.cfi_endproc\n"
  var a = Asm{}
  a.parse(leaf.bytes())
  expect(a.err) == ""
  expect(a.compact_encoding(a.frames[0])) == UNWIND_ARM64_MODE_FRAME
  let xo = "_g:\n\t.cfi_startproc\n\tstp x29, x30, [sp, #-32]!\n\tmov x29, sp\n\tstp x20, x19, [sp, #16]\n\t.cfi_def_cfa w29, 32\n\t.cfi_offset w29, -32\n\t.cfi_offset w30, -24\n\t.cfi_offset w20, -16\n\t.cfi_offset w19, -8\n\tret\n\t.cfi_endproc\n"
  var b = Asm{}
  b.parse(xo.bytes())
  expect(b.compact_encoding(b.frames[0])) == UNWIND_ARM64_MODE_DWARF
  // callee saved pairs below fp and lr, as LLVM writes them
  let pairs = "_h:\n\t.cfi_startproc\n\t.cfi_def_cfa w29, 32\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n\t.cfi_offset w19, -24\n\t.cfi_offset w20, -32\n\tret\n\t.cfi_endproc\n"
  var c = Asm{}
  c.parse(pairs.bytes())
  expect(c.compact_encoding(c.frames[0])) == UNWIND_ARM64_MODE_FRAME + 1
}

test "ULEB128 differences settle and branches resolve" {
  let src = "_f:\n\tb L2\nL1:\n\tnop\nL2:\n\tret\n\t.section __TEXT,__gcc_except_tab\n\t.uleb128 L2-L1\n\t.uleb128 Le-Ls\nLs:\n\t.ascii \"${"a".repeat(136)}\"\nLe:\n"
  var a = Asm{}
  a.parse(src.bytes())
  a.finish()
  expect(a.err) == ""
  // b L2: two words ahead
  expect(a.sects[0].words[0]) == 0x14000002
  // 4, then 136 as two bytes, then the string
  let t = a.sects[1].bytes
  expect(Int(t[0])) == 4
  expect(Int(t[1])) == 0x88
  expect(Int(t[2])) == 1
  expect(t.len()) == 3 + 136
}

test "errors name the line" {
  expect(assemble("\tnop\n\tfrobnicate x0\n".bytes())) == Err("line 2: unsupported instruction: frobnicate x0")
  expect(assemble("\tb Lnowhere\n".bytes())) == Err("Lnowhere is used but not defined")
  expect(assemble("\tadd x0, x1, #5000\n".bytes())) == Err("line 1: unsupported instruction: add x0, x1, #5000")
}

// ---------------------------------------------------------------------------
// ELF (decision 0182 stage 3). The comparison with clang on every golden
// and on xo1's linux assembly is scripts/elf-compare.py; running the
// linked goldens on Linux is scripts/elf-goldens.py.

/// A small program in the linux emitter's syntax: a numeric label loop,
/// a page and :lo12: pair, a call to an undefined function, a frame with
/// a personality and LSDA, and a pointer in .rodata.
const ELF_SRC = """
\t.text
\t.p2align 2
\t.type f, %function
f:
.Lf_begin:
\t.cfi_startproc
\t.cfi_personality 155, DW.ref.xo_personality
\t.cfi_lsda 27, .Lf_lsda
\tstp x29, x30, [sp, #-16]!
\tmov x29, sp
\t.cfi_def_cfa w29, 16
\t.cfi_offset w30, -8
\t.cfi_offset w29, -16
\tadrp x0, .Ls
\tadd x0, x0, :lo12:.Ls
1:
\tldaxr x1, [x0]
\tstlxr w2, x1, [x0]
\tcbnz w2, 1b
\tbl puts
\tldp x29, x30, [sp], #16
\tret
\t.cfi_endproc
\t.section .gcc_except_table,"a",@progbits
\t.p2align 2
.Lf_lsda:
\t.byte 255
\t.byte 255
\t.byte 1
\t.uleb128 0
\t.hidden DW.ref.xo_personality
\t.weak DW.ref.xo_personality
\t.section .data.DW.ref.xo_personality,"awG",@progbits,DW.ref.xo_personality,comdat
\t.p2align 3
\t.type DW.ref.xo_personality, @object
\t.size DW.ref.xo_personality, 8
DW.ref.xo_personality:
\t.xword xo_personality
\t.section .rodata
\t.p2align 3
.Ls:
\t.quad .Ls
\t.section .note.GNU-stack,"",@progbits
"""

fn elf_obj(src: Str) -> EObj {
  match assemble_elf(src.bytes()) {
    Ok(b) => match parse_elf_object("t.o", b) {
      Ok(o) => o
      Err(e) => fault("does not parse: ${e}")
    }
    Err(e) => fault("does not assemble: ${e}")
  }
}

fn sect_named(o: EObj, name: Str) -> ESect {
  for s in o.sects {
    if s.name == name {
      return s
    }
  }
  fault("no section ${name}")
}

test "an ELF object has LLVM's sections, symbols, and relocations" {
  let o = elf_obj(ELF_SRC)
  var names: List[Str] = []
  for s in o.sects {
    names.push(s.name)
  }
  expect(names) == ["", ".strtab", ".text", ".rela.text", ".gcc_except_table", ".group", ".data.DW.ref.xo_personality", ".rela.data.DW.ref.xo_personality", ".rodata", ".rela.rodata", ".note.GNU-stack", ".eh_frame", ".rela.eh_frame", ".symtab"]
  // adrp and add to the .rodata section symbol, the call to puts; the
  // loop's branch resolved
  var types: List[Int] = []
  for r in sect_named(o, ".text").relocs {
    types.push(r.typ)
  }
  expect(types) == [R_AARCH64_ADR_PREL_PG_HI21, R_AARCH64_ADD_ABS_LO12_NC, R_AARCH64_CALL26]
  expect(rd32(sect_named(o, ".text").data, 24)) == 0x35ffffc2
  // the personality pointer, then the FDE's pc and LSDA
  var eh: List[Int] = []
  for r in sect_named(o, ".eh_frame").relocs {
    eh.push(r.typ)
  }
  expect(eh) == [R_AARCH64_PREL32, R_AARCH64_PREL32, R_AARCH64_PREL32]
  // mapping symbols and the local function, then the weak hidden
  // DW.ref and the undefined names
  var syms: List[Str] = []
  for s in o.syms {
    if !s.name.is_empty() {
      syms.push(bstr(s.name))
    }
  }
  expect(syms) == ["f", "$x", "$d", "$d", "$d", "$d", "puts", "DW.ref.xo_personality", "xo_personality"]
}

test "a .file directive is an STT_FILE symbol first in the symbol table" {
  // the linux emitter's first line (gotcha linux-arm64-file-symbol)
  let o = elf_obj("\t.file \"prog.s\"\n\t.text\n\t.globl main\nmain:\n\tret\n")
  var syms: List[(Str, Int, Int)] = []
  for s in o.syms {
    if !s.name.is_empty() {
      syms.push((bstr(s.name), s.info, s.shndx))
    }
  }
  // prog.s: STB_LOCAL STT_FILE in SHN_ABS; main: STB_GLOBAL, in .text
  expect(syms[0]) == ("prog.s", 4, 0xfff1)
  expect(syms[syms.len() - 1].0) == "main"
  match assemble_elf("\t.file prog.s\n".bytes()) {
    Ok(_) => fault("an unquoted .file assembled")
    Err(e) => expect(e.contains(".file takes a quoted name")) == true
  }
}

test "a .data directive switches to a writable .data section" {
  // the linux emitter's `.data` (G.section "data"); every network
  // golden of the ELF run failed on it before (2026-10-14)
  let o = elf_obj("\t.text\n\t.globl main\nmain:\n\tret\n\t.data\n\t.p2align 3\nv:\n\t.quad 7\n")
  let d = sect_named(o, ".data")
  expect(d.data.len()) == 8
  expect(rd32(d.data, 0)) == 7
}

test "numeric labels go back to the last definition and forward to the next" {
  let o = elf_obj("\tb 1f\n1:\n\tb 1b\n1:\n\tb 1b\n")
  let t = sect_named(o, ".text").data
  expect(rd32(t, 0)) == 0x14000001
  expect(rd32(t, 4)) == 0x14000000
  expect(rd32(t, 8)) == 0x14000000
}

test "the outline atomics assemble" {
  for n in ["__aarch64_cas4_acq", "__aarch64_cas8_acq_rel", "__aarch64_swp4_rel", "__aarch64_ldadd8_relax", "__aarch64_ldclr4_acq", "__aarch64_ldset8_rel", "__aarch64_ldeor8_acq_rel"] {
    match outline_atomic(n) {
      Some(src) => expect(assemble_elf(src.bytes()).is_ok()) == true
      None => fault("no ${n}")
    }
  }
  expect(outline_atomic("__aarch64_cas16_acq")) == None
  expect(outline_atomic("__aarch64_cas4_sync")) == None
}

test "a linked executable loads glibc and binds versioned imports" {
  let main = "\t.text\n\t.globl main\n\t.p2align 2\n\t.type main, %function\nmain:\n\tstp x29, x30, [sp, #-16]!\n\tadrp x0, .Lhi\n\tadd x0, x0, :lo12:.Lhi\n\tbl puts\n\tbl __aarch64_ldadd8_acq_rel\n\tmov x0, #0\n\tldp x29, x30, [sp], #16\n\tret\n\t.section .rodata\n.Lhi:\n\t.asciz \"hi\"\n"
  let obj = match assemble_elf(main.bytes()) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  let exe = match link_elf([LinkInput{path: "main.o", data: obj}], ElfLinkOpts{}) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  // ET_EXEC, arm64, the entry in the code segment
  expect(rd16(exe, 16)) == ET_EXEC
  expect(rd16(exe, 18)) == 183
  expect(rd64(exe, 24) > ELF_BASE) == true
  // PT_PHDR, PT_INTERP naming the loader, three PT_LOADs
  let phnum = rd16(exe, 56)
  var types: List[Int] = []
  for i in 0..phnum {
    types.push(rd32(exe, 64 + 56 * i))
  }
  expect(types[0..5]) == [PT_PHDR, PT_INTERP, PT_LOAD, PT_LOAD, PT_LOAD]
  let ip = rd64(exe, 64 + 56 + 8)
  expect(bstr(cstr(exe, ip))) == "/lib/ld-linux-aarch64.so.1"
  // puts and __libc_start_main from libc.so.6 at GLIBC_2.17
  expect(has(exe, "puts")) == true
  expect(has(exe, "__libc_start_main")) == true
  expect(has(exe, "GLIBC_2.17")) == true
  expect(has(exe, "libc.so.6")) == true
}

test "stat, fstat, and lstat call glibc's __xstat family, as libc_nonshared.a does" {
  let main = "\t.text\n\t.globl main\n\t.p2align 2\n\t.type main, %function\nmain:\n\tstp x29, x30, [sp, #-16]!\n\tbl stat\n\tbl fstat\n\tbl lstat\n\tmov x0, #0\n\tldp x29, x30, [sp], #16\n\tret\n"
  let obj = assemble_elf(main.bytes()).or_fault("assemble")
  let exe = match link_elf([LinkInput{path: "main.o", data: obj}], ElfLinkOpts{}) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  expect(has(exe, "__xstat")) == true
  expect(has(exe, "__fxstat")) == true
  expect(has(exe, "__lxstat")) == true
  expect(nonshared("stat", false)) == Some("\t.globl stat\n\t.p2align 2\n\t.type stat, %function\nstat:\n\tmov x2, x1\n\tmov x1, x0\n\tmov w0, #0\n\tb __xstat\n")
  expect(nonshared("puts", false)) == None
}

/// b holds the bytes of s.
fn has(b: Bytes, s: Str) -> Bool {
  let n = s.bytes()
  var i = 0
  while i + n.len() <= b.len() {
    if b[i..i + n.len()] == n {
      return true
    }
    i += 1
  }
  false
}

test "glibc versions: libm and libgcc_s names, libc's default" {
  let v = glibc_versions(false)
  expect(v.get("fmod".bytes())) == Some(("libm.so.6", "GLIBC_2.17"))
  expect(v.get("_Unwind_RaiseException".bytes())) == Some(("libgcc_s.so.1", "GCC_3.0"))
  expect(v.get("getrandom".bytes())) == Some(("libc.so.6", "GLIBC_2.25"))
  expect(v.get("malloc".bytes())) == None
}

test "a COMDAT group is kept once, a symbol defined twice is an error" {
  let pers = "\t.hidden DW.ref.xo_personality\n\t.weak DW.ref.xo_personality\n\t.section .data.DW.ref.xo_personality,\"awG\",@progbits,DW.ref.xo_personality,comdat\n\t.p2align 3\nDW.ref.xo_personality:\n\t.xword xo_personality\n"
  let a = "\t.text\n\t.globl main\nmain:\n\tbl g\n\tret\n\t.globl xo_personality\nxo_personality:\n\tret\n" + pers
  let b = "\t.text\n\t.globl g\ng:\n\tret\n" + pers
  let oa = assemble_elf(a.bytes()).or_fault("a")
  let ob = assemble_elf(b.bytes()).or_fault("b")
  expect(link_elf([LinkInput{path: "a.o", data: oa}, LinkInput{path: "b.o", data: ob}], ElfLinkOpts{}).is_ok()) == true
  expect(link_elf([LinkInput{path: "a.o", data: oa}, LinkInput{path: "a2.o", data: oa}], ElfLinkOpts{})) == Err("main is defined in a.o and in a2.o")
}

test "a static link: no loader, weak hooks a nop and a ret, -s drops locals" {
  // decision 0243: the program's own _start; __hook_a called, __hook_b
  // tail called, both weak and undefined; a local function helper
  let src = "\t.text\n\t.globl _start\n\t.type _start, %function\n_start:\n\tbl helper\n\tbl __hook_a\n\tb __hook_b\n\t.type helper, %function\nhelper:\n\tret\n\t.weak __hook_a\n\t.weak __hook_b\n"
  let obj = assemble_elf(src.bytes()).or_fault("assemble")
  let exe = match link_elf([LinkInput{path: "s.o", data: obj}], ElfLinkOpts{static: true}) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  // PT_PHDR then the loads: no PT_INTERP, no PT_DYNAMIC
  let phnum = rd16(exe, 56)
  var types: List[Int] = []
  for i in 0..phnum {
    types.push(rd32(exe, 64 + 56 * i))
  }
  expect(types.contains(PT_INTERP)) == false
  expect(types.contains(PT_DYNAMIC)) == false
  expect(types[0..4]) == [PT_PHDR, PT_LOAD, PT_LOAD, PT_LOAD]
  // the entry is _start: bl helper, then the hooks' nop and ret
  let entry = rd64(exe, 24)
  let off = entry - ELF_BASE
  expect(rd32(exe, off + 4)) == 0xd503201f
  expect(rd32(exe, off + 8)) == 0xd65f03c0
  expect(has(exe, "helper")) == true
  // -s: the local helper is gone from .symtab, _start stays
  let st = match link_elf([LinkInput{path: "s.o", data: obj}], ElfLinkOpts{static: true, strip: true}) {
    Ok(b) => b
    Err(e) => fault(e)
  }
  expect(has(st, "helper")) == false
  expect(has(st, "_start")) == true
  // a strong undefined symbol is an error
  let bad = assemble_elf("\t.text\n\t.globl _start\n_start:\n\tbl puts\n".bytes()).or_fault("bad")
  expect(link_elf([LinkInput{path: "b.o", data: bad}], ElfLinkOpts{static: true})) == Err("puts is not defined (a static link with no C library)")
}

test "a function without .size gets its extent: to the next named symbol or the section's end" {
  // valgrind and perf name an address by a symbol whose extent holds it
  // (callgrind showed every Xo function as ??? with sizes of 0)
  let o = elf_obj("\t.text\n\t.globl f\n\t.type f, %function\nf:\n\tnop\n\tnop\n\tret\nh:\n\tret\n\t.globl g\n\t.type g, %function\ng:\n\tnop\n\tret\n\t.globl k\n\t.type k, %function\nk:\n\tret\n\t.size k, 12\n")
  var sizes: Map[Str, Int] = {}
  for s in o.syms {
    sizes.put(s.name.to_str() ?? "", s.size)
  }
  // f stops at the untyped label h, g at k, k keeps its .size
  expect(sizes.get("f")) == Some(12)
  expect(sizes.get("g")) == Some(8)
  expect(sizes.get("k")) == Some(12)
}
