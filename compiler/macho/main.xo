// macho: the self hosted Mach-O assembler and linker of decision 0182.
//
//   macho asm [-o OUT.o] [--minos=X.Y] [--elf] [--amd64] [--bench=N] IN.s
//       assemble the arm64 emitter's assembly into an object (--elf: its
//       linux/arm64 assembly into an ELF object; --darwin-amd64:
//       darwin/amd64 assembly into a Mach-O x86_64 object; --amd64: linux/amd64
//       assembly into an ELF object)
//   macho link -o OUT [--minos=X.Y] [--sdk=X.Y] [--dylib=PATH...] IN.o|IN.a...
//       link objects and archives into an executable (libSystem, and each
//       --dylib, imported)
//   macho pelink -o OUT.exe --entry=SYM [--import=SYM=DLL...] [--manifest]
//     [--version=A.B.C.D] [--icon=FILE.ico] IN.obj...
//       link windows/amd64 COFF objects into a PE32+ executable (decision
//       0254 6b step 4; each imported function named with its DLL)
//   macho elflink -o OUT [--interp=PATH] [--static] IN.o|IN.a...
//       link linux/arm64 ELF objects and archives into an executable
//       (glibc imported)
//
// The package is also the library xo1 (compiler/xo) calls: assemble, link,
// assemble_elf, link_elf.

fn main(os: Os) ! {
  let args = os.env.args()
  if !args.is_empty() && args[0] == "link" {
    link_main(os, args)?
    return
  }
  if !args.is_empty() && args[0] == "elflink" {
    elflink_main(os, args)?
    return
  }
  if !args.is_empty() && args[0] == "pelink" {
    pelink_main(os, args)?
    return
  }
  if args.is_empty() || args[0] != "asm" {
    usage(os)
  }
  var out = ""
  var repeat = 0
  var minos = (11, 0)
  var ins: List[Str] = []
  var elf = false
  var amd64 = false
  var macho_amd64 = false
  var coff_amd64 = false
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "-o" && i + 1 < args.len() {
      out = args[i + 1]
      i += 1
    } else if a.starts_with("--minos=") {
      minos = version(a.trim_prefix("--minos="))
    } else if a == "--elf" {
      elf = true
    } else if a == "--darwin-amd64" {
      // darwin/amd64 assembly into a Mach-O x86_64 object (stage 6a)
      macho_amd64 = true
    } else if a == "--windows-amd64" {
      // windows/amd64 assembly into a COFF object (decision 0254 6b)
      coff_amd64 = true
    } else if a == "--amd64" {
      // linux/amd64 assembly into an ELF object (decision 0254)
      amd64 = true
    } else if a.starts_with("--bench=") {
      repeat = Int.parse(a.trim_prefix("--bench=")) ?? 0
    } else {
      ins.push(a)
    }
    i += 1
  }
  if ins.len() != 1 {
    usage(os)
  }
  let src = os.fs.read(ins[0])?
  if repeat > 0 {
    let t0 = os.clock.now()
    var size = 0
    for _ in 0..repeat {
      match if coff_amd64 { assemble_coff_amd64(src) } else if macho_amd64 { assemble_macho_amd64(src, minos) } else if amd64 { assemble_elf_amd64(src) } else if elf { assemble_elf(src) } else { assemble_for(src, minos) } {
        Ok(b) => size = b.len()
        Err(e) => fail(os, "${ins[0]}: ${e}")
      }
    }
    let el = os.clock.now() - t0
    os.stdio.println("assembled ${ins[0]} x ${repeat}: ${size} bytes, ${el.nanos() / 1000000 / repeat} ms each")
    return
  }
  if out.is_empty() {
    out = ins[0].trim_suffix(".s") + ".o"
  }
  match if coff_amd64 { assemble_coff_amd64(src) } else if macho_amd64 { assemble_macho_amd64(src, minos) } else if amd64 { assemble_elf_amd64(src) } else if elf { assemble_elf(src) } else { assemble_for(src, minos) } {
    Ok(b) => os.fs.write(out, b)?
    Err(e) => fail(os, "${ins[0]}: ${e}")
  }
}

fn version(s: Str) -> (Int, Int) {
  let v = s.split(".")
  (Int.parse(v[0]) ?? 11, if v.len() > 1 { Int.parse(v[1]) ?? 0 } else { 0 })
}

fn link_main(os: Os, args: List[Str]) -> () ! FsErr {
  var out = ""
  var opts = LinkOpts{name: ""}
  var dylibs = ["/usr/lib/libSystem.B.dylib"]
  var ins: List[LinkInput] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "-o" && i + 1 < args.len() {
      out = args[i + 1]
      i += 1
    } else if a.starts_with("--minos=") {
      opts.minos = version(a.trim_prefix("--minos="))
    } else if a.starts_with("--sdk=") {
      opts.sdk = version(a.trim_prefix("--sdk="))
    } else if a.starts_with("--dylib=") {
      dylibs.push(a.trim_prefix("--dylib="))
    } else {
      ins.push(LinkInput{path: a, data: os.fs.read(a)?})
    }
    i += 1
  }
  if out.is_empty() || ins.is_empty() {
    usage(os)
  }
  opts.dylibs = dylibs
  let parts = out.split("/")
  opts.name = parts[parts.len() - 1]
  match link(ins, opts) {
    Ok(b) => {
      // a new file, not one overwritten in place: the kernel caches the
      // signature of a file it has run
      let tmp = "${out}.tmp"
      os.fs.write(tmp, b)?
      os.fs.set_mode(tmp, 0o755)?
      os.fs.rename(tmp, out)?
    }
    Err(e) => fail(os, e)
  }
}

fn elflink_main(os: Os, args: List[Str]) -> () ! FsErr {
  var out = ""
  var opts = ElfLinkOpts{}
  var ins: List[LinkInput] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "-o" && i + 1 < args.len() {
      out = args[i + 1]
      i += 1
    } else if a.starts_with("--interp=") {
      opts.interp = a.trim_prefix("--interp=")
    } else if a == "--static" {
      // no loader, no imports (decision 0243; x86-64 links only this way)
      opts.static = true
    } else {
      ins.push(LinkInput{path: a, data: os.fs.read(a)?})
    }
    i += 1
  }
  if out.is_empty() || ins.is_empty() {
    usage(os)
  }
  match link_elf(ins, opts) {
    Ok(b) => {
      let tmp = "${out}.tmp"
      os.fs.write(tmp, b)?
      os.fs.set_mode(tmp, 0o755)?
      os.fs.rename(tmp, out)?
    }
    Err(e) => fail(os, e)
  }
}

fn usage(os: Os) -> Never {
  os.stdio.eprintln("usage: macho asm [-o OUT.o] [--minos=X.Y] [--elf] [--bench=N] IN.s")
  os.stdio.eprintln("       macho link -o OUT [--minos=X.Y] [--sdk=X.Y] [--dylib=PATH...] IN.o|IN.a...")
  os.stdio.eprintln("       macho elflink -o OUT [--interp=PATH] [--static] IN.o|IN.a...")
  os.proc.exit(2)
}

fn fail(os: Os, msg: Str) -> Never {
  os.stdio.eprintln("macho: ${msg}")
  os.proc.exit(1)
}

fn pelink_main(os: Os, args: List[Str]) -> () ! FsErr {
  var out = ""
  var opts = PEOpts{entry: "", imports: {}}
  var objs: List[CObj] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "-o" && i + 1 < args.len() {
      out = args[i + 1]
      i += 1
    } else if a.starts_with("--entry=") {
      opts.entry = a.trim_prefix("--entry=")
    } else if a.starts_with("--import=") {
      let kv = a.trim_prefix("--import=").split("=")
      if kv.len() == 2 {
        opts.imports[kv[0]] = kv[1]
      }
    } else if a == "--manifest" {
      opts.resources.push(PERes{typ: RT_MANIFEST, id: 1, data: pe_manifest()})
    } else if a.starts_with("--version=") {
      var parts: List[Int] = []
      for f in a.trim_prefix("--version=").split(".") {
        parts.push(Int.parse(f) ?? 0)
      }
      opts.resources.push(PERes{typ: RT_VERSION, id: 1, data: pe_version(parts, [("FileVersion", a.trim_prefix("--version="))])})
    } else if a.starts_with("--icon=") {
      let p = a.trim_prefix("--icon=")
      match pe_icon(os.fs.read(p)?) {
        Ok(rs) => opts.resources = opts.resources + rs
        Err(e) => fail(os, "${p}: ${e}")
      }
    } else {
      match read_coff(a, os.fs.read(a)?) {
        Ok(o) => objs.push(o)
        Err(e) => fail(os, e)
      }
    }
    i += 1
  }
  if out.is_empty() || objs.is_empty() || opts.entry.is_empty() {
    usage(os)
  }
  match link_pe(objs, opts) {
    Ok(b) => os.fs.write(out, b)?
    Err(e) => fail(os, e)
  }
}
