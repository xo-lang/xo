// std's indexed store (decision 0388 stage 4): std's objects, made with
// `.subsections_via_symbols`, split into atoms once (strip.xo atomize),
// with each atom's edges (what its relocations reach, and what its FDE,
// compact unwind entry and unsafe range record name) resolved to atoms of
// the store. A link through the store walks the edges from what the
// program's objects name and the entry, and reads only the live atoms'
// bytes and relocations; a dead atom stays as an empty section (dead), so
// the ordinals the relocations and DWARF name hold. The program's objects
// are kept whole. link_store gives the bytes link_debug gives for the
// store's objects and the program's, byte for byte.
//
// The file: STORE_MAGIC, then a header region the link reads in full and
// a data region it reads by offset (the live atoms', and the sections
// never split: DWARF, __eh_frame, compact unwind). All integers are
// little-endian u32, addresses and values u64.

// the file's format: a new one for every change of its layout (a store
// from an older xo then fails cleanly, `not an xo std store`, instead of
// being misread: gotchas/store-format-magic.md)
const STORE_MAGIC = "XOSTORE4"

fn sw32(var b: BytesBuilder, v: Int) {
  b.write_byte(UInt8(v & 255))
  b.write_byte(UInt8((v >> 8) & 255))
  b.write_byte(UInt8((v >> 16) & 255))
  b.write_byte(UInt8((v >> 24) & 255))
}

fn sw64(var b: BytesBuilder, v: Int) {
  sw32(b, v & 0xffffffff)
  sw32(b, (v >> 32) & 0xffffffff)
}

fn swbytes(var b: BytesBuilder, x: Bytes) {
  sw32(b, x.len())
  b.write(x)
}

/// A reader of the header region.
struct SR {
  b: Bytes
  at: Int = 0
}

fn (var r: SR) u32() -> Int {
  let v = rd32(r.b, r.at)
  r.at += 4
  v
}

fn (var r: SR) u64() -> Int {
  let v = rd64(r.b, r.at)
  r.at += 8
  v
}

fn (var r: SR) bytes() -> Bytes {
  let n = r.u32()
  let v = r.b[r.at..r.at + n]
  r.at += n
  v
}

/// A relocation in 12 bytes: its address, its symbol or ordinal, and its
/// flags (pcrel, len, ext, the type).
fn sw_reloc(var b: BytesBuilder, x: IReloc) {
  sw32(b, x.addr)
  sw32(b, x.sym)
  sw32(b, (if x.pcrel { 1 } else { 0 }) | (x.len << 1) | (if x.ext { 8 } else { 0 }) | (x.typ << 4))
}

fn rd_reloc(b: Bytes, at: Int) -> IReloc {
  let f = rd32(b, at + 8)
  IReloc{addr: rd32(b, at), sym: rd32(b, at + 4), pcrel: (f & 1) != 0, len: (f >> 1) & 3, ext: (f & 8) != 0, typ: f >> 4}
}

/// store_encode: the store of objects (each made with
/// `.subsections_via_symbols`), or the first error.
pub fn store_encode(inputs: List[LinkInput]) -> Result[Bytes, Str] {
  var l = Linker{opts: LinkOpts{name: "store"}}
  for inp in inputs {
    match parse_object(inp.path, inp.data) {
      Ok(o) => {
        if !o.subsections {
          return Err("${inp.path}: not made with .subsections_via_symbols")
        }
        l.objs.push(o)
      }
      Err(e) => return Err(e)
    }
  }
  let n = l.objs.len()
  // the store's own definitions only: what it does not define (the
  // program's, imports) is no edge, the program's objects being whole
  for o in 0..n {
    l.add_globals(o)
  }
  if !l.err.is_empty() {
    return Err(l.err)
  }
  for o in 0..n {
    l.atomize(o)
  }
  var base: List[Int] = []
  var total = 0
  for ob in l.objs {
    base.push(total)
    total += ob.sects.len()
  }
  let unw = l.unwind_refs()
  // the global definitions (a strong one over a weak one, else the
  // first, as add_globals)
  var gdefs: Map[Bytes, (Int, Bool)] = {}
  var gorder: List[Bytes] = []
  for (o, ob) in l.objs.indexed() {
    for x in ob.syms {
      if is_ext(x) && is_defined(x) && (x.typ & N_TYPE) == N_SECT && x.sect >= 1 {
        let weak = (x.desc & 0x80) != 0
        match gdefs.get(x.name) {
          Some((_, w)) => if w && !weak {
            gdefs[x.name] = (base[o] + x.sect - 1, false)
          }
          None => {
            gdefs[x.name] = (base[o] + x.sect - 1, weak)
            gorder.push(x.name)
          }
        }
      }
    }
  }
  var defs: List[(Bytes, Int)] = []
  for nm in gorder {
    defs.push((nm, (gdefs.get(nm) ?? (0, false)).0))
  }
  var objs: List[CoreObj] = []
  for (o, ob) in l.objs.indexed() {
    let segs = l.dw_all_segs(o)
    var cs: List[CoreSect] = []
    for (k, s) in ob.sects.indexed() {
      var c = CoreSect{seg: s.seg, name: s.name, align: s.align, flags: s.flags, addr: s.addr, size: s.size, data: s.data, relocs: "".bytes(), nrel: 0}
      // a cut DWARF section's relocations go with its runs, by address,
      // so its patches are one run in order (out.xo patches_in_order)
      let g = segs.get(k) ?? []
      if g.is_empty() {
        var rb = BytesBuilder.new()
        for r in s.relocs {
          sw_reloc(rb, r)
        }
        c.relocs = rb.freeze()
        c.nrel = s.relocs.len()
      }
      for x in g {
        var rs: List[IReloc] = []
        for r in s.relocs {
          if r.addr >= x.start && r.addr < x.end {
            rs.push(r)
          }
        }
        var rb = BytesBuilder.new()
        for r in rs.sort_by(fn(r: IReloc) -> Int { r.addr }) {
          sw_reloc(rb, r)
        }
        c.runs.push(CoreRun{start: x.start, end: x.end, fn_atom: if x.fo < 0 { -1 } else { base[x.fo] + x.fk }, typ: x.typ, refs: x.refs, relocs: rb.freeze(), nrel: rs.len()})
      }
      // its edges, as store atom numbers
      var refs: List[(Int, Int)] = []
      if !(s.seg == "__LD" || s.seg == "__DWARF" || (s.flags & S_ATTR_DEBUG_FLAG) != 0 || is_eh(s)) {
        for r in s.relocs {
          refs.push(l.reloc_sect(o, s, r))
        }
      }
      for t in unw.get((o, k)) ?? [] {
        refs.push(t)
      }
      var seen: Set[Int] = #{}
      for (d, j) in refs {
        if d < 0 {
          continue
        }
        if j < 0 {
          for (_, m) in l.objs[d].split.get(-1 - j) ?? [] {
            let id = base[d] + m - 1
            if !seen.contains(id) {
              seen.add(id)
              c.edges.push(id)
            }
          }
          continue
        }
        let id = base[d] + j
        if !seen.contains(id) {
          seen.add(id)
          c.edges.push(id)
        }
      }
      cs.push(c)
    }
    var syms: List[CoreSym] = []
    for x in ob.syms {
      syms.push(CoreSym{name: x.name, typ: x.typ, sect: x.sect, desc: x.desc, value: x.value})
    }
    // its xo unit's functions, when the unit goes with them
    var fns: List[Int] = []
    for (k, g) in segs {
      if ob.sects[k].name == "__debug_info" && dw_droppable(g) {
        for x in g {
          if x.fo >= 0 {
            fns.push(base[x.fo] + x.fk)
          }
        }
      }
    }
    objs.push(CoreObj{path: ob.path, sects: cs, syms: syms, split: ob.split, unit_fns: fns})
  }
  Ok(store_write(objs, defs, 12))
}

/// A section's record in the header: its name's index, alignment,
/// flags, its bytes' place and length and its relocations' place and
/// count in the data region, its cut runs' count and place (dwtrim.xo),
/// its address and size.
const STORE_REC = 52

/// A symbol's record: its name's place and length in the data region,
/// its type, section (an atom's ordinal), desc and value.
const STORE_SYM = 28

/// The atom of the global definition named name in the store's sorted
/// table (nd records of 12 bytes at dt), -1 for none.
fn store_def(store: Bytes, data0: Int, dt: Int, nd: Int, name: Bytes) -> Int {
  var lo = 0
  var hi = nd
  while lo < hi {
    let m = (lo + hi) / 2
    let q = dt + 12 * m
    let c = cmp_at(store, data0 + rd32(store, q), rd32(store, q + 4), name)
    if c == 0 {
      return rd32(store, q + 8)
    }
    if c < 0 {
      lo = m + 1
    } else {
      hi = m
    }
  }
  -1
}

/// store[at..at + n] against b, as bytes: -1, 0 or 1 (no copy).
fn cmp_at(store: Bytes, at: Int, n: Int, b: Bytes) -> Int {
  let k = if n < b.len() { n } else { b.len() }
  for i in 0..k {
    let x = Int(store[at + i])
    let y = Int(b[i])
    if x != y {
      return if x < y { -1 } else { 1 }
    }
  }
  if n == b.len() { 0 } else if n < b.len() { -1 } else { 1 }
}

/// The fields of the section record at q (STORE_REC).
fn rec_name(b: Bytes, q: Int) -> Int { rd32(b, q) }
fn rec_align(b: Bytes, q: Int) -> Int { rd32(b, q + 4) }
fn rec_flags(b: Bytes, q: Int) -> Int { rd32(b, q + 8) }
fn rec_data_at(b: Bytes, q: Int) -> Int { rd32(b, q + 12) }
fn rec_data_len(b: Bytes, q: Int) -> Int { rd32(b, q + 16) }
fn rec_rel_at(b: Bytes, q: Int) -> Int { rd32(b, q + 20) }
fn rec_nrel(b: Bytes, q: Int) -> Int { rd32(b, q + 24) }
fn rec_nseg(b: Bytes, q: Int) -> Int { rd32(b, q + 28) }
fn rec_seg_at(b: Bytes, q: Int) -> Int { rd32(b, q + 32) }
fn rec_addr(b: Bytes, q: Int) -> Int { rd64(b, q + 36) }
fn rec_size(b: Bytes, q: Int) -> Int { rd64(b, q + 44) }

/// A section kept whole and never walked (DWARF, the linker's own,
/// __eh_frame: strip.xo whole_sect).
fn whole_name(seg: Str, name: Str, flags: Int) -> Bool {
  seg == "__LD" || seg == "__DWARF" || (flags & S_ATTR_DEBUG_FLAG) != 0 || (seg == "__TEXT" && name == "__eh_frame")
}

/// link_store: link_debug of the program's inputs and the store's
/// objects, reading only the atoms the program reaches.
pub fn link_store(inputs: List[LinkInput], store: Bytes, opts: LinkOpts) -> Result[(Bytes, Bytes), Str] {
  match store_prepare(inputs, store, opts) {
    Ok(s) => {
      var sl = s
      let err = sl.resolve()
      if !err.is_empty() {
        return Err(err)
      }
      sl.finish()
    }
    Err(e) => Err(e)
  }
}

/// A link through the store in its steps, which a caller may time:
/// store_prepare (the walk and the live atoms read), resolve (the
/// symbols, the live compact unwind entries), then link_rest's: layout,
/// synthesize and write (finish is the three).
pub struct StoreLink {
  l: Linker
  /// the store's objects (the first n of l.objs), compacted, and each
  /// one's dead section (-1 for none)
  n: Int
  stubs: List[Int]
  /// the prepare cache (prepcache.xo): what its key is made of (the
  /// roots and the options prepare read), the decisions made, and
  /// whether they came from the cache
  pub prep: Prep = Prep{}
  pub hit: Bool = false
}

/// The symbols resolved and the dead functions' compact unwind entries
/// dropped; the error, "" for none.
pub fn (var s: StoreLink) resolve() -> Str {
  s.l.resolve()
  if !s.l.err.is_empty() {
    return s.l.err
  }
  var live2: List[List[Bool]] = []
  for o in 0..s.l.objs.len() {
    var row: List[Bool] = []
    for k in 0..s.l.objs[o].sects.len() {
      row.push(o >= s.n || (k != s.stubs[o] && !s.l.objs[o].sects[k].dead))
    }
    live2.push(row)
  }
  for o in 0..s.l.objs.len() {
    for k in 0..s.l.objs[o].sects.len() {
      let x = s.l.objs[o].sects[k]
      if is_eh(x) && o < s.n && !s.l.x86 {
        // the dead functions' FDEs, as dead_strip drops them
        s.l.objs[o].sects[k] = s.l.eh_live(o, x, live2)
      } else if x.seg == "__LD" && x.name == "__compact_unwind" {
        if o < s.n {
          s.l.objs[o].sects[k] = s.l.live_unwind(o, x, live2)
        } else {
          s.l.objs[o].sects[k] = s.l.uncoalesced_unwind(o, x)
        }
      }
    }
  }
  // the imports again, from what the kept sections name
  s.l.stripped = true
  s.l.collect_imports()
  s.l.err
}

/// A program object's compact unwind section without the entries of its
/// weak definitions the link takes from another object (a helper or an
/// instance std's store defines too, decision 0388): their FDEs name the
/// symbol, which is the other object's, so the copy has no FDE of its
/// own, and nothing reaches it (every reference resolves to the kept one).
fn (l: Linker) uncoalesced_unwind(o: Int, s: ISect) -> ISect {
  // the addresses of this object's weak definitions taken from another
  var gone: Set[(Int, Int)] = #{}
  for (i, y) in l.objs[o].syms.indexed() {
    if is_ext(y) && is_defined(y) && (y.desc & 0x80) != 0 && y.sect >= 1 {
      match l.globals.get(y.name) {
        Some(g) => if g != (o, i) {
          gone.add((y.sect, y.value))
        }
        None => {}
      }
    }
  }
  if gone.is_empty() {
    return s
  }
  var keep: List[Int] = []
  for r in s.relocs {
    if r.addr % 32 != 0 {
      continue
    }
    // the entry's function: a symbol, or a section and an address
    let f = if r.ext {
      let y = l.objs[o].syms[r.sym]
      (y.sect, y.value)
    } else {
      (r.sym, rd64(s.data, r.addr))
    }
    if !gone.contains(f) {
      keep.push(r.addr)
    }
  }
  var out = s
  var b = BytesBuilder.new()
  out.relocs = []
  for (n, at) in keep.indexed() {
    b.write(s.data[at..at + 32])
    for r in s.relocs {
      if r.addr >= at && r.addr < at + 32 {
        var r2 = r
        r2.addr = r.addr - at + 32 * n
        out.relocs.push(r2)
      }
    }
  }
  out.data = b.freeze()
  out.size = 32 * keep.len()
  out
}

/// The executable and the dSYM's DWARF (link_debug's), or the error.
pub fn (var s: StoreLink) finish() -> Result[(Bytes, Bytes), Str] {
  s.l.link_rest()
}

/// finish's steps, for a caller that times them (compiler/xo ld.xo's
/// link.layout, link.synthesize and link.write laps): the error, "" for
/// none, and the last the image and the dSYM's DWARF.
pub fn (var s: StoreLink) layout() -> Str { s.l.rest_layout() }
pub fn (var s: StoreLink) synthesize() -> Str { s.l.rest_synthesize() }
pub fn (var s: StoreLink) write() -> Result[(Bytes, Bytes), Str] { s.l.rest_write() }

/// The walk from the program's inputs and the store's live atoms read
/// (link_store's first step).
pub fn store_prepare(inputs: List[LinkInput], store: Bytes, opts: LinkOpts) -> Result[StoreLink, Str] {
  store_prepare_cached(inputs, store, opts, None)
}

/// What a store link's prepare decisions depend on besides the store:
/// the names the program's objects take from it (undefined, or defined
/// weak), the entry, the cpu and whether DWARF is cut. The caller adds
/// the store's and xo's identity (compiler/xo ld.xo prep_file).
pub fn prep_key(inputs: List[LinkInput], opts: LinkOpts) -> Result[Bytes, Str] {
  let prog = match parse_inputs(inputs) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let x86 = !prog.is_empty() && prog[0].x86
  let dwarf = !(opts.program_dwarf && !prog.any(fn(ob) { obj_xo_dwarf(ob) })) && (opts.embed_dwarf || opts.dsym)
  var names: List[Bytes] = []
  for ob in prog {
    if !ob.live {
      continue
    }
    for s in ob.syms {
      if is_ext(s) && (!is_defined(s) || (s.desc & 0x80) != 0) {
        names.push(s.name)
      }
    }
  }
  var b = BytesBuilder.new()
  b.write_str("prep1 x86=${x86} dwarf=${dwarf} entry=${opts.entry}\n")
  for nm in names.sort_by(fn(x: Bytes) -> Bytes { x }) {
    b.write(nm)
    b.write_byte(0)
  }
  Ok(b.freeze())
}

/// store_prepare with a prepare cache: cached holds the decisions a link
/// with the same prep_key (and store) made, None to decide afresh; the
/// StoreLink returns the decisions made (prep) and whether they were
/// the cache's (hit). The decisions only choose which of the store's
/// atoms, runs and symbols are kept, so a hit links the same bytes as a
/// miss.
pub fn store_prepare_cached(inputs: List[LinkInput], store: Bytes, opts: LinkOpts, cached: Prep?) -> Result[StoreLink, Str] {
  let v = match store_view(store) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let n = v.n
  let data0 = v.data0
  var l = Linker{opts: opts}
  // the program's objects after the store's (a build passes its parts
  // first), whole: what they name roots the walk
  var prog = match parse_inputs(inputs) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  for i in 0..prog.len() {
    prog[i].subsections = false
  }
  // x86_64 or arm64 by the program's objects (the store names no cpu;
  // link_debug reads its first object's)
  l.x86 = !prog.is_empty() && prog[0].x86
  // the debug information follows the program's objects (program_dwarf,
  // a separately compiled link): with none there (-s, --debug-info=off),
  // std's is neither cut nor written
  if opts.program_dwarf && !prog.any(fn(ob) { obj_xo_dwarf(ob) }) {
    l.opts.embed_dwarf = false
    l.opts.dsym = false
  }
  let no_dwarf = !l.opts.embed_dwarf && !l.opts.dsym
  // the walk: the program's undefined symbols the store defines, the
  // entry, and the store's sections nothing may strip
  var roots: List[Int] = []
  for ob in prog {
    if !ob.live {
      continue
    }
    for s in ob.syms {
      // what it names, and what it defines weak (a helper or an instance
      // std's store defines too: the link keeps the store's, the first,
      // so its atom must be live)
      if is_ext(s) && (!is_defined(s) || (s.desc & 0x80) != 0) {
        roots.push(v.def(s.name))
      }
    }
  }
  roots.push(v.def(opts.entry.bytes()))
  let hit = match cached {
    Some(p) => p.live.len() == v.total && p.dw_dropped.len() == n && p.symnews.len() == n
    None => false
  }
  let given = if hit { cached ?? Prep{} } else { Prep{} }
  var live: List[Bool] = []
  var dw_dropped: List[Bool] = []
  if hit {
    live = given.live
    dw_dropped = given.dw_dropped
  } else {
    live = v.walk(roots, fn(sg: Str, nm: Str, flags: Int) -> Bool { !whole_name(sg, nm, flags) && ((flags & S_ATTR_NO_DEAD_STRIP) != 0 || (flags & 0xff) == S_MOD_INIT_FUNC_POINTERS) })
    if no_dwarf {
      for _ in 0..n {
        dw_dropped.push(true)
      }
    } else {
      dw_dropped = v.dw_dropped(live)
    }
  }
  var keeps: List[List[Bool]] = []
  var symnews: List[List[Int]] = List.with_capacity(n)
  // each store object compacted: its kept sections (a live atom's bytes
  // and relocations, a whole section's, a cut DWARF section's runs) in
  // order, then one empty dead section standing for every dead atom (a
  // reference to one, from DWARF or an FDE, is 0: translate); its kept
  // symbols renumbered (store_core.xo keep_syms). The link is the one
  // over every atom, byte for byte.
  var stubs: List[Int] = List.with_capacity(n)
  var newks: List[List[Int]] = List.with_capacity(n)
  var nameds: List[List[Bool]] = List.with_capacity(n)
  var elsewhere: Set[Bytes] = #{}
  for i in 0..n {
    l.objs.push(IObj{path: v.paths[i], subsections: true, x86: l.x86})
    let ns = v.nsects[i]
    var newk: List[Int] = List.with_capacity(ns)
    var sects: List[ISect] = List.with_capacity(ns)
    var any_dead = false
    for k in 0..ns {
      let q = v.recs[i] + STORE_REC * k
      let (sg, nm) = v.names[rec_name(store, q)]
      let flags = rec_flags(store, q)
      if sg == "__DWARF" && dw_dropped[i] {
        newk.push(sects.len())
        sects.push(ISect{seg: sg, name: nm, addr: rec_addr(store, q), size: 0, align: rec_align(store, q), flags: flags, data: "".bytes()})
      } else if rec_nseg(store, q) > 0 {
        let ci = keeps.len()
        let (data, rels, keep) = v.cut_with(q, live, if hit && ci < given.keeps.len() { given.keeps[ci] } else { [] }, nm == "__debug_loclists")
        keeps.push(keep)
        var t = ISect{seg: sg, name: nm, addr: rec_addr(store, q), size: data.len(), align: rec_align(store, q), flags: flags, data: data, relocs: List.with_capacity(rels.len())}
        for (rq, addr) in rels {
          var x = rd_reloc(store, rq)
          x.addr = addr
          t.relocs.push(x)
        }
        newk.push(sects.len())
        sects.push(t)
      } else if whole_name(sg, nm, flags) || live[v.base[i] + k] {
        let da = data0 + rec_data_at(store, q)
        let ra = data0 + rec_rel_at(store, q)
        let nr = rec_nrel(store, q)
        var t = ISect{seg: sg, name: nm, addr: rec_addr(store, q), size: rec_size(store, q), align: rec_align(store, q), flags: flags, data: store[da..da + rec_data_len(store, q)], relocs: List.with_capacity(nr)}
        for j in 0..nr {
          t.relocs.push(rd_reloc(store, ra + 12 * j))
        }
        newk.push(sects.len())
        sects.push(t)
      } else if l.x86 {
        // x86_64: an FDE points into its function by address, with no
        // relocation (link.xo x86_eh_pointer), so a dead atom keeps a
        // dead section of its own at its address, as in the parts' link
        newk.push(sects.len())
        sects.push(ISect{seg: sg, name: nm, addr: rec_addr(store, q), size: rec_size(store, q), align: rec_align(store, q), flags: flags, data: "".bytes(), dead: true})
      } else {
        newk.push(-1)
        any_dead = true
      }
    }
    let stub = if any_dead { sects.len() } else { -1 }
    if any_dead {
      sects.push(ISect{seg: "__TEXT", name: "__dead", addr: 0, size: 0, align: 0, flags: 0, data: "".bytes(), dead: true})
    }
    stubs.push(stub)
    // the symbols a kept relocation names, and the names of the
    // undefined ones (another object's definitions)
    let nsym = v.nsyms[i]
    var named: List[Bool] = List.with_capacity(nsym)
    for _ in 0..nsym {
      named.push(false)
    }
    // (only keep_syms reads them: a cache hit has its answer)
    for t in if hit { [] } else { sects } {
      for x in t.relocs {
        if x.ext && x.typ != R_ADDEND && x.sym < nsym && !named[x.sym] {
          named[x.sym] = true
          let y = v.sym(i, x.sym)
          if (y.typ & N_TYPE) == N_UNDF {
            elsewhere.add(y.name)
          }
        }
      }
    }
    l.objs[i].sects = sects
    newks.push(newk)
    nameds.push(named)
  }
  l.objs = l.objs + prog
  let kind = fn(typ: Int) -> SymKind {
    if (typ & N_STAB) != 0 {
      SymKind.Stab
    } else if (typ & N_TYPE) == N_UNDF {
      SymKind.Undef
    } else if (typ & N_TYPE) == N_SECT {
      SymKind.InSect
    } else {
      SymKind.Other
    }
  }
  for i in 0..n {
    let newk = newks[i]
    let stub = stubs[i]
    let nsym = v.nsyms[i]
    // an atom's new ordinal (1 based)
    let ord = fn(o: Int) -> Int { if newk[o - 1] >= 0 { newk[o - 1] + 1 } else { stub + 1 } }
    let symnew = if hit && given.symnews[i].len() == nsym { given.symnews[i] } else { v.keep_syms(i, newk, nameds[i], elsewhere, kind, fn(typ: Int) -> Bool { (typ & N_EXT) != 0 }) }
    symnews.push(symnew)
    var syms: List[ISym] = []
    for j in 0..nsym {
      if symnew[j] < 0 {
        continue
      }
      let y = v.sym(i, j)
      let in_sect = (y.typ & N_STAB) == 0 && (y.typ & N_TYPE) == N_SECT && y.sect >= 1
      syms.push(ISym{name: y.name, typ: y.typ, sect: if in_sect { ord(y.sect) } else { y.sect }, desc: y.desc, value: y.value})
    }
    // taken out of the object while renumbered: shared with it, the first
    // write copied every section's relocations (3.4 ms of an HTTP
    // server's store link, 2026-10-28)
    var sects = l.objs[i].sects
    l.objs[i].sects = []
    for k in 0..sects.len() {
      for j in 0..sects[k].relocs.len() {
        let x = sects[k].relocs[j]
        if x.ext && x.typ != R_ADDEND && x.sym < nsym {
          sects[k].relocs[j].sym = symnew[x.sym]
        }
      }
    }
    l.objs[i].sects = sects
    l.objs[i].syms = syms
    for (key, atoms) in v.splits[i] {
      var a2: List[(Int, Int)] = List.with_capacity(atoms.len())
      for (a, o) in atoms {
        a2.push((a, ord(o)))
      }
      l.objs[i].split[key] = a2
    }
  }
  Ok(StoreLink{l: l, n: n, stubs: stubs, prep: Prep{live: live, dw_dropped: dw_dropped, keeps: keeps, symnews: symnews}, hit: hit})
}
