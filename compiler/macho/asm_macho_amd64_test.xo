// Generated by scripts/amd64-enc-goldens.py macho-objects: each
// compiler/macho/testdata/amd64-macho/*.s and the Mach-O object clang writes
// for it (clang -c -arch x86_64 -mmacosx-version-min=11.0); do not edit
// the table.

const AMD64_MACHO_OBJECTS: List[(Str, Str, Str)] = [
  ("atoms_relocs_unwind.s", r#"	.section __TEXT,__text,regular,pure_instructions
	.globl _main
	.p2align 4
_main:
	.cfi_startproc
	.cfi_personality 155, _xo_personality
	.cfi_lsda 16, Lexcept0
	pushq %rbp
	movq %rsp, %rbp
	pushq %rbx
	.cfi_def_cfa %rbp, 16
	.cfi_offset %rbp, -16
	.cfi_offset %rbx, -24
	leaq Lstr(%rip), %rdi
	movl $0, %eax
	callq _puts
	callq _helper
	callq _main
	movq _ext@GOTPCREL(%rip), %rcx
	movq _xo_tlocal@TLVP(%rip), %rdi
	callq *(%rdi)
	movl $7, Ldata(%rip)
	movl $7, Lstr(%rip)
	movl $7, _counter+4(%rip)
	movq _counter(%rip), %rax
	cmpq $3, %rax
	je Lmain_end
	jmp Lmain_end
Lmain_end:
	popq %rbx
	popq %rbp
	retq
	.cfi_endproc
	.p2align 4
	.globl _helper
	.private_extern _helper
_helper:
	.cfi_startproc
	pushq %rbp
	.cfi_def_cfa_offset 16
	.cfi_offset %rbp, -16
	movq %rsp, %rbp
	.cfi_def_cfa_register %rbp
	pushq %rbx
	pushq %r12
	.cfi_offset %rbx, -24
	.cfi_offset %r12, -32
	testq %rdi, %rdi
	jne Lmain_end
	popq %r12
	popq %rbx
	popq %rbp
	jmp _helper
	.cfi_endproc
	.p2align 4
_leaf:
	.cfi_startproc
	retq
	.cfi_endproc
	.section __TEXT,__gcc_except_tab
Lexcept0:
	.byte 255
	.byte 155
	.byte 0
	.section __TEXT,__cstring,cstring_literals
Lstr:
	.asciz "hi"
	.section __DATA,__data
	.globl _counter
	.p2align 3
_counter:
	.quad 0
Ldata:
	.long 0
	.long 0
	.quad Lstr
	.quad _helper
	.quad Lmain_end
"#, ""),
  ("signed_forms.s", r#"	.section __TEXT,__text,regular,pure_instructions
	.globl _f
_f:
	leaq _counter(%rip), %rax
	cmpb $1, _counter(%rip)
	movl $7, _counter(%rip)
	leaq _counter+4(%rip), %rax
	cmpb $1, _counter+4(%rip)
	movl $7, _counter+4(%rip)
	leaq _counter+8(%rip), %rax
	cmpb $1, _counter+8(%rip)
	movl $7, _counter+8(%rip)
	leaq Ldata(%rip), %rax
	cmpb $1, Ldata(%rip)
	movl $7, Ldata(%rip)
	leaq Ldata+4(%rip), %rax
	cmpb $1, Ldata+4(%rip)
	movl $7, Ldata+4(%rip)
	leaq Ldata+8(%rip), %rax
	cmpb $1, Ldata+8(%rip)
	movl $7, Ldata+8(%rip)
	leaq Lstr(%rip), %rax
	cmpb $1, Lstr(%rip)
	movl $7, Lstr(%rip)
	leaq Lstr+4(%rip), %rax
	cmpb $1, Lstr+4(%rip)
	movl $7, Lstr+4(%rip)
	leaq Lstr+8(%rip), %rax
	cmpb $1, Lstr+8(%rip)
	movl $7, Lstr+8(%rip)
	retq
	.section __TEXT,__cstring,cstring_literals
Lstr:
	.asciz "hello world!"
	.section __DATA,__data
	.globl _counter
_counter:
	.quad 0
Ldata:
	.quad 0
	.quad 0
	.quad Lstr
	.quad Ldata
"#, ""),
]

test "each darwin/amd64 test file assembles to clang's Mach-O object" {
  var bad: List[Str] = []
  for (name, src, want) in AMD64_MACHO_OBJECTS {
    match assemble_macho_amd64_raw(src.bytes(), (11, 0)) {
      Ok(o) => {
        let got = hex_of(o)
        if got != want {
          var i = 0
          while i < got.len() && i < want.len() && got[i..i + 1] == want[i..i + 1] {
            i += 1
          }
          bad.push("${name}: differs at byte ${i / 2} (${got.len() / 2} bytes, want ${want.len() / 2})")
        }
      }
      Err(e) => bad.push("${name}: ${e}")
    }
  }
  expect(bad.join("; ")) == ""
}
