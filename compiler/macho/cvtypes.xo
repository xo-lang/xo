// The PDB's types (decision 0344 stage 4): the DWARF types the program's
// variables have, as CodeView type records for the TPI stream. Base
// types are CodeView's primitive indices (T_INT8, T_UINT4, T_REAL64,
// T_BOOL08, ...); a pointer to one is its 64 bit pointer form (0x600 |
// the type); every structure, by name, gets a forward reference that
// pointers, arrays and members name, then its LF_FIELDLIST of LF_MEMBERs
// and its full LF_STRUCTURE, which a reader finds from the forward
// reference by the name's hash (the TPI hash stream: hash_v1 of the name
// for a full definition, the record's JamCRC for the rest, as LLVM's
// hashTypeRecord). A typedef is its type; anything else is T_NOTYPE.

use github.com/xo-lang/xo/compiler/debug

const LF_POINTER = 0x1002
const LF_FIELDLIST = 0x1203
const LF_ARRAY = 0x1503
const LF_STRUCTURE = 0x1505
const LF_MEMBER = 0x150d
const LF_ULONG = 0x8004

/// ClassOptions: a forward reference.
const CO_FWDREF = 0x80

/// The type records (from index 0x1000), each one's hash bucket value,
/// and the CodeView index of each DWARF type offset converted.
struct CvTypes {
  recs: List[Bytes] = []
  hashes: List[Int] = []
  of: Map[Int, Int] = {}
  /// each structure's forward reference, by name
  fwd: Map[Str, Int] = {}
}

/// The types of info: every structure's forward reference, then the
/// types its variables need, then each structure's members and full
/// definition.
fn cv_types(info: debug.Info) -> CvTypes { cv_types_of(info, var_tys(info)) }

/// The types of info's variables (the DWARF offsets), in the order
/// cv_types first meets them: each function's, then its inlined calls'.
fn var_tys(info: debug.Info) -> List[Int] {
  var out: List[Int] = []
  for f in info.funcs {
    for v in f.vars {
      out.push(v.ty)
    }
    for c in f.inlined {
      for v in c.vars {
        out.push(v.ty)
      }
    }
  }
  out
}

/// cv_types with the variables' types given in order (var_tys): the
/// structures by offset, then tys, then the structures' members.
fn cv_types_of(info: debug.Info, tys: List[Int]) -> CvTypes { cv_types_split(info, tys, -1, 0) }

/// cv_types_of in two runs when split_off >= 0: the types at offsets
/// below split_off and tys[0..split_tys] (std's, the store's objects come
/// first), then the rest; so std's records and indices are the same
/// whatever the program brings (a PDB's std part is reused, decision 0409).
fn cv_types_split(info: debug.Info, tys: List[Int], split_off: Int, split_tys: Int) -> CvTypes {
  var t = CvTypes{}
  var offs: List[Int] = []
  for (off, _) in info.types {
    offs.push(off)
  }
  let sorted = offs.sort()
  if split_off < 0 {
    cv_types_run(t, info, sorted, tys)
    return t
  }
  t = cv_types_std(info, tys, split_off, split_tys)
  cv_types_rest(t, info, tys, split_off, split_tys)
  t
}

/// cv_types_split's first run alone: std's types (a PdbStd keeps them).
fn cv_types_std(info: debug.Info, tys: List[Int], split_off: Int, split_tys: Int) -> CvTypes {
  var t = CvTypes{}
  var lo: List[Int] = []
  for (off, _) in info.types {
    if off < split_off {
      lo.push(off)
    }
  }
  let k = if split_tys < tys.len() { split_tys } else { tys.len() }
  cv_types_run(t, info, lo.sort(), tys[0..k])
  t
}

/// cv_types_split's second run, after std's in t: the program's types.
fn cv_types_rest(var t: CvTypes, info: debug.Info, tys: List[Int], split_off: Int, split_tys: Int) {
  var hi: List[Int] = []
  for (off, _) in info.types {
    if off >= split_off {
      hi.push(off)
    }
  }
  let k = if split_tys < tys.len() { split_tys } else { tys.len() }
  cv_types_run(t, info, hi.sort(), tys[k..tys.len()])
}

/// The structures at offs (ascending) as forward references, then tys'
/// types, then those structures' members and full definitions, into t.
fn cv_types_run(var t: CvTypes, info: debug.Info, offs: List[Int], tys: List[Int]) {
  var structs: List[(Str, Int)] = []
  for off in offs {
    let ty = info.types.get(off) ?? debug.Type{tag: 0, name: "", size: 0, enc: 0, of: -1, members: []}
    if ty.tag == 0x13 && !ty.name.is_empty() && !t.fwd.contains(ty.name) {
      var w = new_out(16 + ty.name.len())
      // count, options, field list, derived from, vshape, size, name
      w.u16(0)
      w.u16(CO_FWDREF)
      w.u32(0)
      w.u32(0)
      w.u32(0)
      numeric(w, 0)
      w.bytes(cstr_bytes(ty.name))
      t.fwd[ty.name] = add_type(t, LF_STRUCTURE, w.done(), -1)
      structs.push((ty.name, off))
    }
  }
  for ty in tys {
    let _i = cv_index(t, info, ty)
  }
  // each structure's members and full definition
  for (name, off) in structs {
    let ty = info.types.get(off) ?? debug.Type{tag: 0, name: "", size: 0, enc: 0, of: -1, members: []}
    var fl = new_out(32 * ty.members.len())
    for m in ty.members {
      let mi = cv_index(t, info, m.ty)
      var mw = new_out(16 + m.name.len())
      // LF_MEMBER: attributes (public), type, offset, name
      mw.u16(LF_MEMBER)
      mw.u16(3)
      mw.u32(mi)
      numeric(mw, m.offset)
      mw.bytes(cstr_bytes(m.name))
      lf_pad(mw)
      fl.bytes(mw.done())
    }
    let fli = add_type(t, LF_FIELDLIST, fl.done(), -1)
    var w = new_out(24 + name.len())
    w.u16(ty.members.len())
    w.u16(0)
    w.u32(fli)
    w.u32(0)
    w.u32(0)
    numeric(w, ty.size)
    w.bytes(cstr_bytes(name))
    let _f = add_type(t, LF_STRUCTURE, w.done(), hash_v1(name))
  }
}

/// The CodeView index of the DWARF type at off (converted once).
fn cv_index(var t: CvTypes, info: debug.Info, off: Int) -> Int {
  if off < 0 {
    return 0
  }
  if let Some(i) = t.of.get(off) {
    return i
  }
  let ty = match info.types.get(off) {
    Some(x) => x
    None => return 0
  }
  // a cycle through typedefs or pointers ends at T_NOTYPE
  t.of[off] = 0
  let i = match ty.tag {
    0x24 => primitive(ty.enc, ty.size)
    0x16 => cv_index(t, info, ty.of)
    0x13 => t.fwd.get(ty.name) ?? 0
    0x0f => {
      let p = if ty.of < 0 { 3 } else { cv_index(t, info, ty.of) }
      if p < 0x1000 && p != 0 {
        0x600 | p
      } else if p == 0 {
        // void * (T_64PVOID)
        0x603
      } else {
        var w = new_out(8)
        // the referent, attributes: a 64 bit near pointer of 8 bytes
        w.u32(p)
        w.u32(0xc | (8 << 13))
        add_type(t, LF_POINTER, w.done(), -1)
      }
    }
    0x01 => {
      let e = cv_index(t, info, ty.of)
      var size = ty.size
      if size == 0 && ty.count > 0 {
        size = ty.count * type_size(info, ty.of)
      }
      var w = new_out(16)
      // the element type, the index type (T_UQUAD), the size, no name
      w.u32(e)
      w.u32(0x23)
      numeric(w, size)
      w.bytes(cstr_bytes(""))
      add_type(t, LF_ARRAY, w.done(), -1)
    }
    _ => 0
  }
  t.of[off] = i
  i
}

/// A DWARF type's size, through typedefs.
fn type_size(info: debug.Info, off: Int) -> Int {
  var o = off
  for _ in 0..16 {
    let ty = match info.types.get(o) {
      Some(x) => x
      None => return 0
    }
    if ty.tag != 0x16 {
      return ty.size
    }
    o = ty.of
  }
  0
}

/// A base type's primitive index: DW_ATE_boolean 2, float 4, signed 5,
/// signed_char 6, unsigned 7, unsigned_char 8, UTF 0x10.
fn primitive(enc: Int, size: Int) -> Int {
  match enc {
    2 => 0x30
    4 => if size == 4 { 0x40 } else { 0x41 }
    5 | 6 => match size {
      1 => 0x68
      2 => 0x72
      4 => 0x74
      _ => 0x76
    }
    7 | 8 => match size {
      1 => 0x69
      2 => 0x73
      4 => 0x75
      _ => 0x77
    }
    0x10 => 0x7b
    _ => 0
  }
}

/// Appends a type record (its length, kind, data, LF_PAD bytes to 4) and
/// its hash (h, or the record's JamCRC when h < 0); its index.
fn add_type(var t: CvTypes, kind: Int, data: Bytes, h: Int) -> Int {
  var w = new_out(data.len() + 8)
  let len = 2 + data.len()
  let padded = (len + 2 + 3) / 4 * 4 - 2
  w.u16(padded)
  w.u16(kind)
  w.bytes(data)
  var left = padded - len
  while left > 0 {
    w.u8(0xf0 + left)
    left -= 1
  }
  let rec = w.done()
  t.recs.push(rec)
  t.hashes.push((if h >= 0 { h } else { jam_crc(rec) }) % 0x3ffff)
  0x1000 + t.recs.len() - 1
}

/// A numeric leaf: the value itself under 0x8000, else LF_ULONG and 4
/// bytes.
fn numeric(var w: Out, v: Int) {
  if v >= 0 && v < 0x8000 {
    w.u16(v)
  } else {
    w.u16(LF_ULONG)
    w.u32(v)
  }
}

/// LF_PAD bytes after a field list member, to 4 bytes.
fn lf_pad(var w: Out) {
  while w.n % 4 != 0 {
    w.u8(0xf0 + (4 - w.n % 4))
  }
}

/// A TPI or IPI stream of records recs with their hashes: the header
/// naming the hash stream hs (its hash values, then the first record's
/// index offset), the records; and the hash stream.
fn type_stream(recs: List[Bytes], hashes: List[Int], hs: Int) -> (Bytes, Bytes) {
  var body = new_out(64 * recs.len())
  for r in recs {
    body.bytes(r)
  }
  let data = body.done()
  var h = new_out(4 * hashes.len() + 8)
  for x in hashes {
    h.u32(x)
  }
  if !hashes.is_empty() {
    h.u32(0x1000)
    h.u32(0)
  }
  let hash = h.done()
  var w = new_out(56 + data.len())
  w.u32(20040203)
  w.u32(56)
  w.u32(0x1000)
  w.u32(0x1000 + recs.len())
  w.u32(data.len())
  w.u16(if hashes.is_empty() { 0xffff } else { hs })
  w.u16(0xffff)
  w.u32(4)
  w.u32(0x3ffff)
  // hash values, index offsets, hash adjusters: offset and length each
  w.u32(0)
  w.u32(4 * hashes.len())
  w.u32(4 * hashes.len())
  w.u32(if hashes.is_empty() { 0 } else { 8 })
  w.u32(hash.len())
  w.u32(0)
  w.bytes(data)
  (w.done(), hash)
}

// ---------------------------------------------------------------------------
// Locals (decision 0344 stage 4): each variable's S_LOCAL and the
// S_DEFRANGE records of its DWARF locations

const S_LOCAL = 0x113e
const S_DEFRANGE_REGISTER = 0x1141
const S_DEFRANGE_SUBFIELD_REGISTER = 0x1143
const S_DEFRANGE_REGISTER_REL = 0x1145

/// A variable of a procedure or inline site: its S_LOCAL's type, whether
/// a parameter, its name, and its S_DEFRANGE records (kind, body); seg
/// above 0: each record's range start moves by delta into section seg
/// as it is written (locals_placed, pdb.xo def_record_moved), not copied.
struct PdbLocal {
  name: Str
  ty: Int
  param: Bool
  defs: List[(Int, Bytes)]
  delta: Int = 0
  seg: Int = 0
}

/// The locals of vars: each place a variable's DWARF locations put it or
/// a piece of it, in a register (S_DEFRANGE_REGISTER, or
/// S_DEFRANGE_SUBFIELD_REGISTER for a piece of a value in several) or in
/// memory at a register and an offset (S_DEFRANGE_REGISTER_REL, the
/// piece's offset in its value in the flags); a constant, a global's
/// address or an unread expression has none (a variable with no record
/// is left out). A place's ranges (an exprloc: every range of whole) are
/// merged, then written as few records as CodeView allows: each covers
/// at most 0xffff bytes of one section, its holes as gaps (a location
/// list repeats a stack slot in every entry where another piece moves:
/// xo.exe had 2.1 million S_DEFRANGE_REGISTER_REL, 42 MB, before).
fn cv_locals(var t: CvTypes, info: debug.Info, vars: List[debug.Var], whole: List[(Int, Int)], sects: List[PdbSect], base: Int) -> List[PdbLocal] {
  var out = cv_locals_at(vars, whole, sects, base)
  for i in 0..out.len() {
    var l = out[i]
    l.ty = cv_index(t, info, l.ty)
    out[i] = l
  }
  out
}

/// cv_locals with each local's type its DWARF offset (cv_index converts
/// it): a function's locals made from its own object (cvobj obj_pdb).
fn cv_locals_at(vars: List[debug.Var], whole: List[(Int, Int)], sects: List[PdbSect], base: Int) -> List[PdbLocal] {
  var out: List[PdbLocal] = []
  for v in vars {
    // the places in first seen order (kind, register, offset, the
    // piece's offset in its value) and their ranges
    var keys: List[(Int, Int, Int, Int)] = []
    var spans: List[List[(Int, Int)]] = []
    for l in v.locs {
      let rs = if l.lo == 0 && l.hi == -1 { whole } else { [(l.lo, l.hi)] }
      let multi = l.pieces.len() > 1
      var poff = 0
      for pc in l.pieces {
        var key = (0, 0, 0, 0)
        match pc.place {
          debug.Place.Reg(r) => {
            key = (if multi { S_DEFRANGE_SUBFIELD_REGISTER } else { S_DEFRANGE_REGISTER }, cv_reg(r), 0, poff)
          }
          debug.Place.Breg(r, o) => {
            key = (S_DEFRANGE_REGISTER_REL, cv_reg(r), o, poff)
          }
          _ => {}
        }
        if key.0 != 0 && key.1 != 0 {
          var k = -1
          for (i, x) in keys.indexed() {
            if x == key {
              k = i
            }
          }
          if k < 0 {
            k = keys.len()
            keys.push(key)
            spans.push([])
          }
          for r in rs {
            spans[k].push(r)
          }
        }
        poff += pc.size
      }
    }
    var defs: List[(Int, Bytes)] = []
    for (i, (kind, cr, o, poff)) in keys.indexed() {
      for (so, seg, n, gaps) in cv_spans(sects, base, merge_spans(spans[i])) {
        var w = new_out(16 + 4 * gaps.len())
        w.u16(cr)
        if kind == S_DEFRANGE_REGISTER_REL {
          // the piece's offset in its value, bits 4 to 15
          w.u16((poff & 0xfff) << 4)
          w.u32(o & 0xffffffff)
        } else {
          w.u16(0)
          if kind == S_DEFRANGE_SUBFIELD_REGISTER {
            w.u32(poff & 0xfff)
          }
        }
        w.u32(so)
        w.u16(seg)
        w.u16(n)
        for (g, gn) in gaps {
          w.u16(g)
          w.u16(gn)
        }
        defs.push((kind, w.done()))
      }
    }
    if !defs.is_empty() {
      out.push(PdbLocal{name: v.name, ty: v.ty, param: v.param, defs: defs})
    }
  }
  out
}


/// rs in order; a list already in order (DWARF's usually are) is
/// returned as it is, with no sorted copy.
fn spans_sorted(rs: List[(Int, Int)]) -> List[(Int, Int)] {
  var i = 1
  while i < rs.len() {
    let (alo, ahi) = rs[i - 1]
    let (blo, bhi) = rs[i]
    if alo > blo || (alo == blo && ahi > bhi) {
      return rs.sort()
    }
    i += 1
  }
  rs
}

/// Ranges sorted, with the ones that touch or overlap joined.
fn merge_spans(rs: List[(Int, Int)]) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  for (lo, hi) in spans_sorted(rs) {
    if hi <= lo {
      continue
    }
    if !out.is_empty() && lo <= out[out.len() - 1].1 {
      let (plo, phi) = out[out.len() - 1]
      out[out.len() - 1] = (plo, if hi > phi { hi } else { phi })
    } else {
      out.push((lo, hi))
    }
  }
  out
}

/// Merged ranges as CodeView records' ranges: (section offset, section,
/// length, the gaps (offset from the start, length)), each at most 0xffff
/// bytes long in one section, a longer range cut; a range outside the
/// sections is left out.
fn cv_spans(sects: List[PdbSect], base: Int, rs0: List[(Int, Int)]) -> List[(Int, Int, Int, List[(Int, Int)])] {
  var rs = rs0
  var out: List[(Int, Int, Int, List[(Int, Int)])] = []
  var i = 0
  while i < rs.len() {
    let (lo, _) = rs[i]
    let (seg, off) = seg_off(sects, lo - base)
    if seg == 0 {
      i += 1
      continue
    }
    let sect_end = lo + sects[seg - 1].vsize - off
    let limit = if lo + 0xffff < sect_end { lo + 0xffff } else { sect_end }
    var end = lo
    var gaps: List[(Int, Int)] = []
    while i < rs.len() && rs[i].0 < limit {
      let (a, b) = rs[i]
      if a > end {
        // a record stays under 0xffff bytes: at most 1000 gaps
        if gaps.len() >= 1000 {
          break
        }
        gaps.push((end - lo, a - end))
      }
      if b > limit {
        // the rest starts the next record
        end = limit
        rs[i] = (limit, b)
        break
      }
      end = b
      i += 1
    }
    out.push((off, seg, end - lo, gaps))
  }
  out
}

/// [lo, hi) as CodeView address ranges: (section offset, section, length)
/// each at most 0xffff bytes; none outside the image's sections.
fn cv_ranges(sects: List[PdbSect], base: Int, lo: Int, hi: Int) -> List[(Int, Int, Int)] {
  var out: List[(Int, Int, Int)] = []
  let (seg, off) = seg_off(sects, lo - base)
  if seg == 0 || hi <= lo {
    return out
  }
  var a = off
  let end = off + (hi - lo)
  while a < end {
    let n = if end - a > 0xffff { 0xffff } else { end - a }
    out.push((a, seg, n))
    a += n
  }
  out
}

/// The CodeView (CV_AMD64) register of DWARF register r of x86_64, or 0.
fn cv_reg(r: Int) -> Int {
  match r {
    0 => 328
    1 => 331
    2 => 330
    3 => 329
    4 => 332
    5 => 333
    6 => 334
    7 => 335
    _ => if r >= 8 && r <= 15 { 336 + r - 8 } else if r >= 17 && r <= 24 { 154 + r - 17 } else if r >= 25 && r <= 32 { 252 + r - 25 } else { 0 }
  }
}
