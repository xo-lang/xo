// Xo's PE linker for windows/amd64 (decision 0254 stage 6b, step 4): COFF
// objects (coff.xo's, and clang's for the zone data) into a PE32+
// executable without lld-link. The sections merge by name into .text,
// .rdata (with .xdata, the import tables, the TLS directory), .data (with
// .bss), .pdata (the exception directory) and .tls; the relocations are
// applied (REL32 and its _1 to _5, ADDR64 with a base relocation, ADDR32NB,
// SECREL); a call of an imported function goes through a `jmp *IAT` thunk;
// .reloc holds the base relocations; the COFF symbol table follows the
// sections as lld-link's /debug:symtab writes it (the profiler and the
// fault traceback read it, std/native/llrt/prof.xo coff_symbols). The
// objects' DWARF (.debug_line and the rest) is kept, merged by name into
// discardable sections after .reloc, named through the string table
// ("/4"), as MinGW's linkers write them: the program reads its own
// (std/native/llrt/dwline.xo) for the lines of its reports. Which DLL
// exports an imported function is the caller's (PEOpts.imports).

const PE_BASE = 0x140000000
const PE_SECT_ALIGN = 0x1000
const PE_FILE_ALIGN = 0x200
const IMAGE_REL_AMD64_ADDR32 = 2
const IMAGE_REL_BASED_DIR64 = 10
const IMAGE_SCN_MEM_DISCARDABLE = 0x2000000
/// the output sections, in order (of index and of address)
const PO_TEXT = 0
const PO_RDATA = 1
const PO_DATA = 2
/// the program's own code, read only data and data after std's
/// (PEOpts.prog_from, decision 0409's split on PE): std's sections keep
/// their addresses whatever the program; empty in a link without it
const PO_PTEXT = 3
const PO_PRDATA = 4
const PO_PWDATA = 5
const PO_PDATA = 6
const PO_TLS = 7
const PO_RSRC = 8
const PO_RELOC = 9
/// the first .debug_ section (the others after it, in first seen order)
const PO_DEBUG = 10

/// The link's settings: the entry symbol, the DLL of each function the
/// program may import (by symbol), the subsystem (3: the console), the
/// stack's reserve, and the resources (peres.xo; none: no .rsrc).
pub struct PEOpts {
  pub entry: Str
  pub imports: Map[Str, Str]
  pub subsystem: Int = 3
  pub stack: Int = 1048576
  pub resources: List[PERes] = []
  /// loaded at its base, PE_BASE (no DYNAMIC_BASE, HIGH_ENTROPY_VA):
  /// a --race program (decision 0273's Windows addendum), whose image
  /// ThreadSanitizer's Go flavor shadows below 0xe0_0000_0000
  pub fixed_base: Bool = false
  /// the PDB the debug directory names (decision 0344, pdb.xo pe_pdb
  /// writes it and the record's GUID); "": no debug directory
  pub pdb: Str = ""
  /// false: the atoms mode objects' DWARF is kept whole (coff_dw_strip
  /// not run); XO_STD_STORE_CHECK's PDB check, whose parts are made from
  /// whole DWARF
  pub dwtrim: Bool = true
  /// false: the objects' .debug_ sections are left out (`-s` or
  /// --debug-info=off, whose program objects have none but std's store's
  /// do, decision 0388)
  pub debug: Bool = true
  /// the first object of the program's own (std's come before it): its
  /// code, read only data and data go in .xotext, .xordata and .xodata
  /// after std's, and the import thunks after its code; -1: one .text,
  /// .rdata and .data (decision 0409 on PE)
  pub prog_from: Int = -1
}

/// An input section's place: its output section and offset there.
pub struct PEPlace {
  pub out: Int
  pub off: Int
}

/// What a symbol of an object resolves to: an object's section and offset
/// (sect >= 0), an import (imp, by name), the linker's _tls_index, or an
/// absolute value.
struct PETarget {
  obj: Int = -1
  sect: Int = -1
  off: Int = 0
  imp: Str = ""
  /// a reference through `__imp_NAME`: the IAT slot, not the thunk
  iat: Bool = false
  tls_index: Bool = false
  abs: Bool = false
}

/// The output section of input section s (-1: not in the image).
fn pe_out(s: CSect) -> Int {
  let n = s.name
  if (s.chars & IMAGE_SCN_LNK_REMOVE) != 0 || n == ".drectve" || n.starts_with(".debug") || n == ".llvm_addrsig" {
    return -1
  }
  if n == ".pdata" {
    return PO_PDATA
  }
  if n.starts_with(".tls") {
    return PO_TLS
  }
  if (s.chars & IMAGE_SCN_CNT_CODE) != 0 {
    return PO_TEXT
  }
  if (s.chars & IMAGE_SCN_MEM_WRITE) != 0 {
    return PO_DATA
  }
  PO_RDATA
}

/// The program's own output section for std's output section k.
fn pe_prog_out(k: Int) -> Int {
  if k == PO_TEXT {
    return PO_PTEXT
  }
  if k == PO_RDATA {
    return PO_PRDATA
  }
  if k == PO_DATA {
    return PO_PWDATA
  }
  k
}

/// An input section's alignment in bytes.
fn pe_align(chars: Int) -> Int {
  let k = (chars >> 20) & 0xf
  if k == 0 { 16 } else { 1 << (k - 1) }
}

fn pe_up(v: Int, a: Int) -> Int { (v + a - 1) / a * a }

/// Output section k's size in memory: .data's with the uninitialized
/// data (bss bytes) after it.
fn pe_vsize(bufs: List[BytesBuilder], k: Int, bss: Int) -> Int { if k == PO_DATA { bufs[k].len() + bss } else { bufs[k].len() } }

/// b padded with fill to a multiple of al.
fn pe_pad(var b: BytesBuilder, al: Int, fill: Int) {
  while b.len() % al != 0 {
    b.write_byte(UInt8(fill))
  }
}

/// A fixup of n little-endian bytes of v at at, written over the
/// section's bytes by pe_write.
fn put_le(var ps: List[BytePatch], at: Int, v: Int, n: Int) {
  ps.push(BytePatch{at: at, n: n, v: v})
}

/// n little-endian bytes of v at at of d (an input section's own bytes,
/// as its relocations' addends; 0 past its end, an uninitialized
/// section's), a 4 byte value sign extended.
fn get_le(d: Bytes, at: Int, n: Int) -> Int {
  if at < 0 || at + n > d.len() {
    return 0
  }
  var v = 0
  for k in 0..n {
    v = v | (Int(d[at + k]) << (8 * k))
  }
  if n == 4 && (v & 0x80000000) != 0 {
    v = v - 0x100000000
  }
  v
}

/// link_pe: the executable of objs, or why not.
pub fn link_pe(objs: List[CObj], o: PEOpts) -> Result[Bytes, Str] {
  match link_pe_layout(objs, o) {
    Ok((img, _)) => Ok(img)
    Err(e) => Err(e)
  }
}

/// Where a link put its input sections (per-object CodeView, the PDB
/// design note's tier 2): each object's sections' places (out -1: not
/// placed), each output section's RVA (the .debug_ ones from PO_DEBUG
/// have none: their offsets are within them), the .debug_ sections'
/// names by output section from PO_DEBUG, and the image base.
pub struct PELayout {
  /// the objects as linked (an atoms mode object split into its atoms,
  /// pestrip.xo); places index their sections
  pub objs: List[CObj]
  pub places: List[List[PEPlace]]
  pub rva: List[Int]
  pub dnames: List[Str]
  pub base: Int
  /// each object's symbols' targets (pehalf.xo capture_pe_half)
  targets: List[List[PETarget]] = []
}

/// link_pe and the layout it made.
pub fn link_pe_layout(objs0: List[CObj], o: PEOpts) -> Result[(Bytes, PELayout), Str] {
  // decision 0388: objects in atoms mode split into their atoms, the ones
  // nothing reaches left unplaced
  var objs = objs0
  var any_atoms = false
  for i in 0..objs.len() {
    if coff_atoms(objs[i]) {
      objs[i] = coff_split(objs[i])
      any_atoms = true
    }
  }
  // each object's weak definitions, once (each duplicate name made them
  // again)
  var weaks: List[Map[Str, Bool]] = List.with_capacity(objs.len())
  for ob in objs {
    weaks.push(coff_weak_names(ob))
  }
  var live = if any_atoms { coff_live(objs, o.entry, weaks) } else { [] }
  // the atoms mode objects' DWARF without their dead functions' (as on
  // Mach-O and ELF: a windows XO_SEPCOMP HTTP server kept every std
  // function's, 10.2 MB of debug sections against the whole program's 4.5)
  // (the layout keeps the objects as split: a PDB part is made from an
  // object's own DWARF and cached under its key, whatever a link cuts)
  let split = objs
  if any_atoms && o.dwtrim && o.debug {
    for i in 0..objs.len() {
      if !coff_atoms(objs0[i]) {
        continue
      }
      let (ob, drop) = coff_dw_strip(objs[i], i, live)
      objs[i] = ob
      if drop {
        for (k, s) in ob.sects.indexed() {
          if s.name.starts_with(".debug_") {
            live[i][k] = false
          }
        }
      }
    }
  }
  // the input sections' places, in object order: each output section's
  // bytes (an input section's appended whole) and its fixups, written
  // over them by pe_write (2026-10-27: a List[Int] per section, one push
  // per input byte and one u8 write per output byte, were most of the
  // link's time)
  var bufs: List[BytesBuilder] = []
  var pats: List[List[BytePatch]] = []
  for _ in 0..PO_DEBUG {
    bufs.push(BytesBuilder.new())
    pats.push([])
  }
  var places: List[List[PEPlace]] = []
  // the uninitialized data (.bss) after .data's bytes, in no file bytes
  // (ThreadSanitizer's object, decision 0273, has 15 MiB of it): its
  // size, and the places to move past .data's bytes once they are known
  var bss = 0
  var bss_places: List[(Int, Int)] = []
  // the .debug_ sections' names, by output section from PO_DEBUG
  var dnames: List[Str] = []
  // grouped sections (`.xounsafe$a`, `$m`, `$z`: decision 0388's unsafe
  // range index), placed after the others sorted by name, so a group is
  // one run between its $a and $z
  var grouped: List[(Str, Int, Int)] = []
  for (oi, ob) in objs.indexed() {
    var ps: List[PEPlace] = []
    for (si, s) in ob.sects.indexed() {
      var k = pe_out(s)
      if o.prog_from >= 0 && oi >= o.prog_from {
        k = pe_prog_out(k)
      }
      if (!live.is_empty() && !live[oi][si]) || (!o.debug && s.name.starts_with(".debug_")) {
        ps.push(PEPlace{out: -1, off: 0})
        continue
      }
      if s.name.starts_with(".xounsafe$") {
        grouped.push((s.name, oi, si))
        ps.push(PEPlace{out: -1, off: 0})
        continue
      }
      if s.name.starts_with(".debug_") && (s.chars & IMAGE_SCN_LNK_REMOVE) == 0 {
        k = -1
        for (di, d) in dnames.indexed() {
          if d == s.name {
            k = PO_DEBUG + di
          }
        }
        if k < 0 {
          k = PO_DEBUG + dnames.len()
          dnames.push(s.name)
          bufs.push(BytesBuilder.new())
          pats.push([])
        }
      }
      if k < 0 {
        ps.push(PEPlace{out: -1, off: 0})
        continue
      }
      if k == PO_DATA && s.data.is_empty() && (s.chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0 {
        bss = pe_up(bss, pe_align(s.chars))
        bss_places.push((places.len(), ps.len()))
        ps.push(PEPlace{out: k, off: bss})
        bss += s.size
        continue
      }
      pe_pad(bufs[k], pe_align(s.chars), if k == PO_TEXT || k == PO_PTEXT { 0xcc } else { 0 })
      let at = bufs[k].len()
      if s.data.is_empty() {
        bufs[k].write(Bytes.zeroed(s.size))
      } else {
        bufs[k].write(s.data)
      }
      ps.push(PEPlace{out: k, off: at})
    }
    places.push(ps)
  }
  for (_, oi, si) in grouped.sort() {
    let s = objs[oi].sects[si]
    let k = pe_out(s)
    pe_pad(bufs[k], pe_align(s.chars), 0)
    let at = bufs[k].len()
    bufs[k].write(if s.data.is_empty() { Bytes.zeroed(s.size) } else { s.data })
    places[oi][si] = PEPlace{out: k, off: at}
  }
  // the globals and the alternate names
  var globals: Map[Str, (Int, Int)] = {}
  var alt: Map[Str, Str] = {}
  for (oi, ob) in objs.indexed() {
    for (si, s) in ob.syms.indexed() {
      if s.aux || s.class != IMAGE_SYM_CLASS_EXTERNAL || s.sect <= 0 {
        continue
      }
      if let Some((po, _)) = globals.get(s.name) {
        // a weak definition (.xoweak) yields: the first kept, a strong
        // one over a weak one (as compiler/macho's add_globals)
        let w_new = weaks[oi].contains(s.name)
        let w_old = weaks[po].contains(s.name)
        if w_old && !w_new {
          globals[s.name] = (oi, si)
          continue
        }
        if w_old || w_new {
          continue
        }
        return Err("${ob.path}: ${s.name} is defined twice")
      }
      globals[s.name] = (oi, si)
    }
    for d in coff_directives(ob) {
      let lo = d.to_lower()
      if lo.starts_with("/alternatename:") || lo.starts_with("-alternatename:") {
        let kv = d[15..d.len()].split("=")
        if kv.len() == 2 {
          alt[kv[0]] = kv[1]
        }
      }
    }
  }
  // the imports the program uses, by DLL (in first use order) and name
  var dlls: List[Str] = []
  var by_dll: Map[Str, List[Str]] = {}
  var used: Map[Str, Bool] = {}
  var targets: List[List[PETarget]] = []
  for ob in objs {
    var ts: List[PETarget] = []
    for _ in ob.syms {
      ts.push(PETarget{})
    }
    targets.push(ts)
  }
  for (oi, ob) in objs.indexed() {
    for (si, s) in ob.syms.indexed() {
      if s.aux {
        continue
      }
      if s.sect > 0 {
        targets[oi][si] = PETarget{obj: oi, sect: s.sect - 1, off: s.value}
        continue
      }
      if s.sect == -1 {
        targets[oi][si] = PETarget{abs: true, off: s.value}
        continue
      }
      if s.sect != 0 {
        continue
      }
      // undefined: another object's, an alternate name's, the linker's,
      // or an import
      var name = s.name
      var tries = 0
      while !globals.contains(name) && alt.contains(name) && tries < 8 {
        name = alt.get(name) ?? name
        tries += 1
      }
      if let Some((go, gs)) = globals.get(name) {
        let g = objs[go].syms[gs]
        targets[oi][si] = PETarget{obj: go, sect: g.sect - 1, off: g.value}
        continue
      }
      if name == "_tls_index" {
        targets[oi][si] = PETarget{tls_index: true}
        continue
      }
      let iat = name.starts_with("__imp_")
      let fname = name.trim_prefix("__imp_")
      if let Some(dll) = o.imports.get(fname) {
        if !used.contains(fname) {
          used[fname] = true
          if !by_dll.contains(dll) {
            dlls.push(dll)
            by_dll[dll] = []
          }
          var l = by_dll.get(dll) ?? []
          l.push(fname)
          by_dll[dll] = l
        }
        targets[oi][si] = PETarget{imp: fname, iat: iat}
        continue
      }
      // a symbol only relocations of removed sections name stays
      // unresolved; one a kept section names is an error below
    }
  }
  // the import thunks at the end of .text, the linker's _tls_index in
  // .data
  // (after the program's code when it has its own: std's calls to them
  // then move with each program, as its relocations say)
  let tk = if o.prog_from >= 0 { PO_PTEXT } else { PO_TEXT }
  pe_pad(bufs[tk], 16, 0xcc)
  var thunk_at: Map[Str, Int] = {}
  for d in dlls {
    for f in by_dll.get(d) ?? [] {
      thunk_at[f] = bufs[tk].len()
      // jmp *IAT(%rip), its displacement patched below
      for x in [0xff, 0x25, 0, 0, 0, 0, 0xcc, 0xcc] {
        bufs[tk].write_byte(UInt8(x))
      }
    }
  }
  pe_pad(bufs[PO_DATA], 8, 0)
  let tls_index_at = bufs[PO_DATA].len()
  bufs[PO_DATA].write(Bytes.zeroed(8))
  pe_pad(bufs[PO_DATA], 64, 0)
  for (oi, pi) in bss_places {
    places[oi][pi].off += bufs[PO_DATA].len()
  }
  // .rdata's linker tables: the IAT first (as lld-link), then the import
  // directory, the lookup tables, the names, and the TLS directory
  // (in .xordata when the program has its own sections: a program that
  // adds an import then leaves std's .rdata and .data where they were)
  let lt = if o.prog_from >= 0 { PO_PRDATA } else { PO_RDATA }
  pe_pad(bufs[lt], 8, 0)
  let iat_start = bufs[lt].len()
  var iat_at: Map[Str, Int] = {}
  var dll_iat: List[Int] = []
  for d in dlls {
    dll_iat.push(bufs[lt].len())
    for f in by_dll.get(d) ?? [] {
      iat_at[f] = bufs[lt].len()
      bufs[lt].write(Bytes.zeroed(8))
    }
    bufs[lt].write(Bytes.zeroed(8))
  }
  let iat_size = bufs[lt].len() - iat_start
  let idir = bufs[lt].len()
  bufs[lt].write(Bytes.zeroed(20 * (dlls.len() + 1)))
  var dll_ilt: List[Int] = []
  for d in dlls {
    dll_ilt.push(bufs[lt].len())
    bufs[lt].write(Bytes.zeroed(8 * ((by_dll.get(d) ?? []).len() + 1)))
  }
  var hint_at: Map[Str, Int] = {}
  for d in dlls {
    for f in by_dll.get(d) ?? [] {
      pe_pad(bufs[lt], 2, 0)
      hint_at[f] = bufs[lt].len()
      bufs[lt].write(Bytes.zeroed(2))
      bufs[lt].write_str(f)
      bufs[lt].write_byte(0)
    }
  }
  var dll_name_at: List[Int] = []
  for d in dlls {
    dll_name_at.push(bufs[lt].len())
    bufs[lt].write_str(d)
    bufs[lt].write_byte(0)
  }
  let has_tls = bufs[PO_TLS].len() > 0
  var tls_dir = -1
  if has_tls {
    pe_pad(bufs[lt], 8, 0)
    tls_dir = bufs[lt].len()
    // the directory (40 bytes) and an empty callback list
    bufs[lt].write(Bytes.zeroed(48))
  }
  // the debug directory (one IMAGE_DEBUG_DIRECTORY, 28 bytes) and its
  // CodeView record: RSDS, the GUID (pdb.xo pe_pdb sets it), age 1, the
  // PDB's path
  var dbg = -1
  var rsds = -1
  if !o.pdb.is_empty() {
    pe_pad(bufs[lt], 4, 0)
    dbg = bufs[lt].len()
    bufs[lt].write(Bytes.zeroed(28))
    rsds = bufs[lt].len()
    bufs[lt].write_str("RSDS")
    bufs[lt].write(Bytes.zeroed(16))
    for x in [1, 0, 0, 0] {
      bufs[lt].write_byte(UInt8(x))
    }
    bufs[lt].write_str(o.pdb)
    bufs[lt].write_byte(0)
  }
  // layout: the headers, then each section that has contents (.reloc's
  // size known after the relocations: placed last)
  let nsect_max = PO_DEBUG + dnames.len()
  let hdr = pe_up(64 + 4 + 20 + 240 + 40 * nsect_max, PE_FILE_ALIGN)
  var rva: List[Int] = []
  for _ in 0..nsect_max {
    rva.push(0)
  }
  var next = PE_SECT_ALIGN
  for k in [PO_TEXT, PO_RDATA, PO_DATA, PO_PTEXT, PO_PRDATA, PO_PWDATA, PO_PDATA, PO_TLS] {
    if bufs[k].len() == 0 {
      continue
    }
    rva[k] = next
    next = pe_up(next + pe_vsize(bufs, k, bss), PE_SECT_ALIGN)
  }
  // .rsrc (its data entries hold RVAs: built at its place)
  if !o.resources.is_empty() {
    rva[PO_RSRC] = next
    for x in pe_rsrc(o.resources, next) {
      bufs[PO_RSRC].write_byte(UInt8(x))
    }
    next = pe_up(next + bufs[PO_RSRC].len(), PE_SECT_ALIGN)
  }
  rva[PO_RELOC] = next
  let sym_rva = fn(t: PETarget) -> Int {
    if t.tls_index {
      return rva[PO_DATA] + tls_index_at
    }
    if !t.imp.is_empty() {
      return if t.iat { rva[lt] + (iat_at.get(t.imp) ?? 0) } else { rva[tk] + (thunk_at.get(t.imp) ?? 0) }
    }
    let p = places[t.obj][t.sect]
    rva[p.out] + p.off + t.off
  }
  // the relocations
  var based: List[Int] = []
  for (oi, ob) in objs.indexed() {
    for (si, s) in ob.sects.indexed() {
      let p = places[oi][si]
      if p.out < 0 {
        continue
      }
      for r in s.relocs {
        let t = targets[oi][r.sym]
        if t.obj < 0 && t.imp.is_empty() && !t.tls_index && !t.abs {
          return Err("${ob.path}: undefined symbol ${ob.syms[r.sym].name}${rt_hint(ob.syms[r.sym].name)}")
        }
        let at = p.off + r.addr
        if t.obj >= 0 && places[t.obj][t.sect].out < 0 {
          // a stripped atom (pestrip.xo): DWARF's references to it are 0,
          // any other is the strip's error
          if p.out >= PO_DEBUG {
            put_le(pats[p.out], at, 0, coff_rel_width(r.typ))
            continue
          }
          return Err("${ob.path}: ${ob.syms[r.sym].name} was stripped but ${s.name} refers to it")
        }
        let site = rva[p.out] + at
        if r.typ >= IMAGE_REL_AMD64_REL32 && r.typ <= IMAGE_REL_AMD64_REL32 + 5 {
          let n = r.typ - IMAGE_REL_AMD64_REL32
          let a = get_le(s.data, r.addr, 4)
          let v = sym_rva(t) + a - (site + 4 + n)
          if v < -0x80000000 || v > 0x7fffffff {
            return Err("${ob.path}: REL32 out of range")
          }
          put_le(pats[p.out], at, v, 4)
        } else if r.typ == IMAGE_REL_AMD64_ADDR64 {
          let a = get_le(s.data, r.addr, 8)
          put_le(pats[p.out], at, if t.abs { t.off + a } else { PE_BASE + sym_rva(t) + a }, 8)
          // (DWARF's addresses are not loaded: no base relocation; its
          // reader adds the image's distance from PE_BASE)
          if !t.abs && p.out < PO_DEBUG {
            based.push(site)
          }
        } else if r.typ == IMAGE_REL_AMD64_ADDR32NB {
          put_le(pats[p.out], at, sym_rva(t) + get_le(s.data, r.addr, 4), 4)
        } else if r.typ == IMAGE_REL_AMD64_SECREL {
          // the offset in the target's output section (the TLS block,
          // or a .debug_ section)
          let p2 = places[t.obj][t.sect]
          put_le(pats[p.out], at, p2.off + t.off + get_le(s.data, r.addr, 4), 4)
        } else {
          return Err("${ob.path}: relocation type ${r.typ}")
        }
      }
    }
  }
  // the thunks' displacements, the import tables, the TLS directory
  for (f, at) in thunk_at {
    let site = rva[tk] + at + 2
    put_le(pats[tk], at + 2, rva[lt] + (iat_at.get(f) ?? 0) - (site + 4), 4)
  }
  for (di, d) in dlls.indexed() {
    let e = idir + 20 * di
    put_le(pats[lt], e, rva[lt] + dll_ilt[di], 4)
    put_le(pats[lt], e + 12, rva[lt] + dll_name_at[di], 4)
    put_le(pats[lt], e + 16, rva[lt] + dll_iat[di], 4)
    for (fi, f) in (by_dll.get(d) ?? []).indexed() {
      let hn = rva[lt] + (hint_at.get(f) ?? 0)
      put_le(pats[lt], dll_ilt[di] + 8 * fi, hn, 8)
      put_le(pats[lt], dll_iat[di] + 8 * fi, hn, 8)
    }
  }
  if has_tls {
    let d = tls_dir
    put_le(pats[lt], d, PE_BASE + rva[PO_TLS], 8)
    put_le(pats[lt], d + 8, PE_BASE + rva[PO_TLS] + bufs[PO_TLS].len(), 8)
    put_le(pats[lt], d + 16, PE_BASE + rva[PO_DATA] + tls_index_at, 8)
    put_le(pats[lt], d + 24, PE_BASE + rva[lt] + d + 40, 8)
    put_le(pats[lt], d + 36, 0x400000, 4)
    for k in 0..4 {
      based.push(rva[lt] + d + 8 * k)
    }
  }
  // .reloc: a block per 4 KiB page of DIR64 entries, each block a whole
  // number of 4 byte words
  let sorted = based.sort()
  var i = 0
  while i < sorted.len() {
    let page = sorted[i] & ~0xfff
    var j = i
    while j < sorted.len() && (sorted[j] & ~0xfff) == page {
      j += 1
    }
    var n = j - i
    let pad = n % 2
    let size = 8 + 2 * (n + pad)
    for x in [page, size] {
      for k in 0..4 {
        bufs[PO_RELOC].write_byte(UInt8((x >> (8 * k)) & 0xff))
      }
    }
    for k in i..j {
      let e = (IMAGE_REL_BASED_DIR64 << 12) | (sorted[k] & 0xfff)
      bufs[PO_RELOC].write_byte(UInt8(e & 0xff))
      bufs[PO_RELOC].write_byte(UInt8(e >> 8))
    }
    if pad == 1 {
      bufs[PO_RELOC].write(Bytes.zeroed(2))
    }
    i = j
    n = 0
  }
  // the .debug_ sections after .reloc
  next = pe_up(next + bufs[PO_RELOC].len(), PE_SECT_ALIGN)
  for di in 0..dnames.len() {
    rva[PO_DEBUG + di] = next
    next = pe_up(next + bufs[PO_DEBUG + di].len(), PE_SECT_ALIGN)
  }
  // the entry
  var entry = -1
  if let Some((eo, es)) = globals.get(o.entry) {
    let s = objs[eo].syms[es]
    entry = sym_rva(PETarget{obj: eo, sect: s.sect - 1, off: s.value})
  }
  if entry < 0 {
    return Err("the entry ${o.entry} is not defined")
  }
  let img = pe_write(bufs, pats, rva, hdr, entry, o, has_tls, tls_dir, idir, dlls.len(), iat_start, iat_size, objs, places, bss, dnames, dbg, rsds)
  Ok((img, PELayout{objs: split, places: places, rva: rva, dnames: dnames, base: PE_BASE, targets: targets}))
}

/// The image: the DOS header, the PE headers and section table, the
/// sections, then the COFF symbol table and string table.
fn pe_write(bufs: List[BytesBuilder], pats0: List[List[BytePatch]], rva: List[Int], hdr: Int, entry: Int, o: PEOpts, has_tls: Bool, tls_dir: Int, idir: Int, ndll: Int, iat_start: Int, iat_size: Int, objs: List[CObj], places: List[List[PEPlace]], bss: Int, dnames: List[Str], dbg: Int, rsds: Int) -> Bytes {
  // the section holding the linker's tables (pe_link's lt)
  let lt = if o.prog_from >= 0 { PO_PRDATA } else { PO_RDATA }
  var pats = pats0
  let ctext = IMAGE_SCN_CNT_CODE + IMAGE_SCN_MEM_EXECUTE + IMAGE_SCN_MEM_READ
  let crdata = IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ
  let cdata = IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ + IMAGE_SCN_MEM_WRITE
  var names = [".text", ".rdata", ".data", ".xotext", ".xordata", ".xodata", ".pdata", ".tls", ".rsrc", ".reloc"]
  var chars = [ctext, crdata, cdata, ctext, crdata, cdata, IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ, IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ + IMAGE_SCN_MEM_WRITE, IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ, IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ + IMAGE_SCN_MEM_DISCARDABLE]
  for d in dnames {
    names.push(d)
    chars.push(IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ + IMAGE_SCN_MEM_DISCARDABLE)
  }
  var present: List[Int] = []
  var foff: List[Int] = []
  for k in 0..bufs.len() {
    foff.push(0)
    if bufs[k].len() > 0 {
      present.push(k)
    }
  }
  // file offsets
  var at = hdr
  for k in present {
    foff[k] = at
    at += pe_up(bufs[k].len(), PE_FILE_ALIGN)
  }
  let symtab = at
  if dbg >= 0 {
    // the debug directory: type CODEVIEW, the record's size, RVA and file
    // offset
    put_le(pats[lt], dbg + 12, 2, 4)
    put_le(pats[lt], dbg + 16, 24 + o.pdb.len() + 1, 4)
    put_le(pats[lt], dbg + 20, rva[lt] + rsds, 4)
    put_le(pats[lt], dbg + 24, foff[lt] + rsds, 4)
  }
  // the symbol table: each object's external and static symbols that are
  // in the image (not sections, not removed), with the output section's
  // number and the offset in it
  var syms: List[(Str, Int, Int, Int)] = []
  for (oi, ob) in objs.indexed() {
    for s in ob.syms {
      if s.aux || s.sect <= 0 || !(s.class == IMAGE_SYM_CLASS_EXTERNAL || s.class == IMAGE_SYM_CLASS_STATIC) {
        continue
      }
      let p = places[oi][s.sect - 1]
      if p.out < 0 || p.out >= PO_DEBUG || s.name.starts_with(".") || s.name.is_empty() {
        continue
      }
      var num = 0
      for (pi, k) in present.indexed() {
        if k == p.out {
          num = pi + 1
        }
      }
      syms.push((s.name, p.off + s.value, num, s.class))
    }
  }
  var long: List[Bytes] = []
  for (n, _, _, _) in syms {
    if n.len() > 8 {
      long.push(n.bytes())
    }
  }
  for d in dnames {
    if d.len() > 8 {
      long.push(d.bytes())
    }
  }
  let (strs, stroff) = coff_strtab(long)
  var w = new_out(symtab + 18 * syms.len() + strs.len())
  // the DOS header: MZ, e_lfanew at 0x3c
  w.u16(0x5a4d)
  w.zeros(58)
  w.u32(64)
  w.bytes("PE\0\0".bytes())
  w.u16(IMAGE_FILE_MACHINE_AMD64)
  w.u16(present.len())
  w.u32(0)
  w.u32(symtab)
  w.u32(syms.len())
  w.u16(240)
  w.u16(0x22)
  // the optional header (PE32+)
  var code = 0
  var idata = 0
  for k in present {
    let sz = pe_up(bufs[k].len(), PE_FILE_ALIGN)
    if k == PO_TEXT || k == PO_PTEXT {
      code += sz
    } else {
      idata += sz
    }
  }
  var image = PE_SECT_ALIGN
  for k in present {
    image = rva[k] + pe_up(pe_vsize(bufs, k, bss), PE_SECT_ALIGN)
  }
  w.u16(0x20b)
  w.u8(14)
  w.u8(0)
  w.u32(code)
  w.u32(idata)
  w.u32(0)
  w.u32(entry)
  w.u32(rva[PO_TEXT])
  w.u64(PE_BASE)
  w.u32(PE_SECT_ALIGN)
  w.u32(PE_FILE_ALIGN)
  w.u16(6)
  w.u16(0)
  w.u16(0)
  w.u16(0)
  w.u16(6)
  w.u16(0)
  w.u32(0)
  w.u32(image)
  w.u32(hdr)
  w.u32(0)
  w.u16(o.subsystem)
  // TERMINAL_SERVER_AWARE, NX_COMPAT, and unless fixed_base
  // DYNAMIC_BASE and HIGH_ENTROPY_VA
  w.u16(if o.fixed_base { 0x8100 } else { 0x8160 })
  w.u64(o.stack)
  w.u64(0x1000)
  w.u64(0x100000)
  w.u64(0x1000)
  w.u32(0)
  w.u32(16)
  // the data directories
  let dirs: List[(Int, Int)] = [
    (0, 0),
    (if ndll > 0 { rva[lt] + idir } else { 0 }, if ndll > 0 { 20 * (ndll + 1) } else { 0 }),
    (rva[PO_RSRC], bufs[PO_RSRC].len()),
    (rva[PO_PDATA], bufs[PO_PDATA].len()),
    (0, 0),
    (rva[PO_RELOC], bufs[PO_RELOC].len()),
    (if dbg >= 0 { rva[lt] + dbg } else { 0 }, if dbg >= 0 { 28 } else { 0 }),
    (0, 0),
    (0, 0),
    (if has_tls { rva[lt] + tls_dir } else { 0 }, if has_tls { 40 } else { 0 }),
    (0, 0),
    (0, 0),
    (if iat_size > 0 { rva[lt] + iat_start } else { 0 }, iat_size),
    (0, 0),
    (0, 0),
    (0, 0),
  ]
  for (r, s) in dirs {
    w.u32(r)
    w.u32(s)
  }
  for k in present {
    w.name(if names[k].len() > 8 { "/${stroff.get(names[k].bytes()) ?? 0}" } else { names[k] }, 8)
    w.u32(pe_vsize(bufs, k, bss))
    w.u32(rva[k])
    w.u32(pe_up(bufs[k].len(), PE_FILE_ALIGN))
    w.u32(foff[k])
    w.u32(0)
    w.u32(0)
    w.u16(0)
    w.u16(0)
    w.u32(chars[k])
  }
  w.zeros(hdr - w.n)
  for k in present {
    let d = bufs[k].freeze()
    write_patched(w.b, d, pats[k])
    w.n += d.len()
    w.zeros(pe_up(d.len(), PE_FILE_ALIGN) - d.len())
  }
  for (n, v, num, class) in syms {
    if n.len() > 8 {
      w.u32(0)
      w.u32(stroff.get(n.bytes()) ?? 0)
    } else {
      w.name(n, 8)
    }
    w.u32(v)
    w.u16(num)
    w.u16(0)
    w.u8(class)
    w.u8(0)
  }
  w.bytes(strs)
  w.done()
}

/// The names an object's `.xoweak` section lists (its weak definitions).
fn coff_weak_names(ob: CObj) -> Map[Str, Bool] {
  var out: Map[Str, Bool] = {}
  for s in ob.sects {
    if s.name != ".xoweak" {
      continue
    }
    var at = 0
    for i in 0..s.data.len() {
      if s.data[i] == 0 {
        if i > at {
          out[s.data[at..i].to_str() ?? ""] = true
        }
        at = i + 1
      }
    }
  }
  out
}
