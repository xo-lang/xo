// COFF x86-64 objects (decision 0254 stage 6b, step 3): the amd64
// emitter's windows/amd64 assembly into the object `llvm-mc -triple
// x86_64-pc-windows-msvc` writes for it, byte for byte. The parse, the
// data directives, the code and its branch relaxation are the ELF path's
// (asm_amd64.xo with Asm.elf); here are the COFF sections (.section NAME,
// "FLAGS"; .text, .data and .bss first, as LLVM makes them), the .seh
// directives with the unwind data LLVM builds from them (UNWIND_INFO in
// .xdata, RUNTIME_FUNCTION entries in .pdata), the relocations
// (IMAGE_REL_AMD64_*: the addend in the contents), and the object writer
// (the file header, the section headers, each section's contents and
// relocations, the symbol table with the sections' auxiliary records, the
// string table).

const IMAGE_FILE_MACHINE_AMD64 = 0x8664
const IMAGE_REL_AMD64_ADDR64 = 1
const IMAGE_REL_AMD64_ADDR32NB = 3
const IMAGE_REL_AMD64_REL32 = 4
const IMAGE_REL_AMD64_SECREL = 0xB
const IMAGE_SCN_CNT_CODE = 0x20
const IMAGE_SCN_CNT_INITIALIZED_DATA = 0x40
const IMAGE_SCN_CNT_UNINITIALIZED_DATA = 0x80
const IMAGE_SCN_LNK_INFO = 0x200
const IMAGE_SCN_LNK_REMOVE = 0x800
/// A section with 0xffff relocations or more: its header's 16 bit count is
/// 0xffff and the first relocation's VirtualAddress holds the number of
/// relocations, that one included (the PE format's extended relocations;
/// LLVM's COFF writer). Without it xo.exe's largest part lost every
/// relocation past the count modulo 65536 (0.25.1's windows/amd64 xo.exe
/// faulted in every build, 2026-10-22).
pub const IMAGE_SCN_LNK_NRELOC_OVFL = 0x01000000
/// The relocation count past which a section's count overflows.
const COFF_NRELOC_MAX = 0xffff
const IMAGE_SCN_MEM_EXECUTE = 0x20000000
const IMAGE_SCN_MEM_READ = 0x40000000
const IMAGE_SCN_MEM_WRITE = 0x80000000
const IMAGE_SYM_CLASS_EXTERNAL = 2
const IMAGE_SYM_CLASS_STATIC = 3
/// UNWIND_INFO's flags and codes (the x64 exception handling ABI)
const UNW_FLAG_EHANDLER = 1
const UNW_FLAG_UHANDLER = 2
const UWOP_PUSH_NONVOL = 0
const UWOP_ALLOC_LARGE = 1
const UWOP_ALLOC_SMALL = 2
const UWOP_SAVE_XMM128 = 8
const UWOP_SAVE_XMM128_FAR = 9

/// A function's unwind data from its .seh directives: the function's
/// symbol, the label at .seh_endproc, the handler (-1 none) and its
/// UNW_FLAG_* flags, the prologue's codes in order (the offset after the
/// instruction from the function's start, the operation, its info, and
/// the extra slots), the prologue's size, and the label of its
/// UNWIND_INFO in .xdata (-1 until written).
struct Seh {
  fsym: Int
  end: Int = -1
  handler: Int = -1
  flags: Int = 0
  codes: List[(Int, Int, Int, List[Int])] = []
  prolog: Int = 0
  info: Int = -1
}

/// assemble_coff_amd64: the COFF object of src (the amd64 emitter's
/// windows/amd64 assembly), or the first error as "line N: why".
pub fn assemble_coff_amd64(src: Bytes) -> Result[Bytes, Str] {
  assemble_coff(src, true)
}

/// assemble_coff_amd64_raw: assemble_coff_amd64 without the jump
/// padding (decision 0398), llvm-mc's bytes, for the goldens.
pub fn assemble_coff_amd64_raw(src: Bytes) -> Result[Bytes, Str] {
  assemble_coff(src, false)
}

fn assemble_coff(src: Bytes, jpad: Bool) -> Result[Bytes, Str] {
  var long: Map[Int, Bool] = {}
  while true {
    var a = Asm{elf: true, coff: true, amd64: true, xlong: long, xjpad: jpad}
    a.coff_defaults()
    a.parse(src)
    if !a.err.is_empty() {
      return Err(a.err)
    }
    var grew = false
    for br in a.xbrs {
      if !br.long && !a.x86_short_reaches(br) {
        long[br.seq] = true
        grew = true
      }
    }
    if grew {
      continue
    }
    a.coff_finish_seh()
    a.finish()
    if !a.err.is_empty() {
      return Err(a.err)
    }
    a.coff_pdata()
    if !a.err.is_empty() {
      return Err(a.err)
    }
    return Ok(a.write_coff())
  }
  Err("unreachable")
}

/// .text, .data and .bss, the sections LLVM's COFF streamer makes first,
/// with their default alignments.
fn (var a: Asm) coff_defaults() {
  a.coff_section(".text", IMAGE_SCN_CNT_CODE + IMAGE_SCN_MEM_EXECUTE + IMAGE_SCN_MEM_READ, 4)
  a.coff_section(".data", IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ + IMAGE_SCN_MEM_WRITE, 0)
  a.coff_section(".bss", IMAGE_SCN_CNT_UNINITIALIZED_DATA + IMAGE_SCN_MEM_READ + IMAGE_SCN_MEM_WRITE, 2)
  a.cur = -1
}

/// Switches to section name, made with characteristics ch and log2
/// alignment al the first time.
fn (var a: Asm) coff_section(name: Str, ch: Int, al: Int) {
  for (i, s) in a.sects.indexed() {
    if s.name == name {
      a.cur = i
      return
    }
  }
  let code = (ch & IMAGE_SCN_CNT_CODE) != 0
  a.sects.push(Sect{seg: "", name: name, flags: 0, code: code, align: al, cchar: ch})
  a.cur = a.sects.len() - 1
  // the section's symbol (always in the table, with its auxiliary record)
  let t = a.syms.len()
  a.syms.push(Sym{name: name.bytes(), sect: a.cur, secsym: true})
  a.sects[a.cur].ltmp = t
  if !code {
    a.push_item(a.cur, Item.Label(t))
  }
}

/// The characteristics of `.section NAME,"FLAGS"` (LLVM's COFF flags: b
/// uninitialized, d initialized, x code, r read only, w writable, n
/// removed at link, y not readable; .drectve is linker information).
fn coff_flags(name: Str, fl: Str) -> Int {
  var ch = 0
  var write = false
  var read = true
  var any = false
  for c in fl.bytes() {
    match c {
      'b' => {
        ch = ch | IMAGE_SCN_CNT_UNINITIALIZED_DATA
        any = true
      }
      'd' => {
        ch = ch | IMAGE_SCN_CNT_INITIALIZED_DATA
        any = true
      }
      'x' => {
        ch = ch | IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE
        any = true
      }
      'w' => write = true
      'n' => ch = ch | IMAGE_SCN_LNK_REMOVE
      'y' => read = false
      _ => {}
    }
  }
  if !any && (ch & IMAGE_SCN_LNK_REMOVE) == 0 {
    ch = ch | IMAGE_SCN_CNT_INITIALIZED_DATA
  }
  if read {
    ch = ch | IMAGE_SCN_MEM_READ
  }
  if write {
    ch = ch | IMAGE_SCN_MEM_WRITE
  }
  if name == ".drectve" {
    ch = ch | IMAGE_SCN_LNK_INFO
  }
  ch
}

/// The COFF directives; false for the ones the ELF path handles too.
fn (var a: Asm) coff_directive(d: Str, rest: Bytes) -> Bool {
  match d {
    ".text" => {
      a.coff_section(".text", 0, 4)
      true
    }
    ".data" => {
      a.coff_section(".data", 0, 0)
      true
    }
    ".bss" => {
      a.coff_section(".bss", 0, 2)
      true
    }
    ".section" => {
      let ps = split_operands(rest)
      if ps.is_empty() {
        a.fail(".section needs a name")
        return true
      }
      let name = bstr(ps[0])
      var fl = ""
      if ps.len() >= 2 {
        match unquote(ps[1]) {
          Some(f) => fl = bstr(f)
          None => {
            a.fail(".section ${name}: the flags are quoted")
            return true
          }
        }
      }
      a.coff_section(name, coff_flags(name, fl), 0)
      true
    }
    ".seh_proc" => {
      a.sehs.push(Seh{fsym: a.sym(rest)})
      true
    }
    ".seh_handler" => {
      let ps = split_operands(rest)
      if ps.is_empty() || a.sehs.is_empty() {
        a.fail(".seh_handler outside a .seh_proc")
        return true
      }
      let k = a.sehs.len() - 1
      a.sehs[k].handler = a.sym(ps[0])
      for p in ps[1..ps.len()] {
        let s = bstr(trim(p))
        if s == "@unwind" {
          a.sehs[k].flags = a.sehs[k].flags | UNW_FLAG_UHANDLER
        } else if s == "@except" {
          a.sehs[k].flags = a.sehs[k].flags | UNW_FLAG_EHANDLER
        } else {
          a.fail(".seh_handler ${s}")
        }
      }
      true
    }
    ".seh_pushreg" => {
      let r = x86_gp_number(trim(rest))
      if r < 0 {
        a.fail(".seh_pushreg ${bstr(rest)}")
        return true
      }
      a.seh_code(UWOP_PUSH_NONVOL, r, [])
      true
    }
    ".seh_stackalloc" => {
      let n = parse_int(trim(rest)) ?? -1
      if n <= 0 || n % 8 != 0 {
        a.fail(".seh_stackalloc ${bstr(rest)}")
      } else if n <= 128 {
        a.seh_code(UWOP_ALLOC_SMALL, n / 8 - 1, [])
      } else if n <= 512 * 1024 - 8 {
        a.seh_code(UWOP_ALLOC_LARGE, 0, [n / 8])
      } else {
        a.seh_code(UWOP_ALLOC_LARGE, 1, [n & 0xffff, n >> 16])
      }
      true
    }
    ".seh_savexmm" => {
      let ps = split_operands(rest)
      let r = if ps.len() == 2 { x86_xmm_number(trim(ps[0])) } else { -1 }
      let off = if ps.len() == 2 { parse_int(trim(ps[1])) ?? -1 } else { -1 }
      if r < 0 || off < 0 || off % 16 != 0 {
        a.fail(".seh_savexmm ${bstr(rest)}")
      } else if off / 16 <= 0xffff {
        a.seh_code(UWOP_SAVE_XMM128, r, [off / 16])
      } else {
        a.seh_code(UWOP_SAVE_XMM128_FAR, r, [off & 0xffff, off >> 16])
      }
      true
    }
    ".seh_endprologue" => {
      if !a.sehs.is_empty() {
        let k = a.sehs.len() - 1
        a.sehs[k].prolog = a.seh_offset()
      }
      true
    }
    ".seh_handlerdata" => {
      if a.sehs.is_empty() {
        a.fail(".seh_handlerdata outside a .seh_proc")
        return true
      }
      // the unwind information here, the handler's data after it in the
      // same section, as LLVM's streamer writes them
      a.seh_info(a.sehs.len() - 1)
      true
    }
    ".seh_endproc" => {
      if a.sehs.is_empty() {
        a.fail(".seh_endproc outside a .seh_proc")
        return true
      }
      let k = a.sehs.len() - 1
      let e = a.new_numeric(".Lseh_end".bytes())
      a.syms[e].sect = a.cur
      a.syms[e].off = a.code_len(a.cur)
      // in the function's atom (decision 0388): its end, not the next
      // function's start
      a.syms[e].atom = a.sects[a.cur].last_atom
      a.sehs[k].end = e
      if a.sehs[k].info < 0 {
        // a function with no handler data: its unwind information now,
        // as LLVM's streamer writes it at the end of the function
        let back = a.cur
        a.seh_info(k)
        a.cur = back
      }
      true
    }
    _ => false
  }
}

/// The open function's offset from its start: the current position in
/// its section.
fn (a: Asm) seh_offset() -> Int {
  let k = a.sehs.len() - 1
  a.code_len(a.cur) - a.syms[a.sehs[k].fsym].off
}

fn (var a: Asm) seh_code(op: Int, info: Int, extra: List[Int]) {
  if a.sehs.is_empty() {
    a.fail("an unwind code outside a .seh_proc")
    return
  }
  let k = a.sehs.len() - 1
  a.sehs[k].codes.push((a.seh_offset(), op, info, extra))
}

/// Writes function k's UNWIND_INFO at the end of .xdata: the version and
/// flags, the prologue's size, the count of code slots, no frame
/// register, the codes from the last to the first (each the offset, then
/// the operation and info, then its extra slots), a zero slot when the
/// count is odd, and the handler's address (an image relative word).
fn (var a: Asm) seh_info(k: Int) {
  let back = a.cur
  a.coff_section(".xdata", IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ, 2)
  let s = a.sehs[k]
  // UNWIND_INFO's SizeOfProlog and each code's offset are one byte: a
  // longer prologue (an x86 frame probed a page at a time past about 68
  // KiB) would wrap and the unwinder misread the frame (LLVM refuses it
  // too; gotchas/coff-relocation-count-overflow.md, the 16 bit counts)
  if s.prolog > 255 {
    a.fail("a prologue of ${s.prolog} bytes: UNWIND_INFO holds at most 255")
    return
  }
  var slots: List[Int] = []
  var i = s.codes.len() - 1
  while i >= 0 {
    let (off, op, info, extra) = s.codes[i]
    if off > 255 {
      a.fail("an unwind code at prologue byte ${off}: UNWIND_INFO holds at most 255")
      return
    }
    slots.push(off | ((op | (info << 4)) << 8))
    for x in extra {
      slots.push(x)
    }
    i -= 1
  }
  let n = slots.len()
  if n % 2 == 1 {
    slots.push(0)
  }
  let flags = if s.handler >= 0 { s.flags } else { 0 }
  var b: List[Int] = [1 | (flags << 3), s.prolog, n, 0]
  for v in slots {
    b.push(v & 0xff)
    b.push(v >> 8)
  }
  let si = a.cur
  a.push_item(si, Item.Align(2))
  let lab = a.new_numeric(".Lseh_info".bytes())
  a.syms[lab].sect = si
  a.push_item(si, Item.Label(lab))
  a.push_item(si, Item.Raw(int_bytes(b)))
  if s.handler >= 0 {
    a.register(s.handler)
    a.push_item(si, Item.Word(n: 4, a: s.handler, b: -1, k: 0))
  } else if n == 0 {
    // an UNWIND_INFO is 8 bytes at least: LLVM pads one with no codes
    a.push_item(si, Item.Raw(int_bytes([0, 0, 0, 0])))
  }
  a.sehs[k].info = lab
  if back >= 0 && a.sehs[k].end >= 0 {
    a.cur = back
  }
}

/// The UNWIND_INFO of the functions with no handler data, at the end of
/// .xdata in their order (before the layout).
fn (var a: Asm) coff_finish_seh() {
  let back = a.cur
  for k in 0..a.sehs.len() {
    if a.sehs[k].info < 0 {
      a.seh_info(k)
    }
  }
  a.cur = back
}

/// .pdata: a RUNTIME_FUNCTION per function (its start, its end, its
/// UNWIND_INFO, each an image relative word against the section's
/// symbol), after the layout.
fn (var a: Asm) coff_pdata() {
  if a.sehs.is_empty() {
    return
  }
  a.coff_section(".pdata", IMAGE_SCN_CNT_INITIALIZED_DATA + IMAGE_SCN_MEM_READ, 2)
  let si = a.cur
  var out = new_out(12 * a.sehs.len())
  for s in a.sehs {
    let f = a.syms[s.fsym]
    let e = a.syms[s.end]
    let x = a.syms[s.info]
    for (at, sect, v) in [(out.n, f.sect, f.off), (out.n + 4, e.sect, e.off), (out.n + 8, x.sect, x.off)] {
      let t = a.sects[sect].ltmp
      a.sects[si].relocs.push(Reloc{addr: at, typ: IMAGE_REL_AMD64_ADDR32NB, pcrel: false, len: 2, sym: t})
      a.syms[t].used = true
      out.u32(v)
    }
  }
  a.sects[si].bytes = out.done()
  a.sects[si].size = a.sects[si].bytes.len()
  a.sects[si].raw = true
}

fn int_bytes(b: List[Int]) -> Bytes {
  var o = new_out(b.len())
  for v in b {
    o.u8(v)
  }
  o.done()
}

/// The x86-64 register number (rax 0 ... r15 15) of a %reg64 operand,
/// -1 for none.
fn x86_gp_number(b: Bytes) -> Int {
  let s = bstr(b).trim_prefix("%")
  let names = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]
  for (i, n) in names.indexed() {
    if s == n {
      return i
    }
  }
  -1
}

fn x86_xmm_number(b: Bytes) -> Int {
  let s = bstr(b).trim_prefix("%")
  if !s.starts_with("xmm") {
    return -1
  }
  let n = Int.parse(s.trim_prefix("xmm")) ?? -1
  if n < 0 || n > 15 { -1 } else { n }
}

/// A COFF relocation of a code fixup: an image relative or section
/// relative operator, an absolute 8 bytes, or pc relative 4 bytes
/// (REL32 plus the bytes of the instruction past the field); a temporary
/// label becomes its section's symbol. The addend goes in the contents.
fn (var a: Asm) coff_x86_fix(f: XFx) {
  let s = a.syms[f.sym]
  var target = f.sym
  var inplace = 0
  var typ = 0
  if f.rel == "SECREL32" && f.size == 4 && !f.pcrel {
    typ = IMAGE_REL_AMD64_SECREL
    inplace = f.addend
  } else if !(f.rel is "" | "PLT") {
    // (a call's PLT: COFF has none, a plain REL32)
    a.err = "line ${f.line}: the COFF operator @${f.rel}"
    return
  } else if f.pcrel && f.size == 4 {
    let n = f.end - (f.at + 4)
    if n < 0 || n > 5 {
      a.err = "line ${f.line}: ${n} bytes past a pc relative field"
      return
    }
    typ = IMAGE_REL_AMD64_REL32 + n
    inplace = f.addend + 4 + n
  } else if !f.pcrel && f.size == 8 {
    typ = IMAGE_REL_AMD64_ADDR64
    inplace = f.addend
  } else {
    a.err = "line ${f.line}: a ${f.size} byte reference to ${bstr(s.name)}"
    return
  }
  if s.temp && s.sect >= 0 {
    if a.atoms && s.atom >= 0 {
      // atoms (decision 0388): a label in an atom is relocated to the
      // atom's symbol, so the reference is an edge to that atom
      target = s.atom
      inplace += s.off - a.syms[s.atom].off
    } else {
      target = a.sects[s.sect].ltmp
      inplace += s.off
    }
  }
  a.register(target)
  a.syms[target].used = true
  a.sects[f.sect].relocs.push(Reloc{addr: f.at, typ: typ, pcrel: f.pcrel, len: 2, sym: target})
  a.put_code(f.sect, f.at, inplace, f.size)
}

/// A data word naming sym (+ k): an 8 byte address (ADDR64) or a 4 byte
/// image relative one (ADDR32NB), or in a .debug_ section a 4 byte
/// offset in the target's section (SECREL: DWARF's references between
/// its sections, as LLVM's .secrel32); the value in the contents.
fn (var a: Asm) coff_data_reloc(si: Int, off: Int, n: Int, sym: Int, k: Int) -> Int {
  let s = a.syms[sym]
  var target = sym
  var v = k
  if s.temp && s.sect >= 0 {
    if a.atoms && s.atom >= 0 {
      target = s.atom
      v += s.off - a.syms[s.atom].off
    } else {
      target = a.sects[s.sect].ltmp
      v += s.off
    }
  }
  a.register(target)
  a.syms[target].used = true
  let typ = if n == 8 { IMAGE_REL_AMD64_ADDR64 } else if a.sects[si].name.starts_with(".debug_") { IMAGE_REL_AMD64_SECREL } else { IMAGE_REL_AMD64_ADDR32NB }
  a.sects[si].relocs.push(Reloc{addr: off, typ: typ, pcrel: false, len: if n == 8 { 3 } else { 2 }, sym: target})
  v
}

/// The JamCRC LLVM's COFF writer puts in a section's auxiliary record:
/// the reflected CRC-32 from 0, not inverted.
fn jamcrc(b: Bytes) -> Int {
  var crc = 0
  for x in b {
    crc = crc ^ Int(x)
    for _ in 0..8 {
      if (crc & 1) != 0 {
        crc = (crc >> 1) ^ 0xEDB88320
      } else {
        crc = crc >> 1
      }
    }
  }
  crc & 0xffffffff
}

/// The COFF object: the file header, the section headers, each
/// section's contents then its relocations, the symbol table (each
/// section's symbol with its auxiliary record, then the symbols in the
/// order they were first named), and the string table.
fn (var a: Asm) write_coff() -> Bytes {
  // the symbols: the sections', then the others named or defined
  var order: List[Int] = []
  for s in a.sects {
    order.push(s.ltmp)
  }
  for i in a.reg_order {
    let s = a.syms[i]
    if s.secsym {
      continue
    }
    if s.temp {
      continue
    }
    if s.sect < 0 && !(s.global || s.used) {
      continue
    }
    order.push(i)
  }
  // indexes (a section symbol takes two entries)
  var index: Map[Int, Int] = {}
  var n = 0
  for i in order {
    index[i] = n
    n += if a.syms[i].secsym { 2 } else { 1 }
  }
  // the string table: names past 8 bytes
  var long: List[Bytes] = []
  for i in order {
    if a.syms[i].name.len() > 8 {
      long.push(a.syms[i].name)
    }
  }
  let (strs, stroff) = coff_strtab(long)
  // layout: header 20, section headers 40 each, then contents and
  // relocations per section
  var off = 20 + 40 * a.sects.len()
  var data_at: List[Int] = []
  var rel_at: List[Int] = []
  for s in a.sects {
    let bss = (s.cchar & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0
    let size = if bss { 0 } else { a.coff_bytes(s).len() }
    data_at.push(if size == 0 { 0 } else { off })
    off += size
    rel_at.push(if s.relocs.is_empty() { 0 } else { off })
    off += 10 * (s.relocs.len() + (if s.relocs.len() >= COFF_NRELOC_MAX { 1 } else { 0 }))
  }
  let symtab = off
  var o = new_out(off + 18 * n + strs.len())
  o.u16(IMAGE_FILE_MACHINE_AMD64)
  o.u16(a.sects.len())
  o.u32(0)
  o.u32(symtab)
  o.u32(n)
  o.u16(0)
  o.u16(0)
  for (i, s) in a.sects.indexed() {
    // a name past 8 bytes (.debug_abbrev) is "/" and its offset in the
    // string table (its section symbol put it there)
    if s.name.len() > 8 {
      o.name("/${stroff.get(s.name.bytes()) ?? 0}", 8)
    } else {
      o.name(s.name, 8)
    }
    o.u32(0)
    o.u32(0)
    let bss = (s.cchar & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0
    o.u32(if bss { s.size } else { a.coff_bytes(s).len() })
    o.u32(data_at[i])
    o.u32(rel_at[i])
    o.u32(0)
    let ovfl = s.relocs.len() >= COFF_NRELOC_MAX
    o.u16(if ovfl { COFF_NRELOC_MAX } else { s.relocs.len() })
    o.u16(0)
    o.u32(s.cchar | ((s.align + 1) << 20) | (if ovfl { IMAGE_SCN_LNK_NRELOC_OVFL } else { 0 }))
  }
  for (i, s) in a.sects.indexed() {
    if data_at[i] != 0 {
      o.bytes(a.coff_bytes(s))
    }
    if s.relocs.len() >= COFF_NRELOC_MAX {
      // the count, the extra entry included
      o.u32(s.relocs.len() + 1)
      o.u32(0)
      o.u16(0)
    }
    for r in s.relocs {
      o.u32(r.addr)
      o.u32(index.get(r.sym) ?? 0)
      o.u16(r.typ)
    }
  }
  for i in order {
    let s = a.syms[i]
    if s.name.len() > 8 {
      o.u32(0)
      o.u32(stroff.get(s.name) ?? 0)
    } else {
      o.name(bstr(s.name), 8)
    }
    o.u32(if s.secsym || s.sect < 0 { 0 } else { s.off })
    o.u16(if s.sect < 0 { 0 } else { s.sect + 1 })
    o.u16(0)
    o.u8(if s.global || s.sect < 0 { IMAGE_SYM_CLASS_EXTERNAL } else { IMAGE_SYM_CLASS_STATIC })
    o.u8(if s.secsym { 1 } else { 0 })
    if s.secsym {
      let sc = a.sects[s.sect]
      let bss = (sc.cchar & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0
      let b = a.coff_bytes(sc)
      o.u32(if bss { sc.size } else { b.len() })
      o.u16(if sc.relocs.len() >= COFF_NRELOC_MAX { COFF_NRELOC_MAX } else { sc.relocs.len() })
      o.u16(0)
      o.u32(if bss { 0 } else { jamcrc(b) })
      o.u16(s.sect + 1)
      o.u8(0)
      o.zeros(3)
    }
  }
  o.bytes(strs)
  o.done()
}

/// A section's contents: its code bytes, or its data.
fn (a: Asm) coff_bytes(s: Sect) -> Bytes {
  if s.code {
    return int_bytes(s.words)
  }
  s.bytes
}

/// The COFF string table of names (its size first, then the names each
/// with a NUL, ordered and tail merged as LLVM's WinCOFF string table
/// builder), and each name's offset.
fn coff_strtab(names: List[Bytes]) -> (Bytes, Map[Bytes, Int]) {
  // strtab_build's table starts with a NUL byte; COFF's with its 4 byte
  // size, which the offsets count
  let (tab, offs) = strtab_build_at(names, 3)
  var o = new_out(tab.len() + 3)
  o.u32(tab.len() - 1 + 4)
  o.bytes(tab[1..tab.len()])
  (o.done(), offs)
}

/// COFF has no weak definition (decision 0388: std's helpers and generic
/// instances, which the program's object may define too): the names of
/// this object's `.weak_definition` symbols, NUL ended, in an `.xoweak`
/// section removed at the link, which pelink reads (coff_weak_names).
fn (var a: Asm) coff_weak_section() {
  var b = BytesBuilder.new()
  for s in a.syms {
    if s.weak_def && s.sect >= 0 && !s.temp {
      b.write(s.name)
      b.write_byte(0)
    }
  }
  if b.len() == 0 {
    return
  }
  let back = a.cur
  a.coff_section(".xoweak", IMAGE_SCN_LNK_INFO | IMAGE_SCN_LNK_REMOVE, 0)
  a.push_item(a.cur, Item.Raw(b.freeze()))
  a.cur = back
}
