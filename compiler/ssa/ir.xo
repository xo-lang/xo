// The SSA intermediate representation (internal/ssa ssa.go, decision
// 0045) in the table design of decisions 0141 and 0150: a type is an Int
// into the module's `types` (interned by name), a value an Int into its
// function's `values` (its ID), a block an Int into `blocks` (its ID), and
// an edge an Int into `edges`. -1 stands for none.

/// What a type is (ssa.Kind).
pub enum Kind {
  Unit
  Int
  Float
  Bool
  Str
  Struct
  Enum
  Tuple
  List
  Cap
  Func
  Box
  Handle
  /// A type the builder could not lower (poison): every function its name
  /// reaches is skipped.
  Bad
}

/// A named struct field or variant field.
pub struct SField {
  pub name: Str
  pub ty: Int
}

/// An enum variant; its tag is its index.
pub struct SVariant {
  pub name: Str
  pub fields: List[SField] = []
}

/// An SSA type (ssa.Type).
pub struct SType {
  pub kind: Kind
  /// The printed name: `Int`, `Body`, `List[Op]`, `(Int, Bool)`.
  pub name: Str
  pub fields: List[SField] = []
  pub variants: List[SVariant] = []
  /// Tuple elements; List: the element; Func: the parameters; Box and
  /// Handle: the type arguments.
  pub elems: List[Int] = []
  /// Func: the result.
  pub ret: Int = -1
  /// The struct of a Map or Set.
  pub coll: Bool = false
  /// A sized integer (0 for Int itself) or Float32 (32).
  pub bits: Int = 0
  pub unsigned: Bool = false
}

/// An instruction opcode (ssa.Op).
pub enum Op {
  Param
  Const
  Add
  Sub
  Mul
  Div
  Rem
  Neg
  And
  Or
  Xor
  Not
  Shl
  Shr
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  IntToFloat
  FloatToInt
  IntConv
  Struct
  Tuple
  Variant
  Field
  SetField
  Tag
  Payload
  Cap
  Undef
  Closure
  Capture
  CallValue
  Box
  Unbox
  FuncAddr
  Rebind
  Call
  Fault
  Retain
  Release
  Drop
  Reuse
  Share
  Jump
  Branch
  Return
  Unreachable
}

/// The printed name of an opcode.
pub fn op_name(o: Op) -> Str {
  match o {
    Param => "param"
    Const => "const"
    Add => "add"
    Sub => "sub"
    Mul => "mul"
    Div => "div"
    Rem => "rem"
    Neg => "neg"
    And => "and"
    Or => "or"
    Xor => "xor"
    Not => "not"
    Shl => "shl"
    Shr => "shr"
    Eq => "eq"
    Ne => "ne"
    Lt => "lt"
    Le => "le"
    Gt => "gt"
    Ge => "ge"
    IntToFloat => "itof"
    FloatToInt => "ftoi"
    IntConv => "iconv"
    Struct => "struct"
    Tuple => "tuple"
    Variant => "variant"
    Field => "field"
    SetField => "setfield"
    Tag => "tag"
    Payload => "payload"
    Cap => "cap"
    Undef => "undef"
    Closure => "closure"
    Capture => "capture"
    CallValue => "callv"
    Box => "box"
    Unbox => "unbox"
    FuncAddr => "funcaddr"
    Rebind => "rebind"
    Call => "call"
    Fault => "fault"
    Retain => "retain"
    Release => "release"
    Drop => "drop"
    Reuse => "reuse"
    Share => "share"
    Jump => "jump"
    Branch => "br"
    Return => "ret"
    Unreachable => "unreachable"
  }
}

/// Whether o ends a block.
pub fn is_terminator(o: Op) -> Bool {
  o is Op.Jump | Op.Branch | Op.Return | Op.Unreachable | Op.Fault
}

/// The payload of an instruction (ssa.Value.Aux): an integer (constant,
/// tag, field index), a Float, a Bool, a name (callee, capability field,
/// function), constant bytes, or a variant field (tag, field).
pub enum Aux {
  None
  I(n: Int)
  F(f: Float)
  B(b: Bool)
  S(s: Str)
  Bs(b: Bytes)
  P(tag: Int, field: Int)
}

/// An instruction or block parameter (ssa.Value); its ID is its index.
pub struct Value {
  pub op: Op
  /// The result type, -1 for none.
  pub ty: Int = -1
  pub args: List[Int] = []
  pub aux: Aux = Aux.None
  pub block: Int = -1
  /// Terminators: their edges.
  pub succs: List[Int] = []
  /// `file:line:col` for operations that can fault.
  pub pos: Str = ""
  /// The landing check of a call (Value.Pad), -1 for none.
  pub pad: Int = -1
  /// The source line of the statement it was lowered from, as line *
  /// 4096 + column (column at most 4095), 0 for none: the debug line
  /// tables (decision 0239). The file is the function's (Func.file).
  pub line: Int = 0
  /// The inline site (Func.inl_sites) this value was copied in by the
  /// arm64 inliner, -1 for the function's own code; its line is then the
  /// callee's, in the site's file (decision 0239, inlined frames).
  pub inl: Int = -1
}

/// A call the arm64 inliner copied a callee in at: the callee's name and
/// source file, the call's packed line (Value.line) in the enclosing
/// code, and the site that code was itself copied in at (-1: the
/// function's own).
pub struct InlSite {
  pub callee: Str
  pub file: Str
  pub call_line: Int
  pub parent: Int = -1
}

/// A source variable of a function (decision 0252): its name, the type
/// of its values (a module type), the packed line of its declaration
/// (Value.line's form), whether it is a parameter, and the inline site
/// it came in with (-1: the function's own; the arm64 inliner).
pub struct DVar {
  pub name: Str
  pub ty: Int
  pub line: Int = 0
  pub param: Bool = false
  pub inl: Int = -1
}

/// A binding record (decision 0252): from the packed line `line` on (0:
/// from the start of value's block, a join's parameter), variable `dvar`
/// (an index into Func.dvars) holds `value`. A side table, not an
/// instruction: passes that renumber or replace values update it
/// (passes.xo), and a record whose value is gone is dropped.
pub struct DBind {
  pub dvar: Int
  pub value: Int
  pub line: Int = 0
}

/// A control flow edge with the arguments for the target's parameters.
pub struct Edge {
  pub from: Int
  pub to: Int
  /// -1 for an argument not filled yet.
  pub args: List[Int] = []
}

/// A basic block: parameters, instructions (the last a terminator), and
/// incoming edges.
pub struct Block {
  pub params: List[Int] = []
  pub instrs: List[Int] = []
  pub preds: List[Int] = []
}

/// A function (ssa.Func); its parameters are the entry block's.
pub struct Func {
  pub name: Str
  /// The source file of the body, as diagnostics name it ("" for
  /// generated code): the debug line tables' file (decision 0239).
  pub file: Str = ""
  /// The arm64 inliner's call sites (Value.inl).
  pub inl_sites: List[InlSite] = []
  /// The source variables and their binding records (decision 0252).
  pub dvars: List[DVar] = []
  pub dbinds: List[DBind] = []
  pub results: List[Int] = []
  pub blocks: List[Block] = []
  pub values: List[Value] = []
  pub edges: List[Edge] = []
  /// The indexes of the `var` parameters (returned after the result).
  pub var_params: List[Int] = []
  /// Called through function values: parameter 0 is the closure.
  pub indirect: Bool = false
  pub captures: List[Int] = []
  /// Called by the runtime.
  pub entry: Bool = false
  /// The C symbol of a C ABI export (Func.Export, decision 0207), or "".
  pub export: Str = ""
  /// A fault in it returns (a closure given to Map.update): its unwind
  /// block does not go on to the caller (Func.Catches).
  pub catches: Bool = false
  /// The block that ends the function when it unwinds (Func.UnwindExit),
  /// -1 for none.
  pub unwind_exit: Int = -1
  /// The blocks split off after a check (Func.landRest: merged back when
  /// the check goes, mergeJumps).
  pub land_rest: Map[Int, Bool] = {}
  /// The payloads that take their enum's ownership (rc.xo walk): the
  /// enum dies there, so the payload's live leaves are not retained and
  /// the enum is not released (an Option matched and moved out of, where
  /// every field was shared and then dropped again, 2026-10-18).
  pub moved: Map[Int, Bool] = {}
  /// Per parameter, whether the callee only reads it (Func.Borrowed, set
  /// by InsertRC); empty before.
  pub borrowed: List[Bool] = []
  /// Why the builder left it incomplete (a construct outside the stages
  /// ported, decision 0150), or "": such a function is not compared.
  pub skip: Str = ""
  /// The back-end cache's key of the function as it is now (decision 0220
  /// addendum stage D 2c): "rc KEY" after insert_rc through the cache,
  /// "inl KEY" after the inliner's cache, "" when unknown. The key
  /// determines the function in full (its types by key), so the emitter's
  /// key hashes it instead of the function's text. Not in the codec; a
  /// pass that changes the function clears it.
  pub ckey: Str = ""
  /// The builder resolved a test of the build's target in it (a `match`
  /// or `if` on target.os or target.arch, or rt.sym_present on Windows):
  /// only such a function's constant result is folded into its callers
  /// (passes.xo fold_known_calls). Not in the codec.
  pub target: Bool = false
}

/// A lowered program (ssa.Module).
pub struct Module {
  /// write_func also prints each function's source variables and their
  /// binding records (`xo dev dump ssa --debug-vars`, decision 0252).
  pub show_dvars: Bool = false
  pub funcs: List[Func] = []
  /// Functions whose reference counting a cache entry holds and that are
  /// not decoded yet (decision 0220 addendum stage D 2b): by index, the
  /// entry and the inliner's summary of it; the function is a shell
  /// (rccache.xo lazy_shell) until force_lazy decodes it.
  pub lazy: Map[Int, LazyFn] = {}
  /// The facts that stand in for the body of a function the passes after
  /// inlining have not decoded (decision 0283 stage B, bodyfacts.xo), by
  /// index; such a function is a shell. Readers go through the accessors
  /// (block_names), which read the body when a function has no facts.
  pub facts: Map[Int, BodyFacts] = {}
  /// The first function of each name.
  pub func_at: Map[Str, Int] = {}
  pub types: List[SType] = []
  pub type_at: Map[Str, Int] = {}
  /// The names of the types and functions so far, hashed in order.
  pub fe_h: Int = 0
  /// The front end cache's recording of a body (fecache.xo), while on:
  /// the types and functions it found by name (their indices: fe_treads,
  /// fe_freads), and what it made, in order (fe_ev: 1 a type, its index;
  /// 2 an order entry, its type; 3 a function, its index; 4 a declare,
  /// its object; 5 a closure, its index; 6 a constant's use, its number,
  /// Builder.consts; 7 a thunk, its function; 8 a spawn site, its
  /// number). A declare
  /// pauses it: the commit replays a declare whole.
  pub fe_log: Bool = false
  pub fe_treads: Map[Int, Bool] = {}
  pub fe_freads: Map[Int, Bool] = {}
  /// the function names it looked for and did not find: a builder
  /// branches on that (a helper's `#n` or result suffix), and function
  /// names, unlike type names, do not say what they are
  pub fe_fabsent: Map[Str, Bool] = {}
  pub fe_ev: List[(Int, Int)] = []
  /// Named struct and enum types in creation order.
  pub order: List[Int] = []
  /// The build's target architecture (Builder.goarch), "" for the
  /// compiler's own; the LLVM emitter picks the spin hint by it.
  pub goarch: Str = ""
  /// A Linux program with no C library (XO_NOLIBC=1) whose process entry
  /// the backend emits (entry_stub_arm64 and entry_stub_amd64: _start,
  /// the thread pointer, main's stack, the call of main).
  pub nolibc_start: Bool = false
  /// A test of the arm64 emitter's spill paths: the register allocator
  /// uses only this many caller saved and this many callee saved registers
  /// of each class (and the
  /// calling convention's own), so most values spill ($XO_ARM64_REGS;
  /// 0, the default: all of them).
  pub arm64_regs: Int = 0
  /// The arm64 backend fills each frame's spill slots, outgoing argument
  /// words and memory area (frame homes, aggregates) with POISON in the
  /// prologue (XO_POISON_FRAMES=1): a read before any write sees a value
  /// no pointer, length or tag has, and faults or prints it at once
  /// instead of reading a stale word (2026-10-18: a frame home left
  /// unwritten on one loop entry read old return addresses).
  pub poison_frames: Bool = false
  /// The build guards the runtime's records (XO_HEAP_GUARD=1, Builder
  /// heap_guard): in the fn and part cache keys.
  pub heap_guard: Bool = false
  /// XO_OP_VERIFY=1 (decision 0274 step 3): the arm64 emitter parses each
  /// instruction line into an Op and fails the build when printing it does
  /// not give the line back
  pub op_verify: Bool = false
  /// Map and Set on the log and fork representation (decision 0291,
  /// check.Checker map_log): in the fn and part cache keys.
  pub map_log: Bool = false
  /// Functions the arm64 inliner leaves out, by name, or by prefix for
  /// an entry ending in `*` ($XO_INLINE_DENY, comma separated): a
  /// measurement knob, each callee's speed against its text
  /// (bench/results/inline-ledger-2026-10-17.md).
  pub inline_deny: List[Str] = []
  /// The optional optimization passes turned off, by name ($XO_PASSES,
  /// `-name` entries, comma separated; compiler/arm64 passes.xo
  /// PASSES): miscompile triage (`xo dev bisect-pass`) builds with
  /// passes off to find the one whose output diverges.
  pub passes_off: List[Str] = []
  /// The tasks a whole-module analysis may use (may_fault's scan); the
  /// result does not depend on it. The driver sets it (emit_jobs).
  pub jobs: Int = 1
  /// --race on the arm64 backend (decision 0273): ThreadSanitizer's calls
  /// at loads, stores, and atomics (compiler/arm64 race.xo); set by the
  /// driver.
  pub race: Bool = false
  /// Emit DWARF line tables (decision 0239): set by the driver; off for
  /// `xo asm`, `-s`, and release builds without --debug-info.
  pub debug_info: Bool = false
  /// Variable locations may name a data address (a string literal's
  /// object, DW_OP_addrx; compiler/arm64 dwvars.xo): set by the driver
  /// when the debug information's writer relocates it, an ELF link or
  /// compiler/macho's dSYM; dsymutil adds the function's own offset to an
  /// address in a location list, so not for a cc link on macOS.
  pub dw_data_addrs: Bool = false
  /// The directory the sources' names are relative to (DW_AT_comp_dir).
  pub comp_dir: Str = ""
  /// The directory std/'s files are named relative to (std/..): their
  /// directory in the line tables.
  pub std_root: Str = ""
  /// A Linux program with no C library (XO_NOLIBC=1): the emitters define
  /// the C library's data symbols (nolibc_data, decision 0234).
  pub nolibc: Bool = false
}

/// The C library's data symbols of a program with no C library (Module
/// nolibc, decision 0234): one word each, zero at start, defined by the
/// emitters and set by cabi_nolibc.xo nl_start (environ and the
/// standard streams' FILE records; xo_lse, 1 when the CPU has ARMv8.1's
/// LSE atomics, which compiler/macho elflink's outline atomics test).
pub fn nolibc_data() -> List[Str] { ["environ", "stdin", "stdout", "stderr", "xo_lse"] }

/// The process entry of a program linked with no C library (Module
/// nolibc_start), as assembly for arm64 Linux (the same text through
/// the arm64 emitter and the LLVM emitter's module asm). From the
/// initial stack (argc, argv, envp, the auxiliary vector): Xo records
/// it, sets environ, stdin, stdout and stderr (the emitters' data
/// symbols, decision 0234) and returns environ (xo_x_nl_start), maps the
/// main thread's TLS block (xo_x_nl_main_tp, set in tpidr_el0) and its
/// 1 GiB stack (xo_x_nl_main_stack, 0 to stay on the initial one); then
/// main(argc, argv, envp) and exit with its result. _start has no unwind
/// information, so the unwinder's walk ends there (std/native/llrt
/// unwind.xo: a pc with no frame).
pub fn entry_stub_arm64() -> Str {
  // the process's outermost frame: fp zero, and its unwind entry's
  // return address undefined (DW_CFA_undefined x30), where debuggers'
  // backtraces end
  "\t.text\n\t.globl _start\n\t.type _start, %function\n\t.p2align 2\n_start:\n\t.cfi_startproc\n\t.cfi_escape 0x07, 30\n" +
    "\tmov x29, #0\n\tmov x30, #0\n\tmov x19, sp\n\tand sp, x19, #-16\n" +
    "\tmov x0, x19\n\tbl xo_x_nl_start\n\tmov x20, x0\n" +
    "\tbl xo_x_nl_main_tp\n\tmsr tpidr_el0, x0\n" +
    "\tbl xo_x_nl_main_stack\n\tcbz x0, 1f\n\tmov sp, x0\n1:\n" +
    "\tmov x29, #0\n\tldr x0, [x19]\n\tadd x1, x19, #8\n\tmov x2, x20\n\tbl main\n\tbl exit\n\tbrk #1\n" +
    "\t.cfi_endproc\n\t.size _start, .-_start\n"
}

/// entry_stub_arm64 for x86_64 Linux: the thread pointer (fs) is set by
/// xo_x_nl_main_tp itself (arch_prctl); rbx and r12 keep the initial
/// stack and environ across the calls.
pub fn entry_stub_amd64() -> Str {
  "\t.text\n\t.globl _start\n\t.type _start, @function\n\t.p2align 4\n_start:\n" +
    "\txorl %ebp, %ebp\n\tmovq %rsp, %rbx\n\tandq $-16, %rsp\n" +
    "\tmovq %rbx, %rdi\n\tcall xo_x_nl_start\n\tmovq %rax, %r12\n" +
    "\tcall xo_x_nl_main_tp\n" +
    "\tcall xo_x_nl_main_stack\n\ttestq %rax, %rax\n\tjz 1f\n\tmovq %rax, %rsp\n1:\n" +
    "\txorl %ebp, %ebp\n\tmovq (%rbx), %rdi\n\tleaq 8(%rbx), %rsi\n\tmovq %r12, %rdx\n\tcall main\n\tmovl %eax, %edi\n\tcall exit\n\thlt\n" +
    "\t.size _start, .-_start\n"
}

// ---------------------------------------------------------------------------
// Types

fn kind_name(k: Kind) -> Str {
  match k {
    Unit => "()"
    Int => "Int"
    Float => "Float"
    Bool => "Bool"
    Str => "Str"
    _ => "?"
  }
}

/// The builtin type of kind k (unit, Int, Float, Bool, Str).
pub fn (var m: Module) builtin(k: Kind) -> Int {
  let name = kind_name(k)
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: k, name: name})
}

fn (var m: Module) intern(t: SType) -> Int {
  let i = m.types.len()
  m.type_at[t.name] = i
  m.fe_h = fe_mix(m.fe_h, t.name)
  m.types.push(t)
  if m.fe_log {
    m.fe_ev.push((1, i))
  }
  i
}

/// Type t found by name, while a body records (Module.fe_log).
fn (var m: Module) fe_seen(t: Int) {
  if m.fe_log {
    m.fe_treads[t] = true
  }
}

pub fn (var m: Module) float32() -> Int {
  if let Some(t) = m.type_at.get("Float32") {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: Kind.Float, name: "Float32", bits: 32})
}

/// The sized integer type named name (Int8 to UInt64, or Rune), or -1.
pub fn (var m: Module) int_type(name: Str) -> Int {
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  let (bits, unsigned) = match name {
    "Int8" => (8, false)
    "Int16" => (16, false)
    "Int32" => (32, false)
    "UInt8" => (8, true)
    "UInt16" => (16, true)
    "UInt32" => (32, true)
    "UInt64" => (64, true)
    "Rune" => (32, false)
    _ => return -1
  }
  m.intern(SType{kind: Kind.Int, name: name, bits: bits, unsigned: unsigned})
}

/// The tuple type of elems (unit when empty).
pub fn (var m: Module) tuple(elems: List[Int]) -> Int {
  if elems.is_empty() {
    return m.builtin(Kind.Unit)
  }
  var names: List[Str] = []
  for e in elems {
    names.push(m.types[e].name)
  }
  let name = "(${names.join(", ")})"
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: Kind.Tuple, name: name, elems: elems})
}

pub fn (var m: Module) list(elem: Int) -> Int {
  let name = "List[${m.types[elem].name}]"
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: Kind.List, name: name, elems: [elem]})
}

pub fn (var m: Module) box_of(elem: Int) -> Int {
  let name = "Box[${m.types[elem].name}]"
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: Kind.Box, name: name, elems: [elem]})
}

pub fn (var m: Module) handle(name: Str, elems: List[Int]) -> Int {
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: Kind.Handle, name: name, elems: elems})
}

pub fn (var m: Module) func_type(params: List[Int], ret: Int) -> Int {
  var names: List[Str] = []
  for p in params {
    names.push(m.types[p].name)
  }
  let name = "fn(${names.join(", ")}) -> ${m.types[ret].name}"
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return t
  }
  m.intern(SType{kind: Kind.Func, name: name, elems: params, ret: ret})
}

/// The named type, created empty with kind k (the caller fills it) when it
/// is new; the second result reports that.
pub fn (var m: Module) named(name: Str, k: Kind) -> (Int, Bool) {
  if let Some(t) = m.type_at.get(name) {
    m.fe_seen(t)
    return (t, false)
  }
  let t = m.intern(SType{kind: k, name: name})
  if k is Kind.Struct | Kind.Enum {
    m.order.push(t)
    if m.fe_log {
      m.fe_ev.push((2, t))
    }
  }
  (t, true)
}

pub fn (m: Module) field_index(t: Int, name: Str) -> Int {
  for (i, f) in m.types[t].fields.indexed() {
    if f.name == name {
      return i
    }
  }
  -1
}

pub fn (m: Module) variant_index(t: Int, name: Str) -> Int {
  for (i, v) in m.types[t].variants.indexed() {
    if v.name == name {
      return i
    }
  }
  -1
}

pub fn (m: Module) is_sized(t: Int) -> Bool {
  m.types[t].kind == Kind.Int && m.types[t].bits != 0
}

pub fn (m: Module) is_u64(t: Int) -> Bool {
  m.types[t].kind == Kind.Int && m.types[t].bits == 64 && m.types[t].unsigned
}

pub fn (m: Module) is_f32(t: Int) -> Bool {
  m.types[t].kind == Kind.Float && m.types[t].bits == 32
}

/// Whether values of t hold heap memory (Type.Heap).
pub fn (m: Module) heap(t: Int) -> Bool {
  m.heap_in(t, [])
}

fn (m: Module) heap_in(t: Int, seen: List[Int]) -> Bool {
  if seen.contains(t) {
    return true
  }
  var s2 = seen
  s2.push(t)
  let x = m.types[t]
  match x.kind {
    Str | List | Func | Box | Handle => return true
    Struct => {
      for f in x.fields {
        if m.heap_in(f.ty, s2) {
          return true
        }
      }
    }
    Enum => {
      for v in x.variants {
        for f in v.fields {
          if m.heap_in(f.ty, s2) {
            return true
          }
        }
      }
    }
    Tuple => {
      for e in x.elems {
        if m.heap_in(e, s2) {
          return true
        }
      }
    }
    Unit | Int | Float | Bool | Cap | Bad => {}
  }
  false
}

// ---------------------------------------------------------------------------
// Functions

/// Adds a function with an entry block whose parameters have the given
/// types; returns its index.
pub fn (var m: Module) new_func(name: Str, params: List[Int], results: List[Int]) -> Int {
  var f = Func{name: name, results: results}
  f.blocks.push(Block{})
  for p in params {
    f.add_param(0, p)
  }
  let i = m.funcs.len()
  m.funcs.push(f)
  m.fe_h = fe_mix(m.fe_h, name)
  if m.fe_log {
    m.fe_ev.push((3, i))
  }
  if !m.func_at.contains(name) {
    m.func_at[name] = i
  }
  i
}

/// The index of the function named name, or -1.
pub fn (m: Module) func_index(name: Str) -> Int {
  m.func_at.get(name) ?? -1
}

/// Renames function i (Func.Name = ...).
pub fn (var m: Module) rename_func(i: Int, name: Str) {
  let old = m.funcs[i].name
  if (m.func_at.get(old) ?? -1) == i {
    m.func_at.remove(old)
    // a later function of the old name is found by name again
    for (j, f) in m.funcs.indexed() {
      if j != i && f.name == old {
        m.func_at[old] = j
        break
      }
    }
  }
  m.funcs[i].name = name
  if !m.func_at.contains(name) || (m.func_at.get(name) ?? -1) > i {
    m.func_at[name] = i
  }
}

pub fn (var f: Func) new_block() -> Int {
  f.blocks.push(Block{})
  f.blocks.len() - 1
}

pub fn (var f: Func) add_param(b: Int, t: Int) -> Int {
  let v = f.values.len()
  f.values.push(Value{op: Op.Param, ty: t, block: b})
  f.blocks[b].params.push(v)
  v
}

/// Appends an instruction to block b.
pub fn (var f: Func) add(b: Int, op: Op, t: Int, aux: Aux, args: List[Int]) -> Int {
  let v = f.values.len()
  f.values.push(Value{op: op, ty: t, args: args, aux: aux, block: b})
  f.blocks[b].instrs.push(v)
  v
}

fn (var f: Func) link(from: Int, to: Int, args: List[Int]) -> Int {
  let e = f.edges.len()
  f.edges.push(Edge{from: from, to: to, args: args})
  f.blocks[to].preds.push(e)
  e
}

/// Ends block b with a jump to to.
pub fn (var f: Func) jump(b: Int, to: Int, args: List[Int]) -> Int {
  let t = f.add(b, Op.Jump, -1, Aux.None, [])
  let e = f.link(b, to, args)
  f.values[t].succs = [e]
  t
}

/// Ends block b with a conditional branch.
pub fn (var f: Func) branch(b: Int, cond: Int, yes: Int, no: Int) -> Int {
  let t = f.add(b, Op.Branch, -1, Aux.None, [cond])
  let e1 = f.link(b, yes, [])
  let e2 = f.link(b, no, [])
  f.values[t].succs = [e1, e2]
  t
}

/// The terminator of block b, or -1.
pub fn (f: Func) term(b: Int) -> Int {
  let ins = f.blocks[b].instrs
  if ins.is_empty() {
    return -1
  }
  let t = ins[ins.len() - 1]
  if !is_terminator(f.values[t].op) {
    return -1
  }
  t
}

// ---------------------------------------------------------------------------
// Printing (print.go)

/// The module in the form of Module.String.
pub fn (m: Module) text() -> Str {
  var b = StrBuilder.new()
  m.write_types(b)
  for (i, f) in m.funcs.indexed() {
    if i > 0 {
      b.write("\n")
    }
    m.write_func(b, f)
  }
  b.freeze()
}

pub fn (m: Module) write_types(var b: StrBuilder) {
  for t in m.order {
    let line = m.type_line(t)
    if line.contains("<unsupported: ") {
      // a type holding one the builder could not lower (poison)
      continue
    }
    b.write(line)
    b.write("\n")
  }
  if !m.order.is_empty() {
    b.write("\n")
  }
}

/// Whether a type of f (of a value, a result, or a capture) holds a type
/// the builder could not lower (poison): a type name, not a constant
/// string that holds the text.
pub fn (m: Module) has_poison(f: Func) -> Bool {
  for v in f.values {
    if v.ty >= 0 && m.types[v.ty].name.contains("<unsupported: ") {
      return true
    }
    if v.op != Op.Const {
      // a callee or closure named after one (`f[<unsupported: T>]`)
      if let S(s) = v.aux {
        if s.contains("<unsupported: ") {
          return true
        }
      }
    }
  }
  for t in f.results {
    if m.types[t].name.contains("<unsupported: ") {
      return true
    }
  }
  for t in f.captures {
    if m.types[t].name.contains("<unsupported: ") {
      return true
    }
  }
  false
}

/// The line of a named struct or enum type.
pub fn (m: Module) type_line(t: Int) -> Str {
  let x = m.types[t]
  if x.kind == Kind.Struct {
    var fs: List[Str] = []
    for f in x.fields {
      fs.push("${f.name}: ${m.types[f.ty].name}")
    }
    return "type ${x.name} = struct { ${fs.join(", ")} }"
  }
  var vs: List[Str] = []
  for v in x.variants {
    if v.fields.is_empty() {
      vs.push(v.name)
      continue
    }
    var fs: List[Str] = []
    for f in v.fields {
      fs.push("${f.name}: ${m.types[f.ty].name}")
    }
    vs.push("${v.name}(${fs.join(", ")})")
  }
  "type ${x.name} = enum { ${vs.join(" | ")} }"
}

/// One function in the form of Func.String.
pub fn (m: Module) func_text(f: Func) -> Str {
  var b = StrBuilder.new()
  m.write_func(b, f)
  b.freeze()
}

fn (m: Module) write_func(var b: StrBuilder, f: Func) {
  var ps: List[Str] = []
  for (i, p) in f.blocks[0].params.indexed() {
    let bw = if i < f.borrowed.len() && f.borrowed[i] { "borrow " } else { "" }
    ps.push("${bw}v${p}: ${m.type_name(f.values[p].ty)}")
  }
  var rs: List[Str] = []
  for r in f.results {
    rs.push(m.type_name(r))
  }
  var res = rs.join(", ")
  if rs.len() != 1 {
    res = "(${res})"
  }
  if f.indirect {
    var cs: List[Str] = []
    for c in f.captures {
      cs.push(m.type_name(c))
    }
    res = "${res} captures (${cs.join(", ")})"
  }
  b.write("func ${f.name}(${ps.join(", ")}) -> ${res} {\n")
  for (bi, bl) in f.blocks.indexed() {
    b.write("b${bi}")
    if !bl.params.is_empty() {
      var qs: List[Str] = []
      for p in bl.params {
        qs.push("v${p}: ${m.type_name(f.values[p].ty)}")
      }
      b.write("(${qs.join(", ")})")
    }
    b.write(":")
    if !bl.preds.is_empty() {
      var qs: List[Str] = []
      for e in bl.preds {
        qs.push("b${f.edges[e].from}")
      }
      b.write("  ; preds ${qs.join(", ")}")
    }
    b.write("\n")
    for v in bl.instrs {
      b.write("  ")
      m.write_value(b, f, v)
      b.write("\n")
    }
  }
  if m.show_dvars {
    for (i, d) in f.dvars.indexed() {
      let p = if d.param { " param" } else { "" }
      let s = if d.inl >= 0 { " site ${d.inl}" } else { "" }
      b.write("  ; var ${i} ${d.name}: ${m.type_name(d.ty)} line ${d.line / 4096}:${d.line % 4096}${p}${s}\n")
    }
    for d in f.dbinds {
      b.write("  ; bind ${d.dvar} = v${d.value} from ${d.line / 4096}:${d.line % 4096}\n")
    }
  }
  b.write("}\n")
}

fn (m: Module) type_name(t: Int) -> Str {
  if t < 0 {
    return "<nil>"
  }
  m.types[t].name
}

fn vname(v: Int) -> Str {
  if v < 0 {
    return "<nil>"
  }
  "v${v}"
}

fn (m: Module) write_value(var b: StrBuilder, f: Func, vi: Int) {
  let v = f.values[vi]
  if v.ty >= 0 && !is_terminator(v.op) {
    b.write("v${vi}: ${m.types[v.ty].name} = ")
  }
  b.write(op_name(v.op))
  var ops: List[Str] = []
  match v.aux {
    None => {}
    I(n) => ops.push("${n}")
    F(x) => ops.push(float_text(x))
    B(x) => ops.push(if x { "true" } else { "false" })
    S(s) => ops.push(if v.op == Op.Const { s.quote() } else { s })
    Bs(x) => ops.push(x.quote())
    P(tag, field) => ops.push("${tag}.${field}")
  }
  for a in v.args {
    ops.push(vname(a))
  }
  for e in v.succs {
    var eas: List[Str] = []
    for a in f.edges[e].args {
      eas.push(vname(a))
    }
    ops.push("b${f.edges[e].to}(${eas.join(", ")})")
  }
  if !ops.is_empty() {
    b.write(" ${ops.join(", ")}")
  }
  if !v.pos.is_empty() {
    b.write(" @ ${v.pos}")
  }
  if v.pad >= 0 {
    b.write(" lands v${v.pad}")
  }
}

/// A Float as print.go writes it: strconv 'g' with -1 precision, and
/// `.0` after a whole number (the same text as Xo's `${x}`).
fn float_text(x: Float) -> Str {
  "${x}"
}

/// The runtime's slow paths (std/native/llrt), kept out of line: cold in
/// LLVM (compiler/llvm func.xo) and never inlined by the arm64 inliner.
/// Inlined into a user's loop around their fast path (the test world's
/// lock around Rand's step), they took the registers the loop's
/// invariants lived in, and LLVM rebuilt them each iteration
/// (bench/results/zero-c-perf-sweep-2026-10-15.md: testworld rand 1.08);
/// on arm64, push_slow inlined into obj.rs_push_word made the push 31 to
/// 128 instructions and the digests 5 to 8% slower (2026-10-16). A
/// map's rebuild (a table that grows) inlined into its put made every put
/// save and spill for the rare growth: update, putget and copymut 1.9 to
/// 2.6% fewer instructions out of line (2026-10-17; LLVM unchanged).
/// The log map's findx (forks, scans; decision 0291) inlined into its
/// small find made find 292 instructions and a get 3 times slower
/// (2026-10-20). Its newdir stays a call so the directory's length is
/// not known where log.push grows it (2026-10-21). The hybrid Map's
/// log and conversion paths stay calls (2026-10-21: inlined, the lists'
/// put doubled in size).
pub fn cold_fn(name: Str) -> Bool {
  name is "pool.lock_slow" | "pool.futex_wake" | "budget.tick_slow" | "mutex.held_add_slow" | "obj.reserve_slow" | "obj.push_slow" | "obj.rl_free_n_slow" | "stdio.out_slow" ||
    name.starts_with("xo.map.rebuild[") || name.starts_with("xo.mlog.findx[") || name.starts_with("xo.mlog.newdir[") ||
    name.starts_with("xo.maph.slowput[") || name.starts_with("xo.maph.slowrem[") || name.starts_with("xo.maph.loglookup[") || name.starts_with("xo.maph.putrest[") || name.starts_with("xo.maph.remrest[") || name.starts_with("xo.maph.logget[")
}
