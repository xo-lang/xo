// The cleanup cache's keys and entries (decision 0382 step 1): a key by
// name, not by index; the may_fault bits of what a function calls in it;
// an entry that reads back as the function it was made of.

use std/crypto

/// f calls g and h; g faults, h does not. With extra, an unrelated
/// function comes first (every index moves by one).
fn calls_module(extra: Bool) -> Module {
  var m = Module{}
  let it = m.intern(SType{kind: Kind.Int, name: "Int"})
  if extra {
    let _z = m.new_func("z", [], [])
  }
  let fi = m.new_func("f", [it], [it])
  let gi = m.new_func("g", [], [])
  let hi = m.new_func("h", [], [])
  var g = m.funcs[gi]
  let _flt = g.add(0, Op.Fault, -1, Aux.None, [])
  m.funcs[gi] = g
  var h = m.funcs[hi]
  let _r = h.add(0, Op.Return, -1, Aux.None, [])
  m.funcs[hi] = h
  var f = m.funcs[fi]
  let p = f.blocks[0].params[0]
  let _cg = f.add(0, Op.Call, -1, Aux.S(s: "g"), [])
  let _ch = f.add(0, Op.Call, -1, Aux.S(s: "h"), [])
  let _rf = f.add(0, Op.Return, -1, Aux.None, [p])
  m.funcs[fi] = f
  m
}

fn key_of(m: Module, name: Str, flags: Str) -> Str {
  cln_key(m, m.func_index(name), m.may_fault(), type_keys(m), "xo-id", flags, ClnFacts{})
}

test "a cln key is the same when every index moves" {
  let a = calls_module(false)
  let b = calls_module(true)
  expect(key_of(a, "f", "fl")) == key_of(b, "f", "fl")
  expect(key_of(a, "f", "fl") == key_of(a, "g", "fl")) == false
}

test "a cln key changes with a callee's may_fault bit, the flags and the identity" {
  let m = calls_module(false)
  let k = key_of(m, "f", "fl")
  var faults = m.may_fault()
  faults[m.func_index("h")] = true
  expect(cln_key(m, m.func_index("f"), faults, type_keys(m), "xo-id", "fl", ClnFacts{}) == k) == false
  // a function f does not name
  var other = m.may_fault()
  let mz = calls_module(true)
  expect(key_of(mz, "f", "fl")) == k
  other[m.func_index("f")] = !other[m.func_index("f")]
  expect(cln_key(m, m.func_index("f"), other, type_keys(m), "xo-id", "fl", ClnFacts{})) == k
  expect(key_of(m, "f", "fl2") == k) == false
  expect(cln_key(m, m.func_index("f"), m.may_fault(), type_keys(m), "xo-id2", "fl", ClnFacts{}) == k) == false
}

test "a replayed body's cln key is its front end entry's and what the replay set, with its callees' prune_unwind and fold bits" {
  let m = calls_module(false)
  let fi = m.func_index("f")
  let faults = m.may_fault()
  let tk = type_keys(m)
  // f is 0, g 1, h 2
  let facts = ClnFacts{fe: {fi: b"fe entry"}, pre: [false, true, false], may: [false, false, false], known: ["", "", ""]}
  let k = cln_key(m, fi, faults, tk, "id", "fl", facts)
  expect(k == key_of(m, "f", "fl")) == false
  // the body's ops are not hashed: the entry's key stands for them
  var m2 = m
  var f2 = m2.funcs[fi]
  f2.values[0].op = Op.Undef
  m2.funcs[fi] = f2
  expect(cln_key(m2, fi, faults, tk, "id", "fl", facts)) == k
  // what a replay sets beyond the entry is (key_replayed): a line moved
  // with its declaration, a constant numbered as this build numbers it
  var m3 = m
  var f3 = m3.funcs[fi]
  f3.values[0].line += 4096
  m3.funcs[fi] = f3
  expect(cln_key(m3, fi, faults, tk, "id", "fl", facts) == k) == false
  var m4 = m
  var f4 = m4.funcs[fi]
  let _c = f4.add(0, Op.Const, -1, Aux.I(n: 7), [])
  m4.funcs[fi] = f4
  expect(cln_key(m4, fi, faults, tk, "id", "fl", facts) == k) == false
  expect(cln_key(m, fi, faults, tk, "id", "fl", ClnFacts{fe: {fi: b"fe entry 2"}, pre: facts.pre, may: facts.may, known: facts.known}) == k) == false
  // a callee's bit before prune_unwind, its cancel bit and its constant
  expect(cln_key(m, fi, faults, tk, "id", "fl", ClnFacts{fe: facts.fe, pre: [false, true, true], may: facts.may, known: facts.known}) == k) == false
  expect(cln_key(m, fi, faults, tk, "id", "fl", ClnFacts{fe: facts.fe, pre: facts.pre, may: [false, true, false], known: facts.known}) == k) == false
  expect(cln_key(m, fi, faults, tk, "id", "fl", ClnFacts{fe: facts.fe, pre: facts.pre, may: facts.may, known: ["", "", "i1"]}) == k) == false
}

test "cln keys on tasks are one task's" {
  var m = calls_module(false)
  for k in 0..200 {
    let _x = m.new_func("x${k}", [], [])
  }
  let faults = m.may_fault()
  let tk = type_keys(m)
  expect(cln_keys(m, faults, tk, "id", "fl", ClnFacts{}, 4)) == cln_keys(m, faults, tk, "id", "fl", ClnFacts{}, 1)
}

test "a cln entry reads back as its function, and not where a type is missing" {
  let m = calls_module(false)
  let f = cleaned(m.funcs[m.func_index("f")])
  let e = cln_entry(m, f) ?? b""
  expect(e.is_empty()) == false
  let back = cln_of_entry(m, e) ?? Func{name: "none"}
  expect(back.name) == "f"
  var x = m
  x.funcs[x.func_index("f")] = back
  var y = m
  y.funcs[y.func_index("f")] = f
  expect(x.text()) == y.text()
  // a module without Int
  var bare = Module{}
  let _f = bare.new_func("f", [], [])
  expect((cln_of_entry(bare, e) ?? Func{name: "none"}).name) == "none"
}

fn body_key(m: Module, fi: Int) -> Str {
  var b = BytesBuilder.new()
  let _id = key_body(b, m, fi, m.funcs[fi], type_keys(m))
  crypto.sha256(b.freeze()).to_hex()
}

test "a function with a body id is keyed by it, one without by its body" {
  var m = calls_module(false)
  let fi = m.func_index("f")
  let full = body_key(m, fi)
  m.body_ids = ["cln k1", "", ""]
  let k = body_key(m, fi)
  expect(k == full) == false
  // the body is not read: the id stands for it
  var f = m.funcs[fi]
  let _c = f.add(0, Op.Const, -1, Aux.I(n: 7), [])
  m.funcs[fi] = f
  expect(body_key(m, fi)) == k
  m.body_ids = ["cln k2", "", ""]
  expect(body_key(m, fi) == k) == false
  // no id (specialize_args cleared it, or past the end): the body
  m.body_ids = ["", "", ""]
  let changed = body_key(m, fi)
  expect(changed == full) == false
  m.body_ids = []
  expect(body_key(m, fi)) == changed
}

test "a stored cln entry carries its body's full key" {
  let d = cln_seal(b"entry bytes", "${"ab".repeat(32)}")
  expect(cln_body(d)) == b"entry bytes"
  expect(cln_full_of(d)) == "ab".repeat(32)
  expect(cln_body(b"short")) == b""
}
