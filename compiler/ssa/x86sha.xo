// SHA-256 on x86-64 with SHA-NI (decision 0254): the instruction
// sequence both native x86-64 lowerings use (compiler/arm64 calls.xo,
// compiler/llvm call.xo).

/// The x86-64 SHA-NI compression of one SHA-256 block (decision 0254;
/// the owner's approval, 2026-10-17): the Linux kernel's sha256_ni form,
/// in xmm0 (sha256rnds2's implicit W + K), xmm1 and xmm2 (ABEF and CDGH),
/// xmm3 to xmm6 (the message), xmm7, xmm8 (the byte swap mask, built in
/// r11), xmm9 and xmm10 (the state before); the state is eight 8 byte
/// words of 32 bit values at st, the block 64 bytes at p, the constants
/// 64 packed 32 bit words at k. Generated (2026-10-17); the Xo backend
/// saves those xmm registers around it, LLVM lists them as clobbered.
pub fn sha256_ni_lines(st: Str, p: Str, k: Str) -> List[Str] {
  [
    "movd 0(${st}), %xmm1",
    "pinsrd $1, 8(${st}), %xmm1",
    "pinsrd $2, 16(${st}), %xmm1",
    "pinsrd $3, 24(${st}), %xmm1",
    "movd 32(${st}), %xmm2",
    "pinsrd $1, 40(${st}), %xmm2",
    "pinsrd $2, 48(${st}), %xmm2",
    "pinsrd $3, 56(${st}), %xmm2",
    "movdqa %xmm1, %xmm7",
    "punpcklqdq %xmm2, %xmm1",
    "punpckhqdq %xmm7, %xmm2",
    "pshufd $27, %xmm1, %xmm1",
    "pshufd $177, %xmm2, %xmm2",
    "movdqa %xmm1, %xmm9",
    "movdqa %xmm2, %xmm10",
    "movabsq $289644378169868803, %r11",
    "movq %r11, %xmm8",
    "movabsq $868365760874482187, %r11",
    "movq %r11, %xmm0",
    "punpcklqdq %xmm0, %xmm8",
    "movdqu 0(${p}), %xmm3",
    "pshufb %xmm8, %xmm3",
    "movdqu 0(${k}), %xmm0",
    "paddd %xmm3, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "movdqu 16(${p}), %xmm4",
    "pshufb %xmm8, %xmm4",
    "movdqu 16(${k}), %xmm0",
    "paddd %xmm4, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm4, %xmm3",
    "movdqu 32(${p}), %xmm5",
    "pshufb %xmm8, %xmm5",
    "movdqu 32(${k}), %xmm0",
    "paddd %xmm5, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm5, %xmm4",
    "movdqu 48(${p}), %xmm6",
    "pshufb %xmm8, %xmm6",
    "movdqu 48(${k}), %xmm0",
    "paddd %xmm6, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm6, %xmm7",
    "palignr $4, %xmm5, %xmm7",
    "paddd %xmm7, %xmm3",
    "sha256msg2 %xmm6, %xmm3",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm6, %xmm5",
    "movdqu 64(${k}), %xmm0",
    "paddd %xmm3, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm3, %xmm7",
    "palignr $4, %xmm6, %xmm7",
    "paddd %xmm7, %xmm4",
    "sha256msg2 %xmm3, %xmm4",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm3, %xmm6",
    "movdqu 80(${k}), %xmm0",
    "paddd %xmm4, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm4, %xmm7",
    "palignr $4, %xmm3, %xmm7",
    "paddd %xmm7, %xmm5",
    "sha256msg2 %xmm4, %xmm5",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm4, %xmm3",
    "movdqu 96(${k}), %xmm0",
    "paddd %xmm5, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm5, %xmm7",
    "palignr $4, %xmm4, %xmm7",
    "paddd %xmm7, %xmm6",
    "sha256msg2 %xmm5, %xmm6",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm5, %xmm4",
    "movdqu 112(${k}), %xmm0",
    "paddd %xmm6, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm6, %xmm7",
    "palignr $4, %xmm5, %xmm7",
    "paddd %xmm7, %xmm3",
    "sha256msg2 %xmm6, %xmm3",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm6, %xmm5",
    "movdqu 128(${k}), %xmm0",
    "paddd %xmm3, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm3, %xmm7",
    "palignr $4, %xmm6, %xmm7",
    "paddd %xmm7, %xmm4",
    "sha256msg2 %xmm3, %xmm4",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm3, %xmm6",
    "movdqu 144(${k}), %xmm0",
    "paddd %xmm4, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm4, %xmm7",
    "palignr $4, %xmm3, %xmm7",
    "paddd %xmm7, %xmm5",
    "sha256msg2 %xmm4, %xmm5",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm4, %xmm3",
    "movdqu 160(${k}), %xmm0",
    "paddd %xmm5, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm5, %xmm7",
    "palignr $4, %xmm4, %xmm7",
    "paddd %xmm7, %xmm6",
    "sha256msg2 %xmm5, %xmm6",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm5, %xmm4",
    "movdqu 176(${k}), %xmm0",
    "paddd %xmm6, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm6, %xmm7",
    "palignr $4, %xmm5, %xmm7",
    "paddd %xmm7, %xmm3",
    "sha256msg2 %xmm6, %xmm3",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm6, %xmm5",
    "movdqu 192(${k}), %xmm0",
    "paddd %xmm3, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm3, %xmm7",
    "palignr $4, %xmm6, %xmm7",
    "paddd %xmm7, %xmm4",
    "sha256msg2 %xmm3, %xmm4",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "sha256msg1 %xmm3, %xmm6",
    "movdqu 208(${k}), %xmm0",
    "paddd %xmm4, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm4, %xmm7",
    "palignr $4, %xmm3, %xmm7",
    "paddd %xmm7, %xmm5",
    "sha256msg2 %xmm4, %xmm5",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "movdqu 224(${k}), %xmm0",
    "paddd %xmm5, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "movdqa %xmm5, %xmm7",
    "palignr $4, %xmm4, %xmm7",
    "paddd %xmm7, %xmm6",
    "sha256msg2 %xmm5, %xmm6",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "movdqu 240(${k}), %xmm0",
    "paddd %xmm6, %xmm0",
    "sha256rnds2 %xmm0, %xmm1, %xmm2",
    "punpckhqdq %xmm0, %xmm0",
    "sha256rnds2 %xmm0, %xmm2, %xmm1",
    "paddd %xmm9, %xmm1",
    "paddd %xmm10, %xmm2",
    "movdqa %xmm1, %xmm7",
    "punpcklqdq %xmm2, %xmm1",
    "punpckhqdq %xmm7, %xmm2",
    "pshufd $177, %xmm1, %xmm1",
    "pshufd $27, %xmm2, %xmm2",
    "pextrd $0, %xmm2, %r11d",
    "movq %r11, 0(${st})",
    "pextrd $1, %xmm2, %r11d",
    "movq %r11, 8(${st})",
    "pextrd $2, %xmm2, %r11d",
    "movq %r11, 16(${st})",
    "pextrd $3, %xmm2, %r11d",
    "movq %r11, 24(${st})",
    "pextrd $0, %xmm1, %r11d",
    "movq %r11, 32(${st})",
    "pextrd $1, %xmm1, %r11d",
    "movq %r11, 40(${st})",
    "pextrd $2, %xmm1, %r11d",
    "movq %r11, 48(${st})",
    "pextrd $3, %xmm1, %r11d",
    "movq %r11, 56(${st})",
  ]
}
