// The SSA builder (internal/ssa build.go), stage 1 of decision 0150: it
// lowers the program checked by compiler/check (native mode) into the
// SSA internal/ssa's builder makes before its passes, function by
// function in the same order, so `xo ssadump --stage=build` and this
// builder print the same text for every function it completes. A
// construct outside the stages ported marks the function it is in as
// skipped (Func.skip) and the build goes on, as the Go builder goes on
// after an unsupported construct.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser

type Expr = parser.Expr
type Stmt = parser.Stmt
type Pattern = parser.Pattern
type Ident = parser.Ident
type Span = parser.Span

/// The name of the hidden trace field of Err (build_frames.go).
const TRACE_FIELD = "xo.tr"

/// A loop around the current code (build.go loopCtx).
struct LoopCtx {
  label: Bytes
  brk: Int
  cont: Int
  exits: Int
}

/// The state of one function body under construction (build.go fn).
struct S {
  f: Func
  /// The function's index in the module.
  fi: Int = -1
  /// The checker's function object (-1 for generated code), and the named
  /// function whose frame a `?` in a closure records.
  fo: Int = -1
  frame_fo: Int = -1
  /// How deep in closures this code is.
  closures: Int = 0
  cur: Int = 0
  /// The checker file of the code being lowered (expressions are keyed by
  /// file, span, and kind).
  file: Int = -1
  /// The packed source line of the statement being lowered (Value.line).
  line: Int = 0
  /// The code is of the program's own modules and polls the budget in a
  /// program that uses one (build_budget.go).
  polls: Bool = false
  /// Braun et al.: the definition of each variable per block, keyed by
  /// def_key; variables are checker locals or (negative) made up ones.
  defs: Map[Int, Int] = {}
  var_type: Map[Int, Int] = {}
  sealed: Map[Int, Bool] = {}
  incomplete: Map[Int, List[Int]] = {}
  param_var: Map[Int, Int] = {}
  /// The Func.dvars index of each checker local (decision 0252).
  dvar_of: Map[Int, Int] = {}
  loops: List[LoopCtx] = []
  /// The bindings of `var` parameters, returned updated.
  var_params: List[Int] = []
  /// The frames of deferred code (defer.xo), and the open blocks and
  /// scopes around the current code, innermost last (frame indexes; a
  /// scope's frame names it, DFrame.sc).
  frames: List[DFrame] = []
  exits: List[Int] = []
  /// The scopes of the function (conc.xo), and those open around the
  /// current code, innermost last (build.go fn.scopes: indexes into
  /// scope_tab).
  scope_tab: List[ScopeCtx] = []
  scopes: List[Int] = []
  /// A `defer` statement was registered or a scope opened in this
  /// function: only then can an operation need a landing of its own
  /// (lexical_cleanup).
  any_defer: Bool = false
  /// How deep in deferred code the current code is (shielded from
  /// cancellation: no checks).
  shield: Int = 0
  /// An operation that may fault inside a block with deferred code,
  /// waiting for its landing (flushLanding): the value, the blocks open
  /// when it was added, the definitions of its block it replaced since
  /// (-1: none), and the deferred statement it is in (zero or one).
  pending: Int = -1
  pending_at: List[Int] = []
  pending_scopes: List[Int] = []
  pending_defs: Map[Int, Int] = {}
  pending_defer: List[DLand] = []
  /// The top level deferred statement being lowered (zero or one), and
  /// the fault continuations made so far.
  defer_land: List[DLand] = []
  conts: List[Int] = []
  /// The shared unwind blocks of ordinary code, by unwind_key.
  unwinds: Map[Str, Int] = {}
  /// The values of the `old(...)` calls of the ensures clauses being
  /// checked, by the key of the call.
  olds: Map[Int, Int] = {}
  /// fault_detail's text so far and the names it showed.
  detail_acc: Int = -1
  detail_seen: List[Str] = []
  /// The bounds of loops, by their counter variable.
  bounds: Map[Int, LoopBound] = {}
  /// The code is outside the runtime (budget.xo runtime_mod): its loops
  /// poll for preemption (decision 0286 step 3).
  ppolls: Bool = false
  /// The function's unwind block (lazy), -1 until needed.
  unwind_b: Int = -1
  /// The success type and the error type (-1: cannot fail), checker types.
  res: Int = -1
  err_t: Int = -1
  /// The type arguments of the instance being built.
  sub: Map[Int, Int] = {}
  /// The function returns its result and its `var` parameter as one tuple
  /// (a closure given to Map.update, closureWith), and the value it was
  /// given (-1 for none): what it hands back when it fails or unwinds.
  pack_var: Bool = false
  pack_orig: Int = -1
}

/// A generated function whose body is still to build (run_gens).
enum Gen {
  Debug(ct: Int, t: Int)
  Slice(lt: Int)
  Concat(t: Int)
  FrameArgs(names: List[Str], cts: List[Int], cap_ts: List[Int], elided: Bool)
  Zero(t: Int)
  /// xo.testfs[memfs]: the real Fs of a `--real` test (realFsWrapper).
  TestFs(memfs: Int, real: Int)
}

struct GenJob {
  fi: Int
  file: Int
  gen: Gen
}

/// A body waiting to be built (the Go builder's queue of closures).
enum Job {
  Body(fo: Int, fi: Int, sub: Map[Int, Int])
  /// The body of a function wrapped for its contracts (`<name>.body`).
  Inner(fo: Int, fi: Int, sub: Map[Int, Int])
  /// The function of a test block (testBody).
  Test(fi: Int, file: Int, td: parser.TestDecl)
  Closure(fi: Int, lit: parser.FnLit, file: Int, result: Int, err_t: Int, owner: Int, closures: Int, sub: Map[Int, Int], caps: List[Int], cap_ts: List[Int], pack: Bool, polls: Bool)
  /// A closure a front end cache entry made (fe_replay): its body from
  /// its entry d, the owner's entry's key for a failure.
  ClosureReplay(fi: Int, d: Bytes, key: Str)
}

/// A check after an operation (build_conc.go unwindCheck): the function,
/// the check's call u, the callee whose unwinding it checks ("" for any),
/// and the operation (-1 for none). pruneUnwind removes the ones nothing
/// can take.
struct UCheck {
  fi: Int
  u: Int
  callee: Str
  w: Int
}

/// The builder (build.go builder).
pub struct Builder {
  pub c: check.Checker
  pub m: Module = Module{}
  /// The directory fault positions are relative to.
  line_root: Str = ""
  s: S = S{f: Func{name: ""}}
  queue: List[Job] = []
  gens: List[GenJob] = []
  /// Functions by instance key, and named functions used as values.
  funcs: Map[Str, Int] = {}
  /// The instances of functions that are not generic, by function object
  /// (the fast path of declare).
  plain: Map[Int, Int] = {}
  thunks: Map[Str, Int] = {}
  /// A thunk's function object, by the thunk (a recorded body's event 7).
  thunk_of: Map[Int, Int] = {}
  nclos: Int = 0
  /// The names of types two loaded user modules both declare.
  ambiguous: Map[Str, Bool] = {}
  /// The modules whose functions and constants are named by their path,
  /// not their default name, since another module of the program has
  /// that name (mod_prefix).
  path_named: Set[Int] = #{}
  /// Implementation modules by the std path they implement.
  natives: Map[Str, Int] = {}
  /// The module holding main.
  main_mod: Int = -1
  main_named: Int = -1
  /// The program uses a concurrency construct: the Go builder builds it
  /// again with unwinding checks (conc), as build_program does; the
  /// constructs themselves are outside stage 1.
  pub need_conc: Bool = false
  /// a std object's body was asked for with its tree still pending in
  /// the checker's record (trees_lazy, decision 0388 stage 2): the
  /// build is made again with every tree joined (build_program_fe)
  pub trees_missing: Bool = false
  /// the functions whose own body needs concurrency (set_flag 1, a front
  /// end cache entry's flag), for std's facts (StdFact.conc)
  pub conc_names: Map[Str, Bool] = {}
  /// A test binary (Options.Tests, testmode.xo).
  pub tests: Bool = false
  pub conc: Bool = false
  /// prune_unwind's view of each function before it ran: may_fault, and
  /// with conc whether a call of it can be canceled (cln_key hashes a
  /// callee's)
  pub unwind_faults: List[Bool] = []
  pub unwind_may: List[Bool] = []
  /// a std-facts build (decision 0388): prune_unwind also keeps each
  /// function's (faults, may be canceled) by name, which later passes'
  /// renumbering leaves valid (std_facts)
  pub keep_unwind_names: Bool = false
  /// decision 0388 stage 3: std's facts by name (Checker.sepcomp_facts,
  /// decoded at the first job), the std functions to make externs
  sep: Map[Str, StdFact] = {}
  sep_read: Bool = false
  pub unwind_names: Map[Str, (Bool, Bool)] = {}
  /// with keep_unwind_names, fold_known_calls's constant results by name
  /// (a decoded cache hit is no longer Func.target: std_facts)
  pub known_names: Map[Str, Aux] = {}
  /// the constants fold_known_calls folded calls of these functions to
  pub fold_known: Map[Int, Aux] = {}
  /// The program is lowered for the wasm backend (decision 0207): rt.layout
  /// folds to the wasm runtime's layout, and no C ABI export is built (no
  /// C calls them).
  pub wasm: Bool = false
  /// The program links with no C library (XO_NOLIBC=1, decision 0206
  /// stage 2): native/llrt/cabi_nolibc's exports are built, and only then.
  pub nolibc: Bool = false
  /// The paths of the modules of the functions declared (declMods).
  decl_mods: Map[Str, Bool] = {}
  /// The program calls task.with_budget: the code of its own modules
  /// polls the budget (build_budget.go).
  budgets: Bool = false
  /// The walk of uses_os_tasks looks for task.with_budget calls instead
  /// (uses_budgets).
  scan_budget: Bool = false
  /// The program dials or listens (Net.dial, Net.listen): the C runtime's
  /// network runs, so native/llrt/cabi_net's exports are built (decision
  /// 0206 stage 3, usesNet).
  uses_net: Bool = false
  /// Why the run cannot be built here (no main, concurrency), or "".
  pub why: Str = ""
  /// Every construct recorded as unsupported (build.go errs): the no GC
  /// check's XO1201 diagnostics (nogc.xo), each at the expression being
  /// lowered when it was recorded.
  pub errs: List[BuildErr] = []
  seen_err: Map[Str, Bool] = {}
  /// The expression being lowered and its file (-1: none), for errs.
  at: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  at_file: Int = -1
  /// While declaring a function: what was unsupported in its signature.
  declaring: Bool = false
  pend_skip: Str = ""
  /// Made up variables (negative ids).
  nvar: Int = 0
  /// The constants of heap types built so far (build_int.go constValue),
  /// by the name of the function that builds each, and those names by
  /// number (a recorded body's event 6).
  consts: Map[Str, Int] = {}
  const_names: List[Str] = []
  /// The interface types lowered as xo.iface[I], by SSA type: their
  /// checker type (build_iface.go ifaces).
  ifaces: Map[Int, Int] = {}
  /// The numbers of the concrete types held by interface values (tids).
  tids: Map[Str, Int] = {}
  /// Method values made so far (each a literal at offsets of its own).
  nsyn: Int = 0
  /// The spawns whose task can fail, numbered by the key of their call
  /// (build_conc.go sites), and the bindings spawn calls are stored in
  /// (boundTo), by the key of the call.
  sites: Map[Int, Int] = {}
  bound_to: Map[Int, Int] = {}
  /// Expressions already lowered, by span (pin_key), whose value expr
  /// returns again: a capability call's receiver, evaluated once before
  /// user_cap_call branches (decision 0307).
  pinned: Map[Str, Int] = {}
  /// Some construct was skipped so far: the Go builder lowered code there
  /// that this builder did not, which may have numbered interface types
  /// (tids) and queued bodies, so type numbers given from then on may
  /// differ from the Go builder's (late_tids).
  skipped_any: Bool = false
  late_tids: Map[Int, Bool] = {}
  /// The checks made, in order (b.checks).
  checks: List[UCheck] = []
  /// A release build (`--release`): debug contract clauses are left out.
  pub release: Bool = false
  /// The runtime's profiler is built (decision 0238's gating): false for
  /// `--release` without `--profile-support`, where a call of
  /// native/llrt/prof.supported is false (target_test), so the profiler
  /// is neither built nor linked.
  pub prof: Bool = true
  /// `--trace-support`: a release build keeps the execution trace's
  /// recorder (decision 0240; the owner's rule, decision 0238's
  /// addendum): tracerec.built() is true unless release and not this.
  pub trace_support: Bool = false
  /// XO_HEAP_GUARD=1 at build time: a call of native/llrt/guard.on is
  /// true (target_test), so the runtime's records get a guard page after
  /// them (llrt libcmem.xo heap_large), and an rt.slot_* on a List checks
  /// its index against the length (json.xo slot_bounds).
  pub heap_guard: Bool = false
  /// `xo test --real` (core 9.2, decision 0120): the tests that declare
  /// `uses` are built, with the real Fs (Options.RealTests).
  pub real_tests: Bool = false
  /// The build's target for the predeclared `target` (Options.GOOS and
  /// GOARCH): "" for the builder's own (the host, as `xo ssadump`).
  pub goos: Str = ""
  pub goarch: Str = ""
  /// The amd64 backend's builds (decision 0254): since stage 3 every
  /// intrinsic of std/native/llrt/cpu.xo is lowered, so this no longer
  /// changes which (kept for the builder's callers).
  pub soft_cpu: Bool = false
  /// Reference counting emits no retain or release of a statically
  /// immortal leaf (rc.xo immortal_leaf); off for the LLVM backend, whose
  /// own inliner grew the TLS client 2% with it at no gain in run time
  /// (bench/results/amd64-vs-llvm-2026-10-17.md).
  pub imm_rc: Bool = true
  /// The attribution of the std/log call call_as lowers next (logFrom).
  pend_log_from: Str = ""
  /// The front end cache's misses by reason (XO_FE_STATS=1 prints them).
  pub fe_stats: Map[Str, Int] = {}
  /// A recorded body declared a generic instance.
  fe_gen: Bool = false
  /// The front end cache (fecache.xo), and the recording of a body: the
  /// functions it declared.
  pub fe: FeCache = FeCache{}
  /// The modules (checker indexes) the module check cache skipped of
  /// which a body was built from source (check_lazy): the driver checks
  /// them in full and builds again (XO_CHK_CACHE=auto)
  pub skip_src: Map[Int, Bool] = {}
  /// The check errors of the native module bodies checked as they were
  /// built (check_lazy), reported as themselves, not as XO1201 (2026-10-20
  /// poll: an XO0605 in std/native read as "not available without a
  /// garbage collector"), once each
  pub lazy_diags: List[check.Diag] = []
  lazy_seen: Map[Str, Bool] = {}
  /// The modules of which a closure's body was built with no front end
  /// cache entry: ModEntry.fe_complete is false for them
  pub nofe_mods: Map[Int, Bool] = {}
  /// The function objects whose bodies were built with no front end
  /// cache entry made or replayed (a skip reason, a generic instance, a
  /// contract's inner body), by module: ModEntry.eager, checked even
  /// when the module is skipped
  pub nofe_fos: Map[Int, Map[Int, Bool]] = {}
  /// Per program module: uses_os_tasks and uses_budgets of it, for the
  /// module check cache.
  pub mod_scans: Map[Int, (Bool, Bool)] = {}
  fe_rec: Bool = false
  /// A recording's top level declares (the function objects, in order of
  /// Module.fe_ev, as event 4), its generic instances found (the key and
  /// the name the body calls it by), and the first table it read that a
  /// commit cannot replay (a skip reason, "" for none).
  fe_greads: List[(Str, Str)] = []
  fe_touched: Str = ""
  /// The spawn sites numbered before the recorded body (its own are
  /// event 8).
  fe_site0: Int = 0
  /// the one-way flags a recorded body set (set_flag): 1 need_conc, 2
  /// uses_net; a builder that had them already would otherwise hide it
  fe_flagbits: Int = 0
}

/// logFrom: the attribution of the record the std/log function fo writes
/// from the code being lowered (decision 0173): "<module path>@<version>"
/// in a dependency's source, else "".
fn (var b: Builder) log_from(fo: Int) -> Str {
  let o = b.c.objs[fo]
  if o.recv >= 0 || o.module < 0 || b.c.mods[o.module].path != "std/log" || b.s.file < 0 {
    return ""
  }
  if !(b.obj_name(fo) is "debug" | "info" | "warn" | "error" | "with") {
    return ""
  }
  let m = b.c.files[b.s.file].module
  if m < 0 || b.c.mods[m].is_std {
    return ""
  }
  b.c.mods[m].dependency
}

/// Builds the program c checked (BuildOpts): once, and when it uses a
/// concurrency construct again with unwinding checks.
pub fn build_program(c: check.Checker, line_root: Str, tests: Bool) -> Builder uses fs.read {
  build_program_release(c, line_root, tests, false)
}

/// build_program for a release build when release is set (Options.Release,
/// `xo build --release`): the contract clauses marked debug are compiled
/// out (contractOn).
pub fn build_program_release(c: check.Checker, line_root: Str, tests: Bool, release: Bool) -> Builder uses fs.read {
  build_program_opts(c, line_root, tests, release, false)
}

/// build_program_release with the tests that declare `uses` built when
/// real_tests is set (Options.RealTests, `xo test --real`).
pub fn build_program_opts(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool) -> Builder uses fs.read {
  build_program_target(c, line_root, tests, release, real_tests, "", "")
}

/// build_program_opts for the target goos/goarch, the value of the
/// predeclared `target` ("" for the builder's own; internal/build passes
/// each target's, so a cross build's `match target.os` keeps the
/// target's arm, not the compiler's).
pub fn build_program_target(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str) -> Builder uses fs.read {
  build_program_for(c, line_root, tests, release, real_tests, goos, goarch, false)
}

/// build_program_target for the wasm backend when wasm is set (decision
/// 0207: the wasm runtime's layout, no C ABI exports).
pub fn build_program_for(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool) -> Builder uses fs.read {
  build_program_libc(c, line_root, tests, release, real_tests, goos, goarch, wasm, false)
}

/// build_program_for, for a program linked with no C library when nolibc
/// is set (XO_NOLIBC=1, decision 0206 stage 2): the exports of
/// native/llrt/cabi_nolibc, which std/llrt/xo_nolibc.c calls, are built.
pub fn build_program_libc(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool) -> Builder uses fs.read {
  build_program_prof(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, true)
}

/// build_program_libc with the runtime's profiler left out when prof is
/// false (`xo build --release` without `--profile-support`, decision
/// 0238's gating).
pub fn build_program_prof(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool) -> Builder uses fs.read {
  build_program_support(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, prof, false)
}

/// build_program_prof, with a release build keeping the execution
/// trace's recorder when trace_support (`--trace-support`, decision 0240).
pub fn build_program_support(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace_support: Bool) -> Builder uses fs.read {
  build_program_cpu(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, prof, trace_support, false)
}

/// build_program_support with soft_cpu (Builder.soft_cpu).
pub fn build_program_cpu(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace_support: Bool, soft_cpu: Bool) -> Builder uses fs.read {
  build_program_guard(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, prof, trace_support, soft_cpu, false)
}

/// build_program_cpu with heap_guard (Builder.heap_guard).
pub fn build_program_guard(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace_support: Bool, soft_cpu: Bool, heap_guard: Bool) -> Builder uses fs.read {
  build_program_fe(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, prof, trace_support, soft_cpu, heap_guard, FeCache{})
}

/// build_program_guard through the front end cache fe (fecache.xo).
pub fn build_program_fe(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace_support: Bool, soft_cpu: Bool, heap_guard: Bool, fe: FeCache) -> Builder uses fs.read {
  var b = program_builder(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, prof, trace_support, soft_cpu, heap_guard, fe, if fe.conc_fixed >= 0 { fe.conc_fixed == 1 } else { fe.start_conc })
  b.build()
  if b.need_conc != b.conc && fe.conc_fixed < 0 {
    // built again with unwinding checks (a body needs concurrency), or
    // without them when fe.start_conc guessed wrong: the first build is
    // dropped, its stores and counts with it
    b = program_builder(c, line_root, tests, release, real_tests, goos, goarch, wasm, nolibc, prof, trace_support, soft_cpu, heap_guard, fe, b.need_conc)
    b.build()
  }
  b.m.goarch = goarch
  b.m.heap_guard = heap_guard
  b
}

/// contractOn: whether a contract clause marked debug (or not) is
/// checked: always, except debug clauses of a release build.
fn (b: Builder) contract_on(debug: Bool) -> Bool {
  !debug || b.debug_contracts_on()
}

/// A setting's value (decision 0354): as given (0 or 1), else the preset.
fn setting_on(v: Int, preset: Bool) -> Bool { if v < 0 { preset } else { v == 1 } }

/// The `(debug)` contract clauses checked: in a debug build, unless
/// --debug-contracts says.
pub fn (b: Builder) debug_contracts_on() -> Bool { setting_on(b.c.set_debug_contracts, !b.release) }

/// `dbg(x)` prints: in a debug build, unless --dbg says.
pub fn (b: Builder) dbg_on() -> Bool { setting_on(b.c.set_dbg, !b.release) }

/// Parameter values in error frames: in every build, unless
/// --error-args=off.
pub fn (b: Builder) error_args_on() -> Bool { setting_on(b.c.set_error_args, true) }

/// The execution trace's recorder: in a debug build, and in a release
/// one with --trace-support (decision 0240), unless --trace-support says.
pub fn (b: Builder) trace_on() -> Bool { setting_on(b.c.set_trace, !b.release || b.trace_support) }

/// A builder for build_program_fe, with or without unwinding checks.
fn program_builder(c: check.Checker, line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace_support: Bool, soft_cpu: Bool, heap_guard: Bool, fe: FeCache, conc: Bool) -> Builder {
  var b = new_builder(c, line_root)
  b.fe = fe
  b.heap_guard = heap_guard
  b.m.map_log = c.map_log
  b.m.map_core = c.map_core
  // branching is unmeasured and untested on wasm (decision 0291
  // branching addendum)
  b.m.map_branch = c.map_log && c.map_branch && !wasm
  b.m.no_preempt = c.no_preempt || c.det
  b.m.det = c.det
  b.soft_cpu = soft_cpu
  b.prof = prof
  b.trace_support = trace_support
  b.m.pack_lists = c.pack_lists
  b.m.inline_str = c.inline_str
  b.nolibc = nolibc
  b.tests = tests
  b.release = release
  b.real_tests = real_tests
  b.goos = goos
  b.goarch = goarch
  b.m.async_preempt = c.async_preempt_ok && !c.no_preempt && !c.det && ((goarch is "arm64" | "amd64") && (goos is "darwin" | "linux") || (goarch == "amd64" && goos == "windows" && !c.async_preempt_llvm)) && !wasm
  b.m.std_store = c.std_roots && (goos is "darwin" | "windows" | "linux")
  b.wasm = wasm
  b.conc = conc
  b
}

/// A builder for the program c checked.
pub fn new_builder(c: check.Checker, line_root: Str) -> Builder {
  var b = Builder{c: c, line_root: line_root}
  b.ambiguous = b.ambiguous_type_names()
  b.path_named = b.path_named_mods()
  b
}

/// Builds the program: main and every function reachable from it, in the
/// Go builder's order (buildModule, before the passes).
pub fn (var b: Builder) build() uses fs.read {
  b.budgets = b.uses_budgets()
  if b.tests {
    // a test binary (testmode.xo): its main runs one test
    b.build_tests()
    b.run_queue()
    // after the program's own code: a feature's exports are built only
    // when code of a module importing them is
    b.declare_exports()
    b.run_queue()
    return
  }
  var main_fo = -1
  for m in b.c.root_mods {
    if let Some(o) = b.c.mods[m].members.get(b"main") {
      if b.c.objs[o].kind == check.ObjKind.Func && b.c.objs[o].recv < 0 {
        main_fo = o
        b.main_mod = m
        break
      }
    }
  }
  if main_fo < 0 {
    b.why = "no `main` function in the root module"
    return
  }
  let mf = b.declare(main_fo, [])
  if b.uses_os_tasks() {
    b.set_flag(1)
    if !b.conc {
      // build_program_cpu builds the program again with unwinding
      // checks and drops this one: building its bodies first was wasted
      // (the SSA builder's time twice for a program with tasks)
      return
    }
    b.tasks_main(mf, b.fail_err(b.c.objs[main_fo].err))
  } else {
    let et = b.fail_err(b.c.objs[main_fo].err)
    if et >= 0 {
      b.main_wrapper(mf, et)
    }
  }
  b.run_queue()
  // the dump's and std's roots first, so the C ABI exports of the modules
  // they build are declared too (a feature's exports are declared once its
  // importer is built)
  b.declare_dump_roots()
  b.run_queue()
  b.declare_exports()
  b.run_queue()
}

/// Declares the non generic functions the checker's dump_roots name
/// (`xo dev dump ssa --fn=NAME`: `Type.method`, `name`, or either with
/// its module's name before) as roots of the build.
fn (var b: Builder) declare_dump_roots() {
  if b.c.dump_roots.is_empty() && !b.c.std_roots {
    return
  }
  for o in 0..b.c.objs.len() {
    let ob = b.c.objs[o]
    if ob.kind != check.ObjKind.Func || !ob.tparams.is_empty() || ob.module < 0 {
      continue
    }
    if ob.recv >= 0 && !b.c.objs[ob.recv].tparams.is_empty() {
      continue
    }
    // the std modules and their implementations; the runtime's modules
    // (native/llrt) only as their callers reach them, since some exist for
    // one build mode (the test world's, --race's) and their C exports are
    // declared only in it
    let mpath = b.c.mods[ob.module].path
    if b.c.std_roots && b.c.mods[ob.module].std_tree && !mpath.starts_with("native/llrt/") && (b.tests || !(mpath is "std/testing" | "native/testing" | "native/rttest")) && (b.tests || !txt(ob.name).starts_with("llrt_tw_")) {
      // a declaration whose body is elsewhere (a std API function the
      // native implementation provides) has no bound parameters: the
      // implementation's function is the root instead
      let bound = (ob.params.is_empty() || b.c.param_vars.contains(o)) && (ob.recv < 0 || b.c.recv_var.contains(o))
      let has_body = !ob.fn_decl.is_empty() && (ob.fn_decl[0].body != None || ob.fn_decl[0].lazy != None)
      if bound && has_body {
        let _s = b.declare(o, [])
      }
      continue
    }
    let dn = b.c.display_name(o)
    let full = "${b.c.mods[ob.module].name}.${dn}"
    for n in b.c.dump_roots {
      if n == dn || n == full {
        let _f = b.declare(o, [])
        break
      }
    }
  }
}

/// Declares every function of the marker modules of C ABI exports the
/// program loaded (native/llrt/cabi and native/llrt/cabi_<feature>), in
/// the order of their paths and then of their names, as roots of the
/// build: the C runtime calls them as xo_x_<name> (decision 0207,
/// declareExports). Not for the wasm backend, which links no C.
fn (var b: Builder) declare_exports() {
  if b.wasm {
    return
  }
  var paths: List[Str] = []
  var by_path: Map[Str, Int] = {}
  for (i, m) in b.c.mods.indexed() {
    if m.path == "native/llrt/cabi" || m.path.starts_with("native/llrt/cabi_") {
      paths.push(m.path)
      by_path[m.path] = i
    }
  }
  for p in paths.sort() {
    let mi = by_path.get(p) ?? -1
    if p == "native/llrt/cabi_wincrt" {
      // a windows/amd64 program with no C runtime's (decision 0254 6b
      // step 4)
      if b.nolibc && b.goos == "windows" {
        b.declare_exports_of(mi, true)
      }
    } else if p == "native/llrt/cabi_nolibc" {
      // the C that calls them is compiled only into XO_NOLIBC builds
      if b.nolibc && b.goos != "windows" {
        b.declare_exports_of(mi, false)
      }
    } else if p == "native/llrt/cabi_libc" {
      // the C library of an XO_NOLIBC build, under the C names (malloc,
      // memcpy, read): the C runtime calls them; a libc build
      // links the system's
      if b.nolibc && b.goos != "windows" {
        b.declare_exports_of(mi, true)
      }
    } else if p == "native/llrt/cabi_c" {
      // the C names every native program defines (main, decision 0234),
      // in place of std/llrt's C
      b.declare_exports_of(mi, true)
    } else if p == "native/llrt/cabi_race" {
      // --race on windows (decision 0273's Windows addendum): the
      // functions the instrumented code calls (compiler/arm64 race.xo
      // race_sym) and ThreadSanitizer's callback
      if b.c.race && b.goos == "windows" {
        b.declare_exports_of(mi, false)
      }
    } else if p == "native/llrt/cabi_racefn" {
      // --race on every target: the functions' entry and exit
      // (compiler/arm64 race.xo race_func_hooks)
      if b.c.race {
        b.declare_exports_of(mi, false)
      }
    } else if p == "native/llrt/cabi_inl" {
      // --inline-str (decision 0370): its view of an inline Str
      if b.c.inline_str {
        b.declare_exports_of(mi, false)
      }
    } else if p == "native/llrt/cabi_tw" {
      // the test world's (std/native/llrt/testworld.xo, the zero-C
      // audit's B14): the C calls them only in a test binary, and other
      // programs link its weak definitions
      if b.tests {
        b.declare_exports_of(mi, false)
      }
    } else if p == "native/llrt/cabi" || b.importer_built(mi) {
      b.declare_exports_of(mi, false)
    }
  }
}

/// Whether the program builds code of a module that imports module mi
/// (importerBuilt): a feature's marker module, whose C runs only then.
fn (var b: Builder) importer_built(mi: Int) -> Bool {
  let path = b.c.mods[mi].path
  if path == "native/llrt/cabi_poll" || (b.uses_net && path == "native/llrt/cabi_net") {
    // the poller's exports, which every program may run, and the
    // network's: a program that dials or listens runs the C runtime's
    // network, which calls them (decision 0206 stage 3)
    return true
  }
  for m in b.c.mods {
    if !b.decl_mods.contains(m.path) {
      continue
    }
    // the native prelude imports cabi_net only so that os.net's runtime
    // calls resolve in a program without std/http (03fadf54e): it is
    // built in every program, so counting it built the network's
    // runtime into each (llvm-fib: 129 functions, about 11 ms of an
    // edit); uses_net above decides for os.net
    if m.path == "native/prelude" && path == "native/llrt/cabi_net" {
      continue
    }
    for f in m.files {
      for (_, imp) in b.c.files[f].imports.entries() {
        if imp.module == mi {
          return true
        }
      }
    }
  }
  false
}

/// declare_exports_of declares module mi's functions as C ABI exports:
/// xo_x_<name>, or the bare name (bare: the C library of an XO_NOLIBC
/// build, cabi_libc.xo, and main, cabi_c.xo).
fn (var b: Builder) declare_exports_of(mi: Int, bare: Bool) {
  var names: List[Str] = []
  for (n, o) in b.c.mods[mi].members {
    if b.c.objs[o].kind == check.ObjKind.Func && b.c.objs[o].recv < 0 {
      names.push(n.to_str() ?? "")
    }
  }
  for n in names.sort() {
    let o = b.c.mods[mi].members.get(n.bytes()) ?? -1
    if !b.type_params(o).is_empty() {
      b.unsupported("a generic C ABI export")
      continue
    }
    let fi = b.declare(o, [])
    b.m.funcs[fi].entry = true
    b.m.funcs[fi].export = if bare { n } else { "xo_x_${n}" }
    for p in b.m.funcs[fi].blocks[0].params {
      let t = b.m.funcs[fi].values[p].ty
      if !(b.tkind(t) is Kind.Int | Kind.Float) {
        b.unsupported("a C ABI export with a `${b.m.types[t].name}` parameter")
      }
    }
    let rs = b.m.funcs[fi].results
    if rs.len() != 1 || !b.m.funcs[fi].var_params.is_empty() {
      b.unsupported("a C ABI export with `var` parameters")
    } else if b.tkind(rs[0]) == Kind.Str {
      // a Str may be a view (decision 0330): its second word packs the
      // offset, which C would read as part of the length
      b.unsupported("a C ABI export with a `Str` result (a Str may be a view of a larger buffer, decision 0330)")
    } else if !(b.tkind(rs[0]) is Kind.Int | Kind.Float | Kind.Unit) {
      b.unsupported("a C ABI export with a `${b.m.types[rs[0]].name}` result")
    }
  }
}

/// Builds the queued bodies (and the generated functions they ask for).
fn (var b: Builder) run_queue() {
  b.run_gens()
  var i = 0
  while i < b.queue.len() {
    let j = b.queue[i]
    i += 1
    b.run_job(j)
    b.run_gens()
  }
  // built: a later run (the exports, declare_exports) starts empty
  b.queue = []
  if b.need_conc && !b.conc && b.fe.conc_fixed < 0 {
    b.why = "concurrency: built again with unwinding checks"
  }
}

fn (var b: Builder) run_job(j: Job) {
  // decision 0388 stage 3: a std function whose facts std's object
  // exports is an extern; its body is std's object's
  if !b.c.sepcomp_facts.is_empty() {
    if let Body(fo, fi, sub) = j {
      if sub.is_empty() && b.c.mods[b.obj_mod(fo)].std_tree {
        if !b.sep_read {
          b.sep_read = true
          // std's variant for this builder's concurrency (a program that
          // spawns is built again with it on, build_program_fe)
          let fb = if b.conc && !b.c.sepcomp_facts_conc.is_empty() { b.c.sepcomp_facts_conc } else { b.c.sepcomp_facts }
          for x in decode_std_facts(fb) ?? [] {
            b.sep[x.name] = x
          }
        }
        if let Some(x) = b.sep.get(b.m.funcs[fi].name) {
          b.m.mark_extern(fi, x)
          // a std function that needs concurrency: the program is built
          // with it (build_program_fe), as the whole program would be
          if x.conc {
            b.need_conc = true
          }
          return
        }
      }
    }
  }
  b.run_job_fe(j)
}

/// run_job0 through the front end cache for a body that is not generic.
fn (var b: Builder) run_job_fe(j: Job) {
  if !b.fe.on {
    b.run_job0(j)
    return
  }
  if let Body(fo, fi, sub) = j {
    // the declaration's line: the entry's lines are relative to it
    b.fe.cur_line = if b.c.objs[fo].fn_decl.is_empty() { 0 } else { b.c.objs[fo].fn_decl[0].span.start.line }
    // the entry of this builder's own flags (concurrency, budgets): a
    // body differs by them, and programs of either kind share the cache
    let k0 = b.fe.keys.get(fo) ?? ""
    let key = if k0.is_empty() { "" } else { fe_variant(k0, b.fe_own_flags()) }
    if sub.is_empty() && !key.is_empty() {
      let entry = b.fe.entries.get(key)
      if !b.fe.verify {
        if let Some(e) = entry {
          b.fe.cur_key = key
          if b.fe_replay(e, fi) {
            if b.fe.broken {
              // the module is half committed: the driver drops this build
              // and builds again without the entry (xo bcache.xo)
              b.fe.broken = false
              b.fe.bad.push("${key} (${b.m.funcs[fi].name}, recorded by xo ${b.fe.last_recorder})")
            }
            b.fe.hits += 1
            b.fe.body_entries[fi] = e
            return
          }
        }
      }
      b.fe.misses += 1
      // verify compares an entry a commit would take here, not one whose
      // checks fail now (another build's entry, kept until replaced)
      let applies = b.fe.verify && entry != None && b.fe_applies(entry ?? b"")
      // the runtime's lazy check before the recording (a hit skips it)
      b.check_lazy(fo)
      let r = b.fe_begin()
      b.run_job0(j)
      let eo = b.fe_entry(r, fi)
      if eo == None {
        b.nofe_fo(fo)
      }
      if let Some(e) = eo {
        match entry {
          Some(old) => {
            if applies && !b.fe_same_numbered(old, e) {
              b.fe.mismatches.push(b.m.funcs[fi].name)
            } else if applies {
              // the body a hit would have replayed: keyed as a hit's, so
              // verify checks the cleanup cache's chained keys too
              b.fe.body_entries[fi] = old
            }
          }
          None => {}
        }
        let clos = b.fe_made_closures()
        if !clos.is_empty() {
          // its closures' entries follow it once their jobs ran
          b.fe.pending.push((key, e, clos))
        } else if let Some(x) = b.fe_seal(e, []) {
          if entry == None || entry != Some(x) {
            b.fe.stores.push((key, x))
          }
          // the entry a later build replays: this body's (a cold build
          // keys its cleanup as the next build's hits do)
          if !b.fe.verify {
            b.fe.body_entries[fi] = x
          }
        }
      }
      return
    }
  }
  match j {
    Closure(cf, _, file, _, _, owner, _, _, _, _, _, _) => {
      // a closure's entry is pinned: its lines are not made relative
      b.fe.cur_line = 0
      // a closure's body: an entry of its own, sealed into its owner's
      // (fe_finalize); none leaves its owner without an entry, so the
      // owner's body is checked and built from source when the module's
      // check comes from the cache (nofe_fo, the entry's eager list), as a
      // body without an entry is. Only a closure with no named owner makes
      // its module's bodies incomplete: a module whose closures made a
      // generic instance (fe skip.gen, bench/perf/http's Mutex.with calls)
      // never skipped its check (cache chk 0/1, 2026-10-23)
      let r = b.fe_begin()
      b.run_job0(j)
      match b.fe_entry(r, cf) {
        Some(e) => b.fe.clos_rec[cf] = (e, b.fe_made_closures())
        None => {
          b.fe.no_clos[cf] = true
          if owner >= 0 {
            b.nofe_fo(owner)
          } else if file >= 0 {
            b.nofe_mods[b.c.files[file].module] = true
          }
        }
      }
      return
    }
    ClosureReplay(cf, d, key) => {
      // a closure its owner's entry made: its body from the entry; it
      // cannot be built here (its job's data is not kept), so a replay
      // that fails drops the build as a commit that fails does
      b.fe.cur_key = key
      // a closure's entry is pinned (its owner's is too, so it replays
      // only where it was recorded)
      b.fe.cur_line = 0
      if !b.fe_replay(d, cf) || b.fe.broken {
        b.fe.broken = false
        b.fe.bad.push("${key} (closure ${b.m.funcs[cf].name}, recorded by xo ${b.fe.last_recorder})")
        if b.why.is_empty() {
          b.why = "the front end cache's entry for the closure ${b.m.funcs[cf].name} does not replay (XO_FE_CACHE=off builds without it)"
        }
      }
      return
    }
    Body(..) | Inner(..) | Test(..) => {}
  }
  // built with no entry: a generic instance, a body with no key, a
  // contract's inner body, a test
  match j {
    Body(fo, _, _) => b.nofe_fo(fo)
    Inner(fo, _, _) => b.nofe_fo(fo)
    Test(..) | Closure(..) | ClosureReplay(..) => {}
  }
  b.run_job0(j)
}

/// Function object fo's body was built from source (nofe_fos).
fn (var b: Builder) nofe_fo(fo: Int) {
  let m = b.c.objs[fo].module
  if m < 0 {
    return
  }
  var s = b.nofe_fos.get(m) ?? {}
  s[fo] = true
  b.nofe_fos[m] = s
}

fn (var b: Builder) run_job0(j: Job) {
  match j {
    Body(fo, fi, sub) => b.body(fo, fi, sub)
    Inner(fo, fi, sub) => b.body_of(fo, fi, sub, false)
    Test(fi, file, td) => b.test_body(fi, file, td)
    Closure(fi, lit, file, result, err_t, owner, closures, sub, caps, cap_ts, pack, polls) => b.closure_body(fi, lit, file, result, err_t, owner, closures, sub, caps, cap_ts, pack, polls)
    ClosureReplay(..) => b.impossible("a closure's front end cache replay without the cache")
  }
}

// ---------------------------------------------------------------------------
// Positions and errors

fn (var b: Builder) file_name(f: Int) -> Str {
  rel_path_from(b.line_root, b.c.files[f].path)
}

/// `file:line:col` of a span in file f (build.go pos).
fn (var b: Builder) pos_in(f: Int, sp: Span) -> Str {
  "${b.file_name(f)}:${sp.start.line}:${sp.start.col}"
}

/// `file:line` (build.go posLine).
fn (var b: Builder) line_in(f: Int, sp: Span) -> Str {
  "${b.file_name(f)}:${sp.start.line}"
}

fn (var b: Builder) pos(sp: Span) -> Str {
  b.pos_in(b.s.file, sp)
}

fn (var b: Builder) pos_line(sp: Span) -> Str {
  b.line_in(b.s.file, sp)
}

/// Records a construct outside the stages ported: the function being
/// built (or declared) is not compared, and the no GC check reports it
/// (build.go unsupported).
fn (var b: Builder) unsupported(what: Str) {
  b.unsupported_kind(what, false)
}

/// Records a construct no native backend can support, such as a call into
/// a `use go` package (build.go impossible).
fn (var b: Builder) impossible(what: Str) {
  b.unsupported_kind(what, true)
}

fn (var b: Builder) unsupported_kind(what: Str, never: Bool) {
  b.record_err(what, never)
  b.skip_body(what)
}

/// Leaves the function being built unbuilt (what says why), recording no
/// XO1201: check_lazy's check errors are reported as they are.
fn (var b: Builder) skip_body(what: Str) {
  b.skipped_any = true
  if b.declaring {
    if b.pend_skip.is_empty() {
      b.pend_skip = what
    }
    return
  }
  if b.s.f.skip.is_empty() {
    b.s.f.skip = what
  }
}

// ---------------------------------------------------------------------------
// Checker queries (internal/check info.go)

fn (var b: Builder) tyk(t: Int) -> check.TyKind {
  b.c.tys[b.c.resolve(t)].kind
}

/// The Type object of a named type, or -1.
fn (var b: Builder) named_obj(t: Int) -> Int {
  if t < 0 {
    return -1
  }
  let r = b.c.resolve(t)
  if b.c.tys[r].kind == check.TyKind.Named {
    return b.c.tys[r].obj
  }
  -1
}

fn (var b: Builder) ty_args(t: Int) -> List[Int] {
  b.c.tys[b.c.resolve(t)].args
}

fn (var b: Builder) obj_name(o: Int) -> Str {
  check.text(b.c.objs[o].name)
}

fn (var b: Builder) obj_mod(o: Int) -> Int {
  b.c.objs[o].module
}

fn (var b: Builder) is_prelude_mod(m: Int) -> Bool {
  m >= 0 && b.c.mods[m].is_prelude
}

fn (var b: Builder) is_std_mod(m: Int) -> Bool {
  m >= 0 && b.c.mods[m].is_std
}

/// Whether checker type t is one of the prelude types names
/// (isPreludeNamed).
fn (var b: Builder) is_prelude_named(t: Int, names: List[Str]) -> Bool {
  let o = b.named_obj(t)
  if o < 0 || !b.is_prelude_mod(b.obj_mod(o)) {
    return false
  }
  names.contains(b.obj_name(o))
}

fn (var b: Builder) is_never(t: Int) -> Bool {
  t >= 0 && b.c.is_never(t)
}

/// The error type of a function that can fail, or -1 (failErr).
fn (var b: Builder) fail_err(e: Int) -> Int {
  if e < 0 || b.c.is_never(e) {
    return -1
  }
  e
}

/// T and E of Result[T, E] (resultParts), or (-1, -1).
fn (var b: Builder) result_parts(t: Int) -> (Int, Int) {
  let o = b.named_obj(t)
  if o >= 0 && b.is_prelude_mod(b.obj_mod(o)) && b.obj_name(o) == "Result" {
    let a = b.ty_args(t)
    if a.len() == 2 {
      return (a[0], a[1])
    }
  }
  (-1, -1)
}

/// T of Option[T] (optionElem), or -1.
fn (var b: Builder) option_elem(t: Int) -> Int {
  let o = b.named_obj(t)
  if o >= 0 && b.is_prelude_mod(b.obj_mod(o)) && b.obj_name(o) == "Option" {
    let a = b.ty_args(t)
    if a.len() == 1 {
      return a[0]
    }
  }
  -1
}

fn (var b: Builder) is_never_result(t: Int) -> Bool {
  let (_, et) = b.result_parts(t)
  et >= 0 && b.c.is_never(et)
}

/// The prelude type name applied to args (preludeType).
fn (var b: Builder) prelude_type(name: Str, args: List[Int]) -> Int {
  b.c.mk_named(b.c.prelude_obj(name), args)
}

/// What a function with success type res and error type err returns
/// (resultOf).
fn (var b: Builder) result_of(res: Int, err: Int) -> Int {
  if err < 0 {
    return res
  }
  var r = res
  if r < 0 {
    r = b.c.unit_ty
  }
  b.prelude_type("Result", [r, err])
}

/// The type parameters of fo that take types (typeParams).
fn (var b: Builder) type_params(fo: Int) -> List[Int] {
  var out: List[Int] = []
  for p in b.c.objs[fo].tparams {
    if !b.c.objs[p].effect {
      out.push(p)
    }
  }
  out
}

// ---------------------------------------------------------------------------
// Types (build.go typ)

fn (var b: Builder) unit_t() -> Int {
  b.m.builtin(Kind.Unit)
}

fn (var b: Builder) int_t() -> Int {
  b.m.builtin(Kind.Int)
}

fn (var b: Builder) bool_t() -> Int {
  b.m.builtin(Kind.Bool)
}

fn (var b: Builder) str_t() -> Int {
  b.m.builtin(Kind.Str)
}

fn (var b: Builder) float_t() -> Int {
  b.m.builtin(Kind.Float)
}

/// Lowers a checker type.
fn (var b: Builder) typ(t0: Int) -> Int {
  if t0 < 0 {
    return b.unit_t()
  }
  let t = b.c.resolve(t0)
  let x = b.c.tys[t]
  match x.kind {
    Tuple => {
      var es: List[Int] = []
      for e in x.args {
        es.push(b.typ(e))
      }
      return b.m.tuple(es)
    }
    Func => {
      var ps: List[Int] = []
      for (i, p) in x.args.indexed() {
        if x.vars[i] {
          b.unsupported("function values with `var` parameters")
        }
        ps.push(b.typ(p))
      }
      let rt = b.typ(b.result_of(x.result, b.fail_err(x.err)))
      return b.m.func_type(ps, rt)
    }
    Var => return b.unit_t()
    Named => return b.named_type(t)
    _ => {}
  }
  b.unsupported("the type `${b.c.show(t)}`")
  b.poison(b.c.show(t))
}

fn (var b: Builder) named_type(t: Int) -> Int {
  let x = b.c.tys[t]
  let obj = x.obj
  let om = b.obj_mod(obj)
  let oname = b.obj_name(obj)
  if b.is_prelude_mod(om) {
    match oname {
      "Int" | "Int64" => return b.int_t()
      "Float" => return b.float_t()
      "Float32" => return b.m.float32()
      "Secret" => {
        let it = b.impl_named(t)
        let (st, created) = b.m.named(b.type_name(it), Kind.Struct)
        if created && x.args.len() == 1 {
          let ft = b.typ(x.args[0])
          b.m.types[st].fields = [SField{name: "v", ty: ft}]
        }
        return st
      }
      "Bool" => return b.bool_t()
      "Str" | "Bytes" | "StrBuilder" | "BytesBuilder" => return b.str_t()
      "Int8" | "Int16" | "Int32" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Rune" => return b.m.int_type(oname)
      "Duration" | "Time" => return b.int_t()
      "Never" => return b.unit_t()
      "Fs" => return b.fs_type()
      "Proc" | "Env" | "Net" => return b.lists_type(oname)
      "Stdio" | "Clock" | "Rand" => return b.void_cap_type(oname)
      "Os" => return b.os_type()
      "List" | "Buf" => {
        let et = b.typ(x.args[0])
        return b.m.list(et)
      }
      "Map" => {
        let k = b.typ(x.args[0])
        let v = b.typ(x.args[1])
        return b.map_type(false, k, v)
      }
      "Set" => {
        let k = b.typ(x.args[0])
        return b.map_type(true, k, b.unit_t())
      }
      "Result" => {
        if x.args.len() == 2 && b.c.is_never(x.args[1]) {
          return b.typ(x.args[0])
        }
      }
      _ => {}
    }
  }
  if om >= 0 && b.c.mods[om].path == "std/testing" {
    let cap = test_cap(oname)
    if !cap.is_empty() {
      if cap == "Fs" {
        return b.fs_type()
      }
      if cap is "Proc" | "Env" | "Net" {
        return b.lists_type(cap)
      }
      if cap is "Stdio" | "Clock" | "Rand" {
        return b.void_cap_type(cap)
      }
      if cap == "Os" {
        return b.os_type()
      }
      let (ct, _) = b.m.named(cap, Kind.Cap)
      return ct
    }
  }
  let impl_t = b.impl_named(t)
  let name = b.type_name(impl_t)
  if om >= 0 && !b.c.mods[om].go_path.is_empty() {
    b.impossible("the type `${name}` of the Go package `${b.c.mods[om].go_path}` (`use go`)")
    return b.unit_t()
  }
  if om >= 0 && !b.c.mods[om].c_prefix.is_empty() && b.c.objs[obj].opaque {
    // a C handle of `use c`: the pointer in a word, never reference
    // counted (decision 0116)
    return b.int_t()
  }
  let tk = b.c.objs[obj].tkind
  if tk == "struct" {
    if b.conc_type(obj) {
      // a handle of the runtime (build_conc.go concType)
      b.set_flag(1)
      var hname = oname
      if !b.is_prelude_mod(om) {
        hname = "task.Group"
      }
      var es: List[Int] = []
      var ns: List[Str] = []
      for a in x.args {
        let et = b.typ(a)
        es.push(et)
        ns.push(b.m.types[et].name)
      }
      if !ns.is_empty() {
        hname = "${hname}[${ns.join(", ")}]"
      }
      return b.m.handle(hname, es)
    }
    let it = b.impl_type(obj)
    if it >= 0 {
      return b.typ(b.c.mk_named(it, x.args))
    }
    if om >= 0 && b.c.mods[om].path.starts_with("native/") && b.c.objs[obj].opaque {
      if oname == "Loc" {
        return b.str_t()
      }
      return b.m.handle("${b.c.mods[om].path.replace("/", ".")}.${oname}", [])
    }
    let std_opaque = b.is_std_mod(om) && (b.c.objs[obj].opaque || b.is_prelude_mod(om) && !(oname is "DurationErr" | "FileInfo" | "ProcOutput" | "Target"))
    if !std_opaque {
      let (st, created) = b.m.named(name, Kind.Struct)
      if created {
        let sub = b.c.args_subst(b.c.objs[obj].tparams, x.args)
        var fs: List[SField] = []
        for f in b.c.objs[obj].fields {
          let ft = b.c.subst(f.ty, sub)
          let lt = b.typ(ft)
          fs.push(SField{name: check.text(f.name), ty: b.boxed(ft, lt, name)})
        }
        b.m.types[st].fields = fs
      }
      return st
    }
  } else if tk == "enum" {
    let (et, created) = b.m.named(name, Kind.Enum)
    if created {
      let sub = b.c.args_subst(b.c.objs[obj].tparams, x.args)
      var vs: List[SVariant] = []
      let prelude = b.is_prelude_mod(om)
      for v in b.c.objs[obj].variants {
        var nv = SVariant{name: check.text(v.name)}
        for (i, f) in v.fields.indexed() {
          var fname = check.text(f.name)
          if fname.is_empty() {
            fname = "${i}"
          }
          let ct = b.c.subst(f.ty, sub)
          var ft = b.typ(ct)
          if !prelude {
            ft = b.boxed(ct, ft, name)
          }
          nv.fields.push(SField{name: fname, ty: ft})
        }
        if prelude && oname == "Result" && nv.name == "Err" {
          nv.fields.push(SField{name: TRACE_FIELD, ty: b.trace_type()})
        }
        vs.push(nv)
      }
      b.m.types[et].variants = vs
    }
    return et
  } else if tk == "alias" {
    return b.typ(b.c.subst(b.c.objs[obj].target, b.c.args_subst(b.c.objs[obj].tparams, x.args)))
  } else if tk == "newtype" {
    let (st, created) = b.m.named(name, Kind.Struct)
    if created {
      let ft = b.c.subst(b.c.objs[obj].target, b.c.args_subst(b.c.objs[obj].tparams, x.args))
      let lt = b.typ(ft)
      b.m.types[st].fields = [SField{name: "0", ty: b.boxed(ft, lt, name)}]
    }
    return st
  } else if tk == "interface" {
    if b.dyn_iface(obj) {
      // its text (build_show.go)
      return b.dyn_type()
    }
    // function values over the concrete value (iface.xo)
    return b.iface_type(t, obj)
  }
  b.unsupported("the type `${b.c.show(t)}`")
  b.poison(b.c.show(t))
}

/// The type of values whose type the builder could not lower: a unit
/// named `<unsupported: T>`, so that every function its name reaches is
/// skipped (dump).
fn (var b: Builder) poison(text: Str) -> Int {
  let name = "<unsupported: ${text}>"
  if let Some(t) = b.m.type_at.get(name) {
    b.fe_touch("poison")
    return t
  }
  let i = b.m.types.len()
  b.m.types.push(SType{kind: Kind.Bad, name: name})
  b.m.type_at[name] = i
  i
}

/// The capability a fake of std/testing stands for (testCaps), or "".
fn test_cap(name: Str) -> Str {
  match name {
    "TestOs" => "Os"
    "FakeNet" => "Net"
    "MemFs" => "Fs"
    "FakeClock" => "Clock"
    "FakeEnv" => "Env"
    "FakeStdio" => "Stdio"
    "FakeProc" => "Proc"
    _ => ""
  }
}

/// Whether the struct obj is a runtime handle of the concurrency
/// constructs (build_conc.go concType).
fn (var b: Builder) conc_type(obj: Int) -> Bool {
  let om = b.obj_mod(obj)
  if om < 0 {
    return false
  }
  let n = b.obj_name(obj)
  if b.c.mods[om].is_prelude {
    return n is "Chan" | "Mutex" | "Atomic" | "Scope" | "Task" | "Listener" | "Conn" | "ServerConn"
  }
  b.c.mods[om].path == "std/task" && n == "Group"
}

/// The lowered Map or Set (build_map.go mapType).
fn (var b: Builder) map_type(set: Bool, k: Int, v: Int) -> Int {
  var name = "Map[${b.m.types[k].name}, ${b.m.types[v].name}]"
  if set {
    name = "Set[${b.m.types[k].name}]"
  }
  let (t, created) = b.m.named(name, Kind.Struct)
  if created {
    let kl = b.m.list(k)
    let vl = b.m.list(v)
    let ll = b.m.list(b.bool_t())
    let sl = b.m.list(b.int_t())
    let n = b.int_t()
    b.m.types[t].coll = true
    b.m.types[t].fields = [SField{name: "keys", ty: kl}, SField{name: "vals", ty: vl}, SField{name: "live", ty: ll}, SField{name: "slots", ty: sl}, SField{name: "n", ty: n}]
    if b.m.map_log {
      // decision 0291's hybrid: the lists until a value written while
      // shared converts (map.xo maph_*), then the log table in log
      let lt = b.mlog_type("xo.MapLog[${name}]", k, v)
      b.m.types[t].fields = b.m.types[t].fields + [SField{name: "log", ty: b.m.list(lt)}]
    }
  }
  t
}

/// The lowered Fs (build_io.go fsType).
fn (var b: Builder) fs_type() -> Int {
  let (t, created) = b.m.named("xo.Fs", Kind.Struct)
  if created {
    let st = b.str_t()
    let it = b.int_t()
    var fs = [SField{name: "root", ty: st}, SField{name: "mode", ty: it}]
    // a user value converted to Fs (decision 0307): the native prelude's
    // UserFs record, None for the runtime's own Fs
    let ut = b.user_fs_check()
    if ut >= 0 {
      fs.push(SField{name: "user", ty: b.user_holder(ut)})
    }
    b.m.types[t].fields = fs
  }
  t
}

/// The module native/llrt/userfs (decision 0307), or -1 when the
/// program has none (the Go backend).
fn (var b: Builder) userfs_mod() -> Int {
  for m in b.c.order {
    if b.c.mods[m].path == "native/llrt/userfs" {
      return m
    }
  }
  -1
}

/// The checker type of native/llrt/userfs's UserFs (decision 0307), or -1
/// when the program has none (the Go backend).
fn (var b: Builder) user_fs_check() -> Int { b.user_cap_check("UserFs") }

/// The checker type of the interface name of native/llrt/userfs
/// (UserFs, UserNet, UserProc, UserEnv; decision 0307), or -1.
fn (var b: Builder) user_cap_check(name: Str) -> Int {
  let um = b.userfs_mod()
  if um < 0 {
    return -1
  }
  let o = b.member(um, name)
  if o < 0 || b.c.objs[o].kind != check.ObjKind.Type {
    return -1
  }
  b.c.mk_named(o, [])
}

/// v (checker type ct, not an Fs) converted to Fs (decision 0307): an Fs
/// whose user field holds v as a UserFs record.
fn (var b: Builder) user_to_fs(v: Int, ct: Int, at: Expr?) -> Int {
  let t = b.fs_type()
  if b.m.types[t].fields.len() < 3 {
    b.unsupported("converting `${b.m.types[b.vty(v)].name}` to `Fs` without the native prelude")
    return b.undef(t)
  }
  let u = b.user_hold(b.m.types[t].fields[2].ty, v, ct, at)
  // root and mode deny everything (as fs_cwd's fallback), so that native
  // code reading them directly instead of calling a method (lock_shared)
  // never treats a user value as the unrestricted Fs
  b.add(Op.Struct, t, Aux.None, [b.const_str("denied"), b.cint(7), u])
}

/// The fields of a runtime Fs with root and mode: the user field, when
/// there is one, None (decision 0307).
fn (var b: Builder) fs_fields(t: Int, root: Int, mode: Int) -> List[Int] {
  var vs = [root, mode]
  if b.m.types[t].fields.len() > 2 {
    vs.push(b.zero(b.m.types[t].fields[2].ty, []))
  }
  vs
}

fn (var b: Builder) is_fs(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && b.m.types[t].name == "xo.Fs"
}

/// The lowered Proc, Env, or Net (build_io.go listsType): the lists of
/// its attenuations in one Str.
fn (var b: Builder) lists_type(name: Str) -> Int {
  let (t, created) = b.m.named("xo.${name}", Kind.Struct)
  if created {
    let st = b.str_t()
    var fs = [SField{name: "lists", ty: st}]
    // a user value converted to the capability (decision 0307): its
    // native/llrt/userfs record, None for the runtime's own
    let ut = b.user_cap_check("User${name}")
    if ut >= 0 {
      fs.push(SField{name: "user", ty: b.user_holder(ut)})
    }
    b.m.types[t].fields = fs
  }
  t
}

/// The fields of a runtime Proc, Env, or Net t with lists: the user
/// field, when there is one, None (decision 0307).
fn (var b: Builder) lists_fields(t: Int, lists: Int) -> List[Int] {
  var vs = [lists]
  if b.m.types[t].fields.len() > 1 {
    vs.push(b.zero(b.m.types[t].fields[1].ty, []))
  }
  vs
}

/// v (checker type ct, not a Proc, Env, or Net) converted to the
/// capability t (decision 0307): t's user field holds v as a record, and
/// its lists admit nothing ("\u{1}", one empty list), so native code
/// that reads the lists instead of calling a method denies.
fn (var b: Builder) user_to_lists(v: Int, ct: Int, t: Int, at: Expr?) -> Int {
  if b.m.types[t].fields.len() < 2 {
    b.unsupported("converting `${b.m.types[b.vty(v)].name}` to `${b.m.types[t].name}` without the native prelude")
    return b.undef(t)
  }
  let u = b.user_hold(b.m.types[t].fields[1].ty, v, ct, at)
  b.add(Op.Struct, t, Aux.None, [b.const_str("\u{1}"), u])
}

/// The lowered Stdio, Clock, or Rand (decision 0307, the last step): one
/// field, the native/llrt/userfs record of a user value converted to it,
/// None for the runtime's own, whose methods take no state. A std without
/// the record interfaces (a seed's) keeps the void capability.
fn (var b: Builder) void_cap_type(name: Str) -> Int {
  let ut = b.user_cap_check("User${name}")
  if ut < 0 {
    let (ct, _) = b.m.named(name, Kind.Cap)
    return ct
  }
  let (t, created) = b.m.named("xo.${name}", Kind.Struct)
  if created {
    b.m.types[t].fields = [SField{name: "user", ty: b.user_holder(ut)}]
  }
  t
}

/// The lowered Os (decision 0307, the last step): one field, the
/// native/llrt/userfs UserOs record of an Os a program built with a
/// literal, None for the runtime's own, whose fields are the runtime's
/// own capabilities. A std without UserOs (a seed's) keeps the void Os.
fn (var b: Builder) os_type() -> Int {
  let ut = b.user_cap_check("UserOs")
  if ut < 0 {
    let (ct, _) = b.m.named("Os", Kind.Cap)
    return ct
  }
  let (t, created) = b.m.named("xo.Os", Kind.Struct)
  if created {
    // lowering UserOs's record lowers task.Group (its tasks method),
    // which marks the program as using tasks (conc_type); the type alone
    // does not, and every program lowers Os: keep the flags as they were
    // (a Group value comes only from os.tasks, Scope.group, or a task
    // operation, each of which sets them; 2026-10-21: every program was
    // built with unwinding checks)
    let need = b.need_conc
    let bits = b.fe_flagbits
    let h = b.user_holder(ut)
    b.need_conc = need
    b.fe_flagbits = bits
    b.m.types[t].fields = [SField{name: "user", ty: h}]
  }
  t
}

fn (var b: Builder) is_os(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && b.m.types[t].name == "xo.Os"
}

fn (var b: Builder) is_void_cap(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && (b.m.types[t].name is "xo.Stdio" | "xo.Clock" | "xo.Rand")
}

/// The index of the user field of a lowered Proc, Env, Net, Stdio, Clock,
/// or Rand t, or -1 when it has none.
fn (var b: Builder) cap_user_field(t: Int) -> Int {
  if b.is_void_cap(t) {
    return 0
  }
  if b.is_lists(t) && b.m.types[t].fields.len() > 1 {
    return 1
  }
  -1
}

/// The runtime's own Stdio, Clock, or Rand t (a struct whose user field is
/// None).
fn (var b: Builder) own_void_cap(t: Int) -> Int {
  b.add(Op.Struct, t, Aux.None, [b.zero(b.m.types[t].fields[0].ty, [])])
}

/// v (checker type ct, not the capability) converted to the Stdio, Clock,
/// or Rand t (decision 0307): t's user field holds v as a record.
fn (var b: Builder) user_to_void_cap(v: Int, ct: Int, t: Int, at: Expr?) -> Int {
  b.add(Op.Struct, t, Aux.None, [b.user_hold(b.m.types[t].fields[0].ty, v, ct, at)])
}

/// The user field of a lowered capability for the interface type ut
/// (decision 0307): xo.user[R], None (tag 0, so all-zero words are None)
/// for the runtime's own value, or Some with ut's record R boxed. Two
/// words, where an Option of the record itself would hold two words a
/// method in every capability value (an Fs was 66 words).
fn (var b: Builder) user_holder(ut: Int) -> Int {
  let rect = b.typ(ut)
  let bt = b.m.box_of(rect)
  let (et, created) = b.m.named("xo.user[${b.m.types[rect].name}]", Kind.Enum)
  if created {
    b.m.types[et].variants = [SVariant{name: "None"}, SVariant{name: "Some", fields: [SField{name: "v", ty: bt}]}]
  }
  et
}

/// The record type of the user field type lt.
fn (var b: Builder) user_rect(lt: Int) -> Int {
  b.m.types[b.m.types[lt].variants[1].fields[0].ty].elems[0]
}

/// v (checker type ct) as the user field of type lt: Some of its record,
/// boxed.
fn (var b: Builder) user_hold(lt: Int, v: Int, ct: Int, at: Expr?) -> Int {
  let bt = b.m.types[lt].variants[1].fields[0].ty
  let rec = b.to_iface(v, ct, b.m.types[bt].elems[0], at)
  b.add(Op.Variant, lt, Aux.I(n: 1), [b.add(Op.Box, bt, Aux.None, [rec])])
}

/// Whether the user field u holds a record.
fn (var b: Builder) user_held(u: Int) -> Int {
  b.is_tag(u, "Some")
}

/// Whether user field idx of w is statically None, the runtime's own
/// value: w is a capability struct built here from a None (the runtime's
/// own Stdio, Clock, Rand, Fs ... made by own_os_field). The dispatch on
/// a user value is then dropped, not left to the optimizer behind a join
/// (2026-10-21: every main called through its Os, goldens fib and
/// sieve). It is asked before the field is read: a read of it would be
/// released, a runtime call left in main.
fn (var b: Builder) known_none(w: Int, idx: Int) -> Bool {
  let f = b.s.f
  let wv = f.values[w]
  if wv.op == Op.Struct && idx < wv.args.len() {
    let a = f.values[wv.args[idx]]
    if a.op == Op.Variant && a.args.is_empty() {
      if let I(n) = a.aux {
        return n == 0
      }
    }
  }
  false
}

/// Whether x, in main, is main's own Os parameter (not `var`) and no code
/// names main: the entry passes the runtime's own Os, so its user field
/// is None. Asked of the expression, since the builder threads the value
/// through loops as a block parameter.
fn (var b: Builder) main_os(x: Expr) -> Bool {
  if b.s.f.name != "main" {
    return false
  }
  let vo = match x {
    Ident(id) => b.c.var_of(b.s.file, id)
    _ => -1
  }
  let mfo = b.main_fo_of()
  if vo < 0 || mfo < 0 || b.c.objs[vo].local != "param" {
    return false
  }
  let ps = b.c.param_vars.get(mfo) ?? []
  !ps.is_empty() && ps[0] == vo && b.main_unnamed()
}

/// Whether no identifier of the program names main, so only the entry
/// calls it (a call `main(Os{stdio: tee, ...})` passes a user value). A
/// main module whose check came from the module cache recorded no names:
/// its entry's answer (ModEntry.main_unnamed) is taken.
fn (var b: Builder) main_unnamed() -> Bool {
  if b.main_named < 0 {
    let un = b.c.mod_cached_main_unnamed(b.main_mod) ?? b.c.names_only_decl(b.main_fo_of())
    b.main_named = if un { 0 } else { 1 }
  }
  b.main_named == 0
}

/// The record the user field u holds (user_held is true).
fn (var b: Builder) user_rec(u: Int) -> Int {
  let bt = b.m.types[b.vty(u)].variants[1].fields[0].ty
  b.unbox(b.add(Op.Payload, bt, Aux.P(tag: 1, field: 0), [u]))
}

fn (var b: Builder) is_lists(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && (b.m.types[t].name == "xo.Proc" || b.m.types[t].name == "xo.Env" || b.m.types[t].name == "xo.Net")
}

/// The value of an interface type Error, Display, or Debug (build_show.go
/// dynType).
fn (var b: Builder) dyn_type() -> Int {
  let (t, created) = b.m.named("xo.dyn", Kind.Struct)
  if created {
    let st = b.str_t()
    let bt = b.bool_t()
    b.m.types[t].fields = [SField{name: "text", ty: st}, SField{name: "raw", ty: bt}, SField{name: "dbg", ty: st}]
  }
  t
}

fn (var b: Builder) is_dyn(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && b.m.types[t].name == "xo.dyn"
}

fn (var b: Builder) is_iface(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && b.m.types[t].name.starts_with("xo.iface[")
}

fn (var b: Builder) dyn_iface(obj: Int) -> Bool {
  b.is_prelude_mod(b.obj_mod(obj)) && (b.obj_name(obj) is "Error" | "Display" | "Debug")
}

/// xo.trace (build_frames.go traceType).
fn (var b: Builder) trace_type() -> Int {
  let (t, created) = b.m.named("xo.trace", Kind.Struct)
  if created {
    let st = b.str_t()
    let ft = b.m.func_type([], st)
    let frame = b.m.tuple([st, st, ft])
    let lt = b.m.list(frame)
    b.m.types[t].fields = [SField{name: "frames", ty: lt}]
  }
  t
}

fn (var b: Builder) is_trace(t: Int) -> Bool {
  b.m.types[t].kind == Kind.Struct && b.m.types[t].name == "xo.trace"
}

/// The field type of t when it is boxed: Box[ft] when the field's checker
/// type ct reaches owner by value (decision 0052), else ft.
fn (var b: Builder) boxed(ct: Int, ft: Int, owner: Str) -> Int {
  if b.reaches_by_value(ct, owner, []) {
    return b.m.box_of(ft)
  }
  ft
}

fn (var b: Builder) reaches_by_value(t0: Int, owner: Str, seen: List[Str]) -> Bool {
  b.reaches(t0, owner, seen).0
}

/// reachesByValue, threading seen (Go shares one map through the walk).
fn (var b: Builder) reaches(t0: Int, owner: Str, seen0: List[Str]) -> (Bool, List[Str]) {
  var seen = seen0
  if t0 < 0 {
    return (false, seen)
  }
  let t = b.c.resolve(t0)
  let x = b.c.tys[t]
  match x.kind {
    Tuple => {
      for e in x.args {
        let (r, s2) = b.reaches(e, owner, seen)
        seen = s2
        if r {
          return (true, seen)
        }
      }
    }
    Named => {
      let obj = x.obj
      let om = b.obj_mod(obj)
      let oname = b.obj_name(obj)
      if b.is_prelude_mod(om) && (oname is "Int" | "Int64" | "Float" | "Bool" | "Str" | "Never" | "Os" | "Stdio" | "List") {
        return (false, seen)
      }
      let tk = b.c.objs[obj].tkind
      if tk == "alias" {
        return b.reaches(b.c.subst(b.c.objs[obj].target, b.c.args_subst(b.c.objs[obj].tparams, x.args)), owner, seen)
      }
      if tk == "struct" || tk == "enum" {
        if tk == "struct" && b.is_std_mod(om) {
          return (false, seen)
        }
        let name = b.type_name(t)
        if name == owner {
          return (true, seen)
        }
        let prelude = b.is_prelude_mod(om)
        if seen.contains(name) || (!prelude && name < owner) {
          return (false, seen)
        }
        seen.push(name)
        let sub = b.c.args_subst(b.c.objs[obj].tparams, x.args)
        for f in b.c.objs[obj].fields {
          let (r, s2) = b.reaches(b.c.subst(f.ty, sub), owner, seen)
          seen = s2
          if r {
            return (true, seen)
          }
        }
        for v in b.c.objs[obj].variants {
          for f in v.fields {
            let (r, s2) = b.reaches(b.c.subst(f.ty, sub), owner, seen)
            seen = s2
            if r {
              return (true, seen)
            }
          }
        }
      }
    }
    _ => {}
  }
  (false, seen)
}

/// The names of the types declared by more than one user module
/// (ambiguousTypeNames).
/// The modules named by their path in SSA names: every program module
/// whose default name another module of the build has (app/a/util and
/// app/b/util; a program's util and a std util). std modules keep their
/// names, which the std store holds whatever a build loads, so two std
/// modules sharing one (std/trace and std/native/llrt/trace) may not
/// declare the same function (internal/repotest
/// TestStdSameNameModulesDisjoint).
/// Before, both modules' functions were `util.parse`: one of the two
/// bodies was called for both on the native and wasm backends, and LLVM
/// refused the duplicate (2026-10-29, found by xo-lang-5 through std/x509
/// and std/native/llrt/x509).
fn (var b: Builder) path_named_mods() -> Set[Int] {
  var by: Map[Str, List[Int]] = {}
  for (m, md) in b.c.mods.indexed() {
    var l = by.get(md.name) ?? []
    l.push(m)
    by[md.name] = l
  }
  var out: Set[Int] = #{}
  for (_, ms) in by {
    if ms.len() < 2 {
      continue
    }
    for m in ms {
      if !b.c.mods[m].is_std && !b.c.mods[m].native {
        out.add(m)
      }
    }
  }
  out
}

/// The prefix of module m's functions and constants in SSA names: its
/// default name, or its path when another module has that name
/// (path_named_mods).
fn (b: Builder) mod_prefix(m: Int) -> Str {
  if b.path_named.contains(m) {
    return b.c.mods[m].path
  }
  b.c.mods[m].name
}

fn (var b: Builder) ambiguous_type_names() -> Map[Str, Bool] {
  var owner: Map[Str, Int] = {}
  var out: Map[Str, Bool] = {}
  for m in b.c.order {
    if b.c.mods[m].is_std || b.c.mods[m].native {
      continue
    }
    for (name, o) in b.c.mods[m].members {
      if b.c.objs[o].kind != check.ObjKind.Type || b.c.objs[o].tkind == "alias" {
        continue
      }
      let n = check.text(name)
      if let Some(prev) = owner.get(n) {
        if prev != m {
          out[n] = true
        }
      }
      owner[n] = m
      // a program's own type named like a prelude type (`Conn`, `Cmd`):
      // the prelude's is interned under the bare name, so the program's
      // takes its module path (2026-10-21: a user `struct Conn` became the
      // prelude's Conn handle once Os's UserOs record lowered Net.dial's
      // result, and its literal was XO1201)
      if b.c.prelude >= 0 {
        if let Some(po) = b.c.mods[b.c.prelude].members.get(name) {
          if b.c.objs[po].kind == check.ObjKind.Type {
            out[n] = true
          }
        }
      }
    }
  }
  out
}

/// The name a lowered named type is interned under (typeName).
fn (var b: Builder) type_name(t: Int) -> Str {
  if b.ambiguous.is_empty() {
    return b.c.show(t)
  }
  b.type_text(t)
}

fn (var b: Builder) type_text(t0: Int) -> Str {
  let t = b.c.resolve(t0)
  let x = b.c.tys[t]
  match x.kind {
    Named => {
      let obj = x.obj
      let om = b.obj_mod(obj)
      if b.is_prelude_mod(om) && b.obj_name(obj) == "Option" && x.args.len() == 1 {
        var s = b.type_text(x.args[0])
        if b.tyk(x.args[0]) == check.TyKind.Func {
          s = "(${s})"
        }
        return "${s}?"
      }
      var name = b.c.qual_name(obj)
      let oname = b.obj_name(obj)
      if b.ambiguous.contains(oname) && om >= 0 && !b.c.mods[om].is_std && !b.c.mods[om].native {
        name = "${b.c.mods[om].path}.${b.obj_name(obj)}"
      }
      if x.args.is_empty() {
        return name
      }
      var args: List[Str] = []
      for a in x.args {
        args.push(b.type_text(a))
      }
      return "${name}[${args.join(", ")}]"
    }
    Tuple => {
      var es: List[Str] = []
      for e in x.args {
        es.push(b.type_text(e))
      }
      if es.len() == 1 {
        return "(${es[0]},)"
      }
      return "(${es.join(", ")})"
    }
    _ => {}
  }
  b.c.show(t)
}

// ---------------------------------------------------------------------------
// Native implementations (build_native.go)

/// The implementation module of the std module path, or -1.
fn (var b: Builder) native_mod(path: Str) -> Int {
  if b.natives.is_empty() {
    for m in b.c.order {
      if b.c.mods[m].native {
        b.natives[b.c.mods[m].implements] = m
      }
    }
  }
  b.natives.get(path) ?? -1
}

/// The native prelude's function name (one the builder calls itself, not
/// as a method's implementation), or -1 (preludeImpl).
fn (var b: Builder) prelude_impl(name: Str) -> Int {
  let nm = b.native_mod("std/prelude")
  if nm < 0 {
    return -1
  }
  let impl = b.member(nm, name)
  if impl < 0 || b.c.objs[impl].kind != check.ObjKind.Func || b.c.objs[impl].recv >= 0 {
    return -1
  }
  impl
}

fn (var b: Builder) member(m: Int, name: Str) -> Int {
  b.c.mods[m].members.get(name.bytes()) ?? -1
}

/// The implementation of the std function fo, or -1 (implOf).
fn (var b: Builder) impl_of(fo: Int) -> Int {
  let om = b.obj_mod(fo)
  if om < 0 || !b.c.mods[om].is_std || b.c.objs[fo].iface {
    return -1
  }
  let nm = b.native_mod(b.c.mods[om].path)
  if nm < 0 {
    return -1
  }
  var name = b.obj_name(fo)
  let r = b.c.objs[fo].recv
  if r >= 0 {
    if !b.c.objs[fo].is_static {
      let t = b.member(nm, b.obj_name(r))
      if t >= 0 && b.c.objs[t].kind == check.ObjKind.Type {
        if let Some(mo) = b.c.objs[t].methods.get(b.c.objs[fo].name) {
          return mo
        }
      }
    }
    name = "${b.obj_name(r).to_lower()}_${name}"
  }
  let f = b.member(nm, name)
  if f >= 0 && b.c.objs[f].kind == check.ObjKind.Func && b.c.objs[f].recv < 0 {
    return f
  }
  -1
}

/// The implementation module's type of the std type obj, or -1.
fn (var b: Builder) impl_type(obj: Int) -> Int {
  let om = b.obj_mod(obj)
  if om < 0 || !b.c.mods[om].is_std {
    return -1
  }
  let nm = b.native_mod(b.c.mods[om].path)
  if nm < 0 {
    return -1
  }
  let t = b.member(nm, b.obj_name(obj))
  if t >= 0 && b.c.objs[t].kind == check.ObjKind.Type {
    return t
  }
  -1
}

/// t with every std struct that has an implementation type replaced by
/// it, in its arguments too (implNamed).
fn (var b: Builder) impl_named(t0: Int) -> Int {
  let t = b.c.resolve(t0)
  let x = b.c.tys[t]
  match x.kind {
    Named => {
      var obj = x.obj
      if b.c.objs[obj].tkind == "struct" {
        let it = b.impl_type(obj)
        if it >= 0 {
          obj = it
        }
      }
      if obj == x.obj && x.args.is_empty() {
        return t
      }
      var args: List[Int] = []
      var changed = obj != x.obj
      for a in x.args {
        let ia = b.impl_named(a)
        changed = changed || ia != a
        args.push(ia)
      }
      if !changed {
        // the same type: no new table entry (its text is the same)
        return t
      }
      return b.c.mk_named(obj, args)
    }
    Tuple => {
      var es: List[Int] = []
      var changed = false
      for e in x.args {
        let ie = b.impl_named(e)
        changed = changed || ie != e
        es.push(ie)
      }
      if !changed {
        return t
      }
      return b.c.mk_tuple(es)
    }
    _ => {}
  }
  t
}

// ---------------------------------------------------------------------------
// Functions

/// The SSA name of fo (funcName).
fn (var b: Builder) func_name(fo: Int) -> Str {
  var n = b.c.display_name(fo)
  let om = b.obj_mod(fo)
  if om >= 0 && om != b.main_mod {
    n = "${b.mod_prefix(om)}.${n}"
  }
  if b.tests && n == "main" {
    // a test binary's main is the test entry; the program's main is an
    // ordinary function (testing.run_main calls it)
    n = "main.main"
  }
  n
}

/// The SSA function of fo instantiated with targs (checker types of its
/// type parameters), declared and queued on first use (declare).
fn (var b: Builder) declare(fo: Int, targs: List[Int]) -> Int {
  if !b.m.fe_log {
    return b.declare0(fo, targs)
  }
  // a recording (fecache.xo): the commit replays a declare whole, so
  // what it makes and finds is its own, not the body's
  if targs.is_empty() {
    b.m.fe_ev.push((4, fo))
  }
  b.m.fe_log = false
  let f = b.declare0(fo, targs)
  b.m.fe_log = true
  f
}

/// Sets need_conc (k 1) or uses_net (k 2), noted while a body records:
/// its entry sets them again when committed (fecache.xo), whatever the
/// recording builder had set before.
fn (var b: Builder) set_flag(k: Int) {
  if k == 1 {
    b.need_conc = true
    b.conc_names[b.s.f.name] = true
  } else {
    b.uses_net = true
  }
  if b.m.fe_log {
    b.fe_flagbits = b.fe_flagbits | k
  }
}

/// m.func_index, noted while a body records (Module.fe_freads).
fn (var b: Builder) fidx(name: Str) -> Int {
  let i = b.m.func_index(name)
  if b.m.fe_log {
    if i >= 0 {
      b.m.fe_freads[i] = true
    } else {
      b.m.fe_fabsent[name] = true
    }
  }
  i
}

/// A recorded body read a table a commit does not replay (fecache.xo):
/// it is not cached, what names the reason (XO_FE_STATS).
fn (var b: Builder) fe_touch(what: Str) {
  if b.m.fe_log && b.fe_touched.is_empty() {
    b.fe_touched = what
  }
}

fn (var b: Builder) declare0(fo: Int, targs: List[Int]) -> Int {
  if targs.is_empty() {
    // a function that is not generic has one instance, keyed by fo
    if let Some(f) = b.plain.get(fo) {
      return f
    }
  }
  let tps = b.type_params(fo)
  if targs.len() != tps.len() {
    b.unsupported("a generic call whose type arguments are not inferred (`${b.c.display_name(fo)}`)")
    let u = b.unit_t()
    return b.m.new_func("${b.func_name(fo)}?", [], [u])
  }
  let was = b.declaring
  let pend = b.pend_skip
  b.declaring = true
  b.pend_skip = ""
  var sub: Map[Int, Int] = {}
  var sargs: List[Int] = []
  if !tps.is_empty() {
    sub = b.c.args_subst(tps, targs)
    for t in targs {
      sargs.push(b.typ(t))
    }
  }
  var name = b.func_name(fo)
  if !sargs.is_empty() {
    var ns: List[Str] = []
    for t in sargs {
      ns.push(b.m.types[t].name)
    }
    name = "${name}[${ns.join(", ")}]"
  }
  var key = "${fo}:${name}"
  if !targs.is_empty() {
    var cs: List[Str] = []
    for t in targs {
      let it = b.impl_named(t)
      cs.push(b.c.show(it))
    }
    key = "${key}|${cs.join(", ")}"
    if let Some(f) = b.funcs.get(key) {
      b.declaring = was
      b.pend_skip = pend
      if b.fe_rec && !was {
        // a recording found it: the commit finds it by the key
        b.fe_greads.push((key, b.m.funcs[f].name))
      }
      return f
    }
    // a new instance: not replayed (fecache.xo)
    b.fe_gen = true
    var n = 2
    while b.fidx(name) >= 0 {
      let base = name.split("#")[0]
      name = "${base}#${n}"
      n += 1
    }
  }
  if let Some(f) = b.funcs.get(key) {
    b.declaring = was
    b.pend_skip = pend
    return f
  }
  var params: List[Int] = []
  var var_idx: List[Int] = []
  if b.c.objs[fo].recv >= 0 {
    params.push(b.typ(b.c.subst(b.c.objs[fo].recv_ty, sub)))
    if b.c.objs[fo].recv_var {
      var_idx.push(0)
    }
  }
  for p in b.c.objs[fo].params {
    if p.is_var {
      var_idx.push(params.len())
    }
    params.push(b.typ(b.c.subst(p.ty, sub)))
  }
  let res = b.c.subst(b.c.objs[fo].result, sub)
  let err0 = b.c.subst(b.c.objs[fo].err, sub)
  let err = b.fail_err(err0)
  var results = [b.typ(b.result_of(res, err))]
  for i in var_idx {
    results.push(params[i])
  }
  let f = b.m.new_func(name, params, results)
  b.m.funcs[f].var_params = var_idx
  let skipped = b.pend_skip
  b.declaring = was
  b.pend_skip = pend
  if !skipped.is_empty() {
    // the signature holds a type outside the stages ported: the function
    // and its callers' calls differ from the Go builder's
    b.m.funcs[f].skip = skipped
    b.unsupported(skipped)
  }
  b.funcs[key] = f
  if targs.is_empty() {
    b.plain[fo] = f
  }
  let om = b.obj_mod(fo)
  if om >= 0 {
    // the modules the program builds code of (declare_exports)
    b.decl_mods[b.c.mods[om].path] = true
  }
  b.queue.push(Job.Body(fo: fo, fi: f, sub: sub))
  f
}

/// The checker file of fo's declaration, or -1.
fn (var b: Builder) decl_file(o: Int) -> Int {
  b.c.objs[o].decl_file
}

/// Starts building the body of function fi in a fresh state; returns the
/// state it replaces (newFn).
fn (var b: Builder) begin(fi: Int, file: Int) -> S {
  let f = b.m.funcs[fi]
  // the module keeps the signature (a recursive call reads it)
  let ps = f.blocks[0].params
  var pvals: List[Value] = []
  for p in ps {
    pvals.push(f.values[p])
  }
  b.m.funcs[fi] = Func{name: f.name, results: f.results, var_params: f.var_params, indirect: f.indirect, captures: f.captures, entry: f.entry, export: f.export, catches: f.catches, reader: f.reader, blocks: [Block{params: ps}], values: pvals}
  var s = S{f: f, fi: fi, file: file}
  if file >= 0 {
    s.f.file = b.file_name(file)
  }
  s.sealed[0] = true
  let saved = b.s
  b.s = s
  saved
}

/// Stores the function built and puts back the state begin replaced.
fn (var b: Builder) end(saved: S) {
  let fi = b.s.fi
  b.m.funcs[fi] = b.s.f
  b.s = saved
}

/// Whether the struct obj declares an invariant (and is not std).
fn (var b: Builder) has_invariant(obj: Int) -> Bool {
  if b.is_std_mod(b.obj_mod(obj)) {
    return false
  }
  !b.invariant_of(obj).is_empty()
}

/// The invariant of struct obj (zero or one expression).
fn (var b: Builder) invariant_of(obj: Int) -> List[Expr] {
  let f = b.c.objs[obj].decl_file
  let i = b.c.objs[obj].decl_idx
  if f < 0 || i < 0 {
    return []
  }
  // through top_decl: a std record file's declaration may be parsed alone
  // (decision 0428), its file's list empty
  match b.c.top_decl(f, i) {
    Some(StructDecl(d)) => {
      if let Some(e) = d.inv {
        return [e]
      }
    }
    _ => {}
  }
  []
}

/// Binds fo's receiver and parameters to the entry block's parameters and
/// records the `var` parameters (paramBindings); the bindings in order (-1
/// for none).
fn (var b: Builder) param_bindings(fo: Int) -> List[Int] {
  var vars: List[Int] = []
  if b.c.objs[fo].recv >= 0 {
    vars.push(b.c.recv_var.get(fo) ?? -1)
  }
  for v in b.c.param_vars.get(fo) ?? [] {
    vars.push(v)
  }
  let ps = b.s.f.blocks[0].params
  for (i, vo) in vars.indexed() {
    if vo >= 0 && i < ps.len() {
      b.write_var(vo, ps[i])
    }
  }
  for i in b.s.f.var_params {
    b.s.var_params.push(vars[i])
  }
  vars
}

/// A checker type in the instance being built (fn.apply).
fn (var b: Builder) apply(t: Int) -> Int {
  if t < 0 {
    return -1
  }
  b.c.subst(t, b.s.sub)
}

/// main returning an error: the program's main becomes main.run, and main
/// calls it and reports an error (mainWrapper).
fn (var b: Builder) main_wrapper(mf: Int, et: Int) {
  b.m.rename_func(mf, "main.run")
  var params: List[Int] = []
  for p in b.m.funcs[mf].blocks[0].params {
    params.push(b.m.funcs[mf].values[p].ty)
  }
  let unit = b.unit_t()
  let fi = b.m.new_func("main", params, [unit])
  let main_fo = b.m.funcs[mf]
  let saved = b.begin(fi, b.decl_file(b.main_fo_of()))
  let ps = b.s.f.blocks[0].params
  let rt = main_fo.results[0]
  let r = b.call("main.run", rt, "", ps)
  let ei = b.m.variant_index(rt, "Err")
  let is_err = b.add(Op.Eq, b.bool_t(), Aux.None, [b.add(Op.Tag, b.int_t(), Aux.None, [r]), b.cint(ei)])
  let (yes, no) = b.branch(is_err)
  let join = b.new_block()
  b.s.cur = yes
  let e = b.add(Op.Payload, b.m.types[rt].variants[ei].fields[0].ty, Aux.P(tag: ei, field: 0), [r])
  let msg = b.append_display(b.const_str("error: "), e, et)
  b.eprintln_rt(msg)
  b.print_trace(b.err_trace(r, ei))
  b.exit_rt(b.cint(1))
  if !b.is_dead() {
    b.jump(join, [])
  }
  b.s.cur = no
  b.jump(join, [])
  b.seal(join)
  b.s.cur = join
  b.retv(b.unit())
  b.finish_fn()
  b.end(saved)
}

fn (var b: Builder) main_fo_of() -> Int {
  b.c.mods[b.main_mod].members.get(b"main") ?? -1
}

/// Whether a user module reads `os.tasks` (build_tasks.go usesOsTasks);
/// with scan_budget, whether one uses budgets (uses_budgets). Every
/// module is scanned, or its answer taken from the module check cache
/// when its check was (compiler/check modcache.xo: its bodies are not
/// checked, so not scanned), and the answers kept for that cache
/// (mod_scans).
fn (var b: Builder) uses_os_tasks() -> Bool {
  var any = false
  for m in b.c.order {
    if b.c.mods[m].is_std || b.c.mods[m].native {
      continue
    }
    let r = match b.c.mod_cached_scan(m) {
      Some((t, bu)) => if b.scan_budget { bu } else { t }
      None => b.mod_uses_tasks(m)
    }
    var sc = b.mod_scans.get(m) ?? (false, false)
    sc = if b.scan_budget { (sc.0, r) } else { (r, sc.1) }
    b.mod_scans[m] = sc
    any = any || r
  }
  any
}

/// uses_os_tasks of module m alone.
fn (var b: Builder) mod_uses_tasks(m: Int) -> Bool {
  if !b.c.mods[m].is_std && !b.c.mods[m].native {
    for f in b.c.mods[m].files {
      for d in b.c.files[f].ast.decls {
        let found = match d {
          FnDecl(d: fd) => {
            var r = false
            for cl in fd.clauses {
              match cl {
                RequiresClause(cond: cond, els: els, ..) => r = r || b.tasks_expr(f, cond) || b.tasks_opt(f, els)
                EnsuresClause(cond: cond, ..) => r = r || b.tasks_expr(f, cond)
                _ => {}
              }
            }
            if let Some(body) = fd.body {
              r = r || b.tasks_block(f, body)
            }
            r
          }
          TestDecl(d: td) => {
            match td.body {
              Some(body) => b.tasks_block(f, body)
              None => false
            }
          }
          ConstDecl(d: cd) => b.tasks_expr(f, cd.value)
          _ => false
        }
        if found {
          return true
        }
      }
    }
  }
  false
}

fn (var b: Builder) tasks_opt(f: Int, e: Expr?) -> Bool {
  match e {
    Some(x) => b.tasks_expr(f, x)
    None => false
  }
}

fn (var b: Builder) tasks_list(f: Int, es: List[Expr]) -> Bool {
  for e in es {
    if b.tasks_expr(f, e) {
      return true
    }
  }
  false
}

fn (var b: Builder) tasks_block(f: Int, bl: parser.Block) -> Bool {
  for st in bl.stmts {
    if b.tasks_stmt(f, st) {
      return true
    }
  }
  false
}

fn (var b: Builder) tasks_stmt(f: Int, st: Stmt) -> Bool {
  match st {
    LetStmt(value: v, ..) => b.tasks_expr(f, v)
    VarStmt(value: v, ..) => b.tasks_expr(f, v)
    AssignStmt(target: t, value: v, ..) => b.tasks_expr(f, t) || b.tasks_expr(f, v)
    DeferStmt(body: body, ..) => b.tasks_stmt(f, body)
    ReturnStmt(value: v, ..) => b.tasks_opt(f, v)
    ForStmt(iter: iter, bound: bound, body: body, ..) => b.tasks_expr(f, iter) || b.tasks_list(f, bound) || b.tasks_block(f, body)
    WhileStmt(cond: cond, value: value, bound: bound, body: body, ..) => b.tasks_opt(f, cond) || b.tasks_list(f, value) || b.tasks_list(f, bound) || b.tasks_block(f, body)
    ExprStmt(x: x, ..) => b.tasks_expr(f, x)
    ConstDecl(d) => b.tasks_expr(f, d.value)
    _ => false
  }
}

/// Whether e holds `x.tasks` on an Os or a test's TestOs
/// (build_tasks.go usesOsTasks).
fn (var b: Builder) tasks_expr(f: Int, e0: Expr) -> Bool {
  // an `else if` chain in a loop (its `else` is the last thing visited),
  // not a call per `if`: the recursion overflowed a browser worker's
  // stack in the wasm build of the compiler (decision 0242)
  var e = e0
  while true {
    let r = match e {
      SelectorExpr(x: x, sel: sel, ..) => {
        if !b.scan_budget && sel.name == b"tasks" {
          var t = b.c.nat_in(f, x)
          if t < 0 {
            t = b.c.type_in(f, x)
          }
          let o = b.named_obj(t)
          if o >= 0 && b.obj_mod(o) >= 0 {
            let om = b.obj_mod(o)
            let n = b.obj_name(o)
            if (b.c.mods[om].is_prelude && n == "Os") || (b.c.mods[om].path == "std/testing" && n == "TestOs") {
              return true
            }
          }
        }
        b.tasks_expr(f, x)
      }
      StringLit(s) => {
        for p in s.parts {
          if b.tasks_opt(f, p.expr) {
            return true
          }
        }
        false
      }
      ParenExpr(x: x, ..) => b.tasks_expr(f, x)
      TupleExpr(elems: elems, ..) => b.tasks_list(f, elems)
      ListLit(elems: elems, ..) => b.tasks_list(f, elems)
      SetLit(elems: elems, ..) => b.tasks_list(f, elems)
      MapLit(entries: entries, ..) => {
        for en in entries {
          if b.tasks_expr(f, en.key) || b.tasks_expr(f, en.value) {
            return true
          }
        }
        false
      }
      StructLit(fields: fields, ..) => {
        for fi in fields {
          if b.tasks_expr(f, fi.value) {
            return true
          }
        }
        false
      }
      UnaryExpr(x: x, ..) => b.tasks_expr(f, x)
      BinaryExpr(x: x, y: y, ..) => b.tasks_expr(f, x) || b.tasks_expr(f, y)
      IsExpr(x: x, ..) => b.tasks_expr(f, x)
      RangeExpr(lo: lo, hi: hi, ..) => b.tasks_opt(f, lo) || b.tasks_opt(f, hi)
      CallExpr(fun: fun, args: args, ..) => {
        if b.scan_budget {
          if let Some(ci) = b.c.call_in(f, e) {
            if b.is_with_budget(ci.fn_obj) {
              return true
            }
          }
        }
        if b.tasks_expr(f, fun) {
          return true
        }
        for a in args {
          if b.tasks_expr(f, a.value) {
            return true
          }
        }
        false
      }
      TypeArgsExpr(x: x, ..) => b.tasks_expr(f, x)
      IndexExpr(x: x, index: index, ..) => b.tasks_expr(f, x) || b.tasks_expr(f, index)
      TryExpr(x: x, ..) => b.tasks_expr(f, x)
      WithExpr(x: x, fields: fields, ..) => {
        if b.tasks_expr(f, x) {
          return true
        }
        for fi in fields {
          if b.tasks_expr(f, fi.value) {
            return true
          }
        }
        false
      }
      IfExpr(x) => {
        if b.tasks_opt(f, x.cond) || b.tasks_opt(f, x.value) || b.tasks_block(f, x.then) {
          return true
        }
        match x.els {
          Some(el) => {
            e = el
            continue
          }
          None => false
        }
      }
      MatchExpr(subject: subject, arms: arms, ..) => {
        if b.tasks_expr(f, subject) {
          return true
        }
        for a in arms {
          if b.tasks_opt(f, a.guard) {
            return true
          }
          if let Some(st) = a.body {
            if b.tasks_stmt(f, st) {
              return true
            }
          }
        }
        false
      }
      ScopeExpr(body: body, ..) => b.tasks_block(f, body)
      SelectExpr(arms: arms, ..) => {
        for a in arms {
          if b.tasks_opt(f, a.op) || b.tasks_opt(f, a.after) {
            return true
          }
          if let Some(st) = a.body {
            if b.tasks_stmt(f, st) {
              return true
            }
          }
        }
        false
      }
      Block(bl) => b.tasks_block(f, bl)
      FnLit(lit) => b.tasks_block(f, lit.body)
      WhileExpr(body: body, ..) => b.tasks_block(f, body)
      _ => false
    }
    return r
  }
  false
}

// ---------------------------------------------------------------------------
// SSA construction (Braun et al.)

fn def_key(vo: Int, bl: Int) -> Int {
  vo * 1048576 + bl
}

fn (var b: Builder) new_block() -> Int {
  b.s.f.new_block()
}

/// A fresh made up variable (local("name")).
fn (var b: Builder) local() -> Int {
  b.nvar += 1
  -1000000 - b.nvar
}

/// Starts an unreachable block for code after a terminator.
fn (var b: Builder) dead() {
  b.s.cur = b.new_block()
  b.s.sealed[b.s.cur] = true
}

fn (var b: Builder) write_var(vo: Int, v: Int) {
  if b.s.pending >= 0 && b.s.f.values[b.s.pending].block == b.s.cur && !b.s.pending_defs.contains(vo) {
    // the landing of the pending operation reads what the variable held
    // before it (flush_landing)
    b.s.pending_defs[vo] = b.s.defs.get(def_key(vo, b.s.cur)) ?? -1
  }
  b.s.defs[def_key(vo, b.s.cur)] = v
  if !b.s.var_type.contains(vo) {
    b.s.var_type[vo] = b.s.f.values[v].ty
  }
  b.debug_bind(vo, v, b.s.line)
}

/// Records that checker local vo holds value v from packed line `line`
/// on (decision 0252): a source variable of the function the first time,
/// and a binding record. Made up variables (negative) and `_` are not
/// source variables.
fn (var b: Builder) debug_bind(vo: Int, v: Int, line: Int) {
  if vo < 0 || vo >= b.c.objs.len() || b.c.objs[vo].kind != check.ObjKind.Local {
    return
  }
  var k = b.s.dvar_of.get(vo) ?? -1
  if k < 0 {
    let o = b.c.objs[vo]
    let name = check.text(o.name)
    if name.is_empty() || name == "_" {
      return
    }
    let col = if o.col > 4095 { 4095 } else { o.col }
    k = b.s.f.dvars.len()
    b.s.f.dvars.push(DVar{name: name, ty: b.s.f.values[v].ty, line: o.line * 4096 + col, param: o.local is "param" | "var-param" | "recv" | "var-recv"})
    b.s.dvar_of[vo] = k
  }
  b.s.f.dbinds.push(DBind{dvar: k, value: v, line: line})
}

fn (var b: Builder) read_var(vo: Int, bl0: Int) -> Int {
  // up a chain of sealed blocks with one predecessor each in a loop,
  // not a call per block: a long function's chains nested the recursion
  // deep enough to overflow a browser worker's stack in the wasm build
  // of the compiler (decision 0242). The blocks passed get the value
  // found, innermost first, as the recursion gave them.
  var chain: List[Int] = []
  var bl = bl0
  var v = -1
  while true {
    if let Some(d) = b.s.defs.get(def_key(vo, bl)) {
      v = d
      break
    }
    if !(b.s.sealed.get(bl) ?? false) {
      v = b.new_param(bl, vo)
      var inc = b.s.incomplete.get(bl) ?? []
      inc.push(v)
      b.s.incomplete[bl] = inc
      b.s.defs[def_key(vo, bl)] = v
      break
    }
    if b.s.f.blocks[bl].preds.len() == 1 {
      chain.push(bl)
      bl = b.s.f.edges[b.s.f.blocks[bl].preds[0]].from
      continue
    }
    v = b.new_param(bl, vo)
    b.s.defs[def_key(vo, bl)] = v
    b.add_args(vo, v)
    b.s.defs[def_key(vo, bl)] = v
    break
  }
  // the value goes to the block the read started in and every 16th block
  // of the chain, so a later read walks at most 16 blocks: an entry per
  // chain block per variable read was 11 s of a 24,000 line function's
  // build, 2026-10-22 (the chain's blocks are sealed with one
  // predecessor, never written again, so no other code looks them up)
  var i = chain.len()
  while i > 0 {
    i -= 1
    if i % 16 == 0 {
      b.s.defs[def_key(vo, chain[i])] = v
    }
  }
  v
}

fn (var b: Builder) new_param(bl: Int, vo: Int) -> Int {
  var t = b.s.var_type.get(vo) ?? -1
  if t < 0 {
    t = b.unit_t()
  }
  let p = b.s.f.add_param(bl, t)
  b.s.param_var[p] = vo
  b.debug_bind(vo, p, 0)
  p
}

/// Fills the argument of parameter p of its block on every incoming edge.
fn (var b: Builder) add_args(vo: Int, p: Int) {
  let bl = b.s.f.values[p].block
  var idx = -1
  for (i, q) in b.s.f.blocks[bl].params.indexed() {
    if q == p {
      idx = i
    }
  }
  for e in b.s.f.blocks[bl].preds {
    let a = b.read_var(vo, b.s.f.edges[e].from)
    while b.s.f.edges[e].args.len() <= idx {
      b.s.f.edges[e].args.push(-1)
    }
    b.s.f.edges[e].args[idx] = a
  }
}

/// Records that every predecessor of bl is known.
fn (var b: Builder) seal(bl: Int) {
  if b.s.sealed.get(bl) ?? false {
    return
  }
  var i = 0
  while i < (b.s.incomplete.get(bl) ?? []).len() {
    let p = (b.s.incomplete.get(bl) ?? [])[i]
    b.add_args(b.s.param_var.get(p) ?? 0, p)
    i += 1
  }
  b.s.incomplete.remove(bl)
  b.s.sealed[bl] = true
}

fn (var b: Builder) read(vo: Int) -> Int {
  b.read_var(vo, b.s.cur)
}

// ---------------------------------------------------------------------------
// Emission helpers

fn (var b: Builder) vty(v: Int) -> Int {
  b.s.f.values[v].ty
}

fn (var b: Builder) vop(v: Int) -> Op {
  b.s.f.values[v].op
}

fn (var b: Builder) tkind(t: Int) -> Kind {
  b.m.types[t].kind
}

fn (var b: Builder) add(op: Op, t: Int, aux: Aux, args0: List[Int]) -> Int {
  if b.s.pending >= 0 {
    b.flush_landing()
  }
  var args = args0
  if op == Op.Variant && t >= 0 && b.tkind(t) == Kind.Enum {
    if let I(tag) = aux {
      if tag < b.m.types[t].variants.len() {
        let fs = b.m.types[t].variants[tag].fields
        if args.len() + 1 == fs.len() && fs[args.len()].name == TRACE_FIELD {
          // a new error has no frames yet
          args.push(b.empty_trace())
        }
      }
    }
  }
  let v = b.s.f.add(b.s.cur, op, t, aux, args)
  b.s.f.values[v].line = b.s.line
  if b.s.any_defer && may_raise(op) {
    if b.s.shield == 0 && b.lexical_cleanup() {
      // its landing is placed when the next instruction comes (the caller
      // sets the position after adding it)
      b.s.pending = v
      b.s.pending_at = b.snapshot()
      b.s.pending_scopes = b.s.scopes
      b.s.pending_defs = {}
      b.s.pending_defer = []
    } else if b.defer_landing_here() {
      // in deferred code: a fault goes on with the cleanup after it
      b.s.pending = v
      b.s.pending_at = b.snapshot()
      b.s.pending_scopes = b.s.scopes
      b.s.pending_defs = {}
      b.s.pending_defer = b.s.defer_land
    }
  }
  v
}

fn (var b: Builder) set_pos(v: Int, pos: Str) {
  b.s.f.values[v].pos = pos
}

fn (var b: Builder) unit() -> Int {
  b.add(Op.Tuple, b.unit_t(), Aux.None, [])
}

fn (var b: Builder) undef(t: Int) -> Int {
  b.add(Op.Undef, t, Aux.None, [])
}

/// A value of type t where a body needs concurrency and the build has
/// none: undef, the build then made again with it (build_program_fe),
/// or with the unwinding checks fixed off (XO_STD_CONC=0, decision 0388:
/// std's object without concurrency, where every std function is a root)
/// a fault, so the body verifies; a program without concurrency never
/// calls it.
fn (var b: Builder) conc_off(t: Int) -> Int {
  if b.fe.conc_fixed == 0 {
    b.fault(b.const_str("concurrency in a build without it (XO_STD_CONC=0)"), "")
    b.dead()
  }
  b.undef(t)
}

/// The value in a Box; other values as they are.
fn (var b: Builder) unbox(v: Int) -> Int {
  let t = b.vty(v)
  if b.tkind(t) != Kind.Box {
    return v
  }
  b.add(Op.Unbox, b.m.types[t].elems[0], Aux.None, [v])
}

fn (var b: Builder) cint(n: Int) -> Int {
  b.add(Op.Const, b.int_t(), Aux.I(n: n), [])
}

fn (var b: Builder) cbool(x: Bool) -> Int {
  b.add(Op.Const, b.bool_t(), Aux.B(b: x), [])
}

fn (var b: Builder) const_str(s: Str) -> Int {
  b.add(Op.Const, b.str_t(), Aux.S(s: s), [])
}

fn (var b: Builder) call(name: Str, t: Int, pos: Str, args: List[Int]) -> Int {
  let v = b.add(Op.Call, t, Aux.S(s: name), args)
  b.set_pos(v, pos)
  v
}

/// A call of the C runtime (`rt.<name>`); t -1 is unit.
fn (var b: Builder) rt(name: Str, t0: Int, args: List[Int]) -> Int {
  var t = t0
  if t < 0 {
    t = b.unit_t()
  }
  if net_rt(name) {
    b.set_flag(2)
  }
  b.add(Op.Call, t, Aux.S(s: "rt.${name}"), args)
}

/// A call of the C runtime (`rt.<name>`) at a source position; t -1 is
/// unit. A lowering that can fault needs it: the native emitters skip a
/// bounds check whose value has no position, since a fault has to name
/// its call site (rt.list_swap's two, 2026-10-26).
fn (var b: Builder) rt_at(name: Str, t: Int, pos: Str, args: List[Int]) -> Int {
  let v = b.rt(name, t, args)
  b.set_pos(v, pos)
  v
}

/// A call of the native prelude's llrt_<name>: runtime text written in
/// Xo (std/native/llrt/text.xo, decision 0193), called where the C
/// runtime's rt.<name> was (fn.llrt).
fn (var b: Builder) llrt(name: Str, t: Int, args: List[Int]) -> Int {
  let impl = b.prelude_impl("llrt_${name}")
  if impl < 0 {
    b.unsupported("the runtime's ${name} without the native prelude")
    return b.undef(t)
  }
  let f = b.declare(impl, [])
  // unchecked, like the C it replaces (fn.llrt)
  b.call(b.m.funcs[f].name, b.m.funcs[f].results[0], "", args)
}

/// Clock.now: the native prelude's llrt_clock_now, which makes the
/// system call from Xo on Linux (std/native/llrt/sysio.xo, decision
/// 0206), or the C runtime's clock_now without the prelude (fn.clockNow).
fn (var b: Builder) clock_now() -> Int {
  let it = b.int_t()
  if b.prelude_impl("llrt_clock_now") < 0 {
    return b.rt("clock_now", it, [])
  }
  b.llrt("clock_now", it, [])
}

/// A call of Rand's name (rand_int, rand_float, rand_bool, rand_bytes):
/// the native prelude's llrt_<name> (std/native/llrt/rand.xo, the zero-C
/// audit's B08); in a WASI module, or without the native prelude, the
/// runtime's rt.<name> (the wasm runtime's random_get).
fn (var b: Builder) rand_rt(name: Str, t: Int, args: List[Int]) -> Int {
  if b.wasm || b.prelude_impl("llrt_${name}") < 0 {
    return b.rt(name, t, args)
  }
  b.llrt(name, t, args)
}

/// A write of the Str s by Stdio's name (print, println, eprint,
/// eprintln): the native prelude's llrt_<name> (std/native/llrt/stdio.xo,
/// the zero-C audit's B03), and true; false in a WASI module (its runtime
/// prints) or without the native prelude, where the caller makes the
/// runtime's call.
fn (var b: Builder) stdio_llrt(name: Str, s: Int) -> Bool {
  if b.wasm {
    return false
  }
  let impl = b.prelude_impl("llrt_${name}")
  if impl < 0 {
    return false
  }
  let f = b.declare(impl, [])
  b.call(b.m.funcs[f].name, b.unit_t(), "", [s])
  true
}

/// msg and a newline on standard error, for the builder's own messages
/// (an error main returned, a fault's trace): stdio_llrt, else the
/// runtime's rt.eprintln.
fn (var b: Builder) eprintln_rt(msg: Int) {
  if !b.stdio_llrt("eprintln", msg) {
    b.rt("eprintln", -1, [msg])
  }
}

/// A call of the native prelude's llrt_<name> with result type t (t -1
/// is unit) in place of the C runtime's rt.<name> (the zero-C audit's
/// B03: std/native/llrt/process.xo and stdio.xo); None in a WASI module
/// (its runtime has its own) or without the native prelude.
fn (var b: Builder) llrt_or_none(name: Str, t0: Int, args: List[Int]) -> Int? {
  if b.wasm {
    return None
  }
  let impl = b.prelude_impl("llrt_${name}")
  if impl < 0 {
    return None
  }
  var t = t0
  if t < 0 {
    t = b.unit_t()
  }
  let f = b.declare(impl, [])
  Some(b.call(b.m.funcs[f].name, t, "", args))
}

/// llrt_or_none, else the C runtime's rt.<name>.
fn (var b: Builder) llrt_or_rt(name: Str, t: Int, args: List[Int]) -> Int {
  if let Some(v) = b.llrt_or_none(name, t, args) {
    return v
  }
  b.rt(name, t, args)
}

/// The end of the process with status code (an Int value): the native
/// prelude's llrt_exit (std/native/llrt/process.xo, the zero-C audit's
/// B03); in a WASI module or without the native prelude the runtime's
/// rt.exit.
fn (var b: Builder) exit_rt(code: Int) {
  if !b.wasm {
    let impl = b.prelude_impl("llrt_exit")
    if impl >= 0 {
      let f = b.declare(impl, [])
      b.call(b.m.funcs[f].name, b.unit_t(), "", [code])
      return
    }
  }
  b.rt("exit", -1, [code])
}

/// A call of std/json's tape reader or text function name (json_str,
/// rs_append_json_str, b64_ok, ...) for the codecs json.xo generates:
/// the native prelude's llrt_<name> (std/native/llrt/jsontext.xo,
/// decision 0193 step 4), unchecked like the C it replaces; the C
/// runtime has no JSON text since decision 0198, so without the native
/// prelude it is unsupported (fn.jsonRT).
fn (var b: Builder) json_rt(name: Str, t: Int, args: List[Int]) -> Int { b.llrt(name, t, args) }

/// A call of the runtime scan name (utf8_valid for Bytes.to_str): the
/// native prelude's llrt_<name> (std/native/llrt/scan.xo, decision 0201),
/// unchecked like the C it replaces; without the native prelude the C
/// runtime's rt.<name> (fn.scanRT).
fn (var b: Builder) scan_rt(name: Str, t: Int, args: List[Int]) -> Int {
  let impl = b.prelude_impl("llrt_${name}")
  if impl >= 0 {
    let f = b.declare(impl, [])
    return b.call(b.m.funcs[f].name, b.m.funcs[f].results[0], "", args)
  }
  b.rt(name, t, args)
}

/// acc + the text of v, an Int or Float (acc < 0: the text alone), for
/// interpolation and Display: the native prelude's llrt_concat_int or
/// llrt_concat_float (std/native/llrt/num.xo, decision 0193 step 3),
/// unchecked like the C it replaces; without the native prelude, or for
/// a Float32, the C runtime's str.concat_int and friends (fn.numText).
fn (var b: Builder) num_text(acc0: Int, v0: Int) -> Int {
  let st = b.str_t()
  var v = v0
  let vt = b.vty(v)
  let k = b.lower_kind(vt)
  let impl = b.prelude_impl("llrt_concat_${k}")
  if impl >= 0 && !b.m.is_f32(vt) {
    var acc = acc0
    if acc < 0 {
      acc = b.const_str("")
    }
    let it = b.int_t()
    if b.tkind(vt) == Kind.Int && vt != it {
      // a sized integer (not UInt64): the same word as an Int
      v = b.add(Op.IntConv, it, Aux.None, [v])
    }
    let f = b.declare(impl, [])
    return b.call(b.m.funcs[f].name, b.m.funcs[f].results[0], "", [acc, v])
  }
  if acc0 < 0 {
    return b.call("str.of_${k}", st, "", [v])
  }
  b.call("str.concat_${k}", st, "", [acc0, v])
}

fn (var b: Builder) jump(to: Int, args: List[Int]) {
  if b.s.pending >= 0 {
    b.flush_landing()
  }
  b.s.f.jump(b.s.cur, to, args)
}

/// Ends the current block with a branch to two new sealed blocks.
fn (var b: Builder) branch(cond: Int) -> (Int, Int) {
  if b.s.pending >= 0 {
    b.flush_landing()
  }
  let yes = b.new_block()
  let no = b.new_block()
  b.s.f.branch(b.s.cur, cond, yes, no)
  b.seal(yes)
  b.seal(no)
  (yes, no)
}

/// Continues in a new block when cond holds, going to fail otherwise.
fn (var b: Builder) test_br(cond: Int, fail: Int) {
  if b.s.pending >= 0 {
    b.flush_landing()
  }
  let ok = b.new_block()
  b.s.f.branch(b.s.cur, cond, ok, fail)
  b.seal(ok)
  b.s.cur = ok
}

fn (var b: Builder) is_dead() -> Bool {
  b.s.cur != 0 && b.s.f.blocks[b.s.cur].preds.is_empty() && (b.s.sealed.get(b.s.cur) ?? false)
}

/// Returns v and the updated `var` parameters (ret).
fn (var b: Builder) ret(v0: Int) {
  b.ret_at(v0, None)
}

/// ret of the value of the expression at (an implicit conversion reads
/// its type).
fn (var b: Builder) ret_at(v0: Int, at: Expr?) {
  let want = b.result_t()
  if b.is_dead() {
    b.add(Op.Unreachable, -1, Aux.None, [])
    b.dead()
    return
  }
  var v = v0
  if b.s.err_t >= 0 {
    if b.vty(v) != want {
      let ok = b.m.variant_index(want, "Ok")
      let c = b.coerce_at(v, b.m.types[want].variants[ok].fields[0].ty, at)
      v = b.add(Op.Variant, want, Aux.I(n: ok), [c])
    }
  } else {
    v = b.coerce_at(v, want, at)
  }
  var args = [v]
  for vo in b.s.var_params {
    args.push(b.read(vo))
  }
  if b.s.pack_var {
    if b.s.pack_orig >= 0 && args.len() == 2 && b.s.err_t >= 0 {
      args[1] = b.packed_value(v, args[1])
    }
    args = [b.add(Op.Tuple, b.s.f.results[0], Aux.None, args)]
  }
  b.exit_to(0)
  b.add(Op.Return, -1, Aux.None, args)
  b.dead()
}

/// The value a packed closure (Map.update) hands back with its result r:
/// the updated value cur when r is a success, the value it was given
/// when r is an error (packedValue).
fn (var b: Builder) packed_value(r: Int, cur: Int) -> Int {
  let rt = b.vty(r)
  let err_i = b.m.variant_index(rt, "Err")
  if cur == b.s.pack_orig || err_i < 0 {
    return cur
  }
  if b.vop(r) == Op.Variant {
    if let I(tag) = b.s.f.values[r].aux {
      if tag == err_i {
        return b.s.pack_orig
      }
    }
    return cur
  }
  let join = b.new_block()
  let res = b.s.f.add_param(join, b.vty(cur))
  let tag = b.add(Op.Tag, b.int_t(), Aux.None, [r])
  let is_err = b.add(Op.Eq, b.bool_t(), Aux.None, [tag, b.cint(err_i)])
  let (yes, no) = b.branch(is_err)
  b.s.cur = yes
  b.jump(join, [b.s.pack_orig])
  b.s.cur = no
  b.jump(join, [cur])
  b.seal(join)
  b.s.cur = join
  res
}

fn (var b: Builder) retv(v: Int) {
  b.add(Op.Return, -1, Aux.None, [v])
  b.dead()
}

/// The check after a call (build_conc.go check): `rt.unwinding` in a
/// program built with unwinding checks, else a check only a fault takes
/// (`rt.landing`); its unwind path leaves the open blocks and scopes.
fn (var b: Builder) check(callee: Str) {
  // a call of a function of the same no allocation module (decision
  // 0207's amendment): the callee keeps the same rule, so it cannot
  // fault, and no check follows (one would give the caller an unwind
  // block, which the rule refuses)
  let p = b.no_alloc_prefix()
  if p != "" && callee.starts_with(p) {
    return
  }
  b.check_then(callee, Cleanup.None)
}

/// check with cleanup code run on the unwind path first (checkThen:
/// unlocking a mutex).
fn (var b: Builder) check_then(callee: Str, cleanup: Cleanup) {
  if b.is_dead() || b.s.shield > 0 {
    return
  }
  // the last instruction, read in place: binding the list would share
  // it, and the next instruction would copy it
  let n = b.s.f.blocks[b.s.cur].instrs.len()
  let w = if n == 0 { -1 } else { b.s.f.blocks[b.s.cur].instrs[n - 1] }
  if b.s.pending == w {
    b.s.pending = -1
  }
  let name = if b.conc { "rt.unwinding" } else { "rt.landing" }
  let u = b.s.f.add(b.s.cur, Op.Call, b.bool_t(), Aux.S(s: name), [])
  if w >= 0 && (b.vop(w) is Op.Call | Op.CallValue) {
    b.s.f.values[w].pad = u
  }
  let (yes, no) = b.branch(u)
  b.s.f.land_rest[no] = true
  b.s.cur = yes
  var c = callee
  match cleanup {
    None => {}
    Unlock(name, h, l) => {
      b.rt(name, -1, [h, l])
      // never removed
      c = ""
    }
  }
  b.unwind()
  b.s.cur = no
  b.checks.push(UCheck{fi: b.s.fi, u: u, callee: c, w: w})
}

/// Ends the current block on the unwind path: the deferred code of the
/// blocks inside the innermost scope runs, then the code jumps to that
/// scope's unwind block (which closes it and goes on), or the function's
/// (build_defer.go unwind).
fn (var b: Builder) unwind() {
  if b.s.shield == 0 && b.s.defer_land.is_empty() {
    // ordinary code: one shared block per open block and its deferred
    // statements (unwind_block); a copy per landing nested deferred code
    // grew one function to 225,753 blocks (progen deferfault seed 8)
    if !b.is_dead() {
      let t = b.unwind_block(b.s.exits)
      b.jump(t, [])
    }
    return
  }
  let saved = b.s.exits
  var i = saved.len() - 1
  while i >= 0 && b.s.frames[saved[i]].sc < 0 && !b.is_dead() {
    b.s.exits = saved[0..i]
    b.run_defers(saved[i])
    i -= 1
  }
  b.s.exits = saved
  if b.is_dead() {
    return
  }
  let t = b.unwind_target()
  b.jump(t, [])
}

/// The block that unwinds ordinary code with the open blocks exits: the
/// innermost block's deferred code, then the unwind block of the blocks
/// around it, down to a scope (its unwind block, unwind_target). Made
/// once per open blocks, their deferred statements and the open scopes
/// (unwind_key), and sealed when the function ends, as fault_cont's: the
/// code reads the variables through its predecessors.
fn (var b: Builder) unwind_block(exits: List[Int]) -> Int {
  var i = exits.len() - 1
  while i >= 0 && b.s.frames[exits[i]].sc < 0 && b.s.frames[exits[i]].stmts.is_empty() {
    i -= 1
  }
  if i < 0 || b.s.frames[exits[i]].sc >= 0 {
    let saved = b.s.exits
    b.s.exits = exits[0..i + 1]
    let t = b.unwind_target()
    b.s.exits = saved
    return t
  }
  let key = b.unwind_key(exits[0..i + 1])
  if let Some(c) = b.s.unwinds.get(key) {
    return c
  }
  if b.s.pending >= 0 {
    b.flush_landing()
  }
  let blk = b.new_block()
  b.s.unwinds[key] = blk
  b.s.conts.push(blk)
  let cur = b.s.cur
  let saved = b.s.exits
  b.s.cur = blk
  b.s.exits = exits[0..i]
  b.run_defers(exits[i])
  if !b.is_dead() {
    let next = b.unwind_block(exits[0..i])
    b.jump(next, [])
  }
  b.s.cur = cur
  b.s.exits = saved
  blk
}

/// The open blocks and scopes as unwind_block tells them apart: each
/// block's scope or its deferred statements (by position, since every
/// landing copies the frames, snapshot), and the open scopes.
fn (b: Builder) unwind_key(exits: List[Int]) -> Str {
  var k = ""
  for e in exits {
    let fr = b.s.frames[e]
    k = k + "|${fr.sc}"
    for d in fr.stmts {
      k = k + ",${d.span.start.offset}"
    }
  }
  k = k + "/"
  for sc in b.s.scopes {
    k = k + "${sc},"
  }
  k
}

/// Emits the function's unwind block: the fault goes on to the caller,
/// and zero results (finishFn).
fn (var b: Builder) finish_fn() {
  b.seal_conts()
  if b.s.unwind_b < 0 {
    return
  }
  let saved = b.s.cur
  b.seal(b.s.unwind_b)
  b.s.cur = b.s.unwind_b
  b.s.f.unwind_exit = b.s.unwind_b
  if !b.s.f.catches {
    // a fault goes on to the caller (decision 0085)
    b.s.f.add(b.s.cur, Op.Call, b.unit_t(), Aux.S(s: "rt.fault_continue"), [])
  }
  var rs: List[Int] = []
  for t in b.s.f.results {
    rs.push(b.zero(t, []))
  }
  if b.s.pack_orig >= 0 {
    // a packed closure hands back the value it was given
    let pt = b.s.f.results[0]
    let z = b.zero(b.m.types[pt].elems[0], [])
    rs = [b.add(Op.Tuple, pt, Aux.None, [z, b.s.pack_orig])]
  }
  b.add(Op.Return, -1, Aux.None, rs)
  b.s.cur = saved
}

fn (var b: Builder) num_fields(t: Int) -> Int {
  if b.tkind(t) == Kind.Struct {
    return b.m.types[t].fields.len()
  }
  b.m.types[t].elems.len()
}

fn (var b: Builder) field_type(t: Int, i: Int) -> Int {
  if b.tkind(t) == Kind.Struct {
    return b.m.types[t].fields[i].ty
  }
  b.m.types[t].elems[i]
}

/// A value of t that owns nothing a caller could not release (zero).
fn (var b: Builder) zero(t: Int, seen: List[Int]) -> Int {
  match b.tkind(t) {
    Unit | Bad => return b.unit()
    Int => return b.add(Op.Const, t, Aux.I(n: 0), [])
    Float => return b.add(Op.Const, t, Aux.F(f: 0.0), [])
    Bool => return b.cbool(false)
    Str => return b.add(Op.Const, t, Aux.S(s: ""), [])
    Cap => return b.add(Op.Cap, t, Aux.S(s: "zero"), [])
    List => return b.rt("rl_empty", t, [])
    Handle => return b.rt("h_zero", t, [])
    Box => {
      let z = b.zero(b.m.types[t].elems[0], seen)
      return b.add(Op.Box, t, Aux.None, [z])
    }
    Func => {
      let name = b.zero_func(t)
      return b.add(Op.Closure, t, Aux.S(s: name), [])
    }
    Struct | Tuple => {
      var vs: List[Int] = []
      for i in 0..b.num_fields(t) {
        vs.push(b.zero(b.field_type(t, i), seen))
      }
      if b.tkind(t) == Kind.Struct {
        return b.add(Op.Struct, t, Aux.None, vs)
      }
      return b.add(Op.Tuple, t, Aux.None, vs)
    }
    Enum => {
      var s2 = seen
      s2.push(t)
      var best = -1
      for (i, v) in b.m.types[t].variants.indexed() {
        var ok = true
        for f in v.fields {
          ok = ok && b.zeroable(f.ty, s2)
        }
        if ok && (best < 0 || v.fields.len() < b.m.types[t].variants[best].fields.len()) {
          best = i
        }
      }
      if best < 0 {
        best = 0
      }
      var vs: List[Int] = []
      for f in b.m.types[t].variants[best].fields {
        vs.push(b.zero(f.ty, s2))
      }
      return b.add(Op.Variant, t, Aux.I(n: best), vs)
    }
  }
}

fn (var b: Builder) zeroable(t: Int, seen: List[Int]) -> Bool {
  match b.tkind(t) {
    Enum => {
      if seen.contains(t) {
        return false
      }
      var s2 = seen
      s2.push(t)
      for v in b.m.types[t].variants {
        var ok = true
        for f in v.fields {
          ok = ok && b.zeroable(f.ty, s2)
        }
        if ok {
          return true
        }
      }
      false
    }
    Struct | Tuple => {
      for i in 0..b.num_fields(t) {
        if !b.zeroable(b.field_type(t, i), seen) {
          return false
        }
      }
      true
    }
    Box => b.zeroable(b.m.types[t].elems[0], seen)
    _ => true
  }
}

/// The function of the zero value of function type t (zeroFunc).
fn (var b: Builder) zero_func(t: Int) -> Str {
  let name = "zero.${b.m.types[t].name}"
  if b.fidx(name) >= 0 {
    return name
  }
  var ps = [t]
  for e in b.m.types[t].elems {
    ps.push(e)
  }
  let fi = b.m.new_func(name, ps, [b.m.types[t].ret])
  b.m.funcs[fi].indirect = true
  b.build_gen(GenJob{fi: fi, file: b.s.file, gen: Gen.Zero(t: t)})
  name
}

/// Raises a fault with message msg at pos (landing.go fault).
fn (var b: Builder) fault(msg: Int, pos: Str) {
  b.rt("fault_raise", -1, [msg, b.const_str(pos)])
  b.add(Op.Unreachable, -1, Aux.None, [])
}

/// Runs then in a block entered when c holds (ifThen).
fn (var b: Builder) if_then_begin(c: Int) -> (Int, Int) {
  let (yes, no) = b.branch(c)
  let join = b.new_block()
  b.s.cur = yes
  (no, join)
}

fn (var b: Builder) if_then_end(no: Int, join: Int) {
  if !b.is_dead() {
    b.jump(join, [])
  }
  b.s.cur = no
  b.jump(join, [])
  b.seal(join)
  b.s.cur = join
}

/// The blocks of `for i in 0..n` (forUpTo): returns i, head, and exit;
/// the body follows in the current block.
fn (var b: Builder) for_up_to_begin(n: Int, iv: Int) -> (Int, Int, Int) {
  b.write_var(iv, b.cint(0))
  let head = b.new_block()
  let inb = b.new_block()
  let exit = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let i = b.read(iv)
  let c = b.add(Op.Lt, b.bool_t(), Aux.None, [i, n])
  b.s.f.branch(b.s.cur, c, inb, exit)
  b.seal(inb)
  b.s.cur = inb
  (i, head, exit)
}

fn (var b: Builder) for_up_to_end(i: Int, iv: Int, head: Int, exit: Int) {
  if !b.is_dead() {
    b.write_var(iv, b.add(Op.Add, b.int_t(), Aux.None, [i, b.cint(1)]))
    b.jump(head, [])
  }
  b.seal(head)
  b.seal(exit)
  b.s.cur = exit
}

/// Declares the generated function name once and builds its body at once
/// (genFunc).
fn (var b: Builder) gen_func(name0: Str, params: List[Int], results: List[Int], g: Gen) -> Str {
  let (name, found) = b.helper_name(name0, params, false)
  if found {
    return name
  }
  let fi = b.m.new_func(name, params, results)
  b.build_gen(GenJob{fi: fi, file: b.s.file, gen: g})
  name
}

/// The name of the generated helper name0 with parameter types (or
/// captures) ts, and whether it exists already: a helper of other types
/// takes name0 with `#2`, `#3`, ... (helperName: helper names hold
/// checker type names, which do not name the module).
fn (var b: Builder) helper_name(name0: Str, ts: List[Int], captures: Bool) -> (Str, Bool) {
  var name = name0
  var i = 2
  while true {
    let fi = b.fidx(name)
    if fi < 0 {
      return (name, false)
    }
    var have: List[Int] = []
    if captures {
      have = b.m.funcs[fi].captures
    } else {
      for p in b.m.funcs[fi].blocks[0].params {
        have.push(b.m.funcs[fi].values[p].ty)
      }
    }
    if have == ts {
      return (name, true)
    }
    name = "${name0}#${i}"
    i += 1
  }
  (name, false)
}

/// Builds the bodies of the generated functions queued so far (and of
/// those they queue). Generated functions are built when asked for
/// (build_gen), as the Go builder's genFunc builds them, so the queue is
/// empty unless a construct queued one.
fn (var b: Builder) run_gens() {
  var i = 0
  while i < b.gens.len() {
    let g = b.gens[i]
    i += 1
    b.build_gen(g)
  }
  b.gens = []
}

/// Builds the body of the generated function g: at once, in the middle
/// of the code that asks for it, as the Go builder's genFunc does (the
/// functions its body declares follow it in the module, in the Go
/// builder's order; decision 0158 compares whole files).
fn (var b: Builder) build_gen(g: GenJob) {
  let saved = b.begin(g.fi, g.file)
  match g.gen {
    Debug(ct, t) => {
      b.debug_body(ct, t)
      b.finish_fn()
    }
    Slice(lt) => {
      b.slice_body(lt)
      b.finish_fn()
    }
    Concat(t) => {
      b.concat_body(t)
      b.finish_fn()
    }
    FrameArgs(names, cts, cap_ts, elided) => b.frame_args_body(names, cts, cap_ts, elided)
    Zero(t) => {
      let z = b.zero(b.m.types[t].ret, [])
      b.add(Op.Return, -1, Aux.None, [z])
    }
    TestFs(memfs, real) => {
      b.test_fs_body(memfs, real)
      b.finish_fn()
    }
  }
  b.end(saved)
}

fn (var b: Builder) param(i: Int) -> Int {
  b.s.f.blocks[0].params[i]
}

// ---------------------------------------------------------------------------
// Paths

/// path relative to root as internal/ssa's file does: relative when it is
/// below root, else as it is (cleaned).
fn rel_path_from(root: Str, path: Str) -> Str {
  if root.is_empty() {
    let parts = path.split("/")
    return parts[parts.len() - 1]
  }
  var p = path
  if p.starts_with("${root}/") {
    p = p.trim_prefix("${root}/")
  }
  while p.starts_with("./") {
    p = p.trim_prefix("./")
  }
  p
}
