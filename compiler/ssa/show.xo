// Display and Debug text (internal/ssa build_show.go), error frames
// (build_frames.go), constants and sized integers (build_int.go).

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/lexer

// ---------------------------------------------------------------------------
// Display and Debug

/// The method name of the named type ct (declared on it, or a std type's
/// native implementation), or -1 (methodOf).
fn (var b: Builder) method_of(ct: Int, name: Str) -> Int {
  let o = b.named_obj(ct)
  if o < 0 {
    return -1
  }
  let m = b.c.objs[o].methods.get(name.bytes()) ?? -1
  if m < 0 {
    let om = b.obj_mod(o)
    if om >= 0 && b.c.mods[om].is_std {
      let nm = b.native_mod(b.c.mods[om].path)
      if nm >= 0 {
        let f = b.member(nm, "${b.obj_name(o).to_lower()}_${name}")
        if f >= 0 && b.c.objs[f].kind == check.ObjKind.Func && b.c.objs[f].recv < 0 {
          return f
        }
      }
    }
    return -1
  }
  if b.is_std_mod(b.obj_mod(m)) {
    return b.impl_of(m)
  }
  m
}

/// Calls method m of the named type ct on v (callMethod).
fn (var b: Builder) call_method(m: Int, ct: Int, v: Int) -> Int {
  let targs = b.ty_args(ct)
  if b.type_params(m).len() != targs.len() {
    b.unsupported("the method `${b.c.display_name(m)}` of `${b.c.show(ct)}`")
    return b.undef(b.typ(b.c.objs[m].result))
  }
  let callee = b.declare(m, targs)
  let name = b.m.funcs[callee].name
  let r = b.call(name, b.m.funcs[callee].results[0], "", [v])
  b.check(name)
  r
}

/// acc + the Display text of v of checker type ct (appendDisplay).
fn (var b: Builder) append_display(acc: Int, v: Int, ct: Int) -> Int {
  let st = b.str_t()
  let vt = b.vty(v)
  if b.is_dyn(vt) {
    return b.call("str.concat", st, "", [acc, b.add(Op.Field, st, Aux.I(n: 0), [v])])
  }
  if b.is_iface(vt) {
    return b.iface_show_call(acc, v, false)
  }
  if b.is_prelude_named(ct, ["Secret"]) {
    return b.call("str.concat", st, "", [acc, b.const_str("<redacted>")])
  }
  if b.is_prelude_named(ct, ["Duration"]) {
    return b.llrt("append_duration", st, [acc, v])
  }
  if b.is_prelude_named(ct, ["Time"]) {
    return b.llrt("append_time", st, [acc, v])
  }
  if b.is_prelude_named(ct, ["Bytes"]) {
    return b.append_debug(acc, v, ct)
  }
  if b.is_prelude_named(ct, ["UInt64"]) {
    return b.show_text("append_u64", acc, v)
  }
  if b.is_prelude_named(ct, ["Rune"]) {
    return b.show_text("append_rune", acc, v)
  }
  match b.tkind(vt) {
    Str => return b.call("str.concat", st, "", [acc, v])
    Int | Float => return b.num_text(acc, v)
    Bool => return b.call("str.concat", st, "", [acc, b.call("str.of_bool", st, "", [v])])
    _ => {}
  }
  let md = b.method_of(ct, "display")
  if md >= 0 {
    let r = b.call_method(md, ct, v)
    return b.call("str.concat", st, "", [acc, r])
  }
  b.append_debug(acc, v, ct)
}

/// acc + the leaf text name (append_rune, append_rune_quote, append_u64)
/// of v, a Rune or UInt64: the native prelude's llrt_<name>
/// (std/native/llrt/show.xo, decision 0193 step 5), unchecked like the C
/// it replaces; without the native prelude, the C runtime's rs_<name>
/// (showText).
fn (var b: Builder) show_text(name: Str, acc: Int, v0: Int) -> Int {
  let impl = b.prelude_impl("llrt_${name}")
  if impl < 0 {
    return b.rt("rs_${name}", b.str_t(), [acc, v0])
  }
  var v = v0
  let it = b.int_t()
  if b.vty(v) != it {
    // the same word as an Int
    v = b.add(Op.IntConv, it, Aux.None, [v])
  }
  let f = b.declare(impl, [])
  b.call(b.m.funcs[f].name, b.m.funcs[f].results[0], "", [acc, v])
}

/// acc + the Debug text of v of checker type ct (appendDebug).
fn (var b: Builder) append_debug(acc: Int, v: Int, ct: Int) -> Int {
  let name = b.debug_func(ct, b.vty(v))
  b.call(name, b.str_t(), "", [acc, v])
}

/// `<chan>`: a type name in lower case without its arguments
/// (lowerName).
fn lower_name(n: Str) -> Str {
  n.split("[")[0].to_lower()
}

/// The Debug text of a sub value x of checker type xt appended to a, in
/// a function under construction (debugFunc's sub).
fn (var b: Builder) debug_sub(a: Int, x0: Int, xt: Int) -> Int {
  let x = b.unbox(x0)
  let name = b.debug_func(xt, b.vty(x))
  b.call(name, b.str_t(), "", [a, x])
}

fn (var b: Builder) lit(a: Int, text: Str) -> Int {
  b.call("str.concat", b.str_t(), "", [a, b.const_str(text)])
}

/// xo.debug[ct](acc: Str, v: T) -> Str: acc and the Debug text of v
/// (debugFunc).
fn (var b: Builder) debug_func(ct: Int, t: Int) -> Str {
  let st = b.str_t()
  let name = "xo.debug[${b.type_name(ct)}]"
  b.gen_func(name, [st, t], [st], Gen.Debug(ct: ct, t: t))
}

fn (var b: Builder) debug_body(ct: Int, t: Int) {
  let st = b.str_t()
  let it = b.int_t()
  let bt = b.bool_t()
  let acc = b.param(0)
  let v = b.param(1)
  if b.is_dyn(t) {
    b.retv(b.dyn_debug(acc, v))
    return
  }
  if b.is_iface(t) {
    b.retv(b.iface_show_call(acc, v, true))
    return
  }
  if b.is_fs(t) {
    b.retv(b.lit(acc, "<fs>"))
    return
  }
  if b.is_lists(t) || b.is_void_cap(t) || b.is_os(t) {
    b.retv(b.lit(acc, "<${lower_name(b.m.types[t].name[3..])}>"))
    return
  }
  let (ok_t, et) = b.result_parts(ct)
  if et >= 0 && b.c.is_never(et) {
    let a = b.lit(acc, "Ok(")
    let s2 = b.debug_sub(a, v, ok_t)
    b.retv(b.lit(s2, ")"))
    return
  }
  if b.is_prelude_named(ct, ["Secret"]) {
    b.retv(b.lit(acc, "<redacted>"))
    return
  }
  if b.is_prelude_named(ct, ["Buf"]) {
    let args = b.ty_args(ct)
    if args.len() == 1 {
      let a = b.lit(acc, "Buf")
      b.retv(b.debug_sub(a, v, b.prelude_type("List", [args[0]])))
      return
    }
  }
  if b.is_prelude_named(ct, ["Duration"]) {
    b.retv(b.llrt("append_duration", st, [acc, v]))
    return
  }
  if b.is_prelude_named(ct, ["Time"]) {
    b.retv(b.llrt("append_time", st, [acc, v]))
    return
  }
  if b.is_prelude_named(ct, ["Bytes"]) {
    let a = b.lit(acc, "b")
    b.retv(b.llrt("append_bytes_quote", st, [a, v]))
    return
  }
  if b.is_prelude_named(ct, ["UInt64"]) {
    b.retv(b.show_text("append_u64", acc, v))
    return
  }
  if b.is_prelude_named(ct, ["Rune"]) {
    b.retv(b.show_text("append_rune_quote", acc, v))
    return
  }
  match b.tkind(t) {
    Str => {
      b.retv(b.llrt("append_quote", st, [acc, v]))
      return
    }
    Int | Float => {
      b.retv(b.num_text(acc, v))
      return
    }
    Bool => {
      let s2 = b.call("str.of_bool", st, "", [v])
      b.retv(b.call("str.concat", st, "", [acc, s2]))
      return
    }
    Unit => {
      b.retv(b.lit(acc, "()"))
      return
    }
    Func => {
      b.retv(b.lit(acc, "<fn>"))
      return
    }
    Cap => {
      b.retv(b.lit(acc, "<${lower_name(b.m.types[t].name)}>"))
      return
    }
    Handle => {
      let r = b.c.resolve(ct)
      if b.is_prelude_named(ct, ["Atomic"]) && b.c.tys[r].kind == check.TyKind.Named && b.c.tys[r].args.len() == 1 {
        // `Atomic(1)`: its value now (std/rt's Atomic.XoDebug)
        let ea = b.c.tys[r].args[0]
        let et = b.typ(ea)
        if b.tkind(et) is Kind.Int | Kind.Bool | Kind.Float {
          let a = b.lit(acc, "Atomic(")
          let g = if b.atomic_xo() {
            b.rt("slot_load", et, [v, b.cint(ATOMIC_SLOT), b.cint(ORD_SEQ_CST)])
          } else {
            b.rt("atomic_get", et, [v])
          }
          let s2 = b.debug_sub(a, g, ea)
          b.retv(b.lit(s2, ")"))
          return
        }
      }
      b.retv(b.lit(acc, "<${lower_name(b.m.types[t].name)}>"))
      return
    }
    Box => {
      b.retv(b.debug_sub(acc, v, ct))
      return
    }
    Tuple => {
      let r = b.c.resolve(ct)
      if b.c.tys[r].kind == check.TyKind.Tuple && b.c.tys[r].args.len() == b.m.types[t].elems.len() {
        var a = b.lit(acc, "(")
        for (i, et2) in b.m.types[t].elems.indexed() {
          if i > 0 {
            a = b.lit(a, ", ")
          }
          let f = b.add(Op.Field, et2, Aux.I(n: i), [v])
          a = b.debug_sub(a, f, b.c.tys[r].args[i])
        }
        b.retv(b.lit(a, ")"))
        return
      }
    }
    Struct | Enum | List | Bad => {}
  }
  let obj = b.named_obj(ct)
  if obj < 0 {
    b.unsupported("the Debug text of `${b.c.show(ct)}`")
    b.retv(acc)
    return
  }
  let args = b.ty_args(ct)
  let om = b.obj_mod(obj)
  let oname = b.obj_name(obj)
  if b.is_prelude_mod(om) && oname == "List" {
    let et2 = b.m.types[t].elems[0]
    let av = b.local()
    b.write_var(av, b.lit(acc, "["))
    let iv = b.local()
    let n = b.call("list.len", it, "", [v])
    let (i, head, exit) = b.for_up_to_begin(n, iv)
    let (no, join) = b.if_then_begin(b.add(Op.Gt, bt, Aux.None, [i, b.cint(0)]))
    b.write_var(av, b.lit(b.read(av), ", "))
    b.if_then_end(no, join)
    let cur = b.read(av)
    let el = b.call("list.index", et2, "", [v, i])
    b.write_var(av, b.debug_sub(cur, el, args[0]))
    b.for_up_to_end(i, iv, head, exit)
    b.retv(b.lit(b.read(av), "]"))
    return
  }
  if b.is_prelude_mod(om) && (oname is "Map" | "Set") {
    let kt = map_key(b.m, t)
    let vt = map_val(b.m, t)
    let (keys, vals, live) = b.map_kvl(t, v)
    let av = b.local()
    let first = b.local()
    let open = if oname == "Set" { "#{" } else { "{" }
    b.write_var(av, b.lit(acc, open))
    b.write_var(first, b.cbool(true))
    let iv = b.local()
    let n = b.call("list.len", it, "", [keys])
    let (i, head, exit) = b.for_up_to_begin(n, iv)
    let (no, join) = b.if_then_begin(b.map_live(live, i))
    let (no2, join2) = b.if_then_begin(b.add(Op.Not, bt, Aux.None, [b.read(first)]))
    b.write_var(av, b.lit(b.read(av), ", "))
    b.if_then_end(no2, join2)
    b.write_var(first, b.cbool(false))
    let cur = b.read(av)
    let k = b.call("list.index", kt, "", [keys, i])
    var a = b.debug_sub(cur, k, args[0])
    if oname == "Map" {
      a = b.lit(a, ": ")
      let x = b.call("list.index", vt, "", [vals, i])
      a = b.debug_sub(a, x, args[1])
    }
    b.write_var(av, a)
    b.if_then_end(no, join)
    b.for_up_to_end(i, iv, head, exit)
    b.retv(b.lit(b.read(av), "}"))
    return
  }
  let sb = b.c.args_subst(b.c.objs[obj].tparams, args)
  let tk = b.c.objs[obj].tkind
  if b.tkind(t) == Kind.Struct && tk == "newtype" && b.m.types[t].fields.len() == 1 {
    let a = b.lit(acc, "${oname}(")
    let f = b.add(Op.Field, b.m.types[t].fields[0].ty, Aux.I(n: 0), [v])
    let a2 = b.debug_sub(a, f, b.c.subst(b.c.objs[obj].target, sb))
    b.retv(b.lit(a2, ")"))
    return
  }
  if b.tkind(t) == Kind.Struct && tk == "struct" {
    if b.c.objs[obj].opaque {
      // its own Debug text (a native implementation's, as `Row(a: 1)`),
      // else its name
      let dm = b.method_of(ct, "debug")
      if dm >= 0 {
        b.retv(b.call("str.concat", b.str_t(), "", [acc, b.call_method(dm, ct, v)]))
        return
      }
      b.retv(b.lit(acc, "<${lower_name(oname)}>"))
      return
    }
    var a = b.lit(acc, "${oname}{")
    for (i, f) in b.c.objs[obj].fields.indexed() {
      if i > 0 {
        a = b.lit(a, ", ")
      }
      a = b.lit(a, "${check.text(f.name)}: ")
      let fi = b.m.field_index(t, check.text(f.name))
      if fi < 0 {
        b.unsupported("the Debug text of `${b.c.show(ct)}`")
        continue
      }
      let fv = b.add(Op.Field, b.m.types[t].fields[fi].ty, Aux.I(n: fi), [v])
      a = b.debug_sub(a, fv, b.c.subst(f.ty, sb))
    }
    b.retv(b.lit(a, "}"))
    return
  }
  if b.tkind(t) == Kind.Enum && tk == "enum" {
    let tag = b.add(Op.Tag, it, Aux.None, [v])
    let is_opt = b.is_prelude_named(ct, ["Option", "Result"])
    for vo in b.c.objs[obj].variants {
      let vname = check.text(vo.name)
      let vi = b.m.variant_index(t, vname)
      if vi < 0 {
        continue
      }
      let (no, join) = b.if_then_begin(b.add(Op.Eq, bt, Aux.None, [tag, b.cint(vi)]))
      if vo.fields.is_empty() {
        b.retv(b.lit(acc, vname))
      } else {
        var a = b.lit(acc, "${vname}(")
        for (fi, f) in vo.fields.indexed() {
          var sep = ""
          if fi > 0 {
            sep = ", "
          }
          if !f.from && !f.name.is_empty() && !is_opt {
            sep = "${sep}${check.text(f.name)}: "
          }
          if !sep.is_empty() {
            a = b.lit(a, sep)
          }
          let ft = b.m.types[t].variants[vi].fields[fi].ty
          let pv = b.add(Op.Payload, ft, Aux.P(tag: vi, field: fi), [v])
          a = b.debug_sub(a, pv, b.c.subst(f.ty, sb))
        }
        b.retv(b.lit(a, ")"))
      }
      b.if_then_end(no, join)
    }
    b.retv(acc)
    return
  }
  b.unsupported("the Debug text of `${b.c.show(ct)}`")
  b.retv(acc)
}

// ---------------------------------------------------------------------------
// Error frames (build_frames.go)

/// The trace of a new error (emptyTrace).
fn (var b: Builder) empty_trace() -> Int {
  let t = b.trace_type()
  let l = b.rt("rl_empty", b.m.types[t].fields[0].ty, [])
  b.s.f.add(b.s.cur, Op.Struct, t, Aux.None, [l])
}

/// The trace of the Err payload of r (tag ei), or a new one (errTrace).
fn (var b: Builder) err_trace(r: Int, ei: Int) -> Int {
  let fs = b.m.types[b.vty(r)].variants[ei].fields
  let n = fs.len()
  if n > 0 && fs[n - 1].name == TRACE_FIELD {
    return b.add(Op.Payload, fs[n - 1].ty, Aux.P(tag: ei, field: n - 1), [r])
  }
  b.empty_trace()
}

/// The named function whose frame a `?` here records, or -1 (frameOwner).
fn (var b: Builder) frame_owner() -> Int {
  var fo = b.s.fo
  if fo < 0 {
    fo = b.s.frame_fo
  }
  if fo < 0 {
    return -1
  }
  let m = b.obj_mod(fo)
  if m < 0 || b.c.mods[m].is_std || b.c.mods[m].native {
    return -1
  }
  fo
}

/// std/rt's frame name of fo (frameName).
fn (var b: Builder) frame_name(fo: Int) -> Str {
  let mn = b.c.mods[b.obj_mod(fo)].name
  let r = b.c.objs[fo].recv
  if r >= 0 {
    return "${mn}.${b.obj_name(r)}.${b.obj_name(fo)}"
  }
  "${mn}.${b.obj_name(fo)}"
}

/// The bindings a frame of fo shows: the receiver and the parameters,
/// without capabilities (frameVars).
fn (var b: Builder) frame_vars(fo: Int) -> List[Int] {
  var vars: List[Int] = []
  if b.c.objs[fo].recv >= 0 {
    vars.push(b.c.recv_var.get(fo) ?? -1)
  }
  for v in b.c.param_vars.get(fo) ?? [] {
    vars.push(v)
  }
  var out: List[Int] = []
  for vo in vars {
    if vo >= 0 && !b.is_capability_type(b.c.objs[vo].ty) {
      out.push(vo)
    }
  }
  out
}

fn (var b: Builder) is_capability_type(t: Int) -> Bool {
  let o = b.named_obj(t)
  if o < 0 || b.obj_mod(o) < 0 {
    return false
  }
  let n = b.obj_name(o)
  if b.c.mods[b.obj_mod(o)].is_prelude {
    if n is "Os" | "Stdio" | "Clock" | "Net" | "Proc" | "Env" | "Fs" | "Rand" {
      return true
    }
  }
  if b.c.mods[b.obj_mod(o)].path == "std/testing" {
    return !test_cap(n).is_empty()
  }
  false
}

/// Trace tr with the frame of the `?` at sp added (pushFrame).
fn (var b: Builder) push_frame(tr: Int, sp: Span) -> Int {
  let fo = b.frame_owner()
  if fo < 0 {
    return tr
  }
  let t = b.trace_type()
  let lt = b.m.types[t].fields[0].ty
  let ft = b.m.types[lt].elems[0]
  var vals: List[Int] = []
  var names: List[Str] = []
  var cts: List[Int] = []
  // --error-args=off (decision 0354; spec 11.1): the frame records the
  // function and the location, and `...` for its parameters
  var fvs = b.frame_vars(fo)
  let elided = !b.error_args_on() && !fvs.is_empty()
  if elided {
    fvs = []
  }
  for vo in fvs {
    if !b.s.var_type.contains(vo) {
      continue
    }
    var ct = b.apply(b.c.objs[vo].ty)
    var v = b.read(vo)
    if b.is_prelude_named(ct, ["Atomic"]) {
      // its Debug text changes in place: taken now
      v = b.append_debug(b.const_str(""), v, ct)
      ct = -1
    }
    names.push(check.text(b.c.objs[vo].name))
    cts.push(ct)
    vals.push(v)
  }
  let fname = b.frame_args_func(names, cts, vals, elided)
  let args = b.add(Op.Closure, b.m.types[ft].elems[2], Aux.S(s: fname), vals)
  var label = b.frame_name(fo)
  for _ in 0..b.s.closures {
    label = "${label}.closure"
  }
  let l1 = b.const_str(label)
  let l2 = b.const_str(b.pos_line(sp))
  let frame = b.add(Op.Tuple, ft, Aux.None, [l1, l2, args])
  let l = b.add(Op.Field, lt, Aux.I(n: 0), [tr])
  let pushed = b.call("list.push", lt, "", [l, frame])
  b.add(Op.Struct, t, Aux.None, [pushed])
}

/// The code of the closure that formats a frame's parameters
/// (frameArgsFunc); its body is built by run_gens.
fn (var b: Builder) frame_args_func(names: List[Str], cts: List[Int], vals: List[Int], elided: Bool) -> Str {
  let st = b.str_t()
  var key: List[Str] = if elided { ["..."] } else { [] }
  var cap_ts: List[Int] = []
  for (i, n) in names.indexed() {
    if cts[i] < 0 {
      key.push("${n}: text")
    } else {
      let impl = b.impl_named(cts[i])
      key.push("${n}: ${b.c.show(impl)}")
    }
    cap_ts.push(b.vty(vals[i]))
  }
  let (name, found) = b.helper_name("xo.frameargs(${key.join(", ")})", cap_ts, true)
  if found {
    return name
  }
  let ft = b.m.func_type([], st)
  let fi = b.m.new_func(name, [ft], [st])
  b.m.funcs[fi].indirect = true
  b.m.funcs[fi].captures = cap_ts
  b.build_gen(GenJob{fi: fi, file: b.s.file, gen: Gen.FrameArgs(names: names, cts: cts, cap_ts: cap_ts, elided: elided)})
  name
}

fn (var b: Builder) frame_args_body(names: List[Str], cts: List[Int], cap_ts: List[Int], elided: Bool) {
  let st = b.str_t()
  let it = b.int_t()
  let env = b.param(0)
  var acc = b.const_str(if elided { "..." } else { "" })
  for (i, n) in names.indexed() {
    var sep = "${n}="
    if i > 0 {
      sep = ", ${sep}"
    }
    acc = b.call("str.concat", st, "", [acc, b.const_str(sep)])
    let v = b.add(Op.Capture, cap_ts[i], Aux.I(n: i), [env])
    var text = v
    if cts[i] >= 0 {
      text = b.append_debug(b.const_str(""), v, cts[i])
    }
    let cut = b.local()
    b.write_var(cut, text)
    let long = b.add(Op.Gt, b.bool_t(), Aux.None, [b.call("Str.len", it, "", [text]), b.cint(64)])
    let (no, join) = b.if_then_begin(long)
    let short = b.llrt_or_rt("str_slice", st, [text, b.cint(0), b.cint(61)])
    b.write_var(cut, b.call("str.concat", st, "", [short, b.const_str("...")]))
    b.if_then_end(no, join)
    acc = b.call("str.concat", st, "", [acc, b.read(cut)])
  }
  b.retv(acc)
  b.finish_fn()
}

/// The rune count of the Str value s: the native prelude's str_rune_count
/// (std/native/llrt/scan.xo's rune_count, zero-C audit B13); without
/// the native prelude (the wasm runtime) rt.str_rune_count.
fn (var b: Builder) rune_count(s: Int) -> Int {
  let it = b.int_t()
  let impl = b.prelude_impl("str_rune_count")
  if b.wasm || impl < 0 {
    return b.rt("str_rune_count", it, [s])
  }
  let f = b.declare(impl, [])
  b.call(b.m.funcs[f].name, it, "", [s])
}

/// Writes the frames of trace tr to standard error (printTrace).
fn (var b: Builder) print_trace(tr: Int) {
  let st = b.str_t()
  let it = b.int_t()
  let bt = b.bool_t()
  let lt = b.m.types[b.vty(tr)].fields[0].ty
  let ft = b.m.types[lt].elems[0]
  let l = b.add(Op.Field, lt, Aux.I(n: 0), [tr])
  let iv = b.local()
  let n = b.call("list.len", it, "", [l])
  let (i, head, exit) = b.for_up_to_begin(n, iv)
  let fr = b.call("list.index", ft, "", [l, i])
  let fv = b.add(Op.Field, b.m.types[ft].elems[2], Aux.I(n: 2), [fr])
  let args = b.add(Op.CallValue, st, Aux.None, [fv])
  b.check("")
  let l0 = b.add(Op.Field, st, Aux.I(n: 0), [fr])
  var label = b.call("str.concat", st, "", [l0, b.const_str("(")])
  label = b.call("str.concat", st, "", [label, args])
  label = b.call("str.concat", st, "", [label, b.const_str(")")])
  let line = b.local()
  let at = b.const_str("  at ")
  b.write_var(line, b.call("str.concat", st, "", [at, label]))
  let c34 = b.cint(34)
  let pad = b.add(Op.Sub, it, Aux.None, [c34, b.rune_count(label)])
  let (no, join) = b.if_then_begin(b.add(Op.Gt, bt, Aux.None, [pad, b.cint(0)]))
  let cur = b.read(line)
  let sp = b.const_str(" ")
  b.write_var(line, b.call("str.concat", st, "", [cur, b.llrt_or_rt("str_repeat", st, [sp, pad])]))
  b.if_then_end(no, join)
  let out = b.call("str.concat", st, "", [b.read(line), b.const_str(" ")])
  let loc = b.add(Op.Field, st, Aux.I(n: 1), [fr])
  b.eprintln_rt(b.call("str.concat", st, "", [out, loc]))
  b.for_up_to_end(i, iv, head, exit)
}

// ---------------------------------------------------------------------------
// Constants and sized integers (build_int.go)

/// Reads the constant c as a value of type t (constValue): a constant of
/// a heap type other than Str, or one whose initializer calls a function
/// (decision 0332), is built once, by a function the runtime calls
/// (xo.const), and read from its list.
fn (var b: Builder) const_value(c: Int, t: Int) -> Int {
  let f = b.c.objs[c].decl_file
  let di = b.c.objs[c].decl_idx
  let value = match b.c.top_decl(f, di) {
    Some(ConstDecl(d)) => d.value
    _ => fault("not a constant, or its tree not parsed (${b.c.files[f].path})")
  }
  if t == b.int_t() {
    // a constant Int expression is one constant, not its operations at
    // every use (MIN_INT = -9223372036854775807 - 1)
    if let Some(n) = b.c.const_int(f, value, 0) {
      return b.add(Op.Const, t, Aux.I(n: n), [])
    }
  }
  if (!b.m.heap(t) || b.tkind(t) == Kind.Str) && b.c.is_compile_time(f, value) {
    return b.foreign_value(value, f, t, b.s.sub)
  }
  // a constant whose initializer runs code (a call) is built once too,
  // whatever its type (decision 0332)
  let it = b.int_t()
  let lt = b.m.list(t)
  let name = "xo.const[${b.mod_prefix(b.obj_mod(c))}.${b.obj_name(c)}]"
  var id = b.consts.get(name) ?? -1
  let made = id < 0
  if made {
    id = b.consts.len()
    b.consts[name] = id
    b.const_names.push(name)
  }
  if b.m.fe_log {
    // the commit numbers it as the build there numbers constants
    b.m.fe_ev.push((6, id))
  }
  if made {
    if id >= 4096 {
      b.unsupported("more than 4096 constants of collection types")
    }
    // an initializer that runs code is built by a function of its own,
    // which the entry function calls under a landing (decision 0332)
    let runs = !b.c.is_compile_time(f, value)
    let body = if runs { "xo.const_body[${b.mod_prefix(b.obj_mod(c))}.${b.obj_name(c)}]" } else { name }
    let fi = b.m.new_func(body, [], [lt])
    b.m.funcs[fi].entry = !runs
    let saved = b.begin(fi, f)
    let v = match b.int_list_data(value, f, t) {
      // a long List[Int] of literals as data, read back by the native
      // prelude's llrt_list_of_le64: nistec's P-256 table was 434 KB of
      // code (LLVM) built element by element, 60 KB as data
      Some(data) => b.llrt("list_of_le64", t, [b.add(Op.Const, b.str_t(), Aux.Bs(b: data), [])])
      None => b.value_as(value, t)
    }
    let l0 = b.call("list.new", lt, "", [])
    let l = b.call("list.push", lt, "", [l0, v])
    // readers on any thread share it
    b.add(Op.Share, -1, Aux.None, [l])
    b.retv(l)
    b.finish_fn()
    b.end(saved)
    if runs {
      b.const_entry(name, body, lt, f)
    }
  }
  let dl = b.drop_list(t)
  // one value for the number: the front end's cache renumbers it
  // (fecache.xo fe_const_ids), the fast path's load included
  let idv = b.cint(id)
  let l = if b.const_fast() {
    b.const_read(lt, name, dl, idv)
  } else {
    let fa = b.add(Op.FuncAddr, it, Aux.S(s: name), [])
    let da = b.add(Op.FuncAddr, it, Aux.S(s: dl), [])
    b.rt("const_once", lt, [fa, da, idv])
  }
  b.call("list.index", t, "", [l, b.cint(0)])
}

/// Whether a constant's read takes const_read's fast path: the native
/// backends and LLVM on arm64 and amd64, not --race (whose readers call
/// sanhook.acquire, consts.once) nor wasm.
fn (b: Builder) const_fast() -> Bool {
  !b.wasm && !b.m.race && (b.goarch is "arm64" | "amd64")
}

/// The services record's static word and its constants table's word
/// (std/native/llrt/ctx.xo SVC and SV_CONSTS / 8), and a slot's state
/// past which it holds a built list (consts.xo FAULTED, read ACQUIRE).
const CONST_SVC_WORD = 16
const CONST_TABLE_WORD = 18
const CONST_FAULTED = 2
const CONST_ACQUIRE = 1

/// A constant's list, read inline when it is built: the services
/// record, its constants table, the constant's slot (consts.once's fast
/// path, without its calls: 2026-10-23, bench/perf/trimchars index read
/// two tables a loop through cabi.const_once, consts.once and table());
/// rt.const_once otherwise (not built yet, being built, or faulted), the
/// addresses of the constant's entry fname and drop function dname made
/// there (2026-10-24: made before the read, they were four instructions
/// every read of a constant, built or not).
fn (var b: Builder) const_read(lt: Int, fname: Str, dname: Str, idv: Int) -> Int {
  let it = b.int_t()
  let bt = b.bool_t()
  let join = b.new_block()
  let res = b.s.f.add_param(join, lt)
  let slow = b.new_block()
  let sw = b.rt("static_word", it, [b.cint(CONST_SVC_WORD)])
  let w = b.rt("mem_load", it, [sw, b.cint(0), b.cint(8)])
  let t = b.rt("slot_load", it, [w, b.cint(CONST_TABLE_WORD), b.cint(CONST_ACQUIRE)])
  let (has, none) = b.branch(b.add(Op.Ne, bt, Aux.None, [t, b.cint(0)]))
  b.s.cur = none
  b.jump(slow, [])
  b.s.cur = has
  let s0 = b.rt("slot_load", it, [t, idv, b.cint(CONST_ACQUIRE)])
  let (built, not) = b.branch(b.add(Op.Gt, bt, Aux.None, [s0, b.cint(CONST_FAULTED)]))
  b.s.cur = not
  b.jump(slow, [])
  b.s.cur = built
  // the same word as a list, a plain load after the acquiring one (a
  // built slot never changes until exit)
  let off = b.add(Op.Mul, it, Aux.None, [idv, b.cint(8)])
  let l = b.rt("mem_load", lt, [t, off, b.cint(8)])
  b.jump(join, [l])
  b.seal(slow)
  b.s.cur = slow
  let fa = b.add(Op.FuncAddr, it, Aux.S(s: fname), [])
  let da = b.add(Op.FuncAddr, it, Aux.S(s: dname), [])
  b.jump(join, [b.rt("const_once", lt, [fa, da, idv])])
  b.seal(join)
  b.s.cur = join
  res
}

/// The entry function name of a constant whose initializer runs code:
/// it calls the builder body and returns its list of one; a fault in it
/// is caught (as task.isolate catches one) and the immortal empty list
/// returned (never dropped),
/// the fault's record left in the context for rt.const_once to store and
/// raise at every read; a cancellation returns the empty list too, the
/// context still unwinding (decision 0332).
fn (var b: Builder) const_entry(name: Str, body: Str, lt: Int, f: Int) {
  let fi = b.m.new_func(name, [], [lt])
  b.m.funcs[fi].entry = true
  let saved = b.begin(fi, f)
  let bt = b.bool_t()
  let r = b.s.f.add(b.s.cur, Op.Call, lt, Aux.S(s: body), [])
  let u = b.s.f.add(b.s.cur, Op.Call, bt, Aux.S(s: "rt.unwinding"), [])
  b.s.f.values[r].pad = u
  let (pad, normal) = b.branch(u)
  b.s.cur = pad
  let caught = b.rt("fault_take", bt, [])
  let (yes, no) = b.branch(caught)
  b.s.cur = yes
  b.retv(b.rt("rl_empty", lt, []))
  b.s.cur = no
  b.retv(b.rt("rl_empty", lt, []))
  b.s.cur = normal
  b.retv(r)
  b.finish_fn()
  b.end(saved)
}

/// The little endian 8 byte words of value when it is a List[Int]
/// literal of at least 64 constant Ints and the native prelude reads such
/// data (llrt_list_of_le64); None otherwise.
fn (var b: Builder) int_list_data(value: Expr, f: Int, t: Int) -> Bytes? {
  if b.tkind(t) != Kind.List || b.m.types[t].elems[0] != b.int_t() || b.prelude_impl("llrt_list_of_le64") < 0 {
    return None
  }
  let elems = match value {
    ListLit(elems: es, ..) => es
    _ => return None
  }
  if elems.len() < 64 {
    return None
  }
  var out = BytesBuilder.with_capacity(8 * elems.len())
  for e in elems {
    let n = match b.c.const_int(f, e, 0) {
      Some(x) => x
      None => return None
    }
    for k in 0..8 {
      out.write_byte(UInt8((n >> (8 * k)) & 255))
    }
  }
  Some(out.freeze())
}

/// The type operands of the runtime calls on sized integers (sizeArgs).
fn (var b: Builder) size_args(t: Int) -> List[Int] {
  var u = 0
  if b.m.types[t].unsigned {
    u = 1
  }
  var bits = b.m.types[t].bits
  if bits == 0 {
    bits = 64
  }
  let a = b.cint(bits)
  let c = b.cint(u)
  [a, c]
}

fn int_op_code(op: lexer.Kind) -> Int {
  match op {
    Plus => 0
    Minus => 1
    Star => 2
    Slash => 3
    Percent => 4
    Shl => 5
    Shr => 6
    _ => -1
  }
}

/// `l op r` on a sized integer type (sizedArith).
fn (var b: Builder) sized_arith(op: lexer.Kind, l: Int, r: Int, sp: Span) -> Int {
  let t = b.vty(l)
  match op {
    Amp => return b.add(Op.And, t, Aux.None, [l, r])
    Pipe => return b.add(Op.Or, t, Aux.None, [l, r])
    Caret => return b.add(Op.Xor, t, Aux.None, [l, r])
    _ => {}
  }
  let code = int_op_code(op)
  if code < 0 {
    b.unsupported("this operator")
    return b.undef(t)
  }
  if b.sized_inline() {
    return b.sized_op(code, l, r, sp)
  }
  var args = [b.cint(code), l, r]
  for a in b.size_args(t) {
    args.push(a)
  }
  args.push(b.const_str(b.pos(sp)))
  b.rt("int_op", t, args)
}

/// `-v` on a sized integer type (sizedNeg).
fn (var b: Builder) sized_neg(v: Int, sp: Span) -> Int {
  let t = b.vty(v)
  if b.sized_inline() {
    return b.sized_op(7, v, b.add(Op.Const, t, Aux.I(n: 0), []), sp)
  }
  var args = [b.cint(7), v, b.cint(0)]
  for a in b.size_args(t) {
    args.push(a)
  }
  args.push(b.const_str(b.pos(sp)))
  b.rt("int_op", t, args)
}

/// Whether sized integer operations are lowered inline, their faults in
/// Xo (std/native/llrt/ints.xo, decisions 0193 and 0195): with the native
/// prelude (sizedInline).
fn (var b: Builder) sized_inline() -> Bool {
  b.prelude_impl("llrt_int_op_fault") >= 0
}

/// A call of the native prelude's llrt_<name> with args: its result
/// (unit when it returns Never; the caller ends the block) (llrtCall).
fn (var b: Builder) llrt_call(name: Str, args: List[Int]) -> Int {
  let f = b.declare(b.prelude_impl("llrt_${name}"), [])
  var t = b.unit_t()
  if b.m.funcs[f].results.len() > 0 {
    t = b.m.funcs[f].results[0]
  }
  b.call(b.m.funcs[f].name, t, "", args)
}

/// The value of v when it is an integer constant, through conversions
/// (constWord).
fn (var b: Builder) const_word(v0: Int) -> (Int, Bool) {
  var v = v0
  while b.vop(v) == Op.IntConv {
    v = b.s.f.values[v].args[0]
  }
  if b.vop(v) != Op.Const {
    return (0, false)
  }
  if let I(n) = b.s.f.values[v].aux {
    return (n, true)
  }
  (0, false)
}

/// The integer v as an Int, the same word (word).
fn (var b: Builder) word(v: Int) -> Int {
  let it = b.int_t()
  if b.vty(v) != it {
    return b.add(Op.IntConv, it, Aux.None, [v])
  }
  v
}

/// a / d (rem: a % d) on the Int word a as UInt64s, d a constant in
/// [2, 2^63): rt.u64_divc, which the backends lower inline (native:
/// isel's u64_divc, a multiply high by a magic number, or the signed
/// division where a's bounds prove it is not negative; LLVM udiv and
/// urem; wasm i64.div_u and i64.rem_u), not ints.u64_div's signed
/// division behind tests of both signs (2026-10-23: portable u64's `h %
/// 4294967291` and `/ 3`, 1.38 times LLVM's instructions).
fn (var b: Builder) u64_div_const(a: Int, d: Int, rem: Bool) -> Int {
  b.rt("u64_divc", b.int_t(), [a, b.cint(d), b.cint(if rem { 1 } else { 0 })])
}

/// `x < y` on two Int words as UInt64s (ult).
fn (var b: Builder) ult(x: Int, y: Int) -> Int {
  let it = b.int_t()
  let fx = b.add(Op.Xor, it, Aux.None, [x, b.cint(-9223372036854775807 - 1)])
  let fy = b.add(Op.Xor, it, Aux.None, [y, b.cint(-9223372036854775807 - 1)])
  b.add(Op.Lt, b.bool_t(), Aux.None, [fx, fy])
}

/// Whether the Int word r is not a value of the narrow integer type t
/// (outOf).
fn (var b: Builder) out_of(r0: Int, t: Int) -> Int {
  let it = b.int_t()
  let bits = b.m.types[t].bits
  var r = r0
  if !b.m.types[t].unsigned {
    r = b.add(Op.Add, it, Aux.None, [r, b.cint(1 << (bits - 1))])
  }
  let sh = b.add(Op.Shr, it, Aux.None, [r, b.cint(bits)])
  b.add(Op.Ne, b.bool_t(), Aux.None, [sh, b.cint(0)])
}

/// Faults when bad holds, with the fault of `l op r` on l's type
/// (ints.op_fault) (sizedFailIf).
fn (var b: Builder) sized_fail_if(bad: Int, code: Int, l: Int, r: Int, sp: Span) {
  let (no, join) = b.if_then_begin(bad)
  var args = [b.cint(code), b.word(l), b.word(r)]
  for a in b.size_args(b.vty(l)) {
    args.push(a)
  }
  args.push(b.const_str(b.pos(sp)))
  b.llrt_call("int_op_fault", args)
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.dead()
  b.if_then_end(no, join)
}

/// `l op r` (code as int_op_code; 7: -l) on a sized integer type, inline:
/// the word operation and xo_int_op's range check (sizedOp).
fn (var b: Builder) sized_op(code: Int, l: Int, r: Int, sp: Span) -> Int {
  let t = b.vty(l)
  let it = b.int_t()
  let bt = b.bool_t()
  let u64 = b.m.is_u64(t)
  let uns = b.m.types[t].unsigned
  let a = b.word(l)
  let c = b.word(r)
  let (kb, bconst) = b.const_word(r)
  let wrap = Aux.S(s: "wrap")
  var res = -1
  if code == 0 || code == 1 {
    let o = if code == 1 { Op.Sub } else { Op.Add }
    if u64 {
      res = b.add(o, it, wrap, [a, c])
      if code == 0 {
        b.sized_fail_if(b.ult(res, a), code, l, r, sp)
      } else {
        b.sized_fail_if(b.ult(a, c), code, l, r, sp)
      }
    } else {
      res = b.add(o, it, Aux.None, [a, c])
      b.sized_fail_if(b.out_of(res, t), code, l, r, sp)
    }
  } else if code == 2 {
    if u64 {
      let hi = b.rt("u64_mul_hi", it, [a, c])
      b.sized_fail_if(b.add(Op.Ne, bt, Aux.None, [hi, b.cint(0)]), code, l, r, sp)
      res = b.add(Op.Mul, it, wrap, [a, c])
    } else {
      if uns {
        // a UInt32 product can pass 2^63: it wraps, and is out of range
        res = b.add(Op.Mul, it, wrap, [a, c])
      } else {
        res = b.add(Op.Mul, it, Aux.None, [a, c])
      }
      b.sized_fail_if(b.out_of(res, t), code, l, r, sp)
    }
  } else if code == 3 || code == 4 {
    if !bconst || kb == 0 {
      b.sized_fail_if(b.add(Op.Eq, bt, Aux.None, [c, b.cint(0)]), code, l, r, sp)
    }
    if u64 && bconst && kb > 1 {
      res = b.u64_div_const(a, kb, code == 4)
    } else if u64 {
      let name = if code == 4 { "u64_rem" } else { "u64_div" }
      res = b.llrt_call(name, [a, c])
    } else if code == 4 {
      res = b.add(Op.Rem, it, Aux.None, [a, c])
    } else {
      res = b.add(Op.Div, it, Aux.None, [a, c])
      if !uns && (!bconst || kb == -1) {
        // the minimum over -1
        b.sized_fail_if(b.out_of(res, t), code, l, r, sp)
      }
    }
  } else if code == 5 || code == 6 {
    let bits = if u64 { 64 } else { b.m.types[t].bits }
    if !bconst || kb < 0 || kb >= bits {
      // c < 0 or c >= bits: c >= bits as UInt64s, one unsigned compare
      // on the native backends (isel.xo unflip) and LLVM (2026-10-19:
      // two compares, two sets, an or, and a test on amd64)
      b.sized_fail_if(b.ult(b.cint(bits - 1), c), code, l, r, sp)
    }
    if code == 6 {
      if u64 {
        res = b.rt("int_wrap", it, [b.cint(4), a, c])
      } else {
        // a narrow unsigned value is not negative
        res = b.add(Op.Shr, it, Aux.None, [a, c])
      }
    } else {
      res = b.add(Op.Shl, it, Aux.None, [a, c])
      if u64 {
        let back = b.rt("int_wrap", it, [b.cint(4), res, c])
        b.sized_fail_if(b.add(Op.Ne, bt, Aux.None, [back, a]), code, l, r, sp)
      } else {
        b.sized_fail_if(b.out_of(res, t), code, l, r, sp)
      }
    }
  } else {
    if uns {
      // only 0 negates
      b.sized_fail_if(b.add(Op.Ne, bt, Aux.None, [a, b.cint(0)]), code, l, r, sp)
      res = b.cint(0)
    } else {
      res = b.add(Op.Sub, it, Aux.None, [b.cint(0), a])
      b.sized_fail_if(b.out_of(res, t), code, l, r, sp)
    }
  }
  b.add(Op.IntConv, t, Aux.None, [res])
}

/// Whether the Int word v is a value of the integer type to (inRange).
fn (var b: Builder) in_range(v: Int, to: Int) -> Int {
  let bt = b.bool_t()
  if b.m.is_u64(to) {
    return b.add(Op.Ge, bt, Aux.None, [v, b.cint(0)])
  }
  // Int64 is the machine word (bits 0, as UInt64 is): every Int value is in
  // its range, so there is no narrow width to mask with. out_of would shift
  // by bits - 1, which is -1 here (Int64.try faults the compiler with
  // "shift amount -1 out of range for Int" without this).
  if b.m.types[to].bits <= 0 {
    return b.add(Op.Eq, bt, Aux.None, [b.cint(0), b.cint(0)])
  }
  b.add(Op.Not, bt, Aux.None, [b.out_of(v, to)])
}

/// Whether the Int word v is a Unicode scalar value (runeValid).
fn (var b: Builder) rune_valid(v: Int) -> Int {
  let it = b.int_t()
  let bt = b.bool_t()
  let neg = b.add(Op.Lt, bt, Aux.None, [v, b.cint(0)])
  let big = b.add(Op.Gt, bt, Aux.None, [v, b.cint(0x10FFFF)])
  let hi = b.add(Op.Shr, it, Aux.None, [v, b.cint(11)])
  let sur = b.add(Op.Eq, bt, Aux.None, [hi, b.cint(27)])
  let o1 = b.add(Op.Or, bt, Aux.None, [neg, big])
  let o2 = b.add(Op.Or, bt, Aux.None, [o1, sur])
  b.add(Op.Not, bt, Aux.None, [o2])
}

/// Faults when bad holds, with the fault of converting v to the integer
/// type to (-1: Rune) (ints.conv_fault) (convFailIf).
fn (var b: Builder) conv_fail_if(bad: Int, v: Int, to: Int, sp: Span) {
  let (no, join) = b.if_then_begin(bad)
  var args = [b.word(v)]
  for a in b.size_args(b.vty(v)) {
    args.push(a)
  }
  if to < 0 {
    args.push(b.cint(0))
    args.push(b.cint(0))
  } else {
    for a in b.size_args(to) {
      args.push(a)
    }
  }
  args.push(b.const_str(b.pos(sp)))
  b.llrt_call("int_conv_fault", args)
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.dead()
  b.if_then_end(no, join)
}

/// `~v` on a sized integer type (sizedNot).
fn (var b: Builder) sized_not(v: Int) -> Int {
  let t = b.vty(v)
  if b.m.types[t].unsigned && b.m.types[t].bits < 64 {
    let mask = (1 << b.m.types[t].bits) - 1
    return b.add(Op.Xor, t, Aux.None, [v, b.add(Op.Const, t, Aux.I(n: mask), [])])
  }
  b.add(Op.Not, t, Aux.None, [v])
}

/// The range of the integer type t: (lo, hi, u64) (intRange).
fn (var b: Builder) int_range(t: Int) -> (Int, Int, Bool) {
  let x = b.m.types[t]
  if x.bits == 0 {
    return (-9223372036854775807 - 1, 9223372036854775807, false)
  }
  if b.m.is_u64(t) {
    return (0, -1, true)
  }
  if x.unsigned {
    return (0, (1 << x.bits) - 1, false)
  }
  (-(1 << (x.bits - 1)), (1 << (x.bits - 1)) - 1, false)
}

fn (var b: Builder) widens(from: Int, to: Int) -> Bool {
  let (flo, fhi, fu) = b.int_range(from)
  let (tlo, thi, tu) = b.int_range(to)
  if tu {
    return flo >= 0
  }
  if fu {
    return false
  }
  flo >= tlo && fhi <= thi
}

/// Converts the integer v to the integer type to (intConv).
fn (var b: Builder) int_conv(v: Int, to: Int, sp: Span) -> Int {
  let from = b.vty(v)
  if from == to {
    return v
  }
  if b.m.types[to].name == "Rune" {
    if b.m.types[from].unsigned && b.m.types[from].bits == 8 {
      return b.add(Op.IntConv, to, Aux.None, [v])
    }
    if b.sized_inline() {
      // a UInt64 at 2^63 or above is a negative word: not valid
      let w = b.word(v)
      let ok = b.rune_valid(w)
      b.conv_fail_if(b.add(Op.Not, b.bool_t(), Aux.None, [ok]), v, -1, sp)
      return b.add(Op.IntConv, to, Aux.None, [w])
    }
    var args = [v]
    for a in b.size_args(from) {
      args.push(a)
    }
    args.push(b.const_str(b.pos(sp)))
    return b.rt("rune_of", to, args)
  }
  if b.widens(from, to) {
    return b.add(Op.IntConv, to, Aux.None, [v])
  }
  if b.sized_inline() {
    let w = b.word(v)
    let bt = b.bool_t()
    var bad = -1
    if b.m.is_u64(to) || b.m.types[to].bits == 0 {
      // a UInt64 from a signed type, or an Int from a UInt64
      bad = b.add(Op.Lt, bt, Aux.None, [w, b.cint(0)])
    } else {
      bad = b.out_of(w, to)
      if b.m.is_u64(from) && !b.m.types[to].unsigned {
        // a UInt64 at 2^63 or above (a negative word) fits no signed type
        let neg = b.add(Op.Lt, bt, Aux.None, [w, b.cint(0)])
        bad = b.add(Op.Or, bt, Aux.None, [neg, bad])
      }
    }
    b.conv_fail_if(bad, v, to, sp)
    return b.add(Op.IntConv, to, Aux.None, [w])
  }
  var args = [v]
  for a in b.size_args(from) {
    args.push(a)
  }
  for a in b.size_args(to) {
    args.push(a)
  }
  args.push(b.const_str(b.pos(sp)))
  b.rt("int_conv", to, args)
}

/// a.min(b) or a.max(b) on a sized integer type (sizedMinMax).
fn (var b: Builder) sized_min_max(name: Str, a: Int, c: Int) -> Int {
  var cmp = -1
  if name == "min" {
    cmp = b.compare(Op.Lt, c, a)
  } else {
    cmp = b.compare(Op.Lt, a, c)
  }
  let join = b.new_block()
  let res = b.s.f.add_param(join, b.vty(a))
  let (yes, no) = b.branch(cmp)
  b.s.cur = yes
  b.jump(join, [c])
  b.s.cur = no
  b.jump(join, [a])
  b.seal(join)
  b.s.cur = join
  res
}
