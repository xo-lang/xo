// `xo vet --cost` (decision 0327): notes on what the compiled program
// does that its source does not show, found in the SSA after insert_rc
// (before inlining): a loop that copies a collection's entries first
// (XO0907), an element counted up and down every iteration (XO0908), a
// value over 8 words captured or wrapped inline (XO0910), a list update
// that may copy the whole list every iteration (XO0909), a small view of a
// parameter's text stored long-lived (XO0911). Notes only, never errors; the driver turns them into vet's
// findings (compiler/xo vetcost.xo).

/// A cost note at a source position of function fn_name.
pub struct CostNote {
  pub code: Str
  pub fn_name: Str
  pub file: Str
  pub line: Int
  pub col: Int
  pub msg: Str
}

/// The notes of every function of m whose file is one of keep (the root
/// module's own, as the checker names them: a function names its file
/// relative to the program's root, so a keep path that ends in it
/// matches), each at keep's name of its file.
pub fn cost_notes(m: Module, keep: List[Str]) -> List[CostNote] {
  var out: List[CostNote] = []
  var nwords: Map[Int, Int] = {}
  for f in m.funcs {
    if f.blocks.is_empty() || f.file.is_empty() {
      continue
    }
    var file = ""
    for k in keep {
      if k == f.file || k.ends_with("/${f.file}") {
        file = k
      }
    }
    if file.is_empty() {
      continue
    }
    let inloop = loop_blocks(f)
    for n in copy_feeds_loop(f, inloop) + elem_count_per_iter(f, inloop) + callback_walks(m, f) + reuse_in_loop(f, inloop) + large_copies(m, f, inloop, nwords) + view_stores(f, inloop) {
      var n2 = n
      n2.file = file
      out.push(n2)
    }
  }
  out
}

/// Whether each block of f is inside a natural loop: the blocks that
/// reach a back edge's source without passing its header, and the header.
fn loop_blocks(f: Func) -> List[Bool] {
  var inl: List[Bool] = []
  for _ in f.blocks {
    inl.push(false)
  }
  let idom = dominators(f)
  for (b, bl) in f.blocks.indexed() {
    if bl.instrs.is_empty() {
      continue
    }
    for e in f.values[bl.instrs[bl.instrs.len() - 1]].succs {
      let h = f.edges[e].to
      if !udom(idom, h, b) {
        continue
      }
      // back edge b -> h: the body is h and what reaches b without h
      inl[h] = true
      var work = [b]
      while !work.is_empty() {
        let x = work.pop() ?? -1
        if x < 0 || inl[x] {
          continue
        }
        inl[x] = true
        for pe in f.blocks[x].preds {
          work.push(f.edges[pe].from)
        }
      }
    }
  }
  inl
}

/// The thunks that copy a collection's entries into fresh lists: a
/// log-mode Map's lists (decision 0291) and its entries.
fn copies_entries(name: Str) -> Bool {
  name.starts_with("xo.maph.logkvl[") || name.starts_with("xo.mlog.each[")
}

/// XO0907: a call that copies a collection's entries whose result a
/// loop reads (each key and value counted up when copied and down after
/// the loop: on a map shared across threads, atomic counts every core
/// fights over).
fn copy_feeds_loop(f: Func, inloop: List[Bool]) -> List[CostNote] {
  var out: List[CostNote] = []
  var users: List[List[Int]] = []
  for _ in f.values {
    users.push([])
  }
  for bl in f.blocks {
    for v in bl.instrs {
      for a in f.values[v].args {
        if a >= 0 && a < users.len() {
          users[a].push(f.values[v].block)
        }
      }
    }
  }
  for ed in f.edges {
    for a in ed.args {
      if a >= 0 && a < users.len() {
        users[a].push(ed.to)
      }
    }
  }
  // a loop that walks its map in place (ssa map.xo for_mlog_root) keeps
  // the copy only for a forked view: its line has an eachpos call
  var walked: Map[Int, Bool] = {}
  for x in f.values {
    if x.op == Op.Call && aux_name(x.aux).starts_with("xo.mlog.eachpos[") {
      walked[x.line / 4096] = true
    }
  }
  var seen: Map[Int, Bool] = {}
  for (vi, x) in f.values.indexed() {
    if x.op != Op.Call || !copies_entries(aux_name(x.aux)) || walked.contains(x.line / 4096) {
      continue
    }
    // the copy, or what carries it (a tuple's fields, a block parameter),
    // read inside a loop
    if !reaches_loop(f, vi, users, inloop) {
      continue
    }
    let line = x.line / 4096
    if line <= 0 || seen.contains(line) {
      continue
    }
    seen[line] = true
    out.push(CostNote{code: "XO0907", fn_name: f.name, file: f.file, line: line, col: x.line % 4096, msg: "this loop copies every entry of the map before it starts (a log-mode map read through a forked view, or a loop body with a closure, a defer, or over 64 nodes): each key and value is counted up and down once per loop, atomically on a map shared across threads; iterate the map directly in a small body, or read the entries once outside an outer loop"})
  }
  out
}

/// Whether value v, or a value made from it (its fields, a block
/// parameter it flows into), is read in a block inside a loop.
fn reaches_loop(f: Func, v: Int, users: List[List[Int]], inloop: List[Bool]) -> Bool {
  var work = [v]
  var seen: Map[Int, Bool] = {}
  while !work.is_empty() {
    let x = work.pop() ?? -1
    if x < 0 || seen.contains(x) {
      continue
    }
    seen[x] = true
    for b in users[x] {
      if b >= 0 && b < inloop.len() && inloop[b] {
        return true
      }
    }
    // the values that take x apart or carry it on
    for (wi, w) in f.values.indexed() {
      if w.op is Op.Field | Op.Rebind && w.args.contains(x) {
        work.push(wi)
      }
    }
    for ed in f.edges {
      for (k, a) in ed.args.indexed() {
        if a == x && k < f.blocks[ed.to].params.len() {
          work.push(f.blocks[ed.to].params[k])
        }
      }
    }
  }
  false
}

/// XO0908: in a loop, an element of a collection made outside it (a
/// list.index, or a field of one) counted up (Retain) for a function
/// value that takes it (its type is the function's result type,
/// fv_arg_owned: decision 0337 borrows the others) and drops it after. An element that a
/// use keeps (a call, a push, a struct, a return: on any path) is a real
/// copy and not reported; a direct call's parameter is borrowed unless
/// the callee keeps it (infer_borrows).
fn elem_count_per_iter(f: Func, inloop: List[Bool]) -> List[CostNote] {
  var out: List[CostNote] = []
  var used_by: List[List[Int]] = []
  for _ in f.values {
    used_by.push([])
  }
  for bl in f.blocks {
    for v in bl.instrs {
      for a in f.values[v].args {
        if a >= 0 && a < used_by.len() {
          used_by[a].push(v)
        }
      }
    }
  }
  var seen: Map[Int, Bool] = {}
  for bl in f.blocks {
    for r in bl.instrs {
      let rx = f.values[r]
      if rx.op != Op.Retain || rx.args.is_empty() || rx.block < 0 || !inloop[rx.block] {
        continue
      }
      let x = rx.args[0]
      if !elem_of_outside(f, x, inloop) {
        continue
      }
      // up and down: a function value's argument, and no use that keeps
      // it (a store on another path retains it too: not a dup and drop).
      // A struct element is retained field by field while the call takes
      // the element: the uses of x and of each value its fields come from
      // (2026-10-22: `for u in xs { t += f(u) }` was not noted)
      var dropped = false
      var stored = false
      var at = x
      var c = x
      while c >= 0 && c < f.values.len() {
        for u in used_by[c] {
          let ux = f.values[u]
          if ux.op == Op.CallValue {
            dropped = true
            if f.values[at].line / 4096 <= 0 {
              // a field the RC pass made has no position: the call's
              at = u
            }
          } else if ux.op == Op.Call && aux_name(ux.aux) != "list.index" && aux_name(ux.aux) != "list.len" || ux.op is Op.Struct | Op.Tuple | Op.Variant | Op.Box | Op.Return | Op.SetField | Op.Closure {
            stored = true
          }
        }
        if f.values[c].op != Op.Field {
          break
        }
        c = f.values[c].args[0]
      }
      if !dropped || stored {
        continue
      }
      let line = f.values[at].line / 4096
      if line <= 0 || seen.contains(line) {
        continue
      }
      seen[line] = true
      out.push(CostNote{code: "XO0908", fn_name: f.name, file: f.file, line: line, col: f.values[at].line % 4096, msg: "each iteration counts this element up and down: it goes to a function value whose result has its type, so the call hands it over (decision 0337; atomically, when the collection is shared across threads); call a named function that only reads it, or hoist the call"})
    }
  }
  out
}

/// The prelude's methods that walk a collection and hand each element to
/// a function value (std/native prelude.xo), with the parameter of the
/// function value that the walk does not give an element (fold's
/// accumulator), else -1. Not sort_by or group_by: their key runs once
/// per element and the sort or the grouping costs more (sort_by over
/// 1000 structs of two strings: +16% against Int fields, 2026-10-22).
fn callback_walk(name: Str) -> (Bool, Int) {
  let base = name.split("[")[0]
  match base {
    "prelude.list_map" | "prelude.list_filter" | "prelude.list_find" | "prelude.list_any" | "prelude.list_all" => (true, -1)
    "prelude.map_filter" | "prelude.map_map" | "prelude.map_any" | "prelude.map_all" | "prelude.set_any" | "prelude.set_all" | "prelude.set_filter" | "prelude.set_map" => (true, -1)
    "prelude.list_fold" => (true, 0)
    _ => (false, -1)
  }
}

/// XO0908 at the call: a prelude method that walks a collection and
/// hands each element to a function value that takes it (an element
/// parameter of the result's type, fv_arg_owned: `xs.map(fn(u: User) ->
/// User { ... })`) counts each element's heap fields up and down per
/// element, as a loop passing elements to such a function value does;
/// the loop is the prelude's, which cost_notes does not read, so the note
/// is at the call. Only when that parameter holds heap memory: since
/// decision 0337 the others are borrowed (`xs.any(fn(u) { ... })`).
fn callback_walks(m: Module, f: Func) -> List[CostNote] {
  var out: List[CostNote] = []
  var seen: Map[Int, Bool] = {}
  for bl in f.blocks {
    for v in bl.instrs {
      let x = f.values[v]
      if x.op != Op.Call {
        continue
      }
      let (walks, acc) = callback_walk(aux_name(x.aux))
      if !walks {
        continue
      }
      var heap = false
      for a in x.args {
        let t = f.values[a].ty
        if t < 0 || t >= m.types.len() || m.types[t].kind != Kind.Func {
          continue
        }
        for (i, p) in m.types[t].elems.indexed() {
          if i != acc && m.heap(p) && fv_arg_owned(m.types, t, i) {
            heap = true
          }
        }
      }
      let line = x.line / 4096
      if !heap || line <= 0 || seen.contains(line) {
        continue
      }
      seen[line] = true
      out.push(CostNote{code: "XO0908", fn_name: f.name, file: f.file, line: line, col: x.line % 4096, msg: "this call counts each element up and down: it hands every element to a function value whose result has the element's type, which takes it (decision 0337; atomically, when the collection is shared across threads); a `for` loop over the collection borrows its elements (decision 0186), or call a named function that only reads them"})
    }
  }
  out
}

/// Whether x is an element of a collection made outside the loop: a
/// list.index (through fields, and through the chunks of a directory)
/// whose root list is defined in a block outside the loop or is a
/// parameter.
fn elem_of_outside(f: Func, x0: Int, inloop: List[Bool]) -> Bool {
  var x = x0
  var elem = false
  while x >= 0 && x < f.values.len() {
    let v = f.values[x]
    if v.op == Op.Field {
      x = v.args[0]
      continue
    }
    if v.op == Op.Call && aux_name(v.aux) == "list.index" && !v.args.is_empty() {
      elem = true
      x = v.args[0]
      continue
    }
    break
  }
  if !elem || x < 0 || x >= f.values.len() {
    return false
  }
  let b = f.values[x].block
  f.values[x].op == Op.Param || b < 0 || !inloop[b]
}

/// XO0909: a list update in a loop whose list a holder made in the same
/// iteration keeps alive, so the Reuse in front of the update (copy
/// unless the count is 1) copies the whole list every iteration: O(n^2)
/// (`snapshots.push(xs)` or `let prev = xs` kept, then `xs.push(...)`).
/// A holder made outside the loop costs one copy, after which the loop's
/// list is unique again; a loop that updates on every iteration has its
/// Reuse hoisted to the loop's entry (rc.xo hoist_reuse). So a note needs
/// a Reuse in a loop block whose list is a loop-carried parameter or made
/// outside the loop, and a Retain of that same list in a loop block (the
/// count insert_rc takes when the list is kept as well as updated).
fn reuse_in_loop(f: Func, inloop: List[Bool]) -> List[CostNote] {
  var out: List[CostNote] = []
  let idom = dominators(f)
  // the loop-carried lists: a parameter of a loop header; its loop's blocks
  var body: Map[Int, List[Bool]] = {}
  var seen: Map[Int, Bool] = {}
  for (vi, x) in f.values.indexed() {
    if x.op != Op.Reuse || x.args.is_empty() || x.block < 0 || !inloop[x.block] {
      continue
    }
    let root = below_fields(f, x.args[0])
    if root < 0 || root >= f.values.len() || f.values[root].op != Op.Param || f.values[root].block < 0 {
      continue
    }
    let h = f.values[root].block
    var inl: List[Bool] = []
    if let Some(c) = body.get(h) {
      inl = c
    } else {
      inl = loop_of(f, idom, h)
      body[h] = inl
    }
    if inl.is_empty() || !inl[x.block] {
      continue
    }
    // a holder made in the loop: the same list counted up in its blocks
    var kept = false
    for y in f.values {
      if y.op == Op.Retain && !y.args.is_empty() && y.block >= 0 && inl[y.block] && below_fields(f, y.args[0]) == root {
        kept = true
      }
    }
    if !kept {
      continue
    }
    // the update call that takes the Reuse: its line is the note's
    for (ui, u) in f.values.indexed() {
      if u.op != Op.Call || u.args.is_empty() || u.args[0] != vi {
        continue
      }
      let line = u.line / 4096
      if line <= 0 || seen.contains(line) || !carried_back(f, root, inl, ui) {
        continue
      }
      seen[line] = true
      out.push(CostNote{code: "XO0909", fn_name: f.name, file: f.file, line: line, col: u.line % 4096, msg: "this list update copies the whole list on every iteration: the list is also kept in this iteration (stored, captured, or bound to a name used after the update), so it is shared when the update runs; update a copy you own, or keep the other holder out of the loop"})
    }
  }
  out
}

/// Whether the result of the update u (or a value made from it by Rebind
/// or Field) is passed back to the header parameter root along an edge of
/// its loop: the loop's own list is the one updated (`xs = xs.push(..)`),
/// not a copy bound to another name (`var c = xs; c[i] = ...`, which
/// copies by the language's meaning).
fn carried_back(f: Func, root: Int, inl: List[Bool], u: Int) -> Bool {
  let h = f.values[root].block
  var k = -1
  for (i, p) in f.blocks[h].params.indexed() {
    if p == root {
      k = i
    }
  }
  if k < 0 {
    return false
  }
  var work = [u]
  var done: Map[Int, Bool] = {}
  while !work.is_empty() {
    let x = work.pop() ?? -1
    if x < 0 || done.contains(x) {
      continue
    }
    done[x] = true
    for e in f.blocks[h].preds {
      let ed = f.edges[e]
      if ed.from >= 0 && inl[ed.from] && k < ed.args.len() && ed.args[k] == x {
        return true
      }
    }
    for (wi, w) in f.values.indexed() {
      if w.op is Op.Rebind | Op.Field && w.args.contains(x) {
        work.push(wi)
      }
    }
  }
  false
}

/// The blocks of the natural loop of header h (its back edges' sources and
/// what reaches them without passing h), empty when h is no loop header.
fn loop_of(f: Func, idom: List[Int], h: Int) -> List[Bool] {
  var inl: List[Bool] = []
  for _ in f.blocks {
    inl.push(false)
  }
  var any = false
  for e in f.blocks[h].preds {
    let b = f.edges[e].from
    if b < 0 || !udom(idom, h, b) {
      continue
    }
    any = true
    inl[h] = true
    var work = [b]
    while !work.is_empty() {
      let x = work.pop() ?? -1
      if x < 0 || inl[x] {
        continue
      }
      inl[x] = true
      for pe in f.blocks[x].preds {
        work.push(f.edges[pe].from)
      }
    }
  }
  if any { inl } else { [] }
}

/// The blocks of f whose terminator is a back edge of a natural loop with
/// Float arithmetic (an Add, Sub, Mul, or Div of a Float) in its body:
/// the LLVM backend marks those loops for full unrolling (decision 0338).
pub fn float_loop_latches(m: Module, f: Func) -> List[Bool] {
  var out: List[Bool] = []
  for _ in f.blocks {
    out.push(false)
  }
  var fl: List[Bool] = []
  for bl in f.blocks {
    var has = false
    for v in bl.instrs {
      let x = f.values[v]
      if x.op is Op.Add | Op.Sub | Op.Mul | Op.Div && m.types[x.ty].kind == Kind.Float {
        has = true
      }
    }
    fl.push(has)
  }
  if !fl.contains(true) {
    return out
  }
  let idom = dominators(f)
  for (h, bl) in f.blocks.indexed() {
    if idom[h] < 0 {
      continue
    }
    let inl = loop_of(f, idom, h)
    if inl.is_empty() {
      continue
    }
    var has = false
    for (b, i) in inl.indexed() {
      if i && fl[b] {
        has = true
      }
    }
    if !has {
      continue
    }
    for e in bl.preds {
      let b = f.edges[e].from
      if b >= 0 && udom(idom, h, b) {
        out[b] = true
      }
    }
  }
  out
}

/// The values over this many words (a cache line) are noted when a
/// closure captures one or an Option or enum value holds one (XO0910).
const LARGE_WORDS = 8

/// The words of a value of type t (compiler/arm64 gen.xo layout, as
/// chainpads.xo's Rc.words), memoized in nw.
fn type_words(m: Module, var nw: Map[Int, Int], t: Int, depth: Int) -> Int {
  if t < 0 || t >= m.types.len() || depth > 64 {
    return 0
  }
  if let Some(n) = nw.get(t) {
    return n
  }
  let x = m.types[t]
  var n = match x.kind {
    Unit | Cap | Struct | Tuple | Enum => 0
    Str | Func => 2
    Int | Float | Bool | List | Box | Handle | Bad => 1
  }
  if x.kind == Kind.Struct {
    for fd in x.fields {
      n += type_words(m, nw, fd.ty, depth + 1)
    }
  } else if x.kind == Kind.Tuple {
    for e in x.elems {
      n += type_words(m, nw, e, depth + 1)
    }
  } else if x.kind == Kind.Enum {
    var w = 0
    for vt in x.variants {
      var k = 0
      for fd in vt.fields {
        k += type_words(m, nw, fd.ty, depth + 1)
      }
      w = w.max(k)
    }
    n = 1 + w
  }
  nw[t] = n
  n
}

/// XO0910: a value over LARGE_WORDS words that the program copies where
/// the source shows no copy: captured by a closure (copied into its
/// environment when the closure is made, each heap field shared), or an
/// element of a list read in a loop wrapped whole in an Option or enum
/// value (`return Some(x)` in a search: copied out of the
/// collection, each heap field shared). Options made from a value built
/// in place (a constructor, a returned record) are not noted: there is
/// nothing to copy from.
fn large_copies(m: Module, f: Func, inloop: List[Bool], var nw: Map[Int, Int]) -> List[CostNote] {
  var out: List[CostNote] = []
  var seen: Map[Int, Bool] = {}
  for bl in f.blocks {
    for v in bl.instrs {
      let x = f.values[v]
      let line = x.line / 4096
      if line <= 0 || seen.contains(line) {
        continue
      }
      var msg = ""
      if x.op == Op.Closure && aux_name(x.aux).starts_with("${f.name}.fn") {
        for a in x.args {
          let t = f.values[a].ty
          let n = type_words(m, nw, t, 0)
          if n > LARGE_WORDS && msg.is_empty() {
            msg = "the closure copies a `${type_label(m, t)}` (${n} words) into its environment when it is made, sharing each of its heap fields; bind the fields the body reads first and capture those"
          }
        }
      } else if x.op == Op.Variant && x.args.len() == 1 && list_elem_in_loop(f, x.args[0], inloop) {
        let n = type_words(m, nw, f.values[x.args[0]].ty, 0)
        if n > LARGE_WORDS {
          msg = "this `${type_label(m, x.ty)}` holds ${n} words inline: making it copies them and shares each heap field of the payload, and every copy of it does again; return or keep what the caller needs (an index, a field) instead"
        }
      }
      if msg.is_empty() {
        continue
      }
      seen[line] = true
      out.push(CostNote{code: "XO0910", fn_name: f.name, file: f.file, line: line, col: x.line % 4096, msg: msg})
    }
  }
  out
}

/// Whether x is an element of a list read in a loop: a list.index (through
/// fields) in a loop block whose list, through fields, is a parameter or
/// is made outside the loop, and is not itself an element (a map's
/// directory chunk: a lookup builds its Option in place).
fn list_elem_in_loop(f: Func, x0: Int, inloop: List[Bool]) -> Bool {
  let x = below_fields(f, x0)
  if x < 0 || x >= f.values.len() {
    return false
  }
  let v = f.values[x]
  if v.op != Op.Call || aux_name(v.aux) != "list.index" || v.args.is_empty() || v.block < 0 || !inloop[v.block] {
    return false
  }
  let l = below_fields(f, v.args[0])
  if l < 0 || l >= f.values.len() {
    return false
  }
  let lv = f.values[l]
  if lv.op == Op.Call && aux_name(lv.aux) == "list.index" {
    return false
  }
  lv.op == Op.Param || lv.block < 0 || !inloop[lv.block]
}

/// The value x is a field (or a field of a field) of, or x.
fn below_fields(f: Func, x0: Int) -> Int {
  var x = x0
  while x >= 0 && x < f.values.len() && f.values[x].op == Op.Field {
    x = f.values[x].args[0]
  }
  x
}

/// The name of type t as notes show it.
fn type_label(m: Module, t: Int) -> Str {
  m.types[t].name
}

/// The calls whose result is a view of their first argument (decision
/// 0330): a slice, and the trims.
fn view_call(name: Str) -> Bool {
  name is "rt.str_view" | "prelude.str_trim" | "prelude.str_trim_start" | "prelude.str_trim_end" | "prelude.str_trim_prefix" | "prelude.str_trim_suffix"
}

/// The value a Field, Rebind, or Payload chain starts from (a Payload: an
/// Option's view unwrapped with ??, 2026-10-23).
fn below_rebinds(f: Func, x0: Int) -> Int {
  var x = x0
  while x >= 0 && x < f.values.len() && f.values[x].op is Op.Field | Op.Rebind | Op.Payload && !f.values[x].args.is_empty() {
    x = f.values[x].args[0]
  }
  x
}

/// Whether x is a view of a parameter's text (decision 0330): a slice or
/// a trim of a parameter, or an element of what the parameter's split or
/// lines made.
fn param_view(f: Func, x: Int) -> Bool { param_view_at(f, x, 0) }

/// A view of a view is a view of the same text (depth bounds the chain).
fn param_text(f: Func, a: Int, depth: Int) -> Bool {
  let r = below_rebinds(f, a)
  r >= 0 && r < f.values.len() && (f.values[r].op == Op.Param || (depth < 8 && param_view_at(f, r, depth + 1)))
}

fn param_view_at(f: Func, x: Int, depth: Int) -> Bool {
  if x < 0 || x >= f.values.len() {
    return false
  }
  let v = f.values[x]
  if v.op != Op.Call || v.args.is_empty() {
    return false
  }
  let name = aux_name(v.aux)
  if view_call(name) {
    return param_text(f, v.args[0], depth)
  }
  if name == "list.index" {
    let l = below_rebinds(f, v.args[0])
    if l < 0 || l >= f.values.len() || f.values[l].op != Op.Call || f.values[l].args.is_empty() {
      return false
    }
    let ln = aux_name(f.values[l].aux)
    if ln is "prelude.str_split" | "prelude.str_split_n" | "prelude.str_split_after" | "prelude.str_split_after_n" | "prelude.str_fields" | "prelude.str_lines" {
      return param_text(f, f.values[l].args[0], depth)
    }
  }
  false
}

/// Whether value x (or what carries it: a struct or variant it is a field
/// of, a collection it is pushed or put into, a block parameter it flows
/// into) is stored long-lived: set as a field, or returned inside a struct
/// or a collection.
fn view_stored(f: Func, x0: Int, users: List[List[Int]]) -> Bool {
  var work = [(x0, false)]
  var seen: Map[Int, Bool] = {}
  while !work.is_empty() {
    let (x, agg) = work.pop() ?? (-1, false)
    if x < 0 || seen.contains(x) {
      continue
    }
    seen[x] = true
    for u in users[x] {
      let w = f.values[u]
      let name = aux_name(w.aux)
      if w.op is Op.Struct | Op.Variant | Op.Box {
        work.push((u, true))
      } else if w.op is Op.Tuple | Op.Rebind {
        work.push((u, agg))
      } else if w.op == Op.Payload {
        // an Option or a Result unwrapped (`view ?? ""`, a view_call's
        // Option): the view itself again, not inside an aggregate (a
        // payload of a nested aggregate is missed, never noted wrongly)
        work.push((u, false))
      } else if w.op == Op.Return {
        if agg {
          return true
        }
      } else if w.op == Op.SetField {
        if w.args.len() >= 2 && w.args[1] == x {
          return true
        }
      } else if w.op == Op.Call && (name == "list.push" || name == "list.set" || name.starts_with("xo.map.put[") || name.starts_with("xo.set.add[")) {
        // the collection now holds x: stored long-lived when it is returned
        // or set in a field (a list used and dropped here is not)
        for (k, a) in w.args.indexed() {
          if k > 0 && a == x {
            work.push((u, true))
          }
        }
      }
    }
    for ed in f.edges {
      for (k, a) in ed.args.indexed() {
        if a == x && k < f.blocks[ed.to].params.len() {
          work.push((f.blocks[ed.to].params[k], agg))
        }
      }
    }
  }
  false
}

/// XO0911: a view of a parameter's text (decision 0330: a slice, a trim, an
/// element of a split or of lines) that is stored long-lived, in a struct
/// field, a collection, or a returned struct: the small view keeps the
/// whole input alive, however large, until the holder is dropped.
fn view_stores(f: Func, inloop: List[Bool]) -> List[CostNote] {
  var users: List[List[Int]] = []
  for _ in f.values {
    users.push([])
  }
  for bl in f.blocks {
    for v in bl.instrs {
      for a in f.values[v].args {
        if a >= 0 && a < users.len() {
          users[a].push(v)
        }
      }
    }
  }
  var out: List[CostNote] = []
  var seen: Map[Int, Bool] = {}
  for (vi, x) in f.values.indexed() {
    let line = x.line / 4096
    // parser-shaped: the view is made in a loop (a tokenizer's slices) or is
    // an element of a split; one slice of an argument (a path, a name) is
    // too common and too small to note
    let tokenizer = x.op == Op.Call && (aux_name(x.aux) == "list.index" || (x.block >= 0 && x.block < inloop.len() && inloop[x.block]))
    if line <= 0 || seen.contains(line) || !tokenizer || !param_view(f, vi) || !view_stored(f, vi, users) {
      continue
    }
    seen[line] = true
    out.push(CostNote{code: "XO0911", fn_name: f.name, file: f.file, line: line, col: x.line % 4096, msg: "this view of a parameter's text is stored long-lived (in a field, a collection, or a returned struct): this keeps the whole input alive; clone() it"})
  }
  out
}
