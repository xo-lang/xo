// Map and Set on the log and fork representation (decision 0291; std/rt
// map.go is the Go backend's, and its soundness argument is this one's),
// behind check.Checker map_log until the switch. A Map[K, V] is the struct
// {kl, vdir, vpar} (decision 0372 stage B): kl the key side
// xo.MapLogK[K], whose functions are one per key type,
//
//   dir     List[List[E]]  the table's entry log in chunks of 8, 16, 32,
//                          ... entries after MLOG_PAD empty slots; the
//                          directory (made with room for MLOG_DIR chunks)
//                          and the chunks never move, so
//                          every value of the table reads what the owner
//                          appends (an index slot can name an entry past a
//                          value's view: its key and prev are read)
//   idx     List[Int]      the table's index (open addressing: a slot is
//                          an own entry's position minus base plus one, 0
//                          empty), [] while the table has at most
//                          MLOG_SMALL keys (they are scanned); shared, its
//                          slots written with rt.slot_store
//   used    List[Int]      one cell: the log length some value claimed
//                          (rt.slot_cas), [] for a map with no table
//   base    Int            the position of the table's first entry
//   n       Int            live keys (field 4, as the lists' form)
//   len     Int            the end of this value's view of the table
//   keys    Int            distinct keys of the table (its owner's count)
//   parents List[Level]    the views this table forked from, nearest first
//
// and vdir the value log (List[List[V]], own entry i's value at i's slot
// and offset of dir: a record appends it after its entry, at the same own
// index; a reader reads a value only of an entry in its own view), vpar
// the value levels (MapVLevel[V] {vdir, lv}: a parent's value log, or a
// lists level's values), one for each of kl's parents in their order;
// with E = MapEntry[K] {h, prev, org, k} (prev: the previous entry
// of k in the table, or -1; org: the position that gives k its place in
// insertion order, -1 for a tombstone) and Level {dir, idx, base, len}.
// A put claims the next position of its table (rt.slot_cas from len to
// len + 1) and appends in place (log.push: the chunk is shared); a value
// that loses the claim (another copy appended first) forks a table whose
// parent is its view, O(1). Forks nest at most MLOG_DEPTH deep; deeper,
// or when overwritten entries and tombstones outnumber live keys, the
// view is flattened into a fresh table.

/// The first chunk's entries; chunk c holds MLOG_CHUNK << c.
const MLOG_CHUNK = 8
/// A table's chunk directory is made with room for this many chunks (8
/// (2^40 - 1) entries) and never grows: every value of the table reads
/// the chunks the owner appends (log.push), as Go's newest log array.
const MLOG_DIR = 40
/// The empty directory slots before the first chunk (its slot is 3: the
/// top bit of 8, mlog_slot8).
const MLOG_PAD = 3
/// A table with at most this many keys has no index (its log is scanned).
const MLOG_SMALL = 8
/// Forks nest at most this deep.
const MLOG_DEPTH = 8
/// The bit that separates a find's level from its position.
const MLOG_LEVEL = 1099511627776
/// rt.slot_* orders (C11's).
const MLOG_ACQ = 1
const MLOG_REL = 2
const MLOG_ACQ_REL = 3

/// The entry type of the key side type t (xo.MapLogK[K]; fields: h, prev,
/// org, k).
fn mlog_entry_of(m: Module, t: Int) -> Int { m.types[m.types[m.types[t].fields[0].ty].elems[0]].elems[0] }

/// The key type of the key side type t.
fn mlog_key(m: Module, t: Int) -> Int { m.types[mlog_entry_of(m, t)].fields[3].ty }

/// The key side type (xo.MapLogK[K]) of the log map type t.
fn mlog_k(m: Module, t: Int) -> Int { m.types[t].fields[0].ty }

/// The value type of the log map type t (its value log's element).
fn mlog_val(m: Module, t: Int) -> Int { m.types[m.types[m.types[t].fields[1].ty].elems[0]].elems[0] }

/// The log representation of Map[k, v] (or Set[k], v unit) named name:
/// the key side xo.MapLogK[K] (mlog_ktype), the value log (vdir, the key
/// side's chunk layout: own entry i's value at the same slot and offset)
/// and the value levels (vpar, one for each of the key side's parents,
/// in its order: a log level's value log, a lists level's values).
fn (var b: Builder) mlog_type(name: Str, k: Int, v: Int) -> Int {
  let (t, created) = b.m.named(name, Kind.Struct)
  if created {
    let kt = b.mlog_ktype(k)
    let vl = b.m.list(v)
    let vd = b.m.list(vl)
    let (vlt, vnew) = b.m.named("xo.MapVLevel[${b.m.types[v].name}]", Kind.Struct)
    if vnew {
      b.m.types[vlt].fields = [SField{name: "vdir", ty: vd}, SField{name: "lv", ty: vl}]
    }
    b.m.types[t].fields = [SField{name: "kl", ty: kt}, SField{name: "vdir", ty: vd}, SField{name: "vpar", ty: b.m.list(vlt)}]
  }
  t
}

/// The key side of the log maps of key type k (decision 0372 stage B):
/// every function of it is one per key type, whatever the value type.
fn (var b: Builder) mlog_ktype(k: Int) -> Int {
  let kn = b.m.types[k].name
  let (t, created) = b.m.named("xo.MapLogK[${kn}]", Kind.Struct)
  if created {
    let it = b.int_t()
    let (et, enew) = b.m.named("xo.MapEntry[${kn}]", Kind.Struct)
    if enew {
      b.m.types[et].fields = [SField{name: "h", ty: it}, SField{name: "prev", ty: it}, SField{name: "org", ty: it}, SField{name: "k", ty: k}]
    }
    let dt = b.m.list(b.m.list(et))
    let il = b.m.list(it)
    let (lv, lnew) = b.m.named("xo.MapLevel[${kn}]", Kind.Struct)
    if lnew {
      b.m.types[lv].fields = [SField{name: "dir", ty: dt}, SField{name: "idx", ty: il}, SField{name: "base", ty: it}, SField{name: "len", ty: it}]
      if b.m.map_branch {
        // a lists level (maphyb.xo maph_fork_lists): a hybrid lists
        // value's keys, live flags, slots and live count, the oldest
        // level of a fork (positions 0 to len; its values are the value
        // level's lv); empty in a log level
        b.m.types[lv].fields = b.m.types[lv].fields + [SField{name: "lk", ty: b.m.list(k)}, SField{name: "ll", ty: b.m.list(b.bool_t())}, SField{name: "ls", ty: il}, SField{name: "ln", ty: it}]
      }
    }
    b.m.types[t].coll = true
    b.m.types[t].fields = [SField{name: "dir", ty: dt}, SField{name: "idx", ty: il}, SField{name: "used", ty: il}, SField{name: "base", ty: it}, SField{name: "n", ty: it}, SField{name: "len", ty: it}, SField{name: "keys", ty: it}, SField{name: "parents", ty: b.m.list(lv)}]
  }
  t
}

fn (var b: Builder) mf(t: Int, i: Int, v: Int) -> Int { b.add(Op.Field, b.m.types[t].fields[i].ty, Aux.I(n: i), [v]) }

fn (var b: Builder) iop(op: Op, x: Int, y: Int) -> Int { b.add(op, b.int_t(), Aux.None, [x, y]) }

fn (var b: Builder) iwrap(op: Op, x: Int, y: Int) -> Int { b.add(op, b.int_t(), Aux.S(s: "wrap"), [x, y]) }

fn (var b: Builder) bop(op: Op, x: Int, y: Int) -> Int { b.add(op, b.bool_t(), Aux.None, [x, y]) }

/// The directory slot and offset of own entry i (i >= 0): slot c (c >= 3,
/// the directory's first MLOG_PAD slots are empty) holds the 2^c entries
/// [2^c - 8, 2^(c+1) - 8).
fn (var b: Builder) mlog_slot(i: Int) -> (Int, Int) {
  b.mlog_slot8(b.iop(Op.Add, i, b.cint(MLOG_CHUNK)))
}

/// mlog_slot of j - 8: the slot is j's top bit and the offset j without
/// it (five operations, so the inlined xo.mlog.find stays small).
fn (var b: Builder) mlog_slot8(j: Int) -> (Int, Int) {
  let it = b.int_t()
  let top = b.iop(Op.Sub, b.cint(63), b.rt("clz", it, [j]))
  (top, b.iop(Op.Xor, j, b.iop(Op.Shl, b.cint(1), top)))
}

/// A new chunk directory: room for MLOG_DIR chunks after MLOG_PAD empty
/// slots (so an entry's slot is its position's top bit, mlog_slot8),
/// made by xo.mlog.newdir: a call's result has no known length in the
/// caller, where log.push then grows it in place (built inline, the
/// pushes' known length 3 held in the flatten's loop and a chunk went in
/// the wrong slot on arm64; gotchas/arm64-list-length-cache-in-place-growth.md).
fn (var b: Builder) mlog_newdir(dt: Int) -> Int {
  let name = "xo.mlog.newdir[${b.m.types[dt].name}]"
  let fi = b.thunk_func(name, [], [dt], [])
  if fi >= 0 {
    let saved = b.begin(fi, b.s.file)
    let el = b.m.types[dt].elems[0]
    var d = b.call("list.new", dt, "", [b.cint(MLOG_DIR + MLOG_PAD)])
    for _ in 0..MLOG_PAD {
      // the shared empty list: list.new with a size allocates
      d = b.call("list.push", dt, "", [d, b.call("list.new", el, "", [])])
    }
    b.retv(d)
    b.finish_fn()
    b.end(saved)
  }
  b.call(name, dt, "", [])
}

/// Own entry i of the log dir.
fn (var b: Builder) mlog_at(et: Int, dir: Int, i: Int) -> Int {
  let (c, off) = b.mlog_slot(i)
  let chunk = b.call("list.index", b.m.types[b.vty(dir)].elems[0], "", [dir, c])
  b.call("list.index", et, "", [chunk, off])
}

/// A log level of key level type lvt: dir, idx, base, len, and with
/// map_branch an empty lists part.
fn (var b: Builder) mlog_level(lvt: Int, dir: Int, idx: Int, base: Int, lim: Int) -> Int {
  var fs = [dir, idx, base, lim]
  if b.m.map_branch {
    for i in 4..7 {
      fs.push(b.call("list.new", b.m.types[lvt].fields[i].ty, "", []))
    }
    fs.push(b.cint(0))
  }
  b.add(Op.Struct, lvt, Aux.None, fs)
}

/// Whether level lvl (of type lvt) is a lists level (map_branch).
fn (var b: Builder) mlog_lvl_lists(lvt: Int, lvl: Int) -> Int {
  b.bop(Op.Gt, b.call("list.len", b.int_t(), "", [b.add(Op.Field, b.m.types[lvt].fields[4].ty, Aux.I(n: 4), [lvl])]), b.cint(0))
}

/// The entry at own index i of level lvl (of type lvt) of key side type
/// t: its log's, or for a lists level one made from the lists (no hash,
/// no prev, its own origin when live, else a removal's -1).
fn (var b: Builder) mlog_lvl_at(t: Int, lvt: Int, lvl: Int, i: Int) -> Int {
  let et = mlog_entry_of(b.m, t)
  let dir = b.add(Op.Field, b.m.types[lvt].fields[0].ty, Aux.I(n: 0), [lvl])
  if !b.m.map_branch {
    return b.mlog_at(et, dir, i)
  }
  let lf = b.m.types[lvt].fields
  let join = b.new_block()
  let res = b.s.f.add_param(join, et)
  let (ls, lg) = b.branch(b.mlog_lvl_lists(lvt, lvl))
  b.s.cur = ls
  let orgv = b.local()
  b.write_var(orgv, b.cint(-1))
  let (nl, jl) = b.if_then_begin(b.call("list.index", b.bool_t(), "", [b.add(Op.Field, lf[5].ty, Aux.I(n: 5), [lvl]), i]))
  b.write_var(orgv, i)
  b.if_then_end(nl, jl)
  let k = b.call("list.index", mlog_key(b.m, t), "", [b.add(Op.Field, lf[4].ty, Aux.I(n: 4), [lvl]), i])
  b.jump(join, [b.add(Op.Struct, et, Aux.None, [b.cint(0), b.cint(-1), b.read(orgv), k])])
  b.s.cur = lg
  b.jump(join, [b.mlog_at(et, dir, i)])
  b.seal(join)
  b.s.cur = join
  res
}

/// The value at own index i of the level of key level lvl (type lvt) and
/// value level vlvl (type vlt), of value type vt: its value log's, or a
/// lists level's value.
fn (var b: Builder) mlog_vlvl_at(vt: Int, lvt: Int, lvl: Int, vlt: Int, vlvl: Int, i: Int) -> Int {
  let vf = b.m.types[vlt].fields
  let vdir = b.add(Op.Field, vf[0].ty, Aux.I(n: 0), [vlvl])
  if !b.m.map_branch {
    return b.mlog_at(vt, vdir, i)
  }
  let join = b.new_block()
  let res = b.s.f.add_param(join, vt)
  let (ls, lg) = b.branch(b.mlog_lvl_lists(lvt, lvl))
  b.s.cur = ls
  b.jump(join, [b.call("list.index", vt, "", [b.add(Op.Field, vf[1].ty, Aux.I(n: 1), [vlvl]), i])])
  b.s.cur = lg
  b.jump(join, [b.mlog_at(vt, vdir, i)])
  b.seal(join)
  b.s.cur = join
  res
}

/// xo.mlog.lprobe[T](keys, live, slots, k, h) -> Int: k's live entry in a
/// lists level (the lists' find: slots by h, linear probing, dead entries
/// skipped; a scan with no slots), or -1.
fn (var b: Builder) mlog_lprobe(t: Int, lvt: Int) -> Str {
  let it = b.int_t()
  let kt = mlog_key(b.m, t)
  let lf = b.m.types[lvt].fields
  let name = "xo.mlog.lprobe[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [lf[4].ty, lf[5].ty, lf[6].ty, kt, it], [it], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let keys = b.param(0)
  let live = b.param(1)
  let slots = b.param(2)
  let k = b.param(3)
  let h = b.param(4)
  let n = b.call("list.len", it, "", [slots])
  let (ns, js) = b.if_then_begin(b.bop(Op.Eq, n, b.cint(0)))
  let sv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(b.call("list.len", it, "", [keys]), sv)
  let (nk, jk) = b.if_then_begin(b.add(Op.And, b.bool_t(), Aux.None, [b.call("list.index", b.bool_t(), "", [live, i]), b.eq_values(b.call("list.index", kt, "", [keys, i]), k)]))
  b.retv(i)
  b.if_then_end(nk, jk)
  b.for_up_to_end(i, sv, ih, ix)
  b.retv(b.cint(-1))
  b.if_then_end(ns, js)
  let mask = b.iop(Op.Sub, n, b.cint(1))
  let pv = b.local()
  b.write_var(pv, b.iop(Op.And, h, mask))
  let head = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let p = b.read(pv)
  let sl = b.call("list.index", it, "", [slots, p])
  let (ne, je) = b.if_then_begin(b.bop(Op.Eq, sl, b.cint(0)))
  b.retv(b.cint(-1))
  b.if_then_end(ne, je)
  let j = b.iop(Op.Sub, sl, b.cint(1))
  let (nh, jh) = b.if_then_begin(b.call("list.index", b.bool_t(), "", [live, j]))
  let (nq, jq) = b.if_then_begin(b.eq_values(b.call("list.index", kt, "", [keys, j]), k))
  b.retv(j)
  b.if_then_end(nq, jq)
  b.if_then_end(nh, jh)
  b.write_var(pv, b.iop(Op.And, b.iop(Op.Add, p, b.cint(1)), mask))
  b.jump(head, [])
  b.seal(head)
  b.dead()
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.finish_fn()
  b.end(saved)
  name
}

/// The home slot of hash h in an index of n slots (a power of two): its
/// low bits, as the lists' table (hash_func mixes its keys already).
fn (var b: Builder) mlog_home(h: Int, n: Int) -> Int { b.iop(Op.And, h, b.iop(Op.Sub, n, b.cint(1))) }

/// xo.mlog.probe[T](dir, idx, base, L, k, h) -> (slot, j): in the table
/// (dir, idx, base), the newest own entry of k below L (j, or -1) and the
/// slot of k in idx (its slot, or the empty one where it would go; -1 with
/// no index, when the log is scanned).
fn (var b: Builder) mlog_probe(t: Int) -> Str {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let kt = mlog_key(b.m, t)
  let rt = b.m.tuple([it, it])
  let name = "xo.mlog.probe[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [b.m.types[t].fields[0].ty, b.m.types[t].fields[1].ty, it, it, kt, it], [rt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let dir = b.param(0)
  let idx = b.param(1)
  let base = b.param(2)
  let lim = b.param(3)
  let k = b.param(4)
  let h = b.param(5)
  let n = b.call("list.len", it, "", [idx])
  let (no, join) = b.if_then_begin(b.bop(Op.Eq, n, b.cint(0)))
  // no index: the log scanned from its end
  let iv = b.local()
  b.write_var(iv, b.iop(Op.Sub, lim, b.cint(1)))
  let head = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let i = b.read(iv)
  let (miss, more) = b.if_then_begin(b.bop(Op.Lt, i, base))
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.cint(-1), b.cint(-1)]))
  b.if_then_end(miss, more)
  // the keys alone: a table with no index keeps no hashes (0, mlog_hash_if)
  let e = b.mlog_at(et, dir, b.iop(Op.Sub, i, base))
  let (n2, j2) = b.if_then_begin(b.eq_values(b.add(Op.Field, kt, Aux.I(n: 3), [e]), k))
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.cint(-1), i]))
  b.if_then_end(n2, j2)
  b.write_var(iv, b.iop(Op.Sub, i, b.cint(1)))
  b.jump(head, [])
  b.seal(head)
  b.dead()
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.if_then_end(no, join)
  // the index: the newest own entry of k, then back to below L
  let pv = b.local()
  b.write_var(pv, b.mlog_home(h, n))
  let head2 = b.new_block()
  b.jump(head2, [])
  b.s.cur = head2
  let p = b.read(pv)
  let s = b.rt("slot_load", it, [idx, p, b.cint(MLOG_ACQ)])
  let (ne, je) = b.if_then_begin(b.bop(Op.Eq, s, b.cint(0)))
  b.retv(b.add(Op.Tuple, rt, Aux.None, [p, b.cint(-1)]))
  b.if_then_end(ne, je)
  let pos = b.iop(Op.Add, base, b.iop(Op.Sub, s, b.cint(1)))
  let e2 = b.mlog_at(et, dir, b.iop(Op.Sub, pos, base))
  let (n3, j3) = b.if_then_begin(b.bop(Op.Eq, b.add(Op.Field, it, Aux.I(n: 0), [e2]), h))
  let (n4, j4) = b.if_then_begin(b.eq_values(b.add(Op.Field, kt, Aux.I(n: 3), [e2]), k))
  // follow prev below the view's end
  let jv = b.local()
  b.write_var(jv, pos)
  let head3 = b.new_block()
  let done3 = b.new_block()
  b.jump(head3, [])
  b.s.cur = head3
  let j = b.read(jv)
  let above = b.bop(Op.Ge, j, lim)
  let step = b.new_block()
  b.s.f.branch(b.s.cur, above, step, done3)
  b.seal(step)
  b.s.cur = step
  let ej = b.mlog_at(et, dir, b.iop(Op.Sub, j, base))
  b.write_var(jv, b.add(Op.Field, it, Aux.I(n: 1), [ej]))
  b.jump(head3, [])
  b.seal(head3)
  b.seal(done3)
  b.s.cur = done3
  b.retv(b.add(Op.Tuple, rt, Aux.None, [p, b.read(jv)]))
  b.if_then_end(n4, j4)
  b.if_then_end(n3, j3)
  b.write_var(pv, b.iop(Op.And, b.iop(Op.Add, p, b.cint(1)), b.iop(Op.Sub, n, b.cint(1))))
  b.jump(head2, [])
  b.seal(head2)
  b.dead()
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.finish_fn()
  b.end(saved)
  name
}

/// The newest own entry of k below lim in the table (dir, idx, base), or
/// -1, emitted inline (xo.mlog.probe without the slot): find's path for
/// a map with no parents.
fn (var b: Builder) mlog_probe_j(t: Int, dir: Int, idx: Int, base: Int, lim: Int, k: Int, h: Int) -> Int {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let kt = mlog_key(b.m, t)
  let join = b.new_block()
  let res = b.s.f.add_param(join, it)
  let n = b.call("list.len", it, "", [idx])
  let (scan, indexed) = b.branch(b.bop(Op.Eq, n, b.cint(0)))
  // no index: the log scanned from its end
  b.s.cur = scan
  let iv = b.local()
  b.write_var(iv, b.iop(Op.Sub, lim, b.cint(1)))
  let head = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let i = b.read(iv)
  let (miss, more) = b.branch(b.bop(Op.Lt, i, base))
  b.s.cur = miss
  b.jump(join, [b.cint(-1)])
  b.s.cur = more
  let e = b.mlog_at(et, dir, b.iop(Op.Sub, i, base))
  // the keys alone (no hashes without an index)
  let (hit, next2) = b.branch(b.eq_values(b.add(Op.Field, kt, Aux.I(n: 3), [e]), k))
  b.s.cur = hit
  b.jump(join, [i])
  let step = b.new_block()
  b.s.cur = next2
  b.jump(step, [])
  b.seal(step)
  b.s.cur = step
  b.write_var(iv, b.iop(Op.Sub, i, b.cint(1)))
  b.jump(head, [])
  b.seal(head)
  // the index: the newest own entry of k, then back below lim
  b.s.cur = indexed
  let pv = b.local()
  b.write_var(pv, b.mlog_home(h, n))
  let head2 = b.new_block()
  b.jump(head2, [])
  b.s.cur = head2
  let p = b.read(pv)
  let s = b.rt("slot_load", it, [idx, p, b.cint(MLOG_ACQ)])
  let (empty, full) = b.branch(b.bop(Op.Eq, s, b.cint(0)))
  b.s.cur = empty
  b.jump(join, [b.cint(-1)])
  b.s.cur = full
  let pos = b.iop(Op.Add, base, b.iop(Op.Sub, s, b.cint(1)))
  let e2 = b.mlog_at(et, dir, b.iop(Op.Sub, s, b.cint(1)))
  let (h2, n2) = b.branch(b.bop(Op.Eq, b.add(Op.Field, it, Aux.I(n: 0), [e2]), h))
  b.s.cur = h2
  let (k2, n3) = b.branch(b.eq_values(b.add(Op.Field, kt, Aux.I(n: 3), [e2]), k))
  b.s.cur = k2
  let jv = b.local()
  b.write_var(jv, pos)
  let head3 = b.new_block()
  b.jump(head3, [])
  b.s.cur = head3
  let j = b.read(jv)
  let (above, below) = b.branch(b.bop(Op.Ge, j, lim))
  b.s.cur = above
  b.write_var(jv, b.add(Op.Field, it, Aux.I(n: 1), [b.mlog_at(et, dir, b.iop(Op.Sub, j, base))]))
  b.jump(head3, [])
  b.seal(head3)
  b.s.cur = below
  b.jump(join, [j])
  let step2 = b.new_block()
  b.s.cur = n2
  b.jump(step2, [])
  b.s.cur = n3
  b.jump(step2, [])
  b.seal(step2)
  b.s.cur = step2
  b.write_var(pv, b.iop(Op.And, b.iop(Op.Add, p, b.cint(1)), b.iop(Op.Sub, n, b.cint(1))))
  b.jump(head2, [])
  b.seal(head2)
  b.seal(join)
  b.s.cur = join
  res
}

/// xo.mlog.find[T](m, k, h) -> Int: k's live entry in m's view as level *
/// MLOG_LEVEL + position (level 0: m's table, i: m.parents[i - 1]), or -1.
/// Small enough for the arm64 inliner (INLINE_MAX_INSTRS): an indexed
/// table with no parents whose newest entry of k is in the view; every
/// other case (a scan, a fork, an entry past the view) is xo.mlog.findx.
fn (var b: Builder) mlog_find(t: Int) -> Str {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let kt = mlog_key(b.m, t)
  let slow = b.mlog_findx(t)
  let name = "xo.mlog.find[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, kt, it], [it], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let h = b.param(2)
  let idx = b.mf(t, 1, mp)
  let n = b.call("list.len", it, "", [idx])
  let slow_b = b.new_block()
  let (none, fast) = b.branch(b.bop(Op.Eq, n, b.cint(0)))
  b.s.cur = none
  b.jump(slow_b, [])
  b.s.cur = fast
  let dir = b.mf(t, 0, mp)
  let mask = b.iop(Op.Sub, n, b.cint(1))
  let pv = b.local()
  b.write_var(pv, b.iop(Op.And, h, mask))
  let head = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let p = b.read(pv)
  let s = b.rt("slot_load", it, [idx, p, b.cint(MLOG_ACQ)])
  let (empty, full) = b.branch(b.bop(Op.Eq, s, b.cint(0)))
  // a miss in m's own table is the answer unless m has parents
  b.s.cur = empty
  let (own, up) = b.branch(b.bop(Op.Eq, b.call("list.len", it, "", [b.mf(t, 7, mp)]), b.cint(0)))
  b.s.cur = own
  b.retv(b.cint(-1))
  b.s.cur = up
  b.jump(slow_b, [])
  b.s.cur = full
  let (c, off) = b.mlog_slot8(b.iop(Op.Add, s, b.cint(MLOG_CHUNK - 1)))
  let chunk = b.call("list.index", b.m.types[b.vty(dir)].elems[0], "", [dir, c])
  let e = b.call("list.index", et, "", [chunk, off])
  let next = b.new_block()
  // an Int key is its own hash's input: the key compare alone decides
  if b.tkind(kt) != Kind.Int {
    let (hh, step) = b.branch(b.bop(Op.Eq, b.add(Op.Field, it, Aux.I(n: 0), [e]), h))
    b.s.cur = step
    b.jump(next, [])
    b.s.cur = hh
  }
  let (hit, step2) = b.branch(b.eq_values(b.add(Op.Field, kt, Aux.I(n: 3), [e]), k))
  b.s.cur = step2
  b.jump(next, [])
  b.s.cur = hit
  let pos = b.iop(Op.Add, b.mf(t, 3, mp), b.iop(Op.Sub, s, b.cint(1)))
  // past the view (another value appended): xo.mlog.findx follows prev
  let (past, inview) = b.branch(b.bop(Op.Ge, pos, b.mf(t, 5, mp)))
  b.s.cur = past
  b.jump(slow_b, [])
  b.s.cur = inview
  let (live, dead) = b.branch(b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 2), [e]), b.cint(0)))
  b.s.cur = live
  b.retv(pos)
  b.s.cur = dead
  b.retv(b.cint(-1))
  b.seal(next)
  b.s.cur = next
  b.write_var(pv, b.iop(Op.And, b.iop(Op.Add, p, b.cint(1)), mask))
  b.jump(head, [])
  b.seal(head)
  b.seal(slow_b)
  b.s.cur = slow_b
  b.retv(b.call(slow, it, "", [mp, k, h]))
  b.dead()
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.findx[T](m, k, h): xo.mlog.find for every map.
fn (var b: Builder) mlog_findx(t: Int) -> Str {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let kt = mlog_key(b.m, t)
  let probe = b.mlog_probe(t)
  let name = "xo.mlog.findx[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, kt, it], [it], [])
  if fi < 0 {
    return name
  }
  let pt = b.m.tuple([it, it])
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let h = b.param(2)
  let np0 = b.call("list.len", it, "", [b.mf(t, 7, mp)])
  let (nr, jr) = b.if_then_begin(b.bop(Op.Eq, np0, b.cint(0)))
  // no parents: one table, probed inline
  let rdir = b.mf(t, 0, mp)
  let rbase = b.mf(t, 3, mp)
  let rj = b.mlog_probe_j(t, rdir, b.mf(t, 1, mp), rbase, b.mf(t, 5, mp), k, h)
  let (nf0, jf0) = b.if_then_begin(b.bop(Op.Ge, rj, b.cint(0)))
  let (nl0, jl0) = b.if_then_begin(b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 2), [b.mlog_at(et, rdir, b.iop(Op.Sub, rj, rbase))]), b.cint(0)))
  b.retv(rj)
  b.if_then_end(nl0, jl0)
  b.if_then_end(nf0, jf0)
  b.retv(b.cint(-1))
  b.if_then_end(nr, jr)
  // m's own table, read through the borrowed value (no List is a loop
  // variable: a List carried along an edge would make m owned, and every
  // get would count its Lists up and down)
  let parents = b.mf(t, 7, mp)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let odir = b.mf(t, 0, mp)
  let obase = b.mf(t, 3, mp)
  let olim = b.mf(t, 5, mp)
  let (nv0, jn0) = b.if_then_begin(b.bop(Op.Gt, olim, obase))
  let r0 = b.call(probe, pt, "", [odir, b.mf(t, 1, mp), obase, olim, k, h])
  let j0 = b.add(Op.Field, it, Aux.I(n: 1), [r0])
  let (nf0b, jf0b) = b.if_then_begin(b.bop(Op.Ge, j0, b.cint(0)))
  let (nl0b, jl0b) = b.if_then_begin(b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 2), [b.mlog_at(et, odir, b.iop(Op.Sub, j0, obase))]), b.cint(0)))
  b.retv(j0)
  b.if_then_end(nl0b, jl0b)
  b.retv(b.cint(-1))
  b.if_then_end(nf0b, jf0b)
  b.if_then_end(nv0, jn0)
  // the parents, newest first: a level's view ends at its child's base
  let lv = b.local()
  let levv = b.local()
  b.write_var(lv, obase)
  b.write_var(levv, b.cint(0))
  let np = b.call("list.len", it, "", [parents])
  let head = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let lim = b.read(lv)
  let lev = b.read(levv)
  let (nd, jd) = b.if_then_begin(b.bop(Op.Ge, lev, np))
  b.retv(b.cint(-1))
  b.if_then_end(nd, jd)
  let lvl = b.call("list.index", lvt, "", [parents, lev])
  if b.m.map_branch {
    // a lists level, always the oldest: the lists' find
    let lf = b.m.types[lvt].fields
    let (nls, jls) = b.if_then_begin(b.mlog_lvl_lists(lvt, lvl))
    let lj = b.call(b.mlog_lprobe(t, lvt), it, "", [b.add(Op.Field, lf[4].ty, Aux.I(n: 4), [lvl]), b.add(Op.Field, lf[5].ty, Aux.I(n: 5), [lvl]), b.add(Op.Field, lf[6].ty, Aux.I(n: 6), [lvl]), k, h])
    let (nlh, jlh) = b.if_then_begin(b.bop(Op.Ge, lj, b.cint(0)))
    b.retv(b.iop(Op.Add, b.iop(Op.Mul, b.iop(Op.Add, lev, b.cint(1)), b.cint(MLOG_LEVEL)), lj))
    b.if_then_end(nlh, jlh)
    b.retv(b.cint(-1))
    b.if_then_end(nls, jls)
  }
  let dir = b.add(Op.Field, b.m.types[lvt].fields[0].ty, Aux.I(n: 0), [lvl])
  let base = b.add(Op.Field, it, Aux.I(n: 2), [lvl])
  let (nv, jn) = b.if_then_begin(b.bop(Op.Gt, lim, base))
  let r = b.call(probe, pt, "", [dir, b.add(Op.Field, b.m.types[lvt].fields[1].ty, Aux.I(n: 1), [lvl]), base, lim, k, h])
  let j = b.add(Op.Field, it, Aux.I(n: 1), [r])
  let (nf, jf) = b.if_then_begin(b.bop(Op.Ge, j, b.cint(0)))
  let e = b.mlog_at(et, dir, b.iop(Op.Sub, j, base))
  let (nl, jl) = b.if_then_begin(b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 2), [e]), b.cint(0)))
  b.retv(b.iop(Op.Add, b.iop(Op.Mul, b.iop(Op.Add, lev, b.cint(1)), b.cint(MLOG_LEVEL)), j))
  b.if_then_end(nl, jl)
  b.retv(b.cint(-1))
  b.if_then_end(nf, jf)
  b.if_then_end(nv, jn)
  b.write_var(lv, base)
  b.write_var(levv, b.iop(Op.Add, lev, b.cint(1)))
  b.jump(head, [])
  b.seal(head)
  b.dead()
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.finish_fn()
  b.end(saved)
  name
}

/// The entry of a find's result w (>= 0) in the key side value mv (of
/// type t).
fn (var b: Builder) mlog_entry_at(t: Int, mv: Int, w: Int) -> Int {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let lev = b.iop(Op.Div, w, b.cint(MLOG_LEVEL))
  let pos = b.iop(Op.Sub, w, b.iop(Op.Mul, lev, b.cint(MLOG_LEVEL)))
  let parents = b.mf(t, 7, mv)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let join = b.new_block()
  let res = b.s.f.add_param(join, et)
  let (own, up) = b.branch(b.bop(Op.Eq, lev, b.cint(0)))
  b.s.cur = own
  b.jump(join, [b.mlog_at(et, b.mf(t, 0, mv), b.iop(Op.Sub, pos, b.mf(t, 3, mv)))])
  b.s.cur = up
  let lvl = b.call("list.index", lvt, "", [parents, b.iop(Op.Sub, lev, b.cint(1))])
  let lbase = b.add(Op.Field, it, Aux.I(n: 2), [lvl])
  b.jump(join, [b.mlog_lvl_at(t, lvt, lvl, b.iop(Op.Sub, pos, lbase))])
  b.seal(join)
  b.s.cur = join
  res
}

/// The value of a find's result w (>= 0) in the log map value mv (of
/// type t): its value log's at the entry's own index, or its value
/// level's.
fn (var b: Builder) mlog_value_at(t: Int, mv: Int, w: Int) -> Int {
  let it = b.int_t()
  let vt = mlog_val(b.m, t)
  let kt = mlog_k(b.m, t)
  let kl = b.mf(t, 0, mv)
  let lev = b.iop(Op.Div, w, b.cint(MLOG_LEVEL))
  let pos = b.iop(Op.Sub, w, b.iop(Op.Mul, lev, b.cint(MLOG_LEVEL)))
  let join = b.new_block()
  let res = b.s.f.add_param(join, vt)
  let (own, up) = b.branch(b.bop(Op.Eq, lev, b.cint(0)))
  b.s.cur = own
  b.jump(join, [b.mlog_at(vt, b.mf(t, 1, mv), b.iop(Op.Sub, pos, b.mf(kt, 3, kl)))])
  b.s.cur = up
  let parents = b.mf(kt, 7, kl)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let vpar = b.mf(t, 2, mv)
  let vlt = b.m.types[b.vty(vpar)].elems[0]
  let li = b.iop(Op.Sub, lev, b.cint(1))
  let lvl = b.call("list.index", lvt, "", [parents, li])
  let vlvl = b.call("list.index", vlt, "", [vpar, li])
  let lbase = b.add(Op.Field, it, Aux.I(n: 2), [lvl])
  b.jump(join, [b.mlog_vlvl_at(vt, lvt, lvl, vlt, vlvl, b.iop(Op.Sub, pos, lbase))])
  b.seal(join)
  b.s.cur = join
  res
}

/// xo.mlog.vals[T](m, ws) -> List[V]: the values of find results ws in
/// the log map value m.
fn (var b: Builder) mlog_vals(t: Int) -> Str {
  let it = b.int_t()
  let vl = b.m.list(mlog_val(b.m, t))
  let il = b.m.list(it)
  let name = "xo.mlog.vals[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, il], [vl], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let ws = b.param(1)
  let n = b.call("list.len", it, "", [ws])
  let out = b.local()
  b.write_var(out, b.call("list.new", vl, "", [n]))
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(n, iv)
  let v = b.mlog_value_at(t, mp, b.call("list.index", it, "", [ws, i]))
  b.write_var(out, b.call("list.push", vl, "", [b.read(out), v]))
  b.for_up_to_end(i, iv, ih, ix)
  b.retv(b.read(out))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.vtable[D](vals) -> D: a fresh value log (D, a List[List[V]])
/// of vals in the key side's chunk layout (mlog_table's entries).
fn (var b: Builder) mlog_vtable(vd: Int) -> Str {
  let it = b.int_t()
  let vl = b.m.types[vd].elems[0]
  let name = "xo.mlog.vtable[${b.m.types[vd].name}]"
  let fi = b.thunk_func(name, [vl], [vd], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let vals = b.param(0)
  let n = b.call("list.len", it, "", [vals])
  let dv = b.local()
  b.write_var(dv, b.mlog_newdir(vd))
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(n, iv)
  let v = b.call("list.index", b.m.types[vl].elems[0], "", [vals, i])
  let (c, _off) = b.mlog_slot(i)
  let (nn, jn) = b.if_then_begin(b.bop(Op.Eq, c, b.call("list.len", it, "", [b.read(dv)])))
  b.mlog_push(b.read(dv), b.call("list.new", vl, "", [b.iop(Op.Shl, b.cint(1), c)]))
  b.if_then_end(nn, jn)
  b.mlog_push(b.call("list.index", vl, "", [b.read(dv), c]), v)
  b.for_up_to_end(i, iv, ih, ix)
  b.retv(b.read(dv))
  b.finish_fn()
  b.end(saved)
  name
}

/// The value log vdir with v appended at own index i (a new chunk first
/// when i starts one), in place (log.push: the chunks are shared as the
/// key side's are).
fn (var b: Builder) mlog_vpush(vdir: Int, i: Int, v: Int) {
  let it = b.int_t()
  let vl = b.m.types[b.vty(vdir)].elems[0]
  let (c, _off) = b.mlog_slot(i)
  let (nc, jc) = b.if_then_begin(b.bop(Op.Eq, c, b.call("list.len", it, "", [vdir])))
  b.mlog_push(vdir, b.call("list.new", vl, "", [b.iop(Op.Shl, b.cint(1), c)]))
  b.if_then_end(nc, jc)
  b.mlog_push(b.call("list.index", vl, "", [vdir, c]), v)
}

/// The index of the own entries [base, lim) of the log dir: each key's
/// newest entry, in slots twice the keys (at least 16).
fn (var b: Builder) mlog_build_index(t: Int, dir: Int, base: Int, lim: Int, keys: Int) -> Int {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let kt = mlog_key(b.m, t)
  let il = b.m.types[t].fields[1].ty
  let cv = b.local()
  b.write_var(cv, b.cint(16))
  let h0 = b.new_block()
  let grow = b.new_block()
  let done = b.new_block()
  b.jump(h0, [])
  b.s.cur = h0
  let c = b.read(cv)
  b.s.f.branch(b.s.cur, b.bop(Op.Lt, c, b.iop(Op.Mul, keys, b.cint(2))), grow, done)
  b.seal(grow)
  b.s.cur = grow
  b.write_var(cv, b.iop(Op.Mul, c, b.cint(2)))
  b.jump(h0, [])
  b.seal(h0)
  b.seal(done)
  b.s.cur = done
  let n = b.read(cv)
  let sv = b.local()
  b.write_var(sv, b.call("list.new", il, "", [n]))
  let zv = b.local()
  let (z, zh, zx) = b.for_up_to_begin(n, zv)
  b.write_var(sv, b.call("list.push", il, "", [b.read(sv), b.cint(0)]))
  b.for_up_to_end(z, zv, zh, zx)
  let slots = b.read(sv)
  let iv = b.local()
  let (i, head, exit) = b.for_up_to_begin(b.iop(Op.Sub, lim, base), iv)
  let e = b.mlog_at(et, dir, i)
  let h = b.add(Op.Field, it, Aux.I(n: 0), [e])
  let k = b.add(Op.Field, kt, Aux.I(n: 3), [e])
  // k's slot (an older entry of k) or the first empty one
  let pv = b.local()
  b.write_var(pv, b.mlog_home(h, n))
  let ph = b.new_block()
  let found = b.new_block()
  b.jump(ph, [])
  b.s.cur = ph
  let p = b.read(pv)
  let s = b.call("list.index", it, "", [slots, p])
  let empty = b.bop(Op.Eq, s, b.cint(0))
  let check = b.new_block()
  b.s.f.branch(b.s.cur, empty, found, check)
  b.seal(check)
  b.s.cur = check
  let e2 = b.mlog_at(et, dir, b.iop(Op.Sub, s, b.cint(1)))
  let same = b.bop(Op.Eq, b.add(Op.Field, it, Aux.I(n: 0), [e2]), h)
  let cmpk = b.new_block()
  let next = b.new_block()
  b.s.f.branch(b.s.cur, same, cmpk, next)
  b.seal(cmpk)
  b.s.cur = cmpk
  let eqk = b.eq_values(b.add(Op.Field, kt, Aux.I(n: 3), [e2]), k)
  b.s.f.branch(b.s.cur, eqk, found, next)
  b.seal(next)
  b.s.cur = next
  b.write_var(pv, b.iop(Op.And, b.iop(Op.Add, p, b.cint(1)), b.iop(Op.Sub, n, b.cint(1))))
  b.jump(ph, [])
  b.seal(ph)
  b.seal(found)
  b.s.cur = found
  b.rt("slot_store", -1, [slots, b.read(pv), b.iop(Op.Add, i, b.cint(1)), b.cint(MLOG_REL)])
  b.for_up_to_end(i, iv, head, exit)
  slots
}

/// xo.mlog.each[K](m) -> (List[E], List[Int]): the live entries of the
/// key side m's view in insertion order, as fresh entries (prev and org
/// -1), and each one's current entry as a find result (mlog_value_at
/// reads its value): the flatten and the iterations.
fn (var b: Builder) mlog_each(t: Int) -> Str {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let kt = mlog_key(b.m, t)
  let find = b.mlog_find(t)
  let el = b.m.list(et)
  let wl = b.m.list(it)
  let rt = b.m.tuple([el, wl])
  let name = "xo.mlog.each[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [rt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let n = b.mf(t, 4, mp)
  let out = b.local()
  b.write_var(out, b.call("list.new", el, "", [n]))
  let wsv = b.local()
  b.write_var(wsv, b.call("list.new", wl, "", [n]))
  let parents = b.mf(t, 7, mp)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let np = b.call("list.len", it, "", [parents])
  // a root table (base 0): with no garbage every entry is live and its
  // own origin, in order; else Go's eachRoot: an entry is current when no
  // later entry's prev names it, and current live entries go by origin
  let (nr, jr) = b.if_then_begin(b.bop(Op.Eq, np, b.cint(0)))
  let rdir = b.mf(t, 0, mp)
  let rlim = b.mf(t, 5, mp)
  let (ng, jg) = b.if_then_begin(b.bop(Op.Eq, rlim, n))
  let fv = b.local()
  let (fi0, fh, fx) = b.for_up_to_begin(n, fv)
  let fe = b.mlog_at(et, rdir, fi0)
  let fk = b.add(Op.Field, kt, Aux.I(n: 3), [fe])
  let ffresh = b.add(Op.Struct, et, Aux.None, [b.add(Op.Field, it, Aux.I(n: 0), [fe]), b.cint(-1), b.cint(-1), fk])
  b.write_var(out, b.call("list.push", el, "", [b.read(out), ffresh]))
  b.write_var(wsv, b.call("list.push", wl, "", [b.read(wsv), fi0]))
  b.for_up_to_end(fi0, fv, fh, fx)
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.read(out), b.read(wsv)]))
  b.if_then_end(ng, jg)
  let bl = b.m.list(b.bool_t())
  let il = b.m.list(it)
  let supv = b.local()
  b.write_var(supv, b.call("list.new", bl, "", [rlim]))
  let ordv = b.local()
  b.write_var(ordv, b.call("list.new", il, "", [rlim]))
  let zv = b.local()
  let (z, zh, zx) = b.for_up_to_begin(rlim, zv)
  b.write_var(supv, b.call("list.push", bl, "", [b.read(supv), b.cbool(false)]))
  b.write_var(ordv, b.call("list.push", il, "", [b.read(ordv), b.cint(0)]))
  b.for_up_to_end(z, zv, zh, zx)
  let sv = b.local()
  let (s, sh, sx) = b.for_up_to_begin(rlim, sv)
  let sp = b.add(Op.Field, it, Aux.I(n: 1), [b.mlog_at(et, rdir, s)])
  let (nps, jps) = b.if_then_begin(b.bop(Op.Ge, sp, b.cint(0)))
  b.write_var(supv, b.call("list.set", bl, "", [b.read(supv), sp, b.cbool(true)]))
  b.if_then_end(nps, jps)
  b.for_up_to_end(s, sv, sh, sx)
  let ov = b.local()
  let (o, oh, ox) = b.for_up_to_begin(rlim, ov)
  let oe = b.mlog_at(et, rdir, o)
  let oorg = b.add(Op.Field, it, Aux.I(n: 2), [oe])
  let cur_live = b.add(Op.And, b.bool_t(), Aux.None, [b.add(Op.Not, b.bool_t(), Aux.None, [b.call("list.index", b.bool_t(), "", [b.read(supv), o])]), b.bop(Op.Ge, oorg, b.cint(0))])
  let (nol, jol) = b.if_then_begin(cur_live)
  b.write_var(ordv, b.call("list.set", il, "", [b.read(ordv), oorg, b.iop(Op.Add, o, b.cint(1))]))
  b.if_then_end(nol, jol)
  b.for_up_to_end(o, ov, oh, ox)
  let ords = b.read(ordv)
  let wv = b.local()
  let (w0, wh, wx) = b.for_up_to_begin(rlim, wv)
  let x = b.call("list.index", it, "", [ords, w0])
  let (nx, jx) = b.if_then_begin(b.bop(Op.Ne, x, b.cint(0)))
  let ce = b.mlog_at(et, rdir, b.iop(Op.Sub, x, b.cint(1)))
  let cfresh = b.add(Op.Struct, et, Aux.None, [b.add(Op.Field, it, Aux.I(n: 0), [ce]), b.cint(-1), b.cint(-1), b.add(Op.Field, kt, Aux.I(n: 3), [ce])])
  b.write_var(out, b.call("list.push", el, "", [b.read(out), cfresh]))
  b.write_var(wsv, b.call("list.push", wl, "", [b.read(wsv), b.iop(Op.Sub, x, b.cint(1))]))
  b.if_then_end(nx, jx)
  b.for_up_to_end(w0, wv, wh, wx)
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.read(out), b.read(wsv)]))
  b.if_then_end(nr, jr)
  // the levels from the oldest (np) to m's table (0); a level's end is
  // its child's base
  let levv = b.local()
  b.write_var(levv, np)
  let head = b.new_block()
  let fin = b.new_block()
  b.jump(head, [])
  b.s.cur = head
  let lev = b.read(levv)
  let body = b.new_block()
  b.s.f.branch(b.s.cur, b.bop(Op.Ge, lev, b.cint(0)), body, fin)
  b.seal(body)
  b.s.cur = body
  let dv = b.local()
  let bv = b.local()
  let ev = b.local()
  let (own, up) = b.branch(b.bop(Op.Eq, lev, b.cint(0)))
  let ready = b.new_block()
  b.s.cur = own
  b.write_var(dv, b.mf(t, 0, mp))
  b.write_var(bv, b.mf(t, 3, mp))
  b.write_var(ev, b.mf(t, 5, mp))
  b.jump(ready, [])
  b.s.cur = up
  let lvl = b.call("list.index", lvt, "", [parents, b.iop(Op.Sub, lev, b.cint(1))])
  b.write_var(dv, b.add(Op.Field, b.m.types[lvt].fields[0].ty, Aux.I(n: 0), [lvl]))
  b.write_var(bv, b.add(Op.Field, it, Aux.I(n: 2), [lvl]))
  // a parent's view ends where the level below it begins
  let (top, below) = b.branch(b.bop(Op.Eq, lev, b.cint(1)))
  let got = b.new_block()
  b.s.cur = top
  b.write_var(ev, b.mf(t, 3, mp))
  b.jump(got, [])
  b.s.cur = below
  let lower = b.call("list.index", lvt, "", [parents, b.iop(Op.Sub, lev, b.cint(2))])
  b.write_var(ev, b.add(Op.Field, it, Aux.I(n: 2), [lower]))
  b.jump(got, [])
  b.seal(got)
  b.s.cur = got
  b.jump(ready, [])
  b.seal(ready)
  b.s.cur = ready
  let dir = b.read(dv)
  let base = b.read(bv)
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(b.iop(Op.Sub, b.read(ev), base), iv)
  var e = -1
  if b.m.map_branch {
    // a level's entry through mlog_lvl_at (a lists level has no log)
    let ej = b.new_block()
    let er = b.s.f.add_param(ej, et)
    let (eo, eu) = b.branch(b.bop(Op.Eq, lev, b.cint(0)))
    b.s.cur = eo
    b.jump(ej, [b.mlog_at(et, dir, i)])
    b.s.cur = eu
    b.jump(ej, [b.mlog_lvl_at(t, lvt, b.call("list.index", lvt, "", [parents, b.iop(Op.Sub, lev, b.cint(1))]), i)])
    b.seal(ej)
    b.s.cur = ej
    e = er
  } else {
    e = b.mlog_at(et, dir, i)
  }
  let pos = b.iop(Op.Add, base, i)
  // an origin entry: its key's current entry in m's view, if live and
  // still from this origin
  let (no, jo) = b.if_then_begin(b.bop(Op.Eq, b.add(Op.Field, it, Aux.I(n: 2), [e]), pos))
  let k = b.add(Op.Field, kt, Aux.I(n: 3), [e])
  // the entry's hash, or k's when it kept none (a table with no index,
  // mlog_hash_if): m's view is probed by hash in its indexed levels
  let hv = b.local()
  b.write_var(hv, b.add(Op.Field, it, Aux.I(n: 0), [e]))
  let (nz, jz) = b.if_then_begin(b.bop(Op.Eq, b.read(hv), b.cint(0)))
  b.write_var(hv, b.call(b.hash_func(kt), it, "", [k]))
  b.if_then_end(nz, jz)
  let h = b.read(hv)
  let w = b.call(find, it, "", [mp, k, h])
  let (nw, jw) = b.if_then_begin(b.bop(Op.Ge, w, b.cint(0)))
  let cur = b.mlog_entry_at(t, mp, w)
  let (ns, js) = b.if_then_begin(b.bop(Op.Eq, b.add(Op.Field, it, Aux.I(n: 2), [cur]), pos))
  let fresh = b.add(Op.Struct, et, Aux.None, [h, b.cint(-1), b.cint(-1), k])
  b.write_var(out, b.call("list.push", el, "", [b.read(out), fresh]))
  b.write_var(wsv, b.call("list.push", wl, "", [b.read(wsv), w]))
  b.if_then_end(ns, js)
  b.if_then_end(nw, jw)
  b.if_then_end(no, jo)
  b.for_up_to_end(i, iv, ih, ix)
  b.write_var(levv, b.iop(Op.Sub, lev, b.cint(1)))
  b.jump(head, [])
  b.seal(head)
  b.seal(fin)
  b.s.cur = fin
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.read(out), b.read(wsv)]))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.eachpos[T](m) -> List[Int]: for a root table m (no parents,
/// base 0), the own positions of its live keys' current entries in
/// insertion order (mlog_each's order and values, as positions: a loop
/// reads the entries in place, for_mlog_root, with no copy of a key or
/// a value).
fn (var b: Builder) mlog_eachpos(t: Int) -> Str {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let il = b.m.list(it)
  let name = "xo.mlog.eachpos[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [il], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let n = b.mf(t, 4, mp)
  let out = b.local()
  b.write_var(out, b.call("list.new", il, "", [n]))
  let rdir = b.mf(t, 0, mp)
  let rlim = b.mf(t, 5, mp)
  // with no garbage every entry is live and its own origin, in order
  let (ng, jg) = b.if_then_begin(b.bop(Op.Eq, rlim, n))
  let fv = b.local()
  let (fi0, fh, fx) = b.for_up_to_begin(n, fv)
  b.write_var(out, b.call("list.push", il, "", [b.read(out), fi0]))
  b.for_up_to_end(fi0, fv, fh, fx)
  b.retv(b.read(out))
  b.if_then_end(ng, jg)
  // else mlog_each's root walk: an entry is current when no later
  // entry's prev names it, and current live entries go by origin
  let bl = b.m.list(b.bool_t())
  let supv = b.local()
  b.write_var(supv, b.call("list.new", bl, "", [rlim]))
  let ordv = b.local()
  b.write_var(ordv, b.call("list.new", il, "", [rlim]))
  let zv = b.local()
  let (z, zh, zx) = b.for_up_to_begin(rlim, zv)
  b.write_var(supv, b.call("list.push", bl, "", [b.read(supv), b.cbool(false)]))
  b.write_var(ordv, b.call("list.push", il, "", [b.read(ordv), b.cint(0)]))
  b.for_up_to_end(z, zv, zh, zx)
  let sv = b.local()
  let (s, sh, sx) = b.for_up_to_begin(rlim, sv)
  let sp = b.add(Op.Field, it, Aux.I(n: 1), [b.mlog_at(et, rdir, s)])
  let (nps, jps) = b.if_then_begin(b.bop(Op.Ge, sp, b.cint(0)))
  b.write_var(supv, b.call("list.set", bl, "", [b.read(supv), sp, b.cbool(true)]))
  b.if_then_end(nps, jps)
  b.for_up_to_end(s, sv, sh, sx)
  let ov = b.local()
  let (o, oh, ox) = b.for_up_to_begin(rlim, ov)
  let oorg = b.add(Op.Field, it, Aux.I(n: 2), [b.mlog_at(et, rdir, o)])
  let cur_live = b.add(Op.And, b.bool_t(), Aux.None, [b.add(Op.Not, b.bool_t(), Aux.None, [b.call("list.index", b.bool_t(), "", [b.read(supv), o])]), b.bop(Op.Ge, oorg, b.cint(0))])
  let (nol, jol) = b.if_then_begin(cur_live)
  b.write_var(ordv, b.call("list.set", il, "", [b.read(ordv), oorg, b.iop(Op.Add, o, b.cint(1))]))
  b.if_then_end(nol, jol)
  b.for_up_to_end(o, ov, oh, ox)
  let ords = b.read(ordv)
  let wv = b.local()
  let (w0, wh, wx) = b.for_up_to_begin(rlim, wv)
  let x = b.call("list.index", it, "", [ords, w0])
  let (nx, jx) = b.if_then_begin(b.bop(Op.Ne, x, b.cint(0)))
  b.write_var(out, b.call("list.push", il, "", [b.read(out), b.iop(Op.Sub, x, b.cint(1))]))
  b.if_then_end(nx, jx)
  b.for_up_to_end(w0, wv, wh, wx)
  b.retv(b.read(out))
  b.finish_fn()
  b.end(saved)
  name
}

/// A fresh table holding entries es (fresh, in insertion order) with
/// room for extra more, claimed through position es.len() + claim.
fn (var b: Builder) mlog_table(t: Int, es: Int, claim: Int) -> Int {
  let it = b.int_t()
  let et = mlog_entry_of(b.m, t)
  let el = b.m.list(et)
  let dt = b.m.types[t].fields[0].ty
  let il = b.m.types[t].fields[1].ty
  let n = b.call("list.len", it, "", [es])
  let dv = b.local()
  b.write_var(dv, b.mlog_newdir(dt))
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(n, iv)
  let e0 = b.call("list.index", et, "", [es, i])
  let ev = b.local()
  b.write_var(ev, b.add(Op.SetField, et, Aux.I(n: 2), [e0, i]))
  // an indexed table's entries carry their keys' hashes (an unindexed
  // one's may be 0: mlog_hash_if)
  let (nh, jh) = b.if_then_begin(b.bop(Op.Gt, n, b.cint(MLOG_SMALL)))
  let kh = b.call(b.hash_func(mlog_key(b.m, t)), it, "", [b.add(Op.Field, mlog_key(b.m, t), Aux.I(n: 3), [e0])])
  b.write_var(ev, b.add(Op.SetField, et, Aux.I(n: 0), [b.read(ev), kh]))
  b.if_then_end(nh, jh)
  let e = b.read(ev)
  let (c, _off) = b.mlog_slot(i)
  let dir = b.read(dv)
  let (nn, jn) = b.if_then_begin(b.bop(Op.Eq, c, b.call("list.len", it, "", [dir])))
  let chunk = b.call("list.new", el, "", [b.iop(Op.Shl, b.cint(1), c)])
  b.mlog_push(b.read(dv), chunk)
  b.if_then_end(nn, jn)
  let d2 = b.read(dv)
  b.mlog_push(b.call("list.index", el, "", [d2, c]), e)
  b.for_up_to_end(i, iv, ih, ix)
  let dir2 = b.read(dv)
  let xv = b.local()
  b.write_var(xv, b.call("list.new", il, "", []))
  let (ns, js) = b.if_then_begin(b.bop(Op.Gt, n, b.cint(MLOG_SMALL)))
  b.write_var(xv, b.mlog_build_index(t, dir2, b.cint(0), n, n))
  b.if_then_end(ns, js)
  var used = b.call("list.new", il, "", [b.cint(1)])
  used = b.call("list.push", il, "", [used, b.iop(Op.Add, n, claim)])
  let parents = b.call("list.new", b.m.types[t].fields[7].ty, "", [])
  b.add(Op.Struct, t, Aux.None, [dir2, b.read(xv), used, b.cint(0), n, n, n, parents])
}

/// The result of xo.mlog.claimk[K] for key side type t: (the key side,
/// how, the flatten's find results), how 0 when m won the claim, 1 for a
/// first table, 2 for a flatten (its entries' current ones in m were the
/// find results), 3 for a fork (m's view its parent).
fn (var b: Builder) mlog_claim_type(t: Int) -> Int {
  b.m.tuple([t, b.int_t(), b.m.list(b.int_t())])
}

/// xo.mlog.claimk[K](m) -> mlog_claim_type: the key side m owning the next
/// position of its table (it won the claim, or forked or flattened into a
/// table only it has).
fn (var b: Builder) mlog_claimk(t: Int) -> Str {
  let it = b.int_t()
  let each = b.mlog_each(t)
  let rt = b.mlog_claim_type(t)
  let wl = b.m.list(it)
  let name = "xo.mlog.claimk[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [rt], [])
  if fi < 0 {
    return name
  }
  let il = b.m.types[t].fields[1].ty
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let used = b.mf(t, 2, mp)
  let lim = b.mf(t, 5, mp)
  let none = b.call("list.new", wl, "", [])
  let (nt, jt) = b.if_then_begin(b.bop(Op.Eq, b.call("list.len", it, "", [used]), b.cint(0)))
  // no table yet: a fresh one, position 0 claimed
  var u0 = b.call("list.new", il, "", [b.cint(1)])
  u0 = b.call("list.push", il, "", [u0, b.cint(1)])
  let d0 = b.mlog_newdir(b.m.types[t].fields[0].ty)
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.add(Op.SetField, t, Aux.I(n: 0), [b.add(Op.SetField, t, Aux.I(n: 2), [mp, u0]), d0]), b.cint(1), none]))
  b.if_then_end(nt, jt)
  let won = b.rt("slot_cas", b.bool_t(), [used, b.cint(0), lim, b.iop(Op.Add, lim, b.cint(1)), b.cint(MLOG_ACQ_REL)])
  let (nw, jw) = b.if_then_begin(won)
  b.retv(b.add(Op.Tuple, rt, Aux.None, [mp, b.cint(0), none]))
  b.if_then_end(nw, jw)
  let parents = b.mf(t, 7, mp)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let np = b.call("list.len", it, "", [parents])
  let (nd, jd) = b.if_then_begin(b.bop(Op.Ge, np, b.cint(MLOG_DEPTH)))
  // too deep: a flattened table, its next position claimed
  let er = b.call(each, b.m.tuple([b.m.list(mlog_entry_of(b.m, t)), wl]), "", [mp])
  let es = b.add(Op.Field, b.m.list(mlog_entry_of(b.m, t)), Aux.I(n: 0), [er])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.mlog_table(t, es, b.cint(1)), b.cint(2), b.add(Op.Field, wl, Aux.I(n: 1), [er])]))
  b.if_then_end(nd, jd)
  // a fork: a table whose parent is m's view
  let lvl = b.mlog_level(lvt, b.mf(t, 0, mp), b.mf(t, 1, mp), b.mf(t, 3, mp), lim)
  let plt = b.vty(parents)
  let pv = b.local()
  b.write_var(pv, b.call("list.new", plt, "", [b.iop(Op.Add, np, b.cint(1))]))
  b.write_var(pv, b.call("list.push", plt, "", [b.read(pv), lvl]))
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(np, iv)
  b.write_var(pv, b.call("list.push", plt, "", [b.read(pv), b.call("list.index", lvt, "", [parents, i])]))
  b.for_up_to_end(i, iv, ih, ix)
  var u1 = b.call("list.new", il, "", [b.cint(1)])
  u1 = b.call("list.push", il, "", [u1, b.iop(Op.Add, lim, b.cint(1))])
  let dir = b.mlog_newdir(b.m.types[t].fields[0].ty)
  let idx = b.call("list.new", il, "", [])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.add(Op.Struct, t, Aux.None, [dir, idx, u1, lim, b.mf(t, 4, mp), lim, b.cint(0), b.read(pv)]), b.cint(3), none]))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.claim[T](m) -> T: the log map m owning the next position of its
/// table (xo.mlog.claimk), its values following: the same value log when
/// it won, a fresh one for a first table or a fork (whose value level is
/// m's value log), the flatten's values in one.
fn (var b: Builder) mlog_claim(t: Int) -> Str {
  let it = b.int_t()
  let kt = mlog_k(b.m, t)
  let claimk = b.mlog_claimk(kt)
  let vals = b.mlog_vals(t)
  let vd = b.m.types[t].fields[1].ty
  let vtab = b.mlog_vtable(vd)
  let name = "xo.mlog.claim[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [t], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let wl = b.m.list(it)
  let r = b.call(claimk, b.mlog_claim_type(kt), "", [b.mf(t, 0, mp)])
  let k2 = b.add(Op.Field, kt, Aux.I(n: 0), [r])
  let how = b.add(Op.Field, it, Aux.I(n: 1), [r])
  let vpar = b.mf(t, 2, mp)
  let vpt = b.vty(vpar)
  let vlt = b.m.types[vpt].elems[0]
  let (nw, jw) = b.if_then_begin(b.bop(Op.Eq, how, b.cint(0)))
  b.retv(b.add(Op.SetField, t, Aux.I(n: 0), [mp, k2]))
  b.if_then_end(nw, jw)
  let (nf, jf) = b.if_then_begin(b.bop(Op.Eq, how, b.cint(1)))
  b.retv(b.add(Op.Struct, t, Aux.None, [k2, b.mlog_newdir(vd), vpar]))
  b.if_then_end(nf, jf)
  let (nl, jl) = b.if_then_begin(b.bop(Op.Eq, how, b.cint(2)))
  let vs = b.call(vals, b.m.types[vd].elems[0], "", [mp, b.add(Op.Field, wl, Aux.I(n: 2), [r])])
  b.retv(b.add(Op.Struct, t, Aux.None, [k2, b.call(vtab, vd, "", [vs]), b.call("list.new", vpt, "", [])]))
  b.if_then_end(nl, jl)
  // a fork: m's value log is the new parent level's, nearest first
  let vlvl = b.add(Op.Struct, vlt, Aux.None, [b.mf(t, 1, mp), b.call("list.new", b.m.types[vlt].fields[1].ty, "", [])])
  let np = b.call("list.len", it, "", [vpar])
  let pv = b.local()
  b.write_var(pv, b.call("list.new", vpt, "", [b.iop(Op.Add, np, b.cint(1))]))
  b.write_var(pv, b.call("list.push", vpt, "", [b.read(pv), vlvl]))
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(np, iv)
  b.write_var(pv, b.call("list.push", vpt, "", [b.read(pv), b.call("list.index", vlt, "", [vpar, i])]))
  b.for_up_to_end(i, iv, ih, ix)
  b.retv(b.add(Op.Struct, t, Aux.None, [k2, b.mlog_newdir(vd), b.read(pv)]))
  b.finish_fn()
  b.end(saved)
  name
}

/// The result of xo.mlog.recordk[K] for key side type t: (the key side,
/// the entry's own index, whether the table is to be flattened).
fn (var b: Builder) mlog_record_type(t: Int) -> Int {
  b.m.tuple([t, b.int_t(), b.bool_t()])
}

/// xo.mlog.recordk[K](m, h, k, del) -> mlog_record_type: an entry of k (a
/// tombstone when del) appended at the position the key side m claimed;
/// the caller appends its value at the same own index (xo.mlog.record),
/// then flattens when told (too much garbage, or a root's first index).
fn (var b: Builder) mlog_recordk(t: Int) -> Str {
  let it = b.int_t()
  let bt = b.bool_t()
  let et = mlog_entry_of(b.m, t)
  let el = b.m.list(et)
  let kt = mlog_key(b.m, t)
  let probe = b.mlog_probe(t)
  let find = b.mlog_find(t)
  let rt = b.mlog_record_type(t)
  let name = "xo.mlog.recordk[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, it, kt, bt], [rt], [])
  if fi < 0 {
    return name
  }
  let pt = b.m.tuple([it, it])
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let h = b.param(1)
  let k = b.param(2)
  let del = b.param(3)
  let base = b.mf(t, 3, mp)
  let lim = b.mf(t, 5, mp)
  let i = b.iop(Op.Sub, lim, base)
  let xv = b.local()
  b.write_var(xv, b.mf(t, 1, mp))
  let keysv = b.local()
  b.write_var(keysv, b.mf(t, 6, mp))
  let dv = b.local()
  b.write_var(dv, b.mf(t, 0, mp))
  let r0 = b.call(probe, pt, "", [b.read(dv), b.read(xv), base, lim, k, h])
  let j = b.add(Op.Field, it, Aux.I(n: 1), [r0])
  let slotv = b.local()
  b.write_var(slotv, b.add(Op.Field, it, Aux.I(n: 0), [r0]))
  // the origin: k's own newest entry's, else its parent view's
  let orgv = b.local()
  b.write_var(orgv, b.cint(-1))
  let (nj, jj) = b.if_then_begin(b.bop(Op.Ge, j, b.cint(0)))
  b.write_var(orgv, b.add(Op.Field, it, Aux.I(n: 2), [b.mlog_at(et, b.read(dv), b.iop(Op.Sub, j, base))]))
  b.if_then_end(nj, jj)
  let parents = b.mf(t, 7, mp)
  let has_parent = b.bop(Op.Gt, b.call("list.len", it, "", [parents]), b.cint(0))
  let (np, jp) = b.if_then_begin(b.add(Op.And, bt, Aux.None, [b.bop(Op.Lt, j, b.cint(0)), has_parent]))
  // a view of the parents alone: m with no entries of its own
  let pm = b.add(Op.SetField, t, Aux.I(n: 5), [mp, base])
  let w = b.call(find, it, "", [pm, k, h])
  let (nw, jw) = b.if_then_begin(b.bop(Op.Ge, w, b.cint(0)))
  b.write_var(orgv, b.add(Op.Field, it, Aux.I(n: 2), [b.mlog_entry_at(t, pm, w)]))
  b.if_then_end(nw, jw)
  b.if_then_end(np, jp)
  // a new key of the table: counted, the index made or grown. A root
  // table's first index is a flatten (its entries' hashes may be 0,
  // mlog_hash_if; mlog_table hashes them); a fork's own entries and an
  // indexed table's carry theirs
  let firstv = b.local()
  b.write_var(firstv, b.cbool(false))
  let (nk, jk) = b.if_then_begin(b.bop(Op.Lt, j, b.cint(0)))
  let keys1 = b.iop(Op.Add, b.read(keysv), b.cint(1))
  b.write_var(keysv, keys1)
  let nidx = b.call("list.len", it, "", [b.read(xv)])
  let make = b.bop(Op.Gt, keys1, b.cint(MLOG_SMALL))
  let full = b.bop(Op.Gt, b.iop(Op.Mul, keys1, b.cint(2)), nidx)
  let first = b.add(Op.And, bt, Aux.None, [b.bop(Op.Eq, nidx, b.cint(0)), b.add(Op.Not, bt, Aux.None, [has_parent])])
  let (nfi, jfi) = b.if_then_begin(b.add(Op.And, bt, Aux.None, [make, first]))
  b.write_var(firstv, b.cbool(true))
  b.if_then_end(nfi, jfi)
  let (ng, jg) = b.if_then_begin(b.add(Op.And, bt, Aux.None, [b.add(Op.And, bt, Aux.None, [make, full]), b.add(Op.Not, bt, Aux.None, [first])]))
  b.write_var(xv, b.mlog_build_index(t, b.read(dv), base, lim, keys1))
  let r1 = b.call(probe, pt, "", [b.read(dv), b.read(xv), base, lim, k, h])
  b.write_var(slotv, b.add(Op.Field, it, Aux.I(n: 0), [r1]))
  b.if_then_end(ng, jg)
  b.if_then_end(nk, jk)
  let nv = b.local()
  b.write_var(nv, b.mf(t, 4, mp))
  let (nd, jd) = b.if_then_begin(del)
  b.write_var(nv, b.iop(Op.Sub, b.read(nv), b.cint(1)))
  b.write_var(orgv, b.cint(-1))
  b.if_then_end(nd, jd)
  let (no, jo) = b.if_then_begin(b.add(Op.And, bt, Aux.None, [b.bop(Op.Lt, b.read(orgv), b.cint(0)), b.add(Op.Not, bt, Aux.None, [del])]))
  b.write_var(nv, b.iop(Op.Add, b.read(nv), b.cint(1)))
  b.write_var(orgv, lim)
  b.if_then_end(no, jo)
  let e = b.add(Op.Struct, et, Aux.None, [h, j, b.read(orgv), k])
  // the entry: a new chunk first when this position starts one
  let (c, _off) = b.mlog_slot(i)
  let (nc, jc) = b.if_then_begin(b.bop(Op.Eq, c, b.call("list.len", it, "", [b.read(dv)])))
  let chunk = b.call("list.new", el, "", [b.iop(Op.Shl, b.cint(1), c)])
  b.mlog_push(b.read(dv), chunk)
  b.if_then_end(nc, jc)
  let dir = b.read(dv)
  b.mlog_push(b.call("list.index", el, "", [dir, c]), e)
  let idx = b.read(xv)
  let (nx, jx) = b.if_then_begin(b.bop(Op.Gt, b.call("list.len", it, "", [idx]), b.cint(0)))
  b.rt("slot_store", -1, [idx, b.read(slotv), b.iop(Op.Add, i, b.cint(1)), b.cint(MLOG_REL)])
  b.if_then_end(nx, jx)
  let lim1 = b.iop(Op.Add, lim, b.cint(1))
  let n1 = b.read(nv)
  let m1 = b.add(Op.Struct, t, Aux.None, [dir, idx, b.mf(t, 2, mp), base, n1, lim1, b.read(keysv), parents])
  // too much garbage: flattened (a root's log past twice its keys and 32,
  // a fork's own entries past its keys and 32)
  let own1 = b.iop(Op.Add, i, b.cint(1))
  // a root's garbage past an eighth of its keys (and 32): only a shared
  // table gathers it from overwrites (its sole owner writes in place, put's
  // fast path), and a copy written all over then flattens early, as the
  // lists copy on the first write, and writes in place after
  let root_g = b.add(Op.And, bt, Aux.None, [b.add(Op.Not, bt, Aux.None, [has_parent]), b.bop(Op.Gt, b.iop(Op.Mul, lim1, b.cint(8)), b.iop(Op.Add, b.iop(Op.Mul, n1, b.cint(9)), b.cint(256)))])
  // (or past an eighth of its parents' log: a copy written all over, as
  // `var c = m` then a put of every key, becomes a root table early, whose
  // owner then writes in place: the lists' copy on first write, once)
  let fork_big = b.bop(Op.Gt, b.iop(Op.Mul, own1, b.cint(8)), b.iop(Op.Add, base, b.cint(256)))
  let fork_g = b.add(Op.And, bt, Aux.None, [has_parent, b.add(Op.Or, bt, Aux.None, [b.bop(Op.Gt, own1, b.iop(Op.Add, n1, b.cint(32))), fork_big])])
  let flat = b.add(Op.Or, bt, Aux.None, [b.add(Op.Or, bt, Aux.None, [root_g, fork_g]), b.read(firstv)])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [m1, i, flat]))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.record[T](m, h, k, v, del) -> T: an entry of k (a tombstone when
/// del, v then the removed value, kept so the value log follows the key
/// side's positions) appended at the position m claimed (xo.mlog.recordk),
/// and v at the same own index of the value log; flattened (the key side
/// by its xo.mlog.each, the values by its find results) when recordk says.
fn (var b: Builder) mlog_record(t: Int) -> Str {
  let it = b.int_t()
  let bt = b.bool_t()
  let kt = mlog_k(b.m, t)
  let et = mlog_entry_of(b.m, kt)
  let el = b.m.list(et)
  let wl = b.m.list(it)
  let recordk = b.mlog_recordk(kt)
  let each = b.mlog_each(kt)
  let vals = b.mlog_vals(t)
  let vd = b.m.types[t].fields[1].ty
  let vtab = b.mlog_vtable(vd)
  let name = "xo.mlog.record[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, it, mlog_key(b.m, kt), mlog_val(b.m, t), bt], [t], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let r = b.call(recordk, b.mlog_record_type(kt), "", [b.mf(t, 0, mp), b.param(1), b.param(2), b.param(4)])
  let k1 = b.add(Op.Field, kt, Aux.I(n: 0), [r])
  let i = b.add(Op.Field, it, Aux.I(n: 1), [r])
  let vdir = b.mf(t, 1, mp)
  b.mlog_vpush(vdir, i, b.param(3))
  let m1 = b.add(Op.Struct, t, Aux.None, [k1, vdir, b.mf(t, 2, mp)])
  let (nf, jf) = b.if_then_begin(b.add(Op.Field, bt, Aux.I(n: 2), [r]))
  let er = b.call(each, b.m.tuple([el, wl]), "", [k1])
  let vs = b.call(vals, b.m.types[vd].elems[0], "", [m1, b.add(Op.Field, wl, Aux.I(n: 1), [er])])
  b.retv(b.add(Op.Struct, t, Aux.None, [b.mlog_table(kt, b.add(Op.Field, el, Aux.I(n: 0), [er]), b.cint(0)), b.call(vtab, vd, "", [vs]), b.call("list.new", b.m.types[t].fields[2].ty, "", [])]))
  b.if_then_end(nf, jf)
  b.retv(m1)
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.putpos[K](m, k) -> Int: the own index of k's newest entry when
/// the key side m is the only value of a root table whose view is the
/// whole log and that entry is live (the put's fast path then replaces
/// its value in place, as the lists' put does: no claim, no new entry,
/// no garbage to flatten later), else -1.
fn (var b: Builder) mlog_putpos(t: Int) -> Str {
  let it = b.int_t()
  let bt = b.bool_t()
  let kt = mlog_key(b.m, t)
  let et = mlog_entry_of(b.m, t)
  let probe = b.mlog_probe(t)
  let name = "xo.mlog.putpos[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, kt], [it], [])
  if fi < 0 {
    return name
  }
  let pt = b.m.tuple([it, it])
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  // put owns m, so a caller that keeps its m retained it: the directory
  // and the claim cell then count two. A loop walking the table in place
  // (map.xo for_mlog_root) holds a count of its directory for the whole
  // walk, so the directory is never sole during a walk and a put in the
  // loop's body appends: a test here that stops reading the directory's
  // count would let the body change an entry the walk reads later.
  let used = b.mf(t, 2, mp)
  let (nt, jt) = b.if_then_begin(b.bop(Op.Gt, b.call("list.len", it, "", [used]), b.cint(0)))
  let dir = b.mf(t, 0, mp)
  let sole = b.add(Op.And, bt, Aux.None, [b.bop(Op.Eq, b.call("list.len", it, "", [b.mf(t, 7, mp)]), b.cint(0)), b.add(Op.And, bt, Aux.None, [b.mlog_sole(dir), b.mlog_sole(used)])])
  let (ns, js) = b.if_then_begin(sole)
  let lim = b.mf(t, 5, mp)
  let (nw, jw) = b.if_then_begin(b.bop(Op.Eq, b.rt("slot_load", it, [used, b.cint(0), b.cint(MLOG_ACQ)]), lim))
  let base = b.mf(t, 3, mp)
  let r = b.call(probe, pt, "", [dir, b.mf(t, 1, mp), base, lim, k, b.mlog_hash_if(t, mp, k)])
  let j = b.add(Op.Field, it, Aux.I(n: 1), [r])
  let (nj, jj) = b.if_then_begin(b.bop(Op.Ge, j, b.cint(0)))
  let i = b.iop(Op.Sub, j, base)
  let (no, jo) = b.if_then_begin(b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 2), [b.mlog_at(et, dir, i)]), b.cint(0)))
  b.retv(i)
  b.if_then_end(no, jo)
  b.if_then_end(nj, jj)
  b.if_then_end(nw, jw)
  b.if_then_end(ns, js)
  b.if_then_end(nt, jt)
  b.retv(b.cint(-1))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.mlog.put[T](m, k, v) -> T: v replaced in place at xo.mlog.putpos's
/// index when the value log is held once too, else a claim and a record.
fn (var b: Builder) mlog_put(t: Int) -> Str {
  let it = b.int_t()
  let bt = b.bool_t()
  let kt = mlog_k(b.m, t)
  let vt = mlog_val(b.m, t)
  let putpos = b.mlog_putpos(kt)
  let claim = b.mlog_claim(t)
  let record = b.mlog_record(t)
  let name = "xo.mlog.put[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, mlog_key(b.m, kt), vt], [t], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let v = b.param(2)
  let i = b.call(putpos, it, "", [b.mf(t, 0, mp), k])
  let vdir = b.mf(t, 1, mp)
  let (ni, ji) = b.if_then_begin(b.add(Op.And, bt, Aux.None, [b.bop(Op.Ge, i, b.cint(0)), b.mlog_sole(vdir)]))
  let (c, off) = b.mlog_slot(i)
  let chunk = b.call("list.index", b.m.types[b.vty(vdir)].elems[0], "", [vdir, c])
  b.mlog_share_into(chunk, v)
  b.call("log.set", -1, "", [chunk, off, v])
  b.retv(mp)
  b.if_then_end(ni, ji)
  let m1 = b.call(claim, t, "", [mp])
  b.retv(b.call(record, t, "", [m1, b.mlog_hash_if(kt, b.mf(t, 0, m1), k), k, v, b.cbool(false)]))
  b.finish_fn()
  b.end(saved)
  name
}

/// log.push of v into the borrowed list l (a chunk, or the directory),
/// with v marked shared first when l is (mlog_share_into).
fn (var b: Builder) mlog_push(l: Int, v: Int) {
  b.mlog_share_into(l, v)
  b.call("log.push", -1, "", [l, v])
}

/// Marks v shared when the list l it is about to be stored in has a
/// shared count: l's Map crossed threads (a Mutex's state, a task's
/// capture), and the mark walk that made l shared stops at objects that
/// are shared already (rc.mark), so it will not reach v later; v read
/// by another thread with thread local counts was a data race that
/// corrupted the heap under concurrent HTTP load (2026-10-21,
/// gotchas/map-log-store-into-shared-chunk.md). A chunk or directory is
/// never immortal, so a negative count is a shared one.
fn (var b: Builder) mlog_share_into(l: Int, v: Int) {
  let vt = b.vty(v)
  if !b.m.heap(vt) {
    // nothing in v is counted (a Map[Int, Int]'s entry)
    return
  }
  if b.wasm {
    // one thread: no count is ever shared
    return
  }
  let (ns, js) = b.if_then_begin(b.bop(Op.Lt, b.obj_count(l), b.cint(0)))
  b.add(Op.Share, -1, Aux.None, [v])
  b.if_then_end(ns, js)
}

/// Whether the object of list l has one reference (thread local): the
/// Map value holding it is its only holder.
fn (var b: Builder) mlog_sole(l: Int) -> Int {
  b.bop(Op.Eq, b.obj_count(l), b.cint(1))
}

/// The reference count of the object of the counted value l (a list),
/// read in place: the native runtimes keep an Int at the object's
/// start (rc.xo: negative when shared, INT64_MIN immortal); the wasm
/// runtime an i32, then the list's i32 length (compiler/wasm gen.xo),
/// so a word read there is cut to its low half (unsigned: the
/// immortal i32 minimum reads 2^31) (the
/// hybrid's put fast path once read count + length << 32 there and lost
/// writes on wasm, 2026-10-21).
fn (var b: Builder) obj_count(l: Int) -> Int {
  let it = b.int_t()
  let w = b.rt("slot_load", it, [b.rt("obj_addr", it, [l]), b.cint(0), b.cint(0)])
  if !b.wasm {
    return w
  }
  b.iop(Op.And, w, b.cint(4294967295))
}

/// The capacity of list l, read in place: word 2 of a native list (obj.xo
/// rl_new), the i32 at byte 8 of a wasm one (compiler/wasm gen.xo).
fn (var b: Builder) list_cap(l: Int) -> Int {
  let it = b.int_t()
  let a = b.rt("obj_addr", it, [l])
  if b.wasm {
    return b.iop(Op.And, b.rt("slot_load", it, [a, b.cint(1), b.cint(0)]), b.cint(4294967295))
  }
  b.rt("slot_load", it, [a, b.cint(2), b.cint(0)])
}

/// obj_count of an immortal object (a literal, the shared empty list).
fn (var b: Builder) immortal_count() -> Int {
  if b.wasm { b.cint(2147483648) } else { b.iop(Op.Sub, b.cint(-9223372036854775807), b.cint(1)) }
}

/// xo.mlog.remove[T](m, k) -> (T, V?).
fn (var b: Builder) mlog_remove(t: Int, ot: Int) -> Str {
  let it = b.int_t()
  let kt = mlog_k(b.m, t)
  let find = b.mlog_find(kt)
  let claim = b.mlog_claim(t)
  let record = b.mlog_record(t)
  let rt = b.m.tuple([t, ot])
  let name = "xo.mlog.remove[${b.m.types[t].name}]${opt_suffix(b.m, mlog_val(b.m, t), ot)}"
  let fi = b.thunk_func(name, [t, mlog_key(b.m, kt)], [rt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let kl = b.mf(t, 0, mp)
  let h = b.mlog_hash_if(kt, kl, k)
  let w = b.call(find, it, "", [kl, k, h])
  let (no, join) = b.if_then_begin(b.bop(Op.Lt, w, b.cint(0)))
  let none = b.add(Op.Variant, ot, Aux.I(n: b.m.variant_index(ot, "None")), [])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [mp, none]))
  b.if_then_end(no, join)
  let old = b.mlog_value_at(t, mp, w)
  let m1 = b.call(claim, t, "", [mp])
  // h again only when mp had none and the claim made a table that needs
  // one (a fork, whose parents are probed by hash)
  let h2v = b.local()
  b.write_var(h2v, h)
  let mp_plain = b.add(Op.And, b.bool_t(), Aux.None, [b.bop(Op.Eq, b.call("list.len", it, "", [b.mf(kt, 1, kl)]), b.cint(0)), b.bop(Op.Eq, b.call("list.len", it, "", [b.mf(kt, 7, kl)]), b.cint(0))])
  let (nq, jq) = b.if_then_begin(mp_plain)
  b.write_var(h2v, b.mlog_hash_if(kt, b.mf(t, 0, m1), k))
  b.if_then_end(nq, jq)
  let m2 = b.call(record, t, "", [m1, b.read(h2v), k, old, b.cbool(true)])
  let some = b.add(Op.Variant, ot, Aux.I(n: b.m.variant_index(ot, "Some")), [old])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [m2, some]))
  b.finish_fn()
  b.end(saved)
  name
}

/// The find of k in the log map value mv (of type t): -1 or a result for
/// mlog_value_at.
fn (var b: Builder) mlog_lookup(t: Int, mv: Int, k: Int) -> Int {
  let it = b.int_t()
  let kt = mlog_k(b.m, t)
  let kl = b.mf(t, 0, mv)
  b.call(b.mlog_find(kt), it, "", [kl, k, b.mlog_hash_if(kt, kl, k)])
}

/// k's hash when map m's table has an index or parents (whose indexes
/// it is probed in), else 0: a small table is scanned by its keys and
/// keeps no hashes (an HTTP request's headers, 2026-10-21: hashing each
/// name was 446 instructions a request), and mlog_table hashes them when
/// it indexes.
fn (var b: Builder) mlog_hash_if(t: Int, m: Int, k: Int) -> Int {
  let it = b.int_t()
  let hv = b.local()
  b.write_var(hv, b.cint(0))
  let plain = b.add(Op.And, b.bool_t(), Aux.None, [b.bop(Op.Eq, b.call("list.len", it, "", [b.mf(t, 1, m)]), b.cint(0)), b.bop(Op.Eq, b.call("list.len", it, "", [b.mf(t, 7, m)]), b.cint(0))])
  let (np, jp) = b.if_then_begin(b.add(Op.Not, b.bool_t(), Aux.None, [plain]))
  b.write_var(hv, b.call(b.hash_func(mlog_key(b.m, t)), it, "", [k]))
  b.if_then_end(np, jp)
  b.read(hv)
}

/// xo.mlog.kv[T](m) -> (List[K], List[V]): the live entries' keys and
/// values in order, from one pass (map.xo map_kvl).
fn (var b: Builder) mlog_kv(t: Int) -> Str {
  let it = b.int_t()
  let ktt = mlog_k(b.m, t)
  let et = mlog_entry_of(b.m, ktt)
  let kt = mlog_key(b.m, ktt)
  let vt = mlog_val(b.m, t)
  let each = b.mlog_each(ktt)
  let vals = b.mlog_vals(t)
  let kl = b.m.list(kt)
  let vl = b.m.list(vt)
  let el = b.m.list(et)
  let wl = b.m.list(it)
  let rt = b.m.tuple([kl, vl])
  let name = "xo.mlog.kv[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [rt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let er = b.call(each, b.m.tuple([el, wl]), "", [b.mf(t, 0, mp)])
  let es = b.add(Op.Field, el, Aux.I(n: 0), [er])
  let n = b.call("list.len", it, "", [es])
  let ks = b.local()
  b.write_var(ks, b.call("list.new", kl, "", [n]))
  let iv = b.local()
  let (i, head, exit) = b.for_up_to_begin(n, iv)
  let e = b.call("list.index", et, "", [es, i])
  b.write_var(ks, b.call("list.push", kl, "", [b.read(ks), b.add(Op.Field, kt, Aux.I(n: 3), [e])]))
  b.for_up_to_end(i, iv, head, exit)
  let vs = b.call(vals, vl, "", [mp, b.add(Op.Field, wl, Aux.I(n: 1), [er])])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.read(ks), vs]))
  b.finish_fn()
  b.end(saved)
  name
}

/// The function that lists the live entries' keys (what 0), values (1),
/// or (key, value) tuples (2) in order.
fn (var b: Builder) mlog_list(t: Int, what: Int) -> Str {
  let it = b.int_t()
  let ktt = mlog_k(b.m, t)
  let et = mlog_entry_of(b.m, ktt)
  let kt = mlog_key(b.m, ktt)
  let vt = mlog_val(b.m, t)
  let each = b.mlog_each(ktt)
  let vals = b.mlog_vals(t)
  let pair = b.m.tuple([kt, vt])
  let xt = [kt, vt, pair][what]
  let lt = b.m.list(xt)
  let el = b.m.list(et)
  let wl = b.m.list(it)
  let vl = b.m.list(vt)
  let name = "${["xo.mlog.keys[", "xo.mlog.values[", "xo.mlog.entries["][what]}${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [lt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let er = b.call(each, b.m.tuple([el, wl]), "", [b.mf(t, 0, mp)])
  if what == 1 {
    b.retv(b.call(vals, vl, "", [mp, b.add(Op.Field, wl, Aux.I(n: 1), [er])]))
  } else {
    let es = b.add(Op.Field, el, Aux.I(n: 0), [er])
    var vs = -1
    if what == 2 {
      vs = b.call(vals, vl, "", [mp, b.add(Op.Field, wl, Aux.I(n: 1), [er])])
    }
    let n = b.call("list.len", it, "", [es])
    let out = b.local()
    b.write_var(out, b.call("list.new", lt, "", [n]))
    let iv = b.local()
    let (i, head, exit) = b.for_up_to_begin(n, iv)
    let k = b.add(Op.Field, kt, Aux.I(n: 3), [b.call("list.index", et, "", [es, i])])
    var x = k
    if what == 2 {
      x = b.add(Op.Tuple, pair, Aux.None, [k, b.call("list.index", vt, "", [vs, i])])
    }
    b.write_var(out, b.call("list.push", lt, "", [b.read(out), x]))
    b.for_up_to_end(i, iv, head, exit)
    b.retv(b.read(out))
  }
  b.finish_fn()
  b.end(saved)
  name
}
