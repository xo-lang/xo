// The no GC check (internal/ssa nogc.go, decision 0083): what the builder
// recorded as unsupported, as XO1201 diagnostics at the sites. `xo check
// --no-gc` (compiler/cli/core) and xo1's native builds report them.

use github.com/xo-lang/xo/compiler/check

/// One construct the builder does not lower (build.go Error): the file
/// as the checker names it ("" without a position), the span, the
/// feature, and whether no native backend can ever support it.
pub struct BuildErr {
  pub file: Str
  pub span: Span
  pub feature: Str
  pub impossible: Bool
}

/// Records what at the expression being lowered, once per position and
/// feature (build.go unsupportedKind).
fn (var b: Builder) record_err(what: Str, never: Bool) {
  var file = ""
  if b.at_file >= 0 && b.at_file < b.c.files.len() {
    file = b.c.files[b.at_file].path
  }
  let key = "${file}:${b.at.start.line}:${b.at.start.col}:${what}"
  if b.seen_err.contains(key) {
    return
  }
  b.seen_err[key] = true
  b.errs.push(BuildErr{file: file, span: b.at, feature: what, impossible: never})
}

/// The XO1201 diagnostics of the build (NoGCDiagnostics), unsorted: an
/// error overlapping the source range of one kept before it is a
/// consequence of it and left out (core 10.2: never cascade).
pub fn nogc_diags(b: Builder) -> List[check.Diag] {
  var kept: List[BuildErr] = []
  // a native body's check errors (check_lazy) first, as themselves; an
  // XO1201 among them with no position is a cascade of one with a
  // position (a body with a syntax error stands as an empty block)
  let positioned = b.lazy_diags.any(fn(d) { d.code != "XO1201" && !d.file.is_empty() })
  var out: List[check.Diag] = b.lazy_diags.filter(fn(d) { !(positioned && d.code == "XO1201" && d.file.is_empty()) })
  // the uses of each `use go` package by file: one diagnostic at its
  // `use go` line instead of one per call (0.33.0 tester's bug 17)
  var go_uses: Map[Str, Int] = {}
  var go_order: List[(Str, Str, Str)] = []
  // a Go package's types (reported with no position) are named in its
  // diagnostic, and std/go's types (go.Error, go.Any), which only `use
  // go` code uses, in a note of the first (owner's v0.36.0 evaluation: 19
  // errors for one program, one per Go package, type and use)
  var go_types: Map[Str, List[Str]] = {}
  var go_types_order: List[Str] = []
  var std_go: List[BuildErr] = []
  var lazy_files: Map[Str, Bool] = {}
  for d in b.lazy_diags {
    lazy_files[d.file] = true
  }
  for e in b.errs {
    if cascades(e, kept) {
      continue
    }
    // an error type comes from a check error, reported as itself
    if !b.lazy_diags.is_empty() && e.feature.contains("<error>") {
      continue
    }
    // so does what the builder could not lower in a file with a check
    // error, or with no position: a body with a syntax error stands as an
    // empty block (`()` where an Int is due), a mistyped call as an
    // unsupported conversion, and an XO1201 printed first hid the real
    // error (owner, 2026-11-05, from the agents' survey; core 10.2)
    if !lazy_files.is_empty() && (e.file.is_empty() || lazy_files.contains(e.file)) {
      continue
    }
    let gp = go_package_of(e)
    if !gp.is_empty() && e.file.is_empty() {
      let nm = go_type_name(e)
      var l = go_types.get(gp) ?? []
      if l.is_empty() {
        go_types_order.push(gp)
      }
      if !nm.is_empty() && !l.contains(nm) {
        l.push(nm)
      }
      go_types[gp] = l
      continue
    }
    if gp.is_empty() && is_std_go_type(e) {
      // kept, so what overlaps it (the Debug text of go.Error at the
      // same `?`) is still its cascade
      kept.push(e)
      std_go.push(e)
      continue
    }
    if !gp.is_empty() && !e.file.is_empty() {
      let key = "${e.file}\n${gp}"
      if let Some(n) = go_uses.get(key) {
        go_uses[key] = n + 1
      } else {
        go_uses[key] = 1
        go_order.push((key, e.file, gp))
      }
      continue
    }
    kept.push(e)
    out.push(nogc_diag(e))
  }
  var std_note = ""
  if !std_go.is_empty() && (!go_order.is_empty() || !go_types_order.is_empty()) {
    var names: List[Str] = []
    for e in std_go {
      let nm = go_type_name(e)
      if !nm.is_empty() && !names.contains(nm) {
        names.push(nm)
      }
    }
    std_note = "std/go's ${names.join(", ")}, which `use go` code uses, is part of this"
  } else {
    for e in std_go {
      out.push(nogc_diag(e))
    }
  }
  var named: Set[Str] = #{}
  for (key, file, gp) in go_order {
    // the package's types go with its first diagnostic
    let types = if named.contains(gp) { [] } else { go_types.get(gp) ?? [] }
    named.add(gp)
    out.push(go_use_diag(b, file, gp, go_uses.get(key) ?? 1, types, std_note))
    std_note = ""
  }
  // a package whose only uses are types (no position of its own)
  for gp in go_types_order {
    if !named.contains(gp) {
      out.push(go_use_diag(b, "", gp, 0, go_types.get(gp) ?? [], std_note))
      std_note = ""
    }
  }
  out
}

/// The name in a feature "the type `T` ..." (build.xo's record of a
/// type), or "".
fn go_type_name(e: BuildErr) -> Str {
  let mark = "the type `"
  if !e.feature.starts_with(mark) {
    return ""
  }
  let rest = e.feature[mark.len()..]
  let j = rest.find("`") ?? return ""
  rest[0..j]
}

/// A construct of std's go module's types (go.Error, go.Any: the type,
/// its Debug text): planned on the native backends, and used only by
/// `use go` code.
fn is_std_go_type(e: BuildErr) -> Bool { e.feature.contains("`go.Error`") || e.feature.contains("`go.Any`") }

/// The Go package a construct of a `use go` package names (the
/// impossible features of call.xo and build.xo: "... of the Go package
/// `P` (`use go`)"), or "".
fn go_package_of(e: BuildErr) -> Str {
  if !e.impossible {
    return ""
  }
  let mark = " of the Go package `"
  let i = e.feature.find(mark) ?? return ""
  let rest = e.feature[i + mark.len()..]
  let j = rest.find("` (`use go`)") ?? return ""
  rest[0..j]
}

/// The one XO1201 of the n uses of Go package gp in file: at its `use go`
/// declaration when the file has one, else at the first use; types are
/// the package's types the program uses, and std_note ("" for none) a
/// note naming std/go's types.
fn go_use_diag(b: Builder, file: Str, gp: Str, n: Int, types: List[Str], std_note: Str) -> check.Diag {
  var line = 0
  var col = 0
  var end_line = 0
  var end_col = 0
  for f in b.c.files {
    if f.path != file {
      continue
    }
    for (_, imp) in f.imports {
      if imp.module >= 0 && b.c.mods[imp.module].go_path == gp && imp.span.start.line > 0 {
        line = imp.span.start.line
        col = imp.span.start.col
        end_line = imp.span.end.line
        end_col = imp.span.end.col
      }
    }
  }
  if line == 0 {
    for e in b.errs {
      if e.file == file && go_package_of(e) == gp {
        line = e.span.start.line
        col = e.span.start.col
        end_line = e.span.end.line
        end_col = e.span.end.col
        break
      }
    }
  }
  var what: List[Str] = []
  if n > 0 {
    what.push(if n == 1 { "1 use in this file" } else { "${n} uses in this file" })
  }
  if !types.is_empty() {
    what.push("its types ${types.join(", ")}")
  }
  let msg = "not available on the native backends (arm64, amd64, LLVM): the Go package `${gp}` (`use go`, ${what.join("; ")}) (impossible: Go code needs Go's runtime)"
  var notes = [check.DNote{message: "support: impossible; build with --backend=go to use it"}]
  if !std_note.is_empty() {
    notes.push(check.DNote{message: std_note})
  }
  check.Diag{code: "XO1201", file: file, line: line, col: col, end_line: end_line, end_col: end_col, message: msg, notes: notes}
}

fn before(al: Int, ac: Int, bl: Int, bc: Int) -> Bool {
  al < bl || (al == bl && ac < bc)
}

fn cascades(e: BuildErr, kept: List[BuildErr]) -> Bool {
  if e.file.is_empty() {
    return false
  }
  let es = e.span
  for k in kept {
    if k.file != e.file {
      continue
    }
    let ks = k.span
    // overlap: neither ends before the other starts
    if before(es.end.line, es.end.col, ks.start.line, ks.start.col) || before(ks.end.line, ks.end.col, es.start.line, es.start.col) {
      continue
    }
    if (es.end.line == ks.start.line && es.end.col == ks.start.col) || (ks.end.line == es.start.line && ks.end.col == es.start.col) {
      continue
    }
    return true
  }
  false
}

/// The XO1201 diagnostic of one construct (NoGCDiagnostic).
fn nogc_diag(e: BuildErr) -> check.Diag {
  let msg = if e.impossible {
    "not available on the native backends (arm64, amd64, LLVM): ${e.feature} (impossible: Go code needs Go's runtime)"
  } else {
    "not available on the native backends (arm64, amd64, LLVM) yet: ${e.feature} (support is planned)"
  }
  // the native backends build by default (decision 0248), so the message
  // names them, not --no-gc, which the build may not have been given
  // (field report 0.26.0)
  let note = if e.impossible {
    "support: impossible; build with --backend=go to use it"
  } else {
    "support: planned; build with --backend=go to use it until then"
  }
  check.Diag{code: "XO1201", file: e.file, line: e.span.start.line, col: e.span.start.col, end_line: e.span.end.line, end_col: e.span.end.col, message: msg, notes: [check.DNote{message: note}]}
}
