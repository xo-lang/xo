// The no GC check (internal/ssa nogc.go, decision 0083): what the builder
// recorded as unsupported, as XO1201 diagnostics at the sites. `xo check
// --no-gc` (compiler/cli/core) and xo1's native builds report them.

use github.com/xo-lang/xo/compiler/check

/// One construct the builder does not lower (build.go Error): the file
/// as the checker names it ("" without a position), the span, the
/// feature, and whether no native backend can ever support it.
pub struct BuildErr {
  pub file: Str
  pub span: Span
  pub feature: Str
  pub impossible: Bool
}

/// Records what at the expression being lowered, once per position and
/// feature (build.go unsupportedKind).
fn (var b: Builder) record_err(what: Str, never: Bool) {
  var file = ""
  if b.at_file >= 0 && b.at_file < b.c.files.len() {
    file = b.c.files[b.at_file].path
  }
  let key = "${file}:${b.at.start.line}:${b.at.start.col}:${what}"
  if b.seen_err.contains(key) {
    return
  }
  b.seen_err[key] = true
  b.errs.push(BuildErr{file: file, span: b.at, feature: what, impossible: never})
}

/// The XO1201 diagnostics of the build (NoGCDiagnostics), unsorted: an
/// error overlapping the source range of one kept before it is a
/// consequence of it and left out (core 10.2: never cascade).
pub fn nogc_diags(b: Builder) -> List[check.Diag] {
  var kept: List[BuildErr] = []
  // a native body's check errors (check_lazy) first, as themselves
  var out: List[check.Diag] = b.lazy_diags
  // the uses of each `use go` package by file: one diagnostic at its
  // `use go` line instead of one per call (0.33.0 tester's bug 17)
  var go_uses: Map[Str, Int] = {}
  var go_order: List[(Str, Str, Str)] = []
  for e in b.errs {
    if cascades(e, kept) {
      continue
    }
    // an error type comes from a check error, reported as itself
    if !b.lazy_diags.is_empty() && e.feature.contains("<error>") {
      continue
    }
    let gp = go_package_of(e)
    if !gp.is_empty() && !e.file.is_empty() {
      let key = "${e.file}\n${gp}"
      if let Some(n) = go_uses.get(key) {
        go_uses[key] = n + 1
      } else {
        go_uses[key] = 1
        go_order.push((key, e.file, gp))
      }
      continue
    }
    kept.push(e)
    out.push(nogc_diag(e))
  }
  for (key, file, gp) in go_order {
    out.push(go_use_diag(b, file, gp, go_uses.get(key) ?? 1))
  }
  out
}

/// The Go package a construct of a `use go` package names (the
/// impossible features of call.xo and build.xo: "... of the Go package
/// `P` (`use go`)"), or "".
fn go_package_of(e: BuildErr) -> Str {
  if !e.impossible {
    return ""
  }
  let mark = " of the Go package `"
  let i = e.feature.find(mark) ?? return ""
  let rest = e.feature[i + mark.len()..]
  let j = rest.find("` (`use go`)") ?? return ""
  rest[0..j]
}

/// The one XO1201 of the n uses of Go package gp in file: at its `use go`
/// declaration when the file has one, else at the first use.
fn go_use_diag(b: Builder, file: Str, gp: Str, n: Int) -> check.Diag {
  var line = 0
  var col = 0
  var end_line = 0
  var end_col = 0
  for f in b.c.files {
    if f.path != file {
      continue
    }
    for (_, imp) in f.imports {
      if imp.module >= 0 && b.c.mods[imp.module].go_path == gp && imp.span.start.line > 0 {
        line = imp.span.start.line
        col = imp.span.start.col
        end_line = imp.span.end.line
        end_col = imp.span.end.col
      }
    }
  }
  if line == 0 {
    for e in b.errs {
      if e.file == file && go_package_of(e) == gp {
        line = e.span.start.line
        col = e.span.start.col
        end_line = e.span.end.line
        end_col = e.span.end.col
        break
      }
    }
  }
  let count = if n == 1 { "1 use" } else { "${n} uses" }
  let msg = "not available on the native backends (arm64, amd64, LLVM): the Go package `${gp}` (`use go`, ${count} in this file) (impossible: Go code needs Go's runtime)"
  check.Diag{code: "XO1201", file: file, line: line, col: col, end_line: end_line, end_col: end_col, message: msg, notes: [check.DNote{message: "support: impossible; build with --backend=go to use it"}]}
}

fn before(al: Int, ac: Int, bl: Int, bc: Int) -> Bool {
  al < bl || (al == bl && ac < bc)
}

fn cascades(e: BuildErr, kept: List[BuildErr]) -> Bool {
  if e.file.is_empty() {
    return false
  }
  let es = e.span
  for k in kept {
    if k.file != e.file {
      continue
    }
    let ks = k.span
    // overlap: neither ends before the other starts
    if before(es.end.line, es.end.col, ks.start.line, ks.start.col) || before(ks.end.line, ks.end.col, es.start.line, es.start.col) {
      continue
    }
    if (es.end.line == ks.start.line && es.end.col == ks.start.col) || (ks.end.line == es.start.line && ks.end.col == es.start.col) {
      continue
    }
    return true
  }
  false
}

/// The XO1201 diagnostic of one construct (NoGCDiagnostic).
fn nogc_diag(e: BuildErr) -> check.Diag {
  let msg = if e.impossible {
    "not available on the native backends (arm64, amd64, LLVM): ${e.feature} (impossible: Go code needs Go's runtime)"
  } else {
    "not available on the native backends (arm64, amd64, LLVM) yet: ${e.feature} (support is planned)"
  }
  // the native backends build by default (decision 0248), so the message
  // names them, not --no-gc, which the build may not have been given
  // (field report 0.26.0)
  let note = if e.impossible {
    "support: impossible; build with --backend=go to use it"
  } else {
    "support: planned; build with --backend=go to use it until then"
  }
  check.Diag{code: "XO1201", file: e.file, line: e.span.start.line, col: e.span.start.col, end_line: e.span.end.line, end_col: e.span.end.col, message: msg, notes: [check.DNote{message: note}]}
}
