// Calls (internal/ssa build_call.go, build_native.go, the stage 1 part of
// build_io.go and build_int.go): constructors, conversions, declared
// functions and methods, std functions with native implementations, the
// prelude operations lowered inline, closures, function values, and `?`.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser
use github.com/xo-lang/xo/compiler/lexer

fn call_parts(e: Expr) -> (Span, Expr, List[parser.Arg]) {
  match e {
    CallExpr(span: span, fun: fun, args: args) => (span, fun, args)
    _ => fault("not a call")
  }
}

fn (var b: Builder) call_expr(x: Expr) -> Int {
  let (_, fun, args) = call_parts(x)
  if !b.s.olds.is_empty() {
    if let Some(v) = b.s.olds.get(b.c.expr_key_in(b.s.file, x)) {
      return v
    }
  }
  if let Some(vr) = b.c.ctor_in(b.s.file, x) {
    return b.ctor_call(vr, x)
  }
  if let Some(vr) = b.c.ctor_in(b.s.file, fun) {
    return b.ctor_call(vr, x)
  }
  if b.is_ret_ctor(x) {
    return b.ret_ctor(x)
  }
  let tobj = b.c.type_call_in(b.s.file, x)
  if tobj >= 0 {
    return b.type_call(tobj, x)
  }
  if b.is_expect_call(x) {
    return b.expect_call(x)
  }
  let cio = b.c.call_in(b.s.file, x)
  let ci = match cio {
    Some(c) => c
    None => {
      if let SelectorExpr(x: recv, sel: sel, ..) = fun {
        let sn = sel.name
        if (args.len() == 1 && (sn == b"min" || sn == b"max")) || (args.len() == 2 && sn == b"clamp") {
          // a variable or field path receiver is read after the
          // arguments (decision 0326)
          let late = recv_after_args(recv)
          var a = if late { -1 } else { b.expr(recv) }
          let at = if late { b.nat_of(recv) } else { b.vty(a) }
          if sn == b"clamp" {
            let lo = b.value_as(args[0].value, at)
            let hi = b.value_as(args[1].value, at)
            if late {
              a = b.expr(recv)
            }
            let r = b.ord_min_max("max", a, lo)
            if r >= 0 {
              return b.ord_min_max("min", r, hi)
            }
          } else {
            let o = b.value_as(args[0].value, at)
            if late {
              a = b.expr(recv)
            }
            let r = b.ord_min_max(check.text(sn), a, o)
            if r >= 0 {
              return r
            }
          }
        }
        if args.len() == 1 && sn == b"cmp" {
          // `a.cmp(b)` on an Ord type (decision 0586)
          let late = recv_after_args(recv)
          var a = if late { -1 } else { b.expr(recv) }
          let at = if late { b.nat_of(recv) } else { b.vty(a) }
          let o = b.value_as(args[0].value, at)
          if late {
            a = b.expr(recv)
          }
          return b.ord_cmp(b.nat_of(x), a, o)
        }
        if args.is_empty() && sn == b"display" {
          let ct = b.nat_check(recv)
          let v = b.expr(recv)
          return b.append_display(b.const_str(""), v, ct)
        }
        if args.is_empty() && sn == b"debug" {
          let ct = b.nat_check(recv)
          let v = b.expr(recv)
          return b.append_debug(b.const_str(""), v, ct)
        }
      }
      b.unsupported("this call")
      return b.undef(b.nat_of(x))
    }
  }
  let fo = ci.fn_obj
  if fo < 0 {
    return b.value_call(x)
  }
  let fr = b.c.objs[fo].recv
  if b.c.objs[fo].flags.iface() && fr >= 0 && (!b.is_prelude_mod(b.obj_mod(fr)) || b.dyn_iface(fr) || (b.obj_name(fr) is "Stream" | "NetConn" | "Secrets" | "Keyring" | "Keychain" | "Dpapi")) {
    // not a capability's method (those are lowered as std calls); the
    // prelude's Stream (decision 0280), NetConn (decision 0481), Secrets
    // and Keyring (decision 0584) are ordinary interfaces
    return b.iface_call(x, ci)
  }
  let fm = b.obj_mod(fo)
  if b.wasm && fm >= 0 {
    let w = wasi_served(b.c.mods[fm].path, b.c.objs[fo].name)
    if !w.is_empty() {
      // the native runtime's own body reads what a WASI module does not
      // have; the wasm runtime serves the call
      var vs: List[Int] = []
      for a in args {
        vs.push(b.expr(a.value))
      }
      return b.rt(w, if w == "rand_bytes" { b.str_t() } else { b.nat_of(x) }, vs)
    }
  }
  if fm >= 0 && !b.c.mods[fm].go_path.is_empty() {
    b.impossible("`${b.c.mods[fm].name}.${b.c.display_name(fo)}` of the Go package `${b.c.mods[fm].go_path}` (`use go`)")
    return b.undef(b.nat_of(x))
  }
  if fm >= 0 && !b.c.mods[fm].c_prefix.is_empty() && !b.derived_in_c(fm, fo) {
    return b.c_call(x, ci)
  }
  if let Some(v) = b.fs_user_call(x, fo) {
    return v
  }
  if (b.is_std_mod(fm) || b.native_part(fo)) && !b.derived_in_c(fm, fo) {
    let path = b.c.mods[fm].path
    if path.starts_with("native/") {
      return b.intrinsic(x, ci)
    }
    if let Some(v) = b.map_values_hof(x, ci) {
      return v
    }
    if let Some(v) = b.test_call(x, ci) {
      return v
    }
    if let Some(v) = b.user_cap_call(x, ci) {
      return v
    }
    if b.is_proc_run(fo) {
      b.set_flag(1)
      if !b.conc {
        return b.conc_off(b.nat_of(x))
      }
      let pm = b.native_mod("std/prelude")
      if pm >= 0 {
        let impl = b.member(pm, "proc_run")
        if impl >= 0 && b.c.objs[impl].kind == check.ObjKind.Func && b.c.objs[impl].recv < 0 {
          return b.call_as(x, ci, impl)
        }
      }
    }
    if let Some(v) = b.mem_fs_call(x, ci) {
      return v
    }
    if b.native_waits(fo) {
      b.set_flag(1)
      if !b.conc {
        return b.conc_off(b.nat_of(x))
      }
    }
    if b.net_waits(fo) {
      // and the network's runtime exports (cabi_net), which netconn's
      // handles name
      b.set_flag(2)
      b.set_flag(1)
      if !b.conc {
        return b.conc_off(b.nat_of(x))
      }
    }
    if let Some(v) = b.word_method(x, ci) {
      return v
    }
    if let Some(v) = b.list_move_call(x, ci) {
      return v
    }
    // Map.clone copies the hybrid map's storage in bulk (xo.maph.clone),
    // where the native body puts each entry (decision 0592)
    if b.m.map_log && b.c.display_name(fo) == "Map.clone" {
      let ct = b.nat_of(ci.recv[0])
      if b.m.types[ct].coll && b.m.types[ct].fields.len() == 6 {
        let f = b.maph_clone(ct)
        return b.call(f, ct, "", [b.expr(ci.recv[0])])
      }
    }
    // Float.fma on arm64 is one instruction (decision 0385 stage 2): the
    // native body (gomath.fma) is the other targets'
    let impl = if b.goarch == "arm64" && b.c.display_name(fo) == "Float.fma" { -1 } else { b.impl_of(fo) }
    if impl >= 0 {
      // a dependency's log record carries the dependency (decision
      // 0173): set just before the call, after its arguments (call_as)
      b.pend_log_from = b.log_from(fo)
      let lvl = b.lazy_log_level(fo)
      if lvl > 0 && b.prelude_impl("llrt_log_enabled") >= 0 {
        // a record below the configured level does not evaluate its
        // arguments (decision 0558)
        let f = b.declare(b.prelude_impl("llrt_log_enabled"), [])
        let en = b.call(b.m.funcs[f].name, b.bool_t(), "", [b.cint(lvl)])
        let (no, join) = b.if_then_begin(en)
        let _r = b.call_as(x, ci, impl)
        b.if_then_end(no, join)
        return b.unit()
      }
      return b.call_as(x, ci, impl)
    }
    if let Some(v) = b.io_call(x, ci) {
      return v
    }
    if b.is_conc_call(fo) {
      return b.conc_call(x, ci)
    }
    // the std module under test (`xo test --std-module`, the run's root
    // std module): a function of its own with a body is built from that
    // body, as a program's is, since its test file calls it through the
    // private access the test has (2026-10-25: the call was XO1201 "the
    // std function `probe.seven`", as only the std API lowerings above
    // could answer it)
    // a std module merged with its implementation (decision 0588,
    // std/merged.txt) is built from its bodies in every program
    let fd = b.c.objs[fo].fn_decl
    if (b.c.mods[fm].root || b.c.mods[fm].merged) && !fd.is_empty() && (fd[0].body != None || fd[0].lazy != None) {
      return b.call_as(x, ci, fo)
    }
    return b.std_call(x, ci)
  }
  if fm >= 0 && b.c.mods[fm].path == "native/llrt/cpu" && !b.wasm {
    if let Some(v) = b.cpu_call(x, ci) {
      return v
    }
  }
  b.call_as(x, ci, fo)
}

/// A call of std/native/llrt/cpu.xo's functions the native emitters
/// lower to instructions (decision 0231): rt.<name>, with the arguments
/// of the call; None for the others, and in a wasm module (their Xo
/// bodies run there, as with an older xo, which does not know them).
fn (var b: Builder) cpu_call(x: Expr, ci: check.CallInfo) -> Int? {
  let fo = ci.fn_obj
  let name = match b.obj_name(fo) {
    "carry" => "u64_carry"
    "borrow" => "u64_borrow"
    "adc" => "u64_adc"
    "adc_carry" => "u64_adc_carry"
    "mul_hi_signed" => "i64_mul_hi"
    "clmul_lo" => "clmul_lo"
    "clmul_hi" => "clmul_hi"
    "aes_round" => "aes_round"
    "aes_last" => "aes_last"
    "aes_sub_word" => "aes_sub_word"
    "aes_enc10" => "aes_enc10"
    "aes_enc12" => "aes_enc12"
    "aes_enc14" => "aes_enc14"
    "aes_dec10" => "aes_dec10"
    "aes_dec12" => "aes_dec12"
    "aes_dec14" => "aes_dec14"
    // four blocks side by side: arm64 (NEON's AESE, AESMC) and LLVM
    // there; amd64 and wasm run the body (four aes_enc calls)
    "aes_enc10x4" | "aes_enc12x4" | "aes_enc14x4" => if b.goarch == "arm64" { b.obj_name(fo) } else { "" }
    "aes_ctr10" | "aes_ctr12" | "aes_ctr14" => if b.goarch == "arm64" { b.obj_name(fo) } else { "" }
    "aes_cbc_enc10" | "aes_cbc_enc12" | "aes_cbc_enc14" => if b.goarch == "arm64" { b.obj_name(fo) } else { "" }
    "aes_gcm_enc10" | "aes_gcm_enc12" | "aes_gcm_enc14" | "aes_gcm_dec10" | "aes_gcm_dec12" | "aes_gcm_dec14" => if b.goarch == "arm64" { b.obj_name(fo) } else { "" }
    // and amd64 (AES-NI and PCLMULQDQ, ssa x86aesgcm8.xo, 2026-10-27)
    "aes_gcm8_enc10" | "aes_gcm8_enc12" | "aes_gcm8_enc14" | "aes_gcm8_dec10" | "aes_gcm8_dec12" | "aes_gcm8_dec14" => if b.goarch == "arm64" || b.goarch == "amd64" { b.obj_name(fo) } else { "" }
    "sha256_block" => "sha256_block"
    // many blocks in one loop (ssa a64sha256.xo, x86sha.xo): arm64 and
    // amd64; wasm runs the body (a sha256_block a block)
    "sha256_blocks" => if b.goarch == "arm64" || b.goarch == "amd64" { "sha256_blocks" } else { "" }
    // SHA-1's (ssa sha1hw.xo): arm64's SHA1 instructions, x86-64's SHA-NI
    "sha1_block" => if b.goarch == "arm64" || b.goarch == "amd64" { "sha1_block" } else { "" }
    // many blocks in one loop (ssa sha1hw.xo): arm64 and amd64; wasm runs
    // the body (a sha1_block a block)
    "sha1_blocks" => if b.goarch == "arm64" || b.goarch == "amd64" { "sha1_blocks" } else { "" }
    // SHA-512's (ssa sha512hw.xo): arm64's SHA512 instructions; amd64 and
    // wasm run the body
    "sha512_block" => if b.goarch == "arm64" { "sha512_block" } else { "" }
    // many blocks in one loop (ssa sha512hw.xo): arm64 only, as
    // sha512_block
    "sha512_blocks" => if b.goarch == "arm64" { "sha512_blocks" } else { "" }
    // decision 0329: NEON on arm64 (and LLVM's vectors there); SSSE3 on
    // amd64 (ssa x86chacha.xo, 2026-10-27)
    "chacha_blocks4" => if b.goarch == "arm64" || b.goarch == "amd64" { "chacha_blocks4" } else { "" }
    "chacha_stream4" => if b.goarch == "arm64" || b.goarch == "amd64" { "chacha_stream4" } else { "" }
    // ChaCha20-Poly1305's bulk in one loop: amd64 (ssa x86chachapoly.xo,
    // 2026-10-27); arm64 runs the body (NEON's stream, then Poly1305)
    "chacha_poly_seal4" => if b.goarch == "amd64" { "chacha_poly_seal4" } else { "" }
    "chacha_poly_open4" => if b.goarch == "amd64" { "chacha_poly_open4" } else { "" }
    // and with AVX2 (ssa x86chachapoly8.xo)
    "chacha_poly_seal8" => if b.goarch == "amd64" { "chacha_poly_seal8" } else { "" }
    "chacha_poly_open8" => if b.goarch == "amd64" { "chacha_poly_open8" } else { "" }
    // the generic timer on arm64; elsewhere the body (mono_ns, 1e9 a
    // second)
    "ticks" | "ticks_hz" => if b.goarch == "arm64" { b.obj_name(fo) } else { "" }
    // decision 0339: NEON on arm64; amd64 runs the portable body
    "ghash4" => if b.goarch == "arm64" { "ghash4" } else { "" }
    // the decision 0231 addendum's CRC-32 (IEEE): arm64 only; x86-64's
    // crc32 is Castagnoli, so amd64 and wasm run the body
    "crc32x" => if b.goarch == "arm64" { "crc32x" } else { "" }
    // its Castagnoli twin (std/crc32): arm64's crc32cx and x86-64's
    // SSE4.2 crc32q, which is this polynomial; wasm runs the body
    "crc32cx" => if b.goarch == "arm64" || b.goarch == "amd64" { "crc32cx" } else { "" }
    // IEEE 64 bytes a step with PCLMULQDQ (ssa x86crc32.xo): amd64 only
    "crc32_fold" | "crc32_fold_ymm" => if b.goarch == "amd64" { b.obj_name(fo) } else { "" }
    // the SHA3 extension's Keccak rounds (ssa a64keccak.xo): arm64 only,
    // amd64 and wasm run the body (sha3.xo calls it only with HW_SHA3)
    "keccak_f1600" => if b.goarch == "arm64" { "keccak_f1600" } else { "" }
    "ghash_blocks" => if b.goarch == "arm64" { "ghash_blocks" } else { "" }
    // SSE2 on amd64 (x86mlkem.xo), NEON on arm64 (a64mlkem.xo)
    "mlkem_ntt" | "mlkem_inverse_ntt" | "mlkem_mul_acc" => if b.goarch == "amd64" || b.goarch == "arm64" { b.obj_name(fo) } else { "" }
    "cpuid1_ecx" => "cpuid1_ecx"
    "cpuid7_ebx" => "cpuid7_ebx"
    "cpuid7_ecx" => "cpuid7_ecx"
    // decision 0385 stage 3: XCR0 for the FMA check, and vfmadd231sd
    "xgetbv0" => "xgetbv0"
    "fma_hw" => if b.goarch == "amd64" { "fma_hw" } else { "" }
    "lowered" => "lowered"
    _ => ""
  }
  // riscv64 (decision 0571): no instruction lowerings yet but the
  // arithmetic ones, which LLVM's IR states; the hardware paths' bodies
  // run (cpu.hw() is 0 there, so std takes its portable forms)
  if b.goarch == "riscv64" && !["u64_carry", "u64_borrow", "u64_adc", "u64_adc_carry", "i64_mul_hi", "lowered"].contains(name) {
    return None
  }
  // amd64 (decision 0254 stage 3): every one, SHA-256's compression too
  // (SHA-NI, found by CPUID leaf 7: the owner's approval, 2026-10-17)
  if name.is_empty() {
    return None
  }
  if name == "lowered" {
    return Some(b.cint(1))
  }
  let (_, _, args) = call_parts(x)
  let es = arg_exprs(b.c.objs[fo].params, args)
  var vs: List[Int] = []
  for (i, p) in b.c.objs[fo].params.indexed() {
    let e = es[i] ?? fault("arg")
    vs.push(b.value_as(e, b.typ(p.ty)))
  }
  b.rt(name, b.nat_of(x), vs)
}

fn (var b: Builder) is_proc_run(fo: Int) -> Bool {
  let r = b.c.objs[fo].recv
  if r < 0 || b.c.objs[fo].flags.is_static() || b.obj_name(fo) != "run" {
    return false
  }
  let m = b.obj_mod(fo)
  (b.is_prelude_mod(m) && b.obj_name(r) == "Proc") || (b.c.mods[m].path == "std/testing" && b.obj_name(r) == "FakeProc")
}

/// Whether build_conc.go concCall lowers fo.
fn (var b: Builder) is_conc_call(fo: Int) -> Bool {
  let m = b.obj_mod(fo)
  let r = b.c.objs[fo].recv
  if r < 0 {
    return b.c.mods[m].path == "std/task"
  }
  if b.c.mods[m].is_prelude {
    return b.obj_name(r) is "Scope" | "Task" | "Chan" | "Mutex" | "Atomic"
  }
  b.c.mods[m].path == "std/task" && b.obj_name(r) == "Group"
}

/// Calls a function value (valueCall).
fn (var b: Builder) value_call(x: Expr) -> Int {
  let (_, fun, args) = call_parts(x)
  let fv = b.expr(fun)
  let ft = b.vty(fv)
  if b.tkind(ft) != Kind.Func || args.len() != b.m.types[ft].elems.len() {
    b.unsupported("this call of a function value")
    return b.undef(b.nat_of(x))
  }
  // the checker's type says which parameters are `var` (typ packs them):
  // a local's own type (the callee expression of a call has no recorded
  // type), else the expression's
  var vars: List[Bool] = []
  var fct = -1
  if let Ident(id: id) = fun {
    let vo = b.c.var_of(b.s.file, id)
    if vo >= 0 {
      fct = b.apply(b.c.objs[vo].ty)
    }
  }
  if fct < 0 {
    fct = b.nat_check(fun)
  }
  if fct >= 0 && b.c.tys[b.c.resolve(fct)].kind == check.TyKind.Func {
    vars = b.c.tys[b.c.resolve(fct)].vars
  }
  var vs = [fv]
  var places: List[Place] = []
  for (i, a) in args.indexed() {
    if a.name != None {
      b.unsupported("a named argument to a function value")
    }
    if i < vars.len() && vars[i] {
      var p = b.place(a.value)
      if !p.ok {
        return b.undef(b.nat_of(x))
      }
      vs.push(b.place_get(p))
      places.push(p)
    } else {
      vs.push(b.value_as(a.value, b.m.types[ft].elems[i]))
    }
  }
  let r = b.add(Op.CallValue, b.m.types[ft].ret, Aux.None, vs)
  b.check("")
  if places.is_empty() {
    return b.call_result(r, x)
  }
  // a packed result: the call's result, then each `var` argument's new
  // value, written back as a direct call's are
  let t = b.vty(r)
  for (i, p0) in places.indexed() {
    var p = p0
    let f = b.add(Op.Field, b.m.types[t].elems[i + 1], Aux.I(n: i + 1), [r])
    b.place_set(p, f)
  }
  let f0 = b.add(Op.Field, b.m.types[t].elems[0], Aux.I(n: 0), [r])
  b.call_result(f0, x)
}

/// After a call of a function that never returns, the block ends
/// (callResult).
fn (var b: Builder) call_result(r: Int, x: Expr) -> Int {
  if b.expr_never(x) {
    b.add(Op.Unreachable, -1, Aux.None, [])
    b.dead()
    return b.undef(b.vty(r))
  }
  r
}

/// A function literal: its body becomes an Indirect function whose
/// environment holds the captured bindings (closure).
fn (var b: Builder) closure(e: Expr, lit: parser.FnLit) -> Int {
  let t = b.nat_of(e)
  let nct = b.nat_check(e)
  if nct < 0 {
    b.unsupported("a closure the checker did not type (${b.pos(lit.span)})")
    return b.undef(t)
  }
  let ct = b.c.resolve(nct)
  if b.c.tys[ct].kind != check.TyKind.Func || b.tkind(t) != Kind.Func {
    b.unsupported("this closure")
    return b.undef(t)
  }
  // decision 0507: the captures a scope's spawn of this literal borrows
  let borrow = b.s.spawn_borrow
  b.s.spawn_borrow = []
  // captured bindings: used inside, bound outside, in first use order
  var caps: List[Int] = []
  b.capture_block(lit.body, caps)
  var cap_b: List[Bool] = []
  for vo in caps {
    cap_b.push(borrow.contains(vo))
  }
  let owner = b.frame_owner()
  if owner >= 0 && block_has_try(lit.body) {
    for vo in b.frame_vars(owner) {
      if b.s.var_type.contains(vo) && !caps.contains(vo) {
        caps.push(vo)
      }
    }
  }
  var vals: List[Int] = []
  var cap_ts: List[Int] = []
  for vo in caps {
    let v = b.read(vo)
    vals.push(v)
    cap_ts.push(b.vty(v))
  }
  b.nclos += 1
  let name = "${b.s.f.name}.fn${b.nclos}"
  var ps = [t]
  for p in b.m.types[t].elems {
    ps.push(p)
  }
  let fi = b.m.new_func(name, ps, [b.m.types[t].ret])
  b.m.funcs[fi].indirect = true
  b.m.funcs[fi].captures = cap_ts
  if cap_b.contains(true) {
    // the frame's variables a `try` adds after caps are owned
    while cap_b.len() < cap_ts.len() {
      cap_b.push(false)
    }
    b.m.funcs[fi].cap_borrowed = cap_b
  }
  b.fe_closure_made(fi)
  let x = b.c.tys[ct]
  let err_t = b.fail_err(x.err)
  b.queue.push(Job.Closure(fi: fi, lit: lit, file: b.s.file, result: x.result, err_t: err_t, owner: owner, closures: b.s.closures + 1, sub: b.s.sub, caps: caps, cap_ts: cap_ts, pack: x.vars.contains(true), polls: b.s.polls))
  b.add(Op.Closure, t, Aux.S(s: name), vals)
}

fn (var b: Builder) closure_body(fi: Int, lit: parser.FnLit, file: Int, result: Int, err_t: Int, owner: Int, closures: Int, sub: Map[Int, Int], caps: List[Int], cap_ts: List[Int], pack: Bool, polls: Bool) {
  let saved = b.begin(fi, file)
  b.s.res = result
  b.s.err_t = err_t
  b.s.frame_fo = owner
  b.s.lit_line = lit.span.start.line
  b.s.lit_col = lit.span.start.col
  b.s.closures = closures
  b.s.sub = sub
  b.s.pack_var = pack
  let env = b.param(0)
  for (i, vo) in caps.indexed() {
    b.write_var(vo, b.add(Op.Capture, cap_ts[i], Aux.I(n: i), [env]))
  }
  let ps = b.c.closure_params(file, lit)
  if pack {
    // the value given (closureWith): what a failing or unwinding call
    // hands back, when the closure catches (Mutex.with's; Map.update's
    // neither catches nor keeps it)
    if b.s.f.catches {
      b.s.pack_orig = b.param(1)
    }
    // each parameter, and the `var` ones (closure_with's single one, or
    // those the literal marks) hand back their values in the tuple
    for (i, vo) in ps.indexed() {
      if vo < 0 {
        continue
      }
      b.write_var(vo, b.param(i + 1))
      if ps.len() == 1 || (i < lit.params.len() && lit.params[i].is_var) {
        b.s.var_params.push(vo)
      }
    }
  } else {
    let nps = b.s.f.blocks[0].params.len()
    for (i, vo) in ps.indexed() {
      if vo >= 0 && i + 1 < nps {
        b.write_var(vo, b.param(i + 1))
      }
    }
  }
  b.s.polls = polls
  let om = if owner >= 0 { b.obj_mod(owner) } else { -1 }
  b.s.ppolls = if om >= 0 { !runtime_mod(b.c.mods[om].path) } else { polls }
  b.poll()
  let v = b.block(lit.body)
  b.ret_at(v, Some(Expr.Block(b: lit.body)))
  b.finish_fn()
  b.end(saved)
}

/// The locals the identifiers of a block name that are bound outside
/// (s.var_type), in first use order: check.Inspect over the body, whose
/// children (internal/check walk.go) are the expressions of statements,
/// not patterns, names, or labels.
fn (var b: Builder) capture_block(bl: parser.Block, var caps: List[Int]) {
  for st in bl.stmts {
    b.capture_stmt(st, caps)
  }
}

fn (var b: Builder) capture_ident(id: Ident, var caps: List[Int]) {
  let vo = b.c.var_of(b.s.file, id)
  if vo >= 0 && !caps.contains(vo) && b.s.var_type.contains(vo) {
    caps.push(vo)
  }
}

fn (var b: Builder) capture_opt(e: Expr?, var caps: List[Int]) {
  if let Some(x) = e {
    b.capture_expr(x, caps)
  }
}

fn (var b: Builder) capture_stmt(st: Stmt, var caps: List[Int]) {
  match st {
    LetStmt(value: value, ..) => b.capture_expr(value, caps)
    VarStmt(value: value, ..) => b.capture_expr(value, caps)
    AssignStmt(target: target, value: value, ..) => {
      b.capture_expr(target, caps)
      b.capture_expr(value, caps)
    }
    DeferStmt(body: body, ..) => b.capture_stmt(body, caps)
    ReturnStmt(value: value, ..) => b.capture_opt(value, caps)
    ForStmt(iter: iter, bound: bound, body: body, ..) => {
      b.capture_expr(iter, caps)
      for e in bound {
        b.capture_expr(e, caps)
      }
      b.capture_block(body, caps)
    }
    WhileStmt(cond: cond, value: value, bound: bound, body: body, ..) => {
      b.capture_opt(cond, caps)
      for v in value {
        b.capture_expr(v, caps)
      }
      for e in bound {
        b.capture_expr(e, caps)
      }
      b.capture_block(body, caps)
    }
    ExprStmt(x: x, ..) => b.capture_expr(x, caps)
    ConstDecl(d) => b.capture_expr(d.value, caps)
    _ => {}
  }
}

fn (var b: Builder) capture_expr(e: Expr, var caps: List[Int]) {
  match e {
    Ident(id) => b.capture_ident(id, caps)
    StringLit(s) => {
      for p in s.parts {
        b.capture_opt(p.expr, caps)
      }
    }
    ParenExpr(x: x, ..) => b.capture_expr(x, caps)
    TupleExpr(elems: elems, ..) => {
      for x in elems {
        b.capture_expr(x, caps)
      }
    }
    ListLit(elems: elems, ..) => {
      for x in elems {
        b.capture_expr(x, caps)
      }
    }
    SetLit(elems: elems, ..) => {
      for x in elems {
        b.capture_expr(x, caps)
      }
    }
    MapLit(entries: entries, ..) => {
      for en in entries {
        b.capture_expr(en.key, caps)
        b.capture_expr(en.value, caps)
      }
    }
    StructLit(fields: fields, ..) => {
      for f in fields {
        b.capture_expr(f.value, caps)
      }
    }
    UnaryExpr(x: x, ..) => b.capture_expr(x, caps)
    BinaryExpr(x: x, y: y, ..) => {
      b.capture_expr(x, caps)
      b.capture_expr(y, caps)
    }
    IsExpr(x: x, ..) => b.capture_expr(x, caps)
    RangeExpr(lo: lo, hi: hi, ..) => {
      b.capture_opt(lo, caps)
      b.capture_opt(hi, caps)
    }
    SelectorExpr(x: x, ..) => b.capture_expr(x, caps)
    CallExpr(fun: fun, args: args, ..) => {
      b.capture_expr(fun, caps)
      for a in args {
        b.capture_expr(a.value, caps)
      }
    }
    TypeArgsExpr(x: x, ..) => b.capture_expr(x, caps)
    IndexExpr(x: x, index: index, ..) => {
      b.capture_expr(x, caps)
      b.capture_expr(index, caps)
    }
    TryExpr(x: x, ..) => b.capture_expr(x, caps)
    WithExpr(x: x, fields: fields, ..) => {
      b.capture_expr(x, caps)
      for f in fields {
        b.capture_expr(f.value, caps)
      }
    }
    IfExpr(x) => {
      b.capture_opt(x.cond, caps)
      b.capture_opt(x.value, caps)
      b.capture_block(x.then, caps)
      b.capture_opt(x.els, caps)
    }
    MatchExpr(subject: subject, arms: arms, ..) => {
      b.capture_expr(subject, caps)
      for a in arms {
        b.capture_opt(a.guard, caps)
        if let Some(st) = a.body {
          b.capture_stmt(st, caps)
        }
      }
    }
    ScopeExpr(body: body, ..) => b.capture_block(body, caps)
    SelectExpr(arms: arms, ..) => {
      for a in arms {
        b.capture_opt(a.op, caps)
        b.capture_opt(a.after, caps)
        if let Some(st) = a.body {
          b.capture_stmt(st, caps)
        }
      }
    }
    Block(bl) => b.capture_block(bl, caps)
    FnLit(f) => b.capture_block(f.body, caps)
    WhileExpr(body: body, ..) => b.capture_block(body, caps)
    _ => {}
  }
}

/// Whether a block holds a `?` (hasTry, over the same children).
fn block_has_try(bl: parser.Block) -> Bool {
  for st in bl.stmts {
    if stmt_has_try(st) {
      return true
    }
  }
  false
}

fn stmt_has_try(st: Stmt) -> Bool {
  match st {
    LetStmt(value: v, ..) => expr_has_try(v)
    VarStmt(value: v, ..) => expr_has_try(v)
    AssignStmt(target: t, value: v, ..) => expr_has_try(t) || expr_has_try(v)
    DeferStmt(body: body, ..) => stmt_has_try(body)
    ReturnStmt(value: v, ..) => opt_has_try(v)
    ForStmt(iter: iter, bound: bound, body: body, try_next: tn, ..) => tn || expr_has_try(iter) || list_has_try(bound) || block_has_try(body)
    WhileStmt(cond: cond, value: value, bound: bound, body: body, ..) => opt_has_try(cond) || list_has_try(value) || list_has_try(bound) || block_has_try(body)
    ExprStmt(x: x, ..) => expr_has_try(x)
    ConstDecl(d) => expr_has_try(d.value)
    _ => false
  }
}

fn opt_has_try(e: Expr?) -> Bool {
  match e {
    Some(x) => expr_has_try(x)
    None => false
  }
}

fn list_has_try(es: List[Expr]) -> Bool {
  for e in es {
    if expr_has_try(e) {
      return true
    }
  }
  false
}

fn expr_has_try(e: Expr) -> Bool {
  match e {
    TryExpr(..) => true
    StringLit(s) => {
      for p in s.parts {
        if opt_has_try(p.expr) {
          return true
        }
      }
      false
    }
    ParenExpr(x: x, ..) => expr_has_try(x)
    TupleExpr(elems: elems, ..) => list_has_try(elems)
    ListLit(elems: elems, ..) => list_has_try(elems)
    SetLit(elems: elems, ..) => list_has_try(elems)
    MapLit(entries: entries, ..) => {
      for en in entries {
        if expr_has_try(en.key) || expr_has_try(en.value) {
          return true
        }
      }
      false
    }
    StructLit(fields: fields, ..) => {
      for f in fields {
        if expr_has_try(f.value) {
          return true
        }
      }
      false
    }
    UnaryExpr(x: x, ..) => expr_has_try(x)
    BinaryExpr(x: x, y: y, ..) => expr_has_try(x) || expr_has_try(y)
    IsExpr(x: x, ..) => expr_has_try(x)
    RangeExpr(lo: lo, hi: hi, ..) => opt_has_try(lo) || opt_has_try(hi)
    SelectorExpr(x: x, ..) => expr_has_try(x)
    CallExpr(fun: fun, args: args, ..) => {
      if expr_has_try(fun) {
        return true
      }
      for a in args {
        if expr_has_try(a.value) {
          return true
        }
      }
      false
    }
    TypeArgsExpr(x: x, ..) => expr_has_try(x)
    IndexExpr(x: x, index: index, ..) => expr_has_try(x) || expr_has_try(index)
    WithExpr(x: x, fields: fields, ..) => {
      if expr_has_try(x) {
        return true
      }
      for f in fields {
        if expr_has_try(f.value) {
          return true
        }
      }
      false
    }
    IfExpr(x) => opt_has_try(x.cond) || opt_has_try(x.value) || block_has_try(x.then) || opt_has_try(x.els)
    MatchExpr(subject: subject, arms: arms, ..) => {
      if expr_has_try(subject) {
        return true
      }
      for a in arms {
        if opt_has_try(a.guard) {
          return true
        }
        if let Some(st) = a.body {
          if stmt_has_try(st) {
            return true
          }
        }
      }
      false
    }
    ScopeExpr(body: body, ..) => block_has_try(body)
    SelectExpr(arms: arms, ..) => {
      for a in arms {
        if opt_has_try(a.op) || opt_has_try(a.after) {
          return true
        }
        if let Some(st) = a.body {
          if stmt_has_try(st) {
            return true
          }
        }
      }
      false
    }
    Block(bl) => block_has_try(bl)
    FnLit(f) => block_has_try(f.body)
    WhileExpr(body: body, ..) => block_has_try(body)
    _ => false
  }
}

/// A named function used as a value: a closure without an environment
/// over a wrapper that calls it (funcValue).
fn (var b: Builder) func_value(fo: Int, e: Expr) -> Int {
  let t = b.nat_of(e)
  if b.tkind(t) != Kind.Func || b.c.objs[fo].recv >= 0 {
    b.unsupported("the function `${b.c.display_name(fo)}` as a value")
    return b.undef(t)
  }
  // the type arguments: by matching the signature against the function
  // type the value has here (the checker records none for a function)
  var bound: Map[Int, Int] = {}
  let nct = b.nat_check(e)
  if nct >= 0 {
    let fx = b.c.tys[b.c.resolve(nct)]
    if fx.kind == check.TyKind.Func && fx.args.len() == b.c.objs[fo].params.len() {
      for (i, p) in b.c.objs[fo].params.indexed() {
        b.match_tparams(p.ty, fx.args[i], bound)
      }
      b.match_tparams(b.c.objs[fo].result, fx.result, bound)
    }
  }
  var targs: List[Int] = []
  var names: List[Str] = []
  for p in b.type_params(fo) {
    let ta = bound.get(p) ?? -1
    if ta < 0 {
      b.unsupported("the generic function `${b.c.display_name(fo)}` as a value without type arguments")
      return b.undef(t)
    }
    let at = b.apply(ta)
    targs.push(at)
    names.push(b.m.types[b.typ(at)].name)
  }
  var key = "${fo}:${b.func_name(fo)}"
  if !names.is_empty() {
    key = "${key}[${names.join(", ")}]"
  }
  if !names.is_empty() {
    // a generic instance's thunk is named by the instance's name here
    b.fe_touch("thunks")
  }
  var w = b.thunks.get(key) ?? -1
  if w < 0 {
    let callee = b.declare(fo, targs)
    let cname = b.m.funcs[callee].name
    // a function with `var` parameters returns (result, their values),
    // the tuple a packed function value returns
    let cres = if b.m.funcs[callee].results.len() == 1 { b.m.funcs[callee].results[0] } else { b.m.tuple(b.m.funcs[callee].results) }
    var ps = [t]
    for p in b.m.types[t].elems {
      ps.push(p)
    }
    w = b.m.new_func("${cname}.value", ps, [b.m.types[t].ret])
    b.m.funcs[w].indirect = true
    var args: List[Int] = []
    for (i, p) in b.m.funcs[w].blocks[0].params.indexed() {
      if i > 0 {
        args.push(p)
      }
    }
    let r = b.m.funcs[w].add(0, Op.Call, cres, Aux.S(s: cname), args)
    b.m.funcs[w].add(0, Op.Return, -1, Aux.None, [r])
    b.thunks[key] = w
  }
  if b.m.fe_log && names.is_empty() {
    // the commit finds it, or makes it, by its function's name
    b.thunk_of[w] = fo
    b.m.fe_ev.push((7, w))
  }
  b.add(Op.Closure, t, Aux.S(s: b.m.funcs[w].name), [])
}

/// Constructs a variant from call arguments (ctorCall).
fn (var b: Builder) ctor_call(vr: check.VRef, x: Expr) -> Int {
  let (_, _, args) = call_parts(x)
  let t = b.nat_of(x)
  let name = b.variant_name(vr)
  let nct = b.nat_check(x)
  let (_, et) = b.result_parts(nct)
  if et >= 0 && b.c.is_never(et) && args.len() == 1 {
    if name == "Err" {
      b.expr(args[0].value)
      b.add(Op.Unreachable, -1, Aux.None, [])
      b.dead()
      return b.undef(t)
    }
    return b.value_as(args[0].value, t)
  }
  let tag = b.m.variant_index(t, name)
  if b.tkind(t) != Kind.Enum || tag < 0 {
    b.unsupported("constructing `${name}` here")
    return b.undef(t)
  }
  let fs = user_fields(b.m.types[t].variants[tag])
  var vals: List[Int] = []
  for _ in fs {
    vals.push(-1)
  }
  let vfields = b.c.objs[vr.en].variants[vr.variant].fields
  var pos = 0
  for a in args {
    var i = pos
    if let Some(n) = a.name {
      i = -1
      for (j, f) in vfields.indexed() {
        if f.name == n.name {
          i = j
        }
      }
    } else {
      pos += 1
    }
    if i < 0 || i >= fs.len() {
      b.unsupported("this variant argument")
      continue
    }
    vals[i] = b.value_as(a.value, fs[i].ty)
  }
  for i in 0..vals.len() {
    if vals[i] < 0 {
      b.unsupported("a variant constructed without all its fields")
      vals[i] = b.undef(fs[i].ty)
    }
  }
  b.add(Op.Variant, t, Aux.I(n: tag), vals)
}

/// A bare `Err(x)` or `Ok(x)` the checker typed against the enclosing
/// function's Result without recording a constructor (isRetCtor).
fn (var b: Builder) is_ret_ctor(x: Expr) -> Bool {
  let (_, fun, args) = call_parts(x)
  if let Ident(id) = fun {
    if (id.name != b"Err" && id.name != b"Ok") || args.len() != 1 {
      return false
    }
    return b.c.var_of(b.s.file, id) < 0 && b.c.ref_of(b.s.file, id) < 0 && b.c.ctor_in(b.s.file, x) == None && b.c.call_in(b.s.file, x) == None
  }
  false
}

fn (var b: Builder) ret_ctor(x: Expr) -> Int {
  let (_, fun, args) = call_parts(x)
  let id = match fun {
    Ident(i) => i
    _ => fault("ret ctor")
  }
  var ct = b.check_type(x)
  let (rt0, et0) = b.result_parts(ct)
  var rt = rt0
  var et = et0
  if rt < 0 {
    if b.s.err_t < 0 {
      b.unsupported("`${check.text(id.name)}(...)` here")
      return b.undef(b.nat_of(x))
    }
    rt = b.s.res
    et = b.s.err_t
    ct = b.result_of(b.s.res, b.s.err_t)
  }
  let t = b.typ(ct)
  let arg = args[0].value
  if b.c.is_never(et) {
    if id.name == b"Err" {
      b.expr(arg)
      b.add(Op.Unreachable, -1, Aux.None, [])
      b.dead()
      return b.undef(t)
    }
    return b.value_as(arg, t)
  }
  if id.name == b"Err" {
    let v = b.expr(arg)
    let ev = b.coerce_err(v, b.nat_check(arg), et, Some(arg))
    return b.add(Op.Variant, t, Aux.I(n: b.m.variant_index(t, "Err")), [ev])
  }
  let ok = b.value_as(arg, b.typ(rt))
  b.add(Op.Variant, t, Aux.I(n: b.m.variant_index(t, "Ok")), [ok])
}

/// Converts an error at a `?` or `Err` site (coerceErr).
fn (var b: Builder) coerce_err(v: Int, from: Int, to: Int, at: Expr?) -> Int {
  let tt = b.typ(to)
  if b.vty(v) == tt || b.vop(v) == Op.Undef {
    return b.coerce_at(v, tt, at)
  }
  let fv = b.c.from_variant(to, from)
  if fv >= 0 {
    let o = b.named_obj(to)
    return b.variant(tt, check.text(b.c.objs[o].variants[fv].name), [v])
  }
  if b.is_dyn(tt) {
    // an error converted to the Error interface (`main ! Error`)
    return b.to_dyn(v, from, "Error")
  }
  b.unsupported("converting the error `${b.m.types[b.vty(v)].name}` to `${b.m.types[tt].name}`")
  b.undef(tt)
}

/// The result type the function's body returns: its result, or for a
/// packed closure the first element of its tuple (resultT).
fn (var b: Builder) result_t() -> Int {
  if b.s.pack_var {
    return b.m.types[b.s.f.results[0]].elems[0]
  }
  b.s.f.results[0]
}

/// `x?` (try).
fn (var b: Builder) try_expr(e: Expr) -> Int {
  let (span, x) = match e {
    TryExpr(span: span, x: x) => (span, x)
    _ => fault("try")
  }
  let xt = b.nat_check(x)
  let v = b.expr(x)
  let (_, et0) = b.result_parts(xt)
  if et0 >= 0 && b.c.is_never(et0) {
    return v
  }
  let vt = b.vty(v)
  if b.tkind(vt) != Kind.Enum {
    b.unsupported("`?` on `${b.m.types[vt].name}`")
    return b.undef(b.nat_of(e))
  }
  var fail_tag = b.m.variant_index(vt, "Err")
  var ok_tag = b.m.variant_index(vt, "Ok")
  let (_, et) = b.result_parts(xt)
  let is_result = et >= 0
  if !is_result {
    fail_tag = b.m.variant_index(vt, "None")
    ok_tag = b.m.variant_index(vt, "Some")
  }
  if fail_tag < 0 || ok_tag < 0 {
    b.unsupported("`?` on `${b.m.types[vt].name}`")
    return b.undef(b.nat_of(e))
  }
  let c = b.add(Op.Eq, b.bool_t(), Aux.None, [b.add(Op.Tag, b.int_t(), Aux.None, [v]), b.cint(fail_tag)])
  let (yes, no) = b.branch(c)
  b.s.cur = yes
  let want = b.result_t()
  if is_result {
    if b.s.err_t < 0 {
      b.unsupported("`?` on a Result in a function that cannot fail")
    } else {
      let ev = b.add(Op.Payload, b.m.types[vt].variants[fail_tag].fields[0].ty, Aux.P(tag: fail_tag, field: 0), [v])
      let ce = b.coerce_err(ev, et, b.s.err_t, Some(e))
      let wi = b.m.variant_index(want, "Err")
      let fs = b.m.types[want].variants[wi].fields
      if fs.len() == 2 && fs[1].name == TRACE_FIELD {
        let tr = b.push_frame(b.err_trace(v, fail_tag), span)
        b.ret(b.add(Op.Variant, want, Aux.I(n: wi), [ce, tr]))
      } else {
        b.ret(b.add(Op.Variant, want, Aux.I(n: wi), [ce]))
      }
    }
  } else if let Some(tm) = b.c.test_missing.get(b.c.expr_key_in(b.s.file, e)) {
    // a test body's `x?` on an Option: `x.or_err("missing value: x")?`
    // (decision 0347)
    // where (decision 0347: `missing value: first([]) at FILE:LINE:COL`,
    // as expect failures say it)
    let sv = b.add(Op.Const, b.str_t(), Aux.Bs(b: "${tm.msg} at ${b.pos(span)}".bytes()), [])
    let ce = b.coerce_err(sv, tm.str_ty, b.s.err_t, Some(e))
    let wi = b.m.variant_index(want, "Err")
    let fs = b.m.types[want].variants[wi].fields
    if fs.len() == 2 && fs[1].name == TRACE_FIELD {
      let tr = b.push_frame(b.empty_trace(), span)
      b.ret(b.add(Op.Variant, want, Aux.I(n: wi), [ce, tr]))
    } else {
      b.ret(b.add(Op.Variant, want, Aux.I(n: wi), [ce]))
    }
  } else {
    let rt = b.typ(b.s.res)
    if b.option_elem(b.s.res) < 0 {
      b.unsupported("`?` on an Option outside a function returning an Option")
    } else {
      b.ret(b.add(Op.Variant, rt, Aux.I(n: b.m.variant_index(rt, "None")), []))
    }
  }
  b.s.cur = no
  b.add(Op.Payload, b.m.types[vt].variants[ok_tag].fields[0].ty, Aux.P(tag: ok_tag, field: 0), [v])
}

/// A numeric conversion `Float(i)`, `Int(f)`, or a newtype `Email(x)`
/// (typeCall).
fn (var b: Builder) type_call(obj: Int, x: Expr) -> Int {
  let (span, _, args) = call_parts(x)
  let to = b.nat_of(x)
  if b.c.objs[obj].tkind == "newtype" && args.len() == 1 && b.tkind(to) == Kind.Struct && b.m.types[to].fields.len() == 1 {
    let v = b.value_as(args[0].value, b.m.types[to].fields[0].ty)
    return b.add(Op.Struct, to, Aux.None, [v])
  }
  if args.len() != 1 || !b.is_prelude_mod(b.obj_mod(obj)) {
    b.unsupported("the conversion `${b.obj_name(obj)}(...)`")
    return b.undef(to)
  }
  let v = b.expr(args[0].value)
  let vt = b.vty(v)
  let it = b.int_t()
  let tk = b.tkind(to)
  let vk = b.tkind(vt)
  if vt == to {
    return v
  }
  if b.m.is_f32(to) && b.m.is_u64(vt) {
    // one rounding, as Go's float32(u): through a Float, a UInt64 above
    // 2^53 rounded twice (2026-10-23: 2^60 + 2^36 + 1 became 2^60, not
    // 2^60 + 2^37)
    return b.rt("u64_to_f32", to, [v])
  }
  if b.m.is_f32(to) && vk == Kind.Int {
    return b.rt("i64_to_f32", to, [v])
  }
  if tk == Kind.Float && vk == Kind.Float {
    return b.rt("f32_round", to, [v])
  }
  if tk == Kind.Float && b.m.is_u64(vt) {
    return b.rt("u64_to_float", to, [v])
  }
  if tk == Kind.Float && vk == Kind.Int {
    return b.add(Op.IntToFloat, to, Aux.None, [v])
  }
  if tk == Kind.Int && vk == Kind.Float && b.m.types[to].bits > 0 {
    // a sized type: its own range test on the float first, so the fault
    // names the type and the value as written (std/rt FloatToInt's text;
    // FloatToInt and int_conv named Int, and the truncated value)
    b.float_range_check(v, to, span)
    if b.m.is_u64(to) {
      return b.float_to_u64(v, to, span)
    }
    let r = b.add(Op.FloatToInt, it, Aux.None, [v])
    return b.add(Op.IntConv, to, Aux.None, [r])
  }
  if tk == Kind.Int && vk == Kind.Float {
    let r = b.add(Op.FloatToInt, it, Aux.None, [v])
    b.set_pos(r, b.pos(span))
    return b.int_conv(r, to, span)
  }
  if tk == Kind.Int && vk == Kind.Int {
    return b.int_conv(v, to, span)
  }
  b.unsupported("the conversion `${b.obj_name(obj)}(...)`")
  b.undef(to)
}

/// Call arguments matched to parameters, positional then named; missing
/// ones are None (argExprs).
fn arg_exprs(params: List[check.ParamInfo], args: List[parser.Arg]) -> List[Expr?] {
  var out: List[Expr?] = []
  for _ in params {
    out.push(None)
  }
  var pos = 0
  for a in args {
    match a.name {
      None => {
        if pos < out.len() {
          out[pos] = Some(a.value)
        }
        pos += 1
      }
      Some(n) => {
        for (i, p) in params.indexed() {
          if p.name == n.name {
            out[i] = Some(a.value)
          }
        }
      }
    }
  }
  out
}

fn same_span(a: Expr, e: Expr?) -> Bool {
  match e {
    Some(x) => parser.expr_span(x) == parser.expr_span(a) && check.expr_kind(x) == check.expr_kind(a)
    None => false
  }
}

/// Calls the user function or the implementation impl of ci's function
/// (callAs, declCall).
fn (var b: Builder) call_as(x: Expr, ci: check.CallInfo, impl: Int) -> Int {
  b.call_as_via(x, ci, impl, -1)
}

/// Whether a by value receiver expression is read after the call's
/// arguments (core 5.2, decision 0326): a variable or a field path of
/// one, whose read has no effect of its own. Any other receiver (a call, an
/// index) is evaluated first, in source order.
pub fn recv_after_args(e: Expr) -> Bool {
  match e {
    Ident(_) => true
    SelectorExpr(_, x, _) => recv_after_args(x)
    ParenExpr(_, x) => recv_after_args(x)
    _ => false
  }
}

/// call_as calling, when real >= 0, the real Fs wrapper of the declared
/// implementation and real (callAsVia with realFsWrapper).
fn (var b: Builder) call_as_via(x: Expr, ci: check.CallInfo, impl: Int, real: Int) -> Int {
  let log_from = b.pend_log_from
  b.pend_log_from = ""
  let (span, _, args) = call_parts(x)
  let fo = ci.fn_obj
  var targs: List[Int] = []
  for p in b.type_params(fo) {
    let t = ci.subst.get(p) ?? -1
    if t < 0 {
      b.unsupported("a generic call whose type arguments are not inferred")
      return b.undef(b.nat_of(x))
    }
    targs.push(b.apply(t))
  }
  let callee = b.declare(impl, targs)
  let ps0 = b.m.funcs[callee].blocks[0].params
  var ps: List[Int] = []
  for p in ps0 {
    ps.push(b.func_value_type(callee, p))
  }
  let cres = b.m.funcs[callee].results
  var impl_params = b.c.objs[impl].params
  let is_method = b.c.objs[fo].recv >= 0 && !b.c.objs[fo].flags.is_static()
  if is_method && b.c.objs[impl].recv < 0 && !impl_params.is_empty() {
    impl_params = impl_params[1..impl_params.len()]
  }
  var vargs: List[Int] = []
  var places: List[Place] = []
  var recv_place = -1
  var recv_deferred = false
  if is_method {
    if ci.recv.is_empty() {
      b.unsupported("this method call")
      return b.undef(cres[0])
    }
    if b.c.objs[fo].flags.recv_var() {
      let p = b.place(ci.recv[0])
      if !p.ok {
        return b.undef(cres[0])
      }
      places.push(p)
      recv_place = 0
      vargs.push(-1)
    } else if recv_after_args(ci.recv[0]) {
      // a by value receiver that is a variable or a field path is read
      // after the arguments (decision 0326)
      recv_deferred = true
      vargs.push(-1)
    } else {
      vargs.push(b.value_as(ci.recv[0], ps[0]))
    }
  }
  let off = vargs.len()
  let fparams = b.c.objs[fo].params
  let exprs = arg_exprs(fparams, args)
  var vals: List[Int] = []
  var done: List[Bool] = []
  var arg_places: List[Int] = []
  for _ in fparams {
    vals.push(-1)
    done.push(false)
    arg_places.push(-1)
  }
  var aplaces: List[Place] = []
  for a in args {
    for (i, e) in exprs.indexed() {
      if done[i] || !same_span(a.value, e) {
        continue
      }
      done[i] = true
      let ex = e ?? fault("arg")
      if fparams[i].is_var {
        let p = b.place(ex)
        if !p.ok {
          return b.undef(cres[0])
        }
        arg_places[i] = aplaces.len()
        aplaces.push(p)
      } else {
        vals[i] = b.value_as(ex, ps[off + i])
      }
    }
  }
  for (i, p) in fparams.indexed() {
    if !done[i] {
      var d: List[Expr] = p.default
      var dfile = b.decl_file(fo)
      if impl != fo {
        d = []
        if i < impl_params.len() {
          d = impl_params[i].default
          dfile = b.decl_file(impl)
        }
        if d.is_empty() {
          d = p.default
          dfile = b.decl_file(fo)
        }
      }
      if d.is_empty() && b.c.is_loc_type(p.ty) {
        // a merged std function's trailing rt.Loc (decision 0597's
        // amendment): this call's position, as loc_args gives a native
        // implementation's
        vals[i] = b.const_str(b.pos_line(span))
        continue
      }
      if d.is_empty() {
        b.unsupported("a call with a missing argument")
        vals[i] = b.undef(ps[off + i])
        continue
      }
      vals[i] = b.foreign_value(d[0], dfile, ps[off + i], b.s.sub, p.ty)
    }
    if arg_places[i] >= 0 {
      places.push(aplaces[arg_places[i]])
    }
  }
  if recv_deferred {
    vargs[0] = b.value_as(ci.recv[0], ps[0])
  }
  if recv_place >= 0 {
    var rp = places[0]
    vargs[0] = b.place_get(rp)
    places[0] = rp
  }
  for (i, ap) in arg_places.indexed() {
    if ap >= 0 {
      // the place in places that is argument i's
      var k = 0
      if recv_place >= 0 {
        k = 1
      }
      for j in 0..i {
        if arg_places[j] >= 0 {
          k += 1
        }
      }
      var p = places[k]
      vals[i] = b.place_get(p)
      places[k] = p
    }
  }
  for v in vals {
    vargs.push(v)
  }
  if impl != fo {
    for v in b.loc_args(span, impl_params, fparams.len()) {
      vargs.push(v)
    }
  }
  var name = b.m.funcs[callee].name
  if real >= 0 {
    name = b.real_fs_wrapper(callee, b.declare(real, []))
  }
  if !log_from.is_empty() {
    // the native prelude's llrt_log_from keeps the constant's address in
    // a thread local word (std/native/llrt/logstate.xo, work item B02)
    let impl = b.prelude_impl("llrt_log_from")
    if impl >= 0 {
      let f = b.declare(impl, [])
      b.call(b.m.funcs[f].name, b.unit_t(), "", [b.const_str(log_from)])
    }
  }
  // a call of a real-time function from code that is not real-time is a
  // real-time section (core 6.5, decision 0133)
  let section = b.c.objs[impl].flags.realtime() && (b.s.fo < 0 || !b.c.objs[b.s.fo].flags.realtime())
  if section {
    b.rt("realtime_enter", -1, [])
  }
  if cres.len() == 1 {
    let r = b.call(name, cres[0], "", vargs)
    b.check(name)
    b.leave_section(section, impl, span)
    return b.call_result(r, x)
  }
  let t = b.m.tuple(cres)
  let r = b.call(name, t, "", vargs)
  b.check(name)
  b.leave_section(section, impl, span)
  for (i, p0) in places.indexed() {
    var p = p0
    let f = b.add(Op.Field, b.m.types[t].elems[i + 1], Aux.I(n: i + 1), [r])
    b.place_set(p, f)
  }
  let f0 = b.add(Op.Field, b.m.types[t].elems[0], Aux.I(n: 0), [r])
  b.call_result(f0, x)
}

/// The end of a real-time section around a call of impl (callAsVia's
/// leave): the runtime faults (XO-F007) when it allocated.
fn (var b: Builder) leave_section(section: Bool, impl: Int, span: Span) {
  if section && !b.is_dead() {
    let name = b.const_str(b.c.display_name(impl))
    let loc = b.const_str(b.pos_line(span))
    b.rt("realtime_exit", -1, [name, loc])
    b.check("")
  }
}

/// Binds the type parameters in pattern (a signature type) to the
/// corresponding parts of actual (matchTParams).
fn (var b: Builder) match_tparams(pattern: Int, actual0: Int, var bound: Map[Int, Int]) {
  if pattern < 0 || actual0 < 0 {
    return
  }
  let actual = b.c.resolve(actual0)
  let p = b.c.tys[pattern]
  let a = b.c.tys[actual]
  match p.kind {
    Param => {
      if !bound.contains(p.obj) {
        bound[p.obj] = actual
      }
    }
    Named => {
      if a.kind == check.TyKind.Named && a.obj == p.obj && a.args.len() == p.args.len() {
        for i in 0..p.args.len() {
          b.match_tparams(p.args[i], a.args[i], bound)
        }
      }
    }
    Tuple => {
      if a.kind == check.TyKind.Tuple && a.args.len() == p.args.len() {
        for i in 0..p.args.len() {
          b.match_tparams(p.args[i], a.args[i], bound)
        }
      }
    }
    Func => {
      if a.kind == check.TyKind.Func && a.args.len() == p.args.len() {
        for i in 0..p.args.len() {
          b.match_tparams(p.args[i], a.args[i], bound)
        }
        b.match_tparams(p.result, a.result, bound)
      }
    }
    Var | Bad | EffArg => {}
  }
}

/// The type of parameter value p of function fi (which may be the
/// function being built, whose values live in b.s.f).
fn (var b: Builder) func_value_type(fi: Int, p: Int) -> Int {
  if fi == b.s.fi {
    return ty_of(b.s.f.values[p].tb)
  }
  ty_of(b.m.funcs[fi].values[p].tb)
}

/// The `rt.Loc` arguments of the implementation's parameters after those
/// of the std function (locArgs).
fn (var b: Builder) loc_args(span: Span, impl_params: List[check.ParamInfo], n: Int) -> List[Int] {
  var out: List[Int] = []
  var i = n
  while i < impl_params.len() {
    let o = b.named_obj(impl_params[i].ty)
    if o < 0 || b.obj_name(o) != "Loc" || b.obj_mod(o) < 0 || b.c.mods[b.obj_mod(o)].path != "native/rt" {
      b.unsupported("an implementation with more parameters than the std function")
      i += 1
      continue
    }
    out.push(b.const_str(b.pos_line(span)))
    i += 1
  }
  out
}

/// A call of a function of std/native/rt.xo (intrinsic).
fn (var b: Builder) intrinsic(x: Expr, ci: check.CallInfo) -> Int {
  let (_, _, args) = call_parts(x)
  let fo = ci.fn_obj
  let nt = b.nat_of(x)
  let es = arg_exprs(b.c.objs[fo].params, args)
  for e in es {
    if e == None {
      b.unsupported("an intrinsic call with a missing argument")
      return b.undef(nt)
    }
  }
  if !b.type_params(fo).is_empty() {
    return b.generic_intrinsic(x, ci, es)
  }
  let name = b.obj_name(fo)
  let mpath = b.c.mods[b.obj_mod(fo)].path
  if mpath is "native/sys_darwin" | "native/sys_windows" | "native/sys_c" {
    return b.platform_call(x, fo, mpath.trim_prefix("native/sys_"), name, es)
  }
  if name == "sym_present" {
    return b.sym_present(x, es)
  }
  if name == "fn_addr" {
    return b.fn_addr(es)
  }
  if name == "wasi_hook" && b.wasm {
    return b.wasi_hook(es)
  }
  if name == "sym_addr" {
    return b.sym_addr(es)
  }
  if name is "fs_root" | "fs_mode" {
    let v = b.expr(es[0] ?? fault("arg"))
    if !b.is_fs(b.vty(v)) {
      b.unsupported("`${name}` of a value that is not an Fs")
      return b.undef(nt)
    }
    let i = if name == "fs_mode" { 1 } else { 0 }
    return b.add(Op.Field, b.m.types[b.vty(v)].fields[i].ty, Aux.I(n: i), [v])
  }
  if name == "fs_new" {
    let t = b.fs_type()
    let a = b.value_as(es[0] ?? fault("arg"), b.m.types[t].fields[0].ty)
    let c = b.value_as(es[1] ?? fault("arg"), b.m.types[t].fields[1].ty)
    return b.add(Op.Struct, t, Aux.None, b.fs_fields(t, a, c))
  }
  if name is "proc_lists" | "env_lists" | "net_lists" {
    // the attenuation lists of a Proc, Env, or Net (decisions 0172 and
    // 0175)
    let v = b.expr(es[0] ?? fault("arg"))
    if !b.is_lists(b.vty(v)) {
      b.unsupported("`${name}` of a value that is not a Proc, Env, or Net")
      return b.undef(nt)
    }
    return b.add(Op.Field, b.m.types[b.vty(v)].fields[0].ty, Aux.I(n: 0), [v])
  }
  if name is "proc_new" | "env_new" | "net_new" {
    let t = b.lists_type(if name == "env_new" { "Env" } else if name == "net_new" { "Net" } else { "Proc" })
    let a = b.value_as(es[0] ?? fault("arg"), b.m.types[t].fields[0].ty)
    return b.add(Op.Struct, t, Aux.None, b.lists_fields(t, a))
  }
  if name is "dyn_text" | "dyn_raw" {
    let v = b.expr(es[0] ?? fault("arg"))
    if !b.is_dyn(b.vty(v)) {
      b.unsupported("`${name}` of a value that is not an interface value")
      return b.undef(nt)
    }
    let i = if name == "dyn_text" { 0 } else { 1 }
    return b.add(Op.Field, nt, Aux.I(n: i), [v])
  }
  var vs: List[Int] = []
  for (i, p) in b.c.objs[fo].params.indexed() {
    let pt = b.typ(p.ty)
    vs.push(b.value_as(es[i] ?? fault("arg"), pt))
  }
  let (rv, raw) = b.raw_intrinsic(name, vs)
  if raw {
    return rv
  }
  if b.wasm && b.tests && name is "env_get" | "env_vars" {
    // a WASI test module's environment is the test world's (a FakeEnv,
    // as on the native targets: process.env_get), not the runner's
    if let Some(v) = b.llrt_any(name, nt, vs) {
      return v
    }
  }
  if name is "eprintln" | "env_get" | "env_vars" {
    // the runtime's standard error and environment in Xo (the zero-C
    // audit's B03): the native prelude's llrt_<name>; rt.<name> only in a
    // WASI module (its runtime's)
    if let Some(v) = b.llrt_or_none(name, nt, vs) {
      return v
    }
  }
  if name.starts_with("mem_file") || name.starts_with("mem_lock") {
    // a test's MemFs handles: the native prelude's llrt_<name>, which
    // sees the fields of File and FileLock (std/native/testing.xo)
    if let Some(v) = b.llrt_or_none(name, nt, vs) {
      return v
    }
  }
  if name == "fs_canceled" {
    // the native prelude's llrt_fs_canceled (poll.xo); rt.fs_canceled
    // only in a wasm module (its runtime's)
    if let Some(v) = b.llrt_or_none(name, nt, vs) {
      return v
    }
  }
  if !b.wasm && (wasm_only_rt(name) || (name.starts_with("stdin_") && b.target_os() != "windows")) {
    // the calls of a layer 0 or Windows arm that this target never takes
    // (the passes keep every arm, gotchas/dead-target-arm-still-links.md):
    // a fault, as a platform call of another OS, so no C stub is needed
    let (span, _, _) = call_parts(x)
    b.fault(b.const_str("the runtime call `rt.${name}` on ${b.target_os()}"), b.pos_line(span))
    b.dead()
    return b.undef(nt)
  }
  if b.is_never(b.c.objs[fo].result) {
    b.rt(name, -1, vs)
    b.add(Op.Unreachable, -1, Aux.None, [])
    b.dead()
    return b.undef(nt)
  }
  b.rt(name, nt, vs)
}

/// rt.sym_present("name") (decision 0232): whether the C symbol name,
/// weakly referenced (sys_c.xo's `weak_` declarations), was linked: the
/// call `rt.pc.cp.<name>`, its address compared with 0; false in a wasm
/// module, and on Windows for a sanitizer's symbol (`__tsan_`,
/// `__sanitizer_`: no sanitizer runtime links there; `__tsan_go_start`,
/// ThreadSanitizer's Go flavor, is a --race build's), and on every target
/// for a `__tsan_` symbol outside --race, a result of the
/// target that fold_known_calls folds (so the TSan helpers' pthread calls
/// go, gotchas/windows-llvm-split-link.md). The argument is a string
/// literal.
fn (var b: Builder) sym_present(x: Expr, es: List[Expr?]) -> Int {
  let sym = match es[0] ?? fault("arg") {
    StringLit(s) => if s.parts.len() == 1 && s.parts[0].expr == None { check.text(s.parts[0].text) } else { "" }
    _ => ""
  }
  if sym.is_empty() {
    b.unsupported("rt.sym_present of anything but a string literal")
    return b.cbool(false)
  }
  if !b.wasm && b.target_os() == "windows" && sym == "__tsan_go_start" {
    // ThreadSanitizer's Go flavor, which a windows --race build links
    // (sanhook.xo gorace, decision 0273's Windows addendum): known
    b.s.f.target = true
    return b.cbool(b.c.race)
  }
  if b.wasm || (b.target_os() == "windows" && (sym.starts_with("__tsan_") || sym.starts_with("__sanitizer_"))) {
    b.s.f.target = true
    return b.cbool(false)
  }
  if sym.starts_with("__tsan_") && !b.c.race && !b.c.async_preempt_llvm && !b.c.mods.any(fn(m) { !m.c_prefix.is_empty() }) {
    // ThreadSanitizer's runtime links only into a --race build, with a
    // `use c` object built with -fsanitize=thread, or into LLVM IR a
    // harness compiles with it (TestSysCTSan: xotool.LLVMIR, then clang
    // -fsanitize=thread; c.async_preempt_llvm is the LLVM backend's
    // flag); the front end's cache keys hold race, llvm and the modules.
    // With none,
    // known false, so the guarded
    // weak calls go and the program imports none of ___tsan_* (14 failed
    // weak lookups at every launch, about 8% of an empty program's
    // startup; Lang 1, 2026-10-28)
    b.s.f.target = true
    return b.cbool(false)
  }
  b.add(Op.Call, b.bool_t(), Aux.S(s: "rt.pc.cp.${sym}"), [])
}

/// rt.fn_addr("name") (decision 0233): the address of the C ABI export
/// xo_x_<name>, a FuncAddr of its symbol (an aux that starts with `@`,
/// which the emitters take as a C symbol, not a function of the
/// module). The argument is a string literal naming an export of the
/// program.
/// rt.wasi_hook("NAME") in a wasm build: the table index of the C ABI
/// export module's function NAME (a free hook of a runtime record,
/// compiler/wasm rt9.xo $hfree_any), the function built for it. Unlike
/// rt.fn_addr, which stays a faulting call on wasm (lowering it would
/// build every function it names, native ones included), only the wasm
/// arms that need a hook name one.
fn (var b: Builder) wasi_hook(es: List[Expr?]) -> Int {
  let it = b.int_t()
  let name = match es[0] ?? fault("arg") {
    StringLit(s) => if s.parts.len() == 1 && s.parts[0].expr == None { check.text(s.parts[0].text) } else { "" }
    _ => ""
  }
  var o = -1
  for m in b.c.mods {
    if m.path == "native/llrt/cabi" || m.path.starts_with("native/llrt/cabi_") {
      let k = m.members.get(name.bytes()) ?? -1
      if k >= 0 && b.c.objs[k].kind == check.ObjKind.Func && b.c.objs[k].recv < 0 {
        o = k
      }
    }
  }
  if o < 0 {
    b.unsupported("rt.wasi_hook of `${name}`, which no C ABI export module (native/llrt/cabi*) defines")
    return b.undef(it)
  }
  let fi = b.declare(o, [])
  b.add(Op.FuncAddr, it, Aux.S(s: b.m.funcs[fi].name), [])
}

fn (var b: Builder) fn_addr(es: List[Expr?]) -> Int {
  let it = b.int_t()
  let name = match es[0] ?? fault("arg") {
    StringLit(s) => if s.parts.len() == 1 && s.parts[0].expr == None { check.text(s.parts[0].text) } else { "" }
    _ => ""
  }
  if name.is_empty() {
    b.unsupported("rt.fn_addr of anything but a string literal")
    return b.undef(it)
  }
  // a top-level function of an export module (the exports themselves
  // are declared after the build's queue, declare_exports; the verifier
  // checks that the program has the symbol)
  var found = false
  for m in b.c.mods {
    if m.path == "native/llrt/cabi" || m.path.starts_with("native/llrt/cabi_") {
      let o = m.members.get(name.bytes()) ?? -1
      if o >= 0 && b.c.objs[o].kind == check.ObjKind.Func && b.c.objs[o].recv < 0 {
        found = true
      }
    }
  }
  if !found {
    b.unsupported("rt.fn_addr of `${name}`, which no C ABI export module (native/llrt/cabi*) defines")
    return b.undef(it)
  }
  if b.wasm {
    // no exports in a WASI module: a call that faults if it runs
    return b.rt("fn_addr", it, [])
  }
  b.add(Op.FuncAddr, it, Aux.S(s: "@xo_x_${name}"), [])
}

/// rt.sym_addr("name") (decision 0234): the address of the C level
/// symbol name under that exact name, a FuncAddr whose aux is `&` and the
/// name (the emitters declare it when the module does not define it).
/// The argument is a string literal.
fn (var b: Builder) sym_addr(es: List[Expr?]) -> Int {
  let it = b.int_t()
  let name = match es[0] ?? fault("arg") {
    StringLit(s) => if s.parts.len() == 1 && s.parts[0].expr == None { check.text(s.parts[0].text) } else { "" }
    _ => ""
  }
  if name.is_empty() {
    b.unsupported("rt.sym_addr of anything but a string literal")
    return b.undef(it)
  }
  if b.wasm {
    // no C symbols in a WASI module: a call that faults if it runs
    return b.rt("fn_addr", it, [])
  }
  b.add(Op.FuncAddr, it, Aux.S(s: "&${name}"), [])
}

/// The wasm runtime's call that serves a call of the native runtime's
/// function name of module path in a WASI module, or "": rand.xo's
/// entropy (the system's generator, rand_bytes: WASI random_get, as
/// Rand.bytes; decision 0231's addendum of 2026-10-16) and process.xo's
/// real_env_get (the C environment, env_get: WASI environ_get, as
/// Env.get). Their native bodies have no source there
/// (gotchas/wasm-native-rand-no-entropy.md).
fn wasi_served(path: Str, name: Bytes) -> Str {
  if path == "native/llrt/rand" && name == b"entropy" {
    return "rand_bytes"
  }
  if path == "native/llrt/process" && name == b"real_env_get" {
    return "env_get"
  }
  if path == "native/llrt/stdio" && name == b"out" {
    // Stdio.write's bytes: the native buffer is flushed by the runtime's
    // exit, which a WASI module does not have, and its flush is a
    // platform call; written through directly, as print and println are
    return "stdio_out"
  }
  if path == "native/llrt/process" && name == b"env_real_at" {
    // a test binary's variables (XO_TEST and friends, twrun.start): the
    // C runtime's envp, which a WASI module does not have; environ_get
    return "env_real_at"
  }
  if path == "native/llrt/testworld" && name == b"write_real" {
    // the test harness's channel (a failure, a log record, the begin and
    // end marks) on the real standard output: WASI fd_write, where the
    // native body's arms are Linux, Darwin, and Windows system calls
    return "tw_write_real"
  }
  if path == "native/llrt/testworld" && name == b"quit" {
    // a test binary's immediate exit: WASI proc_exit
    return "tw_quit"
  }
  ""
}

/// Whether rt.<name> is served only by a wasm module's runtime: the calls
/// of sysio.xo's and fsops.xo's layer 0 arms (std/native/rt.xo fs_read
/// through fs_unlock, and the error record fs_set_err, fs_status,
/// fs_msg).
fn wasm_only_rt(name: Str) -> Bool {
  if name is "fs_root" | "fs_mode" | "fs_new" | "fs_canceled" {
    return false
  }
  // a wasi:http component's calls (compiler/wasm rt5.xo): std's client
  // reaches them from its wasm arm on every target; a wasip2 command's
  // sockets (rt9.xo, std/native/llrt/netwasi.xo) and the records of its
  // HTTP server's wasm arms (decision 0447 R2a)
  name.starts_with("fs_") || name.starts_with("wasi_http_") || name.starts_with("wasi_sock_") || name is "wasi_hook" | "wasi_handle_new" | "wasi_rc_inc" | "wasi_rc_dec" | "wasi_h_release" | "wasi_mono_ns" | "wasi_scope_new" | "wasi_scope_group" | "wasi_scope_close" | "wasi_park_wait" | "wasi_park_signal"
}

/// A call of a platform library function declared in
/// std/native/sys_<os>.xo (decision 0213): the call `rt.pc.<os>.<sym>`,
/// with `/<n>` when the function is variadic after its first n
/// parameters (those before the first one named `va_*`). The emitters
/// lower it to a call of the bare C symbol with the C ABI (an Int is a
/// word, an Int32 or UInt32 a C int, a Float a double, Bytes its data
/// address). For another OS, or a wasm module, the call is a fault: the
/// passes keep every arm of a `match` on `target`, and the symbol may not
/// exist there.
fn (var b: Builder) platform_call(x: Expr, fo: Int, os0: Str, name0: Str, es: List[Expr?]) -> Int {
  // std/native/sys_c.xo (decision 0232): the C library's symbol on every
  // native OS (`rt.pc.c.<sym>`), a weak reference when the name starts
  // with `weak_` (`rt.pc.cw.<sym>`, the prefix dropped)
  var os = os0
  var name = name0
  if os == "c" && name.starts_with("weak_") {
    os = "cw"
    name = name.trim_prefix("weak_")
  }
  if b.wasm || (os != "c" && os != "cw" && os != b.target_os()) {
    let (span, _, _) = call_parts(x)
    b.fault(b.const_str("the platform call `${name}` of ${os} on another OS"), b.pos_line(span))
    b.dead()
    return b.undef(b.typ(b.c.objs[fo].result))
  }
  var vs: List[Int] = []
  var nfixed = -1
  for (i, p) in b.c.objs[fo].params.indexed() {
    if nfixed < 0 && check.text(p.name).starts_with("va_") {
      nfixed = i
    }
    let pt = b.typ(p.ty)
    match b.tkind(pt) {
      Int | Float | Str => {}
      _ => {
        b.unsupported("a platform call taking a `${b.m.types[pt].name}`")
        return b.undef(b.typ(b.c.objs[fo].result))
      }
    }
    vs.push(b.value_as(es[i] ?? fault("arg"), pt))
  }
  var aux = "rt.pc.${os}.${name}"
  if nfixed >= 0 {
    aux = "${aux}/${nfixed}"
  }
  let rt0 = b.typ(b.c.objs[fo].result)
  match b.tkind(rt0) {
    Unit => {
      b.add(Op.Call, b.unit_t(), Aux.S(s: aux), vs)
      b.unit()
    }
    Int | Float => b.add(Op.Call, rt0, Aux.S(s: aux), vs)
    _ => {
      b.unsupported("a platform call returning a `${b.m.types[rt0].name}`")
      b.undef(rt0)
    }
  }
}

/// The OS of the build's target (`darwin`, `linux`, `windows`,
/// `wasip1`): goos, or the builder's own.
fn (b: Builder) target_os() -> Str {
  if !b.goos.is_empty() {
    return b.goos
  }
  match target.os {
    Darwin => "darwin"
    Linux => "linux"
    Windows => "windows"
    Wasi => "wasip1"
    FreeBSD => "freebsd"
  }
}

// ---------------------------------------------------------------------------
// Raw memory intrinsics (internal/ssa rawmem.go, decision 0207)

/// The table of rt.layout (internal/ssa Layout): the offsets and sizes
/// of the C runtime's objects on the 64 bit native targets, or (wasm) of
/// the wasm runtime's; -1 for a key outside it.
pub fn layout_value(k: Int, wasm: Bool) -> Int {
  let native = [16, 8, 24, 8, 16, 0, 8, 8]
  let w32 = [8, 4, 16, 4, 8, 0, 4, 4]
  if k < 0 || k >= native.len() {
    return -1
  }
  if wasm { w32[k] } else { native[k] }
}

/// Checks and folds the raw memory intrinsics (rawIntrinsic): the value
/// and true, or false for another intrinsic.
fn (var b: Builder) raw_intrinsic(name: Str, vs: List[Int]) -> (Int, Bool) {
  if name == "layout" {
    let (k, ok) = b.const_word(vs[0])
    let n = layout_value(k, b.wasm)
    if !ok || n < 0 {
      b.unsupported("`rt.layout` of a key that is not a constant of the layout table")
      return (b.undef(b.int_t()), true)
    }
    return (b.cint(n), true)
  }
  if name == "static_word" {
    // word k of the process globals (decision 0207, work item B02; 256
    // words since decision 0237): the emitters add 8 * k to the table's
    // address
    let (k, ok) = b.const_word(vs[0])
    if !ok || k < 0 || k >= 256 {
      b.unsupported("`${b.s.f.name}`: `rt.static_word` of a word that is not a constant 0 to 255")
      return (b.undef(b.int_t()), true)
    }
  }
  if name is "mem_load" | "mem_store" {
    let (w, ok) = b.const_word(vs[vs.len() - 1])
    if !ok || !(w is 1 | 2 | 4 | 8) {
      b.unsupported("`rt.${name}` of a width that is not a constant 1, 2, 4, or 8")
      return (b.undef(b.int_t()), true)
    }
  }
  (-1, false)
}

/// rt.obj_addr[T] and rt.obj_at[T] (rawGeneric) of type t: the value and
/// true, or false for another generic intrinsic.
fn (var b: Builder) raw_generic(name: Str, t: Int, es: List[Expr?]) -> (Int, Bool) {
  let it = b.int_t()
  let k = b.tkind(t)
  if name == "obj_addr" {
    if !(k is Kind.Str | Kind.List | Kind.Handle) {
      b.unsupported("`rt.obj_addr` of a `${b.m.types[t].name}` (a Str, List, or handle)")
      return (b.undef(it), true)
    }
    let v = b.value_as(es[0] ?? fault("arg"), t)
    return (b.rt("obj_addr", it, [v]), true)
  }
  if name == "obj_at" {
    if !(k is Kind.List | Kind.Handle) {
      b.unsupported("`rt.obj_at` of a `${b.m.types[t].name}` (a List or handle)")
      return (b.undef(t), true)
    }
    let a = b.value_as(es[0] ?? fault("arg"), it)
    return (b.rt("obj_at", t, [a]), true)
  }
  (-1, false)
}

/// a.min(b) or a.max(b) on Int, Float, the sized integers, Str, and an
/// orderable struct, enum, tuple or newtype; -1 for another type
/// (ordMinMax).
fn (var b: Builder) ord_min_max(name: Str, a: Int, c: Int) -> Int {
  let t = b.vty(a)
  if b.m.is_sized(t) {
    return b.sized_min_max(name, a, c)
  }
  if b.tkind(t) == Kind.Int || b.tkind(t) == Kind.Float {
    let base = if b.tkind(t) == Kind.Float { "Float" } else { "Int" }
    return b.call("${base}.${name}", t, "", [a, c])
  }
  // Str by str.cmp; a derived Ord struct, enum or tuple, or a newtype
  // (decision 0390), by its xo.cmp[T]
  let cf = if b.tkind(t) == Kind.Str { "str.cmp" } else { b.cmp_func(t) }
  if !cf.is_empty() {
    let bt = b.bool_t()
    let cmp = b.call(cf, b.int_t(), "", [c, a])
    var pick = -1
    if name == "min" {
      pick = b.add(Op.Lt, bt, Aux.None, [cmp, b.cint(0)])
    } else {
      pick = b.add(Op.Gt, bt, Aux.None, [cmp, b.cint(0)])
    }
    let join = b.new_block()
    let res = b.s.f.add_param(join, t)
    let (yes, no) = b.branch(pick)
    b.s.cur = yes
    b.jump(join, [c])
    b.s.cur = no
    b.jump(join, [a])
    b.seal(join)
    b.s.cur = join
    return res
  }
  -1
}

/// `a.cmp(c)`, an Ordering of type t: Less when a < c, Greater when c < a,
/// else Equal (a NaN compares Equal), by the comparison `<` uses.
fn (var b: Builder) ord_cmp(t: Int, a: Int, c: Int) -> Int {
  let join = b.new_block()
  let res = b.s.f.add_param(join, t)
  let lt = b.compare_values(lexer.Kind.Lt, a, c)
  let (yes, no) = b.branch(lt)
  b.s.cur = yes
  b.jump(join, [b.variant(t, "Less", [])])
  b.s.cur = no
  let gt = b.compare_values(lexer.Kind.Lt, c, a)
  let (y2, n2) = b.branch(gt)
  b.s.cur = y2
  b.jump(join, [b.variant(t, "Greater", [])])
  b.s.cur = n2
  b.jump(join, [b.variant(t, "Equal", [])])
  b.seal(join)
  b.s.cur = join
  res
}

/// Whether e is the expression of a `var` receiver or argument that is a
/// place; the receiver expression of ci.
fn (var b: Builder) recv_value(ci: check.CallInfo) -> Int {
  b.expr(ci.recv[0])
}

/// A prelude function or method: a runtime call, inline code, or a
/// terminator (stdCall).
fn (var b: Builder) std_call(x: Expr, ci: check.CallInfo) -> Int {
  let (span, _, args) = call_parts(x)
  let fo = ci.fn_obj
  let nt = b.nat_of(x)
  let bt = b.bool_t()
  let it = b.int_t()
  let fm = b.obj_mod(fo)
  let fname = b.obj_name(fo)
  if !b.c.mods[fm].is_prelude {
    b.unsupported("the std function `${b.c.mods[fm].name}.${b.c.display_name(fo)}`")
    return b.undef(nt)
  }
  let r = b.c.objs[fo].recv
  if r < 0 {
    if fname == "fault" && args.len() == 1 {
      let msg = b.value_as(args[0].value, b.str_t())
      b.fault(msg, b.pos(span))
      b.dead()
      return b.undef(nt)
    }
    if fname == "dbg" && args.len() == 1 {
      // `[file:line:col] source = Debug text` on stderr, the value
      // returned; a release build computes only the value (decision 0265)
      let a = args[0].value
      let v = b.value_as(a, nt)
      if b.dbg_on() {
        let head = b.const_str("[${b.pos(span)}] ${b.source_text(b.s.file, parser.expr_span(a))} = ")
        b.eprintln_rt(b.append_debug(head, v, b.check_type(a)))
      }
      return v
    }
    b.unsupported("the prelude function `${fname}`")
    return b.undef(nt)
  }
  let rname = b.obj_name(r)
  let is_static = b.c.objs[fo].flags.is_static()
  match rname {
    "Range" => {
      let recv = strip_parens(ci.recv[0])
      if let RangeExpr(lo: Some(lo), hi: Some(hi), inclusive: inclusive, ..) = recv {
        if fname == "to_list" {
          let nm = b.native_mod("std/prelude")
          if nm >= 0 {
            let impl = b.member(nm, "int_range_list")
            if impl >= 0 && b.c.objs[impl].kind == check.ObjKind.Func {
              let lv = b.value_as(lo, it)
              var hv = b.value_as(hi, it)
              if inclusive {
                hv = b.add(Op.Add, it, Aux.None, [hv, b.cint(1)])
              }
              let f = b.declare(impl, [])
              return b.call(b.m.funcs[f].name, b.m.funcs[f].results[0], "", [lv, hv])
            }
          }
        }
      }
    }
    "Int8" | "Int16" | "Int32" | "Int64" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Rune" => {
      // UInt64's bits as an Int and back: the word unchanged (an iconv
      // between two 64 bit integers moves no bits)
      if rname == "UInt64" && is_static && fname == "from_bits" && args.len() == 1 {
        return b.add(Op.IntConv, nt, Aux.None, [b.value_as(args[0].value, it)])
      }
      if rname == "UInt64" && !is_static && fname == "to_bits" && ci.recv.len() == 1 {
        return b.add(Op.IntConv, it, Aux.None, [b.recv_value(ci)])
      }
      // T.wrapping_from(x): Go's conversion T(x) of an Int, the low bits
      // kept (sign extended for a signed T), no fault (spec/std.md 2.1)
      if is_static && fname == "wrapping_from" && args.len() == 1 && rname != "Rune" {
        let v = b.value_as(args[0].value, it)
        let bits = b.m.types[nt].bits
        if bits == 0 || bits >= 64 {
          return b.add(Op.IntConv, nt, Aux.None, [v])
        }
        if rname.starts_with("U") {
          let masked = b.add(Op.And, it, Aux.None, [v, b.cint((1 << bits) - 1)])
          return b.add(Op.IntConv, nt, Aux.None, [masked])
        }
        let hi = b.rt("int_wrap", it, [b.cint(3), v, b.cint(64 - bits)])
        let ext = b.add(Op.Shr, it, Aux.None, [hi, b.cint(64 - bits)])
        return b.add(Op.IntConv, nt, Aux.None, [ext])
      }
      if is_static && fname == "try" && args.len() == 1 && b.tkind(nt) == Kind.Enum {
        let v = b.value_as(args[0].value, it)
        let some = b.m.variant_index(nt, "Some")
        let to = b.m.types[nt].variants[some].fields[0].ty
        var ok = -1
        if b.sized_inline() {
          // inline (std/native/llrt/ints.xo, decision 0195)
          if b.m.types[to].name == "Rune" {
            ok = b.rune_valid(v)
          } else {
            ok = b.in_range(v, to)
          }
        } else if b.m.types[to].name == "Rune" {
          ok = b.rt("rune_valid", bt, [v])
        } else {
          var rargs = [v]
          for a in b.size_args(to) {
            rargs.push(a)
          }
          ok = b.rt("int_in_range", bt, rargs)
        }
        let join = b.new_block()
        let res = b.s.f.add_param(join, nt)
        let (yes, no) = b.branch(ok)
        b.s.cur = yes
        var w = v
        if to != it {
          w = b.add(Op.IntConv, to, Aux.None, [v])
        }
        b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: some), [w])])
        b.s.cur = no
        b.jump(join, [b.variant(nt, "None", [])])
        b.seal(join)
        b.s.cur = join
        return res
      }
    }
    "Buf" => {
      if is_static && fname == "with_capacity" && args.len() == 1 && b.tkind(nt) == Kind.List {
        // room for n elements, as List.with_capacity (decision 0170): the
        // size was evaluated and dropped, so a Buf of 1,000,000 grew from
        // empty through about 40 copies (micro13 sort1M, 2026-11-05)
        return b.call("list.new", nt, "", [b.value_as(args[0].value, it), b.cint(1)])
      }
      if is_static && fname == "new" && b.tkind(nt) == Kind.List {
        return b.call("list.new", nt, "", [])
      }
      if b.c.objs[fo].flags.recv_var() && fname == "push" && args.len() == 1 {
        var p = b.place(ci.recv[0])
        if p.ok && b.tkind(p.t()) == Kind.List {
          let v = b.value_as(args[0].value, b.m.types[p.t()].elems[0])
          let l = b.place_get(p)
          b.place_set(p, b.call("list.push", p.t(), "", [l, v]))
          return b.unit()
        }
      } else if !is_static && fname == "len" {
        let l = b.expr(ci.recv[0])
        return b.call("list.len", it, "", [l])
      } else if !is_static && fname == "freeze" {
        return b.expr(ci.recv[0])
      }
    }
    "Secret" => {
      if is_static && fname == "new" && args.len() == 1 && b.tkind(nt) == Kind.Struct && b.m.types[nt].fields.len() == 1 {
        let v = b.value_as(args[0].value, b.m.types[nt].fields[0].ty)
        return b.add(Op.Struct, nt, Aux.None, [v])
      }
      if !is_static && fname == "reveal" && args.is_empty() {
        let sv = b.expr(ci.recv[0])
        let svt = b.vty(sv)
        if b.tkind(svt) == Kind.Struct && b.m.types[svt].fields.len() == 1 {
          return b.add(Op.Field, b.m.types[svt].fields[0].ty, Aux.I(n: 0), [sv])
        }
      }
    }
    "Map" | "Set" => {
      if let Some(v) = b.map_call(x, ci) {
        return v
      }
    }
    "Stdio" => {
      if fname is "print" | "println" | "eprint" | "eprintln" {
        let rv = b.expr(ci.recv[0])
        let mv = b.value_as(args[0].value, b.str_t())
        if b.stdio_llrt(fname, mv) {
          return b.unit()
        }
        return b.call("Stdio.${fname}", b.unit_t(), "", [rv, mv])
      }
      if fname is "write" | "read_line" | "read_all" | "lines" | "read_secret" | "raw_input" | "read_bytes" | "read_all_bytes" | "stdin_is_tty" | "stdout_is_tty" | "stderr_is_tty" | "width" {
        if stdio_reads(fname) {
          // reads wait on the event loop
          b.set_flag(1)
          if !b.conc {
            return b.conc_off(nt)
          }
        }
        let pm = b.native_mod("std/prelude")
        if pm >= 0 {
          let impl = b.member(pm, "stdio_${fname}")
          if impl >= 0 && b.c.objs[impl].kind == check.ObjKind.Func && b.c.objs[impl].recv < 0 {
            return b.call_as(x, ci, impl)
          }
        }
      }
    }
    "List" => {
      if is_static && fname == "with_capacity" && args.len() == 1 && b.tkind(nt) == Kind.List {
        // list.new with a size: room for n elements (decision 0170); the
        // second argument asks for exactly n (rt rl_new_cap, decision
        // 0448), where a literal's size keeps the runtime's minimum
        return b.call("list.new", nt, "", [b.value_as(args[0].value, it), b.cint(1)])
      }
      if b.c.objs[fo].flags.recv_var() {
        var p = b.place(ci.recv[0])
        if p.ok && b.tkind(p.t()) == Kind.List {
          let lt = p.t()
          let et = b.m.types[lt].elems[0]
          match fname {
            "push" => {
              let v = b.value_as(args[0].value, et)
              let l = b.place_get(p)
              b.place_set(p, b.call("list.push", lt, "", [l, v]))
              return b.unit()
            }
            "set" => {
              let i = b.value_as(args[0].value, it)
              let v = b.value_as(args[1].value, et)
              let l = b.place_get(p)
              b.place_set(p, b.call("list.set", lt, b.pos_line(span), [l, i, v]))
              return b.unit()
            }
            "pop" => {
              let l = b.place_get(p)
              let rt = b.m.tuple([lt, nt])
              let rv = b.call("list.pop", rt, "", [l])
              b.place_set(p, b.add(Op.Field, lt, Aux.I(n: 0), [rv]))
              return b.add(Op.Field, nt, Aux.I(n: 1), [rv])
            }
            _ => {}
          }
        }
      } else {
        // a variable or field path receiver is read after the index
        // (decision 0326)
        var li = -1
        if fname == "get" && args.len() == 1 && recv_after_args(ci.recv[0]) {
          li = b.value_as(args[0].value, it)
        }
        let l = b.expr(ci.recv[0])
        if b.tkind(b.vty(l)) == Kind.List {
          match fname {
            "len" => return b.call("list.len", it, "", [l])
            "is_empty" => return b.add(Op.Eq, bt, Aux.None, [b.call("list.len", it, "", [l]), b.cint(0)])
            "get" => {
              let i = if li >= 0 { li } else { b.value_as(args[0].value, it) }
              return b.call("list.get", nt, "", [l, i])
            }
            "first" => return b.call("list.get", nt, "", [l, b.cint(0)])
            "last" => {
              let n = b.call("list.len", it, "", [l])
              return b.call("list.get", nt, "", [l, b.add(Op.Sub, it, Aux.None, [n, b.cint(1)])])
            }
            _ => {}
          }
        }
      }
    }
    "Option" | "Result" => {
      let o = b.expr(ci.recv[0])
      let ot = b.vty(o)
      if b.tkind(ot) == Kind.Enum {
        let key = "${rname}.${fname}"
        match key {
          "Option.is_some" => return b.is_tag(o, "Some")
          "Option.is_none" => return b.is_tag(o, "None")
          "Result.is_ok" => return b.is_tag(o, "Ok")
          "Result.is_err" => return b.is_tag(o, "Err")
          "Result.ok" | "Result.err" => {
            let vname = if fname == "err" { "Err" } else { "Ok" }
            let from = b.m.variant_index(ot, vname)
            let join = b.new_block()
            let res = b.s.f.add_param(join, nt)
            let (yes, no) = b.branch(b.is_tag(o, vname))
            b.s.cur = yes
            let pv = b.add(Op.Payload, b.m.types[ot].variants[from].fields[0].ty, Aux.P(tag: from, field: 0), [o])
            b.jump(join, [b.variant(nt, "Some", [pv])])
            b.s.cur = no
            b.jump(join, [b.variant(nt, "None", [])])
            b.seal(join)
            b.s.cur = join
            return res
          }
          "Option.or_fault" => {
            let msg = b.value_as(args[0].value, b.str_t())
            let (none, some) = b.branch(b.is_tag(o, "None"))
            b.s.cur = none
            b.fault(msg, b.pos_line(span))
            b.s.cur = some
            let i = b.m.variant_index(ot, "Some")
            return b.add(Op.Payload, b.m.types[ot].variants[i].fields[0].ty, Aux.P(tag: i, field: 0), [o])
          }
          "Result.or_fault" => {
            let rct = b.nat_check(ci.recv[0])
            if b.named_obj(rct) >= 0 && b.ty_args(rct).len() == 2 {
              let st = b.str_t()
              let msg = b.value_as(args[0].value, st)
              let (bad, good) = b.branch(b.is_tag(o, "Err"))
              b.s.cur = bad
              let ei = b.m.variant_index(ot, "Err")
              let ev = b.add(Op.Payload, b.m.types[ot].variants[ei].fields[0].ty, Aux.P(tag: ei, field: 0), [o])
              let pre = b.call("str.concat", st, "", [msg, b.const_str(": ")])
              let text = b.append_display(pre, ev, b.apply(b.ty_args(rct)[1]))
              b.fault(text, b.pos_line(span))
              b.s.cur = good
              let i = b.m.variant_index(ot, "Ok")
              return b.add(Op.Payload, b.m.types[ot].variants[i].fields[0].ty, Aux.P(tag: i, field: 0), [o])
            }
          }
          _ => {}
        }
      }
    }
    "Int" | "Float" | "Str" => {
      // a variable or field path receiver is read after the arguments
      // (decision 0326)
      let late = recv_after_args(ci.recv[0])
      let v0 = if late { -1 } else { b.expr(ci.recv[0]) }
      var vs = [v0]
      for a in args {
        vs.push(b.expr(a.value))
      }
      if late {
        vs[0] = b.expr(ci.recv[0])
      }
      var pos = ""
      if rname == "Int" && fname == "abs" {
        pos = b.pos_line(span)
      }
      let key = "${rname}.${fname}"
      if key is "Int.abs" | "Int.min" | "Int.max" | "Float.min" | "Float.max" | "Float.sqrt" | "Float.floor" | "Float.ceil" | "Float.trunc" | "Float.round" | "Float.abs" | "Float.is_nan" | "Str.len" | "Str.is_empty" {
        return b.call(key, nt, pos, vs)
      }
      // a fused multiply-add is one instruction on arm64 (decision 0385
      // stage 2: fmadd, llvm.fma); elsewhere the software body
      // (gomath.fma) is called
      if key == "Float.fma" && b.goarch == "arm64" {
        return b.call(key, nt, pos, vs)
      }
    }
    _ => {}
  }
  b.unsupported("the method `${b.c.display_name(fo)}`")
  b.undef(nt)
}

/// Int's word methods (decision 0260) as the intrinsics their native
/// bodies call (std/native/prelude.xo), inline in every emitter with no
/// call and no landing check, so the no allocation modules and the adcs
/// chains may use them: wrapping_add, wrapping_sub, wrapping_mul,
/// wrapping_shl, shr_logical, rotate_right, rotate_right32, swap_bytes
/// as rt.int_wrap's operations 0 to 7, mul_hi_unsigned as rt.u64_mul_hi,
/// lt_unsigned and le_unsigned as the signed compare of both words with
/// the sign bit flipped. None for any other call.
fn (var b: Builder) word_method(x: Expr, ci: check.CallInfo) -> Int? {
  let fo = ci.fn_obj
  if fo < 0 || ci.recv.len() != 1 {
    return None
  }
  let r = b.c.objs[fo].recv
  if r < 0 || b.c.objs[fo].flags.is_static() || b.obj_name(r) != "Int" || !b.c.mods[b.obj_mod(fo)].is_prelude {
    return None
  }
  let code = match b.obj_name(fo) {
    "wrapping_add" => 0
    "wrapping_sub" => 1
    "wrapping_mul" => 2
    "wrapping_shl" => 3
    "shr_logical" => 4
    "rotate_right" => 5
    "rotate_right32" => 6
    "swap_bytes" => 7
    "mul_hi_unsigned" => 8
    "lt_unsigned" => 9
    "le_unsigned" => 10
    _ => -1
  }
  if code < 0 {
    return None
  }
  let (_, _, args) = call_parts(x)
  let it = b.int_t()
  let a = b.value_as(ci.recv[0], it)
  let c = if args.is_empty() { b.cint(0) } else { b.value_as(args[0].value, it) }
  if code <= 7 {
    return Some(b.rt("int_wrap", it, [b.cint(code), a, c]))
  }
  if code == 8 {
    return Some(b.rt("u64_mul_hi", it, [a, c]))
  }
  let min = b.cint(-9223372036854775807 - 1)
  let ax = b.add(Op.Xor, it, Aux.None, [a, min])
  let cx = b.add(Op.Xor, it, Aux.None, [c, min])
  Some(b.add(if code == 9 { Op.Lt } else { Op.Le }, b.bool_t(), Aux.None, [ax, cx]))
}

fn strip_parens(e: Expr) -> Expr {
  match e {
    ParenExpr(x: x, ..) => strip_parens(x)
    _ => e
  }
}

fn (var b: Builder) is_tag(o: Int, name: Str) -> Int {
  let t = b.add(Op.Tag, b.int_t(), Aux.None, [o])
  // the index first: a by value read of b.m in the arguments of a `var`
  // call of b would copy the module (an own site)
  let vo = b.vty(o)
  let vi = b.m.variant_index(vo, name)
  b.add(Op.Eq, b.bool_t(), Aux.None, [t, b.cint(vi)])
}

/// The methods of capabilities and builders lowered inline (ioCall): the
/// value, or None for a method ioCall does not lower.
fn (var b: Builder) io_call(x: Expr, ci: check.CallInfo) -> Int? {
  let (span, _, args) = call_parts(x)
  let fo = ci.fn_obj
  let r = b.c.objs[fo].recv
  let fm = b.obj_mod(fo)
  if r < 0 {
    return None
  }
  var rname = b.obj_name(r)
  if b.c.mods[fm].path == "std/testing" {
    let cap = test_cap(rname)
    if cap.is_empty() {
      return None
    }
    rname = cap
  } else if !b.c.mods[fm].is_prelude {
    return None
  }
  let fname = b.obj_name(fo)
  let key = "${rname}.${fname}"
  if rname == "Fs" {
    // fsCall: the function fs_<name> of the native prelude
    if WAITS.contains(key) {
      // Fs.lock waits, polling on the event loop's timers (decision 0172)
      b.set_flag(1)
      if !b.conc {
        return Some(b.conc_off(b.nat_of(x)))
      }
    }
    let pm = b.native_mod("std/prelude")
    if pm >= 0 {
      let impl = b.member(pm, "fs_${b.obj_name(fo)}")
      if impl >= 0 && b.c.objs[impl].kind == check.ObjKind.Func && b.c.objs[impl].recv < 0 {
        return Some(b.call_as(x, ci, impl))
      }
    }
    b.unsupported("the method `Fs.${b.obj_name(fo)}`")
    return Some(b.undef(b.nat_of(x)))
  }
  if rname == "Stdio" && b.c.mods[fm].path == "std/testing" && (fname is "write" | "read_line" | "read_all" | "lines" | "read_secret" | "raw_input" | "read_bytes" | "read_all_bytes" | "stdin_is_tty" | "stdout_is_tty" | "stderr_is_tty" | "width") {
    // a test's FakeStdio: the same functions, whose runtime reads the
    // input set_input gave and has no terminal (std/llrt/xo_stdin.c)
    if stdio_reads(fname) {
      b.set_flag(1)
      if !b.conc {
        return Some(b.conc_off(b.nat_of(x)))
      }
    }
    let pm = b.native_mod("std/prelude")
    if pm >= 0 {
      let impl = b.member(pm, "stdio_${fname}")
      if impl >= 0 && b.c.objs[impl].kind == check.ObjKind.Func && b.c.objs[impl].recv < 0 {
        return Some(b.call_as(x, ci, impl))
      }
    }
  }
  if let Some(v) = b.test_cap_call(x, ci, key) {
    return Some(v)
  }
  if !(rname is "Clock" | "Net" | "Listener" | "Conn" | "ServerConn" | "Proc" | "Env" | "Duration" | "Time" | "Bytes" | "Fs" | "StrBuilder" | "BytesBuilder" | "Rand") {
    if rname != "Str" || fname != "bytes" {
      return None
    }
  }
  let nt = b.nat_of(x)
  let it = b.int_t()
  let st = b.str_t()
  let es = arg_exprs(b.c.objs[fo].params, args)
  if b.call_waits(fo, key) {
    // operations that wait (waits.xo): the program needs unwinding checks
    b.set_flag(1)
    if !b.conc {
      return Some(b.conc_off(nt))
    }
  }
  let pos = b.pos_line(span)
  if b.c.objs[fo].flags.is_static() {
    match key {
      "Duration.from_nanos" => return Some(b.io_arg(fo, es, 0, it))
      "Duration.from_millis" => return Some(b.mul_pos(b.io_arg(fo, es, 0, it), 1000000, pos))
      "Duration.from_secs_int" => return Some(b.mul_pos(b.io_arg(fo, es, 0, it), 1000000000, pos))
      "Time.from_unix" => return Some(b.mul_pos(b.io_arg(fo, es, 0, it), 1000000000, pos))
      "Time.from_unix_millis" => return Some(b.mul_pos(b.io_arg(fo, es, 0, it), 1000000, pos))
      "Time.UNIX_EPOCH" => return Some(b.cint(0))
      "StrBuilder.new" | "BytesBuilder.new" => return Some(b.const_str(""))
      "BytesBuilder.with_capacity" => return Some(b.rt("rs_with_cap", st, [b.io_arg(fo, es, 0, it)]))
      _ => {}
    }
    b.unsupported("`${b.c.display_name(fo)}`")
    return Some(b.undef(nt))
  }
  if key is "StrBuilder.write" | "BytesBuilder.write" | "BytesBuilder.write_str" | "BytesBuilder.write_byte" | "BytesBuilder.write_rune" | "BytesBuilder.put_le" | "BytesBuilder.put_be" | "BytesBuilder.write_le" | "BytesBuilder.write_be" {
    var p = b.place(ci.recv[0])
    if !p.ok {
      return Some(b.undef(nt))
    }
    let cur = b.place_get(p)
    match fname {
      "put_le" | "put_be" => {
        // decision 0399: the n low bytes of v stored in place over the
        // builder's bytes at `at`; a builder stays an object (an inline Str
        // has no bytes to store into: it is copied to one first)
        let at = b.io_arg(fo, es, 0, it)
        let v = b.io_arg(fo, es, 1, it)
        let n = b.io_arg(fo, es, 2, it)
        if b.wasm {
          b.put_check_wasm(cur, at, n, pos)
        }
        var cb = cur
        if b.c.inline_str {
          // cur + "", not "" + cur: an append of nothing keeps a unique
          // builder's object in place (obj.xo reserve) and makes only an
          // inline Str an object; "" + cur copied the whole builder on
          // every put (jpeg_decode 5.8x, 2026-11-04)
          cb = b.call("str.concat_obj", st, "", [cur, b.const_str("")])
        }
        let be = b.cint(if fname == "put_be" { 1 } else { 0 })
        if let Some(r) = b.llrt_or_none("rs_put", st, [cb, at, v, n, be, b.const_str(pos)]) {
          b.place_set(p, r)
        } else {
          b.place_set(p, b.rt("rs_put", st, [cb, at, v, n, be]))
        }
      }
      "write_le" if !b.wasm => {
        // decision 0561: the n low bytes of v appended, one word push. The
        // width's check here, then rt.rs_push_word itself (arm64's push_fast
        // in a loop, LLVM's inline fast path): llrt_rs_write, whose fault
        // call gave it landing pads, was never inlined (XO_INLINE_REPORT
        // "padded"), and its call and the push's were a third of protobuf
        // marshal on host 1 (2026-11-12)
        let v = b.io_arg(fo, es, 0, it)
        let n = b.io_arg(fo, es, 1, it)
        b.write_width_check(n, pos)
        b.place_set(p, b.rt("rs_push_word", st, [cur, v, n]))
      }
      "write_le" | "write_be" => {
        // decision 0561: the n low bytes of v appended, one word push
        let v = b.io_arg(fo, es, 0, it)
        let n = b.io_arg(fo, es, 1, it)
        let be = b.cint(if fname == "write_be" { 1 } else { 0 })
        if let Some(r) = b.llrt_or_none("rs_write", st, [cur, v, n, be, b.const_str(pos)]) {
          b.place_set(p, r)
        } else {
          // wasm: $rs_write in rt.xo, after the width's check here (its
          // own was a trap, "unreachable", where native faults; 2026-11-12)
          b.write_width_check(n, pos)
          b.place_set(p, b.rt("rs_write", st, [cur, v, n, be]))
        }
      }
      "write_byte" => {
        let a = b.io_arg(fo, es, 0, b.m.int_type("UInt8"))
        b.place_set(p, b.rt("rs_push_byte", st, [cur, a]))
      }
      "write_rune" => {
        let a = b.io_arg(fo, es, 0, b.m.int_type("Rune"))
        // the native prelude's llrt_rs_push_rune (raw.xo push_rune)
        b.place_set(p, b.llrt_or_rt("rs_push_rune", st, [cur, a]))
      }
      _ => {
        // an interpolation written to a builder appends its pieces to the
        // builder itself, with no Str of its own (string_lit_into); not
        // with inline Strs, whose builder must stay an object
        if !b.c.inline_str && fname is "write" | "write_str" {
          if let Some(Expr.StringLit(lit)) = es[0] {
            if lit.parts.any(fn(q) { q.expr is Some(_) }) && b.pure_pieces(lit) {
              b.place_set(p, b.string_lit_into(cur, lit))
              return Some(b.unit())
            }
          }
        }
        let a = b.io_arg(fo, es, 0, st)
        // a builder stays an object (decision 0370): its pieces are not
        // folded into an inline Str and back
        b.place_set(p, b.call(if b.c.inline_str { "str.concat_obj" } else { "str.concat" }, st, "", [cur, a]))
      }
    }
    return Some(b.unit())
  }
  let impl_name = cap_impl(key)
  if impl_name != "" {
    // the native prelude's implementation (a capability's method has no
    // implementation lookup of its own); internal/ssa's capImpls
    let pm = b.native_mod("std/prelude")
    if pm >= 0 {
      let impl = b.member(pm, impl_name)
      if impl >= 0 && b.c.objs[impl].kind == check.ObjKind.Func {
        return Some(b.call_as(x, ci, impl))
      }
    }
  }
  let recv = b.expr(ci.recv[0])
  if let Some(v) = b.wait_call(key, fo, es, recv, nt) {
    return Some(v)
  }
  match key {
    "StrBuilder.len" | "BytesBuilder.len" => return Some(b.call("Str.len", it, "", [recv]))
    "StrBuilder.freeze" => return Some(recv)
    "BytesBuilder.freeze" => {
      if b.c.inline_str {
        // the builder is a Str's words, and a short one is inline
        // (decision 0370): Bytes is never inline
        return Some(b.rt("str_bytes", nt, [recv]))
      }
      return Some(recv)
    }
    "Env.args" => return Some(b.llrt_or_rt("env_args", b.m.list(st), []))
    "Env.program" => {
      // argv[0] (decision 0190: the CLI servers run themselves again)
      let l = b.llrt_or_rt("env_program", b.m.list(st), [])
      return Some(b.call("list.index", st, "", [l, b.cint(0)]))
    }
    "Proc.exit" => {
      b.exit_rt(b.io_arg(fo, es, 0, it))
      if b.tests {
        // in testing.run_main the exit unwinds main back to it (decision
        // 0108): the runtime returns unwinding
        b.check("")
      }
      b.add(Op.Unreachable, -1, Aux.None, [])
      b.dead()
      return Some(b.undef(nt))
    }
    "Rand.int" => {
      let lo = b.io_arg(fo, es, 0, it)
      let hi = b.io_arg(fo, es, 1, it)
      return Some(b.rand_rt("rand_int", it, [lo, hi, b.const_str(pos)]))
    }
    "Rand.float" => return Some(b.rand_rt("rand_float", b.float_t(), []))
    "Rand.bool" => return Some(b.rand_rt("rand_bool", b.bool_t(), []))
    "Rand.bytes" => return Some(b.rand_rt("rand_bytes", st, [b.io_arg(fo, es, 0, it)]))
    "Clock.now" => return Some(b.clock_now())
    "Clock.since" => {
      let now = b.clock_now()
      let a = b.io_arg(fo, es, 0, it)
      let v = b.add(Op.Sub, it, Aux.None, [now, a])
      b.set_pos(v, pos)
      return Some(v)
    }
    "Proc.set_grace" => {
      b.rt("set_grace", -1, [b.io_arg(fo, es, 0, it)])
      return Some(b.unit())
    }
    "Str.bytes" => {
      if b.c.inline_str {
        // Bytes is never inline (decision 0370): an inline Str becomes an
        // object, any other is counted once more (the arm64 lowering)
        return Some(b.rt("str_bytes", nt, [recv]))
      }
      return Some(recv)
    }
    "Bytes.len" => return Some(b.call("Str.len", it, "", [recv]))
    "Bytes.is_empty" => return Some(b.add(Op.Eq, b.bool_t(), Aux.None, [b.call("Str.len", it, "", [recv]), b.cint(0)]))
    "Bytes.to_str" => {
      let join = b.new_block()
      let res = b.s.f.add_param(join, nt)
      // the native prelude's llrt_utf8_valid (std/native/llrt/scan.xo,
      // decision 0201), else rt.utf8_valid (fn.scanRT)
      let (yes, no) = b.branch(b.scan_rt("utf8_valid", b.bool_t(), [recv]))
      b.s.cur = yes
      b.jump(join, [b.variant(nt, "Some", [recv])])
      b.s.cur = no
      b.jump(join, [b.variant(nt, "None", [])])
      b.seal(join)
      b.s.cur = join
      return Some(res)
    }
    "Duration.nanos" => return Some(recv)
    "Duration.millis" => return Some(b.add(Op.Div, it, Aux.None, [recv, b.cint(1000000)]))
    "Duration.seconds" => {
      // Go's Duration.Seconds to the bit (decision 0503): whole seconds
      // plus the rest over 1e9, which one division rounds differently
      let ft = b.float_t()
      let sec = b.add(Op.Div, it, Aux.None, [recv, b.cint(1000000000)])
      let nsec = b.add(Op.Rem, it, Aux.None, [recv, b.cint(1000000000)])
      let fs = b.add(Op.IntToFloat, ft, Aux.None, [sec])
      let fn_ = b.add(Op.IntToFloat, ft, Aux.None, [nsec])
      let frac = b.add(Op.Div, ft, Aux.None, [fn_, b.add(Op.Const, ft, Aux.F(f: 1000000000.0), [])])
      return Some(b.add(Op.Add, ft, Aux.None, [fs, frac]))
    }
    "Duration.abs" => return Some(b.call("Int.abs", it, pos, [recv]))
    "Time.unix" | "Time.unix_millis" => {
      let unit = if key == "Time.unix_millis" { 1000000 } else { 1000000000 }
      let k = b.cint(unit)
      if b.sized_inline() {
        // std/native/llrt/ints.xo (decision 0195)
        return Some(b.llrt_call("floor_div", [recv, k]))
      }
      return Some(b.rt("floor_div", it, [recv, k]))
    }
    _ => {}
  }
  b.unsupported("the method `${b.c.display_name(fo)}`")
  Some(b.undef(nt))
}

/// The checks of BytesBuilder.put_le and put_be in the wasm build (decision
/// 0399; the native prelude's llrt_rs_put and std/rt's put do their own):
/// n is 1, 2, 4 or 8 and at..at + n lies within the builder, else the
/// fault text they raise.
/// BytesBuilder.write_le's width check in line (0 to 8, llrt_rs_write's
/// fault and text): the fault where n is outside it.
fn (var b: Builder) write_width_check(n: Int, pos: Str) {
  let bt = b.bool_t()
  let bad = b.new_block()
  let (neg, nn) = b.branch(b.add(Op.Lt, bt, Aux.None, [n, b.cint(0)]))
  b.s.cur = neg
  b.jump(bad, [])
  b.s.cur = nn
  let (over, ok) = b.branch(b.add(Op.Gt, bt, Aux.None, [n, b.cint(8)]))
  b.s.cur = over
  b.jump(bad, [])
  b.seal(bad)
  b.s.cur = bad
  b.fault(b.const_str("BytesBuilder.write_le and write_be: width must be 0 to 8"), pos)
  b.s.cur = ok
}

fn (var b: Builder) put_check_wasm(cur: Int, at: Int, n: Int, pos: Str) {
  let it = b.int_t()
  let bt = b.bool_t()
  let wok = b.new_block()
  let bad = b.new_block()
  for w in [1, 2, 4] {
    let (yes, no) = b.branch(b.add(Op.Eq, bt, Aux.None, [n, b.cint(w)]))
    b.s.cur = yes
    b.jump(wok, [])
    b.s.cur = no
  }
  let (y8, n8) = b.branch(b.add(Op.Eq, bt, Aux.None, [n, b.cint(8)]))
  b.s.cur = y8
  b.jump(wok, [])
  b.s.cur = n8
  b.jump(bad, [])
  b.seal(wok)
  b.s.cur = wok
  let len = b.call("Str.len", it, "", [cur])
  let (neg, nn) = b.branch(b.add(Op.Lt, bt, Aux.None, [at, b.cint(0)]))
  b.s.cur = neg
  b.jump(bad, [])
  b.s.cur = nn
  let (over, ok) = b.branch(b.add(Op.Gt, bt, Aux.None, [at, b.add(Op.Sub, it, Aux.None, [len, n])]))
  b.s.cur = over
  b.jump(bad, [])
  b.seal(bad)
  b.s.cur = bad
  b.fault(b.const_str("BytesBuilder.put: width must be 1, 2, 4 or 8 and at..at + width must lie within the builder"), pos)
  b.s.cur = ok
}

/// Argument i of an ioCall, or the parameter's default (arg).
fn (var b: Builder) io_arg(fo: Int, es: List[Expr?], i: Int, t: Int) -> Int {
  match es[i] {
    Some(e) => b.value_as(e, t)
    None => {
      let d = b.c.objs[fo].params[i].default
      if !d.is_empty() {
        return b.foreign_value(d[0], b.decl_file(fo), t, b.s.sub)
      }
      b.unsupported("a call with a missing argument")
      b.undef(t)
    }
  }
}

fn (var b: Builder) mul_pos(v: Int, k: Int, pos: Str) -> Int {
  let r = b.add(Op.Mul, b.int_t(), Aux.None, [v, b.cint(k)])
  b.set_pos(r, pos)
  r
}

/// The one element a runtime list holds, as an Option (popOne).
fn (var b: Builder) pop_one(l: Int, ot: Int) -> Int {
  let rt = b.m.tuple([b.vty(l), ot])
  let r = b.call("list.pop", rt, "", [l])
  b.add(Op.Field, ot, Aux.I(n: 1), [r])
}

/// Whether the Stdio method name reads standard input (it waits on the
/// event loop: the program needs unwinding checks); internal/ssa's
/// stdioReads.
fn stdio_reads(name: Str) -> Bool { WAITS.contains("Stdio.${name}") }

/// The native prelude function implementing the capability method key,
/// or ""; internal/ssa's capImpls.
fn cap_impl(key: Str) -> Str {
  match key {
    "Rand.shuffle" => "rand_shuffle"
    "Env.config_dir" => "env_config_dir"
    "Env.cache_dir" => "env_cache_dir"
    "Env.hostname" => "env_hostname"
    "Env.local_app_data" => "env_local_app_data"
    "Env.get" => "env_get"
    "Env.vars" => "env_vars"
    "Env.home" => "env_home"
    "Env.only" => "env_only"
    "Proc.only" => "proc_only"
    "Net.only" => "net_only"
    "Net.dial_timeout" => "net_dial_timeout"
    "Net.lookup_host" => "net_lookup_host"
    "Net.interfaces" => "net_interfaces"
    "Conn.set_deadline" => "conn_set_deadline"
    "Conn.set_read_deadline" => "conn_set_read_deadline"
    "Conn.set_write_deadline" => "conn_set_write_deadline"
    "ServerConn.set_deadline" => "server_conn_set_deadline"
    "ServerConn.set_read_deadline" => "server_conn_set_read_deadline"
    "ServerConn.set_write_deadline" => "server_conn_set_write_deadline"
    "Proc.cmd" => "proc_cmd"
    "Proc.pipeline" => "proc_pipeline"
    "Proc.kill" => "proc_kill"
    "Proc.notify" => "proc_notify"
    "Proc.stop_notify" => "proc_stop_notify"
    "Proc.request_stop" => "proc_request_stop"
    "Proc.pid" => "proc_pid"
    "Proc.ppid" => "proc_ppid"
    "Proc.usage" => "proc_usage"
    "Proc.children_usage" => "proc_children_usage"
    _ => ""
  }
}

/// Whether fo is a std function that declares a network effect (`uses
/// net.dial`: the prelude's Net, Listener and Conn methods, std/dns's
/// lookups, std/udp's sockets and the rest): it waits on the network, so
/// the program keeps the scheduler and its waits unwind (core 7.5), and
/// builds the network runtime's exports (waits.xo).
fn (var b: Builder) net_waits(fo: Int) -> Bool {
  let m = b.obj_mod(fo)
  m >= 0 && b.c.mods[m].is_std && b.c.declares_net(fo)
}

/// Whether fo is a prelude method the native prelude implements that
/// waits on the event loop (waits.xo WAITS); internal/ssa's nativeWaits.
fn (var b: Builder) native_waits(fo: Int) -> Bool {
  let r = b.c.objs[fo].recv
  let m = b.obj_mod(fo)
  if r < 0 || b.c.objs[fo].flags.is_static() || m < 0 || !b.is_prelude_mod(m) {
    return false
  }
  WAITS.contains("${b.obj_name(r)}.${b.obj_name(fo)}")
}

/// A call of native/llrt/userfs's user(f) (decision 0307): the user
/// field of the Fs f; None when fo is another function.
fn (var b: Builder) fs_user_call(x: Expr, fo: Int) -> Int? {
  if b.obj_name(fo) != "user" || b.c.objs[fo].recv >= 0 {
    return None
  }
  let om = b.obj_mod(fo)
  if om < 0 || b.c.mods[om].path != "native/llrt/userfs" {
    return None
  }
  let (_, _, args) = call_parts(x)
  if args.len() != 1 {
    return None
  }
  let t = b.fs_type()
  let v = b.value_as(args[0].value, t)
  if b.m.types[t].fields.len() < 3 {
    b.unsupported("`fs_user` without the user field of Fs")
    return Some(b.undef(b.nat_of(x)))
  }
  // the Option[UserFs] userfs.user returns, from the list
  let ot = b.nat_of(x)
  let some = b.m.variant_index(ot, "Some")
  let none = b.m.variant_index(ot, "None")
  if b.known_none(v, 2) {
    return Some(b.add(Op.Variant, ot, Aux.I(n: none), []))
  }
  let u = b.add(Op.Field, b.m.types[t].fields[2].ty, Aux.I(n: 2), [v])
  let join = b.new_block()
  let res = b.s.f.add_param(join, ot)
  let (yes, no) = b.branch(b.user_held(u))
  b.s.cur = yes
  b.jump(join, [b.add(Op.Variant, ot, Aux.I(n: some), [b.user_rec(u)])])
  b.s.cur = no
  b.jump(join, [b.add(Op.Variant, ot, Aux.I(n: none), [])])
  b.seal(join)
  b.s.cur = join
  Some(res)
}

/// The key of e in pinned: its file and span.
fn (b: Builder) pin_key(e: Expr) -> Str {
  let sp = parser.expr_span(e)
  "${b.s.file}:${sp.start.offset}:${sp.end.offset}"
}

/// A call of a Proc, Env, or Net method (decision 0307): when the
/// receiver holds a user value, the call goes to its record's method;
/// else the call is lowered as before (the receiver is evaluated once,
/// pinned for that lowering). None when x is not such a call or the
/// native capability has no user field.
fn (var b: Builder) user_cap_call(x: Expr, ci: check.CallInfo) -> Int? {
  if !b.lowering_on("user_cap_call") {
    return None
  }
  let fo = ci.fn_obj
  let r = b.c.objs[fo].recv
  if r < 0 || !b.c.objs[fo].flags.iface() || ci.recv.is_empty() || !b.is_prelude_mod(b.obj_mod(fo)) {
    return None
  }
  let rname = b.obj_name(r)
  if !(rname is "Proc" | "Env" | "Net" | "Stdio" | "Clock" | "Rand") {
    return None
  }
  let recv = ci.recv[0]
  let key = b.pin_key(recv)
  if b.pinned.contains(key) {
    // the lowering of the runtime's own value, inside this dispatch
    return None
  }
  let lt = if rname is "Proc" | "Env" | "Net" { b.lists_type(rname) } else { b.void_cap_type(rname) }
  let ui = b.cap_user_field(lt)
  if ui < 0 {
    return None
  }
  let fname = b.obj_name(fo)
  let ot = b.m.types[lt].fields[ui].ty
  let rect = b.user_rect(ot)
  let j = b.m.field_index(rect, fname)
  // a method the record has no field for (Rand.shuffle, generic): the
  // lowering as for the runtime's own value, which for shuffle is the
  // native prelude's Fisher-Yates over the value's own `int`, as the Go
  // backend's (std.md 3.4), so a user Rand's int is called
  if j < 0 {
    return None
  }
  let (_, _, args) = call_parts(x)
  let nt = b.nat_of(x)
  let v = b.value_as(recv, lt)
  if b.known_none(v, ui) {
    // the runtime's own value: the lowering as before, receiver evaluated
    b.pinned[key] = v
    let rv = b.call_expr(x)
    b.pinned.remove(key)
    return Some(rv)
  }
  let u = b.add(Op.Field, ot, Aux.I(n: ui), [v])
  let join = b.new_block()
  let res = b.s.f.add_param(join, nt)
  let (yes, no) = b.branch(b.user_held(u))
  b.s.cur = yes
  // the user value's method, through its record
  let rec = b.user_rec(u)
  let pts = b.m.types[b.slot_ft(rect, j)].elems
  let es = arg_exprs(b.c.objs[fo].params, args)
  var vals: List[Int] = []
  for i in 0..es.len() {
    if i >= pts.len() {
      b.unsupported("a call of `${b.c.display_name(fo)}` on a user value")
      return Some(b.undef(nt))
    }
    vals.push(b.io_arg(fo, es, i, pts[i]))
  }
  var to_err = -1
  if b.c.objs[fo].err >= 0 {
    let (_, et) = b.result_parts(b.nat_check(x))
    to_err = et
  }
  let ur = b.method_on(fname, b.nat_check(recv), rec, vals, nt, b.fail_err(to_err), Some(x))
  let nx = b.nat_check(x)
  if b.c.is_never(nx) {
    // Proc.exit: the user's method does not return either
    b.add(Op.Unreachable, -1, Aux.None, [])
    b.dead()
  }
  var reach = false
  if !b.is_dead() {
    b.jump(join, [ur])
    reach = true
  }
  // the runtime's own value: the lowering as before, with the receiver
  // already evaluated
  b.s.cur = no
  b.pinned[key] = v
  let rv = b.call_expr(x)
  b.pinned.remove(key)
  if !b.is_dead() {
    b.jump(join, [rv])
    reach = true
  }
  b.seal(join)
  b.s.cur = join
  if !reach {
    b.dead()
    return Some(b.undef(nt))
  }
  Some(res)
}

/// Whether fo is a function generated into a `use c` binding module (the
/// methods of a bound enum, derive.xo valued_enum_methods): it has a body
/// of its own, so it is an ordinary call, not a C extern or a std function.
fn (var b: Builder) derived_in_c(fm: Int, fo: Int) -> Bool {
  fm >= 0 && !b.c.mods[fm].c_prefix.is_empty() && b.c.objs[fo].file.ends_with("#derive")
}

/// UInt64(f): f truncated, in range from 0 up to 2^64 (core 3: faults on
/// NaN or out of range). FloatToInt stops at 2^63, which faulted every
/// value from 2^63 up (9.3e18) on the native and LLVM backends while the
/// Go backend converted it (2026-11-09): at 2^63 or above the value less
/// 2^63 is converted and the top bit set; 2^64 or above (and NaN, in
/// either arm) faults through FloatToInt of f itself.
fn (var b: Builder) float_to_u64(v: Int, to: Int, span: Span) -> Int {
  let vt = b.vty(v)
  let it = b.int_t()
  let bt = b.bool_t()
  let two63 = b.add(Op.Const, vt, Aux.F(f: 9223372036854775808.0), [])
  let big = b.add(Op.Ge, bt, Aux.None, [v, two63])
  let (yes, no) = b.branch(big)
  let join = b.new_block()
  let res = b.s.f.add_param(join, to)
  b.s.cur = yes
  let d = b.add(Op.Sub, vt, Aux.None, [v, two63])
  let over = b.add(Op.Ge, bt, Aux.None, [d, two63])
  let (fits, join2) = b.if_then_begin(over)
  let f = b.add(Op.FloatToInt, it, Aux.None, [v])
  b.set_pos(f, b.pos(span))
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.dead()
  b.if_then_end(fits, join2)
  let lo = b.add(Op.FloatToInt, it, Aux.None, [d])
  b.set_pos(lo, b.pos(span))
  let top = b.add(Op.Xor, it, Aux.None, [lo, b.cint(-9223372036854775807 - 1)])
  b.jump(join, [b.add(Op.IntConv, to, Aux.None, [top])])
  b.s.cur = no
  let r = b.add(Op.FloatToInt, it, Aux.None, [v])
  b.set_pos(r, b.pos(span))
  b.jump(join, [b.int_conv(r, to, span)])
  b.seal(join)
  b.s.cur = join
  res
}


/// Faults unless the float v truncated toward zero fits the sized
/// integer type to (core 3): v > min - 1 and v < max + 1, both exact as
/// Floats for every sized type (2^63 and 2^64 are powers of two). NaN
/// fails the second test under IEEE order and under Xo's (NaN above every
/// number).
fn (var b: Builder) float_range_check(v: Int, to: Int, span: Span) {
  let vt = b.vty(v)
  let bt = b.bool_t()
  let bits = b.m.types[to].bits
  var lo = -1.0
  var hi = 1.0
  var i = 0
  while i < (if b.m.types[to].unsigned { bits } else { bits - 1 }) {
    hi = hi * 2.0
    i += 1
  }
  if !b.m.types[to].unsigned {
    lo = -hi - 1.0
  }
  // a Float32 cannot hold min - 1 of a 32 or 64 bit signed type (it
  // rounds to min): there v >= min, the same test at Float32's spacing
  let above = if b.m.is_f32(vt) && !b.m.types[to].unsigned { b.add(Op.Ge, bt, Aux.None, [v, b.add(Op.Const, vt, Aux.F(f: lo + 1.0), [])]) } else { b.add(Op.Gt, bt, Aux.None, [v, b.add(Op.Const, vt, Aux.F(f: lo), [])]) }
  let below = b.add(Op.Lt, bt, Aux.None, [v, b.add(Op.Const, vt, Aux.F(f: hi), [])])
  let ok = b.add(Op.And, bt, Aux.None, [above, below])
  let (no, join) = b.if_then_begin(b.add(Op.Not, bt, Aux.None, [ok]))
  // the fault prints a Float (a Float32 widened exactly, as Go's float64(f))
  let fv = if b.m.is_f32(vt) { b.rt("f32_round", b.float_t(), [v]) } else { v }
  b.llrt_call("float_conv_fault", [fv, b.cint(bits), b.cint(if b.m.types[to].unsigned { 1 } else { 0 }), b.const_str(b.pos(span))])
  b.add(Op.Unreachable, -1, Aux.None, [])
  b.dead()
  b.if_then_end(no, join)
}
