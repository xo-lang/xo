// The std facts' codec (decision 0388).

test "std facts encode and decode to the same records" {
  let fs = [
    StdFact{name: "strings.trim", body: b"\x01\x02", var_params: [0, 2], borrowed: [true, false], unique: [true], catches: true, faults: false, cancels: false, known: Aux.I(n: -7), inline: b"body"},
    StdFact{name: "prelude.list_len", known: Aux.S(s: "x")},
    StdFact{name: "f", known: Aux.F(f: 2.5)},
    StdFact{name: "g", known: Aux.B(b: true)},
    StdFact{name: "h", known: Aux.Bs(b: b"\x00\xff")},
  ]
  let d = encode_std_facts(fs)
  match decode_std_facts(d) {
    Some(gs) => {
      expect(gs.len()) == fs.len()
      expect(encode_std_facts(gs) == d) == true
      expect(gs[0].var_params) == [0, 2]
      expect(gs[0].faults) == false
      expect(gs[1].faults) == true
    }
    None => expect("decoded") == "None"
  }
}

test "damaged, truncated and other versions of std facts decode to None" {
  let d = encode_std_facts([StdFact{name: "a"}])
  expect(decode_std_facts(d[0..d.len() - 1]).is_none()) == true
  expect(decode_std_facts(d + b"x").is_none()) == true
  expect(decode_std_facts(b"\x10xo std facts v0").is_none()) == true
}

test "a std extern is a body-less shell its facts answer" {
  var m = Module{}
  let fi = m.add_extern(Func{name: "strings.trim"}, StdFact{name: "strings.trim", borrowed: [true, false], faults: false, cancels: true})
  expect(m.is_extern(fi)) == true
  expect(m.funcs[fi].blocks.is_empty()) == true
  expect(m.func_index("strings.trim")) == fi
  let (mf, cs) = m.fault_facts(fi)
  expect(mf) == false
  expect(cs.len()) == 0
  var r = Rc{types: [], ext: m.extern_borrows()}
  r.init_borrows(m.funcs)
  expect(r.borrowed[fi]) == [true, false]
}

test "two std facts sets compare: conventions must match, conservative facts are counted" {
  let want = [StdFact{name: "a", borrowed: [true], faults: false}, StdFact{name: "b", faults: true}, StdFact{name: "c", known: Aux.I(n: 3)}]
  let same = diff_std_facts(want, want)
  expect(same.errors.len()) == 0
  expect(same.common) == 3
  let got = [StdFact{name: "a", borrowed: [true], faults: true}, StdFact{name: "b", faults: false}, StdFact{name: "c"}, StdFact{name: "d"}]
  let d = diff_std_facts(want, got)
  expect(d.errors.len()) == 1
  expect((d.conservative.get("faults") ?? []).len()) == 1
  expect((d.conservative.get("known") ?? []).len()) == 1
  expect(d.only_got) == 1
  let bad = diff_std_facts(want, [StdFact{name: "a", borrowed: [false], faults: false}])
  expect(bad.errors.len()) == 1
}
