// XO0915 for views that take no count (decision 0465's view_proj): an
// rt.str_borrow used after the release of the Str it views is reported, one
// retained first is not.

/// f: s, a view of s (rt.str_borrow), then, in order, the ops of shape
/// ("retain": the view retained, "release": s released, "use": the view's
/// length), each at its own line.
fn view_func(shape: List[Str]) -> Func {
  var m = Module{}
  let fi = m.new_func("f", [], [])
  var f = m.funcs[fi]
  let s = f.add(0, Op.Const, -1, Aux.S(s: "hello"), [])
  let lo = f.add(0, Op.Const, -1, Aux.I(n: 1), [])
  let hi = f.add(0, Op.Const, -1, Aux.I(n: 3), [])
  let v = f.add(0, Op.Call, -1, Aux.S(s: "rt.str_borrow"), [s, lo, hi])
  f.values[v].lp = 2 * 4096 + 1
  for (k, op) in shape.indexed() {
    let x = match op {
      "retain" => f.add(0, Op.Retain, -1, Aux.None, [v])
      "release" => f.add(0, Op.Release, -1, Aux.None, [s])
      _ => f.add(0, Op.Call, -1, Aux.S(s: "Str.len"), [v])
    }
    f.values[x].lp = (3 + k) * 4096 + 1
  }
  m.funcs[fi] = f
  m.funcs[fi]
}

fn codes(f: Func) -> List[Str] {
  var out: List[Str] = []
  for n in freed_addresses(f) {
    out.push("${n.code}:${n.line}")
  }
  out
}

test "XO0915: a borrowed view used after its Str's release" {
  expect(codes(view_func(["release", "use"]))) == ["XO0915:2"]
}

test "XO0915: a borrowed view used before the release, or retained first, is not reported" {
  expect(codes(view_func(["use", "release"]))) == []
  expect(codes(view_func(["retain", "release", "use"]))) == []
}

/// f: s, the result of a call of trim (which returns a view of its
/// parameter 0, decision 0465 step 2), s released, then the result's length.
fn ret_view_func() -> Func {
  var m = Module{}
  let fi = m.new_func("f", [], [])
  var f = m.funcs[fi]
  let s = f.add(0, Op.Const, -1, Aux.S(s: "hello"), [])
  let v = f.add(0, Op.Call, -1, Aux.S(s: "trim"), [s])
  f.values[v].lp = 2 * 4096 + 1
  let r = f.add(0, Op.Release, -1, Aux.None, [s])
  f.values[r].lp = 3 * 4096 + 1
  let u = f.add(0, Op.Call, -1, Aux.S(s: "Str.len"), [v])
  f.values[u].lp = 4 * 4096 + 1
  m.funcs[fi] = f
  m.funcs[fi]
}

test "XO0915: the result of a function that returns a view of its parameter" {
  var out: List[Str] = []
  for n in freed_addresses_rv(ret_view_func(), {"trim": 0}) {
    out.push("${n.code}:${n.line}")
  }
  expect(out) == ["XO0915:2"]
  expect(codes(ret_view_func())) == []
}

/// m: hc(h) -> Int, a word loaded from h's object (tlsio.handle_conn's
/// shape), or, with direct, rt.obj_addr(h) + 16 itself; and f(s): t =
/// hc(s), then, in order, the ops of shape ("release": s released,
/// "use": t passed to g), each at its own line.
fn handle_module(direct: Bool, shape: List[Str]) -> Module {
  var m = Module{}
  let it = m.intern(SType{kind: Kind.Int, name: "Int"})
  let st = m.intern(SType{kind: Kind.Str, name: "Str"})
  let hi = m.new_func("hc", [st], [it])
  let fi = m.new_func("f", [st], [])
  var h = m.funcs[hi]
  let hp = h.blocks[0].params[0]
  let a = h.add(0, Op.Call, it, Aux.S(s: "rt.obj_addr"), [hp])
  let off = h.add(0, Op.Const, it, Aux.I(n: 16), [])
  var r = -1
  if direct {
    r = h.add(0, Op.Add, it, Aux.None, [a, off])
  } else {
    let w = h.add(0, Op.Const, it, Aux.I(n: 8), [])
    r = h.add(0, Op.Call, it, Aux.S(s: "rt.mem_load"), [a, off, w])
  }
  let _rh = h.add(0, Op.Return, -1, Aux.None, [r])
  m.funcs[hi] = h
  var f = m.funcs[fi]
  let s = f.blocks[0].params[0]
  let t = f.add(0, Op.Call, it, Aux.S(s: "hc"), [s])
  f.values[t].lp = 2 * 4096 + 1
  for (k, op) in shape.indexed() {
    let x = match op {
      "release" => f.add(0, Op.Release, -1, Aux.None, [s])
      _ => f.add(0, Op.Call, -1, Aux.S(s: "g"), [t])
    }
    f.values[x].lp = (3 + k) * 4096 + 1
  }
  let _rf = f.add(0, Op.Return, -1, Aux.None, [])
  m.funcs[fi] = f
  m
}

fn handle_codes(m: Module) -> List[Str] {
  var out: List[Str] = []
  for n in freed_addresses_at(m.funcs[m.func_index("f")], {}, addr_returns(m)) {
    out.push("${n.code}:${n.line}")
  }
  out
}

test "XO0915: an address a call read from its handle, used after the handle's release" {
  expect(addr_returns(handle_module(false, []))) == {"hc": 0}
  expect(addr_returns(handle_module(true, []))) == {"hc": 0}
  expect(handle_codes(handle_module(false, ["release", "use"]))) == ["XO0915:2"]
  expect(handle_codes(handle_module(true, ["release", "use"]))) == ["XO0915:2"]
}

test "XO0915: the handle's address used before its release is not reported" {
  expect(handle_codes(handle_module(false, ["use", "release"]))) == []
  // without the summary, a call's Int result is not an address
  expect(codes(handle_module(false, ["release", "use"]).funcs[1])) == []
}

test "XO0915: a function that also counts what it returns is not an address source" {
  // tlsio's keep: rt.obj_addr(a), then rc.inc of it; the address owns a count
  var m = handle_module(true, ["release", "use"])
  let hi = m.func_index("hc")
  var h = m.funcs[hi]
  let ret = h.blocks[0].instrs[h.blocks[0].instrs.len() - 1]
  let a = h.blocks[0].instrs[0]
  var ins = h.blocks[0].instrs[0..h.blocks[0].instrs.len() - 1]
  let inc = h.add(0, Op.Call, -1, Aux.S(s: "rc.inc"), [a])
  ins.push(inc)
  ins.push(ret)
  h.blocks[0].instrs = ins
  m.funcs[hi] = h
  expect(addr_returns(m)) == {}
  expect(handle_codes(m)) == []
}
