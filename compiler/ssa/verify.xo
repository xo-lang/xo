// The verifier (internal/ssa verify.go, verify_rc.go), stage 8 of
// decision 0150: block structure, edges, dominance, operand and result
// types, and after reference counting the balance of ownership on every
// path. `xo ssadump --stage=verify` prints its verdict after rc, and
// `--stage=mutants` its verdicts with one retain or release removed;
// this verifier prints the same.

/// A definition site: its block and position (-1 for a parameter).
struct Site {
  b: Int
  idx: Int
}

fn bname(b: Int) -> Str {
  "b${b}"
}

fn (m: Module) tname(t: Int) -> Str {
  if t < 0 {
    return "<none>"
  }
  m.types[t].name
}

/// The printed instruction (Value.LongString).
fn (m: Module) long_string(f: Func, v: Int) -> Str {
  var b = StrBuilder.new()
  m.write_value(b, f, v)
  b.freeze()
}

/// The structural checks of f (verifyFunc).
fn (var m: Module) verify_func(f: Func) -> List[Str] {
  var errs: List[Str] = []
  let pre = "${f.name}: "
  let nb = f.blocks.len()
  if nb == 0 {
    errs.push("${pre}no blocks")
    return errs
  }
  if !f.blocks[0].preds.is_empty() {
    errs.push("${pre}entry block b0 has predecessors")
  }
  var def: Map[Int, Site] = {}
  for bi in 0..nb {
    let bl = f.blocks[bi]
    for p in bl.params {
      if f.values[p].op != Op.Param || f.values[p].block != bi {
        errs.push("${pre}${bname(bi)}: parameter v${p} is malformed")
      }
      def[p] = Site{b: bi, idx: -1}
    }
    for (i, v) in bl.instrs.indexed() {
      if def.contains(v) {
        errs.push("${pre}${bname(bi)}: value v${v} defined twice")
      }
      def[v] = Site{b: bi, idx: i}
      let p = f.values[v].pad
      if p >= 0 {
        // a landing: the check's call, which a branch on it ends its
        // block with (decision 0085)
        let x = f.values[p]
        let name = aux_name(x.aux)
        let pb = x.block
        var ok = x.op == Op.Call && (name == "rt.landing" || name == "rt.unwinding") && pb >= 0 && pb < nb
        if ok {
          let t = f.term(pb)
          ok = t >= 0 && f.values[t].op == Op.Branch && f.values[t].args[0] == p
        }
        if !ok {
          errs.push("${pre}${bname(bi)}: v${v} lands on v${p}, which is not a check")
        }
      }
      if f.values[v].block != bi {
        errs.push("${pre}${bname(bi)}: v${v} does not belong to its block")
      }
    }
  }
  for bi in 0..nb {
    let bl = f.blocks[bi]
    if f.term(bi) < 0 {
      errs.push("${pre}${bname(bi)}: does not end with a terminator")
    }
    for (i, v) in bl.instrs.indexed() {
      let x = f.values[v]
      if is_terminator(x.op) && i != bl.instrs.len() - 1 {
        errs.push("${pre}${bname(bi)}: terminator v${v} is not last")
      }
      if x.op == Op.Param {
        errs.push("${pre}${bname(bi)}: parameter v${v} in the instruction list")
      }
      for e in x.succs {
        let ed = f.edges[e]
        if ed.from != bi || ed.to < 0 || ed.to >= nb {
          errs.push("${pre}${bname(bi)}: edge to ${bname(ed.to)} is malformed")
          continue
        }
        if !f.blocks[ed.to].preds.contains(e) {
          errs.push("${pre}${bname(bi)}: edge to ${bname(ed.to)} is missing from its predecessors")
        }
        let tps = f.blocks[ed.to].params
        if ed.args.len() != tps.len() {
          errs.push("${pre}${bname(bi)}: edge to ${bname(ed.to)} has ${ed.args.len()} arguments for ${tps.len()} parameters")
          continue
        }
        for (k, a) in ed.args.indexed() {
          let at = if a >= 0 { f.values[a].ty } else { -1 }
          if at != f.values[tps[k]].ty {
            errs.push("${pre}${bname(bi)}: edge to ${bname(ed.to)} passes v${a}: ${m.tname(at)} for v${tps[k]}: ${m.tname(f.values[tps[k]].ty)}")
          }
        }
      }
    }
    for e in bl.preds {
      let fr = f.edges[e].from
      let t = if fr >= 0 { f.term(fr) } else { -1 }
      var found = false
      if t >= 0 {
        found = f.values[t].succs.contains(e)
      }
      if !found {
        errs.push("${pre}${bname(bi)}: predecessor edge from ${bname(fr)} is not a successor edge")
      }
    }
  }
  if !errs.is_empty() {
    return errs
  }
  // dominance
  let idom = dominators(f)
  for bi in 0..nb {
    for (i, v) in f.blocks[bi].instrs.indexed() {
      let x = f.values[v]
      for a in x.args {
        if a < 0 {
          errs.push("${pre}${bname(bi)}: v${v} has a nil operand")
        } else if !usable(idom, def, a, bi, i) {
          errs.push("${pre}${bname(bi)}: v${v} uses v${a}, which does not dominate it")
        }
      }
      for e in x.succs {
        for a in f.edges[e].args {
          if a < 0 {
            errs.push("${pre}${bname(bi)}: edge to ${bname(f.edges[e].to)} has a nil argument")
          } else if !usable(idom, def, a, bi, f.blocks[bi].instrs.len()) {
            errs.push("${pre}${bname(bi)}: edge to ${bname(f.edges[e].to)} passes v${a}, which does not dominate it")
          }
        }
      }
      let msg = m.check_types(f, v)
      if !msg.is_empty() {
        errs.push("${pre}${bname(bi)}: ${m.long_string(f, v)}: ${msg}")
      }
    }
  }
  // binding records name a variable and a value of the function (decision
  // 0252)
  for d in f.dbinds {
    if d.dvar < 0 || d.dvar >= f.dvars.len() || d.value < 0 || d.value >= f.values.len() {
      errs.push("${pre}binding record of variable ${d.dvar} names v${d.value}, out of range")
    }
  }
  errs
}

/// Whether a dominates b (a reachable block).
fn dominates(idom: List[Int], a: Int, b0: Int) -> Bool {
  var b = b0
  while b >= 0 {
    if a == b {
      return true
    }
    if idom[b] == b {
      return false
    }
    b = idom[b]
  }
  false
}

/// Whether value x can be used at position idx of block at (usable).
fn usable(idom: List[Int], def: Map[Int, Site], x: Int, at: Int, idx: Int) -> Bool {
  let d = match def.get(x) {
    Some(s) => s
    None => return false
  }
  if idom[at] < 0 {
    // unreachable code: nothing to check
    return true
  }
  if d.b == at {
    return d.idx < idx
  }
  dominates(idom, d.b, at)
}

/// The immediate dominator of every block reachable from the entry (the
/// entry its own, -1 for the others), by Cooper, Harvey, and Kennedy
/// (dominators).
fn dominators(f: Func) -> List[Int] {
  let n = f.blocks.len()
  var seen: List[Bool] = []
  var idom: List[Int] = []
  var num: List[Int] = []
  for _ in 0..n {
    seen.push(false)
    idom.push(-1)
    num.push(-1)
  }
  var post: List[Int] = []
  dom_walk(f, 0, seen, post)
  var order: List[Int] = []
  var i = post.len() - 1
  while i >= 0 {
    order.push(post[i])
    i -= 1
  }
  for (k, b) in order.indexed() {
    num[b] = k
  }
  idom[0] = 0
  var changed = true
  while changed {
    changed = false
    for k in 1..order.len() {
      let b = order[k]
      var nd = -1
      for e in f.blocks[b].preds {
        let fr = f.edges[e].from
        if fr < 0 || idom[fr] < 0 || !seen[fr] {
          continue
        }
        if nd < 0 {
          nd = fr
        } else {
          nd = intersect(idom, num, fr, nd)
        }
      }
      if nd >= 0 && idom[b] != nd {
        idom[b] = nd
        changed = true
      }
    }
  }
  idom
}

fn dom_walk(f: Func, b: Int, var seen: List[Bool], var post: List[Int]) {
  seen[b] = true
  let t = f.term(b)
  if t >= 0 {
    for e in f.values[t].succs {
      let to = f.edges[e].to
      if !seen[to] {
        dom_walk(f, to, seen, post)
      }
    }
  }
  post.push(b)
}

fn intersect(idom: List[Int], num: List[Int], a0: Int, b0: Int) -> Int {
  var a = a0
  var b = b0
  while a != b {
    while num[a] > num[b] {
      a = idom[a]
    }
    while num[b] > num[a] {
      b = idom[b]
    }
  }
  a
}

/// One instruction's operand and result types (checkTypes); "" when
/// they are right.
fn (var m: Module) check_types(f: Func, v: Int) -> Str {
  let x = f.values[v]
  let n = x.args.len()
  let bt = m.builtin(Kind.Bool)
  var ats: List[Int] = []
  for a in x.args {
    ats.push(if a >= 0 { f.values[a].ty } else { -1 })
  }
  let a0 = if n > 0 { ats[0] } else { -1 }
  let a1 = if n > 1 { ats[1] } else { -1 }
  let nargs = fn(k: Int) -> Str {
    if n != k {
      return "want ${k} operands, have ${n}"
    }
    ""
  }
  let tk = if x.ty >= 0 { m.types[x.ty].kind } else { Kind.Bad }
  let k0 = if a0 >= 0 { m.types[a0].kind } else { Kind.Bad }
  match x.op {
    Const => {
      let want = match x.aux {
        I(..) => Kind.Int
        F(..) => Kind.Float
        B(..) => Kind.Bool
        S(..) | Bs(..) => Kind.Str
        None | P(..) => Kind.Unit
      }
      if x.ty < 0 || tk != want {
        return "constant of the wrong type"
      }
    }
    Add | Sub | Mul | Div | Rem => {
      let s = nargs(2)
      if !s.is_empty() {
        return s
      }
      if a0 != a1 || a0 != x.ty || !(tk is Kind.Int | Kind.Float) {
        return "operands and result must be one numeric type"
      }
    }
    And | Or | Xor | Shl | Shr => {
      let s = nargs(2)
      if !s.is_empty() {
        return s
      }
      if a0 != a1 || a0 != x.ty || !(tk is Kind.Int | Kind.Bool) {
        return "operands and result must be one Int or Bool type"
      }
    }
    Neg | Not => {
      let s = nargs(1)
      if !s.is_empty() {
        return s
      }
      if a0 != x.ty {
        return "operand and result types differ"
      }
    }
    Eq | Ne | Lt | Le | Gt | Ge => {
      let s = nargs(2)
      if !s.is_empty() {
        return s
      }
      if a0 != a1 || x.ty != bt {
        return "comparison of different types, or a result that is not Bool"
      }
    }
    IntToFloat => {
      if n != 1 || k0 != Kind.Int || tk != Kind.Float {
        return "itof takes Int to Float"
      }
    }
    FloatToInt => {
      if n != 1 || k0 != Kind.Float || tk != Kind.Int {
        return "ftoi takes Float to Int"
      }
    }
    IntConv => {
      if n != 1 || k0 != Kind.Int || tk != Kind.Int {
        return "iconv takes an integer to an integer type"
      }
    }
    Struct => {
      if tk != Kind.Struct || n != m.types[x.ty].fields.len() {
        return "struct operands do not match the fields"
      }
      for (i, a) in ats.indexed() {
        if a != m.types[x.ty].fields[i].ty {
          return "field ${m.types[x.ty].fields[i].name} has the wrong type"
        }
      }
    }
    Undef => return "undef in a reachable block"
    Tuple => {
      if tk == Kind.Unit && n == 0 {
        return ""
      }
      if tk != Kind.Tuple || n != m.types[x.ty].elems.len() {
        return "tuple operands do not match the elements"
      }
      for (i, a) in ats.indexed() {
        if a != m.types[x.ty].elems[i] {
          return "element ${i} has the wrong type"
        }
      }
    }
    Variant => {
      let tag = match x.aux {
        I(n: t) => t
        None | F(..) | B(..) | S(..) | Bs(..) | P(..) => -1
      }
      if tag < 0 || tk != Kind.Enum || tag >= m.types[x.ty].variants.len() {
        return "variant of a non enum or a bad tag"
      }
      let fs = m.types[x.ty].variants[tag].fields
      if fs.len() != n {
        return "variant operands do not match its fields"
      }
      for (i, a) in ats.indexed() {
        if a != fs[i].ty {
          return "variant field ${fs[i].name} has the wrong type"
        }
      }
    }
    Field | SetField => {
      let i = match x.aux {
        I(n: t) => t
        None | F(..) | B(..) | S(..) | Bs(..) | P(..) => -1000000
      }
      if i == -1000000 || n == 0 {
        return "field needs an index and an operand"
      }
      var ft = -1
      if k0 == Kind.Struct {
        if i >= 0 && i < m.types[a0].fields.len() {
          ft = m.types[a0].fields[i].ty
        }
      } else if k0 == Kind.Tuple {
        if i >= 0 && i < m.types[a0].elems.len() {
          ft = m.types[a0].elems[i]
        }
      }
      if ft < 0 {
        return "field index out of range or not a struct or tuple"
      }
      if x.op == Op.Field && x.ty != ft {
        return "result type is not the field type"
      }
      if x.op == Op.SetField && (n != 2 || a1 != ft || x.ty != a0) {
        return "setfield operands or result have the wrong type"
      }
    }
    Tag => {
      if n != 1 || k0 != Kind.Enum || tk != Kind.Int {
        return "tag takes an enum to Int"
      }
    }
    Payload => {
      let (tag, fld) = match x.aux {
        P(tag: t, field: fi) => (t, fi)
        None | I(..) | F(..) | B(..) | S(..) | Bs(..) => (-1, -1)
      }
      if tag < 0 || n != 1 || k0 != Kind.Enum || tag >= m.types[a0].variants.len() || fld >= m.types[a0].variants[tag].fields.len() {
        return "payload of a non enum or a bad reference"
      }
      if x.ty != m.types[a0].variants[tag].fields[fld].ty {
        return "result type is not the payload field type"
      }
    }
    Call => {
      let name = aux_name(x.aux)
      let ci = m.func_index(name)
      if ci >= 0 {
        // the callee's parameters, from its body facts when it is not
        // decoded (decision 0283 stage B)
        let pts = m.param_types(ci)
        if pts.len() != n {
          return "call of ${name} with ${n} arguments for ${pts.len()} parameters"
        }
        for (i, a) in ats.indexed() {
          let pt = pts[i]
          if a != pt {
            return "argument ${i} has type ${m.tname(a)}, want ${m.tname(pt)}"
          }
        }
        let rs = m.funcs[ci].results
        let want = if rs.len() > 1 { m.tuple(rs) } else { rs[0] }
        if x.ty != want {
          return "result type does not match the callee"
        }
      } else if !name.contains(".") {
        return "call of an unknown function"
      }
    }
    Closure => {
      let ci = m.func_index(aux_name(x.aux))
      if ci < 0 || !m.funcs[ci].indirect || x.ty < 0 || tk != Kind.Func {
        return "closure of a function that is not Indirect, or not of a function type"
      }
      let g = m.funcs[ci]
      let pts = m.param_types(ci)
      let ft = m.types[x.ty]
      if pts.len() != ft.elems.len() + 1 || pts[0] != x.ty || g.results.len() != 1 || g.results[0] != ft.ret {
        return "closure type does not match its function"
      }
      for i in 1..pts.len() {
        if pts[i] != ft.elems[i - 1] {
          return "closure type does not match its function"
        }
      }
      if n != g.captures.len() {
        return "closure captures do not match its function"
      }
      for (i, a) in ats.indexed() {
        if a != g.captures[i] {
          return "capture ${i} has the wrong type"
        }
      }
    }
    Box => {
      if n != 1 || x.ty < 0 || tk != Kind.Box || m.types[x.ty].elems[0] != a0 {
        return "box takes T to Box[T]"
      }
    }
    Unbox => {
      if n != 1 || k0 != Kind.Box || x.ty != m.types[a0].elems[0] {
        return "unbox takes Box[T] to T"
      }
    }
    Rebind => {
      let ci = m.func_index(aux_name(x.aux))
      if ci < 0 || !m.funcs[ci].indirect || x.ty < 0 || tk != Kind.Func || n != 1 || k0 != Kind.Func {
        return "rebind of a function that is not Indirect, or not of function types"
      }
      let g = m.funcs[ci]
      let pts = m.param_types(ci)
      let ft = m.types[x.ty]
      if pts.len() != ft.elems.len() + 1 || pts[0] != x.ty || g.results.len() != 1 || g.results[0] != ft.ret {
        return "rebind type does not match its function"
      }
    }
    FuncAddr => {
      let fname = aux_name(x.aux)
      if fname.starts_with("&") {
        // rt.sym_addr (decision 0234): a C level symbol by its exact name
        if fname.len() < 2 || n != 0 || x.ty < 0 || tk != Kind.Int {
          return "funcaddr of an empty C symbol, or not an Int"
        }
      } else if fname.starts_with("@") {
        // rt.fn_addr (decision 0233): a C ABI export's symbol
        var found = false
        for f in m.funcs {
          if f.export == fname[1..fname.len()] {
            found = true
          }
        }
        if !found || n != 0 || x.ty < 0 || tk != Kind.Int {
          return "funcaddr of a symbol that no C ABI export has, or not an Int"
        }
      } else {
        let ci = m.func_index(fname)
        if ci < 0 || !m.funcs[ci].entry || n != 0 || x.ty < 0 || tk != Kind.Int {
          return "funcaddr of a function that is not an entry, or not an Int"
        }
      }
    }
    Capture => {
      let i = match x.aux {
        I(n: t) => t
        None | F(..) | B(..) | S(..) | Bs(..) | P(..) => -1000000
      }
      // operand 0 is the function's own closure, or (the xo.eq function
      // of an interface value) another closure whose environment has the
      // same layout
      if i == -1000000 || n != 1 || !f.indirect || (x.args[0] != f.blocks[0].params[0] && k0 != Kind.Func) || i < 0 || i >= f.captures.len() || x.ty != f.captures[i] {
        return "capture must read the environment of its own function"
      }
    }
    CallValue => {
      if n == 0 || k0 != Kind.Func {
        return "callv needs a function value"
      }
      let ft = m.types[a0]
      if n - 1 != ft.elems.len() || x.ty != ft.ret {
        return "callv arguments or result do not match the function type"
      }
      for i in 1..n {
        if ats[i] != ft.elems[i - 1] {
          return "callv argument ${i - 1} has the wrong type"
        }
      }
    }
    Branch => {
      if n != 1 || a0 != bt || x.succs.len() != 2 {
        return "br takes a Bool and two successors"
      }
    }
    Jump => {
      if x.succs.len() != 1 {
        return "jump takes one successor"
      }
    }
    Return => {
      if n != f.results.len() {
        return "ret does not return every result"
      }
      for (i, a) in ats.indexed() {
        if a != f.results[i] {
          return "result ${i} has type ${m.tname(a)}, want ${m.tname(f.results[i])}"
        }
      }
    }
    Fault => {
      if n != 1 || k0 != Kind.Str {
        return "fault takes a Str"
      }
    }
    Retain | Release | Drop | Reuse | Share => {
      if n != 1 || a0 < 0 || !m.heap(a0) {
        return "reference counting of a value that is not on the heap"
      }
    }
    Param | Cap | Unreachable => {}
  }
  ""
}

// ---------------------------------------------------------------------------
// Reference counts (verify_rc.go)

/// The references a function holds per leaf at the start of a block or on
/// an edge (rcState): the leaves held a nonzero number of times, by leaf
/// number (Rc.lid) in increasing order, and their counts. Within a block,
/// and for the changes an edge makes, the verifier counts in Rc.cur
/// instead, a list by leaf number that it reuses, so an instruction
/// changes a count in place; the state is copied out once per edge
/// (Rc.snapshot). (The Go verifier's map per state, ported as an ordered
/// Map keyed by text, recorded a new entry at every count change; a dense
/// list per state, or a sparse one changed instruction by instruction,
/// copied more than it saved: bench/results/selfhost-ssa-2026-10-10.md.)
struct RcState {
  ids: List[Int] = []
  cs: List[Int] = []
}

/// The position of leaf number id in s.ids, or where it would go.
fn (s: RcState) pos(id: Int) -> Int {
  var i = 0
  while i < s.ids.len() && s.ids[i] < id {
    i += 1
  }
  i
}

fn (s: RcState) at(id: Int) -> Int {
  let i = s.pos(id)
  if i < s.ids.len() && s.ids[i] == id { s.cs[i] } else { 0 }
}

fn (var s: RcState) put(id: Int, k: Int) {
  let i = s.pos(id)
  if i < s.ids.len() && s.ids[i] == id {
    if k == 0 {
      s.ids.remove_at(i)
      s.cs.remove_at(i)
    } else {
      s.cs[i] = k
    }
  } else if k != 0 {
    s.ids.insert(i, id)
    s.cs.insert(i, k)
  }
}

fn (s: RcState) equal(t: RcState) -> Bool {
  s.ids == t.ids && s.cs == t.cs
}

/// One leaf an instruction uses, by number, and how (Use).
struct UseId {
  id: Int
  m: Mode
}

/// Starts the leaf numbers of function r.fi, unless they are its already:
/// the numbers, and the leaves and uses by value, stay while the verifier
/// works on the same function, so the mutants of a function share them.
fn (var r: Rc) vstart() {
  if r.vfi != r.fi {
    r.vfi = r.fi
    r.vids = {}
    r.vleaves = []
    r.cur = []
    r.mark = []
    r.touched = []
    r.vleafs = []
    r.vimm = []
    r.vuses = []
    r.vset = []
    r.uset = []
  }
}

/// The number of leaf l in the function being verified.
fn (var r: Rc) lid(l: Leaf) -> Int {
  r.vstart()
  let key = leaf_key(l)
  if let Some(i) = r.vids.get(key) {
    return i
  }
  let i = r.vleaves.len()
  r.vids[key] = i
  r.vleaves.push(l)
  r.cur.push(0)
  r.mark.push(false)
  i
}

/// The numbers of the leaves value v denotes (leaves).
fn (var r: Rc) lids(f: Func, v: Int) -> List[Int] {
  r.vstart()
  if v < r.vset.len() && r.vset[v] {
    return r.vleafs[v]
  }
  r.vgrow(v)
  var ids: List[Int] = []
  for l in r.leaves(f, v) {
    ids.push(r.lid(l))
  }
  r.vleafs[v] = ids
  r.vset[v] = true
  ids
}

/// The leaves instruction v uses, by number (leaf_uses).
fn (var r: Rc) luses(f: Func, v: Int) -> List[UseId] {
  r.vstart()
  if v < r.uset.len() && r.uset[v] {
    return r.vuses[v]
  }
  r.vgrow(v)
  var us: List[UseId] = []
  for u in r.leaf_uses(f, v) {
    us.push(UseId{id: r.lid(u.l), m: u.m})
  }
  r.vuses[v] = us
  r.uset[v] = true
  us
}

/// Grows the by-value lists (lids, luses) to value v: indexed by value,
/// as the maps they were cost a hash per lookup (2026-10-21, verify_rc
/// 7.5 s of a cold self-build).
fn (var r: Rc) vgrow(v: Int) {
  while r.vset.len() <= v {
    r.vset.push(false)
    r.uset.push(false)
    r.vleafs.push([])
    r.vuses.push([])
  }
}

fn (var r: Rc) get(s: RcState, l: Leaf) -> Int {
  s.at(r.lid(l))
}

fn (var r: Rc) set(var s: RcState, l: Leaf, k: Int) {
  s.put(r.lid(l), k)
}

/// Whether verifier leaf number i is immortal (immortal_leaf): its
/// count is never tracked, retains and releases of it being skipped.
fn (var r: Rc) imm_id(f: Func, i: Int) -> Bool {
  while r.vimm.len() <= i {
    r.vimm.push(-1)
  }
  if r.vimm[i] >= 0 {
    return r.vimm[i] == 1
  }
  let b = immortal_leaf(f, r.vleaves[i], r.imm_ret)
  r.vimm[i] = if b { 1 } else { 0 }
  b
}

fn (var r: Rc) cset(i: Int, k: Int) {
  if !r.mark[i] {
    r.mark[i] = true
    r.touched.push(i)
  }
  r.cur[i] = k
}

/// Starts a block in state s.
fn (var r: Rc) load(s: RcState) {
  for (j, i) in s.ids.indexed() {
    r.cset(i, s.cs[j])
  }
}

/// The current state.
fn (var r: Rc) snapshot() -> RcState {
  var ids: List[Int] = []
  for i in r.touched {
    if r.cur[i] != 0 {
      ids.push(i)
    }
  }
  let sorted = ids.sort()
  var out = RcState{ids: sorted}
  for i in sorted {
    out.cs.push(r.cur[i])
  }
  out
}

/// Ends the block being checked: every count back to 0.
fn (var r: Rc) clear() {
  for i in r.touched {
    r.cur[i] = 0
    r.mark[i] = false
  }
  r.touched = []
}

/// The nonzero leaves of s, ordered (sortedLeaves).
fn (r: Rc) held(s: RcState) -> List[Leaf] {
  var out: List[Leaf] = []
  for id in s.ids {
    out.push(r.vleaves[id])
  }
  // stable, by root, then path (an insertion sort here was quadratic)
  out.sort_by(fn(l) { (l.root, l.path) })
}

fn leaf_text(l: Leaf) -> Str {
  "v${l.root}${l.path}"
}

fn (var r: Rc) text(s: RcState) -> Str {
  var parts: List[Str] = []
  for l in r.held(s) {
    parts.push("${leaf_text(l)}:${r.get(s, l)}")
  }
  "{${parts.join(" ")}}"
}

/// Whether block b ends the program (unreachable or a fault).
fn stops(f: Func, b: Int) -> Bool {
  let t = f.term(b)
  t >= 0 && (f.values[t].op is Op.Unreachable | Op.Fault)
}

/// Whether leaf number i is alive in the block being checked (verifyRC's
/// alive).
fn (var r: Rc) alive(f: Func, i: Int) -> Bool {
  let root = r.vleaves[i].root
  match r.kind(f, root) {
    Borrowed => true
    Proj | BProj => {
      if r.cur[i] > 0 {
        return true
      }
      let p = r.parent(f, root)
      r.alive(f, r.lid(p))
    }
    // an immortal value is never counted (rc_ops skips it) and always
    // alive: a constant's list, whose element a read borrows
    Owned => r.cur[i] > 0 || r.imm_id(f, i)
  }
}

/// The balance of ownership of f after reference counting (verifyRC).
fn (var r: Rc) verify_rc(m: Module, f: Func, faults: List[Bool]) -> List[Str] {
  var errs: List[Str] = []
  r.vstart()
  let pre = "${f.name}: "
  let u = r.unique(f)
  let n = f.blocks.len()
  var entry: List[RcState] = []
  var has: List[Bool] = []
  for _ in 0..n {
    entry.push(RcState{})
    has.push(false)
  }
  var st0 = RcState{}
  for p in f.blocks[0].params {
    if r.is_root(f, p) && r.kind(f, p) == RootKind.Owned {
      for l in r.leaves(f, p) {
        r.set(st0, l, 1)
      }
    }
  }
  entry[0] = st0
  has[0] = true
  var seen: List[Bool] = []
  for _ in 0..n {
    seen.push(false)
  }
  var post: List[Int] = []
  dom_walk(f, 0, seen, post)
  var oi = post.len() - 1
  while oi >= 0 {
    let b = post[oi]
    oi -= 1
    let bp = "${pre}${bname(b)}: "
    r.load(entry[b])
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      if x.op == Op.Retain {
        for i in r.lids(f, x.args[0]) {
          if !r.alive(f, i) {
            if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
              errs.push("${bp}retain of ${leaf_text(r.vleaves[i])}, which is not alive")
            }
          }
          if !r.imm_id(f, i) {
            r.cset(i, r.cur[i] + 1)
          }
        }
        continue
      }
      if x.op == Op.Release {
        for i in r.lids(f, x.args[0]) {
          if r.cur[i] < 1 {
            if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
              errs.push("${bp}release of ${leaf_text(r.vleaves[i])}, which is not held")
            }
          }
          if !r.imm_id(f, i) {
            r.cset(i, r.cur[i] - 1)
          }
        }
        continue
      }
      if x.op == Op.Call && is_update_call(aux_name(x.aux)) {
        let a = x.args[0]
        for i in r.lids(f, a) {
          let l = r.vleaves[i]
          if r.cur[i] != 1 {
            errs.push("${bp}v${v} updates ${leaf_text(l)} held ${r.cur[i]} times, want once")
          }
          if f.values[a].op != Op.Reuse && !r.uniq(f, u, l) {
            errs.push("${bp}v${v} updates ${leaf_text(l)}, which is neither a reuse result nor provably unique")
          }
        }
      }
      let us = r.luses(f, v)
      for us1 in us {
        if us1.m == Mode.Borrow && !r.alive(f, us1.id) {
          if !immortal_leaf(f, r.vleaves[us1.id], r.imm_ret) {
            errs.push("${bp}v${v} uses ${leaf_text(r.vleaves[us1.id])}, which is not alive")
          }
        }
      }
      for us1 in us {
        if us1.m != Mode.Consume {
          continue
        }
        if r.cur[us1.id] < 1 {
          if !immortal_leaf(f, r.vleaves[us1.id], r.imm_ret) {
            errs.push("${bp}v${v} consumes ${leaf_text(r.vleaves[us1.id])}, which is not held")
          }
        }
        if !r.imm_id(f, us1.id) {
          r.cset(us1.id, r.cur[us1.id] - 1)
        }
      }
      if x.pad < 0 && !is_terminator(x.op) && raises(m, f, x, faults) {
        // a fault here leaves the function without cleanup (decision
        // 0085): nothing may be held
        let snap = r.snapshot()
        for l in r.held(snap) {
          let c = r.get(snap, l)
          if c > 0 {
            if !immortal_leaf(f, l, r.imm_ret) {
              errs.push("${bp}v${v} can fault while ${leaf_text(l)} is held ${c} times (no landing releases it)")
            }
          }
        }
        if keeps_operands(x) {
          for us1 in us {
            let l = r.vleaves[us1.id]
            if us1.m == Mode.Consume && r.tracked(f, l) && r.kind(f, l.root) == RootKind.Owned {
              if !immortal_leaf(f, l, r.imm_ret) {
                errs.push("${bp}v${v} can fault before it takes ${leaf_text(l)} (no landing releases it)")
              }
            }
          }
        }
      }
      if f.moved.contains(v) {
        // the payload takes its enum's ownership (rc.xo movable)
        for i in r.lids(f, f.values[v].args[0]) {
          if r.cur[i] < 1 {
            if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
              errs.push("${bp}v${v} moves out of ${leaf_text(r.vleaves[i])}, which is not held")
            }
          }
          if !r.imm_id(f, i) {
            r.cset(i, r.cur[i] - 1)
          }
        }
      }
      if r.is_root(f, v) {
        let k = if r.kind(f, v) == RootKind.Owned || f.moved.contains(v) { 1 } else { 0 }
        for i in r.lids(f, v) {
          if r.cur[i] != 0 {
            if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
              errs.push("${bp}${leaf_text(r.vleaves[i])} is still held ${r.cur[i]} times when it is defined again (a leak around a loop)")
            }
          }
          if !r.imm_id(f, i) {
            r.cset(i, k)
          }
        }
      }
      if x.op == Op.Return {
        let snap = r.snapshot()
        for l in r.held(snap) {
          if !immortal_leaf(f, l, r.imm_ret) {
            errs.push("${bp}${leaf_text(l)} is held ${r.get(snap, l)} times at ret (leak or imbalance)")
          }
        }
      }
      if x.op is Op.Jump | Op.Branch {
        let (site, landing) = landing_site(f, b)
        for (si, e) in x.succs.indexed() {
          let to = f.edges[e].to
          var est = RcState{}
          if si == 0 && landing >= 0 && x.op == Op.Branch {
            // the cleanup path of a landing check: the operation checked
            // produced nothing (decision 0085)
            let st = r.snapshot()
            for (j, k) in st.ids.indexed() {
              let l = r.vleaves[k]
              let rv = f.values[l.root]
              if l.root == site || (site < 0 && rv.op == Op.Param && rv.block == b && b != 0) {
                continue
              }
              est.ids.push(k)
              est.cs.push(st.cs[j])
            }
            if site >= 0 && keeps_operands(f.values[site]) {
              // it faulted before taking its operands
              for us1 in r.luses(f, site) {
                let l = r.vleaves[us1.id]
                if us1.m == Mode.Consume && r.tracked(f, l) && r.kind(f, l.root) == RootKind.Owned && !r.imm_id(f, us1.id) {
                  est.put(us1.id, est.at(us1.id) + 1)
                }
              }
            }
            for a in f.edges[e].args {
              for i in r.lids(f, a) {
                if est.at(i) < 1 {
                  if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
                    errs.push("${bp}edge to ${bname(to)} passes ${leaf_text(r.vleaves[i])}, which is not held")
                  }
                }
                if !r.imm_id(f, i) {
                  est.put(i, est.at(i) - 1)
                }
              }
            }
            for p in f.blocks[to].params {
              if r.is_root(f, p) {
                for i in r.lids(f, p) {
                  if est.at(i) != 0 {
                    if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
                      errs.push("${bp}edge to ${bname(to)}: the previous ${leaf_text(r.vleaves[i])} is still held ${est.at(i)} times (a leak around a loop)")
                    }
                  }
                  est.put(i, 1)
                }
              }
            }
          } else {
            // the edge's changes go to the block's counts and back
            var undo: List[Int] = []
            for a in f.edges[e].args {
              for i in r.lids(f, a) {
                if r.cur[i] < 1 {
                  if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
                    errs.push("${bp}edge to ${bname(to)} passes ${leaf_text(r.vleaves[i])}, which is not held")
                  }
                }
                undo.push(i)
                undo.push(r.cur[i])
                if !r.imm_id(f, i) {
                  r.cset(i, r.cur[i] - 1)
                }
              }
            }
            for p in f.blocks[to].params {
              if r.is_root(f, p) {
                for i in r.lids(f, p) {
                  if r.cur[i] != 0 {
                    if !immortal_leaf(f, r.vleaves[i], r.imm_ret) {
                      errs.push("${bp}edge to ${bname(to)}: the previous ${leaf_text(r.vleaves[i])} is still held ${r.cur[i]} times (a leak around a loop)")
                    }
                  }
                  undo.push(i)
                  undo.push(r.cur[i])
                  if !r.imm_id(f, i) {
                    r.cset(i, 1)
                  }
                }
              }
            }
            est = r.snapshot()
            var j = undo.len() - 2
            while j >= 0 {
              r.cur[undo[j]] = undo[j + 1]
              j -= 2
            }
          }
          if has[to] && stops(f, to) {
            // the program stops there: paths need not agree
            var old = entry[to]
            for (j, k) in est.ids.indexed() {
              let c = est.cs[j]
              if c > old.at(k) {
                old.put(k, c)
              }
            }
            entry[to] = old
          } else if has[to] {
            if !entry[to].equal(est) {
              errs.push("${bp}edge to ${bname(to)} holds ${r.text(est)}, another predecessor ${r.text(entry[to])}")
            }
          } else {
            entry[to] = est
            has[to] = true
          }
        }
      }
    }
    r.clear()
  }
  errs
}

/// The verifier's checker over the module after reference counting.
fn rc_checker(m: Module) -> Rc {
  var r = Rc{types: m.types, imm_ret: m.immortal_returns_m(), ext: m.extern_borrows()}
  for (i, f) in m.funcs.indexed() {
    r.fidx[f.name] = i
    r.borrowed.push(f.borrowed)
    let ps = if f.blocks.is_empty() { [] } else { f.blocks[0].params }
    r.fparam0.push(if ps.is_empty() || ps[0] >= f.values.len() { -1 } else { f.values[ps[0]].ty })
  }
  r
}

/// The verdict of stage `verify`: `ok`, or the errors sorted (Verify).
fn (var b: Builder) verify_text() -> Str {
  var errs: List[Str] = []
  for f in b.m.funcs {
    for e in b.m.verify_func(f) {
      errs.push(e)
    }
  }
  if errs.is_empty() {
    let faults = b.m.may_fault()
    var r = rc_checker(b.m)
    for (fi, f) in b.m.funcs.indexed() {
      r.fi = fi
      for e in r.verify_rc(b.m, f, faults) {
        errs.push(e)
      }
    }
  }
  if errs.is_empty() {
    return "ok\n"
  }
  "${errs.sort().join("\n")}\n"
}

/// The verdicts with one retain or release removed: the first n of each
/// function (VerifyMutants).
fn (var b: Builder) verify_mutants(n: Int) -> Str {
  var out = StrBuilder.new()
  let faults = b.m.may_fault()
  var r = rc_checker(b.m)
  for fi in 0..b.m.funcs.len() {
    r.fi = fi
    var k = 0
    var f = b.m.funcs[fi]
    for bi in 0..f.blocks.len() {
      var i = 0
      while i < f.blocks[bi].instrs.len() && k < n {
        let v = f.blocks[bi].instrs[i]
        if !(f.values[v].op is Op.Retain | Op.Release) {
          i += 1
          continue
        }
        k += 1
        let orig = f.blocks[bi].instrs
        f.blocks[bi].instrs = remove_at(orig, i)
        var errs = b.m.verify_func(f)
        if errs.is_empty() {
          errs = r.verify_rc(b.m, f, faults)
        }
        f.blocks[bi].instrs = orig
        out.write("${f.name} ${bname(bi)} ${i}: ")
        if errs.is_empty() {
          out.write("ok\n")
        } else {
          out.write("${errs.sort().join("; ")}\n")
        }
        i += 1
      }
    }
  }
  out.freeze()
}

/// The verifier's errors on the module after reference counting, in
/// function order (Module.Verify): the structural checks of every
/// function, then, when they pass, the ownership balance (compiler/arm64
/// verifies the module again after inlining, decision 0158).
/// verify_all on up to jobs tasks, by runs of functions: the same errors
/// in the same order. Each task checks against its own copy of the
/// module, which the checks may intern types into.
pub fn (var m: Module) verify_all_jobs(jobs: Int) -> List[Str] {
  m.verify_jobs_skip(jobs, [])
}

/// verify_all_jobs without the functions skip marks (the driver's: they
/// verified before under the same verify_keys); skip empty for none.
pub fn (var m: Module) verify_jobs_skip(jobs: Int, skip: List[Bool]) -> List[Str] {
  let n = m.funcs.len()
  let nc = (n / 64).min(64)
  if (jobs <= 1 || nc <= 1) && skip.is_empty() {
    return m.verify_all()
  }
  if !skip.is_empty() && !skip.contains(false) {
    // every function verified before
    return []
  }
  if jobs <= 1 || nc <= 1 {
    var errs: List[Str] = []
    for (fi, f) in m.funcs.indexed() {
      if !skip[fi] {
        errs = errs + m.verify_func(f)
      }
    }
    if !errs.is_empty() {
      return errs
    }
    let faults = m.may_fault()
    var r = rc_checker(m)
    for (fi, f) in m.funcs.indexed() {
      if !skip[fi] {
        r.fi = fi
        errs = errs + r.verify_rc(m, f, faults)
      }
    }
    return errs
  }
  var bounds: List[Int] = []
  for k in 0..nc + 1 {
    bounds.push(n * k / nc)
  }
  let base = m
  let starts = bounds
  // the structural checks, then (when they pass) the reference counts
  for pass in 0..2 {
    let faults = if pass == 1 { base.may_fault() } else { [] }
    // the checker's whole-program facts once, copied by each task
    let r0 = if pass == 1 { rc_checker(base) } else { Rc{types: []} }
    let next = Atomic[Int].new(0)
    let done = scope s {
      var ts = []
      for _ in 0..jobs.min(nc) {
        ts.push(s.spawn(fn() -> List[(Int, List[Str])] {
          var mine: List[(Int, List[Str])] = []
          var mm = base
          var r = r0
          while true {
            let k = next.add(1) - 1
            if k >= nc {
              break
            }
            var errs: List[Str] = []
            for fi in starts[k]..starts[k + 1] {
              if !skip.is_empty() && skip[fi] {
                continue
              }
              let f = base.funcs[fi]
              if pass == 0 {
                errs = errs + mm.verify_func(f)
              } else {
                r.fi = fi
                errs = errs + r.verify_rc(base, f, faults)
              }
            }
            mine.push((k, errs))
          }
          mine
        }))
      }
      var all: List[(Int, List[Str])] = []
      for t in ts {
        all = all + t.await
      }
      all
    }
    var by_chunk: List[List[Str]] = []
    for _ in 0..nc {
      by_chunk.push([])
    }
    for (k, errs) in done {
      by_chunk[k] = errs
    }
    var errs: List[Str] = []
    for e in by_chunk {
      errs = errs + e
    }
    if !errs.is_empty() {
      return errs
    }
  }
  []
}

/// Decision 0342: the calls, closures, and field and payload accesses of
/// every decoded function checked against this module's definitions
/// (check_types), before code generation. A function whose body a cache
/// kept (the front end's, decision 0220) assumes the types it was built
/// with; when this build defines a name it calls with other types, as
/// an order dependent helper name did (gotchas/
/// helper-name-creation-order.md), the build must stop, not emit the
/// call. The first mismatch of each function, "NAME: bN: vM ...: why".
pub fn (var m: Module) check_assumptions() -> List[Str] {
  var errs: List[Str] = []
  for f in m.funcs {
    var bad = false
    for (bi, bl) in f.blocks.indexed() {
      for v in bl.instrs {
        let op = f.values[v].op
        if op == Op.Call || op == Op.Closure || op == Op.Field || op == Op.SetField || op == Op.Payload {
          // a callee with neither a body nor body facts yet (a runtime
          // function the build adds later) has no signature to check
          if (op == Op.Call || op == Op.Closure) && !m.signature_known(aux_name(f.values[v].aux)) {
            continue
          }
          let msg = m.check_types(f, v)
          if !msg.is_empty() {
            errs.push("${f.name}: ${bname(bi)}: ${m.long_string(f, v)}: ${msg}")
            bad = true
            break
          }
        }
      }
      if bad {
        break
      }
    }
  }
  errs
}

/// Whether the function named n is in m with a signature: a body, or
/// body facts (decision 0283 stage B); false for a name m does not have.
fn (m: Module) signature_known(n: Str) -> Bool {
  let ci = m.func_index(n)
  ci >= 0 && (!m.funcs[ci].blocks.is_empty() || m.facts.contains(ci))
}

/// XO_ASSUME_BREAK=1's damage, for check_assumptions' test: the first
/// call of a known function gets another result type, as a stale cached
/// caller would have it; whether one was found.
pub fn (var m: Module) break_a_call() -> Bool {
  let bt = m.builtin(Kind.Bool)
  let it = m.builtin(Kind.Int)
  for fi in 0..m.funcs.len() {
    for b in m.funcs[fi].blocks {
      for v in b.instrs {
        let x = m.funcs[fi].values[v]
        if x.op == Op.Call && x.ty >= 0 && m.signature_known(aux_name(x.aux)) {
          m.funcs[fi].values[v].ty = if x.ty == bt { it } else { bt }
          return true
        }
      }
    }
  }
  false
}

pub fn (var m: Module) verify_all() -> List[Str] {
  var errs: List[Str] = []
  for f in m.funcs {
    for e in m.verify_func(f) {
      errs.push(e)
    }
  }
  if errs.is_empty() {
    let faults = m.may_fault()
    var r = rc_checker(m)
    for (fi, f) in m.funcs.indexed() {
      r.fi = fi
      for e in r.verify_rc(m, f, faults) {
        errs.push(e)
      }
    }
  }
  errs
}
