// The facts std exports per function (decision 0388): what a program's
// passes read of a std callee whose body they do not have once std is
// compiled apart (stage 3). This is the record's SSA section; the
// emitter's section (by_ref, kept results, entry, export) is written by
// std's object builder after it. A function with no record, or a fact it
// lacks, gets the conservative answer: not borrowed, not unique, may
// fault and be canceled, no bounds, not inlined.

/// The version of the facts' encoding.
pub const STD_FACTS_VERSION = "xo std facts v1"

/// One std function's facts, by its name.
pub struct StdFact {
  pub name: Str
  /// body_facts, encoded (encode_facts); empty for none
  pub body: Bytes = b""
  pub var_params: List[Int] = []
  /// its parameters' borrowed flags and the results it hands back unique
  /// (decision 0322), from the borrow inference; empty for none
  pub borrowed: List[Bool] = []
  pub unique: List[Bool] = []
  pub catches: Bool = false
  /// may fault, may be canceled (prune_unwind)
  pub faults: Bool = true
  pub cancels: Bool = true
  /// its constant result (fold_known_calls), Aux.None for none
  pub known: Aux = Aux.None
  /// its body for the inliner (encode_func), empty for none
  pub inline: Bytes = b""
}

/// The facts of every function of m, after the passes a program's build
/// runs before the emit: plan is the borrow inference's, and b kept the
/// unwind facts by name (keep_unwind_names).
pub fn std_facts(m: Module, b: Builder, plan: RcPlan) -> List[StdFact] {
  var out: List[StdFact] = []
  for (fi, f) in m.funcs.indexed() {
    var x = StdFact{name: f.name, var_params: f.var_params, catches: f.catches}
    if !f.blocks.is_empty() {
      x.body = encode_facts(m, body_facts(f, m.types)) ?? b""
      x.known = known_result(f) ?? Aux.None
    } else if let Some(bf) = m.facts.get(fi) {
      // an undecoded cache hit (decision 0283 B): its body's facts
      x.body = encode_facts(m, bf) ?? b""
    }
    let ci = plan.r.fidx.get(f.name) ?? -1
    if ci >= 0 && ci < plan.r.borrowed.len() {
      x.borrowed = plan.r.borrowed[ci]
    }
    if ci >= 0 && ci < plan.r.uq.len() {
      x.unique = plan.r.uq[ci]
    }
    if let Some((fa, ca)) = b.unwind_names.get(f.name) {
      x.faults = fa
      x.cancels = ca
    }
    out.push(x)
  }
  out
}

struct SfW {
  b: BytesBuilder
}

fn (var w: SfW) uv(v0: Int) {
  var v = v0
  while v >= 128 {
    w.b.write_byte(UInt8((v & 127) | 128))
    v = v >> 7
  }
  w.b.write_byte(UInt8(v))
}

fn (var w: SfW) sv(v: Int) {
  w.uv(if v < 0 { ((-v) << 1) - 1 } else { v << 1 })
}

fn (var w: SfW) bytes(d: Bytes) {
  w.uv(d.len())
  w.b.write(d)
}

fn (var w: SfW) bools(xs: List[Bool]) {
  w.uv(xs.len())
  for x in xs {
    w.uv(if x { 1 } else { 0 })
  }
}

struct SfR {
  d: Bytes
  at: Int = 0
  ok: Bool = true
}

fn (var r: SfR) uv() -> Int {
  var v = 0
  var sh = 0
  while true {
    if r.at >= r.d.len() || sh > 63 {
      r.ok = false
      return 0
    }
    let c = Int(r.d[r.at])
    r.at += 1
    v = v | ((c & 127) << sh)
    if c < 128 {
      break
    }
    sh += 7
  }
  v
}

fn (var r: SfR) sv() -> Int {
  let u = r.uv()
  if (u & 1) == 1 { -((u + 1) >> 1) } else { u >> 1 }
}

fn (var r: SfR) bytes() -> Bytes {
  let n = r.uv()
  if !r.ok || n > r.d.len() - r.at {
    r.ok = false
    return b""
  }
  let out = r.d[r.at..r.at + n]
  r.at += n
  out
}

fn (var r: SfR) bools() -> List[Bool] {
  let n = r.uv()
  if !r.ok || n > r.d.len() {
    r.ok = false
    return []
  }
  var out = List[Bool].with_capacity(n)
  for _ in 0..n {
    out.push(r.uv() == 1)
  }
  out
}

/// The facts as bytes: the version, then each function's record.
pub fn encode_std_facts(fs: List[StdFact]) -> Bytes {
  var w = SfW{b: BytesBuilder.new()}
  w.bytes(STD_FACTS_VERSION.bytes())
  w.uv(fs.len())
  for x in fs {
    w.bytes(x.name.bytes())
    w.bytes(x.body)
    w.uv(x.var_params.len())
    for p in x.var_params {
      w.uv(p)
    }
    w.bools(x.borrowed)
    w.bools(x.unique)
    w.bools([x.catches, x.faults, x.cancels])
    match x.known {
      I(n) => {
        w.uv(1)
        w.sv(n)
      }
      B(v) => {
        w.uv(2)
        w.uv(if v { 1 } else { 0 })
      }
      S(s) => {
        w.uv(3)
        w.bytes(s.bytes())
      }
      F(v) => {
        // the bits as two halves: all 64 do not fit a zigzag varint
        let bits = v.to_bits()
        w.uv(4)
        w.sv(bits >> 32)
        w.uv(bits & 0xffffffff)
      }
      Bs(v) => {
        w.uv(5)
        w.bytes(v)
      }
      None => w.uv(0)
      P(tag: _, field: _) => w.uv(0)
    }
    w.bytes(x.inline)
  }
  w.b.freeze()
}

/// The facts of d, or None when d is not facts of this version or is
/// damaged (a miss: every callee then gets the conservative answer).
pub fn decode_std_facts(d: Bytes) -> Option[List[StdFact]] {
  var r = SfR{d: d}
  if r.bytes() != STD_FACTS_VERSION.bytes() || !r.ok {
    return None
  }
  let n = r.uv()
  if !r.ok || n > d.len() {
    return None
  }
  var out: List[StdFact] = []
  for _ in 0..n {
    if !r.ok {
      return None
    }
    var x = StdFact{name: r.bytes().to_str() ?? ""}
    x.body = r.bytes()
    let np = r.uv()
    if !r.ok || np > d.len() {
      return None
    }
    for _ in 0..np {
      x.var_params.push(r.uv())
    }
    x.borrowed = r.bools()
    x.unique = r.bools()
    let fl = r.bools()
    if fl.len() != 3 {
      return None
    }
    x.catches = fl[0]
    x.faults = fl[1]
    x.cancels = fl[2]
    x.known = match r.uv() {
      1 => Aux.I(n: r.sv())
      2 => Aux.B(b: r.uv() == 1)
      3 => Aux.S(s: r.bytes().to_str() ?? "")
      4 => {
        let hi = r.sv()
        Aux.F(f: Float.from_bits((hi << 32) | r.uv()))
      }
      5 => Aux.Bs(b: r.bytes())
      _ => Aux.None
    }
    x.inline = r.bytes()
    out.push(x)
  }
  if !r.ok || r.at != d.len() {
    return None
  }
  Some(out)
}

/// Whether function fi of m is a std extern (decision 0388 stage 3).
pub fn (m: Module) is_extern(fi: Int) -> Bool {
  fi >= 0 && fi < m.funcs.len() && m.externs.contains(m.funcs[fi].name)
}

/// Adds f, std's function by its name and signature with no blocks, as
/// an extern answered by x: its body facts are x's (its own faults, and
/// no callees: those are inside std). Its index.
pub fn (var m: Module) add_extern(f: Func, x: StdFact) -> Int {
  let fi = m.funcs.len()
  m.funcs.push(f)
  m.func_at[f.name] = fi
  var bf = decode_facts(m, x.body) ?? BodyFacts{}
  bf.faults = x.faults
  bf.names = []
  m.facts[fi] = bf
  m.externs[f.name] = x
  fi
}

/// Each extern's borrowed flags (exact: the calling convention std's
/// object was built with) and its first parameter's type, -1 for none,
/// by name, for the borrow inference (Rc.init_borrows).
pub fn (m: Module) extern_borrows() -> Map[Str, (List[Bool], Int)] {
  var out: Map[Str, (List[Bool], Int)] = {}
  for (fi, f) in m.funcs.indexed() {
    if let Some(x) = m.externs.get(f.name) {
      let p0 = match m.facts.get(fi) {
        Some(bf) => if bf.params.is_empty() { -1 } else { bf.params[0] }
        None => -1
      }
      out[f.name] = (x.borrowed, p0)
    }
  }
  out
}

/// Whether a function of file (Func.file) is std's own: under std's
/// directory, the checker's spelling of it (a program file is relative
/// to the program's root). A generic instance (a name with `[`) is the
/// program's, compiled where it is used (decision 0388).
pub fn std_func(name: Str, file: Str) -> Bool {
  !name.contains("[") && (file.starts_with("std/") || file.contains("/std/"))
}

/// The facts of m's std functions only (std_func), for XO_STD_FACTS_DUMP:
/// a whole-program build's, the stand-in for and the expected output of
/// std's object builder's stdf.
pub fn std_facts_of_std(m: Module, b: Builder, plan: RcPlan) -> List[StdFact] {
  var out: List[StdFact] = []
  for x in std_facts(m, b, plan) {
    let fi = m.func_index(x.name)
    if fi >= 0 && std_func(x.name, m.funcs[fi].file) {
      out.push(x)
    }
  }
  out
}

/// How one set of std facts (got: std's object builder's) compares with
/// another (want: a whole-program build's, XO_STD_FACTS_DUMP) for the
/// functions both name: errors are differences got may not have (the
/// calling convention: borrowed, var parameters, catches; or a fact less
/// conservative than want's); conservative counts, per kind, the
/// functions where got is safely more conservative, a lost optimization
/// (decision 0388 1c's runtime estimate), with their names.
pub struct FactsDiff {
  pub common: Int = 0
  pub only_want: Int = 0
  pub only_got: Int = 0
  pub errors: List[Str] = []
  pub conservative: Map[Str, List[Str]] = {}
  /// the body facts' bytes differ (compared as bytes: a kind of their own)
  pub body: List[Str] = []
}

fn note_cons(var d: FactsDiff, kind: Str, name: Str) {
  var xs = d.conservative.get(kind) ?? []
  xs.push(name)
  d.conservative[kind] = xs
}

/// The comparison (FactsDiff) of got against want.
pub fn diff_std_facts(want: List[StdFact], got: List[StdFact]) -> FactsDiff {
  var d = FactsDiff{}
  var by: Map[Str, StdFact] = {}
  for x in got {
    by[x.name] = x
  }
  var seen: Map[Str, Bool] = {}
  for w in want {
    seen[w.name] = true
    let g = match by.get(w.name) {
      Some(x) => x
      None => {
        d.only_want += 1
        continue
      }
    }
    d.common += 1
    let n = w.name
    if g.borrowed != w.borrowed {
      d.errors.push("${n}: borrowed ${bools_str(g.borrowed)}, want ${bools_str(w.borrowed)} (the calling convention)")
    }
    if g.var_params != w.var_params {
      d.errors.push("${n}: var parameters differ")
    }
    if g.catches != w.catches {
      d.errors.push("${n}: catches ${g.catches}, want ${w.catches}")
    }
    if g.faults != w.faults {
      if g.faults { note_cons(d, "faults", n) } else { d.errors.push("${n}: does not fault, but the whole program's may") }
    }
    if g.cancels != w.cancels {
      if g.cancels { note_cons(d, "cancels", n) } else { d.errors.push("${n}: is not canceled, but the whole program's may be") }
    }
    for (i, u) in g.unique.indexed() {
      let wu = i < w.unique.len() && w.unique[i]
      if u && !wu {
        d.errors.push("${n}: result ${i} unique, the whole program's not")
      } else if !u && wu {
        note_cons(d, "unique", n)
      }
    }
    if w.unique.len() > g.unique.len() && w.unique[g.unique.len()..].any(fn(v) { v }) {
      note_cons(d, "unique", n)
    }
    match w.known {
      None => {
        if g.known != Aux.None {
          d.errors.push("${n}: a known result the whole program's lacks")
        }
      }
      I(..) | F(..) | B(..) | S(..) | Bs(..) | P(..) => {
        if g.known == Aux.None {
          note_cons(d, "known", n)
        } else if g.known != w.known {
          d.errors.push("${n}: a different known result")
        }
      }
    }
    if g.body != w.body {
      d.body.push(n)
    }
  }
  for x in got {
    if !seen.contains(x.name) {
      d.only_got += 1
    }
  }
  d
}

fn bools_str(xs: List[Bool]) -> Str {
  var s = ""
  for x in xs {
    s = s + (if x { "1" } else { "0" })
  }
  s
}
