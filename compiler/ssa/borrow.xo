// Borrowed projections (internal/ssa rcborrow.go, decision 0186): a
// projection out of a tracked container whose owner nothing consumes
// while the projection is alive is never retained or released; its uses
// borrow its owner instead. See rcborrow.go for the rules.

/// An instruction: its block and index.
struct BSite {
  b: Int
  i: Int
}

/// The per function state of borrowProjections: the index of each value
/// in its block, the instructions using each root, those consuming an
/// operand based on each root (edges at the terminator), every use of
/// each root (terminators and edges included), the roots a
/// terminator uses, the candidates, and those decided.
struct Borrows {
  pos: List[Int] = []
  /// by value: lists where maps keyed by value made a lookup, a removal,
  /// and an insertion per site (bench/results/xo1-speed-2026-10-13.md)
  users: List[List[BSite]] = []
  all: List[List[BSite]] = []
  /// the path of the leaf each site of all uses (the path of the value
  /// an edge passes): used_after asks about one leaf of its root
  all_p: List[List[Str]] = []
  cons: List[List[BSite]] = []
  in_term: List[Bool] = []
  cand: List[Bool] = []
  done: List[Bool] = []
}

fn add_site(var m: List[List[BSite]], root: Int, s: BSite) {
  m[root].push(s)
}

/// Decides the borrowed projections of f into r.bproj
/// (borrowProjections).
fn (var r: Rc) borrow_projections(f: Func) {
  r.bproj = {}
  r.bchain = {}
  var st = Borrows{}
  for _ in 0..f.values.len() {
    st.pos.push(0)
    st.cand.push(false)
    st.done.push(false)
    st.users.push([])
    st.all.push([])
    st.all_p.push([])
    st.cons.push([])
    st.in_term.push(false)
  }
  var cands: List[Int] = []
  for bl in 0..f.blocks.len() {
    for (i, v) in f.blocks[bl].instrs.indexed() {
      st.pos[v] = i
      let x = f.values[v]
      if r.is_root(f, v) && !x.args.is_empty() && r.kind(f, v) == RootKind.Proj {
        st.cand[v] = true
        cands.push(v)
      }
      for (k, m) in r.modes(f, v).indexed() {
        if m == Mode.Consume {
          add_site(st.cons, r.base(f, x.args[k]).root, BSite{b: bl, i: i})
        }
      }
      for e in x.succs() {
        for a in f.edges[e].args {
          let root = r.base(f, a).root
          add_site(st.all, root, BSite{b: bl, i: i})
          st.all_p[root].push(r.base(f, a).path)
          // an argument of no heap type (an Int field read of a struct
          // passed to a join) moves nothing: it neither consumes its root
          // nor ends a projection of it (decision 0487: `x = if c { b.f }
          // else { ... }` after a write of b ended a borrow of b.segs)
          if r.heap(ty_of(f.values[a].tb)) {
            add_site(st.cons, root, BSite{b: bl, i: i})
            st.in_term[root] = true
          }
        }
      }
      if is_terminator(x.op) {
        for u in r.leaf_uses(f, v) {
          add_site(st.all, u.l.root, BSite{b: bl, i: i})
          st.all_p[u.l.root].push(u.l.path)
          st.in_term[u.l.root] = true
        }
        continue
      }
      for u in r.leaf_uses(f, v) {
        add_site(st.users, u.l.root, BSite{b: bl, i: i})
        add_site(st.all, u.l.root, BSite{b: bl, i: i})
        st.all_p[u.l.root].push(u.l.path)
      }
    }
  }
  r.bpos = st.pos
  r.bidom = []
  for v in cands {
    r.decide_borrow(f, st, v)
  }
}

/// Whether projection v is borrowed, and its owner (borrowProjections'
/// decide).
fn (var r: Rc) decide_borrow(f: Func, var st: Borrows, v: Int) {
  if st.done[v] {
    return
  }
  st.done[v] = true
  let p = r.parent(f, v)
  if st.cand[p.root] {
    r.decide_borrow(f, st, p.root)
  }
  var owner = p
  if let Some(o) = r.bproj.get(p.root) {
    owner = o
  }
  if st.in_term[v] || !r.tracked(f, owner) {
    return
  }
  // the blocks v is live into and out of, and its last use in each
  let db = block_of(f.values[v].tb)
  let di = st.pos[v]
  var live_in: Map[Int, Bool] = {}
  var live_out: Map[Int, Bool] = {}
  var last: Map[Int, Int] = {}
  var work: List[Int] = []
  for s in st.users[v] {
    if s.i > (last.get(s.b) ?? -1) {
      last[s.b] = s.i
    }
    if s.b != db && !live_in.contains(s.b) {
      live_in[s.b] = true
      work.push(s.b)
    }
  }
  while !work.is_empty() {
    let b = work.pop() ?? 0
    for e in f.blocks[b].preds {
      let pb = f.edges[e].from
      live_out[pb] = true
      if pb != db && !live_in.contains(pb) {
        live_in[pb] = true
        work.push(pb)
      }
    }
  }
  // the owner's roots: its own, then each setfield of another field of
  // one of them, which carries the owner's leaf on (`b.pos = ...` on a
  // `var` struct while a projection of b.segs is alive); a consume of one
  // of them inside v's life other than such a setfield keeps v counted
  var roots = [owner.root]
  var chain: List[Int] = []
  // a projection of a borrowed one inherits its owner's chain: made after
  // a setfield of the chain, its owner's leaf lives in that setfield's
  // value, not in the consumed root
  if let Some(pc) = r.bchain.get(p.root) {
    for w in pc {
      roots.push(w)
      chain.push(w)
    }
  }
  var k = 0
  while k < roots.len() {
    for s in st.cons[roots[k]] {
      var inside = false
      if s.b == db {
        inside = s.i > di && (live_out.contains(db) || s.i <= (last.get(db) ?? -1))
      } else if live_in.contains(s.b) {
        inside = live_out.contains(s.b) || s.i <= (last.get(s.b) ?? -1)
      }
      if !inside {
        continue
      }
      let w = f.blocks[s.b].instrs[s.i]
      if r.carries(f, w, roots[k], owner.path) {
        if !chain.contains(w) {
          roots.push(w)
          chain.push(w)
        }
        continue
      }
      return
    }
    k += 1
  }
  if !chain.is_empty() && !r.chain_dominates(f, st, v, chain) {
    return
  }
  // a projection consumed where its owner would be dead stays counted:
  // the owner dying first left it unique, while borrowing would keep the
  // owner alive and the value shared at the consume
  for s in st.cons[v] {
    // the owner's leaf lives on in the chain's setfields (decision 0487):
    // a use of one of them after s is a use of the owner
    var after = used_after(f, st, owner, s)
    for w in chain {
      if !after && used_after(f, st, r.leaf(w, owner.path), s) {
        after = true
      }
    }
    if !after {
      return
    }
  }
  r.bproj[v] = owner
  if !chain.is_empty() {
    r.bchain[v] = chain
  }
}

/// Whether instruction w is a setfield of root's own value (no path) of a
/// field that is not path and holds no part of it: w's value then holds
/// the leaf at path that root held (owner_chain).
fn (r: Rc) carries(f: Func, w: Int, root: Int, path: Str) -> Bool {
  let x = f.values[w]
  if x.op != Op.SetField || x.args[0] != root || path.is_empty() {
    return false
  }
  !paths_overlap(".${auxw_int(x.aux)}", path)
}

/// Whether every use of projection v that a setfield of chain reaches
/// (without passing v's own block, where v is made anew) comes after it
/// in its block or in a block it dominates, so owner_use names a value
/// that holds the owner at every use.
fn (var r: Rc) chain_dominates(f: Func, st: Borrows, v: Int, chain: List[Int]) -> Bool {
  if r.bidom.is_empty() {
    r.bidom = dominators(f)
  }
  let db = block_of(f.values[v].tb)
  for w in chain {
    let wb = block_of(f.values[w].tb)
    let wi = st.pos[w]
    // the blocks reachable from w's block (not through db)
    var seen: Map[Int, Bool] = {}
    var work: List[Int] = [wb]
    while !work.is_empty() {
      let b = work.pop() ?? 0
      for e in f.values[f.term(b)].succs() {
        let to = f.edges[e].to
        if seen.contains(to) || to == db {
          continue
        }
        seen[to] = true
        work.push(to)
      }
    }
    for s in st.users[v] {
      if s.b == wb && s.i < wi && !seen.contains(wb) {
        continue
      }
      if s.b == wb || seen.contains(s.b) {
        if !(s.b == wb && s.i > wi) && !(s.b != wb && dominates(r.bidom, wb, s.b)) {
          return false
        }
      }
    }
  }
  true
}

/// Whether leaf o is used after instruction s on some path, by its root's
/// uses of o or of a leaf that holds it or that it holds
/// (borrowProjections' usedAfter). Another field's use does not count:
/// Mutex.with's packed path takes the list out of list.pop's tuple
/// (field 1) and pushes onto its field 0 after the call, and counting
/// that use borrowed the list, so the call's first push copied it.
fn used_after(f: Func, st: Borrows, o: Leaf, s: BSite) -> Bool {
  let root = o.root
  var used: Map[Int, Bool] = {}
  for (k, u) in st.all[root].indexed() {
    if !paths_overlap(st.all_p[root][k], o.path) {
      continue
    }
    if u.b == s.b && u.i > s.i {
      return true
    }
    used[u.b] = true
  }
  var seen: Map[Int, Bool] = {}
  var work: List[Int] = [s.b]
  // a path that reaches root's own block makes it anew there: a use past
  // it (around a loop) is of the next value, not this one (2026-10-18:
  // an Option matched in a loop stayed a borrowed projection, and its
  // payload was shared at the move and dropped with it); s's own block
  // too when it is root's: root is made before s there, so a use before
  // s on the way back is the next value's (Mutex.with's loop of pushes)
  let home = block_of(f.values[root].tb)
  while !work.is_empty() {
    let b = work.pop() ?? 0
    for e in f.values[f.term(b)].succs() {
      let to = f.edges[e].to
      if seen.contains(to) || to == home {
        continue
      }
      if used.contains(to) {
        return true
      }
      seen[to] = true
      work.push(to)
    }
  }
  false
}

/// Whether leaf paths a and b name the same leaf, or one holds the other.
fn paths_overlap(a: Str, b: Str) -> Bool {
  a == b || a.starts_with("${b}.") || b.starts_with("${a}.")
}
