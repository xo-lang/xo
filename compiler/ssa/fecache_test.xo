// Front end cache entries (decision 0271): the header verify compares.

/// An entry's head as fe_entry writes it: version, own flags, recorder,
/// the declaration's line and whether the entry is pinned to it (decision
/// 0271 addendum, front cache v12), then the tail (the body and its
/// effects on the builder).
fn head_entry(own: Str, recorder: Str, tail: Bytes) -> Bytes {
  head_entry_at(own, recorder, 10, false, tail)
}

fn head_entry_at(own: Str, recorder: Str, line: Int, pinned: Bool, tail: Bytes) -> Bytes {
  var e = EntryW{b: BytesBuilder.new()}
  e.str(FE_CACHE_VERSION)
  e.str(own)
  e.str(recorder)
  e.uv(line)
  e.bool(pinned)
  e.bytes(tail)
  e.b.freeze()
}

test "verify compares the tail, not the xo that recorded the entry (fe_same)" {
  let a = head_entry("conc=false", "xo-a", b"body one")
  expect(fe_same(a, head_entry("conc=false", "xo-b", b"body one"))) == true
  expect(fe_same(a, head_entry("conc=false", "xo-a", b"body two"))) == false
  expect(fe_same(a, head_entry("conc=true", "xo-a", b"body one"))) == false
}

test "verify does not compare where the body was (fe_same: line, pinned)" {
  let a = head_entry_at("conc=false", "xo-a", 10, false, b"body one")
  expect(fe_same(a, head_entry_at("conc=false", "xo-a", 42, false, b"body one"))) == true
  expect(fe_same(a, head_entry_at("conc=false", "xo-a", 10, true, b"body one"))) == true
  expect(fe_same(a, head_entry_at("conc=false", "xo-a", 42, true, b"body two"))) == false
}
