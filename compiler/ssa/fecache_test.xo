// Front end cache entries (decision 0271): the header verify compares.

/// An entry's head as fe_entry writes it: version, own flags, recorder,
/// the declaration's line and whether the entry is pinned to it (decision
/// 0271 addendum, front cache v12), then the tail (the body and its
/// effects on the builder).
fn head_entry(own: Str, recorder: Str, tail: Bytes) -> Bytes {
  head_entry_at(own, recorder, 10, false, tail)
}

fn head_entry_at(own: Str, recorder: Str, line: Int, pinned: Bool, tail: Bytes) -> Bytes {
  var e = EntryW{b: BytesBuilder.new()}
  e.str(FE_CACHE_VERSION)
  e.str(own)
  e.str(recorder)
  e.uv(line)
  e.bool(pinned)
  e.bytes(tail)
  e.b.freeze()
}

test "verify compares the tail, not the xo that recorded the entry (fe_same)" {
  let a = head_entry("conc=false", "xo-a", b"body one")
  expect(fe_same(a, head_entry("conc=false", "xo-b", b"body one"))) == true
  expect(fe_same(a, head_entry("conc=false", "xo-a", b"body two"))) == false
  expect(fe_same(a, head_entry("conc=true", "xo-a", b"body one"))) == false
}

/// A tail as fe_entry writes it: no checks, no variables, the modules the
/// body built code of first, then target, flag bits, and the body.
fn tail_with(mods: List[Str], body: Bytes) -> Bytes {
  var t = EntryW{b: BytesBuilder.new()}
  t.uv(0)
  t.sv(0)
  t.uv(mods.len())
  for m in mods {
    t.str(m)
  }
  t.bool(false)
  t.uv(0)
  t.bytes(body)
  t.b.freeze()
}

test "verify does not compare the modules a body built code of first (fe_same: tail_sans_mods)" {
  // the same body recorded where native/llrt/ints was declared before it
  // and where it was not (2026-10-23, prelude.llrt_str_hash)
  let a = head_entry("conc=false", "xo-a", tail_with([], b"body one"))
  expect(fe_same(a, head_entry("conc=false", "xo-a", tail_with(["native/llrt/ints"], b"body one")))) == true
  expect(fe_same(a, head_entry("conc=false", "xo-a", tail_with(["native/llrt/ints"], b"body two")))) == false
  expect(tail_sans_mods(tail_with(["a", "b"], b"x"))) == tail_sans_mods(tail_with([], b"x"))
  expect(tail_sans_mods(tail_with(["a"], b"x")) == tail_sans_mods(tail_with([], b"y"))) == false
  // a tail fe_entry did not write is compared whole
  expect(tail_sans_mods(b"body one")) == None
}

test "verify does not compare where the body was (fe_same: line, pinned)" {
  let a = head_entry_at("conc=false", "xo-a", 10, false, b"body one")
  expect(fe_same(a, head_entry_at("conc=false", "xo-a", 42, false, b"body one"))) == true
  expect(fe_same(a, head_entry_at("conc=false", "xo-a", 10, true, b"body one"))) == true
  expect(fe_same(a, head_entry_at("conc=false", "xo-a", 42, true, b"body two"))) == false
}

test "shift_lines moves packed lines by whole lines, columns kept (v13)" {
  var f = Func{name: "f", file: "a.xo"}
  f.values.push(Value{op: Op.Const, line: 10 * 4096 + 3, pos: "a.xo:10:3"})
  f.values.push(Value{op: Op.Const, line: 0, pos: "b.xo:4:1"})
  f.dvars.push(DVar{name: "x", ty: -1, line: 11 * 4096 + 5})
  f.dbinds.push(DBind{dvar: 0, value: 0, line: 12 * 4096 + 7})
  expect(relocatable(f, 10)) == true
  expect(relocatable(f, 11)) == false
  shift_lines(f, 2)
  expect(f.values[0].line) == 12 * 4096 + 3
  expect(f.values[0].pos) == "a.xo:12:3"
  expect(f.values[1].line) == 0
  expect(f.values[1].pos) == "b.xo:4:1"
  expect(f.dvars[0].line) == 13 * 4096 + 5
  expect(f.dbinds[0].line) == 14 * 4096 + 7
  shift_lines(f, -2)
  expect(f.values[0].line) == 10 * 4096 + 3
  expect(f.dvars[0].line) == 11 * 4096 + 5
}

test "verify numbers closures alike: closure_name" {
  expect(closure_name("http.call_raw.fn17")) == true
  expect(closure_name("f.fn1")) == true
  expect(closure_name("f.fn")) == false
  expect(closure_name("main")) == false
  expect(closure_name("a.fnx")) == false
}

test "an entry that made a thunk replays with the one there only when it is the same (thunk_replay_ok)" {
  let sig = "(Int) -> (Int)"
  // the same thunk another body made first: replay with it
  expect(thunk_replay_ok("twice.value", 7, sig, "twice.value", 7, sig)) == true
  // a thunk of another name, another target, or another signature: the
  // entry is refused (fe miss thunk), its body built from source
  expect(thunk_replay_ok("inc.value", 7, sig, "twice.value", 7, sig)) == false
  expect(thunk_replay_ok("twice.value", 8, sig, "twice.value", 7, sig)) == false
  expect(thunk_replay_ok("twice.value", 7, "(Int, Int) -> (Int)", "twice.value", 7, sig)) == false
  expect(thunk_replay_ok("twice.value", -1, sig, "twice.value", -1, sig)) == false
  // a callee not declared yet here: the target decides (it fixes the
  // signature), and a wrong target still refuses
  expect(thunk_replay_ok("twice.value", 7, sig, "twice.value", 7, "")) == true
  expect(thunk_replay_ok("twice.value", 8, sig, "twice.value", 7, "")) == false
}
