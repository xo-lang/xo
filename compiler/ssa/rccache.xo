// The per-function cache of insert_rc (decision 0220 addendum stage C):
// after borrow inference, a function's reference counting reads only its
// own SSA, the types, and the borrowed parameters of the functions it
// names, so its result is cached under the hash of those (rc_key) and,
// on a hit, read back (decode_func) instead of computed. Also the type
// keys (a type's name and the hash of every type it reaches) the arm64
// emitter's cache (compiler/arm64 fcache.xo) uses. compiler/xo reads and
// writes the entries (XO_BACKEND_CACHE=on|verify|off, bcache.xo).

use std/crypto

/// The version of the entries and keys.
const RC_CACHE_VERSION = "xo rc cache v11"

/// What insert_rc_plan computed for the cache: the key of each function
/// ("" for one not cached), and the pass's state after borrow inference.
pub struct RcPlan {
  pub keys: List[Str] = []
  r: Rc = Rc{types: []}
  ready: Bool = false
}

/// What insert_rc_apply did with the cache: the entries to store (key,
/// entry), the functions read from entries, and the functions whose
/// computed result differs from their entry (verify).
pub struct RcOut {
  pub stores: List[(Str, Bytes)] = []
  pub reused: Int = 0
  pub mismatches: List[Str] = []
  /// The hits left undecoded (insert_rc_apply's sums)
  pub lazy: List[(Int, LazyFn)] = []
}

/// A function read from the cache but not decoded (Module.lazy): its
/// key, its entry, and the inliner's summary of it (compiler/arm64
/// inlsum.xo), which the cache keeps beside the entry under the same key.
pub struct LazyFn {
  pub key: Str
  pub entry: Bytes
  pub sum: Bytes
  /// the decoded function's Func.ckey: "rc KEY" when empty (an inline
  /// hit's is "inl KEY", decision 0283 stage B)
  pub ckey: Str = ""
}

/// What stands in the module for a lazy function: its name and the
/// facts outside its body (the passes before force_lazy read the
/// summary, not the body). reader comes from the function as built: the
/// inliner must see it without decoding the body (a build without debug
/// information keeps the readers' stubs this way, 2026-10-25).
fn lazy_shell(f: Func, key: Str, borrowed: List[Bool]) -> Func {
  Func{name: f.name, file: f.file, results: f.results, indirect: f.indirect, entry: f.entry, export: f.export, catches: f.catches, reader: f.reader, borrowed: borrowed, ckey: "rc ${key}"}
}

/// Decodes the lazy functions idx of m (all of them for idx []) in
/// place, on up to jobs tasks; a function whose entry does not decode
/// faults (its entry decoded when it was read: the codec is the same).
pub fn force_lazy(var m: Module, idx: List[Int], jobs: Int) {
  if m.lazy.is_empty() {
    return
  }
  var todo: List[(Int, LazyFn)] = []
  if idx.is_empty() {
    for (fi, l) in m.lazy {
      todo.push((fi, l))
    }
  } else {
    for fi in idx {
      if let Some(l) = m.lazy.get(fi) {
        todo.push((fi, l))
      }
    }
  }
  if todo.is_empty() {
    return
  }
  let mt = Module{types: m.types, type_at: m.type_at, goarch: m.goarch}
  let ops = ops_by_name()
  let n = todo.len()
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(s.spawn(fn() -> List[(Int, Func)] {
        var mine: List[(Int, Func)] = []
        while true {
          let i = next.add(16) - 16
          if i >= n {
            break
          }
          for j in i..(i + 16).min(n) {
            let (fi, l) = todo[j]
            match decode_func(mt, l.entry, ops) {
              Some(g0) => {
                var g = g0
                g.ckey = if l.ckey.is_empty() { "rc ${l.key}" } else { l.ckey }
                mine.push((fi, g))
              }
              None => fault("ssa.force_lazy: the cache entry of ${l.key} no longer decodes")
            }
          }
        }
        mine
      }))
    }
    var all: List[(Int, Func)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  for (fi, g) in done {
    m.funcs[fi] = g
    m.lazy.remove(fi)
    m.facts.remove(fi)
  }
}

/// force_lazy of the lazy functions with no body facts (the reference
/// counting cache's shells); those with facts (the inline cache's,
/// decision 0283 stage B) stay until a reader forces them.
pub fn force_lazy_unfacted(var m: Module, jobs: Int) {
  var idx: List[Int] = []
  for (fi, _) in m.lazy {
    if !m.facts.contains(fi) {
      idx.push(fi)
    }
  }
  if !idx.is_empty() {
    force_lazy(m, idx, jobs)
  }
}

/// The first half of insert_rc_jobs with the cache: the `var` List
/// parameters made unique, borrow inference, and the key of every
/// function (on up to jobs tasks) for the compiler of identity id.
pub fn (var b: Builder) insert_rc_plan(id: Str, jobs: Int) -> RcPlan {
  let r = b.rc_prepare(jobs)
  b.insert_rc_keys(r, type_keys(b.m), id, jobs)
}

/// insert_rc_plan's second half: every function's key, after
/// rc_prepare (borrow inference) gave r, with the module's type keys tk
/// (type_keys).
pub fn (b: Builder) insert_rc_keys(r: Rc, tk: List[Str], id: Str, jobs: Int) -> RcPlan {
  let m = b.m
  let n = m.funcs.len()
  let rr = r
  let w = jobs.min(n).max(1)
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..w {
      ts.push(s.spawn(fn() -> List[(Int, Str)] {
        var mine: List[(Int, Str)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for fi in i..(i + 64).min(n) {
            mine.push((fi, rc_key(m, fi, rr, tk, id)))
          }
        }
        mine
      }))
    }
    var all: List[(Int, Str)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var keys: List[Str] = []
  for _ in 0..n {
    keys.push("")
  }
  for (fi, k) in done {
    keys[fi] = k
  }
  RcPlan{keys: keys, r: r, ready: true}
}

/// The second half: every function's reference counting, read from its
/// entry when the cache holds one (and not verify), else computed and
/// encoded for the cache (verify: compared with the entry).
/// With sums (the inliner's summaries by key, decision 0220 addendum
/// stage D 2b), a hit that has one is not decoded: the function is a
/// shell and Module.lazy holds its entry until force_lazy.
pub fn (var b: Builder) insert_rc_apply(plan: RcPlan, entries: Map[Str, Bytes], sums: Map[Str, Bytes], verify: Bool, jobs: Int) -> RcOut {
  let out = b.rc_run(plan.r, plan.keys, entries, sums, verify, jobs)
  for (fi, l) in out.lazy {
    b.m.lazy[fi] = l
  }
  out
}

/// The key of function fi (before its reference counting): the SHA-256
/// of the compiler's identity, the target, the function in full with its
/// types by key, its borrowed parameters, and those of every function it
/// names, with their immortal results and decision 0322 facts (r.uq).
fn rc_key(m: Module, fi: Int, r: Rc, tk: List[Str], id: Str) -> Str {
  let f = m.funcs[fi]
  var b = BytesBuilder.new()
  b.write_str("${RC_CACHE_VERSION}\n${id}\n${m.goarch}\n")
  b.write_str("self ${bools_text(r.borrowed[fi])} last=${(r.fidx.get(f.name) ?? -1) == fi} imm=${r.skip_imm}\n")
  if key_body(b, m, fi, f, tk) {
    // apply_uniq's marks, which the body id does not cover
    let es = if fi < r.uq_entry.len() { bools_text(r.uq_entry[fi]) } else { "-" }
    b.write_str("uq ${es} ${r.uq_mark}\n")
  }
  var seen: Map[Str, Bool] = {}
  for x in f.values {
    if let S(s) = x.aux {
      if !seen.contains(s) {
        seen[s] = true
        let ci = r.fidx.get(s) ?? -1
        let bs = if ci >= 0 { bools_text(r.borrowed[ci]) } else { "none" }
        // its immortal fields too (immortal_returns, read by immortal_leaf)
        let ir = if let Some(fs) = r.imm_ret.get(s) { bools_text(fs) } else { "-" }
        // and what it hands back unique (decision 0322, Rc.handed_unique)
        let uq = if ci >= 0 && ci < r.uq.len() { bools_text(r.uq[ci]) } else { "-" }
        b.write_str("callee ${s.len()}:${s} ${bs} ${ir} ${uq}\n")
      }
    }
  }
  crypto.sha256(b.freeze()).to_hex()
}

/// Each function's body hash for the incremental borrow inference
/// (rc_prepare_incr), on up to jobs tasks: the SHA-256 of the compiler's
/// identity, the target, the function in full (after reuse_var_params)
/// with its types by key, and whether each name it uses names a function
/// of the module. What a scan reads of its callees (their flags, `var`
/// parameters, immortal returns, signatures) comes from their bodies,
/// whose own hashes cover it: a changed callee makes its callers
/// inferred again (infer_borrows_incr).
fn borrow_hashes(m: Module, r: Rc, tk: List[Str], id: Str, jobs: Int) -> List[Str] {
  let n = m.funcs.len()
  let rr = r
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(s.spawn(fn() -> List[(Int, Str)] {
        var mine: List[(Int, Str)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for fi in i..(i + 64).min(n) {
            mine.push((fi, borrow_hash(m, fi, rr, tk, id)))
          }
        }
        mine
      }))
    }
    var all: List[(Int, Str)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var hs: List[Str] = []
  for _ in 0..n {
    hs.push("")
  }
  for (fi, h) in done {
    hs[fi] = h
  }
  hs
}

fn borrow_hash(m: Module, fi: Int, r: Rc, tk: List[Str], id: Str) -> Str {
  let f = m.funcs[fi]
  var b = BytesBuilder.new()
  b.write_str("${BORROW_REC_VERSION}\n${id}\n${m.goarch}\nlast=${(r.fidx.get(f.name) ?? -1) == fi} imm=${r.skip_imm}\n")
  let _id = key_body(b, m, fi, f, tk)
  var seen: Map[Str, Bool] = {}
  for x in f.values {
    if let S(s) = x.aux {
      if !seen.contains(s) {
        seen[s] = true
        b.write_str("name ${s.len()}:${s} ${r.fidx.contains(s)}\n")
      }
    }
  }
  crypto.sha256(b.freeze()).to_hex()
}

/// Writes what stands for function fi's body (f) into a key: its body id
/// when it has one (Module.body_ids, decision 0382 stage 3), else the
/// body in full (key_func); whether it was the id.
fn key_body(var b: BytesBuilder, m: Module, fi: Int, f: Func, tk: List[Str]) -> Bool {
  if fi < m.body_ids.len() && !m.body_ids[fi].is_empty() {
    b.write_str("body ${m.body_ids[fi]}\n")
    return true
  }
  key_func(b, f, tk)
  false
}

/// The version of the incremental borrow inference's record and hashes.
pub const BORROW_REC_VERSION = "xo borrow record v3"

fn bools_text(xs: List[Bool]) -> Str {
  var b = StrBuilder.new()
  b.write("[")
  for x in xs {
    b.write(if x { "1" } else { "0" })
  }
  b.write("]")
  b.freeze()
}

fn ints_line(xs: List[Int]) -> Str {
  var b = StrBuilder.new()
  for (i, x) in xs.indexed() {
    if i > 0 {
      b.write(" ")
    }
    b.write("${x}")
  }
  b.freeze()
}

fn tkey(tk: List[Str], t: Int) -> Str {
  if t < 0 || t >= tk.len() { "-" } else { tk[t] }
}

/// Function f in full for a key: every field, its types by key. Written
/// straight into b (no text per value: it ran on every function of every
/// build, twice), the bytes ints_line and interpolation wrote before.
fn key_func(var b: BytesBuilder, f: Func, tk: List[Str]) {
  key_head(b, f, tk)
  key_blocks(b, f, tk)
}

/// What key_func writes of f but its blocks, values and edges: its
/// name, flags, signature by type key and land_rest.
fn key_head(var b: BytesBuilder, f: Func, tk: List[Str]) {
  b.write_str("func ")
  write_int(b, f.name.len())
  b.write_str(":${f.name} indirect=${f.indirect} entry=${f.entry} export=${f.export.len()}:${f.export} catches=${f.catches} unwind=${f.unwind_exit} skip=${f.skip.len()}:${f.skip} file=${f.file.len()}:${f.file} var=[")
  write_ints(b, f.var_params)
  b.write_str("] borrowed=${bools_text(f.borrowed)}\n")
  b.write_str("results")
  for t in f.results {
    b.write_byte(' ')
    b.write_str(tkey(tk, t))
  }
  b.write_str("\ncaptures")
  for t in f.captures {
    b.write_byte(' ')
    b.write_str(tkey(tk, t))
  }
  var lr: List[Int] = []
  for (k, _) in f.land_rest {
    lr.push(k)
  }
  b.write_str("\nland_rest [")
  write_ints(b, lr.sort())
  b.write_str("]\n")
}

/// What key_func writes of f after key_head.
fn key_blocks(var b: BytesBuilder, f: Func, tk: List[Str]) {
  for (bi, bl) in f.blocks.indexed() {
    b.write_byte('b')
    write_int(b, bi)
    b.write_str(" [")
    write_ints(b, bl.params)
    b.write_str("] [")
    write_ints(b, bl.instrs)
    b.write_str("] [")
    write_ints(b, bl.preds)
    b.write_str("]\n")
  }
  for (vi, x) in f.values.indexed() {
    b.write_byte('v')
    write_int(b, vi)
    b.write_byte(' ')
    b.write_str(op_name(x.op))
    b.write_byte(' ')
    b.write_str(tkey(tk, x.ty))
    b.write_str(" [")
    write_ints(b, x.args)
    b.write_str("] ")
    key_aux(b, x.aux)
    b.write_byte(' ')
    write_int(b, x.block)
    b.write_str(" [")
    write_ints(b, x.succs)
    b.write_str("] ")
    write_int(b, x.pad)
    b.write_byte(' ')
    write_int(b, x.line)
    b.write_byte(' ')
    write_int(b, x.pos.len())
    b.write_byte(':')
    b.write_str(x.pos)
    b.write_byte('\n')
  }
  for (ei, e) in f.edges.indexed() {
    b.write_byte('e')
    write_int(b, ei)
    b.write_byte(' ')
    write_int(b, e.from)
    b.write_byte(' ')
    write_int(b, e.to)
    b.write_str(" [")
    write_ints(b, e.args)
    b.write_str("]\n")
  }
  for d in f.dvars {
    b.write_str("dvar ${d.name.len()}:${d.name} ${tkey(tk, d.ty)} ${d.line} ${d.param} ${d.inl}\n")
  }
  for d in f.dbinds {
    b.write_str("dbind ${d.dvar} ${d.value} ${d.line}\n")
  }
}

/// What a front end replay (fecache.xo fe_replay) sets of a body beyond
/// its entry's bytes, for a key that hashes those bytes in place of the
/// body (clncache.xo cln_key): the header (the name and target this
/// build gives it), and each value's line and position (shift_lines: an
/// entry's lines are relative to its declaration's), aux (fe_rename's
/// closure names, fe_const_ids' constant numbers, fe_site_ids' spawn
/// sites) and type by key, and the debug rows' lines. A cache hit keyed
/// by the entry alone took another build's numbering (2026-10-27: TLS
/// goldens read the wrong constants, a moved body kept its old lines).
fn key_replayed(var b: BytesBuilder, f: Func, tk: List[Str]) {
  key_head(b, f, tk)
  for x in f.values {
    write_int(b, x.line)
    b.write_byte(' ')
    write_int(b, x.pos.len())
    b.write_byte(':')
    b.write_str(x.pos)
    b.write_byte(' ')
    key_aux(b, x.aux)
    b.write_byte(' ')
    b.write_str(tkey(tk, x.ty))
    b.write_byte('\n')
  }
  for d in f.dvars {
    b.write_str("dvar ${d.name.len()}:${d.name} ${tkey(tk, d.ty)} ${d.line} ${d.param} ${d.inl}\n")
  }
  for d in f.dbinds {
    b.write_str("dbind ${d.dvar} ${d.value} ${d.line}\n")
  }
}

/// Writes x in decimal, as "${x}" does.
fn write_int(var b: BytesBuilder, x: Int) {
  if x >= 0 && x < 10 {
    b.write_byte(UInt8(x + 48))
    return
  }
  if x < 0 {
    // the most negative Int has no positive; -x would overflow
    if x < -999999999999999999 {
      b.write_str("${x}")
      return
    }
    b.write_byte('-')
    write_int(b, -x)
    return
  }
  write_int(b, x / 10)
  b.write_byte(UInt8(x % 10 + 48))
}

/// Writes xs as ints_line does: decimal, separated by one space.
fn write_ints(var b: BytesBuilder, xs: List[Int]) {
  for (i, x) in xs.indexed() {
    if i > 0 {
      b.write_byte(' ')
    }
    write_int(b, x)
  }
}

fn key_aux(var b: BytesBuilder, a: Aux) {
  match a {
    None => b.write_str("n")
    I(n) => b.write_str("i${n}")
    F(x) => b.write_str("f${float_bits(x)}")
    B(x) => b.write_str("b${x}")
    S(s) => b.write_str("s${s.len()}:${s}")
    Bs(x) => {
      b.write_str("y${x.len()}:")
      b.write(x)
    }
    P(tag, field) => b.write_str("p${tag},${field}")
  }
}

// ---------------------------------------------------------------------------
// Entries: a function after its reference counting, types by name

/// Every opcode, for reading an entry back (an opcode missing here only
/// makes its functions miss the cache).
fn all_ops() -> List[Op] {
  [Op.Param, Op.Const, Op.Add, Op.Sub, Op.Mul, Op.Div, Op.Rem, Op.Neg, Op.And, Op.Or, Op.Xor, Op.Not, Op.Shl, Op.Shr, Op.Eq, Op.Ne, Op.Lt, Op.Le, Op.Gt, Op.Ge, Op.IntToFloat, Op.FloatToInt, Op.IntConv, Op.Struct, Op.Tuple, Op.Variant, Op.Field, Op.SetField, Op.Tag, Op.Payload, Op.Cap, Op.Undef, Op.Closure, Op.Capture, Op.CallValue, Op.Box, Op.Unbox, Op.FuncAddr, Op.Rebind, Op.Call, Op.Fault, Op.Retain, Op.Release, Op.Drop, Op.Reuse, Op.Share, Op.Jump, Op.Branch, Op.Return, Op.Unreachable]
}

/// The name of type t, "" for none; false when the name does not lead
/// back to t (two types of one name): the function is not cached.
fn type_name_of(m: Module, t: Int) -> (Str, Bool) {
  if t < 0 {
    return ("", true)
  }
  let n = m.types[t].name
  (n, (m.type_at.get(n) ?? -1) == t)
}

/// The writer of an entry (binary since v7, 2026-10-18: the text form
/// took 3.4 s of CPU to read back after an edit of xo, and the entries
/// of one build were about 450 MB): unsigned and zigzag varints, strings
/// by length, and the type and opcode names in one table each entry
/// refers to by index (0 for no type).
struct EntryW {
  b: BytesBuilder
  names: Map[Str, Int] = {}
  table: List[Str] = []
  ok: Bool = true
}

fn (var e: EntryW) uv(n: Int) {
  var x = n
  while true {
    let low = x & 127
    x = x.shr_logical(7)
    if x == 0 {
      e.b.write_byte(UInt8(low))
      return
    }
    e.b.write_byte(UInt8(low | 128))
  }
}

fn (var e: EntryW) sv(n: Int) {
  e.uv(n.wrapping_shl(1) ^ (n >> 63))
}

fn (var e: EntryW) bytes(d: Bytes) {
  e.uv(d.len())
  e.b.write(d)
}

fn (var e: EntryW) str(s: Str) {
  e.bytes(s.bytes())
}

fn (var e: EntryW) bool(x: Bool) {
  e.uv(if x { 1 } else { 0 })
}

fn (var e: EntryW) ints(xs: List[Int]) {
  e.uv(xs.len())
  for x in xs {
    e.sv(x)
  }
}

/// A name of the entry's table, by index.
fn (var e: EntryW) name(s: Str) {
  match e.names.get(s) {
    Some(i) => e.uv(i)
    None => {
      let i = e.table.len()
      e.names[s] = i
      e.table.push(s)
      e.uv(i)
    }
  }
}

/// Type t by name (0 for none, else 1 + its name's index); not ok for a
/// type whose name is not its own.
fn (var e: EntryW) ty(m: Module, t: Int) {
  if t < 0 {
    e.uv(0)
    return
  }
  let (n, ok) = type_name_of(m, t)
  if !ok {
    e.ok = false
  }
  match e.names.get(n) {
    Some(i) => e.uv(i + 1)
    None => {
      let i = e.table.len()
      e.names[n] = i
      e.table.push(n)
      e.uv(i + 1)
    }
  }
}

fn (var e: EntryW) types(m: Module, ts: List[Int]) {
  e.uv(ts.len())
  for t in ts {
    e.ty(m, t)
  }
}

/// Function f as an entry; none when it holds what an entry cannot (a
/// Float constant, a type whose name is not its own).
fn encode_func(m: Module, f: Func) -> Option[Bytes] {
  var e = EntryW{b: BytesBuilder.new()}
  e.str(f.name)
  e.types(m, f.results)
  e.ints(f.var_params)
  e.uv((if f.indirect { 1 } else { 0 }) + (if f.entry { 2 } else { 0 }) + (if f.catches { 4 } else { 0 }) + (if f.reader { 8 } else { 0 }))
  e.sv(f.unwind_exit)
  e.types(m, f.captures)
  e.str(f.export)
  e.str(f.file)
  var lr: List[Int] = []
  for (k, _) in f.land_rest {
    lr.push(k)
  }
  e.ints(lr.sort())
  var mv: List[Int] = []
  for (k, _) in f.moved {
    mv.push(k)
  }
  e.ints(mv.sort())
  e.uv(f.borrowed.len())
  for x in f.borrowed {
    e.bool(x)
  }
  e.str(f.skip)
  e.uv(f.blocks.len())
  for bl in f.blocks {
    e.ints(bl.params)
    e.ints(bl.instrs)
    e.ints(bl.preds)
  }
  e.uv(f.values.len())
  for x in f.values {
    e.name(op_name(x.op))
    e.ty(m, x.ty)
    e.ints(x.args)
    match x.aux {
      None => e.uv(0)
      I(n) => {
        e.uv(1)
        e.sv(n)
      }
      F(x) => {
        e.uv(7)
        e.sv(float_bits(x))
      }
      B(v) => e.uv(if v { 3 } else { 2 })
      S(s) => {
        e.uv(4)
        e.str(s)
      }
      Bs(v) => {
        e.uv(5)
        e.bytes(v)
      }
      P(tag, field) => {
        e.uv(6)
        e.sv(tag)
        e.sv(field)
      }
    }
    e.sv(x.block)
    e.sv(x.pad)
    e.sv(x.line)
    e.sv(x.inl)
    e.ints(x.succs)
    e.str(x.pos)
  }
  e.uv(f.edges.len())
  for ed in f.edges {
    e.sv(ed.from)
    e.sv(ed.to)
    e.ints(ed.args)
  }
  e.uv(f.dvars.len())
  for d in f.dvars {
    e.str(d.name)
    e.ty(m, d.ty)
    e.sv(d.line)
    e.bool(d.param)
    e.sv(d.inl)
  }
  e.uv(f.dbinds.len())
  for d in f.dbinds {
    e.sv(d.dvar)
    e.sv(d.value)
    e.sv(d.line)
  }
  // the inline sites (after the arm64 inliner, its cache: stage D 2a)
  e.uv(f.inl_sites.len())
  for st in f.inl_sites {
    e.str(st.callee)
    e.str(st.file)
    e.sv(st.call_line)
    e.sv(st.parent)
  }
  if !e.ok {
    return None
  }
  let body = e.b.freeze()
  var h = EntryW{b: BytesBuilder.with_capacity(body.len() + 64 + 16 * e.table.len())}
  h.str(RC_CACHE_VERSION)
  h.uv(e.table.len())
  for s in e.table {
    h.str(s)
  }
  h.b.write(body)
  Some(h.b.freeze())
}

/// The reader of an entry; ok turns false on a malformed one.
struct EntryR {
  d: Bytes
  at: Int = 0
  ok: Bool = true
  /// the entry's names, as types of this module (-1: not one) and as
  /// opcodes
  tys: List[Int] = []
  ops: List[Option[Op]] = []
}

fn (var r: EntryR) uv() -> Int {
  var x = 0
  var sh = 0
  while true {
    if r.at >= r.d.len() || sh > 63 {
      r.ok = false
      return 0
    }
    let c = Int(r.d[r.at])
    r.at += 1
    x = x | (c & 127).wrapping_shl(sh)
    if c < 128 {
      return x
    }
    sh += 7
  }
  x
}

fn (var r: EntryR) sv() -> Int {
  let z = r.uv()
  z.shr_logical(1) ^ (0 - (z & 1))
}

fn (var r: EntryR) bytes() -> Bytes {
  let n = r.uv()
  if !r.ok || n < 0 || r.at + n > r.d.len() {
    r.ok = false
    return b""
  }
  let out = r.d[r.at..r.at + n]
  r.at += n
  out
}

fn (var r: EntryR) str() -> Str {
  match r.bytes().to_str() {
    Some(s) => s
    None => {
      r.ok = false
      ""
    }
  }
}

fn (var r: EntryR) bool() -> Bool {
  r.uv() == 1
}

fn (var r: EntryR) ints() -> List[Int] {
  let n = r.uv()
  if !r.ok || n > r.d.len() {
    r.ok = false
    return []
  }
  if n == 0 {
    return []
  }
  // sized once: grown by push, a decode's lists (every block's and
  // value's) showed as alloc and memmove in llvm-fib's edit profile
  // (2026-10-27); CPU only, the edit's wall time did not change
  var out = List[Int].with_capacity(n)
  for _ in 0..n {
    out.push(r.sv())
  }
  out
}

/// A type by its table index (0: none); not ok for one this module does
/// not have.
fn (var r: EntryR) ty() -> Int {
  let i = r.uv()
  if i == 0 {
    return -1
  }
  if i > r.tys.len() || r.tys[i - 1] < 0 {
    r.ok = false
    return -1
  }
  r.tys[i - 1]
}

fn (var r: EntryR) types() -> List[Int] {
  let n = r.uv()
  var out: List[Int] = []
  if !r.ok || n > r.d.len() {
    r.ok = false
    return out
  }
  for _ in 0..n {
    out.push(r.ty())
  }
  out
}

/// The function of an entry with this module's type ids; none for a
/// malformed entry, another version, or a type or opcode not known.
fn decode_func(m: Module, d: Bytes, ops: Map[Str, Op]) -> Option[Func] { decode_func_at(m, d, ops, false) }

/// The function of an entry func_entry wrote without its body: every
/// field before the blocks (name, results, `var` parameters, flags,
/// unwind exit, captures, export, file, borrowed, skip), for the shell
/// of a function not decoded (decision 0283 stage B).
pub fn func_head_of_entry(m: Module, d: Bytes) -> Option[Func] { decode_func_at(m, d, ops_by_name(), true) }

fn decode_func_at(m: Module, d: Bytes, ops: Map[Str, Op], head_only: Bool) -> Option[Func] {
  var r = EntryR{d: d}
  if r.str() != RC_CACHE_VERSION {
    return None
  }
  let nt = r.uv()
  if !r.ok || nt > d.len() {
    return None
  }
  r.tys = List[Int].with_capacity(nt)
  r.ops = List[Option[Op]].with_capacity(nt)
  for _ in 0..nt {
    let s = r.str()
    r.tys.push(m.type_at.get(s) ?? -1)
    r.ops.push(ops.get(s))
  }
  var f = Func{name: r.str()}
  f.results = r.types()
  f.var_params = r.ints()
  let fl = r.uv()
  f.indirect = fl & 1 != 0
  f.entry = fl & 2 != 0
  f.catches = fl & 4 != 0
  f.reader = fl & 8 != 0
  f.unwind_exit = r.sv()
  f.captures = r.types()
  f.export = r.str()
  f.file = r.str()
  for k in r.ints() {
    f.land_rest[k] = true
  }
  for k in r.ints() {
    f.moved[k] = true
  }
  let nbw = r.uv()
  if !r.ok || nbw > d.len() {
    return None
  }
  for _ in 0..nbw {
    f.borrowed.push(r.bool())
  }
  f.skip = r.str()
  if head_only {
    return if r.ok { Some(f) } else { None }
  }
  let nb = r.uv()
  if !r.ok || nb > d.len() {
    return None
  }
  f.blocks = List[Block].with_capacity(nb)
  for _ in 0..nb {
    let ps = r.ints()
    let ins = r.ints()
    let pr = r.ints()
    f.blocks.push(Block{params: ps, instrs: ins, preds: pr})
  }
  let nv = r.uv()
  if !r.ok || nv > d.len() {
    return None
  }
  f.values = List[Value].with_capacity(nv)
  for _ in 0..nv {
    let oi = r.uv()
    if !r.ok || oi >= r.ops.len() {
      return None
    }
    let op = match r.ops[oi] {
      Some(o) => o
      None => return None
    }
    let ty = r.ty()
    let args = r.ints()
    let aux = match r.uv() {
      0 => Aux.None
      1 => Aux.I(n: r.sv())
      2 => Aux.B(b: false)
      3 => Aux.B(b: true)
      4 => Aux.S(s: r.str())
      5 => Aux.Bs(b: r.bytes())
      6 => {
        let tag = r.sv()
        Aux.P(tag: tag, field: r.sv())
      }
      7 => Aux.F(f: float_of_bits(r.sv()))
      _ => return None
    }
    let block = r.sv()
    let pad = r.sv()
    let line = r.sv()
    let inl = r.sv()
    let succs = r.ints()
    let pos = r.str()
    if !r.ok {
      return None
    }
    f.values.push(Value{op: op, ty: ty, args: args, aux: aux, block: block, succs: succs, pos: pos, pad: pad, line: line, inl: inl})
  }
  let ne = r.uv()
  if !r.ok || ne > d.len() {
    return None
  }
  f.edges = List[Edge].with_capacity(ne)
  for _ in 0..ne {
    let from = r.sv()
    let to = r.sv()
    f.edges.push(Edge{from: from, to: to, args: r.ints()})
  }
  let ndv = r.uv()
  if !r.ok || ndv > d.len() {
    return None
  }
  for _ in 0..ndv {
    let name = r.str()
    let ty = r.ty()
    let line = r.sv()
    let param = r.bool()
    f.dvars.push(DVar{name: name, ty: ty, line: line, param: param, inl: r.sv()})
  }
  let ndb = r.uv()
  if !r.ok || ndb > d.len() {
    return None
  }
  for _ in 0..ndb {
    let dv = r.sv()
    let value = r.sv()
    f.dbinds.push(DBind{dvar: dv, value: value, line: r.sv()})
  }
  let nis = r.uv()
  if !r.ok || nis > d.len() {
    return None
  }
  for _ in 0..nis {
    let callee = r.str()
    let file = r.str()
    let cl = r.sv()
    f.inl_sites.push(InlSite{callee: callee, file: file, call_line: cl, parent: r.sv()})
  }
  if !r.ok || r.at != d.len() {
    return None
  }
  Some(f)
}

/// The opcodes by name.
fn ops_by_name() -> Map[Str, Op] {
  var out: Map[Str, Op] = {}
  for o in all_ops() {
    out[op_name(o)] = o
  }
  out
}

// ---------------------------------------------------------------------------
// Type keys

fn kind_text(k: Kind) -> Str {
  match k {
    Unit => "unit"
    Int => "int"
    Float => "float"
    Bool => "bool"
    Str => "str"
    Struct => "struct"
    Enum => "enum"
    Tuple => "tuple"
    List => "list"
    Cap => "cap"
    Func => "func"
    Box => "box"
    Handle => "handle"
    Bad => "bad"
  }
}

/// The types type x names directly.
fn type_refs(x: SType) -> List[Int] {
  var out: List[Int] = []
  for f in x.fields {
    out.push(f.ty)
  }
  for v in x.variants {
    for f in v.fields {
      out.push(f.ty)
    }
  }
  for e in x.elems {
    out.push(e)
  }
  if x.ret >= 0 {
    out.push(x.ret)
  }
  out
}

/// Type t one level deep: its kind, name, flags, and fields, the types
/// it names by name.
fn type_desc(m: Module, t: Int) -> Str {
  let x = m.types[t]
  var b = StrBuilder.new()
  b.write("${kind_text(x.kind)} ${x.name.len()}:${x.name} ${x.coll} ${x.bits} ${x.unsigned} ret=")
  b.write(if x.ret >= 0 { m.types[x.ret].name } else { "-" })
  b.write(" fields")
  for f in x.fields {
    b.write(" ${f.name.len()}:${f.name}=${m.types[f.ty].name.len()}:${m.types[f.ty].name}")
  }
  b.write(" variants")
  for v in x.variants {
    b.write(" ${v.name.len()}:${v.name}(")
    for f in v.fields {
      b.write(" ${f.name.len()}:${f.name}=${m.types[f.ty].name.len()}:${m.types[f.ty].name}")
    }
    b.write(")")
  }
  b.write(" elems")
  for e in x.elems {
    b.write(" ${m.types[e].name.len()}:${m.types[e].name}")
  }
  b.freeze()
}

/// Tarjan's strongly connected components over the types, each given
/// the hash of its members' descriptions and the hashes of the
/// components it reaches: a type's hash covers every type reachable from
/// it, and stays when an unrelated type is added.
struct TypeHasher {
  m: Module
  index: List[Int] = []
  low: List[Int] = []
  on: List[Bool] = []
  stack: List[Int] = []
  next: Int = 0
  hash: List[Str] = []
}

fn (var h: TypeHasher) visit(t: Int) {
  h.index[t] = h.next
  h.low[t] = h.next
  h.next += 1
  h.stack.push(t)
  h.on[t] = true
  for u in type_refs(h.m.types[t]) {
    if h.index[u] < 0 {
      h.visit(u)
      h.low[t] = h.low[t].min(h.low[u])
    } else if h.on[u] {
      h.low[t] = h.low[t].min(h.index[u])
    }
  }
  if h.low[t] != h.index[t] {
    return
  }
  var members: List[Int] = []
  while true {
    let u = h.stack.pop() ?? t
    h.on[u] = false
    members.push(u)
    if u == t {
      break
    }
  }
  var inside: Map[Int, Bool] = {}
  for u in members {
    inside[u] = true
  }
  var descs: List[Str] = []
  var outs: List[Str] = []
  for u in members {
    descs.push(type_desc(h.m, u))
    for v in type_refs(h.m.types[u]) {
      if !inside.contains(v) {
        outs.push(h.hash[v])
      }
    }
  }
  var b = StrBuilder.new()
  for d in descs.sort() {
    b.write("${d.len()}:${d}\n")
  }
  b.write("reaches\n")
  for o in outs.sort() {
    b.write("${o}\n")
  }
  let sum = crypto.sha256(b.freeze().bytes()).to_hex()[0..32]
  for u in members {
    h.hash[u] = sum
  }
}

/// Each type's key: its name and the hash of every type it reaches.
pub fn type_keys(m: Module) -> List[Str] {
  var h = TypeHasher{m: m}
  for _ in 0..m.types.len() {
    h.index.push(-1)
    h.low.push(0)
    h.on.push(false)
    h.hash.push("")
  }
  for t in 0..m.types.len() {
    if h.index[t] < 0 {
      h.visit(t)
    }
  }
  var out: List[Str] = []
  for (t, x) in m.types.indexed() {
    out.push("${x.name.len()}:${x.name}#${h.hash[t]}")
  }
  out
}

/// The verifier's key of each function (decision 0220 addendum stage D),
/// for a driver that verifies only the functions whose key it has not
/// seen verify: the SHA-256 of keys[fi] (the emitter's key: the function
/// in full, its types, and the signatures of the functions it names) and
/// what the verifier reads of each function it names besides: the first
/// and last function of the name, their borrowed parameters, whether
/// they can fault (may_fault), whether they catch, and their immortal
/// results. "" where keys[fi] is "" (always verified).
pub fn (m: Module) verify_keys(keys: List[Str]) -> List[Str] {
  let faults = m.may_fault()
  let imm = m.immortal_returns_m()
  var last: Map[Str, Int] = {}
  for (i, f) in m.funcs.indexed() {
    last[f.name] = i
  }
  var out: List[Str] = []
  for (fi, f) in m.funcs.indexed() {
    if fi >= keys.len() || keys[fi].is_empty() {
      out.push("")
      continue
    }
    var b = BytesBuilder.new()
    b.write_str("xo verify key v1\n${keys[fi]}\nself ${faults[fi]} ${f.catches} ${bools_text(f.borrowed)}\n")
    var seen: Map[Str, Bool] = {}
    // (a function not decoded: its body facts' names, decision 0283 B)
    for s in m.value_names(fi) {
      if !seen.contains(s) {
        seen[s] = true
        b.write_str("name ${s.len()}:${s}")
        for ci in [m.func_index(s), last.get(s) ?? -1] {
          if ci >= 0 {
            let g = m.funcs[ci]
            b.write_str(" ${ci} ${faults[ci]} ${g.catches} ${bools_text(g.borrowed)}")
          } else {
            b.write_str(" -")
          }
        }
        let ir = if let Some(fs) = imm.get(s) { bools_text(fs) } else { "-" }
        b.write_str(" ${ir}\n")
      }
    }
    out.push(crypto.sha256(b.freeze()).to_hex())
  }
  out
}

/// Function f as a cache entry (encode_func's codec), for the inliner's
/// cache (compiler/arm64 inlcache.xo); none for one an entry cannot hold.
pub fn func_entry(m: Module, f: Func) -> Option[Bytes] { encode_func(m, f) }

/// The function of an entry func_entry wrote, with m's type ids
/// (decode_func; ops from op_names); none for a malformed entry.
pub fn func_of_entry(m: Module, d: Bytes, ops: Map[Str, Op]) -> Option[Func] { decode_func(m, d, ops) }

/// The opcodes by name, for func_of_entry.
pub fn op_names() -> Map[Str, Op] { ops_by_name() }
