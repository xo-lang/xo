// Specialization of a callee for a call site's constant argument
// (decision 0368): a call that passes a closure of nothing or a literal
// to a function the inliner does not take calls a copy of that function
// in which the parameter is the constant, so the passes after it see the
// constant: arm64's devirtualize turns `f(r)` into a direct call the
// inliner takes, fold_consts and str_eq_const read the literal. LLVM gets
// the same from its interprocedural constant propagation.

/// The largest callee, in SSA values, that a call site's constant clones.
const SPEC_MAX_VALUES = 600

/// The most clones one module gets.
const SPEC_MAX_CLONES = 256

/// Clones callees for the constant arguments of their call sites
/// (specialize_args, decision 0368); every call with the same callee,
/// parameter, and constant calls one clone. Off under
/// XO_PASSES=-specialize_args and on wasm.
pub fn (var b: Builder) specialize_args() {
  if b.m.passes_off.contains("specialize_args") || b.wasm {
    return
  }
  var clones: Map[Str, Int] = {}
  // spec_callee by function index (0 not asked yet, 1 yes, 2 no): a
  // callee's answer reads only its own body, which neither pass changes
  // but for the names its calls take (never its own), so it is asked once
  // and not at each of its call sites (3.4 of the pass's 6 ms of CPU on
  // an HTTP server edit, 2026-10-27)
  var callee_ok: List[Int] = []
  // closures first, then literals with the budget left: the literals at
  // most call sites are fault locations a callee only passes on
  b.specialize_pass(clones, callee_ok, true)
  b.specialize_pass(clones, callee_ok, false)
}

/// One pass of specialize_args over the module and the clones it adds:
/// closure arguments when closures, else literals.
fn (var b: Builder) specialize_pass(var clones: Map[Str, Int], var callee_ok: List[Int], closures: Bool) {
  // the clones too, as they are added: a constant a clone passes on
  // (str_split_where's closure, which it hands to where_spans) clones the
  // next callee; SPEC_MAX_CLONES bounds the chain
  var fi = 0
  while fi < b.m.funcs.len() {
    if clones.len() >= SPEC_MAX_CLONES {
      return
    }
    for bi in 0..b.m.funcs[fi].blocks.len() {
      for v in b.m.funcs[fi].blocks[bi].instrs {
        let x = b.m.funcs[fi].values[v]
        if x.op != Op.Call {
          continue
        }
        let name = match x.aux {
          S(s) => s
          None | I(..) | F(..) | B(..) | Bs(..) | P(..) => ""
        }
        let ci = b.m.func_at.get(name) ?? -1
        if ci < 0 || ci == fi || !b.spec_callee_at(callee_ok, ci) {
          continue
        }
        for (k, a) in x.args.indexed() {
          let key = spec_key(b.m.funcs[fi], a)
          if key.is_empty() || key.starts_with("fn ") != closures || !spec_param(b.m.funcs[ci], k) {
            continue
          }
          if !closures && !spec_compared(b.m, ci, k, 3) {
            continue
          }
          let ck = "${name}#${k}=${key}"
          var c = clones.get(ck) ?? -1
          if c < 0 {
            if clones.len() >= SPEC_MAX_CLONES {
              break
            }
            c = b.m.add_clone(spec_clone(b.m.funcs[ci], k, b.m.funcs[fi].values[a], b.spec_name(name, ck)))
            clones[ck] = c
          }
          b.m.funcs[fi].values[v].aux = Aux.S(s: b.m.funcs[c].name)
          if fi < b.m.body_ids.len() {
            b.m.body_ids[fi] = ""
          }
          // one constant parameter a call: the clone's other parameters
          // stay parameters
          break
        }
      }
    }
    fi += 1
  }
}

/// The name of the clone of callee name for key ck (callee#k=constant):
/// `name#spec` and a hash of ck, so it depends on the constant alone, not
/// on the order the clones were made in (a counter numbered the same clone
/// apart on two targets whose modules differ, and TestWindowsAmd64Identity
/// paired functions by name, 2026-10-24); a later suffix only on a
/// collision.
fn (b: Builder) spec_name(name: Str, ck: Str) -> Str {
  let h = fe_mix(0, ck) & 281474976710655
  var n = "${name}#spec${h.to_str_base(16)}"
  var i = 0
  while b.m.func_at.contains(n) {
    i += 1
    n = "${name}#spec${h.to_str_base(16)}.${i}"
  }
  n
}

/// Whether f may be cloned: a plain function with a body of at most
/// SPEC_MAX_VALUES values that is not called through values, not an entry
/// or an export, has no captures, and does not call itself.
fn spec_callee(f: Func) -> Bool {
  if f.blocks.is_empty() || f.indirect || f.entry || !f.export.is_empty() || !f.captures.is_empty() || f.values.len() > SPEC_MAX_VALUES {
    return false
  }
  for bl in f.blocks {
    for v in bl.instrs {
      let x = f.values[v]
      if x.op == Op.Call {
        if let S(s) = x.aux {
          if s == f.name {
            return false
          }
        }
      }
    }
  }
  true
}

/// Whether parameter k of f may become a constant: an entry parameter
/// that is not a `var` parameter.
fn spec_param(f: Func, k: Int) -> Bool {
  k < f.blocks[0].params.len() && !f.var_params.contains(k)
}

/// Whether function fi of m compares parameter k and puts it to no use a
/// literal cannot help: spec_uses is 1.
fn spec_compared(m: Module, fi: Int, k: Int, depth: Int) -> Bool {
  spec_uses(m, fi, k, depth) == 1
}

/// What function fi of m does with parameter k, for a literal argument:
/// 1 when it compares it (an operand of str.eq or str.cmp, an Eq or Ne)
/// and every other use is neutral, 0 when every use is neutral, -1 when
/// one use gains nothing from a literal and a clone would only add code.
/// Neutral: a Str.len, a capture of a closure, and an argument of a
/// callee whose own uses are neutral or compare (depth levels down: walk
/// passes its `want` to by_for, which compares it, and to by_any, whose
/// closure captures it). Against: any other operation (a hash, a store
/// into a list or a field), or a call of a function with no body here (a
/// fault location's runtime call). A Map's generated operations hash
/// and store their key before they compare it: with compares alone,
/// CRUD's `m["id"] = ...` made 43 clones of map put, slowput and record,
/// 60 KB of its 149 KB of map code that folded nothing (2026-10-24).
fn spec_uses(m: Module, fi: Int, k: Int, depth: Int) -> Int {
  let f = m.funcs[fi]
  if k >= f.blocks[0].params.len() {
    return -1
  }
  let p = f.blocks[0].params[k]
  var r = 0
  for bl in f.blocks {
    for v in bl.instrs {
      let x = f.values[v]
      if !x.args.contains(p) {
        continue
      }
      let name = match x.aux {
        S(s) => s
        None | I(..) | F(..) | B(..) | Bs(..) | P(..) => ""
      }
      if x.op is Op.Eq | Op.Ne || (x.op == Op.Call && name is "str.eq" | "str.cmp") {
        r = 1
        continue
      }
      if x.op == Op.Closure || (x.op == Op.Call && name == "Str.len") {
        continue
      }
      if depth <= 0 || x.op != Op.Call {
        return -1
      }
      let ci = m.func_at.get(name) ?? -1
      if ci < 0 || ci == fi || m.funcs[ci].blocks.is_empty() {
        return -1
      }
      for (j, a) in x.args.indexed() {
        if a == p {
          let u = spec_uses(m, ci, j, depth - 1)
          if u < 0 {
            return -1
          }
          r = r.max(u)
        }
      }
    }
  }
  r
}

/// The key of value a of f as a constant argument: a closure of nothing
/// (its function's name) or a Str or Bytes literal; "" for anything else.
/// Int and Bool literals are not keys: the runtime passes them at most
/// call sites (budget.charge's count), they used up the clone budget on
/// functions no faster for it, and the inliner folds the small callees'
/// (2026-10-24).
fn spec_key(f: Func, a: Int) -> Str {
  let x = f.values[a]
  if x.op == Op.Closure && x.args.is_empty() {
    return match x.aux {
      S(s) => "fn ${s}"
      None | I(..) | F(..) | B(..) | Bs(..) | P(..) => ""
    }
  }
  if x.op != Op.Const {
    return ""
  }
  match x.aux {
    S(s) => "s${s.len()} ${s}"
    Bs(bs) => "b${bs.len()} ${bs.to_hex()}"
    None | I(..) | B(..) | F(..) | P(..) => ""
  }
}

/// f with parameter k the constant c (a copy of c's operation at the start
/// of the entry block, every use of the parameter its use); the parameter
/// stays, unused, so the calls keep their arguments.
fn spec_clone(f: Func, k: Int, c: Value, name: Str) -> Func {
  var g = f
  g.name = name
  // its own cache keys (the original's name another body)
  g.ckey = ""
  let p = g.blocks[0].params[k]
  let nv = g.values.len()
  g.values.push(Value{op: c.op, ty: c.ty, aux: c.aux, args: [], block: 0})
  g.blocks[0].instrs = [nv] + g.blocks[0].instrs
  for i in 0..g.values.len() {
    for j in 0..g.values[i].args.len() {
      if g.values[i].args[j] == p {
        g.values[i].args[j] = nv
      }
    }
  }
  for e in 0..g.edges.len() {
    for j in 0..g.edges[e].args.len() {
      if g.edges[e].args[j] == p {
        g.edges[e].args[j] = nv
      }
    }
  }
  for d in 0..g.dbinds.len() {
    if g.dbinds[d].value == p {
      g.dbinds[d].value = nv
    }
  }
  g
}

/// spec_callee of function ci, memoized in ok (specialize_args).
fn (b: Builder) spec_callee_at(var ok: List[Int], ci: Int) -> Bool {
  while ok.len() <= ci {
    ok.push(0)
  }
  if ok[ci] == 0 {
    // an extern (std's, decision 0388 stage 3) has no body here to copy
    ok[ci] = if !b.m.externs.contains(b.m.funcs[ci].name) && spec_callee(b.m.funcs[ci]) { 1 } else { 2 }
  }
  ok[ci] == 1
}
