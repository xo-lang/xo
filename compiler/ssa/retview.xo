// Decision 0465 step 2, part A: which functions return a view of one of
// their parameters (a Str result that is the parameter itself, a view of
// it, a view of a view, or the result of a call that returns a view of
// its argument), so a caller can treat the call as a projection of that
// argument (as rt.str_view is with view_proj) and the callee can return
// it without a count. Only functions every caller reaches directly
// qualify: an indirect one (called through a function value), one whose
// address is taken (FuncAddr, Closure), an export and an entry keep
// today's convention, since a caller that does not know the fact would
// release a result it never owned.

/// For each function, the index of the parameter its Str result is a
/// view of, or -1: a pessimistic fixed point over the call graph (a
/// recursive function qualifies when its non-recursive returns already
/// prove it; a cycle of only each other is left out).
///
/// borrowed is each function's borrowed parameters (the borrow
/// inference's): the parameter must be one, so its caller keeps it alive
/// past the call. ext holds the facts of the functions whose bodies are
/// another compilation's (std's, decision 0388), taken as they are.
pub fn return_views(funcs: List[Func], types: List[SType], fidx: Map[Str, Int], borrowed: List[List[Bool]], ext: Map[Str, Int]) -> List[Int] {
  var rvp: List[Int] = []
  var cand: List[Bool] = []
  for f in funcs {
    if let Some(p) = ext.get(f.name) {
      rvp.push(p)
      cand.push(false)
      continue
    }
    rvp.push(-1)
    cand.push(!f.indirect && !f.entry && f.export.is_empty() && f.results.len() == 1 && is_view_result(types, f.results[0]))
  }
  // a function named by a FuncAddr, a Closure or a CodeOf is reached through a value
  for f in funcs {
    for v in f.values {
      if v.op is Op.FuncAddr | Op.Closure | Op.CodeOf {
        let k = fidx.get(f.name_of(v)) ?? -1
        if k >= 0 {
          cand[k] = false
        }
      }
    }
  }
  var changed = true
  while changed {
    changed = false
    for (fi, f) in funcs.indexed() {
      if !cand[fi] || rvp[fi] >= 0 {
        continue
      }
      let p = returned_view(f, rvp, fidx, types)
      if p >= 0 && fi < borrowed.len() && p < borrowed[fi].len() && borrowed[fi][p] {
        rvp[fi] = p
        changed = true
      }
    }
  }
  rvp
}

fn is_str(types: List[SType], t: Int) -> Bool {
  t >= 0 && t < types.len() && types[t].kind == Kind.Str
}

/// Whether a result of type t can be a view of a parameter (decision 0465
/// step 3): a Str, or a tuple of Strs and scalars (Int, Float, Bool, Unit)
/// with at least one Str (mime's consume_token: `(v[0..i], v[i..])`).
pub fn is_view_result(types: List[SType], t: Int) -> Bool {
  if is_str(types, t) {
    return true
  }
  if t < 0 || t >= types.len() || types[t].kind != Kind.Tuple {
    return false
  }
  var any = false
  for e in types[t].elems {
    if is_str(types, e) {
      any = true
    } else if e < 0 || e >= types.len() || !(types[e].kind is Kind.Int | Kind.Float | Kind.Bool | Kind.Unit) {
      return false
    }
  }
  any
}

/// The mark on a Tuple that a function returning views hands back (decision
/// 0465 step 3, mark_ret_tuples): the reference counting gives it no count
/// of its own and has it borrow its fields, views of a borrowed parameter.
pub const RET_TUPLE_MARK = 4653

/// Whether value x is a marked return tuple (RET_TUPLE_MARK).
pub fn is_ret_tuple(x: Value) -> Bool {
  x.op == Op.Tuple && auxw_int(x.aux) == RET_TUPLE_MARK
}

/// Whether Tuple v of f is used once, as the value of a Return.
fn returned_only(f: Func, v: Int) -> Bool {
  var n = 0
  var ret = false
  for bl in f.blocks {
    for w in bl.instrs {
      let y = f.values[w]
      for k in 0..y.args.len() {
        if f.arg(y.args, k) == v {
          n += 1
          ret = y.op == Op.Return && k == 0
        }
      }
    }
  }
  for e in f.edges {
    if e.args.contains(v) {
      return false
    }
  }
  n == 1 && ret
}

/// Marks the Tuple each Return of a function of rvp with a tuple result
/// hands back (RET_TUPLE_MARK), after return_views decided: its caller
/// counts the fields as projections of the argument, so the callee hands
/// them back without a count.
pub fn mark_ret_tuples(var m: Module, rvp: List[Int]) {
  for fi in 0..m.funcs.len() {
    if fi >= rvp.len() || rvp[fi] < 0 || m.funcs[fi].blocks.is_empty() {
      continue
    }
    let t = m.funcs[fi].results[0]
    if t < 0 || t >= m.types.len() || m.types[t].kind != Kind.Tuple {
      continue
    }
    var f = m.funcs[fi]
    var changed = false
    for bl in f.blocks {
      if bl.instrs.is_empty() {
        continue
      }
      let r = f.values[bl.instrs[bl.instrs.len() - 1]]
      if r.op != Op.Return || r.args.is_empty() {
        continue
      }
      let a = f.arg(r.args, 0)
      if f.values[a].op == Op.Tuple {
        f.set_aux(a, Aux.I(n: RET_TUPLE_MARK))
        changed = true
      }
    }
    if changed {
      m.funcs[fi] = f
    }
  }
}

/// The parameter every Return of f returns a view of, or -1.
fn returned_view(f: Func, rvp: List[Int], fidx: Map[Str, Int], types: List[SType]) -> Int {
  var p = -1
  var any = false
  for bl in f.blocks {
    if bl.instrs.is_empty() {
      continue
    }
    let t = f.values[bl.instrs[bl.instrs.len() - 1]]
    if t.op != Op.Return {
      continue
    }
    if t.args.is_empty() {
      return -1
    }
    var seen: Map[Int, Bool] = {}
    let a = f.arg(t.args, 0)
    var q = -1
    if f.values[a].op == Op.Tuple {
      // decision 0465 step 3: every Str field a view of the same
      // parameter (or a constant), the tuple used only here
      if !returned_only(f, a) {
        return -1
      }
      q = -2
      for k in 0..f.values[a].args.len() {
        let fv = f.arg(f.values[a].args, k)
        if !is_str(types, ty_of(f.values[fv].tb)) {
          continue
        }
        var seen2: Map[Int, Bool] = {}
        let qk = view_of(f, fv, rvp, fidx, seen2)
        if qk == -1 || (qk >= 0 && q >= 0 && qk != q) {
          return -1
        }
        if qk >= 0 {
          q = qk
        }
      }
    } else {
      q = view_of(f, a, rvp, fidx, seen)
    }
    if q == -1 || (q >= 0 && any && q != p) {
      return -1
    }
    if q >= 0 {
      p = q
      any = true
    }
  }
  p
}

/// The parameter v is a view of in f, -1 for none, or -2 for a value any
/// parameter agrees with: a constant (an immortal Str, a fault path's
/// zero value), which no caller counts. seen guards a value met twice.
fn view_of(f: Func, v: Int, rvp: List[Int], fidx: Map[Str, Int], var seen: Map[Int, Bool]) -> Int {
  if v < 0 || v >= f.values.len() {
    return -1
  }
  if seen.contains(v) {
    return -2
  }
  seen[v] = true
  let x = f.values[v]
  match x.op {
    Op.Const | Op.Undef => -2
    Op.Param => {
      // the entry block's: a parameter. Not a join's (another block's
      // parameter): the counting owns a block parameter (its edges count
      // what they pass), so returning one uncounted would leak that count
      // (ssa.cln_body's `if` of b"" and a slice, 2026-11-03)
      if block_of(x.tb) != 0 {
        return -1
      }
      f.blocks[0].params.index_of(v) ?? -1
    }
    Op.Call => {
      let n = f.name_of(x)
      if n is "rt.str_view" | "rt.str_borrow" {
        if x.args.is_empty() {
          return -1
        }
        let q = view_of(f, f.arg(x.args, 0), rvp, fidx, seen)
        // a view of a constant is a constant's: not a parameter's
        return if q == -2 { -1 } else { q }
      }
      let g = fidx.get(n) ?? -1
      if g < 0 || rvp[g] < 0 || rvp[g] >= x.args.len() {
        return -1
      }
      let q = view_of(f, f.arg(x.args, rvp[g]), rvp, fidx, seen)
      if q == -2 { -1 } else { q }
    }
    _ => -1
  }
}

/// Rc.rvp of m (decision 0465 step 2): return_views when views are
/// projections (view_proj) and the pass is on (XO_PASSES=-ret_views turns
/// it off), with std's facts for the functions std compiled; else none.
fn (r: Rc) ret_views(m: Module) -> List[Int] {
  if !r.view_proj || m.passes_off.contains("ret_views") {
    return []
  }
  var ext: Map[Str, Int] = {}
  for f in m.funcs {
    if let Some(x) = m.externs.get(f.name) {
      ext[f.name] = x.ret_view
    }
  }
  return_views(m.funcs, r.types, r.fidx, r.borrowed, ext)
}
