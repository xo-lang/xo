// A constant read once per function path (2026-10-24): show.xo
// const_read reads a constant's list inline at every mention, so a loop
// that names a constant table twice an iteration (DS-2's cut_prefix
// shape: `TEXTS[i % TEXTS.len()]`) read the services record, the
// constants table and the slot four times, 45 to 49 instructions a
// mention against a local's none. A read that an earlier read of the same
// constant dominates (that read completed: built, or faulted and never
// reached here) gives that read's value; once built, a slot never
// changes until exit (consts.xo), so the two are the same list.

/// One inline constant read of f (const_read's shape): its first block,
/// its branch on the table word, the values it loaded there, its join,
/// the join's parameter that is the list (the builder's variables are
/// the join's other parameters until remove_trivial_params), the built
/// path's edge arguments with the list at pi, and the constant's index.
struct CRead {
  start: Int
  br: Int
  loads: List[Int]
  join: Int
  res: Int
  args: List[Int]
  pi: Int
  idx: Int
}

/// The inline constant reads of f, by const_read's shape: in one block a
/// static_word(CONST_SVC_WORD), its mem_load, the table word's slot_load
/// (CONST_TABLE_WORD), a compare of it with 0 that the block's branch
/// tests; the built path's mem_load of the slot's list jumping to the
/// join, whose one parameter is the list; the slot's index constant.
fn const_reads(f: Func) -> List[CRead] {
  var out: List[CRead] = []
  for b in 0..f.blocks.len() {
    let t = f.term(b)
    if t < 0 || f.values[t].op != Op.Branch || f.values[t].args.len() != 1 {
      continue
    }
    let cmp = f.values[t].args[0]
    let cv = f.values[cmp]
    if cv.op != Op.Ne || cv.block != b || cv.args.len() != 2 || const_int(f, cv.args[1]) != Some(0) {
      continue
    }
    let tw = cv.args[0]
    let tv = f.values[tw]
    if tv.op != Op.Call || tv.block != b || aux_name(tv.aux) != "rt.slot_load" || tv.args.len() != 3 || const_int(f, tv.args[1]) != Some(CONST_TABLE_WORD) {
      continue
    }
    let w = tv.args[0]
    let wv = f.values[w]
    if wv.op != Op.Call || wv.block != b || aux_name(wv.aux) != "rt.mem_load" || wv.args.is_empty() {
      continue
    }
    let sw = wv.args[0]
    let sv = f.values[sw]
    if sv.op != Op.Call || sv.block != b || aux_name(sv.aux) != "rt.static_word" || sv.args.is_empty() || const_int(f, sv.args[0]) != Some(CONST_SVC_WORD) {
      continue
    }
    // the slot's state read and the built list's load: t's other users
    var idx = -1
    var join = -1
    var res = -1
    var args: List[Int] = []
    var pi = -1
    var inner: List[Int] = []
    var ok = true
    for (vi, x) in f.values.indexed() {
      if x.block < 0 || x.args.is_empty() || x.args[0] != tw || vi == cmp {
        continue
      }
      if x.op != Op.Call {
        ok = false
        continue
      }
      let n = aux_name(x.aux)
      if n == "rt.slot_load" && x.args.len() == 3 {
        inner.push(x.block)
        match const_int(f, x.args[1]) {
          Some(k) => idx = k
          None => ok = false
        }
      } else if n == "rt.mem_load" {
        // the built path: its block jumps to the join with it
        let jt = f.term(x.block)
        if jt < 0 || f.values[jt].op != Op.Jump || f.values[jt].succs.len() != 1 {
          ok = false
          continue
        }
        let e = f.values[jt].succs[0]
        let to = f.edges[e].to
        pi = f.edges[e].args.index_of(vi) ?? -1
        if pi < 0 || pi >= f.blocks[to].params.len() {
          ok = false
          continue
        }
        inner.push(x.block)
        join = to
        res = f.blocks[to].params[pi]
        args = f.edges[e].args
      } else {
        ok = false
      }
    }
    // the loads used only within the read
    for v in [sw, w] {
      for (vi, x) in f.values.indexed() {
        if x.block >= 0 && x.args.contains(v) && vi != w && vi != tw {
          ok = false
        }
      }
    }
    // the other arguments are the builder's variables, defined before
    // the read: the start block can pass them too
    for (k, a) in args.indexed() {
      if k != pi && (inner.contains(f.values[a].block) || a == tw || a == w || a == sw || a == cmp) {
        ok = false
      }
    }
    if ok && idx >= 0 && join >= 0 {
      out.push(CRead{start: b, br: t, loads: [sw, w, tw, cmp], join: join, res: res, args: args, pi: pi, idx: idx})
    }
  }
  out
}

/// Gives each inline constant read that an earlier read of the same
/// constant dominates that read's list, its own loads and branch gone
/// (its start block jumps to its join with the list); whether any was.
pub fn reuse_const_reads(var f: Func) -> Bool {
  let reads = const_reads(f)
  if reads.len() < 2 {
    return false
  }
  let idom = dominators(f)
  var kept: List[CRead] = []
  var repl: Map[Int, Int] = {}
  var any = false
  // in the order of the blocks: an earlier read first where one
  // dominates another
  for r in reads {
    var from = -1
    for k in kept {
      if k.idx == r.idx && idom[r.start] >= 0 && dominates(idom, k.join, r.start) {
        from = k.res
      }
    }
    if from < 0 {
      kept.push(r)
      continue
    }
    any = true
    repl[r.res] = from
    // the start block jumps to the join, which no longer reads the slot
    var ins: List[Int] = []
    for v in f.blocks[r.start].instrs {
      if !r.loads.contains(v) && v != r.br {
        ins.push(v)
      }
    }
    for v in r.loads {
      f.values[v].block = -1
    }
    f.values[r.br].block = -1
    f.blocks[r.start].instrs = ins
    var jargs = r.args
    jargs[r.pi] = from
    let _j = f.jump(r.start, r.join, jargs)
  }
  if !any {
    return false
  }
  for vi in 0..f.values.len() {
    if f.values[vi].block < 0 {
      continue
    }
    var args: List[Int] = []
    for a in f.values[vi].args {
      args.push(repl.get(a) ?? a)
    }
    f.values[vi].args = args
  }
  // the removed reads' paths are unreachable now: their edges pass
  // nothing (prune keeps the edges of the blocks it drops, and the
  // reference counting's use lists read every edge's arguments)
  let live = reachable(f)
  for e in 0..f.edges.len() {
    var args: List[Int] = []
    if live[f.edges[e].from] {
      for a in f.edges[e].args {
        args.push(repl.get(a) ?? a)
      }
    }
    f.edges[e].args = args
  }
  true
}

/// Whether each block of f is reachable from the entry.
fn reachable(f: Func) -> List[Bool] {
  var reach: List[Bool] = []
  for _ in 0..f.blocks.len() {
    reach.push(false)
  }
  var stack = [0]
  reach[0] = true
  while !stack.is_empty() {
    let bl = stack.pop() ?? 0
    let t = f.term(bl)
    if t >= 0 {
      for e in f.values[t].succs {
        let to = f.edges[e].to
        if !reach[to] {
          reach[to] = true
          stack.push(to)
        }
      }
    }
  }
  reach
}

// A constant read in a loop, cached across its iterations (2026-10-24,
// DS-1's `XS[i % XS.len()]` at 30 instructions an iteration against Go's
// 13): the read that reuse_const_reads keeps still ran its fast path every
// iteration (the services record, two acquiring loads, two tests). The
// loop header carries whether the read has given a list yet, and the
// list; the read takes the list when it has, else reads as before, and
// every back edge passes true and the list read. Unlike a read before the
// loop, this sees a constant first built inside the loop; a built slot
// never changes until exit (consts.xo), and a read that faults never
// reaches a back edge.

/// The fast path's result of constant idx before loop header h: whether
/// the slot was built, and its list.
struct Pre {
  ok: Int
  list: Int
}

/// The preheader edge of loop header h: the only edge into h from a
/// block h does not dominate, that block ending in a jump to h; -1 when
/// h is not a loop header or has no such edge.
fn preheader(f: Func, idom: List[Int], h: Int) -> Int {
  var outside = -1
  var back = false
  for e in f.blocks[h].preds {
    let fr = f.edges[e].from
    if fr < 0 || idom[fr] < 0 {
      continue
    }
    if dominates(idom, h, fr) {
      back = true
    } else if outside >= 0 {
      return -1
    } else {
      outside = e
    }
  }
  if !back || outside < 0 {
    return -1
  }
  let p = f.edges[outside].from
  let t = f.term(p)
  if t < 0 || f.values[t].op != Op.Jump || f.values[t].succs.len() != 1 {
    return -1
  }
  outside
}

/// Caches each inline constant read in a loop that it runs every
/// iteration (its join dominates each back edge) in the innermost such
/// loop's header; whether any was.
pub fn cache_const_reads(var f: Func) -> Bool {
  var any = false
  var done: Map[Int, Bool] = {}
  while true {
    // the reads as f is now (each cache adds blocks and parameters)
    var next = -1
    let reads = const_reads(f)
    for (i, r) in reads.indexed() {
      if !done.contains(r.start) {
        next = i
        break
      }
    }
    if next < 0 {
      return any
    }
    let r = reads[next]
    done[r.start] = true
    let idom = dominators(f)
    if idom[r.start] < 0 {
      continue
    }
    let h = inner_loop(f, idom, r.start)
    if h < 0 {
      continue
    }
    // every back edge from a block the read's join dominates
    var ok = true
    var latches: List[Int] = []
    for e in f.blocks[h].preds {
      let fr = f.edges[e].from
      if fr >= 0 && idom[fr] >= 0 && dominates(idom, h, fr) {
        if !dominates(idom, r.join, fr) {
          ok = false
        }
        latches.push(e)
      }
    }
    if !ok || latches.is_empty() {
      continue
    }
    let e0 = preheader(f, idom, h)
    let bt = f.values[r.loads[3]].ty
    let lt = f.values[r.res].ty
    let seen = f.add_param(h, bt)
    let list = f.add_param(h, lt)
    let p = f.edges[e0].from
    let no = f.add(p, Op.Const, bt, Aux.B(b: false), [])
    let empty = f.add(p, Op.Call, lt, Aux.S(s: "rt.rl_empty"), [])
    before_jump(f, p, [no, empty])
    f.edges[e0].args = f.edges[e0].args + [no, empty]
    for e in latches {
      let fr = f.edges[e].from
      let yes = f.add(fr, Op.Const, bt, Aux.B(b: true), [])
      before_jump(f, fr, [yes])
      f.edges[e].args = f.edges[e].args + [yes, r.res]
    }
    // the read moves to a block the split makes: not cached again
    let n0 = f.blocks.len()
    if split_read(f, r, Pre{ok: seen, list: list}) {
      any = true
    }
    for nb in n0..f.blocks.len() {
      done[nb] = true
    }
  }
  any
}

/// The innermost loop header h that dominates block s with s in its loop
/// (h reachable from s) and one preheader; -1 for none.
fn inner_loop(f: Func, idom: List[Int], s: Int) -> Int {
  var seen: List[Bool] = []
  for _ in 0..f.blocks.len() {
    seen.push(false)
  }
  var stack = [s]
  seen[s] = true
  while !stack.is_empty() {
    let b = stack.pop() ?? 0
    let t = f.term(b)
    if t < 0 {
      continue
    }
    for e in f.values[t].succs {
      let to = f.edges[e].to
      if !seen[to] {
        seen[to] = true
        stack.push(to)
      }
    }
  }
  var b = s
  while b > 0 {
    if seen[b] && preheader(f, idom, b) >= 0 {
      return b
    }
    if idom[b] == b {
      break
    }
    b = idom[b]
  }
  -1
}

/// Moves vs, just added at the end of block b, before b's terminator.
fn before_jump(var f: Func, b: Int, vs: List[Int]) {
  let ins = f.blocks[b].instrs
  var out: List[Int] = []
  for v in ins {
    if !vs.contains(v) {
      out.push(v)
    }
  }
  let t = out.pop() ?? -1
  for v in vs {
    out.push(v)
  }
  out.push(t)
  f.blocks[b].instrs = out
}

/// Splits read r's start block before its loads: the block tests p.ok
/// and jumps to r's join with p.list, or goes on to the read; whether it
/// did (not when a value the join takes is defined among the loads).
fn split_read(var f: Func, r: CRead, p: Pre) -> Bool {
  let ins = f.blocks[r.start].instrs
  var k = ins.len()
  for (i, v) in ins.indexed() {
    if r.loads.contains(v) && i < k {
      k = i
    }
  }
  if k >= ins.len() {
    return false
  }
  let rest = ins[k..ins.len()]
  for (i, a) in r.args.indexed() {
    if i != r.pi && rest.contains(a) {
      return false
    }
  }
  let s2 = f.new_block()
  f.blocks[s2].instrs = rest
  for v in rest {
    f.values[v].block = s2
  }
  // the read's branch now leaves the new block
  for e in f.values[r.br].succs {
    f.edges[e].from = s2
  }
  f.blocks[r.start].instrs = ins[0..k]
  let fast = f.new_block()
  let _b = f.branch(r.start, p.ok, fast, s2)
  var jargs = r.args
  jargs[r.pi] = p.list
  let _j = f.jump(fast, r.join, jargs)
  true
}
