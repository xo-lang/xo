/// The C ABI exports (decision 0207: cabi*.xo's top level functions,
/// `xo_x_<name>`) that the native emitters call for these runtime calls,
/// or "" for a call that is not one of them. Both emitters pass an Int,
/// Bool or handle as one word, a Str as its bytes' address and length.
pub fn rt_export(name: Str) -> Str {
  match name {
    // tasks.xo's deadline of task.with_timeout (cabi.xo)
    "rt.scope_deadline" => "xo_x_scope_deadline"
    "rt.scope_timed_out" => "xo_x_scope_timed_out"
    // stop.xo's two phase shutdown (cabi.xo)
    "rt.stop_requested" => "xo_x_stop_requested"
    "rt.task_stopping" => "xo_x_stop_stopping"
    // rtsec.xo's real-time sections (cabi.xo)
    "rt.realtime_enter" => "xo_x_rt_enter"
    "rt.realtime_exit" => "xo_x_rt_exit"
    "rt.realtime_program" => "xo_x_rt_program"
    // netconn.xo's listeners and connections (cabi_net.xo)
    "rt.listener_close" => "xo_x_nc_listener_close"
    "rt.conn_write" => "xo_x_nc_conn_write"
    "rt.conn_close" => "xo_x_nc_conn_close"
    "rt.net_listen" => "xo_x_nc_listen"
    "rt.net_dial" => "xo_x_nc_dial"
    "rt.listener_accept" => "xo_x_nc_listener_accept"
    "rt.listener_addr" => "xo_x_nc_listener_addr_list"
    "rt.conn_read" => "xo_x_nc_conn_read_list"
    "rt.net_status" => "xo_x_nc_status"
    "rt.net_msg" => "xo_x_nc_msg"
    // the clock and cancellation checks (cabi.xo over poll.xo, tasks.xo,
    // selects.xo and twrun.xo)
    "rt.clock_now" => "xo_x_clock_now"
    "rt.clock_sleep" => "xo_x_clock_sleep"
    "rt.clock_sleep_or_cancel" => "xo_x_clock_sleep_or_cancel"
    "rt.select_after" => "xo_x_select_after"
    "rt.is_canceled" => "xo_x_is_canceled"
    "rt.task_deadline_left" => "xo_x_task_deadline_left"
    // the runtime's records (cabi.xo over libcmem.xo)
    "rt.heap_large" => "xo_x_heap_large"
    "rt.heap_large_resize" => "xo_x_heap_large_resize"
    "rt.heap_release" => "xo_x_heap_release"
    // standard output's flush (cabi.xo flush: stdio.xo) and
    // proc.set_grace (cabi.xo stop_set_grace: stop.xo)
    "rt.flush" => "xo_x_flush"
    "rt.set_grace" => "xo_x_stop_set_grace"
    // a fiber's task (cabi.xo fiber_run_task; sched.xo fiber_main)
    "rt.sched_run_task" => "xo_x_fiber_run_task"
    _ => ""
  }
}

/// Whether the export of rt_export(name) returns 0 for none, which the
/// emitters turn into the immortal zero handle (a handle result) or
/// empty list (a List result).
pub fn rt_export_none(name: Str) -> Bool {
  name is "rt.net_listen" | "rt.net_dial" | "rt.listener_accept" | "rt.listener_addr" | "rt.conn_read"
}

/// Whether the C runtime call rt.<name> lowers to an export of
/// native/llrt/cabi_net (rt_export's netconn rows): a body that makes one
/// sets uses_net, which builds cabi_net's exports (importer_built).
fn net_rt(name: Str) -> Bool {
  name is "listener_close" | "conn_write" | "conn_close" | "net_listen" | "net_dial" | "listener_accept" | "listener_addr" | "conn_read" | "net_status" | "net_msg"
}
