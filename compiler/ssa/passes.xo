// The passes after the build (internal/ssa build_conc.go pruneUnwind,
// landing.go addLandings, cleanup.go), stage 8 of decision 0150, printed
// at the stages `unwind`, `landings`, and `cleanup` of `xo ssadump`; the
// reference counting pass (rc) is in rc.xo.
//
// A pass works on one function at a time, moved out of the module into
// the builder's state (begin and end) so that its lists are updated in
// place. Blocks and values are indexes: removing blocks (prune) renumbers
// the blocks that stay, and renumber gives the values the IDs the Go
// builder's renumber gives (block order, parameters first).

/// Whether the value x can raise a fault by itself (selfFaults).
fn value_self_faults(f: Func, x: Value) -> Bool {
  match x.op {
    Fault => true
    Add | Sub | Mul | Neg | Div | Rem | Shl | Shr | FloatToInt => has_pos(x.lp)
    CallValue => true
    Call => {
      let name = f.name_of(x)
      if name is "list.index" | "list.set" | "list.take" | "bytes.index" | "Int.abs" {
        return has_pos(x.lp)
      }
      faulting_rt(name)
    }
    _ => false
  }
}

/// The name in an instruction's aux ("" for another aux).
fn aux_name(a: Aux) -> Str {
  match a {
    S(s) => s
    None | I(..) | F(..) | B(..) | Bs(..) | P(..) | E(..) => ""
  }
}

/// The index of the module's function x calls, or -1 (isUserCall).
fn user_callee(m: Module, f: Func, x: Value) -> Int {
  if x.op != Op.Call {
    return -1
  }
  m.func_index(f.name_of(x))
}

/// The functions that can fault: those with an operation that faults,
/// and their callers (mayFault), by function index.
/// The functions are scanned on up to m.jobs tasks, and the fault is
/// carried to callers by a work list (the sweep repeated until nothing
/// changed went over every function once per level of the call chain).
fn (m: Module) may_fault() -> List[Bool] {
  let n = m.funcs.len()
  let scans = fault_scans(m)
  var may: List[Bool] = []
  var callers: List[List[Int]] = []
  for _ in 0..n {
    callers.push([])
  }
  var work: List[Int] = []
  for (i, (mf, cs)) in scans.indexed() {
    may.push(mf)
    if mf {
      work.push(i)
    }
    for g in cs {
      callers[g].push(i)
    }
  }
  while let Some(i) = work.pop() {
    for c in callers[i] {
      if !may[c] {
        may[c] = true
        work.push(c)
      }
    }
  }
  may
}

/// Whether function fi has an operation that faults, and the user
/// functions it calls (may_fault's scan of one function), from its body
/// facts when it is not decoded (decision 0283 stage B).
fn fault_scan(m: Module, fi: Int) -> (Bool, List[Int]) { m.fault_facts(fi) }

/// fault_scan of every function, on up to m.jobs tasks, in order.
fn fault_scans(m: Module) -> List[(Bool, List[Int])] {
  let n = m.funcs.len()
  if m.jobs <= 1 || n < 512 || target.arch == TargetArch.Wasm32 {
    var out: List[(Bool, List[Int])] = []
    for fi in 0..n {
      out.push(fault_scan(m, fi))
    }
    return out
  }
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..m.jobs.min((n + 255) / 256) {
      ts.push(s.spawn(fn() -> List[(Int, List[(Bool, List[Int])])] {
        var mine: List[(Int, List[(Bool, List[Int])])] = []
        while true {
          let i = next.add(256) - 256
          if i >= n {
            break
          }
          var part: List[(Bool, List[Int])] = []
          for fi in i..(i + 256).min(n) {
            part.push(fault_scan(m, fi))
          }
          mine.push((i, part))
        }
        mine
      }))
    }
    var all: List[(Int, List[(Bool, List[Int])])] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[(Bool, List[Int])] = []
  for (_, part) in done.sort_by(fn(x) { x.0 }) {
    out = out + part
  }
  out
}

/// Whether value x of function f, once built, can fault (raises).
fn raises(m: Module, f: Func, x: Value, faults: List[Bool]) -> Bool {
  if x.op == Op.CallValue && f.values[f.arg(x.args, 0)].op == Op.Closure {
    let g = m.func_index(f.name_of(f.values[f.arg(x.args, 0)]))
    if g >= 0 && m.funcs[g].catches {
      // it returns on a fault
      return false
    }
  }
  if value_self_faults(f, x) {
    return true
  }
  let g = user_callee(m, f, x)
  if g >= 0 {
    return faults[g]
  }
  false
}

// ---------------------------------------------------------------------------
// pruneUnwind

/// Removes the checks nothing can take: after calls of functions that can
/// neither be canceled nor fault (pruneUnwind); a check only a fault takes
/// becomes `rt.landing`.
pub fn (var b: Builder) prune_unwind() {
  let n = b.m.funcs.len()
  var may: List[Bool] = []
  for _ in 0..n {
    may.push(false)
  }
  // each check's callee by index (-1 for none or not a function of m)
  var gs: List[Int] = List.with_capacity(b.checks.len())
  // whose cancel bit each check takes: its callee's, or the closure
  // literal's that a prelude walk was given (walk_literal)
  var ds: List[Int] = List.with_capacity(b.checks.len())
  for c in b.checks {
    let g = if c.callee.is_empty() { -1 } else { b.m.func_index(c.callee) }
    gs.push(g)
    let l = if g >= 0 { walk_literal(b.m, c) } else { -1 }
    ds.push(if l >= 0 { l } else { g })
  }
  if b.conc {
    // a function may be canceled when it has a check of no callee, or
    // calls one that may: from those, up the callers (a worklist; the
    // fixpoint over every check walked them all once a round, 15 ms of
    // an HTTP server edit)
    var callers: List[List[Int]] = []
    for _ in 0..n {
      callers.push([])
    }
    var work: List[Int] = []
    for (ci, c) in b.checks.indexed() {
      if c.callee.is_empty() {
        if !may[c.fi] {
          may[c.fi] = true
          work.push(c.fi)
        }
      } else if ds[ci] >= 0 {
        callers[ds[ci]].push(c.fi)
      }
    }
    // a std extern may be canceled as its facts say (decision 0388)
    for fi in 0..n {
      if let Some(x) = b.m.externs.get(b.m.funcs[fi].name) {
        if x.cancels && !may[fi] {
          may[fi] = true
          work.push(fi)
        }
      }
    }
    while let Some(i) = work.pop() {
      for f in callers[i] {
        if !may[f] {
          may[f] = true
          work.push(f)
        }
      }
    }
  }
  let faults = b.m.may_fault()
  b.unwind_faults = faults
  b.unwind_may = may
  if b.keep_unwind_names {
    for i in 0..n {
      b.unwind_names[b.m.funcs[i].name] = (faults[i], may[i])
    }
  }
  for (ci, c) in b.checks.indexed() {
    let g = gs[ci]
    if b.conc && (c.callee.is_empty() || (ds[ci] >= 0 && may[ds[ci]])) {
      continue
    }
    if c.callee.is_empty() || (g >= 0 && faults[g]) {
      b.m.funcs[c.fi].values[c.u].aux = b.m.funcs[c.fi].pack(Aux.S(s: "rt.landing"))
      continue
    }
    b.drop_check(c.fi, c.u, c.w)
  }
  for fi in 0..n {
    if b.m.funcs[fi].catches && !(b.conc && may[fi]) {
      hand_back_zero(b.m.funcs[fi])
    }
  }
}

/// For a check after a call of a prelude method that takes a function
/// value as its last parameter and calls nothing else that waits
/// (callback_walk's walks, and fn_param_only's: filter_map, sort_by,
/// group_by, Option.map and and_then, Result.map and map_err, the Str and
/// Bytes *_where and map_runes methods), given a closure literal: the
/// literal's function, else -1.
/// Such a method waits only in calls of its function value, so whether
/// the caller may be canceled is the literal's, as for a literal called in
/// place (UCheck callee, Builder.check). Without it every walk counted as
/// a cancellation point, and a Mutex.with body that mapped a list kept the
/// value it was given for an unwind, so its first write copied it
/// (gotchas/with-body-cancelable-through-closure-call.md).
fn walk_literal(m: Module, c: UCheck) -> Int {
  let base = c.callee.split("[")[0]
  if !callback_walk(c.callee).0 && !fn_param_only(base) {
    return -1
  }
  let f = m.funcs[c.fi]
  if c.w < 0 || c.w >= f.values.len() {
    return -1
  }
  let x = f.values[c.w]
  if x.op != Op.Call || f.name_of(x) != c.callee || x.args.is_empty() {
    return -1
  }
  // the function value is the method's last parameter
  let a = f.values[f.arg(x.args, x.args.len() - 1)]
  if a.op != Op.Closure {
    return -1
  }
  m.func_index(f.name_of(a))
}

/// The prelude methods outside callback_walk whose only call that may
/// wait is of their last parameter, a function value (std/native/prelude.xo;
/// not walk_dir, which does I/O). Std code mapped an Option inside a
/// Mutex.with body and had to hoist the closure (wbody2, 2026-11-06).
fn fn_param_only(base: Str) -> Bool {
  base is "prelude.list_filter_map" | "prelude.list_sort_by" | "prelude.list_group_by" | "prelude.list_map_sized" | "prelude.list_sort_in_place_by" | "prelude.list_sort_with" | "prelude.list_sort_in_place_with" | "prelude.list_sort_by_desc" | "prelude.list_sort_in_place_by_desc" | "prelude.option_map" | "prelude.option_and_then" | "prelude.result_map" | "prelude.result_map_err" | "prelude.where_index" | "prelude.where_last_index" | "prelude.where_trim_left" | "prelude.where_trim_right" | "prelude.where_spans" | "prelude.str_find_where" | "prelude.str_rfind_where" | "prelude.str_contains_where" | "prelude.str_split_where" | "prelude.str_trim_start_where" | "prelude.str_trim_end_where" | "prelude.str_trim_where" | "prelude.str_map_runes" | "prelude.bytes_split_where" | "prelude.bytes_trim_where" | "prelude.bytes_trim_start_where" | "prelude.bytes_trim_end_where" | "prelude.bytes_find_where" | "prelude.bytes_rfind_where" | "prelude.bytes_contains_where" | "prelude.bytes_map_runes"
}

/// A `Mutex.with` closure that cannot be canceled hands back a zero value
/// when a fault unwinds out of it, not the value it was given: the fault
/// poisons the mutex (decision 0482), so nothing reads what it hands back,
/// and the value it was given no longer stays alive while the closure
/// changes it (its first write to a list or map copied it). An `Err`
/// still hands that value back (packed_value), and so does a cancellation
/// of a closure that can be canceled. The zero is finish_fn's, the value
/// of the same type in the unwind exit.
fn hand_back_zero(var f: Func) {
  let ex = f.unwind_exit
  if ex < 0 || f.blocks.is_empty() || f.blocks[0].params.len() < 2 || ex >= f.blocks.len() {
    return
  }
  let orig = f.blocks[0].params[1]
  let ins = f.blocks[ex].instrs
  if ins.is_empty() {
    return
  }
  let ret = ins[ins.len() - 1]
  if f.values[ret].op != Op.Return || f.values[ret].args.len() != 1 {
    return
  }
  let t = f.arg(f.values[ret].args, 0)
  if f.values[t].op != Op.Tuple || f.values[t].args.len() != 2 || f.arg(f.values[t].args, 1) != orig {
    return
  }
  for v in ins {
    if v == t {
      return
    }
    if v != orig && ty_of(f.values[v].tb) == ty_of(f.values[orig].tb) {
      f.set_arg(t, 1, v)
      return
    }
  }
}

/// Removes check u of function fi (and w's landing on it): its branch
/// becomes a jump to the normal successor.
fn (var b: Builder) drop_check(fi: Int, u: Int, w: Int) {
  if w >= 0 && pad_of(b.m.funcs[fi].values[w].pi) == u {
    b.m.funcs[fi].values[w].pi = with_pad(b.m.funcs[fi].values[w].pi, -1)
  }
  let bl = block_of(b.m.funcs[fi].values[u].tb)
  let br = b.m.funcs[fi].term(bl)
  let yes = succ(b.m.funcs[fi].values[br], 0)
  let no = succ(b.m.funcs[fi].values[br], 1)
  let to = b.m.funcs[fi].edges[yes].to
  var preds: List[Int] = []
  for e in b.m.funcs[fi].blocks[to].preds {
    if e != yes {
      preds.push(e)
    }
  }
  b.m.funcs[fi].blocks[to].preds = preds
  b.m.funcs[fi].values[br].op = Op.Jump
  b.m.funcs[fi].set_args(br, [])
  b.m.funcs[fi].values[br].set_succs([no])
  var ins: List[Int] = []
  for v in b.m.funcs[fi].blocks[bl].instrs {
    if v != u {
      ins.push(v)
    }
  }
  b.m.funcs[fi].blocks[bl].instrs = ins
}

/// Folds the calls of functions that only return an integer or Bool
/// constant the build's target decided (Func.target: std/native/llrt's
/// `layer()`, whose `match target.os` the builder resolved, and
/// sanhook's `tsan()` on Windows; not every constant function, which
/// would change more code than this needs): each call
/// becomes the constant, and a negation of a constant, an equality of two
/// constants, and a branch on a constant are folded after it, so the
/// arms for other targets are unreachable and cleanup drops them. Without
/// it, a module of a split LLVM build (and any build at O0) kept the
/// darwin arms' calls of pthread and mmap, which a Windows link cannot
/// resolve (gotchas/windows-llvm-split-link.md). Calls with a landing
/// check left are kept.
pub fn (var b: Builder) fold_known_calls() {
  var known: Map[Int, Aux] = {}
  for fi in 0..b.m.funcs.len() {
    if let Some(n) = known_result(b.m.funcs[fi]) {
      known[fi] = n
    }
  }
  b.fold_known = known
  if b.keep_unwind_names {
    for (fi, a) in known {
      b.known_names[b.m.funcs[fi].name] = a
    }
  }
  if known.is_empty() {
    return
  }
  for fi in 0..b.m.funcs.len() {
    var hit = false
    for vi in 0..b.m.funcs[fi].values.len() {
      let v = b.m.funcs[fi].values[vi]
      if v.op != Op.Call || !v.args.is_empty() || pad_of(v.pi) >= 0 || block_of(v.tb) < 0 {
        continue
      }
      if let Some(a) = known.get(user_callee(b.m, b.m.funcs[fi], v)) {
        b.m.funcs[fi].values[vi].op = Op.Const
        b.m.funcs[fi].values[vi].aux = b.m.funcs[fi].pack(a)
        hit = true
      }
    }
    if hit {
      var f = b.m.funcs[fi]
      b.m.funcs[fi] = Func{name: ""}
      let _c = fold_const_branches(f)
      b.m.funcs[fi] = f
    }
  }
}

/// The integer or Bool constant function f returns when its body is only
/// that: no parameters, and from the entry a chain of jumps through
/// blocks of constants to a return of a constant (directly or through the
/// block parameters the jumps bind, as the builder leaves a `match`).
fn known_result(f: Func) -> Option[Aux] {
  if !f.target || f.blocks.is_empty() || !f.blocks[0].params.is_empty() || f.indirect || f.entry || !f.export.is_empty() || !f.var_params.is_empty() || !f.captures.is_empty() {
    return None
  }
  // the block parameters bound so far, to the constants they hold
  var bound: Map[Int, Int] = {}
  var bl = 0
  for _ in 0..16 {
    let ins = f.blocks[bl].instrs
    if ins.is_empty() {
      return None
    }
    for i in 0..ins.len() - 1 {
      if f.values[ins[i]].op != Op.Const {
        return None
      }
    }
    let t = f.values[ins[ins.len() - 1]]
    match t.op {
      Op.Jump => {
        let e = f.edges[succ(t, 0)]
        let ps = f.blocks[e.to].params
        if e.args.len() != ps.len() {
          return None
        }
        for i in 0..ps.len() {
          let a = bound.get(e.args[i]) ?? e.args[i]
          if f.values[a].op != Op.Const {
            return None
          }
          bound[ps[i]] = a
        }
        bl = e.to
      }
      Op.Return => {
        if t.args.len() != 1 {
          return None
        }
        let r = f.values[bound.get(f.arg(t.args, 0)) ?? f.arg(t.args, 0)]
        if r.op != Op.Const {
          return None
        }
        if let I(n) = r.aux {
          return Some(Aux.I(n: n))
        }
        if let B(x) = r.aux {
          return Some(Aux.B(b: x))
        }
        return None
      }
      _ => return None
    }
  }
  None
}

/// fold_const_branches, then prune_func when a branch became a jump; whether
/// one did. The native inliner runs it after its constant folding
/// (2026-10-19: checked_mul inlined `ints.fits(2, a, b)`, and its `op ==
/// 0`, `op == 1` tests stayed, the constants hoisted and spilled, in the
/// loop).
pub fn fold_branches(var f: Func) -> Bool {
  // a function with landings folds only the branches that leave every
  // reached value's landing check reached (fold_const_branches): one
  // that did not failed the inlined module's verification (windows.fix:
  // a value landing on a check that was no longer one, 2026-10-20)
  if !fold_const_branches(f) {
    return false
  }
  prune_func(f)
  true
}

/// Folds the negations of a Bool constant, the integer equalities of two
/// constants, and the branches on a constant of f into constants and jumps (the edge not taken leaves its
/// target's predecessors; prune_func drops what became unreachable).
/// Whether a branch became a jump.
fn fold_const_branches(var f: Func) -> Bool {
  var changed = false
  for vi in 0..f.values.len() {
    let v = f.values[vi]
    if v.op == Op.Not && block_of(v.tb) >= 0 && v.args.len() == 1 && f.values[f.arg(v.args, 0)].op == Op.Const {
      if let B(x) = f.values[f.arg(v.args, 0)].aux {
        f.values[vi].op = Op.Const
        f.values[vi].aux = f.pack(Aux.B(b: !x))
        f.set_args(vi, [])
      }
      continue
    }
    if block_of(v.tb) < 0 || v.args.len() != 2 || !(v.op is Op.Eq | Op.Ne | Op.Lt | Op.Le | Op.Gt | Op.Ge) {
      continue
    }
    if let Some(x) = const_word(f, f.arg(v.args, 0)) {
      if let Some(y) = const_word(f, f.arg(v.args, 1)) {
        // an ordering only of two constants at least 0, which order the
        // same signed or not (an unsigned type's word above 2^63 is
        // negative as Int's; 2026-10-20: ints.u64_rem's `b > 0` stayed a
        // compare of two constants in portable u64's loop)
        if !(v.op is Op.Eq | Op.Ne) && (x < 0 || y < 0) {
          continue
        }
        let r = match v.op {
          Eq => x == y
          Ne => x != y
          Lt => x < y
          Le => x <= y
          Gt => x > y
          _ => x >= y
        }
        f.values[vi].op = Op.Const
        f.values[vi].aux = f.pack(Aux.B(b: r))
        f.set_args(vi, [])
      }
    }
  }
  for bl in 0..f.blocks.len() {
    let t = f.term(bl)
    if t < 0 || f.values[t].op != Op.Branch || succ_n(f.values[t]) != 2 {
      continue
    }
    let cv = f.values[f.arg(f.values[t].args, 0)]
    if cv.op != Op.Const {
      continue
    }
    var taken = -1
    if let B(x) = cv.aux {
      taken = if x { 0 } else { 1 }
    }
    if taken < 0 {
      continue
    }
    let keep = f.values[t].succs()[taken]
    let drop = f.values[t].succs()[1 - taken]
    if !pads_reached(f, t, keep) {
      continue
    }
    let to = f.edges[drop].to
    var preds: List[Int] = []
    for e in f.blocks[to].preds {
      if e != drop {
        preds.push(e)
      }
    }
    f.blocks[to].preds = preds
    f.values[t].op = Op.Jump
    f.set_args(t, [])
    f.values[t].set_succs([keep])
    changed = true
  }
  changed
}

/// Whether, with branch t taking only edge keep, the landing check of
/// every value in a reached block is in a reached block (chain_pads lets
/// calls share a check, so one on the edge not taken can be the landing
/// of a value that stays).
pub fn pads_reached(f: Func, t: Int, keep: Int) -> Bool {
  let n = f.blocks.len()
  var reach: List[Bool] = []
  for _ in 0..n {
    reach.push(false)
  }
  var stack = [0]
  reach[0] = true
  while !stack.is_empty() {
    let bl = stack.pop() ?? 0
    let tt = f.term(bl)
    if tt >= 0 {
      let ss = if tt == t { [keep] } else { f.values[tt].succs() }
      for e in ss {
        let to = f.edges[e].to
        if !reach[to] {
          reach[to] = true
          stack.push(to)
        }
      }
    }
  }
  for bl in 0..n {
    if !reach[bl] {
      continue
    }
    for v in f.blocks[bl].instrs {
      let w = pad_of(f.values[v].pi)
      if w >= 0 {
        let wb = block_of(f.values[w].tb)
        if wb < 0 || !reach[wb] {
          return false
        }
      }
    }
  }
  true
}

/// const_int through IntConv, the same word as another integer type
/// (2026-10-20: a UInt64 literal passed to ints.u64_rem's Int parameter
/// left `b > 0` unfolded in portable u64's loop).
fn const_word(f: Func, v: Int) -> Option[Int] {
  var x = v
  for _ in 0..8 {
    if f.values[x].op != Op.IntConv || f.values[x].args.len() != 1 {
      break
    }
    x = f.arg(f.values[x].args, 0)
  }
  const_int(f, x)
}

/// The integer constant value v of f, or None.
fn const_int(f: Func, v: Int) -> Option[Int] {
  let x = f.values[v]
  if x.op != Op.Const {
    return None
  }
  if let I(n) = x.aux {
    return Some(n)
  }
  None
}

// ---------------------------------------------------------------------------
// addLandings

/// Gives every operation that can fault and has no landing yet a check
/// whose cleanup goes to the function's unwind exit (addLandings).
///
/// The rest of a split block is filled when the walk reaches it (lazy:
/// its instructions are those of src from off up to its own first
/// operation that can fault), so each instruction moves once: copying the
/// whole rest at every split was quadratic in the operations of a block
/// (examples/notes-service: 1.4 s of every build, 2026-10-15). The blocks
/// are made in the same order as before.
pub fn (var b: Builder) add_landings() {
  let _g = b.add_landings_with(b.m.may_fault(), {})
}

/// add_landings with may_fault's result from the caller, which the
/// cleanup cache's keys hash (decision 0382: the pass and the keys read
/// one list), leaving the functions in skip as they are (their cached
/// form stands in for them). Returns, per function, whether its landings
/// grew the module or the builder (a type, a function, a generated body,
/// fe_fixed's counts): a cached form cannot stand in for such a function,
/// as skipping it would change what the module grows next.
pub fn (var b: Builder) add_landings_with(faults: List[Bool], skip: Map[Int, Bool]) -> List[Bool] {
  let n = b.m.funcs.len()
  var grew: List[Bool] = []
  for fi in 0..n {
    if skip.contains(fi) {
      grew.push(false)
      continue
    }
    let before = "${b.m.types.len()} ${b.m.funcs.len()} ${b.fe_fixed()}"
    let saved = b.begin(fi, -1)
    var lazy_src: Map[Int, List[Int]] = {}
    var lazy_off: Map[Int, Int] = {}
    var bi = 0
    while bi < b.s.f.blocks.len() {
      let lazy = lazy_src.contains(bi)
      let src = if lazy { lazy_src.get(bi) ?? [] } else { b.s.f.blocks[bi].instrs }
      let off = lazy_off.get(bi) ?? 0
      var end = src.len()
      var at = -1
      var i = off
      while i < src.len() {
        let x = b.s.f.values[src[i]]
        if pad_of(x.pi) < 0 && !is_terminator(x.op) && raises(b.m, b.s.f, x, faults) {
          at = i
          end = i + 1
          break
        }
        i += 1
      }
      if lazy || at >= 0 {
        b.s.f.blocks[bi].instrs = src[off..end]
      }
      if lazy {
        for k in off..end {
          let v = src[k]
          b.s.f.values[v].tb = with_block(b.s.f.values[v].tb, bi)
          for e in b.s.f.values[v].succs() {
            b.s.f.edges[e].from = bi
          }
        }
        lazy_src.remove(bi)
      }
      if at >= 0 {
        let rest = b.land_at(bi, src[at])
        lazy_src[rest] = src
        lazy_off[rest] = at + 1
      }
      bi += 1
    }
    b.end(saved)
    grew.push("${b.m.types.len()} ${b.m.funcs.len()} ${b.fe_fixed()}" != before)
  }
  b.run_gens()
  grew
}

/// Ends block bl, whose last instruction is w, with a check only a fault
/// takes, whose cleanup goes to the unwind exit, and returns the new
/// block for the rest of the block, which add_landings fills (landAt).
fn (var b: Builder) land_at(bl: Int, w: Int) -> Int {
  let rest = b.s.f.new_block()
  b.s.f.land_rest[rest] = true
  let u = b.s.f.add(bl, Op.Call, b.bool_t(), Aux.S(s: "rt.landing"), [])
  b.s.f.values[w].pi = with_pad(b.s.f.values[w].pi, u)
  let pad = b.s.f.new_block()
  b.s.f.branch(bl, u, pad, rest)
  let exit = b.unwind_exit()
  b.s.f.jump(pad, exit, [])
  rest
}

/// The pad of an operation that can fault whose landing mark_landings
/// left to rc_func (XO_LAZY_LANDINGS): land_func makes it just before
/// the function's reference counting, so the module never holds every
/// function's landings at once (they are 59% of the values and 98% of
/// the blocks of arithmetic code, and prune_landings removes most of
/// them again).
pub const PAD_LAZY = -2

/// add_landings_with for lazy landings: marks every operation that can
/// fault and has no landing PAD_LAZY and makes the unwind exit of each
/// function with one, splitting no block. Returns what
/// add_landings_with does.
pub fn (var b: Builder) mark_landings(faults: List[Bool], skip: Map[Int, Bool]) -> List[Bool] {
  let n = b.m.funcs.len()
  var grew: List[Bool] = []
  b.m.land_bool = b.bool_t()
  for fi in 0..n {
    if skip.contains(fi) {
      grew.push(false)
      continue
    }
    let before = "${b.m.types.len()} ${b.m.funcs.len()} ${b.fe_fixed()}"
    let saved = b.begin(fi, -1)
    if b.mark_lazy(faults) {
      b.s.f.lazy_lands = true
      let _e = b.unwind_exit()
      // the exit's own blocks, as add_landings walks them
      let _m = b.mark_lazy(faults)
    }
    b.end(saved)
    grew.push("${b.m.types.len()} ${b.m.funcs.len()} ${b.fe_fixed()}" != before)
  }
  grew
}

/// Marks the operations of the current function that can fault and have
/// no landing PAD_LAZY; whether it marked one.
fn (var b: Builder) mark_lazy(faults: List[Bool]) -> Bool {
  var any = false
  for bi in 0..b.s.f.blocks.len() {
    for v in b.s.f.blocks[bi].instrs {
      let x = b.s.f.values[v]
      if pad_of(x.pi) == -1 && !is_terminator(x.op) && raises(b.m, b.s.f, x, faults) {
        b.s.f.values[v].pi = with_pad(x.pi, PAD_LAZY)
        any = true
      }
    }
  }
  any
}

/// Makes f's PAD_LAZY landings, as add_landings_with's walk does (each
/// instruction moves once).
pub fn land_func(var f: Func, bool_t: Int) {
  if !f.lazy_lands {
    return
  }
  f.lazy_lands = false
  var lazy_src: Map[Int, List[Int]] = {}
  var lazy_off: Map[Int, Int] = {}
  var bi = 0
  while bi < f.blocks.len() {
    let lazy = lazy_src.contains(bi)
    let src = if lazy { lazy_src.get(bi) ?? [] } else { f.blocks[bi].instrs }
    let off = lazy_off.get(bi) ?? 0
    var end = src.len()
    var at = -1
    var i = off
    while i < src.len() {
      if pad_of(f.values[src[i]].pi) == PAD_LAZY {
        at = i
        end = i + 1
        break
      }
      i += 1
    }
    if lazy || at >= 0 {
      f.blocks[bi].instrs = src[off..end]
    }
    if lazy {
      for k in off..end {
        let v = src[k]
        f.values[v].tb = with_block(f.values[v].tb, bi)
        for e in f.values[v].succs() {
          f.edges[e].from = bi
        }
      }
      lazy_src.remove(bi)
    }
    if at >= 0 {
      let w = src[at]
      let rest = f.new_block()
      f.land_rest[rest] = true
      let u = f.add(bi, Op.Call, bool_t, Aux.S(s: "rt.landing"), [])
      f.values[w].pi = with_pad(f.values[w].pi, u)
      let pad = f.new_block()
      f.branch(bi, u, pad, rest)
      f.jump(pad, f.unwind_exit, [])
      lazy_src[rest] = src
      lazy_off[rest] = at + 1
    }
    bi += 1
  }
}

/// The function's unwind exit, made when it has none: it hands a fault on
/// and returns zero values (unwindExit).
fn (var b: Builder) unwind_exit() -> Int {
  if b.s.f.unwind_exit >= 0 {
    return b.s.f.unwind_exit
  }
  if b.s.f.catches {
    b.s.pack_orig = b.param(1)
  }
  b.s.unwind_b = b.s.f.new_block()
  let cur = b.s.cur
  b.finish_fn()
  b.s.cur = cur
  b.s.f.unwind_exit
}

// ---------------------------------------------------------------------------
// cleanup

/// Prunes the blocks unreachable from the entry, removes trivial block
/// parameters, and renumbers (Func.cleanup).
/// f after cleanup_func.
fn cleaned(f0: Func) -> Func {
  var f = f0
  cleanup_func(f)
  f
}

fn cleanup_func(var f: Func) {
  // a constant read again where a read of it dominates (constreuse.xo)
  let _c = reuse_const_reads(f)
  // and a read in a loop cached across its iterations (constreuse.xo)
  let _cc = cache_const_reads(f)
  prune_func(f)
  remove_trivial_params(f)
  renumber(f)
}

/// Removes the blocks unreachable from the entry and the edges from them
/// (prune).
fn prune_func(var f: Func) {
  let n = f.blocks.len()
  var reach: List[Bool] = []
  for _ in 0..n {
    reach.push(false)
  }
  var stack = [0]
  reach[0] = true
  if f.lazy_lands && f.unwind_exit > 0 && !reach[f.unwind_exit] {
    reach[f.unwind_exit] = true
    stack.push(f.unwind_exit)
  }
  while !stack.is_empty() {
    let bl = stack.pop() ?? 0
    let t = f.term(bl)
    if t >= 0 {
      for e in f.values[t].succs() {
        let to = f.edges[e].to
        if !reach[to] {
          reach[to] = true
          stack.push(to)
        }
      }
    }
  }
  for i in 0..n {
    if !reach[i] {
      continue
    }
    var preds: List[Int] = []
    for e in f.blocks[i].preds {
      if reach[f.edges[e].from] {
        preds.push(e)
      }
    }
    f.blocks[i].preds = preds
  }
  remove_blocks(f, reach)
}

/// Joins each block that ends in a jump to a block reached by that jump
/// alone (not the entry, the unwind exit, or a block split off after a
/// check) with that block, when no parameter of it is a heap value of m
/// (the references held on each edge, which verify checks, are by value:
/// an owned parameter replaced by its argument broke them): its
/// parameters become the jump's arguments.
/// After inlining, a one block callee left its caller's block in three
/// (the call's block, the copy, the continuation), and the passes that
/// look within an SSA block (the arm64 address fold, the reload memo,
/// adc pairs) saw each helper call's operations apart: bigmod's
/// ld(t, o + 8) loads each a register offset (2026-10-17). Neither block
/// may make a call (calls[b], the caller's say: an intrinsic emitted in
/// line is none): a joined block that a value lives across a call in
/// took a callee saved register for it, a frame where there was none
/// (obj.rs_new_n's slow path joined to its tail: text 1.01 to 1.02x).
/// Reports whether it joined any.
pub fn merge_straight(var f: Func, m: Module, calls: List[Bool]) -> Bool {
  let nb = f.blocks.len()
  var keep: List[Bool] = []
  for _ in 0..nb {
    keep.push(true)
  }
  var repl: Map[Int, Int] = {}
  var any = false
  for a in 0..nb {
    if !keep[a] {
      continue
    }
    var steps = 0
    while steps < nb {
      steps += 1
      let t = f.term(a)
      if t < 0 || f.values[t].op != Op.Jump {
        break
      }
      let e = succ(f.values[t], 0)
      let b = f.edges[e].to
      if b == a || b == 0 || b < 0 || !keep[b] || f.blocks[b].preds.len() != 1 || b == f.unwind_exit || f.land_rest.contains(b) || calls[a] || calls[b] {
        break
      }
      // nothing joins a join (two or more predecessors): the emitter
      // copies a small join and its test into each predecessor (a
      // compare's -1, 0, 1 tested at once), and grown it was too big to
      // copy (bench/perf/xo sortpt 1.025x on Linux)
      var plain = true
      for p in f.blocks[b].params {
        plain = plain && !m.heap(ty_of(f.values[p].tb))
      }
      if !plain {
        break
      }
      for (i, p) in f.blocks[b].params.indexed() {
        repl[p] = f.edges[e].args[i]
      }
      let n = f.blocks[a].instrs.len()
      var ins = f.blocks[a].instrs[0..n - 1]
      for v in f.blocks[b].instrs {
        f.values[v].tb = with_block(f.values[v].tb, a)
        for se in f.values[v].succs() {
          f.edges[se].from = a
        }
        ins.push(v)
      }
      f.blocks[a].instrs = ins
      f.blocks[b].instrs = []
      f.blocks[b].params = []
      f.blocks[b].preds = []
      keep[b] = false
      any = true
    }
  }
  if !any {
    return false
  }
  if !repl.is_empty() {
    for bl in 0..f.blocks.len() {
      if !keep[bl] {
        continue
      }
      for v in f.blocks[bl].instrs {
        for i in 0..f.values[v].args.len() {
          f.set_arg(v, i, find_repl(repl, f.arg(f.values[v].args, i)))
        }
        for se in f.values[v].succs() {
          for i in 0..f.edges[se].args.len() {
            f.edges[se].args[i] = find_repl(repl, f.edges[se].args[i])
          }
        }
      }
    }
    for k in 0..f.dbinds.len() {
      f.dbinds[k].value = find_repl(repl, f.dbinds[k].value)
    }
  }
  remove_blocks(f, keep)
  true
}

/// Replaces a pure operation by an identical one that dominates it
/// (Go's cse pass: arithmetic, a field or tag of a value, with
/// a type that is not counted, so no retain or release pairs with it).
/// An earlier twin that faulted (overflow) never let control reach the
/// later one. A length call is pure too, and so is an element read
/// (list.index: a list is a value) whose counted result, its twin's
/// too, is only ever read from (borrow_only): no count moves with it
/// (2026-10-24: `XS[i % XS.len()]` read the constant's list twice, so
/// the index was not seen to be below its length). False when nothing
/// changed.
pub fn cse(var f: Func, m: Module) -> Bool {
  if f.blocks.is_empty() {
    return false
  }
  let idom = dominators(f)
  var seen: List[Bool] = []
  for _ in 0..f.blocks.len() {
    seen.push(false)
  }
  var post: List[Int] = []
  dom_walk(f, 0, seen, post)
  var have: Map[Str, List[Int]] = {}
  var repl: Map[Int, Int] = {}
  var dead: Map[Int, Bool] = {}
  // values used other than as a list read's or length's operand, once a
  // counted element read is met
  var shared: Map[Int, Bool] = {}
  var scanned = false
  var i = post.len() - 1
  while i >= 0 {
    let b = post[i]
    i -= 1
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      let call = if x.op == Op.Call { cse_call(f.aux(x)) } else { "" }
      if call.is_empty() && (!cse_op(x.op) || ty_of(x.tb) < 0 || m.heap(ty_of(x.tb))) {
        continue
      }
      if !call.is_empty() && ty_of(x.tb) >= 0 && m.heap(ty_of(x.tb)) {
        if call != "list.index" {
          continue
        }
        if !scanned {
          shared = read_only_uses(f)
          scanned = true
        }
        if shared.contains(v) {
          continue
        }
      }
      // one with a landing stays (its block branches on the landing);
      // it may still be the twin a later one takes
      let lands = pad_of(x.pi) >= 0
      var key = "${op_name(x.op)} ${ty_of(x.tb)}"
      match f.aux(x) {
        None => {}
        I(n) => key = "${key} #${n}"
        P(t, fl) => key = "${key} #${t}.${fl}"
        S(n) => if call.is_empty() {
          continue
        } else {
          key = "${key} ${n}"
        }
        F(..) | B(..) | Bs(..) | E(..) => continue
      }
      // a constant operand by its value: each use site has its own Const
      var args: List[Str] = []
      var ok = true
      for a0 in f.args_iter(x.args) {
        let a = find_repl(repl, a0)
        let y = f.values[a]
        if y.op == Op.Const {
          match y.aux {
            I(n) => args.push("k${ty_of(y.tb)}=${n}")
            B(t) => args.push("k${ty_of(y.tb)}=${t}")
            None | F(..) | S(..) | Bs(..) | P(..) | E(..) => ok = false
          }
        } else {
          args.push("v${a}")
        }
      }
      if !ok {
        continue
      }
      if args.len() == 2 && cse_commutes(x.op) && args[1] < args[0] {
        args = [args[1], args[0]]
      }
      for a in args {
        key = "${key} ${a}"
      }
      let prev = have.get(key) ?? []
      var hit = -1
      for u in prev {
        let ub = block_of(f.values[u].tb)
        if ub == b || dominates(idom, ub, b) {
          hit = u
          break
        }
      }
      if hit >= 0 && !lands {
        repl[v] = hit
        dead[v] = true
      } else if hit < 0 {
        var next = prev
        next.push(v)
        have[key] = next
      }
    }
  }
  if repl.is_empty() {
    return false
  }
  for bl in 0..f.blocks.len() {
    var keep: List[Int] = []
    for v in f.blocks[bl].instrs {
      if dead.contains(v) {
        continue
      }
      keep.push(v)
      for k in 0..f.values[v].args.len() {
        f.set_arg(v, k, find_repl(repl, f.arg(f.values[v].args, k)))
      }
      for se in f.values[v].succs() {
        for k in 0..f.edges[se].args.len() {
          f.edges[se].args[k] = find_repl(repl, f.edges[se].args[k])
        }
      }
    }
    f.blocks[bl].instrs = keep
  }
  for k in 0..f.dbinds.len() {
    f.dbinds[k].value = find_repl(repl, f.dbinds[k].value)
  }
  true
}

/// Replaces each field read of a tuple that is only read field by field
/// (the inliner's return of a call with `var` parameters) by the tuple's
/// operand, and drops the tuple (Go's generic rules, StructSelect of
/// StructMake). Only a tuple whose counted operands are owned roots
/// (tuple_operand_owned): a projection's retain made the tuple its owner,
/// and without the tuple that count is on no leaf (the reference count
/// check failed on cached_macho_objects' list.index element).
/// False when nothing changed.
pub fn fold_tuple_fields(var f: Func, m: Module) -> Bool {
  // most functions have no tuple: no use map for them (a third of the
  // inliner's time on xo's self build, 2026-10-18)
  var any = false
  for x in f.values {
    if x.op == Op.Tuple {
      any = true
      break
    }
  }
  if !any {
    return false
  }
  // the uses of tuples only, the one kind read below, each list grown in
  // place (every value's uses, copied per use, were 2.7% of the
  // self-build's allocation, 2026-10-30, ADR 0448 stage 4)
  var us: Map[Int, List[Int]] = {}
  for bl in f.blocks {
    for v in bl.instrs {
      for a in f.args_iter(f.values[v].args) {
        if a >= 0 && f.values[a].op == Op.Tuple {
          us.update(a, [], fn(var l) { l.push(v) })
        }
      }
      for e in f.values[v].succs() {
        for a in f.edges[e].args {
          if a >= 0 && f.values[a].op == Op.Tuple {
            us.update(a, [], fn(var l) { l.push(-1) })
          }
        }
      }
    }
  }
  for d in f.dbinds {
    if d.value >= 0 && f.values[d.value].op == Op.Tuple {
      us.update(d.value, [], fn(var l) { l.push(-1) })
    }
  }
  var repl: Map[Int, Int] = {}
  var dead: Map[Int, Bool] = {}
  for bl in f.blocks {
    for t in bl.instrs {
      let x = f.values[t]
      if x.op != Op.Tuple {
        continue
      }
      let tu = us.get(t) ?? []
      var ok = !tu.is_empty()
      for a in f.args_iter(x.args) {
        if !tuple_operand_owned(f, m, a) {
          ok = false
        }
      }
      for u in tu {
        if u < 0 || f.values[u].op != Op.Field || f.arg(f.values[u].args, 0) != t {
          ok = false
          break
        }
        let i = match f.values[u].aux {
          I(n) => n
          None | F(..) | B(..) | S(..) | Bs(..) | P(..) | E(..) => -1
        }
        if i < 0 || i >= x.args.len() {
          ok = false
          break
        }
      }
      if !ok {
        continue
      }
      for u in tu {
        let i = match f.values[u].aux {
          I(n) => n
          None | F(..) | B(..) | S(..) | Bs(..) | P(..) | E(..) => 0
        }
        repl[u] = f.arg(x.args, i)
        dead[u] = true
      }
      dead[t] = true
    }
  }
  if dead.is_empty() {
    return false
  }
  for bl in 0..f.blocks.len() {
    var keep: List[Int] = []
    for v in f.blocks[bl].instrs {
      if dead.contains(v) {
        continue
      }
      keep.push(v)
      for k in 0..f.values[v].args.len() {
        f.set_arg(v, k, find_repl(repl, f.arg(f.values[v].args, k)))
      }
      for se in f.values[v].succs() {
        for k in 0..f.edges[se].args.len() {
          f.edges[se].args[k] = find_repl(repl, f.edges[se].args[k])
        }
      }
    }
    f.blocks[bl].instrs = keep
  }
  true
}

/// Whether tuple operand a is not counted or is an owned root of the
/// reference count pass (rc.xo kind): not a borrowed parameter, a
/// constant, a projection (payload, capture, unbox, a list element) or a
/// field of an aggregate.
fn tuple_operand_owned(f: Func, m: Module, a: Int) -> Bool {
  let x = f.values[a]
  if ty_of(x.tb) < 0 || !m.heap(ty_of(x.tb)) {
    return true
  }
  match x.op {
    Param => block_of(x.tb) != 0
    Const | Payload | Capture | Unbox | Field | Bind => false
    Call => !is_proj_call(f.name_of(x))
    _ => true
  }
}

/// Whether cse may merge two operations of op (not compares: the
/// emitter folds a compare used once into its branch's flags).
fn cse_op(op: Op) -> Bool {
  op is Op.Add | Op.Sub | Op.Mul | Op.Neg | Op.And | Op.Or | Op.Xor | Op.Not | Op.Shl | Op.Shr | Op.IntConv | Op.Field | Op.Tag
}

/// The name of a call cse may merge with an identical dominating one
/// (a length, or an element read with borrow_only's condition), else "".
fn cse_call(aux: Aux) -> Str {
  match aux {
    S(n) => if n is "list.len" | "Str.len" | "bytes.len" | "list.index" { n } else { "" }
    None | I(..) | F(..) | B(..) | Bs(..) | P(..) | E(..) => ""
  }
}

/// The values of f used other than as the list or text operand of a
/// list.index or length call (an operand of anything else, a jump's
/// argument, a debug binding): a counted list element read whose value
/// is not one of them only borrows (cse).
fn read_only_uses(f: Func) -> Map[Int, Bool] {
  var out: Map[Int, Bool] = {}
  for b in f.blocks {
    for v in b.instrs {
      let x = f.values[v]
      let name = if x.op == Op.Call { cse_call(f.aux(x)) } else { "" }
      for (k, a) in f.args_indexed(x.args) {
        if k > 0 || name.is_empty() {
          out[a] = true
        }
      }
      for se in x.succs() {
        for a in f.edges[se].args {
          out[a] = true
        }
      }
    }
  }
  for d in f.dbinds {
    out[d.value] = true
  }
  out
}

/// Whether op's two operands may be swapped.
fn cse_commutes(op: Op) -> Bool {
  op is Op.Add | Op.Mul | Op.And | Op.Or | Op.Xor
}

/// Keeps the blocks keep marks, in order, and renumbers them in the
/// values, edges, and the function's block references.
fn remove_blocks(var f: Func, keep: List[Bool]) {
  var map: List[Int] = []
  var blocks: List[Block] = []
  var all = true
  for (i, k) in keep.indexed() {
    if k {
      map.push(blocks.len())
      blocks.push(f.blocks[i])
    } else {
      map.push(-1)
      all = false
    }
  }
  if all {
    return
  }
  f.blocks = blocks
  for i in 0..f.values.len() {
    let bl = block_of(f.values[i].tb)
    if bl >= 0 {
      f.values[i].tb = with_block(f.values[i].tb, map[bl])
    }
  }
  for i in 0..f.edges.len() {
    let fr = f.edges[i].from
    let to = f.edges[i].to
    f.edges[i].from = if fr >= 0 { map[fr] } else { -1 }
    f.edges[i].to = if to >= 0 { map[to] } else { -1 }
  }
  if f.unwind_exit >= 0 {
    f.unwind_exit = map[f.unwind_exit]
  }
  var lr: Map[Int, Bool] = {}
  for (bl, _) in f.land_rest {
    if map[bl] >= 0 {
      lr[map[bl]] = true
    }
  }
  f.land_rest = lr
}

/// The value a removed trivial parameter stands for (removeTrivialParams'
/// find).
fn find_repl(repl: Map[Int, Int], v0: Int) -> Int {
  var v = v0
  while let Some(r) = repl.get(v) {
    v = r
  }
  v
}

/// Removes the block parameters whose incoming arguments are all the
/// parameter itself or one other value (removeTrivialParams).
fn remove_trivial_params(var f: Func) {
  var repl: Map[Int, Int] = {}
  var changed = true
  while changed {
    changed = false
    for bl in 1..f.blocks.len() {
      var i = 0
      while i < f.blocks[bl].params.len() {
        let p = f.blocks[bl].params[i]
        var same = -1
        var trivial = true
        for e in f.blocks[bl].preds {
          let a = find_repl(repl, f.edges[e].args[i])
          if a == p || a == same {
            continue
          }
          if same >= 0 {
            trivial = false
            break
          }
          same = a
        }
        if !trivial || same < 0 {
          i += 1
          continue
        }
        repl[p] = same
        f.blocks[bl].params = remove_at(f.blocks[bl].params, i)
        for e in f.blocks[bl].preds {
          f.edges[e].args = remove_at(f.edges[e].args, i)
        }
        changed = true
      }
    }
  }
  if repl.is_empty() {
    return
  }
  for k in 0..f.dbinds.len() {
    f.dbinds[k].value = find_repl(repl, f.dbinds[k].value)
  }
  for bl in 0..f.blocks.len() {
    for v in f.blocks[bl].instrs {
      for k in 0..f.values[v].args.len() {
        f.set_arg(v, k, find_repl(repl, f.arg(f.values[v].args, k)))
      }
      for e in f.values[v].succs() {
        for k in 0..f.edges[e].args.len() {
          f.edges[e].args[k] = find_repl(repl, f.edges[e].args[k])
        }
      }
    }
  }
}

fn remove_at(xs: List[Int], i: Int) -> List[Int] {
  var out: List[Int] = []
  for (k, x) in xs.indexed() {
    if k != i {
      out.push(x)
    }
  }
  out
}

/// Gives the values placed in blocks the IDs of the Go builder's renumber
/// (block order, parameters first): the value table is rebuilt in that
/// order, and values no block holds are dropped.
fn renumber(var f: Func) {
  var map: List[Int] = []
  for _ in 0..f.values.len() {
    map.push(-1)
  }
  var order: List[Int] = []
  for bl in f.blocks {
    for p in bl.params {
      map[p] = order.len()
      order.push(p)
    }
    for v in bl.instrs {
      map[v] = order.len()
      order.push(v)
    }
  }
  var vals: List[Value] = List.with_capacity(order.len())
  // the argument pool rebuilt in the new order, without the ranges
  // set_args replaced (decision 0448 addendum)
  var live = 0
  for v in order {
    live += f.values[v].args.len()
  }
  var np: List[Int] = List.with_capacity(live)
  for v in order {
    var x = f.values[v]
    x.args = f.args_mapped_into(x.args, map, np)
    if pad_of(x.pi) >= 0 {
      x.pi = with_pad(x.pi, map[pad_of(x.pi)])
    }
    vals.push(x)
  }
  f.values = vals
  f.argpool = np
  for bl in 0..f.blocks.len() {
    var ps: List[Int] = []
    for p in f.blocks[bl].params {
      ps.push(map[p])
    }
    f.blocks[bl].params = ps
    var ins: List[Int] = []
    for v in f.blocks[bl].instrs {
      ins.push(map[v])
    }
    f.blocks[bl].instrs = ins
  }
  for e in 0..f.edges.len() {
    if f.edges[e].args.is_empty() {
      continue
    }
    var args: List[Int] = List.with_capacity(f.edges[e].args.len())
    for a in f.edges[e].args {
      args.push(if a >= 0 { map[a] } else { -1 })
    }
    f.edges[e].args = args
  }
  // binding records follow their values; one whose value no block holds
  // any more is dropped (decision 0252)
  var bs: List[DBind] = []
  for d in f.dbinds {
    if d.value >= 0 && d.value < map.len() && map[d.value] >= 0 {
      bs.push(DBind{dvar: d.dvar, value: map[d.value], line: d.line})
    }
  }
  f.dbinds = bs
  // the payloads that took their enum's ownership follow theirs too
  var mv: Map[Int, Bool] = {}
  for (k, _) in f.moved {
    if k >= 0 && k < map.len() && map[k] >= 0 {
      mv[map[k]] = true
    }
  }
  f.moved = mv
}

/// Runs cleanup on every function (the cleanup stage).
pub fn (var b: Builder) cleanup_all() {
  b.cleanup_all_jobs(1)
}

/// cleanup_all on up to jobs tasks: each function's cleanup reads only
/// the function, so the module is the same for any number of jobs (a
/// serial pass over xo was 0.25 s of every edit build).
pub fn (var b: Builder) cleanup_all_jobs(jobs: Int) {
  let n = b.m.funcs.len()
  if jobs <= 1 || n < 256 || target.arch == TargetArch.Wasm32 {
    for fi in 0..n {
      var f = b.m.funcs[fi]
      b.m.funcs[fi] = Func{name: ""}
      cleanup_func(f)
      b.m.funcs[fi] = f
    }
    return
  }
  // in waves, each function taken out of the module before its cleaned
  // form is made: the whole module twice (the old and the cleaned) was
  // the cleanup's peak (a program of 2,000 large functions: 2.1 GB live,
  // 2.6 GB at the peak)
  var w = 0
  while w < n {
    let hi = (w + CLEANUP_WAVE).min(n)
    var sub: List[Func] = List.with_capacity(hi - w)
    for fi in w..hi {
      sub.push(b.m.funcs[fi])
      b.m.funcs[fi] = Func{name: ""}
    }
    for (k, f) in cleanup_funcs(sub, jobs).indexed() {
      b.m.funcs[w + k] = f
    }
    w = hi
  }
}

/// The functions cleanup_all_jobs cleans at a time.
const CLEANUP_WAVE = 1024

/// cleanup_all_jobs but for the functions in skip (the cleanup cache's
/// hits, decision 0382, which stand in for their cleaned form).
pub fn (var b: Builder) cleanup_skip_jobs(jobs: Int, skip: Map[Int, Bool]) {
  if skip.is_empty() {
    b.cleanup_all_jobs(jobs)
    return
  }
  var idx: List[Int] = []
  for fi in 0..b.m.funcs.len() {
    if !skip.contains(fi) {
      idx.push(fi)
    }
  }
  // in waves, as cleanup_all_jobs
  let par = jobs > 1 && idx.len() >= 256 && target.arch != TargetArch.Wasm32
  var w = 0
  while w < idx.len() {
    let hi = (w + CLEANUP_WAVE).min(idx.len())
    var sub: List[Func] = List.with_capacity(hi - w)
    for fi in idx[w..hi] {
      sub.push(b.m.funcs[fi])
      b.m.funcs[fi] = Func{name: ""}
    }
    for (k, f) in cleanup_funcs(sub, if par { jobs } else { 1 }).indexed() {
      b.m.funcs[idx[w + k]] = f
    }
    w = hi
  }
}

/// funcs after cleanup, on up to jobs tasks, in order.
fn cleanup_funcs(funcs: List[Func], jobs: Int) -> List[Func] {
  let n = funcs.len()
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..jobs.min((n + 63) / 64).max(1) {
      ts.push(s.spawn(fn() -> List[(Int, Func)] {
        var mine: List[(Int, Func)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for fi in i..(i + 64).min(n) {
            mine.push((fi, cleaned(funcs[fi])))
          }
        }
        mine
      }))
    }
    var all: List[(Int, Func)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out = funcs
  for (fi, f) in done {
    out[fi] = f
  }
  out
}

/// Runs the passes after the build and writes the module after each:
/// unwind, landings, cleanup, rc (buildModule, BuildStages).
pub fn (var b: Builder) write_passes(var out: StrBuilder) {
  b.prune_unwind()
  b.fold_known_calls()
  out.write("== stage unwind\n")
  out.write(b.m.text())
  b.add_landings()
  out.write("== stage landings\n")
  out.write(b.m.text())
  b.cleanup_all()
  out.write("== stage cleanup\n")
  out.write(b.m.text())
  b.insert_rc()
  out.write("== stage rc\n")
  out.write(b.m.text())
  out.write("== stage verify\n")
  out.write(b.verify_text())
  out.write("== stage mutants\n")
  out.write(b.verify_mutants(6))
}

/// Runs the passes after the build without printing them: unwind,
/// landings, cleanup, rc (what a native build generates code from;
/// compiler/arm64, decision 0158).
pub fn (var b: Builder) run_passes() {
  b.prune_unwind()
  b.fold_known_calls()
  b.add_landings()
  b.cleanup_all()
  b.specialize_args()
  b.insert_rc()
}
