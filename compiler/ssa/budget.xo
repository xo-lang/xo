// Resource budgets (internal/ssa build_budget.go; std.md 7, decisions
// 0173 and 0175): in a program that calls task.with_budget, the code of
// the program's own modules polls the budget (`rt.tick`, then an
// unwinding check) at the start of every loop iteration (loop_tick) and
// at the entry of every function, closure, and test body.
use github.com/xo-lang/xo/compiler/check

/// Whether a user module calls task.with_budget (usesBudgets): the walk
/// of uses_os_tasks, looking for those calls.
fn (var b: Builder) uses_budgets() -> Bool {
  b.scan_budget = true
  let found = b.uses_os_tasks()
  b.scan_budget = false
  found
}

/// Whether fo is std/task's with_budget (isWithBudget).
fn (var b: Builder) is_with_budget(fo: Int) -> Bool {
  if fo < 0 || b.c.objs[fo].recv >= 0 {
    return false
  }
  let m = b.obj_mod(fo)
  m >= 0 && b.c.mods[m].path == "std/task" && b.obj_name(fo) == "with_budget"
}

/// std/native/llrt/pool.xo W_PREEMPT: the static word of the preemption
/// flag.
const PREEMPT_WORD = 76

/// The preemption poll at a loop's iteration, on arm64 and amd64 (decision 0286
/// step 3, the owner's choice (a+) of 2026-10-21): in every module but
/// the runtime's (runtime_mod: it holds spin locks, and pool.xo preempt
/// yields only when the worker holds none of them), the static word
/// W_PREEMPT tested, a call of xo_preempt_stub (which keeps every
/// register) when it is set; the word's address is loop invariant.
fn (var b: Builder) preempt_poll() {
  if !b.s.ppolls || b.m.no_preempt || b.wasm || !(b.goarch is "arm64" | "amd64") || b.is_dead() {
    return
  }
  let a = b.rt("static_word", b.int_t(), [b.cint(PREEMPT_WORD)])
  b.rt("preempt_poll", -1, [a])
}

/// The budget poll, when the program uses budgets and the code being
/// built is the program's own (poll).
fn (var b: Builder) poll() {
  if !b.s.polls || !b.budgets || b.is_dead() {
    return
  }
  b.rt("tick", -1, [])
  b.check("")
}

/// `task.with_budget(clock, b, f)` (withBudget, std.md 7): f runs as the
/// body of a scope with the budget b (rt.budget_open); rt.budget_end,
/// once the scope closed, tells the resource whose ceiling was passed
/// (Err(Exceeded(resource)), an unwinding stops), else f's own outcome
/// stands.
fn (var b: Builder) with_budget(x: Expr, fo: Int) -> Int {
  let (span, _, args) = call_parts(x)
  let nt = b.nat_of(x)
  let it = b.int_t()
  let bt = b.bool_t()
  let es = arg_exprs(b.c.objs[fo].params, args)
  if es.len() < 3 || es[0] == None || es[1] == None || es[2] == None {
    b.unsupported("a call with a missing argument")
    return b.undef(nt)
  }
  let e0 = es[0] ?? fault("missing")
  let e1 = es[1] ?? fault("missing")
  let e2 = es[2] ?? fault("missing")
  b.expr(e0)
  let bv = b.expr(e1)
  var lim: List[Int] = []
  for name in ["cpu", "alloc", "steps"] {
    let (k, ft) = b.field_index(b.vty(bv), name)
    if k < 0 {
      b.unsupported("this budget")
      return b.undef(nt)
    }
    lim.push(b.add(Op.Field, ft, Aux.I(n: k), [bv]))
  }
  let nct = b.nat_check(e2)
  if nct < 0 || b.c.tys[b.c.resolve(nct)].kind != check.TyKind.Func {
    b.unsupported("this closure")
    return b.undef(nt)
  }
  let ct = b.c.tys[b.c.resolve(nct)]
  let err_t = b.fail_err(b.apply(ct.err))
  let rt = b.typ(b.result_of(b.apply(ct.result), err_t))
  let fv = b.value_as(e2, b.m.func_type([], rt))
  let h = b.rt("scope_open", b.m.handle("Scope", []), [])
  b.rt("budget_open", -1, [h, lim[0], lim[1], lim[2], b.loc(span)])
  if b.s.pending >= 0 {
    b.flush_landing()
  }
  let r = b.s.f.add(b.s.cur, Op.CallValue, rt, Aux.None, [fv])
  let u = b.s.f.add(b.s.cur, Op.Call, bt, Aux.S(s: "rt.unwinding"), [])
  // a fault in f closes the scope and goes on (decision 0085)
  b.s.f.values[r].pad = u
  let join = b.new_block()
  let res = b.s.f.add_param(join, nt)
  let ei = b.m.variant_index(nt, "Err")
  let bud_t = b.m.types[nt].variants[ei].fields[0].ty
  let (unw, done) = b.branch(u)
  b.checks.push(UCheck{fi: b.s.fi, u: u, callee: "", w: r})
  // unwinding: a ceiling passed, or a cancellation from outside
  b.s.cur = unw
  b.rt("scope_close", it, [h, b.cint(2)])
  let k = b.rt("budget_end", it, [h])
  let (over, out) = b.branch(b.add(Op.Gt, bt, Aux.None, [k, b.cint(0)]))
  b.s.cur = over
  b.budget_exceeded(k, nt, ei, bud_t, join)
  b.s.cur = out
  b.unwind()
  // f returned
  b.s.cur = done
  b.rt("scope_close", it, [h, b.cint(0)])
  let k2 = b.rt("budget_end", it, [h])
  b.check("")
  let (late, intime) = b.branch(b.add(Op.Gt, bt, Aux.None, [k2, b.cint(0)]))
  b.s.cur = late
  b.budget_exceeded(k2, nt, ei, bud_t, join)
  b.s.cur = intime
  let ok_i = b.m.variant_index(nt, "Ok")
  if err_t < 0 {
    b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: ok_i), [r])])
  } else {
    let r_ok = b.m.variant_index(rt, "Ok")
    let tag = b.add(Op.Tag, it, Aux.None, [r])
    let (fok, ferr) = b.branch(b.add(Op.Eq, bt, Aux.None, [tag, b.cint(r_ok)]))
    b.s.cur = fok
    let v = b.add(Op.Payload, b.m.types[rt].variants[r_ok].fields[0].ty, Aux.P(tag: r_ok, field: 0), [r])
    b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: ok_i), [v])])
    b.s.cur = ferr
    let rei = b.m.variant_index(rt, "Err")
    let ev = b.add(Op.Payload, b.m.types[rt].variants[rei].fields[0].ty, Aux.P(tag: rei, field: 0), [r])
    let fv2 = b.variant(bud_t, "Failed", [ev])
    b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: ei), [fv2])])
  }
  b.seal(join)
  b.s.cur = join
  res
}

/// Jumps to join with Err(Exceeded(the name of resource k)): k 1 cpu,
/// 2 alloc, 3 steps (withBudget's exceeded).
fn (var b: Builder) budget_exceeded(k: Int, nt: Int, ei: Int, bud_t: Int, join: Int) {
  let bt = b.bool_t()
  let (is_cpu, other) = b.branch(b.add(Op.Eq, bt, Aux.None, [k, b.cint(1)]))
  b.s.cur = is_cpu
  let c = b.variant(bud_t, "Exceeded", [b.const_str("cpu")])
  b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: ei), [c])])
  b.s.cur = other
  let (is_alloc, steps) = b.branch(b.add(Op.Eq, bt, Aux.None, [k, b.cint(2)]))
  b.s.cur = is_alloc
  let a = b.variant(bud_t, "Exceeded", [b.const_str("alloc")])
  b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: ei), [a])])
  b.s.cur = steps
  let st = b.variant(bud_t, "Exceeded", [b.const_str("steps")])
  b.jump(join, [b.add(Op.Variant, nt, Aux.I(n: ei), [st])])
}

/// The body of xo_preempt_stub on arm64 (decision 0286 step 3; both
/// emitters define it, compiler/arm64 sched.xo and compiler/llvm): a preemption poll's
/// slow path, which keeps every register the C convention lets a callee
/// change (x0 to x17, x18 off Apple, the flags, all of q0 to q31: the
/// callee keeps only d8 to d15's low halves) around the runtime's
/// xo_x_preempt, so a poll in a loop clobbers nothing; x30 is the
/// caller's to keep (the poll's stub).
pub fn preempt_stub_arm64(os: Str) -> List[Str] {
  // first, with x16 (and on Darwin x17, which the TLV thunk changes) only:
  // whether this worker was asked (its record, xo_tlocal slot TLS_W, word
  // W_PREEMPT_I of pool.xo: bytes 16 and 3456); a poll of every other
  // worker returns here, saving nothing (the full save in every poll while
  // any ask was out cost a loaded server a quarter of its throughput,
  // 2026-10-21)
  let l = if os == "darwin" { "Lxo_preempt" } else { ".Lxo_preempt" }
  var b: List[Str] = []
  if os == "darwin" {
    b = ["stp x0, x30, [sp, #-16]!", "adrp x0, _xo_tlocal@TLVPPAGE", "ldr x0, [x0, _xo_tlocal@TLVPPAGEOFF]", "ldr x16, [x0]", "blr x16", "ldr x16, [x0, #16]", "ldp x0, x30, [sp], #16"]
  } else {
    b = ["mrs x16, tpidr_el0", "add x16, x16, :tprel_hi12:xo_tlocal", "add x16, x16, :tprel_lo12_nc:xo_tlocal", "ldr x16, [x16, #16]"]
  }
  b = b + ["cbz x16, ${l}_none", "ldr x16, [x16, #3456]", "cbnz x16, ${l}_asked", "${l}_none:", "ret", "${l}_asked:"]
  b = b + ["stp x29, x30, [sp, #-16]!", "mov x29, sp", "sub sp, sp, #672"]
  var i = 0
  while i < 18 {
    b.push("stp x${i}, x${i + 1}, [sp, #${8 * i}]")
    i += 2
  }
  b.push("mrs x9, nzcv")
  b.push("str x9, [sp, #144]")
  if os != "darwin" {
    b.push("str x18, [sp, #152]")
  }
  i = 0
  while i < 32 {
    b.push("stp q${i}, q${i + 1}, [sp, #${160 + 16 * i}]")
    i += 2
  }
  b.push(if os == "darwin" { "bl _xo_x_preempt" } else { "bl xo_x_preempt" })
  i = 0
  while i < 32 {
    b.push("ldp q${i}, q${i + 1}, [sp, #${160 + 16 * i}]")
    i += 2
  }
  if os != "darwin" {
    b.push("ldr x18, [sp, #152]")
  }
  b.push("ldr x9, [sp, #144]")
  b.push("msr nzcv, x9")
  i = 0
  while i < 18 {
    b.push("ldp x${i}, x${i + 1}, [sp, #${8 * i}]")
    i += 2
  }
  b + ["add sp, sp, #672", "ldp x29, x30, [sp], #16", "ret"]
}

/// Whether module path p is the runtime's, which never polls (it holds
/// spin locks; decision 0286 step 3): native/llrt (std/native/llrt), the
/// rt modules, and the system call wrappers.
fn runtime_mod(p: Str) -> Bool {
  p.starts_with("native/llrt") || p.starts_with("native/rt") || p.starts_with("native/sys_")
}

/// The body of xo_preempt_stub on amd64 (decision 0286 step 3; both
/// emitters define it, compiler/arm64 x86rt.xo and compiler/llvm): a
/// preemption poll's slow path, which keeps every register either
/// convention lets a callee change (rax, rcx, rdx, rsi, rdi, r8 to r11,
/// the flags, xmm0 to xmm15) around the runtime's xo_x_preempt, in a
/// frame it aligns itself (a poll may be in a leaf), with Win64's shadow
/// space below the saves (on Windows the export takes Win64).
pub fn preempt_stub_amd64(os: Str) -> List[Str] {
  let gp = ["rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11"]
  // first, with r11 only (the poll's scratch; the flags are the poll's
  // test's): whether this worker was asked (its record, xo_tlocal slot
  // TLS_W, word W_PREEMPT_I of pool.xo: bytes 16 and 3456), as the arm64
  // stub; every other worker's poll returns here saving nothing
  let l = if os == "darwin" { "Lxo_preempt" } else { ".Lxo_preempt" }
  var b: List[Str] = []
  if os == "darwin" {
    // the TLV thunk changes rax and rdi
    b = ["pushq %rbp", "movq %rsp, %rbp", "andq $-16, %rsp", "pushq %rax", "pushq %rdi", "movq _xo_tlocal@TLVP(%rip), %rdi", "callq *(%rdi)", "movq 16(%rax), %r11", "popq %rdi", "popq %rax", "movq %rbp, %rsp", "popq %rbp"]
  } else if os == "windows" {
    b = ["pushq %rax", "movl _tls_index(%rip), %eax", "movq %gs:88, %r11", "movq (%r11,%rax,8), %r11", "leaq xo_tlocal@SECREL32(%r11), %r11", "popq %rax", "movq 16(%r11), %r11"]
  } else {
    b = ["movq %fs:0, %r11", "leaq xo_tlocal@TPOFF(%r11), %r11", "movq 16(%r11), %r11"]
  }
  b = b + ["testq %r11, %r11", "jz ${l}_none", "cmpq $0, 3456(%r11)", "jne ${l}_asked", "${l}_none:", "retq", "${l}_asked:"]
  b = b + ["pushq %rbp", "movq %rsp, %rbp", "pushfq", "andq $-16, %rsp", "subq $368, %rsp"]
  for (i, r) in gp.indexed() {
    b.push("movq %${r}, ${32 + 8 * i}(%rsp)")
  }
  for i in 0..16 {
    b.push("movups %xmm${i}, ${104 + 16 * i}(%rsp)")
  }
  b.push(if os == "darwin" { "callq _xo_x_preempt" } else { "callq xo_x_preempt" })
  for i in 0..16 {
    b.push("movups ${104 + 16 * i}(%rsp), %xmm${i}")
  }
  for (i, r) in gp.indexed() {
    b.push("movq ${32 + 8 * i}(%rsp), %${r}")
  }
  b + ["leaq -8(%rbp), %rsp", "popfq", "popq %rbp", "retq"]
}
