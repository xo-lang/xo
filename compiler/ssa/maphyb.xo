// Decision 0291's hybrid Map (the default since 2026-10-21; XO_MAP_LOG=0
// builds the lists alone): a Map or Set value is the
// lists' struct (map.xo: keys, vals, live, slots, n) with one more field:
//
//   log   List[L]  in log mode one log table (maplog.xo, the type L =
//                  xo.MapLog[...]) that holds the entries; in lists mode
//                  empty: the shared (immortal) empty list until the
//                  value's lists copied on write once, then an empty list
//                  of its own (the mark; six fields keep a put's map, key
//                  and value in registers on arm64, where a seventh field
//                  put the value on the stack: puts 1.3x the lists')
//
// In lists mode every read and every write by the only holder is the
// lists' code (their speed: no log indirection). A write to a value
// whose lists are shared copies on write as the lists do and counts it;
// the second converts the value to a log table (O(n), once) and writes
// through it from then on: a Map written while shared again and again (a
// store under Mutex.with) gets the log's O(1) copies, and code that
// copies a Map and writes the copy keeps the lists' speed. A log value
// never goes back; its n (field 4) mirrors the table's.

/// The bit a log value's lookup result carries (above any position and
/// MLOG_LEVEL's levels).
const MAPH_LOG = 2305843009213693952

/// The log table type of the hybrid map type t.
fn (var b: Builder) maph_lt(t: Int) -> Int { b.m.types[b.m.types[t].fields[5].ty].elems[0] }

/// Whether the hybrid map mv (of type t) is in log mode.
fn (var b: Builder) maph_is_log(t: Int, mv: Int) -> Int { b.bop(Op.Gt, b.call("list.len", b.int_t(), "", [b.mfield(t, 5, mv)]), b.cint(0)) }

/// Whether the list l is held by one value only (a thread local count of
/// one; the shared empty list is immortal, so not).
fn (var b: Builder) maph_sole(l: Int) -> Int {
  b.bop(Op.Eq, b.obj_count(l), b.cint(1))
}

/// map_lookup of a hybrid map: the lists' position, else (a miss) the
/// log table's when the value is in log mode (xo.maph.loglookup, out of
/// line). A log value's lists are empty, so their lookup misses at once,
/// and a lists value's hit never looks at the log field.
fn (var b: Builder) maph_lookup(t: Int, mv: Int, k: Int) -> Int {
  let it = b.int_t()
  let ll = b.maph_loglookup(t)
  let res = b.local()
  b.write_var(res, b.lists_lookup(t, mv, k))
  let (nm, jm) = b.if_then_begin(b.bop(Op.Lt, b.read(res), b.cint(0)))
  let (nl, jl) = b.if_then_begin(b.maph_is_log(t, mv))
  b.write_var(res, b.call(ll, it, "", [mv, k]))
  b.if_then_end(nl, jl)
  b.if_then_end(nm, jm)
  b.read(res)
}

/// xo.maph.loglookup[T](m, k) -> Int (ssa.cold_fn): k's position in the
/// log value m's table, with MAPH_LOG set (map_value tells the two kinds
/// apart without loading the log field again), or -1.
fn (var b: Builder) maph_loglookup(t: Int) -> Str {
  let it = b.int_t()
  let kt = map_key(b.m, t)
  let lt = b.maph_lt(t)
  let name = "xo.maph.loglookup[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, kt], [it], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let lv = b.call("list.index", lt, "", [b.mfield(t, 5, mp), b.cint(0)])
  let w = b.mlog_lookup(lt, lv, k)
  let (nt, jt) = b.if_then_begin(b.bop(Op.Ge, w, b.cint(0)))
  b.retv(b.iop(Op.Or, w, b.cint(MAPH_LOG)))
  b.if_then_end(nt, jt)
  b.retv(b.cint(-1))
  b.finish_fn()
  b.end(saved)
  name
}

/// Map.get of a hybrid map (nt: V?): the lists' lookup, and on a hit
/// the lists' value with no other test, so the hit path is the lists'
/// own (a position tagged MAPH_LOG cost two more branches a get, 1.66x
/// the cycles in a get loop at 1.05x the instructions); a miss looks in
/// the log through the cold xo.maph.logget when the value is a log one.
fn (var b: Builder) maph_get(t: Int, mv: Int, k: Int, nt: Int) -> Int {
  let bt = b.bool_t()
  let lg = b.maph_logget(t, nt)
  let idx = b.lists_lookup(t, mv, k)
  let join = b.new_block()
  let res = b.s.f.add_param(join, nt)
  let (yes, no) = b.branch(b.add(Op.Ge, bt, Aux.None, [idx, b.cint(0)]))
  b.s.cur = yes
  b.jump(join, [b.variant(nt, "Some", [b.lists_value(t, mv, idx)])])
  b.s.cur = no
  let (lg_yes, lg_no) = b.branch(b.maph_is_log(t, mv))
  b.s.cur = lg_yes
  b.jump(join, [b.call(lg, nt, "", [mv, k])])
  b.s.cur = lg_no
  b.jump(join, [b.variant(nt, "None", [])])
  b.seal(join)
  b.s.cur = join
  res
}

/// xo.maph.logget[T](m, k) -> V? (ssa.cold_fn): k's value in the log
/// value m's table.
fn (var b: Builder) maph_logget(t: Int, nt: Int) -> Str {
  let kt = map_key(b.m, t)
  let lt = b.maph_lt(t)
  let name = "xo.maph.logget[${b.m.types[t].name}]${opt_suffix(b.m, map_val(b.m, t), nt)}"
  let fi = b.thunk_func(name, [t, kt], [nt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let lv = b.call("list.index", lt, "", [b.mfield(t, 5, mp), b.cint(0)])
  let w = b.mlog_lookup(lt, lv, k)
  let (nt2, jt) = b.if_then_begin(b.bop(Op.Ge, w, b.cint(0)))
  b.retv(b.variant(nt, "Some", [b.mlog_value_at(lt, lv, w)]))
  b.if_then_end(nt2, jt)
  b.retv(b.variant(nt, "None", []))
  b.finish_fn()
  b.end(saved)
  name
}

/// map_value of a hybrid map, for a maph_lookup result idx (>= 0).
fn (var b: Builder) maph_value(t: Int, mv: Int, idx: Int) -> Int {
  let vt = map_val(b.m, t)
  let join = b.new_block()
  let res = b.s.f.add_param(join, vt)
  let (yes, no) = b.branch(b.bop(Op.Ne, b.iop(Op.And, idx, b.cint(MAPH_LOG)), b.cint(0)))
  b.s.cur = yes
  let lt = b.maph_lt(t)
  let lv = b.call("list.index", lt, "", [b.mfield(t, 5, mv), b.cint(0)])
  b.jump(join, [b.mlog_value_at(lt, lv, b.iop(Op.Xor, idx, b.cint(MAPH_LOG)))])
  b.s.cur = no
  b.jump(join, [b.lists_value(t, mv, idx)])
  b.seal(join)
  b.s.cur = join
  res
}

/// xo.maph.tolog[T](m) -> L: the log table of m's live entries, in order
/// (the conversion: a flatten's cost, once): the key side from the keys
/// (xo.maph.ktolog[K]), the values from the live flags (xo.map.vcompact).
fn (var b: Builder) maph_tolog(t: Int) -> Str {
  let it = b.int_t()
  let lt = b.maph_lt(t)
  let kt = mlog_k(b.m, lt)
  let ktolog = b.maph_ktolog(t)
  let compact = b.map_vcompact(t)
  let vd = b.m.types[lt].fields[1].ty
  let vtab = b.mlog_vtable(vd)
  let name = "xo.maph.tolog[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [lt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let n = b.add(Op.Field, it, Aux.I(n: 4), [mp])
  let kl = b.call(ktolog, kt, "", [b.mfield(t, 0, mp), b.mfield(t, 2, mp), n])
  let vs = b.call(compact, b.m.types[t].fields[1].ty, "", [b.mfield(t, 1, mp), b.mfield(t, 2, mp), n])
  b.retv(b.add(Op.Struct, lt, Aux.None, [kl, b.call(vtab, vd, "", [vs]), b.call("list.new", b.m.types[lt].fields[2].ty, "", [])]))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.maph.ktolog[K](keys, live, n) -> the key side of a fresh table of
/// the live keys, in order (maph_tolog's).
fn (var b: Builder) maph_ktolog(t: Int) -> Str {
  let it = b.int_t()
  let lt = b.maph_lt(t)
  let kt = mlog_k(b.m, lt)
  let et = mlog_entry_of(b.m, kt)
  let el = b.m.list(et)
  let kty = map_key(b.m, t)
  let fs = b.m.types[t].fields
  let name = "xo.maph.ktolog[${b.m.types[kt].name}]"
  let fi = b.thunk_func(name, [fs[0].ty, fs[2].ty, it], [kt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let keys = b.param(0)
  let live = b.param(1)
  let es = b.local()
  b.write_var(es, b.call("list.new", el, "", [b.param(2)]))
  let iv = b.local()
  let (i, head, exit) = b.for_up_to_begin(b.call("list.len", it, "", [keys]), iv)
  let (no, join) = b.if_then_begin(b.call("list.index", b.bool_t(), "", [live, i]))
  let e = b.add(Op.Struct, et, Aux.None, [b.cint(0), b.cint(-1), b.cint(0), b.call("list.index", kty, "", [keys, i])])
  b.write_var(es, b.call("list.push", el, "", [b.read(es), e]))
  b.if_then_end(no, join)
  b.for_up_to_end(i, iv, head, exit)
  b.retv(b.mlog_table(kt, b.read(es), b.cint(0)))
  b.finish_fn()
  b.end(saved)
  name
}

/// The hybrid map of log table lv (a conversion's result): empty lists, n
/// mirrored (xo.maph.oflog[T], called from the slow paths).
fn (var b: Builder) maph_of_log(t: Int, lv: Int) -> Int {
  let lt = b.maph_lt(t)
  let name = "xo.maph.oflog[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [lt], [t], [])
  if fi >= 0 {
    let saved = b.begin(fi, b.s.file)
    b.retv(b.maph_of_log_body(t, b.param(0)))
    b.finish_fn()
    b.end(saved)
  }
  b.call(name, t, "", [lv])
}

fn (var b: Builder) maph_of_log_body(t: Int, lv: Int) -> Int {
  let it = b.int_t()
  let lt = b.maph_lt(t)
  let ll = b.m.list(lt)
  var lg = b.call("list.new", ll, "", [b.cint(1)])
  lg = b.call("list.push", ll, "", [lg, lv])
  var fs: List[Int] = []
  for i in 0..4 {
    fs.push(b.call("list.new", b.m.types[t].fields[i].ty, "", []))
  }
  b.add(Op.Struct, t, Aux.None, fs + [b.add(Op.Field, it, Aux.I(n: 4), [b.mf(lt, 0, lv)]), lg])
}

/// The functions maph_put_pro's code calls (made before the put's own).
fn (var b: Builder) maph_prep(t: Int) {
  let _s = b.maph_slowput(t)
}

/// Whether the list l is shared with another value (not empty, not held
/// once).
fn (var b: Builder) maph_shared(l: Int) -> Int {
  let bt = b.bool_t()
  b.add(Op.And, bt, Aux.None, [b.bop(Op.Gt, b.call("list.len", b.int_t(), "", [l]), b.cint(0)), b.add(Op.Not, bt, Aux.None, [b.maph_sole(l)])])
}

/// Whether the hybrid map mp leaves the lists' put (or remove) for
/// xo.maph.slowput (slowrem): it is a log value, or the list the write
/// changes (l) is shared and the value copied on write once already.
fn (var b: Builder) maph_slow(t: Int, mp: Int, l: Int) -> Int {
  let it = b.int_t()
  let res = b.local()
  b.write_var(res, b.cbool(false))
  // a log value's lists are empty: only then is the log field read
  let (ne, je) = b.if_then_begin(b.bop(Op.Eq, b.call("list.len", it, "", [l]), b.cint(0)))
  b.write_var(res, b.maph_is_log(t, mp))
  b.if_then_end(ne, je)
  let (ns, js) = b.if_then_begin(b.maph_shared(l))
  if b.m.map_branch {
    // or MAPH_BRANCH_MIN entries: a fork of its lists (maph_fork_lists)
    b.write_var(res, b.add(Op.Or, b.bool_t(), Aux.None, [b.maph_cowed(t, mp), b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 4), [mp]), b.cint(MAPH_BRANCH_MIN))]))
  } else {
    b.write_var(res, b.maph_cowed(t, mp))
  }
  b.if_then_end(ns, js)
  b.read(res)
}

/// Whether the lists' code may write field f (1, the values; 2, the live
/// flags) of hybrid map mp in place with no other test: the list is not
/// empty (a log value's lists are, and a new map's) and held once.
fn (var b: Builder) maph_lists_own(t: Int, mp: Int, f: Int) -> Int {
  let l = b.mfield(t, f, mp)
  b.add(Op.And, b.bool_t(), Aux.None, [b.bop(Op.Gt, b.call("list.len", b.int_t(), "", [l]), b.cint(0)), b.maph_sole(l)])
}

/// Whether the lists of hybrid map mp copied on write once: its log field
/// is the mark, an empty list of capacity MAPH_MARK_CAP (maph_mark). Not
/// the field's identity: a new map's empty list is the immortal shared
/// one on the native backends but a fresh one on wasm, where every new
/// map looked marked and converted at its first shared write
/// (2026-10-21).
fn (var b: Builder) maph_cowed(t: Int, mp: Int) -> Int {
  b.bop(Op.Eq, b.list_cap(b.mfield(t, 5, mp)), b.cint(MAPH_MARK_CAP))
}

/// mp with its copy on write marked (maph_cowed).
fn (var b: Builder) maph_mark(t: Int, mp: Int) -> Int {
  b.add(Op.SetField, t, Aux.I(n: 5), [mp, b.call("list.new", b.m.types[t].fields[5].ty, "", [b.cint(MAPH_MARK_CAP)])])
}

/// The capacity of the mark (maph_cowed): no other empty list has it (the
/// runtimes give a list at least 4, an empty literal 0 or 4).
const MAPH_MARK_CAP = 5

/// The hybrid's start of xo.map.put[T] (m, k, v its parameters): a log
/// value's put and the conversion go to the cold xo.maph.slowput;
/// otherwise whether the values list (every put writes it) is shared:
/// this put copies it, and its result is marked (maph_marked).
fn (var b: Builder) maph_put_pro(t: Int, mp: Int, k: Int, v: Int) -> Int {
  let (nl, jl) = b.if_then_begin(b.maph_slow(t, mp, b.mfield(t, 1, mp)))
  b.retv(b.call(b.maph_slowput(t), t, "", [mp, k, v]))
  b.if_then_end(nl, jl)
  b.maph_shared(b.mfield(t, 1, mp))
}

/// The lists' result r of a put or remove, marked as copied on write when
/// sh (a Bool value; -1: not the hybrid).
fn (var b: Builder) maph_marked(t: Int, r: Int, sh: Int) -> Int {
  if sh < 0 {
    return r
  }
  let cur = b.local()
  b.write_var(cur, r)
  let (ns, js) = b.if_then_begin(sh)
  b.write_var(cur, b.maph_mark(t, r))
  b.if_then_end(ns, js)
  b.read(cur)
}

/// xo.maph.slowput[T](m, k, v) -> T (ssa.cold_fn): a log value's put (the
/// table moved out of its list, so the log's own fast path sees it held
/// once, and back), or the conversion of a value written while shared a
/// second time, then its put.
fn (var b: Builder) maph_slowput(t: Int) -> Str {
  let it = b.int_t()
  let kt = map_key(b.m, t)
  let vt = map_val(b.m, t)
  let lt = b.maph_lt(t)
  let gput = b.mlog_put(lt)
  let conv = b.maph_tolog(t)
  var gb = ""
  if b.m.map_branch {
    gb = b.maph_goback(t)
  }
  let name = "xo.maph.slowput[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, kt, vt], [t], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let v = b.param(2)
  let ll = b.m.types[t].fields[5].ty
  if !gb.is_empty() {
    // a large lists value written while shared: a fork of its lists
    let (nb, jb) = b.if_then_begin(b.maph_branches(t, mp))
    b.retv(b.maph_of_log(t, b.call(gput, lt, "", [b.maph_fork_lists(t, mp), k, v])))
    b.if_then_end(nb, jb)
  }
  let (nl, jl) = b.if_then_begin(b.maph_is_log(t, mp))
  let tk = b.call("list.take", b.m.tuple([ll, lt]), "", [b.mfield(t, 5, mp), b.cint(0)])
  let lvt = b.add(Op.Field, lt, Aux.I(n: 1), [tk])
  if !gb.is_empty() {
    // a fork written by its only holder: back to the lists after
    // MAPH_GOBACK writes (maph_goback), then the lists' put
    let klv = b.mf(lt, 0, lvt)
    let kt = mlog_k(b.m, lt)
    let due = b.add(Op.And, b.bool_t(), Aux.None, [b.bop(Op.Gt, b.call("list.len", it, "", [b.mf(kt, 7, klv)]), b.cint(0)), b.mlog_sole(b.mf(kt, 0, klv))])
    let (np, jp) = b.if_then_begin(due)
    let gr = b.call(gb, b.m.tuple([t, b.bool_t()]), "", [lvt])
    let (ng, jg) = b.if_then_begin(b.add(Op.Field, b.bool_t(), Aux.I(n: 1), [gr]))
    b.retv(b.call("xo.map.put[${b.m.types[t].name}]", t, "", [b.add(Op.Field, t, Aux.I(n: 0), [gr]), k, v]))
    b.if_then_end(ng, jg)
    b.if_then_end(np, jp)
  }
  let lv2 = b.call(gput, lt, "", [lvt, k, v])
  let lg2 = b.call("list.set", ll, "", [b.add(Op.Field, ll, Aux.I(n: 0), [tk]), b.cint(0), lv2])
  let n2 = b.add(Op.Field, it, Aux.I(n: 4), [b.mf(lt, 0, b.call("list.index", lt, "", [lg2, b.cint(0)]))])
  b.retv(b.add(Op.SetField, t, Aux.I(n: 4), [b.add(Op.SetField, t, Aux.I(n: 5), [mp, lg2]), n2]))
  b.if_then_end(nl, jl)
  let lv = b.call(conv, lt, "", [mp])
  b.retv(b.maph_of_log(t, b.call(gput, lt, "", [lv, k, v])))
  b.finish_fn()
  b.end(saved)
  name
}

/// The functions maph_rem_pro's code calls.
fn (var b: Builder) maph_prep_rem(t: Int, ot: Int) {
  let _s = b.maph_slowrem(t, ot)
}

/// The hybrid's start of xo.map.remove[T] (maph_put_pro's, for remove: it
/// writes the live flags).
fn (var b: Builder) maph_rem_pro(t: Int, ot: Int, mp: Int, k: Int) -> Int {
  let rt = b.m.tuple([t, ot])
  let (nl, jl) = b.if_then_begin(b.maph_slow(t, mp, b.mfield(t, 2, mp)))
  b.retv(b.call(b.maph_slowrem(t, ot), rt, "", [mp, k]))
  b.if_then_end(nl, jl)
  b.maph_shared(b.mfield(t, 2, mp))
}

/// xo.maph.slowrem[T](m, k) -> (T, V?) (ssa.cold_fn): maph_slowput's,
/// for remove.
fn (var b: Builder) maph_slowrem(t: Int, ot: Int) -> Str {
  let it = b.int_t()
  let kt = map_key(b.m, t)
  let lt = b.maph_lt(t)
  let grem = b.mlog_remove(lt, ot)
  let conv = b.maph_tolog(t)
  let rt = b.m.tuple([t, ot])
  let lrt = b.m.tuple([lt, ot])
  let name = "xo.maph.slowrem[${b.m.types[t].name}]${opt_suffix(b.m, map_val(b.m, t), ot)}"
  let fi = b.thunk_func(name, [t, kt], [rt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let k = b.param(1)
  let ll = b.m.types[t].fields[5].ty
  if b.m.map_branch {
    // a large lists value written while shared: a fork of its lists
    let (nb, jb) = b.if_then_begin(b.maph_branches(t, mp))
    let rb = b.call(grem, lrt, "", [b.maph_fork_lists(t, mp), k])
    b.retv(b.add(Op.Tuple, rt, Aux.None, [b.maph_of_log(t, b.add(Op.Field, lt, Aux.I(n: 0), [rb])), b.add(Op.Field, ot, Aux.I(n: 1), [rb])]))
    b.if_then_end(nb, jb)
  }
  let (nl, jl) = b.if_then_begin(b.maph_is_log(t, mp))
  let tk = b.call("list.take", b.m.tuple([ll, lt]), "", [b.mfield(t, 5, mp), b.cint(0)])
  let r = b.call(grem, lrt, "", [b.add(Op.Field, lt, Aux.I(n: 1), [tk]), k])
  let lg2 = b.call("list.set", ll, "", [b.add(Op.Field, ll, Aux.I(n: 0), [tk]), b.cint(0), b.add(Op.Field, lt, Aux.I(n: 0), [r])])
  let n2 = b.add(Op.Field, it, Aux.I(n: 4), [b.mf(lt, 0, b.call("list.index", lt, "", [lg2, b.cint(0)]))])
  let m2 = b.add(Op.SetField, t, Aux.I(n: 4), [b.add(Op.SetField, t, Aux.I(n: 5), [mp, lg2]), n2])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [m2, b.add(Op.Field, ot, Aux.I(n: 1), [r])]))
  b.if_then_end(nl, jl)
  let lv = b.call(conv, lt, "", [mp])
  let r2 = b.call(grem, lrt, "", [lv, k])
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.maph_of_log(t, b.add(Op.Field, lt, Aux.I(n: 0), [r2])), b.add(Op.Field, ot, Aux.I(n: 1), [r2])]))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.maph.list[T] (map_list of a hybrid map: the lists', or the table's).
fn (var b: Builder) maph_list(t: Int, what: Int) -> Str {
  let kt = map_key(b.m, t)
  let vt = map_val(b.m, t)
  let et = [kt, vt, b.m.tuple([kt, vt])][what]
  let ol = b.m.list(et)
  let lt = b.maph_lt(t)
  let llist = b.lists_list(t, what)
  let glist = b.mlog_list(lt, what)
  let name = "${["xo.maph.keys[", "xo.maph.values[", "xo.maph.entries["][what]}${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [ol], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let mp = b.param(0)
  let (nl, jl) = b.if_then_begin(b.maph_is_log(t, mp))
  b.retv(b.call(glist, ol, "", [b.call("list.index", lt, "", [b.mfield(t, 5, mp), b.cint(0)])]))
  b.if_then_end(nl, jl)
  b.retv(b.call(llist, ol, "", [mp]))
  b.finish_fn()
  b.end(saved)
  name
}

/// map_kvl of a hybrid map: the lists' keys, values and live flags, or
/// the table's live keys and values with every flag true.
fn (var b: Builder) maph_kvl(t: Int, mv: Int) -> (Int, Int, Int) {
  let it = b.int_t()
  let kl = b.m.types[t].fields[0].ty
  let vl = b.m.types[t].fields[1].ty
  let bl = b.m.types[t].fields[2].ty
  let rt = b.m.tuple([kl, vl, bl])
  let lt = b.maph_lt(t)
  let ll = b.m.types[t].fields[5].ty
  let gkv = b.mlog_kv(lt)
  // the log mode's lists, out of line (xo.maph.logkvl takes the log
  // field alone: a thunk of the whole map value once lost a borrowed
  // map's leaves on wasm, 2026-10-21); the lists mode's are its fields,
  // read here as the lists' kvl reads them
  let name = "xo.maph.logkvl[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [ll], [rt], [])
  if fi >= 0 {
    let saved = b.begin(fi, b.s.file)
    let lg = b.param(0)
    let r = b.call(gkv, b.m.tuple([kl, vl]), "", [b.call("list.index", lt, "", [lg, b.cint(0)])])
    let ks = b.add(Op.Field, kl, Aux.I(n: 0), [r])
    let n = b.call("list.len", it, "", [ks])
    let lv = b.local()
    b.write_var(lv, b.call("list.new", bl, "", [n]))
    let iv = b.local()
    let (i, head, exit) = b.for_up_to_begin(n, iv)
    b.write_var(lv, b.call("list.push", bl, "", [b.read(lv), b.cbool(true)]))
    b.for_up_to_end(i, iv, head, exit)
    b.retv(b.add(Op.Tuple, rt, Aux.None, [ks, b.add(Op.Field, vl, Aux.I(n: 1), [r]), b.read(lv)]))
    b.finish_fn()
    b.end(saved)
  }
  let join = b.new_block()
  let res = b.s.f.add_param(join, rt)
  let (yes, no) = b.branch(b.maph_is_log(t, mv))
  b.s.cur = yes
  b.jump(join, [b.call(name, rt, "", [b.mfield(t, 5, mv)])])
  b.s.cur = no
  b.jump(join, [b.add(Op.Tuple, rt, Aux.None, [b.mfield(t, 0, mv), b.mfield(t, 1, mv), b.mfield(t, 2, mv)])])
  b.seal(join)
  b.s.cur = join
  (b.add(Op.Field, kl, Aux.I(n: 0), [res]), b.add(Op.Field, vl, Aux.I(n: 1), [res]), b.add(Op.Field, bl, Aux.I(n: 2), [res]))
}

// ---------------------------------------------------------------------------
// Branching (decision 0291, branching addendum; the default on the
// native backends since 2026-10-22, XO_MAP_LOG=1 turns it off). A lists value copied and written once, again and again
// from the same base (`var c = m; c.put(k, v)` per request), copied all
// of its lists at each write: the mark is on the copy, never the base. A
// lists value of MAPH_BRANCH_MIN or more entries written while shared
// becomes instead a fork whose oldest level is its lists (maplog.xo
// mlog_level's lists part: read in place, no copy), O(1). The lists stay
// shared, so the base never writes them in place under a fork. A fork
// its only holder then writes MAPH_GOBACK times goes back to the lists
// (maph_goback): the lists' copy on write, once, then their speed (a copy
// written all over, bench/perf/xo copymut).

/// The live entries from which a lists value written while shared forks
/// its lists.
const MAPH_BRANCH_MIN = 1024
/// A fork's writes, by its only holder, that send it back to the lists.
const MAPH_GOBACK = 64

/// Whether hybrid map mp is a lists value that forks its lists when
/// written while shared.
fn (var b: Builder) maph_branches(t: Int, mp: Int) -> Int {
  let it = b.int_t()
  b.add(Op.And, b.bool_t(), Aux.None, [b.bop(Op.Gt, b.call("list.len", it, "", [b.mfield(t, 0, mp)]), b.cint(0)), b.bop(Op.Ge, b.add(Op.Field, it, Aux.I(n: 4), [mp]), b.cint(MAPH_BRANCH_MIN))])
}

/// The log table of lists value mp as a fork whose one parent is mp's
/// lists (positions 0 to their length), its next position unclaimed: the
/// key level holds the keys, live flags and slots, the value level the
/// values.
fn (var b: Builder) maph_fork_lists(t: Int, mp: Int) -> Int {
  let lt = b.maph_lt(t)
  let name = "xo.maph.fork[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t], [lt], [])
  if fi >= 0 {
    let saved = b.begin(fi, b.s.file)
    b.retv(b.maph_fork_body(t, b.param(0)))
    b.finish_fn()
    b.end(saved)
  }
  b.call(name, lt, "", [mp])
}

fn (var b: Builder) maph_fork_body(t: Int, mp: Int) -> Int {
  let it = b.int_t()
  let lt = b.maph_lt(t)
  let kt = mlog_k(b.m, lt)
  let dt = b.m.types[kt].fields[0].ty
  let il = b.m.types[kt].fields[1].ty
  let plt = b.m.types[kt].fields[7].ty
  let lvt = b.m.types[plt].elems[0]
  let vd = b.m.types[lt].fields[1].ty
  let vpt = b.m.types[lt].fields[2].ty
  let vlt = b.m.types[vpt].elems[0]
  let fs = b.m.types[t].fields
  let kname = "xo.maph.kfork[${b.m.types[kt].name}]"
  let kfi = b.thunk_func(kname, [fs[0].ty, fs[2].ty, fs[3].ty, it], [kt], [])
  if kfi >= 0 {
    let saved = b.begin(kfi, b.s.file)
    let keys = b.param(0)
    let n = b.param(3)
    let lim = b.call("list.len", it, "", [keys])
    let lvl = b.add(Op.Struct, lvt, Aux.None, [b.call("list.new", dt, "", []), b.call("list.new", il, "", []), b.cint(0), lim, keys, b.param(1), b.param(2), n])
    var ps = b.call("list.new", plt, "", [b.cint(1)])
    ps = b.call("list.push", plt, "", [ps, lvl])
    var used = b.call("list.new", il, "", [b.cint(1)])
    used = b.call("list.push", il, "", [used, lim])
    b.retv(b.add(Op.Struct, kt, Aux.None, [b.mlog_newdir(dt), b.call("list.new", il, "", []), used, lim, n, lim, b.cint(0), ps]))
    b.finish_fn()
    b.end(saved)
  }
  let kl = b.call(kname, kt, "", [b.mfield(t, 0, mp), b.mfield(t, 2, mp), b.mfield(t, 3, mp), b.add(Op.Field, it, Aux.I(n: 4), [mp])])
  let vlvl = b.add(Op.Struct, vlt, Aux.None, [b.call("list.new", vd, "", []), b.mfield(t, 1, mp)])
  var vps = b.call("list.new", vpt, "", [b.cint(1)])
  vps = b.call("list.push", vpt, "", [vps, vlvl])
  b.add(Op.Struct, lt, Aux.None, [kl, b.call("list.new", vd, "", []), vps])
}

/// xo.maph.entry[K](kl, p) -> E: the entry at position p of the key side
/// kl's view (its own, else the nearest parent level holding p).
fn (var b: Builder) maph_entry(t: Int) -> Str {
  let it = b.int_t()
  let lt = mlog_k(b.m, b.maph_lt(t))
  let et = mlog_entry_of(b.m, lt)
  let name = "xo.maph.entry[${b.m.types[lt].name}]"
  let fi = b.thunk_func(name, [lt, it], [et], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let lv = b.param(0)
  let p = b.param(1)
  let base = b.mf(lt, 3, lv)
  let (no, jo) = b.if_then_begin(b.bop(Op.Ge, p, base))
  b.retv(b.mlog_at(et, b.mf(lt, 0, lv), b.iop(Op.Sub, p, base)))
  b.if_then_end(no, jo)
  let parents = b.mf(lt, 7, lv)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(b.call("list.len", it, "", [parents]), iv)
  let lvl = b.call("list.index", lvt, "", [parents, i])
  let lb = b.add(Op.Field, it, Aux.I(n: 2), [lvl])
  let (nl, jl) = b.if_then_begin(b.bop(Op.Ge, p, lb))
  b.retv(b.mlog_lvl_at(lt, lvt, lvl, b.iop(Op.Sub, p, lb)))
  b.if_then_end(nl, jl)
  b.for_up_to_end(i, iv, ih, ix)
  b.retv(b.mlog_at(et, b.mf(lt, 0, lv), b.cint(0)))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.maph.vpos[T](lv, p) -> V: the value at position p of log table lv's
/// view (maph_entry's, for the values).
fn (var b: Builder) maph_vpos(t: Int) -> Str {
  let it = b.int_t()
  let lt = b.maph_lt(t)
  let kt = mlog_k(b.m, lt)
  let vt = mlog_val(b.m, lt)
  let name = "xo.maph.vpos[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [lt, it], [vt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let lv = b.param(0)
  let p = b.param(1)
  let kl = b.mf(lt, 0, lv)
  let base = b.mf(kt, 3, kl)
  let (no, jo) = b.if_then_begin(b.bop(Op.Ge, p, base))
  b.retv(b.mlog_at(vt, b.mf(lt, 1, lv), b.iop(Op.Sub, p, base)))
  b.if_then_end(no, jo)
  let parents = b.mf(kt, 7, kl)
  let lvt = b.m.types[b.vty(parents)].elems[0]
  let vpar = b.mf(lt, 2, lv)
  let vlt = b.m.types[b.vty(vpar)].elems[0]
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(b.call("list.len", it, "", [parents]), iv)
  let lvl = b.call("list.index", lvt, "", [parents, i])
  let lb = b.add(Op.Field, it, Aux.I(n: 2), [lvl])
  let (nl, jl) = b.if_then_begin(b.bop(Op.Ge, p, lb))
  b.retv(b.mlog_vlvl_at(vt, lvt, lvl, vlt, b.call("list.index", vlt, "", [vpar, i]), b.iop(Op.Sub, p, lb)))
  b.if_then_end(nl, jl)
  b.for_up_to_end(i, iv, ih, ix)
  b.retv(b.mlog_at(vt, b.mf(lt, 1, lv), b.cint(0)))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.maph.goback[T](lv) -> (T, Bool) (ssa.cold_fn): the lists value of
/// fork lv, whose directory has one holder: its oldest level's lists with
/// the puts after them, when that level is a lists level, MAPH_GOBACK or
/// more entries follow it and none is a removal; else (an empty map,
/// false).
fn (var b: Builder) maph_goback(t: Int) -> Str {
  let it = b.int_t()
  let bt = b.bool_t()
  let lt = b.maph_lt(t)
  let kt = mlog_k(b.m, lt)
  let et = mlog_entry_of(b.m, kt)
  let plt = b.m.types[kt].fields[7].ty
  let lvt = b.m.types[plt].elems[0]
  let lf = b.m.types[lvt].fields
  let vpt = b.m.types[lt].fields[2].ty
  let vlt = b.m.types[vpt].elems[0]
  let ent = b.maph_entry(t)
  let vpos = b.maph_vpos(t)
  let put = b.maph_listput(t)
  let rt = b.m.tuple([t, bt])
  let name = "xo.maph.goback[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [lt], [rt], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  let lv = b.param(0)
  var fs: List[Int] = []
  for i in 0..4 {
    fs.push(b.call("list.new", b.m.types[t].fields[i].ty, "", []))
  }
  let none = b.add(Op.Tuple, rt, Aux.None, [b.add(Op.Struct, t, Aux.None, fs + [b.cint(0), b.call("list.new", b.m.types[t].fields[5].ty, "", [])]), b.cbool(false)])
  let kl = b.mf(lt, 0, lv)
  let parents = b.mf(kt, 7, kl)
  let last = b.iop(Op.Sub, b.call("list.len", it, "", [parents]), b.cint(1))
  let old = b.call("list.index", lvt, "", [parents, last])
  let (nn, jn) = b.if_then_begin(b.add(Op.Not, bt, Aux.None, [b.mlog_lvl_lists(lvt, old)]))
  b.retv(none)
  b.if_then_end(nn, jn)
  let at = b.add(Op.Field, it, Aux.I(n: 3), [old])
  let cnt = b.iop(Op.Sub, b.mf(kt, 5, kl), at)
  let (nf, jf) = b.if_then_begin(b.bop(Op.Lt, cnt, b.cint(MAPH_GOBACK)))
  b.retv(none)
  b.if_then_end(nf, jf)
  let iv = b.local()
  let (i, ih, ix) = b.for_up_to_begin(cnt, iv)
  let e = b.call(ent, et, "", [kl, b.iop(Op.Add, at, i)])
  let (nr, jr) = b.if_then_begin(b.bop(Op.Lt, b.add(Op.Field, it, Aux.I(n: 2), [e]), b.cint(0)))
  b.retv(none)
  b.if_then_end(nr, jr)
  b.for_up_to_end(i, iv, ih, ix)
  let mv = b.local()
  let vold = b.call("list.index", vlt, "", [b.mf(lt, 2, lv), last])
  b.write_var(mv, b.add(Op.Struct, t, Aux.None, [b.add(Op.Field, lf[4].ty, Aux.I(n: 4), [old]), b.add(Op.Field, b.m.types[vlt].fields[1].ty, Aux.I(n: 1), [vold]), b.add(Op.Field, lf[5].ty, Aux.I(n: 5), [old]), b.add(Op.Field, lf[6].ty, Aux.I(n: 6), [old]), b.add(Op.Field, it, Aux.I(n: 7), [old]), b.call("list.new", b.m.types[t].fields[5].ty, "", [])]))
  let jv = b.local()
  let (j, jh, jx) = b.for_up_to_begin(cnt, jv)
  let pj = b.iop(Op.Add, at, j)
  let e2 = b.call(ent, et, "", [kl, pj])
  b.write_var(mv, b.call(put, t, "", [b.read(mv), b.add(Op.Field, b.m.types[et].fields[3].ty, Aux.I(n: 3), [e2]), b.call(vpos, mlog_val(b.m, lt), "", [lv, pj])]))
  b.for_up_to_end(j, jv, jh, jx)
  b.retv(b.add(Op.Tuple, rt, Aux.None, [b.read(mv), b.cbool(true)]))
  b.finish_fn()
  b.end(saved)
  name
}

/// xo.maph.listput[T](m, k, v) -> T: the lists' put alone (the first
/// copies the shared lists on write; maph_goback's replay, which the
/// hybrid's put would fork again).
fn (var b: Builder) maph_listput(t: Int) -> Str {
  let kt = map_key(b.m, t)
  let vt = map_val(b.m, t)
  let rebuild = b.map_rebuild(t)
  let hash = b.hash_func(kt)
  let name = "xo.maph.listput[${b.m.types[t].name}]"
  let fi = b.thunk_func(name, [t, kt, vt], [t], [])
  if fi < 0 {
    return name
  }
  let saved = b.begin(fi, b.s.file)
  b.put_body(t, b.param(0), b.param(1), b.param(2), -1, rebuild, hash)
  b.finish_fn()
  b.end(saved)
  name
}
