// The front end cache (decision 0220 addendum stage 2, step 1): a
// function body's SSA, as the builder made it, by the hash of what the
// building reads. A hit replays the body's effects on the builder (the
// types it interned, the functions it declared, its unwinding checks)
// and places its function from the entry instead of building it.
//
// The key (fe_keys, computed before the build from the checked program):
// the build's flags, the interface closure of the body's module (its
// files with every function body cut out, and the same of every module
// it imports, transitively, and of the standard library), the body's
// file, position, and declaration text. The flags only the builder knows
// (concurrency, budgets) are in the entry and compared.
//
// An entry holds no index and no state of the builder (decision 0271):
// what the body found that was there before it, and what it made in
// order, by name; the commit (fe_replay) checks the first and replays
// the second, so the types and functions it adds get the indices a
// serial build at this point gives them. Bodies that make or read other
// state (new generic instances, closures, constants, thunks, type ids,
// spawn sites) are not cached yet.

use std/crypto
use github.com/xo-lang/xo/compiler/check

const FE_CACHE_VERSION = "xo front cache v13"

/// The front end cache of one build: entries by key (fe_keys), the
/// entries to store, and counts.
pub struct FeCache {
  pub on: Bool = false
  /// every body built and compared with its entry
  pub verify: Bool = false
  /// per function object: its key ("" when not cached)
  pub keys: Map[Int, Str] = {}
  pub entries: Map[Str, Bytes] = {}
  pub stores: List[(Str, Bytes)] = []
  pub hits: Int = 0
  /// per function index: the entry its body replayed (a hit) or was
  /// recorded as (a miss whose entry was sealed at once), which fixes the
  /// body as built; the cleanup cache's key hashes it (cln_key). Not the
  /// entry's key: an entry whose checks fail is replaced under the same
  /// key by a body built anew.
  pub body_entries: Map[Int, Bytes] = {}
  pub misses: Int = 0
  pub mismatches: List[Str] = []
  /// the build starts with unwinding checks (Builder.conc): the last
  /// build of the program needed them (xo bcache.xo's hint)
  pub start_conc: Bool = false
  /// the keys of entries whose checks passed but whose commit did not
  /// (a front end cache bug): the driver builds again without them
  pub bad: List[Str] = []
  /// the last commit failed (fe_replay), for run_job_fe to note its key
  broken: Bool = false
  /// the xo that records entries (its identity, xo bcache.xo self_id),
  /// written in each entry so a failed commit names who made the entry
  pub recorder: Str = ""
  /// the recorder of the entry being committed
  last_recorder: Str = ""
  /// a test hook (XO_FE_BREAK): the commit of this function's entry
  /// fails, as an entry that does not replay does
  pub break_name: Str = ""
  /// the entries of bodies that made closures, waiting for their
  /// closures' entries (fe_finalize): key, entry, the closures in order
  pub pending: List[(Str, Bytes, List[Int])] = []
  /// a closure's entry when its job recorded one, and the closures it
  /// made in turn; a closure in no_clos recorded none
  pub clos_rec: Map[Int, (Bytes, List[Int])] = {}
  pub no_clos: Map[Int, Bool] = {}
  /// the key of the entry being committed (its closures' replay jobs
  /// name it when one fails)
  pub cur_key: Str = ""
  /// the first line of the declaration whose body is being built or
  /// replayed (0 for a closure's): an entry's lines are kept relative to
  /// it, so a body that moved replays (fe_entry, fe_replay)
  pub cur_line: Int = 0
  /// qualified name to function object, built on the first replay
  by_ident: Map[Str, Int] = {}
}

/// The keys of the bodies the builder may take from the cache: every
/// function that is not generic and has a body. flags are the build's
/// (fe_flags). A body of std, the prelude or the native runtime is keyed
/// by std_sum (every std source, xo bcache.xo std_tree_sum) and whether
/// the build has a root (its positions name std files the same either
/// way), not by what this program loads, so its entry serves every
/// program (decision 0271 step 1b, for the shared std cache); a program
/// module's body by its interface closure and the root.
pub fn fe_keys(c: check.Checker, flags: Str, root: Str, std_sum: Str) -> Map[Int, Str] {
  let closure = c.iface_closures()
  // a std module the build has as its root (xo test --std-module): its
  // functions are named as the main module's (unprefixed), so a std body
  // calling them names them so; std bodies key on it ("" for a program)
  var std_roots: List[Str] = []
  for md in c.mods {
    if md.root && (md.is_std || md.is_prelude || md.native) {
      std_roots.push(md.path)
    }
  }
  let rootsk = std_roots.sort().join(",")
  var keys: Map[Int, Str] = {}
  for (fo, o) in c.objs.indexed() {
    if o.kind != check.ObjKind.Func || o.fn_decl.is_empty() || o.decl_file < 0 || o.module < 0 || !o.tparams.is_empty() {
      continue
    }
    if o.recv >= 0 && !c.objs[o.recv].tparams.is_empty() {
      continue
    }
    let fd = o.fn_decl[0]
    if fd.body == None {
      continue
    }
    let src = c.files[o.decl_file].src
    if fd.span.end.offset > src.len() || fd.span.start.offset < 0 {
      continue
    }
    let md = c.mods[o.module]
    // a root module (a std module under test, --std-module) is the
    // program's own: its functions are named and built as the main
    // module's
    // a program module's body by whether its module is the build's root
    // too: a root module's functions are named unprefixed, a library's
    // with its module, so an entry `xo test compiler/ssa` recorded called
    // value_self_faults by the name a build importing ssa lacks (an
    // unknown runtime call there, 2026-10-21)
    let whose = if (md.is_std || md.is_prelude || md.native) && !md.root && !std_sum.is_empty() { "std ${std_sum} rooted=${!root.is_empty()} std_roots=${rootsk}" } else { "${closure[o.module]} root=${root} rootmod=${md.root}" }
    var h = BytesBuilder.new()
    // the declaration's column, not its line: an entry's lines are
    // relative to the declaration's (fe_entry), so a body that moved (an
    // edit above it) keeps its entry
    h.write_str("${FE_CACHE_VERSION}\n${flags}\nlower=${c.lower_off.join(",")}\n${whose}\n${c.files[o.decl_file].path}\n${fd.span.start.col}\n")
    h.write(src[fd.span.start.offset..fd.span.end.offset])
    keys[fo] = crypto.sha256(h.freeze()).to_hex()
  }
  keys
}

/// The key of body key's entry for a builder of own flags own
/// (fe_own_flags): entries of a program with tasks and of one without
/// differ, and both are kept.
pub fn fe_variant(key: Str, own: Str) -> Str {
  crypto.sha256("${key}\n${own}".bytes()).to_hex()
}

/// The two common own flags (fe_own_flags): a build without and with
/// concurrency, no budgets, no realtime. A build with no hint (its first)
/// reads both variants of each key.
pub fn fe_common_owns() -> List[Str] {
  ["conc=false budgets=false scan=false rt=false", "conc=true budgets=false scan=false rt=false"]
}

/// The own flags the build ended with: the hint for the next build of
/// the program (the variant it reads, and whether it starts with
/// unwinding checks).
pub fn (var b: Builder) fe_final_own() -> Str {
  b.fe_own_flags()
}

/// The builder's flags in a key, for build_program_guard's arguments.
pub fn fe_flags(line_root: Str, tests: Bool, release: Bool, real_tests: Bool, goos: Str, goarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace_support: Bool, soft_cpu: Bool, heap_guard: Bool) -> Str {
  "tests=${tests} release=${release} real=${real_tests} os=${goos} arch=${goarch} wasm=${wasm} nolibc=${nolibc} prof=${prof} trace=${trace_support} soft=${soft_cpu} guard=${heap_guard}"
}

/// The flags the builder sets itself, compared with an entry's.
fn (var b: Builder) fe_own_flags() -> Str {
  "conc=${b.conc} budgets=${b.budgets} scan=${b.scan_budget} rt=${b.user_realtime()}"
}

/// FNV-1a over s, continued from h.
fn fe_mix(h: Int, s: Str) -> Int {
  var x = h
  for c in s.bytes() {
    x = (x ^ Int(c)).wrapping_mul(1099511628211)
  }
  (x ^ 10).wrapping_mul(1099511628211)
}

/// What a body may change and an entry not replay: when any differs
/// after the body, it is not cached.
fn (b: Builder) fe_fixed() -> Str {
  "${b.gens.len()} ${b.ifaces.len()} ${b.tids.len()} ${b.natives.len()} ${b.late_tids.len()} ${b.nsyn} ${b.skipped_any} ${b.errs.len()} ${b.seen_err.len()} ${b.why} ${b.c.types.len()} ${b.c.diags.len()}"
}

/// A function object's qualified name: module path, receiver type, name.
fn (b: Builder) fe_ident(fo: Int) -> Str {
  let o = b.c.objs[fo]
  let m = if o.module >= 0 { b.c.mods[o.module].path } else { "" }
  let r = if o.recv >= 0 { txt(b.c.objs[o.recv].name) } else { "" }
  "${m}|${r}|${txt(o.name)}"
}

fn txt(x: Bytes) -> Str {
  x.to_str() ?? ""
}

/// The recording of one body: the module before it.
struct FeRec {
  fixed: Str
  nt: Int
  nf: Int
  nq: Int
  nc: Int
  nvar: Int
  nclos: Int
  nconst: Int
  mods: Map[Str, Bool]
}

fn (var b: Builder) fe_begin() -> FeRec {
  b.fe_rec = true
  b.fe_gen = false
  b.fe_greads = []
  b.fe_touched = ""
  b.m.fe_log = true
  b.m.fe_treads = {}
  b.m.fe_freads = {}
  b.m.fe_fabsent = {}
  b.fe_flagbits = 0
  b.m.fe_ev = []
  b.fe_site0 = b.sites.len()
  FeRec{fixed: b.fe_fixed(), nt: b.m.types.len(), nf: b.m.funcs.len(), nq: b.queue.len(), nc: b.checks.len(), nvar: b.nvar, nclos: b.nclos, nconst: b.consts.len(), mods: b.decl_mods}
}

/// The name of type t in an entry ("" for none); a type its name does
/// not find (a second type of one name) keeps the body out.
fn (var b: Builder) fe_tname(t: Int) -> Str {
  if t < 0 {
    return ""
  }
  let n = b.m.types[t].name
  if (b.m.type_at.get(n) ?? -1) != t {
    b.fe_touched = "shadowed"
  }
  n
}

/// The entry of the body just built into fi, none when it may not be
/// cached. It holds what the body found that was there before it (the
/// commit's checks), what it made in order (types, order entries, whole
/// functions, declares; the commit's replay), all by name, then the
/// body: no index and no state of the builder (decision 0271).
fn (var b: Builder) fe_entry(r: FeRec, fi: Int) -> Option[Bytes] {
  b.fe_rec = false
  b.m.fe_log = false
  if b.fe_gen || b.fe_fixed() != r.fixed || !b.m.funcs[fi].skip.is_empty() || !b.fe_touched.is_empty() {
    if b.fe_gen {
      b.fe_skip("gen")
    } else if !b.fe_touched.is_empty() {
      b.fe_skip("read.${b.fe_touched}")
    } else if b.fe_fixed() != r.fixed {
      // which side table the body changed (XO_FE_STATS)
      let names = ["gens", "ifaces", "tids", "natives", "late_tids", "nsyn", "skipped_any", "errs", "seen_err"]
      let was = r.fixed.split(" ")
      let now = b.fe_fixed().split(" ")
      for (i, n) in names.indexed() {
        if i < was.len() && i < now.len() && was[i] != now[i] {
          b.fe_skip("fixed.${n}")
        }
      }
    } else {
      b.fe_skip("skip")
    }
    return None
  }
  // the closures it made: each an event 5 (fe_closure_made), their
  // bodies' entries added when their jobs ran (fe_finalize)
  var made_c: Map[Int, Bool] = {}
  for (k, x) in b.m.fe_ev {
    if k == 5 {
      made_c[x] = true
    }
  }
  if made_c.len() != b.nclos - r.nclos {
    b.fe_skip("fixed.nclos")
    return None
  }
  // only declares' bodies and its closures queued: a contract's inner
  // body (Job.Inner) is not replayed
  for j in b.queue[r.nq..b.queue.len()] {
    match j {
      Body(..) => {}
      Closure(cf, _, _, _, _, _, _, _, _, _, _, _) => {
        if !made_c.contains(cf) {
          b.fe_skip("queue")
          return None
        }
      }
      Inner(..) | Test(..) | ClosureReplay(..) => {
        b.fe_skip("queue")
        return None
      }
    }
  }
  // the unwinding checks of the body itself
  for c in b.checks[r.nc..b.checks.len()] {
    if c.fi != fi {
      b.fe_skip("checks")
      return None
    }
  }
  // the body's lines relative to its declaration's: pinned to the line
  // (replayed only there) when it cannot be moved, or made closures
  let base = b.fe.cur_line
  var body = b.m.funcs[fi]
  var pinned = base <= 0 || !made_c.is_empty() || !relocatable(body, base)
  // a function it made whole with source lines: its lines are its own
  // file's, which a closure without layout (iface_closures) does not
  // cover; in the body's file the entry is pinned, elsewhere not kept
  for (k, x) in b.m.fe_ev {
    if k == 3 && !b.m.funcs[x].file.is_empty() {
      if b.m.funcs[x].file != body.file {
        b.fe_skip("made.file")
        return None
      }
      pinned = true
    }
  }
  if !pinned {
    shift_lines(body, 1 - base)
  }
  let fbo = encode_func(b.m, body)
  if fbo == None {
    return None
  }
  var e = EntryW{b: BytesBuilder.new()}
  e.str(FE_CACHE_VERSION)
  e.str(b.fe_own_flags())
  e.str(b.fe.recorder)
  e.uv(base.max(0))
  e.bool(pinned)
  // the body and what it does to the builder itself: the same whichever
  // builder made the entry but for the module list (fe_same compares the
  // rest for verify, tail_sans_mods)
  var tl = EntryW{b: BytesBuilder.new()}
  tl.uv(b.checks.len() - r.nc)
  for c in b.checks[r.nc..b.checks.len()] {
    tl.uv(c.u)
    tl.str(c.callee)
    tl.sv(c.w)
  }
  tl.sv(b.nvar - r.nvar)
  var mods: List[Str] = []
  for (k, _) in b.decl_mods {
    if !r.mods.contains(k) {
      mods.push(k)
    }
  }
  tl.uv(mods.len())
  for k in mods.sort() {
    tl.str(k)
  }
  tl.bool(b.m.funcs[fi].target)
  tl.uv(b.fe_flagbits)
  tl.bytes(fbo ?? b"")
  e.bytes(tl.b.freeze())
  // what it found that was there before it
  var reads: List[Str] = []
  for (t, _) in b.m.fe_treads {
    if t < r.nt {
      reads.push("t ${b.m.types[t].name}")
    }
  }
  for (i, _) in b.m.fe_freads {
    if i < r.nf {
      reads.push("f ${b.m.funcs[i].name}")
    }
  }
  // what it looked for and did not find, and the functions it made
  // whole: absent at a commit too (another function of the name may be
  // another function)
  var absent: Map[Str, Bool] = {}
  for (n, _) in b.m.fe_fabsent {
    absent[n] = true
  }
  for (k, x) in b.m.fe_ev {
    if k == 3 {
      absent[b.m.funcs[x].name] = true
    }
  }
  for (n, _) in absent {
    reads.push("a ${n}")
  }
  e.uv(reads.len())
  for k in reads.sort() {
    e.str(k)
  }
  e.uv(b.fe_greads.len())
  for (k, n) in b.fe_greads {
    e.str(k)
    e.str(n)
  }
  // what it made, in order
  e.uv(b.m.fe_ev.len())
  var made_t: List[Int] = []
  var made_f: List[Int] = []
  for (k, x) in b.m.fe_ev {
    e.uv(k)
    if k == 1 {
      let t = b.m.types[x]
      e.str(kind_text(t.kind))
      e.str(b.fe_tname(x))
      made_t.push(x)
    } else if k == 2 {
      e.str(b.fe_tname(x))
    } else if k == 3 {
      e.str(b.m.funcs[x].name)
      made_f.push(x)
    } else if k == 5 {
      // a closure: its name as made here (renamed at a commit) and its
      // function as made, before its job built the body: parameters,
      // results, captures by type name, whether it catches
      let cf = b.m.funcs[x]
      e.str(cf.name)
      let ps = cf.blocks[0].params
      e.uv(ps.len())
      for v in ps {
        e.str(b.fe_tname(cf.values[v].ty))
      }
      e.uv(cf.results.len())
      for t in cf.results {
        e.str(b.fe_tname(t))
      }
      e.uv(cf.captures.len())
      for t in cf.captures {
        e.str(b.fe_tname(t))
      }
      e.bool(cf.catches)
    } else if k == 6 {
      // a constant: its function's name, and whether this body made it
      // (its function is then one of the functions made whole)
      e.str(b.const_names[x])
      e.bool(x >= r.nconst)
    } else if k == 7 {
      // a thunk: its function's identity and its own name, and whether
      // this body made it (one of the functions made whole)
      e.str(b.fe_ident(b.thunk_of.get(x) ?? -1))
      e.str(b.m.funcs[x].name)
      e.bool(x >= r.nf)
    } else if k == 8 {
      // a spawn site: its number here, renumbered at a commit
      e.uv(x)
    } else {
      e.str(b.fe_ident(x))
    }
  }
  // the structure of the types made, by name
  for t in made_t {
    let x = b.m.types[t]
    e.uv(x.fields.len())
    for f in x.fields {
      e.str(f.name)
      e.str(b.fe_tname(f.ty))
    }
    e.uv(x.variants.len())
    for v in x.variants {
      e.str(v.name)
      e.uv(v.fields.len())
      for f in v.fields {
        e.str(f.name)
        e.str(b.fe_tname(f.ty))
      }
    }
    e.uv(x.elems.len())
    for el in x.elems {
      e.str(b.fe_tname(el))
    }
    e.str(b.fe_tname(x.ret))
    e.bool(x.coll)
    e.sv(x.bits)
    e.bool(x.unsigned)
  }
  // the functions made whole (helpers such as xo.hash[T])
  for i in made_f {
    let hb = encode_func(b.m, b.m.funcs[i])
    if hb == None {
      return None
    }
    e.bool(b.m.funcs[i].target)
    e.bytes(hb ?? b"")
  }
  if !b.fe_touched.is_empty() {
    b.fe_skip(b.fe_touched)
    return None
  }
  if !e.ok {
    return None
  }
  Some(e.b.freeze())
}

/// Whether entries a and b make the same body with the same effects on
/// the builder (verify): their version, flags, and tail without its
/// module list (tail_sans_mods); what each found and made depends on the
/// builder that recorded it, and the xo that recorded it (v8's recorder)
/// is not compared.
fn fe_same(a: Bytes, b: Bytes) -> Bool {
  var x = EntryR{d: a}
  var y = EntryR{d: b}
  let same_head = x.str() == y.str() && x.str() == y.str()
  let _xr = x.str()
  let _yr = y.str()
  // the declaration's line and whether the entry is pinned to it: where
  // the body was, not what it is
  let _xl = x.uv()
  let _yl = y.uv()
  let _xp = x.bool()
  let _yp = y.bool()
  let xt = x.bytes()
  let yt = y.bytes()
  let same_tail = match (tail_sans_mods(xt), tail_sans_mods(yt)) {
    (Some(p), Some(q)) => p == q
    _ => xt == yt
  }
  same_head && same_tail && x.ok && y.ok
}

/// An entry's tail (fe_entry's tl) without its module list, or None when
/// it is not a tail fe_entry wrote. The list holds the modules the body
/// was the first to build code of, which depends on what the builder
/// built before it (decl_mods only grows), so one body recorded in two
/// programs differs there; a replay declares the body's functions again
/// (its declare events, declare0), which adds their modules, so the
/// list's contents never change what a replay builds (2026-10-23:
/// XO_BACKEND_CACHE=verify failed on entries another golden recorded,
/// with byte-identical binaries).
fn tail_sans_mods(t: Bytes) -> Option[Bytes] {
  let (pre, mid, body) = tail_split(t)?
  var w = EntryW{b: BytesBuilder.new()}
  w.b.write(pre)
  w.b.write(mid)
  w.bytes(body)
  Some(w.b.freeze())
}

/// A tail's parts: what comes before its module list, what comes after
/// it up to the body (target and flag bits), and the encoded body.
fn tail_split(t: Bytes) -> Option[(Bytes, Bytes, Bytes)] {
  var r = EntryR{d: t}
  let nc = r.uv()
  if !r.ok || nc > t.len() {
    return None
  }
  for _ in 0..nc {
    let _u = r.uv()
    let _c = r.str()
    let _w = r.sv()
  }
  let _nvar = r.sv()
  let mods_at = r.at
  let nm = r.uv()
  if !r.ok || nm > t.len() {
    return None
  }
  for _ in 0..nm {
    let _m = r.str()
  }
  let mid_at = r.at
  let _target = r.bool()
  let _flagbits = r.uv()
  let body_at = r.at
  let body = r.bytes()
  if !r.ok || r.at != t.len() {
    return None
  }
  Some((t[0..mods_at], t[mid_at..body_at], body))
}

/// fe_same, with the closures and constants each body names numbered
/// alike: a replay numbers both as the build here numbers them
/// (fe_replay's renames, fe_const_ids), so one body recorded where other
/// bodies had been replayed or built before it (http.call_raw.fn17
/// against fn22, 2026-10-23) builds the same code. Verify's comparison.
fn (b: Builder) fe_same_numbered(a: Bytes, e: Bytes) -> Bool {
  if fe_same(a, e) {
    return true
  }
  let (xh, xt) = entry_head_tail(a) ?? ("", b"")
  let (yh, yt) = entry_head_tail(e) ?? ("", b"")
  if xh.is_empty() || xh != yh {
    return false
  }
  match (tail_split(xt), tail_split(yt)) {
    (Some((xp, xm, xb)), Some((yp, ym, yb))) => {
      if xp != yp || xm != ym {
        return false
      }
      let nb = b.numbered_body(xb)
      nb != None && nb == b.numbered_body(yb)
    }
    _ => false
  }
}

/// An entry's version and flags (what fe_same compares of its head) and
/// its tail; None when it does not decode.
fn entry_head_tail(d: Bytes) -> Option[(Str, Bytes)] {
  var r = EntryR{d: d}
  let v = r.str()
  let own = r.str()
  let _recorder = r.str()
  let _line = r.uv()
  let _pinned = r.bool()
  let t = r.bytes()
  if !r.ok {
    return None
  }
  Some(("${v}\n${own}", t))
}

/// An encoded body with its closures numbered by first use and its
/// constants' numbers zeroed (fe_same_numbered), re-encoded; None when
/// it does not decode.
fn (b: Builder) numbered_body(d: Bytes) -> Option[Bytes] {
  var f = decode_func(b.m, d, op_names())?
  var clos: Map[Str, Str] = {}
  for i in 0..f.values.len() {
    if f.values[i].op is Op.Call | Op.FuncAddr | Op.Closure | Op.Rebind {
      if let S(s) = f.values[i].aux {
        if closure_name(s) {
          if !clos.contains(s) {
            clos[s] = "closure#${clos.len()}"
          }
          f.values[i].aux = Aux.S(s: clos.get(s) ?? s)
        } else if s == "rt.const_once" && f.values[i].args.len() == 3 {
          f.values[f.values[i].args[2]].aux = Aux.I(n: 0)
        }
      }
    }
  }
  encode_func(b.m, f)
}

/// Whether s names a closure as the builder names them: NAME.fnN.
fn closure_name(s: Str) -> Bool {
  let d = s.bytes()
  var i = d.len()
  while i > 0 && Int(d[i - 1]) >= 48 && Int(d[i - 1]) <= 57 {
    i -= 1
  }
  i < d.len() && i >= 4 && d[i - 3..i] == b".fn"
}

/// Whether a commit of entry d would pass its checks here (fe_replay's,
/// without changing anything): what the body found is here, what it
/// found absent and made whole is not, its generic instances and
/// declared functions are found.
fn (var b: Builder) fe_applies(d: Bytes) -> Bool {
  var r = EntryR{d: d}
  if r.str() != FE_CACHE_VERSION || r.str() != b.fe_own_flags() {
    return false
  }
  let _recorder = r.str()
  let line = r.uv()
  if r.bool() && line != b.fe.cur_line {
    return false
  }
  let _tail = r.bytes()
  let nr = r.uv()
  if !r.ok || nr > d.len() {
    return false
  }
  for _ in 0..nr {
    let k = r.str()
    let n = k[2..k.len()]
    let ok = if k.starts_with("t ") { b.m.type_at.contains(n) } else if k.starts_with("a ") { !b.m.func_at.contains(n) } else { b.m.func_at.contains(n) }
    if !ok {
      return false
    }
  }
  let ng = r.uv()
  if !r.ok || ng > d.len() {
    return false
  }
  for _ in 0..ng {
    let k = r.str()
    let _n = r.str()
    if !b.funcs.contains(k) {
      return false
    }
  }
  r.ok
}

/// One event of an entry (fe_entry): its kind, its name, and for a
/// declare the function object.
struct FeEv {
  k: Int
  s: Str
  fo: Int = -1
  /// a closure's (k 5) parameters, results and captures by type name,
  /// and whether it catches
  ps: List[Str] = []
  rs: List[Str] = []
  caps: List[Str] = []
  catches: Bool = false
}

/// Commits entry d for the body of function fi: true when it was placed,
/// false (nothing changed) when the entry does not fit this module. The
/// checks come first: what the body found must be here (else a build
/// would make it where the body ran, so the entry is a miss), and each
/// generic instance it calls is found by its key (its name may differ:
/// `#n`). Then its events in order: a type made unless one of its name
/// is here, an order entry for a type made now, a whole function made
/// unless one of its name is here, a declare run as a build runs it.
/// Then the types made get their fields, by name, and the functions
/// their bodies. So the module grows as a serial build at this point
/// grows it (decision 0271).
fn (var b: Builder) fe_replay(d: Bytes, fi: Int) -> Bool {
  var r = EntryR{d: d}
  if r.str() != FE_CACHE_VERSION {
    return b.fe_miss("version")
  }
  if r.str() != b.fe_own_flags() {
    return b.fe_miss("flags")
  }
  b.fe.last_recorder = r.str()
  let line = r.uv()
  let pinned = r.bool()
  if pinned && line != b.fe.cur_line {
    return b.fe_miss("moved")
  }
  // the body's lines were kept relative to its declaration's
  let shift = if pinned { 0 } else { b.fe.cur_line - 1 }
  let tail = r.bytes()
  let nr = r.uv()
  if !r.ok || nr > d.len() {
    return b.fe_miss("malformed")
  }
  for _ in 0..nr {
    let k = r.str()
    let n = k[2..k.len()]
    if k.starts_with("t ") {
      if !b.m.type_at.contains(n) {
        return b.fe_miss("read")
      }
    } else if k.starts_with("a ") {
      // a constant's function made whole here may be there already,
      // made by another body: the commit keeps that one
      if b.m.func_at.contains(n) && !fe_const_fn(n) && !b.fe_thunk_there(n) {
        return b.fe_miss("absent")
      }
    } else if !b.m.func_at.contains(n) {
      return b.fe_miss("read")
    }
  }
  let ng = r.uv()
  if !r.ok || ng > d.len() {
    return b.fe_miss("malformed")
  }
  var renames: Map[Str, Str] = {}
  for _ in 0..ng {
    let k = r.str()
    let n = r.str()
    match b.funcs.get(k) {
      Some(f) => {
        if b.m.funcs[f].name != n {
          renames[n] = b.m.funcs[f].name
        }
      }
      None => return b.fe_miss("generic")
    }
  }
  if b.fe.by_ident.is_empty() {
    for (fo, o) in b.c.objs.indexed() {
      if o.kind == check.ObjKind.Func {
        b.fe.by_ident[b.fe_ident(fo)] = fo
      }
    }
  }
  var kinds: Map[Str, Kind] = {}
  for k in all_kinds() {
    kinds[kind_text(k)] = k
  }
  // read everything before changing anything
  let ne = r.uv()
  if !r.ok || ne > d.len() {
    return b.fe_miss("malformed")
  }
  var evs: List[FeEv] = []
  var cnew: Map[Str, Bool] = {}
  var tnew: Map[Str, Bool] = {}
  var sites: Map[Int, Int] = {}
  var nmt = 0
  var nmf = 0
  for _ in 0..ne {
    let k = r.uv()
    if k == 1 {
      let ks = r.str()
      if !kinds.contains(ks) {
        return b.fe_miss("malformed")
      }
      evs.push(FeEv{k: 1, s: r.str(), fo: kind_index(kinds.get(ks) ?? Kind.Bad)})
      nmt += 1
    } else if k == 2 || k == 3 {
      evs.push(FeEv{k: k, s: r.str()})
      if k == 3 {
        nmf += 1
      }
    } else if k == 4 {
      let fo = b.fe.by_ident.get(r.str()) ?? -1
      if fo < 0 {
        return b.fe_miss("ident")
      }
      evs.push(FeEv{k: 4, s: "", fo: fo})
    } else if k == 5 {
      var x = FeEv{k: 5, s: r.str()}
      for _ in 0..r.uv() {
        x.ps.push(r.str())
      }
      for _ in 0..r.uv() {
        x.rs.push(r.str())
      }
      for _ in 0..r.uv() {
        x.caps.push(r.str())
      }
      x.catches = r.bool()
      if !r.ok {
        return b.fe_miss("malformed")
      }
      evs.push(x)
    } else if k == 6 {
      // a constant made before the body must be there at the commit;
      // one the body made is made there unless another body made it
      // first (its function is the same, by its name: the commit keeps
      // the one there), so a body's entry does not depend on which of
      // the bodies reading a constant the build reaches first
      let n = r.str()
      let made = r.bool()
      if !r.ok {
        return b.fe_miss("malformed")
      }
      let there = b.consts.contains(n) || cnew.contains(n)
      if !made && !there {
        return b.fe_miss("const")
      }
      if made && !there {
        cnew[n] = true
      }
      evs.push(FeEv{k: 6, s: n})
    } else if k == 7 {
      let fo = b.fe.by_ident.get(r.str()) ?? -1
      let n = r.str()
      let made = r.bool()
      if !r.ok || fo < 0 {
        return b.fe_miss("ident")
      }
      let key = "${fo}:${b.func_name(fo)}"
      let there = b.thunks.contains(key) || tnew.contains(key)
      // a thunk the body made that another body made first: the commit
      // keeps that one, as for a constant's function, when it is the
      // thunk this entry made (same target function, name and signature);
      // before, the body missed on every build that made the thunk
      // elsewhere first (dce_values' main, 2026-10-23)
      var made_there = false
      if made && b.thunks.contains(key) {
        let w = b.thunks.get(key) ?? -1
        made_there = thunk_replay_ok(b.m.funcs[w].name, b.thunk_of.get(w) ?? -1, b.thunk_sig(w), n, fo, b.thunk_sig_of(n))
        if !made_there {
          return b.fe_miss("thunk")
        }
      }
      // the same body's second record of making it (dce_values' main
      // names inc in a list and in an if's arms): one thunk, which the
      // commit makes once
      let made_again = made && tnew.contains(key) && !b.thunks.contains(key)
      if made == there && !made_there && !made_again {
        return b.fe_miss("thunk")
      }
      if made && !made_there {
        tnew[key] = true
      } else if !tnew.contains(key) && b.m.funcs[b.thunks.get(key) ?? 0].name != n {
        return b.fe_miss("thunk")
      }
      evs.push(FeEv{k: 7, s: n, fo: fo})
    } else if k == 8 {
      evs.push(FeEv{k: 8, s: "", fo: r.uv()})
    } else {
      return b.fe_miss("malformed")
    }
  }
  var shapes: List[SType] = []
  var shape_names: List[(List[Str], List[List[Str]], List[Str], Str)] = []
  for _ in 0..nmt {
    var x = SType{kind: Kind.Bad, name: ""}
    var fnames: List[Str] = []
    let nf = r.uv()
    if !r.ok || nf > d.len() {
      return b.fe_miss("malformed")
    }
    for _ in 0..nf {
      x.fields.push(SField{name: r.str(), ty: -1})
      fnames.push(r.str())
    }
    var vnames: List[List[Str]] = []
    let nv = r.uv()
    if !r.ok || nv > d.len() {
      return b.fe_miss("malformed")
    }
    for _ in 0..nv {
      var v = SVariant{name: r.str()}
      var vn: List[Str] = []
      let nvf = r.uv()
      if !r.ok || nvf > d.len() {
        return b.fe_miss("malformed")
      }
      for _ in 0..nvf {
        v.fields.push(SField{name: r.str(), ty: -1})
        vn.push(r.str())
      }
      x.variants.push(v)
      vnames.push(vn)
    }
    var enames: List[Str] = []
    let nel = r.uv()
    if !r.ok || nel > d.len() {
      return b.fe_miss("malformed")
    }
    for _ in 0..nel {
      enames.push(r.str())
    }
    let rn = r.str()
    x.coll = r.bool()
    x.bits = r.sv()
    x.unsigned = r.bool()
    shapes.push(x)
    shape_names.push((fnames, vnames, enames, rn))
  }
  var helpers: List[(Bool, Bytes)] = []
  for _ in 0..nmf {
    let tg = r.bool()
    helpers.push((tg, r.bytes()))
  }
  // its closures' entries, in the order it made them
  var subs: List[Bytes] = []
  let ns = r.uv()
  if !r.ok || ns > d.len() {
    return b.fe_miss("malformed")
  }
  for _ in 0..ns {
    subs.push(r.bytes())
  }
  if !r.ok {
    return b.fe_miss("malformed")
  }
  var tr = EntryR{d: tail}
  let nc = tr.uv()
  if !tr.ok || nc > d.len() {
    return b.fe_miss("malformed")
  }
  var checks: List[UCheck] = []
  for _ in 0..nc {
    let u = tr.uv()
    let callee = tr.str()
    checks.push(UCheck{fi: fi, u: u, callee: renames.get(callee) ?? callee, w: tr.sv()})
  }
  let dvar = tr.sv()
  let nm = tr.uv()
  if !tr.ok || nm > d.len() {
    return b.fe_miss("malformed")
  }
  var mods: List[Str] = []
  for _ in 0..nm {
    mods.push(tr.str())
  }
  let target = tr.bool()
  let flagbits = tr.uv()
  let fb = tr.bytes()
  if !tr.ok {
    return b.fe_miss("malformed")
  }
  // the events, as the body's build made them
  var bad = false
  var ci = 0
  var made_t: List[(Int, Int)] = []
  var holes: List[(Int, Int)] = []
  var ti = 0
  var hi = 0
  var now: Map[Str, Bool] = {}
  for ev in evs {
    if ev.k == 1 {
      if !b.m.type_at.contains(ev.s) {
        let t = b.m.intern(SType{kind: kind_at(ev.fo), name: ev.s})
        made_t.push((t, ti))
        now[ev.s] = true
      }
      ti += 1
    } else if ev.k == 2 {
      if now.contains(ev.s) {
        b.m.order.push(b.m.type_at.get(ev.s) ?? -1)
      }
    } else if ev.k == 3 {
      // absent: checked above, but for a constant's function another
      // body made (the same function: its body is not decoded)
      if !((fe_const_fn(ev.s) && b.m.func_at.contains(ev.s)) || b.fe_thunk_there(ev.s)) {
        let i = b.m.new_func(ev.s, [], [])
        holes.push((i, hi))
      }
      hi += 1
    } else if ev.k == 5 {
      // a closure, numbered as the build here numbers it; its body from
      // its own entry, at its job's turn
      if ci >= subs.len() {
        bad = true
        continue
      }
      b.nclos += 1
      let name = "${b.m.funcs[fi].name}.fn${b.nclos}"
      renames[ev.s] = name
      var ps: List[Int] = []
      for n in ev.ps {
        let t = b.m.type_at.get(n) ?? -1
        bad = bad || t < 0
        ps.push(t)
      }
      var rs: List[Int] = []
      for n in ev.rs {
        let t = b.m.type_at.get(n) ?? -1
        bad = bad || t < 0
        rs.push(t)
      }
      var caps: List[Int] = []
      for n in ev.caps {
        let t = b.m.type_at.get(n) ?? -1
        bad = bad || t < 0
        caps.push(t)
      }
      if !bad {
        let cf = b.m.new_func(name, ps, rs)
        b.m.funcs[cf].indirect = true
        b.m.funcs[cf].captures = caps
        b.m.funcs[cf].catches = ev.catches
        b.queue.push(Job.ClosureReplay(fi: cf, d: subs[ci], key: b.fe.cur_key))
      }
      ci += 1
    } else if ev.k == 6 {
      // numbered as the build here numbers constants
      if !b.consts.contains(ev.s) {
        let id = b.consts.len()
        bad = bad || id >= 4096
        b.consts[ev.s] = id
        b.const_names.push(ev.s)
      }
    } else if ev.k == 7 {
      let key = "${ev.fo}:${b.func_name(ev.fo)}"
      if !b.thunks.contains(key) {
        // made by the body: its function was made whole above
        let w = b.m.func_at.get(ev.s) ?? -1
        bad = bad || w < 0
        b.thunks[key] = w
        b.thunk_of[w] = ev.fo
      }
    } else if ev.k == 8 {
      // a number no expression's key takes
      let id = b.sites.len()
      b.sites[-1 - id] = id
      sites[ev.fo] = id
    } else {
      let _ = b.declare(ev.fo, [])
    }
  }
  // the types made get their structure, by name
  for (t, si) in made_t {
    var x = shapes[si]
    x.kind = b.m.types[t].kind
    x.name = b.m.types[t].name
    let (fnames, vnames, enames, rn) = shape_names[si]
    for (i, n) in fnames.indexed() {
      x.fields[i].ty = b.m.type_at.get(n) ?? -1
      bad = bad || x.fields[i].ty < 0
    }
    for (i, vn) in vnames.indexed() {
      for (j, n) in vn.indexed() {
        x.variants[i].fields[j].ty = b.m.type_at.get(n) ?? -1
        bad = bad || x.variants[i].fields[j].ty < 0
      }
    }
    for n in enames {
      let el = b.m.type_at.get(n) ?? -1
      bad = bad || el < 0
      x.elems.push(el)
    }
    x.ret = if rn.is_empty() { -1 } else { b.m.type_at.get(rn) ?? -2 }
    bad = bad || x.ret == -2
    b.m.types[t] = x
  }
  let ops = ops_by_name()
  for (i, h) in holes {
    let (tg, hb) = helpers[h]
    match decode_func(b.m, hb, ops) {
      Some(g0) => {
        var g = g0
        g.target = tg
        fe_rename(g, renames)
        b.fe_const_ids(g)
        fe_site_ids(g, sites)
        b.m.funcs[i] = g
      }
      None => bad = true
    }
  }
  var f = decode_func(b.m, fb, ops)
  if let Some(g0) = f {
    var g = g0
    shift_lines(g, shift)
    f = Some(g)
  }
  if !b.fe.break_name.is_empty() && b.m.funcs[fi].name == b.fe.break_name {
    bad = true
  }
  if bad || f == None {
    // the checks passed but the commit did not: a builder bug, never a
    // silent difference
    b.why = "the front end cache's entry for ${b.m.funcs[fi].name} does not replay (XO_FE_CACHE=off builds without it)"
    b.fe.broken = true
    return true
  }
  var g = f ?? Func{name: ""}
  // the name this build gave fi (a closure's is numbered here, not as
  // where the entry was recorded)
  g.name = b.m.funcs[fi].name
  g.target = target
  fe_rename(g, renames)
  b.fe_const_ids(g)
  fe_site_ids(g, sites)
  b.m.funcs[fi] = g
  for c in checks {
    b.checks.push(c)
  }
  b.nvar += dvar
  if (flagbits & 1) != 0 {
    b.need_conc = true
  }
  if (flagbits & 2) != 0 {
    b.uses_net = true
  }
  for k in mods {
    b.decl_mods[k] = true
  }
  true
}

/// The names of generic instances a committed body calls, as this module
/// names them (fe_replay's renames).
fn fe_rename(var f: Func, renames: Map[Str, Str]) {
  if renames.is_empty() {
    return
  }
  for i in 0..f.values.len() {
    if f.values[i].op is Op.Call | Op.FuncAddr | Op.Closure | Op.Rebind {
      if let S(s) = f.values[i].aux {
        if let Some(n) = renames.get(s) {
          f.values[i].aux = Aux.S(s: n)
        }
      }
    }
  }
}

/// Numbers the constants a committed function reads (rt.const_once of
/// the constant's function and its number) as this build numbers them.
fn (b: Builder) fe_const_ids(var f: Func) {
  for i in 0..f.values.len() {
    if f.values[i].op != Op.Call || f.values[i].args.len() != 3 {
      continue
    }
    if let S(s) = f.values[i].aux {
      if s == "rt.const_once" {
        if let S(n) = f.values[f.values[i].args[0]].aux {
          if let Some(id) = b.consts.get(n) {
            f.values[f.values[i].args[2]].aux = Aux.I(n: id)
          }
        }
      }
    }
  }
}

/// Numbers the spawn sites of a committed function (rt.task_spawn_fn's
/// and rt.task_spawn's seventh argument) as this build numbered them.
fn fe_site_ids(var f: Func, sites: Map[Int, Int]) {
  if sites.is_empty() {
    return
  }
  for i in 0..f.values.len() {
    if f.values[i].op != Op.Call || f.values[i].args.len() != 8 {
      continue
    }
    if let S(s) = f.values[i].aux {
      if s is "rt.task_spawn_fn" | "rt.task_spawn" {
        let a = f.values[i].args[6]
        if let I(n) = f.values[a].aux {
          if let Some(id) = sites.get(n) {
            f.values[a].aux = Aux.I(n: id)
          }
        }
      }
    }
  }
}

fn kind_index(k: Kind) -> Int {
  for (i, x) in all_kinds().indexed() {
    if x == k {
      return i
    }
  }
  -1
}

fn kind_at(i: Int) -> Kind {
  let ks = all_kinds()
  if i >= 0 && i < ks.len() { ks[i] } else { Kind.Bad }
}

/// A replay that does not fit, counted by reason (XO_FE_STATS).
/// A body whose entry is not recorded, by reason (XO_FE_STATS).
fn (var b: Builder) fe_skip(why: Str) {
  b.fe_stats["skip.${why}"] = (b.fe_stats.get("skip.${why}") ?? 0) + 1
}

fn (var b: Builder) fe_miss(why: Str) -> Bool {
  b.fe_stats["miss.${why}"] = (b.fe_stats.get("miss.${why}") ?? 0) + 1
  false
}

fn all_kinds() -> List[Kind] {
  [Kind.Unit, Kind.Int, Kind.Float, Kind.Bool, Kind.Str, Kind.Struct, Kind.Enum, Kind.Tuple, Kind.List, Kind.Cap, Kind.Func, Kind.Box, Kind.Handle, Kind.Bad]
}

/// Notes the closure function fi a body made, while it records:
/// an event 5, not the whole function new_func noted (its body is built
/// by its job; the entry takes the job's entry, fe_finalize).
fn (var b: Builder) fe_closure_made(fi: Int) {
  if !b.m.fe_log {
    return
  }
  let n = b.m.fe_ev.len()
  if n > 0 && b.m.fe_ev[n - 1] == (3, fi) {
    b.m.fe_ev[n - 1] = (5, fi)
  } else {
    b.m.fe_ev.push((5, fi))
  }
}

/// The closures (event 5) the entry just recorded made, in order.
fn (b: Builder) fe_made_closures() -> List[Int] {
  var out: List[Int] = []
  for (k, x) in b.m.fe_ev {
    if k == 5 {
      out.push(x)
    }
  }
  out
}

/// Entry e with its closures' entries after it (each sealed in turn),
/// none when one of them recorded none.
fn (b: Builder) fe_seal(e: Bytes, clos: List[Int]) -> Option[Bytes] {
  var w = EntryW{b: BytesBuilder.new()}
  w.b.write(e)
  w.uv(clos.len())
  for cf in clos {
    if b.fe.no_clos.contains(cf) {
      return None
    }
    match b.fe.clos_rec.get(cf) {
      Some((ce, sub)) => {
        match b.fe_seal(ce, sub) {
          Some(x) => w.bytes(x)
          None => return None
        }
      }
      None => return None
    }
  }
  Some(w.b.freeze())
}

/// The entries waiting for their closures', sealed and stored (after the
/// build: every closure job has run).
pub fn (var b: Builder) fe_finalize() {
  for (key, e, clos) in b.fe.pending {
    if let Some(x) = b.fe_seal(e, clos) {
      b.fe.stores.push((key, x))
    }
  }
  b.fe.pending = []
}

/// Whether n names a function its name determines, which a body makes
/// when it is the first to need it: a constant's function (const_value's
/// xo.const[M.N]), the drop of its list type (drop_list's
/// xo.droplist[T], an empty function), and a Map type's helpers
/// (xo.map.*, xo.mlog.*, xo.maph.*[T]: made by thunk_func, which takes
/// one already there by its name). An entry that made one whole replays
/// where another body made it already. (2026-10-26: a closure of
/// std/metrics' series_of made xo.maph.logget[Map[Str, metrics.Series]]
/// where it was recorded; in a program where another body made it first
/// the closure's entry, which cannot fall back to its source, did not
/// replay, and the build was made again without the cache.)
fn fe_const_fn(n: Str) -> Bool {
  n.starts_with("xo.const[") || n.starts_with("xo.droplist[") || n.starts_with("xo.map.") || n.starts_with("xo.mlog.") || n.starts_with("xo.maph.")
}

/// Whether an entry that made the thunk named n for target function fo
/// with signature sig may replay with the thunk already there (its name,
/// target and signature): only when it is that same thunk.
/// sig is "" when the callee is not declared yet in this build (its body
/// replays later): the target function object (have_target == fo) then
/// fixes the signature, as a thunk of a generic instance never replays.
fn thunk_replay_ok(have_name: Str, have_target: Int, have_sig: Str, n: Str, fo: Int, sig: Str) -> Bool {
  have_name == n && have_target == fo && fo >= 0 && (sig.is_empty() || have_sig == sig)
}

/// The parameter types (from the entry block's, skipping the first skip)
/// and result types of function w, by type name ("" for none).
fn (b: Builder) sig_from(w: Int, skip: Int) -> Str {
  if w < 0 || w >= b.m.funcs.len() {
    return ""
  }
  let f = b.m.funcs[w]
  var ps: List[Str] = []
  for (i, v) in f.blocks[0].params.indexed() {
    if i >= skip {
      ps.push(b.m.types[f.values[v].ty].name)
    }
  }
  var rs: List[Str] = []
  for r in f.results {
    rs.push(b.m.types[r].name)
  }
  "(${ps.join(",")}) -> (${rs.join(",")})"
}

/// A thunk's own signature: its parameters after the closure value and
/// its results (call.xo: NAME.value calls NAME with them).
fn (b: Builder) thunk_sig(w: Int) -> Str { b.sig_from(w, 1) }

/// The signature the thunk of function object fo must have: its callee's
/// (the function the thunk named NAME.value calls, NAME).
fn (b: Builder) thunk_sig_of(n: Str) -> Str {
  if !n.ends_with(".value") {
    return ""
  }
  b.sig_from(b.m.func_at.get(n.trim_suffix(".value")) ?? -1, 0)
}

/// Whether n names a function value's thunk that is there already (made
/// by another body): an entry that made it whole replays with that one
/// (call.xo names a thunk after its function: `NAME.value`).
fn (b: Builder) fe_thunk_there(n: Str) -> Bool {
  if !n.ends_with(".value") {
    return false
  }
  let w = b.m.func_at.get(n) ?? -1
  w >= 0 && b.thunk_of.contains(w)
}

/// Adds delta to every line of f in its own file: each value's line and
/// position (`file:line[:col]`), its variables' and their bindings'
/// (decision 0271 addendum, entries relative to the declaration's line).
/// Value, variable, and binding lines are packed, line * 4096 + column
/// (Value.line): the delta moves the line (adding it whole moved the
/// column, so a body that moved had its debug rows at its old lines with
/// the columns off by the move; v12, 2026-10-21).
fn shift_lines(var f: Func, delta: Int) {
  if delta == 0 {
    return
  }
  let pre = "${f.file}:"
  let d = delta * 4096
  for vi in 0..f.values.len() {
    if f.values[vi].line > 0 {
      f.values[vi].line += d
    }
    if f.values[vi].pos.starts_with(pre) {
      f.values[vi].pos = shift_pos(f.values[vi].pos, pre, delta)
    }
  }
  for i in 0..f.dvars.len() {
    if f.dvars[i].line > 0 {
      f.dvars[i].line += d
    }
  }
  for i in 0..f.dbinds.len() {
    if f.dbinds[i].line > 0 {
      f.dbinds[i].line += d
    }
  }
}

/// p (`pre` then `line` or `line:col`) with its line moved by delta.
fn shift_pos(p: Str, pre: Str, delta: Int) -> Str {
  var parts = p[pre.len()..p.len()].split(":")
  match Int.parse(parts[0]) {
    Some(l) => {
      parts[0] = "${l + delta}"
      "${pre}${parts.join(":")}"
    }
    None => p
  }
}

/// Whether f's lines can be kept relative to base (fe_entry): every line
/// in its file at base or after (a relative line of 0 would read as no
/// line), its positions all `file:line[:col]`, and no constant naming
/// its file (dbg's `[file:line:col]`, which a move would not update).
fn relocatable(f: Func, base: Int) -> Bool {
  let pre = "${f.file}:"
  for x in f.values {
    // packed lines (line * 4096 + column)
    if x.line > 0 && x.line / 4096 < base {
      return false
    }
    if x.pos.starts_with(pre) {
      match Int.parse(x.pos[pre.len()..x.pos.len()].split(":")[0]) {
        Some(l) => {
          if l < base {
            return false
          }
        }
        None => return false
      }
    }
  }
  for d in f.dvars {
    if d.line > 0 && d.line / 4096 < base {
      return false
    }
  }
  for d in f.dbinds {
    if d.line > 0 && d.line / 4096 < base {
      return false
    }
  }
  !names_file(f, f.file)
}

/// Whether a constant of f names file (`file:` in a string).
fn names_file(f: Func, file: Str) -> Bool {
  if file.is_empty() {
    return false
  }
  let pre = "${file}:"
  for x in f.values {
    match x.aux {
      S(s) => {
        if x.op == Op.Const && s.contains(pre) {
          return true
        }
      }
      Bs(b) => {
        if (b.to_str() ?? "").contains(pre) {
          return true
        }
      }
      None | I(..) | F(..) | B(..) | P(..) => {}
    }
  }
  false
}
