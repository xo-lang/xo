// A Windows x64 executable's unwinding (decision 0253 stage 6): a PE has
// no .eh_frame; each function's unwind data is its RUNTIME_FUNCTION in
// .pdata (begin, end and UNWIND_INFO RVAs) and that UNWIND_INFO (in
// .rdata): the prolog's operations, newest first, which undone in order
// give the caller's rsp, its callee saved registers and the return
// address. A function with no entry is a leaf (its return address at
// rsp). The first frame may stop in an epilog, which the unwind codes do
// not describe: its instructions (add or lea of rsp, pops, ret) are run
// instead, as Windows' own RtlVirtualUnwind does.

/// The hardware number of an x64 register (an unwind code's) as DWARF's.
fn win_reg(hw: Int) -> Int {
  if hw >= 8 {
    return hw
  }
  [0, 2, 1, 3, 7, 6, 4, 5][hw]
}

/// The bytes of the image at address a (n of them), from its sections.
fn pe_bytes(tab: Tables, a: Int, n: Int) -> Bytes? {
  for (addr, b) in tab.pe_data {
    if a >= addr && a + n <= addr + b.len() {
      return Some(b[a - addr..a - addr + n])
    }
  }
  None
}

/// The RUNTIME_FUNCTION of the code at pc: its begin's and UNWIND_INFO's
/// addresses, or None.
fn pdata_at(tab: Tables, pc: Int) -> (Int, Int)? {
  let rva = pc - tab.base
  var lo = 0
  var hi = tab.pdata.len() / 12
  while lo < hi {
    let m = (lo + hi) / 2
    let begin = rd32(tab.pdata, 12 * m)
    let end = rd32(tab.pdata, 12 * m + 4)
    if rva < begin {
      hi = m
    } else if rva >= end {
      lo = m + 1
    } else {
      return Some((tab.base + begin, tab.base + rd32(tab.pdata, 12 * m + 8)))
    }
  }
  None
}

/// The caller's registers of the frame at pc with registers regs (DWARF
/// numbers, the return address under 16), and how they were found.
fn win_step[T: Target](tab: Tables, pc: Int, regs: Map[Int, Int], t: T, first: Bool) -> (Map[Int, Int], Str)? {
  var next = regs
  if pdata_at(tab, pc) == None {
    // a leaf: nothing pushed, the return address at rsp
    let sp = regs.get(7) ?? 0
    next[16] = load64(t, sp)?
    next[7] = sp + 8
    return Some((next, "leaf"))
  }
  let (begin, info0) = pdata_at(tab, pc)?
  if first {
    if let Some(e) = epilog_step(tab, pc, regs, t) {
      return Some((e, "epilog"))
    }
  }
  var info = info0
  var primary = true
  var off = pc - begin
  while true {
    let head = pe_bytes(tab, info, 4)?
    let flags = Int(head[0]) >> 3
    let count = Int(head[2])
    let fr = Int(head[3]) & 15
    let fo = Int(head[3]) >> 4
    let codes = pe_bytes(tab, info + 4, 2 * count)?
    // the frame the saves count from: the frame register's when it is set
    // up (the function's prolog past its SET_FPREG), else rsp
    var frame = next.get(7) ?? 0
    if fr != 0 {
      var i = 0
      while i < count {
        let op = Int(codes[2 * i + 1]) & 15
        if op == 3 && (!primary || Int(codes[2 * i]) <= off) {
          frame = (next.get(win_reg(fr)) ?? 0) - 16 * fo
        }
        i += op_slots(op, Int(codes[2 * i + 1]) >> 4)
      }
    }
    var i = 0
    while i < count {
      let at = Int(codes[2 * i])
      let op = Int(codes[2 * i + 1]) & 15
      let oi = Int(codes[2 * i + 1]) >> 4
      let n = op_slots(op, oi)
      if primary && at > off {
        // not run yet: pc is in the prolog before it
        i += n
        continue
      }
      let sp = next.get(7) ?? 0
      if op == 0 {
        // UWOP_PUSH_NONVOL
        next[win_reg(oi)] = load64(t, sp)?
        next[7] = sp + 8
      } else if op == 1 {
        // UWOP_ALLOC_LARGE: a 16 bit size in 8 byte units, or 32 bits
        next[7] = sp + (if oi == 0 { 8 * rd16(codes, 2 * i + 2) } else { rd32(codes, 2 * i + 2) })
      } else if op == 2 {
        // UWOP_ALLOC_SMALL
        next[7] = sp + 8 * oi + 8
      } else if op == 3 {
        // UWOP_SET_FPREG: rsp was the frame register less its offset
        next[7] = (next.get(win_reg(fr)) ?? 0) - 16 * fo
      } else if op == 4 {
        // UWOP_SAVE_NONVOL: at the frame plus an 8 byte scaled offset
        next[win_reg(oi)] = load64(t, frame + 8 * rd16(codes, 2 * i + 2))?
      } else if op == 5 {
        // UWOP_SAVE_NONVOL_FAR
        next[win_reg(oi)] = load64(t, frame + rd32(codes, 2 * i + 2))?
      } else if op == 7 || op > 10 {
        // not an operation of version 1 or 2: the data is not understood
        return None
      } else if op == 10 {
        // UWOP_PUSH_MACHFRAME: an interrupt's frame (rip, cs, rflags,
        // rsp, ss), after an error code when oi is 1
        let base = sp + 8 * oi
        next[16] = load64(t, base)?
        next[7] = load64(t, base + 24)?
        return Some((next, "pdata"))
      }
      // UWOP_SAVE_XMM128 (8, 9) and version 2's epilog codes (6) leave
      // the integer registers as they are
      i += n
    }
    if flags & 4 == 0 {
      break
    }
    // UNW_FLAG_CHAININFO: the parent's RUNTIME_FUNCTION after the codes
    // (their count rounded up to even), its operations all run
    let chain = pe_bytes(tab, info + 4 + 2 * ((count + 1) & -2), 12)?
    info = tab.base + rd32(chain, 8)
    primary = false
    off = 0
  }
  let sp = next.get(7) ?? 0
  next[16] = load64(t, sp)?
  next[7] = sp + 8
  Some((next, "pdata"))
}

/// How many 2 byte slots unwind operation op (with its info oi) takes.
fn op_slots(op: Int, oi: Int) -> Int {
  if op == 1 {
    return if oi == 0 { 2 } else { 3 }
  }
  if op == 4 || op == 8 {
    return 2
  }
  if op == 5 || op == 9 {
    return 3
  }
  1
}

/// The caller's registers when pc is in an epilog: an optional `add rsp,
/// imm` or `lea rsp, [reg + disp]`, then pops, then `ret` (or a jump of a
/// tail call); None when the code at pc is not one.
fn epilog_step[T: Target](tab: Tables, pc: Int, regs: Map[Int, Int], t: T) -> Map[Int, Int]? {
  if tab.text.is_empty() || pc < tab.text_addr || pc >= tab.text_addr + tab.text.len() {
    return None
  }
  let code = tab.text[pc - tab.text_addr..(pc - tab.text_addr + 64).min(tab.text.len())]
  var next = regs
  var i = 0
  var sp = regs.get(7) ?? 0
  // add rsp, imm8 / imm32; lea rsp, [reg + disp8 / disp32]
  if code.len() >= 4 && Int(code[0]) & 0xf8 == 0x48 && code[1] == 0x83 && code[2] == 0xc4 {
    sp += sext8(Int(code[3]))
    i = 4
  } else if code.len() >= 7 && Int(code[0]) & 0xf8 == 0x48 && code[1] == 0x81 && code[2] == 0xc4 {
    sp += sext32(rd32(code, 3))
    i = 7
  } else if code.len() >= 3 && Int(code[0]) & 0xfa == 0x48 && code[1] == 0x8d && (Int(code[2]) & 0x38) == 0x20 {
    let md = Int(code[2]) >> 6
    let rm = (Int(code[2]) & 7) + (if Int(code[0]) & 1 != 0 { 8 } else { 0 })
    if rm & 7 == 4 || md == 0 || md == 3 {
      return None
    }
    let b = regs.get(win_reg(rm)) ?? 0
    if md == 1 && code.len() >= 4 {
      sp = b + sext8(Int(code[3]))
      i = 4
    } else if md == 2 && code.len() >= 7 {
      sp = b + sext32(rd32(code, 3))
      i = 7
    } else {
      return None
    }
  }
  // pops (58+r, 41 58+r for r8 to r15)
  while i < code.len() {
    if Int(code[i]) & 0xf8 == 0x58 {
      next[win_reg(Int(code[i]) & 7)] = load64(t, sp)?
      sp += 8
      i += 1
    } else if code[i] == 0x41 && i + 1 < code.len() && Int(code[i + 1]) & 0xf8 == 0x58 {
      next[win_reg(8 + (Int(code[i + 1]) & 7))] = load64(t, sp)?
      sp += 8
      i += 2
    } else {
      break
    }
  }
  if i >= code.len() {
    return None
  }
  // ret, ret imm16, or a tail call's jmp (rel8, rel32, rex.w jmp [mem])
  let c = Int(code[i])
  if !(c == 0xc3 || c == 0xc2 || c == 0xe9 || c == 0xeb || (c == 0x48 && i + 1 < code.len() && code[i + 1] == 0xff)) {
    return None
  }
  next[16] = load64(t, sp)?
  next[7] = sp + 8
  Some(next)
}

fn sext8(v: Int) -> Int { if v >= 128 { v - 256 } else { v } }

fn sext32(v: Int) -> Int { if v >= 0x80000000 { v - 0x100000000 } else { v } }

/// A memory whose every word is w (pdata_check's stack).
struct WordMem {
  w: Int
}

fn (m: WordMem) reg(n: Int) -> Int? {
  None
}

fn (m: WordMem) mem(a: Int, n: Int) -> Bytes? {
  var b = BytesBuilder.new()
  for k in 0..n {
    b.write_byte(UInt8((m.w >> (8 * (k % 8))) & 255))
  }
  Some(b.freeze())
}

/// What is wrong with a PE's unwind data, and how many functions it has
/// (xo dev debug --unwind-check): the RUNTIME_FUNCTIONs in order and
/// apart, each UNWIND_INFO readable, of version 1 or 2, its operations
/// known and inside the prolog, newest first, its chain ending; and each
/// function unwinds from the end of its prolog to a caller's rsp above
/// its own by a whole number of words.
pub fn pdata_check(tab: Tables) -> (Int, List[Str]) {
  var errs: List[Str] = []
  let n = tab.pdata.len() / 12
  var prev_end = 0
  for k in 0..n {
    let begin = rd32(tab.pdata, 12 * k)
    let end = rd32(tab.pdata, 12 * k + 4)
    let at = "function at rva 0x${hex(begin)}"
    if begin >= end || begin < prev_end {
      errs.push("${at}: its range ends at 0x${hex(end)}, the one before at 0x${hex(prev_end)}")
    }
    prev_end = end
    var info = tab.base + rd32(tab.pdata, 12 * k + 8)
    var prolog = 0
    var depth = 0
    var primary = true
    while true {
      let head = match pe_bytes(tab, info, 4) {
        Some(h) => h
        None => {
          errs.push("${at}: its UNWIND_INFO at 0x${hex(info)} is outside the image")
          break
        }
      }
      let version = Int(head[0]) & 7
      if version != 1 && version != 2 {
        errs.push("${at}: UNWIND_INFO version ${version}")
        break
      }
      if primary {
        prolog = Int(head[1])
      }
      let count = Int(head[2])
      let codes = match pe_bytes(tab, info + 4, 2 * count) {
        Some(c) => c
        None => {
          errs.push("${at}: its ${count} unwind codes are outside the image")
          break
        }
      }
      var i = 0
      var last = 256
      while i < count {
        let off = Int(codes[2 * i])
        let op = Int(codes[2 * i + 1]) & 15
        let s = op_slots(op, Int(codes[2 * i + 1]) >> 4)
        if op == 7 || op > 10 {
          errs.push("${at}: unwind operation ${op}")
        } else if i + s > count {
          errs.push("${at}: operation ${op} runs past the codes")
        } else if op != 6 && (off > Int(head[1]) || off > last) {
          errs.push("${at}: operation ${op} at prolog offset ${off} (prolog ${Int(head[1])}, the newer one at ${last})")
        }
        if op != 6 {
          last = off
        }
        i += s
      }
      if Int(head[0]) >> 3 & 4 == 0 {
        break
      }
      depth += 1
      let chain = match pe_bytes(tab, info + 4 + 2 * ((count + 1) & -2), 12) {
        Some(c) => c
        None => {
          errs.push("${at}: its chained RUNTIME_FUNCTION is outside the image")
          break
        }
      }
      if depth > 32 {
        errs.push("${at}: its chain does not end")
        break
      }
      info = tab.base + rd32(chain, 8)
      primary = false
    }
    // unwind from the end of the prolog with every stack word an address
    // inside the function: the caller's rsp is above the frame's
    let sp = 0x10000
    let pc = tab.base + begin + prolog.min(end - begin - 1)
    match win_step(tab, pc, {7: sp, 6: sp + 0x100}, WordMem{w: tab.base + begin}, false) {
      Some((r, _)) => {
        let up = (r.get(7) ?? 0) - sp
        if up < 8 || up % 8 != 0 || up > 0x1000000 {
          errs.push("${at}: unwinds rsp by ${up}")
        }
      }
      None => errs.push("${at}: does not unwind from the end of its prolog")
    }
  }
  (n, errs)
}
