// A live session of `xo debug PROG` (decision 0253 stage 2): the program
// started stopped through std/internal's process control, its traps
// (`brk #0` words) planted at the breakpoints' addresses, run until a
// trap, an exception, or its end. At a stop the thread's registers become
// the session's snapshot (its memory read from the process) and the
// frames are its backtrace, so locals, print, backtrace and frame read
// the live program as they read a recorded thread. continue steps the
// stopped thread over its trap (the original word back, one instruction
// by the single step bit, the trap again) before it lets the program go.

use std/internal

/// EXC_BREAKPOINT: a trap or a single step.
const EXC_BREAKPOINT = 6

/// A session that runs prog with args: exe is the executable (its unwind
/// and symbol tables), dwarf its debug sections.
pub fn live_session(exe: Bytes, dwarf: Sections, prog: Str, args: List[Str]) -> Session {
  let info = read(dwarf)
  let l = lines(dwarf)
  let tab = tables(exe)
  Session{info: info, lines: l, tab: tab, snap: Snapshot{}, prog: prog, args: args}
}

/// run: starts the program with every breakpoint planted and waits for
/// its first stop.
fn (var s: Session) run() -> Str ! Str uses proc {
  if s.proc != 0 {
    return Err("the program is running already (continue, or quit)")
  }
  s.proc = internal.dbg_launch(s.prog, s.args, s.out)?
  s.traps = {}
  s.plant()?
  if !internal.dbg_resume(s.proc, false) {
    return Err("the program could not be started")
  }
  Ok(s.wait_stop())
}

/// continue: the stopped thread past its trap, then the program until its
/// next stop.
fn (var s: Session) cont() -> Str ! Str uses proc {
  if s.proc == 0 {
    return Err("the program is not running (run)")
  }
  let pc = s.snap.regs.get(-1) ?? 0
  if s.traps.contains(pc) {
    // the original word for one instruction, the trap again after it
    let r = s.step1(s.thread, pc)?
    if !stepped(r, s.thread) {
      // something else stopped the step (a fault in that instruction, the
      // program's end)
      return Ok(s.stopped(r))
    }
  }
  if !internal.dbg_resume(s.proc, false) {
    return Err("the program could not be resumed")
  }
  Ok(s.wait_stop())
}

/// One instruction of thread th, at pc: alone (the other threads stay
/// suspended) unless it is a system call, which may wait for another
/// thread; a trap at pc is taken out for it and planted again. The wait's
/// result (stepped tells a finished step from another stop).
fn (var s: Session) step1(th: Int, pc: Int) -> List[Int] ! Str uses proc {
  let orig = s.traps.get(pc)
  if let Some(o) = orig {
    if !internal.dbg_write(s.proc, pc, o) {
      return Err("could not take the breakpoint at 0x${hex(pc)} out")
    }
  }
  let w = s.word(pc)
  // svc #0x80 (and any svc): d4000001 with an immediate in bits 5 to 20
  let svc = w & 0xffe0001f == 0xd4000001
  if !internal.dbg_set_step(s.proc, th, true) || !internal.dbg_resume(s.proc, !svc) {
    return Err("could not step the thread at 0x${hex(pc)}")
  }
  let r = internal.dbg_wait(s.proc, 0)
  if r.len() > 0 && r[0] == 1 {
    let _s = internal.dbg_set_step(s.proc, th, false)
  }
  if orig.is_some() && s.proc != 0 && !(r.len() > 0 && r[0] >= 2) {
    if !internal.dbg_write(s.proc, pc, brk()) {
      return Err("could not plant the breakpoint at 0x${hex(pc)} again")
    }
  }
  Ok(r)
}

/// The instruction word at pc as the program runs it (a planted trap's
/// original), 0 when it cannot be read.
fn (s: Session) word(pc: Int) -> Int {
  let b = s.traps.get(pc) ?? (internal.dbg_read(s.proc, pc, 4) ?? b"")
  if b.len() < 4 {
    return 0
  }
  Int(b[0]) | (Int(b[1]) << 8) | (Int(b[2]) << 16) | (Int(b[3]) << 24)
}

/// Whether r (dbg_wait's) is thread th's finished single step.
fn stepped(r: List[Int], th: Int) -> Bool {
  r.len() >= 5 && r[0] == 1 && r[1] == th && r[2] == EXC_BREAKPOINT && r[4] == 0
}

/// Plants the trap of every breakpoint address not planted yet (a live
/// session's process only).
fn (var s: Session) plant() -> () ! Str uses proc {
  if s.proc == 0 {
    return Ok(())
  }
  for a in s.bpts.traps() {
    if s.traps.contains(a) {
      continue
    }
    let orig = internal.dbg_read(s.proc, a, 4) ?? return Err("cannot read the code at 0x${hex(a)}")
    if !internal.dbg_write(s.proc, a, brk()) {
      return Err("cannot plant a breakpoint at 0x${hex(a)}")
    }
    s.traps[a] = orig
  }
  Ok(())
}

/// Takes the traps at the addresses a deleted breakpoint had back out,
/// unless another breakpoint still has the address.
fn (var s: Session) unplant(addrs: List[Int]) uses proc {
  if s.proc == 0 {
    return
  }
  let keep = s.bpts.traps()
  for a in addrs {
    if keep.contains(a) {
      continue
    }
    if let Some(orig) = s.traps.get(a) {
      let _w = internal.dbg_write(s.proc, a, orig)
      s.traps.remove(a)
    }
  }
}

/// Ends the program, when it runs (quit).
fn (var s: Session) end() uses proc {
  if s.proc != 0 {
    internal.dbg_kill(s.proc)
    internal.dbg_close(s.proc)
    s.proc = 0
  }
}

fn (var s: Session) wait_stop() -> Str uses proc {
  let r = internal.dbg_wait(s.proc, 0)
  s.stopped(r)
}

/// The stop r (dbg_wait's list) taken in: the stopped thread's registers
/// and frames, or the program's end; its text.
fn (var s: Session) stopped(r: List[Int]) -> Str uses proc {
  s.frames = []
  s.sel = 0
  if r.is_empty() || r[0] == 0 {
    s.stopj = "\"stop\":\"none\""
    return "the program did not stop"
  }
  if r[0] == 2 || r[0] == 3 {
    internal.dbg_close(s.proc)
    s.proc = 0
    s.thread = 0
    s.snap = Snapshot{}
    if r[0] == 2 {
      s.stopj = "\"stop\":\"exited\",\"status\":${r[1]}"
      return "the program exited with status ${r[1]}"
    }
    s.stopj = "\"stop\":\"signaled\",\"signal\":${r[1]}"
    return "the program was ended by signal ${r[1]}"
  }
  s.thread = r[1]
  let rs = internal.dbg_regs(s.proc, s.thread)
  var regs: Map[Int, Int] = {}
  if rs.len() >= 33 {
    // x0 to x28, fp (29), lr (30), sp (31); the pc as -1
    for i in 0..32 {
      regs[i] = rs[i]
    }
    regs[-1] = rs[32]
  }
  s.snap = Snapshot{regs: regs, proc: s.proc}
  let pc = regs.get(-1) ?? 0
  s.frames = vframes(s.info, s.lines, s.tab, backtrace(s.tab, s.snap.regs, s.snap, 64))
  let at = if s.frames.is_empty() { "0x${hex(pc)}" } else { s.frame_text(s.frames[0]) }
  if r[2] == EXC_BREAKPOINT {
    if let Some(id) = s.bpts.at(pc) {
      s.stopj = "\"stop\":\"breakpoint\",\"id\":${id},\"thread\":${s.thread}${s.top_json()}"
      return "stopped at breakpoint ${id}: ${at}"
    }
  }
  s.stopj = "\"stop\":\"exception\",\"exception\":${r[2]},\"code\":${r[3]},\"subcode\":${r[4]},\"thread\":${s.thread}${s.top_json()}"
  "stopped by exception ${r[2]} (code ${r[3]}, subcode 0x${hex(r[4])}): ${at}"
}

fn (s: Session) top_json() -> Str {
  if s.frames.is_empty() { "" } else { ",\"frame\":${s.frame_json(0, s.frames[0])}" }
}

/// The last run or continue's JSON fields.
fn (s: Session) stop_json() -> Str { s.stopj }

/// The trap's 4 bytes (BRK little endian).
fn brk() -> Bytes { Bytes.from_hex("000020d4") ?? b"" }
