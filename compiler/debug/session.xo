// A debugging session of `xo debug` (decision 0253 point 4): the
// program's DWARF, line tables, unwind tables, and breakpoints, the
// stopped thread's frames, and the commands run against them, each
// giving its text (--batch prints them; the interactive prompt will too).
// Until the per OS process control (stage 2) the stopped thread is a
// snapshot (snap.xo): break, delete, backtrace, frame, locals, and print
// work; run, continue, step, next, and finish say that the process
// control is not there yet.

/// A frame as shown: a physical frame, or a call inlined in one (then
/// its pc and registers are the physical frame's).
pub struct VFrame {
  pub pc: Int
  pub name: Str
  /// the base name of the file and the line (file "" when unknown)
  pub file: Str
  /// the file's path as the line table names it (DAP's source path)
  pub path: Str = ""
  pub line: Int
  pub inlined: Bool
  pub vars: List[Var]
  pub regs: Map[Int, Int]
  pub how: Str
}

/// The frames of a backtrace with each inlined call as its own frame,
/// innermost first, as lldb lists them: an inlined callee at its own
/// line, each caller at the line of its call (DW_AT_call_file and
/// DW_AT_call_line).
pub fn vframes(info: Info, l: Lines, tab: Tables, frames: List[UFrame]) -> List[VFrame] {
  var out: List[VFrame] = []
  for (k, f) in frames.indexed() {
    // a caller's line is its call's: the instruction before the return
    // (pc - 1 is inside it on arm64 and x86_64 alike)
    let look = if k == 0 { f.pc } else { f.pc - 1 }
    var file = ""
    var path = ""
    var line = 0
    if let Some((fl, ln)) = l.at(look) {
      file = base_of(fl)
      path = fl
      line = ln
    }
    var name = tab.sym_at(f.pc)
    var vars: List[Var] = []
    var chain: List[Inlined] = []
    if let Some(fn_) = info.func_at(look) {
      name = fn_.name
      vars = fn_.vars
      for c in fn_.inlined {
        for (lo, hi) in c.ranges {
          if look >= lo && look < hi {
            chain.push(c)
          }
        }
      }
    }
    var order: List[(Int, Int)] = []
    for (i, c) in chain.indexed() {
      order.push((-c.depth, i))
    }
    for (_, i) in order.sort() {
      let c = chain[i]
      out.push(VFrame{pc: f.pc, name: c.name, file: file, path: path, line: line, inlined: true, vars: c.vars, regs: f.regs, how: f.how})
      let cf = l.call_file(c.unit_line, c.call_file)
      if !cf.is_empty() {
        file = base_of(cf)
        path = cf
      }
      line = c.call_line
    }
    out.push(VFrame{pc: f.pc, name: name, file: file, path: path, line: line, inlined: false, vars: vars, regs: f.regs, how: f.how})
  }
  out
}

fn base_of(p: Str) -> Str {
  let parts = p.split("/")
  parts[parts.len() - 1]
}

/// A session: the program's debug information and the stopped thread.
pub struct Session {
  pub info: Info
  pub lines: Lines
  pub tab: Tables
  pub bpts: Bpts = Bpts{}
  pub snap: Snapshot
  pub frames: List[VFrame] = []
  /// the selected frame (`frame N`)
  pub sel: Int = 0
  pub done: Bool = false
  /// a live session's program and its arguments (live.xo), "" for a
  /// recorded thread
  pub prog: Str = ""
  pub args: List[Str] = []
  /// the file the program's standard output and error go to ("": this
  /// process's; DAP's stdout is its protocol)
  pub out: Str = ""
  /// the running debuggee (std/internal dbg_launch), 0 before run and
  /// after its end
  pub proc: Int = 0
  /// the thread that stopped, and each planted trap's original word
  pub thread: Int = 0
  pub traps: Map[Int, Bytes] = {}
  /// the last run or continue's JSON fields (live.xo stop_json)
  pub stopj: Str = ""
  /// the line table's statement rows by address (step.xo stmt_rows)
  pub stmts: Map[Int, Int] = {}
  /// the task whose frames are selected (`task N`), 0 for the stopped
  /// thread's
  pub task: Int = 0
  /// the thread a selected running task runs on (its frame 0 is a live
  /// pc, not a return address), 0 for a parked task
  pub task_thread: Int = 0
  /// the executable's file (a live session's), and whether the program
  /// was attached to (not started: quit detaches) and its ASLR slide
  pub exe: Bytes = b""
  pub attached: Bool = false
  pub slide: Int = 0
  /// how long a command waits for the program's next stop, in
  /// milliseconds (`xo debug --timeout`); 0 waits as long as it runs
  pub wait_ms: Int = 0
}

/// A session on a recorded stopped thread: exe is the executable (its
/// unwind and symbol tables), dwarf its debug sections (the executable's
/// own, or a dSYM's).
pub fn session(exe: Bytes, dwarf: Sections, snap: Snapshot) -> Session {
  let info = read(dwarf)
  let l = lines(dwarf)
  let tab = tables(exe)
  let fs = vframes(info, l, tab, backtrace(tab, snap.regs, snap, 64))
  Session{info: info, lines: l, tab: tab, snap: snap, frames: fs}
}

/// The version of the JSON of `xo debug --json` (spec 10.7): a change
/// that removes or changes a field takes the next number; added fields
/// keep it.
pub const JSON_V = 1

/// A command's result: its text, and its JSON fields after "v", "cmd",
/// and "ok" (a comma separated list of `"name":value`, or "").
struct Res {
  text: Str
  json: Str
}

/// Runs command line `line`: its output, or an error's text.
pub fn (var s: Session) exec(line: Str) -> Str uses proc {
  match parse_cmd(line) {
    Ok(c) => match s.run_cmd(c) {
      Ok(r) => r.text
      Err(e) => "error: ${e}"
    }
    Err(e) => "error: ${e}"
  }
}

/// Runs command line `line`: one line of JSON, `{"v":1,"cmd":NAME,
/// "ok":true,...}` with the command's fields, or with "ok":false its
/// "error" (spec 10.7).
pub fn (var s: Session) exec_json(line: Str) -> Str uses proc {
  match parse_cmd(line) {
    Ok(c) => {
      let head = "{\"v\":${JSON_V},\"cmd\":${json_str(cmd_name(c))}"
      match s.run_cmd(c) {
        Ok(r) => "${head},\"ok\":true${if r.json.is_empty() { "" } else { ",${r.json}" }}}"
        Err(e) => "${head},\"ok\":false,\"error\":${json_str(e)}}"
      }
    }
    Err(e) => "{\"v\":${JSON_V},\"cmd\":\"\",\"ok\":false,\"error\":${json_str(e)}}"
  }
}

/// The command's name in JSON: its long form.
pub fn cmd_name(c: Cmd) -> Str {
  match c {
    Cmd.Break(_) => "break"
    Cmd.Delete(_) => "delete"
    Cmd.Run => "run"
    Cmd.Attach(_) => "attach"
    Cmd.Continue => "continue"
    Cmd.Step => "step"
    Cmd.Next => "next"
    Cmd.Finish => "finish"
    Cmd.Print(_) => "print"
    Cmd.Locals => "locals"
    Cmd.Backtrace => "backtrace"
    Cmd.Frame(_) => "frame"
    Cmd.Tasks => "tasks"
    Cmd.Task(_, _) => "task"
    Cmd.Threads => "threads"
    Cmd.Quit => "quit"
  }
}

fn (var s: Session) run_cmd(c: Cmd) -> Res ! Str uses proc {
  match c {
    Cmd.Break(spot) => {
      let id = s.bpts.add(s.info, s.lines, spot)?
      var at: List[Str] = []
      var js: List[Str] = []
      for p in s.bpts.list {
        if p.id == id {
          for a in p.addrs {
            at.push("0x${hex(a)}${s.where_(a)}")
            js.push(s.loc_json(a))
          }
        }
      }
      s.plant()?
      Ok(Res{text: "breakpoint ${id}: ${at.join(", ")}", json: "\"id\":${id},\"locations\":[${js.join(",")}]"})
    }
    Cmd.Delete(id) => {
      let gone = s.bpts.delete(id)?
      s.unplant(gone)
      Ok(Res{text: "deleted breakpoint ${id}", json: "\"id\":${id}"})
    }
    Cmd.Backtrace => {
      var out: List[Str] = []
      var js: List[Str] = []
      for (i, f) in s.frames.indexed() {
        let mark = if i == s.sel { "*" } else { " " }
        out.push("${mark} #${i} ${s.frame_text(f)}")
        js.push(s.frame_json(i, f))
      }
      Ok(Res{text: out.join("\n"), json: "\"frames\":[${js.join(",")}]"})
    }
    Cmd.Frame(n) => {
      if n >= s.frames.len() {
        return Err("no frame ${n} (${s.frames.len()} frames)")
      }
      s.sel = n
      Ok(Res{text: "#${n} ${s.frame_text(s.frames[n])}", json: "\"frame\":${s.frame_json(n, s.frames[n])}"})
    }
    Cmd.Locals => {
      let f = s.cur()?
      var out: List[Str] = []
      var js: List[Str] = []
      for v in f.vars {
        let (text, vj) = s.var_value(v)
        out.push("${v.name} = ${text}")
        js.push("{\"name\":${json_str(v.name)},\"type\":${json_str(s.info.type_name(v.ty))},\"param\":${v.param},${vj}}")
      }
      Ok(Res{text: if out.is_empty() { "no variables" } else { out.join("\n") }, json: "\"frame\":${s.sel},\"vars\":[${js.join(",")}]"})
    }
    Cmd.Print(path) => {
      let f = s.cur()?
      for v in f.vars {
        if v.name == path[0] {
          let val = value_in(s.info, v, s.selected_pc(), s.regs_of(), s.snap)?
          let x = field(val, path[1..])?
          let shown = x.show()
          return Ok(Res{text: "${path.join(".")} = ${shown}", json: "\"frame\":${s.sel},\"path\":${json_str(path.join("."))},\"text\":${json_str(shown)},\"value\":${val_json(x)}"})
        }
      }
      Err("no variable ${path[0].quote()} in frame ${s.sel}")
    }
    Cmd.Run => {
      if s.prog.is_empty() {
        return Err("this session is a recorded thread: run it with xo debug PROG")
      }
      let t = s.run()?
      Ok(Res{text: t, json: s.stop_json()})
    }
    Cmd.Attach(pid) => {
      if s.prog.is_empty() {
        return Err("this session is a recorded thread: attach with xo debug -p PID PROG")
      }
      let t = s.attach(pid)?
      Ok(Res{text: t, json: s.stop_json()})
    }
    Cmd.Continue => {
      if s.prog.is_empty() {
        return Err("this session is a recorded thread: run it with xo debug PROG")
      }
      let t = s.cont()?
      Ok(Res{text: t, json: s.stop_json()})
    }
    Cmd.Step | Cmd.Next | Cmd.Finish => {
      if s.prog.is_empty() {
        return Err("this session is a recorded thread: run it with xo debug PROG")
      }
      let t = match c {
        Cmd.Step => s.step_line(true)?
        Cmd.Next => s.step_line(false)?
        _ => s.finish()?
      }
      Ok(Res{text: t, json: s.stop_json()})
    }
    Cmd.Tasks => {
      let ts = s.task_walk()?
      var out: List[Str] = []
      var js: List[Str] = []
      for t in ts {
        out.push(task_text(t))
        js.push(task_json(t))
      }
      Ok(Res{text: if out.is_empty() { "no tasks" } else { out.join("\n") }, json: "\"tasks\":[${js.join(",")}]"})
    }
    Cmd.Task(id, bt) => {
      let ts = s.task_walk()?
      for t in ts {
        if t.id == id && id > 0 {
          var fs = s.task_frames(t)
          var on = 0
          if fs.is_empty() && t.state == "running" {
            // on a thread: its live registers
            let (rf, th) = s.running_frames(t)
            fs = rf
            on = th
          }
          if fs.is_empty() {
            return Err("task ${id} is ${t.state}: no stack of it can be read (a ready task has none; a running one run inline on another task's fiber is in that task's)")
          }
          s.frames = fs
          // the task's own code where it waits, not the scheduler's switch
          s.sel = user_frame(fs).max(0)
          s.task = id
          s.task_thread = on
          var js: List[Str] = []
          var out = [task_text(TaskRec{id: t.id, depth: 0, kind: t.kind, spawned: t.spawned, state: t.state, op: t.op, at: t.at, canceled: t.canceled})]
          for (i, f) in fs.indexed() {
            js.push(s.frame_json(i, f))
            if bt || i == s.sel {
              out.push("${if i == s.sel { "*" } else { " " }} #${i} ${s.frame_text(f)}")
            }
          }
          return Ok(Res{text: out.join("\n"), json: "\"task\":${task_json(t)},\"frames\":[${js.join(",")}]"})
        }
      }
      Err("no task ${id} (tasks lists them)")
    }
    Cmd.Threads => {
      if s.prog.is_empty() {
        return Ok(Res{text: "* thread 1 (recorded)", json: "\"threads\":[{\"id\":1,\"selected\":true,\"recorded\":true}]"})
      }
      if s.proc == 0 || s.thread == 0 {
        return Ok(Res{text: "no threads (the program is not stopped)", json: "\"threads\":[]"})
      }
      Ok(Res{text: "* thread ${s.thread}", json: "\"threads\":[{\"id\":${s.thread},\"selected\":true}]"})
    }
    Cmd.Quit => {
      s.end()
      s.done = true
      Ok(Res{text: "", json: ""})
    }
  }
}

/// A variable's value in the selected frame: its text, and the JSON
/// fields "text" and "value" (or "error" when it cannot be read).
fn (s: Session) var_value(v: Var) -> (Str, Str) {
  match value_in(s.info, v, s.selected_pc(), s.regs_of(), s.snap) {
    Ok(x) => {
      let t = x.show()
      (t, "\"text\":${json_str(t)},\"value\":${val_json(x)}")
    }
    Err(e) => (e, "\"text\":${json_str(e)},\"error\":${json_str(e)}")
  }
}

/// A value as JSON: a scalar `{"text":"10"}` (its text: integers keep
/// their 64 bits), a structure `{"type":"Point","fields":[{"name":"x",
/// "value":...}]}`, an array `{"type":"[3]","elements":[...]}`.
pub fn val_json(v: Val) -> Str {
  match v {
    Val.Text(t) => "{\"text\":${json_str(t)}}"
    Val.Parts(t, names, vals) => {
      var parts: List[Str] = []
      if t.starts_with("[") {
        for x in vals {
          parts.push(val_json(x))
        }
        "{\"type\":${json_str(t)},\"elements\":[${parts.join(",")}]}"
      } else {
        for (i, x) in vals.indexed() {
          parts.push("{\"name\":${json_str(names[i])},\"value\":${val_json(x)}}")
        }
        "{\"type\":${json_str(t)},\"fields\":[${parts.join(",")}]}"
      }
    }
  }
}

fn (s: Session) frame_json(i: Int, f: VFrame) -> Str {
  "{\"index\":${i},\"pc\":\"0x${hex(f.pc)}\",\"function\":${json_str(f.name)},\"inlined\":${f.inlined},\"file\":${json_str(f.file)},\"path\":${json_str(f.path)},\"line\":${f.line},\"selected\":${i == s.sel}}"
}

fn (s: Session) loc_json(a: Int) -> Str {
  match s.lines.at(a) {
    Some((f, n)) => "{\"pc\":\"0x${hex(a)}\",\"file\":${json_str(base_of(f))},\"line\":${n}}"
    None => "{\"pc\":\"0x${hex(a)}\"}"
  }
}

/// s as a JSON string: `"` and `\\` escaped, control characters as
/// \\u00XX.
pub fn json_str(s: Str) -> Str {
  var b = StrBuilder.new()
  b.write("\"")
  for r in s.runes() {
    if r == '"' {
      b.write("\\\"")
    } else if r == '\\' {
      b.write("\\\\")
    } else if r == '\n' {
      b.write("\\n")
    } else if Int(r) < 32 {
      let h = hex(Int(r))
      b.write("\\u${"0000"[0..4 - h.len()]}${h}")
    } else {
      b.write("${r}")
    }
  }
  b.write("\"")
  b.freeze()
}

fn (s: Session) cur() -> VFrame ! Str {
  if s.frames.is_empty() {
    return Err("no frames")
  }
  Ok(s.frames[s.sel])
}

/// The pc the selected frame's variables are read at: a caller's call
/// (the instruction before its return address).
fn (s: Session) selected_pc() -> Int {
  let f = s.frames[s.sel]
  if s.task != 0 {
    // a parked task's frames are all return addresses (its fiber's
    // switch); a running one's first physical frame is its thread's pc
    if s.task_thread != 0 {
      var first = true
      for i in 0..s.sel {
        if !s.frames[i].inlined {
          first = false
        }
      }
      if first {
        return f.pc
      }
    }
    return f.pc - s.tab.ret_back()
  }
  // the first physical frame is the one at index 0 and the frames
  // inlined in it
  var first = true
  for i in 0..s.sel {
    if !s.frames[i].inlined {
      first = false
    }
  }
  if first { f.pc } else { f.pc - s.tab.ret_back() }
}

/// The registers of the selected frame: none (the thread's own) for the
/// first physical frame.
fn (s: Session) regs_of() -> Map[Int, Int] {
  if s.task != 0 {
    return s.frames[s.sel].regs
  }
  if s.selected_pc() == s.frames[s.sel].pc { {} } else { s.frames[s.sel].regs }
}

fn (s: Session) show(f: VFrame, v: Var) -> Str {
  let _f = f
  match value_in(s.info, v, s.selected_pc(), s.regs_of(), s.snap) {
    Ok(x) => x.show()
    Err(e) => e
  }
}

fn (s: Session) frame_text(f: VFrame) -> Str {
  let at = if f.file.is_empty() { "" } else { " at ${f.file}:${f.line}" }
  "0x${hex(f.pc)} ${f.name}${if f.inlined { " [inlined]" } else { "" }}${at}"
}

/// " at FILE:LINE" for address a, or "".
fn (s: Session) where_(a: Int) -> Str {
  match s.lines.at(a) {
    Some((f, n)) => " (${base_of(f)}:${n})"
    None => ""
  }
}
