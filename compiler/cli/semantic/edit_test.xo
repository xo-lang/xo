// Tests of the semantic edits' file writes.

test "an edit's rollback bytes: empty for a new file, an error for an unreadable one" {
  expect(rollback_bytes(Ok(b"fn a() {}\n"), "a.xo")) == Ok(b"fn a() {}\n")
  expect(rollback_bytes(Err(FsErr.NotFound(path: "c.xo")), "c.xo")) == Ok(b"")
  // "" here made a failed rename restore the file empty
  expect(rollback_bytes(Err(FsErr.Io(path: "b.xo", msg: "input/output error")), "b.xo").is_err()) == true
}

test "write_all writes every file and creates new ones" {
  os.fs.write("a.xo", b"fn a() {}\n")?
  expect(write_all(os.fs, [("a.xo", b"fn a2() {}\n"), ("c.xo", b"fn c() {}\n")]).is_ok()) == true
  expect(os.fs.read("a.xo")?) == b"fn a2() {}\n"
  expect(os.fs.read("c.xo")?) == b"fn c() {}\n"
}
