// `xo query` (cmd/xo tools.go runQueryWith, hash.go queryHash).

use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/hostpath

/// The usage text of `xo query` (compiler/cli/cmdhelp).
fn query_usage() -> Str {
  cmdhelp.usage("query")
}

fn run_query(os: Os, args: List[Str]) -> Int {
  if args.is_empty() {
    os.stdio.eprint(query_usage())
    return 2
  }
  // flags anywhere: before the kind, between, or after (decision 0289)
  var as_json = !os.stdio.stdout_is_tty()
  var dir = "."
  var dir_set = false
  var kind = ""
  var rest: List[Str] = []
  for a in args {
    if a == "--json" || a == "-json" {
      as_json = true
    } else if a == "--text" || a == "-text" {
      as_json = false
    } else if a.starts_with("--dir=") {
      dir = a.trim_prefix("--dir=")
      dir_set = true
    } else if a.starts_with("-") && a != "-" {
      os.stdio.eprint("xo query: unknown flag ${a}\n\n${query_usage()}")
      return 2
    } else if kind.is_empty() {
      kind = a
    } else {
      rest.push(a)
    }
  }
  if kind.is_empty() {
    os.stdio.eprint(query_usage())
    return 2
  }
  // the directory in / form on Windows, as the checker's paths are: a
  // C:\x --dir found the asked package but not the workspace packages
  // importing it (`xo query callers`, 2026-11-10)
  dir = host_slash(dir)
  if kind == "holes" && rest.len() == 1 && !dir_set {
    // `xo query holes DIR`: the directory, as --dir names it (a field
    // report of 0.25.2 wrote `xo query holes .`)
    dir = host_slash(rest[0])
    dir_set = true
    rest = []
  }
  let want = if kind == "holes" { 0 } else { 1 }
  if rest.len() != want {
    os.stdio.eprint("xo query ${kind}: want ${want} argument(s)\n\n${query_usage()}")
    return 2
  }
  if kind is "api" | "imports" | "deps" && !dir_set {
    // a directory argument is the directory checked (decision 0515):
    // its module and imports answer, not the whole workspace around it
    let a = rest[0]
    if !a.starts_with("std/") && (os.fs.read_dir(a).ok() ?? []).any(fn(e) { !e.is_dir && e.name.ends_with(".xo") }) {
      dir = host_slash(a)
    }
  }
  if kind != "type" && !(rest.first() ?? "").starts_with("std/") && mod_root(os.fs, wd_of(os), dir).is_empty() && !xo_below(os.fs, abs_path(wd_of(os), dir), 2) {
    // no module above, none below and no Xo files: an empty answer would
    // read as "none" (decision 0437); a std module needs no module, and a
    // directory of modules is a root
    os.stdio.eprintln("xo query: ${if dir_set { dir } else { "the current directory" }} is not inside a module (no xo.mod above it, no .xo files); pass --dir=DIR")
    return 2
  }
  var dirs = [dir]
  var file = ""
  var line = 0
  var col = 0
  if kind == "type" {
    match parse_pos(rest[0]) {
      Ok(p) => {
        file = in_dir(os, if dir_set { dir } else { "" }, p.0)
        line = p.1
        col = p.2
      }
      Err(e) => {
        os.stdio.eprintln("xo query type: ${e}")
        return 2
      }
    }
    if !dir_set {
      // the file's own directory, wherever the command runs
      dirs = [dir_of(file)]
    } else if !within(wd_of(os), file, dir) {
      dirs.push(dir_of(file))
    }
  }
  if kind == "hash" {
    // syntactic: no check run (decision 0125)
    return query_hash(os, dir, rest[0], as_json)
  }
  if !(kind is "type" | "def" | "callers" | "effects" | "holes" | "api" | "imports" | "deps") {
    os.stdio.eprint("xo query: unknown kind ${kind.quote()}\n\n${query_usage()}")
    return 2
  }
  semantic_query(os, kind, dirs, rest, file, line, col, as_json)
}

/// Splits `file:line:col`.
fn parse_pos(s: Str) -> (Str, Int, Int) ! Str {
  let parts = s.split(":")
  if parts.len() < 3 {
    return Err("want file:line:col, got ${s.quote()}")
  }
  let n = parts.len()
  let line = Int.parse(parts[n - 2])
  let col = Int.parse(parts[n - 1])
  match (line, col) {
    (Some(l), Some(c)) => {
      if l < 1 || c < 1 {
        return Err("want file:line:col with positive numbers, got ${s.quote()}")
      }
      Ok((parts[0..n - 2].join(":"), l, c))
    }
    _ => Err("want file:line:col with positive numbers, got ${s.quote()}")
  }
}

/// p with Windows's \ separators as /; p itself elsewhere.
fn host_slash(p: Str) -> Str {
  if hostpath.windows() { p.replace("\\", "/") } else { p }
}

/// Whether path lies under dir.
/// A relative FILE with --dir names a file under the directory when one
/// is there and none is under the working directory (xo mcp's query tool
/// passes its dir argument as --dir; Intel field report 0.26.0).
fn in_dir(os: Os, dir: Str, file: Str) -> Str uses fs.read {
  if dir.is_empty() || hostpath.is_abs(file) {
    return file
  }
  let joined = "${dir.trim_suffix("/")}/${file}"
  // xo:allow XO0903 a path it cannot stat is left for the query to report
  if !(os.fs.exists(file).ok() ?? false) && (os.fs.exists(joined).ok() ?? false) {
    return joined
  }
  file
}

fn within(wd: Str, path: Str, dir: Str) -> Bool {
  let ap = abs_path(wd, path)
  let ad = abs_path(wd, dir)
  if ad == "/" {
    return true
  }
  ap == ad || ap.starts_with("${ad}/")
}

/// `xo query hash <name>` (core 4.3, decision 0125): the definition hashes
/// of the module holding dir. It needs no check run.
fn query_hash(os: Os, dir: Str, name: Str, as_json: Bool) -> Int {
  let wd = wd_of(os)
  var root = mod_root(os.fs, wd, dir)
  var mod_path = ""
  if !root.is_empty() {
    mod_path = mod_path_of(os.fs, root)
  }
  if root.is_empty() || mod_path.is_empty() {
    root = abs_path(wd, dir)
    mod_path = base_of(root)
  }
  let defs = match module_defs(os.fs, root, mod_path) {
    Ok(d) => d
    Err(e) => {
      os.stdio.eprintln("xo query hash: ${e}")
      return 2
    }
  }
  let found = find_defs(defs, name)
  if found.is_empty() {
    var msg = "${name.quote()} does not name a definition of the module ${mod_path}"
    let near = nearest(defs, name, 3)
    if !near.is_empty() {
      msg = "${msg} (did you mean ${near.join(", ")}?)"
    }
    os.stdio.eprintln("xo query hash: ${msg}")
    return 1
  }
  if as_json {
    var items: List[JVal] = []
    for d in found {
      items.push(def_json(d))
    }
    os.stdio.print(encode(JVal.Obj([("list", JVal.Arr(items))])))
    return 0
  }
  for d in found {
    os.stdio.print("${d.hash}  ${d.kind} ${d.id} (${d.file}:${d.line})\n  own ${d.own}\n")
  }
  0
}

/// Whether d, or a directory at most depth levels below it, holds a .xo
/// file or an xo.mod (a root of modules, as `xo def --dir=ROOT` takes).
fn xo_below(fs: Fs, d: Str, depth: Int) -> Bool {
  for e in fs.read_dir(d).ok() ?? [] {
    if !e.is_dir && (e.name.ends_with(".xo") || e.name == "xo.mod") {
      return true
    }
    if e.is_dir && depth > 0 && !e.name.starts_with(".") && xo_below(fs, "${d}/${e.name}", depth - 1) {
      return true
    }
  }
  false
}
