// The semantic queries of `xo query` (core 10.3): a port of
// internal/query over compiler/check's records. A Session is a checked
// program; positions, names, and signatures are those of the Go tool.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser

/// A checked program to query.
pub struct Session {
  pub c: check.Checker
  pub wd: Str
}

/// Checks the modules under dirs (query.Load): with the other modules of
/// their workspace unless exact (query.LoadExact). overlay replaces the
/// sources of files by absolute path (check.CheckOverlay).
pub fn load_session(os: Os, dirs0: List[Str], exact: Bool, overlay: Map[Str, Bytes]) -> Session ! Str uses env, fs, proc {
  load_session_for(os, dirs0, exact, overlay, [], false)
}

/// load_session with the std and runtime modules names refer to loaded
/// too, imported or not (preloads_for), so a lookup of `tls.client` or
/// `pool.park_wait` finds them.
pub fn load_session_for(os: Os, dirs0: List[Str], exact: Bool, overlay: Map[Str, Bytes], names: List[Str], wide: Bool) -> Session ! Str uses env, fs, proc {
  load_session_pc(os, dirs0, exact, overlay, names, wide, {}, Bodies.All)
}

/// Which function bodies a query's check parses and checks: every one,
/// none (a lookup of declarations: def, api, imports, deps), or those
/// that spell one of the words (callers: the names' last segments).
pub enum Bodies {
  All
  Decls
  Spelling(words: List[Str])
}

/// load_session_for reusing the std parses of an earlier check (pc, its
/// Checker.parse_cache): `xo edit`'s check of the edited program
/// (decision 0289).
pub fn load_session_pc(os: Os, dirs0: List[Str], exact: Bool, overlay: Map[Str, Bytes], names: List[Str], wide: Bool, pc: Map[Str, check.ParseEntry], bodies: Bodies) -> Session ! Str uses env, fs, proc {
  let wd = wd_of(os)
  let std = std_dir_of(os)
  var c = check.new_checker(os.fs, std)
  c.parse_cache = pc
  match bodies {
    All => {}
    Decls => c.decls_only = true
    Spelling(words: w) => c.body_words = w
  }
  for n in names {
    for p in if wide { preloads_wide(os, std, n) } else { preloads_for(os, std, n) } {
      if !c.preload.contains(p) {
        c.preload.push(p)
      }
    }
  }
  c.set_mod_env(wd, os.env.get("XO_MODCACHE") ?? "", os.env.get("HOME") ?? "", os.env.get("XDG_CACHE_HOME") ?? "", os.env.get("XO_OFFLINE") ?? "", os.env.get("XO_WORK") ?? "")
  c.cbind_dir = os.env.get("XO_CBIND_DIR") ?? ""
  c.gobind_dir = os.env.get("XO_GOBIND_DIR") ?? ""
  c.set_overlay(overlay)
  // xo query and xo edit cover the modules below a workspace or
  // repository root (decision 0289), within the walk's bound (0345)
  c.walk_all = true
  let dirs = if exact { dirs0 } else { c.workspace_dirs(dirs0) }
  c.check_dirs_bound(os, dirs)?
  if !c.unsupported.is_empty() {
    return Err("the self hosted checker cannot check this program: ${c.unsupported}")
  }
  Ok(Session{c: c, wd: wd})
}

/// The std and runtime modules a name may refer to (decision 0289): the
/// module of its import path (`std/tls.client`, `native/prelude.f`,
/// `native/llrt/pool.f`), or the std, native std, and runtime modules
/// named by its first segment (`tls.client`, `prelude.str_trim_end_chars`,
/// `pool.park_wait`), those std has a file for.
pub fn preloads_for(os: Os, std_dir: Str, name: Str) -> List[Str] uses fs.read {
  var cands: List[Str] = []
  if let Some(i) = last_index(name, "/") {
    let tail = name[i..]
    let p = name[0..i + (tail.find(".") ?? tail.len())]
    if p.starts_with("std/") || p.starts_with("native/") {
      cands.push(p)
    }
  } else {
    // a module's name is snake_case; `Chan.new` names a type's member
    let first = name.split(".")[0]
    let b = first.bytes()
    if !first.is_empty() && b[0] >= 'a' && b[0] <= 'z' {
      // std/X, the native backends' std/native/X (prelude.str_trim_end_chars
      // is native/prelude's), and the runtime's native/llrt/X
      cands = ["std/${first}", "native/${first}", "native/llrt/${first}"]
    }
  }
  var out: List[Str] = []
  for p in cands {
    // listed, not stat'ed: a case-insensitive file system (macOS) finds
    // chan.xo for Chan.xo
    let (dir, base) = if p.starts_with("std/") {
      (std_dir, p.trim_prefix("std/"))
    } else if p.starts_with("native/llrt/") {
      ("${std_dir}/native/llrt", p.trim_prefix("native/llrt/"))
    } else {
      ("${std_dir}/native", p.trim_prefix("native/"))
    }
    if let Ok(es) = os.fs.read_dir(dir) {
      if es.any(fn(e) { !e.is_dir && e.name == "${base}.xo" }) {
        out.push(p)
      }
    }
  }
  out
}

/// preloads_for, widened for references and callers: with a std module,
/// every std module; with a runtime module, every runtime module (their
/// uses are in the other modules of the same tree, tasks.xo's call of
/// pool.park_wait). Only the files whose text holds the name's last
/// segment are added: a reference spells it (every std module checked
/// with its body took about 1.7 s a query). With a std module the
/// runtime's files are scanned too: the native modules a filter leaves
/// out are no longer there to bring in the runtime files they import
/// (pgwire.xo's calls of Str.trim_prefix).
pub fn preloads_wide(os: Os, std_dir: Str, name: Str) -> List[Str] uses fs.read {
  let segs = name.split("/")
  let ds = segs[segs.len() - 1].split(".")
  let word = ds[ds.len() - 1]
  var out: List[Str] = []
  for p in preloads_for(os, std_dir, name) {
    if !out.contains(p) {
      out.push(p)
    }
    let trees = if p.starts_with("native/llrt/") {
      [("native/llrt/", "native/llrt/")]
    } else if p.starts_with("native/") {
      [("native/", "native/"), ("native/llrt/", "native/llrt/")]
    } else {
      [("", "std/"), ("native/llrt/", "native/llrt/")]
    }
    for (sub, prefix) in trees {
      if let Ok(es) = os.fs.read_dir("${std_dir}/${sub}") {
        for fi in es {
          if fi.is_dir || !fi.name.ends_with(".xo") || fi.name.ends_with("_test.xo") || fi.name.ends_with("_c.xo") {
            continue
          }
          let q = "${prefix}${fi.name.trim_suffix(".xo")}"
          if out.contains(q) {
            continue
          }
          // xo:allow XO0903 a file it cannot read is left out, as a missing one
          let text = os.fs.read("${std_dir}/${sub}${fi.name}").ok() ?? b""
          if check.spells_ident(text, word) {
            out.push(q)
          }
        }
      }
    }
  }
  out
}

/// The runtime modules (native/llrt/X) whose file spells the last
/// segment of one of names: xo refs over std itself loads them, since no
/// module checked there may import them (pg.xo, imported by native/sql).
pub fn runtime_spelling(os: Os, std_dir: Str, names: List[Str]) -> List[Str] uses fs.read {
  var words: List[Str] = []
  for n in names {
    let segs = n.split("/")
    let ds = segs[segs.len() - 1].split(".")
    words.push(ds[ds.len() - 1])
  }
  var out: List[Str] = []
  if let Ok(es) = os.fs.read_dir("${std_dir}/native/llrt") {
    for fi in es {
      if fi.is_dir || !fi.name.ends_with(".xo") || fi.name.ends_with("_test.xo") || fi.name.ends_with("_c.xo") {
        continue
      }
      // xo:allow XO0903 a file it cannot read is left out, as a missing one
      let text = os.fs.read("${std_dir}/native/llrt/${fi.name}").ok() ?? b""
      if words.any(fn(w) { check.spells_ident(text, w) }) {
        out.push("native/llrt/${fi.name.trim_suffix(".xo")}")
      }
    }
  }
  out
}

/// What to add to "no declaration named NAME" (decision 0289): that
/// min, max, and clamp are built into every ordered type, and the std
/// functions of that name; "" for neither.
pub fn miss_hint(os: Os, std_dir: Str, name: Str) -> Str uses fs.read {
  var out = ""
  let segs = name.split(".")
  if segs.len() == 2 && segs[1] is "min" | "max" | "clamp" {
    out = "; `${segs[1]}` is a built-in method of ordered types (Int, Float, Str, ...): `a.${segs[1]}(b)`"
  }
  let ty = habit_type(name)
  if !ty.is_empty() {
    out = "${out}; ${ty}"
  }
  let alts = std_suggestions(os, std_dir, name)
  // the name itself, in a std file the module does not load (a std/native
  // implementation file, searched from the repository's root): where to
  // look instead of a suggestion of the same name
  for a in alts {
    if a.starts_with(name + " (std/") {
      let file = a[name.len() + 2..a.len() - 1]
      let dir = file[0..(file.rfind("/") ?? 0)]
      return "${out}; `${name}` is declared in ${file}, outside the module searched: give --dir=${dir} (or the path to it)"
    }
  }
  if !alts.is_empty() {
    out = "${out}; did you mean ${alts.join(", ")}?"
  }
  out
}

/// Xo's name for a type an agent knows from another language
/// (`xo doc String`: Xo's string type is `Str`), or "".
fn habit_type(name: Str) -> Str {
  let (xo, from) = match name.to_lower() {
    "string" | "str" | "&str" => ("Str", "a string")
    "int" | "integer" | "int64" | "i64" | "long" => ("Int", "a 64-bit integer")
    "bool" | "boolean" => ("Bool", "a boolean")
    "float64" | "f64" | "double" | "float" => ("Float", "a 64-bit float")
    "byte" | "[]byte" | "bytes" | "u8" => ("Bytes", "bytes")
    "map" | "dict" | "hashmap" | "dictionary" => ("Map", "a map")
    "slice" | "array" | "vec" | "vector" | "list" | "arraylist" => ("List", "a list")
    "error" => ("Result", "an error result (`T ! E`, core 2.6)")
    "nil" | "null" | "none" | "option" | "optional" => ("Option", "an optional value (`T?`, core 2.5)")
    _ => ("", "")
  }
  if xo.is_empty() || xo == name {
    return ""
  }
  "Xo's type for ${from} is `${xo}` (`xo doc ${xo}`)"
}

/// The std and runtime functions named like name's last segment, as
/// `module.name (file:line)`, for a name that resolves to nothing
/// (`crypto.verify_pss` is `rsa.verify_pss`): a scan of the std files'
/// `fn` lines, at most 5.
pub fn std_suggestions(os: Os, std_dir: Str, name: Str) -> List[Str] uses fs.read {
  let segs = name.split(".")
  let last = segs[segs.len() - 1]
  if last.is_empty() || std_dir.is_empty() {
    return []
  }
  var out: List[Str] = []
  for sub in ["", "native/", "native/llrt/"] {
    let entries = match os.fs.read_dir("${std_dir}/${sub}") {
      Ok(es) => es
      Err(_) => continue
    }
    for fi in entries {
      if fi.is_dir || !fi.name.ends_with(".xo") || fi.name.ends_with("_test.xo") {
        continue
      }
      let src = match os.fs.read("${std_dir}/${sub}${fi.name}") {
        Ok(b) => b.to_str() ?? ""
        Err(_) => continue
      }
      let module = fi.name.trim_suffix(".xo")
      for (i, l) in src.split("\n").indexed() {
        let t = l.trim_prefix("pub ")
        if !t.starts_with("fn ") {
          continue
        }
        // `fn name(`, `fn name[T](`, or a method `fn (r: T) name(`
        let at = if t.starts_with("fn (") { (t.find(") ") ?? -1) + 2 } else { 3 }
        if at < 2 {
          continue
        }
        let r = t[at..]
        if r.starts_with(last + "(") || r.starts_with(last + "[") {
          // a method by its receiver's type (`fn (a: Atomic[Int]) max(`)
          var qual = if sub == "native/" { "native/${module}" } else { module }
          if t.starts_with("fn (") {
            let recv = t[4..at - 2]
            let ty = recv[(recv.find(": ") ?? -2) + 2..]
            qual = ty[0..(ty.find("[") ?? ty.len())]
          }
          out.push("${qual}.${last} (std/${sub}${fi.name}:${i + 1})")
          if out.len() >= 5 {
            return out
          }
        }
      }
    }
  }
  out
}

/// The std declaration files: $XO_STD, else lib/xo/std of a release
/// layout beside the binary Env.program names (check.std_dir).
fn std_dir_of(os: Os) -> Str uses env, fs.read {
  check.std_dir(os.env, os.fs)
}

/// A source position in query results.
pub struct Pos {
  pub file: Str
  pub line: Int
  pub col: Int
}

fn pos_json(p: Pos) -> JVal {
  JVal.Obj([("file", JVal.Text(p.file)), ("line", JVal.Num(p.line)), ("col", JVal.Num(p.col))])
}

fn pos_text(p: Pos) -> Str {
  "${p.file}:${p.line}:${p.col}"
}

fn (s: Session) span_pos(f: Int, sp: parser.Span) -> Pos {
  Pos{file: s.c.files[f].path, line: sp.start.line, col: sp.start.col}
}

/// The modules in dependency order (Info.AllModules).
fn (s: Session) all_modules() -> List[Int] {
  s.c.order
}

/// The loaded modules that are not std or Go bindings.
fn (s: Session) user_modules() -> List[Int] {
  var out: List[Int] = []
  for m in s.c.order {
    if !s.c.mods[m].is_std {
      out.push(m)
    }
  }
  out
}

// ---------------------------------------------------------------------------
// type

/// The answer of `xo query type file:line:col`.
pub struct TypeResult {
  pub pos: Pos
  pub expr: Str
  pub kind: Str
  pub typ: Str
  pub natural: Str
  pub span: Pos
}

/// The type of the innermost expression or binding pattern at line:col
/// of file.
pub fn (s: Session) type_at(file: Str, line: Int, col: Int) -> TypeResult ! Str {
  let f = s.find_file(file)
  if f < 0 {
    return Err("${file} is not part of the checked modules")
  }
  let src = s.c.files[f].src
  let target = offset_of(src, line, col)
  if target < 0 {
    return Err("${file} has no position ${line}:${col}")
  }
  var best_len = -1
  var best_e: Expr? = None
  var best_p: Pattern? = None
  var best_sp = parser.Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  for d in s.c.files[f].ast.decls {
    for n in decl_nodes(d) {
      let sp = node_span(n)
      if target < sp.start.offset || target >= sp.end.offset {
        continue
      }
      if let E(e) = n {
        if s.c.type_in(f, e) >= 0 {
          let l = sp.end.offset - sp.start.offset
          if best_len < 0 || l < best_len {
            best_len = l
            best_e = Some(e)
            best_p = None
            best_sp = sp
          }
        }
      }
      for pt in patterns_of(n) {
        for q in sub_patterns(pt) {
          if let BindPat(qsp, _) = q {
            if s.c.pat_type_in(f, q) >= 0 && (qsp.start.offset <= target && target < qsp.end.offset || (qsp.start.offset == target && qsp.end.offset == target)) {
              let l = qsp.end.offset - qsp.start.offset
              if best_len < 0 || l < best_len {
                best_len = l
                best_e = None
                best_p = Some(q)
                best_sp = qsp
              }
            }
          }
        }
      }
    }
  }
  if best_len < 0 {
    return Err("no typed expression at ${file}:${line}:${col}")
  }
  var r = TypeResult{pos: Pos{file: s.c.files[f].path, line: line, col: col}, expr: src[best_sp.start.offset..best_sp.end.offset].to_str() ?? "", kind: "", typ: "", natural: "", span: s.span_pos(f, best_sp)}
  if let Some(e) = best_e {
    r.kind = "expr"
    r.typ = s.c.show(s.c.type_in(f, e))
    let nt = s.c.nat_in(f, e)
    if nt >= 0 {
      let ns = s.c.show(nt)
      if ns != r.typ {
        r.natural = ns
      }
    }
  } else if let Some(p) = best_p {
    r.kind = "binding"
    r.typ = s.c.show(s.c.pat_type_in(f, p))
  }
  Ok(r)
}

fn type_json(r: TypeResult) -> JVal {
  var ms: List[(Str, JVal)] = [("pos", pos_json(r.pos)), ("expr", JVal.Text(r.expr)), ("kind", JVal.Text(r.kind)), ("type", JVal.Text(r.typ))]
  if !r.natural.is_empty() {
    ms.push(("natural", JVal.Text(r.natural)))
  }
  ms.push(("span", pos_json(r.span)))
  JVal.Obj(ms)
}

/// The file of the checked modules at path (absolute or as named).
fn (s: Session) find_file(path: Str) -> Int {
  let a = abs_path(s.wd, path)
  for m in s.c.order {
    for f in s.c.mods[m].files {
      let fp = s.c.files[f].path
      if abs_path(s.wd, fp) == a || fp == path {
        return f
      }
    }
  }
  -1
}

/// The offset of a 1 based line and byte column, -1 when there is none.
pub fn offset_of(src: Bytes, line: Int, col: Int) -> Int {
  var l = 1
  var start = 0
  var i = 0
  while i < src.len() && l < line {
    if src[i] == '\n' {
      l += 1
      start = i + 1
    }
    i += 1
  }
  if l != line || col < 1 {
    return -1
  }
  let off = start + col - 1
  if off > src.len() {
    return -1
  }
  for j in start..off {
    if src[j] == '\n' {
      return -1
    }
  }
  off
}

// ---------------------------------------------------------------------------
// Names

/// One declaration a name resolves to (query.Def).
pub struct QDef {
  /// fn, method, struct, enum, interface, alias, newtype, const, field,
  /// variant
  pub kind: Str
  pub name: Str
  pub module: Str
  pub pos: Pos
  pub signature: Str
  pub doc: Str = ""
  /// The function, or the object (function, type, constant), -1 for
  /// fields and variants.
  pub fn_obj: Int = -1
  pub obj: Int = -1
}

pub fn qdef_json(d: QDef) -> JVal {
  var ms: List[(Str, JVal)] = [("kind", JVal.Text(d.kind)), ("name", JVal.Text(d.name)), ("module", JVal.Text(d.module)), ("pos", pos_json(d.pos)), ("signature", JVal.Text(d.signature))]
  if !d.doc.is_empty() {
    ms.push(("doc", JVal.Text(d.doc)))
  }
  JVal.Obj(ms)
}

/// The declarations name refers to.
pub fn (s: Session) def(name: Str) -> List[QDef] ! Str {
  let defs = s.resolve(name)
  if defs.is_empty() {
    return Err("${name.quote()} does not name a declaration in the checked modules")
  }
  Ok(defs)
}

/// The objects name refers to (functions, types, constants), resolved as
/// by def (Session.Objects).
pub fn (s: Session) objects(name: Str) -> List[Int] {
  var out: List[Int] = []
  for d in s.resolve(name) {
    if d.obj >= 0 {
      out.push(d.obj)
    }
  }
  out
}

fn (s: Session) resolve(name: Str) -> List[QDef] {
  var out: List[QDef] = []
  var seen: Set[Str] = #{}
  // module path qualified: std/http.server, example.com/a/b.f
  if let Some(i) = last_index(name, "/") {
    let tail = name[i..]
    if let Some(j) = tail.find(".") {
      if j > 0 {
        let m = s.module_by_path(name[0..i + j])
        if m >= 0 {
          add_defs(out, seen, s.lookup(m, name[i + j + 1..].split(".")))
        }
      }
    }
    return out
  }
  let parts = name.split(".")
  if parts.len() > 1 {
    // a std module's implementation for the native backends
    // (std/native/http.xo, module native/http) shares its name: it
    // answers only for what the std module does not declare
    // (prelude.str_trim_end_chars), so http.client stays std's
    let impl = fn(m: Int) -> Bool { s.c.mods[m].path.starts_with("native/") && !s.c.mods[m].path.starts_with("native/llrt/") }
    for m in s.c.order {
      if s.c.mods[m].name == parts[0] && !impl(m) {
        add_defs(out, seen, s.lookup(m, parts[1..]))
      }
    }
    if out.is_empty() {
      for m in s.c.order {
        if s.c.mods[m].name == parts[0] && impl(m) {
          add_defs(out, seen, s.lookup(m, parts[1..]))
        }
      }
    }
    // `main.f`: the program's own modules (main's module is named for
    // its directory)
    if parts[0] == "main" {
      for m in s.c.root_mods {
        add_defs(out, seen, s.lookup(m, parts[1..]))
      }
    }
    // an import's local name as a program file writes it (`use x/y as z`)
    for m in s.user_modules() {
      for f in s.c.mods[m].files {
        if let Some(im) = s.c.files[f].imports.get(parts[0].bytes()) {
          add_defs(out, seen, s.lookup(im.module, parts[1..]))
        }
      }
    }
  }
  for m in s.user_modules() {
    add_defs(out, seen, s.lookup(m, parts))
  }
  if out.is_empty() && s.c.prelude >= 0 {
    add_defs(out, seen, s.lookup(s.c.prelude, parts))
  }
  out
}

fn add_defs(var out: List[QDef], var seen: Set[Str], ds: List[QDef]) {
  for d in ds {
    let k = "${d.kind}|${pos_text(d.pos)}|${d.name}"
    if !seen.contains(k) {
      seen.add(k)
      out.push(d)
    }
  }
}

fn last_index(s: Str, sub: Str) -> Int? {
  let b = s.bytes()
  let c = sub.bytes()[0]
  var i = b.len() - 1
  while i >= 0 {
    if b[i] == c {
      return Some(i)
    }
    i -= 1
  }
  None
}

/// A loaded module by import path or directory (Session.ModuleByPath),
/// -1 when there is none.
pub fn (s: Session) module_by_path(path: Str) -> Int {
  for m in s.c.order {
    if s.c.mods[m].path == path {
      return m
    }
  }
  let a = abs_path(s.wd, path)
  for m in s.c.order {
    if s.c.mods[m].is_std {
      continue
    }
    if abs_path(s.wd, s.c.mods[m].dir) == a || s.c.mods[m].path.ends_with("/${path}") {
      return m
    }
  }
  -1
}

fn (s: Session) lookup(m: Int, segs: List[Str]) -> List[QDef] {
  if m < 0 || segs.is_empty() || segs.len() > 2 {
    return []
  }
  let o = s.c.mods[m].members.get(segs[0].bytes()) ?? -1
  if o < 0 {
    return []
  }
  let obj = s.c.objs[o]
  if obj.decl_file >= 0 && s.c.files[obj.decl_file].generated {
    // code a derive generates is not a declaration of the program
    return []
  }
  if segs.len() == 1 {
    return match obj.kind {
      Func => [s.fn_def(o)]
      Type => [s.type_def(o)]
      Const => [s.const_def(o)]
      _ => []
    }
  }
  if obj.kind != check.ObjKind.Type {
    return []
  }
  let member = segs[1].bytes()
  if let Some(f) = obj.methods.get(member) {
    return [s.fn_def(f)]
  }
  if let Some(f) = obj.statics.get(member) {
    return [s.fn_def(f)]
  }
  for f in obj.iface_meths {
    if s.c.objs[f].name == member {
      return [s.fn_def(f)]
    }
  }
  let tname = txt(obj.name)
  let mpath = s.c.mods[m].path
  for f in obj.fields {
    if f.name == member {
      var sig = "${txt(f.name)}: ${s.c.show(f.ty)}"
      if f.is_pub {
        sig = "pub ${sig}"
      }
      return [QDef{kind: "field", name: "${tname}.${txt(f.name)}", module: mpath, pos: Pos{file: obj.file, line: f.line, col: f.col}, signature: sig}]
    }
  }
  for v in obj.variants {
    if v.name == member {
      var sig = txt(v.name)
      if !v.unit {
        var fs: List[Str] = []
        for f in v.fields {
          if f.from {
            fs.push("from ${s.c.show(f.ty)}")
          } else {
            fs.push("${txt(f.name)}: ${s.c.show(f.ty)}")
          }
        }
        sig = "${sig}(${fs.join(", ")})"
      }
      return [QDef{kind: "variant", name: "${tname}.${txt(v.name)}", module: mpath, pos: Pos{file: obj.file, line: v.line, col: v.col}, signature: sig}]
    }
  }
  []
}

fn doc_text(d: parser.Doc?) -> Str {
  match d {
    Some(x) => txt(x.text)
    None => ""
  }
}

/// The declaration of an object: its file's index and the declaration.
fn (s: Session) decl_of(o: Int) -> (Int, Decl)? {
  let obj = s.c.objs[o]
  if obj.decl_file < 0 || obj.decl_idx < 0 {
    return None
  }
  let decls = s.c.files[obj.decl_file].ast.decls
  if obj.decl_idx >= decls.len() {
    return None
  }
  Some((obj.decl_file, decls[obj.decl_idx]))
}

fn (s: Session) fn_def(f: Int) -> QDef {
  let obj = s.c.objs[f]
  let mpath = if obj.module >= 0 { s.c.mods[obj.module].path } else { "" }
  var d = QDef{kind: if obj.recv >= 0 { "method" } else { "fn" }, name: s.c.display_name(f), module: mpath, pos: Pos{file: obj.file, line: obj.line, col: obj.col}, signature: "", fn_obj: f, obj: f}
  if let Some(fd) = obj.fn_decl.first() {
    d.doc = doc_text(fd.doc)
    if obj.decl_file >= 0 {
      d.signature = fmt_decl(Decl.FnDecl(fd), s.c.files[obj.decl_file].src, true)
    }
  }
  if d.signature.is_empty() {
    // an interface method (or a prelude one) whose declaration text is not
    // at hand: its signature from its parameters, result, error, and
    // effects (decision 0289)
    d.signature = s.method_sig(f)
  }
  d
}

/// `fn Iface.name(params) -> R ! E uses X` of function object f, from its
/// checked types.
fn (s: Session) method_sig(f: Int) -> Str {
  let o = s.c.objs[f]
  var ps: List[Str] = []
  for p in o.params {
    let kw = if p.is_var { "var " } else { "" }
    ps.push("${kw}${txt(p.name)}: ${s.c.show(p.ty)}")
  }
  var sig = "fn ${s.c.display_name(f)}(${ps.join(", ")})"
  if o.result >= 0 && o.result != s.c.unit_ty {
    sig = "${sig} -> ${s.c.show(o.result)}"
  }
  if o.err >= 0 {
    sig = "${sig} ! ${s.c.show(o.err)}"
  }
  if let Some(u) = s.c.declared_text(f) {
    if !u.is_empty() {
      sig = "${sig} uses ${u}"
    }
  }
  sig
}

fn (s: Session) type_def(t: Int) -> QDef {
  let obj = s.c.objs[t]
  let mpath = if obj.module >= 0 { s.c.mods[obj.module].path } else { "" }
  var d = QDef{kind: obj.tkind, name: txt(obj.name), module: mpath, pos: Pos{file: obj.file, line: obj.line, col: obj.col}, signature: "", obj: t}
  if let Some((f, decl)) = s.decl_of(t) {
    d.signature = fmt_decl(decl, s.c.files[f].src, true)
    d.doc = decl_doc(decl)
  }
  d
}

fn (s: Session) const_def(o: Int) -> QDef {
  let obj = s.c.objs[o]
  let mpath = if obj.module >= 0 { s.c.mods[obj.module].path } else { "" }
  var d = QDef{kind: "const", name: txt(obj.name), module: mpath, pos: Pos{file: obj.file, line: obj.line, col: obj.col}, signature: "", obj: o}
  if let Some((f, decl)) = s.decl_of(o) {
    d.signature = fmt_decl(decl, s.c.files[f].src, true)
    d.doc = decl_doc(decl)
  }
  d
}

pub fn decl_doc(d: Decl) -> Str {
  match d {
    FnDecl(x) => doc_text(x.doc)
    StructDecl(x) => doc_text(x.doc)
    EnumDecl(x) => doc_text(x.doc)
    InterfaceDecl(x) => doc_text(x.doc)
    TypeDecl(x) => doc_text(x.doc)
    ConstDecl(x) => doc_text(x.doc)
    TestDecl(x) => doc_text(x.doc)
    BadDecl(_) => ""
  }
}

/// name resolved to exactly one function or method.
fn (s: Session) func_target(name: Str) -> Int ! Str {
  var fns: List[Int] = []
  for d in s.resolve(name) {
    if d.fn_obj >= 0 {
      fns.push(d.fn_obj)
    }
  }
  if fns.is_empty() {
    return Err("${name.quote()} does not name a function or method in the checked modules")
  }
  if fns.len() == 1 {
    return Ok(fns[0])
  }
  var names: List[Str] = []
  for f in fns {
    names.push("${s.fn_module(f)}.${s.c.display_name(f)}")
  }
  Err("${name.quote()} is ambiguous: ${names.join(", ")}; qualify it with the module")
}

fn (s: Session) fn_module(f: Int) -> Str {
  let m = s.c.objs[f].module
  if m >= 0 { s.c.mods[m].path } else { "" }
}

// ---------------------------------------------------------------------------
// callers

/// One reference to a function: a call, or a use as a value.
pub struct Caller {
  pub caller: Str
  pub module: Str
  /// call or value
  pub kind: Str
  pub pos: Pos
}

/// Every call of function name, and every use of it as a value, in the
/// user modules; the target's display name.
pub fn (s: Session) callers(name: Str) -> (Str, List[Caller]) ! Str {
  let target = s.func_target(name)?
  var out: List[Caller] = []
  for m in s.user_modules() {
    for f in s.c.mods[m].files {
      for (i, d) in s.c.files[f].ast.decls.indexed() {
        let encl = s.enclosing(f, i, d)
        var seen: Set[Int] = #{}
        for n in decl_nodes(d) {
          if let E(e) = n {
            match e {
              CallExpr(sp, fun, _) => {
                if let Some(ci) = s.c.call_in(f, e) {
                  if ci.fn_obj == target {
                    out.push(Caller{caller: encl, module: s.c.mods[m].path, kind: "call", pos: s.span_pos(f, sp)})
                    seen.add(s.c.expr_key_in(f, fun))
                    if let TypeArgsExpr(_, x, _) = fun {
                      seen.add(s.c.expr_key_in(f, x))
                    }
                  }
                }
              }
              Ident(id) => {
                if !seen.contains(s.c.expr_key_in(f, e)) && s.c.ref_of(f, id) == target {
                  out.push(Caller{caller: encl, module: s.c.mods[m].path, kind: "value", pos: s.span_pos(f, id.span)})
                }
              }
              SelectorExpr(sp, _, sel) => {
                if !seen.contains(s.c.expr_key_in(f, e)) && s.c.ref_of(f, sel) == target {
                  out.push(Caller{caller: encl, module: s.c.mods[m].path, kind: "value", pos: s.span_pos(f, sp)})
                }
              }
              _ => {}
            }
          }
        }
      }
    }
  }
  Ok(("${s.fn_module(target)}.${s.c.display_name(target)}", out))
}

/// The enclosing declaration's name: `fn`, `Type.method`, `test "name"`,
/// `const NAME`, `struct Name`.
fn (s: Session) enclosing(f: Int, i: Int, d: Decl) -> Str {
  match d {
    FnDecl(x) => {
      let o = s.c.files[f].decl_objs.get(i) ?? -1
      if o >= 0 {
        return s.c.display_name(o)
      }
      txt(x.name.name)
    }
    TestDecl(x) => {
      if let Some(n) = x.name {
        if n.parts.len() == 1 {
          return "test ${txt(n.parts[0].text).quote()}"
        }
      }
      "test"
    }
    ConstDecl(x) => "const ${txt(x.name.name)}"
    StructDecl(x) => "struct ${txt(x.name.name)}"
    _ => "?"
  }
}

fn caller_json(c: Caller) -> JVal {
  JVal.Obj([("caller", JVal.Text(c.caller)), ("module", JVal.Text(c.module)), ("kind", JVal.Text(c.kind)), ("pos", pos_json(c.pos))])
}

// ---------------------------------------------------------------------------
// effects

/// The answer of `xo query effects`.
pub struct EffectsResult {
  pub target: Str
  pub declared: List[Str]
  pub inferred: Bool
  pub performed: List[check.EffectUse]
}

/// The effects function name performs, each with its call chain.
pub fn (s: Session) effects(name: Str) -> EffectsResult ! Str {
  let target = s.func_target(name)?
  var r = EffectsResult{target: "${s.fn_module(target)}.${s.c.display_name(target)}", declared: [], inferred: false, performed: s.c.performed_by(target)}
  match s.c.declared_text(target) {
    None => r.inferred = true
    Some(t) => {
      if !t.is_empty() {
        r.declared = t.split(", ")
      }
    }
  }
  Ok(r)
}

fn effects_json(r: EffectsResult) -> JVal {
  var perf: List[JVal] = []
  for e in r.performed {
    var chain: List[JVal] = []
    for st in e.chain {
      chain.push(JVal.Obj([("message", JVal.Text(st.message)), ("pos", pos_json(Pos{file: st.file, line: st.line, col: st.col}))]))
    }
    var ms: List[(Str, JVal)] = [("effect", JVal.Text(e.effect))]
    if e.param {
      ms.push(("param", JVal.Bool(true)))
    }
    ms.push(("chain", JVal.Arr(chain)))
    perf.push(JVal.Obj(ms))
  }
  JVal.Obj([("target", JVal.Text(r.target)), ("declared", strs(r.declared)), ("inferred", JVal.Bool(r.inferred)), ("performed", JVal.Arr(perf))])
}

// ---------------------------------------------------------------------------
// holes

/// The hole reports (XO0900) of the checked modules.
pub fn (s: Session) holes() -> List[check.Diag] {
  var out: List[check.Diag] = []
  for d in s.c.diags {
    if d.code == "XO0900" {
      out.push(d)
    }
  }
  out
}

// ---------------------------------------------------------------------------
// api

/// The pub declarations of the module with the given import path or
/// directory: its path and items.
pub fn (s: Session) api(path: Str) -> (Str, List[QDef]) ! Str {
  let m = s.module_by_path(path)
  if m < 0 {
    return Err("no module ${path.quote()} among the checked modules")
  }
  Ok((s.c.mods[m].path, s.surface(m, false)))
}

/// The declarations of m, pub ones only unless all; test files and test
/// blocks left out; files in path order.
pub fn (s: Session) surface(m: Int, all0: Bool) -> List[QDef] {
  // a std module's declaration file is all surface: its declarations
  // carry no `pub` (std/json.xo's `fn decode`; `xo query api std/json`
  // listed nothing, 2026-10-26)
  let all = all0 || s.c.mods[m].is_std
  var out: List[QDef] = []
  var files: List[(Str, Int)] = []
  for f in s.c.mods[m].files {
    files.push((s.c.files[f].path, f))
  }
  for pf in files.sort() {
    let f = pf.1
    if s.c.files[f].is_test || s.c.files[f].generated {
      continue
    }
    for (i, d) in s.c.files[f].ast.decls.indexed() {
      if let FnDecl(x) = d {
        if x.is_pub || all {
          let o = s.c.files[f].decl_objs.get(i) ?? -1
          if o >= 0 && s.c.objs[o].kind == check.ObjKind.Func {
            out.push(s.fn_def(o))
            continue
          }
        }
      }
      if let Some(def) = decl_surface(s.c.mods[m].path, s.c.files[f].path, s.c.files[f].src, d, all) {
        out.push(def)
      }
    }
  }
  out
}

/// The `xo query api` entry of one parsed declaration of module path,
/// from the syntax tree alone (query.DeclSurface): pub ones only unless
/// all. Methods are named `Type.name`.
pub fn decl_surface(path: Str, file: Str, src: Bytes, d: Decl, all: Bool) -> QDef? {
  let pos = fn(id: parser.Ident) -> Pos { Pos{file: file, line: id.span.start.line, col: id.span.start.col} }
  match d {
    FnDecl(x) => {
      if !x.is_pub && !all {
        return None
      }
      var name = txt(x.name.name)
      var kind = "fn"
      if let Some(r) = x.recv {
        kind = "method"
        if let NamedType(_, p, _) = r.typ {
          if !p.is_empty() {
            name = "${txt(p[p.len() - 1].name)}.${name}"
          }
        }
      }
      Some(QDef{kind: kind, name: name, module: path, pos: pos(x.name), signature: fmt_decl(d, src, true), doc: doc_text(x.doc)})
    }
    ConstDecl(x) => {
      if !x.is_pub && !all {
        return None
      }
      Some(QDef{kind: "const", name: txt(x.name.name), module: path, pos: pos(x.name), signature: fmt_decl(d, src, true), doc: doc_text(x.doc)})
    }
    StructDecl(x) => {
      if !x.is_pub && !all {
        return None
      }
      var c = x
      if !all {
        var fs: List[parser.Field] = []
        for fl in x.fields {
          if fl.is_pub {
            fs.push(fl)
          }
        }
        c = x with {fields: fs, inv: None}
      }
      Some(QDef{kind: "struct", name: txt(x.name.name), module: path, pos: pos(x.name), signature: fmt_decl(Decl.StructDecl(c), src, true), doc: doc_text(x.doc)})
    }
    EnumDecl(x) => {
      if !x.is_pub && !all {
        return None
      }
      Some(QDef{kind: "enum", name: txt(x.name.name), module: path, pos: pos(x.name), signature: fmt_decl(d, src, true), doc: doc_text(x.doc)})
    }
    InterfaceDecl(x) => {
      if !x.is_pub && !all {
        return None
      }
      Some(QDef{kind: "interface", name: txt(x.name.name), module: path, pos: pos(x.name), signature: fmt_decl(d, src, true), doc: doc_text(x.doc)})
    }
    TypeDecl(x) => {
      if !x.is_pub && !all {
        return None
      }
      let kind = if x.newtype { "newtype" } else { "alias" }
      Some(QDef{kind: kind, name: txt(x.name.name), module: path, pos: pos(x.name), signature: fmt_decl(d, src, true), doc: doc_text(x.doc)})
    }
    _ => None
  }
}

// ---------------------------------------------------------------------------
// imports and deps (decision 0095)

/// One `use` line.
pub struct ImportEdge {
  pub from: Str
  pub path: Str
  pub pos: Pos
  pub std: Bool = false
  pub go: Bool = false
  pub c: Bool = false
  pub in_test: Bool = false
  pub missing: Bool = false
  pub denied: Str = ""
}

/// The answer of `xo query imports` and `xo query deps`.
pub struct ImportsResult {
  pub package: Str
  pub transitive: Bool
  pub imports: List[ImportEdge]
  pub packages: List[Str]
}

/// The `use` lines of the package with the given import path or
/// directory; with transitive, of every package it reaches that is not
/// std or a Go binding too.
pub fn (s: Session) imports(path: Str, transitive: Bool) -> ImportsResult ! Str {
  let m0 = s.module_by_path(path)
  if m0 >= 0 && s.c.mods[m0].is_std || m0 < 0 && (path.starts_with("std/") || path.starts_with("native/")) {
    // imports and deps follow a program's packages; std's are not followed
    return Err("${path.quote()} is a std module: imports and deps list a program's packages, and std ones are not followed (xo query api ${path} lists its surface)")
  }
  if m0 < 0 {
    return Err("no package ${path.quote()} among the checked modules")
  }
  var denied: Map[Str, Str] = {}
  for d in s.c.diags {
    if d.code == "XO1312" {
      denied["${d.file}:${d.line}:${d.col}"] = d.message
    }
  }
  var res = ImportsResult{package: s.c.mods[m0].path, transitive: transitive, imports: [], packages: []}
  var seen: Set[Str] = #{s.c.mods[m0].path}
  var reached: Set[Str] = #{}
  var queue = [m0]
  var qi = 0
  while qi < queue.len() {
    let cur = queue[qi]
    qi += 1
    var files: List[(Str, Int)] = []
    for f in s.c.mods[cur].files {
      files.push((s.c.files[f].path, f))
    }
    for pf in files.sort() {
      let f = pf.1
      for u in s.c.files[f].ast.imports {
        let up = txt(u.path)
        if up.is_empty() {
          continue
        }
        var e = ImportEdge{from: s.c.mods[cur].path, path: up, pos: s.span_pos(f, u.span), go: u.go, c: u.c, in_test: s.c.files[f].is_test, std: !u.go && !u.c && up.starts_with("std/")}
        e.denied = denied.get(pos_text(e.pos)) ?? ""
        var dep = -1
        if !u.go && !u.c {
          for m in s.c.order {
            if s.c.mods[m].path == up {
              dep = m
            }
          }
          e.missing = dep < 0
        }
        res.imports.push(e)
        reached.add(up)
        if transitive && dep >= 0 && !s.c.mods[dep].is_std && !seen.contains(s.c.mods[dep].path) {
          seen.add(s.c.mods[dep].path)
          queue.push(dep)
        }
      }
    }
    if !transitive {
      break
    }
  }
  res.packages = reached.to_list().sort()
  Ok(res)
}

fn imports_json(r: ImportsResult) -> JVal {
  var items: List[JVal] = []
  for e in r.imports {
    var ms: List[(Str, JVal)] = [("from", JVal.Text(e.from)), ("path", JVal.Text(e.path)), ("pos", pos_json(e.pos))]
    if e.std {
      ms.push(("std", JVal.Bool(true)))
    }
    if e.go {
      ms.push(("go", JVal.Bool(true)))
    }
    if e.c {
      ms.push(("c", JVal.Bool(true)))
    }
    if e.in_test {
      ms.push(("test", JVal.Bool(true)))
    }
    if e.missing {
      ms.push(("missing", JVal.Bool(true)))
    }
    if !e.denied.is_empty() {
      ms.push(("denied", JVal.Text(e.denied)))
    }
    items.push(JVal.Obj(ms))
  }
  JVal.Obj([("package", JVal.Text(r.package)), ("transitive", JVal.Bool(r.transitive)), ("imports", JVal.Arr(items)), ("packages", strs(r.packages))])
}

// ---------------------------------------------------------------------------
// The command (tools.go runQueryWith after the session is loaded)

fn semantic_query(os: Os, kind: Str, dirs: List[Str], rest: List[Str], file: Str, line: Int, col: Int, as_json: Bool) -> Int uses env, fs, proc, stdio {
  // a name may be a std or runtime module's the program does not import
  // (api names a module: a std one loads too, so `xo query api std/json`
  // outside a module answers)
  let names = if kind is "def" | "callers" | "effects" | "api" { rest } else { [] }
  // def, api, imports and deps read declarations only, and callers the
  // bodies that spell the name's last segment (XO_LOOKUP_EAGER=1: every
  // body; TestQueryLookupsEager)
  var bodies = Bodies.All
  if (os.env.get("XO_LOOKUP_EAGER") ?? "") != "1" {
    if kind is "def" | "api" | "imports" | "deps" {
      bodies = Bodies.Decls
    } else if kind == "callers" && rest.len() == 1 {
      let segs = rest[0].split("/")
      let ds = segs[segs.len() - 1].split(".")
      let w = ds[ds.len() - 1]
      if !w.is_empty() {
        bodies = Bodies.Spelling(words: [w])
      }
    }
  }
  let s = match load_session_pc(os, dirs, false, {}, names, kind == "callers", {}, bodies) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo query: ${e}")
      return 2
    }
  }
  var res = JVal.Null
  var text = ""
  var err = ""
  match kind {
    "type" => match s.type_at(file, line, col) {
      Ok(r) => {
        res = type_json(r)
        text = "${pos_text(r.pos)}: `${r.expr}`: ${r.typ}"
        if !r.natural.is_empty() {
          text = "${text} (converted from ${r.natural})"
        }
        text = "${text}\n"
      }
      Err(e) => err = e
    }
    "def" => match s.def(rest[0]) {
      Ok(ds) => {
        var items: List[JVal] = []
        var b = StrBuilder.new()
        for d in ds {
          items.push(qdef_json(d))
          b.write("${pos_text(d.pos)}: ${d.kind} ${d.name} (module ${d.module})\n")
          if !d.doc.is_empty() {
            b.write("${prefix_lines(d.doc, "/// ")}\n")
          }
          b.write("${d.signature}\n")
        }
        res = JVal.Arr(items)
        text = b.freeze()
      }
      Err(e) => {
        err = e + miss_hint(os, std_dir_of(os), rest[0])
      }
    }
    "callers" => match s.callers(rest[0]) {
      Ok((target, cs)) => {
        var items: List[JVal] = []
        var b = StrBuilder.new()
        for c in cs {
          items.push(caller_json(c))
          b.write("${pos_text(c.pos)}: ${c.kind} in ${c.module}.${c.caller}\n")
        }
        b.write("${cs.len()} reference(s) to ${target}\n")
        res = JVal.Obj([("target", JVal.Text(target)), ("callers", JVal.Arr(items))])
        text = b.freeze()
      }
      Err(e) => err = e
    }
    "effects" => match s.effects(rest[0]) {
      Ok(r) => {
        res = effects_json(r)
        var b = StrBuilder.new()
        if r.inferred {
          b.write("${r.target}: effects inferred\n")
        } else if r.declared.is_empty() {
          b.write("${r.target}: declared pure\n")
        } else {
          b.write("${r.target}: declares uses ${r.declared.join(", ")}\n")
        }
        if r.performed.is_empty() {
          b.write("performs no effects\n")
        }
        for ef in r.performed {
          b.write("performs ${ef.effect}\n")
          for st in ef.chain {
            b.write("  ${st.file}:${st.line}:${st.col}: ${st.message}\n")
          }
        }
        text = b.freeze()
      }
      Err(e) => err = e
    }
    "holes" => {
      let hs = s.holes()
      var items: List[JVal] = []
      var b = StrBuilder.new()
      for d in hs {
        items.push(diag_json(d))
        b.write("${diag_human(d)}\n")
      }
      b.write("${hs.len()} hole(s)\n")
      res = JVal.Arr(items)
      text = b.freeze()
    }
    "imports" | "deps" => match s.imports(rest[0], kind == "deps") {
      Ok(r) => {
        res = imports_json(r)
        var b = StrBuilder.new()
        for e in r.imports {
          b.write("${pos_text(e.pos)}: ${e.from} uses ${e.path}")
          if e.missing {
            b.write(" (not found)")
          }
          if !e.denied.is_empty() {
            b.write(" (denied, XO1312)")
          }
          b.write("\n")
        }
        b.write("${r.imports.len()} use line(s), ${r.packages.len()} package(s)\n")
        text = b.freeze()
      }
      Err(e) => err = e
    }
    "api" => match s.api(rest[0]) {
      Ok((mpath, items)) => {
        var js: List[JVal] = []
        var b = StrBuilder.new()
        b.write("module ${mpath}\n")
        for d in items {
          js.push(qdef_json(d))
          b.write("\n${d.signature}\n")
        }
        res = JVal.Obj([("module", JVal.Text(mpath)), ("items", JVal.Arr(js))])
        text = b.freeze()
      }
      Err(e) => err = e
    }
    _ => {}
  }
  if !err.is_empty() {
    os.stdio.eprintln("xo query ${kind}: ${err}")
    return 1
  }
  if as_json {
    os.stdio.print(encode(res))
    return 0
  }
  os.stdio.print(text)
  0
}

/// Each line of s prefixed, trailing spaces trimmed (tools.go
/// prefixLines).
fn prefix_lines(s: Str, prefix: Str) -> Str {
  var out: List[Str] = []
  for l in s.split("\n") {
    out.push("${prefix}${l}".trim_end())
  }
  out.join("\n")
}

/// diag.Human: `file:line:col: severity CODE: message`, then each note
/// and fix on a line of its own.
pub fn diag_human(d: check.Diag) -> Str {
  let sev = if d.note_sev { "note" } else if d.warning { "warning" } else { "error" }
  var b = StrBuilder.new()
  if !d.file.is_empty() {
    if d.line == 0 {
      b.write("${d.file}: ")
    } else {
      b.write("${d.file}:${d.line}:${d.col}: ")
    }
  }
  b.write("${sev} ${d.code}: ${d.message}")
  for n in d.notes {
    match n.span {
      Some(sp) => b.write("\n  note: ${sp.file}:${sp.line}:${sp.col}: ${n.message}")
      None => b.write("\n  note: ${n.message}")
    }
  }

  for f in d.fixes {
    b.write("\n  fix: ${f.title}")
  }
  b.freeze()
}
