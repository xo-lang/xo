// What an identifier of a checked file names (internal/lsp resolve.go),
// for `xo lsp`'s hover, definition, references, rename, and semantic
// tokens, and for `xo edit rename` of a type (decision 0289; moved here
// from compiler/cli/servers so both use one resolution). The Go server walks the syntax tree by reflection and looks at
// an identifier's parent and grandparent nodes; this walk visits the
// identifiers in the same order (the fields of compiler/parser's nodes
// are internal/ast's, in its order) and records for each the part of its
// parent and grandparent that resolve reads (SiteCtx).

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser

pub type Span = parser.Span

pub const MOD_DECLARATION = 1
pub const MOD_READONLY = 2
pub const MOD_DEFAULT_LIBRARY = 4

/// What resolve reads of an identifier's parent (and grandparent):
/// resolve.go's switch on the parent's node type.
pub enum SiteCtx {
  /// A parent the switch does not name.
  Other
  /// The function declared (FuncOf, or the interface's method), -1 for
  /// none, and whether it is a method.
  FnDecl(fo: Int, method: Bool)
  /// The receiver of function fo.
  Receiver(fo: Int)
  /// A parameter of a function or closure: its bindings (ParamVars,
  /// ClosureParams), empty for a test's.
  Param(vars: List[Int])
  /// A struct, enum, interface, or type declaration.
  TypeDecl
  TypeParam
  /// A field of the struct named name.
  Field(name: Bytes)
  /// A variant of the enum named name.
  Variant(name: Bytes)
  VariantField
  /// A constant declaration and the object it declares (-1 for a block
  /// constant).
  ConstDecl(co: Int)
  NamedType(path: List[parser.Ident])
  UseDecl
  /// The selector x and, when it is the callee of a call, that call.
  Selector(x: Expr, call: List[Expr])
  /// A field initializer of the struct literal or `with` g.
  FieldInit(g: List[Expr])
  Arg
  PatField
  VariantPat(p: Pattern, path: List[parser.Ident])
  StructPat(path: List[parser.Ident])
  /// An effect label or a loop label.
  Label
  /// The callee of a call (the call), or the X of a selector.
  CallFun(call: Expr)
  SelX
}

/// One identifier with its place: the Go field of the parent holding it,
/// its index there (-1 when the field is not a list), and the context.
pub struct IdentSite {
  pub id: parser.Ident
  pub field: Str
  pub index: Int
  pub ctx: SiteCtx
  /// The name of a property test's input (`test "x" for n: Int`): the Go
  /// checker records no binding for it (Info.VarOf is nil there; its
  /// uses have one).
  pub no_var: Bool = false
}

/// What an identifier names (resolve.go target): its semantic token type
/// ("" when unknown) and modifiers, the entity (obj, a key unique per
/// entity, "" for none; what and oi, sub say which), its declaration
/// (file as the checker names it, "" for none, and byte offsets), and the
/// hover text of an entity without a declaration to print.
pub struct LspTarget {
  pub kind: Str = ""
  pub mods: Int = 0
  pub obj: Str = ""
  pub what: Str = ""
  pub oi: Int = -1
  pub sub: Int = -1
  pub def_file: Str = ""
  pub def_start: Int = 0
  pub def_end: Int = 0
  pub label: Str = ""
}

/// sameObj.
pub fn same_obj(a: LspTarget, b: LspTarget) -> Bool {
  if !a.obj.is_empty() || !b.obj.is_empty() {
    return a.obj == b.obj
  }
  !a.def_file.is_empty() && a.def_file == b.def_file && a.def_start == b.def_start && a.def_end == b.def_end
}

pub fn is_upper(name: Bytes) -> Bool {
  !name.is_empty() && name[0] >= 'A' && name[0] <= 'Z'
}

// ---------------------------------------------------------------------------
// The walk (resolve.go idents)

pub struct Walk {
  pub c: check.Checker
  pub f: Int
  pub out: List[IdentSite] = []
  /// The byte ranges that scope local bindings (blocks, functions,
  /// closures, loops, `if`, match and select arms), for completion's
  /// names in scope (lsp_complete.xo).
  pub scopes: List[(Int, Int)] = []
  /// The byte ranges of `let` and `var` statements: what one declares is
  /// not in scope inside it.
  pub lets: List[(Int, Int)] = []
}

pub fn (var w: Walk) open_scope(sp: Span) {
  w.scopes.push((sp.start.offset, sp.end.offset))
}

pub fn (var w: Walk) add(id: parser.Ident, field: Str, index: Int, ctx: SiteCtx) {
  w.out.push(IdentSite{id: id, field: field, index: index, ctx: ctx})
}

/// The identifiers of file f of c in the Go walk's order.
pub fn idents_of(c: check.Checker, f: Int) -> List[IdentSite] {
  walk_file(c, f).out
}

/// The walk of file f of c: its identifiers and scope ranges.
pub fn walk_file(c: check.Checker, f: Int) -> Walk {
  var w = Walk{c: c, f: f}
  let file = c.files[f].ast
  for u in file.imports {
    if let Some(a) = u.alias {
      w.add(a, "Alias", -1, SiteCtx.UseDecl)
    }
    if let Some(es) = u.effects {
      w.effects(es)
    }
  }
  for (i, d) in file.decls.indexed() {
    w.decl(d, c.files[f].decl_objs.get(i) ?? -1)
  }
  w
}

pub fn (var w: Walk) effects(es: List[parser.Effect]) {
  for e in es {
    w.add(e.name, "Name", -1, SiteCtx.Label)
    if let Some(s) = e.sub {
      w.add(s, "Sub", -1, SiteCtx.Label)
    }
  }
}

pub fn (var w: Walk) decl(d: parser.Decl, o: Int) {
  match d {
    FnDecl(x) => {
      let fo = if o >= 0 && w.c.objs[o].kind == check.ObjKind.Func { o } else { -1 }
      w.fn_decl(x, fo, x.recv.is_some(), fo)
    }
    StructDecl(x) => {
      w.add(x.name, "Name", -1, SiteCtx.TypeDecl)
      w.type_params(x.type_params)
      for fl in x.fields {
        let ctx = SiteCtx.Field(name: x.name.name)
        w.add(fl.name, "Name", -1, ctx)
        w.typ(fl.typ)
        if let Some(e) = fl.default {
          w.expr(e, "Default", -1, ctx, [])
        }
      }
      if let Some(e) = x.inv {
        w.expr(e, "Inv", -1, SiteCtx.TypeDecl, [])
      }
      for (i, id) in x.derive.indexed() {
        w.add(id, "Derive", i, SiteCtx.TypeDecl)
      }
    }
    EnumDecl(x) => {
      w.add(x.name, "Name", -1, SiteCtx.TypeDecl)
      w.type_params(x.type_params)
      for v in x.variants {
        w.add(v.name, "Name", -1, SiteCtx.Variant(name: x.name.name))
        if let Some(fs) = v.fields {
          for vf in fs {
            if let Some(n) = vf.name {
              w.add(n, "Name", -1, SiteCtx.VariantField)
            }
            w.typ(vf.typ)
          }
        }
      }
      for (i, id) in x.derive.indexed() {
        w.add(id, "Derive", i, SiteCtx.TypeDecl)
      }
    }
    InterfaceDecl(x) => {
      w.add(x.name, "Name", -1, SiteCtx.TypeDecl)
      w.type_params(x.type_params)
      // the methods: FuncOf has none, so the interface's (ifaceMethod)
      let m = w.c.files[w.f].module
      var to = -1
      if let Some(t) = w.c.mods[m].members.get(x.name.name) {
        if w.c.objs[t].kind == check.ObjKind.Type {
          to = t
        }
      }
      for md in x.methods {
        var fo = -1
        if to >= 0 {
          for im in w.c.objs[to].iface_meths {
            if fo < 0 && w.c.objs[im].name == md.name.name {
              fo = im
            }
          }
        }
        w.fn_decl(md, fo, true, -1)
      }
    }
    TypeDecl(x) => {
      w.add(x.name, "Name", -1, SiteCtx.TypeDecl)
      w.type_params(x.type_params)
      if let Some(t) = x.typ {
        w.typ(t)
      }
    }
    ConstDecl(x) => w.const_decl(x, if o >= 0 && w.c.objs[o].kind == check.ObjKind.Const { o } else { -1 })
    TestDecl(x) => {
      w.open_scope(x.span)
      if let Some(n) = x.name {
        w.string_lit(n)
      }
      for tp in x.params {
        w.out.push(IdentSite{id: tp.name, field: "Name", index: -1, ctx: SiteCtx.Param(vars: []), no_var: true})
        if let Some(t) = tp.typ {
          w.typ(t)
        }
        if let Some(e) = tp.default {
          w.expr(e, "Default", -1, SiteCtx.Param(vars: []), [])
        }
      }
      if let Some(e) = x.seed {
        w.expr(e, "Seed", -1, SiteCtx.Other, [])
      }
      w.effects(x.effects)
      if let Some(b) = x.body {
        w.block(b)
      }
    }
    BadDecl(_) => {}
  }
}

/// A function declaration: fo is FuncOf (or the interface's method),
/// pv the function whose parameter bindings its parameters are (FuncOf).
pub fn (var w: Walk) fn_decl(x: parser.FnDecl, fo: Int, method: Bool, pv: Int) {
  w.open_scope(x.span)
  if let Some(r) = x.recv {
    w.add(r.name, "Name", -1, SiteCtx.Receiver(fo: pv))
    w.typ(r.typ)
  }
  w.add(x.name, "Name", -1, SiteCtx.FnDecl(fo: fo, method: method))
  w.type_params(x.type_params)
  let vars = if pv >= 0 { w.c.param_vars.get(pv) ?? [] } else { [] }
  w.params(x.params, vars)
  if let Some(t) = x.result {
    w.typ(t)
  }
  w.err_spec(x.err)
  w.clauses(x.clauses)
  if let Some(b) = x.body {
    w.block(b)
  }
}

pub fn (var w: Walk) type_params(tps: List[parser.TypeParam]) {
  for tp in tps {
    w.add(tp.name, "Name", -1, SiteCtx.TypeParam)
    if let Some(t) = tp.constraint {
      w.typ(t)
    }
  }
}

pub fn (var w: Walk) params(ps: List[parser.Param], vars: List[Int]) {
  for p in ps {
    let ctx = SiteCtx.Param(vars: vars)
    w.add(p.name, "Name", -1, ctx)
    if let Some(t) = p.typ {
      w.typ(t)
    }
    if let Some(e) = p.default {
      w.expr(e, "Default", -1, ctx, [])
    }
  }
}

pub fn (var w: Walk) err_spec(e: parser.ErrSpec?) {
  if let Some(es) = e {
    if let Some(t) = es.typ {
      w.typ(t)
    }
  }
}

pub fn (var w: Walk) clauses(cls: List[parser.Clause]) {
  for cl in cls {
    match cl {
      UsesClause(_, effects, _) => w.effects(effects)
      RequiresClause(_, _, cond, els) => {
        w.expr(cond, "Cond", -1, SiteCtx.Other, [])
        if let Some(e) = els {
          w.expr(e, "Else", -1, SiteCtx.Other, [])
        }
      }
      EnsuresClause(_, _, cond) => w.expr(cond, "Cond", -1, SiteCtx.Other, [])
    }
  }
}

pub fn (var w: Walk) const_decl(x: parser.ConstDecl, co: Int) {
  let ctx = SiteCtx.ConstDecl(co: co)
  w.add(x.name, "Name", -1, ctx)
  if let Some(t) = x.typ {
    w.typ(t)
  }
  w.expr(x.value, "Value", -1, ctx, [])
}

pub fn (var w: Walk) typ(t: parser.Type) {
  match t {
    NamedType(_, path, args) => {
      for (i, id) in path.indexed() {
        w.add(id, "Path", i, SiteCtx.NamedType(path: path))
      }
      for a in args {
        w.typ(a)
      }
    }
    OptionalType(_, elem) => w.typ(elem)
    TupleType(_, elems) => {
      for e in elems {
        w.typ(e)
      }
    }
    FnType(ft) => {
      for p in ft.params {
        w.typ(p.typ)
      }
      if let Some(r) = ft.result {
        w.typ(r)
      }
      w.err_spec(ft.err)
      w.effects(ft.effects)
    }
    BadType(_) => {}
  }
}

pub fn (var w: Walk) block(b: parser.Block) {
  w.open_scope(b.span)
  for st in b.stmts {
    w.stmt(st)
  }
}

pub fn (var w: Walk) opt_label(l: parser.Ident?) {
  if let Some(id) = l {
    w.add(id, "Label", -1, SiteCtx.Label)
  }
}

pub fn (var w: Walk) stmt(st: parser.Stmt) {
  match st {
    LetStmt(lsp, pattern, typ, value) => {
      w.lets.push((lsp.start.offset, lsp.end.offset))
      w.pat(pattern)
      if let Some(t) = typ {
        w.typ(t)
      }
      w.expr(value, "Value", -1, SiteCtx.Other, [])
    }
    VarStmt(vsp, name, typ, value) => {
      w.lets.push((vsp.start.offset, vsp.end.offset))
      w.add(name, "Name", -1, SiteCtx.Other)
      if let Some(t) = typ {
        w.typ(t)
      }
      w.expr(value, "Value", -1, SiteCtx.Other, [])
    }
    AssignStmt(_, _, target, value) => {
      w.expr(target, "LspTarget", -1, SiteCtx.Other, [])
      w.expr(value, "Value", -1, SiteCtx.Other, [])
    }
    DeferStmt(_, body) => w.stmt(body)
    ReturnStmt(_, value) => {
      if let Some(e) = value {
        w.expr(e, "Value", -1, SiteCtx.Other, [])
      }
    }
    BreakStmt(_, label) => {
      if let Some(id) = label {
        w.add(id, "Label", -1, SiteCtx.Other)
      }
    }
    ContinueStmt(_, label) => {
      if let Some(id) = label {
        w.add(id, "Label", -1, SiteCtx.Other)
      }
    }
    ForStmt(fsp, label, pattern, iter, bound, body, _) => {
      w.open_scope(fsp)
      w.opt_label(label)
      w.pat(pattern)
      w.expr(iter, "Iter", -1, SiteCtx.Other, [])
      for b in bound {
        w.expr(b, "Bound", -1, SiteCtx.Other, [])
      }
      w.block(body)
    }
    WhileStmt(wsp, label, cond, pattern, value, bound, body) => {
      w.open_scope(wsp)
      w.opt_label(label)
      if let Some(e) = cond {
        w.expr(e, "Cond", -1, SiteCtx.Other, [])
      }
      for p in pattern {
        w.pat(p)
      }
      for v in value {
        w.expr(v, "Value", -1, SiteCtx.Other, [])
      }
      for b in bound {
        w.expr(b, "Bound", -1, SiteCtx.Other, [])
      }
      w.block(body)
    }
    ExprStmt(_, x) => w.expr(x, "X", -1, SiteCtx.Other, [])
    BadStmt(_) => {}
    // a body the lazy parse skipped, read without parse_body (decision
    // 0351): a compiler bug, never an empty body
    LazyStmt(..) => fault("a lazily parsed function body was read before parse_body")
    ConstDecl(d) => w.const_decl(d, -1)
  }
}

pub fn (var w: Walk) string_lit(s: parser.StringLit) {
  for p in s.parts {
    if let Some(e) = p.expr {
      w.expr(e, "Expr", -1, SiteCtx.Other, [])
    }
  }
}

pub fn (var w: Walk) field_inits(fs: List[parser.FieldInit], g: Expr) {
  for fi in fs {
    w.add(fi.name, "Name", -1, SiteCtx.FieldInit(g: [g]))
    w.expr(fi.value, "Value", -1, SiteCtx.Other, [])
  }
}

/// An expression held by the field (and index) of a parent whose context
/// for a direct identifier child is ctx; call is the call whose callee e
/// is (empty otherwise).
pub fn (var w: Walk) expr(e: Expr, field: Str, index: Int, ctx: SiteCtx, call: List[Expr]) {
  match e {
    Ident(id) => w.add(id, field, index, ctx)
    StringLit(s) => w.string_lit(s)
    ParenExpr(_, x) => w.expr(x, "X", -1, SiteCtx.Other, [])
    TupleExpr(_, elems) => {
      for (i, x) in elems.indexed() {
        w.expr(x, "Elems", i, SiteCtx.Other, [])
      }
    }
    ListLit(_, elems) => {
      for (i, x) in elems.indexed() {
        w.expr(x, "Elems", i, SiteCtx.Other, [])
      }
    }
    SetLit(_, elems) => {
      for (i, x) in elems.indexed() {
        w.expr(x, "Elems", i, SiteCtx.Other, [])
      }
    }
    MapLit(_, entries) => {
      for me in entries {
        w.expr(me.key, "Key", -1, SiteCtx.Other, [])
        w.expr(me.value, "Value", -1, SiteCtx.Other, [])
      }
    }
    StructLit(_, typ, fields) => {
      w.expr(typ, "Type", -1, SiteCtx.Other, [])
      w.field_inits(fields, e)
    }
    UnaryExpr(_, _, x) => w.expr(x, "X", -1, SiteCtx.Other, [])
    BinaryExpr(_, _, x, y) => {
      w.expr(x, "X", -1, SiteCtx.Other, [])
      w.expr(y, "Y", -1, SiteCtx.Other, [])
    }
    IsExpr(_, x, pattern) => {
      w.expr(x, "X", -1, SiteCtx.Other, [])
      w.pat(pattern)
    }
    RangeExpr(_, lo, hi, _) => {
      if let Some(x) = lo {
        w.expr(x, "Lo", -1, SiteCtx.Other, [])
      }
      if let Some(x) = hi {
        w.expr(x, "Hi", -1, SiteCtx.Other, [])
      }
    }
    SelectorExpr(_, x, sel) => {
      w.expr(x, "X", -1, SiteCtx.SelX, [])
      w.add(sel, "Sel", -1, SiteCtx.Selector(x: e, call: call))
    }
    CallExpr(_, fun, args) => {
      w.expr(fun, "Fun", -1, SiteCtx.CallFun(call: e), [e])
      for (i, a) in args.indexed() {
        if let Some(n) = a.name {
          w.add(n, "Name", -1, SiteCtx.Arg)
        }
        w.expr(a.value, "Value", -1, SiteCtx.Other, [])
        let _ = i
      }
    }
    TypeArgsExpr(_, x, types) => {
      w.expr(x, "X", -1, SiteCtx.Other, [])
      for t in types {
        w.typ(t)
      }
    }
    IndexExpr(_, x, index0) => {
      w.expr(x, "X", -1, SiteCtx.Other, [])
      w.expr(index0, "Index", -1, SiteCtx.Other, [])
    }
    TryExpr(_, x) => w.expr(x, "X", -1, SiteCtx.Other, [])
    WithExpr(_, x, fields) => {
      w.expr(x, "X", -1, SiteCtx.Other, [])
      w.field_inits(fields, e)
    }
    IfExpr(ie) => w.if_expr(ie)
    MatchExpr(_, subject, arms) => {
      w.expr(subject, "Subject", -1, SiteCtx.Other, [])
      for arm in arms {
        w.open_scope(arm.span)
        w.pat(arm.pattern)
        if let Some(g) = arm.guard {
          w.expr(g, "Guard", -1, SiteCtx.Other, [])
        }
        if let Some(b) = arm.body {
          w.stmt(b)
        }
      }
    }
    ScopeExpr(_, name, body) => {
      w.add(name, "Name", -1, SiteCtx.Other)
      w.block(body)
    }
    SelectExpr(_, arms) => {
      for arm in arms {
        w.open_scope(arm.span)
        if let Some(b) = arm.bind {
          w.add(b, "Bind", -1, SiteCtx.Other)
        }
        if let Some(x) = arm.op {
          w.expr(x, "Op", -1, SiteCtx.Other, [])
        }
        if let Some(x) = arm.after {
          w.expr(x, "After", -1, SiteCtx.Other, [])
        }
        if let Some(b) = arm.body {
          w.stmt(b)
        }
      }
    }
    Block(b) => w.block(b)
    FnLit(lit) => {
      w.open_scope(lit.span)
      w.params(lit.params, w.c.closure_params(w.f, lit))
      if let Some(t) = lit.result {
        w.typ(t)
      }
      w.err_spec(lit.err)
      w.effects(lit.effects)
      w.block(lit.body)
    }
    WhileExpr(_, body) => w.block(body)
    _ => {}
  }
}

pub fn (var w: Walk) if_expr(ie: parser.IfExpr) {
  w.open_scope(ie.span)
  if let Some(x) = ie.cond {
    w.expr(x, "Cond", -1, SiteCtx.Other, [])
  }
  if let Some(p) = ie.pattern {
    w.pat(p)
  }
  if let Some(x) = ie.value {
    w.expr(x, "Value", -1, SiteCtx.Other, [])
  }
  w.block(ie.then)
  if let Some(x) = ie.els {
    w.expr(x, "Else", -1, SiteCtx.Other, [])
  }
}

pub fn (var w: Walk) pat_fields(fs: List[parser.PatField]) {
  for pf in fs {
    if let Some(n) = pf.name {
      w.add(n, "Name", -1, SiteCtx.PatField)
    }
    w.pat(pf.pattern)
  }
}

pub fn (var w: Walk) pat(p: Pattern) {
  match p {
    BindPat(_, name) => w.add(name, "Name", -1, SiteCtx.Other)
    LitPat(_, value) => w.expr(value, "Value", -1, SiteCtx.Other, [])
    RangePat(_, lo, hi, _) => {
      w.expr(lo, "Lo", -1, SiteCtx.Other, [])
      w.expr(hi, "Hi", -1, SiteCtx.Other, [])
    }
    OrPat(_, alts) => {
      for a in alts {
        w.pat(a)
      }
    }
    TuplePat(_, elems) => {
      for a in elems {
        w.pat(a)
      }
    }
    VariantPat(_, path, _, fields, _) => {
      for (i, id) in path.indexed() {
        w.add(id, "Path", i, SiteCtx.VariantPat(p: p, path: path))
      }
      w.pat_fields(fields)
    }
    StructPat(_, path, fields, _) => {
      for (i, id) in path.indexed() {
        w.add(id, "Path", i, SiteCtx.StructPat(path: path))
      }
      w.pat_fields(fields)
    }
    ListPat(_, elems, _) => {
      for a in elems {
        w.pat(a)
      }
    }
    _ => {}
  }
}

// ---------------------------------------------------------------------------
// Resolution (resolve.go resolve)

/// The checked program the resolution reads: the checker, and the line
/// starts of its files (for positions given as line and column).
pub struct Res {
  pub c: check.Checker
  pub lines: Map[Int, List[Int]] = {}
  /// The file index of each path the checker names.
  pub idx: Map[Str, Int] = {}
}

pub fn new_res(c: check.Checker) -> Res {
  var r = Res{c: c}
  for (i, f) in c.files.indexed() {
    if !r.idx.contains(f.path) {
      r.idx[f.path] = i
    }
  }
  r
}

/// The byte offset of 1 based line and column in the file the checker
/// names path, or -1.
pub fn (var r: Res) offset_in(path: Str, line: Int, col: Int) -> Int {
  let f = r.idx.get(path) ?? -1
  if f < 0 || line <= 0 {
    return -1
  }
  if !r.lines.contains(f) {
    var ls = [0]
    let src = r.c.files[f].src
    var i = 0
    while i < src.len() {
      if src[i] == '\n' {
        ls.push(i + 1)
      }
      i += 1
    }
    r.lines[f] = ls
  }
  let ls = r.lines.get(f) ?? []
  if line > ls.len() {
    return -1
  }
  ls[line - 1] + col - 1
}

/// The declaration of a name at line:col of path, len bytes long.
pub fn (var r: Res) def_at(t0: LspTarget, path: Str, line: Int, col: Int, len: Int) -> LspTarget {
  var t = t0
  let off = r.offset_in(path, line, col)
  if off >= 0 {
    t.def_file = path
    t.def_start = off
    t.def_end = off + len
  }
  t
}

pub fn with_def(t0: LspTarget, path: Str, sp: Span) -> LspTarget {
  var t = t0
  t.def_file = path
  t.def_start = sp.start.offset
  t.def_end = sp.end.offset
  t
}

pub fn (r: Res) is_std_mod(m: Int) -> Bool {
  m >= 0 && r.c.mods[m].is_std
}

/// The declaration name of object o's declaring decl (decl_file,
/// decl_idx), if it has one.
pub fn (r: Res) decl_name(o: Int) -> parser.Ident? {
  let f = r.c.objs[o].decl_file
  let i = r.c.objs[o].decl_idx
  if f < 0 || i < 0 || i >= r.c.files[f].ast.decls.len() {
    return None
  }
  match r.c.files[f].ast.decls[i] {
    StructDecl(x) => Some(x.name)
    EnumDecl(x) => Some(x.name)
    InterfaceDecl(x) => Some(x.name)
    TypeDecl(x) => Some(x.name)
    ConstDecl(x) => Some(x.name)
    FnDecl(x) => Some(x.name)
    _ => None
  }
}

/// varTarget.
pub fn (var r: Res) var_target(v: Int, id: parser.Ident, id_file: Str) -> LspTarget {
  let o = r.c.objs[v]
  var t = LspTarget{kind: "variable", obj: "o${v}", what: "local", oi: v}
  if o.local.contains("param") || o.local.contains("recv") {
    t.kind = "parameter"
  }
  t = r.def_at(t, o.file, o.line, o.col, o.name.len())
  if !t.def_file.is_empty() && t.def_start == id.span.start.offset && t.def_file == id_file {
    t.mods = t.mods | MOD_DECLARATION
  }
  t
}

/// objTarget.
pub fn (var r: Res) obj_target(o: Int) -> LspTarget {
  let ob = r.c.objs[o]
  match ob.kind {
    Func => {
      var t = LspTarget{kind: "function", obj: "o${o}", what: "func", oi: o}
      if ob.recv >= 0 || ob.iface {
        t.kind = "method"
      }
      if let Some(fd) = ob.fn_decl.first() {
        t = with_def(t, ob.file, fd.name.span)
      } else {
        t = r.def_at(t, ob.file, ob.line, ob.col, ob.name.len())
      }
      if r.is_std_mod(ob.module) {
        t.mods = t.mods | MOD_DEFAULT_LIBRARY
      }
      t
    }
    Const => {
      var t = LspTarget{kind: "variable", mods: MOD_READONLY, obj: "o${o}", what: "const", oi: o}
      if let Some(n) = r.decl_name(o) {
        t = with_def(t, r.c.files[ob.decl_file].path, n.span)
      }
      if r.is_std_mod(ob.module) {
        t.mods = t.mods | MOD_DEFAULT_LIBRARY
      }
      t
    }
    Type => r.type_target(o)
    Local => r.var_target(o, parser.Ident{span: Span{start: parser.Pos{offset: -1, line: 0, col: 0}, end: parser.Pos{offset: -1, line: 0, col: 0}}, name: b""}, "")
    _ => LspTarget{}
  }
}

/// typeTarget.
pub fn (var r: Res) type_target(to: Int) -> LspTarget {
  let ob = r.c.objs[to]
  var t = LspTarget{kind: "type", obj: "o${to}", what: "type", oi: to}
  if ob.tkind == "struct" {
    t.kind = "struct"
  } else if ob.tkind == "enum" {
    t.kind = "enum"
  } else if ob.tkind == "interface" {
    t.kind = "interface"
  }
  if let Some(n) = r.decl_name(to) {
    t = with_def(t, r.c.files[ob.decl_file].path, n.span)
  } else {
    t = r.def_at(t, ob.file, ob.line, ob.col, ob.name.len())
  }
  if r.is_std_mod(ob.module) {
    t.mods = t.mods | MOD_DEFAULT_LIBRARY
  }
  t
}

/// The file the checker names a type object's declaration by.
pub fn (r: Res) type_file(to: Int) -> Str {
  let f = r.c.objs[to].decl_file
  if f >= 0 { r.c.files[f].path } else { r.c.objs[to].file }
}

/// variantTarget.
pub fn (var r: Res) variant_target(en: Int, vi: Int) -> LspTarget {
  let v = r.c.objs[en].variants[vi]
  let t = LspTarget{kind: "enumMember", obj: "v${en}.${vi}", what: "variant", oi: en, sub: vi}
  r.def_at(t, r.type_file(en), v.line, v.col, v.name.len())
}

/// A field of struct to (fieldOf) as a target, or None.
pub fn (var r: Res) field_target(to: Int, name: Bytes, mods: Int) -> LspTarget? {
  for (i, fl) in r.c.objs[to].fields.indexed() {
    if fl.name == name {
      let t = LspTarget{kind: "property", mods: mods, obj: "f${to}.${i}", what: "field", oi: to, sub: i}
      return Some(r.def_at(t, r.type_file(to), fl.line, fl.col, fl.name.len()))
    }
  }
  None
}

/// namedObj: the Type object of a named type, or -1.
/// The type object a struct literal's type expression names (`T`,
/// `m.T`, either with type arguments), or -1: as type_name resolves it.
fn (r: Res) lit_type_obj(f: Int, te: Expr) -> Int {
  var o = -1
  match te {
    Ident(x) => o = r.scope_get(r.c.files[f].module, x.name)
    SelectorExpr(_, Ident(m), sel) => {
      if let Some(im) = r.c.files[f].imports.get(m.name) {
        o = r.scope_get(im.module, sel.name)
      }
    }
    TypeArgsExpr(_, x, _) => return r.lit_type_obj(f, x)
    _ => {}
  }
  if o >= 0 && r.c.objs[o].kind == check.ObjKind.Type { o } else { -1 }
}

pub fn (r: Res) named_obj(t: Int) -> Int {
  if t < 0 {
    return -1
  }
  let x = r.c.resolve(t)
  if r.c.tys[x].kind == check.TyKind.Named { r.c.tys[x].obj } else { -1 }
}

pub fn (r: Res) scope_get(m: Int, name: Bytes) -> Int {
  if m < 0 {
    return -1
  }
  r.c.mods[m].members.get(name) ?? -1
}

/// typeName.
pub fn (var r: Res) type_name(f: Int, path: List[parser.Ident], kind0: Str) -> LspTarget {
  var o = -1
  let name = path[path.len() - 1].name
  if path.len() == 1 {
    o = r.scope_get(r.c.files[f].module, name)
    if o < 0 {
      o = r.scope_get(r.c.prelude, name)
    }
  } else if path.len() == 2 {
    if let Some(im) = r.c.files[f].imports.get(path[0].name) {
      o = r.scope_get(im.module, name)
    }
  }
  if o >= 0 && r.c.objs[o].kind == check.ObjKind.Type {
    return r.type_target(o)
  }
  var kind = kind0
  if kind.is_empty() && is_upper(name) {
    kind = "type"
  }
  LspTarget{kind: kind}
}

pub fn (var r: Res) type_or_import(f: Int, path: List[parser.Ident], i: Int) -> LspTarget {
  if i == 0 {
    let t = r.import_name(f, path[0])
    if !t.kind.is_empty() {
      return t
    }
  }
  r.type_name(f, path[0..i + 1], "")
}

/// importName.
pub fn (r: Res) import_name(f: Int, id: parser.Ident) -> LspTarget {
  let im = match r.c.files[f].imports.get(id.name) {
    Some(x) => x
    None => return LspTarget{}
  }
  var t = LspTarget{kind: "namespace", label: "use ${check.text(im.path)}"}
  if im.module >= 0 {
    t.obj = "m${im.module}"
    t.what = "module"
    t.oi = im.module
    if r.c.mods[im.module].is_std {
      t.mods = t.mods | MOD_DEFAULT_LIBRARY
    }
  }
  if im.span.end.offset > 0 {
    t = with_def(t, r.c.files[f].path, im.span)
  }
  t
}

/// resolve: what the identifier at site of file f names.
pub fn (var r: Res) resolve(f: Int, site: IdentSite) -> LspTarget {
  let id = site.id
  let path = r.c.files[f].path
  let decl = fn(t: LspTarget) -> LspTarget { with_def(t, path, id.span) }
  let v = if site.no_var { -1 } else { r.c.var_of(f, id) }
  if v >= 0 {
    return r.var_target(v, id, path)
  }
  let module = r.c.files[f].module
  match site.ctx {
    FnDecl(fo, method) => {
      if site.field == "Name" {
        var t = decl(LspTarget{kind: if method { "method" } else { "function" }, mods: MOD_DECLARATION})
        if fo >= 0 {
          t.obj = "o${fo}"
          t.what = "func"
          t.oi = fo
        }
        return t
      }
    }
    Receiver(fo) => {
      if fo >= 0 {
        let rv = r.c.recv_var.get(fo) ?? -1
        if rv >= 0 {
          return r.var_target(rv, id, path)
        }
      }
      return decl(LspTarget{kind: "parameter", mods: MOD_DECLARATION})
    }
    Param(vars) => {
      if site.field == "Name" {
        for pv in vars {
          if pv >= 0 && r.c.objs[pv].name == id.name {
            return r.var_target(pv, id, path)
          }
        }
        return decl(LspTarget{kind: "parameter", mods: MOD_DECLARATION})
      }
    }
    TypeDecl => {
      if site.field == "Name" {
        let to = r.scope_get(module, id.name)
        if to >= 0 && r.c.objs[to].kind == check.ObjKind.Type {
          var t = r.type_target(to)
          t.mods = t.mods | MOD_DECLARATION
          return decl(t)
        }
        return decl(LspTarget{kind: "type", mods: MOD_DECLARATION})
      }
      if site.field == "Derive" {
        return r.type_name(f, [id], "interface")
      }
    }
    TypeParam => {
      if site.field == "Name" {
        return decl(LspTarget{kind: "typeParameter", mods: MOD_DECLARATION, label: check.text(id.name)})
      }
    }
    Field(name) => {
      let to = r.scope_get(module, name)
      if to >= 0 && r.c.objs[to].kind == check.ObjKind.Type {
        if let Some(t) = r.field_target(to, id.name, MOD_DECLARATION) {
          return decl(t)
        }
      }
      return decl(LspTarget{kind: "property", mods: MOD_DECLARATION})
    }
    Variant(name) => {
      let to = r.scope_get(module, name)
      if to >= 0 && r.c.objs[to].kind == check.ObjKind.Type {
        for (i, vi) in r.c.objs[to].variants.indexed() {
          if vi.name == id.name {
            return decl(LspTarget{kind: "enumMember", mods: MOD_DECLARATION, obj: "v${to}.${i}", what: "variant", oi: to, sub: i})
          }
        }
      }
      return decl(LspTarget{kind: "enumMember", mods: MOD_DECLARATION})
    }
    VariantField => return decl(LspTarget{kind: "property", mods: MOD_DECLARATION})
    ConstDecl(co) => {
      if site.field == "Name" {
        var t = decl(LspTarget{kind: "variable", mods: MOD_DECLARATION | MOD_READONLY})
        if co >= 0 {
          t.obj = "o${co}"
          t.what = "const"
          t.oi = co
        }
        return t
      }
    }
    NamedType(p) => {
      if site.index == p.len() - 1 {
        return r.type_name(f, p, "")
      }
      return r.import_name(f, id)
    }
    UseDecl => return decl(LspTarget{kind: "namespace", mods: MOD_DECLARATION})
    Selector(x, call) => {
      if site.field == "Sel" {
        return r.selector(f, x, call)
      }
    }
    FieldInit(g) => {
      if site.field == "Name" {
        for e in g {
          // a struct literal's own type name first: the literal's type
          // can be an interface it is converted to (`List[Area]`'s
          // `Rect{w: 2}`)
          var to = -1
          if let StructLit(typ: te, ..) = e {
            to = r.lit_type_obj(f, te)
          }
          if to < 0 {
            to = r.named_obj(r.c.type_in(f, e))
          }
          if to >= 0 {
            if let Some(t) = r.field_target(to, id.name, 0) {
              return t
            }
          }
        }
        return LspTarget{kind: "property"}
      }
    }
    Arg => {
      if site.field == "Name" {
        return LspTarget{kind: "parameter"}
      }
    }
    PatField => {
      if site.field == "Name" {
        return LspTarget{kind: "property"}
      }
    }
    VariantPat(p, vpath) => {
      if site.index == vpath.len() - 1 {
        if let Some(vr) = r.c.pat_variant_in(f, p) {
          return r.variant_target(vr.en, vr.variant)
        }
        let nt = r.c.pat_newtype_in(f, p)
        if nt >= 0 {
          return r.type_target(nt)
        }
      }
      return r.type_or_import(f, vpath, site.index)
    }
    StructPat(spath) => {
      if site.index == spath.len() - 1 {
        return r.type_name(f, spath, "")
      }
      return r.type_or_import(f, spath, site.index)
    }
    Label => {
      if site.field is "Label" | "Name" | "Sub" {
        return LspTarget{}
      }
    }
    Other | CallFun(_) | SelX => {}
  }
  // an identifier in expression position
  let o = r.c.ref_of(f, id)
  if o >= 0 {
    return r.obj_target(o)
  }
  if let Some(vr) = r.c.ctor_in(f, Expr.Ident(id: id)) {
    return r.variant_target(vr.en, vr.variant)
  }
  match site.ctx {
    CallFun(call) => {
      if let Some(ci) = r.c.call_in(f, call) {
        if ci.fn_obj >= 0 {
          return r.obj_target(ci.fn_obj)
        }
      }
      let tc = r.c.type_call_in(f, call)
      if tc >= 0 {
        return r.type_target(tc)
      }
    }
    SelX => {
      let t = r.import_name(f, id)
      if !t.kind.is_empty() {
        return t
      }
    }
    _ => {}
  }
  if is_upper(id.name) {
    let t = r.type_name(f, [id], "")
    if !t.kind.is_empty() {
      return t
    }
  }
  let co = r.scope_get(module, id.name)
  if co >= 0 && r.c.objs[co].kind == check.ObjKind.Const {
    return r.obj_target(co)
  }
  LspTarget{}
}

/// selector: the Sel of x, the callee of call when call holds one.
pub fn (var r: Res) selector(f: Int, x: Expr, call: List[Expr]) -> LspTarget {
  let (xx, sel) = match x {
    SelectorExpr(_, a, b) => (a, b)
    _ => return LspTarget{kind: "property"}
  }
  let o = r.c.ref_of(f, sel)
  if o >= 0 {
    return r.obj_target(o)
  }
  if let Some(vr) = r.c.ctor_in(f, x) {
    return r.variant_target(vr.en, vr.variant)
  }
  for cl in call {
    if let Some(ci) = r.c.call_in(f, cl) {
      if ci.fn_obj >= 0 {
        return r.obj_target(ci.fn_obj)
      }
    }
    let tc = r.c.type_call_in(f, cl)
    if tc >= 0 {
      return r.type_target(tc)
    }
    return LspTarget{kind: "method"}
  }
  if let Ident(xid) = xx {
    if r.c.var_of(f, xid) < 0 {
      if let Some(im) = r.c.files[f].imports.get(xid.name) {
        if im.module >= 0 {
          let mo = r.scope_get(im.module, sel.name)
          if mo >= 0 {
            return r.obj_target(mo)
          }
        }
      }
    }
  }
  let to = r.named_obj(r.c.type_in(f, xx))
  if to >= 0 {
    if let Some(t) = r.field_target(to, sel.name, 0) {
      return t
    }
    if let Some(m) = r.c.objs[to].methods.get(sel.name) {
      return r.obj_target(m)
    }
  }
  LspTarget{kind: "property"}
}
