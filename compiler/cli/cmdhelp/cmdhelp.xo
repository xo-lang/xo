// The help of the `xo` command line: the command list `xo help` prints
// and each command's usage, which `xo <command> -h` prints on standard
// output (exit 0) and a usage error (an unknown flag, a missing
// argument) prints on standard error (exit 2). Every package of the
// command line (compiler/cli/*, compiler/xo) takes its usage from here,
// so the texts are the same whichever package parses the flags. The
// texts follow cmd/xo's usage (the Go reference) and spec/core.md 10.1;
// internal flags (xo1's --std, --wd, --cc, --asm, --go-tree,
// --phase-times) and hidden commands stay out of them.

/// One user command: its name and the one line purpose of `xo help`.
pub struct Command {
  pub name: Str
  pub purpose: Str
}

/// The user commands in the order `xo help` lists them.
pub fn commands() -> List[Command] {
  [
    Command{name: "build", purpose: "compile to static binaries (the host, or --targets)"},
    Command{name: "run", purpose: "build for the host and run"},
    Command{name: "test", purpose: "run test blocks, property tests, and contract fuzzing"},
    Command{name: "check", purpose: "parse and type check the modules under each directory"},
    Command{name: "parse", purpose: "parse .xo files and report syntax diagnostics"},
    Command{name: "fmt", purpose: "rewrite .xo files in the one canonical layout"},
    Command{name: "fix", purpose: "apply the machine fixes of check diagnostics"},
    Command{name: "vet", purpose: "advisory checks (never errors)"},
    Command{name: "query", purpose: "semantic queries: type, def, callers, effects, holes, api, ..."},
    Command{name: "edit", purpose: "semantic edits: rename, add-field, change-sig"},
    Command{name: "doc", purpose: "Markdown documentation from doc comments"},
    Command{name: "def", purpose: "where a name is declared, as code writes it"},
    Command{name: "refs", purpose: "every reference to a name"},
    Command{name: "type", purpose: "the type and declaration at FILE:LINE:COL"},
    Command{name: "symbols", purpose: "a directory's, file's, or module's declarations"},
    Command{name: "explain", purpose: "long form explanation of a diagnostic code"},
    Command{name: "init", purpose: "write xo.mod for a new module"},
    Command{name: "get", purpose: "require, upgrade, or remove a module"},
    Command{name: "mod", purpose: "tidy, accept-effects, clean, proxy serve"},
    Command{name: "vendor", purpose: "copy every selected module version into vendor/"},
    Command{name: "publish", purpose: "check a release against the previous version tag"},
    Command{name: "audit", purpose: "supply chain report of the dependencies"},
    Command{name: "bind", purpose: "bind Go packages (use go) or C headers (use c)"},
    Command{name: "dump", purpose: "print the task tree of a running Xo program"},
    Command{name: "replay", purpose: "rerun a recorded trace or crash bundle offline"},
    Command{name: "prof", purpose: "pprof files and summaries of a native program's profile"},
    Command{name: "trace", purpose: "Perfetto JSON and a summary of a native execution trace"},
    Command{name: "bench", purpose: "interleaved A/B measurement with a confidence interval (--ab)"},
    Command{name: "clean", purpose: "remove xo's caches under the user cache directory (-cache)"},
    Command{name: "lsp", purpose: "Language Server Protocol server on stdin/stdout"},
    Command{name: "mcp", purpose: "Model Context Protocol server on stdin/stdout"},
    Command{name: "serve", purpose: "keep checked programs in memory for check and query"},
    Command{name: "version", purpose: "print the toolchain version and the host target"},
  ]
}

/// Whether name is a user command (help included).
pub fn is_command(name: Str) -> Bool {
  if name == "help" {
    return true
  }
  for c in commands() {
    if c.name == name {
      return true
    }
  }
  false
}

/// The text of `xo help` (and, on standard error, of `xo` alone).
pub fn top() -> Str {
  var b = StrBuilder.new()
  b.write("usage: xo <command> [arguments]\n\ncommands:\n")
  for c in commands() {
    var name = c.name
    while name.len() < 9 {
      name = name + " "
    }
    b.write("  ${name} ${c.purpose}\n")
  }
  b.write("\n")
  b.write("Run \"xo <command> -h\" for a command's usage and flags.\n")
  b.write("A command that takes directories also takes DIR/... (xo check ./...).\n")
  b.write("Every command accepts --offline (XO_OFFLINE=1: never fetch; a missing\n")
  b.write("module is XO1303) and --workspace=off (XO_WORK=off: ignore xo.work).\n")
  b.freeze()
}

/// The usage of one command ("" for no such command), ending in a
/// newline.
pub fn usage(name: Str) -> Str {
  let t = match name {
    "build" => build_text()
    "run" => run_text()
    "test" => test_text()
    "check" => check_text()
    "parse" => parse_text()
    "fmt" => fmt_text()
    "fix" => fix_text()
    "vet" => vet_text()
    "query" => query_text()
    "edit" => edit_text()
    "doc" => doc_text()
    "def" => def_text()
    "refs" => refs_text()
    "type" => type_text()
    "symbols" => symbols_text()
    "explain" => explain_text()
    "init" => init_text()
    "get" => get_text()
    "mod" => mod_text()
    "vendor" => vendor_text()
    "publish" => publish_text()
    "audit" => audit_text()
    "bind" => bind_text()
    "dump" => dump_text()
    "replay" => replay_text()
    "prof" => prof_text()
    "trace" => trace_text()
    "bench" => bench_text()
    "clean" => clean_text()
    "lsp" => lsp_text()
    "mcp" => mcp_text()
    "serve" => serve_text()
    "version" => version_text()
    "help" => "usage: xo help\n\nList the commands."
    _ => ""
  }
  if t.is_empty() {
    return ""
  }
  let u = if t.ends_with("\n") { t } else { t + "\n" }
  if takes_dirs(name) && name != "run" {
    return u + "\n" + PATTERN_NOTE
  }
  u
}

/// The usage of the command a flag set is named for: its first word
/// ("mod tidy" is mod's), "" when that is no user command.
pub fn usage_of(flag_set: Str) -> Str {
  let words = flag_set.split(" ")
  if words.is_empty() { "" } else { usage(words[0]) }
}

/// Whether arg asks for help, as Go's flag package takes it.
pub fn is_help_flag(arg: Str) -> Bool {
  arg is "-h" | "--h" | "-help" | "--help"
}

/// The note on DIR/... of the commands that take directories.
const PATTERN_NOTE = "A directory means that directory alone; DIR/... covers the directories\nbelow it too, up to 6,000 .xo files or 60,000 entries (decision 0345).\nA DIR/... with no .xo file at or below DIR is an error.\n"

/// Whether the command cmd takes directories, and so the pattern D/...
/// (decision 0210).
pub fn takes_dirs(cmd: Str) -> Bool {
  cmd is "build" | "run" | "test" | "check" | "parse" | "fmt" | "fix" | "vet" | "doc" | "audit"
}

/// Whether arg is a package pattern in the go command's form: `D/...`
/// or any other argument with `...` in it (decision 0210).
pub fn is_pattern(arg: Str) -> Bool {
  arg.contains("...")
}

/// The directory D of the pattern D/... ("./..." is ".", "/..." is "/"),
/// or "" for a pattern of another form (`...` alone, `a/.../b`, `a...`),
/// which xo does not take.
pub fn pattern_dir(arg: Str) -> Str {
  if !arg.ends_with("/...") {
    return ""
  }
  let d = arg.trim_suffix("/...")
  if d.contains("...") {
    return ""
  }
  if d.is_empty() { "/" } else { d }
}

/// The usage error for a pattern xo does not take.
pub fn pattern_error(cmd: Str, arg: Str) -> Str {
  "xo ${cmd}: ${arg}: only the pattern DIR/... is supported (for example xo ${cmd} ./...), where DIR/... is every directory at or below DIR"
}

/// The error for a pattern D/... that matches no directory with .xo
/// files.
pub fn no_match_error(cmd: Str, arg: Str) -> Str {
  "xo ${cmd}: ${arg} matched no directory with .xo files"
}

fn clean_text() -> Str {
  """
usage: xo clean -cache [-n]

-cache removes every cache xo and its tests keep under the user cache
directory (<user cache>/xo: build directories, the native back end's
cache, the Go backend's GOCACHE, test binaries, watch builds, xo dev
outputs, checkout builds, the Go tests' caches) and prints the bytes
freed per cache. -n prints what it would remove, and its size, and
removes nothing. Nothing outside <user cache>/xo is touched: not
$XO_BUILD_DIR or another directory a variable names, not a project. The
module cache (xo mod clean) and the prebuilt seeds stay. Each cache's
own stamp and lock files stay, and an entry whose build lock a running
process holds is skipped. A build running at the same time can fail
with a missing file: run it again.
"""
}

fn build_text() -> Str {
  """
usage: xo build [--targets=all|os/arch,...] [--backend=go|llvm|arm64|amd64|wasm] [--no-gc]
                [--no-mono] [--no-arenas] [--tzdata=embedded|system] [--ci]
                [--release] [--debug-contracts=on|off] [--dbg=on|off]
                [--error-args=on|off] [--debug-info=on|off|split]
                [--profile-support=on|off] [--trace-support=on|off] [--opt=O0..O3]
                [--trimpath=on|off] [-s] [--dsym] [--ld=macho|cc] [--race]
                [--stamp NAME=VALUE]... [--hybrid] [--pack-lists=on|off]
                [--inline-str] [--json] [-o out] <dirs...>

Compile to static binaries (default: the host). The directories are one
program. The default backend is native (decisions 0248 and 0270): arm64
or amd64 for the target's architecture, --race too where a
ThreadSanitizer runtime ships for the target (else llvm, which needs
clang). With no --backend, --targets=all builds each of linux/amd64,
linux/arm64, darwin/amd64, darwin/arm64, windows/amd64 and wasip1/wasm
with its own native backend, as NAME-OS-ARCH (.exe, .wasm) in -o's
directory; windows/arm64 needs --backend=go, whose --targets=all builds
all seven; -o NAME for windows writes NAME.exe. --backend=go builds through
the Go toolchain, and a program with `use go` needs it. A linux/arm64
target links with Xo's own linker, from any host (decision 0243).
--no-gc (also on run and test) reports every construct, std API, or
effect the native backends do not support as XO1201 before code
generation (decision 0083). --backend=wasm builds a WASI preview1 module.
Request scoped arenas for HTTP handlers are on by default (decision
0066); --no-arenas (also on run and test) turns them off. --ci fails
before building when a .xo file is not formatted (core 10.5) or dbg(...)
is left in code (core 11.4). --release is a preset (decision 0354):
it turns off --debug-contracts (requires(debug) and ensures(debug)
compiled out), --dbg (dbg(x) is x), --debug-info, --profile-support (the
runtime's XO_PROF) and --trace-support (XO_TRACE's recorder), and sets
--opt=O2; each setting can be given either way in any build, and an
explicit flag wins over the preset (a bare flag means on; on|off and
true|false both work). --error-args=off drops parameter values from
error frames. --opt applies to the LLVM backend (a usage error on arm64
and amd64; the Go backend ignores it). --trimpath (on) records the DWARF compile and std directories
relative to the working directory, so a binary carries no path of the machine
that built it (a debugger started in that directory finds the sources);
--trimpath=off keeps absolute paths. --debug-info=split keeps the
DWARF beside the program: NAME.dSYM on darwin, NAME.debug (found by
build id and .gnu_debuglink) on linux (decision 0355). Native builds carry DWARF line tables
(in a darwin binary's __DWARF segment, a link through cc's too; --dsym
also writes NAME.dSYM); -s leaves them and the local symbols out.
--ld picks the native
linker: macho (Xo's own; the default on darwin/arm64) or cc. --race (also
on run and test) builds with ThreadSanitizer on the LLVM backend. --stamp (repeatable, also on run)
sets a `const NAME: Str` of the main module for this build (XO1501
otherwise). std/time zone data is embedded per use (decision 0094);
--tzdata=system (also on run and test) reads the host's database
instead. --hybrid is deprecated: a plain Go backend build with a
warning (decision 0084). --pack-lists (on by default, decision 0369)
stores a List of a sized integer type in its elements' width on the
arm64 and LLVM backends; --pack-lists=off keeps a word an element.
--inline-str (experimental, off by default, decision 0370) keeps a Str
of up to 11 bytes in its two words; it works on the native arm64
backend only, and elsewhere warns that it has no effect.
"""
}

fn run_text() -> Str {
  """
usage: xo run [--seed=N] [--record=trace.xotrace] [--holes] [--backend=go|llvm|arm64|amd64]
              [--no-gc] [--no-mono] [--no-arenas] [--tzdata=embedded|system]
              [--profile=cpu|heap|cpu,heap] [--trace=FILE] [--race]
              [--stamp NAME=VALUE]... [--watch [--grace=D]] [dir] [-- args...]

Build for the host and run the program in dir (default .) with args.
xo run runs exactly that directory and never one below it (decision
0345): a dir with no .xo file or no main is an error.
--seed makes task interleavings reproducible: one thread runs the
tasks and a generator seeded with N picks the next at each scheduling
point (decision 0350). --record writes every
effect (clock, rand, env, stdin, fs, net, http client responses, server
requests, signals) and every scheduling decision into the trace (core
11.3) for xo replay. --holes allows holes (???), which fault when
evaluated. --record needs the Go backend. --profile=cpu
samples the program's CPU time (a native backend, the host's by default)
into xo-cpu.pprof (go tool pprof reads it) and a text summary,
xo-cpu.txt, in the working directory; --profile=heap samples its
allocations into xo-heap.pprof and xo-heap.txt; cpu,heap takes both. A
profile file that exists is not overwritten. --trace=FILE records the
scheduler's execution trace (XO_TRACE, a native backend; decision 0240)
into FILE, then writes FILE.json for ui.perfetto.dev and prints a summary
(xo trace). --watch rebuilds after a change to the module's sources and
restarts the program only when the built binary changed (an edit to a
test or a comment does not restart it): SIGTERM, up to --grace (5s) for
it to exit, then SIGKILL; a failed build keeps the old program running.
With --json each cycle is a JSON line, the last also in
last.json in the watch's cache directory, <user cache>/xo/watch/HASH
(decision 0267); the watch writes nothing into the project.
"""
}

fn test_text() -> Str {
  """
usage: xo test [--seed=N] [--explore=N] [--run=text] [--race] [--real] [--cases=N]
               [--timeout=D] [--json] [-v] [--backend=go|llvm|arm64|amd64] [--no-gc]
               [--profile=cpu|heap|cpu,heap] [--trace=FILE] [--watch] [--fail-empty] <dirs...>

Run test blocks, property tests, and contract fuzzing on the
deterministic scheduler. --run selects the tests whose name contains
text; --cases sets the cases per property test and fuzzed function
(default 100); --explore=N runs each test under N schedules; --real
gives tests real capabilities for their declared effects; --timeout
is the real time each test (each property case) may take, 60s by
default, 0 for no limit: a test past it fails and, natively, its
process is killed. Shrunk contract failures are written to the
module's regressions_test.xo. --profile=cpu (heap, cpu,heap) samples
each test process (not property cases) into xo-cpu-<pid>.pprof
(xo-heap-<pid>.pprof) and .txt in the working directory; go tool pprof
merges several. --trace=FILE writes an execution trace per test process
(FILE.<pid>, or FILE with %p); read one with xo trace. --watch runs
the tests, then after each change to the sources only the tests it
reaches (a new or edited test, the tests of a changed _test.xo file,
and the tests that name a function whose definition, or one it uses,
changed); typing a and Enter runs them all. With --json each cycle is
a JSON line, the last also in last.json under <user cache>/xo/watch
(decision 0267). A run of no tests says so on standard error ("xo
test: no tests in ..."); with --fail-empty it also fails (exit 1).
"""
}

fn check_text() -> Str {
  """
usage: xo check [--json] [--backend=go] [--support] [--fix] [--wip] [--dir=DIR] <dirs...>

Resolve names and type check the modules under each directory (every
directory holding .xo files is a module; imports are resolved through
xo.mod and the embedded std) by the rules of the backend a build uses:
the native backends' by default, so `use c` is valid; --backend=go checks
by the Go backend's. --json prints {"modules": [...], "diagnostics":
[...]} on stdout. --support (old name --no-gc) also runs the native
backends' support check, which lowers the program (XO1201 for what they
cannot build yet, or ever; decision 0083).
--fix first applies every unambiguous machine fix (as xo fix) and
reformats the changed files, then reports what remains (decision 0096).
--wip reports the errors of code still being written, an unused binding
or import (XO0110) and an unused computed value (XO0209), as warnings,
so a check passes mid edit; a normal check and every build keep them
errors (decision 0293).
--dir=DIR checks DIR as def, refs, and doc take it (the same as giving it
as an argument; both together check both).
Exit status is 1 when any error is reported (warnings such as holes do
not count), 2 on usage errors.
"""
}

fn parse_text() -> Str {
  """
usage: xo parse [--json] [--ast] [--sig] <files or dirs...>

Parse .xo files and report syntax diagnostics. Directories are walked
recursively. --json prints {"files": [...], "diagnostics": [...]} on
stdout; --ast includes each file's syntax tree; --sig allows function
declarations without bodies (signature listings). Exit status is 1 when
any error is reported, 2 on usage errors.
"""
}

fn fmt_text() -> Str {
  """
usage: xo fmt [--check] [--json] [files or dirs...]

Rewrite .xo files in the one canonical layout (core 10.5; no options)
and print the names of the files changed. --check changes nothing, lists
the unformatted files, and exits 1 if there are any. Files with syntax
errors are reported and left alone (exit 1). Default: .
"""
}

fn fix_text() -> Str {
  """
usage: xo fix [--dry-run] [--json] [--from=draft-0.N] [--edition=preview] [dirs...]

Apply the machine fixes of check diagnostics, round after round, until
none apply, then reformat the changed files and print what changed.
--from runs the migration rewriters for every breaking change after that
draft first. An xo.mod line edition 2026 becomes edition preview
(XO1315; the only edition before 1.0, --edition=preview names it).
--dry-run writes nothing. Exit status 0 even when errors remain (they
are listed); 2 on usage errors. Default: .
"""
}

fn vet_text() -> Str {
  """
usage: xo vet [--json] [dirs or .xo files...]

Advisory checks (never errors, exit 0): the warnings of check, unused
declared effects (XO0703), x ?? [].f() precedence traps (XO0207), every
.ignore_err reason (XO0208), use go packages and functions that perform
go per module (XO1103), dbg(...) left in code (XO0901), tls.Verify.None
(XO0902). Default: .

A .xo file vets its directory and reports that file's findings. A
directory of std (std, std/native, std/native/llrt) or a file in one is
checked as std, its modules together.
"""
}

fn query_text() -> Str {
  """
usage: xo query <kind> [--json|--text] [--dir=<dir>] <argument>

kinds:
  type <file:line:col>     type of the innermost expression or binding there
  def <name>               declaration of name, Type.member, module.name, module.Type.member
  callers <module.fn>      calls of the function and uses of it as a value
  effects <module.fn>      effects the function performs, with the call chain per effect
  holes                    holes (???) with their expected types
  api <module path>        exported surface of a module (import path or directory)
  imports <package>        the package's use lines, with any deny rule that forbids one
  deps <package>           imports, transitively (std and Go packages are not followed)
  hash <name>              content hash of a definition of the module (name, Type.method,
                           pkg.name, or <package path>.name): local names erased,
                           referenced definitions by their hashes (core 4.3)

--dir (default .; for type, the file's directory) is the directory
checked; a workspace or repository root checks the modules under it. A name
is resolved in any form code writes it (decision 0289): name, Type.member,
module.name, module.Type.member, an import's local name, main.name, a module
path, a prelude method (Str.find), or a std or runtime module the program
does not import (tls.client, pool.park_wait). Flags may come anywhere. JSON
is the default when stdout is not a terminal.
"""
}

fn edit_text() -> Str {
  """
usage: xo edit [--dry-run] [--dir=<dir>] <op> <args...>

Semantic edits (core 10.4) through the checker's resolved symbols:
  rename <name> <new name>           function, method, constant, type,
                                     field or variant (Type.member), or
                                     interface method (Iface.m, with every
                                     type's method that implements it)
  add-field <Struct> <name: Type = default>
  change-sig <fn> "(params) -> Result ! Err"
Every reference is rewritten at once, and the edit is rejected (nothing
written, exit 1) unless the program checks clean before and after it;
the JSON summary lists the files, the diagnostics, or the call sites
that blocked it, and with --dry-run a diff of the changes. A renamed
field of a struct that derives Json or SqlRow keeps its key on the wire
(`new as "old"`); a variant of an enum that derives Json is not renamed.
Default dir: .
"""
}

fn doc_text() -> Str {
  """
usage: xo doc [--json] [--all] [--dir=<dir>] [module dir or import path]
       xo doc [--dir=DIR] [--json] NAME

Markdown documentation from doc comments and signatures, with the
example code blocks of each doc comment. --all includes declarations
that are not pub. Default: the modules under .

With a NAME that is not a directory or an import path (`Map`,
`std/tls.client`), the declaration's doc comment and, for a type, its
methods, as xo def finds it: the declaration with its whole doc, then
a method a line (its signature and the first line of its doc).
"""
}

/// The program the name lookups check (def, refs, symbols, doc NAME).
const LOOKUP_DIR = """
--dir=DIR checks the program in DIR (default .; a workspace or
repository root checks the modules under it).
"""

/// The output and exit status of the lookups (decisions 0289, 0386).
const LOOKUP_OUT = """
Output is compact text, a record a line, so grep and head cut it
(decision 0386); --json is the same answer as JSON, broken over lines
with a flat record (a reference, a symbol) on one line. Exit status: 0
with an answer, 1 for no match, 2 for a usage error.
"""

fn def_text() -> Str {
  """
usage: xo def [--dir=DIR] [--json] NAME

Where NAME is declared, with its signature and doc comment. NAME is
written as code writes it: `greet`, `Counter.next`, `Str.find`,
`check.Checker.check_dirs`, `std/tls.client`; std and runtime modules
load when a name refers to them (decision 0289). Text: the place, the
doc comment's first line, the signature (xo doc NAME has the whole
doc and the methods).
""" + "\n\n" + LOOKUP_DIR + "\n" + LOOKUP_OUT
}

fn refs_text() -> Str {
  """
usage: xo refs [--dir=DIR] [--testdata] [--limit=N] [--json] NAME [NAME...]

Every reference to NAME in the program, the declaration marked, NAME
written as for xo def. A root's check leaves out its `testdata`
directories, as every DIR/... walk does (the answer names them, JSON
"testdata_skipped"); --testdata checks the modules under them too (the
program goldens of internal/*/testdata). Several names are answered
from one check (JSON {"results": [...]}, one answer or {"target",
"error"} each, in order; exit 1 when one has no answer). Text: the
declaration's line, then `file:line:col  context` per reference (the
source line, trimmed). --limit=N shows the first N references and
says how many there are (JSON "total").
""" + "\n\n" + LOOKUP_DIR + "\n" + LOOKUP_OUT
}

fn type_text() -> Str {
  """
usage: xo type [--json] FILE:LINE:COL

The type of the expression at a position (1 based line and column) and
the declaration it refers to; FILE's directory is the program checked.
""" + "\n\n" + LOOKUP_OUT
}

fn symbols_text() -> Str {
  """
usage: xo symbols [--dir=DIR] [--pub] [--doc] [--limit=N] [--json] [DIR | FILE.xo | NAME]
       xo symbols --file=FILE.xo | --module=PATH [--pub] [--doc] [NAME]

The declarations of one directory's own files, private ones too; --pub
lists the exported surface only. At a root with no .xo files of its
own, the directories below that have them are named. --file (or a .xo
argument) lists one file's; --module one module's by its import path,
std and runtime ones too (std/json, native/llrt/pool). A NAME that is
not a directory keeps the declarations whose name contains it, or
matches it with `*` for any run (`check_*`). Text: `kind name
file:line  signature` a line (a signature's first line); --doc adds
each doc comment. --limit=N shows the first N and says how many there
are (JSON "total").
""" + "\n\n" + LOOKUP_OUT
}

fn explain_text() -> Str {
  """
usage: xo explain [--json] <code>

Long form explanation of a diagnostic code (for example XO0201), with
an example and a fix.
"""
}

fn init_text() -> Str {
  """
usage: xo init [--dir=<dir>] <module path>

Write xo.mod for a new module and add xo.work (unless a workspace above
already covers the directory) and .xo/, xo's binding caches, to
.gitignore.
"""
}

fn get_text() -> Str {
  """
usage: xo get [--dir=<dir>] [--json] [-u] [--accept-effects] <module path>[@version|@latest|@none]...

Require a module (decision 0086): the latest vX.Y.Z tag unless a
version is given; @none removes the requirement; -u alone upgrades
every requirement. Fetches with git into the module cache ($XO_MODCACHE
or <user cache dir>/xo/mod), resolves the graph by minimal version
selection, rewrites xo.mod and xo.lock, and prints the API and effect
changes of every version change. --accept-effects records the new
version's effects in xo.lock even when they are wider than the locked
ones (else XO1317, nothing written).
"""
}

fn mod_text() -> Str {
  """
usage: xo mod tidy [--dir=<dir>] [--json]
       xo mod accept-effects [--dir=<dir>] [--json] [<module path>...]
       xo mod clean
       xo mod proxy serve [--addr=127.0.0.1:7070] [--fetch] [<cache dir>]

tidy requires every imported module, drops requirements nothing imports,
and rewrites xo.lock with exactly the hashes the build uses.
accept-effects records the current effects of the named modules (all
when none is named) in xo.lock (decision 0156). clean removes the module
cache. proxy serve serves a module cache read only over the module proxy
protocol (decision 0126); --fetch fills it from git on a miss.
"""
}

fn vendor_text() -> Str {
  """
usage: xo vendor [--dir=<dir>] [--json]

Copy every selected module version into vendor/ with
vendor/modules.txt; builds then use vendor/ only (no cache, no network),
verified against xo.lock.
"""
}

fn publish_text() -> Str {
  """
usage: xo publish [--dir=<dir>] [--check] [--version=vX.Y.Z] [--json]

Compare the exports and effects with the previous vX.Y.Z tag and reject
a minor or patch release that removes or changes an export or adds an
effect to one (XO1310). Without --check it also needs a clean working
tree and a module that checks without a workspace, then prints the git
tag command to run; it never tags or pushes.
"""
}

fn audit_text() -> Str {
  """
usage: xo audit [--dir=<dir>] [--json] [--no-gc] [<dir>]

Supply chain report (decision 0156): per dependency its version, the
effects its API may reach, its xo.lock effects line, its effect ceiling,
and its escape hatches (use c, use go of an impure package) with the
vouch that covers each; this module's attenuations and the capabilities
it passes into dependencies; and the check's diagnostics. JSON when
--json or stdout is not a terminal. Exit 1 when the check has errors.
--no-gc checks as a native build (use c).
"""
}

fn bind_text() -> Str {
  """
usage: xo bind [--dir=<project dir>] [--json] <go import paths...>
       xo bind --c [--dir=<module dir>] [--link=<lib>]... [--uses=none|<effects>] [--json] <headers...>

Bind Go packages for use go "<path>" (decision 0041), or with --c C
headers for use c "<header>" on native builds (decision 0116): write
the Xo declaration file and the adapter into the binding cache and print
how much mapped. check, build, and test bind missing packages on their
own.
"""
}

fn dump_text() -> Str {
  """
usage: xo dump [--timeout=5s] <pid>

Print the task tree of a running Xo program (core 11.4): sends it
SIGQUIT and prints the dump it writes to $XO_DUMP_DIR or the system
temporary directory (xo-dump-<pid>.txt). The program goes on running.
"""
}

fn replay_text() -> Str {
  """
usage: xo replay [--dir=<module dir>] <trace.xotrace | crash.xocrash>

Rebuild the recorded program and rerun it offline with every effect
result and interleaving taken from the trace: same output, same fault.
A divergence is reported with both locations, exit status 3. Secrets
are redacted in traces; a replay takes them from the environment.
"""
}

fn lsp_text() -> Str {
  """
usage: xo lsp

Language Server Protocol server on stdin/stdout (LSP 3.17) for editors:
diagnostics with quick fixes, hover, definition, references, rename,
document symbols, semantic tokens, and formatting.
"""
}

fn mcp_text() -> Str {
  """
usage: xo mcp

Model Context Protocol server on stdin/stdout (JSON-RPC 2.0, one message
per line) with the tools check, query, edit, explain, fmt, test, and
build, each returning compact JSON.
"""
}

fn serve_text() -> Str {
  """
usage: xo serve [--socket=path] [stop|status]

Keep checked programs in memory and answer xo check and xo query over a
unix socket (default $XO_SERVE_SOCKET or <user cache dir>/xo/serve.sock).
check and query use a running server automatically; XO_NO_SERVE=1 turns
that off. stop shuts the server down; status prints its cache counters.
"""
}

fn version_text() -> Str {
  """
usage: xo version [--json | -v]
       xo version -m [--json] BINARY...

Print the toolchain version and the host target. --json and -v add
what the binary was built from: the commit, whether the tree had
uncommitted changes (and a hash of them), the source key, and the xo
that built it (decision 0264). -m prints the build information a
program built by xo carries, on every backend (decision 0354): the xo,
backend and target, its ID and directory, every effective setting
(debug contracts, dbg, error args, debug info, profiler and trace
support, the LLVM level), the stamps, and its sources' hashes; --json
prints it as recorded.
"""
}

fn bench_text() -> Str {
  """
usage: xo bench --ab [flags] A [B] [-- ARGS...]

Run program A and program B (B defaults to A) in interleaved rounds and
report, per metric, each side's median and spread, the ratio B/A with a
95% bootstrap interval, and a verdict: better, worse, or within noise
(decision 0340). One build under two settings:
`xo bench --ab ./srv --env-b XO_THREADS=1`.

Metrics: wall_ms, cpu_ms (user plus system, children included),
cpu_us_per_op, instructions (macOS), max_rss_kb, and every number on the
last JSON line the program prints (rps, ops, ...; names with rps, mbps,
per_sec or throughput are higher is better).

  --rounds=N         rounds measured (10); --warmup=N discarded first (1)
  --env-a=K=V        environment for A (repeatable); --env-b=K=V for B
  --args-a=WORDS     arguments for A only; --args-b=WORDS for B; after --
                     they go to both
  --max-load=X       before each run wait until the 1 minute load is under X
  --guard=CMD        before each run wait until `sh -c CMD` exits 0
  --load-wait=D      longest wait (10m), then the round runs marked loaded
  --no-guard         do not wait for the quiet window file
  --ops=N            operations per run, for cpu_us_per_op
  --metrics=a,b      only these metrics
  --keep-loaded      count loaded rounds in the statistics
  --allow-fail       a failed run drops its round instead of ending the run
  --timeout=D        longest run (10m)
  --alpha=P          interval level (0.05); --seed=N bootstrap seed (1)
  --json             one JSON object: parameters, rounds, loads, metrics

Runs wait while the quiet window file (XO_QUIET_FILE, default
~/xo-lead/quiet) holds a future time. The processes run under
/usr/bin/time; on Windows, which has none, they run alone and only wall_ms
is measured. Exit 0 whatever the verdict, 1 on a failed run, 2 on usage.
"""
}

fn prof_text() -> Str {
  """
usage: xo prof FILE|URL [--raw-out=PATH] [--cpu-out=PATH] [--heap-out=PATH]

Read the raw profile a native program wrote under XO_PROF (decision
0238; the file XO_PROF_OUT names, default xo-prof.xoraw; decision 0245)
and write what `go tool pprof` reads: the CPU profile as PATH (default
FILE's name with .cpu.pprof for its .xoraw, .pb.gz or .gz: cold.pb.gz
gives cold.cpu.pprof) with its text summary beside it (.txt: the top 30
by flat and by cumulative samples, each with its hottest line), the heap
profile as FILE's name with .heap.pprof and its .txt. The program named
its locations already, so neither the binary nor its dSYM is needed. The
default names are replaced on a rerun; a path given with --cpu-out or
--heap-out is never overwritten. xo run --profile and xo test --profile
run it for you.

A URL (http:// or https://) is a running server's std/debug endpoint
(decision 0325): xo prof http://HOST/debug/profile?seconds=30 or
http://HOST/debug/heap fetches the raw profile into xo-prof.xoraw (or
--raw-out=PATH; the default name is replaced on a rerun) and converts it
as above. A text answer, /debug/sched or /debug/threads, is printed.
"""
}

fn trace_text() -> Str {
  """
usage: xo trace FILE [--json OUT] [--text]

Read the raw execution trace a native program wrote under XO_TRACE=FILE
(or xo run --trace=FILE; decision 0240): Chrome trace event JSON for
ui.perfetto.dev or chrome://tracing (OUT, default FILE.json: a track per
worker with each task's runs and the wakes that caused them, and a track
per task with its runs and parks), and a summary on standard error: time
parked by reason (chan send and recv, select, mutex, join, sleep, net,
http), runnable latency, the top wakers, the longest parks, worker idle
time, deferred and late wakes. --text prints only the summary.
"""
}
