use std/testing

test "rusage reads macOS time -l" {
  let err = "        0.40 real         0.31 user         0.02 sys\n             8306688  maximum resident set size\n  25632703  instructions retired\n             4621817  cycles elapsed\n             1130736  peak memory footprint\n"
  let m = rusage("darwin", err)
  expect(m.get("cpu_ms") == Some(330.0))
  expect(m.get("max_rss_kb") == Some(8112.0))
  expect(m.get("instructions") == Some(25632703.0))
  expect(m.get("cycles") == Some(4621817.0))
}

test "ipc is higher is better, cycles lower" {
  expect(higher_better("ipc")) == true
  expect(higher_better("cycles_per_op")) == false
}

test "counters are n/a on Linux" {
  expect(counters_na("linux").contains("n/a")) == true
  expect(counters_na("windows").contains("Windows")) == true
  expect(usage_na().contains("not measured on Windows")) == true
}

test "rusage reads GNU time -v" {
  let err = "\tCommand being timed: \"x\"\n\tUser time (seconds): 0.25\n\tSystem time (seconds): 0.05\n\tMaximum resident set size (kbytes): 9000\n"
  let m = rusage("linux", err)
  expect(m.get("cpu_ms") == Some(300.0))
  expect(m.get("max_rss_kb") == Some(9000.0))
  expect(m.get("instructions") == None)
  expect(m.get("cycles") == None)
}

test "reported takes the numbers of the last JSON line" {
  let m = reported("log\n{\"ops\": 1, \"x\": 2}\nmore\n{\"requests\": 500, \"rps\":1.5e3, \"name\": \"a\", \"p99_us\": 20.5}\n")
  expect(m.get("requests") == Some(500.0))
  expect(m.get("rps") == Some(1500.0))
  expect(m.get("p99_us") == Some(20.5))
  expect(m.get("ops") == None)
  expect(m.get("name") == None)
}

test "options" {
  expect(parse_opts(["--ab", "a", "b"]).is_ok())
  expect(parse_opts(["a", "b"]).is_err())
  expect(parse_opts(["--ab", "a"]).is_err())
  expect(parse_opts(["--ab", "--env-b=X=1", "a"]).is_ok())
  expect(parse_opts(["--ab", "--rounds=x", "a", "b"]).is_err())
  expect(parse_opts(["--ab", "--bogus", "a", "b"]).is_err())
  match parse_opts(["--ab", "--rounds=7", "--env-a=K=V", "--args-b=-x 1", "p", "q", "--", "z"]) {
    Ok(o) => {
      expect(o.rounds == 7 && o.env_a == ["K=V"] && o.args_b == ["-x", "1"] && o.common == ["z"] && o.progs == ["p", "q"])
    }
    Err(e) => expect(e == "")
  }
}

test "a value flag takes its value as the next word" {
  match parse_opts(["--ab", "--rounds", "7", "--env-a", "K=V", "--args-b", "-x 1", "p", "q"]) {
    Ok(o) => {
      expect(o.rounds == 7 && o.env_a == ["K=V"] && o.args_b == ["-x", "1"] && o.progs == ["p", "q"])
    }
    Err(e) => expect(e == "")
  }
  expect(parse_opts(["--ab", "a", "b", "--rounds"]).is_err())
  expect(parse_opts(["--ab", "--rounds", "x", "a", "b"]).is_err())
}

test "fmt and jnum guard NaN and infinity" {
  let zero = 0.0
  let nan = zero / zero
  let inf = 1.0 / zero
  expect(fmt(nan) == "n/a")
  expect(fmt(inf) == "inf")
  expect(fmt(-inf) == "-inf")
  expect(fmt(1.0e20) != "")
  expect(jnum(nan) == "null")
  expect(jnum(inf) == "null")
  expect(jnum(1.5) == "1.5")
}

test "a quiet window holds a run unless it is the window's measurement" {
  os.env.set("XO_QUIET_FILE", "/quiet")
  os.fs.write("/quiet", "${os.clock.now().unix() + 3600}".bytes())?
  // wait_ok's answer with the environment set as named: 1 for true
  let ok = fn(heavy: Str, inwin: Str) -> Int {
    os.env.set("HEAVY_QUIET", heavy)
    os.env.set("XO_BENCH_IN_WINDOW", inwin)
    testing.run_main(fn(o: Os) -> () ! Error {
      var op = match parse_opts(["--ab", "a", "b"]) {
        Ok(x) => x
        Err(_) => o.proc.exit(2)
      }
      op.max_load = 0.0
      op.load_wait = Duration.from_secs_int(30)
      if wait_ok(o, Host{goos: "darwin"}, op) { o.proc.exit(1) }
      Ok(())
    }, os)
  }
  // another session's window: the run waits out load_wait
  expect(ok("", "")) == 0
  // started for the window by heavy.sh (HEAVY_QUIET=1), or by hand
  expect(ok("1", "")) == 1
  expect(ok("", "1")) == 1
  // the window closed: any run proceeds
  os.fs.write("/quiet", "1".bytes())?
  expect(ok("", "")) == 1
}

test "a gate or slot run of --ab is refused; a measure job and the window's own runs are not" {
  // slot_refusal with the environment set as named: 0 allowed, 1 refused
  // with the advice, 3 refused without it
  let refused = fn(slot: Str, heavy: Str, inwin: Str, flag: Str) -> Int {
    os.env.set("XO_HEAVY_SLOT", slot)
    os.env.set("HEAVY_QUIET", heavy)
    os.env.set("XO_BENCH_IN_WINDOW", inwin)
    testing.run_main(fn(o: Os) -> () ! Error {
      let args = if flag.is_empty() { ["--ab", "a", "b"] } else { ["--ab", flag, "a", "b"] }
      let op = match parse_opts(args) {
        Ok(x) => x
        Err(_) => o.proc.exit(2)
      }
      let why = slot_refusal(o, op)
      if !why.is_empty() {
        o.proc.exit(if why.contains("HEAVY_CLASS=measure") { 1 } else { 3 })
      }
      Ok(())
    }, os)
  }
  // not started by heavy.sh, or a measure job
  expect(refused("", "", "", "")) == 0
  expect(refused("measure", "1", "", "")) == 0
  // a gate, and a slot (heavy.sh names it by its lock file)
  expect(refused("gate", "", "", "")) == 1
  expect(refused("slot1", "", "", "")) == 1
  // the window's own runs never wait for it
  expect(refused("gate", "1", "", "")) == 0
  expect(refused("gate", "", "1", "")) == 0
  // nor does a run with no window guard (internal/arm64's inline test)
  // or its own
  expect(refused("gate", "", "", "--no-guard")) == 0
  expect(refused("gate", "", "", "--guard=true")) == 0
}

test "a round started at load 6 or more is loaded with no --max-load" {
  let o = match parse_opts(["--ab", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  expect(started_loaded(o, 20.0)) == true
  expect(started_loaded(o, 6.0)) == true
  expect(started_loaded(o, 2.5)) == false
  // with --max-load the guard waits; the start load alone does not mark
  let m = match parse_opts(["--ab", "--max-load=4", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  expect(started_loaded(m, 20.0)) == false
}

test "the loaded limit is the baseline plus the margin, never under 6" {
  var o = match parse_opts(["--ab", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  // an idle Mac at 4.6: a round loaded only from 7.6
  o.base_load = 4.6
  expect(started_loaded(o, 6.5)) == false
  expect(started_loaded(o, 7.6)) == true
  // a quiet machine keeps the old floor
  o.base_load = 1.0
  expect(started_loaded(o, 5.9)) == false
  expect(started_loaded(o, 6.0)) == true
  let s = Sample{vals: {}, ok: true, why: ""}
  o.base_load = 4.6
  let n = load_note(o, [Round{a: s, b: s, load_a: 5.0, load_b: 6.8, a_first: true, loaded: false}])
  expect(n.contains("loaded: 0 of 1 rounds")) == true
  expect(n.contains("baseline 4.6 + 3")) == true
}

test "the load note counts loaded rounds and warns at a busy median" {
  let o = match parse_opts(["--ab", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  let s = Sample{vals: {}, ok: true, why: ""}
  var rs: List[Round] = []
  for l in [20.0, 18.0, 21.0, 2.0] {
    rs.push(Round{a: s, b: s, load_a: l, load_b: l, a_first: true, loaded: l >= 6.0})
  }
  let n = load_note(o, rs)
  expect(n.contains("loaded: 3 of 4 rounds")) == true
  expect(n.contains("warning: the machine was busy")) == true
  var quiet: List[Round] = []
  for l in [2.0, 2.5, 3.0] {
    quiet.push(Round{a: s, b: s, load_a: l, load_b: l, a_first: true, loaded: false})
  }
  let q = load_note(o, quiet)
  expect(q.contains("loaded: 0 of 3 rounds")) == true
  expect(q.contains("warning")) == false
  expect(load_note(o, [])) == ""
}
