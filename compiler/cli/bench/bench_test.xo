use std/testing

test "rusage reads macOS time -l" {
  let err = "        0.40 real         0.31 user         0.02 sys\n             8306688  maximum resident set size\n  25632703  instructions retired\n"
  let m = rusage("darwin", err)
  expect(m.get("cpu_ms") == Some(330.0))
  expect(m.get("max_rss_kb") == Some(8112.0))
  expect(m.get("instructions") == Some(25632703.0))
}

test "rusage reads GNU time -v" {
  let err = "\tCommand being timed: \"x\"\n\tUser time (seconds): 0.25\n\tSystem time (seconds): 0.05\n\tMaximum resident set size (kbytes): 9000\n"
  let m = rusage("linux", err)
  expect(m.get("cpu_ms") == Some(300.0))
  expect(m.get("max_rss_kb") == Some(9000.0))
  expect(m.get("instructions") == None)
}

test "reported takes the numbers of the last JSON line" {
  let m = reported("log\n{\"ops\": 1, \"x\": 2}\nmore\n{\"requests\": 500, \"rps\":1.5e3, \"name\": \"a\", \"p99_us\": 20.5}\n")
  expect(m.get("requests") == Some(500.0))
  expect(m.get("rps") == Some(1500.0))
  expect(m.get("p99_us") == Some(20.5))
  expect(m.get("ops") == None)
  expect(m.get("name") == None)
}

test "options" {
  expect(parse_opts(["--ab", "a", "b"]).is_ok())
  expect(parse_opts(["a", "b"]).is_err())
  expect(parse_opts(["--ab", "a"]).is_err())
  expect(parse_opts(["--ab", "--env-b=X=1", "a"]).is_ok())
  expect(parse_opts(["--ab", "--rounds=x", "a", "b"]).is_err())
  expect(parse_opts(["--ab", "--bogus", "a", "b"]).is_err())
  match parse_opts(["--ab", "--rounds=7", "--env-a=K=V", "--args-b=-x 1", "p", "q", "--", "z"]) {
    Ok(o) => {
      expect(o.rounds == 7 && o.env_a == ["K=V"] && o.args_b == ["-x", "1"] && o.common == ["z"] && o.progs == ["p", "q"])
    }
    Err(e) => expect(e == "")
  }
}

test "fmt and jnum guard NaN and infinity" {
  let zero = 0.0
  let nan = zero / zero
  let inf = 1.0 / zero
  expect(fmt(nan) == "n/a")
  expect(fmt(inf) == "inf")
  expect(fmt(-inf) == "-inf")
  expect(fmt(1.0e20) != "")
  expect(jnum(nan) == "null")
  expect(jnum(inf) == "null")
  expect(jnum(1.5) == "1.5")
}

test "a quiet window holds a run unless it is the window's measurement" {
  os.env.set("XO_QUIET_FILE", "/quiet")
  os.fs.write("/quiet", "${os.clock.now().unix() + 3600}".bytes())?
  // wait_ok's answer with the environment set as named: 1 for true
  let ok = fn(heavy: Str, inwin: Str) -> Int {
    os.env.set("HEAVY_QUIET", heavy)
    os.env.set("XO_BENCH_IN_WINDOW", inwin)
    testing.run_main(fn(o: Os) -> () ! Error {
      var op = match parse_opts(["--ab", "a", "b"]) {
        Ok(x) => x
        Err(_) => o.proc.exit(2)
      }
      op.max_load = 0.0
      op.load_wait = Duration.from_secs_int(30)
      if wait_ok(o, Host{goos: "darwin"}, op) { o.proc.exit(1) }
      Ok(())
    }, os)
  }
  // another session's window: the run waits out load_wait
  expect(ok("", "")) == 0
  // started for the window by heavy.sh (HEAVY_QUIET=1), or by hand
  expect(ok("1", "")) == 1
  expect(ok("", "1")) == 1
  // the window closed: any run proceeds
  os.fs.write("/quiet", "1".bytes())?
  expect(ok("", "")) == 1
}
