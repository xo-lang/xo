use std/testing

test "rusage reads macOS time -l's counters" {
  let err = "        0.40 real         0.31 user         0.02 sys\n             8306688  maximum resident set size\n  25632703  instructions retired\n             4621817  cycles elapsed\n             1130736  peak memory footprint\n"
  let m = rusage("darwin", err)
  // cpu_ms and max_rss_kb come from ProcOutput.usage (decision 0426's addendum)
  expect(m.get("cpu_ms") == None)
  expect(m.get("max_rss_kb") == None)
  expect(m.get("instructions") == Some(25632703.0))
  expect(m.get("cycles") == Some(4621817.0))
}

test "ipc is higher is better, cycles lower" {
  expect(higher_better("ipc")) == true
  expect(higher_better("cycles_per_op")) == false
}

test "counters are n/a on Linux" {
  expect(counters_na("linux").contains("n/a")) == true
  expect(counters_na("windows").contains("Windows")) == true
}

test "rusage reads nothing off macOS" {
  expect(rusage("linux", "\tUser time (seconds): 0.25\n").is_empty()) == true
}

test "reported takes the numbers of the last JSON line" {
  let m = reported("log\n{\"ops\": 1, \"x\": 2}\nmore\n{\"requests\": 500, \"rps\":1.5e3, \"name\": \"a\", \"p99_us\": 20.5}\n")
  expect(m.get("requests") == Some(500.0))
  expect(m.get("rps") == Some(1500.0))
  expect(m.get("p99_us") == Some(20.5))
  expect(m.get("ops") == None)
  expect(m.get("name") == None)
}

test "options" {
  expect(parse_opts(["--ab", "a", "b"]).is_ok())
  expect(parse_opts(["a", "b"]).is_err())
  expect(parse_opts(["--ab", "a"]).is_err())
  expect(parse_opts(["--ab", "--env-b=X=1", "a"]).is_ok())
  expect(parse_opts(["--ab", "--rounds=x", "a", "b"]).is_err())
  // every --ab runs 4 rounds unless told otherwise (owner 2026-11-18,
  // question #163); no odd count was asked, so no note (task #378)
  match parse_opts(["--ab", "a", "b"]) {
    Ok(o) => expect(o.rounds == 4 && o.asked == 0)
    Err(e) => expect(e == "")
  }
  expect(parse_opts(["--ab", "--bogus", "a", "b"]).is_err())
  match parse_opts(["--ab", "--rounds=7", "--env-a=K=V", "--args-b=-x 1", "p", "q", "--", "z"]) {
    Ok(o) => {
      expect(o.rounds == 8 && o.asked == 7 && o.env_a == ["K=V"] && o.args_b == ["-x", "1"] && o.common == ["z"] && o.progs == ["p", "q"])
    }
    Err(e) => expect(e == "")
  }
}

test "a value flag takes its value as the next word" {
  match parse_opts(["--ab", "--rounds", "7", "--env-a", "K=V", "--args-b", "-x 1", "p", "q"]) {
    Ok(o) => {
      expect(o.rounds == 8 && o.env_a == ["K=V"] && o.args_b == ["-x", "1"] && o.progs == ["p", "q"])
    }
    Err(e) => expect(e == "")
  }
  expect(parse_opts(["--ab", "a", "b", "--rounds"]).is_err())
  expect(parse_opts(["--ab", "--rounds", "x", "a", "b"]).is_err())
}

test "fmt and jnum guard NaN and infinity" {
  let zero = 0.0
  let nan = zero / zero
  let inf = 1.0 / zero
  expect(fmt(nan) == "n/a")
  expect(fmt(inf) == "inf")
  expect(fmt(-inf) == "-inf")
  expect(fmt(1.0e20) != "")
  expect(jnum(nan) == "null")
  expect(jnum(inf) == "null")
  expect(jnum(1.5) == "1.5")
}

test "a quiet window holds a run unless it is the window's measurement" {
  os.env.set("XO_QUIET_FILE", "/quiet")
  os.fs.write("/quiet", "${os.clock.now().unix() + 3600}".bytes())?
  // wait_ok's answer with the environment set as named: 1 for true
  let ok = fn(heavy: Str, inwin: Str) -> Int {
    os.env.set("HEAVY_QUIET", heavy)
    os.env.set("XO_BENCH_IN_WINDOW", inwin)
    testing.run_main(fn(o: Os) -> () ! Error {
      var op = match parse_opts(["--ab", "a", "b"]) {
        Ok(x) => x
        Err(_) => o.proc.exit(2)
      }
      op.max_load = 0.0
      op.load_wait = Duration.from_secs_int(30)
      if wait_ok(o, Host{goos: "darwin"}, op) { o.proc.exit(1) }
      Ok(())
    }, os)
  }
  // another session's window: the run waits out load_wait
  expect(ok("", "")) == 0
  // started for the window by heavy.sh (HEAVY_QUIET=1), or by hand
  expect(ok("1", "")) == 1
  expect(ok("", "1")) == 1
  // the window closed: any run proceeds
  os.fs.write("/quiet", "1".bytes())?
  expect(ok("", "")) == 1
}

test "a gate or slot run of --ab is refused; a measure job and the window's own runs are not" {
  // slot_refusal with the environment set as named: 0 allowed, 1 refused
  // with the advice, 3 refused without it
  let refused = fn(slot: Str, heavy: Str, inwin: Str, flag: Str) -> Int {
    os.env.set("XO_HEAVY_SLOT", slot)
    os.env.set("HEAVY_QUIET", heavy)
    os.env.set("XO_BENCH_IN_WINDOW", inwin)
    testing.run_main(fn(o: Os) -> () ! Error {
      let args = if flag.is_empty() { ["--ab", "a", "b"] } else { ["--ab", flag, "a", "b"] }
      let op = match parse_opts(args) {
        Ok(x) => x
        Err(_) => o.proc.exit(2)
      }
      let why = slot_refusal(o, op)
      if !why.is_empty() {
        o.proc.exit(if why.contains("HEAVY_CLASS=measure") { 1 } else { 3 })
      }
      Ok(())
    }, os)
  }
  // not started by heavy.sh, or a measure job
  expect(refused("", "", "", "")) == 0
  expect(refused("measure", "1", "", "")) == 0
  // a gate, and a slot (heavy.sh names it by its lock file)
  expect(refused("gate", "", "", "")) == 1
  expect(refused("slot1", "", "", "")) == 1
  // the window's own runs never wait for it
  expect(refused("gate", "1", "", "")) == 0
  expect(refused("gate", "", "1", "")) == 0
  // nor does a run with no window guard (internal/arm64's inline test)
  // or its own
  expect(refused("gate", "", "", "--no-guard")) == 0
  expect(refused("gate", "", "", "--guard=true")) == 0
}

test "a round started at load 6 or more is loaded with no --max-load" {
  let o = match parse_opts(["--ab", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  expect(started_loaded(o, 20.0)) == true
  expect(started_loaded(o, 6.0)) == true
  expect(started_loaded(o, 2.5)) == false
  // with --max-load the guard waits; the start load alone does not mark
  let m = match parse_opts(["--ab", "--max-load=4", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  expect(started_loaded(m, 20.0)) == false
}

test "the loaded limit is the baseline plus the margin, never under 6" {
  var o = match parse_opts(["--ab", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  // an idle Mac at 4.6: a round loaded only from 7.6
  o.base_load = 4.6
  expect(started_loaded(o, 6.5)) == false
  expect(started_loaded(o, 7.6)) == true
  // a quiet machine keeps the old floor
  o.base_load = 1.0
  expect(started_loaded(o, 5.9)) == false
  expect(started_loaded(o, 6.0)) == true
  let s = Sample{vals: {}, ok: true, why: ""}
  o.base_load = 4.6
  let n = load_note(o, [Round{a: s, b: s, load_a: 5.0, load_b: 6.8, a_first: true, loaded: false}])
  expect(n.contains("loaded: 0 of 1 rounds")) == true
  expect(n.contains("baseline 4.6 + 3")) == true
}

test "the load note counts loaded rounds and warns at a busy median" {
  let o = match parse_opts(["--ab", "a", "b"]) {
    Ok(x) => x
    Err(e) => fault(e)
  }
  let s = Sample{vals: {}, ok: true, why: ""}
  var rs: List[Round] = []
  for l in [20.0, 18.0, 21.0, 2.0] {
    rs.push(Round{a: s, b: s, load_a: l, load_b: l, a_first: true, loaded: l >= 6.0})
  }
  let n = load_note(o, rs)
  expect(n.contains("loaded: 3 of 4 rounds")) == true
  expect(n.contains("warning: the machine was busy")) == true
  var quiet: List[Round] = []
  for l in [2.0, 2.5, 3.0] {
    quiet.push(Round{a: s, b: s, load_a: l, load_b: l, a_first: true, loaded: false})
  }
  let q = load_note(o, quiet)
  expect(q.contains("loaded: 0 of 3 rounds")) == true
  expect(q.contains("warning")) == false
  expect(load_note(o, [])) == ""
}

fn pos_round(a: Float, b: Float, a_first: Bool) -> Round {
  Round{a: Sample{vals: {"wall_ms": a}, ok: true, why: ""}, b: Sample{vals: {"wall_ms": b}, ok: true, why: ""}, load_a: 0.0, load_b: 0.0, a_first: a_first, loaded: false}
}

test "same slot B/A cancels a first-run advantage" {
  // equal programs; the first run of each round is 20% faster
  let rs = [pos_round(80.0, 100.0, true), pos_round(100.0, 80.0, false), pos_round(80.0, 100.0, true), pos_round(100.0, 80.0, false)]
  expect(same_pos(rs, "wall_ms", true)) == 1.0
  expect(same_pos(rs, "wall_ms", false)) == 1.0
  expect(same_pos([pos_round(80.0, 100.0, true)], "wall_ms", true)) == 0.0
  expect(pos_str(0.0)) == "n/a"
}

test "{side} names each side's output" {
  let o = parse_opts(["--ab", "a", "b", "--", "build", "-o", "out-{side}", "."]).or_fault("valid flags")
  expect(side_args(o, true).join(" ")) == "build -o out-a ."
  expect(side_args(o, false).join(" ")) == "build -o out-b ."
}

test "a shared back-end cache is warned about; a cache per side or off is not" {
  let shared = parse_opts(["--ab", "a", "b", "--", "build", "-o", "out-{side}", "."]).or_fault("valid flags")
  expect(shared_cache_note(shared, "", "").is_empty()) == false
  expect(shared_cache_note(shared, "/c", "off")) == ""
  let split = parse_opts(["--ab", "--env-a=XO_BACKEND_CACHE_DIR=/c/a", "--env-b=XO_BACKEND_CACHE_DIR=/c/b", "a", "b", "--", "build", "."]).or_fault("valid flags")
  expect(shared_cache_note(split, "/c", "")) == ""
  let one_off = parse_opts(["--ab", "--env-a=XO_BACKEND_CACHE=off", "a", "b", "--", "run", "."]).or_fault("valid flags")
  expect(shared_cache_note(one_off, "", "").is_empty()) == false
  let not_xo = parse_opts(["--ab", "a", "b", "--", "-n", "100"]).or_fault("valid flags")
  expect(shared_cache_note(not_xo, "", "")) == ""
}

// a null A/B (the same program on both sides) whose second run of a
// round is 5% slower, as null.sh's netip (xw-1 #347): the rounds in the
// order the loop runs them
fn null_rounds(rounds: Int, warmup: Int) -> List[Round] {
  var rs: List[Round] = []
  for n in 0..(warmup + rounds) {
    let af = a_first_at(n, warmup)
    if n >= warmup {
      rs.push(pos_round(if af { 200.0 } else { 210.0 }, if af { 210.0 } else { 200.0 }, af))
    }
  }
  rs
}

test "a null A/B with a second-run-slower effect reports no change (task #372)" {
  for asked in [3, 5, 7] {
    match parse_opts(["--ab", "--rounds=${asked}", "a", "b"]) {
      Ok(o) => {
        let rs = null_rounds(o.rounds, o.warmup)
        expect(rs.filter(fn(r: Round) { r.a_first }).len() * 2 == rs.len())
        expect(rs[0].a_first)
        let row = rows_of(o, rs).filter(fn(r: Row) { r.name == "wall_ms" })[0]
        expect(row.r.ratio) == 1.0
        expect(row.verdict) == "within noise"
      }
      Err(e) => expect(e) == ""
    }
  }
  expect(balanced_rounds(1)) == 2
  expect(balanced_rounds(4)) == 4
}

test "a wall time verdict needs 100 ms samples (task #372)" {
  match parse_opts(["--ab", "a", "b"]) {
    Ok(o) => {
      var rs: List[Round] = []
      for i in 0..4 {
        rs.push(pos_round(17.0, 15.0, i % 2 == 0))
      }
      expect(rows_of(o, rs)[0].verdict) == "too short"
      var long: List[Round] = []
      for i in 0..4 {
        long.push(pos_round(170.0, 150.0, i % 2 == 0))
      }
      expect(rows_of(o, long)[0].verdict) == "better"
    }
    Err(e) => expect(e) == ""
  }
}

test "--ab copies A and B into one tmpfs directory on Linux only (task #378)" {
  expect(stage_root("linux", false, true) == "/dev/shm")
  expect(stage_root("linux", true, true) == "")
  expect(stage_root("linux", false, false) == "")
  expect(stage_root("darwin", false, true) == "")
  let o = parse_opts(["--ab", "--in-place", "p", "q"]).or_fault("opts")
  expect(o.in_place)
  expect(!parse_opts(["--ab", "p", "q"]).or_fault("opts").in_place)
}

test "a staged xo finds the std beside its original (task #378)" {
  expect(with_std(["K=V"], "/x/std") == ["K=V", "XO_STD=/x/std"])
  expect(with_std(["XO_STD=/mine"], "/x/std") == ["XO_STD=/mine"])
  expect(with_std(["K=V"], "") == ["K=V"])
  expect(base_of("/a/b/xo") == "xo" && base_of("xo") == "xo")
  expect(dir_of("/a/b/xo") == "/a/b" && dir_of("xo") == "." && dir_of("/xo") == "/")
}

test "stage writes both sides into one new directory and keeps the bytes (task #378)" {
  // the test Fs: an in-memory tree
  let root = "/shm"
  let src = "/src"
  os.fs.create_dir_all(root).or_fault("root")
  os.fs.create_dir_all(src).or_fault("src")
  os.fs.write("${src}/pa", b"#!/bin/sh\necho a\n").or_fault("pa")
  os.fs.write("${src}/pb", b"#!/bin/sh\necho b\n").or_fault("pb")
  let o = parse_opts(["--ab", "${src}/pa", "${src}/pb"]).or_fault("opts")
  let st = stage(os.fs, root, o, "${src}/pa", "${src}/pb")
  expect(st.note == "")
  expect(st.dir.starts_with(root) && st.a.starts_with(st.dir) && st.b.starts_with(st.dir) && st.a != st.b)
  expect(os.fs.read(st.a).or_fault("a") == b"#!/bin/sh\necho a\n" && os.fs.read(st.b).or_fault("b") == b"#!/bin/sh\necho b\n")
  expect((os.fs.mode(st.a).or_fault("mode") & 0o111) == 0o111)
  let one = stage(os.fs, root, o, "${src}/pa", "${src}/pa")
  expect(one.a == one.b && one.a.starts_with(one.dir))
  let bare = stage(os.fs, root, o, "sh", "sh")
  expect(bare.dir == "" && bare.a == "sh" && bare.note.contains("not a file path"))
}

test "the default is 4 rounds, with no odd count note (task #378)" {
  let o = parse_opts(["--ab", "p", "q"]).or_fault("opts")
  expect(o.rounds == 4 && o.asked == 0)
}
