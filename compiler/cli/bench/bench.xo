// `xo bench --ab` (decision 0340): two programs, or one under two
// settings, run in interleaved rounds; per metric the medians, the spread,
// a bootstrap interval for the ratio, and a verdict.
//
//   xo bench --ab [flags] A [B] [-- ARGS...]

use github.com/xo-lang/xo/compiler/cli/core
use std/regexp
use std/task

/// What the caller (compiler/xo) knows about the running xo.
pub struct Host {
  /// GOOS of the host ("darwin", "linux", ...).
  pub goos: Str
}

pub fn usage() -> Str {
  [
    "usage: xo bench --ab [--rounds=N] [--warmup=N] [--env-a=K=V] [--env-b=K=V] [--args-a=WORDS] [--args-b=WORDS]",
    "                     [--max-load=X] [--load-wait=D] [--guard=CMD] [--no-guard] [--ops=N]",
    "                     [--metrics=a,b] [--keep-loaded] [--allow-fail] [--allow-fallback] [--timeout=D]",
    "                     [--alpha=P] [--seed=N] [--json] A [B] [-- ARGS...]",
  ].join("\n")
}

struct Opts {
  rounds: Int = 10
  warmup: Int = 1
  env_a: List[Str] = []
  env_b: List[Str] = []
  args_a: List[Str] = []
  args_b: List[Str] = []
  common: List[Str] = []
  max_load: Float = 0.0
  /// the 1 minute load before the first round (0: not taken), which
  /// the loaded limit is relative to (load_limit)
  base_load: Float = 0.0
  load_wait: Duration = Duration.from_secs_int(600)
  guard: Str = ""
  no_guard: Bool = false
  ops: Float = 0.0
  metrics: List[Str] = []
  keep_loaded: Bool = false
  allow_fail: Bool = false
  allow_fallback: Bool = false
  timeout: Duration = Duration.from_secs_int(600)
  alpha: Float = 0.05
  seed: Int = 1
  json: Bool = false
  progs: List[Str] = []
}

/// One measured run: the metrics by name.
struct Sample {
  vals: Map[Str, Float]
  ok: Bool
  why: Str
}

/// One round: both sides' samples and the load before each run.
struct Round {
  a: Sample
  b: Sample
  load_a: Float
  load_b: Float
  a_first: Bool
  loaded: Bool
}

fn flag_val(a: Str, name: Str) -> Str? {
  if a.starts_with("--${name}=") {
    return Some(a[name.len() + 3..])
  }
  None
}

/// Whether --name takes a value: given as `--name=V` or as `--name V`
/// (`--rounds 20` was "unknown flag --rounds" before 2026-10-30).
fn value_flag(name: Str) -> Bool {
  name is "rounds" | "warmup" | "env-a" | "env-b" | "args-a" | "args-b" | "max-load" | "load-wait" | "guard" | "ops" | "metrics" | "timeout" | "alpha" | "seed"
}

fn words(s: Str) -> List[Str] {
  var out: List[Str] = []
  for w in s.split(" ") {
    if !w.is_empty() {
      out.push(w)
    }
  }
  out
}

fn parse_opts(args: List[Str]) -> Opts ! Str {
  var o = Opts{}
  var ab = false
  var i = 0
  while i < args.len() {
    var a = args[i]
    i += 1
    if a.starts_with("--") && !a.contains("=") && value_flag(a[2..]) {
      // `--rounds 20`: the next word is the value
      if i >= args.len() {
        return Err("${a} needs a value")
      }
      a = "${a}=${args[i]}"
      i += 1
    }
    if a == "--" {
      while i < args.len() {
        o.common.push(args[i])
        i += 1
      }
      break
    }
    if a == "--ab" {
      ab = true
    } else if a == "--json" {
      o.json = true
    } else if a == "--keep-loaded" {
      o.keep_loaded = true
    } else if a == "--allow-fail" {
      o.allow_fail = true
    } else if a == "--allow-fallback" {
      o.allow_fallback = true
    } else if a == "--no-guard" {
      o.no_guard = true
    } else if let Some(v) = flag_val(a, "rounds") {
      o.rounds = Int.parse(v) ?? return Err("--rounds needs an integer")
    } else if let Some(v) = flag_val(a, "warmup") {
      o.warmup = Int.parse(v) ?? return Err("--warmup needs an integer")
    } else if let Some(v) = flag_val(a, "env-a") {
      o.env_a.push(v)
    } else if let Some(v) = flag_val(a, "env-b") {
      o.env_b.push(v)
    } else if let Some(v) = flag_val(a, "args-a") {
      o.args_a = words(v)
    } else if let Some(v) = flag_val(a, "args-b") {
      o.args_b = words(v)
    } else if let Some(v) = flag_val(a, "max-load") {
      o.max_load = Float.parse(v) ?? return Err("--max-load needs a number")
    } else if let Some(v) = flag_val(a, "load-wait") {
      o.load_wait = Duration.parse(v).ok() ?? return Err("--load-wait needs a duration such as 10m")
    } else if let Some(v) = flag_val(a, "guard") {
      o.guard = v
    } else if let Some(v) = flag_val(a, "ops") {
      o.ops = Float.parse(v) ?? return Err("--ops needs a number")
    } else if let Some(v) = flag_val(a, "metrics") {
      o.metrics = v.split(",")
    } else if let Some(v) = flag_val(a, "timeout") {
      o.timeout = Duration.parse(v).ok() ?? return Err("--timeout needs a duration such as 10m")
    } else if let Some(v) = flag_val(a, "alpha") {
      o.alpha = Float.parse(v) ?? return Err("--alpha needs a number")
    } else if let Some(v) = flag_val(a, "seed") {
      o.seed = Int.parse(v) ?? return Err("--seed needs an integer")
    } else if a.starts_with("--") {
      return Err("unknown flag ${a}")
    } else {
      o.progs.push(a)
    }
  }
  if !ab {
    return Err("only --ab is implemented")
  }
  if o.progs.is_empty() || o.progs.len() > 2 {
    return Err("give one or two programs")
  }
  if o.progs.len() == 1 && o.env_a.is_empty() && o.env_b.is_empty() && o.args_a == o.args_b {
    return Err("one program needs --env-a/--env-b or --args-a/--args-b to differ")
  }
  if o.rounds < 1 {
    return Err("--rounds must be at least 1")
  }
  o
}

/// The 1 minute load average (0.0 when unreadable).
fn load1(os: Os, goos: Str) -> Float uses (fs.read, proc) {
  if goos == "linux" {
    let t = os.fs.read_text("/proc/loadavg").ok() ?? ""
    return Float.parse(words(t).first() ?? "0") ?? 0.0
  }
  // macOS: sysctl -n vm.loadavg prints "{ 1.23 4.56 7.89 }"
  match os.proc.run("sysctl", ["-n", "vm.loadavg"]) {
    Ok(r) => {
      let w = words((r.stdout.to_str() ?? "").trim())
      if w.len() > 1 { Float.parse(w[1]) ?? 0.0 } else { 0.0 }
    }
    Err(_) => 0.0
  }
}

/// quiet_file is the lead's quiet window file: a future epoch inside it
/// means a measurement window is open: only runs started for it
/// (HEAVY_QUIET=1, which heavy.sh passes to its child, or
/// XO_BENCH_IN_WINDOW=1) proceed, and every other run waits.
fn quiet_file(os: Os) -> Str uses env {
  match os.env.get("XO_QUIET_FILE") {
    Some(p) => p
    None => "${os.env.get("HOME") ?? ""}/xo-lead/quiet"
  }
}

/// Whether this run is the window's own measurement (quiet_file).
fn in_window_run(os: Os) -> Bool uses env {
  (os.env.get("HEAVY_QUIET") ?? "") == "1" || (os.env.get("XO_BENCH_IN_WINDOW") ?? "") == "1"
}

/// Why this --ab may not run where it was started, or "": heavy.sh sets
/// XO_HEAVY_SLOT for every run it starts ("gate", a slot's name, or
/// "measure"), and a gate or slot run that waits for a quiet window
/// deadlocks, since the window's measurement waits for the gates and
/// slots to finish (2026-10-27: a gate's instruction check sat 28 minutes
/// against Lang 1's measurement; gotchas/bench-ab-inside-gate-deadlock.md).
/// The window's own runs (in_window_run) and runs that do not wait for
/// the window (--no-guard, --guard=CMD; wait_ok) may run.
fn slot_refusal(os: Os, o: Opts) -> Str uses env {
  let slot = os.env.get("XO_HEAVY_SLOT") ?? ""
  if slot == "" || slot == "measure" || in_window_run(os) || o.no_guard || !o.guard.is_empty() {
    return ""
  }
  "run --ab as its own HEAVY_CLASS=measure job (a gate or slot would deadlock against a measure window); this run is heavy.sh's ${slot}"
}

fn window_open(os: Os) -> Bool uses (clock, env, fs.read) {
  let t = (os.fs.read_text(quiet_file(os)).ok() ?? "").trim()
  match Int.parse(t) {
    Some(until) => until > os.clock.now().unix()
    None => false
  }
}

/// The least 1 minute load at which a round is loaded when no --max-load
/// is given (it is then left out unless --keep-loaded; the guard does not
/// wait for it) (lead, 2026-10-26: a run at a steady load of 20 reported
/// "0 loaded", since without --max-load no round ever was).
const WARN_LOAD = 6.0

/// How far over the load before the first round a round may start and
/// still count: the limit is relative, since the idle Mac's load moves
/// with the sessions on it (2026-10-28: idle at 4.4 to 5, a multi-threaded
/// workload put nearly every round over a fixed 6, and an A/B lost 18 of
/// its 20 workloads; gotchas/bench-fixed-load-limit.md).
const LOAD_MARGIN = 3.0

/// The load at or above which a round is loaded: --max-load when given,
/// else the baseline plus LOAD_MARGIN, never under WARN_LOAD.
fn load_limit(o: Opts) -> Float {
  if o.max_load > 0.0 {
    return o.max_load
  }
  let rel = o.base_load + LOAD_MARGIN
  if rel > WARN_LOAD { rel } else { WARN_LOAD }
}

/// Whether a side that starts at 1 minute load ld makes its round loaded
/// without the guard having waited: only with no --max-load (with one,
/// wait_ok waits, and a round it gave up on is loaded).
fn started_loaded(o: Opts, ld: Float) -> Bool {
  o.max_load == 0.0 && ld >= load_limit(o)
}

/// The summary's load line: the median load of each side and how many
/// rounds were loaded (started at or above load_limit), with the baseline
/// it came from and a warning when a median is over it; "" with no rounds.
fn load_note(o: Opts, rounds: List[Round]) -> Str {
  if rounds.is_empty() {
    return ""
  }
  let lim = load_limit(o)
  var la: List[Float] = []
  var lb: List[Float] = []
  var over = 0
  for r in rounds {
    la.push(r.load_a)
    lb.push(r.load_b)
    if r.load_a >= lim || r.load_b >= lim {
      over += 1
    }
  }
  let ma = median(la)
  let mb = median(lb)
  var line = "load: median ${fmt(ma)} (A) / ${fmt(mb)} (B); loaded: ${over} of ${rounds.len()} rounds (at or above ${fmt(lim)}${if o.max_load == 0.0 { "; baseline ${fmt(o.base_load)} + ${fmt(LOAD_MARGIN)}, at least ${fmt(WARN_LOAD)}" } else { "" }})"
  if ma >= lim || mb >= lim {
    line = "${line}\nwarning: the machine was busy through the run (median load at or above ${fmt(lim)}): wall and cpu ratios are not reliable; measure with HEAVY_CLASS=measure (agent-tools.md Measuring) or --max-load"
  }
  line
}

/// wait_ok waits until the guards allow a run: the quiet window closed
/// (or this run is its measurement, in_window_run), the load under
/// max_load, the guard command successful. It returns false
/// when load_wait passes first (the round runs, marked loaded).
fn wait_ok(os: Os, h: Host, o: Opts) -> Bool uses (clock, env, fs.read, proc) {
  let t0 = os.clock.now()
  while true {
    var busy = false
    if !o.no_guard && o.guard.is_empty() && window_open(os) && !in_window_run(os) {
      busy = true
    }
    if o.max_load > 0.0 && load1(os, h.goos) >= o.max_load {
      busy = true
    }
    if !o.guard.is_empty() {
      let code = os.proc.cmd("sh", ["-c", o.guard]).run().ok() ?? 1
      if code != 0 {
        busy = true
      }
    }
    if !busy {
      return true
    }
    if os.clock.since(t0) > o.load_wait {
      return false
    }
    os.clock.sleep(Duration.from_secs_int(5))
  }
  false
}

/// The numbers `"key": 1.5` of the last JSON object line of s.
fn reported(s: Str) -> Map[Str, Float] {
  var out: Map[Str, Float] = {}
  var last = ""
  for l in s.split("\n") {
    if l.trim().starts_with("{") {
      last = l
    }
  }
  let re = regexp.must("\"[A-Za-z0-9_]+\"\\s*:\\s*-?[0-9][0-9.eE+-]*")
  for m in re.find_all(last) {
    let kv = m.split(":")
    let k = kv[0].trim().trim_prefix("\"").trim_suffix("\"")
    if let Some(v) = Float.parse(kv[1].trim()) {
      out[k] = v
    }
  }
  out
}

fn num_before(l: Str, suffix: Str) -> Float? {
  let t = l.trim()
  if t.ends_with(suffix) {
    return Float.parse(words(t.trim_suffix(suffix).trim())[0])
  }
  None
}

/// The rusage figures `/usr/bin/time` printed on stderr: cpu_ms,
/// max_rss_kb, and (macOS) instructions and cycles.
fn rusage(goos: Str, err: Str) -> Map[Str, Float] {
  var out: Map[Str, Float] = {}
  for l in err.split("\n") {
    let t = l.trim()
    if goos == "darwin" {
      // "0.40 real         0.31 user         0.02 sys"
      if t.ends_with(" sys") && t.contains(" real") {
        let w = words(t)
        if w.len() >= 6 {
          out["cpu_ms"] = ((Float.parse(w[2]) ?? 0.0) + (Float.parse(w[4]) ?? 0.0)) * 1000.0
        }
      }
      if let Some(v) = num_before(t, " maximum resident set size") {
        out["max_rss_kb"] = v / 1024.0
      }
      if let Some(v) = num_before(t, " instructions retired") {
        out["instructions"] = v
      }
      if let Some(v) = num_before(t, " cycles elapsed") {
        out["cycles"] = v
      }
    } else {
      if t.starts_with("User time (seconds):") || t.starts_with("System time (seconds):") {
        let v = Float.parse(t.split(":")[1].trim()) ?? 0.0
        out["cpu_ms"] = (out.get("cpu_ms") ?? 0.0) + v * 1000.0
      }
      if t.starts_with("Maximum resident set size (kbytes):") {
        out["max_rss_kb"] = Float.parse(t.split(":")[1].trim()) ?? 0.0
      }
    }
  }
  out
}

/// timed_cmd wraps prog in the platform's time(1). Windows has none (Git
/// Bash ships no /usr/bin/time), so prog runs alone there and a round
/// reports wall_ms only.
fn timed_cmd(os: Os, h: Host, o: Opts, prog: Str, args: List[Str], env: List[Str]) -> Cmd {
  var argv: List[Str] = []
  var tool = "/usr/bin/time"
  if h.goos == "windows" {
    tool = prog
  } else if h.goos == "darwin" {
    argv.push("-l")
  } else {
    argv.push("-v")
  }
  if h.goos != "windows" {
    argv.push(prog)
  }
  for a in args {
    argv.push(a)
  }
  var c = os.proc.cmd(tool, argv)
  for kv in env {
    let p = kv.split("=")
    c = c.set_env(p[0], kv[p[0].len() + 1..])
  }
  c
}

fn run_once(os: Os, h: Host, o: Opts, prog: Str, args: List[Str], env: List[Str]) -> Sample uses (clock, env, proc) {
  let c = timed_cmd(os, h, o, prog, args, env)
  let t0 = os.clock.now()
  let r = task.with_timeout(os.clock, o.timeout, fn() { c.output() })
  let wall = Float(os.clock.since(t0).nanos()) / 1000000.0
  match r {
    Ok(out) => {
      let err = out.stderr.to_str() ?? ""
      if out.code != 0 {
        return Sample{vals: {}, ok: false, why: "exit ${out.code}"}
      }
      var m = reported(out.stdout.to_str() ?? "")
      let ru = rusage(h.goos, err)
      for k in ru.keys() {
        m[k] = ru.get(k) ?? 0.0
      }
      m["wall_ms"] = wall
      var ops = o.ops
      if ops == 0.0 {
        for k in ["ops", "requests", "all_requests"] {
          if ops == 0.0 {
            ops = m.get(k) ?? 0.0
          }
        }
      }
      if ops > 0.0 {
        if let Some(c) = m.get("cpu_ms") {
          m["cpu_us_per_op"] = c * 1000.0 / ops
        }
        if let Some(n) = m.get("instructions") {
          m["instructions_per_op"] = n / ops
        }
        if let Some(n) = m.get("cycles") {
          m["cycles_per_op"] = n / ops
        }
      }
      // instructions per cycle: fewer instructions can still run slower
      // when this drops (a wall change the instruction count misses)
      if let Some(n) = m.get("instructions") {
        if let Some(cy) = m.get("cycles") {
          if cy > 0.0 {
            m["ipc"] = n / cy
          }
        }
      }
      Sample{vals: m, ok: true, why: ""}
    }
    Err(task.Timed.TimedOut) => Sample{vals: {}, ok: false, why: "timed out"}
    Err(task.Timed.Failed(e)) => Sample{vals: {}, ok: false, why: "${e}"}
  }
}

fn side_args(o: Opts, side_a: Bool) -> List[Str] {
  var out: List[Str] = []
  for a in (if side_a { o.args_a } else { o.args_b }) {
    out.push(a)
  }
  for a in o.common {
    out.push(a)
  }
  out
}

fn finite(v: Float) -> Bool {
  v == v && v.abs() < 1.0e300
}

/// jnum is a JSON number; NaN and infinities are null.
fn jnum(v: Float) -> Str {
  if finite(v) {
    return "${v}"
  }
  "null"
}

fn fmt(v: Float) -> Str {
  if v != v {
    return "n/a"
  }
  if !finite(v) {
    return if v < 0.0 { "-inf" } else { "inf" }
  }
  if v == 0.0 {
    return "0"
  }
  let a = v.abs()
  if a >= 1.0e15 {
    return "${v}"
  }
  if a >= 1000.0 {
    return "${Int(v.round())}"
  }
  let p = if a >= 100.0 { 10.0 } else if a >= 10.0 { 100.0 } else { 1000.0 }
  "${(v * p).round() / p}"
}

struct Row {
  name: Str
  n: Int
  med_a: Float
  med_b: Float
  spread_a: Float
  spread_b: Float
  r: Ratio
  verdict: Str
}

fn rows_of(o: Opts, rounds: List[Round]) -> List[Row] {
  var names: List[Str] = []
  for r in rounds {
    for k in r.a.vals.keys() {
      if !names.contains(k) {
        names.push(k)
      }
    }
  }
  let order = ["wall_ms", "cpu_ms", "cpu_us_per_op", "instructions", "instructions_per_op", "cycles", "cycles_per_op", "ipc", "max_rss_kb"]
  var rest: List[Str] = []
  var first: List[Str] = []
  for k in order {
    if names.contains(k) {
      first.push(k)
    }
  }
  for k in names.sort() {
    if !order.contains(k) {
      rest.push(k)
    }
  }
  var all: List[Str] = []
  for k in first {
    all.push(k)
  }
  for k in rest {
    all.push(k)
  }
  var cpu_a: List[Float] = []
  var cpu_b: List[Float] = []
  for r in rounds {
    if let Some(va) = r.a.vals.get("cpu_ms") {
      if let Some(vb) = r.b.vals.get("cpu_ms") {
        cpu_a.push(va)
        cpu_b.push(vb)
      }
    }
  }
  let cpu_med_a = if cpu_a.is_empty() { 0.0 } else { median(cpu_a) }
  let cpu_med_b = if cpu_b.is_empty() { 0.0 } else { median(cpu_b) }
  var rows: List[Row] = []
  for k in all {
    if !o.metrics.is_empty() && !o.metrics.contains(k) {
      continue
    }
    var xa: List[Float] = []
    var xb: List[Float] = []
    for r in rounds {
      if let Some(va) = r.a.vals.get(k) {
        if let Some(vb) = r.b.vals.get(k) {
          xa.push(va)
          xb.push(vb)
        }
      }
    }
    if xa.is_empty() {
      continue
    }
    let rt = bootstrap_ratio(xa, xb, 10000, o.seed, o.alpha)
    let ma = median(xa)
    let mb = median(xb)
    var vd = verdict(rt, xa.len(), !higher_better(k))
    let src = if k == "cpu_us_per_op" { "cpu_ms" } else { k }
    if vd != "too few rounds" && coarse(if src == k { ma } else { cpu_med_a }, if src == k { mb } else { cpu_med_b }, resolution(src)) {
      vd = "too coarse"
    }
    rows.push(Row{name: k, n: xa.len(), med_a: ma, med_b: mb, spread_a: spread_pct(xa), spread_b: spread_pct(xb), r: rt, verdict: vd})
  }
  rows
}

fn pad(s: Str, n: Int) -> Str {
  var t = s
  while t.len() < n {
    t = t + " "
  }
  t
}

fn table(rows: List[Row]) -> Str {
  var out = StrBuilder.new()
  out.write("${pad("metric", 22)}${pad("A median", 12)}${pad("B median", 12)}${pad("spread A/B", 18)}${pad("B / A", 8)}${pad("95% interval", 18)}verdict\n")
  for r in rows {
    out.write("${pad(r.name, 22)}${pad(fmt(r.med_a), 12)}${pad(fmt(r.med_b), 12)}${pad("${fmt(r.spread_a)}% ${fmt(r.spread_b)}%", 18)}${pad(if r.r.defined { fmt(r.r.ratio) } else { "n/a" }, 8)}${pad(if r.r.defined { "${fmt(r.r.lo)} to ${fmt(r.r.hi)}" } else { "n/a" }, 18)}${r.verdict} (n=${r.n})\n")
  }
  out.freeze()
}

fn json_out(o: Opts, rounds: List[Round], used: Int, rows: List[Row]) -> Str {
  var out = StrBuilder.new()
  out.write("{\"rounds\":${o.rounds},\"used\":${used},\"load_note\":${load_note(o, rounds).quote()},\"alpha\":${o.alpha},\"seed\":${o.seed},\"metrics\":{")
  var first = true
  for r in rows {
    if !first {
      out.write(",")
    }
    first = false
    out.write("${r.name.quote()}:{\"n\":${r.n},\"median_a\":${jnum(r.med_a)},\"median_b\":${jnum(r.med_b)},\"spread_a_pct\":${jnum(r.spread_a)},\"spread_b_pct\":${jnum(r.spread_b)},\"ratio\":${if r.r.defined { jnum(r.r.ratio) } else { "null" }},\"lo\":${if r.r.defined { jnum(r.r.lo) } else { "null" }},\"hi\":${if r.r.defined { jnum(r.r.hi) } else { "null" }},\"verdict\":${r.verdict.quote()}}")
  }
  out.write("},\"per_round\":[")
  var i = 0
  for r in rounds {
    if i > 0 {
      out.write(",")
    }
    i += 1
    out.write("{\"load_a\":${jnum(r.load_a)},\"load_b\":${jnum(r.load_b)},\"a_first\":${r.a_first},\"loaded\":${r.loaded},\"a\":${vals_json(r.a.vals)},\"b\":${vals_json(r.b.vals)}}")
  }
  out.write("]}")
  out.freeze()
}

fn vals_json(m: Map[Str, Float]) -> Str {
  var out = StrBuilder.new()
  out.write("{")
  var first = true
  for k in m.keys().sort() {
    if !first {
      out.write(",")
    }
    first = false
    out.write("${k.quote()}:${jnum(m.get(k) ?? 0.0)}")
  }
  out.write("}")
  out.freeze()
}

/// The line saying the counter rows are missing, and why: GNU time
/// (Linux) reports neither instructions nor cycles.
/// The note a Windows run prints under its table: no round measured the
/// child's CPU or memory, so those rows are absent, not zero.
fn usage_na() -> Str {
  "cpu_ms, max_rss_kb: not measured on Windows (no time(1) there; wall_ms only until decision 0426's Proc.children_usage)"
}

fn counters_na(goos: Str) -> Str {
  if goos == "windows" {
    return "instructions, cycles, ipc: n/a (not measured on Windows)"
  }
  if goos == "darwin" {
    return "instructions, cycles, ipc: n/a (time -l printed no cycles elapsed line)"
  }
  "instructions, cycles, ipc: n/a (GNU time reports neither instructions nor cycles; only macOS time -l does)"
}

/// run is `xo bench ARGS` and returns the exit status.
/// The first verification error a binary's build information records
/// when it was built without inlining (compiler/xo binfo.xo
/// inline_fallback), or "" (none, or no build information: a command,
/// a script, an older xo's binary).
fn inline_fallback(os: Os, prog: Str) -> Str uses fs.read {
  let data = os.fs.read(prog).ok() ?? b""
  let text = core.find_build_info(data, "")
  let key = "\"inline_fallback\":\""
  let i = text.find(key) ?? -1
  if i < 0 {
    return ""
  }
  let rest = text[i + key.len()..text.len()]
  let j = rest.find("\",\"") ?? rest.find("\"}") ?? rest.len()
  rest[0..j]
}

pub fn run(os: Os, h: Host, args: List[Str]) -> Int uses (clock, env, fs.read, proc, stdio) {
  let o0 = match parse_opts(args) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo bench: ${e}\n${usage()}")
      return 2
    }
  }
  let refusal = slot_refusal(os, o0)
  if !refusal.is_empty() {
    os.stdio.eprintln("xo bench: ${refusal}")
    return 2
  }
  let pa = o0.progs[0]
  let pb = if o0.progs.len() == 2 { o0.progs[1] } else { pa }
  if !o0.allow_fallback {
    for p in o0.progs {
      let why = inline_fallback(os, p)
      if !why.is_empty() {
        os.stdio.eprintln("xo bench: ${p} was built without inlining (its inlined module did not verify: ${why}), so its numbers are not the program's; fix the build, or pass --allow-fallback")
        return 2
      }
    }
  }
  // the load before any round runs: the limit a round is loaded at is
  // relative to it (load_limit)
  var o = o0
  o.base_load = load1(os, h.goos)
  let aa = side_args(o, true)
  let ab = side_args(o, false)
  var rounds: List[Round] = []
  var failed = false
  for n in 0..(o.warmup + o.rounds) {
    let a_first = n % 2 == 0
    var ra: Sample = Sample{vals: {}, ok: false, why: ""}
    var rb: Sample = Sample{vals: {}, ok: false, why: ""}
    var la = 0.0
    var lb = 0.0
    var loaded = false
    for k in 0..2 {
      let is_a = (k == 0) == a_first
      let calm = wait_ok(os, h, o)
      if !calm {
        loaded = true
      }
      let ld = load1(os, h.goos)
      // with no --max-load the guard does not wait, but a side started
      // at or above WARN_LOAD marks the round loaded (left out of the
      // statistics unless --keep-loaded)
      if started_loaded(o, ld) {
        loaded = true
      }
      if is_a {
        la = ld
        ra = run_once(os, h, o, pa, aa, o.env_a)
      } else {
        lb = ld
        rb = run_once(os, h, o, pb, ab, o.env_b)
      }
    }
    if !ra.ok || !rb.ok {
      os.stdio.eprintln("xo bench: round ${n}: ${if !ra.ok { "A: ${ra.why}" } else { "B: ${rb.why}" }}")
      if !o.allow_fail {
        return 1
      }
      failed = true
      continue
    }
    if n >= o.warmup {
      rounds.push(Round{a: ra, b: rb, load_a: la, load_b: lb, a_first: a_first, loaded: loaded})
      if !o.json {
        os.stdio.eprintln("round ${n - o.warmup + 1}/${o.rounds}: load ${fmt(la)} / ${fmt(lb)}${if loaded { " (loaded)" } else { "" }}")
      }
    }
  }
  var used: List[Round] = []
  for r in rounds {
    if o.keep_loaded || !r.loaded {
      used.push(r)
    }
  }
  let rows = rows_of(o, used)
  if o.json {
    os.stdio.println(json_out(o, rounds, used.len(), rows))
  } else {
    os.stdio.println("A: ${pa} ${aa.join(" ")} ${o.env_a.join(" ")}")
    os.stdio.println("B: ${pb} ${ab.join(" ")} ${o.env_b.join(" ")}")
    os.stdio.println("${used.len()} of ${rounds.len()} rounds used (${rounds.len() - used.len()} loaded), loads A/B per round: ${rounds.map(fn(r: Round) -> Str { "${fmt(r.load_a)}/${fmt(r.load_b)}" }).join(" ")}\n")
    if rows.is_empty() {
      os.stdio.println("no round was usable: every round ran under load (see --max-load, --guard, --load-wait, --keep-loaded)")
      os.stdio.println(load_note(o, rounds))
    } else {
      os.stdio.print(table(rows))
      os.stdio.println(load_note(o, rounds))
      if h.goos == "windows" {
        os.stdio.println(usage_na())
      }
      if !rows.any(fn(r: Row) { r.name == "cycles" }) && (o.metrics.is_empty() || o.metrics.any(fn(k) { k is "cycles" | "cycles_per_op" | "ipc" | "instructions" })) {
        os.stdio.println(counters_na(h.goos))
      }
    }
  }
  if failed { 1 } else { 0 }
}
