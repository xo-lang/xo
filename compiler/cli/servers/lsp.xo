// `xo lsp`: the Language Server Protocol server of internal/lsp in Xo
// (decision 0178 stage 5). JSON-RPC 2.0 over standard input and output
// with Content-Length framing (LSP 3.17). The server keeps the text of
// open documents and checks their modules in process with the self hosted
// checker (compiler/check), the open texts as its overlay, and publishes
// the diagnostics as the Go server does. Each open directory is checked
// on its own, in a worker task (decision 0284): after a change (debounced,
// 150 ms) only its directory and the open directories whose last check
// read it are checked again, a request that reads a check waits for its
// directory's (references and rename for one over every open directory),
// and formatting and documentSymbol are answered at once.
//
// Every request of the Go server: initialize, shutdown, exit, the
// document notifications, publishDiagnostics (with window/logMessage when
// the check fails), codeAction (the diagnostics' machine fixes as quick
// fixes), documentSymbol, (lsp_features.xo, over the identifier
// resolution of resolve.xo) hover, definition, references, prepareRename,
// rename, formatting, and semanticTokens, and (lsp_complete.xo, decision
// 0219) completion and signatureHelp. A definition in std is opened
// from a read only copy under <user cache dir>/xo/lsp-std, as the Go
// server writes it.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser

const TOKEN_TYPES = ["namespace", "type", "struct", "enum", "interface", "typeParameter", "parameter", "variable", "property", "enumMember", "function", "method"]

const TOKEN_MODIFIERS = ["declaration", "readonly", "defaultLibrary"]

fn lsp_flags() -> List[Flag] {
  [Flag{name: "stdio", kind: "bool", def: "true", usage: "serve on stdin/stdout (the only transport; accepted for clients that pass it)"}]
}

// ---------------------------------------------------------------------------
// text positions (internal/lsp text.go): the checker's 1 based line and
// byte column, LSP's 0 based line and UTF-16 character

struct Text {
  src: Bytes
  /// byte offset of the start of each line
  lines: List[Int]
}

fn new_text(src: Bytes) -> Text {
  var lines = [0]
  var i = 0
  while i < src.len() {
    if src[i] == '\n' {
      lines.push(i + 1)
    }
    i += 1
  }
  Text{src: src, lines: lines}
}

/// The bytes of line l (0 based) without its `\n` or `\r\n`.
fn (t: Text) line_bytes(l: Int) -> Bytes {
  if l < 0 || l >= t.lines.len() {
    return b""
  }
  var end = t.src.len()
  if l + 1 < t.lines.len() {
    end = t.lines[l + 1] - 1
  }
  var b = t.src[t.lines[l]..end]
  if b.len() > 0 && b[b.len() - 1] == '\r' {
    b = b[0..b.len() - 1]
  }
  b
}

fn utf16_len(b: Bytes) -> Int {
  var n = 0
  var i = 0
  while i < b.len() {
    let (r, size) = b.decode_rune(i)
    n += if Int(r) >= 0x10000 { 2 } else { 1 }
    i += if size > 0 { size } else { 1 }
  }
  n
}

/// position: a 1 based line and byte column as (line, character).
fn (t: Text) position(line: Int, col: Int) -> (Int, Int) {
  let l = line - 1
  let b = t.line_bytes(l)
  var n = col - 1
  if n > b.len() {
    n = b.len()
  }
  if n < 0 {
    n = 0
  }
  (if l > 0 { l } else { 0 }, utf16_len(b[0..n]))
}

/// offset: an LSP position as a byte offset.
fn (t: Text) offset(line: Int, ch: Int) -> Int {
  if line >= t.lines.len() || line < 0 {
    return t.src.len()
  }
  let b = t.line_bytes(line)
  var units = 0
  var i = 0
  while i < b.len() && units < ch {
    let (r, size) = b.decode_rune(i)
    units += if Int(r) >= 0x10000 { 2 } else { 1 }
    if units > ch {
      break
    }
    i += if size > 0 { size } else { 1 }
  }
  t.lines[line] + i
}

/// offsetPosition: a byte offset as (line, character).
fn (t: Text) offset_position(off: Int) -> (Int, Int) {
  var lo = 0
  var hi = t.lines.len() - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if t.lines[mid] <= off {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  t.position(lo + 1, off - t.lines[lo] + 1)
}

fn pos_json(p: (Int, Int)) -> J {
  let (l, c) = p
  jobj(["line", "character"], [jint(l), jint(c)])
}

fn range_json(a: (Int, Int), b: (Int, Int)) -> J { jobj(["start", "end"], [pos_json(a), pos_json(b)]) }

// ---------------------------------------------------------------------------
// URIs (url.URL with Scheme "file")

fn hex_digit(n: Int) -> Str { "0123456789ABCDEF"[n..n + 1] }

/// pathToURI: "file://" and the path escaped as url.URL escapes a path.
fn path_to_uri(path: Str) -> Str {
  var out = "file://"
  for c in path.bytes() {
    let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' || c == '$' || c == '&' || c == '+' || c == ',' || c == '/' || c == ':' || c == ';' || c == '=' || c == '@'
    if ok {
      out = out + "${Rune.try(Int(c)) ?? '?'}"
    } else {
      out = out + "%" + hex_digit(Int(c) >> 4) + hex_digit(Int(c) & 15)
    }
  }
  out
}

fn unhex(c: UInt8) -> Int {
  if c >= '0' && c <= '9' {
    return Int(c - '0')
  }
  if (c | 0x20) >= 'a' && (c | 0x20) <= 'f' {
    return Int((c | 0x20) - 'a') + 10
  }
  -1
}

/// uriToPath: the cleaned path of a file URI, or "".
fn uri_to_path(uri: Str) -> Str {
  if !uri.starts_with("file:") {
    return ""
  }
  var rest = uri.trim_prefix("file:")
  if rest.starts_with("//") {
    rest = rest[2..]
    // the authority (empty or localhost) up to the path
    match rest.find("/") {
      Some(i) => rest = rest[i..]
      None => rest = ""
    }
  }
  match rest.find("?") {
    Some(i) => rest = rest[..i]
    None => {}
  }
  match rest.find("#") {
    Some(i) => rest = rest[..i]
    None => {}
  }
  let b = rest.bytes()
  var out = BytesBuilder.new()
  var i = 0
  while i < b.len() {
    if b[i] == '%' && i + 2 < b.len() + 0 && i + 2 <= b.len() - 1 && unhex(b[i + 1]) >= 0 && unhex(b[i + 2]) >= 0 {
      out.write_byte(UInt8(unhex(b[i + 1]) * 16 + unhex(b[i + 2])))
      i += 3
      continue
    }
    out.write_byte(b[i])
    i += 1
  }
  clean_path(out.freeze().to_str() ?? "")
}

/// filepath.Clean of a slash path.
fn clean_path(p: Str) -> Str {
  if p.is_empty() {
    return "."
  }
  let rooted = p.starts_with("/")
  var parts: List[Str] = []
  for seg in p.split("/") {
    if seg.is_empty() || seg == "." {
      continue
    }
    if seg == ".." {
      if !parts.is_empty() && parts[parts.len() - 1] != ".." {
        parts = parts[0..parts.len() - 1]
      } else if !rooted {
        parts.push("..")
      }
      continue
    }
    parts.push(seg)
  }
  let body = parts.join("/")
  if rooted {
    return "/" + body
  }
  if body.is_empty() { "." } else { body }
}

// ---------------------------------------------------------------------------
// framing

/// Reads framed messages from standard input.
struct Reader {
  buf: Bytes = b""
  off: Int = 0
  eof: Bool = false
}

fn (var r: Reader) fill(os: Os) -> Bool uses stdio {
  if r.eof {
    return false
  }
  match os.stdio.read_bytes(65536) {
    Ok(Some(data)) => {
      r.buf = r.buf[r.off..] + data
      r.off = 0
      true
    }
    Ok(None) | Err(_) => {
      r.eof = true
      false
    }
  }
}

/// One header line without its line end, or None at the end of input.
fn (var r: Reader) line(os: Os) -> Str? uses stdio {
  while {
    var i = r.off
    while i < r.buf.len() {
      if r.buf[i] == '\n' {
        var end = i
        if end > r.off && r.buf[end - 1] == '\r' {
          end -= 1
        }
        let l = r.buf[r.off..end].to_str() ?? ""
        r.off = i + 1
        return Some(l)
      }
      i += 1
    }
    if !r.fill(os) {
      return None
    }
  }
  None
}

/// readMessage: the body of the next message; Ok(None) at the end of
/// input, Err with the error that ends the server.
fn (var r: Reader) message(os: Os) -> Str? ! Str uses stdio {
  var length = ""
  var have = false
  var any = false
  while {
    match r.line(os) {
      None => {
        if any {
          return Err("unexpected EOF")
        }
        return Ok(None)
      }
      Some(l) => {
        if l.is_empty() {
          if !any {
            // textproto skips nothing: an empty first line ends an empty header
          }
          break
        }
        any = true
        match l.find(":") {
          Some(i) => {
            if l[..i].to_lower() == "content-length" && !have {
              length = l[i + 1..].trim()
              have = true
            }
          }
          None => return Err("malformed MIME header line: ${l}")
        }
      }
    }
  }
  let n = Int.parse(length) ?? -1
  if n < 0 {
    return Err("missing or bad Content-Length header")
  }
  while r.buf.len() - r.off < n {
    if !r.fill(os) {
      if r.buf.len() - r.off == 0 {
        return Ok(None)
      }
      return Err("unexpected EOF")
    }
  }
  let body = r.buf[r.off..r.off + n]
  r.off += n
  Ok(Some(body.to_str() ?? ""))
}

fn send(os: Os, msg: J) uses stdio {
  let body = encode(msg, true)
  let _ = os.stdio.write(("Content-Length: ${body.len()}\r\n\r\n" + body).bytes()).ignore_err("the client may be gone")
}

fn reply(os: Os, id: Str, result: J) uses stdio {
  send(os, jobj(["jsonrpc", "id", "result"], [jstr("2.0"), J.Raw(id), result]))
}

fn reply_error(os: Os, id: Str, code: Int, msg: Str) uses stdio {
  send(os, jobj(["jsonrpc", "id", "error"], [jstr("2.0"), J.Raw(id), jobj(["code", "message"], [jint(code), jstr(msg)])]))
}

fn notify(os: Os, method: Str, params: J) uses stdio {
  send(os, jobj(["jsonrpc", "method", "params"], [jstr("2.0"), jstr(method), params]))
}

// ---------------------------------------------------------------------------
// the session

/// A diagnostic of the last check, by absolute path.
struct LDiag {
  d: check.Diag
}

struct Session {
  version: Str
  std_dir: Str
  wd: Str
  /// the module directories an agent session left out of its check of a
  /// root (their `use go` or `use c` binding is missing, or a module they
  /// require is not in the module cache)
  skipped: List[Str] = []
  /// the `testdata` directories an agent session's check of a root left
  /// out (`--testdata` walks them)
  testdata_skipped: List[Str] = []
  /// the module roots left out because another module under the root has
  /// their module path (root, path, the root kept)
  same_path: List[(Str, Str, Str)] = []
  /// open documents: absolute path to text
  docs: Map[Str, Bytes] = {}
  dirty: Bool = true
  checked: Bool = false
  /// the files of the last check: absolute path to source
  files: Map[Str, Bytes] = {}
  diags: Map[Str, List[check.Diag]] = {}
  published: List[Str] = []
  err: Str = ""
  /// why the last check stopped before resolving names (Checker.unsupported:
  /// a `use go` or `use c` binding that is missing, or a module the program
  /// requires that is not in the module cache); a headless session reports
  /// it rather than let a caller read the standard library's references as
  /// the program's own (agent.xo, `xo dev edges`)
  stopped: Str = ""
  /// the generation of the last change; a debounce wake of an older one
  /// does nothing
  gen: Int = 0
  /// where std sources are copied for a definition in std (StdDir)
  lsp_std: Str = ""
  /// the last check that ran (zero or one): its resolution tables, the
  /// identifiers of its files (by file index), and the file index of each
  /// snapshot key (a std file's std path, else its absolute path)
  res: List[Res] = []
  sites: Map[Int, List[Site]] = {}
  keys: Map[Str, Int] = {}
  /// a headless session (agent.xo's commands): no notifications written
  quiet: Bool = false
  /// std and runtime modules to load with the program (agent.xo: those
  /// the looked up name refers to, semantic.preloads_for)
  preload: List[Str] = []
  /// agent.xo's def, doc and symbols by name: no body checked
  /// (Checker.decls_only)
  decls_only: Bool = false
  /// the texts the published diagnostics' positions are in
  dfiles: Map[Str, Bytes] = {}
  /// `xo lsp` (run_lsp) checks each open directory on its own, in a
  /// worker task, and keeps each one's last check: the views by key (an
  /// open directory, or ALL for references and rename), and the
  /// generation of the last change each directory's check must include
  views: Map[Str, View] = {}
  need: Map[Str, Int] = {}
  /// the requests waiting for a check
  waiting: List[Waiting] = []
  /// a check is running in the worker: its key
  busy: Str = ""
  /// the debounce passed since the last change: stale directories are
  /// checked without a request asking
  auto: Bool = true
  /// the patched checks of completion and signatureHelp the worker ran
  pre: List[Pre] = []
}

fn abs_of(wd: Str, p: Str) -> Str {
  if p.starts_with("/") { clean_path(p) } else { clean_path(wd + "/" + p) }
}

fn dir_of(p: Str) -> Str {
  let parts = p.split("/")
  if parts.len() <= 1 {
    return "."
  }
  let d = parts[0..parts.len() - 1].join("/")
  if d.is_empty() { "/" } else { d }
}

/// The std directory the checker reads: $XO_STD, else lib/xo/std of a
/// release layout beside the binary Env.program names (check.std_dir).
pub fn std_dir(os: Os) -> Str uses (env, fs) {
  check.std_dir(os.env, os.fs)
}

/// The result of one check: what Session.res, keys, files, and diags hold
/// for the requests it answers.
struct View {
  /// the generation of the documents it checked
  gen: Int = -1
  err: Str = ""
  files: Map[Str, Bytes] = {}
  diags: Map[Str, List[check.Diag]] = {}
  res: List[Res] = []
  keys: Map[Str, Int] = {}
  sites: Map[Int, List[Site]] = {}
  /// the directories of the user files it read (the open directory and
  /// the local modules it imports)
  deps: Set[Str] = #{}
  /// why the check stopped before resolving names (Checker.unsupported),
  /// and the module directories of the missing bindings behind it
  stopped: Str = ""
  stopped_dirs: List[Str] = []
  /// the `testdata` directories the walk of a root left out
  testdata_skipped: List[Str] = []
  /// the module roots the walk left out for their module path, as
  /// Checker.same_path
  same_path: List[(Str, Str, Str)] = []
}

/// The open documents to check, without std copies (a std source opened
/// through a definition is served from the std module, never checked as
/// user code).
fn (s: Session) overlay() -> Map[Str, Bytes] {
  var out: Map[Str, Bytes] = {}
  for (p, src) in s.docs {
    if !s.is_std_copy(p) {
      out[p] = src
    }
  }
  out
}

/// The directories of the documents of overlay, sorted.
fn dirs_of(overlay: Map[Str, Bytes]) -> List[Str] {
  var dirs: List[Str] = []
  for (p, _) in overlay {
    let d = dir_of(p)
    if !dirs.contains(d) {
      dirs.push(d)
    }
  }
  dirs.sort()
}

fn new_lsp_checker(os: Os, std_dir: Str, wd: Str, overlay: Map[Str, Bytes]) -> check.Checker uses (fs, env) {
  var c = check.new_checker(os.fs, std_dir)
  c.overlay = overlay
  c.set_mod_env(wd, os.env.get("XO_MODCACHE") ?? "", os.env.get("HOME") ?? "", os.env.get("XDG_CACHE_HOME") ?? "", os.env.get("XO_OFFLINE") ?? "", os.env.get("XO_WORK") ?? "")
  // the editor's and the agent tools' checks cover the modules below a
  // workspace or repository root (decision 0289), within the walk's
  // bound (decision 0345)
  c.walk_all = true
  // one module a module path, the others named (same_path)
  c.split_same_path = true
  c
}

/// check_view: checks the modules of dirs with the open texts as the
/// overlay. It reads no Session, so the server's worker task runs it.
fn check_view(os: Os, std_dir: Str, wd: Str, overlay: Map[Str, Bytes], dirs: List[Str], preload: List[Str]) -> View uses (fs, env) {
  check_view_excluding(os, std_dir, wd, overlay, dirs, preload, [], false, [], false)
}

/// check_view, leaving out the module directories exclude; testdata
/// walks the `testdata` directories too.
fn check_view_excluding(os: Os, std_dir: Str, wd: Str, overlay: Map[Str, Bytes], dirs: List[Str], preload: List[Str], exclude: List[Str], testdata: Bool, words: List[Str], decls_only: Bool) -> View uses (fs, env) {
  var v = View{}
  if dirs.is_empty() {
    return v
  }
  var c = new_lsp_checker(os, std_dir, wd, overlay)
  c.preload = preload
  // the preloaded std and runtime modules a name refers to: their bodies
  // too, so that xo refs finds the calls inside them
  c.check_bodies_of = if decls_only { [] } else { preload }
  c.runtime_files = true
  c.exclude_dirs = exclude
  c.walk_testdata = testdata
  c.testdata_words = words
  // refs: bodies that spell none of the names stay unparsed
  c.body_words = words
  // def, doc, symbols: no body
  c.decls_only = decls_only
  match c.check_dirs(dirs) {
    Ok(_) => {}
    Err(e) => {
      v.err = e
      return v
    }
  }
  for (i, f) in c.files.indexed() {
    let std = f.module >= 0 && c.mods[f.module].is_std
    let p = if std { f.path } else { abs_of(wd, f.path) }
    if !v.keys.contains(p) {
      v.keys[p] = i
    }
    v.files[p] = overlay.get(p) ?? f.src
    if !std {
      v.deps.add(dir_of(p))
    }
  }
  v.res = [new_res(c)]
  v.testdata_skipped = c.testdata_skipped
  v.same_path = c.same_path
  v.stopped = c.unsupported
  for d in c.fetch_dirs {
    if !v.stopped_dirs.contains(d) {
      v.stopped_dirs.push(d)
    }
  }
  for bm in c.bind_misses {
    let d = if !bm.mod_dir.is_empty() { bm.mod_dir } else { bm.root }
    if !d.is_empty() && !v.stopped_dirs.contains(d) {
      v.stopped_dirs.push(d)
    }
  }
  for d in c.diags {
    v.diags.update(abs_of(wd, d.file), [], fn(var l) { l.push(d) })
  }
  v
}

/// use_view: answer requests from v.
fn (var s: Session) use_view(v: View) {
  s.dirty = false
  s.checked = true
  s.err = v.err
  s.stopped = v.stopped
  s.files = v.files
  s.res = v.res
  s.keys = v.keys
  s.sites = v.sites
}

/// recheck: checks the modules of the open documents and publishes their
/// diagnostics.
fn (var s: Session) recheck(os: Os) uses (stdio, fs, env) {
  let overlay = s.overlay()
  let v = check_view_excluding(os, s.std_dir, s.wd, overlay, dirs_of(overlay), s.preload, [], false, [], s.decls_only)
  s.use_view(v)
  s.diags = v.diags
  s.dfiles = v.files
  if !v.err.is_empty() && !s.quiet {
    notify(os, "window/logMessage", jobj(["message", "type"], [jstr("xo: ${v.err}"), jint(2)]))
  }
  s.publish(os)
}

fn (s: Session) text_of(p: Str) -> Text? {
  match s.files.get(p) {
    Some(src) => Some(new_text(src))
    None => {
      // a std copy: the std file's text (snapshot.file)
      let k = std_key(s.lsp_std, p)
      if k.is_empty() {
        return None
      }
      match s.files.get(k) {
        Some(src) => Some(new_text(src))
        None => None
      }
    }
  }
}

fn diag_range(d: check.Diag, t: Text) -> J {
  let start = t.position(d.line, d.col)
  let end = if d.end_line > 0 { t.position(d.end_line, d.end_col) } else { start }
  range_json(start, end)
}

/// toLSP.
fn to_lsp(d: check.Diag, t: Text) -> J {
  let sev = if d.note_sev { 3 } else if d.warning { 2 } else { 1 }
  var msg = d.message
  for n in d.notes {
    msg = msg + "\nnote: " + n.message
  }
  var keys = ["range", "severity"]
  var vals = [diag_range(d, t), jint(sev)]
  if !d.code.is_empty() {
    keys.push("code")
    vals.push(jstr(d.code))
  }
  keys = keys + ["source", "message"]
  vals = vals + [jstr("xo"), jstr(msg)]
  jobj(keys, vals)
}

fn (var s: Session) publish(os: Os) uses (stdio, fs) {
  if s.quiet {
    return
  }
  var all: List[Str] = []
  for (p, _) in s.docs {
    all.push(p)
  }
  for (p, _) in s.diags {
    if !all.contains(p) {
      all.push(p)
    }
  }
  var now: List[Str] = []
  for p in all.sort() {
    let t = match s.dfiles.get(p) {
      Some(src) => new_text(src)
      None => match s.text_of(p) {
        Some(t) => t
        None => match os.fs.read(p) {
          Ok(src) => new_text(src)
          Err(_) => continue
        }
      }
    }
    var out: List[J] = []
    for d in s.diags.get(p) ?? [] {
      out.push(to_lsp(d, t))
    }
    now.push(p)
    notify(os, "textDocument/publishDiagnostics", jobj(["uri", "diagnostics"], [jstr(path_to_uri(p)), jarr(out)]))
  }
  for p in s.published {
    if !now.contains(p) {
      notify(os, "textDocument/publishDiagnostics", jobj(["uri", "diagnostics"], [jstr(path_to_uri(p)), jarr([])]))
    }
  }
  s.published = now
}

fn (var s: Session) fresh(os: Os) uses (stdio, fs, env) {
  if s.dirty || !s.checked {
    s.recheck(os)
  }
}

fn int_of(v: J?) -> Int {
  match v {
    Some(J.Num(t)) => Int.parse(t) ?? 0
    _ => 0
  }
}

fn pos_of(v: J?) -> (Int, Int) {
  let p = v ?? J.Null
  (int_of(get(p, "line")), int_of(get(p, "character")))
}

fn uri_of(params: J) -> Str {
  match get(get(params, "textDocument") ?? J.Null, "uri") {
    Some(J.Str(u)) => u
    _ => ""
  }
}

/// The open directories: those of the open documents, std copies aside.
fn (s: Session) groups() -> List[Str] { dirs_of(s.overlay()) }

/// changed: a document of directory d changed. Every open directory whose
/// check read d needs a new one.
fn (var s: Session) changed(d: Str) {
  s.dirty = true
  s.gen += 1
  for g in s.groups() {
    let reads = match s.views.get(g) {
      Some(v) => v.deps.contains(d)
      None => false
    }
    if g == d || reads {
      s.need[g] = s.gen
    }
  }
}

/// A notification: documents opened, changed, closed, or saved. It
/// returns when the checks it calls for start: "now", "later" (after the
/// debounce), or "" (none).
fn (var s: Session) notification(os: Os, method: Str, params: J) -> Str {
  if method == "textDocument/didOpen" {
    let td = get(params, "textDocument") ?? J.Null
    let path = uri_to_path(jstr_of(td, "uri"))
    if !path.is_empty() {
      s.docs[path] = jstr_of(td, "text").bytes()
      s.changed(dir_of(path))
      return "now"
    }
  } else if method == "textDocument/didChange" {
    let path = uri_to_path(uri_of(params))
    var src = match s.docs.get(path) {
      Some(b) => b
      None => return ""
    }
    match get(params, "contentChanges") {
      Some(J.Arr(changes, _)) => {
        for ch in changes {
          let text = jstr_of(ch, "text")
          match get(ch, "range") {
            Some(J.Obj(_, _, _)) => {
              let r = get(ch, "range") ?? J.Null
              let t = new_text(src)
              let (sl, sc) = pos_of(get(r, "start"))
              let (el, ec) = pos_of(get(r, "end"))
              let a = t.offset(sl, sc)
              let b = t.offset(el, ec)
              src = src[0..a] + text.bytes() + src[b..src.len()]
            }
            _ => src = text.bytes()
          }
        }
      }
      _ => {}
    }
    s.docs[path] = src
    s.changed(dir_of(path))
    return "later"
  } else if method == "textDocument/didClose" {
    let path = uri_to_path(uri_of(params))
    s.docs.remove(path)
    let d = dir_of(path)
    if !s.groups().contains(d) {
      s.views.remove(d)
      s.need.remove(d)
    }
    // the file is read from disk again
    s.changed(d)
    return "now"
  } else if method == "workspace/didChangeWatchedFiles" {
    // a file on disk changed: any check may have read it
    s.dirty = true
    s.gen += 1
    for g in s.groups() {
      s.need[g] = s.gen
    }
    return "now"
  }
  // didSave: the check already has the saved text
  ""
}

/// The quick fixes of the diagnostics that overlap the range.
fn (var s: Session) code_actions(os: Os, params: J) -> J uses (stdio, fs, env) {
  s.fresh(os)
  let path = uri_to_path(uri_of(params))
  let t = match s.text_of(path) {
    Some(t) => t
    None => return jarr([])
  }
  let r = get(params, "range") ?? J.Null
  let rs = pos_of(get(r, "start"))
  let re = pos_of(get(r, "end"))
  var out: List[J] = []
  for d in s.diags.get(path) ?? [] {
    let ld = to_lsp(d, t)
    let start = d.line
    let ds = t.position(d.line, d.col)
    let de = if d.end_line > 0 { t.position(d.end_line, d.end_col) } else { ds }
    if less(de, rs) || less(re, ds) {
      continue
    }
    let _ = start
    for (i, fx) in d.fixes.indexed() {
      var uris: List[Str] = []
      var edits: Map[Str, List[J]] = {}
      for e in fx.edits {
        let ep = abs_of(s.wd, e.span.file)
        let et = if ep == path { Some(t) } else { s.text_of(ep) }
        match et {
          Some(tt) => {
            let a = tt.position(e.span.line, e.span.col)
            let b = if e.span.end_line > 0 { tt.position(e.span.end_line, e.span.end_col) } else { a }
            let u = path_to_uri(ep)
            if !uris.contains(u) {
              uris.push(u)
            }
            var l = edits.get(u) ?? []
            l.push(jobj(["range", "newText"], [range_json(a, b), jstr(e.replace)]))
            edits[u] = l
          }
          None => {}
        }
      }
      var ck: List[Str] = []
      var cv: List[J] = []
      for u in uris.sort() {
        ck.push(u)
        cv.push(jarr(edits.get(u) ?? []))
      }
      var keys = ["title", "kind", "diagnostics"]
      var vals = [jstr(fx.title), jstr("quickfix"), jarr([ld])]
      if i == 0 && d.fixes.len() == 1 {
        keys.push("isPreferred")
        vals.push(jbool(true))
      }
      keys.push("edit")
      vals.push(jobj(["changes"], [jobj(ck, cv)]))
      out.push(jobj(keys, vals))
    }
  }
  jarr(out)
}

fn less(a: (Int, Int), b: (Int, Int)) -> Bool {
  let (al, ac) = a
  let (bl, bc) = b
  al < bl || (al == bl && ac < bc)
}

// ---------------------------------------------------------------------------
// document symbols (internal/lsp features.go symbols)

fn span_range(t: Text, sp: parser.Span) -> J { range_json(t.offset_position(sp.start.offset), t.offset_position(sp.end.offset)) }

fn sym(t: Text, name: Str, sel: parser.Span, whole: parser.Span, kind: Int, detail: Str, children: List[J]) -> J {
  var keys = ["name"]
  var vals = [jstr(name)]
  if !detail.is_empty() {
    keys.push("detail")
    vals.push(jstr(detail))
  }
  keys = keys + ["kind", "range", "selectionRange"]
  vals = vals + [jint(kind), span_range(t, whole), span_range(t, sel)]
  if !children.is_empty() {
    keys.push("children")
    vals.push(jarr(children))
  }
  jobj(keys, vals)
}

fn ident_text(id: parser.Ident) -> Str { id.name.to_str() ?? "" }

fn (s: Session) symbols(params: J) -> J {
  let path = uri_to_path(uri_of(params))
  let src = match s.docs.get(path) {
    Some(b) => b
    None => return jarr([])
  }
  let pr = parser.parse_file(path.bytes(), src, false)
  let t = new_text(src)
  var out: List[J] = []
  for d in pr.file.decls {
    match d {
      parser.Decl.FnDecl(x) => {
        let name = ident_text(x.name)
        if name.is_empty() {
          continue
        }
        var kind = 12
        var full = name
        match x.recv {
          Some(r) => {
            kind = 6
            match r.typ {
              parser.Type.NamedType(_, path, _) => {
                if !path.is_empty() {
                  full = ident_text(path[path.len() - 1]) + "." + name
                }
              }
              _ => {}
            }
          }
          None => {}
        }
        out.push(sym(t, full, x.name.span, x.span, kind, "", []))
      }
      parser.Decl.StructDecl(x) => {
        var ch: List[J] = []
        for f in x.fields {
          ch.push(sym(t, ident_text(f.name), f.name.span, f.span, 7, "", []))
        }
        out.push(sym(t, ident_text(x.name), x.name.span, x.span, 23, "", ch))
      }
      parser.Decl.EnumDecl(x) => {
        var ch: List[J] = []
        for v in x.variants {
          ch.push(sym(t, ident_text(v.name), v.name.span, v.span, 22, "", []))
        }
        out.push(sym(t, ident_text(x.name), x.name.span, x.span, 10, "", ch))
      }
      parser.Decl.InterfaceDecl(x) => {
        var ch: List[J] = []
        for m in x.methods {
          ch.push(sym(t, ident_text(m.name), m.name.span, m.span, 6, "", []))
        }
        out.push(sym(t, ident_text(x.name), x.name.span, x.span, 11, "", ch))
      }
      parser.Decl.TypeDecl(x) => {
        out.push(sym(t, ident_text(x.name), x.name.span, x.span, 5, if x.newtype { "newtype" } else { "alias" }, []))
      }
      parser.Decl.ConstDecl(x) => {
        out.push(sym(t, ident_text(x.name), x.name.span, x.span, 14, "", []))
      }
      parser.Decl.TestDecl(x) => {
        match x.name {
          Some(n) => {
            let raw = src[n.span.start.offset..n.span.end.offset].to_str() ?? ""
            out.push(sym(t, "test " + raw.trim_prefix("\"").trim_suffix("\""), n.span, x.span, 12, "", []))
          }
          None => {}
        }
      }
      parser.Decl.BadDecl(_) => {}
    }
  }
  jarr(out)
}

// ---------------------------------------------------------------------------
// requests

fn initialize_result(version: Str) -> J {
  var tt: List[J] = []
  for x in TOKEN_TYPES {
    tt.push(jstr(x))
  }
  var tm: List[J] = []
  for x in TOKEN_MODIFIERS {
    tm.push(jstr(x))
  }
  jobj(["capabilities", "serverInfo"], [
    jobj(["codeActionProvider", "completionProvider", "definitionProvider", "documentFormattingProvider", "documentSymbolProvider", "hoverProvider", "positionEncoding", "referencesProvider", "renameProvider", "semanticTokensProvider", "signatureHelpProvider", "textDocumentSync"], [
      jobj(["codeActionKinds"], [jarr([jstr("quickfix")])]),
      jobj(["triggerCharacters"], [jarr([jstr(".")])]),
      jbool(true),
      jbool(true),
      jbool(true),
      jbool(true),
      jstr("utf-16"),
      jbool(true),
      jobj(["prepareProvider"], [jbool(true)]),
      jobj(["full", "legend"], [jbool(true), jobj(["tokenModifiers", "tokenTypes"], [jarr(tm), jarr(tt)])]),
      jobj(["triggerCharacters"], [jarr([jstr("("), jstr(",")])]),
      jobj(["change", "openClose", "save"], [jint(2), jbool(true), jobj(["includeText"], [jbool(false)])]),
    ]),
    jobj(["name", "version"], [jstr("xo"), jstr(version)]),
  ])
}

/// A request: Ok(result) or Err((code, message)).
fn (var s: Session) request(os: Os, method: Str, params: J, has_params: Bool) -> J ! (Int, Str) uses (stdio, fs, env) {
  if method == "initialize" {
    return Ok(initialize_result(s.version))
  }
  if method == "shutdown" {
    return Ok(J.Null)
  }
  let reads = method is "textDocument/hover" | "textDocument/definition" | "textDocument/references" | "textDocument/prepareRename" | "textDocument/rename" | "textDocument/formatting" | "textDocument/codeAction" | "textDocument/documentSymbol" | "textDocument/semanticTokens/full" | "textDocument/completion" | "textDocument/signatureHelp"
  if !reads {
    return Err((-32601, "method not supported: ${method}"))
  }
  if !has_params {
    return Err((-32602, "unexpected end of JSON input"))
  }
  if method == "textDocument/codeAction" {
    return Ok(s.code_actions(os, params))
  }
  if method == "textDocument/documentSymbol" {
    return Ok(s.symbols(params))
  }
  let failed = fn(e: Str) -> (Int, Str) { (-32803, e) }
  match method {
    "textDocument/formatting" => Ok(s.formatting(params))
    "textDocument/semanticTokens/full" => Ok(s.semantic_tokens(os, params))
    "textDocument/completion" => Ok(s.completion(os, params))
    "textDocument/signatureHelp" => Ok(s.signature_help(os, params))
    "textDocument/hover" => s.hover(os, params).map_err(failed)
    "textDocument/definition" => s.definition(os, params).map_err(failed)
    "textDocument/references" => s.references(os, params).map_err(failed)
    "textDocument/prepareRename" => s.prepare_rename(os, params)
    "textDocument/rename" => s.rename(os, params)
    _ => Err((-32601, "method not supported: ${method}"))
  }
}

// ---------------------------------------------------------------------------
// the server's checks (run_lsp): each open directory is checked on its
// own, by a worker task, so the loop answers requests that need no check
// (formatting, documentSymbol) at once, and an edit rechecks only its
// directory and the open directories whose last check read it

/// The key of the check over every open directory (references, rename,
/// and requests in std copies).
const ALL = "*"

/// A request waiting for the check of key at generation gen or later.
struct Waiting {
  id: Str
  method: Str
  params: J
  key: Str
  gen: Int
}

/// A patched check (lsp_complete.xo check_patched): the resolution and
/// file index of path checked with text, if it checked.
struct Pre {
  path: Str
  text: Bytes
  res: List[(Res, Int)]
}

/// A check for the worker: the view of key, or (patched) path's Pre.
struct Job {
  key: Str
  gen: Int
  overlay: Map[Str, Bytes]
  dirs: List[Str]
  patched: Bool = false
  path: Str = ""
  text: Bytes = b""
}

/// The events of the server loop: a message, a debounce wake, a check's
/// result, or the end of input.
enum Ev {
  Msg(body: Str)
  Wake(gen: Int)
  Checked(key: Str, gen: Int, v: View)
  Patched(p: Pre)
  End(err: Str)
}

/// The check a request reads: "" for none, ALL, or its open directory.
fn (s: Session) check_key(method: Str, params: J, has_params: Bool) -> Str {
  let reads = method is "textDocument/hover" | "textDocument/definition" | "textDocument/references" | "textDocument/prepareRename" | "textDocument/rename" | "textDocument/codeAction" | "textDocument/semanticTokens/full" | "textDocument/completion" | "textDocument/signatureHelp"
  if !reads || !has_params {
    return ""
  }
  if method is "textDocument/references" | "textDocument/rename" {
    return ALL
  }
  let path = uri_to_path(uri_of(params))
  let d = dir_of(path)
  if s.is_std_copy(path) || !s.groups().contains(d) {
    return ALL
  }
  d
}

/// The generation a check of key must include.
fn (s: Session) need_of(key: Str) -> Int {
  if key == ALL { s.gen } else { s.need.get(key) ?? s.gen }
}

fn (s: Session) fresh_view(key: Str, gen: Int) -> Bool {
  match s.views.get(key) {
    Some(v) => v.gen >= gen
    None => false
  }
}

/// The patched text a completion or signatureHelp request checks, if any.
fn (s: Session) patch_for(w: Waiting) -> (Str, Bytes)? {
  let path = uri_to_path(uri_of(w.params))
  let src = match s.docs.get(path) {
    Some(b) => b
    None => return None
  }
  let p = if w.method == "textDocument/completion" { completion_patch(src, w.params) } else if w.method == "textDocument/signatureHelp" { signature_patch(src, w.params) } else { None }
  match p {
    Some(text) => Some((path, text))
    None => None
  }
}

fn (s: Session) has_patched(path: Str, text: Bytes) -> Bool {
  for p in s.pre {
    if p.path == path && p.text == text {
      return true
    }
  }
  false
}

/// The check a waiting request still needs, if any.
fn (s: Session) job_for(w: Waiting) -> Job? {
  match s.patch_for(w) {
    Some((path, text)) => {
      if s.has_patched(path, text) {
        return None
      }
      var ov = s.overlay()
      ov[path] = text
      return Some(Job{key: "", gen: s.gen, overlay: ov, dirs: [dir_of(path)], patched: true, path: path, text: text})
    }
    None => {}
  }
  if s.fresh_view(w.key, w.gen) {
    return None
  }
  let ov = s.overlay()
  Some(Job{key: w.key, gen: s.gen, overlay: ov, dirs: if w.key == ALL { dirs_of(ov) } else { [w.key] }})
}

/// answer: replies to w from its check.
fn (var s: Session) answer(os: Os, w: Waiting) uses (stdio, fs, env) {
  if let Some(v) = s.views.get(w.key) {
    s.use_view(v)
  }
  match s.request(os, w.method, w.params, true) {
    Ok(res) => reply(os, w.id, res)
    Err((c, msg)) => reply_error(os, w.id, c, msg)
  }
  // keep what the request cached (identifier sites, resolutions)
  if let Some(v0) = s.views.get(w.key) {
    var v = v0
    v.res = s.res
    v.sites = s.sites
    s.views[w.key] = v
  }
  match s.patch_for(w) {
    Some((path, _)) => {
      var keep: List[Pre] = []
      for p in s.pre {
        if p.path != path {
          keep.push(p)
        }
      }
      s.pre = keep
    }
    None => {}
  }
}

/// merge: the diagnostics of the open directories' checks, each file's
/// from its own directory's check when it is open, and publishes them.
fn (var s: Session) merge(os: Os) uses (stdio, fs) {
  let gs = s.groups()
  var diags: Map[Str, List[check.Diag]] = {}
  var files: Map[Str, Bytes] = {}
  for g in gs {
    if let Some(v) = s.views.get(g) {
      for (p, l) in v.diags {
        let own = dir_of(p)
        if own == g || (!gs.contains(own) && !diags.contains(p)) {
          diags[p] = l
          if let Some(src) = v.files.get(p) {
            files[p] = src
          }
        }
      }
    }
  }
  s.diags = diags
  s.dfiles = files
  s.publish(os)
}

/// pump: answers the waiting requests whose checks are done, then starts
/// the next check if the worker is idle: one a request waits for first,
/// then (after the debounce) a stale open directory's.
fn (var s: Session) pump(os: Os, jobs: Chan[Job]) uses (stdio, fs, env) {
  let ws = s.waiting
  s.waiting = []
  for w in ws {
    if s.job_for(w).is_none() {
      s.answer(os, w)
    } else {
      s.waiting.push(w)
    }
  }
  if !s.busy.is_empty() {
    return
  }
  for w in s.waiting {
    if let Some(j) = s.job_for(w) {
      s.busy = if j.patched { "patch" } else { j.key }
      jobs.send(j)
      return
    }
  }
  if !s.auto {
    return
  }
  for g in s.groups() {
    if !s.fresh_view(g, s.need_of(g)) {
      s.busy = g
      jobs.send(Job{key: g, gen: s.gen, overlay: s.overlay(), dirs: [g]})
      return
    }
  }
}

pub fn run_lsp(os: Os, ex: Exec, version: Str, args: List[Str]) -> Int uses (stdio, proc, env, fs, clock) {
  match parse_flags("lsp", lsp_flags(), args) {
    Ok(_) => {}
    Err(text) => {
      os.stdio.eprint(text)
      return 2
    }
  }
  let _ = ex
  let s0 = Session{version: version, std_dir: std_dir(os), wd: os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? "", lsp_std: lsp_std_dir(os)}
  let events: Chan[Ev] = Chan.new(16)
  let jobs: Chan[Job] = Chan.new(1)
  let fin: Chan[Int] = Chan.new(1)
  let std = s0.std_dir
  let wd = s0.wd
  scope sc {
    sc.spawn_background(fn() {
      for j in jobs {
        if j.patched {
          events.send(Ev.Patched(Pre{path: j.path, text: j.text, res: patched_check(os, std, wd, j.overlay, j.dirs, j.path)}))
        } else {
          events.send(Ev.Checked(key: j.key, gen: j.gen, v: check_view(os, std, wd, j.overlay, j.dirs, [])))
        }
      }
    })
    sc.spawn_background(fn() {
      var r = Reader{}
      while {
        match r.message(os) {
          Ok(Some(body)) => events.send(Ev.Msg(body))
          Ok(None) => {
            events.send(Ev.End(""))
            break
          }
          Err(e) => {
            events.send(Ev.End(e))
            break
          }
        }
      }
    })
    // the loop is a task of its own, and the body waits for it on a
    // channel, not with await: a task the root thread runs inline (main's
    // body, or a task its join claims) helps with other work while it is
    // parked, so its wake would wait for a check to end
    // (gotchas/root-inline-task-waits-for-helped-work.md)
    sc.spawn(fn() {
      var s = s0
      var code = 0
      while {
        let ev = match events.recv() {
          Some(e) => e
          None => break
        }
        match ev {
          Ev.End(e) => {
            if !e.is_empty() {
              os.stdio.eprintln("xo lsp: ${e}")
              code = 1
            }
            break
          }
          Ev.Wake(g) => {
            if g == s.gen {
              s.auto = true
              s.pump(os, jobs)
            }
          }
          Ev.Checked(key, gen, v0) => {
            s.busy = ""
            var v = v0
            v.gen = gen
            s.views[key] = v
            if key != ALL {
              if !v.err.is_empty() {
                notify(os, "window/logMessage", jobj(["message", "type"], [jstr("xo: ${v.err}"), jint(2)]))
              }
              s.merge(os)
            }
            s.pump(os, jobs)
          }
          Ev.Patched(p) => {
            s.busy = ""
            s.pre.push(p)
            s.pump(os, jobs)
          }
          Ev.Msg(body) => {
            let m = match parse(body) {
              Ok(m) => m
              Err(e) => {
                os.stdio.eprintln("xo lsp: bad message: ${e}")
                code = 1
                break
              }
            }
            let method = jstr_of(m, "method")
            if method == "exit" {
              break
            }
            let id = match get(m, "id") {
              None | Some(J.Null) => ""
              Some(_) => get_raw(m, "id") ?? ""
            }
            let params = get(m, "params") ?? J.Null
            if id.is_empty() {
              let start = s.notification(os, method, params)
              if start == "now" {
                s.auto = true
                if method != "textDocument/didOpen" {
                  // a closed document's diagnostics go
                  s.merge(os)
                }
                s.pump(os, jobs)
              } else if start == "later" {
                s.auto = false
                let g = s.gen
                sc.spawn_background(fn() {
                  os.clock.sleep(150ms)
                  events.send(Ev.Wake(g))
                })
                s.pump(os, jobs)
              }
              continue
            }
            let has_params = get(m, "params").is_some()
            let key = s.check_key(method, params, has_params)
            if !key.is_empty() {
              s.waiting.push(Waiting{id: id, method: method, params: params, key: key, gen: s.need_of(key)})
              s.pump(os, jobs)
              continue
            }
            match s.request(os, method, params, has_params) {
              Ok(res) => reply(os, id, res)
              Err((c, msg)) => reply_error(os, id, c, msg)
            }
          }
        }
      }
      fin.send(code)
    })
    fin.recv() ?? 1
  }
}
