// `xo def`, `xo refs`, `xo type`, `xo doc NAME`, and `xo symbols`
// (decision 0261 stage (a)): lookups for agents on `xo lsp`'s engine,
// stateless (the directory checked from disk on each run, as a headless
// Session) and JSON on standard output. A target is a position,
// FILE:LINE:COL (1 based, the column in bytes), or a name in any form code
// writes it, resolved as `xo query def` resolves it (decision 0289): NAME,
// Type.member, module.name, module.Type.member, an import's local name,
// a module path (std/tls.client), a prelude method (Str.find), or a std
// or runtime module the program does not import (tls.client,
// pool.park_wait); a bare member name (check_dirs) matches the members of
// the checked modules. Exit 0 with an answer, 1 when nothing matches or
// the program does not check, 2 on a usage error.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/cli/semantic
use github.com/xo-lang/xo/compiler/hostpath
use github.com/xo-lang/xo/compiler/parser

/// Whether args (the command line after `xo`) is one of these commands:
/// `xo doc` is one only with a name that is not a directory or an import
/// path (`xo doc MODULE` stays core's).
pub fn is_agent_command(os: Os, args: List[Str]) -> Bool uses fs {
  if args.is_empty() {
    return false
  }
  if args[0] is "def" | "refs" | "type" | "symbols" {
    return true
  }
  if args[0] != "doc" {
    return false
  }
  var name = ""
  for a in args[1..] {
    if !a.starts_with("-") {
      name = a
    }
  }
  if name.is_empty() || name == "." {
    return false
  }
  // a module path names a module (`xo doc std/tls`) unless its last
  // segment names a declaration in it (`xo doc std/tls.client`)
  if name.contains("/") {
    let segs = name.split("/")
    if !segs[segs.len() - 1].contains(".") {
      return false
    }
  }
  match os.fs.stat(name) {
    Ok(Some(_)) => false
    _ => true
  }
}

/// A command's arguments: the target, --dir, and the output form (text,
/// or --json; decision 0386: text everywhere by default, where 0289 gave
/// JSON whenever standard output was not a terminal).
struct AgentArgs {
  target: Str
  dir: Str
  /// --dir given (an explicit directory is never replaced by std)
  dir_set: Bool = false
  all: Bool
  json: Bool = false
  text: Bool = false
  /// symbols: pub declarations only
  pub_only: Bool = false
  /// symbols: one file's declarations (`--file=PATH`, or a .xo target)
  file: Str = ""
  /// symbols: one module's, by import path (`--module=std/json`)
  module: Str = ""
  /// a root's check walks its `testdata` directories too
  testdata: Bool = false
  /// refs: the names after the first (`xo refs A B C`), answered from
  /// one check
  more: List[Str] = []
  /// symbols and refs: at most this many records (--limit=N; 0: all)
  limit: Int = 0
  /// symbols: the doc comments too (--doc)
  docs: Bool = false
}

fn agent_args(cmd: Str, args: List[Str]) -> AgentArgs ! Str {
  var a = AgentArgs{target: "", dir: ".", all: false}
  for x in args {
    if x.starts_with("--dir=") {
      a.dir = x.trim_prefix("--dir=")
      a.dir_set = true
    } else if x == "--all" {
      // the default since decision 0289; kept for old command lines
      a.all = true
    } else if x == "--pub" {
      a.pub_only = true
    } else if x == "--testdata" && cmd != "type" {
      a.testdata = true
    } else if x.starts_with("--file=") && cmd == "symbols" {
      a.file = x.trim_prefix("--file=")
    } else if x.starts_with("--module=") && cmd == "symbols" {
      a.module = x.trim_prefix("--module=")
    } else if x.starts_with("--limit=") && cmd is "symbols" | "refs" {
      a.limit = Int.parse(x.trim_prefix("--limit=")) ?? -1
      if a.limit < 0 {
        return Err("xo ${cmd}: --limit takes a count, not ${x.trim_prefix("--limit=")}")
      }
    } else if x == "--doc" && cmd == "symbols" {
      a.docs = true
    } else if x is "--json" | "-json" {
      a.json = true
      a.text = false
    } else if x is "--text" | "-text" {
      a.text = true
      a.json = false
    } else if x.starts_with("-") {
      return Err("xo ${cmd}: unknown flag ${x}")
    } else if a.target.is_empty() {
      a.target = x
    } else if cmd == "refs" {
      a.more.push(x)
    } else {
      return Err("xo ${cmd}: one target only (got ${a.target} and ${x})")
    }
  }
  if cmd == "symbols" && a.target.ends_with(".xo") && a.file.is_empty() {
    // `xo symbols FILE.xo`: that file's declarations
    a.file = a.target
    a.target = ""
  }
  if cmd == "symbols" && !a.file.is_empty() && !a.module.is_empty() {
    return Err("xo symbols: --file or --module, not both")
  }
  if !a.more.is_empty() && ([a.target] + a.more).any(fn(t) { position_of(t).is_some() }) {
    return Err("xo refs: several targets are names only, not FILE:LINE:COL positions")
  }
  if a.target.is_empty() && cmd != "symbols" {
    return Err("xo ${cmd}: no ${if cmd == "type" { "FILE:LINE:COL" } else { "NAME" }}")
  }
  Ok(a)
}

/// Runs `xo CMD ARGS`: the exit status.
pub fn run_agent(os: Os, cmd: Str, args: List[Str]) -> Int uses (stdio, fs, env) {
  // -h and --help as every command takes them: the usage on standard
  // output; a usage error prints it on standard error
  if args.any(fn(x) { cmdhelp.is_help_flag(x) }) {
    os.stdio.print(cmdhelp.usage(cmd))
    return 0
  }
  let a = match agent_args(cmd, args) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprint("${e}\n${cmdhelp.usage(cmd)}")
      return 2
    }
  }
  var dir = a.dir
  // symbols' argument: a directory (as before), else a name pattern
  // (`xo symbols --dir=D NAME`, `*` matches any run; decision 0386)
  var pattern = ""
  if cmd == "symbols" && !a.target.is_empty() {
    match os.fs.stat(a.target) {
      Ok(Some(fi)) if fi.is_dir => dir = a.target
      _ => pattern = a.target
    }
  }
  let cwd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  if cmd == "symbols" && !a.file.is_empty() {
    // the file is checked with its directory
    dir = dir_of(abs_of(cwd, a.file))
  }
  // a position's file is checked with its directory
  if let Some((file, _, _)) = position_of(a.target) {
    dir = dir_of(abs_of(os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? "", file))
  }
  // the std and runtime modules a name refers to load with the program
  var preload = if a.target.is_empty() || position_of(a.target).is_some() { [] } else if cmd == "refs" { semantic.preloads_wide(os, std_dir(os), a.target) } else { semantic.preloads_for(os, std_dir(os), a.target) }
  // refs over std itself (--dir=std or std/native): the runtime files
  // that spell a name looked for, which no module checked there may
  // import (pg.xo, imported by native/sql only; 2026-10-30)
  if cmd == "refs" && position_of(a.target).is_none() {
    let sd = std_dir(os).trim_suffix("/")
    let ad = abs_of(cwd, dir).trim_suffix("/")
    if ad == sd || ad == "${sd}/native" {
      for p in semantic.runtime_spelling(os, sd, [a.target] + a.more) {
        if !preload.contains(p) {
          preload.push(p)
        }
      }
    }
  }
  // several names: every one's modules, loaded and checked once
  for t in a.more {
    for p in semantic.preloads_wide(os, std_dir(os), t) {
      if !preload.contains(p) {
        preload.push(p)
      }
    }
  }
  if cmd == "symbols" && (a.module.starts_with("std/") || a.module.starts_with("native/")) {
    // a std or runtime module loads with the program
    preload = [a.module]
  }
  // text unless --json (decision 0386)
  let as_json = a.json
  // refs of names: a module under a root whose text spells none of the
  // names' last segments cannot refer to them, so it is not checked (the
  // declaring module spells its name; 2026-10-26: --testdata at the xo
  // root checked every module, 5 to 12 s and 6 GB)
  // and a function body that spells none of them is not parsed or
  // checked either (Checker.body_words; trim_prefix at the xo root with
  // --testdata, 5.8 GB to 1.0 GB). XO_REFS_SPELL=off checks every module
  // and body (the comparison in cmd/xo's
  // TestAgentRefsSpellFilter); XO_LOOKUP_EAGER=1 checks every module and
  // body for every lookup (TestAgentLookupsEager)
  let eager = (os.env.get("XO_LOOKUP_EAGER") ?? "") == "1"
  var words: List[Str] = []
  if cmd == "refs" && !eager && (os.env.get("XO_REFS_SPELL") ?? "") != "off" {
    for t in [a.target] + a.more {
      if position_of(t).is_none() {
        let segs = t.split("/")
        let ds = segs[segs.len() - 1].split(".")
        words.push(ds[ds.len() - 1])
      }
    }
    if a.target.is_empty() || words.any(fn(w) { w.is_empty() }) || words.len() < 1 + a.more.len() {
      words = []
    }
  }
  // def, doc and symbols read declarations only: no body is parsed or
  // checked (a position's lookup reads its body)
  let decls_only = (cmd is "def" | "doc" | "symbols") && position_of(a.target).is_none() && !eager
  var s = match agent_session(os, dir, preload, a.testdata, words, decls_only) {
    Ok(x) => x
    Err(e) => {
      // `xo doc NAME` or `xo def NAME` run outside a module (a scratch or
      // home directory over the walk bound, or one with no .xo file):
      // a std or prelude name is answered from std alone
      let fb = if (cmd is "doc" | "def") && !a.dir_set { std_session(os, preload, decls_only) } else { None }
      match fb {
        Some(x) => {
          os.stdio.eprintln("xo ${cmd}: the working directory was not checked (${e}); answering from std")
          x
        }
        None => return fail(os, cmd, as_json, e)
      }
    }
  }
  // several names: each one's answer or error, in order; exit 1 when one
  // failed
  var batch_failed = false
  let out = match cmd {
    "def" => s.agent_def(os, a.target, false)
    "doc" => s.agent_def(os, a.target, true)
    "refs" if !a.more.is_empty() => {
      var rs: List[J] = []
      for t in [a.target] + a.more {
        match s.agent_refs(os, t) {
          Ok(v) => rs.push(v)
          Err(e) => {
            batch_failed = true
            rs.push(jobj(["target", "error"], [jstr(t), jstr(e)]))
          }
        }
      }
      Ok(jobj(["results"], [jarr(rs)]))
    }
    "refs" => s.agent_refs(os, a.target)
    "type" => s.agent_type(os, a.target)
    _ => s.agent_symbols(os, dir, a.pub_only, if a.file.is_empty() { "" } else { abs_of(cwd, a.file) }, a.module)
  }
  // the modules left out of a root's check, named
  var shown: List[Str] = []
  for d in s.skipped {
    shown.push(d.trim_prefix("${s.wd.trim_suffix("/")}/"))
  }
  let skip_note = if shown.is_empty() { "" } else { "skipped (a missing use go or use c binding, or a module to fetch): ${shown[0..shown.len().min(5)].join(", ")}${if shown.len() > 5 { ", ... (${shown.len()} modules)" } else { "" }}" }
  // the references in a root's `testdata` directories (the program
  // goldens) are not looked for unless --testdata: name the directories,
  // relative to the root
  var td: List[Str] = []
  if cmd == "refs" {
    let root = abs_of(cwd, dir).trim_suffix("/")
    for d in s.testdata_skipped {
      td.push(abs_of(s.wd, d).trim_prefix("${root}/"))
    }
  }
  // the module roots left out for a module path another module under the
  // root has (Checker.same_path), relative to the root
  let rootp = abs_of(cwd, dir).trim_suffix("/")
  let rel = fn(d: Str) -> Str { abs_of(s.wd, d).trim_prefix("${rootp}/") }
  var same: List[J] = []
  var same_text: List[Str] = []
  for (d, mp, kept) in s.same_path {
    same.push(jobj(["dir", "path", "kept"], [jstr(rel(d)), jstr(mp), jstr(rel(kept))]))
    same_text.push("${rel(d)} (${mp}, the path of ${rel(kept)})")
  }
  match out {
    Ok(v0) => {
      var v = v0
      if !same.is_empty() {
        if let J.Obj(keys, vals, raws) = v {
          v = J.Obj(keys: keys + ["same_path"], vals: vals + [jarr(same)], raws: if raws.is_empty() { raws } else { raws + [""] })
        }
      }
      if !s.skipped.is_empty() {
        if let J.Obj(keys, vals, raws) = v {
          var items: List[J] = []
          for d in shown {
            items.push(jstr(d))
          }
          v = J.Obj(keys: keys + ["skipped"], vals: vals + [jarr(items)], raws: if raws.is_empty() { raws } else { raws + [""] })
        }
      }
      if !td.is_empty() {
        if let J.Obj(keys, vals, raws) = v {
          v = J.Obj(keys: keys + ["testdata_skipped"], vals: vals + [jarr(td.map(fn(d) { jstr(d) }))], raws: if raws.is_empty() { raws } else { raws + [""] })
        }
      }
      // --limit and symbols' pattern, in both forms
      let (v2, cut) = trim_answer(cmd, v, pattern, a.limit)
      v = v2
      if as_json {
        print_json(os, v)
      } else {
        os.stdio.print(agent_text(os, cmd, v, a.docs, cwd, s.std_dir))
        if !cut.is_empty() {
          os.stdio.println("note: ${cut}")
        }
        if !skip_note.is_empty() {
          os.stdio.println("note: ${skip_note}")
        }
        if !td.is_empty() {
          let more = if td.len() > 3 { ", ... (${td.len()} directories)" } else { "" }
          os.stdio.println("note: not checked: ${td[0..td.len().min(3)].join(", ")}${more}; --testdata checks them too")
        }
        if !same_text.is_empty() {
          os.stdio.println("note: not checked, another module under the root has its module path (check it with --dir=DIR): ${same_text.join("; ")}")
        }
      }
      if batch_failed { 1 } else { 0 }
    }
    Err(e) => fail(os, cmd, as_json, if skip_note.is_empty() { e } else { "${e} (${skip_note})" })
  }
}

/// JSON a record a line (encode_lines), so grep and head work on it.
fn print_json(os: Os, v: J) uses stdio { os.stdio.print(encode_lines(v)) }

/// Whether name matches pattern: `*` any run of characters, otherwise a
/// substring (symbols' NAME, decision 0386).
fn name_matches(name: Str, pat: Str) -> Bool {
  if pat.is_empty() {
    return true
  }
  if !pat.contains("*") {
    return name.contains(pat)
  }
  let parts = pat.split("*")
  var at = 0
  for (i, p) in parts.indexed() {
    if p.is_empty() {
      continue
    }
    if i == 0 {
      if !name.starts_with(p) {
        return false
      }
      at = p.len()
      continue
    }
    match name[at..].find(p) {
      Some(k) => at = at + k + p.len()
      None => return false
    }
  }
  pat.ends_with("*") || parts[parts.len() - 1].is_empty() || name.ends_with(parts[parts.len() - 1])
}

/// The answer with symbols' pattern and --limit applied, and a note of
/// what was cut ("" when nothing): the list keeps its key, and a cut
/// list gets "total" beside it.
fn trim_answer(cmd: Str, v: J, pattern: Str, limit: Int) -> (J, Str) {
  let key = match cmd {
    "symbols" => "symbols"
    "refs" => "references"
    _ => return (v, "")
  }
  let (keys, vals, raws) = match v {
    J.Obj(k, vs, r) => (k, vs, r)
    J.Null | J.Bool(_) | J.Num(_) | J.Str(_) | J.Arr(..) | J.Raw(_) => return (v, "")
  }
  let i = keys.index_of(key) ?? return (v, "")
  var items = items_of(v, key)
  if !pattern.is_empty() {
    items = items.filter(fn(d) { name_matches(jstr_of(d, "name"), pattern) })
  }
  let total = items.len()
  if limit > 0 && items.len() > limit {
    items = items[0..limit]
  }
  var nv = vals
  nv[i] = jarr(items)
  var nk = keys
  var nr = raws
  var note = ""
  if items.len() < total {
    nk = nk + ["total"]
    nv = nv + [J.Num(text: "${total}")]
    if !nr.is_empty() {
      nr = nr + [""]
    }
    note = "showing ${items.len()} of ${total} ${key} (--limit)"
  }
  (J.Obj(keys: nk, vals: nv, raws: nr), note)
}

/// An error: {"error": ...} on standard output as JSON, else a line on
/// standard error; exit status 1.
fn fail(os: Os, cmd: Str, as_json: Bool, e: Str) -> Int uses stdio {
  if as_json {
    print_json(os, jobj(["error"], [jstr(e)]))
  } else {
    os.stdio.eprintln("xo ${cmd}: ${e}")
  }
  1
}

fn items_of(v: J, key: Str) -> List[J] {
  match get(v, key) {
    Some(J.Arr(items, _)) => items
    _ => []
  }
}

/// d's place, `file:line:col`, or "" for none.
fn place(d: J) -> Str {
  let file = jstr_of(d, "file")
  if file.is_empty() { "" } else { "${file}:${int_of(get(d, "line"))}:${int_of(get(d, "col"))}" }
}

/// The first line of d's doc comment, or "".
fn doc_line(d: J) -> Str { jstr_of(d, "doc").trim().split("\n")[0] }

/// A declaration's text (decision 0386): `file:line:col: kind name`, the
/// doc (all of it with full, else its first line) as `///` lines, and the
/// signature.
fn decl_text(d: J, indent: Str, full: Bool) -> Str {
  var b = StrBuilder.new()
  let at = place(d)
  b.write("${indent}${if at.is_empty() { "" } else { "${at}: " }}${jstr_of(d, "kind")} ${jstr_of(d, "name")}\n")
  let doc = jstr_of(d, "doc").trim()
  if !doc.is_empty() {
    for l in if full { doc.split("\n") } else { [doc.split("\n")[0]] } {
      b.write("${indent}/// ${l}\n")
    }
  }
  let sig = jstr_of(d, "signature")
  if !sig.is_empty() {
    for l in sig.split("\n") {
      b.write("${indent}${l}\n")
    }
  }
  b.freeze()
}

/// The source line a reference is on, trimmed and cut to 120 bytes (its
/// context); "" when the file cannot be read. Files are read once.
fn ref_context(os: Os, var cache: Map[Str, List[Str]], file: Str, line: Int, cwd: Str, std_dir: Str) -> Str uses fs.read {
  if !cache.contains(file) {
    var text = ""
    // a std file's path is relative to std's parent (std/prelude.xo)
    for p in [abs_of(cwd, file), "${dir_of(std_dir.trim_suffix("/"))}/${file}"] {
      if let Ok(b) = os.fs.read(p) {
        text = b.to_str() ?? ""
        break
      }
    }
    cache[file] = text.split("\n")
  }
  let ls = cache.get(file) ?? []
  if line < 1 || line > ls.len() {
    return ""
  }
  let t = ls[line - 1].trim()
  if t.len() <= 120 {
    return t
  }
  var sb = StrBuilder.new()
  for r in t.runes() {
    if sb.len() >= 117 {
      break
    }
    sb.write("${r}")
  }
  "${sb.freeze()}..."
}

/// The text form of a command's answer (decision 0386): a record a line,
/// compact. symbols: `kind name  file:line  signature` (docs only with
/// --doc); refs: the declaration's line, then `file:line:col  context`
/// per reference; def: place, the doc's first line, the signature; doc:
/// the declaration with its whole doc, then a member a line.
fn agent_text(os: Os, cmd: Str, v: J, docs: Bool, cwd: Str, std_dir: Str) -> Str uses fs.read {
  var b = StrBuilder.new()
  match cmd {
    "def" | "doc" => {
      for (i, d) in items_of(v, "declarations").indexed() {
        if i > 0 {
          b.write("\n")
        }
        b.write(decl_text(d, "", cmd == "doc"))
        for m in items_of(d, "methods") {
          let sig = jstr_of(m, "signature").split("\n")[0]
          let dl = doc_line(m)
          b.write("  ${jstr_of(m, "name")}  ${sig}${if dl.is_empty() { "" } else { "  // ${dl}" }}\n")
        }
      }
    }
    "refs" if get(v, "results").is_some() => {
      // several names: each answer, a blank line between
      for (i, r) in items_of(v, "results").indexed() {
        if i > 0 {
          b.write("\n")
        }
        match get(r, "error") {
          Some(_) => b.write("xo refs: ${jstr_of(r, "target")}: ${jstr_of(r, "error")}\n")
          None => b.write(agent_text(os, "refs", r, docs, cwd, std_dir))
        }
      }
    }
    "refs" => {
      let d = get(v, "declaration") ?? J.Null
      b.write("declaration: ${place(d)} ${jstr_of(d, "kind")} ${jstr_of(d, "name")}\n")
      let refs = items_of(v, "references")
      var cache: Map[Str, List[Str]] = {}
      for r in refs {
        let decl = match get(r, "declaration") {
          Some(J.Bool(true)) => " (declaration)"
          _ => ""
        }
        let ctx = ref_context(os, cache, jstr_of(r, "file"), int_of(get(r, "line")), cwd, std_dir)
        b.write("${place(r)}${decl}  ${ctx}\n")
      }
      let total = int_of(get(v, "total"))
      b.write("${if total > refs.len() { total } else { refs.len() }} reference(s)\n")
    }
    "type" => b.write(decl_text(jobj(["kind", "name", "signature", "doc"], [get(v, "kind") ?? J.Null, get(v, "target") ?? J.Null, get(v, "signature") ?? J.Null, get(v, "doc") ?? J.Null]), "", true))
    _ => {
      for d in items_of(v, "symbols") {
        let sig = jstr_of(d, "signature").split("\n")[0]
        b.write("${jstr_of(d, "kind")} ${jstr_of(d, "name")}  ${jstr_of(d, "file")}:${int_of(get(d, "line"))}  ${sig}\n")
        if docs {
          let doc = jstr_of(d, "doc").trim()
          if !doc.is_empty() {
            for l in doc.split("\n") {
              b.write("  /// ${l}\n")
            }
          }
        }
      }
    }
  }
  b.freeze()
}

/// FILE:LINE:COL, when target is one.
fn position_of(target: Str) -> (Str, Int, Int)? {
  let parts = target.split(":")
  if parts.len() < 3 {
    return None
  }
  let n = parts.len()
  let line = Int.parse(parts[n - 2])?
  let col = Int.parse(parts[n - 1])?
  if line < 1 || col < 1 {
    return None
  }
  Some((parts[0..n - 2].join(":"), line, col))
}

/// The most .xo files, and directory entries looked at, under a --dir
/// that is not itself a module directory (the xo checkout has about
/// 1,800 .xo files).
const MAX_DIR_XO = check.MAX_WALK_XO
const MAX_DIR_ENTRIES = check.MAX_WALK_ENTRIES

/// Why dir d holds too much to check as one workspace, or None: a bounded
/// walk counting its .xo files and entries, and naming the first
/// directories when it is over.
fn too_wide(os: Os, d: Str) -> Str? uses fs.read {
  var stack = [d.trim_suffix("/")]
  var xo = 0
  var seen = 0
  while let Some(cur) = stack.pop() {
    let es = match os.fs.read_dir(cur) {
      Ok(x) => x
      Err(_) => continue
    }
    for fi in es {
      seen += 1
      if fi.is_dir {
        if !fi.name.starts_with(".") {
          stack.push(cur + "/" + fi.name)
        }
      } else if fi.name.ends_with(".xo") {
        xo += 1
      }
      if xo > MAX_DIR_XO || seen > MAX_DIR_ENTRIES {
        return Some("${d} holds more than ${MAX_DIR_XO} .xo files or ${MAX_DIR_ENTRIES} entries: give a module or repository directory with --dir, not a scratch or home directory (a check of it would load every tree under it)")
      }
    }
  }
  None
}

/// A Session of std alone (and the modules preload names): agent_session
/// over a new directory holding one empty program, removed after; None
/// when it fails too.
fn std_session(os: Os, preload: List[Str], decls_only: Bool) -> Session? uses (stdio, fs, env) {
  let tmp = os.fs.create_temp(hostpath.temp_dir(os.env), "xo-doc-").ok() ?? return None
  // create_temp makes a file: a directory of that name instead
  os.fs.remove(tmp).ignore_err("replaced by a directory")
  os.fs.create_dir_all(tmp).ok() ?? return None
  // a directory with no .xo file is refused: one empty program
  os.fs.write("${tmp}/main.xo", "fn main() {}\n".bytes()).ok() ?? return None
  let r = agent_session(os, tmp, preload, false, [], decls_only).ok()
  os.fs.remove_all(tmp).ignore_err("a temporary directory")
  r
}

/// A Session over the .xo files of dir, checked as `xo lsp` checks open
/// documents, with nothing written to standard output; at a root,
/// testdata walks its `testdata` directories too.
fn agent_session(os: Os, dir: Str, preload: List[Str], testdata: Bool, words: List[Str], decls_only: Bool) -> Session ! Str uses (stdio, fs, env) {
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  var s = Session{version: "", std_dir: std_dir(os), wd: wd, lsp_std: "", quiet: true, preload: preload, decls_only: decls_only}
  let d = abs_of(wd, dir)
  let entries = os.fs.read_dir(d).map_err(fn(e) { e.display() })?
  for fi in entries {
    if fi.is_dir || !fi.name.ends_with(".xo") {
      continue
    }
    let p = d.trim_suffix("/") + "/" + fi.name
    match os.fs.read(p) {
      Ok(b) => s.docs[p] = b
      Err(e) => return Err(e.display())
    }
  }
  if s.docs.is_empty() {
    // a stray --dir (a scratch or home directory) would load every tree
    // under it: refuse one with more than MAX_DIR_XO files or entries
    // (2026-10-21: `xo doc --dir=/private/tmp` took 220 GB)
    if let Some(why) = too_wide(os, d) {
      return Err(why)
    }
    // a workspace or repository root: the modules under it, as `xo
    // query` and `xo check` find them (decision 0289)
    var v = check_view_excluding(os, s.std_dir, wd, {}, [d], preload, [], testdata, words, decls_only)
    // a module below the root whose `use go` or `use c` binding is
    // missing stops the whole check: leave such modules out and check
    // again (the xo checkout's examples/realtime-control), naming them
    var skipped: List[Str] = []
    var tries = 0
    while v.err.is_empty() && !v.stopped.is_empty() && tries < 8 {
      var more: List[Str] = []
      for sd in v.stopped_dirs {
        let a = abs_of(wd, sd)
        if a != d.trim_suffix("/") && a.starts_with("${d.trim_suffix("/")}/") && !skipped.contains(a) {
          more.push(a)
        }
      }
      if more.is_empty() {
        break
      }
      skipped = skipped + more
      tries += 1
      v = check_view_excluding(os, s.std_dir, wd, {}, [d], preload, skipped, testdata, words, decls_only)
    }
    s.skipped = skipped
    s.testdata_skipped = v.testdata_skipped
    s.same_path = v.same_path
    // v.files holds the std files the check loaded too
    if v.err.is_empty() && !v.files.keys().any(fn(p) { p.starts_with("${d.trim_suffix("/")}/") }) {
      return Err("no .xo files in or under ${d}")
    }
    s.use_view(v)
    s.diags = v.diags
  } else {
    s.dirty = true
    s.recheck(os)
  }
  if !s.err.is_empty() {
    return Err(s.err)
  }
  if s.res.is_empty() {
    return Err("the program did not check")
  }
  Ok(s)
}

/// The 1 based line and byte column of offset off in src.
fn line_col(src: Bytes, off: Int) -> (Int, Int) {
  var line = 1
  var start = 0
  var i = 0
  while i < off && i < src.len() {
    if src[i] == 10 {
      line += 1
      start = i + 1
    }
    i += 1
  }
  (line, off - start + 1)
}

/// The byte offset of 1 based line and byte column in src, or -1.
fn offset_of(src: Bytes, line: Int, col: Int) -> Int {
  var l = 1
  var i = 0
  while l < line && i < src.len() {
    if src[i] == 10 {
      l += 1
    }
    i += 1
  }
  if l != line {
    return -1
  }
  i + col - 1
}

/// A location's JSON: the file (as the checker names it), line, column,
/// and end.
fn (s: Session) loc_json(f: Int, a: Int, b: Int) -> (List[Str], List[J]) {
  let src = s.res[0].c.files[f].src
  let (l, c) = line_col(src, a)
  let (el, ec) = line_col(src, b)
  (["file", "line", "col", "end_line", "end_col"], [jstr(s.res[0].c.files[f].path), jint(l), jint(c), jint(el), jint(ec)])
}

/// The user files (not std) of the last check, by path.
fn (s: Session) user_files() -> List[Int] {
  let c = s.res[0].c
  var out: List[(Str, Int)] = []
  for (p, f) in s.keys {
    let m = c.files[f].module
    if m >= 0 && !c.mods[m].is_std && !c.files[f].generated {
      out.push((p, f))
    }
  }
  var fs: List[Int] = []
  for (_, f) in out.sort_by(fn(x) { x.0 }) {
    fs.push(f)
  }
  fs
}

/// The qualified name of a declaration target: name, Type.member,
/// Enum.Variant, Type.field ("" for a local or another kind).
fn (s: Session) target_name(tg: LspTarget) -> Str {
  let c = s.res[0].c
  if tg.oi < 0 {
    return ""
  }
  match tg.what {
    "func" => c.display_name(tg.oi)
    "type" | "const" => check.text(c.objs[tg.oi].name)
    "field" => "${check.text(c.objs[tg.oi].name)}.${check.text(c.objs[tg.oi].fields[tg.sub].name)}"
    "variant" => "${check.text(c.objs[tg.oi].name)}.${check.text(c.objs[tg.oi].variants[tg.sub].name)}"
    _ => ""
  }
}

/// A declaration of the checked modules.
struct Found {
  f: Int
  site: Site
  tg: LspTarget
  name: Str
}

/// The declarations whose qualified name is name or ends with "." name.
fn (var s: Session) declarations(name: Str) -> List[Found] {
  s.declared(fn(full: Str) { full == name || full.ends_with("." + name) })
}

/// The declarations of the members of type name (`Counter.next` for
/// `Counter`).
fn (var s: Session) members(name: Str) -> List[Found] {
  var files = s.search_files()
  // a prelude type's methods (Map.get, Str.trim) are declared in the
  // prelude's files, which no name preloads (2026-10-21: `xo doc Map`
  // listed none)
  let c = s.res[0].c
  if c.prelude >= 0 {
    if let Some(o) = c.mods[c.prelude].members.get(name.bytes()) {
      if c.objs[o].kind == check.ObjKind.Type {
        for f in c.mods[c.prelude].files {
          if !files.contains(f) {
            files.push(f)
          }
        }
      }
    }
  }
  s.declared_in(files, fn(full: Str) { full.starts_with(name + ".") })
}

/// The files declared() searches: the user files, then those of the std
/// and runtime modules the name preloaded (`pool.park_wait` loads
/// native/llrt/pool).
fn (s: Session) search_files() -> List[Int] {
  let c = s.res[0].c
  var fs = s.user_files()
  for (_, f) in s.keys {
    let m = c.files[f].module
    if m >= 0 && c.mods[m].is_std && s.preloaded(m) && !fs.contains(f) {
      fs.push(f)
    }
  }
  fs
}

/// Whether module m is one the name preloaded (by mod_index: the
/// runtime's native/llrt/pool is a file of module std/native/llrt).
fn (s: Session) preloaded(m: Int) -> Bool {
  let c = s.res[0].c
  s.preload.any(fn(p) { (c.mod_index.get(p) ?? -1) == m })
}

/// The declarations of the checked files whose full name matches: a
/// top level declaration also by its module's name (`pool.park_wait` for
/// park_wait of native/llrt/pool).
fn (var s: Session) declared(matches: fn(Str) -> Bool) -> List[Found] {
  s.declared_in(s.search_files(), matches)
}

/// declared over the files given.
fn (var s: Session) declared_in(files: List[Int], matches: fn(Str) -> Bool) -> List[Found] {
  let c = s.res[0].c
  var out: List[Found] = []
  for f in files {
    for site in s.sites_of(f) {
      if site.id.name.is_empty() {
        continue
      }
      let tg = s.resolve(f, site)
      let sp = site.id.span
      // a declaration: the identifier is where its target is declared
      if tg.def_file != c.files[f].path || sp.start.offset != tg.def_start || sp.end.offset != tg.def_end {
        continue
      }
      let full = s.target_name(tg)
      if full.is_empty() {
        continue
      }
      if matches(full) {
        out.push(Found{f: f, site: site, tg: tg, name: full})
        continue
      }
      // module qualified: the last segment of the module's path, or for
      // the runtime (one module of many files, std/native/llrt) the
      // file's name, as its callers write it (`pool.park_wait`)
      let m = c.files[f].module
      if m >= 0 && !full.contains(".") {
        var quals = [last_seg(c.mods[m].path)]
        if c.mods[m].path.ends_with("native/llrt") {
          quals = [last_seg(c.files[f].path).trim_suffix(".xo").trim_suffix("_c")]
        }
        for qual in quals {
          let q = "${qual}.${full}"
          if matches(q) {
            out.push(Found{f: f, site: site, tg: tg, name: q})
          }
        }
      }
    }
  }
  out
}

/// The identifier at position target (FILE:LINE:COL).
fn (var s: Session) at_position(os: Os, target: Str) -> Found ! Str {
  let (file, line, col) = match position_of(target) {
    Some(x) => x
    None => return Err("not FILE:LINE:COL: ${target}")
  }
  let p = abs_of(s.wd, file)
  let f = s.file_at(p)
  if f < 0 {
    return Err("${file}: not a file of the checked program")
  }
  let off = offset_of(s.res[0].c.files[f].src, line, col)
  if off < 0 {
    return Err("${target}: no such line")
  }
  for site in s.sites_of(f) {
    let sp = site.id.span
    if sp.start.offset <= off && off <= sp.end.offset && !site.id.name.is_empty() {
      let tg = s.resolve(f, site)
      return Ok(Found{f: f, site: site, tg: tg, name: s.target_name(tg)})
    }
  }
  Err("${target}: no identifier there")
}

/// The targets of a command: the identifier at a position, or the
/// declarations of a name: those `xo query def` resolves it to (one
/// resolver for every tool, decision 0289), else the members of the
/// checked modules whose qualified name ends with it.
fn (var s: Session) targets(os: Os, target: Str) -> List[Found] ! Str uses fs {
  if position_of(target).is_some() {
    return Ok([s.at_position(os, target)?])
  }
  var out: List[Found] = []
  let q = semantic.Session{c: s.res[0].c, wd: s.wd}
  if let Ok(ds) = q.def(target) {
    for d in ds {
      // the identifier at the declaration, else (no identifier starts
      // exactly there; Lib 1 saw Str.to_upper from a repository root,
      // 2026-10-20) the declaration's object itself
      let hit = match s.found_at(d.pos.file, d.pos.line, d.pos.col) {
        Some(x) => Some(x)
        None => s.found_obj(d)
      }
      if let Some(found) = hit {
        if !out.any(fn(x) { x.f == found.f && x.site.id.span.start.offset == found.site.id.span.start.offset && x.name == found.name }) {
          out.push(found)
        }
      }
    }
  }
  if out.is_empty() {
    out = s.declarations(target)
  }

  if out.is_empty() {
    let stopped = s.res[0].c.unsupported
    if !stopped.is_empty() {
      // nothing was resolved: say why instead of "no declaration"
      return Err("no declaration named ${target}: the check stopped before resolving names (${stopped}); run it from a module's directory, or give --dir=DIR${semantic.miss_hint(os, s.std_dir, target)}")
    }
    return Err("no declaration named ${target}${semantic.miss_hint(os, s.std_dir, target)}")
  }
  Ok(out)
}

/// A declaration found by the resolver, by its object (fields and
/// variants have none), with the name's identifier made up from d.
fn (var s: Session) found_obj(d: semantic.QDef) -> Found? {
  if d.obj < 0 {
    return None
  }
  var r = s.res[0]
  let tg = r.obj_target(d.obj)
  s.res[0] = r
  let f = s.file_named(d.pos.file)
  let at = parser.Pos{offset: tg.def_start, line: d.pos.line, col: d.pos.col}
  let id = parser.Ident{span: parser.Span{start: at, end: at}, name: d.name.bytes()}
  Some(Found{f: f, site: Site{id: id, field: "", index: 0, ctx: SiteCtx.Other}, tg: tg, name: d.name})
}

/// The declaration whose name is at line:col of file (as the checker
/// names it), if an identifier starts there.
fn (var s: Session) found_at(file: Str, line: Int, col: Int) -> Found? {
  let f = s.file_named(file)
  if f < 0 {
    return None
  }
  let off = offset_of(s.res[0].c.files[f].src, line, col)
  for site in s.sites_of(f) {
    if site.id.span.start.offset == off && !site.id.name.is_empty() {
      let tg = s.resolve(f, site)
      let name = s.target_name(tg)
      return Some(Found{f: f, site: site, tg: tg, name: if name.is_empty() { check.text(site.id.name) } else { name }})
    }
  }
  None
}

/// The JSON of a target's declaration: name, kind, signature, doc, and
/// location.
fn (var s: Session) decl_json(found: Found) -> J {
  let tg = found.tg
  let (sig, doc) = s.describe(tg)
  var keys = ["name", "kind", "signature", "doc"]
  var vals = [jstr(found.name), jstr(tg.what), jstr(sig), jstr(doc)]
  if !tg.def_file.is_empty() {
    let df = s.file_named(tg.def_file)
    if df >= 0 {
      let (k, v) = s.loc_json(df, tg.def_start, tg.def_end)
      keys = keys + k
      vals = vals + v
    }
  }
  jobj(keys, vals)
}

/// `xo def` (and `xo doc NAME`, with methods): the declarations.
fn (var s: Session) agent_def(os: Os, target: Str, with_methods: Bool) -> J ! Str {
  var out: List[J] = []
  for found in s.targets(os, target)? {
    var d = s.decl_json(found)
    if with_methods && found.tg.what == "type" {
      var ms: List[J] = []
      for m in s.members(found.name) {
        if m.tg.what == "func" {
          ms.push(s.decl_json(m))
        }
      }
      if let J.Obj(keys, vals, raws) = d {
        d = J.Obj(keys: keys + ["methods"], vals: vals + [jarr(ms)], raws: raws)
      }
    }
    out.push(d)
  }
  Ok(jobj(["target", "declarations"], [jstr(target), jarr(out)]))
}

/// `xo refs`: every reference of the target, the declaration marked.
fn (var s: Session) agent_refs(os: Os, target: Str) -> J ! Str {
  let founds = s.targets(os, target)?
  if founds.len() > 1 {
    var names: List[J] = []
    for f in founds {
      names.push(jstr(f.name))
    }
    return Err("${target} names ${founds.len()} declarations: give Type.member or a position (${encode(jarr(names), false)})")
  }
  let tg = founds[0].tg
  if tg.obj.is_empty() && tg.def_file.is_empty() {
    return Err("${target}: nothing to find references of")
  }
  // a std declaration's uses are in std (other std modules, the prelude)
  let df = s.file_named(tg.def_file)
  let in_std = df >= 0 && s.res[0].c.files[df].module >= 0 && s.res[0].c.mods[s.res[0].c.files[df].module].is_std
  var refs: List[J] = []
  // a file loaded twice (a runtime file through two modules) is listed once
  var listed: Set[Str] = #{}
  for (f, r) in s.refs_in(tg, in_std) {
    if s.res[0].c.files[f].generated {
      // the code a derive generates is not the program's own
      continue
    }
    let sp = r.id.span
    let key = "${s.res[0].c.files[f].path}:${sp.start.offset}"
    if listed.contains(key) {
      continue
    }
    listed.add(key)
    let (k, v) = s.loc_json(f, sp.start.offset, sp.end.offset)
    let decl = s.res[0].c.files[f].path == tg.def_file && sp.start.offset == tg.def_start && sp.end.offset == tg.def_end
    refs.push(jobj(k + ["declaration"], v + [jbool(decl)]))
  }
  Ok(jobj(["target", "declaration", "references"], [jstr(target), s.decl_json(founds[0]), jarr(refs)]))
}

/// `xo type FILE:LINE:COL`: the identifier there, described.
fn (var s: Session) agent_type(os: Os, target: Str) -> J ! Str {
  if position_of(target).is_none() {
    return Err("xo type: a position (FILE:LINE:COL), not ${target}")
  }
  let found = s.at_position(os, target)?
  let (sig, doc) = s.describe(found.tg)
  Ok(jobj(["target", "kind", "signature", "doc", "declaration"], [jstr(target), jstr(found.tg.what), jstr(sig), jstr(doc), s.decl_json(found)]))
}

/// `xo symbols [DIR]`: the declarations of the files of dir (not of the
/// modules it imports), private ones too unless pub_only (decision 0289).
fn (var s: Session) agent_symbols(os: Os, dir: Str, pub_only: Bool, file: Str, module: Str) -> J ! Str {
  let c = s.res[0].c
  let d = abs_of(s.wd, dir)
  var out: List[J] = []
  // the files in scope: one file, one module (std and runtime ones
  // included), or the directory's own
  var files: List[Int] = []
  var mod_ix = -1
  if !module.is_empty() {
    mod_ix = c.mod_index.get(module) ?? -1
    if mod_ix < 0 {
      for (m, md) in c.mods.indexed() {
        if md.path == module {
          mod_ix = m
        }
      }
    }
    if mod_ix < 0 {
      return Err("no module ${module} in the check of ${d} (a std module is std/NAME, a runtime one native/llrt/NAME, a program's its import path)")
    }
    for (_, f) in s.keys {
      if c.files[f].module == mod_ix && !files.contains(f) && !c.files[f].generated && !c.files[f].path.ends_with("_test.xo") {
        files.push(f)
      }
    }
  } else {
    for f in s.user_files() {
      if !file.is_empty() {
        if abs_of(s.wd, c.files[f].path) == file {
          files.push(f)
        }
      } else if dir_of(abs_of(s.wd, c.files[f].path)) == d {
        files.push(f)
      }
    }
    if !file.is_empty() && files.is_empty() {
      return Err("${file} is not a checked .xo file")
    }
  }
  for f in files {
    for site in s.sites_of(f) {
      if site.id.name.is_empty() {
        continue
      }
      let tg = s.resolve(f, site)
      let sp = site.id.span
      if tg.def_file != c.files[f].path || sp.start.offset != tg.def_start || sp.end.offset != tg.def_end || tg.oi < 0 {
        continue
      }
      let name = s.target_name(tg)
      if name.is_empty() {
        continue
      }
      if pub_only && !c.objs[tg.oi].is_pub {
        continue
      }
      out.push(s.decl_json(Found{f: f, site: site, tg: tg, name: name}))
    }
  }
  if out.is_empty() && file.is_empty() && module.is_empty() && !s.user_files().any(fn(f) { dir_of(abs_of(s.wd, c.files[f].path)) == d }) {
    // a workspace or repository root: symbols lists one directory's own
    // declarations, so say which directories have them (agent poll
    // 2026-10-20: `symbols --dir=.` at a root was a silent [])
    var below: List[Str] = []
    for f in s.user_files() {
      let fd = dir_of(abs_of(s.wd, c.files[f].path))
      if fd.starts_with("${d.trim_suffix("/")}/") && !below.contains(fd) {
        below.push(fd)
      }
    }
    if below.is_empty() {
      return Err("no .xo files in ${d}")
    }
    let shown = below[0..below.len().min(5)].map(fn(x) { "--dir=${x[d.trim_suffix("/").len() + 1..]}" })
    let more = if below.len() > 5 { ", ... (${below.len()} directories)" } else { "" }
    return Err("no .xo files directly in ${d}: symbols lists one directory's declarations; try ${shown.join(", ")}${more}")
  }
  Ok(jobj(["symbols"], [jarr(out)]))
}

/// The part of path after its last "/".
fn last_seg(path: Str) -> Str {
  let segs = path.split("/")
  segs[segs.len() - 1]
}
