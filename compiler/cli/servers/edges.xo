// `xo dev edges`: every resolved reference of a checked program as a call
// graph edge, for tools that must not guess a name from its text
// (scripts/coverage: a corpus writes `xs.map(f)`, so the receiver of a
// method call is a variable and only the checker knows its type).
//
// One line per reference site, tab separated, no header:
//
//   SRC_PATH SRC_LINE SRC_NAME TGT_PATH TGT_LINE TGT_NAME SITE_PATH SITE_LINE SITE_COL SITE_NAME
//
// SRC is the function whose body holds the site (a file with line 0
// outside one), TGT the declaration the site resolves to (lines whose
// site names no declaration are skipped), SITE the reference itself.
// Paths are as the checker names them (a std file by its std path), lines
// 1 based bytes. A declaration's own name is not a reference to itself
// and is not emitted.
//
// The edges are those of the last check, so a program that does not check
// writes nothing and exits 1 with the reason on standard error.

use github.com/xo-lang/xo/compiler/check

/// edges_usage is the command line of `xo dev edges`.
pub fn edges_usage() -> Str {
  "usage: xo dev edges [--out=FILE] [--dir=DIR] DIR\n  every resolved reference of the checked program in DIR as SRC and TGT declaration lines"
}

/// edges_cmd is `xo dev edges [--out=FILE] [--dir=DIR] DIR`: the edges of
/// the program in DIR (this directory when no DIR is given).
pub fn edges_cmd(os: Os, args: List[Str]) -> Int uses (env, fs, fs.read, fs.write, stdio) {
  var dir = "."
  var out = ""
  var saw_dir = false
  for a in args {
    if a.starts_with("--out=") {
      out = a.trim_prefix("--out=")
    } else if a.starts_with("--dir=") {
      dir = a.trim_prefix("--dir=")
      saw_dir = true
    } else if a.starts_with("-") {
      os.stdio.eprintln("xo dev edges: unknown flag ${a.quote()}\n${edges_usage()}")
      return 2
    } else if saw_dir {
      os.stdio.eprintln("xo dev edges: one DIR\n${edges_usage()}")
      return 2
    } else {
      dir = a
      saw_dir = true
    }
  }
  var s = match session(os, dir) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo dev edges: ${e}")
      return 1
    }
  }
  let text = s.edge_lines().join("\n")
  if out.is_empty() {
    os.stdio.println(text)
    return 0
  }
  match os.fs.write(out, text.bytes()) {
    Ok(_) => 0
    Err(e) => {
      os.stdio.eprintln("xo dev edges: ${out}: ${e.display()}")
      1
    }
  }
}

/// The headless session of the program in dir, checked.
fn session(os: Os, dir: Str) -> Session ! Str uses (stdio, fs, env) {
  let s = agent_session(os, dir, [])?
  if !s.err.is_empty() {
    return Err(s.err)
  }
  Ok(s)
}

/// The edge lines of the last check, sorted.
fn (var s: Session) edge_lines() -> List[Str] {
  let c = s.res[0].c
  var out: List[Str] = []
  for f in 0..c.files.len() {
    let path = c.files[f].path
    for site in s.sites_of(f) {
      if site.id.name.is_empty() {
        continue
      }
      let off = site.id.span.start.offset
      let tg = s.resolve(f, site)
      if tg.def_file.is_empty() {
        continue
      }
      // a declaration's own name is not a reference to it
      if tg.def_file == path && tg.def_start == off {
        continue
      }
      let (sl, sc) = line_col(c.files[f].src, off)
      let (spl, spll, spn) = s.src_decl(f, off)
      out.push("${spl}\t${spll}\t${spn}\t${tg.def_file}\t${s.def_line(tg)}\t${s.target_name(tg)}\t${path}\t${sl}\t${sc}\t${check.text(site.id.name)}")
    }
  }
  out = out.sort()
  out
}

/// The 1 based line of a target's declaration in its file, or 0.
fn (s: Session) def_line(tg: LspTarget) -> Int {
  let df = s.file_named(tg.def_file)
  if df < 0 {
    return 0
  }
  let (l, _) = line_col(s.res[0].c.files[df].src, tg.def_start)
  l
}

/// The path, line and name of the function whose body holds off in file
/// f (a file with line 0 and no name outside one).
fn (var s: Session) src_decl(f: Int, off: Int) -> (Str, Int, Str) {
  let path = s.res[0].c.files[f].path
  let oi = s.enclosing_fn(f, off)
  if oi < 0 {
    return (path, 0, "")
  }
  var r = s.res[0]
  let tg = r.obj_target(oi)
  s.res[0] = r
  let name = s.res[0].c.display_name(oi)
  let df = s.file_named(tg.def_file)
  if df < 0 {
    return (path, 0, name)
  }
  let (l, _) = line_col(s.res[0].c.files[df].src, tg.def_start)
  (tg.def_file, l, name)
}
