// `xo dev edges`: every resolved reference of a checked program as a call
// graph edge, for tools that must not guess a name from its text
// (scripts/stdcoverage: a corpus writes `xs.map(f)`, so the receiver of a
// method call is a variable and only the checker knows its type).
//
// One line per reference site, tab separated, no header:
//
//   SRC_PATH SRC_LINE SRC_NAME TGT_PATH TGT_LINE TGT_NAME SITE_PATH SITE_LINE SITE_COL SITE_NAME
//
// SRC is the function whose body holds the site (a file with line 0
// outside one), TGT the declaration the site resolves to (lines whose
// site names no declaration are skipped), SITE the reference itself.
// Paths are as the checker names them (a std file by its std path), lines
// 1 based bytes. A declaration's own name is not a reference to itself
// and is not emitted.
//
// --impls adds the implementation edges a call through an interface needs:
// a call written on an interface value names the interface method, so the
// methods that implement it are never named anywhere. Each such edge has
// the interface method's declaration as SRC and the implementing method as
// TGT; a tool that follows SRC to decide what is reachable then reaches
// the implementations only once the interface method itself is reached.
// The rule is the checker's structural one (a type implements the
// interface when its methods have every name the interface's do), so a
// program that declares its own interface gets those edges too.
//
// The edges are those of the last check, so a program that does not check
// writes nothing and exits 1 with the reason on standard error.
//
// The command itself is compiler/xo edgecache.xo (decision 0381): the
// edges split into the program's own and the std graph (edges_of), and
// the std graph, the same for every program, is cached there once per xo
// identity, std sources and bindings.

use github.com/xo-lang/xo/compiler/check

/// edges_usage is the command line of `xo dev edges`.
pub fn edges_usage() -> Str {
  "usage: xo dev edges [--out=FILE] [--impls] [--dir=DIR] DIR\n  every resolved reference of the checked program in DIR as SRC and TGT declaration lines; --impls adds an edge from each interface method to the methods that implement it"
}

/// The edges of a checked program, split (decision 0381): the std graph
/// (the sites in the std tree's files, which every program's check
/// resolves the same way, since each std body is checked once in its own
/// scope and the preload is the files on disk, not the program's imports)
/// and the program's own (sites in its files, in a binding's declaration
/// file, and the impl edges with an end outside the std tree); and the
/// bindings its modules use ("go", "c", "go,c" or "none"), which change
/// the std graph a check produces and so are part of its cache key.
pub struct Edges {
  pub own: List[Str] = []
  pub std: List[Str] = []
  pub bindings: Str = "none"
}

/// edges_of: the edges of the program in dir, with the std implementation
/// files preloaded and their bodies checked (preload: the full graph,
/// about 16 s) or the program alone checked (its own edges, about 0.3 s;
/// the std part then holds only the std bodies the check reached). impls
/// adds the implementation edges (impl_lines). Neither list is sorted.
pub fn edges_of(os: Os, dir: Str, impls: Bool, preload: Bool) -> Edges ! Str uses (env, fs, stdio) {
  var s = session(os, dir, preload)?
  var e = Edges{}
  let (own, std) = s.edge_lines()
  e.own = own
  e.std = std
  if impls {
    let (iown, istd) = s.impl_lines()
    e.own = e.own + iown
    e.std = e.std + istd
  }
  var go = false
  var c = false
  for m in s.res[0].c.mods {
    if !m.go_path.is_empty() {
      go = true
    }
    if !m.c_prefix.is_empty() {
      c = true
    }
  }
  e.bindings = if go && c { "go,c" } else if go { "go" } else if c { "c" } else { "none" }
  Ok(e)
}

/// The headless session of the program in dir, checked, with the std
/// implementation files loaded and their bodies checked too (preload), or
/// the program alone.
fn session(os: Os, dir: Str, preload: Bool) -> Session ! Str uses (stdio, fs, env) {
  let std = agent_std(os, dir)
  let s = agent_session(os, dir, std, if preload { impl_modules(os, std) } else { [] }, false, [], false)?
  if !s.err.is_empty() {
    return Err(s.err)
  }
  // A `use go` or `use c` binding that is missing (or a module the program
  // requires that is not in the module cache) stops the check before names
  // resolve: the standard library alone checks, so the session holds its
  // references and none of the program's own. Reporting them would make an
  // empty program look like one with no calls (the 2026-10-26 coverage
  // sweep read every unbound `use go` golden that way); the other agent
  // commands keep answering from std and say the check stopped, which is
  // useful to them, so only the edge list refuses.
  if !s.stopped.is_empty() {
    return Err(s.stopped)
  }
  Ok(s)
}

/// The std modules whose bodies an implementation file holds: `native/NAME`
/// for each `std/NAME.xo` that has a `std/native/NAME.xo` (decision 0074
/// lowers a prelude method to a function there by symbol, so no import
/// names the file). Without them in the preload the checker reads the
/// declarations only, and their sites, which are most of what a corpus
/// calls, are nowhere in the edges.
fn impl_modules(os: Os, std_dir: Str) -> List[Str] uses fs.read {
  var out: List[Str] = []
  if std_dir.is_empty() {
    return out
  }
  let entries = os.fs.read_dir(std_dir).ok() ?? []
  for e in entries {
    if e.is_dir || !e.name.ends_with(".xo") || e.name.ends_with("_test.xo") {
      continue
    }
    let name = e.name.trim_suffix(".xo")
    // a module with a `use c` line (decision 0534's) needs its C binding,
    // which only a build with a C compiler writes: a fresh checkout has
    // none, and the preload failed (cmd/xo TestDevEdges on linux/arm64,
    // 2026-11-06); the std store build skips it the same way (check
    // load.xo std_uses_c)
    let b = os.fs.read("${std_dir.trim_suffix("/")}/native/${name}.xo").ok() ?? continue
    if !check.uses_c(b) {
      out.push("native/${name}")
    }
  }
  out
}

/// Whether file f of the last check is in the std tree (check.Module
/// std_tree: std, native, llrt; not a `use go` or `use c` binding's
/// declaration file, which is_std too).
fn (s: Session) std_tree_file(f: Int) -> Bool {
  s.res[0].c.mods[s.res[0].c.files[f].module].std_tree
}

/// Whether the file the checker names p is in the std tree.
fn (s: Session) std_tree_path(p: Str) -> Bool {
  let df = s.file_named(p)
  df >= 0 && s.std_tree_file(df)
}

/// The edge lines of the last check: (the program's own, the std graph),
/// a line by the file of its site.
fn (var s: Session) edge_lines() -> (List[Str], List[Str]) {
  let c = s.res[0].c
  var out: List[Str] = []
  var std: List[Str] = []
  for f in 0..c.files.len() {
    let path = c.files[f].path
    let in_std = s.std_tree_file(f)
    for site in s.sites_of(f) {
      if site.id.name.is_empty() {
        continue
      }
      let off = site.id.span.start.offset
      let tg = s.resolve(f, site)
      if tg.def_file.is_empty() {
        continue
      }
      // a declaration's own name is not a reference to it
      if tg.def_file == path && tg.def_start == off {
        continue
      }
      let (sl, sc) = line_col(c.files[f].src, off)
      let (spl, spll, spn) = s.src_decl(f, off)
      let line = "${spl}\t${spll}\t${spn}\t${tg.def_file}\t${s.def_line(tg)}\t${s.target_name(tg)}\t${path}\t${sl}\t${sc}\t${check.text(site.id.name)}"
      if in_std {
        std.push(line)
      } else {
        out.push(line)
      }
    }
  }
  (out, std)
}

/// The 1 based line of a target's declaration in its file, or 0.
fn (s: Session) def_line(tg: LspTarget) -> Int {
  let df = s.file_named(tg.def_file)
  if df < 0 {
    return 0
  }
  let (l, _) = line_col(s.res[0].c.files[df].src, tg.def_start)
  l
}

/// The impl edge lines: for every type whose method set has every name of
/// an interface's methods, one edge from the interface method's declaration
/// to the type's method of that name (the checker's structural rule, the
/// one rename_iface_method uses). SRC is the interface method, so a
/// consumer that follows SRC reaches the implementations only when the
/// interface method itself is reached. (the program's own, the std
/// graph): an edge is the std graph's when both its ends are in the std
/// tree; one with a program's type implementing a std interface, or a std
/// type implementing the program's, is the program's own.
fn (var s: Session) impl_lines() -> (List[Str], List[Str]) {
  var r = s.res[0]
  let c = r.c
  // a type's methods, by the receiver type's object
  var by_recv: Map[Int, List[Int]] = {}
  for (o, ob) in c.objs.indexed() {
    if ob.kind != check.ObjKind.Func || ob.recv < 0 || ob.iface {
      continue
    }
    var l = by_recv.get(ob.recv) ?? []
    l.push(o)
    by_recv[ob.recv] = l
  }
  var ifaces: List[Int] = []
  for (oi, ob) in c.objs.indexed() {
    if ob.tkind == "interface" && !ob.iface_meths.is_empty() {
      ifaces.push(oi)
    }
  }
  s.res[0] = r
  var out: List[Str] = []
  var std: List[Str] = []
  for ti in ifaces {
    let meths = s.res[0].c.objs[ti].iface_meths
    for (_recv, ms) in by_recv.entries() {
      // the method of the type with each interface method's name (the
      // checker's structural rule, matched on the bare name: display_name
      // qualifies it with the receiver, which differs by design)
      var found: List[Int] = []
      for im in meths {
        var hit = -1
        for o in ms {
          if s.res[0].c.objs[o].name == s.res[0].c.objs[im].name {
            hit = o
          }
        }
        found.push(hit)
      }
      if found.contains(-1) {
        continue
      }
      for i in 0..meths.len() {
        let (sp, sl, sn) = s.obj_pos(meths[i])
        let (tp, tl, tn) = s.obj_pos(found[i])
        if tp.is_empty() {
          continue
        }
        let line = "${sp}\t${sl}\t${sn}\t${tp}\t${tl}\t${tn}\t${sp}\t${sl}\t0\t${sn}"
        if s.std_tree_path(sp) && s.std_tree_path(tp) {
          std.push(line)
        } else {
          out.push(line)
        }
      }
    }
  }
  (out, std)
}

/// The path, 1 based line and name of the declaration of object oi (a file
/// with line 0 and no path when it has no declaration site).
fn (var s: Session) obj_pos(oi: Int) -> (Str, Int, Str) {
  let tg = s.res[0].obj_target(oi)
  let name = s.res[0].c.display_name(oi)
  if tg.def_file.is_empty() {
    return ("", 0, name)
  }
  let df = s.file_named(tg.def_file)
  if df < 0 {
    return (tg.def_file, 0, name)
  }
  let (l, _) = line_col(s.res[0].c.files[df].src, tg.def_start)
  (tg.def_file, l, name)
}

/// The path, line and name of the function whose body holds off in file
/// f (a file with line 0 and no name outside one).
fn (var s: Session) src_decl(f: Int, off: Int) -> (Str, Int, Str) {
  let path = s.res[0].c.files[f].path
  let oi = s.enclosing_fn(f, off)
  if oi < 0 {
    return (path, 0, "")
  }
  let tg = s.res[0].obj_target(oi)
  let name = s.res[0].c.display_name(oi)
  let df = s.file_named(tg.def_file)
  if df < 0 {
    return (path, 0, name)
  }
  let (l, _) = line_col(s.res[0].c.files[df].src, tg.def_start)
  (tg.def_file, l, name)
}
