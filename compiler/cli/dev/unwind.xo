// `xo dev unwind --snap FILE [--dwarf FILE] [--locals] EXE`: the
// backtrace compiler/debug's unwinder (decision 0253) finds for a
// recorded stopped thread (a snapshot: its registers and stack, from
// lldb or gdb at a breakpoint), each frame's function, file, and line
// from the DWARF (EXE's own, or --dwarf: a dSYM's DWARF file), and with
// --locals each frame's variables read in that frame. For tests and
// agents until `xo debug` controls processes itself.

use github.com/xo-lang/xo/compiler/cli/core
use github.com/xo-lang/xo/compiler/debug

fn unwind_cmd(os: Os, args: List[Str]) -> Int uses (fs.read, stdio) {
  var fl = core.new_flags("dev unwind")
  fl.str_flag("snap", "", "the recorded thread (reg and mem lines)")
  fl.str_flag("dwarf", "", "the DWARF file (default the executable)")
  fl.bool_flag("locals", "print each frame's variables")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.len() != 1 || fl.get_str("snap").is_empty() {
    os.stdio.eprintln("usage: xo dev unwind --snap FILE [--dwarf FILE] [--locals] EXE")
    return 2
  }
  let exe = match os.fs.read(fl.args[0]) {
    Ok(d) => d
    Err(e) => {
      os.stdio.eprintln("xo dev unwind: ${e}")
      return 1
    }
  }
  let dpath = if fl.get_str("dwarf").is_empty() { fl.args[0] } else { fl.get_str("dwarf") }
  let ddata = if dpath == fl.args[0] { exe } else {
    match os.fs.read(dpath) {
      Ok(d) => d
      Err(e) => {
        os.stdio.eprintln("xo dev unwind: ${e}")
        return 1
      }
    }
  }
  let stext = match os.fs.read(fl.get_str("snap")) {
    Ok(t) => t.to_str() ?? ""
    Err(e) => {
      os.stdio.eprintln("xo dev unwind: ${e}")
      return 1
    }
  }
  let snap = match debug.parse_snapshot(stext) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo dev unwind: ${fl.get_str("snap")}: ${e}")
      return 1
    }
  }
  let s = match debug.sections(ddata) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo dev unwind: ${dpath}: ${e}")
      return 1
    }
  }
  let info = debug.read(s)
  let tab = debug.tables(exe)
  let frames = debug.backtrace(tab, snap.regs, snap, 64)
  // the first physical frame and the calls inlined in it read the
  // thread's own registers, at its pc
  var first = true
  for (n, f) in debug.vframes(info, debug.lines(s), tab, frames).indexed() {
    let at = if f.file.is_empty() { "" } else { " at ${f.file}:${f.line}" }
    os.stdio.println("#${n} ${hex(f.pc)} ${f.name}${if f.inlined { " [inlined]" } else { "" }}${at} (${f.how})")
    if fl.get_bool("locals") {
      let pc = if first { f.pc } else { f.pc - 4 }
      let regs: Map[Int, Int] = if first { {} } else { f.regs }
      print_locals(os, info, f.vars, pc, regs, snap)
    }
    if !f.inlined {
      first = false
    }
  }
  0
}

fn print_locals(os: Os, info: debug.Info, vars: List[debug.Var], pc: Int, regs: Map[Int, Int], snap: debug.Snapshot) uses (stdio) {
  for v in vars {
    let shown = match debug.value_in(info, v, pc, regs, snap) {
      Ok(x) => x.show()
      Err(e) => e
    }
    os.stdio.println("    ${v.name} = ${shown}")
  }
}
