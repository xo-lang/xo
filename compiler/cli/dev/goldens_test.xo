// Tests of xo dev goldens (moved from goldens.xo, decision 0262: tests under
// compiler/ live in _test.xo files).

test "fields" {
  expect(fields(" a  b\tc\n") == ["a", "b", "c"])
  expect(fields("") == [])
}

test "order puts the slow first" {
  let ps = [Prog{dir: "a", name: "a", want: "", size: 10}, Prog{dir: "b", name: "b", want: "", size: 5}, Prog{dir: "c", name: "c", want: "", size: 1}]
  let o = order(ps, {"c": 900})
  expect(o.map(fn(p: Prog) { p.dir }) == ["c", "a", "b"])
}

test "discovery fails on a directory it cannot list instead of finding fewer programs" {
  os.fs.create_dir_all("g/one")?
  os.fs.write("g/one/main.xo", b"fn main() {}\n")?
  os.fs.write("g/one/want.txt", b"")?
  expect(programs(os.fs, ["g"]).map(fn(ps) { ps.map(fn(p: Prog) { p.name }) })) == Ok(["one"])
  // a misspelled or unreadable directory used to be zero programs and a pass
  expect(programs(os.fs, ["g", "nosuch"]).is_err()) == true
  expect(module_dirs(os.fs, ["nosuch"]).is_err()) == true
  expect(module_dirs(os.fs, ["g"])) == Ok(["g/one"])
}

test "last_msg skips the leak check line a compiler adds when it exits" {
  expect(last_msg("xo: --backend=wasm: want arm64\nxo leakcheck: skipped (os.proc.exit)\n") == "xo: --backend=wasm: want arm64")
  expect(last_msg("a\nb\n") == "b")
  expect(last_msg("") == "")
}

test "classify counts a cross build of a use c program and the cross link error as unsupported" {
  os.fs.create_dir_all("u/c")?
  os.fs.write("u/c/main.xo", b"use c \"a.h\" link \"a.c\"\nfn main() {}\n")?
  os.fs.create_dir_all("u/plain")?
  os.fs.write("u/plain/main.xo", b"fn main() {}\n")?
  let cross = Config{xo: "xo", std: "std", out: "out", flags: ["--backend=amd64", "--target=linux/amd64"]}
  let host = Config{xo: "xo", std: "std", out: "out"}
  let fail = fn(dir: Str, why: Str) -> Outcome { Outcome{name: "x", dir: dir, status: "fail", why: why} }
  expect(classify(os.fs, cross, fail("u/c", "build: xo: syntax")).status) == "unsupported"
  expect(classify(os.fs, cross, fail("u/plain", "build: xo: syntax")).status) == "fail"
  expect(classify(os.fs, host, fail("u/c", "build: xo: syntax")).status) == "fail"
  expect(classify(os.fs, host, fail("u/plain", "build: xo: linux/amd64 links with a C compiler and xo does not cross link with one")).status) == "unsupported"
  expect(classify(os.fs, host, fail("u/plain", "build: xo: the wasm backend does not support the call `rt.heap_big`")).status) == "unsupported"
  expect(classify(os.fs, cross, fail("u/c", "differs: line 1")).status) == "fail"
  // a std module's `use c` (std/sqlite) is not in the directory: xo
  // build's own message names the missing Windows sysroot
  expect(classify(os.fs, cross, fail("u/plain", "build: xo: windows/amd64 compiles a `use c` source (the program's, or a std module's such as std/sqlite's) with clang against the MSVC C library and the Windows SDK, which a darwin/arm64 host has only as a sysroot: set XO_WINSYSROOT to one (xwin's), or build on windows/amd64")).status) == "unsupported"
  expect(classify(os.fs, cross, fail("u/plain", "build: clang: fatal error: 'stdlib.h' file not found")).status) == "fail"
}
