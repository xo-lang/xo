// Tests of xo dev goldens (moved from goldens.xo, decision 0262: tests under
// compiler/ live in _test.xo files).

test "fields" {
  expect(fields(" a  b\tc\n") == ["a", "b", "c"])
  expect(fields("") == [])
}

test "order puts the slow first" {
  let ps = [Prog{dir: "a", name: "a", want: "", size: 10}, Prog{dir: "b", name: "b", want: "", size: 5}, Prog{dir: "c", name: "c", want: "", size: 1}]
  let o = order(ps, {"c": 900})
  expect(o.map(fn(p: Prog) { p.dir }) == ["c", "a", "b"])
}

test "discovery fails on a directory it cannot list instead of finding fewer programs" {
  os.fs.create_dir_all("g/one")?
  os.fs.write("g/one/main.xo", b"fn main() {}\n")?
  os.fs.write("g/one/want.txt", b"")?
  expect(programs(os.fs, ["g"]).map(fn(ps) { ps.map(fn(p: Prog) { p.name }) })) == Ok(["one"])
  // a misspelled or unreadable directory used to be zero programs and a pass
  expect(programs(os.fs, ["g", "nosuch"]).is_err()) == true
  expect(module_dirs(os.fs, ["nosuch"]).is_err()) == true
  expect(module_dirs(os.fs, ["g"])) == Ok(["g/one"])
}

test "last_msg skips the leak check line a compiler adds when it exits" {
  expect(last_msg("xo: --backend=wasm: want arm64\nxo leakcheck: skipped (os.proc.exit)\n") == "xo: --backend=wasm: want arm64")
  expect(last_msg("a\nb\n") == "b")
  expect(last_msg("") == "")
}
