// `xo dev debug --snap FILE [--dwarf FILE] [--json] -c CMD... EXE`: `xo
// debug --batch` (decision 0253 point 4) on a recorded stopped thread
// until the process control of stage 2: each command echoed as `(xo)
// CMD`, then its output (compiler/debug session.xo); with --json one JSON
// line per command instead (spec 11.5, version 1). With no -c the
// commands are read from standard input, a line each, until its end or
// `quit`: the prompt `(xo) ` on a terminal, and an empty line repeats the
// last command, as gdb and lldb do; with --json that is the line protocol
// (one command in, one JSON line out).

use github.com/xo-lang/xo/compiler/cli/core
use github.com/xo-lang/xo/compiler/debug

fn debug_cmd(os: Os, args: List[Str]) -> Int uses (fs.read, stdio, proc) {
  let interactive = !args.contains("-c")
  // -c may repeat: gather them before the flag parser
  var cmds: List[Str] = []
  var rest: List[Str] = []
  var i = 0
  while i < args.len() {
    if args[i] == "-c" && i + 1 < args.len() {
      cmds.push(args[i + 1])
      i += 2
    } else {
      rest.push(args[i])
      i += 1
    }
  }
  var fl = core.new_flags("dev debug")
  fl.str_flag("snap", "", "the recorded thread (reg and mem lines)")
  fl.str_flag("dwarf", "", "the DWARF file (default the executable)")
  fl.bool_flag("json", "one JSON line per command (spec 11.5)")
  if !fl.parse(os, rest) {
    return 2
  }
  if fl.args.len() != 1 || fl.get_str("snap").is_empty() {
    os.stdio.eprintln("usage: xo dev debug --snap FILE [--dwarf FILE] [--json] [-c CMD]... EXE")
    return 2
  }
  let exe = match os.fs.read(fl.args[0]) {
    Ok(d) => d
    Err(e) => {
      os.stdio.eprintln("xo dev debug: ${e}")
      return 1
    }
  }
  let dpath = if fl.get_str("dwarf").is_empty() { fl.args[0] } else { fl.get_str("dwarf") }
  let ddata = if dpath == fl.args[0] { exe } else {
    match os.fs.read(dpath) {
      Ok(d) => d
      Err(e) => {
        os.stdio.eprintln("xo dev debug: ${e}")
        return 1
      }
    }
  }
  let sections = match debug.sections(ddata) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo dev debug: ${dpath}: ${e}")
      return 1
    }
  }
  let stext = match os.fs.read(fl.get_str("snap")) {
    Ok(t) => t.to_str() ?? ""
    Err(e) => {
      os.stdio.eprintln("xo dev debug: ${e}")
      return 1
    }
  }
  let snap = match debug.parse_snapshot(stext) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo dev debug: ${fl.get_str("snap")}: ${e}")
      return 1
    }
  }
  var s = debug.session(exe, sections, snap)
  let json = fl.get_bool("json")
  if interactive {
    return prompt_loop(os, s, json)
  }
  run_cmds(os, s, cmds, json)
}

/// `xo debug [--batch] [--json] [-c CMD]... PROG [ARGS]` (decision 0253
/// stage 2): PROG, an executable built with its debug information (a
/// native build's default), run under the process control with ARGS; the
/// commands from -c (--batch: each echoed as `(xo) CMD`, then its
/// output), else from standard input as `xo dev debug` reads them. The
/// program is ended at the commands' end or quit. macOS arm64 and Linux
/// (decision 0253 stage 6) so far.
/// usage is the command's help (cmdhelp), printed on a usage error.
pub fn debug_main(os: Os, args: List[Str], usage: Str) -> Int uses (fs.read, stdio, proc) {
  var cmds: List[Str] = []
  var json = false
  var batch = false
  var attach = false
  var wait_ms = 0
  var i = 0
  while i < args.len() && args[i].starts_with("-") {
    let a = args[i]
    if a == "-c" && i + 1 < args.len() {
      cmds.push(args[i + 1])
      i += 2
      continue
    }
    if a == "-p" && i + 1 < args.len() {
      match Int.parse(args[i + 1]) {
        Some(p) if p > 0 => cmds.insert(0, "attach ${p}")
        _ => {
          os.stdio.eprint("xo debug: -p takes a process id, not ${args[i + 1].quote()}\n${usage}")
          return 2
        }
      }
      attach = true
      i += 2
      continue
    }
    if a.starts_with("--timeout=") {
      match Duration.parse(a["--timeout=".len()..a.len()]) {
        Ok(d) if d.millis() > 0 => wait_ms = d.millis()
        _ => {
          os.stdio.eprint("xo debug: --timeout takes a duration (30s, 2m, 500ms), not ${a["--timeout=".len()..a.len()].quote()}\n${usage}")
          return 2
        }
      }
    } else if a == "--json" {
      json = true
    } else if a == "--batch" {
      batch = true
    } else if a == "--" {
      i += 1
      break
    } else {
      os.stdio.eprint("xo debug: unknown flag ${a.quote()}\n${usage}")
      return 2
    }
    i += 1
  }
  if i >= args.len() || (batch && cmds.len() == (if attach { 1 } else { 0 })) {
    os.stdio.eprint(usage)
    return 2
  }
  let prog = args[i]
  let exe = match os.fs.read(prog) {
    Ok(d) => d
    Err(e) => {
      os.stdio.eprintln("xo debug: ${e}")
      return 1
    }
  }
  let sections = match debug.sections(exe) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo debug: ${prog}: ${e} (build it with its debug information: a native xo build keeps it unless -s or --release)")
      return 1
    }
  }
  var s = debug.live_session(exe, sections, prog, args[i + 1..])
  s.wait_ms = wait_ms
  if attach && cmds.len() == 1 && !batch {
    // -p with no commands: attach, then the prompt
    os.stdio.println(if json { s.exec_json(cmds[0]) } else { s.exec(cmds[0]) })
    return prompt_loop(os, s, json)
  }
  if cmds.is_empty() { prompt_loop(os, s, json) } else { run_cmds(os, s, cmds, json) }
}

/// Runs cmds in order (see the file's comment): 1 when one failed.
fn run_cmds(os: Os, var s: debug.Session, cmds: List[Str], json: Bool) -> Int uses (stdio, proc) {
  var failed = false
  for c in cmds {
    if json {
      let out = s.exec_json(c)
      os.stdio.println(out)
      failed = failed || out.contains("\"ok\":false")
    } else {
      os.stdio.println("(xo) ${c}")
      let out = s.exec(c)
      if !out.is_empty() {
        os.stdio.println(out)
      }
      failed = failed || out.starts_with("error: ")
    }
    if s.done {
      break
    }
  }
  // a live program ends with the commands (quit's end, again harmless)
  let _q = s.exec("quit")
  if failed { 1 } else { 0 }
}

/// The commands of standard input, a line each (see the file's comment):
/// 0 at its end or `quit`, 1 when it could not be read.
fn prompt_loop(os: Os, var s: debug.Session, json: Bool) -> Int uses (stdio, proc) {
  let tty = os.stdio.stdin_is_tty()
  var last = ""
  while !s.done {
    if tty && !json {
      os.stdio.print("(xo) ")
    }
    let line = match os.stdio.read_line() {
      Ok(Some(l)) => l.trim()
      Ok(None) => {
        let _q = s.exec("quit")
        return 0
      }
      Err(e) => {
        os.stdio.eprintln("xo dev debug: ${e}")
        return 1
      }
    }
    var c = line
    if c.is_empty() {
      if last.is_empty() {
        continue
      }
      c = last
    }
    last = c
    if json {
      os.stdio.println(s.exec_json(c))
    } else {
      let out = s.exec(c)
      if !out.is_empty() {
        os.stdio.println(out)
      }
    }
  }
  let _q = s.exec("quit")
  0
}
