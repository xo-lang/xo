// `xo dev codegen` (decisions 0209, 0217): optimizations verified by
// patterns on the code emitted for one function, as Go's test/codegen
// does, never by whole files. A comment inside a function's body names a
// backend and regular expressions the function's assembly (arm64, amd64)
// or IR (llvm) must match, or with a leading `-` must not:
//
//   fn shift(x: Int) -> Int {
//     // arm64: "lsl\tx[0-9]+, x[0-9]+, #3" -"mul"
//     // amd64: "imulq \$8, " -"idiv"
//     // llvm: "shl i64"
//     x * 8
//   }
//
// The function is the nearest `fn name(` line above the comment (a
// function of the program's root module: its symbol is the bare name).
// `xo asm --backend=B DIR` prints the code: arm64 functions start at a
// `// func NAME` line, amd64 ones (AT&T syntax, the host's object
// format) at `# func NAME` (since 2026-10-27), LLVM ones at `define ... @"x.NAME"(` and end at a
// line `}`. A line `// func MOD.NAME` names a function of another
// module (a std runtime module's) for the patterns below it. A backend
// key with an architecture, `// llvm/arm64: ...`, is checked only where
// `xo asm` targets it (the host: LLVM's IR holds the target's inline
// assembly, so arm64's AES rounds are not an x86_64 host's).

use std/regexp
use std/task
use github.com/xo-lang/xo/compiler/cli/core

/// One pattern on one function.
pub struct Pattern {
  pub file: Str
  pub line: Int
  pub func: Str
  pub backend: Str
  /// the architecture the pattern needs ("" for any)
  pub arch: Str = ""
  pub re: Str
  /// true: the code must not match.
  pub negate: Bool = false
}

/// patterns parses the backend comments of one file.
pub fn patterns(file: Str, src: Str) -> List[Pattern] {
  var out: List[Pattern] = []
  let fn_re = regexp.must("^\\s*(?:pub\\s+)?fn\\s+([a-z_][a-z0-9_]*)\\s*[(\\[]")
  let item = regexp.must("(-?)\"((?:[^\"\\\\]|\\\\.)*)\"")
  var cur = ""
  for (i, l) in src.split("\n").indexed() {
    match fn_re.captures(l) {
      Some(c) => cur = c[1] ?? ""
      None => {}
    }
    let t = l.trim()
    if t.starts_with("// func ") {
      // a function of another module (a std runtime module's, as `xo
      // asm` names it: ct.pick), whose code the program pulls in
      cur = t.trim_prefix("// func ").trim()
      continue
    }
    for key in ["arm64", "amd64", "llvm", "llvm/arm64", "llvm/amd64"] {
      let head = "// ${key}: "
      if !t.starts_with(head) {
        continue
      }
      let parts = key.split("/")
      let be = parts[0]
      let arch = parts.get(1) ?? ""
      for m in item.find_all(t[head.len()..]) {
        match item.captures(m) {
          Some(c) => {
            let re = unescape(c[2] ?? "")
            out.push(Pattern{file: file, line: i + 1, func: cur, backend: be, arch: arch, re: re, negate: (c[1] ?? "") == "-"})
          }
          None => {}
        }
      }
    }
  }
  out
}

/// unescape turns the `\"`, `\\`, and `\t` of a quoted pattern into the
/// characters; other escapes stay for the regular expression.
fn unescape(s: Str) -> Str {
  s.replace("\\\"", "\"").replace("\\t", "\t")
}

/// functions cuts the output of `xo asm` into functions by name. An LLVM
/// function's text ends with the attribute groups its `define` line
/// names (`attributes #N = { ... }`), so a pattern checks what a function
/// is (noinline, a frame pointer) and not a group's number, which moves
/// when the backend adds groups.
pub fn functions(backend: Str, code: Str) -> Map[Str, Str] {
  var out: Map[Str, Str] = {}
  var name = ""
  var body: List[Str] = []
  var groups: Map[Str, Str] = {}
  var refs: List[Str] = []
  // the native backends mark each function with a comment line
  let mark = if backend == "amd64" { "# func " } else { "// func " }
  let native = backend == "arm64" || backend == "amd64"
  if !native {
    for l in code.split("\n") {
      if l.starts_with("attributes #") {
        match l.find(" = ") {
          Some(k) => groups[l["attributes ".len()..k]] = l
          None => {}
        }
      }
    }
  }
  for l in code.split("\n") {
    if native {
      if l.starts_with(mark) {
        if !name.is_empty() {
          out[name] = body.join("\n")
        }
        name = l.trim_prefix(mark).trim()
        body = []
        continue
      }
      if !name.is_empty() {
        body.push(l)
      }
    } else {
      if l.starts_with("define ") {
        match l.find("@\"x.") {
          Some(k) => {
            let rest = l[k + 4..]
            name = match rest.find("\"") {
              Some(e) => rest[0..e]
              None => ""
            }
          }
          None => name = ""
        }
        body = []
        refs = []
        for w in l.split(" ") {
          if w.starts_with("#") && groups.contains(w) {
            refs.push(w)
          }
        }
      }
      if !name.is_empty() {
        body.push(l)
        if l == "}" {
          for r in refs {
            if let Some(g) = groups.get(r) {
              body.push(g)
            }
          }
          out[name] = body.join("\n")
          name = ""
        }
      }
    }
  }
  if native && !name.is_empty() {
    out[name] = body.join("\n")
  }
  out
}

/// verify checks the patterns of one backend against its functions.
pub fn verify(ps: List[Pattern], fns: Map[Str, Str]) -> List[Str] {
  var problems: List[Str] = []
  for p in ps {
    let code = match fns.get(p.func) {
      Some(c) => c
      None => {
        problems.push("${p.file}:${p.line}: no ${p.backend} code for function ${p.func.quote()}")
        continue
      }
    }
    match regexp.compile(p.re) {
      Ok(r) => {
        let hit = r.is_match(code)
        if hit && p.negate {
          problems.push("${p.file}:${p.line}: ${p.func}: ${p.backend} code matches -${p.re.quote()}")
        } else if !hit && !p.negate {
          problems.push("${p.file}:${p.line}: ${p.func}: ${p.backend} code does not match ${p.re.quote()}")
        }
      }
      Err(e) => problems.push("${p.file}:${p.line}: bad pattern ${p.re.quote()}: ${e}")
    }
  }
  problems
}

fn codegen_cmd(os: Os, h: Host, args: List[Str]) -> Int uses (clock, env, fs.read, fs.write, proc, stdio) {
  var fl = core.new_flags("dev codegen")
  fl.str_flag("xo", "", "the xo that compiles (default this one)")
  fl.str_flag("backend", "arm64,amd64,llvm", "the backends whose patterns are checked")
  fl.int_flag("j", 4, "programs at once")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.is_empty() {
    os.stdio.eprintln("usage: xo dev codegen [--backend=arm64,amd64,llvm] [-j N] DIR...")
    return 2
  }
  let xo = if fl.get_str("xo").is_empty() { h.xo } else { fl.get_str("xo") }
  let backends = fl.get_str("backend").split(",")
  let dirs = match module_dirs(os.fs, fl.args) {
    Ok(ds) => ds
    Err(e) => {
      os.stdio.eprintln("xo dev codegen: ${e}")
      return 1
    }
  }
  var jobs: List[(Str, Str)] = []
  for d in dirs {
    for b in backends {
      jobs.push((d, b))
    }
  }
  let t0 = os.clock.now()
  let res = task.map_concurrent(jobs, fl.get_int("j").max(1), fn(j: (Str, Str)) {
    let (d, b) = j
    codegen_one(os, h, xo, d, b)
  })
  var fails = 0
  var checked = 0
  for (i, r) in res.indexed() {
    let (n, ps) = match r {
      Ok(x) => x
      Err(_) => (0, ["internal error"])
    }
    checked += n
    let (d, b) = jobs[i]
    if !ps.is_empty() {
      fails += 1
      for p in ps {
        os.stdio.println("FAIL ${d} ${b} ${p}")
      }
    }
  }
  os.stdio.println("${jobs.len()} program builds, ${checked} patterns: ${jobs.len() - fails} pass, ${fails} fail (${os.clock.since(t0).millis()} ms)")
  if fails == 0 { 0 } else { 1 }
}

fn codegen_one(os: Os, h: Host, xo: Str, d: Str, backend: Str) -> (Int, List[Str]) uses (env, fs.read, proc) {
  var ps: List[Pattern] = []
  for e in os.fs.read_dir(d).ok() ?? [] {
    if !e.is_dir && e.name.ends_with(".xo") {
      for p in patterns("${d}/${e.name}", os.fs.read_text("${d}/${e.name}").ok() ?? "") {
        // an architecture's pattern only where the host is it
        if p.backend == backend && (p.arch.is_empty() || h.host.ends_with("/${p.arch}")) {
          ps.push(p)
        }
      }
    }
  }
  if ps.is_empty() {
    return (0, [])
  }
  // the inline verify as the Go tests and xo dev goldens run it
  let strict = os.env.get("XO_INLINE_STRICT") ?? "1"
  let out = match os.proc.cmd(xo, ["asm", "--backend=${backend}", "--std=${h.std}", d]).set_env("XO_LLVM_SPLIT", "1").set_env("XO_INLINE_STRICT", strict).output() {
    Ok(o) => o
    Err(e) => return (ps.len(), ["xo asm: ${e}"])
  }
  if out.code != 0 {
    return (ps.len(), ["xo asm: ${(out.stderr.to_str() ?? "").trim()}"])
  }
  (ps.len(), verify(ps, functions(backend, out.stdout.to_str() ?? "")))
}
