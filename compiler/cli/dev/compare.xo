// What a golden compares (decision 0209): the exit status, the standard
// output byte for byte, and the stable lines of the standard error, laid
// out as want.txt holds them:
//
//   exit N
//   --- stdout
//   <stdout bytes>--- stderr
//   <stable stderr lines>
//
// The one documented stderr filter is the Go tests' and the old Python
// scripts' (internal/llvm stableStderr, scripts/selfhost-goldens.py):
// timestamps become <time>, indented lines (frames) and the
// `crash bundle:` line are dropped, and on the native backends the
// `xo leakcheck:` line too (it is checked separately). The Go backend's
// filter keeps the `  at ` frame lines and drops Go frame pairs from
// both sides before comparing (internal/gen dropGoFrames).

use std/regexp

/// The comparison rules of a backend.
pub struct Rules {
  /// Keep `  at ` lines and drop Go frame pairs (the Go backend).
  pub go_frames: Bool = false
  /// Drop the `xo leakcheck:` line (native backends).
  pub drop_leak: Bool = true
}

/// stable is the stderr filter: the lines that are not indented, with
/// RFC 3339 timestamps replaced, each ending in a newline.
pub fn stable(s: Str, r: Rules) -> Str {
  let t = regexp.must("[0-9]{4}-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9](\\.[0-9]+)?Z").replace_all_literal(s, "<time>")
  var out = StrBuilder.new()
  for l in t.split("\n") {
    if r.go_frames && l.starts_with("  at ") {
      out.write(l)
      out.write("\n")
      continue
    }
    if l.is_empty() || l.starts_with(" ") || l.starts_with("\t") || l.starts_with("crash bundle:") {
      continue
    }
    if r.drop_leak && l.starts_with("xo leakcheck:") {
      continue
    }
    out.write(l)
    out.write("\n")
  }
  out.freeze()
}

/// layout is want.txt's form of a run: the status, stdout as is, and
/// the stable stderr. stderr that is not UTF-8 is kept unfiltered.
pub fn layout(code: Int, stdout: Bytes, stderr: Bytes, r: Rules) -> Bytes {
  var b = BytesBuilder.new()
  b.write_str("exit ${code}\n--- stdout\n")
  b.write(stdout)
  b.write_str("--- stderr\n")
  match stderr.to_str() {
    Some(s) => b.write_str(stable(s, r))
    None => b.write(stderr)
  }
  b.freeze()
}

/// drop_go_frames removes the Go frame pairs (`  x_name` then `  file.xo:N`)
/// of a Go backend run.
fn drop_go_frames(b: Bytes) -> Bytes {
  match b.to_str() {
    Some(s) => regexp.must("(?m)^ +x_[^ \\n]+\\n +[^ \\n]+\\.xo:[0-9]+\\n").replace_all_literal(s, "").bytes()
    None => b
  }
}

/// same reports whether a run's layout matches want.txt byte for byte
/// (Go frame pairs dropped from both for the Go backend).
pub fn same(got: Bytes, want: Bytes, r: Rules) -> Bool {
  if r.go_frames {
    return drop_go_frames(got) == drop_go_frames(want)
  }
  got == want
}

/// leak_problem is what the leak check of a native run that exited 0
/// finds wrong in its stderr: "" when it printed `xo leakcheck: 0 live`.
pub fn leak_problem(stderr: Bytes) -> Str {
  let s = stderr.to_str() ?? ""
  for l in s.split("\n") {
    if l.starts_with("xo leakcheck: ") {
      let n = l.trim_prefix("xo leakcheck: ").split(" ")[0]
      if n == "0" {
        return ""
      }
      return "${n} allocations live"
    }
  }
  "no leak check line"
}

/// first_diff is a short report of where got and want part: the first
/// differing line of each, with its line number.
pub fn first_diff(got: Bytes, want: Bytes) -> Str {
  let g = (got.to_str() ?? got.quote()).split("\n")
  let w = (want.to_str() ?? want.quote()).split("\n")
  var i = 0
  while i < g.len() && i < w.len() && g[i] == w[i] {
    i += 1
  }
  let gl = if i < g.len() { g[i].quote() } else { "(end)" }
  let wl = if i < w.len() { w[i].quote() } else { "(end)" }
  "line ${i + 1}: want ${wl}, got ${gl}"
}
