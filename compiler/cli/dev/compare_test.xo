// Tests of xo dev compare (moved from compare.xo, decision 0262: tests under
// compiler/ live in _test.xo files).

test "stable drops frames and fixes times" {
  let s = "fault: boom at 2026-10-13T01:02:03.5Z\n  at main.xo:3\n\tframe\ncrash bundle: /x\nxo leakcheck: 0 live of 3 allocations\ndone\n"
  expect(stable(s, Rules{}) == "fault: boom at <time>\ndone\n")
  expect(stable(s, Rules{go_frames: true, drop_leak: false}) == "fault: boom at <time>\n  at main.xo:3\nxo leakcheck: 0 live of 3 allocations\ndone\n")
  expect(stable("", Rules{}) == "")
  // a native fault's traceback (by default since 2026-10-22): the header
  // and its indented frames are dropped
  expect(stable("fault: x at main.xo:1:1\ntraceback:\n  main (main.xo:1)\n", Rules{}) == "fault: x at main.xo:1:1\n")
}

test "layout" {
  expect(layout(1, "hi\n".bytes(), "oops\n  frame\n".bytes(), Rules{}) == "exit 1\n--- stdout\nhi\n--- stderr\noops\n".bytes())
}

test "same is byte exact" {
  expect(same("a\r\n".bytes(), "a\r\n".bytes(), Rules{}))
  expect(!same("a\r\n".bytes(), "a\n\n".bytes(), Rules{}))
  let g = "exit 2\n--- stdout\n--- stderr\nfault\n  x_main\n  main.xo:3\n".bytes()
  expect(same(g, "exit 2\n--- stdout\n--- stderr\nfault\n".bytes(), Rules{go_frames: true}))
}

test "leak_problem" {
  expect(leak_problem("xo leakcheck: 0 live of 9 allocations\n".bytes()) == "")
  expect(leak_problem("x\nxo leakcheck: 2 live of 9 allocations\n".bytes()) == "2 allocations live")
  expect(leak_problem("".bytes()) == "no leak check line")
}

test "first_diff" {
  expect(first_diff("a\nb\n".bytes(), "a\nc\n".bytes()) == "line 2: want \"c\", got \"b\"")
}
