// `xo dev dwarf FILE`: what compiler/debug's DWARF reader (decision 0253,
// stage 1) reads from an executable or a dSYM's DWARF file: each function
// with its address range and its variables (name, type, parameter or
// not, declaration line, and each location range with its pieces), the
// global variables, and with --types the types; with --break SPOT the
// addresses a breakpoint at SPOT (FILE:LINE or a function) resolves to,
// and with --pc ADDR the file and line of the code at ADDR, from the line
// tables. The text is for tests and agents; `xo debug` is the command
// built on the reader.

use github.com/xo-lang/xo/compiler/cli/core
use github.com/xo-lang/xo/compiler/debug

fn dwarf_cmd(os: Os, args: List[Str]) -> Int uses (fs.read, stdio) {
  var fl = core.new_flags("dev dwarf")
  fl.str_flag("func", "", "only the functions of this name")
  fl.bool_flag("types", "print the types too")
  fl.str_flag("break", "", "print the addresses of a breakpoint at FILE:LINE or FUNCTION instead")
  fl.str_flag("pc", "", "print the file and line of the code at this address (0x...) instead")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.len() != 1 {
    os.stdio.eprintln("usage: xo dev dwarf [--func=NAME] [--types] FILE (an executable, or a dSYM's DWARF file)")
    return 2
  }
  let data = match os.fs.read(fl.args[0]) {
    Ok(d) => d
    Err(e) => {
      os.stdio.eprintln("xo dev dwarf: ${e}")
      return 1
    }
  }
  let s = match debug.sections(data) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo dev dwarf: ${fl.args[0]}: ${e}")
      return 1
    }
  }
  let info = debug.read(s)
  if !fl.get_str("break").is_empty() || !fl.get_str("pc").is_empty() {
    return lines_query(os, info, debug.lines(s), fl.get_str("break"), fl.get_str("pc"))
  }
  let only = fl.get_str("func")
  for f in info.funcs {
    if !only.is_empty() && f.name != only {
      var calls = false
      for c in f.inlined {
        if c.name == only {
          calls = true
        }
      }
      if !calls {
        continue
      }
    }
    os.stdio.println("func ${f.name} ${hex(f.lo)}..${hex(f.hi)}")
    for v in f.vars {
      print_var(os, info, v, "  ", "  ")
    }
    for c in f.inlined {
      let lead = "  ".repeat(c.depth)
      var rs: List[Str] = []
      for (a, z) in c.ranges {
        rs.push("${hex(a)}..${hex(z)}")
      }
      os.stdio.println("${lead}inlined ${c.name} call line ${c.call_line} ${rs.join(" ")}")
      for v in c.vars {
        print_var(os, info, v, "${lead}  ", "${lead}  ")
      }
    }
  }
  if only.is_empty() {
    for v in info.globals {
      print_var(os, info, v, "global ", "")
    }
  }
  if fl.get_bool("types") {
    var offs: List[Int] = []
    for (k, _) in info.types {
      offs.push(k)
    }
    for k in offs.sort() {
      let t = info.types.get_or_fault(k, "a key of the map")
      os.stdio.println("type ${hex(k)} tag ${hex(t.tag)} ${info.type_name(k)} size ${t.size}${if t.enc != 0 { " enc ${t.enc}" } else { "" }}")
      for m in t.members {
        os.stdio.println("  member ${m.name}: ${info.type_name(m.ty)} at ${m.offset}")
      }
    }
  }
  0
}

/// v on a line after head, its locations below, indented by indent.
fn print_var(os: Os, info: debug.Info, v: debug.Var, head: Str, indent: Str) uses (stdio) {
  let kind = if v.param { "param" } else { "var" }
  os.stdio.println("${head}${kind} ${v.name}: ${info.type_name(v.ty)} line ${v.line}")
  for l in v.locs {
    let range = if l.lo == 0 && l.hi == -1 { "always" } else { "${hex(l.lo)}..${hex(l.hi)}" }
    var ps: List[Str] = []
    for p in l.pieces {
      let at = place(p.place)
      ps.push(if p.size > 0 { "${at} (${p.size})" } else { at })
    }
    os.stdio.println("${indent}  ${range} ${ps.join(", ")}")
  }
}

fn place(p: debug.Place) -> Str {
  match p {
    debug.Place.Reg(n) => "reg${n}"
    debug.Place.Breg(n, o) => "[reg${n}${off(o)}]"
    debug.Place.Fbreg(o) => "[fb${off(o)}]"
    debug.Place.Addr(a) => "[${hex(a)}]"
    debug.Place.Value(v) => "=${v}"
    debug.Place.Gone => "gone"
    debug.Place.Other(op) => "op ${hex(op)}"
  }
}

fn off(o: Int) -> Str {
  if o < 0 { "${o}" } else { "+${o}" }
}

fn hex(v: Int) -> Str {
  if v == 0 {
    return "0x0"
  }
  let digits = "0123456789abcdef"
  var out = ""
  var x = v
  var n = 0
  // an Int's 16 nibbles, high zeros dropped
  while x != 0 && n < 16 {
    let d = x & 15
    out = digits[d..d + 1] + out
    x = x >> 4
    if x < 0 {
      x = x & 0x0fffffffffffffff
    }
    n += 1
  }
  "0x${out}"
}

/// --break and --pc: a breakpoint's addresses, one a line, or the file
/// and line at an address.
fn lines_query(os: Os, info: debug.Info, l: debug.Lines, spot: Str, pc: Str) -> Int uses (stdio) {
  if !spot.is_empty() {
    let sp = match debug.parse_cmd("break ${spot}") {
      Ok(debug.Cmd.Break(x)) => x
      Ok(_) => return 2
      Err(e) => {
        os.stdio.eprintln("xo dev dwarf: ${e}")
        return 2
      }
    }
    match debug.resolve(info, l, sp) {
      Ok(addrs) => {
        for a in addrs {
          os.stdio.println(hex(a))
        }
      }
      Err(e) => {
        os.stdio.eprintln("xo dev dwarf: ${e}")
        return 1
      }
    }
    return 0
  }
  var a = 0
  for c in pc.trim_prefix("0x").runes() {
    let d = "0123456789abcdef".find("${c}".to_lower()) ?? -1
    if d < 0 {
      os.stdio.eprintln("xo dev dwarf: --pc ${pc.quote()}: want a hex address")
      return 2
    }
    a = a * 16 + d
  }
  match l.at(a) {
    Some((f, n)) => os.stdio.println("${f}:${n}")
    None => {
      os.stdio.eprintln("xo dev dwarf: no line at ${hex(a)}")
      return 1
    }
  }
  0
}
