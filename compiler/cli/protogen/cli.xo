// `xo proto gen FILE.proto... [--out=DIR]` (decision 0530): parses each .proto file with std/protoparse
// and writes the Xo source of its messages and enums (`derive Proto`) to DIR/NAME.xo, or to standard
// output when --out is not given and one file is named.

use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/cli/core
use std/path
use std/protoparse

/// Whether name is the command of this package, for the driver's dispatch.
pub fn is_command(name: Str) -> Bool {
  name == "proto"
}

/// Runs `xo proto <args>` (args[0] is "proto") and returns the exit status.
pub fn run(os: Os, args: List[Str]) -> Int uses (fs, stdio) {
  let rest = if args.is_empty() { [] } else { args[1..] }
  if rest.is_empty() || rest[0] != "gen" {
    os.stdio.eprint(cmdhelp.usage("proto"))
    return 2
  }
  var fl = core.new_flags("proto gen")
  fl.str_flag("out", "", "write NAME.xo for each file into this directory (default: standard output, one file only)")
  if !fl.parse(os, rest[1..]) {
    return 2
  }
  if fl.args.is_empty() {
    os.stdio.eprintln("xo proto gen: no .proto files given")
    return 2
  }
  let out = fl.get_str("out")
  if out.is_empty() && fl.args.len() > 1 {
    os.stdio.eprintln("xo proto gen: several files need --out=DIR")
    return 2
  }
  var failed = false
  for file in fl.args {
    let src = match os.fs.read_text(file) {
      Ok(t) => t
      Err(e) => {
        os.stdio.eprintln("xo proto gen: ${file}: ${e}")
        failed = true
        continue
      }
    }
    let text = match generate(src) {
      Ok(t) => t
      Err(e) => {
        os.stdio.eprintln("${file}:${e}")
        failed = true
        continue
      }
    }
    if out.is_empty() {
      os.stdio.print(text)
      continue
    }
    let base = path.base(file)
    let stem = if base.ends_with(".proto") { base[0..base.len() - 6] } else { base }
    let dest = path.join(out, "${stem}.xo")
    match os.fs.create_dir_all(out) {
      Ok(_) => {}
      Err(e) => {
        os.stdio.eprintln("xo proto gen: ${out}: ${e}")
        failed = true
        continue
      }
    }
    match os.fs.write(dest, text.bytes()) {
      Ok(_) => {}
      Err(e) => {
        os.stdio.eprintln("xo proto gen: ${dest}: ${e}")
        failed = true
      }
    }
  }
  if failed { 1 } else { 0 }
}

/// The Xo source for the .proto text `src`, with a header naming the generator.
pub fn generate(src: Str) -> Str ! protoparse.ParseErr {
  let f = protoparse.parse(src)?
  let body = protoparse.gen(f)?
  Ok("// Code generated by xo proto gen. DO NOT EDIT.\n${body}\n")
}
