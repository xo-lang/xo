// `xo repl` (decision 0572, stage 1, experimental): read an entry, add
// it to the session's generated program, build it with this xo, run it,
// and print what the newest entry wrote and its value. Bindings of plain
// data are pinned as literals (session.xo), so earlier entries do not run
// again. The check for types runs in process; the build and the run are
// child processes, the loop decision 0572 measured.
//
//   xo repl [--session=FILE] [--keep] [--eval=ENTRIES]

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/cli/semantic
use github.com/xo-lang/xo/compiler/hostpath
use std/json

pub fn usage() -> Str {
  [
    "usage: xo repl [--session=FILE] [--keep] [--effects=LIST] [--eval=ENTRIES]",
    "",
    "Experimental (decision 0572). Reads Xo entries (an expression, a let or",
    "var, a statement, a fn, struct or enum, a use line), runs each at once,",
    "and prints its output and value. `os` is the program's Os. Bindings of",
    "plain data carry to later entries as values, so an entry's effects run",
    "once; a binding that holds a handle runs its entry again each time.",
    "A fn, struct or enum defined again replaces the earlier one; bindings",
    "and definitions that no longer check with a changed type are dropped,",
    "with a note.",
    "",
    "  --eval=ENTRIES   run ENTRIES (one per line; an open bracket continues",
    "                   an entry) and exit: 1 at the first that fails",
    "  --session=FILE   read the session from FILE and write it back after",
    "  --keep           keep the session directory and print its path",
    "  --effects=LIST   the effects entries may use (`uses (LIST)`, such as",
    "                   stdio,clock or none; stdio always): an entry that",
    "                   needs another is rejected by the checker",
    "",
    "Commands: :type EXPR, :doc NAME, :undo, :reset, :quit; :defs prints the",
    "session's use lines, definitions and bindings; :save FILE writes its",
    "entries to FILE, and :load FILE runs FILE's entries as if typed.",
    "",
    "On a terminal, entries are edited in place: left and right, home and",
    "end (ctrl-a, ctrl-e), alt-b and alt-f by word, backspace, delete,",
    "ctrl-w, ctrl-k and ctrl-u (ctrl-y puts the text back), up and down",
    "between an entry's lines and then through the history (the entries that",
    "start with what is typed), Enter to run a complete entry (an open",
    "bracket continues it; Enter on an empty last line runs it as it is),",
    "ctrl-c to drop the entry, ctrl-d on an empty one to quit, ctrl-l to",
    "clear the screen. The history is <config dir>/xo/repl_history (the last",
    "1000 entries); XO_REPL_HISTORY=off keeps none.",
  ].join("\n") + "\n"
}

struct Opts {
  effects: Str? = None
  eval: Str?
  session: Str
  keep: Bool
}

struct State {
  sess: Sess
  /// the sessions before each kept change, for :undo
  undo: List[Sess]
  dir: Str
  xo: Str
  pc: Map[Str, check.ParseEntry]
  /// the warm-up build (warm_start) and its directory, waited for before
  /// the first entry's build
  warm: Child? = None
  warm_dir: Str = ""
  /// --effects: the entries' `uses` list (decision 0572); None: all of Os
  effects: Str? = None
}

pub fn run(os: Os, args: List[Str]) -> Int uses (clock, env, fs, proc, rand, stdio) {
  var o = Opts{eval: None, session: "", keep: false}
  for a in args {
    if let Some(v) = a.cut_prefix("--eval=") {
      o.eval = Some(v)
    } else if let Some(v) = a.cut_prefix("--effects=") {
      o.effects = Some(v)
    } else if let Some(v) = a.cut_prefix("--session=") {
      o.session = v
    } else if a == "--keep" {
      o.keep = true
    } else if a is "-h" | "--help" {
      os.stdio.print(usage())
      return 0
    } else {
      os.stdio.eprint("xo repl: unknown argument ${a}\n${usage()}")
      return 2
    }
  }
  let dir = match new_dir(os) {
    Ok(d) => d
    Err(e) => {
      os.stdio.eprintln("xo repl: ${e}")
      return 1
    }
  }
  var st = State{sess: Sess{entries: []}, undo: [], dir: dir, xo: os.env.program(), pc: {}, effects: o.effects}
  if !o.session.is_empty() {
    if let Ok(b) = os.fs.read(o.session) {
      match json.decode[Sess](b) {
        Ok(s) => st.sess = s
        Err(e) => {
          os.stdio.eprintln("xo repl: ${o.session}: ${e}")
          return 1
        }
      }
    }
  }
  let code = match o.eval {
    Some(text) => eval_all(os, st, text)
    None => interact(os, st)
  }
  // a session that ended before its first entry: the warm-up's end
  warm_wait(os, st)
  if !o.session.is_empty() {
    match os.fs.write(o.session, json.encode(st.sess)) {
      Ok(_) => {}
      Err(e) => os.stdio.eprintln("xo repl: ${o.session}: ${e}")
    }
  }
  if o.keep {
    os.stdio.eprintln("xo repl: session directory ${dir}")
  } else {
    os.fs.remove_all(dir).ok()
  }
  code
}

fn new_dir(os: Os) -> Str ! Str uses (env, fs) {
  let t = os.fs.create_temp(hostpath.temp_dir(os.env), "xo-repl-").map_err(fn(e) { "${e}" })?
  // create_temp makes a file: a directory of that name instead
  os.fs.remove(t).ok()
  os.fs.create_dir_all(t).map_err(fn(e) { "${e}" })?
  os.fs.write("${t}/xo.mod", "module repl.local/session\nedition preview\n".bytes()).map_err(fn(e) { "${e}" })?
  Ok(t)
}

/// Whether src is a whole entry: every bracket it opens is closed and no
/// string is left open.
pub fn complete(src: Str) -> Bool {
  let b = src.bytes()
  var depth = 0
  var i = 0
  while i < b.len() {
    let c = b[i]
    if c == 0x22 {
      // a string, with its escapes (a ${...} inside is part of it)
      i += 1
      while i < b.len() && b[i] != 0x22 {
        if b[i] == 0x5c {
          i += 1
        }
        i += 1
      }
      if i >= b.len() {
        return false
      }
    } else if c == 0x2f && i + 1 < b.len() && b[i + 1] == 0x2f {
      while i < b.len() && b[i] != 0x0a {
        i += 1
      }
    } else if c is 0x28 | 0x5b | 0x7b {
      depth += 1
    } else if c is 0x29 | 0x5d | 0x7d {
      depth -= 1
    }
    i += 1
  }
  depth <= 0
}

/// ENTRIES split into entries: lines, an entry continuing while it is
/// not complete.
pub fn split_entries(text: Str) -> List[Str] {
  var out: List[Str] = []
  var cur = ""
  for l in text.split("\n") {
    if cur.is_empty() && l.trim().is_empty() {
      continue
    }
    cur = if cur.is_empty() { l } else { "${cur}\n${l}" }
    if complete(cur) {
      out.push(cur)
      cur = ""
    }
  }
  if !cur.trim().is_empty() {
    out.push(cur)
  }
  out
}

fn eval_all(os: Os, var st: State, text: Str) -> Int uses (clock, env, fs, proc, rand, stdio) {
  for e in split_entries(text) {
    if !step(os, st, e) {
      return 1
    }
  }
  0
}

fn interact(os: Os, var st: State) -> Int uses (clock, env, fs, proc, rand, stdio) {
  os.stdio.eprintln("xo repl (experimental, decision 0572): :quit to end, :type EXPR, :doc NAME, :undo, :reset")
  warm_start(os, st)
  // a terminal: the line editor on raw input (decision 0581); else lines
  if os.stdio.stdin_is_tty() && os.stdio.raw_input(true) {
    return interact_edit(os, st)
  }
  var cur = ""
  while {
    os.stdio.eprint(if cur.is_empty() { "xo> " } else { "... " })
    let line = match os.stdio.read_line() {
      Ok(Some(l)) => l
      Ok(None) => return 0
      Err(e) => {
        os.stdio.eprintln("xo repl: ${e}")
        return 1
      }
    }
    if cur.is_empty() && line.trim().is_empty() {
      continue
    }
    // a blank line ends an open entry (it is run as it is)
    cur = if cur.is_empty() { line } else if line.trim().is_empty() { cur } else { "${cur}\n${line}" }
    if !complete(cur) && !line.trim().is_empty() {
      continue
    }
    let e = cur
    cur = ""
    if e.trim() == ":quit" || e.trim() == ":q" {
      return 0
    }
    step(os, st, e)
  }
  0
}

/// The session on a terminal in raw input (decision 0572 stage 2 step 1):
/// line.xo edits each entry with history and continuation lines; raw
/// input is off while an entry runs, so ctrl-c interrupts it and a
/// program that reads standard input reads lines.
fn interact_edit(os: Os, var st: State) -> Int uses (clock, env, fs, proc, rand, stdio) {
  let hpath = hist_path(os)
  var hist: List[Str] = []
  if let Some(p) = hpath {
    if let Ok(t) = os.fs.read_text(p) {
      hist = hist_parse(t)
    }
  }
  var e = editor(hist)
  os.stdio.eprint(draw(e, "xo> ", "... "))
  var pend: Bytes = b""
  var code = 0
  var done = false
  while !done {
    let got = match os.stdio.read_bytes(64) {
      Ok(Some(b)) => b
      Ok(None) => break
      Err(err) => {
        os.stdio.eprintln("xo repl: ${err}")
        code = 1
        break
      }
    }
    pend = pend + got
    while !pend.is_empty() && !done {
      let (k, n) = decode(pend)
      if n == 0 {
        break
      }
      pend = pend[n..]
      match key(e, k) {
        Act.None => os.stdio.eprint(draw(e, "xo> ", "... "))
        Act.Submit(text: t) => {
          os.stdio.eprint("${draw(e, "xo> ", "... ")}${leave(e)}")
          remember(e, t)
          save_hist(os, hpath, e.hist)
          reset(e)
          if t.trim() == ":quit" || t.trim() == ":q" {
            done = true
          } else {
            let _off = os.stdio.raw_input(false)
            step(os, st, t)
            let _on = os.stdio.raw_input(true)
            os.stdio.eprint(draw(e, "xo> ", "... "))
          }
        }
        Act.Cancel => {
          os.stdio.eprint("^C${leave(e)}")
          reset(e)
          os.stdio.eprint(draw(e, "xo> ", "... "))
        }
        Act.Eof => {
          os.stdio.eprint(leave(e))
          done = true
        }
        Act.Clear => {
          os.stdio.eprint("\x1b[H\x1b[2J")
          cleared(e)
          os.stdio.eprint(draw(e, "xo> ", "... "))
        }
      }
    }
  }
  let _r = os.stdio.raw_input(false)
  code
}

/// The history file, <config dir>/xo/repl_history; None when
/// XO_REPL_HISTORY=off or there is no config directory.
fn hist_path(os: Os) -> Str? uses env {
  if os.env.get("XO_REPL_HISTORY") == Some("off") {
    return None
  }
  match os.env.config_dir() {
    Ok(d) => Some("${d}/xo/repl_history")
    Err(_) => None
  }
}

fn save_hist(os: Os, path: Str?, hist: List[Str]) uses fs {
  if let Some(p) = path {
    let dir = p.rfind("/").map(fn(i) { p[..i] }) ?? "."
    os.fs.create_dir_all(dir).ok()
    os.fs.write(p, hist_text(hist).bytes()).ok()
  }
}

/// Starts the warm-up (decision 0572 stage 2): a build, in a directory of
/// its own, of a session program with one entry that prints values the
/// way an entry does, so std's functions that every entry uses are in the
/// front end and back end caches (a fresh xo's are empty: its first
/// entry took 165 to 320 ms more) and the cache's hint names the
/// session's variant, while the person types the first entry.
/// XO_REPL_WARM=0 starts none.
fn warm_start(os: Os, var st: State) uses (env, fs, proc, rand) {
  if (os.env.get("XO_REPL_WARM") ?? "") == "0" {
    return
  }
  let wd = match new_dir(os) {
    Ok(d) => d
    Err(_) => return
  }
  let s0 = Sess{entries: []}
  let (prog, _) = s0.program(Entry{src: "[1, 2].len() + \"ab\".len()", kind: Kind.Expr, pin: "", typ: ""})
  if os.fs.write("${wd}/main.xo", prog.bytes()).is_err() {
    os.fs.remove_all(wd).ok()
    return
  }
  // std's two concurrency variants first, in the foreground: a fresh xo
  // misses them, and a plain build would start their build in a detached
  // child the first entry cannot wait for (host 1, 2026-11-08: entries
  // raced it and took 0.5 to 1.2 s); then the sample program, which
  // fills the front end and back end caches the entries read
  let script = "\"$0\" dev stdcache --conc=0 >/dev/null; \"$0\" dev stdcache --conc=1 >/dev/null; XO_SEPCOMP_BG=0 \"$0\" build -o \"$1/session\" \"$1\""
  match os.proc.cmd("/bin/sh", ["-c", script, st.xo, wd]).merge_stderr().spawn() {
    Ok(ch) => {
      st.warm = Some(ch)
      st.warm_dir = wd
    }
    Err(_) => os.fs.remove_all(wd).ok()
  }
}

/// Waits for the warm-up build to end (its output read and dropped) and
/// removes its directory; nothing when none runs.
fn warm_wait(os: Os, var st: State) uses (fs, proc) {
  if let Some(ch) = st.warm {
    while {
      match ch.read(65536) {
        Ok(Some(_)) => {}
        _ => break
      }
    }
    ch.wait().ok()
    st.warm = None
    os.fs.remove_all(st.warm_dir).ok()
    st.warm_dir = ""
  }
}

/// Runs one entry or command; false when it failed.
fn step(os: Os, var st: State, src: Str) -> Bool uses (clock, env, fs, proc, rand, stdio) {
  let t = src.trim()
  if t.starts_with(":") {
    return command(os, st, t)
  }
  let e = Entry{src: src, kind: classify(src), pin: "", typ: ""}
  // XO_REPL_TIMES=1: each step's wall time on stderr
  let timing = (os.env.get("XO_REPL_TIMES") ?? "") == "1"
  var tries = 0
  // a type defined again (decision 0572 stage 2): the bindings of the old
  // type run their entries again (a pin's Debug text is the old shape)
  let redef = if e.kind is Def && defines_type(src) { def_name(src) } else { "" }
  let before = st.sess
  var stale: List[Str] = []
  if !redef.is_empty() {
    for x in st.sess.entries {
      if let Bind(name: n, mutable: _) = x.kind {
        if mentions_type(x.typ, redef) && !stale.contains(n) {
          stale.push(n)
          st.sess = st.sess.unpin(n)
        }
      }
    }
  }
  while {
    let (prog0, at0) = st.sess.program(e)
    let (prog, at) = with_effects(prog0, at0, st.effects)
    let main = "${st.dir}/main.xo"
    if let Err(err) = os.fs.write(main, prog.bytes()) {
      os.stdio.eprintln("xo repl: ${err}")
      return false
    }
    let bin = "${st.dir}/session"
    // (the warm-up first: two builds at once share the work of neither)
    let tw = os.clock.now()
    warm_wait(os, st)
    if timing && tries == 0 && os.clock.since(tw).nanos() > 1000000 {
      os.stdio.eprintln("xo repl: waited ${os.clock.since(tw).nanos() / 1000000} ms for the warm-up")
    }
    let tb = os.clock.now()
    let b = match os.proc.cmd(st.xo, ["build", "-o", bin, st.dir]).output() {
      Ok(r) => r
      Err(err) => {
        os.stdio.eprintln("xo repl: ${st.xo} build: ${err}")
        return false
      }
    }
    let msg = (b.stderr.to_str() ?? "") + (b.stdout.to_str() ?? "")
    if b.code != 0 && e.kind is Use && unused_only(msg) {
      // a use line no entry refers to yet: its path checked, it is kept
      st.undo.push(st.sess)
      st.sess = st.sess.after(e, {}, {})
      return true
    }
    if b.code != 0 {
      let (text, earlier) = map_diags(msg, main, at)
      if earlier && tries == 0 && st.sess.entries.any(fn(x) { !x.pin.is_empty() }) {
        // a pinned literal did not check (a Debug text that is not a
        // literal): those bindings run their entries again from now on
        for n in st.sess.bound() {
          st.sess = st.sess.unpin(n)
        }
        tries += 1
        continue
      }
      if earlier && !redef.is_empty() && tries < 2 {
        // earlier entries do not check with the new type: the bindings of
        // the type and the definitions that use it go (define them again)
        for n in stale {
          os.stdio.eprintln("xo repl: dropped `${n}`: its type ${redef} changed and its entry does not check with the new one")
        }
        let defs = st.sess.defs_using(redef)
        for n in defs {
          os.stdio.eprintln("xo repl: dropped the definition of `${n}`: it uses ${redef}, which changed; define it again")
        }
        st.sess = st.sess.drop_bindings(stale).drop_defs(defs)
        stale = []
        tries = 2
        continue
      }
      os.stdio.eprint(text)
      st.sess = before
      return false
    }
    let build_ms = os.clock.since(tb).nanos() / 1000000
    let tr = os.clock.now()
    let r = match os.proc.cmd(bin, []).output() {
      Ok(r) => r
      Err(err) => {
        os.stdio.eprintln("xo repl: run: ${err}")
        return false
      }
    }
    let run_ms = os.clock.since(tr).nanos() / 1000000
    let ran = parse_run(r.stdout.to_str() ?? "")
    os.stdio.print(ran.out)
    os.stdio.eprint(r.stderr.to_str() ?? "")
    if r.code != 0 {
      os.stdio.eprintln("(exit status ${r.code}; the entry is not kept)")
      return false
    }
    if let Some(v) = ran.value {
      if v != "()" {
        os.stdio.println(v)
      }
    }
    var types: Map[Str, Str] = {}
    let tt = os.clock.now()
    if let Bind(name: n, mutable: _) = e.kind {
      let first = src.split("\n")[0]
      let col = (first.find(n) ?? 0) + 1
      match type_of(os, st, main, at, col) {
        Ok(ty) => types[n] = ty
        Err(_) => {}
      }
    }
    if timing {
      os.stdio.eprintln("xo repl: build ${build_ms} ms, run ${run_ms} ms, types ${os.clock.since(tt).nanos() / 1000000} ms")
    }
    if !(e.kind is Expr) {
      st.undo.push(st.sess)
    }
    st.sess = st.sess.after(e, ran.pins, types)
    // a binding that is not plain data (a handle, a closure) has no pin:
    // say once, when it is bound, that its entry runs again
    if let Bind(name: n, mutable: _) = e.kind {
      for x in st.sess.entries {
        let same = if let Bind(name: m, mutable: _) = x.kind { m == n } else { false }
        if same && x.pin.is_empty() && !x.typ.is_empty() {
          os.stdio.eprintln("xo repl: `${n}` is a ${x.typ}, not plain data: its entry runs again before each later entry (its effects too)")
        }
      }
    }
    return true
  }
  false
}

/// The type at line:col of the session's main.xo, from an in-process
/// check (std's parsed files kept across entries).
fn type_of(os: Os, var st: State, main: Str, line: Int, col: Int) -> Str ! Str uses (env, fs, proc) {
  let s = semantic.load_session_pc(os, [st.dir], true, {}, [], false, st.pc, semantic.Bodies.All)?
  st.pc = s.c.parse_cache
  let r = s.type_at(main, line, col)?
  Ok(r.typ)
}

/// The build's diagnostics with main.xo's lines given as the entry's
/// (`entry:L:C`) or the session's; and whether one points before the
/// entry (at an earlier entry or a pinned literal).
/// Whether every error in a build's output is an unused import.
pub fn unused_only(msg: Str) -> Bool {
  var any = false
  for l in msg.lines() {
    if l.contains(": error XO") {
      if !(l.contains("error XO0110") && l.contains("import")) {
        return false
      }
      any = true
    }
  }
  any
}

pub fn map_diags(msg: Str, main: Str, at: Int) -> (Str, Bool) {
  var b = StrBuilder.new()
  var earlier = false
  for l in msg.split("\n") {
    var out = l
    for p in [main, "main.xo"] {
      if let Some(rest) = l.cut_prefix("${p}:") {
        if let Some((ln, tail)) = rest.cut(":") {
          if let Some(n) = Int.parse(ln) {
            if n >= at {
              out = "entry:${n - at + 1}:${tail}"
            } else {
              out = "session:${n}:${tail}"
              earlier = true
            }
          }
        }
        break
      }
    }
    b.write(out)
    b.write("\n")
  }
  (b.freeze().trim_end() + "\n", earlier)
}

fn command(os: Os, var st: State, t: Str) -> Bool uses (clock, env, fs, proc, rand, stdio) {
  if t == ":reset" {
    st.undo.push(st.sess)
    st.sess = Sess{entries: []}
    return true
  }
  if t == ":undo" {
    if st.undo.is_empty() {
      os.stdio.eprintln("xo repl: nothing to undo")
      return false
    }
    st.sess = st.undo[st.undo.len() - 1]
    st.undo = st.undo[..st.undo.len() - 1]
    return true
  }
  if let Some(x) = t.cut_prefix(":type ") {
    let e = Entry{src: x, kind: Kind.Expr, pin: "", typ: ""}
    let (prog0, at0) = st.sess.program(e)
    let (prog, at) = with_effects(prog0, at0, st.effects)
    let main = "${st.dir}/main.xo"
    if let Err(err) = os.fs.write(main, prog.bytes()) {
      os.stdio.eprintln("xo repl: ${err}")
      return false
    }
    match type_of(os, st, main, at, 5) {
      Ok(ty) => {
        os.stdio.println(ty)
        return true
      }
      Err(err) => {
        os.stdio.eprintln("xo repl: :type: ${err}")
        return false
      }
    }
  }
  if t == ":defs" {
    os.stdio.print(st.sess.defs_text())
    return true
  }
  if let Some(x) = t.cut_prefix(":save ") {
    let path = x.trim()
    match os.fs.write(path, st.sess.source().bytes()) {
      Ok(_) => {
        os.stdio.eprintln("xo repl: saved ${st.sess.entries.len()} entries to ${path}")
        return true
      }
      Err(err) => {
        os.stdio.eprintln("xo repl: :save: ${err}")
        return false
      }
    }
  }
  if let Some(x) = t.cut_prefix(":load ") {
    let path = x.trim()
    let text = match os.fs.read_text(path) {
      Ok(s) => s
      Err(err) => {
        os.stdio.eprintln("xo repl: :load: ${err}")
        return false
      }
    }
    // each entry as if typed; the first that fails stops the load
    var n = 0
    for e in split_entries(text) {
      if e.trim().starts_with(":") {
        continue
      }
      if !step(os, st, e) {
        os.stdio.eprintln("xo repl: :load ${path}: stopped at entry ${n + 1}; the ${n} before it are kept")
        return false
      }
      n += 1
    }
    os.stdio.eprintln("xo repl: loaded ${n} entries from ${path}")
    return true
  }
  if let Some(x) = t.cut_prefix(":doc ") {
    match os.proc.cmd(st.xo, ["doc", x.trim()]).output() {
      Ok(r) => {
        os.stdio.print(r.stdout.to_str() ?? "")
        os.stdio.eprint(r.stderr.to_str() ?? "")
        return r.code == 0
      }
      Err(err) => {
        os.stdio.eprintln("xo repl: :doc: ${err}")
        return false
      }
    }
  }
  os.stdio.eprintln("xo repl: unknown command ${t} (:type EXPR, :doc NAME, :defs, :save FILE, :load FILE, :undo, :reset, :quit)")
  false
}
