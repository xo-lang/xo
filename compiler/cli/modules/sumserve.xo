// `xo mod sumdb keygen <name> <key file>` and `xo mod sumdb serve
// --key=<key file> [--addr=host:port] [--fetch] <data dir>` (decision
// 0124): a checksum log over the protocol sumdb.xo's client reads, the
// Go internal/sumdb Server and GenerateKey the Go compiler took with it
// (decision 0215), with the records kept in <data dir>/records so a
// restarted log serves the same tree (an in-memory log that restarts is
// a rewrite every client of it reports as XO1313).
//
//   GET /latest                     the signed tree head
//   GET /lookup/<path>@<version>    "<record id>\n<record>\n<signed tree head>"
//   GET /proof/inclusion/<id>/<n>   audit path of record id in the tree of n records
//   GET /proof/consistency/<m>/<n>  proof that the tree of m records prefixes that of n
//
// Paths and versions are escaped as in the module cache. A record is the
// two xo.lock lines of a module version, newline terminated; proofs are
// base64 hashes, one per line; an unknown version is 404.

use github.com/xo-lang/xo/compiler/check
use std/crypto
use std/http

/// A log's private key (sumdb.Signer): PRIVATE+KEY+<name>+<key id>+<base64
/// Ed25519 seed>.
struct Signer {
  name: Str
  id: Int
  seed: Bytes
}

/// The records of a log and their leaf hashes (sumdb.Server's fields).
struct LogState {
  records: List[Str] = []
  leaves: List[Bytes] = []
  /// "<path>@<version>" to record id
  index: Map[Str, Int] = {}
  /// the tree hash of all the leaves
  root: Bytes = b""
  /// when each record was added, Unix seconds (0 for a record from
  /// before the log kept times)
  times: List[Int] = []
}

/// What `xo mod sumdb serve` was started with.
struct LogConf {
  signer: Signer
  data: Str
  fetch: Bool
  /// the bucket every new record is copied to before it is added
  copy: Bucket? = None
  /// lookups that add a version, per client and minute; 0 is no limit
  rate: Int = 0
  /// the proxy bucket each version the log adds is written to
  fill: Bucket? = None
  /// how often every module's @v/list in the fill bucket is refreshed
  /// from its repository's tags (--refresh); None for never
  refresh: Duration? = None
  /// the @v/list body last written per module path (refresh_list)
  lists: Mutex[Map[Str, Str]]
  /// the "<path>@<version>" uploads to the fill bucket not yet finished,
  /// as in <data dir>/fill-pending (fill_logged)
  pending: Mutex[Map[Str, Bool]]
}

/// The 32 bit value id as 4 big endian bytes.
fn be32_bytes(id: Int) -> Bytes {
  var b = BytesBuilder.new()
  b.write_byte(UInt8((id >> 24) & 255))
  b.write_byte(UInt8((id >> 16) & 255))
  b.write_byte(UInt8((id >> 8) & 255))
  b.write_byte(UInt8(id & 255))
  b.freeze()
}

/// sumdb.GenerateKey's two keys for seed: (signer, verifier).
fn log_keys(name: Str, seed: Bytes) -> (Str, Str) {
  let pub_key = crypto.ed25519_public_key(seed)
  let id = hex8(key_id(name, pub_key))
  ("PRIVATE+KEY+${name}+${id}+${seed.to_base64()}", "${name}+${id}+${pub_key.to_base64()}")
}

/// sumdb.ParseSigner.
fn parse_signer(s: Str) -> Signer ! Str {
  let parts = split_n(s.trim(), "+", 5)
  if parts.len() != 5 || parts[0] != "PRIVATE" || parts[1] != "KEY" || !valid_log_name(parts[2]) {
    return Err("malformed signer key: want PRIVATE+KEY+<name>+<key id>+<base64 seed>")
  }
  let id = parse_key_id(parts[3])?
  let seed = Bytes.from_base64(parts[4]) ?? b""
  if seed.len() != 32 {
    return Err("malformed signer key: the seed is not 32 base64 bytes")
  }
  if key_id(parts[2], crypto.ed25519_public_key(seed)) != id {
    return Err("signer key: the key id does not match the name and key")
  }
  Ok(Signer{name: parts[2], id: id, seed: seed})
}

/// Signer.SignTree: the tree head text, a blank line, and the signature.
fn sign_tree(s: Signer, t: Tree) -> Str {
  let text = tree_text(s.name, t)
  let sig = crypto.ed25519_sign(s.seed, text.bytes())
  "${text}\nsig ${s.name} ${(be32_bytes(s.id) + sig).to_base64()}\n"
}

/// The empty tree's hash, SHA-256 of nothing.
fn empty_tree_hash() -> Bytes {
  crypto.sha256(b"")
}

/// The largest power of two below n (n >= 2).
fn split_point(n: Int) -> Int {
  var k = 1
  while k * 2 < n {
    k *= 2
  }
  k
}

/// TreeHash: the Merkle tree hash of leaves[lo..hi] (RFC 6962 2.1, MTH).
fn tree_hash(leaves: List[Bytes], lo: Int, hi: Int) -> Bytes {
  let n = hi - lo
  if n == 0 {
    return empty_tree_hash()
  }
  if n == 1 {
    return leaves[lo]
  }
  let k = split_point(n)
  node_hash(tree_hash(leaves, lo, lo + k), tree_hash(leaves, lo + k, hi))
}

/// InclusionProof: the audit path of leaf lo + i in the tree of
/// leaves[lo..hi] (RFC 6962 2.1.1, PATH).
fn inclusion_proof(leaves: List[Bytes], lo: Int, hi: Int, i: Int, var out: List[Bytes]) {
  let n = hi - lo
  if n <= 1 {
    return
  }
  let k = split_point(n)
  if i < k {
    inclusion_proof(leaves, lo, lo + k, i, out)
    out.push(tree_hash(leaves, lo + k, hi))
  } else {
    inclusion_proof(leaves, lo + k, hi, i - k, out)
    out.push(tree_hash(leaves, lo, lo + k))
  }
}

/// ConsistencyProof's subproof: the tree of the first m of leaves[lo..hi]
/// against all of them (RFC 6962 2.1.2, SUBPROOF).
fn subproof(leaves: List[Bytes], lo: Int, hi: Int, m: Int, whole: Bool, var out: List[Bytes]) {
  let n = hi - lo
  if m == n {
    if !whole {
      out.push(tree_hash(leaves, lo, hi))
    }
    return
  }
  let k = split_point(n)
  if m <= k {
    subproof(leaves, lo, lo + k, m, whole, out)
    out.push(tree_hash(leaves, lo + k, hi))
  } else {
    subproof(leaves, lo + k, hi, m - k, false, out)
    out.push(tree_hash(leaves, lo, lo + k))
  }
}

/// ConsistencyProof: the tree of the first m of the first n leaves is a
/// prefix of the tree of all n (empty when m is 0 or n).
fn consistency_proof(leaves: List[Bytes], m: Int, n: Int) -> List[Bytes] {
  var out: List[Bytes] = []
  if m > 0 && m < n {
    subproof(leaves, 0, n, m, true, out)
  }
  out
}

/// Server.add: appends the record of key unless the log holds one; the
/// record's id either way. The caller updates root.
fn (var st: LogState) add(key: Str, record: Str) -> Int {
  if let Some(id) = st.index.get(key) {
    return id
  }
  let id = st.records.len()
  st.records.push(record)
  st.leaves.push(record_hash(record.bytes()))
  st.index[key] = id
  id
}

/// The "<path>@<version>" of a record (its first line's first two fields),
/// "" when the record is malformed.
fn record_key(record: Str) -> Str {
  let lines = record.trim_suffix("\n").split("\n")
  if lines.len() != 2 {
    return ""
  }
  let a = check.fields(lines[0])
  let b = check.fields(lines[1])
  if a.len() != 3 || b.len() != 3 || b[0] != a[0] || b[1] != "${a[1]}/xo.mod" {
    return ""
  }
  "${a[0]}@${a[1]}"
}

/// The records file of a data directory: two lines per record, in log
/// order. Read once at start; a record is appended (and synced) before
/// any tree head that holds it is signed.
fn records_file(data: Str) -> Str {
  "${data}/records"
}

/// One Unix time per line, the time each record was added.
fn times_file(data: Str) -> Str {
  "${data}/times"
}

/// The versions the log added whose upload to the --fill-to bucket has
/// not finished, one "<path>@<version>" per line, sorted: rewritten with
/// the version before its upload starts and without it once the upload
/// succeeds, so a failed or interrupted one (an R2 error, a restart) is
/// retried at the start and on every --refresh tick.
fn pending_file(data: Str) -> Str {
  "${data}/fill-pending"
}

/// The pending uploads in data's fill-pending (none when it is missing).
fn (c: ModCtx) load_pending(data: Str) -> Map[Str, Bool] uses fs.read {
  var m: Map[Str, Bool] = {}
  let text = (c.os.fs.read(pending_file(data)).ok() ?? b"").to_str() ?? ""
  for l in text.split("\n") {
    if !l.trim().is_empty() {
      m[l.trim()] = true
    }
  }
  m
}

/// Replaces data's fill-pending with m (a temporary file renamed over it).
fn (c: ModCtx) save_pending(data: Str, m: Map[Str, Bool]) -> () ! Str uses fs {
  var body = ""
  for k in m.keys().sort() {
    body += "${k}\n"
  }
  let tmp = "${pending_file(data)}.tmp"
  c.os.fs.write(tmp, body.bytes()).map_err(fs_msg)?
  c.os.fs.rename(tmp, pending_file(data)).map_err(fs_msg)
}

/// Uploads path@version to the fill bucket (from the log's cache, fetched
/// again when the cache lost it) and rewrites its @v/list, recorded in
/// fill-pending until the files are written; errors go to standard error.
fn (var c: ModCtx) fill_logged(conf: LogConf, fb: Bucket, path: Str, version: Str) uses (fs, net, proc, rand, clock, stdio) {
  let key = "${path}@${version}"
  let data = conf.data
  let root = "${data}/cache"
  let cc = c
  let mark = fn(on: Bool) {
    conf.pending.with(fn(var m) {
      if on {
        m[key] = true
      } else {
        m.remove(key)
      }
      if let Err(e) = cc.save_pending(data, m) {
        cc.os.stdio.eprintln("xo mod sumdb serve: ${pending_file(data)}: ${e}")
      }
    })
  }
  mark(true)
  let dir = version_dir_in(root, path, version)
  let done = if c.exists("${dir}/xo.mod") { c.fill_files(fb, dir, path, version) } else { c.fill_version(fb, root, path, version) }
  match done {
    Ok(_) => mark(false)
    Err(e) => c.os.stdio.eprintln("xo mod sumdb serve: fill ${path} ${version}: ${e} (retried later; ${pending_file(data)})")
  }
  match c.refresh_list(fb, root, path, conf.lists) {
    Ok(_) => {}
    Err(e) => c.os.stdio.eprintln("xo mod sumdb serve: fill ${path} list: ${e}")
  }
}

/// Retries every upload in fill-pending, oldest name first.
fn (var c: ModCtx) retry_pending(conf: LogConf, fb: Bucket) uses (fs, net, proc, rand, clock, stdio) {
  let keys = conf.pending.with_read(fn(m) { m.keys().sort() })
  for k in keys {
    let (path, version, ok) = cut(k, "@")
    if ok {
      c.fill_logged(conf, fb, path, version)
    }
  }
}

/// The bucket object holding a copy of record id: "<time>\n<record>".
fn record_object(id: Int) -> Str {
  var s = "${id}"
  while s.len() < 10 {
    s = "0${s}"
  }
  "records/${s}"
}

fn (c: ModCtx) load_log(data: Str) -> LogState ! Str uses fs.read {
  var st = LogState{}
  let p = records_file(data)
  if !c.exists(p) {
    st.root = empty_tree_hash()
    return Ok(st)
  }
  let text = (c.os.fs.read(p).map_err(fs_msg)?).to_str() ?? ""
  if !text.is_empty() && !text.ends_with("\n") {
    return Err("${p}: the last record is incomplete (a write was cut short); restore the file from a backup")
  }
  let lines = check_lines(text.bytes())
  if lines.len() % 2 != 0 {
    return Err("${p}: an odd number of lines; every record is two")
  }
  var i = 0
  while i < lines.len() {
    let rec = "${lines[i]}\n${lines[i + 1]}\n"
    let key = record_key(rec)
    if key.is_empty() {
      return Err("${p}:${i + 1}: malformed record")
    }
    if st.index.get(key) != None {
      return Err("${p}:${i + 1}: a second record of ${key}")
    }
    st.add(key, rec)
    i += 2
  }
  st.root = tree_hash(st.leaves, 0, st.leaves.len())
  let tp = times_file(data)
  if c.exists(tp) {
    let tl = check_lines(c.os.fs.read(tp).map_err(fs_msg)?)
    if tl.len() > st.records.len() {
      return Err("${tp}: more lines than ${p} has records")
    }
    for (k, l) in tl.indexed() {
      match Int.parse(l) {
        Some(t) => st.times.push(t)
        None => return Err("${tp}:${k + 1}: not a Unix time")
      }
    }
  }
  while st.times.len() < st.records.len() {
    st.times.push(0)
  }
  Ok(st)
}

/// Appends data to the file at p and syncs it.
fn (c: ModCtx) append_synced(p: Str, data: Bytes) -> () ! Str uses fs {
  let f = c.os.fs.open_append(p).map_err(fs_msg)?
  var r = f.write(data)
  if r.is_ok() {
    r = f.sync()
  }
  f.close().ignore_err("the write's own error, if any, is the one reported")
  r.map_err(fs_msg)
}

/// The record, then its time (a time lost to a crash between the two
/// reads back as 0).
fn (c: ModCtx) append_record(data: Str, record: Str, time: Int) -> () ! Str uses fs {
  c.append_synced(records_file(data), record.bytes())?
  c.append_synced(times_file(data), "${time}\n".bytes())
}

fn (var c: ModCtx) run_mod_sumdb(args: List[Str]) -> Int uses (fs, net, proc, stdio, rand, clock) {
  if args.len() >= 1 && args[0] == "keygen" {
    return c.run_sumdb_keygen(args[1..])
  }
  if args.len() >= 1 && args[0] == "restore" {
    return c.run_sumdb_restore(args[1..])
  }
  if args.is_empty() || args[0] != "serve" {
    c.os.stdio.eprintln("xo mod sumdb: want `keygen <name> <key file>`, `serve --key=<key file> [--addr=127.0.0.1:7071] [--fetch] [--copy-to=<bucket URL>] [--rate=60] <data dir>`, or `restore --from=<bucket URL> <data dir>`")
    return 2
  }
  var fl = FlagSet{name: "mod sumdb serve", defs: [flag_str("key", "", "the file holding the log's signer key (from xo mod sumdb keygen)"), flag_str("addr", "127.0.0.1:7071", "the address to listen on"), flag_bool("fetch", "add a module version the log lacks by fetching it from git"), flag_str("copy-to", "", "a bucket (https://<endpoint>/<bucket>) every new record is copied to before it is added"), flag_str("region", "auto", "the region bucket requests are signed for"), flag_str("rate", "60", "lookups that add a version, per client and minute (0: no limit)"), flag_str("fill-to", "", "a proxy bucket (https://<endpoint>/<bucket>) each version the log adds is written to, as xo mod proxy fill does"), flag_str("refresh", "", "how often (a duration: 30m) every module's @v/list in the --fill-to bucket is rewritten from its repository's tags; never when empty")]}
  if !c.parse_flags(fl, args[1..]) {
    return 2
  }
  if fl.args.len() != 1 || fl.str("key").is_empty() {
    c.os.stdio.eprintln("xo mod sumdb serve: want --key=<key file> and one data directory")
    return 2
  }
  let key_text = match c.os.fs.read(c.abs(fl.str("key"))) {
    Ok(b) => b.to_str() ?? ""
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb serve: ${fs_msg(e)}")
      return 1
    }
  }
  let signer = match parse_signer(key_text) {
    Ok(s) => s
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb serve: ${fl.str("key")}: ${e}")
      return 1
    }
  }
  let rate = Int.parse(fl.str("rate")) ?? -1
  if rate < 0 {
    c.os.stdio.eprintln("xo mod sumdb serve: --rate=${fl.str("rate")} is not a count")
    return 2
  }
  var copy: Bucket? = None
  if !fl.str("copy-to").is_empty() {
    match c.bucket_of(fl.str("copy-to"), fl.str("region")) {
      Ok(b) => copy = Some(b)
      Err(e) => {
        c.os.stdio.eprintln("xo mod sumdb serve: --copy-to: ${e}")
        return 2
      }
    }
  }
  var fill: Bucket? = None
  if !fl.str("fill-to").is_empty() {
    match c.bucket_of(fl.str("fill-to"), fl.str("region")) {
      Ok(b) => fill = Some(b)
      Err(e) => {
        c.os.stdio.eprintln("xo mod sumdb serve: --fill-to: ${e}")
        return 2
      }
    }
  }
  var refresh: Duration? = None
  if !fl.str("refresh").is_empty() {
    match Duration.parse(fl.str("refresh")) {
      Ok(d) if d.millis() >= 1000 => refresh = Some(d)
      _ => {
        c.os.stdio.eprintln("xo mod sumdb serve: --refresh=${fl.str("refresh")} is not a duration of 1s or more")
        return 2
      }
    }
    if fill is None {
      c.os.stdio.eprintln("xo mod sumdb serve: --refresh needs --fill-to (the bucket whose lists it refreshes)")
      return 2
    }
  }
  let data = c.abs(fl.args[0])
  match c.os.fs.create_dir_all(data) {
    Ok(_) => {}
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb serve: ${fs_msg(e)}")
      return 1
    }
  }
  let st = match c.load_log(data) {
    Ok(s) => s
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb serve: ${e}")
      return 1
    }
  }
  let l = match c.os.net.listen(fl.str("addr")) {
    Ok(x) => x
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb serve: ${e}")
      return 1
    }
  }
  let fetch = fl.on("fetch")
  let (_, verifier) = log_keys(signer.name, signer.seed)
  let mode = if fetch { "adding versions from git" } else { "serving its records only" }
  c.out("checksum log ${signer.name} (${st.records.len()} records in ${data}, ${mode}) at http://${l.addr()}\nclients: XO_SUMDB='${verifier} http://${l.addr()}'\n")
  let state = Mutex.new(st)
  let limits: Mutex[Map[Str, (Int, Int)]] = Mutex.new({})
  let conf = LogConf{signer: signer, data: data, fetch: fetch, copy: copy, rate: rate, fill: fill, refresh: refresh, lists: Mutex.new({}), pending: Mutex.new(c.load_pending(data))}
  let cc = c
  if let Some(fb) = fill {
    // uploads a restart or an error interrupted
    if conf.pending.with_read(fn(m) { m.len() }) > 0 {
      c.os.tasks.spawn_background(fn() {
        var rc = cc
        rc.retry_pending(conf, fb)
      })
    }
  }
  if let Some(d) = refresh {
    if let Some(fb) = fill {
      // a new tag reaches @v/list within d, whether or not anyone looked
      // the version up (a stale list would answer @latest with an older
      // version, and a client falls back to git only on a 404)
      c.os.tasks.spawn_background(fn() {
        var rc = cc
        while true {
          rc.os.clock.sleep(d)
          rc.retry_pending(conf, fb)
          let paths = state.with_read(fn(st) { log_paths(st) })
          for p in paths {
            match rc.refresh_list(fb, "${data}/cache", p, conf.lists) {
              Ok(_) => {}
              Err(e) => rc.os.stdio.eprintln("xo mod sumdb serve: refresh ${p} list: ${e}")
            }
          }
        }
      })
    }
  }
  var r = http.router()
  r.handle("/{rest...}", fn(req) { cc.sumdb_answer(req, state, limits, conf) })
  match http.server(l, r).serve() {
    Ok(_) => 0
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb serve: ${e}")
      1
    }
  }
}

/// `xo mod sumdb keygen <name> <key file>`: a new Ed25519 key; the signer
/// key goes to the file (mode 0600, never overwritten), the verifier key
/// (what clients put in XO_SUMDB) to standard output.
fn (c: ModCtx) run_sumdb_keygen(args: List[Str]) -> Int uses (fs, stdio, rand) {
  if args.len() != 2 {
    c.os.stdio.eprintln("xo mod sumdb keygen: want <log name> <key file>")
    return 2
  }
  let name = args[0]
  if !valid_log_name(name) {
    c.os.stdio.eprintln("xo mod sumdb keygen: invalid log name ${name.quote()}: no '+' or white space")
    return 2
  }
  let p = c.abs(args[1])
  if c.exists(p) {
    c.os.stdio.eprintln("xo mod sumdb keygen: ${args[1]} exists; a log's key is never replaced")
    return 1
  }
  let (signer, verifier) = log_keys(name, crypto.random_bytes(c.os.rand, 32))
  let tmp = c.temp_name(dir_of(p), ".key.tmp")
  var wrote = c.os.fs.write(tmp, "${signer}\n".bytes())
  if wrote.is_ok() {
    wrote = c.os.fs.set_mode(tmp, 0o600)
  }
  if wrote.is_ok() {
    wrote = c.os.fs.rename(tmp, p)
  }
  match wrote {
    Ok(_) => {}
    Err(e) => {
      c.os.fs.remove(tmp).ignore_err("cleanup")
      c.os.stdio.eprintln("xo mod sumdb keygen: ${fs_msg(e)}")
      return 1
    }
  }
  c.out("${verifier}\n")
  0
}

fn hashes_text(hs: List[Bytes]) -> Str {
  var b = StrBuilder.new()
  for h in hs {
    b.write("${h.to_base64()}\n")
  }
  b.freeze()
}

fn plain(body: Str) -> http.Response {
  http.text(200, body).with_header("Content-Type", "text/plain; charset=utf-8")
}

/// The lookup answer for key when the log holds its record.
fn held(state: Mutex[LogState], signer: Signer, key: Str) -> Str? {
  let found = state.with_read(fn(st) -> (Int, Str, Tree)? {
    let id = st.index.get(key)?
    Some((id, st.records[id], Tree{n: st.leaves.len(), hash: st.root}))
  })
  let (id, rec, t) = found?
  Some("${id}\n${rec}\n${sign_tree(signer, t)}")
}

/// The client a lookup is counted against: Cloudflare's
/// CF-Connecting-IP when the request came through a local tunnel, else
/// the peer's address.
fn client_of(req: http.Request) -> Str {
  if req.remote_ip == "127.0.0.1" || req.remote_ip == "::1" {
    if let Some(ip) = req.headers.get("Cf-Connecting-Ip") {
      return ip
    }
  }
  req.remote_ip
}

/// Counts one lookup that adds a version for client in this minute; false
/// when the client already made rate of them.
fn allow(limits: Mutex[Map[Str, (Int, Int)]], client: Str, minute: Int, rate: Int) -> Bool {
  limits.with(fn(var m) -> Bool {
    if m.len() > 100000 {
      // a new minute's worth of clients; the old counts no longer matter
      m = {}
    }
    let (w, n) = m.get(client) ?? (minute, 0)
    let count = if w == minute { n } else { 0 }
    if count >= rate {
      return false
    }
    m[client] = (minute, count + 1)
    true
  })
}

/// The module paths the log holds a version of, sorted.
fn log_paths(st: LogState) -> List[Str] {
  var set: Map[Str, Bool] = {}
  for k in st.index.keys() {
    let (p, _, _) = cut(k, "@")
    set[p] = true
  }
  set.keys().sort()
}

/// The index feed (index.golang.org's form): the records added at or
/// after since, in log order, at most limit, as JSON lines.
fn index_lines(st: LogState, since: Int, limit: Int) -> Str {
  var b = StrBuilder.new()
  var n = 0
  for id in 0..st.records.len() {
    if n >= limit {
      break
    }
    if st.times[id] < since {
      continue
    }
    let (path, version, _) = cut(record_key(st.records[id]), "@")
    b.write("{\"Path\":${path.quote()},\"Version\":${version.quote()},\"Timestamp\":\"${Time.from_unix(st.times[id]).format_rfc3339()}\"}\n")
    n += 1
  }
  b.freeze()
}

const NO_STORE = "no-store"

/// sumdb.Server.ServeHTTP for one request.
fn (c: ModCtx) sumdb_answer(req: http.Request, state: Mutex[LogState], limits: Mutex[Map[Str, (Int, Int)]], conf: LogConf) -> http.Response uses (fs, proc, rand, net, clock, stdio) {
  var cc = c
  let signer = conf.signer
  if req.method != "GET" && req.method != "HEAD" {
    return http_error("the checksum log is read only", 405)
  }
  let p = req.path
  if p == "/latest" {
    let t = state.with_read(fn(st) { Tree{n: st.leaves.len(), hash: st.root} })
    return plain(sign_tree(signer, t)).with_header("Cache-Control", NO_STORE)
  }
  if p == "/index" {
    var since = 0
    if let Some(s) = req.query("since") {
      match Time.parse_rfc3339(s) {
        Some(t) => since = t.unix()
        None => return http_error("since=${s.quote()} is not an RFC 3339 time", 400)
      }
    }
    var limit = Int.parse(req.query("limit") ?? "2000") ?? 2000
    if limit < 1 || limit > 2000 {
      limit = 2000
    }
    let body = state.with_read(fn(st) { index_lines(st, since, limit) })
    return http.text(200, body).with_header("Content-Type", "application/json").with_header("Cache-Control", "public, max-age=60")
  }
  if p.starts_with("/refresh/") {
    // GET /refresh/<path>: rewrite the module's @v/list from its tags now
    // (a new release need not wait for --refresh); only for a module the
    // log holds, and counted against the client's rate as a lookup that
    // adds a version is, since each one runs git ls-remote
    let path = unescape_path(p.trim_prefix("/refresh/")) ?? ""
    let fb = match conf.fill {
      Some(b) => b
      None => return http_error("this log fills no proxy bucket", 404)
    }
    if !check.valid_path(path) || !state.with_read(fn(st) { log_paths(st).contains(path) }) {
      return http_error("the log holds no version of ${path.quote()}", 404)
    }
    let client = client_of(req)
    if conf.rate > 0 && !allow(limits, client, cc.os.clock.now().unix() / 60, conf.rate) {
      return http_error("${client} made ${conf.rate} requests that reach git this minute; try again in a minute", 429).with_header("Retry-After", "60")
    }
    return match cc.refresh_list(fb, "${conf.data}/cache", path, conf.lists) {
      Ok(wrote) => plain(if wrote { "refreshed\n" } else { "unchanged\n" }).with_header("Cache-Control", NO_STORE)
      Err(e) => http_error("${path} list: ${e}", 502)
    }
  }
  if p.starts_with("/lookup/") {
    let (esc_path, esc_version, ok) = cut(p.trim_prefix("/lookup/"), "@")
    let path = unescape_path(esc_path) ?? ""
    let version = unescape_path(esc_version) ?? ""
    if !ok || !check.valid_path(path) || !check.valid_version(version) {
      return http_error("want /lookup/<module path>@<version>", 400)
    }
    let key = "${path}@${version}"
    if let Some(body) = held(state, signer, key) {
      return plain(body).with_header("Cache-Control", NO_STORE)
    }
    if !conf.fetch {
      return http_error("unknown module version", 404)
    }
    let now = cc.os.clock.now().unix()
    let client = client_of(req)
    if conf.rate > 0 && !allow(limits, client, now / 60, conf.rate) {
      return http_error("${client} added ${conf.rate} module versions this minute; try again in a minute", 429).with_header("Retry-After", "60")
    }
    let dir = match cc.download_in("${conf.data}/cache", path, version, Some(direct_only())) {
      Ok(d) => d
      Err(pr) => return http_error("${path} ${version}: ${pr.msg}", 404)
    }
    let rec = match cc.record(dir, path, version) {
      Ok(lines) => lines.join("\n") + "\n"
      Err(e) => return http_error("${path} ${version}: ${e}", 404)
    }
    // added unless another request added it meanwhile; copied to the
    // bucket and on disk before any tree head that holds it is signed
    let added = state.with(fn(var st) -> (Int, Str, Tree, Bool) ! Str {
      var id = st.index.get(key) ?? -1
      let is_new = id < 0
      if is_new {
        if let Some(b) = conf.copy {
          cc.s3_put(b, record_object(st.records.len()), "${now}\n${rec}".bytes(), "text/plain; charset=utf-8", IMMUTABLE)?
        }
        cc.append_record(conf.data, rec, now)?
        id = st.add(key, rec)
        st.times.push(now)
        st.root = tree_hash(st.leaves, 0, st.leaves.len())
      }
      Ok((id, st.records[id], Tree{n: st.leaves.len(), hash: st.root}, is_new))
    })
    return match added {
      Ok((id, r, t, is_new)) => {
        if is_new {
          if let Some(fb) = conf.fill {
            // the tree is in the log's cache already; the answer does not
            // wait for the upload, and a failed one stays in fill-pending
            // and is retried (at the start and on each --refresh tick)
            cc.os.tasks.spawn_background(fn() {
              var fc = cc
              fc.fill_logged(conf, fb, path, version)
            })
          }
        }
        plain("${id}\n${r}\n${sign_tree(signer, t)}").with_header("Cache-Control", NO_STORE)
      }
      Err(e) => http_error("cannot record ${path} ${version}: ${e}", 500)
    }
  }
  let inclusion = p.starts_with("/proof/inclusion/")
  if inclusion || p.starts_with("/proof/consistency/") {
    let rest = p.trim_prefix("/proof/inclusion/").trim_prefix("/proof/consistency/")
    let (a, b, ok) = cut(rest, "/")
    let x = Int.parse(a) ?? -1
    let n = Int.parse(b) ?? -1
    if !ok || x < 0 || n < 0 {
      return http_error("want /proof/inclusion/<id>/<n> or /proof/consistency/<m>/<n>", 400)
    }
    let proof = state.with_read(fn(st) -> List[Bytes]? {
      if n > st.leaves.len() || x > n || (inclusion && x >= n) {
        return None
      }
      if inclusion {
        var out: List[Bytes] = []
        inclusion_proof(st.leaves, 0, n, x, out)
        return Some(out)
      }
      Some(consistency_proof(st.leaves, x, n))
    })
    return match proof {
      // a proof for fixed sizes never changes
      Some(hs) => plain(hashes_text(hs)).with_header("Cache-Control", IMMUTABLE)
      None => http_error("the log has ${state.with_read(fn(st) { st.leaves.len() })} records", 404)
    }
  }
  http_error("not found", 404)
}

/// `xo mod sumdb restore --from=<bucket URL> [--region=auto] <data dir>`:
/// a log's records and times from the copies `serve --copy-to` made, into
/// a data directory that holds none.
fn (c: ModCtx) run_sumdb_restore(args: List[Str]) -> Int uses (fs, net, stdio, clock) {
  var fl = FlagSet{name: "mod sumdb restore", defs: [flag_str("from", "", "the bucket serve --copy-to wrote, https://<endpoint>/<bucket>"), flag_str("region", "auto", "the region bucket requests are signed for")]}
  if !c.parse_flags(fl, args) {
    return 2
  }
  if fl.args.len() != 1 {
    c.os.stdio.eprintln("xo mod sumdb restore: want --from=<bucket URL> and one data directory")
    return 2
  }
  let b = match c.bucket_of(fl.str("from"), fl.str("region")) {
    Ok(x) => x
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb restore: --from: ${e}")
      return 2
    }
  }
  let data = c.abs(fl.args[0])
  if c.exists(records_file(data)) || c.exists(times_file(data)) {
    c.os.stdio.eprintln("xo mod sumdb restore: ${data} already holds a log; restore into an empty directory")
    return 1
  }
  match c.os.fs.create_dir_all(data) {
    Ok(_) => {}
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb restore: ${fs_msg(e)}")
      return 1
    }
  }
  var recs = StrBuilder.new()
  var times = StrBuilder.new()
  var n = 0
  while true {
    let body = match c.s3_get(b, record_object(n)) {
      Ok(Some(x)) => x.to_str() ?? ""
      Ok(None) => break
      Err(e) => {
        c.os.stdio.eprintln("xo mod sumdb restore: ${e}")
        return 1
      }
    }
    let (t, rec, ok) = cut(body, "\n")
    if !ok || Int.parse(t) == None || record_key(rec).is_empty() {
      c.os.stdio.eprintln("xo mod sumdb restore: ${record_object(n)} is not a record copy")
      return 1
    }
    recs.write(rec)
    times.write("${t}\n")
    n += 1
  }
  match c.append_synced(times_file(data), times.freeze().bytes()) {
    Ok(_) => {}
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb restore: ${e}")
      return 1
    }
  }
  match c.append_synced(records_file(data), recs.freeze().bytes()) {
    Ok(_) => {}
    Err(e) => {
      c.os.stdio.eprintln("xo mod sumdb restore: ${e}")
      return 1
    }
  }
  c.out("restored ${n} records into ${data}\n")
  0
}
