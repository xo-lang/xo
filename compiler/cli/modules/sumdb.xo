// The checksum log client (decision 0124): internal/sumdb's note.go
// (verifier keys and signed tree heads, Ed25519 from std/crypto, decision
// 0189), tlog.go (RFC 6962 / 9162 Merkle proofs), and client.go. On the
// first fetch of a module version the client checks that the log holds
// the same two xo.lock lines the fetched tree has, that the record is in
// the tree the log signed, and that the tree extends the latest one this
// client verified before.

use github.com/xo-lang/xo/compiler/check
use std/crypto
use std/http

/// A log's public key (sumdb.Verifier): what XO_SUMDB names.
struct Verifier {
  name: Str
  id: Int
  key: Bytes
}

/// A tree head (sumdb.Tree).
struct Tree {
  n: Int = 0
  hash: Bytes = b""
}

/// A client of one log (sumdb.Client).
struct SumClient {
  url: Str
  verifier: Verifier
  /// <state_dir>/<log name>/latest keeps the latest verified tree head.
  state_dir: Str
}

/// A failed check (sumdb.Error): security when the log or the fetched
/// tree cannot be trusted (XO1313), else the log could not be consulted
/// (XO1314).
struct SumErr {
  security: Bool
  msg: Str
}

fn security(msg: Str) -> SumErr {
  SumErr{security: true, msg: msg}
}

fn unavailable(msg: Str) -> SumErr {
  SumErr{security: false, msg: msg}
}

/// sumdb keyID: the first four bytes of SHA-256("<name>\n" || key), big
/// endian.
fn key_id(name: Str, key: Bytes) -> Int {
  var b = BytesBuilder.new()
  b.write("${name}\n".bytes())
  b.write(key)
  let h = crypto.sha256(b.freeze())
  be32(h, 0)
}

/// The big endian 32 bit value at b[i..i+4].
fn be32(b: Bytes, i: Int) -> Int {
  Int(b[i]) * 16777216 + Int(b[i + 1]) * 65536 + Int(b[i + 2]) * 256 + Int(b[i + 3])
}

fn valid_log_name(name: Str) -> Bool {
  !name.is_empty() && !name.contains("+") && !name.contains(" ") && !name.contains("\t") && !name.contains("\r") && !name.contains("\n")
}

/// sumdb parseID: 8 hex digits.
fn parse_key_id(s: Str) -> Int ! Str {
  match Bytes.from_hex(s) {
    Some(b) => {
      if b.len() == 4 {
        return Ok(be32(b, 0))
      }
    }
    None => {}
  }
  Err("key id ${s.quote()} is not 8 hex digits")
}

/// strings.SplitN(s, sep, n).
fn split_n(s: Str, sep: Str, n: Int) -> List[Str] {
  var out: List[Str] = []
  var rest = s
  while out.len() < n - 1 {
    match rest.find(sep) {
      Some(i) => {
        out.push(rest[..i])
        rest = rest[i + sep.len()..]
      }
      None => break
    }
  }
  out.push(rest)
  out
}

/// sumdb.ParseVerifier: <name>+<key id>+<base64 public key>.
fn parse_verifier(s: Str) -> Verifier ! Str {
  let parts = split_n(s.trim(), "+", 3)
  if parts.len() != 3 || !valid_log_name(parts[0]) {
    return Err("malformed checksum log key ${s.quote()}: want <name>+<key id>+<base64 public key>")
  }
  let id = parse_key_id(parts[1])?
  let key = match Bytes.from_base64(parts[2]) {
    Some(k) => k
    None => b""
  }
  if key.len() != 32 {
    return Err("malformed checksum log key ${s.quote()}: the key is not a base64 Ed25519 public key")
  }
  if key_id(parts[0], key) != id {
    return Err("checksum log key ${s.quote()}: the key id does not match the name and key")
  }
  Ok(Verifier{name: parts[0], id: id, key: key})
}

/// sumdb.ParseConfig: XO_SUMDB, "<verifier key>" (the log at
/// https://<name>) or "<verifier key> <URL>".
fn parse_sum_config(s: Str) -> (Verifier, Str) ! Str {
  let f = check.fields(s)
  if f.is_empty() || f.len() > 2 {
    return Err("XO_SUMDB=${s.quote()}: want off, or <name>+<key id>+<public key> [<URL>]")
  }
  let v = parse_verifier(f[0])?
  var url = "https://${v.name}"
  if f.len() == 2 {
    url = f[1]
    if !url.starts_with("https://") && !url.starts_with("http://") {
      return Err("XO_SUMDB: the log URL ${url.quote()} is not http or https")
    }
  }
  while url.ends_with("/") {
    url = url.trim_suffix("/")
  }
  Ok((v, url))
}

const NOTE_HEADER = "xo checksum log\n"

/// The four lines a tree head signs.
fn tree_text(name: Str, t: Tree) -> Str {
  "${NOTE_HEADER}${name}\n${t.n}\n${t.hash.to_base64()}\n"
}

/// sumdb.ParseHash: a base64 SHA-256.
fn parse_hash(s: Str) -> Bytes ! Str {
  match Bytes.from_base64(s) {
    Some(b) => {
      if b.len() == 32 {
        return Ok(b)
      }
    }
    None => {}
  }
  Err("malformed hash ${s.quote()}")
}

/// Verifier.VerifyTree: the tree of a signed tree head, checked with the
/// key.
fn verify_tree(v: Verifier, note: Bytes) -> Tree ! Str {
  let s = note.to_str() ?? ""
  let (text0, sigs, ok) = cut(s, "\n\n")
  if !ok {
    return Err("malformed signed tree head")
  }
  let text = "${text0}\n"
  let lines = text0.split("\n")
  if lines.len() != 4 || "${lines[0]}\n" != NOTE_HEADER {
    return Err("malformed signed tree head")
  }
  if lines[1] != v.name {
    return Err("signed tree head is from the log ${lines[1].quote()}, not ${v.name.quote()}")
  }
  let n = match Int.parse(lines[2]) {
    Some(x) => x
    None => -1
  }
  if n < 0 {
    return Err("malformed tree size ${lines[2].quote()}")
  }
  let h = parse_hash(lines[3])?
  for l in sigs.trim().split("\n") {
    let f = check.fields(l)
    if f.len() != 3 || f[0] != "sig" || f[1] != v.name {
      continue
    }
    let raw = match Bytes.from_base64(f[2]) {
      Some(r) => r
      None => continue
    }
    if raw.len() != 68 || be32(raw, 0) != v.id {
      continue
    }
    if crypto.ed25519_verify(v.key, text.bytes(), raw[4..68]) {
      return Ok(Tree{n: n, hash: h})
    }
    return Err("the signature of the tree head does not verify with the key of ${v.name}")
  }
  Err("the tree head carries no signature by the key ${v.name}+${hex8(v.id)}")
}

/// %08x of a 32 bit value.
fn hex8(id: Int) -> Str {
  var b = BytesBuilder.new()
  b.write_byte(UInt8((id >> 24) & 255))
  b.write_byte(UInt8((id >> 16) & 255))
  b.write_byte(UInt8((id >> 8) & 255))
  b.write_byte(UInt8(id & 255))
  b.freeze().to_hex()
}

// ---------------------------------------------------------------------------
// Merkle trees (sumdb tlog.go)

/// RecordHash: SHA-256(0x00 || data).
fn record_hash(data: Bytes) -> Bytes {
  var b = BytesBuilder.new()
  b.write_byte(0)
  b.write(data)
  crypto.sha256(b.freeze())
}

/// NodeHash: SHA-256(0x01 || left || right).
fn node_hash(left: Bytes, right: Bytes) -> Bytes {
  var b = BytesBuilder.new()
  b.write_byte(1)
  b.write(left)
  b.write(right)
  crypto.sha256(b.freeze())
}

/// VerifyInclusion: leaf is the i-th leaf of the tree of size n whose
/// hash is root (RFC 9162 2.1.3.2).
fn verify_inclusion(proof: List[Bytes], n: Int, i: Int, leaf: Bytes, root: Bytes) -> () ! Str {
  if i < 0 || i >= n {
    return Err("record ${i} is not in a tree of ${n} records")
  }
  var fnn = i
  var sn = n - 1
  var r = leaf
  for p in proof {
    if sn == 0 {
      return Err("proof does not verify")
    }
    if (fnn & 1) == 1 || fnn == sn {
      r = node_hash(p, r)
      while (fnn & 1) == 0 && fnn != 0 {
        fnn = fnn >> 1
        sn = sn >> 1
      }
    } else {
      r = node_hash(r, p)
    }
    fnn = fnn >> 1
    sn = sn >> 1
  }
  if sn != 0 || r != root {
    return Err("proof does not verify")
  }
  Ok(())
}

/// VerifyConsistency: the tree of size m with hash old_root is a prefix of
/// the tree of size n with hash new_root (RFC 9162 2.1.4.2).
fn verify_consistency(proof: List[Bytes], m: Int, n: Int, old_root: Bytes, new_root: Bytes) -> () ! Str {
  if m < 0 || m > n {
    return Err("a tree of ${n} records cannot extend one of ${m}")
  }
  if m == n {
    if !proof.is_empty() || old_root != new_root {
      return Err("proof does not verify")
    }
    return Ok(())
  }
  if m == 0 {
    if !proof.is_empty() {
      return Err("proof does not verify")
    }
    return Ok(())
  }
  if proof.is_empty() {
    return Err("proof does not verify")
  }
  var path = proof
  if (m & (m - 1)) == 0 {
    path = [old_root] + proof
  }
  var fnn = m - 1
  var sn = n - 1
  while (fnn & 1) == 1 {
    fnn = fnn >> 1
    sn = sn >> 1
  }
  var fr = path[0]
  var sr = path[0]
  for k in 1..path.len() {
    let cn = path[k]
    if sn == 0 {
      return Err("proof does not verify")
    }
    if (fnn & 1) == 1 || fnn == sn {
      fr = node_hash(cn, fr)
      sr = node_hash(cn, sr)
      while (fnn & 1) == 0 && fnn != 0 {
        fnn = fnn >> 1
        sn = sn >> 1
      }
    } else {
      sr = node_hash(sr, cn)
    }
    fnn = fnn >> 1
    sn = sn >> 1
  }
  if sn != 0 || fr != old_root || sr != new_root {
    return Err("proof does not verify")
  }
  Ok(())
}

// ---------------------------------------------------------------------------
// The client (sumdb client.go)

/// Client.get: the body (at most 1 MiB), the status, and the error.
fn (c: ModCtx) sum_get(cl: SumClient, p: Str) -> (Bytes, Int, Str) uses net {
  let hc = http.client(c.os.net, timeout: 60s)
  let url = cl.url + p
  let resp = match hc.get(url) {
    Ok(r) => r
    Err(e) => return (b"", 0, "Get ${url.quote()}: ${client_msg(e)}")
  }
  var body = resp.body
  if body.len() > 1048576 {
    body = body[0..1048576]
  }
  if resp.status != 200 {
    return (body, resp.status, "${url}: ${status_text(resp.status)}: ${(body.to_str() ?? "").trim()}")
  }
  (body, resp.status, "")
}

fn parse_hashes(body: Bytes) -> List[Bytes] ! Str {
  var out: List[Bytes] = []
  for l0 in check_lines(body) {
    let l = l0.trim()
    if l.is_empty() {
      continue
    }
    out.push(parse_hash(l)?)
  }
  Ok(out)
}

/// The lines of data as bufio.Scanner splits them.
fn check_lines(data: Bytes) -> List[Str] {
  var out: List[Str] = []
  let text = data.to_str() ?? ""
  if text.is_empty() {
    return out
  }
  let parts = text.split("\n")
  for (i, l) in parts.indexed() {
    if i == parts.len() - 1 && l.is_empty() {
      break
    }
    out.push(l.trim_suffix("\r"))
  }
  out
}

fn state_path(cl: SumClient) -> Str {
  "${cl.state_dir}/${cl.verifier.name}/latest"
}

/// Client.stored: the latest verified tree head, the empty tree when none.
fn (c: ModCtx) sum_stored(cl: SumClient) -> Tree ! SumErr uses fs.read {
  if cl.state_dir.is_empty() {
    return Ok(Tree{})
  }
  let data = match c.os.fs.read(state_path(cl)) {
    Ok(d) => d
    Err(_) => return Ok(Tree{})
  }
  match verify_tree(cl.verifier, data) {
    Ok(t) => Ok(t)
    Err(e) => Err(security("the stored tree head ${state_path(cl)} does not verify: ${e}"))
  }
}

/// Client.store: keeps note as the latest tree head (best effort).
fn (c: ModCtx) sum_store(cl: SumClient, note: Bytes) uses (fs, rand) {
  if cl.state_dir.is_empty() {
    return
  }
  let p = state_path(cl)
  if c.os.fs.create_dir_all(dir_of(p)).is_err() {
    return
  }
  let tmp = c.temp_name(dir_of(p), "latest.tmp")
  if c.os.fs.write(tmp, note).is_ok() {
    c.os.fs.rename(tmp, p).ignore_err("best effort, as Client.store")
  }
}

/// Client.Check: the log holds exactly the record lines want for
/// path@version, the record is in the signed tree, and the tree is
/// consistent with the latest one this client verified (which it then
/// replaces when larger).
fn (c: ModCtx) sum_check(cl: SumClient, path: Str, version: Str, want: List[Str]) -> () ! SumErr uses (net, fs, rand) {
  let name = cl.verifier.name
  let (body, status, err) = c.sum_get(cl, "/lookup/${escape(path)}@${escape(version)}")
  if !err.is_empty() {
    if status == 404 || status == 410 {
      return Err(unavailable("the checksum log ${name} has no record of ${path} ${version}: ${err}"))
    }
    return Err(unavailable("cannot reach the checksum log ${name}: ${err}"))
  }
  let text = body.to_str() ?? ""
  let (id_line, rest, ok) = cut(text, "\n")
  let (record0, note, ok2) = cut(rest, "\n\n")
  if !ok || !ok2 {
    return Err(unavailable("malformed lookup answer from the checksum log ${name}"))
  }
  let record = "${record0}\n"
  let id = match Int.parse(id_line) {
    Some(x) => x
    None => -1
  }
  if id < 0 {
    return Err(unavailable("malformed record id ${id_line.quote()} from the checksum log ${name}"))
  }
  let tree = match verify_tree(cl.verifier, note.bytes()) {
    Ok(t) => t
    Err(e) => return Err(security("checksum log ${name}: ${e}"))
  }
  let got = record0.split("\n")
  if !same_lines(got, want) {
    return Err(security("${path} ${version}: the checksum log ${name} records\n${indent(got)}\nbut the fetched module has\n${indent(want)}"))
  }
  if id >= tree.n {
    return Err(security("checksum log ${name}: record ${id} is outside its signed tree of ${tree.n} records"))
  }
  let (pb, _, perr) = c.sum_get(cl, "/proof/inclusion/${id}/${tree.n}")
  if !perr.is_empty() {
    return Err(unavailable("checksum log ${name}: inclusion proof: ${perr}"))
  }
  let proof = match parse_hashes(pb) {
    Ok(p) => p
    Err(e) => return Err(unavailable("checksum log ${name}: inclusion proof: ${e}"))
  }
  match verify_inclusion(proof, tree.n, id, record_hash(record.bytes()), tree.hash) {
    Ok(_) => {}
    Err(e) => return Err(security("checksum log ${name}: the record of ${path} ${version} is not in its signed tree (${e})"))
  }
  let old = c.sum_stored(cl)?
  c.sum_consistent(cl, old, tree)?
  if tree.n > old.n {
    c.sum_store(cl, note.bytes())
  }
  Ok(())
}

/// Client.consistent: the smaller of two verified trees is a prefix of
/// the larger.
fn (c: ModCtx) sum_consistent(cl: SumClient, a0: Tree, b0: Tree) -> () ! SumErr uses net {
  var a = a0
  var b = b0
  if a.n > b.n {
    a = b0
    b = a0
  }
  let name = cl.verifier.name
  if a.n == b.n {
    if a.hash != b.hash {
      return Err(security("checksum log ${name}: two signed trees of ${a.n} records differ: the log forked"))
    }
    return Ok(())
  }
  if a.n == 0 {
    return Ok(())
  }
  let (pb, _, err) = c.sum_get(cl, "/proof/consistency/${a.n}/${b.n}")
  if !err.is_empty() {
    return Err(security("checksum log ${name}: cannot prove that its tree of ${b.n} records extends the one of ${a.n} seen before: ${err}"))
  }
  let proof = match parse_hashes(pb) {
    Ok(p) => p
    Err(e) => return Err(unavailable("checksum log ${name}: consistency proof: ${e}"))
  }
  match verify_consistency(proof, a.n, b.n, a.hash, b.hash) {
    Ok(_) => Ok(())
    Err(e) => Err(security("checksum log ${name}: its tree of ${b.n} records does not extend the one of ${a.n} seen before: the log forked or rewrote history (${e})"))
  }
}

/// sumdb sameLines: the same lines in any order, white space normalized.
fn same_lines(a: List[Str], b: List[Str]) -> Bool {
  if a.len() != b.len() {
    return false
  }
  let sa = a.sort()
  let sb = b.sort()
  for i in 0..sa.len() {
    if norm_space(sa[i]) != norm_space(sb[i]) {
      return false
    }
  }
  true
}

fn norm_space(s: Str) -> Str {
  check.fields(s).join(" ")
}

fn indent(lines: List[Str]) -> Str {
  "  " + lines.join("\n  ")
}
