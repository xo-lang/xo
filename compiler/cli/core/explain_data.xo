// The texts of `xo explain` and every code's severity: the code table.
// Generated from internal/diag until decision 0215 deleted it; edit it
// here (internal/repotest keeps it equal to spec/core.md 10.6).

/// The long form explanation of a diagnostic code (diag.Explanation),
/// with its severity and one line summary (diag.SeverityOf,
/// diag.Descriptions).
pub struct Expl {
  pub title: Str
  pub severity: Str
  pub summary: Str
  pub detail: Str
  pub example: Str
  pub fix: Str
}

/// The explanation of code (upper case, as XO0201), or None.
pub fn explanation(code: Str) -> Expl? {
  match code {
    "XO0101" => Some(Expl{title: "name breaks the enforced naming rules", severity: "error", summary: "name breaks the enforced naming rules (core 1.5)", detail: "Xo enforces naming in the compiler instead of leaving it to linters, so every program reads the same way and a name's kind is visible at a glance. Types, enum variants, interfaces, and type parameters are UpperCamel; functions, methods, variables, fields, parameters, modules, and effect variables are snake_case; constants are UPPER_SNAKE. Exported names are marked with `pub`, never by capitalization. The diagnostic carries a fix that renames the declaration. See core 1.5.", example: "fn DoIt(userId: Int) -> Int {\n  userId\n}", fix: "fn do_it(user_id: Int) -> Int {\n  user_id\n}"})
    "XO0110" => Some(Expl{title: "unused local binding or import", severity: "error", summary: "unused local binding or import (core 3.1)", detail: "A local `let` or `var` binding, a local constant, a pattern binding, or an import that is never read is an error, because dead names usually mean a forgotten step. Function and closure parameters, names starting with `_`, and `_` itself are not covered. A `var` that is only assigned and never read also counts as unused. `xo fix` removes unused bindings, and `xo check --wip` reports them as warnings while the code is still being written. See core 3.1.", example: "use std/json\n\nfn f() -> Int {\n  let x = 1\n  2\n}", fix: "fn f() -> Int {\n  let x = 1\n  x + 1\n}"})
    "XO0150" => Some(Expl{title: "character that cannot start any token", severity: "error", summary: "character that cannot start any token", detail: "The lexer found a character that begins no Xo token, such as `@` or a stray Unicode symbol outside a string or comment. Xo source is UTF-8 and identifiers are `[A-Za-z_][A-Za-z0-9_]*`. Remove the character or move it into a string literal. See core 1.1 and 1.5.", example: "fn f(x: Int) -> Int {\n  x @\n}", fix: "fn f(x: Int) -> Int {\n  x\n}"})
    "XO0151" => Some(Expl{title: "string, raw string, bytes, or triple quoted string not closed", severity: "error", summary: "string, raw string, bytes, or triple quoted string not closed", detail: "A string literal `\"...\"`, raw string `r\"...\"` or `r#\"...\"#`, bytes literal `b\"...\"`, or triple quoted string `\"\"\"...\"\"\"` reached the end of the line (or file, for triple quoted strings) without its closing delimiter. Plain strings cannot span lines; use a triple quoted string for multi line text. A raw string opened with `r#\"` must close with `\"#`. See core 1.6.", example: "fn f() -> Str {\n  let s = \"abc\n  s\n}", fix: "fn f() -> Str {\n  let s = \"abc\"\n  s\n}"})
    "XO0152" => Some(Expl{title: "rune literal that is empty, unterminated, or holds more than one character", severity: "error", summary: "rune literal that is empty, unterminated, or holds more than one character", detail: "A rune literal is exactly one character (or one escape) between single quotes: `'a'`, `'\\n'`, `'\\u{1F600}'`. `''`, `'ab'`, and an unclosed `'a` are rejected. Text of several characters is a `Str` and uses double quotes. See core 1.6.", example: "fn f() -> Str {\n  let s = 'ab'\n  \"\${s}\"\n}", fix: "fn f() -> Str {\n  let s = \"ab\"\n  s\n}"})
    "XO0153" => Some(Expl{title: "unknown or malformed escape sequence", severity: "error", summary: "unknown or malformed escape sequence", detail: "Escapes in `Str` and `Bytes` are `\\n \\t \\r \\0 \\\\ \\\" \\' \\\$ \\xHH \\u{...}`. Anything else after a backslash is an error, as are `\\x` without two hex digits, `\\u` without braces, an invalid code point, and in `Str` a `\\xHH` above `\\x7f` (use `\\u{...}` for non ASCII text). To write a backslash, double it, or use a raw string `r\"...\"`, which has no escapes. See core 1.6.", example: "fn f() -> Str {\n  \"\\q\"\n}", fix: "fn f() -> Str {\n  r\"\\q\"\n}"})
    "XO0154" => Some(Expl{title: "bad digit, misplaced `_`, missing digits, or out of range integer", severity: "error", summary: "bad digit, misplaced `_`, missing digits, or out of range integer", detail: "Integer literals are decimal, `0x` hex, `0b` binary, or `0o` octal, with `_` allowed only between digits (`1_000_000`). The lexer rejects a digit that does not belong to the base (`0b102`), a prefix with no digits (`0x`), a doubled, leading, or trailing `_`, an integer that does not fit in 64 bits, and a duration literal whose nanosecond count overflows. See core 1.6.", example: "const LIMIT = 1__000", fix: "const LIMIT = 1_000"})
    "XO0155" => Some(Expl{title: "unknown duration unit, fractional or non decimal duration", severity: "error", summary: "unknown duration unit, fractional or non decimal duration", detail: "A duration literal is a decimal integer followed by one of `ns`, `us`, `ms`, `s`, `m`, or `h`: `5s`, `250ms`. Any other suffix on a number (`5sec`, or `0xg`, where `g` is read as a suffix) is reported here, and so are fractional or non decimal durations such as `1.5s` or `0x10s`. Write a fractional duration in a smaller unit: `1500ms`. See core 1.6.", example: "const TIMEOUT = 1.5s", fix: "const TIMEOUT = 1500ms"})
    "XO0156" => Some(Expl{title: "`\${` without a matching `}` in the same string", severity: "error", summary: "`\${` without a matching `}` in the same string", detail: "Inside a string, `\${` starts an interpolated expression that must be closed by `}` before the string ends. If a literal `\${` is meant, escape the dollar sign: `\\\${`. A `\$` not followed by `{` is always literal. See core 1.6.", example: "fn f(b: Int) -> Str {\n  \"a \${b\"\n}", fix: "fn f(b: Int) -> Str {\n  \"a \${b}\"\n}"})
    "XO0157" => Some(Expl{title: "`\${}` with no expression", severity: "error", summary: "`\${}` with no expression", detail: "An interpolation must contain an expression whose type implements `Display`. `\${}` (or `\${ }`) has nothing to interpolate. Put an expression inside, or escape the dollar sign (`\\\${}`) to write the characters literally. See core 1.6.", example: "fn f() -> Str {\n  \"a \${}\"\n}", fix: "fn f() -> Str {\n  \"a \\\${}\"\n}"})
    "XO0158" => Some(Expl{title: "`use` not followed by a valid import path", severity: "error", summary: "`use` not followed by a valid import path", detail: "`use` takes a slash separated module path (`use std/http`, `use github.com/acme/billing/invoice`) or, for Go packages, `use go \"path\"` with a non empty, relative, plain string. Empty segments (`std//http`), a missing path, an empty or absolute Go path, and interpolation in a Go path are rejected. See core 4.1 and 4.4.", example: "use std//http\n\nfn ok() -> http.Response { http.text(200, \"ok\") }", fix: "use std/http\n\nfn ok() -> http.Response { http.text(200, \"ok\") }"})
    "XO0160" => Some(Expl{title: "a token that does not fit the grammar here", severity: "error", summary: "a token that does not fit the grammar here", detail: "The general syntax error: the parser expected one thing (an expression, `,`, `)`, a type, `in` in a `for`, ...) and found another. The message names what was expected and what was found. It is also used for a keyword written where a name is needed, bitwise compound assignments (only `+= -= *= /= %=` exist), an interface method with a body, and a statement such as `return` used as a value. The parser recovers at the next statement, so one mistake gives one diagnostic. See core 15 for the grammar.", example: "fn f() -> Int {\n  let x = (1 2)\n  x\n}", fix: "fn f() -> Int {\n  let x = (1 + 2)\n  x\n}"})
    "XO0161" => Some(Expl{title: "list element followed by a newline instead of a comma", severity: "error", summary: "list element followed by a newline instead of a comma (core 1.3)", detail: "Newlines end statements (core 1.3), so a comma separated list (arguments, list, map, or struct literal elements, parameters) that spans lines needs a comma after every element, including the last one. Trailing commas are allowed in every list. The diagnostic carries a fix that inserts the comma. See core 1.3.", example: "fn f() -> List[Int] {\n  let xs = [\n    1,\n    2\n  ]\n  xs\n}", fix: "fn f() -> List[Int] {\n  let xs = [\n    1,\n    2,\n  ]\n  xs\n}"})
    "XO0162" => Some(Expl{title: "`else` must be on the line of the closing brace", severity: "error", summary: "`else` must be on the line of the closing brace (core 1.3)", detail: "Because a newline after `}` ends the `if` statement (core 1.3), an `else` on the next line would start a new statement. Write `} else {` and `} else if` on the same line as the closing brace. See core 1.3.", example: "fn f(a: Bool) -> Int {\n  if a {\n    1\n  }\n  else {\n    2\n  }\n}", fix: "fn f(a: Bool) -> Int {\n  if a {\n    1\n  } else {\n    2\n  }\n}"})
    "XO0163" => Some(Expl{title: "unparenthesized struct literal in a condition", severity: "error", summary: "unparenthesized struct literal in a condition (core 1.4)", detail: "In the condition of `if`, `while`, `for`, `match`, `requires`, or `ensures`, a `{` opens the body, so a struct literal or struct pattern (`p is Point{x: 0, ..}`) there is ambiguous. Parenthesize the condition, as in Go. The diagnostic carries that fix. See core 1.4.", example: "struct Point { x: Int }\n\nfn f(p: Point) -> Bool {\n  if p == Point{x: 0} {\n    true\n  } else {\n    false\n  }\n}", fix: "struct Point { x: Int }\n\nfn f(p: Point) -> Bool {\n  if (p == Point{x: 0}) {\n    true\n  } else {\n    false\n  }\n}"})
    "XO0164" => Some(Expl{title: "`(`, `[`, or `{` not closed before end of file", severity: "error", summary: "`(`, `[`, or `{` not closed before end of file", detail: "The file ended while a delimiter was still open. The diagnostic points at the opening delimiter and notes where the file ended. The prototype reports this for an unclosed `{`; an unclosed `(` or `[` currently surfaces as XO0160 at the token that cannot continue the list. See core 15.", example: "fn f() -> Int {\n  1\n", fix: "fn f() -> Int {\n  1\n}"})
    "XO0165" => Some(Expl{title: "syntax that is not a pattern", severity: "error", summary: "syntax that is not a pattern (core 3.5)", detail: "Where a pattern is expected (a `match` arm, `let`, `if let`, `for`, or after `is`), the parser found something that is not one: an operator, a missing pattern after `let`, or a non literal in a range pattern. A pattern after `is` tests without binding, so it may not bind names: write `_`, or bind with `if let` or `match`. See core 3.5 for the pattern table.", example: "fn f(r: Result[Int, Str]) -> Bool {\n  r is Ok(v)\n}", fix: "fn f(r: Result[Int, Str]) -> Bool {\n  r is Ok(_)\n}"})
    "XO0166" => Some(Expl{title: "`while cond` used as an expression; only `while { }` is one", severity: "error", summary: "`while cond` used as an expression; only `while { }` is one", detail: "A `while` loop with a condition may end without producing a value, so it is a statement. Only the infinite loop `while { ... }` is an expression, whose value comes from `break`. Move the loop into its own statement and compute the value separately. See core 3.5.", example: "fn f(a: Bool) {\n  let x = while a { }\n}", fix: "fn f(a: Bool) {\n  while a { }\n}"})
    "XO0167" => Some(Expl{title: "top level declaration inside a block", severity: "error", summary: "top level declaration (fn, struct, const, ...) inside a block", detail: "`fn`, `struct`, `enum`, `interface`, `type`, `use`, `test`, and anything marked `pub` may appear only at the top level of a file. Inside a function, use a closure (`let name = fn(...) { ... }`) instead of a nested function. `const` is the exception: local constants are allowed in blocks. See core 3.1, 3.3, and 15.", example: "fn f() -> Int {\n  fn g() -> Int { 1 }\n  g()\n}", fix: "fn f() -> Int {\n  let g = fn() -> Int { 1 }\n  g()\n}"})
    "XO0168" => Some(Expl{title: "statement (let, expression, ...) at top level", severity: "error", summary: "statement (let, expression, ...) at top level", detail: "A file holds only `use` declarations and declarations (`fn`, `struct`, `enum`, `interface`, `type`, `const`, `test`). Statements such as `let`, assignments, and expressions are allowed only inside a function or test body. A module level value is a `const`. See core 15 (File).", example: "let max_users = 10\n\nfn f() -> Int { max_users }", fix: "const MAX_USERS = 10\n\nfn f() -> Int { MAX_USERS }"})
    "XO0169" => Some(Expl{title: "match or select arms separated by `,` instead of newlines", severity: "error", summary: "match or select arms separated by `,` instead of newlines", detail: "`match` and `select` arms are separated by newlines, not commas, so arms read like statements. Remove the comma. See core 3.5.", example: "fn f(b: Bool) -> Int {\n  match b {\n    true => 1,\n    false => 2\n  }\n}", fix: "fn f(b: Bool) -> Int {\n  match b {\n    true => 1\n    false => 2\n  }\n}"})
    "XO0170" => Some(Expl{title: "several effects in a function type must be parenthesized", severity: "error", summary: "several effects in a function type must be parenthesized (core 15)", detail: "In a function type, `uses a, b` would be ambiguous with the comma that separates parameters or fields, so several effects are written `uses (a, b)`. In a declaration clause (`fn f() uses net, clock`) the parentheses are optional. The diagnostic carries a fix that adds them. See core 6.2 and 15.", example: "fn f(g: fn() uses net, clock, n: Int) uses (net, clock) {\n  g()\n}", fix: "fn f(g: fn() uses (net, clock), n: Int) uses (net, clock) {\n  g()\n}"})
    "XO0171" => Some(Expl{title: "`..` used more than once or not last in pattern fields", severity: "error", summary: "`..` used more than once or not last in pattern fields", detail: "In variant and struct patterns, `..` ignores the remaining fields and must come last: `Db(msg: m, ..)`. A list pattern may contain `..` once, anywhere: `[first, .., last]`. `..` is not allowed outside list, variant, and struct patterns. See core 3.5.", example: "enum E { Db(msg: Str, code: Int) }\n\nfn f(e: E) -> Int {\n  match e {\n    Db(.., code: c) => c\n  }\n}", fix: "enum E { Db(msg: Str, code: Int) }\n\nfn f(e: E) -> Int {\n  match e {\n    Db(code: c, ..) => c\n  }\n}"})
    "XO0172" => Some(Expl{title: "function declaration without a body", severity: "error", summary: "function declaration without a body", detail: "Every `fn` declaration outside an interface needs a `{ ... }` body. Only interface method signatures have no body. If the body is not written yet, use a typed hole `???` (core 3.7) so the rest of the program still checks. See core 3.2 and 15.", example: "fn f() -> Int\nfn g() {}", fix: "fn f() -> Int { ??? }\nfn g() {}"})
    "XO0173" => Some(Expl{title: "`use` after the first declaration", severity: "error", summary: "`use` after the first declaration (core 15: File)", detail: "All `use` declarations of a file come first, before any `fn`, `struct`, or other declaration, so a file's imports are visible at the top. Move the `use` up. See core 4.1 and 15 (File).", example: "fn f() -> Int { 1 }\nuse std/http\n\nfn ok() -> http.Response { http.text(200, \"ok\") }", fix: "use std/http\n\nfn f() -> Int { 1 }\n\nfn ok() -> http.Response { http.text(200, \"ok\") }"})
    "XO0174" => Some(Expl{title: "bare `self` parameter outside an interface method signature", severity: "error", summary: "bare `self` parameter outside an interface method signature", detail: "A bare `self` parameter is only allowed first in an interface method signature (`fn get(self, id: Int) -> T?`). A method on a concrete type names its receiver before the method name: `fn (p: Point) norm() -> Int`. See core 2.4 and 3.4.", example: "struct P { x: Int }\n\nfn norm(self, scale: Int) -> Int { scale }", fix: "struct P { x: Int }\n\nfn (p: P) norm(scale: Int) -> Int { p.x * scale }"})
    "XO0175" => Some(Expl{title: "two statements or arms on one line", severity: "error", summary: "two statements or arms on one line", detail: "Newlines terminate statements and separate declarations and `match` arms, and Xo has no semicolons in source (core 1.3). Two statements, declarations, or arms on one line are rejected. Put each on its own line. Several `match` or `select` arms on one line (`match r { Ok(v) => v Err(_) => 0 }`) get a machine fix that puts each arm on its own line (`xo fix`), and the parser keeps every arm, so no false missing arm error (XO0301) follows.", example: "fn a() {}\nfn b() {}\n\nfn f() {\n  a() b()\n}", fix: "fn a() {}\nfn b() {}\n\nfn f() {\n  a()\n  b()\n}"})
    "XO0176" => Some(Expl{title: "`pub` before something that cannot be exported", severity: "error", summary: "`pub` before something that cannot be exported", detail: "`pub` exports a declaration from its module (core 1.5). Imports (`use`) and `test` blocks cannot be exported, so `pub use` and `pub test` are rejected. Remove the `pub`.", example: "pub test \"adds\" {\n  expect(1 + 1) == 2\n}", fix: "test \"adds\" {\n  expect(1 + 1) == 2\n}"})
    "XO0177" => Some(Expl{title: "syntax from another language (Go, Rust, TypeScript, Python, Swift, Kotlin); names the habit and the Xo form (decision 0087)", severity: "error", summary: "syntax from another language (Go, Rust, TypeScript, Python, Swift, Kotlin); names the habit and the Xo form (decision 0087)", detail: "The code uses a form that is correct in Go, Rust, TypeScript, Python, Swift, or Kotlin but not in Xo. The message names the habit and the Xo form, and when the rewrite is unambiguous a machine fix applies it (`xo fix`). The parser then continues as if the Xo form had been written, so one habit gives one diagnostic. Common ones: `func`, `fun`, `def`, `function` are `fn`; `x := v` and Kotlin `val` are `let` (or `var`); Rust `let mut` is `var`; `T: Hash + Eq` is one constraint, `T: Hash` (`Eq` and `Debug` are automatic); `Vec<T>` and `[]T` are `List[T]`, `map[K]V` is `Map[K, V]`; `var x` or `&x` at a call site is just `x` (`var` belongs on the parameter); `*p`, `&T`, and `*T` have no Xo form (no pointers); `c ? a : b` and Python's `a if c else b` are `if c { a } else { b }`; Kotlin `?:` is `??`; `x!!` and `x!` are `x.or_fault(\"why\")`; `switch`/`case` and Kotlin `when` are `match` with `pattern => body` arms; `elif` is `else if`; `and`, `or`, `not` are `&&`, `||`, `!`; `x in xs` is `xs.contains(x)`; `for i := 0; i < n; i++` is `for i in 0..n`; Go `for k, v := range m` is `for (k, v) in m` (the checker names the form for the type); `for cond` is `while cond`; `loop` and `for {}` are `while {}`; `0..<n` is `0..n`, Swift `0...n` is `0..=n`, Kotlin `until` is `..`; `x++` is `x += 1`; `===` is `==`; `**` is `.pow(n)`; `xs[a:b]` is `xs[a..b]`; `throw e` and `raise e` are `return Err(e)`; Swift `try f()` is `f()?` and `throws` is `! Error`; `try`/`catch` has no Xo form (handle the Result); `|x| e`, `(x) => e`, and `lambda x: e` are `fn(x) { e }`; `x as T` is `T(x)`; `A::B` is `A.B`; `impl T { fn m(&self) }` is `fn (self: T) m()` at top level; `trait` is `interface`; `): T` and Go's bare result type are `-> T`; Go `(T, error)` results are `-> T ! Error`, and `return v, nil` is `return v`; `x, err := f()` with `if err != nil { return err }` is `let x = f()?`; backtick templates and Python f-strings are `\"...\${x}...\"`; `/* */` is `//`. See decision 0087 for the policy.", example: "func add(a: Int, b: Int) -> Int {\n  x := a + b\n  x > 0 ? x : -x\n}", fix: "fn add(a: Int, b: Int) -> Int {\n  let x = a + b\n  if x > 0 { x } else { -x }\n}"})
    "XO0178" => Some(Expl{title: "a line starts with a binary operator; end the previous line with it", severity: "error", summary: "a line starts with a binary operator (`||`, `&&`, `+`, `==`, ...); end the previous line with it (core 1.3, decision 0136)", detail: "A newline ends a statement when the line's last token is an identifier, literal, `)`, `]`, `}`, `?`, or `return`, `break`, `continue` (core 1.3, Go's rule). So an expression continued on the next line must leave its operator at the end of the first line: a line that starts with `||`, `&&`, `+`, `==`, `??`, or another binary operator would begin a new statement. Rust, Swift, Kotlin, and some Go style guides put the operator first; Xo cannot, because `-x`, `!x`, and `..n` start expressions and a leading `||` reads as a closure. The machine fix moves the operator to the end of the previous line, and the parser reads the expression as continued, so no other error follows. A line starting with `.` continues a method chain and is allowed. See decision 0136.", example: "fn ready(a: Int, b: Int) -> Bool {\n  a > 0\n    || b > 0\n}", fix: "fn ready(a: Int, b: Int) -> Bool {\n  a > 0 ||\n    b > 0\n}"})
    "XO0179" => Some(Expl{title: "retired: `var` with a tuple or list pattern", severity: "error", summary: "retired (decision 0384): `var (a, b) = ...` is allowed, every name it binds mutable, so nothing is reported", detail: "XO0179 reported `var` followed by a pattern, which only `let` took then, with a fix that wrote `let`. Decision 0384 (the owner, 2026-10-26) made `var PATTERN = e` bind every name of an irrefutable pattern as a `var` (core 3.1, 3.5), so the error is gone. The code stays reserved.", example: "fn f() -> (Int, Int) { (1, 2) }\n\nfn main(os: Os) {\n  var (a, b) = f()\n  a += b\n  os.stdio.println(\"\${a}\")\n}", fix: "// no change needed: a and b are var"})
    "XO0201" => Some(Expl{title: "Result value is never used", severity: "error", summary: "Result value is never used (core 2.6)", detail: "Handling errors is mandatory. A `Result` value that is not propagated with `?`, matched, passed, returned, or stored is an error, and so is a `Result` bound to a name that is never used, whatever the name (including `_x`). This covers expression statements, `defer`, loop bodies, `if` without `else`, and the tail of a unit function or closure. The diagnostic offers `?` as a fix. To discard on purpose, write `.ignore_err(\"reason\")`. See core 2.6.", example: "enum E { A }\n\nfn g() -> Int ! E { 1 }\n\nfn f() {\n  g()\n}", fix: "enum E { A }\n\nfn g() -> Int ! E { 1 }\n\nfn f() ! E {\n  g()?\n}"})
    "XO0202" => Some(Expl{title: "error type does not convert to the enclosing error type", severity: "error", summary: "error type does not convert to the enclosing error type (core 2.6)", detail: "`expr?` on a `Result[T, E2]` returns the error from the enclosing function, so `E2` must convert to its error type `E`: `E2` is `E`, or `E` is `Error` and `E2` implements `Display`, or `E` has a `from E2` variant. Add a `from` variant, derive `Display` for an `Error` target, or convert inline with `map_err`. The same rule applies inside a closure whose error type is fixed. See core 2.6.", example: "enum LoadErr { Timeout }\nenum ApiErr { Bad }\n\nfn g() -> Int ! LoadErr { 1 }\n\nfn f() -> Int ! ApiErr { g()? }", fix: "enum LoadErr { Timeout }\nenum ApiErr { Bad, Load(from LoadErr) }\n\nfn g() -> Int ! LoadErr { 1 }\n\nfn f() -> Int ! ApiErr { g()? }"})
    "XO0203" => Some(Expl{title: "success of a Result typed T must be written Ok(x)", severity: "error", summary: "success of a Result typed T must be written Ok(x) (core 2.6)", detail: "In a function declared `-> T ! E`, a returned `T` means success and a returned `Result[T, E]` is passed through as is. When `T` is itself a `Result`, a returned `Result` would be ambiguous, so success must be written `Ok(x)` explicitly. The same applies to closures whose results are collected, as in `xs.map(fn(x) { Ok(g()) })`. See core 2.6.", example: "enum E { A }\n\nfn f(r: Result[Int, Str]) -> Result[Int, Str] ! E { r }", fix: "enum E { A }\n\nfn f(r: Result[Int, Str]) -> Result[Int, Str] ! E { Ok(r) }"})
    "XO0204" => Some(Expl{title: "`?` on an Option in a function returning a Result", severity: "error", summary: "`?` on an Option in a function returning a Result (core 2.5)", detail: "`opt?` returns `None` from a function that returns an optional. In a function that returns a `Result` there is no error value to return for `None`, so say which error a missing value is: `opt.or_err(E.Missing)?`. The diagnostic offers that fix. Directly in a test block (not in a helper function or a fn literal), `opt?` fails the test with `missing value: opt` instead (decision 0347). See core 2.5. Coming from Go: knowledgebase/guides/option-result-for-go.md maps `if err != nil`, `v, ok := m[k]`, error wrapping, and errors.Is to Xo (https://github.com/xo-lang/xo/blob/main/knowledgebase/guides/option-result-for-go.md).", example: "enum E { Missing }\n\nfn f(s: Str?) -> Str ! E { s? }", fix: "enum E { Missing }\n\nfn f(s: Str?) -> Str ! E { s.or_err(E.Missing)? }"})
    "XO0205" => Some(Expl{title: "`?` where the enclosing function cannot return the failure", severity: "error", summary: "`?` where the enclosing function cannot return the failure (core 2.5, 2.6)", detail: "`?` on a `Result` needs a function or closure that can fail, and `?` on an optional needs one that returns an optional. A function without `!` cannot propagate an error, and a `requires ... else` clause in such a function has nowhere to return its error either. Declare the error type (the diagnostic offers `! E` as a fix), or handle the failure with `match`, `??`, or `ignore_err`. See core 2.5 and 2.6. Coming from Go: knowledgebase/guides/option-result-for-go.md maps `if err != nil`, `v, ok := m[k]`, error wrapping, and errors.Is to Xo (https://github.com/xo-lang/xo/blob/main/knowledgebase/guides/option-result-for-go.md).", example: "enum E { A }\n\nfn g() -> Int ! E { 1 }\n\nfn f() -> Int { g()? }", fix: "enum E { A }\n\nfn g() -> Int ! E { 1 }\n\nfn f() -> Int ! E { g()? }"})
    "XO0206" => Some(Expl{title: "`let _ =` discards a Result; use `.ignore_err(\"reason\")`", severity: "error", summary: "`let _ =` discards a Result; use `.ignore_err(\"reason\")` (core 2.6)", detail: "`let _ = expr` on a `Result` silently drops its error. Xo requires a reason instead: `expr.ignore_err(\"why this failure does not matter\")` yields `T?` and records the reason, so every discarded error is searchable and reviewable (`xo vet` lists them, XO0208). The diagnostic carries a fix that inserts `.ignore_err(\"TODO: reason\")`. Use `r.ok()` when failure simply means no value. See core 2.6.", example: "fn f(fs: Fs) uses fs.write {\n  let _ = fs.remove(\"tmp\")\n}", fix: "fn f(fs: Fs) uses fs.write {\n  let _ = fs.remove(\"tmp\").ignore_err(\"best effort temp file cleanup\")\n}"})
    "XO0908" => Some(Expl{title: "an element counted up and down each iteration", severity: "note", summary: "in a loop, an element of a collection is counted up and down every iteration: it goes to a function value whose result has its type, which takes it (xo vet --cost, decision 0327, 0337)", detail: "Reported by `xo vet --cost`, which builds the program and reads what the compiler did. A named function that only reads a parameter borrows it, so passing it a list element costs nothing. A function value (a closure, a `fn` parameter) borrows its arguments too (decision 0337), except one whose type is the function's result type (or one of a tuple result's: an accumulator, a `var` closure's value), which it takes so the body can update it in place: each element passed there is counted up before the call and down after, atomically when the collection is shared across threads. Call a named function that only reads the element, return another type, or hoist the call out of the loop. The prelude's `map`, `filter`, `find`, `any`, `all`, and `fold` hand every element to their function value the same way, so `xs.map(fn(u: User) -> User { ... })` over elements holding heap memory is noted at the call, and `xs.any(fn(u) { u.name == n })` is not; a `for` loop over the list borrows its elements (decision 0186).", example: "fn total(xs: List[Str], f: fn(Str) -> Str) -> Int {\n  var t = 0\n  for x in xs {\n    t += f(x).len()\n  }\n  t\n}", fix: "fn width(s: Str) -> Int {\n  s.len()\n}\n\nfn total(xs: List[Str]) -> Int {\n  var t = 0\n  for x in xs {\n    t += width(x)\n  }\n  t\n}"})
    "XO0909" => Some(Expl{title: "a list update that copies the whole list every iteration", severity: "note", summary: "in a loop, a list is updated while a holder made in the same iteration keeps it shared, so the update copies it every time (xo vet --cost, decision 0327)", detail: "Reported by `xo vet --cost`, which builds the program and reads what the compiler did. A list update (`push`, `set`, `pop`, `take`) copies the list unless its count is 1. When the loop keeps the list as well as updating it (`snaps.push(xs)`, or a name bound to it and used after the update), the count is 2 at every update, so each iteration copies the whole list: O(n squared). A holder made before the loop costs one copy, after which the loop's list is its own again; a loop that updates the list on every iteration has that one copy moved to its entry. Update a copy you own, or keep the other holder out of the loop.", example: "fn history(n: Int) -> Int {\n  var xs: List[Int] = []\n  var snaps: List[List[Int]] = []\n  for i in 0..n {\n    snaps.push(xs)\n    xs.push(i)\n  }\n  snaps.len() + xs.len()\n}", fix: "fn history(n: Int) -> Int {\n  var xs: List[Int] = []\n  var lens: List[Int] = []\n  for i in 0..n {\n    lens.push(xs.len())\n    xs.push(i)\n  }\n  lens.len() + xs.len()\n}"})
    "XO0910" => Some(Expl{title: "a value over 8 words copied into a closure or an Option", severity: "note", summary: "a value over 8 words is copied where the source shows no copy: captured by a closure, or copied out of a collection into an Option in a loop (xo vet --cost, decision 0327)", detail: "Reported by `xo vet --cost`, which builds the program and reads what the compiler did. A closure captures by value: making it copies each captured value into its environment and shares every heap field of it (Str, Bytes, List, Map, handles), even when the body reads one field. In a loop, `Some(x)` of a collection's element copies the whole element out of the collection and shares its heap fields again. Over 8 words (a cache line) that is a cost the source does not show. Bind the fields the closure reads and capture those; return an index or the one field the caller needs instead of the element.", example: "struct Big {\n  a: Int, b: Int, c: Int, d: Int, e: Int\n  f: Int, g: Int, h: Int, i: Int\n}\n\nfn adder(big: Big) -> fn(Int) -> Int {\n  fn(k: Int) -> Int { big.a + k }\n}", fix: "struct Big {\n  a: Int, b: Int, c: Int, d: Int, e: Int\n  f: Int, g: Int, h: Int, i: Int\n}\n\nfn adder(big: Big) -> fn(Int) -> Int {\n  let a = big.a\n  fn(k: Int) -> Int { a + k }\n}"})
    "XO0911" => Some(Expl{title: "a view of a parameter's text is stored and keeps the whole input alive", severity: "note", summary: "a slice, trim, or element of a split of a parameter's text, made in a loop, is stored in a field or a returned collection (xo vet --cost, decisions 0327 and 0330)", detail: "Reported by `xo vet --cost`. Slicing a Str or Bytes (s[a..b], trim, split, lines) makes a view of the same object, not a copy (decision 0330), so a small token kept in a struct, a map, or a returned list keeps the whole input alive for as long as it is held: 2,000 stored 16 byte tokens of 1 MiB request bodies hold 2.1 GB. Call `clone()` on the token where it is stored. Not noted: a slice used and dropped, a list that stays local, or storing the full text. The note cannot see how large the input is; a small input (a path, a flag) can keep the view.", example: "struct Tok {\n  name: Str\n}\n\nfn parse(text: Str) -> List[Tok] {\n  var out: List[Tok] = []\n  for line in text.lines() {\n    out.push(Tok{name: line[0..1]})\n  }\n  out\n}", fix: "struct Tok {\n  name: Str\n}\n\nfn parse(text: Str) -> List[Tok] {\n  var out: List[Tok] = []\n  for line in text.lines() {\n    out.push(Tok{name: line[0..1].clone()})\n  }\n  out\n}"})
    "XO0907" => Some(Expl{title: "a loop that copies a map's entries first", severity: "note", summary: "the loop over a log-mode map copies every key and value before it starts (xo vet --cost, decision 0327)", detail: "Reported by `xo vet --cost`, which builds the program and reads what the compiler did. A Map written while other values hold it (a store under a Mutex) is in log mode (decision 0291); a `for` over it walks its table in place when the table has no parent views and the body is small (at most 64 nodes) with no closure or defer. Otherwise the loop first copies every entry into fresh lists, counting each key and value up and down once per loop, atomically when the map is shared across threads. Keep the body small (call a function for the work), or read the entries once outside an outer loop.", example: "fn names(m: Mutex[Map[Int, Str]]) -> List[Str] {\n  m.with_read(fn(st) {\n    var out: List[Str] = []\n    for (_, n) in st {\n      out.push(n)\n      let f = fn() { n }\n      out.push(f())\n    }\n    out\n  })\n}", fix: "fn names(m: Mutex[Map[Int, Str]]) -> List[Str] {\n  m.with_read(fn(st) {\n    var out: List[Str] = []\n    for (_, n) in st {\n      out.push(n)\n      out.push(n)\n    }\n    out\n  })\n}"})
    "XO0906" => Some(Expl{title: "a match that `??` writes shorter", severity: "note", summary: "a `match` that only unwraps an Option or a Result or leaves; `x ?? return v` (`r ?? e => return v`) says the same in one line (core 2.5, 2.6, decision 0321)", detail: "Reported by `xo vet`, not `xo check`. `match opt { Some(v) => v  None => return r }` (or `continue`, `break`) is the Option form of `opt ?? return r`: the right side of `??` may leave the function or the loop. On a Result, `match r { Ok(v) => v  Err(e) => return w }` is `r ?? e => return w` (`Err(_)` gives `_ =>`). The fix rewrites it.", example: "fn first(xs: List[Int]) -> Int? {\n  let v = match xs.first() {\n    Some(x) => x\n    None => return None\n  }\n  Some(v)\n}", fix: "fn first(xs: List[Int]) -> Int? {\n  let v = xs.first() ?? return None\n  Some(v)\n}"})
    "XO0207" => Some(Expl{title: "method chain on the right of `??` starts at a literal", severity: "warning", summary: "warning: method chain on the right of `??` starts at a literal, so it applies only to the default (core 15 precedence)", detail: "Reported by `xo vet`, not `xo check`. A method call binds tighter than `??` (core 15 precedence), so in `x ?? [].f()` the call `.f()` applies only to the default `[]`, not to the unwrapped `x`. That is rarely what was meant when the chain starts at a literal. If the chain should apply to both, parenthesize the coalesce: `(x ?? []).f()`. If it really is only for the default, bind the default to a name to make that clear.", example: "fn names(xs: List[Str]?) -> List[Str] {\n  xs ?? [].reverse()\n}", fix: "fn names(xs: List[Str]?) -> List[Str] {\n  (xs ?? []).reverse()\n}"})
    "XO0208" => Some(Expl{title: "`.ignore_err(\"reason\")` discards an error; listed for review", severity: "note", summary: "note: `.ignore_err(\"reason\")` discards an error; listed with its reason for review (core 2.6)", detail: "Reported by `xo vet` as a note, never an error. Every `.ignore_err(\"reason\")` throws away an error, and its reason is the only record of why that is safe (core 2.6). `xo vet` lists each one with its reason so a reviewer can confirm the reason still holds, catch placeholder reasons such as the `TODO: reason` inserted by the XO0206 fix, and decide whether the error should be handled after all.", example: "fn cleanup(fs: Fs) uses fs.write {\n  fs.remove(\"tmp\").ignore_err(\"TODO: reason\")\n}", fix: "// Either give the real reason:\nfn cleanup(fs: Fs) uses fs.write {\n  fs.remove(\"tmp\").ignore_err(\"best effort temp file cleanup\")\n}\n\n// or handle the error:\nfn cleanup_checked(fs: Fs) -> () ! FsErr uses fs.write {\n  fs.remove(\"tmp\")?\n}"})
    "XO0209" => Some(Expl{title: "the result of a call that only computes a value is discarded", severity: "error", summary: "the result of a call that only computes a value is discarded (core 2.6)", detail: "Values are not changed in place: `xs.reverse()`, `xs.sort()`, `s.trim()`, `xs.map(f)` and the like return a new value and leave the receiver as it was. As a statement such a call does nothing. XO0209 reports an expression statement whose call performs no effect (section 6), mutates no `var` receiver or argument, and reaches no handle, interface, or function value through its receiver or arguments (an `Atomic.add`, a channel receive, or a spawn is not reported). The fix assigns the result back (`xs = xs.reverse()`) when the receiver is a `var` binding of the same type; write `let _ = f()` to discard a result on purpose. A `defer` statement's call is not reported, and `xo check --wip` reports it as a warning while the code is still being written. See core 2.6 and decision 0258.", example: "fn f() -> List[Int] {\n  var xs = [3, 1, 2]\n  xs.sort()\n  xs\n}", fix: "fn f() -> List[Int] {\n  var xs = [3, 1, 2]\n  xs = xs.sort()\n  xs\n}"})
    "XO0301" => Some(Expl{title: "match does not cover every case", severity: "error", summary: "match does not cover every case (core 2.3)", detail: "A `match` must cover every value of its subject. The message lists example patterns that are missing (such as `C`, `Some(Err(_))`, `[_]`, or `_` for integers and strings). Guarded arms (`if ...`) do not count toward coverage. A `match` on `target.os` must name every OS, so a missing platform fails on every host. Add the missing arms. For an enum declared in the same module, list the variants rather than adding `_` (XO0305). See core 2.3 and 3.5.", example: "enum E { A, B, C }\n\nfn f(e: E) -> Int {\n  match e {\n    A => 1\n    B => 2\n  }\n}", fix: "enum E { A, B, C }\n\nfn f(e: E) -> Int {\n  match e {\n    A => 1\n    B | C => 2\n  }\n}"})
    "XO0302" => Some(Expl{title: "pattern does not fit the type of the matched value", severity: "error", summary: "pattern does not fit the type of the matched value (core 3.5)", detail: "The pattern can never match because it describes a different type: a variant of another enum, `Ok` on an optional, a literal of the wrong type, a tuple of the wrong size, a list pattern on a non list. It also covers malformed variant and struct patterns: parentheses on a variant without fields (or none on one with fields), too many or repeated fields, and fields left unmentioned without `..`. See core 3.5.", example: "fn f(o: Int?) -> Bool {\n  o is Ok(_)\n}", fix: "fn f(o: Int?) -> Bool {\n  o is Some(_)\n}"})
    "XO0303" => Some(Expl{title: "refutable pattern where an irrefutable one is required", severity: "error", summary: "refutable pattern where an irrefutable one is required (core 3.5)", detail: "`let` and `for` bind every value they get, so their patterns must match every value of the type, such as `(a, b)` for a tuple or `P{x, y}` for a struct. A pattern that can fail, such as `Some(v)`, needs a construct that says what happens otherwise: `if let`, `match`, `??`, or `?`. The message names a value that is not covered. See core 3.5.", example: "fn f(o: Int?) -> Int {\n  let Some(v) = o\n  v\n}", fix: "fn f(o: Int?) -> Int {\n  if let Some(v) = o { v } else { 0 }\n}"})
    "XO0304" => Some(Expl{title: "alternatives of an or pattern bind different names or types", severity: "error", summary: "alternatives of an or pattern bind different names or types (core 3.5)", detail: "The arm body of `p1 | p2` runs for either alternative, so every alternative must bind the same names with the same types; otherwise a name would be unbound in one case. Bind the name in every alternative, or bind it in none and use separate arms. See core 3.5.", example: "fn f(r: Result[Int, Int]) -> Int {\n  match r {\n    Ok(v) | Err(_) => v\n  }\n}", fix: "fn f(r: Result[Int, Int]) -> Int {\n  match r {\n    Ok(v) | Err(v) => v\n  }\n}"})
    "XO0305" => Some(Expl{title: "`_` arm hides variants of an enum declared in this module", severity: "warning", summary: "warning: `_` arm hides variants of an enum declared in this module (core 3.5)", detail: "Warning. An unguarded `_` or catch all binding arm on an enum declared in the same module hides the variants it covers, so adding a variant later compiles silently instead of failing at every `match`. List the variants (an or pattern such as `B | C` keeps it short). Enums from other modules, the prelude (`Option`, `Result`), and non enum values may use `_`, since their owners can add variants. A `_` arm that hides at least 8 variants and more than half of the enum is a deliberate default and is not reported (decision 0080). See core 3.5.", example: "enum E { A, B, C }\n\nfn f(e: E) -> Int {\n  match e {\n    A => 1\n    _ => 2\n  }\n}", fix: "enum E { A, B, C }\n\nfn f(e: E) -> Int {\n  match e {\n    A => 1\n    B | C => 2\n  }\n}"})
    "XO0401" => Some(Expl{title: "value of the wrong type; only three implicit conversions exist", severity: "error", summary: "value of the wrong type; only three implicit conversions exist (core 2.10)", detail: "The value's type is not the expected one. Xo converts implicitly in exactly three cases, each only where the target type is known: `T` to `T?`, a value to an interface it implements, and an error at `?` to the enclosing error type. Everything else is explicit, including all numeric conversions (`Float(i)`) and newtypes (`Email(s)`). Branches of `if` and `match` must already agree; annotate the binding to give them an expected type. See core 2.10.", example: "fn f(i: Int) -> Float { i }", fix: "fn f(i: Int) -> Float { Float(i) }"})
    "XO0402" => Some(Expl{title: "type arguments cannot be inferred", severity: "error", summary: "type arguments cannot be inferred (core 2.7)", detail: "A generic function's type parameter was determined by nothing: not the arguments, the expected type, or later use. Write the type argument explicitly (`json.decode[Int](b)`), or give the result an expected type. See core 2.7.", example: "use std/json\n\nfn f(b: Bytes) -> Int {\n  let _ = json.decode(b).ok()\n  1\n}", fix: "use std/json\n\nfn f(b: Bytes) -> Int {\n  let _ = json.decode[Int](b).ok()\n  1\n}"})
    "XO0403" => Some(Expl{title: "wrong arguments or fields: count, names, missing, or duplicates", severity: "error", summary: "wrong arguments or fields: count, names, missing, or duplicates", detail: "A call, struct literal, variant construction, or type application does not match its declaration: too many or too few arguments, an unknown or repeated parameter name, a positional argument after a named one, a missing struct field without a default, or the wrong number of type arguments. Variants with several fields are constructed with names (`A(x: 1, y: 2)`), and `ignore_err` needs its reason. See core 2.2, 2.3, and 3.2.", example: "struct P { x: Int, y: Int }\n\nfn f() -> P { P{x: 1} }", fix: "struct P { x: Int, y: Int }\n\nfn f() -> P { P{x: 1, y: 0} }"})
    "XO0404" => Some(Expl{title: "type does not implement a required interface or constraint", severity: "error", summary: "type does not implement a required interface or constraint (core 2.4)", detail: "The value is used in a way that needs an interface its type does not implement: interpolation needs `Display`, `==` needs `Eq`, `<` needs `Ord`, `json.encode` needs `Json`, a generic call needs its constraint (`T: Ord`), and `derive X` needs every field to implement `X`. A value that holds a handle (`Mutex`, `Atomic`, `Chan`, `Task`, `Conn`, ...) or a function value is never `Eq` or `Hash`: it cannot be compared, be a Map key or Set element, or derive `Eq`, `Hash`, or `Ord` (decision 0112); compare an identifying field instead. Add `derive` to the type, implement the interface's methods, or convert the value first. See core 2.4 and 2.9.", example: "struct P { x: Int }\n\nfn f(p: P) -> Str { \"\${p}\" }", fix: "struct P { x: Int } derive Display\n\nfn f(p: P) -> Str { \"\${p}\" }"})
    "XO0405" => Some(Expl{title: "type cannot be inferred here; annotate it", severity: "error", summary: "type cannot be inferred here; annotate it", detail: "The checker needs a type at this point and nothing determines it yet: a closure parameter with no expected function type, a value whose method or field is used before its type is known, a `match` subject, or an iterated value. Add a type annotation to the parameter or binding. See core 3.3.", example: "fn f() -> Int {\n  let g = fn(p) { p }\n  g(1)\n}", fix: "fn f() -> Int {\n  let g = fn(p: Int) -> Int { p }\n  g(1)\n}"})
    "XO0406" => Some(Expl{title: "operator, index, slice, or iteration not defined for the type", severity: "error", summary: "operator, index, slice, or iteration not defined for the type", detail: "The operation does not exist for this type: arithmetic between `Duration` and a plain integer literal, `Time + Time`, indexing a `Str` by position, slicing something other than `List`, `Bytes`, or `Str`, `for` over a value that is not a List, Set, Map, Chan, Bytes, or range, `??` on a non optional, or `expect(x)` without a comparison. Durations need units (`5s`), and a `Str` is read with `runes()` or by slicing. See core 2.1, 3.5, and 3.6. Coming from Go: knowledgebase/guides/option-result-for-go.md maps `if err != nil`, `v, ok := m[k]`, error wrapping, and errors.Is to Xo (https://github.com/xo-lang/xo/blob/main/knowledgebase/guides/option-result-for-go.md).", example: "fn f(d: Duration) -> Duration { d + 5 }", fix: "fn f(d: Duration) -> Duration { d + 5s }"})
    "XO0407" => Some(Expl{title: "name used as the wrong kind of thing", severity: "error", summary: "name used as the wrong kind of thing (a type as a value, a value that is not callable)", detail: "A name resolved, but to the wrong kind of entity: a type used as a value, a module or constant called like a function, a value given type arguments, a non interface used as a constraint, a method declared on an interface, or a type alias or constant that refers to itself. A common case is `t.await()`: `await` is written without parentheses. See core 2.4, 2.7, and 7.1.", example: "fn f() -> Int {\n  scope s {\n    let t = s.spawn(fn() { 1 })\n    t.await()\n  }\n}", fix: "fn f() -> Int {\n  scope s {\n    let t = s.spawn(fn() { 1 })\n    t.await\n  }\n}"})
    "XO0408" => Some(Expl{title: "block const initializer is not a compile time value", severity: "error", summary: "a `const` inside a block must be a compile time value (core 3.1)", detail: "A `const` declared inside a function body may use only literals, other constants, struct and enum construction, and collection literals of those. A top level `const` may also call effect free functions: it is computed once, on first use (decision 0332). Move the constant to the top level, or use a `let` binding. See core 3.1.", example: "fn g() -> Int { 1 }\n\nfn f() -> Int {\n  const X = g()\n  X\n}", fix: "fn g() -> Int { 1 }\n\nconst X = g()\n\nfn f() -> Int {\n  X\n}"})
    "XO0415" => Some(Expl{title: "const initializer performs an effect", severity: "error", summary: "a const initializer cannot perform effects; it runs once, at first use (core 3.1)", detail: "A top level `const` may call functions, but its initializer's inferred effect set must be empty: no `fs`, `net`, `clock`, `rand`, `env`, `proc`, `stdio`, or `ffi`. It runs once, at the first read, in whichever task reads it first, so an effect there would happen at a time the program text does not show, and the value would depend on more than the program. Read the input in `main` and pass the value down. See core 3.1 and decision 0332.", example: "fn stamp() -> Int uses clock {\n  42\n}\n\nconst START = stamp()", fix: "fn stamp() -> Int uses clock {\n  42\n}\n\nfn main(os: Os) {\n  let start = stamp()\n  os.stdio.println(start.display())\n}"})
    "XO0416" => Some(Expl{title: "const value holds a handle", severity: "error", summary: "a const value cannot hold a Mutex, channel, task, or other handle (core 3.1)", detail: "A constant is an immutable value shared by every task, not a global variable. Its type may not contain, at any depth, a `Mutex`, a channel, a task handle, or another handle type, since that would make it shared mutable state. Create the handle in `main` or a `scope` and pass it down. See core 3.1 and decision 0332.", example: "const LOCK = Mutex.new(0)", fix: "fn main(os: Os) {\n  let lock = Mutex.new(0)\n  lock.with(fn(var n) { n += 1 })\n}"})
    "XO0409" => Some(Expl{title: "invalid explicit conversion", severity: "error", summary: "invalid explicit conversion (core 2.1)", detail: "Numeric conversions such as `Int(x)` and `Float(x)` take a number. Text is not a number: parse it with `Int.parse(s)`, which returns `Int?`, and decide what a bad input means. See core 2.1.", example: "fn f(s: Str) -> Int { Int(s) }", fix: "fn f(s: Str) -> Int { Int.parse(s) ?? 0 }"})
    "XO0410" => Some(Expl{title: "reading a Map by index; use `get` or `get_or_fault`", severity: "error", summary: "reading a Map by index; use `get` or `get_or_fault` (core 3.6)", detail: "A missing key is the Map form of a nil dereference, so `m[k]` in an expression, or an in place change through it (`m[k].f = v`, `m[k] += 1`), is an error. Use `m.get(k)` (an optional), `m.get_or_fault(k, \"why the key must exist\")`, or `m.update(k, init, fn(var v) { ... })`. On a `var` map the whole value assignment `m[k] = v` is allowed and means `m.put(k, v)`. See core 3.6.", example: "fn f(m: Map[Str, Int]) -> Int {\n  m[\"a\"]\n}", fix: "fn f(m: Map[Str, Int]) -> Int {\n  m.get(\"a\") ?? 0\n}"})
    "XO0411" => Some(Expl{title: "two fields have one wire key", severity: "error", summary: "two fields have one wire key under a derive the struct has (core 2.2, decision 0277)", detail: "A field's key in `derive Json` and its column in `derive SqlRow` is its wire name (`kind as \"type\": Str`), else its name under the derive's `case:` rule, else its name. Two fields of one struct with the same key would read the same JSON key or column. Give one of them another wire name. See core 2.2.", example: "struct Event {\n  kind: Str\n  other as \"kind\": Str\n} derive Json", fix: "struct Event {\n  kind: Str\n  other as \"other_kind\": Str\n} derive Json"})
    "XO0412" => Some(Expl{title: "empty wire name", severity: "error", summary: "empty wire name, `as \"\"` (core 2.2)", detail: "A field's wire name (`name as \"key\": T`) is its JSON key or SqlRow column and cannot be empty. Write the key, or leave out `as` to use the field's name. See core 2.2.", example: "struct User {\n  name as \"\": Str\n} derive Json", fix: "struct User {\n  name: Str\n} derive Json"})
    "XO0413" => Some(Expl{title: "unknown derive argument", severity: "error", summary: "unknown derive argument or `case:` value, or an argument on a derive that takes none (core 2.2)", detail: "`derive Json` and `derive SqlRow` take one argument, `case:`, which is snake, camel, pascal, or kebab: it converts the keys of the fields without their own wire name. Other derives take no arguments. See core 2.2.", example: "struct User {\n  user_id: Int\n} derive Json(case: shouty)", fix: "struct User {\n  user_id: Int\n} derive Json(case: camel)"})
    "XO0414" => Some(Expl{title: "wire name no derive uses", severity: "warning", summary: "a wire name on a struct with no derive that maps fields to keys (core 2.2)", detail: "A field's wire name (`name as \"key\": T`) is used only by `derive Json` and `derive SqlRow`. On a struct with neither it changes nothing. Add the derive, or remove the wire name. See core 2.2.", example: "struct User {\n  name as \"Name\": Str\n}", fix: "struct User {\n  name as \"Name\": Str\n} derive Json"})
    "XO0420" => Some(Expl{title: "constant std/time layout is invalid", severity: "error", summary: "constant std/time layout is invalid: unknown field, bad field form, or stray brace (std.md 13.3)", detail: "A layout passed to `time.format`, `time.parse`, or `time.check_layout` is written with named, lowercase fields: `{year}`, `{month}` (also `{month:1}`, `{month:short}`, `{month:name}`), `{day}` (`{day:1}`), `{weekday:short}`, `{weekday:name}`, `{hour}`, `{hour12}` with `{ampm}`, `{minute}`, `{second}`, `{frac}` (`{frac:1}` to `{frac:9}`), `{offset}` (`{offset:compact}`), `{zone}`, and `{lbrace}`/`{rbrace}` for literal braces (std.md 13.3). When the layout is a constant (a string literal, a `const`, or a `+` of them) the checker parses it: an unknown field, a field form that does not exist, a stray brace, or `{hour12}` without `{ampm}` is this error, with a did you mean fix for a misspelled field. Date patterns of other languages (`{yyyy}`, `yyyy-MM-dd`, `%Y-%m-%d`, Go's `2006-01-02`) are the habit XO0177 instead, with a fix to the named fields. A layout built at run time is not checked here: `format` and `parse` fault on a bad one, and `time.check_layout` returns a `Result` for layouts that come from input. See decision 0094.", example: "use std/time\n\nfn stamp(t: Time) -> Str {\n  time.format(t, time.utc(), \"{year}-{month}-{dya}\")\n}", fix: "use std/time\n\nfn stamp(t: Time) -> Str {\n  time.format(t, time.utc(), \"{year}-{month}-{day}\")\n}"})
    "XO0421" => Some(Expl{title: "integer literal does not fit its type", severity: "error", summary: "an integer literal is outside the range of the integer type it takes in context", detail: "An integer literal takes the integer type expected in context (`Int` by default), and its value must fit that type: `300` is not an `Int8`, `9223372036854775808` is not an `Int`, and a negative literal is not an unsigned type. A minus written directly on the literal makes a negative literal, so a type's minimum is written `-128` or `-9223372036854775808`; with parentheses, `-(128)`, the literal must fit alone. See core 1.6.", example: "fn main(os: Os) {\n  let b: Int8 = 300\n  os.stdio.println(\"\${b}\")\n}", fix: "fn main(os: Os) {\n  let b: Int16 = 300\n  os.stdio.println(\"\${b}\")\n}"})
    "XO0422" => Some(Expl{title: "unknown wire name option", severity: "error", summary: "unknown wire name option; the only one is `omitempty` (core 2.2, decision 0309)", detail: "A field's wire string may carry options after a comma, as in a Go struct tag: `name as \"key,omitempty\": T`, or `as \",omitempty\"` to keep the default key. `omitempty` is the only option: `derive Json` then leaves the field out when its value is empty (None, false, 0, \"\", or no elements). Go's other options (`string`, `omitzero`) do not exist in Xo. Remove the option. See core 2.2 and decision 0309.", example: "struct User {\n  id as \"id,string\": Int\n} derive Json", fix: "struct User {\n  id as \"id\": Int\n} derive Json"})
    "XO0423" => Some(Expl{title: "a format's wire string given twice", severity: "error", summary: "a field has two wire strings for one format (core 2.2, decision 0315)", detail: "A field may override its shared wire name (`as \"name\"`) once per format, with `json \"...\"`, `sql \"...\"`, or `xml \"...\"`. Two strings for the same format leave its name ambiguous. Keep one. See core 2.2 and decision 0315.", example: "struct User {\n  id json \"id\" json \"ID\": Int\n} derive Json", fix: "struct User {\n  id json \"ID\": Int\n} derive Json"})
    "XO0424" => Some(Expl{title: "a wire string for a format the struct does not derive", severity: "error", summary: "a format's wire string on a struct that does not derive that format (core 2.2, decision 0315)", detail: "`json \"...\"` names a field for `derive Json`, `sql \"...\"` for `derive SqlRow`, and `xml \"...\"` for `derive Xml`. On a struct without that derive the string changes nothing, which is likely a mistake. Add the derive, or remove the string. See core 2.2 and decision 0315.", example: "struct Row {\n  created sql \"created_at\": Int\n} derive Json", fix: "struct Row {\n  created sql \"created_at\": Int\n} derive Json, SqlRow"})
    "XO0425" => Some(Expl{title: "a field type derive Xml cannot map", severity: "error", summary: "derive Xml needs a struct without type parameters whose fields are Str, Int, Float, Bool, or a struct that derives Xml, alone, as an Option, or in a List (core 2.9, decision 0315)", detail: "`derive Xml` generates Go's Marshal and Unmarshal for the struct from its field types. A field of another type (a Map, a Time, a Bytes), a struct with type parameters, or a nested struct without `derive Xml` cannot be mapped. Change the field, or give the nested struct `derive Xml`. See core 2.9.", example: "struct Page {\n  meta: Map[Str, Str]\n} derive Xml", fix: "struct Page {\n  title: Str\n} derive Xml"})
    "XO0426" => Some(Expl{title: "a bad xml wire string", severity: "error", summary: "an xml wire string with an unknown or unsupported option, `attr` with a path, or `chardata` or `attr` on a type that cannot hold it (core 2.9, decision 0315)", detail: "An `xml` string is Go's tag text: `name`, `name,attr`, `,chardata`, `a>b>c`, `,omitempty`, or `-`. `attr` takes a Str, Int, Float, or Bool (or an Option of one) and no path; `chardata` takes a Str. `innerxml`, `comment`, and `any` are not supported yet. See core 2.9.", example: "struct Item {\n  id xml \"ID,attr,bogus\": Int\n} derive Xml", fix: "struct Item {\n  id xml \"ID,attr\": Int\n} derive Xml"})
    "XO0427" => Some(Expl{title: "xml.decode of a type parameter", severity: "error", summary: "`xml.encode_value` or `xml.decode` of a type parameter instead of a concrete struct that derives Xml (core 2.9, decision 0315)", detail: "A call of `xml.encode_value` or `xml.decode` is compiled as a call of the function `derive Xml` generates for its struct, so the type must be known where it is called. Call it with the struct, or take the decoder as a function value. See core 2.9.", example: "fn read[T: Xml](s: Str) -> T ! xml.XmlErr {\n  xml.decode[T](s)\n}", fix: "fn read_item(s: Str) -> Item ! xml.XmlErr {\n  xml.decode[Item](s)\n}"})
    "XO0501" => Some(Expl{title: "var method called on a non var binding", severity: "error", summary: "var method called on a non var binding (core 3.4)", detail: "A method with a `var` receiver (including mutating collection methods such as `push` and `put`) changes the caller's binding in place. It can be called only on a `var` binding, a `var` parameter, or a field of one. A `Mutex.with` closure parameter declared without `var` is a read only view. Declare the binding with `var` (the diagnostic offers that fix). See core 3.4 and 5.2.", example: "fn f() -> List[Int] {\n  let xs = [1]\n  xs.push(2)\n  xs\n}", fix: "fn f() -> List[Int] {\n  var xs = [1]\n  xs.push(2)\n  xs\n}"})
    "XO0502" => Some(Expl{title: "assignment to an immutable binding or to a captured variable", severity: "error", summary: "assignment to an immutable binding or to a captured variable (core 5.2, 3.3)", detail: "Only `var` bindings, `var` parameters, `var` receivers, and their fields and elements can be assigned or passed to a `var` parameter. `let`, constants, pattern bindings, and `for` bindings are immutable. Closures capture by value, so mutating a captured `var` inside a closure is also an error; share state through a `Mutex` or `Atomic` instead. See core 3.3 and 5.2.", example: "fn f() -> Int {\n  let x = 1\n  x = 2\n  x\n}", fix: "fn f() -> Int {\n  var x = 1\n  x = 2\n  x\n}"})
    "XO0503" => Some(Expl{title: "one variable or overlapping places passed to two `var` parameters of one call", severity: "error", summary: "one variable or overlapping places passed to two `var` parameters of one call (core 5.2, decision 0111)", detail: "A call may not pass the same variable, or two places that overlap (`x` and `x.f`, `xs[i]` and `xs[j]` unless both indexes are different literals, a `var` receiver and an argument naming it), to two `var` parameters. The Go backend passes `var` arguments by reference and the native backends copy them in and out, so aliased writes would differ; with aliasing ruled out both conventions give one result. Copy one of the places into a temporary, pass the temporary, and store it back after the call, or take a single `var` parameter of a struct that holds both values. See core 5.2 and decision 0111.", example: "fn both(var a: List[Int], var b: List[Int]) {\n  a.push(1)\n  b.push(2)\n}\n\nfn f() -> Int {\n  var xs = [0]\n  both(xs, xs)\n  xs.len()\n}", fix: "fn both(var a: List[Int], var b: List[Int]) {\n  a.push(1)\n  b.push(2)\n}\n\nfn f() -> Int {\n  var xs = [0]\n  var ys = xs\n  both(xs, ys)\n  xs.len() + ys.len()\n}"})
    "XO0510" => Some(Expl{title: "use of a moved Buf, StrBuilder, BytesBuilder, or std move only handle", severity: "error", summary: "use of a moved Buf, StrBuilder, BytesBuilder, or std move only handle (core 5.3)", detail: "`Buf[T]`, `StrBuilder`, and `BytesBuilder` are mutable in place and move only, as are the std handles documented `@move_only` (std/compress's Compressor and Decompressor; the marker has no effect in user code). `freeze()`, assigning, passing to a function, sending on a channel, or capturing in a spawned task moves the buffer, and the old name may not be used again (until it is reassigned). Finish all writes before moving, or start a new buffer. See core 5.3.", example: "fn f() -> List[Int] {\n  var b = Buf[Int].with_capacity(8)\n  b.push(1)\n  let xs = b.freeze()\n  b.push(2)\n  xs\n}", fix: "fn f() -> List[Int] {\n  var b = Buf[Int].with_capacity(8)\n  b.push(1)\n  b.push(2)\n  b.freeze()\n}"})
    "XO0520" => Some(Expl{title: "mutation of a copied or stored collection element is never written back", severity: "error", summary: "mutation of a copied or stored collection element is never written back (core 5.2)", detail: "Xo collections hold values, not references. A local `var` initialized from a collection element (`m.get(k)`, `m[k]`, `xs[i]`, `first`, `find`, optionally with `??`, `?`, or `.or_err(...)?`) and then mutated changes only the copy; the collection keeps the old value. The same holds for a `var` mutated after being pushed or put into a collection. Store it again (`m.put(k, b)`), or use `m.update(k, init, fn(var b) { ... })`. Reading or returning the copy does not count as storing. See core 5.2.", example: "struct Bucket { tokens: Int }\n\nfn take(m: Map[Str, Bucket], k: Str) {\n  var b = m.get(k) ?? Bucket{tokens: 3}\n  b.tokens -= 1\n}", fix: "struct Bucket { tokens: Int }\n\nfn take(var m: Map[Str, Bucket], k: Str) {\n  var b = m.get(k) ?? Bucket{tokens: 3}\n  b.tokens -= 1\n  m.put(k, b)\n}"})
    "XO0530" => Some(Expl{title: "binding the payload of a field shares every heap field of a large value", severity: "warning", summary: "warning: binding the payload of a field shares every heap field of a large value (decision 0263)", detail: "Reported by `xo vet`, not `xo check`. `match s.conn { Some(c) => ... }` (or `if let`) on a field of a value that lives on binds a copy of the payload: every reference counted field of it (Str, Bytes, List, Map, handles) is shared, and released again when the copy or the field is dropped. For a payload with at least 8 such fields that is a fixed walk on every match, which profiles of the HTTP/2 server found at about 4,000 instructions a request. Test the field with `.is_none()` or a pattern without bindings first when the payload is not needed, read the one part needed (`s.conn.map(...)`), or take the value out of its owner before matching. See decision 0263.", example: "struct Conn {\n  a: Str, b: Str, c: Str, d: Str\n  e: Str, f: Str, g: Str, h: Str\n}\n\nstruct Srv {\n  conn: Conn?\n}\n\nfn label(s: Srv) -> Str {\n  match s.conn {\n    Some(c) => c.a\n    None => \"none\"\n  }\n}", fix: "struct Conn {\n  a: Str, b: Str, c: Str, d: Str\n  e: Str, f: Str, g: Str, h: Str\n}\n\nstruct Srv {\n  conn: Conn?\n}\n\nfn label(s: Srv) -> Str {\n  if s.conn.is_none() {\n    return \"none\"\n  }\n  s.conn.map(fn(c) { c.a }) ?? \"none\"\n}"})
    "XO0531" => Some(Expl{title: "a large parameter is only stored while each caller passes its last use", severity: "warning", summary: "warning: a large parameter is only stored while each caller passes its last use (decision 0263)", detail: "Reported by `xo vet`, not `xo check`. A parameter is borrowed from the caller: storing it (in a struct literal, a list or map literal, a push, put, or insert, rt.any_of) shares every reference counted field of the value (Str, Bytes, List, Map, handles), and the caller then releases its own copy after the call. When every caller passes a local it does not use again, storing the value at the caller (or returning it from the function) moves it instead and does neither walk. For a value with at least 8 such fields a profile of the HTTP/2 server found about 5,600 instructions a call. See decision 0263.", example: "struct Conn {\n  a: Str, b: Str, c: Str, d: Str\n  e: Str, f: Str, g: Str, h: Str\n}\n\nstruct Saved {\n  conn: Conn\n}\n\nfn save(c: Conn) -> Saved {\n  Saved{conn: c}\n}\n\nfn handle(c: Conn) -> Saved {\n  let d = c\n  save(d)\n}", fix: "struct Conn {\n  a: Str, b: Str, c: Str, d: Str\n  e: Str, f: Str, g: Str, h: Str\n}\n\nstruct Saved {\n  conn: Conn\n}\n\nfn handle(c: Conn) -> Saved {\n  let d = c\n  Saved{conn: d}\n}"})
    "XO0532" => Some(Expl{title: "a Map value read, changed, and stored back", severity: "note", summary: "note: a Map value read into a var, changed, and stored back; Map.update does it in one lookup (decision 0266)", detail: "Reported by `xo vet`, not `xo check`. `var x = m.get(k) ?? d`, statements that only change x, then `m[k] = x` looks the key up twice and depends on the last line: values are copies (core 2.6), so without it the change is lost (the checker's XO0520). `m.update(k, d, fn(var x) { ... })` reads k (or d), runs the function on the value in place, stores it, and returns the function's value (std.md 2.4). The fix rewrites the statements into that call. See decision 0266.", example: "fn index(var by: Map[Str, List[Int]], name: Str, i: Int) {\n  var ids = by.get(name) ?? []\n  ids.push(i)\n  by[name] = ids\n}", fix: "fn index(var by: Map[Str, List[Int]], name: Str, i: Int) {\n  by.update(name, [], fn(var ids) {\n    ids.push(i)\n  })\n}"})
    "XO0534" => Some(Expl{title: "a task captures a value with many heap fields", severity: "note", summary: "note: a task captures a value with 32 or more heap fields, sharing each at the spawn (core 5.1, decision 0294)", detail: "Reported by `xo vet`, not `xo check`. A closure passed to `Scope.spawn` or `spawn_background` captures by value (core 5.1): the spawn shares each heap field of the value (Str, Bytes, List, Map, Set, boxes, handles, counted through nested structs) and the task's end releases them, and the first change to a collection in it while both the task and the spawner hold it copies that collection. For a struct the size of the compiler's Checker that is hundreds of count updates per task. Bind the fields the task uses before the spawn and capture those. The program is correct either way; this is about time. See core 5.1 and decision 0294.", example: "// State has 40 List and Map fields\nfn run(st: State) {\n  scope s {\n    s.spawn(fn() { count(st.users) })\n  }\n}", fix: "fn run(st: State) {\n  let users = st.users\n  scope s {\n    s.spawn(fn() { count(users) })\n  }\n}"})
    "XO0535" => Some(Expl{title: "`.debug()` inside an interpolation", severity: "note", summary: "note: `\${x.debug()}` in a string, which `\${x:?}` writes shorter; its fix rewrites it (core 1.6, decision 0296)", detail: "Reported by `xo vet`, not `xo check`. `\${expr:?}` interpolates the Debug text of expr, the same text as `expr.debug()`, so `\${xs.debug()}` is `\${xs:?}`. The diagnostic carries the fix (in `xo vet --json`), which replaces `.debug()` with `:?`. A type's own `debug` method is left alone. See core 1.6 and decision 0296.", example: "fn show(xs: List[Int]) -> Str {\n  \"items \${xs.debug()}\"\n}", fix: "fn show(xs: List[Int]) -> Str {\n  \"items \${xs:?}\"\n}"})
    "XO0538" => Some(Expl{title: "a variable written after a closure captured it", severity: "warning", summary: "warning: a closure takes its captures by value when it is created, so a write to the variable after that is invisible to the closure (core 5.1)", detail: "Reported by `xo vet`, not `xo check`. `let root = fn(k) { .. up[k] .. }` copies `up` when the closure is created. A later `up[i] = x`, `up = ..`, or `up.push(..)` in the enclosing function changes `up` but not the closure's copy, so every later call of `root` walks the old value. Found as the union find bug of the arm64 SLP pass (2026-10-21), where every pack stayed its own group. The check fires for a `let name = fn(..) { .. }` whose body reads a `var` local, a write to that local in a later statement of the same block, and a use of `name` after the write. Pass the variable as a parameter (`fn(k, up)`), or move the closure after the writes. See core 5.1.", example: "fn groups(n: Int) -> Int {\n  var up: List[Int] = [0, 1, 2]\n  let root = fn(k: Int) -> Int { up[k] }\n  up[0] = 2\n  root(0)\n}", fix: "fn groups(n: Int) -> Int {\n  var up: List[Int] = [0, 1, 2]\n  up[0] = 2\n  let root = fn(k: Int) -> Int { up[k] }\n  root(0)\n}"})
    "XO0537" => Some(Expl{title: "retired: a by value receiver read before an argument that changes it", severity: "warning", summary: "retired (decision 0326): a by value receiver that is a variable or a field path is read after the call's arguments, so `x.m(x.n(..))` has one meaning and nothing is reported", detail: "xo vet used to report `x.m(x.n(..))` where m takes x by value and n is a `var` method of x, because the call read x before n ran. Decision 0326 made the receiver read after the arguments (as a `var` receiver always was, decision 0142), so the check was removed. The code stays reserved. See the gotcha receiver-read-before-args.", example: "fn size_of(var t: Table, v: Int) -> Int {\n  t.size(t.add(v))\n}", fix: "// no change needed: size sees the item add pushed"})
    "XO0540" => Some(Expl{title: "a Mutex.with write that an Err undoes", severity: "warning", summary: "the closure writes its `var` value, then a path returns Err, which undoes the write (core 5.4)", detail: "A `Mutex.with` closure's changes to its `var` value are written back only when it returns successfully; an Err (a `return Err(...)`, a `?`, or a call that can fail as the closure's result) leaves the protected value as it was. A sticky error, a `done` flag, or consumed input stored before the failure is lost with it. To keep the change and still report the failure, return the outcome as the closure's success value (its type `Result[T, E]` with no `!`) and apply `?` outside the `with`.", example: "fn fail(m: Mutex[St], e: E) -> () ! E {\n  m.with(fn(var st) -> () ! E {\n    st.err = Some(e)\n    Err(e)\n  })\n}", fix: "fn fail(m: Mutex[St], e: E) -> () ! E {\n  let r = m.with(fn(var st) -> Result[(), E] {\n    st.err = Some(e)\n    Err(e)\n  })\n  r?\n}"})
    "XO0536" => Some(Expl{title: "a collection copied out of a list element, changed, and stored back", severity: "note", summary: "note: `var x = xs[i]` with a collection element, changed, then `xs[i] = x`: the first change copies the whole element (core 5.1, decision 0294)", detail: "Reported by `xo vet`, not `xo check`. `var x = xs[i]` shares the element with xs, so the first change to x (a push, an element write, a var argument) copies all of it, and `xs[i] = x` stores the copy back. In a loop that copies the element on every pass: the PE linker copied a whole section at each relocation that way and linked xo.exe in quadratic time (2026-10-20). Change the element in place: `xs[i].push(v)`, `xs[i][j] = v`, or pass `xs[i]` to a `var` parameter (decision 0169); the store back is then not needed. Taking the element first (`xs[i] = []` right after the read) also avoids the copy and is not reported. See core 5.1 and decision 0294.", example: "fn fill(var bufs: List[List[Int]], k: Int, n: Int) {\n  for i in 0..n {\n    var b = bufs[k]\n    b.push(i)\n    bufs[k] = b\n  }\n}", fix: "fn fill(var bufs: List[List[Int]], k: Int, n: Int) {\n  for i in 0..n {\n    bufs[k].push(i)\n  }\n}"})
    "XO0601" => Some(Expl{title: "name does not resolve", severity: "error", summary: "name does not resolve (core 4.3)", detail: "A variable, function, type, field, method, module, or effect name does not exist where it is used. The diagnostic suggests the nearest real names, so an API cannot be hallucinated silently. It also covers `os`, `expect`, and `testing` outside tests, a tuple field out of range, and `result` outside an `ensures` clause. `Float.from(n)` and other unknown associated functions of a numeric type called with one numeric argument get the fix `Float(n)`: numeric conversions are calls on the type name (std.md 2.1). A print function of another language (`println`, `print`, `fmt.Println`, `console.log`) is this error too, because Xo prints through the `Stdio` capability: `fn main(os: Os)` and `os.stdio.println(\"...\")`, or a `stdio: Stdio` parameter in another function; `dbg(x)` prints while debugging. See core 4.3. Coming from Go: knowledgebase/guides/option-result-for-go.md maps `if err != nil`, `v, ok := m[k]`, error wrapping, and errors.Is to Xo (https://github.com/xo-lang/xo/blob/main/knowledgebase/guides/option-result-for-go.md).", example: "fn f() -> Int {\n  let count = 1\n  coutn\n}", fix: "fn f() -> Int {\n  let count = 1\n  count\n}"})
    "XO0602" => Some(Expl{title: "import path does not yield a valid local name", severity: "error", summary: "import path does not yield a valid local name (core 4.1)", detail: "An import binds its last path segment as the local name, with `-` replaced by `_`. For a Go package the local name is the Go package name. If the result is still not a valid identifier, or is a keyword, give the import a name with `as`. See core 4.1.", example: "// main/main.xo, with a module directory 03-lib\nuse example.com/app/03-lib\n\nfn f() -> Int { 1 }", fix: "use example.com/app/03-lib as lib\n\nfn f() -> Int { lib.one() }"})
    "XO0603" => Some(Expl{title: "name declared twice in one scope, or a predeclared name redefined", severity: "error", summary: "name declared twice in one scope, or a predeclared name redefined (core 3.1, 1.4)", detail: "A name may be declared once per scope: top level declarations, fields, variants, methods, parameters, imports, and bindings in one block. Shadowing is allowed only in a nested block. Predeclared names (`Option`, `Result`, `true`, `dbg`, builtin types, ...) cannot be redefined at top level, and a type cannot have a field and a method with the same name. See core 1.4 and 3.1.", example: "fn f() -> Int {\n  let x = 1\n  let x = 2\n  x\n}", fix: "fn f() -> Int {\n  let x = 1\n  let y = 2\n  x + y\n}"})
    "XO0604" => Some(Expl{title: "cyclic module imports", severity: "error", summary: "cyclic module imports (core 4.1)", detail: "Modules may not import each other in a cycle, so every module can be checked and built after its dependencies. Move the shared declarations into a third module that both import, or merge the two modules. See core 4.1.", example: "// a/a.xo\nuse example.com/app/b\n\npub fn fa() -> Int { b.fb() }\n\n// b/b.xo\nuse example.com/app/a\n\npub fn fb() -> Int { 1 }\npub fn g() -> Int { a.fa() }", fix: "// a/a.xo\nuse example.com/app/b\n\npub fn fa() -> Int { b.fb() }\n\n// b/b.xo (no longer imports a)\npub fn fb() -> Int { 1 }"})
    "XO0605" => Some(Expl{title: "name is not `pub` in its module, or the std type is an opaque handle", severity: "error", summary: "name is not `pub` in its module, or the std type is an opaque handle (core 1.5)", detail: "Only `pub` declarations, fields, and methods are visible outside their module. Mark the declaration `pub` if it is part of the module's API, or use an exported function instead. Some std types are opaque handles with no visible fields; they cannot be built with a struct literal and are created by their constructor function. See core 1.5.", example: "// lib/a.xo\nfn hidden() -> Int { 1 }\n\n// main/main.xo\nuse example.com/app/lib\n\nfn f() -> Int { lib.hidden() }", fix: "// lib/a.xo\npub fn hidden() -> Int { 1 }\n\n// main/main.xo\nuse example.com/app/lib\n\nfn f() -> Int { lib.hidden() }"})
    "XO0606" => Some(Expl{title: "method declared outside the module of its type", severity: "error", summary: "method declared outside the module of its type (core 3.4)", detail: "Methods may be declared only in the module that declares the type, so a type's method set is fixed by its owner and two modules cannot add conflicting methods. For a builtin or imported type, write a plain function instead. See core 3.4.", example: "fn (s: Str) shout() -> Str { s.to_upper() }", fix: "fn shout(s: Str) -> Str { s.to_upper() }"})
    "XO0607" => Some(Expl{title: "`break` or `continue` outside a loop, or an unknown label", severity: "error", summary: "`break` or `continue` outside a loop, or an unknown label (core 3.5)", detail: "`break` and `continue` must be inside a loop of the same function or closure, and a label must name an enclosing labeled loop (`outer: for ... { break outer }`). Inside a closure, `return` leaves the closure; a loop outside it cannot be broken from inside. See core 3.5.", example: "fn f(xs: List[Int]) {\n  for _x in xs {\n    break outr\n  }\n}", fix: "fn f(xs: List[Int]) {\n  outer: for _x in xs {\n    break outer\n  }\n}"})
    "XO0608" => Some(Expl{title: "two C ABI export modules define the same function name", severity: "error", summary: "two C ABI export modules of the native std (std/native/llrt/cabi*.xo) define the same function name, one symbol `xo_x_<name>` (decision 0207)", detail: "Every top level function of std/native/llrt/cabi.xo and the cabi_*.xo modules (except cabi_libc's, which keep their C names) becomes the C ABI symbol `xo_x_<name>`, and all of those modules share that one namespace. Two of them defining a function of the same name would give the program two definitions of one symbol, which the assembler or linker rejects. The checker reports the second definition and notes the first. Only the native std's own modules are export modules, so user code never sees this. Rename one of the two (grep the cabi modules for the name first).", example: "// std/native/llrt/cabi_poll.xo\nfn poll_wait(ep: Int, evs: Int, n: Int, ms: Int) -> Int { 0 }\n\n// std/native/llrt/cabi.xo\nfn poll_wait(c: Int) {}", fix: "// std/native/llrt/cabi_poll.xo\nfn poll_wait(ep: Int, evs: Int, n: Int, ms: Int) -> Int { 0 }\n\n// std/native/llrt/cabi.xo\nfn poll_park_wait(c: Int) {}"})
    "XO0701" => Some(Expl{title: "effect performed outside the declared set", severity: "error", summary: "effect performed outside the declared set (core 6.2)", detail: "`pub` functions, interface methods, function types, and any function with a `uses` clause are checked against their declared effects; no clause means pure. Performing an effect outside that set, directly or through a call chain, a closure, an interface implementation, or a Go call (effect `go`), is an error, and the diagnostic shows the chain that performs it. Contract clauses (`requires`, `ensures`, `invariant`) must be pure. Declare the effect, or pass the work in from a caller that has it. See core 6.2.", example: "pub fn now(c: Clock) -> Time { c.now() }", fix: "pub fn now(c: Clock) -> Time uses clock { c.now() }"})
    "XO0702" => Some(Expl{title: "unknown effect label", severity: "error", summary: "unknown effect label (core 6.1)", detail: "Effect labels are `net` (`net.dial`, `net.listen`), `fs` (`fs.read`, `fs.write`), `clock`, `rand`, `env`, `proc`, `stdio`, `ffi`, and `go` for calls into Go packages, plus effect variables declared as `fx: Effects`. Any other name in a `uses` clause or effect argument is an error, as is an effect argument that is not a label, variable, or parenthesized list of them. See core 6.1.", example: "pub fn g() uses network {}", fix: "pub fn g() uses net {}"})
    "XO0703" => Some(Expl{title: "effect declared in `uses` is never performed", severity: "warning", summary: "warning: effect declared in `uses` is never performed (core 6.2)", detail: "Reported by `xo vet` as a warning, never by `xo check`. Declaring more effects than the body performs is allowed, for example to keep an interface or a `pub` API stable while its implementation changes (core 6.2). Unless that is the intent, the extra effect overstates what the function can do and forces callers to declare it too. Remove it, or keep it deliberately.", example: "pub fn now(c: Clock) -> Time uses clock, net {\n  c.now()\n}", fix: "pub fn now(c: Clock) -> Time uses clock {\n  c.now()\n}"})
    "XO0801" => Some(Expl{title: "child or group task error does not convert to the enclosing error type", severity: "error", summary: "child or group task error does not convert to the enclosing error type (core 7.1)", detail: "If a task fails with an error that no `await` consumes, the scope cancels everything else and the error propagates out of the scope as if by `?`, so it must convert to the enclosing function's error type. The same holds for tasks on a task group. When the group or scope handle came from outside the function, a task started on it must not fail unless its handle is bound and awaited. Bind the handle and handle `t.await`, handle the error inside the task, or declare a compatible error type. See core 7.1.", example: "enum E { Boom }\n\nfn work() -> Int ! E { 1 }\n\nfn f() {\n  scope s {\n    s.spawn(fn() { work() })\n  }\n}", fix: "enum E { Boom }\n\nfn work() -> Int ! E { 1 }\n\nfn f() -> Int {\n  scope s {\n    let t = s.spawn(fn() { work() })\n    t.await.ok() ?? 0\n  }\n}"})
    "XO0802" => Some(Expl{title: "scope handle, or a value containing a task group, escapes its scope", severity: "error", summary: "scope handle, or a value containing a task group, escapes its scope (core 7.1)", detail: "No task outlives its scope. A scope handle, a closure that captures one, or a value whose type contains a `task.Group` from `s.group()` cannot be the scope's value, be returned, or be stored outside the scope (in an outer `var`, a collection, or a channel), because it could start tasks after the scope ended. `os.tasks`, the program lifetime group from `main`, may be stored anywhere. See core 7.1.", example: "fn f() -> Int {\n  let h = scope s { s }\n  1\n}", fix: "fn f() -> Int {\n  scope s {\n    let t = s.spawn(fn() { 1 })\n    t.await\n  }\n}"})
    "XO0803" => Some(Expl{title: "task started without a scope handle", severity: "error", summary: "task started without a scope handle (core 7.1)", detail: "Xo has structured concurrency only: tasks are started with `s.spawn(f)` or `s.spawn_background(f)` on a scope handle inside `scope s { ... }`, or on a task group, so every task belongs to a scope that waits for it. There is no free `spawn` or `go` statement, and `spawn` on a value that is not a scope handle or group is an error. See core 7.1.", example: "fn work() {}\n\nfn f() {\n  spawn(fn() { work() })\n}", fix: "fn work() {}\n\nfn f() {\n  scope s {\n    s.spawn(fn() { work() })\n  }\n}"})
    "XO0804" => Some(Expl{title: "value read in one `Mutex.with` is written back in a later one", severity: "warning", summary: "warning: value read in one `Mutex.with` is written back in a later one (core 5.4)", detail: "Warning. A value read (or derived) inside one `m.with(...)` is used inside a later `m.with(...)` on the same mutex, or a branch on it decides whether the later one runs. Another task may change the state between the two sections (check then act), so the write can overwrite a newer value. Do the read and the write in one `with`. See core 5.4.", example: "struct B { n: Int }\n\nfn bump(m: Mutex[Map[Str, B]]) {\n  let b = m.with(fn(s) { s.get(\"k\") ?? B{n: 0} })\n  m.with(fn(var s) { s.put(\"k\", b with {n: b.n + 1}) })\n}", fix: "struct B { n: Int }\n\nfn bump(m: Mutex[Map[Str, B]]) {\n  m.with(fn(var s) {\n    let b = s.get(\"k\") ?? B{n: 0}\n    s.put(\"k\", b with {n: b.n + 1})\n  })\n}"})
    "XO0900" => Some(Expl{title: "typed hole report", severity: "warning", summary: "typed hole report (core 3.7)", detail: "Warning. `???` is a typed hole, valid anywhere an expression is expected. `xo check` succeeds and reports, for each hole, the expected type, the effects in scope, and in scope values or functions that fit. `xo build` rejects programs with holes; `xo run --holes` and `xo test --holes` allow them and fault if a hole is evaluated. Holes let an agent write a type correct skeleton first and fill it in steps. See core 3.7.", example: "fn retry_after(base: Duration, attempt: Int) -> Duration {\n  ???\n}", fix: "fn retry_after(base: Duration, attempt: Int) -> Duration {\n  base * attempt\n}"})
    "XO0901" => Some(Expl{title: "`dbg(...)` left in code", severity: "warning", summary: "warning: `dbg(...)` left in code (core 11.4)", detail: "Reported by `xo vet` as a warning. `dbg(expr)` prints the expression source and its `Debug` value and returns the value, which is useful while debugging but noise in committed code; `xo build --ci` rejects it. Remove the call and keep the expression, or log through `std/log` if the output is meant to stay. See core 11.4.", example: "fn area(w: Int, h: Int) -> Int {\n  dbg(w * h)\n}", fix: "fn area(w: Int, h: Int) -> Int {\n  w * h\n}"})
    "XO0902" => Some(Expl{title: "`tls.Verify.None` checks no certificate", severity: "warning", summary: "warning: `tls.Verify.None` checks no certificate (std.md 27, decision 0281)", detail: "Reported by `xo vet` as a warning, once per use. A `tls.client` with `verify: tls.Verify.None` encrypts the connection but accepts any certificate, so an active attacker can stand in for the server (libpq's `sslmode=require`). `tls.Verify.ChainOnly` checks the chain against the roots without the host name (`sslmode=verify-ca`), and `roots: tls.roots(pem)` trusts a private CA while keeping the full check.", example: "tls.client(c, host, verify: tls.Verify.None)", fix: "tls.client(c, host, roots: Some(tls.roots(ca_pem)?))"})
    "XO0903" => Some(Expl{title: "an I/O error turned into a default", severity: "warning", summary: "warning: `.ok() ?? d` or `Err(_) => <empty>` on the result of an Fs, Net, or Proc call: every error, transient ones included, becomes the default", detail: "A filesystem, network, or process call can fail for reasons other than a missing file: no file descriptors or memory left, an I/O error, an interrupted read. Turning every error into a default (`os.fs.read_dir(d).ok() ?? []`) makes such a failure look like an empty directory or an empty file, so the program answers from part of its input: a directory walk that drops a subtree, a hash of a partial tree, a file rewritten from empty text. xo itself had these bugs (2026-10-21). Match the result instead, keep the default for the errors it is right for, and return or report the rest. When the default is right for every error (a hint, a cache miss that is rebuilt), say so on the line or the line above: `// xo:allow XO0903 <reason>`; a comment without a reason does not count.", example: "for e in os.fs.read_dir(d).ok() ?? [] { ... }", fix: "match the result: `Ok(es) => es`, `Err(NotFound(_)) => []` for a missing directory, `Err(e) => return Err(e)` for the rest; or `// xo:allow XO0903 <why every error may be the default>`"})
    "XO0904" => Some(Expl{title: "an embedded file is not in git", severity: "warning", summary: "warning: a file an embed constant embeds is ignored or untracked by git (decision 0304)", detail: "An embed constant takes the file's bytes at build time. When git ignores the file or does not track it, a build of a clean checkout (CI, a release, another developer) embeds a different file or none, and the program differs without a source change. `xo vet` asks git about every embedded file of the modules it vets; outside a git work tree, or without git, it says nothing.", example: "const KEY: Bytes = embed(\"secrets/dev.key\")   // secrets/ is in .gitignore", fix: "Add the file to git, or embed only files the repository holds."})
    "XO1001" => Some(Expl{title: "std/sys/<os> used outside the matching target arm", severity: "error", summary: "std/sys/<os> used outside the matching target arm (core 12.2)", detail: "Platform specific APIs live in `std/sys/<os>` and may be referenced only inside the arm of a `match target.os` for that OS, so code for one platform cannot leak into another's build while every arm is still type checked on every host. The prototype does not emit this code yet: no `std/sys/<os>` modules exist, and the example below names a hypothetical `std/sys/linux` function. See core 12.2.", example: "use std/sys/linux\n\npub fn page_size() -> Int {\n  linux.page_size()\n}", fix: "use std/sys/linux\n\npub fn page_size() -> Int {\n  match target.os {\n    Linux => linux.page_size()\n    Darwin => 16384\n    Windows => 4096\n    Wasi => 65536\n  }\n}"})
    "XO1101" => Some(Expl{title: "Go package cannot be bound", severity: "error", summary: "Go package cannot be bound (not found, does not build, main package, or binding error)", detail: "`use go \"path\"` generates a binding for the Go package (into `.xo/gobind/` or `\$XO_GOBIND_DIR`). This failed: the package was not found by Go's module resolution, does not build, is a `main` package, or the binding generator reported an error (the message carries Go's reason). Check the import path and that the module is available to the Go toolchain; `xo bind <path>` runs the binding step alone. See core 4.4 and decision 0041.", example: "use go \"example.invalid/nope\"\n\nfn f() {}", fix: "use go \"strings\"\n\nfn f(s: Str) -> Str { strings.to_upper(s) }"})
    "XO1102" => Some(Expl{title: "Go name exists but its signature does not map to Xo", severity: "error", summary: "Go name exists but its signature does not map to Xo, so the binding skipped it", detail: "The Go package exports this function, method, or type, but its signature uses something the binding cannot express in Xo (for example complex numbers, channels, or unsafe pointers), so the binding skipped it. Skipped names and their reasons are listed at the top of the generated binding. Use another function, or write a small Go wrapper with a mappable signature. A name that does not exist at all is XO0601 instead. See core 4.4.", example: "use go \"strconv\"\n\nfn f() {\n  strconv.parse_complex(\"1\", 128)\n}", fix: "use go \"strconv\"\n\nfn f(s: Str) -> Float ! Error {\n  strconv.parse_float(s, 64)?\n}"})
    "XO1103" => Some(Expl{title: "per module report of `use go` packages and the functions that perform `go`", severity: "note", summary: "note: per module report of `use go` packages and the functions that perform `go` (decision 0041)", detail: "Reported by `xo vet` as a note, once per module. Go code can reach files and the network without a capability, so every call into Go performs the effect `go`, and agents may reach for Go idioms through the boundary out of habit (decision 0041). The note lists the Go packages the module imports and the functions that perform `go`, so the authority escape can be reviewed. See core 4.4.", example: "use go \"strings\"\n\npub fn shout(s: Str) -> Str uses go {\n  strings.to_upper(s)\n}", fix: "// Review each listed use. Prefer Xo std where it covers the need:\npub fn shout(s: Str) -> Str {\n  s.to_upper()\n}"})
    "XO1104" => Some(Expl{title: "C header cannot be bound", severity: "error", summary: "C header cannot be bound (not found, clang cannot read it, a `link` file is missing, or an unknown effect in its `uses`)", detail: "`use c \"header.h\"` reads the header with clang's AST dump and generates an Xo declaration file and a C adapter (into `.xo/cbind/` or `\$XO_CBIND_DIR`). This failed: the header is neither a file relative to the module directory nor on the C include path, clang reported an error in it, a `link` file does not exist, or the line's `uses` names an unknown effect. The message carries the reason. `link \"x.c\"` (or `.a`, `.o`) is a path relative to the module directory; `link \"z\"` (no extension or `/`) links the library -lz. `xo bind --c <header>` runs the binding step alone. See core 4.4 and decision 0116.", example: "use c \"missing.h\" link \"missing.c\"\n\nfn main(os: Os) uses ffi {\n  os.stdio.println(\"hi\")\n}", fix: "use c \"zlib.h\" link \"z\"\n\nfn main(os: Os) uses ffi {\n  os.stdio.println(zlib.zlib_version())\n}"})
    "XO1105" => Some(Expl{title: "C function exists in the header but its signature does not map to Xo", severity: "error", summary: "C function exists in the header but its signature does not map to Xo, so the binding skipped it", detail: "The header declares this function, but a parameter or the result is a type the boundary does not carry (decision 0093): an output pointer, a mutable buffer, a `char *` result whose owner is unknown, a pointer to a struct the header defines, a function pointer, an array, or a variadic list. The binding maps scalars, `const char *` (Str), a const byte pointer followed by an integer length (Str or Bytes), flat structs of scalars (copied), and pointers to structs the header leaves undefined (opaque handles). Skipped names and their reasons are listed at the top of the generated binding. Write a small C wrapper with a mappable signature, declare it in a header of your module, and bind that header. See core 4.4 and decision 0116.", example: "use c \"zlib.h\" link \"z\"\n\nfn f() -> Int32 uses ffi {\n  zlib.deflate_end()\n}", fix: "use c \"zlib.h\" link \"z\"\n\nfn f(data: Bytes) -> UInt64 uses ffi {\n  zlib.crc32(0, data)\n}"})
    "XO1201" => Some(Expl{title: "not available on the native backends", severity: "error", summary: "construct, std API, or effect not available on the native backends (arm64, amd64, LLVM); planned or impossible", detail: "The native backends are the default (arm64 on arm64 hosts, amd64 on x86-64 hosts, and LLVM with `--backend=llvm`; `--no-gc` names them too), and their memory is reference counted instead of collected. Before any code is generated, a check reports every construct, std API, or effect the native backends do not support, at the call site, naming the feature. The message says whether support is planned (the program will build once the native backends grow it; until then build without `--no-gc`) or impossible: code from a `use go` package needs Go's runtime and garbage collector, so it can never run in a native build. The check is derived from what the native code generator supports, so a program it accepts builds. See core 10.1 and decision 0083.", example: "use go \"strings\"\n\nfn main(os: Os) uses go {\n  os.stdio.println(strings.to_upper(\"hi\"))\n}", fix: "fn main(os: Os) {\n  os.stdio.println(\"hi\".to_upper())\n}"})
    "XO1301" => Some(Expl{title: "malformed xo.mod require, xo.lock, or xo.work line", severity: "error", summary: "malformed xo.mod require or deny line, xo.lock, or xo.work line, or a deny rule naming a package that does not exist (core 4.2, 4.3)", detail: "A `require` line of xo.mod is `require <module path> <version>`: the module path is its git location (its first element is a host name) and the version a tag `vX.Y.Z`. A module is required once. xo.mod has no `replace`, `exclude`, or `retract`; local code is reached through an xo.work workspace. xo.lock lines are `<module path> <version>[/xo.mod] h1:<hash>` and are written by `xo get` and `xo mod tidy`. xo.work lines are `xo <edition>` and `use <dir>`, each dir holding an xo.mod. See core 4.2, 4.3, and decision 0086.", example: "// xo.mod\nmodule example.com/api\nrequire github.com/acme/billing 1.4", fix: "// xo.mod\nmodule example.com/api\nrequire github.com/acme/billing v1.4.0"})
    "XO1302" => Some(Expl{title: "module version cannot be fetched", severity: "error", summary: "module version cannot be fetched from git or a module proxy (XO_PROXY): repository, tag, or version missing, or its xo.mod declares another path", detail: "A module path is its location: `github.com/acme/billing` is fetched with git from https://github.com/acme/billing.git (XO_GIT_BASE=<dir or URL> or XO_GIT_REWRITE=<prefix>=<url>,... point it elsewhere, for mirrors and tests), and version v1.4.0 is the tree of the tag `v1.4.0`, extracted with `git archive` (no code runs). A module in a subdirectory of its repository (`github.com/acme/tools/cli` in `cli/`) is that directory's tree at the tag `cli/v1.4.0`. This failed: the repository cannot be reached or cloned, it has no such tag, the tag has no xo.mod in the module's directory, or that xo.mod declares a different module path. The message carries git's reason. With XO_PROXY listing module proxies, the message carries each source's answer: a proxy that does not have the version (404) passes on to the next source after a comma, any error does after a pipe, and `off` forbids fetching. A zip with paths outside the module, or a tree that contradicts the proxy's own .lock answer, also fails here. See core 4.2 and decisions 0086 and 0126.", example: "// xo.mod\nmodule example.com/api\nrequire github.com/acme/billing v1.9.9   // no such tag", fix: "// pick an existing tag (xo get github.com/acme/billing takes the latest)\nmodule example.com/api\nrequire github.com/acme/billing v1.4.0"})
    "XO1303" => Some(Expl{title: "module version not in the cache while offline", severity: "error", summary: "module version is not in the module cache and the build is offline (XO_OFFLINE, --offline)", detail: "With XO_OFFLINE=1 or `--offline`, the toolchain never touches the network: every required module version must already be in the module cache (\$XO_MODCACHE, default <user cache dir>/xo/mod) or in the main module's vendor/. This version is in neither. Fetch it once while online (`xo mod tidy`, `xo get <path>@<version>`, or any build), or commit a vendor/ directory with `xo vendor`. See core 4.2 and decision 0086.", example: "XO_OFFLINE=1 xo build .   # billing v1.4.0 was never fetched", fix: "xo mod tidy               # online, once\nXO_OFFLINE=1 xo build .   # from the cache from now on"})
    "XO1304" => Some(Expl{title: "module content does not match xo.lock", severity: "error", summary: "module tree does not match its xo.lock content hash (core 4.3)", detail: "xo.lock records the content hash of every module version the build uses (and of the xo.mod of every version minimal version selection read); every build recomputes them from the cache or vendor/ and compares. A mismatch means the code changed under the same version: a tag was moved or rewritten upstream, or a cached or vendored copy was edited. Nothing is built. If the new content is expected (you control the dependency and retagged it), delete its lines from xo.lock and run `xo mod tidy`; for an edited vendor/, run `xo vendor`. See core 4.3.", example: "# xo.lock\ngithub.com/acme/billing v1.4.0 h1:AAAA...   # the tag now has other content", fix: "# delete the stale lines, then\nxo mod tidy"})
    "XO1305" => Some(Expl{title: "xo.lock has no hash for a module version", severity: "error", summary: "xo.lock has no hash for a module version the build uses; run `xo mod tidy`", detail: "Every module version the build selects must be recorded in xo.lock, so the content of a build is pinned and checked. A require line was added or changed by hand, or a dependency upgrade raised the version of a module further down the graph. `xo mod tidy` (or `xo get`) records the hashes; commit xo.lock with xo.mod. See core 4.3 and decision 0086.", example: "// xo.mod edited by hand, xo.lock not updated\nrequire github.com/acme/billing v1.5.0", fix: "xo mod tidy   # writes the v1.5.0 hashes to xo.lock"})
    "XO1306" => Some(Expl{title: "import from a module xo.mod does not require", severity: "error", summary: "import of a package from a module that xo.mod does not require", detail: "An import path whose first element is a host name (`github.com/acme/billing/invoice`) names a package of another module, and that module must be required in xo.mod so its version is selected and locked. `xo get <module path>` adds the latest version; `xo mod tidy` adds a requirement for every such import. See core 4.1, 4.2, and decision 0086.", example: "use github.com/acme/billing/invoice   // xo.mod has no require for it\n\nfn total() -> Int { invoice.total() }", fix: "// xo get github.com/acme/billing adds to xo.mod:\nrequire github.com/acme/billing v1.4.0"})
    "XO1307" => Some(Expl{title: "vendor/ does not match xo.mod", severity: "error", summary: "vendor/ does not match xo.mod; run `xo vendor`", detail: "When the main module has vendor/modules.txt, builds use vendor/ only: no module cache, no network. Every requirement of xo.mod must then be vendored at its version (or above, as minimal version selection chose), and vendor/ must be readable. xo.mod changed since the last `xo vendor`; run it again. A vendored tree that was edited is XO1304 instead. See core 4.2 and decision 0086.", example: "// xo.mod now requires v1.5.0, vendor/modules.txt still lists\n# github.com/acme/billing v1.4.0", fix: "xo mod tidy\nxo vendor"})
    "XO1308" => Some(Expl{title: "release build while a workspace overrides modules", severity: "error", summary: "release build (`xo build --release`, or `--ci`) while an xo.work workspace overrides required modules", detail: "An xo.work workspace builds the modules it uses from their local directories, overriding the versions xo.mod requires. That is for development only: a release build (`xo build --release`, and `xo build --ci`) must build exactly what xo.mod and xo.lock pin, so it fails while a workspace overrides a required module, naming those modules. Build with `--workspace=off` (or XO_WORK=off) to ignore xo.work, or release the overridden modules, require their new versions, and run `xo mod tidy`. See decision 0086.", example: "# xo.work: use ./api, use ./billing; api requires billing\nxo build --release ./api", fix: "xo build --release --workspace=off ./api"})
    "XO1309" => Some(Expl{title: "call into a dependency above its effect ceiling", severity: "error", summary: "call into a dependency performs an effect above its ceiling (`require ... uses ...` in xo.mod, `use ... uses ...` in xo.work)", detail: "A `uses` clause after a require's version in xo.mod (`require github.com/acme/billing v1.4.0 uses none`) is the effect ceiling of that dependency: every call from this module into it, and every use of one of its functions as a value, may perform only the effects listed (`uses none`: none; `fs` admits `fs.read`). The effects counted are those the dependency's function declares itself, not the effects of callbacks you pass it. A `use <dir> uses ...` line of xo.work sets a ceiling for calls from the other workspace modules. The error sits on the call, so an upgrade whose new version adds an effect fails where it matters. Review why the dependency now needs the effect; then raise the ceiling, or stay on a version within it. See core 4.2 and decision 0086.", example: "// xo.mod: require github.com/acme/billing v1.5.0 uses none\nfn total(items: List[Item]) -> Int { invoice.total(items) }   // v1.5.0 declares uses net", fix: "// after review, in xo.mod:\nrequire github.com/acme/billing v1.5.0 uses net"})
    "XO1310" => Some(Expl{title: "breaking change in a minor or patch release", severity: "error", summary: "`xo publish`: a minor or patch release removes or changes an export, or adds an effect to one", detail: "`xo publish` compares the exported API and effects of the module (the declarations `xo query api` lists, in every package of the module) with the previous vX.Y.Z tag. A minor or patch release may add exports but must not remove one, change its signature, or add an effect to a function (callers' effect ceilings and `uses` clauses would break). A breaking change needs a new major version, whose module path ends in /vN from v2 on; before v1.0.0 (v0.x.y), a minor bump may break and a patch may not. Each breaking change is listed with the old and new signature. See decision 0086.", example: "# v1.4.0: pub fn total(items: List[Item]) -> Int\n# now:    pub fn total(items: List[Item]) -> Int uses net\nxo publish --check --version v1.5.0", fix: "# keep the old function pure and add a new one, or release a major version:\nxo publish --check --version v2.0.0   # module path .../v2"})
    "XO1311" => Some(Expl{title: "the release cannot be made", severity: "error", summary: "`xo publish`: the release cannot be made (not in a git repository, a subdirectory module path not ending in its directory, uncommitted changes, tag exists, version not above the last, wrong /vN path)", detail: "Publishing a module version is creating its git tag; `xo publish` validates first and prints the tag command, it never pushes. It needs the module in a git repository (at its root, or in a subdirectory whose name ends the module path, tagged `<dir>/vX.Y.Z`), no uncommitted changes (without --check), a version tag that does not exist yet and is above the last release, a major version that matches the module path (/vN from v2 on), and an xo.mod and xo.lock that load. See decision 0086.", example: "xo publish --version v1.4.0   # v1.4.0 is already a tag", fix: "xo publish --version v1.4.1"})
    "XO1312" => Some(Expl{title: "import forbidden by a deny rule", severity: "error", summary: "`use` of a package that a `deny` rule of xo.mod forbids (decision 0095)", detail: "A `deny <package> -> <package>, ...` line of xo.mod is an import direction rule: a package matching the left side may not `use` a package matching any pattern on the right. A pattern is a package path, or a path ending in `/...` that matches it and every package under it. Each direct `use` is checked, whether or not it is used, so a chain of imports is caught at its first forbidden step. The rules of the main module (and of each workspace module) apply to its own packages. There is no machine fix: removing an import is a design change. Move the code the package needs to a package it may import (often an interface or a plain data type in the lower layer), or change the rule if the architecture changed. `xo query imports <pkg>` lists the imports of a package with the `use` line of each. See core 4.2 and decision 0095.", example: "// xo.mod: deny example.com/notes/domain -> example.com/notes/store\n// domain/note.xo:\nuse example.com/notes/store", fix: "// domain declares what it needs; store implements it\n// domain/note.xo:\npub interface NoteStore {\n  fn get(self, id: Int) -> Note ! NotFound\n}"})
    "XO1313" => Some(Expl{title: "fetched module version disagrees with the checksum log", severity: "error", summary: "a fetched module version disagrees with the checksum log (XO_SUMDB), or the log's signature or proofs do not verify (decision 0124)", detail: "With XO_SUMDB naming a checksum log (`<name>+<key id>+<public key> [<URL>]`), the first fetch of every module version (from git or a proxy) is checked against the log before it enters the module cache: the log's record of the version must hold the same tree and xo.mod hashes, the record must be in the tree the log signed (an inclusion proof), the tree head must carry a valid signature by the configured key, and the tree must extend every tree this module cache saw from the log before (a consistency proof). Any failure means someone is serving different content for the same version (a moved tag, a tampered proxy or mirror) or the log itself forked or rewrote history. Nothing is cached or built. Find out which source changed before trusting it. A private module that the log can never see belongs in XO_NOSUMDB. See core 4.3 and decision 0124.", example: "XO_SUMDB=\"sum.example.com+1a2b3c4d+<key>\" xo mod tidy\n# github.com/acme/billing v1.4.0 was retagged after the log recorded it", fix: "# investigate the source; for a private module that never reaches the log:\nXO_NOSUMDB=github.com/acme/private xo mod tidy"})
    "XO1314" => Some(Expl{title: "module fetch settings malformed, or the checksum log unreachable", severity: "error", summary: "the checksum log cannot be consulted, or XO_PROXY, XO_SUMDB, XO_NOPROXY, or XO_NOSUMDB is malformed (decisions 0124, 0126)", detail: "XO_PROXY is a list of proxy URLs (http or https), `direct` (git), and `off`, separated by commas (try the next source only after \"not found\") or pipes (after any error); the default is `direct`. XO_NOPROXY and XO_NOSUMDB are comma separated path patterns (`github.com/acme/*`, `*.corp.example.com`). XO_SUMDB is `off` (the default) or a log's verifier key and optional URL. This code is reported when one of them cannot be parsed, or when the checksum log could not be consulted for a first fetch (unreachable, no record of the version, malformed answers): the version is not cached rather than cached unverified. A log that answers but contradicts the fetched content is XO1313 instead. See decisions 0124 and 0126.", example: "XO_PROXY=ftp://mirror.example.com xo build .", fix: "XO_PROXY=https://mirror.example.com,direct xo build ."})
    "XO1315" => Some(Expl{title: "`edition 2026` is the old name of `edition preview`", severity: "note", summary: "note: `edition 2026` in xo.mod (or `xo 2026` in xo.work) is the old name of `edition preview`; the fix rewrites it (core 13, decision 0155)", detail: "Before 1.0 the only edition is `preview` (decision 0155): nothing is frozen in the 0.x releases, and the compatibility promise of core 13 starts with the first frozen edition, which is named at 1.0. Modules written before the rename say `edition 2026`. That name stays an alias of `preview` during the 0.x releases, so they keep building, and `xo check` reports this note on the `edition` line of xo.mod. The note carries a fix that rewrites the line; `xo fix` (or `xo check --fix`) applies it.", example: "// xo.mod\nmodule example.com/api\nedition 2026", fix: "// xo.mod\nmodule example.com/api\nedition preview"})
    "XO1316" => Some(Expl{title: "a dependency's escape hatch is not vouched for by this module", severity: "error", summary: "`use c` or `use go` of an impure Go package in a required module without the consumer's `vouch` for that version (decision 0156)", detail: "An escape hatch is code whose authority the checker cannot see: a `use c` line (C code) or a `use go` of a Go package that is not pure (anything but strconv, strings, bytes, unicode, unicode/utf8, unicode/utf16, math, math/bits, regexp, regexp/syntax, path, html, net/url, encoding/hex, encoding/base64, encoding/base32). In a module the build gets as a required version, each one needs a `vouch` line in the xo.mod of the consuming module (the main module, or a module of the active workspace): a dependency cannot vouch for itself, so its `use c ... uses none` counts only when you say so. The vouch names the exact version reviewed; an upgrade needs a new review. Without a vouch the `use c` binding performs `ffi` whatever its `uses` says. With one, it performs the vouch's `uses` (or `ffi` without it). There is no machine fix: a vouch is a human review of foreign code. See core 4.2 and decision 0156.", example: "// github.com/acme/zip v1.2.0, a dependency:\nuse c \"zlib.h\" link \"z\" uses none", fix: "// after reviewing the C code, in this module's xo.mod:\nvouch github.com/acme/zip v1.2.0 c \"zlib.h\" uses none"})
    "XO1317" => Some(Expl{title: "a dependency's effects are wider than xo.lock records", severity: "error", summary: "a dependency's effects are wider than its `effects` line in xo.lock (decision 0156)", detail: "xo.lock records, for every required module, the effects its exported API can reach: a line `<module path> effects <labels|none>`, the union of the `uses` of its pub functions and methods. `xo get` and `xo mod tidy` write it the first time a module is locked, and narrow it when a version needs less. When the selected version needs an effect the line does not admit (an update that starts using `net`, `proc`, `log`, ...), every command that loads the program fails with this error, and `xo get` and `xo mod tidy` write nothing. Review why the dependency now needs the effect. To accept it, run `xo mod accept-effects <module path>` (or `xo get --accept-effects <path>@<version>`); the change is an xo.lock diff a reviewer sees. Otherwise stay on the previous version. See core 4.3 and decision 0156.", example: "# xo.lock: github.com/acme/billing effects none\nxo get github.com/acme/billing@v1.5.0   # v1.5.0 declares uses net.dial", fix: "# after review:\nxo mod accept-effects github.com/acme/billing"})
    "XO1318" => Some(Expl{title: "a module's tree cannot be read for the effect, escape hatch, or tidy scan", severity: "error", summary: "a module version's files could not be read while checking its effects against xo.lock or its escape hatches against the main module's vouches (decision 0156)", detail: "The effect audit (XO1317) and the escape hatch audit (XO1316) read every .xo file of each selected module version. When a directory or file of the tree fails to read with an I/O error, what it holds cannot be checked, so the build stops with this error instead of passing on a partial tree. The content hash of a module tree (core 4.3) fails the same way rather than hash a partial tree, which a command recording hashes would write to xo.lock. `xo mod tidy` stops the same way when its scan of the main module's imports cannot read a directory or file, rather than drop the requirements of what it did not see. A directory that does not exist is not an error.", example: "", fix: "Run the command again: a transient error (no file descriptors or memory left) does not recur. If it persists, check the files under the module cache, or empty it with `xo mod clean` so the next build fetches the versions again."})
    "XO1319" => Some(Expl{title: "a third-party `use go` has no `require go` pin", severity: "error", summary: "a `use go` of a package outside Go's standard library needs its Go module pinned in xo.mod", detail: "Without a `require go` line, the binding follows Go's module resolution, which picks the module's latest version, and records it only in the gitignored .xo/gobind: two machines, or one machine on two days, could build different code from the same commit. The fix adds `require go <module> <version>` with the version the binding resolved; `xo mod tidy` adds missing pins too. Go's standard library packages need no line. See core 4.4 and decision 0356.", example: "// xo.mod has no require go line\nuse go \"github.com/google/uuid\" as uuid", fix: "# xo.mod\nrequire go github.com/google/uuid v1.6.0"})
    "XO1401" => Some(Expl{title: "allocation in a real-time function", severity: "error", summary: "allocation in a real-time function (literal, interpolation, `+` on Str or List, closure, growth method)", detail: "A function declared `uses realtime` (core 6.5) may not allocate: list, map, and set literals, string interpolation, `+` and `+=` on Str, List, or Bytes, slicing, closures, storing into a Map, and every prelude method that builds a new collection or Str or grows one (`push`, `put`, `insert`, `sort`, `map`, ...). Allocate during initialization instead (in code that is not real-time), and write preallocated Lists by index: `xs[i] = v` is in place when the List is unique. The message of `fault(...)` is exempt, since a fault ends the real-time section. Native builds also count allocations at run time and fault with XO-F007 when a section allocated (a shared List copied on write). See decision 0133.", example: "fn tick(var st: State, x: Float) uses realtime {\n  st.history.push(x)\n}", fix: "fn tick(var st: State, x: Float) uses realtime {\n  st.history[st.pos] = x\n  st.pos = (st.pos + 1) % st.history.len()\n}"})
    "XO1402" => Some(Expl{title: "loop without a provable bound", severity: "error", summary: "loop without a provable bound in a real-time function, or a `bound N` that is not a constant or is exceeded by a constant range", detail: "Every loop of a real-time function (core 6.5) needs a bound known at compile time: a `for` over a range whose ends are constants is bounded by its length; any other `for` and every `while` needs a `bound N` clause after the iterated value or the condition, N a constant Int. A bound is a contract (core 3.5): when the iteration count is not constant, the loop faults with XO-F006 when it would start iteration N + 1, and `xo test` fuzzes the function. This code is also reported in any function when a bound is not a constant, is negative, or is smaller than a constant range it bounds.", example: "fn sum(xs: List[Int]) -> Int uses realtime {\n  var t = 0\n  for x in xs { t += x }\n  t\n}", fix: "const MAX = 64\n\nfn sum(xs: List[Int]) -> Int uses realtime {\n  var t = 0\n  for x in xs bound MAX { t += x }\n  t\n}"})
    "XO1403" => Some(Expl{title: "call of a function not known to be real-time", severity: "error", summary: "call in a real-time function of a function that is not real-time, a function value, or an interface method", detail: "A real-time function (core 6.5) may call only other real-time functions (declared `uses realtime`), the bounded prelude methods (scalar arithmetic, `len`, `get`, `contains`, `List.set`, Atomic operations), and C functions of a `use c` module. A call of a function value or of an interface method (a capability, or a method of a type parameter's constraint) is rejected: its callee is not known, so neither its allocation nor its recursion can be checked. Mark the helper `uses realtime` when it follows the rules, or move the call out of the real-time function.", example: "fn scale(x: Float) -> Float { x * 0.5 }\n\nfn tick(x: Float) -> Float uses realtime {\n  scale(x)\n}", fix: "fn scale(x: Float) -> Float uses realtime { x * 0.5 }\n\nfn tick(x: Float) -> Float uses realtime {\n  scale(x)\n}"})
    "XO1404" => Some(Expl{title: "recursion among real-time functions", severity: "error", summary: "recursion among real-time functions", detail: "The call graph of real-time functions (core 6.5) must be acyclic, so that their stack depth is bounded. A function that calls itself, directly or through other real-time functions, is reported at the call that closes the cycle. Since real-time functions cannot call function values or interface methods, recursion through them is ruled out too. Rewrite the recursion as a loop with `bound N` and an explicit stack in a preallocated List.", example: "fn depth(n: Int) -> Int uses realtime {\n  if n == 0 { 0 } else { 1 + depth(n - 1) }\n}", fix: "fn depth(n: Int) -> Int uses realtime {\n  var d = 0\n  var i = n\n  while i > 0 bound 1000 {\n    d += 1\n    i -= 1\n  }\n  d\n}"})
    "XO1405" => Some(Expl{title: "blocking operation in a real-time function", severity: "error", summary: "blocking operation (channel, Mutex, scope, select, task) or capability effect in a real-time function", detail: "A real-time function (core 6.5) may not wait for other tasks or the operating system: channel operations, `for` over a channel, `Mutex.with` and `with_read`, `scope`, `select`, spawning and awaiting tasks, `dbg`, and capability calls are rejected. It may declare no effect besides `ffi`. Atomic operations do not block and are allowed: share state with the rest of the program through Atomic values, or pass the data in and out as arguments.", example: "fn tick(c: Chan[Float], x: Float) uses realtime {\n  c.send(x)\n}", fix: "fn tick(level: Atomic[Int], x: Float) uses realtime {\n  level.set(Int(x * 1000.0))\n}"})
    "XO1501" => Some(Expl{title: "--stamp names no stampable constant", severity: "error", summary: "`--stamp NAME=VALUE` names no `const NAME: Str = \"...\"` (a plain string literal) of the main module", detail: "`xo build --stamp NAME=VALUE` (also `xo run`) replaces the value of the constant `NAME` of the main module for that build, so a program reports a version, commit, or build date set by the build script. The constant must exist in a module named on the command line and be declared `const NAME: Str = \"...\"` with a plain string literal (no interpolation, no expression): the literal is what the build replaces. Other constants may be built from it.", example: "// xo build --stamp VERSION=1.4.0\nconst VERSION = 14", fix: "// xo build --stamp VERSION=1.4.0\nconst VERSION: Str = \"dev\""})
    "XO1502" => Some(Expl{title: "the installed Go is older than the Go backend supports", severity: "error", summary: "the go command the Go backend runs is older than the oldest Go Xo supports (decision 0176)", detail: "The Go backend (the default for `xo build`, `xo run`, and `xo test`) writes Go source and compiles it with the go command: `\$XO_GO`, else `go` on PATH. Generated programs and the runtime use standard library APIs of Go 1.24 (`crypto/pbkdf2`, `maphash.Comparable`, `http.Protocols`), so an older go command cannot build them. The build reads `go env GOVERSION` once per process and stops before generating code. Xo writes the installed Go's language version into the build's go.mod (at most the newest Go the suite has passed on), so it never asks the go command to download another Go. See decision 0176.", example: "\$ go version\ngo version go1.22.5 darwin/arm64\n\$ xo build .\nXO1502: the Go backend needs Go 1.24 or newer, but /usr/local/go/bin/go is go1.22.5", fix: "# install Go 1.24 or newer from https://go.dev/dl, or point Xo at one:\nXO_GO=\$HOME/sdk/go1.26.1/bin/go xo build .\n# or use a native backend, which does not run Go:\nxo build --backend=arm64 ."})
    "XO1503" => Some(Expl{title: "the Go backend finds no go command", severity: "error", summary: "the Go backend finds no go command (\$XO_GO, else go on PATH; decision 0176)", detail: "The Go backend (the default for `xo build`, `xo run`, and `xo test`) writes Go source and compiles it with the go command: `\$XO_GO`, else `go` on PATH. When `\$XO_GO` is not an executable file, or PATH has no go, the build stops before generating code with this diagnostic instead of failing inside the go build. The native backends (arm64, LLVM) do not run Go and build without it. See decision 0176.", example: "\$ xo run .\nXO1503: the Go backend runs the go command, but there is no go on PATH; install Go 1.24 or newer (https://go.dev/dl), set XO_GO to its go command, or build with --backend=arm64 or llvm, which need no Go", fix: "# install Go 1.24 or newer from https://go.dev/dl, or point Xo at one:\nXO_GO=\$HOME/sdk/go1.26.1/bin/go xo run .\n# or use a native backend, which does not run Go:\nxo run --backend=arm64 ."})
    "XO1504" => Some(Expl{title: "a std API the native runtime does not support on this target yet", severity: "error", summary: "std API the native runtime does not support on this target yet (Windows: decision 0197)", detail: "No build reports it today. It stopped a native build whose program used a std API the native runtime did not support on the target yet; the last ones were processes on Windows, ported on 2026-10-12 (decision 0197 stage 2), and Windows builds now default to Xo's own amd64 backend (decisions 0254, 0270). The code keeps its meaning in case a port is ever partial again; the message would name the parts, and the Go backend (`--backend=go`) would build the program.", example: "> xo build --backend=llvm .\nXO1504: the LLVM backend does not support processes (Proc) on windows yet (decision 0197); build with the Go backend (the default) instead", fix: "# build with the Go backend, which supports every std API on Windows:\nxo build ."})
    "XO1505" => Some(Expl{title: "the LLVM backend's clang is older than 16", severity: "error", summary: "the LLVM backend's clang is an LLVM clang older than 16", detail: "The LLVM backend (`--backend=llvm`) compiles its IR with clang: `\$XO_CLANG`, else `clang` on PATH, or `--cc`. The generated code reads thread locals through llvm.threadlocal.address, which LLVM 16 added: an older clang leaves it an undefined function and the link fails (`undefined reference to llvm.threadlocal.address.p0`). The build reads `clang --version` and stops before generating code. Apple's clang numbers its versions apart from LLVM's and is not checked. The native backends, the default, do not use clang.", example: "\$ clang --version\nclang version 15.0.7\n\$ xo build --backend=llvm .\nXO1505: the LLVM backend needs clang 16 or later, but /usr/bin/clang is clang 15", fix: "# install clang 16 or newer and point Xo at it:\nXO_CLANG=/usr/lib/llvm-19/bin/clang xo build --backend=llvm .\n# or use the native backend, which does not run clang:\nxo build ."})
    "XO1506" => Some(Expl{title: "an embed names no file, too many, or too much", severity: "error", summary: "`embed(\"...\")` names no file, more than one for a `Str` or `Bytes` constant, a file that cannot be read, or more bytes than an embed may hold (decision 0304)", detail: "An embed constant's path is relative to the directory of the file that declares it. A `Str` or `Bytes` constant embeds exactly one file; an `embed.Dir` constant embeds every file a path or glob names (a directory brings its files, except names starting with `.` or `_` unless the pattern starts with `all:`). One embed may hold up to 64 MiB and a program's embeds 256 MiB together.", example: "const PAGE: Str = embed(\"static/*.html\")", fix: "Name one file, or declare the constant `embed.Dir` to embed several."})
    "XO1507" => Some(Expl{title: "an embed path leaves the module", severity: "error", summary: "an `embed` path is absolute, has a `..`, `.` or empty segment, or is a symbolic link (decision 0304)", detail: "Embedded files must come from the module itself, so a build on another machine embeds the same bytes: paths are relative to the declaring file's directory, stay inside it, and name no symbolic link.", example: "const KEY: Bytes = embed(\"../secrets/key.pem\")", fix: "Move the file into the module, next to or below the declaring file."})
    "XO1508" => Some(Expl{title: "an embedded Str is not UTF-8", severity: "error", summary: "a `Str` embed constant's file is not valid UTF-8 (decision 0304)", detail: "A `Str` holds UTF-8 text. A file with other bytes (an image, a compressed file, text in another encoding) embeds as `Bytes`.", example: "const LOGO: Str = embed(\"logo.png\")", fix: "Declare the constant `Bytes`: `const LOGO: Bytes = embed(\"logo.png\")`."})
    "XO1509" => Some(Expl{title: "embed used outside a typed constant", severity: "error", summary: "`embed` is used other than as the initializer of a constant typed `Str`, `Bytes`, or `embed.Dir`, with one plain string literal (decision 0304)", detail: "Files are embedded at build time, so `embed` is only a constant's whole initializer, the constant declares its type (`Str`, `Bytes`, or `embed.Dir`), and the path is one string literal without interpolation. A module that declares its own `embed` uses it instead.", example: "const PAGE = embed(\"index.html\")", fix: "Declare the type: `const PAGE: Str = embed(\"index.html\")`."})
    "XO1510" => Some(Expl{title: "a function disagrees with this build's definitions", severity: "error", summary: "a function the native backends are about to generate calls a function, makes a closure, or reads a field with types this build defines otherwise (decision 0342)", detail: "Before code generation the native backends check every call, closure, and field or payload access against this build's definitions. A mismatch means a piece of the build came from a cache built under other definitions (a front end body that names a helper by a name this build gives another helper, gotchas/helper-name-creation-order.md): emitting the call would produce a binary that faults. The build stops instead. It is a compiler bug, not an error in the program.", example: "# XO1510: http.fields_in: b27: v117: Str? = call xo.maph.logget[Map[Str, Str]] ...: result type does not match the callee", fix: "# rebuild without the backend cache and report the message\nXO_BACKEND_CACHE=off xo build ."})
    "XO1511" => Some(Expl{title: "an embed.Dir has no file at this literal path", severity: "warning", summary: "`read`, `read_text`, or `contains` on an `embed.Dir` constant (or a literal `.sub` of one) with a literal path it does not hold (decision 0304)", detail: "An `embed.Dir`'s keys are the files' paths relative to the directory of the file that declares the constant, so `const SITE: embed.Dir = embed(\"static\")` holds `static/index.html`, not `index.html`, and `SITE.read(\"index.html\")` gives None: a server that serves the result shows a blank page. When one key ends with the path, the warning offers it as a fix and notes that `SITE.sub(\"static\")` drops the prefix. A path computed at run time is not checked, and the call is not an error because its result is an Option.", example: "const SITE: embed.Dir = embed(\"static\")\n\nfn page() -> Bytes { SITE.read(\"index.html\") ?? b\"\" }", fix: "const SITE: embed.Dir = embed(\"static\")\n\nfn page() -> Bytes { SITE.read(\"static/index.html\") ?? b\"\" }"})
    "XO1512" => Some(Expl{title: "a run cache entry differs from a rebuild", severity: "error", summary: "under `XO_BACKEND_CACHE=verify`, a build, run, or test the run cache would have served differs from its rebuild, in the binary or in what the build printed (decision 0360)", detail: "`xo build`, `xo run` (XO_WHOLE_BUILD) and `xo test` reuse an unchanged program's binary from the run cache: the entry lists every file the build read, every path it looked for, and every environment variable it read, and is used only when all still match. `XO_BACKEND_CACHE=verify` builds anyway and compares the result with the entry. A difference means the entry missed an input, or the build is not reproducible; either is a bug in xo. The entry is replaced by the rebuild.", example: "# XO_BACKEND_CACHE=verify xo build .\nerror XO1512: the run cache's entry for this build differs from a rebuild in the binary", fix: "# report it with the program; meanwhile build without the run cache\nXO_BIN_CACHE=off xo build ."})
    _ => None
  }
}
