// Finding a binary's build information (decision 0354 stage 2): the JSON
// object `{"id":"<24 hex>","dir":...}` the Go backend passes to
// rt.SetBuildInfo and a native binary carries as xo_buildinfo, found by
// its prefix (xo replay, xo version -m).

/// The length of a build ID (hex of SHA-256, [:24]).
const BUILD_ID_LEN = 24

/// The text of the first build information object in data whose "dir"
/// is dir (any dir when dir is ""), or "".
pub fn find_build_info(data: Bytes, dir: Str) -> Str {
  let prefix = "{\"id\":\"".bytes()
  let tail = "\",\"dir\":".bytes()
  var i = 0
  let n = data.len()
  while i + prefix.len() + BUILD_ID_LEN + tail.len() < n {
    if data[i] != '{' || data[i + 1] != '"' {
      i += 1
      continue
    }
    var ok = true
    for k in 0..prefix.len() {
      ok = ok && data[i + k] == prefix[k]
    }
    let t = i + prefix.len() + BUILD_ID_LEN
    for k in 0..tail.len() {
      ok = ok && data[t + k] == tail[k]
    }
    if ok {
      // the object ends at the first `}` that closes it
      var depth = 0
      var j = i
      var in_str = false
      var esc = false
      while j < n {
        let c = data[j]
        if in_str {
          if esc {
            esc = false
          } else if c == '\\' {
            esc = true
          } else if c == '"' {
            in_str = false
          }
        } else if c == '"' {
          in_str = true
        } else if c == '{' {
          depth += 1
        } else if c == '}' {
          depth -= 1
          if depth == 0 {
            break
          }
        }
        j += 1
      }
      if j < n {
        let text = data[i..j + 1].to_str() ?? ""
        if dir.is_empty() {
          return text
        }
        // "dir" follows the ID, as the build writes it (json_str, which
        // escapes as jstr_html)
        if text.starts_with("{\"id\":\"${text[7..7 + BUILD_ID_LEN]}\",\"dir\":${jstr_html(dir)}") {
          return text
        }
      }
    }
    i += 1
  }
  ""
}
