// `xo parse` and `xo check` (cmd/xo main.go runParse, runCheckWith).

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser
use github.com/xo-lang/xo/compiler/cli/modules
use github.com/xo-lang/xo/compiler/ssa

// ---------------------------------------------------------------------------
// parse

fn run_parse(os: Os, ctx: Ctx, args: List[Str]) -> Int {
  var fl = new_flags("parse")
  fl.bool_flag("json", "print diagnostics (and the AST with --ast) as JSON")
  fl.bool_flag("ast", "dump the syntax tree as JSON")
  fl.bool_flag("sig", "allow function declarations without bodies")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.is_empty() {
    os.stdio.eprintln("xo parse: no files or directories given")
    return 2
  }
  let files = match collect(os, ctx, fl.args) {
    Ok(fs) => fs
    Err(e) => {
      os.stdio.eprintln("xo parse: ${e}")
      return 2
    }
  }
  let as_json = fl.get_bool("json")
  let with_ast = fl.get_bool("ast")
  let sig = fl.get_bool("sig")
  var all: List[Diag] = []
  var results: List[Str] = []
  for path in files {
    let src = match os.fs.read(path) {
      Ok(b) => b
      Err(e) => {
        os.stdio.eprintln("xo parse: ${fs_err(e)}")
        return 2
      }
    }
    let r = parser.parse_file(path.bytes(), src, sig)
    all = all + check.parse_diags(path, r.diags)
    var fields = [("path", jstr(path))]
    if with_ast {
      fields.push(("ast", ast_json(r.file)))
    }
    results.push(jobj(fields))
  }
  var has_err = false
  for d in all {
    has_err = has_err || is_error(d)
  }
  if as_json {
    let files_json = if results.is_empty() { "null" } else { jarr(results) }
    os.stdio.print(indent_json(jobj([("files", files_json), ("diagnostics", diags_json(all))])))
  } else {
    if with_ast {
      let files_json = if results.is_empty() { "null" } else { jarr(results) }
      os.stdio.print(indent_json(files_json))
    }
    var b = StrBuilder.new()
    for d in all {
      b.write(human(d))
      b.write("\n")
    }
    b.write("${files.len()} file(s), ${all.len()} error(s)\n")
    os.stdio.eprint(b.freeze())
  }
  if has_err { 1 } else { 0 }
}

/// The .xo files of paths: a file as named, a directory's own .xo files,
/// and for a directory named as DIR/... (in ctx.walk, decision 0345) its
/// .xo files at any depth (check.walk_skips directories skipped), all
/// sorted (cmd/xo collect, collectFmt).
pub fn collect(os: Os, ctx: Ctx, paths: List[Str]) -> List[Str] ! Str uses fs.read {
  var out: List[Str] = []
  for p in paths {
    let info = match os.fs.stat(p) {
      Ok(Some(i)) => i
      Ok(None) => return Err("stat ${p}: no such file or directory")
      Err(e) => return Err(stat_err(p, e))
    }
    if !info.is_dir {
      out.push(p)
      continue
    }
    if !ctx.walk.contains(abs_path(ctx, p)) {
      for f in own_xo(os, p)? {
        out.push(f)
      }
      continue
    }
    var n = WalkCount{}
    walk_xo(os, p, true, out, n)?
  }
  Ok(out.sort())
}

/// The entries and .xo files a DIR/... walk has looked at (the bound of
/// decision 0345).
struct WalkCount {
  seen: Int = 0
  xo: Int = 0
}

/// The .xo files directly in dir.
fn own_xo(os: Os, dir: Str) -> List[Str] ! Str uses fs.read {
  let entries = match os.fs.read_dir(dir) {
    Ok(es) => es
    Err(e) => return Err(stat_err(dir, e))
  }
  var out: List[Str] = []
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") {
      out.push(join_path(dir, e.name))
    }
  }
  Ok(out)
}

/// The error of a DIR/... walk from top over the bound.
fn walk_limit(top: Str) -> Str {
  check.walk_limit_error(if top == "/" { "/..." } else { "${top.trim_suffix("/")}/..." })
}

/// Appends the .xo files under dir in the order filepath.WalkDir visits
/// them, with paths joined as it joins them.
fn walk_xo(os: Os, dir: Str, top: Bool, var out: List[Str], var n: WalkCount) -> () ! Str {
  let entries = match os.fs.read_dir(dir) {
    Ok(es) => es
    Err(e) => return Err(stat_err(dir, e))
  }
  n.seen += entries.len()
  if n.seen > check.MAX_WALK_ENTRIES {
    return Err(walk_limit(dir))
  }
  for e in entries {
    let p = join_path(dir, e.name)
    if e.is_dir {
      if check.walk_skips(e.name) {
        continue
      }
      walk_xo(os, p, false, out, n)?
    } else if p.ends_with(".xo") {
      out.push(p)
      n.xo += 1
      if n.xo > check.MAX_WALK_XO {
        return Err(walk_limit(dir))
      }
    }
  }
  Ok(())
}

fn stat_err(p: Str, e: FsErr) -> Str {
  match e {
    NotFound(_) => "stat ${p}: no such file or directory"
    Denied(_) => "stat ${p}: permission denied"
    _ => fs_err(e)
  }
}

// ---------------------------------------------------------------------------
// check

/// What a check run of some directories found (query.Session).
pub struct Session {
  pub c: check.Checker
  /// The root modules' paths, in order.
  pub mods: List[Str]
  /// The diagnostics, sorted (diag.Sort).
  pub diags: List[Diag]
  /// Whether ctx.member_support ran on each member (load_each).
  pub supported: Bool = false
}

/// Checks dirs and, unless exact, the other modules of their workspace
/// (query.Load, LoadExact). The error is what cmd/xo prints after
/// "xo <command>: ".
pub fn load(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes]) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  load_with(os, ctx, dirs, exact, overlay, [])
}

/// load with the std and runtime modules of preload (`std/tls`,
/// `native/llrt/pool`) loaded too, imported or not (decision 0289).
pub fn load_with(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes], preload: List[Str]) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  load_mode(os, ctx, dirs, exact, overlay, preload, false)
}

/// load_with under the native backends' checker rules when native (as
/// `xo check` checks by default, owner 2026-10-23: `use c` is valid), else
/// the Go backend's.
fn load_mode(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes], preload: List[Str], native: Bool) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  load_mode_cached(os, ctx, dirs, exact, overlay, preload, native, false)
}

/// load_mode, with cached the module check cache of `xo check` (decision
/// 0351 addendum, 2026-10-23): a program module unchanged since its last
/// check, with the modules it imports, is not checked again; its
/// diagnostics, warnings included, come from its entry, so the output is
/// a full check's. The entries are `xo check`'s own (their flags say so):
/// a build's entries also record what its front end cache replays.
fn load_mode_cached(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes], preload: List[Str], native: Bool, cached: Bool) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  load_walked(os, ctx, dirs, exact, overlay, preload, native, cached, [])
}

/// load_mode_cached with the directories of walk walked (DIR/...): a
/// module root left out for its module path is checked as the walk found
/// it, its packages below it.
fn load_walked(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes], preload: List[Str], native: Bool, cached: Bool, walk: List[Str]) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  var c = new_checker(os, ctx)
  for w in walk {
    c.walk.push(abs_path(ctx, w))
  }
  c.native = native
  // two modules with one module path under the directories: one is
  // checked here and each other on its own below (lead, 2026-10-26: a
  // check read only the first's files, so an error in the second passed)
  c.split_same_path = true
  let chk = cached && native && overlay.is_empty() && !ctx.chk_dir.is_empty()
  if chk {
    c.mod_cache_dir = ctx.chk_dir
    c.mod_flags = "xo check\n${ctx.chk_id}\nstd=${ctx.std}"
    c.mod_skip_on = true
    // the runtime's bodies as a build checks them (decision 0247): when
    // the SSA builder needs them, so never in a plain check; not when a
    // named directory is in std (checking std itself checks them all)
    let std_abs = abs_path(ctx, ctx.std)
    c.lazy = (os.env.get("XO_CHECK_EAGER") ?? "") != "1" && !dirs.any(fn(d) { let a = abs_path(ctx, d); a == std_abs || a.starts_with("${std_abs}/") })
  }
  c.overlay = overlay
  c.preload = preload
  let all = if exact { dirs } else { c.check_workspace_dirs(dirs) }
  let walked = dirs.any(fn(d) { c.walk.contains(abs_path(ctx, d)) })
  if ctx.per_module && !walked && all.len() - dirs.len() >= PER_MODULE_MIN {
    // decision 0513: each workspace module on its own, from a copy of a
    // shared base, so the peak is the largest module's closure
    return load_each(os, ctx, [all[0]], all[1..], false, overlay, preload, native, cached)
  }
  if ctx.per_module && dirs.len() == 1 && walked {
    // a walk of a workspace (decision 0513): the packages outside its
    // members are the base, each member is walked on its own
    if let Some((base_dirs, members)) = walk_split(os, ctx, c, dirs[0]) {
      if members.len() >= PER_MODULE_MIN {
        return load_each(os, ctx, base_dirs, members, true, overlay, preload, native, cached)
      }
    }
  }
  // the workspace's other modules: walked when a named directory is
  // (DIR/...), left out when they hold no .xo file of their own
  c.named_dirs = dirs.len()
  if dirs.any(fn(d) { c.walk.contains(abs_path(ctx, d)) }) {
    for d in all[dirs.len()..] {
      c.walk.push(abs_path(ctx, d))
    }
  }
  c.check_dirs_fetching(os, all, fn(p: Str, v: Str) -> Str ! check.Problem { modules.fetch(os, ctx.wd, p, v) })?
  if !c.unsupported.is_empty() {
    return Err("not supported by the self hosted checker: ${c.unsupported}")
  }
  var mods: List[Str] = []
  for m in c.root_mods {
    mods.push(c.mods[m].path)
  }
  if chk && !c.mod_skip.is_empty() && !c.effect_reads_across_modules().is_empty() {
    // a checked body reads a skipped module's inferred effects: check
    // everything (gotchas/module-check-cache-skips-whole-program-passes.md)
    return load_walked(os, ctx, dirs, exact, overlay, preload, native, false, walk)
  }
  if chk {
    store_check_entries(os, c)
  }
  var all_diags = c.diags
  // each module left out for its module path, checked on its own: its
  // diagnostics and its root modules join this check's
  for (root, _, _) in c.same_path {
    let sub = load_walked(os, ctx, [root], true, overlay, preload, native, cached, [root])?
    all_diags = all_diags + sub.diags
    for m in sub.mods {
      mods.push(m)
    }
  }
  let ds = sort_diags(all_diags)
  Ok(Session{c: c, mods: mods, diags: ds})
}

/// The workspace members from which a whole-workspace `xo check` holds
/// one at a time (decision 0513): below it one checker is as fast (aws
/// core + 10 services: 1.13 s at 1,198 MB against 1.30 s at 968 MB).
pub const PER_MODULE_MIN = 8

/// load_walked of each of dirs alone (exact), one checker at a time, its
/// diagnostics merged without repeats (a module two of them import
/// reports once); the session's checker is the last one's.
fn load_each(os: Os, ctx: Ctx, base_dirs: List[Str], members: List[Str], walk_members: Bool, overlay: Map[Str, Bytes], preload: List[Str], native: Bool, cached: Bool) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  var mods: List[Str] = []
  var diags: List[Diag] = []
  var seen: Set[Str] = #{}
  var last: Session? = None
  // the first directory's checker is the base the others start from (a
  // copy; run skips its modules)
  let extra0 = shared_imports(os, ctx, base_dirs[0], members)
  // a walk's base keeps only the directories two members import; its
  // other directories are checked on their own, as members are, but not
  // walked (each is a directory of the walk already)
  var core = base_dirs
  var plain: List[Str] = []
  if walk_members {
    core = []
    for bd in base_dirs {
      if extra0.any(fn(x) { abs_path(ctx, x) == abs_path(ctx, bd) }) {
        core.push(bd)
      } else {
        plain.push(bd)
      }
    }
    if core.is_empty() {
      core = [plain[0]]
      plain = plain[1..]
    }
  }
  // each entry: its directory and whether it is walked
  var dirs: List[(Str, Bool)] = [("", false)]
  for d in plain {
    dirs.push((d, false))
  }
  for d in members {
    dirs.push((d, walk_members))
  }
  var base: check.Checker? = None
  for (di, (d, walks)) in dirs.indexed() {
    // a workspace module with no .xo file of its own is left out, as one
    // checker leaves it (only the named directories must hold sources)
    let has_xo = if di == 0 { true } else { match os.fs.read_dir(d) {
      Ok(es) => es.any(fn(e) { !e.is_dir && e.name.ends_with(".xo") })
      Err(_) => false
    } }
    if di > 0 && !has_xo && !walks {
      continue
    }
    var sub = Session{c: new_checker(os, ctx), mods: [], diags: []}
    match base {
      Some(b) => {
        var c = b
        c.start_member_with(ctx.member_support.is_some())
        if walks {
          c.walk = [abs_path(ctx, d)]
        }
        c.check_dirs([d])?
        var ms: List[Str] = []
        for m in c.root_mods {
          ms.push(c.mods[m].path)
        }
        sub = Session{c: c, mods: ms, diags: c.diags}
      }
      None => {
        var extra: List[Str] = []
        for x in extra0 {
          if !base_dirs.any(fn(bd) { abs_path(ctx, bd) == abs_path(ctx, x) }) {
            extra.push(x)
          }
        }
        // the base's directories are checked as named, never walked
        var bctx = ctx
        bctx.walk = []
        bctx.per_module = false
        sub = load_walked(os, bctx, core + extra, true, overlay, preload, native, cached, [])?
        base = Some(sub.c)
        if !extra.is_empty() {
          // the shared packages are checked as imports are: only d's
          // module is named
          var ms: List[Str] = []
          for m in sub.c.root_mods {
            if core.any(fn(bd) { abs_path(ctx, bd) == abs_path(ctx, sub.c.mods[m].dir) }) {
              ms.push(sub.c.mods[m].path)
            }
          }
          sub = Session{c: sub.c, mods: ms, diags: sub.diags}
        }
      }
    }
    if let Some(sup) = ctx.member_support {
      // the member's support check on its own checker (decision 0523),
      // when its check found no error: the named directories' (the base)
      // and the walked members', every member's with --support-all (a
      // whole workspace's took aws's check from 21 s to 205 s)
      if (di == 0 || walks || ctx.support_all) && !sub.diags.any(fn(x) { !x.warning }) {
        sub.c.lib_roots = true
        sub.diags = sub.diags + sup(sub.c)
      }
    }
    for m in sub.mods {
      if !mods.contains(m) {
        mods.push(m)
      }
    }
    for x in sub.diags {
      let k = human(x)
      if !seen.contains(k) {
        seen.add(k)
        diags.push(x)
      }
    }
    last = Some(sub)
  }
  match last {
    Some(s) => Ok(Session{c: s.c, mods: mods, diags: sort_diags(diags), supported: ctx.member_support.is_some()})
    None => Err("no directory to check")
  }
}

/// walk_split for `xo test ROOT/...` (decision 0515 point 5): the walk's
/// directories outside the workspace's members and the members' own.
pub fn test_split(os: Os, ctx: Ctx, root: Str) -> (List[Str], List[Str])? uses fs.read, env {
  var c = new_checker(os, ctx)
  c.walk = [abs_path(ctx, root)]
  walk_split(os, ctx, c, root)
}

/// The walk of root split for decision 0513: the walked directories
/// outside every workspace member below root (the base), and those
/// members' directories (each walked on its own); None when root has no
/// workspace with two members below it.
fn walk_split(os: Os, ctx: Ctx, c: check.Checker, root: Str) -> (List[Str], List[Str])? uses fs.read, env {
  let probe = new_checker(os, ctx)
  let (w0, _) = probe.find_work(abs_path(ctx, root))
  let w = w0?
  let ra = abs_path(ctx, root)
  var members: List[Str] = []
  for m in w.modules {
    let md = abs_path(ctx, m.dir)
    if md != ra && md.starts_with("${ra}/") {
      members.push(md)
    }
  }
  if members.len() < 2 {
    return None
  }
  var walker = c
  let found = walker.walked_dirs(root).ok()?
  var base: List[Str] = []
  for d in found {
    let a = abs_path(ctx, d)
    if !members.any(fn(md) { a == md || a.starts_with("${md}/") }) {
      base.push(d)
    }
  }
  if base.is_empty() {
    return None
  }
  var rel: List[Str] = []
  for md in members.sort() {
    rel.push(c.rel_dir(md))
  }
  Some((base, rel))
}

/// The directories of the packages two or more of dirs[1..] import that
/// are in none of them (decision 0513's base: the workspace's shared
/// core), from their files' `use` lines and the workspace's modules.
fn shared_imports(os: Os, ctx: Ctx, root: Str, member_dirs: List[Str]) -> List[Str] uses fs.read, env {
  if member_dirs.len() < 2 {
    return []
  }
  let probe = new_checker(os, ctx)
  let (w0, _) = probe.find_work(abs_path(ctx, root))
  let w = match w0 {
    Some(x) => x
    None => return []
  }
  var members: Set[Str] = #{}
  for d in member_dirs {
    members.add(abs_path(ctx, d))
  }
  var count: Map[Str, Int] = {}
  for d in member_dirs {
    var seen: Set[Str] = #{}
    for e in os.fs.read_dir(d).ok() ?? [] {
      if e.is_dir || !e.name.ends_with(".xo") || e.name.ends_with("_test.xo") {
        continue
      }
      let text = os.fs.read_text(join_path(d, e.name)).ok() ?? ""
      for l in text.split("\n") {
        let t = l.trim()
        if !t.starts_with("use ") {
          continue
        }
        let p = t[4..].trim().split(" ")[0]
        // the workspace module holding p, longest path first
        var best = -1
        for (i, m) in w.modules.indexed() {
          if (p == m.path || p.starts_with("${m.path}/")) && (best < 0 || m.path.len() > w.modules[best].path.len()) {
            best = i
          }
        }
        if best < 0 || members.contains(abs_path(ctx, w.modules[best].dir)) {
          continue
        }
        let dir = join_path(w.modules[best].dir, p[w.modules[best].path.len()..].trim_prefix("/"))
        if !seen.contains(dir) {
          seen.add(dir)
          count[dir] = (count.get(dir) ?? 0) + 1
        }
      }
    }
  }
  var out: List[Str] = []
  for (dir, n) in count.entries() {
    if n >= 2 {
      out.push(dir)
    }
  }
  out.sort()
}

/// Stores the module check cache entries of the modules c checked in
/// full without an error (Checker.mod_cache_entries), each written to a
/// temporary file and renamed into place.
fn store_check_entries(os: Os, c: check.Checker) uses fs, rand {
  var scans: Map[Int, (Bool, Bool)] = {}
  for m in c.order {
    // the SSA builder's scans: no build reads `xo check`'s entries
    scans[m] = (false, false)
  }
  for (k, e) in c.mod_cache_entries(scans, {}, {}) {
    let path = "${c.mod_cache_dir}/chk/${k[0..2]}/${k}"
    match os.fs.create_dir_all("${c.mod_cache_dir}/chk/${k[0..2]}") {
      Ok(_) => {}
      // xo:allow XO0903 a cache it cannot write is only slower
      Err(_) => return
    }
    let tmp = "${path}.tmp-${os.rand.bytes(6).to_hex()}"
    match os.fs.write(tmp, e) {
      Ok(_) => {
        match os.fs.rename(tmp, path) {
          Ok(_) => {}
          Err(_) => os.fs.remove(tmp).ignore_err("another process stored it")
        }
      }
      Err(_) => os.fs.remove(tmp).ignore_err("a failed store")
    }
  }
}

fn run_check(os: Os, ctx: Ctx, args: List[Str], support_fn: fn(check.Checker) -> List[Diag] uses (clock, env, fs, proc, rand, stdio)) -> Int {
  var fl = new_flags("check")
  fl.bool_flag("json", "print diagnostics as JSON")
  fl.str_flag("backend", "", "the build backend whose rules to check by (go for the Go backend's; default the native backends', as xo build builds)")
  fl.opt_bool_flag("support", "the native backends' support check (XO1201: what they cannot build yet), which lowers every function of the checked modules: on by default, except for a walk (DIR/...), about 10 times the plain check there; --support turns it on for every walked module, --support=false skips it (decision 0523)")
  fl.bool_flag("no-gc", "the same as --support (its old name)")
  fl.bool_flag("support-all", "run the support check on every module of the workspace, not only on the named directories and the walked (DIR/...) ones")
  fl.bool_flag("fix", "first apply every unambiguous machine fix (as `xo fix`) and reformat the changed files, then report what remains (decision 0096)")
  fl.str_flag("dir", "", "a directory to check, as def, refs, and doc take --dir (the same as giving it as an argument)")
  fl.bool_flag("wip", "report unused bindings and imports (XO0110) and unused computed values (XO0209) as warnings, for checking code mid edit; a normal check and every build keep them errors (decision 0293)")
  if !fl.parse(os, args) {
    return 2
  }
  var targets = fl.args
  if !fl.get_str("dir").is_empty() {
    targets = [fl.get_str("dir")] + targets
  }
  if targets.is_empty() {
    os.stdio.eprintln("xo check: no directories given")
    return 2
  }
  if let Some(t) = std_target(ctx, targets) {
    // checked on their own, std's files gave 16,022 misleading errors
    // (2026-11-06; scripts/xocheck refused them since 2026-10-24)
    os.stdio.eprintln("xo check: ${t} is inside std, whose modules are checked as a program's dependencies, not on their own (their use lines, such as native/llrt/raw, resolve only from a program): run `xo test --std-module=M` for module M, or check a program that uses it")
    return 2
  }
  let do_fix = fl.get_bool("fix")
  var applied: List[Change] = []
  if do_fix {
    match fix_run(os, ctx, targets, [], false) {
      Ok(r) => applied = r.changes
      Err(e) => {
        os.stdio.eprintln("xo check: --fix: ${e}")
        return 2
      }
    }
  }
  let be = fl.get_str("backend")
  if !(be is "" | "go" | "native" | "arm64" | "amd64" | "llvm") {
    os.stdio.eprintln("xo check: --backend=${be}: want go, arm64, amd64 or llvm")
    return 2
  }
  var lctx = ctx
  lctx.support_all = fl.get_bool("support-all")
  // the support check by default on the named directories, a walk
  // (DIR/...) only when asked (decision 0523: about 10 times the plain
  // check on aws's 480 modules)
  let support = match fl.opt_bool("support") {
    Some(x) => x
    None => fl.get_bool("no-gc") || lctx.support_all || lctx.walk.is_empty()
  }
  var s = match load_check(os, lctx, targets, support, be == "go", support_fn) {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo check: ${e}")
      return 2
    }
  }
  if fl.get_bool("wip") {
    s.diags = soften_wip(s.diags)
  }
  var errs = 0
  var warns = 0
  for d in s.diags {
    if is_error(d) {
      errs += 1
    } else {
      warns += 1
    }
  }
  if fl.get_bool("json") {
    var fields = [("modules", jstrs(s.mods)), ("diagnostics", diags_json(s.diags))]
    if do_fix {
      fields.push(("applied", changes_json(applied)))
    }
    os.stdio.print(indent_json(jobj(fields)))
  } else {
    var b = StrBuilder.new()
    for ch in applied {
      b.write("${ch.file}:${ch.line}: fixed ${ch.rule}: ${ch.title}\n")
    }
    if do_fix {
      b.write("${applied.len()} fix(es) applied\n")
    }
    for d in s.diags {
      b.write(human(d))
      b.write("\n")
    }
    b.write("${s.mods.len()} module(s), ${errs} error(s), ${warns} warning(s)\n")
    os.stdio.eprint(b.freeze())
  }
  if errs > 0 { 1 } else { 0 }
}

/// The check of `xo check` (owner, 2026-10-23, field report 0.26.0 b08):
/// the workspace's modules under the native backends' checker rules, as a
/// build checks them, or the Go backend's with go_rules (--backend=go); with
/// support, when the check reports no error, the XO1201 diagnostics of the
/// SSA builder too, lowering every function of the root modules (a
/// library's too): what the native backends cannot build yet (decision
/// 0523 proposes it as the default; about 0.9 s more for compiler/xo,
/// warm). A per module check (decision 0513) runs it on each member's
/// checker.
/// The first of targets (a directory, or a walk DIR/...) at or inside the
/// std root, None when there is none.
fn std_target(ctx: Ctx, targets: List[Str]) -> Str? {
  if ctx.std.is_empty() {
    return None
  }
  let std = clean_path(abs_path(ctx, ctx.std))
  for t in targets {
    var d = t.trim_suffix("/...")
    if d == "..." {
      d = "."
    }
    let a = clean_path(abs_path(ctx, d))
    if a == std || a.starts_with("${std}/") {
      return Some(t)
    }
  }
  None
}

fn load_check(os: Os, ctx: Ctx, dirs: List[Str], support: Bool, go_rules: Bool, support_fn: fn(check.Checker) -> List[Diag] uses (clock, env, fs, proc, rand, stdio)) -> Session ! Str uses fs, proc, net, rand, env, clock, stdio {
  if go_rules {
    return load(os, ctx, dirs, false, {})
  }
  // --support keeps the module check cache and the lazy runtime: the SSA
  // builder checks the runtime bodies it reaches (check_lazy) as a build
  // does, and a skipped module's diagnostics come from its entry. A check
  // may hold one workspace member at a time (decision 0513): the support
  // check then runs on each member's checker (load_each; with one
  // checker for the whole workspace, aws's 438 modules passed 18 GB)
  var cx = ctx
  cx.per_module = true
  if support {
    cx.member_support = Some(support_fn)
  }
  var s = load_mode_cached(os, cx, dirs, false, {}, [], true, true)?
  if !support || s.supported {
    return Ok(s)
  }
  var errs = false
  for d in s.diags {
    errs = errs || !d.warning
  }
  if !errs {
    // the driver's support check (compiler/xo: through the front end
    // cache), or plain_support, with every function of the root modules
    // a root (decision 0523)
    s.c.lib_roots = true
    s.diags = sort_diags(s.diags + support_fn(s.c))
  }
  Ok(s)
}

/// The native backends' support check of c's program without a cache:
/// the XO1201 diagnostics of the SSA builder (none for a library, which
/// has no program to lower).
pub fn plain_support(c: check.Checker) -> List[Diag] uses fs.read {
  let b = ssa.build_program(c, ".", false)
  if b.why.is_empty() { ssa.nogc_diags(b) } else { [] }
}
