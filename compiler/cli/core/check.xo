// `xo parse` and `xo check` (cmd/xo main.go runParse, runCheckWith).

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser
use github.com/xo-lang/xo/compiler/cli/modules
use github.com/xo-lang/xo/compiler/ssa

// ---------------------------------------------------------------------------
// parse

fn run_parse(os: Os, ctx: Ctx, args: List[Str]) -> Int {
  var fl = new_flags("parse")
  fl.bool_flag("json", "print diagnostics (and the AST with --ast) as JSON")
  fl.bool_flag("ast", "dump the syntax tree as JSON")
  fl.bool_flag("sig", "allow function declarations without bodies")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.is_empty() {
    os.stdio.eprintln("xo parse: no files or directories given")
    return 2
  }
  let files = match collect(os, ctx, fl.args) {
    Ok(fs) => fs
    Err(e) => {
      os.stdio.eprintln("xo parse: ${e}")
      return 2
    }
  }
  let as_json = fl.get_bool("json")
  let with_ast = fl.get_bool("ast")
  let sig = fl.get_bool("sig")
  var all: List[Diag] = []
  var results: List[Str] = []
  for path in files {
    let src = match os.fs.read(path) {
      Ok(b) => b
      Err(e) => {
        os.stdio.eprintln("xo parse: ${fs_err(e)}")
        return 2
      }
    }
    let r = parser.parse_file(path.bytes(), src, sig)
    all = all + check.parse_diags(path, r.diags)
    var fields = [("path", jstr(path))]
    if with_ast {
      fields.push(("ast", ast_json(r.file)))
    }
    results.push(jobj(fields))
  }
  var has_err = false
  for d in all {
    has_err = has_err || is_error(d)
  }
  if as_json {
    let files_json = if results.is_empty() { "null" } else { jarr(results) }
    os.stdio.print(indent_json(jobj([("files", files_json), ("diagnostics", diags_json(all))])))
  } else {
    if with_ast {
      let files_json = if results.is_empty() { "null" } else { jarr(results) }
      os.stdio.print(indent_json(files_json))
    }
    var b = StrBuilder.new()
    for d in all {
      b.write(human(d))
      b.write("\n")
    }
    b.write("${files.len()} file(s), ${all.len()} error(s)\n")
    os.stdio.eprint(b.freeze())
  }
  if has_err { 1 } else { 0 }
}

/// The .xo files of paths: a file as named, a directory's own .xo files,
/// and for a directory named as DIR/... (in ctx.walk, decision 0345) its
/// .xo files at any depth (check.walk_skips directories skipped), all
/// sorted (cmd/xo collect, collectFmt).
pub fn collect(os: Os, ctx: Ctx, paths: List[Str]) -> List[Str] ! Str uses fs.read {
  var out: List[Str] = []
  for p in paths {
    let info = match os.fs.stat(p) {
      Ok(Some(i)) => i
      Ok(None) => return Err("stat ${p}: no such file or directory")
      Err(e) => return Err(stat_err(p, e))
    }
    if !info.is_dir {
      out.push(p)
      continue
    }
    if !ctx.walk.contains(abs_path(ctx, p)) {
      for f in own_xo(os, p)? {
        out.push(f)
      }
      continue
    }
    var n = WalkCount{}
    walk_xo(os, p, true, out, n)?
  }
  Ok(out.sort())
}

/// The entries and .xo files a DIR/... walk has looked at (the bound of
/// decision 0345).
struct WalkCount {
  seen: Int = 0
  xo: Int = 0
}

/// The .xo files directly in dir.
fn own_xo(os: Os, dir: Str) -> List[Str] ! Str uses fs.read {
  let entries = match os.fs.read_dir(dir) {
    Ok(es) => es
    Err(e) => return Err(stat_err(dir, e))
  }
  var out: List[Str] = []
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") {
      out.push(join_path(dir, e.name))
    }
  }
  Ok(out)
}

/// The error of a DIR/... walk from top over the bound.
fn walk_limit(top: Str) -> Str {
  check.walk_limit_error(if top == "/" { "/..." } else { "${top.trim_suffix("/")}/..." })
}

/// Appends the .xo files under dir in the order filepath.WalkDir visits
/// them, with paths joined as it joins them.
fn walk_xo(os: Os, dir: Str, top: Bool, var out: List[Str], var n: WalkCount) -> () ! Str {
  let entries = match os.fs.read_dir(dir) {
    Ok(es) => es
    Err(e) => return Err(stat_err(dir, e))
  }
  n.seen += entries.len()
  if n.seen > check.MAX_WALK_ENTRIES {
    return Err(walk_limit(dir))
  }
  for e in entries {
    let p = join_path(dir, e.name)
    if e.is_dir {
      if check.walk_skips(e.name) {
        continue
      }
      walk_xo(os, p, false, out, n)?
    } else if p.ends_with(".xo") {
      out.push(p)
      n.xo += 1
      if n.xo > check.MAX_WALK_XO {
        return Err(walk_limit(dir))
      }
    }
  }
  Ok(())
}

fn stat_err(p: Str, e: FsErr) -> Str {
  match e {
    NotFound(_) => "stat ${p}: no such file or directory"
    Denied(_) => "stat ${p}: permission denied"
    _ => fs_err(e)
  }
}

// ---------------------------------------------------------------------------
// check

/// What a check run of some directories found (query.Session).
pub struct Session {
  pub c: check.Checker
  /// The root modules' paths, in order.
  pub mods: List[Str]
  /// The diagnostics, sorted (diag.Sort).
  pub diags: List[Diag]
}

/// Checks dirs and, unless exact, the other modules of their workspace
/// (query.Load, LoadExact). The error is what cmd/xo prints after
/// "xo <command>: ".
pub fn load(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes]) -> Session ! Str uses fs, proc, net, rand, env {
  load_with(os, ctx, dirs, exact, overlay, [])
}

/// load with the std and runtime modules of preload (`std/tls`,
/// `native/llrt/pool`) loaded too, imported or not (decision 0289).
pub fn load_with(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes], preload: List[Str]) -> Session ! Str uses fs, proc, net, rand, env {
  load_mode(os, ctx, dirs, exact, overlay, preload, false)
}

/// load_with under the native backends' checker rules when native (as
/// `xo check` checks by default, owner 2026-10-23: `use c` is valid), else
/// the Go backend's.
fn load_mode(os: Os, ctx: Ctx, dirs: List[Str], exact: Bool, overlay: Map[Str, Bytes], preload: List[Str], native: Bool) -> Session ! Str uses fs, proc, net, rand, env {
  var c = new_checker(os, ctx)
  c.native = native
  c.overlay = overlay
  c.preload = preload
  let all = if exact { dirs } else { c.workspace_dirs(dirs) }
  // the workspace's other modules: walked when a named directory is
  // (DIR/...), left out when they hold no .xo file of their own
  c.named_dirs = dirs.len()
  if dirs.any(fn(d) { c.walk.contains(abs_path(ctx, d)) }) {
    for d in all[dirs.len()..] {
      c.walk.push(abs_path(ctx, d))
    }
  }
  c.check_dirs_fetching(os, all, fn(p: Str, v: Str) -> Str ! check.Problem { modules.fetch(os, ctx.wd, p, v) })?
  if !c.unsupported.is_empty() {
    return Err("not supported by the self hosted checker: ${c.unsupported}")
  }
  var mods: List[Str] = []
  for m in c.root_mods {
    mods.push(c.mods[m].path)
  }
  let ds = sort_diags(c.diags)
  Ok(Session{c: c, mods: mods, diags: ds})
}

fn run_check(os: Os, ctx: Ctx, args: List[Str]) -> Int {
  var fl = new_flags("check")
  fl.bool_flag("json", "print diagnostics as JSON")
  fl.str_flag("backend", "", "the build backend whose rules to check by (go for the Go backend's; default the native backends', as xo build builds)")
  fl.bool_flag("support", "also run the native backends' support check (XO1201: what they cannot build yet), which lowers the program")
  fl.bool_flag("no-gc", "the same as --support (its old name)")
  fl.bool_flag("fix", "first apply every unambiguous machine fix (as `xo fix`) and reformat the changed files, then report what remains (decision 0096)")
  fl.str_flag("dir", "", "a directory to check, as def, refs, and doc take --dir (the same as giving it as an argument)")
  fl.bool_flag("wip", "report unused bindings and imports (XO0110) and unused computed values (XO0209) as warnings, for checking code mid edit; a normal check and every build keep them errors (decision 0293)")
  if !fl.parse(os, args) {
    return 2
  }
  var targets = fl.args
  if !fl.get_str("dir").is_empty() {
    targets = [fl.get_str("dir")] + targets
  }
  if targets.is_empty() {
    os.stdio.eprintln("xo check: no directories given")
    return 2
  }
  let do_fix = fl.get_bool("fix")
  var applied: List[Change] = []
  if do_fix {
    match fix_run(os, ctx, targets, [], false) {
      Ok(r) => applied = r.changes
      Err(e) => {
        os.stdio.eprintln("xo check: --fix: ${e}")
        return 2
      }
    }
  }
  let be = fl.get_str("backend")
  if !(be is "" | "go" | "native" | "arm64" | "amd64" | "llvm") {
    os.stdio.eprintln("xo check: --backend=${be}: want go, arm64, amd64 or llvm")
    return 2
  }
  var s = match load_check(os, ctx, targets, fl.get_bool("support") || fl.get_bool("no-gc"), be == "go") {
    Ok(x) => x
    Err(e) => {
      os.stdio.eprintln("xo check: ${e}")
      return 2
    }
  }
  if fl.get_bool("wip") {
    s.diags = soften_wip(s.diags)
  }
  var errs = 0
  var warns = 0
  for d in s.diags {
    if is_error(d) {
      errs += 1
    } else {
      warns += 1
    }
  }
  if fl.get_bool("json") {
    var fields = [("modules", jstrs(s.mods)), ("diagnostics", diags_json(s.diags))]
    if do_fix {
      fields.push(("applied", changes_json(applied)))
    }
    os.stdio.print(indent_json(jobj(fields)))
  } else {
    var b = StrBuilder.new()
    for ch in applied {
      b.write("${ch.file}:${ch.line}: fixed ${ch.rule}: ${ch.title}\n")
    }
    if do_fix {
      b.write("${applied.len()} fix(es) applied\n")
    }
    for d in s.diags {
      b.write(human(d))
      b.write("\n")
    }
    b.write("${s.mods.len()} module(s), ${errs} error(s), ${warns} warning(s)\n")
    os.stdio.eprint(b.freeze())
  }
  if errs > 0 { 1 } else { 0 }
}

/// The check of `xo check` (owner, 2026-10-23, field report 0.26.0 b08):
/// the workspace's modules under the native backends' checker rules, as a
/// build checks them, or the Go backend's with go_rules (--backend=go); with
/// support, when the check reports no error and a root module declares
/// main, the XO1201 diagnostics of the SSA builder too (what the native
/// backends cannot build yet; it lowers the program, about 2 s for
/// compiler/xo, so it is not the default yet).
fn load_check(os: Os, ctx: Ctx, dirs: List[Str], support: Bool, go_rules: Bool) -> Session ! Str uses fs, proc, net, rand, env {
  if go_rules {
    return load(os, ctx, dirs, false, {})
  }
  var s = load_mode(os, ctx, dirs, false, {}, [], true)?
  if !support {
    return Ok(s)
  }
  var errs = false
  for d in s.diags {
    errs = errs || !d.warning
  }
  if !errs {
    let b = ssa.build_program(s.c, ".", false)
    // no main: a library has no program to lower
    if b.why.is_empty() {
      s.diags = sort_diags(s.diags + ssa.nogc_diags(b))
    }
  }
  Ok(s)
}
