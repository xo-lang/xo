// The core commands of the `xo` command line in Xo (decision 0178 stage
// 2): check, parse, explain, version, init, fmt, fix, vet, and doc, each
// with the flags, exit codes, and output of cmd/xo (the Go side is the
// reference). compiler/xo (xo1) dispatches them here.
//
// Global flags before the command: --std=DIR names the std declaration
// files (default $XO_STD, else lib/xo/std beside the binary's directory's
// parent, else std beside the binary, else ./std); --wd=DIR the working
// directory (default $PWD). After the command, as in cmd/xo,
// --offline and --workspace=off|on are taken from anywhere before `--`.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/hostpath

/// The toolchain version (cmd/xo version.go; TestSelfhostVersion keeps
/// them equal).
pub const VERSION = "0.26.0"

/// What every command needs from the environment.
pub struct Ctx {
  pub std: Str
  pub wd: Str
  /// XO_OFFLINE and XO_WORK after --offline and --workspace.
  pub offline: Str
  pub work: Str
  /// The directories (absolute) the command line named as DIR/...: only
  /// they cover the directories below them (decision 0345).
  pub walk: List[Str] = []
  /// The module check cache for `xo check` (decision 0351 addendum,
  /// 2026-10-23): the driver's backend cache directory and cache ID, ""
  /// when the cache is off (compiler/xo main.xo check_cache).
  pub chk_dir: Str = ""
  pub chk_id: Str = ""
}

/// The commands this package runs.
pub fn is_command(args: List[Str]) -> Bool {
  var i = 0
  while i < args.len() && (args[i].starts_with("--std=") || args[i].starts_with("--wd=")) {
    i += 1
  }
  i < args.len() && (args[i] is "check" | "parse" | "explain" | "version" | "--version" | "init" | "fmt" | "fix" | "vet" | "doc" | "help" | "-h" | "--help")
}

/// Runs the command line args (the command first) and returns the exit
/// status.
pub fn run(os: Os, args0: List[Str]) -> Int uses fs, env, stdio, proc, clock, net, rand {
  run_extra(os, args0, [])
}

/// run with extra findings for `xo vet` (its --cost notes, which the
/// driver computes from the compiled program: decision 0327).
pub fn run_extra(os: Os, args0: List[Str], extra: List[Diag]) -> Int uses fs, env, stdio, proc, clock, net, rand {
  run_cached(os, args0, extra, "", "", fn(c: check.Checker) -> List[Diag] uses (clock, env, fs, proc, rand, stdio) { plain_support(c) })
}

/// run_extra with the module check cache for `xo check` in chk_dir under
/// the cache ID chk_id ("" for none).
pub fn run_cached(os: Os, args0: List[Str], extra: List[Diag], chk_dir: Str, chk_id: Str, support: fn(check.Checker) -> List[Diag] uses (clock, env, fs, proc, rand, stdio)) -> Int uses fs, env, stdio, proc, clock, net, rand {
  var std_dir = os.env.get("XO_STD") ?? ""
  var wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  var args = args0
  while !args.is_empty() && (args[0].starts_with("--std=") || args[0].starts_with("--wd=")) {
    if args[0].starts_with("--std=") {
      std_dir = args[0].trim_prefix("--std=")
    } else {
      wd = args[0].trim_prefix("--wd=")
    }
    args = drop_first(args)
  }
  if std_dir.is_empty() {
    std_dir = find_std(os)
  }
  if args.is_empty() {
    os.stdio.eprint(cmdhelp.top())
    return 2
  }
  var ctx = Ctx{std: std_dir, wd: wd, offline: os.env.get("XO_OFFLINE") ?? "", work: os.env.get("XO_WORK") ?? "", chk_dir: chk_dir, chk_id: chk_id}
  // moduleFlags: --offline and --workspace anywhere before `--`
  var rest: List[Str] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "--" {
      while i < args.len() {
        rest.push(args[i])
        i += 1
      }
      break
    }
    if a == "--offline" || a == "-offline" || a == "--offline=true" {
      ctx.offline = "1"
    } else if a == "--offline=false" {
      ctx.offline = ""
    } else if a.starts_with("--workspace=") || a.starts_with("-workspace=") {
      let v = a.split("=")[1]
      if v == "off" {
        ctx.work = "off"
      } else if v == "on" || v == "auto" {
        ctx.work = ""
      } else {
        os.stdio.eprintln("xo ${args[0]}: --workspace=${v}: want off or on")
        return 2
      }
    } else if cmdhelp.takes_dirs(args[0]) && cmdhelp.is_pattern(a) {
      // DIR/... (the front end took any other pattern form): DIR, walked
      let d = cmdhelp.pattern_dir(a)
      ctx.walk.push(abs_path(ctx, d))
      rest.push(d)
    } else {
      rest.push(a)
    }
    i += 1
  }
  match args[0] {
    "check" => run_check(os, ctx, rest, support)
    "parse" => run_parse(os, ctx, rest)
    "explain" => run_explain(os, rest)
    "version" | "--version" => run_version(os, rest)
    "init" => run_init(os, ctx, rest)
    "fmt" => run_fmt(os, ctx, rest)
    "fix" => run_fix(os, ctx, rest)
    "vet" => run_vet(os, ctx, rest, extra)
    "doc" => run_doc(os, ctx, rest)
    "help" | "-h" | "--help" => {
      os.stdio.print(cmdhelp.top())
      0
    }
    _ => {
      os.stdio.eprint("xo: unknown command ${go_quote(args[0])}\n\n${cmdhelp.top()}")
      2
    }
  }
}

/// The std directory when --std names none: $XO_STD, else lib/xo/std of
/// a release layout beside the binary Env.program names (check.std_dir).
fn find_std(os: Os) -> Str uses (env, fs.read) {
  check.std_dir(os.env, os.fs)
}

/// A checker for dirs with the module environment of ctx (as xo1 and
/// compiler/check's command line set it up).
pub fn new_checker(os: Os, ctx: Ctx) -> check.Checker uses fs.read, env {
  var c = check.new_checker(os.fs, ctx.std)
  c.set_mod_env(ctx.wd, os.env.get("XO_MODCACHE") ?? "", os.env.get("HOME") ?? "", os.env.get("XDG_CACHE_HOME") ?? "", ctx.offline, ctx.work)
  c.cbind_dir = os.env.get("XO_CBIND_DIR") ?? ""
  c.gobind_dir = os.env.get("XO_GOBIND_DIR") ?? ""
  c.walk = ctx.walk
  c
}

// ---------------------------------------------------------------------------
// version and explain

fn run_version(os: Os, args: List[Str]) -> Int {
  if !args.is_empty() {
    os.stdio.eprint(cmdhelp.usage("version"))
    return 2
  }
  let goos = match target.os {
    Linux => "linux"
    Darwin => "darwin"
    Windows => "windows"
    Wasi => "wasip1"
  }
  let arch = match target.arch {
    Amd64 => "amd64"
    Arm64 => "arm64"
    Wasm32 => "wasm"
  }
  os.stdio.println("xo ${VERSION} ${goos}/${arch}")
  0
}

/// "XO0201", "xo0201", or "0201" as "XO0201" (diag.NormalizeCode).
fn normalize_code(s: Str) -> Str {
  let u = s.trim().to_upper()
  if u.starts_with("XO") { u } else { "XO${u}" }
}

fn run_explain(os: Os, args: List[Str]) -> Int {
  var fl = new_flags("explain")
  fl.bool_flag("json", "print the explanation as JSON")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.len() != 1 {
    os.stdio.eprintln("usage: xo explain [--json] <code>   (for example XO0201)")
    return 2
  }
  let code = normalize_code(fl.args[0])
  let e = match explanation(code) {
    Some(x) => x
    None => {
      os.stdio.eprintln("xo explain: unknown diagnostic code ${go_quote(fl.args[0])}")
      return 1
    }
  }
  if fl.get_bool("json") {
    // a map[string]string: keys sorted
    os.stdio.print(indent_json(jobj([("code", jstr(code)), ("detail", jstr(e.detail)), ("example", jstr(e.example)), ("fix", jstr(e.fix)), ("severity", jstr(e.severity)), ("summary", jstr(e.summary)), ("title", jstr(e.title))])))
    return 0
  }
  var b = StrBuilder.new()
  b.write("${code}: ${e.title}\nseverity: ${e.severity}\n\n${e.detail}\n\nExample:\n")
  indent_block(b, e.example)
  b.write("\nFix:\n")
  indent_block(b, e.fix)
  os.stdio.print(b.freeze())
  0
}

/// s without its trailing newlines (strings.TrimRight(s, "\n")).
fn trim_newlines(s: Str) -> Str {
  var t = s
  while t.ends_with("\n") {
    t = slice_to(t, t.len() - 1)
  }
  t
}

/// xs without its first element.
pub fn drop_first(xs: List[Str]) -> List[Str] {
  var out: List[Str] = []
  for i in 1..xs.len() {
    out.push(xs[i])
  }
  out
}

/// s with every non empty line indented by four spaces (diag indent).
fn indent_block(var b: StrBuilder, s: Str) {
  for line in trim_newlines(s).split("\n") {
    if !line.is_empty() {
      b.write("    ")
      b.write(line)
    }
    b.write("\n")
  }
}

// ---------------------------------------------------------------------------
// init

fn run_init(os: Os, ctx: Ctx, args: List[Str]) -> Int {
  var fl = new_flags("init")
  fl.str_flag("dir", ".", "the module directory")
  if !fl.parse(os, args) {
    return 2
  }
  if fl.args.len() != 1 {
    os.stdio.eprintln("xo init: want one module path (xo init github.com/acme/billing)")
    return 2
  }
  let path = fl.args[0]
  if !valid_module_path(path) {
    os.stdio.eprintln("xo init: invalid module path ${go_quote(path)}: a module path is its location, such as github.com/acme/billing (core 4.2)")
    return 2
  }
  let dir = fl.get_str("dir")
  match os.fs.create_dir_all(dir) {
    Ok(_) => {}
    Err(e) => {
      os.stdio.eprintln("xo init: ${fs_err(e)}")
      return 1
    }
  }
  let name = join_path(dir, "xo.mod")
  if os.fs.exists(name).ok() ?? false {
    os.stdio.eprintln("xo init: ${name} already exists")
    return 1
  }
  match os.fs.write(name, "module ${path}\nedition preview\n".bytes()) {
    Ok(_) => {}
    Err(e) => {
      os.stdio.eprintln("xo init: ${fs_err(e)}")
      return 1
    }
  }
  os.stdio.println("wrote ${name}")
  let w = nearest_work(os, ctx, dir)
  if !w.is_empty() {
    os.stdio.println("the workspace ${w} is above it; add `use ${dir}` to it to build the module from here")
  }
  let ignore = join_path(dir, ".gitignore")
  var s = ""
  if os.fs.exists(ignore).ok() ?? false {
    match os.fs.read_text(ignore) {
      Ok(t) => s = t
      Err(e) => {
        os.stdio.eprintln("xo init: ${fs_err(e)}")
        return 1
      }
    }
  }
  var has_work = !w.is_empty()
  var has_dot = false
  for l in s.split("\n") {
    let t = l.trim()
    has_work = has_work || t is "xo.work" | "/xo.work"
    has_dot = has_dot || t is ".xo" | ".xo/" | "/.xo" | "/.xo/"
  }
  if has_work && has_dot {
    return 0
  }
  if !s.is_empty() && !s.ends_with("\n") {
    s = s + "\n"
  }
  var added: List[Str] = []
  if !has_work {
    s = s + "# a local xo.work workspace (decision 0086) is not committed in a single module repository\n/xo.work\n"
    added.push("xo.work")
  }
  if !has_dot {
    s = s + "# xo's caches in the module: the use go and use c bindings (.xo/gobind, .xo/cbind)\n/.xo/\n"
    added.push(".xo/")
  }
  match os.fs.write(ignore, s.bytes()) {
    Ok(_) => {}
    Err(e) => {
      os.stdio.eprintln("xo init: ${fs_err(e)}")
      return 1
    }
  }
  os.stdio.println("added ${added.join(" and ")} to ${ignore}")
  0
}

/// mod.ValidPath: a module path is its location, with a dot in the first
/// element.
pub fn valid_module_path(p: Str) -> Bool {
  if p.is_empty() || p.starts_with("/") || p.ends_with("/") {
    return false
  }
  let elems = p.split("/")
  if !elems[0].contains(".") {
    return false
  }
  for e in elems {
    if e.is_empty() || e == "." || e == ".." || e.starts_with(".") {
      return false
    }
    for ch in e.bytes() {
      let ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' || ch == '_' || ch == '~'
      if !ok {
        return false
      }
    }
  }
  true
}

/// mod.NearestWork: the xo.work XO_WORK names, or the nearest at or above
/// dir, absolute; "" for none or when workspaces are off.
pub fn nearest_work(os: Os, ctx: Ctx, dir: Str) -> Str uses fs.read {
  if ctx.work == "off" {
    return ""
  }
  if !ctx.work.is_empty() {
    return abs_path(ctx, ctx.work)
  }
  var d = abs_path(ctx, dir)
  while true {
    let name = join_path(d, "xo.work")
    if os.fs.exists(name).ok() ?? false {
      return name
    }
    // the root of the volume (/, C:/), where dir_of gives back d
    let up = dir_of(d)
    if up == d || hostpath.is_root(d) {
      return ""
    }
    d = up
  }
  ""
}

// ---------------------------------------------------------------------------
// Paths (path/filepath on Unix)

/// filepath.Clean (hostpath.clean: a Windows volume stays in front).
pub fn clean_path(p: Str) -> Str { hostpath.clean(p) }

/// filepath.Join of two elements.
pub fn join_path(a: Str, b: Str) -> Str { hostpath.join(a, b) }

/// filepath.Dir.
pub fn dir_of(p: Str) -> Str { hostpath.dir(p) }

/// filepath.Base.
pub fn base_of(p: Str) -> Str { hostpath.base(p) }

/// filepath.Abs against the working directory of ctx.
pub fn abs_path(ctx: Ctx, p: Str) -> Str { hostpath.abs(ctx.wd, p) }

/// filepath.Rel(base, target) for two absolute clean paths; None when
/// target is not below base.
pub fn rel_below(base: Str, target: Str) -> Str? { hostpath.rel_below(base, target) }

/// An Fs error as Go's *PathError prints it, as near as the error kinds
/// allow.
pub fn fs_err(e: FsErr) -> Str {
  match e {
    NotFound(path) => "open ${path}: no such file or directory"
    Exists(path) => "${path}: file exists"
    NotEmpty(path) => "${path}: directory not empty"
    NotDir(path) => "${path}: not a directory"
    IsDir(path) => "read ${path}: is a directory"
    Denied(path) => "open ${path}: permission denied"
    Io(path, msg) => "${path}: ${msg}"
    Canceled => "canceled"
  }
}
