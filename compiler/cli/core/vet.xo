// `xo vet` (cmd/xo tools.go runVet, internal/vet): advisory checks over a
// checked program, never errors: the warnings of check, unused declared
// effects (XO0703), `x ?? [].f()` (XO0207), every `.ignore_err` reason
// (XO0208), `use go` per module (XO1103), `dbg(...)` left in code
// (XO0901), an I/O error defaulted away (XO0903).

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/lexer
use github.com/xo-lang/xo/compiler/parser

fn run_vet(os: Os, ctx: Ctx, args: List[Str], extra: List[Diag]) -> Int {
  var fl = new_flags("vet")
  fl.bool_flag("json", "print the findings as JSON")
  // the driver computes these notes and passes them in (extra)
  fl.bool_flag("cost", "also note costs the compiled program has in loops that its source does not show (decision 0327)")
  fl.str_flag("std-module", "", "vet one std or runtime module as `xo test --std-module` checks it, with its private declarations (json, native/http, native/llrt/pool)")
  if !fl.parse(os, args) {
    return 2
  }
  // what to vet (decision 0289): program directories; a .xo file (its
  // directory, findings in that file only); std and runtime modules, each
  // checked as the std module under test, named by --std-module or by a
  // directory or file under std
  var dirs: List[Str] = []
  var files: List[Str] = []
  var std_mods: List[Str] = []
  let sm = fl.get_str("std-module")
  if !sm.is_empty() {
    std_mods.push(std_module_path(sm))
  }
  let std_root = abs_path(ctx, ctx.std)
  for a in fl.args {
    if a.ends_with("...") {
      // DIR/... is DIR (decision 0210): the loader reads it
      dirs.push(a)
      continue
    }
    let ap = abs_path(ctx, a)
    let is_dir = match os.fs.stat(ap) {
      Ok(Some(i)) => i.is_dir
      _ => false
    }
    let dir = if is_dir { ap } else { dir_of(ap) }
    if !is_dir {
      if !a.ends_with(".xo") {
        os.stdio.eprintln("xo vet: ${a} is not a directory or a .xo file")
        return 2
      }
      files.push(ap)
    }
    match rel_below(std_root, dir) {
      Some(rel) => {
        let sub = if rel == "." { "" } else { "${rel}/" }
        if !(sub is "" | "native/" | "native/llrt/") {
          os.stdio.eprintln("xo vet: ${a}: std modules are the files of std, std/native, and std/native/llrt")
          return 2
        }
        let prefix = if sub.is_empty() { "std/" } else { sub }
        let names = if is_dir { std_files(os, dir) } else { [base_of(ap)] }
        for n in names {
          if !n.ends_with("_test.xo") && !n.ends_with("_c.xo") && !(sub.is_empty() && n == "prelude.xo") {
            std_mods.push("${prefix}${n.trim_suffix(".xo")}")
          }
        }
      }
      None => {
        if !dirs.contains(dir) || is_dir {
          dirs.push(if is_dir { a } else { dir })
        }
      }
    }
  }
  if dirs.is_empty() && std_mods.is_empty() {
    dirs = ["."]
  }
  var ds: List[Diag] = []
  var check_errors = 0
  var mods: List[Str] = []
  if !dirs.is_empty() {
    let s = match load(os, ctx, dirs, true, {}) {
      Ok(x) => x
      Err(e) => {
        os.stdio.eprintln("xo vet: ${e}")
        return 2
      }
    }
    let (d, n) = vet_session(s.c, s.diags)
    ds = ds + d + embed_untracked(os, s.c)
    check_errors += n
    mods = mods + s.mods
  }
  if !std_mods.is_empty() {
    // one check: --std-module alone as the std module under test (with
    // its private test file, decision 0262); a std directory's modules
    // loaded together, in native mode for the runtime's
    var c = new_checker(os, ctx)
    c.native = std_mods.any(fn(p: Str) -> Bool { p.starts_with("native/") })
    if std_mods.len() == 1 && !sm.is_empty() {
      c.std_test = std_mods[0]
    } else {
      c.preload = std_mods
    }
    match c.check_dirs([]) {
      Ok(_) => {}
      Err(e) => {
        os.stdio.eprintln("xo vet: ${e}")
        return 2
      }
    }
    var ms: List[Int] = []
    for path in std_mods {
      match c.mod_index.get(path) {
        Some(m) => {
          ms.push(m)
          mods.push(path)
        }
        None => {
          os.stdio.eprintln("xo vet: std module ${path} not found in ${ctx.std}")
          return 2
        }
      }
    }
    let (d, n) = vet_modules(c, sort_diags(c.diags), ms, true)
    ds = ds + d
    check_errors += n
  }
  ds = ds + extra
  if !files.is_empty() {
    ds = ds.filter(fn(d: Diag) -> Bool { files.contains(abs_path(ctx, d.file)) || files.contains(join_path(dir_of(std_root), d.file)) })
  }
  let s = VetRun{mods: mods}
  ds = sort_diags(ds)
  if fl.get_bool("json") {
    os.stdio.print(indent_json(jobj([("modules", jstrs(s.mods)), ("diagnostics", diags_json(ds)), ("check_errors", "${check_errors}")])))
    return 0
  }
  var warns = 0
  var notes = 0
  var b = StrBuilder.new()
  for d in ds {
    b.write(human(d))
    b.write("\n")
    if d.note_sev {
      notes += 1
    } else {
      warns += 1
    }
  }
  os.stdio.print(b.freeze())
  os.stdio.eprintln("${s.mods.len()} module(s), ${warns} warning(s), ${notes} note(s)")
  if check_errors > 0 {
    os.stdio.eprintln("xo vet: the program has ${check_errors} check error(s), not repeated here; run `xo check`")
  }
  0
}

/// The modules vetted, for the summary.
struct VetRun {
  mods: List[Str]
}

/// The findings of a checked program's root modules: the warnings and
/// notes of its check and the vet checks, and its count of check errors.
fn vet_session(c: check.Checker, diags: List[Diag]) -> (List[Diag], Int) { vet_modules(c, diags, c.root_mods, false) }

/// vet_session over modules ms; only the check's findings in their files
/// when own (a std directory loads modules it does not vet).
fn vet_modules(c: check.Checker, diags: List[Diag], ms: List[Int], own: Bool) -> (List[Diag], Int) {
  var files: Set[Str] = #{}
  for m in ms {
    for f in c.mods[m].files {
      files.add(c.files[f].path)
    }
  }
  var ds: List[Diag] = []
  var check_errors = 0
  for d in diags {
    if own && !files.contains(d.file) {
      continue
    }
    if is_error(d) {
      check_errors += 1
    } else {
      ds.push(d)
    }
  }
  for m in ms {
    ds = ds + vet_module(c, m)
  }
  (ds, check_errors)
}

/// XO0904 (decision 0304): the files the root modules' embed constants
/// embed that git ignores or does not track, so a build of a clean
/// checkout would embed something else or fail. Nothing when git is
/// missing or the module is in no git work tree.
fn embed_untracked(os: Os, c: check.Checker) -> List[Diag] uses proc {
  var out: List[Diag] = []
  for (f, es) in c.embeds.entries() {
    if es.is_empty() || !c.mods[c.files[f].module].root {
      continue
    }
    let file = c.files[f].path
    let dir0 = dir_of(file)
    let dir = if dir0.is_empty() { "." } else { dir0 }
    let inside = match os.proc.run("git", ["-C", dir, "rev-parse", "--is-inside-work-tree"]) {
      Ok(r) => r.code == 0 && (r.stdout.to_str() ?? "").trim() == "true"
      // xo:allow XO0903 no git: the check is skipped, as outside a work tree
      Err(_) => false
    }
    if !inside {
      continue
    }
    var rels: List[Str] = []
    for e in es {
      if !rels.contains(e.rel) {
        rels.push(e.rel)
      }
    }
    var tracked: Set[Str] = #{}
    if let Ok(r) = os.proc.run("git", ["-C", dir, "ls-files", "-z", "--"] + rels) {
      for p in (r.stdout.to_str() ?? "").split("\u{0}") {
        if !p.is_empty() {
          tracked.add(p)
        }
      }
    }
    let untracked = rels.filter(fn(r) { !tracked.contains(r) })
    if untracked.is_empty() {
      continue
    }
    var ignored: Set[Str] = #{}
    if let Ok(r) = os.proc.run("git", ["-C", dir, "check-ignore", "--"] + untracked) {
      for p in (r.stdout.to_str() ?? "").lines() {
        if !p.is_empty() {
          ignored.add(p)
        }
      }
    }
    for e in es {
      if !untracked.contains(e.rel) {
        continue
      }
      let why = if ignored.contains(e.rel) { "git ignores it" } else { "git does not track it" }
      var d = Diag{code: "XO0904", file: file, line: e.line, col: e.col, end_line: e.line, end_col: e.col, message: "the embedded file `${e.rel}` is in no clean checkout: ${why}, so a build there embeds something else or fails", warning: true}
      d.notes.push(check.DNote{message: "add the file to git, or embed only files the repository holds (decision 0304)"})
      out.push(d)
    }
  }
  out
}

/// A std module as `xo test --std-module` names it: json is std/json.
fn std_module_path(m: Str) -> Str {
  if m.starts_with("native/") || m.starts_with("std/") { m } else { "std/${m}" }
}

/// The .xo files of a std directory, sorted.
fn std_files(os: Os, dir: Str) -> List[Str] uses fs.read {
  var out: List[Str] = []
  if let Ok(es) = os.fs.read_dir(dir) {
    for fi in es {
      if !fi.is_dir && fi.name.ends_with(".xo") {
        out.push(fi.name)
      }
    }
  }
  out.sort()
}

fn jspan(file: Str, sp: parser.Span) -> check.JSpan {
  check.JSpan{file: file, line: sp.start.line, col: sp.start.col, end_line: sp.end.line, end_col: sp.end.col}
}

fn point(file: Str, p: parser.Pos) -> check.JSpan {
  check.JSpan{file: file, line: p.line, col: p.col, end_line: p.line, end_col: p.col}
}

fn vdiag(code: Str, note: Bool, file: Str, sp: parser.Span, msg: Str) -> Diag {
  Diag{code: code, file: file, line: sp.start.line, col: sp.start.col, end_line: sp.end.line, end_col: sp.end.col, message: msg, warning: true, note_sev: note}
}

/// The advisory checks of module m (vetter.module).
fn vet_module(c: check.Checker, m: Int) -> List[Diag] {
  var out: List[Diag] = []
  for f in c.mods[m].files {
    let path = c.files[f].path
    var nodes: List[parser.Expr] = []
    for d in c.files[f].ast.decls {
      walk_decl(d, nodes)
    }
    for e in nodes {
      match e {
        BinaryExpr(span, op, x, y) => {
          if op == lexer.Kind.Coalesce {
            if let Some(d) = coalesce_chain(path, span, x, y) {
              out.push(d)
            }
            if let Some(d) = io_default(c, f, path, span, x) {
              out.push(d)
            }
          }
        }
        CallExpr(span, fun, args) => {
          if let Some(d) = vet_call(c, f, path, e, span, fun, args) {
            out.push(d)
          }
          if let Some(d) = uuid_make(c, m, f, path, e, span, fun) {
            out.push(d)
          }
          out = out + task_captures(c, f, path, e, args)
        }
        MatchExpr(span, subject, arms) => {
          if let Some(d) = match_exit(c, f, path, span, subject, arms) {
            out.push(d)
          }
          var pats: List[parser.Pattern] = []
          for a in arms {
            pats.push(a.pattern)
            out = out + uuid_pats(c, m, f, path, a.pattern)
          }
          if let Some(d) = payload_share(c, f, path, subject, pats) {
            out.push(d)
          }
          out = out + io_match(c, f, path, subject, arms)
        }
        IfExpr(ie) => {
          if let (Some(p), Some(x)) = (ie.pattern, ie.value) {
            if let Some(d) = payload_share(c, f, path, x, [p]) {
              out.push(d)
            }
          }
          if let Some(p) = ie.pattern {
            out = out + uuid_pats(c, m, f, path, p)
          }
        }
        Block(b) => {
          for st in b.stmts {
            if let LetStmt(_, p, ..) = st {
              out = out + uuid_pats(c, m, f, path, p)
            }
          }
          out = out + copy_store(c, f, path, b) + elem_copy_store(c, f, path, b) + stale_captures(c, f, path, b)
        }
        StringLit(s) => {
          out = out + debug_interps(c, f, path, s)
        }
        SelectorExpr(span, _, sel) => {
          if let Some(d) = verify_none(c, f, path, e, span, sel) {
            out.push(d)
          }
          if let Some(d) = uuid_text(c, m, f, path, e, span, sel) {
            out.push(d)
          }
        }
        _ => {}
      }
    }
  }
  for fo in c.funcs_of(m) {
    out = out + unused_effects(c, fo)
  }
  out = out + store_only_params(c, m)
  if let Some(d) = go_report(c, m) {
    out.push(d)
  }
  out
}

/// XO0532 (decision 0266) in block b: `var x = m.get(k) ?? d` on a Map,
/// then statements that only change x (a call of a `var` method on x, an
/// assignment to x, its fields or elements), then `m[k] = x`: m.update
/// reads, changes, and stores in one lookup. The change without the store
/// is the checker's XO0520 (core 5.2).
fn copy_store(c: check.Checker, f: Int, file: Str, b: parser.Block) -> List[Diag] {
  var out: List[Diag] = []
  let ss = b.stmts
  for (i, s) in ss.indexed() {
    if let Some((x, m, k, d)) = get_or_var(c, f, s) {
      var j = i + 1
      while j < ss.len() && changes(c, f, ss[j], x) {
        j += 1
      }
      if j == i + 1 {
        continue
      }
      if j < ss.len() && stores_back(c, f, ss[j], x, m, k) {
        let sp = parser.Span{start: stmt_span(s).start, end: stmt_span(ss[j]).end}
        var dg = vdiag("XO0532", true, file, sp, "`${x}` is read from `${m}`, changed, and stored back; `${m}.update(${k}, ${d}, fn(var ${x}) { ... })` does it in one lookup (std.md 2.4)")
        let ind = " ".repeat(sp.start.col - 1)
        var body = ""
        for t in ss[i + 1..j] {
          body = body + "${ind}  ${src_text(c, f, stmt_span(t)).replace("\n", "\n  ")}\n"
        }
        dg.fixes.push(check.DFix{title: "use `${m}.update`", edits: [check.DEdit{span: jspan(file, sp), replace: "${m}.update(${k}, ${d}, fn(var ${x}) {\n${body}${ind}})"}]})
        out.push(dg)
      }
    }
  }
  out
}

/// The identifier at the root of a chain of selectors and indexes.
fn root_ident(e: parser.Expr) -> parser.Ident? {
  match e {
    Ident(id) => Some(id)
    SelectorExpr(_, x, _) => root_ident(x)
    IndexExpr(_, x, _) => root_ident(x)
    ParenExpr(_, x) => root_ident(x)
    _ => None
  }
}

/// Whether call is a call of a `var` method on the local v (`v.push(x)`,
/// `v.items.put(k, x)`).
fn var_method_on(c: check.Checker, f: Int, call: parser.Expr, v: Int) -> Bool {
  if let CallExpr(_, fun, _) = call {
    if let SelectorExpr(_, recv, _) = fun {
      if let Some(id) = root_ident(recv) {
        if c.var_of(f, id) == v {
          if let Some(ci) = c.call_in(f, call) {
            return ci.fn_obj >= 0 && c.objs[ci.fn_obj].recv_var
          }
        }
      }
    }
  }
  false
}

/// The offset of the first write to the local v in statement s (an
/// assignment to it or a part of it, or a call of a `var` method on it),
/// anywhere in s, or -1.
fn first_write(c: check.Checker, f: Int, s: parser.Stmt, v: Int) -> Int {
  var nodes: List[parser.Expr] = []
  walk_stmt(s, nodes)
  var best = -1
  if let AssignStmt(sp, _, target, _) = s {
    if let Some(id) = root_ident(target) {
      if c.var_of(f, id) == v {
        best = sp.start.offset
      }
    }
  }
  for e in nodes {
    var at = -1
    match e {
      Block(b) => {
        for bs in b.stmts {
          if let AssignStmt(sp, _, target, _) = bs {
            if let Some(id) = root_ident(target) {
              if c.var_of(f, id) == v {
                at = sp.start.offset
              }
            }
          }
        }
      }
      CallExpr(sp, ..) => {
        if var_method_on(c, f, e, v) {
          at = sp.start.offset
        }
      }
      _ => {}
    }
    if at >= 0 && (best < 0 || at < best) {
      best = at
    }
  }
  best
}

/// XO0538: in block b, `let name = fn(..) { .. }` whose body reads a `var`
/// local of the enclosing function that a later statement writes, and
/// name is used after that write. A closure takes its captures by value
/// when it is created (core 5.1), so the use sees the value from before the
/// write: the slp_root bug of 2026-10-21 (a union find parent list
/// assigned after the closure that walks it).
fn stale_captures(c: check.Checker, f: Int, file: Str, b: parser.Block) -> List[Diag] {
  var out: List[Diag] = []
  for (i, s) in b.stmts.indexed() {
    let (nm, fl) = match s {
      LetStmt(_, BindPat(_, n), _, FnLit(x), _) => (n, x)
      _ => continue
    }
    let cid = c.var_of(f, nm)
    if cid < 0 {
      continue
    }
    var inner: List[parser.Expr] = []
    walk_block(fl.body, inner)
    var seen: Map[Int, Bool] = {}
    for e in inner {
      let id = match e {
        Ident(x) => x
        _ => continue
      }
      let v = c.var_of(f, id)
      if v < 0 || seen.contains(v) || !c.objs[v].mutable {
        continue
      }
      let o = c.objs[v]
      if o.line > fl.span.start.line || (o.line == fl.span.start.line && o.col >= fl.span.start.col) {
        continue
      }
      seen[v] = true
      var j = i + 1
      while j < b.stmts.len() {
        let at = first_write(c, f, b.stmts[j], v)
        if at >= 0 {
          // a use of the closure after the write, in this or a later
          // statement
          var used = -1
          var k = j
          while k < b.stmts.len() && used < 0 {
            var ns: List[parser.Expr] = []
            walk_stmt(b.stmts[k], ns)
            for ne in ns {
              if let Ident(uid) = ne {
                if uid.span.start.offset > at && c.var_of(f, uid) == cid {
                  used = uid.span.start.offset
                  break
                }
              }
            }
            k += 1
          }
          if used >= 0 {
            let name = check.text(id.name)
            let sp = parser.stmt_span(b.stmts[j])
            var d = vdiag("XO0538", false, file, sp, "`${name}` is written here after the closure `${check.text(nm.name)}` (line ${fl.span.start.line}) captured it: the closure keeps the value `${name}` had when it was created and sees none of this write (core 5.1)")
            d.notes.push(check.DNote{message: "pass `${name}` to the closure as a parameter, or move the closure after the writes"})
            out.push(d)
          }
          break
        }
        j += 1
      }
    }
  }
  out
}

/// XO0536 (decision 0294) in block b: `var x = xs[i]` on a List whose
/// elements are collections (List, Bytes, Map, Set, Str), then later in the
/// block `xs[i] = x`. While xs still holds the element, x's first change
/// copies all of it, at every pass through the block: a loop over the
/// relocations of a section did that to the whole section (compiler/macho
/// pelink.xo, 2026-10-20). Changing `xs[i]` in place copies nothing (core
/// 5.1, decision 0169).
fn elem_copy_store(c: check.Checker, f: Int, file: Str, b: parser.Block) -> List[Diag] {
  var out: List[Diag] = []
  let ss = b.stmts
  for (i, s) in ss.indexed() {
    if let VarStmt(_, name, _, value) = s {
      if let IndexExpr(_, lx, ix) = value {
        if !c.type_text_in(f, lx).starts_with("List[") {
          continue
        }
        let et = c.type_text_in(f, value)
        if !(et.starts_with("List[") || et.starts_with("Map[") || et.starts_with("Set[") || et == "Bytes" || et == "Str") {
          continue
        }
        let x = text_of(name.name)
        let xs = src_text(c, f, parser.expr_span(lx))
        let k = src_text(c, f, parser.expr_span(ix))
        for j in i + 1..ss.len() {
          // `xs[i] = []` after the read takes the element (lsr.xo's
          // idiom): x is then its only holder and changes in place
          if assigns_to(c, f, ss[j], xs, k) && !stores_back(c, f, ss[j], x, xs, k) {
            break
          }
          if stores_back(c, f, ss[j], x, xs, k) {
            var dg = vdiag("XO0536", true, file, stmt_span(s), "`${x}` is copied out of `${xs}[${k}]`, changed, and stored back: while `${xs}` still holds the element, the first change copies all of this `${et}` (core 5.1)")
            dg.notes.push(check.DNote{message: "change `${xs}[${k}]` in place instead (`${xs}[${k}].push(v)`, or pass `${xs}[${k}]` to a `var` parameter); the store back is then not needed", span: Some(jspan(file, stmt_span(ss[j])))})
            out.push(dg)
            break
          }
        }
      }
    }
  }
  out
}

/// Whether s assigns to `m[k]`.
fn assigns_to(c: check.Checker, f: Int, s: parser.Stmt, m: Str, k: Str) -> Bool {
  if let AssignStmt(_, _, target, _) = s {
    if let IndexExpr(_, mx, kx) = target {
      return src_text(c, f, parser.expr_span(mx)) == m && src_text(c, f, parser.expr_span(kx)) == k
    }
  }
  false
}

/// `var x = m.get(k) ?? d` with m a Map: the texts of x, m, k, d.
fn get_or_var(c: check.Checker, f: Int, s: parser.Stmt) -> (Str, Str, Str, Str)? {
  if let VarStmt(_, name, _, value) = s {
    if let BinaryExpr(_, op, call, dflt) = value {
      if op != lexer.Kind.Coalesce {
        return None
      }
      if let CallExpr(_, fun, args) = call {
        if let SelectorExpr(_, mx, sel) = fun {
          if text_of(sel.name) == "get" && args.len() == 1 && c.type_text_in(f, mx).starts_with("Map[") {
            return Some((text_of(name.name), src_text(c, f, parser.expr_span(mx)), src_text(c, f, parser.expr_span(args[0].value)), src_text(c, f, parser.expr_span(dflt))))
          }
        }
      }
    }
  }
  None
}

/// Whether s only changes x: `x.method(...)` of a `var` receiver as a
/// statement, or an assignment whose target is x, a field, or an element
/// of it.
fn changes(c: check.Checker, f: Int, s: parser.Stmt, x: Str) -> Bool {
  match s {
    ExprStmt(_, e) => {
      if let CallExpr(_, fun, _) = e {
        if let SelectorExpr(_, recv, _) = fun {
          if root_name(recv) == x && is_ident(recv) {
            if let Some(ci) = c.call_in(f, e) {
              return ci.fn_obj >= 0 && c.objs[ci.fn_obj].recv_var
            }
          }
        }
      }
      false
    }
    // `x = v` replaces the copy rather than changing it; `x += v` and
    // `x.f = v` change it
    AssignStmt(_, op, target, _) => root_name(target) == x && (op != lexer.Kind.Assign || !is_ident(target))
    _ => false
  }
}

/// Whether s is `m[k] = x`.
fn stores_back(c: check.Checker, f: Int, s: parser.Stmt, x: Str, m: Str, k: Str) -> Bool {
  if let AssignStmt(_, op, target, value) = s {
    if let IndexExpr(_, mx, kx) = target {
      return op == lexer.Kind.Assign && is_ident(value) && root_name(value) == x && src_text(c, f, parser.expr_span(mx)) == m && src_text(c, f, parser.expr_span(kx)) == k
    }
  }
  false
}

/// The name at the root of a chain of selectors and indexes (`x` of
/// `x.f[i].g`), or "".
fn root_name(e: parser.Expr) -> Str {
  match e {
    Ident(id) => text_of(id.name)
    SelectorExpr(_, x, _) => root_name(x)
    IndexExpr(_, x, _) => root_name(x)
    ParenExpr(_, x) => root_name(x)
    _ => ""
  }
}

fn is_ident(e: parser.Expr) -> Bool {
  if let Ident(_) = e { true } else { false }
}

fn stmt_span(s: parser.Stmt) -> parser.Span {
  parser.stmt_span(s)
}

/// The source text of span sp of file f.
fn src_text(c: check.Checker, f: Int, sp: parser.Span) -> Str {
  let src = c.files[f].src
  if sp.start.offset < 0 || sp.end.offset > src.len() || sp.start.offset > sp.end.offset {
    return ""
  }
  src[sp.start.offset..sp.end.offset].to_str() ?? ""
}

/// The number of heap fields (core 5's reference counted values: Str,
/// Bytes, List, Map, handles) whose counts a copy of a value of type t
/// changes: a struct's are its fields', an enum's those of its largest
/// variant, a scalar's none (decision 0263).
fn heap_fields(c: check.Checker, t0: Int, depth: Int) -> Int {
  var memo: Map[Int, Int] = {}
  heap_fields_in(c, t0, depth, memo)
}

/// heap_fields with the counts found so far by type: each type is
/// counted once (the compiler's own enums nest each other in every
/// variant, and walking them afresh at each level took exponential time:
/// `xo vet compiler` ran for 25 minutes, 2026-10-18), and a type met
/// again while it is being counted (a recursive type) counts 0 there.
fn heap_fields_in(c: check.Checker, t0: Int, depth: Int, var memo: Map[Int, Int]) -> Int {
  let t = c.resolve(t0)
  if t < 0 || depth > 64 {
    return 0
  }
  if let Some(n) = memo.get(t) {
    return n
  }
  memo[t] = 0
  let n = heap_fields_of(c, t, depth, memo)
  memo[t] = n
  n
}

fn heap_fields_of(c: check.Checker, t: Int, depth: Int, var memo: Map[Int, Int]) -> Int {
  let ty = c.tys[t]
  match ty.kind {
    check.TyKind.Tuple => {
      var n = 0
      for a in ty.args {
        n += heap_fields_in(c, a, depth + 1, memo)
      }
      n
    }
    check.TyKind.Named => {
      let o = c.objs[ty.obj]
      // a field of a generic type: its type argument
      let arg = fn(ft: Int) -> Int {
        let r = c.resolve(ft)
        if r >= 0 && c.tys[r].kind == check.TyKind.Param {
          for i in 0..o.tparams.len() {
            if o.tparams[i] == c.tys[r].obj && i < ty.args.len() {
              return ty.args[i]
            }
          }
        }
        ft
      }
      if o.tkind == "struct" && o.fields.is_empty() && c.mods[o.module].is_prelude {
        // the prelude's built in types are field-less structs (Str,
        // List[T], Int): a scalar holds no count, the others are one
        return builtin_heap(check.text(o.name))
      }
      match o.tkind {
        "struct" => {
          var n = 0
          for fl in o.fields {
            n += heap_fields_in(c, arg(fl.ty), depth + 1, memo)
          }
          n
        }
        "enum" => {
          var most = 0
          for v in o.variants {
            var n = 0
            for vf in v.fields {
              n += heap_fields_in(c, arg(vf.ty), depth + 1, memo)
            }
            if n > most {
              most = n
            }
          }
          most
        }
        _ => builtin_heap(check.text(o.name))
      }
    }
    _ => 0
  }
}

/// The heap fields of a built in or opaque type named name: none for a
/// scalar, else one (its reference count).
fn builtin_heap(name: Str) -> Int {
  if name is "Int" | "Int8" | "Int16" | "Int32" | "Int64" | "UInt" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Float" | "Float32" | "Float64" | "Bool" | "Char" | "Rune" | "Duration" | "Instant" {
    0
  } else {
    1
  }
}

/// Whether pattern p binds a name inside a variant's payload.
fn binds_payload(p: parser.Pattern, inside: Bool) -> Bool {
  match p {
    BindPat(..) => inside
    OrPat(_, alts) => alts.any(fn(a) { binds_payload(a, inside) })
    TuplePat(_, elems) => elems.any(fn(a) { binds_payload(a, inside) })
    VariantPat(_, _, _, fields, _) => fields.any(fn(pf) { binds_payload(pf.pattern, true) })
    StructPat(_, _, fields, _) => fields.any(fn(pf) { binds_payload(pf.pattern, inside) })
    _ => false
  }
}

/// The copy lint's threshold: payloads with at least this many heap
/// fields are reported (decision 0263).
const COPY_THRESHOLD = 8

/// XO0530: `match c.f { Some(x) => ... }` (or `if let`) on a field binds
/// the payload of a value that lives on, so every heap field of the
/// payload is shared and released again later (decision 0263).
fn payload_share(c: check.Checker, f: Int, file: Str, subject: parser.Expr, pats: List[parser.Pattern]) -> Diag? {
  let base = match subject {
    SelectorExpr(_, x, _) => x
    _ => return None
  }
  // a field of a value (not a module's or a type's member)
  if c.type_in(f, base) < 0 {
    return None
  }
  if !pats.any(fn(p) { binds_payload(p, false) }) {
    return None
  }
  let t = c.type_in(f, subject)
  if t < 0 {
    return None
  }
  let n = heap_fields(c, t, 0)
  if n < COPY_THRESHOLD {
    return None
  }
  let what = c.show(t)
  var d = vdiag("XO0530", false, file, parser.expr_span(subject), "binding the payload of this field shares the ${n} heap fields of `${what}`, and releasing the field later releases them again")
  d.notes.push(check.DNote{message: "test it with `.is_none()` (or a pattern without bindings) first when the payload is not needed, or take the value out of its owner before matching (decision 0263)"})
  Some(d)
}

/// XO0703: the effects named in the `uses` clauses of fo that its body
/// never performs.
fn unused_effects(c: check.Checker, fo: Int) -> List[Diag] {
  var out: List[Diag] = []
  let o = c.objs[fo]
  if o.fn_decl.is_empty() || c.mods[o.module].is_std {
    return out
  }
  let fd = o.fn_decl[0]
  if fd.body.is_none() {
    return out
  }
  var labels: List[Str] = []
  var params: List[Str] = []
  for (name, is_param) in c.performed_of(fo) {
    if is_param {
      params.push(name)
    } else {
      labels.push(name)
    }
  }
  var is_param: List[Str] = []
  for tp in fd.type_params {
    if tp.effects {
      is_param.push(text_of(tp.name.name))
    }
  }
  for cl in fd.clauses {
    match cl {
      UsesClause(uspan, effects, _) => {
        for e in effects {
          var name = text_of(e.name.name)
          if let Some(sub) = e.sub {
            name = "${name}.${text_of(sub.name)}"
          }
          var used = false
          if is_param.contains(name) {
            used = params.contains(name)
          } else {
            for l in labels {
              if l == name || l.starts_with("${name}.") || name.starts_with("${l}.") {
                used = true
              }
            }
          }
          if used {
            continue
          }
          var d = vdiag("XO0703", false, o.file, e.span, "`${c.display_name(fo)}` declares `uses ${name}` but never performs it")
          d.notes.push(check.DNote{message: "declaring more effects than the body performs is allowed (core 6.2); keep it only if callers should already budget for it, such as an interface or a planned change"})
          if effects.len() == 1 {
            d.fixes.push(check.DFix{title: "remove the `uses` clause", edits: [check.DEdit{span: jspan(o.file, uspan), replace: ""}]})
          }
          out.push(d)
        }
      }
      _ => {}
    }
  }
  out
}

/// XO0207: `x ?? [].f()`, where `??` binds loosest so the chain applies
/// to the literal default only.
fn coalesce_chain(file: Str, span: parser.Span, x: parser.Expr, y: parser.Expr) -> Diag? {
  let (base, sel) = chain_base(y)
  if sel.is_empty() || !is_literal(base) {
    return None
  }
  var d = vdiag("XO0207", false, file, parser.expr_span(y), "`.${sel}` applies only to the default `${lit_text(base)}`, not to the result of `??`, because `??` binds loosest")
  d.notes.push(check.DNote{message: "if the whole value was meant, parenthesize the `??`; if only the default was meant, bind it to a name first"})
  d.fixes.push(check.DFix{title: "apply the chain to the result of `??`", edits: [
    check.DEdit{span: point(file, parser.expr_span(x).start), replace: "("},
    check.DEdit{span: point(file, parser.expr_span(base).end), replace: ")"},
  ]})
  Some(d)
}

/// The innermost operand of a postfix chain and the first selector applied
/// to it ("" when the chain has none).
fn chain_base(e0: parser.Expr) -> (parser.Expr, Str) {
  var sel = ""
  var e = e0
  while true {
    match e {
      SelectorExpr(_, x, s) => {
        sel = text_of(s.name)
        e = x
      }
      CallExpr(_, fun, _) => e = fun
      IndexExpr(_, x, _) => e = x
      TypeArgsExpr(_, x, _) => e = x
      TryExpr(_, x) => e = x
      _ => return (e, sel)
    }
  }
  (e, sel)
}

fn is_literal(e: parser.Expr) -> Bool {
  match e {
    ListLit(..) | MapLit(..) | SetLit(..) | StringLit(..) | IntLit(..) | FloatLit(..) | DurationLit(..) | RuneLit(..) | BytesLit(..) | StructLit(..) | TupleExpr(..) => true
    _ => false
  }
}

fn lit_text(e: parser.Expr) -> Str {
  match e {
    ListLit(_, elems) => if elems.is_empty() { "[]" } else { "[...]" }
    MapLit(_, entries) => if entries.is_empty() { "{}" } else { "{...}" }
    SetLit(..) => "#{...}"
    StringLit(s) => if s.parts.is_empty() { "\"\"" } else { "string literal" }
    IntLit(_, raw, _) => text_of(raw)
    FloatLit(_, raw) => text_of(raw)
    DurationLit(_, raw, _) => text_of(raw)
    _ => "literal"
  }
}

/// The error types of a program's own I/O whose loss XO0903 notes.
const IO_ERRS = ["FsErr", "NetErr", "ProcErr", "IoErr"]

/// The I/O error type of a Result type's text (`Result[T, FsErr]`), or "".
fn io_err_of(t: Str) -> Str {
  if !t.starts_with("Result[") {
    return ""
  }
  for e in IO_ERRS {
    if t.ends_with(", ${e}]") {
      return e
    }
  }
  ""
}

/// Whether the line of file f holding a finding, or the line above it,
/// says `xo:allow CODE <reason>`; the reason is required, as ignore_err's.
fn allowed(c: check.Checker, f: Int, line: Int, code: Str) -> Bool {
  let lines = (c.files[f].src.to_str() ?? "").split("\n")
  for l in [line - 1, line - 2] {
    if l < 0 || l >= lines.len() {
      continue
    }
    let tag = "xo:allow ${code} "
    if let Some(i) = lines[l].find(tag) {
      if !lines[l][i + tag.len()..].trim().is_empty() {
        return true
      }
    }
  }
  false
}

/// The note every XO0903 carries: the rewrite, and the allow comment for
/// a default that is right for every error.
fn io_note(e: Str) -> check.DNote {
  let missing = if e == "FsErr" { "`Err(NotFound(_)) => default` for a file that may be missing, " } else { "" }
  check.DNote{message: "match the result: ${missing}and return or report every other ${e}; when the default is right for every error (a hint, a cache miss that is rebuilt), say why with `// xo:allow XO0903 <reason>` on the line or the line above"}
}

/// XO0903: `r.ok() ?? default` on the result of a filesystem, process, or
/// network call: every error becomes the default, so a transient one (no
/// file descriptors or memory, EIO) gives a smaller or empty answer
/// instead of an error (a directory walk that drops a subtree, a hash of
/// a partial tree; the 2026-10-21 sweep).
fn io_default(c: check.Checker, f: Int, file: Str, span: parser.Span, x: parser.Expr) -> Diag? {
  let r = match x {
    CallExpr(_, fun, args) => {
      if !args.is_empty() {
        return None
      }
      match fun {
        SelectorExpr(_, r, sel) => {
          if sel.name != b"ok" {
            return None
          }
          r
        }
        _ => return None
      }
    }
    _ => return None
  }
  let e = io_err_of(c.type_text_in(f, r))
  if e.is_empty() || allowed(c, f, span.start.line, "XO0903") {
    return None
  }
  var d = vdiag("XO0903", false, file, span, "`.ok() ?? ...` turns every ${e} into the default: a transient error (no file descriptors or memory, EIO) gives a smaller or empty answer instead of an error")
  d.notes.push(io_note(e))
  Some(d)
}

/// Whether x is an empty value: `[]`, `{}`, `#{}`, `""`, `b""`, `None`,
/// `false`, or `0`.
fn empty_value(x: parser.Expr) -> Bool {
  match x {
    ListLit(_, elems) => elems.is_empty()
    MapLit(_, entries) => entries.is_empty()
    SetLit(_, elems) => elems.is_empty()
    StringLit(s) => s.parts.all(fn(p) { p.expr.is_none() && p.text.is_empty() })
    BytesLit(_, value) => value.is_empty()
    Ident(id) => id.name == b"None" || id.name == b"false"
    IntLit(_, _, value) => value == b"0"
    _ => false
  }
}

/// Whether p is `Err(_)` or `Err(e)`: every error.
fn every_err(p: parser.Pattern) -> Bool {
  match p {
    VariantPat(_, path, _, fields, _) => {
      if path.is_empty() || path[path.len() - 1].name != b"Err" || fields.len() != 1 {
        return false
      }
      match fields[0].pattern {
        WildcardPat(_) => true
        BindPat(_, _) => true
        _ => false
      }
    }
    _ => false
  }
}

/// Whether p names NotFound anywhere (`Err(NotFound(_))`).
fn names_not_found(p: parser.Pattern) -> Bool {
  match p {
    VariantPat(_, path, _, fields, _) => path.any(fn(i) { i.name == b"NotFound" }) || fields.any(fn(pf) { names_not_found(pf.pattern) })
    OrPat(_, alts) => alts.any(fn(a) { names_not_found(a) })
    _ => false
  }
}

/// XO0903 for a match on a filesystem, process, or network result whose
/// `Err(_)` arm is an empty value and no arm names NotFound.
fn io_match(c: check.Checker, f: Int, file: Str, subject: parser.Expr, arms: List[parser.MatchArm]) -> List[Diag] {
  let e = io_err_of(c.type_text_in(f, subject))
  if e.is_empty() || arms.any(fn(a) { names_not_found(a.pattern) }) {
    return []
  }
  var out: List[Diag] = []
  for a in arms {
    if !every_err(a.pattern) {
      continue
    }
    let empty = match a.body {
      Some(ExprStmt(_, x)) => empty_value(x)
      _ => false
    }
    if !empty || allowed(c, f, a.span.start.line, "XO0903") {
      continue
    }
    var d = vdiag("XO0903", false, file, a.span, "`Err(_) => <empty>` turns every ${e} into an empty value: a transient error (no file descriptors or memory, EIO) gives a smaller or empty answer instead of an error")
    d.notes.push(io_note(e))
    out.push(d)
  }
  out
}

/// XO0902 (decision 0281): `tls.Verify.None`, a TLS client that checks no
/// certificate (encryption without authentication).
fn verify_none(c: check.Checker, f: Int, file: Str, e: parser.Expr, span: parser.Span, sel: parser.Ident) -> Diag? {
  if sel.name != b"None" || c.type_text_in(f, e) != "tls.Verify" {
    return None
  }
  var d = vdiag("XO0902", false, file, span, "`tls.Verify.None` checks no certificate: the connection is encrypted but an active attacker can stand in for the server")
  d.notes.push(check.DNote{message: "`tls.Verify.ChainOnly` checks the chain without the host name (libpq's verify-ca); `roots: tls.roots(pem)` trusts a private CA with full checks (std.md 27)"})
  Some(d)
}

/// XO0912 (decision 0387): `uuid.Uuid`'s text read or built directly,
/// which the next minor's two Int representation removes. Not in std,
/// where std/uuid itself reads it.
fn uuid_text(c: check.Checker, m: Int, f: Int, file: Str, e: parser.Expr, span: parser.Span, sel: parser.Ident) -> Diag? {
  if sel.name != b"0" || c.mods[m].is_std {
    return None
  }
  let x = match e {
    SelectorExpr(_, x, _) => x
    _ => return None
  }
  if c.type_text_in(f, x) != "uuid.Uuid" {
    return None
  }
  Some(uuid_diag(file, span, "`.0` reads a `uuid.Uuid`'s text", "`u.display()` (or `\"\${u}\"`) for the text, `u < v` to order"))
}

/// XO0912 on `uuid.Uuid(s)`: a UUID built from a text that was never
/// parsed.
fn uuid_make(c: check.Checker, m: Int, f: Int, file: Str, call: parser.Expr, span: parser.Span, fun: parser.Expr) -> Diag? {
  if c.mods[m].is_std {
    return None
  }
  let name = match fun {
    Ident(id) => id.name
    SelectorExpr(_, _, sel) => sel.name
    _ => return None
  }
  if name != b"Uuid" || c.type_text_in(f, call) != "uuid.Uuid" {
    return None
  }
  Some(uuid_diag(file, span, "`uuid.Uuid(s)` builds a `uuid.Uuid` from its text", "`uuid.parse(s)?` checks the text and gives the canonical form"))
}

/// XO0912 on each pattern `uuid.Uuid(p)` in p.
fn uuid_pats(c: check.Checker, m: Int, f: Int, file: Str, p: parser.Pattern) -> List[Diag] {
  var out: List[Diag] = []
  if c.mods[m].is_std {
    return out
  }
  match p {
    VariantPat(span, _, _, fields, _) => {
      let o = c.pat_newtype_in(f, p)
      if o >= 0 && c.objs[o].name == b"Uuid" && c.mods[c.objs[o].module].is_std && c.mods[c.objs[o].module].path.ends_with("uuid") {
        out.push(uuid_diag(file, span, "the pattern `uuid.Uuid(p)` reads a `uuid.Uuid`'s text", "`u.display()` for the text"))
      }
      for x in fields {
        out = out + uuid_pats(c, m, f, file, x.pattern)
      }
    }
    OrPat(_, alts) => {
      for a in alts {
        out = out + uuid_pats(c, m, f, file, a)
      }
    }
    TuplePat(_, elems) => {
      for a in elems {
        out = out + uuid_pats(c, m, f, file, a)
      }
    }
    StructPat(_, _, fields, _) => {
      for x in fields {
        out = out + uuid_pats(c, m, f, file, x.pattern)
      }
    }
    ListPat(_, elems, _) => {
      for a in elems {
        out = out + uuid_pats(c, m, f, file, a)
      }
    }
    _ => {}
  }
  out
}

fn uuid_diag(file: Str, span: parser.Span, what: Str, fix: Str) -> Diag {
  var d = vdiag("XO0912", false, file, span, "${what}: deprecated, a `uuid.Uuid` becomes two Ints in the next minor release and its text is only `display()`")
  d.notes.push(check.DNote{message: "${fix} (std.md 24, decision 0387)"})
  d
}

/// XO0208 for `.ignore_err` and XO0901 for `dbg` calls.
fn vet_call(c: check.Checker, f: Int, file: Str, call: parser.Expr, span: parser.Span, fun: parser.Expr, args: List[parser.Arg]) -> Diag? {
  let ci = match c.call_in(f, call) {
    Some(x) => x
    None => return None
  }
  let fo = ci.fn_obj
  if fo < 0 || !c.mods[c.objs[fo].module].is_prelude {
    return None
  }
  let name = text_of(c.objs[fo].name)
  let recv = c.objs[fo].recv >= 0 || c.objs[fo].recv_ty >= 0
  if name == "ignore_err" && recv {
    var reason = "(not a literal)"
    if args.len() == 1 {
      match args[0].value {
        StringLit(s) => {
          if s.parts.len() <= 1 {
            reason = ""
            if s.parts.len() == 1 && s.parts[0].expr.is_none() {
              reason = text_of(s.parts[0].text)
            }
          }
        }
        _ => {}
      }
    }
    var what = "a Result"
    match fun {
      SelectorExpr(_, x, _) => {
        let t = c.type_text_in(f, x)
        if !t.is_empty() {
          what = "`${t}`"
        }
      }
      _ => {}
    }
    var d = vdiag("XO0208", true, file, span, "error of ${what} ignored: ${go_quote(reason)}")
    if reason.trim().is_empty() {
      d.notes.push(check.DNote{message: "the reason is empty; say why this failure does not matter (core 2.6)"})
    }
    return Some(d)
  }
  if name == "dbg" && !recv {
    var d = vdiag("XO0901", false, file, span, "`dbg(...)` left in code; `xo build --ci` rejects it (core 11.4)")
    if args.len() == 1 {
      let arg = parser.expr_span(args[0].value)
      d.fixes.push(check.DFix{title: "remove `dbg`, keep the expression", edits: [
        check.DEdit{span: check.JSpan{file: file, line: span.start.line, col: span.start.col, end_line: arg.start.line, end_col: arg.start.col}, replace: ""},
        check.DEdit{span: check.JSpan{file: file, line: arg.end.line, col: arg.end.col, end_line: span.end.line, end_col: span.end.col}, replace: ""},
      ]})
    }
    return Some(d)
  }
  None
}

/// The heap fields from which a value a task captures is large (XO0534):
/// a struct the size of the compiler's Checker, not an everyday config.
const TASK_CAPTURE_THRESHOLD = 32

/// XO0534 (decision 0294): the locals with at least TASK_CAPTURE_THRESHOLD
/// heap fields that the closure passed to `Scope.spawn` or
/// `spawn_background` in call captures. A capture copies the value
/// (core 5.1): it shares each heap field when the task starts and releases
/// it when the task ends, and a collection in it that the task changes is
/// copied first while the spawner still holds it.
fn task_captures(c: check.Checker, f: Int, file: Str, call: parser.Expr, args: List[parser.Arg]) -> List[Diag] {
  let ci = match c.call_in(f, call) {
    Some(x) => x
    None => return []
  }
  let fo = ci.fn_obj
  if fo < 0 || !c.mods[c.objs[fo].module].is_prelude || !(text_of(c.objs[fo].name) is "spawn" | "spawn_background") || args.len() != 1 {
    return []
  }
  let fl = match args[0].value {
    FnLit(x) => x
    _ => return []
  }
  var nodes: List[parser.Expr] = []
  walk_block(fl.body, nodes)
  let start = fl.span.start
  var seen: Map[Int, Bool] = {}
  var out: List[Diag] = []
  for e in nodes {
    if let Ident(id) = e {
      let v = c.var_of(f, id)
      if v < 0 || seen.contains(v) {
        continue
      }
      let o = c.objs[v]
      if o.line > start.line || (o.line == start.line && o.col >= start.col) {
        continue
      }
      seen[v] = true
      let t = c.type_in(f, e)
      let n = heap_fields(c, t, 0)
      if t < 0 || n < TASK_CAPTURE_THRESHOLD {
        continue
      }
      let name = check.text(id.name)
      var d = vdiag("XO0534", true, file, id.span, "the task captures `${name}` by value: spawning shares the ${n} heap fields of `${c.show(t)}` and the task's end releases them, and a collection in it that the task changes is copied first (core 5.1)")
      d.notes.push(check.DNote{message: "capture only what the task uses (`let part = ${name}.field` before the spawn)"})
      out.push(d)
    }
  }
  out
}

/// XO1103: the Go packages module m imports with `use go` and the
/// functions that perform `go`, one note per module.
fn go_report(c: check.Checker, m: Int) -> Diag? {
  var gouses: List[(Str, Str, parser.Span)] = []
  var seen: List[Str] = []
  for f in c.mods[m].files {
    for u in c.files[f].ast.imports {
      let p = text_of(u.path)
      if u.go && !seen.contains(p) {
        seen.push(p)
        gouses.push((p, c.files[f].path, u.span))
      }
    }
  }
  var fns: List[(Str, Str, parser.Span)] = []
  for fo in c.funcs_of(m) {
    for (eff, is_param) in c.performed_of(fo) {
      if eff == "go" && !is_param && !c.objs[fo].fn_decl.is_empty() {
        fns.push((c.display_name(fo), c.objs[fo].file, c.objs[fo].fn_decl[0].name.span))
      }
    }
  }
  if gouses.is_empty() && fns.is_empty() {
    return None
  }
  var pkgs: List[Str] = []
  for (p, _, _) in gouses {
    pkgs.push(p)
  }
  pkgs = pkgs.sort()
  let (_, file, sp) = if !gouses.is_empty() { gouses[0] } else { fns[0] }
  var names: List[Str] = []
  for (n, _, _) in fns {
    names.push(n)
  }
  var d = vdiag("XO1103", true, file, sp, "module `${c.mods[m].path}` uses Go packages [${pkgs.join(", ")}]; ${fns.len()} function(s) perform `go`: [${names.join(", ")}]")
  for (p, ufile, usp) in gouses {
    d.notes.push(check.DNote{message: "use go ${go_quote(p)}", span: Some(jspan(ufile, usp))})
  }
  for (n, ffile, fsp) in fns {
    d.notes.push(check.DNote{message: "`${n}` performs `go`", span: Some(jspan(ffile, fsp))})
  }
  Some(d)
}

fn text_of(b: Bytes) -> Str {
  b.to_str() ?? ""
}

// ---------------------------------------------------------------------------
// Walking the syntax tree: every expression, outer before inner
// (check.Inspect order for what vet looks at).

fn walk_decl(d: parser.Decl, var out: List[parser.Expr]) {
  match d {
    FnDecl(fd) => walk_fn(fd, out)
    StructDecl(sd) => {
      for f in sd.fields {
        if let Some(x) = f.default {
          walk_expr(x, out)
        }
      }
      if let Some(x) = sd.inv {
        walk_expr(x, out)
      }
    }
    InterfaceDecl(id) => {
      for m in id.methods {
        walk_fn(m, out)
      }
    }
    ConstDecl(cd) => walk_expr(cd.value, out)
    TestDecl(td) => {
      for p in td.params {
        if let Some(x) = p.default {
          walk_expr(x, out)
        }
      }
      if let Some(b) = td.body {
        walk_block(b, out)
      }
    }
    _ => {}
  }
}

fn walk_fn(fd: parser.FnDecl, var out: List[parser.Expr]) {
  for p in fd.params {
    if let Some(x) = p.default {
      walk_expr(x, out)
    }
  }
  for cl in fd.clauses {
    match cl {
      RequiresClause(_, _, cond, els) => {
        walk_expr(cond, out)
        if let Some(x) = els {
          walk_expr(x, out)
        }
      }
      EnsuresClause(_, _, cond) => walk_expr(cond, out)
      _ => {}
    }
  }
  if let Some(b) = fd.body {
    walk_block(b, out)
  }
}

fn walk_block(b: parser.Block, var out: List[parser.Expr]) {
  // the block itself, for the checks over its statements (copy_store)
  out.push(parser.Expr.Block(b: b))
  for s in b.stmts {
    walk_stmt(s, out)
  }
}

fn walk_stmt(s: parser.Stmt, var out: List[parser.Expr]) {
  match s {
    LetStmt(_, pat, _, value, _) => {
      walk_pat(pat, out)
      walk_expr(value, out)
    }
    VarStmt(_, _, _, value) => walk_expr(value, out)
    AssignStmt(_, _, target, value) => {
      walk_expr(target, out)
      walk_expr(value, out)
    }
    DeferStmt(_, body) => walk_stmt(body, out)
    ReturnStmt(_, value) => {
      if let Some(x) = value {
        walk_expr(x, out)
      }
    }
    ForStmt(_, _, pat, iter, bound, body, _) => {
      walk_pat(pat, out)
      walk_expr(iter, out)
      for x in bound {
        walk_expr(x, out)
      }
      walk_block(body, out)
    }
    WhileStmt(_, _, cond, pats, values, bound, body) => {
      if let Some(x) = cond {
        walk_expr(x, out)
      }
      for p in pats {
        walk_pat(p, out)
      }
      for x in values {
        walk_expr(x, out)
      }
      for x in bound {
        walk_expr(x, out)
      }
      walk_block(body, out)
    }
    ExprStmt(_, x) => walk_expr(x, out)
    ConstDecl(cd) => walk_expr(cd.value, out)
    _ => {}
  }
}

fn walk_pat(p: parser.Pattern, var out: List[parser.Expr]) {
  match p {
    LitPat(_, value) => walk_expr(value, out)
    RangePat(_, lo, hi, _) => {
      walk_expr(lo, out)
      walk_expr(hi, out)
    }
    OrPat(_, alts) => {
      for a in alts {
        walk_pat(a, out)
      }
    }
    TuplePat(_, elems) => {
      for a in elems {
        walk_pat(a, out)
      }
    }
    VariantPat(_, _, _, fields, _) => {
      for f in fields {
        walk_pat(f.pattern, out)
      }
    }
    StructPat(_, _, fields, _) => {
      for f in fields {
        walk_pat(f.pattern, out)
      }
    }
    ListPat(_, elems, _) => {
      for a in elems {
        walk_pat(a, out)
      }
    }
    _ => {}
  }
}

fn walk_expr(e: parser.Expr, var out: List[parser.Expr]) {
  match e {
    Ident(_) => out.push(e)
    BinaryExpr(_, _, x, y) => {
      out.push(e)
      walk_expr(x, out)
      walk_expr(y, out)
    }
    CallExpr(_, fun, args) => {
      out.push(e)
      walk_expr(fun, out)
      for a in args {
        walk_expr(a.value, out)
      }
    }
    StringLit(s) => {
      out.push(e)
      for p in s.parts {
        if let Some(x) = p.expr {
          walk_expr(x, out)
        }
      }
    }
    ParenExpr(_, x) => walk_expr(x, out)
    TupleExpr(_, elems) => {
      for x in elems {
        walk_expr(x, out)
      }
    }
    ListLit(_, elems) => {
      out.push(e)
      for x in elems {
        walk_expr(x, out)
      }
    }
    SetLit(_, elems) => {
      for x in elems {
        walk_expr(x, out)
      }
    }
    MapLit(_, entries) => {
      out.push(e)
      for en in entries {
        walk_expr(en.key, out)
        walk_expr(en.value, out)
      }
    }
    StructLit(_, typ, fields) => {
      out.push(e)
      walk_expr(typ, out)
      for f in fields {
        walk_expr(f.value, out)
      }
    }
    UnaryExpr(_, _, x) => walk_expr(x, out)
    IsExpr(_, x, pat) => {
      walk_expr(x, out)
      walk_pat(pat, out)
    }
    RangeExpr(_, lo, hi, _) => {
      if let Some(x) = lo {
        walk_expr(x, out)
      }
      if let Some(x) = hi {
        walk_expr(x, out)
      }
    }
    SelectorExpr(_, x, _) => {
      // XO0902 reads the selector itself
      out.push(e)
      walk_expr(x, out)
    }
    TypeArgsExpr(_, x, _) => walk_expr(x, out)
    IndexExpr(_, x, index) => {
      walk_expr(x, out)
      walk_expr(index, out)
    }
    TryExpr(_, x) => walk_expr(x, out)
    WithExpr(_, x, fields) => {
      walk_expr(x, out)
      for f in fields {
        walk_expr(f.value, out)
      }
    }
    IfExpr(ie) => {
      out.push(e)
      walk_if(ie, out)
    }
    MatchExpr(_, subject, arms) => {
      out.push(e)
      walk_expr(subject, out)
      for a in arms {
        walk_pat(a.pattern, out)
        if let Some(g) = a.guard {
          walk_expr(g, out)
        }
        if let Some(b) = a.body {
          walk_stmt(b, out)
        }
      }
    }
    ScopeExpr(_, _, body) => walk_block(body, out)
    SelectExpr(_, arms) => {
      for a in arms {
        if let Some(x) = a.op {
          walk_expr(x, out)
        }
        if let Some(x) = a.after {
          walk_expr(x, out)
        }
        if let Some(b) = a.body {
          walk_stmt(b, out)
        }
      }
    }
    Block(b) => walk_block(b, out)
    FnLit(fl) => {
      for p in fl.params {
        if let Some(x) = p.default {
          walk_expr(x, out)
        }
      }
      walk_block(fl.body, out)
    }
    WhileExpr(_, body) => walk_block(body, out)
    _ => {}
  }
}

fn walk_if(ie: parser.IfExpr, var out: List[parser.Expr]) {
  if let Some(x) = ie.cond {
    walk_expr(x, out)
  }
  if let Some(p) = ie.pattern {
    walk_pat(p, out)
  }
  if let Some(x) = ie.value {
    walk_expr(x, out)
  }
  walk_block(ie.then, out)
  if let Some(x) = ie.els {
    walk_expr(x, out)
  }
}

// XO0531 (decision 0263): a parameter of a type with at least
// COPY_THRESHOLD heap fields whose every use stores it (a struct
// literal's field, a list or map literal's element, rt.any_of, a push,
// put, or insert), while every caller passes a local it does not use
// after the call. The parameter is borrowed, so storing it shares each
// heap field, and the caller then drops its own copy: moving the store to
// the caller's last use (or returning the value) does neither.

/// The local the identifier e of file f refers to, or -1.
fn local_of(c: check.Checker, f: Int, e: parser.Expr) -> Int {
  match e {
    Ident(id) => c.var_of(f, id)
    ParenExpr(_, x) => local_of(c, f, x)
    _ => -1
  }
}

/// Whether call (a CallExpr) consumes its arguments: rt.any_of, or a
/// method that stores its argument (push, put, insert).
fn storing_call(fun: parser.Expr) -> Bool {
  match fun {
    SelectorExpr(_, x, sel) => {
      let name = check.text(sel.name)
      if name is "push" | "put" | "insert" | "push_front" | "set" {
        return true
      }
      if name == "any_of" {
        if let Ident(id) = x {
          return check.text(id.name) == "rt"
        }
      }
      false
    }
    _ => false
  }
}

/// The locals nodes store (a direct operand of a storing position).
fn stored_locals(c: check.Checker, f: Int, nodes: List[parser.Expr]) -> Map[Int, Int] {
  var out: Map[Int, Int] = {}
  for e in nodes {
    match e {
      StructLit(_, _, fields) => {
        for fl in fields {
          note_local(c, f, out, fl.value)
        }
      }
      ListLit(_, elems) => {
        for x in elems {
          note_local(c, f, out, x)
        }
      }
      MapLit(_, entries) => {
        for en in entries {
          note_local(c, f, out, en.value)
        }
      }
      CallExpr(_, fun, args) => {
        if storing_call(fun) {
          for a in args {
            note_local(c, f, out, a.value)
          }
        }
      }
      _ => {}
    }
  }
  out
}

fn note_local(c: check.Checker, f: Int, var m: Map[Int, Int], x: parser.Expr) {
  let v = local_of(c, f, x)
  if v >= 0 {
    m[v] = (m.get(v) ?? 0) + 1
  }
}

/// How many times nodes name each local.
fn local_uses(c: check.Checker, f: Int, nodes: List[parser.Expr]) -> Map[Int, Int] {
  var out: Map[Int, Int] = {}
  for e in nodes {
    if let Ident(id) = e {
      let v = c.var_of(f, id)
      if v >= 0 {
        out[v] = (out.get(v) ?? 0) + 1
      }
    }
  }
  out
}

/// A call's site: its file, the call's end, and the nodes of the
/// declaration it is in.
struct CallSite {
  f: Int
  end: Int
  args: List[check.ArgParam]
  nodes: List[parser.Expr]
}

fn store_only_params(c: check.Checker, m: Int) -> List[Diag] {
  var out: List[Diag] = []
  // the calls of the root modules, by callee
  var calls: Map[Int, List[CallSite]] = {}
  for rm in c.root_mods {
    for f in c.mods[rm].files {
      for d in c.files[f].ast.decls {
        var nodes: List[parser.Expr] = []
        walk_decl(d, nodes)
        for e in nodes {
          if let CallExpr(sp, _, _) = e {
            if let Some(ci) = c.call_in(f, e) {
              if ci.fn_obj >= 0 {
                var l = calls.get(ci.fn_obj) ?? []
                l.push(CallSite{f: f, end: sp.end.offset, args: ci.params, nodes: nodes})
                calls[ci.fn_obj] = l
              }
            }
          }
        }
      }
    }
  }
  for f in c.mods[m].files {
    for (i, d) in c.files[f].ast.decls.indexed() {
      let fd = match d {
        FnDecl(fd) => fd
        _ => continue
      }
      let fo = if i < c.files[f].decl_objs.len() { c.files[f].decl_objs[i] } else { -1 }
      if fo < 0 || fd.body.is_none() {
        continue
      }
      let sites = calls.get(fo) ?? []
      if sites.is_empty() {
        continue
      }
      var nodes: List[parser.Expr] = []
      walk_fn(fd, nodes)
      let stored = stored_locals(c, f, nodes)
      let named = local_uses(c, f, nodes)
      for (k, p) in fd.params.indexed() {
        if p.is_var || p.is_self || k >= c.objs[fo].params.len() {
          continue
        }
        // a parameter's local (the checker records parameters there, not
        // by their name's position)
        let pv = c.param_vars.get(fo) ?? []
        let v = if k < pv.len() { pv[k] } else { -1 }
        let st = stored.get(v) ?? 0
        if v < 0 || st == 0 || st != (named.get(v) ?? 0) {
          continue
        }
        let t = c.objs[fo].params[k].ty
        let n = heap_fields(c, t, 0)
        if n < COPY_THRESHOLD {
          continue
        }
        // every caller passes a local it does not name after the call
        var all_last = true
        for s in sites {
          if k >= s.args.len() {
            all_last = false
            break
          }
          let a = local_of(c, s.f, s.args[k].arg)
          if a < 0 {
            all_last = false
            break
          }
          for e in s.nodes {
            if let Ident(id) = e {
              if id.span.start.offset >= s.end && c.var_of(s.f, id) == a {
                all_last = false
              }
            }
          }
          if !all_last {
            break
          }
        }
        if !all_last {
          continue
        }
        let name = check.text(p.name.name)
        var dg = vdiag("XO0531", false, c.files[f].path, p.name.span, "`${name}` is borrowed, so storing it shares the ${n} heap fields of `${c.show(t)}`, and each caller drops its own copy after the call")
        dg.notes.push(check.DNote{message: "store the value at the caller's last use, or return it from here, so it moves instead (decision 0263)"})
        out.push(dg)
      }
    }
  }
  out
}

/// XO0535 (decision 0296): each `${x.debug()}` in s, whose shorter form
/// is `${x:?}`, with the fix. Only the prelude's Debug: a type's own
/// `debug` method is left alone.
fn debug_interps(c: check.Checker, f: Int, file: Str, s: parser.StringLit) -> List[Diag] {
  var out: List[Diag] = []
  for p in s.parts {
    if p.debug {
      continue
    }
    let call = match p.expr {
      Some(x) => x
      None => continue
    }
    if let CallExpr(span, fun, args) = call {
      if !args.is_empty() {
        continue
      }
      if let SelectorExpr(_, x, sel) = fun {
        if check.text(sel.name) != "debug" {
          continue
        }
        if let Some(ci) = c.call_in(f, call) {
          if ci.fn_obj >= 0 && !c.mods[c.objs[ci.fn_obj].module].is_prelude {
            continue
          }
        }
        let xe = parser.expr_span(x).end
        var d = vdiag("XO0535", true, file, span, "`.debug()` in an interpolation is `:?`: `\${x:?}` writes the Debug text (core 1.6)")
        d.fixes.push(check.DFix{title: "write `:?`", edits: [check.DEdit{span: check.JSpan{file: file, line: xe.line, col: xe.col, end_line: span.end.line, end_col: span.end.col}, replace: ":?"}]})
        out.push(d)
      }
    }
  }
  out
}

/// XO0906 (decision 0321): `match x { Some(v) => v  None => return r }`
/// (or `continue`, `break`), which `x ?? return r` writes in one line, and
/// on a Result `match r { Ok(v) => v  Err(e) => return w }`, which
/// `r ?? e => return w` writes in one line (`Err(_)` gives `_ =>`).
fn match_exit(c: check.Checker, f: Int, file: Str, span: parser.Span, subject: parser.Expr, arms: List[parser.MatchArm]) -> Diag? {
  if arms.len() != 2 {
    return None
  }
  // the match the parser makes of `r ?? e => body` is already the short
  // form (field report 0.26.0, b07: vet offered to rewrite it into itself)
  if arms[1].coalesce {
    return None
  }
  var exit_text = ""
  var unwrap = ""
  var leave = ""
  // the Err arm's binding, or `_`
  var err_name = ""
  for a in arms {
    if a.guard != None {
      return None
    }
    let body = match a.body {
      Some(b) => b
      None => return None
    }
    match a.pattern {
      VariantPat(_, path, parens, fields, _) => {
        if path.len() != 1 {
          return None
        }
        let n = text_of(path[0].name)
        if (n == "Some" || n == "Ok") && parens && fields.len() == 1 {
          // Some(v) => v, Ok(v) => v
          if let BindPat(_, b) = fields[0].pattern {
            if let ExprStmt(_, bx) = body {
              if let Ident(id) = bx {
                if id.name == b.name {
                  unwrap = n
                  continue
                }
              }
            }
          }
          return None
        }
        let none = n == "None" && !parens
        let err = n == "Err" && parens && fields.len() == 1
        if !none && !err {
          return None
        }
        if err {
          match fields[0].pattern {
            BindPat(_, b) => err_name = text_of(b.name)
            WildcardPat(..) => err_name = "_"
            _ => return None
          }
        }
        exit_text = exit_of(c, f, body)
        if exit_text.is_empty() {
          return None
        }
        leave = n
        continue
      }
      _ => return None
    }
  }
  if exit_text.is_empty() {
    return None
  }
  var short = ""
  var what = ""
  if unwrap == "Some" && leave == "None" {
    short = "${src_text(c, f, parser.expr_span(subject))} ?? ${exit_text}"
    what = "Option"
  } else if unwrap == "Ok" && leave == "Err" && c.type_text_in(f, subject).starts_with("Result[") {
    short = "${src_text(c, f, parser.expr_span(subject))} ?? ${err_name} => ${exit_text}"
    what = "Result"
  } else {
    return None
  }
  var d = vdiag("XO0906", true, file, span, "this `match` only unwraps the ${what} or leaves: `${short}` says the same in one line (decision 0321)")
  d.fixes.push(check.DFix{title: "write it with `??`", edits: [check.DEdit{span: jspan(file, span), replace: short}]})
  Some(d)
}

/// The text of an arm body that only leaves (`return`, `break`, or
/// `continue`, alone or as a block's one statement), or "".
fn exit_of(c: check.Checker, f: Int, body: parser.Stmt) -> Str {
  var st = body
  if let ExprStmt(_, bx) = body {
    if let Block(b) = bx {
      if b.stmts.len() == 1 {
        st = b.stmts[0]
      }
    }
  }
  match st {
    ReturnStmt(..) | BreakStmt(..) | ContinueStmt(..) => src_text(c, f, stmt_span(st))
    _ => ""
  }
}
