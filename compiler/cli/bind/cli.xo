// `xo bind` (cmd/xo bind.go, decision 0178 stage 6): `--c` binds C
// headers with the binder in this package; Go packages are bound by the
// helper xo-gobind (cmd/xo-gobind), which stays Go because it reads Go's
// export data, so the self hosted `xo` execs it with the same flags and
// passes its output and status through. compiler/check uses the same
// helpers to bind a `use go` package or a `use c` header missing from
// the binding cache (check_dirs_bound).

use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/hostpath
use std/crypto

/// Runs `xo bind <args>` (args[0] is "bind") and returns the exit status,
/// with the std directory $XO_STD, else "std" in the working directory
/// (run_std with the std the program found).
pub fn run(os: Os, args: List[Str]) -> Int uses (fs, proc, env, stdio) {
  let std = os.env.get("XO_STD") ?? ""
  run_std(os, args, if std.is_empty() { "std" } else { std })
}

/// run with the std directory std_dir, whose parent is where
/// gobind_helper looks for xo-gobind or its sources. xo passes the std
/// it found beside its binary (check.std_dir): with "std" in the working
/// directory, `xo bind` outside the repository found no helper and no
/// sources to build it from (gotchas/xo-bind-std-from-wd.md).
pub fn run_std(os: Os, args: List[Str], std_dir: Str) -> Int uses (fs, proc, env, stdio) {
  var fl = Flags{}
  fl.def("c", "bool", "", "bind C headers for `use c` (native builds, decision 0116) instead of Go packages")
  fl.def("dir", "str", ".", "a directory of the Xo project (its xo.mod root holds the cache)")
  fl.def("json", "bool", "", "print the coverage of each package as JSON")
  fl.def("link", "list", "", "with --c: a `link` library or file (repeatable)")
  fl.def("uses", "str", "", "with --c: the effects of the `use c` line (`none`, or labels separated by commas); default ffi")
  if !fl.parse(os, if args.is_empty() { [] } else { args[1..] }) {
    return 2
  }
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  let dir = fl.get("dir")
  let as_json = fl.get("json") == "true"
  if fl.get("c") == "true" {
    return run_bind_c(os, wd, fl.args, dir, fl.lists.get("link") ?? [], fl.get("uses"), as_json)
  }
  if fl.args.is_empty() {
    os.stdio.eprintln("xo bind: no Go import paths given")
    return 2
  }
  let (helper, temp) = match gobind_helper(os, std_dir, wd) {
    Ok(h) => h
    Err(e) => {
      os.stdio.eprintln("xo bind: ${e}")
      return 2
    }
  }
  var hargs = ["--dir", dir]
  if as_json {
    hargs.push("--json")
  }
  for a in fl.args {
    hargs.push(a)
  }
  let r = os.proc.cmd(helper, hargs).inherit().run()
  if temp {
    os.fs.remove(helper).ok()
  }
  match r {
    Ok(code) => code
    Err(e) => {
      os.stdio.eprintln("xo bind: ${helper}: ${e}")
      2
    }
  }
}

/// projectRoot: the directory of the nearest xo.mod at or above dir, or
/// dir itself (absolute).
pub fn project_root(os: Os, wd: Str, dir: Str) -> Str uses fs.read {
  let abs = if wd.is_empty() { clean(dir) } else { hostpath.abs(wd, dir) }
  var d = abs
  while true {
    if is_file(os, join(d, "xo.mod")) {
      return d
    }
    let p = dir_of(d)
    if p == d {
      return abs
    }
    d = p
  }
  abs
}

/// runBindC: `xo bind --c` binds C headers (relative to dir, or on the
/// include path) into the binding cache of the project that contains
/// dir.
fn run_bind_c(os: Os, wd: Str, headers: List[Str], dir: Str, links: List[Str], use_effs: Str, as_json: Bool) -> Int uses (fs, proc, env, stdio) {
  if headers.is_empty() {
    os.stdio.eprintln("xo bind --c: no C headers given")
    return 2
  }
  let root = project_root(os, wd, dir)
  var effs: List[Str]? = None
  if !use_effs.is_empty() {
    var es: List[Str] = []
    if use_effs != "none" {
      for e in use_effs.split(",") {
        es.push(e.trim())
      }
    }
    effs = Some(es)
  }
  var status = 0
  var results: List[Str] = []
  for h in headers {
    match bind_c(os, Options{header: h, mod_dir: dir, links: links, effects: effs, dir: cache_dir(os, root), wd: wd}) {
      Err(msg) => {
        let e = error_text(h, msg)
        status = 1
        results.push(result_json(h, None, e))
        if !as_json {
          os.stdio.eprintln("xo bind --c: ${e}")
        }
      }
      Ok(b) => {
        results.push(result_json(h, Some(b), ""))
        if !as_json {
          os.stdio.print("${h} (${b.header_path}): functions ${b.bound}/${b.total} bound, ${b.skipped.len()} skipped\n")
          os.stdio.print("  wrote ${b.decl_path}\n")
        }
      }
    }
  }
  if as_json {
    var sb = StrBuilder.new()
    sb.write("[")
    for (i, r) in results.indexed() {
      if i > 0 {
        sb.write(",")
      }
      sb.write("\n  ")
      sb.write(r)
    }
    sb.write("\n]\n")
    os.stdio.print(sb.freeze())
  }
  status
}

/// One cBindResult as json.Encoder writes it at depth 1 of the array.
fn result_json(header: Str, b: Binding?, err: Str) -> Str {
  var ms: List[Str] = ["\"header\": ${json_quote(header)}"]
  match b {
    Some(x) => {
      ms.push("\"path\": ${json_quote(x.header_path)}")
      ms.push("\"decl\": ${json_quote(x.decl_path)}")
      ms.push("\"bound\": ${x.bound}")
      ms.push("\"total\": ${x.total}")
      if !x.skipped.is_empty() {
        var ks: List[Str] = []
        for k in sorted_keys(x.skipped) {
          ks.push("      ${json_quote(k)}: ${json_quote(x.skipped.get(k) ?? "")}")
        }
        ms.push("\"skipped\": {\n${ks.join(",\n")}\n    }")
      }
    }
    None => {
      ms.push("\"bound\": 0")
      ms.push("\"total\": 0")
    }
  }
  if !err.is_empty() {
    ms.push("\"error\": ${json_quote(err)}")
  }
  "{\n    ${ms.join(",\n    ")}\n  }"
}

// ---------------------------------------------------------------------------
// Flags (Go's flag package with ContinueOnError, as cmd/xo's FlagSet)

struct FlagDef {
  name: Str
  /// "bool", "str", or "list" (a repeatable string)
  kind: Str
  def: Str
  usage: Str
}

struct Flags {
  defs: List[FlagDef] = []
  vals: Map[Str, Str] = {}
  lists: Map[Str, List[Str]] = {}
  args: List[Str] = []
}

fn (var f: Flags) def(name: Str, kind: Str, def: Str, usage: Str) {
  f.defs.push(FlagDef{name: name, kind: kind, def: def, usage: usage})
  f.vals[name] = if kind == "bool" { "false" } else { def }
}

fn (f: Flags) get(name: Str) -> Str {
  f.vals.get(name) ?? ""
}

fn (var f: Flags) parse(os: Os, args: List[Str]) -> Bool uses stdio {
  var i = 0
  while i < args.len() {
    let s = args[i]
    if s.len() < 2 || !s.starts_with("-") {
      break
    }
    var minuses = 1
    if s.starts_with("--") {
      minuses = 2
      if s.len() == 2 {
        i += 1
        break
      }
    }
    var name = s[minuses..s.len()]
    if name.is_empty() || name.starts_with("-") || name.starts_with("=") {
      return f.fail(os, "bad flag syntax: ${s}")
    }
    i += 1
    var has_value = false
    var value = ""
    if let Some(eq) = name.find("=") {
      if eq >= 1 {
        value = name[eq + 1..name.len()]
        name = name[0..eq]
        has_value = true
      }
    }
    var def = FlagDef{name: "", kind: "", def: "", usage: ""}
    var found = false
    for d in f.defs {
      if d.name == name {
        def = d
        found = true
      }
    }
    if !found {
      if name == "help" || name == "h" {
        f.usage(os)
        return false
      }
      return f.fail(os, "flag provided but not defined: -${name}")
    }
    if def.kind == "bool" {
      if has_value {
        if value is "1" | "t" | "T" | "TRUE" | "true" | "True" {
          f.vals[name] = "true"
        } else if value is "0" | "f" | "F" | "FALSE" | "false" | "False" {
          f.vals[name] = "false"
        } else {
          return f.fail(os, "invalid boolean value ${go_quote(value)} for -${name}: parse error")
        }
      } else {
        f.vals[name] = "true"
      }
      continue
    }
    if !has_value && i < args.len() {
      has_value = true
      value = args[i]
      i += 1
    }
    if !has_value {
      return f.fail(os, "flag needs an argument: -${name}")
    }
    if def.kind == "list" {
      var l = f.lists.get(name) ?? []
      l.push(value)
      f.lists[name] = l
    } else {
      f.vals[name] = value
    }
  }
  var rest: List[Str] = []
  while i < args.len() {
    rest.push(args[i])
    i += 1
  }
  f.args = rest
  true
}

fn (f: Flags) fail(os: Os, msg: Str) -> Bool uses stdio {
  os.stdio.eprintln(msg)
  f.usage(os)
  false
}

/// `Usage of bind:` and the flags (flag.PrintDefaults).
fn (f: Flags) usage(os: Os) uses stdio {
  let u = cmdhelp.usage("bind")
  if !u.is_empty() {
    // the command's usage (compiler/cli/cmdhelp)
    os.stdio.eprint(u)
    return
  }
  var b = StrBuilder.new()
  b.write("Usage of bind:\n")
  for d in f.defs.sort_by(fn(d: FlagDef) -> Str { d.name }) {
    var line = "  -${d.name}"
    var arg = if d.kind == "bool" { "" } else if d.kind == "list" { "value" } else { "string" }
    var usage = d.usage
    let parts = d.usage.split("`")
    if parts.len() >= 3 {
      arg = parts[1]
      usage = "${parts[0]}${parts[1]}${parts[2..].join("`")}"
    }
    if !arg.is_empty() {
      line = "${line} ${arg}"
    }
    if line.len() <= 4 {
      line = "${line}\t"
    } else {
      line = "${line}\n    \t"
    }
    line = line + usage.replace("\n", "\n    \t")
    if d.kind == "str" && !d.def.is_empty() {
      line = "${line} (default ${go_quote(d.def)})"
    }
    b.write(line)
    b.write("\n")
  }
  os.stdio.eprint(b.freeze())
}

// ---------------------------------------------------------------------------
// The Go binder: the helper xo-gobind

/// The helper that binds Go packages, xo-gobind (cmd/xo-gobind, decision
/// 0178 stage 6), and whether it is a temporary build to remove after
/// use: $XO_GOBIND; else xo-gobind beside this program, in the bin directory of a release
/// layout (<prefix>/bin beside <prefix>/lib/xo/std), beside the std
/// directory, or on $PATH; else built with `go build` ($XO_GO, else go)
/// from the repository holding the std directory, into a temporary file.
pub fn gobind_helper(os: Os, std_dir: Str, wd: Str) -> (Str, Bool) ! Str uses (fs, proc, env) {
  let named = os.env.get("XO_GOBIND") ?? ""
  if !named.is_empty() {
    return Ok((named, false))
  }
  // beside this program (a release ships them together), then the std
  // directory's repository or release layout; a prebuilt helper older
  // than the installed Go is rebuilt with it (decision 0393)
  let win = hostpath.windows()
  let up = hostpath.dir_w(if wd.is_empty() { std_dir } else { hostpath.abs_w(wd, std_dir, win) }, win)
  for cand in gobind_candidates_w(os.env.program(), std_dir, wd, win) {
    if is_file(os, cand) {
      return Ok((helper_for_go(os, cand, up)?, false))
    }
  }
  let on_path = look_path(os, "xo-gobind${if win { ".exe" } else { "" }}")
  if !on_path.is_empty() {
    return Ok((on_path, false))
  }
  if !is_file(os, join(up, "cmd/xo-gobind/main.go")) {
    return Err("xo-gobind not found: set XO_GOBIND, put xo-gobind on PATH or beside xo, or build it with `go build github.com/xo-lang/xo/cmd/xo-gobind`")
  }
  let tmp = match os.fs.create_temp(hostpath.temp_dir(os.env), "xo-gobind-") {
    Ok(t) => t
    Err(e) => return Err("building xo-gobind: ${e}")
  }
  var go = os.env.get("XO_GO") ?? ""
  if go.is_empty() {
    go = "go"
  }
  match os.proc.cmd(go, ["build", "-o", tmp, "./cmd/xo-gobind"]).dir(up).output() {
    Ok(o) => {
      if o.code != 0 {
        os.fs.remove(tmp).ok()
        return Err("building xo-gobind: ${(o.stderr.to_str() ?? "").trim()}")
      }
    }
    Err(e) => {
      os.fs.remove(tmp).ok()
      return Err("building xo-gobind: ${e}")
    }
  }
  Ok((tmp, true))
}

/// The paths gobind_helper tries for xo-gobind, in order, by the host's
/// path rules (win: Windows', testable on any host): beside the program
/// prog when its path names a directory, then up from the std directory
/// std_dir (against wd when relative): a release's bin/, the repository.
/// (Windows tester, 0.33.0, bug 13: the name had no .exe, and only a
/// program or std path holding `/`, or starting with it, counted.)
pub fn gobind_candidates_w(prog0: Str, std_dir: Str, wd: Str, win: Bool) -> List[Str] {
  let name = "xo-gobind${if win { ".exe" } else { "" }}"
  let prog = if win { prog0.replace("\\", "/") } else { prog0 }
  var out: List[Str] = []
  if prog.contains("/") {
    out.push(hostpath.join_w(hostpath.dir_w(prog, win), name, win))
  }
  let std = if wd.is_empty() { std_dir } else { hostpath.abs_w(wd, std_dir, win) }
  let up = hostpath.dir_w(std, win)
  for rel in ["../../bin/${name}", name, "bin/${name}"] {
    out.push(hostpath.join_w(up, rel, win))
  }
  out
}

/// The go command xo-gobind runs: $XO_GO, else go.
fn go_command(os: Os) -> Str uses env {
  let g = os.env.get("XO_GO") ?? ""
  if g.is_empty() { "go" } else { g }
}

/// The trimmed standard output of go with args, or "" when it fails.
fn go_output(os: Os, go: Str, args: List[Str]) -> Str uses proc {
  match os.proc.cmd(go, args).output() {
    Ok(o) => if o.code == 0 { (o.stdout.to_str() ?? "").trim() } else { "" }
    Err(_) => ""
  }
}

/// The language version (major, minor) of a Go version text
/// ("go1.27.0", "go1.27rc1", "devel go1.28-abc ..."), or (0, 0).
fn go_lang(v0: Str) -> (Int, Int) {
  var v = v0.trim()
  if v.starts_with("devel ") {
    v = v[6..]
  }
  if !v.starts_with("go") {
    return (0, 0)
  }
  let parts = v[2..].split(".")
  if parts.len() < 2 {
    return (0, 0)
  }
  let maj = Int.parse(parts[0]) ?? 0
  let b = parts[1].bytes()
  var n = 0
  while n < b.len() && b[n] >= 48 && b[n] <= 57 {
    n += 1
  }
  (maj, Int.parse(parts[1][0..n]) ?? 0)
}

/// The sha256 of the helper's source under src (go.mod and the .go files
/// of cmd/xo-gobind, internal/gobind and internal/gotool, tests left out),
/// in hex: the cache key of a local build.
fn helper_source_key(os: Os, src: Str) -> Str uses fs.read {
  var b = BytesBuilder.new()
  b.write((os.fs.read(join(src, "go.mod")).ok() ?? b""))
  for d in ["cmd/xo-gobind", "internal/gobind", "internal/gotool"] {
    let entries = os.fs.read_dir(join(src, d)).ok() ?? []
    for name in entries.map(fn(e) { e.name }).sort() {
      if !name.ends_with(".go") || name.ends_with("_test.go") {
        continue
      }
      b.write_str("\n${d}/${name}\n")
      b.write(os.fs.read(join(src, "${d}/${name}")).ok() ?? b"")
    }
  }
  crypto.sha256(b.freeze()).to_hex()
}

/// The helper to run in place of the prebuilt one at helper (decision
/// 0393): when the installed go command is a newer Go than the helper
/// was built with, whose export data the helper cannot read, and the
/// helper's source is under src (a release's lib/xo, or a checkout), a
/// build of that source with the installed Go, made once into <user
/// cache>/xo/gobind/<source key>-<go version>/; else helper.
/// XO_GOBIND_LOCAL=1 makes that build whatever the versions.
fn helper_for_go(os: Os, helper: Str, src: Str) -> Str ! Str uses (fs, proc, env) {
  if !is_file(os, join(src, "cmd/xo-gobind/main.go")) {
    return Ok(helper)
  }
  let go = go_command(os)
  let local = go_output(os, go, ["env", "GOVERSION"])
  // `go version FILE` prints "FILE: go1.26.1"
  let built_line = go_output(os, go, ["version", helper])
  let built = built_line[(built_line.rfind(" ") ?? -1) + 1..]
  let (lmaj, lmin) = go_lang(local)
  let (bmaj, bmin) = go_lang(built)
  // XO_GOBIND_LOCAL=1 builds it with the installed Go whatever the
  // versions (the release smoke runs this path on a runner whose Go is
  // the helper's)
  let force = (os.env.get("XO_GOBIND_LOCAL") ?? "") == "1"
  if !force && (lmaj == 0 || bmaj == 0 || lmaj < bmaj || (lmaj == bmaj && lmin <= bmin)) {
    return Ok(helper)
  }
  let cache = hostpath.user_cache_dir(os.env)
  if cache.is_empty() {
    return Err("xo-gobind was built with ${built} and cannot read ${local}'s export data, and there is no user cache directory to build it into (HOME, or LocalAppData on Windows): set XO_GOBIND to an xo-gobind built with ${local}")
  }
  let dir = "${cache}/xo/gobind/${helper_source_key(os, src)[0..16]}-${local}"
  let out = join(dir, "xo-gobind${if hostpath.windows() { ".exe" } else { "" }}")
  if is_file(os, out) {
    return Ok(out)
  }
  os.fs.create_dir_all(dir).ok()
  // built beside its name and renamed, so a concurrent bind never runs
  // a half written helper
  let tmp = match os.fs.create_temp(dir, "xo-gobind-") {
    Ok(t) => t
    Err(e) => return Err("building xo-gobind with ${local}: ${e}")
  }
  // only the unique name: the build makes the file, executable (the
  // temporary one is not)
  os.fs.remove(tmp).ok()
  match os.proc.cmd(go, ["build", "-o", tmp, "./cmd/xo-gobind"]).dir(src).output() {
    Ok(o) => {
      if o.code != 0 {
        os.fs.remove(tmp).ok()
        return Err("building xo-gobind with ${local} (decision 0393; the shipped one is ${built}): ${(o.stderr.to_str() ?? "").trim()}")
      }
    }
    Err(e) => {
      os.fs.remove(tmp).ok()
      return Err("building xo-gobind with ${local}: ${e}")
    }
  }
  match os.fs.rename(tmp, out) {
    Ok(_) => Ok(out)
    Err(e) => {
      os.fs.remove(tmp).ok()
      if is_file(os, out) { Ok(out) } else { Err("building xo-gobind with ${local}: ${e}") }
    }
  }
}

/// Binds Go package gopath into the binding cache of the project at root
/// with xo-gobind (`xo bind --dir root gopath`): the helper's path, or
/// the binder's reason (gobind.Error's Msg) or why the helper did not run.
pub fn bind_go_package(os: Os, std_dir: Str, wd: Str, root: Str, gopath: Str) -> Str ! Str uses (fs, proc, env) {
  let (helper, temp) = gobind_helper(os, std_dir, wd)?
  let r = os.proc.cmd(helper, ["--dir", root, gopath]).output()
  if temp {
    os.fs.remove(helper).ok()
  }
  let out = match r {
    Ok(o) => o
    Err(e) => return Err("xo-gobind: ${e}")
  }
  if out.code == 0 {
    return Ok(if temp { "a temporary build of cmd/xo-gobind" } else { helper })
  }
  var msg = (out.stderr.to_str() ?? "").trim()
  let pre = "xo bind: cannot bind Go package ${go_quote(gopath)}: "
  if msg.starts_with(pre) {
    msg = msg.trim_prefix(pre)
  } else if msg.is_empty() {
    msg = "xo-gobind exited with status ${out.code}"
  }
  Err(msg)
}
