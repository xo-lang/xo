// The Go declarations of the std types for the Go backend's runtime,
// std/rt/std_gen.go (internal/gen stdtypes.go StdTypes, deleted with the
// Go compiler): every struct, enum, and interface of the std modules c
// loaded, in module path order, generated as package rt itself would
// (no "rt." qualifiers), without //line directives. scripts/stdgen runs
// it through `xo dev dump go --std-types`, gofmt, and writes the file.

use github.com/xo-lang/xo/compiler/check

/// Prelude declarations the runtime implements by hand (core.go,
/// list.go, ...), which std_types skips (preludeBuiltin).
fn prelude_builtin(name: Str) -> Bool {
  name is "Never" | "Option" | "Result" | "Error" || check.is_derivable_name(name)
}

/// Fields of std structs that only the Go runtime reads and writes (the
/// request's path parameters, parsed form, and raw query, the
/// response's stream, and both's header field names in order, decision
/// 0288; a streamed multipart part's fields, decision 0310), appended
/// to the generated struct: (Go type name, field lines).
fn rt_extra_fields() -> List[(Str, List[Str])] {
  [
    ("Http_Request", ["\tXParams Map[string, string]", "\tXValues *reqValues", "\tXRawQuery string", "\tXFields []string"]),
    ("Http_Response", ["\tXStream func(*Task, Http_BodyWriter) Result[Unit, IoErr]", "\tXFields []string"]),
    ("Http_StreamPart", ["\tXFields []string"]),
  ]
}

/// text with each extra field added at the end of its struct.
fn add_extra_fields(text: Str) -> Str ! Str {
  var out = text
  for (name, lines) in rt_extra_fields() {
    let head = "type ${name} struct {\n"
    let parts = out.split(head)
    if parts.len() != 2 {
      return Err("std_types: no struct ${name} for its runtime fields")
    }
    let i = parts[1].find("\n}\n") ?? -1
    if i < 0 {
      return Err("std_types: struct ${name} has no end")
    }
    let body = parts[1].bytes()
    let fields = body[0..i + 1].to_str() ?? ""
    let rest = body[i + 1..].to_str() ?? ""
    out = parts[0] + head + fields + lines.join("\n") + "\n" + rest
  }
  Ok(out)
}

/// The text of std/rt/std_gen.go before gofmt, or the generator's errors.
pub fn std_types(c: check.Checker) -> Str ! Str {
  var g = Gen{c: c, opts: Opts{arenas: true}}
  g.prelude = c.prelude
  g.init_adapt()
  // after init_adapt's key package
  let rp = g.pkgs.len()
  g.pkgs.push(Pkg{m: -1, dir: "rt", name: "rt", in_rt: true})
  g.p = rp
  var mods: List[Int] = []
  for (m, md) in c.mods.indexed() {
    if md.is_std && !md.native {
      mods.push(m)
    }
  }
  for m in mods.sort_by(fn(m: Int) -> Str { c.mods[m].path }) {
    g.pkgs[rp].m = m
    let prelude = c.mods[m].is_prelude
    for fi in c.mods[m].files {
      g.pkgs[rp].cur = fi
      let file = c.files[fi]
      for (di, d) in file.ast.decls.indexed() {
        let o = if di < file.decl_objs.len() { file.decl_objs[di] } else { -1 }
        if o < 0 || c.objs[o].kind != check.ObjKind.Type {
          continue
        }
        if prelude && prelude_builtin(g.oname(o)) {
          continue
        }
        match d {
          StructDecl(sd) => {
            if !c.objs[o].opaque {
              g.gen_struct(o, sd)
            }
          }
          EnumDecl(ed) => g.gen_enum(o, ed.span)
          InterfaceDecl(..) => g.gen_interface(o)
          TypeDecl(td) => {
            if g.tkind(o) == "newtype" {
              g.gen_newtype(o, td.span)
            }
          }
          _ => {}
        }
      }
    }
  }
  if !g.errs.is_empty() {
    return Err(g.errs.join("\n"))
  }
  var b = StrBuilder.new()
  b.write("// Code generated by scripts/stdgen from std/*.xo. DO NOT EDIT.\n")
  b.write("// Regenerate with: go run ./scripts/stdgen\n\n")
  b.write("package rt\n\n")
  let paths = g.pkgs[rp].imports.keys().filter(fn(p: Str) { p != "xoprog/rt" }).sort()
  if !paths.is_empty() {
    b.write("import (\n")
    for p in paths {
      b.write("\t${p.quote()}\n")
    }
    b.write(")\n\n")
  }
  // //line directives would point at std/*.xo, which is not part of
  // the build
  let lines = g.pkgs[rp].out.join("").split("\n").filter(fn(l: Str) { !l.starts_with("//line ") })
  b.write(lines.join("\n"))
  add_extra_fields(b.freeze())
}

/// The Go function type of a std function as the generator calls it:
/// `func(*Task, P0, ...) R`, with recv first after the task for a method
/// the runtime keeps as a package level function.
fn (var g: Gen) std_sig_type(fo: Int, recv: Str) -> Str {
  var b = "func(*Task"
  if !recv.is_empty() {
    b = b + ", " + recv
  }
  for p in g.c.objs[fo].params {
    b = b + ", "
    if p.is_var {
      b = b + "*"
    }
    b = b + g.go_type(p.ty)
  }
  b = b + ")"
  let r = g.go_result(fo)
  if !r.is_empty() {
    b = b + " " + r
  }
  b
}

/// The text of std/rt/std_sigs_gen.go before gofmt: for each std function
/// the runtime writes by hand (no Xo body, not generic), a declaration
/// `var _ TYPE = NAME` that stops std/rt compiling when the hand written
/// function's signature is not the one the Go backend calls.
pub fn std_sigs(c: check.Checker) -> Str ! Str {
  var g = Gen{c: c, opts: Opts{arenas: true}}
  g.prelude = c.prelude
  g.init_adapt()
  let rp = g.pkgs.len()
  g.pkgs.push(Pkg{m: -1, dir: "rt", name: "rt", in_rt: true})
  g.p = rp
  var mods: List[Int] = []
  for (m, md) in c.mods.indexed() {
    if md.is_std && !md.native {
      mods.push(m)
    }
  }
  var b = StrBuilder.new()
  b.write("// Code generated by scripts/stdgen from std/*.xo. DO NOT EDIT.\n")
  b.write("// Regenerate with: go run ./scripts/stdgen\n\n")
  b.write("package rt\n\n")
  b.write("// The signatures the Go backend calls the hand written std functions\n")
  b.write("// with (compiler/gen stdtypes.xo std_sigs).\n")
  b.write("var (\n")
  for m in mods.sort_by(fn(m: Int) -> Str { c.mods[m].path }) {
    g.pkgs[rp].m = m
    let prefix = g.std_free_prefix(m)
    for fi in c.mods[m].files {
      g.pkgs[rp].cur = fi
      let file = c.files[fi]
      for (di, d) in file.ast.decls.indexed() {
        let fo = if di < file.decl_objs.len() { file.decl_objs[di] } else { -1 }
        if fo < 0 || c.objs[fo].kind != check.ObjKind.Func {
          continue
        }
        let body = match d {
          FnDecl(fd) => fd.body != None
          _ => true
        }
        let o = c.objs[fo]
        if body || !o.tparams.is_empty() || o.iface {
          continue
        }
        if o.recv < 0 {
          // fault and dbg are lowered where they are called (conc.xo
          // special_std); a module the Go backend compiles from its
          // native implementation has no hand written function (decision
          // 0312)
          if !(c.mods[m].is_prelude && g.oname(fo) is "fault" | "dbg") && (g.impl_mod(c.mods[m].path) < 0 || g.impl_member(g.impl_mod(c.mods[m].path), fo) < 0) {
            b.write("\t_ ${g.std_sig_type(fo, "")} = ${prefix}${g.oname(fo)}\n")
          }
        } else if !g.c.objs[o.recv].tparams.is_empty() {
          continue
        } else if g.impl_mod(c.mods[m].path) >= 0 && g.impl_member(g.impl_mod(c.mods[m].path), fo) >= 0 {
          // compiled from the native implementation (decision 0312)
          continue
        } else if g.method_is_go_method(fo) {
          // a Go method: its method expression on the pointer type takes
          // value and pointer receivers alike
          let gt = g.go_type(o.recv_ty)
          let rt = if gt.starts_with("*") { gt } else { "*" + gt }
          let sig = g.std_sig_type(fo, "").trim_prefix("func(*Task")
          b.write("\t_ func(${rt}, *Task${sig} = (${rt}).${go_method(g.oname(fo))}\n")
        } else if o.is_static {
          b.write("\t_ ${g.std_sig_type(fo, "")} = ${g.std_prefix(g.omod(o.recv))}${g.oname(o.recv)}_${g.oname(fo)}\n")
        } else {
          let rt = g.go_type(o.recv_ty)
          let recv = if o.recv_var { "*" + rt } else { rt }
          b.write("\t_ ${g.std_sig_type(fo, recv)} = ${g.std_prefix(g.omod(o.recv))}${g.oname(o.recv)}_${g.oname(fo)}\n")
        }
      }
    }
  }
  b.write(")\n")
  if !g.errs.is_empty() {
    return Err(g.errs.join("\n"))
  }
  let text = b.freeze()
  let imports = g.pkgs[rp].imports.keys().filter(fn(p: Str) { p != "xoprog/rt" }).sort()
  if imports.is_empty() {
    return Ok(text)
  }
  var head = "import (\n"
  for p in imports {
    head = head + "\t${p.quote()}\n"
  }
  Ok(text.replace("package rt\n\n", "package rt\n\n${head})\n\n"))
}
