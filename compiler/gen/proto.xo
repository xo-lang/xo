// Protocol methods on demand (decision 0542): a protocol method of a
// user type (XoGenAny, XoEq, XoEqT, XoHash) is written only when a whole-program walk
// from that protocol's roots reaches the type, through fields, enum
// payloads, newtype targets and type arguments. Each such method is
// written between marker chunks that pkg_file keeps or drops.

use github.com/xo-lang/xo/compiler/check

/// XoGenAny: the values property tests and testing.gen generate.
const P_GEN = 1
/// XoEq and XoEqT: `==`, `!=`, literal patterns, Map keys, Set elements
/// and constrained type parameters.
const P_EQ = 2
/// XoHash: Map keys, Set elements and constrained type parameters.
const P_HASH = 4

/// The chunk that starts a protocol method of object o, and the one that
/// ends it (never valid Go, so a leak fails go build).
fn proto_begin(bit: Int, o: Int) -> Str {
  "\0xoproto ${bit} ${o}\n"
}

const PROTO_END = "\0xoproto end\n"

/// Starts the protocol method bit of type object t (protoBegin).
/// std's types in the runtime package keep every method: the walk stops
/// at std types, and other programs share that package.
fn (var g: Gen) proto_open(bit: Int, t: Int) {
  if !g.pkgs[g.p].in_rt {
    g.pkgs[g.p].out.push(proto_begin(bit, t))
  }
}

/// Marks a user type whose protocol methods may be left out, so the
/// runtime's EqAny and HashAny fault on a missing one instead of falling
/// back to reflection; std's types keep every method and need no mark.
fn (var g: Gen) proto_mark(self: Str) {
  if !g.pkgs[g.p].in_rt {
    g.pl("func (${self}) XoProto() {}\n")
  }
}

fn (var g: Gen) proto_close_method() {
  if !g.pkgs[g.p].in_rt {
    g.pkgs[g.p].out.push(PROTO_END)
  }
}

/// Records t as a root of the protocols in bits.
fn (var g: Gen) proto_root(t: Int, bits: Int) {
  if t < 0 {
    return
  }
  if g.c.tys[g.c.resolve(t)].kind == check.TyKind.Param {
    // a generic form compares or hashes values of any type its callers
    // pass, but runs only when a call was not specialized (past
    // MAX_SPECS_PER_FUNC copies or MAX_SPEC_DEPTH, or with no copies):
    // proto_close keeps every type's methods only then
    let cur = g.proto_cur_gform()
    if cur >= 0 {
      g.proto_gform[cur] = (g.proto_gform.get(cur) ?? 0) | bits
      g.proto_gnote(cur, "type parameter ${g.c.show(t)} compared or hashed")
    } else {
      g.proto_set_all(bits, "type parameter ${g.c.show(t)} rooted outside a generic form (${g.proto_where()})")
    }
    return
  }
  if g.opts.proto_why && !g.proto_root_at.contains(t) {
    g.proto_root_at[t] = g.proto_where()
  }
  g.proto_roots[t] = (g.proto_roots.get(t) ?? 0) | bits
}

/// Sets the protocols in bits for every type, noting why when asked.
fn (var g: Gen) proto_set_all(bits: Int, why: Str) {
  if g.opts.proto_why && (bits & (bits ^ g.proto_all)) != 0 {
    g.proto_why_log.push("bits ${bits & (bits ^ g.proto_all)}: ${why}")
  }
  g.proto_all = g.proto_all | bits
}

/// Notes the first reason generic form fo records a protocol.
fn (var g: Gen) proto_gnote(fo: Int, why: Str) {
  if g.opts.proto_why && !g.proto_gwhy.contains(fo) {
    g.proto_gwhy[fo] = why
  }
}

/// The function being generated, for XO_GO_PROTO=why.
fn (g: Gen) proto_where() -> Str {
  if g.proto_prepass {
    return "syntax pass"
  }
  if g.f.frames.is_empty() {
    return "no function"
  }
  let fo = g.f.frames[0].fo
  "in ${if fo >= 0 { g.oname(fo) } else { "a test or top-level code" }}${if g.pkgs[g.p].ms.on { " copy" } else { "" }}"
}

/// Whether the method bit of object o is written: XO_GO_PROTO=all, a
/// generic body that reaches the protocol through a type parameter, or o
/// reached from a root.
fn (g: Gen) proto_kept(bit: Int, o: Int) -> Bool {
  g.opts.proto_all || (g.proto_all & bit) != 0 || ((g.proto_need.get(o) ?? 0) & bit) != 0
}

/// The roots no generated code names: calls of testing.gen[T] (a type
/// argument that is a type parameter reaches every type).
fn (var g: Gen) proto_call_roots() {
  for (fi, file) in g.c.files.indexed() {
    let m = file.module
    if m < 0 || g.c.mods[m].is_std {
      continue
    }
    for n in decl_nodes(file.ast) {
      for ne in flatten(n) {
        if let E(e) = ne.node {
          if let CallExpr(..) = e {
            if let Some(ci) = g.c.call_in(fi, e) {
              let fo = ci.fn_obj
              if fo >= 0 && g.omod(fo) >= 0 && g.c.mods[g.omod(fo)].path == "std/testing" && g.oname(fo) == "gen" {
                for (_, t) in ci.subst {
                  g.proto_root(t, P_GEN)
                }
              }
              // the prelude's element searches compare with the runtime's Eq
              // (std/rt list.go List_contains, List_index_of)
              if fo >= 0 && g.oprelude(fo) && g.oname(fo) is "contains" | "index_of" {
                for (_, t) in ci.subst {
                  if g.c.tys[g.c.resolve(t)].kind != check.TyKind.Param {
                    g.proto_root(t, P_EQ)
                  }
                }
              }
              // a std callee's constrained type parameter may be compared or
              // hashed in its body, which this run does not generate (std's
              // Go is pregenerated); a program's own generic needs no root:
              // its copies root what they compare. A type parameter passed
              // to a prelude method keeps every type; to another std
              // function, the copy's call roots its concrete type
              // (proto_std_call)
              if fo >= 0 && g.ostd(fo) && !g.proto_std_free(fo) {
                for (p, t) in ci.subst {
                  if p >= 0 && g.c.objs[p].constraint >= 0 && g.c.tys[g.c.resolve(t)].kind != check.TyKind.Param {
                    g.proto_root(t, P_EQ | P_HASH)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

/// Records a conversion of a from value to interface type to: the
/// interface's dynamic values reach from's protocol methods.
fn (var g: Gen) proto_iface(from: Int, to: Int) {
  let n = g.nobj(to)
  if n < 0 || from < 0 {
    return
  }
  var l = g.proto_ifs.get(n) ?? []
  if !l.contains(from) {
    l.push(from)
    g.proto_ifs[n] = l
  }
}

/// Walks a type converted to an interface: a type parameter there may be
/// any type, compared through the interface without a constraint.
fn (var g: Gen) proto_walk_any(t: Int, bits: Int, var walked: Map[Int, Int]) {
  if t >= 0 && g.c.tys[g.c.resolve(t)].kind == check.TyKind.Param {
    g.proto_set_all(bits, "type parameter ${g.c.show(t)} converted to an interface")
    return
  }
  g.proto_walk(t, bits, walked)
}

/// The generic function whose generic form is being generated, or -1 (a
/// specialized copy, a non-generic function, or the syntax pass).
fn (g: Gen) proto_cur_gform() -> Int {
  if g.proto_prepass || g.pkgs[g.p].ms.on || g.f.frames.is_empty() {
    return -1
  }
  let fo = g.f.frames[0].fo
  if g.is_generic_user_func(fo) { fo } else { -1 }
}

/// A call of generic function fo's generic form with type arguments sub
/// (emit_call, no copy), recorded under the generic form that makes it
/// (-1: code that runs): a running form's protocols reach the arguments
/// it is called with.
fn (var g: Gen) proto_gform_call(fo: Int, sub: Map[Int, Int]) {
  var args: List[Int] = []
  for p in g.type_params(g.c.objs[fo].tparams) {
    args.push(g.mono_type(sub.get(p) ?? -1))
  }
  let cur = g.proto_cur_gform()
  var l = g.proto_gcalls.get(cur) ?? []
  l.push((fo, args))
  g.proto_gcalls[cur] = l
}

/// A call of std function fo with type arguments sub, as generated: inside
/// a specialized copy a type parameter's argument is concrete here.
fn (var g: Gen) proto_std_call(fo: Int, sub: Map[Int, Int]) {
  let search = g.oprelude(fo) && g.oname(fo) is "contains" | "index_of"
  if !search && g.proto_std_free(fo) {
    return
  }
  for (p, t) in sub {
    if p >= 0 && (search || g.c.objs[p].constraint >= 0) && g.c.tys[g.c.resolve(t)].kind == check.TyKind.Param {
      g.proto_root(g.mono_type(t), if search { P_EQ } else { P_EQ | P_HASH })
    }
  }
}

/// Whether std function fo is listed in std/go_proto_free.txt: its Go
/// compares and hashes no value of its type parameters.
fn (g: Gen) proto_std_free(fo: Int) -> Bool {
  let o = g.c.objs[fo]
  if o.recv >= 0 || g.omod(fo) < 0 {
    return false
  }
  let parts = g.c.mods[g.omod(fo)].path.split("/")
  g.proto_free.contains("${parts[parts.len() - 1]}.${g.oname(fo)}")
}

/// The type parameters t holds (depth-limited: a type is finite, but a
/// recursive generic is cut).
fn (g: Gen) proto_params_in(t0: Int, var out: List[Int], depth: Int) {
  if t0 < 0 || depth > 16 {
    return
  }
  let t = g.c.resolve(t0)
  let x = g.c.tys[t]
  if x.kind == check.TyKind.Param {
    if x.obj >= 0 && !out.contains(x.obj) {
      out.push(x.obj)
    }
    return
  }
  for a in x.args {
    g.proto_params_in(a, out, depth + 1)
  }
  if x.kind == check.TyKind.Func {
    g.proto_params_in(x.result, out, depth + 1)
    g.proto_params_in(x.err, out, depth + 1)
  }
}

/// Closes the roots over the types they reach (after every module and
/// copy is generated).
fn (var g: Gen) proto_close() {
  g.proto_prepass = true
  g.proto_call_roots()
  g.proto_prepass = false
  var roots: List[(Int, Int)] = []
  for (t, bits) in g.proto_roots {
    roots.push((t, bits))
  }
  // every type instance: a Map's key and a Set's element are compared and
  // hashed; a constrained parameter's argument may be
  // a key that holds a type parameter is a root of each argument that
  // parameter is given: a function's in its generic form (when that form
  // runs), a generic type's in each of its instances
  var owner: Map[Int, Int] = {}
  for (o, ob) in g.c.objs.indexed() {
    for p in ob.tparams {
      owner[p] = o
    }
  }
  var keyed: Map[(Int, Int), Bool] = {}
  var keys: List[Int] = []
  for t in 0..g.c.tys.len() {
    let x = g.c.tys[t]
    if x.kind != check.TyKind.Named || x.obj < 0 {
      continue
    }
    let o = x.obj
    let ps = g.c.objs[o].tparams
    if g.oprelude(o) && (g.oname(o) == "Map" || g.oname(o) == "Set") && !x.args.is_empty() {
      keys.push(x.args[0])
    }
    for (i, p) in ps.indexed() {
      if i < x.args.len() && g.c.objs[p].constraint >= 0 {
        keys.push(x.args[i])
      }
    }
  }
  var changed = true
  while changed {
    changed = false
    for a in keys {
      var ps: List[Int] = []
      g.proto_params_in(a, ps, 0)
      if ps.is_empty() {
        roots.push((a, P_EQ | P_HASH))
        continue
      }
      for p in ps {
        let o = owner.get(p) ?? -1
        if o < 0 || g.ostd(o) {
          continue
        }
        if g.is_generic_user_func(o) {
          g.proto_gform[o] = (g.proto_gform.get(o) ?? 0) | P_EQ | P_HASH
          g.proto_gnote(o, "key or constrained argument ${g.c.show(a)}")
        } else if !keyed.contains((o, g.c.objs[o].tparams.index_of(p) ?? -1)) {
          keyed[(o, g.c.objs[o].tparams.index_of(p) ?? -1)] = true
          changed = true
        }
      }
    }
    keys = []
    if changed {
      // each instance of a generic type gives its keyed parameters' arguments
      for t in 0..g.c.tys.len() {
        let x = g.c.tys[t]
        if x.kind != check.TyKind.Named || x.obj < 0 {
          continue
        }
        for i in 0..x.args.len() {
          if keyed.contains((x.obj, i)) {
            keys.push(x.args[i])
          }
        }
      }
    }
  }
  // the generic forms that run: called where no copy was made, and what
  // those call in turn
  var running: Map[Int, Bool] = {}
  var work: List[Int] = [-1]
  var seen: Map[Int, Bool] = {}
  while let Some(c) = work.pop() {
    if seen.contains(c) {
      continue
    }
    seen[c] = true
    for (fo, _) in g.proto_gcalls.get(c) ?? [] {
      running[fo] = true
      work.push(fo)
    }
  }
  // a running form's protocols reach the type arguments of its calls: a
  // concrete one is a root, a type parameter of the calling form gives
  // that form the protocols in turn (until no form gains one)
  var grooted: Map[Int, Int] = {}
  var gchanged = true
  while gchanged {
    gchanged = false
    for (c, calls) in g.proto_gcalls {
      if c >= 0 && !running.contains(c) {
        continue
      }
      for (fo, args) in calls {
        let bits = g.proto_gform.get(fo) ?? 0
        if bits == 0 {
          continue
        }
        for a in args {
          var ps: List[Int] = []
          g.proto_params_in(a, ps, 0)
          if a < 0 {
            g.proto_set_all(bits, "generic form ${g.oname(fo)} runs with a type argument not known")
          } else if ps.is_empty() {
            let had = grooted.get(a) ?? 0
            if (had | bits) != had {
              grooted[a] = had | bits
              roots.push((a, bits))
            }
          }
          for p in ps {
            if c >= 0 && g.c.objs[c].tparams.contains(p) {
              let had = g.proto_gform.get(c) ?? 0
              if (had | bits) != had {
                g.proto_gform[c] = had | bits
                g.proto_gnote(c, "passes ${g.c.show(a)} to ${g.oname(fo)}")
                gchanged = true
              }
            } else {
              g.proto_set_all(bits, "generic form ${g.oname(fo)} runs with type argument ${g.c.show(a)} (${if c >= 0 { g.oname(c) } else { "not a generic form" }}; ${g.proto_gwhy.get(fo) ?? "?"})")
            }
          }
        }
      }
    }
  }
  var walked: Map[Int, Int] = {}
  for (t, bits) in roots {
    let before = g.proto_need.len()
    g.proto_walk(t, bits, walked)
    if g.opts.proto_why && g.proto_need.len() > before {
      g.proto_why_log.push("root ${g.c.show(t)} bits ${bits} (${g.proto_root_at.get(t) ?? "a key, constrained argument or running form"}): ${g.proto_need.len() - before} new types")
    }
  }
  // a user type that derives Eq, Hash or Ord says it is compared: it and
  // what its fields reach (a type parameter in them reaches every type)
  for (o, ob) in g.c.objs.indexed() {
    if ob.derives.is_empty() || ob.tkind.is_empty() || g.ostd(o) {
      continue
    }
    if !g.proto_derives_compare(o) {
      continue
    }
    g.proto_need[o] = (g.proto_need.get(o) ?? 0) | P_EQ | P_HASH
    for f in ob.fields {
      g.proto_walk(f.ty, P_EQ | P_HASH, walked)
    }
    for v in ob.variants {
      for f in v.fields {
        g.proto_walk(f.ty, P_EQ | P_HASH, walked)
      }
    }
    if ob.tkind == "newtype" {
      g.proto_walk(ob.target, P_EQ | P_HASH, walked)
    }
  }
}

/// Whether user type o derives a comparing interface (the derivable
/// table's Equality and Order markers: Eq, Hash, Ord).
fn (g: Gen) proto_derives_compare(o: Int) -> Bool {
  for n in g.c.objs[o].derives {
    if let Some(d) = check.derivable(n) {
      if d.marker && (d.kind == check.DeriveKind.Equality || d.kind == check.DeriveKind.Order) {
        return true
      }
    }
  }
  false
}

fn (var g: Gen) proto_walk(t0: Int, bits: Int, var walked: Map[Int, Int]) {
  if t0 < 0 {
    return
  }
  let t = g.c.resolve(t0)
  let had = walked.get(t) ?? 0
  if (had & bits) == bits {
    return
  }
  walked[t] = had | bits
  let x = g.c.tys[t]
  match x.kind {
    Param => {
      // a compared or hashed type parameter is constrained, so each of
      // its arguments is a root of its own (proto_call_roots); a
      // generated one may be any type
      g.proto_set_all(bits & P_GEN, "testing.gen reaches type parameter ${g.c.show(t)}")
    }
    Tuple => {
      for a in x.args {
        g.proto_walk(a, bits, walked)
      }
    }
    Func => {
      for a in x.args {
        g.proto_walk(a, bits, walked)
      }
      g.proto_walk(x.result, bits, walked)
      g.proto_walk(x.err, bits, walked)
    }
    Named => {
      let o = x.obj
      for a in x.args {
        g.proto_walk(a, bits, walked)
      }
      if g.tkind(o) == "interface" {
        // its dynamic values are the types converted to it
        for s in g.proto_ifs.get(o) ?? [] {
          g.proto_walk_any(s, bits, walked)
        }
        return
      }
      if g.ostd(o) {
        return
      }
      g.proto_need[o] = (g.proto_need.get(o) ?? 0) | bits
      let s = g.subst_of(o, t)
      let k = g.tkind(o)
      if k == "struct" {
        for f in g.c.objs[o].fields {
          g.proto_walk(g.sub_apply(f.ty, s), bits, walked)
        }
      } else if k == "newtype" {
        g.proto_walk(g.sub_apply(g.c.objs[o].target, s), bits, walked)
      } else if k == "enum" {
        for v in g.c.objs[o].variants {
          for f in v.fields {
            g.proto_walk(g.sub_apply(f.ty, s), bits, walked)
          }
        }
      }
    }
    _ => ()
  }
}

/// The package text with the protocol methods no root reaches left out
/// (pkg_file's body).
fn (g: Gen) proto_filter(out: List[Str]) -> Str {
  var b = StrBuilder.new()
  var drop = false
  for s in out {
    if s.starts_with("\0xoproto ") {
      if s == PROTO_END {
        drop = false
        continue
      }
      let w = s.trim_suffix("\n").split(" ")
      let bit = Int.parse(w[1]) ?? 0
      let o = Int.parse(w[2]) ?? -1
      drop = !g.proto_kept(bit, o)
      continue
    }
    if !drop {
      b.write(s)
    }
  }
  b.freeze()
}
