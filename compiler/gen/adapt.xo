// Interface adapters for conversions in generic code (internal/gen
// adapt.go), and the zone data a program needs (timezone.go).

use github.com/xo-lang/xo/selfhost/parser

fn (var g: Gen) init_adapt() {
  g.ad = AdaptState{kp: g.pkgs.len()}
  g.pkgs.push(Pkg{name: "main", no_adapt: true})
}

/// Records a concrete user type named in generated code, or a std type
/// whose methods are runtime functions (noteType).
fn (var g: Gen) note_type(t: Int) {
  if g.pkgs[g.p].no_adapt || g.ad.kp < 0 {
    return
  }
  let concrete = !g.contains_param(t)
  if concrete && g.ad.seen.contains(t) {
    return
  }
  if concrete {
    g.ad.seen[t] = true
  }
  let o = g.nobj(t)
  if g.omod(o) < 0 || (g.ostd(o) && !g.rt_func_methods(o)) {
    return
  }
  var tt = t
  if g.contains_param(tt) {
    tt = g.mono_type(tt)
    if g.contains_param(tt) {
      return
    }
  }
  let key = g.key_type(tt)
  g.ad.types[key] = tt
}

/// The Go type text of t as seen from package main (adaptState.kp).
fn (var g: Gen) key_type(t: Int) -> Str {
  let saved = g.p
  g.p = g.ad.kp
  let s = g.go_type(t)
  g.p = saved
  s
}

/// Records an interface that generic code converts a type parameter to
/// with rt.Iface (noteTarget).
fn (var g: Gen) note_target(to0: Int) {
  if g.pkgs[g.p].no_adapt || g.ad.kp < 0 {
    return
  }
  let to = g.mono_type(to0)
  let o = g.nobj(to)
  if o < 0 || g.tkind(o) != "interface" || g.ostd(o) {
    return
  }
  if g.contains_param(to) {
    g.ad.objs[o] = true
    return
  }
  let key = g.key_type(to)
  g.ad.targets[key] = to
}

/// The text of package main's xo_adapt.go (adaptFile).
fn (var g: Gen) adapt_file() -> Str {
  var targets: Map[Str, Int] = {}
  for (k, t) in g.ad.targets.entries() {
    targets[k] = t
  }
  for (k, t) in g.ad.types.entries() {
    let o = g.nobj(t)
    if o >= 0 && g.ad.objs.contains(o) {
      targets[k] = t
    }
  }
  let ap = g.pkgs.len()
  g.pkgs.push(Pkg{name: "main", no_adapt: true, no_mono: true})
  let saved = g.p
  g.p = ap
  var regs: List[Str] = []
  let tkeys = targets.keys().sort()
  let xkeys = g.ad.types.keys().sort()
  for tk in tkeys {
    let to = targets.get(tk) ?? -1
    let tn = g.nobj(to)
    for xk in xkeys {
      let from = g.ad.types.get(xk) ?? -1
      if xk == tk || !g.has_method_names(from, tn) || !g.c.implements(from, to, no_span()) {
        continue
      }
      let name = g.iface_adapter(from, to)
      if name.is_empty() {
        continue
      }
      let it = g.go_type(to)
      let xt = g.go_type(from)
      regs.push("\t${g.rt()}RegAdapter[${it}](func(v any) (${it}, bool) {\n\t\tx, ok := v.(${xt})\n\t\tif !ok {\n\t\t\treturn nil, false\n\t\t}\n\t\treturn ${name}{V: x}, true\n\t})")
    }
  }
  g.p = saved
  var b = "// Code generated by xo. DO NOT EDIT.\n\n"
  b = b + "// Interface adapters for conversions of type parameters (rt.RegAdapter).\n\npackage main\n\n"
  if regs.is_empty() {
    return b
  }
  let pg = g.pkgs[ap]
  b = b + "import (\n"
  for p in pg.imports.keys().sort() {
    b = b + "\t${pg.imports.get(p) ?? ""} ${p.quote()}\n"
  }
  b = b + ")\n\n"
  b = b + pg.out.join("")
  b + "func init() {\n" + regs.join("\n") + "\n}\n"
}

fn no_span() -> Span {
  Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
}

/// Whether t has a method for every method name of interface type o
/// (hasMethodNames).
fn (var g: Gen) has_method_names(t: Int, o: Int) -> Bool {
  for im in g.c.objs[o].iface_meths {
    let (m, _) = g.find_method(t, g.oname(im))
    if m < 0 {
      return false
    }
  }
  true
}

// ---------------------------------------------------------------------------
// Zone data per use (std.md 13, decision 0094)

fn (g: Gen) is_time_zone_fn(fo: Int) -> Bool {
  fo >= 0 && g.c.objs[fo].recv < 0 && g.oname(fo) == "zone" && g.ostd(fo) && g.c.mods[g.omod(fo)].path == "std/time"
}

/// Records a call of time.zone (noteZoneCall).
fn (var g: Gen) note_zone_call(x: Expr, fo: Int) {
  if !g.is_time_zone_fn(fo) {
    return
  }
  let (span, _, args) = call_parts(x)
  if !args.is_empty() {
    if let Some(name) = g.c.const_str(g.f.file, args[0].value, 0) {
      g.tz_names[name] = true
      return
    }
  }
  g.tz_dynamic[g.loc(span)] = true
}

/// Records time.zone used as a function value: any name (noteZoneValue).
fn (var g: Gen) note_zone_value(fo: Int, at: Span) {
  if g.is_time_zone_fn(fo) {
    g.tz_dynamic[g.loc(at)] = true
  }
}

fn (g: Gen) tz_use() -> (List[Str], List[Str]) {
  (g.tz_names.keys().sort(), g.tz_dynamic.keys().sort())
}
