// Age and size pruning of xo's caches under <user cache>/xo, shared by
// every cache the driver writes: the build directories (build/), the Go
// backend's GOCACHE (gocache/), the linked binary cache ($XO_BIN_CACHE),
// and the back-end cache of decision 0220's addendum.
//
// The stamp format, the same for every cache:
//
// - An entry's last use is its modification time. A reader marks an
//   entry used with mark_used, which refreshes the time only when it is
//   over TOUCH (an hour) old, so a hit costs one stat (Go's own cache
//   does the same, hourly). A writer stores an entry under a temporary
//   name and renames it into place, so its time is the store's.
// - A cache's last prune is the modification time of DIR/prune-stamp.
// - The bytes stored since then are DIR/prune-stored (decimal text),
//   which note_stored adds to, for Policy.burst.
//
// run removes, at most once per Policy.every (or sooner once Policy.burst
// bytes were stored since the last prune), the entries unused for
// longer than Policy.max_age, then the least recently used ones while the
// cache is over Policy.max_bytes. An entry used within KEEP (two hours)
// is never removed: mark_used may leave a time up to an hour old while a
// process is using the entry, and Go refreshes its entries hourly, so
// the margin covers a build of up to an hour after a refresh. Each entry
// is restated just before it is removed, so one used since the walk
// stays. Removal tolerates failures: another process may remove the same
// entry. Decision 0223. A cache of files also loses its empty
// directories below the top level (the back-end cache's pack slots, one
// per build target) once they are unused for longer than max_age; the
// top level's (GOCACHE's 00 to ff) stay.

/// An entry used within KEEP is never removed.
pub const KEEP: Duration = 2h

/// mark_used refreshes an entry's time once it is older than TOUCH.
pub const TOUCH: Duration = 1h

/// The bytes of a GiB.
pub const GB: Int = 1024 * 1024 * 1024

/// What a prune removes.
pub struct Policy {
  /// Entries unused for longer go; zero keeps entries of any age.
  pub max_age: Duration = 24h
  /// The size cap in bytes; zero or less is no cap.
  pub max_bytes: Int = 20 * 1024 * 1024 * 1024
  /// The least time between two prunes of one cache (the stamp's age).
  pub every: Duration = 1h
  /// true: each directory at the top of the cache is one entry (its
  /// time is the directory's, its size every file below it); false:
  /// each file below the top level is an entry (files at the top, such
  /// as the stamp and lock files, are never entries).
  pub dirs: Bool = false
  /// An entry used within keep is never removed (KEEP unless a cache
  /// whose entries are in use only briefly says otherwise, such as the
  /// test binaries of $XO_BIN_CACHE, decision 0236).
  pub keep: Duration = 2h
  /// Over zero: a run within every still prunes once the bytes stored
  /// since the last prune (note_stored) reach burst, so a burst of
  /// builds cannot grow the cache past the cap for a whole interval.
  pub burst: Int = 0
}

/// What one run did: whether it ran (the stamp allowed it), the paths it
/// removed, and the bytes the cache held afterwards.
pub struct Stats {
  pub ran: Bool = false
  pub removed: List[Str] = []
  pub bytes: Int = 0
}

struct Entry {
  path: Str
  size: Int
  used: Time
}

/// The policy base with $XO_CACHE_MAX_AGE (a Go duration such as 6h or
/// 90m; 0 turns age pruning off) and $XO_CACHE_MAX_GB (GiB, a decimal
/// such as 20 or 0.5; 0 turns the size cap off) applied when set and
/// valid.
pub fn from_env(env: Env, base: Policy) -> Policy uses env {
  var p = base
  let age = (env.get("XO_CACHE_MAX_AGE") ?? "").trim()
  if !age.is_empty() {
    match Duration.parse(age) {
      Ok(d) => {
        if d.nanos() >= 0 {
          p.max_age = d
        }
      }
      Err(_) => {}
    }
  }
  let gb = (env.get("XO_CACHE_MAX_GB") ?? "").trim()
  if !gb.is_empty() {
    if let Some(f) = Float.parse(gb) {
      if f >= 0.0 {
        p.max_bytes = Int(f * Float(GB))
      }
    }
  }
  p
}

/// Marks the entry at path used: its modification time is set to now
/// when it is over TOUCH old (one stat otherwise).
pub fn mark_used(fs: Fs, clock: Clock, path: Str) uses (fs.read, fs.write, clock) {
  mark_used_within(fs, clock, path, TOUCH)
}

/// mark_used with touch in place of TOUCH, for a cache whose keep is
/// shorter than KEEP (its touch must be shorter than its keep).
pub fn mark_used_within(fs: Fs, clock: Clock, path: Str, touch: Duration) uses (fs.read, fs.write, clock) {
  match fs.stat(path) {
    Ok(Some(fi)) => {
      if clock.since(fi.modified) >= touch {
        fs.set_modified(path, clock.now()).ignore_err("only the prune order")
      }
    }
    _ => {}
  }
}

/// Prunes the cache in dir by p (see the file comment).
pub fn run(fs: Fs, clock: Clock, dir: Str, p: Policy) -> Stats uses (fs.read, fs.write, clock) {
  var st = Stats{}
  if p.max_age.nanos() <= 0 && p.max_bytes <= 0 {
    return st
  }
  match fs.stat(dir) {
    Ok(Some(fi)) => {
      if !fi.is_dir {
        return st
      }
    }
    _ => return st
  }
  let stamp = "${dir}/prune-stamp"
  match fs.stat(stamp) {
    Ok(Some(fi)) => {
      if clock.since(fi.modified) < p.every && (p.burst <= 0 || stored(fs, dir) < p.burst) {
        return st
      }
    }
    _ => {}
  }
  // the stamp first: a concurrent process sees it and skips the walk
  match fs.write(stamp, b"") {
    Ok(_) => fs.set_modified(stamp, clock.now()).ignore_err("the stamp only limits prunes")
    Err(_) => {}
  }
  if p.burst > 0 {
    fs.remove("${dir}/prune-stored").ignore_err("none stored since the last prune")
  }
  st.ran = true
  var kept: List[Entry] = []
  var total = 0
  var subdirs: List[Entry] = []
  for e in entries(fs, clock, dir, p.dirs, p.keep, subdirs) {
    let idle = clock.since(e.used)
    if p.max_age.nanos() > 0 && idle > p.max_age && idle >= p.keep && remove(fs, clock, e.path, p.dirs, p.keep) {
      st.removed.push(e.path)
      continue
    }
    kept.push(e)
    total += e.size
  }
  if p.max_bytes > 0 && total > p.max_bytes {
    for e in kept.sort_by(fn(x) { x.used.unix_millis() }) {
      if total <= p.max_bytes || clock.since(e.used) < p.keep {
        // oldest first: everything left was used within keep
        break
      }
      if remove(fs, clock, e.path, p.dirs, p.keep) {
        st.removed.push(e.path)
        total -= e.size
      }
    }
  }
  // empty directories below the top level, deepest first (walk lists
  // parents before children); remove fails on one that is not empty
  if p.max_age.nanos() > 0 {
    var i = subdirs.len() - 1
    while i >= 0 {
      let d = subdirs[i]
      let idle = clock.since(d.used)
      if idle > p.max_age && idle >= p.keep {
        fs.remove(d.path).ignore_err("not empty, or another process removed it")
      }
      i -= 1
    }
  }
  st.bytes = total
  st
}

/// Adds n to the bytes stored in the cache in dir since its last prune
/// (DIR/prune-stored), for Policy.burst. Two processes adding at once
/// can lose one count: the next store or the interval's prune covers it.
pub fn note_stored(fs: Fs, dir: Str, n: Int) uses (fs.read, fs.write) {
  if n <= 0 {
    return
  }
  fs.write("${dir}/prune-stored", "${stored(fs, dir) + n}".bytes()).ignore_err("only the burst prune")
}

/// The bytes stored in the cache in dir since its last prune (0 when
/// none are recorded).
fn stored(fs: Fs, dir: Str) -> Int uses fs.read {
  match fs.read("${dir}/prune-stored") {
    Ok(b) => Int.parse((b.to_str() ?? "").trim()) ?? 0
    Err(_) => 0
  }
}

/// The entries of the cache in dir; files left under a temporary name
/// (".tmp" in the name) for over keep are removed on the way. Without
/// dirs, the directories below the top level go to subdirs in walk order.
fn entries(fs: Fs, clock: Clock, dir: Str, dirs: Bool, keep: Duration, var subdirs: List[Entry]) -> List[Entry] uses (fs.read, fs.write, clock) {
  var out: List[Entry] = []
  if dirs {
    let top = match fs.read_dir(dir) {
      Ok(l) => l
      Err(_) => return out
    }
    for fi in top {
      if !fi.is_dir {
        continue
      }
      let path = "${dir}/${fi.name}"
      var size = 0
      match fs.walk(path) {
        Ok(all) => {
          for f in all {
            if !f.is_dir {
              size += f.size
            }
          }
        }
        Err(_) => {}
      }
      out.push(Entry{path: path, size: size, used: fi.modified})
    }
    return out
  }
  let all = match fs.walk(dir) {
    Ok(l) => l
    Err(_) => return out
  }
  for fi in all {
    let rel = fi.path.trim_prefix("${dir}/")
    if fi.is_dir && rel.contains("/") {
      subdirs.push(Entry{path: fi.path, size: 0, used: fi.modified})
    }
    if fi.is_dir || !rel.contains("/") {
      continue
    }
    if fi.name.contains(".tmp") {
      if clock.since(fi.modified) > keep {
        fs.remove(fi.path).ignore_err("another process may own it")
      }
      continue
    }
    out.push(Entry{path: fi.path, size: fi.size, used: fi.modified})
  }
  out
}

/// Removes the entry at path unless it was used within keep (restated
/// now: a process may have marked it since the walk); true when it is
/// gone.
fn remove(fs: Fs, clock: Clock, path: Str, dir: Bool, keep: Duration) -> Bool uses (fs.read, fs.write, clock) {
  match fs.stat(path) {
    Ok(Some(fi)) => {
      if clock.since(fi.modified) < keep {
        return false
      }
    }
    _ => return false
  }
  let r = if dir { fs.remove_all(path) } else { fs.remove(path) }
  r.is_ok()
}
