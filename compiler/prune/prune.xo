// Age and size pruning of xo's caches under <user cache>/xo, shared by
// every cache the driver writes: the build directories (build/), the Go
// backend's GOCACHE (gocache/), the linked binary cache ($XO_BIN_CACHE),
// and the back-end cache of decision 0220's addendum.
//
// The stamp format, the same for every cache:
//
// - An entry's last use is its modification time. A reader marks an
//   entry used with mark_used, which refreshes the time only when it is
//   over TOUCH (an hour) old, so a hit costs one stat (Go's own cache
//   does the same, hourly). A writer stores an entry under a temporary
//   name and renames it into place, so its time is the store's.
// - A cache's last prune is the modification time of DIR/prune-stamp.
// - The bytes stored since then are DIR/prune-stored (decimal text),
//   which note_stored adds to, for Policy.burst.
//
// run removes, at most once per Policy.every (or sooner once Policy.burst
// bytes were stored since the last prune), the entries unused for
// longer than Policy.max_age, then the least recently used ones while the
// cache is over Policy.max_bytes. An entry used within KEEP (two hours)
// is never removed: mark_used may leave a time up to an hour old while a
// process is using the entry, and Go refreshes its entries hourly, so
// the margin covers a build of up to an hour after a refresh. Each entry
// is restated just before it is removed, so one used since the walk
// stays. Removal tolerates failures: another process may remove the same
// entry. Decision 0223. A cache of files also loses its empty
// directories below the top level (the back-end cache's pack slots, one
// per build target) once they are unused for longer than max_age; the
// top level's (GOCACHE's 00 to ff) stay. A run may have a budget (a
// time, a number of removals): past it, it stops removing and leaves the
// stamp due, so the next run goes on (a build falling on a prune after a
// busy period paid for all of it).

/// An entry used within KEEP is never removed.
pub const KEEP: Duration = 2h

/// A run stopped at its budget leaves the stamp due again this much
/// later.
pub const PARTIAL_PAUSE: Duration = 1m

/// mark_used refreshes an entry's time once it is older than TOUCH.
pub const TOUCH: Duration = 1h

/// The bytes of a GiB.
pub const GB: Int = 1024 * 1024 * 1024

/// A run holds DIR/prune-lock while it walks and removes; a lock older
/// than LOCK_STALE was left by a run that was killed (a build timed out
/// during a walk of a large cache), and no longer blocks the next run.
/// The stamp is written when a run ends: a killed run used to leave a
/// fresh stamp and block every prune for an interval (2026-10-21: the
/// back-end cache grew to 62 GB under a 16 GiB cap).
pub const LOCK_STALE: Duration = 10m

/// What a prune removes.
pub struct Policy {
  /// Entries unused for longer go; zero keeps entries of any age.
  pub max_age: Duration = 24h
  /// The size cap in bytes; zero or less is no cap.
  pub max_bytes: Int = 20 * 1024 * 1024 * 1024
  /// The least time between two prunes of one cache (the stamp's age).
  pub every: Duration = 1h
  /// true: each directory at the top of the cache is one entry (its
  /// time is the directory's, its size every file below it); false:
  /// each file below the top level is an entry (files at the top, such
  /// as the stamp and lock files, are never entries).
  pub dirs: Bool = false
  /// An entry used within keep is never removed (KEEP unless a cache
  /// whose entries are in use only briefly says otherwise, such as the
  /// test binaries of $XO_BIN_CACHE, decision 0236).
  pub keep: Duration = 2h
  /// Over zero: a run within every still prunes once the bytes stored
  /// since the last prune (note_stored) reach burst, so a burst of
  /// builds cannot grow the cache past the cap for a whole interval.
  pub burst: Int = 0
  /// Over zero: a run stops removing once it has run this long, and
  /// leaves the stamp due, so the next run (the next build) goes on
  /// where it stopped; a build that falls on a prune after a busy period
  /// paid for all of it (minutes of unlinking, 2026-10-21: a timed test
  /// building one golden timed out).
  pub budget: Duration = 0s
  /// Over zero: a run removes at most this many entries, the same way
  /// (the rest left for the next run).
  pub max_remove: Int = 0
  /// Over zero (a cache of files, not dirs): a run walks only a slice of
  /// the cache, the shards (the directories two levels down, such as
  /// fn/ab) after DIR/prune-cursor, until it has walked this long, and
  /// keeps each shard's bytes in DIR/prune-sizes; the cap is applied to
  /// the sum of those, each walked shard evicting its least recently
  /// used entries down to its share of the cap (run_sliced). A whole
  /// walk of a busy cache took 45 s (2026-10-21, 500,000 files), and a
  /// build that fell on it stalled.
  pub walk_budget: Duration = 0s
  /// Over zero: a sliced run walks at most this many shards (as
  /// walk_budget, by count; both may be set).
  pub slice_shards: Int = 0
  /// With dirs: the files below an entry whose names end in drop_suffix
  /// and that are unused for drop_idle are removed by every run, however
  /// recently their directory was used (the build directories' assembly:
  /// no build reads it after its link, and it held 28 GB of 40 under
  /// directories the keep protected, 2026-10-21).
  pub drop_suffix: Str = ""
  pub drop_idle: Duration = 0s
  /// Over one: a file counts as its size rounded up to a multiple of this,
  /// the allocation unit of the volume, so the cap bounds the disk the cache
  /// uses and not the bytes it holds (the back-end cache: 4096; 1.28M small
  /// files held 17.4 GiB by size and 25.9 GiB on the disk, 2026-10-24).
  pub block: Int = 0
  /// A sliced run removes the empty directories below a shard that were
  /// unused for this long (0: it leaves them to age out as dirs do). The
  /// back-end cache's targets leave one per build kind on their first
  /// build, and most targets are built once or twice: 1,467 empty
  /// directories in one of 256 shards, 2026-10-24.
  pub empty_idle: Duration = 0s
}

/// n bytes as the cache p counts them (Policy.block).
fn counted(p: Policy, n: Int) -> Int {
  if p.block > 1 && n > 0 {
    return (n + p.block - 1) / p.block * p.block
  }
  n
}

/// What one run did: whether it ran (the stamp allowed it), the paths it
/// removed, and the bytes the cache held afterwards.
pub struct Stats {
  pub ran: Bool = false
  /// the run stopped at its budget with entries left to remove
  pub partial: Bool = false
  pub removed: List[Str] = []
  pub bytes: Int = 0
  /// a sliced run: the shards the sizes ledger has no size for yet (its
  /// bytes count those as empty)
  pub unmeasured: Int = 0
}

struct Entry {
  path: Str
  size: Int
  used: Time
}

/// The policy base with $XO_CACHE_MAX_AGE (a Go duration such as 6h or
/// 90m; 0 turns age pruning off) and $XO_CACHE_MAX_GB (GiB, a decimal
/// such as 20 or 0.5; 0 turns the size cap off) applied when set and
/// valid.
pub fn from_env(env: Env, base: Policy) -> Policy uses env {
  var p = base
  let age = (env.get("XO_CACHE_MAX_AGE") ?? "").trim()
  if !age.is_empty() {
    match Duration.parse(age) {
      Ok(d) => {
        if d.nanos() >= 0 {
          p.max_age = d
        }
      }
      Err(_) => {}
    }
  }
  let gb = (env.get("XO_CACHE_MAX_GB") ?? "").trim()
  if !gb.is_empty() {
    if let Some(f) = Float.parse(gb) {
      if f >= 0.0 {
        p.max_bytes = Int(f * Float(GB))
      }
    }
  }
  p
}

/// Marks the entry at path used: its modification time is set to now
/// when it is over TOUCH old (one stat otherwise).
pub fn mark_used(fs: Fs, clock: Clock, path: Str) uses (fs.read, fs.write, clock) {
  mark_used_within(fs, clock, path, TOUCH)
}

/// mark_used with touch in place of TOUCH, for a cache whose keep is
/// shorter than KEEP (its touch must be shorter than its keep).
pub fn mark_used_within(fs: Fs, clock: Clock, path: Str, touch: Duration) uses (fs.read, fs.write, clock) {
  match fs.stat(path) {
    Ok(Some(fi)) => {
      if clock.since(fi.modified) >= touch {
        fs.set_modified(path, clock.now()).ignore_err("only the prune order")
      }
    }
    _ => {}
  }
}

/// Prunes the cache in dir by p (see the file comment).
pub fn run(fs: Fs, clock: Clock, dir: Str, p: Policy) -> Stats uses (fs.read, fs.write, clock) {
  var st = Stats{}
  if p.max_age.nanos() <= 0 && p.max_bytes <= 0 {
    return st
  }
  match fs.stat(dir) {
    Ok(Some(fi)) => {
      if !fi.is_dir {
        return st
      }
    }
    _ => return st
  }
  if !due(fs, clock, dir, p) {
    return st
  }
  if sliced(p) {
    return run_sliced(fs, clock, dir, p)
  }
  let stamp = "${dir}/prune-stamp"
  let lock = "${dir}/prune-lock"
  // the lock first: a concurrent process sees it and skips the walk
  match fs.write(lock, b"") {
    Ok(_) => fs.set_modified(lock, clock.now()).ignore_err("the lock only limits prunes")
    Err(_) => {}
  }
  let t0 = clock.now()
  if p.burst > 0 {
    fs.remove("${dir}/prune-stored").ignore_err("none stored since the last prune")
  }
  st.ran = true
  var kept: List[Entry] = []
  var total = 0
  var subdirs: List[Entry] = []
  let all = entries(fs, clock, dir, p, subdirs)
  // the budget is for the removals: a walk longer than it still lets a
  // run make progress
  let start = clock.now()
  var before = 0
  for e in all {
    before += e.size
  }
  for e in all {
    let idle = clock.since(e.used)
    if p.max_age.nanos() > 0 && idle > p.max_age && idle >= p.keep {
      if over_budget(clock, start, p, st.removed.len()) {
        st.partial = true
      } else if remove(fs, clock, e.path, p.dirs, p.keep) {
        st.removed.push(e.path)
        continue
      }
    }
    kept.push(e)
    total += e.size
  }
  if p.max_bytes > 0 && total > p.max_bytes {
    for e in kept.sort_by(fn(x) { x.used.unix_millis() }) {
      if total <= p.max_bytes || clock.since(e.used) < p.keep {
        // oldest first: everything left was used within keep
        break
      }
      if over_budget(clock, start, p, st.removed.len()) {
        st.partial = true
        break
      }
      if remove(fs, clock, e.path, p.dirs, p.keep) {
        st.removed.push(e.path)
        total -= e.size
      }
    }
  }
  // empty directories below the top level, deepest first (walk lists
  // parents before children); remove fails on one that is not empty
  if p.max_age.nanos() > 0 {
    var i = subdirs.len() - 1
    while i >= 0 {
      let d = subdirs[i]
      let idle = clock.since(d.used)
      if idle > p.max_age && idle >= p.keep {
        fs.remove(d.path).ignore_err("not empty, or another process removed it")
      }
      i -= 1
    }
  }
  // over the cap with nothing left to remove: the burst backs off
  if p.max_bytes > 0 && total > p.max_bytes && !st.partial {
    fs.write("${dir}/prune-over", b"").ignore_err("the burst may prune again")
  } else {
    fs.remove("${dir}/prune-over").ignore_err("none")
  }
  match fs.write(stamp, b"") {
    Ok(_) => fs.set_modified(stamp, clock.now()).ignore_err("the stamp only limits prunes")
    Err(_) => {}
  }
  if st.partial {
    // due again in PARTIAL_PAUSE (or every, if shorter): the next build
    // goes on, not this build's next store
    let pause = if p.every < PARTIAL_PAUSE { p.every } else { PARTIAL_PAUSE }
    fs.set_modified(stamp, clock.now() - p.every + pause).ignore_err("the next interval's prune goes on")
  }
  fs.remove(lock).ignore_err("another run's lock went stale")
  st.bytes = total
  // one line per run: what the walk found and what the run left
  let line = "${clock.now().unix()} walk ${start.unix_millis() - t0.unix_millis()} ms, ${all.len()} entries, ${before} bytes before, ${total} after, ${st.removed.len()} removed${if st.partial { ", partial" } else { "" }}, cap ${p.max_bytes}\n"
  fs.append("${dir}/prune-log", line.bytes()).ignore_err("only the log")
  st
}

/// Whether a run of the cache in dir is due under p (run's own check,
/// without the walk): its stamp is older than p.every, or the bytes
/// stored since reach p.burst (not while a run that left the cache over
/// its cap could remove nothing more, until p.keep passed), and no run
/// holds the lock (one younger than LOCK_STALE).
pub fn due(fs: Fs, clock: Clock, dir: Str, p: Policy) -> Bool uses (fs.read, clock) {
  if p.max_age.nanos() <= 0 && p.max_bytes <= 0 {
    return false
  }
  if let Ok(Some(fi)) = fs.stat("${dir}/prune-lock") {
    if clock.since(fi.modified) < LOCK_STALE {
      return false
    }
  }
  if sliced(p) && !(fs.exists("${dir}/prune-stamp").ok() ?? false) {
    // a sliced cache's first store: its stamp, not a prune (a test's
    // cache directory would get a detached prune while it is removed)
    return false
  }
  match fs.stat("${dir}/prune-stamp") {
    Ok(Some(fi)) => {
      let since = clock.since(fi.modified)
      // a run that left the cache over its cap could remove nothing more
      // (every entry used within keep): a burst waits until keep has
      // passed (a busy day's back-end cache set one off on every build,
      // each walking all 332,535 files, 2026-10-21)
      let futile = fs.exists("${dir}/prune-over").ok() ?? false
      !(since < p.every && (p.burst <= 0 || stored(fs, dir) < p.burst || (futile && since < p.keep)))
    }
    _ => true
  }
}

/// Whether p prunes a slice of the shards per run (walk_budget,
/// slice_shards).
fn sliced(p: Policy) -> Bool {
  !p.dirs && (p.walk_budget.nanos() > 0 || p.slice_shards > 0)
}

/// The directories below root (a shard) that hold no file, as fis lists
/// them, and were unused for p.empty_idle and p.keep: removed deepest first
/// (remove fails on one that is not empty, or that a build just filled).
fn remove_empty_dirs(fs: Fs, clock: Clock, root: Str, fis: List[FileInfo], p: Policy) uses (fs.write, clock) {
  var full: Map[Str, Bool] = {}
  for fi in fis {
    if fi.is_dir {
      continue
    }
    var d = dir_of(fi.path)
    while d.len() > root.len() && !full.contains(d) {
      full[d] = true
      d = dir_of(d)
    }
  }
  var empty: List[FileInfo] = []
  for fi in fis {
    if fi.is_dir && fi.path.len() > root.len() && !full.contains(fi.path) {
      let idle = clock.since(fi.modified)
      if idle > p.empty_idle && idle >= p.keep {
        empty.push(fi)
      }
    }
  }
  let ord = empty.sort_by(fn(f) { -f.path.len() })
  for f in ord {
    fs.remove(f.path).ignore_err("not empty, or another process removed it")
  }
}

fn dir_of(path: Str) -> Str {
  match path.rfind("/") {
    Some(i) => path[0..i]
    None => ""
  }
}

/// run with p.walk_budget: one slice of the shards, the cap applied to
/// the sizes ledger (Policy.walk_budget).
fn run_sliced(fs: Fs, clock: Clock, dir: Str, p: Policy) -> Stats uses (fs.read, fs.write, clock) {
  var st = Stats{ran: true}
  let stamp = "${dir}/prune-stamp"
  let lock = "${dir}/prune-lock"
  match fs.write(lock, b"") {
    Ok(_) => fs.set_modified(lock, clock.now()).ignore_err("the lock only limits prunes")
    Err(_) => {}
  }
  if p.burst > 0 {
    fs.remove("${dir}/prune-stored").ignore_err("none stored since the last prune")
  }
  // a line before any removal: a run that dies on the way (a build
  // killed, a fault) still leaves its start (2026-10-21: 25 GB went with
  // no line, from runs that faulted before their end line)
  fs.append("${dir}/prune-log", "${clock.now().unix()} start cap ${p.max_bytes} age ${p.max_age} at ${clock.now().unix_millis()} ms\n".bytes()).ignore_err("only the log")
  let shards = shard_list(fs, dir)
  // the walk budget is the shards' walk, not their listing
  let t0 = clock.now()
  var sizes = read_sizes(fs, dir)
  // the shards from the cursor on, until the walk budget (at least one)
  let cursor = (fs.read_text("${dir}/prune-cursor").ok() ?? "").trim()
  var first = 0
  for (k, s) in shards.indexed() {
    if s > cursor {
      first = k
      break
    }
  }
  var walked: List[(Str, List[Entry])] = []
  var k = 0
  var last = cursor
  while k < shards.len() && (k == 0 || ((p.walk_budget.nanos() <= 0 || clock.since(t0) < p.walk_budget) && (p.slice_shards <= 0 || k < p.slice_shards))) {
    let s = shards[(first + k) % shards.len()]
    var fis: List[FileInfo] = []
    if s.contains("/") {
      walk_into(fs, "${dir}/${s}", fis)
    } else if let Ok(l) = fs.read_dir("${dir}/${s}") {
      // a top level directory's own files (its directories are shards)
      for fi in l {
        if !fi.is_dir {
          var f = fi
          f.path = "${dir}/${s}/${fi.name}"
          fis.push(f)
        }
      }
    }
    var es: List[Entry] = []
    var bytes = 0
    if p.empty_idle.nanos() > 0 && s.contains("/") {
      remove_empty_dirs(fs, clock, "${dir}/${s}", fis, p)
    }
    for fi in fis {
      if fi.is_dir {
        continue
      }
      if fi.name.contains(".tmp") {
        if clock.since(fi.modified) > p.keep {
          fs.remove(fi.path).ignore_err("another process may own it")
        }
        continue
      }
      es.push(Entry{path: fi.path, size: counted(p, fi.size), used: fi.modified})
      bytes += counted(p, fi.size)
    }
    sizes[s] = bytes
    walked.push((s, es))
    last = s
    k += 1
  }
  let walk_ms = clock.since(t0).millis()
  // shards gone since the ledger was written
  var live: Map[Str, Bool] = {}
  for s in shards {
    live[s] = true
  }
  var total = 0
  var kept_sizes: Map[Str, Int] = {}
  for (s, n) in sizes {
    if live.contains(s) {
      kept_sizes[s] = n
      total += n
    }
  }
  st.unmeasured = shards.len() - kept_sizes.len()
  let before = total
  let start = clock.now()
  // a run that walked every shard knows every entry: it evicts the least
  // recently used across them all (below); a slice evicts each shard to
  // its share of the cap, scaled by the total the run started from (a
  // total lowered shard by shard gave later shards larger shares, and a
  // whole walk left the cache over its cap, 2026-10-21)
  let whole = walked.len() >= shards.len()
  // the shard a run stopped in at its budget: the next run starts there
  var stopped = ""
  var olds: List[(Str, Entry)] = []
  for (s, es) in walked {
    if st.partial {
      break
    }
    var size = kept_sizes.get(s) ?? 0
    // the shard's share of the cap: its bytes scaled by cap / total
    let share = if !whole && p.max_bytes > 0 && before > p.max_bytes { share_of(size, p.max_bytes, before) } else { size }
    var rest: List[Entry] = []
    for e in es {
      let idle = clock.since(e.used)
      if p.max_age.nanos() > 0 && idle > p.max_age && idle >= p.keep && !st.partial {
        if over_budget(clock, start, p, st.removed.len()) {
          st.partial = true
          stopped = s
        } else if remove(fs, clock, e.path, false, p.keep) {
          st.removed.push(e.path)
          size -= e.size
          continue
        }
      }
      rest.push(e)
    }
    if size > share {
      for e in rest.sort_by(fn(x) { x.used.unix_millis() }) {
        if size <= share || clock.since(e.used) < p.keep {
          break
        }
        if over_budget(clock, start, p, st.removed.len()) {
          st.partial = true
          stopped = s
          break
        }
        if remove(fs, clock, e.path, false, p.keep) {
          st.removed.push(e.path)
          size -= e.size
        }
      }
    }
    total = total - (kept_sizes.get(s) ?? 0) + size
    kept_sizes[s] = size
    if whole {
      for e in rest {
        olds.push((s, e))
      }
    }
  }
  if whole && p.max_bytes > 0 && total > p.max_bytes && !st.partial {
    for (s, e) in olds.sort_by(fn(x) { x.1.used.unix_millis() }) {
      if total <= p.max_bytes || clock.since(e.used) < p.keep {
        break
      }
      if over_budget(clock, start, p, st.removed.len()) {
        st.partial = true
        stopped = s
        break
      }
      if remove(fs, clock, e.path, false, p.keep) {
        st.removed.push(e.path)
        total -= e.size
        kept_sizes[s] = (kept_sizes.get(s) ?? 0) - e.size
      }
    }
  }
  write_sizes(fs, dir, kept_sizes)
  if !stopped.is_empty() {
    // the cursor names the shard before: a run starts after its cursor
    last = ""
    for (k, s) in shards.indexed() {
      if s == stopped {
        last = if k == 0 { "" } else { shards[k - 1] }
      }
    }
  }
  fs.write("${dir}/prune-cursor", last.bytes()).ignore_err("the next run starts over")
  // over the cap with the whole cache walked since: the burst backs off
  if p.max_bytes > 0 && total > p.max_bytes && !st.partial && walked.len() >= shards.len() {
    fs.write("${dir}/prune-over", b"").ignore_err("the burst may prune again")
  } else {
    fs.remove("${dir}/prune-over").ignore_err("none")
  }
  match fs.write(stamp, b"") {
    Ok(_) => fs.set_modified(stamp, clock.now()).ignore_err("the stamp only limits prunes")
    Err(_) => {}
  }
  if st.partial || (p.max_bytes > 0 && total > p.max_bytes) {
    // over the cap: the next slice is due in PARTIAL_PAUSE (or every)
    let pause = if p.every < PARTIAL_PAUSE { p.every } else { PARTIAL_PAUSE }
    fs.set_modified(stamp, clock.now() - p.every + pause).ignore_err("the next slice goes on")
  }
  fs.remove(lock).ignore_err("another run's lock went stale")
  st.bytes = total
  let line = "${clock.now().unix()} slice ${walked.len()}/${shards.len()} shards from ${cursor.quote()}, walk ${walk_ms} ms, ${before} bytes before, ${total} after, ${st.removed.len()} removed${if st.partial { ", partial" } else { "" }}, cap ${p.max_bytes}\n"
  fs.append("${dir}/prune-log", line.bytes()).ignore_err("only the log")
  st
}

/// Removes the directories under dir named trash-* (a cache's retired
/// layout, renamed there whole by retire), for a detached prune: each is
/// many files, too long for a build.
pub fn prune_trash(fs: Fs, dir: Str) uses (fs.read, fs.write) {
  if let Ok(top) = fs.read_dir(dir) {
    for t in top {
      if t.is_dir && t.name.starts_with("trash-") {
        fs.remove_all("${dir}/${t.name}").ignore_err("another prune removes it")
      }
    }
  }
}

/// Renames dir/name, a layout the cache no longer reads, to a trash-*
/// directory (one rename; prune_trash removes it). Nothing when it is
/// absent.
pub fn retire(fs: Fs, clock: Clock, dir: Str, name: Str) uses (fs.read, fs.write, clock) {
  if fs.exists("${dir}/${name}").ok() ?? false {
    fs.rename("${dir}/${name}", "${dir}/trash-${name}-${clock.now().unix_millis()}").ignore_err("another prune retired it")
  }
}

/// size scaled by cap / total, in Float: size * cap overflowed Int once
/// a shard held over 512 MiB under a 16 GiB cap (2026-10-21: every
/// detached prune faulted before removing anything, and the back-end
/// cache grew to 49 GB).
fn share_of(size: Int, cap: Int, total: Int) -> Int {
  if total <= 0 {
    return size
  }
  Int(Float(size) * (Float(cap) / Float(total)))
}

/// The shards of the cache in dir, sorted: each directory one level
/// below a top level directory (`fn/ab`, `packs/ab`), and each top level
/// directory holding files of its own (`stdsums`: those files alone).
fn shard_list(fs: Fs, dir: Str) -> List[Str] uses fs.read {
  var out: List[Str] = []
  let top = match fs.read_dir(dir) {
    Ok(l) => l
    Err(_) => return out
  }
  for t in top {
    // trash-*: directories a cache retired whole (prune_trash)
    if !t.is_dir || t.name.starts_with("trash-") {
      continue
    }
    if let Ok(l) = fs.read_dir("${dir}/${t.name}") {
      var files = false
      for c in l {
        if c.is_dir {
          out.push("${t.name}/${c.name}")
        } else {
          files = true
        }
      }
      if files {
        out.push(t.name)
      }
    }
  }
  out.sort()
}

/// The sizes ledger (DIR/prune-sizes): a line `bytes shard` per shard.
fn read_sizes(fs: Fs, dir: Str) -> Map[Str, Int] uses fs.read {
  var m: Map[Str, Int] = {}
  for line in (fs.read_text("${dir}/prune-sizes").ok() ?? "").split("\n") {
    let parts = line.split(" ")
    if parts.len() == 2 {
      if let Some(n) = Int.parse(parts[0]) {
        m[parts[1]] = n
      }
    }
  }
  m
}

fn write_sizes(fs: Fs, dir: Str, m: Map[Str, Int]) uses fs.write {
  var b = StrBuilder.new()
  for s in m.keys().sort() {
    b.write("${m.get(s) ?? 0} ${s}\n")
  }
  fs.write("${dir}/prune-sizes", b.freeze().bytes()).ignore_err("the next slice measures again")
}

/// Whether a run that started at start and removed n entries has used
/// up p.budget or p.max_remove.
fn over_budget(clock: Clock, start: Time, p: Policy, n: Int) -> Bool {
  (p.budget.nanos() > 0 && clock.since(start) >= p.budget) || (p.max_remove > 0 && n >= p.max_remove)
}

/// Adds n to the bytes stored in the cache in dir since its last prune
/// (DIR/prune-stored), for Policy.burst. Two processes adding at once
/// can lose one count: the next store or the interval's prune covers it.
pub fn note_stored(fs: Fs, dir: Str, n: Int) uses (fs.read, fs.write) {
  if n <= 0 {
    return
  }
  fs.write("${dir}/prune-stored", "${stored(fs, dir) + n}".bytes()).ignore_err("only the burst prune")
}

/// The bytes stored in the cache in dir since its last prune (0 when
/// none are recorded).
fn stored(fs: Fs, dir: Str) -> Int uses fs.read {
  match fs.read("${dir}/prune-stored") {
    Ok(b) => Int.parse((b.to_str() ?? "").trim()) ?? 0
    Err(_) => 0
  }
}

/// The entries of the cache in dir; files left under a temporary name
/// (".tmp" in the name) for over keep are removed on the way. Without
/// dirs, the directories below the top level go to subdirs in walk order.
fn entries(fs: Fs, clock: Clock, dir: Str, p: Policy, var subdirs: List[Entry]) -> List[Entry] uses (fs.read, fs.write, clock) {
  let dirs = p.dirs
  let keep = p.keep
  var out: List[Entry] = []
  if dirs {
    let top = match fs.read_dir(dir) {
      Ok(l) => l
      Err(_) => return out
    }
    for fi in top {
      if !fi.is_dir {
        continue
      }
      let path = "${dir}/${fi.name}"
      var size = 0
      match fs.walk(path) {
        Ok(all) => {
          for f in all {
            if f.is_dir {
              continue
            }
            if !p.drop_suffix.is_empty() && f.name.ends_with(p.drop_suffix) && clock.since(f.modified) >= p.drop_idle {
              if fs.remove(f.path).is_ok() {
                continue
              }
            }
            size += counted(p, f.size)
          }
        }
        Err(_) => {}
      }
      out.push(Entry{path: path, size: size, used: fi.modified})
    }
    return out
  }
  // not fs.walk: one directory removed between its listing and its walk
  // (another build compacting a pack) failed the whole walk, and the run
  // saw an empty cache
  var all: List[FileInfo] = []
  walk_into(fs, dir, all)
  for fi in all {
    let rel = fi.path.trim_prefix("${dir}/")
    if fi.is_dir && rel.contains("/") {
      subdirs.push(Entry{path: fi.path, size: 0, used: fi.modified})
    }
    if fi.is_dir || !rel.contains("/") {
      continue
    }
    if fi.name.contains(".tmp") {
      if clock.since(fi.modified) > keep {
        fs.remove(fi.path).ignore_err("another process may own it")
      }
      continue
    }
    out.push(Entry{path: fi.path, size: counted(p, fi.size), used: fi.modified})
  }
  out
}

/// The files and directories below dir, depth first, each with its path
/// (fs.walk's), skipping any directory that cannot be read (removed
/// since its parent was listed).
fn walk_into(fs: Fs, dir: Str, var out: List[FileInfo]) uses fs.read {
  let l = match fs.read_dir(dir) {
    Ok(l) => l
    Err(_) => return
  }
  for fi in l {
    var f = fi
    f.path = "${dir}/${fi.name}"
    out.push(f)
    if fi.is_dir {
      walk_into(fs, f.path, out)
    }
  }
}

/// Removes the entry at path unless it was used within keep (restated
/// now: a process may have marked it since the walk); true when it is
/// gone.
fn remove(fs: Fs, clock: Clock, path: Str, dir: Bool, keep: Duration) -> Bool uses (fs.read, fs.write, clock) {
  match fs.stat(path) {
    Ok(Some(fi)) => {
      if clock.since(fi.modified) < keep {
        return false
      }
    }
    // gone already (a concurrent prune removed it): its bytes left the
    // cache too, so it counts; counting it as kept made concurrent runs
    // each remove the next oldest entries in its place, and they took a
    // cache far below its cap (2026-10-21: 29 GB to 3.55 GB under 16)
    Ok(None) => return true
    Err(_) => return false
  }
  let r = if dir { fs.remove_all(path) } else { fs.remove(path) }
  r.is_ok() || !(fs.exists(path).ok() ?? true)
}
