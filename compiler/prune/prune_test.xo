// Tests of the cache pruning (decision 0223), on the in memory file system
// and the virtual clock: no real time passes.

/// Writes a file of n bytes (its time is the virtual clock's now).
fn put(os: testing.TestOs, path: Str, n: Int) {
  os.fs.write(path, "x".repeat(n).bytes()).or_fault("write ${path}")
}

fn there(os: testing.TestOs, path: Str) -> Bool {
  os.fs.exists(path).or_fault("exists ${path}")
}

test "entries unused past the age limit go, recent ones stay" {
  put(os, "c/aa/old", 10)
  os.clock.advance(30h)
  put(os, "c/bb/new", 10)
  let st = run(os.fs, os.clock, "c", Policy{})
  expect(st.ran) == true
  expect(st.removed) == ["c/aa/old"]
  expect(there(os, "c/aa/old")) == false
  expect(there(os, "c/bb/new")) == true
  expect(st.bytes) == 10
}

test "an entry in use is never removed, over the age and the cap" {
  put(os, "c/aa/busy", 100)
  put(os, "c/aa/idle", 100)
  os.clock.advance(30h)
  // a reader hits busy: marked used, so it is not stale
  mark_used(os.fs, os.clock, "c/aa/busy")
  // even with a cap of one byte, an entry used within KEEP stays
  let st = run(os.fs, os.clock, "c", Policy{max_bytes: 1})
  expect(st.removed) == ["c/aa/idle"]
  expect(there(os, "c/aa/busy")) == true
  expect(st.bytes) == 100
}

test "mark_used costs one stat within the hour and refreshes after it" {
  put(os, "c/aa/e", 1)
  os.clock.advance(30m)
  mark_used(os.fs, os.clock, "c/aa/e")
  let fi = os.fs.stat("c/aa/e").or_fault("stat").or_fault("missing")
  expect(os.clock.since(fi.modified)) == 30m
  os.clock.advance(31m)
  mark_used(os.fs, os.clock, "c/aa/e")
  let fj = os.fs.stat("c/aa/e").or_fault("stat").or_fault("missing")
  expect(os.clock.since(fj.modified)) == 0s
}

test "over the cap the least recently used go first, until under it" {
  put(os, "c/aa/1", 40)
  os.clock.advance(3h)
  put(os, "c/aa/2", 40)
  os.clock.advance(3h)
  put(os, "c/bb/3", 40)
  os.clock.advance(3h)
  let st = run(os.fs, os.clock, "c", Policy{max_bytes: 100})
  expect(st.removed) == ["c/aa/1"]
  expect(st.bytes) == 80
  expect(there(os, "c/aa/2")) == true
}

test "the stamp limits prunes to one per interval" {
  put(os, "c/aa/1", 1)
  expect(run(os.fs, os.clock, "c", Policy{}).ran) == true
  os.clock.advance(30h)
  let st = run(os.fs, os.clock, "c", Policy{every: 31h})
  expect(st.ran) == false
  expect(there(os, "c/aa/1")) == true
  os.clock.advance(1h)
  expect(run(os.fs, os.clock, "c", Policy{every: 31h}).removed) == ["c/aa/1"]
}

test "top level files (stamps, locks) are never entries" {
  put(os, "c/xo-cache.lock", 5)
  put(os, "c/trim.txt", 5)
  os.clock.advance(100h)
  let st = run(os.fs, os.clock, "c", Policy{max_bytes: 1})
  expect(st.removed.len()) == 0
  expect(there(os, "c/xo-cache.lock")) == true
}

test "temporary files are left alone while recent and removed when old" {
  put(os, "c/aa/x.tmp-123", 5)
  os.clock.advance(1h)
  run(os.fs, os.clock, "c", Policy{})
  expect(there(os, "c/aa/x.tmp-123")) == true
  os.clock.advance(2h)
  run(os.fs, os.clock, "c", Policy{})
  expect(there(os, "c/aa/x.tmp-123")) == false
}

test "directory entries go whole, sized by their files, timed by the directory" {
  put(os, "b/one/m/a.go", 30)
  put(os, "b/one/bin/p", 30)
  os.clock.advance(5h)
  put(os, "b/two/a.go", 30)
  os.clock.advance(5h)
  // one was used again (build_dir sets the directory's time)
  os.fs.set_modified("b/one", os.clock.now()).or_fault("touch")
  put(os, "b/three/a.go", 30)
  let st = run(os.fs, os.clock, "b", Policy{max_bytes: 100, dirs: true})
  expect(st.removed) == ["b/two"]
  expect(there(os, "b/two/a.go")) == false
  expect(there(os, "b/one/bin/p")) == true
  expect(st.bytes) == 90
}

test "zero age and zero cap turn pruning off" {
  put(os, "c/aa/1", 5)
  os.clock.advance(1000h)
  let st = run(os.fs, os.clock, "c", Policy{max_age: 0s, max_bytes: 0})
  expect(st.ran) == false
  expect(there(os, "c/aa/1")) == true
}

test "the environment sets the age and the cap" {
  os.env.set("XO_CACHE_MAX_AGE", "6h")
  os.env.set("XO_CACHE_MAX_GB", "0.5")
  let p = from_env(os.env, Policy{})
  expect(p.max_age) == 6h
  expect(p.max_bytes) == GB / 2
  os.env.set("XO_CACHE_MAX_AGE", "0")
  os.env.set("XO_CACHE_MAX_GB", "junk")
  let q = from_env(os.env, Policy{})
  expect(q.max_age) == 0s
  expect(q.max_bytes) == 20 * GB
}

test "a missing cache directory is no prune" {
  expect(run(os.fs, os.clock, "nothing", Policy{}).ran) == false
}

test "a shorter keep lets the cap remove entries younger than KEEP" {
  // the test binary cache (decision 0236): keep 10m, touch 1m
  put(os, "c/aa/1", 40)
  os.clock.advance(20m)
  put(os, "c/aa/2", 40)
  os.clock.advance(20m)
  put(os, "c/bb/3", 40)
  os.clock.advance(5m)
  let p = Policy{max_bytes: 50, every: 2m, keep: 10m}
  let st = run(os.fs, os.clock, "c", p)
  expect(st.removed) == ["c/aa/1", "c/aa/2"]
  expect(there(os, "c/bb/3")) == true
  // with KEEP's two hours nothing that young goes
  put(os, "c/aa/4", 40)
  os.clock.advance(20m)
  let st2 = run(os.fs, os.clock, "c", Policy{max_bytes: 50, every: 0s})
  expect(st2.removed) == []
  mark_used_within(os.fs, os.clock, "c/bb/3", 1m)
  let fi = os.fs.stat("c/bb/3").or_fault("stat").or_fault("missing")
  expect(os.clock.since(fi.modified)) == 0s
}

test "a burst of stores prunes before the interval and keeps the cache near its cap" {
  // the back-end cache (compiler/xo bcache.xo): keep 2m, burst an eighth
  // of the cap; a store of 50 bytes every 10 seconds for an hour, each
  // followed by note_stored and run, as fn_cache_store does
  let p = Policy{max_age: 168h, max_bytes: 1000, keep: 2m, burst: 125}
  var most = 0
  var runs = 0
  for i in 0..360 {
    put(os, "c/${i % 7}${i % 5}/${i}", 50)
    note_stored(os.fs, "c", 50)
    if run(os.fs, os.clock, "c", p).ran {
      runs += 1
    }
    var total = 0
    for fi in os.fs.walk("c").or_fault("walk") {
      if !fi.is_dir && fi.path.trim_prefix("c/").contains("/") {
        total += fi.size
      }
    }
    most = most.max(total)
    os.clock.advance(10s)
  }
  // without burst one run in the hour and 18,000 bytes at its end
  expect(runs > 100) == true
  expect(most <= 1000 + 125) == true
}

test "note_stored adds up, and a prune starts the count again" {
  put(os, "c/aa/1", 1)
  note_stored(os.fs, "c", 100)
  note_stored(os.fs, "c", 0)
  note_stored(os.fs, "c", 23)
  expect(os.fs.read("c/prune-stored").or_fault("read").to_str() ?? "") == "123"
  expect(run(os.fs, os.clock, "c", Policy{burst: 200}).ran) == true
  expect(there(os, "c/prune-stored")) == false
  note_stored(os.fs, "c", 150)
  expect(run(os.fs, os.clock, "c", Policy{burst: 200}).ran) == false
  note_stored(os.fs, "c", 50)
  expect(run(os.fs, os.clock, "c", Policy{burst: 200}).ran) == true
  expect(there(os, "c/aa/1")) == true
}

test "empty directories below the top level go once unused past the age limit" {
  os.fs.create_dir_all("c/pack/s1/fn").or_fault("mkdir")
  os.fs.create_dir_all("c/aa").or_fault("mkdir")
  os.clock.advance(1h)
  run(os.fs, os.clock, "c", Policy{})
  // within the age limit: a target's first build left it, kept
  expect(there(os, "c/pack/s1/fn")) == true
  os.clock.advance(300h)
  put(os, "c/pack/s2/fn/seg", 10)
  run(os.fs, os.clock, "c", Policy{every: 0s})
  expect(there(os, "c/pack/s1/fn")) == false
  expect(there(os, "c/pack/s1")) == false
  // not empty, or at the top level: kept
  expect(there(os, "c/pack/s2/fn/seg")) == true
  expect(there(os, "c/aa")) == true
}

test "a run past its budget stops, and the next run goes on where it stopped" {
  for i in 0..5 {
    put(os, "c/aa/${i}", 10)
  }
  os.clock.advance(30h)
  let p = Policy{max_remove: 2}
  let a = run(os.fs, os.clock, "c", p)
  expect(a.removed.len()) == 2
  expect(a.partial) == true
  // the same build's next store does not prune again; the next build
  // (PARTIAL_PAUSE later) goes on
  expect(run(os.fs, os.clock, "c", p).ran) == false
  os.clock.advance(PARTIAL_PAUSE)
  let b = run(os.fs, os.clock, "c", p)
  expect(b.ran) == true
  expect(b.removed.len()) == 2
  os.clock.advance(PARTIAL_PAUSE)
  let c = run(os.fs, os.clock, "c", p)
  expect(c.removed.len()) == 1
  expect(c.partial) == false
  // done: the interval holds again
  os.clock.advance(PARTIAL_PAUSE)
  expect(run(os.fs, os.clock, "c", p).ran) == false
}

test "the size cap under a budget: least recently used first, then on" {
  for i in 0..4 {
    put(os, "c/aa/${i}", 40)
    os.clock.advance(3h)
  }
  let p = Policy{max_age: 0s, max_bytes: 50, max_remove: 1}
  expect(run(os.fs, os.clock, "c", p).removed) == ["c/aa/0"]
  os.clock.advance(PARTIAL_PAUSE)
  expect(run(os.fs, os.clock, "c", p).removed) == ["c/aa/1"]
  os.clock.advance(PARTIAL_PAUSE)
  expect(run(os.fs, os.clock, "c", p).removed) == ["c/aa/2"]
  expect(there(os, "c/aa/3")) == true
}

test "the cap counts blocks: small files take a whole block each (Policy.block)" {
  for i in 0..4 {
    put(os, "c/aa/${i}", 40)
    os.clock.advance(3h)
  }
  // 160 bytes held, 16,384 on a 4 KiB volume: a cap of 10,000 evicts the two oldest
  let exact = Policy{max_age: 0s, max_bytes: 10000, every: 0s}
  expect(run(os.fs, os.clock, "c", exact).removed) == []
  let blocks = Policy{max_age: 0s, max_bytes: 10000, every: 0s, block: 4096}
  let st = run(os.fs, os.clock, "c", blocks)
  expect(st.removed) == ["c/aa/0", "c/aa/1"]
  expect(st.bytes) == 8192
}

test "a burst does not prune again a cache it could not bring under its cap until keep passes" {
  // every entry in use: a prune cannot get under the cap
  put(os, "c/aa/1", 600)
  put(os, "c/aa/2", 600)
  let p = Policy{every: 1h, burst: 100, keep: 2h, max_age: 0s, max_bytes: 1000}
  let a = run(os.fs, os.clock, "c", p)
  expect(a.ran) == true
  expect(a.bytes) == 1200
  // a burst stored: the last run was futile, so no prune within keep
  note_stored(os.fs, "c", 500)
  os.clock.advance(30m)
  expect(run(os.fs, os.clock, "c", p).ran) == false
  // past keep (2h since the entries' use) a prune can remove them
  os.clock.advance(91m)
  let b = run(os.fs, os.clock, "c", p)
  expect(b.ran) == true
  // the entries are past keep now: removed down to the cap, no backoff
  expect(b.bytes <= 1000) == true
  expect(there(os, "c/prune-over")) == false
}

/// A sliced cache of 8 shards (s/0 to s/7) of 4 entries of 100 bytes,
/// each entry its own minute older than the next, and its stamp.
fn sliced_cache(os: testing.TestOs) {
  for e in 0..4 {
    for s in 0..8 {
      put(os, "c/s/${s}/e${e}", 100)
    }
    os.clock.advance(1m)
  }
  put(os, "c/prune-stamp", 0)
  os.clock.advance(3h)
}

test "a sliced run walks at most its slice of the shards" {
  sliced_cache(os)
  let p = Policy{max_age: 0s, max_bytes: GB, every: 0s, slice_shards: 2}
  // under its cap: the run only measures, two shards at a time
  let st = run(os.fs, os.clock, "c", p)
  expect(st.ran) == true
  let sizes = os.fs.read_text("c/prune-sizes").or_fault("sizes")
  expect(sizes) == "400 s/0\n400 s/1\n"
  let st2 = run(os.fs, os.clock, "c", p)
  expect(st2.ran) == true
  expect(os.fs.read_text("c/prune-sizes").or_fault("sizes")) == "400 s/0\n400 s/1\n400 s/2\n400 s/3\n"
  // the cursor wraps after the last shard
  for _ in 0..2 {
    let _s = run(os.fs, os.clock, "c", p)
  }
  expect(os.fs.read_text("c/prune-cursor").or_fault("cursor")) == "s/7"
  let _s = run(os.fs, os.clock, "c", p)
  expect(os.fs.read_text("c/prune-cursor").or_fault("cursor")) == "s/1"
}

test "sliced runs converge under the cap, the oldest entries first" {
  sliced_cache(os)
  // 3,200 bytes against a cap of 1,600: a rotation measures, the next
  // brings each shard to its share
  let p = Policy{max_age: 0s, max_bytes: 1600, every: 0s, keep: 1m, slice_shards: 3}
  var last = 0
  for _ in 0..8 {
    let st = run(os.fs, os.clock, "c", p)
    last = st.bytes
  }
  expect(last <= 1600) == true
  var total = 0
  for s in 0..8 {
    // each shard kept its newest entries
    expect(there(os, "c/s/${s}/e3")) == true
    for e in 0..4 {
      if there(os, "c/s/${s}/e${e}") {
        total += 100
      }
    }
  }
  expect(total <= 1600) == true
  expect(total >= 800) == true
}

test "a lock younger than LOCK_STALE holds off a run, an older one does not" {
  sliced_cache(os)
  let p = Policy{max_age: 0s, max_bytes: 100, every: 0s, slice_shards: 8}
  put(os, "c/prune-lock", 0)
  expect(run(os.fs, os.clock, "c", p).ran) == false
  os.clock.advance(LOCK_STALE + 1s)
  expect(run(os.fs, os.clock, "c", p).ran) == true
  expect(there(os, "c/prune-lock")) == false
}

test "a retired layout leaves the shards and its trash is removed" {
  sliced_cache(os)
  for i in 0..50 {
    put(os, "c/pack/slot${i}/fn/s-1", 10)
  }
  retire(os.fs, os.clock, "c", "pack")
  expect(there(os, "c/pack")) == false
  let p = Policy{max_age: 0s, max_bytes: GB, every: 0s, slice_shards: 100}
  let _s = run(os.fs, os.clock, "c", p)
  // the shards are s/0 to s/7 alone: the trash is not walked
  expect(os.fs.read_text("c/prune-sizes").or_fault("sizes").split("\n").len()) == 9
  prune_trash(os.fs, "c")
  let left = os.fs.read_dir("c").or_fault("read c")
  for fi in left {
    expect(fi.name.starts_with("trash-")) == false
  }
}

test "a shard's share of the cap does not overflow at real sizes" {
  // a 613 MB shard of a 49 GB cache under 16 GiB (2026-10-21's fault)
  let share = share_of(613024918, 16 * GB, 49 * GB)
  expect(share > 200000000 && share < 210000000) == true
  expect(share_of(5, 10, 0)) == 5
  expect(share_of(GB * 1000, GB * 16, GB * 2000) == GB * 8) == true
}

/// The bytes of the files below dir, as du counts them.
fn du(os: testing.TestOs, dir: Str) -> Int {
  var n = 0
  for fi in os.fs.walk(dir).or_fault("walk ${dir}") {
    if !fi.is_dir && fi.path.trim_prefix("${dir}/").contains("/") {
      n += fi.size
    }
  }
  n
}

test "a whole walk acts on current sizes after shards grew since they were measured" {
  // two pack shards measured small, then appended to past the cap
  // (2026-10-21: the ledger said 16 GB of a 49 GB cache)
  for s in 0..4 {
    put(os, "c/packs/${s}/seg0", 100)
  }
  put(os, "c/prune-stamp", 0)
  os.clock.advance(3h)
  let measure = Policy{max_age: 0s, max_bytes: GB, every: 0s, keep: 1m, slice_shards: 4}
  let _m = run(os.fs, os.clock, "c", measure)
  for s in 0..4 {
    for k in 1..5 {
      put(os, "c/packs/${s}/seg${k}", 1000)
    }
  }
  os.clock.advance(3h)
  // the detached child's policy: every shard each run
  let whole = Policy{max_age: 0s, max_bytes: 6000, every: 0s, keep: 1m, walk_budget: 60s}
  let st = run(os.fs, os.clock, "c", whole)
  expect(st.bytes <= 6000) == true
  expect(du(os, "c") <= 6000) == true
}

test "a whole walk of a cache twice its cap ends between 90% and 100% of it" {
  // 8 shards of 25 entries of 100 bytes: 20,000 bytes against 10,000
  for e in 0..25 {
    for s in 0..8 {
      put(os, "c/s/${s}/e${e}", 100)
    }
    os.clock.advance(1m)
  }
  put(os, "c/prune-stamp", 0)
  os.clock.advance(3h)
  let p = Policy{max_age: 0s, max_bytes: 10000, every: 0s, keep: 1m, walk_budget: 60s}
  let st = run(os.fs, os.clock, "c", p)
  expect(st.bytes <= 10000 && st.bytes >= 9000) == true
  expect(du(os, "c") <= 10000 && du(os, "c") >= 9000) == true
  // the least recently used went first: each shard keeps its newest
  for s in 0..8 {
    expect(there(os, "c/s/${s}/e24")) == true
    expect(there(os, "c/s/${s}/e0")) == false
  }
}

test "a slice of a cache twice its cap does not overshoot it" {
  for e in 0..25 {
    for s in 0..8 {
      put(os, "c/s/${s}/e${e}", 100)
    }
    os.clock.advance(1m)
  }
  put(os, "c/prune-stamp", 0)
  os.clock.advance(3h)
  // a rotation to measure, then slices of 3 shards evicting to shares
  let p = Policy{max_age: 0s, max_bytes: 10000, every: 0s, keep: 1m, slice_shards: 3}
  for _ in 0..12 {
    let _s = run(os.fs, os.clock, "c", p)
  }
  expect(du(os, "c") <= 10000 && du(os, "c") >= 9000) == true
}

test "an entry another prune removed counts as removed" {
  put(os, "c/aa/x", 10)
  os.clock.advance(3h)
  os.fs.remove("c/aa/x").or_fault("remove")
  // gone: its bytes left the cache, so a run counts it and stops sooner
  expect(remove(os.fs, os.clock, "c/aa/x", false, 1m)) == true
}

test "a build directory's assembly goes after its idle time, whatever the directory's keep" {
  put(os, "b/aa/arm64/prog.s", 1000)
  put(os, "b/aa/arm64/prog.o", 10)
  os.clock.advance(11m)
  // the directory was used just now (a build of it): kept, its .s not
  put(os, "b/aa/arm64/prog.o", 10)
  put(os, "b/aa/stamp", 0)
  let p = Policy{dirs: true, max_bytes: 1 * GB, keep: 30m, drop_suffix: ".s", drop_idle: 10m}
  let st = run(os.fs, os.clock, "b", p)
  expect(there(os, "b/aa/arm64/prog.s")) == false
  expect(there(os, "b/aa/arm64/prog.o")) == true
  expect(st.bytes) == 10
}

test "a build directory thins to its bin/ after the idle time, however recently the directory was used" {
  put(os, "b/aa/arm64/w-1/prog-darwin.0.o", 1000)
  put(os, "b/aa/llvm-split/prog.ll", 500)
  put(os, "b/aa/arm64/bin/app", 300)
  os.clock.advance(3h)
  // a build of the directory just now: kept whole, its old files thinned
  put(os, "b/aa/arm64/fresh.o", 10)
  put(os, "b/aa/arm64/bin/app", 300)
  let p = Policy{dirs: true, max_bytes: 1 * GB, keep: 30m, thin_keep: "bin", thin_idle: 2h}
  let st = run(os.fs, os.clock, "b", p)
  expect(there(os, "b/aa/arm64/w-1/prog-darwin.0.o")) == false
  expect(there(os, "b/aa/llvm-split/prog.ll")) == false
  expect(there(os, "b/aa/arm64/fresh.o")) == true
  expect(there(os, "b/aa/arm64/bin/app")) == true
  expect(st.bytes) == 310
}

test "a build directory's bin/ outlives the thin idle time" {
  put(os, "b/aa/arm64/bin/app", 300)
  os.clock.advance(5h)
  put(os, "b/aa/stamp", 0)
  let p = Policy{dirs: true, max_bytes: 1 * GB, keep: 30m, thin_keep: "bin", thin_idle: 2h}
  run(os.fs, os.clock, "b", p)
  expect(there(os, "b/aa/arm64/bin/app")) == true
}

test "clean empties a cache: entries go, its stamp and lock files stay, dry removes nothing" {
  put(os, "r/xo/build/a1/prog", 100)
  put(os, "r/xo/build/b2/prog.s", 50)
  put(os, "r/xo/build/prune-stamp", 0)
  put(os, "r/xo/build/prune-lock", 0)
  put(os, "r/xo/build/stray", 7)
  put(os, "r/keep/other", 5)
  let c = Cache{name: "build", what: ""}
  let d = clean(os.fs, "r/xo", c, true)
  expect(d.found) == true
  expect(d.bytes) == 157
  expect(d.entries) == 3
  expect(there(os, "r/xo/build/a1/prog")) == true
  let r = clean(os.fs, "r/xo", c, false)
  expect(r.bytes) == 157
  expect(there(os, "r/xo/build/a1")) == false
  expect(there(os, "r/xo/build/b2")) == false
  expect(there(os, "r/xo/build/stray")) == false
  expect(there(os, "r/xo/build/prune-stamp")) == true
  expect(there(os, "r/xo/build/prune-lock")) == true
  // nothing outside the root
  expect(there(os, "r/keep/other")) == true
  // again: nothing left to remove
  expect(clean(os.fs, "r/xo", c, false).bytes) == 0
}

test "clean of a cache that is one file, and of one that is not there" {
  put(os, "r/xo/llvm-sysroot", 1)
  let f = clean(os.fs, "r/xo", Cache{name: "llvm-sysroot", what: ""}, false)
  expect(f.bytes) == 1
  expect(there(os, "r/xo/llvm-sysroot")) == false
  expect(clean(os.fs, "r/xo", Cache{name: "gone", what: ""}, false).found) == false
}

test "the table names each cache once, and keeps the module cache and seeds" {
  var seen: Set[Str] = #{}
  for c in caches() {
    expect(seen.contains(c.name)) == false
    seen.add(c.name)
    if c.name is "mod" | "seeds" | "seed" {
      expect(c.clean) == false
    }
  }
}

test "a sliced run removes the empty directories of a shard unused for empty_idle" {
  put(os, "c/s/0/e0", 100)
  put(os, "c/prune-stamp", 0)
  os.fs.create_dir_all("c/s/0/t1/fn").or_fault("mkdir")
  os.fs.create_dir_all("c/s/0/t2/fn").or_fault("mkdir")
  put(os, "c/s/0/t2/fn/seg", 10)
  os.clock.advance(30m)
  let p = Policy{max_age: 0s, max_bytes: GB, every: 0s, keep: 1m, slice_shards: 8, empty_idle: 1h}
  let _a = run(os.fs, os.clock, "c", p)
  // younger than empty_idle: kept
  expect(there(os, "c/s/0/t1/fn")) == true
  os.clock.advance(1h)
  let _b = run(os.fs, os.clock, "c", p)
  expect(there(os, "c/s/0/t1/fn")) == false
  expect(there(os, "c/s/0/t1")) == false
  // a directory with a file, the shard itself, and its entry stay
  expect(there(os, "c/s/0/t2/fn/seg")) == true
  expect(there(os, "c/s/0/e0")) == true
  // empty_idle off: nothing is removed
  os.fs.create_dir_all("c/s/0/t3/fn").or_fault("mkdir")
  os.clock.advance(5h)
  let _c = run(os.fs, os.clock, "c", Policy{max_age: 0s, max_bytes: GB, every: 0s, slice_shards: 8})
  expect(there(os, "c/s/0/t3/fn")) == true
}
