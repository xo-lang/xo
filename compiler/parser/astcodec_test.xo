// The parse's binary form (astcodec.xo): decoding what encode_parse
// wrote gives the same tree (its dump, every node and span) and the same
// bytes again, for a lazy and a full parse.

const SAMPLE = """/// A doc.
use std/json as j

pub struct Point {
  /// x
  pub x: Int = 3
  kind as "type": Str
  y: List[Map[Str, Float?]] json "y,omitempty"
} derive Json(case: camel), Eq

pub enum Shape[T] {
  Dot
  Line(from: Point, to: Point)
  Wrap(from T)
} derive Display

pub interface Area {
  fn area(self) -> Float
}

type Meters = Float
type Id struct(Int)

pub const NAMES: List[Str] = ["a", "b\\n", r"raw"]
const BIG = 0x1fff_ffff + 1_000 * -3
const D = 1500ms
const R = 'x'
const B = b"\\x00\\xff"

fn (var p: Point) move(dx: Int, var dy: Int = 2) -> Int ! Str uses fs.read, net requires dx > 0 ensures true {
  let (a, b) = (p.x, dy)
  var t = a
  t += b
  defer { t -= 1 }
  for i in 0..10 bound 20 {
    if i % 2 == 0 { continue } else if i > 7 { break }
  }
  outer: while let Some(v) = next() {
    match v {
      0 | 1 => {}
      2..=5 if v > 2 => t = t * 2
      Shape.Line(from: f, ..) => {}
      [x, y, ..] => {}
      _ => return Err("no")
    }
  }
  let s = "v=DOLLAR{t:?} and DOLLAR{p.x + 1}"
  let f = fn(z: Int) -> Int { z * z }
  let m = {"k": 1, "j": 2}
  let st = #{1, 2}
  let q = p with { x: 4 }
  let r = scope sc { sc.spawn(fn() { 1 }) }
  select {
    v = ch.recv() => {}
    after 1s => {}
  }
  let c = x ?? return 0
  let w = f(z: 3)?
  let g = List[Int].new()
  t is Some(_)
  t
}

test "a test" {
  expect(1) == 1
}
"""

/// SAMPLE with its interpolations (DOLLAR stands for the sign the
/// literal above cannot hold).
fn sample() -> Bytes { SAMPLE.replace("DOLLAR", "$").bytes() }

fn round_trip(path: Str, src: Bytes, lazy: Bool) -> Str {
  let r = if lazy { parse_file_lazy(path.bytes(), src, false) } else { parse_file(path.bytes(), src, false) }
  let b = encode_parse(r)
  match decode_parse(b) {
    Some(d) => {
      if encode_parse(d) != b {
        return "${path}: the decoded tree encodes to other bytes"
      }
      if dump_result(path, d) != dump_result(path, r) {
        return "${path}: the decoded tree dumps differently"
      }
      if d.iface != r.iface || d.hard != r.hard || d.diags.len() != r.diags.len() {
        return "${path}: the decoded interface, hard flag or diagnostics differ"
      }
      ""
    }
    None => "${path}: encode_parse's bytes do not decode"
  }
}

test "a parse decodes to the same tree, lazy and full" {
  expect(round_trip("s.xo", sample(), true)) == ""
  expect(round_trip("s.xo", sample(), false)) == ""
}

test "a file that does not parse round-trips its Bad nodes and diagnostics" {
  let bad = "fn f( -> {\nstruct {\nconst = \n"
  expect(round_trip("b.xo", bad.bytes(), true)) == ""
  expect(round_trip("b.xo", bad.bytes(), false)) == ""
}

test "damaged bytes are no parse" {
  let b = encode_parse(parse_file_lazy(b"s.xo", sample(), false))
  expect(decode_parse(b[0..b.len() - 1]).is_some()) == false
  expect(decode_parse(b + b"x").is_some()) == false
  expect(decode_parse(b"").is_some()) == false
}

test "every file of XO_AST_CODEC_FILES round-trips, and parses alone by range (run with --real)" uses env, fs.read {
  // newline separated paths; skipped without it
  let list = os.env.get("XO_AST_CODEC_FILES") ?? ""
  if list.is_empty() {
    return
  }
  var bad: List[Str] = []
  for p in list.split("\n") {
    if p.is_empty() {
      continue
    }
    let src = os.fs.read(p).or_fault("read ${p}")
    for lazy in [true, false] {
      let e = round_trip(p, src, lazy)
      if !e.is_empty() && bad.len() < 20 {
        bad.push(e)
      }
      // and each declaration range alone (a file with diagnostics has none)
      let d = decls_alone(p, src, lazy)
      if !d.is_empty() && !d.contains("no ranges recorded") && bad.len() < 20 {
        bad.push(d)
      }
    }
  }
  expect(bad) == []
}

/// The full parse of src against parse_decl over each of its ranges
/// (decision 0428): each range parses alone to the same declarations,
/// compared through encode_parse (every node and span), or "" when they
/// all match.
fn decls_alone(path: Str, src: Bytes, lazy: Bool) -> Str {
  let r = if lazy { parse_file_lazy(path.bytes(), src, false) } else { parse_file(path.bytes(), src, false) }
  let f = r.file
  if f.ranges.is_empty() {
    return "${path}: no ranges recorded (${r.diags.len()} diagnostics, hard ${r.hard}${if r.diags.is_empty() { "" } else { ": " + r.diags[0].code + " line ${r.diags[0].span.start.line}" }})"
  }
  var k = 0
  for (i, dr) in f.ranges.indexed() {
    var part: List[Decl] = []
    for j in k..k + dr.n {
      part.push(f.decls[j])
    }
    k += dr.n
    let got = parse_decl(path.bytes(), src, dr, false, lazy) ?? return "${path}: range ${i} (line ${dr.start.line}) did not parse alone"
    let want = ParseResult{file: File{span: f.span, name: f.name, imports: [], decls: part}, diags: []}
    let have = ParseResult{file: File{span: f.span, name: f.name, imports: [], decls: got}, diags: []}
    if encode_parse(have) != encode_parse(want) {
      return "${path}: range ${i} (line ${dr.start.line}) parses alone to another tree"
    }
  }
  if k != f.decls.len() {
    return "${path}: the ranges cover ${k} of ${f.decls.len()} declarations"
  }
  ""
}

/// A file with no diagnostics (SAMPLE has a hard error, so its parse
/// records no ranges): docs, generics, methods, an enum, an interface,
/// constants, a test.
const DECLS = """/// Lists.
use std/json as j

/// A point.
pub struct Point {
  /// x
  pub x: Int = 3
  y: List[Map[Str, Float?]]
} derive Eq

pub enum Shape[T] {
  Dot
  Line(from: Point, to: Point)
  Wrap(v: T)
}

pub interface Area {
  fn area(self) -> Float
}

type Meters = Float

pub const NAMES: List[Str] = ["a", "b"]
const BIG = 0x1fff + 1_000 * -3

/// Moves p.
fn (var p: Point) move(dx: Int, dy: Int = 2) -> Int {
  p.x += dx
  for i in 0..10 {
    if i % 2 == 0 { continue }
  }
  match dy {
    0 => 1
    n if n > 3 => n
    _ => 2
  }
}

pub fn first[T](xs: List[T]) -> T? {
  xs.get(0)
}

fn uses_closure(xs: List[Int]) -> List[Int] {
  xs.map(fn(x: Int) -> Int { x * 2 })
}

test "a test" {
  expect(1) == 1
}
"""

test "each declaration range parses alone to the full parse's declarations" {
  expect(decls_alone("d.xo", DECLS.bytes(), true)) == ""
  expect(decls_alone("d.xo", DECLS.bytes(), false)) == ""
}

test "a file with diagnostics records no ranges" {
  let r = parse_file(b"bad.xo", b"fn f( {\n", false)
  expect(r.file.ranges.len()) == 0
}
