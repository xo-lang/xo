// xoparse: the self hosted parser's command line.
//
//   parser [--sig] <files...>              print each file's canonical tree dump
//   parser --lazy [--sig] <files...>       the same through the lazy parse and parse_body
//   parser [--sig] --bench=N <files...>    parse every file N times, print the time
//
// The dump of every file the Go parser accepts is byte for byte the output
// of `xo astdump` (internal/parser); --sig parses in signature mode (std
// declaration files).

fn dump_body(os: Os, args: List[Str]) ! {
  var repeat = 0
  var sig = false
  // --lazy: the lazy parse with every body parsed after (decision 0351
  // stage 2), which must dump as the full parse does
  var lazy = false
  var files: List[Str] = []
  for a in args {
    if a.starts_with("--bench=") {
      repeat = Int.parse(a.trim_prefix("--bench=")) ?? fault("--bench needs a number")
    } else if a == "--sig" {
      sig = true
    } else if a == "--lazy" {
      lazy = true
    } else {
      files.push(a)
    }
  }
  if files.is_empty() {
    os.stdio.eprintln("usage: parser [--sig] [--bench=N] <files...>")
    os.proc.exit(2)
  }
  var srcs: List[(Str, Bytes)] = []
  for f in files {
    srcs.push((f, os.fs.read(f)?))
  }
  if repeat > 0 {
    let t0 = os.clock.now()
    var decls = 0
    for _ in 0..repeat {
      for (f, src) in srcs {
        decls += parse_file(f.bytes(), src, sig).file.decls.len()
      }
    }
    let elapsed = os.clock.now() - t0
    os.stdio.println("parsed ${srcs.len()} files x ${repeat}: ${decls} decls in ${elapsed.nanos() / 1_000_000} ms")
    return
  }
  var out = StrBuilder.new()
  for (f, src) in srcs {
    if lazy {
      out.write(dump_result(f, force_bodies(f.bytes(), src, parse_file_lazy(f.bytes(), src, sig))))
    } else {
      out.write(dump(f, src, sig))
    }
  }
  os.stdio.print(out.freeze())
}

/// dump_main is this component's command line with args, for `xo dev
/// dump` (decision 0209) as for the component's own binary; the exit
/// status.
pub fn dump_main(os: Os, args: List[Str]) -> Int uses (clock, env, fs.read, fs.write, proc, stdio) {
  match dump_body(os, args) {
    Ok(_) => 0
    Err(e) => {
      os.stdio.eprintln("${e.debug()}")
      1
    }
  }
}

fn main(os: Os) {
  os.proc.exit(dump_main(os, os.env.args()))
}
