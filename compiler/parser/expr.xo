// Expressions (core 3, 15: Expr), with the precedence of core 15.

use github.com/xo-lang/xo/compiler/lexer

fn (var p: Parser) parse_expr_no_lit() -> Expr {
  let saved = p.no_lit
  p.no_lit = true
  let e = p.parse_expr()
  p.no_lit = saved
  e
}

fn (var p: Parser) parse_expr() -> Expr {
  let x = p.parse_binary(1)
  if !p.bad && p.at(Kind.Question) && p.ternary_ahead() {
    return p.ternary(x)
  }
  if !p.bad && p.py_cond_ahead() {
    return p.py_cond(x)
  }
  x
}

/// Binary operator precedence, lowest first (core 15); 0 is not an
/// operator.
fn precedence(k: Kind) -> Int {
  match k {
    Coalesce => 1
    OrOr => 2
    AndAnd => 3
    Eq | NotEq | Lt | LtEq | Gt | GtEq => 4
    DotDot | DotDotEq => 5
    Plus | Minus | Pipe | Caret => 6
    Star | Slash | Percent | Shl | Shr | Amp => 7
    _ => 0
  }
}

const RANGE_PREC = 5

/// The precedence of the contextual `is`: that of `==` (core 3.5).
const IS_PREC = 4

fn (var p: Parser) parse_binary(min_prec: Int) -> Expr {
  var x = p.parse_unary()
  while {
    if p.at_ident(b"is") && IS_PREC >= min_prec && !p.failed() {
      x = p.parse_is(x)
      continue
    }
    // the token kinds foreign_binary can act on, tested first: the
    // habit checks are on the parser's hottest paths
    if p.tok.kind is Ident | In | Eq | NotEq | Star | Question {
      if let Some(y) = p.foreign_binary(x, min_prec) {
        x = y
        continue
      }
    }
    let op = p.tok.kind
    let prec = precedence(op)
    if prec == 0 || prec < min_prec || p.failed() || p.inc_dec_ahead() {
      return x
    }
    let op_tok = p.tok
    p.next()
    if prec == RANGE_PREC {
      var inclusive = op == Kind.DotDotEq
      if op == Kind.DotDot && adjacent(op_tok, p.tok) && (p.at(Kind.Lt) || p.at(Kind.Dot)) {
        inclusive = p.foreign_range(op_tok)
      }
      var hi: Expr? = None
      if !(p.open_range && p.at(Kind.RBrack)) {
        hi = Some(p.parse_binary(prec + 1))
      }
      x = Expr.RangeExpr(span: p.span_from(expr_span(x).start), lo: Some(x), hi: hi, inclusive: inclusive)
      continue
    }
    let y = if op == Kind.Coalesce { p.parse_binary(prec) } else { p.parse_binary(prec + 1) }
    x = Expr.BinaryExpr(span: span_to(expr_span(x), expr_span(y)), op: op, x: x, y: y)
  }
  x
}

/// `++` or `--` ending a statement, which the operator loop leaves alone.
fn (p: Parser) inc_dec_ahead() -> Bool {
  let t = p.tok
  if (t.kind != Kind.Plus && t.kind != Kind.Minus) || p.peek(1).kind != t.kind || !adjacent(t, p.peek(1)) {
    return false
  }
  p.peek(2).kind is Newline | RBrace | Eof
}

/// Whether the `?` here starts `c ? a : b` rather than a postfix `?`.
fn (p: Parser) ternary_ahead() -> Bool {
  let n = p.peek(1)
  match n.kind {
    Ident => {
      if n.text == b"is" || n.text == b"with" {
        return false
      }
    }
    Int | Float | Duration | Rune | String | RawString | Bytes | Bang | Hole => {}
    LParen | LBrack | Minus => {
      if adjacent(p.tok, n) {
        return false
      }
    }
    _ => return false
  }
  var depth = 0
  var i = p.pos + 1
  while i < p.toks.len() {
    match p.tok_at(i).kind {
      Newline | Eof => return false
      LParen | LBrack | LBrace | HashLBrace => depth += 1
      RParen | RBrack | RBrace => {
        depth -= 1
        if depth < 0 {
          return false
        }
      }
      Comma | FatArrow | Assign => {
        if depth == 0 {
          return false
        }
      }
      Colon => {
        if depth == 0 {
          return true
        }
      }
      _ => {}
    }
    i += 1
  }
  false
}

/// Whether `if` after an expression starts Python's `a if c else b`.
fn (p: Parser) py_cond_ahead() -> Bool {
  if !p.at(Kind.If) || p.no_lit {
    return false
  }
  var depth = 0
  var i = p.pos + 1
  while i < p.toks.len() {
    match p.tok_at(i).kind {
      Newline | Eof => return false
      LBrace => {
        if depth == 0 {
          return false
        }
        depth += 1
      }
      LParen | LBrack | HashLBrace => depth += 1
      RParen | RBrack | RBrace => {
        depth -= 1
        if depth < 0 {
          return false
        }
      }
      Else => {
        if depth == 0 {
          return true
        }
      }
      _ => {}
    }
    i += 1
  }
  false
}

/// `x is Pattern` after x (core 3.5); the pattern binds no names.
fn (var p: Parser) parse_is(x: Expr) -> Expr {
  p.next() // is
  let pat = p.parse_pattern()
  let e = Expr.IsExpr(span: span_to(expr_span(x), pattern_span(pat)), x: x, pattern: pat)
  if p.failed() {
    return e
  }
  var binds: List[Ident] = []
  collect_binds(pat, binds)
  for b in binds {
    let d = p.soft(INVALID_PATTERN, b.span, "a pattern after `is` cannot bind names, found `${txt(b.name)}`; write `_`, or bind with `if let` or `match` (core 3.5)")
    if d >= 0 {
      p.diags[d].fixes.push(Fix{title: b"replace with `_`", edits: [replace_span(b.span, "_")]})
    }
  }
  e
}

/// The names pat and the patterns nested in it bind, in the order of
/// internal/parser inspectPattern.
fn collect_binds(pat: Pattern, var out: List[Ident]) {
  match pat {
    BindPat(_, name) => out.push(name)
    OrPat(_, alts) => {
      for a in alts {
        collect_binds(a, out)
      }
    }
    TuplePat(_, elems) => {
      for a in elems {
        collect_binds(a, out)
      }
    }
    ListPat(_, elems, _) => {
      for a in elems {
        collect_binds(a, out)
      }
    }
    VariantPat(_, _, _, fields, _) => {
      for f in fields {
        collect_binds(f.pattern, out)
      }
    }
    StructPat(_, _, fields, _) => {
      for f in fields {
        collect_binds(f.pattern, out)
      }
    }
    WildcardPat(_) | LitPat(..) | RangePat(..) | BadPat(_) => {}
  }
}

/// Whether k can start an expression operand.
fn starts_expr(k: Kind) -> Bool {
  k is Ident | Int | Float | Duration | Rune | String | RawString | Bytes | Hole | LParen | LBrack | LBrace | HashLBrace | Minus | Bang | Tilde | Fn | If | Match
}

fn (var p: Parser) parse_unary() -> Expr {
  if p.tok.kind is Amp | Star | Ident {
    if let Some(fx) = p.foreign_unary() {
      return fx
    }
  }
  let t = p.tok
  if t.kind is Minus | Bang | Tilde {
    let start = t.span.start
    p.next()
    let x = p.parse_unary()
    return Expr.UnaryExpr(span: p.span_from(start), op: t.kind, x: x)
  }
  let x = p.parse_primary()
  p.parse_postfix(x)
}

/// Whether a token of kind follows on the current line at bracket depth
/// zero (internal/parser restOfLineHas).
fn (p: Parser) rest_of_line_has(kind: Kind) -> Bool {
  var depth = 0
  var i = p.pos
  while i < p.toks.len() {
    let k = p.tok_at(i).kind
    match k {
      Newline | Eof => return false
      LParen | LBrack | HashLBrace => depth += 1
      RParen | RBrack => {
        depth -= 1
        if depth < 0 {
          return false
        }
      }
      LBrace => {
        if depth == 0 && kind == Kind.LBrace {
          return true
        }
        depth += 1
      }
      RBrace => {
        depth -= 1
        if depth < 0 {
          return false
        }
      }
      _ => {}
    }
    if depth == 0 && k == kind && i > p.pos {
      return true
    }
    i += 1
  }
  false
}

/// The index of the token closing the bracket at index i, or -1.
fn (p: Parser) match_close(i: Int) -> Int {
  let open = p.tok_at(i).kind
  let close = match open {
    LParen => Kind.RParen
    LBrack => Kind.RBrack
    LBrace | HashLBrace => Kind.RBrace
    _ => return -1
  }
  var depth = 0
  var j = i
  while j < p.toks.len() {
    let k = p.tok_at(j).kind
    if k == open || (close == Kind.RBrace && (k == Kind.LBrace || k == Kind.HashLBrace)) {
      depth += 1
    } else if k == close {
      depth -= 1
      if depth == 0 {
        return j
      }
    } else if k == Kind.Eof {
      return -1
    }
    j += 1
  }
  -1
}

fn (var p: Parser) parse_primary() -> Expr {
  if p.may_be_foreign_primary() {
    if let Some(fx) = p.foreign_primary() {
      return fx
    }
  }
  let t = p.tok
  let sp = t.span
  match t.kind {
    Ident => {
      p.next()
      return Expr.Ident(Ident{span: sp, name: t.text})
    }
    Int => {
      p.next()
      return Expr.IntLit(span: sp, raw: t.text, value: t.value)
    }
    Float => {
      p.next()
      return Expr.FloatLit(span: sp, raw: t.text)
    }
    Duration => {
      p.next()
      return Expr.DurationLit(span: sp, raw: t.text, nanos: t.value)
    }
    Rune => {
      p.next()
      return Expr.RuneLit(span: sp, raw: t.text, value: first_rune(t.value))
    }
    String | RawString => return Expr.StringLit(p.parse_string())
    Bytes => {
      p.next()
      return Expr.BytesLit(span: sp, value: t.value)
    }
    Hole => {
      p.next()
      return Expr.HoleExpr(sp)
    }
    LParen => return p.parse_paren_or_tuple()
    LBrack => {
      var elems: List[Expr] = []
      var comp: List[Comprehension] = []
      let st = p.list_open(Kind.LBrack)
      while p.list_more(Kind.RBrack) {
        let before = p.pos
        elems.push(p.parse_expr())
        if elems.len() == 1 && p.at(Kind.For) && !p.bad {
          comp.push(p.parse_comprehension(elems[0]))
        }
        if !p.list_sep(before, Kind.RBrack, "list") {
          break
        }
      }
      let lsp = p.list_close(st, Kind.RBrack)
      if let Some(c) = comp.first() {
        return p.finish_comprehension(c, lsp)
      }
      return Expr.ListLit(span: lsp, elems: elems)
    }
    HashLBrace => {
      var elems: List[Expr] = []
      let st = p.list_open(Kind.HashLBrace)
      while p.list_more(Kind.RBrace) {
        let before = p.pos
        elems.push(p.parse_expr())
        if !p.list_sep(before, Kind.RBrace, "set") {
          break
        }
      }
      let ssp = p.list_close(st, Kind.RBrace)
      return Expr.SetLit(span: ssp, elems: elems)
    }
    LBrace => {
      if p.brace_is_map() {
        return p.parse_map_lit()
      }
      return Expr.Block(p.parse_block())
    }
    If => return p.parse_if()
    Match => return p.parse_match()
    Scope => {
      p.next()
      let name = p.expect_ident("a scope name")
      let body = p.parse_block()
      return Expr.ScopeExpr(span: p.span_from(sp.start), name: name, body: body)
    }
    Select => return p.parse_select()
    Fn => return p.parse_fn_lit()
    While => {
      p.next()
      if !p.at(Kind.LBrace) {
        p.fail(WHILE_COND_AS_EXPR, sp, "a `while` loop with a condition is a statement, not an expression; only `while { ... }` is an expression")
        p.parse_expr_no_lit()
      }
      let body = p.parse_block()
      return Expr.WhileExpr(span: p.span_from(sp.start), body: body)
    }
    Return | Break | Continue => {
      p.fail(UNEXPECTED_TOKEN, sp, "`${kind_text(t.kind)}` is a statement and cannot be used as a value here")
      return Expr.BadExpr(sp)
    }
    _ => {}
  }
  p.error_expected("an expression")
  Expr.BadExpr(Span{start: sp.start, end: sp.start})
}

/// The first code point of a rune token's value (Go's range over a
/// string: U+FFFD for an invalid byte, 0 when empty).
fn first_rune(v: Bytes) -> Int {
  if v.is_empty() {
    return 0
  }
  let (r, _) = v.decode_rune(0)
  Int(r)
}

fn (var p: Parser) parse_paren_or_tuple() -> Expr {
  let start = p.tok.span.start
  if p.peek(1).kind == Kind.RParen {
    p.next()
    p.next()
    return Expr.UnitExpr(p.span_from(start))
  }
  var elems: List[Expr] = []
  var trailing = false
  let st = p.list_open(Kind.LParen)
  while p.list_more(Kind.RParen) {
    let before = p.pos
    elems.push(p.parse_expr())
    trailing = p.at(Kind.Comma)
    if !p.list_sep(before, Kind.RParen, "tuple") {
      break
    }
  }
  let sp = p.list_close(st, Kind.RParen)
  if elems.len() == 1 && !trailing {
    return Expr.ParenExpr(span: sp, x: elems[0])
  }
  Expr.TupleExpr(span: sp, elems: elems)
}

/// Whether `{` in expression position starts a map literal rather than a
/// block: `{}` is an empty map, and a map has a `:` at depth zero before
/// the first newline (core 15).
fn (p: Parser) brace_is_map() -> Bool {
  var i = p.pos + 1
  while p.tok_at(i).kind == Kind.Newline {
    i += 1
  }
  match p.tok_at(i).kind {
    RBrace => return true
    Let | Var | Return | Break | Continue | Defer | For | While => return false
    Ident => {
      if p.tok_at(i + 1).kind == Kind.Colon && (p.tok_at(i + 2).kind is For | While) {
        return false
      }
    }
    _ => {}
  }
  var depth = 0
  while i < p.toks.len() {
    match p.toks[i].kind {
      LParen | LBrack | LBrace | HashLBrace => depth += 1
      RParen | RBrack => depth -= 1
      RBrace => {
        if depth == 0 {
          return false
        }
        depth -= 1
      }
      Newline => {
        if depth == 0 {
          return false
        }
      }
      Colon => {
        if depth == 0 {
          return true
        }
      }
      Eof => return false
      _ => {}
    }
    i += 1
  }
  false
}

fn (var p: Parser) parse_map_lit() -> Expr {
  var entries: List[MapEntry] = []
  let st = p.list_open(Kind.LBrace)
  while p.list_more(Kind.RBrace) {
    let before = p.pos
    let start = p.tok.span.start
    let key = p.parse_expr()
    p.expect(Kind.Colon, "`:` between map key and value")
    let value = p.parse_expr()
    entries.push(MapEntry{span: p.span_from(start), key: key, value: value})
    if !p.list_sep(before, Kind.RBrace, "map") {
      break
    }
  }
  let sp = p.list_close(st, Kind.RBrace)
  Expr.MapLit(span: sp, entries: entries)
}

fn (var p: Parser) parse_field_inits() -> List[FieldInit] {
  var out: List[FieldInit] = []
  let st = p.list_open(Kind.LBrace)
  while p.list_more(Kind.RBrace) {
    let before = p.pos
    let start = p.tok.span.start
    let name = p.expect_ident("a field name")
    p.expect(Kind.Colon, "`:` after the field name")
    let value = p.parse_expr()
    out.push(FieldInit{span: p.span_from(start), name: name, value: value})
    if !p.list_sep(before, Kind.RBrace, "field") {
      break
    }
  }
  p.list_close(st, Kind.RBrace)
  out
}

/// One `if` of an `else if` chain, parsed before the `if`s after it
/// (parse_if).
struct IfHead {
  start: Pos
  cond: Expr?
  pattern: Pattern?
  value: Expr?
  then: Block
}

fn (var p: Parser) parse_if() -> Expr {
  // an `else if` chain in a loop, then its IfExpr nodes from the last one
  // out (the recursion went as deep as the chain is long, which overflowed
  // a browser worker's stack in the wasm build of the compiler, decision
  // 0242); every span ends where the chain does, as before
  var heads: List[IfHead] = []
  var inner: Expr? = None
  while true {
    let start = p.tok.span.start
    p.next() // if
    var cond: Expr? = None
    var pattern: Pattern? = None
    var value: Expr? = None
    var head: Expr = Expr.BadExpr(p.tok.span)
    if p.got(Kind.Let) {
      let pat = p.parse_pattern()
      pattern = Some(pat)
      p.expect(Kind.Assign, "`=` in `if let`")
      head = p.parse_expr_no_lit()
      value = Some(head)
    } else {
      head = p.parse_expr_no_lit()
      cond = Some(head)
    }
    if let ParenExpr(..) = head {
      if !p.bad && !p.at(Kind.LBrace) && !p.at(Kind.Newline) && (starts_expr(p.tok.kind) || (p.tok.kind is Return | Break | Continue)) {
        inner = Some(p.braceless_if(cond, pattern, value, start))
        break
      }
    }
    let then = p.parse_cond_block(Some(head))
    // `}` newline `else` is a common mistake; report it and keep going.
    if p.at(Kind.Newline) && p.peek_past_newlines().kind == Kind.Else {
      let nl = p.tok
      let else_tok = p.peek_past_newlines()
      let d = p.soft(ELSE_ON_NEW_LINE, else_tok.span, "`else` must be on the same line as the closing `}` (core 1.3)")
      if d >= 0 {
        p.diags[d].fixes.push(Fix{title: b"join `} else`", edits: [replace_range(nl.span.start, else_tok.span.start, " ")]})
      }
      p.skip_newlines()
    }
    heads.push(IfHead{start: start, cond: cond, pattern: pattern, value: value, then: then})
    if !p.bad && p.foreign_elif() {
      continue
    }
    if p.got(Kind.Else) {
      if p.at(Kind.If) {
        continue
      } else if p.at(Kind.LBrace) {
        inner = Some(Expr.Block(p.parse_block()))
      } else {
        p.error_expected("`if` or `{` after `else`")
      }
    }
    break
  }
  var i = heads.len()
  while i > 0 {
    i -= 1
    let h = heads[i]
    inner = Some(Expr.IfExpr(IfExpr{span: p.span_from(h.start), cond: h.cond, pattern: h.pattern, value: h.value, then: h.then, els: inner}))
  }
  inner ?? Expr.BadExpr(p.tok.span)
}

/// Kotlin, Java, and C's `if (c) a else b` (no braces), after the
/// parenthesized condition.
fn (var p: Parser) braceless_if(cond: Expr?, pattern: Pattern?, value: Expr?, start: Pos) -> Expr {
  let then_start = p.tok
  let then = p.braceless_body()
  var edits = [insert_at(then.span.start, "{ "), insert_at(then.span.end, " }")]
  var els: Expr? = None
  if p.at(Kind.Else) {
    p.next()
    if p.at(Kind.If) {
      els = Some(p.parse_if())
    } else if p.at(Kind.LBrace) {
      els = Some(Expr.Block(p.parse_block()))
    } else {
      let eb = p.braceless_body()
      edits.push(insert_at(eb.span.start, "{ "))
      edits.push(insert_at(eb.span.end, " }"))
      els = Some(Expr.Block(eb))
    }
  }
  let sp = p.span_from(start)
  let d = p.foreign(then_start.span, "`if (c) a else b` without braces is Kotlin, Java, and C syntax; every Xo `if` and `else` body is a block: `if c { a } else { b }` (core 3.5)")
  p.add_fix(d, "add braces", edits)
  Expr.IfExpr(IfExpr{span: sp, cond: cond, pattern: pattern, value: value, then: then, els: els})
}

fn (var p: Parser) braceless_body() -> Block {
  let s = p.parse_simple_stmt()
  Block{span: stmt_span(s), stmts: [s]}
}

/// After an arm: a newline or the closing `}`. A `,` (Rust, Kotlin) and a
/// second arm on the line are soft errors (XO0169, XO0175): the next arm
/// is parsed as one. After an error, resynchronizes at the end of the arm
/// (internal/parser parseArms).
fn (var p: Parser) arm_end(what: Str, before: Int) {
  if !p.bad {
    if p.got(Kind.Newline) || p.at(Kind.RBrace) {
      return
    }
    if p.at(Kind.Comma) {
      // internal/parser armComma
      let c = p.tok
      let d = p.soft(MATCH_ARM_SEPARATOR, c.span, "${what}s are separated by newlines, not `,`")
      p.add_note(d, "Rust and Kotlin separate arms with `,`; an Xo arm ends at its newline (core 3.5)")
      let next = p.peek(1)
      if !(next.kind is Newline | RBrace | Eof) && next.span.start.line == c.span.start.line {
        p.add_fix(d, "put the next arm on its own line", [replace_range(c.span.start, next.span.start, "\n")])
      } else {
        p.add_fix(d, "remove `,`", [replace_span(c.span, "")])
      }
      p.next()
      return
    }
    if p.arm_on_same_line() {
      // internal/parser splitArm
      let d = p.soft(EXPECTED_NEWLINE, p.tok.span, "expected newline after ${what}, found ${describe_go(p.tok)}")
      p.add_note(d, "each arm goes on its own line; Xo has no separator between arms (core 3.5)")
      p.add_fix(d, "put the next arm on its own line", [replace_range(p.prev_end(), p.tok.span.start, "\n")])
      return
    }
    p.fail(EXPECTED_NEWLINE, p.tok.span, "expected newline after ${what}, found ${describe(p.tok)}")
  }
  p.resync(before)
}

fn (var p: Parser) parse_match() -> Expr {
  let start = p.tok.span.start
  p.next() // match
  let subject = p.parse_expr_no_lit()
  p.check_struct_lit_in_cond(Some(subject))
  var arms: List[MatchArm] = []
  if let Some(br) = p.braces_open(true) {
    var before = 0
    while p.braces_more(before) {
      let astart = p.tok.span.start
      let pattern = p.parse_pattern()
      var guard: Expr? = None
      if p.got(Kind.If) {
        let saved = p.no_arrow_fn
        p.no_arrow_fn = true
        guard = Some(p.parse_expr())
        p.no_arrow_fn = saved
      }
      if p.at(Kind.Arrow) && !p.bad {
        let d = p.foreign(p.tok.span, "`->` after a pattern is Kotlin and Scala syntax; an Xo match arm is `pattern => body` (core 3.5)")
        p.add_fix(d, "write `=>`", [replace_span(p.tok.span, "=>")])
        p.next()
      } else {
        p.expect(Kind.FatArrow, "`=>` after the match pattern")
      }
      var body: Stmt? = None
      if !p.failed() {
        body = Some(p.parse_simple_stmt())
      }
      arms.push(MatchArm{span: p.span_from(astart), pattern: pattern, guard: guard, body: body})
      p.arm_end("match arm", before)
    }
    p.braces_close(br)
  }
  Expr.MatchExpr(span: p.span_from(start), subject: subject, arms: arms)
}

fn (var p: Parser) parse_select() -> Expr {
  let start = p.tok.span.start
  p.next() // select
  var arms: List[SelectArm] = []
  if let Some(br) = p.braces_open(true) {
    var before = 0
    while p.braces_more(before) {
      let astart = p.tok.span.start
      var arm = SelectArm{span: p.tok.span}
      let saved = p.no_arrow_fn
      p.no_arrow_fn = true
      if p.at_ident(b"after") && !(p.peek(1).kind is Assign | FatArrow | Dot | LParen | LBrack | Question) {
        p.next()
        arm.after = Some(p.parse_expr())
      } else if p.at(Kind.Ident) && p.peek(1).kind == Kind.Assign {
        arm.bind = Some(p.expect_ident("a name"))
        p.next() // =
        arm.op = Some(p.parse_expr())
      } else {
        arm.op = Some(p.parse_expr())
      }
      p.no_arrow_fn = saved
      p.expect(Kind.FatArrow, "`=>` after the select operation")
      if !p.failed() {
        arm.body = Some(p.parse_simple_stmt())
      }
      arm.span = p.span_from(astart)
      arms.push(arm)
      p.arm_end("select arm", before)
    }
    p.braces_close(br)
  }
  Expr.SelectExpr(span: p.span_from(start), arms: arms)
}

fn (var p: Parser) parse_fn_lit() -> Expr {
  let start = p.tok.span.start
  p.next() // fn
  let params = p.parse_params(true, false)
  var result: Type? = None
  if p.got(Kind.Arrow) {
    result = Some(p.parse_type())
  }
  var err: ErrSpec? = None
  if p.at(Kind.Bang) {
    err = Some(p.parse_err_spec())
  }
  var effects: List[Effect] = []
  if p.got(Kind.Uses) {
    let (effs, _) = p.parse_effect_clause()
    effects = effs
  }
  let body = p.parse_block()
  Expr.FnLit(FnLit{span: p.span_from(start), params: params, result: result, err: err, effects: effects, body: body})
}

fn (var p: Parser) parse_postfix(x0: Expr) -> Expr {
  var x = x0
  while !p.failed() {
    let start = expr_span(x).start
    let fp = if p.tok.kind is Question | As | Bang | Colon { p.foreign_postfix(x) } else { Postfix.NoHabit }
    match fp {
      Stop => return x
      Habit(y) => {
        x = y
        continue
      }
      NoHabit => {}
    }
    let t = p.tok
    let next = p.peek(1)
    match t.kind {
      Question => {
        p.next()
        x = Expr.TryExpr(span: p.span_from(start), x: x)
      }
      Dot => {
        p.next()
        if p.at(Kind.Int) {
          // tuple field `t.0` (core 3.5)
          let it = p.tok
          p.next()
          if it.value != it.text {
            p.fail(UNEXPECTED_TOKEN, it.span, "a tuple field is a plain decimal index such as `.0`, found `${txt(it.text)}`")
          }
          x = Expr.SelectorExpr(span: p.span_from(start), x: x, sel: Ident{span: it.span, name: it.text})
          continue
        }
        let sel = p.expect_ident("a field or method name after `.`")
        x = Expr.SelectorExpr(span: p.span_from(start), x: x, sel: sel)
      }
      LParen => {
        var args: List[Arg] = []
        let st = p.list_open(Kind.LParen)
        while p.list_more(Kind.RParen) {
          let before = p.pos
          let astart = p.tok.span.start
          var name: Ident? = None
          if p.at(Kind.Ident) && p.peek(1).kind == Kind.Colon {
            name = Some(p.expect_ident("an argument name"))
            p.next()
          }
          if p.at(Kind.Var) && !p.bad && starts_expr(p.peek(1).kind) {
            // Swift `inout` call sites and C# `ref` read like this.
            let vt = p.tok
            let d = p.foreign(vt.span, "`var` at a call site is not Xo: `var` belongs only on the parameter, `fn f(var x: T)`, and the caller passes its `var` binding as is, `f(x)` (core 3.2)")
            p.add_fix(d, "remove `var`", [p.delete_token(vt)])
            p.next()
          }
          let value = p.parse_expr()
          args.push(Arg{span: p.span_from(astart), name: name, value: value})
          if !p.list_sep(before, Kind.RParen, "argument") {
            break
          }
        }
        p.list_close(st, Kind.RParen)
        x = Expr.CallExpr(span: p.span_from(start), fun: x, args: args)
      }
      LBrack => {
        if p.type_args_ahead(x) {
          var types: List[Type] = []
          let st = p.list_open(Kind.LBrack)
          while p.list_more(Kind.RBrack) {
            let before = p.pos
            types.push(p.parse_type())
            if !p.list_sep(before, Kind.RBrack, "type argument") {
              break
            }
          }
          p.list_close(st, Kind.RBrack)
          x = Expr.TypeArgsExpr(span: p.span_from(start), x: x, types: types)
        } else {
          x = p.parse_index(x)
        }
      }
      Ident => {
        if t.text != b"with" || next.kind != Kind.LBrace {
          return x
        }
        p.next()
        let fields = p.parse_field_inits()
        x = Expr.WithExpr(span: p.span_from(start), x: x, fields: fields)
      }
      LBrace => {
        if p.no_lit || !is_type_name(x) {
          return x
        }
        let fields = p.parse_field_inits()
        x = Expr.StructLit(span: p.span_from(start), typ: x, fields: fields)
      }
      _ => return x
    }
  }
  x
}

fn (var p: Parser) parse_index(x: Expr) -> Expr {
  let start = expr_span(x).start
  p.next() // [
  let saved_lit = p.no_lit
  let saved_range = p.open_range
  p.no_lit = false
  p.open_range = true
  var idx: Expr = Expr.BadExpr(p.tok.span)
  if p.at(Kind.DotDot) || p.at(Kind.DotDotEq) {
    let rstart = p.tok.span.start
    let inclusive = p.at(Kind.DotDotEq)
    p.next()
    var hi: Expr? = None
    if !p.at(Kind.RBrack) {
      hi = Some(p.parse_binary(RANGE_PREC + 1))
    }
    idx = Expr.RangeExpr(span: p.span_from(rstart), lo: None, hi: hi, inclusive: inclusive)
  } else if p.at(Kind.Colon) {
    idx = p.foreign_slice(None)
  } else if p.at(Kind.RBrack) {
    p.error_expected("an index or range")
  } else {
    idx = p.parse_expr()
    if p.at(Kind.Colon) && !p.bad {
      idx = p.foreign_slice(Some(idx))
    }
  }
  p.no_lit = saved_lit
  p.open_range = saved_range
  p.expect(Kind.RBrack, "`]`")
  Expr.IndexExpr(span: p.span_from(start), x: x, index: idx)
}

/// Whether e names a type: an UpperCamel identifier, a selector ending in
/// one, or either with type arguments.
fn is_type_name(e: Expr) -> Bool {
  match e {
    Ident(id) => is_upper(id.name)
    SelectorExpr(_, x, sel) => is_upper(sel.name) && is_path(x)
    TypeArgsExpr(_, x, _) => is_type_name(x)
    _ => false
  }
}

fn is_path(e: Expr) -> Bool {
  match e {
    Ident(_) => true
    SelectorExpr(_, x, _) => is_path(x)
    _ => false
  }
}

fn is_upper(s: Bytes) -> Bool {
  !s.is_empty() && s[0] >= 'A' && s[0] <= 'Z'
}

/// Whether the `[` here starts explicit type arguments rather than an
/// index (core 15, "Type arguments vs. indexing").
fn (p: Parser) type_args_ahead(base: Expr) -> Bool {
  var depth = 0
  var end = -1
  var elem_starts = [p.pos + 1]
  var i = p.pos
  while i < p.toks.len() && end < 0 {
    let k = p.toks[i].kind
    match k {
      LBrack | LParen => depth += 1
      RBrack | RParen => {
        depth -= 1
        if depth == 0 {
          if k != Kind.RBrack {
            return false
          }
          end = i
        }
      }
      Comma => {
        if depth == 1 {
          elem_starts.push(i + 1)
        }
      }
      Ident | Dot | Question | Arrow | Bang | Fn | Uses | Var => {}
      _ => return false
    }
    i += 1
  }
  if end <= p.pos + 1 {
    return false
  }
  var any_type = false
  for s in elem_starts {
    if s >= end {
      continue // trailing comma
    }
    if p.type_start_at(s) {
      any_type = true
    } else if !p.effect_arg_at(s) {
      return false
    }
  }
  if is_type_name(base) {
    return any_type || !is_const_name(base)
  }
  any_type && p.tok_at(end + 1).kind == Kind.LParen
}

/// Whether e is an identifier spelled like a constant: upper case
/// letters, digits, and underscores (`NAMES`, `KIND_NAMES`), which with
/// only lowercase names in the brackets is indexed (decision 0143).
fn is_const_name(e: Expr) -> Bool {
  let id = match e {
    Ident(x) => x
    _ => return false
  }
  if !is_upper(id.name) {
    return false
  }
  for i in 0..id.name.len() {
    let ch = id.name[i]
    if !((ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_') {
      return false
    }
  }
  true
}

/// Whether the tokens at i are a whole effect argument: `name` or
/// `name.sub` followed by `,` or `]`.
fn (p: Parser) effect_arg_at(i: Int) -> Bool {
  if i >= p.toks.len() || p.toks[i].kind != Kind.Ident || is_upper(p.toks[i].text) {
    return false
  }
  var j = i + 1
  if j + 1 < p.toks.len() && p.toks[j].kind == Kind.Dot && p.toks[j + 1].kind == Kind.Ident {
    j += 2
  }
  j < p.toks.len() && (p.toks[j].kind is Comma | RBrack)
}

/// Whether the tokens at i start something that looks like a type.
fn (p: Parser) type_start_at(i0: Int) -> Bool {
  let t = p.tok_at(i0)
  match t.kind {
    LParen | Fn => return true
    Ident => {
      if is_upper(t.text) {
        return true
      }
      // module qualified: mod.Type
      var i = i0
      while i + 2 < p.toks.len() && p.toks[i + 1].kind == Kind.Dot && p.toks[i + 2].kind == Kind.Ident {
        i += 2
        if is_upper(p.toks[i].text) {
          return true
        }
      }
    }
    _ => {}
  }
  false
}

/// A string literal, parsing interpolated expressions.
fn (var p: Parser) parse_string() -> StringLit {
  let t = p.tok
  p.next()
  if t.kind == Kind.RawString {
    return StringLit{span: t.span, kind: StringKind.Raw, parts: [StringPart{text: t.value, expr: None}]}
  }
  var s = StringLit{span: t.span, kind: if t.triple { StringKind.Triple } else { StringKind.Plain }}
  for part in t.parts {
    if !part.is_expr {
      s.parts.push(StringPart{text: part.text, expr: None})
      continue
    }
    let (e, debug) = p.parse_interp_part(part.span)
    s.parts.push(StringPart{text: b"", expr: Some(e), debug: debug})
  }
  s
}

/// Lexes and parses the source of one `${...}`. Its diagnostics join the
/// file's; its errors do not suppress the enclosing statement's (a parser
/// of its own, as in internal/parser parseInterp).
fn (var p: Parser) parse_interp(sp: Span) -> Expr {
  let (e, _) = p.parse_interp_part(sp)
  e
}

/// parse_interp, and whether the expression ends with `:?`, the Debug
/// text's form `${x:?}` (decision 0296).
fn (var p: Parser) parse_interp_part(sp: Span) -> (Expr, Bool) {
  let r = lexer.lex_range(p.src, sp.start, sp.end.offset)
  var sub = Parser{file: p.file, src: p.src, toks: r.tokens, tok: r.tokens[0], sig: p.sig, diags: r.diags}
  let e = sub.parse_expr()
  var debug = false
  if !sub.failed() && sub.at(Kind.Colon) && sub.peek(1).kind == Kind.Question && sub.peek(2).kind == Kind.Eof {
    debug = true
    sub.next()
    sub.next()
  }
  if !sub.failed() && !sub.at(Kind.Eof) {
    sub.fail(UNEXPECTED_TOKEN, sub.tok.span, "unexpected ${describe(sub.tok)} in interpolation; expected `}`")
  }
  for d in sub.diags {
    p.diags.push(d)
  }
  if sub.hard {
    p.hard = true
  }
  (e, debug)
}

/// Python's `[elem for pat in iter if cond]`.
struct Comprehension {
  elem: Expr
  pat: Pattern
  iter: Expr
  cond: Expr?
  kw: Token
}

/// `for pat in iter [if cond]` after the element.
fn (var p: Parser) parse_comprehension(elem: Expr) -> Comprehension {
  let kw = p.tok
  p.next() // for
  let pat = p.parse_pattern()
  p.expect(Kind.In, "`in` in a comprehension")
  let iter = p.parse_binary(2)
  var cond: Expr? = None
  if p.got(Kind.If) {
    cond = Some(p.parse_expr())
  }
  Comprehension{elem: elem, pat: pat, iter: iter, cond: cond, kw: kw}
}

/// Reports the comprehension and recovers it as
/// `iter.filter(fn(x) { cond }).map(fn(x) { elem })`.
fn (var p: Parser) finish_comprehension(c: Comprehension, sp: Span) -> Expr {
  let d = p.foreign(c.kw.span, "`[x for x in xs]` is a Python comprehension; Xo calls the list methods, `xs.filter(fn(x) { cond }).map(fn(x) { f(x) })` (spec/std.md 2)")
  let (bsp, name) = match c.pat {
    BindPat(span, id) => (span, id.name)
    _ => return Expr.ListLit(span: sp, elems: [c.elem])
  }
  let params = [Param{span: bsp, name: Ident{span: bsp, name: name}}]
  var text = p.operand_text(c.iter)
  var x = c.iter
  if let Some(cond) = c.cond {
    text = text + ".filter(fn(${txt(name)}) { ${p.span_text(expr_span(cond))} })"
    x = method_call(x, b"filter", sp, [Expr.FnLit(FnLit{span: expr_span(cond), params: params, body: expr_block(cond)})])
  }
  var same = false
  if let Ident(id) = c.elem {
    same = id.name == name
  }
  if !same {
    text = text + ".map(fn(${txt(name)}) { ${p.span_text(expr_span(c.elem))} })"
    x = method_call(x, b"map", sp, [Expr.FnLit(FnLit{span: expr_span(c.elem), params: params, body: expr_block(c.elem)})])
  }
  p.add_fix(d, "write `.filter(...).map(...)`", [replace_span(sp, text)])
  x
}
