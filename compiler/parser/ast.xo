// The syntax tree of Xo, written in Xo: a port of internal/ast (core 15).
//
// Every node carries the span of the source it was parsed from. Node and
// field names follow internal/ast (Go type names become variant or struct
// names, Go field names become snake_case fields), so the dump (dump.xo)
// prints the same text as `xo astdump`. Text is Bytes, as in the lexer.
//
// A Go interface type (Expr, Stmt, Decl, Type, Pattern, Clause) is an
// enum here; a Go node that is only ever held by its own type (FnDecl,
// Block, Param, ...) is a struct. A variant named like a struct holds that
// struct (`Expr.Block(b)`). Optional children are `T?`; list children are
// `List[T]`, empty when Go's is nil. The three places where Go tells a nil
// list from an empty one (a variant's fields, a `use c` effect ceiling, the
// fields of a variant or struct pattern) keep that difference: `List[T]?`
// or the pattern's own flags.

use github.com/xo-lang/xo/compiler/lexer

pub type Kind = lexer.Kind
pub type Token = lexer.Token
pub type Span = lexer.Span
pub type Pos = lexer.Pos

/// A name.
pub struct Ident {
  pub span: Span
  pub name: Bytes
}

/// A `///` doc comment: its lines joined with "\n", leading "/// " removed.
pub struct Doc {
  pub span: Span
  pub text: Bytes
}

// ---------------------------------------------------------------------------
// File and declarations

/// One parsed source file.
pub struct File {
  pub span: Span
  pub name: Bytes
  pub imports: List[UseDecl] = []
  pub decls: List[Decl] = []
  /// Each top level item's source range and the declarations it gave,
  /// in order (decision 0428: parse_decl parses one again); empty after
  /// a parse error.
  pub ranges: List[DeclRange] = []
}

/// One top level item of a file: its source from its doc comment (or
/// its first token) to the end of its last line, and how many entries of
/// File.decls it gave (a recovered Rust `impl` gives several, a `use`
/// none and is not listed).
pub struct DeclRange {
  pub start: Pos
  pub end: Int
  pub n: Int
}

/// `use path [as name]`, `use go "<path>"`, or `use c "<header>" ...`.
pub struct UseDecl {
  pub span: Span
  pub path: Bytes = b""
  pub alias: Ident? = None
  pub go: Bool = false
  pub c: Bool = false
  pub links: List[Bytes] = []
  /// The effect ceiling of `use c`; `uses none` is Some([]).
  pub effects: List[Effect]? = None
}

/// A function or method declaration; body is None in interfaces and in
/// signature mode.
pub struct FnDecl {
  pub span: Span
  pub doc: Doc? = None
  pub is_pub: Bool = false
  pub recv: Receiver? = None
  pub name: Ident
  pub type_params: List[TypeParam] = []
  pub params: List[Param] = []
  pub result: Type? = None
  pub err: ErrSpec? = None
  pub clauses: List[Clause] = []
  pub body: Block? = None
  /// A body the lazy parse left unparsed (decision 0351 stage 2): its
  /// source range; parse_body parses it. body is None while it is set.
  pub lazy: LazyBody? = None
  /// The parameter list had a hard error: the rest of the signature was
  /// not parsed and the checker gives the function no usable type, so its
  /// call sites report nothing more (a `! E` after a bad parameter read as
  /// the error spec made every call a cascade; field report 0.26.0)
  pub bad_sig: Bool = false
  /// params is empty but not nil in Go (a method recovered from a Rust
  /// `impl` block whose only parameter was `self`): the dump prints
  /// `params: []`.
  pub params_list: Bool = false
}

/// The source of a function body the lazy parse skipped (decision 0351
/// stage 2): from its `{` (start, with its line and column) to the byte
/// after its `}`.
pub struct LazyBody {
  pub start: Pos
  pub end: Int
}

/// `(var name: Type)` before a method name.
pub struct Receiver {
  pub span: Span
  pub is_var: Bool
  pub name: Ident
  pub typ: Type
}

/// `name`, `name: Constraint`, or `name: Effects`.
pub struct TypeParam {
  pub span: Span
  pub name: Ident
  pub constraint: Type? = None
  pub effects: Bool = false
}

/// A function, closure, or test parameter.
pub struct Param {
  pub span: Span
  pub is_var: Bool = false
  pub is_self: Bool = false
  pub name: Ident
  pub typ: Type? = None
  pub default: Expr? = None
}

/// `! [Type]`.
pub struct ErrSpec {
  pub span: Span
  pub typ: Type? = None
}

/// An effect label such as `net` or `fs.read`.
pub struct Effect {
  pub span: Span
  pub name: Ident
  pub sub: Ident? = None
}

/// A function clause.
pub enum Clause {
  UsesClause(span: Span, effects: List[Effect], parens: Bool)
  RequiresClause(span: Span, debug: Bool, cond: Expr, els: Expr?)
  EnsuresClause(span: Span, debug: Bool, cond: Expr)
}

pub struct StructDecl {
  pub span: Span
  pub doc: Doc?
  pub is_pub: Bool
  pub name: Ident
  pub type_params: List[TypeParam]
  pub fields: List[Field] = []
  pub inv: Expr? = None
  pub derive: List[Ident] = []
  /// the derives' arguments, `derive Json(case: camel)` (decision 0277)
  pub derive_args: List[DeriveArg] = []
}

/// An argument of a derive: `case: camel` in `derive Json(case: camel)`
/// (decision 0277).
pub struct DeriveArg {
  pub span: Span
  /// the derive it belongs to
  pub derive: Ident
  pub key: Ident
  pub value: Ident
}

pub struct Field {
  pub span: Span
  pub doc: Doc?
  pub is_pub: Bool
  pub name: Ident
  pub typ: Type
  pub default: Expr? = None
  /// its name on the wire, `kind as "type": Str` (decision 0277): the
  /// derived encoders' and decoders' key or column; None for the field's
  /// own name
  pub wire: Bytes? = None
  pub wire_span: Span? = None
  /// per-format overrides, `json "..."`, `xml "..."`, `sql "..."`
  /// (decision 0315), in source order
  pub formats: List[FormatWire] = []
}

/// One format's wire string of a field (decision 0315): `xml "ID,attr"`.
pub struct FormatWire {
  /// "json", "xml", or "sql"
  pub format: Bytes
  pub wire: Bytes
  pub span: Span
}

pub struct EnumDecl {
  pub span: Span
  pub doc: Doc?
  pub is_pub: Bool
  pub name: Ident
  pub type_params: List[TypeParam]
  pub variants: List[Variant] = []
  pub derive: List[Ident] = []
}

/// An enum variant; fields is None for a unit variant.
pub struct Variant {
  pub span: Span
  pub doc: Doc?
  pub name: Ident
  pub fields: List[VariantField]? = None
}

/// `name: Type` or `from Type` (name None).
pub struct VariantField {
  pub span: Span
  pub name: Ident? = None
  pub from: Bool = false
  pub typ: Type
}

pub struct InterfaceDecl {
  pub span: Span
  pub doc: Doc?
  pub is_pub: Bool
  pub name: Ident
  pub type_params: List[TypeParam]
  pub methods: List[FnDecl] = []
}

/// `type Name = T` or `type Name struct(T)` (newtype).
pub struct TypeDecl {
  pub span: Span
  pub doc: Doc?
  pub is_pub: Bool
  pub name: Ident
  pub type_params: List[TypeParam]
  pub newtype: Bool = false
  pub typ: Type? = None
  /// a newtype's `derive Ord` (decision 0390)
  pub derive: List[Ident] = []
}

/// `const NAME [: T] = value`, at top level or as a statement.
pub struct ConstDecl {
  pub span: Span
  pub doc: Doc?
  pub is_pub: Bool
  pub name: Ident
  pub typ: Type? = None
  pub value: Expr
}

pub struct TestDecl {
  pub span: Span
  pub doc: Doc?
  pub name: StringLit? = None
  pub params: List[Param] = []
  pub seed: Expr? = None
  pub effects: List[Effect] = []
  pub body: Block? = None
}

/// A top level declaration.
pub enum Decl {
  FnDecl(d: FnDecl)
  StructDecl(d: StructDecl)
  EnumDecl(d: EnumDecl)
  InterfaceDecl(d: InterfaceDecl)
  TypeDecl(d: TypeDecl)
  ConstDecl(d: ConstDecl)
  TestDecl(d: TestDecl)
  BadDecl(span: Span)
}

// ---------------------------------------------------------------------------
// Types

/// A type expression.
pub enum Type {
  /// `Int`, `http.Response`, `Map[Str, V]`.
  NamedType(span: Span, path: List[Ident], args: List[Type])
  OptionalType(span: Span, elem: Type)
  /// `(A, B)`; `()` is the unit type.
  TupleType(span: Span, elems: List[Type])
  FnType(t: FnType)
  BadType(span: Span)
}

/// `fn(A, var B) -> R ! E uses fx`.
pub struct FnType {
  pub span: Span
  pub params: List[FnTypeParam] = []
  pub result: Type? = None
  pub err: ErrSpec? = None
  pub effects: List[Effect] = []
  pub uses_parens: Bool = false
}

pub struct FnTypeParam {
  pub span: Span
  pub is_var: Bool
  pub typ: Type
}

// ---------------------------------------------------------------------------
// Statements

pub enum Stmt {
  /// `let PATTERN = e`, or `var PATTERN = e` (is_var, decision 0384: a
  /// tuple, list or struct pattern whose names are all mutable; a single
  /// name is VarStmt)
  LetStmt(span: Span, pattern: Pattern, typ: Type?, value: Expr, is_var: Bool)
  VarStmt(span: Span, name: Ident, typ: Type?, value: Expr)
  AssignStmt(span: Span, op: Kind, target: Expr, value: Expr)
  /// `defer stmt`, or `defer { ... }` as an ExprStmt holding the Block.
  DeferStmt(span: Span, body: Stmt)
  ReturnStmt(span: Span, value: Expr?)
  BreakStmt(span: Span, label: Ident?)
  ContinueStmt(span: Span, label: Ident?)
  /// go_range marks Go's `for k, v := range x`, which the checker
  /// reports (XO0177, decision 0087).
  /// `bound` holds the `bound N` clause or nothing: a List (one word), not
  /// an `Expr?`, which would push MatchArm past the arm64 backend's 4 KiB
  /// reference counting helper frame (gotchas/arm64-rc-helper-frame.md).
  ForStmt(span: Span, label: Ident?, pattern: Pattern, iter: Expr, bound: List[Expr], body: Block, go_range: Bool)
  /// `while let pattern = value` (decision 0137) holds the pattern and the
  /// value as Lists of zero or one element, like `bound`, and no cond.
  WhileStmt(span: Span, label: Ident?, cond: Expr?, pattern: List[Pattern], value: List[Expr], bound: List[Expr], body: Block)
  ExprStmt(span: Span, x: Expr)
  BadStmt(span: Span)
  ConstDecl(d: ConstDecl)
  /// The only statement of a function body the lazy parse skipped and
  /// nothing forced yet (decision 0351 stage 2): reading it is a compiler
  /// bug, so every consumer faults on it (a missed one must never build an
  /// empty function); parser.parse_body gives the body.
  LazyStmt(span: Span)
}

// ---------------------------------------------------------------------------
// Expressions

/// A string literal: plain, triple quoted, or raw.
pub enum StringKind {
  Plain
  Triple
  Raw
}

/// Parts alternate between literal text and interpolated expressions.
pub struct StringLit {
  pub span: Span
  pub kind: StringKind
  pub parts: List[StringPart] = []
}

/// Literal text (expr None) or an interpolated expression.
pub struct StringPart {
  pub text: Bytes
  pub expr: Expr?
  /// `${x:?}`: the Debug text of expr instead of its Display text
  /// (decision 0296).
  pub debug: Bool = false
}

pub struct MapEntry {
  pub span: Span
  pub key: Expr
  pub value: Expr
}

/// `name: value` in a struct literal or `with` update.
pub struct FieldInit {
  pub span: Span
  pub name: Ident
  pub value: Expr
}

/// A call argument, optionally named.
pub struct Arg {
  pub span: Span
  pub name: Ident?
  pub value: Expr
}

/// `if cond { } else ...` or `if let pat = value { } else ...`; els is a
/// Block or an IfExpr.
pub struct IfExpr {
  pub span: Span
  pub cond: Expr? = None
  pub pattern: Pattern? = None
  pub value: Expr? = None
  pub then: Block
  pub els: Expr? = None
}

/// `pattern [if guard] => body`.
pub struct MatchArm {
  pub span: Span
  pub pattern: Pattern
  pub guard: Expr?
  pub body: Stmt?
  /// The `e => body` of `r ?? e => body` (decision 0321): the Err arm of
  /// the match the parser makes of it.
  pub coalesce: Bool = false
}

/// `name = op => body`, `op => body`, or `after d => body`.
pub struct SelectArm {
  pub span: Span
  pub bind: Ident? = None
  pub op: Expr? = None
  pub after: Expr? = None
  pub body: Stmt? = None
}

/// `{ stmts }`.
pub struct Block {
  pub span: Span
  pub stmts: List[Stmt] = []
  /// The right side of `x ?? return v`, `?? break`, or `?? continue`
  /// (decision 0321): one statement that leaves, written without braces.
  pub exit: Bool = false
}

/// A closure literal.
pub struct FnLit {
  pub span: Span
  pub params: List[Param]
  pub result: Type? = None
  pub err: ErrSpec? = None
  pub effects: List[Effect] = []
  pub body: Block
}

pub enum Expr {
  Ident(id: Ident)
  /// value is the decimal value.
  IntLit(span: Span, raw: Bytes, value: Bytes)
  FloatLit(span: Span, raw: Bytes)
  /// nanos is the value in nanoseconds, decimal.
  DurationLit(span: Span, raw: Bytes, nanos: Bytes)
  /// value is the code point.
  RuneLit(span: Span, raw: Bytes, value: Int)
  StringLit(s: StringLit)
  BytesLit(span: Span, value: Bytes)
  HoleExpr(span: Span)
  UnitExpr(span: Span)
  ParenExpr(span: Span, x: Expr)
  TupleExpr(span: Span, elems: List[Expr])
  ListLit(span: Span, elems: List[Expr])
  MapLit(span: Span, entries: List[MapEntry])
  SetLit(span: Span, elems: List[Expr])
  StructLit(span: Span, typ: Expr, fields: List[FieldInit])
  UnaryExpr(span: Span, op: Kind, x: Expr)
  BinaryExpr(span: Span, op: Kind, x: Expr, y: Expr)
  IsExpr(span: Span, x: Expr, pattern: Pattern)
  RangeExpr(span: Span, lo: Expr?, hi: Expr?, inclusive: Bool)
  /// `x.name`, or a tuple field `t.0`.
  SelectorExpr(span: Span, x: Expr, sel: Ident)
  CallExpr(span: Span, fun: Expr, args: List[Arg])
  TypeArgsExpr(span: Span, x: Expr, types: List[Type])
  IndexExpr(span: Span, x: Expr, index: Expr)
  TryExpr(span: Span, x: Expr)
  WithExpr(span: Span, x: Expr, fields: List[FieldInit])
  IfExpr(e: IfExpr)
  MatchExpr(span: Span, subject: Expr, arms: List[MatchArm])
  ScopeExpr(span: Span, name: Ident, body: Block)
  SelectExpr(span: Span, arms: List[SelectArm])
  Block(b: Block)
  FnLit(f: FnLit)
  WhileExpr(span: Span, body: Block)
  BadExpr(span: Span)
}

// ---------------------------------------------------------------------------
// Patterns

pub enum Pattern {
  WildcardPat(span: Span)
  BindPat(span: Span, name: Ident)
  /// A literal, `true`/`false` (an Ident), or a negated number (UnaryExpr).
  LitPat(span: Span, value: Expr)
  RangePat(span: Span, lo: Expr, hi: Expr, inclusive: Bool)
  OrPat(span: Span, alts: List[Pattern])
  TuplePat(span: Span, elems: List[Pattern])
  /// `None`, `Some(x)`, `http.ClientErr.Canceled`, `Db(msg: m, ..)`.
  VariantPat(span: Span, path: List[Ident], parens: Bool, fields: List[PatField], rest: Bool)
  StructPat(span: Span, path: List[Ident], fields: List[PatField], rest: Bool)
  /// rest is the number of elements before `..`, or -1.
  ListPat(span: Span, elems: List[Pattern], rest: Int)
  BadPat(span: Span)
}

/// `[name:] pattern`.
pub struct PatField {
  pub span: Span
  pub name: Ident?
  pub pattern: Pattern
}

// ---------------------------------------------------------------------------
// Spans

pub fn expr_span(e: Expr) -> Span {
  match e {
    Ident(id) => id.span
    IntLit(span, ..) => span
    FloatLit(span, ..) => span
    DurationLit(span, ..) => span
    RuneLit(span, ..) => span
    StringLit(s) => s.span
    BytesLit(span, ..) => span
    HoleExpr(span) => span
    UnitExpr(span) => span
    ParenExpr(span, ..) => span
    TupleExpr(span, ..) => span
    ListLit(span, ..) => span
    MapLit(span, ..) => span
    SetLit(span, ..) => span
    StructLit(span, ..) => span
    UnaryExpr(span, ..) => span
    BinaryExpr(span, ..) => span
    IsExpr(span, ..) => span
    RangeExpr(span, ..) => span
    SelectorExpr(span, ..) => span
    CallExpr(span, ..) => span
    TypeArgsExpr(span, ..) => span
    IndexExpr(span, ..) => span
    TryExpr(span, ..) => span
    WithExpr(span, ..) => span
    IfExpr(e) => e.span
    MatchExpr(span, ..) => span
    ScopeExpr(span, ..) => span
    SelectExpr(span, ..) => span
    Block(b) => b.span
    FnLit(f) => f.span
    WhileExpr(span, ..) => span
    BadExpr(span) => span
  }
}

pub fn type_span(t: Type) -> Span {
  match t {
    NamedType(span, ..) => span
    OptionalType(span, ..) => span
    TupleType(span, ..) => span
    FnType(f) => f.span
    BadType(span) => span
  }
}

pub fn pattern_span(p: Pattern) -> Span {
  match p {
    WildcardPat(span) => span
    BindPat(span, ..) => span
    LitPat(span, ..) => span
    RangePat(span, ..) => span
    OrPat(span, ..) => span
    TuplePat(span, ..) => span
    VariantPat(span, ..) => span
    StructPat(span, ..) => span
    ListPat(span, ..) => span
    BadPat(span) => span
  }
}

/// The span from the start of a to the end of b.
pub fn span_to(a: Span, b: Span) -> Span {
  Span{start: a.start, end: b.end}
}
