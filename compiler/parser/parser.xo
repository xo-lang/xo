// The Xo parser, written in Xo: a port of internal/parser (core 15) on top
// of the self hosted lexer (decision 0127).
//
// It builds the same tree as the Go parser for every file the Go parser
// accepts, so the canonical dumps (dump.xo, `xo astdump`) are byte for
// byte equal; internal/selfhost checks that on every .xo file of the
// repository and on mutated inputs.
//
// Errors: the habit checks of internal/parser (decision 0087), which turn
// syntax from other languages into XO0177 and the other soft errors, are
// ported with their messages, spans, and recovery (habits*.xo), so a file
// the Go parser accepts with only soft errors gives the same tree and the
// same diagnostics. After a hard error the parser goes on as the Go
// parser does: further errors are suppressed until the statement, member,
// arm, or declaration ends, and it resynchronizes there (sync_stmt,
// sync_top), so the diagnostics and the recovered tree are the Go
// parser's for every file.

use github.com/xo-lang/xo/compiler/lexer
use std/crypto

pub type Diag = lexer.Diag
pub type Note = lexer.Note
pub type Fix = lexer.Fix
pub type Edit = lexer.Edit
pub type Comment = lexer.Comment

const UNEXPECTED_TOKEN = "XO0160"
const MISSING_COMMA = "XO0161"
const ELSE_ON_NEW_LINE = "XO0162"
const STRUCT_LIT_IN_CONDITION = "XO0163"
const UNCLOSED_DELIMITER = "XO0164"
const INVALID_PATTERN = "XO0165"
const WHILE_COND_AS_EXPR = "XO0166"
const DECL_IN_BLOCK = "XO0167"
const STMT_AT_TOP_LEVEL = "XO0168"
const MATCH_ARM_SEPARATOR = "XO0169"
const FN_TYPE_EFFECTS_PARENS = "XO0170"
const MISPLACED_REST = "XO0171"
const MISSING_BODY = "XO0172"
const USE_AFTER_DECL = "XO0173"
const MISPLACED_SELF = "XO0174"
const EXPECTED_NEWLINE = "XO0175"
const MISPLACED_PUB = "XO0176"
const FOREIGN_SYNTAX = "XO0177"
const LEADING_OPERATOR = "XO0178"
const MALFORMED_IMPORT_PATH = "XO0158"

/// The tree of one file and its diagnostics. A file with no diagnostics
/// is accepted.
pub struct ParseResult {
  pub file: File
  pub diags: List[Diag]
  /// A hard error was reported (not only lexer diagnostics and soft
  /// errors): the tree holds Bad nodes where the parser resynchronized.
  pub hard: Bool = false
  /// The SHA-256 of the file's interface (iface.xo: its tokens outside
  /// function bodies, without comments or layout), for cache keys.
  pub iface: Str = ""
}

struct Parser {
  /// The file's name, as diagnostics name it.
  file: Bytes = b""
  src: Bytes
  toks: List[Token]
  pos: Int = 0
  tok: Token
  /// Signature mode: function declarations may omit their body (std
  /// declaration files).
  sig: Bool = false
  /// Lazy mode (decision 0351 stage 2): a function body is skipped by its
  /// braces and recorded (FnDecl.lazy) instead of parsed.
  lazy: Bool = false
  /// No struct literals: the head of if, while, for, match, requires,
  /// ensures (core 1.4).
  no_lit: Bool = false
  /// `a..` with no upper bound is allowed (inside an index).
  open_range: Bool = false
  /// Parsing a type where no comma may follow (return types, aliases).
  fn_type_top: Bool = false
  /// `(x) =>` and `x =>` are not arrow functions here (select operations,
  /// match guards).
  no_arrow_fn: Bool = false
  /// Doc comments keyed by their last line.
  docs: Map[Int, Doc] = {}
  /// The lexer's diagnostics, the soft errors, and the hard errors.
  diags: List[Diag] = []
  /// A hard error was reported in the current statement, member, arm, or
  /// declaration: further errors are suppressed until it ends
  /// (internal/parser p.bad).
  bad: Bool = false
  /// A hard error was reported anywhere.
  hard: Bool = false
  /// A foreign top level line was consumed whole (habits).
  line_done: Bool = false
  /// Parsing the methods of a Rust `impl` block.
  in_impl: Bool = false
  /// Inside an outermost `Name<...>` type argument list (habits).
  angle_active: Bool = false
  /// The edits of the outermost `<...>` list: `[` and `]` for each bracket.
  angle_edits: List[Edit] = []
  /// An inner `<...>` list consumed `>>`, closing the outer one too.
  angle_pending_gt: Bool = false
  /// The start of the first declaration (or its doc comment).
  first_decl: Pos = Pos{offset: 0, line: 1, col: 1}
  /// Further methods recovered from a Rust `impl` block.
  pending_decls: List[FnDecl] = []
  /// The top level items' ranges (File.ranges).
  ranges: List[DeclRange] = []
}

/// Parses one file. With sig, function declarations may omit their body.
pub fn parse_file(name: Bytes, src: Bytes, sig: Bool) -> ParseResult { parse_file_mode(name, src, sig, false) }

/// parse_file with function bodies skipped and recorded (FnDecl.lazy;
/// decision 0351 stage 2): the declarations, the interface, and the
/// lexer's and habits' diagnostics are a full parse's; a body's own
/// parse errors are reported only when parse_body parses it.
pub fn parse_file_lazy(name: Bytes, src: Bytes, sig: Bool) -> ParseResult { parse_file_mode(name, src, sig, true) }

fn parse_file_mode(name: Bytes, src: Bytes, sig: Bool, lazy: Bool) -> ParseResult {
  let lx = lexer.lex(src)
  var p = Parser{file: name, src: src, toks: lx.tokens, tok: lx.tokens[0], sig: sig, lazy: lazy, diags: lx.diags}
  p.collect_docs(lx.comments)
  p.lex_habits()
  p.tok = p.toks[0]
  let f = p.parse_file(name)
  let iface = crypto.sha256(iface_bytes(lx.tokens, if p.hard { [] } else { f.decls })).to_hex()
  ParseResult{file: f, diags: sort_diags(p.diags), hard: p.hard, iface: iface}
}

/// The body of a function the lazy parse skipped (decision 0351 stage 2),
/// parsed from src (the file's bytes) as parse_file would have, spans
/// included, and the diagnostics of its parse.
pub fn parse_body(name: Bytes, src: Bytes, lb: LazyBody) -> (Block, List[Diag]) {
  let lx = lexer.lex_from(src, lb.start, lb.end)
  var p = Parser{file: name, src: src, toks: lx.tokens, tok: lx.tokens[0], diags: lx.diags}
  p.lex_habits()
  p.tok = p.toks[0]
  let b = p.parse_block()
  (b, sort_diags(p.diags))
}

/// The declarations of the top level item r of the file name with
/// source src (a range of its parse's File.ranges), parsed from that
/// range alone as the file's parse gave them, spans included (decision
/// 0428), lazily (bodies skipped) when lazy; None when they are not r.n
/// declarations or the range does not parse cleanly (the caller parses
/// the file).
pub fn parse_decl(name: Bytes, src: Bytes, r: DeclRange, sig: Bool, lazy: Bool) -> List[Decl]? {
  if r.start.offset < 0 || r.end > src.len() || r.start.offset >= r.end {
    return None
  }
  let lx = lexer.lex_from(src, r.start, r.end)
  if !lx.diags.is_empty() || lx.tokens.is_empty() {
    return None
  }
  var p = Parser{file: name, src: src, toks: lx.tokens, tok: lx.tokens[0], sig: sig, lazy: lazy}
  p.collect_docs(lx.comments)
  p.lex_habits()
  p.tok = p.toks[0]
  p.skip_newlines()
  let doc = p.doc_for(p.tok.span.start.line)
  let decl_start = p.tok.span.start
  let pub_tok = p.tok
  let is_pub = p.got(Kind.Pub)
  var imports: List[UseDecl] = []
  var out: List[Decl] = []
  if let Some(d) = p.parse_top_decl(imports, doc, is_pub, pub_tok, decl_start, true) {
    out.push(d)
  }
  for pd in p.pending_decls {
    out.push(Decl.FnDecl(pd))
  }
  if !p.diags.is_empty() || p.hard || p.bad || out.len() != r.n || !imports.is_empty() {
    return None
  }
  Some(out)
}

/// r (a lazy parse of src, parse_file_lazy) with every skipped body
/// parsed (parse_body) and its diagnostics added: what parse_file gives
/// (decision 0351 stage 2; the parser's lazy test compares the two).
pub fn force_bodies(name: Bytes, src: Bytes, r: ParseResult) -> ParseResult {
  var out = r
  var diags = r.diags
  var decls: List[Decl] = []
  for d in r.file.decls {
    if let FnDecl(d: fd) = d {
      if let Some(lb) = fd.lazy {
        let (b, ds) = parse_body(name, src, lb)
        var f = fd
        f.body = Some(b)
        f.lazy = None
        decls.push(Decl.FnDecl(d: f))
        diags = diags + ds
        continue
      }
    }
    decls.push(d)
  }
  out.file.decls = decls
  out.diags = sort_diags(diags)
  out
}

/// At a body's `{`: steps past its matching `}` (by brace depth over the
/// tokens; braces in strings and comments are not tokens) and returns
/// the body's source range.
fn (var p: Parser) skip_body() -> (LazyBody, Span) {
  let start = p.tok.span.start
  var depth = 0
  var end = start.offset
  var end_pos = start
  while p.tok.kind != Kind.Eof {
    if p.tok.kind == Kind.LBrace || p.tok.kind == Kind.HashLBrace {
      // `#{` opens a set literal, closed by `}`
      depth += 1
    } else if p.tok.kind == Kind.RBrace {
      depth -= 1
      if depth == 0 {
        end = p.tok.span.end.offset
        end_pos = p.tok.span.end
        p.next()
        break
      }
    }
    p.next()
  }
  (LazyBody{start: start, end: end}, Span{start: start, end: end_pos})
}

/// Orders diagnostics by position, keeping the order of equal ones
/// (diag.Sort, a stable sort by line and column).
fn sort_diags(ds: List[Diag]) -> List[Diag] {
  var out: List[Diag] = []
  for d in ds {
    var i = out.len()
    while i > 0 && pos_after(out[i - 1].span.start, d.span.start) {
      i -= 1
    }
    out.insert(i, d)
  }
  out
}

fn pos_after(a: Pos, b: Pos) -> Bool {
  a.line > b.line || (a.line == b.line && a.col > b.col)
}

// ---------------------------------------------------------------------------
// Token helpers

fn (var p: Parser) next() {
  if p.pos < p.toks.len() - 1 {
    p.pos += 1
  }
  p.tok = p.toks[p.pos]
}

fn (p: Parser) at(k: Kind) -> Bool {
  p.tok.kind == k
}

/// The token n past the current one, or the final Eof.
fn (p: Parser) peek(n: Int) -> Token {
  p.tok_at(p.pos + n)
}

/// The token at index i, clamped to the token list.
fn (p: Parser) tok_at(i: Int) -> Token {
  if i < 0 {
    return p.toks[0]
  }
  if i >= p.toks.len() {
    return p.toks[p.toks.len() - 1]
  }
  p.toks[i]
}

fn (p: Parser) at_ident(name: Bytes) -> Bool {
  p.tok.kind == Kind.Ident && p.tok.text == name
}

fn is_word(t: Token, name: Bytes) -> Bool {
  t.kind == Kind.Ident && t.text == name
}

fn (var p: Parser) got(k: Kind) -> Bool {
  if p.tok.kind == k {
    p.next()
    return true
  }
  false
}

fn (var p: Parser) skip_newlines() {
  while p.tok.kind == Kind.Newline {
    p.next()
  }
}

/// The first token at or after the current one that is not a newline.
fn (p: Parser) peek_past_newlines() -> Token {
  var i = p.pos
  while i < p.toks.len() - 1 && p.toks[i].kind == Kind.Newline {
    i += 1
  }
  p.toks[i]
}

fn (p: Parser) prev_end() -> Pos {
  if p.pos == 0 {
    return p.tok.span.start
  }
  p.toks[p.pos - 1].span.end
}

/// The span from start to the end of the previous token.
fn (p: Parser) span_from(start: Pos) -> Span {
  var end = p.prev_end()
  if end.offset < start.offset {
    end = start
  }
  Span{start: start, end: end}
}

/// Whether b starts exactly where a ends.
fn adjacent(a: Token, b: Token) -> Bool {
  a.span.end.offset == b.span.start.offset
}

/// The Go parser's description of a token in messages (describe).
fn describe(t: Token) -> Str {
  describe_go(t)
}

// ---------------------------------------------------------------------------
// Errors

/// Records a hard error (internal/parser errorf) unless one is pending
/// for the current statement or declaration; the parse goes on and
/// resynchronizes where that ends. Like the Go parser, an error at an
/// Illegal token the lexer already reported adds no diagnostic. It returns
/// the index of the diagnostic in p.diags, for notes and fixes, or -1.
fn (var p: Parser) fail(code: Str, sp: Span, message: Str) -> Int {
  if p.bad {
    return -1
  }
  p.bad = true
  p.hard = true
  if p.tok.kind == Kind.Illegal && sp.start.offset == p.tok.span.start.offset {
    return -1
  }
  p.diags.push(Diag{code: code, span: sp, message: message.bytes()})
  p.diags.len() - 1
}

fn (p: Parser) failed() -> Bool {
  p.bad
}

/// A soft error (internal/parser softErrorf): reported, and the parser
/// recovers locally.
/// It returns the index of the diagnostic, or -1 when none was added.
fn (var p: Parser) soft(code: Str, sp: Span, message: Str) -> Int {
  if p.bad {
    return -1
  }
  p.diags.push(Diag{code: code, span: sp, message: message.bytes()})
  p.diags.len() - 1
}

/// A habit of another language (decision 0087) at sp: XO0177, a soft
/// error; the caller recovers as if the Xo form had been written.
fn (var p: Parser) foreign(sp: Span, message: Str) -> Int {
  p.soft(FOREIGN_SYNTAX, sp, message)
}

fn (var p: Parser) error_expected(what: Str) -> Int {
  p.fail(UNEXPECTED_TOKEN, p.tok.span, "expected ${what}, found ${describe(p.tok)}")
}

// ---------------------------------------------------------------------------
// Notes and fixes (internal/parser habits.go addNote, addFix; decision
// 0141, stage 7)

/// Attaches a machine fix to diagnostic d (-1: none); a fix without edits
/// is dropped.
fn (var p: Parser) add_fix(d: Int, title: Str, edits: List[Edit]) {
  if d < 0 || edits.is_empty() {
    return
  }
  p.diags[d].fixes.push(Fix{title: title.bytes(), edits: edits})
}

/// Attaches a note without a span to diagnostic d (-1: none).
fn (var p: Parser) add_note(d: Int, message: Str) {
  if d < 0 {
    return
  }
  p.diags[d].notes.push(Note{message: message.bytes()})
}

/// Replaces the source between a and b with text.
fn replace_range(a: Pos, b: Pos, text: Str) -> Edit {
  Edit{span: Span{start: a, end: b}, replace: text.bytes()}
}

/// Replaces the source of sp with text.
fn replace_span(sp: Span, text: Str) -> Edit {
  replace_range(sp.start, sp.end, text)
}

/// Inserts text at pos.
fn insert_at(pos: Pos, text: Str) -> Edit {
  Edit{span: Span{start: pos, end: pos}, replace: text.bytes()}
}

/// Consumes a token of kind k, or fails.
fn (var p: Parser) expect(k: Kind, what: Str) -> Token {
  let t = p.tok
  if t.kind != k {
    p.error_expected(what)
    return Token{kind: Kind.Illegal, span: Span{start: t.span.start, end: t.span.start}, text: b""}
  }
  p.next()
  t
}

fn (var p: Parser) expect_ident(what: Str) -> Ident {
  if p.tok.kind == Kind.Ident {
    let id = Ident{span: p.tok.span, name: p.tok.text}
    p.next()
    return id
  }
  p.error_expected(what)
  Ident{span: Span{start: p.tok.span.start, end: p.tok.span.start}, name: b""}
}

// ---------------------------------------------------------------------------
// Lists

/// The parser state a bracketed list saves and restores.
struct ListState {
  start: Pos
  no_lit: Bool
  open_range: Bool
}

/// Opens `open elem, elem, ... close` (internal/parser parseList): struct
/// literals and open ranges are allowed again inside the brackets.
fn (var p: Parser) list_open(open: Kind) -> ListState {
  let st = ListState{start: p.tok.span.start, no_lit: p.no_lit, open_range: p.open_range}
  p.expect(open, "`${kind_text(open)}`")
  p.no_lit = false
  p.open_range = false
  st
}

fn (p: Parser) list_more(close: Kind) -> Bool {
  !p.at(close) && !p.at(Kind.Eof)
}

/// After an element: consumes a `,` and reports whether another element
/// may follow. A newline where a comma belongs is an error (core 1.3).
fn (var p: Parser) list_sep(before: Int, close: Kind, what: Str) -> Bool {
  if p.failed() || p.pos == before {
    return false
  }
  if p.got(Kind.Comma) {
    return true
  }
  if p.at(Kind.Newline) {
    let nl = p.tok
    let d = p.soft(MISSING_COMMA, nl.span, "missing `,` before newline in ${what} list")
    if d >= 0 {
      p.diags[d].notes.push(Note{message: b"a list that spans lines needs a comma after every element, including the last (core 1.3)"})
      p.diags[d].fixes.push(Fix{title: b"insert `,`", edits: [insert_at(nl.span.start, ",")]})
    }
    p.skip_newlines()
    return true
  }
  if !p.at(close) {
    p.fail(UNEXPECTED_TOKEN, p.tok.span, "expected `,` or `${kind_text(close)}` in ${what} list, found ${describe(p.tok)}")
  }
  false
}

/// Closes a list and returns its span, from the opening bracket to the
/// end of the closing one.
fn (var p: Parser) list_close(st: ListState, close: Kind) -> Span {
  let end = p.tok.span.end
  p.expect(close, "`${kind_text(close)}`")
  p.no_lit = st.no_lit
  p.open_range = st.open_range
  Span{start: st.start, end: end}
}

/// The state a brace delimited list of members, statements, or arms
/// saves and restores (internal/parser parseMembers, parseBlock,
/// parseArms).
struct Braces {
  open: Token
  bad: Bool
  no_lit: Bool
  open_range: Bool
}

/// `{` of a member, statement, or arm list: None, with an error, when it
/// is missing. With clear, struct literals and open ranges are allowed
/// again inside (blocks and arms).
fn (var p: Parser) braces_open(clear: Bool) -> Braces? {
  let open = p.expect(Kind.LBrace, "`{`")
  if open.kind != Kind.LBrace {
    return None
  }
  let st = Braces{open: open, bad: p.bad, no_lit: p.no_lit, open_range: p.open_range}
  if clear {
    p.no_lit = false
    p.open_range = false
  }
  Some(st)
}

/// Whether another member, statement, or arm follows inside braces; it
/// starts one (clears the error state) and returns its first token's
/// index in before.
fn (var p: Parser) braces_more(var before: Int) -> Bool {
  p.skip_newlines()
  if p.at(Kind.RBrace) || p.at(Kind.Eof) {
    return false
  }
  p.bad = false
  before = p.pos
  true
}

/// After a member: a `,`, a newline, or the closing `}`; after an error,
/// resynchronizes at the end of the member.
fn (var p: Parser) member_end(what: Str, before: Int) {
  if !p.bad {
    if p.got(Kind.Comma) || p.got(Kind.Newline) || p.at(Kind.RBrace) {
      return
    }
    p.fail(UNEXPECTED_TOKEN, p.tok.span, "expected newline, `,`, or `}` after ${what}, found ${describe(p.tok)}")
  }
  p.resync(before)
}

/// Skips to the end of a statement, member, or arm with an error, at
/// least one token past before.
fn (var p: Parser) resync(before: Int) {
  p.sync_stmt()
  if p.pos == before {
    p.next()
  }
}

/// Skips to the end of the current statement: a newline at the current
/// nesting depth (consumed) or a `}` that closes the enclosing block (not
/// consumed) (internal/parser syncStmt).
fn (var p: Parser) sync_stmt() {
  var depth = 0
  while !p.at(Kind.Eof) {
    match p.tok.kind {
      Newline => {
        if depth == 0 {
          p.next()
          return
        }
      }
      LParen | LBrack | LBrace | HashLBrace => depth += 1
      RParen | RBrack => {
        if depth > 0 {
          depth -= 1
        }
      }
      RBrace => {
        if depth == 0 {
          return
        }
        depth -= 1
      }
      _ => {}
    }
    p.next()
  }
}

/// Closes a brace list: restores the state braces_open saved and expects
/// the `}`.
fn (var p: Parser) braces_close(st: Braces) {
  p.bad = st.bad
  p.no_lit = st.no_lit
  p.open_range = st.open_range
  p.close_brace(st.open)
}

fn (var p: Parser) close_brace(open: Token) {
  if p.at(Kind.Eof) {
    let d = p.fail(UNCLOSED_DELIMITER, open.span, "`{` is never closed")
    if d >= 0 {
      p.diags[d].notes.push(Note{message: b"reached end of file", span: Some(p.tok.span)})
    }
    return
  }
  p.expect(Kind.RBrace, "`}`")
}

// ---------------------------------------------------------------------------
// Doc comments

fn (var p: Parser) collect_docs(comments: List[Comment]) {
  var cur: Doc? = None
  var last = -10
  for c in comments {
    if !c.doc || !p.own_line(c.span.start) {
      cur = None
      last = -10
      continue
    }
    let line = c.span.start.line
    var d = Doc{span: c.span, text: c.text}
    if let Some(prev) = cur {
      if line == last + 1 {
        p.docs.remove(last)
        d = Doc{span: Span{start: prev.span.start, end: c.span.end}, text: prev.text + b"\n" + c.text}
      }
    }
    cur = Some(d)
    p.docs[line] = d
    last = line
  }
}

/// Whether only blanks precede pos on its line.
fn (p: Parser) own_line(pos: Pos) -> Bool {
  var i = pos.offset - 1
  while i >= 0 {
    let c = p.src[i]
    if c == '\n' {
      return true
    }
    if c != ' ' && c != '\t' {
      return false
    }
    i -= 1
  }
  true
}

/// The doc comment ending on the line before line.
fn (p: Parser) doc_for(line: Int) -> Doc? {
  p.docs.get(line - 1)
}

// ---------------------------------------------------------------------------
// File and declarations

fn (var p: Parser) parse_file(name: Bytes) -> File {
  let start = p.tok.span.start
  var imports: List[UseDecl] = []
  var decls: List[Decl] = []
  var seen_decl = false
  while {
    p.skip_newlines()
    if p.at(Kind.Eof) {
      break
    }
    p.bad = false
    let doc = p.doc_for(p.tok.span.start.line)
    let decl_start = p.tok.span.start
    let n0 = decls.len()
    let pub_tok = p.tok
    let is_pub = p.got(Kind.Pub)
    if let Some(d) = p.parse_top_decl(imports, doc, is_pub, pub_tok, decl_start, seen_decl) {
      decls.push(d)
      if !seen_decl {
        p.first_decl = decl_start
        if let Some(dc) = doc {
          p.first_decl = dc.span.start
        }
      }
      seen_decl = true
    }
    for pd in p.pending_decls {
      decls.push(Decl.FnDecl(pd))
    }
    p.pending_decls = []
    if decls.len() > n0 {
      let rs = match doc {
        Some(dc) => if dc.span.start.offset < decl_start.offset { dc.span.start } else { decl_start }
        None => decl_start
      }
      p.ranges.push(DeclRange{start: rs, end: p.tok.span.start.offset, n: decls.len() - n0})
    }
    if p.bad {
      p.sync_top()
      continue
    }
    if p.line_done {
      p.line_done = false
      continue
    }
    if !p.at(Kind.Eof) && !p.got(Kind.Newline) {
      p.fail(EXPECTED_NEWLINE, p.tok.span, "expected newline after declaration, found ${describe(p.tok)}")
      p.sync_top()
    }
  }
  let ranges = if p.diags.is_empty() && !p.hard { p.ranges } else { [] }
  File{span: Span{start: start, end: p.tok.span.end}, name: name, imports: imports, decls: decls, ranges: ranges}
}

/// One top level item after an optional `pub`: None for a `use` (pushed
/// on imports) and for skipped foreign lines.
fn (var p: Parser) parse_top_decl(var imports: List[UseDecl], doc: Doc?, is_pub: Bool, pub_tok: Token, decl_start: Pos, seen_decl: Bool) -> Decl? {
  match p.tok.kind {
    Use => {
      if is_pub {
        p.soft(MISPLACED_PUB, pub_tok.span, "`use` cannot be `pub`")
      }
      let use_tok = p.tok
      let u = p.parse_use()
      if seen_decl {
        let d = p.soft(USE_AFTER_DECL, use_tok.span, "`use` must come before all declarations")
        p.move_use_fix(d, imports, u)
      }
      imports.push(u)
      None
    }
    Fn => Some(Decl.FnDecl(p.parse_fn_decl(doc, is_pub, decl_start, false)))
    Struct => Some(Decl.StructDecl(p.parse_struct(doc, is_pub, decl_start)))
    Enum => Some(Decl.EnumDecl(p.parse_enum(doc, is_pub, decl_start)))
    Interface => Some(Decl.InterfaceDecl(p.parse_interface(doc, is_pub, decl_start)))
    Type => Some(p.parse_type_decl(doc, is_pub, decl_start))
    Const => Some(Decl.ConstDecl(p.parse_const(doc, is_pub, decl_start)))
    Test => {
      if is_pub {
        p.soft(MISPLACED_PUB, pub_tok.span, "a test cannot be `pub`")
      }
      Some(Decl.TestDecl(p.parse_test(doc, decl_start)))
    }
    _ => {
      let (fd, ok) = p.foreign_top_level(imports, doc, is_pub, pub_tok, decl_start, seen_decl)
      if ok {
        return fd
      }
      if is_pub {
        p.fail(UNEXPECTED_TOKEN, p.tok.span, "expected a declaration after `pub`, found ${describe(p.tok)}")
      } else {
        p.top_level_stmt_error()
      }
      Some(Decl.BadDecl(p.tok.span))
    }
  }
}

/// Skips to the next line that starts a top level declaration in column
/// one (internal/parser syncTop).
fn (var p: Parser) sync_top() {
  p.next()
  while !p.at(Kind.Eof) && !p.top_level_start() {
    p.next()
  }
}

/// Whether the current token can start a top level declaration and sits
/// in column one (internal/parser topLevelStart).
fn (p: Parser) top_level_start() -> Bool {
  if p.tok.span.start.col != 1 {
    return false
  }
  match p.tok.kind {
    Fn | Pub | Struct | Enum | Interface | Type | Const | Test | Use => true
    Ident => {
      let w = p.tok.text
      let foreign = w == b"func" || w == b"fun" || w == b"def" || w == b"function" || w == b"impl" || w == b"trait" || w == b"protocol" || w == b"class" || w == b"export" || w == b"async" || w == b"data" || w == b"public"
      foreign && p.peek(1).kind == Kind.Ident
    }
    _ => false
  }
}

fn (var p: Parser) top_level_stmt_error() {
  match p.tok.kind {
    Let | Var | Return | For | While | If | Match | Defer | Break | Continue | Scope | Select | Ident | Int | String | LParen | LBrack | LBrace => p.fail(STMT_AT_TOP_LEVEL, p.tok.span, "statements are only allowed inside a function or test body, found ${describe(p.tok)}")
    _ => p.error_expected("a declaration")
  }
}

/// Whether b holds any byte of set.
fn has_any(b: Bytes, set: Bytes) -> Bool {
  for i in 0..b.len() {
    for j in 0..set.len() {
      if b[i] == set[j] {
        return true
      }
    }
  }
  false
}

fn (var p: Parser) parse_use() -> UseDecl {
  let start = p.tok.span.start
  p.next() // use
  var u = UseDecl{span: p.tok.span}
  if p.at(Kind.ImportPath) {
    u.path = p.tok.value
    p.next()
    if u.path == b"go" && (p.at(Kind.String) || p.at(Kind.RawString)) {
      // `use go "<Go import path>"` (decision 0041)
      u.go = true
      let t = p.tok
      var interp = false
      u.path = t.value
      if t.kind == Kind.String {
        var b = BytesBuilder.new()
        for part in t.parts {
          if part.is_expr {
            interp = true
          }
          b.write(part.text)
        }
        u.path = b.freeze()
      }
      p.next()
      let path = u.path
      if interp || path.is_empty() || has_any(path, b" \t\n\\") || path[0] == '/' || path[0] == '.' || path[path.len() - 1] == '/' {
        p.fail(MALFORMED_IMPORT_PATH, t.span, "malformed Go import path ${path.quote()}")
      }
    } else if u.path == b"c" && (p.at(Kind.String) || p.at(Kind.RawString)) {
      // `use c "<header>" [link "<lib>"]...` (decision 0116)
      u.c = true
      let (h, sp, ok) = p.plain_string()
      u.path = h
      if !ok || h.is_empty() || has_any(h, b"\t\n\\\"") || h[h.len() - 1] == '/' {
        p.fail(MALFORMED_IMPORT_PATH, sp, "malformed C header path ${h.quote()}")
      }
      while p.at_ident(b"link") {
        p.next()
        if !p.at(Kind.String) && !p.at(Kind.RawString) {
          p.fail(MALFORMED_IMPORT_PATH, p.tok.span, "expected a library after `link`, found ${describe(p.tok)}")
          break
        }
        let (l, lsp, lok) = p.plain_string()
        if !lok || l.is_empty() || has_any(l, b" \t\n\\") {
          p.fail(MALFORMED_IMPORT_PATH, lsp, "malformed `link` library ${l.quote()}")
        }
        u.links.push(l)
      }
    }
  } else {
    p.fail(MALFORMED_IMPORT_PATH, p.tok.span, "expected an import path after `use`, found ${describe(p.tok)}")
  }
  if p.got(Kind.As) {
    u.alias = Some(p.expect_ident("a name after `as`"))
  }
  if u.c && p.at(Kind.Uses) {
    p.next()
    var effs: List[Effect] = []
    if p.at_ident(b"none") {
      p.next()
    } else {
      while {
        effs.push(p.parse_effect())
        if !p.got(Kind.Comma) {
          break
        }
      }
    }
    u.effects = Some(effs)
  }
  u.span = p.span_from(start)
  u
}

/// Consumes a string literal; its text, span, and false when it
/// interpolates.
fn (var p: Parser) plain_string() -> (Bytes, Span, Bool) {
  let t = p.tok
  p.next()
  if t.kind != Kind.String {
    return (t.value, t.span, true)
  }
  var b = BytesBuilder.new()
  var ok = true
  for part in t.parts {
    if part.is_expr {
      ok = false
    }
    b.write(part.text)
  }
  (b.freeze(), t.span, ok)
}

fn (var p: Parser) parse_fn_decl(doc: Doc?, is_pub: Bool, start: Pos, in_interface: Bool) -> FnDecl {
  p.next() // fn
  var recv: Receiver? = None
  if p.at(Kind.LParen) {
    recv = Some(p.parse_receiver())
  }
  let name = p.expect_ident("a function name")
  var fn_decl = FnDecl{span: p.tok.span, doc: doc, is_pub: is_pub, recv: recv, name: name}
  if p.at_type_params() {
    fn_decl.type_params = p.parse_type_params()
  }
  fn_decl.params = p.parse_params(false, in_interface || p.in_impl)
  fn_decl.bad_sig = p.bad
  var throws_tok: List[Token] = []
  if !p.bad && p.at_ident(b"throws") {
    throws_tok.push(p.tok)
    p.next()
  }
  if !p.bad {
    p.foreign_result(fn_decl)
  }
  if !p.bad && p.at(Kind.Newline) && p.peek_past_newlines().kind == Kind.Arrow {
    // A result type on the next line continues the declaration.
    p.skip_newlines()
  }
  if !fn_decl.bad_sig && fn_decl.result.is_none() && p.got(Kind.Arrow) {
    fn_decl.result = Some(p.parse_type_top())
  }
  if !fn_decl.bad_sig && p.at(Kind.Bang) {
    fn_decl.err = Some(p.parse_err_spec())
  }
  for t in throws_tok {
    p.foreign_throws(fn_decl, t)
  }
  fn_decl.clauses = p.parse_clauses()
  if p.peek_past_newlines().kind == Kind.LBrace {
    p.skip_newlines()
    if in_interface && !p.bad {
      p.soft(UNEXPECTED_TOKEN, p.tok.span, "interface method `${txt(name.name)}` cannot have a body (core 15: FnSig)")
    }
    if p.lazy && !in_interface {
      let (lb, sp) = p.skip_body()
      fn_decl.lazy = Some(lb)
      // the sentinel body (decision 0351): a reader that skips
      // parse_body faults on its LazyStmt instead of building an empty
      // function; its span is the real body's
      fn_decl.body = Some(Block{span: sp, stmts: [Stmt.LazyStmt(span: sp)]})
    } else {
      fn_decl.body = Some(p.parse_block())
    }
  } else if !in_interface && !p.sig {
    p.fail(MISSING_BODY, p.tok.span, "expected `{` to start the body of `${txt(name.name)}`, found ${describe(p.tok)}")
  }
  fn_decl.span = p.span_from(start)
  fn_decl
}

/// Whether the token at index i can start a type (habit checks).
fn (p: Parser) starts_type_at(i: Int) -> Bool {
  if i >= p.toks.len() {
    return false
  }
  p.tok_at(i).kind is Ident | LParen | Fn | LBrack | Star | Amp
}

fn (var p: Parser) parse_receiver() -> Receiver {
  let start = p.tok.span.start
  p.next() // (
  let is_var = p.got(Kind.Var)
  let name = p.expect_ident("a receiver name")
  if !p.bad && (p.at(Kind.Star) || p.at(Kind.Ident)) {
    // Go receivers: `(p *P)` and `(p P)`.
    let t = p.tok
    let n = txt(name.name)
    if t.kind == Kind.Star {
      let ty = txt(p.peek(1).text)
      let d = p.foreign(t.span, "a pointer receiver `*${ty}` is Go syntax; an Xo receiver is a value, `(${n}: ${ty})`, and `(var ${n}: ${ty})` lets the method change the caller's value (core 3.4)")
      p.add_fix(d, "write `: ${ty}`", [replace_range(name.span.end, p.peek(1).span.start, ": ")])
      p.next()
    } else {
      let d = p.foreign(t.span, "`(${n} ${txt(t.text)})` is Go syntax; Xo writes the receiver type after a colon, `(${n}: ${txt(t.text)})` (core 3.4)")
      p.add_fix(d, "insert `:`", [replace_range(name.span.end, t.span.start, ": ")])
    }
    let typ = p.parse_type()
    p.expect(Kind.RParen, "`)` after the receiver")
    return Receiver{span: p.span_from(start), is_var: is_var, name: name, typ: typ}
  }
  p.expect(Kind.Colon, "`:` after the receiver name")
  let typ = p.parse_type()
  p.expect(Kind.RParen, "`)` after the receiver")
  Receiver{span: p.span_from(start), is_var: is_var, name: name, typ: typ}
}

/// Whether a type parameter list starts here: `[` or, as a habit, `<`
/// right after the declared name.
fn (p: Parser) at_type_params() -> Bool {
  p.at(Kind.LBrack) || (p.at(Kind.Lt) && p.pos > 0 && p.toks[p.pos - 1].kind == Kind.Ident && adjacent(p.toks[p.pos - 1], p.tok))
}

fn (var p: Parser) parse_type_params() -> List[TypeParam] {
  var out: List[TypeParam] = []
  if p.at(Kind.Lt) {
    // `<T>` type parameters (internal/parser angleTypeParams).
    let open = p.tok
    p.next() // <
    while !p.bad && !p.at(Kind.Gt) && !p.at(Kind.Eof) {
      out.push(p.parse_type_param())
      if !p.got(Kind.Comma) {
        break
      }
    }
    let close = p.tok
    if !p.at(Kind.Gt) {
      p.error_expected("`>` to close the type parameters")
      return out
    }
    p.next()
    let d = p.foreign(span_to(open.span, close.span), "`<T>` type parameters are Rust, TypeScript, Kotlin, and Swift syntax; Xo writes them in square brackets, `[T]` (core 2.7)")
    p.add_fix(d, "use square brackets", [replace_span(open.span, "["), replace_span(close.span, "]")])
    return out
  }
  let st = p.list_open(Kind.LBrack)
  while p.list_more(Kind.RBrack) {
    let before = p.pos
    out.push(p.parse_type_param())
    if !p.list_sep(before, Kind.RBrack, "type parameter") {
      break
    }
  }
  p.list_close(st, Kind.RBrack)
  out
}

fn (var p: Parser) parse_type_param() -> TypeParam {
  let start = p.tok.span.start
  let name = p.expect_ident("a type parameter name")
  var tp = TypeParam{span: p.tok.span, name: name}
  if p.at_ident(b"extends") && p.peek(1).kind == Kind.Ident {
    // TypeScript and Kotlin `T extends Bound`.
    let n = txt(name.name)
    let b = txt(p.peek(1).text)
    let d = p.foreign(p.tok.span, "`${n} extends ${b}` is TypeScript syntax; Xo writes a constraint after a colon, `${n}: ${b}` (core 2.7)")
    p.add_fix(d, "write `:`", [replace_range(name.span.end, p.peek(1).span.start, ": ")])
    p.next()
    let first = p.parse_type()
    tp.constraint = p.parse_bounds(name, first)
    tp.span = p.span_from(start)
    return tp
  }
  if p.got(Kind.Colon) {
    let first = p.parse_type()
    if let Some(t) = p.parse_bounds(name, first) {
      if is_effects_kind(t) {
        tp.effects = true
      } else {
        tp.constraint = Some(t)
      }
    }
  }
  tp.span = p.span_from(start)
  tp
}

/// Whether t is the bare name `Effects` (an effect variable, core 6.2).
fn is_effects_kind(t: Type) -> Bool {
  match t {
    NamedType(_, path, args) => path.len() == 1 && path[0].name == b"Effects" && args.is_empty()
    OptionalType(..) | TupleType(..) | FnType(_) | BadType(_) => false
  }
}

/// Parses a parameter list; closure parameters (closure) may omit their
/// types and take no defaults.
fn (var p: Parser) parse_params(closure: Bool, allow_self: Bool) -> List[Param] {
  var out: List[Param] = []
  if !p.at(Kind.LParen) {
    p.error_expected("`(` to start the parameter list")
    return out
  }
  let st = p.list_open(Kind.LParen)
  while p.list_more(Kind.RParen) {
    let before = p.pos
    if !p.unparenthesized_effect(out) {
      out.push(p.parse_param(closure, allow_self && out.is_empty()))
    }
    if !p.list_sep(before, Kind.RParen, "parameter") {
      break
    }
  }
  p.list_close(st, Kind.RParen)
  out
}

fn effect_text(e: Effect) -> Str {
  if let Some(sub) = e.sub {
    return "${txt(e.name.name)}.${txt(sub.name)}"
  }
  txt(e.name.name)
}

/// `f: fn() uses a, b, c: T`: a name followed by `,`, `)`, or `.` after a
/// parameter whose function type has one unparenthesized effect is a
/// second effect (XO0170, a soft error): consumed into that type.
fn (var p: Parser) unparenthesized_effect(var out: List[Param]) -> Bool {
  if out.is_empty() {
    return false
  }
  let n = out.len() - 1
  if let Some(FnType(ft)) = out[n].typ {
    if ft.effects.is_empty() || ft.uses_parens || !p.at(Kind.Ident) {
      return false
    }
    if !(p.peek(1).kind is Comma | RParen | Dot) {
      return false
    }
    let first = ft.effects[0]
    let eff = p.parse_effect()
    let d = p.soft(FN_TYPE_EFFECTS_PARENS, span_to(first.span, eff.span), "several effects in a function type must be parenthesized: `uses (${effect_text(first)}, ${effect_text(eff)})`")
    p.add_fix(d, "parenthesize the effect list", [insert_at(first.span.start, "("), insert_at(eff.span.end, ")")])
    var ft2 = ft
    ft2.effects.push(eff)
    ft2.uses_parens = true
    out[n].typ = Some(Type.FnType(ft2))
    return true
  }
  false
}

fn (var p: Parser) parse_param(closure: Bool, allow_self: Bool) -> Param {
  let start = p.tok.span.start
  if let Some(prm) = p.foreign_self_param(start) {
    return prm
  }
  let is_var = p.got(Kind.Var)
  if !closure && p.at(Kind.Ident) && p.peek(1).kind == Kind.Ident && p.peek(2).kind == Kind.Colon {
    // Swift argument labels: `_ x: Int`, `from x: Int`.
    let lbl = p.tok
    let pn = txt(p.peek(1).text)
    let d = p.foreign(lbl.span, "`${txt(lbl.text)} ${pn}:` is a Swift argument label; Xo has none: callers use the parameter name, `f(${pn}: v)`, or pass the argument by position (core 3.2)")
    p.add_fix(d, "remove the label", [p.delete_token(lbl)])
    p.next()
  }
  let name = p.expect_ident("a parameter name")
  if !closure && !p.bad && !p.at(Kind.Colon) && (p.at(Kind.Star) || p.at(Kind.LBrack) || (p.at(Kind.Ident) && p.tok.span.start.line == name.span.start.line)) {
    // Go parameters: `x int`, `p *Point`, `xs []int`.
    let t = p.tok
    let n = txt(name.name)
    let d = p.foreign(t.span, "`${n} ${txt(t.text)}` is Go syntax; Xo writes the parameter type after a colon, `${n}: ${txt(t.text)}` (core 3.2)")
    p.add_fix(d, "insert `:`", [replace_range(name.span.end, t.span.start, ": ")])
    let typ = p.parse_type()
    return Param{span: p.span_from(start), is_var: is_var, name: name, typ: Some(typ)}
  }
  if !closure && p.at(Kind.Colon) && is_word(p.peek(1), b"inout") && p.peek(2).kind == Kind.Ident {
    // Swift `x: inout Int`.
    let io = p.peek(1)
    let d = p.foreign(io.span, "`inout` is Swift syntax; Xo marks an in out parameter with `var` before its name, `var ${txt(name.name)}: ${txt(p.peek(2).text)}`, and callers pass a `var` binding without `&` (core 3.2)")
    var edits = [p.delete_token(io)]
    if !is_var {
      edits.push(insert_at(name.span.start, "var "))
    }
    p.add_fix(d, "write `var ${txt(name.name)}`", edits)
    p.next() // :
    p.next() // inout
    let typ = p.parse_type()
    return Param{span: p.span_from(start), is_var: true, name: name, typ: Some(typ)}
  }
  if name.name == b"self" && !is_var && !p.at(Kind.Colon) && !closure {
    if !allow_self {
      p.soft(MISPLACED_SELF, name.span, "a bare `self` parameter is only allowed first in an interface method signature")
    }
    return Param{span: p.span_from(start), is_self: true, name: name}
  }
  var prm = Param{span: p.tok.span, is_var: is_var, name: name}
  if p.got(Kind.Colon) {
    prm.typ = Some(p.parse_type())
  } else if !closure {
    p.error_expected("`:` and a type after parameter `${txt(name.name)}`")
  }
  if !closure && p.got(Kind.Assign) {
    prm.default = Some(p.parse_expr())
  }
  prm.span = p.span_from(start)
  prm
}

fn (var p: Parser) parse_err_spec() -> ErrSpec {
  let start = p.tok.span.start
  p.next() // !
  var e = ErrSpec{span: p.tok.span}
  if p.tok.kind is Ident | LParen | Fn {
    e.typ = Some(p.parse_type())
  }
  e.span = p.span_from(start)
  e
}

/// `uses`, `requires`, and `ensures` clauses, each possibly on a new line.
fn (var p: Parser) parse_clauses() -> List[Clause] {
  var out: List[Clause] = []
  while {
    if !(p.peek_past_newlines().kind is Uses | Requires | Ensures) {
      return out
    }
    p.skip_newlines()
    let start = p.tok.span.start
    match p.tok.kind {
      Uses => {
        p.next()
        let (effs, parens) = p.parse_effect_clause()
        out.push(Clause.UsesClause(span: p.span_from(start), effects: effs, parens: parens))
      }
      Requires => {
        p.next()
        let debug = p.parse_debug_flag()
        let cond = p.parse_expr_no_lit()
        var els: Expr? = None
        if p.peek_past_newlines().kind == Kind.Else {
          p.skip_newlines()
          p.next()
          els = Some(p.parse_expr_no_lit())
        }
        out.push(Clause.RequiresClause(span: p.span_from(start), debug: debug, cond: cond, els: els))
      }
      _ => {
        p.next()
        let debug = p.parse_debug_flag()
        let cond = p.parse_expr_no_lit()
        out.push(Clause.EnsuresClause(span: p.span_from(start), debug: debug, cond: cond))
      }
    }
    if p.failed() {
      return out
    }
  }
  out
}

/// `(debug)` right after requires or ensures.
fn (var p: Parser) parse_debug_flag() -> Bool {
  if p.at(Kind.LParen) && is_word(p.peek(1), b"debug") && p.peek(2).kind == Kind.RParen {
    p.next()
    p.next()
    p.next()
    return true
  }
  false
}

/// The effects after `uses` in a declaration or closure: a comma separated
/// list, optionally parenthesized.
fn (var p: Parser) parse_effect_clause() -> (List[Effect], Bool) {
  var out: List[Effect] = []
  if p.at(Kind.LParen) {
    let st = p.list_open(Kind.LParen)
    while p.list_more(Kind.RParen) {
      let before = p.pos
      out.push(p.parse_effect())
      if !p.list_sep(before, Kind.RParen, "effect") {
        break
      }
    }
    p.list_close(st, Kind.RParen)
    return (out, true)
  }
  out.push(p.parse_effect())
  while p.at(Kind.Comma) && p.peek(1).kind == Kind.Ident {
    p.next()
    out.push(p.parse_effect())
  }
  (out, false)
}

fn (var p: Parser) parse_effect() -> Effect {
  let start = p.tok.span.start
  let name = p.expect_ident("an effect name")
  var sub: Ident? = None
  if p.at(Kind.Dot) && p.peek(1).kind == Kind.Ident {
    p.next()
    sub = Some(p.expect_ident("a sub effect name"))
  }
  Effect{span: p.span_from(start), name: name, sub: sub}
}

fn (var p: Parser) parse_struct(doc: Doc?, is_pub: Bool, start: Pos) -> StructDecl {
  p.next() // struct
  let name = p.expect_ident("a struct name")
  var tps: List[TypeParam] = []
  if p.at_type_params() {
    tps = p.parse_type_params()
  }
  p.parse_struct_body(StructDecl{span: p.tok.span, doc: doc, is_pub: is_pub, name: name, type_params: tps}, start)
}

/// The fields, invariant, and derive list of a struct whose name and type
/// parameters are parsed.
fn (var p: Parser) parse_struct_body(s0: StructDecl, start: Pos) -> StructDecl {
  var s = s0
  if let Some(br) = p.braces_open(false) {
    var before = 0
    while p.braces_more(before) {
      let fstart = p.tok.span.start
      let fdoc = p.doc_for(fstart.line)
      let fpub = p.got(Kind.Pub)
      let fname = p.expect_ident("a field name")
      // its wire name, `kind as "type": Str` (decision 0277)
      var wire: Bytes? = None
      var wire_span: Span? = None
      if p.got(Kind.As) {
        if !p.at(Kind.String) && !p.at(Kind.RawString) {
          p.error_expected("a string literal, the field's name on the wire")
        } else {
          let (w, wsp, ok) = p.plain_string()
          if !ok {
            p.fail(UNEXPECTED_TOKEN, wsp, "a wire name is a plain string literal, without interpolation")
          }
          wire = Some(w)
          wire_span = Some(wsp)
        }
      }
      // per-format overrides, `xml "ID,attr"` (decision 0315): a contextual
      // word followed by a string
      var formats: List[FormatWire] = []
      while (p.at_ident(b"json") || p.at_ident(b"xml") || p.at_ident(b"sql")) && (p.peek(1).kind == Kind.String || p.peek(1).kind == Kind.RawString) {
        let fmt = p.tok.text
        p.next()
        let (w, wsp, ok) = p.plain_string()
        if !ok {
          p.fail(UNEXPECTED_TOKEN, wsp, "a wire name is a plain string literal, without interpolation")
        }
        formats.push(FormatWire{format: fmt, wire: w, span: wsp})
      }
      var typ = Type.BadType(p.tok.span)
      if let Some(ft) = p.foreign_field(fname) {
        typ = ft
      } else {
        p.expect(Kind.Colon, "`:` after the field name")
        typ = p.parse_type()
      }
      var f = Field{span: p.tok.span, doc: fdoc, is_pub: fpub, name: fname, typ: typ, wire: wire, wire_span: wire_span, formats: formats}
      if p.got(Kind.Assign) {
        f.default = Some(p.parse_expr())
      }
      f.span = p.span_from(fstart)
      s.fields.push(f)
      p.member_end("struct field", before)
    }
    p.braces_close(br)
  }
  if !p.bad && p.peek_past_newlines().kind == Kind.Invariant {
    p.skip_newlines()
    p.next()
    s.inv = Some(p.parse_expr())
  }
  if !p.bad {
    let (ds, args) = p.parse_derive()
    s.derive = ds
    s.derive_args = args
  }
  s.span = p.span_from(start)
  s
}

/// An optional `derive A, B` after a type body, and the derives'
/// arguments: `derive Json(case: camel)` (decision 0277), each `key:
/// value` with identifiers, which the checker validates.
fn (var p: Parser) parse_derive() -> (List[Ident], List[DeriveArg]) {
  var out: List[Ident] = []
  var args: List[DeriveArg] = []
  if !is_word(p.peek_past_newlines(), b"derive") {
    return (out, args)
  }
  p.skip_newlines()
  p.next()
  while {
    let d = p.expect_ident("a derivable interface name")
    out.push(d)
    if p.got(Kind.LParen) {
      while !p.bad && !p.at(Kind.RParen) {
        let astart = p.tok.span.start
        let key = p.expect_ident("a derive argument name")
        p.expect(Kind.Colon, "`:` after the derive argument's name")
        let value = p.expect_ident("a derive argument value")
        args.push(DeriveArg{span: p.span_from(astart), derive: d, key: key, value: value})
        if !p.got(Kind.Comma) {
          break
        }
      }
      p.expect(Kind.RParen, "`)` after the derive's arguments")
    }
    if !p.got(Kind.Comma) {
      break
    }
  }
  (out, args)
}

fn (var p: Parser) parse_enum(doc: Doc?, is_pub: Bool, start: Pos) -> EnumDecl {
  p.next() // enum
  let name = p.expect_ident("an enum name")
  var tps: List[TypeParam] = []
  if p.at_type_params() {
    tps = p.parse_type_params()
  }
  var e = EnumDecl{span: p.tok.span, doc: doc, is_pub: is_pub, name: name, type_params: tps}
  if let Some(br) = p.braces_open(false) {
    var before = 0
    while p.braces_more(before) {
      let vstart = p.tok.span.start
      let vdoc = p.doc_for(vstart.line)
      let vname = p.expect_ident("a variant name")
      var fields: List[VariantField]? = None
      if p.at(Kind.LParen) {
        var fs: List[VariantField] = []
        let st = p.list_open(Kind.LParen)
        while p.list_more(Kind.RParen) {
          let before = p.pos
          let fstart = p.tok.span.start
          var fname: Ident? = None
          var from = false
          if p.at_ident(b"from") && p.peek(1).kind != Kind.Colon {
            p.next()
            from = true
          } else {
            fname = Some(p.expect_ident("a field name or `from`"))
            p.expect(Kind.Colon, "`:` after the variant field name")
          }
          let typ = p.parse_type()
          fs.push(VariantField{span: p.span_from(fstart), name: fname, from: from, typ: typ})
          if !p.list_sep(before, Kind.RParen, "variant field") {
            break
          }
        }
        p.list_close(st, Kind.RParen)
        fields = Some(fs)
      }
      e.variants.push(Variant{span: p.span_from(vstart), doc: vdoc, name: vname, fields: fields})
      p.member_end("enum variant", before)
    }
    p.braces_close(br)
  }
  if !p.bad {
    let (ds, args) = p.parse_derive()
    e.derive = ds
    if !args.is_empty() {
      p.fail(UNEXPECTED_TOKEN, args[0].span, "derive arguments apply to a struct's fields (decision 0277), not an enum")
    }
  }
  e.span = p.span_from(start)
  e
}

fn (var p: Parser) parse_interface(doc: Doc?, is_pub: Bool, start: Pos) -> InterfaceDecl {
  p.next() // interface
  let name = p.expect_ident("an interface name")
  var tps: List[TypeParam] = []
  if p.at_type_params() {
    tps = p.parse_type_params()
  }
  p.parse_interface_body(InterfaceDecl{span: p.tok.span, doc: doc, is_pub: is_pub, name: name, type_params: tps}, start)
}

/// The method signatures of an interface whose name and type parameters
/// are parsed.
fn (var p: Parser) parse_interface_body(d0: InterfaceDecl, start: Pos) -> InterfaceDecl {
  var d = d0
  if let Some(br) = p.braces_open(false) {
    var before = 0
    while p.braces_more(before) {
      let mstart = p.tok.span.start
      let mdoc = p.doc_for(mstart.line)
      if !p.at(Kind.Fn) {
        p.error_expected("a method signature starting with `fn`")
      } else {
        d.methods.push(p.parse_fn_decl(mdoc, false, mstart, true))
      }
      p.member_end("method signature", before)
    }
    p.braces_close(br)
  }
  d.span = p.span_from(start)
  d
}

fn (var p: Parser) parse_type_decl(doc: Doc?, is_pub: Bool, start: Pos) -> Decl {
  let type_tok = p.tok
  p.next() // type
  let name = p.expect_ident("a type name")
  var tps: List[TypeParam] = []
  if p.at_type_params() {
    tps = p.parse_type_params()
  }
  if !p.bad && (p.at(Kind.Struct) || p.at(Kind.Interface)) && p.peek(1).kind == Kind.LBrace {
    // Go: `type P struct {` and `type I interface {`.
    let kw = p.tok
    let k = kind_text(kw.kind)
    let n = txt(name.name)
    let dg = p.foreign(span_to(type_tok.span, kw.span), "`type ${n} ${k} {` is Go syntax; Xo writes `${k} ${n} {` (core 2.2, 2.4)")
    p.add_fix(dg, "write `${k} ${n}`", [replace_span(type_tok.span, k), replace_range(p.before_blanks(kw.span.start), kw.span.end, "")])
    p.next()
    if kw.kind == Kind.Struct {
      return Decl.StructDecl(p.parse_struct_body(StructDecl{span: p.tok.span, doc: doc, is_pub: is_pub, name: name, type_params: tps}, start))
    }
    return Decl.InterfaceDecl(p.parse_interface_body(InterfaceDecl{span: p.tok.span, doc: doc, is_pub: is_pub, name: name, type_params: tps}, start))
  }
  var d = TypeDecl{span: p.tok.span, doc: doc, is_pub: is_pub, name: name, type_params: tps}
  if p.got(Kind.Assign) {
    d.typ = Some(p.parse_type_top())
  } else if p.got(Kind.Struct) {
    d.newtype = true
    p.expect(Kind.LParen, "`(` after `struct` in a newtype")
    d.typ = Some(p.parse_type())
    p.expect(Kind.RParen, "`)`")
    if !p.bad {
      // decision 0390: the checker takes Ord only and reports arguments
      let (ds, args) = p.parse_derive()
      d.derive = ds
      if let Some(a) = args.first() {
        p.fail(UNEXPECTED_TOKEN, a.span, "a newtype's derive takes no arguments: it derives `Ord` only (decision 0390)")
      }
    }
  } else {
    p.error_expected("`=` or `struct(` in a type declaration")
  }
  d.span = p.span_from(start)
  Decl.TypeDecl(d)
}

fn (var p: Parser) parse_const(doc: Doc?, is_pub: Bool, start: Pos) -> ConstDecl {
  p.next() // const
  let name = p.expect_ident("a constant name")
  var typ: Type? = None
  if p.got(Kind.Colon) {
    typ = Some(p.parse_type())
  }
  p.expect(Kind.Assign, "`=` in a constant declaration")
  let value = p.parse_expr()
  ConstDecl{span: p.span_from(start), doc: doc, is_pub: is_pub, name: name, typ: typ, value: value}
}

fn (var p: Parser) parse_test(doc: Doc?, start: Pos) -> TestDecl {
  p.next() // test
  var t = TestDecl{span: p.tok.span, doc: doc}
  if p.at(Kind.String) || p.at(Kind.RawString) {
    t.name = Some(p.parse_string())
  } else {
    p.error_expected("a test name string")
  }
  if p.got(Kind.For) {
    t.params.push(p.parse_param(false, false))
    while p.got(Kind.Comma) {
      t.params.push(p.parse_param(false, false))
    }
  }
  if p.at_ident(b"seed") {
    p.next()
    if p.at(Kind.Int) {
      t.seed = Some(Expr.IntLit(span: p.tok.span, raw: p.tok.text, value: p.tok.value))
      p.next()
    } else {
      p.error_expected("an integer seed")
    }
  }
  if p.peek_past_newlines().kind == Kind.Uses {
    p.skip_newlines()
    p.next()
    let (effs, _) = p.parse_effect_clause()
    t.effects = effs
  }
  if p.peek_past_newlines().kind == Kind.LBrace {
    p.skip_newlines()
    t.body = Some(p.parse_block())
  } else {
    p.error_expected("`{` to start the test body")
  }
  t.span = p.span_from(start)
  t
}

// ---------------------------------------------------------------------------
// Types

/// A type where no comma may follow (return types and alias targets).
fn (var p: Parser) parse_type_top() -> Type {
  let saved = p.fn_type_top
  p.fn_type_top = true
  let t = p.parse_type()
  p.fn_type_top = saved
  t
}

fn (var p: Parser) parse_type() -> Type {
  let start = p.tok.span.start
  if !(p.tok.kind is Ident | LParen | Fn) || p.tok.text == b"map" {
    if let Some(ft) = p.foreign_type() {
      return ft
    }
  }
  var t: Type = Type.BadType(p.tok.span)
  match p.tok.kind {
    Ident => {
      var path = [p.expect_ident("a type name")]
      while p.at(Kind.Dot) && p.peek(1).kind == Kind.Ident {
        p.next()
        path.push(p.expect_ident("a type name"))
      }
      var args: List[Type] = []
      if p.at(Kind.Lt) && adjacent(p.toks[p.pos - 1], p.tok) {
        args = p.angle_args(path)
      } else if p.at(Kind.LBrack) {
        let saved = p.fn_type_top
        p.fn_type_top = false
        let st = p.list_open(Kind.LBrack)
        while p.list_more(Kind.RBrack) {
          let before = p.pos
          args.push(p.parse_type())
          if !p.list_sep(before, Kind.RBrack, "type argument") {
            break
          }
        }
        p.list_close(st, Kind.RBrack)
        p.fn_type_top = saved
      }
      t = Type.NamedType(span: p.span_from(start), path: path, args: args)
    }
    LParen => {
      var elems: List[Type] = []
      var trailing = false
      let saved = p.fn_type_top
      p.fn_type_top = false
      let st = p.list_open(Kind.LParen)
      while p.list_more(Kind.RParen) {
        let before = p.pos
        elems.push(p.parse_type())
        trailing = p.at(Kind.Comma)
        if !p.list_sep(before, Kind.RParen, "tuple type") {
          break
        }
      }
      p.list_close(st, Kind.RParen)
      p.fn_type_top = saved
      if elems.len() == 1 && !trailing {
        t = elems[0]
      } else {
        t = Type.TupleType(span: p.span_from(start), elems: elems)
      }
    }
    Fn => t = p.parse_fn_type()
    _ => {
      p.error_expected("a type")
      return t
    }
  }
  // `T?` and `T??` (core 3.5: Type = BaseType { "?" }): the lexer reads
  // `??` as one coalesce token, which in a type is two `?`
  while p.at(Kind.Question) || p.at(Kind.Coalesce) {
    let two = p.at(Kind.Coalesce)
    p.next()
    t = Type.OptionalType(span: p.span_from(start), elem: t)
    if two {
      t = Type.OptionalType(span: p.span_from(start), elem: t)
    }
  }
  t
}

fn (var p: Parser) parse_fn_type() -> Type {
  let start = p.tok.span.start
  let top = p.fn_type_top
  p.fn_type_top = false
  p.next() // fn
  if !p.at(Kind.LParen) {
    p.error_expected("`(` in a function type")
    p.fn_type_top = top
    return Type.BadType(p.span_from(start))
  }
  var ft = FnType{span: p.tok.span}
  let st = p.list_open(Kind.LParen)
  while p.list_more(Kind.RParen) {
    let before = p.pos
    let pstart = p.tok.span.start
    let is_var = p.got(Kind.Var)
    let typ = p.parse_type()
    ft.params.push(FnTypeParam{span: p.span_from(pstart), is_var: is_var, typ: typ})
    if !p.list_sep(before, Kind.RParen, "parameter type") {
      break
    }
  }
  p.list_close(st, Kind.RParen)
  if p.got(Kind.Arrow) {
    ft.result = Some(p.parse_type())
  }
  if p.at(Kind.Bang) {
    ft.err = Some(p.parse_err_spec())
  }
  if p.got(Kind.Uses) {
    if p.at(Kind.LParen) {
      ft.uses_parens = true
      let est = p.list_open(Kind.LParen)
      while p.list_more(Kind.RParen) {
        let before = p.pos
        ft.effects.push(p.parse_effect())
        if !p.list_sep(before, Kind.RParen, "effect") {
          break
        }
      }
      p.list_close(est, Kind.RParen)
    } else {
      ft.effects.push(p.parse_effect())
      if top && p.at(Kind.Comma) && p.peek(1).kind == Kind.Ident {
        let first = ft.effects[0]
        let end = p.peek(1)
        let d = p.fail(FN_TYPE_EFFECTS_PARENS, span_to(first.span, end.span), "several effects in a function type must be parenthesized: `uses (${effect_text(first)}, ${txt(end.text)})`")
        if d >= 0 {
          p.diags[d].fixes.push(Fix{title: b"parenthesize the effect list", edits: [insert_at(first.span.start, "("), insert_at(end.span.end, ")")]})
        }
      }
    }
  }
  p.fn_type_top = top
  ft.span = p.span_from(start)
  Type.FnType(ft)
}
