// A source file's interface for cache keys (decision 0271, 0283): its
// tokens outside the bodies of its functions, without comments or
// layout, so that an edit of a comment, of blank lines or of a body
// keeps the interface of its file.

use github.com/xo-lang/xo/compiler/lexer

/// The interface text of src (file name): each token's text and a
/// separator, a function body as `{}`, comments and newlines left out.
/// Parsed as signatures may be (bodies optional: the prelude and the
/// runtime declare functions without one); a file with a hard parse
/// error keeps its bodies (its tokens all count, its comments still not).
pub fn iface_text(name: Bytes, src: Bytes) -> Bytes {
  let r = parse_file(name, src, true)
  iface_bytes(lexer.lex(src).tokens, if r.hard { [] } else { r.file.decls })
}

/// iface_text from the tokens alone, without a parse (the std tree's
/// hash, compiler/xo std_tree_sum: a parse of every std file took 0.8 to
/// 1.9 s of a cold build, 2026-10-21). A body is cut only where the token
/// stream leaves no doubt: `fn` or `test` first on a line (or after a
/// line's `pub`) outside every bracket, then a `{` before any newline
/// outside the parentheses and brackets of its signature, matched to its
/// `}`. Anything else keeps its tokens, so where the parse would cut and
/// this does not, a body edit changes the text (a needless miss), never
/// the reverse. The same as iface_text on every std file
/// (TestIfaceLexMatchesParse).
pub fn iface_text_lex(src: Bytes) -> Bytes {
  let toks = lexer.lex(src).tokens
  var cuts: List[(Int, Int)] = []
  var depth = 0
  var i = 0
  while i < toks.len() {
    let k = toks[i].kind
    if depth == 0 && (k == lexer.Kind.Fn || k == lexer.Kind.Test) && decl_start(toks, i) {
      // the signature: to the `{` outside its parentheses and brackets
      var j = i + 1
      var inner = 0
      var body = -1
      while j < toks.len() {
        let kj = toks[j].kind
        if kj == lexer.Kind.LParen || kj == lexer.Kind.LBrack {
          inner += 1
        } else if kj == lexer.Kind.RParen || kj == lexer.Kind.RBrack {
          inner -= 1
        } else if inner == 0 && (kj == lexer.Kind.Newline || kj == lexer.Kind.Eof || kj == lexer.Kind.RBrace) {
          break
        } else if inner == 0 && kj == lexer.Kind.LBrace {
          body = j
          break
        }
        j += 1
      }
      if body >= 0 {
        // the body: to its matching `}`
        var d = 0
        var e = body
        while e < toks.len() {
          let ke = toks[e].kind
          if ke == lexer.Kind.LBrace || ke == lexer.Kind.HashLBrace {
            d += 1
          } else if ke == lexer.Kind.RBrace {
            d -= 1
            if d == 0 {
              break
            }
          }
          e += 1
        }
        if e < toks.len() {
          cuts.push((toks[body].span.start.offset, toks[e].span.end.offset))
          i = e + 1
          continue
        }
      }
    }
    if k == lexer.Kind.LBrace || k == lexer.Kind.HashLBrace || k == lexer.Kind.LParen || k == lexer.Kind.LBrack {
      depth += 1
    } else if k == lexer.Kind.RBrace || k == lexer.Kind.RParen || k == lexer.Kind.RBrack {
      depth -= 1
    }
    i += 1
  }
  cut_tokens(toks, cuts)
}

/// Whether toks[i] begins a declaration: first on its line, or after a
/// `pub` that is.
fn decl_start(toks: List[lexer.Token], i: Int) -> Bool {
  var j = i - 1
  if j >= 0 && toks[j].kind == lexer.Kind.Pub {
    j -= 1
  }
  j < 0 || toks[j].kind == lexer.Kind.Newline
}

/// The interface text of a file from its tokens and declarations (its
/// functions' bodies cut; [] for a file that did not parse: every token).
fn iface_bytes(toks: List[lexer.Token], decls: List[Decl]) -> Bytes {
  var cuts: List[(Int, Int)] = []
  for d in decls {
    if let FnDecl(d: fd) = d {
      if let Some(bd) = fd.body {
        cuts.push((bd.span.start.offset, bd.span.end.offset))
      } else if let Some(lb) = fd.lazy {
        // a body the lazy parse skipped: the same bytes as its block's
        cuts.push((lb.start.offset, lb.end))
      }
    }
    // a test's body too: nothing outside it reads it (2026-10-21: an
    // edit to one std test body missed every std body's front end entry)
    if let TestDecl(d: td) = d {
      if let Some(bd) = td.body {
        cuts.push((bd.span.start.offset, bd.span.end.offset))
      }
    }
  }
  cut_tokens(toks, cuts)
}

/// Each token's text and a separator, the tokens inside a cut written as
/// `{}` once, newlines and the end left out.
fn cut_tokens(toks: List[lexer.Token], cuts: List[(Int, Int)]) -> Bytes {
  let sorted = cuts.sort_by(fn(c) { c.0 })
  var ci = 0
  var out = BytesBuilder.new()
  for t in toks {
    if t.kind == lexer.Kind.Newline || t.kind == lexer.Kind.Eof {
      continue
    }
    let at = t.span.start.offset
    while ci < sorted.len() && at >= sorted[ci].1 {
      ci += 1
    }
    if ci < sorted.len() && at >= sorted[ci].0 {
      if at == sorted[ci].0 {
        out.write_str("{} ")
      }
      continue
    }
    out.write(t.text)
    out.write_byte(UInt8(1))
  }
  out.freeze()
}
