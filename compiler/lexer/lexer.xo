// The Xo lexer, written in Xo: a faithful port of internal/lexer (core 1).
//
// Newlines become Newline tokens when the last token on the line can end a
// statement (core 1.3), except when the next non blank, non comment line
// starts with a single `.`, which continues the previous line. A string
// literal with `${expr}` interpolation is one String token holding the
// literal parts and the raw source of each expression; lex_range lexes
// those expressions. Diagnostics carry the same codes and messages as the
// Go lexer, and the dump (dump.xo) prints the same text as `xo lexdump`.
//
// Source text is Bytes, and a byte is a UInt8: a rune literal where a byte
// is expected is its code point (`c == '"'`, core 1.6).

/// Marks an interpolation in the flattened text of a triple quoted string.
const MARKER: UInt8 = 0x01

const MAX_INT = 9223372036854775807
const MAX_U64: UInt64 = 18446744073709551615

/// The output of lex and lex_range. Tokens always end with Eof.
pub struct LexResult {
  pub tokens: List[Token]
  pub comments: List[Comment]
  pub diags: List[Diag]
}

struct Lexer {
  src: Bytes
  off: Int
  end: Int
  line: Int
  col: Int
  /// Set when lexing an interpolated expression: no Newline tokens.
  range_mode: Bool
  toks: List[Token] = []
  comments: List[Comment] = []
  diags: List[Diag] = []
  /// The last significant token, for newline insertion.
  last: Kind = Kind.Newline
}

/// A raw part of a string literal before escapes are decoded.
struct Piece {
  expr: Bool
  raw: Bytes
  /// Position of raw in the source.
  start: Pos
}

/// Tokenizes a whole file.
pub fn lex(src: Bytes) -> LexResult {
  var l = Lexer{src: src, off: 0, end: src.len(), line: 1, col: 1, range_mode: false}
  l.run()
  LexResult{tokens: l.toks, comments: l.comments, diags: l.diags}
}

/// Tokenizes src[start.offset..end] as part of a file, Newline tokens
/// included, with positions continuing from start: a function body the
/// lazy parse skipped (parser parse_body, decision 0351 stage 2).
pub fn lex_from(src: Bytes, start: Pos, end: Int) -> LexResult {
  var l = Lexer{src: src, off: start.offset, end: end, line: start.line, col: start.col, range_mode: false}
  l.run()
  LexResult{tokens: l.toks, comments: l.comments, diags: l.diags}
}

/// Tokenizes src[start.offset..end] with positions continuing from start.
/// Used for interpolated expressions; never emits Newline tokens.
pub fn lex_range(src: Bytes, start: Pos, end: Int) -> LexResult {
  var l = Lexer{src: src, off: start.offset, end: end, line: start.line, col: start.col, range_mode: true}
  l.run()
  LexResult{tokens: l.toks, comments: l.comments, diags: l.diags}
}

fn is_letter(c: UInt8) -> Bool {
  c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn is_digit(c: UInt8) -> Bool {
  c >= '0' && c <= '9'
}

fn is_hex(c: UInt8) -> Bool {
  is_digit(c) || ((c | 0x20) >= 'a' && (c | 0x20) <= 'f')
}

/// The value of the hex digit c.
fn hex_value(c: UInt8) -> Int {
  if is_digit(c) { Int(c - '0') } else { Int((c | 0x20) - 'a') + 10 }
}

/// Whether a newline after k terminates a statement (core 1.3). `???`
/// counts as a literal.
fn ends_statement(k: Kind) -> Bool {
  k is Ident | Int | Float | Duration | Rune | String | RawString | Bytes | ImportPath | Hole | RParen | RBrack | RBrace | Question | Return | Break | Continue
}

fn (l: Lexer) pos() -> Pos {
  Pos{offset: l.off, line: l.line, col: l.col}
}

fn (l: Lexer) span(start: Pos) -> Span {
  Span{start: start, end: l.pos()}
}

/// The byte n past the current one, or 0 past the end.
fn (l: Lexer) peek(n: Int) -> UInt8 {
  if l.off + n < l.end { l.src[l.off + n] } else { 0 }
}

/// The current byte; the caller checks l.off < l.end.
fn (l: Lexer) cur() -> UInt8 {
  l.src[l.off]
}

/// Moves past one byte, tracking lines and columns.
fn (var l: Lexer) advance() {
  if l.off >= l.end {
    return
  }
  if l.src[l.off] == '\n' {
    l.line += 1
    l.col = 1
  } else {
    l.col += 1
  }
  l.off += 1
}

fn (var l: Lexer) advance_n(n: Int) {
  for _ in 0..n {
    l.advance()
  }
}

fn (var l: Lexer) error(code: Str, sp: Span, message: Bytes) {
  l.diags.push(Diag{code: code, span: sp, message: message})
}

/// Appends a token of kind from start to the current position.
fn (var l: Lexer) emit(kind: Kind, start: Pos, value: Bytes) {
  l.toks.push(Token{kind: kind, span: l.span(start), text: l.src[start.offset..l.off], value: value})
  l.last = kind
}

fn (var l: Lexer) run() {
  while {
    l.skip_space_and_comments()
    if l.off >= l.end {
      if !l.range_mode && ends_statement(l.last) {
        let p = l.pos()
        l.toks.push(Token{kind: Kind.Newline, span: Span{start: p, end: p}, text: b""})
      }
      let p = l.pos()
      l.toks.push(Token{kind: Kind.Eof, span: Span{start: p, end: p}, text: b""})
      return
    }
    l.next()
  }
}

/// Skips blanks and comments and handles newlines.
fn (var l: Lexer) skip_space_and_comments() {
  while l.off < l.end {
    let c = l.cur()
    if c == ' ' || c == '\t' || c == '\r' {
      l.advance()
    } else if c == '\n' {
      let start = l.pos()
      l.advance()
      if !l.range_mode && ends_statement(l.last) && !l.continues_line() {
        l.toks.push(Token{kind: Kind.Newline, span: l.span(start), text: b"\n"})
        l.last = Kind.Newline
      }
    } else if c == '/' && l.peek(1) == '/' {
      l.comment()
    } else {
      return
    }
  }
}

/// Whether the next line holding a token starts with a single `.` (core
/// 1.3). Blank lines and comment lines are skipped.
fn (l: Lexer) continues_line() -> Bool {
  var i = l.off
  while i < l.end {
    let c = l.src[i]
    if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
      i += 1
    } else if c == '/' && i + 1 < l.end && l.src[i + 1] == '/' {
      while i < l.end && l.src[i] != '\n' {
        i += 1
      }
    } else if c == '.' {
      return !(i + 1 < l.end && l.src[i + 1] == '.')
    } else {
      return false
    }
  }
  false
}

/// Whether b starts with n slashes.
fn slashes(b: Bytes, n: Int) -> Bool {
  if b.len() < n {
    return false
  }
  for i in 0..n {
    if b[i] != '/' {
      return false
    }
  }
  true
}

fn (var l: Lexer) comment() {
  let start = l.pos()
  while l.off < l.end && l.cur() != '\n' {
    l.advance()
  }
  let all = l.src[start.offset..l.off]
  let doc = slashes(all, 3) && !slashes(all, 4)
  var text = if doc { all[3..] } else { all[2..] }
  if text.len() > 0 && text[0] == ' ' {
    text = text[1..]
  }
  if text.len() > 0 && text[text.len() - 1] == '\r' {
    text = text[..text.len() - 1]
  }
  l.comments.push(Comment{span: l.span(start), text: text, doc: doc})
}

fn (var l: Lexer) next() {
  let start = l.pos()
  let c = l.cur()

  // Import path directly after `use`.
  if l.last == Kind.Use && !l.range_mode {
    l.import_path(start)
    return
  }

  if c == 'r' && (l.peek(1) == '"' || (l.peek(1) == '#' && l.raw_hashes(1) > 0)) {
    l.raw_string(start)
    return
  }
  if c == 'b' && l.peek(1) == '"' {
    l.bytes_lit(start)
    return
  }
  if is_letter(c) {
    while l.off < l.end && (is_letter(l.cur()) || is_digit(l.cur())) {
      l.advance()
    }
    let word = l.src[start.offset..l.off].to_str().or_fault("identifiers are ASCII")
    l.emit(lookup(word), start, b"")
    return
  }
  if is_digit(c) {
    l.number(start)
    return
  }
  if c == '"' {
    l.string_lit(start)
    return
  }
  if c == '\'' {
    l.rune_lit(start)
    return
  }

  let (k, n) = l.operator()
  if n > 0 {
    l.advance_n(n)
    if k == Kind.Newline {
      // ';'
      l.toks.push(Token{kind: Kind.Newline, span: l.span(start), text: b";"})
      l.last = Kind.Newline
      return
    }
    l.emit(k, start, b"")
    return
  }

  // Invalid character: skip the whole UTF-8 sequence.
  let (r, size) = l.src[l.off..l.end].decode_rune(0)
  l.advance_n(size)
  l.error(INVALID_CHAR, l.span(start), "invalid character ${r.quote()}".bytes())
  l.emit(Kind.Illegal, start, b"")
}

/// Counts `#` bytes at offset i from the current position and returns the
/// count if they are followed by `"`, else 0.
fn (l: Lexer) raw_hashes(i: Int) -> Int {
  var n = 0
  while l.peek(i + n) == '#' {
    n += 1
  }
  if l.peek(i + n) == '"' { n } else { 0 }
}

/// The operator at the current position and its length, or (Illegal, 0).
fn (l: Lexer) operator() -> (Kind, Int) {
  let c1 = l.peek(1)
  let c2 = l.peek(2)
  match l.peek(0) {
    '+' => if c1 == '=' { (Kind.PlusAssign, 2) } else { (Kind.Plus, 1) }
    '-' => {
      if c1 == '=' {
        (Kind.MinusAssign, 2)
      } else if c1 == '>' {
        (Kind.Arrow, 2)
      } else {
        (Kind.Minus, 1)
      }
    }
    '*' => if c1 == '=' { (Kind.StarAssign, 2) } else { (Kind.Star, 1) }
    '/' => if c1 == '=' { (Kind.SlashAssign, 2) } else { (Kind.Slash, 1) }
    '%' => if c1 == '=' { (Kind.PercentAssign, 2) } else { (Kind.Percent, 1) }
    '<' => {
      if c1 == '<' {
        if c2 == '=' { (Kind.ShlAssign, 3) } else { (Kind.Shl, 2) }
      } else if c1 == '=' {
        (Kind.LtEq, 2)
      } else {
        (Kind.Lt, 1)
      }
    }
    '>' => {
      if c1 == '>' {
        if c2 == '=' { (Kind.ShrAssign, 3) } else { (Kind.Shr, 2) }
      } else if c1 == '=' {
        (Kind.GtEq, 2)
      } else {
        (Kind.Gt, 1)
      }
    }
    '&' => {
      if c1 == '&' {
        (Kind.AndAnd, 2)
      } else if c1 == '=' {
        (Kind.AmpAssign, 2)
      } else {
        (Kind.Amp, 1)
      }
    }
    '|' => {
      if c1 == '|' {
        (Kind.OrOr, 2)
      } else if c1 == '=' {
        (Kind.PipeAssign, 2)
      } else {
        (Kind.Pipe, 1)
      }
    }
    '^' => if c1 == '=' { (Kind.CaretAssign, 2) } else { (Kind.Caret, 1) }
    '~' => (Kind.Tilde, 1)
    '!' => if c1 == '=' { (Kind.NotEq, 2) } else { (Kind.Bang, 1) }
    '?' => {
      if c1 == '?' {
        if c2 == '?' { (Kind.Hole, 3) } else { (Kind.Coalesce, 2) }
      } else {
        (Kind.Question, 1)
      }
    }
    '=' => {
      if c1 == '=' {
        (Kind.Eq, 2)
      } else if c1 == '>' {
        (Kind.FatArrow, 2)
      } else {
        (Kind.Assign, 1)
      }
    }
    '.' => {
      if c1 == '.' {
        if c2 == '=' { (Kind.DotDotEq, 3) } else { (Kind.DotDot, 2) }
      } else {
        (Kind.Dot, 1)
      }
    }
    ',' => (Kind.Comma, 1)
    ':' => (Kind.Colon, 1)
    ';' => (Kind.Newline, 1)
    '(' => (Kind.LParen, 1)
    ')' => (Kind.RParen, 1)
    '[' => (Kind.LBrack, 1)
    ']' => (Kind.RBrack, 1)
    '{' => (Kind.LBrace, 1)
    '}' => (Kind.RBrace, 1)
    '#' => if c1 == '{' { (Kind.HashLBrace, 2) } else { (Kind.Illegal, 0) }
    _ => (Kind.Illegal, 0)
  }
}

fn is_path_char(c: UInt8) -> Bool {
  is_letter(c) || is_digit(c) || c == '-' || c == '.' || c == '/'
}

/// Whether b holds `//`.
/// Whether an import path has a `.` or `..` segment (core 4.1).
fn has_dot_segment(b: Bytes) -> Bool {
  var start = 0
  for i in 0..=b.len() {
    if i == b.len() || b[i] == '/' {
      let n = i - start
      if (n == 1 && b[start] == '.') || (n == 2 && b[start] == '.' && b[start + 1] == '.') {
        return true
      }
      start = i + 1
    }
  }
  false
}

fn has_double_slash(b: Bytes) -> Bool {
  for i in 1..b.len() {
    if b[i] == '/' && b[i - 1] == '/' {
      return true
    }
  }
  false
}

/// Lexes the path after `use`: segments of letters, digits, `_`, `-`, and
/// `.` separated by `/`.
fn (var l: Lexer) import_path(start: Pos) {
  while l.off < l.end && is_path_char(l.cur()) {
    l.advance()
  }
  if l.off == start.offset {
    // Not a path at all; lex the token normally so the parser reports it.
    l.last = Kind.Illegal
    l.next()
    return
  }
  let text = l.src[start.offset..l.off]
  l.emit(Kind.ImportPath, start, text)
  if text[0] == '/' || text[text.len() - 1] == '/' || has_double_slash(text) {
    l.error(MALFORMED_IMPORT_PATH, l.span(start), "malformed import path ${text.quote()}".bytes())
  } else if has_dot_segment(text) {
    l.error(MALFORMED_IMPORT_PATH, l.span(start), "malformed import path ${text.quote()}: `.` and `..` segments are not allowed; import paths are absolute (core 4.1)".bytes())
  }
}

/// The nanoseconds in one duration unit, or None for an unknown suffix.
fn duration_unit(suffix: Bytes) -> Int? {
  match suffix.to_str() ?? "" {
    "ns" => Some(1)
    "us" => Some(1_000)
    "ms" => Some(1_000_000)
    "s" => Some(1_000_000_000)
    "m" => Some(60 * 1_000_000_000)
    "h" => Some(3600 * 1_000_000_000)
    _ => None
  }
}

fn (var l: Lexer) digits() {
  while l.off < l.end && (is_digit(l.cur()) || l.cur() == '_') {
    l.advance()
  }
}

/// b without the bytes c, or b itself when it holds none.
fn without_byte(b: Bytes, c: UInt8) -> Bytes {
  // most numbers have none: no builder for them (2026-10-26: 31 MB of
  // the edit rebuild's 800 MB allocated)
  var has = false
  for i in 0..b.len() {
    if b[i] == c {
      has = true
      break
    }
  }
  if !has {
    return b
  }
  var out = BytesBuilder.with_capacity(b.len())
  var run = 0
  for i in 0..b.len() {
    if b[i] == c {
      out.write(b[run..i])
      run = i + 1
    }
  }
  if run == 0 {
    return b
  }
  out.write(b[run..])
  out.freeze()
}

/// Whether every `_` in s sits between two digits of the base.
fn valid_underscores(s: Bytes, base: Int) -> Bool {
  for i in 0..s.len() {
    if s[i] != '_' {
      continue
    }
    if i == 0 || i == s.len() - 1 {
      return false
    }
    let prev = s[i - 1]
    let next = s[i + 1]
    let ok = if base == 16 { is_hex(prev) && is_hex(next) } else { is_digit(prev) && is_digit(next) }
    if !ok {
      return false
    }
  }
  true
}

/// The result of strconv.ParseUint.
enum Parsed {
  Value(n: UInt64)
  Syntax
  OutOfRange
}

/// strconv.ParseUint(s, base, 64) for a non empty s: the first problem in
/// reading order decides between a syntax and a range error, as in Go.
fn parse_uint(s: Bytes, base: Int) -> Parsed {
  let b = UInt64(base)
  let cutoff = MAX_U64 / b + 1
  var n: UInt64 = 0
  for i in 0..s.len() {
    let c = s[i]
    let d = if is_digit(c) {
      Int(c - '0')
    } else if (c | 0x20) >= 'a' && (c | 0x20) <= 'z' {
      Int((c | 0x20) - 'a') + 10
    } else {
      return Parsed.Syntax
    }
    if d >= base {
      return Parsed.Syntax
    }
    if n >= cutoff {
      return Parsed.OutOfRange
    }
    n = n * b
    let du = UInt64(d)
    if n > MAX_U64 - du {
      return Parsed.OutOfRange
    }
    n = n + du
  }
  Parsed.Value(n)
}

/// Validates digits for base and returns the value, or reports why not.
fn (var l: Lexer) parse_int(body: Bytes, base: Int, sp: Span) -> UInt64? {
  if body.is_empty() {
    l.error(MALFORMED_NUMBER, sp, b"number literal has no digits")
    return None
  }
  // 0x_ff is allowed, as in Go.
  let digits = if base != 10 && body[0] == '_' { body[1..] } else { body }
  if !valid_underscores(digits, base) {
    l.error(MALFORMED_NUMBER, sp, b"misplaced `_` in number literal")
    return None
  }
  let clean = without_byte(digits, '_')
  if clean.is_empty() {
    l.error(MALFORMED_NUMBER, sp, b"number literal has no digits")
    return None
  }
  match parse_uint(clean, base) {
    Value(n) => Some(n)
    OutOfRange => {
      l.error(MALFORMED_NUMBER, sp, b"integer literal out of range")
      None
    }
    Syntax => {
      l.error(MALFORMED_NUMBER, sp, "invalid digit in base ${base} literal".bytes())
      None
    }
  }
}

fn (var l: Lexer) number(start: Pos) {
  var kind = Kind.Int
  var base = 10
  let p1 = l.peek(1) | 0x20
  if l.cur() == '0' && (p1 == 'x' || p1 == 'o' || p1 == 'b') {
    base = if p1 == 'x' { 16 } else if p1 == 'o' { 8 } else { 2 }
    l.advance_n(2)
    while l.off < l.end && (is_hex(l.cur()) || l.cur() == '_') {
      l.advance()
    }
  } else if l.last == Kind.Dot {
    // A tuple field index (`t.0`, core 3.5): plain digits only, so `t.0.1`
    // is two field accesses rather than `t.` and `0.1`.
    l.digits()
  } else {
    l.digits()
    if l.peek(0) == '.' && is_digit(l.peek(1)) {
      kind = Kind.Float
      l.advance()
      l.digits()
    }
    let sign = l.peek(1) == '+' || l.peek(1) == '-'
    if (l.peek(0) | 0x20) == 'e' && (is_digit(l.peek(1)) || (sign && is_digit(l.peek(2)))) {
      kind = Kind.Float
      l.advance_n(2)
      l.digits()
    }
  }
  let num_end = l.off
  // Suffix: a duration unit or an error.
  while l.off < l.end && (is_letter(l.cur()) || is_digit(l.cur())) {
    l.advance()
  }
  let suffix = l.src[num_end..l.off]
  let digits = l.src[start.offset..num_end]
  let sp = l.span(start)

  if !suffix.is_empty() {
    let text = l.src[start.offset..l.off]
    var value = b""
    if let Some(unit) = duration_unit(suffix) {
      if kind != Kind.Int || base != 10 {
        l.error(INVALID_DURATION, sp, "duration literal ${text.quote()} must be a decimal integer followed by a unit".bytes())
      } else if let Some(v) = l.parse_int(digits, 10, sp) {
        if v > UInt64(MAX_INT) || Int(v) > MAX_INT / unit {
          l.error(MALFORMED_NUMBER, sp, "duration literal ${text.quote()} overflows a 64 bit nanosecond count".bytes())
        } else {
          value = "${Int(v) * unit}".bytes()
        }
      }
    } else {
      l.error(INVALID_DURATION, sp, "invalid suffix ${suffix.quote()} on number literal; duration units are ns, us, ms, s, m, h".bytes())
    }
    l.emit(Kind.Duration, start, value)
    return
  }

  if kind == Kind.Float {
    if valid_underscores(digits, 10) {
      l.emit(kind, start, without_byte(digits, '_'))
    } else {
      l.error(MALFORMED_NUMBER, sp, "misplaced `_` in number literal ${digits.quote()}".bytes())
      l.emit(kind, start, b"")
    }
    return
  }
  let body = if base != 10 { digits[2..] } else { digits }
  let value = match l.parse_int(body, base, sp) {
    Some(v) => "${v}".bytes()
    None => b""
  }
  l.emit(kind, start, value)
}

/// Whether `"` followed by `hashes` `#` bytes starts at the current position.
fn (l: Lexer) at_closing(hashes: Int) -> Bool {
  if l.off + hashes >= l.end || l.cur() != '"' {
    return false
  }
  for k in 1..=hashes {
    if l.src[l.off + k] != '#' {
      return false
    }
  }
  true
}

/// b with every CR LF replaced by LF.
fn replace_crlf(b: Bytes) -> Bytes {
  var out = BytesBuilder.with_capacity(b.len())
  var run = 0
  var i = 0
  while i + 1 < b.len() {
    if b[i] == '\r' && b[i + 1] == '\n' {
      out.write(b[run..i])
      run = i + 1
    }
    i += 1
  }
  if run == 0 {
    return b
  }
  out.write(b[run..])
  out.freeze()
}

fn (var l: Lexer) raw_string(start: Pos) {
  l.advance() // r
  var hashes = 0
  while l.peek(0) == '#' {
    hashes += 1
    l.advance()
  }
  l.advance() // "
  if l.peek(0) == '"' && l.peek(1) == '"' {
    // r"""...""": a multi-line raw string (decision 0320)
    l.advance_n(2)
    l.raw_triple(start, hashes)
    return
  }
  let body_start = l.off
  while l.off < l.end {
    if l.at_closing(hashes) {
      let body = l.src[body_start..l.off]
      l.advance_n(hashes + 1)
      l.emit(Kind.RawString, start, replace_crlf(body))
      return
    }
    l.advance()
  }
  let closing = "\"" + "#".repeat(hashes)
  l.emit(Kind.RawString, start, l.src[body_start..l.off])
  l.error(UNTERMINATED_STRING, l.span(start), "raw string literal not terminated; expected ${closing}".bytes())
}

/// The rest of a raw multi-line string `r"""..."""` (or with `#`s, closed
/// by `"""` and as many `#`s), decision 0320: no escapes, no
/// interpolation, and the common leading indentation removed as for
/// `"""` (strip_indent: a first line holding only the opening quotes and a
/// last holding only the closing ones are dropped).
fn (var l: Lexer) raw_triple(start: Pos, hashes: Int) {
  let body_start = l.off
  let body_pos = l.pos()
  while l.off < l.end {
    if l.cur() == '"' && l.peek(1) == '"' && l.peek(2) == '"' && l.closing_hashes(3, hashes) {
      let body = replace_crlf(l.src[body_start..l.off])
      l.advance_n(3 + hashes)
      var text = b""
      for p in strip_indent([Piece{expr: false, raw: body, start: body_pos}]) {
        text = text + p.raw
      }
      l.toks.push(Token{kind: Kind.RawString, span: l.span(start), text: l.src[start.offset..l.off], value: text, triple: true})
      l.last = Kind.RawString
      return
    }
    l.advance()
  }
  let closing = "\"\"\"" + "#".repeat(hashes)
  l.emit(Kind.RawString, start, l.src[body_start..l.off])
  l.error(UNTERMINATED_STRING, l.span(start), "raw string literal not terminated; expected ${closing}".bytes())
}

/// Whether the hashes `#` bytes follow at offset i from the current
/// position.
fn (l: Lexer) closing_hashes(i: Int, hashes: Int) -> Bool {
  for k in 0..hashes {
    if l.peek(i + k) != '#' {
      return false
    }
  }
  true
}

/// Scans the body of a bytes or rune literal up to the closing `quote`, a
/// newline, or the end. Reports whether it was terminated.
fn (var l: Lexer) quoted_body(quote: UInt8) -> Bool {
  while l.off < l.end {
    let c = l.cur()
    if c == quote {
      return true
    }
    if c == '\n' {
      return false
    }
    if c == '\\' && l.off + 1 < l.end {
      l.advance_n(2)
    } else {
      l.advance()
    }
  }
  false
}

fn (var l: Lexer) bytes_lit(start: Pos) {
  l.advance() // b
  l.advance() // "
  let raw_start = l.pos()
  let terminated = l.quoted_body('"')
  let raw = l.src[raw_start.offset..l.off]
  if terminated {
    l.advance()
  }
  let sp = l.span(start)
  if !terminated {
    l.error(UNTERMINATED_STRING, sp, b"bytes literal not terminated")
  }
  let value = l.cook(raw, raw_start, true)
  l.emit(Kind.Bytes, start, value)
}

fn (var l: Lexer) rune_lit(start: Pos) {
  l.advance() // '
  let raw_start = l.pos()
  let terminated = l.quoted_body('\'')
  let raw = l.src[raw_start.offset..l.off]
  if terminated {
    l.advance()
  }
  let sp = l.span(start)
  if !terminated {
    l.error(INVALID_RUNE, sp, b"rune literal not terminated")
    l.emit(Kind.Rune, start, b"")
    return
  }
  let v = l.cook(raw, raw_start, false)
  if v.rune_count() != 1 {
    l.error(INVALID_RUNE, sp, b"rune literal must hold exactly one character")
    l.emit(Kind.Rune, start, b"")
    return
  }
  l.emit(Kind.Rune, start, v)
}

/// The value of hex digits as strconv.ParseUint(hex, 16, 32) reads them,
/// or None when one is not a hex digit or the value needs more than 32 bits.
fn parse_hex32(hex: Bytes) -> Int? {
  var v = 0
  for i in 0..hex.len() {
    if !is_hex(hex[i]) {
      return None
    }
    v = v * 16 + hex_value(hex[i])
    if v > 0xffffffff {
      return None
    }
  }
  Some(v)
}

/// The index of the first `}` in b at or after from, relative to from.
fn index_rbrace(b: Bytes, from: Int) -> Int {
  for i in from..b.len() {
    if b[i] == '}' {
      return i - from
    }
  }
  -1
}

/// Decodes escape sequences in raw (which starts at pos). With bytes set,
/// \xHH may be any byte; in text it must be ASCII.
fn (var l: Lexer) cook(raw: Bytes, pos: Pos, bytes: Bool) -> Bytes {
  var has_escape = false
  for i in 0..raw.len() {
    if raw[i] == '\\' {
      has_escape = true
      break
    }
  }
  if !has_escape {
    return raw
  }
  var out = BytesBuilder.with_capacity(raw.len())
  var run = 0
  var col = pos.col
  var line = pos.line
  var off = pos.offset
  var i = 0
  while i < raw.len() {
    let c = raw[i]
    if c != '\\' {
      if c == '\n' {
        line += 1
        col = 1
      } else {
        col += 1
      }
      off += 1
      i += 1
      continue
    }
    out.write(raw[run..i])
    let here = Pos{offset: off, line: line, col: col}
    if i + 1 >= raw.len() {
      l.error(INVALID_ESCAPE, escape_span(here, 1), b"incomplete escape sequence")
      run = raw.len()
      break
    }
    var n = 2
    let e = raw[i + 1]
    match e {
      'n' => out.write_byte('\n')
      't' => out.write_byte('\t')
      'r' => out.write_byte('\r')
      '0' => out.write_byte(0)
      '\\' | '"' | '\'' | '$' => out.write_byte(e)
      'x' => {
        if i + 4 <= raw.len() && is_hex(raw[i + 2]) && is_hex(raw[i + 3]) {
          let v = hex_value(raw[i + 2]) * 16 + hex_value(raw[i + 3])
          if !bytes && v > 0x7f {
            l.error(INVALID_ESCAPE, escape_span(here, 4), b"\\x escape above \\x7f in a string; use \\u{...}")
          }
          out.write_byte(UInt8(v))
          n = 4
        } else {
          l.error(INVALID_ESCAPE, escape_span(here, 2), b"\\x escape needs two hex digits")
        }
      }
      'u' => {
        let end = index_rbrace(raw, i)
        if i + 2 < raw.len() && raw[i + 2] == '{' && end > 3 {
          let hex = raw[i + 3..i + end]
          let r = if hex.len() <= 6 { Rune.try(parse_hex32(hex) ?? -1) } else { None }
          match r {
            Some(v) => out.write_rune(v)
            None => l.error(INVALID_ESCAPE, escape_span(here, end + 1), b"invalid unicode escape \\u{" + hex + b"}")
          }
          n = end + 1
        } else {
          l.error(INVALID_ESCAPE, escape_span(here, 2), b"unicode escape must be written \\u{XXXX}")
        }
      }
      _ => {
        // Go's %c of the byte: bytes above 0x7f print as U+0080 to U+00FF.
        l.error(INVALID_ESCAPE, escape_span(here, 2), "unknown escape sequence \\${Rune(e)}".bytes())
      }
    }
    i += n
    col += n
    off += n
    run = i
  }
  if run < raw.len() {
    out.write(raw[run..])
  }
  out.freeze()
}

/// The span of an n byte escape sequence at p (on one line).
fn escape_span(p: Pos, n: Int) -> Span {
  Span{start: p, end: Pos{offset: p.offset + n, line: p.line, col: p.col + n}}
}

/// The position after text that starts at p.
fn end_pos(p: Pos, text: Bytes) -> Pos {
  var line = p.line
  var col = p.col
  for i in 0..text.len() {
    if text[i] == '\n' {
      line += 1
      col = 1
    } else {
      col += 1
    }
  }
  Pos{offset: p.offset + text.len(), line: line, col: col}
}

/// strings.TrimSpace(b) == "": every rune of b is Unicode white space.
fn is_blank(b: Bytes) -> Bool {
  var i = 0
  while i < b.len() {
    let (r, size) = b.decode_rune(i)
    if !r.is_space() {
      return false
    }
    i += size
  }
  true
}

fn (var l: Lexer) string_lit(start: Pos) {
  let triple = l.peek(1) == '"' && l.peek(2) == '"'
  if triple {
    l.advance_n(3)
  } else {
    l.advance()
  }
  var pieces: List[Piece] = []
  // The current literal piece: its start, the raw text collected before a
  // skipped CR, and the offset where the uncollected raw text begins.
  var cur_start = l.pos()
  var acc = b""
  var seg = l.off
  var terminated = false
  while l.off < l.end {
    let c = l.cur()
    if c == '"' && (!triple || (l.peek(1) == '"' && l.peek(2) == '"')) {
      terminated = true
      break
    }
    if c == '\n' && !triple {
      break
    }
    if c == '\\' && l.off + 1 < l.end && l.src[l.off + 1] != '\n' {
      l.advance_n(2)
      continue
    }
    if c == '$' && l.peek(1) == '{' {
      // Flush the literal piece.
      let raw = acc + l.src[seg..l.off]
      if !raw.is_empty() {
        pieces.push(Piece{expr: false, raw: raw, start: cur_start})
      }
      acc = b""
      let open = l.pos()
      l.advance_n(2)
      let expr_start = l.pos()
      let end = l.scan_interp(l.off, triple)
      if end < 0 {
        // Unterminated: consume to end of line or string.
        while l.off < l.end && l.cur() != '\n' && l.cur() != '"' {
          l.advance()
        }
        l.error(UNTERMINATED_INTERP, l.span(open), b"`\${` is not closed by `}`")
        cur_start = l.pos()
        seg = l.off
        continue
      }
      while l.off < end {
        l.advance()
      }
      let text = l.src[expr_start.offset..end]
      l.advance() // }
      if is_blank(text) {
        l.error(EMPTY_INTERP, l.span(open), b"empty interpolation `\${}`")
      } else {
        pieces.push(Piece{expr: true, raw: text, start: expr_start})
      }
      cur_start = l.pos()
      seg = l.off
      continue
    }
    if c == '\r' && l.peek(1) == '\n' {
      acc = acc + l.src[seg..l.off]
      l.advance()
      seg = l.off
      continue
    }
    l.advance()
  }
  let last_raw = acc + l.src[seg..l.off]
  if !last_raw.is_empty() {
    pieces.push(Piece{expr: false, raw: last_raw, start: cur_start})
  }
  if terminated {
    if triple {
      l.advance_n(3)
    } else {
      l.advance()
    }
  }
  let sp = l.span(start)
  if !terminated {
    l.error(UNTERMINATED_STRING, sp, b"string literal not terminated")
  }
  let final_pieces = if triple { strip_indent(pieces) } else { pieces }
  var parts: List[StrPart] = []
  for p in final_pieces {
    if p.expr {
      parts.push(StrPart{is_expr: true, text: p.raw, span: Span{start: p.start, end: end_pos(p.start, p.raw)}})
      continue
    }
    let cooked = l.cook(p.raw, p.start, false)
    if cooked.is_empty() {
      continue
    }
    parts.push(StrPart{is_expr: false, text: cooked, span: Span{start: p.start, end: end_pos(p.start, p.raw)}})
  }
  l.toks.push(Token{kind: Kind.String, span: sp, text: l.src[start.offset..l.off], parts: parts, triple: triple})
  l.last = Kind.String
}

/// Index of the first occurrence of `"` followed by `hashes` `#` in
/// src[from..end], or -1.
fn (l: Lexer) find_closing(from: Int, hashes: Int) -> Int {
  var i = from
  while i + hashes < l.end {
    if l.src[i] == '"' {
      var ok = true
      for k in 1..=hashes {
        if l.src[i + k] != '#' {
          ok = false
          break
        }
      }
      if ok {
        return i
      }
    }
    i += 1
  }
  -1
}

/// Finds the `}` that closes an interpolation whose expression starts at
/// off. Skips nested braces, strings, raw strings, and runes. Returns -1 if
/// the interpolation is not closed (or, in a one line string, if a newline
/// comes first).
fn (l: Lexer) scan_interp(off: Int, multiline: Bool) -> Int {
  var depth = 0
  var i = off
  while i < l.end {
    let c = l.src[i]
    if c == '\n' && !multiline {
      return -1
    } else if c == '{' {
      depth += 1
    } else if c == '}' {
      if depth == 0 {
        return i
      }
      depth -= 1
    } else if c == 'r' && i + 1 < l.end && (l.src[i + 1] == '"' || l.src[i + 1] == '#') && (i == off || !is_letter(l.src[i - 1]) && !is_digit(l.src[i - 1])) {
      var j = i + 1
      var h = 0
      while j < l.end && l.src[j] == '#' {
        h += 1
        j += 1
      }
      if j < l.end && l.src[j] == '"' {
        let k = l.find_closing(j + 1, h)
        if k < 0 {
          return -1
        }
        i = k + h
      }
    } else if c == '"' {
      // Nested string; may itself contain interpolations.
      var j = i + 1
      while j < l.end && l.src[j] != '"' {
        let cj = l.src[j]
        if cj == '\n' && !multiline {
          return -1
        }
        if cj == '\\' {
          j += 2
        } else if cj == '$' && j + 1 < l.end && l.src[j + 1] == '{' {
          let e = l.scan_interp(j + 2, multiline)
          if e < 0 {
            return -1
          }
          j = e + 1
        } else {
          j += 1
        }
      }
      if j >= l.end {
        return -1
      }
      i = j
    } else if c == '\'' {
      var j = i + 1
      while j < l.end && l.src[j] != '\'' && l.src[j] != '\n' {
        if l.src[j] == '\\' {
          j += 1
        }
        j += 1
      }
      i = j
    }
    i += 1
  }
  -1
}

/// Whether every byte of b is a space or a tab.
fn is_space_tab(b: Bytes) -> Bool {
  for i in 0..b.len() {
    if b[i] != ' ' && b[i] != '\t' {
      return false
    }
  }
  true
}

/// The number of leading spaces and tabs of b.
fn leading_space_tab(b: Bytes) -> Int {
  var n = 0
  while n < b.len() && (b[n] == ' ' || b[n] == '\t') {
    n += 1
  }
  n
}

/// Splits b at every byte sep, like strings.Split with a one byte separator.
fn split_byte(b: Bytes, sep: UInt8) -> List[Bytes] {
  var out: List[Bytes] = []
  var run = 0
  for i in 0..b.len() {
    if b[i] == sep {
      out.push(b[run..i])
      run = i + 1
    }
  }
  out.push(b[run..])
  out
}

/// Applies the triple quoted string rules: the line holding the opening
/// quotes is dropped when it is blank, the line holding the closing quotes
/// is dropped when it is blank, and the common leading indentation of the
/// remaining non blank lines is removed. Indentation is measured on the raw
/// source, so an interpolation counts as non blank content.
fn strip_indent(pieces: List[Piece]) -> List[Piece] {
  var flat = BytesBuilder.new()
  var exprs: List[Piece] = []
  for p in pieces {
    if p.expr {
      flat.write_byte(MARKER)
      exprs.push(p)
    } else {
      flat.write(p.raw)
    }
  }
  var lines = split_byte(flat.freeze(), '\n')
  var kept_first = true
  if lines.len() > 1 && is_space_tab(lines[0]) {
    lines = lines[1..]
    kept_first = false
  }
  if lines.len() > 1 && is_space_tab(lines[lines.len() - 1]) {
    lines = lines[..lines.len() - 1]
  }
  // A first line with content (text right after the opening quotes) is
  // neither measured nor stripped.
  let first = if kept_first { 1 } else { 0 }
  var indent = -1
  for i in first..lines.len() {
    let ln = lines[i]
    if is_space_tab(ln) {
      continue
    }
    let n = leading_space_tab(ln)
    if indent < 0 || n < indent {
      indent = n
    }
  }
  if indent < 0 {
    indent = 0
  }
  var joined = BytesBuilder.new()
  for (i, ln) in lines.indexed() {
    if i > 0 {
      joined.write_byte('\n')
    }
    if i < first {
      joined.write(ln)
    } else if !is_space_tab(ln) {
      joined.write(ln[indent..])
    }
  }
  // Rebuild pieces. Literal pieces lose their exact source position after
  // stripping; they keep the position of the first original piece, which
  // is only used for escape error locations.
  var out: List[Piece] = []
  var lit_start = Pos{offset: 0, line: 0, col: 0}
  if let Some(p) = pieces.first() {
    lit_start = p.start
  }
  for (i, s) in split_byte(joined.freeze(), MARKER).indexed() {
    if !s.is_empty() {
      out.push(Piece{expr: false, raw: s, start: lit_start})
    }
    if let Some(e) = exprs.get(i) {
      out.push(e)
      let after = end_pos(e.start, e.raw)
      lit_start = Pos{offset: after.offset + 1, line: after.line, col: after.col + 1}
    }
  }
  out
}
