// Redundant loads (2026-10-19): a block's later load of the same word as
// an earlier one (the same base register, offset, and width, the
// template's text equal but for its definition) with nothing between
// them that may write memory or redefine the base or the earlier value
// becomes a register move from that value, which coalescing usually
// removes. The amd64 backend loaded twice LLVM's words a request on the
// plain HTTP server (bench/results/amd64-native-vs-llvm-2026-10-19.md,
// the gap by cause); both native backends run it on the arm64 MIR,
// before amd64's retarget.

/// The opcodes of a template line that neither write memory nor have an
/// effect beyond their definitions (reuse_loads: anything else ends every
/// reuse).
fn pure_op(op: Str) -> Bool {
  op is "ldr" | "ldrb" | "ldrh" | "ldrsw" | "ldrsb" | "ldrsh" | "ldur" | "ldp" | "add" | "adds" | "sub" | "subs" | "mov" | "movz" | "movk" | "movn" | "and" | "ands" | "orr" | "eor" | "lsl" | "lsr" | "asr" | "ror" | "mul" | "madd" | "msub" | "umulh" | "smulh" | "umull" | "smull" | "umaddl" | "smaddl" | "cmp" | "cmn" | "tst" | "csel" | "cset" | "csetm" | "csinc" | "csinv" | "csneg" | "cneg" | "neg" | "negs" | "mvn" | "ubfx" | "sbfx" | "ubfiz" | "sbfiz" | "bfi" | "bfxil" | "sxtw" | "sxth" | "sxtb" | "uxtw" | "uxth" | "uxtb" | "adc" | "adcs" | "sbc" | "sbcs" | "bic" | "orn" | "eon" | "clz" | "rev" | "rbit" | "extr" | "udiv" | "sdiv" | "sdivs" | "fmov" | "fadd" | "fsub" | "fmul" | "fmadd" | "fdiv" | "fneg" | "fabs" | "fsqrt" | "fcmp" | "fcsel" | "scvtf" | "ucvtf" | "fcvtzs" | "fcvtzu" | "fcvt"
}

/// Whether inst may write memory or synchronize (reuse_loads forgets
/// every load past it).
fn mir_may_write(inst: Inst) -> Bool {
  if inst.kind == K_PMOVE {
    return false
  }
  // a branch's compare reads registers only (2026-10-30: a block's own
  // `cmp; b.eq` at its end forgot every load before its successors, so
  // no edge carried one)
  let br = inst.kind == K_CONDBR || inst.kind == K_JUMP
  if (inst.kind != K_PLAIN && !br) || inst.has(IF_X86) {
    return true
  }
  for l in inst.text.split("\n") {
    let sp = l.find(" ") ?? l.len()
    let op = l[0..sp]
    if !pure_op(op) && !(br && (op.is_empty() || op == "b" || op.starts_with("b.") || op is "cbz" | "cbnz" | "tbz" | "tbnz")) {
      return true
    }
  }
  false
}

/// The reuse key of a single line load `ldr $d0, [$u0, #off]` (or its
/// w and b forms): the text with its definition left out and its base
/// the register's number; "" for anything else.
fn load_key(inst: Inst) -> Str {
  if inst.kind != K_PLAIN || inst.has(IF_X86) || inst.has(IF_HAS_FAULT) || inst.defs.len() != 1 || inst.us.is_empty() || inst.us.len() > 2 || inst.text.contains("\n") {
    return ""
  }
  let t = inst.text
  if !(t.starts_with("ldr ") || t.starts_with("ldrb ") || t.starts_with("ldrh ") || t.starts_with("ldrsw ")) {
    return ""
  }
  let c = t.find(", [$u0") ?? -1
  if c < 0 || !t.ends_with("]") {
    return ""
  }
  let op = t[0..(t.find(" ") ?? 0)]
  let dst = t[op.len() + 1..c]
  // the definition's width form ($d0, $wd0) is part of the key; an
  // indexed load (`[$u0, $u1, lsl #3]`) its index register's too
  var rest = t[c + 6..t.len()]
  if inst.us.len() == 2 {
    if !rest.starts_with(", $u1") || rest.contains("$u0") {
      return ""
    }
    rest = ", v${inst.us[1]}${rest[", $u1".len()..rest.len()]}"
  } else if rest.contains("$u") {
    return ""
  }
  "${op} ${dst} [v${inst.us[0]}${rest}"
}

/// reuse_loads over every block (redundant loads, above). A block whose
/// one predecessor reaches it by a jump, a branch, or a switch (not a
/// landing pad's edge) starts with what that block's end held: the same
/// element read again past a check's fault branch (2026-10-20: portable
/// divmod loaded xs[i] three times an iteration on amd64). A join, all
/// of whose predecessors come first, starts with what they all end
/// holding in the same value.
fn (var g: G) reuse_loads() {
  let blocks = g.all_blocks()
  let preds = g.mpreds_all(blocks)
  // a reverse postorder from the entry: every predecessor of a block
  // but a loop's back edge comes before it (a join's all done, a
  // preorder visited one before its other predecessors)
  var order: List[Int] = []
  var seen: List[Bool] = []
  for _ in 0..g.blocks.len() {
    seen.push(false)
  }
  if !blocks.is_empty() {
    var post: List[Int] = []
    // (block, index of its next successor)
    var stack = [(blocks[0], 0)]
    seen[blocks[0]] = true
    while !stack.is_empty() {
      let top = stack.len() - 1
      let (b, k) = stack[top]
      let ss = g.msuccs(b)
      if k < ss.len() {
        stack[top] = (b, k + 1)
        if !seen[ss[k]] {
          seen[ss[k]] = true
          stack.push((ss[k], 0))
        }
      } else {
        post.push(b)
        let _p = stack.pop()
      }
    }
    var i = post.len() - 1
    while i >= 0 {
      order.push(post[i])
      i -= 1
    }
  }
  for b in 0..g.blocks.len() {
    if !seen[b] {
      order.push(b)
    }
  }
  var end_avail: Map[Int, Map[Str, Int]] = {}
  var done: List[Bool] = []
  for _ in 0..g.blocks.len() {
    done.push(false)
  }
  var end_dep: Map[Int, Map[Int, List[Str]]] = {}
  for b in order {
    var ins = g.take_insts(b)
    // a key -> the value that holds it; a value -> the keys it holds or
    // is the base of
    var avail: Map[Str, Int] = {}
    var dep: Map[Int, List[Str]] = {}
    if preds[b].len() == 1 {
      let p = preds[b][0]
      if p != b && g.rle_edge(p) {
        avail = end_avail.get(p) ?? {}
        dep = end_dep.get(p) ?? {}
      }
    } else if preds[b].len() > 1 {
      // a join: what every predecessor, each done before b (no back
      // edge), ends holding in the same value (2026-10-30:
      // parse_duration's sign byte read again after `c == 45 || c == 43`
      // joined)
      var all = true
      for p in preds[b] {
        all = all && p != b && done[p] && g.rle_edge(p)
      }
      if all {
        let p0 = preds[b][0]
        for (key, v) in end_avail.get(p0) ?? {} {
          var same = true
          for p in preds[b] {
            same = same && ((end_avail.get(p) ?? {}).get(key) ?? -1) == v
          }
          if same {
            avail[key] = v
          }
        }
        // a value's keys: those kept that a predecessor had it hold
        for p in preds[b] {
          for (r, ks) in end_dep.get(p) ?? {} {
            var l = dep.get(r) ?? []
            for kk in ks {
              if avail.contains(kk) && !l.contains(kk) {
                l.push(kk)
              }
            }
            if !l.is_empty() {
              dep[r] = l
            }
          }
        }
      }
    }
    for k in 0..ins.len() {
      let inst = ins[k]
      let key = load_key(inst)
      if !key.is_empty() {
        if let Some(v) = avail.get(key) {
          if v != inst.defs[0] {
            ins[k] = Inst{kind: K_PMOVE, defs: [inst.defs[0]], srcs: [rsrc(v)], us: [v], line: inst.line, inl: inst.inl}
          }
        }
      }
      if mir_may_write(inst) {
        avail = {}
        dep = {}
      }
      // a definition ends what it held and what it was the base of
      for d in ins[k].defs {
        for kk in dep.get(d) ?? [] {
          avail.remove(kk)
        }
        dep.remove(d)
      }
      if !key.is_empty() && !avail.contains(key) && !inst.us.contains(inst.defs[0]) {
        let v = inst.defs[0]
        avail[key] = v
        // in place (Map.update): a copy, push and store copied a base's
        // whole list at each load through it, quadratic in a block of a
        // wide result's word loads (aiplatform/v1, 2026-11-10)
        dep.update(v, [], fn(var l) { l.push(key) })
        for u in inst.us {
          dep.update(u, [], fn(var l) { l.push(key) })
        }
      }
    }
    g.blocks[b].insts = ins
    done[b] = true
    if !avail.is_empty() {
      end_avail[b] = avail
      end_dep[b] = dep
    }
  }
}

/// Whether block p ends in a jump, a branch, or a switch (not a landing
/// pad's edge), so its successors start with what it ends holding.
fn (g: G) rle_edge(p: Int) -> Bool {
  let pi = g.blocks[p].insts
  let pt = if pi.is_empty() { Inst{kind: K_PLAIN} } else { pi[pi.len() - 1] }
  pt.kind == K_CONDBR || pt.kind == K_SWITCH || (pt.kind == K_JUMP && pt.targets.len() == 1)
}
