// Closures, boxes, and structural equality (internal/arm64 closures.go,
// boxes.go, eq.go; decisions 0048 and 0050).
//
// A function value is two integer words, the code pointer and the
// environment: null when the closure captures nothing, else a counted
// cell [0] rc, [8] drop, [16] share, [24] the captured values' words. A
// Box[T] is one integer word, a pointer to an immutable counted cell [0]
// rc, [8] the words of the T value.

use github.com/xo-lang/xo/compiler/ssa

/// {rc, drop, share}
const ENV_HDR = 24

/// The first word (from the start of the captures) and the word count of
/// capture i of function fi.
fn (var g: G) capture_words(fi: Int, i: Int) -> (Int, Int) {
  let caps = g.m.funcs[fi].captures
  var off = 0
  for k in 0..i {
    off += g.nwords(caps[k])
  }
  (off, g.nwords(caps[i]))
}

/// The fewest words of plain data the equality helpers compare as bytes
/// in one call instead of field by field (2026-11-07: a struct of 4,096
/// Int fields made 378 KB of compares, and 177 s of clang with LLVM).
const EQ_RUN = 16

/// The field types of struct or tuple t.
fn (g: G) part_types(t: Int) -> List[Int] {
  let x = g.m.types[t]
  if x.kind == ssa.Kind.Struct {
    var out: List[Int] = []
    for f in x.fields {
      out.push(f.ty)
    }
    return out
  }
  x.elems
}

/// Whether a value of type t is plain words, equal exactly when its bytes
/// are: Int, Bool, and structs and tuples of them (no Float: NaN is not
/// equal to itself; nothing counted or tagged).
fn (var g: G) plain_words(t: Int) -> Bool {
  match g.m.types[t].kind {
    Int | Bool | Unit | Cap => true
    Struct | Tuple => {
      for ft in g.part_types(t) {
        if !g.plain_words(ft) {
          return false
        }
      }
      true
    }
    _ => false
  }
}

/// The run of plain fields of struct or tuple t (field types fts) from
/// field i: the index past it and its words, the fields lying end to end;
/// (i + 1, 0) when field i is not plain.
fn (var g: G) plain_run(t: Int, fts: List[Int], i: Int) -> (Int, Int) {
  let (f0, _) = g.field_words(t, i)
  var j = i
  var words = 0
  while j < fts.len() && g.plain_words(fts[j]) {
    let (fo, nw) = g.field_words(t, j)
    if fo != f0 + words {
      break
    }
    words += nw
    j += 1
  }
  if j == i {
    return (i + 1, 0)
  }
  (j, words)
}

/// The words of the captured values of function ci's environment.
fn (var g: G) env_words(ci: Int) -> Int {
  var n = 0
  for c in g.m.funcs[ci].captures {
    n += g.nwords(c)
  }
  n
}

/// Lowers a closure: the code address, and a new environment holding the
/// captured values (consumed) when there are any.
fn (var g: G) closure_op(v: Int) {
  let x = g.f.values[v]
  let name = g.f.name_of(x)
  let ci = g.by_name.get(name) ?? -1
  if ci < 0 {
    g.fail("closure of unknown function `${name}`")
    g.set(v, [0, 0])
    return
  }
  let code = g.sym_addr(g.fname(name))
  if x.args.is_empty() {
    g.set(v, [code, 0])
    return
  }
  let n = g.env_words(ci)
  if g.stack_closures().contains(v) {
    // in the frame: one area per closure, which its next run reuses (the
    // value is dead by then: it is never carried on an edge); the count
    // immortal, so nothing frees it
    let off = g.mem_bytes
    g.mem_bytes += ENV_HDR + 8 * n
    let env = g.area_addr(off)
    g.store("str $u0, [$u1]", [g.cimm(MIN_INT), env])
    g.closure_fill(v, ci, env)
    g.set(v, [code, env])
    return
  }
  let env = g.rt("xo_x_obj_rc_alloc", [isrc(ENV_HDR + 8 * n)], [false])[0]
  g.store("str $u0, [$u1]", [g.cimm(1), env])
  g.closure_fill(v, ci, env)
  g.set(v, [code, env])
}

/// Stores a closure's drop and share functions and its captured values
/// (consumed) in its environment env.
fn (var g: G) closure_fill(v: Int, ci: Int, env: Int) {
  let x = g.f.values[v]
  let d = g.sym_addr(g.env_drop(ci))
  g.store("str $u0, [$u1, #8]", [d, env])
  let s = g.sym_addr(g.env_share(ci))
  g.store("str $u0, [$u1, #16]", [s, env])
  var k = 0
  for a in x.args {
    for w in g.store_words(a) {
      let (base, off) = g.mem_at(env, ENV_HDR + 8 * k)
      g.store("str $u0, [$u1, #${off}]", [w, base])
      k += 1
    }
  }
}

/// The closures of the function whose environment can be in its frame:
/// those whose value is only called, retained, or released here: never
/// stored, passed, returned, captured, or carried on an edge (2026-10-23:
/// a closure given to Map.update in a loop allocated its environment at
/// every iteration). One whose captured values hold something counted is
/// never retained either, so its release releases them
/// (stack_env_release; 2026-11-07: Mutex.with_read's closure over a Str
/// key allocated and freed its environment on every metrics lookup).
fn (var g: G) stack_closures() -> Map[Int, Bool] {
  if g.stack_env_done {
    return g.stack_env
  }
  g.stack_env_done = true
  var cand: Map[Int, Bool] = {}
  for (v, x) in g.f.values.indexed() {
    if x.op != ssa.Op.Closure || x.args.is_empty() || ssa.block_of(x.tb) < 0 {
      continue
    }
    // past 32760 bytes an environment word's offset goes through an add
    // (mem_at; a fault frame's parameters, 2026-11-07: generated GCP
    // services hold thousands of words); such an environment stays on
    // the heap
    let ci = g.by_name.get(g.f.name_of(x)) ?? -1
    if ci < 0 || ENV_HDR + 8 * g.env_words(ci) > 32760 {
      continue
    }
    cand[v] = true
  }
  if cand.is_empty() {
    return g.stack_env
  }
  for b in 0..g.f.blocks.len() {
    for u in g.f.blocks[b].instrs {
      let y = g.f.values[u]
      for (k, a) in y.args.indexed() {
        if !cand.contains(a) {
          continue
        }
        // a retain only of one whose captures hold nothing counted: with
        // none, any release is the last (2026-11-07), and releases them
        let fine = (y.op == ssa.Op.CallValue && k == 0) || (y.op == ssa.Op.Release && y.args.len() == 1) || (y.op == ssa.Op.Retain && y.args.len() == 1 && !g.counted_env(a))
        if !fine {
          cand.remove(a)
        }
      }
      for e in y.succs() {
        for a in g.f.edges[e].args {
          if cand.contains(a) {
            cand.remove(a)
          }
        }
      }
    }
  }
  g.stack_env = cand
  g.stack_env
}

/// Whether closure value v captures a value holding something counted.
fn (var g: G) counted_env(v: Int) -> Bool {
  for a in g.f.values[v].args {
    if g.m.heap(g.vty(a)) {
      return true
    }
  }
  false
}

/// The release of a closure value v whose environment is in the frame
/// (stack_closures): with counted captures it is never retained, so
/// this release is its last and releases them; else nothing.
fn (var g: G) stack_env_release(v: Int) {
  if !g.counted_env(v) {
    return
  }
  let ci = g.by_name.get(g.f.name_of(g.f.values[v])) ?? -1
  if ci < 0 {
    g.fail("closure of unknown function `${g.f.name_of(g.f.values[v])}`")
    return
  }
  let env = g.real(g.words(v)[1])
  var off = 0
  for t in g.m.funcs[ci].captures {
    let lay = g.layout(t)
    if g.m.heap(t) {
      var ws: List[Int] = []
      for (k, fp) in lay.indexed() {
        let (base, o) = g.mem_at(env, ENV_HDR + 8 * (off + k))
        ws.push(g.def1(fp, "ldr $d0, [$u0, #${o}]", [base]))
      }
      g.release(t, ws)
    }
    off += lay.len()
  }
}

/// Lowers a capture: the words of a captured value, loaded from the
/// environment of the closure parameter (a projection: no counting).
fn (var g: G) capture_op(v: Int) {
  let x = g.f.values[v]
  let env = g.real(g.words(x.args[0])[1])
  let (off, _) = g.capture_words(g.fi, ssa.auxw_int(x.aux))
  var ws: List[Int] = []
  for (k, fp) in g.layout(ssa.ty_of(x.tb)).indexed() {
    let (base, o) = g.mem_at(env, ENV_HDR + 8 * (off + k))
    ws.push(g.def1(fp, "ldr $d0, [$u0, #${o}]", [base]))
  }
  g.set(v, ws)
}

/// EnvUnique (decision 0613 step 5 stage 4): whether the environment of
/// the function value's count is 1 (a frame's environment, MIN_INT, and
/// a shared one, its SHARED bit set, are not).
fn (var g: G) env_unique_op(v: Int) {
  let x = g.f.values[v]
  let env = g.real(g.words(x.args[0])[1])
  let rc = g.def1(false, "ldr $d0, [$u0]", [env])
  g.set(v, [g.def1(false, "cmp $u0, #1\ncset $d0, eq", [rc])])
}

/// CapTake: capture aux of the function's own environment, its slot then
/// zero, so a later release of the environment releases nothing there.
fn (var g: G) cap_take_op(v: Int) {
  let x = g.f.values[v]
  let env = g.real(g.words(x.args[0])[1])
  let (off, _) = g.capture_words(g.fi, ssa.auxw_int(x.aux))
  var ws: List[Int] = []
  for (k, fp) in g.layout(ssa.ty_of(x.tb)).indexed() {
    let (base, o) = g.mem_at(env, ENV_HDR + 8 * (off + k))
    ws.push(g.def1(fp, "ldr $d0, [$u0, #${o}]", [base]))
  }
  let z = g.cimm(0)
  for k in 0..ws.len() {
    let (base, o) = g.mem_at(env, ENV_HDR + 8 * (off + k))
    g.store("str $u0, [$u1, #${o}]", [z, base])
  }
  g.set(v, ws)
}

/// CapPut: the value stored into capture aux of the function's own
/// environment (the slot CapTake emptied).
fn (var g: G) cap_put_op(v: Int) {
  let x = g.f.values[v]
  let env = g.real(g.words(x.args[0])[1])
  let (off, _) = g.capture_words(g.fi, ssa.auxw_int(x.aux))
  var k = 0
  for w in g.store_words(x.args[1]) {
    let (base, o) = g.mem_at(env, ENV_HDR + 8 * (off + k))
    g.store("str $u0, [$u1, #${o}]", [w, base])
    k += 1
  }
  g.set(v, [])
}

/// Lowers a call through a function value: the closure's words (code in
/// x0, environment in x1) and the arguments, then `blr x0`.
fn (var g: G) call_value_op(v: Int) {
  let x = g.f.values[v]
  var args: List[Src] = []
  for a in x.args {
    args = args + regs(g.words(a))
  }
  let defs = g.new_vregs(g.layout(ssa.ty_of(x.tb)))
  var us: List[Int] = []
  for a in args {
    if a.v != 0 {
      us.push(a.v)
    }
  }
  let _i = g.add(Inst{kind: K_CALL, srcs: args, defs: defs, us: us, fl: IF_INDIRECT})
  g.clobber()
  g.set(v, defs)
}

/// The drop function of the environments of function fi: it releases
/// the captures and frees the cell (x0).
fn (var g: G) env_drop(fi: Int) -> Str {
  let key = "envdrop ${g.m.funcs[fi].name}"
  if let Some(s) = g.helped.get(key) {
    return s
  }
  if g.defers(key, Want{op: 2, kind: "", t: -1, fi: fi}) {
    return g.helped.get(key) ?? ""
  }
  let sym = g.helper_label("envdrop")
  g.helped[key] = sym
  var b: List[Str] = ["${g.cmt()} envdrop ${g.m.funcs[fi].name}\n${g.fn_align()}${g.alias(key)}${sym}:\n"]
  var ls: List[Leaf] = []
  let bw = g.m.funcs[fi].cap_borrowed
  for (i, c) in g.m.funcs[fi].captures.indexed() {
    if i < bw.len() && bw[i] {
      continue // borrowed (decision 0507): its scope's variable owns it
    }
    let (off, _) = g.capture_words(fi, i)
    g.heap_leaves(c, off, ls)
  }
  g.leaves_and_then(b, "drop", ls, ENV_HDR, g.sym("xo_x_obj_rc_free"))
  g.helpers.push(b.join(""))
  sym
}

/// The share function of the environments of function fi (decision
/// 0058).
fn (var g: G) env_share(fi: Int) -> Str {
  let key = "envshare ${g.m.funcs[fi].name}"
  if let Some(s) = g.helped.get(key) {
    return s
  }
  if g.defers(key, Want{op: 3, kind: "", t: -1, fi: fi}) {
    return g.helped.get(key) ?? ""
  }
  let sym = g.helper_label("envshare")
  g.helped[key] = sym
  var b: List[Str] = ["${g.cmt()} envshare ${g.m.funcs[fi].name}\n${g.fn_align()}${g.alias(key)}${sym}:\n"]
  var ls: List[Leaf] = []
  for (i, c) in g.m.funcs[fi].captures.indexed() {
    let (off, _) = g.capture_words(fi, i)
    g.heap_leaves(c, off, ls)
  }
  g.leaves_and_then(b, "share", ls, ENV_HDR, "")
  g.helpers.push(b.join(""))
  sym
}

/// Retains a function value inline (ws: code, environment).
fn (var g: G) retain_func(ws: List[Int]) {
  if ws[1] == 0 {
    return // no captures: nothing counted
  }
  let env = ws[1]
  let before = g.m_()
  let has = g.new_block(false)
  let cont = g.new_block(false)
  let _b = g.add(Inst{kind: K_CONDBR, cond: "cbnz", us: [env], targets: [has, cont]})
  g.cur = has
  g.inc(env)
  let _j = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = cont
  g.inherit(before)
  g.clobber()
}

/// Releases a function value inline: when there is an environment, its
/// count goes down by one, and at one the environment goes to
/// xo_rc_defer with its drop function.
fn (var g: G) release_func(ws: List[Int]) {
  if ws[1] == 0 {
    return
  }
  let env = ws[1]
  let before = g.m_()
  let has = g.new_block(false)
  let at = g.cur
  let bi = g.add(Inst{kind: K_CONDBR, cond: "cbnz", us: [env], targets: [has, -1]})
  g.cur = has
  let cont = g.dec_or_defer(env, DropFn.EnvWord(env: env))
  var ins = g.take_insts(at)
  ins[bi].targets[1] = cont
  g.put_insts(at, ins)
  g.cur = cont
  g.inherit(before)
  g.clobber()
}

/// Where the drop function of a cell comes from.
enum DropFn {
  /// the drop word of the environment (`ldr [env, #8]`)
  EnvWord(env: Int)
  /// the boxdrop helper of a box type
  BoxDrop(t: Int)
}

/// Ends the current block with the inline release of the counted cell p:
/// when its count is one the cell goes to xo_rc_defer with its drop
/// function (a cold block), else the count goes down by one. Returns the
/// block both paths continue at.
fn (var g: G) dec_or_defer(p0: Int, drop: DropFn) -> Int {
  let p = g.real(p0)
  let c = g.def1(false, "ldr $d0, [$u0]", [p])
  let slow = g.new_block(true)
  let dec = g.new_block(false)
  let cont = g.new_block(false)
  // a count of at most one: the last reference, shared, or immortal
  let _b = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, #1", us: [c], cond: "le", targets: [slow, dec]})
  g.cur = dec
  let c1 = g.def1(false, "sub $d0, $u0, #1", [c])
  g.store("str $u0, [$u1]", [c1, p])
  let _j = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = slow
  let free = g.new_block(true)
  let shared = g.new_block(true)
  let atomic = g.new_block(true)
  let _b2 = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, #1", us: [c], cond: "eq", targets: [free, shared]})
  g.cur = shared
  let _b3 = g.add(Inst{kind: K_CONDBR, cond: "tbz", bit: 62, us: [c], targets: [cont, atomic]})
  g.cur = atomic
  // x16 may hold a reloaded p: x17 and w15 are free scratch
  let _b4 = g.add(Inst{kind: K_CONDBR, text: g.atomic_dec("$u0", "x17", "w15"), us: [p], cond: "eq", targets: [free, cont], clobbers: [15]})
  g.cur = free
  let d = match drop {
    EnvWord(env) => rsrc(g.def1(false, "ldr $d0, [$u0, #8]", [env]))
    BoxDrop(t) => symsrc(g.box_drop(t))
  }
  let _r = g.rt("xo_x_obj_rc_defer_n", [rsrc(p), d], [])
  let _j2 = g.add(Inst{kind: K_JUMP, targets: [cont]})
  cont
}

// ---------------------------------------------------------------------------
// Boxes

/// Lowers a box: copies a value (consumed) into a new cell.
fn (var g: G) box_op(v: Int) {
  let x = g.f.values[v]
  let a = x.args[0]
  let n = g.nwords(g.vty(a))
  let p = g.rt("xo_x_obj_rc_alloc", [isrc(BOX_HDR + 8 * n)], [false])[0]
  g.store("str $u0, [$u1]", [g.cimm(1), p])
  for (k, w) in g.store_words(a).indexed() {
    // past 32760 bytes through an add (mem_at; a recursive value of
    // thousands of words, 2026-11-07)
    let (base, off) = g.mem_at(p, BOX_HDR + 8 * k)
    g.store("str $u0, [$u1, #${off}]", [w, base])
  }
  g.set(v, [p])
}

/// Lowers an unbox: loads the box's words (a projection: no counting).
fn (var g: G) unbox_op(v: Int) {
  let x = g.f.values[v]
  let p = g.word(x.args[0])
  var ws: List[Int] = []
  for (k, fp) in g.layout(ssa.ty_of(x.tb)).indexed() {
    let (base, off) = g.mem_at(p, BOX_HDR + 8 * k)
    ws.push(g.def1(fp, "ldr $d0, [$u0, #${off}]", [base]))
  }
  g.set(v, ws)
}

/// Releases the box p of type t inline.
fn (var g: G) release_box(t: Int, p: Int) {
  let before = g.m_()
  let cont = g.dec_or_defer(p, DropFn.BoxDrop(t: t))
  g.cur = cont
  g.inherit(before)
  g.clobber()
}

// ---------------------------------------------------------------------------
// Structural equality: `==` and `!=` on Str, structs, tuples, enums,
// lists, and boxes. A Str compares through obj.xo str_eq; other types
// call a generated helper that returns 1 or 0 in x0.

/// Lowers v (a comparison) when its operands are aggregates; reports
/// whether it did.
fn (var g: G) eq_aggregate(v: Int) -> Bool {
  let x = g.f.values[v]
  let t = g.vty(x.args[0])
  let k = g.kind(t)
  if !(k is ssa.Kind.Str | ssa.Kind.Struct | ssa.Kind.Tuple | ssa.Kind.Enum | ssa.Kind.List | ssa.Kind.Box) {
    return false
  }
  if x.op != ssa.Op.Eq && x.op != ssa.Op.Ne {
    g.fail("ordering of `${g.tname(t)}`")
    g.set(v, [0])
    return true
  }
  var r = 0
  if k == ssa.Kind.Str {
    let a = g.words(x.args[0])
    let b = g.words(x.args[1])
    let xd = g.str_data(a)
    let yd = g.str_data(b)
    let res = g.rt("xo_x_obj_str_eq", regs([xd, g.str_len(a), yd, g.str_len(b)]), [false])
    r = g.def1(false, "cmp $wu0, #0\ncset $d0, ne", [res[0]])
  } else if k is ssa.Kind.List | ssa.Kind.Box {
    let h = g.eq_helper(t)
    let a = g.word(x.args[0])
    let b = g.word(x.args[1])
    r = g.call(h, regs([a, b]), [false])[0]
  } else if g.eq_by_ref(t) {
    // a wide value: the helper reads both in place
    let pa = g.eq_addr(x.args[0], 0)
    let pb = g.eq_addr(x.args[1], 1)
    r = g.call(g.eq_helper(t), regs([pa, pb]), [false])[0]
  } else {
    let lay = g.layout(t)
    if lay.is_empty() {
      r = g.imm(1)
    } else {
      let a = g.to_int(g.words(x.args[0]), lay)
      let b = g.to_int(g.words(x.args[1]), lay)
      if !g.x86 && g.tag_only_enum(t, lay) {
        // the tag is the whole value: one compare, where the helper call
        // made `x.op == ssa.Op.Call` 1.8% of the aiplatform/v1 test
        // build's CPU (Lang 1, 2026-11-11)
        r = g.def1(false, "cmp $u0, $u1\ncset $d0, eq", [a[0], b[0]])
      } else {
        r = g.call(g.eq_helper(t), regs(a + b), [false])[0]
      }
    }
  }
  if x.op == ssa.Op.Ne {
    r = g.def1(false, "eor $d0, $u0, #1", [r])
  }
  g.set(v, [r])
  true
}

/// Whether t is an enum with no payload in any variant, one word wide:
/// its values are equal when their tags are.
fn (g: G) tag_only_enum(t: Int, lay: List[Bool]) -> Bool {
  if g.kind(t) != ssa.Kind.Enum || lay.len() != 1 || lay[0] {
    return false
  }
  for vr in g.m.types[t].variants {
    if !vr.fields.is_empty() {
      return false
    }
  }
  true
}

/// Whether the equality helper of t takes the two values' addresses
/// (x0, x1) instead of their words: a struct, tuple or enum of
/// ssa.WIDE_MIN bytes or more, whose words the caller would copy to the
/// stack and the helper back to its frame (2026-11-07: 61,000
/// instructions for one `==` of a 4,096 word struct).
fn (var g: G) eq_by_ref(t: Int) -> Bool {
  ssa.wide_kind(g.kind(t)) && ssa.wide_bytes(8 * g.nwords(t))
}

/// The address of v for a helper taking it by reference: the memory v
/// is read from in place, else the n-th frame area of its type with v
/// stored there.
fn (var g: G) eq_addr(v: Int, n: Int) -> Int {
  let (ptr, ok) = g.mem_of(v)
  if ok {
    return ptr
  }
  let ad = g.area_addr(g.frame_area(g.vty(v), n))
  g.store_words_at(ad, 0, g.words(v))
  ad
}

/// The symbol of the equality helper of t.
fn (var g: G) eq_helper(t: Int) -> Str {
  let key = "eq ${g.tname(t)}"
  if let Some(s) = g.helped.get(key) {
    return s
  }
  if g.defers(key, Want{op: 4, kind: "", t: t, fi: -1}) {
    return g.helped.get(key) ?? ""
  }
  let sym = g.helper_label("eq")
  g.helped[key] = sym
  let yes = g.helper_label("eq_yes")
  let no = g.helper_label("eq_no")
  let done = g.helper_label("eq_done")
  var b: List[Str] = ["${g.cmt()} eq ${g.tname(t)}\n${g.fn_align()}${g.alias(key)}${sym}:\n"]
  if g.x86 {
    g.x86_eq_body(b, sym, t, yes, no, done)
    g.helpers.push(b.join(""))
    return sym
  }
  var frame = 32
  let k = g.kind(t)
  match k {
    Box => {
      let et = g.m.types[t].elems[0]
      if !g.has_float(et) {
        // the same cell is equal, unless it holds a Float
        b.push("\tcmp x0, x1\n\tb.ne ${sym}_cmp\n\tmov x0, #1\n\tret\n${sym}_cmp:\n")
      }
      b.push("\tstp x29, x30, [sp, #-32]!\n\tmov x29, sp\n\tstp x20, x19, [sp, #16]\n")
      b.push("\tadd x19, x0, #8\n\tadd x20, x1, #8\n")
      g.eq_at(b, et, "x19", "x20", 0, no, false)
    }
    List => {
      frame = 64
      b.push("\tstp x29, x30, [sp, #-64]!\n\tmov x29, sp\n\tstp x20, x19, [sp, #16]\n\tstp x22, x21, [sp, #32]\n\tstp x24, x23, [sp, #48]\n")
      b.push("\tldr x9, [x0, #8]\n\tldr x10, [x1, #8]\n\tcmp x9, x10\n\tb.ne ${no}\n")
      let et = g.m.types[t].elems[0]
      let es = g.esize(et)
      if es == 0 {
        b.push("\tb ${yes}\n")
      } else {
        let lp = g.helper_label("eq_loop")
        b.push("\tmov x21, x9\n\tmov x22, #0\n\tadd x23, x0, #${LIST_HDR}\n\tadd x24, x1, #${LIST_HDR}\n")
        b.push("${lp}:\n\tcmp x22, x21\n\tb.eq ${yes}\n")
        let nw = g.narrow_w(et)
        if nw > 0 {
          // packed elements (decision 0369): loads of their width
          let ld = if nw == 1 { "ldrb" } else if nw == 2 { "ldrh" } else { "ldr" }
          b.push("\t${ld} w9, [x23]\n\t${ld} w10, [x24]\n\tcmp w9, w10\n\tb.ne ${no}\n")
        } else {
          g.eq_at(b, et, "x23", "x24", 0, no, g.kind(et) == ssa.Kind.Bool)
        }
        if imm12(es) {
          b.push("\tadd x23, x23, #${es}\n\tadd x24, x24, #${es}\n")
        } else {
          b.push(imm_text(es, "x9"))
          b.push("\tadd x23, x23, x9\n\tadd x24, x24, x9\n")
        }
        b.push("\tadd x22, x22, #1\n\tb ${lp}\n")
      }
    }
    Struct | Tuple | Enum if g.eq_by_ref(t) => {
      b.push("\tstp x29, x30, [sp, #-32]!\n\tmov x29, sp\n\tstp x20, x19, [sp, #16]\n")
      b.push("\tmov x19, x0\n\tmov x20, x1\n")
      g.eq_at(b, t, "x19", "x20", 0, no, false)
    }
    Struct | Tuple | Enum => {
      let n = g.nwords(t)
      frame = align16(32 + 16 * n)
      // eq_at reads both values at any offset (mem_at); a frame of 4
      // KiB or more is lowered page by page (frame_down)
      g.frame_down(b, frame, "")
      b.push("\tstp x29, x30, [sp]\n\tmov x29, sp\n\tstp x20, x19, [sp, #16]\n")
      for w in 0..2 * n {
        if w < 8 {
          b.push(mem_at("str", "x${w}", "sp", 32 + 8 * w))
          continue
        }
        // stack arguments: at the caller's sp, which is sp + frame
        b.push("${mem_at("ldr", "x9", "sp", frame + 8 * (w - 8))}${mem_at("str", "x9", "sp", 32 + 8 * w)}")
      }
      b.push("\tadd x19, sp, #32\n${add_at("x20", "sp", 32 + 8 * n)}")
      g.eq_at(b, t, "x19", "x20", 0, no, false)
    }
    _ => g.fail("equality of `${g.tname(t)}`")
  }
  b.push("${yes}:\n\tmov x0, #1\n\tb ${done}\n${no}:\n\tmov x0, #0\n${done}:\n")
  if k == ssa.Kind.List {
    b.push("\tldp x24, x23, [sp, #48]\n\tldp x22, x21, [sp, #32]\n")
  }
  b.push("\tldp x20, x19, [sp, #16]\n")
  if (k is ssa.Kind.Struct | ssa.Kind.Tuple | ssa.Kind.Enum) && !g.eq_by_ref(t) {
    b.push("\tldp x29, x30, [sp]\n")
    sub_sp(b, "add", frame)
    b.push("\tret\n\n")
  } else {
    b.push("\tldp x29, x30, [sp], #${frame}\n\tret\n\n")
  }
  g.helpers.push(b.join(""))
  sym
}

/// Compares the values of type t at [ra, #off] and [rb, #off] and
/// branches to no when they differ (eqAt). byte: a Bool list element.
fn (var g: G) eq_at(var b: List[Str], t: Int, ra: Str, rb: Str, off: Int, no: Str, byte: Bool) {
  let x = g.m.types[t]
  match x.kind {
    Unit | Cap => {}
    Int | Bool => {
      if byte {
        b.push("\tldrb w9, [${ra}, #${off}]\n\tldrb w10, [${rb}, #${off}]\n")
      } else {
        b.push("${mem_at("ldr", "x9", ra, off)}${mem_at("ldr", "x10", rb, off)}")
      }
      b.push("\tcmp x9, x10\n\tb.ne ${no}\n")
    }
    Float => {
      // unordered (NaN) sets ne: NaN is unequal to everything
      b.push("${mem_at("ldr", "d0", ra, off)}${mem_at("ldr", "d1", rb, off)}\tfcmp d0, d1\n\tb.ne ${no}\n")
    }
    Str => {
      // the data of a view starts off bytes in, its length is the low half of
      // the second word (decision 0330)
      if g.inl_str() {
        // a field may be an inline Str (decision 0370): the runtime compares the words
        b.push("${mem_at("ldr", "x0", ra, off)}${mem_at("ldr", "x1", ra, off + 8)}${mem_at("ldr", "x2", rb, off)}${mem_at("ldr", "x3", rb, off + 8)}")
        b.push("\tbl ${g.sym("xo_x_inl_eq")}\n\tcbz w0, ${no}\n")
      } else {
        b.push("${mem_at("ldr", "x0", ra, off)}${mem_at("ldr", "x1", ra, off + 8)}\tadd x0, x0, x1, lsr #32\n\tadd x0, x0, #16\n\tmov w1, w1\n")
        b.push("${mem_at("ldr", "x2", rb, off)}${mem_at("ldr", "x3", rb, off + 8)}\tadd x2, x2, x3, lsr #32\n\tadd x2, x2, #16\n\tmov w3, w3\n")
        b.push("\tbl ${g.sym("xo_x_obj_str_eq")}\n\tcbz w0, ${no}\n")
      }
    }
    List | Box => {
      let h = g.eq_helper(t)
      b.push("${mem_at("ldr", "x0", ra, off)}${mem_at("ldr", "x1", rb, off)}\tbl ${h}\n\tcbz x0, ${no}\n")
    }
    Struct | Tuple => {
      let fts = g.part_types(t)
      var i = 0
      while i < fts.len() {
        let (fo, _) = g.field_words(t, i)
        let (j, words) = g.plain_run(t, fts, i)
        if words >= EQ_RUN {
          // a run of plain words: one byte compare (xo_x_obj_str_eq)
          b.push("${add_at("x0", ra, off + 8 * fo)}${imm_text(8 * words, "x1")}${add_at("x2", rb, off + 8 * fo)}${imm_text(8 * words, "x3")}\tbl ${g.sym("xo_x_obj_str_eq")}\n\tcbz w0, ${no}\n")
          i = j
          continue
        }
        g.eq_at(b, fts[i], ra, rb, off + 8 * fo, no, false)
        i += 1
      }
    }
    Enum => {
      b.push("${mem_at("ldr", "x9", ra, off)}${mem_at("ldr", "x10", rb, off)}\tcmp x9, x10\n\tb.ne ${no}\n")
      let end = g.helper_label("eq_tag")
      for (vi, vr) in x.variants.indexed() {
        var words = 0
        for f in vr.fields {
          words += g.nwords(f.ty)
        }
        if words == 0 {
          continue
        }
        let next = g.helper_label("eq_var")
        // the tag again: comparing a field may have called a function
        b.push("${mem_at("ldr", "x9", ra, off)}\tcmp x9, #${vi}\n\tb.ne ${next}\n")
        for (fi, f) in vr.fields.indexed() {
          let (po, _) = g.payload_words(t, vi, fi)
          g.eq_at(b, f.ty, ra, rb, off + 8 * po, no, false)
        }
        b.push("\tb ${end}\n${next}:\n")
      }
      b.push("${end}:\n")
    }
    _ => g.fail("equality of `${x.name}`")
  }
}
