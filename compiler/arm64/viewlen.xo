// Views only measured (view_lens): after inlining, `s.trim_prefix(p).len()`
// makes a view of s (rt.str_view counts s once more), joins it with s
// itself in a block parameter, reads the parameter's length, and
// releases it, a call. When a Str value's only uses are its length,
// its release, and edges into parameters of the same kind: a view
// becomes hi - lo (no count, no release), and a parameter gets an Int
// parameter beside it with the length, its own reads replaced, while it
// still carries a Str for its release (the empty string where a view
// came in), since a parameter may alias an argument read after the jump
// (Xo Lang 3's trim_affix, 2026-10-23: about 12 instructions and a call
// per trim).

use github.com/xo-lang/xo/compiler/ssa

/// Rewrites the Str values of f used only for their length (see above);
/// whether it changed f.
fn view_lens(var f: ssa.Func) -> Bool {
  // the Int and Str types: a Str.len's result and operand
  var it = -1
  var st = -1
  for x in f.values {
    if x.op == ssa.Op.Call && f.name_is(x, "Str.len") && x.args.len() == 1 && ssa.block_of(x.tb) >= 0 {
      it = ssa.ty_of(x.tb)
      st = ssa.ty_of(f.values[f.arg(x.args, 0)].tb)
      break
    }
  }
  if it < 0 || st < 0 {
    return false
  }
  let n = f.values.len()
  // the uses of each value: by instructions, and as edge arguments
  var vuses: List[List[Int]] = []
  var euses: List[List[(Int, Int)]] = []
  for _ in 0..n {
    vuses.push([])
    euses.push([])
  }
  for b in 0..f.blocks.len() {
    for u in f.blocks[b].instrs {
      for a in f.args_iter(f.values[u].args) {
        vuses[a].push(u)
      }
      for e in f.values[u].succs() {
        for (k, a) in f.edges[e].args.indexed() {
          euses[a].push((e, k))
        }
      }
    }
  }
  // candidates: views (rt.str_view cannot fault: a landing pad on one is
  // the inlined call site's, which every value copied from the callee
  // gets; 2026-10-24: requiring none skipped every inlined view), and Str
  // parameters of blocks other than the entry (a function's parameters
  // may be borrowed)
  var cand: List[Bool] = []
  for _ in 0..n {
    cand.push(false)
  }
  for b in 1..f.blocks.len() {
    for p in f.blocks[b].params {
      cand[p] = ssa.ty_of(f.values[p].tb) == st
    }
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      cand[v] = cand[v] || (x.op == ssa.Op.Call && (f.name_of(x) is "rt.str_view" | "rt.str_borrow") && x.args.len() == 3 && ssa.ty_of(x.tb) == st)
    }
  }
  for v in f.blocks[0].instrs {
    let x = f.values[v]
    cand[v] = x.op == ssa.Op.Call && (f.name_of(x) is "rt.str_view" | "rt.str_borrow") && x.args.len() == 3 && ssa.ty_of(x.tb) == st
  }
  // an option of a Str (2026-10-24, DS-2's `(b.cut_prefix(p) ?? b"").len()`:
  // the view travels in a variant, through option parameters, out of a
  // payload): its types are those of a variant of one Str; a variant of
  // such a type (of one view, or of none) and such a block parameter are
  // option candidates, and a payload of one, a Str, is a view whose
  // length the option carries beside it
  var otys: Map[Int, Bool] = {}
  for v in 0..n {
    let x = f.values[v]
    if ssa.block_of(x.tb) >= 0 && x.op == ssa.Op.Variant && x.args.len() == 1 && ssa.ty_of(f.values[f.arg(x.args, 0)].tb) == st {
      otys[ssa.ty_of(x.tb)] = true
    }
  }
  var ocand: List[Bool] = []
  for _ in 0..n {
    ocand.push(false)
  }
  if !otys.is_empty() {
    for b in 0..f.blocks.len() {
      if b > 0 {
        for p in f.blocks[b].params {
          ocand[p] = otys.contains(ssa.ty_of(f.values[p].tb))
        }
      }
      for v in f.blocks[b].instrs {
        let x = f.values[v]
        if x.op == ssa.Op.Variant && otys.contains(ssa.ty_of(x.tb)) {
          ocand[v] = x.args.is_empty() || cand[f.arg(x.args, 0)]
        }
        if x.op == ssa.Op.Payload && ssa.ty_of(x.tb) == st && x.args.len() == 1 && otys.contains(ssa.ty_of(f.values[f.arg(x.args, 0)].tb)) {
          cand[v] = true
        }
      }
    }
  }
  // drop a candidate with any other use, until none changes
  var changed = true
  while changed {
    changed = false
    for v in 0..n {
      if !cand[v] {
        continue
      }
      var ok = true
      let xv = f.values[v]
      if xv.op == ssa.Op.Payload && !ocand[f.arg(xv.args, 0)] {
        ok = false
      }
      for u in vuses[v] {
        let y = f.values[u]
        // a borrowed view's Retain (decision 0465's view_proj: the count
        // rt.str_view took itself) goes with it, as its Release does
        let vret = y.op == ssa.Op.Retain && y.args.len() == 1 && xv.op == ssa.Op.Call && f.name_is(xv, "rt.str_borrow")
        if !((y.op == ssa.Op.Call && f.name_is(y, "Str.len") && y.args.len() == 1) || (y.op == ssa.Op.Release && y.args.len() == 1) || vret || (y.op == ssa.Op.Variant && ocand[u] && xv.op == ssa.Op.Call)) {
          ok = false
          break
        }
      }
      if ok {
        for (e, k) in euses[v] {
          if !cand[f.blocks[f.edges[e].to].params[k]] {
            ok = false
            break
          }
        }
      }
      if !ok {
        cand[v] = false
        changed = true
      }
    }
    // an option candidate: read only by tags, candidate payloads and
    // releases, passed only to option candidates, of a candidate view
    for v in 0..n {
      if !ocand[v] {
        continue
      }
      var ok = true
      let x = f.values[v]
      if x.op == ssa.Op.Variant && !x.args.is_empty() && !cand[f.arg(x.args, 0)] {
        ok = false
      }
      // a parameter: every value coming in is a candidate too (its length
      // rides the edge beside it)
      if x.op == ssa.Op.Param && ssa.block_of(x.tb) > 0 {
        let k = f.blocks[ssa.block_of(x.tb)].params.index_of(v) ?? -1
        for e in f.blocks[ssa.block_of(x.tb)].preds {
          let args = f.edges[e].args
          if k < 0 || k >= args.len() || args[k] < 0 || args[k] >= n || !ocand[args[k]] {
            ok = false
          }
        }
      }
      for u in vuses[v] {
        let y = f.values[u]
        if !(y.op == ssa.Op.Tag || (y.op == ssa.Op.Payload && cand[u]) || (y.op == ssa.Op.Release && y.args.len() == 1)) {
          ok = false
          break
        }
      }
      if ok {
        for (e, k) in euses[v] {
          if !ocand[f.blocks[f.edges[e].to].params[k]] {
            ok = false
            break
          }
        }
      }
      if !ok {
        ocand[v] = false
        changed = true
      }
    }
  }
  var any = false
  for v in 0..n {
    any = any || cand[v] || ocand[v]
  }
  if !any {
    return false
  }
  // a view is its length (no count taken, none released)
  var view: List[Bool] = []
  for _ in 0..n {
    view.push(false)
  }
  for v in 0..n {
    if cand[v] && f.values[v].op == ssa.Op.Call {
      let a = f.args_copy(f.values[v].args)
      f.values[v].op = ssa.Op.Sub
      f.values[v].aux = f.pack(ssa.Aux.None)
      f.set_args(v, [a[2], a[1]])
      f.values[v].pi = ssa.with_pad(f.values[v].pi, -1)
      f.values[v].tb = ssa.with_ty(f.values[v].tb, it)
      view[v] = true
    }
  }
  // an option candidate's length: its view's (the variant then holds the
  // immortal empty string), 0 for none, an Int parameter beside an option
  // parameter; a payload of one is that length (a view, as above)
  var olen: Map[Int, Int] = {}
  for b in 0..f.blocks.len() {
    if b > 0 {
      for p in f.blocks[b].params {
        if ocand[p] {
          olen[p] = f.add_param(b, it)
        }
      }
    }
  }
  for b in 0..f.blocks.len() {
    var ins: List[Int] = []
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      if ocand[v] && x.op == ssa.Op.Variant {
        if x.args.is_empty() {
          let z = f.add(b, ssa.Op.Const, it, ssa.Aux.I(n: 0), [])
          ins.push(z)
          olen[v] = z
        } else {
          let e = f.add(b, ssa.Op.Const, st, ssa.Aux.S(s: ""), [])
          ins.push(e)
          olen[v] = f.arg(x.args, 0)
          f.set_args(v, [e])
        }
      }
      ins.push(v)
    }
    f.blocks[b].instrs = ins
  }
  for v in 0..n {
    let x = f.values[v]
    if cand[v] && x.op == ssa.Op.Payload {
      let l = olen.get(f.arg(x.args, 0)) ?? -1
      let z = f.add(ssa.block_of(x.tb), ssa.Op.Const, it, ssa.Aux.I(n: 0), [])
      // before v in its block
      var ins: List[Int] = []
      for u in f.blocks[ssa.block_of(x.tb)].instrs {
        if u == z {
          continue
        }
        if u == v {
          ins.push(z)
        }
        ins.push(u)
      }
      f.blocks[ssa.block_of(x.tb)].instrs = ins
      f.values[v].op = ssa.Op.Add
      f.values[v].aux = f.pack(ssa.Aux.None)
      f.set_args(v, [l, z])
      f.values[v].tb = ssa.with_ty(f.values[v].tb, it)
      f.values[v].pi = ssa.with_pad(f.values[v].pi, -1)
      view[v] = true
    }
  }
  // on each edge into an option parameter, the argument's length
  for b in 0..f.blocks.len() {
    let t = f.term(b)
    if t < 0 {
      continue
    }
    for e in f.values[t].succs() {
      let to = f.edges[e].to
      var extra: List[Int] = []
      for (k, a) in f.edges[e].args.indexed() {
        let p = f.blocks[to].params[k]
        if ocand[p] {
          extra.push(olen.get(a) ?? a)
        }
      }
      if !extra.is_empty() {
        f.edges[e].args = f.edges[e].args + extra
      }
    }
  }
  // a parameter keeps its Str, so every reference is released where it
  // was (a parameter may alias its argument, which is read after the
  // jump), and gets its length beside it
  var plen: Map[Int, Int] = {}
  for b in 1..f.blocks.len() {
    for p in f.blocks[b].params {
      // (p < n: not a length parameter added above)
      if p < n && cand[p] && !view[p] {
        plen[p] = f.add_param(b, it)
      }
    }
  }
  // on each edge into such a parameter: the argument's length, and the
  // immortal empty string in place of a view (its release does nothing)
  for b in 0..f.blocks.len() {
    let t = f.term(b)
    if t < 0 {
      continue
    }
    for e in f.values[t].succs() {
      let to = f.edges[e].to
      let args = f.edges[e].args
      var extra: List[Int] = []
      for (k, a) in args.indexed() {
        let p = f.blocks[to].params[k]
        if !plen.contains(p) {
          continue
        }
        if a < n && view[a] {
          extra.push(a)
          let c = f.add(b, ssa.Op.Const, st, ssa.Aux.S(s: ""), [])
          before_term(f, b, c)
          f.edges[e].args[k] = c
        } else if let Some(l) = plen.get(a) {
          extra.push(l)
        } else {
          let l = f.add(b, ssa.Op.Call, it, ssa.Aux.S(s: "Str.len"), [a])
          before_term(f, b, l)
          extra.push(l)
        }
      }
      if !extra.is_empty() {
        f.edges[e].args = f.edges[e].args + extra
      }
    }
  }
  // a length read is the length; a view's release goes
  var repl: Map[Int, Int] = {}
  var gone: Map[Int, Bool] = {}
  for v in 0..n {
    if !cand[v] {
      continue
    }
    for u in vuses[v] {
      if f.values[u].op == ssa.Op.Variant {
        // an option candidate's view: the variant now holds the empty
        // string, its length rides beside the option
        continue
      }
      if f.values[u].op == ssa.Op.Release || f.values[u].op == ssa.Op.Retain {
        if view[v] {
          gone[u] = true
        }
      } else {
        repl[u] = if view[v] { v } else { plen.get(v) ?? v }
        gone[u] = true
      }
    }
  }
  // an option candidate holds the empty string or nothing: its releases go
  for v in 0..n {
    if !ocand[v] {
      continue
    }
    for u in vuses[v] {
      if f.values[u].op == ssa.Op.Release {
        gone[u] = true
      }
    }
  }
  for b in 0..f.blocks.len() {
    var out: List[Int] = []
    for u in f.blocks[b].instrs {
      if gone.contains(u) {
        continue
      }
      out.push(u)
      var args = f.args_copy(f.values[u].args)
      var ch = false
      for k in 0..args.len() {
        if let Some(r) = repl.get(args[k]) {
          args[k] = r
          ch = true
        }
      }
      if ch {
        f.set_args(u, args)
      }
      for e in f.values[u].succs() {
        for k in 0..f.edges[e].args.len() {
          if let Some(r) = repl.get(f.edges[e].args[k]) {
            f.edges[e].args[k] = r
          }
        }
      }
    }
    f.blocks[b].instrs = out
  }
  true
}

/// Moves value v, just added at the end of block b, before b's
/// terminator.
fn before_term(var f: ssa.Func, b: Int, v: Int) {
  let ins = f.blocks[b].instrs
  let n = ins.len()
  f.blocks[b].instrs = ins[0..n - 2] + [v, ins[n - 2]]
}
