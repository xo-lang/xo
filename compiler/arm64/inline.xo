// Inlining of small functions, SSA to SSA, after reference counting
// (internal/arm64 inline.go, decisions 0049, 0184). The callee body
// already carries its own retains and releases for its ownership
// convention, so a faithful copy with the parameters replaced by the
// call's arguments keeps every count balanced; the module is verified
// again after inlining.
//
// A call `v = call f, args` in block B becomes:
//
//	B:  ...instructions before v; jump f.entry'
//	f's blocks, copied; `ret xs` becomes `jump C(xs)`
//	C(results):  the rest of B (v is C's parameter, or a tuple of them)
//
// Cost model (decision 0184): a function's cost is its instruction and
// block count with every call of an inlinable Xo function counted as that
// function's cost and every other call as one instruction. A function is
// inlinable when both stay within the limits, it is not main, and it has
// no landing pads of its own. The costs are found by a depth first walk
// of the call graph (functions in module order, callees in instruction
// order); a function that calls one still being walked (a cycle, or
// itself) is not inlinable, so copies never nest without end.

use github.com/xo-lang/xo/compiler/ssa

const INLINE_MAX_INSTRS = 40
const INLINE_MAX_BLOCKS = 12
/// A larger function with at most this many call sites, whose copies
/// stay within the budget (inline.go inlineFewSites).
const INLINE_FEW_SITES = 2
const INLINE_FEW_BUDGET = 500
const INLINE_FEW_BLOCKS = 80
/// A larger function with more than one site is inlined only at a loop
/// site (InlineCost.few), and only up to this size
const INLINE_FEW_LOOP_INSTRS = 100
/// A function over those limits only by its size is still inlined at a
/// call inside a loop of its caller when it stays within these, at most
/// INLINE_LOOP_SITES times a caller (2026-10-17: map.find in a lookup
/// loop was a call where LLVM inlines it; get 1.58 times LLVM on arm64,
/// bench/results/amd64-vs-llvm-2026-10-17.md).
const INLINE_LOOP_INSTRS = 60
const INLINE_LOOP_BLOCKS = 24
const INLINE_LOOP_SITES = 8
/// A function with landing pads and one call site is inlined there up
/// to this size
const INLINE_ONE_PADDED_INSTRS = 150
/// A function with one call site is inlined there up to INLINE_FEW_BUDGET
/// instructions and this many blocks (the copy is the only body, so the
/// program does not grow): jsontext.str_end and scalar_end, 103 and 133
/// blocks of bounds and overflow checks over INLINE_FEW_BLOCKS, were
/// calls from scan where LLVM inlines them, json parse 1.36 times LLVM's
/// instructions on amd64 (2026-10-22,
/// bench/results/amd64-native-vs-llvm-2026-10-22.md)
const INLINE_ONE_SITE_BLOCKS = 160

/// The last function of each name (Go's byName).
fn funcs_by_name(m: ssa.Module) -> Map[Str, Int] {
  var out: Map[Str, Int] = {}
  for (i, f) in m.funcs.indexed() {
    out[f.name] = i
  }
  out
}

/// The expanded size of a function, or bad when it is not inlinable
/// (inline.go inlineCost).
struct InlineCost {
  instrs: Int
  blocks: Int
  bad: Bool
  /// the constants of a leaf (not in instrs), and whether the function
  /// with its inlined callees calls nothing but inline intrinsics
  consts: Int = 0
  leaf: Bool = true
  /// not inlinable for another reason than its size (main, a slow path,
  /// landing pads, rt.frame_addr, a cycle)
  hard: Bool = false
  /// why it is hard, for XO_INLINE_REPORT
  why: Str = ""
  /// it has landing pads of its own: inlined only at a call that passes a
  /// closure literal (decision 0256; elsewhere the copies grew hot loops)
  pads: Bool = false
  /// over INLINE_MAX_INSTRS (within INLINE_FEW_LOOP_INSTRS), inlinable
  /// only by the few sites rule with more than one site: at a call inside
  /// a loop only (find_loop_call), since a copy outside one only saves a
  /// call and adds the body. A function over only the block limit stays
  /// inlined at both sites: its blocks are the joins of its tests, and
  /// the HTTP server's memcmp and map scan lost as calls
  /// (bench/results/inline-ledger-2026-10-17.md)
  few: Bool = false
}

/// The rt intrinsics the arm64 emitter makes instructions, not calls: a
/// function calling only these (and inlined leaves) is a leaf. The
/// immortal placeholders rt.rl_empty and rt.h_zero are an address each
/// (a constant constructor such as x509.empty, its lists all [], is a
/// leaf: 2026-10-17). With the
/// carry arithmetic cpu.xo's adc, adc_carry, carry, and borrow lower to
/// (ssa call.xo cpu_call; one adcs or adds each): leaving them out kept
/// nistec.sub_p256 a non-leaf, its constants counted, and a call
/// (bench/results/arm64-inline-cost-2026-10-16.md).
fn inline_intrinsic(n: Str) -> Bool {
  n is "rt.prefetch" | "rt.static_word" | "rt.mem_copy" | "rt.mem_copy_block" | "rt.mem_load" | "rt.mem_store" | "rt.int_wrap" | "rt.slot_load" | "rt.slot_store" | "rt.slot_swap" | "rt.slot_cas" | "rt.slot_add" | "rt.fence" | "rt.spin_hint" | "rt.preempt_poll" | "rt.ct_barrier" | "rt.u64_adc" | "rt.u64_adc_carry" | "rt.u64_carry" | "rt.u64_borrow" | "rt.rl_empty" | "rt.h_zero"
}

/// The rt.u64_adc and rt.u64_adc_carry calls of a block with the same
/// operands: each pair is one adcs, counted once (a P-256 field add,
/// nistec.add4p, was 44 and a call 29,000 times a handshake, 2026-10-17).
fn adc_pairs(f: ssa.Func, instrs: List[Int]) -> Int {
  var sums: Map[Str, Int] = {}
  var carries: Map[Str, Int] = {}
  for v in instrs {
    let x = f.values[v]
    if x.op != ssa.Op.Call {
      continue
    }
    let n = aux_str(x.aux)
    if n == "rt.u64_adc" {
      let k = args_key(f, x.args)
      sums[k] = (sums.get(k) ?? 0) + 1
    } else if n == "rt.u64_adc_carry" {
      let k = args_key(f, x.args)
      carries[k] = (carries.get(k) ?? 0) + 1
    }
  }
  var n = 0
  for (k, a) in sums {
    let b = carries.get(k) ?? 0
    n += if a < b { a } else { b }
  }
  n
}

/// A call's operands as a map key: a constant by its value (each use
/// of a literal is its own Const, a negative one a Neg of it).
fn args_key(f: ssa.Func, args: List[Int]) -> Str {
  var parts: List[Str] = []
  for a in args {
    if let Some(n) = const_value(f, a) {
      parts.push("k${n}")
    } else if f.values[a].op == ssa.Op.Not && f.values[a].args.len() == 1 {
      // ~v written for the sum and again for the carry
      parts.push("~${f.values[a].args[0]}")
    } else {
      parts.push("${a}")
    }
  }
  parts.join(",")
}

/// Walks function fi and its callees (inline.go inlinableSet's walk):
/// state is 1 while a function is walked, 2 once done.
fn inline_walk(m: ssa.Module, sums: List[FnSum], by_name: Map[Str, Int], sites: Map[Str, Int], fi: Int, var state: Map[Str, Int], var costs: Map[Str, InlineCost]) -> InlineCost {
  let f = m.funcs[fi]
  // the body's facts (inlsum.xo fn_sum, or the cache's for an undecoded
  // function), in the body's order
  let s = sums[fi]
  state[f.name] = 1
  // the runtime's slow paths stay calls (ssa.cold_fn)
  // a function that catches its faults returns on one (ssa raises):
  // inlined, the fault would reach the caller
  // a closure that catches its faults (Map.update's, with a var
  // parameter) is inlinable where its call lands and its own landings
  // only hand back (find_call, catch_inlinable; decision 0317)
  var c = InlineCost{instrs: 0, blocks: s.blocks, bad: f.name == "main" || ssa.cold_fn(f.name) || denied(m, f.name)}
  c.hard = c.bad
  if c.hard {
    c.why = if f.name == "main" { "main" } else if ssa.cold_fn(f.name) { "slow path" } else { "denied" }
  }
  c.instrs -= s.adc
  // landing pads of its own (decision 0085) are copied with the body
  // since decision 0256: each copied value's pad is the copy of its
  // check, and the callee's unwind exit re-raises into the caller's
  // landing (inline_call); but not a pad of an operation that faults
  // before it takes its operands (list.set, list.take): its cleanup
  // releases them only for an owned root, and the callee's owned
  // parameter can be a borrowed root of the caller
  if s.badpad {
    c.bad = true
    c.hard = true
    c.why = "pad before operands"
  }
  if s.pads {
    c.pads = true
  }
  // in a leaf a constant is no instruction of its own (an immediate, or
  // one mov the emitter shares): counting it kept arithmetic helpers
  // (sub_p256's limbs) out of INLINE_MAX_INSTRS. Elsewhere it counts:
  // free constants let the scheduler's run_item and steal_round into
  // park_wait (sysio chan 1.019, 2026-10-16); a negative literal (Neg of
  // a Const) folds as one
  c.consts += s.consts
  c.instrs += s.instrs
  for name in s.calls {
    let ci = by_name.get(name) ?? -1
    if name == "rt.frame_addr" {
      // its frame is the function's own (decision 0233)
      c.bad = true
      c.hard = true
      c.why = "frame_addr"
    }
    if ci < 0 {
      if !inline_intrinsic(name) {
        c.leaf = false
      }
      c.instrs += 1
      continue
    }
    let cname = m.funcs[ci].name
    var k = InlineCost{instrs: 0, blocks: 0, bad: false}
    let st = state.get(cname) ?? 0
    if st == 1 {
      c.bad = true // a cycle through f
      c.hard = true
      c.why = "cycle through ${cname}"
      k.bad = true
    } else if st == 2 {
      k = costs.get(cname) ?? k
    } else {
      k = inline_walk(m, sums, by_name, sites, ci, state, costs)
    }
    if k.bad || k.pads || k.few {
      // a callee with pads is a call here unless its site passes a
      // closure (find_call), so it counts as one
      c.instrs += 1
      c.leaf = false
    } else {
      c.instrs += k.instrs
      c.consts += k.consts
      c.blocks += k.blocks + 1
      c.leaf = c.leaf && k.leaf
    }
  }
  if !c.leaf {
    c.instrs += c.consts
    c.consts = 0
  }
  if c.instrs > INLINE_MAX_INSTRS || c.blocks > INLINE_MAX_BLOCKS {
    let n = sites.get(f.name) ?? 0
    let blocks_max = if n == 1 { INLINE_ONE_SITE_BLOCKS } else { INLINE_FEW_BLOCKS }
    if n > INLINE_FEW_SITES || n * c.instrs > INLINE_FEW_BUDGET || c.blocks > blocks_max {
      c.bad = true
    } else if n > 1 && c.instrs > INLINE_MAX_INSTRS && c.instrs <= INLINE_FEW_LOOP_INSTRS {
      c.few = true
    } else if n > 1 && c.instrs > INLINE_MAX_INSTRS {
      c.bad = true
    }
  }
  state[f.name] = 2
  costs[f.name] = c
  c
}

/// The names of the inlinable functions of m (inline.go inlinableSet),
/// of those inlinable only at a call inside a loop (INLINE_LOOP_*), and of
/// those with landing pads, inlinable only at a call passing a closure.
fn inlinable_set(m: ssa.Module, sums: List[FnSum], by_name: Map[Str, Int]) -> (Map[Str, Bool], Map[Str, Bool], Map[Str, Bool], Map[Str, Bool]) {
  let (costs, sites) = inline_costs(m, sums, by_name)
  var small: Map[Str, Bool] = {}
  var loopy: Map[Str, Bool] = {}
  var padded: Map[Str, Bool] = {}
  var fewl: Map[Str, Bool] = {}
  for (fi, f) in m.funcs.indexed() {
    if let Some(c) = costs.get(f.name) {
      if c.pads {
        if !c.hard && !c.bad && (sites.get(f.name) ?? 0) == 1 && c.instrs <= INLINE_ONE_PADDED_INSTRS && !updates_in_place(sums[fi]) {
          // one site: the copy is the only body, so no loop grows a
          // second one (decision 0256's reason to wait for a closure);
          // the HTTP server's head_request and match_parts were calls
          // where LLVM inlines them (Xo lang 4, 2026-10-19). Not one that
          // updates a list in place: copied, the verifier no longer
          // proves the list unique (sums_of's pushes in a task scope)
          small[f.name] = true
        } else if !c.hard && c.instrs <= INLINE_LOOP_INSTRS && c.blocks <= INLINE_LOOP_BLOCKS {
          padded[f.name] = true
        }
      } else if !c.bad && c.few {
        fewl[f.name] = true
      } else if !c.bad || (!c.hard && f.name.starts_with("xo.map.find[") && c.instrs <= INLINE_MAX_INSTRS) {
        // a map's find: its blocks are mostly the joins of its tests (14
        // for 36 instructions, over INLINE_MAX_BLOCKS), and put, get and
        // update call it once each (2026-10-17: put and find 249M
        // against LLVM's put 169M in update, find inlined there)
        small[f.name] = true
      } else if !c.hard && c.instrs <= INLINE_LOOP_INSTRS && c.blocks <= INLINE_LOOP_BLOCKS {
        loopy[f.name] = true
      }
    }
  }
  (small, loopy, padded, fewl)
}

/// Whether a function's own body updates a list in place (ssa rc.xo
/// is_update_call's operations).
fn updates_in_place(s: FnSum) -> Bool {
  for n in s.calls {
    if n is "list.set" | "list.push" | "list.pop" | "list.take" {
      return true
    }
  }
  false
}

/// The expanded cost of each function of m and the call sites of each
/// (not counting a function's own).
fn inline_costs(m: ssa.Module, sums: List[FnSum], by_name: Map[Str, Int]) -> (Map[Str, InlineCost], Map[Str, Int]) {
  var state: Map[Str, Int] = {}
  var costs: Map[Str, InlineCost] = {}
  var sites: Map[Str, Int] = {}
  for (fi, f) in m.funcs.indexed() {
    for name in sums[fi].calls {
      if name != f.name {
        sites[name] = (sites.get(name) ?? 0) + 1
      }
    }
  }
  for fi in 0..m.funcs.len() {
    if (state.get(m.funcs[fi].name) ?? 0) == 0 {
      let _c = inline_walk(m, sums, by_name, sites, fi, state, costs)
    }
  }
  (costs, sites)
}

/// inline_report: a line for each function of m whose name contains
/// filter (every function for "1"; the driver's XO_INLINE_REPORT): its
/// expanded instructions and blocks, its call sites, and how the inliner
/// takes it (small: at every site; loop: at a site in a loop; few: at a
/// site in a loop, two sites at most; padded: at a site passing a
/// closure; no: a call, by its size, its landing pads (over the padded
/// limits), or another reason, hard).
pub fn inline_report(m: ssa.Module, filter: Str) -> List[Str] {
  let sums = module_sums(m)
  let by_name = funcs_by_name(m)
  let (costs, sites) = inline_costs(m, sums, by_name)
  let (small, loopy, padded, fewl) = inlinable_set(m, sums, by_name)
  var out: List[Str] = []
  for f in m.funcs {
    if filter != "1" && !f.name.contains(filter) {
      continue
    }
    let c = costs.get(f.name) ?? InlineCost{instrs: 0, blocks: 0, bad: true}
    let how = if small.contains(f.name) { "small" } else if fewl.contains(f.name) { "few" } else if loopy.contains(f.name) { "loop" } else if padded.contains(f.name) { "padded" } else if c.hard { "no (hard: ${c.why})" } else if c.pads { "no (pads)" } else { "no (size)" }
    out.push("inline ${f.name}: instrs ${c.instrs} blocks ${c.blocks} sites ${sites.get(f.name) ?? 0} ${how}")
  }
  out
}

/// Whether block b of f is in a loop: it reaches itself (through its
/// predecessors, Block.preds being edges, a bounded walk).
fn in_loop(f: ssa.Func, b: Int) -> Bool {
  var seen: Map[Int, Bool] = {}
  var work: List[Int] = []
  for e in f.blocks[b].preds {
    work.push(f.edges[e].from)
  }
  var steps = 0
  while !work.is_empty() && steps < 4096 {
    steps += 1
    let p = work.pop() ?? 0
    if p == b {
      return true
    }
    if seen.contains(p) {
      continue
    }
    seen[p] = true
    for e in f.blocks[p].preds {
      work.push(f.edges[e].from)
    }
  }
  false
}

/// Turns each call through a closure made in f itself (a Closure value
/// with no captures) into a direct call of the closure's function: the same machine call
/// (the function value's words, then the arguments: the function's first
/// parameter is the closure), which the inliner can then take (a fold's
/// function literal inside hof_chain, 2026-10-17).
fn devirtualize(var f: ssa.Func, m: ssa.Module, by_name: Map[Str, Int]) {
  for bi in 0..f.blocks.len() {
    for v in f.blocks[bi].instrs {
      let x = f.values[v]
      if x.op != ssa.Op.CallValue || x.args.is_empty() {
        continue
      }
      let c = f.values[x.args[0]]
      // a closure with captures stays a value call: its function's
      // capture ops must read their own environment (an inlined copy
      // would read the caller's closure value; the verifier refuses it)
      if c.op != ssa.Op.Closure || !c.args.is_empty() {
        continue
      }
      let name = aux_str(c.aux)
      // only a function made to be called through values (parameter 0
      // the closure: a literal, or a named function's `.value` thunk)
      let ci = by_name.get(name) ?? -1
      // and one that catches its faults (Map.update's closure with a var
      // parameter) only where the call lands: inlined, a fault in the
      // copy goes to that landing (decision 0317)
      if ci >= 0 && m.funcs[ci].indirect && (!m.funcs[ci].catches || x.pad >= 0) {
        f.values[v].op = ssa.Op.Call
        f.values[v].aux = ssa.Aux.S(s: name)
      }
    }
  }
}

/// What inline_module reads of the whole module before it changes it:
/// the last function of each name and the inlinable sets.
struct InlineState {
  by_name: Map[Str, Int] = {}
  /// every function's summary (inlsum.xo), which inline_keys reads too
  sums: List[FnSum] = []
  small: Map[Str, Bool] = {}
  loopy: Map[Str, Bool] = {}
  padded: Map[Str, Bool] = {}
  fewl: Map[Str, Bool] = {}
  rounds: Int = 0
}

fn inline_state(m: ssa.Module) -> InlineState { inline_state_jobs(m, 1) }

/// inline_state with the summaries read on up to jobs tasks.
fn inline_state_jobs(m: ssa.Module, jobs: Int) -> InlineState {
  let by_name = funcs_by_name(m)
  let sums = module_sums_jobs(m, jobs)
  let (small, loopy, padded, fewl) = inlinable_set(m, sums, by_name)
  // XO_PASSES=-inline: no call is inlined (devirtualize, which runs
  // with the call search, neither); the other passes here still run
  let rounds = if pass_on(m, "inline") { 200 } else { 0 }
  InlineState{by_name: by_name, sums: sums, small: small, loopy: loopy, padded: padded, fewl: fewl, rounds: rounds}
}

/// Inlines the calls of small functions in m and reports whether it
/// changed anything.
fn inline_module(var m: ssa.Module) -> Bool {
  // every body (none undecoded: inline_cached forces what it needs)
  ssa.force_lazy(m, [], 1)
  let st = inline_state(m)
  var changed = false
  for fi in 0..m.funcs.len() {
    if inline_one(m, st, fi) {
      changed = true
    }
  }
  changed
}

/// inline_module's work on function fi: the bodies it copies are the
/// module's at that moment (functions before fi already inlined into);
/// whether it changed fi.
fn inline_one(var m: ssa.Module, st: InlineState, fi: Int) -> Bool {
  var ch = false
  var f = m.funcs[fi]
  m.funcs[fi] = ssa.Func{name: ""}
  // its cache key no longer names it (inline_cached sets the inliner's)
  f.ckey = ""
  var here = false
  var loop_left = INLINE_LOOP_SITES
  for _ in 0..st.rounds {
    if pass_on(m, "devirtualize") {
      devirtualize(f, m, st.by_name)
    }
    var v = find_call(f, m, st.small, st.by_name)
    if v < 0 {
      v = find_closure_call(f, m, st.padded, st.by_name)
    }
    if v < 0 && loop_left > 0 {
      v = find_loop_call(f, m, st.loopy, st.by_name)
      if v >= 0 {
        loop_left -= 1
      }
    }
    if v < 0 {
      // the few sites rule's callees, at loop sites only: their own
      // pass, not the loop budget's (two sites each at most)
      v = find_loop_call(f, m, st.fewl, st.by_name)
    }
    if v < 0 {
      break
    }
    let ci = st.by_name.get(aux_str(f.values[v].aux)) ?? -1
    inline_call(f, v, m.funcs[ci])
    ch = true
    here = true
  }
  if here {
    // one block per straight run again (ssa.merge_straight)
    let _j = ssa.merge_straight(f, m, block_calls(f))
    if pass_on(m, "fold_consts") {
      fold_consts(f, m.types)
      // a callee's tests of a constant parameter (ints.fits(2, a, b)'s
      // `op == 0`): jumps, the arms not taken gone
      if ssa.fold_branches(f) {
        let _j2 = ssa.merge_straight(f, m, block_calls(f))
      }
    }
    // a small counted loop whose count inlining made a constant
    // (ssa unroll.xo): its body that many times
    if pass_on(m, "unroll_small") && ssa.unroll_small_loops(f) {
      // each copy's counter and its tests of it are constants now
      if pass_on(m, "fold_consts") {
        fold_consts(f, m.types)
        let _f = ssa.fold_branches(f)
      }
      let _j3 = ssa.merge_straight(f, m, block_calls(f))
    }
    // a callee's release of its parameter meets the caller's retain
    if pass_on(m, "cancel_rc_pairs") {
      let _c = cancel_rc_pairs(f)
    }
    // a view only measured is its length (viewlen.xo); a release it
    // moved to an edge may meet a retain
    if pass_on(m, "view_lens") && view_lens(f) && pass_on(m, "cancel_rc_pairs") {
      let _c2 = cancel_rc_pairs(f)
    }
  }
  // decision 0257: after inlining, which brings the loops' list reads
  // into one function
  if pass_on(m, "hoist_fields") && hoist_fields(f, m.types) {
    ch = true
    // a dropped landing (drop_proven_pads) leaves a jump to a block
    // only it reaches: join them, so a loop body's loads are one
    // block for cluster_mem
    let _k = ssa.merge_straight(f, m, block_calls_inline(f))
  }
  // an inlined body repeats its caller's arithmetic (j + 1 tested,
  // then indexed with): computed once
  if pass_on(m, "fold_tuples") && ssa.fold_tuple_fields(f, m) {
    ch = true
  }
  if pass_on(m, "cse") && ssa.cse(f, m) {
    ch = true
    // a block left only its jump joins the next
    let _s = ssa.merge_straight(f, m, block_calls_inline(f))
  }
  m.funcs[fi] = f
  ch
}

/// Per block of f, whether it makes a call (not an intrinsic emitted
/// in line): ssa.merge_straight joins only blocks that make none.
fn block_calls(f: ssa.Func) -> List[Bool] {
  var out: List[Bool] = []
  for bl in f.blocks {
    var c = false
    for v in bl.instrs {
      let x = f.values[v]
      c = c || (x.op == ssa.Op.Call && !inline_intrinsic(aux_str(x.aux)))
    }
    out.push(c)
  }
  out
}

/// Folds the Int operations of f whose operands are constants, in place
/// (the value becomes the constant): the SSA builder folds before
/// inlining, so a helper's parameter that is a constant at the call (a
/// rotation by 64 - n with n constant) left an operation on two
/// constants that the emitter computed at run time, its result hoisted
/// out of a loop and spilled (2026-10-15,
/// gotchas/arm64-inline-one-level.md). A checked operation is folded only
/// when it does not overflow (otherwise it stays, and faults as before);
/// shifts only by 0 to 62; rt.int_wrap's add, subtract and multiply
/// wrap. Left alone: sized integers (bits), and a value with a landing
/// check (pad), whose branch refers to it (folding one broke the
/// module's verification: tzrules.set_offset, a release of a value not
/// held).
fn fold_consts(var f: ssa.Func, types: List[ssa.SType]) {
  var again = true
  var rounds = 0
  while again && rounds < 4 {
    again = false
    rounds += 1
    for bi in 0..f.blocks.len() {
      for v in f.blocks[bi].instrs {
        let x = f.values[v]
        if x.pad >= 0 || x.ty < 0 || x.ty >= types.len() || types[x.ty].kind != ssa.Kind.Int || types[x.ty].bits != 0 {
          continue
        }
        if let Some(r) = fold_value(f, x) {
          f.values[v] = ssa.Value{op: ssa.Op.Const, ty: x.ty, aux: ssa.Aux.I(n: r), block: x.block}
          again = true
        }
      }
    }
  }
}

/// v through parameters of blocks with one predecessor (the argument
/// that predecessor's edge passes).
fn param_source(f: ssa.Func, v0: Int) -> Int {
  var v = v0
  for _ in 0..8 {
    let x = f.values[v]
    if x.op != ssa.Op.Param || x.block <= 0 || f.blocks[x.block].preds.len() != 1 {
      return v
    }
    let bl = f.blocks[x.block]
    var k = -1
    for (i, p) in bl.params.indexed() {
      if p == v {
        k = i
      }
    }
    let e = f.edges[bl.preds[0]]
    if k < 0 || k >= e.args.len() {
      return v
    }
    v = e.args[k]
  }
  v
}

/// The integer v is when it is a constant or folds to one.
fn const_value(f: ssa.Func, v: Int) -> Int? {
  if let Some(n) = const_int(f, v) {
    return Some(n)
  }
  fold_value(f, f.values[v])
}

/// The integer constant v is, if it is one.
fn const_int(f: ssa.Func, v: Int) -> Int? {
  let x = f.values[v]
  if x.op != ssa.Op.Const {
    return None
  }
  match x.aux {
    I(n) => Some(n)
    _ => None
  }
}

/// The constant value of x when its operands are constants and the
/// operation cannot fault.
fn fold_value(f: ssa.Func, x: ssa.Value) -> Int? {
  if x.op == ssa.Op.Call && aux_str(x.aux) == "Str.len" && x.args.len() == 1 {
    // a literal's length (a callee's p.len() of a literal argument:
    // scan.eq_text's word count, 2026-10-23)
    let s = f.values[param_source(f, x.args[0])]
    if s.op == ssa.Op.Const {
      if let Some(bs) = const_bytes(s.aux) {
        return Some(bs.len())
      }
    }
    return None
  }
  if x.op == ssa.Op.Call {
    if aux_str(x.aux) != "rt.int_wrap" || x.args.len() != 3 {
      return None
    }
    let op = const_int(f, x.args[0])?
    let a = const_int(f, x.args[1])?
    let b = const_int(f, x.args[2])?
    return match op {
      0 => Some(a.wrapping_add(b))
      1 => Some(a.wrapping_sub(b))
      2 => Some(a.wrapping_mul(b))
      _ => None
    }
  }
  if x.op == ssa.Op.Neg && x.args.len() == 1 {
    let a = const_int(f, x.args[0])?
    return 0.checked_sub(a)
  }
  if x.args.len() != 2 || !(x.op is ssa.Op.Add | ssa.Op.Sub | ssa.Op.Mul | ssa.Op.And | ssa.Op.Or | ssa.Op.Xor | ssa.Op.Shl | ssa.Op.Shr) {
    return None
  }
  let a = const_int(f, x.args[0])?
  let b = const_int(f, x.args[1])?
  match x.op {
    Add => a.checked_add(b)
    Sub => a.checked_sub(b)
    Mul => a.checked_mul(b)
    And => Some(a & b)
    Or => Some(a | b)
    Xor => Some(a ^ b)
    Shl => if b < 0 || b > 62 { None } else { a.checked_mul(1 << b) }
    Shr => if b < 0 || b > 62 { None } else { Some(a >> b) }
    _ => None
  }
}

fn find_call(f: ssa.Func, m: ssa.Module, small: Map[Str, Bool], by_name: Map[Str, Int]) -> Int {
  for bl in f.blocks {
    for v in bl.instrs {
      let x = f.values[v]
      if x.op != ssa.Op.Call {
        continue
      }
      let name = aux_str(x.aux)
      // never f itself, as find_closure_call and find_loop_call: a call of
      // f appears in f once a closure that calls it is inlined (generics'
      // count[T] through fold's callback), which the inlinable sets' cycle
      // walk cannot see, and inline_one holds f out of m.funcs
      if !small.contains(name) || name == f.name {
        continue
      }
      let ci = by_name.get(name) ?? -1
      if ci >= 0 && m.funcs[ci].catches && !catch_inlinable(x, m.funcs[ci], m) {
        continue
      }
      if x.pad < 0 {
        return v
      }
      if m.funcs[ci].results.len() == 1 {
        return v
      }
    }
  }
  -1
}

/// A call of a function of padded that passes a closure literal made in
/// f (decision 0256: inlined, its call of the closure becomes direct and
/// is inlined in turn: hof's map and filter), find_call's rules
/// otherwise; else -1.
fn find_closure_call(f: ssa.Func, m: ssa.Module, padded: Map[Str, Bool], by_name: Map[Str, Int]) -> Int {
  for bl in f.blocks {
    for v in bl.instrs {
      let x = f.values[v]
      if x.op != ssa.Op.Call || !padded.contains(aux_str(x.aux)) || aux_str(x.aux) == f.name {
        continue
      }
      var closure = false
      for a in x.args {
        let y = f.values[a]
        closure = closure || (y.op == ssa.Op.Closure && y.args.is_empty())
      }
      if !closure {
        continue
      }
      let ci = by_name.get(aux_str(x.aux)) ?? -1
      if ci >= 0 && m.funcs[ci].catches && !catch_inlinable(x, m.funcs[ci], m) {
        continue
      }
      if x.pad < 0 {
        return v
      }
      if m.funcs[ci].results.len() == 1 {
        return v
      }
    }
  }
  -1
}

/// A call of a function of loopy inside a loop of f (find_call's rules
/// otherwise), else -1.
fn find_loop_call(f: ssa.Func, m: ssa.Module, loopy: Map[Str, Bool], by_name: Map[Str, Int]) -> Int {
  for (bi, bl) in f.blocks.indexed() {
    var looped = -1
    for v in bl.instrs {
      let x = f.values[v]
      if x.op != ssa.Op.Call || !loopy.contains(aux_str(x.aux)) || aux_str(x.aux) == f.name {
        continue
      }
      if looped < 0 {
        looped = if in_loop(f, bi) { 1 } else { 0 }
      }
      if looped == 0 {
        break
      }
      let ci = by_name.get(aux_str(x.aux)) ?? -1
      if ci >= 0 && m.funcs[ci].catches && !catch_inlinable(x, m.funcs[ci], m) {
        continue
      }
      if x.pad < 0 {
        return v
      }
      if m.funcs[ci].results.len() == 1 {
        return v
      }
    }
  }
  -1
}

/// Whether call x of callee g, a closure that catches its faults
/// (Func.catches: Map.update's, with a var parameter), may be inlined
/// (decision 0317): its parameters hold no heap memory, x lands (the caller already goes on unwinding from
/// the landing, and writes the new value only after the call returns),
/// every landing of g only reaches g's unwind exit, which hands back the
/// value it was given, and the exit makes only that and the zero
/// results: no cleanup on the way or there, so in the copy the call's
/// landing does the same. Otherwise a fault in the copy would run
/// g's cleanup and return normally into the caller.
fn catch_inlinable(x: ssa.Value, g: ssa.Func, m: ssa.Module) -> Bool {
  if x.pad < 0 || g.unwind_exit < 0 {
    return false
  }
  // its parameters (but the closure, parameter 0) hold no heap memory:
  // the exit hands the var parameter back, so an owned one (a Map
  // updated in place) would still be held on the copy's way to the
  // call's landing, where the call's other ways hold it no more
  // (TestGoldenRun/maps under XO_INLINE_STRICT=1: nested.update's
  // fn(var inner))
  for (i, p) in g.blocks[0].params.indexed() {
    if i >= 1 && m.heap(g.values[p].ty) {
      return false
    }
  }
  // the exit itself only makes the zero results and the handed back
  // value and returns: a release there (insert_rc places one for an
  // owned parameter or a value live into the shared exit) would be
  // skipped in the copy, whose faults never reach it (Xo Lang 2's
  // review, 2026-10-21)
  for v in g.blocks[g.unwind_exit].instrs {
    let y = g.values[v]
    let pure = match y.op {
      Const | Struct | Tuple | Variant | Undef | Field | Return => true
      Call => aux_str(y.aux).starts_with("rt.") && aux_str(y.aux).ends_with("_empty")
      _ => false
    }
    if !pure {
      return false
    }
  }
  for bl in g.blocks {
    for v in bl.instrs {
      let y = g.values[v]
      if y.pad < 0 {
        continue
      }
      if !hands_back(g, y.pad) {
        return false
      }
    }
  }
  true
}

/// Whether landing value p of g (a check `br p, cleanup, rest`) goes
/// from its cleanup block straight to g's unwind exit: blocks that only
/// jump, without parameters, at most 16.
fn hands_back(g: ssa.Func, p: Int) -> Bool {
  if g.unwind_exit < 0 {
    return false
  }
  var start = -1
  for bl in g.blocks {
    for v in bl.instrs {
      let y = g.values[v]
      if y.op == ssa.Op.Branch && y.args.len() >= 1 && y.args[0] == p {
        start = g.edges[y.succs[0]].to
      }
    }
  }
  if start < 0 {
    return false
  }
  var b = start
  for _ in 0..16 {
    if b == g.unwind_exit {
      return true
    }
    let ins = g.blocks[b].instrs
    if ins.len() != 1 || !g.blocks[b].params.is_empty() || g.values[ins[0]].op != ssa.Op.Jump || !g.edges[g.values[ins[0]].succs[0]].args.is_empty() {
      return false
    }
    b = g.edges[g.values[ins[0]].succs[0]].to
  }
  false
}

/// An edge of the copy whose arguments are mapped after all bodies.
struct Pending {
  e: Int
  args: List[Int]
}

fn inline_call(var f: ssa.Func, call: Int, callee: ssa.Func) {
  let b = f.values[call].block
  let ins = f.blocks[b].instrs
  var at = -1
  for (i, v) in ins.indexed() {
    if v == call {
      at = i
    }
  }
  // the continuation takes the rest of b
  let cont = f.new_block()
  let rest = ins[at + 1..ins.len()]
  f.blocks[b].instrs = ins[0..at]
  for v in rest {
    f.values[v].block = cont
    for e in f.values[v].succs {
      f.edges[e].from = cont
    }
  }
  var res: List[Int] = []
  for r in callee.results {
    res.push(f.add_param(cont, r))
  }
  var repl = -1
  if res.len() == 1 {
    repl = res[0]
  } else {
    repl = f.add(cont, ssa.Op.Tuple, f.values[call].ty, ssa.Aux.None, res)
  }
  for v in rest {
    f.blocks[cont].instrs.push(v)
  }
  replace_uses(f, call, repl)

  // the call's inline site, and the callee's own sites under it
  // (decision 0239: the line tables' inlined frames)
  let site = f.inl_sites.len()
  f.inl_sites.push(ssa.InlSite{callee: callee.name, file: callee.file, call_line: f.values[call].line, parent: f.values[call].inl})
  var smap: List[Int] = []
  for cs in callee.inl_sites {
    smap.push(f.inl_sites.len())
    f.inl_sites.push(ssa.InlSite{callee: cs.callee, file: cs.file, call_line: cs.call_line, parent: -1})
  }
  for (k, cs) in callee.inl_sites.indexed() {
    f.inl_sites[smap[k]].parent = if cs.parent >= 0 { smap[cs.parent] } else { site }
  }
  // the callee's source variables and binding records (decision 0252),
  // after the copy below has mapped its values
  let dv0 = f.dvars.len()
  for d in callee.dvars {
    f.dvars.push(ssa.DVar{name: d.name, ty: d.ty, line: d.line, param: d.param, inl: if d.inl >= 0 && d.inl < smap.len() { smap[d.inl] } else { site }})
  }
  // copy the callee
  var vm: Map[Int, Int] = {}
  let cparams = callee.blocks[0].params
  for (i, p) in cparams.indexed() {
    vm[p] = f.values[call].args[i]
  }
  let order = rpo_of(callee)
  var bm: Map[Int, Int] = {}
  for cb in order {
    let nb = f.new_block()
    bm[cb] = nb
    if cb != 0 {
      for p in callee.blocks[cb].params {
        vm[p] = f.add_param(nb, callee.values[p].ty)
      }
    }
  }
  let pad = f.values[call].pad
  var pads: List[(Int, Int)] = []
  var edges: List[Pending] = []
  for cb in order {
    let nb = bm.get(cb) ?? -1
    for v in callee.blocks[cb].instrs {
      let x = callee.values[v]
      match x.op {
        Jump => {
          let to = callee.edges[x.succs[0]].to
          let t = f.jump(nb, bm.get(to) ?? -1, [])
          edges.push(Pending{e: f.values[t].succs[0], args: callee.edges[x.succs[0]].args})
        }
        Branch => {
          let s0 = callee.edges[x.succs[0]]
          let s1 = callee.edges[x.succs[1]]
          let t = f.branch(nb, vm.get(x.args[0]) ?? x.args[0], bm.get(s0.to) ?? -1, bm.get(s1.to) ?? -1)
          edges.push(Pending{e: f.values[t].succs[0], args: s0.args})
          edges.push(Pending{e: f.values[t].succs[1], args: s1.args})
        }
        Return => {
          let t = f.jump(nb, cont, [])
          edges.push(Pending{e: f.values[t].succs[0], args: x.args})
        }
        _ => {
          var args: List[Int] = []
          for a in x.args {
            args.push(vm.get(a) ?? a)
          }
          let nv = f.add(nb, x.op, x.ty, x.aux, args)
          f.values[nv].pos = x.pos
          // the callee's own line in its file, at its site (decision
          // 0239); a value with no line, or of generated code, takes the
          // call's
          if x.line != 0 && !callee.file.is_empty() {
            f.values[nv].line = x.line
            f.values[nv].inl = if x.inl >= 0 && x.inl < smap.len() { smap[x.inl] } else { site }
          } else {
            f.values[nv].line = f.values[call].line
            f.values[nv].inl = f.values[call].inl
          }
          // a fault in the copy lands where one in the call would
          // (decision 0085), unless the callee gave it a landing of its own
          // (decision 0256): then the copy of that check, set below once
          // every value is copied (a check comes after what it guards)
          f.values[nv].pad = pad
          if x.pad >= 0 {
            pads.push((nv, x.pad))
          }
          vm[v] = nv
        }
      }
    }
  }
  for p in edges {
    var args: List[Int] = []
    for a in p.args {
      args.push(vm.get(a) ?? a)
    }
    f.edges[p.e].args = args
  }
  for (nv, cp) in pads {
    // a closure that catches its faults hands back the value it was
    // given and the caller goes on unwinding from the call's landing
    // (the caller writes the new value only after the call returns): its
    // own landings, which only reach its unwind exit (catch_inlinable),
    // are the call's landing in the copy (decision 0317)
    f.values[nv].pad = if callee.catches { pad } else { vm.get(cp) ?? pad }
  }
  for d in callee.dbinds {
    if let Some(nv) = vm.get(d.value) {
      f.dbinds.push(ssa.DBind{dvar: dv0 + d.dvar, value: nv, line: d.line})
    }
  }
  // the payloads that took their enum's ownership (Func.moved)
  for (k, _) in callee.moved {
    if let Some(nv) = vm.get(k) {
      f.moved[nv] = true
    }
  }
  let _j = f.jump(b, bm.get(0) ?? -1, [])
}

/// Replaces every use of old in f by x, binding records too (decision
/// 0252).
fn replace_uses(var f: ssa.Func, old: Int, x: Int) {
  for k in 0..f.dbinds.len() {
    if f.dbinds[k].value == old {
      f.dbinds[k].value = x
    }
  }
  for bl in 0..f.blocks.len() {
    for v in f.blocks[bl].instrs {
      for i in 0..f.values[v].args.len() {
        if f.values[v].args[i] == old {
          f.values[v].args[i] = x
        }
      }
      for e in f.values[v].succs {
        for i in 0..f.edges[e].args.len() {
          if f.edges[e].args[i] == old {
            f.edges[e].args[i] = x
          }
        }
      }
    }
  }
}

/// block_calls, where the list reads emitted in line (list.index,
/// list.len, list.get: a load and, unproven, a compare) and the landing
/// checks (no code of their own) are not calls either: for the join after
/// drop_proven_pads, whose blocks are a load each (decision 0257).
fn block_calls_inline(f: ssa.Func) -> List[Bool] {
  var out: List[Bool] = []
  for bl in f.blocks {
    var c = false
    for v in bl.instrs {
      let x = f.values[v]
      let n = aux_str(x.aux)
      c = c || (x.op == ssa.Op.Call && !inline_intrinsic(n) && !(n is "list.index" | "list.len" | "list.get" | "rt.landing" | "rt.unwinding"))
    }
    out.push(c)
  }
  out
}

/// Whether $XO_INLINE_DENY names f (ssa.Module inline_deny: a name, or a
/// prefix ending in `*`).
fn denied(m: ssa.Module, name: Str) -> Bool {
  for d in m.inline_deny {
    if d == name || (d.ends_with("*") && name.starts_with(d[0..d.len() - 1])) {
      return true
    }
  }
  false
}
