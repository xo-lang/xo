// Local optimizations of instruction selection and MIR (internal/arm64
// opt.go).
//
//   - Per MIR block memos: constants, list lengths, bounds checks done,
//     and element addresses are computed once per block.
//   - Stores of list.set that write back a word loaded from the same
//     address with no store or call in between are dropped.
//   - Dead code: instructions without side effects whose definitions are
//     never used are deleted.

use github.com/xo-lang/xo/compiler/ssa

/// The memo of the current block (s.m()): its index. The current memo
/// is kept in g.cm, out of the list (an update of a map inside a list
/// element copies the map on the native backends,
/// gotchas/xo-native-nested-element-update.md); memo_at reads any memo.
fn (var g: G) m_() -> Int {
  if g.mm < 0 || g.cm.blk != g.cur {
    g.flush_memo()
    g.memos.push(Memo{blk: -2})
    g.mm = g.memos.len() - 1
    g.cm = Memo{blk: g.cur}
  }
  g.mm
}

/// Stores the current memo back into the list.
fn (var g: G) flush_memo() {
  if g.mm >= 0 {
    g.memos[g.mm] = g.cm
    g.cm = Memo{blk: -3}
  }
}

/// Forgets the current memo (a landing pad's block starts with none).
fn (var g: G) drop_memo() {
  g.flush_memo()
  g.mm = -1
}

/// Memo i (the current one from g.cm).
fn (g: G) memo_at(i: Int) -> Memo {
  if i == g.mm {
    return g.cm
  }
  g.memos[i]
}

/// Records a store or a call: loads before it may be stale.
fn (var g: G) clobber() {
  let _mi = g.m_()
  g.cm.epoch += 1
}

/// Adds a memory write (uses[1..] are addresses; the value may be xzr).
fn (var g: G) store(text: Str, us: List[Int]) {
  var rs: List[Int] = []
  for (i, u) in us.indexed() {
    if i >= 1 {
      rs.push(g.real(u))
    } else {
      rs.push(u)
    }
  }
  let _i = g.add(Inst{kind: K_PLAIN, text: text, us: rs})
  g.clobber()
}

/// All blocks: the hot ones, then the cold ones.
fn (g: G) all_blocks() -> List[Int] {
  g.hot + g.cold
}

/// b, past up to 16 blocks that only jump (thread's final).
fn (g: G) final_of(b0: Int) -> Int {
  var b = b0
  for _ in 0..16 {
    let ins = g.blocks[b].insts
    if ins.len() != 1 || ins[0].kind != K_JUMP || ins[0].targets[0] == b || ins[0].targets.len() > 1 {
      return b
    }
    b = ins[0].targets[0]
  }
  b
}

/// Retargets branches to blocks that only jump, and drops the blocks
/// nothing reaches.
fn (var g: G) thread() {
  for b in g.all_blocks() {
    let k = g.term_kind(b)
    if k == K_JUMP || k == K_CONDBR || k == K_SWITCH {
      let t = g.blocks[b].insts.len() - 1
      let ts = g.blocks[b].insts[t].targets
      var nts: List[Int] = []
      for x in ts {
        nts.push(g.final_of(x))
      }
      var ins = g.take_insts(b)
      ins[t].targets = nts
      g.put_insts(b, ins)
    }
  }
  // drop blocks nothing reaches
  var seen: List[Bool] = []
  for _ in 0..g.blocks.len() {
    seen.push(false)
  }
  var stack = [g.hot[0]]
  seen[g.hot[0]] = true
  while !stack.is_empty() {
    let b = stack.pop() ?? 0
    for x in g.msuccs(b) {
      if !seen[x] {
        seen[x] = true
        stack.push(x)
      }
    }
  }
  var hot: List[Int] = []
  for b in g.hot {
    if seen[b] {
      hot.push(b)
    }
  }
  var cold: List[Int] = []
  for b in g.cold {
    if seen[b] {
      cold.push(b)
    }
  }
  g.hot = hot
  g.cold = cold
}

fn removable(inst: Inst) -> Bool {
  (inst.kind == K_PLAIN && !inst.has_fault && !inst.keep && !inst.defs.is_empty()) || inst.kind == K_PMOVE
}

/// Deletes instructions without side effects whose definitions nothing
/// live uses, and the parts of parallel moves into dead registers.
///
/// The instruction lists go to dce_mark and dce_dead as parameters, so
/// their elements are borrowed: iterating `g.blocks[b].insts` here
/// copied every Inst (a dup and a drop of each of its heap fields per
/// instruction and pass), and building the kept list of every block
/// copied it again even when nothing was deleted (bench/results/xo1-perf).
fn (var g: G) dce() {
  let blocks = g.all_blocks()
  var lists: List[List[Inst]] = []
  for b in blocks {
    lists.push(g.blocks[b].insts)
  }
  let live = dce_live(lists, g.fp.len())
  // the blocks' lists are unique again before they are rebuilt
  lists = []
  for b in blocks {
    if dce_dead(g.blocks[b].insts, live) {
      var ins = g.take_insts(b)
      dce_keep(ins, live)
      g.put_insts(b, ins)
    }
  }
}

/// dce's liveness over the instruction lists of all blocks, to a fixed
/// point: the uses of every instruction kept (not removable, or with a
/// live definition) and the sources of the live destinations of parallel
/// moves. A worklist over the definition sites of each register that
/// becomes live, where passes over every instruction until none marked
/// anything new took as many passes as the longest chain of moves: the
/// same least fixed point (bench/results/xo1-speed-2026-10-13.md).
fn dce_live(lists: List[List[Inst]], n: Int) -> List[Bool] {
  var live: List[Bool] = List.with_capacity(n)
  var start: List[Int] = List.with_capacity(n + 1)
  for _ in 0..n {
    live.push(false)
    start.push(0)
  }
  start.push(0)
  // the definition sites of register v are site_l, site_i, site_k at
  // start[v] .. start[v + 1] (list, instruction, position in its defs)
  for l in lists {
    dce_count_defs(l, start)
  }
  for v in 0..n {
    start[v + 1] = start[v + 1] + start[v]
  }
  let total = start[n]
  var fill: List[Int] = List.with_capacity(n)
  for v in 0..n {
    fill.push(start[v])
  }
  var site_l: List[Int] = List.with_capacity(total)
  var site_i: List[Int] = List.with_capacity(total)
  var site_k: List[Int] = List.with_capacity(total)
  for _ in 0..total {
    site_l.push(0)
    site_i.push(0)
    site_k.push(0)
  }
  var stack: List[Int] = []
  for li in 0..lists.len() {
    dce_sites(lists[li], li, fill, site_l, site_i, site_k)
    dce_roots(lists[li], live, stack)
  }
  while !stack.is_empty() {
    let v = stack.pop() ?? 0
    for j in start[v]..start[v + 1] {
      dce_reach(lists[site_l[j]], site_i[j], site_k[j], live, stack)
    }
  }
  live
}

/// Counts the definitions of each register v of insts into start[v + 1].
fn dce_count_defs(insts: List[Inst], var start: List[Int]) {
  for inst in insts {
    for d in inst.defs {
      start[d + 1] = start[d + 1] + 1
    }
  }
}

/// Records the definition sites of the instructions of list li.
fn dce_sites(insts: List[Inst], li: Int, var fill: List[Int], var site_l: List[Int], var site_i: List[Int], var site_k: List[Int]) {
  for i in 0..insts.len() {
    var k = 0
    for d in insts[i].defs {
      let at = fill[d]
      site_l[at] = li
      site_i[at] = i
      site_k[at] = k
      fill[d] = at + 1
      k += 1
    }
  }
}

/// Marks the uses of the instructions of insts that are kept whatever is
/// live: neither parallel moves nor removable.
fn dce_roots(insts: List[Inst], var live: List[Bool], var stack: List[Int]) {
  for inst in insts {
    if inst.kind == K_PMOVE || removable(inst) {
      continue
    }
    dce_use(inst.us, live, stack)
  }
}

/// Definition k of instruction i of insts became live: a parallel move
/// makes its source live, another instruction is kept and makes its uses
/// live.
fn dce_reach(insts: List[Inst], i: Int, k: Int, var live: List[Bool], var stack: List[Int]) {
  if insts[i].kind == K_PMOVE {
    let a = insts[i].srcs[k]
    if a.kind == S_REG && !live[a.v] {
      live[a.v] = true
      stack.push(a.v)
    }
    return
  }
  dce_use(insts[i].us, live, stack)
}

fn dce_use(us: List[Int], var live: List[Bool], var stack: List[Int]) {
  for u in us {
    if !live[u] {
      live[u] = true
      stack.push(u)
    }
  }
}

/// Whether dce_keep would change insts: a removable instruction with
/// every definition dead, or a parallel move with a dead destination.
fn dce_dead(insts: List[Inst], live: List[Bool]) -> Bool {
  for inst in insts {
    if inst.kind == K_PMOVE {
      for d in inst.defs {
        if !live[d] {
          return true
        }
      }
      continue
    }
    if removable(inst) {
      var dead = true
      for d in inst.defs {
        dead = dead && !live[d]
      }
      if dead {
        return true
      }
    }
  }
  false
}

/// Drops the dead instructions of insts, and the dead destinations of
/// its parallel moves. The instructions move out (pop) and back, so a
/// kept one is not copied: building a new list dup'd every kept
/// instruction's lists and strings and freeing the old one dropped them
/// again (bench/results/xo1-speed-2026-10-13.md).
fn dce_keep(var insts: List[Inst], live: List[Bool]) {
  // the kept instructions, last first
  var rev: List[Inst] = List.with_capacity(insts.len())
  while !insts.is_empty() {
    match insts.pop() {
      Some(x0) => {
        var x = x0
        if x.kind == K_PMOVE {
          var all = true
          for d in x.defs {
            all = all && live[d]
          }
          if !all || x.defs.is_empty() {
            var defs: List[Int] = []
            var srcs: List[Src] = []
            for i in 0..x.defs.len() {
              if live[x.defs[i]] {
                defs.push(x.defs[i])
                srcs.push(x.srcs[i])
              }
            }
            if defs.is_empty() {
              continue
            }
            var us: List[Int] = []
            for a in srcs {
              if a.kind == S_REG && a.v != 0 {
                us.push(a.v)
              }
            }
            x.defs = defs
            x.srcs = srcs
            x.us = us
          }
          rev.push(x)
          continue
        }
        if removable(x) {
          var dead = true
          for d in x.defs {
            dead = dead && !live[d]
          }
          if dead {
            continue
          }
        }
        rev.push(x)
      }
      None => {}
    }
  }
  while !rev.is_empty() {
    match rev.pop() {
      Some(x) => insts.push(x)
      None => {}
    }
  }
}

/// Starts the memo of the current block from memo from, of a block that
/// dominates it.
fn (var g: G) inherit(from: Int) {
  let src = g.memo_at(from)
  var m = Memo{blk: g.cur, epoch: src.epoch, lo: src.lo, hi: src.hi, low_zero: src.low_zero, less: src.less, quo: src.quo,
    lens: src.lens, checked: src.checked, bases: src.bases, loaded: src.loaded, cs: src.cs, len_at: src.len_at}
  for (k, v) in src.ci {
    // a constant one instruction makes is not worth a register across
    // blocks (and a fresh one coalesces with a block parameter)
    if k >= -65536 && k < 65536 {
      continue
    }
    m.ci[k] = v
  }
  for (k, v) in src.cf {
    if k == 0 {
      continue
    }
    m.cf[k] = v
  }
  g.flush_memo()
  g.memos.push(Memo{blk: -2})
  g.mm = g.memos.len() - 1
  g.cm = m
}

/// Adds the facts of memo from (bounds, relations, passed checks) to the
/// current memo, for a block that from's block reaches on every path
/// that runs but does not dominate in the control flow graph
/// (join_source). The registers from's block computed (constants,
/// lengths, addresses, loads, quotients) are not taken: a path the graph
/// has but execution never takes would read them before they are written
/// (opt.go joinFacts, gotchas/arm64-vreg-read-before-write-break-flag.md).
fn (var g: G) join_facts(from: Int) {
  let _mi = g.m_()
  let src = g.memo_at(from)
  for (k, v) in src.less {
    g.cm.less[k] = v
  }
  for (k, v) in src.checked {
    g.cm.checked[k] = v
  }
  for (k, v) in src.lo {
    if let Some(o) = g.cm.lo.get(k) {
      if v <= o {
        continue
      }
    }
    g.cm.lo[k] = v
  }
  for (k, v) in src.hi {
    if let Some(o) = g.cm.hi.get(k) {
      if v >= o {
        continue
      }
    }
    g.cm.hi[k] = v
  }
  for (k, v) in src.low_zero {
    if let Some(o) = g.cm.low_zero.get(k) {
      if v <= o {
        continue
      }
    }
    g.cm.low_zero[k] = v
  }
  // a list's length is the same here (the join only branches; decision
  // 0208)
  for (l, n) in src.len_at {
    if !g.cm.lens.contains(l) {
      g.cm.len_at[l] = n
    }
  }
  for (l, n) in src.lens {
    if !g.cm.lens.contains(l) {
      g.cm.len_at[l] = n
    }
  }
}

// ---------------------------------------------------------------------------
// Bounds: a block whose only predecessor ends in `br (x < y)` knows x < y
// on the edge it is reached by. A checked add or subtract of a constant
// whose bounds prove it cannot overflow is not checked.

/// What is known of Int value v.
fn (var g: G) bounds(v: Int) -> (Int, Int) {
  g.bounds_at(v, BOUNDS_DEPTH)
}

/// How many operations deep bounds derives an interval from the
/// operands' bounds (decision 0184): the range analysis ignores
/// branches, so `(r - 128) * 3` under `r < 2048` learns its bound here.
const BOUNDS_DEPTH = 3

fn (var g: G) bounds_at(v: Int, d: Int) -> (Int, Int) {
  let (n, ok) = g.const_int(v)
  if ok {
    return (n, n)
  }
  let r = g.ssa_range(v) // ranges.xo
  var lo = r.lo
  var hi = r.hi
  if d > 0 {
    let (x, xok) = g.derived(v, d - 1)
    if xok {
      lo = imax(lo, x.lo)
      hi = imin(hi, x.hi)
    }
  }
  if !g.has_val[v] || g.vals[v].len() != 1 {
    return (lo, hi)
  }
  let w = g.vals[v][0]
  let _mi = g.m_()
  if let Some(x) = g.cm.lo.get(w) {
    lo = imax(lo, x)
  }
  if let Some(x) = g.cm.hi.get(w) {
    hi = imin(hi, x)
  }
  (lo, hi)
}

/// The bounds of v as an interval (bounds_at).
fn (var g: G) bounds_iv(v: Int, d: Int) -> Interval {
  let (lo, hi) = g.bounds_at(v, d)
  Interval{lo: lo, hi: hi}
}

/// The interval of the Int operation v from its operands' bounds
/// (derived d more levels deep). Every operation is exact, as in
/// range_of; a shift left only counts when it is checked.
fn (var g: G) derived(v: Int, d: Int) -> (Interval, Bool) {
  let x = g.f.values[v]
  let none = (Interval{lo: 0, hi: 0}, false)
  if x.ty < 0 || g.kind(x.ty) != ssa.Kind.Int {
    return none
  }
  match x.op {
    Add => {
      let a = g.bounds_iv(x.args[0], d)
      let b = g.bounds_iv(x.args[1], d)
      (Interval{lo: sat_add(a.lo, b.lo), hi: sat_add(a.hi, b.hi)}, true)
    }
    Sub => {
      let a = g.bounds_iv(x.args[0], d)
      let b = g.bounds_iv(x.args[1], d)
      if b.lo == MIN_INT {
        return none
      }
      (Interval{lo: sat_add(a.lo, -b.hi), hi: sat_add(a.hi, -b.lo)}, true)
    }
    Mul => {
      let a = g.bounds_iv(x.args[0], d)
      let b = g.bounds_iv(x.args[1], d)
      let c0 = sat_mul(a.lo, b.lo)
      let c1 = sat_mul(a.lo, b.hi)
      let c2 = sat_mul(a.hi, b.lo)
      let c3 = sat_mul(a.hi, b.hi)
      (Interval{lo: imin(imin(c0, c1), imin(c2, c3)), hi: imax(imax(c0, c1), imax(c2, c3))}, true)
    }
    Div => {
      let (k, ok) = g.const_int(x.args[1])
      if !ok || k <= 0 {
        return none
      }
      let a = g.bounds_iv(x.args[0], d)
      (Interval{lo: a.lo / k, hi: a.hi / k}, true)
    }
    And => {
      let a = g.bounds_iv(x.args[0], d)
      let b = g.bounds_iv(x.args[1], d)
      if a.lo >= 0 && b.lo >= 0 {
        return (Interval{lo: 0, hi: imin(a.hi, b.hi)}, true)
      }
      if a.lo >= 0 {
        return (Interval{lo: 0, hi: a.hi}, true)
      }
      if b.lo >= 0 {
        return (Interval{lo: 0, hi: b.hi}, true)
      }
      none
    }
    Or => {
      let a = g.bounds_iv(x.args[0], d)
      let b = g.bounds_iv(x.args[1], d)
      if a.lo >= 0 && b.lo >= 0 {
        return (Interval{lo: imax(a.lo, b.lo), hi: ones(imax(a.hi, b.hi))}, true)
      }
      none
    }
    Shr => {
      let (k, ok) = g.const_int(x.args[1])
      if !ok || k < 0 || k > 63 {
        return none
      }
      let a = g.bounds_iv(x.args[0], d)
      (Interval{lo: a.lo >> k, hi: a.hi >> k}, true)
    }
    Shl => {
      let (k, ok) = g.const_int(x.args[1])
      if !ok || k < 0 || k > 62 || x.pos.is_empty() {
        return none
      }
      let a = g.bounds_iv(x.args[0], d)
      (Interval{lo: sat_mul(a.lo, 1 << k), hi: sat_mul(a.hi, 1 << k)}, true)
    }
    IntConv => (g.bounds_iv(x.args[0], d), true)
    Call => {
      if aux_str(x.aux) != "Str.len" || x.args.is_empty() {
        return none
      }
      let y = g.f.values[x.args[0]]
      if y.op == ssa.Op.Const {
        if let Some(bs) = const_bytes(y.aux) {
          return (Interval{lo: bs.len(), hi: bs.len()}, true)
        }
      }
      none
    }
    _ => none
  }
}

/// The smallest 2^k - 1 at least x (x >= 0): a bound of x | y for x, y
/// in [0, x].
fn ones(x: Int) -> Int {
  var r = 0
  while r < x {
    r = (r << 1) | 1
  }
  r
}

/// Whether 0 <= i < n is known, n a length in a register (decision
/// 0184): from i's bounds and n's constant value k (-1 when not
/// constant), or from a fact x < n of the memo where x and i are one
/// value plus offsets whose bounds put i at or below x.
fn (var g: G) proved_index(i: Int, n: Int, k: Int) -> Bool {
  let (lo, hi) = g.bounds(i)
  if lo < 0 {
    return false
  }
  if k >= 0 && hi < k {
    return true
  }
  let _mn = g.m_()
  if let Some(nlo) = g.cm.lo.get(n) {
    if hi < nlo {
      return true
    }
  }
  let fi = g.add_forms(i)
  let _mi = g.m_()
  let facts = g.cm.less
  for (key, x) in facts {
    if key.1 != n {
      continue
    }
    for b in g.add_forms(x) {
      for a in fi {
        if a.base == b.base && (a.hi <= b.lo || (a.off >= 0 && a.off == b.off)) {
          return true
        }
      }
    }
  }
  false
}

/// A value is base plus an offset in [lo, hi] (the value off, or -1).
struct AddForm {
  base: Int
  lo: Int
  hi: Int
  off: Int
}

/// The ways Int value v is a value plus an offset: v plus 0; for v =
/// a + b, a plus b and b plus a; for v = a - c (c constant), a plus -c.
fn (var g: G) add_forms(v: Int) -> List[AddForm] {
  var out = [AddForm{base: v, lo: 0, hi: 0, off: -1}]
  let x = g.f.values[v]
  if x.op == ssa.Op.Add {
    let (alo, ahi) = g.bounds(x.args[0])
    let (blo, bhi) = g.bounds(x.args[1])
    out.push(AddForm{base: x.args[0], lo: blo, hi: bhi, off: x.args[1]})
    out.push(AddForm{base: x.args[1], lo: alo, hi: ahi, off: x.args[0]})
  } else if x.op == ssa.Op.Sub {
    let (c, ok) = g.const_int(x.args[1])
    if ok && c != MIN_INT {
      out.push(AddForm{base: x.args[0], lo: -c, hi: -c, off: -1})
    }
  }
  out
}

/// Records x < y for SSA value x (one register) and register y.
fn (var g: G) less_fact(x: Int, y: Int) {
  if !g.has_val[x] || g.vals[x].len() != 1 || g.vals[x][0] == 0 || y == 0 || g.vkind(x) != ssa.Kind.Int {
    return
  }
  let w = g.vals[x][0]
  let _mi = g.m_()
  g.cm.less[(w, y)] = x
}

/// Whether a + b (Add) or a - b (Sub) cannot overflow for a in [alo,
/// ahi] and b in [blo, bhi] (decision 0184).
fn safe_add_range(o: ssa.Op, alo: Int, ahi: Int, blo0: Int, bhi0: Int) -> Bool {
  var blo = blo0
  var bhi = bhi0
  if o == ssa.Op.Sub {
    if blo == MIN_INT {
      return false
    }
    blo = -bhi0
    bhi = -blo0
  }
  if bhi > 0 && ahi > MAX_INT - bhi {
    return false
  }
  if blo < 0 && alo < MIN_INT - blo {
    return false
  }
  true
}

fn negate_cmp(o: ssa.Op) -> ssa.Op {
  match o {
    Lt => ssa.Op.Ge
    Ge => ssa.Op.Lt
    Le => ssa.Op.Gt
    Gt => ssa.Op.Le
    Eq => ssa.Op.Ne
    _ => ssa.Op.Eq
  }
}

fn swap_cmp(o: ssa.Op) -> ssa.Op {
  match o {
    Lt => ssa.Op.Gt
    Gt => ssa.Op.Lt
    Le => ssa.Op.Ge
    Ge => ssa.Op.Le
    _ => o
  }
}

/// Records the bounds the branch into b (its only predecessor's
/// terminator) implies.
fn (var g: G) branch_facts(b: Int) {
  let t = g.f.term(g.f.edges[g.f.blocks[b].preds[0]].from)
  if t < 0 || g.op(t) != ssa.Op.Branch {
    return
  }
  let tv = g.f.values[t]
  let yes = g.f.edges[tv.succs[0]].to == b
  let no = g.f.edges[tv.succs[1]].to == b
  if yes == no {
    return
  }
  g.cond_facts(tv.args[0], yes)
}

/// Matches b entered only from a block J with one parameter r and
/// nothing but a branch on r, reached with an r that can take b's edge
/// from one predecessor p only (the join of `x && y` or `x || y`):
/// (p, what p passes, the truth b's edge needs, true) (opt.go
/// joinSource, decision 0184).
fn (g: G) join_source(b: Int) -> (Int, Int, Bool, Bool) {
  let none = (-1, -1, false, false)
  let preds = g.f.blocks[b].preds
  if preds.len() != 1 {
    return none
  }
  let j = g.f.edges[preds[0]].from
  let t = g.f.term(j)
  let jb = g.f.blocks[j]
  if t < 0 || g.op(t) != ssa.Op.Branch || jb.instrs.len() != 1 || jb.params.len() != 1 || g.arg(t, 0) != jb.params[0] || j == b {
    return none
  }
  let tv = g.f.values[t]
  let yes = g.f.edges[tv.succs[0]].to == b
  let no = g.f.edges[tv.succs[1]].to == b
  if yes == no {
    return none
  }
  var p = -1
  var c = -1
  for e in jb.preds {
    let a = g.f.edges[e].args[0]
    let av = g.f.values[a]
    if av.op == ssa.Op.Const {
      match av.aux {
        B(k) => {
          if k != yes {
            continue
          }
        }
        _ => {}
      }
    }
    if p >= 0 {
      return none
    }
    p = g.f.edges[e].from
    c = a
  }
  if p < 0 || g.end_memo[p] < 0 {
    return none
  }
  (p, c, yes, true)
}

/// Records what Bool c being truth says (a compare of Ints).
fn (var g: G) cond_facts(c: Int, truth: Bool) {
  if !is_compare(g.op(c)) || g.vkind(g.arg(c, 0)) != ssa.Kind.Int {
    return
  }
  var o = g.op(c)
  if !truth {
    o = negate_cmp(o)
  }
  let x = g.arg(c, 0)
  let y = g.arg(c, 1)
  if o == ssa.Op.Lt {
    if g.has_val[y] && g.vals[y].len() == 1 {
      g.less_fact(x, g.vals[y][0])
    }
  } else if o == ssa.Op.Gt {
    if g.has_val[x] && g.vals[x].len() == 1 {
      g.less_fact(y, g.vals[x][0])
    }
  }
  if o == ssa.Op.Eq {
    // x % 2^k == 0: the low k bits of x are zero
    for r in [x, y] {
      if g.rem_test(r) {
        let (k, _) = g.pow2(g.arg(r, 1))
        let a = g.arg(r, 0)
        if g.has_val[a] && g.vals[a].len() == 1 {
          let _mi = g.m_()
          g.cm.low_zero[g.vals[a][0]] = k
        }
      }
    }
  }
  let (xlo, xhi) = g.bounds(x)
  let (ylo, yhi) = g.bounds(y)
  g.narrow(x, o, ylo, yhi)
  g.narrow(y, swap_cmp(o), xlo, xhi)
}

/// Records that x op y holds, y in [ylo, yhi].
fn (var g: G) narrow(x: Int, o: ssa.Op, ylo: Int, yhi: Int) {
  if g.op(x) == ssa.Op.Const {
    return
  }
  if !g.has_val[x] || g.vals[x].len() != 1 || g.vals[x][0] == 0 {
    return
  }
  let w = g.vals[x][0]
  let (lo0, hi0) = g.bounds(x)
  var lo = lo0
  var hi = hi0
  match o {
    Lt => {
      if yhi > MIN_INT {
        hi = imin(hi, yhi - 1)
      }
    }
    Le => hi = imin(hi, yhi)
    Gt => {
      if ylo < MAX_INT {
        lo = imax(lo, ylo + 1)
      }
    }
    Ge => lo = imax(lo, ylo)
    Eq => {
      lo = imax(lo, ylo)
      hi = imin(hi, yhi)
    }
    _ => {}
  }
  let _mi = g.m_()
  g.cm.lo[w] = lo
  g.cm.hi[w] = hi
  // x = a + c (exact): a op y - c (decision 0184)
  if g.op(x) == ssa.Op.Add || g.op(x) == ssa.Op.Sub {
    let (c0, ok) = g.const_int(g.arg(x, 1))
    if ok && c0 != MIN_INT {
      let c = if g.op(x) == ssa.Op.Sub { -c0 } else { c0 }
      g.narrow(g.arg(x, 0), o, sat_add(ylo, -c), sat_add(yhi, -c))
    }
  }
}

/// Whether a + n (or a - n) cannot overflow.
fn (var g: G) safe_add(a: Int, n0: Int, o: ssa.Op) -> Bool {
  var n = n0
  if o == ssa.Op.Sub {
    if n == MIN_INT {
      return false
    }
    n = -n
  }
  let (lo, hi) = g.bounds(a)
  if n >= 0 {
    return hi <= MAX_INT - n
  }
  lo >= MIN_INT - n
}

/// Sends a jump to a block that only tests a register straight to the
/// test's outcome when the jumping block set that register to a constant.
fn (var g: G) thread_const() {
  for p in g.all_blocks() {
    if g.term_kind(p) != K_JUMP {
      continue
    }
    let np = g.blocks[p].insts.len()
    // blocks that only move registers and jump are followed to the test;
    // their moves are copied into p (opt.go threadConst, decision 0184)
    let (j, chain) = g.move_chain(p, g.blocks[p].insts[np - 1].targets[0])
    if g.blocks[j].insts.len() != 1 || g.blocks[j].insts[0].kind != K_CONDBR {
      continue
    }
    let br = g.blocks[j].insts[0]
    if br.us.is_empty() {
      continue // a landing check (decision 0085)
    }
    var r = br.us[0]
    var k = 0
    if br.cond != "cbnz" {
      if br.us.len() != 1 {
        continue
      }
      // exactly `cmp $u0, #<decimal>`
      if !br.text.starts_with("cmp $u0, #") {
        continue
      }
      let rest = br.text.trim_prefix("cmp $u0, #")
      match Int.parse(rest) {
        Some(n) => {
          if "${n}" != rest {
            continue
          }
          k = n
        }
        None => continue
      }
    }
    var val = 0
    var ok = false
    var found = false
    var c = chain.len() - 1
    while c >= 0 && !found {
      for (i, d) in chain[c].defs.indexed() {
        if d != r {
          continue
        }
        let sr = chain[c].srcs[i]
        if sr.kind == S_IMM {
          val = sr.imm
          ok = true
          found = true
        } else if sr.kind == S_REG && sr.v == 0 {
          val = 0
          ok = true
          found = true
        } else if sr.kind == S_REG {
          r = sr.v
        } else {
          found = true
        }
        break
      }
      c -= 1
    }
    if !found {
      let (v0, ok0) = g.const_before(p, np - 1, r)
      val = v0
      ok = ok0
    }
    if !ok {
      continue
    }
    var taken = false
    match br.cond {
      "cbnz" => taken = val != 0
      "eq" => taken = val == k
      "ne" => taken = val != k
      "lt" => taken = val < k
      "le" => taken = val <= k
      "gt" => taken = val > k
      "ge" => taken = val >= k
      _ => continue
    }
    let to = if taken { br.targets[0] } else { br.targets[1] }
    var ins = g.take_insts(p)
    ins[np - 1].targets[0] = to
    if !chain.is_empty() {
      ins = copy_moves(ins, chain)
    }
    g.put_insts(p, ins)
  }
}

/// Follows j0, p's jump target, through blocks that only move registers
/// and jump (at most 8): the first other block and their moves in order
/// (opt.go moveChain, decision 0184).
fn (g: G) move_chain(p: Int, j0: Int) -> (Int, List[Inst]) {
  var j = j0
  var chain: List[Inst] = []
  var steps = 0
  while steps < 8 && j != p && g.blocks[j].insts.len() == 2 && g.blocks[j].insts[0].kind == K_PMOVE &&
    g.blocks[j].insts[1].kind == K_JUMP && g.blocks[j].insts[1].targets.len() == 1 {
    chain.push(g.blocks[j].insts[0])
    let next = g.blocks[j].insts[1].targets[0]
    j = next
    steps += 1
  }
  (j, chain)
}

/// The register whose value r0 holds after the moves of chain, read
/// before them; false when one sets it to anything but a register
/// (opt.go throughMoves).
fn through_moves(chain: List[Inst], r0: Int) -> (Int, Bool) {
  var r = r0
  var c = chain.len() - 1
  while c >= 0 {
    for (i, d) in chain[c].defs.indexed() {
      if d != r {
        continue
      }
      let sr = chain[c].srcs[i]
      if sr.kind != S_REG || sr.v == 0 {
        return (0, false)
      }
      r = sr.v
      break
    }
    c -= 1
  }
  (r, true)
}

/// ins (a block's instructions) with copies of the moves of chain
/// before its terminator (opt.go copyMoves).
fn copy_moves(ins: List[Inst], chain: List[Inst]) -> List[Inst] {
  var out: List[Inst] = []
  for ii in 0..ins.len() - 1 {
    out.push(ins[ii])
  }
  for mv in chain {
    out.push(mv)
  }
  out.push(ins[ins.len() - 1])
  out
}

/// The constant register r holds before instruction end of block p
/// (opt.go constBefore): the last definition of r there is a parallel
/// move of an immediate or of a register that holds one, or a `mov` of a
/// constant.
fn (g: G) const_before(p: Int, end: Int, r: Int) -> (Int, Bool) {
  var k = end - 1
  while k >= 0 {
    let inst = g.blocks[p].insts[k]
    for (i, d) in inst.defs.indexed() {
      if d != r {
        continue
      }
      if inst.kind == K_PMOVE {
        let sr = inst.srcs[i]
        if sr.kind == S_IMM {
          return (sr.imm, true)
        }
        if sr.kind == S_REG && sr.v == 0 {
          return (0, true) // xzr
        }
        if sr.kind == S_REG {
          return g.const_before(p, k, sr.v)
        }
        return (0, false)
      }
      if inst.kind == K_PLAIN && inst.konst && inst.defs.len() == 1 && (inst.text.starts_with("mov $d0, #") || inst.text.starts_with("mov $wd0, #")) {
        // mov_imm's one instruction forms (a w register's zero extends)
        let rest = inst.text.trim_prefix("mov $d0, #").trim_prefix("mov $wd0, #")
        if let Some(n) = Int.parse(rest) {
          if "${n}" == rest {
            return (n, true)
          }
        }
      }
      return (0, false)
    }
    k -= 1
  }
  (0, false)
}

/// Turns `t = cmp ...; cset; r = t; jump J` where J only branches on r
/// into a branch on the comparison itself.
fn (var g: G) thread_cset() {
  let nuses = g.use_counts()
  for p in g.all_blocks() {
    let np = g.blocks[p].insts.len()
    if g.term_kind(p) != K_JUMP || np < 3 || g.blocks[p].insts[np - 1].targets.len() > 1 {
      continue
    }
    let (j, chain) = g.move_chain(p, g.blocks[p].insts[np - 1].targets[0])
    if g.blocks[j].insts.len() != 1 || g.blocks[j].insts[0].kind != K_CONDBR || g.blocks[j].insts[0].cond != "cbnz" || j == p {
      continue
    }
    let (r, traced) = through_moves(chain, g.blocks[j].insts[0].us[0])
    if !traced {
      continue
    }
    let mv = g.blocks[p].insts[np - 2]
    if mv.kind != K_PMOVE {
      continue
    }
    var src = 0
    for (i, d) in mv.defs.indexed() {
      if d == r && mv.srcs[i].kind == S_REG {
        src = mv.srcs[i].v
      }
    }
    if src == 0 {
      continue
    }
    let def = g.blocks[p].insts[np - 3]
    if def.kind != K_PLAIN || def.defs.len() != 1 || def.defs[0] != src || def.has_fault || def.keep {
      continue
    }
    let i = last_index(def.text, "\ncset $d0, ")
    if i < 0 {
      continue
    }
    let cond = def.text[i + 11..def.text.len()]
    if inv_cond(cond).is_empty() {
      continue
    }
    var ins = g.take_insts(p)
    ins[np - 1] = Inst{kind: K_CONDBR, text: def.text[0..i], us: def.us,
      cond: cond, targets: g.blocks[j].insts[0].targets}
    if !chain.is_empty() {
      ins = copy_moves(ins, chain)
    } else if (nuses.get(r) ?? 0) == 1 {
      // only J's branch reads r, and p no longer reaches it: the move
      // (and then the cset, by dce) is dead (decision 0184)
      ins = drop_move(ins, np - 2, r)
    }
    g.put_insts(p, ins)
  }
}

/// The number of uses of each register (opt.go useCounts).
fn (g: G) use_counts() -> Map[Int, Int] {
  var n: Map[Int, Int] = {}
  for b in g.all_blocks() {
    for inst in g.blocks[b].insts {
      for u in inst.us {
        n[u] = (n.get(u) ?? 0) + 1
      }
    }
  }
  n
}

/// ins without the move into r of the parallel move ins[k] (without
/// the instruction when nothing is left; opt.go dropMove).
fn drop_move(ins: List[Inst], k: Int, r: Int) -> List[Inst] {
  let mv = ins[k]
  var defs: List[Int] = []
  var srcs: List[Src] = []
  var us: List[Int] = []
  for (i, d) in mv.defs.indexed() {
    if d == r {
      continue
    }
    defs.push(d)
    srcs.push(mv.srcs[i])
    if mv.srcs[i].kind == S_REG && mv.srcs[i].v != 0 {
      us.push(mv.srcs[i].v)
    }
  }
  var out: List[Inst] = []
  for (i, x) in ins.indexed() {
    if i != k {
      out.push(x)
    } else if !defs.is_empty() {
      var y = x
      y.defs = defs
      y.srcs = srcs
      y.us = us
      out.push(y)
    }
  }
  out
}

/// The byte offset of the last sub in s, or -1.
fn last_index(s: Str, sub: Str) -> Int {
  let n = s.len()
  let k = sub.len()
  var i = n - k
  while i >= 0 {
    if s[i..i + k] == sub {
      return i
    }
    i -= 1
  }
  -1
}

/// The predecessors of every block by the terminators' targets, one
/// entry per target (hoistConsts, placeLatches).
fn (g: G) mpreds_all(blocks: List[Int]) -> List[List[Int]] {
  var preds: List[List[Int]] = []
  for _ in 0..g.blocks.len() {
    preds.push([])
  }
  for b in blocks {
    for t in g.msuccs(b) {
      preds[t].push(b)
    }
  }
  preds
}

/// The natural loops of the back edges a depth first search from b0
/// finds, in the order found: each its header and body (hoistConsts).
fn (g: G) dfs_loops(b0: Int, preds: List[List[Int]]) -> List[(Int, List[Bool])] {
  let nb = g.blocks.len()
  var state: List[Int] = []
  for _ in 0..nb {
    state.push(0)
  }
  var loops: List[(Int, List[Bool])] = []
  var stack: List[(Int, Int)] = [(b0, 0)]
  state[b0] = 1
  while !stack.is_empty() {
    let top = stack.len() - 1
    let (b, i) = stack[top]
    let ss = g.msuccs(b)
    if i >= ss.len() {
      state[b] = 2
      let _p = stack.pop()
      continue
    }
    stack[top] = (b, i + 1)
    let t = ss[i]
    if state[t] == 0 {
      state[t] = 1
      stack.push((t, 0))
    } else if state[t] == 1 {
      var body: List[Bool] = []
      for _ in 0..nb {
        body.push(false)
      }
      body[t] = true
      var work = [b]
      while !work.is_empty() {
        let x = work.pop() ?? 0
        if !body[x] {
          body[x] = true
          for p in preds[x] {
            work.push(p)
          }
        }
      }
      loops.push((t, body))
    }
  }
  loops
}

fn count_true(xs: List[Bool]) -> Int {
  var n = 0
  for x in xs {
    if x {
      n += 1
    }
  }
  n
}

/// Moves the instructions that make constants out of loops, into the
/// loop's preheader, innermost loops first. A constant that feeds a
/// parallel move, a call, or a return stays.
fn (var g: G) hoist_consts() {
  let blocks = g.all_blocks()
  let preds = g.mpreds_all(blocks)
  var moved: Map[Int, Bool] = {}
  for b in blocks {
    for inst in g.blocks[b].insts {
      // a constant a move, call, or return takes is made straight into
      // its register in place
      if inst.kind == K_PMOVE || inst.kind == K_CALL || inst.kind == K_RET {
        for a in inst.srcs {
          if a.kind == S_REG {
            moved[a.v] = true
          }
        }
      }
    }
  }
  var loops = g.dfs_loops(g.hot[0], preds)
  // innermost first: smaller bodies first (the Go emitter's selection
  // sort, which is not stable)
  var sizes: List[Int] = []
  for l in loops {
    sizes.push(count_true(l.1))
  }
  for i in 0..loops.len() {
    for j in i + 1..loops.len() {
      if sizes[j] < sizes[i] {
        let t = loops[i]
        loops[i] = loops[j]
        loops[j] = t
        let ts = sizes[i]
        sizes[i] = sizes[j]
        sizes[j] = ts
      }
    }
  }
  for l in loops {
    let (head, body) = l
    var pre = -1
    for p in preds[head] {
      if body[p] {
        continue
      }
      if pre >= 0 {
        pre = -1
        break
      }
      pre = p
    }
    if pre < 0 || g.term_kind(pre) != K_JUMP {
      continue
    }
    // across a call a constant needs a callee saved register, and a
    // spilled one would be reloaded from the stack: leave loops that call
    // on their hot path alone
    var calls = false
    for b in 0..g.blocks.len() {
      if !body[b] || g.blocks[b].cold {
        continue
      }
      for inst in g.blocks[b].insts {
        calls = calls || inst.kind == K_CALL
      }
    }
    if calls {
      continue
    }
    var hoisted: List[Inst] = []
    for b in blocks {
      if !body[b] {
        continue
      }
      var out: List[Inst] = []
      var any = false
      for inst in g.blocks[b].insts {
        if inst.konst && !moved.contains(inst.defs[0]) {
          hoisted.push(inst)
          any = true
          continue
        }
        out.push(inst)
      }
      if any {
        g.blocks[b].insts = out
      }
    }
    if hoisted.is_empty() {
      continue
    }
    let ins = g.blocks[pre].insts
    let n = ins.len()
    g.blocks[pre].insts = ins[0..n - 1] + hoisted + [ins[n - 1]]
  }
}

/// The mnemonics hoist_invariants moves: arithmetic of registers that
/// reads and writes no memory and no flags and cannot fault.
fn pure_mnemonic(m: Str) -> Bool {
  m is "add" | "sub" | "mul" | "madd" | "msub" | "lsl" | "lsr" | "asr" | "and" | "orr" | "eor" | "sxtw" | "neg" | "mov"
}

/// Moves loop invariant arithmetic out of loops into the preheader, as
/// hoist_consts moves constants: a plain one line instruction of
/// pure_mnemonic whose one definition is its register's only one and
/// whose every use is defined only outside the loop (or by an
/// instruction already moved). Only from the loop's hot blocks, at most
/// HOIST_MAX a loop (each lives across the loop: a register), and not
/// in loops that call on their hot path (hoist_consts' rule). nbody's
/// inner loop recomputed bs[i]'s address each step (2026-10-17,
/// bench/results/amd64-vs-llvm-2026-10-17.md).
fn (var g: G) hoist_invariants() {
  let blocks = g.all_blocks()
  let preds = g.mpreds_all(blocks)
  // each register's definitions and their blocks
  var ndef: Map[Int, Int] = {}
  var defb: Map[Int, List[Int]] = {}
  for b in blocks {
    for inst in g.blocks[b].insts {
      for d in inst.defs {
        ndef[d] = (ndef.get(d) ?? 0) + 1
        var bs = defb.get(d) ?? []
        bs.push(b)
        defb[d] = bs
      }
    }
  }
  var loops = g.dfs_loops(g.hot[0], preds)
  var sizes: List[Int] = []
  for l in loops {
    sizes.push(count_true(l.1))
  }
  for i in 0..loops.len() {
    for j in i + 1..loops.len() {
      if sizes[j] < sizes[i] {
        let t = loops[i]
        loops[i] = loops[j]
        loops[j] = t
        let ts = sizes[i]
        sizes[i] = sizes[j]
        sizes[j] = ts
      }
    }
  }
  for l in loops {
    let (head, body) = l
    var pre = -1
    for p in preds[head] {
      if body[p] {
        continue
      }
      if pre >= 0 {
        pre = -1
        break
      }
      pre = p
    }
    if pre < 0 || g.term_kind(pre) != K_JUMP {
      continue
    }
    var calls = false
    for b in 0..g.blocks.len() {
      if !body[b] || g.blocks[b].cold {
        continue
      }
      for inst in g.blocks[b].insts {
        calls = calls || inst.kind == K_CALL
      }
    }
    if calls {
      continue
    }
    var hoisted: List[Inst] = []
    var outside: Map[Int, Bool] = {}
    var again = true
    while again && hoisted.len() < HOIST_MAX {
      again = false
      for b in blocks {
        if !body[b] || g.blocks[b].cold || hoisted.len() >= HOIST_MAX {
          continue
        }
        var out: List[Inst] = []
        var any = false
        for inst in g.blocks[b].insts {
          if hoisted.len() < HOIST_MAX && g.hoistable(inst, body, ndef, defb, outside) {
            hoisted.push(inst)
            outside[inst.defs[0]] = true
            any = true
            again = true
            continue
          }
          out.push(inst)
        }
        if any {
          g.blocks[b].insts = out
        }
      }
    }
    if hoisted.is_empty() {
      continue
    }
    for inst in hoisted {
      defb[inst.defs[0]] = [pre]
    }
    let ins = g.blocks[pre].insts
    let n = ins.len()
    g.blocks[pre].insts = ins[0..n - 1] + hoisted + [ins[n - 1]]
  }
}

const HOIST_MAX = 4

/// Whether inst may move to the preheader of the loop body
/// (hoist_invariants' rule).
fn (g: G) hoistable(inst: Inst, body: List[Bool], ndef: Map[Int, Int], defb: Map[Int, List[Int]], outside: Map[Int, Bool]) -> Bool {
  if inst.kind != K_PLAIN || inst.konst || inst.keep || inst.frame || inst.has_fault || inst.x86 || inst.early || !inst.recover.is_empty() || !inst.clobbers.is_empty() {
    return false
  }
  if inst.defs.len() != 1 || inst.text.contains("\n") || inst.text.contains("[") {
    return false
  }
  let sp = inst.text.find(" ") ?? -1
  if sp < 0 || !pure_mnemonic(inst.text[0..sp]) {
    return false
  }
  let d = inst.defs[0]
  if (ndef.get(d) ?? 0) != 1 {
    return false
  }
  // every definition of a use outside the loop: the use cannot change in
  // it (an outer loop's counter is defined twice, both outside)
  for u in inst.us {
    if u == 0 || outside.contains(u) {
      continue
    }
    let bs = defb.get(u) ?? []
    if bs.is_empty() {
      return false
    }
    for b in bs {
      if body[b] {
        return false
      }
    }
  }
  true
}

/// Whether a condbr tests flags a compare set (not cbnz, tbz, tbnz).
fn flag_test(inst: Inst) -> Bool {
  inst.kind == K_CONDBR && !inst.text.is_empty() && inst.cond != "cbnz" && inst.cond != "tbz" && inst.cond != "tbnz" &&
    !inv_cond(inst.cond).is_empty()
}

/// Renumbers the uses of a template by k (selectCompares' shift).
fn shift_uses(t: Str, k: Int) -> Str {
  var out = StrBuilder.new()
  let bs = t.bytes()
  var i = 0
  let n = bs.len()
  var from = 0
  while i < n {
    if Int(bs[i]) == 36 && i + 2 < n && Int(bs[i + 1]) == 117 && Int(bs[i + 2]) >= 48 && Int(bs[i + 2]) <= 57 {
      out.write(t[from..i])
      var x = 0
      var j = i + 2
      while j < n && Int(bs[j]) >= 48 && Int(bs[j]) <= 57 {
        x = x * 10 + Int(bs[j]) - 48
        j += 1
      }
      out.write("$u${x + k}")
      i = j
      from = i
      continue
    }
    i += 1
  }
  out.write(t[from..n])
  out.freeze()
}

/// Turns a compare that only picks which of two other compares decides a
/// branch into straight line code (selectCompares).
fn (var g: G) select_compares() {
  let blocks = g.all_blocks()
  var npred: List[Int] = []
  for _ in 0..g.blocks.len() {
    npred.push(0)
  }
  for b in blocks {
    for x in g.msuccs(b) {
      npred[x] += 1
    }
  }
  var changed = false
  for p in g.hot {
    let np = g.blocks[p].insts.len()
    if np == 0 {
      continue
    }
    let pt = g.blocks[p].insts[np - 1]
    if !flag_test(pt) || (pt.cond != "eq" && pt.cond != "ne") || pt.text.contains("\n") {
      continue
    }
    // e: taken when the first compare is equal
    let ne = pt.cond == "ne"
    let e = if ne { pt.targets[1] } else { pt.targets[0] }
    let n = if ne { pt.targets[0] } else { pt.targets[1] }
    if e == n || e == p || n == p || g.blocks[e].insts.len() != 1 || g.blocks[n].insts.len() != 1 || npred[e] != 1 || npred[n] != 1 {
      continue
    }
    let et = g.blocks[e].insts[0]
    let nt = g.blocks[n].insts[0]
    if !flag_test(et) || !flag_test(nt) || !one_compare(et.text) || !one_compare(nt.text) {
      continue
    }
    let t = et.targets[0]
    let f = et.targets[1]
    if t == f {
      continue
    }
    let ec = et.cond
    var nc = nt.cond
    if nt.targets[0] == t && nt.targets[1] == f {
    } else if nt.targets[0] == f && nt.targets[1] == t {
      nc = inv_cond(nc)
    } else {
      continue
    }
    if et.us.len() + pt.us.len() > 9 || nt.us.len() + pt.us.len() + 1 > 9 {
      continue
    }
    var insts = g.blocks[p].insts[0..np - 1]
    let a = g.new_vreg(false)
    insts.push(Inst{kind: K_PLAIN, text: "${et.text}\ncset $d0, ${ec}", defs: [a], us: et.us})
    let r = g.new_vreg(false)
    var same = nt.text == pt.text && nt.us.len() == pt.us.len()
    var i = 0
    while same && i < nt.us.len() {
      same = nt.us[i] == pt.us[i]
      i += 1
    }
    if same {
      // the other compare is the first one: its flags pick too
      insts.push(Inst{kind: K_PLAIN, text: "${shift_uses(pt.text, 1)}\ncset $d0, ${nc}\ncsel $d0, $u0, $d0, eq",
        defs: [r], us: [a] + pt.us, early: true})
    } else {
      let b = g.new_vreg(false)
      insts.push(Inst{kind: K_PLAIN, text: "${nt.text}\ncset $d0, ${nc}", defs: [b], us: nt.us})
      insts.push(Inst{kind: K_PLAIN, text: "${shift_uses(pt.text, 2)}\ncsel $d0, $u0, $u1, eq",
        defs: [r], us: [a, b] + pt.us})
    }
    insts.push(Inst{kind: K_CONDBR, cond: "tbnz", us: [r], targets: [t, f]})
    g.blocks[p].insts = insts
    changed = true
  }
  if changed {
    g.thread()
  }
}

/// Whether a branch's flag setting text is one compare: one instruction,
/// or a Float ordering compare (fcmp then fccmp) that only sets the flags.
fn one_compare(text: Str) -> Bool {
  if !text.contains("\n") {
    return true
  }
  for l in text.split("\n") {
    if !l.starts_with("fcmp ") && !l.starts_with("fccmp ") {
      return false
    }
  }
  true
}

/// Whether a condbr tests flags (reuseFlags' flags).
fn flags_br(inst: Inst) -> Bool {
  inst.kind == K_CONDBR && !inst.text.is_empty() && inst.cond != "cbnz" && inst.cond != "tbz" && inst.cond != "tbnz"
}

/// Drops the compare of a block that only branches when its one
/// predecessor ended with the same compare of the same registers.
fn (var g: G) reuse_flags() {
  let blocks = g.all_blocks()
  var preds: List[List[Int]] = []
  for _ in 0..g.blocks.len() {
    preds.push([])
  }
  for b in blocks {
    for x in g.msuccs(b) {
      let n = preds[x].len()
      if n == 0 || preds[x][n - 1] != b {
        preds[x].push(b)
      }
    }
  }
  for x in blocks {
    if g.blocks[x].insts.len() != 1 || !flags_br(g.blocks[x].insts[0]) || preds[x].len() != 1 || preds[x][0] == x {
      continue
    }
    let inst = g.blocks[x].insts[0]
    let pb = preds[x][0]
    let np = g.blocks[pb].insts.len()
    if np == 0 {
      continue
    }
    let p = g.blocks[pb].insts[np - 1]
    if !flags_br(p) || p.text != inst.text || p.us.len() != inst.us.len() {
      continue
    }
    var same = true
    for i in 0..inst.us.len() {
      same = same && inst.us[i] == p.us[i]
    }
    if same {
      var ins = g.take_insts(x)
      ins[0].text = ""
      ins[0].us = []
      g.put_insts(x, ins)
    }
  }
}

/// Deletes the instructions without side effects, and the moves of
/// parallel moves, whose definitions are dead where they are written
/// (opt.go liveDCE, decision 0184): flow sensitive, one backward pass
/// over each block from the registers live out of it; a register live
/// into a landing pad counts as live everywhere.
fn (var g: G) live_dce() {
  let order = g.all_blocks()
  let n = g.fp.len()
  var idx: List[Int] = []
  for _ in 0..g.blocks.len() {
    idx.push(-1)
  }
  for (k, b) in order.indexed() {
    idx[b] = k
  }
  var succs: List[List[Int]] = []
  var gens: List[List[Int]] = []
  var kills: List[List[Int]] = []
  var pads: List[Int] = []
  var kst: List[Int] = List.with_capacity(n)
  var ust: List[Int] = List.with_capacity(n)
  for _ in 0..n {
    kst.push(0)
    ust.push(0)
  }
  for k in 0..order.len() {
    let b = order[k]
    var ss: List[Int] = []
    for t in g.msuccs(b) {
      if idx[t] >= 0 {
        ss.push(idx[t])
      }
    }
    succs.push(ss)
    for inst in g.blocks[b].insts {
      if inst.pad >= 0 {
        let pk = idx[g.pad_of(inst.pad)]
        if pk < 0 {
          return
        }
        pads.push(pk)
      }
    }
    var gl: List[Int] = []
    var kl: List[Int] = []
    gen_kill(g.blocks[b].insts, k + 1, gl, kl, kst, ust)
    gens.push(gl)
    kills.push(kl)
  }
  let lv = solve_live(succs, gens, kills, n)
  var pad_live = new_bits(n)
  for j in pads {
    for v in lv.ins[j] {
      pad_live[v / BW] = pad_live[v / BW] | bit_mask(v)
    }
  }
  // the registers live at the point of a block's backward walk, cleared
  // after each block through the registers it set
  var live = new_bits(n)
  var touched: List[Int] = []
  for k in 0..order.len() {
    let b = order[k]
    for v in lv.outs[k] {
      live[v / BW] = live[v / BW] | bit_mask(v)
      touched.push(v)
    }
    var ins = g.take_insts(b)
    var keep: List[Bool] = List.with_capacity(ins.len())
    for _ in 0..ins.len() {
      keep.push(true)
    }
    // whether the block's list changes: an instruction or a parallel
    // move's destination is dropped
    var changed = false
    var i = ins.len() - 1
    while i >= 0 {
      let kind = ins[i].kind
      if kind == K_PMOVE {
        // a move with no destination left goes too
        var dead = ins[i].defs.is_empty()
        for d in ins[i].defs {
          dead = dead || ld_dead(d, live, pad_live)
        }
        if dead {
          changed = true
          var defs: List[Int] = []
          var srcs: List[Src] = []
          var us: List[Int] = []
          for k2 in 0..ins[i].defs.len() {
            let d = ins[i].defs[k2]
            if !ld_dead(d, live, pad_live) {
              defs.push(d)
              srcs.push(ins[i].srcs[k2])
            }
          }
          for a in srcs {
            if a.kind == S_REG && a.v != 0 {
              us.push(a.v)
            }
          }
          keep[i] = !defs.is_empty()
          ins[i].defs = defs
          ins[i].srcs = srcs
          ins[i].us = us
        }
      } else if kind == K_PLAIN && !ins[i].has_fault && !ins[i].keep && !ins[i].defs.is_empty() {
        var all = true
        for d in ins[i].defs {
          all = all && ld_dead(d, live, pad_live)
        }
        keep[i] = !all
        changed = changed || all
      }
      if keep[i] {
        for d in ins[i].defs {
          if d != 0 {
            live[d / BW] = live[d / BW] & ~bit_mask(d)
          }
        }
        for u in ins[i].us {
          if u != 0 {
            live[u / BW] = live[u / BW] | bit_mask(u)
            touched.push(u)
          }
        }
      }
      i -= 1
    }
    while !touched.is_empty() {
      let v = touched.pop() ?? 0
      live[v / BW] = live[v / BW] & ~bit_mask(v)
    }
    if !changed {
      g.put_insts(b, ins)
      continue
    }
    var kept: List[Inst] = List.with_capacity(ins.len())
    for ii in 0..ins.len() {
      if keep[ii] {
        kept.push(ins[ii])
      }
    }
    g.put_insts(b, kept)
  }
}

/// Whether register d is dead (live_dce): not live and not live into a
/// landing pad.
fn ld_dead(d: Int, live: List[Int], pad_live: List[Int]) -> Bool {
  d != 0 && !bits_has(live, d) && !bits_has(pad_live, d)
}
