// MIR: machine instructions over virtual registers (internal/arm64
// mir.go).
//
// A virtual register (vreg) is an Int; 0 is the zero register (xzr),
// which instruction selection uses for payload words no variant fills.
// Virtual registers need not be SSA: a few are defined on two paths
// (the result of a list push that may grow, the arms of `list.get`), and
// block parameters are defined by the parallel move of each predecessor.
//
// Plain instructions carry an assembly template: `$d0` is the first
// definition, `$u1` the second use; `$wd0` and `$wu1` the 32 bit names
// of integer registers; `$OUT` is the frame offset of the scratch slot
// runtime calls write a length into.
//
// Blocks are indexes into G.blocks (their creation order); a block's
// `id` is the number of its label. -1 stands for none.

// Instruction kinds (ikind).
const K_PLAIN = 0
/// defs[k] = srcs[k], all at once
const K_PMOVE = 1
/// call sym with srcs, defs are the result words
const K_CALL = 2
/// defs are the function parameters, from the ABI locations
const K_ENTRY = 3
/// uses are the result words
const K_RET = 4
/// to targets[0]; a targets[1] is a landing pad's block, entered only by
/// the unwinder (decision 0085)
const K_JUMP = 5
/// text sets flags (or cond is cbnz/cbz on uses[0]); targets[0] if cond,
/// else targets[1]
const K_CONDBR = 6
/// after a call that does not return
const K_TRAP = 7
/// through a table on uses[0] minus text (a decimal): targets[k] for k,
/// the last target otherwise (jumptab.xo)
const K_SWITCH = 8

// Operand kinds (srcKind).
const S_REG = 0
const S_IMM = 1
const S_SYM = 2
const S_FRAME = 3
/// the address of byte imm of the frame's memory (byref.xo)
const S_MEM = 4

/// An operand of a call, a fault stub, or a parallel move.
struct Src {
  kind: Int
  v: Int = 0
  imm: Int = 0
  sym: Str = ""
}

fn rsrc(v: Int) -> Src {
  Src{kind: S_REG, v: v}
}

fn isrc(n: Int) -> Src {
  Src{kind: S_IMM, imm: n}
}

fn symsrc(s: Str) -> Src {
  Src{kind: S_SYM, sym: s}
}

fn framesrc() -> Src {
  Src{kind: S_FRAME}
}

fn regs(vs: List[Int]) -> List[Src] {
  var out: List[Src] = []
  for v in vs {
    out.push(rsrc(v))
  }
  out
}

// Size causes (decision 0443): what made an instruction, for `xo dev
// size --by-cause`. The emitter writes a `_x<code>_dc<n>` label at each
// change of cause (cause_mark); the assembler sums the bytes between
// them (compiler/macho assemble_causes). Codes are only ever added.
const C_BODY = 0
/// the prologue, the epilogue and its return
const C_FRAME = 1
/// the blocks lowered from the SSA unwind exit (Func.unwind_exit)
const C_FAULT_EXIT = 2
/// what only landing pads reach (the cleanups), and the pad entries
const C_LANDING = 3
/// the out of line stubs of checked operations
const C_FAULT_STUB = 4
/// the preemption poll stubs (decision 0286)
const C_PREEMPT = 5
/// retain, release and drop (the SSA rc ops)
const C_RC = 6
/// struct and tuple copies
const C_COPY = 7
/// instructions inlined from std/llrt
const C_INLINE_RT = 8
/// bytes that are not instructions: jump tables, the local empty list
const C_DATA = 9

  /// A machine instruction.
struct Inst {
  kind: Int
  /// its flags, IF_* bits (fifteen Bools were a word each; ADR 0448 stage 3)
  fl: Int = 0
  /// its size cause (C_*, decision 0443), set by isel's add from the SSA
  /// value or block it lowers; instructions made later stay C_BODY
  cause: Int = 0
  /// a call in a cold block: the caller saved general registers live
  /// across it, each with its spill slot, stored before its argument moves and
  /// loaded after its results' (regalloc.xo cold_saves)
  csave: List[(Int, Int)] = []
  text: Str = ""
  /// the packed source line it was selected for (ssa Value.line), 0 for
  /// none: a row of the debug line table (decision 0239)
  line: Int = 0
  /// its inline site (ssa Value.inl, Func.inl_sites), -1 for none
  inl: Int = -1
  /// physical registers its text writes besides its definitions (an
  /// atomic's status register): no value is given one across it
  clobbers: List[Int] = []
  /// reg_hints are registers its operands would like, reg_bars
  /// registers they must not take, each (operand, register), the operand
  /// k >= 0 for us[k] and -1 - k for defs[k]
  reg_hints: List[(Int, Int)] = []
  reg_bars: List[(Int, Int)] = []
  defs: List[Int] = []
  /// template uses first, then the vregs of srcs and fault args
  us: List[Int] = []
  /// how a fault stub recomputes an operand whose register the result
  /// took ("add", "sub", "neg")
  recover: Str = ""
  fcond: Str = ""
  ffn: Str = ""
  fargs: List[Src] = []
  /// K_CALL: the callee symbol and the arguments; K_PMOVE: the sources
  sym: Str = ""
  srcs: List[Src] = []
  cond: Str = ""
  targets: List[Int] = []
  /// K_CONDBR with cond tbz or tbnz: the bit tested
  bit: Int = 0
  /// K_CALL: a variadic C function on Apple arm64 (decision 0213): the
  /// arguments from this index on go on the stack, 8 bytes each; -1 for
  /// none
  vfix: Int = -1
  /// the landing pad block of a call or of a fault stub's call (decision
  /// 0085), -1 for none
  pad: Int = -1
}

// Inst.fl bits: an instruction's yes/no properties, one bit each (a Bool
// field took a word, and an Inst with fifteen of them 43 words; the self
// build held 0.8 GB of instructions halfway through emit, ADR 0448 stage 3)
/// a call of a runtime slow path (ssa cold_fn): cold wherever its
/// block is, so cold_saves and the hoisting passes treat it as one
const IF_COLD_CALL = 1
/// the clobbers hold only between the template's reads and writes
/// (x86_mul_pair): an operand that dies at it, or a definition, may
/// take one
const IF_CLOB_MID = 2
/// the defs are written before the uses are dead (they must not share
/// registers)
const IF_EARLY = 4
/// the side exit of a checked instruction: when fcond holds after it,
/// the runtime function ffn is called with fargs (it does not return)
const IF_HAS_FAULT = 8
/// a preemption poll (decision 0286 step 3): its text loads the flag
/// into w16; when it is set a stub calls xo_preempt_stub, which keeps
/// every register, and comes back
const IF_POLL = 16
/// K_CALL: the call never returns (a fault)
const IF_NORET = 32
/// K_CALL: through the code word of a closure, in x0 (`blr x0`)
const IF_INDIRECT = 64
/// K_CALL: a Linux system call (rt.sys6, decision 0206): the number is
/// the seventh argument (x6), moved to x8 for `svc #0`
const IF_SVC = 128
/// K_CALL: a C ABI call of the address in the last source register
/// (rt.call_c2, decision 0206 stage 2): `blr x<n>` after the n
/// arguments
const IF_CPTR = 256
/// a plain instruction that makes a constant (hoistConsts may move it)
const IF_KONST = 512
/// a plain instruction that reads the frame pointer (rt.frame_addr,
/// decision 0233): the function is not a leaf, and its block has the
/// frame (shrink wrapping)
const IF_FRAME = 1024
/// a plain instruction with a memory effect (an atomic, decision
/// 0200): kept when its definitions are dead, never folded into a
/// branch
const IF_KEEP = 2048
/// K_PMOVE: the copies of shrink wrapping (shrink.xo), whose two sides
/// must not share a location (never coalesced)
const IF_NOCOAL = 4096
/// K_CALL: a tail call (shrink.xo mark_tails): its results are the
/// function's, returned by nothing but moves and jumps; emitted as the
/// frame undone and a branch
const IF_TAIL = 8192
/// an x86 template (decision 0254: written by retarget, or as x86 by
/// the front half for amd64)
const IF_X86 = 16384

/// Whether instruction x has flag bit b (IF_*).
fn (x: Inst) has(b: Int) -> Bool { x.fl & b != 0 }

/// fl with bit b set when on, cleared otherwise.
fn fl_set(fl: Int, b: Int, on: Bool) -> Int {
  if on { fl | b } else { fl & ~b }
}

/// A machine block.
struct MBlock {
  id: Int
  insts: List[Inst] = []
  cold: Bool = false
  succs: List[Int] = []
  preds: List[Int] = []
  // filled by register allocation
  start: Int = 0
  end: Int = 0
  depth: Int = 0
}

/// The terminator of block b, or -1 (its index in insts).
fn (g: G) term_at(b: Int) -> Int {
  let n = g.blocks[b].insts.len()
  if n == 0 {
    return -1
  }
  n - 1
}

/// The kind of block b's last instruction, or -1.
fn (g: G) term_kind(b: Int) -> Int {
  let n = g.blocks[b].insts.len()
  if n == 0 {
    return -1
  }
  g.blocks[b].insts[n - 1].kind
}

/// The targets of block b's terminator when it branches (jump, condbr,
/// switch); else the landing pads of its calls: a call that does not
/// return (a fault the operands prove, then a trap) still unwinds to its
/// pad, which no rt.landing branch reaches once the branch to the call
/// was decided (2026-10-23: `csv.parse(s, sep: '"')` in a test left the
/// pad unemitted and its call site's label undefined).
fn (g: G) msuccs(b: Int) -> List[Int] {
  let n = g.blocks[b].insts.len()
  if n == 0 {
    return []
  }
  let k = g.blocks[b].insts[n - 1].kind
  if k == K_JUMP || k == K_CONDBR || k == K_SWITCH {
    return g.blocks[b].insts[n - 1].targets
  }
  // the pad as the emitter names it (pad_of: past the blocks that only
  // jump, which the layout drops; 2026-10-23: inst.pad itself crashed
  // amd64 builds of bench portable in shrink's liveness)
  var pads: List[Int] = []
  for inst in g.blocks[b].insts {
    if inst.kind == K_CALL && inst.pad >= 0 {
      let p = g.pad_of(inst.pad)
      if !pads.contains(p) {
        pads.push(p)
      }
    }
  }
  pads
}
