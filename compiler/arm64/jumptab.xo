// Compare chains and jump tables for `match` (internal/arm64
// jumptab.go, decision 0051): a chain that tests at least JUMP_TABLE_MIN
// distinct values, whose table would be at most JUMP_TABLE_SLACK times
// that many entries, becomes a K_SWITCH on its first block; every other
// chain is laid out as a run of tests that fall through to each other.
// (The Go emitter's XO_ARM64_JT_MIN measuring knob is not ported.)

const JUMP_TABLE_MIN = 8
const JUMP_TABLE_SLACK = 3
/// A chain of at least this many distinct values that is too sparse for
/// a table becomes a compare tree (2026-10-24: unicode fold tables test
/// a dozen keys, most of them past imm12, one after another).
const COMPARE_TREE_MIN = 6

/// A chain test: the register and constant of a block's terminator when
/// it is `cmp r, #k`, or `cmp r, k` with k a register holding a constant
/// (a key past imm12, kreg), with b.eq or b.ne, the target taken when
/// r == k, and the one that continues the chain.
struct ChainTest {
  ok: Bool
  r: Int = 0
  k: Int = 0
  kreg: Int = -1
  hit: Int = -1
  next: Int = -1
}

fn (g: G) chain_test(b: Int) -> ChainTest {
  let bad = ChainTest{ok: false}
  let n = g.blocks[b].insts.len()
  if n == 0 {
    return bad
  }
  let inst = g.blocks[b].insts[n - 1]
  if inst.kind != K_CONDBR || inst.x86 || (inst.cond != "eq" && inst.cond != "ne") {
    return bad
  }
  var k = 0
  var kreg = -1
  if inst.us.len() == 2 && inst.text == "cmp $u0, $u1" {
    kreg = inst.us[1]
    k = match g.kvals.get(kreg) {
      Some(v) => v
      None => return bad
    }
  } else {
    if inst.us.len() != 1 || !inst.text.starts_with("cmp $u0, #") {
      return bad
    }
    let num = inst.text.trim_prefix("cmp $u0, #")
    if !is_signed_digits(num) {
      return bad
    }
    k = match Int.parse(num) {
      Some(v) => v
      None => return bad
    }
  }
  if inst.cond == "eq" {
    return ChainTest{ok: true, r: inst.us[0], k: k, kreg: kreg, hit: inst.targets[0], next: inst.targets[1]}
  }
  ChainTest{ok: true, r: inst.us[0], k: k, kreg: kreg, hit: inst.targets[1], next: inst.targets[0]}
}

/// A compare chain: the blocks after its head that hold nothing but a
/// compare of the same register, the first target of each value (keys
/// in order), and the block reached when no value matches.
struct Chain {
  blocks: List[Int] = []
  keys: List[Int] = []
  hits: List[Int] = []
  def: Int = -1
  ok: Bool = false
}

fn (g: G) chain(head: Int, nuse: Map[Int, Int]) -> Chain {
  let c0 = g.chain_test(head)
  if !c0.ok {
    return Chain{}
  }
  var ch = Chain{ok: true}
  var seen: Map[Int, Bool] = {}
  seen[head] = true
  var b = head
  while true {
    let c = g.chain_test(b)
    if !ch.keys.contains(c.k) {
      ch.keys.push(c.k)
      ch.hits.push(c.hit)
    }
    let nx = c.next
    let c2 = g.chain_test(nx)
    if !c2.ok || c2.r != c0.r || !g.only_test(nx, c2, nuse) || seen.contains(nx) || g.blocks[nx].cold {
      ch.def = nx
      return ch
    }
    seen[nx] = true
    ch.blocks.push(nx)
    b = nx
  }
  ch
}

/// Whether block b holds nothing but its chain test c: the compare, or
/// the constant's mov and the compare when the key is in a register no
/// other instruction reads (nuse: the reads of each register).
fn (g: G) only_test(b: Int, c: ChainTest, nuse: Map[Int, Int]) -> Bool {
  let ins = g.blocks[b].insts
  if ins.len() == 1 {
    return true
  }
  if ins.len() != 2 || c.kreg < 0 {
    return false
  }
  let mv = ins[0]
  mv.kind == K_PLAIN && mv.konst && mv.defs == [c.kreg] && (nuse.get(c.kreg) ?? 0) == 1
}

/// The number of reads of each register in g.
fn (g: G) reg_uses() -> Map[Int, Int] {
  var n: Map[Int, Int] = {}
  for b in g.all_blocks() {
    for ins in g.blocks[b].insts {
      for u in ins.us {
        n[u] = (n.get(u) ?? 0) + 1
      }
    }
  }
  n
}

/// Ends block b with a test of r against k: cond taken to t, else f
/// (a key past imm12 in a new constant register).
fn (var g: G) key_test(b: Int, r: Int, k: Int, cond: Str, t: Int, f: Int) {
  g.cur = b
  if k >= 0 && k < 4096 {
    let _c = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, #${k}", us: [r], cond: cond, targets: [t, f]})
    return
  }
  let kr = g.imm(k)
  let _c = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, $u1", us: [r, kr], cond: cond, targets: [t, f]})
}

/// A compare tree over keys (ascending) and their targets, def when none
/// matches: the middle key tested for equality, then below it or above
/// it; three keys or fewer one after another. Its first block, and the
/// blocks it made in order in out.
fn (var g: G) key_tree(r: Int, keys: List[Int], hits: List[Int], def: Int, var out: List[Int]) -> Int {
  let n = keys.len()
  if n <= 3 {
    var bs: List[Int] = []
    for _ in 0..n {
      let nb = g.new_block(false)
      bs.push(nb)
      out.push(nb)
    }
    for i in 0..n {
      let next = if i + 1 < n { bs[i + 1] } else { def }
      g.key_test(bs[i], r, keys[i], "eq", hits[i], next)
    }
    return if n == 0 { def } else { bs[0] }
  }
  let m = n / 2
  let eq = g.new_block(false)
  out.push(eq)
  let lt = g.new_block(false)
  out.push(lt)
  let left = g.key_tree(r, keys[0..m], hits[0..m], def, out)
  let right = g.key_tree(r, keys[m + 1..n], hits[m + 1..n], def, out)
  g.key_test(eq, r, keys[m], "eq", hits[m], lt)
  g.key_test(lt, r, keys[m], "lt", left, right)
  eq
}

/// Whether chain ch's table fits: its keys from 0 to 4095, the table at
/// most JUMP_TABLE_SLACK times as long as the keys.
fn (g: G) table_fits(ch: Chain) -> Bool {
  var lo = ch.keys[0]
  var hi = ch.keys[0]
  for k in ch.keys {
    lo = imin(lo, k)
    hi = imax(hi, k)
  }
  let size = hi - lo + 1
  lo >= 0 && lo < 4096 && size <= 4096 && size <= JUMP_TABLE_SLACK * ch.keys.len()
}

/// Replaces dense compare chains with K_SWITCH terminators, sparse ones
/// of COMPARE_TREE_MIN values or more with a compare tree, and lays out
/// the other chains as a run of tests.
fn (var g: G) jump_tables() {
  var changed = false
  let nuse = g.reg_uses()
  var trees: Map[Int, List[Int]] = {}
  let cur = g.cur
  for head in g.hot {
    let ch = g.chain(head, nuse)
    if !ch.ok || ch.keys.len() < COMPARE_TREE_MIN {
      continue
    }
    if ch.keys.len() < JUMP_TABLE_MIN || !g.table_fits(ch) {
      // a compare tree from the head's test on: keys in order
      var ord: List[Int] = []
      for i in 0..ch.keys.len() {
        ord.push(i)
      }
      let sorted = ord.sort_by(fn(i: Int) -> Int { ch.keys[i] })
      var keys: List[Int] = []
      var hits: List[Int] = []
      for i in sorted {
        keys.push(ch.keys[i])
        hits.push(ch.hits[i])
      }
      let n = g.blocks[head].insts.len()
      let r = g.blocks[head].insts[n - 1].us[0]
      var made: List[Int] = []
      let root = g.key_tree(r, keys, hits, ch.def, made)
      var ins = g.take_insts(head)
      ins[n - 1] = Inst{kind: K_JUMP, line: ins[n - 1].line, inl: ins[n - 1].inl, targets: [root]}
      g.put_insts(head, ins)
      trees[head] = made
      changed = true
      continue
    }
    var lo = ch.keys[0]
    var hi = ch.keys[0]
    for k in ch.keys {
      lo = imin(lo, k)
      hi = imax(hi, k)
    }
    let size = hi - lo + 1
    if lo < 0 || lo >= 4096 || size > 4096 || size > JUMP_TABLE_SLACK * ch.keys.len() {
      continue
    }
    var targets: List[Int] = []
    for _ in 0..size + 1 {
      targets.push(ch.def)
    }
    for (i, k) in ch.keys.indexed() {
      targets[k - lo] = ch.hits[i]
    }
    let n = g.blocks[head].insts.len()
    let r = g.blocks[head].insts[n - 1].us[0]
    var ins = g.take_insts(head)
    ins[n - 1] = Inst{kind: K_SWITCH, text: "${lo}", us: [r], targets: targets}
    g.put_insts(head, ins)
    changed = true
  }
  g.cur = cur
  // each compare tree right after its head, in the order it was made,
  // before thread drops a head that only jumps to its tree now
  if !trees.is_empty() {
    var intree: Map[Int, Bool] = {}
    for (_, made) in trees {
      for b in made {
        intree[b] = true
      }
    }
    var out: List[Int] = []
    for b in g.hot {
      if intree.contains(b) {
        continue
      }
      out.push(b)
      if let Some(made) = trees.get(b) {
        for x in made {
          out.push(x)
        }
      }
    }
    g.hot = out
  }
  if changed {
    g.thread() // drops the chain blocks nothing reaches now
  }
  let uses2 = g.reg_uses()
  var placed: Map[Int, Bool] = {}
  var i = 0
  while i < g.hot.len() {
    let head = g.hot[i]
    i += 1
    if placed.contains(head) {
      continue
    }
    let ch = g.chain(head, uses2)
    if ch.blocks.is_empty() {
      continue
    }
    var mv: Map[Int, Bool] = {}
    for b in ch.blocks {
      mv[b] = true
      placed[b] = true
    }
    var out: List[Int] = []
    for b in g.hot {
      if mv.contains(b) {
        continue
      }
      out.push(b)
      if b == head {
        for c in ch.blocks {
          out.push(c)
        }
      }
    }
    g.hot = out
  }
}

/// A function of more than this many words, its instructions counted
/// twice (spills, far tests and stubs grow them) plus a table's entries,
/// keeps its jump tables after their br: adr reaches 1 MiB, and the table
/// at the function's end did not in a match of 65535 arms ("adr out of
/// range", the scale suite, 2026-10-23).
const JT_INLINE_WORDS = 131072

/// Emits a K_SWITCH: values outside the table go to the last target; the
/// table holds offsets from its own label, after the function's code, or
/// right after the br in a long function (JT_INLINE_WORDS).
fn (var g: G) emit_switch(var b: List[Str], inst: Inst) {
  let lo = Int.parse(inst.text) ?? 0
  let n = inst.targets.len() - 1
  // a spilled index reloads into x17, which the offset takes after it
  var idx = g.use_reg(b, inst.us[0], 1)
  if lo != 0 {
    b.push("\tsub x17, ${idx}, #${lo}\n")
    idx = "x17"
  }
  let tab = g.local("${g.lbl_prefix()}_jt${g.blocks[g.cur].id}")
  b.push("\tcmp ${idx}, #${n - 1}\n")
  b.push("\tb.hi ${g.label(g.fwd(inst.targets[n]))}\n")
  b.push("\tadr x16, ${tab}\n")
  b.push("\tldrsw x17, [x16, ${idx}, lsl #2]\n")
  b.push("\tadd x16, x16, x17\n\tbr x16\n")
  var s: List[Str] = ["\t.p2align 2\n${tab}:\n"]
  for t in inst.targets[0..n] {
    s.push("\t.long ${g.label(g.fwd(t))}-${tab}\n")
  }
  if 2 * g.ninst + n >= JT_INLINE_WORDS {
    b.push(s.join(""))
    return
  }
  g.stubs.push(s.join(""))
}
