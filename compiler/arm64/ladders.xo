// Release ladders outlined (decision 0634): a run of `ldr x0, [sp, #N]`
// and `bl H` pairs that a function repeats verbatim (the same slots, the
// same helpers, the same order) is written once, after the function's
// body, as a local subroutine with a frame record of its own, and each
// copy becomes one `bl` to it. xo's own build had 1.33 M instructions
// (7.1%) in such repeats, build_native 0.70 M of its 1.01 M
// (2026-11-14): the releases of a scope with hundreds of owned values on
// each of its exits, in the middle of a block, where neither reltail
// (decision 0623) nor tail_merge_cold sees a common tail.
//
// The subroutine is an unwind region of its own (as a leaf's fault
// stubs), with the frame record every function makes: the frame pointer
// chain and the CFI both go from a pc inside it to its caller at the
// `bl`, so the fault trace, the profiler and xo debug name the line of
// the copy that ran, not the first copy's. Its pcs lie past the
// function's line rows. The run's slots are read 16 bytes further, past
// the record.
//
// x86_64 the same (step 3: 4.7% of xo's amd64 instructions were
// repeats of 16 or more pairs): `movq N(%rsp), %rdi; callq H` pairs, a
// subroutine that pushes rbp (the call pushed the return address, so the
// slots are N + 16 there too), and `callq` to it.

/// The fewest pairs a run has to be outlined.
const LADDER_MIN = 16

/// The farthest slot offset a ladder may read: [sp, #N + 16] stays in
/// the scaled ldr's reach (x86's disp32 reaches it too).
const LADDER_MAX_OFF = 32744

/// The slot offset of a ladder line, `\tldr x0, [sp, #N]` (x86:
/// `\tmovq N(%rsp), %rdi`), or -1.
fn ladder_load(l: Str, x86: Bool) -> Int {
  let (p, q) = if x86 { ("\tmovq ", "(%rsp), %rdi") } else { ("\tldr x0, [sp, #", "]") }
  if !l.starts_with(p) || !l.ends_with(q) || l.len() <= p.len() + q.len() {
    return -1
  }
  let n = parse_int(l[p.len()..l.len() - q.len()]) ?? -1
  if n < 0 || n % 8 != 0 || n > LADDER_MAX_OFF {
    return -1
  }
  n
}

/// A ladder line reading slot n.
fn ladder_load_text(n: Int, x86: Bool) -> Str {
  if x86 { "\tmovq ${n}(%rsp), %rdi" } else { "\tldr x0, [sp, #${n}]" }
}

/// Whether l is a call of a symbol, `\tbl SYM` (x86: `\tcallq SYM`).
fn ladder_call(l: Str, x86: Bool) -> Bool {
  let p = if x86 { "\tcallq " } else { "\tbl " }
  l.starts_with(p) && l.len() > p.len() && !l.contains(",") && !l.contains("*") && !l[p.len()..l.len()].contains(" ")
}

/// Whether l is a label a run may hold (moved before its `bl` when the
/// run is outlined): a line table row (`_dlN`), a variable range's
/// boundary (`_dvN`) or a cause mark (`_xK_dcN`); no branch reaches
/// them. A block's label, a call site's and the preemption spans' end a
/// run.
fn ladder_label(l: Str) -> Bool {
  if !l.ends_with(":") || !(l.starts_with("L") || l.starts_with(".L")) {
    return false
  }
  let name = l[0..l.len() - 1]
  for m in ["_dl", "_dv", "_dc"] {
    let at = name.rfind(m) ?? -1
    if at >= 0 && at + 3 < name.len() && is_digits(name[at + 3..name.len()]) {
      return true
    }
  }
  false
}

/// The run that starts at ls[i]: its pairs and the index past its last
/// call (labels inside it included).
fn ladder_run(ls: List[Str], i: Int, x86: Bool) -> (Int, Int) {
  var n = 0
  var j = i
  var end = i
  while true {
    var k = j
    while k < ls.len() && ladder_label(ls[k]) {
      k += 1
    }
    if k >= ls.len() || ladder_load(ls[k], x86) < 0 {
      break
    }
    var c = k + 1
    while c < ls.len() && ladder_label(ls[c]) {
      c += 1
    }
    if c >= ls.len() || !ladder_call(ls[c], x86) {
      break
    }
    n += 1
    j = c + 1
    end = j
  }
  (n, end)
}

/// The instructions of ls[a..b] (its labels left out), one per line.
fn ladder_key(ls: List[Str], a: Int, b: Int) -> Str {
  var out: List[Str] = []
  for k in a..b {
    if !ladder_label(ls[k]) {
      out.push(ls[k])
    }
  }
  out.join("\n")
}

/// outline_ladders on x86_64's text (x86_emit, after its text passes).
fn (var g: G) outline_ladders_x86(text: Str) -> Str {
  if !g.x86 || g.os == "windows" || !g.on("ladders") || !text.contains("(%rsp), %rdi\n") {
    return text
  }
  g.outline_ladders(text.split("\n")).join("\n")
}

/// Outlines the repeated ladders of one function's text (lines, after
/// the line passes). Off for windows (its unwind codes describe one
/// prologue a region) and XO_PASSES=-ladders. A far frame's slots past
/// sp's reach are read through x28 by then (far_slots_l), which no ladder
/// line matches; its near slots are sp's as elsewhere.
fn (var g: G) outline_ladders(lines: List[Str]) -> List[Str] {
  let x86 = g.x86
  if g.os == "windows" || !g.on("ladders") || !any_has(lines, if x86 { "(%rsp), %rdi" } else { "\tldr x0, [sp, #" }) {
    return lines
  }
  let ls = flat_lines(lines)
  // the runs, as (start, end, pairs), and how often each occurs
  var runs: List[(Int, Int, Int)] = []
  var count: Map[Str, Int] = {}
  var i = 0
  while i < ls.len() {
    if ladder_load(ls[i], x86) < 0 {
      i += 1
      continue
    }
    let (n, end) = ladder_run(ls, i, x86)
    if n == 0 {
      i += 1
      continue
    }
    if n >= LADDER_MIN {
      runs.push((i, end, n))
      let key = ladder_key(ls, i, end)
      count[key] = (count.get(key) ?? 0) + 1
    }
    i = end
  }
  var any = false
  for (_, c) in count {
    any = any || c >= 2
  }
  // the last region's end: the subroutines go before it
  var endp = -1
  for k in 0..ls.len() {
    if ls[k] == "\t.cfi_endproc" {
      endp = k
    }
  }
  if !any || endp < 0 {
    return lines
  }
  var subs: Map[Str, Str] = {}
  var sub_text: List[Str] = []
  var out: List[Str] = []
  var r = 0
  i = 0
  while i < ls.len() {
    if i == endp && !sub_text.is_empty() {
      out.push("\t.cfi_endproc")
      out.push("\t.cfi_startproc")
      for l in sub_text {
        out.push(l)
      }
    }
    if r < runs.len() && runs[r].0 == i {
      let (_, end, _) = runs[r]
      r += 1
      let key = ladder_key(ls, i, end)
      if (count.get(key) ?? 0) >= 2 {
        var lab = subs.get(key) ?? ""
        if lab == "" {
          lab = g.local("${g.lbl_prefix()}_ld${subs.len()}")
          subs[key] = lab
          sub_text.push("${lab}:")
          if x86 {
            sub_text.push("\tpushq %rbp")
            sub_text.push("\t.cfi_def_cfa_offset 16")
            sub_text.push("\t.cfi_offset %rbp, -16")
            sub_text.push("\tmovq %rsp, %rbp")
            sub_text.push("\t.cfi_def_cfa_register %rbp")
          } else {
            sub_text.push("\tstp x29, x30, [sp, #-16]!")
            sub_text.push("\t.cfi_def_cfa_offset 16")
            sub_text.push("\t.cfi_offset w30, -8")
            sub_text.push("\t.cfi_offset w29, -16")
            sub_text.push("\tmov x29, sp")
            sub_text.push("\t.cfi_def_cfa w29, 16")
          }
          for l in key.split("\n") {
            let off = ladder_load(l, x86)
            sub_text.push(if off >= 0 { ladder_load_text(off + 16, x86) } else { l })
          }
          if x86 {
            sub_text.push("\tpopq %rbp")
            sub_text.push("\t.cfi_def_cfa %rsp, 8")
            sub_text.push("\t.cfi_restore %rbp")
            sub_text.push("\tretq")
          } else {
            sub_text.push("\tldp x29, x30, [sp], #16")
            sub_text.push("\t.cfi_def_cfa sp, 0")
            sub_text.push("\t.cfi_restore w30")
            sub_text.push("\t.cfi_restore w29")
            sub_text.push("\tret")
          }
        }
        // the run's labels stay, at the call
        for k in i..end {
          if ladder_label(ls[k]) {
            out.push(ls[k])
          }
        }
        out.push(if x86 { "\tcallq ${lab}" } else { "\tbl ${lab}" })
        i = end
        continue
      }
    }
    out.push(ls[i])
    i += 1
  }
  out
}
