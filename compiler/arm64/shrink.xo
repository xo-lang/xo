// Shrink wrapping and tail calls (decision 0224): a function makes its
// frame (the frame record, the callee saved registers it uses, its
// slots) only on the paths that need it, so a path that returns without
// a call, a callee saved register, or a slot runs without the prologue
// and the epilogue (gotchas/arm64-call-anywhere-costs-frame.md); and a
// call whose results are returned as they are is a branch after the
// epilogue.
//
// Before register allocation, shrink_split finds the blocks that need
// the frame by their instructions alone (calls but tail calls, the $OUT
// slot, the frame's memory) and widens them to the region of blocks both
// reached from one and reaching one (a loop around a call is in it). The
// rest run without the frame. Each edge into the region gets a block
// that makes the frame (a save block), each edge out of it one that
// undoes it (a restore block). The registers named on both sides get new
// names inside the region, and the edge blocks copy those live across
// them, so a value live across one of the region's calls takes a callee
// saved register only inside the region. After allocation, shrink_plan
// keeps the plan when no block outside the region needs the frame (a
// callee saved register or a slot of the allocation); otherwise the
// frame is made at the entry as before and the edge blocks are plain
// copies. Emission lays the blocks without the frame out first, then the
// region with its edge blocks: the unwind rules change once, at the
// region's first block. A block without the frame returns with a bare
// `ret`, and its fault stubs make the whole frame first, so every stub
// unwinds by the frame's rules.

/// Whether inst needs the frame whatever the allocation: a call but a
/// tail call, the $OUT slot, the frame's memory.
fn needs_frame0(inst: Inst) -> Bool {
  if (inst.kind == K_CALL && !inst.tail) || inst.text.contains("$OUT") || inst.frame {
    return true
  }
  for a in inst.srcs {
    if a.kind == S_FRAME || a.kind == S_MEM {
      return true
    }
  }
  for a in inst.fargs {
    if a.kind == S_FRAME || a.kind == S_MEM {
      return true
    }
  }
  false
}

/// Whether a location list has a stack word (an argument or a result
/// past the registers: addressed from the frame's size).
fn stack_words(ls: List[Loc]) -> Bool {
  for l in ls {
    if l.reg < 0 {
      return true
    }
  }
  false
}

/// The blocks reached from the blocks of seed (included), forward along
/// the branches, or backward along them when back.
fn (g: G) reach(seed: List[Bool], preds: List[List[Int]], back: Bool) -> List[Bool] {
  var out: List[Bool] = List.with_capacity(seed.len())
  var work: List[Int] = []
  for (b, n) in seed.indexed() {
    out.push(n)
    if n {
      work.push(b)
    }
  }
  while !work.is_empty() {
    let b = work.pop() ?? 0
    let next = if back { preds[b] } else { g.msuccs(b) }
    for t in next {
      if !out[t] {
        out[t] = true
        work.push(t)
      }
    }
  }
  out
}

/// The most edges into and out of the region (each a copy of the
/// prologue or the epilogue).
const MAX_FRAME_EDGES = 6

/// The predecessors of each block along the branches.
fn (g: G) branch_preds(order: List[Int]) -> List[List[Int]] {
  var preds: List[List[Int]] = []
  for _ in 0..g.blocks.len() {
    preds.push([])
  }
  for b in order {
    for t in g.msuccs(b) {
      push_int(preds, t, b)
    }
  }
  preds
}

/// The region of the blocks of need: those both reached from one and
/// reaching one.
fn (g: G) frame_region(order: List[Int], need: List[Bool]) -> List[Bool] {
  let preds = g.branch_preds(order)
  let fwd = g.reach(need, preds, false)
  let bwd = g.reach(need, preds, true)
  var out: List[Bool] = List.with_capacity(need.len())
  for b in 0..need.len() {
    out.push(fwd[b] && bwd[b])
  }
  out
}

/// Whether the function can return without entering region: a return
/// or a tail call reached from the entry outside it.
fn (g: G) frameless_exit(order: List[Int], region: List[Bool]) -> Bool {
  let e = order[0]
  if region[e] {
    return false
  }
  var seen: List[Bool] = []
  for _ in 0..g.blocks.len() {
    seen.push(false)
  }
  seen[e] = true
  var work = [e]
  while !work.is_empty() {
    let b = work.pop() ?? 0
    for inst in g.blocks[b].insts {
      if inst.kind == K_RET || (inst.kind == K_CALL && inst.tail) {
        return true
      }
    }
    for t in g.msuccs(b) {
      if !region[t] && !seen[t] {
        seen[t] = true
        work.push(t)
      }
    }
  }
  false
}

fn rename_regs(vs: List[Int], m: List[Int]) -> List[Int] {
  var out: List[Int] = List.with_capacity(vs.len())
  for v in vs {
    out.push(m[v])
  }
  out
}

fn rename_srcs(ss: List[Src], m: List[Int]) -> List[Src] {
  var out: List[Src] = List.with_capacity(ss.len())
  for s in ss {
    var c = s
    if c.kind == S_REG {
      c.v = m[c.v]
    }
    out.push(c)
  }
  out
}

/// An edge between a block outside the region and one inside.
struct FEdge {
  from: Int
  to: Int
  /// 1: into the region (a save block), 2: out of it (a restore block)
  kind: Int
}

/// Plans shrink wrapping before register allocation (see the top of the
/// file).
fn (var g: G) shrink_split() {
  g.shrink = false
  g.pro = -1
  g.fedge = []
  g.region = []
  let order = g.hot + g.cold
  if order.is_empty() {
    return
  }
  let nb = g.blocks.len()
  var need: List[Bool] = List.with_capacity(nb)
  for _ in 0..nb {
    need.push(false)
  }
  var any = false
  for b in order {
    for inst in g.blocks[b].insts {
      // landing pads (decision 0085) and stack words keep the frame at
      // the entry
      if inst.pad >= 0 || (inst.kind == K_JUMP && inst.targets.len() > 1) {
        return
      }
      if inst.kind == K_ENTRY && stack_words(g.abi_locs(regs(inst.defs))) {
        return
      }
      if inst.kind == K_RET && stack_words(g.abi_locs(inst.srcs)) {
        return
      }
      if needs_frame0(inst) {
        need[b] = true
        any = true
      }
    }
  }
  if !any {
    return
  }
  let region = g.frame_region(order, need)
  if !g.frameless_exit(order, region) {
    return
  }
  var edges: List[FEdge] = []
  for b in order {
    for t in g.msuccs(b) {
      if region[b] != region[t] {
        var dup = false
        for e in edges {
          dup = dup || (e.from == b && e.to == t)
        }
        if !dup {
          edges.push(FEdge{from: b, to: t, kind: if region[t] { 1 } else { 2 }})
        }
      }
    }
  }
  if edges.len() > MAX_FRAME_EDGES {
    return
  }
  let n = g.fp.len()
  // the registers live into each block (regalloc's liveness)
  var idx: List[Int] = List.with_capacity(nb)
  for _ in 0..nb {
    idx.push(-1)
  }
  for (k, b) in order.indexed() {
    idx[b] = k
  }
  var gens: List[List[Int]] = []
  var kills: List[List[Int]] = []
  var succs: List[List[Int]] = []
  var kst: List[Int] = List.with_capacity(n)
  var ust: List[Int] = List.with_capacity(n)
  for _ in 0..n {
    kst.push(0)
    ust.push(0)
  }
  for (k, b) in order.indexed() {
    var gl: List[Int] = []
    var kl: List[Int] = []
    gen_kill(g.blocks[b].insts, k + 1, gl, kl, kst, ust)
    gens.push(gl)
    kills.push(kl)
    var ss: List[Int] = []
    for s in g.msuccs(b) {
      // a block outside the order (as x86_live and opt's liveness skip)
      if idx[s] >= 0 {
        ss.push(idx[s])
      }
    }
    succs.push(ss)
  }
  let lv = solve_live(succs, gens, kills, n)
  // the registers named on both sides: bit 1 outside, bit 2 inside
  var side: List[Int] = List.with_capacity(n)
  for _ in 0..n {
    side.push(0)
  }
  for b in order {
    let bit = if region[b] { 2 } else { 1 }
    // live through a side unnamed is on it too
    for v in lv.ins[idx[b]] {
      side[v] = side[v] | bit
    }
    for inst in g.blocks[b].insts {
      for d in inst.defs {
        side[d] = side[d] | bit
      }
      for u in inst.us {
        side[u] = side[u] | bit
      }
    }
  }
  var m: List[Int] = List.with_capacity(n)
  for v in 0..n {
    m.push(v)
  }
  for v in 1..n {
    if side[v] == 3 {
      m[v] = g.new_vreg(g.fp[v])
    }
  }
  for b in order {
    if !region[b] {
      continue
    }
    var out: List[Inst] = List.with_capacity(g.blocks[b].insts.len())
    for inst in g.blocks[b].insts {
      var c = inst
      c.defs = rename_regs(inst.defs, m)
      c.us = rename_regs(inst.us, m)
      c.srcs = rename_srcs(inst.srcs, m)
      c.fargs = rename_srcs(inst.fargs, m)
      out.push(c)
    }
    g.blocks[b].insts = out
  }
  // the edge blocks, each beside its block of the region in the layout
  var kind: List[Int] = List.with_capacity(nb)
  var reg: List[Bool] = List.with_capacity(nb)
  for b in 0..nb {
    kind.push(0)
    reg.push(region[b])
  }
  var before: Map[Int, List[Int]] = {}
  var after: Map[Int, List[Int]] = {}
  for e in edges {
    // laid out beside its block of the region, hot or cold as it is
    let cold = if e.kind == 1 { g.blocks[e.to].cold } else { g.blocks[e.from].cold }
    let x = g.blocks.len()
    g.blocks.push(MBlock{id: g.nblock, cold: cold})
    g.nblock += 1
    kind.push(e.kind)
    reg.push(true)
    var defs: List[Int] = []
    var srcs: List[Src] = []
    var us: List[Int] = []
    for v in lv.ins[idx[e.to]] {
      if v != 0 && m[v] != v {
        // into the region: the inside name from the outside one; out:
        // the reverse
        let (d, s) = if e.kind == 1 { (m[v], v) } else { (v, m[v]) }
        defs.push(d)
        srcs.push(rsrc(s))
        us.push(s)
      }
    }
    var ins: List[Inst] = []
    if !defs.is_empty() {
      ins.push(Inst{kind: K_PMOVE, defs: defs, srcs: srcs, us: us, nocoal: true})
    }
    ins.push(Inst{kind: K_JUMP, targets: [e.to]})
    g.blocks[x].insts = ins
    g.retarget(e.from, e.to, x)
    if e.kind == 1 {
      var l = before.get(e.to) ?? []
      l.push(x)
      before.put(e.to, l)
    } else {
      var l = after.get(e.from) ?? []
      l.push(x)
      after.put(e.from, l)
    }
  }
  g.hot = with_edges(g.hot, before, after)
  g.cold = with_edges(g.cold, before, after)
  g.fedge = kind
  g.region = reg
  g.shrink = true
}

/// The blocks of l with the edge blocks of each placed beside it (the
/// save blocks before, the restore blocks after).
fn with_edges(l: List[Int], before: Map[Int, List[Int]], after: Map[Int, List[Int]]) -> List[Int] {
  var out: List[Int] = []
  for b in l {
    for x in before.get(b) ?? [] {
      out.push(x)
    }
    out.push(b)
    for x in after.get(b) ?? [] {
      out.push(x)
    }
  }
  out
}

/// Points the branches of block b to t at x.
fn (var g: G) retarget(b: Int, t: Int, x: Int) {
  let k = g.term_at(b)
  var ts: List[Int] = []
  for y in g.blocks[b].insts[k].targets {
    ts.push(if y == t { x } else { y })
  }
  g.blocks[b].insts[k].targets = ts
}

/// Whether v's location is one the frame holds or saves.
fn (g: G) frame_loc(v: Int) -> Bool {
  if v == 0 {
    return false
  }
  let l = g.loc[v]
  if l.reg >= 0 {
    return g.is_callee_t(l.reg)
  }
  l.slot >= 0
}

/// Whether block b needs the frame after allocation.
fn (g: G) block_needs_frame(b: Int) -> Bool {
  for inst in g.blocks[b].insts {
    if needs_frame0(inst) {
      return true
    }
    for d in inst.defs {
      if g.frame_loc(d) {
        return true
      }
    }
    for u in inst.us {
      if g.frame_loc(u) {
        return true
      }
    }
  }
  false
}

/// Keeps the plan of shrink_split when the allocation allows it: sets
/// fl (the blocks without the frame) and pro (the first block laid out
/// with it), and lays the blocks without the frame out first.
fn (var g: G) shrink_plan() {
  if !g.shrink {
    return
  }
  g.shrink = false
  if g.fr.leaf || g.base != 0 {
    return
  }
  for b in g.order {
    if !g.region[b] && g.block_needs_frame(b) {
      return
    }
  }
  var fl: List[Bool] = List.with_capacity(g.blocks.len())
  for b in 0..g.blocks.len() {
    fl.push(!g.region[b])
  }
  var out: List[Int] = []
  for b in g.order {
    if fl[b] {
      out.push(b)
    }
  }
  for b in g.order {
    if !fl[b] {
      if g.pro < 0 {
        g.pro = b
      }
      out.push(b)
    }
  }
  g.fl = fl
  g.order = out
  g.shrink = true
}

/// Whether block t runs with the frame exactly when the current block
/// does: a branch may copy t's code or go past its head only then.
fn (g: G) same_frame(t: Int) -> Bool {
  !g.shrink || g.fl[t] == g.fl[g.cur]
}

/// Whether b is a save or restore block (never skipped by fwd).
fn (g: G) edge_block(b: Int) -> Bool {
  b < g.fedge.len() && g.fedge[b] != 0
}

// ---------------------------------------------------------------------------
// Tail calls

/// Marks the tail calls of the function: calls whose results are the
/// function's, returned by nothing but moves and jumps after them. A
/// tail call is emitted as the frame undone and a branch, so a block
/// whose only call is one needs no frame, and a function whose only
/// calls are tail calls is a leaf. Not when the frame holds memory a
/// callee may be given the address of (byref.xo, the $OUT slot).
fn (var g: G) mark_tails() {
  if g.mem_bytes != 0 || g.out {
    return
  }
  for b in g.hot + g.cold {
    let n = g.blocks[b].insts.len()
    for k in 0..n {
      if g.blocks[b].insts[k].kind == K_CALL && g.tail_call(b, k) {
        g.blocks[b].insts[k].tail = true
      }
    }
  }
}

/// Whether call k of block b is a tail call (mark_tails).
fn (g: G) tail_call(b: Int, k: Int) -> Bool {
  let c = g.blocks[b].insts[k]
  if c.noret || c.svc || c.pad >= 0 || c.vfix >= 0 {
    return false
  }
  for a in c.srcs {
    if a.kind == S_FRAME || a.kind == S_MEM {
      return false
    }
  }
  // the arguments' locations (x86_64's differ from its results')
  if stack_words(g.call_locs(c.srcs, -1)) || stack_words(g.abi_locs(regs(c.defs))) {
    return false
  }
  // the registers holding each result word, through the moves
  var cur = c.defs
  var blk = b
  var i = k + 1
  for _ in 0..32 {
    let ins = g.blocks[blk].insts
    if i >= ins.len() {
      return false
    }
    let x = ins[i]
    if x.kind == K_PMOVE {
      var nxt: List[Int] = []
      for v in cur {
        var to = -1
        for (q, d) in x.defs.indexed() {
          let s = x.srcs[q]
          if s.kind == S_REG && s.v == v {
            to = d
          }
        }
        if to < 0 {
          for d in x.defs {
            if d == v {
              return false
            }
          }
          to = v
        }
        nxt.push(to)
      }
      cur = nxt
      i += 1
    } else if x.kind == K_JUMP {
      if x.targets.len() != 1 {
        return false
      }
      blk = x.targets[0]
      i = 0
    } else if x.kind == K_RET {
      if x.srcs.len() != cur.len() {
        return false
      }
      for (j, s) in x.srcs.indexed() {
        if s.kind != S_REG || s.v != cur[j] {
          return false
        }
      }
      return true
    } else {
      return false
    }
  }
  false
}

/// Whether block r is parallel moves and a return (a restore block
/// copies it instead of branching to it).
fn (g: G) only_return(r: Int) -> Bool {
  let ins = g.blocks[r].insts
  let n = ins.len()
  if n == 0 || ins[n - 1].kind != K_RET {
    return false
  }
  for k in 0..n - 1 {
    if ins[k].kind != K_PMOVE {
      return false
    }
  }
  true
}
