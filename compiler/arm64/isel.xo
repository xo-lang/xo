// Instruction selection (internal/arm64 isel.go): SSA values to MIR over
// virtual registers, block by block in reverse postorder.

use github.com/xo-lang/xo/compiler/ssa

/// The least heap leaves of a struct held in memory whose release calls
/// its type's mem_drop helper; fewer are released one by one.
const MEM_DROP_LEAVES = 1
/// An enum of more words than this, held in memory, is counted through
/// its helper's pointer form (rc_at).
const RC_AT_WORDS = 8

/// Generates function fi: instruction selection, the MIR passes,
/// register allocation, and emission (function).
fn (var g: G) function(fi: Int) {
  let why = g.unsupported(fi)
  if !why.is_empty() {
    // the label numbers of later functions are kept
    g.nfunc += 1
    g.skipped.push("${g.m.funcs[fi].name}: ${why}")
    return
  }
  g.fn_strs = {}
  g.begin_func(fi)
  g.isel()
  // the optional passes (passes.xo) unless $XO_PASSES turns them off
  if g.on("mir_dce") {
    g.dce()
  }
  if g.on("thread_const") {
    g.thread_const()
  }
  if g.on("thread_cset") {
    g.thread_cset()
  }
  if g.on("thread") {
    g.thread()
  }
  // a jump table's addresses are data in the text section
  if g.on("jump_tables") {
    g.jump_tables()
  }
  if g.on("mir_dce") {
    g.dce()
  }
  if g.on("live_dce") {
    g.live_dce()
  }
  if g.on("select_compares") {
    g.select_compares()
  }
  // decision 0323: before the hoisting passes (a pack of loop invariant
  // scalars is built once, outside the loop) and cluster_mem
  if g.on("slp_f64") {
    g.slp_f64()
  }
  if g.on("hoist_consts") {
    g.hoist_consts()
  }
  if g.on("hoist_invariants") {
    g.hoist_invariants()
  }
  if g.on("copy_prop") {
    g.copy_prop()
  }
  if g.on("reuse_loads") {
    g.reuse_loads()
  }
  // ThreadSanitizer's calls (decision 0273), before the passes that
  // assume a call free stretch (reuse_flags, mark_tails, shrink_split);
  // on x86_64 too: its calls and address arithmetic are arm64 templates
  // that x86_retarget rewrites as it does the rest
  if g.m.race {
    g.race_instrument()
  }
  if g.x86 {
    // x86_64 (decision 0254): each branch keeps its compare (no reused
    // flags); the templates become x86
    if g.on("tail_dup") {
      g.tail_dup()
    }
    if g.on("place_latches") {
      g.place_latches()
    }
    if g.on("mark_tails") {
      g.mark_tails()
    }
    if g.on("x86_merge_blocks") {
      g.x86_merge_blocks()
    }
    if g.on("shrink_split") {
      g.shrink_split()
    }
    if g.on("x86_mul_pair") {
      g.x86_mul_pair()
    }
    g.x86_retarget()
    if g.on("x86_const_imm") {
      g.x86_const_imm()
    }
    if g.on("x86_sink_loads") {
      g.x86_sink_loads()
    }
    // a load folded into several reads whose base was then spilled
    // reloads the base at each read (2026-10-21: nistec.mul4p's
    // multiplier word into four mulq, 217 to 232 instructions): those
    // loads stay loads, and the function is allocated again
    let before_fold = g.blocks
    if g.on("x86_fold_loads") {
      g.x86_fold_loads()
    }
    if g.on("x86_carry_fuse") {
      g.x86_carry_fuse()
    }
    g.regalloc()
    var refold = false
    for (v, base) in g.fold_multi {
      if base > 0 && base < g.loc.len() && g.loc[base].reg < 0 {
        g.fold_skip[v] = true
        refold = true
      }
    }
    if refold {
      g.blocks = before_fold
      g.fold_multi = []
      if g.on("x86_fold_loads") {
        g.x86_fold_loads()
      }
      if g.on("x86_carry_fuse") {
        g.x86_carry_fuse()
      }
      g.regalloc()
    }
    g.dump_named()
    g.x86_emit()
    return
  }
  if g.on("tail_dup") {
    g.tail_dup()
  }
  if g.on("reuse_flags") {
    g.reuse_flags()
  }
  if g.on("place_latches") {
    g.place_latches()
  }
  if g.on("mark_tails") {
    g.mark_tails()
  }
  if g.on("shrink_split") {
    g.shrink_split()
  }
  if g.on("cluster_mem") {
    g.cluster_mem()
  }
  g.regalloc()
  g.dump_named()
  g.emit()
}

/// Whether optional pass name is on (passes.xo, $XO_PASSES).
fn (g: G) on(name: Str) -> Bool {
  if name == "shrink_split" && g.x86 && g.os == "windows" {
    // the Win64 unwind data describes one prologue, at the function's
    // start (x86win.xo)
    return false
  }
  g.m.passes_off.is_empty() || pass_on(g.m, name)
}

fn (var g: G) new_vreg(fp: Bool) -> Int {
  g.fp.push(fp)
  g.fp.len() - 1
}

/// A wide vreg: two doubles in a V register (decision 0323).
fn (var g: G) new_wide() -> Int {
  let v = g.new_vreg(true)
  g.wide[v] = true
  v
}

fn (var g: G) new_vregs(lay: List[Bool]) -> List[Int] {
  var out: List[Int] = []
  for fp in lay {
    out.push(g.new_vreg(fp))
  }
  out
}

fn (var g: G) new_block(cold: Bool) -> Int {
  let i = g.blocks.len()
  g.blocks.push(MBlock{id: g.nblock, cold: cold})
  g.nblock += 1
  if cold {
    g.cold.push(i)
  } else {
    g.hot.push(i)
  }
  i
}

/// Appends an instruction to the current block and returns its index
/// there.
fn (var g: G) add(inst: Inst) -> Int {
  var x = inst
  if x.line == 0 {
    x.line = g.cur_line
    x.inl = g.cur_inl
  }
  if x.kind == K_CALL && g.cur_pad >= 0 {
    x.pad = g.cur_pad
  }
  // in place (decision 0169); take_insts allocated an empty list per
  // instruction (bench/results/xo1-speed-2026-10-13.md)
  let b = g.cur
  g.blocks[b].insts.push(x)
  g.blocks[b].insts.len() - 1
}

/// Takes the instructions of block b out of it, for an update in place:
/// put them back with put_insts. An update of a list inside a list
/// element copies the inner list on the native backends
/// (gotchas/xo-native-nested-element-update.md).
fn (var g: G) take_insts(b: Int) -> List[Inst] {
  let ins = g.blocks[b].insts
  g.blocks[b].insts = []
  ins
}

fn (var g: G) put_insts(b: Int, ins: List[Inst]) {
  g.blocks[b].insts = ins
}

/// u, or a fresh register holding zero when u is xzr (for operand
/// positions where register 31 is not the zero register).
fn (var g: G) real(u: Int) -> Int {
  if u != 0 {
    return u
  }
  g.def1(false, "mov $d0, #0", [])
}

/// Adds an instruction with a template; returns its index in the block.
fn (var g: G) plain(text: Str, defs: List[Int], us: List[Int]) -> Int {
  // the uses as given unless one is xzr: no copy per instruction
  var has_zero = false
  for u in us {
    if u == 0 {
      has_zero = true
    }
  }
  if !has_zero {
    return g.add(Inst{kind: K_PLAIN, text: text, defs: defs, us: us})
  }
  var rs: List[Int] = []
  for u in us {
    rs.push(g.real(u))
  }
  g.add(Inst{kind: K_PLAIN, text: text, defs: defs, us: rs})
}

/// Adds an instruction defining one new register of class fp.
fn (var g: G) def1(fp: Bool, text: Str, us: List[Int]) -> Int {
  let d = g.new_vreg(fp)
  let _i = g.plain(text, [d], us)
  d
}

/// Gives instruction i of the current block the fault side exit.
fn (var g: G) set_fault(i: Int, cond: Str, fname: Str, args: List[Src]) {
  let sym = g.sym(fault_entry(fname))
  let pad = g.cur_pad
  let b = g.cur
  g.blocks[b].insts[i].has_fault = true
  g.blocks[b].insts[i].fcond = cond
  g.blocks[b].insts[i].ffn = sym
  g.blocks[b].insts[i].fargs = args
  g.blocks[b].insts[i].pad = pad
  for a in args {
    if a.kind == S_REG && a.v != 0 {
      g.blocks[b].insts[i].us.push(a.v)
    }
  }
}

/// The symbol of the fault entry point the C runtime named fname
/// (xo_fault_index, xo_fault): the runtime's Xo export that writes the
/// message and raises (std/native/llrt/cabi.xo fault_raise_*, decision
/// 0228), xo_x_fault_raise_index and xo_x_fault_raise_text.
pub fn fault_entry(fname: Str) -> Str {
  if fname == "xo_fault" {
    return "xo_x_fault_raise_text"
  }
  "xo_x_fault_raise_${fname.trim_prefix("xo_fault_")}"
}

/// Adds a flag setting instruction with a fault side exit.
fn (var g: G) check(text: Str, us: List[Int], cond: Str, fname: Str, args: List[Src]) {
  let i = g.plain(text, [], us)
  g.set_fault(i, cond, fname, args)
}

/// Adds an instruction defining one register, with a fault side exit;
/// the result never shares a register with the operands, which the
/// fault stub reads. recover names how the stub gets back an operand
/// whose register the result took ("add", "sub", "neg"); with none, the
/// result is early.
fn (var g: G) checked(fp: Bool, text: Str, us: List[Int], recover: Str, cond: Str, fname: Str, args: List[Src]) -> Int {
  let d = g.new_vreg(fp)
  let i = g.plain(text, [d], us)
  let b = g.cur
  let rs = g.blocks[b].insts[i].us
  if recover.is_empty() || (rs.len() == 2 && rs[0] == rs[1]) {
    g.blocks[b].insts[i].early = true
  } else {
    g.blocks[b].insts[i].recover = recover
  }
  g.set_fault(i, cond, fname, args)
  d
}

/// Adds a call of symbol sym (already prefixed) and returns the result
/// registers.
fn (var g: G) call(sym: Str, args: List[Src], res: List[Bool]) -> List[Int] {
  let defs = g.new_vregs(res)
  var us: List[Int] = []
  for a in args {
    if a.kind == S_REG && a.v != 0 {
      us.push(a.v)
    }
    if a.kind == S_FRAME {
      g.out = true
    }
  }
  let _i = g.add(Inst{kind: K_CALL, sym: sym, srcs: args, defs: defs, us: us})
  g.clobber()
  defs
}

/// A call of the runtime function name.
fn (var g: G) rt(name: Str, args: List[Src], res: List[Bool]) -> List[Int] {
  g.call(g.sym(name), args, res)
}

fn (var g: G) imm(n: Int) -> Int {
  let r = g.konst(g.def1(false, mov_imm(n), []))
  g.kvals[r] = n
  if g.m.debug_info {
    g.kints[r] = n
  }
  r
}

/// Marks the instruction that just defined d as a constant (loop
/// invariant: hoist_consts may move it out of a loop).
fn (var g: G) konst(d: Int) -> Int {
  let b = g.cur
  let n = g.blocks[b].insts.len()
  g.blocks[b].insts[n - 1].konst = true
  d
}

/// imm, shared within the block.
fn (var g: G) cimm(n: Int) -> Int {
  let _mi = g.m_()
  if let Some(r) = g.cm.ci.get(n) {
    return r
  }
  let r = g.imm(n)
  g.cm.ci[n] = r
  r
}

/// Puts the double with bits b in a floating point register.
fn (var g: G) fimm(bits: Int) -> Int {
  if bits == 0 {
    return g.konst(g.def1(true, "fmov $d0, xzr", []))
  }
  let t = g.imm(bits)
  g.konst(g.def1(true, "fmov $d0, $u0", [t]))
}

/// Puts the address of a symbol in a register.
fn (var g: G) sym_addr(sym: Str) -> Int {
  let r = if g.os == "darwin" {
    g.konst(g.def1(false, "adrp $d0, ${sym}@PAGE\nadd $d0, $d0, ${sym}@PAGEOFF", []))
  } else {
    g.konst(g.def1(false, "adrp $d0, ${sym}\nadd $d0, $d0, :lo12:${sym}", []))
  }
  if g.m.debug_info {
    g.ksyms[r] = sym
  }
  r
}

/// sym_addr plus off bytes, as one constant.
fn (var g: G) sym_addr_off(sym: Str, off: Int) -> Int {
  if off == 0 {
    return g.sym_addr(sym)
  }
  if g.x86 {
    // the x86 translation keeps the base and the add apart
    return g.def1(false, "add $d0, $u0, #${off}", [g.real(g.sym_addr(sym))])
  }
  let r = if g.os == "darwin" {
    g.konst(g.def1(false, "adrp $d0, ${sym}@PAGE\nadd $d0, $d0, ${sym}@PAGEOFF\nadd $d0, $d0, #${off}", []))
  } else {
    g.konst(g.def1(false, "adrp $d0, ${sym}\nadd $d0, $d0, :lo12:${sym}\nadd $d0, $d0, #${off}", []))
  }
  r
}

/// The bytes of a string or Bytes constant.
fn const_bytes(a: ssa.Aux) -> Bytes? {
  match a {
    S(s) => Some(s.bytes())
    Bs(b) => Some(b)
    _ => None
  }
}

/// Zero registers of t's layout (a placeholder after a failure).
fn (var g: G) zeros(t: Int) -> List[Int] {
  var out: List[Int] = []
  for _ in g.layout(t) {
    out.push(0)
  }
  out
}

/// The registers of SSA value v (constants are put in registers where
/// they are used).
fn (var g: G) words(v: Int) -> List[Int] {
  let x = g.f.values[v]
  if x.op == ssa.Op.Const {
    let _mi = g.m_()
    match x.aux {
      I(n) => {
        if let Some(r) = g.cm.ci.get(n) {
          return [r]
        }
        let r = g.cimm(n)
        g.cm.ci[n] = r
        return [r]
      }
      F(f) => {
        let key = float_key(f)
        if let Some(r) = g.cm.cf.get(key) {
          return [r]
        }
        let r = g.fimm(float_bits(f))
        g.cm.cf[key] = r
        return [r]
      }
      B(b) => {
        if let Some(r) = g.cm.cb.get(b) {
          return [r]
        }
        let r = g.cimm(if b { 1 } else { 0 })
        g.cm.cb[b] = r
        return [r]
      }
      S(..) | Bs(..) => {
        let bs = const_bytes(x.aux) ?? b""
        if let Some(r) = g.cm.cs.get(bs) {
          return [r, g.cimm(bs.len())]
        }
        let r = g.sym_addr(g.str_obj(bs))
        g.cm.cs[bs] = r
        g.lit_objs[r] = true
        return [r, g.cimm(bs.len())]
      }
      _ => {
        g.fail("constant in ${g.f.name}")
        return g.zeros(x.ty)
      }
    }
  }
  if let Some(ptr) = g.stable.get(v) {
    return g.load_words(ptr, 0, g.layout(x.ty))
  }
  if g.has_held {
    if let Some(m) = g.held.mem_only.get(v) {
      // held in memory at every use: loaded where it is needed whole
      return g.load_words(g.held.mems[m].ptr, 0, g.layout(x.ty))
    }
  }
  if g.has_val[v] {
    return g.vals[v]
  }
  if x.ty < 0 || g.nwords(x.ty) == 0 {
    return []
  }
  g.fail("v${v} in ${g.f.name} used before it is defined")
  g.zeros(x.ty)
}

fn (var g: G) word(v: Int) -> Int {
  let ws = g.words(v)
  if ws.is_empty() {
    g.fail("v${v} in ${g.f.name} has no words")
    return g.real(0)
  }
  g.real(ws[0])
}

fn (var g: G) set(v: Int, ws: List[Int]) {
  g.vals[v] = ws
  g.has_val[v] = true
}

// ---------------------------------------------------------------------------
// Functions and blocks

/// The SSA blocks of the function in reverse postorder from the entry
/// (rpo: a depth first walk over the successors last to first).
fn rpo_of(f: ssa.Func) -> List[Int] {
  let n = f.blocks.len()
  var seen: List[Bool] = []
  for _ in 0..n {
    seen.push(false)
  }
  var post: List[Int] = []
  // the walk's frames: a block and the successor index to try next
  var stack: List[(Int, Int)] = []
  seen[0] = true
  stack.push((0, rpo_succs(f, 0).len() - 1))
  while !stack.is_empty() {
    let top = stack.len() - 1
    let (b, i) = stack[top]
    if i < 0 {
      post.push(b)
      let _p = stack.pop()
      continue
    }
    stack[top] = (b, i - 1)
    let to = rpo_succs(f, b)[i]
    if !seen[to] {
      seen[to] = true
      stack.push((to, rpo_succs(f, to).len() - 1))
    }
  }
  var out: List[Int] = []
  var k = post.len() - 1
  while k >= 0 {
    out.push(post[k])
    k -= 1
  }
  out
}

/// The successor blocks of SSA block b.
fn rpo_succs(f: ssa.Func, b: Int) -> List[Int] {
  let t = f.term(b)
  if t < 0 {
    return []
  }
  var out: List[Int] = []
  for e in f.values[t].succs {
    out.push(f.edges[e].to)
  }
  out
}

/// Whether argument j of x only reads the text of a Bytes that is a
/// borrowed Str (--inline-str, decision 0370): Bytes.len, Bytes.is_empty
/// and b[i], which read through the Str's own (tag tested) address, and
/// the reference counts of the value. Any call, store, return or block
/// argument is an escape, whatever the callee: a Bytes made from an inline
/// Str is then an object.
fn (g: G) reads_borrowed(x: ssa.Value, j: Int) -> Bool {
  if x.op is ssa.Op.Retain | ssa.Op.Release | ssa.Op.Drop | ssa.Op.Share {
    return true
  }
  if x.op != ssa.Op.Call || j != 0 {
    return false
  }
  aux_str(x.aux) is "bytes.index" | "Str.len" | "Str.is_empty"
}

fn (var g: G) isel() {
  let nb = g.f.blocks.len()
  for b in 0..nb {
    for v in g.f.blocks[b].instrs {
      let xv = g.f.values[v]
      for j in 0..xv.args.len() {
        let a = xv.args[j]
        g.nuses[a] += 1
        g.users[a] = v
        if g.inl_str() && !g.reads_borrowed(xv, j) {
          g.escapes[a] = true
        }
      }
      if xv.op == ssa.Op.Call && xv.args.len() >= 2 && (aux_str(xv.aux) is "list.index" | "list.set" | "list.take") {
        let ix = g.f.values[xv.args[1]]
        if ix.op == ssa.Op.Add || ix.op == ssa.Op.Sub {
          for j in 0..2 {
            let (_, kc) = g.const_int(ix.args[1 - j])
            if kc && (j == 0 || ix.op == ssa.Op.Add) {
              g.off_bases[ix.args[j]] = true
              break
            }
          }
        }
      }
      for e in g.f.values[v].succs {
        for a in g.f.edges[e].args {
          g.nuses[a] += 1
          g.escapes[a] = true
        }
      }
    }
  }
  // a branch on a negated Bool read only there branches on the Bool with
  // its targets swapped (2026-10-20: portable checked's `?? 1` and
  // checked_add tested `!fits`, a compare made into a word, an xor, and
  // a test, where the compare and a jump do); the Not is left unread
  for b in 0..nb {
    let t = g.f.term(b)
    if t < 0 || g.f.values[t].op != ssa.Op.Branch || g.f.values[t].succs.len() != 2 || g.f.values[t].pad >= 0 {
      continue
    }
    let n = g.f.values[t].args[0]
    let nv = g.f.values[n]
    if nv.op != ssa.Op.Not || nv.args.len() != 1 || g.nuses[n] != 1 || nv.ty < 0 || g.kind(nv.ty) != ssa.Kind.Bool {
      continue
    }
    let c = nv.args[0]
    // only a compare (not rt.landing, whose branch keeps its order)
    if !(g.f.values[c].op is ssa.Op.Eq | ssa.Op.Ne | ssa.Op.Lt | ssa.Op.Le | ssa.Op.Gt | ssa.Op.Ge) {
      continue
    }
    g.f.values[t].args[0] = c
    let s0 = g.f.values[t].succs[0]
    g.f.values[t].succs[0] = g.f.values[t].succs[1]
    g.f.values[t].succs[1] = s0
    g.nuses[n] = 0
    g.users[c] = t
  }
  // the blocks landing pads enter (decision 0085)
  for b in 0..nb {
    for v in g.f.blocks[b].instrs {
      let w = g.f.values[v].pad
      if w >= 0 {
        g.pads[g.pad_target(w)] = true
      }
    }
  }
  let blocks = rpo_of(g.f)
  // what only landing pads reach (the cleanup, the unwind exit) is laid
  // out with the cold code too
  var cold: List[Bool] = []
  var any_cold = false
  for b in 0..nb {
    cold.push(g.pads[b])
    any_cold = any_cold || g.pads[b]
  }
  var changed = any_cold
  while changed {
    changed = false
    for b in blocks {
      if cold[b] || g.f.blocks[b].preds.is_empty() {
        continue
      }
      var all = true
      for e in g.f.blocks[b].preds {
        all = all && cold[g.f.edges[e].from]
      }
      if all {
        cold[b] = true
        changed = true
      }
    }
  }
  let ptrs = g.plan_held()
  let idom = dominators_of(g.f, blocks)
  g.proof = new_proof(g.f, blocks)
  if g.on("lsr") {
    g.plan_lsr(blocks, idom)
  } else {
    g.lsr = {}
    g.plans = []
  }
  if g.on("ranges") {
    g.compute_ranges(blocks, idom)
  } else {
    // nothing known of any value's interval
    g.ranges = []
    g.has_range = []
    for _ in 0..g.f.values.len() {
      g.ranges.push(Interval{lo: 0, hi: 0})
      g.has_range.push(false)
    }
  }
  if g.on("ranges") {
    g.fold_decided(blocks, idom)
  }
  if g.on("push_runs") {
    g.plan_push_runs(blocks)
  } else {
    g.push_run = {}
    g.push_skip = {}
    g.push_alias = {}
  }
  // a block's place in the order: a predecessor at or past it is a back
  // edge (a loop header's Float32 parameters stay single, decision 0361)
  var pos: Map[Int, Int] = {}
  for (k, b) in blocks.indexed() {
    pos[b] = k
  }
  for b in blocks {
    g.bmap[b] = g.blocks.len()
    g.blocks.push(MBlock{id: 0})
    if b != 0 {
      var header = false
      for e in g.f.blocks[b].preds {
        if (pos.get(g.f.edges[e].from) ?? -1) >= (pos.get(b) ?? 0) {
          header = true
        }
      }
      for p in g.f.blocks[b].params {
        g.set(p, g.new_vregs(g.layout(g.vty(p))))
        if header && g.is_f32(g.vty(p)) {
          // the loop carried Float32 (an accumulator) in single
          // precision too: the edges move its single form
          // (f32_param_move), and its Float32 operations read it
          g.f32s[p] = g.new_vreg(true)
        }
        if g.vkind(p) == ssa.Kind.List {
          // the list's length travels with it (see opt.xo)
          let c = g.new_vreg(false)
          g.len_param[g.vals[p][0]] = c
        }
      }
      g.lsr_params(b)
      for p in g.f.blocks[b].params {
        if g.mem_only(p) >= 0 {
          g.has_val[p] = false
        }
      }
    }
  }
  for (i, b) in blocks.indexed() {
    let mb = g.bmap[b]
    g.blocks[mb].id = g.nblock
    g.nblock += 1
    g.cur = mb
    if cold[b] {
      g.blocks[mb].cold = true
      g.cold.push(mb)
    } else {
      g.hot.push(mb)
    }
    if g.pads[b] {
      // entered by the unwinder after a fault: nothing computed before
      // it in registers is known to hold (the operation that faulted did
      // not finish)
      g.drop_memo()
    } else {
      let preds = g.f.blocks[b].preds
      let (jp, jc, jtruth, jok) = g.join_source(b)
      if jok {
        // b is reached from jp through a join that only branches on the
        // Bool jp passes (`a && b`, decision 0184): jp's facts hold, but
        // jp does not dominate b, so the registers it computed come only
        // from b's dominator, as below
        // (gotchas/arm64-vreg-read-before-write-break-flag.md)
        if idom[b] >= 0 && g.end_memo[idom[b]] >= 0 {
          g.inherit(g.end_memo[idom[b]])
          g.clobber()
        }
        g.join_facts(g.end_memo[jp])
        g.cond_facts(jc, jtruth)
      } else if preds.len() == 1 && g.end_memo[g.f.edges[preds[0]].from] >= 0 {
        // the only predecessor dominates b: what it computed holds
        g.inherit(g.end_memo[g.f.edges[preds[0]].from])
        g.branch_facts(b)
      } else if idom[b] >= 0 && g.end_memo[idom[b]] >= 0 {
        // so do the facts of the immediate dominator, except what memory
        // held (a path from it may have stored)
        g.inherit(g.end_memo[idom[b]])
        g.clobber()
      }
    }
    if i > 0 {
      for p in g.f.blocks[b].params {
        if g.vkind(p) != ssa.Kind.List || !g.has_val[p] {
          continue
        }
        let r = g.vals[p][0]
        if let Some(c) = g.len_param.get(r) {
          let _mi = g.m_()
          g.cm.lens[r] = c
        }
      }
    }
    g.lsr_header(b)
    if i == 0 {
      var defs: List[Int] = []
      for (k, p) in g.f.blocks[b].params.indexed() {
        if let Some(ptr) = ptrs.get(k) {
          defs.push(ptr)
          continue
        }
        let ws = g.new_vregs(g.layout(g.vty(p)))
        g.set(p, ws)
        for w in ws {
          defs.push(w)
        }
      }
      let _e = g.add(Inst{kind: K_ENTRY, defs: defs})
      for (r, off) in g.frame_homes {
        g.pmove_srcs([r], [Src{kind: S_MEM, imm: off}])
      }
      if g.has_ref_ptr {
        g.by_ref_entry(ptrs)
      }
      for p in g.f.blocks[b].params {
        if g.vkind(p) == ssa.Kind.List {
          // known for the whole function (dead code removes the load
          // when nothing uses it)
          let _n = g.list_len(g.vals[p][0])
        }
      }
    }
    if g.spec.contains(b) {
      // an if-conversion selected its instructions into its predecessor
      // or left it unreachable: nothing to select (selecting it would
      // run the if-conversions of its own branch, which can mark a block
      // the new path reaches), only its memo for the blocks it dominates
      g.end_memo[b] = g.m_()
      let _t = g.add(Inst{kind: K_TRAP})
      continue
    }
    g.cur_sb = b
    for (ix, v) in g.f.blocks[b].instrs.indexed() {
      g.cur_ix = ix
      g.instr(v)
    }
    g.cur_sb = -1
  }
}

/// The block a branch along edge e goes to: the target itself, or a new
/// block with the parallel move of e's arguments.
fn (var g: G) edge(e: Int) -> Int {
  let to = g.bmap[g.f.edges[e].to]
  let (dsts, srcs) = g.edge_moves(e)
  if dsts.is_empty() {
    return to
  }
  let save = g.cur
  let b = g.new_block(false)
  g.cur = b
  g.pmove(dsts, srcs)
  let _j = g.add(Inst{kind: K_JUMP, targets: [to]})
  g.cur = save
  b
}

fn (var g: G) edge_moves(e: Int) -> (List[Int], List[Src]) {
  var dsts: List[Int] = []
  var srcs: List[Src] = []
  let to = g.f.edges[e].to
  let ps = g.f.blocks[to].params
  for (i, p) in ps.indexed() {
    let m = g.mem_only(p)
    if m >= 0 {
      // passed in place; an edge whose memory holds another value
      // stores the argument there (byref.xo held_in)
      let a = g.f.edges[e].args[i]
      if let Some(es) = g.held.edge.get(e) {
        if es[m] != g.key_of(a) {
          g.store_words_at(g.held.mems[m].ptr, 0, g.words(a))
        }
      }
      continue
    }
    // a parameter in registers whose memory the target still counts as
    // holding it (a frame home takes a loop's parameter when its back
    // edge passes it in place, byref.xo held_in): the memory is filled
    // here too, or a call after the loop's exit passes a home no path
    // wrote (ModCtx.load's check_effects when no hash was checked)
    let hm = g.param_home(to, p)
    if hm >= 0 {
      let a = g.f.edges[e].args[i]
      if let Some(es) = g.held.edge.get(e) {
        if es[hm] != g.key_of(a) {
          g.store_words_at(g.held.mems[hm].ptr, 0, g.words(a))
        }
      }
    }
    let pw = g.vals[p]
    let aw = g.words(g.f.edges[e].args[i])
    for k in 0..pw.len() {
      if pw[k] == aw[k] {
        continue
      }
      dsts.push(pw[k])
      srcs.push(rsrc(aw[k]))
    }
    g.f32_param_move(p, g.f.edges[e].args[i], dsts, srcs)
    if g.vkind(p) != ssa.Kind.List {
      continue
    }
    if let Some(c) = g.len_param.get(pw[0]) {
      let n = g.list_len(aw[0])
      if n != c {
        dsts.push(c)
        srcs.push(rsrc(n))
      }
    }
  }
  g.lsr_moves(e, dsts, srcs)
}

fn (var g: G) pmove(dsts: List[Int], srcs: List[Src]) {
  if dsts.is_empty() {
    return
  }
  g.pmove_srcs(dsts, srcs)
}

/// A parallel move whose sources may be immediates.
fn (var g: G) pmove_srcs(dsts: List[Int], srcs: List[Src]) {
  var us: List[Int] = []
  for a in srcs {
    if a.kind == S_REG && a.v != 0 {
      us.push(a.v)
    }
  }
  let _i = g.add(Inst{kind: K_PMOVE, defs: dsts, srcs: srcs, us: us})
}

// ---------------------------------------------------------------------------
// Instructions

fn is_compare(o: ssa.Op) -> Bool {
  o is ssa.Op.Eq | ssa.Op.Ne | ssa.Op.Lt | ssa.Op.Le | ssa.Op.Gt | ssa.Op.Ge
}

fn int_cond(o: ssa.Op) -> Str {
  match o {
    Eq => "eq"
    Ne => "ne"
    Lt => "lt"
    Le => "le"
    Gt => "gt"
    Ge => "ge"
    _ => ""
  }
}

fn uint_cond(o: ssa.Op) -> Str {
  match o {
    Eq => "eq"
    Ne => "ne"
    Lt => "lo"
    Le => "ls"
    Gt => "hi"
    Ge => "hs"
    _ => ""
  }
}

/// Whether v is the constant +0.0 (fcmp's #0.0).
fn (g: G) is_pos_zero(v: Int) -> Bool {
  if g.f.values[v].op != ssa.Op.Const {
    return false
  }
  match g.f.values[v].aux {
    F(x) => x == 0.0 && 1.0 / x > 0.0
    _ => false
  }
}

/// Whether v is a Float constant other than NaN.
fn (g: G) not_nan_const(v: Int) -> Bool {
  if g.f.values[v].op != ssa.Op.Const {
    return false
  }
  match g.f.values[v].aux {
    F(x) => !x.is_nan()
    _ => false
  }
}

/// A flag setting compare: its text, its uses, and the condition under
/// which it holds.
struct Cmp {
  text: Str
  us: List[Int]
  cond: Str
}

/// `<`, `<=`, `>`, `>=` on Floats in the total order of std.md 1
/// (floatOrder; decision 0053).
fn (var g: G) float_order(o: ssa.Op, a: Int, b: Int) -> Cmp {
  if g.not_nan_const(b) {
    let cond = match o {
      Lt => "mi"
      Le => "ls"
      Gt => "hi"
      _ => "hs"
    }
    if g.is_pos_zero(b) {
      return Cmp{text: "fcmp $u0, #0.0", us: [g.word(a)], cond: cond}
    }
    let wa = g.word(a)
    let wb = g.word(b)
    return Cmp{text: "fcmp $u0, $u1", us: [wa, wb], cond: cond}
  }
  if g.not_nan_const(a) {
    let cond = match o {
      Lt => "lt"
      Le => "le"
      Gt => "gt"
      _ => "ge"
    }
    let wa = g.word(a)
    let wb = g.word(b)
    return Cmp{text: "fcmp $u0, $u1", us: [wa, wb], cond: cond}
  }
  var x = a
  var y = b
  var cond = "lt"
  match o {
    Gt => {
      x = b
      y = a
    }
    Le => {
      x = b
      y = a
      cond = "ge"
    }
    Ge => cond = "ge"
    _ => {}
  }
  let wx = g.word(x)
  let wy = g.word(y)
  Cmp{text: "fcmp $u0, $u0\nfccmp $u0, $u1, #0, vc", us: [wx, wy], cond: cond}
}

fn op_char(o: ssa.Op) -> Int {
  match o {
    Add => 43
    Sub => 45
    Mul => 42
    Div => 47
    _ => 37
  }
}

/// The flag setting part of a comparison and the condition under which
/// it holds (compare).
fn (var g: G) compare(v: Int) -> Cmp {
  let o = g.op(v)
  var a = g.arg(v, 0)
  var b = g.arg(v, 1)
  for x in [a, b] {
    if g.ext_test(x) {
      let (inner, ext) = g.ext_of(x)
      return Cmp{text: "cmp $u0, $wu0, ${ext}", us: [g.word(inner)], cond: int_cond(o)}
    }
    if g.rem_test(x) {
      let (k, _) = g.pow2(g.arg(x, 1))
      return Cmp{text: "tst $u0, #${pow2i(k) - 1}", us: [g.word(g.arg(x, 0))], cond: int_cond(o)}
    }
    if g.and_test(x) {
      let (y, n) = g.and_imm(x)
      return Cmp{text: "tst $u0, #${n}", us: [g.word(y)], cond: int_cond(o)}
    }
  }
  // UInt64's order is compared as Int's with both sign bits flipped
  // (compiler/ssa expr.xo compare): x ^ MIN < y ^ MIN is x < y unsigned,
  // and a constant c compared so is c ^ MIN (2026-10-19: portable's u64
  // loop made each a movabs, two xors, and a cmp on amd64)
  if g.vkind(a) == ssa.Kind.Int && o != ssa.Op.Eq && o != ssa.Op.Ne {
    let (oa, xa, ca, na) = g.unflip(a)
    let (ob, xb, cb, nb) = g.unflip(b)
    if oa && ob && !(ca && cb) {
      var cond = uint_cond(o)
      var x = xa
      var y = xb
      var yc = cb
      var n = nb
      if ca {
        x = xb
        y = xa
        yc = true
        n = na
        cond = swap_cond(cond)
      }
      if yc && addsub_imm(n) {
        return Cmp{text: "cmp $u0, #${n}", us: [g.word(x)], cond: cond}
      }
      let wx = g.word(x)
      let wy = if yc { g.imm(n) } else { g.word(y) }
      return Cmp{text: "cmp $u0, $u1", us: [wx, wy], cond: cond}
    }
  }
  match g.vkind(a) {
    Int | Bool => {
      var cond = if g.vkind(a) == ssa.Kind.Bool { uint_cond(o) } else { int_cond(o) }
      let (_, ac) = g.const_int(a)
      if ac {
        let (_, bc) = g.const_int(b)
        if !bc {
          let t = a
          a = b
          b = t
          cond = swap_cond(cond)
        }
      }
      let (n, ok) = g.const_int(b)
      if ok && addsub_imm(n) {
        return Cmp{text: "cmp $u0, #${n}", us: [g.word(a)], cond: cond}
      } else if ok && n != MIN_INT && addsub_imm(-n) {
        return Cmp{text: "cmn $u0, #${-n}", us: [g.word(a)], cond: cond}
      }
      let wa = g.word(a)
      let wb = g.word(b)
      Cmp{text: "cmp $u0, $u1", us: [wa, wb], cond: cond}
    }
    Float => {
      if o == ssa.Op.Eq || o == ssa.Op.Ne {
        let cond = int_cond(o)
        if g.is_pos_zero(b) {
          return Cmp{text: "fcmp $u0, #0.0", us: [g.word(a)], cond: cond}
        }
        let wa = g.word(a)
        let wb = g.word(b)
        return Cmp{text: "fcmp $u0, $u1", us: [wa, wb], cond: cond}
      }
      g.float_order(o, a, b)
    }
    _ => {
      g.fail("compare of `${g.tname(g.vty(a))}`")
      Cmp{text: "cmp $u0, $u1", us: [0, 0], cond: "eq"}
    }
  }
}

/// An operand of a flipped UInt64 compare (compare): (true, x, false, 0)
/// for x ^ MIN, (true, -1, true, c ^ MIN) for a constant c, else false.
fn (g: G) unflip(a: Int) -> (Bool, Int, Bool, Int) {
  let (k, kc) = g.const_int(a)
  if kc {
    return (true, -1, true, k ^ MIN_INT)
  }
  let x = g.f.values[a]
  if x.op == ssa.Op.Xor && x.args.len() == 2 {
    for i in 0..2 {
      let (m, mc) = g.const_int(x.args[i])
      if mc && m == MIN_INT {
        return (true, x.args[1 - i], false, 0)
      }
    }
  }
  (false, -1, false, 0)
}

/// Lowers SSA value v.
fn (var g: G) instr(v: Int) {
  if g.f.values[v].line != 0 {
    g.cur_line = g.f.values[v].line
    g.cur_inl = g.f.values[v].inl
  }
  let pad = g.f.values[v].pad
  if pad >= 0 {
    // its calls and fault stubs unwind to the cleanup of its check
    g.cur_pad = g.bmap[g.pad_target(pad)]
  }
  g.instr1(v)
  g.cur_pad = -1
}

/// Whether a logical operation takes a rotated operand (rot_operand): not
/// where the target has no such operand (the amd64 retarget, decision
/// 0254, would pay a mov and a ror into a temporary).
fn (g: G) logic_ror() -> Bool {
  // not on x86_64: no rotated operand (decision 0254)
  !g.x86
}

/// For an operand c of a 64 bit logical operation that is a rotation of
/// y right by a constant k (rt.int_wrap 5) read only there: (y, k), else
/// (-1, 0).
fn (g: G) rot_operand(c: Int) -> (Int, Int) {
  if !g.logic_ror() {
    return (-1, 0)
  }
  let x = g.f.values[c]
  if x.op != ssa.Op.Call || aux_str(x.aux) != "rt.int_wrap" || x.args.len() != 3 || g.nuses[c] != 1 {
    return (-1, 0)
  }
  let (op, ok) = g.const_int(x.args[0])
  let (k, kc) = g.const_int(x.args[2])
  if !ok || op != 5 || !kc || k & 63 == 0 {
    return (-1, 0)
  }
  (x.args[1], k & 63)
}

fn (var g: G) instr1(v: Int) {
  let x = g.f.values[v]
  match x.op {
    Const | Cap => {}
    Add | Sub => {
      if g.ext_add(v) {
        return // ext_test's bias, never computed
      }
      g.add_sub(v)
    }
    Mul => g.mul(v)
    Div | Rem => g.div_rem(v)
    And | Or | Xor => {
      if g.has_val[v] {
        // given with its 32 bit add (add_w32)
        return
      }
      if g.and_test(v) {
        return // lowered by the comparison (tst)
      }
      let ins = match x.op {
        And => "and"
        Or => "orr"
        _ => "eor"
      }
      var p = x.args[0]
      var q = x.args[1]
      let (_, pc) = g.logic_const(p)
      if pc {
        p = x.args[1]
        q = x.args[0]
      }
      let (n, qc) = g.logic_const(q)
      // x86 takes any sign extended 32 bit immediate (decision 0254), and
      // only those: a wider one in a register is a constant hoist_consts
      // moves out of a loop, where the immediate was a movabsq through
      // r11 at each use (2026-10-22: jsontext.str_end's 0x22 and 0x80
      // byte masks, every 8 bytes)
      if qc && x.op == ssa.Op.And && n > 0 && n < MAX_INT && n & (n + 1) == 0 {
        // a low mask over a value already inside it changes nothing
        let (plo, phi) = g.bounds(p)
        if plo >= 0 && phi <= n {
          g.set(v, [g.word(p)])
          return
        }
      }
      if qc && (if g.x86 { imm32(n) } else { ones_run(n) }) {
        // a logical immediate (decision 0184)
        let w = g.word(p)
        g.set(v, [g.def1(false, "${ins} $d0, $u0, #${n}", [w])])
        return
      }
      // an operand that is a complement: bic, orn, eon take it inverted
      // (2026-10-16: Keccak's chi was mvn and and, 100 of each a call);
      // the mvn, with no other use, is then dead. `y ^ -1` is one too
      // (2026-10-24: the SWAR helpers' `& (w ^ -1)`, obj.fold_copy's and
      // between8's, was an eor and an and)
      for j in [1, 0] {
        let c = x.args[j]
        var cx = g.f.values[c]
        if let Some(y) = g.xor_ones(c) {
          cx = ssa.Value{op: ssa.Op.Not, ty: cx.ty, aux: ssa.Aux.None, args: [y]}
        }
        if cx.op == ssa.Op.Not && g.kind(cx.ty) != ssa.Kind.Bool {
          if g.x86 {
            // ~k of a constant k: x86's immediate (`n & ~31`: andq $-32,
            // not a mov, a not, and an and)
            let (k, kc) = g.logic_const(cx.args[0])
            if kc && imm32(~k) {
              g.set(v, [g.def1(false, "${ins} $d0, $u0, #${~k}", [g.word(x.args[1 - j])])])
              return
            }
          }
          let inv = match x.op {
            And => "bic"
            Or => "orn"
            _ => "eon"
          }
          let a = g.word(x.args[1 - j])
          // ~(y rotated): the rotation the operand's shift too
          let (y, k) = g.rot_operand(cx.args[0])
          if k > 0 {
            g.set(v, [g.def1(false, "${inv} $d0, $u0, $u1, ror #${k}", [a, g.word(y)])])
            return
          }
          let b = g.word(cx.args[0])
          g.set(v, [g.def1(false, "${inv} $d0, $u0, $u1", [a, b])])
          return
        }
      }
      // an operand rotated by a constant: the shifted register operand's
      // ror (Keccak's D = C ^ rot(C, 1) and rho, 2026-10-17: a ror each);
      // the ror, with no other use, is then dead
      for j in [1, 0] {
        let (y, k) = g.rot_operand(x.args[j])
        if k > 0 {
          let a = g.word(x.args[1 - j])
          g.set(v, [g.def1(false, "${ins} $d0, $u0, $u1, ror #${k}", [a, g.word(y)])])
          return
        }
      }
      if x.op != ssa.Op.And && g.funnel(v) {
        return
      }
      let a = g.word(x.args[0])
      let b = g.word(x.args[1])
      g.set(v, [g.def1(false, "${ins} $d0, $u0, $u1", [a, b])])
    }
    Shl | Shr => {
      if g.ext_test(v) {
        return // lowered by the comparison (ext_test)
      }
      g.shift(v)
    }
    Neg => {
      let (nc, isn) = g.neg_const(v)
      if isn {
        // a negative literal (the SSA negates the constant): a constant,
        // which cannot overflow (decision 0194)
        g.set(v, [g.cimm(nc)])
        return
      }
      let a = g.word(x.args[0])
      if g.kind(x.ty) == ssa.Kind.Float {
        g.set(v, [g.def1(true, "fneg $d0, $u0", [a])])
        return
      }
      if x.pos.is_empty() {
        g.set(v, [g.def1(false, "neg $d0, $u0", [a])])
        return
      }
      g.set(v, [g.checked(false, "negs $d0, $u0", [a], "neg", "vs", "xo_fault_neg", [rsrc(a)] + g.loc_args(x.pos))])
    }
    Not => {
      if g.nuses[v] == 0 && g.lazy[x.args[0]] {
        // its branch tests the compare (isel's swap): nothing reads it
        return
      }
      let a = g.word(x.args[0])
      if g.kind(x.ty) == ssa.Kind.Bool {
        g.set(v, [g.def1(false, "eor $d0, $u0, #1", [a])])
      } else {
        g.set(v, [g.def1(false, "mvn $d0, $u0", [a])])
      }
    }
    Eq | Ne | Lt | Le | Gt | Ge => {
      if g.eq_aggregate(v) {
        return
      }
      if g.vkind(x.args[0]) == ssa.Kind.Unit {
        let r = match x.op {
          Eq | Le | Ge => 1
          _ => 0
        }
        g.set(v, [g.imm(r)])
        return
      }
      if g.nuses[v] == 1 && g.used_by_branch(v) {
        g.lazy[v] = true
        return
      }
      // decided by the operands' bounds: a constant (2026-10-23: a
      // Rune's `r < 0` in its or of range tests kept a compare after a
      // branch proved its operand not negative, portable conv)
      if let Some(k) = g.decided(v) {
        g.set(v, [g.imm(if k { 1 } else { 0 })])
        return
      }
      // an overflow test passed to a join (ints.fits returned into
      // checked_mul's `if`): the flag set, not the sign or high word test
      let (otext, oa, ob, vc) = g.overflow_test(v)
      if !otext.is_empty() {
        g.set(v, [g.def1(false, "${otext}\ncset $d0, ${if vc { "vc" } else { "vs" }}", [g.word(oa), g.word(ob)])])
        return
      }
      let c = g.compare(v)
      g.set(v, [g.def1(false, "${c.text}\ncset $d0, ${c.cond}", c.us)])
    }
    IntToFloat => {
      let a = g.word(x.args[0])
      g.set(v, [g.def1(true, "scvtf $d0, $u0", [a])])
    }
    IntConv => {
      // the same word as another integer type (decision 0081)
      g.set(v, [g.word(x.args[0])])
    }
    FloatToInt => {
      let a = g.word(x.args[0])
      let t = g.def1(true, "frintz $d0, $u0", [a])
      if !x.pos.is_empty() {
        let lo = g.fimm(float_bits(-9223372036854775808.0))
        let la = g.loc_args(x.pos)
        g.check("fcmp $u0, $u1", [t, lo], "lt", "xo_fault_float_int", [rsrc(a)] + la)
        let hi = g.fimm(float_bits(9223372036854775808.0))
        g.check("fcmp $u0, $u1", [t, hi], "ge", "xo_fault_float_int", [rsrc(a)] + la)
      }
      g.set(v, [g.def1(false, "fcvtzs $d0, $u0", [t])])
    }
    Struct | Tuple => {
      var ws: List[Int] = []
      for a in x.args {
        for w in g.words(a) {
          ws.push(w)
        }
      }
      g.set(v, ws)
    }
    Field => g.field_op(v)
    SetField => g.set_field_op(v)
    Variant => g.set(v, g.variant(x.ty, aux_int(x.aux), x.args))
    Tag => {
      let (ptr, ok) = g.mem_of(x.args[0])
      if ok {
        // an enum in memory (decision 0153): only its tag is read
        g.set(v, g.load_words(ptr, 0, [false]))
        return
      }
      g.set(v, [g.words(x.args[0])[0]])
    }
    Payload => g.payload_op(v)
    Call => g.call_op(v)
    Closure => g.closure_op(v)
    Capture => g.capture_op(v)
    CallValue => g.call_value_op(v)
    Box => g.box_op(v)
    FuncAddr => {
      let n = aux_str(x.aux)
      if n.starts_with("&") {
        // rt.sym_addr (decision 0234): a C level symbol by its exact name
        g.set(v, [g.c_sym_addr(n[1..n.len()])])
      } else if n.starts_with("@") {
        // rt.fn_addr (decision 0233): a C ABI export's symbol
        g.set(v, [g.sym_addr(g.sym(n[1..n.len()]))])
      } else {
        g.set(v, [g.sym_addr(g.c_entry_sym(n))])
      }
    }
    Rebind => {
      // the new code word and the environment word of Args[0]
      let code = g.sym_addr(g.fname(aux_str(x.aux)))
      g.set(v, [code, g.words(x.args[0])[1]])
    }
    Unbox => g.unbox_op(v)
    Fault => {
      let ws = g.words(x.args[0])
      let d = g.str_data(ws)
      let n = g.str_len(ws)
      let w1 = g.real(n)
      let _c = g.add(Inst{kind: K_CALL, sym: g.sym(fault_entry("xo_fault")), srcs: [rsrc(d), rsrc(n)] + g.loc_args(x.pos), us: [d, w1], noret: true})
      let _t = g.add(Inst{kind: K_TRAP})
    }
    Retain => {
      let a = x.args[0]
      if g.op(a) == ssa.Op.Const || g.cancel_rc(v) {
        return // literals are immortal; see cancel_rc
      }
      if g.stack_closures().contains(a) {
        return // an environment in the frame (stack_closures)
      }
      if g.rc_at(v, "dup", a) {
        return
      }
      g.retain(g.vty(a), g.words(a))
    }
    Release => {
      if g.cancel[v] {
        return
      }
      let a = x.args[0]
      if g.stack_closures().contains(a) {
        return // an environment in the frame (stack_closures)
      }
      if g.bare_variant(a) {
        return // holds no heap value (main's own Stdio after the 0307 fold)
      }
      if g.bare_arm(v, a) {
        return // a match arm whose variant holds no heap value (Ok(Duration))
      }
      if imm_post(g.f, a, 0, []) {
        return // immortal once the callees are inlined (rcpair.xo imm_post)
      }
      let t = g.vty(a)
      if (g.kind(t) is ssa.Kind.Struct | ssa.Kind.Tuple) && 8 * g.nwords(t) <= 32760 {
        // a whole struct or tuple (ssa group_releases): its leaves
        // released from memory, in place when it is held there
        let (ptr, ok) = g.mem_of(a)
        var ls0: List[Leaf] = []
        g.heap_leaves(t, 0, ls0)
        if ok && ls0.len() >= MEM_DROP_LEAVES {
          let _r = g.call(g.mem_drop(t), regs([ptr]), [])
          return
        }
        if ok {
          for l in ls0 {
            g.release(l.t, g.load_words(ptr, l.off, g.layout(l.t)))
          }
          return
        }
        // in registers: each heap leaf's own release, as when they were
        // released apart (a store of the words for the helper ran 7
        // percent more instructions in the self build)
        let ws = g.words(a)
        var ls: List[Leaf] = []
        g.heap_leaves(t, 0, ls)
        for l in ls {
          g.release(l.t, ws[l.off..l.off + g.nwords(l.t)])
        }
        return
      }
      if g.rc_at(v, "drop", a) {
        return
      }
      g.release(t, g.words(a))
    }
    Reuse => g.reuse(v)
    Share => {
      let a = x.args[0]
      if g.op(a) == ssa.Op.Const {
        return // literals are immortal
      }
      if g.rc_at(v, "share", a) {
        return
      }
      let h = g.rc_helper("share", g.vty(a))
      let ws = g.to_int(g.words(a), g.layout(g.vty(a)))
      let _r = g.call(h, regs(ws), [])
    }
    Jump => {
      g.end_memo[x.block] = g.m_()
      let (dsts, srcs) = g.edge_moves(x.succs[0])
      g.pmove(dsts, srcs)
      let _j = g.add(Inst{kind: K_JUMP, targets: [g.bmap[g.f.edges[x.succs[0]].to]]})
    }
    Branch => g.branch_op(v)
    Return => {
      if g.has_ref_ptr {
        g.by_ref_return(v)
        return
      }
      var us: List[Int] = []
      for a in x.args {
        for w in g.words(a) {
          us.push(w)
        }
      }
      var nz: List[Int] = []
      for u in us {
        if u != 0 {
          nz.push(u)
        }
      }
      let _r = g.add(Inst{kind: K_RET, srcs: regs(us), us: nz})
    }
    Unreachable => {
      let _t = g.add(Inst{kind: K_TRAP})
    }
    _ => g.fail("op `${ssa.op_name(x.op)}`")
  }
}

/// Branches whose compare the operands' bounds decide become jumps
/// (2026-10-20: portable shift's UInt32(i % 8) tested (i % 8) >> 32 != 0
/// every iteration), when every reached value's landing check stays
/// reached (ssa.pads_reached: a call on the kept path may land on a check
/// on the other, chain_pads). The block not taken is still lowered, and
/// the MIR thread drops it.
fn (var g: G) fold_decided(blocks: List[Int], idom: List[Int]) {
  for b in blocks {
    let t = g.f.term(b)
    if t < 0 || g.f.values[t].op != ssa.Op.Branch || g.f.values[t].succs.len() != 2 || g.f.values[t].pad >= 0 {
      continue
    }
    let c = g.f.values[t].args[0]
    var dk = g.decided(c) ?? g.dom_decided(b, c, idom)
    // through not, or, and and: the one compare left to test, negated
    // or not (2026-10-22: Rune(v % 55296) tested not(not(lt or gt or
    // eq)), of which the ranges decide gt and eq)
    var tv = c
    var neg = false
    if dk == None {
      let (k, v, n) = g.fold_cond(c, COND_DEPTH)
      if k >= 0 {
        dk = Some(k == 1)
      } else if v != c {
        tv = v
        neg = n
        if let Some(k2) = g.dom_decided(b, v, idom) {
          dk = Some(k2 != n)
        }
      }
    }
    if dk == None {
      if tv != c {
        g.f.values[t].args = [tv]
        if neg {
          let ss = g.f.values[t].succs
          g.f.values[t].succs = [ss[1], ss[0]]
        }
        g.nuses[c] -= 1
        g.nuses[tv] += 1
      }
      continue
    }
    if let Some(k) = dk {
      let keep = g.f.values[t].succs[if k { 0 } else { 1 }]
      let drop = g.f.values[t].succs[if k { 1 } else { 0 }]
      if !ssa.pads_reached(g.f, t, keep) {
        continue
      }
      let to = g.f.edges[drop].to
      var preds: List[Int] = []
      for e in g.f.blocks[to].preds {
        if e != drop {
          preds.push(e)
        }
      }
      g.f.blocks[to].preds = preds
      g.f.values[t].op = ssa.Op.Jump
      g.f.values[t].args = []
      g.f.values[t].succs = [keep]
      g.nuses[c] -= 1
    }
  }
}

/// y when Int value v is `y ^ -1` (either operand the constant): a
/// complement for bic, orn and eon, as a Not is.
fn (g: G) xor_ones(v: Int) -> Int? {
  let x = g.f.values[v]
  // arm64 only: x86_64 keeps its eor and and (no output change there)
  if g.x86 || x.op != ssa.Op.Xor || x.args.len() != 2 || x.ty < 0 || g.kind(x.ty) != ssa.Kind.Int {
    return None
  }
  for j in 0..2 {
    let (k, ok) = g.logic_const(x.args[j])
    if ok && k == -1 {
      return Some(x.args[1 - j])
    }
  }
  None
}

/// The outcome of block b's branch on c when a dominating block branches
/// on the same compare (the same value, or the same operation of the
/// same operands) and b is reached only through one of its edges: that
/// edge's block has the dominator as its one predecessor and dominates
/// b (2026-10-21: portable u64 tested `a >= 0` in ints.u64_rem and again
/// in the u64_div it calls).
fn (g: G) dom_decided(b: Int, c: Int, idom: List[Int]) -> Bool? {
  let cv = g.f.values[c]
  if b >= idom.len() {
    return None
  }
  var d = idom[b]
  var steps = 0
  while d >= 0 && d != b && steps < 32 {
    let t = g.f.term(d)
    if t >= 0 && g.f.values[t].op == ssa.Op.Branch && g.f.values[t].succs.len() == 2 && g.f.values[t].pad < 0 {
      let c2 = g.f.values[t].args[0]
      let x2 = g.f.values[c2]
      // the same compare, or its negation (lt and ge, le and gt, eq and
      // ne), which decides the other way (2026-10-23: UInt64(v) branched
      // on v < 0, and ints.u64_rem on Int(UInt64(v)) >= 0)
      let cmp = cv.op is ssa.Op.Eq | ssa.Op.Ne | ssa.Op.Lt | ssa.Op.Le | ssa.Op.Gt | ssa.Op.Ge
      // (integers only: a Float compare with a NaN is false both ways)
      let inv = cmp && x2.op == negated_cmp(cv.op) && cv.args.len() == 2 && g.kind(g.f.values[cv.args[0]].ty) == ssa.Kind.Int
      if c2 == c || (cmp && (x2.op == cv.op || inv) && g.same_operands(x2.args, cv.args)) {
        for i in 0..2 {
          let s = g.f.edges[g.f.values[t].succs[i]].to
          if g.f.blocks[s].preds.len() == 1 && dominates(idom, s, b) {
            return Some((i == 0) != inv)
          }
        }
        return None
      }
    }
    if idom[d] == d {
      break
    }
    d = idom[d]
    steps += 1
  }
  None
}

/// The overflow tests ints.fits(op, a, b) inlines to: `((a ^ r) & (b ^
/// r)) >= 0` with r = a.wrapping_add(b), `((a ^ b) & (a ^ r)) >= 0` with
/// r = a.wrapping_sub(b), and on x86_64 `mul_hi_signed(a, b) ==
/// a.wrapping_mul(b) >> 63` (arm64's mul sets no flag): (the instruction
/// whose V flag is the overflow of a op b, a, b, whether c holds when it
/// does not overflow), else ("", -1, -1, false). Compares against 0 the
/// other way (`< 0`, `!=`) hold when it overflows.
fn (var g: G) overflow_test(c: Int) -> (Str, Int, Int, Bool) {
  let none = ("", -1, -1, false)
  let o = g.op(c)
  if g.f.values[c].args.len() != 2 {
    return none
  }
  if o is ssa.Op.Ge | ssa.Op.Lt {
    let (z, zc) = g.const_int(g.arg(c, 1))
    let x = g.arg(c, 0)
    if !zc || z != 0 || g.op(x) != ssa.Op.And || g.vkind(x) != ssa.Kind.Int {
      return none
    }
    let p = g.arg(x, 0)
    let q = g.arg(x, 1)
    if g.op(p) != ssa.Op.Xor || g.op(q) != ssa.Op.Xor {
      return none
    }
    let vc = o == ssa.Op.Ge
    for (s, t) in [(p, q), (q, p)] {
      for i in 0..2 {
        for j in 0..2 {
          let r = g.arg(s, i)
          if g.arg(t, j) != r {
            continue
          }
          let sa = g.arg(s, 1 - i)
          let ta = g.arg(t, 1 - j)
          let (code, wa, wb) = g.wrap_parts(r)
          // add: s = a ^ r, t = b ^ r
          if code == 0 && ((wa == sa && wb == ta) || (wa == ta && wb == sa)) {
            return ("cmn $u0, $u1", wa, wb, vc)
          }
          // sub: t = a ^ r, s = a ^ b
          if code == 1 && wa == ta && ((g.arg(s, 0) == wa && g.arg(s, 1) == wb) || (g.arg(s, 1) == wa && g.arg(s, 0) == wb)) {
            return ("cmp $u0, $u1", wa, wb, vc)
          }
        }
      }
    }
    return none
  }
  if !g.x86 || !(o is ssa.Op.Eq | ssa.Op.Ne) {
    return none
  }
  for i in 0..2 {
    let h = g.arg(c, i)
    let s = g.arg(c, 1 - i)
    let hx = g.f.values[h]
    if hx.op != ssa.Op.Call || aux_str(hx.aux) != "rt.i64_mul_hi" || hx.args.len() != 2 || g.op(s) != ssa.Op.Shr {
      continue
    }
    let (k, kc) = g.const_int(g.arg(s, 1))
    if !kc || k != 63 {
      continue
    }
    let (code, wa, wb) = g.wrap_parts(g.arg(s, 0))
    let (ha, hb) = (hx.args[0], hx.args[1])
    if code == 2 && ((wa == ha && wb == hb) || (wa == hb && wb == ha)) {
      return ("x86_mulf $u0, $u1", wa, wb, o == ssa.Op.Eq)
    }
  }
  none
}

/// The operation code and operands of rt.int_wrap(code, a, b) with a
/// constant code, else (-1, -1, -1).
fn (g: G) wrap_parts(v: Int) -> (Int, Int, Int) {
  let x = g.f.values[v]
  if x.op != ssa.Op.Call || aux_str(x.aux) != "rt.int_wrap" || x.args.len() != 3 {
    return (-1, -1, -1)
  }
  let (code, ok) = g.const_int(x.args[0])
  if !ok {
    return (-1, -1, -1)
  }
  (code, x.args[1], x.args[2])
}

/// The compare that is true exactly when op is false.
fn negated_cmp(op: ssa.Op) -> ssa.Op {
  match op {
    Eq => ssa.Op.Ne
    Ne => ssa.Op.Eq
    Lt => ssa.Op.Ge
    Ge => ssa.Op.Lt
    Le => ssa.Op.Gt
    Gt => ssa.Op.Le
    _ => op
  }
}

/// Whether two compares' operands are the same words of the same types:
/// equal values, equal constants, or values equal through conversions between 64 bit
/// integer types (2026-10-23: UInt64(v) tested v >= 0, and ints.u64_rem
/// then tested Int(UInt64(v)) >= 0 again in portable conv's loop).
fn (g: G) same_operands(a: List[Int], b: List[Int]) -> Bool {
  if a.len() != b.len() {
    return false
  }
  for i in 0..a.len() {
    if a[i] == b[i] {
      continue
    }
    let (ka, ca) = g.const_int(a[i])
    let (kb, cb) = g.const_int(b[i])
    if ca && cb && ka == kb && g.f.values[a[i]].ty == g.f.values[b[i]].ty {
      continue
    }
    if g.f.values[a[i]].ty != g.f.values[b[i]].ty || g.word_source(a[i]) != g.word_source(b[i]) {
      return false
    }
  }
  true
}

/// v through conversions between 64 bit integer types (Int, Int64,
/// UInt64), which keep the word.
fn (g: G) word_source(v0: Int) -> Int {
  var v = v0
  for _ in 0..8 {
    let x = g.f.values[v]
    if x.op != ssa.Op.IntConv || x.args.len() != 1 || !g.word64(x.ty) || !g.word64(g.f.values[x.args[0]].ty) {
      break
    }
    v = x.args[0]
  }
  v
}

/// Whether type t is a 64 bit integer type.
fn (g: G) word64(t: Int) -> Bool {
  t >= 0 && g.m.types[t].kind == ssa.Kind.Int && (g.m.types[t].bits == 0 || g.m.types[t].bits == 64)
}

/// Whether block a dominates block b (idom: dominators_of, -1 for the
/// entry).
fn dominates(idom: List[Int], a: Int, b: Int) -> Bool {
  var x = b
  for _ in 0..idom.len() + 1 {
    if x == a {
      return true
    }
    if x < 0 || x >= idom.len() || idom[x] == x {
      return false
    }
    x = idom[x]
  }
  false
}

/// How many not, or, and and operations fold_cond looks through.
const COND_DEPTH = 6

/// Branch condition c with the Int compares the bounds decide (decided)
/// and the Bool constants folded through not, or, and and: (1 or 0, c,
/// false) when that decides it, else (-1, v, neg) to test v instead,
/// negated when neg (v is c when nothing folds).
fn (var g: G) fold_cond(c: Int, d: Int) -> (Int, Int, Bool) {
  let x = g.f.values[c]
  if x.op == ssa.Op.Const {
    match x.aux {
      B(k) => return (if k { 1 } else { 0 }, c, false)
      _ => {}
    }
  }
  if let Some(k) = g.decided(c) {
    return (if k { 1 } else { 0 }, c, false)
  }
  if d <= 0 || x.ty < 0 || g.kind(x.ty) != ssa.Kind.Bool {
    return (-1, c, false)
  }
  if x.op == ssa.Op.Not && x.args.len() == 1 {
    let (k, v, n) = g.fold_cond(x.args[0], d - 1)
    if k >= 0 {
      return (1 - k, c, false)
    }
    return (-1, v, !n)
  }
  if (x.op == ssa.Op.Or || x.op == ssa.Op.And) && x.args.len() == 2 {
    // true absorbs an or, false an and; the other constant is the identity
    let absorb = if x.op == ssa.Op.Or { 1 } else { 0 }
    let (ka, va, na) = g.fold_cond(x.args[0], d - 1)
    let (kb, vb, nb) = g.fold_cond(x.args[1], d - 1)
    if ka == absorb || kb == absorb {
      return (absorb, c, false)
    }
    if ka >= 0 && kb >= 0 {
      return (ka, c, false)
    }
    if ka >= 0 {
      return (-1, vb, nb)
    }
    if kb >= 0 {
      return (-1, va, na)
    }
  }
  (-1, c, false)
}

/// The outcome of the Int compare c when its operands' bounds decide it.
fn (var g: G) decided(c: Int) -> Bool? {
  let x = g.f.values[c]
  if !(x.op is ssa.Op.Eq | ssa.Op.Ne | ssa.Op.Lt | ssa.Op.Le | ssa.Op.Gt | ssa.Op.Ge) || x.args.len() != 2 {
    return None
  }
  for a in x.args {
    let t = g.f.values[a].ty
    if t < 0 || g.kind(t) != ssa.Kind.Int {
      return None
    }
  }
  if x.op is ssa.Op.Eq | ssa.Op.Ne {
    // x | k with a constant k other than 0 is never 0 (portable divmod's
    // `d = (x % 97) | 1` kept its division by zero check)
    for j in 0..2 {
      let (z, zk) = g.const_int(x.args[1 - j])
      if zk && z == 0 && g.nonzero_or(x.args[j]) {
        return Some(x.op == ssa.Op.Ne)
      }
    }
  }
  let (alo, ahi) = g.bounds(x.args[0])
  let (blo, bhi) = g.bounds(x.args[1])
  let lt_t = ahi < blo
  let lt_f = alo >= bhi
  let gt_t = alo > bhi
  let gt_f = ahi <= blo
  let eq_t = alo == ahi && blo == bhi && alo == blo
  let eq_f = ahi < blo || bhi < alo
  match x.op {
    Eq => if eq_t { Some(true) } else if eq_f { Some(false) } else { None }
    Ne => if eq_f { Some(true) } else if eq_t { Some(false) } else { None }
    Lt => if lt_t { Some(true) } else if lt_f { Some(false) } else { None }
    Ge => if lt_f { Some(true) } else if lt_t { Some(false) } else { None }
    Gt => if gt_t { Some(true) } else if gt_f { Some(false) } else { None }
    _ => if gt_f { Some(true) } else if gt_t { Some(false) } else { None }
  }
}

/// The value of Bool v when the operands' bounds decide it: a constant,
/// a compare decided, or a not, or, and of such (d more levels deep),
/// else None (2026-10-23: a Rune's range tests `r < 0 || r > max ||
/// surrogate` after a branch proved r's operand not negative).
fn (var g: G) known_bool(v: Int, d: Int) -> Bool? {
  let x = g.f.values[v]
  match x.op {
    Const => {
      if let B(k) = x.aux {
        return Some(k)
      }
      None
    }
    Not => {
      if d <= 0 {
        return None
      }
      if let Some(k) = g.known_bool(x.args[0], d - 1) {
        return Some(!k)
      }
      None
    }
    Or | And => {
      if d <= 0 || x.args.len() != 2 || g.vkind(v) != ssa.Kind.Bool {
        return None
      }
      let a = g.known_bool(x.args[0], d - 1)
      let b = g.known_bool(x.args[1], d - 1)
      let absorb = x.op == ssa.Op.Or
      if a == Some(absorb) || b == Some(absorb) {
        return Some(absorb)
      }
      if a == Some(!absorb) && b == Some(!absorb) {
        return Some(!absorb)
      }
      None
    }
    Eq | Ne | Lt | Le | Gt | Ge => g.decided(v)
    _ => None
  }
}

/// Whether v is an Or with a constant operand other than 0 (never 0).
fn (var g: G) nonzero_or(v: Int) -> Bool {
  let x = g.f.values[v]
  if x.op != ssa.Op.Or || x.args.len() != 2 {
    return false
  }
  for a in x.args {
    let (k, ok) = g.const_int(a)
    if ok && k != 0 {
      return true
    }
  }
  false
}

fn (var g: G) branch_op(v: Int) {
  let x = g.f.values[v]
  g.end_memo[x.block] = g.m_()
  let c = x.args[0]
  let cv = g.f.values[c]
  // a constant, or a Bool the operands' bounds decide through nots, ors,
  // and ands of compares (known_bool)
  var known: Bool? = None
  if cv.op == ssa.Op.Const {
    if let B(k) = cv.aux {
      known = Some(k)
    }
  } else {
    known = g.known_bool(c, 4)
  }
  if let Some(k) = known {
    let e = if k { x.succs[0] } else { x.succs[1] }
    let (dsts, srcs) = g.edge_moves(e)
    g.pmove(dsts, srcs)
    var ts = [g.bmap[g.f.edges[e].to]]
    if !ssa.pads_reached(g.f, v, e) {
      // a value on the kept path lands on a check of the other edge's
      // blocks: they stay reachable, as the rt.landing branch's second
      // target (2026-10-21: an inlined `ensures` that always fails)
      ts.push(g.bmap[g.f.edges[if k { x.succs[1] } else { x.succs[0] }].to])
    }
    let _j = g.add(Inst{kind: K_JUMP, targets: ts})
    return
  }
  if cv.op == ssa.Op.Call && aux_str(cv.aux) == "rt.landing" {
    // only a fault takes it, through a landing pad (decision 0085): a
    // jump to the normal successor, the pad a second target only for
    // liveness and reachability
    let t1 = g.edge(x.succs[1])
    let t0 = g.edge(x.succs[0])
    let _j = g.add(Inst{kind: K_JUMP, targets: [t1, t0]})
    return
  }
  var inst = Inst{kind: K_CONDBR}
  if g.lazy[c] && (g.range_branch(x) || g.range_and(x) || g.range_or(x) || g.range_or_join(x)) {
    return
  }
  if g.lazy[c] {
    let (text, oa, ob, vc) = g.overflow_test(c)
    if !text.is_empty() {
      // the overflow flag of the operation itself (cmn or cmp; x86's
      // imul), not the sign test of ints.fits' xors (2026-10-23:
      // portable checked's checked_add was seven x86 instructions,
      // checked_mul three multiplies)
      let _i = g.add(Inst{kind: K_CONDBR, text: text, us: [g.word(oa), g.word(ob)], cond: if vc { "vc" } else { "vs" }, targets: [g.edge(x.succs[0]), g.edge(x.succs[1])]})
      return
    }
  }
  if g.logic_value(x) {
    return
  }
  if g.lazy[c] {
    let cmp = g.compare(c)
    if g.select_branch(x, cmp) {
      return
    }
    inst = Inst{kind: K_CONDBR, text: cmp.text, us: cmp.us, cond: cmp.cond}
    let k = tst_bit(cmp.text)
    if k >= 0 && (cmp.cond == "eq" || cmp.cond == "ne") {
      // test one bit and branch
      inst = Inst{kind: K_CONDBR, us: cmp.us, cond: if cmp.cond == "eq" { "tbz" } else { "tbnz" }, bit: k}
    } else if cmp.text == "cmp $u0, #0" && (cmp.cond == "eq" || cmp.cond == "ne") {
      // a word against 0: cbnz (or cbz, as cbnz with the targets
      // swapped), one instruction for the compare and the branch (the
      // execution trace's context checks, decision 0240)
      inst = Inst{kind: K_CONDBR, us: cmp.us, cond: "cbnz", bit: if cmp.cond == "eq" { 1 } else { 0 }}
    } else if cmp.text == "cmp $u0, #0" && (cmp.cond == "lt" || cmp.cond == "ge") {
      // a word's sign: test bit 63 and branch (tbnz when negative)
      inst = Inst{kind: K_CONDBR, us: cmp.us, cond: if cmp.cond == "lt" { "tbnz" } else { "tbz" }, bit: 63}
    }
  } else {
    let w = g.word(c)
    if g.select_branch(x, Cmp{text: "cmp $u0, #0", us: [w], cond: "ne"}) {
      return
    }
    inst = Inst{kind: K_CONDBR, cond: "cbnz", us: [w]}
  }
  var t0 = g.edge(x.succs[0])
  var t1 = g.edge(x.succs[1])
  if inst.cond == "cbnz" && inst.bit == 1 {
    // `== 0`: taken when the word is 0, so cbnz goes the other way
    let t = t0
    t0 = t1
    t1 = t
    inst.bit = 0
  }
  inst.targets = [t0, t1]
  let _i = g.add(inst)
}

/// If-conversion: when both edges of branch x (cmp holding on its first)
/// reach the same block J, each directly or through a block that only
/// jumps (no parameters, no other instructions), and J's parameters
/// that the two paths give different values are Int or Bool words (at
/// most 4), selects them with csel and jumps to J: no branch to
/// mispredict (ndigits8's `if v < 10 { 1 } else { 2 }`). The values
/// both paths pass are computed before the branch, so nothing runs that
/// would not have.
fn (var g: G) select_branch(x: ssa.Value, cmp: Cmp) -> Bool {
  if g.from_memory(x.args[0], 3) {
    // a condition on a loaded value (a binary search's `sec < w[m]`): a
    // select makes the next load wait for this one, where a predicted
    // branch runs ahead (std time zone_offset 1.17x the cycles,
    // 2026-10-17; LLVM's x86 cmov conversion keeps such branches too)
    return false
  }
  if g.cond_from_const(x) {
    return false
  }
  let (j0, e0, s0) = g.forward(x.succs[0])
  let (j1, e1, s1) = g.forward(x.succs[1])
  if j0 != j1 || (e0 == x.succs[0] && e1 == x.succs[1]) || !g.plans_of(j0).is_empty() || g.f32_params(j0) {
    return false
  }
  let ps = g.f.blocks[j0].params
  var nsel = 0
  for (i, p) in ps.indexed() {
    let a0 = g.f.edges[e0].args[i]
    let a1 = g.f.edges[e1].args[i]
    if g.mem_only(p) >= 0 {
      return false
    }
    if a0 != a1 {
      if !(g.vkind(p) is ssa.Kind.Int | ssa.Kind.Bool | ssa.Kind.Float) || g.vals[p].len() != 1 {
        return false
      }
      nsel += 1
    }
  }
  if nsel == 0 || nsel > 4 {
    return false
  }
  if g.join_tests(j0) {
    return false // J only tests what it would select: a branch stays a branch
  }
  // the instructions of a side block, selected here (forward)
  for (sb, vs) in [(g.f.edges[x.succs[0]].to, s0), (g.f.edges[x.succs[1]].to, s1)] {
    if vs.is_empty() {
      continue
    }
    let save = g.cur_sb
    g.cur_sb = -1
    for v in vs {
      g.instr(v)
    }
    g.cur_sb = save
    g.spec[sb] = true
  }
  var dsts: List[Int] = []
  var srcs: List[Src] = []
  for (i, p) in ps.indexed() {
    let a0 = g.f.edges[e0].args[i]
    let a1 = g.f.edges[e1].args[i]
    if a0 == a1 {
      g.param_moves(p, a0, dsts, srcs)
      continue
    }
    let w = g.csel_of(cmp, a0, a1)
    let pw = g.vals[p][0]
    if w != pw {
      dsts.push(pw)
      srcs.push(rsrc(w))
    }
  }
  g.pmove(dsts, srcs)
  let _j = g.add(Inst{kind: K_JUMP, targets: [g.bmap[j0]]})
  true
}

/// Whether branch x tests a parameter of its own block that a
/// predecessor passes a constant (a `||` or `&&` made a Bool, true on one
/// path): left a branch, that path goes straight to its side, where a
/// select keeps the Bool, a cset, a compare, and a csel
/// (bench/perf/text float_fmt 1.004x, 2026-10-17).
fn (g: G) cond_from_const(x: ssa.Value) -> Bool {
  let c = x.args[0]
  let bl = g.f.blocks[x.block]
  var at = -1
  for (i, p) in bl.params.indexed() {
    if p == c {
      at = i
    }
  }
  if at < 0 {
    return false
  }
  for e in bl.preds {
    let a = g.f.edges[e].args[at]
    if g.op(a) == ssa.Op.Const {
      return true
    }
  }
  false
}

/// Whether join j only branches on its parameters or on a test made
/// from them (at most three instructions before the branch: constants,
/// and operations each using a parameter or an earlier one, no call):
/// select_branch leaves such a diamond a branch, as
/// each side's constant then decides the test at once (a compare's -1,
/// 0, or 1 tested < 0: a csel and a compare after the join were
/// bench/perf/xo sortpt 1.025x on Linux, 2026-10-17).
fn (g: G) join_tests(j: Int) -> Bool {
  let ins = g.f.blocks[j].instrs
  let n = ins.len()
  if n == 0 || n > 4 || g.op(ins[n - 1]) != ssa.Op.Branch {
    return false
  }
  var known: Map[Int, Bool] = {}
  for p in g.f.blocks[j].params {
    known[p] = true
  }
  for v in ins[0..n - 1] {
    let x = g.f.values[v]
    if x.op == ssa.Op.Call {
      return false
    }
    if x.op == ssa.Op.Const {
      continue
    }
    var hit = false
    for a in x.args {
      hit = hit || known.contains(a)
    }
    if !hit {
      return false
    }
    known[v] = true
  }
  known.contains(g.arg(ins[n - 1], 0))
}

/// Counts value a (an enum of more than RC_AT_WORDS words, held in
/// memory) through the pointer form of its helper (elem_helper:
/// agg_rc_at), where its words would go to the helper as arguments,
/// stored again in its frame; reports whether it did.
fn (var g: G) rc_at(v: Int, kind: Str, a: Int) -> Bool {
  let t = g.vty(a)
  if g.kind(t) != ssa.Kind.Enum || g.nwords(t) <= RC_AT_WORDS || !g.heap(t) {
    return false
  }
  let (ptr, ok) = g.mem_of(a)
  if !ok {
    return false
  }
  let _r = g.call(g.elem_helper(kind, t), regs([ptr]), [])
  true
}

/// The word of an Int or Bool constant (a Bool is 0 or 1).
fn (g: G) word_const(v: Int) -> (Int, Bool) {
  let (n, ok) = g.const_int(v)
  if ok {
    return (n, true)
  }
  let x = g.f.values[g.through_params(v)]
  if x.op == ssa.Op.Const {
    if let B(k) = x.aux {
      return (if k { 1 } else { 0 }, true)
    }
  }
  (0, false)
}

/// A register holding a0 when cmp holds, else a1 (Int or Bool words):
/// csel, or for constants csinc (one apart) and xzr (zero), so that
/// `if c { 1 } else { 2 }` takes one constant and `{ 0 } else { 1 }`
/// none.
fn (var g: G) csel_of(cmp: Cmp, a0: Int, a1: Int) -> Int {
  let n = cmp.us.len()
  let c = cmp.cond
  let ic = inv_cond(c)
  if g.vkind(a0) == ssa.Kind.Float {
    let f0 = g.word(a0)
    let f1 = g.word(a1)
    return g.def1(true, "${cmp.text}\nfcsel $d0, $u${n}, $u${n + 1}, ${c}", cmp.us + [f0, f1])
  }
  let (c0, k0) = g.word_const(a0)
  let (c1, k1) = g.word_const(a1)
  if k0 && k1 {
    if c0 == 0 && c1 == 1 {
      return g.def1(false, "${cmp.text}\ncsinc $d0, xzr, xzr, ${c}", cmp.us)
    }
    if c0 == 1 && c1 == 0 && ic != "" {
      return g.def1(false, "${cmp.text}\ncsinc $d0, xzr, xzr, ${ic}", cmp.us)
    }
    if c0 != MAX_INT && c1 == c0 + 1 {
      return g.def1(false, "${cmp.text}\ncsinc $d0, $u${n}, $u${n}, ${c}", cmp.us + [g.word(a0)])
    }
    if c1 != MAX_INT && c0 == c1 + 1 && ic != "" {
      return g.def1(false, "${cmp.text}\ncsinc $d0, $u${n}, $u${n}, ${ic}", cmp.us + [g.word(a1)])
    }
  }
  if k0 && c0 == 0 {
    return g.def1(false, "${cmp.text}\ncsel $d0, xzr, $u${n}, ${c}", cmp.us + [g.word(a1)])
  }
  if k1 && c1 == 0 {
    return g.def1(false, "${cmp.text}\ncsel $d0, $u${n}, xzr, ${c}", cmp.us + [g.word(a0)])
  }
  let w0 = g.word(a0)
  let w1 = g.word(a1)
  g.def1(false, "${cmp.text}\ncsel $d0, $u${n}, $u${n + 1}, ${c}", cmp.us + [w0, w1])
}

/// A range test: branch x on `c >= lo` whose true edge enters a block
/// that holds only `c <= hi` (and constants) and its branch, the two
/// false edges reaching the same block with the same arguments (`c >=
/// 48 && c <= 57`): one subtract and an unsigned compare, c - lo <= hi -
/// lo as UInt64s, and a branch to the inner true edge or the false
/// edge (the subtract wraps, so it holds for every Int); whether it did.
fn (var g: G) range_branch(x: ssa.Value) -> Bool {
  let (v, lo, ok) = g.bound_of(x.args[0], true)
  if !ok {
    return false
  }
  let e_in = x.succs[0]
  let e_out = x.succs[1]
  let b = g.f.blocks[g.f.edges[e_in].to]
  let n = b.instrs.len()
  if !b.params.is_empty() || n < 2 || b.preds.len() != 1 {
    return false
  }
  let br = g.f.values[b.instrs[n - 1]]
  if br.op != ssa.Op.Branch || br.pad >= 0 || br.args[0] != b.instrs[n - 2] || !g.lazy[br.args[0]] {
    return false
  }
  for k in 0..n - 2 {
    if g.f.values[b.instrs[k]].op != ssa.Op.Const {
      return false
    }
  }
  let (v2, hi, ok2) = g.bound_of(br.args[0], false)
  if !ok2 || v2 != v || hi < lo || g.nuses[br.args[0]] != 1 || hi <= -65536 || hi >= 65536 {
    // (the skipped block is still selected, unreachable, and its true
    // successor inherits its memo: a constant it would put in a
    // register for the blocks it dominates (inherit keeps those of
    // 65536 and more) would be read there unwritten)
    return false
  }
  let e2 = br.succs[1]
  if g.f.edges[e2].to != g.f.edges[e_out].to || g.f.edges[e2].args != g.f.edges[e_out].args {
    return false
  }
  g.spec[g.f.edges[e_in].to] = true
  g.range_test(v, lo, hi, br.succs[0], e_out)
}

/// range_branch's test for its negation, `c < lo || c > hi` (DS-1,
/// 2026-10-24: `let d = x - 48; if d < 0 || d > 9` took a sign test and a
/// compare, two branches, where `x >= 48 && x <= 57` takes one): branch x
/// on `c < lo` whose false edge enters a block that holds only `c > hi`
/// (and constants) and its branch, the two true edges reaching the same
/// block with the same arguments; one subtract and an unsigned compare,
/// the in range edge the inner false one.
fn (var g: G) range_or(x: ssa.Value) -> Bool {
  // c < lo is c <= lo - 1
  let (v, lo1, ok) = g.bound_of(x.args[0], false)
  if !ok || lo1 == MAX_INT {
    return false
  }
  let lo = lo1 + 1
  let e_out = x.succs[0]
  let e_next = x.succs[1]
  let b = g.f.blocks[g.f.edges[e_next].to]
  let n = b.instrs.len()
  if !b.params.is_empty() || n < 2 || b.preds.len() != 1 || !g.f.edges[e_next].args.is_empty() {
    return false
  }
  let br = g.f.values[b.instrs[n - 1]]
  if br.op != ssa.Op.Branch || br.pad >= 0 || br.args[0] != b.instrs[n - 2] || !g.lazy[br.args[0]] {
    return false
  }
  for k in 0..n - 2 {
    if g.f.values[b.instrs[k]].op != ssa.Op.Const {
      return false
    }
  }
  // c > hi is c >= hi + 1
  let (v2, hi1, ok2) = g.bound_of(br.args[0], true)
  if !ok2 || v2 != v || hi1 == MIN_INT || g.nuses[br.args[0]] != 1 {
    return false
  }
  let hi = hi1 - 1
  if hi < lo || hi <= -65536 || hi >= 65536 {
    // (as range_branch: the skipped block's constants)
    return false
  }
  let e2 = br.succs[0]
  if g.f.edges[e2].to != g.f.edges[e_out].to || g.f.edges[e2].args != g.f.edges[e_out].args {
    return false
  }
  g.spec[g.f.edges[e_next].to] = true
  g.range_test(v, lo, hi, br.succs[1], e_out)
}

/// The same range test for `c >= lo && c <= hi` as the SSA builder
/// gives a condition: branch x on `c >= lo` to block B, which holds
/// only `c <= hi` (and constants) and jumps to J passing it, and
/// otherwise to J (directly or through a block of constants) passing
/// false; J only branches on that parameter, its other parameters get
/// the same value on both edges, and its targets take none of them.
/// Moves those values and branches to J's targets directly (B and J are
/// left unreachable; J's memo, which its targets inherit, is A's).
fn (var g: G) range_and(x: ssa.Value) -> Bool {
  let (v, lo, ok) = g.bound_of(x.args[0], true)
  if !ok {
    return false
  }
  let b = g.f.blocks[g.f.edges[x.succs[0]].to]
  let n = b.instrs.len()
  if !b.params.is_empty() || n < 2 || b.preds.len() != 1 {
    return false
  }
  let jmp = g.f.values[b.instrs[n - 1]]
  if jmp.op != ssa.Op.Jump || jmp.pad >= 0 {
    return false
  }
  let eb = jmp.succs[0]
  let jb = g.f.edges[eb].to
  let (jf, ef, sp) = g.forward(x.succs[1])
  if !sp.is_empty() {
    return false
  }
  let j = g.f.blocks[jb]
  if jf != jb || j.instrs.len() != 1 || j.preds.len() != 2 || g.f32_params(jb) {
    return false
  }
  let c2 = b.instrs[n - 2]
  if g.nuses[c2] != 1 {
    return false
  }
  for k in 0..n - 2 {
    if g.f.values[b.instrs[k]].op != ssa.Op.Const {
      return false
    }
  }
  let br = g.f.values[j.instrs[0]]
  if br.op != ssa.Op.Branch || br.pad >= 0 {
    return false
  }
  let p = br.args[0]
  var dsts: List[Int] = []
  var srcs: List[Src] = []
  for (i, q) in j.params.indexed() {
    let ab = g.f.edges[eb].args[i]
    let af = g.f.edges[ef].args[i]
    if q == p {
      let (f, fok) = g.word_const(af)
      if ab != c2 || !fok || f != 0 || g.nuses[p] != 1 {
        return false
      }
      continue
    }
    if ab != af || g.mem_only(q) >= 0 || g.vals[q].len() != 1 || g.vkind(q) == ssa.Kind.List {
      return false
    }
    let w = g.word(ab)
    if w != g.vals[q][0] {
      dsts.push(g.vals[q][0])
      srcs.push(rsrc(w))
    }
  }
  if !j.params.contains(p) {
    return false
  }
  let (v2, hi, ok2) = g.bound_of(c2, false)
  if !ok2 || v2 != v || hi < lo {
    return false
  }
  g.pmove(dsts, srcs)
  g.spec[g.f.edges[x.succs[0]].to] = true
  g.spec[jb] = true
  g.range_test(v, lo, hi, br.succs[0], br.succs[1])
}

/// range_and for `c < lo || c > hi` (range_or's test, in the form the SSA
/// builder gives a condition): branch x on `c < lo` to J (directly or
/// through a block of constants) passing true, and otherwise to block B,
/// which holds only `c > hi` (and constants) and jumps to J passing it; J
/// only branches on that parameter. Its false target is the in range
/// edge. On x86_64 too, through range_test's retarget, as range_branch.
fn (var g: G) range_or_join(x: ssa.Value) -> Bool {
  // c < lo is c <= lo - 1
  let (v, lo1, ok) = g.bound_of(x.args[0], false)
  if !ok || lo1 == MAX_INT {
    return false
  }
  let lo = lo1 + 1
  let b = g.f.blocks[g.f.edges[x.succs[1]].to]
  let n = b.instrs.len()
  if !b.params.is_empty() || n < 2 || b.preds.len() != 1 {
    return false
  }
  let jmp = g.f.values[b.instrs[n - 1]]
  if jmp.op != ssa.Op.Jump || jmp.pad >= 0 {
    return false
  }
  let eb = jmp.succs[0]
  let jb = g.f.edges[eb].to
  let (jf, ef, sp) = g.forward(x.succs[0])
  if !sp.is_empty() {
    return false
  }
  let j = g.f.blocks[jb]
  if jf != jb || j.instrs.len() != 1 || j.preds.len() != 2 || g.f32_params(jb) {
    return false
  }
  let c2 = b.instrs[n - 2]
  if g.nuses[c2] != 1 {
    return false
  }
  for k in 0..n - 2 {
    if g.f.values[b.instrs[k]].op != ssa.Op.Const {
      return false
    }
  }
  let br = g.f.values[j.instrs[0]]
  if br.op != ssa.Op.Branch || br.pad >= 0 {
    return false
  }
  let p = br.args[0]
  var dsts: List[Int] = []
  var srcs: List[Src] = []
  for (i, q) in j.params.indexed() {
    let ab = g.f.edges[eb].args[i]
    let af = g.f.edges[ef].args[i]
    if q == p {
      let (f, fok) = g.word_const(af)
      if ab != c2 || !fok || f != 1 || g.nuses[p] != 1 {
        return false
      }
      continue
    }
    if ab != af || g.mem_only(q) >= 0 || g.vals[q].len() != 1 || g.vkind(q) == ssa.Kind.List {
      return false
    }
    let w = g.word(ab)
    if w != g.vals[q][0] {
      dsts.push(g.vals[q][0])
      srcs.push(rsrc(w))
    }
  }
  if !j.params.contains(p) {
    return false
  }
  // c > hi is c >= hi + 1
  let (v2, hi1, ok2) = g.bound_of(c2, true)
  if !ok2 || v2 != v || hi1 == MIN_INT || hi1 - 1 < lo {
    return false
  }
  let hi = hi1 - 1
  g.pmove(dsts, srcs)
  g.spec[g.f.edges[x.succs[1]].to] = true
  g.spec[jb] = true
  g.range_test(v, lo, hi, br.succs[1], br.succs[0])
}

/// `c0 && c2` (and) or `c0 || c2` as a Bool value, without branches:
/// branch x on c0 to block B, which holds only the compare c2 (and
/// constants) and jumps to J passing it, and otherwise to J (directly or
/// through a block of constants) passing false (true for ||), J's other
/// parameters getting the same value on both edges, and J not just a
/// branch on it (range_and takes that). c2 has no effect and its
/// operands are computed before x, so evaluating it early is safe. A
/// range `c >= lo && c <= hi` is a subtract and one compare; else cset
/// of each, and and orr.
fn (var g: G) logic_value(x: ssa.Value) -> Bool {
  let c0 = x.args[0]
  if !is_compare(g.op(c0)) || !(g.vkind(g.arg(c0, 0)) is ssa.Kind.Int | ssa.Kind.Bool | ssa.Kind.Float) {
    return false // (compare takes these; an enum's == is lowered elsewhere)
  }
  for is_and in [true, false] {
    let e_b = if is_and { x.succs[0] } else { x.succs[1] }
    let e_j = if is_and { x.succs[1] } else { x.succs[0] }
    let b = g.f.blocks[g.f.edges[e_b].to]
    let n = b.instrs.len()
    if !b.params.is_empty() || n < 2 || b.preds.len() != 1 {
      continue
    }
    let jmp = g.f.values[b.instrs[n - 1]]
    if jmp.op != ssa.Op.Jump || jmp.pad >= 0 {
      continue
    }
    let eb = jmp.succs[0]
    let jb = g.f.edges[eb].to
    let (jf, ef, sp) = g.forward(e_j)
    if jf != jb || !sp.is_empty() || !g.plans_of(jb).is_empty() || g.f32_params(jb) {
      continue
    }
    let c2 = b.instrs[n - 2]
    if !is_compare(g.op(c2)) || g.nuses[c2] != 1 || !(g.vkind(g.arg(c2, 0)) is ssa.Kind.Int | ssa.Kind.Bool) {
      continue
    }
    if g.divides(c0) || g.divides(c2) {
      // `y % 4 == 0 && y % 100 != 0`: the second test is a multiply or
      // a division, worth a branch to skip (std time is_leap, zone_civil
      // 1.04x the cycles, 2026-10-17)
      continue
    }
    var consts = true
    for k in 0..n - 2 {
      if g.f.values[b.instrs[k]].op != ssa.Op.Const {
        consts = false
      }
    }
    if !consts {
      continue
    }
    let j = g.f.blocks[jb]
    var pk = -1
    var ok = true
    for (i, q) in j.params.indexed() {
      let ab = g.f.edges[eb].args[i]
      let af = g.f.edges[ef].args[i]
      if ab == c2 {
        let (f, fok) = g.word_const(af)
        if pk >= 0 || !fok || f != (if is_and { 0 } else { 1 }) {
          ok = false
        }
        pk = i
      } else if ab != af || g.mem_only(q) >= 0 || g.vals[q].len() != 1 || g.vkind(q) == ssa.Kind.List {
        ok = false
      }
    }
    if !ok || pk < 0 {
      continue
    }
    let p = j.params[pk]
    if j.instrs.len() == 1 && g.op(j.instrs[0]) == ssa.Op.Branch && g.arg(j.instrs[0], 0) == p {
      return false // a branch on it: range_and, or two branches
    }
    var pv = -1
    if is_and {
      let (v, lo, lok) = g.bound_of(c0, true)
      let (v2, hi, hok) = g.bound_of(c2, false)
      if lok && hok && v == v2 && hi >= lo {
        let span = hi.wrapping_sub(lo)
        let w = g.word(v)
        var t = w
        if lo != 0 {
          t = if addsub_imm(lo) { g.def1(false, "sub $d0, $u0, #${lo}", [w]) } else { g.def1(false, "sub $d0, $u0, $u1", [w, g.cimm(lo)]) }
        }
        pv = if span >= 0 && addsub_imm(span) {
          g.def1(false, "cmp $u0, #${span}\ncset $d0, ls", [t])
        } else {
          g.def1(false, "cmp $u0, $u1\ncset $d0, ls", [t, g.cimm(span)])
        }
      }
    }
    if pv < 0 {
      let k0 = g.compare(c0)
      let w0 = g.def1(false, "${k0.text}\ncset $d0, ${k0.cond}", k0.us)
      let k2 = g.compare(c2)
      let w2 = g.def1(false, "${k2.text}\ncset $d0, ${k2.cond}", k2.us)
      pv = g.def1(false, if is_and { "and $d0, $u0, $u1" } else { "orr $d0, $u0, $u1" }, [w0, w2])
    }
    var dsts: List[Int] = []
    var srcs: List[Src] = []
    for (i, q) in j.params.indexed() {
      let w = if i == pk { pv } else { g.word(g.f.edges[eb].args[i]) }
      if w != g.vals[q][0] {
        dsts.push(g.vals[q][0])
        srcs.push(rsrc(w))
      }
    }
    g.pmove(dsts, srcs)
    g.spec[g.f.edges[e_b].to] = true
    let _j = g.add(Inst{kind: K_JUMP, targets: [g.bmap[jb]]})
    return true
  }
  false
}

/// Whether value v is, within depth operations, the result of a call or
/// a memory read (rt.int_wrap is arithmetic): a list element, a field of
/// an object, a word of bytes.
fn (g: G) from_memory(v: Int, depth: Int) -> Bool {
  let x = g.f.values[g.through_params(v)]
  if x.op == ssa.Op.Call {
    let (_, w) = g.wrap_op(g.through_params(v))
    if !w {
      return true
    }
  }
  if depth == 0 || x.op is ssa.Op.Param | ssa.Op.Const {
    return false
  }
  for a in x.args {
    if a >= 0 && g.from_memory(a, depth - 1) {
      return true
    }
  }
  false
}

/// Whether compare c has an operand that is a division or a remainder.
fn (g: G) divides(c: Int) -> Bool {
  for a in g.f.values[c].args {
    if g.op(g.through_params(a)) is ssa.Op.Div | ssa.Op.Rem {
      return true
    }
  }
  false
}

/// Branches on lo <= v <= hi (lo <= hi) to edge e_in, else to e_out:
/// v - lo <= hi - lo as UInt64s, both differences wrapping (range_branch,
/// range_and).
fn (var g: G) range_test(v: Int, lo: Int, hi: Int, e_in: Int, e_out: Int) -> Bool {
  let span = hi.wrapping_sub(lo)
  let w = g.word(v)
  var t = w
  if lo != 0 {
    if addsub_imm(lo) {
      t = g.def1(false, "sub $d0, $u0, #${lo}", [w])
    } else if lo != MIN_INT && addsub_imm(-lo) {
      t = g.def1(false, "add $d0, $u0, #${-lo}", [w])
    } else {
      t = g.def1(false, "sub $d0, $u0, $u1", [w, g.cimm(lo)])
    }
  }
  var inst = Inst{kind: K_CONDBR, text: "cmp $u0, #${span}", us: [t], cond: "ls"}
  if span < 0 || !addsub_imm(span) {
    inst = Inst{kind: K_CONDBR, text: "cmp $u0, $u1", us: [t, g.cimm(span)], cond: "ls"}
  }
  let t0 = g.edge(e_in)
  let t1 = g.edge(e_out)
  inst.targets = [t0, t1]
  let _i = g.add(inst)
  true
}

/// The Int value v and the bound k of compare c that is `v >= k` (lower
/// true) or `v <= k` (lower false), with the constant on either side and
/// < or > adjusted by one; ok false otherwise.
fn (g: G) bound_of(c: Int, lower: Bool) -> (Int, Int, Bool) {
  let o = g.op(c)
  if !(o is ssa.Op.Lt | ssa.Op.Le | ssa.Op.Gt | ssa.Op.Ge) || g.vkind(g.arg(c, 0)) != ssa.Kind.Int {
    return (0, 0, false)
  }
  let a = g.arg(c, 0)
  let b = g.arg(c, 1)
  let (kb, okb) = g.const_int(b)
  let (ka, oka) = g.const_int(a)
  if g.tname(g.vty(a)) == "UInt64" && (okb && kb < 0 || oka && ka < 0) {
    // an unsigned compare: the test agrees with it for bounds below 2^63
    return (0, 0, false)
  }
  // v op k, the constant moved to the right
  var v = a
  var k = kb
  var op = o
  if !okb {
    if !oka {
      return (0, 0, false)
    }
    v = b
    k = ka
    op = match o {
      Lt => ssa.Op.Gt
      Le => ssa.Op.Ge
      Gt => ssa.Op.Lt
      _ => ssa.Op.Le
    }
  } else if oka {
    return (0, 0, false)
  }
  if lower {
    match op {
      Ge => return (v, k, true)
      Gt => {
        if k == MAX_INT {
          return (0, 0, false)
        }
        return (v, k + 1, true)
      }
      _ => return (0, 0, false)
    }
  }
  match op {
    Le => (v, k, true)
    Lt => if k == MIN_INT { (0, 0, false) } else { (v, k - 1, true) }
    _ => (0, 0, false)
  }
}

/// The block edge e reaches past a block that only jumps (no
/// parameters, nothing but constants before the jump, or, when the edge
/// is its only way in, up to SPEC_MAX instructions that can be run
/// whatever the branch decides: spec_ok), the edge that carries the
/// arguments into it, and those instructions (select_branch).
fn (g: G) forward(e: Int) -> (Int, Int, List[Int]) {
  let t = g.f.edges[e].to
  let b = g.f.blocks[t]
  let n = b.instrs.len()
  if !b.params.is_empty() || n == 0 {
    return (t, e, [])
  }
  var spec: List[Int] = []
  for k in 0..n - 1 {
    let v = b.instrs[k]
    let o = g.f.values[v].op
    if o == ssa.Op.Const || o == ssa.Op.Tuple && g.f.values[v].args.is_empty() {
      continue // nothing to compute (a unit is a tuple of nothing)
    }
    if b.preds.len() != 1 || !g.spec_ok(v) {
      return (t, e, [])
    }
    spec.push(v)
  }
  if spec.len() > SPEC_MAX {
    return (t, e, [])
  }
  let j = g.f.values[b.instrs[n - 1]]
  if j.op != ssa.Op.Jump || j.pad >= 0 {
    return (t, e, [])
  }
  (g.f.edges[j.succs[0]].to, j.succs[0], spec)
}

/// The most instructions select_branch runs of a side it selects.
const SPEC_MAX = 4

/// Whether v can run whatever a branch before it decides: no fault, no
/// effect, cheap (Float add, subtract, multiply, negate; logic;
/// unchecked or wrapping Int arithmetic; Int to Float). Not compares:
/// speculating the second half of `a && b` or `a || b` ran it every time
/// for a Bool that is branched on anyway (json enc_strings 1.09x the
/// cycles, 2026-10-17).
fn (g: G) spec_ok(v: Int) -> Bool {
  let x = g.f.values[v]
  if x.pad >= 0 || x.ty < 0 {
    return false
  }
  let k = g.kind(x.ty)
  match x.op {
    Add | Sub | Mul => k == ssa.Kind.Float || k == ssa.Kind.Int && x.pos.is_empty()
    Neg => k == ssa.Kind.Float
    And | Or | Xor | Not => k is ssa.Kind.Int | ssa.Kind.Bool
    IntToFloat => true
    Call => {
      let (op, ok) = g.wrap_op(v)
      ok && op >= 0 && op <= 2
    }
    _ => false
  }
}

/// Adds the moves that give parameter p the words of value a (as
/// edge_moves).
fn (var g: G) param_moves(p: Int, a: Int, var dsts: List[Int], var srcs: List[Src]) {
  let pw = g.vals[p]
  let aw = g.words(a)
  for k in 0..pw.len() {
    if pw[k] != aw[k] {
      dsts.push(pw[k])
      srcs.push(rsrc(aw[k]))
    }
  }
  g.f32_param_move(p, a, dsts, srcs)
  if g.vkind(p) != ssa.Kind.List {
    return
  }
  if let Some(c) = g.len_param.get(pw[0]) {
    let n = g.list_len(aw[0])
    if n != c {
      dsts.push(c)
      srcs.push(rsrc(n))
    }
  }
}

fn (g: G) used_by_branch(v: Int) -> Bool {
  let t = g.f.term(g.f.values[v].block)
  t >= 0 && g.f.values[t].op == ssa.Op.Branch && g.f.values[t].args[0] == v
}

fn (var g: G) mul(v: Int) {
  let x = g.f.values[v]
  if g.f32_lazy(v) {
    return // f32_op
  }
  if g.kind(x.ty) == ssa.Kind.Float {
    let a = g.word(x.args[0])
    let b = g.word(x.args[1])
    g.set(v, [g.def1(true, "fmul $d0, $u0, $u1", [a, b])])
    return
  }
  var p = x.args[0]
  var q = x.args[1]
  let (_, pc) = g.const_int(p)
  if pc {
    let t = p
    p = q
    q = t
  }
  let a = g.word(x.args[0])
  let b = g.word(x.args[1])
  // the low word by shifts: x*2^k, x*(2^k + 1)
  var low = ""
  let (c, qc) = g.const_int(q)
  if qc {
    let (k, ok) = g.pow2(q)
    if ok {
      low = "lsl $d0, $u0, #${k}"
    } else if c != MIN_INT {
      let (k2, ok2) = pow2c(c - 1)
      if ok2 {
        low = "add $d0, $u0, $u0, lsl #${k2}"
      }
    }
  }
  if low.is_empty() {
    let (text, us, ok) = g.mul_long(x.args[0], x.args[1])
    if ok {
      if x.pos.is_empty() || g.safe_mul(v) {
        g.set(v, [g.def1(false, text, us)])
        return
      }
      if text.starts_with("umull") {
        // the product of two values below 2^32 is below 2^64: an Int
        // when bit 63 is clear
        let r = g.def1(false, text, us)
        g.check("cmp $u0, #0", [r], "lt", "xo_fault_overflow", [rsrc(a), isrc(42), rsrc(b)] + g.loc_args(x.pos))
        g.set(v, [r])
        return
      }
    }
  }
  if x.pos.is_empty() || g.safe_mul(v) {
    if !low.is_empty() {
      g.set(v, [g.def1(false, low, [g.word(p)])])
    } else {
      g.set(v, [g.def1(false, "mul $d0, $u0, $u1", [a, b])])
    }
    return
  }
  if g.x86 {
    // decision 0254: imul and its overflow flag, not arm64's smulh and
    // compare (eight x86 instructions through rdx:rax); a constant factor
    // is imul's immediate
    let la = g.loc_args(x.pos)
    let (k, kc) = g.const_int(q)
    let r = if kc && imm32(k) {
      g.checked(false, "x86_mulo $d0, $u0, #${k}", [g.word(p)], "", "vs", "xo_fault_overflow", [rsrc(a), isrc(42), rsrc(b)] + la)
    } else {
      g.checked(false, "x86_mulo $d0, $u0, $u1", [a, b], "", "vs", "xo_fault_overflow", [rsrc(a), isrc(42), rsrc(b)] + la)
    }
    g.set(v, [r])
    return
  }
  var r = 0
  if !low.is_empty() {
    r = g.def1(false, low, [g.word(p)])
  } else {
    r = g.def1(false, "mul $d0, $u0, $u1", [a, b])
  }
  let hi = g.def1(false, "smulh $d0, $u0, $u1", [a, b])
  g.check("cmp $u0, $u1, asr #63", [hi, r], "ne", "xo_fault_overflow", [rsrc(a), isrc(42), rsrc(b)] + g.loc_args(x.pos))
  g.set(v, [r])
}

/// Whether v is a Float32 `+ - * /` whose only user is the rt.f32_round
/// the SSA builder put after it (decision 0101): that round makes it in
/// single precision instead (f32_op, decision 0361).
fn (g: G) f32_lazy(v: Int) -> Bool {
  let x = g.f.values[v]
  if !(x.op is ssa.Op.Add | ssa.Op.Sub | ssa.Op.Mul | ssa.Op.Div) || x.ty < 0 || g.kind(x.ty) != ssa.Kind.Float || g.m.types[x.ty].bits != 32 || x.args.len() != 2 || g.nuses[v] != 1 || g.has_val[v] {
    return false
  }
  let u = g.users[v]
  u >= 0 && g.f.values[u].op == ssa.Op.Call && aux_str(g.f.values[u].aux) == "rt.f32_round" && g.f.values[u].block == x.block
}

/// rt.f32_round(v) of an f32_lazy v: the single-precision operation on
/// the operands' single forms, which is the float32 0101's double
/// operation and round give (double rounding is innocuous: 53 >= 2 * 24
/// + 2; decision 0361), then its double for the uses that read one (a
/// widen no use reads is dead and goes). The single form stays in f32s
/// for the next Float32 operation.
fn (var g: G) f32_op(r: Int, v: Int) {
  let x = g.f.values[v]
  let ins = match x.op {
    Add => "fadd"
    Sub => "fsub"
    Mul => "fmul"
    _ => "fdiv"
  }
  let a = g.f32_single(x.args[0])
  let b = g.f32_single(x.args[1])
  let s = g.def1(true, "${ins} $wd0, $wu0, $wu1", [a, b])
  g.f32s[r] = s
  g.set(r, [g.def1(true, "fcvt $d0, $wu0", [s])])
}

/// Whether t is Float32.
fn (g: G) is_f32(t: Int) -> Bool {
  t >= 0 && g.kind(t) == ssa.Kind.Float && g.m.types[t].bits == 32
}

/// The move of a loop header's Float32 parameter p's single form from
/// argument a along an edge: a's single form, or a narrowed here (in the
/// predecessor, before its jump or branch: fcvt sets no flags).
fn (var g: G) f32_param_move(p: Int, a: Int, var dsts: List[Int], var srcs: List[Src]) {
  if let Some(sp) = g.f32s.get(p) {
    let s = g.f32_single(a)
    if s != sp {
      dsts.push(sp)
      srcs.push(rsrc(s))
    }
  }
}

/// Whether one of block b's parameters has a single form, which only
/// edge_moves and param_moves fill (select_branch, range_and, and
/// logic_value build their own moves: they leave such a block alone).
fn (g: G) f32_params(b: Int) -> Bool {
  for p in g.f.blocks[b].params {
    if g.f32s.contains(p) {
      return true
    }
  }
  false
}

/// A single-precision register holding Float32 value a: the one a single
/// operation made (defined where a is, so it dominates every use of a),
/// else its double narrowed here (exact: a Float32 value is a float32;
/// not kept, since here may not dominate a's other uses).
fn (var g: G) f32_single(a: Int) -> Int {
  if let Some(s) = g.f32s.get(a) {
    return s
  }
  g.def1(true, "fcvt $wd0, $u0", [g.word(a)])
}

fn (var g: G) add_sub(v: Int) {
  let x = g.f.values[v]
  let ins = if x.op == ssa.Op.Add { "add" } else { "sub" }
  if g.f32_lazy(v) {
    return // made in single precision by its rt.f32_round (f32_op)
  }
  if g.kind(x.ty) == ssa.Kind.Float {
    let a = g.word(x.args[0])
    let b = g.word(x.args[1])
    g.set(v, [g.def1(true, "f${ins} $d0, $u0, $u1", [a, b])])
    return
  }
  var a = x.args[0]
  var b = x.args[1]
  // faults name the operands in source order: c + x swapped to x + c
  // still reports c + x
  var swapped = false
  let (_, ac) = g.const_int(a)
  if ac && x.op == ssa.Op.Add {
    let (_, bc) = g.const_int(b)
    if !bc {
      let t = a
      a = b
      b = t
      swapped = true
    }
  }
  var checked = !x.pos.is_empty()
  let (n0, bconst) = g.const_int(b)
  if bconst && checked && g.safe_add(a, n0, x.op) {
    checked = false // the bounds of a prove it
  }
  var flag = if checked { "s" } else { "" }
  if bconst && (addsub_imm(n0) || (n0 != MIN_INT && addsub_imm(-n0))) {
    var o = ins
    var n = n0
    if n < 0 {
      o = if ins == "add" { "sub" } else { "add" }
      n = -n
    }
    let text = "${o}${flag} $d0, $u0, #${n}"
    let av = g.word(a)
    if !checked {
      g.set(v, [g.def1(false, text, [av])])
      g.offset_facts(v, a, n0)
      return
    }
    var l = rsrc(av)
    var r = isrc(n0)
    if swapped {
      let t = l
      l = r
      r = t
    }
    let pl = g.loc_args(x.pos)
    g.set(v, [g.checked(false, text, [av], ins, "vs", "xo_fault_overflow", [l, isrc(op_char(x.op)), r] + pl)])
    g.offset_facts(v, a, n0)
    return
  }
  if checked {
    let (alo, ahi) = g.bounds(a)
    let (blo, bhi) = g.bounds(b)
    if safe_add_range(x.op, alo, ahi, blo, bhi) {
      checked = false
      flag = ""
    }
  }
  let av = g.word(a)
  let bv = g.word(b)
  let text = "${ins}${flag} $d0, $u0, $u1"
  if !checked {
    g.set(v, [g.def1(false, text, [av, bv])])
    if bconst {
      g.offset_facts(v, a, n0)
    }
    return
  }
  var l = rsrc(av)
  var r = rsrc(bv)
  if swapped {
    let t = l
    l = r
    r = t
  }
  let pl = g.loc_args(x.pos)
  g.set(v, [g.checked(false, text, [av, bv], ins, "vs", "xo_fault_overflow", [l, isrc(op_char(x.op)), r] + pl)])
  if bconst {
    g.offset_facts(v, a, n0)
  }
}

/// k when v is the Int constant 2^k, k >= 1.
fn (g: G) pow2(v: Int) -> (Int, Bool) {
  // x86_64 also through a narrow constant's word: `x % 8` on a UInt32
  // was an idivq (2026-10-19; on arm64 sdiv and msub are fewer
  // instructions than the rounding shifts when x's sign is unknown,
  // portable/shift 1.039)
  let (n, ok) = if g.x86 { g.const_word(v) } else { g.const_int(v) }
  if !ok {
    return (0, false)
  }
  pow2c(n)
}

/// Whether v is `x % 2^k` used only by `== 0` or `!= 0` (lowered as a
/// bit test of x).
/// The value of an Int constant or of a negative literal (the SSA
/// negates the constant: `x & -4`): (n, true), else (0, false).
fn (g: G) logic_const(v: Int) -> (Int, Bool) {
  let (n, c) = g.const_int(v)
  if c {
    return (n, true)
  }
  g.neg_const(v)
}

/// The bit k of a compare that tests one bit (`tst $u0, #2^k`), else -1.
fn tst_bit(text: Str) -> Int {
  let pre = "tst $u0, #"
  if !text.starts_with(pre) {
    return -1
  }
  let n = Int.parse(text[pre.len()..text.len()]) ?? 0
  if n <= 0 || (n & (n - 1)) != 0 {
    return -1
  }
  var k = 0
  while (1 << k) != n {
    k += 1
  }
  k
}

/// Whether v is `y & C` (an Int, its only use an Eq or Ne against 0, C a
/// logical immediate): the comparison is then `tst y, #C` and the and is
/// not made (compare; one bit is a tbz or tbnz in branch_op).
fn (g: G) and_test(v: Int) -> Bool {
  let x = g.f.values[v]
  if x.op != ssa.Op.And || g.kind(x.ty) != ssa.Kind.Int || g.nuses[v] != 1 || g.has_val[v] {
    return false
  }
  let (_, n) = g.and_imm(v)
  if n == 0 {
    return false
  }
  let u = g.users[v]
  if u < 0 || !(g.op(u) is ssa.Op.Eq | ssa.Op.Ne) {
    return false
  }
  var o = g.arg(u, 0)
  if o == v {
    o = g.arg(u, 1)
  }
  let (z, isc) = g.const_int(o)
  isc && z == 0
}

/// The operand and the immediate of `y & C` with C a logical immediate:
/// (y, C), else (-1, 0).
fn (g: G) and_imm(v: Int) -> (Int, Int) {
  let x = g.f.values[v]
  for i in [1, 0] {
    let (n, c) = g.logic_const(x.args[i])
    // x86: a 32 bit one only (the and's rule)
    if c && ones_run(n) && (!g.x86 || imm32(n)) {
      return (x.args[1 - i], n)
    }
  }
  (-1, 0)
}

fn (g: G) rem_test(v: Int) -> Bool {
  let x = g.f.values[v]
  if x.op != ssa.Op.Rem || g.kind(x.ty) != ssa.Kind.Int || g.nuses[v] != 1 {
    return false
  }
  let (_, ok) = g.pow2(x.args[1])
  ok && g.zero_test_use(v)
}

/// Whether v is a sized integer's range test word compared with 0 (ssa
/// show.xo out_of: `(r + 2^(b-1)) >> b`, or `r >> b` unsigned, b 8, 16
/// or 32), its only use: on arm64 one compare of r with its own low b
/// bits extended (`cmp x, w, sxtw`), not an add, a shift and a test
/// (2026-10-24: portable arith32 1.19x LLVM, three such checks a step).
fn (var g: G) ext_test(v: Int) -> Bool {
  if g.x86 {
    return false
  }
  let x = g.f.values[v]
  if x.op != ssa.Op.Shr || g.nuses[v] != 1 || !g.zero_test_use(v) {
    return false
  }
  let (bits, ok) = g.const_int(x.args[1])
  if !ok || !(bits is 8 | 16 | 32) {
    return false
  }
  let (_, ext) = g.ext_of(v)
  !ext.is_empty()
}

/// ext_test's value r and its extend (sxtb, sxth, sxtw, or the uxt
/// forms when r is not biased), "" when the shift's operand is neither.
fn (var g: G) ext_of(v: Int) -> (Int, Str) {
  let x = g.f.values[v]
  let (bits, _) = g.const_int(x.args[1])
  let sfx = if bits == 8 { "b" } else if bits == 16 { "h" } else { "w" }
  let a = x.args[0]
  let y = g.f.values[a]
  if y.op == ssa.Op.Add && g.nuses[a] == 1 && y.pos.is_empty() {
    let (k, kc) = g.const_int(y.args[1])
    if kc && k == 1 << (bits - 1) {
      return (y.args[0], "sxt${sfx}")
    }
  }
  // unsigned: r >> b, r not negative (a product or sum of narrow values)
  let (lo, _) = g.bounds(a)
  if lo >= 0 {
    return (a, "uxt${sfx}")
  }
  (-1, "")
}

/// Whether v is the bias add of an ext_test (its one use), which the
/// comparison reads through.
fn (var g: G) ext_add(v: Int) -> Bool {
  if g.x86 || g.nuses[v] != 1 {
    return false
  }
  let u = g.users[v]
  u >= 0 && g.op(u) == ssa.Op.Shr && g.arg(u, 0) == v && g.ext_test(u) && g.ext_of(u).0 != v
}

/// Whether the one user of v is `v == 0` or `v != 0`.
fn (g: G) zero_test_use(v: Int) -> Bool {
  let u = g.users[v]
  if u < 0 || !(g.op(u) is ssa.Op.Eq | ssa.Op.Ne) {
    return false
  }
  var o = g.arg(u, 0)
  if o == v {
    o = g.arg(u, 1)
  }
  let (n, isc) = g.const_int(o)
  isc && n == 0
}

fn (var g: G) div_rem(v: Int) {
  let x = g.f.values[v]
  let is_div = x.op == ssa.Op.Div
  let (k, p2) = g.pow2(x.args[1])
  if p2 && g.kind(x.ty) == ssa.Kind.Int {
    if g.rem_test(v) {
      return // lowered by the comparison
    }
    // round toward zero: add 2^k - 1 to negative dividends
    let a = g.word(x.args[0])
    let (lo, _) = g.bounds(x.args[0])
    if lo >= 0 {
      // not negative: a mask or a shift
      if is_div {
        g.set(v, [g.def1(false, "asr $d0, $u0, #${k}", [a])])
      } else {
        g.set(v, [g.def1(false, "and $d0, $u0, #${pow2i(k) - 1}", [a])])
      }
      return
    }
    let _mi = g.m_()
    if (g.cm.low_zero.get(a) ?? 0) >= k {
      // a branch proved a % 2^k == 0: exact
      if is_div {
        g.set(v, [g.def1(false, "asr $d0, $u0, #${k}", [a])])
      } else {
        g.set(v, [g.cimm(0)])
      }
      return
    }
    var t = 0
    if k == 1 {
      t = g.def1(false, "add $d0, $u0, $u0, lsr #63", [a])
    } else {
      let sg = g.def1(false, "asr $d0, $u0, #63", [a])
      t = g.def1(false, "add $d0, $u0, $u1, lsr #${64 - k}", [a, sg])
    }
    if is_div {
      g.set(v, [g.def1(false, "asr $d0, $u0, #${k}", [t])])
      return
    }
    let msk = g.def1(false, "and $d0, $u0, #${-pow2i(k)}", [t])
    g.set(v, [g.def1(false, "sub $d0, $u0, $u1", [a, msk])])
    return
  }
  if is_div && g.f32_lazy(v) {
    return // f32_op
  }
  if g.kind(x.ty) == ssa.Kind.Float {
    let a = g.word(x.args[0])
    let b = g.word(x.args[1])
    if is_div {
      g.set(v, [g.def1(true, "fdiv $d0, $u0, $u1", [a, b])])
    } else {
      g.set(v, g.rt("fmod", regs([a, b]), [true]))
    }
    return
  }
  // through a narrow constant's word too (2026-10-19: Int32's `% 46000`
  // was an idivq on x86_64, tens of cycles; 2026-10-24: and an sdiv on
  // arm64, which LLVM makes the multiply high too: quiet --ab, divmod
  // wall 0.880, arith32 0.949)
  let (kc0, c0) = g.const_word(x.args[1])
  let (kn, cn) = g.neg_const(x.args[1])
  let kc = if c0 { kc0 } else { kn }
  let is_const = c0 || cn
  if is_const && g.kind(x.ty) == ssa.Kind.Int && kc != 0 && kc != 1 && kc != -1 && kc != MIN_INT {
    g.div_const(v, kc)
    return
  }
  let a = g.word(x.args[0])
  let b = g.word(x.args[1])
  // the divisor's and dividend's value ranges (ranges.xo, the branches
  // that dominate: u64_rem's `if a >= 0 && b > 0 { a % b }`) can rule
  // out the zero and the minimum by -1 (2026-10-23: portable u64 1.38
  // times LLVM's instructions with both checks every division)
  let (blo, bhi) = g.bounds(x.args[1])
  let (alo, _) = g.bounds(x.args[0])
  let _mi = g.m_()
  let nonzero = blo > 0 || bhi < 0 || g.cm.nonzero.contains(b)
  let no_overflow = blo > -1 || bhi < -1 || alo > MIN_INT
  let zchk = !x.pos.is_empty() && !(is_const && kc != 0) && !nonzero
  let ochk = is_div && !x.pos.is_empty() && !(is_const && kc != -1) && !no_overflow
  // x86_64: a plain idiv (x86.xo sdivs), not arm64's sdiv semantics'
  // tests of 0 and -1, when the divisor is proven or checked not 0 and
  // the minimum by -1 (idiv's other fault) is ruled out or checked
  // (2026-10-23: portable divmod's checked `xs[i] / d`)
  let sdiv = if g.x86 && (nonzero || zchk) && (no_overflow || ochk) { "sdivs" } else { "sdiv" }
  if zchk {
    g.check("cmp $u0, #0", [b], "eq", "xo_fault_divzero", [rsrc(a), isrc(op_char(x.op))] + g.loc_args(x.pos))
  }
  if is_div {
    if ochk {
      let mn = g.imm(MIN_INT)
      g.check("cmp $u0, $u1\nccmn $u2, #1, #0, eq", [a, mn, b], "eq", "xo_fault_overflow", [rsrc(a), isrc(47), rsrc(b)] + g.loc_args(x.pos))
    }
    g.set(v, [g.def1(false, "${sdiv} $d0, $u0, $u1", [a, b])])
    return
  }
  // a - (a / b) * b; arm64's sdiv of the minimum by -1 is the minimum, so
  // `x % -1` is 0 as Xo requires
  let q = g.def1(false, "${sdiv} $d0, $u0, $u1", [a, b])
  g.set(v, [g.def1(false, "msub $d0, $u0, $u1, $u2", [q, b, a])])
}

/// Lowers v = x / d or x % d for an Int constant d other than 0, 1, -1,
/// the minimum, and the positive powers of two (decision 0194): neither
/// can fault. The quotient of x by |d| is a multiply high and shifts
/// (sdiv_quot); x / d negates it for d < 0, and x % d (whose sign is
/// x's, so x % d == x % |d|) is x - q * |d|.
fn (var g: G) div_const(v: Int, d: Int) {
  let x = g.f.values[v]
  let a = g.word(x.args[0])
  let ad = if d < 0 { -d } else { d }
  var q = g.sdiv_quot(x.args[0], a, ad)
  if x.op == ssa.Op.Div {
    if d < 0 {
      q = g.def1(false, "neg $d0, $u0", [q])
    }
    g.set(v, [q])
    return
  }
  g.set(v, [g.def1(false, "msub $d0, $u0, $u1, $u2", [q, g.cimm(ad), a])])
}

/// A register holding x / d rounded toward zero (x the SSA value in
/// register a, 2 <= d < 2^63), shared with the blocks the block
/// dominates (Memo.quo): for a power of two 2^k the rounding add and a
/// shift (as div_rem), else a multiply high by sdiv_magic's M, plus x
/// when M is negative as an Int, an arithmetic shift, and 1 when the
/// result is negative (left out when x's bounds prove it is not).
fn (var g: G) sdiv_quot(xv: Int, a: Int, d: Int) -> Int {
  let _mi = g.m_()
  if let Some(r) = g.cm.quo.get((a, d)) {
    return r
  }
  let (lo, hi) = g.bounds(xv)
  var q = 0
  let (k, p2) = pow2c(d)
  let (sm, ss, sok) = if g.x86 && !p2 && lo >= 0 { small_magic(d, hi) } else { (0, 0, false) }
  if p2 {
    if lo >= 0 || (g.cm.low_zero.get(a) ?? 0) >= k {
      q = g.def1(false, "asr $d0, $u0, #${k}", [a])
    } else if k == 1 {
      let t = g.def1(false, "add $d0, $u0, $u0, lsr #63", [a])
      q = g.def1(false, "asr $d0, $u0, #1", [t])
    } else {
      let sg = g.def1(false, "asr $d0, $u0, #63", [a])
      let t = g.def1(false, "add $d0, $u0, $u1, lsr #${64 - k}", [a, sg])
      q = g.def1(false, "asr $d0, $u0, #${k}", [t])
    }
  } else if sok {
    // a dividend in [0, hi]: x * m >> s, the product exact in 63 bits
    // (one imul by an immediate on x86_64, not imul through rdx:rax,
    // 2026-10-23: portable conv's Int32 values, as LLVM)
    q = g.def1(false, "mul $d0, $u0, $u1", [a, g.cimm(sm)])
    q = g.def1(false, "lsr $d0, $u0, #${ss}", [q])
  } else {
    let (mg, sh) = sdiv_magic(d)
    q = g.def1(false, "smulh $d0, $u0, $u1", [a, g.cimm(mg)])
    if mg < 0 {
      q = g.def1(false, "add $d0, $u0, $u1", [q, a])
    }
    if sh > 0 {
      q = g.def1(false, "asr $d0, $u0, #${sh}", [q])
    }
    if lo < 0 {
      q = g.def1(false, "add $d0, $u0, $u0, lsr #63", [q])
    }
  }
  let _mj = g.m_()
  g.cm.quo[(a, d)] = q
  q
}

fn (var g: G) shift(v: Int) {
  let x = g.f.values[v]
  let a = g.word(x.args[0])
  let (k, kc) = g.const_word(x.args[1])
  if kc && k >= 0 && k < 64 {
    if x.op == ssa.Op.Shr {
      g.set(v, [g.def1(false, "asr $d0, $u0, #${k}", [a])])
      return
    }
    let r = g.def1(false, "lsl $d0, $u0, #${k}", [a])
    if !x.pos.is_empty() && !g.safe_shl(x.args[0], k) {
      let back = g.def1(false, "asr $d0, $u0, #${k}", [r])
      g.check("cmp $u0, $u1", [back, a], "ne", "xo_fault_shl", [rsrc(a), isrc(k)] + g.loc_args(x.pos))
    }
    g.set(v, [r])
    return
  }
  let b = g.word(x.args[1])
  let (klo, khi) = g.bounds(x.args[1])
  if !x.pos.is_empty() && (klo < 0 || khi > 63) {
    g.check("cmp $u0, #64", [b], "hs", "xo_fault_shift", [rsrc(b)] + g.loc_args(x.pos))
  }
  if x.op == ssa.Op.Shr {
    g.set(v, [g.def1(false, "asr $d0, $u0, $u1", [a, b])])
    return
  }
  let r = g.def1(false, "lsl $d0, $u0, $u1", [a, b])
  if !x.pos.is_empty() && !(klo >= 0 && khi <= 63 && g.safe_shl(x.args[0], khi)) {
    let back = g.def1(false, "asr $d0, $u0, $u1", [r, b])
    g.check("cmp $u0, $u1", [back, a], "ne", "xo_fault_shl", [rsrc(a), rsrc(b)] + g.loc_args(x.pos))
  }
  g.set(v, [r])
}

/// Whether n is a value every logical instruction takes as an
/// immediate: one run of ones, or the repetition of an element of 2 to
/// 32 bits that is one run of ones, rotated (isel.go onesRun); a negative
/// n too (2026-10-16: `x & -4` was a mov and an and).
fn ones_run(n: Int) -> Bool {
  if n < 0 {
    // a run of ones rotated past bit 63 (as -4 is): its complement is a
    // run too; all ones is no immediate
    return n != -1 && ones_run(-1 ^ n)
  }
  if n == 0 {
    return false
  }
  // the smallest element whose repetition is n
  var e = 64
  while e > 2 {
    let h = e / 2
    let m = (1 << h) - 1
    if (n & m) != ((n >> h) & m) {
      break
    }
    e = h
  }
  if e == 64 {
    return run1(n)
  }
  let m = (1 << e) - 1
  let x = n & m
  run1(x) || run1(~x & m)
}

/// Whether x > 0 is one run of ones (isel.go run1).
fn run1(x0: Int) -> Bool {
  if x0 <= 0 {
    return false
  }
  var x = x0
  while (x & 1) == 0 {
    x = x >> 1
  }
  x == MAX_INT || (x & (x + 1)) == 0
}

/// Whether a << k cannot overflow for every k in [0, khi] (khi <= 63):
/// a's bounds fit in 63 - khi bits and a sign (decision 0184).
fn (var g: G) safe_shl(a: Int, khi: Int) -> Bool {
  if khi == 0 {
    return true
  }
  let (lo, hi) = g.bounds(a)
  let lim = 1 << (63 - khi)
  lo >= -lim && hi <= lim - 1
}

/// The words of variant tag of enum t.
fn (var g: G) variant(t: Int, tag: Int, args: List[Int]) -> List[Int] {
  var ws: List[Int] = []
  for _ in 0..g.nwords(t) {
    ws.push(0)
  }
  ws[0] = g.imm(tag)
  var k = 1
  for a in args {
    let aw = g.words(a)
    for (i, fp) in g.layout(g.vty(a)).indexed() {
      if fp {
        ws[k] = g.def1(false, "fmov $d0, $u0", [aw[i]])
      } else {
        ws[k] = aw[i]
      }
      k += 1
    }
  }
  ws
}

/// Converts payload words (integer registers) to a value of the given
/// layout.
fn (var g: G) from_payload(ws: List[Int], lay: List[Bool]) -> List[Int] {
  var out: List[Int] = []
  for (i, fp) in lay.indexed() {
    if fp {
      out.push(g.def1(true, "fmov $d0, $u0", [g.real(ws[i])]))
    } else {
      out.push(ws[i])
    }
  }
  out
}

/// Converts value words to integer registers (floats as bits), the
/// convention of the reference counting helpers.
fn (var g: G) to_int(ws: List[Int], lay: List[Bool]) -> List[Int] {
  var out: List[Int] = []
  for (i, fp) in lay.indexed() {
    if fp {
      out.push(g.def1(false, "fmov $d0, $u0", [ws[i]]))
    } else {
      out.push(ws[i])
    }
  }
  out
}

fn (var g: G) field_op(v: Int) {
  let x = g.f.values[v]
  if g.mem_only(v) >= 0 {
    return // a `var` result left in memory: read where used
  }
  let u = x.args[0]
  let fi = aux_int(x.aux)
  if g.lazy_res.contains((u, fi)) && g.held_field_done(v) {
    return // only stored by set fields done in place
  }
  let (off, n) = g.field_words(g.vty(u), fi)
  let mu = g.mem_only(u)
  if mu >= 0 {
    if g.big_by_ref(x.ty) && g.read_in_place(v, mu, g.key_of(u)) {
      // a large field of a value held in memory that holds it at every
      // read: read there where used (a match on an optional TLS 1.2
      // state loaded it whole on the TLS 1.3 path, tlssrv.recv_some)
      g.stable[v] = g.addr_at(g.held.mems[mu].ptr, 8 * off)
      return
    }
    // a field of a value held in memory
    g.set(v, g.load_words(g.held.mems[mu].ptr, off, g.layout(x.ty)))
    return
  }
  if let Some(ptr) = g.stable.get(u) {
    if g.big_by_ref(x.ty) {
      // a large field of read only memory: read in place where used,
      // passed on by address
      g.stable[v] = g.addr_at(ptr, 8 * off)
      return
    }
    g.set(v, g.load_words(ptr, off, g.layout(x.ty)))
    return
  }
  if g.lazy_res.contains((u, fi)) {
    g.fail("v${v} in ${g.f.name}: a result left in memory read out of place")
  }
  let ws = g.words(u)
  g.set(v, ws[off..off + n])
}

fn (var g: G) set_field_op(v: Int) {
  let x = g.f.values[v]
  let (off, n) = g.field_words(x.ty, aux_int(x.aux))
  if g.has_held {
    if let Some((m, at)) = g.held.nested.get(v) {
      // stored in place in the field of the held value; the outer set
      // field is then done
      g.store_words_at(g.held.mems[m].ptr, at, g.words(x.args[1]))
      return
    }
  }
  if g.has_held && g.held.set_done.contains(v) {
    // the call before it wrote the field in place (field homes)
    if g.mem_only(v) < 0 {
      let m = g.held.in_place.get(v) ?? 0
      g.set(v, g.load_words(g.held.mems[m].ptr, 0, g.layout(x.ty)))
    }
    return
  }
  if g.has_held {
    if let Some(m) = g.held.in_place.get(v) {
      // the field is written in place
      let ptr = g.held.mems[m].ptr
      let u_only = g.mem_only(x.args[0]) >= 0
      var old: List[Int] = []
      if !u_only {
        old = g.words(x.args[0])
      }
      g.store_words_at(ptr, off, g.words(x.args[1]))
      if g.mem_only(v) >= 0 {
        return
      }
      if u_only {
        g.set(v, g.load_words(ptr, 0, g.layout(x.ty)))
        return
      }
      var ws = old
      let nw = g.words(x.args[1])
      for k in 0..n {
        ws[off + k] = nw[k]
      }
      g.set(v, ws)
      return
    }
  }
  var ws = g.words(x.args[0])
  let nw = g.words(x.args[1])
  for k in 0..n {
    ws[off + k] = nw[k]
  }
  g.set(v, ws)
}

fn (var g: G) payload_op(v: Int) {
  let x = g.f.values[v]
  let (tag, field) = match x.aux {
    P(tag, field) => (tag, field)
    _ => (0, 0)
  }
  let e = x.args[0]
  let (off, n) = g.payload_words(g.vty(e), tag, field)
  let (ptr, ok) = g.mem_of(e)
  if ok {
    // a payload of an enum in memory (decision 0153): read in place; a
    // large one of read only memory stays there
    if g.stable.contains(e) && g.big_by_ref(x.ty) {
      g.stable[v] = g.addr_at(ptr, 8 * off)
      return
    }
    g.set(v, g.load_words(ptr, off, g.layout(x.ty)))
    return
  }
  let ws = g.words(e)[off..off + n]
  g.set(v, g.from_payload(ws, g.layout(x.ty)))
}

// ---------------------------------------------------------------------------
// Dominators

/// The immediate dominator of each SSA block (blocks in reverse
/// postorder; Cooper, Harvey, Kennedy 2001): -1 for the entry and the
/// blocks not reached.
fn dominators_of(f: ssa.Func, blocks: List[Int]) -> List[Int] {
  let nb = f.blocks.len()
  var num: List[Int] = []
  var idom: List[Int] = []
  for _ in 0..nb {
    num.push(-1)
    idom.push(-1)
  }
  for (i, b) in blocks.indexed() {
    num[b] = i
  }
  idom[blocks[0]] = blocks[0]
  var changed = true
  while changed {
    changed = false
    for bi in 1..blocks.len() {
      let b = blocks[bi]
      var nd = -1
      for e in f.blocks[b].preds {
        let p = f.edges[e].from
        if idom[p] < 0 {
          continue
        }
        if nd < 0 {
          nd = p
        } else {
          // intersect
          var a = p
          var c = nd
          while a != c {
            while num[a] > num[c] {
              a = idom[a]
            }
            while num[c] > num[a] {
              c = idom[c]
            }
          }
          nd = a
        }
      }
      if nd >= 0 && idom[b] != nd {
        idom[b] = nd
        changed = true
      }
    }
  }
  idom[blocks[0]] = -1
  idom
}

/// A funnel shift: v = shl(a, k) | shr(b, 64 - k) (or ^: the two have no
/// bit in common), both rt.int_wrap with constant amounts, is
/// `extr d, a, b, #(64 - k)` (2026-10-16: GHASH's reduction and bignum
/// code wrote lsl, lsr, and orr); the shifts, used only there, are dead.
fn (var g: G) funnel(v: Int) -> Bool {
  let x = g.f.values[v]
  if g.kind(x.ty) != ssa.Kind.Int {
    return false
  }
  for j in [0, 1] {
    let p = g.through_params(x.args[j])
    let q = g.through_params(x.args[1 - j])
    let (po, pok) = g.wrap_op(p)
    let (qo, qok) = g.wrap_op(q)
    if !pok || !qok || po != 3 || qo != 4 {
      continue
    }
    let (k, kc) = g.const_int(g.f.values[p].args[2])
    let (m, mc) = g.const_int(g.f.values[q].args[2])
    if !kc || !mc || k < 1 || k > 63 || m != 64 - k {
      continue
    }
    let a = g.word(g.f.values[p].args[1])
    let b = g.word(g.f.values[q].args[1])
    g.set(v, [g.def1(false, "extr $d0, $u0, $u1, #${m}", [a, b])])
    return true
  }
  false
}

/// The value v stands for through block parameters: a parameter of a
/// block with one incoming edge is the value that edge passes (an
/// inlined call's result reaches its continuation block that way, so a
/// pattern over the call's operation looks through it).
/// The little endian value of the w bytes at base + off when base is a
/// string literal's data address (raw.data of a literal: rt.obj_addr of
/// the constant plus the 16 bytes of its header, through block
/// parameters) and the bytes are the literal's: a prefix compared by
/// scan.eq_text loads its words from the literal (Xo Lang 3's
/// trim_affix, 2026-10-23), which Go compares as immediates.
fn (g: G) literal_load(base: Int, off: Int, w: Int) -> Int? {
  if !(w is 1 | 2 | 4 | 8) {
    return None
  }
  let b = g.through_params(base)
  let xb = g.f.values[b]
  var a = b
  var c = 0
  if xb.op == ssa.Op.Call && aux_str(xb.aux) == "rt.int_wrap" && xb.args.len() == 3 {
    let (op, ok) = g.const_int(xb.args[0])
    let (k, kc) = g.const_int(xb.args[2])
    if !ok || op != 0 || !kc {
      return None
    }
    a = g.through_params(xb.args[1])
    c = k
  }
  let xa = g.f.values[a]
  if xa.op != ssa.Op.Call || aux_str(xa.aux) != "rt.obj_addr" || xa.args.len() != 1 {
    return None
  }
  let s = g.through_params(xa.args[0])
  if g.f.values[s].op != ssa.Op.Const {
    return None
  }
  let bs = const_bytes(g.f.values[s].aux) ?? return None
  let i = c - 16 + off
  if i < 0 || i + w > bs.len() {
    return None
  }
  var k = 0
  for j in 0..w {
    k = k | (Int(bs[i + j]) << (8 * j))
  }
  Some(k)
}

fn (g: G) through_params(v0: Int) -> Int {
  var v = v0
  for _ in 0..8 {
    let x = g.f.values[v]
    if x.op != ssa.Op.Param || x.block < 0 {
      return v
    }
    let bl = g.f.blocks[x.block]
    if bl.preds.len() != 1 {
      return v
    }
    var k = -1
    for (i, p) in bl.params.indexed() {
      if p == v {
        k = i
      }
    }
    let e = g.f.edges[bl.preds[0]]
    if k < 0 || k >= e.args.len() || e.args[k] < 0 {
      return v
    }
    v = e.args[k]
  }
  v
}
