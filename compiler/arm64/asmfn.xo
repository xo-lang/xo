// The functions of a generated assembly text that --fn names (task #468):
// `xo asm --fn=NAME DIR` prints them, and `xo dev dump asm --fn=NAME DIR`
// runs that build (it used to print the dump's own pipeline: byte lists
// not packed, XO_PASSES not read).

use github.com/xo-lang/xo/compiler/ssa

/// The sections of text (arm64 or amd64 assembly, as xo asm prints it)
/// for the functions fns names (ssa.named_in): each from its `// func
/// NAME` line up to the next function, section switch or part header.
/// A trailing `== no function matches ...` line says when none did.
pub fn func_sections(text: Str, fns: List[Str]) -> Str {
  var out = StrBuilder.new()
  var on = false
  var n = 0
  for line in text.lines() {
    if line.starts_with("// func ") {
      on = ssa.named_in(line.trim_prefix("// func "), fns)
      if on {
        n += 1
      }
    } else if line.starts_with("\t.section") || line.starts_with("// generated ") {
      on = false
    }
    if on {
      out.write(line)
      out.write("\n")
    }
  }
  if n == 0 {
    out.write("== no function matches ${fns.join(", ")}\n")
  }
  out.freeze()
}
