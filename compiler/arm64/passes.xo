// The optional optimization passes of the native backends, by name, in
// the order a build runs them: each can be turned off ($XO_PASSES,
// ssa.Module passes_off) and the build stays correct, only slower or
// larger. `xo dev bisect-pass` turns them off to find the first one
// whose output diverges (miscompile triage).

use github.com/xo-lang/xo/compiler/ssa

/// Every optional pass, in the order a build runs them: the module
/// passes (inline.xo, reach.xo), then per function the SSA analyses
/// isel uses and the MIR passes (isel.xo function).
pub fn passes() -> List[Str] {
  [
    // compiler/ssa map.xo (decision 0372 stage A): a Map's key side
    // generated once per key type
    "map_core",
    // module, before code generation
    "inline",
    "devirtualize",
    // hollow.xo: the functions of the assembly nothing reaches emptied
    // before it is assembled (compiler/xo, Mach-O)
    "hollow",
    // compiler/ssa specialize.xo (decision 0368): a callee per call
    // site constant argument (a closure of nothing or a literal)
    "specialize_args",
    "chain_pads",
    // compiler/ssa uniqvar.xo (decision 0322): a `var` List parameter
    // every call passes unique skips its entry copy-on-write check
    "uniq_var_params",
    "fold_consts",
    // compiler/ssa unroll.xo: a loop of a constant count of at most 8 trips
    // and a one-block body, after inlining, unrolled
    "unroll_small",
    "cancel_rc_pairs",
    "sink_retains",
    // viewlen.xo: a Str view used only for its length is the length
    "view_lens",
    // stacksmall.xo (decision 0395): a small Str or Bytes this function
    // only reads, in its frame (arm64)
    "stack_small",
    "hoist_fields",
    "fold_tuples",
    "cse",
    // per function: SSA analyses isel uses
    "lsr",
    "ranges",
    // pushrun.xo: up to four pushes onto a list this function made, in
    // one block, are one capacity check and one length update
    "push_runs",
    "inplace_elems",
    // per function: MIR
    "mir_dce",
    "thread_const",
    "thread_cset",
    "thread",
    "jump_tables",
    "live_dce",
    "select_compares",
    "slp_f64",
    "hoist_consts",
    "hoist_invariants",
    "copy_prop",
    "reuse_loads",
    "reuse_flags",
    "tail_dup",
    // threadsw.xo: a jump table dispatch copied into each arm of its loop
    "thread_switch",
    "place_latches",
    "mark_tails",
    "cold_saves",
    "arg_slots",
    "shrink_split",
    "cluster_mem",
    "x86_merge_blocks",
    "x86_mul_pair",
    "x86_const_imm",
    "x86_sink_loads",
    "x86_fold_loads",
    "x86_carry_fuse",
    // System V leaf frames in the red zone below rsp (x86emit.xo Frame.rz)
    "x86_red_zone",
    // a fault stub's saves of the caller saved registers holding
    // variables (x86emit.xo stub_saves, decision 0268's addendum): below
    // rsp on System V, in frame words on Windows (stub_at)
    "x86_stub_saves",
  ]
}

/// Whether pass name is on in m (not turned off by $XO_PASSES).
pub fn pass_on(m: ssa.Module, name: Str) -> Bool {
  !m.passes_off.contains(name)
}

/// The passes $XO_PASSES turns off (`-name` entries, comma separated) and
/// on (`+name`: one the build leaves off for a target; none today, hollow on
/// darwin/amd64 having been on by default since 2026-10-26; decisions 0184,
/// 0371), or why the value is wrong. Naming a
/// pass both ways, or twice one way, is an error.
pub fn parse_passes(v: Str) -> (List[Str], List[Str], Str) {
  var off: List[Str] = []
  var on: List[Str] = []
  let all = passes()
  for e0 in v.split(",") {
    let e = e0.trim()
    if e.is_empty() {
      continue
    }
    // starts_with, not a slice: slicing a Str inside a UTF-8 sequence
    // faults (an entry like "é" is an error, not a crash)
    if !e.starts_with("-") && !e.starts_with("+") {
      return ([], [], "XO_PASSES: ${e} is not -NAME or +NAME")
    }
    let n = e[1..e.len()]
    if !all.contains(n) {
      return ([], [], "XO_PASSES: no pass ${n}; the passes are ${all.join(", ")}")
    }
    if e.starts_with("-") {
      if on.contains(n) {
        return ([], [], "XO_PASSES: ${n} is named both - and +")
      }
      off.push(n)
    } else {
      if off.contains(n) {
        return ([], [], "XO_PASSES: ${n} is named both - and +")
      }
      on.push(n)
    }
  }
  (off, on, "")
}
