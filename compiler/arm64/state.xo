// The state of the emitter: one struct for the program (internal/arm64
// arm64.go gen) and the function being generated (isel.go fstate), so
// that every pass is a method of one `var` receiver. The function state
// is reset for each function (begin_func).

use github.com/xo-lang/xo/compiler/ssa

/// A spill location: a physical register, or a spill slot (reg -1).
struct Loc {
  reg: Int
  slot: Int
}

/// A call that unwinds to a landing pad: the labels around its `bl` and
/// the pad's block.
struct CallSite {
  from: Str
  to: Str
  pad: Int
  /// the pad's entry that first resets sp, for a fault stub that saved
  /// registers below it (emit.xo pad_entry); "" for the pad itself
  entry: Str = ""
}

/// What a memory holds (byref.xo hkey): an SSA value (k -1), or result k
/// of a call (the `var` parameter it wrote back). v -1 with k -2 is top
/// (not reached yet), with k -3 bottom (unknown).
struct HKey {
  v: Int
  k: Int
}

/// A tracked memory: a `var` parameter passed by reference that is the
/// home of its type.
struct HMem {
  t: Int
  param: Int
  ptr: Int
}

/// The dataflow of the homes (byref.xo heldInfo).
struct Held {
  mems: List[HMem] = []
  /// the state before each instruction, by value
  before: Map[Int, List[HKey]] = {}
  /// the state at the start of each block
  inb: Map[Int, List[HKey]] = {}
  /// the state along each edge
  edge: Map[Int, List[HKey]] = {}
  in_place: Map[Int, Int] = {}
  /// a `var` argument of a call (call, argument) that is a field of a
  /// value held in a memory, passed by its address there: memory, word
  /// offset (byref.xo field homes)
  fslot: Map[(Int, Int), (Int, Int)] = {}
  /// the value whose field the pending call writes, by (call, argument)
  fbase: Map[(Int, Int), HKey] = {}
  /// field homes whose base value is stored into its frame home at the
  /// call first (it was not held there: the first call of a loop), by
  /// (call, argument)
  fstore: Map[(Int, Int), Bool] = {}
  /// set fields the call before them already wrote in place
  set_done: Map[Int, Bool] = {}
  /// set fields of a field of a value held in a memory, stored there in
  /// place (the outer set field is then done): memory, word offset
  nested: Map[Int, (Int, Int)] = {}
  mem_only: Map[Int, Int] = {}
  us: Map[Int, List[Int]] = {}
  has_uses: Bool = false
}

/// What the memo knows of a memory word (opt.xo memAt).
struct MemAt {
  base: Int
  off: Int
  epoch: Int
  /// a register offset, or 0
  idx: Int = 0
}

/// The per block memo (opt.xo memo).
struct Memo {
  blk: Int
  /// constants by value: Int, Float bits (-0.0 as +0.0, as Go's map
  /// keys compare), Bool, string bytes
  ci: Map[Int, Int] = {}
  cf: Map[Int, Int] = {}
  cb: Map[Bool, Int] = {}
  cs: Map[Bytes, Int] = {}
  lens: Map[Int, Int] = {}
  checked: Map[(Int, Int), Bool] = {}
  bases: Map[(Int, Int, Int), Int] = {}
  /// base + index registers of rt.mem_load and rt.mem_store (addr_base),
  /// by the SSA values of the base and the index
  addrs: Map[(Int, Int), Int] = {}
  loaded: Map[Int, MemAt] = {}
  epoch: Int = 0
  lo: Map[Int, Int] = {}
  hi: Map[Int, Int] = {}
  low_zero: Map[Int, Int] = {}
  /// x < y holds for the registers (x, y), from a branch or a passed
  /// bounds check; the value is x's SSA value (decision 0184)
  less: Map[(Int, Int), Int] = {}
  /// the quotient register of (dividend register, constant divisor) of a
  /// division by a constant (decision 0194), inherited like the others
  quo: Map[(Int, Int), Int] = {}
  /// the length register of list l in a block that reaches this one
  /// through a join (join_facts): not a register to read here, but the
  /// facts about it hold of l's length (decision 0208)
  len_at: Map[Int, Int] = {}
  /// registers a branch proved not zero (`if d == 0 { fault }` before a
  /// division of Int32 and the other sized Ints)
  nonzero: Map[Int, Bool] = {}
}

/// A pointer induction variable of a loop (lsr.xo lsrPlan).
struct LsrPlan {
  iv: Int
  iv_idx: Int
  list: Int
  list_idx: Int
  es: Int
  /// the loop header: body is its loop's
  head: Int
  p: Int = 0
  /// p is the list's data address instead (iv unused), for [p, i, lsl
  /// #3] (decision 0208)
  data: Bool = false
}

/// What is known of a loop header (lsr.xo lsrLoop).
struct LsrLoop {
  body: List[Bool] = []
  latches: List[Int] = []
  entries: List[Int] = []
  up: List[Int] = []
  down: List[Int] = []
  plans: List[Int] = []
}

/// An interval of Int values (ranges.xo).
struct Interval {
  lo: Int
  hi: Int
}

/// A register that holds a + c (lsr.xo offset).
struct Offset {
  a: Int
  c: Int
}

/// The emitter's state.
struct G {
  m: ssa.Module
  os: Str
  /// x86_64 (decision 0254): the front half's MIR retargeted (x86.xo)
  x86: Bool = false
  /// x86_retarget: the uses of the instruction being translated that die
  /// there (no later use in its block, not live out of it)
  x86_dead: List[Int] = []
  /// the last function of each name (Go's byName)
  by_name: Map[Str, Int] = {}
  /// the parameter each function's result is at most (retle.xo), by index
  retle: Map[Int, Int] = {}
  retge: Map[Int, Int] = {}
  /// per function: the SSA value each Int value is at most (compute_ub)
  ub: Map[Int, Int] = {}
  /// value layouts by type: 0 not computed, 1 on the current path, 2 done
  lay_st: List[Int] = []
  lay: List[List[Bool]] = []
  /// Type.Heap by type: -1 not computed, 0, 1
  heap_c: List[Int] = []
  /// the namespace of this emitter's string, position, and helper
  /// labels: "" for a whole module, "pN_" for part N of a parallel
  /// generation (generate_parallel), whose labels must not collide
  ns: Str = ""
  /// the assembly is cut into files assembled apart (generate_parallel):
  /// the functions and the system call trampolines are global symbols
  /// with hidden visibility, so the other files reach them
  split: Bool = false
  /// a part of a split generation: the reference counting, equality,
  /// box, and closure helpers are only named (helper_ext) and wanted,
  /// and the last file generates each once
  defer_helpers: Bool = false
  wants: List[Want] = []
  /// the key of each of wants placed from a canonical text (place_text),
  /// for the part cache (partcache.xo)
  want_keys: List[Str] = []
  /// the last file of a split generation: the helper of each global name
  ext_keys: Map[Str, Str] = {}
  strs: Map[Bytes, Str] = {}
  /// The strings the current function's code names (str_obj): a
  /// literal binding is described by its string only then (dv_const), in
  /// a fresh and a canonical text alike (g.strs holds the part's, so
  /// another function's literal decided it, and a build through the
  /// function cache wrote other location lists, 2026-10-22)
  fn_strs: Map[Bytes, Bool] = {}
  str_ord: List[Bytes] = []
  locs: Map[Str, Str] = {}
  loc_ord: List[Str] = []
  helpers: List[Str] = []
  helped: Map[Str, Str] = {}
  nhelp: Int = 0
  nfunc: Int = 0
  text: List[Str] = []
  /// word_text's strings by offset / 8
  ldr_texts: List[Str] = []
  str_texts: List[Str] = []
  lsdas: List[Str] = []
  /// the debug line records of the functions (debug.xo), and while one is
  /// emitted: the line of the SSA value being lowered, the last line a
  /// row was made for, and the rows (label and packed line)
  dbgs: List[Str] = []
  cur_line: Int = 0
  cur_inl: Int = -1
  dl_last: Int = 0
  dl_last_inl: Int = -1
  dl_rows: List[Str] = []
  /// the rows of the fault stubs (placed after the body), and the
  /// labels made so far (one numbering for both)
  dl_stub_rows: List[Str] = []
  /// The fault stubs' location ranges (dwvars.xo DvStub)
  dv_stubs: List[DvStub] = []
  /// How far a fault stub moved sp below the body's (its saves): vloc's
  /// slots are that much further from it
  stub_sp: Int = 0
  /// Per register, its single definition copies (dwvars.xo dv_copies),
  /// made on the function's first fault stub
  dv_copies_at: Map[Int, List[Int]] = {}
  dv_copies_made: Bool = false
  dl_n: Int = 0
  /// decision 0318: the function's `_du` labels so far
  du_n: Int = 0
  ncs: Int = 0
  personality_ref: Bool = false
  /// rt.sys_restorer was used: the rt_sigreturn trampoline is emitted
  /// (decision 0206)
  restorer_ref: Bool = false
  /// rt.sys_words was used: the 16 words of process state are emitted
  /// (decision 0206 stage 2)
  words_ref: Bool = false
  /// rt.static_word was used: the 64 words of process globals are
  /// emitted (decision 0207, work item B02)
  static_ref: Bool = false
  /// rt.sys_clone was used: the clone trampoline is emitted (decision
  /// 0206 stage 2)
  clone_ref: Bool = false
  /// the task switch or the thread locals were used: sched.xo's
  /// functions are emitted (decision 0212)
  sched_ref: Bool = false
  /// windows/amd64 (decision 0254 6b): the platform and C functions
  /// called through a System V to Win64 thunk, by symbol, with their
  /// arguments' kinds (`i` a word, `f` a double; x86win.xo)
  w64: Map[Str, Str] = {}
  /// windows/amd64: the weak C symbols referenced (rt.sym_present and
  /// their calls), each an `/alternatename` to xo_absent (x86win.xo)
  wsyms: Map[Str, Bool] = {}
  /// windows/amd64: the rsp offset of the frame's words for borrowed
  /// registers (x86_borrow_at), -1 when the frame has none
  borrow_at: Int = -1
  /// windows/amd64: this emission borrowed a register with no frame
  /// words for it (x86_emit emits the function again with them), and
  /// whether the frame has them
  borrow_short: Bool = false
  borrow_words: Bool = false
  /// windows/amd64: the rsp offset of the frame's words a fault stub
  /// stores the caller saved registers in (-1 none), and whether this
  /// emission had a stub to store with no words for it (x86_emit emits
  /// the function again with them) and whether the frame has them
  stub_at: Int = -1
  stub_short: Bool = false
  stub_words: Bool = false
  /// parameters passed by reference per function (byref.xo), computed
  /// when asked; an empty list is none
  by_ref: Map[Int, List[Bool]] = {}
  addr_taken: Map[Str, Bool] = {}
  /// the first failure (a construct the backend does not support), or ""
  err: Str = ""
  /// the functions not emitted (a construct of a later stage of decision
  /// 0158): `<name>: <why>`
  skipped: List[Str] = []

  // ---- the function being generated (fstate)
  fi: Int = -1
  f: ssa.Func = ssa.Func{name: ""}
  /// The bodies of the part's functions when the module holds their
  /// shells (parallel.xo generate_cached: each part owns its bodies and
  /// drops them when it is done); begin_func reads a body here first.
  bodies: Map[Int, ssa.Func] = {}
  /// the SSA and MIR of functions, by name, for the driver to write
  /// (dump_ir: a failing function, or $XO_DUMP_FN's)
  dumps: List[(Str, Str)] = []
  /// class of each vreg (index 0 is xzr)
  fp: List[Bool] = []
  /// the fp vregs that hold two doubles in a V register (decision 0323,
  /// slp_f64): only caller saved V registers, never live across a call,
  /// 16 byte spill slots, 128 bit moves
  wide: Map[Int, Bool] = {}
  blocks: List[MBlock] = []
  hot: List[Int] = []
  cold: List[Int] = []
  nblock: Int = 0
  cur: Int = -1
  /// the SSA block being selected and the index of the value in its
  /// instructions (the add and carry fusion looks a few values ahead)
  cur_sb: Int = -1
  cur_ix: Int = -1
  /// the registers of each SSA value
  vals: List[List[Int]] = []
  has_val: List[Bool] = []
  /// the machine block of each SSA block
  bmap: List[Int] = []
  nuses: List[Int] = []
  /// a value some instruction reads other than as a borrowed Bytes (--inline-str, calls.xo "rt.str_bytes")
  escapes: List[Bool] = []
  /// push runs (pushrun.xo): a run's last push and its list and values;
  /// the run's other pushes, which make no list
  push_run: Map[Int, List[Int]] = {}
  push_skip: Map[Int, Bool] = {}
  /// skipped pushes a landing pad releases (pushrun.xo)
  push_alias: Map[Int, Bool] = {}
  /// the last user of each value, -1 for none
  users: List[Int] = []
  /// the register of a List block parameter to the register of its
  /// length, a parameter too
  len_param: Map[Int, Int] = {}
  /// the List field words of each loop header's struct or tuple
  /// parameter whose list the function indexes (list_words)
  field_lens: Map[Int, List[Int]] = {}
  /// the memo at the end of each lowered SSA block, -1 for none
  end_memo: List[Int] = []
  /// compares lowered into the branch that uses them
  lazy: List[Bool] = []
  /// SSA blocks an if-conversion left unreachable (select_branch
  /// selected their instructions into their one predecessor; range_and,
  /// range_branch, logic_value jumped past them): selected as a trap
  spec: Map[Int, Bool] = {}
  /// the function uses the $OUT slot
  out: Bool = false
  /// releases cancelled by a retain (rc.xo cancel_rc)
  cancel: List[Bool] = []
  /// loop headers: induction variables (lsr.xo), by SSA block
  lsr: Map[Int, LsrLoop] = {}
  plans: List[LsrPlan] = []
  /// intervals of Int values (ranges.xo)
  ranges: List[Interval] = []
  has_range: List[Bool] = []
  /// what proves list indexes in range across blocks (decision 0257)
  proof: Proof = Proof{idom: [], entry: 0}
  /// registers that are another plus a constant (lsr.xo)
  offs: Map[Int, Offset] = {}
  /// the Int values a list index adds a constant to (xs[i] beside xs[i +
  /// 1]): their elements are addressed from xs + i * size (elem_addr,
  /// decision 0208)
  off_bases: Map[Int, Bool] = {}
  /// moved latches copied at a branch into them (lsr.xo dup_latch)
  dup_ok: Map[Int, Bool] = {}
  // register allocation results
  loc: List[Loc] = []
  order: List[Int] = []
  ninst: Int = 0
  /// darwin's thread local base (tl_base): the register holding it, the
  /// block, and the instruction index it was made at; -1 when none
  tl_v: Int = -1
  tl_blk: Int = -1
  tl_at: Int = 0
  /// The ranges each physical register holds after allocation (regalloc's
  /// occupancy), and the position of the instruction being emitted: the
  /// emitter finds registers free at an instruction for the reloads and
  /// results of a template with more spilled operands than scratch
  /// registers (emit_plain).
  occ_regs: List[List[Rng]] = []
  pos: Int = -1
  slots: Int = 0
  /// Each virtual register's live ranges before coalescing, kept with
  /// debug information on for the variables' locations (dwvars.xo).
  vranges: List[List[Rng]] = []
  /// With debug information on, the virtual registers that hold an Int
  /// constant (imm) or a symbol's address (sym_addr), for the variables'
  /// locations of words no register keeps (dwvars.xo)
  kints: Map[Int, Int] = {}
  /// the value of each register g.imm loaded (str_base: a literal's
  /// length and view offset word)
  kvals: Map[Int, Int] = {}
  /// the registers holding a string literal's object address (decision 0370:
  /// never an inline Str, so no tag test)
  lit_objs: Map[Int, Bool] = {}
  ksyms: Map[Int, Str] = {}
  /// FAR_BASE when the frame is past MAX_FRAME, or 0
  base: Int = 0
  saved: List[Int] = []
  /// the frame of the function being emitted
  fr: Frame = Frame{}
  /// shrink wrapping (shrink.xo): planned before register allocation,
  /// kept by emission when it holds; the blocks that run without the
  /// frame, and the one block whose head makes it
  shrink: Bool = false
  /// x86_fold_loads: the loads whose value it folded into more than one
  /// read, with their base registers (load value, base); and the loads
  /// it leaves alone (their base was spilled: each read reloaded it)
  fold_multi: List[(Int, Int)] = []
  fold_skip: Map[Int, Bool] = {}
  fl: List[Bool] = []
  pro: Int = -1
  /// per block: 1 a save block, 2 a restore block, 0 neither; and
  /// whether it is in the framed region (shrink.xo)
  fedge: List[Int] = []
  region: List[Bool] = []
  /// the current block's code ended at a tail call
  ended: Bool = false
  stubs: List[Str] = []
  nstub: Int = 0
  /// the closures whose environment is in the frame (stack_closures),
  /// computed once per function (stack_env_done)
  stack_env: Map[Int, Bool] = {}
  stack_env_done: Bool = false
  /// the memos (a block's memo is an index into them)
  memos: List[Memo] = []
  mm: Int = -1
  /// the current memo (memos[mm] is stale while it is current)
  cm: Memo = Memo{blk: -1}
  /// landing pads (decision 0085): the pad of the value being lowered,
  /// the SSA blocks landing pads enter, and the call site table entries
  cur_pad: Int = -1
  pads: List[Bool] = []
  sites: List[CallSite] = []
  stub_sites: List[CallSite] = []
  /// per landing pad block, its entry for the fault stubs that saved
  /// registers (emit.xo pad_entry)
  pad_entries: Map[Int, Str] = {}
  /// large `var` parameters passed by reference (byref.xo)
  held: Held = Held{}
  has_held: Bool = false
  ref_ptr: Map[Int, Int] = {}
  has_ref_ptr: Bool = false
  areas: Map[Int, List[Int]] = {}
  /// the single-precision register of a Float32 value a single-precision
  /// operation made (decision 0361; f32_op)
  f32s: Map[Int, Int] = {}
  mem_bytes: Int = 0
  /// the homes in the frame (byref.xo plan_held): address register,
  /// byte offset of the frame's memory
  frame_homes: List[(Int, Int)] = []
  lazy_res: Map[(Int, Int), Bool] = {}
  /// read only parameters passed by reference: their address
  stable: Map[Int, Int] = {}

  // ---- a part's canonical function texts (fcache.xo, decision 0220
  // addendum): the function's labels, strings, positions, and helpers as
  // tokens, put in place by place_text
  canon: Bool = false
  cstrs: List[Bytes] = []
  cstr_at: Map[Bytes, Int] = {}
  clocs: List[Str] = []
  cloc_at: Map[Str, Int] = {}
  cwants: List[(Str, Want)] = []
  /// the helpers the part wants (place_text)
  wanted: Map[Str, Bool] = {}
}

/// Records a failure: the program cannot be generated (the Go emitter's
/// fail). Generation goes on with placeholder registers. The message
/// names the Xo function and the line of the value being lowered.
fn (var g: G) fail(msg: Str) {
  if g.err.is_empty() {
    g.err = g.f.at_source(g.cur_line, g.cur_inl, "arm64 backend: ${msg}")
    // the failing function's SSA and MIR, which the driver writes to a
    // file and names (2026-10-21, the owner's approval: an internal
    // error named a register and nothing else)
    g.dump_ir()
  }
}

/// Starts the state of function fi.
fn (var g: G) begin_func(fi: Int) {
  g.cur_line = 0
  g.cur_inl = -1
  g.dl_last = 0
  g.dl_last_inl = -1
  g.dl_rows = []
  g.dl_stub_rows = []
  g.dv_stubs = []
  g.stub_sp = 0
  g.dv_copies_at = {}
  g.dv_copies_made = false
  g.vranges = []
  g.kints = {}
  g.kvals = {}
  g.lit_objs = {}
  g.ksyms = {}
  g.dl_n = 0
  g.du_n = 0
  g.tl_v = -1
  g.tl_blk = -1
  g.fi = fi
  g.f = g.bodies.get(fi) ?? g.m.funcs[fi]
  g.ub = {}
  g.compute_ub()
  let nv = g.f.values.len()
  let nb = g.f.blocks.len()
  g.fp = [false]
  g.wide = {}
  g.blocks = []
  g.hot = []
  g.cold = []
  g.nblock = 0
  g.cur = -1
  g.vals = []
  g.has_val = []
  g.nuses = []
  g.escapes = []
  g.users = []
  g.lazy = []
  g.spec = {}
  g.cancel = []
  for _ in 0..nv {
    g.vals.push([])
    g.has_val.push(false)
    g.nuses.push(0)
    g.escapes.push(false)
    g.users.push(-1)
    g.lazy.push(false)
    g.cancel.push(false)
  }
  g.bmap = []
  g.end_memo = []
  g.pads = []
  for _ in 0..nb {
    g.bmap.push(-1)
    g.end_memo.push(-1)
    g.pads.push(false)
  }
  g.len_param = {}
  g.field_lens = {}
  g.out = false
  g.lsr = {}
  g.plans = []
  g.ranges = []
  g.has_range = []
  g.offs = {}
  g.off_bases = {}
  g.dup_ok = {}
  g.loc = []
  g.order = []
  g.ninst = 0
  g.slots = 0
  g.base = 0
  g.saved = []
  g.fr = Frame{}
  g.shrink = false
  g.fold_multi = []
  g.fold_skip = {}
  g.fl = []
  g.pro = -1
  g.fedge = []
  g.region = []
  g.stubs = []
  g.nstub = 0
  g.stack_env = {}
  g.stack_env_done = false
  if g.split {
    // the call site labels numbered per function, so a function's
    // assembly in a part does not depend on the functions before it
    // (decision 0220 addendum)
    g.ncs = 0
  }
  g.memos = []
  g.mm = -1
  g.cm = Memo{blk: -1}
  g.cur_pad = -1
  g.sites = []
  g.stub_sites = []
  g.pad_entries = {}
  g.held = Held{}
  g.has_held = false
  g.ref_ptr = {}
  g.has_ref_ptr = false
  g.areas = {}
  g.f32s = {}
  g.mem_bytes = 0
  g.frame_homes = []
  g.lazy_res = {}
  g.stable = {}
}

// ---------------------------------------------------------------------------
// SSA access

fn (g: G) op(v: Int) -> ssa.Op {
  g.f.values[v].op
}

fn (g: G) vty(v: Int) -> Int {
  g.f.values[v].ty
}

fn (g: G) arg(v: Int, i: Int) -> Int {
  g.f.values[v].args[i]
}

fn (g: G) nargs(v: Int) -> Int {
  g.f.values[v].args.len()
}

fn (g: G) kind(t: Int) -> ssa.Kind {
  g.m.types[t].kind
}

/// The kind of value v's type.
fn (g: G) vkind(v: Int) -> ssa.Kind {
  g.m.types[g.f.values[v].ty].kind
}

fn (g: G) tname(t: Int) -> Str {
  g.m.types[t].name
}

/// The name in an aux ("" for another aux).
fn aux_str(a: ssa.Aux) -> Str {
  match a {
    S(s) => s
    _ => ""
  }
}

/// The integer in an aux (0 for another aux).
fn aux_int(a: ssa.Aux) -> Int {
  match a {
    I(n) => n
    _ => 0
  }
}

/// The callee, closure, or function name of value v ("" for another aux).
fn (g: G) vname(v: Int) -> Str {
  aux_str(g.f.values[v].aux)
}

/// The integer aux of value v (a field index, a tag, a capture).
fn (g: G) vint(v: Int) -> Int {
  aux_int(g.f.values[v].aux)
}

/// The Int constant v holds (constInt).
fn (g: G) const_int(v0: Int) -> (Int, Bool) {
  // through an inlined call's argument or result parameter (a block
  // with one incoming edge): cpu.adc(s, c, 0) inlined passed its 0 that
  // way, so the zero went into a register and the adc pairing broke
  // (2026-10-16, bigmod.mac_row)
  let v = g.through_params(v0)
  if g.f.values[v].op != ssa.Op.Const {
    return (0, false)
  }
  match g.f.values[v].aux {
    I(n) => (n, true)
    _ => (0, false)
  }
}

/// const_int through a narrow constant's word (compiler/ssa show.xo
/// word: an IntConv to Int of a constant, the same number): a shift's
/// amount (2026-10-19: `x >> 8` on UInt32 shifted by a register holding
/// 8) and a division's divisor (2026-10-24: the multiply high is more
/// instructions than sdiv but faster on the wall, divmod 0.880; not for
/// every operand).
fn (g: G) const_word(v0: Int) -> (Int, Bool) {
  let v = g.through_params(v0)
  let x = g.f.values[v]
  if x.op == ssa.Op.IntConv && x.args.len() == 1 && g.m.types[x.ty].kind == ssa.Kind.Int && g.m.types[x.ty].bits == 0 {
    return g.const_int(x.args[0])
  }
  g.const_int(v)
}

/// The value of an Int negation of an Int constant other than the
/// minimum (a negative literal: `-7` is a negation in the SSA), as
/// internal/arm64 negConst.
fn (g: G) neg_const(v: Int) -> (Int, Bool) {
  let x = g.f.values[v]
  if x.op != ssa.Op.Neg || g.kind(x.ty) != ssa.Kind.Int {
    return (0, false)
  }
  let (n, ok) = g.const_int(x.args[0])
  if !ok || n == MIN_INT {
    return (0, false)
  }
  (-n, true)
}

/// The parameters of the function (its entry block's).
fn (g: G) params() -> List[Int] {
  g.f.blocks[0].params
}

/// The terminator value of SSA block b, or -1.
fn (g: G) sterm(b: Int) -> Int {
  g.f.term(b)
}

/// Whether value v is a parameter of its block (isParam).
fn (g: G) is_param(v: Int) -> Bool {
  g.f.values[v].op == ssa.Op.Param
}

/// The SSA block a landing pad value w enters: the first successor of
/// the branch on it (`v.Pad.Block.Term().Succs[0].To`).
fn (g: G) pad_target(w: Int) -> Int {
  let t = g.f.term(g.f.values[w].block)
  g.f.edges[g.f.values[t].succs[0]].to
}

/// Whether t holds heap memory (Type.Heap), cached.
fn (var g: G) heap(t: Int) -> Bool {
  if g.heap_c[t] < 0 {
    g.heap_c[t] = if g.m.heap(t) { 1 } else { 0 }
  }
  g.heap_c[t] == 1
}

/// Whether t holds a Float (Type.HasFloat).
fn (g: G) has_float(t: Int) -> Bool {
  var seen: List[Bool] = []
  for _ in 0..g.m.types.len() {
    seen.push(false)
  }
  g.has_float_in(t, seen)
}

fn (g: G) has_float_in(t: Int, var seen: List[Bool]) -> Bool {
  if seen[t] {
    return false
  }
  seen[t] = true
  let x = g.m.types[t]
  match x.kind {
    Float => return true
    Struct => {
      for f in x.fields {
        if g.has_float_in(f.ty, seen) {
          return true
        }
      }
    }
    Enum => {
      for v in x.variants {
        for f in v.fields {
          if g.has_float_in(f.ty, seen) {
            return true
          }
        }
      }
    }
    Tuple | List | Box => {
      for e in x.elems {
        if g.has_float_in(e, seen) {
          return true
        }
      }
    }
    _ => {}
  }
  false
}
