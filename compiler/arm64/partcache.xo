// The part cache (decision 0220 addendum stage D 2e): a split
// generation's part (gen_part: its functions' text, their exception and
// debug records turned into the part's sections, its data, the helpers it
// wants, the module facts it refers to) under a key of everything that
// decides it, so an unchanged part is read instead of generated. The
// functions' fn keys (fcache.xo fn_key) decide their placed text; the key
// adds what the part itself reads: its place in the split (its index, its
// first and last function, the number of parts, its label namespace), the
// module settings in fn_key's header, the compile and std directories its
// debug lines name, and (with debug information) the types its debug
// entries describe, by every type's key (a type's names and layout). The
// entry is the part before drop_own_weak (which reads the whole module),
// its reference flags, and its wants by name (not how many of its
// functions came from the fn cache: the same part either way, and a
// verify build regenerates every function) (resolve_wants: a name not in
// the module regenerates the part). compiler/xo reads and writes the
// entries (bcache.xo, kind "part").

use std/crypto
use github.com/xo-lang/xo/compiler/ssa

const PART_CACHE_VERSION = "xo part cache v3"

/// The key of each part of m for os from the functions' keys (fkeys,
/// fcache.xo function_keys), "" for a part with a function not cached;
/// [] when the module is not split or fkeys is [].
pub fn part_keys(m: ssa.Module, os: Str, fkeys: List[Str]) -> List[Str] {
  let plist = part_lists(m)
  if plist.len() <= 1 || fkeys.len() != m.funcs.len() {
    return []
  }
  let names = part_names(m, plist)
  let np = plist.len()
  var head = StrBuilder.new()
  head.write("${PART_CACHE_VERSION}\n${FN_CACHE_VERSION}\n${os} ${m.goarch} regs=${m.arm64_regs} poison=${m.poison_frames} guard=${m.heap_guard} debug=${m.debug_info} dwaddr=${m.dw_data_addrs} nolibc=${m.nolibc} maplog=${m.map_log} mapcore=${m.map_core} mapbr=${m.map_branch} nopreempt=${m.no_preempt} det=${m.det} async=${m.async_preempt}${if m.dump_fn.is_empty() { "" } else { " dumpfn=${m.dump_fn}" }}\n")
  // no part count, part index, or function indexes (v2): a part's
  // output reads none of them (its labels count from 0 in its
  // namespace), and a cut that moves (a value cut, an added function)
  // left every later part's key changed
  // no paths: the text holds the .debug_str slots' placeholders
  // (debug.xo DW_SLOT_COMP), filled where the object leaves the compiler
  head.write("dwarf path slots ${DW_SLOT}\n")
  if m.debug_info {
    head.write("types ${crypto.sha256(ssa.type_keys(m).join("\n").bytes()).to_hex()}\n")
  }
  let h = head.freeze()
  var out: List[Str] = []
  for p in 0..np {
    var b = StrBuilder.new()
    b.write(h)
    b.write("part ${names[p].len()}:${names[p]}\n")
    var ok = true
    for fi in plist[p] {
      if fkeys[fi].is_empty() {
        ok = false
        break
      }
      b.write(fkeys[fi])
      b.write("\n")
    }
    out.push(if ok { crypto.sha256(b.freeze().bytes()).to_hex() } else { "" })
  }
  out
}

/// The cache entry of part (generated by g); None when it cannot be one
/// (an error, a skipped function, a want without a name).
fn encode_part(g: G, part: Part) -> Option[Bytes] {
  if !part.err.is_empty() || !part.skipped.is_empty() || g.want_keys.len() != part.wants.len() {
    return None
  }
  var ws: List[(Str, Want)] = []
  for (i, w) in part.wants.indexed() {
    ws.push((g.want_keys[i], w))
  }
  let (nws, ok) = g.name_wants(ws)
  if !ok {
    return None
  }
  var b = BytesBuilder.new()
  put_field(b, PART_CACHE_VERSION.bytes())
  put_field(b, part.asm.bytes())
  let flags = (if part.restorer_ref { 1 } else { 0 }) | (if part.words_ref { 2 } else { 0 }) | (if part.static_ref { 4 } else { 0 }) | (if part.clone_ref { 8 } else { 0 }) | (if part.sched_ref { 16 } else { 0 }) | (if part.personality_ref { 32 } else { 0 })
  put_field(b, "${flags}".bytes())
  put_field(b, "${nws.len()}".bytes())
  for (k, op, kind, tn, fname) in nws {
    put_field(b, k.bytes())
    put_field(b, "${op}".bytes())
    put_field(b, kind.bytes())
    put_field(b, tn.bytes())
    put_field(b, fname.bytes())
  }
  Some(b.freeze())
}

/// The part of an entry with this module's ids (g's); None for a
/// malformed entry or a want whose name the module lacks.
fn decode_part(g: G, d: Bytes) -> Option[Part] {
  var r = FieldReader{d: d}
  if r.str() != PART_CACHE_VERSION {
    return None
  }
  var p = Part{}
  p.asm = r.str()
  let flags = r.int()
  p.restorer_ref = (flags & 1) != 0
  p.words_ref = (flags & 2) != 0
  p.static_ref = (flags & 4) != 0
  p.clone_ref = (flags & 8) != 0
  p.sched_ref = (flags & 16) != 0
  p.personality_ref = (flags & 32) != 0
  let n = r.int()
  var nws: List[(Str, Int, Str, Str, Str)] = []
  for _ in 0..n {
    if !r.ok {
      return None
    }
    let k = r.str()
    let op = r.int()
    let kind = r.str()
    let tn = r.str()
    let fname = r.str()
    nws.push((k, op, kind, tn, fname))
  }
  if !r.ok || r.at != d.len() {
    return None
  }
  let (ws, ok) = g.resolve_wants(nws)
  if !ok {
    return None
  }
  for (_, w) in ws {
    p.wants.push(w)
  }
  Some(p)
}

/// The functions of each part of m (parallel.xo part_lists), for the
/// driver's reads of the part cache.
pub fn part_ranges(m: ssa.Module) -> List[List[Int]] { part_lists(m) }
