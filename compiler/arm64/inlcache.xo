// The inliner per function through the back-end cache (decision 0220
// addendum stage D part 2a). inline_module visits the functions in
// order and copies callee bodies as they are at that moment: a callee
// before the caller is already inlined into, one after it not. So the
// result for function i is decided by its body before inlining (its
// reference counting key, compiler/ssa rccache.xo: that key decides the
// pass's output, the inliner's input), the inliner's settings, and for
// every name it can reach through inlinable callees (the closure over
// their bodies before inlining: inlining copies names, it makes none)
// the facts inline_one reads of it (index, membership in each inlinable
// set, indirect, catches, result count) and the version of its body:
// the inline key of j for j < i, the reference counting key of j for
// j > i. compiler/xo reads and writes the entries (bcache.xo).

use std/crypto
use github.com/xo-lang/xo/compiler/ssa

/// The version of the keys and entries.
const INLINE_CACHE_VERSION = "xo inline cache v11"

/// What inline_cached did: the entries to store (key, entry), the
/// functions read from entries, the functions whose computed result
/// differs from their entry (verify), and whether anything changed.
pub struct InlineOut {
  pub changed: Bool = false
  pub stores: List[(Str, Bytes)] = []
  pub reused: Int = 0
  pub mismatches: List[Str] = []
}

/// The inline keys of a module (inline_keys) and the inliner's view of
/// it before inlining, which inline_cached reads rather than builds again.
pub struct InlineKeys {
  /// one per function, "" for one not cached; [] for none
  pub keys: List[Str] = []
  st: InlineState = InlineState{}
}

/// The inline key of each function of m (before inlining), from the
/// reference counting keys of its functions (rc_keys, one per function;
/// "" for one not cached); "" for a function not cached, [] for none.
/// The text of each key is built on up to jobs tasks: a key that names
/// the inline key of an earlier function is finished after, in order.
pub fn inline_keys(m: ssa.Module, rc_keys: List[Str], jobs: Int) -> InlineKeys {
  let n = m.funcs.len()
  if rc_keys.len() != n {
    return InlineKeys{}
  }
  let st = inline_state_jobs(m, jobs)
  let head = "${INLINE_CACHE_VERSION}\npasses ${m.passes_off.join(",")}\ndeny ${m.inline_deny.join(",")}\nreaders ${m.reader_bodies}\n"
  let texts = key_texts_all(st, rc_keys, head, jobs)
  var keys: List[Str] = []
  for i in 0..n {
    let k = match texts[i] {
      KeyText.Done(k) => k
      KeyText.Segs(segs) => key_of_segs(segs, keys)
    }
    keys.push(k)
  }
  InlineKeys{keys: keys, st: st}
}

/// A key's text: the key itself, or text pieces each followed by the
/// inline key of a function before it (-1 for none), to finish in order.
enum KeyText {
  Done(k: Str)
  Segs(segs: List[(Bytes, Int)])
}

/// The key of the pieces with the earlier keys put in; "" when one of
/// them is not cached.
fn key_of_segs(segs: List[(Bytes, Int)], keys: List[Str]) -> Str {
  var b = BytesBuilder.new()
  for (t, ci) in segs {
    b.write(t)
    if ci >= 0 {
      if keys[ci].is_empty() {
        return ""
      }
      b.write_str(" ${keys[ci]}")
    }
  }
  crypto.sha256(b.freeze()).to_hex()
}

/// key_text of every function, on up to jobs tasks, in function order.
fn key_texts_all(st: InlineState, rc_keys: List[Str], head: Str, jobs: Int) -> List[KeyText] {
  let n = rc_keys.len()
  if jobs <= 1 || n < 512 {
    var out: List[KeyText] = List.with_capacity(n)
    for i in 0..n {
      out.push(key_text(st, rc_keys, head, i))
    }
    return out
  }
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..jobs.min(n) {
      ts.push(s.spawn(fn() -> List[(Int, List[KeyText])] {
        var mine: List[(Int, List[KeyText])] = []
        while true {
          let i = next.add(128) - 128
          if i >= n {
            break
          }
          var part: List[KeyText] = []
          for fi in i..(i + 128).min(n) {
            part.push(key_text(st, rc_keys, head, fi))
          }
          mine.push((i, part))
        }
        mine
      }))
    }
    var all: List[(Int, List[KeyText])] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[KeyText] = List.with_capacity(n)
  for (_, part) in done.sort_by(fn(x) { x.0 }) {
    out = out + part
  }
  out
}

/// The text of function i's inline key: the inliner's settings (head),
/// its reference counting key and, for each name it can reach, the
/// facts the inliner reads of it and the version of an inlinable one's
/// body (the inline key of an earlier function, the reference counting
/// key of a later one). Done with the key when it names no earlier
/// function's inline key, or "" when i or a version it needs is not
/// cached.
fn key_text(st: InlineState, rc_keys: List[Str], head: Str, i: Int) -> KeyText {
  if rc_keys[i].is_empty() {
    return KeyText.Done(k: "")
  }
  var segs: List[(Bytes, Int)] = []
  var b = BytesBuilder.new()
  b.write_str(head)
  // no function indices (they depend on the whole program, so a std
  // function's key differed in every program, decision 0272): a callee
  // is its name, and its place before or after i is the version below
  b.write_str("self ${rc_keys[i]}\n")
  for s in name_closure(st, i).sort() {
    let ci = st.by_name.get(s) ?? -1
    let at = if ci < 0 { "-" } else if ci < i { "<" } else if ci > i { ">" } else { "=" }
    b.write_str("name ${s.len()}:${s} ${at} ${st.small.contains(s)} ${st.loopy.contains(s)} ${st.padded.contains(s)} ${st.fewl.contains(s)} ${st.tailbig.contains(s)}")
    if ci >= 0 {
      let g = st.sums[ci]
      b.write_str(" ${g.indirect} ${g.catches} ${g.nres}")
      if inlinable(st, s) {
        if ci < i {
          // the inline key of an earlier function, known in order
          segs.push((b.freeze(), ci))
          b = BytesBuilder.new()
        } else {
          let ver = if ci > i { rc_keys[ci] } else { "self" }
          if ver.is_empty() {
            return KeyText.Done(k: "")
          }
          b.write_str(" ${ver}")
        }
      }
    }
    b.write_str("\n")
  }
  let last = b.freeze()
  if segs.is_empty() {
    return KeyText.Done(k: crypto.sha256(last).to_hex())
  }
  segs.push((last, -1))
  KeyText.Segs(segs: segs)
}

/// The names function i's body refers to, closed over the bodies of the
/// inlinable functions it names (inlining copies names, it makes none),
/// in the order found (the summaries' names, inlsum.xo).
fn name_closure(st: InlineState, i: Int) -> List[Str] {
  var seen: Map[Str, Bool] = {}
  var all: List[Str] = []
  var work: List[Str] = []
  for s in st.sums[i].names {
    seen[s] = true
    all.push(s)
    work.push(s)
  }
  while !work.is_empty() {
    let s = work.pop() ?? ""
    if !inlinable(st, s) {
      continue
    }
    let ci = st.by_name.get(s) ?? -1
    if ci < 0 {
      continue
    }
    for t in st.sums[ci].names {
      if !seen.contains(t) {
        seen[t] = true
        all.push(t)
        work.push(t)
      }
    }
  }
  all
}

/// Whether name s is in one of the inlinable sets.
fn inlinable(st: InlineState, s: Str) -> Bool {
  st.small.contains(s) || st.loopy.contains(s) || st.padded.contains(s) || st.fewl.contains(s)
}

/// inline_apply through the cache: each function with an entry for its
/// key (keys from inline_keys; [] for none) is read from it, unless
/// verify, which computes every function and compares; the others are
/// inlined and encoded for the cache. The same module as inline_apply's.
/// The entries are decoded first, on up to jobs tasks, into a list of
/// their own: the walk in function order then puts each in place when it
/// reaches it, so a function it inlines sees every later callee before
/// inlining, as inline_module does. The computed functions are encoded
/// on tasks after the walk.
/// With lazy (decision 0283 stage B), a hit no computed function can
/// inline stays undecoded: a shell with its body facts and its entry in
/// m.lazy, until a reader forces it (ssa.force_lazy).
pub fn inline_cached(var m: ssa.Module, ik: InlineKeys, entries: Map[Str, Bytes], verify: Bool, break_inline: Bool, jobs: Int, lazy: Bool) -> InlineOut {
  var out = InlineOut{}
  let keys = ik.keys
  let st = ik.st
  // the module's types for the codec, without its functions
  let mt = ssa.Module{types: m.types, type_at: m.type_at, goarch: m.goarch}
  let n = m.funcs.len()
  var hits: List[(Int, Bytes)] = []
  if !verify {
    for fi in 0..n.min(keys.len()) {
      if !keys[fi].is_empty() {
        if let Some(e) = entries.get(keys[fi]) {
          hits.push((fi, e))
        }
      }
    }
  }
  var post: List[Option[(ssa.Func, Bool)]] = []
  for _ in 0..n {
    post.push(None)
  }
  var is_hit: Map[Int, Bool] = {}
  for (fi, _) in hits {
    is_hit[fi] = true
  }
  // the bodies the walk reads (decision 0220 addendum stage D 2b): each
  // function computed here and each it can inline (its name closure);
  // a function read from its entry needs neither its own body before
  // inlining nor, unless a computed one inlines it, decoding at all
  var need: Map[Int, Bool] = {}
  for fi in 0..n {
    if is_hit.contains(fi) {
      continue
    }
    need[fi] = true
    for s in name_closure(st, fi) {
      let ci = st.by_name.get(s) ?? -1
      if ci >= 0 {
        need[ci] = true
      }
    }
  }
  // with lazy, the hits no computed function reads stay undecoded
  var dec: List[(Int, Bytes)] = []
  var shells: List[Option[(ssa.Func, ssa.BodyFacts, ssa.LazyFn, Bool)]] = []
  for _ in 0..n {
    shells.push(None)
  }
  for (fi, e) in hits {
    if lazy && !need.contains(fi) {
      if let Some(h) = lazy_hit(mt, e, keys[fi]) {
        shells[fi] = Some(h)
        continue
      }
    }
    dec.push((fi, e))
  }
  let decoded = decode_all(mt, dec, jobs)
  if decoded.len() < dec.len() {
    // an entry that does not decode is computed, and may inline any hit:
    // decode them all
    for fi in 0..n {
      if let Some(_) = shells[fi] {
        shells[fi] = None
        dec.push((fi, entries.get(keys[fi]) ?? b""))
      }
    }
    for (fi, g, ch) in decode_all(mt, dec, jobs) {
      post[fi] = Some((g, ch))
    }
  } else {
    for (fi, g, ch) in decoded {
      post[fi] = Some((g, ch))
    }
  }
  if !m.lazy.is_empty() {
    var idx: List[Int] = []
    for (fi, _) in need {
      if m.lazy.contains(fi) {
        idx.push(fi)
      }
    }
    if !idx.is_empty() {
      ssa.force_lazy(m, idx, jobs)
    }
  }
  var computed: List[(Int, Bool)] = []
  for fi in 0..n {
    if let Some((g, ch)) = post[fi] {
      m.funcs[fi] = g
      m.lazy.remove(fi)
      m.funcs[fi].ckey = "inl ${keys[fi]}"
      out.changed = out.changed || ch
      out.reused += 1
      continue
    }
    if let Some((shell, x, l, ch)) = shells[fi] {
      m.funcs[fi] = shell
      m.facts[fi] = x
      m.lazy[fi] = l
      out.changed = out.changed || ch
      out.reused += 1
      continue
    }
    let ch = inline_one(m, st, fi)
    out.changed = out.changed || ch
    if fi < keys.len() && !keys[fi].is_empty() {
      m.funcs[fi].ckey = "inl ${keys[fi]}"
      computed.push((fi, ch))
    }
  }
  for (fi, enc) in encode_all(mt, m, computed, jobs) {
    let k = keys[fi]
    match entries.get(k) {
      Some(e) => {
        if e != enc {
          out.mismatches.push(m.funcs[fi].name)
        }
      }
      None => out.stores.push((k, enc))
    }
  }
  // none should be left but the hits left undecoded (lazy); any other is
  // decoded rather than built as a shell
  if lazy {
    ssa.force_lazy_unfacted(m, jobs)
  } else {
    ssa.force_lazy(m, [], jobs)
  }
  if break_inline {
    out.changed = inline_break(m) || out.changed
  }
  out
}

/// The functions of the entries (index, entry), on up to jobs tasks; an
/// entry that does not decode is left out (its function is computed).
fn decode_all(mt: ssa.Module, hits: List[(Int, Bytes)], jobs: Int) -> List[(Int, ssa.Func, Bool)] {
  let ops = ssa.op_names()
  let n = hits.len()
  let next = Atomic[Int].new(0)
  scope s {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(s.spawn(fn() -> List[(Int, ssa.Func, Bool)] {
        var mine: List[(Int, ssa.Func, Bool)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for j in i..(i + 64).min(n) {
            let (fi, e) = hits[j]
            if let Some((g, ch)) = inline_of_entry(mt, e, ops) {
              mine.push((fi, g, ch))
            }
          }
        }
        mine
      }))
    }
    var all: List[(Int, ssa.Func, Bool)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
}

/// The entries of the computed functions of m (index, changed), on up to
/// jobs tasks; a function the codec cannot hold is left out.
fn encode_all(mt: ssa.Module, m: ssa.Module, computed: List[(Int, Bool)], jobs: Int) -> List[(Int, Bytes)] {
  let n = computed.len()
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(s.spawn(fn() -> List[(Int, Bytes)] {
        var mine: List[(Int, Bytes)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for j in i..(i + 64).min(n) {
            let (fi, ch) = computed[j]
            if let Some(enc) = inline_entry(mt, m.funcs[fi], ch) {
              mine.push((fi, enc))
            }
          }
        }
        mine
      }))
    }
    var all: List[(Int, Bytes)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  // in function order, for the stores' and mismatches' order
  done.sort_by(fn(x) { x.0 })
}

/// Function f after inlining and whether the pass changed it, as an
/// entry; none when the codec cannot hold f.
/// The entry is the changed flag ("1" or "0"), the length of the body
/// facts (an unsigned varint) and the facts (ssa bodyfacts.xo, decision
/// 0283 stage B: what the passes after inlining read of a function left
/// undecoded), then the function (ssa.func_entry).
fn inline_entry(m: ssa.Module, f: ssa.Func, ch: Bool) -> Option[Bytes] {
  let facts = match ssa.encode_facts(m, ssa.body_facts(f, m.types)) {
    Some(x) => x
    None => return None
  }
  match ssa.func_entry(m, f) {
    Some(e) => {
      var b = BytesBuilder.new()
      b.write_str(if ch { "1" } else { "0" })
      put_uv(b, facts.len())
      b.write(facts)
      b.write(e)
      Some(b.freeze())
    }
    None => None
  }
}

/// An inline entry's parts: the changed flag, the facts' bytes and the
/// function's bytes; none for a malformed one.
fn entry_parts(e: Bytes) -> Option[(Bool, Bytes, Bytes)] {
  if e.is_empty() {
    return None
  }
  let (nf, at) = get_uv(e, 1)
  if at < 0 || nf > e.len() - at {
    return None
  }
  Some((e[0] == 0x31, e[at..at + nf], e[at + nf..e.len()]))
}

fn inline_of_entry(m: ssa.Module, e: Bytes, ops: Map[Str, ssa.Op]) -> Option[(ssa.Func, Bool)] {
  match entry_parts(e) {
    Some((ch, _, fb)) => {
      match ssa.func_of_entry(m, fb, ops) {
        Some(g) => Some((g, ch))
        None => None
      }
    }
    None => None
  }
}

/// A hit left undecoded (decision 0283 stage B): the shell of its
/// function (every field before the body), its body facts, the lazy
/// entry force_lazy decodes, and the changed flag; none when the entry
/// does not hold them.
fn lazy_hit(m: ssa.Module, e: Bytes, key: Str) -> Option[(ssa.Func, ssa.BodyFacts, ssa.LazyFn, Bool)] {
  let (ch, xb, fb) = match entry_parts(e) {
    Some(p) => p
    None => return None
  }
  let x = match ssa.decode_facts(m, xb) {
    Some(x) => x
    None => return None
  }
  match ssa.func_head_of_entry(m, fb) {
    Some(h) => {
      var shell = h
      shell.ckey = "inl ${key}"
      Some((shell, x, ssa.LazyFn{key: key, entry: fb, sum: b"", ckey: "inl ${key}"}, ch))
    }
    None => None
  }
}

fn put_uv(var b: BytesBuilder, n: Int) {
  var x = n
  while x >= 128 {
    b.write_byte(UInt8(128 | (x & 127)))
    x = x >> 7
  }
  b.write_byte(UInt8(x))
}

/// The unsigned varint at d[at..] and the position after it ((0, -1)
/// when cut short).
fn get_uv(d: Bytes, at0: Int) -> (Int, Int) {
  var x = 0
  var sh = 0
  var at = at0
  while at < d.len() && sh < 63 {
    let c = Int(d[at])
    at += 1
    x = x | ((c & 127) << sh)
    if c < 128 {
      return (x, at)
    }
    sh += 7
  }
  (0, -1)
}
