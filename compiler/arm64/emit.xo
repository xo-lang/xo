// Emission (internal/arm64 emit.go): the frame, the prologue and
// epilogue, the instructions with their parallel moves resolved, the
// out of line fault stubs, the call site tables, and the text peepholes
// of the function (load pairs, far slots, far branches).

/// A machine location: a register, or memory at [base, #off] (reg -1).
struct MLoc {
  reg: Int
  base: Str = ""
  off: Int = 0
  /// a wide value's location (decision 0323): moved 128 bits at a time
  wide: Bool = false
}

const M_LOC = 0
const M_IMM = 1
const M_SYM = 2
const M_FRAME = 3
const M_ZERO = 4
/// the address of byte imm of the frame's memory
const M_MEM = 5

struct MSrc {
  kind: Int
  l: MLoc = MLoc{reg: -1}
  imm: Int = 0
  sym: Str = ""
}

struct Move {
  dst: MLoc
  src: MSrc
}

/// The 128 bit name of floating point register r: q<n> for a load or
/// store, v<n> for an arrangement (decision 0323).
fn vreg_name(r: Int, q: Bool) -> Str {
  "${if q { "q" } else { "v" }}${r - FP_BASE}"
}

fn reg_name(r: Int, w: Bool) -> Str {
  if r >= FP_BASE {
    // the single precision name (`$wd0` of a Float, decision 0195)
    return if w { "s${r - FP_BASE}" } else { "d${r - FP_BASE}" }
  }
  if r == 31 {
    return if w { "wzr" } else { "xzr" }
  }
  if w {
    return "w${r}"
  }
  "x${r}"
}

const SCRATCH0 = 16
const SCRATCH1 = 17
/// parallel move cycles
const FSCRATCH = 63

fn gp_scratch(k: Int) -> Int {
  match k {
    0 => 16
    _ => 17
  }
}

fn fp_scratch(k: Int) -> Int {
  match k {
    0 => 62
    1 => 61
    _ => 63
  }
}

/// The layout of the frame (sp relative, after the prologue), size bytes,
/// 16 byte aligned (frameInfo):
///
///	[0, out_args)             stack arguments of calls (when any)
///	[out_off, out_off+8)      the $OUT slot (length out parameter)
///	[spill_base, ...)         spill slots, 8 bytes each
///	[save_base, ...)          callee saved registers
///	[mem_off, ...)            memory of by reference arguments (byref.xo)
///	[rec, rec+16)             the frame record (x29, x30); x29 = sp + rec
///
/// A spilled value may live in a stack word instead of a spill slot
/// (regalloc.xo SLOT_IN, SLOT_OUT, the pass arg_slots): a word of the
/// calls' stack arguments, or one of this function's own past size.
struct Frame {
  out_args: Int = 0
  out_off: Int = 0
  spill_base: Int = 0
  save_base: Int = 0
  mem_off: Int = 0
  rec: Int = 0
  size: Int = 0
  leaf: Bool = false
  /// x86_64 System V: the bytes of the frame below the pushed registers
  /// left in the red zone instead of subtracted from rsp (x86_emit_once:
  /// a function with no call); every rsp offset is this much lower
  rz: Int = 0
}

/// The size of the stack argument area of the calls: the stack
/// arguments, and the result words past the registers.
fn (g: G) out_arg_bytes() -> Int {
  var out = 0
  for b in g.order {
    for inst in g.blocks[b].insts {
      if inst.kind == K_CALL {
        var n = 0
        for l in g.call_locs(inst.srcs, inst.vfix) + g.abi_locs(regs(inst.defs)) {
          if l.reg < 0 {
            n = imax(n, l.slot + 1)
          }
        }
        out = imax(out, 8 * n)
      }
      // a fault stub's call too (a checked operation's arguments plus the
      // position's file, line, and column): past the registers on Win64
      // (decision 0228's 2026-10-25 addendum)
      if inst.has_fault {
        var n = 0
        for l in g.call_locs(inst.fargs, -1) {
          if l.reg < 0 {
            n = imax(n, l.slot + 1)
          }
        }
        out = imax(out, 8 * n)
      }
    }
  }
  out
}

/// The size of this function's own stack argument area in its caller's
/// frame, past its frame: the stack parameters, and the result words
/// past the registers (MAX_FRAME leaves 4 KiB of sp's reach for it).
fn (g: G) in_arg_bytes() -> Int {
  var n = 0
  for b in g.order {
    for inst in g.blocks[b].insts {
      var ls: List[Loc] = []
      if inst.kind == K_ENTRY {
        ls = g.param_locs(regs(inst.defs)) + g.abi_locs(regs(inst.defs))
      } else if inst.kind == K_RET {
        ls = g.abi_locs(inst.srcs)
      }
      for l in ls {
        if l.reg < 0 {
          n = imax(n, l.slot + 1)
        }
      }
    }
  }
  8 * n
}

/// An upper bound of the frame emit lays out with saved callee saved
/// registers.
fn (g: G) frame_bound(saved: Int) -> Int {
  g.out_arg_bytes() + 16 + 8 + 8 * g.slots + 8 * saved + g.mem_bytes + 16
}

fn (g: G) label(b: Int) -> Str {
  g.local("${g.lbl_prefix()}_b${g.blocks[b].id}")
}

/// The location of v, or none (a register never allocated).
fn (g: G) vloc(v: Int) -> (MLoc, Bool) {
  let (m, ok) = g.vloc0(v)
  if g.wide.contains(v) {
    return (MLoc{reg: m.reg, base: m.base, off: m.off, wide: true}, ok)
  }
  (m, ok)
}

fn (g: G) vloc0(v: Int) -> (MLoc, Bool) {
  let l = g.loc[v]
  if l.reg >= 0 {
    return (MLoc{reg: l.reg}, true)
  }
  if l.slot < 0 {
    // Go's zero mloc: register 0
    return (MLoc{reg: 0}, false)
  }
  if g.x86 {
    // rsp named as the x86 moves name it (same_loc compares the names:
    // a slot in a call's stack word is that word, arg_slots), and this
    // function's own stack words past the return address and rbp
    let off = if l.slot >= SLOT_IN && l.slot < SLOT_OUT { g.x86_in_arg(l.slot - SLOT_IN) } else { slot_off(g.fr, l.slot) }
    return (MLoc{reg: -1, base: "%rsp", off: off + g.stub_sp}, true)
  }
  (MLoc{reg: -1, base: "sp", off: slot_off(g.fr, l.slot) + g.stub_sp}, true)
}

fn (var g: G) emit() {
  g.nfunc += 1
  var fr = Frame{out_args: g.out_arg_bytes()}
  var calls = false
  for b in g.order {
    for inst in g.blocks[b].insts {
      calls = calls || (inst.kind == K_CALL && !inst.tail) || inst.frame
    }
  }
  fr.leaf = !calls && g.saved.is_empty() && g.slots == 0 && !g.out && g.mem_bytes == 0
  var base = 0
  if fr.out_args == 0 {
    base = 16 // the frame record comes first
  }
  fr.out_off = base + fr.out_args
  fr.spill_base = fr.out_off
  if g.out {
    fr.spill_base += 8
  }
  fr.save_base = fr.spill_base + 8 * g.slots
  fr.mem_off = fr.save_base + 8 * g.saved.len()
  if fr.out_args == 0 {
    fr.size = align16(fr.mem_off + g.mem_bytes)
  } else {
    fr.rec = align16(fr.mem_off + g.mem_bytes)
    fr.size = fr.rec + 16
  }
  if g.base != 0 {
    // a far frame: the saved registers and the frame record below the
    // spill slots, within reach of sp; the slots past it are addressed
    // through x28 (far_slots)
    fr.out_off = fr.out_args
    fr.save_base = fr.out_off
    if g.out {
      fr.save_base += 8
    }
    fr.rec = align16(fr.save_base + 8 * g.saved.len())
    fr.spill_base = fr.rec + 16
    fr.mem_off = fr.spill_base + 8 * g.slots
    fr.size = align16(fr.mem_off + g.mem_bytes)
  }
  if fr.leaf {
    fr.size = 0
  }
  if (fr.size > MAX_FRAME && g.base == 0) || fr.size >= MAX_FAR_FRAME || fr.rec + 16 > MAX_FRAME {
    g.fail("frame of ${g.f.name} too large (${fr.size} bytes)")
  }
  g.fr = fr
  g.shrink_plan()
  var b: List[Str] = []
  b.push("${g.cmt()} func ${g.f.name}\n")
  if g.f.name.contains("[") {
    // a generic instance std's object and the program's may both have
    b.push(g.weak_def(g.fname(g.f.name)))
  }
  g.func_header(b, g.fname(g.f.name), false)
  var pads = false
  for mb in g.order {
    for inst in g.blocks[mb].insts {
      pads = pads || inst.pad >= 0
    }
  }
  g.cfi_start(b, pads)
  if !g.shrink {
    g.prologue(b)
    g.cfi_frame(b)
  }
  // blocks reached once branches skip the blocks that only jump
  var live: List[Bool] = []
  for _ in 0..g.blocks.len() {
    live.push(false)
  }
  var work = [g.order[0]]
  while !work.is_empty() {
    let mb = work.pop() ?? 0
    if live[mb] {
      continue
    }
    live[mb] = true
    // the walk of the Go emitter is depth first; the set reached is the
    // same in any order
    for t in g.blocks[mb].succs {
      let ft = g.fwd(t)
      work.push(ft)
      let ti = g.blocks[ft].insts
      if ti.len() == 1 && ti[0].kind == K_CONDBR {
        for t2 in ti[0].targets {
          work.push(g.fwd(t2))
        }
      }
    }
  }
  var emitted: List[Int] = []
  for mb in g.order {
    if live[mb] {
      emitted.push(mb)
    }
  }
  // the variables' location ranges (decision 0252): a label at the first
  // emitted instruction at or past each boundary
  let dvp = g.dv_plan()
  var dv_labels: Map[Int, Str] = {}
  var dv_next = 0
  for (bi, mb) in emitted.indexed() {
    var next = -1
    if bi + 1 < emitted.len() {
      next = emitted[bi + 1]
    }
    b.push("${g.label(mb)}:\n")
    g.cur = mb
    if g.shrink && g.fedge[mb] == 1 {
      // a way into the blocks that need the frame (shrink.xo)
      g.prologue(b)
    }
    if g.shrink && mb == g.pro {
      // the first block laid out with the frame
      g.cfi_frame(b)
    }
    let head = g.check_head(mb)
    let ins = g.blocks[mb].insts
    // decision 0318: the instructions asynchronous preemption must not
    // interrupt (apreempt.xo), between two `_du` labels
    let (us, ue) = if g.m.async_preempt { g.unsafe_span(mb) } else { (-1, -1) }
    var uopen = false
    g.ended = false
    for (k, inst) in ins.indexed() {
      if g.ended {
        break // past a tail call
      }
      if k == us {
        b.push("${g.local("${g.lbl_prefix()}_du${g.du_n}")}:\n")
        g.du_n += 1
        uopen = true
      }
      g.pos = g.blocks[mb].start + 4 * k
      if dv_next < dvp.need.len() && dvp.need[dv_next] <= g.pos / 4 {
        let lab = g.local("${g.lbl_prefix()}_dv${g.pos / 4}")
        b.push("${lab}:\n")
        while dv_next < dvp.need.len() && dvp.need[dv_next] <= g.pos / 4 {
          dv_labels[dvp.need[dv_next]] = lab
          dv_next += 1
        }
      }
      if g.m.debug_info && inst.line != 0 && (inst.line != g.dl_last || inst.inl != g.dl_last_inl) {
        // a row of the line table: a label here (debug.xo), with the
        // line's inline site
        let lab = g.local("${g.lbl_prefix()}_dl${g.dl_n}")
        g.dl_n += 1
        b.push("${lab}:\n")
        g.dl_rows.push("${lab} ${inst.line} ${inst.inl}")
        g.dl_last = inst.line
        g.dl_last_inl = inst.inl
      }
      g.emit_inst(b, inst, next)
      g.pos = -1
      if k == 0 && head {
        b.push("${g.label(mb)}_c:\n") // past the check (rotate_jump)
      }
      if k == ue && uopen {
        b.push("${g.local("${g.lbl_prefix()}_du${g.du_n}")}:\n")
        g.du_n += 1
        uopen = false
      }
    }
    if uopen {
      b.push("${g.local("${g.lbl_prefix()}_du${g.du_n}")}:\n")
      g.du_n += 1
    }
  }
  if g.fr.leaf && !g.stubs.is_empty() {
    // a leaf function's fault stubs make a frame record before their call
    // (emit_plain), so the unwinder can go past them. Without landing pads
    // they are an unwind region of their own: a compact encoding has no
    // position, so one region made the body FRAME too, and an unwinder
    // trusting it took the caller's record for the leaf's (darwin's CPU
    // profile lost the caller of every sample in such a leaf,
    // gotchas/arm64-compact-unwind-leaf-fault-frames.md). The body's
    // region then states nothing: frameless, the return address in lr.
    // With landing pads the stubs stay in the body's region: their call
    // sites are in the function's LSDA, whose offsets count from the
    // region's start
    if !pads {
      b.push("\t.cfi_endproc\n\t.cfi_startproc\n")
    }
    b.push("\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n")
  }
  // the body's end, before the fault stubs: the variables' ranges past
  // its last instruction end here (at the function's end, past the
  // stubs, a register's range covered them, and the stub's own entries
  // came second: 2026-10-20)
  if g.m.debug_info && !g.dl_rows.is_empty() && dv_next < dvp.need.len() {
    let body_end = g.local("${g.lbl_prefix()}_dvs0")
    b.push("${body_end}:\n")
    while dv_next < dvp.need.len() {
      dv_labels[dvp.need[dv_next]] = body_end
      dv_next += 1
    }
  }
  b.push(g.stubs.join(""))
  if g.fr.leaf && !g.stubs.is_empty() && pads {
    // a leaf with fault stubs and landing pads keeps one unwind region
    // (its compact encoding FRAME for the body too); none was found
    // (2026-10-17: xo and every golden). The label, after the code, marks
    // it for internal/arm64 TestNoLeafWithPads
    b.push("${g.local("${g.lbl_prefix()}_leafpads")}:\n")
  }
  if g.m.debug_info && !g.dl_rows.is_empty() {
    let end = g.local("${g.lbl_prefix()}_dend")
    b.push("${end}:\n")
    // the boundaries past the last emitted instruction: the end
    while dv_next < dvp.need.len() {
      dv_labels[dvp.need[dv_next]] = end
      dv_next += 1
    }
    // the stubs follow the body: their rows after its rows
    // the inline sites: callee, file, call line, parent
    var sites: List[Str] = []
    for s in g.f.inl_sites {
      sites.push("${s.callee}|${s.file}|${s.call_line}|${s.parent}")
    }
    g.dbgs.push("${g.f.file}\t${g.f.name}\t${g.func_begin()}\t${end}\t${(g.dl_rows + g.dl_stub_rows).join(";")}\t${sites.join(";")}\t${g.dv_field(dvp, dv_labels)}")
  }
  b.push("\t.cfi_endproc\n")
  let sites = g.sites + g.stub_sites
  var ext = ""
  // cfi_start named the table whenever an instruction has a pad, also
  // when no call site with one was emitted (2026-10-22: with every
  // optional pass off, G.str_data's table was missing and the link failed
  // on a difference with an undefined label): an empty table then
  if pads || !sites.is_empty() {
    g.lsda(sites)
    ext = g.lsdas[g.lsdas.len() - 1]
  }
  b.push("\n")
  // the function's text split into lines once for the passes after it,
  // joined once (each split and joined it again: memmove and allocation
  // were a fifth of a cold build's emit, 2026-10-19)
  let ls0 = b.join("").split("\n")
  let cr = if g.x86 { ls0 } else { copy_runs_l(ls0) }
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: copy_runs on items gives the text pass's lines
    if line_texts(copy_runs_ops(to_lines(ls0))) != flat_lines(cr) {
      g.fail("XO_OP_VERIFY: ${g.f.name}: copy_runs_ops differs from copy_runs_l")
    }
  }
  let ls = if g.x86 { ls0 } else { borrow_flag_peep_l(cr) }
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: borrow_flag_peep on items gives the text
    // pass's lines
    if line_texts(borrow_flag_peep_ops(to_lines(cr))) != flat_lines(ls) {
      g.fail("XO_OP_VERIFY: ${g.f.name}: borrow_flag_peep_ops differs from borrow_flag_peep_l")
    }
  }
  let nrefs = label_counts(ls, ext)
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: the lines reload_reuse_l reads, as Ops (a
    // function from the backend cache is not emitted again: verify with
    // XO_BACKEND_CACHE=off)
    let bad = op_mismatch(ls)
    if !bad.is_empty() {
      g.fail("XO_OP_VERIFY: ${g.f.name}: ${bad}")
    }
  }
  var rr = reload_reuse_l(ls, nrefs)
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: the pass on items gives the text pass's lines
    let ported = line_texts(reload_reuse_ops(to_lines(ls), nrefs))
    if ported != rr {
      g.fail("XO_OP_VERIFY: ${g.f.name}: reload_reuse_ops differs from reload_reuse_l")
    }
  }
  let pm = pair_mem_l(rr, nrefs)
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: pair_mem on items gives the text pass's lines
    if line_texts(pair_mem_ops(to_lines(rr), nrefs)) != pm {
      g.fail("XO_OP_VERIFY: ${g.f.name}: pair_mem_ops differs from pair_mem_l")
    }
  }
  let fs = g.far_slots_l(pm)
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: far_slots on items gives the text pass's lines
    if line_texts(g.far_slots_ops(to_lines(pm))) != flat_lines(fs) {
      g.fail("XO_OP_VERIFY: ${g.f.name}: far_slots_ops differs from far_slots_l")
    }
  }
  let ft = g.far_tests_l(fs)
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: far_tests on items gives the text pass's lines
    if line_texts(g.far_tests_ops(to_lines(fs))) != flat_lines(ft) {
      g.fail("XO_OP_VERIFY: ${g.f.name}: far_tests_ops differs from far_tests_l")
    }
  }
  let le = g.local_empty_l(ft)
  if g.m.op_verify && !g.x86 {
    // decision 0274 step 3: local_empty on items gives the text pass's
    // text
    if g.local_empty_ops(to_lines(ft)) != le {
      g.fail("XO_OP_VERIFY: ${g.f.name}: local_empty_ops differs from local_empty_l")
    }
  }
  g.push_fn_text(le)
}

/// The number of instructions past which a function keeps adrp and add
/// for the empty list: its own copy, after the function, must stay in
/// adr's reach (1 MB).
const LOCAL_EMPTY_LIMIT = 200000

/// Rewrites each adrp and add of xo_empty_list in a function's text as
/// one adr of the function's own read only empty list ({IMMORTAL, 0,
/// 0}, placed after it, as a literal's count never written: decision
/// 0058): 453,000 pairs in xo, 1.8 MB (bench/results/
/// xo-code-size-2026-10-18.md, fix 4). A `[]` is then not one address,
/// so the runtime tests an empty list by its count (llrt
/// obj.is_immortal), never by address.
/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn (g: G) local_empty_l(lines: List[Str]) -> Str {
  let s = g.sym("xo_empty_list")
  let (pg, off) = if g.os == "darwin" { ("${s}@PAGE", "${s}@PAGEOFF") } else { (s, ":lo12:${s}") }
  if g.x86 || !any_has(lines, "adrp") || !any_has(lines, pg) {
    return lines.join("\n")
  }
  var n = 0
  for l in lines {
    if l.starts_with("\t") && !l.starts_with("\t.") {
      n += 1
    }
  }
  if n > LOCAL_EMPTY_LIMIT {
    return lines.join("\n")
  }
  let lab = g.local("${g.lbl_prefix()}_el")
  var out: List[Str] = []
  var hit = false
  var i = 0
  while i < lines.len() {
    let l = lines[i]
    if i + 1 < lines.len() && l.starts_with("\tadrp ") && l.ends_with(", ${pg}") {
      let r = l[6..l.len() - pg.len() - 2]
      if lines[i + 1] == "\tadd ${r}, ${r}, ${off}" {
        out.push("\tadr ${r}, ${lab}")
        hit = true
        i += 2
        continue
      }
    }
    out.push(l)
    i += 1
  }
  if !hit {
    return lines.join("\n")
  }
  // .long words: compiler/macho takes no .quad in code (IMMORTAL is
  // 1 << 63, its high half 2^31)
  out.join("\n") + "\t.p2align 3\n${lab}:\n\t.long 0\n\t.long 2147483648\n\t.long 0\n\t.long 0\n\t.long 0\n\t.long 0\n"
}

/// The number of instructions past which a function's tbz and tbnz may
/// not reach their targets.
const FAR_TEST_LIMIT = 7000

/// The number of instructions past which a function's b.cond, cbz, and
/// cbnz may not reach their targets.
const FAR_COND_LIMIT = 240000

/// Rewrites every tbz and tbnz of a function longer than FAR_TEST_LIMIT
/// instructions, and every b.cond, cbz, and cbnz of one longer than
/// FAR_COND_LIMIT, as the opposite test around an unconditional branch
/// (farTests; gotchas/arm64-tbz-range.md).
/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn (g: G) far_tests_l(lines: List[Str]) -> List[Str] {
  // instructions and the words of a jump table kept after its br
  // (JT_INLINE_WORDS), which lengthen the branches over it
  var n = 0
  for l in lines {
    if l.starts_with("\t") && (!l.starts_with("\t.") || l.starts_with("\t.long ")) {
      n += 1
    }
  }
  if n < FAR_TEST_LIMIT {
    return lines
  }
  var b: List[Str] = []
  var k = 0
  for (i, l) in lines.indexed() {
    if i > 0 {
      b.push("\n")
    }
    if !l.starts_with("\t") {
      b.push(l)
      continue
    }
    let f = fields_of(l)
    if f.len() == 4 && (f[0] == "tbz" || f[0] == "tbnz") {
      k += 1
      let skip = g.local("${g.lbl_prefix()}_far${k}")
      let o = if f[0] == "tbz" { "tbnz" } else { "tbz" }
      b.push("\t${o} ${f[1]} ${f[2]} ${skip}\n\tb ${f[3]}\n${skip}:")
      continue
    }
    if n >= FAR_COND_LIMIT && f.len() == 3 && (f[0] == "cbz" || f[0] == "cbnz") {
      k += 1
      let skip = g.local("${g.lbl_prefix()}_far${k}")
      let o = if f[0] == "cbz" { "cbnz" } else { "cbz" }
      b.push("\t${o} ${f[1]} ${skip}\n\tb ${f[2]}\n${skip}:")
      continue
    }
    if n >= FAR_COND_LIMIT && f.len() == 2 && f[0].starts_with("b.") && !inv_cond(f[0][2..f[0].len()]).is_empty() {
      k += 1
      let skip = g.local("${g.lbl_prefix()}_far${k}")
      b.push("\tb.${inv_cond(f[0][2..f[0].len()])} ${skip}\n\tb ${f[1]}\n${skip}:")
      continue
    }
    b.push(l)
  }
  b.join("").split("\n")
}

/// The fields of a line split on white space (strings.Fields).
fn fields_of(l: Str) -> List[Str] {
  var out: List[Str] = []
  let bs = l.bytes()
  var i = 0
  let n = bs.len()
  while i < n {
    while i < n && (bs[i] == ' ' || bs[i] == '\t' || bs[i] == '\n') {
      i += 1
    }
    if i >= n {
      break
    }
    var j = i
    while j < n && !(bs[j] == ' ' || bs[j] == '\t' || bs[j] == '\n') {
      j += 1
    }
    out.push(l[i..j])
    i = j
  }
  out
}

/// The largest frame whose every spill slot and saved register, and 4 KiB
/// of incoming stack arguments past them, is within reach of a scaled 12
/// bit `ldr`/`str` offset from sp.
const MAX_FRAME = 28672

/// What `add x28, sp, #hi, lsl #12` and `add x28, x28, #lo` reach.
const MAX_FAR_FRAME = 16777216

/// Rewrites the sp relative loads and stores of a far frame whose offset
/// is past the instruction's reach to go through x28 (farSlots).
/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn (g: G) far_slots_l(lines: List[Str]) -> List[Str] {
  if g.base == 0 {
    return lines
  }
  var b: List[Str] = []
  for (i, l) in lines.indexed() {
    if i > 0 {
      b.push("\n")
    }
    let (ok, op, rs, off) = parse_sp_ref(l)
    if !ok {
      b.push(l)
      continue
    }
    let (scale, pair) = mem_scale(op, rs)
    var reach = 4095 * scale
    if pair {
      reach = 63 * scale
    }
    if off <= reach && off % scale == 0 {
      b.push(l)
      continue
    }
    let hi = off & ~4095
    var lo = off & 4095
    b.push("\tadd x28, sp, #${hi >> 12}, lsl #12\n")
    if lo > reach || lo % scale != 0 {
      b.push("\tadd x28, x28, #${lo}\n")
      lo = 0
    }
    b.push("\t${op} ${rs}, [x28, #${lo}]")
  }
  b.join("").split("\n")
}

/// Whether l is `\t<op> <regs>, [sp, #<off>]` with op a load or store
/// (spRefRE): the op, the registers, and the offset.
fn parse_sp_ref(l: Str) -> (Bool, Str, Str, Int) {
  let bad = (false, "", "", 0)
  if !l.starts_with("\t") || !l.ends_with("]") {
    return bad
  }
  let sp = l.find(" ") ?? -1
  if sp < 0 {
    return bad
  }
  let op = l[1..sp]
  if !(op is "ldr" | "str" | "ldp" | "stp" | "ldrb" | "strb" | "ldrh" | "strh" | "ldrsw" | "ldrsb" | "ldrsh") {
    return bad
  }
  let rest = l[sp + 1..l.len()]
  // ([^\[]+), \[sp, #([0-9]+)\]$
  let br = rest.find("[") ?? -1
  if br < 2 || rest[br - 2..br] != ", " {
    return bad
  }
  let rs = rest[0..br - 2]
  if rs.is_empty() {
    return bad
  }
  let tail = rest[br..rest.len()]
  if !tail.starts_with("[sp, #") {
    return bad
  }
  let num = tail[6..tail.len() - 1]
  if !is_digits(num) {
    return bad
  }
  match Int.parse(num) {
    Some(off) => (true, op, rs, off)
    None => bad
  }
}

/// The access size of a load or store of regs (the scale of its offset),
/// and whether it is a pair.
fn mem_scale(op: Str, rs: Str) -> (Int, Bool) {
  match op {
    "ldrb" | "strb" | "ldrsb" => return (1, false)
    "ldrh" | "strh" | "ldrsh" => return (2, false)
    "ldrsw" => return (4, false)
    _ => {}
  }
  var size = 8
  if rs.starts_with("w") || rs.starts_with("s") {
    size = 4
  } else if rs.starts_with("q") {
    size = 16
  } else if rs.starts_with("h") {
    size = 2
  } else if rs.starts_with("b") {
    size = 1
  }
  (size, op == "ldp" || op == "stp")
}

/// The stride of the stack probes: the smallest guard page.
const PROBE_PAGE = 4096

/// The most pages probe_sp probes without a loop.
const PROBE_UNROLL = 8

/// Lowers sp by n, touching every page on the way when n is more than
/// one page (probeSP; gotchas/arm64-large-frame.md).
fn probe_sp(var b: List[Str], n0: Int, loop: Str) {
  var n = n0
  let pages = (n - 1) / PROBE_PAGE
  if pages > PROBE_UNROLL {
    b.push("\tmov x16, #${pages}\n${loop}:\n\tsub sp, sp, #${PROBE_PAGE >> 12}, lsl #12\n\tstr xzr, [sp]\n\tsubs x16, x16, #1\n\tb.ne ${loop}\n")
    n -= pages * PROBE_PAGE
  }
  while n > PROBE_PAGE {
    b.push("\tsub sp, sp, #${PROBE_PAGE >> 12}, lsl #12\n\tstr xzr, [sp]\n")
    n -= PROBE_PAGE
  }
  sub_sp(b, "sub", n)
}

fn sub_sp(var b: List[Str], op: Str, n0: Int) {
  var n = n0
  if n >= 4096 {
    b.push("\t${op} sp, sp, #${n >> 12}, lsl #12\n")
    n = n & 4095
  }
  if n > 0 {
    b.push("\t${op} sp, sp, #${n}\n")
  }
}

fn (g: G) prologue(var b: List[Str]) {
  let fr = g.fr
  if fr.leaf {
    return
  }
  if fr.rec == 0 && fr.size <= 504 {
    b.push("\tstp x29, x30, [sp, #-${fr.size}]!\n\tmov x29, sp\n")
  } else {
    probe_sp(b, fr.size, g.local("${g.lbl_prefix()}_probe"))
    if fr.rec <= 504 {
      b.push("\tstp x29, x30, [sp, #${fr.rec}]\n")
    } else {
      b.push("\tstr x29, [sp, #${fr.rec}]\n\tstr x30, [sp, #${fr.rec + 8}]\n")
    }
    if fr.rec >= 4096 {
      // add takes a 12 bit immediate, optionally shifted by 12
      b.push("\tadd x29, sp, #${fr.rec >> 12}, lsl #12\n")
      let lo = fr.rec & 4095
      if lo > 0 {
        b.push("\tadd x29, x29, #${lo}\n")
      }
    } else {
      b.push("\tadd x29, sp, #${fr.rec}\n")
    }
  }
  g.saves(b, "str", "stp")
  g.poison_frame(b)
}

/// The poison word (ssa.Module.poison_frames): 0xdeadbeefdeadbeef, not a
/// canonical address, so a load through it faults, and recognizable in a
/// register dump or a printed length.
const POISON_HALVES = [48879, 57005, 48879, 57005]

/// Fills the frame's words that the code writes before it reads (the
/// outgoing arguments, the spill slots, the memory area) with the poison
/// word when the module asks for it (XO_POISON_FRAMES=1), so a read of one
/// that no path wrote shows at once. Not the frame record or the saved
/// registers; not a far frame (g.base, its slots past sp's reach).
fn (g: G) poison_frame(var b: List[Str]) {
  if !g.m.poison_frames || g.x86 || g.fr.leaf || g.base != 0 {
    return
  }
  let fr = g.fr
  let lo = if fr.out_args == 0 { 16 } else { 0 }
  let spans = [(lo, fr.save_base), (fr.mem_off, fr.mem_off + g.mem_bytes)]
  var any = false
  for (s, e) in spans {
    any = any || s + 8 <= e
  }
  if !any {
    return
  }
  b.push("\tmov x16, #${POISON_HALVES[0]}\n")
  for k in 1..4 {
    b.push("\tmovk x16, #${POISON_HALVES[k]}, lsl #${16 * k}\n")
  }
  for (s, e) in spans {
    var off = s
    while off + 16 <= e && off <= 496 {
      b.push("\tstp x16, x16, [sp, #${off}]\n")
      off += 16
    }
    while off + 8 <= e {
      if off <= 32760 {
        b.push("\tstr x16, [sp, #${off}]\n")
      } else {
        b.push("\tadd x17, sp, #${off >> 12}, lsl #12\n")
        if (off & 4095) > 0 {
          b.push("\tadd x17, x17, #${off & 4095}\n")
        }
        b.push("\tstr x16, [x17]\n")
      }
      off += 8
    }
  }
}

/// Stores or loads the callee saved registers, in pairs when it can (the
/// higher register first, gotchas/arm64-stp-pair-order.md).
fn (g: G) saves(var b: List[Str], one: Str, two: Str) {
  var k = 0
  let n = g.saved.len()
  while k < n {
    let r = g.saved[k]
    let off = g.fr.save_base + 8 * k
    if k + 1 < n && (g.saved[k + 1] >= FP_BASE) == (r >= FP_BASE) && off <= 496 {
      b.push("\t${two} ${reg_name(g.saved[k + 1], false)}, ${reg_name(r, false)}, [sp, #${off}]\n")
      k += 2
      continue
    }
    b.push("\t${one} ${reg_name(r, false)}, [sp, #${off}]\n")
    k += 1
  }
}

fn (g: G) epilogue(var b: List[Str]) {
  g.unframe(b)
  b.push("\tret\n")
}

/// Whether the current block runs with the frame made.
fn (g: G) framed_here() -> Bool {
  !g.fr.leaf && !(g.shrink && g.fl[g.cur])
}

/// Undoes the prologue (the epilogue but its `ret`), when the current
/// block runs with the frame.
fn (g: G) unframe(var b: List[Str]) {
  let fr = g.fr
  if !g.framed_here() {
    return
  }
  g.saves(b, "ldr", "ldp")
  if fr.rec == 0 && fr.size <= 504 {
    b.push("\tldp x29, x30, [sp], #${fr.size}\n")
    return
  }
  if fr.rec <= 504 {
    b.push("\tldp x29, x30, [sp, #${fr.rec}]\n")
  } else {
    b.push("\tldr x29, [sp, #${fr.rec}]\n\tldr x30, [sp, #${fr.rec + 8}]\n")
  }
  sub_sp(b, "add", fr.size)
}

fn (g: G) msrc_of(a: Src) -> MSrc {
  if a.kind == S_REG {
    if a.v == 0 {
      return MSrc{kind: M_ZERO}
    }
    let (l, ok) = g.vloc(a.v)
    if !ok {
      return MSrc{kind: M_ZERO}
    }
    return MSrc{kind: M_LOC, l: l}
  }
  if a.kind == S_IMM {
    return MSrc{kind: M_IMM, imm: a.imm}
  }
  if a.kind == S_SYM {
    return MSrc{kind: M_SYM, sym: a.sym}
  }
  if a.kind == S_MEM {
    return MSrc{kind: M_MEM, imm: a.imm}
  }
  MSrc{kind: M_FRAME}
}

/// The moves that put srcs in their ABI locations (stack slots at [base,
/// #off0 + 8k]).
fn (g: G) call_moves(srcs: List[Src], base: Str, off0: Int) -> List[Move] { g.call_moves_v(srcs, base, off0, -1) }

/// call_moves with the variadic arguments from index vfix on the stack
/// (call_locs).
fn (g: G) call_moves_v(srcs: List[Src], base: Str, off0: Int, vfix: Int) -> List[Move] {
  var ms: List[Move] = []
  for (k, l) in g.call_locs(srcs, vfix).indexed() {
    var dst = MLoc{reg: l.reg}
    if l.reg < 0 {
      dst = MLoc{reg: -1, base: base, off: off0 + 8 * l.slot}
    }
    ms.push(Move{dst: dst, src: g.msrc_of(srcs[k])})
  }
  ms
}

fn (var g: G) emit_inst(var b: List[Str], inst: Inst, next: Int) {
  if inst.kind == K_PLAIN {
    g.emit_plain(b, inst)
  } else if inst.kind == K_PMOVE {
    var ms: List[Move] = []
    for (k, d) in inst.defs.indexed() {
      let (l, ok) = g.vloc(d)
      if !ok {
        continue
      }
      ms.push(Move{dst: l, src: g.msrc_of(inst.srcs[k])})
    }
    g.parallel(b, ms)
  } else if inst.kind == K_CALL {
    // a cold call's saves (regalloc.xo cold_saves): stored before the
    // argument moves, which may take their registers
    var saves: List[Move] = []
    var loads: List[Move] = []
    for (r, sl) in inst.csave {
      let at = MLoc{reg: -1, base: "sp", off: slot_off(g.fr, sl) + g.stub_sp}
      saves.push(Move{dst: at, src: MSrc{kind: M_LOC, l: MLoc{reg: r}}})
      loads.push(Move{dst: MLoc{reg: r}, src: MSrc{kind: M_LOC, l: at}})
    }
    if !saves.is_empty() {
      g.parallel(b, saves)
    }
    g.parallel(b, g.call_moves_v(inst.srcs, "sp", 0, inst.vfix))
    if inst.tail {
      // a tail call (shrink.xo mark_tails): the frame undone, a branch;
      // the callee returns to this function's caller
      g.unframe(b)
      if inst.indirect {
        b.push("\tbr x0\n")
      } else if inst.cptr {
        b.push("\tbr x${inst.srcs.len() - 1}\n")
      } else {
        b.push("\tb ${inst.sym}\n")
      }
      g.ended = true
      return
    }
    var cs_to = ""
    if inst.pad >= 0 {
      let (from, to) = g.call_site_labels()
      b.push("${from}:\n")
      g.sites.push(CallSite{from: from, to: to, pad: g.pad_of(inst.pad)})
      cs_to = to
    }
    if inst.indirect {
      b.push("\tblr x0\n")
    } else if inst.svc {
      b.push("\tmov x8, x6\n\tsvc #0\n")
    } else if inst.cptr {
      b.push("\tblr x${inst.srcs.len() - 1}\n")
    } else {
      b.push("\tbl ${inst.sym}\n")
    }
    if !cs_to.is_empty() {
      b.push("${cs_to}:\n")
    }
    if inst.noret {
      return
    }
    var ms: List[Move] = []
    for (k, l) in g.abi_locs(regs(inst.defs)).indexed() {
      var src = MLoc{reg: l.reg}
      if l.reg < 0 {
        // a result word past the registers: the callee stored it in the
        // stack argument area
        src = MLoc{reg: -1, base: "sp", off: 8 * l.slot}
      }
      let (d, ok) = g.vloc(inst.defs[k])
      if ok {
        ms.push(Move{dst: d, src: MSrc{kind: M_LOC, l: src}})
      }
    }
    g.parallel(b, ms)
    if !loads.is_empty() {
      g.parallel(b, loads)
    }
  } else if inst.kind == K_ENTRY {
    var ms: List[Move] = []
    for (k, l) in g.abi_locs(regs(inst.defs)).indexed() {
      var src = MLoc{reg: l.reg}
      if l.reg < 0 {
        src = MLoc{reg: -1, base: "sp", off: g.fr.size + 8 * l.slot}
      }
      let (d, ok) = g.vloc(inst.defs[k])
      if ok {
        ms.push(Move{dst: d, src: MSrc{kind: M_LOC, l: src}})
      }
    }
    g.parallel(b, ms)
  } else if inst.kind == K_RET {
    var ms: List[Move] = []
    for (k, l) in g.abi_locs(inst.srcs).indexed() {
      var dst = MLoc{reg: l.reg}
      if l.reg < 0 {
        // past the registers: into the caller's stack argument area (its
        // arguments were all read at entry)
        dst = MLoc{reg: -1, base: "sp", off: g.fr.size + 8 * l.slot}
      }
      ms.push(Move{dst: dst, src: g.msrc_of(inst.srcs[k])})
    }
    g.parallel(b, ms)
    g.epilogue(b)
  } else if inst.kind == K_JUMP {
    if g.shrink && g.fedge[g.cur] == 2 {
      // a way out of the blocks that need the frame (shrink.xo)
      g.unframe(b)
      let r = g.fwd(inst.targets[0])
      if g.only_return(r) {
        // the return copied here, past the frame (no branch back to it)
        let cur = g.cur
        let pos = g.pos
        g.cur = r
        for (k, x) in g.blocks[r].insts.indexed() {
          // the copy is allocated as the block (emit_plain's free
          // registers at its positions)
          g.pos = g.blocks[r].start + 4 * k
          g.emit_inst(b, x, -1)
        }
        g.pos = pos
        g.cur = cur
        return
      }
    }
    let t = g.fwd(inst.targets[0])
    if t == next {
      return
    }
    if g.rotate_jump(b, t) {
      return
    }
    let ti = g.blocks[t].insts
    if ti.len() == 1 && ti[0].kind == K_CONDBR && t != g.cur && g.same_frame(t) {
      // a loop header that only tests: test here (one taken branch per
      // iteration instead of two)
      let pos = g.pos
      g.pos = g.blocks[t].start
      g.emit_inst(b, ti[0], next)
      g.pos = pos
      return
    }
    b.push("\tb ${g.label(t)}\n")
  } else if inst.kind == K_CONDBR {
    g.emit_condbr(b, inst, next)
  } else if inst.kind == K_SWITCH {
    g.emit_switch(b, inst)
  } else if inst.kind == K_TRAP {
    b.push("\tbrk #1\n")
  }
}

fn (var g: G) emit_condbr(var b: List[Str], inst: Inst, next: Int) {
  let t = g.fwd(inst.targets[0])
  let f = g.fwd(inst.targets[1])
  if t == f {
    // both ways go to one block, but the compare stays: the block may
    // test these flags without a compare of its own (reuse_flags)
    if !inst.text.is_empty() && inst.cond != "cbnz" && inst.cond != "tbz" && inst.cond != "tbnz" {
      g.emit_plain(b, Inst{kind: K_PLAIN, text: inst.text, us: inst.us})
    }
    if t != next {
      b.push("\tb ${g.label(t)}\n")
    }
    return
  }
  // fall: the target the branch falls through to; a moved latch is
  // copied after the branch instead (lsr.xo dup_latch)
  var fall = next
  let dl = g.dup_latch(t, f, next)
  if dl >= 0 {
    fall = dl
  }
  if inst.cond == "cbnz" {
    let r = g.use_reg(b, inst.us[0], 0)
    if t == fall {
      b.push("\tcbz ${r}, ${g.label(f)}\n")
    } else {
      b.push("\tcbnz ${r}, ${g.label(t)}\n")
      if f != fall {
        b.push("\tb ${g.label(f)}\n")
      }
    }
  } else if inst.cond == "tbz" || inst.cond == "tbnz" {
    let r = g.use_reg(b, inst.us[0], 0)
    if t == fall {
      let c = if inst.cond == "tbz" { "tbnz" } else { "tbz" }
      b.push("\t${c} ${r}, #${inst.bit}, ${g.label(f)}\n")
    } else {
      b.push("\t${inst.cond} ${r}, #${inst.bit}, ${g.label(t)}\n")
      if f != fall {
        b.push("\tb ${g.label(f)}\n")
      }
    }
  } else {
    if !inst.text.is_empty() {
      // empty: the flags of the predecessor's compare (reuse_flags)
      g.emit_plain(b, Inst{kind: K_PLAIN, text: inst.text, us: inst.us})
    }
    if t == fall {
      b.push("\tb.${inv_cond(inst.cond)} ${g.label(f)}\n")
    } else {
      b.push("\tb.${inst.cond} ${g.label(t)}\n")
      if f != fall {
        b.push("\tb ${g.label(f)}\n")
      }
    }
  }
  if dl >= 0 {
    g.emit_latch(b, dl, next)
  }
}

/// The register name of use v, reloading a spilled one into scratch
/// register k of its class.
fn (g: G) use_reg(var b: List[Str], v: Int, k: Int) -> Str {
  if v == 0 {
    return "xzr"
  }
  let (l, _) = g.vloc(v)
  if l.reg >= 0 {
    return reg_name(l.reg, false)
  }
  let r = if g.fp[v] { fp_scratch(k) } else { gp_scratch(k) }
  if g.wide.contains(v) {
    b.push(q_mem("ldr", r, l))
  } else {
    b.push("\tldr ${reg_name(r, false)}, [${l.base}, #${l.off}]\n")
  }
  reg_name(r, false)
}

/// The register for the n-th reload or spilled result (of class fp) of
/// the instruction being emitted: the scratch registers first, then a
/// caller saved register no value holds at the instruction (not a
/// callee saved one: a shrink wrapped block runs before they are saved),
/// not one in taken (2026-10-16: past three,
/// they all took the last scratch register, and a template with four
/// spilled operands, such as a long adc chain, read a wrong value).
/// -1 when none is free (scratch_or_fail fails the function then).
fn (g: G) scratch_reg(fp: Bool, n: Int, taken: List[Int]) -> Int {
  // x16 and x17 (d30, d29, d31: three of them), then a register free at
  // the instruction
  if (fp && n < 3) || (!fp && n < 2) {
    return if fp { fp_scratch(n) } else { gp_scratch(n) }
  }
  if g.pos >= 0 && !g.occ_regs.is_empty() {
    let span = [Rng{s: g.pos, e: g.pos + 3}]
    let pool = if fp { fp_caller() } else { gp_caller() }
    for r in pool {
      if (r >= FP_BASE) != fp || taken.contains(r) || r >= g.occ_regs.len() {
        continue
      }
      if !overlaps_sorted(g.occ_regs[r], span) {
        return r
      }
    }
    // then a callee saved register the prologue saves, in a block that
    // runs with the frame
    if !(g.shrink && g.fl[g.cur]) {
      for r in g.saved {
        if (r >= FP_BASE) != fp || taken.contains(r) || r >= g.occ_regs.len() || r == g.base {
          continue
        }
        if !overlaps_sorted(g.occ_regs[r], span) {
          return r
        }
      }
    }
  }
  -1
}

/// scratch_reg, or a failure (G.fail, which writes the function's IR
/// for the driver: 2026-10-21, it was a fault that stopped the process
/// first) and a placeholder register, generation going on as after any
/// failure.
fn (var g: G) scratch_or_fail(fp: Bool, n: Int, taken: List[Int]) -> Int {
  let r = g.scratch_reg(fp, n, taken)
  if r >= 0 {
    return r
  }
  g.fail("internal: no free register for a spilled operand in ${g.f.name}: one instruction with ${taken.len()} registers and more spilled operands than free registers")
  if fp { fp_scratch(0) } else { gp_scratch(0) }
}

/// The operand number of a template's $uN or $dN whose digits start at
/// i, and the index past them (any number of digits: a template may name
/// more than ten operands).
fn operand_num(tb: Bytes, i: Int) -> (Int, Int) {
  var k = 0
  var j = i
  while j < tb.len() && Int(tb[j]) >= 48 && Int(tb[j]) <= 57 {
    k = k * 10 + Int(tb[j]) - 48
    j += 1
  }
  (k, j)
}

/// Expands a template.
fn (var g: G) emit_plain(var b: List[Str], inst: Inst) {
  let t = inst.text
  let tb = t.bytes()
  let tn = tb.len()
  // reload the spilled uses the template names
  var use_reg: List[Int] = List.with_capacity(imax(inst.us.len(), 10))
  for _ in 0..imax(inst.us.len(), 10) {
    use_reg.push(-1)
  }
  var ngp = 0
  var nfp = 0
  var i = 0
  while i < tn {
    if tb[i] != '$' {
      i += 1
      continue
    }
    var j = i + 1
    // $w, and decision 0323's $q and $v, name the same operand
    if j < tn && (tb[j] == 'w' || tb[j] == 'q' || tb[j] == 'v') {
      j += 1
    }
    if j + 1 < tn && tb[j] == 'u' {
      let (k, _) = operand_num(tb, j + 1)
      if use_reg[k] == -1 {
        let v = inst.us[k]
        if v == 0 {
          use_reg[k] = 31
        } else {
          let (l, _) = g.vloc(v)
          if l.reg >= 0 {
            use_reg[k] = l.reg
          } else {
            var r = 0
            if g.fp[v] {
              r = g.scratch_or_fail(true, nfp, use_reg)
              nfp += 1
            } else {
              r = g.scratch_or_fail(false, ngp, use_reg)
              ngp += 1
            }
            if g.wide.contains(v) {
              b.push(q_mem("ldr", r, l))
            } else {
              b.push("\tldr ${reg_name(r, false)}, [${l.base}, #${l.off}]\n")
            }
            use_reg[k] = r
          }
        }
      }
    }
    i += 1
  }
  // the spilled definitions: each its own register (scratch_reg). A
  // template that writes its definitions after reading every use takes
  // them from the first scratch register on (the uses' are free again);
  // an early one (a definition written while the uses are read: decision
  // 0200's cas templates, the adc chains) after the uses', and none of
  // theirs
  var taken: List[Int] = []
  for d in inst.defs {
    let (l, ok) = g.vloc(d)
    if ok && l.reg >= 0 {
      taken.push(l.reg)
    }
  }
  if inst.early {
    for r in use_reg {
      if r >= 0 {
        taken.push(r)
      }
    }
  }
  // a definition into the scratch register after the uses' when both
  // fit in the two scratch registers (x16, x17): the reloaded use keeps
  // its register, so reload_reuse_l drops its next reload (2026-10-21:
  // http.dispatch's 35-word `req with {...}` copied each word as `ldr
  // x16, [sp, #88]`, `ldr x16, [x16, #k]`, `str x16, [sp, #m]`, the
  // spilled record's base reloaded for every word)
  var nsp = 0
  for d in inst.defs {
    let (l, ok) = g.vloc(d)
    if !(ok && l.reg >= 0) && !g.fp[d] {
      nsp += 1
    }
  }
  // (not a template that names x16 or x17 itself)
  let own = t.contains("x16") || t.contains("x17") || t.contains("w16") || t.contains("w17")
  var dgp = if inst.early || (!own && ngp > 0 && ngp + nsp <= 2) { ngp } else { 0 }
  var dfp = if inst.early { nfp } else { 0 }
  var def_reg: List[Int] = []
  var stores: List[Str] = []
  for d in inst.defs {
    let (l, ok) = g.vloc(d)
    if ok && l.reg >= 0 {
      def_reg.push(l.reg)
      continue
    }
    var r = 0
    if g.fp[d] {
      r = g.scratch_or_fail(true, dfp, taken)
      dfp += 1
    } else {
      r = g.scratch_or_fail(false, dgp, taken)
      dgp += 1
    }
    taken.push(r)
    def_reg.push(r)
    if ok {
      if g.wide.contains(d) {
        stores.push(q_mem("str", r, l))
      } else {
        stores.push("\tstr ${reg_name(r, false)}, [${l.base}, #${l.off}]\n")
      }
    }
  }
  if t == "mov $d0, $u0" && def_reg[0] == use_reg[0] && stores.is_empty() {
    return // a copy into the same register
  }
  var out = StrBuilder.new()
  out.write("\t")
  var from = 0
  i = 0
  while i < tn {
    let c = tb[i]
    if c == '\n' {
      out.write(t[from..i])
      out.write("\n\t")
      i += 1
      from = i
      continue
    }
    if c != '$' {
      i += 1
      continue
    }
    out.write(t[from..i])
    if t[i..tn].starts_with("$OUT") {
      out.write("${g.fr.out_off}")
      i += 4
      from = i
      continue
    }
    var j = i + 1
    var w = false
    // $q and $v: a V register's 128 bit names (decision 0323's wide
    // values: `ldr $qd0, [...]`, `fadd $vd0.2d, $vu0.2d, $vu1.2d`)
    // 0: a scalar name, 1: q<n>, 2: v<n>
    var vk = 0
    if tb[j] == 'w' {
      w = true
      j += 1
    } else if tb[j] == 'q' || tb[j] == 'v' {
      vk = if tb[j] == 'q' { 1 } else { 2 }
      j += 1
    }
    let (k, end) = operand_num(tb, j + 1)
    let r = if tb[j] == 'u' { use_reg[k] } else { def_reg[k] }
    if vk != 0 {
      out.write(vreg_name(r, vk == 1))
    } else {
      out.write(reg_name(r, w))
    }
    i = end
    from = i
  }
  out.write(t[from..tn])
  out.write("\n")
  b.push(out.freeze())
  if inst.poll {
    // the cold path after the function: where x30 still holds the return
    // address (a leaf, or a block that runs without the frame, shrink.xo)
    // the call would overwrite it, so the stub keeps it in a frame record
    // as a fault stub does
    g.nstub += 1
    let l = g.local("${g.lbl_prefix()}_pp${g.nstub}")
    b.push("\tcbnz w16, ${l}\n${l}_r:\n")
    let stub = g.sym("xo_preempt_stub")
    if g.fr.leaf || (g.shrink && g.fl[g.cur]) {
      g.stubs.push("${l}:\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n\tbl ${stub}\n\tldp x29, x30, [sp], #16\n\tb ${l}_r\n")
    } else {
      g.stubs.push("${l}:\n\tbl ${stub}\n\tb ${l}_r\n")
    }
  }
  if inst.has_fault {
    g.nstub += 1
    let l = g.local("${g.lbl_prefix()}_fault${g.nstub}")
    b.push("\tb.${inst.fcond} ${l}\n")
    var sb: List[Str] = []
    sb.push("${l}:\n")
    if g.m.debug_info && inst.line != 0 {
      // the stub's row: the faulting instruction's line (a traceback's
      // innermost frame returns into the stub)
      let lab = g.local("${g.lbl_prefix()}_dl${g.dl_n}")
      g.dl_n += 1
      sb.push("${lab}:\n")
      g.dl_stub_rows.push("${lab} ${inst.line} ${inst.inl}")
    }
    if g.fr.leaf {
      // a frame record for the unwinder (the call overwrites x30)
      sb.push("\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n")
    } else if g.shrink && g.fl[g.cur] {
      // a block that runs without the frame: the stub makes it, so the
      // stubs' unwind rules are the frame's (shrink.xo)
      g.prologue(sb)
    }
    // the caller saved registers holding variables at the fault, stored
    // below sp before the moves take x0 to x7 (decision 0268's
    // addendum: a fault report shows them; the same code with and
    // without debug information)
    // not in a far frame (slots through x28). Where the fault can land
    // in this function, the landing pad resumes with sp as at the stub's
    // call, below the saves: the call site then lands on the pad's entry,
    // which first puts sp back at x29 less the frame record's offset
    // (pad_entry; 2026-10-21: half the stubs had pads and saved nothing,
    // so a fault in a function owning a list showed its locals in caller
    // saved registers <unavailable>)
    let saves = if g.base == 0 && g.pos >= 0 && (inst.pad < 0 || g.pad_entry_ok()) { g.stub_saves(g.pos / 4) } else { [] }
    var saved: List[(Int, Int)] = []
    if !saves.is_empty() {
      let bytes = 16 * ((saves.len() + 1) / 2)
      sb.push("\tsub sp, sp, #${bytes}\n")
      var i = 0
      while i < saves.len() {
        if i + 1 < saves.len() {
          sb.push("\tstp ${reg_name(saves[i], false)}, ${reg_name(saves[i + 1], false)}, [sp, #${8 * i}]\n")
          saved.push((saves[i + 1], 8 * i + 8))
        } else {
          sb.push("\tstr ${reg_name(saves[i], false)}, [sp, #${8 * i}]\n")
        }
        saved.push((saves[i], 8 * i))
        i += 2
      }
      g.stub_sp = bytes
    }
    var ms = g.call_moves(inst.fargs, "sp", 0)
    g.recover_operand(sb, inst, ms)
    g.parallel(sb, ms)
    let stub_bytes = g.stub_sp
    g.stub_sp = 0
    // the variables' places over the stub, to its call's return (the
    // faulting frame's pc in a traceback): its index, labels, and how sp
    // moved (decision 0268's locals, dwvars.xo dv_stub_expr)
    var dv_end = ""
    if g.m.debug_info && g.pos >= 0 {
      dv_end = g.local("${g.lbl_prefix()}_dvs${g.nstub}")
      let adj = if g.fr.leaf { 16 + stub_bytes } else if g.shrink && g.fl[g.cur] { -1 } else { stub_bytes }
      g.dv_stubs.push(DvStub{at: g.pos / 4, lo: l, hi: dv_end, adj: adj, saved: saved, slot: g.stubs.len()})
    }
    let after = if dv_end.is_empty() { "" } else { "${dv_end}:\n" }
    if inst.pad >= 0 {
      let (from2, to2) = g.call_site_labels()
      let pad = g.pad_of(inst.pad)
      let entry = if saved.is_empty() { "" } else { g.pad_entry(pad) }
      g.stub_sites.push(CallSite{from: from2, to: to2, pad: pad, entry: entry})
      sb.push("${from2}:\n\tbl ${inst.ffn}\n${to2}:\n${after}\tbrk #1\n")
    } else {
      sb.push("\tbl ${inst.ffn}\n${after}\tbrk #1\n")
    }
    g.stubs.push(sb.join(""))
  }
  for st in stores {
    b.push(st)
  }
}

// ---------------------------------------------------------------------------
// Parallel moves

fn same_loc(a: MLoc, b: MLoc) -> Bool {
  if a.reg >= 0 || b.reg >= 0 {
    return a.reg == b.reg
  }
  a.base == b.base && a.off == b.off
}

/// Emits moves that all read their sources before any writes its
/// destination: moves whose destination no other pending move reads go
/// first; a cycle is broken by saving one destination in a scratch
/// register. Moves from constants come last.
fn (g: G) parallel(var b: List[Str], moves: List[Move]) {
  var pending: List[Move] = []
  var consts: List[Move] = []
  for m in moves {
    if m.src.kind != M_LOC {
      consts.push(m)
      continue
    }
    if same_loc(m.dst, m.src.l) {
      continue
    }
    pending.push(m)
  }
  while !pending.is_empty() {
    var progress = false
    for (i, m) in pending.indexed() {
      var read = false
      for (j, o) in pending.indexed() {
        if j != i && same_loc(o.src.l, m.dst) {
          read = true
          break
        }
      }
      if !read {
        g.move(b, m.dst, m.src)
        pending = pending[0..i] + pending[i + 1..pending.len()]
        progress = true
        break
      }
    }
    if progress {
      continue
    }
    let m = pending[0]
    var tmp = MLoc{reg: SCRATCH0}
    if m.dst.reg >= FP_BASE {
      tmp = MLoc{reg: FSCRATCH}
    }
    g.move(b, tmp, MSrc{kind: M_LOC, l: m.dst})
    for j in 0..pending.len() {
      if same_loc(pending[j].src.l, m.dst) {
        pending[j].src.l = tmp
      }
    }
  }
  for m in consts {
    g.move(b, m.dst, m.src)
  }
}

/// Materializes sp + off in reg (two adds past 4095,
/// gotchas/arm64-add-immediate-range.md).
fn add_sp(var b: List[Str], reg: Str, off: Int) {
  if off <= 4095 {
    b.push("\tadd ${reg}, sp, #${off}\n")
    return
  }
  b.push("\tadd ${reg}, sp, #${off >> 12}, lsl #12\n")
  let lo = off & 4095
  if lo != 0 {
    b.push("\tadd ${reg}, ${reg}, #${lo}\n")
  }
}

/// reg = base + off as text (add_sp's two adds past 4095, a sub for a
/// negative offset), for q_mem's far slots.
fn add_text(reg: Str, base: Str, off: Int) -> Str {
  let op = if off < 0 { "sub" } else { "add" }
  let n = if off < 0 { 0 - off } else { off }
  if n <= 4095 {
    return "\t${op} ${reg}, ${base}, #${n}\n"
  }
  let lo = n & 4095
  "\t${op} ${reg}, ${base}, #${n >> 12}, lsl #12\n${if lo != 0 { "\t${op} ${reg}, ${reg}, #${lo}\n" } else { "" }}"
}

fn mem_ref(l: MLoc) -> Str {
  "[${l.base}, #${l.off}]"
}

/// A 128 bit load or store (op "ldr" or "str") of V register r at l
/// (decision 0323): the scaled form when the offset is a multiple of 16,
/// the unscaled one within its range, else through x17.
fn q_mem(op: Str, r: Int, l: MLoc) -> Str {
  let q = vreg_name(r, true)
  if l.off % 16 == 0 && l.off >= 0 && l.off < 65536 {
    return "\t${op} ${q}, [${l.base}, #${l.off}]\n"
  }
  if l.off >= -256 && l.off < 256 {
    return "\t${if op == "ldr" { "ldur" } else { "stur" }} ${q}, [${l.base}, #${l.off}]\n"
  }
  "${add_text("x17", l.base, l.off)}\t${op} ${q}, [x17]\n"
}

/// Puts a source that is not a location in register r (move's put).
fn (g: G) put(var b: List[Str], r: Int, src: MSrc) {
  if src.kind == M_ZERO {
    if r >= FP_BASE {
      b.push("\tfmov ${reg_name(r, false)}, xzr\n")
    } else {
      b.push("\tmov ${reg_name(r, false)}, xzr\n")
    }
  } else if src.kind == M_IMM {
    if r >= FP_BASE {
      b.push(imm_text(src.imm, "x17"))
      b.push("\tfmov ${reg_name(r, false)}, x17\n")
      return
    }
    b.push(imm_text(src.imm, reg_name(r, false)))
  } else if src.kind == M_SYM {
    b.push(g.addr(reg_name(r, false), src.sym))
  } else if src.kind == M_FRAME {
    add_sp(b, reg_name(r, false), g.fr.out_off)
  } else if src.kind == M_MEM {
    add_sp(b, reg_name(r, false), g.fr.mem_off + src.imm)
  }
}

fn (g: G) move(var b: List[Str], dst: MLoc, src: MSrc) {
  if src.kind != M_LOC {
    if dst.reg >= 0 {
      g.put(b, dst.reg, src)
      return
    }
    if src.kind == M_ZERO {
      b.push("\tstr xzr, ${mem_ref(dst)}\n")
      return
    }
    g.put(b, SCRATCH1, src)
    b.push("\tstr x17, ${mem_ref(dst)}\n")
    return
  }
  let sl = src.l
  if dst.wide || sl.wide {
    // decision 0323: a wide value, 128 bits (q30 between two slots)
    if dst.reg >= 0 && sl.reg >= 0 {
      b.push("\tmov ${vreg_name(dst.reg, false)}.16b, ${vreg_name(sl.reg, false)}.16b\n")
    } else if dst.reg >= 0 {
      b.push(q_mem("ldr", dst.reg, sl))
    } else if sl.reg >= 0 {
      b.push(q_mem("str", sl.reg, dst))
    } else {
      b.push(q_mem("ldr", FP_BASE + 30, sl))
      b.push(q_mem("str", FP_BASE + 30, dst))
    }
    return
  }
  if dst.reg >= 0 && sl.reg >= 0 {
    let dfp = dst.reg >= FP_BASE
    let sfp = sl.reg >= FP_BASE
    if !dfp && !sfp {
      b.push("\tmov ${reg_name(dst.reg, false)}, ${reg_name(sl.reg, false)}\n")
    } else {
      b.push("\tfmov ${reg_name(dst.reg, false)}, ${reg_name(sl.reg, false)}\n")
    }
  } else if dst.reg >= 0 {
    b.push("\tldr ${reg_name(dst.reg, false)}, ${mem_ref(sl)}\n")
  } else if sl.reg >= 0 {
    b.push("\tstr ${reg_name(sl.reg, false)}, ${mem_ref(dst)}\n")
  } else {
    b.push("\tldr x17, ${mem_ref(sl)}\n\tstr x17, ${mem_ref(dst)}\n")
  }
}

/// Recomputes, in a fault stub, an operand of a checked add, sub, or neg
/// whose register the result took, and points its move at the
/// recomputed value: in a caller saved register no argument of the fault
/// call is in (the call clobbers every caller saved register, so none
/// holds a value past it; x15 until it was allocated, 2026-10-16).
fn (g: G) recover_operand(var b: List[Str], inst: Inst, var ms: List[Move]) {
  if inst.recover.is_empty() {
    return
  }
  let (dl, ok) = g.vloc(inst.defs[0])
  if !ok || dl.reg < 0 {
    return
  }
  let d = reg_name(dl.reg, false)
  let args = inst.fargs
  var used: List[Int] = [dl.reg]
  for a in args {
    if a.kind == S_REG && a.v != 0 {
      let (al, _) = g.vloc(a.v)
      used.push(al.reg)
    }
  }
  var tmp = 15
  for r in [15, 14, 13, 12, 11, 10, 9] {
    if !used.contains(r) {
      tmp = r
      break
    }
  }
  let t = reg_name(tmp, false)
  for k in [0, 2] {
    if !g.clobbered(args, k, dl.reg) {
      continue
    }
    if inst.recover == "neg" {
      b.push("\tneg ${t}, ${d}\n")
    } else if inst.recover == "add" {
      let o = g.other_reg(b, args, 2 - k)
      b.push("\tsub ${t}, ${d}, ${o}\n")
    } else if inst.recover == "sub" && k == 0 {
      let o = g.other_reg(b, args, 2)
      b.push("\tadd ${t}, ${d}, ${o}\n")
    } else if inst.recover == "sub" {
      let o = g.other_reg(b, args, 0)
      b.push("\tsub ${t}, ${o}, ${d}\n")
    }
    ms[k].src = MSrc{kind: M_LOC, l: MLoc{reg: tmp}}
  }
}

/// Whether fault argument k is in register r.
fn (g: G) clobbered(args: List[Src], k: Int, r: Int) -> Bool {
  if k >= args.len() || args[k].kind != S_REG || args[k].v == 0 {
    return false
  }
  let (l, _) = g.vloc(args[k].v)
  l.reg == r
}

/// Puts fault argument k in a register.
fn (g: G) other_reg(var b: List[Str], args: List[Src], k: Int) -> Str {
  let a = args[k]
  if a.kind == S_IMM {
    b.push(imm_text(a.imm, "x17"))
    return "x17"
  }
  let (l, _) = g.vloc(a.v)
  if l.reg >= 0 {
    return reg_name(l.reg, false)
  }
  b.push("\tldr x17, ${mem_ref(l)}\n")
  "x17"
}

/// The landing pad block of an instruction, past the blocks that only
/// jump (thread may have dropped them).
fn (g: G) pad_of(pad: Int) -> Int {
  var b = pad
  for _ in 0..16 {
    let ins = g.blocks[b].insts
    if ins.len() != 1 || ins[0].kind != K_JUMP || ins[0].targets[0] == b || ins[0].targets.len() > 1 {
      return b
    }
    b = ins[0].targets[0]
  }
  b
}

/// Whether a fault stub with a landing pad may save registers below sp
/// (pad_entry): a frame with its record, sp x29 less a fixed offset in
/// the body (not a leaf, whose stubs make the record; not a block that
/// runs without the frame, shrink.xo).
fn (g: G) pad_entry_ok() -> Bool {
  !g.fr.leaf && !(g.shrink && g.fl[g.cur]) && g.fr.rec <= 4095
}

/// The entry of landing pad block pad for the call sites of fault stubs
/// that saved registers: it puts sp back where the body keeps it (x29
/// less the frame record's offset, prologue) and jumps to the pad. One
/// per pad, among the stubs.
fn (var g: G) pad_entry(pad: Int) -> Str {
  if let Some(l) = g.pad_entries.get(pad) {
    return l
  }
  let l = g.local("${g.lbl_prefix()}_pe${pad}")
  let set = if g.fr.rec == 0 { "\tmov sp, x29\n" } else { "\tsub sp, x29, #${g.fr.rec}\n" }
  g.stubs.push("${l}:\n${set}\tb ${g.label(g.fwd(pad))}\n")
  g.pad_entries[pad] = l
  l
}

/// The labels around the `bl` of a call that unwinds to a landing pad
/// (decision 0085).
fn (var g: G) call_site_labels() -> (Str, Str) {
  g.ncs += 1
  let n = g.ncs
  (g.local("${g.lbl_prefix()}_cs${n}a"), g.local("${g.lbl_prefix()}_cs${n}b"))
}

/// Opens the unwind information of the function (decision 0085): its
/// call frame information, and with landing pads the personality routine
/// and the call site table.
fn (var g: G) cfi_start(var b: List[Str], pads: Bool) {
  b.push("${g.func_begin()}:\n")
  b.push("\t.cfi_startproc\n")
  if !pads {
    return
  }
  if g.os == "darwin" {
    b.push("\t.cfi_personality 155, ${g.sym(personality_name(g.os))}\n\t.cfi_lsda 16, ${g.lsda_label()}\n")
  } else {
    g.personality_ref = true
    b.push("\t.cfi_personality 155, DW.ref.${personality_name(g.os)}\n\t.cfi_lsda 27, ${g.lsda_label()}\n")
  }
}

/// The personality routine the unwind tables name on os (decision 0221):
/// the runtime's export xo_x_personality (std/native/llrt/cabi.xo; on
/// Windows the language handler, which passes every system exception
/// on, decision 0197).
pub fn personality_name(os: Str) -> Str { "xo_x_personality" }

fn (g: G) func_begin() -> Str {
  g.local("${g.lbl_prefix()}_begin")
}

/// The prefix of the function's labels: its namespace and number, or in
/// a part's canonical text (fcache.xo) a token put in place when the
/// function's text is placed.
fn (g: G) lbl_prefix() -> Str {
  if g.canon {
    return FP_TOKEN
  }
  "${g.ns}f${g.nfunc}"
}

/// The function's call site table (`.cfi_lsda`): an assembler-local label
/// on every object format, so a binary's symbol table has no LSDA names
/// (nothing looks them up: the unwinder takes the pointer from the FDE,
/// and std/native/llrt's prof reads __text symbols only). Darwin named it
/// a symbol until 2026-10-25: 67 of hello's 856 symbols and 559 of CRUD's
/// 2,971, 3.1 KB and 25.8 KB of the files.
fn (g: G) lsda_label() -> Str {
  g.local("${g.lbl_prefix()}_lsda")
}

/// Describes the frame the prologue made.
fn (g: G) cfi_frame(var b: List[Str]) {
  let fr = g.fr
  if fr.leaf {
    return
  }
  b.push("\t.cfi_def_cfa w29, ${fr.size - fr.rec}\n")
  if fr.size - fr.rec == 16 {
    b.push("\t.cfi_offset w30, ${fr.rec + 8 - fr.size}\n\t.cfi_offset w29, ${fr.rec - fr.size}\n")
  } else {
    // the frame record is not at the top of the frame
    // (gotchas/arm64-compact-unwind-cfa.md)
    b.push("\t.cfi_offset w29, ${fr.rec - fr.size}\n\t.cfi_offset w30, ${fr.rec + 8 - fr.size}\n")
  }
  // as saves() stores them: a pair puts the higher register first
  var k = 0
  let n = g.saved.len()
  while k < n {
    let r = g.saved[k]
    let off = fr.save_base + 8 * k
    if k + 1 < n && (g.saved[k + 1] >= FP_BASE) == (r >= FP_BASE) && off <= 496 {
      b.push(cfi_at(g.saved[k + 1], off - fr.size))
      b.push(cfi_at(r, off + 8 - fr.size))
      k += 2
      continue
    }
    b.push(cfi_at(r, off - fr.size))
    k += 1
  }
}

fn cfi_at(r: Int, off: Int) -> Str {
  var name = reg_name(r, false)
  if r < FP_BASE {
    name = "w${name[1..name.len()]}"
  }
  "\t.cfi_offset ${name}, ${off}\n"
}

/// Emits the call site table of the function (GCC's format for cleanups,
/// decision 0085).
fn (var g: G) lsda(sites: List[CallSite]) {
  var b: List[Str] = []
  if g.os == "darwin" {
    b.push("\t.section __TEXT,__gcc_except_tab\n")
  } else {
    b.push("\t.section .gcc_except_table,\"a\",@progbits\n")
  }
  let fb = g.func_begin()
  let beg = g.local("${g.lbl_prefix()}_cst")
  let end = g.local("${g.lbl_prefix()}_cste")
  b.push("\t.p2align 2\n${g.lsda_label()}:\n\t.byte 255\n\t.byte 255\n\t.byte 1\n\t.uleb128 ${end}-${beg}\n${beg}:\n")
  for c in sites {
    let pad = if c.entry.is_empty() { g.label(g.fwd(c.pad)) } else { c.entry }
    b.push("\t.uleb128 ${c.from}-${fb}\n\t.uleb128 ${c.to}-${c.from}\n\t.uleb128 ${pad}-${fb}\n\t.byte 0\n")
  }
  b.push("${end}:\n")
  g.lsdas.push(b.join(""))
}

/// Follows blocks that do nothing but jump (their parallel moves are all
/// between the same locations after allocation).
fn (g: G) fwd(b0: Int) -> Int {
  var b = b0
  for _ in 0..8 {
    if g.edge_block(b) {
      // it makes or undoes the frame (shrink.xo)
      return b
    }
    let ins = g.blocks[b].insts
    let n = ins.len()
    if n == 0 || ins[n - 1].kind != K_JUMP || ins[n - 1].targets[0] == b || ins[n - 1].targets.len() > 1 {
      return b
    }
    for k in 0..n - 1 {
      let inst = ins[k]
      if inst.kind != K_PMOVE {
        return b
      }
      for (j, d) in inst.defs.indexed() {
        let (dl, ok) = g.vloc(d)
        let src = g.msrc_of(inst.srcs[j])
        if ok && !(src.kind == M_LOC && same_loc(dl, src.l)) {
          return b
        }
      }
    }
    b = ins[n - 1].targets[0]
  }
  b
}
