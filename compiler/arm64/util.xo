// Numbers and text the emitter prints (Go's strconv and fmt as the Go
// emitter uses them), and the bits of Float constants.

use github.com/xo-lang/xo/compiler/ssa

const MAX_INT = 9223372036854775807
const MIN_INT = -9223372036854775807 - 1

const HEX = "0123456789abcdef"

/// n in two lowercase hex digits (0 <= n < 256), as `%02x`.
fn hex2(n: Int) -> Str {
  "${HEX[n / 16..n / 16 + 1]}${HEX[n % 16..n % 16 + 1]}"
}

/// n (0 <= n < 512) in three octal digits.
fn oct3(n: Int) -> Str {
  "${n / 64}${n / 8 % 8}${n % 8}"
}

fn imin(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

fn imax(a: Int, b: Int) -> Int {
  if a > b { a } else { b }
}

/// 2^k (0 <= k <= 62).
fn pow2i(k: Int) -> Int {
  var n = 1
  for _ in 0..k {
    n = n * 2
  }
  n
}

/// The bits of x (ssa.float_bits).
fn float_bits(x: Float) -> Int {
  ssa.float_bits(x)
}

/// The bits of -0.0 normalized to those of 0.0 (the memo's key: Go's
/// map compares Float keys with ==).
fn float_key(x: Float) -> Int {
  if x == 0.0 {
    return 0
  }
  float_bits(x)
}

/// The 16 bit chunk k of n (0..3).
fn chunk(n: Int, k: Int) -> Int {
  (n >> (16 * k)) & 0xffff
}

/// The template that puts n in $d0 (movImm).
fn mov_imm(n: Int) -> Str {
  if n >= -65536 && n < 65536 {
    return "mov $d0, #${n}"
  }
  // one orr of a logical immediate (the assembler's mov picks it), as
  // LLVM: -2^32, P-256's limb, was a movn and a movk (2026-10-17)
  if ones_run(n) {
    return "mov $d0, #${n}"
  }
  // one 32 bit movn, its result zero extended: 2^32 - 2 was a mov and a
  // movk
  if n > 0 && n <= 0xffffffff && single_chunk(~n & 0xffffffff) {
    return "mov $wd0, #${n}"
  }
  var lines: List[Str] = []
  let inv = ~n
  // prefer movn when most chunks are all ones
  var ones = 0
  for k in 0..4 {
    if chunk(n, k) == 0xffff {
      ones += 1
    }
  }
  if ones >= 2 {
    var first = true
    for k in 0..4 {
      let c = chunk(inv, k)
      if first && c != 0 {
        lines.push("movn $d0, #${c}, lsl #${16 * k}")
        first = false
      }
    }
    if first {
      return "mov $d0, #-1"
    }
    for k in 0..4 {
      let c = chunk(n, k)
      let ci = chunk(inv, k)
      if c != 0xffff && !lines[0].contains("#${ci}, lsl #${16 * k}") {
        lines.push("movk $d0, #${c}, lsl #${16 * k}")
      }
    }
    return lines.join("\n")
  }
  var first = true
  for k in 0..4 {
    let c = chunk(n, k)
    if c == 0 {
      continue
    }
    if first {
      lines.push("movz $d0, #${c}, lsl #${16 * k}")
      first = false
    } else {
      lines.push("movk $d0, #${c}, lsl #${16 * k}")
    }
  }
  if first {
    return "mov $d0, #0"
  }
  lines.join("\n")
}

/// Whether at most one 16 bit chunk of n is not zero.
fn single_chunk(n: Int) -> Bool {
  var nz = 0
  for k in 0..4 {
    if chunk(n, k) != 0 {
      nz += 1
    }
  }
  nz <= 1
}

/// The assembly that puts n in register r, an x register (immText).
fn imm_text(n: Int, r: Str) -> Str {
  let w = "w" + r.trim_prefix("x")
  "\t${mov_imm(n).replace("\n", "\n\t").replace("$wd0", w).replace("$d0", r)}\n"
}

/// Whether n fits an unsigned 12 bit immediate.
fn imm12(n: Int) -> Bool {
  n >= 0 && n < 4096
}

/// Whether off is the scaled unsigned immediate of a load or store of w
/// bytes (1, 2, 4, or 8): a multiple of w below 4096 * w (rawImmOff).
fn raw_imm_off(off: Int, w: Int) -> Bool {
  w > 0 && off >= 0 && off % w == 0 && off / w < 4096
}

fn align16(n: Int) -> Int {
  (n + 15) & ~15
}

/// The multiplier M (as an Int's bits) and the shift s of a signed
/// division by d (3 <= d < 2^63, not a power of two), as internal/arm64
/// sdivMagic (Hacker's Delight 10-1): the least p >= 64 with e * anc <
/// 2^p, M = ceil(2^p / d), e = M * d - 2^p, anc the largest Int with anc
/// mod d == d - 1; s = p - 64. Only M wraps (wrapping_add).
fn sdiv_magic(d: Int) -> (Int, Int) {
  let t = (MAX_INT % d + 1) % d // 2^63 mod d
  let anc = MAX_INT - t         // 2^62 <= anc < 2^63
  // q1, r1: 2^p / anc and 2^p mod anc, from p = 63; big once q1 >= 2^63
  var q1 = 1
  var r1 = MAX_INT - anc + 1
  if anc == 4611686018427387904 {
    q1 = 2
    r1 = 0
  }
  var big = false
  // q2, r2: 2^p / d (mod 2^64) and 2^p mod d, from p = 0
  var q2 = 0
  var r2 = 1
  var p = 0
  while true {
    p += 1
    q2 = q2.wrapping_add(q2)
    if r2 >= d - r2 {
      r2 -= d - r2
      q2 = q2 | 1
    } else {
      r2 += r2
    }
    if p < 64 {
      continue
    }
    if !big {
      if q1 >= 4611686018427387904 {
        big = true
      } else {
        q1 += q1
        if r1 >= anc - r1 {
          r1 -= anc - r1
          q1 += 1
        } else {
          r1 += r1
        }
      }
    }
    // e * anc < 2^p = q1 * anc + r1
    let e = d - r2
    if big || e < q1 || (e == q1 && r1 > 0) {
      return (q2.wrapping_add(1), p - 64)
    }
  }
  (0, 0)
}

/// k when n is 2^k, k >= 1 (pow2c).
fn pow2c(n: Int) -> (Int, Bool) {
  if n < 2 || n & (n - 1) != 0 {
    return (0, false)
  }
  var k = 0
  var p = 1
  while p != n {
    p = p * 2
    k += 1
  }
  (k, true)
}

/// The decimal integer s (an optional `-` and digits), or None.
fn parse_int(s: Str) -> Int? {
  Int.parse(s)
}

/// The condition with the opposite outcome (invCond), or "".
fn inv_cond(c: Str) -> Str {
  match c {
    "eq" => "ne"
    "ne" => "eq"
    "lt" => "ge"
    "ge" => "lt"
    "gt" => "le"
    "le" => "gt"
    "lo" => "hs"
    "hs" => "lo"
    "hi" => "ls"
    "ls" => "hi"
    "mi" => "pl"
    "pl" => "mi"
    "vs" => "vc"
    "vc" => "vs"
    _ => ""
  }
}

/// The condition after swapping a compare's operands (swapCond).
fn swap_cond(c: Str) -> Str {
  match c {
    "lt" => "gt"
    "gt" => "lt"
    "le" => "ge"
    "ge" => "le"
    "lo" => "hi"
    "hi" => "lo"
    "ls" => "hs"
    "hs" => "ls"
    _ => c
  }
}

/// s escaped for an .ascii directive (asmBytes).
fn asm_bytes(s: Bytes) -> Str {
  var b = StrBuilder.new()
  var i = 0
  let n = s.len()
  while i < n {
    let c = Int(s[i])
    if c == 34 || c == 92 {
      b.write(if c == 34 { "\\\"" } else { "\\\\" })
    } else if c >= 32 && c < 127 {
      var j = i
      while j < n && Int(s[j]) >= 32 && Int(s[j]) < 127 && Int(s[j]) != 34 && Int(s[j]) != 92 {
        j += 1
      }
      b.write(s[i..j].to_str() ?? "")
      i = j
      continue
    } else {
      b.write("\\${oct3(c)}")
    }
    i += 1
  }
  b.freeze()
}
