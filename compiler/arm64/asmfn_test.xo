// func_sections (asmfn.xo): xo asm --fn's filter.

test "func_sections keeps the named functions and drops data and others" {
  let asm = [
    "// generated by xo build --backend=arm64",
    "\t.section __TEXT,__text,regular,pure_instructions",
    "// func main",
    "_xo_f_main:",
    "\tbl _xo_f_sq",
    "\tret",
    "// func sq",
    "\t.globl _xo_f_sq",
    "_xo_f_sq:",
    "\tmul x0, x0, x0",
    "\tret",
    "\t.section __TEXT,__gcc_except_tab",
    "lf2_lsda:",
    "\t.byte 255",
    "// generated by xo build --backend=arm64",
    "\t.section __TEXT,__text,regular,pure_instructions",
    "// func flate.InStream.push",
    "_xo_f_flate_2eInStream_2epush:",
    "\tret",
    "",
  ].join("\n")
  expect(func_sections(asm, ["sq"])) == "// func sq\n\t.globl _xo_f_sq\n_xo_f_sq:\n\tmul x0, x0, x0\n\tret\n"
  expect(func_sections(asm, ["InStream.push"])) == "// func flate.InStream.push\n_xo_f_flate_2eInStream_2epush:\n\tret\n"
  expect(func_sections(asm, ["main", "sq"]).lines().len()) == 9
  expect(func_sections(asm, ["gone"])) == "== no function matches gone\n"
}
