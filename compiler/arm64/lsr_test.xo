// Tests of the text passes (reload_reuse).

test "reload_reuse: a reload of a slot x16 holds goes" {
  let t = "Lf_b0:\n\tstr x0, [sp, #984]\n\tldr x16, [sp, #984]\n\tldr x9, [x16]\n\ttbz x9, #63, Lf_b2\n\tb Lf_b1\nLf_b2:\n\tadd x9, x9, #1\n\tldr x16, [sp, #984]\n\tstr x9, [x16]\nLf_b1:\n\tret"
  expect(reload_reuse(t, "")) == "Lf_b0:\n\tstr x0, [sp, #984]\n\tldr x16, [sp, #984]\n\tldr x9, [x16]\n\ttbz x9, #63, Lf_b2\n\tb Lf_b1\nLf_b2:\n\tadd x9, x9, #1\n\tstr x9, [x16]\nLf_b1:\n\tret"
}

test "reload_reuse: a label reached later forgets" {
  let t = "\tldr x16, [sp, #8]\nLf_b1:\n\tldr x16, [sp, #8]\n\tcbz x0, Lf_b1\n\tret"
  expect(reload_reuse(t, "")) == t
}

test "reload_reuse: a call, a write of x16, another store forget" {
  let t = "\tldr x16, [sp, #8]\n\tbl _f\n\tldr x16, [sp, #8]\n\tadd x16, x16, #1\n\tldr x16, [sp, #8]\n\tstr x3, [sp, #8]\n\tldr x16, [sp, #8]\n\tldr x16, [sp, #8]"
  expect(reload_reuse(t, "")) == "\tldr x16, [sp, #8]\n\tbl _f\n\tldr x16, [sp, #8]\n\tadd x16, x16, #1\n\tldr x16, [sp, #8]\n\tstr x3, [sp, #8]\n\tldr x16, [sp, #8]"
}

test "reload_reuse: ELF labels (.L) are labels: a loop head reached later forgets" {
  let t = "\tldr x16, [sp, #8]\n.Lf_b1:\n\tldr x16, [sp, #8]\n\tcbz x0, .Lf_b1\n\tret"
  expect(reload_reuse(t, "")) == t
  let u = ".Lf_b0:\n\tstr x0, [sp, #984]\n\tldr x16, [sp, #984]\n\tldr x9, [x16]\n\ttbz x9, #63, .Lf_b2\n\tb .Lf_b1\n.Lf_b2:\n\tadd x9, x9, #1\n\tldr x16, [sp, #984]\n\tstr x9, [x16]\n.Lf_b1:\n\tret"
  expect(reload_reuse(u, "")) == ".Lf_b0:\n\tstr x0, [sp, #984]\n\tldr x16, [sp, #984]\n\tldr x9, [x16]\n\ttbz x9, #63, .Lf_b2\n\tb .Lf_b1\n.Lf_b2:\n\tadd x9, x9, #1\n\tstr x9, [x16]\n.Lf_b1:\n\tret"
}

test "reload_reuse: a debug row or variable label keeps what the registers hold" {
  let t = "\tldr x16, [sp, #8]\n.Lf_dl3:\n\tldr x16, [sp, #8]\nLf_dv4:\n\tldr x16, [sp, #8]\n\tret"
  expect(reload_reuse(t, "\t.xword .Lf_dl3\n\t.xword Lf_dv4")) == "\tldr x16, [sp, #8]\n.Lf_dl3:\nLf_dv4:\n\tret"
}

test "pair_mem: pairs across debug labels the debug sections refer to, ELF and Mach-O" {
  let t = "\tldr x10, [x11, #0]\n.Lf_dv8:\n\tldr x13, [x11, #8]\n\tstr x10, [x9, #0]\nLf_dl2:\n\tstr x13, [x9, #8]\n\tret"
  expect(pair_mem(t, "\t.xword .Lf_dv8\n\t.xword Lf_dl2")) == ".Lf_dv8:\n\tldp x10, x13, [x11, #0]\nLf_dl2:\n\tstp x10, x13, [x9, #0]\n\tret"
}

test "pair_mem: a branch target between two loads ends the pair (ELF)" {
  let t = "\tldr x10, [x11, #0]\n.Lf_b3:\n\tldr x13, [x11, #8]\n\tcbz x0, .Lf_b3\n\tret"
  expect(pair_mem(t, "")) == t
}

test "pair_mem: d registers pair like x registers; an x and a d do not" {
  let t = "\tldr d16, [x9, #24]\n\tldr d17, [x9, #32]\n\tstr d22, [x9, #48]\n\tstr d23, [x9, #56]\n\tret"
  expect(pair_mem(t, "")) == "\tldp d16, d17, [x9, #24]\n\tstp d22, d23, [x9, #48]\n\tret"
  let u = "\tldr x10, [x9, #24]\n\tldr d17, [x9, #32]\n\tstr d22, [x9, #48]\n\tstr x11, [x9, #56]\n\tret"
  expect(pair_mem(u, "")) == u
}

test "copy_runs: four or more word copies go 32 bytes at a time through v30 and v31" {
  var t = ""
  var u = ""
  for w in 0..5 {
    t = t + "\tldr x16, [sp, #${4000 + 8 * w}]\n\tstr x16, [x20, #${16 + 8 * w}]\n"
  }
  expect(copy_runs(t + "\tret")) == "\tadd x16, sp, #4000\n\tadd x17, x20, #16\n\tldp q30, q31, [x16, #0]\n\tstp q30, q31, [x17, #0]\n\tldr d30, [x16, #32]\n\tstr d30, [x17, #32]\n\tret"
  for w in 0..3 {
    u = u + "\tldr x16, [sp, #${8 * w}]\n\tstr x16, [x20, #${8 * w}]\n"
  }
  expect(copy_runs(u + "\tret")) == u + "\tret" // three: no fewer
}

test "copy_runs: two bases not sp, or overlapping sp ranges, stay" {
  var t = ""
  var u = ""
  for w in 0..6 {
    t = t + "\tldr x16, [x9, #${8 * w}]\n\tstr x16, [x20, #${8 * w}]\n"
    u = u + "\tldr x16, [sp, #${8 * w}]\n\tstr x16, [sp, #${16 + 8 * w}]\n"
  }
  expect(copy_runs(t + "\tret")) == t + "\tret"
  expect(copy_runs(u + "\tret")) == u + "\tret"
}

test "copy_runs: past 128 words the bases move on 1024 bytes; a large offset takes two adds" {
  var t = ""
  for w in 0..130 {
    t = t + "\tldr x16, [x17, #${8 * w}]\n\tstr x16, [sp, #${5000 + 8 * w}]\n"
  }
  let r = copy_runs(t)
  expect(r.starts_with("\tmov x16, x17\n\tadd x17, sp, #1, lsl #12\n\tadd x17, x17, #904\n\tldp q30, q31, [x16, #0]\n")) == true
  expect(r.contains("\tstp q30, q31, [x17, #992]\n\tadd x16, x16, #1024\n\tadd x17, x17, #1024\n\tldr q30, [x16, #0]\n\tstr q30, [x17, #0]")) == true
}

test "copy_runs: debug rows among the copies go before them" {
  var t = ""
  for w in 0..4 {
    t = t + "\tldr x16, [sp, #${8 * w}]\nLf_dl${w}:\n\tstr x16, [x20, #${8 * w}]\n"
  }
  expect(copy_runs(t + "\tret")) == "Lf_dl0:\nLf_dl1:\nLf_dl2:\nLf_dl3:\n\tmov x16, sp\n\tmov x17, x20\n\tldp q30, q31, [x16, #0]\n\tstp q30, q31, [x17, #0]\n\tret"
}

test "copy_runs: stays when x16 or x17 is read after the run" {
  var t = ""
  var u = ""
  for w in 0..4 {
    t = t + "\tldr x16, [sp, #${8 * w}]\n\tstr x16, [x17, #${8 * w}]\n"
    u = u + "\tldr x17, [sp, #${8 * w}]\n\tstr x17, [sp, #${64 + 8 * w}]\n"
  }
  let a = t + "\tstr x3, [x17, #32]\n\tret"
  expect(copy_runs(a)) == a
  let b = u + "\tblr x16\n\tret"
  expect(copy_runs(b)) == b
  let c = u + "1:\n\tbl _f"
  expect(copy_runs(c)) == c
}

test "copy_runs: a call's stack arguments through x17" {
  var u = ""
  for w in 0..4 {
    u = u + "\tldr x17, [sp, #${96 + 8 * w}]\n\tstr x17, [sp, #${8 * w}]\n"
  }
  expect(copy_runs(u + "\tldr x16, [x9]\n\tblr x16")) == "\tadd x16, sp, #96\n\tmov x17, sp\n\tldp q30, q31, [x16, #0]\n\tstp q30, q31, [x17, #0]\n\tldr x16, [x9]\n\tblr x16"
  expect(copy_runs(u + "\tbl _f")) == "\tadd x16, sp, #96\n\tmov x17, sp\n\tldp q30, q31, [x16, #0]\n\tstp q30, q31, [x17, #0]\n\tbl _f"
}

test "x86_copy_runs: pushq and popq word copies go 16 bytes at a time through xmm15" {
  let t = "\tpushq 16(%rsp)\n\tpopq 64(%rsp)\n\tpushq 24(%rsp)\n\tpopq 72(%rsp)\n\tpushq 32(%rsp)\n\tpopq 80(%rsp)\n\tretq"
  expect(x86_copy_runs(t)) == "\tmovdqu 16(%rsp), %xmm15\n\tmovdqu %xmm15, 64(%rsp)\n\tpushq 32(%rsp)\n\tpopq 80(%rsp)\n\tretq"
}

test "x86_copy_runs: overlapping ranges, two other bases, and a later read of r11 stay" {
  let a = "\tpushq 16(%rsp)\n\tpopq 24(%rsp)\n\tpushq 24(%rsp)\n\tpopq 32(%rsp)\n\tretq"
  expect(x86_copy_runs(a)) == a
  let b = "\tmovq 8(%rbx), %r11\n\tmovq %r11, 16(%r12)\n\tmovq 16(%rbx), %r11\n\tmovq %r11, 24(%r12)\n\tretq"
  expect(x86_copy_runs(b)) == b
  let c = "\tmovq 8(%rbx), %r11\n\tmovq %r11, 16(%rsp)\n\tmovq 16(%rbx), %r11\n\tmovq %r11, 24(%rsp)\n\taddq %r11, %rax\n\tretq"
  expect(x86_copy_runs(c)) == c
  let d = "\tmovq 8(%rbx), %r11\n\tmovq %r11, 16(%rsp)\n\tmovq 16(%rbx), %r11\n\tmovq %r11, 24(%rsp)\n\tmovq $1, %r11\n\tretq"
  expect(x86_copy_runs(d)) == "\tmovdqu 8(%rbx), %xmm15\n\tmovdqu %xmm15, 16(%rsp)\n\tmovq $1, %r11\n\tretq"
}
