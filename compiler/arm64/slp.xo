// slp_f64 (decision 0323, stage 2): pairs of independent, isomorphic
// Float operations become one 128 bit NEON operation, along the hot
// chains of the MIR (extended basic blocks: each block the only
// successor of the last on the hot path, the other exits cold). Each
// lane of a `.2d` instruction rounds exactly as the scalar instruction
// does (decision 0287: no fusion, no reassociation), so the results are
// the scalar code's bit for bit.
//
// Seeds are pairs of Float loads from one base at offsets k and k + 8;
// a pack grows through pairs of the same fadd, fsub, fmul, fdiv (or
// fsqrt) whose operands are packs, the same scalar in both lanes, or two
// scalars built into a pack; a pair of stores of a pack's lanes to k and
// k + 8 becomes one store, and fadd of a pack's two lanes a faddp. A
// chain's packs are made only when they save instructions after the
// extracts (a lane read elsewhere) and the builds (two scalars into a
// pack). A load pack is placed at the earlier load (the only stores
// between are to the same base at other offsets), an operation or a
// store pack at its later member, a lane's extract right after its
// pack, and every other read of a lane must come after that in the
// chain.

/// One instruction's place: block, index in it, and its order in the
/// chain (-1 outside).
struct SPos {
  b: Int
  i: Int
  ord: Int
}

/// A pack: lane 0 and lane 1 (scalar vregs), how it is made ("load",
/// "op", "build"), its members' positions (for "op" and "load"), the
/// vector text, the operands (wide or scalar vregs, filled when made),
/// and its wide vreg.
struct SPack {
  l0: Int
  l1: Int
  how: Str
  m0: SPos = SPos{b: -1, i: -1, ord: -1}
  m1: SPos = SPos{b: -1, i: -1, ord: -1}
  op: Str = ""
  // operand packs (index into the pack list) or -1, and a scalar used
  // by both lanes (-1 for none), by operand position
  args: List[Int] = []
  same: List[Int] = []
  off: Int = 0
  base: Int = 0
  wide: Int = -1
}

/// A Float load `ldr $d0, [$u0, #k]`: (k, base, def), or None.
fn (g: G) slp_load(x: Inst) -> Option[(Int, Int, Int)] {
  if x.kind != K_PLAIN || x.defs.len() != 1 || x.us.len() != 1 || x.has(IF_HAS_FAULT) || !x.clobbers.is_empty() {
    return None
  }
  if !x.text.starts_with("ldr $d0, [$u0, #") || !x.text.ends_with("]") || !g.fp[x.defs[0]] || g.wide.contains(x.defs[0]) {
    return None
  }
  if let Some(k) = Int.parse(x.text["ldr $d0, [$u0, #".len()..x.text.len() - 1]) {
    return Some((k, x.us[0], x.defs[0]))
  }
  None
}

/// A Float store `str $u0, [$u1, #k]`: (k, base, value), or None.
fn (g: G) slp_store(x: Inst) -> Option[(Int, Int, Int)] {
  if x.kind != K_PLAIN || !x.defs.is_empty() || x.us.len() != 2 || x.has(IF_HAS_FAULT) || !x.clobbers.is_empty() {
    return None
  }
  if !x.text.starts_with("str $u0, [$u1, #") || !x.text.ends_with("]") || !g.fp[x.us[0]] || g.wide.contains(x.us[0]) {
    return None
  }
  if let Some(k) = Int.parse(x.text["str $u0, [$u1, #".len()..x.text.len() - 1]) {
    return Some((k, x.us[1], x.us[0]))
  }
  None
}

/// A Float operation the pass pairs: its mnemonic, or "".
fn slp_op(x: Inst) -> Str {
  if x.kind != K_PLAIN || x.defs.len() != 1 || x.has(IF_HAS_FAULT) || !x.clobbers.is_empty() || x.has(IF_EARLY) {
    return ""
  }
  for m in ["fadd", "fsub", "fmul", "fdiv"] {
    if x.text == "${m} $d0, $u0, $u1" && x.us.len() == 2 {
      return m
    }
  }
  if x.text == "fsqrt $d0, $u0" && x.us.len() == 1 {
    return "fsqrt"
  }
  ""
}

/// Whether x may write memory (a store, a call, a template of several
/// lines or one this pass does not know).
fn slp_writes(x: Inst) -> Bool {
  if x.kind == K_CALL || x.kind == K_ENTRY {
    return true
  }
  if x.kind != K_PLAIN {
    return false
  }
  let t = x.text
  t.contains("\n") || t.starts_with("st") || t.starts_with("swp") || t.starts_with("ld") && t.contains("a") && !t.starts_with("ldr") && !t.starts_with("ldp")
}

/// The hot chains of the function: lists of blocks, each block in one.
fn (g: G) slp_chains() -> List[List[Int]] {
  let n = g.blocks.len()
  var seen: List[Bool] = []
  // predecessor counts from the successor lists (MBlock.preds is made
  // later, by register allocation)
  var npred: List[Int] = []
  for _ in 0..n {
    seen.push(false)
    npred.push(0)
  }
  for b in g.all_blocks() {
    for s in g.slp_succs(b) {
      npred[s] += 1
    }
  }
  var out: List[List[Int]] = []
  for b0 in g.all_blocks() {
    if seen[b0] || g.blocks[b0].cold {
      continue
    }
    var ch = [b0]
    seen[b0] = true
    var b = b0
    while true {
      var next = -1
      for s in g.slp_succs(b) {
        if !g.blocks[s].cold {
          if next >= 0 {
            next = -2
          } else {
            next = s
          }
        }
      }
      if next < 0 || seen[next] || npred[next] != 1 {
        break
      }
      seen[next] = true
      ch.push(next)
      b = next
    }
    if ch.len() > 0 {
      out.push(ch)
    }
  }
  out
}

/// The successors of block b, from its terminator's targets (MBlock.succs
/// is made later).
fn (g: G) slp_succs(b: Int) -> List[Int] {
  let t = g.term_at(b)
  if t < 0 {
    return []
  }
  g.blocks[b].insts[t].targets
}

/// The pass: each hot chain on its own. With XO_DUMP_FN naming the
/// function, its chains' decisions go beside its IR dump (xo-ir-slp-NAME
/// .txt: each chain's packs, and per group made, or why not).
fn (var g: G) slp_f64() {
  if g.x86 {
    return
  }
  // every vreg's definition count and uses (block, index, operand)
  var ndef: Map[Int, Int] = {}
  // the uses as (vreg, position) pairs first, each vreg's list stored
  // once: a push into a list the map still held copied it, quadratic in
  // a vreg's uses (54 GB allocated for a 32,768 statement function, the
  // scale suite, 2026-10-23)
  var pairs: List[(Int, SPos)] = []
  for b in g.all_blocks() {
    for (i, x) in g.blocks[b].insts.indexed() {
      for d in x.defs {
        ndef[d] = (ndef.get(d) ?? 0) + 1
      }
      for u in x.us {
        pairs.push((u, SPos{b: b, i: i, ord: -1}))
      }
    }
  }
  // by vreg, then in the order found
  let order = (0..pairs.len()).to_list().sort_by(fn(k) { (pairs[k].0, k) })
  var vuses: Map[Int, List[SPos]] = {}
  var j = 0
  while j < order.len() {
    let u = pairs[order[j]].0
    var l: List[SPos] = []
    while j < order.len() && pairs[order[j]].0 == u {
      l.push(pairs[order[j]].1)
      j += 1
    }
    vuses[u] = l
  }
  var tr: List[Str] = []
  for ch in g.slp_chains() {
    let r = g.slp_chain(ch, ndef, vuses)
    tr.push("chain ${ch.len()} from b${ch[0]} to b${ch[ch.len() - 1]}: ${r}")
  }
  if g.f.name == g.m.dump_fn {
    g.dumps.push(("slp-${g.f.name}", tr.join("\n")))
  }
}

/// The pass over one chain.
fn (var g: G) slp_chain(ch: List[Int], ndef: Map[Int, Int], vuses: Map[Int, List[SPos]]) -> Str {
  // chain order of every instruction
  var ord: Map[Int, Int] = {}
  var at: List[SPos] = []
  for b in ch {
    for i in 0..g.blocks[b].insts.len() {
      ord[b * 65536 + i] = at.len()
      at.push(SPos{b: b, i: i, ord: at.len()})
    }
  }
  let ordof = fn(b: Int, i: Int) -> Int { ord.get(b * 65536 + i) ?? -1 }
  // the single definition of each vreg defined once in the chain
  var defat: Map[Int, SPos] = {}
  for p in at {
    let x = g.blocks[p.b].insts[p.i]
    for d in x.defs {
      if (ndef.get(d) ?? 0) == 1 {
        defat[d] = p
      }
    }
  }
  var packs: List[SPack] = []
  var by_lanes: Map[Str, Int] = {}
  // each scalar in one pack of loads or operations
  var paired: Map[Int, Bool] = {}
  // load seeds: every pair of Float loads of one base 8 apart that may
  // both happen at the earlier, scored by the pairs of the same
  // operation among their lanes' users; taken best first, each load in
  // one pair, none that scores 0 (a pair no operation pairs costs its
  // extracts: x, y, z, vx at 24 to 48 pair as (24, 32) and (48, 56),
  // not (40, 48))
  var cands: List[(Int, SPack)] = []
  for (j, p) in at.indexed() {
    let lxo = g.slp_load(g.blocks[p.b].insts[p.i])
    if lxo.is_none() {
      continue
    }
    let lx = lxo ?? (0, 0, 0)
    for q in at[j + 1..at.len()] {
      let lyo = g.slp_load(g.blocks[q.b].insts[q.i])
      if lyo.is_none() {
        continue
      }
      let ly = lyo ?? (0, 0, 0)
      if ly.1 != lx.1 || (ndef.get(lx.2) ?? 0) != 1 || (ndef.get(ly.2) ?? 0) != 1 {
        continue
      }
      var k = lx.0
      var a = lx.2
      var c = ly.2
      if ly.0 == lx.0 - 8 {
        k = ly.0
        a = ly.2
        c = lx.2
      } else if ly.0 != lx.0 + 8 {
        continue
      }
      // the later load (q's, at ly.0) moves up to p
      if !g.slp_loads_movable(at, p.ord, q.ord, lx.1, ly.0) {
        continue
      }
      let score = g.slp_score(a, c, vuses)
      if score > 0 {
        cands.push((score, SPack{l0: a, l1: c, how: "load", m0: p, m1: q, off: k, base: lx.1}))
      }
    }
  }
  let ranked = cands.sort_by(fn(e) { 0 - e.0 })
  for (_, pk) in ranked {
    if paired.contains(pk.l0) || paired.contains(pk.l1) {
      continue
    }
    paired[pk.l0] = true
    paired[pk.l1] = true
    by_lanes["${pk.l0},${pk.l1}"] = packs.len()
    packs.push(pk)
  }
  if packs.is_empty() {
    return "no load pairs"
  }
  // grow through operations to a fixed point, with no builds first (a
  // build registered early would shadow the operation pack the same
  // lanes become later: (dx*mi, dy*mi)), then once with builds, and
  // again from what that made
  var builds = false
  var grew = true
  while grew || !builds {
    if !grew {
      builds = true
    }
    grew = false
    var pi = 0
    while pi < packs.len() {
      let pk = packs[pi]
      pi += 1
      for ua in vuses.get(pk.l0) ?? [] {
        let oa = ordof(ua.b, ua.i)
        if oa < 0 {
          continue
        }
        let xa = g.blocks[ua.b].insts[ua.i]
        let m = slp_op(xa)
        if m.is_empty() || (ndef.get(xa.defs[0]) ?? 0) != 1 {
          continue
        }
        for ub in vuses.get(pk.l1) ?? [] {
          let ob = ordof(ub.b, ub.i)
          if ob < 0 || ob == oa {
            continue
          }
          let xb = g.blocks[ub.b].insts[ub.i]
          if slp_op(xb) != m || (ndef.get(xb.defs[0]) ?? 0) != 1 {
            continue
          }
          let key = "${xa.defs[0]},${xb.defs[0]}"
          // a build of the same lanes made earlier gives way: the users
          // that took it get this operation instead
          let shadow = by_lanes.get(key) ?? -1
          if (shadow >= 0 && packs[shadow].how != "build") || paired.contains(xa.defs[0]) || paired.contains(xb.defs[0]) {
            continue
          }
          // each operand: a pack of the two, the same scalar, or a build
          var args: List[Int] = []
          var same: List[Int] = []
          var ok = true
          for k in 0..xa.us.len() {
            let a = xa.us[k]
            let c = xb.us[k]
            if a <= 0 || c <= 0 {
              // vreg 0 is the zero register
              ok = false
            } else if let Some(pj) = by_lanes.get("${a},${c}") {
              args.push(pj)
              same.push(-1)
            } else if a == c {
              args.push(-1)
              same.push(a)
            } else if builds && g.fp[a] && g.fp[c] && !g.wide.contains(a) && !g.wide.contains(c) {
              // two scalars built into a pack
              let bk = "${a},${c}"
              by_lanes[bk] = packs.len()
              packs.push(SPack{l0: a, l1: c, how: "build"})
              args.push(packs.len() - 1)
              same.push(-1)
            } else {
              ok = false
            }
          }
          if !ok {
            continue
          }
          paired[xa.defs[0]] = true
          paired[xb.defs[0]] = true
          let np = SPack{l0: xa.defs[0], l1: xb.defs[0], how: "op", m0: SPos{b: ua.b, i: ua.i, ord: oa}, m1: SPos{b: ub.b, i: ub.i, ord: ob}, op: m, args: args, same: same}
          if shadow >= 0 {
            packs[shadow] = np
          } else {
            by_lanes[key] = packs.len()
            packs.push(np)
          }
          grew = true
        }
      }
    }
  }
  // the loads the load packs take (they move to the earlier load)
  // each load pack member's order: the order its pack loads at
  var ldmem: Map[Int, Int] = {}
  for pk in packs {
    if pk.how == "load" {
      ldmem[pk.m0.ord] = imin(pk.m0.ord, pk.m1.ord)
      ldmem[pk.m1.ord] = imin(pk.m0.ord, pk.m1.ord)
    }
  }
  // store pairs of a pack's lanes, and faddp of its two lanes
  var stores: List[(Int, SPos, SPos)] = []
  var redus: List[(Int, SPos)] = []
  for (pj, pk) in packs.indexed() {
    if pk.how == "build" {
      continue
    }
    for sa in vuses.get(pk.l0) ?? [] {
      let oa = ordof(sa.b, sa.i)
      if oa < 0 {
        continue
      }
      let xa = g.blocks[sa.b].insts[sa.i]
      if slp_op(xa) == "fadd" && xa.us[0] == pk.l0 && xa.us[1] == pk.l1 {
        redus.push((pj, SPos{b: sa.b, i: sa.i, ord: oa}))
        continue
      }
      let s0o = g.slp_store(xa)
      if s0o.is_none() {
        continue
      }
      let s0 = s0o ?? (0, 0, 0)
      if s0.2 != pk.l0 {
        continue
      }
      for sb in vuses.get(pk.l1) ?? [] {
        let ob = ordof(sb.b, sb.i)
        if ob < 0 {
          continue
        }
        let s1o = g.slp_store(g.blocks[sb.b].insts[sb.i])
        if s1o.is_none() {
          continue
        }
        let s1 = s1o ?? (0, 0, 0)
        if s1.1 == s0.1 && s1.0 == s0.0 + 8 && s1.2 == pk.l1 && g.slp_stores_movable(at, imin(oa, ob), imax(oa, ob), s0.1, s0.0, ldmem) {
          stores.push((pj, SPos{b: sa.b, i: sa.i, ord: oa}, SPos{b: sb.b, i: sb.i, ord: ob}))
        }
      }
    }
  }
  "${packs.len()} packs, ${stores.len()} stores, ${redus.len()} redus: ${g.slp_commit(ch, at, packs, stores, redus, vuses, defat)}"
}

/// How many pairs of the same paired operation use lanes a and c at the
/// same operand position.
fn (g: G) slp_score(a: Int, c: Int, vuses: Map[Int, List[SPos]]) -> Int {
  var n = 0
  for ua in vuses.get(a) ?? [] {
    let xa = g.blocks[ua.b].insts[ua.i]
    let m = slp_op(xa)
    if m.is_empty() {
      continue
    }
    for ub in vuses.get(c) ?? [] {
      let xb = g.blocks[ub.b].insts[ub.i]
      if slp_op(xb) == m && (ua.b != ub.b || ua.i != ub.i) {
        for k in 0..xa.us.len() {
          if xa.us[k] == a && k < xb.us.len() && xb.us[k] == c {
            n += 1
          }
        }
      }
    }
  }
  n
}

/// Whether the Float load of base at k at chain order o2 may happen at
/// o1 < o2 instead: nothing between writes memory but stores to the same
/// base outside [k, k + 8).
fn (g: G) slp_loads_movable(at: List[SPos], o1: Int, o2: Int, base: Int, k: Int) -> Bool {
  let lo = imin(o1, o2)
  let hi = imax(o1, o2)
  for p in at[lo + 1..hi] {
    let x = g.blocks[p.b].insts[p.i]
    if let Some(s) = g.slp_store(x) {
      if s.1 == base && (s.0 + 8 <= k || s.0 >= k + 8) {
        continue
      }
      return false
    }
    if slp_writes(x) {
      return false
    }
  }
  true
}

/// Whether two Float stores to base at k and k + 8, at chain orders lo <
/// hi, may both happen at hi: nothing between reads or writes that
/// memory (no load of the base in [k, k + 16), no load of another
/// base, no other write).
fn (g: G) slp_stores_movable(at: List[SPos], lo: Int, hi: Int, base: Int, k: Int, ldmem: Map[Int, Int]) -> Bool {
  for p in at[lo + 1..hi] {
    let x = g.blocks[p.b].insts[p.i]
    if (ldmem.get(p.ord) ?? hi) < lo {
      // a load pack's member: it happens at the pack's earlier load,
      // before both stores
      continue
    }
    if slp_writes(x) {
      return false
    }
    if let Some(l) = g.slp_load(x) {
      // another base may name the same memory: vs[i] and vs[j] with
      // i == j (2026-11-02: `vs[j].z = c - vs[i].w; vs[j].w = d -
      // vs[i].z` read the old z, the store of z sunk below that load)
      if l.1 != base || (l.0 + 8 > k && l.0 < k + 16) {
        return false
      }
      continue
    }
    if x.kind == K_PLAIN && x.text.starts_with("ld") {
      // another load (a width this pass does not read): it may alias
      return false
    }
  }
  true
}

/// The chain's packs made, when they save instructions: the cost model,
/// the checks that keep every read of a lane after its pack, and the
/// rewrite of the chain's blocks.
fn (var g: G) slp_commit(ch: List[Int], at: List[SPos], packs0: List[SPack], stores0: List[(Int, SPos, SPos)], redus0: List[(Int, SPos)], vuses: Map[Int, List[SPos]], defat: Map[Int, SPos]) -> Str {
  var packs = packs0
  let np = packs.len()
  // the groups of packs that feed each other (union of an operation and
  // its operand packs); each group is made or left on its own
  var up: List[Int] = []
  for k in 0..np {
    up.push(k)
  }
  for (pj, pk) in packs.indexed() {
    for a in pk.args {
      if a >= 0 {
        let ra = slp_root(up, a)
        let rp = slp_root(up, pj)
        if ra != rp {
          up[ra] = rp
        }
      }
    }
  }
  // each group's saving, cost, and whether its lanes are read only after
  // their packs (a scalar in two packs leaves its groups as they are)
  var save: Map[Int, Int] = {}
  var cost: Map[Int, Int] = {}
  var bad: Map[Int, Str] = {}
  for (_, s0, _) in stores0 {
    let _s = s0
  }
  for (pj, _, _) in stores0 {
    let r = slp_root(up, pj)
    save[r] = (save.get(r) ?? 0) + 1
  }
  // the position of each packed instruction, with its group: a read
  // there is the pack's only if that group is made
  var gone: Map[Int, Int] = {}
  for (pj, pk) in packs.indexed() {
    if pk.how != "build" {
      gone[pk.m0.ord] = slp_root(up, pj)
      gone[pk.m1.ord] = slp_root(up, pj)
    }
  }
  for (pj, s0, s1) in stores0 {
    gone[s0.ord] = slp_root(up, pj)
    gone[s1.ord] = slp_root(up, pj)
  }
  for (pj, r) in redus0 {
    gone[r.ord] = slp_root(up, pj)
  }
  // the reads of a group's lanes before its pack by an instruction of
  // another group: (the group that reads, the lane, its position, the
  // pack's), bad when that group is not made
  var early: Map[Int, List[(Int, Int, Int, Int)]] = {}
  // the lanes a build reads, with the position of the pack the build
  // feeds: a lane of another pack read there in the other order (Lang 3's
  // progen.Alias seed 387, 2026-11-02: an fadd pack's operand was an fsub
  // pack's lanes swapped, built with zip1 from the scalars the fsub pack
  // had replaced) is a read of the scalar, so the lane is extracted
  var bread: Map[Int, List[Int]] = {}
  for pk in packs {
    if pk.how is "build" | "load" {
      continue
    }
    for a in pk.args {
      if a >= 0 && packs[a].how == "build" {
        for l in [packs[a].l0, packs[a].l1] {
          var cs = bread.get(l) ?? []
          cs.push(imax(pk.m0.ord, pk.m1.ord))
          bread[l] = cs
        }
      }
    }
  }
  var lane_of: Map[Int, Int] = {}
  for (pj, pk) in packs.indexed() {
    let r = slp_root(up, pj)
    if pk.how == "build" {
      // free when both scalars come from outside the chain: the hoisting
      // passes build it once, outside the loop
      if defat.contains(pk.l0) || defat.contains(pk.l1) {
        cost[r] = (cost.get(r) ?? 0) + 1
      }
      continue
    }
    save[r] = (save.get(r) ?? 0) + 1
    for s in pk.same {
      if s >= 0 && pk.op != "fmul" {
        cost[r] = (cost.get(r) ?? 0) + 1
      }
    }
    let pos = if pk.how == "load" { imin(pk.m0.ord, pk.m1.ord) } else { imax(pk.m0.ord, pk.m1.ord) }
    for l in [pk.l0, pk.l1] {
      if lane_of.contains(l) {
        bad[r] = "lane v${l} in two packs"
        bad[slp_root(up, lane_of.get(l) ?? pj)] = "lane v${l} in two packs"
      }
      lane_of[l] = pj
      var read = false
      for u in vuses.get(l) ?? [] {
        let o = g.slp_ord(at, u)
        if o >= 0 && gone.contains(o) {
          let gr = gone.get(o) ?? r
          if gr != r && o <= pos {
            var es = early.get(r) ?? []
            es.push((gr, l, o, pos))
            early[r] = es
          }
          continue
        }
        // a read outside the chain, or before the pack: not v1's
        if o < 0 || o <= pos {
          bad[r] = "lane v${l} read at ${o} (pack at ${pos}, ${pk.how})"
        }
        read = true
      }
      for cp in bread.get(l) ?? [] {
        if cp <= pos {
          bad[r] = "lane v${l} built at ${cp} (pack at ${pos})"
        }
        read = true
      }
      if read {
        cost[r] = (cost.get(r) ?? 0) + 1
      }
    }
  }
  var made: Map[Int, Bool] = {}
  var why: List[Str] = []
  for k in 0..np {
    if slp_root(up, k) != k {
      continue
    }
    let sv = save.get(k) ?? 0
    let co = cost.get(k) ?? 0
    if let Some(b) = bad.get(k) {
      why.push("group ${k}: ${b}")
    } else if sv <= co {
      why.push("group ${k}: save ${sv} cost ${co}")
    } else {
      made[k] = true
      why.push("group ${k}: made, save ${sv} cost ${co}")
    }
  }
  // a group whose lane a group left scalar reads before the pack is not
  // made either (Lang 3's progen.Alias seed 54, 2026-11-02: group 3 was
  // left, so its fsub read group 5's lane, made later, before it was
  // written); repeated, since each group left can leave another
  var again = true
  while again {
    again = false
    for k in 0..np {
      if !made.contains(k) {
        continue
      }
      for (gr, l, o, pos) in early.get(k) ?? [] {
        if !made.contains(gr) {
          made.remove(k)
          why.push("group ${k}: lane v${l} read at ${o} (pack at ${pos}) by group ${gr}, not made")
          again = true
          break
        }
      }
    }
  }
  if made.is_empty() {
    return why.join(", ")
  }
  // only the groups made from here on
  var keep: List[Bool] = []
  for k in 0..np {
    keep.push(made.contains(slp_root(up, k)))
  }
  var stores: List[(Int, SPos, SPos)] = []
  for e in stores0 {
    if keep[e.0] {
      stores.push(e)
    }
  }
  var redus: List[(Int, SPos)] = []
  for e in redus0 {
    if keep[e.0] {
      redus.push(e)
    }
  }
  gone = {}
  var extract: Map[Int, Bool] = {}
  for (pj, pk) in packs.indexed() {
    if !keep[pj] {
      packs[pj].how = "skip"
    } else if pk.how != "build" {
      gone[pk.m0.ord] = 0
      gone[pk.m1.ord] = 0
    }
  }
  for (_, s0, s1) in stores {
    gone[s0.ord] = 0
    gone[s1.ord] = 0
  }
  for (_, r) in redus {
    gone[r.ord] = 0
  }
  for pk in packs {
    if pk.how is "skip" | "build" {
      continue
    }
    for l in [pk.l0, pk.l1] {
      for u in vuses.get(l) ?? [] {
        let o = g.slp_ord(at, u)
        if !(o >= 0 && gone.contains(o)) {
          extract[l] = true
        }
      }
    }
  }
  // a lane a kept build reads (bread): the build's zip1 reads the scalar
  for pk in packs {
    if pk.how is "skip" | "build" | "load" {
      continue
    }
    for a in pk.args {
      if a >= 0 && packs[a].how == "build" {
        extract[packs[a].l0] = true
        extract[packs[a].l1] = true
      }
    }
  }
  let save_all = why.join(", ")
  // a wide vreg per pack (a build gets one per use, below)
  for pj in 0..packs.len() {
    if !(packs[pj].how is "build" | "skip") {
      packs[pj].wide = g.new_wide()
    }
  }
  // the instructions to put at each chain order, instead of what is there
  var put: Map[Int, List[Inst]] = {}
  for pk in packs {
    if pk.how is "build" | "skip" {
      continue
    }
    var out: List[Inst] = []
    if pk.how == "load" {
      out.push(Inst{kind: K_PLAIN, text: "ldr $qd0, [$u0, #${pk.off}]", defs: [pk.wide], us: [pk.base]})
    } else {
      var wargs: List[Int] = []
      var by_elem = -1
      for (k, a) in pk.args.indexed() {
        if a >= 0 {
          if packs[a].how == "build" {
            let bw = g.new_wide()
            // lane 0 of each: one instruction, which hoist_invariants
            // moves out of a loop when both scalars are invariant
            out.push(Inst{kind: K_PLAIN, text: "zip1 $vd0.2d, $vu0.2d, $vu1.2d", defs: [bw], us: [packs[a].l0, packs[a].l1]})
            wargs.push(bw)
          } else {
            wargs.push(packs[a].wide)
          }
        } else if pk.op == "fmul" && by_elem < 0 {
          // the scalar both lanes multiply by: by element
          by_elem = pk.same[k]
          wargs.push(-1)
        } else {
          let dw = g.new_wide()
          out.push(Inst{kind: K_PLAIN, text: "dup $vd0.2d, $vu0.d[0]", defs: [dw], us: [pk.same[k]]})
          wargs.push(dw)
        }
      }
      if pk.op == "fsqrt" {
        out.push(Inst{kind: K_PLAIN, text: "fsqrt $vd0.2d, $vu0.2d", defs: [pk.wide], us: [wargs[0]]})
      } else if by_elem >= 0 {
        let w = if wargs[0] >= 0 { wargs[0] } else { wargs[1] }
        out.push(Inst{kind: K_PLAIN, text: "fmul $vd0.2d, $vu0.2d, $vu1.d[0]", defs: [pk.wide], us: [w, by_elem]})
      } else {
        out.push(Inst{kind: K_PLAIN, text: "${pk.op} $vd0.2d, $vu0.2d, $vu1.2d", defs: [pk.wide], us: [wargs[0], wargs[1]]})
      }
    }
    if extract.contains(pk.l0) {
      out.push(Inst{kind: K_PLAIN, text: "dup $d0, $vu0.d[0]", defs: [pk.l0], us: [pk.wide]})
    }
    if extract.contains(pk.l1) {
      out.push(Inst{kind: K_PLAIN, text: "dup $d0, $vu0.d[1]", defs: [pk.l1], us: [pk.wide]})
    }
    let pos = if pk.how == "load" { imin(pk.m0.ord, pk.m1.ord) } else { imax(pk.m0.ord, pk.m1.ord) }
    var l = put.get(pos) ?? []
    for x in out {
      l.push(x)
    }
    put[pos] = l
  }
  for (pj, s0, s1) in stores {
    let x = g.blocks[s0.b].insts[s0.i]
    let k = (g.slp_store(x) ?? (0, 0, 0)).0
    let pos = imax(s0.ord, s1.ord)
    var l = put.get(pos) ?? []
    l.push(Inst{kind: K_PLAIN, text: "str $qu0, [$u1, #${k}]", us: [packs[pj].wide, x.us[1]]})
    put[pos] = l
  }
  for (pj, r) in redus {
    let x = g.blocks[r.b].insts[r.i]
    var l = put.get(r.ord) ?? []
    l.push(Inst{kind: K_PLAIN, text: "faddp $d0, $vu0.2d", defs: [x.defs[0]], us: [packs[pj].wide]})
    put[r.ord] = l
  }
  // the chain's blocks again: each position keeps its instruction unless
  // a pack took it, then what the packs put there
  for b in ch {
    let old = g.take_insts(b)
    var ins: List[Inst] = []
    for (i, x) in old.indexed() {
      let o = g.slp_ord(at, SPos{b: b, i: i, ord: -1})
      if !gone.contains(o) {
        ins.push(x)
      }
      for y in put.get(o) ?? [] {
        ins.push(y)
      }
    }
    g.put_insts(b, ins)
  }
  save_all
}

/// The group of pack k: the root of its union chain in up.
fn slp_root(up: List[Int], k0: Int) -> Int {
  var k = k0
  while up[k] != k {
    k = up[k]
  }
  k
}

/// The chain order of instruction u (its block and index), or -1.
fn (g: G) slp_ord(at: List[SPos], u: SPos) -> Int {
  for p in at {
    if p.b == u.b && p.i == u.i {
      return p.ord
    }
  }
  -1
}

/// Decision 0323 stage 3, loop carried packs: a pair of loop header
/// parameters a and b that the loop reads only as a pack (`zip1 w, a,
/// b`), and whose values on every back edge are the two lanes of one wide
/// p (`dup a', p.d[0]`, `dup b', p.d[1]`, the latch's parallel move
/// `a <- a'`, `b <- b'`), is carried as w instead: the zip1 moves to the
/// preheader, each latch moves p into w, and the loop's exits split w
/// back into a and b. Inside an iteration w still holds (a, b), so an exit
/// from any block of the loop reads the right values. The zip1 and the
/// dups were on the loop carried chain (nbody's bs[i].vx and vy across
/// the j loop: zip1, fsub, dup, about 7 cycles an iteration where Go's
/// scalar fmsub takes 4; 1.036 of Go's wall at 0.867 of its
/// instructions, 2026-11-04).
///
/// Not for a loop with a call outside its cold blocks (a wide value has
/// no callee saved register) or without one preheader ending in a jump,
/// or whose exits are entered from outside it.
fn (var g: G) slp_carry() {
  if g.x86 {
    return
  }
  var tr: List[Str] = []
  // one pair a round: a carry may add blocks (an exit's split), so the
  // loops are found again
  var n = 0
  while n < 16 && g.slp_carry_round(tr) {
    n += 1
  }
  if g.f.name == g.m.dump_fn {
    g.dumps.push(("slpc-${g.f.name}", tr.join("\n")))
  }
}

/// One round of slp_carry: the first pair carried in any loop, whether
/// there was one.
fn (var g: G) slp_carry_round(var tr: List[Str]) -> Bool {
  let blocks = g.all_blocks()
  let preds = g.mpreds_all(blocks)
  let loops = g.dfs_loops(g.hot[0], preds)
  for l in loops {
    let (head, body) = l
    var pre = -1
    for p in preds[head] {
      if body[p] {
        continue
      }
      if pre >= 0 {
        pre = -1
        break
      }
      pre = p
    }
    if pre < 0 || g.term_kind(pre) != K_JUMP {
      tr.push("loop b${head}: no preheader")
      continue
    }
    var exits: List[Int] = []
    var ok = true
    for b in blocks {
      if !body[b] {
        continue
      }
      for x in g.blocks[b].insts {
        ok = ok && !(x.kind == K_CALL && !g.blocks[b].cold && !x.has(IF_COLD_CALL))
      }
      for s in g.slp_succs(b) {
        if !body[s] && !exits.contains(s) {
          exits.push(s)
        }
      }
    }
    if !ok {
      tr.push("loop b${head}: a call")
      continue
    }
    if g.slp_carry_one(blocks, preds, body, head, pre, exits, tr) {
      return true
    }
  }
  false
}

/// One pair of slp_carry in the loop of header head (its body, preheader
/// pre and exits), whether one was found and moved.
fn (var g: G) slp_carry_one(blocks: List[Int], preds: List[List[Int]], body: List[Bool], head: Int, pre: Int, exits: List[Int], var tr: List[Str]) -> Bool {
  // the counts below are maps over every instruction of blocks, built
  // per loop: only for a loop with a zip1 to carry (the self build spent
  // 4% of its CPU here before this check, 2026-11-04)
  var any_zip = false
  for zb in blocks {
    if any_zip || !body[zb] || g.blocks[zb].cold {
      continue
    }
    for z in g.blocks[zb].insts {
      if z.kind == K_PLAIN && z.text == "zip1 $vd0.2d, $vu0.2d, $vu1.2d" {
        any_zip = true
        break
      }
    }
  }
  if !any_zip {
    return false
  }
  var ndef: Map[Int, Int] = {}
  var nuse: Map[Int, Int] = {}
  var nuse_in: Map[Int, Int] = {}
  // a vreg's (last) definition: (block, index)
  var defat: Map[Int, (Int, Int)] = {}
  for b in blocks {
    for (i, x) in g.blocks[b].insts.indexed() {
      for d in x.defs {
        ndef[d] = (ndef.get(d) ?? 0) + 1
        defat[d] = (b, i)
      }
      for u in x.us {
        nuse[u] = (nuse.get(u) ?? 0) + 1
        if body[b] {
          nuse_in[u] = (nuse_in.get(u) ?? 0) + 1
        }
      }
    }
  }
  for zb in blocks {
    if !body[zb] || g.blocks[zb].cold {
      continue
    }
    for (zi, z) in g.blocks[zb].insts.indexed() {
      if z.kind != K_PLAIN || z.text != "zip1 $vd0.2d, $vu0.2d, $vu1.2d" || z.us.len() != 2 || z.defs.len() != 1 {
        continue
      }
      let a = z.us[0]
      let c = z.us[1]
      let w = z.defs[0]
      if a == c || a == 0 || c == 0 || (ndef.get(w) ?? 0) != 1 || (nuse_in.get(a) ?? 0) != 1 || (nuse_in.get(c) ?? 0) != 1 {
        continue
      }
      // every definition of a or c in the loop: a latch's parallel move
      // of both, from the lanes of one wide p: (block, index, k of a, k
      // of c, p)
      var lat: List[(Int, Int, Int, Int, Int)] = []
      var drop: List[(Int, Int)] = [(zb, zi)]
      var ok = true
      for lb in blocks {
        if !body[lb] || !ok {
          continue
        }
        for (k, x) in g.blocks[lb].insts.indexed() {
          let ka = x.defs.index_of(a) ?? -1
          let kc = x.defs.index_of(c) ?? -1
          if ka < 0 && kc < 0 {
            continue
          }
          if x.kind != K_PMOVE || ka < 0 || kc < 0 || !g.slp_succs(lb).contains(head) || x.srcs[ka].kind != S_REG || x.srcs[kc].kind != S_REG {
            ok = false
            break
          }
          let e0 = x.srcs[ka].v
          let e1 = x.srcs[kc].v
          if (ndef.get(e0) ?? 0) != 1 || (ndef.get(e1) ?? 0) != 1 || (nuse.get(e0) ?? 0) != 1 || (nuse.get(e1) ?? 0) != 1 {
            ok = false
            break
          }
          let (b0, i0) = defat.get_or_fault(e0, "a vreg defined once has a definition")
          let (b1, i1) = defat.get_or_fault(e1, "a vreg defined once has a definition")
          let d0 = g.blocks[b0].insts[i0]
          let d1 = g.blocks[b1].insts[i1]
          if d0.text != "dup $d0, $vu0.d[0]" || d1.text != "dup $d0, $vu0.d[1]" || d0.us.len() != 1 || d1.us.len() != 1 || d0.us[0] != d1.us[0] || !g.wide.contains(d0.us[0]) {
            ok = false
            break
          }
          lat.push((lb, k, ka, kc, d0.us[0]))
          drop.push((b0, i0))
          drop.push((b1, i1))
        }
      }
      if !ok || lat.is_empty() {
        tr.push("  zip1 b${zb}: a ${a} c ${c}: not a carried pair")
        continue
      }
      // each latch moves p into w, not the lanes into a and c
      for (lb, k, ka, kc, p) in lat {
        var x = g.blocks[lb].insts[k]
        var defs: List[Int] = []
        var srcs: List[Src] = []
        for j in 0..x.defs.len() {
          if j == ka {
            defs.push(w)
            srcs.push(rsrc(p))
          } else if j != kc {
            defs.push(x.defs[j])
            srcs.push(x.srcs[j])
          }
        }
        var us: List[Int] = []
        for s in srcs {
          if s.kind == S_REG && s.v != 0 {
            us.push(s.v)
          }
        }
        x.defs = defs
        x.srcs = srcs
        x.us = us
        g.blocks[lb].insts[k] = x
      }
      for (db, di) in drop {
        var x = g.blocks[db].insts[di]
        x.kind = -1
        g.blocks[db].insts[di] = x
      }
      for b in blocks {
        if g.blocks[b].insts.any(fn(x) { x.kind == -1 }) {
          g.blocks[b].insts = g.blocks[b].insts.filter(fn(x) { x.kind != -1 })
        }
      }
      let pins = g.blocks[pre].insts
      let n = pins.len()
      g.blocks[pre].insts = pins[0..n - 1] + [g.slp_carry_load(preds, pre, a, c, w) ?? z] + [pins[n - 1]]
      for s in exits {
        if !g.slp_live_from(s, a, c, body) {
          continue
        }
        // the pair stored next to each other right after the loop: one q
        // store of w, no split (nbody's j loop runs 0 to 4 times an entry,
        // where the exit's two dups cost more than the loop saved)
        if (nuse.get(a) ?? 0) == 2 && (nuse.get(c) ?? 0) == 2 && preds[s].all(fn(p) { body[p] }) && g.slp_carry_store(preds, body, s, a, c, w) {
          continue
        }
        let x0 = Inst{kind: K_PLAIN, text: "dup $d0, $vu0.d[0]", defs: [a], us: [w]}
        let x1 = Inst{kind: K_PLAIN, text: "dup $d0, $vu0.d[1]", defs: [c], us: [w]}
        if preds[s].all(fn(p) { body[p] }) {
          g.blocks[s].insts = [x0, x1] + g.blocks[s].insts
          continue
        }
        // entered from outside the loop too (a rotated loop's guard skips
        // it): split each edge from the loop instead, where w is defined
        for p in preds[s] {
          if !body[p] {
            continue
          }
          let nb = g.new_block(g.blocks[s].cold)
          g.blocks[nb].insts = [x0, x1, Inst{kind: K_JUMP, targets: [s]}]
          let t = g.term_at(p)
          var y = g.blocks[p].insts[t]
          for (k, tg) in y.targets.indexed() {
            if tg == s {
              y.targets[k] = nb
            }
          }
          g.blocks[p].insts[t] = y
          // lay it out right after p
          let list = if g.blocks[s].cold { g.cold } else { g.hot }
          var out: List[Int] = []
          for b in list {
            if b == nb {
              continue
            }
            out.push(b)
            if b == p {
              out.push(nb)
            }
          }
          if !out.contains(nb) {
            out.push(nb)
          }
          if g.blocks[s].cold {
            g.cold = out
          } else {
            g.hot = out
          }
        }
      }
      tr.push("  zip1 b${zb}: a ${a} c ${c} carried as ${w}, ${lat.len()} latches, ${exits.len()} exits")
      return true
    }
  }
  false
}

/// Whether a or c may be read on a path from block s (outside the loop
/// body) before both are written: an exit's split of a carried pair is
/// needed (a fault's cold exit reads neither, and keeping w live into it
/// kept w and the latch's p apart, a mov an iteration).
fn (g: G) slp_live_from(s: Int, a: Int, c: Int, body: List[Bool]) -> Bool {
  var seen: Map[Int, Bool] = {}
  var work = [s]
  while !work.is_empty() {
    let b = work.pop() ?? -1
    if b < 0 || seen.contains(b) {
      continue
    }
    seen[b] = true
    var wa = false
    var wc = false
    for x in g.blocks[b].insts {
      if (!wa && x.us.contains(a)) || (!wc && x.us.contains(c)) {
        return true
      }
      wa = wa || x.defs.contains(a)
      wc = wc || x.defs.contains(c)
    }
    if wa && wc {
      continue
    }
    for t in g.slp_succs(b) {
      // back into the loop: its header's parameters are a and c
      if body[t] {
        return true
      }
      work.push(t)
    }
  }
  false
}

/// slp_carry's exit split as one store: the blocks from s on (s, then
/// each block whose one predecessor is the one before, which jumps only
/// there, up to 4) store a at [base, #k] and c at [base, #k + 8] (str,
/// the only reads of a and c outside the loop) with nothing between that
/// touches memory or base; the two become one `str q` of w at the later
/// one's place. Whether it did.
fn (var g: G) slp_carry_store(preds: List[List[Int]], body: List[Bool], s: Int, a: Int, c: Int, w: Int) -> Bool {
  var ch = [s]
  while ch.len() < 4 {
    let ss = g.slp_succs(ch[ch.len() - 1])
    if ss.len() != 1 || ss[0] >= body.len() || body[ss[0]] || preds[ss[0]].len() != 1 || ch.contains(ss[0]) {
      break
    }
    ch.push(ss[0])
  }
  // every instruction of the chain: (block, index)
  var at: List[(Int, Int)] = []
  for b in ch {
    for i in 0..g.blocks[b].insts.len() {
      at.push((b, i))
    }
  }
  var ia = -1
  var ic = -1
  var ka = -1
  var kc = -1
  for (n, (b, i)) in at.indexed() {
    let x = g.blocks[b].insts[i]
    if let Some((k, _, v)) = g.slp_store(x) {
      if v == a && ia < 0 && x.us[1] != a && x.us[1] != c {
        ia = n
        ka = k
        continue
      } else if v == c && ic < 0 && x.us[1] != a && x.us[1] != c {
        ic = n
        kc = k
        continue
      }
    }
    if x.us.contains(a) || x.us.contains(c) {
      return false
    }
  }
  if ia < 0 || ic < 0 {
    return false
  }
  let xa = g.blocks[at[ia].0].insts[at[ia].1]
  let xc = g.blocks[at[ic].0].insts[at[ic].1]
  let base = xa.us[1]
  // ldr/str q takes a multiple of 16 up to 65520, or -256 to 255
  if base != xc.us[1] || ka < 0 || kc != ka + 8 || !(ka % 16 == 0 && ka <= 65520 || ka < 256) {
    return false
  }
  let lo = imin(ia, ic)
  let hi = imax(ia, ic)
  for n in lo + 1..hi {
    let x = g.blocks[at[n].0].insts[at[n].1]
    if x.defs.contains(base) {
      return false
    }
    if x.kind == K_JUMP {
      continue
    }
    if x.kind != K_PLAIN || x.text.contains("[") || x.text.contains("\n") {
      return false
    }
  }
  let (hb, hn) = at[hi]
  var y = g.blocks[hb].insts[hn]
  y.text = "str $qu0, [$u1, #${ka}]"
  y.us = [w, base]
  g.blocks[hb].insts[hn] = y
  let (lb, ln) = at[lo]
  let li = g.blocks[lb].insts
  g.blocks[lb].insts = li[0..ln] + li[ln + 1..li.len()]
  true
}

/// slp_carry's entry pack as one load: the preheader's parallel move
/// gives a and c the values of `ldr [base, #k]` and `ldr [base, #k + 8]`
/// in the preheader or the blocks straight before it (each the one
/// predecessor of the next, its other successors cold, up to 4), with nothing
/// after the first load that writes memory, base or the loaded values;
/// then w is `ldr q [base, #k]` at the preheader's end, not a zip1.
fn (g: G) slp_carry_load(preds: List[List[Int]], pre: Int, a: Int, c: Int, w: Int) -> Inst? {
  var ch = [pre]
  while ch.len() < 4 {
    let ps = preds[ch[0]]
    // its other successors cold (a check's fault path): the q load only
    // reads again what the loads read, on the path that reaches pre
    if ps.len() != 1 || ch.contains(ps[0]) || !g.slp_succs(ps[0]).all(fn(t) { t == ch[0] || g.blocks[t].cold }) {
      break
    }
    ch = [ps[0]] + ch
  }
  var at: List[(Int, Int)] = []
  for b in ch {
    for i in 0..g.blocks[b].insts.len() {
      at.push((b, i))
    }
  }
  var pm = -1
  for (n, (b, i)) in at.indexed() {
    let x = g.blocks[b].insts[i]
    if b == pre && x.kind == K_PMOVE && x.defs.contains(a) && x.defs.contains(c) {
      pm = n
    }
  }
  if pm < 0 {
    return None
  }
  let x = g.blocks[at[pm].0].insts[at[pm].1]
  let sa = x.srcs[x.defs.index_of(a) ?? 0]
  let sc = x.srcs[x.defs.index_of(c) ?? 0]
  if sa.kind != S_REG || sc.kind != S_REG {
    return None
  }
  var la = -1
  var lc = -1
  var ka = -1
  var kc = -1
  var ba = -1
  var bc = -1
  for (n, (b, i)) in at.indexed() {
    if let Some((k, bs, d)) = g.slp_load(g.blocks[b].insts[i]) {
      if d == sa.v {
        la = n
        ka = k
        ba = bs
      } else if d == sc.v {
        lc = n
        kc = k
        bc = bs
      }
    }
  }
  if la < 0 || lc < 0 || ba != bc || ka < 0 || kc != ka + 8 || !(ka % 16 == 0 && ka <= 65520 || ka < 256) {
    return None
  }
  for n in imin(la, lc)..at.len() {
    let (b, i) = at[n]
    let y = g.blocks[b].insts[i]
    if n == la || n == lc || (b == pre && i == g.blocks[pre].insts.len() - 1) {
      continue
    }
    // a parallel move writes registers only; any other write of base or
    // the loaded values, a store, a call: the slots may differ at the end
    if y.defs.contains(ba) || y.defs.contains(sa.v) || y.defs.contains(sc.v) {
      return None
    }
    if y.kind == K_PMOVE || y.kind == K_JUMP {
      continue
    }
    if y.kind != K_PLAIN || slp_writes(y) {
      return None
    }
  }
  Some(Inst{kind: K_PLAIN, text: "ldr $qd0, [$u0, #${ka}]", defs: [w], us: [ba]})
}

