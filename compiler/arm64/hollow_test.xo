// Dead code after code generation (hollow.xo, decision 0371): the
// functions of the assembly no root reaches become one brk.

/// main calls live; a C ABI export stub and the drop helper only it
/// calls (two global labels on one body, with a shared local stub other
/// functions branch to) are named by nothing else; a table in data names
/// kept, which nothing calls.
fn hollow_asm() -> Str {
  [
    "\t.section __TEXT,__text,regular,pure_instructions",
    "// func main",
    "\t.p2align 2",
    "\t.globl _main",
    "_main:",
    "\tbl _xo_f_live",
    "\tadrp x0, Lxo_t_str0@PAGE",
    "\tret",
    "\t.p2align 2",
    "_xo_f_live:",
    "\tbl Lxo_drop1",
    "\tret",
    "\t.p2align 2",
    "\t.globl _xo_x_unused",
    "_xo_x_unused:",
    "\tb _xo_f_cabi_unused",
    "\t.p2align 2",
    "_xo_f_cabi_unused:",
    "\tbl _xo_hDead",
    "\tadrp x3, Lxo_t_loc1@PAGE",
    "\tret",
    "\t.p2align 2",
    "_xo_f_drop_20Dead:",
    "_xo_hDead:",
    "\tldr x1, [x0]",
    "\tret",
    "\t.p2align 2",
    "_xo_hShared:",
    "\tldr x1, [x0]",
    "Lxo_drop1:",
    "\tret",
    "\t.p2align 2",
    "_xo_f_kept:",
    "\tret",
    "\t.section __DATA,__const",
    "\t.quad _xo_f_kept",
    "\t.section __TEXT,__cstring,cstring_literals",
    "Lxo_t_loc1:",
    "\t.asciz \"dead.xo:1:1\"",
    "Lxo_t_loc2:",
    "\t.asciz \"named by DWARF\"",
    "\t.section __DATA,__const",
    "\t.p2align 3",
    "Lxo_t_str0:",
    "\t.quad 0",
    "\t.section __DWARF,__debug_str,regular,debug",
    "\t.quad Lxo_t_loc2",
    "",
  ].join("\n")
}

/// The instruction lines of the function at label name, to the next
/// global label or section.
fn body_of(asm: Str, name: Str) -> List[Str] {
  var out: List[Str] = []
  var in_fn = false
  for l in asm.split("\n") {
    if l.starts_with("_") && l.ends_with(":") {
      in_fn = l == "${name}:" || (in_fn && out.is_empty())
      continue
    }
    if l.starts_with("\t.section") {
      in_fn = false
    }
    if in_fn && l.starts_with("\t") && !l.starts_with("\t.") {
      out.push(l)
    }
  }
  out
}

test "an unreached export and the drop helper only it calls become one brk" {
  let (parts, msg) = hollow_unreached([hollow_asm()])
  let asm = parts[0]
  let brk = ["\tbrk #${HOLLOW_BRK}"]
  expect(body_of(asm, "_xo_x_unused")) == brk
  expect(body_of(asm, "_xo_f_cabi_unused")) == brk
  // both labels of the helper stay, on one brk
  expect(body_of(asm, "_xo_f_drop_20Dead")) == brk
  expect(asm.contains("_xo_hDead:\n")) == true
  // reached: from main, through a shared local label, from data
  expect(body_of(asm, "_main")) == ["\tbl _xo_f_live", "\tadrp x0, Lxo_t_str0@PAGE", "\tret"]
  expect(body_of(asm, "_xo_hShared")) == ["\tldr x1, [x0]", "\tret"]
  expect(body_of(asm, "_xo_f_kept")) == ["\tret"]
  // the export keeps its declaration
  expect(asm.contains("\t.globl _xo_x_unused\n_xo_x_unused:")) == true
  // a fault location's string only the hollowed function named goes;
  // one main names and one __DWARF names stay
  expect(asm.contains("Lxo_t_loc1:")) == false
  expect(asm.contains("dead.xo")) == false
  expect(asm.contains("Lxo_t_loc2:")) == true
  expect(asm.contains("Lxo_t_str0:\n\t.quad 0")) == true
  expect(msg) == "hollowed 3 functions and dropped 1 data objects of 10, 111 bytes of assembly"
}

test "nothing unreached leaves the assembly as it is" {
  let src = "\t.section __TEXT,__text,regular,pure_instructions\n_main:\n\tret\n"
  let (parts, msg) = hollow_unreached([src])
  expect(parts[0]) == src
  expect(msg) == ""
}

test "on ELF an unreached export and its data go, as on Mach-O" {
  let asm = [
    "\t.text",
    "\t.p2align 2",
    "\t.globl main",
    "\t.type main, %function",
    "main:",
    "\tbl xo_f_live",
    "\tadrp x0, .Lxo_t_str0",
    "\tret",
    "\t.size main, .-main",
    "\t.p2align 2",
    "\t.hidden xo_f_live",
    "xo_f_live:",
    "\tbl memcpy",
    "\tret",
    "\t.size xo_f_live, .-xo_f_live",
    "\t.globl memcpy",
    "\t.type memcpy, %function",
    "memcpy:",
    "\tret",
    "\t.size memcpy, .-memcpy",
    "\t.p2align 2",
    "\t.globl xo_x_unused",
    "\t.type xo_x_unused, %function",
    "xo_x_unused:",
    "\tadrp x3, .Lxo_t_loc1",
    "\tb xo_f_live",
    "\t.size xo_x_unused, .-xo_x_unused",
    "\t.section .rodata.str1.1,\"aMS\",@progbits,1",
    ".Lxo_t_loc1:",
    "\t.asciz \"dead.xo:1:1\"",
    "\t.section .rodata",
    "\t.p2align 3",
    ".Lxo_t_str0:",
    "\t.quad 0",
    "",
  ].join("\n")
  let (parts, msg) = hollow_unreached_elf([asm])
  let out = parts[0]
  expect(out.contains("xo_x_unused:\n\tbrk #${HOLLOW_BRK}\n")) == true
  expect(out.contains("\t.size xo_x_unused, .-xo_x_unused")) == true
  expect(out.contains("xo_f_live:\n\tbl memcpy")) == true
  // the runtime's own memcpy (no xo_ prefix) is a function its call reaches
  expect(out.contains("memcpy:\n\tret")) == true
  expect(out.contains(".Lxo_t_loc1:")) == false
  expect(out.contains(".Lxo_t_str0:\n\t.quad 0")) == true
  expect(msg.starts_with("hollowed 1 functions and dropped 1 data objects of 6,")) == true
}
