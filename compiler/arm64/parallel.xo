// Parallel generation (bench/results/fast-builds-2026-10-13.md): the
// functions of a large module are cut into parts by their size, each
// part generated by its own emitter on a task, its string, position,
// and helper labels in a namespace of its own ("pN_"), and the parts'
// assembly joined in order. The parts depend only on the module, never
// on the number of tasks, so the assembly is the same for any number of
// jobs; a module of one part is generated as before.

use github.com/xo-lang/xo/compiler/ssa

/// A module of fewer functions than PART_FUNCS is one part. A larger one
/// is split into two groups, each keeping the functions' order: the
/// runtime's (std/native/llrt, which an edit of a program or a std
/// module never changes) and the rest, so an edit regenerates and
/// reassembles only a part of the rest (a std module test's edit
/// reassembled a part of 172 functions, 47 of them its module's, the
/// others the runtime's that the module's functions reach first;
/// 2026-10-21). Each group is cut by its contents (decision 0220 addendum): after a function whose
/// name hashes to 0 modulo PART_CUT once the part has PART_MIN functions,
/// or at PART_MAX functions, or once the part holds PART_VALUES SSA
/// values (a part of large functions: one of 120 functions held 12% of
/// a cold build of xo's emit, 2026-10-19); a short last part joins the
/// one before. An edit moves the cuts of its own part, and a value cut
/// after it up to the next name cut, so the other parts' assembly (and
/// their cached objects) stay the same; the parts never depend on the
/// number of tasks.
const PART_FUNCS = 256
const PART_MIN = 64
const PART_CUT = 128
const PART_MAX = 512
const PART_VALUES = 60000

/// A module of fewer functions than PART_SMALL is cut four times finer
/// (PART_MIN, PART_CUT, PART_MAX and PART_VALUES over 4): an edit
/// reassembles a quarter of the code. The HTTP server bench (553
/// functions) edit rebuild 620 ms to 570, its cold build alike; xo
/// itself (about 60,000) is cut as before, since 493 parts instead of 131
/// made its edit 10% and its cold build 4% slower (each part's pack read
/// and object). A tier, not a size in proportion: an added function moves
/// no cut but its own part's (2026-10-26).
const PART_SMALL = 4096
const PART_SMALL_DIV = 4

/// What one part generated: its assembly (text, helpers, call site
/// tables, data), its failure and skipped functions, and the program
/// wide code it needs.
struct Part {
  asm: Str = ""
  err: Str = ""
  dumps: List[(Str, Str)] = []
  skipped: List[Str] = []
  restorer_ref: Bool = false
  words_ref: Bool = false
  static_ref: Bool = false
  clone_ref: Bool = false
  sched_ref: Bool = false
  personality_ref: Bool = false
  /// windows/amd64's thunks (G.w64)
  w64: Map[Str, Str] = {}
  wsyms: Map[Str, Bool] = {}
  wants: List[Want] = []
  /// the per-function cache (fcache.xo): new entries, functions reused,
  /// and functions whose text differs from their entry (verify)
  stores: List[(Str, Bytes)] = []
  reused: Int = 0
  mismatches: List[Str] = []
  /// the part cache (partcache.xo): read from its entry; the entry to
  /// store; the generated part differs from its entry (verify)
  part_hit: Bool = false
  part_store: Option[(Str, Bytes)] = None
  part_diff: Bool = false
}

/// A helper a part uses, generated by the last file: op 0 rc_helper(kind,
/// t), 1 elem_helper(kind, t), 2 env_drop(fi), 3 env_share(fi), 4
/// eq_helper(t), 5 box_share(t), 6 box_drop(t), 7 mem_drop(t).
struct Want {
  op: Int
  kind: Str = ""
  t: Int = -1
  fi: Int = -1
}

/// For a part of a split generation (defer_helpers): records the helper
/// of key under its global name (helper_ext) and reports true, its body
/// left to the last file; false otherwise.
fn (var g: G) defers(key: Str, w: Want) -> Bool {
  if !g.defer_helpers {
    return false
  }
  g.helped[key] = g.helper_ext(key)
  if g.canon {
    // a function's canonical text (fcache.xo): the helpers it names,
    // wanted when the text is placed (helped is cleared per function)
    g.cwants.push((key, w))
    return true
  }
  g.wants.push(w)
  true
}

/// The global name of the helper of key in a split generation: xo_h and
/// the FNV-1a hash of the key, so every part names it alike.
fn (g: G) helper_ext(key: Str) -> Str {
  // 60 bits of it in ten base 62 digits: the name is in every call of
  // the helper (millions of lines of compiler/xo), so it is kept short
  g.sym("xo_h${base62(fnv(key), 10)}")
}

/// The FNV-1a hash of s.
fn fnv(s: Str) -> Int {
  var h = -3750763034362895579
  for c in s.bytes() {
    h = (h ^ Int(c)).wrapping_mul(1099511628211)
  }
  h
}

/// The low 60 bits of h in n base 62 digits, the lowest first.
fn base62(h: Int, n: Int) -> Str {
  let digits = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
  var v = h & 1152921504606846975
  var b = StrBuilder.new()
  for _ in 0..n {
    let d = v % 62
    b.write(digits[d..d + 1])
    v = v / 62
  }
  b.freeze()
}

/// The global label that names the helper of key in the last file of a
/// split generation, before its local label; "" otherwise. Two keys of
/// one global name fail the generation.
fn (var g: G) alias(key: Str) -> Str {
  if g.defer_helpers {
    return ""
  }
  // a local symbol named for the helper, its key (`dupp User` once
  // prof.xo demangles it; no function's name has a space, so none
  // collides with it), so profiles and the debugger name
  // the helper: the hashed global below names nothing, and without a
  // split no symbol marked the helper at all, so its samples went to the
  // function before it (2026-10-21: the 32-core server's top entry,
  // 39.7%, was xo_hf5d4IGG6wJ, User's dupp). Locals come first in the
  // symbol table, so the symbolizer takes this name at the address. Not
  // on Windows (COFF).
  var named = ""
  if g.os != "windows" {
    let rd = g.fname(key)
    let rty = if g.os == "linux" { "\t.type ${rd}, %function\n" } else { "" }
    named = "${rty}${rd}:\n"
  }
  if !g.split {
    return named
  }
  let ext = g.helper_ext(key)
  if let Some(k) = g.ext_keys.get(ext) {
    if k != key {
      g.fail("helpers `${k}` and `${key}` have one name ${ext}")
    }
  }
  g.ext_keys[ext] = key
  // a function symbol on ELF, as func_header's: without a type (and no
  // size) valgrind and perf dropped it, and profiles showed every
  // helper as ??? (Xo Lang 3, 2026-10-17)
  let ty = if g.os == "linux" { "\t.type ${ext}, %function\n" } else { "" }
  "${named}${g.hidden_global(ext)}${g.weak_def(ext)}${ty}${ext}:\n"
}

/// Generates the helper a part wanted (Want), once.
fn (var g: G) gen_want(w: Want) {
  match w.op {
    0 => {
      let _s = g.rc_helper(w.kind, w.t)
    }
    1 => {
      let _s = g.elem_helper(w.kind, w.t)
    }
    2 => {
      let _s = g.env_drop(w.fi)
    }
    3 => {
      let _s = g.env_share(w.fi)
    }
    4 => {
      let _s = g.eq_helper(w.t)
    }
    5 => {
      let _s = g.box_share(w.t)
    }
    7 => {
      let _s = g.mem_drop(w.t)
    }
    _ => {
      let _s = g.box_drop(w.t)
    }
  }
}

/// The functions of each part, in order (the groups and cuts above): the
/// rest's parts, then the runtime's; one part of every function for a
/// small module.
pub fn part_lists(m: ssa.Module) -> List[List[Int]] {
  let n = m.funcs.len()
  var all: List[Int] = []
  var rest: List[Int] = []
  var rt: List[Int] = []
  for (fi, f) in m.funcs.indexed() {
    // a std extern (decision 0388) is std's object's, not emitted here
    if m.is_extern(fi) {
      continue
    }
    all.push(fi)
    if f.file.starts_with("native/llrt/") {
      rt.push(fi)
    } else {
      rest.push(fi)
    }
  }
  if n < PART_FUNCS {
    return [all]
  }
  let div = if n < PART_SMALL { PART_SMALL_DIV } else { 1 }
  cut_parts(m, rest, div) + cut_parts(m, rt, div)
}

/// Group fis cut into parts by contents (PART_MIN, PART_CUT, PART_MAX,
/// PART_VALUES); a short last part joins the one before.
fn cut_parts(m: ssa.Module, fis: List[Int], div: Int) -> List[List[Int]] {
  let pmin = PART_MIN / div
  let pmax = PART_MAX / div
  let pcut = PART_CUT / div
  let pvals = PART_VALUES / div
  var out: List[List[Int]] = []
  var cur: List[Int] = []
  var vals = 0
  for (i, fi) in fis.indexed() {
    cur.push(fi)
    // a function not decoded: its body facts' count (decision 0283 B)
    vals += m.value_count(fi)
    let k = cur.len()
    if i + 1 < fis.len() && ((k >= pmin && (k >= pmax || fnv(m.funcs[fi].name) % pcut == 0)) || vals >= pvals) {
      out.push(cur)
      cur = []
      vals = 0
    }
  }
  if !cur.is_empty() {
    if !out.is_empty() && cur.len() < pmin {
      let last = out.pop() ?? []
      out.push(last + cur)
    } else {
      out.push(cur)
    }
  }
  out
}

/// The label namespace of each part: "p", the hash of its first
/// function's name, and "_", so a part's labels do not depend on the
/// parts before it; a repeated one gets the part's index too.
fn part_names(m: ssa.Module, parts: List[List[Int]]) -> List[Str] {
  var seen: Map[Str, Bool] = {}
  var out: List[Str] = []
  for p in 0..parts.len() {
    var ns = "p${base62(fnv(m.funcs[parts[p][0]].name), 6)}_"
    if let Some(_) = seen.get(ns) {
      ns = "${ns}${p}_"
    }
    seen[ns] = true
    out.push(ns)
  }
  out
}

/// Generates m (after the passes and inlining) for os on up to jobs
/// tasks: the assembly generate gives for a module of one part, else
/// the parts' assembly in order, then the entry, the exports, and the
/// program wide code once.
pub fn generate_parallel(m: ssa.Module, os: Str, jobs: Int) -> Program {
  generate_cached(m, os, jobs, FnCache{})
}

/// generate_parallel with the per-function cache fc (fcache.xo): a
/// function whose key fc holds an entry for is placed from it instead of
/// generated (with fc.verify, generated and compared with it).
pub fn generate_cached(m0: ssa.Module, os: Str, jobs: Int, fc: FnCache) -> Program {
  var m = m0
  var plist = part_lists(m)
  let np = plist.len()
  if np <= 1 {
    ssa.force_lazy(m, [], jobs)
    var g = new_gen(m, os)
    return g.generate()
  }
  // the functions generated from their bodies, decoded (the inline
  // cache's hits left undecoded, decision 0283 stage B): those of a part
  // its entry does not give whose own entry the cache lacks, main (the
  // entry calls it) and the exports (their wrappers read the parameters)
  if !m.lazy.is_empty() {
    var idx: List[Int] = []
    for p in 0..np {
      let pk = part_key(fc, p)
      if !fc.verify && !pk.is_empty() && fc.part_entries.contains(pk) {
        continue
      }
      for fi in plist[p] {
        let k = if fi < fc.keys.len() { fc.keys[fi] } else { "" }
        if fc.verify || k.is_empty() || !fc.entries.contains(k) {
          idx.push(fi)
        }
      }
    }
    for (fi, f) in m.funcs.indexed() {
      if f.name == "main" || !f.export.is_empty() {
        idx.push(fi)
      }
    }
    ssa.force_lazy(m, idx, jobs)
  }
  var g = new_gen(m, os)
  g.find_addr_taken()
  let main = g.by_name.get("main") ?? -1
  if main < 0 {
    return Program{asm: "", err: "arm64 backend: no main", skipped: []}
  }
  let taken = g.addr_taken
  let names = part_names(m, plist)
  if m.std_obj {
    // std's object: the program's own functions are its object's
    // (ssa.std_func; a generic instance is emitted here too, weak, and a
    // generated function with no file, a std global's value among them)
    for p in 0..np {
      plist[p] = plist[p].filter(fn(fi: Int) -> Bool { m.funcs[fi].file.is_empty() || ssa.std_func(m.funcs[fi].name, m.funcs[fi].file) || m.funcs[fi].name.contains("[") })
    }
  }
  var parts: List[Part] = []
  let w = jobs.min(np)
  if w <= 1 {
    for p in 0..np {
      parts.push(gen_part(m, os, taken, plist[p], names[p], fc, part_key(fc, p)))
    }
  } else {
    // each task takes the next part until none is left, the largest
    // first (SSA values): a large part taken last held the whole emit
    // back (a cold build of xo: 1 part of 36 took 13.8 s of 111, and 8
    // tasks finished in 11.3 s, 3.8 times one; 2026-10-19)
    var cost: List[(Int, Int)] = []
    for p in 0..np {
      var nv = 0
      for fi in plist[p] {
        nv += m.value_count(fi)
      }
      cost.push((p, nv))
    }
    let order = cost.sort_by(fn(e) { 0 - e.1 })
    let next = Atomic[Int].new(0)
    let done = scope s {
      var ts = []
      for _ in 0..w {
        ts.push(s.spawn(fn() -> List[(Int, Part)] {
          var mine: List[(Int, Part)] = []
          while true {
            let k = next.add(1) - 1
            if k >= np {
              break
            }
            let p = order[k].0
            mine.push((p, gen_part(m, os, taken, plist[p], names[p], fc, part_key(fc, p))))
          }
          mine
        }))
      }
      var all: List[(Int, Part)] = []
      for t in ts {
        all = all + t.await
      }
      all
    }
    for _ in 0..np {
      parts.push(Part{})
    }
    for (p, part) in done {
      parts[p] = part
    }
  }
  // the last file: the entry and exports, and the program wide code the
  // parts use
  g.split = true
  if !m.std_obj {
    // std's object leaves xo_entry (it calls the program's main) to the
    // program's object (decision 0388)
    g.entry(main)
  }
  g.exports()
  var files: List[Str] = []
  var skipped: List[Str] = []
  var stores: List[(Str, Bytes)] = []
  var reused = 0
  var mismatches: List[Str] = []
  var part_stores: List[(Str, Bytes)] = []
  var parts_reused = 0
  var part_mismatches: List[Int] = []
  for (pi, part) in parts.indexed() {
    files.push(part.asm)
    stores = stores + part.stores
    reused += part.reused
    mismatches = mismatches + part.mismatches
    if part.part_hit {
      parts_reused += 1
    }
    if let Some(ps) = part.part_store {
      part_stores.push(ps)
    }
    if part.part_diff {
      part_mismatches.push(pi)
    }
    g.dumps = g.dumps + part.dumps
    if g.err.is_empty() && !part.err.is_empty() {
      g.err = part.err
    }
    skipped = skipped + part.skipped
    g.restorer_ref = g.restorer_ref || part.restorer_ref
    g.words_ref = g.words_ref || part.words_ref
    g.static_ref = g.static_ref || part.static_ref
    g.clone_ref = g.clone_ref || part.clone_ref
    g.sched_ref = g.sched_ref || part.sched_ref
    g.personality_ref = g.personality_ref || part.personality_ref
    for (k, sig) in part.w64 {
      g.w64[k] = sig
    }
    for (k, _) in part.wsyms {
      g.wsyms[k] = true
    }
    // the helpers the part named, each generated once
    for w in part.wants {
      g.gen_want(w)
    }
  }
  var out: List[Str] = []
  g.file_header(out)
  out.push(g.section("text"))
  out.push(g.text.join(""))
  out.push(g.helpers.join(""))
  g.trampolines(out)
  out.push(g.lsdas.join(""))
  out.push(g.debug_sections(g.static_ref))
  g.shared_code(out)
  g.data(out)
  if m.async_preempt {
    out.push(g.unsafe_parts(if m.std_store { [] } else { names }))
  }
  g.end_data(out)
  files.push(out.join(""))
  // the module's own symbols are not weak (weak_ref), each file on a
  // task (a serial pass over xo's 1.1 GB was 0.3 s of an edit build)
  // and windows' calls retargeted (win_text) on the same tasks
  let own = drop_weak_all(g.own_exports(), g.os, files, jobs, g.win_map())
  // with parts, no whole text (Program.text joins them when wanted)
  Program{asm: if own.len() > 1 { "" } else { own.join("") }, err: g.err, skipped: skipped + g.skipped, dumps: g.dumps, parts: own, stores: stores, reused: reused, mismatches: mismatches, part_stores: part_stores, parts_reused: parts_reused, part_mismatches: part_mismatches}
}

/// The part cache's key of part p, "" for none.
fn part_key(fc: FnCache, p: Int) -> Str {
  if p < fc.part_keys.len() { fc.part_keys[p] } else { "" }
}

/// Part fis (functions of m, in order) by an emitter of its own, its labels in
/// namespace ns and its functions numbered from 0, as a file of its own.
/// With pkey (partcache.xo), the part is read from its entry when the
/// cache holds one (not with verify), else generated and encoded for it.
fn gen_part(m: ssa.Module, os: Str, taken: Map[Str, Bool], fis: List[Int], ns: Str, fc: FnCache, pkey: Str) -> Part {
  var g = new_gen(m, os)
  let pentry = if pkey.is_empty() { None } else { fc.part_entries.get(pkey) }
  if !fc.verify {
    if let Some(e) = pentry {
      if let Some(p0) = decode_part(g, e) {
        var p = p0
        p.part_hit = true
        // its functions, each as if placed from its entry
        p.reused = fis.len()
        return p
      }
    }
  }
  g.addr_taken = taken
  g.ns = ns
  g.split = true
  g.defer_helpers = true
  var stores: List[(Str, Bytes)] = []
  var reused = 0
  var mismatches: List[Str] = []
  if fc.keys.is_empty() {
    for fi in fis {
      g.function(fi)
    }
  } else {
    g.canon = true
    for fi in fis {
      let key = fc.keys[fi]
      let entry = if key.is_empty() { None } else { fc.entries.get(key) }
      if !fc.verify {
        if let Some(e) = entry {
          if let Some((r, nws)) = decode_rec(e) {
            let (ws, ok) = g.resolve_wants(nws)
            if ok {
              // what function(fi) would do: the next number, the text
              g.nfunc += 1
              g.place_text(r, ws)
              reused += 1
              continue
            }
          }
        }
      }
      let s0 = g.skipped.len()
      let (r, ws) = g.canon_function(fi)
      g.place_text(r, ws)
      if key.is_empty() || g.skipped.len() != s0 || !g.err.is_empty() {
        continue
      }
      let (nws, ok) = g.name_wants(ws)
      if !ok {
        continue
      }
      let enc = encode_rec(r, nws)
      match entry {
        Some(e) => {
          if e != enc {
            mismatches.push(m.funcs[fi].name)
          }
        }
        None => stores.push((key, enc))
      }
    }
    g.canon = false
  }
  var out: List[Str] = []
  g.file_header(out)
  out.push(g.section("text"))
  let text = g.text.join("")
  // decision 0318: the functions' text between two labels, and its unsafe
  // ranges' table
  let (ubase, uend, utbl) = if m.async_preempt && m.std_store { ("", "", g.unsafe_fn_tables(text)) } else if m.async_preempt { g.unsafe_table(text, ns) } else { ("", "", "") }
  out.push(ubase)
  out.push(text)
  out.push(uend)
  out.push(g.lsdas.join(""))
  out.push(g.debug_sections(false))
  g.data(out)
  out.push(utbl)
  if os == "linux" {
    out.push("\t.section .note.GNU-stack,\"\",@progbits\n")
  }
  var part = Part{asm: out.join(""), err: g.err, dumps: g.dumps, skipped: g.skipped, restorer_ref: g.restorer_ref, words_ref: g.words_ref, static_ref: g.static_ref, clone_ref: g.clone_ref, sched_ref: g.sched_ref, personality_ref: g.personality_ref, w64: g.w64, wsyms: g.wsyms, wants: g.wants, stores: stores, reused: reused, mismatches: mismatches}
  if !pkey.is_empty() {
    if let Some(enc) = encode_part(g, part) {
      match pentry {
        Some(e) => part.part_diff = e != enc
        None => part.part_store = Some((pkey, enc))
      }
    }
  }
  part
}

/// drop_weak_in over each of files, on up to jobs tasks, in order.
fn drop_weak_all(own: Map[Str, Bool], os: Str, files: List[Str], jobs: Int, win: Map[Str, Str]) -> List[Str] {
  let n = files.len()
  if (own.is_empty() && win.is_empty()) || jobs <= 1 || n < 2 {
    var out: List[Str] = []
    for f in files {
      out.push(win_retarget_both(drop_weak_in(own, os, f), win))
    }
    return out
  }
  let next = Atomic[Int].new(0)
  let done = scope s {
    var ts = []
    for _ in 0..jobs.min(n) {
      ts.push(s.spawn(fn() -> List[(Int, Str)] {
        var mine: List[(Int, Str)] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          mine.push((i, win_retarget_both(drop_weak_in(own, os, files[i]), win)))
        }
        mine
      }))
    }
    var all: List[(Int, Str)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[Str] = []
  for (_, f) in done.sort_by(fn(x) { x.0 }) {
    out.push(f)
  }
  out
}
