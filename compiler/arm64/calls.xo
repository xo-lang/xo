// Reference counting inline, lists, and calls (internal/arm64 isel.go,
// second half).

use github.com/xo-lang/xo/compiler/ssa

// ---------------------------------------------------------------------------
// Reference counting

/// Retains the counted cell p inline: a thread local count (bit 63
/// clear) goes up by one; a shared count (bits 63 and 62 set) is updated
/// atomically in a cold block; the immortal count is left alone
/// (decision 0058).
/// rt.rs_push_byte's and rt.rs_push_word's fast path inline (obj.xo
/// rs_push_byte, rs_push_word: a string object a of length an, held only
/// here and with room, takes the byte, or the word's 8 bytes of which n
/// count, in place): the count is 1 and the capacity (word 1) has 1 (8)
/// bytes past an, so the byte (word) goes at a + 16 + an and the length
/// is an + 1 (n); else the call (a shared, immortal, or full string).
/// Seven or eight instructions instead of a call (2026-10-17:
/// obj_rs_push_byte and obj_rs_push_word were 65K instructions a TLS
/// handshake on arm64; LLVM inlines them).
/// Whether the SSA block being selected is in a loop (push_fast's
/// condition).
fn (g: G) push_loops() -> Bool {
  g.cur_sb >= 0 && in_loop(g.f, g.cur_sb)
}

fn (var g: G) push_fast(v: Int, word: Bool) {
  let x = g.f.values[v]
  let ws = g.words(x.args[0])
  let a = g.real(ws[0])
  let an = g.real(ws[1])
  let b = g.word(x.args[1])
  let rp = g.new_vreg(false)
  let rn = g.new_vreg(false)
  let c = g.def1(false, "ldr $d0, [$u0]", [a])
  let before = g.m_()
  let slow = g.new_block(true)
  let room = g.new_block(false)
  let fast = g.new_block(false)
  let cont = g.new_block(false)
  let _b = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, #1", us: [c], cond: "ne", targets: [slow, room]})
  g.cur = room
  let cap = g.def1(false, "ldr $d0, [$u0, #8]", [a])
  if word {
    // 8 bytes of room: an + 8 above the capacity is the slow path
    let end = g.def1(false, "add $d0, $u0, #8", [an])
    let _b2 = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, $u1", us: [end, cap], cond: "hi", targets: [slow, fast]})
  } else {
    let _b2 = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, $u1", us: [an, cap], cond: "hs", targets: [slow, fast]})
  }
  g.cur = fast
  let at = g.def1(false, "add $d0, $u0, $u1", [a, an])
  var n1 = 0
  if word {
    g.store("str $u0, [$u1, #16]", [b, at])
    n1 = g.def1(false, "add $d0, $u0, $u1", [an, g.word(x.args[2])])
  } else {
    g.store("strb $wu0, [$u1, #16]", [b, at])
    n1 = g.def1(false, "add $d0, $u0, #1", [an])
  }
  g.pmove([rp, rn], regs([a, n1]))
  let _j = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = slow
  var args = [rsrc(a), rsrc(an), rsrc(b)]
  if word {
    args.push(rsrc(g.word(x.args[2])))
  }
  let o = g.rt(if word { "xo_x_obj_rs_push_word" } else { "xo_x_obj_rs_push_byte" }, args + [framesrc()], [false])
  let n = g.def1(false, "ldr $d0, [sp, #$OUT]", [])
  g.pmove([rp, rn], regs([o[0], n]))
  let _j2 = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = cont
  g.inherit(before)
  g.clobber()
  g.set(v, [rp, rn])
}

fn (var g: G) inc(p0: Int) {
  let p = g.real(p0)
  let c = g.def1(false, "ldr $d0, [$u0]", [p])
  let before = g.m_()
  let shared = g.new_block(true)
  let fast = g.new_block(false)
  let cont = g.new_block(false)
  let _b = g.add(Inst{kind: K_CONDBR, cond: "tbnz", bit: 63, us: [c], targets: [shared, fast]})
  g.cur = fast
  let c1 = g.def1(false, "add $d0, $u0, #1", [c])
  g.store("str $u0, [$u1]", [c1, p])
  let _j = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = shared
  let atomic = g.new_block(true)
  let _t = g.add(Inst{kind: K_CONDBR, cond: "tbz", bit: 62, us: [c], targets: [cont, atomic]})
  g.cur = atomic
  // x16 may hold a reloaded p: x17 and w15 are free scratch
  let _a = g.add(Inst{kind: K_PLAIN, text: g.atomic_inc("$u0", "x17", "w15"), us: [p], clobbers: [15]})
  let _j2 = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = cont
  g.inherit(before)
  g.clobber()
}

fn (var g: G) retain(t: Int, ws: List[Int]) {
  match g.kind(t) {
    Str | List | Box | Handle => g.inc(g.real(ws[0]))
    Func => g.retain_func(ws)
    _ => {
      if !g.heap(t) {
        return
      }
      let h = g.rc_helper("dup", t)
      let args = regs(g.to_int(ws, g.layout(t)))
      let _r = g.call(h, args, [])
    }
  }
}

fn (var g: G) release(t: Int, ws: List[Int]) {
  if !g.heap(t) {
    return
  }
  match g.kind(t) {
    Str | List | Handle => {
      let h = g.rc_helper("drop", t)
      let _r = g.call(h, regs([ws[0]]), [])
    }
    Box => g.release_box(t, g.real(ws[0]))
    Func => g.release_func(ws)
    _ => {
      let h = g.rc_helper("drop", t)
      let args = regs(g.to_int(ws, g.layout(t)))
      let _r = g.call(h, args, [])
    }
  }
}

/// Makes a list unique: the same list when its count is 1, otherwise a
/// copy (and the original loses a reference).
fn (var g: G) reuse(v: Int) {
  let x = g.arg(v, 0)
  if ssa.proved_reuse(g.f.values[v].aux) {
    // decision 0322: every call passes this list unique
    g.set(v, g.words(x))
    return
  }
  if g.vkind(x) != ssa.Kind.List {
    g.fail("reuse of `${g.tname(g.vty(x))}`")
    g.set(v, g.words(x))
    return
  }
  let et = g.m.types[g.vty(x)].elems[0]
  let l = g.word(x)
  let r = g.new_vreg(false)
  let c = g.def1(false, "ldr $d0, [$u0]", [l])
  let before = g.m_()
  let slow = g.new_block(true)
  let fast = g.new_block(false)
  let cont = g.new_block(false)
  let _b = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, #1", us: [c], cond: "ne", targets: [slow, fast]})
  g.cur = fast
  g.pmove([r], regs([l]))
  let _j = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = slow
  // a copy, or the same list when it is shared but only held here
  let es = g.esize(et)
  let dup = g.elem_fn("dup", et)
  let drop = g.elem_fn("drop", et)
  if ssa.checked_reuse(g.f.values[v].aux) {
    // XO_RC_CHECK=1: decision 0322 proved this list unique
    let _n = g.rt("xo_x_obj_rl_not_unique", [rsrc(l)], [])
  }
  let cp = g.rt("xo_x_obj_rl_copy_n", [rsrc(l), isrc(es), dup, drop], [false])
  g.pmove([r], regs([cp[0]]))
  let _j2 = g.add(Inst{kind: K_JUMP, targets: [cont]})
  g.cur = cont
  g.inherit(before)
  g.clobber()
  g.set(v, [r])
}

/// The runtime callback that retains or releases a list element through
/// a pointer (zero when elements are not on the heap).
fn (var g: G) elem_fn(kind: Str, t: Int) -> Src {
  if !g.heap(t) {
    return isrc(0)
  }
  symsrc(g.elem_helper(kind, t))
}

// ---------------------------------------------------------------------------
// Lists

/// {rc, len, cap}
const LIST_HDR = 24

/// The base register and immediate of an rt.mem_load or rt.mem_store of
/// width w at base + off, off being i + c (c the scaled immediate) or i,
/// when base + i serves two or more accesses of the SSA block (addr_uses):
/// base + i is one add (addr_base), and each access its immediate, where
/// [base, t] needs t = i + c an add each (copy_words: 18 instructions a
/// 32 bytes, now 2 ldp, 2 stp after pair_mem). None leaves the access
/// as it was (x86 has [base + i + c] itself), and so does an i that every
/// access uses with no immediate: [base, i] is the access's own addressing
/// (ML-KEM's ntt: an add per butterfly load and store, 15 instructions a
/// butterfly against LLVM's 13).
fn (var g: G) addr_fold(base: Int, off: Int, w: Int) -> (Int, Int)? {
  if g.x86 || g.cur_sb < 0 {
    return None
  }
  var i = off
  var c = 0
  if let Some((i1, c1)) = g.x86_disp(off) {
    if !raw_imm_off(c1, w) {
      return None
    }
    i = i1
    c = c1
  }
  let (_, ic) = g.const_int(i)
  if ic {
    return None
  }
  let (n, imm) = g.addr_uses(base, i)
  if n < 2 || !imm {
    return None
  }
  Some((g.addr_base(base, i), c))
}

/// The rt.mem_load and rt.mem_store calls of the SSA block being
/// selected at base + i or base + i + c (c a constant), up to 2 once one
/// has a c, and whether one has.
fn (var g: G) addr_uses(base: Int, i: Int) -> (Int, Bool) {
  var n = 0
  var imm = false
  for u in g.f.blocks[g.cur_sb].instrs {
    let y = g.f.values[u]
    if y.op != ssa.Op.Call || y.args.len() < 3 || y.args[0] != base {
      continue
    }
    let name = aux_str(y.aux)
    if name != "rt.mem_load" && name != "rt.mem_store" {
      continue
    }
    let off = y.args[1]
    let (j, c) = match g.x86_disp(off) {
      Some((j1, c1)) => (j1, c1)
      None => (off, 0)
    }
    if j == i {
      n += 1
      imm = imm || c != 0
      if n >= 2 && imm {
        return (n, imm)
      }
    }
  }
  (n, imm)
}

/// A register holding base + i, made once a block (addr_fold).
fn (var g: G) addr_base(base: Int, i: Int) -> Int {
  let _mi = g.m_()
  if let Some(p) = g.cm.addrs.get((base, i)) {
    return p
  }
  let p = g.def1(false, "add $d0, $u0, $u1", [g.real(g.word(base)), g.real(g.word(i))])
  let _mi2 = g.m_()
  g.cm.addrs[(base, i)] = p
  p
}

/// A register b such that element i of list l starts at b + LIST_HDR.
fn (var g: G) elem_base(l: Int, i: Int, es: Int) -> Int {
  let _mi = g.m_()
  if let Some(b) = g.cm.bases.get((l, i, es)) {
    return b
  }
  let (b0, ok) = g.offset_base(l, i, es)
  var b = b0
  if !ok {
    b = g.elem_base1(l, i, es)
  }
  let _mi2 = g.m_()
  g.cm.bases[(l, i, es)] = b
  b
}

fn (var g: G) elem_base1(l: Int, i: Int, es: Int) -> Int {
  if es == 0 {
    return l
  }
  if es == 1 {
    return g.def1(false, "add $d0, $u0, $u1", [l, i])
  }
  if es & (es - 1) == 0 {
    let (k, _) = pow2c(es)
    return g.def1(false, "add $d0, $u0, $u1, lsl #${k}", [l, i])
  }
  for (sh, k) in [(1, 3), (2, 5), (3, 9)] {
    if es == 8 * k {
      // i*(2^sh + 1), then *8 in the address add
      let t = g.def1(false, "add $d0, $u0, $u0, lsl #${sh}", [i])
      return g.def1(false, "add $d0, $u0, $u1, lsl #3", [l, t])
    }
  }
  let n = g.cimm(es)
  g.def1(false, "madd $d0, $u0, $u1, $u2", [i, n, l])
}

/// The address of a list element (isel.go elemAt): [base, #off] (idx
/// 0, off counting the list header), or [base, idx, lsl #sh] for an
/// element of one word (base the list's data address, its first
/// element).
struct ElemAt {
  base: Int
  idx: Int = 0
  off: Int = 0
  sh: Int = 0
}

/// The element address b + LIST_HDR.
fn at_base(b: Int) -> ElemAt {
  ElemAt{base: b, off: LIST_HDR}
}

/// The registers of address a.
fn at_regs(a: ElemAt) -> List[Int] {
  if a.idx != 0 {
    return [a.base, a.idx]
  }
  [a.base]
}

/// The memory operand of word k of address a, its registers $u<u> on.
fn at_operand(a: ElemAt, k: Int, u: Int) -> Str {
  if a.idx != 0 {
    if a.sh == 0 {
      return "[$u${u}, $u${u + 1}]"
    }
    return "[$u${u}, $u${u + 1}, lsl #${a.sh}]"
  }
  "[$u${u}, #${a.off + 8 * k}]"
}

/// What loaded records for word k of address a.
fn at_mem(a: ElemAt, k: Int, epoch: Int) -> MemAt {
  if a.idx != 0 {
    return MemAt{base: a.base, off: 0, epoch: epoch, idx: a.idx}
  }
  MemAt{base: a.base, off: a.off + 8 * k, epoch: epoch}
}

/// The address of element i (SSA value iv, or -1) of list l (isel.go
/// elemAddr, decision 0208): [l, #24 + k * size] for a constant index k,
/// [b, #24 + c * size] for i = a + c (b the address of element a), [data,
/// i, lsl #3] for a one word element (data the list's data address, once
/// per block, or once per loop when the loop cannot move the buffer:
/// lsr.xo), else [b, #24] with b = l + i * size.
fn (var g: G) elem_addr(l: Int, i: Int, iv: Int, et: Int) -> ElemAt {
  let es = g.esize(et)
  if es == 0 {
    return at_base(g.elem_base(l, i, es))
  }
  let _mi = g.m_()
  if let Some(b) = g.cm.bases.get((l, i, es)) {
    return at_base(b)
  }
  let nw = g.layout(et).len()
  let is_bool = g.kind(et) == ssa.Kind.Bool
  if iv >= 0 {
    let (k, kc) = g.const_int(iv)
    if kc && k >= 0 && k < 4096 {
      let off = LIST_HDR + k * es
      if fits_off(off, is_bool, nw) {
        return ElemAt{base: l, off: off}
      }
    }
  }
  let o = g.offs.get(i) ?? Offset{a: -1, c: 0}
  if o.a >= 0 && o.c > -4096 && o.c < 4096 && es < 4096 {
    let off = LIST_HDR + o.c * es
    if fits_off(off, is_bool, nw) {
      return ElemAt{base: g.elem_base(l, o.a, es), off: off}
    }
  }
  if iv >= 0 && (g.off_bases.get(iv) ?? false) {
    return at_base(g.elem_base(l, i, es))
  }
  if is_bool {
    return ElemAt{base: g.data_addr(l), idx: i}
  }
  if es == 8 {
    return ElemAt{base: g.data_addr(l), idx: i, sh: 3}
  }
  at_base(g.elem_base(l, i, es))
}

/// Whether the element words at offset off (the header counted) are in
/// reach of one load's immediate.
fn fits_off(off: Int, is_bool: Bool, nw: Int) -> Bool {
  if is_bool {
    return off >= 0 && off <= 4095
  }
  off >= 0 && off % 8 == 0 && off + 8 * (nw - 1) <= 32760
}

/// The address of the first element of list l, once per block (isel.go
/// dataAddr).
fn (var g: G) data_addr(l: Int) -> Int {
  let _mi = g.m_()
  if let Some(d) = g.cm.bases.get((l, 0, -24)) {
    return d
  }
  let d = g.def1(false, "add $d0, $u0, #${LIST_HDR}", [l])
  let _mj = g.m_()
  g.cm.bases[(l, 0, -24)] = d
  d
}

/// Loads the element words at a (as integer registers when as_int).
fn (var g: G) load_elem(a: ElemAt, et: Int, as_int: Bool) -> List[Int] {
  if g.kind(et) == ssa.Kind.Bool {
    let d = g.def1(false, "ldrb $wd0, ${at_operand(a, 0, 0)}", at_regs(a))
    let _mi = g.m_()
    g.cm.loaded[d] = at_mem(a, 0, g.cm.epoch)
    return [d]
  }
  var out: List[Int] = []
  for (k, fp) in g.layout(et).indexed() {
    let d = g.def1(fp && !as_int, "ldr $d0, ${at_operand(a, k, 0)}", at_regs(a))
    let _mi = g.m_()
    g.cm.loaded[d] = at_mem(a, k, g.cm.epoch)
    out.push(d)
  }
  out
}

/// The words of a value to store: a zero constant is xzr.
fn (var g: G) store_words(v: Int) -> List[Int] {
  let x = g.f.values[v]
  if x.op == ssa.Op.Const {
    match x.aux {
      I(n) => {
        if n == 0 {
          return [0]
        }
      }
      B(b) => {
        if !b {
          return [0]
        }
      }
      _ => {}
    }
  }
  g.words(v)
}

fn (var g: G) store_elem(a: ElemAt, et: Int, ws: List[Int]) {
  let _mi = g.m_()
  if g.kind(et) == ssa.Kind.Bool {
    if !g.same_loaded(ws[0], at_mem(a, 0, g.cm.epoch)) {
      g.store("strb $wu0, ${at_operand(a, 0, 1)}", [ws[0]] + at_regs(a))
    }
    return
  }
  let lay = g.layout(et)
  var skip: List[Bool] = []
  for k in 0..lay.len() {
    let _mk = g.m_()
    skip.push(g.same_loaded(ws[k], at_mem(a, k, g.cm.epoch)))
  }
  for k in 0..lay.len() {
    if !skip[k] {
      g.store("str $u0, ${at_operand(a, k, 1)}", [ws[k]] + at_regs(a))
    }
  }
}

/// Writes the placeholder list.take leaves in the element at a (decision
/// 0169; storeHole): the words reference counting reads, so that retain,
/// release, and share of it do nothing. A Str, List, Box, or handle
/// points to the empty string's object (immortal), a function value's
/// environment is null, and an enum's tag is past its variants.
fn (var g: G) store_hole(a: ElemAt, et: Int) {
  var ls: List[Leaf] = []
  g.heap_leaves(et, 0, ls)
  var obj = 0
  for l in ls {
    var w = 0
    var off = l.off
    match g.kind(l.t) {
      Func => off += 1
      Enum => w = g.cimm(g.m.types[l.t].variants.len())
      _ => {
        if obj == 0 {
          obj = g.sym_addr(g.str_obj("".bytes()))
        }
        w = obj
      }
    }
    g.store("str $u0, ${at_operand(a, off, 1)}", [w] + at_regs(a))
  }
}

/// Whether register w holds the word want says, loaded since the last
/// store or call (the current memo).
fn (g: G) same_loaded(w: Int, want: MemAt) -> Bool {
  if let Some(at) = g.cm.loaded.get(w) {
    return at.base == want.base && at.off == want.off && at.epoch == want.epoch && at.idx == want.idx
  }
  false
}

fn (var g: G) list_len(l: Int) -> Int {
  let _mi = g.m_()
  if let Some(n) = g.cm.lens.get(l) {
    return n
  }
  let n = g.def1(false, "ldr $d0, [$u0, #8]", [l])
  let _mj = g.m_()
  g.cm.lens[l] = n
  if let Some(a) = g.cm.len_at.get(l) {
    g.same_facts(a, n)
  }
  n
}

/// Gives register n the facts of register a, which holds the same value
/// (isel.go sameFacts, decision 0208).
fn (var g: G) same_facts(a: Int, n: Int) {
  let _mi = g.m_()
  if let Some(x) = g.cm.lo.get(a) {
    g.cm.lo[n] = x
  }
  if let Some(x) = g.cm.hi.get(a) {
    g.cm.hi[n] = x
  }
  if let Some(x) = g.cm.low_zero.get(a) {
    g.cm.low_zero[n] = x
  }
  var ks: List[((Int, Int), Int)] = []
  for (k, v) in g.cm.less {
    if k.1 == a {
      ks.push((k, v))
    }
  }
  for (k, v) in ks {
    g.cm.less[(k.0, n)] = v
  }
}

/// Whether Str and Bytes values may be views (decision 0330 step 3): the
/// second word is then len | (off << 32) and the data starts off bytes into
/// the object's bytes. Off until slicing makes views, so the code below that
/// reads the offset and masks the length is not emitted and the output is
/// unchanged. On since step 3: `s[lo..hi]` is rt.str_view.
const STR_VIEWS: Bool = true

/// The data address of the Str or Bytes value whose words are ws (decision
/// 0330): the object's bytes, plus the offset of a view. Every emitter site
/// that wants a string's bytes goes through this one function, so the layout
/// is read in one place.
fn (var g: G) str_data(ws: List[Int]) -> Int {
  if STR_VIEWS {
    return g.str_base(ws)
  }
  g.def1(false, "add $d0, $u0, #16", [g.real(ws[0])])
}

/// The object pointer plus a view's offset (STR_VIEWS only): the address the
/// object's bytes start at less the header.
fn (var g: G) str_obj_at(ws: List[Int]) -> Int {
  let obj = g.real(ws[0])
  let w1 = g.real(ws[1])
  if g.x86 {
    let off = g.def1(false, "lsr $d0, $u0, #32", [w1])
    return g.def1(false, "add $d0, $u0, $u1", [obj, off])
  }
  g.def1(false, "add $d0, $u0, $u1, lsr #32", [obj, w1])
}

/// str_data once per block for a value (STR_VIEWS only): the memo is the
/// one bytes_load keeps.
fn (var g: G) str_base(ws: List[Int]) -> Int {
  let obj = g.real(ws[0])
  if !STR_VIEWS {
    let _mi = g.m_()
    if let Some(x) = g.cm.bases.get((obj, 0, -16)) {
      return x
    }
    let d = g.def1(false, "add $d0, $u0, #16", [obj])
    let _mj = g.m_()
    g.cm.bases[(obj, 0, -16)] = d
    return d
  }
  let w1 = g.real(ws[1])
  let _mi = g.m_()
  if let Some(x) = g.cm.bases.get((obj, w1, -16)) {
    return x
  }
  if let Some(k) = g.kvals.get(w1) {
    // a constant's second word (a literal: its view offset known, 0 for
    // a whole object): the header and the offset in one add (2026-10-23:
    // a constant table's word was a move, a shift, and two adds on
    // x86_64 for every read, num.xo pow10_hi in json enc_floats)
    let off = k.shr_logical(32)
    if off >= 0 && off < 4080 {
      let d0 = g.def1(false, "add $d0, $u0, #${16 + off}", [obj])
      let _mk = g.m_()
      g.cm.bases[(obj, w1, -16)] = d0
      return d0
    }
  }
  var s = 0
  if g.x86 {
    let off = g.def1(false, "lsr $d0, $u0, #32", [w1])
    s = g.def1(false, "add $d0, $u0, $u1", [obj, off])
  } else {
    s = g.def1(false, "add $d0, $u0, $u1, lsr #32", [obj, w1])
  }
  let d = g.def1(false, "add $d0, $u0, #16", [s])
  let _mj = g.m_()
  g.cm.bases[(obj, w1, -16)] = d
  d
}

/// The length of the Str or Bytes value whose words are ws (decision 0330):
/// the second word, or its low half once values may be views (a 32 bit move,
/// which x86 retargets to movl, zero extending too). Every emitter site that
/// does arithmetic on a length, or hands it to C, goes through here; calls
/// into obj.xo pass the word as it is and the runtime masks it. The mask is
/// made once per block for a word, so Str.len and an index check on the same
/// value share one register and their facts (less_fact, proved_index) link.
fn (var g: G) str_len(ws: List[Int]) -> Int {
  if !STR_VIEWS {
    return ws[1]
  }
  let w1 = g.real(ws[1])
  let _mi = g.m_()
  if let Some(x) = g.cm.bases.get((w1, 0, -18)) {
    return x
  }
  let n = g.def1(false, "mov $wd0, $wu0", [w1])
  let _mj = g.m_()
  g.cm.bases[(w1, 0, -18)] = n
  n
}

/// Loads byte i (SSA value iv, register i) of the Bytes object in
/// register obj0; the data address, and data + j for i = j + c (0 < c <
/// 4096), are computed once per block (isel.go bytesLoad, decision 0184).
fn (var g: G) bytes_load(ws: List[Int], iv: Int, i: Int) -> Int {
  let d = g.str_base(ws)
  let x = g.f.values[iv]
  if x.op == ssa.Op.Add {
    let (c, is_k) = g.const_int(x.args[1])
    let j = x.args[0]
    if is_k && c > 0 && c < 4096 && g.has_val[j] && g.vals[j].len() == 1 && g.vals[j][0] != 0 {
      let jw = g.vals[j][0]
      let _mk = g.m_()
      var t = 0
      if let Some(y) = g.cm.bases.get((d, jw, -17)) {
        t = y
      } else {
        t = g.def1(false, "add $d0, $u0, $u1", [d, jw])
        let _ml = g.m_()
        g.cm.bases[(d, jw, -17)] = t
      }
      return g.def1(false, "ldrb $wd0, [$u0, #${c}]", [t])
    }
  }
  g.def1(false, "ldrb $wd0, [$u0, $u1]", [d, i])
}

fn (var g: G) bounds_check(v: Int, l: Int, i: Int) {
  let pos = g.f.values[v].pos
  if pos.is_empty() {
    return
  }
  let _mi = g.m_()
  if g.cm.checked.contains((l, i)) {
    return
  }
  g.cm.checked[(l, i)] = true
  let n = g.list_len(l)
  let iv = g.arg(v, 1)
  // decision 0257: a branch on idx < len in a dominating block, which
  // the per block memo does not carry into a loop
  let x = g.f.values[v]
  if !g.proved_index(iv, n, -1) && !g.proof.proven(g.f, x.block, x.args[1], x.args[0]) {
    let lb = g.loc_label(pos)
    g.check("cmp $u0, $u1", [i, n], "hs", "xo_fault_index", [rsrc(i), rsrc(n), symsrc(lb)])
  }
  g.index_facts(i)
  g.less_fact(iv, n)
}

/// Option words on two paths: in the current block when cond holds (the
/// payload some_pay, or the element of list l at i when some_elem), else
/// None. extra registers are set on both paths too: from some_extra and
/// from none_extra.
fn (var g: G) option(ot: Int, text: Str, us: List[Int], cond: Str, extra: List[Int], some: OptSome, none_extra: List[Src]) -> List[Int] {
  let si = g.m.variant_index(ot, "Some")
  let ni = g.m.variant_index(ot, "None")
  var ws: List[Int] = []
  for _ in 0..g.nwords(ot) {
    ws.push(g.new_vreg(false))
  }
  let before = g.m_()
  let yes = g.new_block(false)
  let no = g.new_block(false)
  let join = g.new_block(false)
  let _b = g.add(Inst{kind: K_CONDBR, text: text, us: us, cond: cond, targets: [yes, no]})
  g.cur = yes
  var pay: List[Int] = []
  var yes_extra: List[Src] = []
  match some {
    Get(l, i, iv, et) => pay = g.load_elem(g.elem_addr(l, i, iv, et), et, true)
    Pop(l, n, et) => {
      let n1 = g.def1(false, "sub $d0, $u0, #1", [n])
      g.store("str $u0, [$u1, #8]", [n1, l])
      pay = g.load_elem(at_base(g.elem_base(l, n1, g.esize(et))), et, true)
      yes_extra = regs([l, n1])
    }
  }
  var srcs: List[Src] = [isrc(si)]
  for k in 1..ws.len() {
    if k - 1 < pay.len() {
      srcs.push(rsrc(pay[k - 1]))
    } else {
      srcs.push(rsrc(0))
    }
  }
  g.pmove_srcs(ws + extra, srcs + yes_extra)
  let _j = g.add(Inst{kind: K_JUMP, targets: [join]})
  g.cur = no
  var nsrcs: List[Src] = [isrc(ni)]
  for _ in 1..ws.len() {
    nsrcs.push(rsrc(0))
  }
  g.pmove_srcs(ws + extra, nsrcs + none_extra)
  let _j2 = g.add(Inst{kind: K_JUMP, targets: [join]})
  g.cur = join
  g.inherit(before)
  g.clobber()
  ws
}

/// What the Some path of option loads: element i of list l (list.get),
/// or the last element of l of length n after shortening it (list.pop).
enum OptSome {
  Get(l: Int, i: Int, iv: Int, et: Int)
  Pop(l: Int, n: Int, et: Int)
}

// ---------------------------------------------------------------------------
// Calls

/// Flags the block's latest call as cold when it calls a runtime slow
/// path (ssa cold_fn; regalloc.xo cold_saves, the hoisting passes): the
/// call, not its block, which a hot loop's fallback shares with nothing
/// else to mark it.
fn (var g: G) mark_cold_call(name: Str) {
  if !ssa.cold_fn(name) {
    return
  }
  var k = g.blocks[g.cur].insts.len() - 1
  while k >= 0 {
    if g.blocks[g.cur].insts[k].kind == K_CALL {
      g.blocks[g.cur].insts[k].cold_call = true
      return
    }
    k -= 1
  }
}

fn (var g: G) call_op(v: Int) {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  if name == "rt.landing" {
    // a check only a fault takes: no code (the branch on it, decision
    // 0085)
    g.set(v, [0])
    return
  }
  // a push run (pushrun.xo): its first pushes make nothing (the next
  // push of the run reads their list only), its last pushes them all
  if name == "list.push" && g.push_skip.contains(v) {
    // no list of its own; one a landing pad between the pushes releases
    // is its input's, the same object until the run's last push grows it
    // (pushrun.xo push_alias)
    if g.push_alias.contains(v) {
      var r = x.args[0]
      while g.push_skip.contains(r) {
        r = g.f.values[r].args[0]
      }
      g.set(v, g.words(r))
    }
    return
  }
  if name == "list.push" {
    if let Some(run) = g.push_run.get(v) {
      g.push_n(v, run)
      return
    }
  }
  let ci = g.by_name.get(name) ?? -1
  if ci >= 0 && !g.by_ref_of(ci).is_empty() {
    g.by_ref_call(v, ci)
    g.mark_cold_call(name)
    return
  }
  if ci >= 0 {
    var args: List[Src] = []
    for a in x.args {
      for w in g.words(a) {
        args.push(rsrc(w))
      }
    }
    var res: List[Bool] = []
    for r in g.m.funcs[ci].results {
      for fp in g.layout(r) {
        res.push(fp)
      }
    }
    g.set(v, g.call(g.fname(name), args, res))
    g.mark_cold_call(name)
    return
  }
  if name.starts_with("rt.") {
    g.rt_call(v)
    return
  }
  match name {
    "list.new" => {
      let es = g.esize(g.m.types[x.ty].elems[0])
      if x.args.len() == 1 {
        // with room for a number of elements: std/native/llrt/obj.xo
        // rl_new_n through its export, with no C level
        let n = g.word(x.args[0])
        g.set(v, g.rt("xo_x_obj_rl_new_n", [rsrc(n), isrc(es)], [false]))
        return
      }
      // the shared empty list, immortal: the first push allocates
      // (xo_rl_grow), so a `[]` that stays empty costs no allocation
      // (bench/results/xo1-speed-2026-10-13.md)
      g.set(v, [g.sym_addr(g.sym("xo_empty_list"))])
    }
    "list.len" => g.set(v, [g.list_len(g.word(x.args[0]))])
    "list.index" => {
      let l = g.word(x.args[0])
      let i = g.word(x.args[1])
      g.bounds_check(v, l, i)
      let et = x.ty
      let base = g.elem_addr(l, i, x.args[1], et)
      if base.idx == 0 && g.elem_in_place(v) {
        // only read: its parts load from the list where used (inplace.xo)
        g.stable[v] = g.addr_at(base.base, base.off)
        return
      }
      g.set(v, g.load_elem(base, et, false))
    }
    "list.take" => {
      // element i moves out (decision 0169); its slot gets a
      // placeholder that releasing ignores until list.set stores back
      let l = g.word(x.args[0])
      let i = g.word(x.args[1])
      g.bounds_check(v, l, i)
      let et = g.m.types[x.ty].elems[1]
      let base = g.elem_addr(l, i, x.args[1], et)
      let e = g.load_elem(base, et, false)
      g.store_hole(base, et)
      g.set(v, [l] + e)
    }
    "list.get" => {
      let l = g.word(x.args[0])
      let i = g.word(x.args[1])
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      let n = g.list_len(l)
      g.set(v, g.option(x.ty, "cmp $u0, $u1", [i, n], "lo", [], OptSome.Get(l: l, i: i, iv: x.args[1], et: et), []))
    }
    "list.set" => {
      let l = g.word(x.args[0])
      let i = g.word(x.args[1])
      let et = g.vty(x.args[2])
      let w = g.store_words(x.args[2])
      g.bounds_check(v, l, i)
      let base = g.elem_addr(l, i, x.args[1], et)
      if g.heap(et) && !g.after_take(v) {
        let old = g.load_elem(base, et, false)
        g.release(et, old)
      }
      g.store_elem(base, et, w)
      g.set(v, [l])
    }
    "list.push" => {
      let l = g.word(x.args[0])
      let et = g.vty(x.args[1])
      let w = g.store_words(x.args[1])
      let n = g.list_len(l)
      let c = g.def1(false, "ldr $d0, [$u0, #16]", [l])
      let lm = g.new_vreg(false)
      let before = g.m_()
      let grow = g.new_block(true)
      let fast = g.new_block(false)
      let room = g.new_block(false)
      let _b = g.add(Inst{kind: K_CONDBR, text: "cmp $u0, $u1", us: [n, c], cond: "eq", targets: [grow, fast]})
      g.cur = fast
      g.pmove([lm], regs([l]))
      let _j = g.add(Inst{kind: K_JUMP, targets: [room]})
      g.cur = grow
      let l2 = g.rt("xo_x_obj_rl_grow_n", [rsrc(l), isrc(g.esize(et))], [false])
      g.pmove([lm], regs([l2[0]]))
      let _j2 = g.add(Inst{kind: K_JUMP, targets: [room]})
      g.cur = room
      g.inherit(before)
      g.clobber()
      if g.esize(et) > 0 {
        g.store_elem(at_base(g.elem_base(lm, n, g.esize(et))), et, w)
      }
      let n1 = g.def1(false, "add $d0, $u0, #1", [n])
      g.store("str $u0, [$u1, #8]", [n1, lm])
      let _mi = g.m_()
      g.cm.lens[lm] = n1
      g.set(v, [lm])
    }
    "log.set" => {
      // decision 0291: list.set into a borrowed list (a Map log's chunk
      // that only its Map's owner holds, maplog.xo's put fast path): the
      // old element released, the new one stored; no result
      let l = g.word(x.args[0])
      let i = g.word(x.args[1])
      let et = g.vty(x.args[2])
      let w = g.store_words(x.args[2])
      let base = g.elem_addr(l, i, x.args[1], et)
      if g.heap(et) {
        let old = g.load_elem(base, et, false)
        g.release(et, old)
      }
      g.store_elem(base, et, w)
    }
    "log.push" => {
      // decision 0291: list.push into a borrowed list with room (a Map
      // log's chunk, made with its capacity): no growth, no result
      let l = g.word(x.args[0])
      let et = g.vty(x.args[1])
      let w = g.store_words(x.args[1])
      let n = g.list_len(l)
      if g.esize(et) > 0 {
        g.store_elem(at_base(g.elem_base(l, n, g.esize(et))), et, w)
      }
      let n1 = g.def1(false, "add $d0, $u0, #1", [n])
      g.store("str $u0, [$u1, #8]", [n1, l])
      let _m = g.m_()
      // the list grew in place: its known length is the new one (a stale
      // one reaches the list's loop parameter and the next push writes
      // over the last element; the padded Map directory, 2026-10-21)
      g.cm.lens[l] = n1
      let _r = g.cm.len_at.remove(l)
    }
    "list.pop" => {
      let l = g.word(x.args[0])
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      let ot = g.m.types[x.ty].elems[1]
      let n = g.list_len(l)
      // a new register for the shorter list (what is known about l, its
      // length, must not reach blocks it dominates), and its length
      let l2 = g.new_vreg(false)
      let nl = g.new_vreg(false)
      let o = g.option(ot, "cmp $u0, #0", [n], "gt", [l2, nl], OptSome.Pop(l: l, n: n, et: et), regs([l, n]))
      let _mi = g.m_()
      g.cm.lens[l2] = nl
      g.set(v, [l2] + o)
    }
    "str.concat" => {
      let a = g.words(x.args[0])
      let b = g.words(x.args[1])
      let n = g.def1(false, "add $d0, $u0, $u1", [g.str_len(a), g.str_len(b)])
      // obj.xo's rs_append through its export, with no C level
      let obj = g.rt("xo_x_obj_rs_concat", regs([a[0], a[1], b[0], b[1]]), [false])
      g.set(v, [obj[0], n])
    }
    "str.concat_int" | "str.concat_float" => {
      let a = g.words(x.args[0])
      let b = g.words(x.args[1])
      // obj.xo and cabi.xo through their exports (the C entries stay for
      // code of earlier compilers)
      let fname = if name == "str.concat_float" { "xo_x_obj_rs_concat_float" } else { "xo_x_obj_rs_concat_int" }
      let obj = g.rt(fname, [rsrc(a[0]), rsrc(a[1]), rsrc(b[0]), framesrc()], [false])
      let n = g.def1(false, "ldr $d0, [sp, #$OUT]", [])
      g.set(v, [obj[0], n])
    }
    "str.of_int" | "str.of_float" => {
      let fname = if name == "str.of_float" { "xo_x_obj_rs_of_float" } else { "xo_x_obj_rs_of_int" }
      let a = g.words(x.args[0])
      let obj = g.rt(fname, [rsrc(a[0]), framesrc()], [false])
      let n = g.def1(false, "ldr $d0, [sp, #$OUT]", [])
      g.set(v, [obj[0], n])
    }
    "str.of_bool" => {
      let b = g.word(x.args[0])
      let t = g.sym_addr(g.str_obj("true".bytes()))
      let f = g.sym_addr(g.str_obj("false".bytes()))
      let obj = g.def1(false, "cmp $u0, #0\ncsel $d0, $u1, $u2, ne", [b, t, f])
      let four = g.imm(4)
      let five = g.imm(5)
      let n = g.def1(false, "cmp $u0, #0\ncsel $d0, $u1, $u2, ne", [b, four, five])
      g.set(v, [obj, n])
    }
    "str.eq" | "str.cmp" => {
      let a = g.words(x.args[0])
      let b = g.words(x.args[1])
      let xd = g.str_data(a)
      let yd = g.str_data(b)
      if name == "str.cmp" && g.x86 {
        // x86_64 retargets no cneg yet: the export
        g.set(v, g.rt("xo_x_obj_str_cmp", regs([xd, g.str_len(a), yd, g.str_len(b)]), [false]))
        return
      }
      if name == "str.cmp" {
        // obj.str_cmp in line: memcmp of the shorter length, then the
        // lengths; -1, 0, 1 (the export was a call into a call of
        // memcmp: maxby's Str key, 2026-10-17)
        let an = g.str_len(a)
        let bn = g.str_len(b)
        let n = g.def1(false, "cmp $u0, $u1\ncsel $d0, $u0, $u1, lt", [an, bn])
        let r = g.rt("memcmp", regs([xd, yd, n]), [false])
        let c = g.def1(false, "sxtw $d0, $wu0", [r[0]])
        let s1 = g.def1(false, "cmp $u0, #0\ncset $d0, ne\ncneg $d0, $d0, lt", [c])
        let s2 = g.def1(false, "cmp $u0, $u1\ncset $d0, ne\ncneg $d0, $d0, lt", [an, bn])
        g.set(v, [g.def1(false, "cmp $u0, #0\ncsel $d0, $u1, $u2, ne", [c, s1, s2])])
        return
      }
      let r = g.rt("xo_x_obj_str_eq", regs([xd, g.str_len(a), yd, g.str_len(b)]), [false])
      g.set(v, [g.def1(false, "cmp $wu0, #0\ncset $d0, ne", [r[0]])])
    }
    "Stdio.print" | "Stdio.println" | "Stdio.eprint" | "Stdio.eprintln" => {
      let a = g.words(x.args[1])
      let d = g.str_data(a)
      let _r = g.rt("xo_${name.trim_prefix("Stdio.")}", regs([d, g.str_len(a)]), [])
      g.set(v, [])
    }
    "Int.min" | "Int.max" => {
      let c = if name == "Int.min" { "lt" } else { "gt" }
      let a = g.word(x.args[0])
      let b = g.word(x.args[1])
      g.set(v, [g.def1(false, "cmp $u0, $u1\ncsel $d0, $u0, $u1, ${c}", [a, b])])
    }
    "Float.min" | "Float.max" => {
      // the total order, the receiver on a tie (std.md 1, decisions/0053):
      // min is `b < a ? b : a`, max `a < b ? b : a`
      var p = x.args[0]
      var q = x.args[1]
      if name == "Float.min" {
        p = x.args[1]
        q = x.args[0]
      }
      let c = g.float_order(ssa.Op.Lt, p, q)
      let ra = g.word(x.args[0])
      let rb = g.word(x.args[1])
      let n = c.us.len()
      g.set(v, [g.def1(true, "${c.text}\nfcsel $d0, $u${n + 1}, $u${n}, ${c.cond}", c.us + [ra, rb])])
    }
    "Int.abs" => {
      let a = g.word(x.args[0])
      if !x.pos.is_empty() {
        let mn = g.imm(MIN_INT)
        let lb = g.loc_label(x.pos)
        g.check("cmp $u0, $u1", [a, mn], "eq", "xo_fault_abs", [rsrc(a), symsrc(lb)])
      }
      g.set(v, [g.def1(false, "cmp $u0, #0\ncneg $d0, $u0, lt", [a])])
    }
    "Float.sqrt" | "Float.floor" | "Float.ceil" | "Float.trunc" | "Float.round" | "Float.abs" => {
      let ins = match name {
        "Float.sqrt" => "fsqrt"
        "Float.floor" => "frintm"
        "Float.ceil" => "frintp"
        "Float.trunc" => "frintz"
        "Float.round" => "frinta"
        _ => "fabs"
      }
      g.set(v, [g.def1(true, "${ins} $d0, $u0", [g.word(x.args[0])])])
    }
    "Float.is_nan" => g.set(v, [g.def1(false, "fcmp $u0, $u0\ncset $d0, vs", [g.word(x.args[0])])])
    "bytes.index" => {
      // b[i] on Bytes (decision 0081): the data is 16 bytes into the
      // string object
      let a = g.words(x.args[0])
      let i = g.word(x.args[1])
      var k = -1
      let y = g.f.values[x.args[0]]
      if y.op == ssa.Op.Const {
        if let Some(bs) = const_bytes(y.aux) {
          k = bs.len()
        }
      }
      let alen = g.str_len(a)
      if !x.pos.is_empty() && !g.proved_index(x.args[1], alen, k) {
        let lb = g.loc_label(x.pos)
        g.check("cmp $u0, $u1", [i, alen], "hs", "xo_fault_bytes_index", [rsrc(i), rsrc(alen), symsrc(lb)])
      }
      if !x.pos.is_empty() {
        // what the check (or the proof) says holds after it
        g.index_facts(i)
        g.less_fact(x.args[1], alen)
      }
      g.set(v, [g.bytes_load(a, x.args[1], i)])
    }
    "Str.len" => g.set(v, [g.str_len(g.words(x.args[0]))])
    "Str.is_empty" => g.set(v, [g.def1(false, "cmp $u0, #0\ncset $d0, eq", [g.real(g.str_len(g.words(x.args[0])))])])
    _ => {
      g.fail("runtime call `${name}`")
      g.set(v, g.zeros(x.ty))
    }
  }
}

/// rt.u64_divc(a, d, rem): a / d (a % d when rem is 1) as UInt64s, d a
/// constant in [2, 2^63) (ssa show.xo u64_div_const): where a's bounds
/// prove it is not negative, the signed division by a constant (its
/// quotient shared through Memo.quo with an Int's `a % d` of the same
/// word: portable conv's `w % 1000` and `u % 1000`), else u64_magic's
/// multiply high.
fn (var g: G) u64_divc(v: Int) -> Bool {
  let x = g.f.values[v]
  let (d, dok) = g.const_int(x.args[1])
  let (rem, rok) = g.const_int(x.args[2])
  if !dok || !rok || d < 2 {
    return false
  }
  let a = g.word(x.args[0])
  let (lo, _) = g.bounds(x.args[0])
  var q = 0
  if lo >= 0 {
    q = g.sdiv_quot(x.args[0], a, d)
  } else {
    let (form, m, pre, post) = u64_magic(d)
    if form == 0 {
      q = g.def1(false, "lsr $d0, $u0, #${post}", [a])
    } else if form == 1 {
      var y = a
      if pre > 0 {
        y = g.def1(false, "lsr $d0, $u0, #${pre}", [a])
      }
      q = g.def1(false, "umulh $d0, $u0, $u1", [y, g.cimm(m)])
      if post > 0 {
        q = g.def1(false, "lsr $d0, $u0, #${post}", [q])
      }
    } else {
      let hi = g.def1(false, "umulh $d0, $u0, $u1", [a, g.cimm(m)])
      let t = g.def1(false, "sub $d0, $u0, $u1", [a, hi])
      let h = g.def1(false, "add $d0, $u1, $u0, lsr #1", [t, hi])
      q = g.def1(false, "lsr $d0, $u0, #${post}", [h])
    }
  }
  if rem != 1 {
    g.set(v, [q])
    return true
  }
  g.set(v, [g.def1(false, "msub $d0, $u0, $u1, $u2", [q, g.cimm(d), a])])
  true
}

/// Lowers the runtime intrinsics that are an instruction or two
/// (decision 0193 step 3): rt.int_wrap with a constant op (0 +, 1 -, 2
/// *, 3 << and 4 >> logical by the amount mod 64; decision 0195: 5
/// rotate right mod 64, 6 the low 32 bits rotated right mod 32 and zero
/// extended, 7 the bytes reversed), rt.u64_mul_hi, the bits of a Float
/// both ways, and rt.bytes_word (an unchecked load of 8 bytes);
/// the scan intrinsics of decision 0201: rt.popcount (cnt and
/// addv), rt.ctz (rbit and clz), rt.clz, and rt.bytes_eq16 and
/// rt.bytes_high16 (16 bytes in v30 compared, narrowed by shrn to 4 bits
/// a byte; v30 and v31 are scratch registers of the emitter), and the
/// string writes of Bytes.to_hex: rt.rs_put_word (an unchecked store of
/// 8 bytes into a new string with room) and rt.rs_set_len (the same
/// object with a new length); whether v was one (isel.go inlineRT).
fn (var g: G) inline_rt(v: Int) -> Bool {
  let x = g.f.values[v]
  match aux_str(x.aux) {
    // in a loop only: a push outside one (a value formatted into ""
    // once) finds the string shared or immortal, and the check is four
    // instructions more before the same call (text/int_fmt 1.006x)
    "rt.rs_push_byte" if g.push_loops() => g.push_fast(v, false)
    "rt.rs_push_word" if g.f.values[v].args.len() == 3 && g.push_loops() => g.push_fast(v, true)
    "rt.u64_divc" => g.u64_divc(v)
    "rt.int_wrap" => {
      let (op, ok) = g.const_int(x.args[0])
      if !ok || op < 0 || op > 7 {
        return false
      }
      let a = g.word(x.args[1])
      if op == 7 {
        g.set(v, [g.def1(false, "rev $d0, $u0", [a])])
        return true
      }
      if op == 5 || op == 6 {
        let (k, kc) = g.const_int(x.args[2])
        if kc {
          if op == 5 {
            g.set(v, [g.def1(false, "ror $d0, $u0, #${k & 63}", [a])])
          } else {
            g.set(v, [g.def1(false, "ror $wd0, $wu0, #${k & 31}", [a])])
          }
          return true
        }
        if op == 5 {
          g.set(v, [g.def1(false, "ror $d0, $u0, $u1", [a, g.word(x.args[2])])])
        } else {
          g.set(v, [g.def1(false, "ror $wd0, $wu0, $wu1", [a, g.word(x.args[2])])])
        }
        return true
      }
      if op == 2 {
        let (text, us, ok2) = g.mul_long(x.args[1], x.args[2])
        if ok2 {
          g.set(v, [g.def1(false, text, us)])
          return true
        }
      }
      if op == 0 && g.fused_add(v) {
        return true
      }
      if op == 1 && g.fused_sub(v) {
        return true
      }
      if (op == 0 || op == 1) && g.add_with_flag(v, op) {
        return true
      }
      if (op == 0 || op == 1) && g.add_w32(v, op) {
        return true
      }
      if op == 1 {
        let (z, zc) = g.const_int(x.args[1])
        if zc && z == 0 {
          // 0 - b: neg (ct.mask_bit's mask; no mov of 0, 2026-10-16)
          g.set(v, [g.def1(false, "neg $d0, $u0", [g.word(x.args[2])])])
          return true
        }
      }
      let ins = ["add", "sub", "mul", "lsl", "lsr"][op]
      let (k, kc) = g.const_int(x.args[2])
      if kc && op <= 1 && imm12(k) {
        // a constant addend is the immediate (decision 0207 stage 3)
        g.set(v, [g.def1(false, "${ins} $d0, $u0, #${k}", [a])])
        return true
      }
      if kc && op >= 3 {
        g.set(v, [g.def1(false, "${ins} $d0, $u0, #${k & 63}", [a])])
        return true
      }
      g.set(v, [g.def1(false, "${ins} $d0, $u0, $u1", [a, g.word(x.args[2])])])
    }
    "rt.u64_mul_hi" => g.set(v, [g.def1(false, "umulh $d0, $u0, $u1", [g.word(x.args[0]), g.word(x.args[1])])])
    // cpu.mul_hi_signed (2026-10-21): smulh; imulq's high half on x86_64
    // (x86.xo)
    "rt.i64_mul_hi" => g.set(v, [g.def1(false, "smulh $d0, $u0, $u1", [g.word(x.args[0]), g.word(x.args[1])])])
    // decision 0231: the carry out of a + b and the borrow out of a - b
    // (std/native/llrt/cpu.xo), the flag of one instruction
    "rt.u64_carry" => {
      // set already when its add was selected (add_with_flag)
      if !g.has_val[v] {
        g.set(v, [g.def1(false, "cmn $u0, $u1\ncset $d0, cs", [g.word(x.args[0]), g.word(x.args[1])])])
      }
    }
    // decision 0231's addendum: x + y + cin (cin 0 or 1, moved into the
    // carry flag by cmp #1) and its carry, one adcs when both are used
    "rt.u64_adc" | "rt.u64_adc_carry" => {
      if !g.has_val[v] && ADC_CHAINS && g.adc_chain(v) {
        return true
      }
      if !g.has_val[v] {
        let sum = aux_str(x.aux) == "rt.u64_adc"
        let other = g.adc_pair(v, if sum { "rt.u64_adc_carry" } else { "rt.u64_adc" })
        // a constant 0 addend is xzr (register 31 is the zero register in
        // adds, adcs, and adc): no mov of 0, and the pair stays one
        // instruction (2026-10-16, x25519.fe64_mul)
        var zus: List[Int] = []
        let a0 = g.adc_op(x.args[0], zus)
        let a1 = g.adc_op(x.args[1], zus)
        if other >= 0 {
          // one pair, at most three uses and two defs: marked early (the
          // sum is written before cset) and keep, so that a template the
          // emitter's three scratch registers cannot serve fails the build
          // instead of sharing x15 (gotchas/arm64-template-scratch-reuse.md)
          let d = g.new_vreg(false)
          let c = g.new_vreg(false)
          let (cin, cin_k) = g.const_int(x.args[2])
          let ii = if cin_k && cin == 0 {
            g.plain("adds $d0, ${a0}, ${a1}\ncset $d1, cs", [d, c], zus)
          } else {
            let ct = g.carry_in(x.args[2], zus)
            g.plain("${ct}adcs $d0, ${a0}, ${a1}\ncset $d1, cs", [d, c], zus)
          }
          g.blocks[g.cur].insts[ii].early = true
          g.blocks[g.cur].insts[ii].keep = true
          g.set(v, [if sum { d } else { c }])
          g.set(other, [if sum { c } else { d }])
        } else {
          let (cin, cin_k) = g.const_int(x.args[2])
          if cin_k && cin == 0 {
            // x + 0 is x, and its carry 0 (no add of xzr: some encodings
            // read register 31 as sp)
            let one = if a0 == "xzr" { a1 } else { a0 }
            if a0 == "xzr" || a1 == "xzr" {
              g.set(v, [g.def1(false, if sum { "mov $d0, ${one}" } else { "mov $d0, xzr" }, zus)])
            } else if sum {
              g.set(v, [g.def1(false, "add $d0, ${a0}, ${a1}", zus)])
            } else {
              g.set(v, [g.def1(false, "cmn ${a0}, ${a1}\ncset $d0, cs", zus)])
            }
          } else if sum {
            let ct = g.carry_in(x.args[2], zus)
            g.set(v, [g.def1(false, "${ct}adc $d0, ${a0}, ${a1}", zus)])
          } else {
            let ct = g.carry_in(x.args[2], zus)
            g.set(v, [g.def1(false, "${ct}adcs xzr, ${a0}, ${a1}\ncset $d0, cs", zus)])
          }
        }
      }
    }
    "rt.u64_borrow" => {
      if !g.has_val[v] {
        g.set(v, [g.def1(false, "cmp $u0, $u1\ncset $d0, cc", [g.word(x.args[0]), g.word(x.args[1])])])
      }
    }
    // the carry-less product's halves and the AES rounds (cpu.xo, run
    // only when cpu.hw() has them), in the scratch registers v30 and v31
    "rt.clmul_lo" | "rt.clmul_hi" => {
      if g.has_val[v] {
        // its other half's pmull gave it
        return true
      }
      let lo = aux_str(x.aux) == "rt.clmul_lo"
      let other = g.clmul_pair(v, if lo { "rt.clmul_hi" } else { "rt.clmul_lo" })
      if g.x86 {
        // PCLMULQDQ (cpu.hw()'s HW_CLMUL): the operands in xmm15 and
        // xmm14, the product's halves out of xmm15
        let us = [g.word(x.args[0]), g.word(x.args[1])]
        let mul = "movq $u0, %xmm15\nmovq $u1, %xmm14\npclmulqdq $0, %xmm14, %xmm15"
        if other >= 0 {
          let ds = g.x86_defs("${mul}\nmovq %xmm15, $d0\npextrq $1, %xmm15, $d1", 2, us)
          g.set(if lo { v } else { other }, [ds[0]])
          g.set(if lo { other } else { v }, [ds[1]])
        } else {
          let out = if lo { "movq %xmm15, $d0" } else { "pextrq $1, %xmm15, $d0" }
          g.set(v, [g.x86_def1("${mul}\n${out}", us)])
        }
        return true
      }
      if other >= 0 {
        // one pmull for both halves of the product
        let d = g.new_vreg(false)
        let e = g.new_vreg(false)
        let _i = g.plain("fmov d30, $u0\nfmov d31, $u1\npmull v30.1q, v30.1d, v31.1d\nfmov $d0, d30\numov $d1, v30.d[1]", [d, e], [g.word(x.args[0]), g.word(x.args[1])])
        g.set(if lo { v } else { other }, [d])
        g.set(if lo { other } else { v }, [e])
        return true
      }
      let out = if lo { "fmov $d0, d30" } else { "umov $d0, v30.d[1]" }
      g.set(v, [g.def1(false, "fmov d30, $u0\nfmov d31, $u1\npmull v30.1q, v30.1d, v31.1d\n${out}", [g.word(x.args[0]), g.word(x.args[1])])])
    }
    "rt.aes_round" if g.x86 => {
      // AES-NI (cpu.hw()'s HW_AES): arm64's aese then aesmc is
      // MixColumns(ShiftRows(SubBytes(st ^ rk))), aesenc's rounds with
      // the key added first and a zero key after
      g.x86_store("movdqu ($u0), %xmm15\nmovdqu ($u1), %xmm14\npxor %xmm14, %xmm15\npxor %xmm14, %xmm14\naesenc %xmm14, %xmm15\nmovdqu %xmm15, ($u0)", [g.word(x.args[0]), g.word(x.args[1])])
      g.set(v, [])
    }
    "rt.aes_last" if g.x86 => {
      // ShiftRows(SubBytes(st ^ rk)) ^ rk2: aesenclast with rk2
      g.x86_store("movdqu ($u0), %xmm15\nmovdqu ($u1), %xmm14\npxor %xmm14, %xmm15\nmovdqu ($u2), %xmm14\naesenclast %xmm14, %xmm15\nmovdqu %xmm15, ($u0)", [g.word(x.args[0]), g.word(x.args[1]), g.word(x.args[2])])
      g.set(v, [])
    }
    "rt.aes_enc10" | "rt.aes_enc12" | "rt.aes_enc14" if g.x86 => {
      // the block: the first key added, nr - 1 aesenc, aesenclast with
      // the last (round keys loaded with movdqu: no alignment assumed)
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_enc")) ?? 10
      var t = "movdqu ($u0), %xmm15\nmovdqu ($u1), %xmm14\npxor %xmm14, %xmm15"
      for r in 1..nr {
        t = t + "\nmovdqu ${16 * r}($u1), %xmm14\naesenc %xmm14, %xmm15"
      }
      t = t + "\nmovdqu ${16 * nr}($u1), %xmm14\naesenclast %xmm14, %xmm15\nmovdqu %xmm15, ($u0)"
      g.x86_store(t, [g.word(x.args[0]), g.word(x.args[1])])
      g.set(v, [])
    }
    "rt.aes_round" => {
      g.store("ldr q30, [$u0, xzr]\nldr q31, [$u1, xzr]\naese v30.16b, v31.16b\naesmc v30.16b, v30.16b\nstr q30, [$u0, xzr]", [g.real(g.word(x.args[0])), g.real(g.word(x.args[1]))])
      g.set(v, [])
    }
    "rt.aes_last" => {
      g.store("ldr q30, [$u0, xzr]\nldr q31, [$u1, xzr]\naese v30.16b, v31.16b\nldr q31, [$u2, xzr]\neor v30.16b, v30.16b, v31.16b\nstr q30, [$u0, xzr]", [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2]))])
      g.set(v, [])
    }
    "rt.ghash4" => {
      // decision 0339: ssa.ghash4_neon_lines, $u0 the state, $u1 the H
      // powers, $u2 the 64 bytes; its V registers clobbered
      var cl: List[Int] = []
      for r in ssa.ghash4_neon_vregs() {
        cl.push(FP_BASE + r)
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.ghash4_neon_lines("$u0", "$u1", "$u2").join("\n"), us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2]))], clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.ghash_blocks" => {
      // ssa.ghash_loop_lines: $u0 the state, $u1 the H powers, $u2 the
      // data, $u3 its length; x9 and x10 its pointer and count, its V
      // registers clobbered
      var cl = [9, 10]
      for r in ssa.ghash_loop_vregs() {
        cl.push(FP_BASE + r)
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.ghash_loop_lines("$u0", "$u1", "$u2", "$u3", "x9", "x10").join("\n"), us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2])), g.real(g.word(x.args[3]))], clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.chacha_blocks4" => {
      // decision 0329: the four blocks in vector registers, one 32 bit
      // lane each (ssa.chacha4_neon_lines), clobbering the caller saved V
      // registers it uses (never v8 to v15, whose low halves a callee
      // keeps), and x9, x10 (its rotation table's halves)
      var cl: List[Int] = [9, 10]
      for r in ssa.chacha4_neon_vregs() {
        cl.push(FP_BASE + r)
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.chacha4_neon_lines("$u0", "$u1", "$u2", "", "x9", "x10", "").join("\n"), us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2]))], clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.ticks" | "rt.ticks_hz" => {
      // a read of the generic timer: kept, never merged or moved (keep)
      let reg = if aux_str(x.aux) == "rt.ticks" { "cntvct_el0" } else { "cntfrq_el0" }
      let d = g.new_vreg(false)
      let _i = g.add(Inst{kind: K_PLAIN, text: "mrs $d0, ${reg}", defs: [d], keep: true})
      g.set(v, [d])
    }
    "rt.chacha_stream4" => {
      // the same kernel over n bytes (a multiple of 256) in one loop, x9
      // to x11 its cursors and count
      var cl: List[Int] = [9, 10, 11]
      for r in ssa.chacha4_neon_vregs() {
        cl.push(FP_BASE + r)
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.chacha4_neon_lines("$u0", "$u1", "$u2", "$u3", "x9", "x10", "x11").join("\n"), us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2])), g.real(g.word(x.args[3]))], clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.aes_enc10" | "rt.aes_enc12" | "rt.aes_enc14" => {
      // the whole block unrolled, the state in v30, each round key
      // loaded once into v31
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_enc")) ?? 10
      var t = "ldr q30, [$u0]"
      for r in 0..nr - 1 {
        t = t + "\nldr q31, [$u1, #${16 * r}]\naese v30.16b, v31.16b\naesmc v30.16b, v30.16b"
      }
      t = t + "\nldr q31, [$u1, #${16 * (nr - 1)}]\naese v30.16b, v31.16b\nldr q31, [$u1, #${16 * nr}]\neor v30.16b, v30.16b, v31.16b\nstr q30, [$u0]"
      g.store(t, [g.real(g.word(x.args[0])), g.real(g.word(x.args[1]))])
      g.set(v, [])
    }
    "rt.aes_gcm_enc10" | "rt.aes_gcm_enc12" | "rt.aes_gcm_enc14" | "rt.aes_gcm_dec10" | "rt.aes_gcm_dec12" | "rt.aes_gcm_dec14" => {
      // ssa.aes_gcm_lines: $u0 dst, $u1 src, $u2 the round keys, $u3 the
      // counter block, $u4 the length, $u5 the GHASH state, $u6 the H
      // powers; x9 to x11 its pointers and count (v8, v9 saved on the
      // stack and restored)
      let name = aux_str(x.aux)
      let nr = Int.parse(name[name.len() - 2..name.len()]) ?? 10
      var cl = [9, 10, 11]
      for r in ssa.aes_gcm_vregs() {
        cl.push(FP_BASE + r)
      }
      var us: List[Int] = []
      for k in 0..7 {
        us.push(g.real(g.word(x.args[k])))
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.aes_gcm_lines(nr, name.contains("enc"), "$u0", "$u1", "$u2", "$u3", "$u4", "$u5", "$u6", "x9", "x10", "x11").join("\n"), us: us, clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.aes_gcm8_enc10" | "rt.aes_gcm8_enc12" | "rt.aes_gcm8_enc14" | "rt.aes_gcm8_dec10" | "rt.aes_gcm8_dec12" | "rt.aes_gcm8_dec14" => {
      // ssa.aes_gcm8_lines: the arguments as aes_gcm_lines' (the H
      // powers eight); x9 to x11 its pointers and count (d8 to d15 saved
      // on the stack and restored)
      let name = aux_str(x.aux)
      let nr = Int.parse(name[name.len() - 2..name.len()]) ?? 10
      var cl = [9, 10, 11]
      for r in ssa.aes_gcm8_vregs() {
        cl.push(FP_BASE + r)
      }
      var us: List[Int] = []
      for k in 0..7 {
        us.push(g.real(g.word(x.args[k])))
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.aes_gcm8_lines(nr, name.contains("enc"), "$u0", "$u1", "$u2", "$u3", "$u4", "$u5", "$u6", "x9", "x10", "x11").join("\n"), us: us, clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.aes_ctr10" | "rt.aes_ctr12" | "rt.aes_ctr14" => {
      // ssa.aes_ctr_lines: $u0 dst, $u1 src, $u2 the round keys, $u3 the
      // counter block, $u4 the length; x9 to x11 its pointers and count
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_ctr")) ?? 10
      var cl = [9, 10, 11]
      for r in ssa.aes_ctr_vregs() {
        cl.push(FP_BASE + r)
      }
      var us: List[Int] = []
      for k in 0..5 {
        us.push(g.real(g.word(x.args[k])))
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ssa.aes_ctr_lines(nr, "$u0", "$u1", "$u2", "$u3", "$u4", "x9", "x10", "x11").join("\n"), us: us, clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.aes_enc10x4" | "rt.aes_enc12x4" | "rt.aes_enc14x4" => {
      // four blocks in v26 to v29 (caller saved, never v8 to v15), each
      // round key loaded once into v31 and applied to the four in turn:
      // four independent AESE and AESMC chains instead of one
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_enc").trim_suffix("x4")) ?? 10
      var t = "ldp q26, q27, [$u0]\nldp q28, q29, [$u0, #32]"
      for r in 0..nr - 1 {
        t = t + "\nldr q31, [$u1, #${16 * r}]"
        for s in 26..30 {
          t = t + "\naese v${s}.16b, v31.16b\naesmc v${s}.16b, v${s}.16b"
        }
      }
      t = t + "\nldr q31, [$u1, #${16 * (nr - 1)}]\nldr q30, [$u1, #${16 * nr}]"
      for s in 26..30 {
        t = t + "\naese v${s}.16b, v31.16b\neor v${s}.16b, v${s}.16b, v30.16b"
      }
      t = t + "\nstp q26, q27, [$u0]\nstp q28, q29, [$u0, #32]"
      var cl: List[Int] = []
      for r in 26..32 {
        cl.push(FP_BASE + r)
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: t, us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1]))], clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.mlkem_ntt" | "rt.mlkem_inverse_ntt" | "rt.mlkem_mul_acc" if !g.x86 => {
      // NEON, four coefficients a register (ssa a64mlkem.xo): x9 to x15
      // and v16 to v31 clobbered
      var cl = ssa.mlkem_neon_gprs()
      for r in ssa.mlkem_neon_vregs() {
        cl.push(FP_BASE + r)
      }
      let name = aux_str(x.aux)
      let ls = if name == "rt.mlkem_ntt" { ssa.mlkem_ntt_neon_lines("$u0", "$u1") } else if name == "rt.mlkem_inverse_ntt" { ssa.mlkem_inverse_ntt_neon_lines("$u0", "$u1") } else { ssa.mlkem_mul_acc_neon_lines("$u0", "$u1", "$u2", "$u3") }
      var us: List[Int] = []
      for a in x.args {
        us.push(g.real(g.word(a)))
      }
      let _i = g.add(Inst{kind: K_PLAIN, text: ls.join("\n"), us: us, clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.mlkem_ntt" | "rt.mlkem_inverse_ntt" => {
      // SSE2, two coefficients a register (ssa.mlkem_ntt_sse2_lines):
      // xmm0 to xmm5 and six general registers clobbered, xmm14 and
      // r11 the emitter's scratch
      var cl = [XR_AX, XR_CX, XR_DX, 8, 9, 10]
      for r in 0..6 {
        cl.push(FP_BASE + r)
      }
      let t = (if aux_str(x.aux) == "rt.mlkem_ntt" { ssa.mlkem_ntt_sse2_lines("$u0", "$u1") } else { ssa.mlkem_inverse_ntt_sse2_lines("$u0", "$u1") }).join("\n")
      let _i = g.add(Inst{kind: K_PLAIN, text: t, us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1]))], x86: true, clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.mlkem_mul_acc" => {
      // SSE2, two products an iteration (ssa.mlkem_mul_acc_sse2_lines):
      // the clobbers of rt.mlkem_ntt, xmm14, xmm15 the emitter's scratch
      var cl = [XR_AX, XR_CX, XR_DX, 8, 9, 10]
      for r in 0..6 {
        cl.push(FP_BASE + r)
      }
      let t = ssa.mlkem_mul_acc_sse2_lines("$u0", "$u1", "$u2", "$u3").join("\n")
      let _i = g.add(Inst{kind: K_PLAIN, text: t, us: [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2])), g.real(g.word(x.args[3]))], x86: true, clobbers: cl})
      g.clobber()
      g.set(v, [])
    }
    "rt.sha256_block" if g.x86 => {
      // SHA-NI (cpu.hw()'s HW_SHA256 from CPUID leaf 7): xmm0 to xmm10
      // saved below rsp and restored, as the arm64 template saves v16
      // to v20
      var t: List[Str] = ["subq $176, %rsp"]
      for r in 0..11 {
        t.push("movdqu %xmm${r}, ${16 * r}(%rsp)")
      }
      t = t + ssa.sha256_ni_lines("$u0", "$u1", "$u2")
      for r in 0..11 {
        t.push("movdqu ${16 * r}(%rsp), %xmm${r}")
      }
      t.push("addq $176, %rsp")
      g.x86_store(t.join("\n"), [g.word(x.args[0]), g.word(x.args[1]), g.word(x.args[2])])
      g.set(v, [])
    }
    "rt.sha256_block" => {
      // the state as abcd in v16 and efgh in v17 (each packed from four
      // 8 byte words), the message in v19, v20, v29, v30, W + K in v31,
      // abcd's copy for SHA256H2 in v18; v16 to v20 may hold the
      // allocator's values, so they are saved below sp and restored
      let m = ["v19", "v20", "v29", "v30"]
      var t = "sub sp, sp, #80\nstr q16, [sp]\nstr q17, [sp, #16]\nstr q18, [sp, #32]\nstr q19, [sp, #48]\nstr q20, [sp, #64]"
      t = t + "\nldr q16, [$u0]\nldr q17, [$u0, #16]\nuzp1 v16.4s, v16.4s, v17.4s\nldr q17, [$u0, #32]\nldr q18, [$u0, #48]\nuzp1 v17.4s, v17.4s, v18.4s"
      for i in 0..4 {
        t = t + "\nldr q${if i < 2 { 19 + i } else { 27 + i }}, [$u1, #${16 * i}]\nrev32 ${m[i]}.16b, ${m[i]}.16b"
      }
      for i in 0..16 {
        let w = m[i % 4]
        t = t + "\nldr q31, [$u2, #${16 * i}]\nadd v31.4s, v31.4s, ${w}.4s"
        if i < 12 {
          t = t + "\nsha256su0 ${w}.4s, ${m[(i + 1) % 4]}.4s"
        }
        t = t + "\nmov v18.16b, v16.16b\nsha256h q16, q17, v31.4s\nsha256h2 q17, q18, v31.4s"
        if i < 12 {
          t = t + "\nsha256su1 ${w}.4s, ${m[(i + 2) % 4]}.4s, ${m[(i + 3) % 4]}.4s"
        }
      }
      // the sums with the state before, unpacked to 8 byte words
      t = t + "\nldr q18, [$u0]\nldr q31, [$u0, #16]\nuzp1 v18.4s, v18.4s, v31.4s\nadd v16.4s, v16.4s, v18.4s"
      t = t + "\nldr q18, [$u0, #32]\nldr q31, [$u0, #48]\nuzp1 v18.4s, v18.4s, v31.4s\nadd v17.4s, v17.4s, v18.4s"
      t = t + "\nushll v18.2d, v16.2s, #0\nushll2 v31.2d, v16.4s, #0\nstr q18, [$u0]\nstr q31, [$u0, #16]"
      t = t + "\nushll v18.2d, v17.2s, #0\nushll2 v31.2d, v17.4s, #0\nstr q18, [$u0, #32]\nstr q31, [$u0, #48]"
      t = t + "\nldr q16, [sp]\nldr q17, [sp, #16]\nldr q18, [sp, #32]\nldr q19, [sp, #48]\nldr q20, [sp, #64]\nadd sp, sp, #80"
      g.store(t, [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2]))])
      g.set(v, [])
    }
    // x86-64's CPUID (cpu.xo cpuid1_ecx): never on arm64
    // CPUID leaf 7's EBX (bit 29 SHA-NI): rbx is the answer, kept in r11
    "rt.cpuid7_ebx" => {
      if g.x86 {
        g.set(v, [g.x86_atomic_def("movq %rbx, %r11\nmovl $7, %eax\nxorl %ecx, %ecx\ncpuid\nmovl %ebx, $wd0\nmovq %r11, %rbx", [], [XR_AX, XR_CX, XR_DX])])
      } else {
        g.set(v, [g.def1(false, "mov $d0, #0", [])])
      }
    }
    // and on x86-64 CPUID leaf 1's ECX; rbx (callee saved) kept in r11
    "rt.cpuid1_ecx" => {
      if g.x86 {
        g.set(v, [g.x86_atomic_def("movq %rbx, %r11\nmovl $1, %eax\nxorl %ecx, %ecx\ncpuid\nmovq %r11, %rbx\nmovl %ecx, $wd0", [], [XR_AX, XR_CX, XR_DX])])
      } else {
        g.set(v, [g.def1(false, "mov $d0, #0", [])])
      }
    }
    // decision 0222: the value barrier is the operand itself (this
    // emitter neither folds through a call's result nor turns masks
    // into branches; test/codegen/consttime checks it)
    "rt.ct_barrier" => g.set(v, [g.word(x.args[0])])
    // decision 0195: the conversions of UInt64 and Float32
    "rt.u64_to_float" => g.set(v, [g.def1(true, "ucvtf $d0, $u0", [g.word(x.args[0])])])
    "rt.f32_round" => {
      if g.f32_lazy(x.args[0]) {
        g.f32_op(v, x.args[0])
      } else {
        g.set(v, [g.def1(true, "fcvt $wd0, $u0\nfcvt $d0, $wd0", [g.word(x.args[0])])])
      }
    }
    "rt.i64_to_f32" | "rt.u64_to_f32" => {
      // the single form kept for the Float32 operations that read it
      // (decision 0361; the widen goes when only they do)
      let cv = if aux_str(x.aux) == "rt.i64_to_f32" { "scvtf" } else { "ucvtf" }
      let s = g.def1(true, "${cv} $wd0, $u0", [g.word(x.args[0])])
      g.f32s[v] = s
      g.set(v, [g.def1(true, "fcvt $d0, $wu0", [s])])
    }
    "rt.float_bits" => g.set(v, [g.def1(false, "fmov $d0, $u0", [g.word(x.args[0])])])
    "rt.float_from_bits" => g.set(v, [g.def1(true, "fmov $d0, $u0", [g.word(x.args[0])])])
    "rt.bytes_word" => {
      let ws = g.words(x.args[0])
      let d = g.str_data(ws)
      g.set(v, [g.def1(false, "ldr $d0, [$u0, $u1]", [d, g.word(x.args[1])])])
    }
    "rt.sys6" => {
      // a call whose `bl` is `svc #0` (decision 0206): the arguments in
      // x0 to x5 and the number in x6 (moved to x8), the result in x0;
      // the kernel keeps the other registers, a call clobbers more
      var args: List[Src] = []
      var us: List[Int] = []
      for k in [1, 2, 3, 4, 5, 6, 0] {
        let r = g.word(x.args[k])
        args.push(rsrc(r))
        us.push(r)
      }
      let defs = g.new_vregs([false])
      let _i = g.add(Inst{kind: K_CALL, svc: true, srcs: args, defs: defs, us: us})
      g.clobber()
      g.set(v, defs)
    }
    "rt.sys_restorer" => {
      g.restorer_ref = true
      g.set(v, [g.sym_addr(g.tramp("xo_sigreturn"))])
    }
    "rt.call_c2" | "rt.call_c4" => {
      // a C ABI call of an address (decision 0206 stage 2): the
      // arguments in x0 and x1 (to x3 for call_c4), the address in the
      // next register (`blr x2`, `blr x4`)
      var args: List[Src] = []
      var us: List[Int] = []
      let order = if x.args.len() == 5 { [1, 2, 3, 4, 0] } else { [1, 2, 0] }
      for k in order {
        let r = g.word(x.args[k])
        args.push(rsrc(r))
        us.push(r)
      }
      let defs = g.new_vregs([false])
      if g.x86 && g.os == "windows" {
        // the address is an export's, a Win64 function: the thunk takes
        // it after the arguments (x86win.xo)
        let n = x.args.len() - 1
        let _w = g.add(Inst{kind: K_CALL, sym: g.w64_sym("xo_callc${n}", "i".repeat(n + 1)), srcs: args, defs: defs, us: us})
        g.clobber()
        g.set(v, defs)
        return true
      }
      let _i = g.add(Inst{kind: K_CALL, cptr: true, srcs: args, defs: defs, us: us})
      g.clobber()
      g.set(v, defs)
    }
    "rt.sys_words" => {
      g.words_ref = true
      g.set(v, [g.sym_addr(g.tramp("xo_sys_words"))])
    }
    "rt.static_word" => {
      // word k of the process globals (decision 0207, work item B02): the
      // table's address plus 8 * k (k a constant the SSA builder checked)
      g.static_ref = true
      let (k, _) = g.const_int(x.args[0])
      // one constant (konst) with its offset: loop invariant, so a loop's
      // preemption poll loads the flag through a hoisted address instead
      // of adrp, add, add each iteration (2026-10-21: sieve +25%)
      g.set(v, [g.sym_addr_off(g.tramp("xo_static"), 8 * k)])
    }
    "rt.sys_clone" => {
      // a call of the clone trampoline (gen.xo), written at the end
      g.clone_ref = true
      var args: List[Src] = []
      for k in 0..4 {
        args.push(rsrc(g.word(x.args[k])))
      }
      g.set(v, g.call(g.tramp("xo_clone"), args, [false]))
    }
    "rt.unwind_save" | "rt.unwind_resume" => {
      // calls of the unwinder's trampolines (decision 0221), written with
      // the clone trampoline: only programs with no C library use either
      g.clone_ref = true
      let _r = g.call(g.tramp(if aux_str(x.aux) == "rt.unwind_save" { "xo_unwind_save" } else { "xo_unwind_resume" }), [rsrc(g.word(x.args[0]))], [])
      g.set(v, [])
    }
    "rt.tlocal_get" | "rt.tlocal_set" | "rt.tlocal_addr" if g.os == "linux" || g.os == "darwin" || (g.x86 && g.os == "windows") => {
      // inline on Linux (2026-10-16): the thread pointer plus xo_tlocal's
      // local exec offset, then the slot; xo_tlocal_get's call, its
      // moves, and its clobbers cost the scheduler's pingpong 9M
      // instructions (sched.xo still defines xo_tlocal)
      g.sched_ref = true
      let base = g.tl_base()
      let op = aux_str(x.aux)
      if op == "rt.tlocal_addr" {
        g.set(v, [base])
      } else {
        let (k, kok) = g.const_int(x.args[0])
        let konst = kok && k >= 0 && k < 4096
        if op == "rt.tlocal_get" {
          if konst {
            g.set(v, [g.def1(false, "ldr $d0, [$u0, #${k * 8}]", [base])])
          } else {
            g.set(v, [g.def1(false, "ldr $d0, [$u0, $u1, lsl #3]", [base, g.word(x.args[0])])])
          }
        } else {
          if konst {
            let _i = g.plain("str $u1, [$u0, #${k * 8}]", [], [base, g.word(x.args[1])])
          } else {
            let _i = g.plain("str $u2, [$u0, $u1, lsl #3]", [], [base, g.word(x.args[0]), g.word(x.args[1])])
          }
          g.set(v, [])
        }
      }
    }
    "rt.stack_switch" | "rt.tlocal_get" | "rt.tlocal_set" | "rt.tlocal_addr" => {
      // calls of the functions sched.xo emits (decision 0212)
      g.sched_ref = true
      return false
    }
    "rt.fiber_start_addr" => {
      g.sched_ref = true
      g.set(v, [g.sym_addr(g.sym("xo_fiber_entry"))])
    }
    "rt.frame_addr" => {
      // the frame record the prologue makes (decision 0233): x29, with
      // the frame kept for this instruction's block (Inst.frame)
      let d = g.new_vreg(false)
      let i = g.plain("mov $d0, x29", [d], [])
      g.blocks[g.cur].insts[i].frame = true
      g.set(v, [d])
    }
    // the runtime's immortal placeholders (an unwinding operation's
    // result, the empty list): their addresses, no call (xo_rt.c
    // xo_empty_list, xo_zero_handle)
    "rt.rl_empty" => g.set(v, [g.sym_addr(g.sym("xo_empty_list"))])
    "rt.h_zero" => g.set(v, [g.sym_addr(g.sym("xo_zero_handle"))])
    "rt.popcount" => {
      if g.x86 {
        g.set(v, [g.x86_def1("popcntq $u0, $d0", [g.word(x.args[0])])])
      } else {
        g.set(v, [g.def1(false, "fmov d30, $u0\ncnt v30.8b, v30.8b\naddv b30, v30.8b\nfmov $d0, d30", [g.word(x.args[0])])])
      }
    }
    "rt.ctz" => g.set(v, [g.def1(false, "rbit $d0, $u0\nclz $d0, $d0", [g.word(x.args[0])])])
    "rt.clz" => g.set(v, [g.def1(false, "clz $d0, $u0", [g.word(x.args[0])])])
    "rt.bytes_eq16" | "rt.bytes_high16" | "rt.bytes_eq16_bits" | "rt.bytes_high16_bits" => {
      let ws = g.words(x.args[0])
      let d = g.str_data(ws)
      var us = [d, g.word(x.args[1])]
      if g.x86 {
        g.set(v, [g.x86_bytes16(x, us)])
        return true
      }
      let bits = aux_str(x.aux).ends_with("_bits")
      var cmp = "cmlt v30.16b, v30.16b, #0"
      if aux_str(x.aux) == "rt.bytes_eq16" || aux_str(x.aux) == "rt.bytes_eq16_bits" {
        let (c, ok) = g.const_int(x.args[2])
        if ok {
          cmp = "movi v31.16b, #${c & 255}\ncmeq v30.16b, v30.16b, v31.16b"
        } else {
          cmp = "dup v31.16b, $wu2\ncmeq v30.16b, v30.16b, v31.16b"
          us.push(g.word(x.args[2]))
        }
      }
      let nib = g.def1(false, "ldr q30, [$u0, $u1]\n${cmp}\nshrn v30.8b, v30.8h, #4\nfmov $d0, d30", us)
      if !bits {
        g.set(v, [nib])
        return true
      }
      // one bit a byte (the _bits forms, made for amd64's pmovmskb): the
      // nibbles' low bits gathered, pairs at a time
      g.set(v, [g.def1(false, "and $d0, $u0, #0x1111111111111111\norr $d0, $d0, $d0, lsr #3\nand $d0, $d0, #0x0303030303030303\norr $d0, $d0, $d0, lsr #6\nand $d0, $d0, #0x000f000f000f000f\norr $d0, $d0, $d0, lsr #12\nand $d0, $d0, #0x000000ff000000ff\norr $d0, $d0, $d0, lsr #24\nand $d0, $d0, #0xffff", [nib])])
    }
    "rt.rs_put_word" => {
      let ws = g.words(x.args[0])
      let d = g.str_data(ws)
      let _i = g.plain("str $u2, [$u0, $u1]", [], [d, g.word(x.args[1]), g.word(x.args[2])])
      g.set(v, ws)
    }
    "rt.rs_set_len" => g.set(v, [g.words(x.args[0])[0], g.word(x.args[1])])
    "rt.slot_load" | "rt.slot_store" | "rt.slot_swap" | "rt.slot_cas" | "rt.slot_add" | "rt.slot_addr" | "rt.fence" | "rt.spin_hint" => g.atomic(v)
    _ => return g.inline_raw(v)
  }
  true
}

/// Lowers the raw memory intrinsics (decision 0207, isel.go inlineRaw):
/// loads and stores of a constant width, memcpy, memmove, memset, and
/// memcmp of the platform library, a string with its length set, and an
/// object's address both ways; whether v was one.
fn (var g: G) inline_raw(v: Int) -> Bool {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  match name {
    "rt.mem_load" => {
      let (w, _) = g.const_int(x.args[2])
      let (off, oc) = g.const_int(x.args[1])
      if oc {
        if let Some(k) = g.literal_load(x.args[0], off, w) {
          // bytes of a string literal: the value itself
          g.set(v, [g.cimm(k)])
          return true
        }
      }
      if g.x86 && !oc {
        if let Some((i, c)) = g.x86_disp(x.args[1]) {
          // decision 0254: i + c folded into the displacement
          let ins = match w {
            1 => "ldrb $wd0, [$u0, $u1, #${c}]"
            2 => "ldrh $wd0, [$u0, $u1, #${c}]"
            4 => "ldr $wd0, [$u0, $u1, #${c}]"
            _ => "ldr $d0, [$u0, $u1, #${c}]"
          }
          g.set(v, [g.def1(false, ins, [g.real(g.word(x.args[0])), g.real(g.word(i))])])
          return true
        }
      }
      if oc && raw_imm_off(off, w) {
        // a constant offset is the instruction's scaled immediate
        // (decision 0207 stage 3: the heap record's words)
        let ins = match w {
          1 => "ldrb $wd0, [$u0, #${off}]"
          2 => "ldrh $wd0, [$u0, #${off}]"
          4 => "ldr $wd0, [$u0, #${off}]"
          _ => "ldr $d0, [$u0, #${off}]"
        }
        g.set(v, [g.def1(false, ins, [g.real(g.word(x.args[0]))])])
        return true
      }
      if let Some((p, c)) = g.addr_fold(x.args[0], x.args[1], w) {
        // base + i once, i + c as the immediate (addr_fold)
        let ins = match w {
          1 => "ldrb $wd0, [$u0, #${c}]"
          2 => "ldrh $wd0, [$u0, #${c}]"
          4 => "ldr $wd0, [$u0, #${c}]"
          _ => "ldr $d0, [$u0, #${c}]"
        }
        g.set(v, [g.def1(false, ins, [p])])
        return true
      }
      let ins = match w {
        1 => "ldrb $wd0, [$u0, $u1]"
        2 => "ldrh $wd0, [$u0, $u1]"
        4 => "ldr $wd0, [$u0, $u1]"
        _ => "ldr $d0, [$u0, $u1]"
      }
      g.set(v, [g.def1(false, ins, [g.real(g.word(x.args[0])), g.real(g.word(x.args[1]))])])
    }
    "rt.mem_store" => {
      let (w, _) = g.const_int(x.args[3])
      let (off, oc) = g.const_int(x.args[1])
      if g.x86 && !oc {
        if let Some((i, c)) = g.x86_disp(x.args[1]) {
          let ins = match w {
            1 => "strb $wu0, [$u1, $u2, #${c}]"
            2 => "strh $wu0, [$u1, $u2, #${c}]"
            4 => "str $wu0, [$u1, $u2, #${c}]"
            _ => "str $u0, [$u1, $u2, #${c}]"
          }
          g.store(ins, [g.real(g.word(x.args[2])), g.word(x.args[0]), g.word(i)])
          g.set(v, [])
          return true
        }
      }
      if oc && raw_imm_off(off, w) {
        let ins = match w {
          1 => "strb $wu0, [$u1, #${off}]"
          2 => "strh $wu0, [$u1, #${off}]"
          4 => "str $wu0, [$u1, #${off}]"
          _ => "str $u0, [$u1, #${off}]"
        }
        g.store(ins, [g.real(g.word(x.args[2])), g.word(x.args[0])])
        g.set(v, [])
        return true
      }
      if let Some((p, c)) = g.addr_fold(x.args[0], x.args[1], w) {
        let ins = match w {
          1 => "strb $wu0, [$u1, #${c}]"
          2 => "strh $wu0, [$u1, #${c}]"
          4 => "str $wu0, [$u1, #${c}]"
          _ => "str $u0, [$u1, #${c}]"
        }
        g.store(ins, [g.real(g.word(x.args[2])), p])
        g.set(v, [])
        return true
      }
      let ins = match w {
        1 => "strb $wu0, [$u1, $u2]"
        2 => "strh $wu0, [$u1, $u2]"
        4 => "str $wu0, [$u1, $u2]"
        _ => "str $u0, [$u1, $u2]"
      }
      g.store(ins, [g.real(g.word(x.args[2])), g.word(x.args[0]), g.word(x.args[1])])
      g.set(v, [])
    }
    "rt.mem_set" if g.zero_inline(x) => {
      // a known small length of zeros: stores of xzr, no call
      // (2026-10-16: the scheduler's 320 byte context, 14M instructions
      // of memset in spawn)
      let (n, _) = g.const_int(x.args[2])
      var lines: List[Str] = []
      var off = 0
      while off + 16 <= n {
        lines.push("stp xzr, xzr, [$u0, #${off}]")
        off += 16
      }
      if off + 8 <= n {
        lines.push("str xzr, [$u0, #${off}]")
        off += 8
      }
      if off + 4 <= n {
        lines.push("str wzr, [$u0, #${off}]")
        off += 4
      }
      if off + 2 <= n {
        lines.push("strh wzr, [$u0, #${off}]")
        off += 2
      }
      if off < n {
        lines.push("strb wzr, [$u0, #${off}]")
      }
      g.store(lines.join("\n"), [g.real(g.word(x.args[0]))])
      g.set(v, [])
    }
    "rt.mem_copy" if g.copy_inline(x) => {
      // a known small length: loads and stores per 16 bytes, no call
      // (2026-10-17: nistec's point functions copied 32 bytes through
      // libc's memcpy; bench/perf/tls spent 3x LLVM's instructions in
      // memcpy, which inlines them)
      let (n, _) = g.const_int(x.args[2])
      let dst = g.real(g.word(x.args[0]))
      let src = g.real(g.word(x.args[1]))
      var off = 0
      while off + 16 <= n {
        let a = g.new_vreg(false)
        let c = g.new_vreg(false)
        let _i = g.plain("ldp $d0, $d1, [$u0, #${off}]", [a, c], [src])
        g.store("stp $u0, $u1, [$u2, #${off}]", [a, c, dst])
        off += 16
      }
      for (w, ld, st) in [(8, "ldr $d0", "str $u0"), (4, "ldr $wd0", "str $wu0"), (2, "ldrh $wd0", "strh $wu0"), (1, "ldrb $wd0", "strb $wu0")] {
        if off + w <= n {
          let a = g.def1(false, "${ld}, [$u0, #${off}]", [src])
          g.store("${st}, [$u1, #${off}]", [a, dst])
          off += w
        }
      }
      g.set(v, [])
    }
    "rt.mem_copy_block" if g.x86 => {
      // through xmm14 and xmm15 (the emitter's scratch registers), r11
      // the offset: the odd 32 bytes first when n has them, then 64 an
      // iteration (no register is left to test for 64 remaining; 11
      // instructions per 64 bytes, 14 at 32 an iteration)
      var t = ["xorl %r11d, %r11d", "testq $32, $u2", "je 1f", "movups ($u1), %xmm14", "movups 16($u1), %xmm15", "movups %xmm14, ($u0)", "movups %xmm15, 16($u0)", "movl $32, %r11d", "1:", "cmpq $u2, %r11", "jae 3f", "2:"]
      for o in [0, 32] {
        t = t + ["movups ${o}($u1,%r11), %xmm14", "movups ${o + 16}($u1,%r11), %xmm15", "movups %xmm14, ${o}($u0,%r11)", "movups %xmm15, ${o + 16}($u0,%r11)"]
      }
      t = t + ["addq $64, %r11", "cmpq $u2, %r11", "jb 2b", "3:"]
      g.x86_store(t.join("\n"), [g.word(x.args[0]), g.word(x.args[1]), g.word(x.args[2])])
      g.set(v, [])
    }
    "rt.mem_copy_block" => {
      // 64 bytes an iteration as two ldp and stp of q30 and q31 (the
      // emitter's scratch registers, with x16 and x17 the pointers), then
      // the last 32 when n is an odd multiple of 32: the count $d0, a
      // copy of n, read last of the operands (2026-10-17: the word loop
      // of libcstr.copy_words was 18 instructions per 32 bytes, LLVM's
      // vectorized one 5.5 times faster on bench/perf/xo branch)
      let t = "mov x16, $u1\nmov x17, $u0\nsubs $d0, $u2, #64\nb.lt 2f\n1:\nldp q30, q31, [x16], #32\nstp q30, q31, [x17], #32\nldp q30, q31, [x16], #32\nstp q30, q31, [x17], #32\nsubs $d0, $d0, #64\nb.ge 1b\n2:\ntbz $d0, #5, 3f\nldp q30, q31, [x16]\nstp q30, q31, [x17]\n3:"
      let c = g.new_vreg(false)
      let i = g.plain(t, [c], [g.real(g.word(x.args[0])), g.real(g.word(x.args[1])), g.real(g.word(x.args[2]))])
      // a store: not dropped for its dead count
      g.blocks[g.cur].insts[i].keep = true
      g.clobber()
      g.set(v, [])
    }
    "rt.mem_copy" | "rt.mem_move" | "rt.mem_set" => {
      let fname = match name {
        "rt.mem_copy" => "memcpy"
        "rt.mem_move" => "memmove"
        _ => "memset"
      }
      let _r = g.rt(fname, regs([g.word(x.args[0]), g.word(x.args[1]), g.word(x.args[2])]), [])
      g.clobber()
      g.set(v, [])
    }
    "rt.preempt_poll" => {
      // decision 0286 step 3: the flag's word, at a loop's iteration
      // no memory clobber: a yield is not a synchronization point of the
      // program's data (another task's writes reach this one through
      // synchronization, which calls); what a poll does change, the
      // thread the task runs on, ends the thread local base's reuse
      // (tl_base checks for a poll)
      let _i = g.add(Inst{kind: K_PLAIN, text: "ldr w16, [$u0]", us: [g.real(g.word(x.args[0]))], poll: true})
      if g.x86 {
        // amd64 keeps it until measured there
        g.clobber()
      }
      g.set(v, [])
    }
    "rt.prefetch" => {
      // decision 0207 stage 3: the heap's free list pops
      g.store("prfm pldl1keep, [$u0]", [g.real(g.word(x.args[0]))])
      g.set(v, [])
    }
    "rt.mem_cmp" => {
      let r = g.rt("memcmp", regs([g.word(x.args[0]), g.word(x.args[1]), g.word(x.args[2])]), [false])
      g.set(v, [g.def1(false, "sxtw $d0, $wu0", [r[0]])])
    }
    "rt.list_esize" => {
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      g.set(v, [g.imm(g.esize(et))])
    }
    "rt.obj_addr" => {
      // the address of a Str's object, plus a view's offset (decision 0330), so
      // llrt's raw.data and bytes_addr need no offset of their own; the header
      // reads on a builder (capacity, count) see off 0
      let ws = g.words(x.args[0])
      if STR_VIEWS && ws.len() == 2 {
        g.set(v, [g.str_obj_at(ws)])
      } else {
        g.set(v, [ws[0]])
      }
    }
    "rt.str_view" => {
      // s[lo..hi] with the range already checked (decision 0330 step 3): the
      // same object, counted once more, and w1 = (hi - lo) | ((off + lo) << 32)
      let ws = g.words(x.args[0])
      let lo = g.real(g.word(x.args[1]))
      let hi = g.real(g.word(x.args[2]))
      let obj = g.real(ws[0])
      let w1 = g.real(ws[1])
      g.inc(obj)
      let n = g.def1(false, "sub $d0, $u0, $u1", [hi, lo])
      let off = g.def1(false, "lsr $d0, $u0, #32", [w1])
      let off2 = g.def1(false, "add $d0, $u0, $u1", [off, lo])
      let sh = g.def1(false, "lsl $d0, $u0, #32", [off2])
      g.set(v, [obj, g.def1(false, "orr $d0, $u0, $u1", [sh, n])])
    }
    "rt.obj_at" => {
      let a = g.real(g.word(x.args[0]))
      g.retain(x.ty, [a])
      g.set(v, [a])
    }
    _ => return false
  }
  true
}

/// The address of this thread's xo_tlocal table, for rt.tlocal_get,
/// tlocal_set, and tlocal_addr. Linux: the thread pointer plus the local
/// exec offset. darwin: the TLV descriptor's thunk, called inline (it
/// keeps every register but x0, x16, x17, and lr, which the template
/// saves or does not hold values in), and reused in the block until the
/// next call: a task may resume on another thread after any call (the
/// scheduler steals work, decision 0077), so a base is never kept across
/// one.
fn (var g: G) tl_base() -> Int {
  if g.x86 && g.os == "windows" {
    // the module's TLS block: the TEB's slot array (gs:88) at
    // _tls_index, plus xo_tlocal's offset in the block (x86win.xo)
    let d = g.new_vreg(false)
    let t = g.new_vreg(false)
    let i = g.add(Inst{kind: K_PLAIN, text: "movl _tls_index(%rip), $wd1\nmovq %gs:88, $d0\nmovq ($d0,$d1,8), $d0\nleaq xo_tlocal@SECREL32($d0), $d0", defs: [d, t], us: [], x86: true, keep: true})
    let _i = i
    return d
  }
  if g.x86 && g.os == "darwin" {
    // the TLV descriptor's thunk: the table's address in rax, every
    // register but rax and rdi kept; a call, so the function makes its
    // frame (rsp aligned to 16 for the thunk's slow path)
    let d = g.new_vreg(false)
    let i = g.add(Inst{kind: K_PLAIN, text: "movq _xo_tlocal@TLVP(%rip), %rdi\ncallq *(%rdi)\nmovq %rax, $d0", defs: [d], us: [], x86: true, clobbers: [0, 7], keep: true, frame: true})
    let _i = i
    return d
  }
  if g.os != "darwin" {
    return g.def1(false, "mrs $d0, tpidr_el0\nadd $d0, $d0, :tprel_hi12:xo_tlocal\nadd $d0, $d0, :tprel_lo12_nc:xo_tlocal", [])
  }
  if g.tl_v >= 0 && g.tl_blk == g.cur {
    let ins = g.blocks[g.cur].insts
    var ok = g.tl_at <= ins.len()
    var i = g.tl_at
    while ok && i < ins.len() {
      let t = ins[i].text
      if ins[i].kind != K_PLAIN || ins[i].poll || t.contains("bl ") || t.contains("blr ") || t.contains("svc") {
        ok = false
      }
      i += 1
    }
    if ok {
      return g.tl_v
    }
  }
  let v = g.new_vreg(false)
  let i = g.plain("stp x0, x30, [sp, #-16]!\nadrp x0, _xo_tlocal@TLVPPAGE\nldr x0, [x0, _xo_tlocal@TLVPPAGEOFF]\nldr x16, [x0]\nblr x16\nmov x17, x0\nldp x0, x30, [sp], #16\nmov $d0, x17", [v], [])
  // not moved, merged, or dropped by a later pass (the base is only valid
  // until the next call)
  g.blocks[g.cur].insts[i].keep = true
  g.tl_v = v
  g.tl_blk = g.cur
  g.tl_at = g.blocks[g.cur].insts.len()
  v
}

/// Whether rt.mem_set x sets a constant length of at most 512 bytes
/// (stp's reach) to zero, which mem_set then writes as stores of xzr.
/// Whether rt.mem_copy x has a known length of at most 128 bytes (the
/// copy inline: at most 8 ldp and stp, and one of each tail width).
fn (g: G) copy_inline(x: ssa.Value) -> Bool {
  let (n, nok) = g.const_int(x.args[2])
  nok && n > 0 && n <= 128
}

fn (g: G) zero_inline(x: ssa.Value) -> Bool {
  let (b, bok) = g.const_int(x.args[1])
  let (n, nok) = g.const_int(x.args[2])
  bok && nok && b & 255 == 0 && n > 0 && n <= 512
}

// Long multiplies (isel.go, decision 0208): the product of two values
// of 32 bits (masked by 0xFFFFFFFF, or `(x << 32) >> 32`, or known in
// range) is umull (smull) of their low halves, and a wrapping add of it
// umaddl (smaddl); a wrapping add of a wrapping shift left by a constant
// is an add with a shifted operand. The mask or the extension, used only
// there, is then dead.

/// The register whose low 32 bits are v, zero extended (sign extended
/// when signed), whether that took off a mask or an extension, and
/// whether there is one (half32).
fn (var g: G) half32(v: Int, signed: Bool) -> (Int, Bool, Bool) {
  let x = g.f.values[v]
  if g.kind(x.ty) != ssa.Kind.Int {
    return (0, false, false)
  }
  if !signed && x.op == ssa.Op.And {
    for j in 0..2 {
      let (k, kc) = g.const_int(x.args[j])
      if kc && k == 0xFFFFFFFF {
        return (g.word(x.args[1 - j]), true, true)
      }
    }
  }
  if signed && x.op == ssa.Op.Shr && g.f.values[x.args[0]].op == ssa.Op.Shl {
    let (k1, ok1) = g.const_int(x.args[1])
    let (k2, ok2) = g.const_int(g.f.values[x.args[0]].args[1])
    if ok1 && ok2 && k1 == 32 && k2 == 32 {
      return (g.word(g.f.values[x.args[0]].args[0]), true, true)
    }
  }
  let (lo, hi) = g.bounds(v)
  if signed && lo >= -2147483648 && hi <= 2147483647 || !signed && lo >= 0 && hi <= 4294967295 {
    return (g.word(v), false, true)
  }
  (0, false, false)
}

/// umull or smull of x and y, when both are 32 bit values and one is
/// masked or extended for it (mulLong).
fn (var g: G) mul_long(x: Int, y: Int) -> (Str, List[Int], Bool) {
  for signed in [false, true] {
    let (a, ea, ok1) = g.half32(x, signed)
    if !ok1 {
      continue
    }
    let (b, eb, ok2) = g.half32(y, signed)
    if ok2 && (ea || eb) {
      if signed {
        return ("smull $d0, $wu0, $wu1", [a, b], true)
      }
      return ("umull $d0, $wu0, $wu1", [a, b], true)
    }
  }
  ("", [], false)
}

/// The operation of an rt.int_wrap call with a constant operation
/// (wrapOp).
fn (g: G) wrap_op(v: Int) -> (Int, Bool) {
  let x = g.f.values[v]
  if x.op != ssa.Op.Call || aux_str(x.aux) != "rt.int_wrap" {
    return (0, false)
  }
  g.const_int(x.args[0])
}

/// Lowers rt.int_wrap(0, a, b) when a or b, used only there, is a long
/// multiply (umaddl, smaddl), another wrapping multiply (madd), or a
/// shift left by a constant (an add with a shifted operand; fusedAdd).
fn (var g: G) fused_add(v: Int) -> Bool {
  let args = g.f.values[v].args
  for j in 1..3 {
    // through an inlined helper's result parameter (num.addw(num.mulw(..)))
    let x = g.through_params(args[j])
    let o = args[3 - j]
    let (op, ok) = g.wrap_op(x)
    if !ok || g.nuses[x] != 1 || g.nuses[args[j]] != 1 {
      continue
    }
    let xa = g.f.values[x].args
    if op == 2 {
      let (text, us, ok2) = g.mul_long(xa[1], xa[2])
      if ok2 {
        let t2 = "${text[0..1]}maddl $d0, $wu0, $wu1, $u2"
        g.set(v, [g.def1(false, t2, us + [g.word(o)])])
        return true
      }
      // a wrapping multiply and add: madd (parse's mant * 10 + digit)
      let m1 = g.word(xa[1])
      let m2 = g.word(xa[2])
      g.set(v, [g.def1(false, "madd $d0, $u0, $u1, $u2", [m1, m2, g.word(o)])])
      return true
    } else if op == 3 {
      let (k, kc) = g.const_int(xa[2])
      if kc && k & 63 != 0 {
        g.set(v, [g.def1(false, "add $d0, $u0, $u1, lsl #${k & 63}", [g.word(o), g.word(xa[1])])])
        return true
      }
    }
  }
  false
}

/// Lowers rt.int_wrap(1, a, b) when b, used only there, is a wrapping
/// multiply: msub.
fn (var g: G) fused_sub(v: Int) -> Bool {
  let args = g.f.values[v].args
  let x = g.through_params(args[2])
  let (op, ok) = g.wrap_op(x)
  if !ok || op != 2 || g.nuses[x] != 1 || g.nuses[args[2]] != 1 {
    return false
  }
  let xa = g.f.values[x].args
  let m1 = g.word(xa[1])
  let m2 = g.word(xa[2])
  g.set(v, [g.def1(false, "msub $d0, $u0, $u1, $u2", [m1, m2, g.word(args[1])])])
  true
}

/// The add (op 0) or subtract (op 1) v = a op b with its carry or borrow
/// (decision 0231): when one of the next few values of the block is
/// rt.u64_carry(a, b) (rt.u64_borrow(a, b) for a subtract) not selected
/// yet, one adds or subs gives both, its flag read by cset; whether it
/// did.
fn (var g: G) add_with_flag(v: Int, op: Int) -> Bool {
  if g.cur_sb < 0 {
    return false
  }
  let a = g.f.values[v].args[1]
  let b = g.f.values[v].args[2]
  let want = if op == 0 { "rt.u64_carry" } else { "rt.u64_borrow" }
  let ins = g.f.blocks[g.cur_sb].instrs
  var k = g.cur_ix + 1
  while k < ins.len() && k <= g.cur_ix + 6 {
    let u = ins[k]
    let y = g.f.values[u]
    if y.op == ssa.Op.Call && aux_str(y.aux) == want && !g.has_val[u] && y.args.len() == 2 {
      let same = (y.args[0] == a && y.args[1] == b) || (op == 0 && y.args[0] == b && y.args[1] == a)
      if same {
        let d = g.new_vreg(false)
        let c = g.new_vreg(false)
        let text = if op == 0 { "adds $d0, $u0, $u1\ncset $d1, cs" } else { "subs $d0, $u0, $u1\ncset $d1, cc" }
        let _i = g.plain(text, [d, c], [g.word(a), g.word(b)])
        g.set(v, [d])
        g.set(u, [c])
        return true
      }
    }
    k += 1
  }
  false
}

/// Whether adc pairs chain into one instruction (adc_chain): on since the
/// emitter gives every spilled operand of one instruction a register of
/// its own or fails naming the function (46aacc7d,
/// gotchas/arm64-template-scratch-reuse.md).
const ADC_CHAINS = true

/// Whether a chain is one instruction per pair (the carry passing in the
/// flags from one to the next, as LLVM's adcs runs; nothing selected
/// between them sets flags: the products the chain takes, and the movs
/// of constants and of spills), so that a sum may take a register an
/// operand frees, and a product used once by the chain is made right
/// before its pair. One template for the whole chain (false) kept every
/// sum apart from every operand: nistec.mul4p saved 5 callee saved
/// pairs where LLVM saves 1 (2026-10-17).
const ADC_SPLIT = true

/// The most pairs in one chain instruction: an early template's uses and
/// defs all need registers of their own (2 per pair and one def each, plus
/// the cset), so a longer chain goes on in the next instruction.
const ADC_CHAIN_PAIRS = 8

/// A chain of adds with carry starting at v (rt.u64_adc or
/// rt.u64_adc_carry), as one instruction so that nothing comes between
/// its flag's writer and reader: each pair (a sum and its carry of the
/// same operands) after the first takes the previous pair's carry as its
/// carry in, that carry used by nothing else, and operands defined
/// before the chain. The first pair is adds (or cmp #1 and adcs for a
/// carry in that is not the constant 0), the rest adcs, and one cset
/// reads the last carry. Whether it emitted a chain of two or more pairs.
fn (var g: G) adc_chain(v: Int) -> Bool {
  if g.cur_sb < 0 {
    return false
  }
  let ins = g.f.blocks[g.cur_sb].instrs
  // the pairs: (sum, carry) values
  var sums: List[Int] = []
  var cars: List[Int] = []
  let x = g.f.values[v]
  let sum0 = aux_str(x.aux) == "rt.u64_adc"
  let p0 = g.adc_pair(v, if sum0 { "rt.u64_adc_carry" } else { "rt.u64_adc" })
  if p0 < 0 {
    return false
  }
  sums.push(if sum0 { v } else { p0 })
  cars.push(if sum0 { p0 } else { v })
  // at most ADC_CHAIN_PAIRS pairs (one fewer after cmp, which reads the
  // carry in as a third use); a longer chain goes on in the next
  // instruction, its carry in from this one's cset
  let (_, cin0_k) = g.const_int(x.args[2])
  var cap = ADC_CHAIN_PAIRS
  if g.m.arm64_regs > 0 {
    // the spill test ($XO_ARM64_REGS = N, N caller and N callee saved
    // registers and x15 to x17): a chain of p pairs needs 3 p + 1
    // distinct registers, so it stays within those (N = 2: no chain)
    cap = imin(cap, (2 * g.m.arm64_regs + 3 - 1) / 3)
  }
  // a carry in from a register is a third use; a constant one is not
  let most = if cin0_k { cap } else { cap - 1 }
  var k = g.cur_ix + 1
  while k < ins.len() && k <= g.cur_ix + 8 * ADC_CHAIN_PAIRS && sums.len() < most {
    let last = cars[cars.len() - 1]
    let u = ins[k]
    let y = g.f.values[u]
    if y.op == ssa.Op.Call && aux_str(y.aux) == "rt.u64_adc" && !g.has_val[u] && y.args.len() == 3 && y.args[2] == last {
      let c = g.adc_pair_at(u, k, "rt.u64_adc_carry")
      // the carry in used only by this pair, its operands defined
      // before the chain
      let nu = if c >= 0 { 2 } else { 1 }
      // (a constant operand is defined anywhere: 0 is xzr, any other is
      // made by a mov before the chain's instruction, 2026-10-16:
      // nistec.sub_p256's t + ~p + 1 broke at every pair)
      if g.nuses[last] == nu && g.chain_operand(y.args[0], ins, k, nu) && g.chain_operand(y.args[1], ins, k, nu) {
        sums.push(u)
        cars.push(c)
        if c < 0 {
          break
        }
      }
    }
    k += 1
  }
  if sums.len() < 2 {
    return false
  }
  if ADC_SPLIT {
    g.adc_chain_split(sums, cars)
    return true
  }
  let x0 = g.f.values[sums[0]]
  var us: List[Int] = []
  var text = ""
  let (cin, cin_k) = g.const_int(x0.args[2])
  let b0 = g.adc_op(x0.args[0], us)
  let b1 = g.adc_op(x0.args[1], us)
  if cin_k && cin == 0 {
    text = "adds $d0, ${b0}, ${b1}"
  } else {
    let ct = g.carry_in(x0.args[2], us)
    text = "${ct}adcs $d0, ${b0}, ${b1}"
  }
  var defs = [g.new_vreg(false)]
  for i in 1..sums.len() {
    let y = g.f.values[sums[i]]
    let c0 = g.adc_op(y.args[0], us)
    let c1 = g.adc_op(y.args[1], us)
    defs.push(g.new_vreg(false))
    text = "${text}\nadcs $d${i}, ${c0}, ${c1}"
  }
  let lastc = cars[cars.len() - 1]
  var cv = -1
  if lastc >= 0 {
    cv = g.new_vreg(false)
    text = "${text}\ncset $d${defs.len()}, cs"
    defs.push(cv)
  }
  // early: a sum is written before the later pairs' operands are read,
  // so no def may share a register with a use
  let ii = g.plain(text, defs, us)
  g.blocks[g.cur].insts[ii].early = true
  for i in 0..sums.len() {
    g.set(sums[i], [defs[i]])
  }
  // the carries inside the chain have no reader but the next pair: the
  // flag; they are marked selected
  for i in 0..cars.len() {
    if cars[i] >= 0 {
      g.set(cars[i], [if i == cars.len() - 1 { cv } else { defs[i] }])
    }
  }
  true
}

/// Whether a, an addend of a later pair of a chain (at index k of ins),
/// can be read there: a constant (0 is xzr, any other a mov, which sets
/// no flags), a value defined before the chain, (ADC_SPLIT) a product
/// the chain alone uses (chain_product), or ~b of a b defined before the
/// chain (the pair is sbcs of b: inverted); nu is the pair's size (its
/// sum and carry, or the sum alone).
fn (var g: G) chain_operand(a: Int, ins: List[Int], k: Int, nu: Int) -> Bool {
  g.is_const(a) || g.before_ix(a, ins) || (g.chain_products() && g.chain_product(a, ins, k, nu)) || (ADC_SPLIT && g.inverted(a) >= 0 && g.ready(g.inverted(a), ins))
}

/// Whether a chain makes its products between its pairs (ADC_SPLIT):
/// not where they would write the flags (the amd64 retarget, decision
/// 0254, lowers mul to imul; only moves may come between its links).
fn (g: G) chain_products() -> Bool {
  // not on x86_64: its multiplies write the flags (decision 0254)
  ADC_SPLIT && !g.x86
}

/// Whether a is a product (rt.u64_mul_hi, or rt.int_wrap's multiply)
/// defined after the chain's start and before index k,
/// not selected yet, read by its pair alone (nu uses: the sum and the
/// carry, or the sum), of values defined before the chain: the chain
/// makes it right before its pair (mul and umulh set no flags).
fn (var g: G) chain_product(a: Int, ins: List[Int], k: Int, nu: Int) -> Bool {
  if g.has_val[a] || g.nuses[a] != nu {
    return false
  }
  var at = -1
  for j in (g.cur_ix + 1)..k {
    if ins[j] == a {
      at = j
    }
  }
  if at < 0 {
    return false
  }
  let x = g.f.values[a]
  if x.op != ssa.Op.Call || g.kind(x.ty) != ssa.Kind.Int {
    return false
  }
  let n = aux_str(x.aux)
  if n == "rt.u64_mul_hi" && x.args.len() == 2 {
    return g.ready(x.args[0], ins) && g.ready(x.args[1], ins)
  }
  if n == "rt.int_wrap" && x.args.len() == 3 {
    let (op, opk) = g.const_int(x.args[0])
    return opk && op == 2 && g.ready(x.args[1], ins) && g.ready(x.args[2], ins)
  }
  false
}

/// Whether a chain's product can read a: a value defined before the
/// chain, or a constant (a mov, which sets no flags; x25519's reduction
/// multiplies by 38).
fn (g: G) ready(a: Int, ins: List[Int]) -> Bool {
  g.is_const(a) || g.before_ix(a, ins)
}

/// adc_chain's instructions with ADC_SPLIT: per pair its products not
/// made yet (chain_product), then adds or adcs; the last pair's cset
/// reads its carry. Every pair is keep: a pair whose sum nothing reads
/// still sets the flags the next one reads.
fn (var g: G) adc_chain_split(sums: List[Int], cars: List[Int]) {
  let lastc = cars[cars.len() - 1]
  for i in 0..sums.len() {
    let y = g.f.values[sums[i]]
    for a in [y.args[0], y.args[1]] {
      let p = g.f.values[a]
      if !g.has_val[a] && p.op == ssa.Op.Call && aux_str(p.aux) is "rt.u64_mul_hi" | "rt.int_wrap" {
        let op = if aux_str(p.aux) == "rt.u64_mul_hi" { "umulh" } else { "mul" }
        let n = p.args.len()
        g.set(a, [g.def1(false, "${op} $d0, $u0, $u1", [g.word(p.args[n - 2]), g.word(p.args[n - 1])])])
      }
    }
    // a + ~b with carry in is a - b with the borrow its complement:
    // sbcs a, b sets the carry flag as adcs a, ~b (a constant -1 is ~0:
    // xzr; a Not's operand needs no mvn)
    var a0 = y.args[0]
    var a1 = y.args[1]
    var neg = g.inverted(a1) >= -1
    if !neg && g.inverted(a0) >= -1 {
      a0 = y.args[1]
      a1 = y.args[0]
      neg = true
    }
    var us: List[Int] = []
    let b0 = g.adc_op(a0, us)
    var b1 = ""
    if neg {
      let src = g.inverted(a1)
      if src < 0 {
        b1 = "xzr"
      } else {
        us.push(g.word(src))
        b1 = "$u${us.len() - 1}"
      }
    }
    let (cin, cin_k) = g.const_int(y.args[2])
    let (k1, k1ok) = g.const_int(a1)
    var text = ""
    if i == 0 && cin_k && cin == 0 && !neg && k1ok && k1 > 0 && k1 < 4096 {
      // a small constant addend is adds' immediate (no mov)
      text = "adds $d0, ${b0}, #${k1}"
    } else if i == 0 && cin_k && cin != 0 && neg {
      // a + ~b + 1 is subs a, b (its carry: no borrow)
      text = "subs $d0, ${b0}, ${b1}"
    } else if i == 0 && cin_k && cin == 0 && neg {
      // a + ~b: cmn xzr, xzr clears the carry, then sbcs (a - b - 1)
      text = "cmn xzr, xzr\nsbcs $d0, ${b0}, ${b1}"
    } else {
      if !neg {
        b1 = g.adc_op(a1, us)
      }
      let op = if neg { "sbcs" } else { "adcs" }
      if i == 0 && !(cin_k && cin == 0) {
        let ct = g.carry_in(y.args[2], us)
        text = "${ct}${op} $d0, ${b0}, ${b1}"
      } else if i == 0 {
        text = "adds $d0, ${b0}, ${b1}"
      } else {
        text = "${op} $d0, ${b0}, ${b1}"
      }
    }
    let d = g.new_vreg(false)
    var defs = [d]
    let last = i == sums.len() - 1
    if last && lastc >= 0 {
      defs.push(g.new_vreg(false))
      text = "${text}\ncset $d1, cs"
    }
    let ii = g.plain(text, defs, us)
    g.blocks[g.cur].insts[ii].keep = true
    g.set(sums[i], [d])
    if cars[i] >= 0 {
      // a carry inside the chain has no reader but the next pair (the
      // flag): marked selected
      g.set(cars[i], [if last { defs[1] } else { d }])
    }
  }
}

/// For an addend a of a chain that is ~b: b (a Not's operand), -1 for the
/// constant -1 (~0, xzr), else -2.
fn (g: G) inverted(a: Int) -> Int {
  let (k, kc) = g.const_int(a)
  if kc {
    return if k == -1 { -1 } else { -2 }
  }
  let x = g.f.values[a]
  if x.op == ssa.Op.Not && x.args.len() == 1 && g.kind(x.ty) == ssa.Kind.Int {
    return x.args[0]
  }
  -2
}

/// The instruction setting the carry flag to the carry in a (0 or 1)
/// before adcs: `cmp xzr, xzr` for a constant (1: the flag set, with no
/// register; 0 never reaches here), else `cmp $uK, #1` of its register
/// pushed on us.
fn (var g: G) carry_in(a: Int, var us: List[Int]) -> Str {
  let (k, kc) = g.const_int(a)
  if kc && k != 0 {
    return "cmp xzr, xzr\n"
  }
  us.push(g.word(a))
  "cmp $u${us.len() - 1}, #1\n"
}

/// Whether value a is an Int constant.
fn (g: G) is_const(a: Int) -> Bool {
  let (_, kc) = g.const_int(a)
  kc
}

/// Whether value a is the Int constant 0.
fn (g: G) is_zero(a: Int) -> Bool {
  let (k, kc) = g.const_int(a)
  kc && k == 0
}

/// An addend of adds, adcs, adc, or cmn as template text: `xzr` for a
/// constant 0 (register 31 is the zero register in those encodings),
/// else `$uK` with its register pushed on us.
fn (var g: G) adc_op(a: Int, var us: List[Int]) -> Str {
  let (k, kc) = g.const_int(a)
  if kc && k == 0 {
    return "xzr"
  }
  us.push(g.word(a))
  "$u${us.len() - 1}"
}

/// Whether values a and b are the same operand: one value, or two
/// constants of one value (each literal 0 carry in is a value of its
/// own).
fn (g: G) same_arg(a: Int, b: Int) -> Bool {
  if a == b {
    return true
  }
  let (x, xk) = g.const_int(a)
  let (y, yk) = g.const_int(b)
  if xk && yk {
    return x == y
  }
  // ~v written twice (sub4p's f + ~g + 1: the sum's and the carry's) is
  // two Not values of one operand
  let va = g.f.values[a]
  let vb = g.f.values[b]
  va.op == ssa.Op.Not && vb.op == ssa.Op.Not && va.args.len() == 1 && vb.args.len() == 1 && g.same_arg(va.args[0], vb.args[0])
}

/// Whether value a is defined before the current value: in an earlier
/// block (or a parameter), or earlier in this block's instrs ins.
fn (g: G) before_ix(a: Int, ins: List[Int]) -> Bool {
  for k in 0..ins.len() {
    if ins[k] == a {
      return k < g.cur_ix
    }
  }
  true
}

/// adc_pair for the value u at index k of the block: the call want of
/// u's three operands among the next few values, else -1.
fn (var g: G) adc_pair_at(u: Int, k: Int, want: Str) -> Int {
  let xa = g.f.values[u].args
  let ins = g.f.blocks[g.cur_sb].instrs
  var j = k + 1
  while j < ins.len() && j <= k + 6 {
    let w = ins[j]
    let y = g.f.values[w]
    if y.op == ssa.Op.Call && aux_str(y.aux) == want && !g.has_val[w] && y.args.len() == 3 && g.same_arg(y.args[0], xa[0]) && g.same_arg(y.args[1], xa[1]) && g.same_arg(y.args[2], xa[2]) {
      return w
    }
    j += 1
  }
  -1
}

/// A value among the next few of the block (or the few before it) that
/// is the call want of the same three operands as v and not selected yet
/// (adc's carry, or adc_carry's sum), else -1.
fn (var g: G) adc_pair(v: Int, want: Str) -> Int {
  if g.cur_sb < 0 {
    return -1
  }
  let xa = g.f.values[v].args
  let ins = g.f.blocks[g.cur_sb].instrs
  var k = g.cur_ix + 1
  while k < ins.len() && k <= g.cur_ix + 6 {
    let u = ins[k]
    let y = g.f.values[u]
    if y.op == ssa.Op.Call && aux_str(y.aux) == want && !g.has_val[u] && y.args.len() == 3 && g.same_arg(y.args[0], xa[0]) && g.same_arg(y.args[1], xa[1]) && g.same_arg(y.args[2], xa[2]) {
      return u
    }
    k += 1
  }
  -1
}

/// The add (op 0) or subtract (op 1) v used only by an `and` with
/// 0xFFFFFFFF among the next few values of the block (ChaCha20's adds
/// modulo 2^32): one 32 bit add or sub, which zero extends, gives both;
/// whether it did.
fn (var g: G) add_w32(v: Int, op: Int) -> Bool {
  if g.cur_sb < 0 || g.nuses[v] != 1 {
    return false
  }
  let ins = g.f.blocks[g.cur_sb].instrs
  var k = g.cur_ix + 1
  while k < ins.len() && k <= g.cur_ix + 4 {
    let u = ins[k]
    let y = g.f.values[u]
    if y.op == ssa.Op.And && !g.has_val[u] && y.args.len() == 2 {
      for j in 0..2 {
        if y.args[j] == v {
          let (n, nc) = g.const_int(y.args[1 - j])
          if nc && n == 0xFFFFFFFF {
            let a = g.word(g.f.values[v].args[1])
            let b = g.word(g.f.values[v].args[2])
            let d = g.def1(false, if op == 0 { "add $wd0, $wu0, $wu1" } else { "sub $wd0, $wu0, $wu1" }, [a, b])
            g.set(v, [d])
            g.set(u, [d])
            return true
          }
        }
      }
    }
    k += 1
  }
  false
}

/// A value among the next few of the block that is the call want of the
/// same two operands as v and not selected yet (the other half of a
/// carry-less product), else -1.
fn (var g: G) clmul_pair(v: Int, want: Str) -> Int {
  if g.cur_sb < 0 {
    return -1
  }
  let a = g.f.values[v].args
  let ins = g.f.blocks[g.cur_sb].instrs
  var k = g.cur_ix + 1
  while k < ins.len() && k <= g.cur_ix + 6 {
    let u = ins[k]
    let y = g.f.values[u]
    if y.op == ssa.Op.Call && aux_str(y.aux) == want && !g.has_val[u] && y.args.len() == 2 && y.args[0] == a[0] && y.args[1] == a[1] {
      return u
    }
    k += 1
  }
  -1
}

/// The memory order of argument k of value v (decision 0200): its
/// constant 0 relaxed, 1 acquire, 2 release, 3 acq_rel, 4 seq_cst; a
/// value that is not one of them is seq_cst.
fn (g: G) ord_arg(v: Int, k: Int) -> Int {
  let x = g.f.values[v]
  if k >= x.args.len() {
    return 4
  }
  let (o, ok) = g.const_int(x.args[k])
  if !ok || o < 0 || o > 4 {
    return 4
  }
  o
}

/// The address of the cell (container, index) of an atomic: the list's
/// element, or an Atomic's value (the same layout: a header of three
/// words, then words).
fn (var g: G) cell_addr(v: Int) -> Int {
  let x = g.f.values[v]
  let l = g.word(x.args[0])
  if g.kind(g.vty(x.args[0])) == ssa.Kind.Int {
    // the address form (decision 0207): word i from the address
    let (k0, kc0) = g.const_int(x.args[1])
    if kc0 && k0 >= 0 && 8 * k0 < 4096 {
      return g.def1(false, "add $d0, $u0, #${8 * k0}", [g.real(l)])
    }
    return g.def1(false, "add $d0, $u0, $u1, lsl #3", [g.real(l), g.word(x.args[1])])
  }
  let (k, kc) = g.const_int(x.args[1])
  if kc && k >= 0 && LIST_HDR + 8 * k < 4096 {
    return g.def1(false, "add $d0, $u0, #${LIST_HDR + 8 * k}", [l])
  }
  let b = g.def1(false, "add $d0, $u0, $u1, lsl #3", [l, g.word(x.args[1])])
  g.def1(false, "add $d0, $u0, #${LIST_HDR}", [b])
}

/// The base register and byte offset of the word a slot atomic names
/// with a constant index (as cell_addr's), when the offset fits an ldr or
/// str's scaled immediate; else (-1, 0).
fn (var g: G) cell_base_off(v: Int) -> (Int, Int) {
  let x = g.f.values[v]
  let (k, kc) = g.const_int(x.args[1])
  if !kc || k < 0 {
    return (-1, 0)
  }
  let int_form = g.kind(g.vty(x.args[0])) == ssa.Kind.Int
  let off = if int_form { 8 * k } else { LIST_HDR + 8 * k }
  if off > 32760 {
    return (-1, 0)
  }
  let l = g.word(x.args[0])
  (if int_form { g.real(l) } else { l }, off)
}

/// Adds an atomic instruction defining one register: kept when its
/// result is dead and never folded into a branch (keep); early, since a
/// template may write its result before it reads every operand.
/// atomic_def with an x86 template and its fixed registers (decision
/// 0254).
fn (var g: G) x86_atomic_def(text: Str, us: List[Int], clob: List[Int]) -> Int {
  let d = g.atomic_def(text, us)
  let b = g.cur
  let i = g.blocks[b].insts.len() - 1
  g.blocks[b].insts[i].x86 = true
  g.blocks[b].insts[i].clobbers = clob
  d
}

fn (var g: G) atomic_def(text: Str, us: List[Int]) -> Int {
  let d = g.new_vreg(false)
  let i = g.plain(text, [d], us)
  let b = g.cur
  g.blocks[b].insts[i].early = true
  g.blocks[b].insts[i].keep = true
  g.clobber()
  d
}

/// Sets v, an Int or a Bool (a Bool cell holds 0 or 1), to register r.
fn (var g: G) atomic_result(v: Int, r: Int) {
  let x = g.f.values[v]
  match g.kind(x.ty) {
    Int | Bool => g.set(v, [r])
    _ => {
      g.fail("the atomic `${aux_str(x.aux)}` returns a `${g.tname(x.ty)}`")
      g.set(v, g.zeros(x.ty))
    }
  }
}

/// --race on Linux (decision 0273): an outline atomic's call (a call, so
/// race.xo, which reads instructions, does not see it as an atomic)
/// tells ThreadSanitizer its order itself, as race.xo does around
/// darwin's LSE instruction: __tsan_release before it when it releases,
/// __tsan_acquire after it when it acquires; not in the runtime's code
/// (race_unchecked: its function, or the innermost inline site of value
/// v). Without it a synchronized Atomic.add reported a race
/// (race_sync's atomic_add on linux/arm64).
fn (g: G) race_checks(v: Int) -> Bool {
  if !g.m.race || race_unchecked(g.f.file) {
    return false
  }
  let k = g.f.values[v].inl
  !(k >= 0 && k < g.f.inl_sites.len() && race_unchecked(g.f.inl_sites[k].file))
}

fn (var g: G) race_release(v: Int, ord: Int, a: Int) {
  if ord >= 2 && g.race_checks(v) {
    let _r = g.rt(g.race_sym("__tsan_release"), [rsrc(a)], [])
  }
}

fn (var g: G) race_acquire(v: Int, ord: Int, a: Int) {
  if (ord == 1 || ord >= 3) && g.race_checks(v) {
    let _r = g.rt(g.race_sym("__tsan_acquire"), [rsrc(a)], [])
  }
}

/// Lowers the atomics and fences of decision 0200 inline: on darwin the
/// LSE instructions every Apple arm64 CPU has (ldar, stlr, swp, cas,
/// ldadd with the order's a and l; dmb, yield); on linux, which also runs
/// on ARMv8.0, loads, stores, and fences inline and the read modify
/// writes as calls of libgcc's outline atomics (__aarch64_cas8_acq_rel
/// and friends), as the C runtime's -moutline-atomics objects do
/// (compiler/macho elflink.xo writes them when it links without cc).
fn (var g: G) atomic(v: Int) {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  if name == "rt.spin_hint" {
    g.store("yield", [])
    g.set(v, [])
    return
  }
  if name == "rt.fence" {
    match g.ord_arg(v, 0) {
      0 => {}
      1 => g.store("dmb ishld", [])
      _ => g.store("dmb ish", [])
    }
    g.set(v, [])
    return
  }
  if name == "rt.slot_addr" {
    g.set(v, [g.cell_addr(v)])
    return
  }
  if (name == "rt.slot_load" || name == "rt.slot_store") && g.ord_arg(v, x.args.len() - 1) == 0 {
    // relaxed with a constant index: a plain ldr or str at the base plus
    // the word's offset, no add (2026-10-16: stdio's relaxed length
    // store was an add and a str)
    let (base, off) = g.cell_base_off(v)
    if base >= 0 {
      if name == "rt.slot_load" {
        g.atomic_result(v, g.atomic_def("ldr $d0, [$u0, #${off}]", [base]))
      } else {
        g.store("str $u0, [$u1, #${off}]", [g.word(x.args[2]), base])
        g.set(v, [])
      }
      return
    }
  }
  let a = g.cell_addr(v)
  // the order of a read modify write: none, acquire, release, both
  let ord = g.ord_arg(v, x.args.len() - 1)
  let sfx = ["", "a", "l", "al", "al"][ord]
  let model = ["relax", "acq", "rel", "acq_rel", "acq_rel"][ord]
  match name {
    "rt.slot_load" => {
      let ins = if ord == 0 { "ldr" } else { "ldar" }
      g.atomic_result(v, g.atomic_def("${ins} $d0, [$u0]", [a]))
    }
    "rt.slot_store" => {
      let ins = if ord == 0 { "str" } else { "stlr" }
      g.store("${ins} $u0, [$u1]", [g.word(x.args[2]), a])
      g.set(v, [])
    }
    "rt.slot_swap" | "rt.slot_add" => {
      let val = g.word(x.args[2])
      let op = if name == "rt.slot_swap" { "swp" } else { "ldadd" }
      if g.x86 {
        // xchg and lock xadd: sequentially consistent, every order's
        // (an x86 template, which race.xo does not read: the order told
        // around it, as the outline atomics below)
        let t = if name == "rt.slot_swap" { "xchgq" } else { "lock xaddq" }
        g.race_release(v, ord, a)
        g.atomic_result(v, g.x86_atomic_def("movq $u0, $d0\n${t} $d0, ($u1)", [val, a], []))
        g.race_acquire(v, ord, a)
      } else if g.os == "darwin" {
        g.atomic_result(v, g.atomic_def("${op}${sfx} $u0, $d0, [$u1]", [val, a]))
      } else {
        g.race_release(v, ord, a)
        let r = g.rt("__aarch64_${op}8_${model}", [rsrc(val), rsrc(a)], [false])
        g.race_acquire(v, ord, a)
        g.atomic_result(v, r[0])
      }
    }
    _ => {
      // rt.slot_cas: the old value seen, compared with the expected one
      let old = g.word(x.args[2])
      let new = g.word(x.args[3])
      if g.x86 {
        g.race_release(v, ord, a)
        g.set(v, [g.x86_atomic_def("movq $u0, %rax\nlock cmpxchgq $u1, ($u2)\nsete $bd0\nmovzbl $bd0, $wd0", [old, new, a], [0])])
        g.race_acquire(v, ord, a)
      } else if g.os == "darwin" {
        g.set(v, [g.atomic_def("mov $d0, $u0\ncas${sfx} $d0, $u1, [$u2]\ncmp $d0, $u0\ncset $d0, eq", [old, new, a])])
      } else {
        g.race_release(v, ord, a)
        let r = g.rt("__aarch64_cas8_${model}", [rsrc(old), rsrc(new), rsrc(a)], [false])
        g.race_acquire(v, ord, a)
        g.set(v, [g.def1(false, "cmp $u0, $u1\ncset $d0, eq", [r[0], old])])
      }
    }
  }
}

/// Lowers a call of the task runtime (`rt.name` is the C function
/// xo_name, decision 0068): an Int, Bool, List, or handle is one word, a
/// Str its bytes and length; the result is nothing or one word.
fn (var g: G) rt_call(v: Int) {
  if aux_str(g.f.values[v].aux).starts_with("rt.pc.") {
    g.platform_call(v)
    return
  }
  if g.inline_rt(v) {
    return
  }
  let x = g.f.values[v]
  let name0 = aux_str(x.aux)
  var args: List[Src] = []
  // `rt.rs_*` functions take their Str operands as the string object
  // (the first is consumed, decision 0074); the others its bytes
  let obj = name0.starts_with("rt.rs_")
  for a in x.args {
    let ws = g.words(a)
    match g.vkind(a) {
      Int | Bool | List | Handle | Float => args.push(rsrc(ws[0]))
      Str => {
        if obj {
          args.push(rsrc(ws[0]))
          args.push(rsrc(ws[1]))
        } else {
          let d = g.str_data(ws)
          args.push(rsrc(d))
          args.push(rsrc(g.str_len(ws)))
        }
      }
      // a closure as its two words, code and environment (rt.task_spawn)
      Func => {
        args.push(rsrc(ws[0]))
        args.push(rsrc(ws[1]))
      }
      _ => g.fail("the runtime call `${name0}` takes a `${g.tname(g.vty(a))}`")
    }
  }
  var name = "xo_${name0.trim_prefix("rt.")}"
  if name0 is "rt.rs_append" | "rt.rs_push_byte" | "rt.rs_push_word" | "rt.rs_push_words" | "rt.rs_append_bytes" | "rt.rs_with_cap" {
    // obj.xo's string builders through their exports, with no C level
    name = "xo_x_obj_${name0.trim_prefix("rt.")}"
  }
  if name0 is "rt.shield_begin" | "rt.shield_end" | "rt.shield_abort" | "rt.unwinding" {
    // ctx.xo's shields through their exports (decision 0229)
    name = "xo_x_ctx_${name0.trim_prefix("rt.")}"
  }
  if name0 is "rt.sched_hook" | "rt.task_done" | "rt.task_unwound" | "rt.task_await" | "rt.task_result" | "rt.scope_fail_task" | "rt.scope_fail_site" | "rt.scope_group" | "rt.fault_rethrow" | "rt.scope_cancel" | "rt.prog_group_set" | "rt.prog_group_clear" | "rt.prog_group" | "rt.task_spawn" | "rt.task_spawn_fn" | "rt.task_wanted" | "rt.scope_open" | "rt.scope_close" | "rt.mutex_new" | "rt.mutex_lock" | "rt.mutex_unlock" | "rt.mutex_rlock" | "rt.mutex_runlock" | "rt.chan_new" | "rt.chan_send" | "rt.chan_recv" | "rt.chan_try_send" | "rt.chan_try_recv" | "rt.chan_close" | "rt.chan_len" | "rt.select_new" | "rt.select_recv" | "rt.select_send" | "rt.select_wait" | "rt.select_take" | "rt.atomic_new" | "rt.const_once" {
    // tasks.xo through its exports (B18), likewise
    name = "xo_x_${name0.trim_prefix("rt.")}"
  }
  if name0 is "rt.tick" | "rt.budget_open" | "rt.budget_end" {
    // budget.xo through its exports, likewise
    name = "xo_x_budget_${name0.trim_prefix("rt.").trim_prefix("budget_")}"
  }
  if name0 is "rt.fault_raise" | "rt.fault_continue" | "rt.fault_take" | "rt.fault_msg" | "rt.fault_loc" | "rt.fault_detail" | "rt.fault_at" {
    // fault.xo's raise, continue, and record through their exports,
    // likewise
    name = "xo_x_${name0.trim_prefix("rt.")}"
  }
  if name0 is "rt.heap_big" | "rt.heap_big_resize" | "rt.heap_big_release" | "rt.heap_grow" | "rt.heap_lock" | "rt.heap_unlock" | "rt.any_new" | "rt.any_get" | "rt.any_take" {
    // heapos.xo's platform calls (B21) and anyval.xo through their
    // exports, likewise
    name = "xo_x_${name0.trim_prefix("rt.")}"
  }
  let own = ssa.rt_export(name0)
  if !own.is_empty() {
    // the net, clock and scope checks, shutdown and real-time sections
    // (ssa/exports.xo, shared with LLVM)
    name = own
  }
  match g.kind(x.ty) {
    Unit => {
      let _r = g.rt(name, args, [])
      g.set(v, [])
    }
    Int | Bool | List | Handle => {
      let r = g.rt(name, args, [false])
      if ssa.rt_export_none(name0) {
        // 0 for none: the zero handle or the empty list (ssa/exports.xo)
        let none = g.sym_addr(g.sym(if g.vkind(v) == ssa.Kind.List { "xo_empty_list" } else { "xo_zero_handle" }))
        g.set(v, [g.def1(false, "cmp $u0, #0\ncsel $d0, $u1, $u0, eq", [r[0], none])])
      } else {
        g.set(v, r)
      }
    }
    Float => g.set(v, g.rt(name, args, [true]))
    Str => {
      // the string object; its length in the frame's out slot
      let o = g.rt(name, args + [framesrc()], [false])
      let n = g.def1(false, "ldr $d0, [sp, #$OUT]", [])
      g.set(v, [o[0], n])
    }
    _ => {
      g.fail("the runtime call `${name0}` returns a `${g.tname(x.ty)}`")
      g.set(v, g.zeros(x.ty))
    }
  }
}

/// The parts of a platform call's name `rt.pc.<os>.<sym>[/<n>]`
/// (decision 0213): the OS, the C symbol, and the number of fixed
/// parameters of a variadic function (-1 when it is not one).
pub fn platform_parts(name: Str) -> (Str, Str, Int) {
  let rest = name.trim_prefix("rt.pc.")
  let parts = rest.split(".")
  if parts.len() < 2 {
    return ("", rest, -1)
  }
  let sv = parts[1].split("/")
  var n = -1
  if sv.len() == 2 {
    n = Int.parse(sv[1]) ?? -1
  }
  (parts[0], sv[0], n)
}

/// The directive that makes sym a weak reference (decision 0232): the
/// linker leaves it 0 when nothing defines it (macOS's ld needs `-U` for
/// that, which the driver adds for each weak reference). Always written:
/// drop_own_weak removes it from the module's text when the module
/// defines sym, so a function's text (the per-function cache's entry)
/// does not depend on the module (2026-10-17: it did, and a libc build's
/// entry gave a no-libc build `.weak` lines).
fn (var g: G) weak_ref(sym: Str) {
  if g.x86 && g.os == "windows" {
    // COFF: an `/alternatename` to xo_absent (x86win.xo w64_weak), not
    // a weak external with its default symbol
    g.wsyms[sym] = true
    return
  }
  let d = if g.os == "darwin" { ".weak_reference" } else { ".weak" }
  g.store("${d} ${g.sym(sym)}", [])
}

/// text without the weak references (weak_ref) to the symbols the module
/// exports (an XO_NOLIBC build's C library, cabi_libc.xo:
/// __errno_location): `.weak` and then `.globl` is an error in LLVM's
/// assembler ("changed binding to STB_GLOBAL").
/// One pass over text (2026-10-17: a replace over the whole text per
/// export was quadratic, 46 minutes for the compiler with DWARF types).
fn (g: G) drop_own_weak(text: Str) -> Str { drop_weak_in(g.own_exports(), g.os, text) }

/// The symbols of the functions the module exports (drop_own_weak).
fn (g: G) own_exports() -> Map[Str, Bool] {
  var own: Map[Str, Bool] = {}
  for f in g.m.funcs {
    if !f.export.is_empty() {
      own[g.sym(f.export)] = true
    }
  }
  own
}

/// drop_own_weak's pass over text for the exported symbols own, the
/// assembly of os.
fn drop_weak_in(own: Map[Str, Bool], os: Str, text: Str) -> Str {
  if own.is_empty() {
    return text
  }
  let d = if os == "darwin" { ".weak_reference" } else { ".weak" }
  let pb = "\t${d} ".bytes()
  let tb = text.bytes()
  let n = tb.len()
  var out = StrBuilder.new()
  var from = 0
  var i = 0
  while i < n {
    // the line [i, j)
    var j = i
    while j < n && tb[j] != '\n' {
      j += 1
    }
    if j - i > pb.len() && tb[i] == '\t' && tb[i + 1] == '.' && tb[i + 2] == 'w' {
      var k = 0
      while k < pb.len() && tb[i + k] == pb[k] {
        k += 1
      }
      if k == pb.len() && own.contains(text[i + k..j]) {
        out.write(text[from..i])
        from = if j < n { j + 1 } else { j }
      }
    }
    i = j + 1
  }
  if from < n {
    out.write(text[from..n])
  }
  out.freeze()
}

/// rt.sym_addr (decision 0234): the address of the C level symbol name,
/// directly for xo_entry and the C library's data symbols of an
/// XO_NOLIBC build (this module defines them), any other's through the
/// GOT, as one in a shared library (libSystem, glibc) has no fixed
/// distance from the code (on Windows directly, UNTESTED).
fn (var g: G) c_sym_addr(name: Str) -> Int {
  if name == "xo_entry" || g.os == "windows" || (g.m.nolibc && ssa.nolibc_data().contains(name)) {
    return g.sym_addr(g.sym(name))
  }
  let s = g.sym(name)
  let load = if g.os == "darwin" { "adrp $d0, ${s}@GOTPAGE\nldr $d0, [$d0, ${s}@GOTPAGEOFF]" } else { "adrp $d0, :got:${s}\nldr $d0, [$d0, :got_lo12:${s}]" }
  g.def1(false, load, [])
}

/// rt.sym_present (decision 0232): sym's address through the GOT,
/// compared with 0 (UNTESTED on Linux; false on Windows, where the
/// arm64 emitter makes no weak references yet).
fn (var g: G) sym_present(v: Int, sym: Str) {
  if g.x86 && g.os == "windows" {
    // the symbol, or xo_absent through its `/alternatename` (x86win.xo)
    g.wsyms[sym] = true
    let a = g.sym_addr(g.sym(sym))
    let n = g.sym_addr(g.sym("xo_absent"))
    g.set(v, [g.def1(false, "cmp $u0, $u1\ncset $d0, ne", [a, n])])
    return
  }
  if g.os == "windows" {
    g.set(v, [g.def1(false, "mov $d0, #0", [])])
    return
  }
  g.weak_ref(sym)
  let s = g.sym(sym)
  let load = if g.os == "darwin" { "adrp $d0, ${s}@GOTPAGE\nldr $d0, [$d0, ${s}@GOTPAGEOFF]" } else { "adrp $d0, :got:${s}\nldr $d0, [$d0, :got_lo12:${s}]" }
  // the compare its own instruction: a branch on the result folds it
  let addr = g.def1(false, load, [])
  g.set(v, [g.def1(false, "cmp $u0, #0\ncset $d0, ne", [addr])])
}

/// Lowers a call of a platform library function (decision 0213,
/// std/native/sys_<os>.xo): a call of the bare C symbol with the C ABI,
/// an Int or Int32 argument one word, a Float a double, Bytes its data
/// address (the value stays alive across the call as its operand); an
/// Int32 result sign extended from 32 bits, a UInt32 one zero extended.
/// Apple arm64 passes the variadic arguments of open, fcntl, and ioctl
/// on the stack, 8 bytes each. A call for another OS (the arm of a
/// `match` on `target.os` the passes keep) is a trap.
fn (var g: G) platform_call(v: Int) {
  let x = g.f.values[v]
  let (os, sym, nfixed) = platform_parts(aux_str(x.aux))
  if os == "cp" {
    g.sym_present(v, sym)
    return
  }
  // a weak C function on Windows: rt.sym_present is false there, so its
  // calls never run (no weak references on COFF yet)
  if (os != g.os && os != "c" && os != "cw") || (os == "cw" && g.os == "windows" && !g.x86) {
    g.store("brk #1", [])
    g.set(v, g.zeros(x.ty))
    return
  }
  if os == "cw" {
    g.weak_ref(sym)
  }
  var args: List[Src] = []
  var us: List[Int] = []
  for a in x.args {
    let ws = g.words(a)
    match g.vkind(a) {
      Int | Float => {
        args.push(rsrc(ws[0]))
        us.push(ws[0])
      }
      Str => {
        let d = g.str_data(ws)
        args.push(rsrc(d))
        us.push(d)
      }
      _ => {
        g.fail("the platform call `${sym}` takes a `${g.tname(g.vty(a))}`")
        g.set(v, g.zeros(x.ty))
        return
      }
    }
  }
  var res: List[Bool] = []
  match g.kind(x.ty) {
    Unit => {}
    Int => res = [false]
    Float => res = [true]
    _ => {
      g.fail("the platform call `${sym}` returns a `${g.tname(x.ty)}`")
      g.set(v, g.zeros(x.ty))
      return
    }
  }
  var call_sym = g.sym(sym)
  if g.x86 && g.os == "windows" {
    if os == "cw" {
      g.wsyms[sym] = true
    }
    // Win64 through a thunk (x86win.xo)
    var sig = StrBuilder.new()
    for a in x.args {
      sig.write(if g.vkind(a) == ssa.Kind.Float { "f" } else { "i" })
    }
    call_sym = g.w64_sym(sym, sig.freeze())
  }
  var vfix = -1
  if g.os == "darwin" {
    // Apple arm64 passes the variadic arguments on the stack; x86_64's
    // System V passes them as the others, with the vector registers'
    // count in al (-3: the emitter zeroes al before the call)
    vfix = if g.x86 { -3 } else { nfixed }
  }
  let defs = g.new_vregs(res)
  var real: List[Int] = []
  for u in us {
    if u != 0 {
      real.push(u)
    }
  }
  let _i = g.add(Inst{kind: K_CALL, sym: call_sym, srcs: args, defs: defs, us: real, vfix: vfix})
  g.clobber()
  if res.is_empty() {
    g.set(v, [])
    return
  }
  let t = g.m.types[x.ty]
  if t.kind == ssa.Kind.Int && t.bits == 32 {
    let ext = if t.unsigned { "mov $wd0, $wu0" } else { "sxtw $d0, $wu0" }
    g.set(v, [g.def1(false, ext, [defs[0]])])
    return
  }
  g.set(v, defs)
}

/// Whether list.set v stores into the slot a list.take of the same list
/// value and index emptied (`g[i][j] += 1`: take g[i], set its element,
/// set it back): the slot holds the take's placeholder, which releasing
/// ignores, so its release (a call, which also kept the loop's constants
/// in it, hoist_consts) is left out (2026-10-17, grid).
fn (g: G) after_take(v: Int) -> Bool {
  let x = g.f.values[v]
  let l = g.f.values[x.args[0]]
  if l.op != ssa.Op.Field || aux_int(l.aux) != 0 || l.args.len() != 1 {
    return false
  }
  let t = g.f.values[l.args[0]]
  t.op == ssa.Op.Call && aux_str(t.aux) == "list.take" && t.args.len() == 2 && t.args[1] == x.args[1]
}
