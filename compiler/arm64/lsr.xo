// Loop optimizations (internal/arm64 lsr.go, decision 0054): strength
// reduction and the facts of loop indexes (on the SSA, during
// selection), rotation at a bounds check (emission), load pairs (a text
// peephole), and latch layout (on the MIR, before allocation).
//
// A pointer induction variable: in a loop whose header H has an Int
// parameter i that every back edge passes as i + c, an element access
// xs[i] of a list whose buffer cannot move in the loop gets a second
// parameter of H, p = xs + i * size, which the back edges advance by c *
// size and the entry edges compute once.

use github.com/xo-lang/xo/compiler/ssa

/// Whether SSA block a dominates b (idom: immediate dominators, -1 for
/// the entry and the blocks not reached).
fn dominates_b(idom: List[Int], entry: Int, a: Int, b0: Int) -> Bool {
  var b = b0
  while b >= 0 {
    if a == b {
      return true
    }
    if b == entry {
      return false
    }
    let d = idom[b]
    if d < 0 {
      return false
    }
    b = d
  }
  false
}

/// Finds the loops of the function and their pointer induction
/// variables (planLSR).
fn (var g: G) plan_lsr(blocks: List[Int], idom: List[Int]) {
  g.lsr = {}
  g.plans = []
  let nb = g.f.blocks.len()
  let entry = blocks[0]
  var reach: List[Bool] = []
  for _ in 0..nb {
    reach.push(false)
  }
  for b in blocks {
    reach[b] = true
  }
  var bodies: Map[Int, List[Bool]] = {}
  for b in blocks {
    let t = g.f.term(b)
    if t < 0 {
      continue
    }
    for e in g.f.values[t].succs {
      let h = g.f.edges[e].to
      if !dominates_b(idom, entry, h, b) || h == entry {
        continue
      }
      var body: List[Bool] = []
      if let Some(bd) = bodies.get(h) {
        body = bd
      } else {
        for _ in 0..nb {
          body.push(false)
        }
        body[h] = true
      }
      var work = [b]
      while !work.is_empty() {
        let x = work.pop() ?? 0
        if body[x] || !reach[x] {
          continue
        }
        body[x] = true
        for pe in g.f.blocks[x].preds {
          work.push(g.f.edges[pe].from)
        }
      }
      bodies[h] = body
    }
  }
  for h in blocks {
    let body = bodies.get(h) ?? []
    if body.is_empty() {
      continue
    }
    var lp = LsrLoop{body: body}
    for e in g.f.blocks[h].preds {
      let from = g.f.edges[e].from
      if !reach[from] {
        continue
      }
      if body[from] {
        lp.latches.push(e)
      } else {
        lp.entries.push(e)
      }
    }
    if lp.entries.is_empty() {
      continue
    }
    for (k, p) in g.f.blocks[h].params.indexed() {
      if g.vkind(p) == ssa.Kind.Int {
        var up = true
        var down = true
        for e in lp.latches {
          let (c, ok) = g.step_of(p, g.f.edges[e].args[k])
          up = up && ok && c >= 0
          down = down && ok && c <= 0
        }
        if up {
          lp.up.push(k)
        }
        if down {
          lp.down.push(k)
        }
      }
    }
    var iv_idx: Map[Int, Int] = {}
    for (k, iv) in g.f.blocks[h].params.indexed() {
      if g.vkind(iv) == ssa.Kind.Int && g.iv_step(iv, k, lp.latches) {
        iv_idx[iv] = k
      }
    }
    for b in blocks {
      if !body[b] {
        continue
      }
      // blocks that run on every iteration
      var every = true
      for e in lp.latches {
        if !dominates_b(idom, entry, b, g.f.edges[e].from) {
          every = false
          break
        }
      }
      for v in g.f.blocks[b].instrs {
        let x = g.f.values[v]
        if x.op != ssa.Op.Call || x.args.len() < 2 {
          continue
        }
        let name = aux_str(x.aux)
        if name != "list.index" && name != "list.set" {
          continue
        }
        let (dl, dli) = g.data_list(h, v, body, lp.latches)
        if dl >= 0 {
          var ddup = false
          for pi in lp.plans {
            ddup = ddup || (g.plans[pi].data && g.plans[pi].list == dl)
          }
          if !ddup {
            lp.plans.push(g.plans.len())
            g.plans.push(LsrPlan{iv: -1, iv_idx: -1, list: dl, list_idx: dli, es: 0, head: h, data: true})
          }
        }
        if !every {
          continue
        }
        let iv = x.args[1]
        let k = iv_idx.get(iv) ?? -1
        if k < 0 {
          continue
        }
        let (l, li) = g.stable_list(x.args[0], h, body, lp.latches)
        if l < 0 {
          continue
        }
        let es = g.esize(g.m.types[g.vty(l)].elems[0])
        if es == 0 || es & (es - 1) == 0 {
          continue // xs + i << k is one instruction already
        }
        var dup = false
        for pi in lp.plans {
          dup = dup || (g.plans[pi].iv == iv && g.plans[pi].list == l)
        }
        if !dup {
          lp.plans.push(g.plans.len())
          g.plans.push(LsrPlan{iv: iv, iv_idx: k, list: l, list_idx: li, es: es, head: h})
        }
      }
    }
    g.lsr[h] = lp
  }
}

/// The list of access v whose data address a plan of the loop of h
/// (body) can hold (dataPlan, decision 0208): a one word element at an
/// index that is not a constant, of a list whose buffer the loop cannot
/// move; and its parameter index. The list is -1 when none.
fn (var g: G) data_list(h: Int, v: Int, body: List[Bool], latches: List[Int]) -> (Int, Int) {
  let x = g.f.values[v]
  let (_, kc) = g.const_int(x.args[1])
  if kc {
    return (-1, 0)
  }
  let et = g.m.types[g.vty(x.args[0])].elems[0]
  if g.kind(et) != ssa.Kind.Bool && (g.esize(et) != 8 || g.layout(et).len() != 1) {
    return (-1, 0)
  }
  g.stable_list(x.args[0], h, body, latches)
}

/// Whether every back edge passes parameter iv (index k) as iv, iv + c,
/// or iv - c.
fn (g: G) iv_step(iv: Int, k: Int, latches: List[Int]) -> Bool {
  for e in latches {
    let (_, ok) = g.step_of(iv, g.f.edges[e].args[k])
    if !ok {
      return false
    }
  }
  true
}

/// c when a is iv + c.
fn (g: G) step_of(iv: Int, a: Int) -> (Int, Bool) {
  if a == iv {
    return (0, true)
  }
  let x = g.f.values[a]
  if (x.op != ssa.Op.Add && x.op != ssa.Op.Sub) || g.kind(x.ty) != ssa.Kind.Int {
    return (0, false)
  }
  let swap = x.op == ssa.Op.Add && x.args[1] == iv
  let p = if swap { x.args[1] } else { x.args[0] }
  let q = if swap { x.args[0] } else { x.args[1] }
  let (c, ok) = g.const_int(q)
  if p != iv || !ok || c == MIN_INT {
    return (0, false)
  }
  if x.op == ssa.Op.Sub {
    return (-c, true)
  }
  (c, true)
}

/// The list whose buffer xs is in the loop of h (body), when that buffer
/// cannot move in the loop: a list defined outside the loop, or a
/// parameter of h that every back edge passes back updated in place. The
/// index is the parameter's, or -1; the list is -1 when none.
fn (g: G) stable_list(xs: Int, h: Int, body: List[Bool], latches: List[Int]) -> (Int, Int) {
  let l = g.strip_set(xs)
  if !body[g.f.values[l].block] {
    return (l, -1)
  }
  var k = -1
  for (i, p) in g.f.blocks[h].params.indexed() {
    if p == l {
      k = i
    }
  }
  if k < 0 {
    return (-1, 0)
  }
  for e in latches {
    var seen: Map[Int, Bool] = {}
    if g.in_place_buf(g.f.edges[e].args[k], l, h, body, seen) != l {
      return (-1, 0)
    }
  }
  (l, k)
}

/// Follows list.set results to the list they update.
fn (g: G) strip_set(v0: Int) -> Int {
  var v = v0
  while g.f.values[v].op == ssa.Op.Call && aux_str(g.f.values[v].aux) == "list.set" {
    v = g.f.values[v].args[0]
  }
  v
}

/// The value whose buffer v shares within the loop: through list.set and
/// through parameters of blocks of the loop (not h) that receive one
/// buffer only; -1 when unknown (inPlace).
fn (g: G) in_place_buf(v0: Int, root: Int, h: Int, body: List[Bool], var seen: Map[Int, Bool]) -> Int {
  let v = g.strip_set(v0)
  let vb = g.f.values[v].block
  if v == root || !body[vb] || vb == h || !g.is_param(v) {
    if v == root {
      return root
    }
    return -1
  }
  if seen.contains(v) {
    return root // a cycle through v adds no other buffer
  }
  seen[v] = true
  var k = -1
  for (i, p) in g.f.blocks[vb].params.indexed() {
    if p == v {
      k = i
    }
  }
  for e in g.f.blocks[vb].preds {
    if g.in_place_buf(g.f.edges[e].args[k], root, h, body, seen) != root {
      return -1
    }
  }
  root
}

/// Adds the pointer parameters of header b.
fn (var g: G) lsr_params(b: Int) {
  for pi in g.plans_of(b) {
    g.plans[pi].p = g.new_vreg(false)
  }
}

fn (g: G) plans_of(b: Int) -> List[Int] {
  if let Some(lp) = g.lsr.get(b) {
    return lp.plans
  }
  []
}

/// What holds of argument a at the end of the block edge e leaves: the
/// memo and a's register, or -1.
fn (g: G) edge_at(e: Int, a: Int) -> (Int, Int) {
  let em = g.end_memo[g.f.edges[e].from]
  if em < 0 || !g.has_val[a] || g.vals[a].len() != 1 || g.vals[a][0] == 0 {
    return (-1, 0)
  }
  (em, g.vals[a][0])
}

/// Starts the memo of loop header b: the address memo with its pointers,
/// and the bounds of its induction variables from their initial values.
fn (var g: G) lsr_header(b: Int) {
  if !g.lsr.contains(b) {
    return
  }
  let lp = g.lsr.get(b) ?? LsrLoop{}
  let _mi = g.m_()
  for pi in lp.plans {
    let p = g.plans[pi]
    if p.data {
      g.cm.bases[(g.vals[p.list][0], 0, -24)] = p.p
      continue
    }
    let l = g.vals[p.list][0]
    let i = g.vals[p.iv][0]
    g.cm.bases[(l, i, p.es)] = p.p
  }
  let params = g.f.blocks[b].params
  for k in lp.up {
    var lo = MAX_INT
    for e in lp.entries {
      let a = g.f.edges[e].args[k]
      let (c, ok) = g.const_int(a)
      var x = c
      if !ok {
        let (em, w) = g.edge_at(e, a)
        if em < 0 {
          lo = MIN_INT
          break
        }
        match g.memo_at(em).lo.get(w) {
          Some(y) => x = y
          None => {
            lo = MIN_INT
            break
          }
        }
      }
      lo = imin(lo, x)
    }
    if lo > MIN_INT {
      g.cm.lo[g.vals[params[k]][0]] = lo
    }
  }
  for k in lp.down {
    var hi = MIN_INT
    for e in lp.entries {
      let a = g.f.edges[e].args[k]
      let (c, ok) = g.const_int(a)
      var x = c
      if !ok {
        let (em, w) = g.edge_at(e, a)
        if em < 0 {
          hi = MAX_INT
          break
        }
        match g.memo_at(em).hi.get(w) {
          Some(y) => x = y
          None => {
            hi = MAX_INT
            break
          }
        }
      }
      hi = imax(hi, x)
    }
    if hi < MAX_INT {
      g.cm.hi[g.vals[params[k]][0]] = hi
    }
  }
}

/// Adds the moves of the pointer parameters along edge e.
fn (var g: G) lsr_moves(e: Int, dsts0: List[Int], srcs0: List[Src]) -> (List[Int], List[Src]) {
  var dsts = dsts0
  var srcs = srcs0
  let to = g.f.edges[e].to
  let from = g.f.edges[e].from
  for pi in g.plans_of(to) {
    let p = g.plans[pi]
    if p.data {
      // the data address: the same on the back edges
      let dbody = (g.lsr.get(p.head) ?? LsrLoop{}).body
      if dbody[from] {
        continue
      }
      var dl = 0
      if p.list_idx >= 0 {
        dl = g.words(g.f.edges[e].args[p.list_idx])[0]
      } else {
        dl = g.vals[p.list][0]
      }
      dsts.push(p.p)
      srcs.push(rsrc(g.data_addr(g.real(dl))))
      continue
    }
    let a = g.f.edges[e].args[p.iv_idx]
    let body = (g.lsr.get(p.head) ?? LsrLoop{}).body
    if body[from] {
      let (c, _) = g.step_of(p.iv, a)
      if c == 0 {
        continue
      }
      let n = c * p.es
      var d = 0
      if addsub_imm(n) {
        d = g.def1(false, "add $d0, $u0, #${n}", [p.p])
      } else if addsub_imm(-n) {
        d = g.def1(false, "sub $d0, $u0, #${-n}", [p.p])
      } else {
        d = g.def1(false, "add $d0, $u0, $u1", [p.p, g.cimm(n)])
      }
      dsts.push(p.p)
      srcs.push(rsrc(d))
      continue
    }
    var l = 0
    if p.list_idx >= 0 {
      l = g.words(g.f.edges[e].args[p.list_idx])[0]
    } else {
      l = g.vals[p.list][0]
    }
    dsts.push(p.p)
    let rl = g.real(l)
    let wa = g.word(a)
    srcs.push(rsrc(g.elem_base(rl, wa, p.es)))
  }
  (dsts, srcs)
}

/// Records what a passed bounds check `i <u len` proves about i: 0 <= i
/// <= MaxInt64 - 1.
fn (var g: G) index_facts(i: Int) {
  let _mi = g.m_()
  var lo = g.cm.lo.get(i) ?? -1
  if !g.cm.lo.contains(i) || lo < 0 {
    lo = 0
  }
  var hi = g.cm.hi.get(i) ?? MAX_INT
  if !g.cm.hi.contains(i) || hi > MAX_INT - 1 {
    hi = MAX_INT - 1
  }
  g.cm.lo[i] = lo
  g.cm.hi[i] = hi
}

/// Records that v = a + n (Add) or a - n (Sub), and v's bounds from a's.
fn (var g: G) offset_facts(v: Int, a: Int, n0: Int) {
  if g.vkind(v) != ssa.Kind.Int {
    return
  }
  var n = n0
  if g.op(v) == ssa.Op.Sub {
    if n == MIN_INT {
      return
    }
    n = -n
  }
  if !g.has_val[a] || !g.has_val[v] || g.vals[a].len() != 1 || g.vals[v].len() != 1 {
    return
  }
  let ar = g.vals[a][0]
  let d = g.vals[v][0]
  if ar == 0 || d == 0 || ar == d {
    return
  }
  g.offs[d] = Offset{a: ar, c: n}
  let _mi = g.m_()
  if let Some(lo) = g.cm.lo.get(ar) {
    if n >= 0 || lo >= MIN_INT - n {
      if n <= 0 || lo <= MAX_INT - n {
        g.cm.lo[d] = lo + n
      }
    }
  }
  if let Some(hi) = g.cm.hi.get(ar) {
    if n <= 0 || hi <= MAX_INT - n {
      if n >= 0 || hi >= MIN_INT - n {
        g.cm.hi[d] = hi + n
      }
    }
  }
}

/// The address of element i of list l from the address of element a when
/// i = a + c and the memo has a's: one add.
fn (var g: G) offset_base(l: Int, i: Int, es: Int) -> (Int, Bool) {
  let o = g.offs.get(i) ?? Offset{a: -1, c: 0}
  if o.a < 0 {
    return (0, false)
  }
  let _mi = g.m_()
  let b = g.cm.bases.get((l, o.a, es)) ?? -1
  if b < 0 || o.c >= 4096 || o.c <= -4096 || es >= 4096 {
    return (0, false)
  }
  let n = o.c * es
  if n == 0 {
    return (b, true)
  }
  if imm12(n) {
    return (g.def1(false, "add $d0, $u0, #${n}", [b]), true)
  }
  if imm12(-n) {
    return (g.def1(false, "sub $d0, $u0, #${-n}", [b]), true)
  }
  (0, false)
}

// ---------------------------------------------------------------------------
// Loop rotation of bounds checks: a jump back to a block that starts with
// a check does the check itself and branches into the block past it.

/// Whether block b starts with a check (checkHead).
fn (g: G) check_head(b: Int) -> Bool {
  let ins = g.blocks[b].insts
  if ins.len() < 2 {
    return false
  }
  let inst = ins[0]
  inst.kind == K_PLAIN && inst.has_fault && inst.defs.is_empty() && inst.recover.is_empty() &&
    inst.text.starts_with("cmp ") && !inst.text.contains("\n") && !inv_cond(inst.fcond).is_empty()
}

/// Emits a jump to t, a block emitted before the current one that starts
/// with a check, as the check and a branch past it; false when it does
/// not apply.
fn (var g: G) rotate_jump(var b: List[Str], t: Int) -> Bool {
  if !g.check_head(t) || !g.same_frame(t) {
    return false
  }
  var back = false
  for x in g.order {
    if x == g.cur {
      break
    }
    back = back || x == t
  }
  if !back {
    return false
  }
  let inst = g.blocks[t].insts[0]
  g.emit_plain(b, Inst{kind: K_PLAIN, text: inst.text, us: inst.us})
  let lt = g.label(t)
  b.push("\tb.${inv_cond(inst.fcond)} ${lt}_c\n\tb ${lt}\n")
  true
}

/// Moves loads and stores of adjacent words through one base register
/// next to each other before register allocation, so pair_mem can join
/// them (decision 0257's follow up: nbody's loads of bs[j].x, y and z
/// and its loads and stores of bs[j].vx and vy were each apart, between
/// arithmetic, and all used one register). A load moves up to the load
/// of the word beside it past arithmetic and loads, and past stores
/// through the same base register to other words; a store moves down to
/// the store of the word beside it past arithmetic and accesses through
/// the same base register to other words. Neither moves past a check
/// (a guarded access stays guarded), a call, a branch, or an instruction
/// that writes the base or its own register.
fn (var g: G) cluster_mem() {
  for b in g.all_blocks() {
    var ins = g.blocks[b].insts
    if ins.len() < 3 {
      continue
    }
    var moved = false
    var i = 0
    while i < ins.len() {
      let (lk, base, off) = mem_word(ins[i])
      if lk == 0 {
        i += 1
        continue
      }
      var j = i + 1
      var found = -1
      while j < ins.len() {
        let (k2, b2, o2) = mem_word(ins[j])
        if k2 == lk && b2 == base && (o2 == off + 8 || o2 == off - 8) && g.fp[mem_reg(ins[j])] == g.fp[mem_reg(ins[i])] {
          found = j
          break
        }
        if !cluster_past(ins[j], lk, base, if lk == 1 { -1 } else { off }) {
          break
        }
        j += 1
      }
      if found < 0 || found == i + 1 {
        i += 1
        continue
      }
      if lk == 1 {
        // the later load moves up: nothing between may write its
        // register, read it, or write memory it reads
        let (_, _, o2) = mem_word(ins[found])
        var ok = true
        for k in i + 1..found {
          ok = ok && cluster_past(ins[k], 1, base, o2) && !ins[k].defs.contains(ins[found].defs[0]) && !ins[k].us.contains(ins[found].defs[0])
        }
        if ok {
          let x = ins[found]
          var out: List[Inst] = []
          for k in 0..ins.len() {
            if k == found {
              continue
            }
            if k == i && o2 == off - 8 {
              out.push(x)
            }
            out.push(ins[k])
            if k == i && o2 == off + 8 {
              out.push(x)
            }
          }
          ins = out
          moved = true
        }
      } else {
        // the earlier store moves down: nothing between may write its
        // register or read memory it writes
        let (_, _, o2) = mem_word(ins[found])
        var ok = true
        for k in i + 1..found {
          ok = ok && cluster_past(ins[k], 2, base, off) && !ins[k].defs.contains(ins[i].us[0])
        }
        if ok {
          let x = ins[i]
          var out: List[Inst] = []
          for k in 0..ins.len() {
            if k == i {
              continue
            }
            if k == found && o2 == off + 8 {
              out.push(x)
            }
            out.push(ins[k])
            if k == found && o2 == off - 8 {
              out.push(x)
            }
          }
          ins = out
          moved = true
        }
      }
      i += 1
    }
    if moved {
      g.blocks[b].insts = ins
    }
  }
}

/// Whether inst is a word load `ldr $d0, [$u0, #off]` (1) or store `str
/// $u0, [$u1, #off]` (2) of cluster_mem, with its base register and
/// offset; 0 otherwise.
fn mem_word(inst: Inst) -> (Int, Int, Int) {
  if inst.kind != K_PLAIN || inst.has_fault || inst.keep || inst.frame || inst.x86 || !inst.clobbers.is_empty() {
    return (0, 0, 0)
  }
  let t = inst.text
  var k = 0
  var pre = ""
  if t.starts_with("ldr $d0, [$u0, #") && inst.defs.len() == 1 && inst.us.len() == 1 {
    k = 1
    pre = "ldr $d0, [$u0, #"
  } else if t.starts_with("str $u0, [$u1, #") && inst.defs.is_empty() && inst.us.len() == 2 {
    k = 2
    pre = "str $u0, [$u1, #"
  } else {
    return (0, 0, 0)
  }
  if !t.ends_with("]") {
    return (0, 0, 0)
  }
  let num = t[pre.len()..t.len() - 1]
  if !is_signed_digits(num) {
    return (0, 0, 0)
  }
  let off = Int.parse(num) ?? 1
  if off % 8 != 0 {
    return (0, 0, 0)
  }
  (k, inst.us[k - 1], off)
}

/// The register a word load defines or a word store stores.
fn mem_reg(inst: Inst) -> Int {
  if inst.defs.len() == 1 { inst.defs[0] } else { inst.us[0] }
}

/// Whether a load (k 1) of the word at off through base, or a store (k 2)
/// of it, may move past inst (cluster_mem's rule): inst is arithmetic of
/// registers, or an access of another word through the same base (or,
/// for a load, any load), and writes neither base nor a register the
/// access reads; off -1 skips the memory test.
fn cluster_past(inst: Inst, k: Int, base: Int, off: Int) -> Bool {
  if inst.kind != K_PLAIN || inst.has_fault || inst.keep || inst.frame || inst.x86 || !inst.clobbers.is_empty() || inst.early {
    return false
  }
  if inst.text.contains("\n") || inst.defs.contains(base) {
    return false
  }
  if !inst.text.contains("[") {
    return true
  }
  let (k2, b2, o2) = mem_word(inst)
  if k2 == 0 {
    // another access: a load past a load only, whatever its form
    return k == 1 && (inst.text.starts_with("ldr") || inst.text.starts_with("ldp")) && !inst.text.contains("!")
  }
  if b2 == base && (off < 0 || o2 >= off + 8 || o2 + 8 <= off) {
    return k == 2 || k2 == 1 || off >= 0
  }
  k == 1 && k2 == 1
}

/// copy_runs_l of text's lines (lsr_test.xo).
fn copy_runs(text: Str) -> Str { copy_runs_l(text.split("\n")).join("\n") }

/// A function's text with each run of four or more word copies through
/// x16 or x17 (`ldr x16, [A, #a]` then `str x16, [B, #b]`, each next pair
/// a word further on both sides) copied 32 bytes at a time: x16 = A + a
/// and x17 = B + b, then load and store pairs of v30 and v31 (the
/// emitter's scratch registers). These are the spill slot reloads of an
/// aggregate's words stored into an object or a call's stack arguments,
/// and back (2026-10-18: 6.28 MB of xo's 38.4 MB __text was word copies
/// through x16). One base is sp and the other not (the object's words
/// cannot overlap a spill slot), or both are sp with the two ranges
/// apart, so loading four words before storing them reads what the word
/// by word copy read; and neither x16 nor x17 is read after the run
/// before it is written (scratch_dead). Before reload_reuse, which takes
/// x16 to hold the run's last word's slot after it.
/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn copy_runs_l(lines: List[Str]) -> List[Str] {
  if !any_has(lines, "\tstr x16, [") && !any_has(lines, "\tstr x17, [") {
    return lines
  }
  var out: List[Str] = []
  var changed = false
  var i = 0
  let n = lines.len()
  while i < n {
    // only a run's first load starts one (most lines: copied at once, no
    // prefix built for them: two strings a line were most of this pass's
    // time, decision 0274's measurement)
    if !lines[i].starts_with("\tldr x1") {
      out.push(lines[i])
      i += 1
      continue
    }
    let x16 = lines[i].starts_with(LD_X16)
    let r = if x16 { "x16" } else { "x17" }
    let ld = if x16 { LD_X16 } else { LD_X17 }
    let st = if x16 { ST_X16 } else { ST_X17 }
    let (aok, ab, ao) = x16_word(lines[i], ld)
    let j = past_rows(lines, i + 1)
    let (bok, bb, bo) = if aok && j < n { x16_word(lines[j], st) } else { (false, "", 0) }
    if bok {
      // the debug line rows and variable locations among the copies
      // (decisions 0239, 0252): kept, before the copy, as pair_mem
      // keeps them, so a build with debug information has the same code
      var rows: List[Str] = []
      for l in lines[i + 1..j] {
        rows.push(l)
      }
      var e = j + 1
      var k = 1
      while true {
        let c = past_rows(lines, e)
        if c >= n {
          break
        }
        let (cok, cb, co) = x16_word(lines[c], ld)
        let d = past_rows(lines, c + 1)
        if !cok || cb != ab || co != ao + 8 * k || d >= n {
          break
        }
        let (dok, db, dof) = x16_word(lines[d], st)
        if !dok || db != bb || dof != bo + 8 * k {
          break
        }
        for l in lines[e..c] {
          rows.push(l)
        }
        for l in lines[c + 1..d] {
          rows.push(l)
        }
        e = d + 1
        k += 1
      }
      let ok = k >= 4 && scratch_dead(lines, e, "16") && scratch_dead(lines, e, "17")
      let code = if ok { copy_block(r, ab, ao, bb, bo, k) } else { [] }
      if code.is_empty() {
        for l in lines[i..e] {
          out.push(l)
        }
      } else {
        for l in rows + code {
          out.push(l)
        }
        changed = true
      }
      i = e
      continue
    }
    out.push(lines[i])
    i += 1
  }
  // the copy blocks are lines of several instructions; with none, out is
  // the input's lines as they were
  if changed { resplit(out) } else { out }
}

/// copy_runs_l's prefixes of a word copy through a scratch register.
const LD_X16 = "\tldr x16, ["
const LD_X17 = "\tldr x17, ["
const ST_X16 = "\tstr x16, ["
const ST_X17 = "\tstr x17, ["

/// borrow_flag_peep_l of text's lines (lsr_test.xo).
fn borrow_flag_peep(text: Str) -> Str { borrow_flag_peep_l(text.split("\n")).join("\n") }

/// A function's text without the round trip of a borrow through a
/// register into the next subtract with borrow: `subs A, B, C` then
/// `cset X, cc`, `eor X, X, #1`, `cmp X, #1`, and `sbcs` or `adcs`, with X
/// written before it is read after them, keeps subs's carry flag (C is 1
/// when there was no borrow, what cmp X, #1 sets) and drops the three
/// (2026-10-19: the field code's subtractions start x - y with 1 ^ its
/// borrow carried into the chain, std/native/llrt x25519.xo fe64_sub,
/// nistec.xo sub4, sub6, sub_m6; a constant carry in of 1 made LLVM join
/// two carries with a conditional select).
/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn borrow_flag_peep_l(ls: List[Str]) -> List[Str] {
  if !any_has(ls, "\teor ") || !any_line_ends(ls, ", cc") {
    return ls
  }
  var out: List[Str] = List.with_capacity(ls.len())
  var i = 0
  while i < ls.len() {
    if ls[i].starts_with("\tsubs ") {
      // the next four instructions, past debug row and variable labels
      // (kept, after subs: a build with debug information has the same
      // code, gotchas/arm64-text-pass-scratch-live.md)
      var at: List[Int] = []
      var rows: List[Str] = []
      var j = i + 1
      while j < ls.len() && at.len() < 4 {
        let j2 = past_rows(ls, j)
        for r in ls[j..j2] {
          rows.push(r)
        }
        if j2 < ls.len() {
          at.push(j2)
        }
        j = j2 + 1
      }
      if at.len() == 4 && ls[at[0]].starts_with("\tcset ") && ls[at[0]].ends_with(", cc") {
        let x = ls[at[0]]["\tcset ".len()..ls[at[0]].len() - ", cc".len()]
        let nx = ls[at[3]]
        if is_xreg(x) && ls[at[1]] == "\teor ${x}, ${x}, #1" && ls[at[2]] == "\tcmp ${x}, #1" && (nx.starts_with("\tsbcs ") || nx.starts_with("\tadcs ")) && !nx.contains(x + ",") && !nx.ends_with(x) && scratch_free_after(ls, at[3], x) {
          out.push(ls[i])
          for r in rows {
            out.push(r)
          }
          i = at[3]
          continue
        }
      }
    }
    out.push(ls[i])
    i += 1
  }
  resplit(out)
}

/// Whether register x (an x register, or its w form) is written before it
/// is read from line i on, within the block: a label, a branch, a call, or
/// a return first counts as a read (the value may be live there).
fn scratch_free_after(ls: List[Str], i: Int, x: Str) -> Bool {
  let r = x[1..x.len()]
  var j = i
  while j < ls.len() {
    let l = ls[j]
    j += 1
    if l.is_empty() || l.starts_with("\t.") {
      continue
    }
    if !l.starts_with("\t") {
      let name = label_def(l)
      if !name.is_empty() && is_row_label(name) {
        continue
      }
      return false
    }
    let body = l[1..l.len()]
    let sp = body.find(" ") ?? body.len()
    let op = body[0..sp]
    let ops = if sp < body.len() { body[sp + 1..body.len()] } else { "" }
    let toks = reg_tokens(ops)
    if !toks.contains("x${r}") && !toks.contains("w${r}") {
      if op.starts_with("b") || op.starts_with("cb") || op.starts_with("tb") || op == "ret" {
        return false
      }
      continue
    }
    // named: dead only when the first operand is it and no later one reads it
    if op.starts_with("st") || op.starts_with("cmp") || op.starts_with("cmn") || op.starts_with("tst") || op.starts_with("cb") || op.starts_with("tb") {
      return false
    }
    let first = toks[0]
    if first != "x${r}" && first != "w${r}" {
      return false
    }
    for t in toks[1..toks.len()] {
      if t == "x${r}" || t == "w${r}" {
        return false
      }
    }
    return true
  }
  false
}

/// Whether x<r> (and w<r>) is not read from line i on before it is
/// written: the first instruction naming it writes it without reading
/// it, or a call, a return, an unconditional branch, or a block's label
/// comes first (the emitter keeps nothing in x16 or x17 from one
/// instruction of the function to the next; only a local label of one
/// instruction's code, `1:`, or a branch to one, `1b`, may). Debug
/// labels and directives are passed over.
fn scratch_dead(lines: List[Str], i: Int, r: Str) -> Bool {
  // the register's names, made once (2026-10-21: building them and
  // splitting every line scanned into register tokens was 78% of
  // copy_runs_l, 4.4 s of a cold self build's CPU); a line that does not
  // contain either name is not split at all
  let xr = "x${r}"
  let wr = "w${r}"
  var j = i
  while j < lines.len() {
    let l = lines[j]
    j += 1
    if l.is_empty() || l.starts_with("\t.") || l.starts_with("//") {
      continue
    }
    if !l.starts_with("\t") {
      let name = label_def(l)
      if !name.is_empty() && is_row_label(name) {
        continue
      }
      return !is_digits(l[0..1])
    }
    let body = l[1..l.len()]
    let sp = body.find(" ") ?? body.len()
    let op = body[0..sp]
    let ops = if sp < body.len() { body[sp + 1..body.len()] } else { "" }
    let named = ops.contains(xr) || ops.contains(wr)
    let toks = if named { reg_tokens(ops) } else { [] }
    var at = -1
    var t = 0
    while t < toks.len() {
      if toks[t] == xr || toks[t] == wr {
        at = t
        break
      }
      t += 1
    }
    if at < 0 {
      if op == "ret" || op == "bl" || op == "b" {
        if op == "b" && is_digits(ops[0..1]) {
          return false
        }
        return true
      }
      if op.starts_with("b.") || op is "cbz" | "cbnz" | "tbz" | "tbnz" {
        let tgt = last_operand(ops)
        if !tgt.is_empty() && is_digits(tgt[0..1]) {
          return false // a local label of the same instruction's code
        }
      }
      if op is "br" | "blr" | "svc" {
        return true
      }
      continue
    }
    if op.starts_with("ld") && !op.starts_with("ldx") && !op.starts_with("lda") {
      // a load writes the registers before its address and reads those in it
      let br = ops.find("[") ?? ops.len()
      let dst = reg_tokens(ops[0..br])
      if dst.contains(xr) || dst.contains(wr) {
        return !reg_tokens(ops[br..ops.len()]).contains(xr)
      }
      return false
    }
    if op is "mov" | "movz" | "movn" | "adr" | "adrp" | "add" | "sub" | "and" | "orr" | "eor" | "lsl" | "lsr" | "asr" | "mul" | "madd" | "msub" | "csel" | "csinc" | "neg" | "mvn" | "ubfx" | "sbfx" | "sxtw" | "uxtw" | "fmov" {
      // a computation: its first operand is its result
      return at == 0 && !toks[1..toks.len()].contains(xr) && !toks[1..toks.len()].contains(wr)
    }
    return false
  }
  true
}

/// The register names among an instruction's operands, in order.
fn reg_tokens(ops: Str) -> List[Str] {
  var out: List[Str] = []
  let bs = ops.bytes()
  var s = 0
  var k = 0
  while k <= bs.len() {
    let word = k < bs.len() && ((bs[k] >= 'a' && bs[k] <= 'z') || (bs[k] >= '0' && bs[k] <= '9'))
    if !word {
      if k > s {
        out.push(ops[s..k])
      }
      s = k + 1
    }
    k += 1
  }
  out
}

/// An instruction's last operand (after its last ", " or the only one).
fn last_operand(ops: Str) -> Str {
  let parts = ops.split(", ")
  parts[parts.len() - 1]
}

/// The first line from i on that is not a debug line row's or variable
/// location's label.
fn past_rows(lines: List[Str], i: Int) -> Int {
  var j = i
  while j < lines.len() {
    let name = label_def(lines[j])
    if name.is_empty() || !is_row_label(name) {
      break
    }
    j += 1
  }
  j
}

/// copy_runs's instructions for k words from [a + ao] to [b + bo], or
/// none when that is not fewer than the 2k of the word copies or the
/// bases do not allow it. Up to 128 words from one x16 and x17 (ldp of
/// q registers reaches 1008 bytes), the next 128 from them plus 1024.
fn copy_block(r: Str, a: Str, ao: Int, b: Str, bo: Int, k: Int) -> List[Str] {
  let apart = ao + 8 * k <= bo || bo + 8 * k <= ao
  // x16 = A + a goes first, so A may be x17 (not for a copy through x17,
  // whose loads replaced it)
  let bases = a != "x16" && b != "x16" && (r == "x16" || (a != "x17" && b != "x17"))
  if k < 4 || !bases || !((a == "sp") != (b == "sp") || (a == "sp" && b == "sp" && apart)) {
    return []
  }
  var out: List[Str] = []
  var w = 0
  while w < k {
    let m = if k - w < 128 { k - w } else { 128 }
    let s = if w == 0 { add_off("x16", a, ao) + add_off("x17", b, bo) } else { add_off("x16", "x16", 1024) + add_off("x17", "x17", 1024) }
    if s.is_empty() {
      return []
    }
    for l in s {
      out.push(l)
    }
    var j = 0
    while j + 4 <= m {
      out.push("\tldp q30, q31, [x16, #${8 * j}]")
      out.push("\tstp q30, q31, [x17, #${8 * j}]")
      j += 4
    }
    if j + 2 <= m {
      out.push("\tldr q30, [x16, #${8 * j}]")
      out.push("\tstr q30, [x17, #${8 * j}]")
      j += 2
    }
    if j < m {
      out.push("\tldr d30, [x16, #${8 * j}]")
      out.push("\tstr d30, [x17, #${8 * j}]")
    }
    w += m
  }
  if out.len() >= 2 * k {
    return []
  }
  out
}

/// `dst = base + off` in one or two adds or subs (off within 24 bits),
/// or none when it does not fit; a zero off is a mov.
fn add_off(dst: Str, base: Str, off: Int) -> List[Str] {
  let op = if off < 0 { "sub" } else { "add" }
  let v = if off < 0 { -off } else { off }
  if v == 0 {
    return ["\tmov ${dst}, ${base}"]
  }
  if v < 4096 {
    return ["\t${op} ${dst}, ${base}, #${v}"]
  }
  if v >= 16777216 {
    return []
  }
  let hi = ["\t${op} ${dst}, ${base}, #${v >> 12}, lsl #12"]
  if v & 4095 == 0 {
    return hi
  }
  hi + ["\t${op} ${dst}, ${dst}, #${v & 4095}"]
}

/// Whether l is `<pre>A, #off]` with A sp or an x register (pre is
/// `\tldr x16, [` or `\tstr x16, [`): the base and the offset.
fn x16_word(l: Str, pre: Str) -> (Bool, Str, Int) {
  let bad = (false, "", 0)
  if !l.starts_with(pre) || !l.ends_with("]") {
    return bad
  }
  let rest = l[pre.len()..l.len() - 1]
  let c = rest.find(", #") ?? -1
  if c < 0 {
    return bad
  }
  let base = rest[0..c]
  if base != "sp" && !is_xreg(base) {
    return bad
  }
  let num = rest[c + 3..rest.len()]
  if !is_signed_digits(num) {
    return bad
  }
  match Int.parse(num) {
    Some(off) => (true, base, off)
    None => bad
  }
}

/// Joins two loads of adjacent words through one base register into a
/// load pair (pairLoads): two x registers or two d registers.
fn pair_loads(text: Str) -> Str {
  let lines = text.split("\n")
  var out: List[Str] = []
  var i = 0
  let n = lines.len()
  while i < n {
    if i + 1 < n {
      let (aok, a1, a2, a3) = parse_ldr(lines[i])
      if aok {
        let (cok, c1, c2, c3) = parse_ldr(lines[i + 1])
        if cok && a2 == c2 && a1 != c1 && a1 != a2 && same_class(a1, c1) {
          if c3 == a3 + 8 && a3 % 8 == 0 && a3 >= -512 && a3 <= 504 {
            out.push("\tldp ${a1}, ${c1}, [${a2}, #${a3}]")
            i += 2
            continue
          }
        }
      }
    }
    out.push(lines[i])
    i += 1
  }
  out.join("\n")
}

/// The bytes a store line writes, as (true, offset, size) for `str`,
/// `stur` and `stp` of x, d, w, s or q registers through a plain
/// `[xN, #off]` (not sp: the frame's saves and restores pair as they
/// were stored), else (false, 0, 0). pair_mem_l keeps a load pair of d
/// registers from bytes a store covers in part (2026-10-26; x pairs stay:
/// a 16 byte copy through two bases pairs, and no measured stall).
fn store_span_l(l: Str) -> (Bool, Int, Int) {
  let no = (false, 0, 0)
  var mn = ""
  if l.starts_with("\tstp ") {
    mn = "stp"
  } else if l.starts_with("\tstur ") {
    mn = "stur"
  } else if l.starts_with("\tstr ") {
    mn = "str"
  } else {
    return no
  }
  let open = l.find(", [") ?? -1
  if open < 0 || !l.ends_with("]") {
    return no
  }
  let regs = l[mn.len() + 2..open]
  var size = 0
  if regs.starts_with("q") {
    size = 16
  } else if regs.starts_with("x") || regs.starts_with("d") {
    size = 8
  } else if regs.starts_with("w") || regs.starts_with("s") {
    size = 4
  } else {
    return no
  }
  let inner = l[open + 3..l.len() - 1]
  let c = inner.find(", #") ?? -1
  if c < 0 {
    return no
  }
  let base = inner[0..c]
  let num = inner[c + 3..inner.len()]
  if !is_xreg(base) || !is_signed_digits(num) {
    return no
  }
  match Int.parse(num) {
    Some(off) => (true, off, if mn == "stp" { size * 2 } else { size })
    None => no
  }
}

/// store_span_l of each line that is a store.
fn store_spans(lines: List[Str]) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  for l in lines {
    let (ok, off, size) = store_span_l(l)
    if ok {
      out.push((off, size))
    }
  }
  out
}

/// Whether a store of spans writes part of the 16 bytes at a without
/// being exactly them: a load pair of them cannot be forwarded from it
/// and waits for the store to commit (an ldp of two fields that two
/// single stores wrote: nbody 1.43 times Go's cycles, 2026-10-26).
fn partial_store(spans: List[(Int, Int)], a: Int) -> Bool {
  for (o, s) in spans {
    if o < a + 16 && o + s > a && !(o == a && s == 16) {
      return true
    }
  }
  false
}

/// pair_mem_l of text's lines (lsr_test.xo).
fn pair_mem(text: Str, ext: Str) -> Str {
  let ls = text.split("\n")
  pair_mem_l(ls, label_counts(ls, ext)).join("\n")
}

/// pair_loads for a function's text (pairMem, decision 0208), which also
/// joins two stores of adjacent words through one base register (not
/// sp) into a store pair, and pairs across labels nothing refers to (the
/// labels of blocks only fallen into, which go). ext is the text that
/// may refer to the function's labels besides it (its call site table).
/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn pair_mem_l(lines: List[Str], nrefs: Map[Str, Int]) -> List[Str] {
  var out: List[Str] = []
  var i = 0
  let n = lines.len()
  let spans = store_spans(lines)
  while i < n {
    let (lok, l1, l2, l3) = parse_ldr(lines[i])
    let (sok, s1, s2, s3) = parse_str(lines[i])
    let st = !lok
    let a1 = if lok { l1 } else { s1 }
    let a2 = if lok { l2 } else { s2 }
    let a3 = if lok { l3 } else { s3 }
    if lok || sok {
      var j = i + 1
      // the debug line rows and variable locations among the labels
      // passed: kept, before the pair (decisions 0239, 0252; only the
      // debug sections refer to them, never a branch)
      var rows: List[Str] = []
      while j < n {
        let name = label_def(lines[j])
        if name.is_empty() {
          break
        }
        if is_row_label(name) {
          rows.push(lines[j])
          j += 1
          continue
        }
        if nrefs.contains(name) {
          break
        }
        j += 1
      }
      if j < n {
        let (cok, c1, c2, c3) = if st { parse_str(lines[j]) } else { parse_ldr(lines[j]) }
        if cok && a2 == c2 && (st || (a1 != c1 && a1 != a2)) && same_class(a1, c1) {
          if c3 == a3 + 8 && a3 % 8 == 0 && a3 >= -512 && a3 <= 504 && (st || a2 == "sp" || !a1.starts_with("d") || !partial_store(spans, a3)) {
            let op = if st { "stp" } else { "ldp" }
            for r in rows {
              out.push(r)
            }
            out.push("\t${op} ${a1}, ${c1}, [${a2}, #${a3}]")
            i = j + 1
            continue
          }
        }
      }
    }
    out.push(lines[i])
    i += 1
  }
  resplit(out)
}

/// reload_reuse_l of text's lines (lsr_test.xo).
fn reload_reuse(text: Str, ext: Str) -> Str {
  let ls = text.split("\n")
  reload_reuse_l(ls, label_counts(ls, ext)).join("\n")
}

/// A function's text without the reloads of a spill slot into x16 or
/// x17 that already hold it (2026-10-17: 13% of bench/perf/tls's arm64
/// instructions were spill reloads and stores, many of one slot again
/// before anything wrote it). On the final text, so every branch the
/// emitter made counts (forwarded jumps, rotated loop tests): what the
/// registers hold since their last `ldr x16|x17, [sp, #k]` or `str
/// x16|x17, [sp, #k]` is forgotten at a label anything refers to (text
/// or ext), at a call, at an instruction that may write the register or
/// moves sp, and for slot k at another store to it
/// (gotchas/arm64-scratch-reload-cache.md). At a label every reference
/// to which (in text and ext) came before it, the registers hold what
/// they held at each of those branches and on the way falling into it;
/// a label referred to later (a loop's head), or from ext, starts empty.
/// How many times each label is referred to in a function's lines, a
/// reference from ext (its LSDA) counted 1000000 (decision 0274 step 4's
/// label table, still by spelling): counted once per function for the
/// passes that need it (reload_reuse_l, pair_mem_l), where each scanned
/// every line again; no pass between them adds or removes a reference.
pub fn label_counts(lines: List[Str], ext: Str) -> Map[Str, Int] {
  var nrefs: Map[Str, Int] = {}
  for x in lines {
    if label_def(x).is_empty() {
      for r in line_label_refs(x) {
        nrefs[r] = (nrefs.get(r) ?? 0) + 1
      }
    }
  }
  for x in ext.split("\n") {
    for r in line_label_refs(x) {
      nrefs[r] = (nrefs.get(r) ?? 0) + 1000000
    }
  }
  nrefs
}

/// Ported to items in lines.xo (decision 0274 step 3): until the text pass
/// goes, a change here is made in its port too, or XO_OP_VERIFY=1 builds
/// fail (gotchas/arm64-line-pass-port-drift.md).
fn reload_reuse_l(lines: List[Str], nrefs: Map[Str, Int]) -> List[Str] {
  // per label, the references seen so far and what x16 and x17 held at
  // them (the intersection)
  var seen: Map[Str, Int] = {}
  var at16: Map[Str, Int] = {}
  var at17: Map[Str, Int] = {}
  // the slot offsets x16 and x17 hold, -1 for none; whether the line
  // before can fall into the next
  var h16 = -1
  var h17 = -1
  var falls = true
  var out: List[Str] = List.with_capacity(lines.len())
  for l in lines {
    let name = label_def(l)
    if !name.is_empty() && is_row_label(name) {
      // a debug line row or variable location: only the debug sections
      // refer to it, never a branch, so what the registers hold stays
      out.push(l)
      continue
    }
    if !name.is_empty() {
      let n = nrefs.get(name) ?? 0
      if n > 0 {
        if (seen.get(name) ?? 0) != n {
          h16 = -1
          h17 = -1
        } else {
          let b16 = at16.get(name) ?? -1
          let b17 = at17.get(name) ?? -1
          h16 = if falls && h16 != b16 { -1 } else { b16 }
          h17 = if falls && h17 != b17 { -1 } else { b17 }
        }
      }
      falls = true
      out.push(l)
      continue
    }
    if !l.starts_with("\t") {
      // a symbol, a comment, or a blank line: forget
      if !l.is_empty() && !l.starts_with("//") {
        h16 = -1
        h17 = -1
      }
      out.push(l)
      continue
    }
    if l.starts_with("\t.") {
      out.push(l) // a directive
      continue
    }
    // the labels this instruction may branch to: what x16 and x17 hold
    // here (before it runs: a branch writes neither)
    for r in line_label_refs(l) {
      let k = seen.get(r) ?? 0
      if k == 0 {
        at16[r] = h16
        at17[r] = h17
      } else {
        if (at16.get(r) ?? -1) != h16 {
          at16[r] = -1
        }
        if (at17.get(r) ?? -1) != h17 {
          at17[r] = -1
        }
      }
      seen[r] = k + 1
    }
    falls = !(l.starts_with("\tb ") || l.starts_with("\tret") || l.starts_with("\tbr ") || l.starts_with("\tbrk"))
    let (lok, lr, lbase, loff) = parse_ldr(l)
    if lok && lbase == "sp" && (lr == "x16" || lr == "x17") {
      if (lr == "x16" && h16 == loff) || (lr == "x17" && h17 == loff) {
        continue // it holds the slot already
      }
      if lr == "x16" {
        h16 = loff
      } else {
        h17 = loff
      }
      out.push(l)
      continue
    }
    let (sok, sr, soff) = parse_sp_str(l)
    if sok {
      // the slot's value is the stored register's now
      if h16 == soff {
        h16 = -1
      }
      if h17 == soff {
        h17 = -1
      }
      if sr == "x16" {
        h16 = soff
      } else if sr == "x17" {
        h17 = soff
      }
      out.push(l)
      continue
    }
    if writes_scratch(l) {
      // only the register the line writes, when that is all it does (a
      // load into x17 from a base in x16 keeps x16: 2026-10-21,
      // http.dispatch's record copy reloaded the base for every word)
      let (w16, w17) = scratch_written(l)
      if w16 {
        h16 = -1
      }
      if w17 {
        h17 = -1
      }
    }
    out.push(l)
  }
  resplit(out)
}

/// Which of x16 and x17 line l (one writes_scratch is true of) may
/// write: only the destination for a plain load (no write back) or a
/// computation, whose result is its first operand; both for anything
/// else (a call, sp, a swap).
fn scratch_written(l: Str) -> (Bool, Bool) {
  let body = l[1..l.len()]
  let sp = body.find(" ") ?? body.len()
  let op = body[0..sp]
  let ops = if sp < body.len() { body[sp + 1..body.len()] } else { "" }
  if op is "bl" | "blr" | "blraa" | "blrab" | "svc" | "br" || ops.contains("sp") || ops.contains("]!") || ops.contains("], #") {
    return (true, true)
  }
  if op.starts_with("ld") && !op.starts_with("ldxr") && !op.starts_with("ldax") {
    let br = ops.find("[") ?? ops.len()
    let dst = ops[0..br]
    return (dst.contains("x16") || dst.contains("w16"), dst.contains("x17") || dst.contains("w17"))
  }
  if op.starts_with("sw") || op.starts_with("cas") || op.starts_with("st") || op.starts_with("ldxr") || op.starts_with("ldax") {
    return (true, true)
  }
  let first = ops.split(",")[0].trim()
  if first is "x16" | "w16" {
    return (true, false)
  }
  if first is "x17" | "w17" {
    return (false, true)
  }
  (true, true)
}

/// The labels line l refers to (every `L` and the letters, digits, and `_`
/// after it).
fn line_label_refs(l: Str) -> List[Str] {
  var out: List[Str] = []
  let bs = l.bytes()
  var k = 0
  while k < bs.len() {
    if bs[k] != 'L' {
      k += 1
      continue
    }
    var e = k + 1
    while e < bs.len() && is_label_byte(bs[e]) {
      e += 1
    }
    out.push(l[k..e])
    k = e
  }
  out
}

/// Whether l is `\tstr x<n>|xzr, [sp, #<off>]`: the register and the
/// offset.
fn parse_sp_str(l: Str) -> (Bool, Str, Int) {
  let bad = (false, "", 0)
  if !l.starts_with("\tstr x") || !l.ends_with("]") {
    return bad
  }
  let rest = l[5..l.len()]
  let comma = rest.find(", [sp, #") ?? -1
  if comma < 0 {
    return bad
  }
  let r = rest[0..comma]
  if r != "xzr" && !is_xreg(r) {
    return bad
  }
  let num = rest[comma + 8..rest.len() - 1]
  if !is_signed_digits(num) {
    return bad
  }
  match Int.parse(num) {
    Some(off) => (true, r, off)
    None => bad
  }
}

/// Whether instruction line l may change what x16 or x17 hold, or what a
/// spill slot holds: a call, anything that moves sp or stores through it
/// other than parse_sp_str's form, and an instruction naming x16, x17,
/// w16, or w17 other than as a read (a store's source, a compare's or a
/// test's operand, a later operand of a computation).
fn writes_scratch(l: Str) -> Bool {
  // most lines name no scratch register, no sp, no write back, and are no
  // call: false without the slices below (each true case needs one of
  // these spellings)
  if !l.contains("16") && !l.contains("17") && !l.contains("sp") && !l.contains("]!") && !l.contains("\tb") && !l.contains("svc") {
    return false
  }
  let body = l[1..l.len()]
  let sp = body.find(" ") ?? body.len()
  let op = body[0..sp]
  let ops = if sp < body.len() { body[sp + 1..body.len()] } else { "" }
  if op is "bl" | "blr" | "blraa" | "blrab" | "svc" | "br" {
    return true
  }
  if ops.starts_with("sp") || ops.contains("[sp]") || ops.contains("]!") || ops.contains("[sp, #") {
    // sp moves, or the stack is written or read in another form
    return !op.starts_with("ldr") || ops.contains("]!") || ops.contains("], #")
  }
  let names = ops.contains("x16") || ops.contains("x17") || ops.contains("w16") || ops.contains("w17")
  if !names {
    return false
  }
  if op.starts_with("ld") {
    // a load writes the registers before its address (x16 as the base
    // is a read)
    let br = ops.find("[") ?? ops.len()
    let dst = ops[0..br]
    return dst.contains("x16") || dst.contains("x17") || dst.contains("w16") || dst.contains("w17") || ops.contains("]!") || ops.contains("], #")
  }
  if op.starts_with("sw") || op.starts_with("cas") || op.starts_with("st") && op != "str" && op != "stp" && op != "strb" && op != "strh" && op != "stur" {
    return true // a swap, an exclusive store's status
  }
  if op is "str" | "stp" | "strb" | "strh" | "stur" | "cmp" | "cmn" | "tst" | "cbz" | "cbnz" | "tbz" | "tbnz" | "ccmp" | "ccmn" {
    return false
  }
  // a computation: its first operand is its result
  ops.starts_with("x16") || ops.starts_with("x17") || ops.starts_with("w16") || ops.starts_with("w17")
}

/// Whether label name is a debug line row's (emit.xo: `..._dl<n>`) or
/// a variable location's (`..._dv<n>`, dwvars.xo): kept, as the debug
/// sections refer to them. Before a pair, a location label is one
/// instruction early (a word may be shown a load before it arrives).
fn is_row_label(name: Str) -> Bool {
  // the digits at the end, after `_dl` or `_dv`
  let bs = name.bytes()
  var k = bs.len()
  while k > 0 && Int(bs[k - 1]) >= 48 && Int(bs[k - 1]) <= 57 {
    k -= 1
  }
  // (`_dvs`: a fault stub's variable range, and the body's end before
  // the stubs)
  // (`_du`: an asynchronous preemption unsafe range's ends, decision 0318)
  k < bs.len() && k >= 3 && (name[k - 3..k] == "_dl" || name[k - 3..k] == "_dv" || name[k - 3..k] == "_du" || (k >= 4 && name[k - 4..k] == "_dvs"))
}

/// The name of the label line l defines (`L<letters, digits, _>:`, or
/// ELF's `.L...:`, named without the dot as line_label_refs names its
/// references), or "". (Until 2026-10-17 only the Mach-O form: on Linux
/// every label ended a pair_mem search and cleared reload_reuse's
/// registers, the debug rows before nearly every line among them.)
fn label_def(l0: Str) -> Str {
  let l = if l0.starts_with(".L") { l0[1..l0.len()] } else { l0 }
  if l.len() < 3 || !l.starts_with("L") || !l.ends_with(":") {
    return ""
  }
  let name = l[0..l.len() - 1]
  for c in name.bytes() {
    if !is_label_byte(c) {
      return ""
    }
  }
  name
}

fn is_label_byte(c: UInt8) -> Bool {
  // 1 delimits the tokens of a canonical text (fcache.xo FP_TOKEN), which
  // stand for letters, digits, and `_`
  c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == 1
}

/// Whether l is `\tstr x<n>|xzr|d<n>, [x<m>, #<off>]` (strRE): the register,
/// the base, and the offset.
fn parse_str(l: Str) -> (Bool, Str, Str, Int) {
  let bad = (false, "", "", 0)
  if !l.starts_with("\tstr x") && !l.starts_with("\tstr d") {
    return bad
  }
  let rest = l[5..l.len()]
  let comma = rest.find(", [") ?? -1
  if comma < 0 {
    return bad
  }
  let r = rest[0..comma]
  if r != "xzr" && !is_xreg(r) && !is_dreg(r) {
    return bad
  }
  let rest2 = rest[comma + 3..rest.len()]
  let c2 = rest2.find(", #") ?? -1
  if c2 < 0 {
    return bad
  }
  let base = rest2[0..c2]
  if !is_xreg(base) {
    return bad
  }
  let tail = rest2[c2 + 3..rest2.len()]
  if !tail.ends_with("]") {
    return bad
  }
  let num = tail[0..tail.len() - 1]
  if !is_signed_digits(num) {
    return bad
  }
  match Int.parse(num) {
    Some(off) => (true, r, base, off)
    None => bad
  }
}

/// Whether l is `\tldr x<n>|d<n>, [x<m>|sp, #<off>]` (ldrRE): the register,
/// the base, and the offset.
fn parse_ldr(l: Str) -> (Bool, Str, Str, Int) {
  let bad = (false, "", "", 0)
  if !l.starts_with("\tldr x") && !l.starts_with("\tldr d") {
    return bad
  }
  let rest = l[5..l.len()]
  let comma = rest.find(", [") ?? -1
  if comma < 0 {
    return bad
  }
  let r = rest[0..comma]
  if !is_xreg(r) && !is_dreg(r) {
    return bad
  }
  let rest2 = rest[comma + 3..rest.len()]
  let c2 = rest2.find(", #") ?? -1
  if c2 < 0 {
    return bad
  }
  let base = rest2[0..c2]
  if base != "sp" && !is_xreg(base) {
    return bad
  }
  let tail = rest2[c2 + 3..rest2.len()]
  if !tail.ends_with("]") {
    return bad
  }
  let num = tail[0..tail.len() - 1]
  if !is_signed_digits(num) {
    return bad
  }
  match Int.parse(num) {
    Some(off) => (true, r, base, off)
    None => bad
  }
}

/// Whether s is `d` and one or more digits (a double register: ldp and
/// stp pair two of them as they pair two x registers).
fn is_dreg(s: Str) -> Bool {
  s.len() >= 2 && s.starts_with("d") && is_digits(s[1..s.len()])
}

/// Whether registers a and b can be one ldp or stp (both x, xzr counting
/// as one, or both d).
fn same_class(a: Str, b: Str) -> Bool {
  a.starts_with("d") == b.starts_with("d")
}

/// Whether s is `x` and one or more digits.
fn is_xreg(s: Str) -> Bool {
  if s.len() < 2 || !s.starts_with("x") {
    return false
  }
  is_digits(s[1..s.len()])
}

fn is_digits(s: Str) -> Bool {
  if s.is_empty() {
    return false
  }
  for c in s.bytes() {
    if c < '0' || c > '9' {
      return false
    }
  }
  true
}

/// An optional `-` and one or more digits.
fn is_signed_digits(s: Str) -> Bool {
  if s.starts_with("-") {
    return is_digits(s[1..s.len()])
  }
  is_digits(s)
}

/// Lays out the latch of a loop right after a block that branches either
/// to it or into an inner loop (placeLatches).
fn (var g: G) place_latches() {
  let all = g.all_blocks()
  let nb = g.blocks.len()
  let preds = g.mpreds_all(all)
  // natural loops of back edges found by depth first search, the bodies
  // by header
  var bodies: List[List[Bool]] = []
  var has_body: List[Bool] = []
  for _ in 0..nb {
    bodies.push([])
    has_body.push(false)
  }
  var state: List[Int] = []
  for _ in 0..nb {
    state.push(0)
  }
  var stack: List[(Int, Int)] = [(g.hot[0], 0)]
  state[g.hot[0]] = 1
  while !stack.is_empty() {
    let top = stack.len() - 1
    let (b, i) = stack[top]
    let ss = g.msuccs(b)
    if i >= ss.len() {
      state[b] = 2
      let _p = stack.pop()
      continue
    }
    stack[top] = (b, i + 1)
    let t = ss[i]
    if state[t] == 0 {
      state[t] = 1
      stack.push((t, 0))
    } else if state[t] == 1 {
      if !has_body[t] {
        var body: List[Bool] = []
        for _ in 0..nb {
          body.push(false)
        }
        bodies[t] = body
        has_body[t] = true
      }
      var body = bodies[t]
      bodies[t] = []
      var work = [b]
      body[t] = true
      while !work.is_empty() {
        let x = work.pop() ?? 0
        if !body[x] {
          body[x] = true
          for p in preds[x] {
            work.push(p)
          }
        }
      }
      bodies[t] = body
    }
  }
  var hot: List[Bool] = []
  for _ in 0..nb {
    hot.push(false)
  }
  for b in g.hot {
    hot[b] = true
  }
  var moved: List[Bool] = []
  for _ in 0..nb {
    moved.push(false)
  }
  var i = 0
  while i < g.hot.len() {
    let b = g.hot[i]
    let nbi = g.blocks[b].insts.len()
    if nbi == 0 {
      i += 1
      continue
    }
    let t = g.blocks[b].insts[nbi - 1]
    if t.kind != K_CONDBR || t.targets[0] == t.targets[1] {
      i += 1
      continue
    }
    var restart = false
    for k in 0..2 {
      let l = t.targets[k]
      let x = t.targets[1 - k]
      // l and the small blocks it jumps through reach the loop's header,
      // or a block that only tests and branches to it
      var chain: List[Int] = []
      var h = -1
      var y = l
      while h < 0 && chain.len() < 4 {
        if !hot[y] || moved[y] || y == b || g.blocks[y].insts.len() > 8 || g.term_kind(y) != K_JUMP {
          break
        }
        chain.push(y)
        let ny = g.blocks[y].insts.len()
        let j = g.blocks[y].insts[ny - 1].targets[0]
        if has_body[j] {
          h = j
        } else if g.blocks[j].insts.len() == 1 && g.blocks[j].insts[0].kind == K_CONDBR {
          for z in g.blocks[j].insts[0].targets {
            if has_body[z] && bodies[z][j] {
              h = z
            }
          }
          if h < 0 {
            y = j
          }
        } else {
          y = j
        }
      }
      // b the test of a loop x is in, or before a loop x heads (while):
      // falling into the loop is best
      if h < 0 || !bodies[h][b] || !bodies[h][l] || has_body[x] || (has_body[b] && bodies[b][x]) || !g.heavy(x, h, l, bodies, has_body) {
        continue
      }
      if i + 1 < g.hot.len() && g.hot[i + 1] == l {
        break
      }
      // move the chain to right after b
      var inc: List[Bool] = []
      for _ in 0..nb {
        inc.push(false)
      }
      for c in chain {
        inc[c] = true
        moved[c] = true
      }
      var out: List[Int] = []
      for z in g.hot {
        if inc[z] {
          continue
        }
        out.push(z)
        if z == b {
          for c in chain {
            out.push(c)
          }
        }
      }
      g.hot = out
      // the blocks a branch reaches the latch through (emission skips
      // the ones whose moves are empty)
      for c in chain {
        if g.copyable(c) {
          g.dup_ok[c] = true
        }
      }
      restart = true // positions changed: scan again (each latch moves once)
      break
    }
    if restart {
      i = 0
    } else {
      i += 1
    }
  }
}

/// Whether x reaches the header of a loop nested in the loop of h
/// without going through h or the latch l.
fn (g: G) heavy(x: Int, h: Int, l: Int, bodies: List[List[Bool]], has_body: List[Bool]) -> Bool {
  var seen: Map[Int, Bool] = {}
  seen[h] = true
  seen[l] = true
  var work = [x]
  while !work.is_empty() {
    let y = work.pop() ?? 0
    if seen.contains(y) || !bodies[h][y] {
      continue
    }
    seen[y] = true
    if has_body[y] && y != h {
      return true
    }
    for s in g.msuccs(y) {
      work.push(s)
    }
  }
  false
}

/// Whether latch b is small and straight: moves and plain instructions
/// without fault exits, then a jump.
fn (g: G) copyable(b: Int) -> Bool {
  let ins = g.blocks[b].insts
  if ins.len() > 4 || ins.is_empty() || ins[ins.len() - 1].kind != K_JUMP {
    return false
  }
  for k in 0..ins.len() - 1 {
    let inst = ins[k]
    if inst.kind == K_PMOVE {
      continue
    }
    if inst.kind == K_PLAIN && !inst.has_fault && inst.recover.is_empty() {
      continue
    }
    return false
  }
  true
}

/// The target of a conditional branch (to t or f) that is a moved latch
/// to copy after the branch, when the other target is next; or -1.
fn (g: G) dup_latch(t: Int, f: Int, next: Int) -> Int {
  for l in [t, f] {
    let o = if l == t { f } else { t }
    if g.dup_ok.contains(l) && o == next && l != next && l != g.cur && g.same_frame(l) {
      return l
    }
  }
  -1
}

/// Emits a copy of latch t (after the branch to its other target).
fn (var g: G) emit_latch(var b: List[Str], t: Int, next: Int) {
  let pos = g.pos
  for (k, inst) in g.blocks[t].insts.indexed() {
    if g.ended {
      break
    }
    // the copy is allocated as the block (emit_plain's free registers
    // at its positions)
    g.pos = g.blocks[t].start + 4 * k
    g.emit_inst(b, inst, next)
  }
  g.pos = pos
}

/// Whether any of lines contains s (s without a newline): text.contains
/// for a text split into lines.
fn any_has(lines: List[Str], s: Str) -> Bool {
  for l in lines {
    if l.contains(s) {
      return true
    }
  }
  false
}

/// Whether a line other than the last ends with s: text.contains("${s}\n")
/// for a text split into lines.
fn any_line_ends(lines: List[Str], s: Str) -> Bool {
  for (i, l) in lines.indexed() {
    if i + 1 < lines.len() && l.ends_with(s) {
      return true
    }
  }
  false
}

/// The lines of xs joined with newlines, without joining them: an
/// element holding newlines is split, the rest kept (the text passes
/// take and give lines, so a function's text is split once, not once a
/// pass).
fn resplit(xs: List[Str]) -> List[Str] {
  var multi = false
  for x in xs {
    if x.contains("\n") {
      multi = true
      break
    }
  }
  if !multi {
    return xs
  }
  var out: List[Str] = []
  for x in xs {
    if x.contains("\n") {
      for y in x.split("\n") {
        out.push(y)
      }
    } else {
      out.push(x)
    }
  }
  out
}
