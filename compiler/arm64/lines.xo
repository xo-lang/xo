// Decision 0274 step 3: a function's lines as structured items for the
// line passes, each instruction parsed once into a compiler/macho Op beside
// its text, and the passes ported to them one at a time behind
// XO_OP_VERIFY (each ported pass's output printed must equal the text
// pass's, function by function). reload_reuse_ops is the first: its slot
// loads and stores are read from the Op instead of matched in the text.
use github.com/xo-lang/xo/compiler/macho

/// One line of a function's text: an instruction's Op beside its text,
/// or (op None) a label, directive, comment, or blank line.
struct Line {
  text: Str
  op: macho.Op?
}

/// The items of lines (a line of several instructions split).
fn to_lines(ls: List[Str]) -> List[Line] {
  var out: List[Line] = List.with_capacity(ls.len())
  for l0 in ls {
    for l in l0.split("\n") {
      if l.starts_with("\t") && !l.starts_with("\t.") {
        let body = l[1..l.len()]
        let bs = body.bytes()
        var k = 0
        while k < bs.len() && bs[k] != ' ' {
          k += 1
        }
        out.push(Line{text: l, op: Some(macho.parse_op(body[0..k], macho.split_operands(bs[k..])))})
      } else {
        out.push(Line{text: l, op: None})
      }
    }
  }
  out
}

/// The texts of items xs.
fn line_texts(xs: List[Line]) -> List[Str] {
  var out: List[Str] = List.with_capacity(xs.len())
  for x in xs {
    out.push(x.text)
  }
  out
}

/// `ldr x16, [sp, #off]` or `ldr x17, [sp, #off]` (parse_ldr's sp form
/// with a scratch register): (true, the register's name, off).
fn op_sp_ldr(x: Line) -> (Bool, Str, Int) {
  if let Some(o) = x.op {
    if o.m == "ldr" && o.ops.len() == 2 {
      if let macho.Operand.Reg(n: r, kind: k) = o.ops[0] {
        if let macho.Operand.MemOp(m: mo) = o.ops[1] {
          if k == macho.RX && (r == 16 || r == 17) && mo.ok && mo.mode == 0 && mo.explicit && mo.base == 31 {
            return (true, "x${r}", mo.off)
          }
        }
      }
    }
  }
  (false, "", 0)
}

/// `str xN, [sp, #off]` or `str xzr, [sp, #off]` (parse_sp_str's form):
/// (true, the register's name, off).
fn op_sp_str(x: Line) -> (Bool, Str, Int) {
  if let Some(o) = x.op {
    if o.m == "str" && o.ops.len() == 2 {
      if let macho.Operand.Reg(n: r, kind: k) = o.ops[0] {
        if let macho.Operand.MemOp(m: mo) = o.ops[1] {
          if k == macho.RX && mo.ok && mo.mode == 0 && mo.explicit && mo.base == 31 {
            return (true, if r == 31 { "xzr" } else { "x${r}" }, mo.off)
          }
        }
      }
    }
  }
  (false, "", 0)
}

/// reload_reuse_l on items (lsr.xo's text pass, the same decisions).
fn reload_reuse_ops(lines: List[Line], nrefs: Map[Str, Int]) -> List[Line] {
  // per label, the references seen so far and what x16 and x17 held at
  // them (the intersection)
  var seen: Map[Str, Int] = {}
  var at16: Map[Str, Int] = {}
  var at17: Map[Str, Int] = {}
  // the slot offsets x16 and x17 hold, -1 for none; whether the line
  // before can fall into the next
  var h16 = -1
  var h17 = -1
  var falls = true
  var out: List[Line] = List.with_capacity(lines.len())
  for x in lines {
    let l = x.text
    let name = label_def(l)
    if !name.is_empty() && is_row_label(name) {
      // a debug line row or variable location: only the debug sections
      // refer to it, never a branch, so what the registers hold stays
      out.push(x)
      continue
    }
    if !name.is_empty() {
      let n = nrefs.get(name) ?? 0
      if n > 0 {
        if (seen.get(name) ?? 0) != n {
          h16 = -1
          h17 = -1
        } else {
          let b16 = at16.get(name) ?? -1
          let b17 = at17.get(name) ?? -1
          h16 = if falls && h16 != b16 { -1 } else { b16 }
          h17 = if falls && h17 != b17 { -1 } else { b17 }
        }
      }
      falls = true
      out.push(x)
      continue
    }
    if !l.starts_with("\t") {
      // a symbol, a comment, or a blank line: forget
      if !l.is_empty() && !l.starts_with("//") {
        h16 = -1
        h17 = -1
      }
      out.push(x)
      continue
    }
    if l.starts_with("\t.") {
      out.push(x) // a directive
      continue
    }
    // the labels this instruction may branch to: what x16 and x17 hold
    // here (before it runs: a branch writes neither)
    for r in line_label_refs(l) {
      let k = seen.get(r) ?? 0
      if k == 0 {
        at16[r] = h16
        at17[r] = h17
      } else {
        if (at16.get(r) ?? -1) != h16 {
          at16[r] = -1
        }
        if (at17.get(r) ?? -1) != h17 {
          at17[r] = -1
        }
      }
      seen[r] = k + 1
    }
    falls = !(l.starts_with("\tb ") || l.starts_with("\tret") || l.starts_with("\tbr ") || l.starts_with("\tbrk"))
    let (lok, lr, loff) = op_sp_ldr(x)
    if lok {
      if (lr == "x16" && h16 == loff) || (lr == "x17" && h17 == loff) {
        continue // it holds the slot already
      }
      if lr == "x16" {
        h16 = loff
      } else {
        h17 = loff
      }
      out.push(x)
      continue
    }
    let (sok, sr, soff) = op_sp_str(x)
    if sok {
      // the slot's value is the stored register's now
      if h16 == soff {
        h16 = -1
      }
      if h17 == soff {
        h17 = -1
      }
      if sr == "x16" {
        h16 = soff
      } else if sr == "x17" {
        h17 = soff
      }
      out.push(x)
      continue
    }
    if writes_scratch(l) {
      // only the register the line writes, when that is all it does (a
      // load into x17 from a base in x16 keeps x16: 2026-10-21,
      // http.dispatch's record copy reloaded the base for every word)
      let (w16, w17) = scratch_written(l)
      if w16 {
        h16 = -1
      }
      if w17 {
        h17 = -1
      }
    }
    out.push(x)
  }
  out
}

/// `ldr x16, [A, #off]` (load) or `str x16, [A, #off]` (x17 when not
/// x16), A sp or an x register (lsr.xo x16_word's form): (true, A's name,
/// off).
fn op_x16_word(x: Line, load: Bool, x16: Bool) -> (Bool, Str, Int) {
  if let Some(o) = x.op {
    if o.m == (if load { "ldr" } else { "str" }) && o.ops.len() == 2 {
      if let macho.Operand.Reg(n: r, kind: k) = o.ops[0] {
        if let macho.Operand.MemOp(m: mo) = o.ops[1] {
          if k == macho.RX && r == (if x16 { 16 } else { 17 }) && mo.ok && mo.mode == 0 && mo.explicit {
            return (true, if mo.base == 31 { "sp" } else { "x${mo.base}" }, mo.off)
          }
        }
      }
    }
  }
  (false, "", 0)
}

/// The lines of ls, each line of several instructions split (what the
/// ported passes' items print as).
fn flat_lines(ls: List[Str]) -> List[Str] {
  var out: List[Str] = []
  for l in ls {
    for x in l.split("\n") {
      out.push(x)
    }
  }
  out
}

/// copy_runs_l on items (lsr.xo's text pass; its word copies read from
/// the Op).
fn copy_runs_ops(xs: List[Line]) -> List[Line] {
  let lines = line_texts(xs)
  if !any_has(lines, "\tstr x16, [") && !any_has(lines, "\tstr x17, [") {
    return xs
  }
  var out: List[Line] = []
  var i = 0
  let n = lines.len()
  while i < n {
    // only a run's first load starts one (most lines: copied at once, no
    // prefix built for them: two strings a line were most of this pass's
    // time, decision 0274's measurement)
    if !lines[i].starts_with("\tldr x1") {
      out.push(xs[i])
      i += 1
      continue
    }
    let x16 = lines[i].starts_with(LD_X16)
    let r = if x16 { "x16" } else { "x17" }
    let (aok, ab, ao) = op_x16_word(xs[i], true, x16)
    let j = past_rows(lines, i + 1)
    let (bok, bb, bo) = if aok && j < n { op_x16_word(xs[j], false, x16) } else { (false, "", 0) }
    if bok {
      // the debug line rows and variable locations among the copies
      // (decisions 0239, 0252): kept, before the copy, as pair_mem
      // keeps them, so a build with debug information has the same code
      var rows: List[Line] = []
      for x in xs[i + 1..j] {
        rows.push(x)
      }
      var e = j + 1
      var k = 1
      while true {
        let c = past_rows(lines, e)
        if c >= n {
          break
        }
        let (cok, cb, co) = op_x16_word(xs[c], true, x16)
        let d = past_rows(lines, c + 1)
        if !cok || cb != ab || co != ao + 8 * k || d >= n {
          break
        }
        let (dok, db, dof) = op_x16_word(xs[d], false, x16)
        if !dok || db != bb || dof != bo + 8 * k {
          break
        }
        for x in xs[e..c] {
          rows.push(x)
        }
        for x in xs[c + 1..d] {
          rows.push(x)
        }
        e = d + 1
        k += 1
      }
      let ok = k >= 4 && scratch_dead(lines, e, "16") && scratch_dead(lines, e, "17")
      let code = if ok { copy_block(r, ab, ao, bb, bo, k) } else { [] }
      if code.is_empty() {
        for x in xs[i..e] {
          out.push(x)
        }
      } else {
        for x in rows + to_lines(code) {
          out.push(x)
        }
      }
      i = e
      continue
    }
    out.push(xs[i])
    i += 1
  }
  out
}

/// `ldr x<n>|d<n>, [x<m>|sp, #<off>]` or `str x<n>|xzr|d<n>, [x<m>,
/// #<off>]` (parse_ldr's and parse_str's forms, st for a store): (true,
/// the register's name, the base's name, off).
fn op_word_mem(x: Line, st: Bool) -> (Bool, Str, Str, Int) {
  let bad = (false, "", "", 0)
  if let Some(o) = x.op {
    if o.m != (if st { "str" } else { "ldr" }) || o.ops.len() != 2 {
      return bad
    }
    if let macho.Operand.Reg(n: r, kind: k) = o.ops[0] {
      if let macho.Operand.MemOp(m: mo) = o.ops[1] {
        if !mo.ok || mo.mode != 0 || !mo.explicit || (st && mo.base == 31) {
          return bad
        }
        let name = if k == macho.RD { "d${r}" } else if k != macho.RX { "" } else if r == 31 { if st { "xzr" } else { "" } } else { "x${r}" }
        if name.is_empty() {
          return bad
        }
        return (true, name, if mo.base == 31 { "sp" } else { "x${mo.base}" }, mo.off)
      }
    }
  }
  bad
}

/// store_span_l on an item: the bytes a `str`, `stur` or `stp` of x, d, w,
/// s or q registers through a plain `[xN, #off]` writes.
fn store_span_op(x: Line) -> (Bool, Int, Int) {
  let no = (false, 0, 0)
  if let Some(o) = x.op {
    if o.m != "str" && o.m != "stur" && o.m != "stp" {
      return no
    }
    let nr = if o.m == "stp" { 2 } else { 1 }
    if o.ops.len() != nr + 1 {
      return no
    }
    var size = 0
    if let macho.Operand.Reg(n: _, kind: k) = o.ops[0] {
      if k == macho.RQ {
        size = 16
      } else if k == macho.RX || k == macho.RD {
        size = 8
      } else if k == macho.RW || k == macho.RS {
        size = 4
      } else {
        return no
      }
    } else {
      return no
    }
    if let macho.Operand.MemOp(m: mo) = o.ops[nr] {
      if !mo.ok || mo.mode != 0 || !mo.explicit || mo.base == 31 {
        return no
      }
      return (true, mo.off, size * nr)
    }
  }
  no
}

/// pair_mem_l on items (lsr.xo's text pass; its loads and stores read
/// from the Op).
fn pair_mem_ops(xs: List[Line], nrefs: Map[Str, Int]) -> List[Line] {
  var out: List[Line] = List.with_capacity(xs.len())
  var i = 0
  let n = xs.len()
  var spans: List[(Int, Int)] = []
  for x in xs {
    let (ok, off, size) = store_span_op(x)
    if ok {
      spans.push((off, size))
    }
  }
  while i < n {
    let (lok, l1, l2, l3) = op_word_mem(xs[i], false)
    let (sok, s1, s2, s3) = op_word_mem(xs[i], true)
    let st = !lok
    let a1 = if lok { l1 } else { s1 }
    let a2 = if lok { l2 } else { s2 }
    let a3 = if lok { l3 } else { s3 }
    if lok || sok {
      var j = i + 1
      // the debug line rows and variable locations among the labels
      // passed: kept, before the pair (as pair_mem_l)
      var rows: List[Line] = []
      while j < n {
        let name = label_def(xs[j].text)
        if name.is_empty() {
          break
        }
        if is_row_label(name) {
          rows.push(xs[j])
          j += 1
          continue
        }
        if nrefs.contains(name) {
          break
        }
        j += 1
      }
      if j < n {
        let (cok, c1, c2, c3) = op_word_mem(xs[j], st)
        if cok && a2 == c2 && (st || (a1 != c1 && a1 != a2)) && same_class(a1, c1) {
          if c3 == a3 + 8 && a3 % 8 == 0 && a3 >= -512 && a3 <= 504 && (st || a2 == "sp" || !a1.starts_with("d") || !partial_store(spans, a3)) {
            let op = if st { "stp" } else { "ldp" }
            for r in rows {
              out.push(r)
            }
            for x in to_lines(["\t${op} ${a1}, ${c1}, [${a2}, #${a3}]"]) {
              out.push(x)
            }
            i = j + 1
            continue
          }
        }
      }
    }
    out.push(xs[i])
    i += 1
  }
  out
}

/// Whether x is an instruction m whose operands are registers of kind RX
/// numbered rs and then, when imm >= 0, the immediate imm.
fn op_is(x: Line, m: Str, rs: List[Int], imm: Int) -> Bool {
  if let Some(o) = x.op {
    let n = rs.len() + if imm >= 0 { 1 } else { 0 }
    if o.m != m || o.ops.len() != n {
      return false
    }
    for k in 0..rs.len() {
      if let macho.Operand.Reg(n: rn, kind: kd) = o.ops[k] {
        if rn != rs[k] || kd != macho.RX {
          return false
        }
      } else {
        return false
      }
    }
    if imm >= 0 {
      if let macho.Operand.Imm(v: v) = o.ops[rs.len()] {
        return v == imm
      }
      return false
    }
    return true
  }
  false
}

/// borrow_flag_peep_l on items (lsr.xo's text pass; its cset, eor, cmp,
/// and carry chain instruction read from the Op).
fn borrow_flag_peep_ops(xs: List[Line]) -> List[Line] {
  let ls = line_texts(xs)
  if !any_has(ls, "\teor ") || !any_line_ends(ls, ", cc") {
    return xs
  }
  var out: List[Line] = List.with_capacity(xs.len())
  var i = 0
  while i < xs.len() {
    let subs = if let Some(o) = xs[i].op { o.m == "subs" } else { false }
    if subs {
      // the next four instructions, past debug row and variable labels
      // (kept, after subs, as borrow_flag_peep_l)
      var at: List[Int] = []
      var rows: List[Line] = []
      var j = i + 1
      while j < xs.len() && at.len() < 4 {
        let j2 = past_rows(ls, j)
        for r in xs[j..j2] {
          rows.push(r)
        }
        if j2 < xs.len() {
          at.push(j2)
        }
        j = j2 + 1
      }
      if at.len() == 4 {
        let (cok, x) = op_cset_cc(xs[at[0]])
        let nx = xs[at[3]]
        let chain = if let Some(o) = nx.op { (o.m == "sbcs" || o.m == "adcs") && !op_reads_x(o, x) } else { false }
        if cok && op_is(xs[at[1]], "eor", [x, x], 1) && op_is(xs[at[2]], "cmp", [x], 1) && chain && scratch_free_after(ls, at[3], "x${x}") {
          out.push(xs[i])
          for r in rows {
            out.push(r)
          }
          i = at[3]
          continue
        }
      }
    }
    out.push(xs[i])
    i += 1
  }
  out
}

/// `cset x<n>, cc` (n not 31): (true, n).
fn op_cset_cc(x: Line) -> (Bool, Int) {
  if let Some(o) = x.op {
    if o.m == "cset" && o.ops.len() == 2 {
      if let macho.Operand.Reg(n: r, kind: k) = o.ops[0] {
        if let macho.Operand.Cond(c: _, name: nm) = o.ops[1] {
          if k == macho.RX && r != 31 && nm == "cc" {
            return (true, r)
          }
        }
      }
    }
  }
  (false, 0)
}

/// Whether one of o's operands is the 64 bit register x<r>.
fn op_reads_x(o: macho.Op, r: Int) -> Bool {
  for p in o.ops {
    if let macho.Operand.Reg(n: rn, kind: k) = p {
      if rn == r && k == macho.RX {
        return true
      }
    }
  }
  false
}

/// far_tests_l on items (emit.xo's text pass; its tests and conditional
/// branches read from the Op, the inverted forms printed from its
/// operands).
fn (g: G) far_tests_ops(xs: List[Line]) -> List[Line] {
  var n = 0
  for x in xs {
    if x.op != None || x.text.starts_with("\t.long ") {
      n += 1
    }
  }
  if n < FAR_TEST_LIMIT {
    return xs
  }
  var out: List[Line] = List.with_capacity(xs.len())
  var k = 0
  for x in xs {
    let o = if let Some(op) = x.op { op } else {
      out.push(x)
      continue
    }
    if (o.m == "tbz" || o.m == "tbnz") && o.ops.len() == 3 {
      k += 1
      let skip = g.local("${g.lbl_prefix()}_far${k}")
      let inv = if o.m == "tbz" { "tbnz" } else { "tbz" }
      for y in to_lines(["\t${inv} ${macho.print_operand(o.ops[0])}, ${macho.print_operand(o.ops[1])}, ${skip}", "\tb ${macho.print_operand(o.ops[2])}", "${skip}:"]) {
        out.push(y)
      }
      continue
    }
    if n >= FAR_COND_LIMIT && (o.m == "cbz" || o.m == "cbnz") && o.ops.len() == 2 {
      k += 1
      let skip = g.local("${g.lbl_prefix()}_far${k}")
      let inv = if o.m == "cbz" { "cbnz" } else { "cbz" }
      for y in to_lines(["\t${inv} ${macho.print_operand(o.ops[0])}, ${skip}", "\tb ${macho.print_operand(o.ops[1])}", "${skip}:"]) {
        out.push(y)
      }
      continue
    }
    if n >= FAR_COND_LIMIT && o.m.starts_with("b.") && o.ops.len() == 1 && !inv_cond(o.m[2..o.m.len()]).is_empty() {
      k += 1
      let skip = g.local("${g.lbl_prefix()}_far${k}")
      for y in to_lines(["\tb.${inv_cond(o.m[2..o.m.len()])} ${skip}", "\tb ${macho.print_operand(o.ops[0])}", "${skip}:"]) {
        out.push(y)
      }
      continue
    }
    out.push(x)
  }
  out
}

/// far_slots_l on items (emit.xo's text pass; its stack slot references
/// read from the Op: the memory operand's base, mode, and offset, the
/// registers before it printed as written).
fn (g: G) far_slots_ops(xs: List[Line]) -> List[Line] {
  if g.base == 0 {
    return xs
  }
  var out: List[Line] = List.with_capacity(xs.len())
  for x in xs {
    let o = if let Some(op) = x.op { op } else {
      out.push(x)
      continue
    }
    let n = o.ops.len()
    var ok = o.m is "ldr" | "str" | "ldp" | "stp" | "ldrb" | "strb" | "ldrh" | "strh" | "ldrsw" | "ldrsb" | "ldrsh"
    var off = 0
    if ok && n >= 2 {
      if let macho.Operand.MemOp(m: mo) = o.ops[n - 1] {
        ok = mo.ok && mo.mode == 0 && mo.explicit && mo.base == 31 && mo.off >= 0
        off = mo.off
      } else {
        ok = false
      }
    } else {
      ok = false
    }
    if !ok {
      out.push(x)
      continue
    }
    var regs: List[Str] = []
    for k in 0..n - 1 {
      regs.push(macho.print_operand(o.ops[k]))
    }
    let rs = regs.join(", ")
    let (scale, pair) = mem_scale(o.m, rs)
    var reach = 4095 * scale
    if pair {
      reach = 63 * scale
    }
    if off <= reach && off % scale == 0 {
      out.push(x)
      continue
    }
    let hi = off & ~4095
    var lo = off & 4095
    var ls: List[Str] = ["\tadd x28, sp, #${hi >> 12}, lsl #12"]
    if lo > reach || lo % scale != 0 {
      ls.push("\tadd x28, x28, #${lo}")
      lo = 0
    }
    ls.push("\t${o.m} ${rs}, [x28, #${lo}]")
    for y in to_lines(ls) {
      out.push(y)
    }
  }
  out
}

/// local_empty_l on items (emit.xo's text pass; the adrp and add of
/// xo_empty_list read from the Op, their operands as written): the
/// function's text.
fn (g: G) local_empty_ops(xs: List[Line]) -> Str {
  let s = g.sym("xo_empty_list")
  let (pg, off) = if g.os == "darwin" { ("${s}@PAGE", "${s}@PAGEOFF") } else { (s, ":lo12:${s}") }
  let lines = line_texts(xs)
  if g.x86 || !any_has(lines, "adrp") || !any_has(lines, pg) {
    return lines.join("\n")
  }
  var n = 0
  for x in xs {
    if x.op != None {
      n += 1
    }
  }
  if n > LOCAL_EMPTY_LIMIT {
    return lines.join("\n")
  }
  let lab = g.local("${g.lbl_prefix()}_el")
  var out: List[Str] = []
  var hit = false
  var i = 0
  while i < xs.len() {
    if i + 1 < xs.len() {
      if let Some(a) = xs[i].op {
        if let Some(d) = xs[i + 1].op {
          if a.m == "adrp" && a.ops.len() == 2 && d.m == "add" && d.ops.len() == 3 && macho.print_operand(a.ops[1]) == pg {
            let r = macho.print_operand(a.ops[0])
            if macho.print_operand(d.ops[0]) == r && macho.print_operand(d.ops[1]) == r && macho.print_operand(d.ops[2]) == off {
              out.push("\tadr ${r}, ${lab}")
              hit = true
              i += 2
              continue
            }
          }
        }
      }
    }
    out.push(xs[i].text)
    i += 1
  }
  if !hit {
    return lines.join("\n")
  }
  out.join("\n") + "\t.p2align 3\n${lab}:\n\t.long 0\n\t.long 2147483648\n\t.long 0\n\t.long 0\n\t.long 0\n\t.long 0\n"
}
