// Loop invariant fields of list elements and proven list indexes
// (decision 0257), on the SSA after inlining, before instruction
// selection: the module verifier checks the result with the inlined code.
//
// A list is a value in the SSA: `bs[j].vx += d` is
// list.set(L, j, setfield(3, list.index(L, j), ...)), a new list that
// differs from L in field 3 of one element. So field k of any element of
// it is field k of the same element of L, for every k but 3, whatever j
// is: a loop whose list parameter comes back only through such sets
// keeps field k of every element, and reading field k of element i (i
// defined outside the loop) is the same in every iteration. nbody's inner
// loop read bs[i].x, y, z and mass each step past its stores to bs[i].vx
// and bs[j].vx (2026-10-17, bench/results/amd64-vs-llvm-2026-10-17.md).

use github.com/xo-lang/xo/compiler/ssa

/// The most fields hoisted out of one loop: each lives in a register
/// across it.
const FIELD_HOIST_MAX = 8

/// How deep the walks through block parameters go.
const FIELD_DEPTH = 12

/// Hoists the loop invariant fields of list elements out of the loops of
/// f, and drops the bounds check of a list.index whose index is proven
/// in range; whether it changed f.
fn hoist_fields(var f: ssa.Func, types: List[ssa.SType]) -> Bool {
  if f.blocks.len() < 2 {
    return false
  }
  let rpo = rpo_of(f)
  let pr = new_proof(f, rpo)
  var changed = false
  var loops = natural_loops(f, rpo, pr.idom, pr.entry)
  // inner loops first: a field hoisted to an inner loop's preheader can
  // leave the outer loop next
  var sizes: List[Int] = []
  for l in loops {
    sizes.push(count_true(l.1))
  }
  for i in 0..loops.len() {
    for j in i + 1..loops.len() {
      if sizes[j] < sizes[i] {
        let t = loops[i]
        loops[i] = loops[j]
        loops[j] = t
        let ts = sizes[i]
        sizes[i] = sizes[j]
        sizes[j] = ts
      }
    }
  }
  for l in loops {
    changed = hoist_loop(f, types, pr, l.0, l.1) || changed
  }
  changed = drop_proven_pads(f, pr) || changed
  // then the fields kept in registers across a loop (promote_loop): each
  // adds a block, so the loops are found again after one
  for _ in 0..PROMOTE_MAX {
    let rpo2 = rpo_of(f)
    let pr2 = new_proof(f, rpo2)
    var any = false
    for l in natural_loops(f, rpo2, pr2.idom, pr2.entry) {
      if promote_loop(f, types, pr2, l.0, l.1) {
        any = true
        break
      }
    }
    if !any {
      break
    }
    changed = true
  }
  changed
}

/// The most loops of a function promote_loop changes.
const PROMOTE_MAX = 8

/// The natural loops of f: each header with the blocks of its loops'
/// bodies (the blocks that reach a back edge's source without passing
/// the header).
fn natural_loops(f: ssa.Func, rpo: List[Int], idom: List[Int], entry: Int) -> List[(Int, List[Bool])] {
  var out: List[(Int, List[Bool])] = []
  let nb = f.blocks.len()
  // a back edge's source comes after its header in reverse postorder
  // (the header dominates it), so an earlier predecessor is no back edge
  // and costs no walk up the dominators, and a block that heads no loop
  // allocates no body (both quadratic in a long straight function: 11%
  // of a 32,768 statement one's build, the scale suite, 2026-10-23)
  var pos: List[Int] = []
  for _ in 0..nb {
    pos.push(-1)
  }
  for (i, b) in rpo.indexed() {
    pos[b] = i
  }
  for h in rpo {
    var work: List[Int] = []
    for e in f.blocks[h].preds {
      let u = f.edges[e].from
      if pos[u] < pos[h] {
        continue
      }
      if idom[u] >= 0 || u == entry {
        if dominates_b(idom, entry, h, u) {
          work.push(u)
        }
      }
    }
    if work.is_empty() {
      continue
    }
    var body: List[Bool] = []
    for _ in 0..nb {
      body.push(false)
    }
    body[h] = true
    while !work.is_empty() {
      let b = work.pop() ?? 0
      if body[b] {
        continue
      }
      body[b] = true
      for e in f.blocks[b].preds {
        work.push(f.edges[e].from)
      }
    }
    out.push((h, body))
  }
  out
}

/// Hoists the invariant fields of the loop with header h and blocks body
/// into its preheader; whether it moved any.
fn hoist_loop(var f: ssa.Func, types: List[ssa.SType], pr: Proof, h: Int, body: List[Bool]) -> Bool {
  // the preheader: the one predecessor outside the loop, ending in a
  // jump to the header
  var pe = -1
  for e in f.blocks[h].preds {
    if body[f.edges[e].from] {
      continue
    }
    if pe >= 0 {
      return false
    }
    pe = e
  }
  if pe < 0 {
    return false
  }
  let p = f.edges[pe].from
  let pt = f.term(p)
  if pt < 0 || f.values[pt].op != ssa.Op.Jump || f.values[pt].succs.len() != 1 {
    return false
  }
  // (index, list, field) to the hoisted field
  var made: Map[(Int, Int, Int), Int] = {}
  var repl: Map[Int, Int] = {}
  var moved: List[Int] = []
  let nb = f.blocks.len()
  for b in 0..nb {
    if !body[b] {
      continue
    }
    for v in f.blocks[b].instrs {
      if made.len() >= FIELD_HOIST_MAX {
        break
      }
      let x = f.values[v]
      if x.op != ssa.Op.Field || x.args.len() != 1 || !scalar(types, x.ty) {
        continue
      }
      let k = aux_int(x.aux)
      let e = f.values[x.args[0]]
      if e.op != ssa.Op.Call || aux_str(e.aux) != "list.index" || e.args.len() != 2 {
        continue
      }
      let idx = e.args[1]
      let ib = f.values[idx].block
      if ib < 0 || body[ib] {
        continue
      }
      // the list at the loop's entry that field k of the element is read
      // from in every iteration
      let l = field_root(f, e.args[0], k, h, body, [], FIELD_DEPTH)
      if l < 0 {
        continue
      }
      var lp = l
      let hp = f.blocks[h].params
      var pi = -1
      for (i, q) in hp.indexed() {
        if q == l {
          pi = i
        }
      }
      if pi >= 0 {
        // every way back to the header keeps field k
        var keeps = true
        for e2 in f.blocks[h].preds {
          if e2 == pe {
            continue
          }
          let r = field_root(f, f.edges[e2].args[pi], k, h, body, [], FIELD_DEPTH)
          keeps = keeps && (r == l || r == -2)
        }
        if !keeps {
          continue
        }
        lp = f.edges[pe].args[pi]
      } else if f.values[l].block < 0 || body[f.values[l].block] {
        continue
      }
      if !pr.proven(f, p, idx, lp) {
        continue
      }
      var nu = made.get((idx, lp, k)) ?? -1
      if nu < 0 {
        let ne = f.values.len()
        f.values.push(ssa.Value{op: ssa.Op.Call, ty: e.ty, args: [lp, idx], aux: e.aux, block: p, line: e.line, inl: e.inl})
        nu = f.values.len()
        f.values.push(ssa.Value{op: ssa.Op.Field, ty: x.ty, args: [ne], aux: x.aux, block: p, line: x.line, inl: x.inl})
        moved.push(ne)
        moved.push(nu)
        made[(idx, lp, k)] = nu
      }
      repl[v] = nu
    }
  }
  if repl.is_empty() {
    return false
  }
  let ins = f.blocks[p].instrs
  let n = ins.len()
  f.blocks[p].instrs = ins[0..n - 1] + moved + [ins[n - 1]]
  for b in 0..nb {
    for v in f.blocks[b].instrs {
      for (i, a) in f.values[v].args.indexed() {
        if let Some(r) = repl.get(a) {
          f.values[v].args[i] = r
        }
      }
    }
  }
  for ei in 0..f.edges.len() {
    for (i, a) in f.edges[ei].args.indexed() {
      if let Some(r) = repl.get(a) {
        f.edges[ei].args[i] = r
      }
    }
  }
  true
}

/// The list value x reads field k of its elements from in every
/// iteration of the loop with header h: a parameter of h, or a value
/// defined outside the loop; through list.set calls that change only
/// other fields of an element (`list.set(X, j, setfield(k2,
/// list.index(X, j), y))`, k2 != k), reuse, and parameters of the loop's
/// other blocks whose incoming values agree. -1 when there is none, -2
/// for a parameter already being walked (it agrees with anything).
fn field_root(f: ssa.Func, x: Int, k: Int, h: Int, body: List[Bool], seen: List[Int], d: Int) -> Int {
  if d <= 0 {
    return -1
  }
  let xv = f.values[x]
  if xv.block < 0 {
    return -1
  }
  if !body[xv.block] {
    return x
  }
  if xv.op == ssa.Op.Param {
    if xv.block == h {
      return x
    }
    if seen.contains(x) {
      return -2
    }
    let s2 = seen + [x]
    var pi = -1
    for (i, q) in f.blocks[xv.block].params.indexed() {
      if q == x {
        pi = i
      }
    }
    var r = -2
    for e in f.blocks[xv.block].preds {
      let a = field_root(f, f.edges[e].args[pi], k, h, body, s2, d - 1)
      if a == -1 {
        return -1
      }
      if a == -2 {
        continue
      }
      if r == -2 {
        r = a
      } else if r != a {
        return -1
      }
    }
    return r
  }
  if xv.op == ssa.Op.Reuse && xv.args.len() == 1 {
    return field_root(f, xv.args[0], k, h, body, seen, d - 1)
  }
  if xv.op == ssa.Op.Call && aux_str(xv.aux) == "list.set" && xv.args.len() == 3 {
    // the stored element: element j of the same list with other fields
    // set
    var s = -1
    s = xv.args[2]
    for _ in 0..16 {
      let sv = f.values[s]
      if sv.op != ssa.Op.SetField {
        break
      }
      if aux_int(sv.aux) == k {
        return -1
      }
      s = sv.args[0]
    }
    let sv = f.values[s]
    if sv.op != ssa.Op.Call || aux_str(sv.aux) != "list.index" || sv.args.len() != 2 || sv.args[0] != xv.args[0] || sv.args[1] != xv.args[1] {
      return -1
    }
    return field_root(f, xv.args[0], k, h, body, seen, d - 1)
  }
  -1
}

/// What proves a list index in range in a function: its dominators and
/// the branches on `x < n` (x to each n and the block the true edge
/// enters, when it has only that edge).
struct Proof {
  idom: List[Int]
  entry: Int
  less: Map[Int, List[(Int, Int)]] = {}
}

fn new_proof(f: ssa.Func, rpo: List[Int]) -> Proof {
  var pr = Proof{idom: dominators_of(f, rpo), entry: rpo[0]}
  for bl in f.blocks {
    if bl.instrs.is_empty() {
      continue
    }
    let tv = f.values[bl.instrs[bl.instrs.len() - 1]]
    if tv.op != ssa.Op.Branch || tv.args.is_empty() || tv.succs.len() != 2 {
      continue
    }
    let c = f.values[tv.args[0]]
    var x = -1
    var n = -1
    if c.op == ssa.Op.Lt && c.args.len() == 2 {
      x = c.args[0]
      n = c.args[1]
    } else if c.op == ssa.Op.Gt && c.args.len() == 2 {
      x = c.args[1]
      n = c.args[0]
    }
    if x < 0 {
      continue
    }
    let tb = f.edges[tv.succs[0]].to
    if f.blocks[tb].preds.len() != 1 {
      continue
    }
    var xs = pr.less.get(x) ?? []
    xs.push((n, tb))
    pr.less[x] = xs
  }
  pr
}

/// Whether 0 <= idx < the length of list l is known in block at: idx is
/// not negative (nonneg), and a branch `idx < list.len(l2)`, l2 of l's
/// length (len_root), took its true edge into a block that has only that
/// edge and dominates at.
fn (pr: Proof) proven(f: ssa.Func, at: Int, idx: Int, l: Int) -> Bool {
  if pr.rem_of_len(f, idx, l) {
    return true
  }
  if !pr.less.contains(idx) {
    return false
  }
  let r = len_root(f, l, [], FIELD_DEPTH)
  if r < 0 {
    return false
  }
  for n in pr.bounds(at, idx) {
    let nv = f.values[n]
    if nv.op == ssa.Op.Call && aux_str(nv.aux) == "list.len" && nv.args.len() == 1 && len_root(f, nv.args[0], [], FIELD_DEPTH) == r {
      return pr.nonneg(f, idx, [], FIELD_DEPTH)
    }
  }
  false
}

/// Whether idx is `a % n` with a never negative and n the length of
/// list l: in [0, n), a length of 0 having faulted in the remainder
/// (2026-10-24: `XS[i % XS.len()]` kept its bounds check, where Go's
/// prove pass drops it).
fn (pr: Proof) rem_of_len(f: ssa.Func, idx: Int, l: Int) -> Bool {
  let x = f.values[idx]
  if x.op != ssa.Op.Rem || x.args.len() != 2 {
    return false
  }
  let nv = f.values[x.args[1]]
  if nv.op != ssa.Op.Call || aux_str(nv.aux) != "list.len" || nv.args.len() != 1 {
    return false
  }
  let r = len_root(f, l, [], FIELD_DEPTH)
  r >= 0 && len_root(f, nv.args[0], [], FIELD_DEPTH) == r && pr.nonneg(f, x.args[0], [], FIELD_DEPTH)
}

/// The values n with `x < n` known in block at.
fn (pr: Proof) bounds(at: Int, x: Int) -> List[Int] {
  var out: List[Int] = []
  for (n, tb) in pr.less.get(x) ?? [] {
    if dominates_b(pr.idom, pr.entry, tb, at) {
      out.push(n)
    }
  }
  out
}

/// Whether x is a call that returns a length.
fn is_len_call(f: ssa.Func, x: Int) -> Bool {
  let xv = f.values[x]
  if xv.op != ssa.Op.Call || xv.args.len() != 1 {
    return false
  }
  let what = aux_str(xv.aux)
  what == "list.len" || what == "Str.len" || what == "bytes.len"
}

/// Whether idx is a length of sv shifted right (by 1 to 63) or divided by
/// a constant of at least 2, with the length known to be at least 1 at
/// block at. Both are then below the length itself, so an index into sv
/// needs no bounds check (2026-10-26: the bench's `b[b.len() / 2]` kept
/// its check, where Go's prove pass drops it; a length of 0 makes both 0
/// and `b[0]` into an empty Bytes faults, so without the len_pos part the
/// check stays).
fn (pr: Proof) div_of_len(f: ssa.Func, at: Int, idx: Int, sv: Int) -> Bool {
  let x = f.values[idx]
  if (x.op != ssa.Op.Shr && x.op != ssa.Op.Div) || x.args.len() != 2 {
    return false
  }
  let kv = f.values[x.args[1]]
  if kv.op != ssa.Op.Const {
    return false
  }
  let k = aux_int(kv.aux)
  if x.op == ssa.Op.Shr {
    // a shift of 64 or more takes a register (isel shift), where it is a
    // shift by 0 and the index equals the length
    if k < 1 || k > 63 {
      return false
    }
  } else if k < 2 {
    return false
  }
  if !is_len_call(f, x.args[0]) {
    return false
  }
  let r = len_root(f, sv, [], FIELD_DEPTH)
  r >= 0 && len_root(f, f.values[x.args[0]].args[0], [], FIELD_DEPTH) == r && pr.len_pos(f, at, sv)
}

/// Whether the length of container sv is at least 1 at block at: a len
/// call on the same container was compared with 0 and the true edge of
/// `len > 0` (`0 < len`) dominates at. The second len call is a value of
/// its own, so the fact has to be found through the container, and
/// div_of_len's rule needs it: `len / 2` is below len only when len is
/// at least 1.
fn (pr: Proof) len_pos(f: ssa.Func, at: Int, sv: Int) -> Bool {
  let r = len_root(f, sv, [], FIELD_DEPTH)
  if r < 0 {
    return false
  }
  for (z, xs) in pr.less {
    let zv = f.values[z]
    if zv.op != ssa.Op.Const || aux_int(zv.aux) != 0 {
      continue
    }
    for (n, tb) in xs {
      if !dominates_b(pr.idom, pr.entry, tb, at) || !is_len_call(f, n) {
        continue
      }
      if len_root(f, f.values[n].args[0], [], FIELD_DEPTH) == r {
        return true
      }
    }
  }
  false
}

/// The list whose length list value x always has: through list.set,
/// reuse, and block parameters whose incoming values agree; x itself
/// when there is none other, -2 for a parameter already being walked.
fn len_root(f: ssa.Func, x: Int, seen: List[Int], d: Int) -> Int {
  if d <= 0 {
    return x
  }
  let xv = f.values[x]
  if xv.op == ssa.Op.Reuse && xv.args.len() == 1 {
    return len_root(f, xv.args[0], seen, d - 1)
  }
  if xv.op == ssa.Op.Call && aux_str(xv.aux) == "list.set" && xv.args.len() == 3 {
    return len_root(f, xv.args[0], seen, d - 1)
  }
  if xv.op == ssa.Op.Param && xv.block > 0 {
    if seen.contains(x) {
      return -2
    }
    let s2 = seen + [x]
    var pi = -1
    for (i, q) in f.blocks[xv.block].params.indexed() {
      if q == x {
        pi = i
      }
    }
    if pi < 0 {
      return x
    }
    var r = -2
    for e in f.blocks[xv.block].preds {
      let a = len_root(f, f.edges[e].args[pi], s2, d - 1)
      if a == -2 {
        continue
      }
      if r == -2 {
        r = a
      } else if r != a {
        return x
      }
    }
    return r
  }
  x
}

/// Whether Int value v is never negative: a constant at least 0, a
/// length, a block parameter whose incoming values are (one being walked
/// counts), or the sum of two such: a checked add (it faults rather than
/// wrap), or an unchecked add of 0 or 1 to a where `a < n` holds for
/// some n, so the sum is at most n and does not wrap (2026-10-24: n
/// need not be a length or not negative, so `for i in 0..n` with n a
/// parameter counts).
fn (pr: Proof) nonneg(f: ssa.Func, v: Int, seen: List[Int], d: Int) -> Bool {
  if d <= 0 {
    return false
  }
  let x = f.values[v]
  match x.op {
    Const => match x.aux {
      I(n) => n >= 0
      _ => false
    }
    Call => aux_str(x.aux) is "list.len" | "Str.len" | "bytes.len"
    Param => {
      if x.block <= 0 {
        return false
      }
      if seen.contains(v) {
        return true
      }
      let s2 = seen + [v]
      var pi = -1
      for (i, q) in f.blocks[x.block].params.indexed() {
        if q == v {
          pi = i
        }
      }
      if pi < 0 || f.blocks[x.block].preds.is_empty() {
        return false
      }
      for e in f.blocks[x.block].preds {
        if !pr.nonneg(f, f.edges[e].args[pi], s2, d - 1) {
          return false
        }
      }
      true
    }
    Add => {
      if x.args.len() != 2 {
        return false
      }
      if !pr.nonneg(f, x.args[0], seen, d - 1) || !pr.nonneg(f, x.args[1], seen, d - 1) {
        return false
      }
      if !x.pos.is_empty() {
        return true
      }
      for j in 0..2 {
        let c = f.values[x.args[1 - j]]
        let small = c.op == ssa.Op.Const && (aux_int(c.aux) is 0 | 1)
        if !small {
          continue
        }
        if !pr.bounds(x.block, x.args[j]).is_empty() {
          return true
        }
      }
      false
    }
    _ => false
  }
}

/// Whether type t is an Int, Float or Bool (a field read without
/// reference counting).
fn scalar(types: List[ssa.SType], t: Int) -> Bool {
  t >= 0 && t < types.len() && (types[t].kind is ssa.Kind.Int | ssa.Kind.Float | ssa.Kind.Bool)
}

// ---------------------------------------------------------------------------
// Fields kept in registers across a loop (decision 0257): nbody's inner
// loop added to bs[i].vx, vy and vz in every iteration, a load and a store
// each, though j > i means nothing else in the loop reads or writes
// element i's velocity. Field k of element idx becomes a parameter of
// the loop's header, from a load in the preheader; the sets of it in the
// loop go, and one set on the loop's exit stores it.

/// Keeps fields of one list element in registers across the loop with
/// header h when promote_plan finds them; whether it changed f.
fn promote_loop(var f: ssa.Func, types: List[ssa.SType], pr: Proof, h: Int, body: List[Bool]) -> Bool {
  let plan = promote_plan(f, types, pr, h, body)
  if plan.fields.is_empty() {
    return false
  }
  let idx = plan.idx
  let p = f.edges[plan.pe].from
  let lp = f.edges[plan.pe].args[plan.pi]
  let l = f.blocks[h].params[plan.pi]
  let et = f.values[l].ty
  let elem = types[et].elems[0]
  // the preheader loads the fields
  var moved: List[Int] = []
  let e0 = f.values.len()
  f.values.push(ssa.Value{op: ssa.Op.Call, ty: elem, args: [lp, idx], aux: ssa.Aux.S(s: "list.index"), block: p})
  moved.push(e0)
  var accs: List[Int] = []
  for k in plan.fields {
    let ft = types[elem].fields[k].ty
    let a0 = f.values.len()
    f.values.push(ssa.Value{op: ssa.Op.Field, ty: ft, args: [e0], aux: ssa.Aux.I(n: k), block: p})
    moved.push(a0)
    let acc = f.add_param(h, ft)
    accs.push(acc)
    f.edges[plan.pe].args.push(a0)
  }
  let pins = f.blocks[p].instrs
  f.blocks[p].instrs = pins[0..pins.len() - 1] + moved + [pins[pins.len() - 1]]
  // the chain: the field's value at each version of the list, the reads
  // of it replaced, the sets of it removed
  var cur = accs
  var at: Map[Int, List[Int]] = {}
  at[l] = cur
  var repl: Map[Int, Int] = {}
  for t in 0..plan.chain.len() {
    let x = plan.chain[t]
    let xv = f.values[x]
    if xv.op == ssa.Op.Call && xv.args[1] == idx {
      let sv = f.values[xv.args[2]]
      let fi = plan.fields.index_of(aux_int(sv.aux)) ?? -1
      if fi >= 0 {
        var c2 = cur
        c2[fi] = sv.args[1]
        cur = c2
        repl[x] = repl.get(xv.args[0]) ?? xv.args[0]
        remove_op(f, x)
      }
    }
    at[x] = cur
  }
  // reads of a promoted field of element idx of a version
  for b in 0..f.blocks.len() {
    if b >= body.len() || !body[b] {
      continue
    }
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      if x.op != ssa.Op.Field {
        continue
      }
      let e = f.values[x.args[0]]
      if e.op != ssa.Op.Call || aux_str(e.aux) != "list.index" || e.args[1] != idx {
        continue
      }
      let fi = plan.fields.index_of(aux_int(x.aux)) ?? -1
      if fi < 0 {
        continue
      }
      if let Some(vs) = at.get(e.args[0]) {
        repl[v] = vs[fi]
      }
    }
  }
  // the latch passes the fields' last values
  for e in f.blocks[h].preds {
    if e != plan.pe {
      let la = f.edges[e].args[plan.pi]
      let vs = at.get(la) ?? cur
      for a in vs {
        f.edges[e].args.push(a)
      }
    }
  }
  replace_all_uses(f, repl)
  // the exit stores the fields: a block on the exit edge
  let t = f.edges[plan.ex].to
  let xb = f.new_block()
  let old_args = f.edges[plan.ex].args
  f.edges[plan.ex].to = xb
  f.edges[plan.ex].args = []
  f.blocks[xb].preds = [plan.ex]
  var tp: List[Int] = []
  for e in f.blocks[t].preds {
    if e != plan.ex {
      tp.push(e)
    }
  }
  let e1 = f.add(xb, ssa.Op.Call, elem, ssa.Aux.S(s: "list.index"), [l, idx])
  var s = e1
  for (fi, k) in plan.fields.indexed() {
    s = f.add(xb, ssa.Op.SetField, elem, ssa.Aux.I(n: k), [s, accs[fi]])
  }
  let l2 = f.add(xb, ssa.Op.Call, et, ssa.Aux.S(s: "list.set"), [l, idx, s])
  var out_args: List[Int] = []
  for a in old_args {
    out_args.push(if a == l { l2 } else { a })
  }
  let ne = f.edges.len()
  f.edges.push(ssa.Edge{from: xb, to: t, args: out_args})
  tp.push(ne)
  f.blocks[t].preds = tp
  let _j = f.add(xb, ssa.Op.Jump, -1, ssa.Aux.None, [])
  f.values[_j].succs = [ne]
  // after the loop the list is the stored one
  for b in 0..f.blocks.len() {
    if b == xb || b >= pr.idom.len() || !dominates_b(pr.idom, pr.entry, t, b) {
      continue
    }
    for v in f.blocks[b].instrs {
      for (i, a) in f.values[v].args.indexed() {
        if a == l {
          f.values[v].args[i] = l2
        }
      }
      for e in f.values[v].succs {
        for (i, a) in f.edges[e].args.indexed() {
          if a == l {
            f.edges[e].args[i] = l2
          }
        }
      }
    }
  }
  true
}

/// What promote_loop keeps in registers in one loop: fields (indexes into
/// the element's struct) of element idx of the header's list parameter
/// pi; pe is the preheader's edge, ex the exit edge; chain holds the
/// list's versions in one iteration, from the header's parameter's first
/// update to the latch's.
struct Promote {
  idx: Int = -1
  pi: Int = -1
  pe: Int = -1
  ex: Int = -1
  fields: List[Int] = []
  chain: List[Int] = []
}

/// The plan of promote_loop for the loop with header h, empty fields
/// when it does not apply: one preheader edge ending a jump, one latch,
/// one exit (from the header, into a block it alone enters); a list
/// parameter that goes round as a straight chain of list.set and reuse;
/// every set of element idx (defined outside the loop, proven in range at
/// the preheader) stores `setfield(k, list.index(X, idx), y)` for one
/// field k, an Int, Float or Bool of a struct without heap values; and
/// every other set, and every read of the list, is at an index that
/// cannot be idx (distinct) or reads element idx's fields only.
fn promote_plan(f: ssa.Func, types: List[ssa.SType], pr: Proof, h: Int, body: List[Bool]) -> Promote {
  let none = Promote{}
  var pe = -1
  var latch = -1
  for e in f.blocks[h].preds {
    if body[f.edges[e].from] {
      if latch >= 0 {
        return none
      }
      latch = e
    } else {
      if pe >= 0 {
        return none
      }
      pe = e
    }
  }
  if pe < 0 || latch < 0 {
    return none
  }
  let p = f.edges[pe].from
  let pt = f.term(p)
  if pt < 0 || f.values[pt].op != ssa.Op.Jump {
    return none
  }
  // the one exit that is not a fault's
  var ex = -1
  for b in 0..body.len() {
    if !body[b] {
      continue
    }
    let tv = f.term(b)
    if tv < 0 {
      return none
    }
    let x = f.values[tv]
    for (si, e) in x.succs.indexed() {
      if body[f.edges[e].to] {
        continue
      }
      if x.op == ssa.Op.Branch && si == 0 && is_landing(f, x.args[0]) {
        continue
      }
      if ex >= 0 {
        return none
      }
      ex = e
    }
  }
  if ex < 0 || f.edges[ex].from != h || f.blocks[f.edges[ex].to].preds.len() != 1 || f.edges[ex].to == h {
    return none
  }
  let hp = f.blocks[h].params
  for (pi, l) in hp.indexed() {
    let lt = f.values[l].ty
    if lt < 0 || types[lt].kind != ssa.Kind.List || types[lt].elems.is_empty() {
      continue
    }
    let elem = types[lt].elems[0]
    if types[elem].kind != ssa.Kind.Struct || !plain_type(types, elem, 4) {
      continue
    }
    // the chain, from the latch's value back to the parameter
    var chain: List[Int] = []
    var x = f.edges[latch].args[pi]
    var ok = true
    while x != l && ok {
      let xv = f.values[x]
      if xv.block < 0 || !body[xv.block] {
        ok = false
      } else if xv.op == ssa.Op.Call && aux_str(xv.aux) == "list.set" && xv.args.len() == 3 {
        chain.push(x)
        x = xv.args[0]
      } else if xv.op == ssa.Op.Reuse && xv.args.len() == 1 {
        chain.push(x)
        x = xv.args[0]
      } else {
        ok = false
      }
    }
    if !ok || chain.is_empty() {
      continue
    }
    chain = chain.reverse()
    // the element: the first set's index defined outside the loop
    var idx = -1
    for c in chain {
      let cv = f.values[c]
      if cv.op == ssa.Op.Call {
        let ib = f.values[cv.args[1]].block
        if ib >= 0 && !body[ib] && idx < 0 {
          idx = cv.args[1]
        }
      }
    }
    if idx < 0 || !pr.proven(f, p, idx, f.edges[pe].args[pi]) {
      continue
    }
    // the fields its sets store, one a set
    var fields: List[Int] = []
    for c in chain {
      let cv = f.values[c]
      if cv.op != ssa.Op.Call {
        continue
      }
      if cv.args[1] == idx {
        let sv = f.values[cv.args[2]]
        if sv.op != ssa.Op.SetField || !scalar(types, f.values[sv.args[1]].ty) {
          ok = false
          break
        }
        let base = f.values[sv.args[0]]
        if base.op != ssa.Op.Call || aux_str(base.aux) != "list.index" || base.args[0] != cv.args[0] || base.args[1] != idx {
          ok = false
          break
        }
        let k = aux_int(sv.aux)
        if !fields.contains(k) {
          fields.push(k)
        }
      } else if !distinct(f, pr, h, body, cv.args[1], idx) {
        ok = false
        break
      }
    }
    if !ok || fields.is_empty() {
      continue
    }
    // every use of a version: the chain's next link, the store's element
    // read, a field read of element idx, a read of another element, the
    // length, or a release on a fault's path
    var versions = [l]
    for c in chain {
      versions.push(c)
    }
    if !versions_ok(f, pr, h, body, versions, idx, chain, latch, pi, ex) {
      continue
    }
    return Promote{idx: idx, pi: pi, pe: pe, ex: ex, fields: fields, chain: chain}
  }
  none
}

/// Whether every use of the list versions of a promotion is one
/// promote_loop accounts for (promote_plan).
fn versions_ok(f: ssa.Func, pr: Proof, h: Int, body: List[Bool], versions: List[Int], idx: Int, chain: List[Int], latch: Int, pi: Int, ex: Int) -> Bool {
  let l = versions[0]
  let t = f.edges[ex].to
  for b in 0..f.blocks.len() {
    let inside = b < body.len() && body[b]
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      for (ai, a) in x.args.indexed() {
        if !versions.contains(a) {
          continue
        }
        if !inside {
          // after the loop only the parameter (where the exit's
          // target dominates: it becomes the stored list), and releases
          // on the paths of faults
          if x.op == ssa.Op.Release || (a == l && dominates_b(pr.idom, pr.entry, t, b)) {
            continue
          }
          return false
        }
        if chain.contains(v) && ai == 0 {
          continue
        }
        if x.op == ssa.Op.Release {
          continue
        }
        if x.op == ssa.Op.Call && ai == 0 {
          let name = aux_str(x.aux)
          if name == "list.len" {
            continue
          }
          if name == "list.index" && x.args.len() == 2 {
            if x.args[1] == idx {
              if index_uses_ok(f, v, chain) {
                continue
              }
              return false
            }
            if distinct(f, pr, h, body, x.args[1], idx) {
              continue
            }
          }
        }
        return false
      }
      for e in x.succs {
        for (k, a) in f.edges[e].args.indexed() {
          if !versions.contains(a) {
            continue
          }
          if e == latch && k == pi {
            continue
          }
          if a == l && !inside && dominates_b(pr.idom, pr.entry, t, b) {
            continue
          }
          if a == l && !body[f.edges[e].to] {
            // the exit's edge (promote_loop passes the stored list)
            continue
          }
          return false
        }
      }
    }
  }
  true
}

/// Whether every use of v, a list.index of element idx of a version, is
/// a field read or the element a set of the chain stores a field of.
fn index_uses_ok(f: ssa.Func, v: Int, chain: List[Int]) -> Bool {
  for bl in f.blocks {
    for u in bl.instrs {
      let x = f.values[u]
      if !x.args.contains(v) {
        continue
      }
      if x.op == ssa.Op.Field {
        continue
      }
      if x.op == ssa.Op.SetField && x.args[0] == v {
        // the stored element of a set of the chain
        var used = false
        for c in chain {
          let cv = f.values[c]
          used = used || (cv.op == ssa.Op.Call && cv.args.len() == 3 && cv.args[2] == u)
        }
        if used {
          continue
        }
      }
      return false
    }
    for u in bl.instrs {
      for e in f.values[u].succs {
        if f.edges[e].args.contains(v) {
          return false
        }
      }
    }
  }
  true
}

/// Whether Int values j and i are never equal: j is a parameter of the
/// loop's header h that enters as i + c (c a constant at least 1) and
/// comes back as j + c2 (c2 at least 0), neither sum wrapping
/// (no_wrap): j > i in every iteration.
fn distinct(f: ssa.Func, pr: Proof, h: Int, body: List[Bool], j: Int, i: Int) -> Bool {
  let jv = f.values[j]
  if jv.op != ssa.Op.Param || jv.block != h {
    return false
  }
  var pi = -1
  for (k, q) in f.blocks[h].params.indexed() {
    if q == j {
      pi = k
    }
  }
  if pi < 0 {
    return false
  }
  for e in f.blocks[h].preds {
    let a = f.edges[e].args[pi]
    let inside = body[f.edges[e].from]
    let base = if inside { j } else { i }
    let least = if inside { 0 } else { 1 }
    if !step_of(f, pr, a, base, least) {
      return false
    }
  }
  true
}

/// Whether a is base + c for a constant c >= least, and the sum cannot
/// wrap: a checked add, or an add of 1 to base where `base < n` holds.
fn step_of(f: ssa.Func, pr: Proof, a: Int, base: Int, least: Int) -> Bool {
  let x = f.values[a]
  if x.op != ssa.Op.Add || x.args.len() != 2 {
    return false
  }
  for k in 0..2 {
    if x.args[k] != base {
      continue
    }
    let c = f.values[x.args[1 - k]]
    if c.op != ssa.Op.Const {
      continue
    }
    let n = aux_int(c.aux)
    if n < least {
      continue
    }
    if !x.pos.is_empty() {
      return true
    }
    if (n is 0 | 1) && !pr.bounds(x.block, base).is_empty() {
      return true
    }
  }
  false
}

/// Whether value c is a landing check (rt.landing), the condition of a
/// branch whose first edge goes to a fault's cleanup.
fn is_landing(f: ssa.Func, c: Int) -> Bool {
  let x = f.values[c]
  x.op == ssa.Op.Call && aux_str(x.aux) == "rt.landing"
}

/// Whether type t holds no heap value: Int, Float, Bool, Unit, and
/// structs and tuples of those, d levels deep.
fn plain_type(types: List[ssa.SType], t: Int, d: Int) -> Bool {
  if t < 0 || t >= types.len() || d <= 0 {
    return false
  }
  let st = types[t]
  match st.kind {
    Int | Float | Bool | Unit => true
    Struct => {
      for fl in st.fields {
        if !plain_type(types, fl.ty, d - 1) {
          return false
        }
      }
      true
    }
    Tuple => {
      for e in st.elems {
        if !plain_type(types, e, d - 1) {
          return false
        }
      }
      true
    }
    _ => false
  }
}

/// Gives every list.index whose index is proven in range (Proof.proven)
/// no check and no landing (drop_pad): it cannot fault, and its landing
/// split the block, so the loads of a loop body stayed in blocks of one
/// load each, apart for cluster_mem; whether it changed f.
fn drop_proven_pads(var f: ssa.Func, pr: Proof) -> Bool {
  var changed = false
  for b in 0..f.blocks.len() {
    if b >= pr.idom.len() || (pr.idom[b] < 0 && b != pr.entry) {
      continue
    }
    for v in f.blocks[b].instrs {
      let x = f.values[v]
      if x.op != ssa.Op.Call || aux_str(x.aux) != "list.index" || x.args.len() != 2 || x.pos.is_empty() {
        continue
      }
      if (x.pad >= 0 && !pad_droppable(f, b, x.pad)) || !pr.proven(f, b, x.args[1], x.args[0]) {
        continue
      }
      f.values[v].pos = ""
      if x.pad >= 0 {
        var ins: List[Int] = []
        for u in f.blocks[b].instrs {
          if u != x.pad {
            ins.push(u)
          }
        }
        f.blocks[b].instrs = ins
        drop_pad(f, b, x.pad)
        f.values[v].pad = -1
      }
      changed = true
    }
  }
  changed
}

/// Removes operation v from its block; its landing check, when it has
/// one, goes too (drop_pad).
fn remove_op(var f: ssa.Func, v: Int) {
  let b = f.values[v].block
  // a check of another shape stays (it then lands nothing)
  let w = if f.values[v].pad >= 0 && pad_droppable(f, b, f.values[v].pad) { f.values[v].pad } else { -1 }
  var ins: List[Int] = []
  for u in f.blocks[b].instrs {
    if u != v && u != w {
      ins.push(u)
    }
  }
  f.blocks[b].instrs = ins
  if w >= 0 {
    drop_pad(f, b, w)
  }
}

/// Whether block b ends in a branch on landing check w, cleanup first
/// (the shape drop_pad rewrites).
fn pad_droppable(f: ssa.Func, b: Int, w: Int) -> Bool {
  let t = f.term(b)
  if t < 0 {
    return false
  }
  let tv = f.values[t]
  tv.op == ssa.Op.Branch && !tv.args.is_empty() && tv.args[0] == w && tv.succs.len() == 2 && f.values[w].block == b
}

/// The landing check w (already out of block b's instructions) goes: the
/// branch on it that ends b becomes a jump to its normal successor, the
/// cleanup only it reached becomes unreachable, and the successor is no
/// longer a landing's rest (so merge_straight may join it to b).
fn drop_pad(var f: ssa.Func, b: Int, w: Int) {
  let t = f.term(b)
  let tv = f.values[t]
  if tv.op != ssa.Op.Branch || tv.args.is_empty() || tv.args[0] != w || tv.succs.len() != 2 {
    return
  }
  let cleanup = tv.succs[0]
  f.values[t] = ssa.Value{op: ssa.Op.Jump, succs: [tv.succs[1]], block: b, line: tv.line, inl: tv.inl}
  kill_edge(f, cleanup)
  f.land_rest.remove(f.edges[tv.succs[1]].to)
}

/// Removes edge e from its target's predecessors; a target left with
/// none (not the entry) ends in unreachable, and its edges go too.
fn kill_edge(var f: ssa.Func, e: Int) {
  let to = f.edges[e].to
  var ps: List[Int] = []
  for q in f.blocks[to].preds {
    if q != e {
      ps.push(q)
    }
  }
  f.blocks[to].preds = ps
  if !ps.is_empty() || to == 0 {
    return
  }
  let t = f.term(to)
  let succs = if t >= 0 { f.values[t].succs } else { [] }
  let u = f.values.len()
  f.values.push(ssa.Value{op: ssa.Op.Unreachable, block: to})
  f.blocks[to].instrs = [u]
  for s in succs {
    kill_edge(f, s)
  }
}

/// Replaces the uses of the keys of repl (operands and edge arguments)
/// by their values, following chains.
fn replace_all_uses(var f: ssa.Func, repl: Map[Int, Int]) {
  if repl.is_empty() {
    return
  }
  for b in 0..f.blocks.len() {
    for v in f.blocks[b].instrs {
      for (i, a) in f.values[v].args.indexed() {
        var r = a
        for _ in 0..64 {
          match repl.get(r) {
            Some(n) => r = n
            None => break
          }
        }
        if r != a {
          f.values[v].args[i] = r
        }
      }
    }
  }
  for ei in 0..f.edges.len() {
    for (i, a) in f.edges[ei].args.indexed() {
      var r = a
      for _ in 0..64 {
        match repl.get(r) {
          Some(n) => r = n
          None => break
        }
      }
      if r != a {
        f.edges[ei].args[i] = r
      }
    }
  }
}
