// A backend failure records the failing function's SSA and MIR for the
// driver to write (irdump.xo, 2026-10-21); once per function.

use github.com/xo-lang/xo/compiler/ssa

test "fail records the function's IR once" {
  var g = G{m: ssa.Module{}, os: "darwin"}
  g.f = ssa.Func{name: "pkg.broken"}
  g.fail("internal: pkg.broken reads virtual register 3 before it is written")
  g.fail("internal: a second failure")
  expect(g.dumps.len()) == 1
  expect(g.dumps[0].0) == "pkg.broken"
  expect(g.dumps[0].1.contains("== ssa")) == true
  expect(g.dumps[0].1.contains("== mir")) == true
  expect(g.err) == "in `pkg.broken`: arm64 backend: internal: pkg.broken reads virtual register 3 before it is written"
}

test "dump_named records only the named function" {
  var m = ssa.Module{}
  m.dump_fn = "keep"
  var g = G{m: m, os: "darwin"}
  g.f = ssa.Func{name: "other"}
  g.dump_named()
  g.f = ssa.Func{name: "keep"}
  g.dump_named()
  expect(g.dumps.len()) == 1
  expect(g.dumps[0].0) == "keep"
}

test "no free scratch register fails the function with its IR, not the process" {
  var g = G{m: ssa.Module{}, os: "darwin"}
  g.f = ssa.Func{name: "pkg.spilly"}
  // past the two scratch registers, with no allocation to take a free
  // one from: scratch_reg has none
  let r = g.scratch_or_fail(false, 2, [])
  expect(r) == gp_scratch(0)
  expect(g.err.contains("no free register for a spilled operand in pkg.spilly")) == true
  expect(g.dumps.len()) == 1
}

test "x86_borrow says none when every register is taken" {
  expect(x86_borrow(false, [10, 9, 8, 1, 2, 6, 7, 0, 3, 12, 13, 14, 15])) == -1
}

test "a failure names the Xo file, line, and function" {
  var g = G{m: ssa.Module{}, os: "darwin"}
  g.f = ssa.Func{name: "main.area", file: "/src/app/main.xo"}
  g.cur_line = 7 * 4096 + 3
  g.fail("internal: main.area reads virtual register 3 before it is written")
  expect(g.err) == "/src/app/main.xo:7:3: in `main.area`: arm64 backend: internal: main.area reads virtual register 3 before it is written"
}
