// Value ranges of Int SSA values (internal/arm64 ranges.go, decision
// 0054): an interval per value for the whole function, found by
// iterating over the blocks in reverse postorder until nothing changes;
// a loop parameter whose interval keeps growing is widened to the next
// threshold. Branches do not narrow (the memo's bounds do that).

use github.com/xo-lang/xo/compiler/ssa

fn full_interval() -> Interval {
  Interval{lo: MIN_INT, hi: MAX_INT}
}

fn union_of(r: Interval, o: Interval) -> Interval {
  Interval{lo: imin(r.lo, o.lo), hi: imax(r.hi, o.hi)}
}

/// a + b clipped to Int.
fn sat_add(a: Int, b: Int) -> Int {
  match a.checked_add(b) {
    Some(s) => s
    None => if a > 0 { MAX_INT } else { MIN_INT }
  }
}

/// a * b, and whether it fits in an Int.
fn mul_ok(a: Int, b: Int) -> (Int, Bool) {
  match a.checked_mul(b) {
    Some(p) => (p, true)
    None => (0, false)
  }
}

fn sat_mul(a: Int, b: Int) -> Int {
  let (p, ok) = mul_ok(a, b)
  if ok {
    return p
  }
  if (a < 0) != (b < 0) {
    return MIN_INT
  }
  MAX_INT
}

/// The interval of v, when known (constants are their own).
fn (g: G) range_get(v: Int) -> (Interval, Bool) {
  let (n, ok) = g.const_int(v)
  if ok {
    return (Interval{lo: n, hi: n}, true)
  }
  if g.has_range[v] {
    return (g.ranges[v], true)
  }
  (Interval{lo: 0, hi: 0}, false)
}

/// Fills the intervals of the function's Int values (computeRanges).
fn (var g: G) compute_ranges(blocks: List[Int], idom: List[Int]) {
  let nv = g.f.values.len()
  let mids = g.midpoints(blocks, idom)
  g.ranges = []
  g.has_range = []
  for _ in 0..nv {
    g.ranges.push(Interval{lo: 0, hi: 0})
    g.has_range.push(false)
  }
  // thresholds for widening
  var ups: List[Int] = [0, MAX_INT]
  var downs: List[Int] = [0, MIN_INT]
  for b in blocks {
    for v in g.f.blocks[b].instrs {
      let x = g.f.values[v]
      if (x.op == ssa.Op.Rem || x.op == ssa.Op.And) && ssa.ty_of(x.tb) >= 0 && g.kind(ssa.ty_of(x.tb)) == ssa.Kind.Int {
        let (k0, ok) = g.const_int(x.args[1])
        if ok && k0 != MIN_INT {
          var k = k0
          if k < 0 {
            k = -k
          }
          if x.op == ssa.Op.Rem && k > 0 {
            k -= 1
          }
          ups.push(k)
          downs.push(-k)
        }
      }
    }
  }
  g.acc_caps = {}
  if g.ranges_fix(blocks, mids, ups, downs) {
    if !g.m.passes_on.contains("acc_range") {
      return
    }
    // decision 0577: the induction bounds from the settled intervals,
    // then the fixed point again within them
    let caps = g.acc_bounds(blocks, idom)
    if caps.is_empty() {
      return
    }
    g.acc_caps = caps
    for i in 0..nv {
      g.has_range[i] = false
    }
    if g.ranges_fix(blocks, mids, ups, downs) {
      return
    }
  }
  // did not settle: know nothing
  g.acc_caps = {}
  for i in 0..nv {
    g.has_range[i] = false
  }
}

/// Iterates the intervals to a fixed point; whether they settled.
fn (var g: G) ranges_fix(blocks: List[Int], mids: Map[Int, (Int, Int)], ups: List[Int], downs: List[Int]) -> Bool {
  let nv = g.f.values.len()
  var grown: List[Int] = []
  for _ in 0..nv {
    grown.push(0)
  }
  for _ in 0..100 {
    var changed = false
    for (bi, b) in blocks.indexed() {
      for (k, p) in g.f.blocks[b].params.indexed() {
        if g.vkind(p) != ssa.Kind.Int {
          continue
        }
        if bi == 0 {
          changed = g.range_set(p, full_interval(), ups, downs, grown) || changed
          continue
        }
        var r = Interval{lo: 0, hi: 0}
        var any = false
        for e in g.f.blocks[b].preds {
          let (a, ok) = g.range_get(g.f.edges[e].args[k])
          if !ok {
            continue // not reached yet: optimistic
          }
          if !any {
            r = a
            any = true
          } else {
            r = union_of(r, a)
          }
        }
        if any {
          changed = g.range_set(p, r, ups, downs, grown) || changed
        }
      }
      for v in g.f.blocks[b].instrs {
        let x = g.f.values[v]
        if ssa.ty_of(x.tb) < 0 || g.kind(ssa.ty_of(x.tb)) != ssa.Kind.Int || x.op == ssa.Op.Const {
          continue
        }
        let (r0, ok) = g.range_of(v)
        var r = r0
        if ok {
          if let Some(ab) = mids.get(v) {
            // a <= m < b (decision 0184)
            let (ra, ok1) = g.range_get(ab.0)
            let (rb, ok2) = g.range_get(ab.1)
            if ok1 && ok2 && rb.hi > MIN_INT {
              // Empty only on a path no run takes (seeds 444, 1502 and
              // 1821 of TestArithProperty): keep r, since every user of
              // an interval assumes lo <= hi.
              let m = Interval{lo: imax(r.lo, ra.lo), hi: imin(r.hi, rb.hi - 1)}
              if m.lo <= m.hi {
                r = m
              }
            }
          }
          changed = g.range_set(v, r, ups, downs, grown) || changed
        }
      }
    }
    if !changed {
      return true
    }
  }
  false
}

/// The values m = a + (b - a) / 2 (or `>> 1`) computed where a < b
/// holds, with their (a, b) (ranges.go midpoints, decision 0184).
fn (g: G) midpoints(blocks: List[Int], idom: List[Int]) -> Map[Int, (Int, Int)] {
  var out: Map[Int, (Int, Int)] = {}
  for b in blocks {
    for v in g.f.blocks[b].instrs {
      let (lo, hi, ok) = g.mid_of(v)
      if !ok {
        continue
      }
      var d = b
      while d >= 0 {
        if g.less_on_entry(d, lo, hi) {
          out[v] = (lo, hi)
          break
        }
        d = idom[d]
      }
    }
  }
  out
}

/// Matches v = a + (b - a) / 2 (or `>> 1`, either operand order).
fn (g: G) mid_of(v: Int) -> (Int, Int, Bool) {
  let x = g.f.values[v]
  if x.op != ssa.Op.Add || ssa.ty_of(x.tb) < 0 || g.kind(ssa.ty_of(x.tb)) != ssa.Kind.Int {
    return (-1, -1, false)
  }
  for k in 0..2 {
    let a = x.args[k]
    let h = g.f.values[x.args[1 - k]]
    var half = false
    if h.args.len() == 2 {
      let (n, is_k) = g.const_int(h.args[1])
      if is_k {
        half = (h.op == ssa.Op.Div && n == 2) || (h.op == ssa.Op.Shr && n == 1)
      }
    }
    if !half {
      continue
    }
    let d = g.f.values[h.args[0]]
    if d.op == ssa.Op.Sub && d.args[1] == a {
      return (a, d.args[0], true)
    }
  }
  (-1, -1, false)
}

/// Whether block d is entered only by the edge of a branch on which
/// a < b holds.
fn (g: G) less_on_entry(d: Int, a: Int, b: Int) -> Bool {
  let preds = g.f.blocks[d].preds
  if preds.len() != 1 {
    return false
  }
  let t = g.f.term(g.f.edges[preds[0]].from)
  if t < 0 || g.f.values[t].op != ssa.Op.Branch {
    return false
  }
  let tv = g.f.values[t]
  let yes = g.f.edges[ssa.succ(tv, 0)].to == d
  let no = g.f.edges[ssa.succ(tv, 1)].to == d
  if yes == no {
    return false
  }
  let c = g.f.values[tv.args[0]]
  if c.args.len() != 2 {
    return false
  }
  let x = c.args[0]
  let y = c.args[1]
  if (yes && c.op == ssa.Op.Lt) || (no && c.op == ssa.Op.Ge) {
    return x == a && y == b
  }
  if (yes && c.op == ssa.Op.Gt) || (no && c.op == ssa.Op.Le) {
    return x == b && y == a
  }
  false
}

/// Sets the interval of v (widening a loop parameter that keeps growing)
/// and reports whether it changed.
fn (var g: G) range_set(v: Int, r0: Interval, ups: List[Int], downs: List[Int], var grown: List[Int]) -> Bool {
  var r = r0
  if r.lo > r.hi {
    // empty: v is never computed (a checked product that always
    // overflows, facts that contradict each other); every user of an
    // interval assumes lo <= hi, so know nothing (TestArithProperty
    // seed 1502: Sub negated an empty interval's hi of MIN_INT)
    r = full_interval()
  }
  let had = g.has_range[v]
  let old = g.ranges[v]
  if had && old == r {
    return false
  }
  if had && g.is_param(v) {
    // a loop parameter that grows: widen after two rounds
    r = union_of(r, old)
    if r == old {
      return false
    }
    grown[v] += 1
    if grown[v] > 2 {
      if r.hi > old.hi {
        var best = MAX_INT
        for t in ups {
          if t >= r.hi && t < best {
            best = t
          }
        }
        r.hi = best
      }
      if r.lo < old.lo {
        var best = MIN_INT
        for t in downs {
          if t <= r.lo && t > best {
            best = t
          }
        }
        r.lo = best
      }
    }
  }
  if let Some(c) = g.acc_caps.get(v) {
    // within its induction bound (decision 0577), which holds for every
    // value v takes
    let k = Interval{lo: imax(r.lo, c.lo), hi: imin(r.hi, c.hi)}
    if k.lo <= k.hi {
      r = k
    }
    if had && old == r {
      return false
    }
  }
  g.ranges[v] = r
  g.has_range[v] = true
  true
}

/// The interval of v from its operands' (false while an operand has none
/// yet).
fn (var g: G) range_of(v: Int) -> (Interval, Bool) {
  let x = g.f.values[v]
  let none = (Interval{lo: 0, hi: 0}, false)
  match x.op {
    Add | Sub | Mul => {
      let (a, ok1) = g.range_get(x.args[0])
      let (b, ok2) = g.range_get(x.args[1])
      if !ok1 || !ok2 {
        return none
      }
      if x.op == ssa.Op.Add {
        return (Interval{lo: sat_add(a.lo, b.lo), hi: sat_add(a.hi, b.hi)}, true)
      }
      if x.op == ssa.Op.Sub {
        if b.lo == MIN_INT {
          return (full_interval(), true)
        }
        return (Interval{lo: sat_add(a.lo, -b.hi), hi: sat_add(a.hi, -b.lo)}, true)
      }
      let c0 = sat_mul(a.lo, b.lo)
      let c1 = sat_mul(a.lo, b.hi)
      let c2 = sat_mul(a.hi, b.lo)
      let c3 = sat_mul(a.hi, b.hi)
      var r = Interval{lo: imin(imin(c0, c1), imin(c2, c3)), hi: imax(imax(c0, c1), imax(c2, c3))}
      // a checked Int product (one with a position; isel.xo add_sub's
      // rule) faults on overflow, so past it the value is a
      // multiple of a constant factor k within Int: at most (MAX / k) * k
      // (2026-10-17: collatz's 3 * n + 1 kept its check, though 3 * n is
      // at most MAX - 1; LLVM drops it)
      var k = 0
      for c in [x.args[0], x.args[1]] {
        let (kc, is_k) = g.const_int(c)
        if is_k {
          k = kc
        }
      }
      if k < 0 && k != MIN_INT {
        k = -k
      }
      if k >= 2 && ssa.has_pos(x.lp) {
        r = Interval{lo: imax(r.lo, (MIN_INT / k) * k), hi: imin(r.hi, (MAX_INT / k) * k)}
      }
      (r, true)
    }
    Div => {
      let (a, ok) = g.range_get(x.args[0])
      let (k, is_k) = g.const_int(x.args[1])
      if !ok {
        return none
      }
      if !is_k || k <= 0 {
        return (full_interval(), true)
      }
      (Interval{lo: a.lo / k, hi: a.hi / k}, true)
    }
    Rem => {
      let (a, ok) = g.range_get(x.args[0])
      if !ok {
        return none
      }
      let (k0, is_k) = g.const_int(x.args[1])
      if !is_k || k0 == 0 || k0 == MIN_INT {
        return (full_interval(), true)
      }
      let k = if k0 < 0 { -k0 } else { k0 }
      let m = k - 1
      if a.lo >= 0 {
        return (Interval{lo: 0, hi: imin(a.hi, m)}, true)
      }
      if a.hi <= 0 {
        return (Interval{lo: imax(a.lo, -m), hi: 0}, true)
      }
      (Interval{lo: imax(a.lo, -m), hi: imin(a.hi, m)}, true)
    }
    And => {
      let (a, ok1) = g.range_get(x.args[0])
      let (b, ok2) = g.range_get(x.args[1])
      if !ok1 || !ok2 {
        return none
      }
      if a.lo >= 0 && b.lo >= 0 {
        return (Interval{lo: 0, hi: imin(a.hi, b.hi)}, true)
      }
      if a.lo >= 0 {
        return (Interval{lo: 0, hi: a.hi}, true)
      }
      if b.lo >= 0 {
        return (Interval{lo: 0, hi: b.hi}, true)
      }
      (full_interval(), true)
    }
    Or | Xor => {
      // nonnegative operands: below the next power of two above the
      // larger bound (2026-10-25: text.digits_word's
      // `(w << 8) | (48 + x % 10)` once unrolled; its masks and its
      // shift checks wait on these bounds)
      let (a, ok1) = g.range_get(x.args[0])
      let (b, ok2) = g.range_get(x.args[1])
      if !ok1 || !ok2 {
        return none
      }
      if a.lo >= 0 && b.lo >= 0 {
        let hi = imax(a.hi, b.hi)
        var m = 1
        while m <= hi && m < (1 << 62) {
          m = m << 1
        }
        let top = if hi >= (1 << 62) { MAX_INT } else { m - 1 }
        return (Interval{lo: if x.op == ssa.Op.Or { imax(a.lo, b.lo) } else { 0 }, hi: top}, true)
      }
      (full_interval(), true)
    }
    Shl => {
      // by a constant that loses no bit of a nonnegative operand
      let (a, ok) = g.range_get(x.args[0])
      let (k, is_k) = g.const_int(x.args[1])
      if !ok {
        return none
      }
      if is_k && k >= 0 && k <= 62 && a.lo >= 0 && a.hi <= (MAX_INT >> k) {
        return (Interval{lo: a.lo << k, hi: a.hi << k}, true)
      }
      (full_interval(), true)
    }
    Shr => {
      let (a, ok) = g.range_get(x.args[0])
      let (k, is_k) = g.const_int(x.args[1])
      if !ok {
        return none
      }
      if !is_k || k < 0 || k > 63 {
        return (full_interval(), true)
      }
      (Interval{lo: a.lo >> k, hi: a.hi >> k}, true)
    }
    Neg => {
      let (a, ok) = g.range_get(x.args[0])
      if !ok {
        return none
      }
      if a.lo == MIN_INT {
        if a.hi == MIN_INT {
          // -MinInt64 wraps to itself in Go
          return (Interval{lo: MIN_INT, hi: MAX_INT}, true)
        }
        return (Interval{lo: -a.hi, hi: MAX_INT}, true)
      }
      (Interval{lo: -a.hi, hi: -a.lo}, true)
    }
    Call => {
      match g.f.name_of(x) {
        "list.len" => (Interval{lo: 0, hi: MAX_INT}, true)
        // bytes in memory (decision 0184): an address space of 2^48
        "Str.len" => (Interval{lo: 0, hi: MAX_STR_LEN}, true)
        "bytes.index" => (Interval{lo: 0, hi: 255}, true)
        // a 1, 2 or 4 byte load zero-extends (ldrb, ldrh, ldr w; calls.xo):
        // raw.byte_at's digit tests and sums were checked for overflow a
        // byte at a time (2026-10-30: text.parse_duration's fraction
        // digits, a `subs` and a `b.vs` each)
        "rt.mem_load" => {
          let (w, wc) = g.const_int(x.args[2])
          if wc && (w == 1 || w == 2 || w == 4) {
            (Interval{lo: 0, hi: (1 << (8 * w)) - 1}, true)
          } else {
            (full_interval(), true)
          }
        }
        _ => g.call_bound(x)
      }
    }
    IntConv => g.range_get(x.args[0])
    _ => (full_interval(), true)
  }
}

/// A bound of the length of a Str or Bytes value.
const MAX_STR_LEN = 4294967295

/// The interval of Int value v.
fn (g: G) ssa_range(v: Int) -> Interval {
  if g.has_range[v] {
    return g.ranges[v]
  }
  full_interval()
}

/// Whether the multiplication v cannot overflow.
fn (var g: G) safe_mul(v: Int) -> Bool {
  let (alo, ahi) = g.bounds(g.arg(v, 0))
  let (blo, bhi) = g.bounds(g.arg(v, 1))
  for x in [alo, ahi] {
    for y in [blo, bhi] {
      let (_, ok) = mul_ok(x, y)
      if !ok {
        return false
      }
    }
  }
  true
}

/// The interval of a call's Int result from the callee's summary
/// (retle.xo): at least its parameter j and at most its parameter k, as
/// those arguments' intervals say (strings.space_end(b, 0, n) is never
/// negative).
fn (var g: G) call_bound(x: ssa.Value) -> (Interval, Bool) {
  var r = full_interval()
  let ci = g.by_name.get(g.f.name_of(x)) ?? -1
  if ci < 0 || ssa.ty_of(x.tb) < 0 || g.kind(ssa.ty_of(x.tb)) != ssa.Kind.Int {
    return (r, true)
  }
  let lk = g.ret_ge_of(ci)
  if lk >= 0 && lk < x.args.len() {
    let (a, ok) = g.range_get(x.args[lk])
    if ok {
      r = Interval{lo: a.lo, hi: r.hi}
    }
  }
  let hk = g.ret_le_of(ci)
  if hk >= 0 && hk < x.args.len() {
    let (a, ok) = g.range_get(x.args[hk])
    if ok && a.hi >= r.lo {
      r = Interval{lo: r.lo, hi: a.hi}
    }
  }
  (r, true)
}

/// The induction bounds of decision 0577, from the settled intervals: for
/// each loop header h whose branch leaves the loop unless `i < n`, with i
/// a header parameter stepping by a constant d > 0 on every back edge,
/// each other Int parameter s that every back edge passes as s or as a
/// chain of adds and subtractions of s with bounded operands is within
/// [lo0 + T * steplo, hi0 + T * stephi]: T the trips, at most
/// ceil((N - c) / d) for i from c and n at most N, [lo0, hi0] its entry
/// values, [steplo, stephi] what a trip adds (a byte sum over a Bytes
/// length stays under 2^40).
fn (var g: G) acc_bounds(blocks: List[Int], idom: List[Int]) -> Map[Int, Interval] {
  var caps: Map[Int, Interval] = {}
  for h in blocks {
    let hb = g.f.blocks[h]
    if hb.params.len() < 2 {
      continue
    }
    var back: List[Int] = []
    var entry: List[Int] = []
    for e in hb.preds {
      if dominates(idom, h, g.f.edges[e].from) {
        back.push(e)
      } else {
        entry.push(e)
      }
    }
    if back.is_empty() || entry.is_empty() {
      continue
    }
    // the test: the loop goes on only while i < n
    let t = g.f.term(h)
    if t < 0 || g.f.values[t].op != ssa.Op.Branch || ssa.succ_n(g.f.values[t]) != 2 || g.f.values[t].args.len() != 1 {
      continue
    }
    let tv = g.f.values[t]
    let cv = g.f.values[tv.args[0]]
    if cv.args.len() != 2 || !(cv.op is ssa.Op.Lt | ssa.Op.Gt) {
      continue
    }
    let iv = if cv.op == ssa.Op.Lt { cv.args[0] } else { cv.args[1] }
    let nv = if cv.op == ssa.Op.Lt { cv.args[1] } else { cv.args[0] }
    let pi = hb.params.index_of(iv) ?? -1
    if pi < 0 || !g.plain_int(iv) {
      continue
    }
    // the false edge must leave the loop: its target reaches no back
    // edge without passing h
    let body = g.loop_body(h, back)
    let out = g.f.edges[ssa.succ(tv, 1)].to
    if out == h || body[out] {
      continue
    }
    // i's constant step d > 0 on every back edge
    var d = 0
    var counted = true
    for e in back {
      let a = g.f.edges[e].args[pi]
      let x = g.f.values[a]
      var k = 0
      if x.op == ssa.Op.Add && x.args.len() == 2 && (x.args[0] == iv || x.args[1] == iv) {
        let (k1, ok1) = g.const_int(x.args[if x.args[0] == iv { 1 } else { 0 }])
        if ok1 {
          k = k1
        }
      }
      if k <= 0 || (d != 0 && k != d) {
        counted = false
        break
      }
      d = k
    }
    if !counted {
      continue
    }
    let (rn, nok) = g.range_get(nv)
    var c = MAX_INT
    var cok = nok
    for e in entry {
      let (r, ok) = g.range_get(g.f.edges[e].args[pi])
      if !ok {
        cok = false
        break
      }
      c = imin(c, r.lo)
    }
    // i and n never negative: a signed and an unsigned `<` agree
    if !cok || c < 0 || rn.lo < 0 {
      continue
    }
    // the trips that reach a back edge
    var trips = 0
    if rn.hi > c {
      let span = match rn.hi.checked_sub(c) {
        Some(x) => x
        None => continue
      }
      trips = span / d + (if span % d != 0 { 1 } else { 0 })
    }
    for (k, s) in hb.params.indexed() {
      if k == pi || !g.plain_int(s) {
        continue
      }
      var lo0 = MAX_INT
      var hi0 = MIN_INT
      var ok = true
      for e in entry {
        let (r, rok) = g.range_get(g.f.edges[e].args[k])
        if !rok {
          ok = false
          break
        }
        lo0 = imin(lo0, r.lo)
        hi0 = imax(hi0, r.hi)
      }
      var slo = 0
      var shi = 0
      for e in back {
        if !ok {
          break
        }
        let (l, hh, cok2) = g.acc_step(g.f.edges[e].args[k], s, 16)
        ok = cok2
        slo = imin(slo, l)
        shi = imax(shi, hh)
      }
      if !ok {
        continue
      }
      let hi = if shi <= 0 { hi0 } else { sat_add(hi0, sat_mul(trips, shi)) }
      let lo = if slo >= 0 { lo0 } else { sat_add(lo0, sat_mul(trips, slo)) }
      if hi < MAX_INT || lo > MIN_INT {
        caps[s] = Interval{lo: lo, hi: hi}
      }
    }
  }
  caps
}

/// What v adds to s: v is s, or a chain of Int adds and subtractions of s
/// with operands whose intervals are known; the interval of v - s.
fn (g: G) acc_step(v: Int, s: Int, depth: Int) -> (Int, Int, Bool) {
  if v == s {
    return (0, 0, true)
  }
  let x = g.f.values[v]
  if depth <= 0 || x.args.len() != 2 || !(x.op is ssa.Op.Add | ssa.Op.Sub) || !g.plain_int(v) {
    return (0, 0, false)
  }
  for j in 0..2 {
    if j == 1 && x.op == ssa.Op.Sub {
      break // s - ... only, not ... - s
    }
    let (lo, hi, ok) = g.acc_step(x.args[j], s, depth - 1)
    if !ok {
      continue
    }
    let (r, rok) = g.range_get(x.args[1 - j])
    if !rok {
      return (0, 0, false)
    }
    if x.op == ssa.Op.Add {
      return (sat_add(lo, r.lo), sat_add(hi, r.hi), true)
    }
    if r.hi == MIN_INT || r.lo == MIN_INT {
      return (0, 0, false)
    }
    return (sat_add(lo, -r.hi), sat_add(hi, -r.lo), true)
  }
  (0, 0, false)
}

/// The blocks that reach one of the back edges' sources without passing
/// through h (the loop's body, h not in it).
fn (g: G) loop_body(h: Int, back: List[Int]) -> List[Bool] {
  var body: List[Bool] = []
  for _ in 0..g.f.blocks.len() {
    body.push(false)
  }
  var work: List[Int] = []
  for e in back {
    let b = g.f.edges[e].from
    if b != h && !body[b] {
      body[b] = true
      work.push(b)
    }
  }
  while !work.is_empty() {
    let b = work.pop() ?? -1
    for e in g.f.blocks[b].preds {
      let p = g.f.edges[e].from
      if p != h && !body[p] {
        body[p] = true
        work.push(p)
      }
    }
  }
  body
}

/// Whether v is an Int (not a sized integer, whose arithmetic wraps).
fn (g: G) plain_int(v: Int) -> Bool {
  let t = ssa.ty_of(g.f.values[v].tb)
  t >= 0 && g.kind(t) == ssa.Kind.Int && g.m.types[t].bits == 0
}
