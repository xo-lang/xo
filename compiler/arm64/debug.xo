// DWARF line tables (decision 0239): each function emitted with debug
// information on records its source file, its begin and end labels, and
// a row label wherever the source line changes (emit.xo); the part's
// records become .debug_line (a DWARF 5 line program, one sequence per
// function), .debug_abbrev, and .debug_info (a compile unit with a
// subprogram per function). Addresses are `.quad label` (absolute
// relocations only, which every assembler and compiler/macho handle);
// every length is counted here, so no label differences are needed.

/// The debug sections of the part, or "" with none.
fn (g: G) debug_sections(with_static: Bool) -> Str {
  if !g.m.debug_info || (g.dbgs.is_empty() && !with_static) {
    return ""
  }
  let mac = g.os == "darwin"
  // the functions: file, name, begin, end, rows (label, packed line,
  // inline site), inline sites (callee, file, call line, parent)
  var files: List[Str] = []
  var file_at: Map[Str, Int] = {}
  var recs: List[DbgFunc] = []
  for d in g.dbgs {
    let p = d.split("\t")
    if p.len() != 6 && p.len() != 7 {
      continue
    }
    let file = if p[0].is_empty() { "<generated>" } else { p[0] }
    let fi = file_index(file, files, file_at)
    var sites: List[DbgSite] = []
    if !p[5].is_empty() {
      for s in p[5].split(";") {
        let q = s.split("|")
        if q.len() == 4 {
          let sf = if q[1].is_empty() { file } else { q[1] }
          sites.push(DbgSite{callee: q[0], file: file_index(sf, files, file_at), call_line: Int.parse(q[2]) ?? 0, parent: Int.parse(q[3]) ?? -1})
        }
      }
    }
    var rows: List[DbgRow] = []
    for r in p[4].split(";") {
      let lr = r.split(" ")
      if lr.len() == 3 {
        let site = Int.parse(lr[2]) ?? -1
        let rf = if site >= 0 && site < sites.len() { sites[site].file } else { fi }
        rows.push(DbgRow{label: lr[0], line: Int.parse(lr[1]) ?? 0, file: rf, site: if site < sites.len() { site } else { -1 }})
      }
    }
    var vars: List[DbgVar] = []
    if p.len() == 7 && !p[6].is_empty() {
      for v in p[6].split(";") {
        let q = v.split("|")
        if q.len() != 5 && q.len() != 6 {
          continue
        }
        var ents: List[DbgLoc] = []
        if !q[4].is_empty() {
          for e in q[4].split("~") {
            let t = e.split(" ")
            if t.len() == 3 {
              ents.push(DbgLoc{start: t[0], end: t[1], ops: t[2]})
            }
          }
        }
        let inl = if q.len() == 6 { Int.parse(q[5]) ?? -1 } else { -1 }
        vars.push(DbgVar{name: q[0], ty: q[1], param: q[2] == "1", line: Int.parse(q[3]) ?? 0, locs: ents, inl: inl})
      }
    }
    recs.push(DbgFunc{file: fi, name: p[1], begin: p[2], end: p[3], rows: rows, sites: sites, vars: vars})
  }
  if files.is_empty() {
    // a unit for xo_static alone (the last file of a split build)
    files.push("<generated>")
  }
  let dir = if g.m.comp_dir.is_empty() { "." } else { g.m.comp_dir }
  var out = StrBuilder.new()
  // .debug_line
  var hdr = Dw{}
  hdr.u8(1) // minimum_instruction_length
  hdr.u8(1) // maximum_operations_per_instruction
  hdr.u8(1) // default_is_stmt
  hdr.u8(251) // line_base -5
  hdr.u8(14) // line_range
  hdr.u8(13) // opcode_base
  for n in [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1] {
    hdr.u8(n)
  }
  // directories: the compile directory, and the one std/'s file names
  // are relative to
  let stdd = !g.m.std_root.is_empty()
  hdr.u8(1) // directory_entry_format_count
  hdr.uleb(1) // DW_LNCT_path
  hdr.uleb(8) // DW_FORM_string
  hdr.uleb(if stdd { 2 } else { 1 })
  hdr.str(dir)
  if stdd {
    hdr.str(g.m.std_root)
  }
  hdr.u8(2) // file_name_entry_format_count
  hdr.uleb(1) // DW_LNCT_path
  hdr.uleb(8) // DW_FORM_string
  hdr.uleb(2) // DW_LNCT_directory_index
  hdr.uleb(15) // DW_FORM_udata
  hdr.uleb(files.len())
  for f in files {
    hdr.str(f)
    hdr.uleb(if stdd && f.starts_with("std/") { 1 } else { 0 })
  }
  var prog = Dw{}
  for fr in recs {
    prog.u8(4) // DW_LNS_set_file
    prog.uleb(fr.file)
    var file = fr.file
    var line = 1
    // the sequence starts at the function (its prologue takes the first
    // statement's line), then a row per label (an inlined callee's rows
    // in its own file); the first statement's row ends the prologue
    // (DW_LNS_set_prologue_end), where lldb and gdb stop for a breakpoint
    // on the function, as on clang's tables (without it they skipped to
    // the second line, past the first statement)
    var rows = fr.rows
    if !rows.is_empty() {
      rows.insert(0, DbgRow{label: fr.begin, line: rows[0].line, file: rows[0].file, site: rows[0].site})
    }
    for (ri, row) in rows.indexed() {
      let ln = row.line / 4096
      let col = row.line % 4096
      prog.u8(0)
      prog.uleb(9)
      prog.u8(2) // DW_LNE_set_address
      prog.quad(row.label)
      if row.file != file {
        prog.u8(4) // DW_LNS_set_file
        prog.uleb(row.file)
        file = row.file
      }
      if ln != line {
        prog.u8(3) // DW_LNS_advance_line
        prog.sleb(ln - line)
        line = ln
      }
      prog.u8(5) // DW_LNS_set_column
      prog.uleb(col)
      if ri == 1 {
        prog.u8(10) // DW_LNS_set_prologue_end
      }
      prog.u8(1) // DW_LNS_copy
    }
    prog.u8(0)
    prog.uleb(9)
    prog.u8(2)
    prog.quad(fr.end)
    prog.u8(0)
    prog.uleb(1)
    prog.u8(1) // DW_LNE_end_sequence
  }
  // unit_length covers version (2), sizes (2), header_length (4), the
  // header, and the program
  let line_len = 2 + 2 + 4 + hdr.n + prog.n
  out.write(if mac { "\t.section __DWARF,__debug_line,regular,debug\n" } else { "\t.section .debug_line,\"\",@progbits\n" })
  let line_lab = g.local("xo_dwline_${g.ns}")
  out.write("${line_lab}:\n")
  out.write("\t.long ${line_len}\n\t.short 5\n\t.byte 8\n\t.byte 0\n\t.long ${hdr.n}\n")
  out.write(hdr.text())
  out.write(prog.text())
  // .debug_abbrev
  out.write(if mac { "\t.section __DWARF,__debug_abbrev,regular,debug\n" } else { "\t.section .debug_abbrev,\"\",@progbits\n" })
  let abbrev_lab = g.local("xo_dwabbrev_${g.ns}")
  out.write("${abbrev_lab}:\n")
  // 1: compile_unit, children: stmt_list, low_pc, high_pc (the part's
  // functions are one run of its text; at fixed places, bytes 13, 17,
  // and 25, for compiler/macho dsym.xo), producer, language, name,
  // comp_dir; 2: subprogram, children: name, low_pc, high_pc; 3: an
  // inlined callee's abstract subprogram: name, inline (1, inlined); 4:
  // inlined_subroutine, children (the calls inlined into it):
  // abstract_origin (unit relative), low_pc, high_pc, call_file,
  // call_line, call_column
  // (1 also: loclists_base and addr_base, at bytes 38 and 42, after the
  // language, for dsym.xo; dsymutil turns the location lists into
  // indexes of an address table and needs the unit's addr_base to give
  // it; decision 0252; for
  // dsym.xo; decision 0252) 5: base_type: name, encoding, byte_size; 6:
  // structure_type, children: name, byte_size; 7: member: name, type,
  // data_member_location; 8: variable and 9: formal_parameter: name,
  // type, decl_line, location (loclistx); 10: the global variable
  // xo_static (decision 0253: the debugger finds the runtime's records
  // through it): name, type, external, location (exprloc, DW_OP_addr);
  // 11: array_type, children: type; 12: subrange_type: count
  out.write("\t.byte 1, 0x11, 1, 0x10, 0x17, 0x11, 0x01, 0x12, 0x01, 0x25, 0x08, 0x13, 0x05, 0x8c, 0x01, 0x17, 0x73, 0x17, 0x03, 0x08, 0x1b, 0x08, 0, 0\n")
  out.write("\t.byte 2, 0x2e, 1, 0x03, 0x08, 0x11, 0x01, 0x12, 0x01, 0, 0\n")
  out.write("\t.byte 3, 0x2e, 0, 0x03, 0x08, 0x20, 0x0b, 0, 0\n")
  out.write("\t.byte 4, 0x1d, 1, 0x31, 0x13, 0x11, 0x01, 0x12, 0x01, 0x58, 0x0f, 0x59, 0x0f, 0x57, 0x0f, 0, 0\n")
  out.write("\t.byte 5, 0x24, 0, 0x03, 0x08, 0x3e, 0x0b, 0x0b, 0x0b, 0, 0\n")
  out.write("\t.byte 6, 0x13, 1, 0x03, 0x08, 0x0b, 0x0f, 0, 0\n")
  out.write("\t.byte 7, 0x0d, 0, 0x03, 0x08, 0x49, 0x13, 0x38, 0x0f, 0, 0\n")
  out.write("\t.byte 8, 0x34, 0, 0x03, 0x08, 0x49, 0x13, 0x3b, 0x0f, 0x02, 0x22, 0, 0\n")
  out.write("\t.byte 9, 0x05, 0, 0x03, 0x08, 0x49, 0x13, 0x3b, 0x0f, 0x02, 0x22, 0, 0\n")
  out.write("\t.byte 10, 0x34, 0, 0x03, 0x08, 0x49, 0x13, 0x3f, 0x19, 0x02, 0x18, 0, 0\n")
  out.write("\t.byte 11, 0x01, 1, 0x49, 0x13, 0, 0\n")
  out.write("\t.byte 12, 0x21, 0, 0x37, 0x05, 0, 0\n")
  // decision 0252 stage 4: 13 pointer_type: type, byte_size; 16
  // enumeration_type, children: name, byte_size, type; 17 enumerator:
  // name, const_value; 18 union_type, children: name, byte_size; 19
  // typedef: name, type
  out.write("\t.byte 13, 0x0f, 0, 0x49, 0x13, 0x0b, 0x0b, 0, 0\n")
  out.write("\t.byte 16, 0x04, 1, 0x03, 0x08, 0x0b, 0x0b, 0x49, 0x13, 0, 0\n")
  out.write("\t.byte 17, 0x28, 0, 0x03, 0x08, 0x1c, 0x0f, 0, 0\n")
  out.write("\t.byte 18, 0x17, 1, 0x03, 0x08, 0x0b, 0x0f, 0, 0\n")
  out.write("\t.byte 19, 0x16, 0, 0x03, 0x08, 0x49, 0x13, 0, 0\n")
  out.write("\t.byte 0\n")
  // .debug_info
  var die = Dw{}
  die.uleb(1)
  die.offset(if mac { "0" } else { line_lab })
  let st = g.tramp("xo_static")
  die.quad(if recs.is_empty() { st } else { recs[0].begin })
  die.quad(if recs.is_empty() { st } else { recs[recs.len() - 1].end })
  die.str("xo")
  die.u16(0x0c) // DW_LANG_C99: no code for Xo
  // the offsets table of this unit's .debug_loclists, past its 12 byte
  // header (dsym.xo moves it by where the object's chunk lands)
  let ll_base = g.local("xo_dwllbase_${g.ns}")
  die.offset(if mac { "12" } else { ll_base })
  let addr_base = g.local("xo_dwaddrbase_${g.ns}")
  die.offset(if mac { "8" } else { addr_base })
  die.str(files[0])
  die.str(dir)
  // the types of the variables (unit relative offsets, by type name),
  // then the objects their pointers point at
  var tys = DwTys{}
  for fr in recs {
    for v in fr.vars {
      let _t = g.dw_type(die, tys, v.ty)
    }
  }
  g.dw_flush(die, tys)
  if with_static {
    // xo_static: STATIC_WORDS words (gen.xo end_data) of Int
    let it = g.dw_base(die, tys, "Int", 5, 8)
    let arr = 12 + die.n
    die.uleb(11)
    die.u32(it)
    die.uleb(12)
    die.u16(STATIC_WORDS)
    die.u8(0)
    die.uleb(10)
    die.str("xo_static")
    die.u32(arr)
    die.uleb(9) // the expression's length: DW_OP_addr and 8 bytes
    die.u8(0x03)
    die.quad(st)
  }
  // each variable's location list, with its function's first label (the
  // list's base address)
  var lists: List[(Str, List[DbgLoc])] = []
  // the runs of inlined code (outermost sites) of each function, and an
  // abstract subprogram per callee they name (unit relative offset: the
  // 12 byte unit header, then the entries)
  var origin: Map[Str, Int] = {}
  for fr in recs {
    for row in fr.rows {
      for s in site_chain(fr, row.site) {
        let callee = fr.sites[s].callee
        if !origin.contains(callee) {
          origin[callee] = 12 + die.n
          die.uleb(3)
          die.str(callee)
          die.u8(1)
        }
      }
    }
  }
  for fr in recs {
    die.uleb(2)
    die.str(fr.name)
    die.quad(fr.begin)
    die.quad(fr.end)
    var chains: List[List[Int]] = []
    for row in fr.rows {
      chains.push(site_chain(fr, row.site))
    }
    // the inlined calls, each with its callee's variables (in the first
    // inlined_subroutine of its site)
    var done: Map[Int, Bool] = {}
    inline_level(die, fr, chains, origin, 0, fr.rows.len(), 0, tys, lists, done)
    // its own variables (decision 0252), each with a location list
    for v in fr.vars {
      if v.inl >= 0 {
        continue
      }
      dw_var(die, tys, lists, fr, v)
    }
    die.u8(0)
  }
  die.u8(0)
  // unit_length covers version (2), unit_type (1), address_size (1),
  // debug_abbrev_offset (4), and the entries
  out.write(if mac { "\t.section __DWARF,__debug_info,regular,debug\n" } else { "\t.section .debug_info,\"\",@progbits\n" })
  out.write("\t.long ${2 + 1 + 1 + 4 + die.n}\n\t.short 5\n\t.byte 1\n\t.byte 8\n")
  out.write("\t.long ${if mac { "0" } else { abbrev_lab }}\n")
  out.write(die.text())
  // .debug_loclists: the header, an offset per list (from the end of the
  // header, DW_AT_loclists_base), then each list: its function's start
  // as the base address (DW_LLE_base_address) and its entries as offsets
  // from it (DW_LLE_offset_pair: two ULEB128 label differences, where
  // two addresses of DW_LLE_start_end made the lists twice as large;
  // decision 0252 stage 4). The sizes are label differences: the
  // assembler knows the ULEB128s' lengths
  let ll_start = g.local("xo_dwllstart_${g.ns}")
  let ll_end = g.local("xo_dwllend_${g.ns}")
  var body = Dw{}
  var offs: List[Str] = []
  // the addresses of DW_OP_addrx operands: .debug_addr's entries
  var addr_ix: Map[Str, Int] = {}
  var addr_syms: List[Str] = []
  for (k, (fb, l)) in lists.indexed() {
    let lab = g.local("xo_dwll_${g.ns}_${k}")
    offs.push(lab)
    body.lines.push("${lab}:\n")
    if !l.is_empty() {
      body.u8(6) // DW_LLE_base_address
      body.quad(fb)
    }
    for e in l {
      body.u8(4) // DW_LLE_offset_pair
      body.lines.push("\t.uleb128 ${e.start}-${fb}\n\t.uleb128 ${e.end}-${fb}\n")
      let ops = e.ops.split(",")
      // a symbol (DW_OP_addrx's operand, dwvars.xo) is the ULEB128 index
      // of its entry in this part's .debug_addr
      var bs: List[Str] = []
      for o in ops {
        let c = o.bytes()[0]
        if c >= 48 && c <= 57 {
          bs.push(o)
          continue
        }
        var k = addr_ix.get(o) ?? -1
        if k < 0 {
          k = addr_syms.len()
          addr_ix[o] = k
          addr_syms.push(o)
        }
        for x in uleb_bytes(k) {
          bs.push("${x}")
        }
      }
      body.uleb(bs.len())
      // the expression's bytes on one line
      body.bytes(bs)
    }
    body.u8(0) // DW_LLE_end_of_list
  }
  out.write(if mac { "\t.section __DWARF,__debug_loclists,regular,debug\n" } else { "\t.section .debug_loclists,\"\",@progbits\n" })
  out.write("\t.long ${ll_end}-${ll_start}\n${ll_start}:\n\t.short 5\n\t.byte 8\n\t.byte 0\n\t.long ${lists.len()}\n")
  out.write("${ll_base}:\n")
  for o in offs {
    out.write("\t.long ${o}-${ll_base}\n")
  }
  out.write(body.text())
  out.write("${ll_end}:\n")
  // .debug_addr: the address table (addr_base above) of the constant
  // words' DW_OP_addrx (dwvars.xo)
  out.write(if mac { "\t.section __DWARF,__debug_addr,regular,debug\n" } else { "\t.section .debug_addr,\"\",@progbits\n" })
  out.write("\t.long ${4 + 8 * addr_syms.len()}\n\t.short 5\n\t.byte 8\n\t.byte 0\n${addr_base}:\n")
  for a in addr_syms {
    out.write("\t.quad ${a}\n")
  }
  out.write(g.section("text"))
  out.freeze()
}

/// A function's debug record, parsed.
struct DbgFunc {
  file: Int
  name: Str
  begin: Str
  end: Str
  rows: List[DbgRow]
  sites: List[DbgSite]
  vars: List[DbgVar] = []
}

/// A variable of a function (dwvars.xo): its name, its type's name,
/// whether a parameter, its packed declaration line, and its locations.
struct DbgVar {
  name: Str
  ty: Str
  param: Bool
  line: Int
  locs: List[DbgLoc]
  /// the inline site it came in with (-1: the function's own)
  inl: Int = -1
}

/// A location entry: from label start to label end, the bytes of a
/// DWARF expression (comma separated).
struct DbgLoc {
  start: Str
  end: Str
  ops: Str
}

/// The unit's DWARF types: each entry's unit relative offset by name,
/// and the references written before their targets (the line of the
/// `.long` in the unit's Dw and the target's name), which dw_flush
/// writes and patches.
struct DwTys {
  at: Map[Str, Int] = {}
  refs: List[(Int, Str)] = []
}

/// A base type: its offset, written the first time.
fn (g: G) dw_base(var die: Dw, var tys: DwTys, n: Str, enc: Int, size: Int) -> Int {
  if let Some(o) = tys.at.get(n) {
    return o
  }
  let o = 12 + die.n
  die.uleb(5)
  die.str(n)
  die.u8(enc)
  die.u8(size)
  tys.at[n] = o
  o
}

/// A reference to the type named target, patched by dw_flush when it is
/// written after this (a pointer's target may contain the pointer).
fn (g: G) dw_ref(var die: Dw, var tys: DwTys, target: Str) {
  if let Some(o) = tys.at.get(target) {
    die.u32(o)
    return
  }
  tys.refs.push((die.lines.len(), target))
  die.u32(0)
}

/// A pointer to the type named target (8 bytes).
fn (g: G) dw_ptr(var die: Dw, var tys: DwTys, target: Str) -> Int {
  let o = 12 + die.n
  die.uleb(13)
  g.dw_ref(die, tys, target)
  die.u8(8)
  o
}

/// A structure named n of size words, its members (name, type offset,
/// byte offset) written after their types.
fn (g: G) dw_struct(var die: Dw, var tys: DwTys, n: Str, words: Int, members: List[(Str, Int, Int)]) -> Int {
  let o = 12 + die.n
  die.uleb(6)
  die.str(n)
  die.uleb(8 * words)
  for (mn, mt, mo) in members {
    die.uleb(7)
    die.str(mn)
    die.u32(mt)
    die.uleb(mo)
  }
  die.u8(0)
  tys.at[n] = o
  o
}

/// An array of the type at offset elem with count elements (0: an
/// object's trailing items, as many as its length says).
fn (g: G) dw_array(var die: Dw, elem: Int, count: Int) -> Int {
  let o = 12 + die.n
  die.uleb(11)
  die.u32(elem)
  die.uleb(12)
  die.u16(count)
  die.u8(0)
  o
}

/// The unit relative offset of the DWARF type named n (an SSA type of
/// the module, dwvars.xo dv_type_ok), written into die at the unit's top
/// level the first time it is asked for, the types it holds first (a
/// pointer's target later, dw_flush). Decision 0252 point 2: base types;
/// structs and tuples as structures of their words; Str as its object
/// pointer and length; List[T] and Box[T] as typedefs of a pointer to
/// their objects (count, length, capacity, items; count, value); Map and
/// Set as their struct of lists; an enum as its tag (an enumeration of
/// the variants' names) and a union of the variants' fields; a function
/// value as its code and environment words; a handle as a word.
fn (g: G) dw_type(var die: Dw, var tys: DwTys, n: Str) -> Int {
  if let Some(o) = tys.at.get(n) {
    return o
  }
  let t = g.m.type_at.get(n) ?? -1
  if t < 0 {
    return 0
  }
  let x = g.m.types[t]
  match x.kind {
    Float => g.dw_base(die, tys, n, 4, if x.bits == 32 { 4 } else { 8 })
    Bool => g.dw_base(die, tys, n, 2, 8)
    Int => g.dw_base(die, tys, n, if x.unsigned { 7 } else { 5 }, 8)
    Handle => g.dw_base(die, tys, n, 7, 8)
    Str => {
      let it = g.dw_base(die, tys, "Int", 5, 8)
      let p = g.dw_ptr(die, tys, "Str.obj")
      g.dw_struct(die, tys, n, 2, [("obj", p, 0), ("len", it, 8)])
    }
    Func => {
      let it = g.dw_base(die, tys, "Int", 5, 8)
      g.dw_struct(die, tys, n, 2, [("code", it, 0), ("env", it, 8)])
    }
    List | Box => {
      // a typedef of the pointer, so the variable's type reads List[T]
      let p = g.dw_ptr(die, tys, "${n}.obj")
      let o = 12 + die.n
      die.uleb(19)
      die.str(n)
      die.u32(p)
      tys.at[n] = o
      o
    }
    Enum => g.dw_enum(die, tys, t)
    Struct | Tuple => {
      var names: List[Str] = []
      var types: List[Int] = []
      if x.fields.is_empty() {
        for (i, e) in x.elems.indexed() {
          names.push("${i}")
          types.push(e)
        }
      } else {
        for f in x.fields {
          names.push(f.name)
          types.push(f.ty)
        }
      }
      var ms: List[(Str, Int, Int)] = []
      var at = 0
      for (i, fname) in names.indexed() {
        ms.push((fname, g.dw_type(die, tys, g.m.types[types[i]].name), 8 * at))
        at += g.dw_words(types[i])
      }
      g.dw_struct(die, tys, n, g.dw_words(t), ms)
    }
    Unit | Cap | Bad => 0
  }
}

/// An enum: its tag's enumeration (`E.tag`), a structure per variant
/// with fields (`E.V`), their union (`E.payload`), and the enum's
/// structure of the tag and the union after it.
fn (g: G) dw_enum(var die: Dw, var tys: DwTys, t: Int) -> Int {
  let x = g.m.types[t]
  let n = x.name
  let it = g.dw_base(die, tys, "Int", 5, 8)
  let tag = 12 + die.n
  die.uleb(16)
  die.str("${n}.tag")
  die.u8(8)
  die.u32(it)
  for (k, v) in x.variants.indexed() {
    die.uleb(17)
    die.str(v.name)
    die.uleb(k)
  }
  die.u8(0)
  tys.at["${n}.tag"] = tag
  // the variants with fields, each a structure of its words
  var vs: List[(Str, Int)] = []
  var most = 0
  for v in x.variants {
    if v.fields.is_empty() {
      continue
    }
    var ms: List[(Str, Int, Int)] = []
    var at = 0
    for f in v.fields {
      ms.push((f.name, g.dw_type(die, tys, g.m.types[f.ty].name), 8 * at))
      at += g.dw_words(f.ty)
    }
    if at > most {
      most = at
    }
    vs.push((v.name, g.dw_struct(die, tys, "${n}.${v.name}", at, ms)))
  }
  var members: List[(Str, Int, Int)] = [("tag", tag, 0)]
  if !vs.is_empty() {
    let u = 12 + die.n
    die.uleb(18)
    die.str("${n}.payload")
    die.uleb(8 * most)
    for (vn, vo) in vs {
      die.uleb(7)
      die.str(vn)
      die.u32(vo)
      die.uleb(0)
    }
    die.u8(0)
    members.push(("payload", u, 8))
  }
  g.dw_struct(die, tys, n, 1 + most, members)
}

/// Writes the objects the pointers point at (Str.obj, List[T].obj,
/// Box[T].obj: the types they hold first), until none is missing, then
/// patches every reference to its target's offset.
fn (g: G) dw_flush(var die: Dw, var tys: DwTys) {
  var i = 0
  while i < tys.refs.len() {
    let (_, target) = tys.refs[i]
    if !tys.at.contains(target) {
      let _o = g.dw_object(die, tys, target)
    }
    i += 1
  }
  for (line, target) in tys.refs {
    die.lines[line] = "\t.long ${tys.at.get(target) ?? 0}\n"
  }
  tys.refs = []
}

/// The object type named key (`Str.obj`, `List[T].obj`, `Box[T].obj`;
/// the layouts of rt.layout's table and rc.xo BOX_HDR).
fn (g: G) dw_object(var die: Dw, var tys: DwTys, key: Str) -> Int {
  let it = g.dw_base(die, tys, "Int", 5, 8)
  if key == "Str.obj" {
    // count, capacity, the bytes at 16
    let bytes = g.dw_array(die, g.dw_base(die, tys, "UInt8", 8, 1), 0)
    return g.dw_struct(die, tys, key, 2, [("count", it, 0), ("cap", it, 8), ("bytes", bytes, 16)])
  }
  let n = key.trim_suffix(".obj")
  let t = g.m.type_at.get(n) ?? -1
  if t < 0 {
    return g.dw_struct(die, tys, key, 1, [("count", it, 0)])
  }
  let x = g.m.types[t]
  let elem = if x.elems.is_empty() { -1 } else { x.elems[0] }
  let et = if elem >= 0 { g.dw_type(die, tys, g.m.types[elem].name) } else { it }
  let boxed = match x.kind {
    Box => true
    Unit | Int | Float | Bool | Str | Struct | Enum | Tuple | List | Cap | Func | Handle | Bad => false
  }
  if boxed {
    // the count, the value's words at BOX_HDR
    return g.dw_struct(die, tys, key, 1 + (if elem >= 0 { g.dw_words(elem) } else { 1 }), [("count", it, 0), ("value", et, BOX_HDR)])
  }
  // a list: count, length, capacity, the items at 24
  let items = g.dw_array(die, et, 0)
  g.dw_struct(die, tys, key, 3, [("count", it, 0), ("len", it, 8), ("cap", it, 16), ("items", items, 24)])
}

/// The words of type t (gen.xo layout's count): two for Str and a
/// function value, the tag and the largest variant's for an enum, the
/// fields' for a struct or tuple, one otherwise.
fn (g: G) dw_words(t: Int) -> Int {
  let x = g.m.types[t]
  match x.kind {
    Str | Func => 2
    Unit | Cap | Bad => 0
    Enum => {
      var most = 0
      for v in x.variants {
        var n = 0
        for f in v.fields {
          n += g.dw_words(f.ty)
        }
        if n > most {
          most = n
        }
      }
      1 + most
    }
    Struct | Tuple => {
      var n = 0
      for f in x.fields {
        n += g.dw_words(f.ty)
      }
      for e in x.elems {
        n += g.dw_words(e)
      }
      n
    }
    Int | Float | Bool | List | Box | Handle => 1
  }
}

/// A row: its label, packed line, file (the unit's index), and inline
/// site (-1: the function's own code).
struct DbgRow {
  label: Str
  line: Int
  file: Int
  site: Int
}

/// An inline site: the callee, its file, the call's packed line, and the
/// enclosing site (-1: the function).
struct DbgSite {
  callee: Str
  file: Int
  call_line: Int
  parent: Int
}

/// The index of file in files, added once.
fn file_index(file: Str, var files: List[Str], var at: Map[Str, Int]) -> Int {
  if let Some(k) = at.get(file) {
    return k
  }
  files.push(file)
  at[file] = files.len() - 1
  files.len() - 1
}

/// The inlined_subroutine entries of rows [i0, i1) of fr at nesting
/// level `level` (0: called from the function itself): consecutive rows
/// whose chain has the same site at that level make one, to the next
/// row (or the function's end), with the deeper levels inside it.
fn inline_level(var die: Dw, fr: DbgFunc, chains: List[List[Int]], origin: Map[Str, Int], i0: Int, i1: Int, level: Int, tys: DwTys, var lists: List[(Str, List[DbgLoc])], var done: Map[Int, Bool]) {
  var i = i0
  while i < i1 {
    let s = if level < chains[i].len() { chains[i][level] } else { -1 }
    if s < 0 {
      i += 1
      continue
    }
    var j = i + 1
    while j < i1 && level < chains[j].len() && chains[j][level] == s {
      j += 1
    }
    let site = fr.sites[s]
    die.uleb(4)
    die.u32(origin.get(site.callee) ?? 0)
    die.quad(fr.rows[i].label)
    die.quad(if j < fr.rows.len() { fr.rows[j].label } else { fr.end })
    // the call is in the enclosing site's file (the function's at level 0)
    let cfile = if site.parent >= 0 && site.parent < fr.sites.len() { fr.sites[site.parent].file } else { fr.file }
    die.uleb(cfile)
    die.uleb(site.call_line / 4096)
    die.uleb(site.call_line % 4096)
    inline_level(die, fr, chains, origin, i, j, level + 1, tys, lists, done)
    if !done.contains(s) {
      // the inlined callee's variables (decision 0252 with 0268: a fault
      // report shows them in the frame that inlined it)
      done[s] = true
      for v in fr.vars {
        if v.inl == s {
          dw_var(die, tys, lists, fr, v)
        }
      }
    }
    die.u8(0)
    i = j
  }
}

/// A variable's entry (8, or 9 for a parameter) with a location list,
/// its function's first label the list's base address.
fn dw_var(var die: Dw, tys: DwTys, var lists: List[(Str, List[DbgLoc])], fr: DbgFunc, v: DbgVar) {
  die.uleb(if v.param { 9 } else { 8 })
  die.str(v.name)
  die.u32(tys.at.get(v.ty) ?? 0)
  die.uleb(v.line / 4096)
  die.uleb(lists.len())
  lists.push((fr.begin, v.locs))
}

/// The sites holding site s, outermost first (empty for none).
fn site_chain(fr: DbgFunc, s: Int) -> List[Int] {
  var out: List[Int] = []
  var k = s
  var guard = 0
  while k >= 0 && k < fr.sites.len() && guard < 64 {
    out.insert(0, k)
    k = fr.sites[k].parent
    guard += 1
  }
  out
}

/// Debug section bytes as assembler directives, with their count.
struct Dw {
  lines: List[Str] = []
  n: Int = 0
}

fn (var d: Dw) u8(v: Int) {
  d.lines.push("\t.byte ${v & 255}\n")
  d.n += 1
}

fn (var d: Dw) u16(v: Int) {
  d.lines.push("\t.short ${v & 65535}\n")
  d.n += 2
}

fn (var d: Dw) u32(v: Int) {
  d.lines.push("\t.long ${v}\n")
  d.n += 4
}

fn (var d: Dw) offset(sym: Str) {
  d.lines.push("\t.long ${sym}\n")
  d.n += 4
}

fn (var d: Dw) quad(sym: Str) {
  d.lines.push("\t.quad ${sym}\n")
  d.n += 8
}

fn (var d: Dw) uleb(v0: Int) {
  var v = v0
  var bs: List[Str] = []
  while true {
    var b = v & 127
    v = v >> 7
    if v != 0 {
      b = b | 128
    }
    bs.push("${b}")
    if v == 0 {
      break
    }
  }
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

fn (var d: Dw) sleb(v0: Int) {
  var v = v0
  var bs: List[Str] = []
  while true {
    let b = v & 127
    v = v >> 7
    let done = (v == 0 && b & 64 == 0) || (v == -1 && b & 64 != 0)
    bs.push("${if done { b } else { b | 128 }}")
    if done {
      break
    }
  }
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

/// Bytes given as decimal text, on one line.
fn (var d: Dw) bytes(bs: List[Str]) {
  if bs.is_empty() {
    return
  }
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

/// A NUL terminated string (DW_FORM_string), as bytes (no escaping).
fn (var d: Dw) str(s: Str) {
  var bs: List[Str] = []
  for c in s.bytes() {
    bs.push("${Int(c)}")
  }
  bs.push("0")
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

fn (d: Dw) text() -> Str {
  d.lines.join("")
}
