// DWARF variables and their locations (decision 0252, stage 2): after
// register allocation, each binding record (ssa Func.dbinds) of a source
// variable becomes, per word of its value, the instruction ranges where
// that word's virtual register is live and the place it lives there (a
// register, or a spill slot below sp). Emission puts a label at each
// range's ends (dv_label) and the function's debug record carries the
// variables (dv_field): their name, type, whether a parameter, their
// declaration line, and location entries (start label, end label, the
// bytes of a DWARF expression), which debug.xo turns into
// DW_TAG_variable entries and .debug_loclists. Nothing here changes the
// code: the labels are only labels (decision 0252's gate).

/// Where one word of a binding's value lives over the instructions
/// [lo, hi): the bytes of a DWARF location for it.
struct DvSpan {
  lo: Int
  hi: Int
  op: List[Int]
}

/// A binding record with its words' spans; def is where its value
/// starts (the least lo), for choosing between bindings of one variable.
struct DvBind {
  dvar: Int
  def: Int
  words: List[List[DvSpan]]
}

/// The function's variables to describe and the instruction indexes
/// where a location range starts or ends.
struct DvPlan {
  binds: List[DvBind] = []
  need: List[Int] = []
  /// the symbols of DW_OP_addrx operands: an op byte -1 - k stands for
  /// syms[k] (dv_field writes the name, debug.xo its index in the
  /// address table)
  syms: List[Str] = []
}

/// A fault stub's range for the variables (2026-10-20): the faulting
/// instruction's index, the stub's label and the label after its call
/// (the faulting frame's pc in a traceback returns there), and how far sp
/// moved in it (16 for a leaf's frame record; -1 when a prologue moved it,
/// and its slots are then left out).
struct DvStub {
  at: Int
  lo: Str
  hi: Str
  adj: Int
  /// the caller saved registers the stub stored, by their offset from sp
  /// at its call (emit.xo stub_saves)
  saved: List[(Int, Int)] = []
}

/// The caller saved registers (x0 to x15) holding a word of a source
/// variable's binding at instruction index k, at most 8, by number:
/// what a fault stub stores so the fault report shows them.
fn (var g: G) stub_saves(k: Int) -> List[Int] {
  if g.vranges.is_empty() {
    return []
  }
  if !g.dv_copies_made {
    g.dv_copies_made = true
    g.dv_copies_at = g.dv_copies()
  }
  var out: List[Int] = []
  for d in g.f.dbinds {
    if !g.has_val[d.value] {
      continue
    }
    for r in g.vals[d.value] {
      var regs = [r]
      var at = 0
      while at < regs.len() && regs.len() < 8 {
        for c in g.dv_copies_at.get(regs[at]) ?? [] {
          if !regs.contains(c) {
            regs.push(c)
          }
        }
        at += 1
      }
      for rr in regs {
        if rr <= 0 || rr >= g.loc.len() || rr >= g.vranges.len() {
          continue
        }
        let reg = g.loc[rr].reg
        // caller saved: x0 to x15; rax, rcx, rdx, rsi, rdi, r8 to r10 (r11
        // is the x86 emitter's scratch)
        let caller = if g.x86 { reg is 0 | 1 | 2 | 6 | 7 | 8 | 9 | 10 } else { reg >= 0 && reg <= 15 }
        if !caller || out.contains(reg) {
          continue
        }
        for rg in g.vranges[rr] {
          if (rg.s + 3) / 4 <= k && k < rg.e / 4 + 1 {
            out.push(reg)
            break
          }
        }
      }
    }
  }
  let sorted = out.sort()
  if sorted.len() > 8 { sorted[0..8] } else { sorted }
}

/// Per register, the registers whose one definition is a parallel move
/// from it (dv_plan's copies).
fn (g: G) dv_copies() -> Map[Int, List[Int]] {
  var ndefs: Map[Int, Int] = {}
  var copy_of: Map[Int, Int] = {}
  for blk in g.blocks {
    for ins in blk.insts {
      for (i, d) in ins.defs.indexed() {
        ndefs[d] = (ndefs.get(d) ?? 0) + 1
        if ins.kind == K_PMOVE && i < ins.srcs.len() && ins.srcs[i].kind == S_REG && ins.srcs[i].v > 0 {
          copy_of[d] = ins.srcs[i].v
        }
      }
    }
  }
  var copies: Map[Int, List[Int]] = {}
  for (d, r) in copy_of.entries() {
    if (ndefs.get(d) ?? 0) == 1 {
      var l = copies.get(r) ?? []
      l.push(d)
      copies[r] = l
    }
  }
  copies
}

/// The DWARF register numbers of x86_64's general registers by their
/// encoding (rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi, r8 to r15): the
/// System V ABI's order (rax 0, rdx 1, rcx 2, rbx 3, rsi 4, rdi 5, rbp 6,
/// rsp 7).
const X86_DW_GP: List[Int] = [0, 2, 1, 3, 7, 6, 4, 5, 8, 9, 10, 11, 12, 13, 14, 15]

/// dv_op on x86_64: a general register's DW_OP_reg, an xmm register's
/// DW_OP_regx (17 and up), a spill slot's DW_OP_breg7 (rsp).
fn (g: G) x86_dv_op(l: Loc) -> List[Int] {
  if l.reg >= 0 {
    if l.reg < FP_BASE {
      if l.reg < X86_DW_GP.len() {
        return [0x50 + X86_DW_GP[l.reg]]
      }
      return []
    }
    return [0x90] + uleb_bytes(17 + l.reg - FP_BASE)
  }
  if l.slot >= 0 && g.base == 0 && !g.fr.leaf {
    // this function's own stack words past the return address and rbp
    let off = if l.slot >= SLOT_IN && l.slot < SLOT_OUT { g.x86_in_arg(l.slot - SLOT_IN) } else { slot_off(g.fr, l.slot) }
    return [0x77] + sleb_bytes(off) // DW_OP_breg7: rsp
  }
  []
}

/// op over a fault stub, or none: a traceback has the faulting frame's
/// callee saved registers (x19 to x29; rbx, rbp, r12 to r15) and sp at
/// the call (decision 0268 point 4), not the registers the stub's moves
/// and the fault function overwrite.
fn dv_stub_op(op: List[Int], adj: Int, x86: Bool, stored: List[(Int, Int)]) -> List[Int] {
  if op.len() == 1 && op[0] >= 0x50 && op[0] < 0x70 {
    let n = op[0] - 0x50
    let saved = if x86 { n is 3 | 6 | 12 | 13 | 14 | 15 } else { n >= 19 && n <= 29 }
    if saved {
      return op
    }
    // a caller saved register the stub stored: its slot (by encoding;
    // x86_64's DWARF numbers differ)
    for (r, off) in stored {
      if !x86 && r == n {
        return [0x8f] + sleb_bytes(off)
      }
      if x86 && r < X86_DW_GP.len() && X86_DW_GP[r] == n {
        return [0x77] + sleb_bytes(off)
      }
    }
    return []
  }
  // DW_OP_breg31 (sp) or DW_OP_breg7 (rsp), plus how far the stub moved it
  let sp_op = if x86 { 0x77 } else { 0x8f }
  if op.len() >= 2 && op[0] == sp_op && adj >= 0 {
    let off = sleb_value(op[1..op.len()])
    return [sp_op] + sleb_bytes(off + adj)
  }
  []
}

/// The value of SLEB128 bytes bs.
fn sleb_value(bs: List[Int]) -> Int {
  var v = 0
  var shift = 0
  for b in bs {
    v = v | (b & 127).wrapping_shl(shift)
    shift += 7
    if b & 128 == 0 {
      if shift < 64 && b & 64 != 0 {
        v = v | (-1).wrapping_shl(shift)
      }
      break
    }
  }
  v
}

/// The location expression of a variable over stub s, from the binding
/// defined last among mine with a word at s's instruction; empty when no
/// word has a place there.
fn dv_stub_expr(mine: List[DvBind], s: DvStub, nw: Int, x86: Bool) -> List[Int] {
  var best = -1
  for (bi, b) in mine.indexed() {
    var here = false
    for w in b.words {
      for sp in w {
        if sp.lo <= s.at && sp.hi > s.at {
          here = true
        }
      }
    }
    if here && (best < 0 || b.def > mine[best].def) {
      best = bi
    }
  }
  if best < 0 {
    return []
  }
  var ops: List[List[Int]] = []
  var any = false
  for w in mine[best].words {
    var op: List[Int] = []
    for sp in w {
      if sp.lo <= s.at && sp.hi > s.at {
        op = dv_stub_op(sp.op, s.adj, x86, s.saved)
      }
    }
    any = any || !op.is_empty()
    ops.push(op)
  }
  if !any {
    return []
  }
  if nw == 1 {
    return ops[0]
  }
  while !ops.is_empty() && ops[ops.len() - 1].is_empty() {
    let _o = ops.pop()
  }
  var expr: List[Int] = []
  for op in ops {
    expr = expr + op + [0x93] + uleb_bytes(8) // DW_OP_piece 8
  }
  expr
}

/// The most words of a value whose locations are described: a larger
/// one (the emitter's own G, a record of hundreds of words) keeps its
/// variable and type with no location, as unavailable. Without the bound
/// xo's own assembly passed 2 GB, which one write(2) on macOS refuses
/// (decision 0252 stage 4).
const DV_MAX_WORDS = 32

/// Whether type t has a DWARF description (debug.xo dw_type, decision
/// 0252 point 2 and stage 4): Int (any size), Float, Bool, Str, List,
/// Box, a function value, a handle, and structs (Map and Set too),
/// tuples, and enums of them. A List's or Box's element is behind a
/// pointer, described when the object is (a recursive type stops there).
fn (var g: G) dv_type_ok(t: Int) -> Bool {
  if t < 0 {
    return false
  }
  let x = g.m.types[t]
  match x.kind {
    Int | Float | Bool | Str | List | Box | Func | Handle => true
    Enum => {
      for v in x.variants {
        for f in v.fields {
          if !g.dv_type_ok(f.ty) {
            return false
          }
        }
      }
      !x.variants.is_empty()
    }
    Struct => {
      for f in x.fields {
        if !g.dv_type_ok(f.ty) {
          return false
        }
      }
      !x.fields.is_empty()
    }
    Tuple => {
      for e in x.elems {
        if !g.dv_type_ok(e) {
          return false
        }
      }
      !x.elems.is_empty()
    }
    _ => false
  }
}

/// The DWARF location of virtual register r, or an empty list when it
/// has none (a far frame's slot, or no home).
fn (g: G) dv_op(r: Int) -> List[Int] {
  if r <= 0 || r >= g.loc.len() {
    return []
  }
  let l = g.loc[r]
  if g.x86 {
    return g.x86_dv_op(l)
  }
  if l.reg >= 0 {
    if l.reg < 32 {
      return [0x50 + l.reg] // DW_OP_reg0 + n: x0 to x30
    }
    return [0x90] + uleb_bytes(64 + l.reg - FP_BASE) // DW_OP_regx: v0 to v31
  }
  if l.slot >= 0 && g.base == 0 && !g.fr.leaf {
    return [0x8f] + sleb_bytes(slot_off(g.fr, l.slot)) // DW_OP_breg31: sp
  }
  []
}

/// The plan of the current function's variables (after regalloc, before
/// emission).
fn (var g: G) dv_plan() -> DvPlan {
  var p = DvPlan{}
  if !g.m.debug_info || g.f.dvars.is_empty() || g.vranges.is_empty() {
    return p
  }
  var need: Map[Int, Bool] = {}
  // the constant registers no other instruction defines: a word in one
  // is that constant wherever its binding is described, even when its
  // definition was deleted as unused (a literal field that no reference
  // count operation keeps in a register still shows)
  var knot: Map[Int, Bool] = {}
  if !g.kints.is_empty() || !g.ksyms.is_empty() {
    for b in g.blocks {
      for ins in b.insts {
        if ins.konst {
          continue
        }
        for d in ins.defs {
          if g.kints.contains(d) || g.ksyms.contains(d) {
            knot[d] = true
          }
        }
      }
    }
  }
  // the copies of each register: a register whose one definition is a
  // parallel move from r holds r's value wherever it lives (2026-10-20:
  // a parameter copied into a callee saved register for a loop with calls
  // was described only until the copy, so a fault in the loop showed it
  // <unavailable>)
  var ndefs: Map[Int, Int] = {}
  var copy_of: Map[Int, Int] = {}
  for blk in g.blocks {
    for ins in blk.insts {
      for (i, d) in ins.defs.indexed() {
        ndefs[d] = (ndefs.get(d) ?? 0) + 1
        if ins.kind == K_PMOVE && i < ins.srcs.len() && ins.srcs[i].kind == S_REG && ins.srcs[i].v > 0 {
          copy_of[d] = ins.srcs[i].v
        }
      }
    }
  }
  var copies: Map[Int, List[Int]] = {}
  for (d, r) in copy_of.entries() {
    if (ndefs.get(d) ?? 0) == 1 {
      var l = copies.get(r) ?? []
      l.push(d)
      copies[r] = l
    }
  }
  var symix: Map[Str, Int] = {}
  for d in g.f.dbinds {
    let dv = g.f.dvars[d.dvar]
    if !g.has_val[d.value] || !g.dv_type_ok(dv.ty) {
      continue
    }
    let ws = g.vals[d.value]
    if ws.len() != g.layout(dv.ty).len() || ws.len() > DV_MAX_WORDS {
      continue
    }
    var words: List[List[DvSpan]] = []
    var def = -1
    var end = -1
    var kops: List[(Int, List[Int])] = []
    for (wi, r) in ws.indexed() {
      var spans: List[DvSpan] = []
      if !knot.contains(r) && (g.kints.contains(r) || g.ksyms.contains(r)) {
        if let Some(n) = g.kints.get(r) {
          // DW_OP_constu or DW_OP_consts, DW_OP_stack_value
          kops.push((wi, (if n >= 0 { [0x10] + uleb_bytes(n) } else { [0x11] + sleb_bytes(n) }) + [0x9f]))
        } else if g.m.dw_data_addrs && g.ksyms.contains(r) {
          let s = g.ksyms.get(r) ?? ""
          if !symix.contains(s) {
            symix[s] = p.syms.len()
            p.syms.push(s)
          }
          // DW_OP_addrx sym (an entry of .debug_addr, which dsymutil
          // relocates; it leaves a DW_OP_addr in a location list as the
          // object file's address), DW_OP_stack_value
          kops.push((wi, [0xa1, -1 - (symix.get(s) ?? 0), 0x9f]))
        }
        words.push(spans)
        continue
      }
      // r and its copies (each copy's copies too, a few levels)
      var regs = [r]
      var at = 0
      while at < regs.len() && regs.len() < 8 {
        for c in copies.get(regs[at]) ?? [] {
          if !regs.contains(c) {
            regs.push(c)
          }
        }
        at += 1
      }
      for rr in regs {
        let op = g.dv_op(rr)
        if op.is_empty() || rr >= g.vranges.len() {
          continue
        }
        for rg in g.vranges[rr] {
          let lo = (rg.s + 3) / 4
          let hi = rg.e / 4 + 1
          if hi <= lo {
            continue
          }
          spans.push(DvSpan{lo: lo, hi: hi, op: op})
          need[lo] = true
          need[hi] = true
          if def < 0 || lo < def {
            def = lo
          }
          if hi > end {
            end = hi
          }
        }
      }
      words.push(spans)
    }
    // a constant word: over the binding's other words' range (a binding
    // of constants only has no range to borrow and stays unavailable)
    if def >= 0 {
      for (wi, op) in kops {
        words[wi] = [DvSpan{lo: def, hi: end, op: op}]
      }
    }
    if def >= 0 {
      p.binds.push(DvBind{dvar: d.dvar, def: def, words: words})
    }
  }
  var ks: List[Int] = []
  for (k, _) in need {
    ks.push(k)
  }
  p.need = ks.sort()
  p
}

/// The debug record's variable field: per described variable,
/// `name|type|param|line|entries`, the entries `start end bytes` joined by
/// `~`, variables by `;`. labels maps an instruction index to the label
/// at it (or at the next emitted instruction, or the end).
fn (var g: G) dv_field(p: DvPlan, labels: Map[Int, Str]) -> Str {
  var out: List[Str] = []
  // each variable's bindings, in the plan's order, found in one pass
  // (2026-10-21: a scan of every binding for each variable, and of every
  // binding's spans for each interval, made this 3% of a cold self
  // build's CPU, decision 0274's profile)
  var by_var: Map[Int, List[Int]] = {}
  for (bi, b) in p.binds.indexed() {
    var l = by_var.get(b.dvar) ?? []
    l.push(bi)
    by_var[b.dvar] = l
  }
  for (vi, dv) in g.f.dvars.indexed() {
    if !g.dv_type_ok(dv.ty) {
      continue
    }
    var mine: List[DvBind] = []
    for bi in by_var.get(vi) ?? [] {
      mine.push(p.binds[bi])
    }
    // the elementary intervals between every boundary of its spans
    var cuts: Map[Int, Bool] = {}
    for b in mine {
      for w in b.words {
        for s in w {
          cuts[s.lo] = true
          cuts[s.hi] = true
        }
      }
    }
    var cs: List[Int] = []
    for (k, _) in cuts {
      cs.push(k)
    }
    cs = cs.sort()
    let nw = g.layout(dv.ty).len()
    // for each elementary interval [cs[i], cs[i + 1]), the binding defined
    // last among those with a word over it (the first of equals): a span
    // covers exactly the intervals between the indices of its ends, every
    // end being a cut
    var at: Map[Int, Int] = {}
    for (i, c) in cs.indexed() {
      at[c] = i
    }
    var bests: List[Int] = []
    for _ in cs {
      bests.push(-1)
    }
    for (bi, b) in mine.indexed() {
      var cover: Map[Int, Bool] = {}
      for w in b.words {
        for s in w {
          let i0 = at.get(s.lo) ?? 0
          let i1 = at.get(s.hi) ?? 0
          for i in i0..i1 {
            cover[i] = true
          }
        }
      }
      for (i, _) in cover {
        if bests[i] < 0 || b.def > mine[bests[i]].def {
          bests[i] = bi
        }
      }
    }
    var entries: List[Str] = []
    var last_end = ""
    var last_op = ""
    for i in 0..cs.len() {
      if i + 1 >= cs.len() {
        break
      }
      let a = cs[i]
      let z = cs[i + 1]
      let best = bests[i]
      if best < 0 {
        continue
      }
      // the words' pieces: a run of words with no place there is one
      // empty piece of their bytes, words in consecutive spill slots one
      // piece of memory, and the words after the last one with a place are
      // left out (an object a composite does not cover is unavailable).
      // Decision 0252 stage 4: values of hundreds of words wrote a piece
      // per word, and .debug_loclists grew 26 times
      var parts: List[(List[Int], Int, Int)] = []
      for w in mine[best].words {
        var op: List[Int] = []
        for s in w {
          if s.lo <= a && s.hi >= z {
            op = s.op
          }
        }
        let k = parts.len() - 1
        if op.is_empty() {
          if k >= 0 && parts[k].0.is_empty() {
            parts[k] = (parts[k].0, -1, parts[k].2 + 8)
          } else {
            parts.push(([], -1, 8))
          }
          continue
        }
        let mo = sp_offset(op)
        if mo >= 0 && k >= 0 && parts[k].1 >= 0 && parts[k].1 + parts[k].2 == mo {
          parts[k] = (parts[k].0, parts[k].1, parts[k].2 + 8)
        } else {
          parts.push((op, mo, 8))
        }
      }
      while !parts.is_empty() && parts[parts.len() - 1].0.is_empty() {
        let _p = parts.pop()
      }
      var expr: List[Int] = []
      if nw == 1 {
        if !parts.is_empty() {
          expr = parts[0].0
        }
      } else {
        for (op, _, size) in parts {
          expr = expr + op + [0x93] + uleb_bytes(size) // DW_OP_piece
        }
      }
      if expr.is_empty() {
        // no word has a place over [a, z)
        continue
      }
      let la = labels.get(a) ?? ""
      let lz = labels.get(z) ?? ""
      if la.is_empty() || lz.is_empty() || la == lz {
        continue
      }
      var bs: List[Str] = []
      for x in expr {
        // -1 - k: the name of DW_OP_addrx's symbol k
        bs.push(if x < 0 { p.syms[-1 - x] } else { "${x}" })
      }
      let ops = bs.join(",")
      if la == last_end && ops == last_op && !entries.is_empty() {
        // the same place as the entry before: extend it
        let prev = entries.pop() ?? ""
        let parts = prev.split(" ")
        entries.push("${parts[0]} ${lz} ${ops}")
      } else {
        entries.push("${la} ${lz} ${ops}")
      }
      last_end = lz
      last_op = ops
    }
    // over each fault stub: the places the faulting frame keeps
    for s in g.dv_stubs {
      let expr = dv_stub_expr(mine, s, nw, g.x86)
      if expr.is_empty() {
        continue
      }
      var bs: List[Str] = []
      for x in expr {
        bs.push(if x < 0 { p.syms[-1 - x] } else { "${x}" })
      }
      entries.push("${s.lo} ${s.hi} ${bs.join(",")}")
    }
    let tn = g.m.types[dv.ty].name
    // the sixth field: its inline site (debug.xo nests it in that site's
    // inlined_subroutine), -1 for the function's own
    out.push("${dv.name}|${tn}|${if dv.param { 1 } else { 0 }}|${dv.line}|${entries.join("~")}|${dv.inl}")
  }
  out.join(";")
}

/// The offset from sp of a spill slot's location (DW_OP_breg31 and its
/// SLEB128), or -1 for another location.
fn sp_offset(op: List[Int]) -> Int {
  if op.is_empty() || op[0] != 0x8f {
    return -1
  }
  var v = 0
  var sh = 0
  var i = 1
  while i < op.len() {
    let b = op[i]
    v = v | ((b & 127) << sh)
    sh += 7
    i += 1
    if b < 128 {
      if b & 64 != 0 {
        v = v - (1 << sh)
      }
      break
    }
  }
  v
}

fn uleb_bytes(v0: Int) -> List[Int] {
  var v = v0
  var out: List[Int] = []
  while true {
    var b = v & 127
    v = v >> 7
    if v != 0 {
      b = b | 128
    }
    out.push(b)
    if v == 0 {
      break
    }
  }
  out
}

fn sleb_bytes(v0: Int) -> List[Int] {
  var v = v0
  var out: List[Int] = []
  while true {
    let b = v & 127
    v = v >> 7
    let done = (v == 0 && b & 64 == 0) || (v == -1 && b & 64 != 0)
    out.push(if done { b } else { b | 128 })
    if done {
      break
    }
  }
  out
}
