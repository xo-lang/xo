// xoasm: the self hosted arm64 emitter's command line (decision 0158).
//
//   arm64 [--std=DIR] [--wd=DIR] [--os=darwin|linux] [--no-inline] [--each] [--test] <dirs...>
//   arm64 [--std=DIR] [--wd=DIR] ... --bench=N <dirs...>
//
// It checks the directories as `xo asmdump` does (compiler/check in
// native mode), builds them with compiler/ssa and its passes, and prints
// the assembly internal/arm64 prints, then `== skipped` and one line per
// function it did not emit (`<name>: <why>`, a construct of a later
// stage). A run the checker rejects prints `== rejected`; one the Xo SSA
// builder does not build completely `== unsupported <why>`; a failure of
// the emitter `== error <why>`. --each builds every directory as a run
// of its own, each preceded by `=== asm <dir>`. --bench=N times the
// emitter alone (from a copy of the module after the passes) N times.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/ssa

fn dump_body(os: Os, args: List[Str]) ! {
  var repeat = 0
  var each = false
  var tests = false
  var no_inline = false
  var target = "darwin"
  var std_dir = "std"
  var wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  var dirs: List[Str] = []
  for a in args {
    if a.starts_with("--bench=") {
      repeat = Int.parse(a.trim_prefix("--bench=")) ?? fault("--bench needs a number")
    } else if a.starts_with("--std=") {
      std_dir = a.trim_prefix("--std=")
    } else if a.starts_with("--wd=") {
      wd = a.trim_prefix("--wd=")
    } else if a.starts_with("--os=") {
      target = a.trim_prefix("--os=")
    } else if a == "--each" {
      each = true
    } else if a == "--test" {
      tests = true
    } else if a == "--no-inline" {
      no_inline = true
    } else {
      dirs.push(a)
    }
  }
  if dirs.is_empty() {
    os.stdio.eprintln("usage: arm64 [--std=DIR] [--wd=DIR] [--os=darwin|linux] [--no-inline] [--each] [--test] [--bench=N] <dirs...>")
    os.proc.exit(2)
  }
  let modcache = os.env.get("XO_MODCACHE") ?? ""
  let home = os.env.get("HOME") ?? ""
  let xdg = os.env.get("XDG_CACHE_HOME") ?? ""
  let offline = os.env.get("XO_OFFLINE") ?? ""
  let work = os.env.get("XO_WORK") ?? ""
  let cbind = os.env.get("XO_CBIND_DIR") ?? ""
  var runs: List[List[Str]] = [dirs]
  if each {
    runs = []
    for d in dirs {
      runs.push([d])
    }
  }
  var total = 0
  var lines = 0
  for r in runs {
    if each && repeat == 0 {
      os.stdio.print("=== asm ${r[0]}\n")
    }
    var c = check.new_checker(os.fs, std_dir)
    c.native = true
    c.set_mod_env(wd, modcache, home, xdg, offline, work)
    c.cbind_dir = cbind
    match c.check_dirs(r) {
      Ok(_) => {}
      Err(e) => {
        if repeat == 0 {
          os.stdio.print("== error ${e}\n")
        }
        continue
      }
    }
    if !c.unsupported.is_empty() {
      if repeat == 0 {
        os.stdio.print("== unsupported ${c.unsupported}\n")
      }
      continue
    }
    if rejected(c) {
      if repeat == 0 {
        os.stdio.print("== rejected\n")
      }
      continue
    }
    var b = ssa.build_program(c, wd, tests)
    if !b.why.is_empty() {
      if repeat == 0 {
        os.stdio.print("== unsupported ${b.why}\n")
      }
      continue
    }
    var skip = ""
    for f in b.m.funcs {
      if !f.skip.is_empty() && skip.is_empty() {
        skip = "${f.name}: ${f.skip}"
      }
    }
    if !skip.is_empty() {
      if repeat == 0 {
        os.stdio.print("== unsupported the SSA builder skipped ${skip}\n")
      }
      continue
    }
    b.run_passes()
    // as xo build does (compiler/xo main.xo)
    b.m.poison_frames = (os.env.get("XO_POISON_FRAMES") ?? "") == "1"
    if repeat > 0 {
      let t0 = os.clock.now()
      for _ in 0..repeat {
        let p = generate_module(b.m, target, no_inline)
        lines += p.asm.split("\n").len() - 1
      }
      total += (os.clock.now() - t0).nanos()
      continue
    }
    let p = generate_module(b.m, target, no_inline)
    if !p.err.is_empty() {
      os.stdio.print("== error ${p.err}\n")
      continue
    }
    var out = StrBuilder.new()
    out.write(p.asm)
    out.write("== skipped\n")
    for s in p.skipped {
      out.write("${s}\n")
    }
    os.stdio.print(out.freeze())
  }
  if repeat > 0 {
    os.stdio.println("emitted ${runs.len()} runs x ${repeat}: ${lines} lines in ${total / 1000000} ms")
  }
}

/// Whether the checker reported an error (build.go checkOpts).
fn rejected(c: check.Checker) -> Bool {
  for d in c.diags {
    if !d.warning || d.code == "XO0900" {
      return true
    }
  }
  false
}

/// Generates module m (after the passes) for os, inlining first unless
/// no_inline (the module is generated without inlining when the inlined
/// one does not verify, as `xo build --backend=arm64` does).
pub fn generate_module(m: ssa.Module, os: Str, no_inline: Bool) -> Program {
  if !no_inline {
    var mi = m
    if !inline_module(mi) || mi.verify_all().is_empty() {
      var g = new_gen(mi, os)
      return g.generate()
    }
    // the inlined module does not verify (InlineError): without inlining
  }
  var g = new_gen(m, os)
  g.generate()
}

/// The two steps of generate_module, for a driver that times them (xo1
/// --phase-times): inline_step inlines into m and reports whether m may
/// be generated (nothing inlined, or the inlined module verifies);
/// generate_plain generates m as it is.
pub fn inline_step(var m: ssa.Module) -> Bool {
  !inline_module(m) || m.verify_all().is_empty()
}

/// inline_step with the verification on up to jobs tasks.
pub fn inline_step_jobs(var m: ssa.Module, jobs: Int) -> Bool { inline_check(m, jobs, false).is_empty() }

/// Inlines into m and returns the inlined module's verification errors
/// (none when nothing was inlined or it verifies): with any, the driver
/// generates the module without inlining, which it must say
/// (gotchas/arm64-inline-verify-fallback.md: the fallback was silent).
/// break_inline (the driver's XO_INLINE_BREAK=1, for the test of that)
/// adds an argument to the first branch's edge, so the inlined module
/// does not verify.
pub fn inline_check(var m: ssa.Module, jobs: Int, break_inline: Bool) -> List[Str] {
  if !inline_apply(m, break_inline) {
    return []
  }
  m.verify_all_jobs(jobs)
}

/// The first half of inline_check: inlines into m (and breaks it, with
/// break_inline); false when m did not change, so it needs no
/// verification.
pub fn inline_apply(var m: ssa.Module, break_inline: Bool) -> Bool {
  if !inline_module(m) && !break_inline {
    return false
  }
  if break_inline {
    let _b = inline_break(m)
  }
  true
}

/// XO_INLINE_BREAK=late's damage (compiler/xo, after dead function
/// removal, for the deferred verification): inline_break's.
pub fn break_inlined(var m: ssa.Module) -> Bool { inline_break(m) }

/// XO_INLINE_BREAK=1's damage (inline_check): an argument added to the
/// first branch's edge, so the module does not verify; true.
fn inline_break(var m: ssa.Module) -> Bool {
  var done = false
  for fi in 0..m.funcs.len() {
    for b in m.funcs[fi].blocks {
      for v in b.instrs {
        let succs = m.funcs[fi].values[v].succs
        if !done && !succs.is_empty() {
          m.funcs[fi].edges[succs[0]].args.push(v)
          m.funcs[fi].ckey = ""
          done = true
        }
      }
    }
    if done {
      break
    }
  }
  true
}

pub fn generate_plain(m: ssa.Module, os: Str) -> Program {
  var g = new_gen(m, os)
  g.generate()
}

/// dump_main is this component's command line with args, for `xo dev
/// dump` (decision 0209) as for the component's own binary; the exit
/// status.
pub fn dump_main(os: Os, args: List[Str]) -> Int uses (clock, env, fs.read, fs.write, proc, stdio) {
  match dump_body(os, args) {
    Ok(_) => 0
    Err(e) => {
      os.stdio.eprintln("${e.debug()}")
      1
    }
  }
}

fn main(os: Os) {
  os.proc.exit(dump_main(os, os.env.args()))
}
