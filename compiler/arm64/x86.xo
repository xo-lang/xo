// x86_64 (decision 0254 stage 2): the arm64 MIR retargeted. The front
// half (isel, calls, closures, rc, byref, and the MIR passes) builds
// arm64 templates over virtual registers; retarget rewrites each plain
// instruction's template, each branch's compare, and each fault's
// condition as an x86 template (AT&T syntax) before register
// allocation, and x86emit.xo expands them.
//
// An x86 template names its operands as an arm64 one does, by width:
// `$d0`, `$u1` (64 bits, or the xmm register of a Float), `$wd0`,
// `$wu1` (32), `$hd0`, `$hu1` (16), `$bd0`, `$bu1` (8). Immediates are
// AT&T's `$n` (a `$` and a digit or `-`). `%r11` and `%xmm15` are the
// template's own registers: no value is allocated to them.
//
// A two operand instruction (`addq $u1, $d0` reads and writes $d0) is
// a copy of the first source into the definition (a parallel move
// before it, which the allocator coalesces when the source dies) and the
// instruction with the definition also among its uses (a tie).

use github.com/xo-lang/xo/compiler/ssa

/// x86_64's registers: 0 to 15 are rax, rcx, rdx, rbx, rsp, rbp, rsi,
/// rdi, r8 to r15; FP_BASE + k is xmm k.
const XR_AX = 0
const XR_CX = 1
const XR_DX = 2
const XR_SP = 4
const XR_BP = 5
/// the emitter's and templates' scratch register (arm64's x16 and x17):
/// never allocated
const XR_SCRATCH = 11
/// xmm14: reloads of spilled Floats and parallel move cycles
const XF_SCRATCH = 46
/// xmm15: a template's own register
const XF_TPL = 47

/// The AT&T name of register r at size bytes (8, 4, 2, 1); an xmm
/// register by its number at any size.
fn x86_reg(r: Int, size: Int) -> Str {
  if r < 0 {
    return "%?${r}"
  }
  if r >= FP_BASE {
    return "%xmm${r - FP_BASE}"
  }
  if r >= 8 {
    return match size {
      8 => "%r${r}"
      4 => "%r${r}d"
      2 => "%r${r}w"
      _ => "%r${r}b"
    }
  }
  let q = ["ax", "cx", "dx", "bx", "sp", "bp", "si", "di"][r]
  match size {
    8 => "%r${q}"
    4 => "%e${q}"
    2 => "%${q}"
    _ => ["%al", "%cl", "%dl", "%bl", "%spl", "%bpl", "%sil", "%dil"][r]
  }
}

/// The translation of one template.
struct XT {
  lines: List[Str] = []
  /// definitions tied to a source: (definition index, the source),
  /// copied into the definition before the instruction
  ties: List[(Int, Src)] = []
  early: Bool = false
  clobbers: List[Int] = []
  /// the kind of the last instruction that set the flags: "sub" (cmp,
  /// subs: x86's carry is arm64's borrow complemented), "add" (adds,
  /// adcs, cmn as an add), "logic" (tst), "fcmp", "fcmps" (a float
  /// compare with its operands swapped), "fnan" (fccmp's ordered
  /// compare), "" none
  kind: Str = ""
  err: Str = ""
  /// the lines after this one the translation consumed (adrp's add,
  /// rbit's clz, mrs's adds, fcmp's fccmp)
  skip: Int = 0
}

/// A template operand's base (`u3`, `d0`) and its width prefix (`w` or
/// ""), or ("", "") for anything else.
fn tpl_ref(tok: Str) -> (Str, Str) {
  if !tok.starts_with("$") || tok.len() < 3 {
    return ("", "")
  }
  var w = ""
  var rest = tok[1..tok.len()]
  if rest.starts_with("w") {
    w = "w"
    rest = rest[1..rest.len()]
  }
  if !(rest.starts_with("u") || rest.starts_with("d")) || !is_digits(rest[1..rest.len()]) {
    return ("", "")
  }
  (rest, w)
}

/// An x86 operand for arm64 operand tok at size bytes: a template
/// reference, a register, or an immediate (`#n` as `$n`); "" for the
/// zero register (the caller writes zero its own way).
fn xop(tok: Str, size: Int) -> Str {
  let (base, _) = tpl_ref(tok)
  if !base.is_empty() {
    return match size {
      8 => "$${base}"
      4 => "$w${base}"
      2 => "$h${base}"
      _ => "$b${base}"
    }
  }
  if tok.starts_with("#") {
    return "$${tok[1..tok.len()]}"
  }
  match tok {
    "xzr" | "wzr" => ""
    "sp" => "%rsp"
    "x29" => "%rbp"
    "x16" | "x17" => x86_reg(XR_SCRATCH, size)
    _ => "?${tok}"
  }
}

/// The 32 bit form of an arm64 register operand (`$wu0`, `wzr`).
fn is_w(tok: Str) -> Bool {
  tok.starts_with("$w") || (tok.starts_with("w") && tok != "wzr") || tok == "wzr"
}

fn imm_of(tok: Str) -> Int? {
  if !tok.starts_with("#") {
    return None
  }
  Int.parse(tok[1..tok.len()])
}

/// Whether n is an x86 immediate of a 64 bit operation (sign extended 32
/// bits).
fn imm32(n: Int) -> Bool { n >= -2147483648 && n <= 2147483647 }

/// The operands of an arm64 instruction line after its mnemonic, split
/// at the commas outside brackets.
fn a64_ops(s: Str) -> List[Str] {
  var out: List[Str] = []
  let bs = s.bytes()
  var depth = 0
  var from = 0
  for i in 0..bs.len() {
    let c = bs[i]
    if c == '[' {
      depth += 1
    } else if c == ']' {
      depth -= 1
    } else if c == ',' && depth == 0 {
      out.push(s[from..i].trim())
      from = i + 1
    }
  }
  let last = s[from..s.len()].trim()
  if !last.is_empty() {
    out.push(last)
  }
  out
}

/// The x86 memory operand of arm64's `[base]`, `[base, #n]`, `[base,
/// index]`, `[base, index, lsl #k]`, and x86's own `[base, index,
/// #disp]`; "" if another form.
fn xmem(m: Str) -> Str {
  if !m.starts_with("[") || !m.ends_with("]") {
    return ""
  }
  let ps = a64_ops(m[1..m.len() - 1])
  if ps.is_empty() {
    return ""
  }
  let b = xop(ps[0], 8)
  if b.is_empty() || b.starts_with("?") {
    return ""
  }
  if ps.len() == 1 {
    return "(${b})"
  }
  if ps[1] == "#$OUT" {
    return "$OUT(${b})"
  }
  if let Some(n) = imm_of(ps[1]) {
    if ps.len() != 2 {
      return ""
    }
    return if n == 0 { "(${b})" } else { "${n}(${b})" }
  }
  if ps[1] == "xzr" {
    return "(${b})"
  }
  let x = xop(ps[1], 8)
  if x.is_empty() || x.starts_with("?") {
    return ""
  }
  if ps.len() == 2 {
    return "(${b},${x})"
  }
  if ps.len() == 3 && ps[2].starts_with("lsl #") {
    let k = Int.parse(ps[2][5..ps[2].len()]) ?? -1
    if k >= 0 && k <= 3 {
      return "(${b},${x},${1 << k})"
    }
  }
  // `[base, index, #disp]`: x86 only (calls.xo's folded offsets, no arm64
  // form)
  if ps.len() == 3 {
    if let Some(d) = imm_of(ps[2]) {
      return "${d}(${b},${x})"
    }
  }
  ""
}

/// The x86 condition code of arm64 condition c after a flag producer of
/// kind k ("" when there is none); a compound one is `e&np` (both) or
/// `ne|p` (either), for the float compares' equality.
fn x86_cond(c: Str, k: Str) -> Str {
  if k == "fcmp" || k == "fcmps" {
    // ucomisd: above (CF=0, ZF=0) is ordered greater, below (CF=1) is
    // less or unordered; fcmps swapped the operands for mi, lo, cc, ls,
    // hi, hs, cs, pl (x86_fswap)
    return match c {
      "eq" => "e&np"
      "ne" => "ne|p"
      "gt" => "a"
      "ge" => "ae"
      "lt" => "b"
      "le" => "be"
      "mi" | "lo" | "cc" => "a"
      "ls" => "ae"
      "hi" => "b"
      "hs" | "cs" | "pl" => "be"
      "vs" => "p"
      "vc" => "np"
      _ => ""
    }
  }
  if k == "fnan" {
    return match c {
      "ge" => "ae"
      "lt" => "b"
      _ => ""
    }
  }
  match c {
    "eq" => "e"
    "ne" => "ne"
    "lt" => "l"
    "ge" => "ge"
    "gt" => "g"
    "le" => "le"
    "mi" => "s"
    "pl" => "ns"
    "vs" => "o"
    "vc" => "no"
    "hs" | "cs" => if k == "add" { "b" } else if k == "sub" { "ae" } else { "" }
    "lo" | "cc" => if k == "add" { "ae" } else if k == "sub" { "b" } else { "" }
    "hi" => if k == "sub" { "a" } else { "" }
    "ls" => if k == "sub" { "be" } else { "" }
    _ => ""
  }
}

/// Whether a float compare tested with c swaps its operands (x86_cond).
fn x86_fswap(c: Str) -> Bool { c is "mi" | "lo" | "cc" | "ls" | "hi" | "hs" | "cs" | "pl" }

/// The negation of an x86 condition (a compound one by De Morgan).
fn x86_inv(c: Str) -> Str {
  if c == "e&np" {
    return "ne|p"
  }
  if c == "ne|p" {
    return "e&np"
  }
  if c.starts_with("n") && c != "np" && c != "ns" && c != "no" && c != "ne" {
    return c[1..c.len()]
  }
  match c {
    "e" => "ne"
    "ne" => "e"
    "l" => "ge"
    "ge" => "l"
    "g" => "le"
    "le" => "g"
    "a" => "be"
    "be" => "a"
    "ae" => "b"
    "b" => "ae"
    "s" => "ns"
    "ns" => "s"
    "o" => "no"
    "no" => "o"
    "p" => "np"
    "np" => "p"
    _ => ""
  }
}

/// The lines that jump to label when x86 condition c holds.
fn x86_jcc(c: Str, label: Str) -> List[Str] {
  if c == "e&np" {
    // both: skip past the jump when unordered
    return ["jp 9f", "je ${label}", "9:"]
  }
  if c == "ne|p" {
    return ["jne ${label}", "jp ${label}"]
  }
  ["j${c} ${label}"]
}

/// The lines that set byte register b to x86 condition c (0 or 1).
fn x86_setcc(c: Str, b: Str) -> List[Str] {
  if c == "e&np" {
    return ["sete ${b}", "setnp %r11b", "andb %r11b, ${b}"]
  }
  if c == "ne|p" {
    return ["setne ${b}", "setp %r11b", "orb %r11b, ${b}"]
  }
  ["set${c} ${b}"]
}

/// The suffix of an integer operation of size bytes.
fn sfx(size: Int) -> Str {
  match size {
    8 => "q"
    4 => "l"
    2 => "w"
    _ => "b"
  }
}

/// The condition the template's consumers test: a select's, a set's, or
/// the branch's or the fault's (the first given).
fn tpl_cond(lines: List[Str], conds: List[Str]) -> Str {
  for l in lines {
    let sp = l.find(" ") ?? -1
    if sp < 0 {
      continue
    }
    let m = l[0..sp]
    if m is "csel" | "csinc" | "cset" | "fcsel" | "cneg" {
      let ops = a64_ops(l[sp + 1..l.len()])
      if !ops.is_empty() {
        return ops[ops.len() - 1]
      }
    }
  }
  for c in conds {
    if !c.is_empty() {
      return c
    }
  }
  ""
}

/// The value of a movz, movk, movn chain (`#imm, lsl #s` operands), or
/// None.
fn mov_wide(lines: List[Str]) -> Int? {
  var v = 0
  for l in lines {
    let sp = l.find(" ") ?? -1
    if sp < 0 {
      return None
    }
    let m = l[0..sp]
    let ops = a64_ops(l[sp + 1..l.len()])
    if ops.len() != 3 || !ops[2].starts_with("lsl #") {
      return None
    }
    let a = imm_of(ops[1]) ?? -1
    let s = Int.parse(ops[2][5..ops[2].len()]) ?? -1
    if a < 0 || s < 0 {
      return None
    }
    match m {
      "movz" => {
        v = a.wrapping_mul(1 << s)
      }
      "movn" => {
        v = ~a.wrapping_mul(1 << s)
      }
      "movk" => {
        v = (v & ~65535.wrapping_mul(1 << s)) | a.wrapping_mul(1 << s)
      }
      _ => return None
    }
  }
  Some(v)
}

/// The lines that put constant n in register operand d (size 8).
fn x86_const(n: Int, d: Str) -> List[Str] {
  if n >= 0 && n <= 4294967295 {
    // a 32 bit move zero extends
    let dw = if d.starts_with("$") { "$w${d[1..d.len()]}" } else { d }
    return ["movl $${n}, ${dw}"]
  }
  if imm32(n) {
    return ["movq $${n}, ${d}"]
  }
  ["movabsq $${n}, ${d}"]
}

/// The class (Float or not) of template operand tok of inst.
fn (g: G) tok_fp(inst: Inst, tok: Str) -> Bool {
  let (base, _) = tpl_ref(tok)
  if base.is_empty() {
    return false
  }
  let k = Int.parse(base[1..base.len()]) ?? 0
  if base.starts_with("u") {
    return k < inst.us.len() && inst.us[k] != 0 && g.fp[inst.us[k]]
  }
  k < inst.defs.len() && g.fp[inst.defs[k]]
}

/// The source of template operand tok (a use, or the zero register) for
/// a tie's copy.
fn tie_src(inst: Inst, tok: Str) -> Src? {
  if tok == "xzr" || tok == "wzr" {
    return Some(rsrc(0))
  }
  let (base, _) = tpl_ref(tok)
  if base.is_empty() || !base.starts_with("u") {
    return None
  }
  let k = Int.parse(base[1..base.len()]) ?? -1
  if k < 0 || k >= inst.us.len() {
    return None
  }
  Some(rsrc(inst.us[k]))
}

/// The definition index of template operand tok, or -1.
fn def_index(tok: Str) -> Int {
  let (base, _) = tpl_ref(tok)
  if !base.starts_with("d") {
    return -1
  }
  Int.parse(base[1..base.len()]) ?? -1
}

/// Translates inst's arm64 template; conds are the conditions its flags
/// are tested with outside it (the branch's, the fault's).
fn (var g: G) x86_tpl(inst: Inst, conds: List[Str]) -> XT {
  var x = XT{}
  let src = inst.text.replace("\n\t", "\n")
  let lines = src.split("\n")
  if lines.len() == 1 && (lines[0].starts_with(".weak ") || lines[0].starts_with(".weak_reference ")) {
    x.lines = lines
    return x
  }
  if lines[0] == "1:" {
    return g.x86_llsc(inst, lines)
  }
  if lines[0].starts_with("movz ") || lines[0].starts_with("movn ") {
    match mov_wide(lines) {
      Some(n) => {
        let ops = a64_ops(lines[0][5..lines[0].len()])
        x.lines = x86_const(n, xop(ops[0], 8))
      }
      None => {
        x.err = "a wide move"
      }
    }
    return x
  }
  let single = lines.len() == 1
  // the flag consumers' condition decides a float compare's operand order
  let cond = tpl_cond(lines, conds)
  var k = 0
  while k < lines.len() {
    let l = lines[k]
    k += 1
    let sp = l.find(" ") ?? -1
    let m = if sp < 0 { l } else { l[0..sp] }
    let ops = if sp < 0 { [] } else { a64_ops(l[sp + 1..l.len()]) }
    let next = if k < lines.len() { lines[k] } else { "" }
    if !g.x86_line(inst, x, m, ops, single, next, cond) {
      if x.err.is_empty() {
        x.err = "`${l}`"
      }
      return x
    }
    k += x.skip
    x.skip = 0
  }
  for l in x.lines {
    if l.contains("?") {
      x.err = "an operand of `${l}`"
      return x
    }
  }
  x
}

/// Appends the x86 lines of one arm64 instruction (mnemonic m, operands
/// ops) to x; false for one it does not translate. single: the template
/// is this one instruction (a two operand form ties its definition); next
/// is the following line.
fn (var g: G) x86_line(inst: Inst, var x: XT, m: Str, ops: List[Str], single: Bool, next: Str, cond: Str) -> Bool {
  let n = ops.len()
  // the operation width of the first (definition or compared) operand
  let size = if n > 0 && is_w(ops[0]) { 4 } else { 8 }
  let q = sfx(size)
  match m {
    "mov" => {
      if n != 2 {
        return false
      }
      if let Some(v) = imm_of(ops[1]) {
        x.lines = x.lines + x86_const(v, xop(ops[0], 8))
        return true
      }
      let s = xop(ops[1], size)
      if s.is_empty() {
        x.lines.push("movl $0, ${xop(ops[0], 4)}")
        return true
      }
      x.lines.push("mov${q} ${s}, ${xop(ops[0], size)}")
      true
    }
    "add" | "sub" => g.x86_addsub(inst, x, m, ops, single, size)
    "adds" | "subs" | "adcs" | "adc" | "sbcs" | "sbc" => g.x86_flagop(inst, x, m, ops, single, size)
    "neg" | "negs" | "mvn" | "rev" => {
      if n != 2 {
        return false
      }
      let op = match m {
        "mvn" => "not"
        "rev" => "bswap"
        _ => "neg"
      }
      g.x86_unary(inst, x, ops[0], ops[1], "${op}${q}", single)
      if m == "negs" {
        x.kind = "sub"
      }
      true
    }
    "and" | "orr" | "eor" | "bic" | "eon" => g.x86_logic(inst, x, m, ops, single, size)
    "lsl" | "lsr" | "asr" | "ror" => g.x86_shift(inst, x, m, ops, single, size)
    "mul" => {
      g.x86_binop(inst, x, ops[0], ops[1], xop(ops[2], size), "imul${q}", single)
      true
    }
    "madd" | "msub" => {
      if n != 4 {
        return false
      }
      x.lines.push("mov${q} ${xop(ops[1], size)}, ${x86_reg(XR_SCRATCH, size)}")
      x.lines.push("imul${q} ${xop(ops[2], size)}, ${x86_reg(XR_SCRATCH, size)}")
      let op = if m == "madd" { "add" } else { "sub" }
      g.x86_binop(inst, x, ops[0], ops[3], "%r11", "${op}${q}", single)
      true
    }
    "x86_mulo" => {
      // isel's checked product under g.x86: imul sets OF on a signed
      // overflow (the fault's vs, jo); the definition is early (the fault
      // stub reads the operands), so no tie
      if n != 3 {
        return false
      }
      if let Some(k) = imm_of(ops[2]) {
        x.lines.push("imulq $${k}, ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
        return true
      }
      x.lines.push("movq ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      x.lines.push("imulq ${xop(ops[2], 8)}, ${xop(ops[0], 8)}")
      true
    }
    "smulh" | "umulh" => {
      if n != 3 {
        return false
      }
      x.clobbers = x.clobbers + [XR_AX, XR_DX]
      x.lines.push("movq ${xop(ops[1], 8)}, %rax")
      x.lines.push("${if m == "smulh" { "imulq" } else { "mulq" }} ${xop(ops[2], 8)}")
      x.lines.push("movq %rdx, ${xop(ops[0], 8)}")
      true
    }
    "smull" | "umull" => {
      if n != 3 {
        return false
      }
      if m == "smull" {
        x.lines.push("movslq ${xop(ops[1], 4)}, %r11")
        x.lines.push("movslq ${xop(ops[2], 4)}, ${xop(ops[0], 8)}")
      } else {
        x.lines.push("movl ${xop(ops[1], 4)}, %r11d")
        x.lines.push("movl ${xop(ops[2], 4)}, ${xop(ops[0], 4)}")
      }
      x.lines.push("imulq %r11, ${xop(ops[0], 8)}")
      true
    }
    "sdiv" => {
      if n != 3 {
        return false
      }
      // arm64's sdiv does not trap: a / 0 is 0 and the minimum / -1 the
      // minimum, and the front half may speculate a division (an if
      // conversion's both arms); x86's idiv traps on both
      x.clobbers = x.clobbers + [XR_AX, XR_DX]
      let dv = xop(ops[2], 8)
      x.lines = x.lines + ["movq ${xop(ops[1], 8)}, %rax", "cmpq $-1, ${dv}", "je 1f", "testq ${dv}, ${dv}", "je 2f", "cqto", "idivq ${dv}", "jmp 3f", "1:", "negq %rax", "jmp 3f", "2:", "xorl %eax, %eax", "3:", "movq %rax, ${xop(ops[0], 8)}"]
      true
    }
    "sxtw" => {
      x.lines.push("movslq ${xop(ops[1], 4)}, ${xop(ops[0], 8)}")
      true
    }
    "clz" => {
      x.lines.push("bsrq ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      x.lines.push("movl $127, %r11d")
      x.lines.push("cmovzq %r11, ${xop(ops[0], 8)}")
      x.lines.push("xorq $63, ${xop(ops[0], 8)}")
      true
    }
    "rbit" => {
      // rbit then clz: the trailing zeros (64 for zero)
      if !next.starts_with("clz ") {
        return false
      }
      x.lines.push("bsfq ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      x.lines.push("movl $64, %r11d")
      x.lines.push("cmovzq %r11, ${xop(ops[0], 8)}")
      x.skip = 1
      true
    }
    "extr" => {
      if n != 4 {
        return false
      }
      let kk = imm_of(ops[3]) ?? -1
      if kk < 0 {
        return false
      }
      g.x86_binop(inst, x, ops[0], ops[2], xop(ops[1], 8), "shrdq $${kk},", single)
      true
    }
    "cmp" | "cmn" | "tst" => g.x86_cmp(inst, x, m, ops, next, cond, size)
    "ccmn" => {
      // after `cmp a, b`: when eq, the flags of c + k, else nzcv (decision:
      // only the Z clear case, tested with eq and ne)
      if n != 4 || ops[2] != "#0" || ops[3] != "eq" {
        return false
      }
      let kk = imm_of(ops[1]) ?? -1
      if kk < 0 {
        return false
      }
      x.lines.push("jne 8f")
      x.lines.push("cmpq $${-kk}, ${xop(ops[0], 8)}")
      x.lines.push("8:")
      x.kind = "sub"
      true
    }
    "cset" | "csinc" | "csel" | "cneg" | "fcsel" => g.x86_select(inst, x, m, ops, single)
    "ldr" | "ldrb" | "ldrh" | "ldar" | "str" | "strb" | "strh" | "stlr" | "stp" | "ldp" => g.x86_mem(inst, x, m, ops)
    "adrp" => {
      // adrp and its add or ldr: the address, or the GOT entry's word
      if n != 2 {
        return false
      }
      let d = xop(ops[0], 8)
      if ops[1].starts_with(":got:") {
        x.lines.push("movq ${ops[1][5..ops[1].len()]}@GOTPCREL(%rip), ${d}")
      } else if ops[1].ends_with("@GOTPAGE") {
        // Mach-O's GOT entry (darwin)
        x.lines.push("movq ${ops[1][0..ops[1].len() - 8]}@GOTPCREL(%rip), ${d}")
      } else if ops[1].ends_with("@PAGE") {
        x.lines.push("leaq ${ops[1][0..ops[1].len() - 5]}(%rip), ${d}")
      } else {
        x.lines.push("leaq ${ops[1]}(%rip), ${d}")
      }
      x.skip = 1
      true
    }
    "mrs" => {
      // the thread pointer and the two tprel adds: local exec
      if n != 2 || ops[1] != "tpidr_el0" {
        return false
      }
      let at = next.find(":tprel_hi12:") ?? -1
      if at < 0 {
        return false
      }
      let d = xop(ops[0], 8)
      x.lines.push("movq %fs:0, ${d}")
      x.lines.push("leaq ${next[at + 12..next.len()]}@TPOFF(${d}), ${d}")
      x.skip = 2
      true
    }
    "prfm" => {
      x.lines.push("prefetcht0 ${xmem(ops[1])}")
      true
    }
    "yield" => {
      x.lines.push("pause")
      true
    }
    "brk" => {
      x.lines.push("ud2")
      true
    }
    // x86_split's pseudo lines: a carry chain's setup and its kind
    // x86_split's carry setup: the setup line and the kind of the
    // instruction after it ("x86setup adc|sbc cmp|cmn op, op")
    "x86setup" => {
      let l = x86_carry_setup(ops[1], ops[2..ops.len()], ops[0] == "sbc")
      if l.is_empty() {
        return false
      }
      x.lines = x.lines + l
      true
    }
    "x86kind" => {
      x.kind = ops[0]
      true
    }
    "dmb" => {
      if n == 1 && ops[0] == "ishld" {
        // x86 keeps loads in order
        x.lines.push("# dmb ishld")
      } else {
        x.lines.push("mfence")
      }
      true
    }
    "fmov" => {
      if n != 2 {
        return false
      }
      let dfp = g.tok_fp(inst, ops[0])
      if ops[1] == "xzr" {
        x.lines.push("xorpd ${xop(ops[0], 8)}, ${xop(ops[0], 8)}")
        return true
      }
      let sfp = g.tok_fp(inst, ops[1])
      if dfp && sfp {
        x.lines.push("movapd ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      } else {
        x.lines.push("movq ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      }
      true
    }
    "fadd" | "fsub" | "fmul" | "fdiv" => {
      let op = match m {
        "fadd" => "addsd"
        "fsub" => "subsd"
        "fmul" => "mulsd"
        _ => "divsd"
      }
      g.x86_binop(inst, x, ops[0], ops[1], xop(ops[2], 8), op, single)
      true
    }
    "fneg" | "fabs" => {
      let mask = if m == "fneg" { "0x8000000000000000" } else { "0x7fffffffffffffff" }
      x.lines.push("movabsq $${mask}, %r11")
      x.lines.push("movq %r11, %xmm15")
      g.x86_unary(inst, x, ops[0], ops[1], if m == "fneg" { "xorpd %xmm15," } else { "andpd %xmm15," }, single)
      true
    }
    "fsqrt" => {
      x.lines.push("sqrtsd ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      true
    }
    "frintz" | "frintm" | "frintp" => {
      let mode = match m {
        "frintz" => 3
        "frintm" => 1
        _ => 2
      }
      x.lines.push("roundsd $${mode}, ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      true
    }
    "frinta" => {
      // to nearest, ties away from zero: trunc(x + copysign(0.5 - ulp, x))
      let d = xop(ops[0], 8)
      let u = xop(ops[1], 8)
      x.lines = x.lines + ["movq ${u}, %r11", "shrq $63, %r11", "shlq $63, %r11", "movq %r11, %xmm15", "movabsq $0x3fdfffffffffffff, %r11", "movq %r11, ${d}", "orpd %xmm15, ${d}", "addsd ${u}, ${d}", "roundsd $3, ${d}, ${d}"]
      x.early = true
      true
    }
    "fcvtzs" => {
      x.lines.push("cvttsd2siq ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      true
    }
    "scvtf" => {
      let op = if is_w(ops[0]) { "cvtsi2ssq" } else { "cvtsi2sdq" }
      x.lines.push("${op} ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      true
    }
    "ucvtf" => {
      // unsigned: halve (keeping the low bit, round to odd) past 2^63
      let d = xop(ops[0], 8)
      let u = xop(ops[1], 8)
      x.lines = x.lines + ["testq ${u}, ${u}", "js 6f", "cvtsi2sdq ${u}, ${d}", "jmp 7f", "6:", "movq ${u}, %r11", "shrq $1, %r11", "jnc 5f", "orq $1, %r11", "5:", "cvtsi2sdq %r11, ${d}", "addsd ${d}, ${d}", "7:"]
      true
    }
    "fcvt" => {
      // to single (the w form) or back to double
      let op = if is_w(ops[0]) { "cvtsd2ss" } else { "cvtss2sd" }
      x.lines.push("${op} ${xop(ops[1], 8)}, ${xop(ops[0], 8)}")
      true
    }
    "fcmp" => {
      if n != 2 {
        return false
      }
      if next.starts_with("fccmp ") {
        return g.x86_fccmp(inst, x, ops, next)
      }
      var a = xop(ops[0], 8)
      var b = xop(ops[1], 8)
      if ops[1].starts_with("#") {
        x.lines.push("xorpd %xmm15, %xmm15")
        b = "%xmm15"
      }
      if x86_fswap(cond) {
        x.lines.push("ucomisd ${a}, ${b}")
        x.kind = "fcmps"
      } else {
        x.lines.push("ucomisd ${b}, ${a}")
        x.kind = "fcmp"
      }
      true
    }
    _ => false
  }
}

/// `add` and `sub` (no flags): lea when it can, else a two operand form.
fn (var g: G) x86_addsub(inst: Inst, var x: XT, m: Str, ops: List[Str], single: Bool, size: Int) -> Bool {
  let n = ops.len()
  if n < 3 {
    return false
  }
  let d = xop(ops[0], size)
  let a = xop(ops[1], 8)
  if a.is_empty() {
    return false
  }
  if let Some(v0) = imm_of(ops[2]) {
    var v = v0
    if n == 4 {
      if ops[3] != "lsl #12" {
        return false
      }
      v = v << 12
    }
    if m == "sub" {
      v = -v
    }
    if !imm32(v) {
      return false
    }
    x.lines.push("lea${sfx(size)} ${v}(${a}), ${d}")
    return true
  }
  if ops[2] == "#$OUT" {
    x.lines.push("lea${sfx(size)} $OUT(${a}), ${d}")
    return true
  }
  let b = xop(ops[2], 8)
  if b.is_empty() || b.starts_with("?") {
    return false
  }
  if m == "add" && n == 3 {
    x.lines.push("lea${sfx(size)} (${a},${b}), ${d}")
    return true
  }
  if m == "add" && n == 4 && ops[3].starts_with("lsl #") {
    let k = Int.parse(ops[3][5..ops[3].len()]) ?? 99
    if k <= 3 {
      x.lines.push("lea${sfx(size)} (${a},${b},${1 << k}), ${d}")
      return true
    }
  }
  if n == 4 {
    // a shifted operand: shift it in the scratch register first
    let sh = ops[3]
    let op = if sh.starts_with("lsl #") { "shlq" } else if sh.starts_with("lsr #") { "shrq" } else if sh.starts_with("asr #") { "sarq" } else { "" }
    if op.is_empty() {
      return false
    }
    x.lines.push("movq ${b}, %r11")
    x.lines.push("${op} $${sh[5..sh.len()]}, %r11")
    if m == "add" {
      x.lines.push("leaq (${a},%r11), ${xop(ops[0], 8)}")
    } else {
      g.x86_binop(inst, x, ops[0], ops[1], "%r11", "subq", single)
    }
    return true
  }
  // sub d, a, b
  g.x86_binop(inst, x, ops[0], ops[1], xop(ops[2], size), "sub${sfx(size)}", single)
  true
}

/// adds, subs (flags), adcs, adc (with the carry).
fn (var g: G) x86_flagop(inst: Inst, var x: XT, m: Str, ops: List[Str], single: Bool, size: Int) -> Bool {
  if ops.len() != 3 {
    return false
  }
  // sbc: a - b - borrow, arm64's C being no borrow, x86's CF the borrow
  // (the polarity a sub or sbb left)
  let op = match m {
    "adds" => "add"
    "subs" => "sub"
    "sbcs" | "sbc" => "sbb"
    _ => "adc"
  }
  var b = xop(ops[2], size)
  if ops[2] == "xzr" || ops[2] == "wzr" {
    b = "$0"
  }
  if ops[0] == "xzr" {
    // only the flags (adcs xzr, a, b): in the scratch register
    let a = if ops[1] == "xzr" { "$0" } else { xop(ops[1], 8) }
    x.lines.push("movq ${a}, %r11")
    x.lines.push("${op}q ${b}, %r11")
  } else {
    g.x86_binop(inst, x, ops[0], ops[1], b, "${op}${sfx(size)}", single)
  }
  x.kind = if m is "subs" | "sbcs" | "sbc" { "sub" } else { "add" }
  true
}

/// The x86 lines that set CF to ARM's C for arm64's carry setup m ops
/// (x86_carry_polarity turns it into the borrow an sbb reads): cmp xzr,
/// xzr sets C, cmn xzr, xzr clears it, cmp c, #1 makes it c (0 or 1);
/// none for another setup. sbc is the instruction after it being an sbc
/// (unused: the polarity is the tracker's).
fn x86_carry_setup(m: Str, ops: List[Str], sbc: Bool) -> List[Str] {
  let _s = sbc
  if ops.len() == 2 && ops[0] == "xzr" && ops[1] == "xzr" {
    return [if m == "cmp" { "stc" } else { "clc" }]
  }
  if m == "cmp" && ops.len() == 2 && ops[1] == "#1" {
    return ["btq $0, ${xop(ops[0], 8)}"]
  }
  []
}

/// d = a op b as a two operand x86 instruction `op b, d`: a tie when the
/// template is this one instruction, else a move first (and the
/// definitions written early). op may end in "," (a three operand form
/// whose last two are b and d, `shrdq $k, b, d`).
fn (var g: G) x86_binop(inst: Inst, var x: XT, dt: Str, at: Str, b: Str, op: Str, single: Bool) {
  let size = if is_w(dt) { 4 } else { 8 }
  let d = xop(dt, size)
  let fp = g.tok_fp(inst, dt)
  var line = "${op} ${b}, ${d}"
  let di = def_index(dt)
  if single && di >= 0 {
    if let Some(s0) = tie_src(inst, at) {
      var s = s0
      if x86_commutes(op) && s.kind == S_REG && s.v != 0 && !g.x86_dead.contains(s.v) {
        // the tied operand lives on, the other dies here: tie that one
        // (its copy coalesces away)
        let (bb, _) = tpl_ref(b)
        if bb.starts_with("u") {
          let k = Int.parse(bb[1..bb.len()]) ?? -1
          if k >= 0 && k < inst.us.len() && inst.us[k] != 0 && g.x86_dead.contains(inst.us[k]) {
            let a2 = xop(at, if b.starts_with("$w") { 4 } else { 8 })
            if !a2.is_empty() && !a2.starts_with("$0") {
              s = rsrc(inst.us[k])
              line = "${op} ${a2}, ${d}"
            }
          }
        }
      }
      // a op a: the operation reads d twice, so a need not outlive the copy
      let (bb2, _) = tpl_ref(b)
      if s.kind == S_REG && s.v != 0 && bb2.starts_with("u") {
        let k2 = Int.parse(bb2[1..bb2.len()]) ?? -1
        if k2 >= 0 && k2 < inst.us.len() && inst.us[k2] == s.v && line == "${op} ${b}, ${d}" {
          line = "${op} ${d}, ${d}"
        }
      }
      x.ties.push((di, s))
      x.lines.push(line)
      return
    }
  }
  // a move of a into d, then the operation: d must not share a register
  // with a later use
  let a = xop(at, size)
  if a.is_empty() {
    x.lines.push(if fp { "xorpd ${d}, ${d}" } else { "mov${sfx(size)} $0, ${d}" })
  } else if fp {
    x.lines.push("movapd ${xop(at, 8)}, ${d}")
  } else {
    x.lines.push("mov${sfx(size)} ${a}, ${d}")
  }
  x.lines.push(line)
  x.early = true
}

/// d = op a (one operand in place).
fn (var g: G) x86_unary(inst: Inst, var x: XT, dt: Str, at: Str, op: Str, single: Bool) {
  let size = if is_w(dt) { 4 } else { 8 }
  let d = xop(dt, size)
  let line = "${op} ${d}"
  let di = def_index(dt)
  if single && di >= 0 {
    if let Some(s) = tie_src(inst, at) {
      x.ties.push((di, s))
      x.lines.push(line)
      return
    }
  }
  let fp = g.tok_fp(inst, dt)
  x.lines.push(if fp { "movapd ${xop(at, 8)}, ${d}" } else { "mov${sfx(size)} ${xop(at, size)}, ${d}" })
  x.lines.push(line)
  x.early = true
}

/// and, orr, eor, bic, eon.
fn (var g: G) x86_logic(inst: Inst, var x: XT, m: Str, ops: List[Str], single: Bool, size: Int) -> Bool {
  if ops.len() != 3 {
    return false
  }
  let op = match m {
    "and" | "bic" => "and"
    "orr" => "or"
    _ => "xor"
  }
  let q = sfx(size)
  if let Some(v) = imm_of(ops[2]) {
    if (size == 8 && imm32(v)) || size == 4 {
      g.x86_binop(inst, x, ops[0], ops[1], "$${v}", "${op}${q}", single)
    } else {
      x.lines.push("movabsq $${v}, %r11")
      g.x86_binop(inst, x, ops[0], ops[1], "%r11", "${op}${q}", single)
    }
    return true
  }
  var b = xop(ops[2], size)
  if m == "bic" || m == "eon" {
    x.lines.push("mov${q} ${b}, ${x86_reg(XR_SCRATCH, size)}")
    x.lines.push("not${q} ${x86_reg(XR_SCRATCH, size)}")
    b = x86_reg(XR_SCRATCH, size)
  }
  g.x86_binop(inst, x, ops[0], ops[1], b, "${op}${q}", single)
  true
}

/// lsl, lsr, asr, ror by an immediate or by a register (in cl).
fn (var g: G) x86_shift(inst: Inst, var x: XT, m: Str, ops: List[Str], single: Bool, size: Int) -> Bool {
  if ops.len() != 3 {
    return false
  }
  let op = match m {
    "lsl" => "shl"
    "lsr" => "shr"
    "asr" => "sar"
    _ => "ror"
  }
  let q = sfx(size)
  if let Some(v) = imm_of(ops[2]) {
    g.x86_binop(inst, x, ops[0], ops[1], "$${v}", "${op}${q}", single)
    return true
  }
  x.clobbers.push(XR_CX)
  x.lines.push("movq ${xop(ops[2], 8)}, %rcx")
  g.x86_binop(inst, x, ops[0], ops[1], "%cl", "${op}${q}", single)
  true
}

/// cmp, cmn, tst (and cmp's carry setups for an adc that follows).
fn (var g: G) x86_cmp(inst: Inst, var x: XT, m: Str, ops: List[Str], next: Str, cond: Str, size: Int) -> Bool {
  let n = ops.len()
  if n < 2 {
    return false
  }
  let q = sfx(size)
  let a = xop(ops[0], size)
  let adc_next = next.starts_with("adcs ") || next.starts_with("adc ")
  let sbc_next = next.starts_with("sbcs ") || next.starts_with("sbc ")
  if (m == "cmp" || m == "cmn") && (adc_next || sbc_next) {
    // the carry an adc or sbc reads (x86_carry_setup)
    let l = x86_carry_setup(m, ops, sbc_next)
    if l.is_empty() {
      return false
    }
    x.lines = x.lines + l
    return true
  }
  if m == "tst" {
    if let Some(v) = imm_of(ops[1]) {
      if size == 4 || imm32(v) {
        x.lines.push("test${q} $${v}, ${a}")
      } else {
        x.lines.push("movabsq $${v}, %r11")
        x.lines.push("testq %r11, ${a}")
      }
    } else {
      x.lines.push("test${q} ${xop(ops[1], size)}, ${a}")
    }
    x.kind = "logic"
    return true
  }
  if m == "cmn" {
    // a + b: as a compare with -b when only the signed and equality
    // conditions are tested, else an add in the scratch register
    let carry = cond is "hs" | "cs" | "lo" | "cc" | "hi" | "ls"
    if let Some(v) = imm_of(ops[1]) {
      if !carry && imm32(-v) {
        x.lines.push("cmp${q} $${-v}, ${a}")
        x.kind = "sub"
        return true
      }
      x.lines.push("mov${q} ${a}, ${x86_reg(XR_SCRATCH, size)}")
      x.lines.push("add${q} $${v}, ${x86_reg(XR_SCRATCH, size)}")
      x.kind = "add"
      return true
    }
    x.lines.push("mov${q} ${a}, ${x86_reg(XR_SCRATCH, size)}")
    x.lines.push("add${q} ${xop(ops[1], size)}, ${x86_reg(XR_SCRATCH, size)}")
    x.kind = "add"
    return true
  }
  // cmp
  if a.is_empty() {
    return false
  }
  if let Some(v) = imm_of(ops[1]) {
    if size == 4 || imm32(v) {
      x.lines.push("cmp${q} $${v}, ${a}")
    } else {
      x.lines.push("movabsq $${v}, %r11")
      x.lines.push("cmpq %r11, ${a}")
    }
  } else if n == 3 {
    // cmp a, b, asr #k (the multiply's overflow test)
    let sh = ops[2]
    if !sh.starts_with("asr #") {
      return false
    }
    x.lines.push("movq ${xop(ops[1], 8)}, %r11")
    x.lines.push("sarq $${sh[5..sh.len()]}, %r11")
    x.lines.push("cmpq %r11, ${a}")
  } else {
    let b = xop(ops[1], size)
    if b.is_empty() {
      x.lines.push("cmp${q} $0, ${a}")
    } else {
      x.lines.push("cmp${q} ${b}, ${a}")
    }
  }
  x.kind = "sub"
  true
}

/// cset, csinc, csel, cneg, fcsel after the template's compare.
fn (var g: G) x86_select(inst: Inst, var x: XT, m: Str, ops: List[Str], single: Bool) -> Bool {
  let n = ops.len()
  let c = x86_cond(ops[n - 1], x.kind)
  if c.is_empty() {
    x.err = "the condition ${ops[n - 1]} after a ${x.kind} compare"
    return false
  }
  let d = xop(ops[0], 8)
  let di = def_index(ops[0])
  if m == "cset" {
    x.lines = x.lines + x86_setcc(c, xop(ops[0], 1))
    x.lines.push("movzbl ${xop(ops[0], 1)}, ${xop(ops[0], 4)}")
    return true
  }
  if m == "csinc" {
    if ops[1] == "xzr" && ops[2] == "xzr" {
      // c ? 0 : 1
      x.lines = x.lines + x86_setcc(x86_inv(c), xop(ops[0], 1))
      x.lines.push("movzbl ${xop(ops[0], 1)}, ${xop(ops[0], 4)}")
      return true
    }
    if ops[1] != ops[2] || di < 0 {
      return false
    }
    // c ? a : a + 1
    x.lines = x.lines + x86_setcc(x86_inv(c), "%r11b")
    x.lines.push("movzbl %r11b, %r11d")
    let so = tie_src(inst, ops[1])
    if so.is_none() {
      return false
    }
    let s = so ?? rsrc(0)
    x.ties.push((di, s))
    x.lines.push("addq %r11, ${d}")
    return true
  }
  if m == "cneg" {
    // the negation is computed before the compare: the scratch register
    // at the template's start
    let so = tie_src(inst, ops[1])
    if so.is_none() {
      return false
    }
    let s = so ?? rsrc(0)
    x.ties.push((di, s))
    x.lines = ["movq ${xop(ops[1], 8)}, %r11", "negq %r11"] + x.lines
    x.lines.push("cmov${c}q %r11, ${d}")
    return true
  }
  // csel and fcsel: d = c ? a : b
  if di < 0 {
    return false
  }
  if ops[2] == ops[0] {
    // b is d itself (a cset before it in the template made it): only the
    // conditional move
    var a0 = xop(ops[1], 8)
    if a0.is_empty() {
      x.lines.push("movl $0, %r11d")
      a0 = "%r11"
    }
    if m == "fcsel" || c.contains("&") || c.contains("|") {
      x.lines = x.lines + x86_jcc(x86_inv(c), "4f")
      x.lines.push("${if m == "fcsel" { "movapd" } else { "movq" }} ${a0}, ${d}")
      x.lines.push("4:")
    } else {
      x.lines.push("cmov${c}q ${a0}, ${d}")
    }
    return true
  }
  let so = tie_src(inst, ops[2])
  if so.is_none() {
    return false
  }
  let s = so ?? rsrc(0)
  x.ties.push((di, s))
  if m == "fcsel" {
    x.lines = x.lines + x86_jcc(x86_inv(c), "4f")
    x.lines.push("movapd ${xop(ops[1], 8)}, ${d}")
    x.lines.push("4:")
    return true
  }
  var a = xop(ops[1], 8)
  if a.is_empty() {
    x.lines.push("movl $0, %r11d")
    a = "%r11"
  }
  if c == "ne|p" {
    // either: two conditional moves of a
    x.lines.push("cmovneq ${a}, ${d}")
    x.lines.push("cmovpq ${a}, ${d}")
    return true
  }
  if c == "e&np" {
    // both: a move past two branches
    x.lines = x.lines + ["jne 3f", "jp 3f", "movq ${a}, ${d}", "3:"]
    return true
  }
  x.lines.push("cmov${c}q ${a}, ${d}")
  true
}

/// Loads and stores (ldar is a load: x86 keeps loads in order; stlr an
/// xchg, which orders it with later loads as stlr with ldar does).
fn (var g: G) x86_mem(inst: Inst, var x: XT, m: Str, ops: List[Str]) -> Bool {
  if m == "stp" || m == "ldp" {
    // a pair of words at [base, #off] (a known length copy, zeroing)
    if ops.len() != 3 {
      return false
    }
    let mm = xmem(ops[2])
    let ps = a64_ops(ops[2][1..ops[2].len() - 1])
    let base = xop(ps[0], 8)
    let off = if ps.len() > 1 { imm_of(ps[1]) ?? 0 } else { 0 }
    if mm.is_empty() || (ps.len() > 1 && imm_of(ps[1]).is_none()) {
      return false
    }
    if m == "ldp" {
      // both definitions written early: one may be the base's register
      x.lines.push("movq ${off}(${base}), ${xop(ops[0], 8)}")
      x.lines.push("movq ${off + 8}(${base}), ${xop(ops[1], 8)}")
      x.early = true
      return true
    }
    for (k, r) in ops[0..2].indexed() {
      let v = if r == "xzr" { "$0" } else { xop(r, 8) }
      x.lines.push("movq ${v}, ${off + 8 * k}(${base})")
    }
    return true
  }
  if ops.len() != 2 {
    return false
  }
  let mm = xmem(ops[1])
  if mm.is_empty() {
    return false
  }
  let r = ops[0]
  let fp = g.tok_fp(inst, r)
  let w = is_w(r)
  match m {
    "ldr" | "ldar" => {
      if fp {
        x.lines.push("${if w { "movss" } else { "movsd" }} ${mm}, ${xop(r, 8)}")
      } else if w {
        x.lines.push("movl ${mm}, ${xop(r, 4)}")
      } else {
        x.lines.push("movq ${mm}, ${xop(r, 8)}")
      }
    }
    "ldrb" => x.lines.push("movzbl ${mm}, ${xop(r, 4)}")
    "ldrh" => x.lines.push("movzwl ${mm}, ${xop(r, 4)}")
    "str" => {
      if r == "xzr" || r == "wzr" {
        x.lines.push("mov${if w { "l" } else { "q" }} $0, ${mm}")
      } else if fp {
        x.lines.push("${if w { "movss" } else { "movsd" }} ${xop(r, 8)}, ${mm}")
      } else if w {
        x.lines.push("movl ${xop(r, 4)}, ${mm}")
      } else {
        x.lines.push("movq ${xop(r, 8)}, ${mm}")
      }
    }
    "strb" => x.lines.push(if r == "wzr" { "movb $0, ${mm}" } else { "movb ${xop(r, 1)}, ${mm}" })
    "strh" => x.lines.push(if r == "wzr" { "movw $0, ${mm}" } else { "movw ${xop(r, 2)}, ${mm}" })
    "stlr" => {
      x.lines.push("movq ${xop(r, 8)}, %r11")
      x.lines.push("xchgq %r11, ${mm}")
    }
    _ => return false
  }
  true
}

/// The load and store exclusive loops of the reference counts
/// (calls.xo atomic_inc, closures.xo atomic_dec): an atomic add of a
/// constant to the word at $u0, then optionally a compare of the new
/// value.
fn (var g: G) x86_llsc(inst: Inst, lines: List[Str]) -> XT {
  var x = XT{}
  // 1: / ld(a)xr x17, [$u0] / add|sub x17, x17, #n / st(l)xr w15, x17,
  // [$u0] / cbnz w15, 1b [/ cmp x17, #m]
  if lines.len() < 5 {
    x.err = "a load and store exclusive loop"
    return x
  }
  let l2 = lines[2]
  let sp = l2.find(" ") ?? -1
  let ops = a64_ops(l2[sp + 1..l2.len()])
  let sp1 = lines[1].find(" ") ?? 0
  let mem = a64_ops(lines[1][sp1..lines[1].len()])
  if sp < 0 || ops.len() != 3 || mem.len() != 2 {
    x.err = "a load and store exclusive loop"
    return x
  }
  var v = imm_of(ops[2]) ?? 0
  if l2.starts_with("sub ") {
    v = -v
  }
  let addr = xmem(mem[1])
  if lines.len() == 5 {
    x.lines.push("lock addq $${v}, ${addr}")
    return x
  }
  let cmp = a64_ops(lines[5][4..lines[5].len()])
  let c = imm_of(cmp[1]) ?? 0
  x.lines = ["movq $${v}, %r11", "lock xaddq %r11, ${addr}", "addq $${v}, %r11", "cmpq $${c}, %r11"]
  x.kind = "sub"
  x
}

/// `fcmp a, a` then `fccmp a, b, #0, vc`: a NaN a compares as greater
/// or equal (the flags nzcv 0), else a with b (an unordered b as less).
fn (var g: G) x86_fccmp(inst: Inst, var x: XT, ops: List[Str], next: Str) -> Bool {
  let fo = a64_ops(next[6..next.len()])
  if fo.len() != 4 || fo[2] != "#0" || fo[3] != "vc" || fo[0] != ops[0] || ops[0] != ops[1] {
    return false
  }
  let a = xop(fo[0], 8)
  let b = xop(fo[1], 8)
  x.lines = x.lines + ["ucomisd ${a}, ${a}", "jp 3f", "ucomisd ${b}, ${a}", "jmp 2f", "3:", "clc", "2:"]
  x.kind = "fnan"
  x.skip = 1
  true
}

/// Rewrites the function's MIR as x86 (decision 0254 stage 2): each
/// plain instruction's template, each compare and branch's template and
/// condition, each fault's condition. The ties become parallel moves
/// before their instruction.
fn (var g: G) x86_retarget() {
  let lout = g.x86_live_out()
  for b in 0..g.blocks.len() {
    var out: List[Inst] = []
    // CF holds not ARM's C (x86_carry_polarity)
    var inv = false
    // each use's last instruction in the block, for x86_dead
    var last: Map[Int, Int] = {}
    for (i, inst) in g.blocks[b].insts.indexed() {
      for u in inst.us {
        last[u] = i
      }
    }
    var ii = -1
    for inst in g.blocks[b].insts {
      ii += 1
      g.x86_dead = []
      for u in inst.us {
        if u != 0 && (last.get(u) ?? -1) == ii && !lout[b].contains(u) && !g.x86_dead.contains(u) {
          g.x86_dead.push(u)
        }
      }
      if inst.kind != K_PLAIN && inst.kind != K_PMOVE {
        inv = false
      }
      if inst.x86 {
        if inst.kind == K_PLAIN {
          let (_l, i2) = x86_carry_polarity(inst.text.split("\n"), inv)
          inv = i2
        }
        out.push(inst)
        continue
      }
      if inst.kind == K_PLAIN && !inst.has_fault {
        // a carry chain: one instruction per link (x86_split)
        let parts = x86_split(inst)
        if !parts.is_empty() {
          for p in parts {
            let x = g.x86_tpl(p, [])
            if !x.err.is_empty() {
              g.skipped.push("amd64 template: ${x.err} (`${p.text}`)")
              continue
            }
            var ni = p
            let (pl, i2) = x86_carry_polarity(x.lines, inv)
            inv = i2
            ni.text = pl.join("\n")
            ni.x86 = true
            ni.early = x.early
            ni.clobbers = x.clobbers
            if !x.ties.is_empty() {
              var dsts: List[Int] = []
              var srcs: List[Src] = []
              for (di, s) in x.ties {
                dsts.push(p.defs[di])
                srcs.push(s)
                ni.us.push(p.defs[di])
              }
              out.push(Inst{kind: K_PMOVE, defs: dsts, srcs: srcs, us: src_regs(srcs), line: inst.line, inl: inst.inl, x86: true})
              // the tied source is read by the copy, not the link
              ni.us = x86_untie_recovered(ni.us, ni.text, srcs, p.defs)
            }
            out.push(ni)
          }
          continue
        }
      }
      if inst.kind == K_PLAIN || (inst.kind == K_CONDBR && !inst.text.is_empty()) {
        var conds: List[Str] = []
        if inst.kind == K_CONDBR {
          conds.push(inst.cond)
        }
        if inst.has_fault {
          conds.push(inst.fcond)
        }
        let x = g.x86_tpl(inst, conds)
        if !x.err.is_empty() {
          // every untranslated template is listed (the function is not
          // emitted), not only the first
          g.skipped.push("amd64 template: ${x.err} (`${inst.text.replace("\n", "; ").replace("\t", "")}`)")
          out.push(inst)
          continue
        }
        var ni = inst
        let (pl, i2) = x86_carry_polarity(x.lines, inv)
        inv = i2
        ni.text = pl.join("\n")
        ni.x86 = true
        ni.early = inst.early || x.early
        ni.clobbers = x.clobbers
        if inst.kind == K_CONDBR && !(inst.cond is "cbnz" | "tbz" | "tbnz") {
          ni.cond = x86_cond(inst.cond, x.kind)
          if ni.cond.is_empty() {
            g.fail("amd64: ${g.f.name}: the branch condition ${inst.cond} after a ${x.kind} compare")
            return
          }
        }
        if inst.has_fault {
          ni.fcond = x86_cond(inst.fcond, x.kind)
          if ni.fcond.is_empty() {
            g.fail("amd64: ${g.f.name}: the fault condition ${inst.fcond} after a ${x.kind} compare")
            return
          }
        }
        if !x.ties.is_empty() {
          var dsts: List[Int] = []
          var srcs: List[Src] = []
          for (di, s) in x.ties {
            dsts.push(inst.defs[di])
            srcs.push(s)
            // the definition is read too
            ni.us.push(inst.defs[di])
          }
          out.push(Inst{kind: K_PMOVE, defs: dsts, srcs: srcs, us: src_regs(srcs), line: inst.line, inl: inst.inl, x86: true})
          if !inst.has_fault || !inst.recover.is_empty() {
            // a checked add, sub, or neg whose fault stub recomputes the
            // operand from the result (x86_recover_operand): the tied
            // operand need not live past the copy, so the copy can be
            // coalesced away (2026-10-17: collatz's step was a copy, the
            // add, and a copy back). Without a fault the tied source is
            // read by the copy alone: listed as the operation's use too, it
            // lived past the copy and no tie coalesced (2026-10-17: nbody's
            // floating point, a movapd before each operation)
            ni.us = x86_untie_recovered(ni.us, ni.text, srcs, inst.defs)
          }
        }
        if inst.kind == K_PLAIN && !inst.has_fault {
          g.x86_fuse_load(out, ni)
        }
        out.push(ni)
        continue
      }
      var ni = inst
      ni.x86 = true
      if inst.kind == K_CALL && inst.svc {
        // the system call's locations (x86_call_locs)
        ni.vfix = -2
      }
      if inst.kind == K_SWITCH {
        // the table's base (x86_emit_switch)
        ni.clobbers = [10]
      }
      out.push(ni)
    }
    g.blocks[b].insts = out
  }
}

/// Adds an instruction with an x86 template defining one integer word
/// (the front half's x86 forms, decision 0254).
fn (var g: G) x86_def1(text: Str, us: List[Int]) -> Int {
  let d = g.new_vreg(false)
  var rs: List[Int] = []
  for u in us {
    rs.push(g.real(u))
  }
  let _i = g.add(Inst{kind: K_PLAIN, text: text, defs: [d], us: rs, x86: true})
  d
}

/// An offset that is i + c with c a 32 bit constant (an unchecked add:
/// rt.int_wrap's, or the SSA's add of no position), as (i, c), for x86's
/// displacement; None for another.
fn (var g: G) x86_disp(off: Int) -> (Int, Int)? {
  let y = g.f.values[off]
  if y.op == ssa.Op.Call && aux_str(y.aux) == "rt.int_wrap" && y.args.len() == 3 {
    let (op, ok) = g.const_int(y.args[0])
    if ok && op == 0 {
      for j in [2, 1] {
        let (c, cc) = g.const_int(y.args[j])
        if cc && imm32(c) {
          return Some((y.args[3 - j], c))
        }
      }
    }
    return None
  }
  if y.op == ssa.Op.Add && y.pos.is_empty() && g.kind(y.ty) == ssa.Kind.Int {
    for j in [1, 0] {
      let (c, cc) = g.const_int(y.args[j])
      if cc && imm32(c) {
        return Some((y.args[1 - j], c))
      }
    }
  }
  None
}

/// x86_def1 with n definitions.
fn (var g: G) x86_defs(text: Str, n: Int, us: List[Int]) -> List[Int] {
  var ds: List[Int] = []
  for _ in 0..n {
    ds.push(g.new_vreg(false))
  }
  var rs: List[Int] = []
  for u in us {
    rs.push(g.real(u))
  }
  let _i = g.add(Inst{kind: K_PLAIN, text: text, defs: ds, us: rs, x86: true})
  ds
}

/// An x86 template that writes memory and defines nothing (g.store's).
fn (var g: G) x86_store(text: Str, us: List[Int]) {
  var rs: List[Int] = []
  for u in us {
    rs.push(g.real(u))
  }
  let _i = g.add(Inst{kind: K_PLAIN, text: text, us: rs, x86: true})
  g.clobber()
}

/// rt.bytes_eq16 and rt.bytes_high16 on x86_64 (SSE2): the 16 bytes at
/// $u0 + $u1 compared, narrowed to 4 bits a byte as arm64's shrn does (the
/// contract std/native/llrt/scan.xo reads).
fn (var g: G) x86_bytes16(x: ssa.Value, var us: List[Int]) -> Int {
  var cmp: List[Str] = []
  if aux_str(x.aux) == "rt.bytes_eq16" {
    let (c, ok) = g.const_int(x.args[2])
    if ok {
      cmp.push("movl $${(c & 255) * 16843009}, %r11d")
    } else {
      cmp.push("movzbl $bu2, %r11d")
      cmp.push("imull $16843009, %r11d, %r11d")
      us.push(g.word(x.args[2]))
    }
    cmp = cmp + ["movd %r11d, %xmm14", "pshufd $0, %xmm14, %xmm14", "pcmpeqb %xmm14, %xmm15"]
  } else {
    cmp = ["pxor %xmm14, %xmm14", "pcmpgtb %xmm15, %xmm14", "movdqa %xmm14, %xmm15"]
  }
  let t = ["movdqu ($u0,$u1), %xmm15"] + cmp + ["psrlw $4, %xmm15", "pcmpeqw %xmm14, %xmm14", "psrlw $8, %xmm14", "pand %xmm14, %xmm15", "packuswb %xmm15, %xmm15", "movq %xmm15, $d0"]
  g.x86_def1(t.join("\n"), us)
}

/// A carry chain (adds, adcs, adc, subs, the carry's setup by cmp, and a
/// cset of the carry) cut into one instruction per line, each with its
/// own definition and uses, so each link ties its definition to its
/// first source: as one template every definition would be written early
/// (none sharing a register with any use), more registers than x86 has
/// for the long chains of x25519 and nistec. The flags pass from one
/// instruction to the next (nothing between them writes flags: the
/// parallel moves of the ties and the spill code are moves). Empty when
/// inst is not such a chain.
fn x86_split(inst: Inst) -> List[Inst] {
  let lines = inst.text.replace("\n\t", "\n").split("\n")
  if lines.len() < 2 {
    return []
  }
  var has_adc = false
  for l in lines {
    let m = l.split(" ")[0]
    if !(m is "adds" | "adcs" | "adc" | "subs" | "sbcs" | "sbc" | "cmp" | "cmn" | "cset") {
      return []
    }
    has_adc = has_adc || m is "adcs" | "adc" | "sbcs" | "sbc"
    if m == "cmp" && !(l.ends_with(", #1") || l == "cmp xzr, xzr") {
      return []
    }
    if m == "cmn" && l != "cmn xzr, xzr" {
      return []
    }
    if m == "cset" && !(l.ends_with(", cs") || l.ends_with(", cc")) {
      return []
    }
  }
  if !has_adc {
    return []
  }
  var sub = false
  for l in lines {
    sub = sub || l.starts_with("subs ") || l.starts_with("sbcs ") || l.starts_with("sbc ")
  }
  var out: List[Inst] = []
  for (li, l) in lines.indexed() {
    // the line's operands renumbered: its defs from 0, its uses from 0
    var defs: List[Int] = []
    var us: List[Int] = []
    var dmap: Map[Int, Int] = {}
    var umap: Map[Int, Int] = {}
    var t = StrBuilder.new()
    let lb = l.bytes()
    var i = 0
    var from = 0
    while i < lb.len() {
      if lb[i] != '$' {
        i += 1
        continue
      }
      var j = i + 1
      var w = ""
      if j < lb.len() && lb[j] == 'w' {
        w = "w"
        j += 1
      }
      if j >= lb.len() || !(lb[j] == 'u' || lb[j] == 'd') {
        i += 1
        continue
      }
      let isu = lb[j] == 'u'
      let (k, end) = operand_num(lb, j + 1)
      t.write(l[from..i])
      if isu {
        if !umap.contains(k) {
          umap[k] = us.len()
          us.push(inst.us[k])
        }
        t.write("$${w}u${umap.get(k) ?? 0}")
      } else {
        if !dmap.contains(k) {
          dmap[k] = defs.len()
          defs.push(inst.defs[k])
        }
        t.write("$${w}d${dmap.get(k) ?? 0}")
      }
      i = end
      from = i
    }
    t.write(l[from..lb.len()])
    var text = t.freeze()
    if text.starts_with("cmp ") || text.starts_with("cmn ") {
      // the carry's setup, which depends on the instruction after it
      let nx = if li + 1 < lines.len() { lines[li + 1] } else { "" }
      let k = if nx.starts_with("sbc") { "sbc" } else { "adc" }
      text = "x86setup ${k}, ${text.replace(" ", ", ").replace(",,", ",")}"
    } else if text.starts_with("cset ") {
      // the carry of the chain's adds and adcs, or its borrow
      text = "x86kind ${if sub { "sub" } else { "add" }}\n${text}"
    }
    out.push(Inst{kind: K_PLAIN, text: text, defs: defs, us: us, line: inst.line, inl: inst.inl, keep: inst.keep})
  }
  out
}

/// Carries ARM's C flag through x86 lines (decision 0254): arm64 has one
/// carry, which adcs reads as a carry and sbcs as a carry too (a + ~b +
/// C), while x86's CF is the carry after add and adc but the borrow (not
/// C) after sub, sbb, cmp and neg. inv says CF holds not C on entry; an
/// adc reading an inverted CF, or an sbb reading a plain one, gets a cmc
/// before it. The lines and inv after them.
fn x86_carry_polarity(lines: List[Str], inv0: Bool) -> (List[Str], Bool) {
  var out: List[Str] = []
  var inv = inv0
  for l in lines {
    let m = l.split(" ")[0]
    if m.starts_with("adc") {
      if inv {
        out.push("cmc")
      }
      inv = false
    } else if m.starts_with("sbb") {
      if !inv {
        out.push("cmc")
      }
      inv = true
    } else if m.starts_with("add") || m.starts_with("lock") || m == "clc" || m == "stc" || m == "btq" {
      // an add's CF is C; the setups (x86_carry_setup) set CF for the
      // instruction after them, whose polarity they already took (a cmc
      // there when it is an sbb)
      inv = false
    } else if m == "cmc" {
      inv = !inv
    } else if m.starts_with("sub") || m.starts_with("cmp") || m.starts_with("neg") {
      inv = true
    }
    out.push(l)
  }
  (out, inv)
}

/// The uses of a checked instruction without its tie sources (srcs)
/// wherever its x86 template does not name them: the template and fault
/// arguments' occurrences become 0 (no register).
fn x86_untie_recovered(us: List[Int], text: Str, srcs: List[Src], defs: List[Int]) -> List[Int] {
  var out = us
  let tb = text.bytes()
  var named: List[Bool] = []
  for _ in 0..us.len() {
    named.push(false)
  }
  var i = 0
  while i < tb.len() {
    if tb[i] == '$' {
      let (_, ud, k, end) = x86_operand(tb, i)
      if k >= 0 && ud == Int('u') && k < named.len() {
        named[k] = true
      }
      i = if end > i { end } else { i + 1 }
      continue
    }
    i += 1
  }
  for s in srcs {
    // a source that is also the definition (`p = p + k`, the MIR not
    // SSA) keeps its uses: they are the tie's read of the old value
    if s.kind != S_REG || s.v == 0 || defs.contains(s.v) {
      continue
    }
    for k in 0..out.len() {
      if out[k] == s.v && !named[k] {
        out[k] = 0
      }
    }
  }
  out
}

/// The registers a parallel move reads (its uses, as isel.xo pmove_srcs
/// lists them: liveness reads uses, not sources).
fn src_regs(srcs: List[Src]) -> List[Int] {
  var us: List[Int] = []
  for a in srcs {
    if a.kind == S_REG && a.v != 0 {
      us.push(a.v)
    }
  }
  us
}

/// Whether x86 operation op commutes (its two operands exchangeable).
fn x86_commutes(op: Str) -> Bool {
  op is "addq" | "addl" | "imulq" | "imull" | "andq" | "andl" | "orq" | "orl" | "xorq" | "xorl" | "addsd" | "mulsd"
}

/// The registers live out of each block (by block index), the arm64
/// MIR's (regalloc.xo's liveness, before the translation).
fn (var g: G) x86_live_out() -> List[List[Int]] {
  g.x86_live().outs
}

/// The registers live into and out of each block (by block index).
fn (var g: G) x86_live() -> Live {
  let order = g.hot + g.cold
  let n = g.fp.len()
  var idx: List[Int] = []
  for _ in 0..g.blocks.len() {
    idx.push(-1)
  }
  for (k, b) in order.indexed() {
    idx[b] = k
  }
  var gens: List[List[Int]] = []
  var kills: List[List[Int]] = []
  var succs: List[List[Int]] = []
  var kst: List[Int] = List.with_capacity(n)
  var ust: List[Int] = List.with_capacity(n)
  for _ in 0..n {
    kst.push(0)
    ust.push(0)
  }
  for k in 0..order.len() {
    let b = order[k]
    var gl: List[Int] = []
    var kl: List[Int] = []
    gen_kill(g.blocks[b].insts, k + 1, gl, kl, kst, ust)
    gens.push(gl)
    kills.push(kl)
    var ss: List[Int] = []
    for t in g.msuccs(b) {
      if idx[t] >= 0 {
        ss.push(idx[t])
      }
    }
    succs.push(ss)
  }
  let lv = solve_live(succs, gens, kills, n)
  var ins: List[List[Int]] = []
  var out: List[List[Int]] = []
  for _ in 0..g.blocks.len() {
    ins.push([])
    out.push([])
  }
  for (k, b) in order.indexed() {
    ins[b] = lv.ins[k]
    out[b] = lv.outs[k]
  }
  Live{ins: ins, outs: out}
}

/// Load-op fusion: when ni is one two operand line `OP $uK, $d0` whose
/// source K dies there and the instruction before it (past a tie's move)
/// is the plain load of that register at the operation's width, the load
/// becomes ni's memory operand and is dropped from out (its address
/// registers become ni's uses).
fn (var g: G) x86_fuse_load(var out: List[Inst], var ni: Inst) {
  if ni.text.contains("\n") || out.is_empty() {
    return
  }
  let sp = ni.text.find(" ") ?? -1
  if sp < 0 {
    return
  }
  let op = ni.text[0..sp]
  if !(op is "addq" | "addl" | "subq" | "subl" | "andq" | "andl" | "orq" | "orl" | "xorq" | "xorl" | "imulq" | "imull" | "addsd" | "subsd" | "mulsd" | "divsd") {
    return
  }
  let ops = x86_ops(ni.text[sp + 1..ni.text.len()])
  if ops.len() != 2 || !ops[1].starts_with("$") {
    return
  }
  let (bb, _) = tpl_ref(ops[0])
  if !bb.starts_with("u") {
    return
  }
  let k = Int.parse(bb[1..bb.len()]) ?? -1
  if k < 0 || k >= ni.us.len() {
    return
  }
  let x = ni.us[k]
  if x == 0 || !g.x86_dead.contains(x) {
    return
  }
  // the load of x earlier in the block: past instructions that neither
  // touch memory (no operand in parentheses, no call), nor read x, nor
  // define a register (the load's address registers must keep their
  // values; a definition between is allowed only when the load's uses
  // do not include it, checked below)
  var li = out.len() - 1
  var between: List[Int] = []
  while li >= 0 {
    let o = out[li]
    if o.kind == K_PLAIN && o.defs.len() == 1 && o.defs[0] == x {
      break
    }
    if o.kind != K_PLAIN && o.kind != K_PMOVE {
      return
    }
    if o.us.contains(x) || o.has_fault || o.keep || o.text.contains("(") || o.text.contains("call") || o.text.contains("lock") || o.text.contains("xchg") {
      return
    }
    for d in o.defs {
      between.push(d)
    }
    li -= 1
  }
  if li < 0 {
    return
  }
  let ld = out[li]
  if ld.kind != K_PLAIN || ld.has_fault || ld.keep || ld.defs.len() != 1 || ld.defs[0] != x || ld.text.contains("\n") {
    return
  }
  for u in ld.us {
    if between.contains(u) {
      return
    }
  }
  let lsp = ld.text.find(" ") ?? -1
  if lsp < 0 {
    return
  }
  let lop = ld.text[0..lsp]
  let width_ok = (lop == "movq" && op.ends_with("q")) || (lop == "movl" && op.ends_with("l")) || (lop == "movsd" && op.ends_with("sd"))
  if !width_ok {
    return
  }
  let lops = x86_ops(ld.text[lsp + 1..ld.text.len()])
  if lops.len() != 2 || !lops[0].contains("(") || lops[0].contains("%r11") {
    return
  }
  // the load's address, its uses renumbered past ni's
  let base = ni.us.len()
  var mem = StrBuilder.new()
  let mb = lops[0].bytes()
  var i = 0
  var from = 0
  while i < mb.len() {
    if mb[i] == '$' {
      let (w, ud, kk, end) = x86_operand(mb, i)
      if kk >= 0 && ud == Int('u') {
        mem.write(lops[0][from..i])
        mem.write("$${w}u${base + kk}")
        i = end
        from = i
        continue
      }
    }
    i += 1
  }
  mem.write(lops[0][from..mb.len()])
  ni.text = "${op} ${mem.freeze()}, ${ops[1]}"
  // the fused register is no longer read
  ni.us[k] = 0
  for u in ld.us {
    ni.us.push(u)
  }
  out = out[0..li] + out[li + 1..out.len()]
}

/// Merges each block into its predecessor when that is its one
/// predecessor and ends in a jump to it (the SSA's blocks between bounds
/// checks, which are inline fault stubs here): a load and its use meet in
/// one block for x86_fuse_load, and the layout has fewer labels. Never
/// the entry, a landing pad, or a block of the other temperature. A jump
/// that also names landing pads (for liveness, decision 0085; each its
/// own edge block) merges only with a block that ends in a jump and has
/// every value those pads need live out already, and the merged jump
/// names both blocks' pads: no value lives longer (with longer lives,
/// interp spilled twice as often, 10% more instructions).
fn (var g: G) x86_merge_blocks() {
  let n = g.blocks.len()
  var npred: List[Int] = []
  var pinned: List[Bool] = []
  var cold: List[Bool] = []
  var merged: List[Bool] = []
  for _ in 0..n {
    npred.push(0)
    pinned.push(false)
    cold.push(false)
    merged.push(false)
  }
  for b in g.cold {
    cold[b] = true
  }
  for b in g.hot + g.cold {
    for t in g.msuccs(b) {
      npred[t] = npred[t] + 1
    }
    for inst in g.blocks[b].insts {
      if inst.pad >= 0 {
        pinned[inst.pad] = true
      }
      if inst.kind == K_JUMP && inst.targets.len() > 1 {
        for t in inst.targets[1..inst.targets.len()] {
          pinned[t] = true
        }
      }
    }
  }
  if !g.hot.is_empty() {
    pinned[g.hot[0]] = true
  }
  let lv = g.x86_live()
  for b in g.hot + g.cold {
    if merged[b] {
      continue
    }
    while true {
      let k = g.term_kind(b)
      if k != K_JUMP {
        break
      }
      let last = g.blocks[b].insts[g.blocks[b].insts.len() - 1]
      let t = last.targets[0]
      if t == b || pinned[t] || npred[t] != 1 || merged[t] || cold[t] != cold[b] {
        break
      }
      let pads = last.targets[1..last.targets.len()]
      if !pads.is_empty() {
        // the same pads past their empty edge blocks: no longer lives
        if g.term_kind(t) != K_JUMP {
          break
        }
        var out: Map[Int, Bool] = {}
        for r in lv.outs[t] {
          out[r] = true
        }
        var covered = true
        for p in pads {
          for r in lv.ins[p] {
            covered = covered && out.contains(r)
          }
        }
        if !covered {
          break
        }
      }
      var ins = g.take_insts(b)
      let _j = ins.pop()
      for x in g.blocks[t].insts {
        ins.push(x)
      }
      if !pads.is_empty() {
        let li = ins.len() - 1
        var ts = ins[li].targets
        for p in pads {
          if !ts.contains(p) {
            ts.push(p)
          }
        }
        ins[li].targets = ts
      }
      g.put_insts(b, ins)
      g.blocks[t].insts = []
      merged[t] = true
    }
  }
  var hot: List[Int] = []
  for b in g.hot {
    if !merged[b] {
      hot.push(b)
    }
  }
  var cl: List[Int] = []
  for b in g.cold {
    if !merged[b] {
      cl.push(b)
    }
  }
  g.hot = hot
  g.cold = cl
}

/// Whether an x86 template's lines write no flags (moves, loads and
/// stores, lea, push and pop) and read none.
fn x86_flag_neutral(inst: Inst) -> Bool {
  if inst.kind == K_PMOVE {
    return true
  }
  if inst.kind != K_PLAIN || !inst.x86 || inst.has_fault {
    return false
  }
  for l in inst.text.split("\n") {
    let m = l.trim().split(" ")[0]
    if !(m.starts_with("mov") || m.starts_with("lea") || m.starts_with("push") || m.starts_with("pop")) {
      return false
    }
  }
  true
}

/// Whether x86 lines read the flags (adc, sbb, cmov, set, cmc).
fn x86_lines_read_flags(text: Str) -> Bool {
  for l in text.split("\n") {
    let m = l.trim().split(" ")[0]
    if m.starts_with("adc") || m.starts_with("sbb") || m.starts_with("cmov") || m.starts_with("set") || m == "cmc" {
      return true
    }
  }
  false
}

/// Whether an x86 template reads the flags.
fn x86_reads_flags(inst: Inst) -> Bool {
  inst.kind == K_PLAIN && inst.x86 && x86_lines_read_flags(inst.text)
}

/// The lines of a carry's save at the end of a template, for its last
/// definition N: `setb $bdN` and `movzbl $bdN, $wdN` (cset cs after an
/// add); "" when the template does not end so.
fn x86_save_tail(inst: Inst) -> Str {
  let n = inst.defs.len() - 1
  if n < 0 {
    return ""
  }
  let tail = "setb $bd${n}\nmovzbl $bd${n}, $wd${n}"
  if inst.text == tail || inst.text.ends_with("\n" + tail) {
    return tail
  }
  ""
}

/// Whether an x86 template may move across flag writers and readers: it
/// reads no flags (no adc, sbb, cmov, set, jcc, cmc).
fn x86_movable(inst: Inst) -> Bool {
  if inst.kind != K_PLAIN || !inst.x86 || inst.has_fault || inst.keep || inst.frame {
    return false
  }
  for l in inst.text.split("\n") {
    let m = l.trim().split(" ")[0]
    if m.is_empty() || m.ends_with(":") || m.starts_with("adc") || m.starts_with("sbb") || m.starts_with("cmov") || m.starts_with("set") || m.starts_with("j") || m == "cmc" || m == "stc" || m == "clc" {
      return false
    }
  }
  true
}

/// A product's two halves in one mulq (2026-10-19: x25519's fe64_mul
/// made each of its 16 products' low half with imulq and its high half
/// with another mulq, 224 instructions to LLVM's one mulq a product):
/// a block's `mul` (the low half, rt.int_wrap) and `umulh` (the high
/// half, rt.u64_mul_hi) of the same two operands, in either order,
/// become one x86 template at the first of them that defines both from
/// rax and rdx. Its clobbers keep every value out of rax and rdx there
/// (regalloc.xo). The second instruction goes; both wrote the flags, so
/// nothing that reads them moves past a new writer.
fn (var g: G) x86_mul_pair() {
  for b in 0..g.blocks.len() {
    var ins = g.take_insts(b)
    var gone: List[Bool] = []
    for _ in 0..ins.len() {
      gone.push(false)
    }
    var i = 0
    while i < ins.len() {
      let lo_first = x86_mul_half(ins[i], "mul $d0, $u0, $u1")
      if !lo_first && !x86_mul_half(ins[i], "umulh $d0, $u0, $u1") {
        i += 1
        continue
      }
      let other = if lo_first { "umulh $d0, $u0, $u1" } else { "mul $d0, $u0, $u1" }
      let a = ins[i].us[0]
      let c = ins[i].us[1]
      var j = i + 1
      var found = -1
      while j < ins.len() && found < 0 {
        let y = ins[j]
        if !gone[j] && x86_mul_half(y, other) && ((y.us[0] == a && y.us[1] == c) || (y.us[0] == c && y.us[1] == a)) {
          found = j
        }
        // an operand redefined: a later product of the same names is
        // another product
        if y.defs.contains(a) || y.defs.contains(c) {
          j = ins.len()
        }
        j += 1
      }
      if found < 0 {
        i += 1
        continue
      }
      let lo = if lo_first { ins[i].defs[0] } else { ins[found].defs[0] }
      let hi = if lo_first { ins[found].defs[0] } else { ins[i].defs[0] }
      var p = ins[i]
      p.text = "movq $u0, %rax\nmulq $u1\nmovq %rax, $d0\nmovq %rdx, $d1"
      p.defs = [lo, hi]
      p.x86 = true
      p.clobbers = [XR_AX, XR_DX]
      // the factors and halves in rax and rdx where they can be (the
      // moves go): the first factor and the low half in rax, the high
      // half in rdx; the second factor not in rax (the first's move
      // writes it) unless it is the first, the low half not in rdx (the
      // high half's move reads it after)
      p.clob_mid = true
      p.reg_hints = [(0, XR_AX), (-1, XR_AX), (-2, XR_DX)]
      p.reg_bars = [(-1, XR_DX)]
      if p.us[1] != p.us[0] {
        p.reg_bars.push((1, XR_AX))
      }
      ins[i] = p
      gone[found] = true
      i += 1
    }
    var out: List[Inst] = []
    for (k, inst) in ins.indexed() {
      if !gone[k] {
        out.push(inst)
      }
    }
    g.blocks[b].insts = out
  }
}

/// Whether inst is the plain product half text (x86_mul_pair).
fn x86_mul_half(inst: Inst, text: Str) -> Bool {
  inst.kind == K_PLAIN && !inst.x86 && !inst.has_fault && inst.text == text && inst.defs.len() == 1 && inst.us.len() == 2
}

/// Constants as immediate operands (2026-10-20: arm64's MIR keeps a
/// constant past its 12 bit immediates in a register, which hoist_consts
/// moves out of the loop; x86_64 then spilled most of them, 16 in
/// portable conv's loop, each use a reload through r11): a register
/// whose one definition is a constant of 32 signed bits becomes `$N` as
/// the first operand of an add, sub, and, or, xor, cmp (a branch's too),
/// test, or mov
/// (not an instruction with a fault, whose stub reads the operands'
/// registers), and a constant left unread goes.
fn (var g: G) x86_const_imm() {
  var ndef: Map[Int, Int] = {}
  var kval: Map[Int, Int] = {}
  for b in 0..g.blocks.len() {
    for inst in g.blocks[b].insts {
      for d in inst.defs {
        ndef[d] = (ndef.get(d) ?? 0) + 1
      }
      if inst.kind == K_PLAIN && inst.x86 && inst.defs.len() == 1 && inst.us.is_empty() && !inst.has_fault {
        if let Some(n) = x86_const_def(inst.text) {
          kval[inst.defs[0]] = n
        }
      }
    }
  }
  if kval.is_empty() {
    return
  }
  var nuse: Map[Int, Int] = {}
  for b in 0..g.blocks.len() {
    var ins = g.take_insts(b)
    for k in 0..ins.len() {
      var inst = ins[k]
      // a plain line, or a branch's compare (`cmpq $u1, $u0`); with a
      // fault too: its stub reads the fault arguments (fargs, read again
      // past the template's uses), not the template's registers
      if (inst.kind == K_PLAIN || (inst.kind == K_CONDBR && !inst.text.is_empty())) && inst.x86 {
        if inst.has_fault {
          // a constant fault argument as the immediate (its register
          // need not live to the stub): the use set_fault added for it,
          // one the template does not name, goes
          for (j, a) in inst.fargs.indexed() {
            let n = if a.kind == S_REG { kval.get(a.v) ?? MIN_INT } else { MIN_INT }
            if n == MIN_INT || (ndef.get(a.v) ?? 0) != 1 {
              continue
            }
            var u = inst.us.len() - 1
            while u >= 0 && !(inst.us[u] == a.v && x86_tok_count(inst.text, "u${u}") == 0) {
              u -= 1
            }
            if u < 0 {
              continue
            }
            var us: List[Int] = []
            for (i, w) in inst.us.indexed() {
              if i != u {
                us.push(w)
              }
            }
            var text = inst.text
            for i in u + 1..inst.us.len() {
              text = x86_tok_rename(text, i, i - 1)
            }
            inst.text = text
            inst.us = us
            inst.reg_hints = x86_drop_use(inst.reg_hints, u)
            inst.reg_bars = x86_drop_use(inst.reg_bars, u)
            inst.fargs[j] = Src{kind: S_IMM, imm: n}
          }
        }
        var again = true
        while again {
          again = false
          for (u, v) in inst.us.indexed() {
            let n = kval.get(v) ?? MIN_INT
            if n == MIN_INT || (ndef.get(v) ?? 0) != 1 || !imm32(n) {
              continue
            }
            let t = x86_imm_into(inst.text, u, n)
            if t.is_empty() {
              continue
            }
            var us: List[Int] = []
            for (j, w) in inst.us.indexed() {
              if j != u {
                us.push(w)
              }
            }
            var text = t
            for j in u + 1..inst.us.len() {
              text = x86_tok_rename(text, j, j - 1)
            }
            inst.text = text
            inst.us = us
            inst.reg_hints = x86_drop_use(inst.reg_hints, u)
            inst.reg_bars = x86_drop_use(inst.reg_bars, u)
            if inst.clobbers.contains(XR_CX) && !text.contains("%cl") && !text.contains("%rcx") && !text.contains("%ecx") && !text.contains("%cx") {
              // a shift by an immediate needs no rcx
              var cs: List[Int] = []
              for r in inst.clobbers {
                if r != XR_CX {
                  cs.push(r)
                }
              }
              inst.clobbers = cs
            }
            again = true
            break
          }
        }
        ins[k] = inst
      }
      if ins[k].kind == K_PMOVE && ins[k].x86 {
        // a constant copied (a loop variable's start, 2026-10-20: portable
        // conv's h = 0 went `pushq 144(%rsp)`, `popq 24(%rsp)` from the
        // hoisted zero's slot): the move writes the immediate
        var p = ins[k]
        var changed = false
        for (j, a) in p.srcs.indexed() {
          let n = if a.kind == S_REG { kval.get(a.v) ?? MIN_INT } else { MIN_INT }
          if n != MIN_INT && (ndef.get(a.v) ?? 0) == 1 && imm32(n) && !g.fp[p.defs[j]] {
            p.srcs[j] = Src{kind: S_IMM, imm: n}
            changed = true
          }
        }
        if changed {
          p.us = src_regs(p.srcs)
          ins[k] = p
        }
      }
      for u in ins[k].us {
        nuse[u] = (nuse.get(u) ?? 0) + 1
      }
      // a call's arguments and a fault's (not in us)
      for sr in ins[k].srcs + ins[k].fargs {
        if sr.kind == S_REG {
          nuse[sr.v] = (nuse.get(sr.v) ?? 0) + 1
        }
      }
    }
    g.put_insts(b, ins)
  }
  // the constants no instruction reads any more
  for b in 0..g.blocks.len() {
    var ins = g.take_insts(b)
    var out: List[Inst] = List.with_capacity(ins.len())
    for inst in ins {
      if inst.kind == K_PLAIN && inst.x86 && inst.defs.len() == 1 && inst.us.is_empty() && kval.contains(inst.defs[0]) && (nuse.get(inst.defs[0]) ?? 0) == 0 && (ndef.get(inst.defs[0]) ?? 0) == 1 {
        continue
      }
      out.push(inst)
    }
    g.put_insts(b, out)
  }
}

/// Inst.reg_hints or reg_bars with use u gone (the uses past it one
/// lower).
fn x86_drop_use(l: List[(Int, Int)], u: Int) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  for (k, r) in l {
    if k == u {
      continue
    }
    out.push((if k > u { k - 1 } else { k }, r))
  }
  out
}

/// The constant a one line `movl $N, $wd0`, `movq $N, $d0`, or `movabsq
/// $N, $d0` writes.
fn x86_const_def(text: Str) -> Int? {
  if text.contains("\n") {
    return None
  }
  for (p, tail) in [("movl $", ", $wd0"), ("movq $", ", $d0"), ("movabsq $", ", $d0")] {
    if text.starts_with(p) && text.ends_with(tail) {
      let s = text[p.len()..text.len() - tail.len()]
      if is_signed_digits(s) {
        return Int.parse(s)
      }
    }
  }
  None
}

/// text with its one read of use K, the first operand of an add, sub,
/// and, or, xor, cmp, test, or mov line (`$uK`, or `$wuK` in a 32 bit
/// one), made the immediate `$N`; "" when it cannot be.
fn x86_imm_into(text: Str, k: Int, n: Int) -> Str {
  let ls = text.split("\n")
  var at = -1
  for (i, l) in ls.indexed() {
    let c = x86_tok_count(l, "u${k}")
    if c > 1 || (c == 1 && at >= 0) {
      return ""
    }
    if c == 1 {
      at = i
    }
  }
  if at < 0 {
    return ""
  }
  let l = ls[at]
  let sp = l.find(" ") ?? -1
  if sp < 0 {
    return ""
  }
  let op = l[0..sp]
  // an add as lea: `leaq ($uA,$uK), D` or `leaq ($uK,$uA), D` is
  // `leaq N($uA), D`
  if op is "leaq" | "leal" {
    let rest = l[sp + 1..l.len()]
    let w = if op == "leal" { "$wu" } else { "$u" }
    let tk = "${w}${k}"
    if rest.starts_with("(${tk},") || rest.contains(",${tk}), ") {
      let close = rest.find("), ") ?? -1
      if close < 0 || !rest.starts_with("(") {
        return ""
      }
      let inner = rest[1..close].split(",")
      if inner.len() != 2 {
        return ""
      }
      let other = if inner[0] == tk { inner[1] } else { inner[0] }
      if other == tk || !other.starts_with("$") {
        return ""
      }
      var out = ls
      out[at] = "${op} ${n}(${other})${rest[close + 1..rest.len()]}"
      return out.join("\n")
    }
    return ""
  }
  // msub and madd's product into the scratch register: `imulq $uK,
  // %r11` is `imulq $N, %r11, %r11` (r11 the source too: an allocated
  // operand there was a spilled one's slot the emitter wrote as `$0`,
  // and the HTTP server's http.match_parts read address 0, 2026-10-20)
  if op == "imulq" && l == "imulq $u${k}, %r11" {
    var out = ls
    out[at] = "imulq $${n}, %r11, %r11"
    return out.join("\n")
  }
  // a shift's amount moved to cl (x86_shift): each shift by cl shifts by
  // the immediate, masked as the hardware masks cl, and the move goes
  // (2026-10-20: portable shift's `ws[i] >> 8` reloaded a spilled 8 into
  // rcx every iteration)
  if l == "movq $u${k}, %rcx" {
    var out: List[Str] = []
    for (i, x) in ls.indexed() {
      if i == at {
        continue
      }
      if !x.contains("%cl") && !x.contains("%rcx") && !x.contains("%ecx") && !x.contains("%cx") {
        out.push(x)
        continue
      }
      let sp2 = x.find(" ") ?? -1
      let m = if sp2 > 0 { x[0..sp2] } else { "" }
      let base = if m.len() > 1 { m[0..m.len() - 1] } else { "" }
      if !(base is "shl" | "shr" | "sar" | "sal" | "ror" | "rol") || !(m.ends_with("q") || m.ends_with("l")) || !x.starts_with("${m} %cl, ") || x["${m} %cl, ".len()..x.len()].contains("%cl") || x.contains("%rcx") || x.contains("%ecx") {
        return ""
      }
      let amt = n & (if m.ends_with("q") { 63 } else { 31 })
      out.push("${m} $${amt}, ${x["${m} %cl, ".len()..x.len()]}")
    }
    return out.join("\n")
  }
  if !(op is "addq" | "subq" | "andq" | "orq" | "xorq" | "cmpq" | "testq" | "movq" | "addl" | "subl" | "andl" | "orl" | "xorl" | "cmpl" | "testl" | "movl") {
    return ""
  }
  let rest = l[sp + 1..l.len()]
  var tok = ""
  for t in ["$u${k}, ", "$wu${k}, "] {
    if rest.starts_with(t) {
      tok = t
    }
  }
  if tok.is_empty() || (op.ends_with("l") && tok.starts_with("$u")) || (op.ends_with("q") && tok.starts_with("$wu")) {
    return ""
  }
  // a mov's immediate goes only to memory or a general register (an
  // xmm destination has no immediate form, and an allocated one may be
  // a float's: `movq $1, %xmm14` loaded from address 1, 2026-10-20)
  let dst = rest[tok.len()..rest.len()]
  if op.starts_with("mov") && !(dst.contains("(") || dst.starts_with("%r") || dst.starts_with("%e")) {
    return ""
  }
  var out = ls
  out[at] = "${op} $${n}, ${rest[tok.len()..rest.len()]}"
  out.join("\n")
}

/// text with use token j (`$uJ`, `$wuJ`, ...: "uJ" not followed by a
/// digit) renumbered to i.
fn x86_tok_rename(text: Str, j: Int, i: Int) -> Str {
  let from = "u${j}"
  var out = ""
  var p = 0
  while p < text.len() {
    let q = text[p..text.len()].find(from) ?? -1
    if q < 0 {
      out = out + text[p..text.len()]
      break
    }
    let s = p + q
    let e = s + from.len()
    let prev_ok = s > 0 && (text[s - 1..s] == "$" || text[s - 1..s] == "w" || text[s - 1..s] == "b" || text[s - 1..s] == "h")
    if prev_ok && (e >= text.len() || !is_digits(text[e..e + 1])) {
      out = out + text[p..s] + "u${i}"
    } else {
      out = out + text[p..e]
    }
    p = e
  }
  out
}

/// Loads moved down to just before the first instruction of their block
/// that reads them (2026-10-20: bigmod.mac_row loads a 4 word round's
/// eight words first, which suits arm64's load pairs, and x86_64's 13
/// registers spilled src, k, and three words: 66 instructions a round,
/// 55 with the loads where they are read). A one line load (movq, movl,
/// movzbl, movzwl) passes instructions that neither write memory nor
/// define its base or index, and stores through the same base and index
/// to bytes it does not read; it stops at anything else (a call, a
/// store elsewhere, a load or store that may fault is not one).
fn (var g: G) x86_sink_loads() {
  for b in 0..g.blocks.len() {
    var ins = g.take_insts(b)
    // last to first: a load moves down once, past instructions already
    // placed (first to first, two loads read by one instruction passed
    // each other forever: a build of bench/perf/rsa hung, 2026-10-20)
    var k = ins.len() - 1
    while k >= 0 {
      let (ok, lm, lw) = x86_sink_load(ins[k])
      if !ok {
        k -= 1
        continue
      }
      let d = ins[k].defs[0]
      var at = -1
      var m = k + 1
      // within X86_SINK_REACH instructions (a block of thousands, a
      // generated table, stays linear)
      while m < ins.len() && m - k <= X86_SINK_REACH {
        let c = ins[m]
        if c.us.contains(d) {
          at = m
          break
        }
        if c.kind != K_PLAIN && c.kind != K_PMOVE {
          break
        }
        var redef = false
        for u in ins[k].us {
          redef = redef || c.defs.contains(u)
        }
        if redef || c.defs.contains(d) {
          break
        }
        if x86_may_write_mem(c) && !x86_store_apart(c, lm, lw, ins[k]) {
          break
        }
        m += 1
      }
      if at > k + 1 {
        let l = ins[k]
        var out: List[Inst] = List.with_capacity(ins.len())
        for (i, x) in ins.indexed() {
          if i == at {
            out.push(l)
          }
          if i != k {
            out.push(x)
          }
        }
        ins = out
      }
      k -= 1
    }
    g.put_insts(b, ins)
  }
}

/// How far past a load x86_sink_loads looks for its first read.
const X86_SINK_REACH = 256

/// Whether inst is a load x86_sink_loads moves: its memory operand
/// (`D($uA)`, `D($uA,$uB)`, `D($uA,$uB,S)`) and width.
fn x86_sink_load(inst: Inst) -> (Bool, Str, Int) {
  let bad = (false, "", 0)
  if inst.kind != K_PLAIN || !inst.x86 || inst.has_fault || !inst.recover.is_empty() || inst.early || inst.defs.len() != 1 || inst.text.contains("\n") || !inst.text.ends_with(", $d0") {
    return bad
  }
  let sp = inst.text.find(" ") ?? -1
  if sp < 0 {
    return bad
  }
  let op = inst.text[0..sp]
  let w = match op {
    "movq" => 8
    "movl" => 4
    "movzwl" => 2
    "movzbl" => 1
    _ => 0
  }
  let mem = inst.text[sp + 1..inst.text.len() - ", $d0".len()]
  if w == 0 || !mem.contains("(") || mem.contains("%") || mem.contains("$OUT") {
    return bad
  }
  (true, mem, w)
}

/// Whether store c (one line `movX SRC, MEM`) writes only bytes apart
/// from load l's (memory operand lm, width lw): the same base and index
/// registers and scale, the displacements' byte ranges apart.
fn x86_store_apart(c: Inst, lm: Str, lw: Int, l: Inst) -> Bool {
  if c.kind != K_PLAIN || !c.x86 || c.has_fault || !c.recover.is_empty() || c.text.contains("\n") {
    return false
  }
  let sp = c.text.find(" ") ?? -1
  if sp < 0 {
    return false
  }
  let w = match c.text[0..sp] {
    "movq" => 8
    "movl" => 4
    "movw" => 2
    "movb" => 1
    _ => 0
  }
  let parts = c.text[sp + 1..c.text.len()].split(", ")
  if w == 0 || parts.len() != 2 || parts[0].contains("(") {
    return false
  }
  let (sd, sr, sok) = x86_sink_mem(parts[1], c.us)
  let (ld, lr, lok) = x86_sink_mem(lm, l.us)
  if !sok || !lok || sr != lr {
    return false
  }
  sd + w <= ld || ld + lw <= sd
}

/// A memory operand's displacement and its registers and scale as
/// "base,index,scale" of vreg numbers (us maps `$uK`).
fn x86_sink_mem(m: Str, us: List[Int]) -> (Int, Str, Bool) {
  let bad = (0, "", false)
  let open = m.find("(") ?? -1
  if open < 0 || !m.ends_with(")") {
    return bad
  }
  let ds = m[0..open]
  let disp = if ds.is_empty() { 0 } else { Int.parse(ds) ?? -999999999 }
  if disp == -999999999 {
    return bad
  }
  var regs: List[Str] = []
  for (i, p) in m[open + 1..m.len() - 1].split(",").indexed() {
    if i < 2 {
      if !p.starts_with("$u") {
        return bad
      }
      let j = Int.parse(p[2..p.len()]) ?? -1
      if j < 0 || j >= us.len() {
        return bad
      }
      regs.push("${us[j]}")
    } else {
      regs.push(p)
    }
  }
  (disp, regs.join(","), true)
}

/// Loads folded into the instructions that read them (2026-10-19: x86
/// arithmetic takes a memory source, `addq 8(%rdx), %r9`, where the
/// retargeted arm64 MIR loads every word into a register first; with 8
/// caller saved registers x25519's fe64_add held 9 values and saved rbx,
/// a frame in a leaf). A `movq OFF($uJ), $dN` line (a ldr's, or one of
/// a ldp's two) whose definition is read only later in the block, each
/// read the source of a line that takes a memory one (`OP $uK, REG` for
/// add, sub, adc, sbb, and, or, xor, imul, cmp, test, mov, or `mulq
/// $uK`), becomes that source in each, `OP OFF($uK), REG` with use K the
/// load's base, and the line goes: a word read four times (fe64_mul's
/// limbs, each a mulq's rax) no longer takes a register or a spill slot.
/// Not past a call, a store, or anything else that may write memory, nor
/// past a definition of the base; not into an instruction with a fault
/// (its stub reads the operands' registers).
fn (var g: G) x86_fold_loads() {
  var nuse: Map[Int, Int] = {}
  var ndef: Map[Int, Int] = {}
  for b in g.hot + g.cold {
    for inst in g.blocks[b].insts {
      for u in inst.us {
        nuse[u] = (nuse.get(u) ?? 0) + 1
      }
      for d in inst.defs {
        ndef[d] = (ndef.get(d) ?? 0) + 1
      }
    }
  }
  for b in 0..g.blocks.len() {
    var ins = g.take_insts(b)
    // a loaded value -> its instruction (cand), base register (cbase),
    // the reads seen (seen) and their places, instruction * 64 + use
    // index (at); bad once one cannot take the memory operand
    var cand: Map[Int, Int] = {}
    var cbase: Map[Int, Int] = {}
    var seen: Map[Int, Int] = {}
    var at: Map[Int, List[Int]] = {}
    var bad: Map[Int, Bool] = {}
    var gone: List[Bool] = []
    for _ in 0..ins.len() {
      gone.push(false)
    }
    for k in 0..ins.len() {
      let inst = ins[k]
      let ok_inst = inst.kind == K_PLAIN && inst.x86 && !inst.has_fault && inst.recover.is_empty()
      for u in 0..inst.us.len() {
        let v = inst.us[u]
        let li = cand.get(v) ?? -1
        if li < 0 || (bad.get(v) ?? false) || g.fold_skip.contains(v) {
          continue
        }
        let (off, _j, _ok) = x86_load_line(x86_def_line(ins[li].text, ins[li].defs.index_of(v) ?? -1), ins[li].defs.index_of(v) ?? -1)
        if !ok_inst || u >= 64 || x86_fold_into(inst.text, u, off).is_empty() {
          bad[v] = true
          continue
        }
        seen[v] = (seen.get(v) ?? 0) + 1
        var l = at.get(v) ?? []
        l.push(k * 64 + u)
        at[v] = l
        if (seen.get(v) ?? 0) == (nuse.get(v) ?? 0) {
          // every read seen, each can take it: fold them all
          let n = ins[li].defs.index_of(v) ?? -1
          let (off2, j, ok2) = x86_load_line(x86_def_line(ins[li].text, n), n)
          if ok2 {
            let base = ins[li].us[j]
            if (at.get(v) ?? []).len() > 1 {
              g.fold_multi.push((v, base))
            }
            for p in at.get(v) ?? [] {
              var c = ins[p / 64]
              c.text = x86_fold_into(c.text, p % 64, off2)
              c.us[p % 64] = base
              ins[p / 64] = c
            }
            ins[li] = x86_drop_load(ins[li], n)
            if ins[li].defs.is_empty() {
              gone[li] = true
            }
          }
          cand.remove(v)
          cbase.remove(v)
        }
      }
      // what this instruction ends: memory written, a base redefined
      if x86_may_write_mem(inst) {
        cand = {}
        cbase = {}
      } else {
        for d in inst.defs {
          cand.remove(d)
          cbase.remove(d)
          var drop: List[Int] = []
          for (v, bv) in cbase.entries() {
            if bv == d {
              drop.push(v)
            }
          }
          for v in drop {
            cand.remove(v)
            cbase.remove(v)
          }
        }
      }
      // the loads it makes (read after it, in this block, once each use
      // is seen)
      if inst.kind == K_PLAIN && inst.x86 && !inst.has_fault && !inst.defs.is_empty() {
        let ls = inst.text.split("\n")
        if ls.len() == inst.defs.len() {
          for (n, d) in inst.defs.indexed() {
            let (_off, j, ok) = x86_load_line(x86_def_line(inst.text, n), n)
            if ok && !inst.defs.contains(inst.us[j]) && (ndef.get(d) ?? 0) == 1 && (nuse.get(d) ?? 0) >= 1 {
              cand[d] = k
              cbase[d] = inst.us[j]
              seen[d] = 0
              at[d] = []
              bad[d] = false
            }
          }
        }
      }
    }
    var out: List[Inst] = []
    for (k, inst) in ins.indexed() {
      if !gone[k] {
        out.push(inst)
      }
    }
    g.blocks[b].insts = out
  }
}

/// The line of text that writes `$dN` (x86_fold_loads), "" if none or
/// several.
fn x86_def_line(text: Str, n: Int) -> Str {
  var found = ""
  for l in text.split("\n") {
    if l.ends_with(", $d${n}") {
      if !found.is_empty() {
        return ""
      }
      found = l
    }
  }
  found
}

/// Whether l is `movq OFF($uJ), $dN`: OFF (with its parentheses' text
/// left out) and J.
fn x86_load_line(l: Str, n: Int) -> (Str, Int, Bool) {
  let bad = ("", 0, false)
  let tail = "), $d${n}"
  if !l.starts_with("movq ") || !l.ends_with(tail) {
    return bad
  }
  let body = l["movq ".len()..l.len() - tail.len()]
  let open = body.find("($u") ?? -1
  if open < 0 || body.contains(",") {
    return bad
  }
  let off = body[0..open]
  if !off.is_empty() && !is_signed_digits(off) {
    return bad
  }
  match Int.parse(body[open + 3..body.len()]) {
    Some(j) => (off, j, true)
    None => bad
  }
}

/// text with its one read of `$uK` as a source made the memory operand
/// OFF($uK), or "" when it cannot take one.
fn x86_fold_into(text: Str, k: Int, off: Str) -> Str {
  let tok = "$u${k}"
  let ls = text.split("\n")
  var at = -1
  for (i, l) in ls.indexed() {
    let c = x86_tok_count(l, tok)
    if c > 1 || (c == 1 && at >= 0) {
      return ""
    }
    if c == 1 {
      at = i
    }
  }
  if at < 0 {
    return ""
  }
  let l = ls[at]
  let mem = "${off}(${tok})"
  var nl = ""
  for op in ["addq", "subq", "adcq", "sbbq", "andq", "orq", "xorq", "imulq", "cmpq", "testq", "movq"] {
    let pre = "${op} ${tok}, "
    if l.starts_with(pre) {
      let dst = l[pre.len()..l.len()]
      if dst.contains("(") || dst.contains(",") || dst.starts_with("$") && !(dst.starts_with("$d") || dst.starts_with("$u")) {
        return ""
      }
      nl = "${op} ${mem}, ${dst}"
    }
  }
  if l == "mulq ${tok}" {
    nl = "mulq ${mem}"
  }
  if l == "imulq ${tok}" {
    nl = "imulq ${mem}"
  }
  if nl.is_empty() {
    return ""
  }
  var out: List[Str] = []
  for (i, x) in ls.indexed() {
    out.push(if i == at { nl } else { x })
  }
  out.join("\n")
}

/// The times register token tok (`$u3`) appears in l, not as a prefix
/// of a longer one (`$u31`).
fn x86_tok_count(l: Str, tok: Str) -> Int {
  var c = 0
  var i = 0
  while i + tok.len() <= l.len() {
    let j = l[i..l.len()].find(tok) ?? -1
    if j < 0 {
      break
    }
    let e = i + j + tok.len()
    if e >= l.len() || !is_digits(l[e..e + 1]) {
      c += 1
    }
    i = e
  }
  c
}

/// ld without its load of definition n: the line goes, the later
/// definitions' tokens move down one.
fn x86_drop_load(ld: Inst, n: Int) -> Inst {
  var out = ld
  var ls: List[Str] = []
  for l in ld.text.split("\n") {
    if l.ends_with(", $d${n}") {
      continue
    }
    var x = l
    var m = n + 1
    while m < ld.defs.len() {
      x = x.replace("$d${m}", "$d${m - 1}")
      m += 1
    }
    ls.push(x)
  }
  out.text = ls.join("\n")
  var ds: List[Int] = []
  for (i, d) in ld.defs.indexed() {
    if i != n {
      ds.push(d)
    }
  }
  out.defs = ds
  out
}

/// Whether inst may write memory (x86_fold_loads keeps no load past
/// it): anything but a plain x86 template or a register move, or a
/// template line with a memory destination, a push, a pop, a call, an
/// exchange, or a string or locked instruction.
fn x86_may_write_mem(inst: Inst) -> Bool {
  if inst.kind == K_PMOVE {
    return false
  }
  if inst.kind != K_PLAIN || !inst.x86 {
    return true
  }
  for l in inst.text.split("\n") {
    if l.starts_with("push") || l.starts_with("pop") || l.starts_with("call") || l.starts_with("xchg") || l.starts_with("lock") || l.starts_with("cmpxchg") || l.starts_with("rep") || l.starts_with("stos") || l.starts_with("movs") {
      return true
    }
    let parts = l.split(", ")
    if parts.len() > 1 && parts[parts.len() - 1].contains("(") {
      return true
    }
    if parts.len() == 1 && l.contains("(") && !l.starts_with("mulq") && !l.starts_with("imulq") && !l.starts_with("prefetch") {
      return true
    }
  }
  false
}

/// Carries kept in CF across the links of an add chain (2026-10-18:
/// x25519's fe64_mul, 300 instructions to arm64's 113). Each
/// cpu.adc/adc_carry link saves its carry (`setb; movzbl`) and the next
/// restores it (`btq $0`), as arm64's do with cset and cmp, which its
/// later passes drop where nothing between writes the flags; here a
/// mulq or imulq of the next product sits between them and writes the
/// flags. When a saved carry is read by the restore alone, the
/// instructions between that write flags and depend on nothing since
/// the add before the save move above that add, and the save and the
/// restore go: the add's CF reaches the next adc.
fn (var g: G) x86_carry_fuse() {
  // each register's reads and writes in the function
  var nuse: Map[Int, Int] = {}
  var ndef: Map[Int, Int] = {}
  for b in g.hot + g.cold {
    for inst in g.blocks[b].insts {
      for u in inst.us {
        nuse[u] = (nuse.get(u) ?? 0) + 1
      }
      for d in inst.defs {
        ndef[d] = (ndef.get(d) ?? 0) + 1
      }
    }
  }
  for b in g.hot + g.cold {
    var ins = g.take_insts(b)
    var j = 0
    while j < ins.len() {
      let r = ins[j]
      if r.kind != K_PLAIN || !r.x86 || r.text != "btq $0, $u0" || r.us.len() != 1 {
        j += 1
        continue
      }
      let k = r.us[0]
      if (nuse.get(k) ?? 0) != 1 || (ndef.get(k) ?? 0) != 1 {
        j += 1
        continue
      }
      // the save: the nearest earlier definition of k, the last lines of
      // its instruction (a split link's own cset, or an adds and cset in
      // one template), k its last definition
      var s = j - 1
      while s >= 0 && !ins[s].defs.contains(k) {
        s -= 1
      }
      if s < 0 || ins[s].kind != K_PLAIN || !ins[s].x86 || ins[s].defs[ins[s].defs.len() - 1] != k {
        j += 1
        continue
      }
      let tail = x86_save_tail(ins[s])
      let own = ins[s].text == tail
      if tail.is_empty() || (own && s < 1) || x86_lines_read_flags(ins[s].text[0..ins[s].text.len() - tail.len()]) {
        j += 1
        continue
      }
      // the next flag reader after the restore is an adc
      var c = j + 1
      while c < ins.len() && x86_flag_neutral(ins[c]) {
        c += 1
      }
      if c >= ins.len() || !(ins[c].text.starts_with("adcq ") || ins[c].text.starts_with("adcl ")) {
        j += 1
        continue
      }
      // the add that set the flags the save read (the instruction before
      // a split save, else the save's own), and the head of its chain:
      // back over the instructions that read the flags (an adc reads the
      // carry before it) and moves, to the one that writes them only; a
      // flag writer moved above the head breaks no carry
      let a = if own { s - 1 } else { s }
      if ins[a].kind != K_PLAIN || !ins[a].x86 {
        j += 1
        continue
      }
      var h = a
      if !(h == s && !own) {
        while h > 0 && (x86_reads_flags(ins[h]) || x86_flag_neutral(ins[h])) {
          h -= 1
        }
      }
      if h != s && (x86_reads_flags(ins[h]) || x86_flag_neutral(ins[h]) || !ins[h].x86 || ins[h].kind != K_PLAIN) {
        j += 1
        continue
      }
      // between the save and the restore: moves stay, independent flag
      // writers move above the head
      var ok = true
      var moved: List[Int] = []
      var touched: List[Int] = []
      var read: List[Int] = []
      for x in h..s {
        for d in ins[x].defs {
          touched.push(d)
        }
        for u in ins[x].us {
          read.push(u)
        }
      }
      var skip_next = false
      for x in s..j {
        if skip_next {
          skip_next = false
          continue
        }
        let t = ins[x]
        if x != s && t.kind == K_PMOVE && t.x86 && x + 1 < j && !x86_flag_neutral(ins[x + 1]) && x86_movable(ins[x + 1]) {
          // a tie's copy and its operation move together
          let o = ins[x + 1]
          var unit_ok = true
          for d in t.defs {
            unit_ok = unit_ok && o.us.contains(d)
          }
          if unit_ok {
            for u in t.us + o.us {
              if touched.contains(u) && !t.defs.contains(u) {
                unit_ok = false
              }
            }
            for d in t.defs + o.defs {
              if touched.contains(d) || read.contains(d) {
                unit_ok = false
              }
            }
          }
          if unit_ok {
            moved.push(x)
            moved.push(x + 1)
            skip_next = true
            continue
          }
        }
        if x != s && !x86_flag_neutral(t) {
          if !x86_movable(t) {
            ok = false
            break
          }
          for u in t.us {
            if touched.contains(u) {
              ok = false
            }
          }
          for d in t.defs {
            if touched.contains(d) || read.contains(d) {
              ok = false
            }
          }
          if !ok {
            break
          }
          moved.push(x)
          continue
        }
        for d in t.defs {
          touched.push(d)
        }
        for u in t.us {
          read.push(u)
        }
      }
      if !ok {
        j += 1
        continue
      }
      var out: List[Inst] = []
      for x in 0..h {
        out.push(ins[x])
      }
      for x in moved {
        out.push(ins[x])
      }
      for x in h..ins.len() {
        if x == j || moved.contains(x) || (x == s && own) {
          continue
        }
        if x == s {
          var t = ins[x]
          t.text = t.text[0..t.text.len() - tail.len() - 1]
          let _d = t.defs.pop()
          out.push(t)
          continue
        }
        out.push(ins[x])
      }
      ins = out
      // the save and the restore are gone: look again from the head
      j = h
    }
    g.put_insts(b, ins)
  }
}
