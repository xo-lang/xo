// The native AArch64 emitter (internal/arm64 arm64.go, decision 0049)
// in Xo, decision 0158: it lowers the module compiler/ssa built (after
// its passes and reference counting) to the assembly text internal/arm64
// prints. Per function: instruction selection (isel.xo) into MIR
// (mir.xo), the MIR passes (opt.xo, jumptab.xo, lsr.xo), register
// allocation (regalloc.xo), and emission (emit.xo); the reference
// counting, equality, box, and closure helpers are generated per
// program (rc.xo, eq.xo, boxes.xo, closures.xo).

use github.com/xo-lang/xo/compiler/ssa

/// The count of literals, never written (decision 0058).
const IMMORTAL = -9223372036854775807 - 1

/// A new emitter for module m and os ("darwin" or "linux").
fn new_gen(m: ssa.Module, os0: Str) -> G {
  // "linux-amd64": x86_64 code for linux (decision 0254 stage 2)
  let x86 = os0.ends_with("-amd64")
  let os = if x86 { os0.trim_suffix("-amd64") } else { os0 }
  // x86_64 has DWARF too since 2026-10-20: the variables' locations name
  // x86_64's registers (dwvars.xo x86_dv_op). Windows too since
  // 2026-10-22, for the program's own reports (fault tracebacks, the
  // profiler, --race's frames: dwline.xo reads the executable's .debug_
  // sections); its debuggers read CodeView, which Xo does not write
  // (gotchas/windows-no-dwarf.md)
  var g = G{m: m, os: os, x86: x86}
  for _ in 0..m.types.len() {
    g.lay_st.push(0)
    g.lay.push([])
    g.heap_c.push(-1)
  }
  for (i, f) in m.funcs.indexed() {
    g.by_name[f.name] = i
  }
  g
}

/// The generated program: its assembly, or the failure (`err`), and the
/// functions skipped.
pub struct Program {
  pub asm: Str
  pub err: Str
  pub skipped: List[Str]
  /// the assembly cut into files that assemble apart, whose objects link
  /// into the program (generate_parallel), or none; with more than one,
  /// asm is empty (their text joined was xo's whole 1.1 GB again, which
  /// Xo's assembler does not read): text() joins them
  pub parts: List[Str] = []
  /// functions' SSA and MIR text by name (G.dump_ir), for the driver to
  /// write to files
  pub dumps: List[(Str, Str)] = []
  /// the per-function cache (fcache.xo, generate_cached): the entries to
  /// store (key, entry), the functions placed from entries, and the
  /// functions whose generated text differs from their entry (verify)
  pub stores: List[(Str, Bytes)] = []
  pub reused: Int = 0
  pub mismatches: List[Str] = []
  /// the part cache (partcache.xo): its entries to store, the parts
  /// read from entries, and the parts that differ from their entry
  /// (verify)
  pub part_stores: List[(Str, Bytes)] = []
  pub parts_reused: Int = 0
  pub part_mismatches: List[Int] = []
}

/// The program's whole assembly: asm, or its parts joined.
pub fn (p: Program) text() -> Str {
  if p.parts.len() > 1 { p.parts.join("") } else { p.asm }
}

/// Lowers the module (after reference counting) to AArch64 assembly
/// (Generate, without inlining: inline.xo runs before).
fn (var g: G) generate() -> Program {
  g.find_addr_taken()
  let main = g.by_name.get("main") ?? -1
  if main < 0 {
    return Program{asm: "", err: "arm64 backend: no main", skipped: []}
  }
  for fi in 0..g.m.funcs.len() {
    g.function(fi)
  }
  g.entry(main)
  g.exports()
  var out: List[Str] = []
  g.file_header(out)
  out.push(g.section("text"))
  let text = g.text.join("")
  // decision 0318: the functions' text between two labels (not the
  // helpers and stubs after it), and its unsafe ranges' table
  let (ubase, uend, utbl) = if g.m.async_preempt { g.unsafe_table(text, "main") } else { ("", "", "") }
  out.push(ubase)
  out.push(text)
  out.push(uend)
  out.push(g.helpers.join(""))
  g.trampolines(out)
  out.push(g.lsdas.join(""))
  out.push(g.debug_sections(g.static_ref))
  g.shared_code(out)
  g.data(out)
  out.push(utbl)
  if g.m.async_preempt {
    out.push(g.unsafe_parts(["main"]))
  }
  g.end_data(out)
  Program{asm: g.win_text(g.drop_own_weak(out.join(""))), err: g.err, skipped: g.skipped, dumps: g.dumps}
}

/// The first lines of the assembly file.
fn (g: G) file_header(var out: List[Str]) {
  out.push("${g.cmt()} generated by xo build --backend=arm64 (internal/arm64, from internal/ssa with reference counting)\n")
  if g.os == "linux" {
    // a fixed file symbol: without one GNU ld names the object's
    // STT_FILE after gcc's temporary object (gotcha
    // linux-arm64-file-symbol)
    out.push("\t.file \"prog.s\"\n")
    // the crypto instructions of std/native/llrt/cpu.xo (decision 0231),
    // which an assembler for plain ARMv8 rejects without it (the code
    // runs them only when the CPU has them); LLVM 14's assembler (Debian
    // bookworm's clang) takes aes and sha2 only by those names
    // (gotchas/clang14-arch-extension-crypto.md)
    out.push("\t.arch_extension crypto\n\t.arch_extension aes\n\t.arch_extension sha2\n")
  }
}

/// The system call trampolines the code uses (rt.sys_restorer,
/// rt.sys_clone), in the text section.
fn (g: G) trampolines(var out: List[Str]) {
  if g.x86 && g.os == "windows" {
    g.w64_thunks(out)
    g.w64_weak(out)
    return
  }
  if g.x86 {
    g.x86_trampolines(out)
    return
  }
  if g.restorer_ref {
    // rt_sigaction's sa_restorer (decision 0206): rt_sigreturn, number 139
    // (in the text section: the call site tables after it switch away)
    out.push("${g.tramp_def("xo_sigreturn")}\t.p2align 2\n${g.tramp("xo_sigreturn")}:\n\tmov x8, #139\n\tsvc #0\n")
  }
  if g.clone_ref {
    // rt.sys_clone (decision 0206 stage 2): clone(flags x0, stack x1,
    // parent tid x2, tls x3, child tid x4 = x2); the child loads the
    // function and its argument from its stack, calls it, and exits the
    // thread (exit, 93); the child is the thread's outermost frame: fp
    // zero for frame pointer walks, and its unwind entry's return address
    // undefined (DW_CFA_undefined x30), where gdb's backtrace ends
    out.push("${g.tramp_def("xo_clone")}\t.p2align 2\n${g.tramp("xo_clone")}:\n\t.cfi_startproc\n\tmov x4, x2\n\tmov x8, #220\n\tsvc #0\n\tcbz x0, ${g.local("xo_clone_child")}\n\tret\n\t.cfi_endproc\n" +
      "${g.local("xo_clone_child")}:\n\t.cfi_startproc\n\t${OUTERMOST_CFI}\n\tldp x9, x0, [sp], #16\n\tmov x29, #0\n\tmov x30, #0\n\tblr x9\n\tmov x0, #0\n\tmov x8, #93\n\tsvc #0\n\tbrk #1\n\t.cfi_endproc\n")
    // rt.unwind_save and rt.unwind_resume (decision 0221), which only the
    // same programs (no C library) use
    out.push("${g.tramp_def("xo_unwind_save")}\t.p2align 2\n${g.tramp("xo_unwind_save")}:\n\t${unwind_save_body().join("\n\t")}\n")
    out.push("${g.tramp_def("xo_unwind_resume")}\t.p2align 2\n${g.tramp("xo_unwind_resume")}:\n\t${unwind_resume_body().join("\n\t")}\n")
  }
}

/// The task switch functions and the personality routine's data word,
/// once per program.
fn (g: G) shared_code(var out: List[Str]) {
  if g.sched_ref {
    out.push(if g.x86 { x86_sched_asm(g.os, g.split) } else { sched_asm(g.os, g.split) })
  }
  if g.personality_ref && g.os != "windows" {
    // the personality routine through a data word, as ELF compilers
    // refer to it from the unwind tables
    let p = personality_name(g.os)
    out.push("\t.hidden DW.ref.${p}\n\t.weak DW.ref.${p}\n" +
      "\t.section .data.DW.ref.${p},\"awG\",@progbits,DW.ref.${p},comdat\n" +
      "\t.p2align 3\n\t.type DW.ref.${p}, @object\n\t.size DW.ref.${p}, 8\n" +
      "DW.ref.${p}:\n\t${if g.x86 { ".quad" } else { ".xword" }} ${p}\n")
  }
}

/// The words of rt.static_word's table (xo_static).
const STATIC_WORDS = 256

/// rt.static_word 77 (std/native/rt.xo's table): decision 0318's unsafe
/// range tables (std/native/llrt apreempt.xo).
const UNSAFE_WORD = 77

/// The process words of rt.sys_words and rt.static_word, and the end of an ELF file.
fn (g: G) end_data(var out: List[Str]) {
  // the immortal placeholders first, at the data's start (page offset
  // 0): after the 2,176 bytes of sys_words and static_word, code that
  // loaded the empty list into x11 then x12 matched an XProtect rule
  // (MACOS.SOMA.AUENB: `add x11, x11, #0x880; adrp x12; add x12`) in
  // every compiler/macho linked program under 5 MB
  // (gotchas/xprotect-false-positive-empty-list.md).
  // The immortal placeholders (rt.rl_empty, rt.h_zero, a 0 export
  // result): the empty list {XO_RC_IMMORTAL, 0, 0} and the zero handle
  // {XO_RC_IMMORTAL, no free function}, defined by every program
  let el = g.sym("xo_empty_list")
  let zh = g.sym("xo_zero_handle")
  out.push("${g.section("data")}${g.hidden_global(el)}\t.p2align 3\n${el}:\n\t.quad ${IMMORTAL}\n\t.quad 0\n\t.quad 0\n" +
    "${g.hidden_global(zh)}\t.p2align 3\n${zh}:\n\t.quad ${IMMORTAL}\n\t.quad 0\n")
  if g.words_ref {
    // rt.sys_words (decision 0206 stage 2): 16 words, zero at start
    out.push("${g.section("data")}${g.tramp_def("xo_sys_words")}\t.p2align 3\n${g.tramp("xo_sys_words")}:\n")
    for _ in 0..16 {
      out.push("\t.quad 0\n")
    }
  }
  if g.static_ref {
    // rt.static_word (decision 0207, work item B02): 256 words of
    // process globals (64 until decision 0237), zero at start (.quad
    // lines: compiler/macho's assembler has no .zero)
    out.push("${g.section("data")}${g.tramp_def("xo_static")}\t.p2align 3\n${g.tramp("xo_static")}:\n")
    for k in 0..STATIC_WORDS {
      // word 77: the unsafe range tables of asynchronous preemption
      // (decision 0318, apreempt.xo), the one word set at start
      if k == UNSAFE_WORD && g.m.async_preempt {
        out.push("\t.quad ${g.sym("xo_unsafe_parts")}\n")
      } else {
        out.push("\t.quad 0\n")
      }
    }
  }
  if g.os == "linux" && g.m.nolibc {
    // the C library's data symbols (decision 0234)
    for d in ssa.nolibc_data() {
      out.push("\t.globl ${d}\n\t.type ${d}, %object\n\t.size ${d}, 8\n\t.p2align 3\n${d}:\n\t.quad 0\n")
    }
  }
  if g.os == "linux" && g.m.nolibc_start {
    out.push(if g.x86 { ssa.entry_stub_amd64() } else { ssa.entry_stub_arm64() })
  }
  if g.os == "linux" {
    out.push("\t.section .note.GNU-stack,\"\",@progbits\n")
  }
}

// ---------------------------------------------------------------------------
// Target conventions

/// The assembler name of a C or global symbol.
fn (g: G) sym(name: Str) -> Str {
  if g.os == "darwin" {
    return "_${name}"
  }
  name
}

/// An assembler local label.
fn (g: G) local(name: Str) -> Str {
  if g.os == "darwin" {
    return "L${name}"
  }
  ".L${name}"
}

/// The symbol of Xo function n: letters and digits are kept, `_` is
/// doubled, anything else is `_` and two hex digits.
fn (g: G) fname(n: Str) -> Str {
  var b = StrBuilder.new()
  b.write("xo_f_")
  let bs = n.bytes()
  var i = 0
  let len = bs.len()
  while i < len {
    let c = Int(bs[i])
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
      var j = i
      while j < len {
        let d = Int(bs[j])
        if !((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57)) {
          break
        }
        j += 1
      }
      b.write(bs[i..j].to_str() ?? "")
      i = j
      continue
    }
    if c == 95 {
      b.write("__")
    } else {
      b.write("_${hex2(c)}")
    }
    i += 1
  }
  g.sym(b.freeze())
}

/// The two instructions that put the address of symbol s in register r.
fn (g: G) addr(r: Str, s: Str) -> Str {
  if g.os == "darwin" {
    return "\tadrp ${r}, ${s}@PAGE\n\tadd ${r}, ${r}, ${s}@PAGEOFF\n"
  }
  "\tadrp ${r}, ${s}\n\tadd ${r}, ${r}, :lo12:${s}\n"
}

fn (g: G) section(kind: Str) -> Str {
  if g.os == "darwin" {
    match kind {
      "text" => return "\t.section __TEXT,__text,regular,pure_instructions\n"
      "data" => return "\t.section __DATA,__data\n"
      "const" => return "\t.section __TEXT,__const\n"
      "cstring" => return "\t.section __TEXT,__cstring,cstring_literals\n"
      _ => {}
    }
  }
  if g.os == "windows" {
    match kind {
      "const" | "cstring" => return "\t.section .rdata,\"dr\"\n"
      _ => {}
    }
  }
  match kind {
    "text" => "\t.text\n"
    "data" => "\t.data\n"
    "const" => "\t.section .rodata\n"
    _ => "\t.section .rodata.str1.1,\"aMS\",@progbits,1\n"
  }
}

/// Starts a function symbol (local unless global); the default layout
/// (functions 4 byte aligned, no padding: decision 0158 ports no layout
/// instrument).
fn (g: G) func_header(var b: List[Str], s: Str, global: Bool) {
  b.push("\t.p2align 2\n")
  if global {
    b.push("\t.globl ${s}\n")
  } else if g.split {
    b.push(g.hidden_global(s))
  }
  if g.os == "linux" {
    b.push("\t.type ${s}, %function\n")
  }
  b.push("${s}:\n")
}

/// The directives that make s a global symbol of hidden visibility: the
/// other files of a split assembly (generate_parallel) reach it, the
/// program does not export it.
fn (g: G) hidden_global(s: Str) -> Str {
  if g.os == "windows" {
    // COFF has no visibility: an executable exports nothing it does not
    // name in an export table
    return "\t.globl ${s}\n"
  }
  if g.os == "darwin" {
    return "\t.globl ${s}\n\t.private_extern ${s}\n"
  }
  "\t.globl ${s}\n\t.hidden ${s}\n"
}

/// The label of the system call trampoline or process words name: an
/// assembler local label, or with a split assembly a hidden global
/// symbol.
fn (g: G) tramp(name: Str) -> Str {
  if g.split {
    return g.sym(name)
  }
  g.local(name)
}

/// The directives before trampoline name's label (tramp).
fn (g: G) tramp_def(name: Str) -> Str {
  if g.split {
    return g.hidden_global(g.sym(name))
  }
  ""
}

/// The label of the immortal object of a string literal.
fn (var g: G) str_obj(s: Bytes) -> Str {
  if g.canon {
    return g.canon_str(s)
  }
  if let Some(l) = g.strs.get(s) {
    return l
  }
  let l = g.local("xo_${g.ns}str${g.strs.len()}")
  g.strs[s] = l
  g.str_ord.push(s)
  l
}

/// The label of the NUL terminated text of a fault position.
fn (var g: G) loc_label(s: Str) -> Str {
  if g.canon {
    return g.canon_loc(s)
  }
  if let Some(l) = g.locs.get(s) {
    return l
  }
  let l = g.local("xo_${g.ns}loc${g.locs.len()}")
  g.locs[s] = l
  g.loc_ord.push(s)
  l
}

fn (g: G) data(var out: List[Str]) {
  if !g.str_ord.is_empty() {
    // read only: the immortal counts of literals are never written
    // (decision 0058), and a write would fault
    out.push(g.section("const"))
    for s in g.str_ord {
      let l = g.strs.get(s) ?? ""
      out.push("\t.p2align 3\n${l}:\n\t.quad ${IMMORTAL}\n\t.quad ${s.len()}\n")
      if s.len() > 0 {
        out.push("\t.ascii \"${asm_bytes(s)}\"\n")
      }
    }
  }
  if !g.loc_ord.is_empty() {
    out.push(g.section("cstring"))
    for s in g.loc_ord {
      let l = g.locs.get(s) ?? ""
      out.push("${l}:\n\t.asciz \"${asm_bytes(s.bytes())}\"\n")
    }
  }
}

/// Emits xo_entry, which the C runtime's main calls: it calls the Xo
/// main with zero words for its parameters.
fn (var g: G) entry(main: Int) {
  if g.x86 {
    g.x86_entry(main)
    return
  }
  var b: List[Str] = []
  g.func_header(b, g.sym("xo_entry"), true)
  b.push("\t.cfi_startproc\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n")
  b.push("\t.cfi_def_cfa w29, 16\n\t.cfi_offset w30, -8\n\t.cfi_offset w29, -16\n")
  var ngp = 0
  var nfp = 0
  for p in g.m.funcs[main].blocks[0].params {
    for fp in g.layout(g.m.funcs[main].values[p].ty) {
      if fp {
        if nfp < 8 {
          b.push("\tfmov d${nfp}, xzr\n")
        }
        nfp += 1
      } else {
        if ngp < 8 {
          b.push("\tmov x${ngp}, #0\n")
        }
        ngp += 1
      }
    }
  }
  if ngp > 8 || nfp > 8 {
    g.fail("main takes too many words")
  }
  b.push("\tbl ${g.fname(g.m.funcs[main].name)}\n\tldp x29, x30, [sp], #16\n\tret\n\t.cfi_endproc\n\n")
  g.text.push(b.join(""))
}

/// Gives every C ABI export (Func.export, decision 0207) its global C
/// symbol (arm64.go exports): a branch to the function, which follows
/// AAPCS64 for Int and Float words, or for a Str result a frame that
/// stores the length (x1) through the pointer after the parameters.
fn (var g: G) exports() {
  if g.x86 {
    g.x86_exports()
    return
  }
  for f in g.m.funcs {
    if f.export.is_empty() {
      continue
    }
    var b: List[Str] = []
    g.func_header(b, g.sym(f.export), true)
    if g.m.types[f.results[0]].kind != ssa.Kind.Str {
      b.push("\tb ${g.fname(f.name)}\n\n")
      g.text.push(b.join(""))
      continue
    }
    var ngp = 0
    for p in f.blocks[0].params {
      if g.m.types[f.values[p].ty].kind != ssa.Kind.Float {
        ngp += 1
      }
    }
    if ngp >= 8 {
      g.fail("the C ABI export ${f.export} takes too many words")
    }
    b.push("\t.cfi_startproc\n\tstp x29, x30, [sp, #-32]!\n\tmov x29, sp\n\tstr x19, [sp, #16]\n")
    b.push("\t.cfi_def_cfa w29, 32\n\t.cfi_offset w30, -24\n\t.cfi_offset w29, -32\n\t.cfi_offset w19, -16\n")
    b.push("\tmov x19, x${ngp}\n\tbl ${g.fname(f.name)}\n\tstr x1, [x19]\n")
    b.push("\tldr x19, [sp, #16]\n\tldp x29, x30, [sp], #32\n\tret\n\t.cfi_endproc\n\n")
    g.text.push(b.join(""))
  }
}

// ---------------------------------------------------------------------------
// Value layout (layout.go): every SSA value is a sequence of 64 bit
// words, each in a general purpose (false) or floating point (true)
// register. In memory a word takes 8 bytes at offset 8*k, except a list
// element of type Bool, which is one byte.
//
//	Int, Bool, List   one integer word (a Bool is 0 or 1)
//	Float             one floating point word
//	Str               two integer words: the object and the length
//	function value    two integer words: the code and the environment
//	Box[T]            one integer word: the cell
//	struct, tuple     the words of the fields, in order
//	enum              the tag, then W integer payload words, W the most
//	                  words of any variant
//	(), capabilities  no words

/// The word classes of t.
fn (var g: G) layout(t: Int) -> List[Bool] {
  if g.lay_st[t] == 2 {
    return g.lay[t]
  }
  if g.lay_st[t] == 1 {
    g.fail("recursive type `${g.tname(t)}` (not boxed)")
    return []
  }
  g.lay_st[t] = 1
  let x = g.m.types[t]
  var l: List[Bool] = []
  match x.kind {
    Unit | Cap => {}
    Int | Bool | List | Box | Handle => l.push(false)
    Float => l.push(true)
    Str | Func => {
      l.push(false)
      l.push(false)
    }
    Struct => {
      for f in x.fields {
        for w in g.layout(f.ty) {
          l.push(w)
        }
      }
    }
    Tuple => {
      for e in x.elems {
        for w in g.layout(e) {
          l.push(w)
        }
      }
    }
    Enum => {
      var w = 0
      for v in x.variants {
        var n = 0
        for f in v.fields {
          n += g.layout(f.ty).len()
        }
        if n > w {
          w = n
        }
      }
      for _ in 0..1 + w {
        l.push(false)
      }
    }
    Bad => g.fail("type `${x.name}`")
  }
  g.lay[t] = l
  g.lay_st[t] = 2
  l
}

fn (var g: G) nwords(t: Int) -> Int {
  g.layout(t).len()
}

/// The first word and the word count of field i of a struct or tuple.
fn (var g: G) field_words(t: Int, i: Int) -> (Int, Int) {
  let x = g.m.types[t]
  var off = 0
  if x.kind == ssa.Kind.Struct {
    for k in 0..i {
      off += g.nwords(x.fields[k].ty)
    }
    return (off, g.nwords(x.fields[i].ty))
  }
  for k in 0..i {
    off += g.nwords(x.elems[k])
  }
  (off, g.nwords(x.elems[i]))
}

/// The first word (the tag is word 0) and the word count of field fi of
/// variant tag of enum t.
fn (var g: G) payload_words(t: Int, tag: Int, fi: Int) -> (Int, Int) {
  var off = 1
  let fs = g.m.types[t].variants[tag].fields
  for k in 0..fi {
    off += g.nwords(fs[k].ty)
  }
  (off, g.nwords(fs[fi].ty))
}

/// The size in bytes of a list element of type t.
fn (var g: G) esize(t: Int) -> Int {
  if g.kind(t) == ssa.Kind.Bool {
    return 1
  }
  8 * g.nwords(t)
}

/// A heap leaf of a value: its word offset and type.
struct Leaf {
  off: Int
  t: Int
}

/// The word offsets and types of the heap leaves of a value of type t
/// (a Str, a List, or an enum with heap payload), through structs and
/// tuples.
fn (var g: G) heap_leaves(t: Int, base: Int, var out: List[Leaf]) {
  if !g.heap(t) {
    return
  }
  let x = g.m.types[t]
  match x.kind {
    Str | List | Enum | Func | Box | Handle => out.push(Leaf{off: base, t: t})
    Struct => {
      for i in 0..x.fields.len() {
        let (off, _) = g.field_words(t, i)
        g.heap_leaves(x.fields[i].ty, base + off, out)
      }
    }
    Tuple => {
      for i in 0..x.elems.len() {
        let (off, _) = g.field_words(t, i)
        g.heap_leaves(x.elems[i], base + off, out)
      }
    }
    _ => {}
  }
}
