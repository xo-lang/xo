    ;; os.Chtimes(p, t, t), t in Unix nanoseconds (through a final link);
    ;; a time before 1970 is PREEPOCH (0x10001; WASI timestamps are
    ;; unsigned)
    (func $fs_chtimes (param $o i32) (param $n i32) (param $t i64) (param $x i32) (param $xn i32) (result i64) (local $fd i32) (local $p i32) (local $k i32)
