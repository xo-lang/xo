      i32.load offset=8
      i32.const 0
      i32.ge_s
      if
        local.get $p
        i32.load offset=8
        call $fd_close
        drop
      end
      local.get $p
      i32.load offset=12
      if
        local.get $p
        i32.load offset=12
        call $free
      end
      local.get $p
      call $free)

    ;; opens the OS path (o, n) in mode m (fsops.xo open_once's kinds: 0
    ;; read, 1 create or truncate, 2 append, 3 read and write, 4 and 5 a
    ;; new file only); a failed open's handle is closed, the status set
