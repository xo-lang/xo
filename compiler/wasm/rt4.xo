      local.get $n
      i64.const 20
      i64.eq
      if
        i32.const 54
        return
      end
      local.get $n
      i64.const 39
      i64.eq
      local.get $n
      i64.const 66
      i64.eq
      i32.or
      if
        i32.const 55
        return
      end
      local.get $n
      i64.const 21
      i64.eq
      if
