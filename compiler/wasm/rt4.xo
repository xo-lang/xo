      (local $fin i32) (local $fout i32) (local $buf i32) (local $e i32) (local $k i32) (local $off i32) (local $fd i32) (local $p i32) (local $pn i32)
      local.get $a
      local.get $an
      call $wpath
      local.set $pn
      local.set $p
      local.set $fd
