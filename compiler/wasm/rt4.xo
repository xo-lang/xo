    (func $any_free (param $p i32) (local $l i32)
      local.get $p
      i32.load offset=8
      local.tee $l
      i32.const ${empty}
      i32.ne
      local.get $l
      i32.const 0
      i32.ne
      i32.and
      if
        local.get $l
        local.get $p
        i32.load offset=12
        call_indirect (type ${dropsig})
      end
      local.get $p
      call $free)

    ;; ------------------------------------------------------------------
    ;; File handles (Fs.open, create, open_append, create_new; std/native
    ;; llrt/fsops.xo's layer 0): an object {rc, drop, fd (-1 closed),
    ;; buffer (a string object of FS_BUF bytes, 0 before the first
    ;; buffered read), r, w}, read and write through WASI's fd_read and
    ;; fd_write; the semantics are fsops.xo's for the other layers

    ;; a handle on fd (-1: a failed open's, closed)
    (func $fsfile_new (param $fd i32) (result i32) (local $p i32)
      i32.const 24
      call $alloc
      local.tee $p
      i32.const 0
      i32.const 24
      memory.fill
      local.get $p
      i32.const 1
      i32.store
      local.get $p
      i32.const ${file_free}
      i32.store offset=4
      local.get $p
      local.get $fd
      i32.store offset=8
      local.get $p)

