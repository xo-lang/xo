      i32.const 0
      i32.store offset=16
      local.get $f
      i32.const 0
      i32.store offset=20
      i32.const 0
      local.get $f
      i32.load offset=12
      i32.const 8
      i32.add
      i32.store
      i32.const 4
      i32.const 65536
      i32.store
      local.get $f
      i32.load offset=8
      i32.const 0
      i32.const 1
      i32.const 8
