// The runtime of the WebAssembly backend, stage 2 (decision 0179): what
// the self hosted checker needs beyond the goldens' runtime. The file
// system through WASI preview1 (`path_open`, `fd_read`, `fd_write`,
// `path_filestat_get`, `fd_readdir`, `path_create_directory`,
// `path_remove_directory`, `path_unlink_file`): whole files, file
// handles (Fs.open, create, open_append, create_new and their reads,
// lines, writes, close; 2026-10-17), fspath.xo's raw calls
// (create_dir_all, remove_all, create_temp), rename, remove, chtimes,
// symlink, and copy (`path_rename`, `path_symlink`,
// `path_filestat_set_times`); WASI preview1 has no permission bits and no
// advisory locks, so perm, chmod, and lock fail with an Io error that
// says so; the constants of collection types
// (`const_once`, decision 0081), Time as its Unix nanoseconds, and
// SHA-256. A relative path resolves against the first preopened
// directory (fd 3, the working directory), an absolute one against the
// second (fd 4, `/`), as compiler/wasm/run.mjs preopens them. Assembled
// into the programs that call these functions. Semantics are std/llrt's
// (xo_fs.c, xo_bytes.c, xo_crypto.c).

/// The runtime functions of rt4.xo called with the operands' leaves.
fn rt4_direct(name: Str) -> Bool {
  name is "fs_read" | "fs_write" | "fs_status" | "fs_msg" | "fs_stat" | "fs_info" | "fs_names" | "fs_read_link" | "fs_open" | "fs_file_closed" | "fs_file_read" | "fs_file_read_line" | "fs_file_write" | "fs_file_close" | "fs_raw_mkdir" | "fs_raw_rmdir" | "fs_raw_unlink" | "fs_raw_kind" | "fs_raw_names" | "fs_raw_errno" | "fs_raw_create" | "fs_raw_fail" | "fs_rename" | "fs_remove" | "fs_chtimes" | "fs_symlink" | "fs_copy" | "fs_perm" | "fs_chmod" | "fs_lock" | "fs_lock_shared" | "fs_lock_held" | "fs_unlock" | "fs_case_sensitive" | "any_new" | "any_get" | "const_once" | "time_of" | "time_ns" | "crypto_sha256"
}

/// The WASI imports of rt4.xo.
fn rt4_imports() -> Str {
  """
    (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "fd_close" (func $fd_close (param i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_filestat_get" (func $path_filestat_get (param i32 i32 i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "fd_readdir" (func $fd_readdir (param i32 i32 i32 i64 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_create_directory" (func $path_create_directory (param i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_remove_directory" (func $path_remove_directory (param i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_unlink_file" (func $path_unlink_file (param i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_rename" (func $path_rename (param i32 i32 i32 i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_readlink" (func $path_readlink (param i32 i32 i32 i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_symlink" (func $path_symlink (param i32 i32 i32 i32 i32) (result i32)))
    (import "wasi_snapshot_preview1" "path_filestat_set_times" (func $path_filestat_set_times (param i32 i32 i32 i32 i64 i64 i32) (result i32)))

  """
}

/// The globals of rt4.xo: the outcome of the last file operation, the
/// fields of the last stat, and the constants built so far.
fn rt4_globals() -> Str {
  """
    (global $fsst (mut i64) (i64.const 0))
    (global $rawerr (mut i64) (i64.const 0))
    (global $casesens (mut i32) (i32.const 0))
    (global $fspath (mut i32) (i32.const 0))
    (global $fspathn (mut i32) (i32.const 0))
    (global $fsmsg (mut i32) (i32.const 0))
    (global $fsmsgn (mut i32) (i32.const 0))
    (global $fsdir (mut i64) (i64.const 0))
    (global $fssize (mut i64) (i64.const 0))
    (global $fsmod (mut i64) (i64.const 0))
    (global $consts (mut i32) (i32.const 0))
    (global $nconsts (mut i32) (i32.const 0))

  """
}

/// The functions of rt4.xo.
fn rt4_text(var g: Gen) -> Str {
  let dot = g.raw(".".bytes())
  let empty = g.empty_list
  let thunk = g.sig([], ["i32"])
  let dropsig = g.sig(["i32"], [])
  let e_noent = g.litp("no such file or directory")
  let e_exist = g.litp("file exists")
  let e_notempty = g.litp("directory not empty")
  let e_notdir = g.litp("not a directory")
  let e_isdir = g.litp("is a directory")
  let e_acces = g.litp("permission denied")
  let e_perm = g.litp("operation not permitted")
  let e_io = g.litp("input/output error")
  let e_toolong = g.litp("file name too long")
  let e_inval = g.litp("invalid argument")
  let e_prepoch = g.litp("WASI has no times before 1970")
  let e_notsup = g.litp("operation not supported by the WASI host")
  let e_nomode = g.litp("operation not supported (WASI has no file modes or locks)")
  // SHA-256's round constants, little endian words
  var kb = BytesBuilder.new()
  for k in SHA_K {
    kb.write(le32(k))
  }
  let ka = g.place(kb.freeze())
  let file_free = g.table_index("$fsfile_free")
  let any_free = g.table_index("$any_free")
  let probe_lo = g.litp(".xocaseprobe")
  let probe_up = g.litp(".XOCASEPROBE")
  """
    ;; the WASI directory and path of the OS path at o (n bytes): fd 3 and
    ;; the path for a relative one, fd 4 and the rest for an absolute one;
    ;; "." for the empty path
    (func $wpath (param $o i32) (param $n i32) (result i32 i32 i32)
      local.get $n
      i32.eqz
      if
        i32.const 3
        i32.const ${dot}
        i32.const 1
        return
      end
      local.get $o
      i32.load8_u offset=8
      i32.const 47
      i32.eq
      if
        local.get $n
        i32.const 1
        i32.eq
        if
          i32.const 4
          i32.const ${dot}
          i32.const 1
          return
        end
        i32.const 4
        local.get $o
        i32.const 9
        i32.add
        local.get $n
        i32.const 1
        i32.sub
        return
      end
      i32.const 3
      local.get $o
      i32.const 8
      i32.add
      local.get $n)

    ;; records WASI error e for the path x (a Str): its status (FsErr's
    ;; tag plus one) and message, as fs_fail
    (func $fs_fail (param $e i32) (param $x i32) (param $xn i32) (result i64) (local $st i64) (local $m i32) (local $mn i32)
      i64.const 7
      local.set $st
      ${e_io}
      local.set $mn
      local.set $m
      local.get $e
      i32.const 44
      i32.eq
      if
        i64.const 1
        local.set $st
        ${e_noent}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 20
      i32.eq
      if
        i64.const 2
        local.set $st
        ${e_exist}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 55
      i32.eq
      if
        i64.const 3
        local.set $st
        ${e_notempty}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 54
      i32.eq
      if
        i64.const 4
        local.set $st
        ${e_notdir}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 31
      i32.eq
      if
        i64.const 5
        local.set $st
        ${e_isdir}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 2
      i32.eq
      if
        i64.const 6
        local.set $st
        ${e_acces}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 63
      i32.eq
      if
        i64.const 6
        local.set $st
        ${e_perm}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 28
      i32.eq
      if
        ${e_inval}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 37
      i32.eq
      if
        ${e_toolong}
        local.set $mn
        local.set $m
      end
      local.get $e
      i32.const 58
      i32.eq
      if
        ${e_notsup}
        local.set $mn
        local.set $m
      end
      ;; PREEPOCH, rt4.xo's own code: a time before 1970
      local.get $e
      i32.const 0x10001
      i32.eq
      if
        ${e_prepoch}
        local.set $mn
        local.set $m
      end
      ;; NOMODE, not a WASI code: rt4.xo's own for modes and locks
      local.get $e
      i32.const 0x10000
      i32.eq
      if
        ${e_nomode}
        local.set $mn
        local.set $m
      end
      local.get $st
      global.set $fsst
      global.get $fspath
      if
        global.get $fspath
        call $free
      end
      local.get $x
      local.get $xn
      call $str_copy
      global.set $fspathn
      global.set $fspath
      local.get $m
      global.set $fsmsg
      local.get $mn
      global.set $fsmsgn
      local.get $st)

    ;; a list of one Str or Bytes (o, n), consumed
    (func $str_list1 (param $o i32) (param $n i32) (result i32) (local $l i32) (local $a i32)
      i32.const 4
      i32.const 16
      call $rl_new
      i32.const 16
      call $rl_slot
      local.set $a
      local.set $l
      local.get $a
      local.get $o
      i32.store
      local.get $a
      local.get $n
      i32.store offset=8
      local.get $l)

    ;; the contents of the file at the OS path (o, n) in a list of one, or
    ;; the empty list with the status set (xo_fs_read)
    (func $fs_read (param $o i32) (param $n i32) (result i32) (local $fd i32) (local $e i32) (local $s i32) (local $len i32) (local $cap i32) (local $k i32) (local $t i32)
      local.get $o
      local.get $n
      call $wpath
      local.set $k
      local.set $t
      local.set $fd
      ;; a directory is IsDir, as natively (reading one is an error
      ;; the host may report otherwise)
      local.get $fd
      i32.const 1
      local.get $t
      local.get $k
      i32.const 24
      call $path_filestat_get
      i32.eqz
      if
        i32.const 40
        i32.load8_u
        i32.const 3
        i32.eq
        if
          i32.const 31
          local.get $o
          local.get $n
          call $fs_fail
          drop
          i32.const ${empty}
          return
        end
      end
      local.get $fd
      i32.const 1
      local.get $t
      local.get $k
      i32.const 0
      ;; fd_read, fd_seek, fd_tell, fd_filestat_get (a broader set is
      ;; refused with ENOTCAPABLE by Node)
      i64.const 0x200026
      i64.const 0
      i32.const 0
      i32.const 16
      call $path_open
      local.tee $e
      if
        local.get $e
        local.get $o
        local.get $n
        call $fs_fail
        drop
        i32.const ${empty}
        return
      end
      i32.const 16
      i32.load
      local.set $fd
      i32.const 4096
      local.tee $cap
      call $rs_new
      local.set $s
      block $x
        loop $l
          local.get $len
          local.get $cap
          i32.eq
          if
            local.get $cap
            i32.const 1
            i32.shl
            local.tee $cap
            call $rs_new
            local.tee $t
            i32.const 8
            i32.add
            local.get $s
            i32.const 8
            i32.add
            local.get $len
            memory.copy
            local.get $s
            call $free
            local.get $t
            local.set $s
          end
          ;; the iovec at 0
          i32.const 0
          local.get $s
          i32.const 8
          i32.add
          local.get $len
          i32.add
          i32.store
          i32.const 4
          local.get $cap
          local.get $len
          i32.sub
          i32.store
          local.get $fd
          i32.const 0
          i32.const 1
          i32.const 8
          call $fd_read
          local.tee $e
          if
            local.get $fd
            call $fd_close
            drop
            local.get $s
            call $free
            local.get $e
            local.get $o
            local.get $n
            call $fs_fail
            drop
            i32.const ${empty}
            return
          end
          i32.const 8
          i32.load
          local.tee $k
          i32.eqz
          br_if $x
          local.get $len
          local.get $k
          i32.add
          local.set $len
          br $l
        end
      end
      local.get $fd
      call $fd_close
      drop
      i64.const 0
      global.set $fsst
      local.get $s
      local.get $len
      call $str_list1)

    (func $fs_status (result i64)
      global.get $fsst)

    ;; the target of link p in a list of one; the empty list when p is
    ;; not a link (status 0: a browser's file system has none, so callers
    ;; that resolve links, compiler/check locate.xo, go on with p) or on an
    ;; error (status set), as fsops.xo read_link
    (func $fs_read_link (param $o i32) (param $n i32) (param $x i32) (param $xn i32) (result i32)
      (local $fd i32) (local $p i32) (local $k i32) (local $e i32) (local $s i32)
      local.get $o
      local.get $n
      call $wpath
      local.set $k
      local.set $p
      local.set $fd
      local.get $fd
      i32.const 0
      local.get $p
      local.get $k
      i32.const 24
      call $path_filestat_get
      local.tee $e
      if
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        drop
        i32.const ${empty}
        return
      end
      i64.const 0
      global.set $fsst
      ;; filetype SYMBOLIC_LINK 7
      i32.const 40
      i32.load8_u
      i32.const 7
      i32.ne
      if
        i32.const ${empty}
        return
      end
      i32.const 4096
      call $rs_new
      local.set $s
      local.get $fd
      local.get $p
      local.get $k
      local.get $s
      i32.const 8
      i32.add
      i32.const 4096
      i32.const 16
      call $path_readlink
      local.tee $e
      if
        local.get $s
        call $free
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        drop
        i32.const ${empty}
        return
      end
      local.get $s
      i32.const 16
      i32.load
      call $str_list1)

    ;; the path and the message of the last error
    (func $fs_msg (result i32) (local $l i32) (local $a i32) (local $s i32) (local $k i32)
      i32.const 4
      i32.const 16
      call $rl_new
      local.set $l
      ;; the path (none before an error)
      i32.const 0
      call $rs_new
      i32.const 0
      global.get $fspath
      i32.const 8
      i32.add
      global.get $fspathn
      call $sapp
      local.set $k
      local.set $s
      local.get $l
      i32.const 16
      call $rl_slot
      local.set $a
      local.set $l
      local.get $a
      local.get $s
      i32.store
      local.get $a
      local.get $k
      i32.store offset=8
      ;; the message
      i32.const 0
      call $rs_new
      i32.const 0
      global.get $fsmsg
      global.get $fsmsgn
      call $sapp
      local.set $k
      local.set $s
      local.get $l
      i32.const 16
      call $rl_slot
      local.set $a
      local.set $l
      local.get $a
      local.get $s
      i32.store
      local.get $a
      local.get $k
      i32.store offset=8
      local.get $l)

    (func $fs_stat (param $o i32) (param $n i32) (param $follow i32) (param $x i32) (param $xn i32) (result i64) (local $fd i32) (local $p i32) (local $k i32) (local $e i32)
      local.get $o
      local.get $n
      call $wpath
      local.set $k
      local.set $p
      local.set $fd
      local.get $fd
      local.get $follow
      local.get $p
      local.get $k
      i32.const 176
      call $path_filestat_get
      local.tee $e
      if
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        return
      end
      ;; filetype 3: a directory
      i32.const 192
      i32.load8_u
      i32.const 3
      i32.eq
      i64.extend_i32_u
      global.set $fsdir
      i32.const 208
      i64.load
      global.set $fssize
      i32.const 224
      i64.load
      global.set $fsmod
      i64.const 0
      global.set $fsst
      i64.const 0)

    ;; os.WriteFile(p, data, 0644) (xo_fs_write): the file at the OS
    ;; path (o, n) created or truncated, then the bytes (d, dn) written
    ;; with fd_write until all are; 0, or the status of the error with the
    ;; path x (WASI has no file modes: the host decides them)
    (func $fs_write (param $o i32) (param $n i32) (param $d i32) (param $dn i32) (param $x i32) (param $xn i32) (result i64) (local $fd i32) (local $p i32) (local $k i32) (local $e i32) (local $off i32)
      local.get $o
      local.get $n
      call $wpath
      local.set $k
      local.set $p
      local.set $fd
      local.get $fd
      i32.const 1
      local.get $p
      local.get $k
      ;; O_CREAT | O_TRUNC
      i32.const 9
      ;; fd_write, fd_seek, fd_tell, fd_filestat_get
      i64.const 0x200064
      i64.const 0
      i32.const 0
      i32.const 16
      call $path_open
      local.tee $e
      if
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        return
      end
      i32.const 16
      i32.load
      local.set $fd
      block $x
        loop $l
          local.get $off
          local.get $dn
          i32.ge_u
          br_if $x
          ;; the iovec at 0
          i32.const 0
          local.get $d
          i32.const 8
          i32.add
          local.get $off
          i32.add
          i32.store
          i32.const 4
          local.get $dn
          local.get $off
          i32.sub
          i32.store
          local.get $fd
          i32.const 0
          i32.const 1
          i32.const 8
          call $fd_write
          local.tee $e
          if
            local.get $fd
            call $fd_close
            drop
            local.get $e
            local.get $x
            local.get $xn
            call $fs_fail
            return
          end
          local.get $off
          i32.const 8
          i32.load
          i32.add
          local.set $off
          br $l
        end
      end
      local.get $fd
      call $fd_close
      local.tee $e
      if
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        return
      end
      i64.const 0
      global.set $fsst
      i64.const 0)

    (func $fs_info (param $w i64) (result i64)
      local.get $w
      i64.eqz
      if
        global.get $fsdir
        return
      end
      local.get $w
      i64.const 1
      i64.eq
      if
        global.get $fssize
        return
      end
      global.get $fsmod)

    ;; the entries of the OS directory (o, n), not `.` and `..`, in no
    ;; order; the error names x
    (func $fs_names (param $o i32) (param $n i32) (param $x i32) (param $xn i32) (result i32)
      (local $fd i32) (local $p i32) (local $k i32) (local $e i32) (local $buf i32) (local $used i32) (local $i i32) (local $nl i32)
      (local $l i32) (local $a i32) (local $cookie i64) (local $s i32)
      local.get $o
      local.get $n
      call $wpath
      local.set $k
      local.set $p
      local.set $fd
      local.get $fd
      i32.const 1
      local.get $p
      local.get $k
      ;; O_DIRECTORY
      i32.const 2
      ;; fd_readdir, fd_filestat_get
      i64.const 0x204000
      i64.const 0
      i32.const 0
      i32.const 16
      call $path_open
      local.tee $e
      if
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        drop
        i32.const 4
        i32.const 16
        call $rl_new
        return
      end
      i32.const 16
      i32.load
      local.set $fd
      i32.const 4
      i32.const 16
      call $rl_new
      local.set $l
      i32.const 65536
      call $alloc
      local.set $buf
      block $done
        loop $more
          local.get $fd
          local.get $buf
          i32.const 65536
          local.get $cookie
          i32.const 16
          call $fd_readdir
          br_if $done
          i32.const 16
          i32.load
          local.set $used
          i32.const 0
          local.set $i
          block $x
            loop $ent
              ;; a whole header (24 bytes) and name
              local.get $i
              i32.const 24
              i32.add
              local.get $used
              i32.gt_u
              br_if $x
              local.get $buf
              local.get $i
              i32.add
              i32.load offset=16
              local.set $nl
              local.get $i
              i32.const 24
              i32.add
              local.get $nl
              i32.add
              local.get $used
              i32.gt_u
              br_if $x
              local.get $buf
              local.get $i
              i32.add
              i64.load
              local.set $cookie
              ;; skip . and ..
              local.get $buf
              local.get $i
              i32.add
              i32.const 24
              i32.add
              local.set $p
              local.get $nl
              i32.const 1
              i32.eq
