      local.get $m
      i32.const 2
      i32.eq
      local.get $m
      i32.const 3
      i32.eq
      i32.or
      if
        i32.const 1
        local.set $of
      end
      local.get $m
      i32.const 4
      i32.ge_u
      if
        i32.const 5
        local.set $of
