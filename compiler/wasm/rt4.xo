          i32.const 0
          local.get $buf
          i32.store
          i32.const 4
          i32.const 65536
          i32.store
          local.get $fin
          i32.const 0
          i32.const 1
          i32.const 8
          call $fd_read
          local.tee $e
          br_if $done
          i32.const 8
          i32.load
          local.tee $k
          i32.eqz
          br_if $done
          i32.const 0
          local.set $off
