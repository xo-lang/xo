    ;; is (t, tn), else the empty list
    (func $any_get (param $a i32) (param $t i32) (param $tn i32) (result i32) (local $l i32)
      local.get $a
      i32.load offset=20
      local.get $tn
      i32.ne
      if
        i32.const ${empty}
        return
      end
      local.get $tn
      if
        local.get $a
        i32.load offset=16
        i32.const 8
        i32.add
        local.get $t
        i32.const 8
        i32.add
        local.get $tn
        call $mem_at
        i32.eqz
        if
          i32.const ${empty}
          return
        end
      end
