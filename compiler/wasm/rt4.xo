        end
        local.get $f
        call $fsfile_fill
        local.tee $k
        i32.const 0
        i32.lt_s
        if
          i32.const 0
          local.get $k
          i32.sub
          local.get $x
          local.get $xn
          call $fs_fail
          drop
          i32.const ${empty}
          return
        end
        i64.const 0
        global.set $fsst
        local.get $k
        i32.eqz
        if
          i32.const ${empty}
          return
        end
        i32.const 0
        local.set $r
        local.get $k
        local.set $w
      end
      local.get $w
      local.get $r
      i32.sub
      local.tee $k
      local.get $m
      i32.gt_s
      if
        local.get $m
        local.set $k
      end
      local.get $k
      call $rs_new
      local.tee $s
      i32.const 8
      i32.add
      local.get $f
      i32.load offset=12
      i32.const 8
      i32.add
      local.get $r
      i32.add
      local.get $k
      memory.copy
      local.get $f
      local.get $r
      local.get $k
      i32.add
      i32.store offset=16
      i64.const 0
      global.set $fsst
      local.get $s
      local.get $k
      call $str_list1)

    ;; f.read_line(): the next line without its newline (and a carriage
    ;; return before it) in a list of one, the empty list at the end or
    ;; with the status set (fsops.xo file_read_line)
    (func $fs_file_read_line (param $f i32) (param $x i32) (param $xn i32) (result i32)
      (local $s i32) (local $n i32) (local $r i32) (local $w i32) (local $k i32) (local $i i32) (local $b i32)
      i32.const 64
      call $rs_new
      local.set $s
      block $done
        loop $l
          local.get $f
          i32.load offset=16
          local.set $r
          local.get $f
          i32.load offset=20
          local.set $w
          local.get $r
          local.get $w
          i32.eq
          if
            local.get $f
            call $fsfile_fill
            local.tee $k
            i32.const 0
            i32.lt_s
            if
              local.get $n
              br_if $done
              local.get $s
              call $free
              i32.const 0
              local.get $k
              i32.sub
              local.get $x
              local.get $xn
              call $fs_fail
              drop
              i32.const ${empty}
              return
            end
            local.get $k
            i32.eqz
            if
              local.get $n
              br_if $done
              local.get $s
              call $free
              i64.const 0
              global.set $fsst
              i32.const ${empty}
              return
            end
            i32.const 0
            local.set $r
            local.get $k
            local.set $w
          end
          local.get $f
          i32.load offset=12
          i32.const 8
          i32.add
          local.set $b
          ;; the first newline in r..w, or w
          local.get $r
          local.set $i
          block $found
            loop $scan
              local.get $i
              local.get $w
              i32.ge_u
              br_if $found
              local.get $b
              local.get $i
              i32.add
              i32.load8_u
              i32.const 10
              i32.eq
              br_if $found
              local.get $i
              i32.const 1
              i32.add
              local.set $i
              br $scan
            end
          end
          local.get $s
          local.get $n
          local.get $b
          local.get $r
          i32.add
          local.get $i
          local.get $r
          i32.sub
          call $rs_append
          local.set $s
          local.get $n
          local.get $i
          local.get $r
          i32.sub
          i32.add
          local.set $n
          local.get $i
          local.get $w
          i32.lt_u
          if
            ;; past the newline
            local.get $f
            local.get $i
            i32.const 1
            i32.add
            i32.store offset=16
            br $done
          end
          local.get $f
          local.get $w
          i32.store offset=16
          br $l
        end
      end
      local.get $n
      if
        local.get $s
        i32.const 8
        i32.add
        local.get $n
        i32.add
        i32.const 1
        i32.sub
        i32.load8_u
        i32.const 13
        i32.eq
        if
          local.get $n
          i32.const 1
          i32.sub
          local.set $n
        end
      end
      i64.const 0
      global.set $fsst
      local.get $s
      local.get $n
      call $str_list1)

    ;; f.write(data): every byte, 0 or the status (fsops.xo file_write)
    (func $fs_file_write (param $f i32) (param $d i32) (param $dn i32) (param $x i32) (param $xn i32) (result i64) (local $off i32) (local $e i32)
      block $x
        loop $l
          local.get $off
          local.get $dn
          i32.ge_u
          br_if $x
          i32.const 0
          local.get $d
          i32.const 8
          i32.add
          local.get $off
          i32.add
          i32.store
          i32.const 4
          local.get $dn
          local.get $off
          i32.sub
          i32.store
          local.get $f
          i32.load offset=8
          i32.const 0
          i32.const 1
          i32.const 8
          call $fd_write
          local.tee $e
          if
            local.get $e
            local.get $x
            local.get $xn
            call $fs_fail
            return
          end
          local.get $off
          i32.const 8
          i32.load
          i32.add
          local.set $off
          br $l
        end
      end
      i64.const 0
      global.set $fsst
      i64.const 0)

    ;; f.close(): a second close does nothing (fsops.xo file_close)
    (func $fs_file_close (param $f i32) (param $x i32) (param $xn i32) (result i64) (local $fd i32) (local $e i32)
      local.get $f
      i32.load offset=8
      local.tee $fd
      i32.const -1
      i32.eq
      if
        i64.const 0
        global.set $fsst
        i64.const 0
        return
      end
      local.get $f
      i32.const -1
      i32.store offset=8
      local.get $fd
      call $fd_close
      local.tee $e
      if
        local.get $e
        local.get $x
        local.get $xn
        call $fs_fail
        return
      end
      i64.const 0
      global.set $fsst
      i64.const 0)
  """
}

