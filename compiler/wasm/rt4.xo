    (func $fs_open (param $o i32) (param $n i32) (param $mode i64) (param $x i32) (param $xn i32) (result i32)
      (local $fd i32) (local $t i32) (local $k i32) (local $e i32) (local $m i32) (local $of i32) (local $ff i32) (local $rights i64)
      local.get $mode
      i32.wrap_i64
      local.set $m
      local.get $o
      local.get $n
