      i32.eq
      if
        i64.const 2
        return
      end
      local.get $e
      i32.const 20
      i32.eq
      if
        i64.const 17
        return
      end
      local.get $e
      i32.const 54
      i32.eq
      if
        i64.const 20
        return
      end
      local.get $e
      i32.const 55
      i32.eq
      if
        i64.const 39
        return
      end
      local.get $e
      i32.const 31
      i32.eq
      if
        i64.const 21
        return
      end
      local.get $e
      i32.const 2
      i32.eq
      if
        i64.const 13
        return
      end
      local.get $e
      i32.const 63
      i32.eq
      if
        i64.const 1
        return
      end
      local.get $e
      i32.const 37
      i32.eq
      if
