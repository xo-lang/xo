// The component binary of a wasi:http program (decision 0447, the stage after
// step 1): Xo writes the component around its core module, with no wasm-tools
// and no preview 1 adapter. The core module's imports name the functions of
// the WASI 0.2 interfaces below, in the canonical ABI's flat forms; each gets
// its component type here, a `canon lower` and, for a resource drop, a `canon
// resource.drop`. The handle export gets a `canon lift` and the exported
// instance wasi:http/incoming-handler.
//
// `canon lower` with memory and cabi_realloc needs the core instance that the
// lowered functions are imports of, so as wit-component does a shim core module
// stands in: its functions call through a table, the core module is
// instantiated against them, and a fixup core module then fills the table with
// the lowered functions.

const WASI_V = "@0.2.0"

// The primitive value types, as s33 values (their one byte encodings).
const VT_BOOL = -1
const VT_U8 = -3
const VT_U16 = -5
const VT_U32 = -7
const VT_U64 = -9
const VT_STRING = -13

/// One import of the core module: its flat signature in value type bytes.
struct CoreImport {
  module: Str
  name: Str
  params: List[Int]
  results: List[Int]
}

/// The imports of core module core.
fn core_imports(core: Bytes) -> List[CoreImport] {
  var sigs: List[(List[Int], List[Int])] = []
  var imps: List[CoreImport] = []
  var at = 8
  while at < core.len() {
    let id = Int(core[at])
    at += 1
    let (size, body) = read_uleb(core, at)
    at = body
    let end = at + size
    if id == 1 {
      var p = at
      let (n, q) = read_uleb(core, p)
      p = q
      for _ in 0..n {
        // 0x60 params results
        p += 1
        let (np, q1) = read_uleb(core, p)
        p = q1
        var ps: List[Int] = []
        for _ in 0..np {
          ps.push(Int(core[p]))
          p += 1
        }
        let (nr, q2) = read_uleb(core, p)
        p = q2
        var rs: List[Int] = []
        for _ in 0..nr {
          rs.push(Int(core[p]))
          p += 1
        }
        sigs.push((ps, rs))
      }
    } else if id == 2 {
      var p = at
      let (n, q) = read_uleb(core, p)
      p = q
      for _ in 0..n {
        let (ml, q1) = read_uleb(core, p)
        let m = core[q1..q1 + ml].to_str() ?? ""
        p = q1 + ml
        let (nl, q2) = read_uleb(core, p)
        let f = core[q2..q2 + nl].to_str() ?? ""
        p = q2 + nl
        // 0x00: a function, the only kind the backend imports
        p += 1
        let (ti, q3) = read_uleb(core, p)
        p = q3
        imps.push(CoreImport{module: m, name: f, params: sigs[ti].0, results: sigs[ti].1})
      }
    }
    at = end
  }
  imps
}

fn read_uleb(b: Bytes, at: Int) -> (Int, Int) {
  var v = 0
  var shift = 0
  var p = at
  while true {
    let x = Int(b[p])
    p += 1
    v = v | ((x & 0x7F) << shift)
    shift += 7
    if (x & 0x80) == 0 {
      break
    }
  }
  (v, p)
}

// ---------------------------------------------------------------------------
// Type encodings

fn dt_own(t: Int) -> List[Int] {
  var o: List[Int] = [0x69]
  uleb(o, t)
  o
}

fn dt_borrow(t: Int) -> List[Int] {
  var o: List[Int] = [0x68]
  uleb(o, t)
  o
}

fn dt_list(v: Int) -> List[Int] {
  var o: List[Int] = [0x70]
  sleb(o, v)
  o
}

fn dt_option(v: Int) -> List[Int] {
  var o: List[Int] = [0x6B]
  sleb(o, v)
  o
}

fn dt_tuple(vs: List[Int]) -> List[Int] {
  var o: List[Int] = [0x6F]
  uleb(o, vs.len())
  for v in vs {
    sleb(o, v)
  }
  o
}

/// result<ok, err>, with -1000 for a missing side.
fn dt_result(ok: Int, err: Int) -> List[Int] {
  var o: List[Int] = [0x6A]
  for v in [ok, err] {
    if v == NO_TYPE {
      o.push(0)
    } else {
      o.push(1)
      sleb(o, v)
    }
  }
  o
}

const NO_TYPE = -1000

fn dt_record(fs: List[(Str, Int)]) -> List[Int] {
  var o: List[Int] = [0x72]
  uleb(o, fs.len())
  for f in fs {
    name_bytes(o, f.0)
    sleb(o, f.1)
  }
  o
}

/// A variant's cases: NO_TYPE for a case with no payload.
fn dt_variant(cs: List[(Str, Int)]) -> List[Int] {
  var o: List[Int] = [0x71]
  uleb(o, cs.len())
  for c in cs {
    name_bytes(o, c.0)
    if c.1 == NO_TYPE {
      o.push(0)
    } else {
      o.push(1)
      sleb(o, c.1)
    }
    o.push(0)
  }
  o
}

fn dt_labels(code: Int, ls: List[Str]) -> List[Int] {
  var o: List[Int] = [code]
  uleb(o, ls.len())
  for l in ls {
    name_bytes(o, l)
  }
  o
}

fn dt_enum(ls: List[Str]) -> List[Int] {
  dt_labels(0x6D, ls)
}

fn dt_flags(ls: List[Str]) -> List[Int] {
  dt_labels(0x6E, ls)
}

/// An instance type being written: its declarations and local type count.
struct InstTy {
  body: List[Int] = []
  n: Int = 0
  t: Int = 0
}

/// A type of the enclosing component, as a local type.
fn (var i: InstTy) outer(idx: Int) -> Int {
  i.body.push(0x02)
  i.body.push(0x03)
  i.body.push(0x02)
  i.body.push(0x01)
  uleb(i.body, idx)
  i.n += 1
  i.t += 1
  i.t - 1
}

fn (var i: InstTy) def(d: List[Int]) -> Int {
  i.body.push(0x01)
  extend(i.body, d)
  i.n += 1
  i.t += 1
  i.t - 1
}

/// Exports local type ty under a name (`eq`).
fn (var i: InstTy) eq(name: Str, ty: Int) -> Int {
  i.body.push(0x04)
  i.body.push(0x00)
  name_bytes(i.body, name)
  i.body.push(0x03)
  i.body.push(0x00)
  uleb(i.body, ty)
  i.n += 1
  i.t += 1
  i.t - 1
}

/// Exports a new resource type.
fn (var i: InstTy) res(name: Str) -> Int {
  i.body.push(0x04)
  i.body.push(0x00)
  name_bytes(i.body, name)
  i.body.push(0x03)
  i.body.push(0x01)
  i.n += 1
  i.t += 1
  i.t - 1
}

/// Exports a function; result NO_TYPE for none.
fn (var i: InstTy) fun(name: Str, params: List[(Str, Int)], result: Int) {
  var d: List[Int] = [0x40]
  uleb(d, params.len())
  for p in params {
    name_bytes(d, p.0)
    sleb(d, p.1)
  }
  if result == NO_TYPE {
    d.push(0x01)
    d.push(0x00)
  } else {
    d.push(0x00)
    sleb(d, result)
  }
  let ty = i.def(d)
  i.body.push(0x04)
  i.body.push(0x00)
  name_bytes(i.body, name)
  i.body.push(0x01)
  uleb(i.body, ty)
  i.n += 1
}

fn (i: InstTy) encoded() -> List[Int] {
  var o: List[Int] = [0x42]
  uleb(o, i.n)
  extend(o, i.body)
  o
}

// ---------------------------------------------------------------------------
// The interfaces

fn ity_io_error() -> InstTy {
  var i = InstTy{}
  let _e = i.res("error")
  i
}

/// wasi:io/poll; sock adds poll, which the network's scheduler waits in
/// (rt9.xo).
fn ity_io_poll(sock: Bool) -> InstTy {
  var i = InstTy{}
  let p = i.res("pollable")
  let bp = i.def(dt_borrow(p))
  i.fun("[method]pollable.block", [("self", bp)], NO_TYPE)
  if sock {
    let l = i.def(dt_list(bp))
    let r = i.def(dt_list(VT_U32))
    i.fun("poll", [("in", l)], r)
  }
  i
}

/// wasi:io/streams; t_poll (wasi:io/poll's pollable, -1 for none) adds
/// what a socket's streams use (rt9.xo): read, check-write, write,
/// blocking-flush and the subscribes.
fn ity_io_streams(t_error: Int, t_poll: Int) -> InstTy {
  var i = InstTy{}
  let e0 = i.outer(t_error)
  let e = i.eq("error", e0)
  var p = -1
  if t_poll >= 0 {
    let p0 = i.outer(t_poll)
    p = i.eq("pollable", p0)
  }
  let own_e = i.def(dt_own(e))
  let se0 = i.def(dt_variant([("last-operation-failed", own_e), ("closed", NO_TYPE)]))
  let se = i.eq("stream-error", se0)
  let inp = i.res("input-stream")
  let outp = i.res("output-stream")
  let bytes = i.def(dt_list(VT_U8))
  let bi = i.def(dt_borrow(inp))
  let r1 = i.def(dt_result(bytes, se))
  i.fun("[method]input-stream.blocking-read", [("self", bi), ("len", VT_U64)], r1)
  let bo = i.def(dt_borrow(outp))
  let r2 = i.def(dt_result(NO_TYPE, se))
  i.fun("[method]output-stream.blocking-write-and-flush", [("self", bo), ("contents", bytes)], r2)
  if p >= 0 {
    let own_p = i.def(dt_own(p))
    i.fun("[method]input-stream.read", [("self", bi), ("len", VT_U64)], r1)
    i.fun("[method]input-stream.subscribe", [("self", bi)], own_p)
    let r3 = i.def(dt_result(VT_U64, se))
    i.fun("[method]output-stream.check-write", [("self", bo)], r3)
    i.fun("[method]output-stream.write", [("self", bo), ("contents", bytes)], r2)
    i.fun("[method]output-stream.blocking-flush", [("self", bo)], r2)
    i.fun("[method]output-stream.subscribe", [("self", bo)], own_p)
  }
  i
}

/// wasi:sockets' error-code, in its order (network.wit).
const SOCK_ERRORS = ["unknown", "access-denied", "not-supported", "invalid-argument", "out-of-memory", "timeout", "concurrency-conflict", "not-in-progress", "would-block", "invalid-state", "new-socket-limit", "address-not-bindable", "address-in-use", "remote-unreachable", "connection-refused", "connection-reset", "connection-aborted", "datagram-too-large", "name-unresolvable", "temporary-resolver-failure", "permanent-resolver-failure"]

/// wasi:sockets/network: the network resource and the address types.
fn ity_sock_network() -> InstTy {
  var i = InstTy{}
  let _n = i.res("network")
  let ec0 = i.def(dt_enum(SOCK_ERRORS))
  let _ec = i.eq("error-code", ec0)
  let fam0 = i.def(dt_enum(["ipv4", "ipv6"]))
  let _fam = i.eq("ip-address-family", fam0)
  let a4_0 = i.def(dt_tuple([VT_U8, VT_U8, VT_U8, VT_U8]))
  let a4 = i.eq("ipv4-address", a4_0)
  let a6_0 = i.def(dt_tuple([VT_U16, VT_U16, VT_U16, VT_U16, VT_U16, VT_U16, VT_U16, VT_U16]))
  let a6 = i.eq("ipv6-address", a6_0)
  let ip0 = i.def(dt_variant([("ipv4", a4), ("ipv6", a6)]))
  let _ip = i.eq("ip-address", ip0)
  let s4_0 = i.def(dt_record([("port", VT_U16), ("address", a4)]))
  let s4 = i.eq("ipv4-socket-address", s4_0)
  let s6_0 = i.def(dt_record([("port", VT_U16), ("flow-info", VT_U32), ("address", a6), ("scope-id", VT_U32)]))
  let s6 = i.eq("ipv6-socket-address", s6_0)
  let sa0 = i.def(dt_variant([("ipv4", s4), ("ipv6", s6)]))
  let _sa = i.eq("ip-socket-address", sa0)
  i
}

/// wasi:sockets/instance-network, over network's t_net.
fn ity_sock_instance(t_net: Int) -> InstTy {
  var i = InstTy{}
  let n0 = i.outer(t_net)
  let n = i.eq("network", n0)
  let own_n = i.def(dt_own(n))
  i.fun("instance-network", [], own_n)
  i
}

/// wasi:sockets/tcp: what rt9.xo calls of tcp-socket.
fn ity_sock_tcp(t_net: Int, t_ec: Int, t_sa: Int, t_in: Int, t_out: Int, t_poll: Int) -> InstTy {
  var i = InstTy{}
  let n0 = i.outer(t_net)
  let n = i.eq("network", n0)
  let sa0 = i.outer(t_sa)
  let sa = i.eq("ip-socket-address", sa0)
  let ec0 = i.outer(t_ec)
  let ec = i.eq("error-code", ec0)
  let in0 = i.outer(t_in)
  let inp = i.eq("input-stream", in0)
  let out0 = i.outer(t_out)
  let outp = i.eq("output-stream", out0)
  let p0 = i.outer(t_poll)
  let p = i.eq("pollable", p0)
  let s = i.res("tcp-socket")
  let bs = i.def(dt_borrow(s))
  let bn = i.def(dt_borrow(n))
  let own_s = i.def(dt_own(s))
  let own_in = i.def(dt_own(inp))
  let own_out = i.def(dt_own(outp))
  let own_p = i.def(dt_own(p))
  let none = i.def(dt_result(NO_TYPE, ec))
  i.fun("[method]tcp-socket.start-bind", [("self", bs), ("network", bn), ("local-address", sa)], none)
  i.fun("[method]tcp-socket.finish-bind", [("self", bs)], none)
  i.fun("[method]tcp-socket.start-connect", [("self", bs), ("network", bn), ("remote-address", sa)], none)
  let streams = i.def(dt_result(i.def(dt_tuple([own_in, own_out])), ec))
  i.fun("[method]tcp-socket.finish-connect", [("self", bs)], streams)
  i.fun("[method]tcp-socket.start-listen", [("self", bs)], none)
  i.fun("[method]tcp-socket.finish-listen", [("self", bs)], none)
  let acc = i.def(dt_result(i.def(dt_tuple([own_s, own_in, own_out])), ec))
  i.fun("[method]tcp-socket.accept", [("self", bs)], acc)
  let la = i.def(dt_result(sa, ec))
  i.fun("[method]tcp-socket.local-address", [("self", bs)], la)
  i.fun("[method]tcp-socket.remote-address", [("self", bs)], la)
  i.fun("[method]tcp-socket.subscribe", [("self", bs)], own_p)
  i
}

/// wasi:sockets/udp: what rt9.xo calls of udp-socket and its datagram
/// streams (decision 0447 R2h).
fn ity_sock_udp(t_net: Int, t_ec: Int, t_sa: Int, t_poll: Int) -> InstTy {
  var i = InstTy{}
  let n0 = i.outer(t_net)
  let n = i.eq("network", n0)
  let sa0 = i.outer(t_sa)
  let sa = i.eq("ip-socket-address", sa0)
  let ec0 = i.outer(t_ec)
  let ec = i.eq("error-code", ec0)
  let p0 = i.outer(t_poll)
  let p = i.eq("pollable", p0)
  let bytes = i.def(dt_list(VT_U8))
  let ind0 = i.def(dt_record([("data", bytes), ("remote-address", sa)]))
  let ind = i.eq("incoming-datagram", ind0)
  let osa = i.def(dt_option(sa))
  let outd0 = i.def(dt_record([("data", bytes), ("remote-address", osa)]))
  let outd = i.eq("outgoing-datagram", outd0)
  let s = i.res("udp-socket")
  let ins = i.res("incoming-datagram-stream")
  let outs = i.res("outgoing-datagram-stream")
  let bs = i.def(dt_borrow(s))
  let bn = i.def(dt_borrow(n))
  let bin = i.def(dt_borrow(ins))
  let bout = i.def(dt_borrow(outs))
  let own_in = i.def(dt_own(ins))
  let own_out = i.def(dt_own(outs))
  let own_p = i.def(dt_own(p))
  let none = i.def(dt_result(NO_TYPE, ec))
  i.fun("[method]udp-socket.start-bind", [("self", bs), ("network", bn), ("local-address", sa)], none)
  i.fun("[method]udp-socket.finish-bind", [("self", bs)], none)
  let streams = i.def(dt_result(i.def(dt_tuple([own_in, own_out])), ec))
  i.fun("[method]udp-socket.stream", [("self", bs), ("remote-address", osa)], streams)
  let la = i.def(dt_result(sa, ec))
  i.fun("[method]udp-socket.local-address", [("self", bs)], la)
  let got = i.def(dt_result(i.def(dt_list(ind)), ec))
  i.fun("[method]incoming-datagram-stream.receive", [("self", bin), ("max-results", VT_U64)], got)
  i.fun("[method]incoming-datagram-stream.subscribe", [("self", bin)], own_p)
  let cnt = i.def(dt_result(VT_U64, ec))
  i.fun("[method]outgoing-datagram-stream.check-send", [("self", bout)], cnt)
  i.fun("[method]outgoing-datagram-stream.send", [("self", bout), ("datagrams", i.def(dt_list(outd)))], cnt)
  i.fun("[method]outgoing-datagram-stream.subscribe", [("self", bout)], own_p)
  i
}

/// wasi:sockets/udp-create-socket, over udp's t_sock.
fn ity_udp_create(t_fam: Int, t_ec: Int, t_sock: Int) -> InstTy {
  var i = InstTy{}
  let f0 = i.outer(t_fam)
  let f = i.eq("ip-address-family", f0)
  let s0 = i.outer(t_sock)
  let s = i.eq("udp-socket", s0)
  let ec0 = i.outer(t_ec)
  let ec = i.eq("error-code", ec0)
  let own_s = i.def(dt_own(s))
  let r = i.def(dt_result(own_s, ec))
  i.fun("create-udp-socket", [("address-family", f)], r)
  i
}

/// wasi:sockets/tcp-create-socket, over tcp's t_sock.
fn ity_sock_create(t_fam: Int, t_ec: Int, t_sock: Int) -> InstTy {
  var i = InstTy{}
  let f0 = i.outer(t_fam)
  let f = i.eq("ip-address-family", f0)
  let s0 = i.outer(t_sock)
  let s = i.eq("tcp-socket", s0)
  let ec0 = i.outer(t_ec)
  let ec = i.eq("error-code", ec0)
  let own_s = i.def(dt_own(s))
  let r = i.def(dt_result(own_s, ec))
  i.fun("create-tcp-socket", [("address-family", f)], r)
  i
}

/// wasi:sockets/ip-name-lookup.
fn ity_sock_lookup(t_poll: Int, t_net: Int, t_ec: Int, t_ip: Int) -> InstTy {
  var i = InstTy{}
  let p0 = i.outer(t_poll)
  let p = i.eq("pollable", p0)
  let n0 = i.outer(t_net)
  let n = i.eq("network", n0)
  let ec0 = i.outer(t_ec)
  let ec = i.eq("error-code", ec0)
  let ip0 = i.outer(t_ip)
  let ip = i.eq("ip-address", ip0)
  let rs = i.res("resolve-address-stream")
  let brs = i.def(dt_borrow(rs))
  let own_p = i.def(dt_own(p))
  let next = i.def(dt_result(i.def(dt_option(ip)), ec))
  i.fun("[method]resolve-address-stream.resolve-next-address", [("self", brs)], next)
  i.fun("[method]resolve-address-stream.subscribe", [("self", brs)], own_p)
  let bn = i.def(dt_borrow(n))
  let own_rs = i.def(dt_own(rs))
  let r = i.def(dt_result(own_rs, ec))
  i.fun("resolve-addresses", [("network", bn), ("name", VT_STRING)], r)
  i
}

/// wasi:http/types: client (a program that makes outgoing requests) adds
/// the client's resources, trailers (a handle_stream route, which reads a
/// request's trailers) incoming-body.finish and future-trailers; either
/// needs t_poll, wasi:io/poll's pollable.
fn ity_http_types(t_in: Int, t_out: Int, t_poll: Int, client: Bool, trailers: Bool) -> InstTy {
  var i = InstTy{}
  let in0 = i.outer(t_in)
  let inp = i.eq("input-stream", in0)
  let out0 = i.outer(t_out)
  let outp = i.eq("output-stream", out0)
  let m0 = i.def(dt_variant([("get", NO_TYPE), ("head", NO_TYPE), ("post", NO_TYPE), ("put", NO_TYPE), ("delete", NO_TYPE), ("connect", NO_TYPE), ("options", NO_TYPE), ("trace", NO_TYPE), ("patch", NO_TYPE), ("other", VT_STRING)]))
  let method = i.eq("method", m0)
  let opt_s = i.def(dt_option(VT_STRING))
  let opt_u8 = i.def(dt_option(VT_U8))
  let opt_u16 = i.def(dt_option(VT_U16))
  let opt_u32 = i.def(dt_option(VT_U32))
  let opt_u64 = i.def(dt_option(VT_U64))
  let dns0 = i.def(dt_record([("rcode", opt_s), ("info-code", opt_u16)]))
  let dns = i.eq("DNS-error-payload", dns0)
  let tls0 = i.def(dt_record([("alert-id", opt_u8), ("alert-message", opt_s)]))
  let tls = i.eq("TLS-alert-received-payload", tls0)
  let fsz0 = i.def(dt_record([("field-name", opt_s), ("field-size", opt_u32)]))
  let fsz = i.eq("field-size-payload", fsz0)
  let opt_fsz = i.def(dt_option(fsz))
  let ec0 = i.def(dt_variant([
    ("DNS-timeout", NO_TYPE),
    ("DNS-error", dns),
    ("destination-not-found", NO_TYPE),
    ("destination-unavailable", NO_TYPE),
    ("destination-IP-prohibited", NO_TYPE),
    ("destination-IP-unroutable", NO_TYPE),
    ("connection-refused", NO_TYPE),
    ("connection-terminated", NO_TYPE),
    ("connection-timeout", NO_TYPE),
    ("connection-read-timeout", NO_TYPE),
    ("connection-write-timeout", NO_TYPE),
    ("connection-limit-reached", NO_TYPE),
    ("TLS-protocol-error", NO_TYPE),
    ("TLS-certificate-error", NO_TYPE),
    ("TLS-alert-received", tls),
    ("HTTP-request-denied", NO_TYPE),
    ("HTTP-request-length-required", NO_TYPE),
    ("HTTP-request-body-size", opt_u64),
    ("HTTP-request-method-invalid", NO_TYPE),
    ("HTTP-request-URI-invalid", NO_TYPE),
    ("HTTP-request-URI-too-long", NO_TYPE),
    ("HTTP-request-header-section-size", opt_u32),
    ("HTTP-request-header-size", opt_fsz),
    ("HTTP-request-trailer-section-size", opt_u32),
    ("HTTP-request-trailer-size", fsz),
    ("HTTP-response-incomplete", NO_TYPE),
    ("HTTP-response-header-section-size", opt_u32),
    ("HTTP-response-header-size", fsz),
    ("HTTP-response-body-size", opt_u64),
    ("HTTP-response-trailer-section-size", opt_u32),
    ("HTTP-response-trailer-size", fsz),
    ("HTTP-response-transfer-coding", opt_s),
    ("HTTP-response-content-coding", opt_s),
    ("HTTP-response-timeout", NO_TYPE),
    ("HTTP-upgrade-failed", NO_TYPE),
    ("HTTP-protocol-error", NO_TYPE),
    ("loop-detected", NO_TYPE),
    ("configuration-error", NO_TYPE),
    ("internal-error", opt_s),
  ]))
  let ec = i.eq("error-code", ec0)
  let he0 = i.def(dt_variant([("invalid-syntax", NO_TYPE), ("forbidden", NO_TYPE), ("immutable", NO_TYPE)]))
  let he = i.eq("header-error", he0)
  let fields = i.res("fields")
  let ireq = i.res("incoming-request")
  let ibody = i.res("incoming-body")
  let oresp = i.res("outgoing-response")
  let obody = i.res("outgoing-body")
  let outparam = i.res("response-outparam")
  let bytes = i.def(dt_list(VT_U8))
  let own_fields = i.def(dt_own(fields))
  let b_fields = i.def(dt_borrow(fields))
  i.fun("[constructor]fields", [], own_fields)
  let r_he = i.def(dt_result(NO_TYPE, he))
  i.fun("[method]fields.append", [("self", b_fields), ("name", VT_STRING), ("value", bytes)], r_he)
  let entry = i.def(dt_tuple([VT_STRING, bytes]))
  let entries = i.def(dt_list(entry))
  i.fun("[method]fields.entries", [("self", b_fields)], entries)
  let b_ireq = i.def(dt_borrow(ireq))
  i.fun("[method]incoming-request.method", [("self", b_ireq)], method)
  i.fun("[method]incoming-request.path-with-query", [("self", b_ireq)], opt_s)
  i.fun("[method]incoming-request.authority", [("self", b_ireq)], opt_s)
  i.fun("[method]incoming-request.headers", [("self", b_ireq)], own_fields)
  let own_ibody = i.def(dt_own(ibody))
  let r_ibody = i.def(dt_result(own_ibody, NO_TYPE))
  i.fun("[method]incoming-request.consume", [("self", b_ireq)], r_ibody)
  let b_ibody = i.def(dt_borrow(ibody))
  let own_in = i.def(dt_own(inp))
  let r_in = i.def(dt_result(own_in, NO_TYPE))
  i.fun("[method]incoming-body.stream", [("self", b_ibody)], r_in)
  let own_oresp = i.def(dt_own(oresp))
  i.fun("[constructor]outgoing-response", [("headers", own_fields)], own_oresp)
  let b_oresp = i.def(dt_borrow(oresp))
  let r_unit = i.def(dt_result(NO_TYPE, NO_TYPE))
  i.fun("[method]outgoing-response.set-status-code", [("self", b_oresp), ("status-code", VT_U16)], r_unit)
  let own_obody = i.def(dt_own(obody))
  let r_obody = i.def(dt_result(own_obody, NO_TYPE))
  i.fun("[method]outgoing-response.body", [("self", b_oresp)], r_obody)
  let b_obody = i.def(dt_borrow(obody))
  let own_out = i.def(dt_own(outp))
  let r_out = i.def(dt_result(own_out, NO_TYPE))
  i.fun("[method]outgoing-body.write", [("self", b_obody)], r_out)
  let opt_tr = i.def(dt_option(own_fields))
  let r_ec = i.def(dt_result(NO_TYPE, ec))
  i.fun("[static]outgoing-body.finish", [("this", own_obody), ("trailers", opt_tr)], r_ec)
  let own_param = i.def(dt_own(outparam))
  let r_resp = i.def(dt_result(own_oresp, ec))
  i.fun("[static]response-outparam.set", [("param", own_param), ("response", r_resp)], NO_TYPE)
  var own_pl = -1
  if client || trailers {
    let p0 = i.outer(t_poll)
    let pl = i.eq("pollable", p0)
    own_pl = i.def(dt_own(pl))
  }
  if trailers {
    let ftr = i.res("future-trailers")
    let own_ftr = i.def(dt_own(ftr))
    i.fun("[static]incoming-body.finish", [("this", own_ibody)], own_ftr)
    let b_ftr = i.def(dt_borrow(ftr))
    i.fun("[method]future-trailers.subscribe", [("self", b_ftr)], own_pl)
    let r_tin = i.def(dt_result(opt_tr, ec))
    let r_tout = i.def(dt_result(r_tin, NO_TYPE))
    let opt_t = i.def(dt_option(r_tout))
    i.fun("[method]future-trailers.get", [("self", b_ftr)], opt_t)
  }
  if client {
    let s0 = i.def(dt_variant([("HTTP", NO_TYPE), ("HTTPS", NO_TYPE), ("other", VT_STRING)]))
    let scheme = i.eq("scheme", s0)
    let opt_scheme = i.def(dt_option(scheme))
    let oreq = i.res("outgoing-request")
    let ropt = i.res("request-options")
    let iresp = i.res("incoming-response")
    let fut = i.res("future-incoming-response")
    let own_oreq = i.def(dt_own(oreq))
    let b_oreq = i.def(dt_borrow(oreq))
    i.fun("[constructor]outgoing-request", [("headers", own_fields)], own_oreq)
    i.fun("[method]outgoing-request.body", [("self", b_oreq)], r_obody)
    i.fun("[method]outgoing-request.set-method", [("self", b_oreq), ("method", method)], r_unit)
    i.fun("[method]outgoing-request.set-scheme", [("self", b_oreq), ("scheme", opt_scheme)], r_unit)
    i.fun("[method]outgoing-request.set-authority", [("self", b_oreq), ("authority", opt_s)], r_unit)
    i.fun("[method]outgoing-request.set-path-with-query", [("self", b_oreq), ("path-with-query", opt_s)], r_unit)
    let own_ropt = i.def(dt_own(ropt))
    let b_ropt = i.def(dt_borrow(ropt))
    i.fun("[constructor]request-options", [], own_ropt)
    i.fun("[method]request-options.set-connect-timeout", [("self", b_ropt), ("duration", opt_u64)], r_unit)
    i.fun("[method]request-options.set-first-byte-timeout", [("self", b_ropt), ("duration", opt_u64)], r_unit)
    i.fun("[method]request-options.set-between-bytes-timeout", [("self", b_ropt), ("duration", opt_u64)], r_unit)
    let own_iresp = i.def(dt_own(iresp))
    let b_iresp = i.def(dt_borrow(iresp))
    i.fun("[method]incoming-response.status", [("self", b_iresp)], VT_U16)
    i.fun("[method]incoming-response.headers", [("self", b_iresp)], own_fields)
    i.fun("[method]incoming-response.consume", [("self", b_iresp)], r_ibody)
    let b_fut = i.def(dt_borrow(fut))
    i.fun("[method]future-incoming-response.subscribe", [("self", b_fut)], own_pl)
    let r_inner = i.def(dt_result(own_iresp, ec))
    let r_outer = i.def(dt_result(r_inner, NO_TYPE))
    let opt_r = i.def(dt_option(r_outer))
    i.fun("[method]future-incoming-response.get", [("self", b_fut)], opt_r)
  }
  i
}

/// wasi:http/outgoing-handler, over the types of t_http's resources.
fn ity_outgoing_handler(t_oreq: Int, t_ropt: Int, t_fut: Int, t_ec: Int) -> InstTy {
  var i = InstTy{}
  let q0 = i.outer(t_oreq)
  let q = i.eq("outgoing-request", q0)
  let o0 = i.outer(t_ropt)
  let o = i.eq("request-options", o0)
  let f0 = i.outer(t_fut)
  let f = i.eq("future-incoming-response", f0)
  let e0 = i.outer(t_ec)
  let e = i.eq("error-code", e0)
  let own_q = i.def(dt_own(q))
  let own_o = i.def(dt_own(o))
  let own_f = i.def(dt_own(f))
  let opt_o = i.def(dt_option(own_o))
  let r = i.def(dt_result(own_f, e))
  i.fun("handle", [("request", own_q), ("options", opt_o)], r)
  i
}

/// The getter of wasi:cli/stdout or stderr, of the stream type t.
fn ity_cli_stream(t: Int, stream: Str, getter: Str) -> InstTy {
  var i = InstTy{}
  let o0 = i.outer(t)
  let o = i.eq(stream, o0)
  let own_o = i.def(dt_own(o))
  i.fun(getter, [], own_o)
  i
}

/// wasi:cli/exit: exit with ok or err (the host's status 0 or 1).
fn ity_cli_exit() -> InstTy {
  var i = InstTy{}
  let r = i.def(dt_result(NO_TYPE, NO_TYPE))
  i.fun("exit", [("status", r)], NO_TYPE)
  i
}

/// wasi:cli/environment: the arguments and the environment.
fn ity_cli_environment() -> InstTy {
  var i = InstTy{}
  let args = i.def(dt_list(VT_STRING))
  i.fun("get-arguments", [], args)
  let pair = i.def(dt_tuple([VT_STRING, VT_STRING]))
  let env = i.def(dt_list(pair))
  i.fun("get-environment", [], env)
  i
}

fn ity_random() -> InstTy {
  var i = InstTy{}
  let bytes = i.def(dt_list(VT_U8))
  i.fun("get-random-bytes", [("len", VT_U64)], bytes)
  i
}

fn ity_wall_clock() -> InstTy {
  var i = InstTy{}
  let d0 = i.def(dt_record([("seconds", VT_U64), ("nanoseconds", VT_U32)]))
  let d = i.eq("datetime", d0)
  i.fun("now", [], d)
  i
}

/// wasi:filesystem/types: what a command's file runtime (rt8.xo) calls;
/// t_dt is wasi:clocks/wall-clock's datetime.
fn ity_fs_types(t_dt: Int) -> InstTy {
  var i = InstTy{}
  let dt0 = i.outer(t_dt)
  let dt = i.eq("datetime", dt0)
  let ty0 = i.def(dt_enum(["unknown", "block-device", "character-device", "directory", "fifo", "symbolic-link", "regular-file", "socket"]))
  let ty = i.eq("descriptor-type", ty0)
  let df0 = i.def(dt_flags(["read", "write", "file-integrity-sync", "data-integrity-sync", "requested-write-sync", "mutate-directory"]))
  let df = i.eq("descriptor-flags", df0)
  let odt = i.def(dt_option(dt))
  let st0 = i.def(dt_record([("type", ty), ("link-count", VT_U64), ("size", VT_U64), ("data-access-timestamp", odt), ("data-modification-timestamp", odt), ("status-change-timestamp", odt)]))
  let st = i.eq("descriptor-stat", st0)
  let pf0 = i.def(dt_flags(["symlink-follow"]))
  let pf = i.eq("path-flags", pf0)
  let of0 = i.def(dt_flags(["create", "directory", "exclusive", "truncate"]))
  let of = i.eq("open-flags", of0)
  let nt0 = i.def(dt_variant([("no-change", NO_TYPE), ("now", NO_TYPE), ("timestamp", dt)]))
  let nt = i.eq("new-timestamp", nt0)
  let de0 = i.def(dt_record([("type", ty), ("name", VT_STRING)]))
  let de = i.eq("directory-entry", de0)
  let ec0 = i.def(dt_enum(FS_ERRORS))
  let ec = i.eq("error-code", ec0)
  let d = i.res("descriptor")
  let ds = i.res("directory-entry-stream")
  let bd = i.def(dt_borrow(d))
  let own_d = i.def(dt_own(d))
  let own_ds = i.def(dt_own(ds))
  let bytes = i.def(dt_list(VT_U8))
  let none = i.def(dt_result(NO_TYPE, ec))
  let rd = i.def(dt_result(i.def(dt_tuple([bytes, VT_BOOL])), ec))
  i.fun("[method]descriptor.read", [("self", bd), ("length", VT_U64), ("offset", VT_U64)], rd)
  let wr = i.def(dt_result(VT_U64, ec))
  i.fun("[method]descriptor.write", [("self", bd), ("buffer", bytes), ("offset", VT_U64)], wr)
  let rdir = i.def(dt_result(own_ds, ec))
  i.fun("[method]descriptor.read-directory", [("self", bd)], rdir)
  i.fun("[method]descriptor.create-directory-at", [("self", bd), ("path", VT_STRING)], none)
  let rst = i.def(dt_result(st, ec))
  i.fun("[method]descriptor.stat", [("self", bd)], rst)
  i.fun("[method]descriptor.stat-at", [("self", bd), ("path-flags", pf), ("path", VT_STRING)], rst)
  i.fun("[method]descriptor.set-times-at", [("self", bd), ("path-flags", pf), ("path", VT_STRING), ("data-access-timestamp", nt), ("data-modification-timestamp", nt)], none)
  let ro = i.def(dt_result(own_d, ec))
  i.fun("[method]descriptor.open-at", [("self", bd), ("path-flags", pf), ("path", VT_STRING), ("open-flags", of), ("flags", df)], ro)
  let rs = i.def(dt_result(VT_STRING, ec))
  i.fun("[method]descriptor.readlink-at", [("self", bd), ("path", VT_STRING)], rs)
  i.fun("[method]descriptor.remove-directory-at", [("self", bd), ("path", VT_STRING)], none)
  i.fun("[method]descriptor.rename-at", [("self", bd), ("old-path", VT_STRING), ("new-descriptor", bd), ("new-path", VT_STRING)], none)
  i.fun("[method]descriptor.symlink-at", [("self", bd), ("old-path", VT_STRING), ("new-path", VT_STRING)], none)
  i.fun("[method]descriptor.unlink-file-at", [("self", bd), ("path", VT_STRING)], none)
  let bds = i.def(dt_borrow(ds))
  let rde = i.def(dt_result(i.def(dt_option(de)), ec))
  i.fun("[method]directory-entry-stream.read-directory-entry", [("self", bds)], rde)
  i
}

/// wasi:filesystem's error-code, in its order (types.wit).
const FS_ERRORS = ["access", "would-block", "already", "bad-descriptor", "busy", "deadlock", "quota", "exist", "file-too-large", "illegal-byte-sequence", "in-progress", "interrupted", "invalid", "io", "is-directory", "loop", "too-many-links", "message-size", "name-too-long", "no-device", "no-entry", "no-lock", "insufficient-memory", "insufficient-space", "not-directory", "not-empty", "not-recoverable", "unsupported", "no-tty", "no-such-device", "overflow", "not-permitted", "pipe", "read-only", "invalid-seek", "text-file-busy", "cross-device"]

/// wasi:filesystem/preopens, t_d types' descriptor.
fn ity_fs_preopens(t_d: Int) -> InstTy {
  var i = InstTy{}
  let d0 = i.outer(t_d)
  let d = i.eq("descriptor", d0)
  let own_d = i.def(dt_own(d))
  let pair = i.def(dt_tuple([own_d, VT_STRING]))
  let l = i.def(dt_list(pair))
  i.fun("get-directories", [], l)
  i
}

fn ity_monotonic(t_pollable: Int) -> InstTy {
  var i = InstTy{}
  let p0 = i.outer(t_pollable)
  let p = i.eq("pollable", p0)
  i.fun("now", [], VT_U64)
  let own_p = i.def(dt_own(p))
  i.fun("subscribe-duration", [("when", VT_U64)], own_p)
  i
}

// ---------------------------------------------------------------------------
// The two helper core modules

fn core_section(var out: List[Int], id: Int, count: Int, body: List[Int]) {
  var s: List[Int] = []
  uleb(s, count)
  extend(s, body)
  section(out, id, s)
}

fn func_type_bytes(var o: List[Int], ps: List[Int], rs: List[Int]) {
  o.push(0x60)
  uleb(o, ps.len())
  for p in ps {
    o.push(p)
  }
  uleb(o, rs.len())
  for r in rs {
    o.push(r)
  }
}

/// The shim: function k calls through slot k of the exported table $imports.
fn shim_module(imps: List[CoreImport]) -> List[Int] {
  var out: List[Int] = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]
  var types: List[Int] = []
  for m in imps {
    func_type_bytes(types, m.params, m.results)
  }
  core_section(out, 1, imps.len(), types)
  var funcs: List[Int] = []
  for k in 0..imps.len() {
    uleb(funcs, k)
  }
  core_section(out, 3, imps.len(), funcs)
  // a table of funcref: min = max = n
  var tab: List[Int] = [0x70, 0x01]
  uleb(tab, imps.len())
  uleb(tab, imps.len())
  core_section(out, 4, 1, tab)
  var exps: List[Int] = []
  for k in 0..imps.len() {
    name_bytes(exps, "${k}")
    exps.push(0x00)
    uleb(exps, k)
  }
  name_bytes(exps, "\$imports")
  exps.push(0x01)
  exps.push(0x00)
  core_section(out, 7, imps.len() + 1, exps)
  var code: List[Int] = []
  for k in 0..imps.len() {
    var b: List[Int] = [0x00]
    for p in 0..imps[k].params.len() {
      b.push(0x20)
      uleb(b, p)
    }
    b.push(0x41)
    sleb(b, k)
    b.push(0x11)
    uleb(b, k)
    b.push(0x00)
    b.push(0x0B)
    uleb(code, b.len())
    extend(code, b)
  }
  core_section(out, 10, imps.len(), code)
  out
}

/// The fixup: its element segment fills the shim's table with the imported
/// (lowered) functions.
fn fixup_module(imps: List[CoreImport]) -> List[Int] {
  var out: List[Int] = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]
  var types: List[Int] = []
  for m in imps {
    func_type_bytes(types, m.params, m.results)
  }
  core_section(out, 1, imps.len(), types)
  var im: List[Int] = []
  for k in 0..imps.len() {
    name_bytes(im, "")
    name_bytes(im, "${k}")
    im.push(0x00)
    uleb(im, k)
  }
  name_bytes(im, "")
  name_bytes(im, "\$imports")
  im.push(0x01)
  im.push(0x70)
  im.push(0x01)
  uleb(im, imps.len())
  uleb(im, imps.len())
  core_section(out, 2, imps.len() + 1, im)
  // an active segment at table 0, offset 0: i32.const 0, end
  var el: List[Int] = [0x00, 0x41, 0x00, 0x0B]
  uleb(el, imps.len())
  for k in 0..imps.len() {
    uleb(el, k)
  }
  core_section(out, 9, 1, el)
  out
}

// ---------------------------------------------------------------------------
// The component

/// The component being written: its bytes and index spaces.
struct Comp {
  out: List[Int] = [0x00, 0x61, 0x73, 0x6D, 0x0D, 0x00, 0x01, 0x00]
  types: Int = 0
  insts: Int = 0
  funcs: Int = 0
  core_funcs: Int = 0
  core_insts: Int = 0
  /// A resource's component type, by name.
  res: Map[Str, Int] = {}
  /// An interface's instance, by name with its version.
  iface: Map[Str, Int] = {}
}

fn (var c: Comp) deftype(d: List[Int]) -> Int {
  var s: List[Int] = [1]
  extend(s, d)
  section(c.out, 7, s)
  c.types += 1
  c.types - 1
}

/// Imports interface name of instance type i.
fn (var c: Comp) import_iface(name: Str, i: InstTy) -> Int {
  let t = c.deftype(i.encoded())
  var s: List[Int] = [1, 0x00]
  name_bytes(s, name)
  s.push(0x05)
  uleb(s, t)
  section(c.out, 10, s)
  c.iface[name] = c.insts
  c.insts += 1
  c.insts - 1
}

/// The component type of the type export name of instance inst.
fn (var c: Comp) alias_type(inst: Int, name: Str) -> Int {
  var s: List[Int] = [1, 0x03, 0x00]
  uleb(s, inst)
  name_bytes(s, name)
  section(c.out, 6, s)
  c.res[name] = c.types
  c.types += 1
  c.types - 1
}

fn (var c: Comp) alias_func(inst: Int, name: Str) -> Int {
  var s: List[Int] = [1, 0x01, 0x00]
  uleb(s, inst)
  name_bytes(s, name)
  section(c.out, 6, s)
  c.funcs += 1
  c.funcs - 1
}

/// An export of core instance inst: sort 0 function, 1 table, 2 memory.
fn (var c: Comp) alias_core(sort: Int, inst: Int, name: Str) -> Int {
  var s: List[Int] = [1, 0x00, sort, 0x01]
  uleb(s, inst)
  name_bytes(s, name)
  section(c.out, 6, s)
  if sort == 0 {
    c.core_funcs += 1
    return c.core_funcs - 1
  }
  0
}

fn (var c: Comp) core_instantiate(module: Int, args: List[(Str, Int)]) -> Int {
  var s: List[Int] = [1, 0x00]
  uleb(s, module)
  uleb(s, args.len())
  for a in args {
    name_bytes(s, a.0)
    s.push(0x12)
    uleb(s, a.1)
  }
  section(c.out, 2, s)
  c.core_insts += 1
  c.core_insts - 1
}

/// A core instance of exports (name, sort, index).
fn (var c: Comp) core_inline(exports: List[(Str, Int, Int)]) -> Int {
  var s: List[Int] = [1, 0x01]
  uleb(s, exports.len())
  for e in exports {
    name_bytes(s, e.0)
    s.push(e.1)
    uleb(s, e.2)
  }
  section(c.out, 2, s)
  c.core_insts += 1
  c.core_insts - 1
}

/// The component of core module core, with the imports it names. Err is an
/// import no interface below has. run: a command (decision 0447 stage 3),
/// which exports wasi:cli/run's run where a wasi:http program exports
/// incoming-handler's handle.
pub fn component_of(core: Bytes, run: Bool = false) -> (Bytes, Str) {
  let all = core_imports(core)
  // the resource drops need no memory and no shim
  var shimmed: List[CoreImport] = []
  for m in all {
    if !m.name.starts_with("[resource-drop]") {
      shimmed.push(m)
    }
  }
  let wanted = fn(module: Str) -> Bool {
    for m in all {
      if m.module == module {
        return true
      }
    }
    false
  }
  let wanted_fn = fn(module: Str, name: Str) -> Bool {
    for m in all {
      if m.module == module && m.name == name {
        return true
      }
    }
    false
  }
  var c = Comp{}
  // m0 the program, m1 the shim, m2 the fixup
  section(c.out, 1, core_list(core))
  section(c.out, 1, shim_module(shimmed))
  section(c.out, 1, fixup_module(shimmed))

  let ie = c.import_iface("wasi:io/error${WASI_V}", ity_io_error())
  let t_err = c.alias_type(ie, "error")
  var t_poll = -1
  let tcp = wanted("wasi:sockets/tcp${WASI_V}")
  let udp = wanted("wasi:sockets/udp${WASI_V}")
  let sock = tcp || udp
  // a stream's pollable and poll without sockets: a command with tasks
  // parks its stdin read on them (rt9.xo $wasi_stdin_wait_read, R2k)
  let waits = sock || wanted_fn("wasi:io/streams${WASI_V}", "[method]input-stream.subscribe")
  if wanted("wasi:io/poll${WASI_V}") {
    let ip = c.import_iface("wasi:io/poll${WASI_V}", ity_io_poll(waits))
    t_poll = c.alias_type(ip, "pollable")
  }
  if waits && t_poll < 0 {
    return (b"", "a wait on a stream needs wasi:io/poll's pollable")
  }
  let is = c.import_iface("wasi:io/streams${WASI_V}", ity_io_streams(t_err, if waits { t_poll } else { -1 }))
  let t_in = c.alias_type(is, "input-stream")
  let t_out = c.alias_type(is, "output-stream")
  if sock {
    // the network (rt9.xo, decision 0447)
    let inet = c.import_iface("wasi:sockets/network${WASI_V}", ity_sock_network())
    let t_net = c.alias_type(inet, "network")
    let t_ec = c.alias_type(inet, "error-code")
    let t_fam = c.alias_type(inet, "ip-address-family")
    let t_ip = c.alias_type(inet, "ip-address")
    let t_sa = c.alias_type(inet, "ip-socket-address")
    let _n = c.import_iface("wasi:sockets/instance-network${WASI_V}", ity_sock_instance(t_net))
    if tcp {
      let itcp = c.import_iface("wasi:sockets/tcp${WASI_V}", ity_sock_tcp(t_net, t_ec, t_sa, t_in, t_out, t_poll))
      let t_sock = c.alias_type(itcp, "tcp-socket")
      let _c = c.import_iface("wasi:sockets/tcp-create-socket${WASI_V}", ity_sock_create(t_fam, t_ec, t_sock))
    }
    if udp {
      // UDP (decision 0447 R2h)
      let iudp = c.import_iface("wasi:sockets/udp${WASI_V}", ity_sock_udp(t_net, t_ec, t_sa, t_poll))
      let t_usock = c.alias_type(iudp, "udp-socket")
      let _u = c.alias_type(iudp, "incoming-datagram-stream")
      let _o = c.alias_type(iudp, "outgoing-datagram-stream")
      let _uc = c.import_iface("wasi:sockets/udp-create-socket${WASI_V}", ity_udp_create(t_fam, t_ec, t_usock))
    }
    if wanted("wasi:sockets/ip-name-lookup${WASI_V}") || tcp {
      let il = c.import_iface("wasi:sockets/ip-name-lookup${WASI_V}", ity_sock_lookup(t_poll, t_net, t_ec, t_ip))
      let _r = c.alias_type(il, "resolve-address-stream")
    }
  }
  let client = wanted("wasi:http/outgoing-handler${WASI_V}")
  var trailers = false
  for m in all {
    if m.name == "[static]incoming-body.finish" {
      trailers = true
    }
  }
  if (client || trailers) && t_poll < 0 {
    return (b"", "a wasi:http client or a handle_stream route needs wasi:io/poll's pollable")
  }
  var ih = -1
  if !run {
    ih = c.import_iface("wasi:http/types${WASI_V}", ity_http_types(t_in, t_out, t_poll, client, trailers))
    for r in ["fields", "incoming-request", "incoming-body", "outgoing-response", "outgoing-body", "response-outparam"] {
      let _t = c.alias_type(ih, r)
    }
  }
  if trailers && !run {
    let _t = c.alias_type(ih, "future-trailers")
  }
  if client && !run {
    let t_oreq = c.alias_type(ih, "outgoing-request")
    let t_ropt = c.alias_type(ih, "request-options")
    let _i = c.alias_type(ih, "incoming-response")
    let t_fut = c.alias_type(ih, "future-incoming-response")
    let t_ec = c.alias_type(ih, "error-code")
    let _h = c.import_iface("wasi:http/outgoing-handler${WASI_V}", ity_outgoing_handler(t_oreq, t_ropt, t_fut, t_ec))
  }
  if wanted("wasi:cli/stdout${WASI_V}") {
    let _i = c.import_iface("wasi:cli/stdout${WASI_V}", ity_cli_stream(t_out, "output-stream", "get-stdout"))
  }
  if wanted("wasi:cli/stderr${WASI_V}") {
    let _i = c.import_iface("wasi:cli/stderr${WASI_V}", ity_cli_stream(t_out, "output-stream", "get-stderr"))
  }
  if wanted("wasi:cli/stdin${WASI_V}") {
    let _i = c.import_iface("wasi:cli/stdin${WASI_V}", ity_cli_stream(t_in, "input-stream", "get-stdin"))
  }
  if wanted("wasi:cli/exit${WASI_V}") {
    let _i = c.import_iface("wasi:cli/exit${WASI_V}", ity_cli_exit())
  }
  if wanted("wasi:cli/environment${WASI_V}") {
    let _i = c.import_iface("wasi:cli/environment${WASI_V}", ity_cli_environment())
  }
  if wanted("wasi:random/random${WASI_V}") {
    let _i = c.import_iface("wasi:random/random${WASI_V}", ity_random())
  }
  let files = wanted("wasi:filesystem/types${WASI_V}") || wanted("wasi:filesystem/preopens${WASI_V}")
  if wanted("wasi:clocks/wall-clock${WASI_V}") || files {
    let iw = c.import_iface("wasi:clocks/wall-clock${WASI_V}", ity_wall_clock())
    if files {
      let t_dt = c.alias_type(iw, "datetime")
      let ift = c.import_iface("wasi:filesystem/types${WASI_V}", ity_fs_types(t_dt))
      let t_d = c.alias_type(ift, "descriptor")
      let _t = c.alias_type(ift, "directory-entry-stream")
      let _p = c.import_iface("wasi:filesystem/preopens${WASI_V}", ity_fs_preopens(t_d))
    }
  }
  if wanted("wasi:clocks/monotonic-clock${WASI_V}") {
    let _i = c.import_iface("wasi:clocks/monotonic-clock${WASI_V}", ity_monotonic(t_poll))
  }
  for m in all {
    if !c.iface.contains(m.module) {
      return (b"", "the component has no interface ${m.module} for its import ${m.name}")
    }
  }

  // the shim, its functions by core module, and the program against them
  let shim = c.core_instantiate(1, [])
  var by_module: Map[Str, List[(Str, Int, Int)]] = {}
  var modules: List[Str] = []
  var k = 0
  for m in all {
    var f = 0
    if m.name.starts_with("[resource-drop]") {
      let r = m.name.trim_prefix("[resource-drop]")
      if !c.res.contains(r) {
        return (b"", "the component has no resource ${r}")
      }
      var s: List[Int] = [1, 0x03]
      uleb(s, c.res.get_or_fault(r, "checked above"))
      section(c.out, 8, s)
      f = c.core_funcs
      c.core_funcs += 1
    } else {
      f = c.alias_core(0, shim, "${k}")
      k += 1
    }
    if !by_module.contains(m.module) {
      modules.push(m.module)
      by_module[m.module] = []
    }
    var l = by_module.get_or_fault(m.module, "set above")
    l.push((m.name, 0, f))
    by_module[m.module] = l
  }
  var args: List[(Str, Int)] = []
  for m in modules {
    args.push((m, c.core_inline(by_module.get_or_fault(m, "set above"))))
  }
  let main = c.core_instantiate(0, args)
  let _mem = c.alias_core(2, main, "memory")
  let realloc = c.alias_core(0, main, "cabi_realloc")
  let entry = c.alias_core(0, main, if run { "wasi:cli/run${WASI_V}#run" } else { "wasi:http/incoming-handler${WASI_V}#handle" })

  // the lowered functions, and the fixup that puts them in the shim's table
  var fills: List[(Str, Int, Int)] = []
  k = 0
  for m in shimmed {
    let f = c.alias_func(c.iface.get_or_fault(m.module, "checked above"), m.name)
    var s: List[Int] = [1, 0x01, 0x00]
    uleb(s, f)
    s.push(3)
    s.push(0x00)
    s.push(0x03)
    s.push(0x00)
    s.push(0x04)
    uleb(s, realloc)
    section(c.out, 8, s)
    fills.push(("${k}", 0, c.core_funcs))
    c.core_funcs += 1
    k += 1
  }
  let _tab = c.alias_core(1, shim, "\$imports")
  fills.push(("\$imports", 1, 0))
  let fx = c.core_inline(fills)
  let _fixup = c.core_instantiate(2, [("", fx)])

  if run {
    // run: func() -> result
    let r = c.deftype(dt_result(NO_TYPE, NO_TYPE))
    var d: List[Int] = [0x40, 0x00, 0x00]
    sleb(d, r)
    let t_run = c.deftype(d)
    var lift: List[Int] = [1, 0x00, 0x00]
    uleb(lift, entry)
    lift.push(0)
    uleb(lift, t_run)
    section(c.out, 8, lift)
    let f_run = c.funcs
    c.funcs += 1
    var inst: List[Int] = [1, 0x01, 1, 0x00]
    name_bytes(inst, "run")
    inst.push(0x01)
    uleb(inst, f_run)
    section(c.out, 5, inst)
    let exported = c.insts
    c.insts += 1
    var ex: List[Int] = [1, 0x00]
    name_bytes(ex, "wasi:cli/run${WASI_V}")
    ex.push(0x05)
    uleb(ex, exported)
    ex.push(0x00)
    section(c.out, 11, ex)
    return (bytes_of(c.out), "")
  }

  // the handler
  let own_req = c.deftype(dt_own(c.res.get_or_fault("incoming-request", "aliased above")))
  let own_out = c.deftype(dt_own(c.res.get_or_fault("response-outparam", "aliased above")))
  var d: List[Int] = [0x40]
  uleb(d, 2)
  name_bytes(d, "request")
  sleb(d, own_req)
  name_bytes(d, "response-out")
  sleb(d, own_out)
  d.push(0x01)
  d.push(0x00)
  let t_handle = c.deftype(d)
  var lift: List[Int] = [1, 0x00, 0x00]
  uleb(lift, entry)
  lift.push(0)
  uleb(lift, t_handle)
  section(c.out, 8, lift)
  let f_handle = c.funcs
  c.funcs += 1
  var inst: List[Int] = [1, 0x01, 1, 0x00]
  name_bytes(inst, "handle")
  inst.push(0x01)
  uleb(inst, f_handle)
  section(c.out, 5, inst)
  let exported = c.insts
  c.insts += 1
  var ex: List[Int] = [1, 0x00]
  name_bytes(ex, "wasi:http/incoming-handler${WASI_V}")
  ex.push(0x05)
  uleb(ex, exported)
  ex.push(0x00)
  section(c.out, 11, ex)
  (bytes_of(c.out), "")
}

fn bytes_of(out: List[Int]) -> Bytes {
  var bb = BytesBuilder.with_capacity(out.len())
  for x in out {
    bb.write_byte(UInt8(x & 255))
  }
  bb.freeze()
}

fn core_list(core: Bytes) -> List[Int] {
  var o: List[Int] = []
  for b in core {
    o.push(Int(b))
  }
  o
}
