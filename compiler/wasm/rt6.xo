// The WASI 0.2 imports of a wasi:http component (decision 0447): a component
// may not import wasi_snapshot_preview1, so the preview 1 functions the rest of
// the runtime calls are functions here, with the same signatures, over what the
// wasi:http/proxy world gives. That world has no arguments, environment,
// files or exit: arguments and the environment are empty, a file operation
// (and, not wired yet, a read of stdin) returns ENOSYS, and proc_exit traps,
// which the host answers with an error. strip_runtime keeps only what a
// program reaches.

/// A preview 1 import line, which a component does not write.
fn drop_preview1(s: Str) -> Str {
  var b = StrBuilder.new()
  for l in s.lines() {
    if !l.trim_start().starts_with("(import \"wasi_snapshot_preview1\"") {
      b.write(l)
      b.write("\n")
    }
  }
  b.freeze()
}

/// The imports of rt6.xo.
fn rt6_imports() -> Str {
  """
    (import "wasi:cli/stdout@0.2.0" "get-stdout" (func $cli_stdout (result i32)))
    (import "wasi:cli/stderr@0.2.0" "get-stderr" (func $cli_stderr (result i32)))
    (import "wasi:random/random@0.2.0" "get-random-bytes" (func $rnd_bytes (param i64 i32)))
    (import "wasi:clocks/wall-clock@0.2.0" "now" (func $wall_now (param i32)))
    (import "wasi:clocks/monotonic-clock@0.2.0" "now" (func $mono_now (result i64)))
    (import "wasi:clocks/monotonic-clock@0.2.0" "subscribe-duration" (func $mono_sub (param i64) (result i32)))
    (import "wasi:io/poll@0.2.0" "[method]pollable.block" (func $poll_block (param i32)))
    (import "wasi:io/poll@0.2.0" "[resource-drop]pollable" (func $poll_drop (param i32)))

  """
}

/// A preview 1 function that WASI's proxy world has no way to do: ENOSYS.
fn rt6_enosys(name: Str, params: Str) -> Str {
  "    (func \$${name} ${params} (result i32)\n      i32.const 52)\n\n"
}

/// The preview 1 functions over WASI 0.2.
fn rt6_text() -> Str {
  var b = StrBuilder.new()
  b.write("""
    ;; stdout and stderr: the stream got and dropped per call, written in the
    ;; 4096 byte pieces blocking-write-and-flush allows
    (func $fd_write (param $fd i32) (param $iov i32) (param $n i32) (param $nw i32) (result i32) (local $s i32) (local $total i32) (local $p i32) (local $left i32) (local $k i32) (local $r i32)
      local.get $fd
      i32.const 1
      i32.eq
      if
        call $cli_stdout
        local.set $s
      else
        local.get $fd
        i32.const 2
        i32.ne
        if
          i32.const 8
          return
        end
        call $cli_stderr
        local.set $s
      end
      call $hret_at
      local.set $r
      block $done
        loop $next
          local.get $n
          i32.eqz
          br_if $done
          local.get $iov
          i32.load
          local.set $p
          local.get $iov
          i32.load offset=4
          local.set $left
          local.get $total
          local.get $left
          i32.add
          local.set $total
          block $sent
            loop $piece
              local.get $left
              i32.eqz
              br_if $sent
              local.get $left
              i32.const 4096
              local.get $left
              i32.const 4096
              i32.lt_u
              select
              local.set $k
              local.get $s
              local.get $p
              local.get $k
              local.get $r
              call $ostream_write
              ;; a failed write's error handle (case 0 of stream-error) is ours
              local.get $r
              i32.load8_u
              if
                local.get $r
                i32.load8_u offset=4
                i32.eqz
                if
                  local.get $r
                  i32.load offset=8
                  call $ioerr_drop
                end
                br $sent
              end
              local.get $p
              local.get $k
              i32.add
              local.set $p
              local.get $left
              local.get $k
              i32.sub
              local.set $left
              br $piece
            end
          end
          local.get $iov
          i32.const 8
          i32.add
          local.set $iov
          local.get $n
          i32.const 1
          i32.sub
          local.set $n
          br $next
        end
      end
      local.get $s
      call $ostream_drop
      local.get $nw
      local.get $total
      i32.store
      i32.const 0)

    (func $proc_exit (param $code i32)
      unreachable)

    (func $args_sizes_get (param $n i32) (param $size i32) (result i32)
      local.get $n
      i32.const 0
      i32.store
      local.get $size
      i32.const 0
      i32.store
      i32.const 0)

    (func $args_get (param $a i32) (param $b i32) (result i32)
      i32.const 0)

    (func $environ_sizes_get (param $n i32) (param $size i32) (result i32)
      local.get $n
      i32.const 0
      i32.store
      local.get $size
      i32.const 0
      i32.store
      i32.const 0)

    (func $environ_get (param $a i32) (param $b i32) (result i32)
      i32.const 0)

    (func $random_get (param $buf i32) (param $n i32) (result i32) (local $r i32) (local $p i32)
      call $hret_at
      local.set $r
      local.get $n
      i64.extend_i32_u
      local.get $r
      call $rnd_bytes
      local.get $r
      i32.load
      local.set $p
      local.get $buf
      local.get $p
      local.get $n
      memory.copy
      local.get $n
      if
        local.get $p
        call $free
      end
      i32.const 0)

    ;; clock 0 is the wall clock, the others the monotonic one
    (func $clock_time_get (param $id i32) (param $prec i64) (param $at i32) (result i32) (local $r i32)
      local.get $id
      if
        local.get $at
        call $mono_now
        i64.store
        i32.const 0
        return
      end
      call $hret_at
      local.set $r
      local.get $r
      call $wall_now
      local.get $at
      local.get $r
      i64.load
      i64.const 1000000000
      i64.mul
      local.get $r
      i64.load32_u offset=8
      i64.add
      i64.store
      i32.const 0)

    ;; the one subscription rt3.xo's sleep makes: a relative clock at +24
    (func $poll_oneoff (param $in i32) (param $out i32) (param $n i32) (param $got i32) (result i32) (local $p i32)
      local.get $in
      i64.load offset=24
      call $mono_sub
      local.tee $p
      call $poll_block
      local.get $p
      call $poll_drop
      local.get $out
      i32.const 0
      i32.const 32
      memory.fill
      local.get $got
      i32.const 1
      i32.store
      i32.const 0)


  """)
  b.write(rt6_enosys("path_open", "(param i32 i32 i32 i32 i32 i64 i64 i32 i32)"))
  b.write(rt6_enosys("fd_read", "(param i32 i32 i32 i32)"))
  b.write(rt6_enosys("fd_close", "(param i32)"))
  b.write(rt6_enosys("path_filestat_get", "(param i32 i32 i32 i32 i32)"))
  b.write(rt6_enosys("fd_readdir", "(param i32 i32 i32 i64 i32)"))
  b.write(rt6_enosys("path_create_directory", "(param i32 i32 i32)"))
  b.write(rt6_enosys("path_remove_directory", "(param i32 i32 i32)"))
  b.write(rt6_enosys("path_unlink_file", "(param i32 i32 i32)"))
  b.write(rt6_enosys("path_rename", "(param i32 i32 i32 i32 i32 i32)"))
  b.write(rt6_enosys("path_readlink", "(param i32 i32 i32 i32 i32 i32)"))
  b.write(rt6_enosys("path_symlink", "(param i32 i32 i32 i32 i32)"))
  b.write(rt6_enosys("path_filestat_set_times", "(param i32 i32 i32 i32 i64 i64 i32)"))
  b.freeze()
}
