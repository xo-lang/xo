// The runtime of a wasip2/wasm command (decision 0447 stage 3): a program
// that does not serve wasi:http is the core module of a `wasi:cli/command`
// 0.2 component. It exports `wasi:cli/run@0.2.0#run` in place of `_start`;
// the preview 1 functions the rest of the runtime calls are rt6.xo's, with
// these in place of its proxy world ones: proc_exit is wasi:cli/exit's exit
// (0 ok, any other code err, which hosts report as status 1), and the
// arguments and the environment are wasi:cli/environment's.

/// The imports of rt7.xo.
fn rt7_imports() -> Str {
  """
    (import "wasi:cli/exit@0.2.0" "exit" (func $cli_exit (param i32)))
    (import "wasi:cli/environment@0.2.0" "get-arguments" (func $cli_args (param i32)))
    (import "wasi:cli/environment@0.2.0" "get-environment" (func $cli_env (param i32)))
    (import "wasi:cli/stdin@0.2.0" "get-stdin" (func $cli_stdin (result i32)))
    (import "wasi:io/streams@0.2.0" "[method]input-stream.blocking-read" (func $istream_read (param i32 i64 i32)))
    (import "wasi:io/error@0.2.0" "[resource-drop]error" (func $ioerr_drop (param i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.blocking-write-and-flush" (func $ostream_write (param i32 i32 i32 i32)))
    (import "wasi:io/streams@0.2.0" "[resource-drop]output-stream" (func $ostream_drop (param i32)))

  """
}

/// The global of rt7.xo: the scratch area imports return through.
fn rt7_globals() -> Str {
  "    (global $hret (mut i32) (i32.const 0))\n    (global $hstdin (mut i32) (i32.const 0))\n"
}

/// The functions of rt6.xo that rt7.xo replaces in a command.
fn rt7_replaces() -> List[Str] {
  ["proc_exit", "args_sizes_get", "args_get", "environ_sizes_get", "environ_get"]
}

/// Text without the functions named (each a chunk of its own, between
/// blank lines, starting `(func $NAME`).
fn drop_funcs(text: Str, names: List[Str]) -> Str {
  var b = StrBuilder.new()
  for chunk in text.split("\n\n") {
    let t = chunk.trim_start()
    var drop = false
    for n in names {
      if t.starts_with("(func \$${n} ") || t.starts_with("(func \$${n}\n") {
        drop = true
      }
    }
    if !drop {
      b.write(chunk)
      b.write("\n\n")
    }
  }
  b.freeze()
}

/// The functions of rt7.xo.
fn rt7_text() -> Str {
  """
    ;; the canonical ABI's allocator, as rt5.xo's
    (func $cabi_realloc (export "cabi_realloc") (param $old i32) (param $osize i32) (param $align i32) (param $n i32) (result i32) (local $p i32)
      local.get $n
      call $alloc
      local.set $p
      local.get $old
      if
        local.get $p
        local.get $old
        local.get $osize
        local.get $n
        local.get $osize
        local.get $n
        i32.lt_u
        select
        memory.copy
        local.get $old
        call $free
      end
      local.get $p)

    (func $hret_at (result i32)
      global.get $hret
      i32.eqz
      if
        i32.const 128
        call $alloc
        global.set $hret
      end
      global.get $hret)

    ;; exit: result<_, _>, ok for code 0
    (func $proc_exit (param $code i32)
      local.get $code
      i32.const 0
      i32.ne
      call $cli_exit
      unreachable)

    ;; wasi:cli/environment's arguments (env 0: list<string>) or environment
    ;; (env 1: list<tuple<string, string>>) in preview 1's two calls: vec 0
    ;; writes the count at $a and the bytes the strings take at $b; vec 1
    ;; the pointers at $a and the strings from $b, each NUL ended, an
    ;; environment entry as "k=v". The host's blocks are freed (an empty
    ;; string may not be a block).
    (func $cli_strings (param $env i32) (param $vec i32) (param $a i32) (param $b i32) (result i32) (local $r i32) (local $p i32) (local $k i32) (local $i i32) (local $e i32) (local $t i32)
      call $hret_at
      local.set $r
      local.get $env
      if
        local.get $r
        call $cli_env
      else
        local.get $r
        call $cli_args
      end
      local.get $r
      i32.load
      local.set $p
      local.get $r
      i32.load offset=4
      local.set $k
      block $done
        loop $next
          local.get $i
          local.get $k
          i32.ge_u
          br_if $done
          local.get $p
          local.get $i
          i32.const 3
          local.get $env
          i32.add
          i32.shl
          i32.add
          local.set $e
          local.get $vec
          if
            local.get $a
            local.get $i
            i32.const 2
            i32.shl
            i32.add
            local.get $b
            local.get $t
            i32.add
            i32.store
            local.get $b
            local.get $t
            i32.add
            local.get $e
            i32.load
            local.get $e
            i32.load offset=4
            memory.copy
          end
          local.get $t
          local.get $e
          i32.load offset=4
          i32.add
          local.set $t
          local.get $env
          if
            local.get $vec
            if
              local.get $b
              local.get $t
              i32.add
              i32.const 61
              i32.store8
              local.get $b
              local.get $t
              i32.add
              i32.const 1
              i32.add
              local.get $e
              i32.load offset=8
              local.get $e
              i32.load offset=12
              memory.copy
            end
            local.get $t
            i32.const 1
            i32.add
            local.get $e
            i32.load offset=12
            i32.add
            local.set $t
            local.get $e
            i32.load offset=12
            if
              local.get $e
              i32.load offset=8
              call $free
            end
          end
          local.get $vec
          if
            local.get $b
            local.get $t
            i32.add
            i32.const 0
            i32.store8
          end
          local.get $t
          i32.const 1
          i32.add
          local.set $t
          local.get $e
          i32.load offset=4
          if
            local.get $e
            i32.load
            call $free
          end
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $next
        end
      end
      local.get $k
      if
        local.get $p
        call $free
      end
      local.get $vec
      i32.eqz
      if
        local.get $a
        local.get $k
        i32.store
        local.get $b
        local.get $t
        i32.store
      end
      i32.const 0)

    ;; rt.wasi_stdin_read: at most n bytes of stdin into p, their count, 0
    ;; at its end, -5 (EIO) for a failed read; the input-stream got once
    (func $wasi_stdin_read (param $p i64) (param $n i64) (result i64) (local $r i32) (local $q i32) (local $k i32)
      global.get $hstdin
      i32.eqz
      if
        call $cli_stdin
        global.set $hstdin
      end
      call $hret_at
      local.set $r
      block $got
        loop $again
          global.get $hstdin
          local.get $n
          local.get $r
          call $istream_read
          local.get $r
          i32.load8_u
          if
            ;; closed is the end; last-operation-failed drops its error
            local.get $r
            i32.load8_u offset=4
            i32.eqz
            if
              local.get $r
              i32.load offset=8
              call $ioerr_drop
              i64.const -5
              return
            end
            i64.const 0
            return
          end
          local.get $r
          i32.load offset=8
          br_if $got
          br $again
        end
      end
      local.get $r
      i32.load offset=4
      local.set $q
      local.get $r
      i32.load offset=8
      local.set $k
      local.get $p
      i32.wrap_i64
      local.get $q
      local.get $k
      memory.copy
      local.get $q
      call $free
      local.get $k
      i64.extend_i32_u)

    (func $args_sizes_get (param $n i32) (param $size i32) (result i32)
      i32.const 0
      i32.const 0
      local.get $n
      local.get $size
      call $cli_strings)

    (func $args_get (param $a i32) (param $b i32) (result i32)
      i32.const 0
      i32.const 1
      local.get $a
      local.get $b
      call $cli_strings)

    (func $environ_sizes_get (param $n i32) (param $size i32) (result i32)
      i32.const 1
      i32.const 0
      local.get $n
      local.get $size
      call $cli_strings)

    (func $environ_get (param $a i32) (param $b i32) (result i32)
      i32.const 1
      i32.const 1
      local.get $a
      local.get $b
      call $cli_strings)

  """
}

/// The run export: main run (the start sequence), a fault reported, then
/// exit 0 (flush_exit0, which ends the run through wasi:cli/exit).
fn rt7_run(start: List[Str], files: Bool) -> Str {
  var b = StrBuilder.new()
  b.write("  (func $run (export \"wasi:cli/run@0.2.0#run\") (result i32)\n")
  for s in start {
    b.write("    ${s}\n")
  }
  b.write("    global.get $faulting\n    if\n      call $fault_report\n    end\n")
  if files {
    b.write("    call $consts_free\n")
  }
  b.write("    call $flush_exit0\n    i32.const 0)\n")
  b.freeze()
}

/// rt.wasi_stdin_read in a preview 1 module: fd_read of descriptor 0.
fn rt7_p1_text() -> Str {
  """
    (func $wasi_stdin_read (param $p i64) (param $n i64) (result i64) (local $io i32) (local $e i32) (local $k i32)
      i32.const 16
      call $alloc
      local.set $io
      local.get $io
      local.get $p
      i32.wrap_i64
      i32.store
      local.get $io
      local.get $n
      i32.wrap_i64
      i32.store offset=4
      i32.const 0
      local.get $io
      i32.const 1
      local.get $io
      i32.const 8
      i32.add
      call $fd_read
      local.set $e
      local.get $io
      i32.load offset=8
      local.set $k
      local.get $io
      call $free
      local.get $e
      if
        i64.const -5
        return
      end
      local.get $k
      i64.extend_i32_u)

  """
}
