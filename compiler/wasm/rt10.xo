        local.get $C
        i32.load offset=12
        local.get $C
        i32.load offset=20
        local.get $C
        i32.load offset=28
        i32.add
        local.get $C
        i32.load offset=24
        local.get $C
        i32.load offset=28
        i32.sub
        call $p3_swrite
        local.tee $c
        i32.const -1
        i32.eq
        if
          local.get $C
          i32.const 64
          call $p3_cflag
          local.get $C
          i32.load offset=12
          i32.const 8
          local.get $C
          local.get $C
          i32.load offset=4
