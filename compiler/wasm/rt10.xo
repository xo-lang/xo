          i32.const 1
          local.get $tns
          local.get $v
          call $p3_ropt_connect
          local.get $opt
          i32.const 1
          local.get $tns
          local.get $v
          call $p3_ropt_first
          local.get $opt
          i32.const 1
          local.get $tns
          local.get $v
