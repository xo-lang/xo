        local.get $C
        i32.load
        i32.const 64
        i32.and
        if
          return
        end
        local.get $C
        i32.load offset=28
        local.get $C
        i32.load offset=24
        i32.ge_u
        if
          local.get $C
          i32.load offset=12
          call $p3_sdrop_w
          local.get $C
          i32.const 0
          i32.store offset=12
          local.get $C
          i32.const 2
          call $p3_cflag
          br $more
