      local.get $C
      i32.load offset=56
      i32.store offset=40
      local.get $C
      i32.load offset=40
      call $p3_resp_code
      i64.extend_i32_u)

    ;; the fields of the response wasi_http_send kept
    (func $wasi_http_resp_headers (result i32 i32) (local $C i32)
      global.get $cur
      i32.load offset=228
      local.tee $C
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      local.get $C
      i32.load offset=40
      call $p3_resp_headers
      call $fields_bytes)

    ;; a response body read's code
    (func $p3_c_rx_note (param $C i32) (param $c i32)
      local.get $C
      i32.const 16
      call $p3_cunflag
      local.get $C
      local.get $C
      i32.load offset=104
      local.get $c
      i32.const 4
      i32.shr_u
      i32.add
      i32.store offset=104
      local.get $c
      i32.const 15
      i32.and
      if
        local.get $C
        i32.const 32
        call $p3_cflag
        local.get $C
        i32.load offset=96
        call $p3_sdrop_r
        local.get $C
        i32.const 0
        i32.store offset=96
      end)

    ;; its body, read to the end (the task waits, its call repeating); the
    ;; response is consumed, its trailers dropped, and its done future told
    ;; the body was read
    (func $wasi_http_resp_body (result i32 i32) (local $C i32) (local $d i64) (local $r i32) (local $k i32) (local $o i32) (local $c i32)
      ;; a resumption's rewind ends here
      call $resumed
      drop
      global.get $cur
      i32.load offset=228
      local.tee $C
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      local.get $C
      i32.load offset=116
      i32.eqz
      if
        call $p3_dnew
        local.set $d
        local.get $C
        i32.const 48
        i32.add
        local.set $r
        local.get $C
        i32.load offset=40
        local.get $d
        i32.wrap_i64
        local.get $r
        call $p3_resp_consume
        local.get $r
        i32.load offset=4
        call $p3_tdrop_r
        local.get $C
        local.get $r
        i32.load
        i32.store offset=96
        local.get $C
        local.get $d
        i64.const 32
        i64.shr_u
        i32.wrap_i64
        i32.store offset=112
        local.get $C
        i32.const 1
        i32.store offset=116
      end
      block $read
        loop $more
          local.get $C
          i32.load
          i32.const 32
          i32.and
          br_if $read
          local.get $C
          i32.load
          i32.const 16
          i32.and
          if
            local.get $C
            i32.const 44
            i32.add
            call $p3_park
            i32.const 0
            call $rs_new
            i32.const 0
            return
          end
          local.get $C
          i32.load offset=108
          local.get $C
          i32.load offset=104
          i32.sub
          i32.const 16384
          i32.lt_u
          if
            local.get $C
            i32.load offset=108
            i32.const 1
            i32.shl
            local.tee $k
            local.get $C
            i32.load offset=104
            i32.const 65536
            i32.add
            local.tee $o
            local.get $k
            local.get $o
            i32.gt_u
            select
            local.tee $k
            call $alloc
            local.tee $o
            local.get $C
            i32.load offset=100
            local.get $C
            i32.load offset=104
            memory.copy
            local.get $C
            i32.load offset=100
            if
              local.get $C
              i32.load offset=100
              call $free
            end
            local.get $C
            local.get $o
            i32.store offset=100
            local.get $C
            local.get $k
            i32.store offset=108
          end
          local.get $C
          i32.load offset=96
          local.get $C
          i32.load offset=100
          local.get $C
          i32.load offset=104
          i32.add
          local.get $C
          i32.load offset=108
          local.get $C
          i32.load offset=104
          i32.sub
          call $p3_sread
          local.tee $c
          i32.const -1
          i32.eq
          if
            local.get $C
            i32.const 16
            call $p3_cflag
            local.get $C
            i32.load offset=96
            i32.const 10
            local.get $C
            local.get $C
            i32.load offset=4
            call $p3_reg
            br $more
          end
          local.get $C
          local.get $c
          call $p3_c_rx_note
          br $more
        end
      end
      ;; the done future: the body was read
      local.get $C
      i32.load offset=112
      if
        local.get $C
        i32.load
        i32.const 256
        i32.and
        if
          local.get $C
          i32.const 44
          i32.add
          call $p3_park
          i32.const 0
          call $rs_new
          i32.const 0
          return
        end
        local.get $C
        i32.const 128
        i32.add
        i32.const 0
        i32.const 32
        memory.fill
        local.get $C
        i32.load offset=112
        local.get $C
        i32.const 128
        i32.add
        call $p3_dwrite
        i32.const -1
        i32.eq
        if
          local.get $C
          i32.const 256
          call $p3_cflag
          local.get $C
          i32.load offset=112
          i32.const 11
          local.get $C
          local.get $C
          i32.load offset=4
          call $p3_reg
          local.get $C
          i32.const 44
          i32.add
          call $p3_park
          i32.const 0
          call $rs_new
          i32.const 0
          return
        end
        local.get $C
        i32.load offset=112
        call $p3_ddrop_w
        local.get $C
        i32.const 0
        i32.store offset=112
      end
      local.get $C
      i32.load offset=104
      local.tee $k
      call $rs_new
      local.tee $o
      i32.const 8
      i32.add
      local.get $C
      i32.load offset=100
      local.get $k
      memory.copy
      local.get $C
      i32.const 2
      i32.store offset=116
      local.get $C
      call $p3_c_free
      global.get $cur
      i32.const 0
      i32.store offset=228
      local.get $o
      local.get $k)

    ;; an outgoing request's event (kinds 7 to 11 of $p3_dispatch)
    (func $p3_cdispatch (param $k i32) (param $o i32) (param $w i32) (param $code i32)
      block $c11
      block $c10
      block $c9
      block $c8
      block $c7
        local.get $k
        i32.const 7
        i32.sub
        br_table $c7 $c8 $c9 $c10 $c11
      end
      ;; 7: send returned
      local.get $o
      i32.const 1
      call $p3_cflag
      local.get $w
      call $p3_subtask_drop
      local.get $o
      i32.const 0
      i32.store offset=8
      local.get $o
      i32.load offset=44
      call $p3_wake
      return
      end
      ;; 8: an outgoing body write
      local.get $o
      local.get $code
      call $p3_c_note
      local.get $o
      call $p3_c_pump
      local.get $o
      i32.load offset=44
      call $p3_wake
      return
      end
      ;; 9: its trailers
      local.get $o
      call $p3_c_trailed
      local.get $o
      i32.load offset=44
      call $p3_wake
      return
      end
      ;; 10: a response body read
      local.get $o
      local.get $code
      call $p3_c_rx_note
      local.get $o
      i32.load offset=44
      call $p3_wake
      return
      end
      ;; 11: the response's done future
      local.get $o
      i32.const 256
      call $p3_cunflag
      local.get $o
      i32.load offset=112
      call $p3_ddrop_w
      local.get $o
      i32.const 0
      i32.store offset=112
      local.get $o
      i32.load offset=44
      call $p3_wake)

  """
}
