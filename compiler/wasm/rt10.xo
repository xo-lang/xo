// The runtime of the WebAssembly backend for a WASI 0.3 wasi:http
// component (wasip3/wasm, decision 0447 stage 5): the program is the core
// module of a component exporting `wasi:http/handler@0.3.0`'s async handle,
// lifted with a callback (componentp3.xo). handle keeps the request's
// method, path, authority and fields, consumes it (a body stream and a
// trailers future), and runs main inside the export (it builds its router
// and calls serve_component, as on wasip2). The response head goes back
// through task.return; its body and trailers go to the stream and future
// the response was made with, as main writes them, and a handle_stream
// route reads the request body as it arrives. A read or write the host
// cannot finish at once waits in place: its waitable joins the set,
// waitable-set.wait blocks until it is done (both wasmtime and Spin allow
// a blocking wait in a callback-lifted export, step 2, 2026-11-03), and it
// leaves the set again. The request getters, fields and the 500 are
// rt5.xo's, whose 0.2 imports rt10's map to their 0.3 functions of the same
// flat forms.

/// rt10's imports: rt5's names for the 0.3 functions of the same flat
/// forms, the 0.2 stream functions rt6.xo's output writes with, the rest of wasi:http/types@0.3.0 it calls, and the async ABI's
/// built-ins (component.xo writes them for the module "$p3").
fn rt10_imports() -> Str {
  """
    (import "wasi:http/types@0.3.0" "[method]request.get-method" (func $ireq_method (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.get-path-with-query" (func $ireq_path (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.get-authority" (func $ireq_authority (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.get-headers" (func $ireq_headers (param i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]fields.copy-all" (func $fields_entries (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[resource-drop]fields" (func $fields_drop (param i32)))
    (import "wasi:http/types@0.3.0" "[constructor]fields" (func $fields_new (result i32)))
    (import "wasi:http/types@0.3.0" "[method]fields.append" (func $fields_append (param i32 i32 i32 i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[static]request.consume-body" (func $p3_consume (param i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[static]response.new" (func $p3_resp_new (param i32 i32 i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]response.set-status-code" (func $p3_resp_status (param i32 i32) (result i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.blocking-write-and-flush" (func $ostream_write (param i32 i32 i32 i32)))
    (import "wasi:io/streams@0.2.0" "[resource-drop]output-stream" (func $ostream_drop (param i32)))
    (import "wasi:io/error@0.2.0" "[resource-drop]error" (func $ioerr_drop (param i32)))
    (import "$p3" "[stream-new]" (func $p3_snew (result i64)))
    (import "$p3" "[stream-read]" (func $p3_sread (param i32 i32 i32) (result i32)))
    (import "$p3" "[stream-write]" (func $p3_swrite (param i32 i32 i32) (result i32)))
    (import "$p3" "[stream-drop-readable]" (func $p3_sdrop_r (param i32)))
    (import "$p3" "[stream-drop-writable]" (func $p3_sdrop_w (param i32)))
    (import "$p3" "[future-new-trailers]" (func $p3_tnew (result i64)))
    (import "$p3" "[future-read-trailers]" (func $p3_tread (param i32 i32) (result i32)))
    (import "$p3" "[future-write-trailers]" (func $p3_twrite (param i32 i32) (result i32)))
    (import "$p3" "[future-drop-readable-trailers]" (func $p3_tdrop_r (param i32)))
    (import "$p3" "[future-drop-writable-trailers]" (func $p3_tdrop_w (param i32)))
    (import "$p3" "[future-new-done]" (func $p3_dnew (result i64)))
    (import "$p3" "[future-write-done]" (func $p3_dwrite (param i32 i32) (result i32)))
    (import "$p3" "[future-drop-readable-done]" (func $p3_ddrop_r (param i32)))
    (import "$p3" "[future-drop-writable-done]" (func $p3_ddrop_w (param i32)))
    (import "$p3" "[task-return]" (func $p3_return (param i32 i32 i32 i64 i32 i32 i32 i32)))
    (import "$p3" "[waitable-set-new]" (func $p3_wsnew (result i32)))
    (import "$p3" "[waitable-join]" (func $p3_join (param i32 i32)))
    (import "$p3" "[waitable-set-wait]" (func $p3_wswait (param i32 i32) (result i32)))
    (import "$p3" "[waitable-set-drop]" (func $p3_wsdrop (param i32)))
    (import "$p3" "[backpressure-inc]" (func $p3_bp_inc))
    (import "$p3" "[backpressure-dec]" (func $p3_bp_dec))

  """
}

/// rt10's imports for a program's outgoing requests (wasi:http/client's
/// send, lowered async, and the parts of a request and a response).
fn rt10_client_imports() -> Str {
  """
    (import "wasi:http/types@0.3.0" "[static]request.new" (func $p3_req_new (param i32 i32 i32 i32 i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-method" (func $p3_req_method (param i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-scheme" (func $p3_req_scheme (param i32 i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-authority" (func $p3_req_authority (param i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-path-with-query" (func $p3_req_path (param i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[resource-drop]request" (func $p3_req_drop (param i32)))
    (import "wasi:http/types@0.3.0" "[constructor]request-options" (func $p3_ropt_new (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request-options.set-connect-timeout" (func $p3_ropt_connect (param i32 i32 i64 i32)))
    (import "wasi:http/types@0.3.0" "[method]request-options.set-first-byte-timeout" (func $p3_ropt_first (param i32 i32 i64 i32)))
    (import "wasi:http/types@0.3.0" "[method]request-options.set-between-bytes-timeout" (func $p3_ropt_between (param i32 i32 i64 i32)))
    (import "wasi:http/types@0.3.0" "[method]response.get-status-code" (func $p3_resp_code (param i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]response.get-headers" (func $p3_resp_headers (param i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[static]response.consume-body" (func $p3_resp_consume (param i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[resource-drop]response" (func $p3_resp_drop (param i32)))
    (import "wasi:http/client@0.3.0" "[async-lower]send" (func $p3_send (param i32 i32) (result i32)))
    (import "$p3" "[subtask-drop]" (func $p3_subtask_drop (param i32)))

  """
}

/// The globals of rt10.xo (with rt5.xo's).
fn rt10_globals() -> Str {
  """
    ;; the waitable set of a blocked read or write, and the event
    ;; waitable-set.wait writes (8 bytes)
    (global $p3ws (mut i32) (i32.const 0))
    (global $p3ev (mut i32) (i32.const 0))
    ;; the request: its fields as rt5's getters returned them, kept for
    ;; main (taken once; consume-body ends the request)
    (global $p3m (mut i32) (i32.const 0))
    (global $p3mn (mut i32) (i32.const 0))
    (global $p3p (mut i32) (i32.const 0))
    (global $p3pn (mut i32) (i32.const 0))
    (global $p3a (mut i32) (i32.const 0))
    (global $p3an (mut i32) (i32.const 0))
    (global $p3h (mut i32) (i32.const 0))
    (global $p3hn (mut i32) (i32.const 0))
    ;; its body stream (0 once it ended and was dropped), its trailers
    ;; future (0 once read or dropped), and the done future's writable end
    (global $p3rx (mut i32) (i32.const 0))
    (global $p3trx (mut i32) (i32.const 0))
    (global $p3dtx (mut i32) (i32.const 0))
    ;; the response: its body stream's and trailers future's writable ends,
    ;; 1 when the host dropped the body stream, 1 once the body ended, and
    ;; a 32 byte value area (a future's payload: ok(none) zeroed, or
    ;; ok(some(fields)))
    (global $p3tx (mut i32) (i32.const 0))
    (global $p3ftx (mut i32) (i32.const 0))
    (global $p3wdrop (mut i32) (i32.const 0))
    (global $p3ended (mut i32) (i32.const 0))
    (global $p3tr (mut i32) (i32.const 0))
    ;; an outgoing request's 32 byte value area (send's result, its
    ;; trailers' ok(none))
    (global $p3cv (mut i32) (i32.const 0))

  """
}

/// rt5.xo's functions that rt10.xo replaces: their definitions renamed
/// (strip_runtime drops them), so the calls of the rest bind to rt10's.
fn rt10_rt5(var g: Gen) -> Str {
  var t = rt5_text(g)
  for n in ["wasi_http_method", "wasi_http_path", "wasi_http_authority", "wasi_http_headers", "wasi_http_body", "wasi_http_body_read", "wasi_http_body_trailers", "wasi_http_head", "wasi_http_write", "wasi_http_end", "handle_end", "wasi_http_send", "wasi_http_resp_headers", "wasi_http_resp_body"] {
    let o = "(func \$${n} "
    let o2 = "(func \$${n}\n"
    if !t.contains(o) && !t.contains(o2) {
      fault("rt10_rt5: rt5.xo has no ${n}")
    }
    t = t.replace(o, "(func \$rt5_${n} ").replace(o2, "(func \$rt5_${n}\n")
  }
  t
}

/// The functions of rt10.xo (with rt10_rt5's text).
fn rt10_text(var g: Gen) -> Str {
  let e500 = g.str_obj("internal error".bytes())
  // the 500's fields in wasi_http_respond's form (rt5_text's)
  var hb = BytesBuilder.new()
  hb.write("content-type".bytes())
  hb.write_byte(0)
  hb.write("text/plain; charset=utf-8".bytes())
  hb.write_byte(0)
  let h500b = hb.freeze()
  let h500 = g.str_obj(h500b)
  rt10_rt5(g) + """
    ;; the request's getters: what handle kept, given to the first caller
    ;; (serve_component calls each once), else empty
    (func $wasi_http_method (result i32 i32)
      global.get $p3m
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      global.get $p3m
      global.get $p3mn
      i32.const 0
      global.set $p3m)

    (func $wasi_http_path (result i32 i32)
      global.get $p3p
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      global.get $p3p
      global.get $p3pn
      i32.const 0
      global.set $p3p)

    (func $wasi_http_authority (result i32 i32)
      global.get $p3a
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      global.get $p3a
      global.get $p3an
      i32.const 0
      global.set $p3a)

    (func $wasi_http_headers (result i32 i32)
      global.get $p3h
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      global.get $p3h
      global.get $p3hn
      i32.const 0
      global.set $p3h)

    ;; w's operation, which returned BLOCKED, waited for: its code
    ;; (count << 4 | status)
    (func $p3_block (param $w i32) (result i32)
      local.get $w
      global.get $p3ws
      call $p3_join
      global.get $p3ws
      global.get $p3ev
      call $p3_wswait
      drop
      local.get $w
      i32.const 0
      call $p3_join
      global.get $p3ev
      i32.load offset=4)

    ;; stream rx's read of at most n bytes to a, waited for when blocked:
    ;; its code (count << 4 | status)
    (func $p3_sread_at (param $rx i32) (param $a i32) (param $n i32) (result i32) (local $r i32)
      local.get $rx
      local.get $a
      local.get $n
      call $p3_sread
      local.tee $r
      i32.const -1
      i32.eq
      if
        local.get $rx
        call $p3_block
        local.set $r
      end
      local.get $r)

    ;; stream rx read to its end and dropped: a Bytes object
    (func $p3_read_all (param $rx i32) (result i32 i32) (local $buf i32) (local $len i32) (local $cap i32) (local $k i32) (local $o i32)
      block $end
        loop $more
          local.get $cap
          local.get $len
          i32.sub
          i32.const 16384
          i32.lt_u
          if
            local.get $cap
            i32.const 1
            i32.shl
            local.tee $k
            local.get $len
            i32.const 65536
            i32.add
            local.tee $o
            local.get $k
            local.get $o
            i32.gt_u
            select
            local.tee $cap
            call $alloc
            local.tee $o
            local.get $buf
            local.get $len
            memory.copy
            local.get $buf
            if
              local.get $buf
              call $free
            end
            local.get $o
            local.set $buf
          end
          local.get $rx
          local.get $buf
          local.get $len
          i32.add
          local.get $cap
          local.get $len
          i32.sub
          call $p3_sread_at
          local.tee $k
          i32.const 4
          i32.shr_u
          local.get $len
          i32.add
          local.set $len
          local.get $k
          i32.const 15
          i32.and
          br_if $end
          br $more
        end
      end
      local.get $rx
      call $p3_sdrop_r
      local.get $len
      call $rs_new
      local.tee $o
      i32.const 8
      i32.add
      local.get $buf
      local.get $len
      memory.copy
      local.get $buf
      if
        local.get $buf
        call $free
      end
      local.get $o
      local.get $len)

    ;; future f's write of the value at v, waited for when blocked; then
    ;; its writable end dropped (trailers is 1 for a trailers future, 0
    ;; for a done future)
    (func $p3_fput (param $f i32) (param $v i32) (param $trailers i32)
      local.get $trailers
      if
        local.get $f
        local.get $v
        call $p3_twrite
        i32.const -1
        i32.eq
        if
          local.get $f
          call $p3_block
          drop
        end
        local.get $f
        call $p3_tdrop_w
      else
        local.get $f
        local.get $v
        call $p3_dwrite
        i32.const -1
        i32.eq
        if
          local.get $f
          call $p3_block
          drop
        end
        local.get $f
        call $p3_ddrop_w
      end)

    ;; at most n bytes of the request body to a: the count, or -1 at its
    ;; end (the stream is then dropped)
    (func $p3_read (param $a i32) (param $n i32) (result i32) (local $r i32)
      loop $again
        global.get $p3rx
        i32.eqz
        if
          i32.const -1
          return
        end
        global.get $p3rx
        local.get $a
        local.get $n
        call $p3_sread_at
        local.tee $r
        i32.const 15
        i32.and
        if
          ;; the writer dropped its end (or the read was cancelled)
          global.get $p3rx
          call $p3_sdrop_r
          i32.const 0
          global.set $p3rx
        end
        local.get $r
        i32.const 4
        i32.shr_u
        local.tee $r
        if
          local.get $r
          return
        end
        br $again
      end
      i32.const -1)

    ;; the request's body: a Bytes object of the stream read to its end
    (func $wasi_http_body (result i32 i32) (local $buf i32) (local $len i32) (local $cap i32) (local $k i32) (local $o i32)
      block $end
        loop $more
          local.get $cap
          local.get $len
          i32.sub
          i32.const 16384
          i32.lt_u
          if
            local.get $cap
            i32.const 1
            i32.shl
            local.tee $k
            local.get $len
            i32.const 65536
            i32.add
            local.tee $o
            local.get $k
            local.get $o
            i32.gt_u
            select
            local.tee $cap
            call $alloc
            local.tee $o
            local.get $buf
            local.get $len
            memory.copy
            local.get $buf
            if
              local.get $buf
              call $free
            end
            local.get $o
            local.set $buf
          end
          local.get $buf
          local.get $len
          i32.add
          local.get $cap
          local.get $len
          i32.sub
          call $p3_read
          local.tee $k
          i32.const 0
          i32.lt_s
          br_if $end
          local.get $len
          local.get $k
          i32.add
          local.set $len
          br $more
        end
      end
      local.get $len
      call $rs_new
      local.tee $o
      i32.const 8
      i32.add
      local.get $buf
      local.get $len
      memory.copy
      local.get $buf
      if
        local.get $buf
        call $free
      end
      local.get $o
      local.get $len)

    ;; a handle_stream route's next read of the request body: at most max
    ;; bytes (1 MiB at most) as they arrive, empty at its end
    (func $wasi_http_body_read (param $max i64) (result i32 i32) (local $m i32) (local $o i32) (local $k i32)
      local.get $max
      i64.const 1048576
      i64.gt_s
      if (result i32)
        i32.const 1048576
      else
        local.get $max
        i32.wrap_i64
      end
      local.tee $m
      call $rs_new
      local.tee $o
      i32.const 8
      i32.add
      local.get $m
      call $p3_read
      local.tee $k
      i32.const 0
      i32.lt_s
      if
        i32.const 0
        local.set $k
      end
      local.get $o
      local.get $k)

    ;; the request's trailers (in the headers' form), once its body is read
    ;; to the end (the rest is read and dropped); empty when there are none
    (func $wasi_http_body_trailers (result i32 i32) (local $r i32) (local $t i32)
      block $drained
        loop $drain
          global.get $p3rx
          i32.eqz
          br_if $drained
          global.get $p3tr
          i32.const 32
          call $p3_read
          drop
          br $drain
        end
      end
      global.get $p3trx
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      global.get $p3tr
      i32.const 0
      i32.const 32
      memory.fill
      global.get $p3trx
      global.get $p3tr
      call $p3_tread
      i32.const -1
      i32.eq
      if
        global.get $p3trx
        call $p3_block
        drop
      end
      global.get $p3trx
      call $p3_tdrop_r
      i32.const 0
      global.set $p3trx
      ;; result<option<own<trailers>>, error-code>: ok's case at 0, the
      ;; option's at 8, the trailers at 12
      global.get $p3tr
      i32.load8_u
      global.get $p3tr
      i32.load8_u offset=8
      i32.eqz
      i32.or
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      global.get $p3tr
      i32.load offset=12
      local.set $t
      global.get $p3tr
      i32.const 0
      i32.const 32
      memory.fill
      local.get $t
      call $fields_bytes)

    ;; the response's head: made with a body stream and a trailers future,
    ;; its status set, and given to the host (task.return(ok(response)))
    (func $wasi_http_head (param $status i64) (param $h i32) (param $hn i32) (local $f i32) (local $s i64) (local $t i64) (local $r i32)
      local.get $h
      local.get $hn
      call $fields_of
      local.set $f
      call $p3_snew
      local.tee $s
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      global.set $p3tx
      call $p3_tnew
      local.tee $t
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      global.set $p3ftx
      call $hret_at
      local.set $r
      ;; response.new(headers, some(body), trailers) -> (response, done)
      local.get $f
      i32.const 1
      local.get $s
      i32.wrap_i64
      local.get $t
      i32.wrap_i64
      local.get $r
      call $p3_resp_new
      local.get $r
      i32.load offset=4
      call $p3_ddrop_r
      local.get $r
      i32.load
      local.get $status
      i32.wrap_i64
      call $p3_resp_status
      drop
      ;; result<own<response>, error-code>: ok (0), the response, then
      ;; error-code's joined payload slots, zero
      i32.const 0
      local.get $r
      i32.load
      i32.const 0
      i64.const 0
      i32.const 0
      i32.const 0
      i32.const 0
      i32.const 0
      call $p3_return
      ;; answered: a fault after this point ends the body, not a 500
      i32.const 1
      global.set $hdone)

    ;; Bytes object b's bn bytes of the response body, written as they come
    ;; (dropped when the host dropped the stream)
    (func $wasi_http_write (param $b i32) (param $bn i32) (local $off i32) (local $r i32)
      block $done
        loop $more
          global.get $p3wdrop
          br_if $done
          local.get $off
          local.get $bn
          i32.ge_u
          br_if $done
          global.get $p3tx
          local.get $b
          i32.const 8
          i32.add
          local.get $off
          i32.add
          local.get $bn
          local.get $off
          i32.sub
          call $p3_swrite
          local.tee $r
          i32.const -1
          i32.eq
          if
            global.get $p3tx
            call $p3_block
            local.set $r
          end
          local.get $off
          local.get $r
          i32.const 4
          i32.shr_u
          i32.add
          local.set $off
          local.get $r
          i32.const 15
          i32.and
          if
            i32.const 1
            global.set $p3wdrop
          end
          br $more
        end
      end)

    ;; the body's end: its stream closed and the trailers (in the headers'
    ;; form) written to their future, ok(some(fields)) when there are any,
    ;; else ok(none)
    (func $wasi_http_end (param $t i32) (param $tn i32)
      global.get $p3ended
      if
        return
      end
      i32.const 1
      global.set $p3ended
      global.get $p3tx
      call $p3_sdrop_w
      global.get $p3tr
      i32.const 0
      i32.const 32
      memory.fill
      local.get $tn
      if
        global.get $p3tr
        i32.const 1
        i32.store8 offset=8
        global.get $p3tr
        local.get $t
        local.get $tn
        call $fields_of
        i32.store offset=12
      end
      global.get $p3ftx
      global.get $p3tr
      call $p3_twrite
      i32.const -1
      i32.eq
      if
        global.get $p3ftx
        call $p3_block
        drop
      end
      global.get $p3ftx
      call $p3_tdrop_w)

    ;; an outgoing request (std/native/http.xo wasi_send, as rt5.xo's):
    ;; method (mk, the variant's case; 9 names it in m), scheme (0 HTTP, 1
    ;; HTTPS), authority, path with query, fields, the whole body, a
    ;; timeout in ns for each of the host's three (0 none). client.send
    ;; runs as a subtask while the body is written to the request's stream;
    ;; then it is waited for. The status, the response kept for the next
    ;; two calls; below zero: -1 the host refused a part of the request,
    ;; -(100 + the error-code's case) the request failed.
    (func $wasi_http_send (param $mk i64) (param $m i32) (param $mn i32) (param $sk i64) (param $au i32) (param $aun i32) (param $pq i32) (param $pqn i32) (param $h i32) (param $hn i32) (param $b i32) (param $bn i32) (param $tns i64) (result i64) (local $f i32) (local $s i64) (local $t i64) (local $opt i32) (local $q i32) (local $v i32) (local $bad i32) (local $st i32) (local $sub i32) (local $off i32) (local $r i32)
      global.get $p3cv
      i32.eqz
      if
        i32.const 32
        call $alloc
        global.set $p3cv
      end
      global.get $p3cv
      local.set $v
      local.get $h
      local.get $hn
      call $fields_of
      local.set $f
      call $p3_snew
      local.set $s
      call $p3_tnew
      local.set $t
      local.get $tns
      i64.const 0
      i64.gt_s
      if
        call $p3_ropt_new
        local.tee $opt
        i32.const 1
        local.get $tns
        local.get $v
        call $p3_ropt_connect
        local.get $opt
        i32.const 1
        local.get $tns
        local.get $v
        call $p3_ropt_first
        local.get $opt
        i32.const 1
        local.get $tns
        local.get $v
        call $p3_ropt_between
      end
      ;; request.new(headers, some(body), trailers, options) -> (request,
      ;; done); when it was sent is not needed
      local.get $f
      i32.const 1
      local.get $s
      i32.wrap_i64
      local.get $t
      i32.wrap_i64
      local.get $opt
      i32.const 0
      i32.ne
      local.get $opt
      local.get $v
      call $p3_req_new
      local.get $v
      i32.load
      local.set $q
      local.get $v
      i32.load offset=4
      call $p3_ddrop_r
      local.get $q
      ;; a Str's bytes are 8 past its object
      local.get $mk
      i32.wrap_i64
      local.get $m
      i32.const 8
      i32.add
      local.get $mn
      call $p3_req_method
      local.get $q
      i32.const 1
      local.get $sk
      i32.wrap_i64
      i32.const 0
      i32.const 0
      call $p3_req_scheme
      i32.or
      local.get $q
      i32.const 1
      local.get $au
      i32.const 8
      i32.add
      local.get $aun
      call $p3_req_authority
      i32.or
      local.get $q
      i32.const 1
      local.get $pq
      i32.const 8
      i32.add
      local.get $pqn
      call $p3_req_path
      i32.or
      local.set $bad
      local.get $bad
      if
        local.get $q
        call $p3_req_drop
        local.get $s
        i64.const 32
        i64.shr_u
        i32.wrap_i64
        call $p3_sdrop_w
        ;; a future's writer is dropped only after its value is written
        global.get $p3cv
        i32.const 0
        i32.const 32
        memory.fill
        local.get $t
        i64.const 32
        i64.shr_u
        i32.wrap_i64
        global.get $p3cv
        i32.const 1
        call $p3_fput
        i64.const -1
        return
      end
      ;; send(request) as a subtask: STARTED (1) or RETURNED (2) in the low
      ;; bits, the subtask above them
      local.get $q
      local.get $v
      call $p3_send
      local.tee $st
      i32.const 4
      i32.shr_u
      local.set $sub
      local.get $st
      i32.const 15
      i32.and
      local.set $st
      ;; the body, then the trailers: ok(none)
      block $done
        loop $more
          local.get $off
          local.get $bn
          i32.ge_u
          br_if $done
          local.get $s
          i64.const 32
          i64.shr_u
          i32.wrap_i64
          local.get $b
          i32.const 8
          i32.add
          local.get $off
          i32.add
          local.get $bn
          local.get $off
          i32.sub
          call $p3_swrite
          local.tee $r
          i32.const -1
          i32.eq
          if
            local.get $s
            i64.const 32
            i64.shr_u
            i32.wrap_i64
            call $p3_block
            local.set $r
          end
          local.get $off
          local.get $r
          i32.const 4
          i32.shr_u
          i32.add
          local.set $off
          local.get $r
          i32.const 15
          i32.and
          br_if $done
          br $more
        end
      end
      local.get $s
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      call $p3_sdrop_w
      global.get $p3tr
      i32.eqz
      if
        i32.const 32
        call $alloc
        global.set $p3tr
      end
      global.get $p3tr
      i32.const 0
      i32.const 32
      memory.fill
      local.get $t
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      global.get $p3tr
      i32.const 1
      call $p3_fput
      ;; the subtask until it returned (2); its result is then at v
      block $returned
        loop $wait
          local.get $st
          i32.const 2
          i32.ge_u
          br_if $returned
          local.get $sub
          call $p3_block
          local.set $st
          br $wait
        end
      end
      local.get $sub
      if
        local.get $sub
        call $p3_subtask_drop
      end
      ;; result<own<response>, error-code>: the case, then at 8 the
      ;; response or the error-code's case
      local.get $v
      i32.load8_u
      if
        i64.const -100
        local.get $v
        i64.load8_u offset=8
        i64.sub
        return
      end
      local.get $v
      i32.load offset=8
      global.set $hresp
      global.get $hresp
      call $p3_resp_code
      i64.extend_i32_u)

    ;; the fields of the response wasi_http_send kept
    (func $wasi_http_resp_headers (result i32 i32)
      global.get $hresp
      call $p3_resp_headers
      call $fields_bytes)

    ;; its body, read to the end; the response is consumed, its trailers
    ;; dropped, and its done future told the body was read
    (func $wasi_http_resp_body (result i32 i32) (local $d i64) (local $r i32) (local $o i32) (local $n i32)
      call $p3_dnew
      local.set $d
      global.get $p3cv
      local.set $r
      global.get $hresp
      local.get $d
      i32.wrap_i64
      local.get $r
      call $p3_resp_consume
      i32.const 0
      global.set $hresp
      local.get $r
      i32.load offset=4
      call $p3_tdrop_r
      local.get $r
      i32.load
      call $p3_read_all
      local.set $n
      local.set $o
      global.get $p3cv
      i32.const 0
      i32.const 32
      memory.fill
      local.get $d
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      global.get $p3cv
      i32.const 0
      call $p3_fput
      local.get $o
      local.get $n)

    ;; after main: a fault is reported, a request main did not answer gets
    ;; 500, a body main did not end is ended; the request's body and
    ;; trailers left unread are dropped, and its done future says it was
    ;; consumed
    (func $handle_end
      global.get $faulting
      if
        call $fault_report
      end
      global.get $hdone
      i32.eqz
      if
        i64.const 500
        i32.const ${h500}
        i32.const ${h500b.len()}
        i32.const ${e500}
        i32.const 14
        i32.const 0
        i32.const 0
        call $wasi_http_respond
      end
      i32.const 0
      i32.const 0
      call $wasi_http_end
      global.get $p3rx
      if
        global.get $p3rx
        call $p3_sdrop_r
        i32.const 0
        global.set $p3rx
      end
      global.get $p3trx
      if
        global.get $p3trx
        call $p3_tdrop_r
        i32.const 0
        global.set $p3trx
      end
      global.get $p3tr
      i32.const 0
      i32.const 32
      memory.fill
      global.get $p3dtx
      global.get $p3tr
      call $p3_dwrite
      i32.const -1
      i32.eq
      if
        global.get $p3dtx
        call $p3_block
        drop
      end
      global.get $p3dtx
      call $p3_ddrop_w)

  """
}

/// The handle export and its callback, and $p3_main: main run (the start
/// sequence), then handle_end.
fn rt10_handle(start: List[Str]) -> Str {
  var b = StrBuilder.new()
  b.write("  (func $p3_main\n")
  for s in start {
    b.write("    ${s}\n")
  }
  b.write("    call $handle_end)\n")
  b.write("""
  (func $p3_handle (export "[async-lift]wasi:http/handler@0.3.0#handle") (param $req i32) (result i32) (local $d i64) (local $r i32)
    ;; one request at a time in an instance: the host starts the next
    ;; handle when this one returns, on a fresh state
    call $p3_bp_inc
    local.get $req
    global.set $hreq
    i32.const 0
    global.set $hdone
    i32.const 0
    global.set $p3wdrop
    i32.const 0
    global.set $p3ended
    ;; what main reads of the request, before consume-body ends it
    call $rt5_wasi_http_method
    global.set $p3mn
    global.set $p3m
    call $rt5_wasi_http_path
    global.set $p3pn
    global.set $p3p
    call $rt5_wasi_http_authority
    global.set $p3an
    global.set $p3a
    call $rt5_wasi_http_headers
    global.set $p3hn
    global.set $p3h
    global.get $p3tr
    i32.eqz
    if
      i32.const 32
      call $alloc
      global.set $p3tr
      i32.const 8
      call $alloc
      global.set $p3ev
    end
    call $p3_wsnew
    global.set $p3ws
    ;; consume-body(request, done) -> (body, trailers)
    call $p3_dnew
    local.tee $d
    i64.const 32
    i64.shr_u
    i32.wrap_i64
    global.set $p3dtx
    call $hret_at
    local.set $r
    global.get $hreq
    local.get $d
    i32.wrap_i64
    local.get $r
    call $p3_consume
    local.get $r
    i32.load
    global.set $p3rx
    local.get $r
    i32.load offset=4
    global.set $p3trx
    i32.const 0
    global.set $hreq
    call $p3_main
    global.get $p3ws
    call $p3_wsdrop
    call $p3_bp_dec
    ;; EXIT: the task returned (task.return) and its work is done
    i32.const 0)

  ;; handle never returns WAIT, so the host never calls this
  (func $p3_callback (export "[callback][async-lift]wasi:http/handler@0.3.0#handle") (param $ev i32) (param $w i32) (param $code i32) (result i32)
    i32.const 0)

""")
  b.freeze()
}
