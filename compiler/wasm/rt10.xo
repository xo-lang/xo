// The runtime of the WebAssembly backend for a WASI 0.3 wasi:http
// component (wasip3/wasm, decision 0447 stage 5): the program is the core
// module of a component exporting `wasi:http/handler@0.3.0`'s async handle,
// lifted with a callback (componentp3.xo). Several requests run at once in
// an instance (step 3): handle keeps the request's method, path,
// authority and fields in a record, consumes the request (a body stream
// and a trailers future), and starts a task of rt3.xo's scheduler that
// runs main (it builds its router and calls serve_component, as on
// wasip2) with the record as its request. The scheduler runs the tasks
// until none can (rt10_sched), and the export or its callback gives the
// host WAIT on the request's waitable set, or EXIT once the request is
// finished. Every host operation is started here and goes on in the
// callback when its event comes (the wait table names each waitable's
// kind and record): the request body is read into the record's buffer
// as tasks want it, the response body is buffered and written as the host
// takes it, and an outgoing request's subtask, body and response have a
// record of their own. A task waits by parking (its call repeats when it
// runs again), and an event wakes only the task that waits for it. The
// response head goes back through task.return in its request's own
// component task: when another request's task makes it, a future made
// for the purpose wakes that task. The request getters, fields and the
// 500 are rt5.xo's, whose 0.2 imports rt10's map to their 0.3 functions
// of the same flat forms.

/// rt10's imports: rt5's names for the 0.3 functions of the same flat
/// forms, the 0.2 stream functions rt6.xo's output writes with, the rest of wasi:http/types@0.3.0 it calls, and the async ABI's
/// built-ins (component.xo writes them for the module "$p3").
fn rt10_imports() -> Str {
  """
    (import "wasi:http/types@0.3.0" "[method]request.get-method" (func $ireq_method (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.get-path-with-query" (func $ireq_path (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.get-authority" (func $ireq_authority (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.get-headers" (func $ireq_headers (param i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]fields.copy-all" (func $fields_entries (param i32 i32)))
    (import "wasi:http/types@0.3.0" "[resource-drop]fields" (func $fields_drop (param i32)))
    (import "wasi:http/types@0.3.0" "[constructor]fields" (func $fields_new (result i32)))
    (import "wasi:http/types@0.3.0" "[method]fields.append" (func $fields_append (param i32 i32 i32 i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[static]request.consume-body" (func $p3_consume (param i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[static]response.new" (func $p3_resp_new (param i32 i32 i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]response.set-status-code" (func $p3_resp_status (param i32 i32) (result i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.blocking-write-and-flush" (func $ostream_write (param i32 i32 i32 i32)))
    (import "wasi:io/streams@0.2.0" "[resource-drop]output-stream" (func $ostream_drop (param i32)))
    (import "wasi:io/error@0.2.0" "[resource-drop]error" (func $ioerr_drop (param i32)))
    (import "$p3" "[stream-new]" (func $p3_snew (result i64)))
    (import "$p3" "[stream-read]" (func $p3_sread (param i32 i32 i32) (result i32)))
    (import "$p3" "[stream-write]" (func $p3_swrite (param i32 i32 i32) (result i32)))
    (import "$p3" "[stream-drop-readable]" (func $p3_sdrop_r (param i32)))
    (import "$p3" "[stream-drop-writable]" (func $p3_sdrop_w (param i32)))
    (import "$p3" "[future-new-trailers]" (func $p3_tnew (result i64)))
    (import "$p3" "[future-read-trailers]" (func $p3_tread (param i32 i32) (result i32)))
    (import "$p3" "[future-write-trailers]" (func $p3_twrite (param i32 i32) (result i32)))
    (import "$p3" "[future-drop-readable-trailers]" (func $p3_tdrop_r (param i32)))
    (import "$p3" "[future-drop-writable-trailers]" (func $p3_tdrop_w (param i32)))
    (import "$p3" "[future-new-done]" (func $p3_dnew (result i64)))
    (import "$p3" "[future-write-done]" (func $p3_dwrite (param i32 i32) (result i32)))
    (import "$p3" "[future-drop-readable-done]" (func $p3_ddrop_r (param i32)))
    (import "$p3" "[future-drop-writable-done]" (func $p3_ddrop_w (param i32)))
    (import "$p3" "[task-return]" (func $p3_return (param i32 i32 i32 i64 i32 i32 i32 i32)))
    (import "$p3" "[waitable-set-new]" (func $p3_wsnew (result i32)))
    (import "$p3" "[waitable-join]" (func $p3_join (param i32 i32)))
    (import "$p3" "[waitable-set-drop]" (func $p3_wsdrop (param i32)))
    (import "$p3" "[context-get]" (func $p3_ctx_get (result i32)))
    (import "$p3" "[context-set]" (func $p3_ctx_set (param i32)))

  """
}

/// rt10's imports for a program's outgoing requests (wasi:http/client's
/// send, lowered async, and the parts of a request and a response).
fn rt10_client_imports() -> Str {
  """
    (import "wasi:http/types@0.3.0" "[static]request.new" (func $p3_req_new (param i32 i32 i32 i32 i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-method" (func $p3_req_method (param i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-scheme" (func $p3_req_scheme (param i32 i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-authority" (func $p3_req_authority (param i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request.set-path-with-query" (func $p3_req_path (param i32 i32 i32 i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[resource-drop]request" (func $p3_req_drop (param i32)))
    (import "wasi:http/types@0.3.0" "[constructor]request-options" (func $p3_ropt_new (result i32)))
    (import "wasi:http/types@0.3.0" "[method]request-options.set-connect-timeout" (func $p3_ropt_connect (param i32 i32 i64 i32)))
    (import "wasi:http/types@0.3.0" "[method]request-options.set-first-byte-timeout" (func $p3_ropt_first (param i32 i32 i64 i32)))
    (import "wasi:http/types@0.3.0" "[method]request-options.set-between-bytes-timeout" (func $p3_ropt_between (param i32 i32 i64 i32)))
    (import "wasi:http/types@0.3.0" "[method]response.get-status-code" (func $p3_resp_code (param i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[method]response.get-headers" (func $p3_resp_headers (param i32) (result i32)))
    (import "wasi:http/types@0.3.0" "[static]response.consume-body" (func $p3_resp_consume (param i32 i32 i32)))
    (import "wasi:http/types@0.3.0" "[resource-drop]response" (func $p3_resp_drop (param i32)))
    (import "wasi:http/client@0.3.0" "[async-lower]send" (func $p3_send (param i32 i32) (result i32)))
    (import "$p3" "[subtask-drop]" (func $p3_subtask_drop (param i32)))

  """
}

/// The globals of rt10.xo (with rt5.xo's).
fn rt10_globals() -> Str {
  """
    ;; the request record of the running task (rt10_sched keeps it in the
    ;; task at 224), and that of the component task whose export or
    ;; callback runs now
    (global $treq (mut i32) (i32.const 0))
    (global $p3ctx (mut i32) (i32.const 0))
    ;; 1 once the first request set the instance up; a zeroed 32 byte
    ;; value (a future's ok(none)); the scope request tasks are in (never
    ;; closed); the wait table ({kind, object} per waitable handle) and
    ;; its capacity; the waitables joined to a set, and the requests whose
    ;; main has not ended
    (global $p3init (mut i32) (i32.const 0))
    (global $p3zero (mut i32) (i32.const 0))
    (global $p3scope (mut i32) (i32.const 0))
    (global $p3wt (mut i32) (i32.const 0))
    (global $p3wcap (mut i32) (i32.const 0))
    (global $p3nreg (mut i32) (i32.const 0))
    (global $p3live (mut i32) (i32.const 0))

  """
}

/// The calls of rt10.xo that can suspend the task (its call repeats when
/// the task runs again).
fn rt10_blocking(name: Str) -> Bool {
  name is "rt.wasi_http_body" | "rt.wasi_http_body_read" | "rt.wasi_http_body_trailers" | "rt.wasi_http_write" | "rt.wasi_http_send" | "rt.wasi_http_resp_body"
}

/// rt3.xo's text for a wasip3/wasm component (stage 5 step 3): requests
/// run as tasks, several at once. A task has 8 more bytes (224 the request
/// record of its task tree, $treq while it runs, kept and inherited as its
/// deadline is; 228 its outgoing request, rt10_text's client record); the
/// scheduler's start runs once per instance
/// and main is not one of its tasks (each request's task runs main); and
/// at its idle step the scheduler returns to the export or callback that
/// ran it ($p3_idle), which gives the host WAIT on the request's set.
fn rt10_sched(rt3: Str) -> Str {
  var out = StrBuilder.new()
  let ls = rt3.lines()
  var n_size = 0
  var n_in = 0
  var n_out = 0
  var in_sched = false
  var guarded = false
  var idle = false
  var in_end = false
  var n_wake = 0
  for (i, l) in ls.indexed() {
    let t = l.trim()
    let ind = l[0..l.len() - l.trim_start().len()]
    if t.starts_with("(func $sched ") {
      in_sched = true
      out.write(l)
      out.write("\n${ind}  global.get $mtask\n${ind}  i32.eqz\n${ind}  if\n")
      continue
    }
    if t.starts_with("(func ") {
      in_end = t.starts_with("(func $task_end ")
    }
    // a request's task ending wakes no other task: its scope is never
    // awaited (a wake makes every blocked task repeat its call)
    if in_end && t == "call $wake)" {
      out.write("${ind}local.get $s\n${ind}global.get $p3scope\n${ind}i32.ne\n${ind}if\n${ind}  call $wake\n${ind}end)\n")
      n_wake += 1
      continue
    }
    if in_sched && !guarded && t == "local.get $m" && i + 1 < ls.len() && ls[i + 1].trim() == "call $act_push" {
      continue
    }
    if in_sched && !guarded && t == "call $act_push" {
      out.write("${ind}end\n")
      guarded = true
      continue
    }
    if in_sched && !idle && t == "call $next_deadline" && i > 0 && ls[i - 1].trim() == "br_if $round" {
      out.write("${ind}call $p3_idle\n${ind}if\n${ind}  return\n${ind}end\n")
      idle = true
    }
    if t == "i32.const 224" && i + 2 < ls.len() && ls[i + 1].trim().starts_with("i32.const ") && ls[i + 2].trim() == "call $obj_new" {
      out.write("${ind}i32.const 232\n")
      n_size += 1
      continue
    }
    out.write(l)
    out.write("\n")
    if t == "global.set $tdl" && i > 0 && ls[i - 1].trim() == "i64.load offset=200" {
      out.write("${ind}local.get $t\n${ind}i32.load offset=224\n${ind}global.set $treq\n")
      n_in += 1
    }
    if t == "i64.store offset=200" && i > 0 && ls[i - 1].trim() == "global.get $tdl" {
      out.write("${ind}local.get $t\n${ind}global.get $treq\n${ind}i32.store offset=224\n")
      n_out += 1
    }
  }
  if !guarded || !idle || n_size != 2 || n_in != 1 || n_out != 2 || n_wake != 1 {
    fault("rt10_sched: rt3.xo changed (start ${guarded}, idle ${idle}, sizes ${n_size}, loads ${n_in}, stores ${n_out}, task_end ${n_wake})")
  }
  out.freeze()
}

/// rt5.xo's functions that rt10.xo replaces: their definitions renamed
/// (strip_runtime drops them), so the calls of the rest bind to rt10's.
fn rt10_rt5(var g: Gen) -> Str {
  var t = rt5_text(g)
  for n in ["wasi_http_method", "wasi_http_path", "wasi_http_authority", "wasi_http_headers", "wasi_http_body", "wasi_http_body_read", "wasi_http_body_trailers", "wasi_http_head", "wasi_http_write", "wasi_http_end", "handle_end", "wasi_http_send", "wasi_http_resp_headers", "wasi_http_resp_body", "wasi_http_respond"] {
    let o = "(func \$${n} "
    let o2 = "(func \$${n}\n"
    if !t.contains(o) && !t.contains(o2) {
      fault("rt10_rt5: rt5.xo has no ${n}")
    }
    t = t.replace(o, "(func \$rt5_${n} ").replace(o2, "(func \$rt5_${n}\n")
  }
  t
}

/// The functions of rt10.xo (with rt10_rt5's text).
fn rt10_text(var g: Gen) -> Str {
  let e500 = g.str_obj("internal error".bytes())
  // the 500's fields in wasi_http_respond's form (rt5_text's)
  var hb = BytesBuilder.new()
  hb.write("content-type".bytes())
  hb.write_byte(0)
  hb.write("text/plain; charset=utf-8".bytes())
  hb.write_byte(0)
  let h500b = hb.freeze()
  let h500 = g.str_obj(h500b)
  let cdisp = if g.is_client() { "call $p3_cdispatch" } else { "drop\n        drop\n        drop\n        drop" }
  rt10_rt5(g) + (if g.is_client() { rt10_client_text() } else { "" }) + """
    ;; A request's record (rt10_handle makes it; 272 bytes): 0 its
    ;; component task's waitable set, 4 its task, 8..36 what the getters
    ;; give once (method, path, authority, fields: object and length), 40
    ;; the request body stream (0 once dropped), 44 its trailers future, 48
    ;; the done future's writable end, 52 the response body stream's
    ;; writable end, 56 its trailers future's, 60 flags (1 the head was
    ;; made, 2 end came, 4 the host dropped the body, 8 main ended, 16 a
    ;; body read in flight, 32 the body ended, 64 a body write in flight,
    ;; 128 a trailers read in flight, 256 the trailers were read, 512 the
    ;; trailers' write in flight, 1024 the done future's write in flight,
    ;; 2048 a kick in flight, 4096 the head waits for its own component
    ;; task, 8192 finished, 16384 the body stream closed), 64 the response
    ;; that waits, 68 the read buffer (64 KiB), 72 its unread start, 76 its
    ;; end, 80 the whole body read so far {80 bytes, 84 length, 88
    ;; capacity}, 92 the body bytes being written {92, 96 length, 100 how
    ;; far}, 104 the next ones {104, 108 length, 112 capacity}, 116 the
    ;; task waiting for the body, 120 the task waiting to write, 124 the
    ;; request trailers (object, 128 length), 132 the response trailers'
    ;; fields, 136 the kick future's readable end, 140 its waitables in
    ;; the set, 144 the trailers read's value, 176 the response trailers'
    ;; value, 208 the done value, 240 the kick's value.

    ;; the request's getters: what handle kept, given to the first caller
    ;; (serve_component calls each once), else empty
    (func $wasi_http_method (result i32 i32) (local $R i32)
      global.get $treq
      local.tee $R
      i32.load offset=8
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      local.get $R
      i32.load offset=8
      local.get $R
      i32.load offset=12
      local.get $R
      i32.const 0
      i32.store offset=8)

    (func $wasi_http_path (result i32 i32) (local $R i32)
      global.get $treq
      local.tee $R
      i32.load offset=16
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      local.get $R
      i32.load offset=16
      local.get $R
      i32.load offset=20
      local.get $R
      i32.const 0
      i32.store offset=16)

    (func $wasi_http_authority (result i32 i32) (local $R i32)
      global.get $treq
      local.tee $R
      i32.load offset=24
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      local.get $R
      i32.load offset=24
      local.get $R
      i32.load offset=28
      local.get $R
      i32.const 0
      i32.store offset=24)

    (func $wasi_http_headers (result i32 i32) (local $R i32)
      global.get $treq
      local.tee $R
      i32.load offset=32
      i32.eqz
      if
        i32.const 0
        call $rs_new
        i32.const 0
        return
      end
      local.get $R
      i32.load offset=32
      local.get $R
      i32.load offset=36
      local.get $R
      i32.const 0
      i32.store offset=32)

    (func $p3_flag (param $R i32) (param $f i32)
      local.get $R
      local.get $R
      i32.load offset=60
      local.get $f
      i32.or
      i32.store offset=60)

    (func $p3_unflag (param $R i32) (param $f i32)
      local.get $R
      local.get $R
      i32.load offset=60
      local.get $f
      i32.const -1
      i32.xor
      i32.and
      i32.store offset=60)

    ;; 1 when R has any of flags f, else 0 (a Bool: p3_after ands it)
    (func $p3_has (param $R i32) (param $f i32) (result i32)
      local.get $R
      i32.load offset=60
      local.get $f
      i32.and
      i32.const 0
      i32.ne)

    ;; waitable w, whose operation returned BLOCKED, joins the set of
    ;; request R with its kind and object (the record, or a client record)
    (func $p3_reg (param $w i32) (param $kind i32) (param $obj i32) (param $R i32) (local $nb i32) (local $nc i32)
      local.get $w
      global.get $p3wcap
      i32.ge_u
      if
        local.get $w
        i32.const 1
        i32.shl
        i32.const 64
        i32.add
        local.tee $nc
        i32.const 3
        i32.shl
        call $alloc
        local.tee $nb
        i32.const 0
        local.get $nc
        i32.const 3
        i32.shl
        memory.fill
        global.get $p3wt
        if
          local.get $nb
          global.get $p3wt
          global.get $p3wcap
          i32.const 3
          i32.shl
          memory.copy
          global.get $p3wt
          call $free
        end
        local.get $nb
        global.set $p3wt
        local.get $nc
        global.set $p3wcap
      end
      global.get $p3wt
      local.get $w
      i32.const 3
      i32.shl
      i32.add
      local.tee $nb
      local.get $kind
      i32.store
      local.get $nb
      local.get $obj
      i32.store offset=4
      local.get $R
      local.get $R
      i32.load offset=140
      i32.const 1
      i32.add
      i32.store offset=140
      global.get $p3nreg
      i32.const 1
      i32.add
      global.set $p3nreg
      local.get $w
      local.get $R
      i32.load
      call $p3_join)

    (func $p3_unreg (param $w i32) (param $R i32)
      global.get $p3wt
      local.get $w
      i32.const 3
      i32.shl
      i32.add
      i64.const 0
      i64.store
      local.get $R
      local.get $R
      i32.load offset=140
      i32.const 1
      i32.sub
      i32.store offset=140
      global.get $p3nreg
      i32.const 1
      i32.sub
      global.set $p3nreg
      local.get $w
      i32.const 0
      call $p3_join)

    ;; task t, parked, runs again (its call repeats); only it: $wake would
    ;; make every blocked task repeat its call
    (func $p3_wake (param $t i32)
      local.get $t
      if
        local.get $t
        local.get $t
        i32.load offset=116
        i32.const 1
        i32.sub
        i32.store offset=116
      end)

    ;; the running task waits until a $p3_wake of the task stored at slot
    (func $p3_park (param $slot i32)
      local.get $slot
      global.get $cur
      i32.store
      call $block)

    ;; scheduler: whether its idle step returns to the export or callback
    ;; (a host operation is in flight, or no request runs main)
    (func $p3_idle (result i32)
      global.get $p3nreg
      i32.const 0
      i32.gt_u
      global.get $p3live
      i32.eqz
      i32.or)

    ;; request R's component task is told to run (task.return or its end
    ;; waits for it): a future it reads, written at once
    (func $p3_kick (param $R i32) (local $t i64)
      local.get $R
      i32.const 2048
      call $p3_has
      if
        return
      end
      local.get $R
      i32.const 2048
      call $p3_flag
      call $p3_tnew
      local.set $t
      local.get $R
      local.get $t
      i32.wrap_i64
      i32.store offset=136
      local.get $R
      i32.const 240
      i32.add
      i32.const 0
      i32.const 32
      memory.fill
      local.get $t
      i32.wrap_i64
      local.get $R
      i32.const 240
      i32.add
      call $p3_tread
      drop
      local.get $t
      i32.wrap_i64
      i32.const 6
      local.get $R
      local.get $R
      call $p3_reg
      local.get $t
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      global.get $p3zero
      call $p3_twrite
      drop
      local.get $t
      i64.const 32
      i64.shr_u
      i32.wrap_i64
      call $p3_tdrop_w)

    ;; R is finished once main ended and the host has the response's body,
    ;; trailers and done value, with nothing of R's in its set
    (func $p3_check_done (param $R i32)
      local.get $R
      i32.const 8
      call $p3_has
      i32.eqz
      if
        return
      end
      local.get $R
      i32.const 8192
      call $p3_has
      if
        return
      end
      local.get $R
      i32.load offset=52
      local.get $R
      i32.load offset=56
      i32.or
      local.get $R
      i32.load offset=48
      i32.or
      if
        return
      end
      local.get $R
      i32.const 4096
      call $p3_has
      local.get $R
      i32.load offset=140
      i32.or
      if
        return
      end
      local.get $R
      i32.const 8192
      call $p3_flag
      local.get $R
      global.get $p3ctx
      i32.ne
      if
        local.get $R
        call $p3_kick
      end)

    ;; the request body: a read of up to 64 KiB into R's buffer when it has
    ;; nothing unread
    (func $p3_rx_pump (param $R i32) (local $c i32)
