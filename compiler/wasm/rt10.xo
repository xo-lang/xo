        local.get $C
        i32.load
        i32.const 2
        i32.and
        if
          local.get $C
          i32.load
          i32.const 132
          i32.and
          if
            return
          end
          local.get $C
          i32.load offset=16
          local.get $C
          i32.const 80
          i32.add
          call $p3_twrite
          i32.const -1
          i32.eq
          if
            local.get $C
            i32.const 128
            call $p3_cflag
            local.get $C
            i32.load offset=16
            i32.const 9
            local.get $C
            local.get $C
            i32.load offset=4
            call $p3_reg
            return
          end
          local.get $C
          call $p3_c_trailed
          return
