    i64.shr_u
    i32.wrap_i64
    i32.store offset=48
    call $hret_at
    local.set $a
    local.get $req
    local.get $d
    i32.wrap_i64
    local.get $a
    call $p3_consume
    local.get $R
    local.get $a
    i32.load
    i32.store offset=40
    local.get $R
    local.get $a
    i32.load offset=4
    i32.store offset=44
    i32.const 0
    global.set $hreq
    ;; its task, in a scope that is never closed, runs main
    i32.const 232
    i32.const ${task_free}
    call $obj_new
    local.tee $t
    i32.const ${run}
    i32.store offset=12
    local.get $t
    global.get $p3scope
    i32.store offset=56
    local.get $t
    global.get $stop_root
    i32.store offset=64
    local.get $t
    local.get $t
    i32.const 60
    i32.add
    i32.store offset=104
    local.get $t
    local.get $R
    i32.store offset=224
    local.get $R
    local.get $t
    i32.store offset=4
    local.get $t
    call $act_push
    global.get $p3live
    i32.const 1
    i32.add
    global.set $p3live
    local.get $R
    global.set $p3ctx
    local.get $R
    call $p3_ctx_set
    call $sched
    local.get $R
