      call $sched
      global.get $p3scope
      global.get $stop_root
      i32.store offset=16
    end
    i32.const 272
    call $alloc
    local.tee $R
    i32.const 0
    i32.const 272
    memory.fill
    local.get $R
    call $p3_wsnew
    i32.store
    ;; what main reads of the request, before consume-body ends it
    local.get $req
    global.set $hreq
    call $rt5_wasi_http_method
    local.set $a
    local.set $t
    local.get $R
    local.get $t
    i32.store offset=8
    local.get $R
    local.get $a
    i32.store offset=12
    call $rt5_wasi_http_path
    local.set $a
    local.set $t
    local.get $R
    local.get $t
    i32.store offset=16
    local.get $R
    local.get $a
    i32.store offset=20
    call $rt5_wasi_http_authority
    local.set $a
    local.set $t
    local.get $R
    local.get $t
    i32.store offset=24
    local.get $R
    local.get $a
    i32.store offset=28
    call $rt5_wasi_http_headers
    local.set $a
    local.set $t
    local.get $R
    local.get $t
    i32.store offset=32
    local.get $R
    local.get $a
    i32.store offset=36
    ;; consume-body(request, done) -> (body, trailers)
    call $p3_dnew
    local.set $d
    local.get $R
    local.get $d
