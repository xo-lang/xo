/// The handle export and its callback (stage 5 step 3): each request
/// gets a record and a task that runs main; the scheduler runs until no
/// task can, then the export or callback gives the host WAIT on the
/// request's set, or EXIT once the request is finished.
fn rt10_handle(var g: Gen, start: List[Str]) -> Str {
  let task_free = g.table_index("$task_free")
  let run = g.table_index("$p3_req_run")
  """
  (func $p3_handle (export "[async-lift]wasi:http/handler@0.3.0#handle") (param $req i32) (result i32) (local $R i32) (local $t i32) (local $a i32) (local $d i64)
    global.get $p3init
    i32.eqz
    if
      i32.const 1
      global.set $p3init
      i32.const 32
      call $alloc
      local.tee $t
      i32.const 0
      i32.const 32
      memory.fill
      local.get $t
      global.set $p3zero
      i32.const 64
      call $alloc
      local.tee $t
      i32.const 0
      i32.const 64
      memory.fill
      local.get $t
      global.set $p3scope
