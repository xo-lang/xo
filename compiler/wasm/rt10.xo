        local.get $C
        local.get $C
        i32.load offset=24
        i32.store offset=28
      end)

    (func $p3_c_trailed (param $C i32)
      local.get $C
      i32.const 128
      call $p3_cunflag
      local.get $C
      i32.load offset=16
      call $p3_tdrop_w
      local.get $C
      i32.const 0
      i32.store offset=16
      local.get $C
      i32.const 4
      call $p3_cflag)

    ;; an outgoing request's record freed (its response dropped when its
    ;; body was never read)
