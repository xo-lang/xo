        i32.wrap_i64
        local.get $m
        i32.const 8
        i32.add
        local.get $mn
        call $p3_req_method
        local.get $q
        i32.const 1
        local.get $sk
        i32.wrap_i64
        i32.const 0
        i32.const 0
        call $p3_req_scheme
        i32.or
        local.get $q
        i32.const 1
        local.get $au
        i32.const 8
        i32.add
        local.get $aun
        call $p3_req_authority
        i32.or
        local.get $q
        i32.const 1
        local.get $pq
        i32.const 8
