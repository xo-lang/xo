// Calls (decision 0179): module functions, and the operations the SSA
// names as calls that the LLVM emitter lowers inline or to the C runtime
// (internal/llvm fromssa.go call and rtCall), here inline or to rt.xo.
// A name the backend does not have yet makes the program unsupported:
// the build reports it and writes no module.

use github.com/xo-lang/xo/compiler/ssa

fn (var g: Gen) call(v: Int) {
  let x = g.f.values[v]
  let name = match x.aux {
    S(s) => s
    _ => ""
  }
  if let Some(ci) = g.by_name.get(name) {
    if !g.homes[ci].is_empty() {
      g.home_call(v, ci)
      return
    }
    let wide = g.wide_result(ci)
    let n = g.nleaves(x.ty)
    if wide && n != g.result_leaves(ci) {
      g.fail("the wasm backend: the call of `${name}` takes ${n} result leaves, it returns ${g.result_leaves(ci)}")
      return
    }
    let blk = if wide { g.sret_block(ci) } else { -1 }
    let id = if g.susp.len() > ci && g.susp[ci] { g.resume_point() } else { -1 }
    for a in x.args {
      g.push(a)
    }
    if wide {
      g.get(blk)
    }
    g.e("call $f${ci}")
    g.suspend_check(id)
    if wide {
      g.mem_push(blk, 0, g.leaves(x.ty))
      g.def(v)
      g.get(blk)
      g.e("call $free")
    } else {
      g.def(v)
    }
    g.check_fault(v)
    return
  }
  match name {
    "rt.landing" => {
      // a check only a fault takes: the fault tests jump to the landing
      // block themselves
      g.e("i32.const 0")
      g.def(v)
    }
    "rt.fault_continue" => {
      // a fault goes on to the caller (cancellation only returns)
      g.e("global.get $faulting")
      g.e("global.set $prop")
    }
    "rt.unwinding" => {
      // a fault sets it (xo_fault_raise), and with tasks a cancellation
      // point that found the task canceled (rt3.xo)
      g.e("global.get $faulting")
      if g.conc {
        g.e("global.get $unw")
        g.e("i32.or")
      }
      g.def(v)
    }
    "rt.fault_detail" => {
      g.push(x.args[0])
      g.e("call $fault_detail")
    }
    "rt.str_hash" => g.rt_call(v, "$str_hash")
    "rt.fault_take" | "rt.fault_msg" | "rt.fault_loc" => g.rt_call(v, "$${name.trim_prefix("rt.")}")
    "rt.str_slice_at" | "rt.bytes_slice_at" => {
      g.rt_call(v, "$${name.trim_prefix("rt.")}")
      g.check_fault(v)
    }
    "rt.fault_raise" | "rt.fault_at" => {
      g.push(x.args[0])
      g.push(x.args[1])
      g.e("call $fault_raise")
      g.fault_exit(v)
    }
    // raw memory (decision 0207); the loads, stores, and copies are rt2.xo's
    "rt.obj_addr" => {
      g.push_part(x.args[0], 0, 1)
      g.e("i64.extend_i32_u")
      g.def(v)
    }
    "rt.obj_at" => {
      g.push(x.args[0])
      g.e("i32.wrap_i64")
      g.def(v)
      g.push(v)
      g.e("call ${g.rc_fn("dup", x.ty)}")
    }
    "rt.prefetch" => {} // a hint; wasm has none (decision 0207 stage 3)
    "rt.static_word" => {
      // word k of the process globals, a static table (work item B02)
      let at = g.static_table("static", 256)
      g.push(x.args[0])
      g.e("i64.const 3")
      g.e("i64.shl")
      g.e("i64.const ${at}")
      g.e("i64.add")
      g.def(v)
    }
    // the thread locals of decision 0212: one thread, so a static table
    "rt.tlocal_get" => {
      let at = g.static_table("tlocal", 16)
      g.push(x.args[0])
      g.e("i32.wrap_i64")
      g.e("i32.const 3")
      g.e("i32.shl")
      g.e("i64.load offset=${at}")
      g.def(v)
    }
    "rt.tlocal_set" => {
      let at = g.static_table("tlocal", 16)
      g.push(x.args[0])
      g.e("i32.wrap_i64")
      g.e("i32.const 3")
      g.e("i32.shl")
      g.push(x.args[1])
      g.e("i64.store offset=${at}")
    }
    "rt.test_on" => {
      // a WASI module is never a test binary (std/native/log.xo asks)
      g.e("i32.const 0")
      g.def(v)
    }
    "rt.tlocal_addr" => {
      g.e("i64.const ${g.static_table("tlocal", 16)}")
      g.def(v)
    }
    "rt.slot_load" | "rt.slot_store" | "rt.slot_swap" | "rt.slot_cas" | "rt.slot_add" | "rt.slot_addr" | "rt.fence" | "rt.spin_hint" => g.slot_op(v)
    "rt.rl_empty" => {
      g.e("i32.const ${g.empty_list}")
      g.def(v)
    }
    "rt.exit" => {
      if g.files {
        g.e("call $consts_free")
      }
      g.push(x.args[0])
      g.e("i32.wrap_i64")
      g.e("call $exit")
    }
    "rt.eprintln" => {
      g.push(x.args[0])
      g.e("call $eprintln")
    }
    "list.new" => {
      let es = g.size(g.m.types[x.ty].elems[0])
      if x.args.len() == 1 {
        g.push(x.args[0])
        g.e("i32.wrap_i64")
        g.e("i32.const ${es}")
        g.e("call $rl_new_n")
      } else {
        g.e("i32.const 4")
        g.e("i32.const ${es}")
        g.e("call $rl_new")
      }
      g.def(v)
    }
    "list.len" => {
      g.push(x.args[0])
      g.e("i32.load offset=4")
      g.e("i64.extend_i32_u")
      g.def(v)
    }
    "list.index" => {
      let a = g.elem_addr(v, x.args[0], x.args[1], x.ty)
      g.load_leaves(a, 0, g.loc(v), g.leaves(x.ty))
    }
    "list.get" => {
      let l = x.args[0]
      let et = g.m.types[g.vty(l)].elems[0]
      let ot = x.ty
      g.push(x.args[1])
      g.push(l)
      g.e("i32.load offset=4")
      g.e("i64.extend_i32_u")
      g.e("i64.lt_u")
      g.e("if")
      let el = g.leaves(et)
      let a = g.scratch(["i32"])
      let b = g.scratch(el)
      g.push(l)
      g.push(x.args[1])
      g.e("i32.const ${g.size(et)}")
      g.e("call $elem")
      g.set(a)
      g.load_leaves(a, 0, b, el)
      g.variant_into(v, ot, g.m.variant_index(ot, "Some"), b, el)
      g.e("else")
      g.variant_into(v, ot, g.m.variant_index(ot, "None"), 0, [])
      g.e("end")
    }
    "rt.list_swap" => {
      // decision 0374: the two elements trade places with no count and no
      // release (a permutation leaves each element referenced as often),
      // both read before either is written so i == j writes back what it
      // read; elem_addr bounds checks both indices
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      let el = g.leaves(et)
      if !el.is_empty() {
        let a = g.elem_addr(v, x.args[0], x.args[1], et)
        let b = g.elem_addr(v, x.args[0], x.args[2], et)
        let wa = g.scratch(el)
        let wb = g.scratch(el)
        g.load_leaves(a, 0, wa, el)
        g.load_leaves(b, 0, wb, el)
        g.store_leaves(a, 0, wb, el)
        g.store_leaves(b, 0, wa, el)
      }
    }
    "rt.list_swap2" => {
      // decision 0374 step 3: one element of each list trade places with
      // no count and no release (the two lists permute their elements
      // between them, so each element stays referenced once), both read
      // before either is written so a == b with i == j writes back what it
      // read; elem_addr bounds checks both indices, one per list
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      let el = g.leaves(et)
      if !el.is_empty() {
        let a = g.elem_addr(v, x.args[0], x.args[1], et)
        let b = g.elem_addr(v, x.args[2], x.args[3], et)
        let wa = g.scratch(el)
        let wb = g.scratch(el)
        g.load_leaves(a, 0, wa, el)
        g.load_leaves(b, 0, wb, el)
        g.store_leaves(a, 0, wb, el)
        g.store_leaves(b, 0, wa, el)
      }
    }
    "list.set" => {
      let et = g.vty(x.args[2])
      let a = g.elem_addr(v, x.args[0], x.args[1], et)
      let el = g.leaves(et)
      if g.heap(et) {
        let old = g.scratch(el)
        g.load_leaves(a, 0, old, el)
        g.push_range(old, el.len())
        let d = g.rc_fn("drop", et)
        g.e("call ${d}")
      }
      if !el.is_empty() {
        g.store_leaves(a, 0, g.loc(x.args[2]), el)
      }
      g.push(x.args[0])
      g.def(v)
    }
    "list.push" => {
      let et = g.vty(x.args[1])
      let el = g.leaves(et)
      let a = g.scratch(["i32"])
      let r = g.loc(v)
      g.push(x.args[0])
      g.e("i32.const ${g.size(et)}")
      g.e("call $rl_slot")
      g.set(a)
      g.set(r)
      if !el.is_empty() {
        g.store_leaves(a, 0, g.loc(x.args[1]), el)
      }
    }
    "log.set" => {
      // decision 0291: list.set into a borrowed list (a Map log's chunk
      // its Map's owner alone holds): the old element dropped; no result
      let et = g.vty(x.args[2])
      let a = g.elem_addr(v, x.args[0], x.args[1], et)
      let el = g.leaves(et)
      if g.heap(et) {
        let old = g.scratch(el)
        g.load_leaves(a, 0, old, el)
        g.push_range(old, el.len())
        let d = g.rc_fn("drop", et)
        g.e("call ${d}")
      }
      if !el.is_empty() {
        g.store_leaves(a, 0, g.loc(x.args[2]), el)
      }
    }
    "log.push" => {
      // decision 0291: list.push into a borrowed list with room (a Map
      // log's chunk: rl_slot does not move it); no result
      let et = g.vty(x.args[1])
      let el = g.leaves(et)
      let a = g.scratch(["i32"])
      g.push(x.args[0])
      g.e("i32.const ${g.size(et)}")
      g.e("call $rl_slot")
      g.set(a)
      g.e("drop")
      if !el.is_empty() {
        g.store_leaves(a, 0, g.loc(x.args[1]), el)
      }
    }
    "list.pop" => {
      let l = x.args[0]
      let et = g.m.types[g.vty(l)].elems[0]
      let ot = g.m.types[x.ty].elems[1]
      let el = g.leaves(et)
      let r = g.loc(v)
      let n = g.scratch(["i32"])
      let a = g.scratch(["i32"])
      let b = g.scratch(el)
      g.push(l)
      g.set(r)
      g.push(l)
      g.e("i32.load offset=4")
      g.set(n)
      g.get(n)
      g.e("if")
      g.get(n)
      g.e("i32.const 1")
      g.e("i32.sub")
      g.set(n)
      g.push(l)
      g.get(n)
      g.e("i32.store offset=4")
      g.push(l)
      g.e("i32.const 16")
      g.e("i32.add")
      g.get(n)
      g.e("i32.const ${g.size(et)}")
      g.e("i32.mul")
      g.e("i32.add")
      g.set(a)
      g.load_leaves(a, 0, b, el)
      g.variant_into_at(r + 1, ot, g.m.variant_index(ot, "Some"), b, el)
      g.e("else")
      g.variant_into_at(r + 1, ot, g.m.variant_index(ot, "None"), 0, [])
      g.e("end")
    }
    "list.take" => {
      // element i moves out (decision 0169); its slot gets a placeholder
      let et = g.m.types[x.ty].elems[1]
      let el = g.leaves(et)
      let a = g.elem_addr(v, x.args[0], x.args[1], et)
      let r = g.loc(v)
      g.push(x.args[0])
      g.set(r)
      g.load_leaves(a, 0, r + 1, el)
      if !el.is_empty() {
        let h = g.scratch(el)
        g.push_hole(et)
        g.set_range(h, el.len())
        g.store_leaves(a, 0, h, el)
      }
    }
    "str.concat" => {
      let b = g.loc(x.args[1])
      g.push(x.args[0])
      g.get(b)
      g.e("i32.const 8")
      g.e("i32.add")
      g.get(b + 1)
      g.e("call $sapp")
      g.def(v)
    }
    // str_view: a view in the native runtime, a copy here (the wasm Str has no views); the callers prove the range
    "rt.str_view" => g.rt_call(v, "$str_slice")
    "rt.str_slice" | "rt.str_starts_with" | "rt.str_ends_with" | "rt.str_contains" | "rt.str_repeat" | "rt.str_join" | "rt.rs_append_quote" | "rt.str_rune_count" => g.rt_call(v, "$${name.trim_prefix("rt.")}")
    "rt.rs_append" => g.rt_call(v, "$rs_append_str")
    "str.concat_int" => g.rt_call(v, "$sapp_int")
    "str.concat_float" => g.rt_call(v, "$sapp_float")
    "str.of_float" => g.rt_call(v, "$of_float")
    "str.eq" => g.rt_call(v, "$str_eq")
    "str.cmp" => g.rt_call(v, "$str_cmp")
    "str.of_int" => g.rt_call(v, "$of_int")
    "str.of_bool" => {
      let a = x.args[0]
      g.e("i32.const ${g.str_obj(b"true")}")
      g.e("i32.const ${g.str_obj(b"false")}")
      g.push(a)
      g.e("select")
      g.e("i32.const 4")
      g.e("i32.const 5")
      g.push(a)
      g.e("select")
      g.def(v)
    }
    "Stdio.print" | "Stdio.println" | "Stdio.eprint" | "Stdio.eprintln" => {
      g.push(x.args[1])
      g.e("call $${name.trim_prefix("Stdio.")}")
    }
    "Int.min" | "Int.max" => {
      let a = x.args[0]
      let b = x.args[1]
      if name == "Int.min" {
        g.push(a)
        g.push(b)
      } else {
        g.push(b)
        g.push(a)
      }
      g.push(a)
      g.push(b)
      g.e("i64.lt_s")
      g.e("select")
      g.def(v)
    }
    "Int.abs" => {
      if !x.pos.is_empty() {
        g.checked(v, "$abs_chk", 1)
        return
      }
      let a = x.args[0]
      g.e("i64.const 0")
      g.push(a)
      g.e("i64.sub")
      g.push(a)
      g.push(a)
      g.e("i64.const 0")
      g.e("i64.lt_s")
      g.e("select")
      g.def(v)
    }
    "Float.min" => g.rt_call(v, "$fmin")
    "Float.max" => g.rt_call(v, "$fmax")
    "Float.round" => g.rt_call(v, "$fround")
    "Float.sqrt" | "Float.floor" | "Float.ceil" | "Float.trunc" | "Float.abs" => {
      g.push(x.args[0])
      g.e("f64.${name.trim_prefix("Float.")}")
      g.def(v)
    }
    "Float.is_nan" => {
      g.push(x.args[0])
      g.push(x.args[0])
      g.e("f64.ne")
      g.def(v)
    }
    "bytes.index" => {
      if !x.pos.is_empty() {
        g.checked(v, "$bidx_chk", 2)
        return
      }
      g.push_part(x.args[0], 0, 1)
      g.push(x.args[1])
      g.e("i32.wrap_i64")
      g.e("i32.add")
      g.e("i64.load8_u offset=8")
      g.def(v)
    }
    "Str.len" => {
      g.push_part(x.args[0], 1, 2)
      g.e("i64.extend_i32_u")
      g.def(v)
    }
    "Str.is_empty" => {
      g.push_part(x.args[0], 1, 2)
      g.e("i32.eqz")
      g.def(v)
    }
    _ => {
      // a runtime function of rt.xo taking the operands' leaves and
      // returning the result's (xo_<name> of std/llrt)
      if name.starts_with("rt.") && (rt_direct(name.trim_prefix("rt.")) || rt2_direct(name.trim_prefix("rt."))) {
        g.rt_call(v, "$${name.trim_prefix("rt.")}")
        if ssa.faulting_rt(name) {
          g.check_fault(v)
        }
        return
      }
      if name.starts_with("rt.") && g.conc && rt3_direct(name.trim_prefix("rt.")) {
        g.rt3_call(v, name)
        return
      }
      let op = name.trim_prefix("rt.")
      if name.starts_with("rt.") && g.files && rt4_direct(op) {
        g.rt_call(v, "$${op}")
        if op == "const_once" {
          // a constant whose initializer faulted raises the fault at
          // every read (decision 0332)
          g.check_fault(v)
        }
        return
      }
      if name == "rt.fs_canceled" {
        // a canceled task's Fs operations report Canceled (xo_fs_canceled)
        g.e(if g.conc { "call $ctx_canceled" } else { "i32.const 0" })
        g.def(v)
        return
      }
      if name == "rt.fs_raw_getcwd" {
        // WASI has no working directory: "" (std's fs_cwd_path reports
        // Io, and its callers fall back to $PWD)
        g.push_hole(x.ty)
        g.def(v)
        return
      }
      if name == "rt.heap_large" {
        // the runtime's records (decision 0207): whole pages from
        // memory.grow (zeroed), outside the allocator, so neither the
        // budgets nor the leak check count them; the size in a 16 byte
        // header for heap_large_resize
        g.push(x.args[0])
        g.e("i32.wrap_i64")
        g.e("call $heap_large")
        g.e("i64.extend_i32_u")
        g.def(v)
        return
      }
      if name == "rt.heap_large_resize" {
        g.push(x.args[0])
        g.e("i32.wrap_i64")
        g.push(x.args[1])
        g.e("i32.wrap_i64")
        g.e("call $heap_large_resize")
        g.e("i64.extend_i32_u")
        g.def(v)
        return
      }
      if name == "rt.heap_release" {
        // pages from memory.grow are not given back (one wasm instance
        // a run)
        return
      }
      if name == "rt.sys_clock_buf" {
        // no Linux clock scratch in a WASI module: Clock.now takes the
        // runtime's clock (std/native/llrt/sysio.xo, decision 0206)
        g.e("i64.const 0")
        g.def(v)
        return
      }
      if g.wasi_xo && name == "rt.task_stopping" {
        // tasks are cooperative on this runtime: nothing asks one to stop
        g.e("i32.const 0")
        g.def(v)
        return
      }
      if g.lax || op.starts_with("pc.") || op is "sys6" | "sys_restorer" | "call_c2" | "call_c4" | "sys_words" | "auxval" | "sys_clone" | "tw_fake" | "fs_set_err" | "test_log" | "frame_addr" | "fn_addr" {
        // --lax: the call faults when it runs; so do the Linux system
        // calls of std/native/llrt/linux.xo and sysio.xo (decision 0206),
        // in `target.os` arms the passes may leave in a WASI module,
        // std/native/log.xo's test world record behind rt.test_on (false),
        // and the native heap's blocks of sysio.set_err's native arm
        // (behind sysio.layer() == 0 in a WASI module); a function or
        // frame address (decision 0233) has no meaning in wasm
        let msg = if g.wasi_xo { "xo: this needs a process, a socket or a system tool (`${name}`), which is not available in the WASI build (XO1513)" } else { "the wasm backend does not support the call `${name}`" }
        g.e("i32.const ${g.str_obj(msg.bytes())}")
        g.e("i32.const ${msg.len()}")
        g.e(g.litp(comment_text(g.f.name)))
        g.e("call $fault_str")
        g.fault_exit(v)
        return
      }
      if op.starts_with("net_") || op.starts_with("listener_") || op.starts_with("conn_") {
        // no sockets in WASI preview1, the targets of decision 0144
        g.fail("the wasm backend does not support the network (`${name}`): WASI preview1 has no sockets")
        return
      }
      g.fail("the wasm backend does not support the call `${name}` (stage 2), in ${g.f.name}")
    }
  }
}

/// A function of the task runtime (rt3.xo) on the operands' leaves; a
/// blocking one is a resume point. Atomic keeps an Int: a Bool value is
/// widened on the way in and narrowed on the way out.
/// A call of function ci, which takes parameters by reference
/// (home.xo): a home of this function when the argument is its chain
/// value given up here, else a temporary copy read back after the call.
/// A zeroed block for the wide result of a call of function ci
/// (wide_result; a fault exit stores none), in a new local: allocated
/// before the call's resume point, so a resumed call passes the same one,
/// and freed after the call reads it.
fn (var g: Gen) sret_block(ci: Int) -> Int {
  let n = g.result_leaves(ci)
  let blk = g.tmps(["i32"])
  g.e("i32.const ${8 * n}")
  g.e("call $alloc")
  g.set(blk)
  g.get(blk)
  g.e("i32.const 0")
  g.e("i32.const ${8 * n}")
  g.e("memory.fill")
  blk
}

fn (var g: Gen) home_call(v: Int, ci: Int) {
  let x = g.f.values[v]
  let cf = g.m.funcs[ci]
  // a wide result (wide_result): the callee stores its results but those
  // left in homes at the block passed after the arguments
  let blk = if g.wide_result(ci) { g.sret_block(ci) } else { -1 }
  let sus = g.susp.len() > ci && g.susp[ci]
  // the temporary copies of a call that can suspend are made before its
  // resume point: a resumed call passes the same blocks, and reads the
  // callee's results from them (made after it, a resumed call passed
  // fresh copies of the arguments' old values and read those back)
  var pre: Map[Int, Int] = {}
  if sus {
    var vh0: List[Int] = []
    for (i, _) in x.args.indexed() {
      if let Some(h) = g.pass.get(v * 4096 + i) {
        vh0.push(h)
      }
    }
    var ns0 = 0
    for (i, a) in x.args.indexed() {
      if !g.homes[ci].contains(i) {
        continue
      }
      if g.pass.get(v * 4096 + i) != None {
        continue
      }
      if g.rhomes[ci].contains(i) {
        let (mp, _) = g.mem_of(a)
        let mh = if g.held[a] >= 0 { g.held[a] } else { g.mfield[a] }
        if mp >= 0 && !vh0.contains(mh) {
          continue
        }
      }
      pre[i] = g.temp_make(a, ns0)
      ns0 += 1
    }
  }
  let id = if sus { g.resume_point() } else { -1 }
  // per `var` result: the temporary block holding it (-1: none)
  var tmp: List[Int] = []
  for _ in 0..cf.results.len() {
    tmp.push(-1)
  }
  // the homes this call passes for `var` parameters: a read only one must
  // not see the callee's writes, so it gets a copy of a value they hold
  var vhomes: List[Int] = []
  for (i, _) in x.args.indexed() {
    if let Some(h) = g.pass.get(v * 4096 + i) {
      vhomes.push(h)
    }
  }
  var frees: List[Int] = []
  var ns = 0

  for (i, a) in x.args.indexed() {
    if !g.homes[ci].contains(i) {
      g.push(a)
      continue
    }
    if let Some(h) = g.pass.get(v * 4096 + i) {
      g.get(g.hptr[h])
      continue
    }
    if g.rhomes[ci].contains(i) {
      let (mp, mo) = g.mem_of(a)
      let mh = if g.held[a] >= 0 { g.held[a] } else { g.mfield[a] }
      if mp >= 0 && !vhomes.contains(mh) {
        g.get(mp)
        if mo > 0 {
          g.e("i32.const ${mo}")
          g.e("i32.add")
        }
        continue
      }
      let t = if let Some(pt) = pre.get(i) { pt } else { g.temp_copy(a, ns) }
      if pre.contains(i) {
        g.get(t)
      }
      ns += 1
      frees.push(t)
      continue
    }
    let t = if let Some(pt) = pre.get(i) { pt } else { g.temp_copy(a, ns) }
    if pre.contains(i) {
      g.get(t)
    }
    ns += 1
    for (j, pi) in cf.var_params.indexed() {
      if pi == i {
        tmp[j + 1] = t
      }
    }
  }
  if blk >= 0 {
    g.get(blk)
  }
  g.e("call $f${ci}")
  g.suspend_check(id)
  // the results the callee returns, into the tuple's locals
  if g.homes[ci].len() == g.rhomes[ci].len() {
    // only read only homes: the results are the SSA's
    if blk >= 0 {
      g.mem_push(blk, 0, g.leaves(x.ty))
    }
    g.def(v)
    if blk >= 0 {
      g.get(blk)
      g.e("call $free")
    }
    for t in frees {
      g.get(t)
      g.e("call $free")
    }
    g.check_fault(v)
    return
  }
  let rt = x.ty
  let tys = g.field_tys(rt)
  let base = g.loc(v)
  if blk >= 0 {
    // in order from the block, as the callee's Return stored them
    var at = 0
    for (k1, ft) in tys.indexed() {
      if !g.home_result(ci, k1) {
        let ls = g.leaves(ft)
        g.mem_push(blk, 8 * at, ls)
        g.set_range(base + g.field_off(rt, k1), ls.len())
        at += ls.len()
      }
    }
    g.get(blk)
    g.e("call $free")
  } else {
    var k = tys.len() - 1
    while k >= 0 {
      if !g.home_result(ci, k) {
        g.set_range(base + g.field_off(rt, k), g.nleaves(tys[k]))
      }
      k -= 1
    }
  }
  for (k2, t) in tmp.indexed() {
    if t >= 0 {
      let ls = g.leaves(tys[k2])
      g.mem_push(t, 0, ls)
      g.set_range(base + g.field_off(rt, k2), ls.len())
      g.get(t)
      g.e("call $free")
    }
  }
  for t in frees {
    g.get(t)
    g.e("call $free")
  }
  // snapshots of the `var` result the home now holds (home.xo)
  g.take_snaps(v)
  g.check_fault(v)
}

/// A temporary block holding a copy of value a, for a parameter passed
/// by reference (home.xo); its address is pushed and its local returned.
/// The k-th temporary of a call takes the k-th of the function's shared
/// locals for them. A value in memory is copied with memory.copy.
fn (var g: Gen) temp_copy(a: Int, k: Int) -> Int {
  let t = g.temp_make(a, k)
  g.get(t)
  t
}

/// temp_copy without pushing the address: the copy is made where this is
/// emitted, so a call that can suspend makes it before its resume point.
fn (var g: Gen) temp_make(a: Int, k: Int) -> Int {
  while g.tslots.len() <= k {
    g.tslots.push(g.tmp("i32"))
  }
  let t = g.tslots[k]
  let ls = g.leaves(g.vty(a))
  g.e("i32.const ${8 * ls.len()}")
  g.e("call $alloc")
  g.set(t)
  let (mp, mo) = g.mem_of(a)
  if mp >= 0 {
    g.get(t)
    g.get(mp)
    if mo > 0 {
      g.e("i32.const ${mo}")
      g.e("i32.add")
    }
    g.e("i32.const ${8 * ls.len()}")
    g.e("memory.copy")
  } else {
    g.mem_store(t, 0, g.loc(a), ls)
  }
  t
}

fn (var g: Gen) rt3_call(v: Int, name: Str) {
  let x = g.f.values[v]
  let fname = name.trim_prefix("rt.")
  let id = if rt3_blocking(name) { g.resume_point() } else { -1 }
  let atomic = fname.starts_with("atomic_")
  if fname == "prog_group" && x.args.is_empty() {
    // $prog_group takes the place for its fault when the program has no
    // task group; the SSA's call (os.tasks) passes none, as the native
    // runtime's takes none (the wasm module did not compile with os.tasks
    // before, 2026-10-21)
    let at = if x.pos.is_empty() { g.f.name } else { x.pos }
    g.e("i32.const ${g.str_obj(at.bytes())}")
    g.e("i32.const ${at.len()}")
  }
  for (i, a) in x.args.indexed() {
    g.push(a)
    let ls = g.leaves(g.vty(a))
    if atomic && ls.len() == 1 && ls[0] == "i32" && (i > 0 || fname == "atomic_new") {
      g.e("i64.extend_i32_u")
    }
  }
  g.e("call $${fname}")
  g.suspend_check(id)
  let rl = g.leaves(x.ty)
  if fname is "atomic_get" | "atomic_swap" && rl.len() == 1 && rl[0] == "i32" {
    g.e("i32.wrap_i64")
  }
  g.def(v)
  if ssa.faulting_rt(name) || fname == "prog_group" {
    g.check_fault(v)
  }
}

/// A runtime function on the operands' leaves, its results v's.
fn (var g: Gen) rt_call(v: Int, fname: Str) {
  for a in g.f.values[v].args {
    g.push(a)
  }
  g.e("call ${fname}")
  g.def(v)
}

/// The address of element i of list l (element type et) in a new local,
/// checked against the length when v has a fault position.
fn (var g: Gen) elem_addr(v: Int, l: Int, i: Int, et: Int) -> Int {
  let a = g.scratch(["i32"])
  g.push(l)
  g.push(i)
  g.e("i32.const ${g.size(et)}")
  if g.f.values[v].pos.is_empty() {
    g.e("call $elem")
    g.set(a)
    return a
  }
  g.e(g.locp(v))
  g.e("call $idx_chk")
  g.set(a)
  g.check_fault(v)
  a
}

/// Defines enum value v (type t) as variant tag with the fields held in
/// locals from b (leaves el).
fn (var g: Gen) variant_into(v: Int, t: Int, tag: Int, b: Int, el: List[Str]) {
  g.variant_into_at(g.loc(v), t, tag, b, el)
}

fn (var g: Gen) variant_into_at(dst: Int, t: Int, tag: Int, b: Int, el: List[Str]) {
  g.e("i64.const ${tag}")
  for (k, l) in el.indexed() {
    g.get(b + k)
    g.to_word(l)
  }
  let w = g.words(t)
  for _ in el.len()..w {
    g.e("i64.const 0")
  }
  g.set_range(dst, w + 1)
}

/// The runtime functions of rt.xo called with the operands' leaves under
/// their std/llrt names (rt.<name> is $<name>).
fn rt_direct(name: Str) -> Bool {
  name is "int_op" | "int_conv" | "int_in_range" | "rune_valid" | "rune_of" | "u64_to_float" | "f32_round" | "i64_to_f32" | "u64_to_f32" | "rs_append_u64" | "rs_append_rune" | "rs_push_rune" | "rs_append_rune_quote" | "rs_push_byte" | "rs_put" | "rs_push_word" | "rs_push_words" | "rs_with_cap" | "str_find" | "str_split" | "str_lines" | "str_trim" | "bytes_hex" | "env_args" | "env_get" | "env_program" | "env_vars" | "set_grace" | "stop_requested" | "rs_append_duration" | "stdio_out"
}

// ---------------------------------------------------------------------------
// Atomics (decision 0200)

/// Module m with the wasm runtime's Atomic in place of decision 0200's
/// inline atomics on its cell: rt3.xo's object holds the value at byte 8
/// (not 128), and each of its operations is a scheduling point of the
/// cooperative scheduler (core 7.4), so get, set, swap, and
/// compare_and_swap on an Atomic (a handle) become rt.atomic_get and
/// friends again, and the native prelude's llrt_atomic_add and
/// llrt_atomic_max rt.atomic_add and rt.atomic_max: the program behaves
/// as before the port.
fn atomics_to_runtime(m0: ssa.Module) -> ssa.Module {
  var m = m0
  for fi in 0..m.funcs.len() {
    for vi in 0..m.funcs[fi].values.len() {
      let x = m.funcs[fi].values[vi]
      if x.op != ssa.Op.Call {
        continue
      }
      let name = match x.aux {
        S(s) => s
        _ => ""
      }
      var to = ""
      var args: List[Int] = []
      if name is "prelude.llrt_atomic_add" | "prelude.llrt_atomic_max" {
        to = "rt.${name.trim_prefix("prelude.llrt_")}"
        args = x.args
      } else if name is "rt.slot_load" | "rt.slot_store" | "rt.slot_swap" | "rt.slot_cas" {
        let ct = m.funcs[fi].values[x.args[0]].ty
        if ct < 0 || m.types[ct].kind != ssa.Kind.Handle {
          continue
        }
        to = match name {
          "rt.slot_load" => "rt.atomic_get"
          "rt.slot_store" => "rt.atomic_set"
          "rt.slot_swap" => "rt.atomic_swap"
          _ => "rt.atomic_cas"
        }
        // the handle and the values: not the cell's index, not the order
        args = [x.args[0]] + x.args[2..x.args.len() - 1]
      }
      if to.is_empty() {
        continue
      }
      m.funcs[fi].values[vi].aux = ssa.Aux.S(s: to)
      m.funcs[fi].values[vi].args = args
    }
  }
  m
}

/// Pushes Int or Bool value a as an i64 (a Bool cell holds 0 or 1).
fn (var g: Gen) push_word(a: Int) {
  g.push(a)
  if g.kind(g.vty(a)) == ssa.Kind.Bool {
    g.e("i64.extend_i32_u")
  }
}

/// Defines v, an Int or a Bool, from the i64 on the stack.
fn (var g: Gen) def_word(v: Int) {
  if g.kind(g.vty(v)) == ssa.Kind.Bool {
    g.e("i32.wrap_i64")
  }
  g.def(v)
}

/// Decision 0200's atomics on a List[Int] cell: plain loads and stores,
/// the wasm runtime running one thread (an Atomic's cell went to rt3.xo's
/// functions, atomics_to_runtime); fences and the spin hint are nothing.
fn (var g: Gen) slot_op(v: Int) {
  let x = g.f.values[v]
  let name = match x.aux {
    S(s) => s
    _ => ""
  }
  if name is "rt.fence" | "rt.spin_hint" {
    return
  }
  let a = g.scratch(["i32"])
  if g.kind(g.vty(x.args[0])) == ssa.Kind.Int {
    // the address form (decision 0207): word i from the address
    g.push(x.args[0])
    g.push(x.args[1])
    g.e("i64.const 3")
    g.e("i64.shl")
    g.e("i64.add")
    g.e("i32.wrap_i64")
  } else if g.kind(g.vty(x.args[0])) == ssa.Kind.List {
    g.push(x.args[0])
    g.push(x.args[1])
    g.e("i32.const 8")
    g.e("call $elem")
  } else {
    g.fail("the wasm backend has `${name}` on a List[Int], an Atomic, or an address only")
    return
  }
  g.set(a)
  match name {
    "rt.slot_addr" => {
      g.get(a)
      g.e("i64.extend_i32_u")
      g.def(v)
    }
    "rt.slot_load" => {
      g.get(a)
      g.e("i64.load")
      g.def_word(v)
    }
    "rt.slot_store" => {
      g.get(a)
      g.push_word(x.args[2])
      g.e("i64.store")
    }
    "rt.slot_swap" | "rt.slot_add" => {
      // the old value stays on the stack
      g.get(a)
      g.e("i64.load")
      g.get(a)
      if name == "rt.slot_add" {
        g.get(a)
        g.e("i64.load")
        g.push_word(x.args[2])
        g.e("i64.add")
      } else {
        g.push_word(x.args[2])
      }
      g.e("i64.store")
      g.def_word(v)
    }
    _ => {
      // rt.slot_cas
      let ok = g.scratch(["i32"])
      g.get(a)
      g.e("i64.load")
      g.push_word(x.args[2])
      g.e("i64.eq")
      g.set(ok)
      g.get(ok)
      g.e("if")
      g.get(a)
      g.push_word(x.args[3])
      g.e("i64.store")
      g.e("end")
      g.get(ok)
      g.def(v)
    }
  }
}
