      i32.store offset=40)

    ;; Conn.close: waiting reads and writes fail (closed)
    (func $wasi_sock_close (param $c i32)
      local.get $c
      call $sk_conn_shut)

    ;; a deadline of connection c: which 1 read, 2 write, 3 both; d ns from
    ;; now when set
    (func $wasi_sock_deadline (param $c i32) (param $which i64) (param $set i32) (param $d i64) (local $at i64)
      local.get $set
      if
        call $mono
        local.get $d
        i64.const 1
        local.get $d
        i64.const 0
        i64.gt_s
        select
        i64.add
        local.set $at
      end
      local.get $which
      i64.const 1
      i64.and
      i64.eqz
      i32.eqz
      if
        local.get $c
        local.get $at
        i64.store offset=24
      end
      local.get $which
      i64.const 2
      i64.and
      i64.eqz
      i32.eqz
      if
        local.get $c
        local.get $at
        i64.store offset=32
      end
      ;; a task waiting on c sees the new deadline when it repeats its
      ;; call: its wait is dropped (a $wake alone would let $sk_reblock
      ;; keep the old deadline: conn_deadline hung, 2026-11-03)
      local.get $c
      call $sk_unwait)

    ;; the start of a lookup of the name (n bytes at h's): its stream, or 0
    ;; with the error recorded
    (func $wasi_sock_resolve (param $h i32) (param $hn i32) (result i64) (local $r i32)
      i32.const 0
      global.set $skerr
      call $sk_net
      local.get $h
      i32.const 8
      i32.add
      local.get $hn
      call $hret_at
      local.tee $r
      call $sk_resolve
      local.get $r
      i32.load8_u
      if
        local.get $r
        i32.load8_u offset=4
        i32.const 1
        i32.add
        global.set $skerr
        i64.const 0
        return
      end
      local.get $r
      i32.load offset=4
      i64.extend_i32_u)

    ;; the next address of lookup stream s: 4 or 16 bytes; empty at the end
    ;; (error 103) or on an error
    (func $wasi_sock_next (param $s i64) (result i32 i32) (local $r i32) (local $o i32) (local $i i32) (local $w i32)
      call $sk_enter
      if
        i32.const ${dead}
        i32.const 0
        return
      end
      local.get $s
      i32.wrap_i64
      call $hret_at
      local.tee $r
      call $sk_rnext
      local.get $r
      i32.load8_u
      if
        local.get $r
        i32.load8_u offset=2
        i32.const 8
        i32.eq
        if
          local.get $s
          i32.wrap_i64
          call $sk_rsub
          ;; the stream owns the wait: resolve_end drops it first
          local.get $s
          i32.wrap_i64
          i64.const 0
          call $sk_wait
          i32.const ${dead}
          i32.const 0
          return
        end
        local.get $r
        i32.load8_u offset=2
        i32.const 1
        i32.add
        global.set $skerr
        i32.const ${dead}
        i32.const 0
        return
      end
      local.get $r
      i32.load8_u offset=2
      i32.eqz
      if
        i32.const 103
        global.set $skerr
        i32.const ${dead}
        i32.const 0
        return
      end
      local.get $r
      i32.load8_u offset=4
      if
        i32.const 16
        call $rs_new
        local.set $o
        block $x
          loop $y
            local.get $i
            i32.const 8
            i32.ge_u
            br_if $x
            local.get $r
            local.get $i
            i32.const 1
            i32.shl
            i32.add
            i32.load16_u offset=6
            local.set $w
            local.get $o
            local.get $i
            i32.const 1
            i32.shl
            i32.add
            local.get $w
            i32.const 8
            i32.shr_u
            i32.store8 offset=8
            local.get $o
            local.get $i
            i32.const 1
            i32.shl
            i32.add
            local.get $w
            i32.store8 offset=9
            local.get $i
            i32.const 1
            i32.add
            local.set $i
            br $y
          end
        end
        local.get $o
        i32.const 16
        return
      end
      i32.const 4
      call $rs_new
      local.tee $o
      local.get $r
      i32.load offset=6 align=1
      i32.store offset=8 align=1
      local.get $o
      i32.const 4)

    ;; a lookup a canceled task left waits on the stream's pollable, its
    ;; child: that goes first, or the drop traps (resource has children)
    (func $wasi_sock_resolve_end (param $s i64)
      local.get $s
      i64.eqz
      if
        return
      end
      local.get $s
      i32.wrap_i64
      call $sk_unwait
      local.get $s
      i32.wrap_i64
      call $sk_rdrop)

  """
}
