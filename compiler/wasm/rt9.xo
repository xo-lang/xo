// The network of a wasip2 command over wasi:sockets 0.2 (decision 0447, R1
// of the wasi:sockets plan): TCP listen, accept, connect, read, write and
// close, deadlines, and name lookup. The logic that must match the native
// runtime (Net.only, address parsing, the error texts and NetErr statuses)
// is Xo, std/native/llrt/netwasi.xo, which the SSA builder calls in a wasm
// module in place of the runtime's rt.net_*, rt.listener_* and rt.conn_*
// (ssa/conc.xo net_rt); this runtime marshals the canonical ABI and waits.
//
// A call that would block (accept, finish-connect, a read with no data, a
// write the stream cannot take, a lookup in progress) subscribes to the
// resource's pollable, records it in the wait table and suspends the task
// ($block); the scheduler, when no task can run, polls every recorded
// pollable (and a clock pollable for the next deadline) in $io_poll, drops
// them, and wakes the waiters, which repeat their call. A write keeps how
// far it got in its connection, so a repeated call goes on from there.
//
// Objects (rt3.xo's handles: {rc, free, ...}):
//   listener   0 rc, 4 free, 8 tcp-socket, 12 closed
//   connection 0 rc, 4 free, 8 tcp-socket, 12 input-stream, 16
//              output-stream, 20 closed, 24 read deadline, 32 write
//              deadline (i64s, monotonic ns, 0 none; the read deadline
//              is the connect deadline until connected), 40 bytes of the
//              current write done, 44 std/tls's upgrade mark, 48 the
//              kind (0 tcp, 1 udp)
//   udp        a connection record (the same offsets for closed and the
//              deadlines, so wasi_sock_close and wasi_sock_deadline serve
//              both): 8 udp-socket, 12 incoming-datagram-stream, 16
//              outgoing-datagram-stream, 48 kind 1 (decision 0447 R2h)
// A call that fails returns the immortal empty string's object as its
// handle, which the reference counting never frees, and records the error
// for $wasi_sock_err: 0 none, 1 + a wasi:sockets error-code, 100 the
// object is closed, 101 canceled, 102 a deadline passed, 103 the end of
// the stream, 104 the stream closed under a write, 105 nothing to read yet
// (wasi_sock_try_read).

/// The runtime calls of rt9.xo (the operands' leaves, like rt3.xo's).
fn rt9_direct(name: Str) -> Bool {
  name is "net_status" | "net_msg" | "wasi_sock_status" | "wasi_sock_msg" | "wasi_sock_set" | "wasi_sock_err" | "wasi_sock_listen" | "wasi_sock_local" | "wasi_sock_peer" | "wasi_sock_accept" | "wasi_sock_connect" | "wasi_sock_connected" | "wasi_sock_read" | "wasi_sock_try_read" | "wasi_sock_readable" | "wasi_udp_open" | "wasi_udp_recv" | "wasi_udp_send" | "wasi_udp_local" | "wasi_rand_u64" | "wasi_sock_write" | "wasi_sock_close" | "wasi_sock_lclose" | "wasi_sock_deadline" | "wasi_sock_resolve" | "wasi_sock_next" | "wasi_sock_resolve_end"
}

/// The calls of rt9.xo that can suspend the task.
fn rt9_blocking(name: Str) -> Bool {
  name is "rt.wasi_sock_accept" | "rt.wasi_sock_connected" | "rt.wasi_sock_read" | "rt.wasi_sock_readable" | "rt.wasi_sock_write" | "rt.wasi_sock_next" | "rt.wasi_udp_recv" | "rt.wasi_udp_send"
}

/// Whether rt9 function name works on a TCP socket or its streams (the
/// rest: the outcome, close, deadlines and lookups, or rt.wasi_udp_*).
fn rt9_tcp(name: Str) -> Bool {
  name is "rt.wasi_sock_listen" | "rt.wasi_sock_local" | "rt.wasi_sock_peer" | "rt.wasi_sock_accept" | "rt.wasi_sock_connect" | "rt.wasi_sock_connected" | "rt.wasi_sock_read" | "rt.wasi_sock_try_read" | "rt.wasi_sock_readable" | "rt.wasi_sock_write" | "rt.wasi_sock_lclose"
}

/// The imports of rt9.xo.
fn rt9_imports() -> Str {
  """
    (import "wasi:sockets/instance-network@0.2.0" "instance-network" (func $sk_inst (result i32)))
    (import "wasi:sockets/tcp-create-socket@0.2.0" "create-tcp-socket" (func $sk_create (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.start-bind" (func $sk_sbind (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.finish-bind" (func $sk_fbind (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.start-connect" (func $sk_sconn (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.finish-connect" (func $sk_fconn (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.start-listen" (func $sk_slisten (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.finish-listen" (func $sk_flisten (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.accept" (func $sk_accept (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.local-address" (func $sk_local (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.remote-address" (func $sk_remote (param i32 i32)))
    (import "wasi:sockets/tcp@0.2.0" "[method]tcp-socket.subscribe" (func $sk_sub (param i32) (result i32)))
    (import "wasi:sockets/tcp@0.2.0" "[resource-drop]tcp-socket" (func $sk_drop (param i32)))
    (import "wasi:sockets/ip-name-lookup@0.2.0" "resolve-addresses" (func $sk_resolve (param i32 i32 i32 i32)))
    (import "wasi:sockets/ip-name-lookup@0.2.0" "[method]resolve-address-stream.resolve-next-address" (func $sk_rnext (param i32 i32)))
    (import "wasi:sockets/ip-name-lookup@0.2.0" "[method]resolve-address-stream.subscribe" (func $sk_rsub (param i32) (result i32)))
    (import "wasi:sockets/ip-name-lookup@0.2.0" "[resource-drop]resolve-address-stream" (func $sk_rdrop (param i32)))
    (import "wasi:io/streams@0.2.0" "[method]input-stream.read" (func $sk_iread (param i32 i64 i32)))
    (import "wasi:io/streams@0.2.0" "[method]input-stream.subscribe" (func $sk_isub (param i32) (result i32)))
    (import "wasi:io/streams@0.2.0" "[resource-drop]input-stream" (func $sk_idrop (param i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.check-write" (func $sk_ocheck (param i32 i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.write" (func $sk_owrite (param i32 i32 i32 i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.flush" (func $sk_oflush_start (param i32 i32)))
    (import "wasi:io/streams@0.2.0" "[method]output-stream.subscribe" (func $sk_osub (param i32) (result i32)))
    (import "wasi:io/poll@0.2.0" "poll" (func $sk_poll (param i32 i32 i32)))
    (import "wasi:sockets/udp-create-socket@0.2.0" "create-udp-socket" (func $udp_create (param i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]udp-socket.start-bind" (func $udp_sbind (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]udp-socket.finish-bind" (func $udp_fbind (param i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]udp-socket.stream" (func $udp_stream (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]udp-socket.local-address" (func $udp_local (param i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[resource-drop]udp-socket" (func $udp_drop (param i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]incoming-datagram-stream.receive" (func $udp_recv (param i32 i64 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]incoming-datagram-stream.subscribe" (func $udp_isub (param i32) (result i32)))
    (import "wasi:sockets/udp@0.2.0" "[resource-drop]incoming-datagram-stream" (func $udp_idrop (param i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]outgoing-datagram-stream.check-send" (func $udp_check (param i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]outgoing-datagram-stream.send" (func $udp_send (param i32 i32 i32 i32)))
    (import "wasi:sockets/udp@0.2.0" "[method]outgoing-datagram-stream.subscribe" (func $udp_osub (param i32) (result i32)))
    (import "wasi:sockets/udp@0.2.0" "[resource-drop]outgoing-datagram-stream" (func $udp_odrop (param i32)))

  """
}

/// The globals of rt9.xo: the outcome rt.net_status and rt.net_msg read
/// (set by netwasi.xo), the last call's error, the network, and the wait
/// table ({pollable, owner, task, unused} entries of 16 bytes).
fn rt9_globals(var g: Gen) -> Str {
  let empty = g.str_obj(b"")
  "    (global $nstat (mut i32) (i32.const 0))\n    (global $nmsg (mut i32) (i32.const ${empty}))\n    (global $nmsgn (mut i32) (i32.const 0))\n    (global $skerr (mut i32) (i32.const 0))\n    (global $skab (mut i32) (i32.const 0))\n    (global $sknet (mut i32) (i32.const -1))\n    (global $wq (mut i32) (i32.const 0))\n    (global $wn (mut i32) (i32.const 0))\n    (global $wcap (mut i32) (i32.const 0))\n    (global $wgen (mut i32) (i32.const 0))\n    (global $clq (mut i32) (i32.const 0))\n    (global $cln (mut i32) (i32.const 0))\n    (global $clcap (mut i32) (i32.const 0))\n"
}

/// rt3.xo's scheduler with $io_poll before it sleeps or reports a deadlock:
/// the waits on sockets are what can still wake a task.
/// tcp: the program closes TCP connections, so main's end waits for the
/// closing list ($sk_closing_drain) after $sched_end.
fn rt9_sched(rt3: Str, tcp: Bool = false) -> Str {
  var out = StrBuilder.new()
  let ls = rt3.lines()
  var done = false
  for (i, l) in ls.indexed() {
    out.write(l)
    out.write("\n")
    if tcp && l.trim() == "call $sched_end" {
      let ind = l[0..l.len() - l.trim_start().len()]
      out.write("${ind}call $sk_closing_drain\n")
    }
    if !done && l.trim() == "local.tee $d" && i > 0 && ls[i - 1].trim() == "call $next_deadline" {
      let ind = l[0..l.len() - l.trim_start().len()]
      out.write("${ind}call $io_poll\n${ind}br_if $round\n${ind}local.get $d\n")
      done = true
    }
  }
  if !done {
    fault("rt9_sched: rt3.xo's idle step changed")
  }
  out.freeze()
}

/// The functions of rt9.xo.
fn rt9_text(var g: Gen) -> Str {
  let dead = g.str_obj(b"")
  let conn_free = g.table_index("$sk_conn_free")
  // a listener's free is in the table, so kept whenever rt9 is: only a
  // TCP program has listeners (it calls TCP's drop; $wasi_sock_listen,
  // its one user, is stripped otherwise)
  let lis_free = if g.tcp { g.table_index("$sk_lis_free") } else { 0 }
  // a connection's shutdown and address for the kinds the program uses
  // only: each names its kind's imports, which the component then asks
  // the host for (decision 0447 R2h)
  let udp_shut = if g.udp { """
      local.get $c
      i32.load offset=48
      if
        ;; udp: the streams, children of the socket, first
        local.get $c
        i32.load offset=12
        call $udp_idrop
        local.get $c
        i32.load offset=16
        call $udp_odrop
        local.get $c
        i32.load offset=8
        call $udp_drop
        return
      end""" } else { "" }
  let tcp_shut = if g.tcp { """
      local.get $c
      i32.load offset=12
      if
        local.get $c
        i32.load offset=12
        call $sk_idrop
      end
      local.get $c
      i32.load offset=16
      if
        ;; what the stream holds goes out after the close, without waiting
        ;; here: a blocking flush stopped every task, the peer too when it
        ;; is one (a deadlock, websocket_tls_deadline 2026-11-03). Nothing
        ;; unsent (the flush ends at once) or a failed stream drops now;
        ;; else the stream and the socket wait in the closing list
        ;; ($sk_closing_sweep), since dropping a stream whose write is in
        ;; flight waits in the host for that write (conn_deadline)
        local.get $c
        i32.load offset=16
        call $hret_at
        call $sk_oflush_start
        local.get $c
        i32.load offset=16
        call $sk_out_done
        i32.eqz
        if
          local.get $c
          i32.load offset=16
          local.get $c
          i32.load offset=8
          call $sk_closing_add
          return
        end
        local.get $c
        i32.load offset=16
        call $ostream_drop
      end
      local.get $c
      i32.load offset=8
      call $sk_drop""" } else { "" }
  // the closing list (TCP only: a UDP close drops at once)
  let closing = if g.tcp { """
    ;; a closed connection's output stream o and socket s, kept until what
    ;; o holds has gone out ({o, s} entries of 8 bytes)
    (func $sk_closing_add (param $o i32) (param $s i32) (local $nb i32)
      global.get $cln
      global.get $clcap
      i32.ge_u
      if
        global.get $clcap
        i32.const 1
        i32.shl
        i32.const 4
        i32.add
        global.set $clcap
        global.get $clcap
        i32.const 3
        i32.shl
        call $alloc
        local.set $nb
        global.get $clq
        if
          local.get $nb
          global.get $clq
          global.get $cln
          i32.const 3
          i32.shl
          memory.copy
          global.get $clq
          call $free
        end
        local.get $nb
        global.set $clq
      end
      global.get $clq
      global.get $cln
      i32.const 3
      i32.shl
      i32.add
      local.tee $nb
      local.get $o
      i32.store
      local.get $nb
      local.get $s
      i32.store offset=4
      global.get $cln
      i32.const 1
      i32.add
      global.set $cln)

    ;; 1 when output stream o, after a flush started, has written what it
    ;; held (check-write allows bytes again) or failed; never waits
    (func $sk_out_done (param $o i32) (result i32) (local $r i32)
      local.get $o
      call $hret_at
      local.tee $r
      call $sk_ocheck
      local.get $r
      i32.load8_u
      if
        local.get $r
        i32.load8_u offset=8
        i32.eqz
        if
          local.get $r
          i32.load offset=12
          call $ioerr_drop
        end
        i32.const 1
        return
      end
      local.get $r
      i64.load offset=8
      i64.eqz
      i32.eqz)

    ;; drops each closing entry whose stream is done ($sk_out_done); the
    ;; host writes in the background meanwhile. Called from $io_poll and
    ;; $sk_closing_drain.
    (func $sk_closing_sweep (local $i i32) (local $e i32)
      block $x
        loop $l
          local.get $i
          global.get $cln
          i32.ge_u
          br_if $x
          global.get $clq
          local.get $i
          i32.const 3
          i32.shl
          i32.add
          local.tee $e
          i32.load
          call $sk_out_done
          if
            local.get $e
            i32.load
            call $ostream_drop
            local.get $e
            i32.load offset=4
            call $sk_drop
            ;; the last entry takes its place
            global.get $cln
            i32.const 1
            i32.sub
            global.set $cln
            local.get $e
            global.get $clq
            global.get $cln
            i32.const 3
            i32.shl
            i32.add
            i64.load
            i64.store
          else
            local.get $i
            i32.const 1
            i32.add
            local.set $i
          end
          br $l
        end
      end)

    ;; after main ended: waits for the closing streams to write what they
    ;; hold, at most 2 s, then leaves the rest to the instance's end (a
    ;; native close hands the bytes to the kernel, which sends them after
    ;; the process exits; a WASI instance's streams end with it)
    (func $sk_closing_drain (local $end i64) (local $b i32) (local $i i32) (local $left i64) (local $r i32)
      call $sk_closing_sweep
      global.get $cln
      i32.eqz
      if
        return
      end
      call $mono
      i64.const 2000000000
      i64.add
      local.set $end
      block $out
        loop $wait
          call $sk_closing_sweep
          global.get $cln
          i32.eqz
          br_if $out
          local.get $end
          call $mono
          i64.sub
          local.tee $left
          i64.const 0
          i64.le_s
          br_if $out
          ;; each stream's pollable and the clock's, then one poll
          global.get $cln
          i32.const 1
          i32.add
          i32.const 2
          i32.shl
          call $alloc
          local.set $b
          i32.const 0
          local.set $i
          block $x
            loop $l
              local.get $i
              global.get $cln
              i32.ge_u
              br_if $x
              local.get $b
              local.get $i
              i32.const 2
              i32.shl
              i32.add
              global.get $clq
              local.get $i
              i32.const 3
              i32.shl
              i32.add
              i32.load
              call $sk_osub
              i32.store
              local.get $i
              i32.const 1
              i32.add
              local.set $i
              br $l
            end
          end
          local.get $b
          global.get $cln
          i32.const 2
          i32.shl
          i32.add
          local.get $left
          call $mono_sub
          i32.store
          local.get $b
          global.get $cln
          i32.const 1
          i32.add
          call $hret_at
          local.tee $r
          call $sk_poll
          local.get $r
          i32.load offset=4
          if
            local.get $r
            i32.load
            call $free
          end
          i32.const 0
          local.set $i
          block $x
            loop $l
              local.get $i
              global.get $cln
              i32.gt_u
              br_if $x
              local.get $b
              local.get $i
              i32.const 2
              i32.shl
              i32.add
              i32.load
              call $poll_drop
              local.get $i
              i32.const 1
              i32.add
              local.set $i
              br $l
            end
          end
          local.get $b
          call $free
          br $wait
        end
      end
      ;; what is left is not dropped: wasmtime's drop of an output stream
      ;; waits for its write, which a peer that never reads never ends
      ;; (conn_deadline hung so, 2026-11-03); the instance's end takes them
      )
""" } else { "" }
  let udp_addr = if g.udp { """
      local.get $remote
      i32.const 2
      i32.eq
      if
        local.get $s
        local.get $r
        call $udp_local
        br $got
      end""" } else { "" }
  let tcp_addr = if g.tcp { """
      local.get $remote
      if
        local.get $s
        local.get $r
        call $sk_remote
      else
        local.get $s
        local.get $r
        call $sk_local
      end""" } else { "" }
  let sweep = if g.tcp { "      call $sk_closing_sweep" } else { "" }
  // the closing streams' pollables join the poll, so a flush that ends
  // while the tasks wait on other pollables (a peer waiting for the end
  // of its stream, which comes once the socket is dropped) wakes it
  let cl_room = if g.tcp { "      global.get $cln\n      i32.add" } else { "" }
  let cl_add = if g.tcp { """
      local.get $n
      local.set $cb
      global.get $cln
      local.set $ck
      i32.const 0
      local.set $i
      block $x
        loop $l
          local.get $i
          local.get $ck
          i32.ge_u
          br_if $x
          local.get $b
          local.get $n
          i32.const 2
          i32.shl
          i32.add
          global.get $clq
          local.get $i
          i32.const 3
          i32.shl
          i32.add
          i32.load
          call $sk_osub
          i32.store
          local.get $n
          i32.const 1
          i32.add
          local.set $n
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $l
        end
      end""" } else { "" }
  let cl_drop = if g.tcp { """
      i32.const 0
      local.set $i
      block $x
        loop $l
          local.get $i
          local.get $ck
          i32.ge_u
          br_if $x
          local.get $b
          local.get $cb
          local.get $i
          i32.add
          i32.const 2
          i32.shl
          i32.add
          i32.load
          call $poll_drop
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $l
        end
      end""" } else { "" }
  """
    ;; the outcome of the last network operation (netwasi.xo's): a NetErr
    ;; status (0 none) and its message
    (func $net_status (result i64)
      global.get $nstat
      i64.extend_i32_u)

    (func $net_msg (result i32 i32)
      global.get $nmsg
      call $rc_inc
      global.get $nmsg
      global.get $nmsgn)

    (func $wasi_sock_status (result i64)
      call $net_status)

    (func $wasi_sock_msg (result i32 i32)
      call $net_msg)

    (func $wasi_sock_set (param $s i64) (param $m i32) (param $mn i32) (local $o i32)
      local.get $s
      i32.wrap_i64
      global.set $nstat
      local.get $m
      call $rc_inc
      global.get $nmsg
      local.set $o
      local.get $m
      global.set $nmsg
      local.get $mn
      global.set $nmsgn
      local.get $o
      call $rc_dec
      if
        local.get $o
        call $free
      end)

    (func $wasi_sock_err (result i64)
      global.get $skerr
      i64.extend_i32_u)

    (func $sk_fail (param $e i32) (result i32)
      local.get $e
      global.set $skerr
      i32.const ${dead})

    ;; the instance's network, got once
    (func $sk_net (result i32)
      global.get $sknet
      i32.const -1
      i32.eq
      if
        call $sk_inst
        global.set $sknet
      end
      global.get $sknet)

    ;; 0 when the result<_, error-code> at r is ok, else 1 + its code
    (func $sk_unit (param $r i32) (result i32)
      local.get $r
      i32.load8_u
      i32.eqz
      if
        i32.const 0
        return
      end
      local.get $r
      i32.load8_u offset=1
