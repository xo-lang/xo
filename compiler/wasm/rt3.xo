      local.get $t
      global.get $fmsgn
      i32.store offset=144
      local.get $t
      global.get $floc
      i32.store offset=148
      local.get $t
      global.get $flocn
      i32.store offset=152
      local.get $t
      global.get $fdet
      i32.store offset=156
      local.get $t
      global.get $fdetn
      i32.store offset=160
      local.get $t
      global.get $flocobj
      i32.store offset=168
      i32.const 0
      global.set $fmsg
      i32.const 0
      global.set $fdet
      i32.const 0
      global.set $fdetn
      i32.const 0
      global.set $flocobj
