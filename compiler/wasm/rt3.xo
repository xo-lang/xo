    ;; main ended: the scheduler's memory goes
    (func $sched_end (local $m i32)
      global.get $mtask
      local.tee $m
      i32.load offset=20
      if
        local.get $m
        i32.load offset=20
        call $free
      end
      local.get $m
      call $free
      global.get $act
      if
        global.get $act
        call $free
      end)

    ;; ------------------------------------------------------------------
    ;; scopes and tasks

    (func $node_new (param $parent i32) (result i32) (local $n i32)
      i32.const 12
      call $alloc
      local.tee $n
      i32.const 0
      i32.const 12
      memory.fill
      local.get $n
      local.get $parent
      i32.store offset=4
      local.get $n)

    (func $scope_open (result i32) (local $s i32)
      ;; word 72: $tdl before the scope's deadline lowered it (0430)
      i32.const 80
      i32.const ${scope_free}
      call $obj_new
      local.tee $s
      global.get $node
      i32.store offset=12
      local.get $s
      local.get $s
      i32.const 8
      i32.add
      call $node_new
      i32.store offset=16
      local.get $s
      global.get $node
      i32.store offset=40
      local.get $s
      i32.const 8
      i32.add
      global.set $node
      local.get $s)

    (func $scope_free (param $s i32) (local $n i32) (local $x i32)
      local.get $s
      i32.load offset=16
      call $free
      local.get $s
      i32.load offset=44
      local.set $n
      block $x
