          local.get $n
          i32.eqz
          br_if $x
          local.get $n
          i32.load offset=8
          local.get $n
          call $free
          local.set $n
          br $l
        end
      end
      local.get $s
      i32.load offset=32
      local.tee $x
      if
        local.get $x
        call $h_release
      end
      local.get $s
      i32.load offset=36
      local.tee $x
      if
        local.get $x
        call $h_release
      end
      local.get $s
      call $free)

    (func $scope_group (param $s i32) (result i32)
      local.get $s
      call $rc_inc
      local.get $s)

    (func $scope_cancel (param $s i32) (local $old i32)
      local.get $s
      i32.load offset=16
      local.tee $old
      local.get $s
      i32.load offset=44
      i32.store offset=8
      local.get $s
      local.get $old
      i32.store offset=44
      local.get $s
      local.get $s
      i32.const 8
      i32.add
      call $node_new
      i32.store offset=16
      local.get $old
      call $ncancel)

    (func $scope_fail_task (param $s i32) (result i32)
      local.get $s
      i32.load offset=32
      call $rc_inc
      local.get $s
      i32.load offset=32)

    (func $scope_fail_site (param $s i32) (result i64)
      local.get $s
      i32.load offset=32
      i32.eqz
      if
        i64.const -1
        return
      end
