      i32.store
      local.get $t
      local.get $run
      i32.wrap_i64
      i32.store offset=12
      local.get $t
      local.get $fl
      i32.store offset=16
      local.get $t
      local.get $flags
      i32.wrap_i64
      i32.const 1
      i32.and
      i32.store offset=40
      local.get $t
      local.get $flags
      i32.wrap_i64
      i32.const 1
      i32.shr_u
      i32.const 1
      i32.and
      i32.store offset=44
      local.get $t
      local.get $site
      i64.store offset=48
      local.get $t
      local.get $s
      i32.store offset=56
      local.get $t
      local.get $s
      i32.load offset=16
      i32.store offset=64
