                end
                local.get $t
                call $task_end
                local.get $i
                call $act_del
                br $each
              end
            end
            local.get $i
            i32.const 1
            i32.add
            local.set $i
            br $each
          end
        end
        local.get $progress
        br_if $round
        call $next_deadline
        local.tee $d
        i64.eqz
        i32.eqz
        if
          local.get $d
          call $sleep_until
          br $round
        end
      end
