      i32.load offset=140
      local.tee $x
      if
        local.get $x
        call $free
      end
      local.get $t
      i32.load offset=168
      local.tee $x
      if
        local.get $x
        call $free
      end
      local.get $t
      i32.load offset=156
      local.tee $x
      if
        local.get $x
        call $free
      end
      local.get $t
      call $free)

    ;; xo_task_done: the result (a list of one, consumed); a failure
