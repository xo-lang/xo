      i32.const 2
      ${dead}
      call $write
      i32.const 70
      call $proc_exit)

    ;; a task's run ended (run_claimed after the run)
    (func $task_end (param $t i32) (local $s i32)
      local.get $t
      i32.const 2
      i32.store offset=8
      local.get $t
      i32.load offset=20
      if
        local.get $t
        i32.load offset=20
        call $free
      end
      local.get $t
      i32.const 0
      i32.store offset=20
      i32.const 0
      global.set $ssb
      i32.const 0
      global.set $ssn
      i32.const 0
      global.set $sscap
      local.get $t
      call $switch_out
      local.get $t
      i32.load offset=176
      call $bud_release
      local.get $t
      i32.const 0
      i32.store offset=176
      local.get $t
      i32.load offset=56
