      i32.load offset=32
      i64.load offset=48)

    ;; takes scope s off the list of deadlines
    (func $undeadline (param $s i32) (local $p i32)
      global.get $dscopes
      local.get $s
      i32.eq
      if
        local.get $s
        i32.load offset=60
        global.set $dscopes
        return
      end
      global.get $dscopes
      local.set $p
      block $x
        loop $l
          local.get $p
          i32.eqz
          br_if $x
          local.get $p
          i32.load offset=60
          local.get $s
          i32.eq
          if
            local.get $p
            local.get $s
            i32.load offset=60
            i32.store offset=60
            return
          end
          local.get $p
          i32.load offset=60
          local.set $p
          br $l
        end
      end)

    (func $scope_deadline (param $s i32) (param $d i64) (local $at i64)
      local.get $s
      call $mono
      local.get $d
      i64.add
      local.tee $at
      i64.store offset=48
      ;; task.deadline: min($tdl, at), the old one kept for the close
      local.get $s
      global.get $tdl
      i64.store offset=72
      global.get $tdl
      i64.eqz
      local.get $at
      global.get $tdl
      i64.lt_s
      i32.or
      if
        local.get $at
        global.set $tdl
      end
      local.get $s
      global.get $dscopes
      i32.store offset=60
      local.get $s
      global.set $dscopes)

    ;; rt.task_deadline_left (decision 0430): the ns left until $tdl, the
    ;; least i64 for none
    (func $task_deadline_left (result i64)
      global.get $tdl
      i64.eqz
      if
        i64.const 0x8000000000000000
        return
      end
      global.get $tdl
      call $mono
      i64.sub)

    (func $scope_timed_out (param $s i32) (result i32)
      local.get $s
      i32.load offset=56
      i32.eqz
      call $ctx_canceled
      i32.or
      if
        i32.const 0
        return
      end
      i32.const 0
      global.set $unw
      i32.const 1)

    ;; xo_scope_close: mode 0 the body completed, 1 an early exit, 2
    ;; unwinding; waits for every task (a suspension point), then 1 when
    ;; a child failed and its error propagates, 3 when one faulted
    (func $scope_close (param $s i32) (param $mode i64) (result i64) (local $t i32) (local $next i32)
      call $resumed
      i32.eqz
      if
        local.get $s
        i64.load offset=48
        i64.eqz
        i32.eqz
        if
          local.get $s
          call $undeadline
