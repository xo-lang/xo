// The runtime of the WebAssembly backend, stage 2 (decision 0179): tasks
// without threads. Scopes, tasks, channels, select, Mutex, Atomic, and
// cancellation run on one thread under a cooperative scheduler: a task
// that has to wait (a receive on an empty channel, an await, a scope's
// close, a contended Mutex) suspends by unwinding its wasm stack into a
// save area of its own (the code of every function that can suspend
// stores its locals and its resume point, func.xo), and the scheduler
// resumes it later by calling its entry function again, which rewinds
// the stack from that area (Asyncify's technique, generated by this
// backend). The scheduler runs the tasks in the order they were spawned,
// each until it waits or ends, so a program's output is the same on
// every run. The semantics are std/llrt's xo_rt.c ("Scopes and tasks",
// "Channels", "Mutex", "Atomic"), function by function, without the
// worker pool. WAT text assembled with a program that uses them.
//
// Layouts (every object starts with its count and the table index of
// the function that frees it, as handles do):
//
//   task     0 rc, 4 free, 8 state (0 queued, 1 started, 2 done), 12 run
//            (table index; -1 for main), 16 the closure list, 20 save
//            area, 24 its length, 28 its capacity, 32 result list, 36
//            unwound, 40 background, 44 consumed, 48 site (i64), 56
//            scope, 60 node {canceled, parent}, 68 next in the scope's
//            list, 72..103 the fault globals while it does not run, 104
//            context node, 108 shield, 112 unwinding, 116 events when
//            it suspended, 120 blocked, 124 its channel entry, 128
//            deadline (i64, ns; 0 none), 136 held mutexes, 140 its fault
//            {msg, msgn, loc, locn, detail, detailn, locobj at 168}, 164
//            the drop of its result list; 176 bytes
//   scope    0 rc, 4 free, 8 body node {canceled, parent}, 16 tasks
//            node, 20 task list, 24 tasks not done, 28 closed, 32 failed
//            task, 36 faulted task, 40 parent node, 44 replaced task
//            nodes, 48 deadline (i64), 56 timed out, 60 next scope with
//            a deadline; 64 bytes
//   node     0 canceled, 4 parent, 8 next replaced node
//   channel  0 rc, 4 free, 8 cap, 12 head, 16 len, 20 buffer, 24
//            closed, 28 drop of a value list, 32 receivers {head, tail},
//            40 senders {head, tail}
//   entry    0 fired (address), 4 item, 8 shut, 12 arm index, 16 chosen
//            (address or 0), 20 prev, 24 next, 28 own fired flag
//   select   0 rc, 4 free, 8 arms, 12 count, 16 capacity, 20 fired, 24
//            chosen, 28 has after, 32 after (i64); an arm (64 bytes): 0
//            channel, 4 send, 8 item, 16 entry
//   mutex    0 rc, 4 free, 8 writer, 12 readers, 16 waiting writers, 20
//            value list, 24 its drop
//   atomic   0 rc, 4 free, 8 value (i64)
//   held     0 mutex, 4 location, 8 its length, 12 next

/// The blocking runtime calls: where a task can suspend.
fn rt3_blocking(name: Str) -> Bool {
  name is "rt.atomic_get" | "rt.atomic_set" | "rt.atomic_swap" | "rt.atomic_cas" | "rt.atomic_add" | "rt.atomic_max" | "rt.is_canceled" | "rt.chan_send" | "rt.chan_recv" | "rt.task_await" | "rt.scope_close" | "rt.select_wait" | "rt.mutex_lock" | "rt.mutex_rlock" | "rt.clock_sleep" | "rt.clock_sleep_or_cancel"
}

/// The runtime functions of rt3.xo called with the operands' leaves.
fn rt3_direct(name: Str) -> Bool {
  name is "scope_open" | "scope_close" | "scope_cancel" | "scope_group" | "scope_fail_task" | "scope_fail_site" | "task_spawn" | "task_await" | "task_result" | "task_done" | "task_unwound" | "fault_rethrow" | "is_canceled" | "shield_begin" | "shield_end" | "shield_abort" | "chan_new" | "chan_send" | "chan_recv" | "chan_try_send" | "chan_try_recv" | "chan_close" | "chan_len" | "mutex_new" | "mutex_lock" | "mutex_unlock" | "mutex_rlock" | "mutex_runlock" | "atomic_new" | "atomic_get" | "atomic_set" | "atomic_swap" | "atomic_cas" | "atomic_add" | "atomic_max" | "select_new" | "select_recv" | "select_send" | "select_after" | "select_wait" | "select_take" | "prog_group_set" | "prog_group_clear" | "prog_group" | "clock_now" | "task_deadline_left" | "clock_sleep" | "clock_sleep_or_cancel" | "scope_deadline" | "scope_timed_out" | "h_zero" | "tick" | "budget_open" | "budget_end"
}

/// The WASI imports of the task runtime: the clocks and waiting for one.
fn rt3_imports() -> Str {
  """
    (import "wasi_snapshot_preview1" "clock_time_get" (func $clock_time_get (param i32 i64 i32) (result i32)))
    (import "wasi_snapshot_preview1" "poll_oneoff" (func $poll_oneoff (param i32 i32 i32 i32) (result i32)))

  """
}

/// The globals of the task runtime.
fn rt3_globals() -> Str {
  """
    (global $sstate (mut i32) (i32.const 0))
    (global $cur (mut i32) (i32.const 0))
    (global $mtask (mut i32) (i32.const 0))
    (global $ssb (mut i32) (i32.const 0))
    (global $ssn (mut i32) (i32.const 0))
    (global $sscap (mut i32) (i32.const 0))
    (global $node (mut i32) (i32.const 0))
    (global $shield (mut i32) (i32.const 0))
    (global $unw (mut i32) (i32.const 0))
    (global $events (mut i32) (i32.const 0))
    (global $act (mut i32) (i32.const 0))
    (global $nact (mut i32) (i32.const 0))
    (global $actcap (mut i32) (i32.const 0))
    (global $pgroup (mut i32) (i32.const 0))
    (global $dscopes (mut i32) (i32.const 0))
    ;; task.deadline (decision 0430): the running task's nearest
    ;; with_timeout deadline ($mono ns, 0 none); a task's word 200
    (global $tdl (mut i64) (i64.const 0))
    (global $quantum (mut i32) (i32.const 64))
    (global $bud (mut i32) (i32.const 0))
    (global $budq (mut i64) (i64.const 0))
    (global $budleft (mut i64) (i64.const 0))
    (global $budrun (mut i64) (i64.const 0))
    (global $budam (mut i64) (i64.const 0))

  """
}

/// The task runtime's functions; main is the index of the program's main
/// and main_res its result leaves.
fn rt3_text(var g: Gen, main: Int, main_res: List[Str], main_args: Str) -> Str {
  let dropsig = g.sig(["i32"], [])
  let runsig = g.sig(["i32", "i32"], [])
  let empty = g.empty_list
  let zh = g.str_obj(b"")
  let task_free = g.table_index("$task_free")
  let scope_free = g.table_index("$scope_free")
  let chan_free = g.table_index("$chan_free")
  let mutex_free = g.table_index("$mutex_free")
  let select_free = g.table_index("$select_free")
  let plain_free = g.table_index("$plain_free")
  let ended = g.str_obj(b"a task was started on a scope that has ended")
  let ended_n = 44
  let awaited = g.str_obj(b"awaited a task that was canceled before it finished")
  let awaited_n = 51
  let closed = g.str_obj(b"send on a closed channel")
  let closed_n = 24
  let negcap = g.litp("negative channel capacity ")
  let reent = g.litp("XO-F004: Mutex.")
  let reent2 = g.litp(" called re-entrantly in one task; the mutex is already held from ")
  let w_with = g.raw("with".bytes())
  let w_read = g.raw("with_read".bytes())
  let dead = g.litp("fault: XO-F001: deadlock: every task is blocked\n")
  let notasks = g.str_obj(b"os.tasks is not available here")
  let notasks_n = 30
  let ovf = g.litp("integer overflow: ")
  let plus = g.litp(" + ")
  let dnf = g.litp(" does not fit Int")
  let bneg = g.litp("task.with_budget: a negative ceiling (cpu ")
  let balloc = g.litp(", alloc ")
  let bsteps = g.litp(", steps ")
  var drops = ""
  for _ in main_res {
    drops = "${drops}\n      drop"
  }
  """
    ;; the program's main as a task's entry function
    (func $main_entry${main_args}
      call $f${main}${drops})

    (func $plain_free (param $p i32)
      local.get $p
      call $free)

    ;; a new zeroed object of n bytes with count 1 and free function f
    (func $obj_new (param $n i32) (param $f i32) (result i32) (local $p i32)
      local.get $n
      call $alloc
      local.tee $p
      i32.const 0
      local.get $n
      memory.fill
      local.get $p
      i32.const 1
      i32.store
      local.get $p
      local.get $f
      i32.store offset=4
      local.get $p)

    ;; releases a handle (h_release)
    (func $h_release (param $p i32)
      local.get $p
      call $rc_dec
      if
        local.get $p
        local.get $p
        i32.load offset=4
        call $rc_defer
      end)

    ;; releases list l with its drop function d (list_release)
    (func $list_release (param $l i32) (param $d i32)
      local.get $l
      i32.eqz
      local.get $l
      i32.const ${empty}
      i32.eq
      i32.or
      if
        return
      end
      local.get $l
      local.get $d
      call_indirect (type ${dropsig}))

    (func $h_zero (result i32)
      i32.const ${zh})

    ;; ------------------------------------------------------------------
    ;; cancellation

    (func $ncanceled (param $n i32) (result i32)
      block $x
        loop $l
          local.get $n
          i32.eqz
          br_if $x
          local.get $n
          i32.load
          if
            i32.const 1
            return
          end
          local.get $n
          i32.load offset=4
          local.set $n
          br $l
        end
      end
      i32.const 0)

    (func $ctx_canceled (result i32)
      global.get $shield
      if
        i32.const 0
        return
      end
      global.get $node
      call $ncanceled)

    ;; a cancellation point: 1 (and unwinding) when canceled
    (func $canceled (result i32)
      call $ctx_canceled
      if
        i32.const 1
        global.set $unw
        i32.const 1
        return
      end
      i32.const 0)

    (func $is_canceled (result i32)
      call $yield_point
      if
        i32.const 0
        return
      end
      call $canceled)

    (func $wake
      global.get $events
      i32.const 1
      i32.add
      global.set $events)

    (func $ncancel (param $n i32)
      local.get $n
      i32.const 1
      i32.store
      call $wake)

    (func $shield_begin (result i64) (local $t i64)
      global.get $unw
      i64.extend_i32_u
      local.set $t
      i32.const 0
      global.set $unw
      global.get $shield
      i32.const 1
      i32.add
      global.set $shield
      call $timers
      local.get $t)

    (func $shield_end (param $t i64) (param $lo i32) (param $ln i32)
      global.get $shield
      i32.const 1
      i32.sub
      global.set $shield
      local.get $t
      i32.wrap_i64
      i32.const 1
      i32.and
      global.set $unw)

    (func $shield_abort (param $t i64)
      global.get $shield
      i32.const 1
      i32.sub
      global.set $shield
      local.get $t
      i32.wrap_i64
      i32.const 1
      i32.and
      global.set $unw)

    ;; ------------------------------------------------------------------
    ;; suspending: the current task waits; the code above it saves its
    ;; frames (func.xo) and returns to the scheduler

    (func $block
      global.get $cur
      global.get $events
      i32.store offset=116
      i32.const 1
      global.set $sstate)

    ;; whether the call is a task's resumption (its stack rewound)
    (func $resumed (result i32)
      global.get $sstate
      i32.const 2
      i32.eq
      if
        i32.const 0
        global.set $sstate
        i32.const 1
        return
      end
      i32.const 0)

    ;; a scheduling point (Atomic operations, task.is_canceled), as in
    ;; the Go backend's deterministic scheduler (gotchas/
    ;; busy-loop-starves-deterministic-scheduler.md): every 64th lets
    ;; the other tasks run, so a loop that polls them makes progress; 1
    ;; when the caller suspends now (and repeats the call on resumption)
    (func $yield_point (result i32)
      call $resumed
      if
        i32.const 0
        return
      end
      global.get $quantum
      i32.const 1
      i32.sub
      global.set $quantum
      global.get $quantum
      i32.const 0
      i32.gt_s
      global.get $nact
      i32.const 2
      i32.lt_u
      i32.or
      ;; not inside a real-time section: saving the frames allocates
      global.get $rtdepth
      i32.or
      if
        i32.const 0
        return
      end
      i32.const 64
      global.set $quantum
      ;; runnable again at once
      global.get $cur
      global.get $events
      i32.const 1
      i32.sub
      i32.store offset=116
      i32.const 1
      global.set $sstate
      i32.const 1)

    ;; the save area of the current task: n bytes pushed, their address
    (func $ss_push (param $n i32) (result i32) (local $c i32) (local $p i32)
      global.get $ssn
      local.get $n
      i32.add
      global.get $sscap
      i32.gt_u
      if
        global.get $sscap
        i32.const 1
        i32.shl
        local.tee $c
        global.get $ssn
        local.get $n
        i32.add
        local.tee $p
        local.get $c
        local.get $p
        i32.gt_u
        select
        local.tee $c
        i32.const 256
        local.get $c
        i32.const 256
        i32.gt_u
        select
        local.tee $c
        call $alloc
        local.tee $p
        global.get $ssb
        global.get $ssn
        memory.copy
        global.get $ssb
        if
          global.get $ssb
          call $free
        end
        local.get $p
        global.set $ssb
        local.get $c
        global.set $sscap
      end
      global.get $ssb
      global.get $ssn
      i32.add
      global.get $ssn
      local.get $n
      i32.add
      global.set $ssn)

    (func $ss_pop (param $n i32) (result i32)
      global.get $ssn
      local.get $n
      i32.sub
      global.set $ssn
      global.get $ssb
      global.get $ssn
      i32.add)

    ;; ------------------------------------------------------------------
    ;; the scheduler

    ;; makes t the running task: its context into the globals
    (func $switch_in (param $t i32)
      local.get $t
      global.set $cur
      local.get $t
      i32.load offset=20
      global.set $ssb
      local.get $t
      i32.load offset=24
      global.set $ssn
      local.get $t
      i32.load offset=28
      global.set $sscap
      local.get $t
      i32.load offset=72
      global.set $fmsg
      local.get $t
      i32.load offset=76
      global.set $fmsgn
      local.get $t
      i32.load offset=80
      global.set $floc
      local.get $t
      i32.load offset=84
      global.set $flocn
      local.get $t
      i32.load offset=88
      global.set $fdet
      local.get $t
      i32.load offset=92
      global.set $fdetn
      local.get $t
      i32.load offset=96
      global.set $flocobj
      local.get $t
      i32.load offset=100
      global.set $faulting
      local.get $t
      i32.load offset=104
      global.set $node
      local.get $t
      i32.load offset=108
      global.set $shield
      local.get $t
      i32.load offset=112
      global.set $unw
      local.get $t
      i32.load offset=172
      global.set $prop
      local.get $t
      i32.load offset=176
      global.set $bud
      local.get $t
      i64.load offset=200
      global.set $tdl
      local.get $t
      i64.load offset=184
      global.set $budq
      local.get $t
      i64.load offset=192
      global.set $budleft
      global.get $bud
      if
        call $bud_mark
      end
      i32.const 64
      global.set $quantum)

    ;; the running task's context back into it
    (func $switch_out (param $t i32)
      local.get $t
      global.get $ssb
      i32.store offset=20
      local.get $t
      global.get $ssn
      i32.store offset=24
      local.get $t
      global.get $sscap
      i32.store offset=28
      local.get $t
      global.get $fmsg
      i32.store offset=72
      local.get $t
      global.get $fmsgn
      i32.store offset=76
      local.get $t
      global.get $floc
      i32.store offset=80
      local.get $t
      global.get $flocn
      i32.store offset=84
      local.get $t
      global.get $fdet
      i32.store offset=88
      local.get $t
      global.get $fdetn
      i32.store offset=92
      local.get $t
      global.get $flocobj
      i32.store offset=96
      local.get $t
      global.get $faulting
      i32.store offset=100
      local.get $t
      global.get $node
      i32.store offset=104
      local.get $t
      global.get $shield
      i32.store offset=108
      local.get $t
      global.get $unw
      i32.store offset=112
      local.get $t
      global.get $prop
      i32.store offset=172
      local.get $t
      global.get $tdl
      i64.store offset=200
      global.get $bud
      if
        i32.const 0
        call $bud_charge
      end
      local.get $t
      global.get $bud
      i32.store offset=176
      local.get $t
      global.get $budq
      i64.store offset=184
      local.get $t
      global.get $budleft
      i64.store offset=192
      i32.const 0
      global.set $cur)

    (func $act_push (param $t i32) (local $p i32)
      global.get $nact
      global.get $actcap
      i32.eq
      if
        global.get $actcap
        i32.const 1
        i32.shl
        i32.const 16
        global.get $actcap
        select
        global.set $actcap
        global.get $actcap
        i32.const 2
        i32.shl
        call $alloc
        local.tee $p
        global.get $act
        global.get $nact
        i32.const 2
        i32.shl
        memory.copy
        global.get $act
        if
          global.get $act
          call $free
        end
        local.get $p
        global.set $act
      end
      global.get $act
      global.get $nact
      i32.const 2
      i32.shl
      i32.add
      local.get $t
      i32.store
      global.get $nact
      i32.const 1
      i32.add
      global.set $nact)

    ;; takes entry i out of the active list, keeping the order
    (func $act_del (param $i i32)
      global.get $act
      local.get $i
      i32.const 2
      i32.shl
      i32.add
      local.tee $i
      local.get $i
      i32.const 4
      i32.add
      global.get $act
      global.get $nact
      i32.const 2
      i32.shl
      i32.add
      local.get $i
      i32.sub
      i32.const 4
      i32.sub
      memory.copy
      global.get $nact
      i32.const 1
      i32.sub
      global.set $nact)

    ;; the monotonic clock in nanoseconds (WASI clock_time_get)
    (func $mono (result i64)
      i32.const 1
      i64.const 1
      i32.const 16
      call $clock_time_get
      drop
      i32.const 16
      i64.load)

    ;; rt.clock_now: the wall clock in Unix nanoseconds
    (func $clock_now (result i64)
      i32.const 0
      i64.const 1
      i32.const 16
      call $clock_time_get
      drop
      i32.const 16
      i64.load)

    ;; fires the deadlines of scopes that passed (scope_deadline_fire)
    (func $timers (local $s i32) (local $pp i32) (local $now i64)
      global.get $dscopes
      i32.eqz
      if
        return
      end
      call $mono
      local.set $now
      i32.const 0
      local.set $pp
      global.get $dscopes
      local.set $s
      block $x
        loop $l
          local.get $s
          i32.eqz
          br_if $x
          local.get $s
          i64.load offset=48
          local.get $now
          i64.le_s
          if
            local.get $s
            i32.const 1
            i32.store offset=56
            local.get $s
            i32.const 8
            i32.add
            call $ncancel
            local.get $s
            i64.const 0
            i64.store offset=48
            ;; unlink
            local.get $pp
            if
              local.get $pp
              local.get $s
              i32.load offset=60
              i32.store offset=60
            else
              local.get $s
              i32.load offset=60
              global.set $dscopes
            end
          else
            local.get $s
            local.set $pp
          end
          local.get $s
          i32.load offset=60
          local.set $s
          br $l
        end
      end)

    ;; the earliest deadline of a blocked task or a scope, 0 for none
    (func $next_deadline (result i64) (local $d i64) (local $i i32) (local $t i32) (local $s i32) (local $w i64)
      block $x
        loop $l
          local.get $i
          global.get $nact
          i32.ge_u
          br_if $x
          global.get $act
          local.get $i
          i32.const 2
          i32.shl
          i32.add
          i32.load
          local.tee $t
          i32.load offset=120
          if
            local.get $t
            i64.load offset=128
            local.tee $w
            i64.eqz
            i32.eqz
            if
              local.get $d
              i64.eqz
              local.get $w
              local.get $d
              i64.lt_s
              i32.or
              if
                local.get $w
                local.set $d
              end
            end
          end
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $l
        end
      end
      global.get $dscopes
      local.set $s
      block $x
        loop $l
          local.get $s
          i32.eqz
          br_if $x
          local.get $s
          i64.load offset=48
          local.set $w
          local.get $d
          i64.eqz
          local.get $w
          local.get $d
          i64.lt_s
          i32.or
          if
            local.get $w
            local.set $d
          end
          local.get $s
          i32.load offset=60
          local.set $s
          br $l
        end
      end
      local.get $d)

    ;; waits until the monotonic clock reaches d (WASI poll_oneoff on a
    ;; clock subscription)
    (func $sleep_until (param $d i64) (local $now i64)
      call $mono
      local.tee $now
      local.get $d
      i64.ge_s
      if
        return
      end
      ;; the subscription at 64: userdata, tag 0 (clock), clock id 1,
      ;; timeout, precision, flags 0 (relative)
      i32.const 64
      i32.const 0
      i32.const 48
      memory.fill
      i32.const 80
      i32.const 1
      i32.store
      i32.const 88
      local.get $d
      local.get $now
      i64.sub
      i64.store
      i32.const 96
      i64.const 1000
      i64.store
      i32.const 64
      i32.const 112
      i32.const 1
      i32.const 160
      call $poll_oneoff
      drop)

    ;; runs the program: main as the first task, then every task until
    ;; main ends
    (func $sched (local $m i32) (local $i i32) (local $t i32) (local $how i32) (local $progress i32) (local $d i64)
      i32.const 208
      i32.const ${task_free}
      call $obj_new
      local.tee $m
      global.set $mtask
      local.get $m
      i32.const -1
      i32.store offset=12
      local.get $m
      call $act_push
      loop $round
        call $timers
        i32.const 0
        local.set $progress
        i32.const 0
        local.set $i
        block $x
          loop $each
            local.get $i
            global.get $nact
            i32.ge_u
            br_if $x
            global.get $act
            local.get $i
            i32.const 2
            i32.shl
            i32.add
            i32.load
            local.set $t
            i32.const 0
            local.set $how
            local.get $t
            i32.load offset=8
            i32.eqz
            if
              i32.const 1
              local.set $how
            else
              local.get $t
              i32.load offset=120
              if
                local.get $t
                i32.load offset=116
                global.get $events
                i32.ne
                if
                  i32.const 2
                  local.set $how
                end
                local.get $t
                i64.load offset=128
                i64.eqz
                i32.eqz
                if
                  call $mono
                  local.get $t
                  i64.load offset=128
                  i64.ge_s
                  if
                    i32.const 2
                    local.set $how
                  end
                end
              end
            end
            local.get $how
            if
              i32.const 1
              local.set $progress
              local.get $t
              call $switch_in
              local.get $how
              i32.const 1
              i32.eq
              if
                local.get $t
                i32.const 1
                i32.store offset=8
                local.get $t
                local.get $m
                i32.eq
                if
                  call $main_entry
                else
                  ;; the entry function's own reference (run_claimed)
                  local.get $t
                  call $rc_inc
                  local.get $t
                  i32.load offset=16
                  local.get $t
                  local.get $t
                  i32.load offset=12
                  call_indirect (type ${runsig})
                end
              else
                local.get $t
                i32.const 0
                i32.store offset=120
                i32.const 2
                global.set $sstate
                local.get $t
                local.get $m
                i32.eq
                if
                  call $main_entry
                else
                  local.get $t
                  i32.load offset=16
                  local.get $t
                  local.get $t
                  i32.load offset=12
                  call_indirect (type ${runsig})
                end
              end
              global.get $sstate
              i32.const 1
              i32.eq
              if
                ;; it waits
                i32.const 0
                global.set $sstate
                local.get $t
                i32.const 1
                i32.store offset=120
                local.get $t
                call $switch_out
              else
                local.get $t
                local.get $m
                i32.eq
