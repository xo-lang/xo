      i32.shl
      i32.add
      local.tee $a
      i32.load offset=8
      local.set $l
      local.get $a
      i32.const 0
      i32.store offset=8
      local.get $l
      i32.const ${empty}
      local.get $l
      select)

    ;; ------------------------------------------------------------------
    ;; sleeping

    ;; 1 when canceled before or during the sleep (clock_wait)
    (func $clock_wait (param $d i64) (result i32)
      call $resumed
      if
        call $mono
        global.get $cur
        i64.load offset=128
        i64.ge_s
        if
          global.get $cur
          i64.const 0
          i64.store offset=128
          i32.const 0
          return
        end
        call $ctx_canceled
        if
          global.get $cur
          i64.const 0
          i64.store offset=128
          i32.const 1
          return
        end
        call $block
        i32.const 0
        return
      end
      call $ctx_canceled
      if
        i32.const 1
        return
      end
      local.get $d
      i64.const 0
      i64.le_s
      if
        i32.const 0
        return
      end
      global.get $cur
      call $mono
      local.get $d
      i64.add
      i64.store offset=128
      call $block
      i32.const 0)

    (func $clock_sleep (param $d i64)
      local.get $d
      call $clock_wait
      global.get $sstate
      i32.eqz
      i32.and
      if
        call $canceled
        drop
      end)

    ;; an Int, as the SSA builder types it (xo_clock_sleep_or_cancel)
    (func $clock_sleep_or_cancel (param $d i64) (result i64)
      local.get $d
      call $clock_wait
      i64.extend_i32_u)

    ;; ------------------------------------------------------------------
    ;; budgets (task.with_budget, decisions 0173 and 0175): a budget
    ;; {refs, parent, cpu, alloc, steps (i64s at 8, 16, 24), used cpu,
    ;; alloc, steps (32, 40, 48), over (56), node (60)}; the running
    ;; context's budget, its quantum, the steps left, and the marks of
    ;; its stretch are globals saved with the task

    (func $bud_mark
      call $mono
      global.set $budrun
      global.get $abytes
      global.set $budam)

    (func $bud_release (param $b i32) (local $p i32)
      block $x
        loop $l
          local.get $b
          i32.eqz
          br_if $x
          local.get $b
          local.get $b
          i32.load
          i32.const 1
          i32.sub
          i32.store
          local.get $b
          i32.load
          br_if $x
          local.get $b
          i32.load offset=4
          local.set $p
          local.get $b
          call $free
          local.get $p
          local.set $b
          br $l
        end
      end)

    (func $bud_retain (param $b i32)
      local.get $b
      if
        local.get $b
        local.get $b
        i32.load
        i32.const 1
        i32.add
        i32.store
      end)

    ;; records that resource r passed its ceiling: the budget's scope is
    ;; canceled
    (func $bud_pass (param $b i32) (param $r i32)
      local.get $b
      i32.load offset=56
      if
        return
      end
      local.get $b
      local.get $r
      i32.store offset=56
      local.get $b
      i32.load offset=60
      if
        local.get $b
        i32.load offset=60
        call $ncancel
      end)

    ;; charges the steps, running time, and allocation of the context's
    ;; stretch to its budgets; check: test the ceilings and refill the
    ;; quantum
    (func $bud_charge (param $check i32) (local $steps i64) (local $run i64) (local $al i64) (local $now i64) (local $q i64) (local $b i32) (local $left i64)
      global.get $budq
      global.get $budleft
      i64.sub
      local.set $steps
      call $mono
      local.tee $now
      global.get $budrun
      i64.sub
      local.set $run
      global.get $abytes
      global.get $budam
      i64.sub
      local.set $al
      local.get $now
      global.set $budrun
      global.get $abytes
      global.set $budam
      i64.const 1024
      local.set $q
      global.get $bud
      local.set $b
      block $x
        loop $l
          local.get $b
          i32.eqz
          br_if $x
          local.get $b
          local.get $b
          i64.load offset=48
          local.get $steps
          i64.add
          i64.store offset=48
          local.get $b
          local.get $b
          i64.load offset=32
          local.get $run
          i64.add
          i64.store offset=32
          local.get $b
          local.get $b
          i64.load offset=40
          local.get $al
          i64.add
          i64.store offset=40
          local.get $check
          if
            local.get $b
            i64.load offset=8
            i64.const 0
            i64.gt_s
            local.get $b
            i64.load offset=32
            local.get $b
            i64.load offset=8
            i64.gt_s
            i32.and
            if
              local.get $b
              i32.const 1
              call $bud_pass
            else
              local.get $b
              i64.load offset=24
              i64.const 0
              i64.gt_s
              local.get $b
              i64.load offset=48
              local.get $b
              i64.load offset=24
              i64.gt_s
              i32.and
              if
                local.get $b
                i32.const 3
                call $bud_pass
              else
                local.get $b
                i64.load offset=16
                i64.const 0
                i64.gt_s
                local.get $b
                i64.load offset=40
                local.get $b
                i64.load offset=16
                i64.gt_s
                i32.and
                if
                  local.get $b
                  i32.const 2
                  call $bud_pass
                end
              end
            end
            local.get $b
            i64.load offset=24
            i64.const 0
            i64.gt_s
            if
              local.get $b
              i64.load offset=24
              local.get $b
              i64.load offset=48
              i64.sub
              local.tee $left
              local.get $q
              i64.lt_s
              if
                local.get $left
                i64.const 1
                local.get $left
                i64.const 1
                i64.gt_s
                select
                local.set $q
              end
            end
          end
          local.get $b
          i32.load offset=4
          local.set $b
          br $l
        end
      end
      local.get $check
      if
        local.get $q
        global.set $budq
        local.get $q
        global.set $budleft
      else
        global.get $budleft
        global.set $budq
      end)

    ;; the budget poll of the program's code (xo_tick)
    (func $tick (local $b i32)
      global.get $budleft
      i64.const 1
      i64.sub
      global.set $budleft
      global.get $budleft
      i64.const 0
      i64.gt_s
      if
        return
      end
      global.get $bud
      i32.eqz
      if
        i64.const 0x4000000000000000
        global.set $budq
        i64.const 0x4000000000000000
        global.set $budleft
        return
      end
      i32.const 1
      call $bud_charge
      call $timers
      global.get $bud
      local.set $b
      block $x
        loop $l
          local.get $b
          i32.eqz
          br_if $x
          local.get $b
          i32.load offset=56
          if
            global.get $shield
            i32.eqz
            if
              i32.const 1
              global.set $unw
            end
            return
          end
          local.get $b
          i32.load offset=4
          local.set $b
          br $l
        end
      end
      ;; under a budget a pure loop is a cancellation point too
      call $canceled
      drop)

    (func $budget_open (param $s i32) (param $cpu i64) (param $al i64) (param $steps i64) (param $lo i32) (param $ln i32) (local $b i32)
      local.get $cpu
      i64.const 0
      i64.lt_s
      local.get $al
      i64.const 0
      i64.lt_s
      i32.or
      local.get $steps
      i64.const 0
      i64.lt_s
      i32.or
      if
        i32.const 0
        call $rs_new
        i32.const 0
        ${bneg}
        call $sapp
        local.get $cpu
        call $rs_append_duration
        ${balloc}
        call $sapp
        local.get $al
        call $sapp_int
        ${bsteps}
        call $sapp
        local.get $steps
        call $sapp_int
        i32.const 41
        call $sapp_byte
        local.get $lo
        i32.const 8
        i32.add
        local.get $ln
        call $fault_set
        return
      end
      global.get $bud
      if
        i32.const 0
        call $bud_charge
      end
      i32.const 64
      call $alloc
      local.tee $b
      i32.const 0
      i32.const 64
      memory.fill
      local.get $b
      i32.const 2
      i32.store
      local.get $b
      global.get $bud
      i32.store offset=4
      local.get $b
      local.get $cpu
      i64.store offset=8
      local.get $b
      local.get $al
      i64.store offset=16
      local.get $b
      local.get $steps
      i64.store offset=24
      local.get $b
      local.get $s
      i32.const 8
      i32.add
      i32.store offset=60
      local.get $s
      local.get $b
      i32.store offset=64
      local.get $b
      global.set $bud
      i64.const 1
      global.set $budq
      i64.const 1
      global.set $budleft
      call $bud_mark)

    ;; the resource whose ceiling was passed (1 cpu, 2 alloc, 3 steps),
    ;; the unwinding stopped, or 0
    (func $budget_end (param $s i32) (result i64) (local $b i32) (local $r i32)
      local.get $s
      i32.load offset=64
      local.set $b
      local.get $s
      i32.const 0
      i32.store offset=64
      global.get $bud
      local.get $b
      i32.eq
      if
        i32.const 0
        call $bud_charge
        local.get $b
        i32.load offset=4
        global.set $bud
        global.get $bud
        call $bud_retain
        local.get $b
        call $bud_release
        i64.const 1
        i64.const 0
        global.get $bud
        select
        global.set $budq
        global.get $budq
        global.set $budleft
        call $bud_mark
      end
      local.get $b
      i32.const 0
      i32.store offset=60
      local.get $b
      i32.load offset=56
      local.set $r
      local.get $b
      call $bud_release
      local.get $r
      i32.eqz
      global.get $faulting
      i32.or
      if
        i64.const 0
        return
      end
      call $ctx_canceled
      if
        i32.const 1
        global.set $unw
        i64.const 0
        return
      end
      i32.const 0
      global.set $unw
      local.get $r
      i64.extend_i32_u)

    ;; ------------------------------------------------------------------
    ;; Mutex and Atomic

    (func $mutex_new (param $l i32) (param $drop i64) (result i32) (local $m i32)
      i32.const 32
      i32.const ${mutex_free}
      call $obj_new
      local.tee $m
      local.get $l
      i32.store offset=20
      local.get $m
      local.get $drop
      i32.wrap_i64
      i32.store offset=24
      local.get $m)

    (func $mutex_free (param $m i32)
      local.get $m
      i32.load offset=20
      local.get $m
      i32.load offset=24
      call $list_release
      local.get $m
      call $free)

    ;; faults when the current task holds m (XO-F004), else records it
    (func $held_check (param $m i32) (param $read i32) (param $lo i32) (param $ln i32) (result i32) (local $h i32) (local $s i32) (local $n i32)
      global.get $cur
      i32.load offset=136
      local.set $h
      block $x
        loop $l
          local.get $h
          i32.eqz
          br_if $x
          local.get $h
          i32.load
          local.get $m
          i32.eq
          if
            i32.const 0
            call $rs_new
            i32.const 0
            ${reent}
            call $sapp
            i32.const ${w_read}
            i32.const ${w_with}
            local.get $read
            select
            i32.const 9
            i32.const 4
            local.get $read
            select
            call $sapp
            ${reent2}
            call $sapp
            local.get $h
            i32.load offset=4
            local.get $h
            i32.load offset=8
            call $sapp
            local.get $lo
            i32.const 8
            i32.add
            local.get $ln
            call $fault_set
            i32.const 1
            return
          end
          local.get $h
          i32.load offset=12
          local.set $h
          br $l
        end
      end
      i32.const 16
      call $alloc
      local.tee $h
      local.get $m
      i32.store
      local.get $h
      local.get $lo
      i32.const 8
      i32.add
      i32.store offset=4
      local.get $h
      local.get $ln
      i32.store offset=8
      local.get $h
      global.get $cur
      i32.load offset=136
      i32.store offset=12
      global.get $cur
      local.get $h
      i32.store offset=136
      i32.const 0)

    (func $held_del (param $m i32) (local $h i32) (local $p i32)
      global.get $cur
      i32.load offset=136
      local.set $h
      block $x
        loop $l
          local.get $h
          i32.eqz
          br_if $x
          local.get $h
          i32.load
          local.get $m
          i32.eq
          if
            local.get $p
            if
              local.get $p
              local.get $h
              i32.load offset=12
              i32.store offset=12
            else
              global.get $cur
              local.get $h
              i32.load offset=12
              i32.store offset=136
            end
            local.get $h
            call $free
            return
          end
          local.get $h
          local.set $p
          local.get $h
          i32.load offset=12
          local.set $h
          br $l
        end
      end)

    ;; m.with: takes m exclusively and moves its value out (a suspension
    ;; and cancellation point while it waits)
    (func $mutex_lock (param $m i32) (param $lo i32) (param $ln i32) (result i32) (local $l i32)
      call $resumed
      if
        call $ctx_canceled
        if
          local.get $m
          local.get $m
          i32.load offset=16
          i32.const 1
          i32.sub
          i32.store offset=16
          local.get $m
          call $held_del
          call $wake
          i32.const 1
          global.set $unw
          i32.const ${empty}
          return
        end
        local.get $m
        i32.load offset=8
        local.get $m
        i32.load offset=12
        i32.or
        if
          call $block
          i32.const 0
          return
        end
        local.get $m
        local.get $m
        i32.load offset=16
        i32.const 1
        i32.sub
        i32.store offset=16
      else
        local.get $m
        i32.const 0
        local.get $lo
        local.get $ln
        call $held_check
        if
          i32.const ${empty}
          return
        end
        local.get $m
        i32.load offset=8
        local.get $m
        i32.load offset=12
        i32.or
        if
          local.get $m
          local.get $m
          i32.load offset=16
          i32.const 1
          i32.add
          i32.store offset=16
          call $block
          i32.const 0
          return
        end
      end
      local.get $m
      i32.const 1
      i32.store offset=8
      local.get $m
      i32.load offset=20
      local.set $l
      local.get $m
      i32.const 0
      i32.store offset=20
      local.get $l)

    (func $mutex_unlock (param $m i32) (param $l i32)
      local.get $m
      local.get $l
      i32.store offset=20
      local.get $m
      i32.const 0
      i32.store offset=8
      local.get $m
      call $held_del
      call $wake)

    ;; m.with_read: takes m shared and returns a reference to its value
    (func $mutex_rlock (param $m i32) (param $lo i32) (param $ln i32) (result i32)
      call $resumed
      if
        call $ctx_canceled
        if
          local.get $m
          call $held_del
          i32.const 1
          global.set $unw
          i32.const ${empty}
          return
        end
      else
        local.get $m
        i32.const 1
        local.get $lo
        local.get $ln
        call $held_check
        if
          i32.const ${empty}
          return
        end
      end
      local.get $m
      i32.load offset=8
      local.get $m
      i32.load offset=16
      i32.or
      if
        call $block
        i32.const 0
        return
      end
      local.get $m
      local.get $m
      i32.load offset=12
      i32.const 1
      i32.add
      i32.store offset=12
      local.get $m
      i32.load offset=20
      call $rc_inc
      local.get $m
      i32.load offset=20)

    (func $mutex_runlock (param $m i32) (param $l i32)
      local.get $l
      call $rc_dec
      if
        local.get $l
        local.get $m
        i32.load offset=24
        call $list_release
      end
      local.get $m
      local.get $m
      i32.load offset=12
      i32.const 1
      i32.sub
      i32.store offset=12
      local.get $m
      call $held_del
      call $wake)

    (func $atomic_new (param $v i64) (result i32) (local $a i32)
      i32.const 16
      i32.const ${plain_free}
      call $obj_new
      local.tee $a
      local.get $v
      i64.store offset=8
      local.get $a)

    (func $atomic_get (param $a i32) (result i64)
      call $yield_point
      if
        i64.const 0
        return
      end
      local.get $a
      i64.load offset=8)

    (func $atomic_set (param $a i32) (param $v i64)
      call $yield_point
      if
        return
      end
      local.get $a
      local.get $v
      i64.store offset=8)

    (func $atomic_swap (param $a i32) (param $v i64) (result i64) (local $o i64)
      call $yield_point
      if
        i64.const 0
        return
      end
      local.get $a
      i64.load offset=8
      local.set $o
      local.get $a
      local.get $v
      i64.store offset=8
      local.get $o)

    (func $atomic_cas (param $a i32) (param $old i64) (param $v i64) (result i32)
      call $yield_point
      if
        i32.const 0
        return
      end
      local.get $a
      i64.load offset=8
      local.get $old
      i64.ne
      if
        i32.const 0
        return
      end
      local.get $a
      local.get $v
      i64.store offset=8
      i32.const 1)

    (func $atomic_add (param $a i32) (param $n i64) (param $lo i32) (param $ln i32) (result i64) (local $o i64) (local $r i64)
      call $yield_point
      if
        i64.const 0
        return
      end
      local.get $a
      i64.load offset=8
      local.tee $o
      local.get $n
      i64.add
      local.set $r
      local.get $o
      local.get $r
      i64.xor
      local.get $n
      local.get $r
      i64.xor
      i64.and
      i64.const 0
      i64.lt_s
      if
        i32.const 0
        call $rs_new
        i32.const 0
        ${ovf}
        call $sapp
        local.get $o
        call $sapp_int
        ${plus}
        call $sapp
        local.get $n
        call $sapp_int
        ${dnf}
        call $sapp
        local.get $lo
        i32.const 8
        i32.add
        local.get $ln
        call $fault_set
        i64.const 0
        return
      end
      local.get $a
      local.get $r
      i64.store offset=8
      local.get $r)

    (func $atomic_max (param $a i32) (param $n i64) (result i64)
      call $yield_point
      if
        i64.const 0
        return
      end
      local.get $a
      i64.load offset=8
      local.get $n
      i64.lt_s
      if
        local.get $a
        local.get $n
        i64.store offset=8
      end
      local.get $a
      i64.load offset=8)
  """
}
