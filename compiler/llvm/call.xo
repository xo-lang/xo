    "rt.aes_enc10x4" | "rt.aes_enc12x4" | "rt.aes_enc14x4" => {
      // four blocks (arm64 only, ssa call.xo): the rounds of each, the
      // four states SSA values the backend interleaves
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_enc").trim_suffix("x4")) ?? 10
      let p = g.raw_ptr(x.args[0])
      let kp = g.raw_ptr(x.args[1])
      var ks: List[Str] = []
      for r in 0..nr + 1 {
        let q = g.def("getelementptr i8, ptr ${kp}, i64 ${16 * r}")
        ks.push(g.def("load <16 x i8>, ptr ${q}, align 1"))
      }
      var ps: List[Str] = []
      var ss: List[Str] = []
      for b in 0..4 {
        let q = g.def("getelementptr i8, ptr ${p}, i64 ${16 * b}")
        ps.push(q)
        ss.push(g.def("load <16 x i8>, ptr ${q}, align 1"))
      }
      for r in 0..nr - 1 {
        for b in 0..4 {
          ss[b] = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\\0Aaesmc $0.16b, $0.16b\", \"=w,0,w\"(<16 x i8> ${ss[b]}, <16 x i8> ${ks[r]})")
        }
      }
      for b in 0..4 {
        let s = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\", \"=w,0,w\"(<16 x i8> ${ss[b]}, <16 x i8> ${ks[nr - 1]})")
        let e = g.def("xor <16 x i8> ${s}, ${ks[nr]}")
        g.emit("store <16 x i8> ${e}, ptr ${ps[b]}, align 1")
      }
