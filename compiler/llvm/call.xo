    "rt.chacha_stream4" if g.arch() == "amd64" => {
      // ssa.chacha4_x86_lines' loop as inline asm (AT&T: its immediates'
      // `$` doubled), its registers clobbered
      var t: List[Str] = []
      for l in ssa.chacha4_x86_lines("@0@", "@1@", "@2@", "@3@") {
        t.push(l.replace("$", "$$").replace("@0@", "$0").replace("@1@", "$1").replace("@2@", "$2").replace("@3@", "$3"))
      }
      var clob = "r,r,r,r"
      for r in ssa.chacha4_x86_gprs() {
        clob = clob + ",~{${r}}"
      }
      for r in ssa.chacha4_x86_xmms() {
        clob = clob + ",~{xmm${r}}"
      }
      clob = clob + ",~{memory},~{dirflag},~{fpsr},~{flags}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, i64 ${g.op(x.args[3])})")
    }
    "rt.chacha_stream4" => {
      // arm64 only (ssa call.xo): ssa.chacha4_neon_lines' loop as inline
      // asm, x9 to x11 and its V registers clobbered
      var t: List[Str] = []
      for l in ssa.chacha4_neon_lines("$0", "$1", "$2", "$3", "x9", "x10", "x11") {
        t.push(l)
      }
      var clob = "r,r,r,r,~{x9},~{x10},~{x11}"
      for r in ssa.chacha4_neon_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{cc}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, i64 ${g.op(x.args[3])})")
    }
    "rt.ghash_blocks" => {
      // arm64 only (ssa call.xo): ssa.ghash_loop_lines as inline asm, x9,
      // x10 and its V registers clobbered
      var t = [".arch_extension crypto"]
      for l in ssa.ghash_loop_lines("$0", "$1", "$2", "$3", "x9", "x10") {
        t.push(l)
      }
      var clob = "r,r,r,r,~{x9},~{x10}"
      for r in ssa.ghash_loop_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{cc}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, i64 ${g.op(x.args[3])})")
    }
    "rt.aes_round" | "rt.aes_last" => {
      let last = aux_str(x.aux) == "rt.aes_last"
      let p = g.raw_ptr(x.args[0])
      let s = g.def("load <16 x i8>, ptr ${p}, align 1")
      let k = g.def("load <16 x i8>, ptr ${g.raw_ptr(x.args[1])}, align 1")
      var r = ""
      if g.arch() == "amd64" {
        // AESENC's key is after the round: the key xored before, a zero
        // key after (AESENCLAST: the next key)
        let sk = g.def("xor <16 x i8> ${s}, ${k}")
        if last {
          let k2 = g.def("load <16 x i8>, ptr ${g.raw_ptr(x.args[2])}, align 1")
          r = g.def("call <16 x i8> asm \"aesenclast $2, $0\", \"=x,0,x\"(<16 x i8> ${sk}, <16 x i8> ${k2})")
        } else {
          r = g.def("call <16 x i8> asm \"aesenc $2, $0\", \"=x,0,x\"(<16 x i8> ${sk}, <16 x i8> zeroinitializer)")
        }
      } else if last {
        let e = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\", \"=w,0,w\"(<16 x i8> ${s}, <16 x i8> ${k})")
        let k2 = g.def("load <16 x i8>, ptr ${g.raw_ptr(x.args[2])}, align 1")
        r = g.def("xor <16 x i8> ${e}, ${k2}")
      } else {
        r = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\\0Aaesmc $0.16b, $0.16b\", \"=w,0,w\"(<16 x i8> ${s}, <16 x i8> ${k})")
      }
