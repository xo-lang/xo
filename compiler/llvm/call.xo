    }
    "rt.mlkem_mul_acc" if g.arch() == "amd64" => {
      // amd64 only, as rt.mlkem_ntt
      var t: List[Str] = []
      for l in ssa.mlkem_mul_acc_sse2_lines("@0@", "@1@", "@2@", "@3@") {
        t.push(l.replace("$", "$$").replace("@0@", "$0").replace("@1@", "$1").replace("@2@", "$2").replace("@3@", "$3"))
      }
      var clob = "r,r,r,r"
      for r in ssa.mlkem_ntt_sse2_gprs() {
        clob = clob + ",~{${r}}"
      }
      for r in [0, 1, 2, 3, 4, 5, 14, 15] {
        clob = clob + ",~{xmm${r}}"
      }
      clob = clob + ",~{memory},~{dirflag},~{fpsr},~{flags}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, ptr ${g.raw_ptr(x.args[3])})")
    }
    "rt.mlkem_ntt" | "rt.mlkem_inverse_ntt" | "rt.mlkem_mul_acc" if g.arch() == "arm64" => {
      // ssa a64mlkem.xo's lines as inline asm, its registers clobbered
      let name = aux_str(x.aux)
      let ls = if name == "rt.mlkem_ntt" { ssa.mlkem_ntt_neon_lines("$0", "$1") } else if name == "rt.mlkem_inverse_ntt" { ssa.mlkem_inverse_ntt_neon_lines("$0", "$1") } else { ssa.mlkem_mul_acc_neon_lines("$0", "$1", "$2", "$3") }
      var ops: List[Str] = []
      var clob = ""
      for a in x.args {
        ops.push("ptr ${g.raw_ptr(a)}")
        clob = clob + (if clob.is_empty() { "r" } else { ",r" })
      }
      for r in ssa.mlkem_neon_gprs() {
        clob = clob + ",~{x${r}}"
      }
      for r in ssa.mlkem_neon_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{nzcv}"
      g.emit("call void asm sideeffect \"${ls.join("\\0A")}\", \"${clob}\"(${ops.join(", ")})")
    }
    "rt.mlkem_ntt" | "rt.mlkem_inverse_ntt" => {
      // amd64 only (ssa cpu_call): ssa.mlkem_ntt_sse2_lines as inline asm
      var t: List[Str] = []
      let ls = if aux_str(x.aux) == "rt.mlkem_ntt" { ssa.mlkem_ntt_sse2_lines("@0@", "@1@") } else { ssa.mlkem_inverse_ntt_sse2_lines("@0@", "@1@") }
      for l in ls {
        t.push(l.replace("$", "$$").replace("@0@", "$0").replace("@1@", "$1"))
      }
      var clob = "r,r"
      for r in ssa.mlkem_ntt_sse2_gprs() + ["r11"] {
        clob = clob + ",~{${r}}"
      }
      for r in [0, 1, 2, 3, 4, 5, 14, 15] {
        clob = clob + ",~{xmm${r}}"
      }
      clob = clob + ",~{memory},~{dirflag},~{fpsr},~{flags}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])})")
    }
    "rt.sha256_block" => {
      // arm64: the state as two <4 x i32> SSA values (abcd, efgh) through
      // the sixteen four round steps of SHA256H and SHA256H2, the
      // schedule by SHA256SU0 and SHA256SU1; x86-64: SHA-NI (decision
      // 0254, cpu.hw()'s HW_SHA256 from CPUID leaf 7), the sequence of
      // ssa.sha256_ni_lines as inline asm, its xmm registers clobbered
      if g.arch() == "amd64" {
        var t: List[Str] = []
        for l in ssa.sha256_ni_lines("@0@", "@1@", "@2@") {
          t.push(l.replace("$", "$$").replace("@0@", "$0").replace("@1@", "$1").replace("@2@", "$2"))
        }
        var clob = "r,r,r"
        for r in 0..11 {
          clob = clob + ",~{xmm${r}}"
        }
        clob = clob + ",~{r11},~{memory},~{dirflag},~{fpsr},~{flags}"
        let sp = g.raw_ptr(x.args[0])
        let bp = g.raw_ptr(x.args[1])
        let kp = g.raw_ptr(x.args[2])
        g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${sp}, ptr ${bp}, ptr ${kp})")
      } else {
        let sp = g.raw_ptr(x.args[0])
        let bp = g.raw_ptr(x.args[1])
        let kp = g.raw_ptr(x.args[2])
        let w8 = g.def("load <8 x i64>, ptr ${sp}, align 8")
        let s8 = g.def("trunc <8 x i64> ${w8} to <8 x i32>")
        let a0 = g.def("shufflevector <8 x i32> ${s8}, <8 x i32> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 3>")
        let e0 = g.def("shufflevector <8 x i32> ${s8}, <8 x i32> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>")
        var ms: List[Str] = []
        for i in 0..4 {
          let q = g.def("getelementptr i8, ptr ${bp}, i64 ${16 * i}")
          let b = g.def("load <16 x i8>, ptr ${q}, align 1")
          let r = g.def("shufflevector <16 x i8> ${b}, <16 x i8> poison, <16 x i32> <i32 3, i32 2, i32 1, i32 0, i32 7, i32 6, i32 5, i32 4, i32 11, i32 10, i32 9, i32 8, i32 15, i32 14, i32 13, i32 12>")
          ms.push(g.def("bitcast <16 x i8> ${r} to <4 x i32>"))
        }
        let ext = ".arch_extension sha2\\0A"
        var a = a0
        var e = e0
        for i in 0..16 {
          let q = g.def("getelementptr i8, ptr ${kp}, i64 ${16 * i}")
          let k = g.def("load <4 x i32>, ptr ${q}, align 1")
          let wk = g.def("add <4 x i32> ${ms[i % 4]}, ${k}")
          if i < 12 {
            ms[i % 4] = g.def("call <4 x i32> asm \"${ext}sha256su0 $0.4s, $2.4s\", \"=w,0,w\"(<4 x i32> ${ms[i % 4]}, <4 x i32> ${ms[(i + 1) % 4]})")
          }
          let a1 = g.def("call <4 x i32> asm \"${ext}sha256h \${0:q}, \${2:q}, $3.4s\", \"=w,0,w,w\"(<4 x i32> ${a}, <4 x i32> ${e}, <4 x i32> ${wk})")
          e = g.def("call <4 x i32> asm \"${ext}sha256h2 \${0:q}, \${2:q}, $3.4s\", \"=w,0,w,w\"(<4 x i32> ${e}, <4 x i32> ${a}, <4 x i32> ${wk})")
          a = a1
          if i < 12 {
            ms[i % 4] = g.def("call <4 x i32> asm \"${ext}sha256su1 $0.4s, $2.4s, $3.4s\", \"=w,0,w,w\"(<4 x i32> ${ms[i % 4]}, <4 x i32> ${ms[(i + 2) % 4]}, <4 x i32> ${ms[(i + 3) % 4]})")
          }
        }
        let a2 = g.def("add <4 x i32> ${a}, ${a0}")
        let e2 = g.def("add <4 x i32> ${e}, ${e0}")
        let o8 = g.def("shufflevector <4 x i32> ${a2}, <4 x i32> ${e2}, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>")
        let z8 = g.def("zext <8 x i32> ${o8} to <8 x i64>")
        g.emit("store <8 x i64> ${z8}, ptr ${sp}, align 8")
      }
    }
    "rt.cpuid7_ebx" => {
      if g.arch() == "amd64" {
        let r = g.def("call { i32, i32, i32, i32 } asm \"cpuid\", \"={ax},={bx},={cx},={dx},0,2\"(i32 7, i32 0)")
        g.set(v, "zext i32 ${g.def("extractvalue { i32, i32, i32, i32 } ${r}, 1")} to i64")
      } else {
        g.set(v, "add i64 0, 0")
      }
    }
    "rt.xgetbv0" => {
      if g.arch() == "amd64" {
        let r = g.def("call { i32, i32 } asm \"xgetbv\", \"={ax},={dx},{cx}\"(i32 0)")
        g.set(v, "zext i32 ${g.def("extractvalue { i32, i32 } ${r}, 0")} to i64")
      } else {
        g.set(v, "add i64 0, 0")
      }
    }
    // decision 0385 stage 3: amd64 only (compiler/ssa), behind HW_FMA; an
    // asm call, since llvm.fma without +fma would call libm's fma
    "rt.fma_hw" => {
      let a0 = g.op(x.args[0])
      let a1 = g.op(x.args[1])
      let a2 = g.op(x.args[2])
      g.set(v, "call double asm \"vfmadd231sd $2, $1, $0\", \"=x,x,x,0\"(double ${a0}, double ${a1}, double ${a2})")
    }
    "rt.cpuid1_ecx" => {
      if g.arch() == "amd64" {
        let r = g.def("call { i32, i32, i32, i32 } asm \"cpuid\", \"={ax},={bx},={cx},={dx},0,2\"(i32 1, i32 0)")
        g.set(v, "zext i32 ${g.def("extractvalue { i32, i32, i32, i32 } ${r}, 2")} to i64")
      } else {
        g.set(v, "add i64 0, 0")
      }
    }
    // decision 0195: the conversions of UInt64 and Float32
    "rt.u64_to_float" => g.set(v, "uitofp i64 ${g.op(x.args[0])} to double")
    "rt.f32_round" => g.set(v, "fpext float ${g.def("fptrunc double ${g.op(x.args[0])} to float")} to double")
    "rt.i64_to_f32" => g.set(v, "fpext float ${g.def("sitofp i64 ${g.op(x.args[0])} to float")} to double")
    "rt.u64_to_f32" => g.set(v, "fpext float ${g.def("uitofp i64 ${g.op(x.args[0])} to float")} to double")
    "rt.float_bits" => g.set(v, "bitcast double ${g.op(x.args[0])} to i64")
    "rt.float_from_bits" => g.set(v, "bitcast i64 ${g.op(x.args[0])} to double")
    "rt.bytes_word" => {
      let (_, d, _) = g.str_parts(g.op(x.args[0]))
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      g.set(v, "load i64, ptr ${p}, align 1${g.sc_md(v)}")
    }
    "rt.sys6" => {
      // a Linux system call (decision 0206): inline asm with the number
      // and six arguments in the registers of the target's convention
      var ops: List[Str] = []
      for a in x.args {
        ops.push("i64 ${g.op(a)}")
      }
      let cons = if g.arch() == "amd64" {
        "\"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\""
      } else {
        "\"svc #0\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}\""
      }
      g.set(v, "call i64 asm sideeffect ${cons}(${ops.join(", ")})")
    }
    "rt.sys_restorer" => {
      g.sigreturn()
      g.set(v, "ptrtoint ptr @xo_sigreturn to i64")
    }
    "rt.call_c2" => {
      // a C ABI call of an address (decision 0206 stage 2)
      let p = g.def("inttoptr i64 ${g.op(x.args[0])} to ptr")
      g.set(v, "call i64 ${p}(i64 ${g.op(x.args[1])}, i64 ${g.op(x.args[2])})")
    }
    "rt.call_c4" => {
      let p = g.def("inttoptr i64 ${g.op(x.args[0])} to ptr")
      g.set(v, "call i64 ${p}(i64 ${g.op(x.args[1])}, i64 ${g.op(x.args[2])}, i64 ${g.op(x.args[3])}, i64 ${g.op(x.args[4])})")
    }
    "rt.sys_words" => {
      // 16 words of process state (decision 0206 stage 2): weak, one
      // object for every module of a split build
      if !g.emitted.contains("@.xo.sys_words") {
        g.emitted["@.xo.sys_words"] = true
        g.helpers.push("${g.comdat_decl("@.xo.sys_words")}@.xo.sys_words = weak global [16 x i64] zeroinitializer${g.comdat()}, align 8\n\n")
      }
      g.set(v, "ptrtoint ptr @.xo.sys_words to i64")
    }
    "rt.static_word" => {
