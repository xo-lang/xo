      // B02; 64 until decision 0237): weak, one object for every module
      // of a split build
      if !g.emitted.contains("@.xo.static") {
        g.emitted["@.xo.static"] = true
        let dbg = if g.dbg_static >= 0 { ", !dbg !${g.dbg_static}" } else { "" }
        // with asynchronous preemption word 77 holds the unsafe range
        // tables (decision 0318 stage 4), alike in every module
        let tables = if g.apre.is_empty() { "" } else { g.apre_tables() }
        g.helpers.push("${tables}${g.comdat_decl("@.xo.static")}@.xo.static = weak global [256 x i64] ${g.apre_static_init()}${g.comdat()}, align 8${dbg}\n\n")
      }
      let p = g.def("getelementptr [256 x i64], ptr @.xo.static, i64 0, i64 ${g.op(x.args[0])}")
      g.set(v, "ptrtoint ptr ${p} to i64")
    }
    "rt.sys_clone" => {
      g.clone_tramp()
      var ops: List[Str] = []
      for a in x.args {
        ops.push("i64 ${g.op(a)}")
      }
      g.set(v, "call i64 @xo_clone(${ops.join(", ")})")
    }
    // decision 0212 (sched.xo): calls of the switch and the thread
    // locals, defined at the first use
    "rt.stack_switch" => {
      g.sched_switch()
      return false
    }
    "rt.unwind_save" | "rt.unwind_resume" => {
      // calls of the unwinder's trampolines (decision 0221)
      g.unwind_fns()
      return false
    }
    "rt.fiber_start_addr" => {
      g.sched_switch()
      g.set(v, "ptrtoint ptr @xo_fiber_entry to i64")
    }
    "rt.frame_addr" => {
      // decision 0233: the function's frame record (its attributes #9
      // keep the frame pointer and forbid inlining)
      g.frame_attrs()
      let p = g.def("call ptr @llvm.frameaddress.p0(i32 0)")
      g.set(v, "ptrtoint ptr ${p} to i64")
    }
    "rt.tlocal_get" | "rt.tlocal_set" | "rt.tlocal_addr" => {
      g.sched_tlocal()
      return false
    }
    // the immortal placeholders: their addresses, no call (the program
    // defines them)
    "rt.rl_empty" => g.alias(v, g.empty_list())
    "rt.h_zero" => g.alias(v, g.zero_handle())
    "rt.popcount" => g.set(v, "call i64 @llvm.ctpop.i64(i64 ${g.op(x.args[0])})")
    "rt.ctz" => g.set(v, "call i64 @llvm.cttz.i64(i64 ${g.op(x.args[0])}, i1 false)")
    "rt.clz" => g.set(v, "call i64 @llvm.ctlz.i64(i64 ${g.op(x.args[0])}, i1 false)")
    "rt.bytes_eq16_bits" | "rt.bytes_high16_bits" => {
      // one bit a byte (pmovmskb on x86_64)
      let (_, d, _) = g.str_parts(g.op(x.args[0]))
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      let w = g.def("load <16 x i8>, ptr ${p}, align 1${g.sc_md(v)}")
      var e = ""
      if aux_str(x.aux) == "rt.bytes_eq16_bits" {
        let c = g.def("trunc i64 ${g.op(x.args[2])} to i8")
        var r = g.def("insertelement <16 x i8> poison, i8 ${c}, i64 0")
        r = g.def("shufflevector <16 x i8> ${r}, <16 x i8> poison, <16 x i32> zeroinitializer")
        e = g.def("icmp eq <16 x i8> ${w}, ${r}")
      } else {
        e = g.def("icmp slt <16 x i8> ${w}, zeroinitializer")
      }
      let m = g.def("bitcast <16 x i1> ${e} to i16")
      g.set(v, "zext i16 ${m} to i64")
    }
    "rt.case_fold16" => {
      // decision 0373's intrinsic as a <16 x i8> sequence: the lane's own
      // arithmetic, not the eight byte SWAR words std writes for a backend
      // without a lane. Written as the words first, step 2's std loop cost
      // LLVM 1.7 percent more instructions on the ASCII rows, because
      // clang no longer widened them itself once the loop stepped 16 bytes
      // (bench/results/case-fold16-2026-10-25.md)
      let mode = match g.f.values[x.args[3]].aux {
        I(n) => n
        _ => 1
      }
      let lower = mode != 2
      // the dst and src operands are raw addresses (Ints), so each needs
      // the inttoptr that raw_at gives before a getelementptr: an i64
      // operand where clang wants a ptr is what it refused
      // ("%v0 defined with type 'i64' but expected 'ptr'", 2026-10-25)
      let dp = g.raw_at(x.args[0], x.args[2])
      let sp = g.raw_at(x.args[1], x.args[2])
      let c = g.def("load <16 x i8>, ptr ${sp}, align 1")
      // d = c - first, wrapping, so the case is the unsigned range 0 to 25
      // for exactly the letters, and no byte at 0x80 or above lands in it
      // (the property ADR 0373 rests on)
      let d = g.def("sub <16 x i8> ${c}, ${g.splat8(if lower { 65 } else { 97 })}")
      // d is in 0 to 25 for a letter (0 to 25 inclusive, so `ule 25`: `ule
      // 26` let '[' (d = 26) lower to '{' and '{' raise to '[', which the
      // corpus's runs of 16, 17, 64 and 65 bytes caught; arm64's cmhs is
      // `d <= 25` and wasm's `lt_u 26` is the same)
      let m = g.def("icmp ule <16 x i8> ${d}, ${g.splat8(25)}")
      let delta = g.def("select <16 x i1> ${m}, <16 x i8> ${g.splat8(32)}, <16 x i8> zeroinitializer")
      let r = if lower { g.def("add <16 x i8> ${c}, ${delta}") } else { g.def("sub <16 x i8> ${c}, ${delta}") }
      g.emit("store <16 x i8> ${r}, ptr ${dp}, align 1")
    }
    "rt.list_swap" => {
      // decision 0374: the two elements trade places with no count and no
      // release (a permutation leaves each element referenced as often),
      // both loaded before either is stored so i == j writes back what it
      // read; the call's type is Unit, so nothing is set
      let md = g.sc_md(v)
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      let l = g.op(x.args[0])
      if !x.pos.is_empty() {
        let n = g.list_len(l, md)
        for k in 1..3 {
          let ak = g.op(x.args[k])
          let bad = g.def("icmp uge i64 ${ak}, ${n}")
          let bk = g.op(x.args[k])
          let lc = g.loc(v)
          g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${bk}, i64 ${n}, ${lc})")
        }
      }
      if g.kind(et) != ssa.Kind.Unit {
        let pa = g.elem_ptr(et, l, g.op(x.args[1]))
        let pb = g.elem_ptr(et, l, g.op(x.args[2]))
        // the elements as registers, so a packed element (decision 0369)
        // is loaded at its width and widened, stored back narrowed: a raw
        // i64 access would overwrite a packed element's neighbours
        let va = g.elem_load(et, pa, md)
        let vb = g.elem_load(et, pb, md)
        g.elem_store(et, vb, pa, md)
        g.elem_store(et, va, pb, md)
      }
    }
    "rt.list_swap2" => {
      // decision 0374 step 3: one element of each list trade places with
      // no count and no release (the two lists permute their elements
      // between them, so each element stays referenced once), both loaded
      // before either is stored so a == b with i == j writes back what it
      // read; the call's type is Unit, so nothing is set
      let md = g.sc_md(v)
      let et = g.m.types[g.vty(x.args[0])].elems[0]
      let l1 = g.op(x.args[0])
      let l2 = g.op(x.args[2])
      if !x.pos.is_empty() {
        let n1 = g.list_len(l1, md)
        let a1 = g.op(x.args[1])
        let bad1 = g.def("icmp uge i64 ${a1}, ${n1}")
        let b1 = g.op(x.args[1])
        let lc1 = g.loc(v)
        g.fault_if(bad1, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n1}, ${lc1})")
        let n2 = g.list_len(l2, md)
        let a2 = g.op(x.args[3])
        let bad2 = g.def("icmp uge i64 ${a2}, ${n2}")
        let b2 = g.op(x.args[3])
        let lc2 = g.loc(v)
        g.fault_if(bad2, "@xo_x_fault_raise_index(i64 ${b2}, i64 ${n2}, ${lc2})")
      }
      if g.kind(et) != ssa.Kind.Unit {
        let pa = g.elem_ptr(et, l1, g.op(x.args[1]))
        let pb = g.elem_ptr(et, l2, g.op(x.args[3]))
        // as list_swap's: a packed element (decision 0369) is loaded at
        // its width and widened, stored back narrowed
        let va = g.elem_load(et, pa, md)
        let vb = g.elem_load(et, pb, md)
        g.elem_store(et, vb, pa, md)
        g.elem_store(et, va, pb, md)
      }
    }
    "rt.bytes_eq16" | "rt.bytes_high16" => {
      let (_, d, _) = g.str_parts(g.op(x.args[0]))
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      let w = g.def("load <16 x i8>, ptr ${p}, align 1${g.sc_md(v)}")
      var e = ""
      if aux_str(x.aux) == "rt.bytes_eq16" {
        let c = g.def("trunc i64 ${g.op(x.args[2])} to i8")
        var r = g.def("insertelement <16 x i8> poison, i8 ${c}, i64 0")
        r = g.def("shufflevector <16 x i8> ${r}, <16 x i8> poison, <16 x i32> zeroinitializer")
        e = g.def("icmp eq <16 x i8> ${w}, ${r}")
      } else {
        e = g.def("icmp slt <16 x i8> ${w}, zeroinitializer")
      }
      let m = g.def("sext <16 x i1> ${e} to <16 x i8>")
      var h = g.def("bitcast <16 x i8> ${m} to <8 x i16>")
      h = g.def("lshr <8 x i16> ${h}, <i16 4, i16 4, i16 4, i16 4, i16 4, i16 4, i16 4, i16 4>")
      let n = g.def("trunc <8 x i16> ${h} to <8 x i8>")
      g.set(v, "bitcast <8 x i8> ${n} to i64")
    }
    "rt.rs_put_word" => {
      let x0 = g.op(x.args[0])
      let (_, d, _) = g.str_parts(x0)
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      g.emit("store i64 ${g.op(x.args[2])}, ptr ${p}, align 1")
      g.alias(v, x0)
    }
    "rt.rs_set_len" => {
      let obj = g.def("extractvalue %xo.str ${g.op(x.args[0])}, 0")
      g.mk_str(v, obj, g.op(x.args[1]))
    }
    "rt.slot_load" | "rt.slot_store" | "rt.slot_swap" | "rt.slot_cas" | "rt.slot_add" | "rt.slot_addr" | "rt.fence" | "rt.spin_hint" | "rt.preempt_poll" => g.atomic(v)
    _ => return g.inline_raw(v)
  }
  true
}

/// The pointer of the address operand a (inlineRaw's ptr).
fn (var g: Gen) raw_ptr(a: Int) -> Str { g.def("inttoptr i64 ${g.op(a)} to ptr") }

/// The pointer of address a plus off (inlineRaw's at).
fn (var g: Gen) raw_at(a: Int, off: Int) -> Str {
  let p = g.raw_ptr(a)
  g.def("getelementptr i8, ptr ${p}, i64 ${g.op(off)}")
}

/// Lowers the raw memory intrinsics (decision 0207, fromssa.go
/// inlineRaw): loads and stores of a constant width at an address,
/// llvm.memcpy, llvm.memmove, llvm.memset, the platform's memcmp, a
/// string with its length set, and an object's address both ways;
/// whether v was one.
fn (var g: Gen) inline_raw(v: Int) -> Bool {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  match name {
    "rt.mem_load" => {
      let w = match g.f.values[x.args[2]].aux {
        I(n) => n
        _ => 8
      }
      let p = g.raw_at(x.args[0], x.args[1])
      if w == 8 && g.kind(x.ty) is ssa.Kind.List | ssa.Kind.Handle {
        // a word read as a list (ssa show.xo const_read)
        g.set(v, "load ptr, ptr ${p}, align 8")
      } else if w == 8 {
        g.set(v, "load i64, ptr ${p}, align 1")
      } else {
        let it = "i${8 * w}"
        g.set(v, "zext ${it} ${g.def("load ${it}, ptr ${p}, align 1")} to i64")
      }
    }
    "rt.mem_store" => {
      let w = match g.f.values[x.args[3]].aux {
        I(n) => n
        _ => 8
      }
      let p = g.raw_at(x.args[0], x.args[1])
      let y = g.op(x.args[2])
      if w == 8 {
        g.emit("store i64 ${y}, ptr ${p}, align 1")
      } else {
        let it = "i${8 * w}"
        g.emit("store ${it} ${g.def("trunc i64 ${y} to ${it}")}, ptr ${p}, align 1")
      }
    }
    "rt.mem_copy" | "rt.mem_move" => {
      let f = if name == "rt.mem_move" { "@llvm.memmove.p0.p0.i64" } else { "@llvm.memcpy.p0.p0.i64" }
      g.llvm_decl(f, "declare void ${f}(ptr, ptr, i64, i1)")
      let d = g.raw_ptr(x.args[0])
      let s = g.raw_ptr(x.args[1])
      g.emit("call void ${f}(ptr ${d}, ptr ${s}, i64 ${g.op(x.args[2])}, i1 false)")
    }
    "rt.mem_copy_block" => {
      // the loop libcstr.copy_words had (two words loaded, then stored,
      // twice per 32 bytes), which LLVM vectorizes; llvm.memcpy would call
      // memcpy, this function's caller
      let d = g.raw_ptr(x.args[0])
      let s = g.raw_ptr(x.args[1])
      let n = g.op(x.args[2])
      let pre = g.label
      let head = g.new_label("cbh")
      let body = g.new_label("cbb")
      let done = g.new_label("cbd")
      g.emit("br label %${head}")
      g.start(head)
      g.emit("%${head}.i = phi i64 [ 0, %${pre} ], [ %${body}.n, %${body} ]")
      g.emit("%${head}.c = icmp ult i64 %${head}.i, ${n}")
      g.emit("br i1 %${head}.c, label %${body}, label %${done}")
      g.start(body)
      var vs: List[Str] = []
      for k in 0..4 {
        let o = if k == 0 { "%${head}.i" } else { g.def("add i64 %${head}.i, ${8 * k}") }
        let ps = g.def("getelementptr i8, ptr ${s}, i64 ${o}")
        vs.push(g.def("load i64, ptr ${ps}, align 1"))
        if k % 2 == 1 {
          for j in [k - 1, k] {
            let oj = if j == 0 { "%${head}.i" } else { g.def("add i64 %${head}.i, ${8 * j}") }
            let pd = g.def("getelementptr i8, ptr ${d}, i64 ${oj}")
            g.emit("store i64 ${vs[j]}, ptr ${pd}, align 1")
          }
        }
      }
      g.emit("%${body}.n = add i64 %${head}.i, 32")
      g.emit("br label %${head}")
      g.start(done)
    }
    "rt.mem_set" => {
      g.llvm_decl("@llvm.memset.p0.i64", "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
      let d = g.raw_ptr(x.args[0])
      let b = g.def("trunc i64 ${g.op(x.args[1])} to i8")
      g.emit("call void @llvm.memset.p0.i64(ptr ${d}, i8 ${b}, i64 ${g.op(x.args[2])}, i1 false)")
    }
    "rt.prefetch" => {
      // read, high locality, data (decision 0207 stage 3)
      g.llvm_decl("@llvm.prefetch.p0", "declare void @llvm.prefetch.p0(ptr, i32, i32, i32)")
      let p = g.raw_ptr(x.args[0])
      g.emit("call void @llvm.prefetch.p0(ptr ${p}, i32 0, i32 3, i32 1)")
    }
    "rt.mem_cmp" => {
      g.llvm_decl("@memcmp", "declare i32 @memcmp(ptr, ptr, i64)")
      let a = g.raw_ptr(x.args[0])
      let b = g.raw_ptr(x.args[1])
      let r = g.def("call i32 @memcmp(ptr ${a}, ptr ${b}, i64 ${g.op(x.args[2])})")
      g.set(v, "sext i32 ${r} to i64")
    }
    "rt.list_esize" => g.alias(v, "${g.esize(g.m.types[g.vty(x.args[0])].elems[0])}")
    "rt.obj_addr" => {
      var o = g.op(x.args[0])
      if g.m.types[g.vty(x.args[0])].kind == ssa.Kind.Str {
        let whole = o
        o = g.def("extractvalue %xo.str ${o}, 0")
        if STR_VIEWS {
          // a view's offset (decision 0330), as arm64 does
          let w1 = g.def("extractvalue %xo.str ${whole}, 1")
          let off = g.def("lshr i64 ${w1}, 32")
          o = g.def("getelementptr i8, ptr ${o}, i64 ${off}")
        }
      }
      g.set(v, "ptrtoint ptr ${o} to i64")
    }
    "rt.str_view" => {
      // s[lo..hi] with the range already checked (decision 0330 step 3), as arm64
      let s = g.op(x.args[0])
      let obj = g.def("extractvalue %xo.str ${s}, 0")
      let w1 = g.def("extractvalue %xo.str ${s}, 1")
      let lo = g.op(x.args[1])
      let hi = g.op(x.args[2])
      g.emit("call void ${g.rc_fn("dup", x.ty)}(ptr ${obj})")
      let n = g.def("sub i64 ${hi}, ${lo}")
      let off = g.def("lshr i64 ${w1}, 32")
      let off2 = g.def("add i64 ${off}, ${lo}")
      let sh = g.def("shl i64 ${off2}, 32")
      let nw = g.def("or i64 ${sh}, ${n}")
      g.mk_str(v, obj, nw)
    }
    "rt.obj_at" => {
      let p = g.raw_ptr(x.args[0])
      g.emit("call void ${g.rc_fn("dup", x.ty)}(ptr ${p})")
      g.alias(v, p)
    }
    "rt.str_at" => {
      // the two words as a Str, no count taken (decision 0402), as arm64
      g.mk_str(v, g.raw_ptr(x.args[0]), g.op(x.args[1]))
    }
    _ => return false
  }
  true
}

/// The pause hint of a spin loop on goarch ("" the compiler's own; the
/// predeclared `target` of internal/ssa's build_target.go), as inline
/// asm (spinHintAsm): `yield` on arm64, `pause` on amd64, as the C
/// runtime's spin_relax; "" (nothing) elsewhere.
fn spin_hint_asm(goarch: Str) -> Str {
  var arch = goarch
  if arch.is_empty() {
    arch = match target.arch {
      Arm64 => "arm64"
      Wasm32 => "wasm"
      Amd64 => "amd64"
    }
  }
  match arch {
    "arm64" => "call void asm sideeffect \"yield\", \"\"()"
    "amd64" => "call void asm sideeffect \"pause\", \"\"()"
    _ => ""
  }
}

/// The memory order of argument k of value v (decision 0200; ordArg):
/// its constant 0 relaxed, 1 acquire, 2 release, 3 acq_rel, 4 seq_cst;
/// a value that is not one of them is seq_cst.
fn (var g: Gen) ord_arg(v: Int, k: Int) -> Int {
  let x = g.f.values[v]
  if k >= x.args.len() {
    return 4
  }
  let c = g.f.values[x.args[k]]
  if c.op != ssa.Op.Const {
    return 4
  }
  match c.aux {
    I(n) => if n >= 0 && n <= 4 { n } else { 4 }
    _ => 4
  }
}

/// The address of the cell (container, index) of an atomic: the list's
/// element, or an Atomic's value (the same layout: a header of three
/// words, then words; cellAddr).
fn (var g: Gen) cell_addr(v: Int) -> Str {
  let x = g.f.values[v]
  let l = g.op(x.args[0])
  if g.kind(g.vty(x.args[0])) == ssa.Kind.Int {
    // the address form (decision 0207): word i from the address
    let p = g.def("inttoptr i64 ${l} to ptr")
    let o = g.def("shl i64 ${g.op(x.args[1])}, 3")
    return g.def("getelementptr i8, ptr ${p}, i64 ${o}")
  }
  let c = g.f.values[x.args[1]]
  if c.op == ssa.Op.Const {
    if let I(k) = c.aux {
      return g.def("getelementptr i8, ptr ${l}, i64 ${24 + 8 * k}")
    }
  }
  let o = g.def("shl i64 ${g.op(x.args[1])}, 3")
  let o2 = g.def("add i64 ${o}, 24")
  g.def("getelementptr i8, ptr ${l}, i64 ${o2}")
}

/// The i64 of an Int or Bool operand (a Bool cell holds 0 or 1).
fn (var g: Gen) word_of(a: Int) -> Str {
  let o = g.op(a)
  if g.kind(g.vty(a)) == ssa.Kind.Bool {
    return g.def("zext i1 ${o} to i64")
  }
  o
}

/// Sets v, an Int or a Bool, to the i64 r.
fn (var g: Gen) atomic_result(v: Int, r: Str) {
  if g.kind(g.vty(v)) == ssa.Kind.Bool {
    g.set(v, "icmp ne i64 ${r}, 0")
    return
  }
  g.alias(v, r)
}

/// Lowers the atomics and fences of decision 0200 inline (atomic): load
/// atomic, store atomic, atomicrmw, cmpxchg, and fence with the order's
/// LLVM ordering (relaxed is monotonic; a load takes no release and a
/// store no acquire, and a cmpxchg fails with the strongest ordering
/// allowed there). The spin hint is the target's pause hint as inline
/// asm (spin_hint_asm), as the C runtime's spin_relax.
fn (var g: Gen) atomic(v: Int) {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  if name == "rt.preempt_poll" {
    // decision 0286 step 3: the flag's word; set, a call of the stub that
    // keeps every register (the asm writes x16 and lr)
    g.preempt_stub()
    let a = g.op(x.args[0])
    let stub = if g.goos == "darwin" { "_xo_preempt_stub" } else { "xo_preempt_stub" }
    if g.arch() == "amd64" {
      // the call steps over System V's red zone (Windows has none)
      let rz = if g.os() == "windows" { "" } else { "leaq -128(%rsp), %rsp\\0A" }
      let rz2 = if g.os() == "windows" { "" } else { "leaq 128(%rsp), %rsp\\0A" }
      g.emit("call void asm sideeffect \"movl ($0), %r11d\\0Atestl %r11d, %r11d\\0Ajz 1f\\0A${rz}callq ${stub}\\0A${rz2}1:\", \"r,~{r11},~{memory},~{dirflag},~{fpsr},~{flags}\"(i64 ${a})")
      return
    }
    // the test in IR, a relaxed atomic load and a branch (2026-10-21: the
    // inline asm with a memory clobber at every iteration kept LLVM from
    // promoting a loop's memory: sieve 0.11 s to 0.19 s), and only the
    // unlikely slow block calls the stub, as asm that touches no program
    // memory (#18): a yield is not a synchronization point of the
    // program's data, and the thread local table is read through calls
    // that are memory barriers (sched_tlocal), never cached across one
    let p = g.def("inttoptr i64 ${a} to ptr")
    let f = g.def("load atomic i32, ptr ${p} monotonic, align 4")
    let c = g.def("icmp ne i32 ${f}, 0")
    let slow = g.new_label("pp")
    let ok = g.new_label("ppr")
    g.emit("br i1 ${c}, label %${slow}, label %${ok}, !prof !0")
    g.start(slow)
    g.emit("call void asm sideeffect \"bl ${stub}\", \"~{x16},~{x17},~{lr}\"() #18")
    g.emit("br label %${ok}")
    g.start(ok)
    return
  }
  if name == "rt.spin_hint" {
    let asm = spin_hint_asm(g.m.goarch)
    if !asm.is_empty() {
      g.emit(asm)
    }
    return
  }
  if name == "rt.fence" {
    let o = g.ord_arg(v, 0)
    if o > 0 {
      g.emit("fence ${["", "acquire", "release", "acq_rel", "seq_cst"][o]}")
    }
    return
  }
  let p = g.cell_addr(v)
  if name == "rt.slot_addr" {
    g.set(v, "ptrtoint ptr ${p} to i64")
    return
  }
  let o = g.ord_arg(v, x.args.len() - 1)
  let ord = ["monotonic", "acquire", "release", "acq_rel", "seq_cst"][o]
  match name {
    "rt.slot_load" => {
      let lo = if o == 0 { "monotonic" } else if o == 1 { "acquire" } else { "seq_cst" }
      g.atomic_result(v, g.def("load atomic i64, ptr ${p} ${lo}, align 8"))
    }
    "rt.slot_store" => {
      let so = if o == 0 { "monotonic" } else if o == 2 { "release" } else { "seq_cst" }
      g.emit("store atomic i64 ${g.word_of(x.args[2])}, ptr ${p} ${so}, align 8")
    }
    "rt.slot_swap" | "rt.slot_add" => {
      let op = if name == "rt.slot_swap" { "xchg" } else { "add" }
      g.atomic_result(v, g.def("atomicrmw ${op} ptr ${p}, i64 ${g.word_of(x.args[2])} ${ord}, align 8"))
    }
    _ => {
      // rt.slot_cas, strong
      let old = g.word_of(x.args[2])
      let new = g.word_of(x.args[3])
      let fail = ["monotonic", "acquire", "monotonic", "acquire", "seq_cst"][o]
      let r = g.def("cmpxchg ptr ${p}, i64 ${old}, i64 ${new} ${ord} ${fail}, align 8")
      g.set(v, "extractvalue { i64, i1 } ${r}, 1")
    }
  }
}

/// Declares the LLVM intrinsic sym once, among the runtime declarations
/// of the calls used (decision 0195; llvmDecl).
fn (var g: Gen) llvm_decl(sym: Str, decl: Str) {
  if !g.emitted.contains(sym) {
    g.emitted[sym] = true
    g.rt_decls.push("${decl}\n")
  }
}

/// Lowers a call of the task runtime (rtCall): an Int is an i64, a Bool
/// an i64 0 or 1, a List or handle a pointer, a Str its bytes and length;
/// the result is void or one of those.
fn (var g: Gen) rt_call(v: Int) {
  if aux_str(g.f.values[v].aux).starts_with("rt.pc.") {
    g.platform_call(v)
    return
  }
  if g.inline_rt(v) {
    return
  }
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  // the shields and budgets are ctx.xo's and budget.xo's exports,
  // defined in the module (decision 0229): called directly, their
  // pointers passed as Ints, with no declaration
  let export = xo_export(name)
  let sym = if export.is_empty() { "@xo_${name.trim_prefix("rt.")}" } else { "@${export}" }
  // `rt.rs_*` functions take their Str operands as the string object
  // (the first is consumed, decision 0074); the others its bytes
  let obj = name.starts_with("rt.rs_")
  var params: List[Str] = []
  var args: List[Str] = []
  for a in x.args {
    let at = g.vty(a)
    match g.kind(at) {
      Int => {
        params.push("i64")
        args.push("i64 ${g.op(a)}")
      }
      Float => {
        params.push("double")
        args.push("double ${g.op(a)}")
      }
      Bool => {
        params.push("i64")
        let o = g.op(a)
        let z = g.def("zext i1 ${o} to i64")
        args.push("i64 ${z}")
      }
      List | Handle => {
        params.push("ptr")
        args.push("ptr ${g.op(a)}")
      }
      Str => {
        let o0 = g.op(a)
        let (o, d0, n0) = g.str_parts(o0)
        let d = if obj { o } else { d0 }
        // an object goes with its packed word (the builder paths mask it)
        let n = if obj { g.def("extractvalue %xo.str ${o0}, 1") } else { n0 }
        params.push("ptr")
        params.push("i64")
        args.push("ptr ${d}")
        args.push("i64 ${n}")
      }
      Func => {
        // a closure as its two words, code and environment
        // (rt.task_spawn)
        let o = g.op(a)
        params.push("ptr")
        params.push("ptr")
        args.push("ptr ${g.def("extractvalue { ptr, ptr } ${o}, 0")}")
        args.push("ptr ${g.def("extractvalue { ptr, ptr } ${o}, 1")}")
      }
      _ => {
        g.fail("the runtime call `${name}` takes a `${g.m.types[at].name}`")
        return
      }
    }
  }
  var ret = "void"
  var slot = ""
  match g.kind(x.ty) {
    Unit => {}
    Int | Bool => ret = "i64"
    Float => ret = "double"
    List | Handle => ret = "ptr"
    Str => {
      // the string object; its length through a pointer
      ret = "ptr"
      slot = g.alloca("i64")
      params.push("ptr")
      args.push("ptr ${slot}")
    }
    _ => {
      g.fail("the runtime call `${name}` returns a `${g.m.types[x.ty].name}`")
      return
    }
  }
  if !export.is_empty() {
    // the exports return Ints: a pointer result comes back through an
    // inttoptr below
    for i in 0..args.len() {
      if args[i].starts_with("ptr ") {
        let p = g.def("ptrtoint ${args[i]} to i64")
        args[i] = "i64 ${p}"
      }
    }
  } else if !g.emitted.contains(sym) && !g.decls.contains(" ${sym}(") {
    g.emitted[sym] = true
    var attr = "#2"
    if runtime_raises(name) {
      attr = "#5" // it raises faults: not nounwind (decision 0085)
    }
    g.rt_decls.push("declare ${ret} ${sym}(${params.join(", ")}) ${attr}\n")
  }
  // the exports that never raise or unwind (heapos.xo's platform calls,
  // anyval.xo) are nounwind and not inlined at the call: inlined
  // into the heap's fast paths, the slow paths cost LLVM alloc tasks and
  // strings 1.10 and 1.03 times the instructions (2026-10-15)
  let nounw = if !export.is_empty() && (name.starts_with("rt.heap_") || name is "rt.any_new" | "rt.any_get" | "rt.any_take") { " #8" } else { "" }
  if !export.is_empty() && ret == "ptr" {
    let r = g.tmp()
    g.raise(r, "i64 ${sym}(${args.join(", ")})${nounw}")
    if g.kind(x.ty) == ssa.Kind.Str {
      // obj.xo's builders: the string object, its length in the slot
      let o = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, o, n)
      return
    }
    if ssa.rt_export_none(name) {
      // 0 for none: the zero handle or the empty list (ssa/exports.xo)
      let p = g.def("inttoptr i64 ${r} to ptr")
      let z = g.def("icmp eq i64 ${r}, 0")
      var none = ""
      if g.kind(x.ty) == ssa.Kind.List {
        none = g.empty_list()
      } else {
        none = g.zero_handle()
      }
      g.set(v, "select i1 ${z}, ptr ${none}, ptr ${p}")
      return
    }
    g.set(v, "inttoptr i64 ${r} to ptr")
    return
  }
  let c = "${ret} ${sym}(${args.join(", ")})${nounw}"
  match g.kind(x.ty) {
    Unit => g.raise("", c)
    Bool => {
      let r = g.tmp()
      g.raise(r, c)
      g.set(v, "icmp ne i64 ${r}, 0")
    }
    Str => {
      let o = g.tmp()
      g.raise(o, c)
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, o, n)
    }
    _ => g.raise(vname(v), c)
  }
}

/// The parts of a platform call's name `rt.pc.<os>.<sym>[/<n>]`
/// (decision 0213): the OS, the C symbol, and the number of fixed
/// parameters of a variadic function (-1 when it is not one).
fn platform_parts(name: Str) -> (Str, Str, Int) {
  let rest = name.trim_prefix("rt.pc.")
  let parts = rest.split(".")
  if parts.len() < 2 {
    return ("", rest, -1)
  }
  let sv = parts[1].split("/")
  var n = -1
  if sv.len() == 2 {
    n = Int.parse(sv[1]) ?? -1
  }
  (parts[0], sv[0], n)
}

/// Lowers a call of a platform library function (decision 0213,
/// std/native/sys_<os>.xo): a call of the bare C symbol, declared with
/// the C types of the declaration (an Int i64, an Int32 or UInt32 i32, a
/// Float double, Bytes the pointer to its data; `...` after the fixed
/// parameters of a variadic function), `dllimport` on Windows. A call
/// for another OS (an arm of a `match` on `target.os` the passes keep)
/// is a trap.
fn (var g: Gen) platform_call(v: Int) {
  let x = g.f.values[v]
  let (os, sym, nfixed) = platform_parts(aux_str(x.aux))
  let rk = g.kind(x.ty)
  if os == "cp" {
    // rt.sym_present (decision 0232): the weak symbol's address against
    // null (a function declaration, so a symbol with a C call
    // declaration too must be declared extern_weak the same way)
    if g.weak_ref(sym) {
      g.llvm_decl("@${sym}", "declare void @${sym}()")
      g.llvm_decl("@xo_absent", "@xo_absent = external global [0 x i8]")
      g.set(v, "icmp ne ptr @${sym}, @xo_absent")
      return
    }
    g.llvm_decl("@${sym}", "declare extern_weak void @${sym}()")
    g.set(v, "icmp ne ptr @${sym}, null")
    return
  }
  if os != g.os() && os != "c" && os != "cw" {
    g.llvm_decl("@llvm.trap", "declare void @llvm.trap() cold noreturn nounwind")
    g.emit("call void @llvm.trap()")
    match rk {
      Int => g.alias(v, "0")
      Float => g.alias(v, "0.0")
      _ => {}
    }
    return
  }
  var params: List[Str] = []
  var args: List[Str] = []
  for a in x.args {
    let at = g.vty(a)
    match g.kind(at) {
      Int => {
        if g.m.types[at].bits == 32 {
          params.push("i32")
          args.push("i32 ${g.def("trunc i64 ${g.op(a)} to i32")}")
        } else {
          params.push("i64")
          args.push("i64 ${g.op(a)}")
        }
      }
      Float => {
        params.push("double")
        args.push("double ${g.op(a)}")
      }
      Str => {
        let (_, d, _) = g.str_parts(g.op(a))
        params.push("ptr")
        args.push("ptr ${d}")
      }
      _ => {
        g.fail("the platform call `${sym}` takes a `${g.m.types[at].name}`")
        return
      }
    }
  }
  let i32r = rk == ssa.Kind.Int && g.m.types[x.ty].bits == 32
  var ret = "void"
  match rk {
    Unit => {}
    Int => ret = if i32r { "i32" } else { "i64" }
    Float => ret = "double"
    _ => {
      g.fail("the platform call `${sym}` returns a `${g.m.types[x.ty].name}`")
      return
    }
  }
  var decl_params = params.join(", ")
  var fty = ""
  if nfixed >= 0 && nfixed <= params.len() {
    var fixed: List[Str] = []
    for i in 0..nfixed {
      fixed.push(params[i])
    }
    fixed.push("...")
    decl_params = fixed.join(", ")
    fty = "(${decl_params}) "
  }
  let dll = if os == "windows" { "dllimport " } else if os == "cw" && !g.weak_ref(sym) { "extern_weak " } else { "" }
  g.llvm_decl("@${sym}", "declare ${dll}${ret} @${sym}(${decl_params}) nounwind")
  let c = "call ${ret} ${fty}@${sym}(${args.join(", ")})"
  match rk {
    Unit => g.emit(c)
    Int => {
      if i32r {
        let r = g.def(c)
        let ext = if g.m.types[x.ty].unsigned { "zext" } else { "sext" }
        g.set(v, "${ext} i32 ${r} to i64")
      } else {
        g.set(v, c)
      }
    }
    _ => g.set(v, c)
  }
}

/// The Xo export a runtime call name goes to directly (decision 0229:
/// ctx.xo's shields, budget.xo's tick, open, and end, tasks.xo
/// and scopes), or "" for the C
/// runtime's xo_<name>.
fn xo_export(name: Str) -> Str {
  if name is "rt.shield_begin" | "rt.shield_end" | "rt.shield_abort" | "rt.unwinding" {
    return "xo_x_ctx_${name.trim_prefix("rt.")}"
  }
  if name is "rt.sched_hook" | "rt.task_done" | "rt.task_unwound" | "rt.task_await" | "rt.task_result" | "rt.scope_fail_task" | "rt.scope_fail_site" | "rt.scope_group" | "rt.fault_rethrow" | "rt.scope_cancel" | "rt.prog_group_set" | "rt.prog_group_clear" | "rt.prog_group" | "rt.task_spawn" | "rt.task_spawn_fn" | "rt.task_wanted" | "rt.scope_open" | "rt.scope_close" | "rt.mutex_new" | "rt.mutex_lock" | "rt.mutex_unlock" | "rt.mutex_rlock" | "rt.mutex_runlock" | "rt.chan_new" | "rt.chan_send" | "rt.chan_recv" | "rt.chan_try_send" | "rt.chan_try_recv" | "rt.chan_close" | "rt.chan_len" | "rt.select_new" | "rt.select_recv" | "rt.select_send" | "rt.select_wait" | "rt.select_take" | "rt.atomic_new" | "rt.const_once" {
    return "xo_x_${name.trim_prefix("rt.")}"
  }
  if name is "rt.tick" | "rt.budget_open" | "rt.budget_end" {
    return "xo_x_budget_${name.trim_prefix("rt.").trim_prefix("budget_")}"
  }
  if name is "rt.fault_raise" | "rt.fault_continue" | "rt.fault_take" | "rt.fault_msg" | "rt.fault_loc" | "rt.fault_detail" | "rt.fault_at" {
    // fault.xo's raise, continue, and record through their exports
    return "xo_x_${name.trim_prefix("rt.")}"
  }
  if name is "rt.heap_big" | "rt.heap_big_resize" | "rt.heap_big_release" | "rt.heap_grow" | "rt.heap_lock" | "rt.heap_unlock" | "rt.any_new" | "rt.any_get" | "rt.any_take" {
    // heapos.xo's platform calls (B21) and anyval.xo through their
    // exports
    return "xo_x_${name.trim_prefix("rt.")}"
  }
  if name is "rt.rs_append" | "rt.rs_push_byte" | "rt.rs_push_word" | "rt.rs_push_words" | "rt.rs_append_bytes" | "rt.rs_with_cap" {
    // obj.xo's string builders, as on arm64
    return "xo_x_obj_${name.trim_prefix("rt.")}"
  }
  // the net, clock and scope checks, shutdown and real-time sections
  // (ssa/exports.xo, shared with arm64)
  ssa.rt_export(name)
}

/// rt.chacha_blocks4 (decision 0329) as vector IR: the 16 state words
/// as <4 x i32> values, a lane a block (the counters the four words after
/// the state at st), the 20 rounds with llvm.fshl rotations, the state
/// added back, each group of four words transposed into the four blocks
/// (shufflevector), xored with src into dst.
fn (var g: Gen) chacha4(dst: Str, src: Str, st: Str) {
  var orig: List[Str] = []
  for i in 0..16 {
    if i == 12 {
      let a = g.def("getelementptr i8, ptr ${st}, i64 64")
      orig.push(g.def("load <4 x i32>, ptr ${a}, align 4"))
    } else {
      let a = g.def("getelementptr i8, ptr ${st}, i64 ${4 * i}")
      let w = g.def("load i32, ptr ${a}, align 4")
      let one = g.def("insertelement <4 x i32> poison, i32 ${w}, i64 0")
      orig.push(g.def("shufflevector <4 x i32> ${one}, <4 x i32> poison, <4 x i32> zeroinitializer"))
    }
  }
  var x = orig
  let quarters = [[0, 4, 8, 12], [1, 5, 9, 13], [2, 6, 10, 14], [3, 7, 11, 15], [0, 5, 10, 15], [1, 6, 11, 12], [2, 7, 8, 13], [3, 4, 9, 14]]
  for _ in 0..10 {
    for q in quarters {
      let a = q[0]
      let b = q[1]
      let c = q[2]
      let d = q[3]
      x[a] = g.def("add <4 x i32> ${x[a]}, ${x[b]}")
      x[d] = g.chacha_rotl(g.def("xor <4 x i32> ${x[d]}, ${x[a]}"), 16)
      x[c] = g.def("add <4 x i32> ${x[c]}, ${x[d]}")
      x[b] = g.chacha_rotl(g.def("xor <4 x i32> ${x[b]}, ${x[c]}"), 12)
      x[a] = g.def("add <4 x i32> ${x[a]}, ${x[b]}")
      x[d] = g.chacha_rotl(g.def("xor <4 x i32> ${x[d]}, ${x[a]}"), 8)
      x[c] = g.def("add <4 x i32> ${x[c]}, ${x[d]}")
      x[b] = g.chacha_rotl(g.def("xor <4 x i32> ${x[b]}, ${x[c]}"), 7)
    }
  }
  for i in 0..16 {
    x[i] = g.def("add <4 x i32> ${x[i]}, ${orig[i]}")
  }
  for gr in 0..4 {
    let w0 = x[4 * gr]
    let w1 = x[4 * gr + 1]
    let w2 = x[4 * gr + 2]
    let w3 = x[4 * gr + 3]
    let t0 = g.def("shufflevector <4 x i32> ${w0}, <4 x i32> ${w1}, <4 x i32> <i32 0, i32 4, i32 2, i32 6>")
    let t1 = g.def("shufflevector <4 x i32> ${w0}, <4 x i32> ${w1}, <4 x i32> <i32 1, i32 5, i32 3, i32 7>")
    let t2 = g.def("shufflevector <4 x i32> ${w2}, <4 x i32> ${w3}, <4 x i32> <i32 0, i32 4, i32 2, i32 6>")
    let t3 = g.def("shufflevector <4 x i32> ${w2}, <4 x i32> ${w3}, <4 x i32> <i32 1, i32 5, i32 3, i32 7>")
    let ys = [
      g.def("shufflevector <4 x i32> ${t0}, <4 x i32> ${t2}, <4 x i32> <i32 0, i32 1, i32 4, i32 5>"),
      g.def("shufflevector <4 x i32> ${t1}, <4 x i32> ${t3}, <4 x i32> <i32 0, i32 1, i32 4, i32 5>"),
      g.def("shufflevector <4 x i32> ${t0}, <4 x i32> ${t2}, <4 x i32> <i32 2, i32 3, i32 6, i32 7>"),
      g.def("shufflevector <4 x i32> ${t1}, <4 x i32> ${t3}, <4 x i32> <i32 2, i32 3, i32 6, i32 7>"),
    ]
    for (b, y) in ys.indexed() {
      let off = 64 * b + 16 * gr
      let sa = g.def("getelementptr i8, ptr ${src}, i64 ${off}")
      let sv = g.def("load <4 x i32>, ptr ${sa}, align 1")
      let r = g.def("xor <4 x i32> ${y}, ${sv}")
      let da = g.def("getelementptr i8, ptr ${dst}, i64 ${off}")
      g.emit("store <4 x i32> ${r}, ptr ${da}, align 1")
    }
  }
}

/// v rotated left by k in each 32 bit lane (llvm.fshl).
fn (var g: Gen) chacha_rotl(v: Str, k: Int) -> Str {
  g.def("call <4 x i32> @llvm.fshl.v4i32(<4 x i32> ${v}, <4 x i32> ${v}, <4 x i32> <i32 ${k}, i32 ${k}, i32 ${k}, i32 ${k}>)")
}

/// Sixteen copies of the byte v as a <16 x i8>: one insertelement into
/// poison and a shufflevector of zeros, the shape bytes_eq16 uses for its
/// constants (decision 0373's lane).
fn (var g: Gen) splat8(v: Int) -> Str {
  let e = g.def("insertelement <16 x i8> poison, i8 ${v}, i64 0")
  g.def("shufflevector <16 x i8> ${e}, <16 x i8> poison, <16 x i32> zeroinitializer")
}
