// Calls (fromssa.go call and rtCall): of functions of the module, of
// the operations lowered inline (lists, strings, numbers, Stdio), and of
// the task runtime (`rt.name` is the C function xo_name, decision 0068).

use github.com/xo-lang/xo/compiler/ssa

/// Whether Str and Bytes values may be views (decision 0330 step 3): the
/// second word is then len | (off << 32). Off until slicing makes views.
const STR_VIEWS: Bool = true

/// The object, data pointer, and length of a Str (strParts). The data of a
/// view starts off bytes into the object's bytes (decision 0330).
fn (var g: Gen) str_parts(x: Str) -> (Str, Str, Str) {
  let obj = g.def("extractvalue %xo.str ${x}, 0")
  var data = ""
  if STR_VIEWS {
    let w1 = g.def("extractvalue %xo.str ${x}, 1")
    let off = g.def("lshr i64 ${w1}, 32")
    let at = g.def("getelementptr i8, ptr ${obj}, i64 ${off}")
    data = g.def("getelementptr i8, ptr ${at}, i64 16")
  } else {
    data = g.def("getelementptr i8, ptr ${obj}, i64 16")
  }
  let n = g.str_len_of(x)
  (obj, data, n)
}

/// The length of the Str or Bytes value x: its second word, or the low half
/// of it once values may be views.
fn (var g: Gen) str_len_of(x: Str) -> Str {
  let w1 = g.def("extractvalue %xo.str ${x}, 1")
  if STR_VIEWS {
    return g.def("and i64 ${w1}, 4294967295")
  }
  w1
}

fn (var g: Gen) mk_str(v: Int, obj: Str, n: Str) {
  let t = g.def("insertvalue %xo.str undef, ptr ${obj}, 0")
  g.set(v, "insertvalue %xo.str ${t}, i64 ${n}, 1")
}

/// Lowers call v (call).
fn (var g: Gen) call(v: Int) {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  let args = x.args
  let vt = x.ty
  // the alias scopes of a list access (decision 0211, noalias.xo)
  let md = g.sc_md(v)
  let callee = g.by_name.get(name) ?? -1
  if callee >= 0 {
    g.user_call(v, callee)
    return
  }
  if name == "rt.landing" {
    // a check only a fault takes: never true here; the landing pads
    // enter its first successor (decision 0085)
    g.alias(v, "false")
    return
  }
  if name.starts_with("rt.") {
    g.rt_call(v)
    return
  }
  match name {
    "list.new" => {
      let et = g.m.types[vt].elems[0]
      if args.len() == 1 {
        // with room for a number of elements
        let a0 = g.op(args[0])
        // obj.xo's export, with no C level
        let r = g.def("call i64 @xo_x_obj_rl_new_n(i64 ${a0}, i64 ${g.esize(et)}) #6")
        let p = g.def("inttoptr i64 ${r} to ptr")
        // the header obj.rl_new_n wrote (count 1, length 0, capacity
        // max(n, 4)), again where LLVM sees it: it then knows the new list
        // is held only here and how long it is (2026-10-21: nbody's
        // bodies() list, decision 0322's step C; plain stores, the list
        // is no other thread's yet)
        g.emit("store i64 1, ptr ${p}${TBAA_RC}")
        let lp = g.def("getelementptr %xo.rlist, ptr ${p}, i32 0, i32 1")
        g.emit("store i64 0, ptr ${lp}${TBAA_HDR}")
        // max(n, 4): a constant folded here, else llvm.smax (no
        // `select`: test/codegen consttime forbids one in sc_reduce)
        let cap = if let Some(k) = Int.parse(a0) { "${k.max(4)}" } else { g.def("call i64 @llvm.smax.i64(i64 ${a0}, i64 4)") }
        let cp = g.def("getelementptr %xo.rlist, ptr ${p}, i32 0, i32 2")
        g.emit("store i64 ${cap}, ptr ${cp}${TBAA_HDR}")
        g.alias(v, p)
        return
      }
      // the shared empty list, immortal: the first push allocates
      // (xo_rl_grow), as on arm64
      g.alias(v, g.empty_list())
    }
    "list.len" => {
      let a0 = g.op(args[0])
      let n = g.list_len(a0, md)
      g.alias(v, n)
    }
    "list.index" => {
      let et = vt
      if !x.pos.is_empty() {
        let a0 = g.op(args[0])
        let n = g.list_len(a0, md)
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let l = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n}, ${l})")
      }
      let a0 = g.op(args[0])
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, a0, a1)
      if g.kind(et) == ssa.Kind.Unit {
        return
      }
      if g.is_agg(et) && g.root_borrowed(args[0]) {
        g.addr[v] = p
      }
      if g.pnarrow(et) > 0 {
        g.alias(v, g.elem_load(et, p, md))
        return
      }
      let l = g.ll(et)
      g.set(v, "load ${l}, ptr ${p}${TBAA_ELEM}${md}")
    }
    "list.take" => {
      // element i moves out (decision 0169); its slot gets a
      // placeholder that releasing ignores until list.set stores back
      let et = g.m.types[vt].elems[1]
      let l = g.op(args[0])
      if !x.pos.is_empty() {
        let n = g.list_len(l, md)
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let lc = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n}, ${lc})")
      }
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, l, a1)
      let ev = g.elem_load(et, p, md)
      let h = g.hole(et)
      g.elem_store(et, h, p, md)
      let rt = g.ll(vt)
      let t = g.def("insertvalue ${rt} undef, ptr ${l}, 0")
      let el3 = g.ll(et)
      g.set(v, "insertvalue ${rt} ${t}, ${el3} ${ev}, 1")
    }
    "list.get" => {
      let ot = vt
      let et = g.m.types[g.vty(args[0])].elems[0]
      let some = g.m.variant_index(ot, "Some")
      let none = g.m.variant_index(ot, "None")
      let a0 = g.op(args[0])
      let n = g.list_len(a0, md)
      let a1 = g.op(args[1])
      let inr = g.def("icmp ult i64 ${a1}, ${n}")
      let yes = g.new_label("get")
      let no = g.new_label("none")
      let end = g.new_label("gend")
      g.emit("br i1 ${inr}, label %${yes}, label %${no}")
      g.start(yes)
      let b0 = g.op(args[0])
      let b1 = g.op(args[1])
      let p = g.elem_ptr(et, b0, b1)
      var ev = "zeroinitializer"
      if g.kind(et) != ssa.Kind.Unit {
        ev = g.elem_load(et, p, md)
      }
      let sv = g.variant(ot, some, [ev])
      let yes_end = g.label
      g.emit("br label %${end}")
      g.start(no)
      let nv = g.variant(ot, none, [])
      let no_end = g.label
      g.emit("br label %${end}")
      g.start(end)
      let ol = g.ll(ot)
      g.set(v, "phi ${ol} [ ${sv}, %${yes_end} ], [ ${nv}, %${no_end} ]")
    }
    "list.set" => {
      let et = g.vty(args[2])
      let l = g.op(args[0])
      if !x.pos.is_empty() {
        let n = g.list_len(l, md)
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let lc = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n}, ${lc})")
      }
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, l, a1)
      if g.heap(et) {
        let el = g.ll(et)
        let h = g.rc_fn("drop", et)
        if g.rc_by_ptr(et) {
          // the old element released where it is
          g.emit("call void ${h}(ptr ${p})")
        } else {
          let old = g.def("load ${el}, ptr ${p}${TBAA_ELEM}${md}")
          g.emit("call void ${h}(${el} ${old})")
        }
      }
      if g.kind(et) != ssa.Kind.Unit {
        g.elem_store(et, g.op(args[2]), p, md)
      }
      g.alias(v, l)
    }
    "list.push" => {
      let et = g.vty(args[1])
      let l = g.op(args[0])
      let n = g.list_len(l, md)
      let cp = g.def("getelementptr %xo.rlist, ptr ${l}, i32 0, i32 2")
      let c = g.def("load i64, ptr ${cp}${HDR_COUNT}${md}")
      let full = g.def("icmp eq i64 ${n}, ${c}")
      let from = g.label
      let grow = g.new_label("grow")
      let room = g.new_label("room")
      g.emit("br i1 ${full}, label %${grow}, label %${room}, !prof !0")
      g.start(grow)
      // obj.xo's export, with no C level (was xo_rt.c xo_rl_grow)
      let li = g.def("ptrtoint ptr ${l} to i64")
      let gi = g.def("call i64 @xo_x_obj_rl_grow_n(i64 ${li}, i64 ${g.esize(et)}) #8")
      let l2 = g.def("inttoptr i64 ${gi} to ptr")
      g.emit("br label %${room}")
      g.start(room)
      let lm = g.def("phi ptr [ ${l}, %${from} ], [ ${l2}, %${grow} ]")
      if g.kind(et) != ssa.Kind.Unit {
        let p = g.elem_ptr(et, lm, n)
        g.elem_store(et, g.op(args[1]), p, md)
      }
      let n1 = g.def("add nuw nsw i64 ${n}, 1")
      let lp = g.def("getelementptr %xo.rlist, ptr ${lm}, i32 0, i32 1")
      g.emit("store i64 ${n1}, ptr ${lp}${TBAA_HDR}${md}")
      g.alias(v, lm)
    }
    "log.set" => {
      // decision 0291: list.set into a borrowed list (a Map log's chunk
      // its Map's owner alone holds): the old element dropped; no result
      let et = g.vty(args[2])
      let l = g.op(args[0])
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, l, a1)
      if g.heap(et) {
        let el = g.ll(et)
        let h = g.rc_fn("drop", et)
        if g.rc_by_ptr(et) {
          g.emit("call void ${h}(ptr ${p})")
        } else {
          let old = g.def("load ${el}, ptr ${p}${TBAA_ELEM}${md}")
          g.emit("call void ${h}(${el} ${old})")
        }
      }
      if g.kind(et) != ssa.Kind.Unit {
        g.elem_store(et, g.op(args[2]), p, md)
      }
    }
    "log.push" => {
      // decision 0291: list.push into a borrowed list with room (a Map
      // log's chunk): no growth, no result
      let et = g.vty(args[1])
      let l = g.op(args[0])
      let n = g.list_len(l, md)
      if g.kind(et) != ssa.Kind.Unit {
        let p = g.elem_ptr(et, l, n)
        g.elem_store(et, g.op(args[1]), p, md)
      }
      let n1 = g.def("add nuw nsw i64 ${n}, 1")
      let lp = g.def("getelementptr %xo.rlist, ptr ${l}, i32 0, i32 1")
      g.emit("store i64 ${n1}, ptr ${lp}${TBAA_HDR}${md}")
    }
    "list.pop" => {
      let lt = g.vty(args[0])
      let et = g.m.types[lt].elems[0]
      let ot = g.m.types[vt].elems[1]
      let some = g.m.variant_index(ot, "Some")
      let none = g.m.variant_index(ot, "None")
      let l = g.op(args[0])
      let n = g.list_len(l, md)
      let c = g.def("icmp sgt i64 ${n}, 0")
      let yes = g.new_label("pop")
      let no = g.new_label("empty")
      let end = g.new_label("pend")
      g.emit("br i1 ${c}, label %${yes}, label %${no}")
      g.start(yes)
      let n1 = g.def("sub i64 ${n}, 1")
      let lp = g.def("getelementptr %xo.rlist, ptr ${l}, i32 0, i32 1")
      g.emit("store i64 ${n1}, ptr ${lp}${TBAA_HDR}${md}")
      var ev = "zeroinitializer"
      if g.kind(et) != ssa.Kind.Unit {
        let p = g.elem_ptr(et, l, n1)
        ev = g.elem_load(et, p, md)
      }
      let sv = g.variant(ot, some, [ev])
      let yes_end = g.label
      g.emit("br label %${end}")
      g.start(no)
      let nv = g.variant(ot, none, [])
      let no_end = g.label
      g.emit("br label %${end}")
      g.start(end)
      let ol = g.ll(ot)
      let o = g.def("phi ${ol} [ ${sv}, %${yes_end} ], [ ${nv}, %${no_end} ]")
      let rt = g.ll(vt)
      let t = g.def("insertvalue ${rt} undef, ptr ${l}, 0")
      let ol2 = g.ll(ot)
      g.set(v, "insertvalue ${rt} ${t}, ${ol2} ${o}, 1")
    }
    "str.concat" => {
      let a0 = g.op(args[0])
      let (ao, _, an) = g.str_parts(a0)
      let a1 = g.op(args[1])
      let (bo, _, bn) = g.str_parts(a1)
      // obj.xo's export, with no C level; it takes the packed words (the
      // offset of a view is needed to copy it), the sum the lengths
      let pa = g.def("ptrtoint ptr ${ao} to i64")
      let pb = g.def("ptrtoint ptr ${bo} to i64")
      let aw = g.def("extractvalue %xo.str ${a0}, 1")
      let bw = g.def("extractvalue %xo.str ${a1}, 1")
      let r = g.def("call i64 @xo_x_obj_rs_concat(i64 ${pa}, i64 ${aw}, i64 ${pb}, i64 ${bw}) #6")
      let obj = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("add i64 ${an}, ${bn}")
      g.mk_str(v, obj, n)
    }
    "str.concat_int" | "str.concat_float" => {
      let a0 = g.op(args[0])
      let (ao, _, _) = g.str_parts(a0)
      let slot = g.alloca("i64")
      let a1 = g.op(args[1])
      // obj.xo and cabi.xo through their exports, not inlined (the C
      // entries stay for code of earlier compilers)
      let pa = g.def("ptrtoint ptr ${ao} to i64")
      let ps = g.def("ptrtoint ptr ${slot} to i64")
      let aw = g.def("extractvalue %xo.str ${a0}, 1")
      let r = if name == "str.concat_int" {
        g.def("call i64 @xo_x_obj_rs_concat_int(i64 ${pa}, i64 ${aw}, i64 ${a1}, i64 ${ps}) #8")
      } else {
        g.def("call i64 @xo_x_obj_rs_concat_float(i64 ${pa}, i64 ${aw}, double ${a1}, i64 ${ps}) #8")
      }
      let obj = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, obj, n)
    }
    "str.eq" => {
      let a0 = g.op(args[0])
      let (_, ad, an) = g.str_parts(a0)
      let a1 = g.op(args[1])
      let (_, bd, bn) = g.str_parts(a1)
      // obj.xo's str_eq, inlined at the call (xo_str_eq stays for code of
      // earlier compilers)
      let pa = g.def("ptrtoint ptr ${ad} to i64")
      let pb = g.def("ptrtoint ptr ${bd} to i64")
      let r = g.def("call i64 @xo_x_obj_str_eq(i64 ${pa}, i64 ${an}, i64 ${pb}, i64 ${bn}) #6")
      g.set(v, "icmp ne i64 ${r}, 0")
    }
    "str.cmp" => {
      let a0 = g.op(args[0])
      let (_, ad, an) = g.str_parts(a0)
      let a1 = g.op(args[1])
      let (_, bd, bn) = g.str_parts(a1)
      let pa = g.def("ptrtoint ptr ${ad} to i64")
      let pb = g.def("ptrtoint ptr ${bd} to i64")
      g.set(v, "call i64 @xo_x_obj_str_cmp(i64 ${pa}, i64 ${an}, i64 ${pb}, i64 ${bn}) #6")
    }
    "str.of_int" | "str.of_float" => {
      let slot = g.alloca("i64")
      let (fnn, at) = if name == "str.of_float" { ("@xo_x_obj_rs_of_float", "double") } else { ("@xo_x_obj_rs_of_int", "i64") }
      let a0 = g.op(args[0])
      let ps = g.def("ptrtoint ptr ${slot} to i64")
      let r = g.def("call i64 ${fnn}(${at} ${a0}, i64 ${ps}) #8")
      let obj = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, obj, n)
    }
    "str.of_bool" => {
      let a0 = g.op(args[0])
      let t = g.str_const("true")
      let f = g.str_const("false")
      g.set(v, "select i1 ${a0}, %xo.str ${t}, %xo.str ${f}")
    }
    "Stdio.print" | "Stdio.println" | "Stdio.eprint" | "Stdio.eprintln" => {
      let a1 = g.op(args[1])
      let (_, d, n) = g.str_parts(a1)
      let fnn = "@xo_${name.trim_prefix("Stdio.")}"
      g.emit("call void ${fnn}(ptr ${d}, i64 ${n})")
    }
    "Int.min" | "Int.max" | "Float.min" | "Float.max" => {
      let lt = g.ll(vt)
      if g.kind(vt) == ssa.Kind.Int {
        let a0 = g.op(args[0])
        let a1 = g.op(args[1])
        let c = g.def("icmp slt i64 ${a0}, ${a1}")
        let b0 = g.op(args[0])
        let b1 = g.op(args[1])
        if name.ends_with(".min") {
          g.set(v, "select i1 ${c}, ${lt} ${b0}, ${lt} ${b1}")
        } else {
          g.set(v, "select i1 ${c}, ${lt} ${b1}, ${lt} ${b0}")
        }
        return
      }
      // the total order, the receiver on a tie (std.md 1, decisions/0053):
      // min is `b < a ? b : a`, max `a < b ? b : a`
      if name.ends_with(".min") {
        let a1 = g.op(args[1])
        let a0 = g.op(args[0])
        let o = g.float_order(ssa.Op.Lt, a1, a0)
        let c = g.def(o)
        let b1 = g.op(args[1])
        let b0 = g.op(args[0])
        g.set(v, "select i1 ${c}, double ${b1}, double ${b0}")
      } else {
        let a0 = g.op(args[0])
        let a1 = g.op(args[1])
        let o = g.float_order(ssa.Op.Lt, a0, a1)
        let c = g.def(o)
        let b1 = g.op(args[1])
        let b0 = g.op(args[0])
        g.set(v, "select i1 ${c}, double ${b1}, double ${b0}")
      }
    }
    "Int.abs" => {
      if !x.pos.is_empty() {
        let a0 = g.op(args[0])
        let bad = g.def("icmp eq i64 ${a0}, ${IMMORTAL}")
        let b0 = g.op(args[0])
        let l = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_abs(i64 ${b0}, ${l})")
      }
      let a0 = g.op(args[0])
      let neg = g.def("icmp slt i64 ${a0}, 0")
      let b0 = g.op(args[0])
      let m = g.def("sub nsw i64 0, ${b0}")
      let c0 = g.op(args[0])
      g.set(v, "select i1 ${neg}, i64 ${m}, i64 ${c0}")
    }
    "Float.sqrt" | "Float.floor" | "Float.ceil" | "Float.trunc" | "Float.round" | "Float.abs" => {
      var intr = name.trim_prefix("Float.")
      if intr == "abs" {
        intr = "fabs"
      }
      let a0 = g.op(args[0])
      g.set(v, "call double @llvm.${intr}.f64(double ${a0})")
    }
    "Float.fma" => {
      // decision 0385: reached for arm64 targets only (compiler/ssa)
      let a0 = g.op(args[0])
      let a1 = g.op(args[1])
      let a2 = g.op(args[2])
      g.set(v, "call double @llvm.fma.f64(double ${a0}, double ${a1}, double ${a2})")
    }
    "Float.is_nan" => {
      let a0 = g.op(args[0])
      let b0 = g.op(args[0])
      g.set(v, "fcmp uno double ${a0}, ${b0}")
    }
    "bytes.index" => {
      // b[i] on Bytes (decision 0081)
      let a0 = g.op(args[0])
      let (_, d, n) = g.str_parts(a0)
      if !x.pos.is_empty() {
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let l = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_bytes_index(i64 ${b1}, i64 ${n}, ${l})")
      }
      let a1 = g.op(args[1])
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${a1}")
      let c = g.def("load i8, ptr ${p}${md}")
      g.set(v, "zext i8 ${c} to i64")
    }
    "Str.len" => {
      let a0 = g.op(args[0])
      if STR_VIEWS {
        let w1 = g.def("extractvalue %xo.str ${a0}, 1")
        g.set(v, "and i64 ${w1}, 4294967295")
      } else {
        g.set(v, "extractvalue %xo.str ${a0}, 1")
      }
    }
    "Str.is_empty" => {
      let a0 = g.op(args[0])
      let n = g.str_len_of(a0)
      g.set(v, "icmp eq i64 ${n}, 0")
    }
    _ => g.fail("the SSA lowering does not support the runtime call `${name}`")
  }
}

/// A call of function callee of the module (call's first part): struct
/// and enum arguments of 256 bytes or more by reference (decision 0145),
/// passed in place when they sit in memory nothing writes during the
/// call (0147), and the results of `var` parameters by reference read
/// back.
fn (var g: Gen) user_call(v: Int, callee: Int) {
  let x = g.f.values[v]
  let br = g.by_ref_of(callee)
  if !br.is_empty() && g.stage < 2 {
    g.unsupported("a call passing a parameter by reference (decision 0145)")
  }
  var args: List[Str] = []
  var slots: List[Str] = []
  var used: Map[Str, Int] = {}
  // every operand is read before anything is stored: a value held in a
  // memory is loaded before another argument overwrites it
  var st_ts: List[Int] = []
  var st_xs: List[Str] = []
  var st_ps: List[Str] = []
  for (i, a) in x.args.indexed() {
    slots.push("")
    let p = g.addr[a]
    if !p.is_empty() && !br.is_empty() && br[i] && !g.is_var_param(callee, i) {
      // in memory nothing writes during the call: passed as it is
      args.push("ptr ${p}")
      continue
    }
    if !br.is_empty() && br[i] {
      let lt = g.ll(g.vty(a))
      let sl = g.slot(lt, used)
      slots[i] = sl
      args.push("ptr ${sl}")
      let m = g.held_at(v, a)
      if m >= 0 && g.held.mems[m].ptr == sl {
        continue // already in its slot (decision 0148)
      }
      st_ts.push(g.vty(a))
      st_xs.push(g.op(a))
      st_ps.push(sl)
      continue
    }
    args.push(g.typed(a))
  }
  for k in 0..st_ts.len() {
    g.store_ref(st_ts[k], st_xs[k], st_ps[k])
  }
  let rl = g.res_ll(callee)
  var c = "${rl} ${fname(aux_str(x.aux))}(${args.join(", ")})"
  if g.inl.contains(aux_str(x.aux)) {
    c = "${c} #6"
  }
  let kept = g.kept_results(callee)
  let results = g.m.funcs[callee].results
  if kept.len() == results.len() {
    if g.kind(x.ty) == ssa.Kind.Unit {
      g.raise("", c)
      return
    }
    g.raise(vname(v), c)
    return
  }
  // rebuild the results the SSA call has: the `var` parameters passed by
  // reference are read back from their memory
  let r = g.tmp()
  g.raise(r, c)
  let full = g.full_res_ll(callee)
  var cur = "undef"
  var ki = 0
  let vps = g.m.funcs[callee].var_params
  for (k, rt) in results.indexed() {
    var y = ""
    if k > 0 && br[vps[k - 1]] {
      if g.lazy_result(v, k) {
        y = "undef" // read from memory where it is used (decision 0148)
      } else {
        y = g.load_ref(rt, slots[vps[k - 1]])
      }
    } else {
      if g.is_void(rt) {
        y = "zeroinitializer"
      } else if kept.len() == 1 {
        y = r
      } else {
        let rl2 = g.res_ll(callee)
        y = g.def("extractvalue ${rl2} ${r}, ${ki}")
      }
      ki += 1
    }
    let tl = g.ll(rt)
    cur = g.def("insertvalue ${full} ${cur}, ${tl} ${y}, ${k}")
  }
  g.alias(v, cur)
}

/// Whether the runtime call name (`rt.*`) can raise a fault
/// (ssa.RuntimeRaises).
fn runtime_raises(name: Str) -> Bool {
  ssa.faulting_rt(name) || name == "rt.fault_continue"
}

/// The address of the immortal empty list, which the program defines
/// once (a count of XO_RC_IMMORTAL, no elements).
fn (var g: Gen) empty_list() -> Str {
  g.placeholder("@xo_empty_list", "[3 x i64] [i64 -9223372036854775808, i64 0, i64 0]")
  "@xo_empty_list"
}

/// The address of the immortal zero handle ({XO_RC_IMMORTAL, no free
/// function}), defined once as the empty list.
fn (var g: Gen) zero_handle() -> Str {
  g.placeholder("@xo_zero_handle", "[2 x i64] [i64 -9223372036854775808, i64 0]")
  "@xo_zero_handle"
}

/// The LLVM name of the C level symbol name (rt.sym_addr, decision
/// 0234): xo_entry, which generate defines, or a symbol declared here
/// (a function of the C runtime), or the C library's data symbols the
/// module defines (ssa.nolibc_data). A C name is plain (an identifier), so
/// unquoted: the split build matches a reference to its definition by
/// the text (compiler/xo split.xo).
fn (var g: Gen) c_sym(name: Str) -> Str {
  let sym = "@${name}"
  if name != "xo_entry" && !(g.m.nolibc && ssa.nolibc_data().contains(name)) {
    g.llvm_decl(sym, "declare void ${sym}()")
  }
  sym
}

/// Defines the placeholder sym (its type and value) once per module:
/// linkonce_odr, as a split build (compiler/xo split.xo) copies a global
/// into every module that uses it, and the linker keeps one of them (and
/// of xo_rt.c's weak one, for code of earlier compilers).
fn (var g: Gen) placeholder(sym: Str, init: Str) {
  g.llvm_decl(sym, "${g.comdat_decl(sym)}${sym} = linkonce_odr hidden global ${init}${g.comdat()}, align 8")
}

/// The `$name = comdat any` line of global sym on Windows ("" elsewhere):
/// COFF folds the copies of a weak or linkonce_odr global that the
/// modules of a split build each define only through a comdat (lld-link:
/// "duplicate symbol", gotchas/windows-llvm-split-link.md); ELF and
/// Mach-O fold them by their linkage.
fn (g: Gen) comdat_decl(sym: Str) -> Str {
  if g.os() != "windows" {
    return ""
  }
  "\$${sym.trim_prefix("@")} = comdat any\n"
}

/// Whether the weak reference to the C symbol sym is an alternate name
/// (Windows, where it is then recorded for weak_alternates): COFF has no
/// extern_weak that links twice, each object's is a definition of the
/// symbol (lld-link: "duplicate symbol" when nothing defines it, as a
/// split build's modules do, gotchas/windows-llvm-split-link.md). The
/// symbol is declared plainly, `/alternatename:sym=xo_absent` makes an
/// undefined one xo_absent, and rt.sym_present compares its address
/// with xo_absent's: a zero sized type, so LLVM never folds the
/// comparison of the two globals.
fn (var g: Gen) weak_ref(sym: Str) -> Bool {
  if g.os() != "windows" {
    return false
  }
  if !g.weak_syms.contains(sym) {
    g.weak_syms.push(sym)
  }
  true
}

/// The linker options and xo_absent's definition (module asm, so a split
/// build defines it in its first module only) of weak_ref's symbols.
fn (g: Gen) weak_alternates() -> Str {
  if g.weak_syms.is_empty() {
    return ""
  }
  var opts: List[Str] = []
  for s in g.weak_syms {
    opts.push("!\"/alternatename:${s}=xo_absent\"")
  }
  var out = "!llvm.linker.options = !{!8}\n!8 = !{${opts.join(", ")}}\n"
  for l in [".data", ".globl xo_absent", "xo_absent:", ".byte 0", ".text"] {
    out = out + "module asm \"${l}\"\n"
  }
  out + "\n"
}

/// The `, comdat` of a global's definition on Windows ("" elsewhere).
fn (g: Gen) comdat() -> Str {
  if g.os() == "windows" { ", comdat" } else { "" }
}

/// Lowers the runtime intrinsics that are an instruction or two
/// (decision 0193 step 3): rt.int_wrap with a constant op (0 +, 1 -, 2
/// *, 3 << and 4 >> logical by the amount mod 64; decision 0195: 5
/// rotate right mod 64, 6 the low 32 bits rotated right mod 32 and zero
/// extended, 7 the bytes reversed), rt.u64_mul_hi (an i128 multiply), the
/// bits of a Float both ways, and rt.bytes_word (an unchecked load of 8
/// bytes);
/// the scan intrinsics of decision 0201:
/// rt.popcount, rt.ctz, rt.clz (llvm.ctpop, cttz, ctlz), and
/// rt.bytes_eq16 and rt.bytes_high16 (a <16 x i8> compare narrowed to 4
/// bits a byte, which arm64 selects as cmeq and shrn), and the string
/// writes of Bytes.to_hex: rt.rs_put_word (an unchecked store of 8 bytes
/// into a new string with room) and rt.rs_set_len (the same object with a
/// new length); whether v was one (fromssa.go inlineRT).
fn (var g: Gen) inline_rt(v: Int) -> Bool {
  let x = g.f.values[v]
  match aux_str(x.aux) {
    "rt.int_wrap" => {
      let c = g.f.values[x.args[0]]
      if c.op != ssa.Op.Const {
        return false
      }
      let op = match c.aux {
        I(n) => n
        _ => -1
      }
      if op < 0 || op > 7 {
        return false
      }
      let a = g.op(x.args[1])
      var b = g.op(x.args[2])
      if op == 5 {
        g.llvm_decl("@llvm.fshr.i64", "declare i64 @llvm.fshr.i64(i64, i64, i64)")
        g.set(v, "call i64 @llvm.fshr.i64(i64 ${a}, i64 ${a}, i64 ${b})")
        return true
      }
      if op == 6 {
        g.llvm_decl("@llvm.fshr.i32", "declare i32 @llvm.fshr.i32(i32, i32, i32)")
        let x32 = g.def("trunc i64 ${a} to i32")
        let n32 = g.def("trunc i64 ${b} to i32")
        g.set(v, "zext i32 ${g.def("call i32 @llvm.fshr.i32(i32 ${x32}, i32 ${x32}, i32 ${n32})")} to i64")
        return true
      }
      if op == 7 {
        g.llvm_decl("@llvm.bswap.i64", "declare i64 @llvm.bswap.i64(i64)")
        g.set(v, "call i64 @llvm.bswap.i64(i64 ${a})")
        return true
      }
      if op >= 3 {
        b = g.def("and i64 ${b}, 63")
      }
      g.set(v, "${["add", "sub", "mul", "shl", "lshr"][op]} i64 ${a}, ${b}")
    }
    // decision 0222: a value barrier, as BoringSSL's value_barrier_w: an
    // empty asm the optimizer cannot see through, with no side effect
    // (it may still be merged or dropped when unused)
    "rt.ct_barrier" => g.set(v, "call i64 asm \"\", \"=r,0\"(i64 ${g.op(x.args[0])})")
    // ssa show.xo u64_div_const: a UInt64 by a constant
    "rt.u64_divc" => {
      let rem = match g.f.values[x.args[2]].aux {
        I(n) => n == 1
        _ => false
      }
      g.set(v, "${if rem { "urem" } else { "udiv" }} i64 ${g.op(x.args[0])}, ${g.op(x.args[1])}")
    }
    "rt.u64_mul_hi" => {
      let a = g.def("zext i64 ${g.op(x.args[0])} to i128")
      let b = g.def("zext i64 ${g.op(x.args[1])} to i128")
      let p = g.def("mul i128 ${a}, ${b}")
      g.set(v, "trunc i128 ${g.def("lshr i128 ${p}, 64")} to i64")
    }
    // cpu.mul_hi_signed (2026-10-21): a sign extended i128 multiply
    "rt.i64_mul_hi" => {
      let a = g.def("sext i64 ${g.op(x.args[0])} to i128")
      let b = g.def("sext i64 ${g.op(x.args[1])} to i128")
      let p = g.def("mul i128 ${a}, ${b}")
      g.set(v, "trunc i128 ${g.def("ashr i128 ${p}, 64")} to i64")
    }
    // decision 0231: the carry out of a + b and the borrow out of a - b
    // (std/native/llrt/cpu.xo), which arm64 selects as adds/adcs chains
    "rt.u64_carry" | "rt.u64_borrow" => {
      let f = if aux_str(x.aux) == "rt.u64_carry" { "uadd" } else { "usub" }
      g.llvm_decl("@llvm.${f}.with.overflow.i64", "declare {i64, i1} @llvm.${f}.with.overflow.i64(i64, i64)")
      let r = g.def("call {i64, i1} @llvm.${f}.with.overflow.i64(i64 ${g.op(x.args[0])}, i64 ${g.op(x.args[1])})")
      g.set(v, "zext i1 ${g.def("extractvalue {i64, i1} ${r}, 1")} to i64")
    }
    // decision 0231's addendum: x + y + cin and its carry as one chain
    // of llvm.uadd.with.overflow (both values from the same calls, which
    // LLVM merges and turns into adds/adcs)
    "rt.u64_adc" | "rt.u64_adc_carry" => {
      g.llvm_decl("@llvm.uadd.with.overflow.i64", "declare {i64, i1} @llvm.uadd.with.overflow.i64(i64, i64)")
      let r1 = g.def("call {i64, i1} @llvm.uadd.with.overflow.i64(i64 ${g.op(x.args[0])}, i64 ${g.op(x.args[1])})")
      let s1 = g.def("extractvalue {i64, i1} ${r1}, 0")
      let r2 = g.def("call {i64, i1} @llvm.uadd.with.overflow.i64(i64 ${s1}, i64 ${g.op(x.args[2])})")
      if aux_str(x.aux) == "rt.u64_adc" {
        g.set(v, "extractvalue {i64, i1} ${r2}, 0")
      } else {
        let c1 = g.def("extractvalue {i64, i1} ${r1}, 1")
        let c2 = g.def("extractvalue {i64, i1} ${r2}, 1")
        g.set(v, "zext i1 ${g.def("or i1 ${c1}, ${c2}")} to i64")
      }
    }
    // decision 0231: the carry-less product's halves and the AES rounds
    // (cpu.xo, run only when cpu.hw() has them) as inline asm, so no
    // target feature is needed on the function; a pure asm, so the two
    // halves of one product share the instruction
    "rt.clmul_lo" | "rt.clmul_hi" => {
      let a = g.def("insertelement <2 x i64> undef, i64 ${g.op(x.args[0])}, i32 0")
      let b = g.def("insertelement <2 x i64> undef, i64 ${g.op(x.args[1])}, i32 0")
      let asm = if g.arch() == "amd64" { "asm \"pclmulqdq $$0, $2, $0\", \"=x,0,x\"" } else { "asm \".arch_extension crypto\\0Apmull $0.1q, $1.1d, $2.1d\", \"=w,w,w\"" }
      let r = g.def("call <2 x i64> ${asm}(<2 x i64> ${a}, <2 x i64> ${b})")
      g.set(v, "extractelement <2 x i64> ${r}, i32 ${if aux_str(x.aux) == "rt.clmul_lo" { 0 } else { 1 }}")
    }
    // decision 0231 addendum: arm64's crc32x as inline asm (no target
    // feature on the function); the w result is zero extended
    "rt.crc32x" => {
      g.set(v, "call i64 asm \".arch_extension crc\\0Acrc32x \${0:w}, \${1:w}, $2\", \"=r,r,r\"(i64 ${g.op(x.args[0])}, i64 ${g.op(x.args[1])})")
    }
    "rt.crc32cx" => {
      if g.arch() == "amd64" {
        g.set(v, "call i64 asm \"crc32q $2, $0\", \"=r,0,r\"(i64 ${g.op(x.args[0])}, i64 ${g.op(x.args[1])})")
      } else {
        g.set(v, "call i64 asm \".arch_extension crc\\0Acrc32cx \${0:w}, \${1:w}, $2\", \"=r,r,r\"(i64 ${g.op(x.args[0])}, i64 ${g.op(x.args[1])})")
      }
    }
    "rt.chacha_blocks4" => g.chacha4(g.raw_ptr(x.args[0]), g.raw_ptr(x.args[1]), g.raw_ptr(x.args[2]))
    "rt.ghash4" => {
      // arm64 only (ssa cpu_call, decision 0339): ssa.ghash4_neon_lines
      // as inline asm, its V registers clobbered
      var t = [".arch_extension crypto"]
      for l in ssa.ghash4_neon_lines("$0", "$1", "$2") {
        t.push(l)
      }
      var clob = "r,r,r"
      for r in ssa.ghash4_neon_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])})")
    }
    "rt.aes_gcm_enc10" | "rt.aes_gcm_enc12" | "rt.aes_gcm_enc14" | "rt.aes_gcm_dec10" | "rt.aes_gcm_dec12" | "rt.aes_gcm_dec14" => {
      // arm64 only (ssa call.xo): ssa.aes_gcm_lines as inline asm, x9 to
      // x11 and its V registers clobbered (d8, d9 restored by it)
      let name = aux_str(x.aux)
      let nr = Int.parse(name[name.len() - 2..name.len()]) ?? 10
      var t = [".arch_extension crypto"]
      for l in ssa.aes_gcm_lines(nr, name.contains("enc"), "$0", "$1", "$2", "$3", "$4", "$5", "$6", "x9", "x10", "x11") {
        t.push(l)
      }
      var clob = "r,r,r,r,r,r,r,~{x9},~{x10},~{x11}"
      for r in ssa.aes_gcm_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{cc}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, ptr ${g.raw_ptr(x.args[3])}, i64 ${g.op(x.args[4])}, ptr ${g.raw_ptr(x.args[5])}, ptr ${g.raw_ptr(x.args[6])})")
    }
    "rt.aes_gcm8_enc10" | "rt.aes_gcm8_enc12" | "rt.aes_gcm8_enc14" | "rt.aes_gcm8_dec10" | "rt.aes_gcm8_dec12" | "rt.aes_gcm8_dec14" if g.arch() == "amd64" => {
      // ssa.aes_gcm8_x86_lines as inline asm (AT&T: its immediates' `$`
      // doubled), its registers clobbered
      let name = aux_str(x.aux)
      let nr = Int.parse(name[name.len() - 2..name.len()]) ?? 10
      var t: List[Str] = []
      for l in ssa.aes_gcm8_x86_lines(nr, name.contains("enc"), "@0@", "@1@", "@2@", "@3@", "@4@", "@5@", "@6@") {
        t.push(l.replace("$", "$$").replace("@0@", "$0").replace("@1@", "$1").replace("@2@", "$2").replace("@3@", "$3").replace("@4@", "$4").replace("@5@", "$5").replace("@6@", "$6"))
      }
      var clob = "r,r,r,r,r,r,r"
      for r in ssa.aes_gcm8_x86_gprs() {
        clob = clob + ",~{${r}}"
      }
      for r in ssa.aes_gcm8_x86_xmms() {
        clob = clob + ",~{xmm${r}}"
      }
      clob = clob + ",~{memory},~{dirflag},~{fpsr},~{flags}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, ptr ${g.raw_ptr(x.args[3])}, i64 ${g.op(x.args[4])}, ptr ${g.raw_ptr(x.args[5])}, ptr ${g.raw_ptr(x.args[6])})")
    }
    "rt.aes_gcm8_enc10" | "rt.aes_gcm8_enc12" | "rt.aes_gcm8_enc14" | "rt.aes_gcm8_dec10" | "rt.aes_gcm8_dec12" | "rt.aes_gcm8_dec14" => {
      // arm64 only (ssa call.xo): ssa.aes_gcm8_lines as inline asm, x9 to
      // x11 and its V registers clobbered (d8 to d15 restored by it)
      let name = aux_str(x.aux)
      let nr = Int.parse(name[name.len() - 2..name.len()]) ?? 10
      var t = [".arch_extension crypto"]
      for l in ssa.aes_gcm8_lines(nr, name.contains("enc"), "$0", "$1", "$2", "$3", "$4", "$5", "$6", "x9", "x10", "x11") {
        t.push(l)
      }
      var clob = "r,r,r,r,r,r,r,~{x9},~{x10},~{x11}"
      for r in ssa.aes_gcm8_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{cc}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, ptr ${g.raw_ptr(x.args[3])}, i64 ${g.op(x.args[4])}, ptr ${g.raw_ptr(x.args[5])}, ptr ${g.raw_ptr(x.args[6])})")
    }
    "rt.keccak_f1600" => {
      // arm64 only (ssa call.xo): ssa.keccak_neon_lines as inline asm, x9
      // and x10 and its V registers clobbered (d8 to d15 restored by it)
      var t = [".arch_extension sha3"]
      for l in ssa.keccak_neon_lines("$0", "$1", "x9", "x10") {
        t.push(l)
      }
      var clob = "r,r,~{x9},~{x10}"
      for r in ssa.keccak_neon_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{cc}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])})")
    }
    "rt.aes_ctr10" | "rt.aes_ctr12" | "rt.aes_ctr14" => {
      // arm64 only (ssa call.xo): ssa.aes_ctr_lines as inline asm, x9 to
      // x11 and its V registers clobbered
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_ctr")) ?? 10
      var t = [".arch_extension crypto"]
      for l in ssa.aes_ctr_lines(nr, "$0", "$1", "$2", "$3", "$4", "x9", "x10", "x11") {
        t.push(l)
      }
      var clob = "r,r,r,r,r,~{x9},~{x10},~{x11}"
      for r in ssa.aes_ctr_vregs() {
        clob = clob + ",~{q${r}}"
      }
      clob = clob + ",~{memory},~{cc}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, ptr ${g.raw_ptr(x.args[3])}, i64 ${g.op(x.args[4])})")
    }
    "rt.ticks" => g.set(v, "call i64 asm sideeffect \"mrs $0, cntvct_el0\", \"=r\"()")
    "rt.ticks_hz" => g.set(v, "call i64 asm sideeffect \"mrs $0, cntfrq_el0\", \"=r\"()")
    "rt.chacha_poly_seal4" | "rt.chacha_poly_open4" | "rt.chacha_poly_seal8" | "rt.chacha_poly_open8" => {
      // amd64 only (ssa call.xo): ssa.chacha_poly4_x86_lines as inline
      // asm (AT&T: its immediates' `$` doubled); rbx and r12 to r15 it
      // saves itself, the rest clobbered
      var t: List[Str] = []
      let nm = aux_str(x.aux)
      let ls = if nm.ends_with("8") { ssa.chacha_poly8_avx2_lines(nm == "rt.chacha_poly_seal8", "@0@", "@1@", "@2@", "@3@", "@4@") } else { ssa.chacha_poly4_x86_lines(nm == "rt.chacha_poly_seal4", "@0@", "@1@", "@2@", "@3@", "@4@") }
      for l in ls {
        t.push(l.replace("$", "$$").replace("@0@", "$0").replace("@1@", "$1").replace("@2@", "$2").replace("@3@", "$3").replace("@4@", "$4"))
      }
      var clob = "r,r,r,r,r"
      for r in ssa.chacha_poly4_x86_gprs() {
        clob = clob + ",~{${r}}"
      }
      clob = clob + ",~{r11}"
      for r in ssa.chacha4_x86_xmms() {
        clob = clob + ",~{xmm${r}}"
      }
      if nm.ends_with("8") {
        // the AVX2 kernel's ymm registers past the xmm list
        clob = clob + ",~{ymm0},~{ymm1},~{ymm2},~{ymm3},~{ymm4},~{ymm5},~{ymm6},~{ymm7},~{ymm8},~{ymm9},~{ymm12},~{ymm13}"
      }
      clob = clob + ",~{memory},~{dirflag},~{fpsr},~{flags}"
      g.emit("call void asm sideeffect \"${t.join("\\0A")}\", \"${clob}\"(ptr ${g.raw_ptr(x.args[0])}, ptr ${g.raw_ptr(x.args[1])}, ptr ${g.raw_ptr(x.args[2])}, i64 ${g.op(x.args[3])}, ptr ${g.raw_ptr(x.args[4])})")
