// Values kept in the memory of a `var` parameter passed by reference
// (held.go, decision 0148): stage 3 of decision 0166.
//
// A `var` parameter passed by reference (decision 0145) arrives in the
// caller's memory, which the function also uses as the slot of every call
// that takes a value of that type by reference (its home) and writes back
// at return. A forward dataflow over the function computes which SSA
// value that memory holds before each instruction; then a field read of a
// held value loads the field, a `setfield` of it stores in place, a store
// of the held value into its own memory is left out, and a value held at
// every use is never materialized (a use loads it).

use github.com/xo-lang/xo/compiler/ssa

/// A tracked memory: the pointer of a `var` parameter passed by
/// reference that is the home of its LLVM type.
struct HeldMem {
  ptr: Str
  lt: Str
  param: Int
}

/// The value a memory holds (hkey): value v, or result k of call v (the
/// `var` parameter it wrote back; -1: v itself). v is -1 with k -2 for
/// "not reached yet" (TOP) and -3 for "unknown" (BOT).
struct HKey {
  v: Int
  k: Int
}

const TOP_K = -2
const BOT_K = -3

/// What the memories hold (heldInfo): the state before each instruction,
/// at each block's start, and on each edge (empty: not reached), the
/// setfields done in memory, and the values never materialized, by
/// memory index (-1: none).
struct Held {
  mems: List[HeldMem] = []
  before: List[List[HKey]] = []
  ins: List[List[HKey]] = []
  edge: List[List[HKey]] = []
  in_place: List[Int] = []
  mem_only: List[Int] = []
  changed: Bool = false
  /// field homes (decision 0490 on LLVM): a `var` argument (call, index)
  /// that is field idx of value u held in memory m, passed at the
  /// field's address there: (m, u, idx); after the call the memory holds
  /// u with that field rewritten, the key HKey{v: call, k: -10 - index}
  fslot: Map[(Int, Int), (Int, Int, Int)] = {}
  /// the setfields storing such a result back, done by the callee: the
  /// memory
  fdone: Map[Int, Int] = {}
}

fn top_key() -> HKey {
  HKey{v: -1, k: TOP_K}
}

fn bot_key() -> HKey {
  HKey{v: -1, k: BOT_K}
}

/// The key of value v (keyOf).
fn (var g: Gen) key_of(v: Int) -> HKey {
  let x = g.f.values[v]
  if x.op == ssa.Op.Field && g.f.values[x.args[0]].op == ssa.Op.Call {
    return HKey{v: x.args[0], k: aux_int(x.aux)}
  }
  HKey{v: v, k: -1}
}

/// The tracked memory of LLVM type lt, or -1 (memOf).
fn (var g: Gen) mem_of(lt: Str) -> Int {
  for (i, m) in g.held.mems.indexed() {
    if m.lt == lt {
      return i
    }
  }
  -1
}

/// The memory that holds u before instruction v, or -1 (heldAt).
fn (var g: Gen) held_at(v: Int, u: Int) -> Int {
  if !g.has_held {
    return -1
  }
  if g.held.before[v].is_empty() {
    return -1
  }
  let m = g.mem_of(g.ll(g.vty(u)))
  if m >= 0 && g.held.before[v][m] == g.key_of(u) {
    return m
  }
  -1
}

/// For each argument of call v to callee, the tracked memory it is
/// stored into (-1 for none), as user_call lowers it (slotMems).
fn (var g: Gen) slot_mems(v: Int, callee: Int) -> List[Int] {
  let br = g.by_ref_of(callee)
  let args = g.f.values[v].args
  var out: List[Int] = []
  var used: List[Str] = []
  for (i, x) in args.indexed() {
    out.push(-1)
    if br.is_empty() || !br[i] {
      continue
    }
    if g.stable(x) && !g.is_var_param(callee, i) {
      continue
    }
    let lt = g.ll(g.vty(x))
    if used.contains(lt) {
      continue
    }
    used.push(lt)
    out[i] = g.mem_of(lt)
  }
  out
}

/// Whether v sits in memory nothing writes during the call (sfn.addr,
/// decision 0147), computed before lowering (stable).
fn (var g: Gen) stable(v: Int) -> Bool {
  let memo = g.stable_memo[v]
  if memo >= 0 {
    return memo == 1
  }
  var r = false
  let x = g.f.values[v]
  match x.op {
    Param => {
      if g.blk[v] == 0 {
        let br = g.by_ref_of(g.fi)
        for (i, p) in g.f.blocks[0].params.indexed() {
          if p == v && !br.is_empty() && br[i] && !g.is_var_param(g.fi, i) {
            r = true
          }
        }
      }
    }
    Payload | Field => r = g.is_agg(ssa.ty_of(x.tb)) && g.stable(x.args[0])
    Unbox => r = g.is_agg(ssa.ty_of(x.tb)) && g.root_borrowed(x.args[0])
    Call => {
      if aux_str(x.aux) == "list.index" {
        r = g.is_agg(ssa.ty_of(x.tb)) && g.kind(ssa.ty_of(x.tb)) != ssa.Kind.Unit && g.root_borrowed(x.args[0])
      }
    }
    _ => {}
  }
  g.stable_memo[v] = if r { 1 } else { 0 }
  r
}

/// List element homes (decision 0498): a `var` argument passed by
/// reference that is an element taken out of a list (`f(c.items[i])`:
/// `t = list.take(l, i)`, the call, then `list.set(t.0, i, the new
/// element)`, with decision 0488's ShareIn before it) is passed at its
/// slot in the list, which the take made unique (decision 0169's
/// reuse), instead of copied to a slot and back: the take loads nothing
/// and leaves no hole, and the store back (and its ShareIn, which a
/// unique list never takes) is the callee's own. The taken list may
/// also be released by a fault's cleanup, with the element in place.
fn (var g: Gen) find_take_args() {
  g.take_arg = {}
  g.take_ptr = {}
  g.take_skip = {}
  for v in 0..g.f.values.len() {
    let x = g.f.values[v]
    if x.op != ssa.Op.Call {
      continue
    }
    let callee = g.by_name.get(aux_str(x.aux)) ?? -1
    if callee < 0 {
      continue
    }
    let br = g.by_ref_of(callee)
    if br.is_empty() {
      continue
    }
    let sm = g.slot_mems(v, callee)
    for (i, a) in x.args.indexed() {
      if !br[i] || sm[i] >= 0 || !g.is_var_param(callee, i) || g.f.values[a].op != ssa.Op.Field || aux_int(g.f.values[a].aux) != 1 || g.users(a) != [v] {
        continue
      }
      let t = g.f.values[a].args[0]
      let tx = g.f.values[t]
      if tx.op != ssa.Op.Call || aux_str(tx.aux) != "list.take" || g.take_ptr.contains(t) {
        continue
      }
      let skip = g.take_store(t, v, callee, i)
      if skip.is_empty() {
        continue
      }
      g.take_arg[(v, i)] = t
      g.take_ptr[t] = ""
      for s in skip {
        g.take_skip[s] = true
      }
    }
  }
}

/// The list.set storing back, at the slot take t emptied, the new value
/// of `var` argument i of call v (and the ShareIn before it), when they
/// are that value's only uses and the taken list's only other uses are
/// releases (else empty).
fn (var g: Gen) take_store(t: Int, v: Int, callee: Int, i: Int) -> List[Int] {
  var k = -1
  for (j, vi) in g.m.funcs[callee].var_params.indexed() {
    if vi == i {
      k = 1 + j
    }
  }
  if k < 0 {
    return []
  }
  var r = -1
  for u in g.users(v) {
    let ux = g.f.values[u]
    if ux.op == ssa.Op.Field && aux_int(ux.aux) == k {
      if r >= 0 {
        return []
      }
      r = u
    }
  }
  if r < 0 {
    return []
  }
  var set = -1
  var share = -1
  for u in g.users(r) {
    let ux = g.f.values[u]
    if ux.op == ssa.Op.Call && aux_str(ux.aux) == "list.set" && ux.args.len() == 3 && ux.args[1] == g.f.values[t].args[1] && ux.args[2] == r && set < 0 {
      set = u
    } else if ux.op == ssa.Op.ShareIn && ux.args[1] == r && share < 0 {
      share = u
    } else {
      return []
    }
  }
  if set < 0 {
    return []
  }
  // every read of the taken list (the store's, a fault's cleanup's) is
  // only stored into or released
  for u in g.users(t) {
    let ux = g.f.values[u]
    if ux.op != ssa.Op.Field {
      return []
    }
    if aux_int(ux.aux) != 0 {
      continue
    }
    for w in g.users(u) {
      if w != set && w != share && g.f.values[w].op != ssa.Op.Release {
        return []
      }
    }
  }
  let sl = g.f.values[g.f.values[set].args[0]]
  if sl.op != ssa.Op.Field || sl.args[0] != t || (share >= 0 && g.f.values[share].args[0] != g.f.values[set].args[0]) {
    return []
  }
  if share >= 0 {
    return [set, share]
  }
  [set]
}

/// Whether setfield v stores back the result of the field home that key
/// k says its memory holds: the same base, field and the call's result
/// for that argument (the callee already wrote it there).
fn (var g: Gen) field_store_done(v: Int, k: HKey) -> Bool {
  if k.v < 0 || k.k > -10 {
    return false
  }
  let i = -10 - k.k
  let (_m, u, idx) = match g.held.fslot.get((k.v, i)) {
    Some(s) => s
    None => return false
  }
  let x = g.f.values[v]
  if x.args[0] != u || aux_int(x.aux) != idx {
    return false
  }
  let r = g.f.values[x.args[1]]
  r.op == ssa.Op.Field && r.args[0] == k.v && aux_int(r.aux) == g.var_result(k.v, i)
}

/// The result index of call v's `var` argument i (-1: not a `var` one).
fn (var g: Gen) var_result(v: Int, i: Int) -> Int {
  let callee = g.by_name.get(aux_str(g.f.values[v].aux)) ?? -1
  if callee < 0 {
    return -1
  }
  for (j, vi) in g.m.funcs[callee].var_params.indexed() {
    if vi == i {
      return 1 + j
    }
  }
  -1
}

/// Whether instruction v reads value a while the memory holding a has a
/// field home's call result in another field: a read of a field other
/// than the one the call wrote (the same as a's), or the setfield that
/// stores that result back.
fn (var g: Gen) field_home_read(v: Int, a: Int, k: HKey) -> Bool {
  if k.v < 0 || k.k > -10 {
    return false
  }
  let (_m, u, idx) = match g.held.fslot.get((k.v, -10 - k.k)) {
    Some(s) => s
    None => return false
  }
  if u != a {
    return false
  }
  let x = g.f.values[v]
  if x.op == ssa.Op.Field {
    return aux_int(x.aux) != idx
  }
  g.held.fdone.contains(v)
}

/// Whether result k of call v is read only by setfields a field home
/// made the callee's (fdone).
fn (var g: Gen) res_only_stored(v: Int, k: Int) -> Bool {
  for u in g.users(v) {
    let x = g.f.values[u]
    if x.op != ssa.Op.Field {
      return false
    }
    if aux_int(x.aux) != k {
      continue
    }
    for w in g.users(u) {
      if !g.held.fdone.contains(w) {
        return false
      }
    }
  }
  true
}

/// Runs the dataflow for the current function (computeHeld); nothing
/// when it has no tracked memory.
fn (var g: Gen) compute_held(mems: List[HeldMem]) {
  if mems.is_empty() {
    return
  }
  let nv = g.f.values.len()
  var h = Held{mems: mems}
  for _ in 0..nv {
    h.before.push([])
    h.in_place.push(-1)
    h.mem_only.push(-1)
  }
  for _ in 0..g.f.blocks.len() {
    h.ins.push([])
  }
  for _ in 0..g.f.edges.len() {
    h.edge.push([])
  }
  g.held = h
  g.has_held = true
  // the pad state of each landing, by the landing's value
  var landed: Map[Int, List[HKey]] = {}
  let order = g.reverse_postorder()
  var changed = true
  while changed {
    changed = false
    for b in order {
      var st = g.held_in(b)
      let old = g.held.ins[b]
      if old.is_empty() || old != st {
        g.held.ins[b] = st
        changed = true
      }
      for v in g.f.blocks[b].instrs {
        g.held.before[v] = st
        var pad = st
        var pad_own = false
        let x = g.f.values[v]
        match x.op {
          Call => {
            let callee = g.by_name.get(aux_str(x.aux)) ?? -1
            if callee >= 0 {
              let sm = g.slot_mems(v, callee)
              for (i, m) in sm.indexed() {
                if m >= 0 {
                  st[m] = g.key_of(x.args[i])
                }
              }
              // a `var` argument that is a field of a value held in a
              // memory no other argument is stored into is passed at the
              // field's address there (field homes)
              var fs: List[(Int, Int)] = []
              let cb = g.by_ref_of(callee)
              for (i, a) in x.args.indexed() {
                // the dataflow runs to a fixed point: a pass decides again
                g.held.fslot.remove((v, i))
                if cb.is_empty() || !cb[i] || sm[i] >= 0 || !g.is_var_param(callee, i) || g.f.values[a].op != ssa.Op.Field {
                  continue
                }
                let u = g.f.values[a].args[0]
                let m = g.mem_of(g.ll(g.vty(u)))
                if m < 0 || sm.contains(m) || st[m] != g.key_of(u) || fs.any(fn(p) { p.0 == m }) {
                  continue
                }
                g.held.fslot[(v, i)] = (m, u, aux_int(g.f.values[a].aux))
                fs.push((m, i))
              }
              for (m, i) in fs {
                st[m] = HKey{v: v, k: -10 - i}
              }
              pad = st
              pad_own = true
              for (m, _i) in fs {
                pad[m] = bot_key()
              }
              for (i, m) in sm.indexed() {
                if m >= 0 && g.is_var_param(callee, i) {
                  pad[m] = bot_key()
                  for (j, vi) in g.m.funcs[callee].var_params.indexed() {
                    if vi == i {
                      st[m] = HKey{v: v, k: 1 + j}
                    }
                  }
                }
              }
            }
          }
          SetField => {
            g.held.fdone.remove(v)
            let u = x.args[0]
            let m = g.mem_of(g.ll(g.vty(u)))
            if m >= 0 && st[m] == g.key_of(u) {
              g.held.in_place[v] = m
              st[m] = HKey{v: v, k: -1}
            } else if m >= 0 && g.field_store_done(v, st[m]) {
              g.held.in_place[v] = m
              g.held.fdone[v] = m
              st[m] = HKey{v: v, k: -1}
            }
          }
          Jump => g.set_edge(x.succs[0], st)
          Branch => {
            let l = x.args[0]
            let lx = g.f.values[l]
            if lx.op == ssa.Op.Call && aux_str(lx.aux) == "rt.landing" {
              if let Some(ps) = landed.get(l) {
                g.set_edge(x.succs[0], ps)
              } else {
                g.set_edge(x.succs[0], st)
              }
              g.set_edge(x.succs[1], st)
            } else {
              g.set_edge(x.succs[0], st)
              g.set_edge(x.succs[1], st)
            }
          }
          _ => {}
        }
        if ssa.pad_of(x.pi) >= 0 {
          // the Go code's pad shares st's memory unless a call copied it
          landed[ssa.pad_of(x.pi)] = if pad_own { pad } else { st }
        }
      }
      if g.held.changed {
        changed = true
        g.held.changed = false
      }
    }
  }
  g.find_mem_only()
}

fn (var g: Gen) set_edge(e: Int, st: List[HKey]) {
  let old = g.held.edge[e]
  if !old.is_empty() && old == st {
    return
  }
  g.held.edge[e] = st
  g.held.changed = true
}

/// The state at the start of block b (heldIn): the parameter's own key
/// in the entry block; else, per memory, the block parameter every
/// incoming edge passes in place, or the key every edge agrees on.
fn (var g: Gen) held_in(b: Int) -> List[HKey] {
  let n = g.held.mems.len()
  var st: List[HKey] = []
  for _ in 0..n {
    st.push(top_key())
  }
  if b == 0 {
    for i in 0..n {
      st[i] = g.key_of(g.held.mems[i].param)
    }
    return st
  }
  for i in 0..n {
    let lt = g.held.mems[i].lt
    var states: List[Int] = []
    for e in g.f.blocks[b].preds {
      let es = g.held.edge[e]
      if !es.is_empty() && es[i] != top_key() {
        states.push(e)
      }
    }
    if states.is_empty() {
      continue
    }
    var found = false
    for (pi, p) in g.f.blocks[b].params.indexed() {
      if g.ll(g.vty(p)) != lt {
        continue
      }
      var all = true
      for e in states {
        if g.held.edge[e][i] != g.key_of(g.f.edges[e].args[pi]) {
          all = false
        }
      }
      if all {
        st[i] = HKey{v: p, k: -1}
        found = true
        break
      }
    }
    if found {
      continue
    }
    var k = g.held.edge[states[0]][i]
    for e in states {
      if g.held.edge[e][i] != k {
        k = bot_key()
      }
    }
    st[i] = k
  }
  st
}

/// Marks the values held in a memory at every use (findMemOnly): the
/// parameter, values updated in place, `var` results of calls, and block
/// parameters passed in place.
fn (var g: Gen) find_mem_only() {
  let nv = g.f.values.len()
  var cands: List[Int] = []
  for _ in 0..nv {
    cands.push(-1)
  }
  for (i, m) in g.held.mems.indexed() {
    cands[m.param] = i
  }
  for v in 0..nv {
    if g.held.in_place[v] >= 0 {
      cands[v] = g.held.in_place[v]
    }
  }
  for b in 0..g.f.blocks.len() {
    let st = g.held.ins[b]
    if !st.is_empty() && b != 0 {
      for (i, k) in st.indexed() {
        if k.k == -1 && k.v >= 0 && g.f.values[k.v].op == ssa.Op.Param && g.blk[k.v] == b {
          cands[k.v] = i
        }
      }
    }
    for v in g.f.blocks[b].instrs {
      let x = g.f.values[v]
      if x.op == ssa.Op.Field && g.f.values[x.args[0]].op == ssa.Op.Call {
        let m = g.mem_of(g.ll(ssa.ty_of(x.tb)))
        if m >= 0 {
          cands[v] = m
        }
      }
    }
  }
  var bad: List[Bool] = []
  for _ in 0..nv {
    bad.push(false)
  }
  for b in 0..g.f.blocks.len() {
    for v in g.f.blocks[b].instrs {
      let x = g.f.values[v]
      for a in x.args {
        let m = cands[a]
        if m < 0 {
          continue
        }
        let st = g.held.before[v]
        if st.is_empty() || (st[m] != g.key_of(a) && !g.field_home_read(v, a, st[m])) {
          bad[a] = true
        }
      }
      for e in x.succs {
        let to = g.f.edges[e].to
        for (pi, a) in g.f.edges[e].args.indexed() {
          let m = cands[a]
          if m < 0 {
            continue
          }
          let es = g.held.edge[e]
          let inb = g.held.ins[to]
          if es.is_empty() || inb.is_empty() || es[m] != g.key_of(a) || inb[m] != (HKey{v: g.f.blocks[to].params[pi], k: -1}) {
            bad[a] = true
          }
        }
      }
    }
  }
  for v in 0..nv {
    if cands[v] >= 0 && !bad[v] {
      g.held.mem_only[v] = cands[v]
    }
  }
}

/// The memory value v is held in at every use, or -1 (memOnly).
fn (var g: Gen) mem_only(v: Int) -> Int {
  if !g.has_held {
    return -1
  }
  g.held.mem_only[v]
}

/// The memory that holds block parameter p of b at the block's start
/// because every edge passes it in place, or -1 (heldParam).
fn (var g: Gen) held_param(b: Int, p: Int) -> Int {
  if !g.has_held || b == 0 {
    return -1
  }
  let st = g.held.ins[b]
  for (i, k) in st.indexed() {
    if k.v == p && k.k == -1 {
      return i
    }
  }
  -1
}

/// Whether result k of call v (a `var` parameter the callee wrote back
/// into a tracked memory) needs no load after the call (lazyResult): the
/// call is only read by field reads, and those of result k are held at
/// every use.
fn (var g: Gen) lazy_result(v: Int, k: Int) -> Bool {
  if !g.has_held {
    return false
  }
  for u in g.users(v) {
    let x = g.f.values[u]
    if x.op != ssa.Op.Field {
      return false
    }
    if aux_int(x.aux) == k && g.mem_only(u) < 0 {
      return false
    }
  }
  true
}

/// The instructions and terminators (for their edges) that use v
/// (users).
fn (var g: Gen) users(v: Int) -> List[Int] {
  if !g.users_done {
    g.users_done = true
    g.users_of = []
    for _ in 0..g.f.values.len() {
      g.users_of.push([])
    }
    for b in 0..g.f.blocks.len() {
      for x in g.f.blocks[b].instrs {
        for a in g.f.values[x].args {
          g.users_of[a].push(x)
        }
        for e in g.f.values[x].succs {
          for a in g.f.edges[e].args {
            g.users_of[a].push(x)
          }
        }
      }
    }
  }
  g.users_of[v]
}
