// A fiber's outermost frame (xo_fiber_entry) ends a fault's unwind: on
// ELF targets its entry has the return address undefined. Without it on
// linux/amd64 the unwinder read the word past the fiber's stack and a
// fault crashed with SIGSEGV instead of exit 70 (2026-11-12).

test "the fiber entry's return address is undefined on ELF targets and darwin/amd64" {
  let (_, la) = switch_asm("linux", "amd64")
  expect(la.contains(".cfi_escape 0x07, 16")) == true
  let (_, fa) = switch_asm("freebsd", "amd64")
  expect(fa.contains(".cfi_escape 0x07, 16")) == true
  let (_, l64) = switch_asm("linux", "arm64")
  expect(l64.contains(".cfi_escape 0x07, 30")) == true
  // darwin/amd64 too: ld64 keeps xo_fiber_entry's DWARF entry (compact
  // mode 4), whose return address lay one word past the fiber's stack, so
  // xo dump's walk died of SIGBUS on the Intel Mac (task #649)
  let (_, da) = switch_asm("darwin", "amd64")
  expect(da.contains(".cfi_escape 0x07, 16")) == true
  // darwin/arm64 and Windows unwind by their own tables
  let (_, d64) = switch_asm("darwin", "arm64")
  expect(d64.contains(".cfi_escape 0x07, 30")) == false
  let (_, wa) = switch_asm("windows", "amd64")
  expect(wa.contains(".cfi_escape 0x07, 16")) == false
}

// pool.xo win_kick names xo_async_stub on every Windows target; an LLVM
// build on windows/arm64 defined it nowhere and failed to link (undefined
// xo_async_stub, 33 cmd/xo tests on the winarm VM, task #605, 2026-11-21).
test "the asynchronous preemption stub is defined on both Windows arches" {
  expect(async_stub_asm("windows", "amd64").contains("xo_async_stub:")) == true
  let a = async_stub_asm("windows", "arm64")
  expect(a.contains("xo_async_stub:")) == true
  expect(a.contains("brk #1")) == true
  expect(async_stub_asm("linux", "arm64")) == ""
}
