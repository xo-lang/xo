// DWARF line tables (decision 0239): with the module's debug_info, a
// compile unit (line tables only), a file per source, a subprogram per
// function with a source file, and on every instruction of such a
// function its statement's line (ssa Value.line) as an inline
// DILocation; clang writes the sections. The compile unit, files, and
// subprograms are numbered metadata in the module's tail (every part of
// a split build gets them, split.xo); the locations stay inline, so the
// shared header does not grow with the code.

/// Makes the compile unit (generate, before the functions).
fn (var g: Gen) debug_unit() {
  if !g.m.debug_info {
    return
  }
  let dir = if g.m.comp_dir.is_empty() { "." } else { g.m.comp_dir }
  let f0 = g.dbg_file("main.xo")
  // the unit's number first: its globals refer to it
  g.dbg_n += 1
  g.dbg_cu = g.dbg_n
  // xo_static, rt.static_word's table (decision 0253: the debugger finds
  // the runtime's records through it), as 256 Ints; call.xo attaches it
  // to @.xo.static where a module defines that
  let it = g.dbg_node("!DIBasicType(name: \"Int\", size: 64, encoding: DW_ATE_signed)")
  g.dbg_types["Int"] = it
  let sub = g.dbg_node("!DISubrange(count: 256)")
  let arr = g.dbg_node("!DICompositeType(tag: DW_TAG_array_type, baseType: !${it}, size: 16384, elements: !{!${sub}})")
  let gv = g.dbg_node("distinct !DIGlobalVariable(name: \"xo_static\", scope: !${g.dbg_cu}, file: !${f0}, type: !${arr}, isLocal: false, isDefinition: true)")
  g.dbg_static = g.dbg_node("!DIGlobalVariableExpression(var: !${gv}, expr: !DIExpression())")
  g.meta.push("!${g.dbg_cu} = distinct !DICompileUnit(language: DW_LANG_C99, file: !${f0}, producer: \"xo compiler\", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, globals: !{!${g.dbg_static}}, nameTableKind: None)\n")
  g.dbg_ty = g.dbg_node("!DISubroutineType(types: !{})")
  let v = g.dbg_node("!{i32 7, !\"Dwarf Version\", i32 5}")
  let d = g.dbg_node("!{i32 2, !\"Debug Info Version\", i32 3}")
  g.meta.push("!llvm.dbg.cu = !{!${g.dbg_cu}}\n!llvm.module.flags = !{!${v}, !${d}}\n")
  let _dir = dir
}

/// The metadata number of a new node with text t.
fn (var g: Gen) dbg_node(t: Str) -> Int {
  g.dbg_n += 1
  g.meta.push("!${g.dbg_n} = ${t}\n")
  g.dbg_n
}

/// The DIFile of source name (std/ names relative to the std root).
fn (var g: Gen) dbg_file(name: Str) -> Int {
  if let Some(k) = g.dbg_files.get(name) {
    return k
  }
  var dir = if g.m.comp_dir.is_empty() { "." } else { g.m.comp_dir }
  if name.starts_with("std/") && !g.m.std_root.is_empty() {
    dir = g.m.std_root
  }
  let k = g.dbg_node("!DIFile(filename: \"${ir_escape(name)}\", directory: \"${ir_escape(dir)}\")")
  g.dbg_files[name] = k
  k
}

/// Starts the function's subprogram (lower_func): none without debug
/// information or a source file.
fn (var g: Gen) debug_func() {
  g.dbg_sp = -1
  g.cur_line = 0
  if g.dbg_cu < 0 || g.f.file.is_empty() {
    return
  }
  var line = 0
  for v in g.f.values {
    if v.line != 0 {
      line = v.line / 4096
      break
    }
  }
  let file = g.dbg_file(g.f.file)
  g.dbg_sp = g.dbg_node("distinct !DISubprogram(name: \"${ir_escape(g.f.name)}\", scope: !${file}, file: !${file}, line: ${line}, type: !${g.dbg_ty}, scopeLine: ${line}, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !${g.dbg_cu})")
  g.debug_vars(file)
}

/// The function's source variables (decision 0252, stage 3): a
/// DILocalVariable per variable of a scalar type (Int, Float, Bool; a
/// struct is an LLVM aggregate, which a dbg.value does not describe per
/// field), parameters numbered by their place in the entry block, and
/// the binding records by value, for debug_bind.
fn (var g: Gen) debug_vars(file: Int) {
  g.dbg_vars = []
  g.dbg_binds = {}
  let entry = g.f.blocks[0].params
  for (k, d) in g.f.dvars.indexed() {
    let t = g.dbg_basic(d.ty)
    if t < 0 || d.inl >= 0 {
      g.dbg_vars.push(-1)
      continue
    }
    var arg = ""
    if d.param {
      for b in g.f.dbinds {
        if b.dvar == k {
          for (i, p) in entry.indexed() {
            if p == b.value {
              arg = "arg: ${i + 1}, "
            }
          }
        }
      }
    }
    g.dbg_vars.push(g.dbg_node("!DILocalVariable(name: \"${ir_escape(d.name)}\", ${arg}scope: !${g.dbg_sp}, file: !${file}, line: ${d.line / 4096}, type: !${t})"))
  }
  for b in g.f.dbinds {
    if b.dvar >= 0 && b.dvar < g.dbg_vars.len() && g.dbg_vars[b.dvar] >= 0 {
      var l = g.dbg_binds.get(b.value) ?? []
      l.push(b.dvar)
      g.dbg_binds[b.value] = l
    }
  }
  if !g.dbg_binds.is_empty() {
    g.llvm_decl("@llvm.dbg.value", "declare void @llvm.dbg.value(metadata, metadata, metadata)")
  }
}

/// The DIBasicType of an Int, Float, or Bool type, -1 for another type.
fn (var g: Gen) dbg_basic(t: Int) -> Int {
  if t < 0 {
    return -1
  }
  let x = g.m.types[t]
  let enc = match x.kind {
    Int => if x.unsigned { "DW_ATE_unsigned" } else { "DW_ATE_signed" }
    Float => "DW_ATE_float"
    Bool => "DW_ATE_boolean"
    _ => ""
  }
  if enc.is_empty() {
    return -1
  }
  if let Some(k) = g.dbg_types.get(x.name) {
    return k
  }
  let size = match x.kind {
    Bool => 8
    Float => if x.bits == 32 { 32 } else { 64 }
    _ => 64
  }
  let k = g.dbg_node("!DIBasicType(name: \"${ir_escape(x.name)}\", size: ${size}, encoding: ${enc})")
  g.dbg_types[x.name] = k
  k
}

/// The dbg.value calls of the binding records of value v (after its
/// definition, or at its block's start for a parameter): none for a value
/// held in memory (reading it would add a load) or of no type.
fn (var g: Gen) debug_bind(v: Int) {
  if g.dbg_sp < 0 {
    return
  }
  let ds = g.dbg_binds.get(v) ?? []
  if ds.is_empty() || g.lazy[v] >= 0 || g.is_void(g.f.values[v].ty) {
    return
  }
  let lt = g.ll(g.f.values[v].ty)
  let o = g.op(v)
  // only a value defined in this block, or a constant: a debug use of a
  // value of another block makes instruction selection carry it across
  // blocks, which changes register allocation (decision 0252's gate;
  // netconn.dial_timeout, 2026-10-17)
  let here = (o == vname(v) && g.blk[v] == g.dbg_block) || g.dbg_temps.contains(o) || !(o.starts_with("%") || o.starts_with("@"))
  if !here {
    return
  }
  for d in ds {
    g.emit("call void @llvm.dbg.value(metadata ${lt} ${o}, metadata !${g.dbg_vars[d]}, metadata !DIExpression())")
  }
}

/// The location of the instruction being emitted, inline.
fn (g: Gen) dbg_loc() -> Str {
  "!DILocation(line: ${g.cur_line / 4096}, column: ${g.cur_line % 4096}, scope: !${g.dbg_sp})"
}

/// s with the characters a metadata string cannot hold escaped.
fn ir_escape(s: Str) -> Str {
  s.replace("\\", "\\5C").replace("\"", "\\22")
}
