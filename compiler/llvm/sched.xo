// The task switch and thread state of decision 0212 (internal/llvm
// sched.go): rt.stack_switch is a call of xo_stack_switch and
// rt.fiber_start_addr the address of xo_fiber_entry, naked functions
// whose bodies are the instruction sequences std/llrt/xo_rt.c's C path
// uses (switch_asm); rt.tlocal_get and rt.tlocal_set are calls of
// xo_tlocal_get and xo_tlocal_set, never inlined (a fiber may go on on
// another thread after a switch, and a caller must not keep a thread
// local's address), over a table of 16 words in a thread_local global
// that only xo_tlocal_at names (a split build, decision 0168, copies a
// global into each module that uses it).
use github.com/xo-lang/xo/compiler/ssa

/// The declaration of llvm.frameaddress and the attributes of a function
/// that calls rt.frame_addr (decision 0233), at the first use.
fn (var g: Gen) frame_attrs() {
  if g.emitted.contains("@llvm.frameaddress.p0") {
    return
  }
  g.emitted["@llvm.frameaddress.p0"] = true
  let san = if g.tsan { " sanitize_thread" } else { "" }
  g.helpers.push("declare ptr @llvm.frameaddress.p0(i32)\nattributes #9 = { uwtable${san} noinline \"frame-pointer\"=\"all\" }\n\n")
}

/// Notes the use of xo_preempt_stub (decision 0286 step 3); preempt_asm
/// defines it.
fn (var g: Gen) preempt_stub() { g.emitted["@xo_preempt_stub"] = true }

/// xo_preempt_stub's definition as module asm, a weak hidden symbol: only
/// inline asm calls it, which thin LTO cannot see, so a definition in IR
/// was internalized or dropped in a split build's parts while another
/// part's code called it (TestGoldenSplit's thin variants, 2026-10-21);
/// module asm is kept as written (and a split build puts it in its first
/// module, split.xo parse_ir).
fn (g: Gen) preempt_asm() -> Str {
  if !g.emitted.contains("@xo_preempt_stub") {
    return ""
  }
  let s = if g.goos == "darwin" { "_xo_preempt_stub" } else { "xo_preempt_stub" }
  var ls: List[Str] = [".text"]
  if g.goos == "darwin" {
    ls = ls + [".globl ${s}", ".weak_definition ${s}", ".private_extern ${s}"]
  } else if g.goos == "windows" {
    ls.push(".globl ${s}")
  } else {
    ls = ls + [".weak ${s}", ".hidden ${s}", ".type ${s},@function"]
  }
  // the body on x86_64 is ssa.preempt_stub_amd64's (decision 0286 step 3)
  let body = if g.arch() == "amd64" { ssa.preempt_stub_amd64(g.goos) } else { ssa.preempt_stub_arm64(g.goos) }
  ls = ls + [".p2align 2", "${s}:"] + body
  var out = ""
  for l in ls {
    out = out + "module asm \"${l}\"\n"
  }
  out + "\n"
}

/// Defines xo_stack_switch and xo_fiber_entry at the first use.
fn (var g: Gen) sched_switch() {
  if g.emitted.contains("@xo_stack_switch") {
    return
  }
  g.emitted["@xo_stack_switch"] = true
  let (sw, start) = switch_asm(g.goos, g.arch())
  // the fiber entry's .cfi_escape needs clang's CFI region around it: the
  // uwtable attribute is what asks for one from an IR level function
  // (Linux clang leaves it out otherwise, switch_asm)
  let uw = if g.goos == "linux" && g.arch() == "arm64" { " uwtable" } else { "" }
  g.helpers.push(naked_fn("void @xo_stack_switch(i64 %0, i64 %1)", sw))
  g.helpers.push(naked_fn("void @xo_fiber_entry()", start, uw))
}

/// Defines xo_unwind_save and xo_unwind_resume (rt.unwind_save and
/// rt.unwind_resume, decision 0221) at the first use: the lines of
/// compiler/arm64 sched.xo unwind_save_body and unwind_resume_body on
/// arm64. On x86_64 (stage 2) the save stores the callee saved rbx, rbp,
/// r12 to r15 at their DWARF numbers' words (3, 6, 12 to 15), the
/// caller's rsp (7) and the return address (16, the return address
/// column); the resume loads them, the exception and selector into rax
/// and rdx (words 0 and 1), and jumps to the pc word (96). Windows does
/// not call them (unwind.xo win_raise resumes with RtlRestoreContext):
/// on windows/amd64 the save stores nothing and the resume traps.
fn (var g: Gen) unwind_fns() {
  if g.emitted.contains("@xo_unwind_save") {
    return
  }
  g.emitted["@xo_unwind_save"] = true
  g.emitted["@xo_unwind_resume"] = true
  if g.os() == "windows" && g.arch() == "amd64" {
    g.helpers.push(naked_fn("void @xo_unwind_save(i64 %0)", ["retq"]))
    g.helpers.push(naked_fn("void @xo_unwind_resume(i64 %0)", ["ud2"]))
    return
  }
  if g.arch() == "amd64" {
    g.helpers.push(naked_fn("void @xo_unwind_save(i64 %0)", ["movq %rbx, 24(%rdi)", "movq %rbp, 48(%rdi)", "movq %r12, 96(%rdi)", "movq %r13, 104(%rdi)", "movq %r14, 112(%rdi)", "movq %r15, 120(%rdi)", "leaq 8(%rsp), %rax", "movq %rax, 56(%rdi)", "movq (%rsp), %rax", "movq %rax, 128(%rdi)", "retq"]))
    g.helpers.push(naked_fn("void @xo_unwind_resume(i64 %0)", ["movq %rdi, %r11", "movq 24(%r11), %rbx", "movq 48(%r11), %rbp", "movq 96(%r11), %r12", "movq 104(%r11), %r13", "movq 112(%r11), %r14", "movq 120(%r11), %r15", "movq 0(%r11), %rax", "movq 8(%r11), %rdx", "movq 56(%r11), %rsp", "jmpq *768(%r11)"]))
    return
  }
  g.helpers.push(naked_fn("void @xo_unwind_save(i64 %0)", ["stp x19, x20, [x0, #152]", "stp x21, x22, [x0, #168]", "stp x23, x24, [x0, #184]", "stp x25, x26, [x0, #200]", "stp x27, x28, [x0, #216]", "stp x29, x30, [x0, #232]", "mov x9, sp", "str x9, [x0, #248]", "str d8, [x0, #576]", "str d9, [x0, #584]", "str d10, [x0, #592]", "str d11, [x0, #600]", "str d12, [x0, #608]", "str d13, [x0, #616]", "str d14, [x0, #624]", "str d15, [x0, #632]", "ret"]))
  g.helpers.push(naked_fn("void @xo_unwind_resume(i64 %0)", ["mov x16, x0", "ldp x19, x20, [x16, #152]", "ldp x21, x22, [x16, #168]", "ldp x23, x24, [x16, #184]", "ldp x25, x26, [x16, #200]", "ldp x27, x28, [x16, #216]", "ldp x29, x30, [x16, #232]", "ldr d8, [x16, #576]", "ldr d9, [x16, #584]", "ldr d10, [x16, #592]", "ldr d11, [x16, #600]", "ldr d12, [x16, #608]", "ldr d13, [x16, #616]", "ldr d14, [x16, #624]", "ldr d15, [x16, #632]", "ldr x17, [x16, #248]", "mov sp, x17", "ldp x0, x1, [x16, #0]", "ldr x17, [x16, #768]", "br x17"]))
}

/// Defines the thread local table and its functions at the first use.
/// The table's address goes through llvm.threadlocal.address: a plain use
/// of the thread_local global is a constant to LLVM (15 and later), so
/// interprocedural constant propagation turned xo_tlocal_addr into `ret`
/// and its callers computed the address themselves, reading tpidr_el0
/// once into a callee saved register that outlived a park; a fiber that
/// went on on another worker then used the first thread's table (linux
/// arm64, where TLS is an mrs and not a call: 19 goldens crashed with a
/// worker on another thread's scheduler stack, 2026-10-15,
/// gotchas/llvm-thread-local-constant.md).
fn (var g: Gen) sched_tlocal() {
  if g.emitted.contains("@xo_tlocal_get") {
    return
  }
  g.emitted["@xo_tlocal_get"] = true
  g.emitted["@xo_tlocal_set"] = true
  g.emitted["@xo_tlocal_addr"] = true
  g.helpers.push("@xo_tlocal = hidden thread_local global [16 x i64] zeroinitializer, align 8\n\n" +
    "declare nonnull ptr @llvm.threadlocal.address.p0(ptr nonnull)\n\n" +
    "define internal ptr @xo_tlocal_at(i64 %k) nounwind {\n  %b = call ptr @llvm.threadlocal.address.p0(ptr @xo_tlocal)\n  %p = getelementptr [16 x i64], ptr %b, i64 0, i64 %k\n  ret ptr %p\n}\n\n" +
    "define i64 @xo_tlocal_get(i64 %k) noinline nounwind {\n  call void asm sideeffect \"\", \"~{memory}\"()\n  %p = call ptr @xo_tlocal_at(i64 %k)\n  %v = load i64, ptr %p, align 8\n  ret i64 %v\n}\n\n" +
    "define void @xo_tlocal_set(i64 %k, i64 %v) noinline nounwind {\n  call void asm sideeffect \"\", \"~{memory}\"()\n  %p = call ptr @xo_tlocal_at(i64 %k)\n  store i64 %v, ptr %p, align 8\n  ret void\n}\n\n" +
    "define i64 @xo_tlocal_addr() noinline nounwind {\n  call void asm sideeffect \"\", \"~{memory}\"()\n  %p = call ptr @xo_tlocal_at(i64 0)\n  %a = ptrtoint ptr %p to i64\n  ret i64 %a\n}\n\n")
}

/// A function of sig whose body is the assembly lines asm.
fn naked_fn(sig: Str, asm: List[Str], attrs: Str = "") -> Str {
  let body = asm.join("\\0A").replace("$", "$$")
  "define ${sig} naked noinline nounwind${attrs} {\n  call void asm sideeffect \"${body}\", \"\"()\n  unreachable\n}\n\n"
}

/// The bodies of xo_stack_switch and xo_fiber_entry on goos/goarch
/// (sched.go switchAsm): xo_rt.c's xo_fiber_switch and xo_fiber_entry.
/// arm64 (AAPCS64): x19 to x28, fp, lr, d8 to d15 callee saved (x18 not
/// touched: the platform's on Darwin, the TEB on Windows, whose stack
/// bounds switch with the stack). x86_64 System V: rbx, rbp, r12 to r15,
/// MXCSR's and the x87 unit's control words; Windows x64 also rdi, rsi,
/// xmm6 to xmm15, and the TEB's bounds. A new fiber's first frame
/// (std/native/llrt/sched.xo fiber_frame) holds its argument and its
/// function in the first two registers restored.
fn switch_asm(goos: Str, goarch: Str) -> (List[Str], List[Str]) {
  if goarch == "amd64" {
    if goos == "windows" {
      return (amd64_win_switch(), ["subq $32, %rsp", "movq %rbx, %rcx", "callq *%r12", "ud2"])
    }
    return (amd64_switch(), ["movq %rbx, %rdi", "callq *%r12", "ud2"])
  }
  let start = ["mov x0, x19", "blr x20", "brk #1"]
  if goos == "windows" {
    return (arm64_win_switch(), start)
  }
  if goos == "linux" {
    // a fiber's outermost frame: its unwind entry has the return address
    // undefined. The directive needs a CFI region from clang, which it
    // emits for a naked IR function only sometimes (a split part's code
    // gen gives one, the whole program IR does not: TestGoldenTasks and
    // TestRaceSyncTable failed on the CI runner, 2026-10-25), so on Linux
    // xo_fiber_entry carries the uwtable attribute (sched_switch) and
    // clang always opens the region
    return (arm64_switch(), [".cfi_escape 0x07, 30"] + start)
  }
  (arm64_switch(), start)
}

fn arm64_switch() -> List[Str] {
  ["sub sp, sp, #160", "stp x19, x20, [sp, #0]", "stp x21, x22, [sp, #16]", "stp x23, x24, [sp, #32]", "stp x25, x26, [sp, #48]", "stp x27, x28, [sp, #64]", "stp x29, x30, [sp, #80]", "stp d8, d9, [sp, #96]", "stp d10, d11, [sp, #112]", "stp d12, d13, [sp, #128]", "stp d14, d15, [sp, #144]", "mov x9, sp", "str x9, [x0]", "mov sp, x1", "ldp x19, x20, [sp, #0]", "ldp x21, x22, [sp, #16]", "ldp x23, x24, [sp, #32]", "ldp x25, x26, [sp, #48]", "ldp x27, x28, [sp, #64]", "ldp x29, x30, [sp, #80]", "ldp d8, d9, [sp, #96]", "ldp d10, d11, [sp, #112]", "ldp d12, d13, [sp, #128]", "ldp d14, d15, [sp, #144]", "add sp, sp, #160", "ret"]
}

fn arm64_win_switch() -> List[Str] {
  ["sub sp, sp, #192", "stp x19, x20, [sp, #0]", "stp x21, x22, [sp, #16]", "stp x23, x24, [sp, #32]", "stp x25, x26, [sp, #48]", "stp x27, x28, [sp, #64]", "stp x29, x30, [sp, #80]", "stp d8, d9, [sp, #96]", "stp d10, d11, [sp, #112]", "stp d12, d13, [sp, #128]", "stp d14, d15, [sp, #144]", "ldr x9, [x18, #8]", "ldr x10, [x18, #16]", "stp x9, x10, [sp, #160]", "ldr x9, [x18, #0x1478]", "str x9, [sp, #176]", "mov x9, sp", "str x9, [x0]", "mov sp, x1", "ldp x9, x10, [sp, #160]", "str x9, [x18, #8]", "str x10, [x18, #16]", "ldr x9, [sp, #176]", "str x9, [x18, #0x1478]", "ldp x19, x20, [sp, #0]", "ldp x21, x22, [sp, #16]", "ldp x23, x24, [sp, #32]", "ldp x25, x26, [sp, #48]", "ldp x27, x28, [sp, #64]", "ldp x29, x30, [sp, #80]", "ldp d8, d9, [sp, #96]", "ldp d10, d11, [sp, #112]", "ldp d12, d13, [sp, #128]", "ldp d14, d15, [sp, #144]", "add sp, sp, #192", "ret"]
}

fn amd64_win_switch() -> List[Str] {
  ["pushq %rbp", "pushq %rbx", "pushq %rdi", "pushq %rsi", "pushq %r12", "pushq %r13", "pushq %r14", "pushq %r15", "subq $192, %rsp", "movq %gs:0x1478, %rax", "movq %rax, 184(%rsp)", "movq %gs:0x10, %rax", "movq %rax, 176(%rsp)", "movq %gs:0x08, %rax", "movq %rax, 168(%rsp)", "movdqu %xmm6, 8(%rsp)", "movdqu %xmm7, 24(%rsp)", "movdqu %xmm8, 40(%rsp)", "movdqu %xmm9, 56(%rsp)", "movdqu %xmm10, 72(%rsp)", "movdqu %xmm11, 88(%rsp)", "movdqu %xmm12, 104(%rsp)", "movdqu %xmm13, 120(%rsp)", "movdqu %xmm14, 136(%rsp)", "movdqu %xmm15, 152(%rsp)", "stmxcsr (%rsp)", "fnstcw 4(%rsp)", "movq %rsp, (%rcx)", "movq %rdx, %rsp", "ldmxcsr (%rsp)", "fldcw 4(%rsp)", "movdqu 8(%rsp), %xmm6", "movdqu 24(%rsp), %xmm7", "movdqu 40(%rsp), %xmm8", "movdqu 56(%rsp), %xmm9", "movdqu 72(%rsp), %xmm10", "movdqu 88(%rsp), %xmm11", "movdqu 104(%rsp), %xmm12", "movdqu 120(%rsp), %xmm13", "movdqu 136(%rsp), %xmm14", "movdqu 152(%rsp), %xmm15", "movq 168(%rsp), %rax", "movq %rax, %gs:0x08", "movq 176(%rsp), %rax", "movq %rax, %gs:0x10", "movq 184(%rsp), %rax", "movq %rax, %gs:0x1478", "addq $192, %rsp", "popq %r15", "popq %r14", "popq %r13", "popq %r12", "popq %rsi", "popq %rdi", "popq %rbx", "popq %rbp", "ret"]
}

fn amd64_switch() -> List[Str] {
  ["pushq %rbp", "pushq %rbx", "pushq %r12", "pushq %r13", "pushq %r14", "pushq %r15", "subq $8, %rsp", "stmxcsr (%rsp)", "fnstcw 4(%rsp)", "movq %rsp, (%rdi)", "movq %rsi, %rsp", "ldmxcsr (%rsp)", "fldcw 4(%rsp)", "addq $8, %rsp", "popq %r15", "popq %r14", "popq %r13", "popq %r12", "popq %rbx", "popq %rbp", "ret"]
}
