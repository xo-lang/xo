// The LLVM emitter (internal/llvm fromssa.go, decision 0040) in Xo,
// decision 0166: it lowers the self hosted SSA module (compiler/ssa,
// after the passes and InsertRC) to the textual LLVM IR internal/llvm
// prints for the same module, byte for byte. This file holds the module
// wide state (sgen): types and their layout, globals, and the generated
// helpers (reference counting, equality, environments, boxes); func.xo
// lowers functions, call.xo calls, held.xo the memory of `var`
// parameters passed by reference.
//
// The IR's parts are kept as lists of text, appended in the order the Go
// emitter writes them, so every global, helper, and type definition is
// numbered and placed as there.

use github.com/xo-lang/xo/compiler/ssa

/// The state of one program lowered (sgen), and of the function being
/// lowered (sfn).
pub struct Gen {
  pub m: ssa.Module
  /// Decision 0318 stage 4: each function's mark (apreempt.xo), empty
  /// when the program polls
  apre: List[Int] = []
  types: List[Str] = []
  globals: List[Str] = []
  helpers: List[Str] = []
  funcs: List[Str] = []
  /// The alias scopes of the functions (noalias.xo).
  meta: List[Str] = []
  rt_decls: List[Str] = []
  /// Windows: the C symbols referenced weakly (rt.sym_present and `weak_`
  /// calls), each an `/alternatename` to xo_absent (weak_ref).
  weak_syms: List[Str] = []
  /// The text of runtime_decls (the runtime calls declared there are not
  /// declared again).
  decls: Str = ""
  /// Per type: the struct or enum definition was written.
  named: List[Bool] = []
  /// Per type: its LLVM type text, "" before the first use.
  ll_memo: List[Str] = []
  /// Per type: its size and alignment, -1 before the first use.
  sizes: List[Int] = []
  aligns: List[Int] = []
  /// Per type: whether it holds heap memory (1, 0; -1 before the first
  /// use).
  heaps: List[Int] = []
  /// String literals by the text of their bytes (irBytes), and fault
  /// locations by position.
  strs: Map[Str, Str] = {}
  locs: Map[Str, Str] = {}
  /// The helpers and runtime declarations written.
  emitted: Map[Str, Bool] = {}
  /// The functions by name (the last of each name, as byName).
  by_name: Map[Str, Int] = {}
  /// Per function: which parameters are passed by reference (empty for
  /// none), once computed (decision 0145).
  by_ref: List[List[Bool]] = []
  by_ref_done: List[Bool] = []
  /// The functions used as values (they keep the plain convention).
  addr_taken: Map[Str, Bool] = {}
  /// Per function and `var` parameter: whether it hands back its own
  /// object or a new list (noalias.xo summarize).
  same_var: List[List[Bool]] = []
  /// The first construct the lowering does not support (fail): the
  /// program fails, as GenerateSSA returns an error.
  pub err: Str = ""
  /// The functions not lowered: `<name>: <why>` (a construct of a later
  /// stage of decision 0166), not compared.
  pub skipped: List[Str] = []
  /// The stages of decision 0166 this emitter does (1 to 3).
  pub stage: Int = 3
  /// The target's architecture (`arm64`, `amd64`): the registers of
  /// rt.sys6's inline asm (decision 0206); "" is arm64.
  pub goarch: Str = ""
  /// The target's OS (`darwin`, `linux`, `windows`): which platform
  /// calls are made (decision 0213) and the task switch's sequences
  /// (decision 0212); "" is the compiler's own.
  pub goos: Str = ""
  /// ThreadSanitizer (`--race`, decision 0241): every generated
  /// function marked sanitize_thread, which clang's -fsanitize=thread
  /// pass needs to instrument a function of IR it was given (the C
  /// frontend sets it; gotchas/tsan-needs-sanitize-thread-mark.md).
  pub tsan: Bool = false
  /// With tsan, the runtime instrumented too (decision 0273 mode 1, the
  /// runtime's own race tests: XO_TSAN_RUNTIME=1); else --race leaves
  /// std/native/llrt out (func.xo race_unchecked).
  pub tsan_runtime: Bool = false

  /// DWARF line tables (decision 0239; debug.xo): the metadata numbers
  /// made (from dbg_first, past the fixed ones and the alias scopes'),
  /// the compile unit, the
  /// files, the subprogram of the function being lowered (-1 for none),
  /// and the line of the value being lowered
  dbg_n: Int = DBG_BASE
  dbg_cu: Int = -1
  /// xo_static's DIGlobalVariableExpression (-1: no debug information)
  dbg_static: Int = -1
  dbg_ty: Int = -1
  dbg_files: Map[Str, Int] = {}
  dbg_sp: Int = -1
  /// The function's DILocalVariable per ssa dvar (-1: not described),
  /// its binding records by value, and the types by name (decision
  /// 0252).
  dbg_vars: List[Int] = []
  dbg_binds: Map[Int, List[Int]] = {}
  dbg_types: Map[Str, Int] = {}
  /// The block being lowered and the temporaries defined in it so far
  /// (debug_bind uses only values of the block).
  dbg_block: Int = -1
  dbg_temps: Map[Str, Bool] = {}
  /// With debug information, the insertvalue instructions of the block
  /// by the name they define: (aggregate, index, inserted operand), so a
  /// variable's part is the scalar inserted (debug_bind)
  dbg_ins: Map[Str, (Str, Int, Str)] = {}
  /// The function's aggregate operands whose parts are a variable's:
  /// the value of a variable bound to that one value only (or a part of
  /// one: the variables and the path of the part), so the code's own
  /// extractvalue of a part describes it (dbg_note_ext)
  dbg_aggs: Map[Str, (List[Int], List[Int])] = {}
  /// The variables bound to one value only in the function
  dbg_once: Map[Int, Bool] = {}
  cur_line: Int = 0

  // The function being lowered (sfn).
  f: ssa.Func = ssa.Func{name: ""}
  fi: Int = -1
  /// Per value: the block that holds it (Value.block is not kept up to
  /// date by the passes), -1 for none.
  blk: List[Int] = []
  allocas: List[Str] = []
  body: List[Str] = []
  label: Str = ""
  /// The SSA block the current LLVM block belongs to.
  label0: Str = ""
  /// Per value: its operand text when it is an alias, else "".
  names: List[Str] = []
  n: Int = 0
  nlabel: Int = 0
  /// Per block: the LLVM block its terminator is in, and its text.
  ends: List[Str] = []
  texts: List[Str] = []
  /// Per value: a release whose retain was cancelled.
  cancel: List[Bool] = []
  /// The landing pads (decision 0085): the value being lowered lands on
  /// block pad_to when it faults; its calls that can raise are invokes
  /// unwinding to pad (made at the first one).
  pad_to: Int = -1
  pad: Str = ""
  pads: List[Str] = []
  npad: Int = 0
  /// Per block: reached only through a fault's cleanup (cold_blocks),
  /// where the count helpers are called out of line
  cold: List[Bool] = []
  /// Per LLVM struct type, the memory that carries a value of it passed
  /// by reference, and more for a call that passes several (decision
  /// 0145).
  home: Map[Str, Str] = {}
  spare: Map[Str, List[Str]] = {}
  /// per LLVM type, the function's slot for a value of a big type given
  /// to its count helper by pointer (rc_val_call)
  rc_tmp: Map[Str, Str] = {}
  /// Per value: the memory nothing writes while the function runs that
  /// holds it (decision 0147), or "".
  addr: List[Str] = []
  /// The memory of `var` parameters passed by reference (held.xo,
  /// decision 0148).
  held: Held = Held{}
  has_held: Bool = false
  /// Per value: stable computed (0 no, 1 yes, -1 not yet).
  stable_memo: List[Int] = []
  /// Per value: the memory it is read from at every use, or -1.
  lazy: List[Int] = []
  /// Per value: the instructions that use it (users), once computed.
  users_of: List[List[Int]] = []
  users_done: Bool = false
  /// Why the current function is not lowered (a later stage), or "".
  skip: Str = ""
  /// The functions whose calls are inlined (ranges.xo inlinable_set).
  inl: Map[Str, Bool] = {}
  /// The value ranges of the function (ranges.xo): per value its
  /// interval, whether it has one, whether its check is proved away, and
  /// whether it is a midpoint; per block its entry facts (an index into
  /// facts, -1 for none).
  rng: List[Interval] = []
  rng_has: List[Bool] = []
  rng_safe: List[Bool] = []
  rng_mid: List[Bool] = []
  facts: List[Fact] = []
  fact_at: List[Int] = []
  /// The alias scopes of the function (noalias.xo): per value the scope
  /// of its access (-1 none), the number of scopes (0: none emitted),
  /// and the first metadata id.
  sc_tag: List[Int] = []
  sc_n: Int = 0
  sc_base: Int = 0
}

/// The emitter for module m.
pub fn new_gen(m: ssa.Module) -> Gen {
  var g = Gen{m: m, decls: runtime_decls()}
  let nt = m.types.len()
  for _ in 0..nt {
    g.named.push(false)
    g.ll_memo.push("")
    g.sizes.push(-1)
    g.aligns.push(-1)
    g.heaps.push(-1)
  }
  for _ in 0..m.funcs.len() {
    g.by_ref.push([])
    g.by_ref_done.push(false)
  }
  g.dbg_n = dbg_first(m.funcs.len())
  g
}

/// The debug metadata's numbers start past 1000000 and past the alias
/// scopes' (noalias.xo: function fi's from SCOPE_BASE * (fi + 1), under
/// SCOPE_BASE each): a module of 10,000 functions or more (the
/// compiler's) gave both families the same numbers, which clang rejects
/// ("Metadata id is already used", 2026-10-21).
fn dbg_first(nfuncs: Int) -> Int {
  DBG_BASE.max(SCOPE_BASE * (nfuncs + 1))
}

/// The debug metadata's first number in a module of fewer than 9,999
/// functions (dbg_first).
const DBG_BASE = 1000000

/// Records the first construct the lowering does not support (fail).
fn (var g: Gen) fail(msg: Str) {
  if g.err.is_empty() {
    g.err = msg
  }
}

/// Leaves the current function unlowered: a construct of a later stage.
fn (var g: Gen) unsupported(why: Str) {
  if g.skip.is_empty() {
    g.skip = why
  }
}

// ---------------------------------------------------------------------------
// The runtime declarations (ssaRuntimeDecls)

/// The types, the LLVM intrinsics, the attribute groups, and the
/// metadata every module starts with (ssaRuntimeDecls). The runtime's
/// functions are Xo exports declared where a call names them.
fn runtime_decls() -> Str {
  let lines = [
    "%xo.str = type { ptr, i64 }",
    "%xo.rlist = type { i64, i64, i64 }",
    "",
    "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)",
    "declare i64 @llvm.smax.i64(i64, i64)",
    "declare double @llvm.sqrt.f64(double)",
    "declare double @llvm.floor.f64(double)",
    "declare double @llvm.ceil.f64(double)",
    "declare double @llvm.trunc.f64(double)",
    "declare double @llvm.round.f64(double)",
    "declare double @llvm.fabs.f64(double)",
    "declare void @llvm.assume(i1)",
    "declare i64 @llvm.ctpop.i64(i64)",
    "declare i64 @llvm.cttz.i64(i64, i1)",
    "declare i64 @llvm.ctlz.i64(i64, i1)",
    "",
    "; faults unwind (decision 0085): the fault functions and generated code",
    "; may unwind, and every generated function has unwind tables",
    "attributes #0 = { noreturn cold }",
    "attributes #1 = { uwtable }",
    "attributes #2 = { nounwind }",
    "attributes #3 = { nounwind cold noinline }",
    "attributes #4 = { nounwind alwaysinline }",
    "attributes #5 = { \"xo-raises\" }",
    "attributes #6 = { alwaysinline }",
    "attributes #7 = { uwtable \"no-builtins\" }",
    "attributes #8 = { nounwind noinline }",
    "attributes #10 = { uwtable noinline cold }",
    "attributes #11 = { uwtable noinline }",
    "; a call of an alwaysinline count helper in a fault's cleanup: kept a call",
    "attributes #12 = { noinline cold }",
    // a --race build's runtime functions (func.xo race_unchecked): not
    // sanitize_thread (generate's replacement skips this spelling)
    "attributes #13 = { \"xo-norace\" uwtable }",
    "attributes #14 = { \"xo-norace\" uwtable \"no-builtins\" }",
    "attributes #15 = { \"xo-norace\" uwtable noinline \"frame-pointer\"=\"all\" }",
    "attributes #16 = { \"xo-norace\" uwtable noinline cold }",
    "attributes #17 = { \"xo-norace\" uwtable noinline }",
    "; a preemption poll's slow call (decision 0286 step 3): the stub keeps every register and touches none of the program's memory",
    "attributes #18 = { nounwind memory(inaccessiblemem: readwrite) }",
    "; a runtime function of the C library kept out of the program's code (decision 0318 stage 4)",
    "attributes #19 = { uwtable \"no-builtins\" noinline }",
    "",
    "!0 = !{!\"branch_weights\", i32 1, i32 4000}",
    "; TBAA: list headers, list elements, and reference counts never overlap",
    "!1 = !{!\"xo tbaa\"}",
    "!2 = !{!\"xo.list.header\", !1, i64 0}",
    "!3 = !{!2, !2, i64 0}",
    "!4 = !{!\"xo.list.element\", !1, i64 0}",
    "!5 = !{!4, !4, i64 0}",
    "!6 = !{!\"xo.rc\", !1, i64 0}",
    "!7 = !{!6, !6, i64 0}",
    "; a list's length or capacity: never negative (bit 62 and up clear), so",
    "; LLVM can prove an index below the length from a signed loop bound",
    "; (2026-10-21: nbody's bs[j] in `for j in i + 1..n` kept its check and",
    "; a fault landing in the loop)",
    "!9 = !{i64 0, i64 4611686018427387904}",
    "",
    "",
  ]
  lines.join("\n")
}

const TBAA_HDR = ", !tbaa !3"
/// A load of a list's length or capacity: the header's tag and the range
/// of a count (!9).
const HDR_COUNT = ", !tbaa !3, !range !9"
const TBAA_ELEM = ", !tbaa !5"
const TBAA_RC = ", !tbaa !7"
/// The count of literals, never written (decision 0058), as text.
const IMMORTAL = "-9223372036854775808"
/// Bit 62, set in every shared (negative, not immortal) count.
const SHARED_BIT = "4611686018427387904"
/// The header fields of an environment (rc, drop, share) before the
/// captures.
const ENV_FIELDS = 3
/// The size from which a struct or enum parameter of a direct call is
/// passed by reference (decision 0145).
const BY_REF_MIN = 256

// ---------------------------------------------------------------------------
// The program

/// Lowers the module (GenerateSSA): the IR text, or "" with err set.
pub fn (var g: Gen) generate() -> Str {
  if g.tsan {
    // the attribute sets of generated functions (#1, #7, #10, #11; #9
    // in frame_attrs) all have uwtable; the runtime's hand written
    // helpers (nounwind) stay unmarked
    g.decls = g.decls.replace("= { uwtable", "= { uwtable sanitize_thread")
  }
  let nf = g.m.funcs.len()
  for fi in 0..nf {
    let name = g.m.funcs[fi].name
    g.by_name[name] = fi
    for bl in g.m.funcs[fi].blocks {
      for v in bl.instrs {
        let op = g.m.funcs[fi].values[v].op
        if op is ssa.Op.Closure | ssa.Op.FuncAddr | ssa.Op.Rebind {
          if let S(s) = g.m.funcs[fi].values[v].aux {
            g.addr_taken[s] = true
          }
        }
      }
    }
  }
  if g.m.async_preempt && !g.tsan {
    // decision 0318 stage 4: the runtime's no-preemption guards
    g.apre_mark()
  }
  for fi in 0..nf {
    for p in g.m.funcs[fi].blocks[0].params {
      g.check_type(g.m.funcs[fi].values[p].ty)
    }
  }
  g.inlinable_set()
  g.summarize()
  g.debug_unit()
  for fi in 0..nf {
    g.lower_func(fi)
    if !g.err.is_empty() {
      return ""
    }
  }
  let mi = g.by_name.get("main") ?? -1
  if mi < 0 {
    g.fail("no main")
    return ""
  }
  var args: List[Str] = []
  for p in g.m.funcs[mi].blocks[0].params {
    args.push("${g.ll(g.m.funcs[mi].values[p].ty)} zeroinitializer")
  }
  let rl = g.res_ll(mi)
  // with debug information, xo_entry has a subprogram too: main is
  // inlined into it, and code inlined into a function without one loses
  // its lines (decision 0239)
  g.f = g.m.funcs[mi]
  g.debug_func()
  if g.dbg_sp >= 0 {
    g.cur_line = 0
    for v in g.f.values {
      if v.line != 0 {
        g.cur_line = v.line
        break
      }
    }
    let loc = g.dbg_loc()
    g.funcs.push("define void @xo_entry() #1 !dbg !${g.dbg_sp} {\n  call ${rl} ${fname(g.m.funcs[mi].name)}(${args.join(", ")}), !dbg ${loc}\n  ret void, !dbg ${loc}\n}\n")
    g.dbg_sp = -1
  } else {
    g.funcs.push("define void @xo_entry() #1 {\n  call ${rl} ${fname(g.m.funcs[mi].name)}(${args.join(", ")})\n  ret void\n}\n")
  }
  g.exports()
  if !g.err.is_empty() {
    return ""
  }
  // a C name the module defines (an XO_NOLIBC build's C library,
  // cabi_libc.xo: __errno_location) is not declared too, as a weak
  // platform call's would be ("invalid redefinition" otherwise)
  var defined: Map[Str, Bool] = {}
  for f in g.m.funcs {
    if !f.export.is_empty() {
      defined[f.export] = true
    }
  }
  var decls: List[Str] = []
  for d in g.rt_decls {
    let parts = d.split(" @")
    if d.starts_with("declare ") && parts.len() > 1 && defined.contains(parts[1].split("(")[0]) {
      continue
    }
    decls.push(d)
  }
  if g.m.nolibc {
    // the C library's data symbols (decision 0234): weak, so the split
    // build's copies are one symbol and an unused one is kept
    for d in ssa.nolibc_data() {
      decls.push("@${d} = weak global i64 0, align 8\n")
    }
  }
  g.rt_decls = decls
  var out: List[Str] = []
  out.push("; generated by xo build --backend=llvm (internal/llvm, from internal/ssa with reference counting)\n\n")
  if g.m.nolibc_start {
    // the process entry (ssa.entry_stub_arm64), as module asm: no
    // function, so no unwind information (the split build puts it in
    // its first module only, split.xo parse_ir)
    let stub = if g.arch() == "amd64" { ssa.entry_stub_amd64() } else { ssa.entry_stub_arm64() }
    for l in stub.split("\n") {
      if !l.is_empty() {
        out.push("module asm \"${l.replace("\t", "\\09")}\"\n")
      }
    }
    out.push("\n")
  }
  out.push(g.weak_alternates())
  out.push(g.preempt_asm())
  out.push(g.decls)
  out.push(g.rt_decls.join(""))
  out.push(g.types.join(""))
  out.push("\n")
  out.push(g.globals.join(""))
  out.push("\n")
  out.push(g.helpers.join(""))
  out.push(g.funcs.join(""))
  out.push(g.meta.join(""))
  out.join("")
}

/// Rejects types that contain themselves by value (checkType; the SSA
/// builder boxes recursive fields, so none should reach here).
fn (var g: Gen) check_type(t: Int) {
  g.check_type_in(t, [])
}

fn (var g: Gen) check_type_in(t: Int, path: List[Int]) {
  if path.contains(t) {
    g.fail("the SSA lowering does not support the recursive type `${g.m.types[t].name}`")
    return
  }
  var p2 = path
  p2.push(t)
  let k = g.m.types[t].kind
  match k {
    Struct => {
      for f in g.m.types[t].fields {
        g.check_type_in(f.ty, p2)
      }
    }
    Enum => {
      for v in g.m.types[t].variants {
        for f in v.fields {
          g.check_type_in(f.ty, p2)
        }
      }
    }
    Tuple => {
      for e in g.m.types[t].elems {
        g.check_type_in(e, p2)
      }
    }
    _ => {}
  }
}

/// The LLVM name of function n.
fn fname(n: Str) -> Str {
  "@${"x.${n}".quote()}"
}

/// The LLVM type of t (ll); a struct or enum is defined at its first use.
fn (var g: Gen) ll(t: Int) -> Str {
  let memo = g.ll_memo[t]
  if !memo.is_empty() {
    return memo
  }
  let r = g.ll_new(t)
  g.ll_memo[t] = r
  r
}

fn (var g: Gen) ll_new(t: Int) -> Str {
  let k = g.m.types[t].kind
  match k {
    Unit | Cap => return "{}"
    Int => return "i64"
    Float => return "double"
    Bool => return "i1"
    Str => return "%xo.str"
    List => {
      g.check_type(t)
      return "ptr"
    }
    Func => return "{ ptr, ptr }"
    Box | Handle => return "ptr"
    Tuple => {
      var es: List[Str] = []
      for e in g.m.types[t].elems {
        es.push(g.ll(e))
      }
      return "{ ${es.join(", ")} }"
    }
    Struct => {
      let name = "%${"s.${g.m.types[t].name}".quote()}"
      if !g.named[t] {
        g.named[t] = true
        g.check_type(t)
        var fs: List[Str] = []
        for f in g.m.types[t].fields {
          fs.push(g.ll(f.ty))
        }
        if fs.is_empty() {
          g.types.push("${name} = type {}\n")
        } else {
          g.types.push("${name} = type { ${fs.join(", ")} }\n")
        }
      }
      return name
    }
    Enum => {
      let name = "%${"e.${g.m.types[t].name}".quote()}"
      if !g.named[t] {
        g.named[t] = true
        g.check_type(t)
        g.types.push("${name} = type { i64, [${g.words(t)} x i64] }\n")
      }
      return name
    }
    Bad => {}
  }
  g.fail("the SSA lowering does not support the type `${g.m.types[t].name}`")
  "?"
}

/// The literal struct of the fields of variant i of enum t (variantLL).
fn (var g: Gen) variant_ll(t: Int, i: Int) -> Str {
  var fs: List[Str] = []
  for f in g.m.types[t].variants[i].fields {
    fs.push(g.ll(f.ty))
  }
  "{ ${fs.join(", ")} }"
}

/// The size and alignment of t (the LLVM data layout of arm64 and
/// x86-64).
fn (var g: Gen) layout(t: Int) -> (Int, Int) {
  if g.sizes[t] >= 0 {
    return (g.sizes[t], g.aligns[t])
  }
  let k = g.m.types[t].kind
  let (s, a) = match k {
    Unit | Cap => (0, 1)
    Int | Float | List | Box | Handle => (8, 8)
    Bool => (1, 1)
    Str | Func => (16, 8)
    Enum => (8 + 8 * g.words(t), 8)
    Struct => {
      var ts: List[Int] = []
      for f in g.m.types[t].fields {
        ts.push(f.ty)
      }
      g.struct_layout(ts)
    }
    Tuple => g.struct_layout(g.m.types[t].elems)
    Bad => (8, 8)
  }
  g.sizes[t] = s
  g.aligns[t] = a
  (s, a)
}

fn align_up(n: Int, a: Int) -> Int {
  if a <= 1 {
    return n
  }
  (n + a - 1) / a * a
}

fn (var g: Gen) struct_layout(ts: List[Int]) -> (Int, Int) {
  var size = 0
  var align = 1
  for t in ts {
    let (s, a) = g.layout(t)
    size = align_up(size, a) + s
    if a > align {
      align = a
    }
  }
  (align_up(size, align), align)
}

/// The payload size of enum t in 8 byte words.
fn (var g: Gen) words(t: Int) -> Int {
  var mx = 0
  for v in g.m.types[t].variants {
    var ts: List[Int] = []
    for f in v.fields {
      ts.push(f.ty)
    }
    let (s, _) = g.struct_layout(ts)
    if s > mx {
      mx = s
    }
  }
  (mx + 7) / 8
}

fn (var g: Gen) size(t: Int) -> Int {
  let (s, _) = g.layout(t)
  s
}

fn (var g: Gen) kind(t: Int) -> ssa.Kind {
  g.m.types[t].kind
}

/// Whether values of t hold heap memory (Type.Heap).
fn (var g: Gen) heap(t: Int) -> Bool {
  let k = g.heaps[t]
  if k >= 0 {
    return k == 1
  }
  let r = g.m.heap(t)
  g.heaps[t] = if r { 1 } else { 0 }
  r
}

/// Whether t holds a Float (Type.HasFloat).
fn (var g: Gen) has_float(t: Int) -> Bool {
  g.has_float_in(t, [])
}

fn (var g: Gen) has_float_in(t: Int, seen: List[Int]) -> Bool {
  if seen.contains(t) {
    return false
  }
  var s2 = seen
  s2.push(t)
  let x = g.m.types[t]
  match x.kind {
    Float => return true
    Struct => {
      for f in x.fields {
        if g.has_float_in(f.ty, s2) {
          return true
        }
      }
    }
    Enum => {
      for v in x.variants {
        for f in v.fields {
          if g.has_float_in(f.ty, s2) {
            return true
          }
        }
      }
    }
    Tuple | List | Box => {
      for e in x.elems {
        if g.has_float_in(e, s2) {
          return true
        }
      }
    }
    _ => {}
  }
  false
}

/// A unit or capability type: no value at run time.
fn (var g: Gen) is_void(t: Int) -> Bool {
  g.m.types[t].kind is ssa.Kind.Unit | ssa.Kind.Cap
}

/// A struct, enum, or tuple type (isAgg).
fn (var g: Gen) is_agg(t: Int) -> Bool {
  g.m.types[t].kind is ssa.Kind.Struct | ssa.Kind.Enum | ssa.Kind.Tuple
}

/// The LLVM return type of function fi: its kept results (resLL).
fn (var g: Gen) res_ll(fi: Int) -> Str {
  let kept = g.kept_results(fi)
  let rs = g.m.funcs[fi].results
  if kept.len() == 1 {
    return g.ll(rs[kept[0]])
  }
  var es: List[Str] = []
  for k in kept {
    es.push(g.ll(rs[k]))
  }
  "{ ${es.join(", ")} }"
}

/// The type of all the results of fi, as the SSA call has (fullResLL).
fn (var g: Gen) full_res_ll(fi: Int) -> Str {
  let rs = g.m.funcs[fi].results
  if rs.len() == 1 {
    return g.ll(rs[0])
  }
  var es: List[Str] = []
  for r in rs {
    es.push(g.ll(r))
  }
  "{ ${es.join(", ")} }"
}

/// Which parameters of fi are passed by reference, or empty (byRefOf):
/// structs and enums of BY_REF_MIN bytes or more of a function called
/// directly.
fn (var g: Gen) by_ref_of(fi: Int) -> List[Bool] {
  if g.by_ref_done[fi] {
    return g.by_ref[fi]
  }
  var br: List[Bool] = []
  let f = g.m.funcs[fi]
  if !f.indirect && !f.entry && !g.addr_taken.contains(f.name) && f.name != "main" {
    let ps = f.blocks[0].params
    for (i, p) in ps.indexed() {
      let t = f.values[p].ty
      if (g.kind(t) is ssa.Kind.Struct | ssa.Kind.Enum) && g.size(t) >= BY_REF_MIN {
        if br.is_empty() {
          for _ in 0..ps.len() {
            br.push(false)
          }
        }
        br[i] = true
      }
    }
  }
  g.by_ref[fi] = br
  g.by_ref_done[fi] = true
  br
}

/// Whether parameter i of fi is `var`.
fn (var g: Gen) is_var_param(fi: Int, i: Int) -> Bool {
  g.m.funcs[fi].var_params.contains(i)
}

/// The indexes of the results of fi its LLVM function returns: all but
/// those of `var` parameters passed by reference (keptResults).
fn (var g: Gen) kept_results(fi: Int) -> List[Int] {
  let br = g.by_ref_of(fi)
  var out: List[Int] = []
  let n = g.m.funcs[fi].results.len()
  for k in 0..n {
    if k > 0 && !br.is_empty() && br[g.m.funcs[fi].var_params[k - 1]] {
      continue
    }
    out.push(k)
  }
  out
}

// ---------------------------------------------------------------------------
// Globals

/// The global object of a string literal of bytes b (strObj).
fn (var g: Gen) str_obj(b: Bytes) -> Str {
  let enc = ir_bytes(b)
  if let Some(name) = g.strs.get(enc) {
    return name
  }
  let name = "@.rs.${g.strs.len()}"
  g.strs[enc] = name
  let n = b.len()
  g.globals.push("${name} = private constant { i64, i64, [${n} x i8] } { i64 ${IMMORTAL}, i64 ${n}, [${n} x i8] c\"${enc}\" }, align 8\n")
  name
}

fn (var g: Gen) str_const_bytes(b: Bytes) -> Str {
  let o = g.str_obj(b)
  "{ ptr ${o}, i64 ${b.len()} }"
}

fn (var g: Gen) str_const(s: Str) -> Str {
  g.str_const_bytes(s.bytes())
}

/// The constant list.take leaves in a slot (decision 0169; hole): its
/// Str, List, Box, and handle leaves point to an immortal object (the
/// empty string's), a function value has no environment, and an enum's
/// tag is past its variants, so retain, release, and share of it do
/// nothing.
fn (var g: Gen) hole(t: Int) -> Str {
  if !g.heap(t) {
    return "zeroinitializer"
  }
  let x = g.m.types[t]
  match x.kind {
    Str => {
      let o = g.str_obj("".bytes())
      return "{ ptr ${o}, i64 0 }"
    }
    List | Box | Handle => return g.str_obj("".bytes())
    Enum => return "{ i64 ${x.variants.len()}, [${g.words(t)} x i64] zeroinitializer }"
    Struct | Tuple => {
      var fts: List[Int] = []
      if x.kind == ssa.Kind.Struct {
        for f in x.fields {
          fts.push(f.ty)
        }
      } else {
        fts = x.elems
      }
      var fs: List[Str] = []
      for ft in fts {
        let l = g.ll(ft)
        let h = g.hole(ft)
        fs.push("${l} ${h}")
      }
      return "{ " + fs.join(", ") + " }"
    }
    _ => {}
  }
  "zeroinitializer"
}

/// A NUL terminated global for a fault location (cstr).
fn (var g: Gen) cstr(s: Str) -> Str {
  if let Some(name) = g.locs.get(s) {
    return name
  }
  let name = "@.loc.${g.locs.len() + 1}"
  g.locs[s] = name
  g.globals.push("${name} = private unnamed_addr constant [${s.len() + 1} x i8] c\"${ir_bytes(s.bytes())}\\00\"\n")
  name
}

// ---------------------------------------------------------------------------
// Reference counting helpers

/// The text of a helper being written: its lines and its temporaries.
struct H {
  lines: List[Str] = []
  n: Int = 0
}

fn (var h: H) tmp() -> Str {
  h.n += 1
  "%t${h.n}"
}

fn (var h: H) w(s: Str) {
  h.lines.push(s)
}

/// The helper that retains ("dup"), releases ("drop"), or marks shared
/// ("share") a value of type t, written at its first use (rcFn).
/// Defines every C ABI export (Func.export, decision 0207; fromssa.go
/// exports): an external function of the C calling convention calling
/// the Xo function; a Str result is returned as its string object, its
/// length stored through the pointer after the parameters.
fn (var g: Gen) exports() {
  // the C library's functions (bare names, cabi_libc.xo, decision 0230)
  // are kept through LTO: code generation may call one (calloc, memcpy)
  // after the optimizer dropped an unreferenced definition
  var used: List[Str] = []
  for fi in 0..g.m.funcs.len() {
    let f = g.m.funcs[fi]
    if f.export.is_empty() {
      continue
    }
    if !f.export.starts_with("xo_x_") {
      used.push("ptr @${f.export}")
    }
    var ps: List[Str] = []
    var as_: List[Str] = []
    for (i, p) in f.blocks[0].params.indexed() {
      let t = g.ll(f.values[p].ty)
      ps.push("${t} %a${i}")
      as_.push("${t} %a${i}")
    }
    let rl = g.res_ll(fi)
    let call = "call ${rl} ${fname(f.name)}(${as_.join(", ")})"
    match g.m.types[f.results[0]].kind {
      Str => {
        ps.push("ptr %len")
        g.funcs.push("define ptr @${f.export}(${ps.join(", ")}) #1 {\n  %r = ${call}\n  %o = extractvalue %xo.str %r, 0\n  %n = extractvalue %xo.str %r, 1\n  store i64 %n, ptr %len\n  ret ptr %o\n}\n")
      }
      Unit => g.funcs.push("define void @${f.export}(${ps.join(", ")}) #1 {\n  ${call}\n  ret void\n}\n")
      _ => g.funcs.push("define ${rl} @${f.export}(${ps.join(", ")}) #1 {\n  %r = ${call}\n  ret ${rl} %r\n}\n")
    }
  }
  if g.emitted.contains("@xo_preempt_stub") {
    // only inline asm names it and the runtime export it calls (decision
    // 0286 step 3): LTO would drop both
    for f in g.m.funcs {
      if f.export == "xo_x_preempt" {
        used.push("ptr @xo_x_preempt")
      }
    }
  }
  if !used.is_empty() {
    g.funcs.push("@llvm.used = appending global [${used.len()} x ptr] [${used.join(", ")}], section \"llvm.metadata\"\n")
  }
}

/// Whether the count helpers of t take a pointer to the value instead of
/// the value: a struct, tuple, or enum of BY_REF_MIN bytes or more, whose
/// helper reads only its counted fields where they are. By value, every
/// release of a big struct copied all its words to the stack arguments
/// first (xo built by LLVM: 11.15 MB of its 89.8, mostly xo.drop.Builder,
/// .Gen, .Checker, .G; bench/results/xo-code-size-2026-10-18.md).
fn (var g: Gen) rc_by_ptr(t: Int) -> Bool {
  (g.kind(t) is ssa.Kind.Struct | ssa.Kind.Tuple | ssa.Kind.Enum) && g.size(t) >= BY_REF_MIN
}

/// The text calling helper h of t on the value at pointer p (loaded into
/// tmp first when h takes the value).
fn (var g: Gen) rc_at(h: Str, t: Int, p: Str, tmp: Str) -> Str {
  if g.rc_by_ptr(t) {
    return "  call void ${h}(ptr ${p})\n"
  }
  let lt = g.ll(t)
  "  ${tmp} = load ${lt}, ptr ${p}\n  call void ${h}(${lt} ${tmp})\n"
}

fn (var g: Gen) rc_fn(kind: Str, t: Int) -> Str {
  let tname = g.m.types[t].name
  let name = "@${"xo.${kind}.${tname}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  var b = H{}
  let lt = g.ll(t)
  let k = g.kind(t)
  var attr = "#1"
  if k is ssa.Kind.Str | ssa.Kind.List | ssa.Kind.Func | ssa.Kind.Box | ssa.Kind.Handle {
    if kind != "share" {
      attr = "#4"
    }
  }
  let by_ptr = g.rc_by_ptr(t)
  if by_ptr {
    b.w("define internal void ${name}(ptr %x) ${attr} {\n")
  } else {
    b.w("define internal void ${name}(${lt} %x) ${attr} {\n")
  }
  match k {
    Str | List => {
      var obj = "%x"
      if k == ssa.Kind.Str {
        obj = b.tmp()
        b.w("  ${obj} = extractvalue %xo.str %x, 0\n")
      }
      if kind == "dup" {
        rc_inc(b, obj)
      } else if kind == "drop" {
        rc_dec_fast(b, obj, g.drop_slow_fn(t))
        g.drop_free(b, t, obj)
      } else {
        rc_mark(b, obj)
        if k == ssa.Kind.List && g.heap(g.m.types[t].elems[0]) {
          let et = g.m.types[t].elems[0]
          let sz = g.size(et)
          let ef = g.elem_fn("share", et)
          let po = b.tmp()
          b.w("  ${po} = ptrtoint ptr ${obj} to i64\n  call void @xo_x_obj_rl_share(i64 ${po}, i64 ${sz}, i64 ptrtoint (ptr ${ef} to i64)) #6\n")
        }
        b.w("  br label %done\n")
      }
      b.w("done:\n  ret void\n")
    }
    Handle => {
      // a runtime object (decision 0068): shared from its creation, so
      // marking it does nothing; at zero the runtime frees it
      if kind == "dup" {
        rc_inc(b, "%x")
      } else if kind == "drop" {
        rc_dec_fast(b, "%x", g.drop_slow_fn(t))
        g.drop_free(b, t, "%x")
      } else {
        b.w("  br label %done\n")
      }
      b.w("done:\n  ret void\n")
    }
    Box => {
      if kind == "dup" {
        rc_inc(b, "%x")
      } else if kind == "drop" {
        rc_dec_fast(b, "%x", g.drop_slow_fn(t))
        g.drop_free(b, t, "%x")
      } else {
        rc_mark(b, "%x")
        if g.heap(g.m.types[t].elems[0]) {
          // the contents through the worklist too
          let sf = g.box_share_fn(t)
          let px = b.tmp()
          b.w("  ${px} = ptrtoint ptr %x to i64\n  call void @xo_x_obj_rc_defer_n(i64 ${px}, i64 ptrtoint (ptr ${sf} to i64)) #6\n")
        }
        b.w("  br label %done\n")
      }
      b.w("done:\n  ret void\n")
    }
    Func => {
      // the environment: null for a closure without captures
      let env = b.tmp()
      b.w("  ${env} = extractvalue { ptr, ptr } %x, 1\n")
      let is_null = b.tmp()
      b.w("  ${is_null} = icmp eq ptr ${env}, null\n  br i1 ${is_null}, label %done, label %live\nlive:\n")
      if kind == "dup" {
        rc_inc(b, env)
      } else if kind == "drop" {
        rc_dec_fast(b, env, g.drop_slow_fn(t))
        g.drop_free(b, t, env)
      } else {
        rc_mark(b, env)
        let sp = b.tmp()
        let sfn = b.tmp()
        let pe = b.tmp()
        b.w("  ${sp} = getelementptr i8, ptr ${env}, i64 16\n  ${sfn} = load i64, ptr ${sp}\n  ${pe} = ptrtoint ptr ${env} to i64\n  call void @xo_x_obj_rc_defer_n(i64 ${pe}, i64 ${sfn}) #6\n  br label %done\n")
      }
      b.w("done:\n  ret void\n")
    }
    Struct | Tuple => {
      var fts: List[Int] = []
      if k == ssa.Kind.Struct {
        for f in g.m.types[t].fields {
          fts.push(f.ty)
        }
      } else {
        fts = g.m.types[t].elems
      }
      for (i, ft) in fts.indexed() {
        if !g.heap(ft) {
          continue
        }
        let hf = g.rc_fn(kind, ft)
        let fl = g.ll(ft)
        if by_ptr {
          // each field read where it is: the struct is never copied
          let fp = b.tmp()
          b.w("  ${fp} = getelementptr ${lt}, ptr %x, i32 0, i32 ${i}\n")
          b.w(g.rc_at(hf, ft, fp, b.tmp()))
          continue
        }
        let fv = b.tmp()
        b.w("  ${fv} = extractvalue ${lt} %x, ${i}\n")
        b.w("  call void ${hf}(${fl} ${fv})\n")
      }
      b.w("  ret void\n")
    }
    Enum => {
      var p = "%x"
      let tag = b.tmp()
      if by_ptr {
        b.w("  ${tag} = load i64, ptr %x\n")
      } else {
        p = b.tmp()
        b.w("  ${p} = alloca ${lt}\n  store ${lt} %x, ptr ${p}\n")
        b.w("  ${tag} = extractvalue ${lt} %x, 0\n")
      }
      var cases: List[Str] = []
      var bodies: List[Str] = []
      let nv = g.m.types[t].variants.len()
      for vi in 0..nv {
        let fields = g.m.types[t].variants[vi].fields
        var heap = false
        for f in fields {
          heap = heap || g.heap(f.ty)
        }
        if !heap {
          continue
        }
        cases.push("i64 ${vi}, label %v${vi}")
        bodies.push("v${vi}:\n")
        let pay = b.tmp()
        bodies.push("  ${pay} = getelementptr ${lt}, ptr ${p}, i32 0, i32 1\n")
        let vl = g.variant_ll(t, vi)
        for (fi, f) in fields.indexed() {
          if !g.heap(f.ty) {
            continue
          }
          let fp = b.tmp()
          bodies.push("  ${fp} = getelementptr ${vl}, ptr ${pay}, i32 0, i32 ${fi}\n")
          let hf = g.rc_fn(kind, f.ty)
          bodies.push(g.rc_at(hf, f.ty, fp, b.tmp()))
        }
        bodies.push("  br label %done\n")
      }
      b.w("  switch i64 ${tag}, label %done [ ${cases.join(" ")} ]\n")
      b.w(bodies.join(""))
      b.w("done:\n  ret void\n")
    }
    _ => b.w("  ret void\n")
  }
  b.w("}\n\n")
  g.helpers.push(b.lines.join(""))
  name
}

/// The out of line half of the drop helper of t (Str, List, Box, Func,
/// Handle): given the counted object (a Func's environment), the rest
/// of rc_dec and the free; nounwind, cold, never inlined, one per type
/// (each inlined release used to carry its own copy, which LLVM split
/// into a cold piece: 4.16 MB of xo, bench/results/xo-code-size).
fn (var g: Gen) drop_slow_fn(t: Int) -> Str {
  let name = "@${"xo.dropslow.${g.m.types[t].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  var b = H{}
  b.w("define internal void ${name}(ptr %o) #3 {\n")
  rc_dec(b, "%o")
  g.drop_free(b, t, "%o")
  b.w("done:\n  ret void\n}\n\n")
  g.helpers.push(b.lines.join(""))
  name
}

/// The %free block of t's drop helper for the counted object obj: the
/// runtime's free, then `br label %done`.
fn (var g: Gen) drop_free(var b: H, t: Int, obj: Str) {
  let po = b.tmp()
  b.w("free:\n  ${po} = ptrtoint ptr ${obj} to i64\n")
  match g.kind(t) {
    Str => b.w("  call void @xo_x_obj_rc_free(i64 ${po}) #8\n")
    List => {
      let et = g.m.types[t].elems[0]
      let sz = g.size(et)
      let ef = g.elem_fn("drop", et)
      // obj.xo's export, inlined at the call as the C entry
      // xo_rl_free inlined it (XO_INLINE_CALL)
      b.w("  call void @xo_x_obj_rl_free_n(i64 ${po}, i64 ${sz}, i64 ptrtoint (ptr ${ef} to i64)) #6\n")
    }
    Handle => b.w("  call void @xo_x_obj_h_free(i64 ${po}) #8\n")
    Box => {
      // deferred: a long chain of boxes is freed with a worklist
      let df = g.box_drop_fn(t)
      b.w("  call void @xo_x_obj_rc_defer_n(i64 ${po}, i64 ptrtoint (ptr ${df} to i64)) #6\n")
    }
    Func => {
      // the drop function frees the environment; deferred so long chains
      // do not recurse on the C stack
      let dp = b.tmp()
      let dfn = b.tmp()
      b.w("  ${dp} = getelementptr i8, ptr ${obj}, i64 8\n  ${dfn} = load i64, ptr ${dp}\n  call void @xo_x_obj_rc_defer_n(i64 ${po}, i64 ${dfn}) #6\n")
    }
    _ => {}
  }
  b.w("  br label %done\n")
}

// The count tests of decision 0058 (std/llrt/xo_rt.c, "Reference
// counts"): a positive count is thread local, a negative count -n is
// shared (atomic), and the immortal count of literals has bit 62 clear
// where every shared count has it set. Each writes the code of one
// helper from its entry, ending in `br label %done` (and rc_dec in
// branches to %free, which the caller writes).

/// The increment of the count at obj (rcInc).
fn rc_inc(var b: H, obj: Str) {
  let c = b.tmp()
  let slow = b.tmp()
  let c1 = b.tmp()
  b.w("  ${c} = load atomic i64, ptr ${obj} unordered, align 8${TBAA_RC}\n")
  b.w("  ${slow} = icmp slt i64 ${c}, 1\n  br i1 ${slow}, label %shared, label %inc, !prof !0\n")
  b.w("inc:\n  ${c1} = add i64 ${c}, 1\n  store i64 ${c1}, ptr ${obj}${TBAA_RC}\n  br label %done\n")
  let sb = b.tmp()
  let sh = b.tmp()
  b.w("shared:\n  ${sb} = and i64 ${c}, ${SHARED_BIT}\n  ${sh} = icmp ne i64 ${sb}, 0\n  br i1 ${sh}, label %atomic, label %done\n")
  b.w("atomic:\n  atomicrmw add ptr ${obj}, i64 -1 monotonic, align 8\n  br label %done\n")
}

/// A drop helper's inline half: the decrement of a thread local count
/// above one; the last thread local reference branches to %free (the
/// caller writes it: one call of the runtime's free, as common as a
/// decrement on hot paths, so not behind a second call); a shared or
/// immortal count calls slow (drop_slow_fn), out of line and cold, which
/// does the rest. Ends in `br label %done` or `%free`.
fn rc_dec_fast(var b: H, obj: Str, slow: Str) {
  let c = b.tmp()
  let s = b.tmp()
  let c1 = b.tmp()
  let one = b.tmp()
  b.w("  ${c} = load atomic i64, ptr ${obj} unordered, align 8${TBAA_RC}\n")
  b.w("  ${s} = icmp slt i64 ${c}, 2\n  br i1 ${s}, label %slow, label %dec, !prof !0\n")
  b.w("dec:\n  ${c1} = sub i64 ${c}, 1\n  store i64 ${c1}, ptr ${obj}${TBAA_RC}\n  br label %done\n")
  let sb = b.tmp()
  let sh = b.tmp()
  b.w("slow:\n  ${one} = icmp eq i64 ${c}, 1\n  br i1 ${one}, label %free, label %shared\n")
  // an immortal count (bit 62 clear) is left alone inline; only a shared
  // one (its atomic decrement, maybe the free) is out of line
  b.w("shared:\n  ${sb} = and i64 ${c}, ${SHARED_BIT}\n  ${sh} = icmp ne i64 ${sb}, 0\n  br i1 ${sh}, label %atomic, label %done\n")
  b.w("atomic:\n  call void ${slow}(ptr ${obj}) #3\n  br label %done\n")
}

/// The decrement of the count at obj, branching to %free when it was the
/// last reference (rcDec).
fn rc_dec(var b: H, obj: Str) {
  let c = b.tmp()
  let slow = b.tmp()
  let c1 = b.tmp()
  let one = b.tmp()
  let sb = b.tmp()
  let sh = b.tmp()
  let old = b.tmp()
  let last = b.tmp()
  b.w("  ${c} = load atomic i64, ptr ${obj} unordered, align 8${TBAA_RC}\n")
  b.w("  ${slow} = icmp slt i64 ${c}, 2\n  br i1 ${slow}, label %slow, label %dec, !prof !0\n")
  b.w("dec:\n  ${c1} = sub i64 ${c}, 1\n  store i64 ${c1}, ptr ${obj}${TBAA_RC}\n  br label %done\n")
  b.w("slow:\n  ${one} = icmp eq i64 ${c}, 1\n  br i1 ${one}, label %free, label %shared\n")
  b.w("shared:\n  ${sb} = and i64 ${c}, ${SHARED_BIT}\n  ${sh} = icmp ne i64 ${sb}, 0\n  br i1 ${sh}, label %atomic, label %done\n")
  b.w("atomic:\n  ${old} = atomicrmw add ptr ${obj}, i64 1 acq_rel, align 8\n  ${last} = icmp eq i64 ${old}, -1\n  br i1 ${last}, label %free, label %done\n")
}

/// The marking of the count at obj as shared (rcMark); the code after it
/// (in block %mark) runs when the count was thread local.
fn rc_mark(var b: H, obj: Str) {
  let c = b.tmp()
  let loc = b.tmp()
  let n = b.tmp()
  b.w("  ${c} = load atomic i64, ptr ${obj} unordered, align 8${TBAA_RC}\n")
  b.w("  ${loc} = icmp sgt i64 ${c}, 0\n  br i1 ${loc}, label %mark, label %done\n")
  b.w("mark:\n  ${n} = sub i64 0, ${c}\n  store i64 ${n}, ptr ${obj}${TBAA_RC}\n")
}

/// The target's OS, the compiler's own when the driver did not say.
fn (g: Gen) os() -> Str {
  if !g.goos.is_empty() {
    return g.goos
  }
  match target.os {
    Darwin => "darwin"
    Linux => "linux"
    Windows => "windows"
    Wasi => "wasip1"
  }
}

/// The target's architecture, arm64 when the driver did not say.
fn (g: Gen) arch() -> Str {
  if g.goarch.is_empty() { "arm64" } else { g.goarch }
}

/// The personality routine the unwind tables name (decision 0221): the
/// runtime's export xo_x_personality (std/native/llrt/cabi.xo, defined
/// in the module; on Windows the language handler, which passes every
/// system exception on, decision 0197), on every target since stage 2
/// (x86_64 Linux and macOS unwind in Xo too, 2026-10-15).
fn (g: Gen) personality() -> Str { "xo_x_personality" }

/// The rt_sigreturn trampoline that rt_sigaction's sa_restorer names
/// (decision 0206), written at its first use: a naked function of the
/// system call, 139 on arm64 and 15 on x86_64.
fn (var g: Gen) sigreturn() {
  let name = "@xo_sigreturn"
  if g.emitted.contains(name) {
    return
  }
  g.emitted[name] = true
  let body = if g.arch() == "amd64" { "movl $$15, %eax\\0Asyscall" } else { "mov x8, #139\\0Asvc #0" }
  g.helpers.push("define internal void ${name}() naked noinline nounwind {\n  call void asm sideeffect \"${body}\", \"\"()\n  unreachable\n}\n\n")
}

/// The clone trampoline of rt.sys_clone (decision 0206 stage 2), written
/// at its first use: a naked function of clone(2) whose child loads the
/// C function and its argument from its new stack, calls it, and exits
/// the thread. arm64: clone(flags, stack, ptid, tls, ctid) is 220, exit
/// 93; x86_64: clone(flags, stack, ptid, ctid, tls) is 56, exit 60.
fn (var g: Gen) clone_tramp() {
  let name = "@xo_clone"
  if g.emitted.contains(name) {
    return
  }
  g.emitted[name] = true
  let body = if g.arch() == "amd64" {
    "mov %rdx, %r10\\0Amov %rcx, %r8\\0Amovl $$56, %eax\\0Asyscall\\0Atest %rax, %rax\\0Ajz 1f\\0Aret\\0A1:\\0Axor %ebp, %ebp\\0Apop %rax\\0Apop %rdi\\0Acall *%rax\\0Axor %edi, %edi\\0Amovl $$60, %eax\\0Asyscall\\0Ahlt"
  } else {
    // the child is the thread's outermost frame: from it on, the
    // function's unwind entry (Linux clang gives a naked function one)
    // has the return address undefined, where gdb's backtrace ends
    "mov x4, x2\\0Amov x8, #220\\0Asvc #0\\0Acbz x0, 1f\\0Aret\\0A1:\\0A.cfi_escape 0x07, 30\\0Aldp x9, x0, [sp], #16\\0Amov x29, #0\\0Amov x30, #0\\0Ablr x9\\0Amov x0, #0\\0Amov x8, #93\\0Asvc #0\\0Abrk #1"
  }
  g.helpers.push("define internal i64 ${name}(i64, i64, i64, i64) naked noinline nounwind {\n  call void asm sideeffect \"${body}\", \"\"()\n  unreachable\n}\n\n")
}

/// The runtime callback that retains or releases a list element through
/// a pointer, or null when elements are not on the heap (elemFn).
fn (var g: Gen) elem_fn(kind: Str, t: Int) -> Str {
  if !g.heap(t) {
    return "null"
  }
  let name = "@${"xo.${kind}p.${g.m.types[t].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  let inner = g.rc_fn(kind, t)
  g.helpers.push("define internal void ${name}(ptr %p) #1 {\n${g.rc_at(inner, t, "%p", "%x")}  ret void\n}\n\n")
  name
}

/// The LLVM type of the cell of a Box[T]: {i64 rc, T}.
fn (var g: Gen) box_ll(t: Int) -> Str {
  "{ i64, ${g.ll(g.m.types[t].elems[0])} }"
}

/// The function that releases the contents of a box whose count reached
/// zero and frees it (boxDropFn).
fn (var g: Gen) box_drop_fn(t: Int) -> Str {
  let name = "@${"xo.boxdrop.${g.m.types[t].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  let et = g.m.types[t].elems[0]
  var b: List[Str] = []
  b.push("define internal void ${name}(ptr %p) #1 {\n")
  if g.heap(et) {
    b.push("  %vp = getelementptr ${g.box_ll(t)}, ptr %p, i32 0, i32 1\n")
    let df = g.rc_fn("drop", et)
    b.push(g.rc_at(df, et, "%vp", "%v"))
  }
  b.push("  %pi = ptrtoint ptr %p to i64\n  call void @xo_x_obj_rc_free(i64 %pi) #8\n  ret void\n}\n\n")
  g.helpers.push(b.join(""))
  name
}

/// The LLVM type of the environment of an indirect function fi: {i64 rc,
/// ptr drop, ptr share, captures...} (envLL).
fn (var g: Gen) env_ll(fi: Int) -> Str {
  var parts = ["i64", "ptr", "ptr"]
  for c in g.m.funcs[fi].captures {
    parts.push(g.ll(c))
  }
  "{ ${parts.join(", ")} }"
}

/// The function that releases the captures of an environment of fi and
/// frees it (envDropFn).
fn (var g: Gen) env_drop_fn(fi: Int) -> Str {
  let name = "@${"xo.envdrop.${g.m.funcs[fi].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  var b: List[Str] = []
  let el = g.env_ll(fi)
  b.push("define internal void ${name}(ptr %e) #1 {\n")
  for (i, c) in g.m.funcs[fi].captures.indexed() {
    if !g.heap(c) {
      continue
    }
    b.push("  %p${i} = getelementptr ${el}, ptr %e, i32 0, i32 ${i + ENV_FIELDS}\n")
    let df = g.rc_fn("drop", c)
    b.push(g.rc_at(df, c, "%p${i}", "%c${i}"))
  }
  b.push("  %ei = ptrtoint ptr %e to i64\n  call void @xo_x_obj_rc_free(i64 %ei) #8\n  ret void\n}\n\n")
  g.helpers.push(b.join(""))
  name
}

/// The function that marks the captures of an environment of fi shared
/// (envShareFn; the environment itself was just marked).
fn (var g: Gen) env_share_fn(fi: Int) -> Str {
  let name = "@${"xo.envshare.${g.m.funcs[fi].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  var b: List[Str] = []
  let el = g.env_ll(fi)
  b.push("define internal void ${name}(ptr %e) #1 {\n")
  for (i, c) in g.m.funcs[fi].captures.indexed() {
    if !g.heap(c) {
      continue
    }
    b.push("  %p${i} = getelementptr ${el}, ptr %e, i32 0, i32 ${i + ENV_FIELDS}\n")
    let sf = g.rc_fn("share", c)
    b.push(g.rc_at(sf, c, "%p${i}", "%c${i}"))
  }
  b.push("  ret void\n}\n\n")
  g.helpers.push(b.join(""))
  name
}

/// The function that marks the contents of a box of type t shared
/// (boxShareFn; the box itself was just marked).
fn (var g: Gen) box_share_fn(t: Int) -> Str {
  let name = "@${"xo.boxshare.${g.m.types[t].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  let et = g.m.types[t].elems[0]
  var b: List[Str] = []
  b.push("define internal void ${name}(ptr %p) #1 {\n")
  b.push("  %vp = getelementptr ${g.box_ll(t)}, ptr %p, i32 0, i32 1\n")
  let sf = g.rc_fn("share", et)
  b.push(g.rc_at(sf, et, "%vp", "%v"))
  b.push("  ret void\n}\n\n")
  g.helpers.push(b.join(""))
  name
}

// ---------------------------------------------------------------------------
// Equality

/// The text of an equality helper being written: the current block's
/// lines and the temporaries (eqFn's w, tmp, def, emit).
struct E {
  w: List[Str] = []
  n: Int = 0
}

fn (var e: E) tmp() -> Str {
  e.n += 1
  "%t${e.n}"
}

fn (var e: E) emit(s: Str) {
  e.w.push("  ${s}\n")
}

fn (var e: E) def(s: Str) -> Str {
  let r = e.tmp()
  e.emit("${r} = ${s}")
  r
}

/// The comparison of x and y of type ft in an equality helper (eqFn's
/// eq).
fn (var g: Gen) eq_of(var e: E, ft: Int, x: Str, y: Str) -> Str {
  match g.kind(ft) {
    Unit | Cap => return "true"
    Int => return e.def("icmp eq i64 ${x}, ${y}")
    Bool => return e.def("icmp eq i1 ${x}, ${y}")
    Float => return e.def("fcmp oeq double ${x}, ${y}")
    _ => {}
  }
  let f = g.eq_fn(ft)
  let l1 = g.ll(ft)
  let l2 = g.ll(ft)
  e.def("call i1 ${f}(${l1} ${x}, ${l2} ${y})")
}

/// The helper that compares two values of type t structurally (`==` on
/// strings, structs, tuples, enums, and lists), written at its first use
/// (eqFn).
fn (var g: Gen) eq_fn(t: Int) -> Str {
  let name = "@${"xo.eq.${g.m.types[t].name}".quote()}"
  if g.emitted.contains(name) {
    return name
  }
  g.emitted[name] = true
  var e = E{}
  let lt = g.ll(t)
  var allocas = ""
  let k = g.kind(t)
  match k {
    Box => {
      // the same cell, or equal contents; a cell holding a Float is
      // always compared (NaN is not equal to itself, decisions/0053)
      let et = g.m.types[t].elems[0]
      if g.has_float(et) {
        e.emit("br label %cmp")
      } else {
        let same = e.def("icmp eq ptr %a, %b")
        e.emit("br i1 ${same}, label %yes, label %cmp")
      }
      e.w.push("cmp:\n")
      let bl1 = g.box_ll(t)
      let pa = e.def("getelementptr ${bl1}, ptr %a, i32 0, i32 1")
      let bl2 = g.box_ll(t)
      let pb = e.def("getelementptr ${bl2}, ptr %b, i32 0, i32 1")
      let x = e.def("load ${g.ll(et)}, ptr ${pa}")
      let y = e.def("load ${g.ll(et)}, ptr ${pb}")
      let r = g.eq_of(e, et, x, y)
      e.emit("ret i1 ${r}")
      e.w.push("yes:\n  ret i1 true\n")
    }
    Str => {
      let oa = e.def("extractvalue %xo.str %a, 0")
      let da = e.def("getelementptr i8, ptr ${oa}, i64 16")
      let na = e.def("extractvalue %xo.str %a, 1")
      let ob = e.def("extractvalue %xo.str %b, 0")
      let db = e.def("getelementptr i8, ptr ${ob}, i64 16")
      let nb = e.def("extractvalue %xo.str %b, 1")
      let pa = e.def("ptrtoint ptr ${da} to i64")
      let pb = e.def("ptrtoint ptr ${db} to i64")
      let r = e.def("call i64 @xo_x_obj_str_eq(i64 ${pa}, i64 ${na}, i64 ${pb}, i64 ${nb}) #6")
      let c = e.def("icmp ne i64 ${r}, 0")
      e.emit("ret i1 ${c}")
    }
    Struct | Tuple => {
      var fts: List[Int] = []
      if k == ssa.Kind.Struct {
        for f in g.m.types[t].fields {
          fts.push(f.ty)
        }
      } else {
        fts = g.m.types[t].elems
      }
      var acc = "true"
      for (i, ft) in fts.indexed() {
        if g.is_void(ft) {
          continue
        }
        let x = e.def("extractvalue ${lt} %a, ${i}")
        let y = e.def("extractvalue ${lt} %b, ${i}")
        let r = g.eq_of(e, ft, x, y)
        acc = e.def("and i1 ${acc}, ${r}")
      }
      e.emit("ret i1 ${acc}")
    }
    Enum => {
      let ta = e.def("extractvalue ${lt} %a, 0")
      let tb = e.def("extractvalue ${lt} %b, 0")
      let same = e.def("icmp eq i64 ${ta}, ${tb}")
      e.emit("br i1 ${same}, label %tags, label %no")
      e.w.push("tags:\n")
      let pa = e.tmp()
      let pb = e.tmp()
      allocas = "  ${pa} = alloca ${lt}\n  ${pb} = alloca ${lt}\n"
      e.emit("store ${lt} %a, ptr ${pa}")
      e.emit("store ${lt} %b, ptr ${pb}")
      let head = e.w
      e.w = []
      var cases: List[Str] = []
      let nv = g.m.types[t].variants.len()
      for vi in 0..nv {
        let fields = g.m.types[t].variants[vi].fields
        if fields.is_empty() {
          continue
        }
        cases.push("i64 ${vi}, label %v${vi}")
        e.w.push("v${vi}:\n")
        let vl = g.variant_ll(t, vi)
        let pay_a = e.def("getelementptr ${lt}, ptr ${pa}, i32 0, i32 1")
        let pay_b = e.def("getelementptr ${lt}, ptr ${pb}, i32 0, i32 1")
        var acc = "true"
        for (fi, f) in fields.indexed() {
          if g.is_void(f.ty) {
            continue
          }
          let fa = e.def("getelementptr ${vl}, ptr ${pay_a}, i32 0, i32 ${fi}")
          let fb = e.def("getelementptr ${vl}, ptr ${pay_b}, i32 0, i32 ${fi}")
          let x = e.def("load ${g.ll(f.ty)}, ptr ${fa}")
          let y = e.def("load ${g.ll(f.ty)}, ptr ${fb}")
          let r = g.eq_of(e, f.ty, x, y)
          acc = e.def("and i1 ${acc}, ${r}")
        }
        e.emit("ret i1 ${acc}")
      }
      let arms = e.w
      e.w = head
      e.emit("switch i64 ${ta}, label %yes [ ${cases.join(" ")} ]")
      e.w.push(arms.join(""))
      e.w.push("yes:\n  ret i1 true\nno:\n  ret i1 false\n")
    }
    List => {
      let et = g.m.types[t].elems[0]
      let p0 = e.def("getelementptr %xo.rlist, ptr %a, i32 0, i32 1")
      let l0 = e.def("load i64, ptr ${p0}${HDR_COUNT}")
      let p1 = e.def("getelementptr %xo.rlist, ptr %b, i32 0, i32 1")
      let l1 = e.def("load i64, ptr ${p1}${HDR_COUNT}")
      let same = e.def("icmp eq i64 ${l0}, ${l1}")
      e.emit("br i1 ${same}, label %loop, label %no")
      e.w.push("loop:\n")
      e.emit("%i = phi i64 [ 0, %entry ], [ %i1, %next ]")
      let done = e.def("icmp eq i64 %i, ${l0}")
      e.emit("br i1 ${done}, label %yes, label %body")
      e.w.push("body:\n")
      var r = "true"
      if !g.is_void(et) {
        let da = e.def("getelementptr %xo.rlist, ptr %a, i64 1")
        let db = e.def("getelementptr %xo.rlist, ptr %b, i64 1")
        let xa = e.def("getelementptr ${g.ll(et)}, ptr ${da}, i64 %i")
        let xb = e.def("getelementptr ${g.ll(et)}, ptr ${db}, i64 %i")
        let x = e.def("load ${g.ll(et)}, ptr ${xa}${TBAA_ELEM}")
        let y = e.def("load ${g.ll(et)}, ptr ${xb}${TBAA_ELEM}")
        r = g.eq_of(e, et, x, y)
      }
      e.emit("br i1 ${r}, label %next, label %no")
      e.w.push("next:\n")
      e.emit("%i1 = add i64 %i, 1")
      e.emit("br label %loop")
      e.w.push("yes:\n  ret i1 true\nno:\n  ret i1 false\n")
    }
    _ => g.fail("the SSA lowering does not compare `${g.m.types[t].name}`")
  }
  g.helpers.push("define internal i1 ${name}(${lt} %a, ${lt} %b) #1 {\nentry:\n${allocas}${e.w.join("")}}\n\n")
  name
}
