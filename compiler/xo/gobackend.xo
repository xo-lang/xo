// `xo1 build --backend=go` (decision 0167): the checker and the Go code
// generator in Xo (compiler/gen), then the Go toolchain, as internal/build
// does for `xo build --backend=go`: the generated packages after
// internal/gen's last step (compiler/gen format_prep, then gofmt), the
// runtime package copied from DIR/rt (DIR the std directory), the build
// information, the zone data (internal/build tzFiles, embedded from the
// Go toolchain's zoneinfo.zip), and `go build`.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/gen
use github.com/xo-lang/xo/compiler/prune
use github.com/xo-lang/xo/compiler/tzsel
use std/internal
use github.com/xo-lang/xo/compiler/hostpath

/// Builds o.dirs with the Go backend (internal/build Build with the Go
/// backend): the tree is the Go driver's build directory (or --go-tree),
/// each target of --targets is built with GOOS and GOARCH, through the
/// binary cache when XO_BIN_CACHE is set.
///
/// build prints `os/arch: path` lines (or the JSON result); run executes
/// the host binary with the program's arguments (XO_SEED for --seed,
/// XO_RECORD for --record); test runs the test binary as `xo test` does
/// for the Go backend: the binary runs the tests itself, with -seed,
/// -explore, -run, -json, -v, -real, -cases from o; its exit status is
/// xo1's; shrunk contract fuzz failures become regression tests
/// (regress.xo).
fn build_go(os: Os, ctx: Ctx, o: Opts) ! {
  let tests = o.cmd == "test"
  let c = check_program(os, o, false)
  let wd = o.wd
  let root = abs_line_root(os, wd, o.dirs[0])
  let release = o.release && !tests
  if debug_info_eff(o, release) == "split" {
    fail(os, "--debug-info=split is for the native and LLVM backends, not --backend=go (decision 0355)")
  }
  var opts = gen.Opts{arenas: !o.no_arenas, line_root: root, wd: wd}
  opts.test_mode = tests
  opts.holes = o.holes
  opts.no_mono = o.no_mono
  opts.release = release
  // the settings --release presets, each overridable (decision 0354)
  opts.no_error_args = !error_args_eff(o)
  opts.debug_contracts = debug_contracts_eff(o, release)
  opts.dbg = dbg_eff(o, release)
  opts.gc = gc_line(os, root)
  let prog = gen.generate(c, opts)
  if !prog.err.is_empty() {
    fail(os, prog.err)
  }
  if !prog.skipped.is_empty() {
    fail(os, "the generator skipped ${prog.skipped[0]}")
  }
  var name = prog_name(wd, o.dirs)
  if tests {
    name = "${name}.test"
  }
  var out = o.out
  if !out.is_empty() {
    out = abs_of(wd, out)
    if is_dir(os, out) {
      // -o DIR, an existing directory: DIR/NAME, as go build -o does
      out = "${out.trim_suffix("/")}/"
    }
  }
  var tree = o.go_tree
  if tree.is_empty() {
    var variants: List[Str] = []
    if release {
      variants.push("release")
    }
    // a tree per setting that differs from a debug build's (decision 0354)
    if !error_args_eff(o) {
      variants.push("noargs")
    }
    if !debug_contracts_eff(o, release) {
      variants.push("nodebugc")
    }
    if !dbg_eff(o, release) {
      variants.push("nodbg")
    }
    tree = build_dir(os, ctx, wd, o.dirs, if tests { 1 } else { 0 }, !o.no_mono, false, !o.no_arenas, variants)?
  } else {
    tree = abs_of(wd, tree)
  }
  // writeTree: generated packages left from an earlier build go first
  os.fs.remove_all("${tree}/m")?
  os.fs.remove_all("${tree}/rt")?
  os.fs.create_dir_all(tree)?
  for fi in os.fs.read_dir(tree)? {
    if !fi.is_dir && fi.name.ends_with(".go") {
      os.fs.remove("${tree}/${fi.name}")?
    }
  }
  // the generated files
  var written: List[Str] = []
  for f in prog.files {
    var text = f.text
    if f.path.starts_with("m/") && f.path.ends_with("/xo.go") {
      text = gen.format_prep(text)
    }
    write_file(os, "${tree}/${f.path}", text)?
    if f.path.ends_with(".go") {
      written.push("${tree}/${f.path}")
    }
  }
  if !tests {
    write_file(os, "${tree}/xo_buildinfo.go", build_info_file(os, c, root, o.dirs[0], wd, o.std, o))?
  }
  tz_files(os, ctx.std, prog.tz_names, prog.tz_dynamic, tree, o.tzdata, o.json && o.cmd == "build")?
  // the runtime
  os.fs.create_dir_all("${tree}/rt")?
  for fi in os.fs.read_dir("${o.std}/rt")? {
    if (fi.name.ends_with(".go") || fi.name.ends_with(".s")) && !fi.name.ends_with("_test.go") {
      os.fs.write("${tree}/rt/${fi.name}", os.fs.read("${o.std}/rt/${fi.name}")?)?
    }
  }
  // a program with Go callbacks (an adapter that registers one) builds
  // with the runtime's view of Go timers (needGoTimers)
  var timers = false
  if (os.env.get("XO_GOTIMERS") ?? "") != "off" {
    for f in prog.files {
      timers = timers || (f.path.starts_with("rt/xo_gobind_") && f.text.contains("NewGoCallback("))
    }
  }
  let gocmd = go_cmd(os)
  // gofmt, as internal/gen's file step ends
  let goroot = match os.proc.run(gocmd, ["env", "GOROOT"]) {
    Ok(r) => (r.stdout.to_str() ?? "").trim()
    Err(e) => fail(os, "go env GOROOT: ${e}")
  }
  let fr = os.proc.run("${goroot}/bin/gofmt", ["-w"] + written)?
  if fr.code != 0 {
    os.stdio.eprint((fr.stderr.to_str() ?? ""))
    fail(os, "gofmt failed on the generated Go (a code generator bug)")
  }
  let host = "${ctx.goos}/${host_arch()}"
  let targets = parse_targets(os, o.targets, host)
  if targets.len() > 1 && !out.is_empty() {
    os.fs.create_dir_all(out)?
  }
  // WASI preview1 has no sockets: Go's wasip1 net is an in-memory fake,
  // so a server there "listened" on nothing and spun at full CPU (a
  // 0.25.2 field report); refused as the wasm backend refuses it
  // (compiler/wasm call.xo), and std/rt fails listen and dial on wasip1
  let net_call = if prog.files.any(fn(f) { f.text.contains(".M_listen(") }) { "net.listen" } else if prog.files.any(fn(f) { f.text.contains(".M_dial(") }) { "net.dial" } else { "" }
  if !net_call.is_empty() && targets.any(fn(t) { t.starts_with("wasip1/") }) {
    fail(os, "the Go backend does not support the network on wasip1/wasm (`${net_call}`): WASI preview1 has no sockets")
  }
  var bins: List[(Str, Str)] = []
  for tg in targets {
    let bin = bin_path(tree, out, name, tg, targets.len() > 1)
    os.fs.create_dir_all(dir_name(bin))?
    // built in a hidden stage beside bin, then moved into place (ld.xo)
    let gst = stage(os, ctx, bin)
    // go build; with Go callbacks first with the runtime's view of Go
    // timers (goBuildTimers, decision 0073), again without it when this
    // Go does not link runtime.timeSleepUntil
    var res = (0, "")
    if timers {
      res = go_build(os, ctx, gocmd, tree, ["xo_gotimers"] + prog.tags, "-checklinkname=0 ", gst.bin, tg, o.race)?
      if res.0 != 0 && linkname_failed(res.1) {
        res = go_build(os, ctx, gocmd, tree, prog.tags, "", gst.bin, tg, o.race)?
        if res.0 == 0 {
          os.stdio.eprintln("xo build: warning: deadlock detection through Go callbacks is off: this Go toolchain does not link runtime.timeSleepUntil (decision 0073)")
          timers = false
        }
      }
    } else {
      res = go_build(os, ctx, gocmd, tree, prog.tags, "", gst.bin, tg, o.race)?
    }
    if res.0 != 0 {
      os.stdio.eprint(res.1)
      fail_stage(os, gst, "go build failed (a code generator bug)")
    }
    let gerr = gst.commit(os)
    if !gerr.is_empty() {
      fail(os, gerr)
    }
    bins.push((tg, bin))
  }
  // the outputs are in place: a stop from here on is the program's
  if let Some(d) = ctx.build_done {
    let _ = d.try_send(())
  }
  var host_bin = ""
  for (tg, p) in bins {
    if tg == host {
      host_bin = p
    }
  }
  if o.cmd == "build" {
    if o.json {
      os.stdio.print(build_json(true, bins, c.diags))
    } else {
      for (tg, p) in bins.sort_by(fn(x) { x.0 }) {
        os.stdio.println("${tg}: ${p}")
      }
    }
    return
  }
  if o.cmd == "run" {
    var env: List[Str] = []
    if o.topts.seed != 0 {
      env.push("XO_SEED=${o.topts.seed}")
    }
    if !o.record.is_empty() {
      let abs = abs_of(wd, o.record)
      env.push("XO_RECORD=${abs}")
      let code = exec_binary(os, host_bin, o.prog_args, env)
      // xo:allow XO0903 a path it cannot stat is not used
      if os.fs.exists(abs).ok() ?? false {
        os.stdio.eprintln("xo run: recorded ${o.record} (xo replay ${o.record})")
      }
      os.proc.exit(code)
    }
    os.proc.exit(exec_binary(os, host_bin, o.prog_args, env))
  }
  if tests {
    let topts = o.topts
    var targs: List[Str] = []
    if topts.seed != 0 {
      targs = targs + ["-seed", "${topts.seed}"]
    }
    if o.explore > 0 {
      targs = targs + ["-explore", "${o.explore}"]
    }
    if !topts.run.is_empty() {
      targs = targs + ["-run", topts.run]
    }
    if topts.json {
      targs.push("-json")
    }
    if topts.verbose {
      targs.push("-v")
    }
    if o.real {
      targs.push("-real")
    }
    if topts.cases > 0 {
      targs = targs + ["-cases", "${topts.cases}"]
    }
    if topts.timeout != 60s {
      targs = targs + ["-timeout", "${topts.timeout}"]
    }
    // shrunk contract fuzz failures become regression tests (core 9.2),
    // through a file in the test binary's environment
    let rf = "${hostpath.temp_dir(os.env)}/xo-regressions-${os.rand.bytes(6).to_hex()}.jsonl"
    let made = os.fs.write(rf, b"").is_ok()
    let code = exec_binary(os, host_bin, targs, if made { ["XO_REGRESSION_OUT=${rf}"] } else { [] })
    if made {
      write_regressions(os, rf, o.std)
      os.fs.remove(rf).ignore_err("a temporary file")
    }
    os.proc.exit(code)
  }
}

/// goTool: $XO_GO, else go.
fn go_cmd(os: Os) -> Str {
  let g = os.env.get("XO_GO") ?? ""
  if g.is_empty() { "go" } else { g }
}

/// GoCacheDir: $XO_GOCACHE, else <user cache>/xo/gocache (decision 0176).
fn go_cache_dir(os: Os, ctx: Ctx) -> Str {
  let d = os.env.get("XO_GOCACHE") ?? ""
  if !d.is_empty() {
    return d
  }
  "${ctx.cache}/xo/gocache"
}

/// The shared lock on the Xo Go cache that a go command holds while it
/// runs (internal/gotool HoldCache and LockCacheShared, the same files
/// and protocol, gotchas/go-commands-outside-build-race-trim.md): a trim
/// (internal/build's gocache.go) takes xo-gate.lock and then
/// xo-cache.lock exclusively and may remove any entry, so a go command
/// passes through the gate (shared) and holds xo-cache.lock shared. None
/// (run unlocked, as before locks existed) on any error. Never hold it
/// around something that itself runs an Xo build: a trim waiting at the
/// gate would deadlock with the nested lock.
fn hold_go_cache(os: Os, ctx: Ctx) -> internal.SharedLock? {
  let dir = go_cache_dir(os, ctx)
  if os.fs.create_dir_all(dir).is_err() {
    return None
  }
  let gate = match internal.lock_shared(os.fs, "${dir}/xo-gate.lock") {
    Ok(l) => l
    Err(_) => return None
  }
  let cache = internal.lock_shared(os.fs, "${dir}/xo-cache.lock").ok()
  gate.unlock()
  cache
}

/// Prunes the Go cache per file (prune.run; decision 0223): at most
/// hourly, files unused past $XO_CACHE_MAX_AGE (default 24h), then the
/// least recently used over $XO_CACHE_MAX_GB (default 20, or
/// $XO_GOCACHE_MAX bytes). Go refreshes a file's time when it uses it
/// and the time is over an hour old, and treats a missing file as a
/// miss, so removing files unused for 75 minutes is safe without the
/// cache lock: a go command in flight uses only files it refreshed (or
/// wrote) within the hour. Top level files (README, trim.txt, the
/// xo-*.lock files) are never removed.
fn prune_go_cache(os: Os, ctx: Ctx) {
  // 75 minutes, not prune.KEEP's 2 hours: Go refreshes a file's time
  // once it is an hour old, so a go command in flight has used each of
  // its files within an hour plus its own run (2026-10-21: 21.5 GB used
  // within 2 hours held the cache over its 20 GB cap). Shorter needs the
  // trim's exclusive locks, which std/internal cannot try yet.
  prune.run(os.fs, os.clock, go_cache_dir(os, ctx), cap_env(os, prune.from_env(os.env, prune.Policy{keep: GO_CACHE_KEEP}), "XO_GOCACHE_MAX"))
}

/// How long the Go cache keeps a file after its last use (prune_go_cache).
const GO_CACHE_KEEP: Duration = 75m

fn release_go_cache(l: internal.SharedLock?) {
  if let Some(h) = l {
    h.unlock()
  }
}

/// One `go build` of the tree for target tg with tags and the linker
/// flags ld before -s -w (goBuild), through the binary cache: its exit
/// status and output.
fn go_build(os: Os, ctx: Ctx, gocmd: Str, tree: Str, tags: List[Str], ld: Str, out: Str, tg: Str, race: Bool) -> (Int, Str) ! ProcErr {
  var args = ["build", "-trimpath"]
  if !tags.is_empty() {
    args.push("-tags=" + tags.join(","))
  }
  args = args + ["-gcflags=all=-dwarf=false", "-ldflags=${ld}-s -w"]
  if race {
    args.push("-race")
  }
  let key = go_bin_key(os, ctx, gocmd, tree, args + ["."], tg, race)
  let (hit, entry) = fetch_bin(os, ctx, key, out)
  if hit {
    return Ok((0, ""))
  }
  let parts = tg.split("/")
  let cgo = if race { "CGO_ENABLED=1" } else { "CGO_ENABLED=0" }
  let env = ["GOOS=${parts[0]}", "GOARCH=${parts[1]}", "GOWORK=off", "GOFLAGS=", "GOCACHE=${go_cache_dir(os, ctx)}", cgo]
  let held = hold_go_cache(os, ctx)
  let br = match os.proc.run("env", env + [gocmd, "-C", tree] + args + ["-o", out, "."]) {
    Ok(r) => r
    Err(e) => {
      release_go_cache(held)
      return Err(e)
    }
  }
  release_go_cache(held)
  if br.code == 0 {
    store_bin(os, ctx, entry, out)
  }
  prune_go_cache(os, ctx)
  Ok((br.code, (br.stdout + br.stderr).to_str() ?? ""))
}

/// linknameFailed: go build output of a failed link of a runtime symbol
/// pulled by a linkname.
fn linkname_failed(out: Str) -> Bool {
  out.contains("relocation target runtime.") || out.contains("invalid reference to runtime.") ||
    (out.contains("undefined") && out.contains("runtime."))
}

fn write_file(os: Os, path: Str, text: Str) -> () ! Str {
  let i = last_slash(path)
  if i > 0 {
    match os.fs.create_dir_all(path.bytes()[0..i].to_str() ?? "") {
      Ok(_) => {}
      Err(e) => return Err("${e}")
    }
  }
  match os.fs.write(path, text.bytes()) {
    Ok(_) => Ok(())
    Err(e) => Err("${e}")
  }
}

fn last_slash(s: Str) -> Int {
  let bs = s.bytes()
  var i = bs.len() - 1
  while i >= 0 {
    if bs[i] == '/' {
      return i
    }
    i -= 1
  }
  -1
}

/// The directory //line paths are relative to (internal/build lineRoot),
/// absolute.
fn abs_line_root(os: Os, wd: Str, dir: Str) -> Str {
  let rel = line_root(os, wd, dir)
  if is_abs_path(rel) {
    return rel
  }
  if rel == "." || rel.is_empty() {
    return wd
  }
  "${wd}/${rel.trim_prefix("./")}"
}

/// The `gc` lines of the xo.mod at root as the statement main runs
/// (decision 0065), "" for none.
fn gc_line(os: Os, root: Str) -> Str {
  let text = match os.fs.read_text("${root}/xo.mod") {
    Ok(t) => t
    Err(_) => return ""
  }
  var percent = -1
  var min_heap = -1
  var limit = -1
  for l in text.lines() {
    var fs: List[Str] = []
    for p in l.replace("\t", " ").split(" ") {
      if !p.is_empty() {
        fs.push(p)
      }
    }
    if fs.len() != 3 || fs[0] != "gc" {
      continue
    }
    if fs[1] == "percent" {
      percent = if fs[2] == "off" { -2 } else { Int.parse(fs[2]) ?? -1 }
    } else if fs[1] == "min_heap" {
      min_heap = byte_size(fs[2])
    } else if fs[1] == "memory_limit" {
      limit = byte_size(fs[2])
    }
  }
  if percent == -1 && min_heap == -1 && limit == -1 {
    return ""
  }
  "rt.GCConfig(${percent}, ${min_heap}, ${limit}); "
}

fn byte_size(s: Str) -> Int {
  for (suf, n) in [("KiB", 1024), ("MiB", 1048576), ("GiB", 1073741824), ("TiB", 1099511627776), ("KB", 1000), ("MB", 1000000), ("GB", 1000000000), ("TB", 1000000000000), ("B", 1)] {
    if s.ends_with(suf) {
      return (Int.parse(s.trim_suffix(suf)) ?? -1) * n
    }
  }
  Int.parse(s) ?? -1
}

/// The Go file of package main that hands the build information
/// (binfo.xo build_info_json) to the runtime.
fn build_info_file(os: Os, c: check.Checker, root: Str, dir: Str, wd: Str, std_dir: Str, o: Opts) -> Str {
  let j = build_info_json(os, binfo_sources(c, root, wd), dir, wd, std_dir, o, "go", if o.targets.is_empty() { "${host_os(os)}/${host_arch()}" } else { o.targets })
  "// Code generated by xo. DO NOT EDIT.\n\npackage main\n\nimport rt \"xoprog/rt\"\n\nfunc init() { rt.SetBuildInfo(${j.quote()}) }\n"
}

/// package main's xo_tzdata.go (internal/build tzFiles): with
/// --tzdata=embedded (the default) the TZif data of each constant zone
/// name, or the whole zoneinfo.zip when a name is known only at run time;
/// with --tzdata=system the host's database; nothing when no zone is
/// asked for.
fn tz_files(os: Os, std: Str, names0: List[Str], dynamic: List[Str], tree: Str, mode: Str, quiet: Bool) -> () ! Str {
  if !(mode is "" | "embedded" | "system") {
    return Err("unknown --tzdata=${mode} (want embedded or system)")
  }
  if mode == "system" {
    if names0.is_empty() && dynamic.is_empty() {
      return Ok(())
    }
    return write_file(os, "${tree}/xo_tzdata.go", "// Code generated by xo build. DO NOT EDIT.\n\npackage main\n\nimport \"xoprog/rt\"\n\nfunc init() { rt.TZUseSystem() }\n")
  }
  var names: List[Str] = []
  for n in names0 {
    if n != "UTC" && !n.is_empty() && n != "Local" {
      names.push(n)
    }
  }
  if names.is_empty() && dynamic.is_empty() {
    return Ok(())
  }
  // std's IANA database (tz.xo zoneinfo_zip, decision 0094's
  // addendum), as the native backends'
  var path = os.env.get("XO_ZONEINFO") ?? ""
  if path.is_empty() {
    path = "${std}/tzdata/zoneinfo.zip"
  }
  let zip = match os.fs.read(path) {
    Ok(z) => z
    Err(e) => return Err("zone data: ${e} (set XO_ZONEINFO to a zoneinfo.zip)")
  }
  var b = "// Code generated by xo build. DO NOT EDIT.\n\npackage main\n\n"
  if !dynamic.is_empty() {
    for at in dynamic {
      if quiet {
        continue
      }
      os.stdio.eprintln("${at}: note: time.zone with a name known only at run time embeds the whole zone database (${(zip.len() + 512) / 1024} KB); pass a constant name to embed only that zone, or build with --tzdata=system to read the host's database")
    }
    b = b + "import (\n\t_ \"embed\"\n\n\t\"xoprog/rt\"\n)\n\n"
    b = b + "//go:embed xo_zoneinfo.zip\nvar xoZoneinfo string\n\n"
    match os.fs.write("${tree}/xo_zoneinfo.zip", zip) {
      Ok(_) => {}
      Err(e) => return Err("${e}")
    }
    b = b + "func init() {\n\trt.TZFull(xoZoneinfo)\n}\n"
  } else {
    let data = zip_entries(zip)
    b = b + "import \"xoprog/rt\"\n\nfunc init() {\n"
    for n in names.sort() {
      match data.get(n) {
        Some(d) => b = b + "\trt.TZEmbed(${n.quote()}, ${d.quote()})\n"
        None => os.stdio.eprintln("note: zone ${n.quote()} is not in the zone database; time.zone returns ZoneErr.Unknown for it")
      }
    }
    b = b + "}\n"
  }
  write_file(os, "${tree}/xo_tzdata.go", b)
}

/// The stored (uncompressed) entries of a zip archive, as Go's
/// zoneinfo.zip has them, by name.
fn zip_entries(z: Bytes) -> Map[Str, Bytes] {
  var out: Map[Str, Bytes] = {}
  var i = 0
  while i + 30 <= z.len() && tzsel.le32(z, i) == 67324752 {
    let method = tzsel.le16(z, i + 8)
    let csize = tzsel.le32(z, i + 18)
    let nlen = tzsel.le16(z, i + 26)
    let xlen = tzsel.le16(z, i + 28)
    let name = z[i + 30..i + 30 + nlen].to_str() ?? ""
    let start = i + 30 + nlen + xlen
    if method == 0 && start + csize <= z.len() {
      out[name] = z[start..start + csize]
    }
    i = start + csize
  }
  out
}
