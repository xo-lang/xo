// The C inputs of `use c` (internal/build cffi.go, decisions 0116 and
// 0152): the adapter of each bound header, its `link` files, and its
// libraries. The checker loads a binding from the cache cbind writes
// (`<module root>/.xo/cbind`, or $XO_CBIND_DIR): the declaration file
// `<prefix>.xo` and, beside it, the adapter `<prefix>.c`, the same bytes
// as the binding's Adapter. The link files and libraries are read back
// from the binding's key (`c:<header>|<link files>|<libraries>|<effects>`
// for a header next to the module).

use std/crypto
use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/hostpath

/// What `use c` adds to a link: C sources, objects, and archives, and -l
/// flags; err is set when a binding cannot be linked.
struct CInputs {
  srcs: List[Str] = []
  flags: List[Str] = []
  err: Str = ""
  /// Every source is a prebuilt object (sqlite_prebuilt): a link with no
  /// C runtime takes them (decision 0534 stage 2).
  prebuilt: Bool = false
}

/// cInputs: each binding's adapter written into dir/cffi (in the order
/// of the prefixes), its link files after it, and the libraries sorted;
/// std/sqlite's binding is its prebuilt object for tgoos/tgoarch when one
/// matches (sqlite_prebuilt).
fn c_inputs(os: Os, c: check.Checker, dir: Str, std: Str, tgoos: Str, tgoarch: Str) -> CInputs {
  var mods: List[check.Module] = []
  for m in c.mods {
    if !m.c_prefix.is_empty() {
      mods.push(m)
    }
  }
  if mods.is_empty() {
    return CInputs{}
  }
  let cdir = "${dir}/cffi"
  match os.fs.create_dir_all(cdir) {
    Ok(_) => {}
    Err(e) => return CInputs{err: "${e}"}
  }
  var out = CInputs{prebuilt: true}
  var seen: Map[Str, Bool] = {}
  var libs: List[Str] = []
  for m in mods.sort_by(fn(m) { m.c_prefix }) {
    let pre = sqlite_prebuilt(os, std, m, tgoos, tgoarch)
    if !pre.is_empty() {
      out.srcs.push(pre)
      continue
    }
    out.prebuilt = false
    let adapter = "${m.c_decl.trim_suffix(".xo")}.c"
    let data0 = match os.fs.read(adapter) {
      Ok(d) => d
      Err(e) => return CInputs{err: "the adapter of `use c \"${m.c_header}\"`: ${e} (a Go build or `xo bind --c` writes it)"}
    }
    // a std binding's adapter names its header relative to the module
    // (bind.std_key, decision 0534 stage 2): this build's copy names it
    // where it is here, the key's first field
    let hp = m.path.split("|")[0].trim_prefix("c:")
    let inc = "#include \"${m.c_header}\"\n"
    let data = if hostpath.is_abs(hp) && (data0.to_str() ?? "").contains(inc) { (data0.to_str() ?? "").replace(inc, "#include \"${hp}\"\n").bytes() } else { data0 }
    let p = "${cdir}/xo_${m.c_prefix.trim_suffix("_")}.c"
    // xo:allow XO0903 a failed read writes the same adapter bytes again
    let old = os.fs.read(p).ok() ?? b""
    if old != data {
      match os.fs.write(p, data) {
        Ok(_) => {}
        Err(e) => return CInputs{err: "${e}"}
      }
    }
    out.srcs.push(p)
    let parts = m.path.split("|")
    var files: List[Str] = []
    var mlibs: List[Str] = []
    if parts.len() == 4 {
      files = if parts[1].is_empty() { [] } else { parts[1].split(",") }
      mlibs = if parts[2].is_empty() { [] } else { parts[2].split(",") }
    } else if parts.len() == 3 && !parts[1].is_empty() {
      // a header found on the include path: the links as written
      for l in parts[1].split(",") {
        if !l.contains("/") && !base_name(l).contains(".") {
          mlibs.push(l)
        } else if hostpath.is_abs(l) {
          files.push(l)
        } else {
          return CInputs{err: "`use c \"${m.c_header}\"` links ${l} relative to its module, which xo1 does not resolve for a header on the include path"}
        }
      }
    }
    for f in files {
      if !seen.contains(f) {
        seen[f] = true
        out.srcs.push(f)
      }
    }
    for l in mlibs {
      if !libs.contains(l) {
        libs.push(l)
      }
    }
  }
  for l in libs.sort() {
    out.flags.push("-l${l}")
  }
  out
}

/// The C sources among srcs (the adapters and link files of `use c`,
/// .c) compiled to objects with debug information before the link
/// (decision 0446), the other inputs passed through in their order: a C
/// function that LTO inlines into its Xo caller then has its compile
/// unit in the binary's DWARF, so a crash report or traceback shows it
/// as an inlined frame (gotchas/linux-lto-inlines-c-frames.md). cflags
/// are the compile's own (the target's; -flto when the link runs LTO,
/// so the object is bitcode and takes part in it). An object is named by
/// its source bytes and flags under dir/cffi and reused while they are
/// the same. With trim (--trimpath) the objects record the source's
/// directory relative to the working directory and "." as the compile
/// directory, as the Xo code's DWARF does, so a binary carries no path of
/// the machine that built it. The second result is the first failure's
/// output, "" when every compile succeeded.
fn c_objects(os: Os, cc: Str, cflags: List[Str], srcs: List[Str], dir: Str, trim: Bool) -> (List[Str], Str) {
  var out: List[Str] = []
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  let cwd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  for s in srcs {
    if !s.ends_with(".c") {
      out.push(s)
      continue
    }
    let data = match os.fs.read(s) {
      Ok(d) => d
      Err(e) => return ([], "${s}: ${e}\n")
    }
    let cdir = "${dir}/cffi"
    match os.fs.create_dir_all(cdir) {
      Ok(_) => {}
      Err(e) => return ([], "${e}\n")
    }
    var args = cflags + ["-g", "-O2", "-c", s]
    // the key names the source by its file name under trim: the
    // generated sources (xo_buildinfo.c, the adapters) are written in
    // each build's own directory, which the object does not record
    var kargs = args
    if trim {
      let sd = dir_name(if is_abs_path(s) { s } else { "${cwd}/${s}" })
      // a generated source, in the build's own directory, has no place to
      // record, even when that directory is below the working directory
      // (bootstrap-xo.sh OUT in the checkout: s2 and s3 differed by
      // xo_buildinfo.c's and xo_tzdata.c's paths, gcc on linux, 2026-11-01)
      let bd = if is_abs_path(dir) { dir } else { "${cwd}/${dir}" }
      let rel = if sd == bd || sd.starts_with("${bd}/") { "." } else { rel_or_dot(cwd, sd) }
      // the working directory as "." (the compile directory), then the
      // source's directory: both compilers apply the last map that
      // matches, so the source's wins below the working directory.
      // -ffile-prefix-map, not clang's -fdebug-compilation-dir, which gcc
      // (linux's cc) rejects
      args = args + ["-ffile-prefix-map=${cwd}=.", "-ffile-prefix-map=${sd}=${rel}"]
      kargs = cflags + ["-g", "-O2", "-c", "${rel}/${base_name(s)}", "cwd=."]
    }
    let key = crypto.sha256("c_objects v3\n${kargs.join("\x00")}\n".bytes() + data).to_hex()
    let obj = "${cdir}/${base_name(s).trim_suffix(".c")}-${key[0..16]}.o"
    // xo:allow XO0903 an object that is not there is compiled
    if !(os.fs.exists(obj).ok() ?? false) {
      let tmp = "${obj}.tmp"
      let (o, err) = combined(os, cc, args + ["-o", tmp])
      if !err.is_empty() {
        return ([], "${o}${cc} -c ${s}: ${err}\n")
      }
      match os.fs.rename(tmp, obj) {
        Ok(_) => {}
        Err(e) => return ([], "${e}\n")
      }
    }
    out.push(obj)
  }
  (out, "")
}

/// The defines std/sqlite's amalgamation is compiled with for a Windows
/// program linked with no C runtime (decision 0534 stage 2): SQLite's
/// memory on a Win32 heap of its own, no worker threads, no structured
/// exception handling, no extension loading, multi-thread mode. The same
/// as scripts/sqlite-prebuilt.sh's windows recipes.
fn sqlite_win_defines() -> List[Str] {
  ["-DSQLITE_THREADSAFE=2", "-DSQLITE_OMIT_LOAD_EXTENSION", "-DSQLITE_WIN32_MALLOC=1", "-DSQLITE_MAX_WORKER_THREADS=0", "-DSQLITE_OMIT_SEH"]
}

/// std/sqlite's prebuilt object for tgoos/tgoarch (decision 0534 stage
/// 2), or "" when there is none to use: m is std/sqlite's binding (its
/// links end in native/sqlite/xo_sqlite.c and sqlite3.c), and
/// sqlite/GOOS-ARCH/sqlite.o (sqlite.obj for windows) beside std (a
/// release's lib/xo/sqlite, a checkout's lib/xo/sqlite: the release
/// writes it) has a .key file equal to sqlite_key's. The object is the
/// amalgamation, xo_sqlite.c and the binding's adapter compiled as one
/// unit, so it replaces the three sources; a changed source or adapter
/// changes the key, and the sources are compiled again.
fn sqlite_prebuilt(os: Os, std: Str, m: check.Module, tgoos: Str, tgoarch: Str) -> Str {
  let parts = m.path.split("|")
  if parts.len() != 4 || m.c_header != "sqlite/xo_sqlite.h" {
    return ""
  }
  let files = parts[1].split(",")
  var amalg = ""
  for f in files {
    if f.ends_with("/native/sqlite/sqlite3.c") {
      amalg = f
    }
  }
  if amalg.is_empty() || files.len() != 2 {
    return ""
  }
  let root = dir_name(std.trim_suffix("/"))
  let rel = "${tgoos}-${tgoarch}/sqlite.${if tgoos == "windows" { "obj" } else { "o" }}"
  for p in ["${root}/sqlite/${rel}", "${root}/lib/xo/sqlite/${rel}"] {
    // xo:allow XO0903 a candidate with no key is not used
    let want = os.fs.read("${p}.key").ok() ?? b""
    if want.is_empty() {
      continue
    }
    let key = sqlite_key(os, dir_name(amalg), "${m.c_decl.trim_suffix(".xo")}.c", tgoos, tgoarch)
    if !key.is_empty() && (want.to_str() ?? "").trim() == key {
      return p
    }
  }
  ""
}

/// The key of std/sqlite's prebuilt object (sqlite_prebuilt): the
/// SHA-256 of the target, then sqlite3.c, xo_sqlite.c, xo_sqlite.h and the
/// binding's adapter at adapter, each after its length; "" when one
/// cannot be read. The adapter includes the header by its absolute path,
/// which is the machine's, so the key takes it as `dir/` removed: the
/// release's and a user's adapters then key alike
/// (scripts/sqlite-prebuilt.sh writes the .key the same way).
fn sqlite_key(os: Os, dir: Str, adapter: Str, tgoos: Str, tgoarch: Str) -> Str {
  var b = "xo sqlite prebuilt v1 ${tgoos}/${tgoarch}\n".bytes()
  for f in ["${dir}/sqlite3.c", "${dir}/xo_sqlite.c", "${dir}/xo_sqlite.h", adapter] {
    match os.fs.read(f) {
      Ok(d0) => {
        let d = if f == adapter { (d0.to_str() ?? "").replace("${dir}/", "").bytes() } else { d0 }
        b = b + "${d.len()}\n".bytes() + d
      }
      Err(_) => return ""
    }
  }
  crypto.sha256(b).to_hex()
}
