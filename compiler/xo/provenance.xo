// Build provenance (decision 0264): what this xo was built from, set by
// `xo build --stamp` in internal/xotool (scripts/xobuild, the tests'
// builds) and scripts/bootstrap-xo.sh; empty in an unstamped build. `xo
// version --json` and `xo version -v` print them; `xo version` alone is
// unchanged (scripts read its words by position: seed-pack.sh, seed-cut.sh).
// The stamps are not inputs of the source key (internal/xotool Key), so
// a cached build of the same sources keeps the commit that first built
// it: XO_SOURCE_KEY, not XO_COMMIT, says whether an xo matches a checkout.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/cli/core
use std/json

/// The commit of the tree it was built from.
const XO_COMMIT: Str = ""
/// The first 12 hex digits of the SHA-256 of `git diff HEAD` when the
/// tree had changes to tracked files, else "".
const XO_DIRTY: Str = ""
/// internal/xotool Key of the sources it was built from.
const XO_SOURCE_KEY: Str = ""
/// The xo that built it (a seed, an earlier build, or a bootstrap stage).
const XO_BUILT_BY: Str = ""
/// internal/xotool CodegenKey of the sources it was built from (decision
/// 0275): the backends and the compiler modules they use. The backend
/// caches key on it (bcache.xo cache_id); "" when unstamped.
const XO_CODEGEN_KEY: Str = ""

/// A warning on standard error when this xo is older than the std it
/// runs with (std/VERSION, written by seed-cut.sh's bump): a stale bin/xo
/// on PATH checks and builds a newer std with old rules (lead,
/// 2026-10-23: an agent ran a 0.24.0 bin/xo against 0.27.0's std).
fn stale_std_note(os: Os, args: List[Str]) {
  var sd = ""
  for a in args {
    if a.starts_with("--std=") {
      sd = a.trim_prefix("--std=")
    }
  }
  if sd.is_empty() {
    sd = check.std_dir(os.env, os.fs)
  }
  if sd.is_empty() {
    return
  }
  // xo:allow XO0903 a std without the stamp (older, or a test's copy) is not compared
  let sv = (os.fs.read_text("${sd}/VERSION").ok() ?? "").trim()
  if sv.is_empty() || check.version_compare("v${sv}", "v${core.VERSION}") <= 0 {
    return
  }
  os.stdio.eprintln("xo: warning: this xo (${core.VERSION}) is older than std at ${sd} (${sv}); rebuild it (`go run ./scripts/xobuild` in a checkout) or put the matching xo on PATH")
}

/// `xo version --json` and `xo version -v`; None for any other form,
/// which compiler/cli/core answers.
fn version_cmd(os: Os, args: List[Str]) -> Int? {
  if args.len() >= 2 && args[0] is "version" | "--version" && args[1] == "-m" {
    return Some(version_m(os, args[2..args.len()]))
  }
  if args.len() != 2 || !(args[0] is "version" | "--version") || !(args[1] is "--json" | "-v") {
    return None
  }
  let goos = host_os(os)
  let arch = host_arch()
  if args[1] == "--json" {
    os.stdio.println("{\"version\":${json_str(core.VERSION)},\"goos\":${json_str(goos)},\"goarch\":${json_str(arch)},\"commit\":${json_str(XO_COMMIT)},\"dirty\":${!XO_DIRTY.is_empty()},\"diff_hash\":${json_str(XO_DIRTY)},\"source_key\":${json_str(XO_SOURCE_KEY)},\"built_by\":${json_str(XO_BUILT_BY)}}")
    return Some(0)
  }
  os.stdio.println("xo ${core.VERSION} ${goos}/${arch}")
  if XO_COMMIT.is_empty() {
    os.stdio.println("no build stamp (an xo built without internal/xotool or the bootstrap)")
    return Some(0)
  }
  let dirty = if XO_DIRTY.is_empty() { "" } else { ", dirty ${XO_DIRTY}" }
  os.stdio.println("commit ${XO_COMMIT}${dirty}")
  os.stdio.println("source key ${XO_SOURCE_KEY}")
  os.stdio.println("built by ${XO_BUILT_BY}")
  Some(0)
}

/// The settings of a binary's build information (decision 0354).
struct BinfoSettings {
  debug_contracts: Bool = false
  dbg: Bool = false
  error_args: Bool = false
  debug_info: Str = ""
  profile_support: Bool = false
  trace_support: Bool = false
  opt: Str = ""
} derive Json

/// A binary's build information, as `xo version -m` shows it.
struct BinfoView {
  id: Str = ""
  dir: Str = ""
  xo: Str = ""
  backend: Str = ""
  target: Str = ""
  release: Bool = false
  holes: Bool = false
  no_mono: Bool = false
  no_arenas: Bool = false
  race: Bool = false
  tzdata: Str = ""
  settings: BinfoSettings? = None
  stamps: Map[Str, Str] = {}
  sources: Map[Str, Str] = {}
  inline_fallback: Str = ""
} derive Json

/// `xo version -m [--json] BINARY...` (decision 0354 stage 2): the build
/// information each binary carries (the Go backend's rt.SetBuildInfo
/// string, a native binary's xo_buildinfo), as `go version -m` lists a
/// Go binary's: the xo, backend and target, the ID and directory, every
/// effective setting, the stamps, and the sources with their hashes.
fn version_m(os: Os, args: List[Str]) -> Int {
  var as_json = false
  var bins: List[Str] = []
  for a in args {
    if a == "--json" {
      as_json = true
    } else {
      bins.push(a)
    }
  }
  if bins.is_empty() {
    os.stdio.eprintln("usage: xo version -m [--json] BINARY...")
    return 2
  }
  var code = 0
  for bin in bins {
    let data = match os.fs.read(bin) {
      Ok(d) => d
      Err(e) => {
        os.stdio.eprintln("xo version -m: ${bin}: ${e}")
        code = 1
        continue
      }
    }
    let text = core.find_build_info(data, "")
    if text.is_empty() {
      os.stdio.eprintln("xo version -m: ${bin}: no Xo build information (not built by xo, or a native build by an xo before decision 0354 stage 2)")
      code = 1
      continue
    }
    if as_json {
      os.stdio.println(text)
      continue
    }
    let v = match json.decode_str[BinfoView](text) {
      Ok(x) => x
      Err(e) => {
        os.stdio.eprintln("xo version -m: ${bin}: unreadable build information: ${e}")
        code = 1
        continue
      }
    }
    let xo = if v.xo.is_empty() { "an xo before decision 0354 stage 2" } else { "xo ${v.xo}" }
    var b = StrBuilder.new()
    b.write("${bin}: ${xo}\n")
    if !v.backend.is_empty() {
      b.write("\tbackend\t${v.backend}\n")
    }
    if !v.target.is_empty() {
      b.write("\ttarget\t${v.target}\n")
    }
    b.write("\tid\t${v.id}\n\tdir\t${v.dir}\n")
    b.write("\tbuild\tmode=${if v.release { "release" } else { "debug" }}\n")
    if let Some(st) = v.settings {
      let onoff = fn(x: Bool) -> Str { if x { "on" } else { "off" } }
      b.write("\tbuild\tdebug-contracts=${onoff(st.debug_contracts)}\n\tbuild\tdbg=${onoff(st.dbg)}\n\tbuild\terror-args=${onoff(st.error_args)}\n")
      b.write("\tbuild\tdebug-info=${st.debug_info}\n\tbuild\tprofile-support=${onoff(st.profile_support)}\n\tbuild\ttrace-support=${onoff(st.trace_support)}\n")
      if !st.opt.is_empty() {
        b.write("\tbuild\topt=${st.opt}\n")
      }
    }
    for (flag, on) in [("holes", v.holes), ("no-mono", v.no_mono), ("no-arenas", v.no_arenas), ("race", v.race)] {
      if on {
        b.write("\tbuild\t${flag}\n")
      }
    }
    if !v.tzdata.is_empty() {
      b.write("\tbuild\ttzdata=${v.tzdata}\n")
    }
    if !v.inline_fallback.is_empty() {
      // built without inlining: its inlined module did not verify
      b.write("\tbuild\tinline=fallback (${v.inline_fallback})\n")
    }
    for k in v.stamps.keys().sort() {
      b.write("\tstamp\t${k}=${v.stamps.get(k) ?? ""}\n")
    }
    for k in v.sources.keys().sort() {
      b.write("\tsource\t${k}\t${v.sources.get(k) ?? ""}\n")
    }
    os.stdio.print(b.freeze())
  }
  code
}
