// Zone data per use (internal/build tzdata.go, std.md 13, decisions 0094
// and 0157): a native program that uses std/time is compiled with
// xo_tzdata.c beside the runtime (so the runtime's object
// does not depend on the program). xo_tz_mode is 0 with the TZif data of
// each constant zone name `time.zone` is called with, 1 with the whole
// zoneinfo.zip when a name is known only at run time, 2 with
// --tzdata=system (the host's database). The data is the IANA database
// std ships (std/tzdata/zoneinfo.zip, built by scripts/tzdata-update.sh,
// decision 0094's addendum): $XO_ZONEINFO, else std's, else an older
// release's lib/xo/zoneinfo.zip. No Go is needed.

use github.com/xo-lang/xo/compiler/tzsel

/// tzSource: xo_tzdata.c in dir for sel; its path.
fn tz_source(os: Os, dir: Str, sel: tzsel.TZSel) -> Str ! FsErr {
  var b = BytesBuilder.new()
  b.write_str("// Code generated by xo build. DO NOT EDIT.\n// The zone data of the program (decisions 0094, 0157).\n\n#include <stdint.h>\n\n")
  b.write_str("typedef struct {\n\tconst char *name;\n\tconst char *data;\n\tint64_t len;\n} xo_tz_blob;\n\n")
  b.write_str("const int64_t xo_tz_mode = ${sel.mode};\n")
  if sel.mode == 1 {
    b.write_str("const int64_t xo_tz_zip_len = ${sel.zip.len()};\nconst char xo_tz_zip[] =\n")
    c_bytes(b, sel.zip)
    b.write_str(";\n")
  } else {
    b.write_str("const int64_t xo_tz_zip_len = 0;\nconst char xo_tz_zip[1] = {0};\n")
  }
  b.write_str("const xo_tz_blob xo_tz_blobs[] = {\n")
  if sel.mode == 0 {
    for i in 0..sel.names.len() {
      b.write_str("\t{${sel.names[i].quote()},\n")
      c_bytes(b, sel.data[i])
      b.write_str("\t, ${sel.data[i].len()}},\n")
    }
  }
  b.write_str("\t{0, 0, 0},\n};\n")
  // the table std/native/llrt/tzhost.xo reads through rttime.tz_table
  // (work item B27): the mode, the zip and its length, the blobs
  let zl = if sel.mode == 1 { sel.zip.len() } else { 0 }
  b.write_str("\nconst void *const xo_tz_tab[4] = {(const void *)(intptr_t)${sel.mode}, xo_tz_zip, (const void *)(intptr_t)${zl}, xo_tz_blobs};\n")
  b.write_str("int64_t xo_tz_table(void) { return (int64_t)(intptr_t)xo_tz_tab; }\n")
  let path = "${dir}/xo_tzdata.c"
  os.fs.write(path, b.freeze())?
  Ok(path)
}

/// cBytes: data as C string literals, printable ASCII as is, other bytes
/// as three digit octal escapes, 64 bytes a line.
fn c_bytes(var b: BytesBuilder, data: Bytes) {
  if data.is_empty() {
    b.write_str("\t\"\"\n")
    return
  }
  var i = 0
  while i < data.len() {
    b.write_str("\t\"")
    var j = i
    let end = if i + 64 < data.len() { i + 64 } else { data.len() }
    while j < end {
      let c = Int(data[j])
      if c == 34 || c == 92 || c == 63 {
        b.write_byte(UInt8(92))
        b.write_byte(data[j])
      } else if c >= 32 && c < 127 {
        b.write_byte(data[j])
      } else {
        b.write_byte(UInt8(92))
        b.write_byte(UInt8(48 + c / 64))
        b.write_byte(UInt8(48 + c / 8 % 8))
        b.write_byte(UInt8(48 + c % 8))
      }
      j += 1
    }
    b.write_str("\"\n")
    i += 64
  }
}
