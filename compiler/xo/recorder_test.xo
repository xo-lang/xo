// Tests of the build recorder (recorder.xo, decision 0360).

use std/crypto
use std/testing

test "the recorder hashes what a read returned, and only for a recorded path" {
  let rec = Mutex[Rec].new(Rec{})
  let code = testing.run_main(fn(o: Os) -> () ! Error {
    o.fs.create_dir_all("/w/src")?
    o.fs.create_dir_all("/c/packs")?
    o.fs.write("/w/src/a.xo", b"fn a() {}")?
    o.fs.write("/c/packs/p.bin", b"a large cache pack")?
    let r = rec_os(o, rec, "/w", ["/c/"])
    let _a = r.fs.read_text("/w/src/a.xo")?
    let _p = r.fs.read("/c/packs/p.bin")?
  }, os)
  expect(code) == 0
  let seen = rec.with(fn(x) { x.reads })
  // the recorded file carries the SHA-256 of its contents; the skipped
  // pack is not recorded and not hashed (hashing every pack a build
  // read made a first build after an edit 5 times slower, 2026-10-24)
  expect(seen.get("/w/src/a.xo") ?? "") == crypto.sha256(b"fn a() {}").to_hex()
  expect(seen.contains("/c/packs/p.bin")) == false
}

test "a file opened is recorded without a hash for the entry to fill" {
  let rec = Mutex[Rec].new(Rec{})
  let code = testing.run_main(fn(o: Os) -> () ! Error {
    o.fs.create_dir_all("/w/src")?
    o.fs.write("/w/src/b.xo", b"fn b() {}")?
    let r = rec_os(o, rec, "/w", [])
    let f = r.fs.open("/w/src/b.xo")?
    f.close()?
  }, os)
  expect(code) == 0
  let seen = rec.with(fn(x) { x.reads })
  expect(seen.contains("/w/src/b.xo")) == true
  expect(seen.get("/w/src/b.xo") ?? "x") == ""
}

test "a release's prebuilt std stores are left out of the recorded reads" {
  let got = Mutex[List[List[Str]]].new([])
  let code = testing.run_main(fn(o: Os) -> () ! Error {
    let rel = rec_skip(o, Ctx{goos: "darwin", std: "/opt/xo/lib/xo/std", xo: "/opt/xo/bin/xo", cache: "/c"})
    let dev = rec_skip(o, Ctx{goos: "darwin", std: "/src/xo/std", xo: "/src/xo/bin/xo", cache: "/c"})
    got.with(fn(var g) { g.push(rel); g.push(dev) })
  }, os)
  expect(code) == 0
  let g = got.with(fn(x) { x })
  // the 52 MB store was hashed on every edit build otherwise
  expect(g[0].contains("/opt/xo/lib/xo/stdstore/")) == true
  expect(g[1].filter(fn(p) { p.ends_with("/stdstore/") }).len()) == 0
}

test "a listing and a walk carry the digests the run cache would compute" {
  let rec = Mutex[Rec].new(Rec{})
  let want = Mutex[(Str, Str)].new(("", ""))
  let code = testing.run_main(fn(o: Os) -> () ! Error {
    o.fs.create_dir_all("/w/src/sub")?
    o.fs.write("/w/src/a.xo", b"fn a() {}")?
    o.fs.write("/w/src/sub/b.xo", b"fn b() {}")?
    let r = rec_os(o, rec, "/w", [])
    let _l = r.fs.read_dir("/w/src")?
    let _w = r.fs.walk("/w/src")?
    let d = listing_of(o, "/w/src")
    let w = walk_of(o, "/w/src")
    want.with(fn(var x) { x = (d, w) })
  }, os)
  expect(code) == 0
  let sums = rec.with(fn(x) { x.list_sums })
  // run_store writes these instead of listing and walking again
  let (want_dir, want_walk) = want.with(fn(x) { x })
  expect(want_dir.is_empty()) == false
  expect(sums.get("dir /w/src") ?? "") == want_dir
  expect(sums.get("walk /w/src") ?? "") == want_walk
}

test "the recorder leaves out the machine's state" {
  // /proc/meminfo changes from one read to the next: recorded, it made
  // every Linux build miss the run cache (2026-10-30)
  let rec = Mutex[Rec].new(Rec{})
  let code = testing.run_main(fn(o: Os) -> () ! Error {
    o.fs.create_dir_all("/proc")?
    o.fs.create_dir_all("/sys/fs/cgroup")?
    o.fs.create_dir_all("/w")?
    o.fs.write("/proc/meminfo", b"MemTotal: 8000000 kB\n")?
    o.fs.write("/sys/fs/cgroup/cpu.max", b"max 100000\n")?
    o.fs.write("/w/main.xo", b"fn main() {}")?
    let r = rec_os(o, rec, "/w", rec_machine())
    let _m = r.fs.read_text("/proc/meminfo")?
    let _c = r.fs.read_text("/sys/fs/cgroup/cpu.max")?
    let _e = r.fs.exists("/sys/fs/cgroup/cpu.max")?
    let _w = r.fs.read_text("/w/main.xo")?
  }, os)
  expect(code) == 0
  let (reads, probes) = rec.with(fn(x) { (x.reads, x.probes) })
  expect(reads.contains("/proc/meminfo")) == false
  expect(reads.contains("/sys/fs/cgroup/cpu.max")) == false
  expect(probes.len()) == 0
  expect(reads.contains("/w/main.xo")) == true
}
