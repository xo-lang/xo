// The command line of xo1 (decision 0178 stage 1): the flags of `xo
// build`, `xo run`, and `xo test` (cmd/xo build.go) with Go's flag
// package rules, so the same command lines work with both drivers:
// `-name` or `--name`, `--name=value` or `--name value` for a flag with
// a value, `--name` or `--name=false` for a boolean; parsing stops at the
// first argument that is not a flag or after `--`. xo1's own flags
// (--std, --wd, --cc, --asm, --go-tree, --phase-times, --target) are
// parsed the same way.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/hostpath

/// Everything a command line sets.
struct Opts {
  cmd: Str = ""
  std: Str = "std"
  wd: Str = ""
  cc: Str = ""
  out: Str = ""
  asm_path: Str = ""
  /// --tzdata: "embedded" (the default, as cmd/xo's flag) or "system".
  tzdata: Str = "embedded"
  /// --targets (comma separated os/arch, or all) or xo1's --target.
  targets: Str = ""
  /// --backend as given ("" when not given: go, or arm64 with --no-gc and
  /// for asm; main.xo).
  backend: Str = ""
  /// build_native: o.backend was empty and is the default it chose.
  backend_auto: Bool = false
  go_tree: Str = ""
  /// --as and --ld (decision 0182): cc, or macho (compiler/macho; --ld=macho
  /// implies --as=macho); "" when not given: main.xo default_ld picks
  /// macho for a darwin/arm64 host link the pack covers, else cc.
  assembler: Str = ""
  linker: Str = ""
  phases: Bool = false
  /// The run cache's key of a native `xo test` (testcache.xo), "" for
  /// none, and when the build started (Unix milliseconds).
  run_key: Str = ""
  run_start: Int = 0
  json: Bool = false
  ci: Bool = false
  release: Bool = false
  /// The settings --release presets (decision 0354): each -1 when not
  /// given (the preset's value, *_eff below), else 0 or 1. --trace-support:
  /// the execution trace's recorder (decision 0240)
  trace_support: Int = -1
  /// -s: no debug information and no local symbols (compiler/macho's
  /// LinkOpts.strip, `ld -x` on darwin, `ld -s` on Linux; the Go
  /// backend's `-s -w`), on top of --debug-info
  strip: Bool = false
  /// --debug-info=on|off|split (decision 0354; split is decision 0355's),
  /// "" when not given: debug_info_eff
  debug_info: Str = ""
  /// --dsym: a darwin link through compiler/macho also writes NAME.dSYM
  /// (decision 0346: the executable carries its DWARF without it)
  dsym: Bool = false
  /// --profile-support: the runtime's profiler (XO_PROF, decision 0238)
  profile_support: Int = -1
  /// --trimpath: the DWARF directories relative to the working directory,
  /// not absolute (trimpath_eff; on unless given)
  trimpath: Int = -1
  /// --pack-lists (decision 0369, on unless --pack-lists=false): a List of a sized
  /// integer stores its elements in their width; the native and LLVM backends
  pack_lists: Bool = true
  /// --error-args: parameter values in error frames (11.1)
  error_args: Int = -1
  /// --debug-contracts: the `(debug)` contract clauses (spec 8)
  debug_contracts: Int = -1
  /// --dbg: `dbg(x)` prints (11.4); off compiles it to x
  dbg: Int = -1
  /// --opt=O0|O1|O2|O3: the LLVM backend's optimization level ("" for
  /// the preset's)
  opt: Str = ""
  /// The build information's source hashes (binfo.xo binfo_sources),
  /// taken by build_native before lowering releases the checker.
  binfo_sources: Map[Str, Str] = {}
  hybrid: Bool = false
  no_mono: Bool = false
  no_arenas: Bool = false
  /// --no-preempt: loops without preemption polls (decision 0286 step 3)
  no_preempt: Bool = false
  no_gc: Bool = false
  holes: Bool = false
  race: Bool = false
  /// --profile: the sampling profiles run and test take (decision 0238:
  /// "cpu", "heap", or "cpu,heap"; XO_PROF for the program), "" for none.
  profile: Str = ""
  /// --trace=FILE (decision 0240): XO_TRACE for the program, then `xo
  /// trace FILE` after it ran; "" for none.
  trace: Str = ""
  real: Bool = false
  record: Str = ""
  explore: Int = 0
  /// --offline: "1" on, "0" off, "" not given (XO_OFFLINE decides).
  offline: Str = ""
  /// --workspace: "off", "on", or "" not given (XO_WORK decides).
  workspace: Str = ""
  /// --stamp NAME=VALUE, in command line order.
  stamps: List[(Str, Str)] = []
  /// Modules (paths) the module check cache checks in full though their
  /// entries would let it skip them (XO_CHK_CACHE=auto's fallback)
  chk_noskip: List[Str] = []
  /// More than one target: XO_CHK_CACHE=auto does not skip (the fallback
  /// covers the first target's build only)
  many_targets: Bool = false
  /// One backend's share of a build whose targets need several
  /// (build_by_backend): build_native leaves the report of the binaries
  /// to its caller.
  part_of_many: Bool = false
  /// --targets=all: a target the program cannot be built for (the SSA
  /// builder's unsupported reason, e.g. the network on wasip1/wasm) is
  /// skipped with a note instead of failing the build (field report
  /// 0.26.0); a target named in --targets still fails
  skip_unsupported: Bool = false
  topts: TestOpts = TestOpts{}
  /// --std-module=MODULE (test, decision 0262): the std module whose
  /// _test.xo tests run, as `use` names it below std (`json`,
  /// `native/http`, `native/llrt/scan`); "" for none.
  std_module: Str = ""
  /// --watch (run, decision 0267): rebuild on a change, restart when the
  /// binary changed; --grace: how long a restart waits for the program
  /// to exit after SIGTERM.
  watch: Bool = false
  grace: Duration = 5s
  /// The directories (build, test, asm) or the one directory of run.
  dirs: List[Str] = []
  /// Those of dirs (absolute) given as DIR/..., which cover the
  /// directories below them (decision 0345); any other is that directory
  /// alone.
  walk: List[Str] = []
  /// run: the program's arguments (after the directory, or after --).
  prog_args: List[Str] = []
  /// The std parses of an earlier build of this process (`xo dev
  /// build-each`, decision 0209); empty for a command line.
  parse_cache: Map[Str, check.ParseEntry] = {}
  /// the caller reuses the parse cache the build returns (xo dev's
  /// builds in one process): a native build keeps it past lowering
  /// (decision 0352)
  reuse_parse: Bool = false
}

/// The flags that take a value (every other known flag is a boolean).
fn value_flags() -> List[Str] {
  ["o", "trace", "targets", "target", "backend", "tzdata", "stamp", "seed", "explore", "record", "run", "cases", "timeout", "std", "wd", "cc", "asm", "go-tree", "workspace", "as", "ld", "profile", "std-module", "grace", "opt"]
}

/// The boolean flags.
fn bool_flags() -> List[Str] {
  ["json", "ci", "release", "error-args", "hybrid", "mono", "no-mono", "arenas", "no-arenas", "no-preempt", "no-gc", "holes", "race", "v", "real", "fail-empty", "phase-times", "offline", "s", "debug-info", "dsym", "profile-support", "trace-support", "trimpath", "pack-lists", "watch", "debug-contracts", "dbg"]
}

/// The usage of xo1's hidden commands (asm, keys) and of an unknown one;
/// build, run, and test print `xo`'s usage (compiler/cli/cmdhelp), which
/// leaves out xo1's own flags.
fn usage_line() -> Str {
  "usage: xo1 build|run|test|asm|keys [flags] [dir ...] (run: [dir] [--] [args]); flags: --std=DIR --wd=DIR --cc=CC --tzdata=embedded|system --targets=OS/ARCH,... --backend=arm64|llvm|go|wasm --go-tree=DIR --as=cc|macho --ld=cc|macho -o OUT --asm=PATH --json --ci --release --error-args=false --profile-support --stamp NAME=VALUE --no-mono --no-arenas --no-preempt --no-gc --holes --race --profile=cpu|heap|cpu,heap --seed=N --explore=N --record=FILE --run=SUB --cases=N --timeout=D --real --std-module=MODULE -v --phase-times"
}

/// usage prints why and the usage of the command cmd on standard error
/// and exits 2 (a usage error).
fn usage(os: Os, cmd: Str, why: Str) -> Never {
  if !why.is_empty() {
    os.stdio.eprintln(why)
  }
  let u = cmdhelp.usage(cmd)
  if u.is_empty() {
    os.stdio.eprintln(usage_line())
  } else {
    os.stdio.eprint(u)
  }
  os.proc.exit(2)
}

/// What front decided: exit with code (code >= 0), or run the command
/// line args.
struct Front {
  code: Int = -1
  args: List[Str] = []
}

/// front handles what every command line shares before a command runs:
/// `xo` alone (the command list on standard error, exit 2), `xo help
/// [command]` and -h or --help anywhere before `--` (run: before its
/// directory) on standard output (exit 0), and the package pattern
/// `D/...` (decision 0210, spec/core.md 10.1), which a command that takes
/// directories reads as D (each of them already covers the directories
/// below D) once D/... is known to match a directory with .xo files. The
/// global --std=DIR and --wd=DIR may come before the command
/// (compiler/cli/core).
fn front(os: Os, args: List[Str]) -> Front {
  var i = 0
  while i < args.len() && (args[i].starts_with("--std=") || args[i].starts_with("--wd=")) {
    i += 1
  }
  if i >= args.len() {
    os.stdio.eprint(cmdhelp.top())
    return Front{code: 2}
  }
  let cmd = args[i]
  if cmd == "help" || cmdhelp.is_help_flag(cmd) {
    if i + 1 < args.len() {
      let u = cmdhelp.usage(args[i + 1])
      if u.is_empty() {
        os.stdio.eprint("xo help: unknown command ${args[i + 1].quote()}\n\n${cmdhelp.top()}")
        return Front{code: 2}
      }
      os.stdio.print(u)
      return Front{code: 0}
    }
    os.stdio.print(cmdhelp.top())
    return Front{code: 0}
  }
  if !cmdhelp.is_command(cmd) {
    return Front{args: args}
  }
  let dirs = cmdhelp.takes_dirs(cmd)
  let vals = if cmd is "build" | "run" | "test" { value_flags() } else { [] }
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  var out: List[Str] = []
  for k in 0..i + 1 {
    out.push(path_arg(args[k]))
  }
  var j = i + 1
  var program = false
  while j < args.len() {
    let a = args[j]
    if program || a == "--" {
      out.push(a)
      program = true
      j += 1
      continue
    }
    if cmdhelp.is_help_flag(a) {
      os.stdio.print(cmdhelp.usage(cmd))
      return Front{code: 0}
    }
    if a.starts_with("-") && a != "-" {
      out.push(path_arg(a))
      // a value flag given without = takes the next argument
      let flag = a.trim_prefix("-").trim_prefix("-")
      if !a.contains("=") && vals.contains(flag) && j + 1 < args.len() {
        j += 1
        out.push(if path_flags().contains(flag) { os_path(args[j]) } else { args[j] })
      }
      j += 1
      continue
    }
    if dirs && cmdhelp.is_pattern(a) {
      if cmd == "run" {
        os.stdio.eprintln("xo run: ${a}: run takes one directory, not a package pattern")
        return Front{code: 2}
      }
      let d = cmdhelp.pattern_dir(a)
      if d.is_empty() {
        os.stdio.eprintln(cmdhelp.pattern_error(cmd, a))
        return Front{code: 2}
      }
      if is_dir(os, abs_in(wd, d)) {
        var n = 0
        if !has_sources(os, abs_in(wd, d), n) {
          os.stdio.eprintln(if n > check.MAX_WALK_ENTRIES { "xo ${cmd}: ${check.walk_limit_error(a)}" } else { cmdhelp.no_match_error(cmd, a) })
          return Front{code: 1}
        }
      }
      // the pattern itself: the command walks DIR (decision 0345)
      out.push(os_path(a))
    } else if cmd == "run" && !program && a.ends_with(".xo") && !is_dir(os, abs_in(wd, a)) {
      // a module is a directory (core 1.1): run the file's directory
      let d = if a.contains("/") { a[0..(a.rfind("/") ?? 0)] } else { "." }
      os.stdio.eprintln("xo run: ${a} is a file, not a directory (a module is a directory, core 1.1)\n  fix: xo run ${if d.is_empty() { "/" } else { d }}")
      return Front{code: 2}
    } else {
      out.push(if dirs { os_path(a) } else { a })
    }
    if cmd == "run" {
      // the directory; the program's arguments follow
      program = true
    }
    j += 1
  }
  Front{args: out}
}

/// The value flags that name a file or directory.
fn path_flags() -> List[Str] {
  ["o", "std", "wd", "tzdata", "record", "cc", "asm", "go-tree", "workspace", "as", "ld"]
}

/// A path argument as the rest of xo takes it: on Windows `\` is a
/// separator (std.md 3.1: `C:\data` is absolute), and the checker and
/// driver split paths only at `/`, so `C:\x\compiler\xo` becomes
/// `C:/x/compiler/xo` (gotchas/windows-seed-xo1306-module-not-required.md);
/// elsewhere `\` is an ordinary character of a name.
fn os_path(p: Str) -> Str {
  if is_windows() { p.replace("\\", "/") } else { p }
}

/// arg with os_path applied to the value of a path flag (`-o=C:\x`,
/// `--std=C:\x`); other arguments unchanged.
fn path_arg(arg: Str) -> Str {
  if !arg.starts_with("-") || !arg.contains("=") {
    return arg
  }
  let eq = arg.find("=") ?? 0
  let name = arg[0..eq]
  if path_flags().contains(name.trim_prefix("-").trim_prefix("-")) { "${name}=${os_path(arg[eq + 1..])}" } else { arg }
}

/// p against the working directory wd (unless absolute).
fn abs_in(wd: Str, p: Str) -> Str {
  if is_abs_path(p) || wd.is_empty() { p } else { "${wd}/${p}" }
}

fn is_dir(os: Os, p: Str) -> Bool {
  os.fs.read_dir(p).is_ok()
}

/// Whether dir or a directory below it holds a .xo file, below the top
/// skipping what the commands' walks skip: testdata, vendor, and names
/// starting with . or _ (decision 0210); n counts the entries looked at,
/// and the walk gives up past the bound of decision 0345.
fn has_sources(os: Os, dir: Str, var n: Int) -> Bool {
  // xo:allow XO0903 a directory it cannot list has no sources: the command reports none
  let entries = os.fs.read_dir(dir).ok() ?? []
  n += entries.len()
  if n > check.MAX_WALK_ENTRIES {
    return false
  }
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") {
      return true
    }
  }
  for e in entries {
    if e.is_dir && !check.walk_skips(e.name) {
      if has_sources(os, "${dir}/${e.name}", n) {
        return true
      }
    }
  }
  false
}

/// Whether dir holds a .xo file of its own.
fn own_xo_files(os: Os, dir: Str) -> Bool {
  // xo:allow XO0903 an unreadable directory: the checker reports it
  (os.fs.read_dir(dir).ok() ?? []).any(fn(e) { !e.is_dir && e.name.ends_with(".xo") })
}

/// The error of `xo run DIR` when DIR has no program (why: "has no .xo
/// files", "has no main function"): xo run runs exactly that directory
/// and never one below it (decision 0345); the note names the
/// subdirectories directly below whose files declare main, as a hint.
fn run_no_main(os: Os, wd: Str, dir: Str, why: Str) -> Str {
  var b = StrBuilder.new()
  b.write("xo run: ${dir} ${why}: xo run runs exactly the directory it is given, never one below it (decision 0345)")
  let top = abs_of(wd, dir)
  var found: List[Str] = []
  // xo:allow XO0903 an unreadable directory has no hint to give
  for e in os.fs.read_dir(top).ok() ?? [] {
    if !e.is_dir || e.name.starts_with(".") || e.name.starts_with("_") || e.name == "testdata" {
      continue
    }
    // xo:allow XO0903 an unreadable subdirectory is left out of the hint
    for f in os.fs.read_dir("${top}/${e.name}").ok() ?? [] {
      if f.is_dir || !f.name.ends_with(".xo") || f.name.ends_with("_test.xo") {
        continue
      }
      let src = match os.fs.read("${top}/${e.name}/${f.name}") {
        Ok(bs) => bs.to_str() ?? ""
        // an unreadable file is left out of the hint
        Err(_) => ""
      }
      if src.starts_with("fn main(") || src.contains("\nfn main(") {
        found.push(if dir == "." { e.name } else { "${dir.trim_suffix("/")}/${e.name}" })
        break
      }
    }
    if found.len() >= 8 {
      break
    }
  }
  if !found.is_empty() {
    b.write("\n  note: programs in the directories below: ${found.join(", ")}\n  fix: xo run ${found[0]}")
  }
  b.freeze()
}

/// help prints the usage of the command cmd on standard output and exits
/// 0 (-h, --help).
fn help(os: Os, cmd: Str) -> Never {
  let u = cmdhelp.usage(cmd)
  if u.is_empty() {
    os.stdio.println(usage_line())
  } else {
    os.stdio.print(u)
  }
  os.proc.exit(0)
}

/// parse_args reads the command line (args[0] is the command).
fn parse_args(os: Os, args: List[Str]) -> Opts {
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  var o = Opts{cmd: args[0], wd: os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""}
  // the std sources: $XO_STD, else lib/xo/std of a release layout beside
  // the binary (check.std_dir, as every command finds it); --std
  // overrides it
  o.std = check.std_dir(os.env, os.fs)
  let vals = value_flags()
  let bools = bool_flags()
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "--" {
      i += 1
      break
    }
    if !a.starts_with("-") || a == "-" {
      break
    }
    var name = a.trim_prefix("-")
    name = name.trim_prefix("-")
    var value = ""
    var has_value = false
    let eq = name.split("=")
    if eq.len() > 1 {
      value = eq[1..eq.len()].join("=")
      name = eq[0]
      has_value = true
    }
    if name == "h" || name == "help" {
      help(os, o.cmd)
    }
    if vals.contains(name) {
      if !has_value {
        if i + 1 >= args.len() {
          usage(os, o.cmd, "flag needs an argument: -${name}")
        }
        value = args[i + 1]
        i += 1
      }
      set_value(os, o, name, value)
    } else if name == "debug-info" && has_value && value == "split" {
      // decision 0355's value of the debug info setting (0354)
      o.debug_info = "split"
    } else if bools.contains(name) {
      var on = true
      if has_value {
        // on and off too: every setting of decision 0354 takes them
        if value is "true" | "1" | "t" | "T" | "TRUE" | "True" | "on" {
          on = true
        } else if value is "false" | "0" | "f" | "F" | "FALSE" | "False" | "off" {
          on = false
        } else {
          usage(os, o.cmd, "invalid boolean value \"${value}\" for -${name}: parse error")
        }
      }
      set_bool(os, o, name, on)
    } else {
      usage(os, o.cmd, "flag provided but not defined: -${name}")
    }
    i += 1
  }
  var rest: List[Str] = []
  while i < args.len() {
    rest.push(args[i])
    i += 1
  }
  if o.cmd == "run" {
    // cmd/xo runRun: the directory, then the program's arguments after
    // an optional --
    var dir = "."
    var r = rest
    if !r.is_empty() {
      if r[0] != "--" {
        dir = r[0]
        r = r[1..r.len()]
      }
      if !r.is_empty() && r[0] == "--" {
        r = r[1..r.len()]
      }
    }
    o.dirs = [dir]
    o.prog_args = r
    if !own_xo_files(os, abs_of(o.wd, dir)) && is_dir(os, abs_of(o.wd, dir)) {
      // xo run never looks below the directory (decision 0345)
      os.stdio.eprintln(run_no_main(os, o.wd, dir, "has no .xo files"))
      os.proc.exit(1)
    }
    return o
  }
  if !o.std_module.is_empty() {
    if o.cmd != "test" {
      usage(os, o.cmd, "--std-module is a flag of xo test")
    }
    if !rest.is_empty() {
      usage(os, o.cmd, "--std-module tests one std module: no directories")
    }
    // the std directory stands for the module's (a program's root); the
    // checker loads the module itself (check.Checker.std_test)
    o.dirs = [o.std]
    return o
  }
  o.dirs = []
  for a in (if rest.is_empty() { ["."] } else { rest }) {
    if cmdhelp.is_pattern(a) {
      // DIR/... (front took any other pattern form): DIR, walked
      let d = cmdhelp.pattern_dir(a)
      o.walk.push(abs_of(o.wd, d))
      o.dirs.push(d)
    } else {
      o.dirs.push(a)
    }
  }
  o
}

/// o.dirs as a command line gives them: DIR/... for a walked one.
fn dir_words(o: Opts) -> List[Str] {
  var out: List[Str] = []
  for d in o.dirs {
    out.push(if o.walk.contains(abs_of(o.wd, d)) { if d == "/" { "/..." } else { "${d}/..." } } else { d })
  }
  out
}

fn set_value(os: Os, var o: Opts, name: Str, v: Str) {
  if name == "o" {
    o.out = v
  } else if name == "targets" || name == "target" {
    o.targets = v
  } else if name == "backend" {
    o.backend = v
  } else if name == "tzdata" {
    o.tzdata = v
  } else if name == "stamp" {
    let parts = v.split("=")
    if parts.len() < 2 || parts[0].is_empty() {
      usage(os, o.cmd, "invalid value \"${v}\" for flag -stamp: --stamp ${v.quote()}: want NAME=VALUE (NAME is a `const NAME: Str` of the main module)")
    }
    var kept: List[(Str, Str)] = []
    for (n, x) in o.stamps {
      if n != parts[0] {
        kept.push((n, x))
      }
    }
    kept.push((parts[0], parts[1..parts.len()].join("=")))
    o.stamps = kept
  } else if name == "seed" {
    o.topts.seed = int_flag(os, o.cmd, name, v)
  } else if name == "opt" {
    if !(v is "O0" | "O1" | "O2" | "O3") {
      os.stdio.eprintln("xo ${o.cmd}: --opt=${v}: want O0, O1, O2 or O3")
      os.proc.exit(2)
    }
    o.opt = v
  } else if name == "explore" {
    o.explore = int_flag(os, o.cmd, name, v)
    o.topts.explore = o.explore
  } else if name == "cases" {
    o.topts.cases = int_flag(os, o.cmd, name, v)
  } else if name == "timeout" {
    o.topts.timeout = match Duration.parse(v) {
      Ok(d) => d
      Err(_) => usage(os, o.cmd, "invalid value \"${v}\" for flag -${name}: parse error")
    }
  } else if name == "record" {
    o.record = v
  } else if name == "trace" {
    // decision 0240: the raw execution trace's file (XO_TRACE)
    o.trace = v
    o.topts.trace = v
  } else if name == "profile" {
    // decision 0238: the CPU profile, the heap profile, or both
    if v != "cpu" && v != "heap" && v != "cpu,heap" && v != "heap,cpu" {
      usage(os, o.cmd, "invalid value \"${v}\" for flag -profile: want cpu, heap, or cpu,heap")
    }
    o.profile = v
    o.topts.profile = v
  } else if name == "run" {
    o.topts.run = v
  } else if name == "std" {
    o.std = v
  } else if name == "std-module" {
    o.std_module = v
  } else if name == "grace" {
    o.grace = match Duration.parse(v) {
      Ok(d) => d
      Err(_) => usage(os, o.cmd, "invalid value \"${v}\" for flag -grace: parse error")
    }
  } else if name == "wd" {
    o.wd = v
  } else if name == "cc" {
    o.cc = look_path(os, v)
  } else if name == "asm" {
    o.asm_path = v
  } else if name == "as" {
    o.assembler = v
  } else if name == "ld" {
    o.linker = v
    if v == "macho" {
      o.assembler = "macho"
    }
  } else if name == "go-tree" {
    o.go_tree = v
  } else if name == "workspace" {
    // cmd/xo moduleFlags: XO_WORK for this run
    if v == "off" {
      o.workspace = "off"
    } else if v is "on" | "auto" {
      o.workspace = "on"
    } else {
      os.stdio.eprintln("xo ${o.cmd}: --workspace=${v}: want off or on")
      os.proc.exit(2)
    }
  }
}

fn set_bool(os: Os, var o: Opts, name: Str, on: Bool) {
  if name == "watch" {
    o.watch = on
  } else if name == "json" {
    o.json = on
    o.topts.json = on
  } else if name == "ci" {
    o.ci = on
  } else if name == "trace-support" {
    o.trace_support = if on { 1 } else { 0 }
  } else if name == "debug-contracts" {
    o.debug_contracts = if on { 1 } else { 0 }
  } else if name == "dbg" {
    o.dbg = if on { 1 } else { 0 }
  } else if name == "release" {
    o.release = on
  } else if name == "s" {
    o.strip = on
  } else if name == "debug-info" {
    o.debug_info = if on { "on" } else { "off" }
  } else if name == "dsym" {
    o.dsym = on
  } else if name == "profile-support" {
    o.profile_support = if on { 1 } else { 0 }
  } else if name == "trimpath" {
    o.trimpath = if on { 1 } else { 0 }
  } else if name == "pack-lists" {
    o.pack_lists = on
  } else if name == "error-args" {
    o.error_args = if on { 1 } else { 0 }
  } else if name == "hybrid" {
    o.hybrid = on
  } else if name == "mono" {
    o.no_mono = o.no_mono || !on
  } else if name == "no-mono" {
    o.no_mono = on
  } else if name == "arenas" {
    o.no_arenas = o.no_arenas || !on
  } else if name == "no-arenas" {
    o.no_arenas = on
  } else if name == "no-preempt" {
    o.no_preempt = on
  } else if name == "no-gc" {
    o.no_gc = on
  } else if name == "holes" {
    o.holes = on
  } else if name == "race" {
    o.race = on
  } else if name == "v" {
    o.topts.verbose = on
  } else if name == "real" {
    o.real = on
    o.topts.real = on
  } else if name == "fail-empty" {
    o.topts.fail_empty = on
  } else if name == "phase-times" {
    o.phases = on
  } else if name == "offline" {
    o.offline = if on { "1" } else { "0" }
  }
}

fn int_flag(os: Os, cmd: Str, name: Str, v: Str) -> Int {
  match Int.parse(v) {
    Some(n) => n
    None => usage(os, cmd, "invalid value \"${v}\" for flag -${name}: parse error")
  }
}

/// A setting's value (decision 0354): the flag's when given (0 or 1),
/// else the preset's.
fn setting(v: Int, preset: Bool) -> Bool { if v < 0 { preset } else { v == 1 } }

/// The profiler (XO_PROF): in a debug build, out of a release one,
/// unless --profile-support says.
fn profile_support_eff(o: Opts, release: Bool) -> Bool { setting(o.profile_support, !release) }

/// --trimpath (on unless it says): the DWARF compile and std directories
/// are recorded relative to the working directory, so a binary does not
/// carry the paths of the machine that built it (decision 0354's addendum;
/// Go's -trimpath, clang's -fdebug-prefix-map)
fn trimpath_eff(o: Opts) -> Bool { setting(o.trimpath, true) }

/// target relative to the working directory cwd for a debugger started in
/// it, "." when target is not below it (no path of the build is kept)
fn rel_or_dot(cwd: Str, target: Str) -> Str { hostpath.rel_below(cwd, target) ?? "." }

/// The execution trace's recorder, as the profiler.
fn trace_support_eff(o: Opts, release: Bool) -> Bool { setting(o.trace_support, !release) }

/// Parameter values in error frames: on in every build unless
/// --error-args=off.
fn error_args_eff(o: Opts) -> Bool { setting(o.error_args, true) }

/// The `(debug)` contract clauses: checked in a debug build, compiled
/// out of a release one, unless --debug-contracts says.
fn debug_contracts_eff(o: Opts, release: Bool) -> Bool { setting(o.debug_contracts, !release) }

/// `dbg(x)` printing: in a debug build, compiled to x in a release one,
/// unless --dbg says.
fn dbg_eff(o: Opts, release: Bool) -> Bool { setting(o.dbg, !release) }

/// The debug information: on, off or split (decision 0355): --debug-info's
/// value when given, else off for a release build and on otherwise.
pub fn debug_info_eff(o: Opts, release: Bool) -> Str {
  if !o.debug_info.is_empty() {
    return o.debug_info
  }
  if release { "off" } else { "on" }
}
