// `xo1 run` (decision 0178 stage 1, cmd/xo runRun): the program is built
// as `xo1 build` builds it, then run with the arguments after its
// directory (or after `--`) on xo1's own standard streams; xo1 exits with
// its status (128 plus the signal number for a program a signal ended).

use std/task
use github.com/xo-lang/xo/compiler/check

/// execBinary: runs bin with args and the extra environment (NAME=value
/// words) on this process's standard input, output, and error; its exit
/// status. A stop request xo gets (SIGINT or SIGTERM, core 7.5) is sent
/// on to the program as SIGTERM when standard input is not a terminal (a
/// process manager, an IDE, a script signals xo's pid alone; 0.25.2 sent
/// nothing on, a field report); on a terminal, Ctrl-C reaches the
/// program through the process group already, and sending it on would
/// be a second signal, which skips the program's grace (core 7.5).
fn exec_binary(os: Os, bin: Str, args: List[Str], env: List[Str]) -> Int {
  var cmd = os.proc.cmd(bin, args).inherit()
  for kv in env {
    let parts = kv.split("=")
    cmd = cmd.set_env(parts[0], parts[1..parts.len()].join("="))
  }
  if os.stdio.stdin_is_tty() {
    return match cmd.run() {
      Ok(code) => code
      Err(e) => {
        os.stdio.eprintln("xo: ${e}")
        1
      }
    }
  }
  let child = match cmd.spawn() {
    Ok(ch) => ch
    Err(e) => {
      os.stdio.eprintln("xo: ${e}")
      return 1
    }
  }
  let pid = child.pid()
  let _fwd = os.tasks.spawn_background(fn() {
    let _ = task.stopping().recv()
    os.proc.kill(pid, "TERM").ignore_err("it may have exited already")
  })
  match child.wait() {
    Ok(code) => code
    Err(e) => {
      os.stdio.eprintln("xo: ${e}")
      1
    }
  }
}

/// `xo build --profile=P` (main.xo): runs this xo again on args with
/// XO_PROF=P, then writes its profile as xo-build.cpu.pprof and
/// xo-build.heap.pprof (and their .txt) in the working directory; the
/// build's exit status.
fn profile_self(os: Os, o: Opts, args: List[Str]) -> Int {
  let xo = check.executable(os.env, os.fs)
  let raw = "${o.wd}/xo-build.xoraw"
  os.fs.remove(raw).ignore_err("not there")
  let code = exec_binary(os, xo, args, ["XO_PROF=${o.profile}", "XO_PROF_OUT=${raw}", "XO_PROF_QUIET=1", "XO_PROF_SELF=1"])
  // xo:allow XO0903 no profile: the build did not get far enough to write one
  if os.fs.exists(raw).ok() ?? false {
    match prof_convert(os, raw, "${o.wd}/xo-build.cpu.pprof", "${o.wd}/xo-build.heap.pprof", true, true) {
      Ok(_) => {}
      Err(e) => os.stdio.eprintln("xo build: ${e}")
    }
  }
  os.fs.remove(raw).ignore_err("not there")
  code
}
