// xo1: the self hosted compiler driver of the switch-over experiment
// (decision 0158): the lexer, parser, checker, SSA builder and its
// passes, and the arm64 emitter, all in Xo, then the system C compiler
// driver to assemble and link with the C runtime (std/llrt), as
// internal/build does for `xo build --backend=arm64` (decision 0174).
//
//   xo1 build [flags] [dir ...]          the directories are one program
//   xo1 run [flags] [dir] [--] [args]    build, then run it with args
//   xo1 test [flags] [dir ...]           build the tests and run them
//   xo1 asm [flags] [dir ...]            print the assembly or LLVM IR
//   xo1 keys [--std=DIR] [--cc=CC]       the cache keys, to compare
//
// The flags are `xo build|run|test`'s with Go's flag rules (opts.xo):
// --backend=arm64|llvm|go|wasm (the default is go as in cmd/xo; arm64
// with --no-gc and for asm),
// --targets, -o, --json, --release, --error-args, --no-mono,
// --no-arenas, --no-gc, --holes, --race, --tzdata, --seed, --explore,
// --record, --run, --cases, -v, --real, --offline, --workspace; and
// xo1's own: --std=DIR --wd=DIR --cc=CC --asm=PATH --go-tree=DIR
// --phase-times (the wall clock of each phase on standard error as
// `phase NAME MS ms` lines).
//
// A build writes to the Go driver's build directory (buildDir, under
// <user cache>/xo/build or $XO_BUILD_DIR) and links the binary there
// (bin/NAME) unless -o names one, printing `os/arch: path` (or the JSON
// result with --json); a check that fails prints its diagnostics as `xo`
// does (diag.xo) and exits 1. With XO_BIN_CACHE the link is looked up in
// and added to the binary cache under the Go driver's key (cache.xo).
//
// --backend=llvm (decision 0178) lowers the same SSA module with the
// LLVM emitter in Xo (compiler/llvm) and compiles the IR with clang
// ($XO_CLANG, else clang; --cc names another) and the C runtime, as
// internal/build buildLLVM does, split into XO_LLVM_SPLIT modules when
// that is set (split.xo, decision 0168); asm prints the IR.
//
// --as=macho (decision 0182): assemble with compiler/macho, cc links;
// --ld=macho: assemble and link with compiler/macho, no cc (ld.xo); with
// --target=linux/arm64 an ELF executable for glibc, from any host; a
// macho build does not use the binary cache.
//
// --backend=go (decision 0167) checks and generates Go with compiler/gen
// and builds it with the Go toolchain (gobackend.xo); the build tree
// (generated packages, runtime, build information) is the build
// directory, or --go-tree.
//
// The runtime sources are read from DIR/llrt (DIR the std directory,
// default std). A link takes the runtime from a prebuilt pack or the
// runtime object cache, the zone data of std/time, and the C inputs of
// `use c`, keyed as internal/build keys them, so both drivers share the
// caches. A target other than the host gets its assembly only, as
// internal/build does. It is not the released `xo` (decision 0150: that
// is the owner's decision after the fixed point).

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/ssa
use github.com/xo-lang/xo/compiler/arm64
use github.com/xo-lang/xo/compiler/llvm
use github.com/xo-lang/xo/compiler/tzsel
use github.com/xo-lang/xo/compiler/cli/core
use github.com/xo-lang/xo/compiler/cli/modules
use github.com/xo-lang/xo/compiler/cli/semantic
use github.com/xo-lang/xo/compiler/cli/bind
use github.com/xo-lang/xo/compiler/cli/servers
use github.com/xo-lang/xo/compiler/cli/cmdhelp

fn main(os: Os) ! {
  let fr = front(os, os.env.args())
  if fr.code >= 0 {
    // help, or a usage error found before any command runs (opts.xo)
    os.proc.exit(fr.code)
  }
  let args = fr.args
  if !args.is_empty() && modules.is_command(args[0]) { os.proc.exit(modules.run(os, os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? "", args)) }
  if !args.is_empty() && args[0] == "bind" { os.proc.exit(bind.run_std(os, args, check.std_dir(os.env, os.fs))) }
  if let Some(code) = servers.forward_cli(os, args) {
    // a running `xo serve` answered check or query
    os.proc.exit(code)
  }
  if !args.is_empty() && args[0] is "query" | "edit" {
    os.proc.exit(semantic.run(os, args))
  }
  // agents' lookups (decision 0261): xo def, refs, type, symbols, doc NAME
  if servers.is_agent_command(os, args) {
    os.proc.exit(servers.run_agent(os, args[0], args[1..]))
  }
  if !args.is_empty() && servers.is_command(args[0]) {
    os.proc.exit(servers.run(os, args[0], args[1..], servers.XO_VERSION))
  }
  if core.is_command(args) {
    os.proc.exit(core.run(os, args))
  }
  if !args.is_empty() && args[0] == "prof" {
    // a native program's raw profile as pprof and text (prof.xo,
    // decision 0245)
    os.proc.exit(prof_cmd(os, args[1..]))
  }
  if !args.is_empty() && args[0] == "trace" {
    // the execution trace's JSON and summary (trace.xo, decision 0240)
    os.proc.exit(trace_cmd(os, args[1..]))
  }
  if !args.is_empty() && args[0] == "dev" {
    // hidden: the developer commands (dev.xo, decision 0209)
    os.proc.exit(dev_cmd(os, args[1..]))
  }
  if args.is_empty() || !(args[0] is "build" | "run" | "asm" | "keys" | "test") {
    os.stdio.eprint("xo: unknown command ${(if args.is_empty() { "" } else { args[0] }).quote()}\n\n${cmdhelp.top()}")
    os.proc.exit(2)
  }
  var o = parse_args(os, args)
  let goos = host_os(os)
  var ctx = Ctx{goos: goos, std: o.std, xo: dir_name(o.std.trim_suffix("/")), cache: user_cache_dir(os, goos)}
  ctx.bin_cache = bin_cache_dir(os, ctx, o.cmd == "test")
  if o.cmd == "keys" {
    keys(os, ctx, o.cc)?
    return
  }
  let what = if o.cmd == "asm" { "build" } else { o.cmd }
  // cmd/xo's checks of the flags, before anything is built
  if !o.error_args && !o.release {
    os.stdio.eprintln("xo build: --error-args=false needs --release (debug builds always record parameters)")
    os.proc.exit(2)
  }
  // the default backend is the host's native one (decision 0248): arm64
  // on arm64 hosts, llvm otherwise; asm prints the arm64 assembly. The
  // flags only the Go backend has (--hybrid, --holes, xo test --explore,
  // xo run --seed and --record) choose it, and --race llvm's
  // ThreadSanitizer (arm64 has no race detector).
  var backend = o.backend
  if backend.is_empty() {
    let go_only = o.hybrid || o.holes || (o.cmd == "test" && o.explore > 0) || (o.cmd == "run" && (o.topts.seed != 0 || !o.record.is_empty()))
    if o.cmd == "asm" {
      backend = "arm64"
    } else if go_only {
      backend = "go"
    } else if host_arch() == "arm64" && !o.race {
      backend = "arm64"
    } else {
      backend = "llvm"
    }
  }
  if !o.trace.is_empty() && backend == "go" {
    os.stdio.eprintln("xo ${what}: --trace needs a native backend (llvm or arm64); a Go backend program traces with runtime/trace")
    os.proc.exit(2)
  }
  if !o.profile.is_empty() && backend == "go" {
    os.stdio.eprintln("xo ${what}: --profile needs a native backend (llvm or arm64); a Go backend program profiles with runtime/pprof")
    os.proc.exit(2)
  }
  if o.hybrid {
    if backend != "go" {
      os.stdio.eprintln("xo build: --hybrid needs the Go backend")
      os.proc.exit(2)
    }
  }
  if o.no_gc && backend == "go" {
    os.stdio.eprintln("xo ${what}: --no-gc needs a native backend (llvm or arm64), not go")
    os.proc.exit(1)
  }
  if o.cmd == "run" && o.topts.seed != 0 && backend != "go" {
    os.stdio.eprintln("xo run: --seed needs the Go backend (native builds use the real scheduler)")
    os.proc.exit(2)
  }
  if o.cmd == "build" && (o.ci || o.release) {
    // cmd/xo runBuild: a release (or --ci) build fails while a workspace
    // overrides a required module, then --ci fails on an unformatted
    // file or a dbg left in code (compiler/cli/core ci.xo)
    let cx = core_ctx(os, o)
    let code = core.release_check(os, cx, o.dirs, o.json, if o.release { "--release" } else { "--ci" })
    if code != 0 {
      os.proc.exit(code)
    }
    if o.ci {
      let code2 = core.ci_check(os, cx, o.dirs, o.json)
      if code2 != 0 {
        os.proc.exit(code2)
      }
    }
  }
  if o.hybrid && o.cmd == "build" && !o.json {
    // decision 0084's Go assembler mode of the arm64 backend
    // (internal/arm64 goasm.go) is not in compiler/arm64: the build is
    // the plain Go build that `xo build --hybrid` falls back to, and the
    // report says why, as the Go driver's does when its assembly fails
    os.stdio.eprintln("hybrid: no assembly (the self hosted arm64 backend has no Go assembler mode yet)")
  }
  if backend == "go" && !o.std_module.is_empty() {
    fail(os, "--std-module needs a native backend (llvm or arm64): the Go backend's std is std/rt, in Go")
  }
  if backend == "go" && (o.cmd == "build" || o.cmd == "test" || o.cmd == "run") {
    build_go(os, ctx, o)?
    return
  }
  if !(backend is "arm64" | "amd64" | "llvm") && !(backend == "wasm" && o.cmd == "build") {
    fail(os, "--backend=${backend}: want arm64, amd64, llvm, or go for build, run, and test, or wasm for build")
  }
  if !(o.assembler is "" | "cc" | "macho") {
    fail(os, "--as=${o.assembler}: want cc or macho")
  }
  if !(o.linker is "" | "cc" | "macho") {
    fail(os, "--ld=${o.linker}: want cc or macho")
  }
  if o.race && backend != "llvm" {
    fail(os, "the ${backend} backend does not support --race: use --backend=llvm (ThreadSanitizer) or --backend=go (Go's race detector)")
  }
  if o.holes {
    fail(os, "the ${backend} backend does not support --holes")
  }
  if o.cmd == "test" {
    if o.explore > 0 {
      os.stdio.eprintln("xo test: --explore needs the Go backend (native builds use the real scheduler)")
      os.proc.exit(2)
    }
    if o.out.is_empty() && o.std_module.is_empty() && (backend is "arm64" | "amd64" | "llvm") {
      // the run cache (testcache.xo): an unchanged program's binary and
      // tests without a build
      let t0 = os.clock.now()
      o.run_start = t0.unix_millis()
      o.run_key = run_key(os, ctx, o, args, backend)
      if let Some(hit) = run_fetch(os, ctx, o.run_key) {
        lap(os, o.phases, "run_cache", t0)
        let code = run_tests(os, hit.bin, hit.tests, o.topts)
        prof_tests(os, o.topts)
        os.fs.remove(hit.bin).ignore_err("a prune removes it later")
        os.proc.exit(code)
      }
      lap(os, o.phases, "run_cache_miss", t0)
    }
  }
  let nb = build_native(os, ctx, o, backend)
  if o.cmd == "test" {
    var to = o.topts
    to.profile_dir = o.wd
    to.std = o.std
    let code = run_tests(os, nb.bin, nb.tests, to)
    prof_tests(os, to)
    if !o.trace.is_empty() {
      // a raw trace per test process (decision 0240)
      os.stdio.eprintln("xo test: execution traces in ${trace_path(to).replace("%p", "<pid>")}; read one with `xo trace FILE`")
    }
    os.proc.exit(code)
  }
  if o.cmd == "run" {
    if !o.record.is_empty() {
      os.stdio.eprintln("xo run: --record needs the Go backend")
      os.proc.exit(2)
    }
    // --profile: the raw profile beside the binary, then xo-cpu.pprof and
    // xo-heap.pprof (and their .txt) in the working directory (prof.xo,
    // decision 0245)
    let raw = "${nb.bin}.prof.xoraw"
    var pe = if o.profile.is_empty() { [] } else { ["XO_PROF=${o.profile}", "XO_PROF_OUT=${raw}", "XO_PROF_QUIET=1"] }
    if !o.profile.is_empty() {
      os.fs.remove(raw).ignore_err("not there")
    }
    if !o.trace.is_empty() {
      // --trace (decision 0240): the raw file, then its JSON and summary
      pe.push("XO_TRACE=${o.trace}")
    }
    let code = exec_binary(os, nb.bin, o.prog_args, pe)
    if !o.profile.is_empty() {
      if os.fs.exists(raw).ok() ?? false {
        match prof_convert(os, raw, "xo-cpu.pprof", "xo-heap.pprof") {
          Ok(_) => {}
          Err(e) => os.stdio.eprintln("xo run: ${e}")
        }
      }
      os.fs.remove(raw).ignore_err("not there")
    }
    if !o.trace.is_empty() {
      let _t = trace_convert(os, o.trace, o.trace + ".json", false)
    }
    os.proc.exit(code)
  }
}

/// What a native build made: the host binary ("" for asm or another
/// target only) and the tests of a test binary.
struct Native {
  bin: Str = ""
  tests: List[TestInfo] = []
  /// The checker's std parses, for the next build of the process
  /// (`xo dev build-each`, decision 0209).
  pc: Map[Str, check.ParseEntry] = {}
}

/// The targets of --targets (internal/build ParseTargets): the host when
/// none is named, `all`, or a comma separated list of os/arch.
fn parse_targets(os: Os, s: Str, host: Str) -> List[Str] {
  if s.is_empty() {
    return [host]
  }
  if s == "all" {
    return ["linux/amd64", "linux/arm64", "darwin/amd64", "darwin/arm64", "windows/amd64", "windows/arm64", "wasip1/wasm"]
  }
  var out: List[Str] = []
  for p0 in s.split(",") {
    let p = p0.trim()
    let parts = p.split("/")
    if parts.len() != 2 || parts[0].is_empty() || parts[1].is_empty() {
      os.stdio.eprintln("xo build: bad target ${p.quote()}: want os/arch")
      os.proc.exit(2)
    }
    let tos = if parts[0] == "wasi" { "wasip1" } else { parts[0] }
    let arch = if parts[1] == "wasm32" { "wasm" } else { parts[1] }
    out.push("${tos}/${arch}")
  }
  out
}

/// The context of the compiler/cli/core checks (--ci, --release) for the
/// command line o: its std, working directory, and module flags.
fn core_ctx(os: Os, o: Opts) -> core.Ctx {
  var offline = os.env.get("XO_OFFLINE") ?? ""
  if o.offline == "1" {
    offline = "1"
  } else if o.offline == "0" {
    offline = ""
  }
  var work = os.env.get("XO_WORK") ?? ""
  if o.workspace == "off" {
    work = "off"
  } else if o.workspace == "on" {
    work = ""
  }
  core.Ctx{std: o.std, wd: o.wd, offline: offline, work: work}
}

/// The names in $XO_LLRT_C (comma separated; `all` selects every C
/// path). A name with no std/native/llrt/<name>_c.xo fails the build:
/// decision 0198 deleted most C paths, and a deleted name that was
/// ignored built the Xo path while claiming to test the C one
/// (knowledgebase/gotchas/deleted-llrt-switch-still-set.md).
fn llrt_c_names(os: Os, std: Str) -> List[Str] {
  var names: List[Str] = []
  for n0 in (os.env.get("XO_LLRT_C") ?? "").split(",") {
    let n = n0.trim()
    if n.is_empty() {
      continue
    }
    if n != "all" && os.fs.read("${std}/native/llrt/${n}_c.xo").is_err() {
      fail(os, "XO_LLRT_C=${n}: no C path named ${n} (std/native/llrt/${n}_c.xo); the C paths left are the std/native/llrt/*_c.xo files, decision 0198 deleted the others")
    }
    names.push(n)
  }
  names
}

/// The checker of a build: the native implementation modules when
/// native, the module environment, and the check of dirs; a check that
/// fails prints its diagnostics (or, with --json on build, the JSON
/// result) and exits 1. Warnings are printed and the build goes on.
fn check_program(os: Os, o: Opts, native: Bool) -> check.Checker {
  let (c, _) = check_program_ov(os, o, native, {})
  c
}

/// check_program with the files of ov (absolute path to source) in the
/// checker's overlay: the generated contract fuzz tests (decision 0250).
/// Their diagnostics are returned, never printed or kept in c.diags; with
/// an overlay the user's own are not printed again (the first check did).
fn check_program_ov(os: Os, o: Opts, native: Bool, ov: Map[Str, Bytes]) -> (check.Checker, List[check.Diag]) {
  var c = check.new_checker(os.fs, o.std)
  c.overlay = ov
  c.parse_cache = o.parse_cache
  c.native = native
  // a native build checks the runtime's bodies as it builds them
  // (decision 0247); XO_CHECK_EAGER=1 checks them all first, as before
  c.lazy = native && (os.env.get("XO_CHECK_EAGER") ?? "") != "1"
  // the C paths of ported runtime modules (decisions 0193, 0206)
  c.llrt_c = llrt_c_names(os, o.std)
  c.std_test = std_test_path(o.std_module)
  var offline = os.env.get("XO_OFFLINE") ?? ""
  if o.offline == "1" {
    offline = "1"
  } else if o.offline == "0" {
    offline = ""
  }
  var work = os.env.get("XO_WORK") ?? ""
  if o.workspace == "off" {
    work = "off"
  } else if o.workspace == "on" {
    work = ""
  }
  c.set_mod_env(o.wd, os.env.get("XO_MODCACHE") ?? "", os.env.get("HOME") ?? "", os.env.get("XDG_CACHE_HOME") ?? "", offline, work)
  c.cbind_dir = os.env.get("XO_CBIND_DIR") ?? ""
  c.gobind_dir = os.env.get("XO_GOBIND_DIR") ?? ""
  // binds a `use go` or `use c` missing from the cache first, as the
  // Go checker does (decision 0178 stage 6)
  // and fetches a module version missing from the module cache
  match c.check_dirs_fetching(os, o.dirs, fn(p: Str, v: Str) -> Str ! check.Problem { modules.fetch(os, o.wd, p, v) }) {
    Ok(_) => {}
    Err(e) => fail(os, "check: ${e}")
  }
  if !c.unsupported.is_empty() {
    fail_unsupported(os, "unsupported: ${c.unsupported}")
  }
  // the generated tests' diagnostics apart from the user's
  var gen_ds: List[check.Diag] = []
  if !ov.is_empty() {
    var user: List[check.Diag] = []
    for d in c.diags {
      if is_fuzz_path(d.file) {
        gen_ds.push(d)
      } else {
        user.push(d)
      }
    }
    c.diags = user
  }
  var ds = c.diags
  var bad = blocks(ds, o.holes)
  if !bad && o.cmd != "test" {
    // the stamped constants (applyStamps), after a check that passed
    let sd = apply_stamps(c, o.stamps)
    if !sd.is_empty() {
      ds = ds + sd
      bad = true
    }
  }
  if bad {
    if o.json && o.cmd == "build" {
      os.stdio.print(build_json(false, [], ds))
    } else {
      print_diags(os, in_scope(os, o, ds))
    }
    os.proc.exit(1)
  }
  if !(o.json && o.cmd == "build") && ov.is_empty() {
    print_diags(os, in_scope(os, o, c.diags))
  }
  (c, gen_ds)
}

/// The diagnostics to print: every error, and the warnings of files in
/// the directories the command names (a build of compiler/xo does not
/// print compiler/ssa's warnings, though they are one module; `xo vet`
/// and `xo check` on that directory do). XO_WARNINGS=all prints them
/// all; the warnings left out are counted on one line.
fn in_scope(os: Os, o: Opts, ds: List[check.Diag]) -> List[check.Diag] {
  if (os.env.get("XO_WARNINGS") ?? "") == "all" {
    return ds
  }
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  let abs = fn(p: Str) -> Str { if p.starts_with("/") { p } else { "${wd}/${p}".replace("/./", "/") } }
  var roots: List[Str] = []
  for d in o.dirs {
    roots.push(abs(d.trim_suffix("/...").trim_suffix("/.").trim_suffix("/")) + "/")
  }
  if roots.is_empty() {
    roots.push("${wd}/")
  }
  var out: List[check.Diag] = []
  var left = 0
  for d in ds {
    var shown = !d.warning || d.file.is_empty()
    let f = abs(d.file)
    for r in roots {
      // a directory covers the directories below it (decision 0210)
      shown = shown || f.starts_with(r) || "${f}/" == r
    }
    if shown {
      out.push(d)
    } else {
      left += 1
    }
  }
  if left > 0 {
    os.stdio.eprintln("xo: ${left} warning${if left == 1 { "" } else { "s" }} in files outside the directories built (XO_WARNINGS=all prints them)")
  }
  out
}

/// A native build (arm64 or llvm, or wasm): check, SSA, passes, code,
/// then the link of the host target into the build directory or -o.
fn build_native(os: Os, ctx: Ctx, o: Opts, backend: Str) -> Native {
  let phases = o.phases
  let goos = ctx.goos
  // LLVM builds for the host; the arm64 backend for arm64 (on an amd64
  // host its default is still the arm64 code of the host's OS)
  // amd64: Xo's own x86_64 backend (decision 0254), linux/amd64 only
  let march = if backend == "amd64" { "amd64" } else { "arm64" }
  let host = if backend == "llvm" { "${goos}/${host_arch()}" } else { "${goos}/${march}" }
  let targets = parse_targets(os, o.targets, host)
  // the LLVM backend: the host, or one other target clang cross
  // compiles for with the host's SDK (llvm_cross_triple: windows/arm64 on
  // windows/amd64, decision 0197), or Windows from any host given a
  // Windows sysroot (XO_WINSYSROOT)
  var ltarget = host
  var cross: List[Str] = []
  let winsysroot = os.env.get("XO_WINSYSROOT") ?? ""
  for tg in targets {
    if backend == "arm64" && !(tg is "darwin/arm64" | "linux/arm64") {
      fail(os, "the arm64 backend builds for darwin/arm64 and linux/arm64, not ${tg}")
    }
    if backend == "amd64" && !(tg is "linux/amd64" | "darwin/amd64") {
      fail(os, "the amd64 backend builds for linux/amd64 and darwin/amd64, not ${tg} (decision 0254)")
    }
    if backend == "llvm" && tg != host {
      let sysroot = if tg.starts_with("linux/") { os.env.get("XO_LINUXSYSROOT") ?? "" } else { winsysroot }
      let triple = llvm_cross_triple(host, tg, sysroot)
      if triple.is_empty() || targets.len() > 1 {
        let hint = if tg.starts_with("windows/") { " (set XO_WINSYSROOT to a Windows sysroot to cross build for Windows)" } else { "" }
        fail(os, "the LLVM backend builds for the host (${host}) only, not ${tg}${hint}")
      }
      ltarget = tg
      cross = llvm_cross_flags(host, triple, sysroot)
    }
  }
  // the link's context: its target OS (a cross build's)
  var lctx = ctx
  lctx.tgoos = ltarget.split("/")[0]
  let tests = o.cmd == "test"
  let release = o.release && !tests
  var t = os.clock.now()
  var c = check_program(os, o, true)
  var fz = FuzzSet{}
  if o.cmd == "test" {
    // contract fuzzing as generated property tests (decision 0250)
    let (c2, f2) = fuzz_check(os, o, c)
    c = c2
    fz = f2
  }
  t = lap(os, phases, "check", t)
  if o.backend.is_empty() {
    // a program with `use go` builds only with the Go backend: say so,
    // rather than the native build's errors on each Go use (decision 0248)
    for m in c.mods {
      if !m.go_path.is_empty() {
        os.stdio.eprintln("xo ${o.cmd}: this program uses the Go package \"${m.go_path}\" (`use go`), which needs the Go backend: add --backend=go (the default backend is native, decision 0248)")
        os.proc.exit(2)
      }
    }
  }
  var uses_time = false
  for m in c.mods {
    uses_time = uses_time || m.path == "native/time"
  }
  let root = line_root(os, o.wd, o.dirs[0])
  // the predeclared `target` of each target (internal/build's
  // ssa.Options GOOS, GOARCH): one SSA per target OS, as the Go driver
  // builds one per target; the first target's here, another OS's in the
  // arm64 loop below
  var tgoos = ""
  var tgoarch = ""
  if backend is "arm64" | "amd64" | "llvm" {
    tgoos = targets[0].split("/")[0]
    tgoarch = if backend == "llvm" { ltarget.split("/")[1] } else { march }
  } else if backend == "wasm" {
    // the architecture of a WASI module: std/native/llrt/sysio.xo's
    // Linux system calls are not for it (decision 0206); `target.os`
    // stays the host's (gotchas/wasm-target-os-is-the-host.md)
    tgoarch = "wasm"
  }
  var lo = lower(os, o, c, root, tests, release, uses_time, tgoos, tgoarch, backend == "wasm", t)
  t = lo.t
  let b = lo.b
  let tu = lo.tu
  if backend == "wasm" {
    // the zone data std/time reads (as the native link embeds it)
    build_wasm(os, b.m, o.out, o.wd, o.dirs[0], tzsel.tz_select(os, ctx.std, tu, o.tzdata))
    return Native{pc: c.parse_cache}
  }
  // the build directory (buildDir, then the backend's subdirectory)
  let mode = if tests { 1 } else { 0 }
  let variant = if release { "release" } else { "" }
  let bdir = match build_dir(os, ctx, o.wd, o.dirs, mode, false, false, false, [variant]) {
    Ok(d) => d
    Err(e) => fail(os, "${e}")
  }
  var cc = o.cc
  var name = prog_name(o.wd, o.dirs)
  if tests {
    name = "${name}.test"
  }
  var out = o.out
  if !out.is_empty() {
    out = abs_of(o.wd, out)
  }
  if backend == "llvm" {
    if cc.is_empty() {
      cc = find_clang(os)
      if cc.is_empty() {
        if o.backend.is_empty() {
          // the default backend on this host (decision 0248)
          fail(os, "the LLVM backend (the default on this host) needs clang: install it (xcode-select --install on macOS, your distribution's clang package on Linux) or set XO_CLANG, or build with --backend=go")
        }
        fail(os, "the LLVM backend needs clang: install it or set XO_CLANG")
      }
    }
    // DWARF line tables (decision 0239), as for arm64 below
    var lm = b.m
    lm.debug_info = o.cmd != "asm" && !o.strip && (!release || o.debug_info)
    lm.comp_dir = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
    let lsd = dir_name(ctx.std.trim_suffix("/"))
    lm.std_root = if lsd.starts_with("/") { lsd } else { "${lm.comp_dir}/${lsd}" }
    var g = llvm.new_gen(lm)
    g.goarch = tgoarch
    g.goos = tgoos
    // --race (decision 0241): ThreadSanitizer over every function
    g.tsan = o.race
    let ir = g.generate()
    t = lap(os, phases, "emit", t)
    if !g.err.is_empty() {
      fail(os, g.err)
    }
    if !g.skipped.is_empty() {
      fail_unsupported(os, "the LLVM emitter skipped ${g.skipped[0]}")
    }
    // with no C library, no libgcc: arm64 atomics call the outline helpers
    // the link writes (nolibc_atomics), which dispatch on xo_lse
    let attr_flags = if nolibc(os, o, c, lctx.tgoos) && tgoarch == "arm64" { cross + ["-moutline-atomics"] } else { cross }
    let code = with_target_attrs(ir, clang_target_attrs(os, cc, attr_flags))
    if o.cmd == "asm" {
      os.stdio.print(code)
      lap(os, phases, "print", t)
      return Native{pc: c.parse_cache}
    }
    var split = split_config(os)
    if release {
      split.opt = "-O2"
    } else if tests && !split.opt_set {
      // a test binary is built at -O0, so with no LTO (decision 0236:
      // examples/notes-service's link 38.7 s at -O2, 5.4 s at -O0)
      split.opt = "-O0"
    }
    let parts = split_ir(code, split.modules)
    var dir = "${bdir}/llvm"
    if o.race {
      dir = "${dir}-race"
    }
    if ltarget != host {
      dir = "${dir}-${ltarget.replace("/", "-")}"
    }
    if parts.len() > 1 {
      // a split build has its own directory (a single module build of
      // the same program may run at the same time)
      dir = "${dir}-split${parts.len()}-${split.lto}"
    }
    write_or_fail(os, dir, "", b"")
    var lls: List[Str] = []
    for (i, part) in parts.indexed() {
      let ll = if parts.len() > 1 { "${dir}/prog.${i}.ll" } else { "${dir}/prog.ll" }
      write_or_fail(os, dir, ll, part.bytes())
      lls.push(ll)
    }
    if !o.asm_path.is_empty() {
      write_or_fail(os, dir, o.asm_path, code.bytes())
    }
    t = lap(os, phases, "write", t)
    let bin = bin_path(dir, out, name, ltarget, false)
    var lk = link_inputs(os, ctx, o, c, dir, code, uses_time, tu, false, lctx.tgoos, tgoarch)
    lk.flags = cross + lk.flags
    if o.race {
      // without the instrumentation of function entry and exit: it gives
      // a function a cleanup pad that resumes the unwind, which the Xo
      // fault unwinder cannot resume (gotchas/tsan-func-exit-pads.md)
      lk.flags = lk.flags + ["-fsanitize=thread", "-mllvm", "-tsan-instrument-func-entry-exit=0"]
    }
    let lto1 = single_lto(split)
    var mode_flags = ["llvm", split.opt]
    if lls.len() > 1 {
      mode_flags = mode_flags + ["split", split.lto]
    } else {
      mode_flags = mode_flags + ["lto", lto1]
    }
    let srcs = lls + lk.srcs
    let key = native_bin_key(os, ctx, dir, cc, mode_flags + lk.flags + lk.link_only, srcs)
    let (hit, entry) = fetch_bin(os, ctx, key, bin)
    if !hit {
      write_or_fail(os, dir_name(bin), "", b"")
      let dsym = lm.debug_info && lctx.tgoos == "darwin" && ctx.goos == "darwin"
      let lto = if lls.len() > 1 { split.lto } else { lto1 }
      let lflags = (if dsym { lk.flags + lto_object_flags(os, dir, lto) } else { lk.flags }) + lk.link_only
      let msg = if lls.len() > 1 {
        split_build(os, lctx, cc, lls, lk.srcs, bin, split, lflags)
      } else {
        cc_build(os, lctx, cc, [split.opt] + single_lto_flags(lto1) + ["-Wno-override-module"] + lflags, srcs, bin)
      }
      if !msg.is_empty() {
        os.stdio.eprint(msg)
        fail(os, "${cc} failed")
      }
      if dsym {
        cc_dsym(os, bin)
      }
      store_bin(os, ctx, entry, bin)
    }
    lap(os, phases, "cc", t)
    return finish(os, ctx, o, c, root, [(ltarget, bin)], tests, fz)
  }
  // arm64 (and amd64, the arm64 MIR retargeted): the assembly of each
  // target; the host's is linked
  let dir = "${bdir}/${march}"
  write_or_fail(os, dir, "", b"")
  var cur = b
  var cur_tu = tu
  var cur_os = tgoos
  var mi = cur.m
  var inl = inline_or_say(os, mi, emit_jobs(os))
  t = lap(os, phases, "inline", t)
  var bins: List[(Str, Str)] = []
  for tg in targets {
    let tgoos = tg.split("/")[0]
    if tgoos != cur_os {
      // another OS: its own SSA, its `target` that OS's
      let l = lower(os, o, c, root, tests, release, uses_time, tgoos, march, false, t)
      cur = l.b
      cur_tu = l.tu
      cur_os = tgoos
      mi = cur.m
      inl = inline_or_say(os, mi, emit_jobs(os))
      t = lap(os, phases, "inline", l.t)
    }
    // arm64.generate_module(cur.m, tgoos, false), timed
    let jobs = emit_jobs(os)
    // with the per-function cache (decision 0220 addendum stage B)
    var gm = if inl { mi } else { cur.m }
    // whole program dead function removal (arm64 reach.xo); not for `xo
    // asm`, which shows every function (xo dev codegen reads inlined ones)
    if o.cmd != "asm" && (os.env.get("XO_DCE") ?? "") != "off" {
      let d = arm64.drop_unreached(gm)
      // XO_DCE=debug says how many, =list also which
      let how = os.env.get("XO_DCE") ?? ""
      if how == "debug" || how == "list" {
        let ls = d.split("\n")
        os.stdio.eprintln("dce: ${ls[0]}")
        if how == "list" {
          for n in ls[1..ls.len()] {
            os.stdio.eprintln("dce dropped ${n}")
          }
        }
      }
      t = lap(os, phases, "dce", t)
    }
    gm.passes_off = passes_off(os)
    gm.arm64_regs = Int.parse(os.env.get("XO_ARM64_REGS") ?? "") ?? 0
    gm.poison_frames = (os.env.get("XO_POISON_FRAMES") ?? "") == "1"
    // DWARF line tables (decision 0239): on, except for `xo asm`, -s, and
    // a release build without --debug-info
    gm.debug_info = o.cmd != "asm" && !o.strip && (!release || o.debug_info)
    // a string literal's address in a variable's location: not through
    // dsymutil (a cc link on macOS), which relocates it as the function's
    let own_ld = o.linker == "macho" || (o.linker.is_empty() && default_ld(os, ctx, o, c, tgoos, "", false))
    gm.dw_data_addrs = gm.debug_info && (tgoos != "darwin" || own_ld)
    gm.comp_dir = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
    let sd = dir_name(ctx.std.trim_suffix("/"))
    gm.std_root = if sd.starts_with("/") { sd } else { "${gm.comp_dir}/${sd}" }
    // no per-function cache for amd64 yet (its canonical text is
    // arm64's), nor with passes off (XO_PASSES: its keys do not say so)
    let (fc, fdir) = if march == "amd64" || !gm.passes_off.is_empty() { (arm64.FnCache{}, "") } else { fn_cache_load(os, ctx, gm, tgoos, jobs, release) }
    if !fdir.is_empty() {
      t = lap(os, phases, "fn_keys", t)
    }
    let p = arm64.generate_cached(gm, if march == "amd64" { "${tgoos}-amd64" } else { tgoos }, jobs, fc)
    t = lap(os, phases, "emit", t)
    if !fdir.is_empty() {
      fn_cache_store(os, fdir, p.stores)
      cache_note(os, phases, "functions", p.reused, fc.keys.len())
      if !p.mismatches.is_empty() {
        fail(os, "XO_BACKEND_CACHE=verify: ${p.mismatches.len()} functions differ from their cache entries, the first ${p.mismatches[0]}")
      }
    }
    if !p.err.is_empty() {
      fail(os, p.err)
    }
    if !p.skipped.is_empty() {
      fail_unsupported(os, "the emitter skipped ${p.skipped[0]}")
    }
    let code = p.asm
    if o.cmd == "asm" {
      os.stdio.print(code)
      lap(os, phases, "print", t)
      continue
    }
    let s = "${dir}/prog-${tgoos}.s"
    write_or_fail(os, dir, s, code.bytes())
    if !o.asm_path.is_empty() {
      write_or_fail(os, dir, o.asm_path, code.bytes())
    }
    t = lap(os, phases, "write", t)
    // --ld=macho links arm64 programs without cc, linux/arm64 ones from
    // any host (decision 0182); with no --ld, the host's darwin/arm64
    // link is macho's when the pack has its runtime and no `use c`
    // source is linked, else cc's, and a linux/arm64 program with no C
    // library links with the ELF linker from any host, a cross build too
    // (default_ld, decision 0243: as GOOS=linux go build)
    // the amd64 backend's darwin/amd64 program, on an arm64 Mac too
    // (decision 0254 stage 6a): Xo's Mach-O x86_64 assembler and linker
    // as darwin/arm64's (--as=cc for Apple's cc, which then links too)
    let mac_x86 = march == "amd64" && tg == "darwin/amd64" && host.starts_with("darwin/")
    var no_cc = o.linker == "macho"
    if o.linker.is_empty() && (tg == host || tgoos == "linux" || mac_x86) {
      no_cc = default_ld(os, ctx, o, c, tgoos, code, uses_time)
    }
    let macho_as = if mac_x86 { o.assembler != "cc" } else { o.assembler == "macho" || (no_cc && o.assembler.is_empty()) }
    if tg != host && !(no_cc && tgoos == "linux") && !mac_x86 {
      // another target: its assembly only (internal/build buildArm64)
      if !o.json {
        os.stdio.println("${tg}: ${s}")
      }
      continue
    }
    if cc.is_empty() && !no_cc {
      cc = find_cc(os)
      if cc.is_empty() {
        fail(os, "the arm64 backend needs a C compiler to assemble and link: install one (macOS: xcode-select --install; Debian or Ubuntu: apt-get install gcc, or clang) or set XO_CC")
      }
    }
    let bin = bin_path(dir, out, name, tg, false)
    let lk = link_inputs(os, ctx, o, c, dir, code, uses_time, cur_tu, no_cc, tgoos, march)
    let flags = ["-O2"] + lk.flags
    // the program's assembly: one file, or the files of a parallel
    // generation, which assemble apart (arm64.generate_parallel)
    var progs = [s]
    if p.parts.len() > 1 {
      progs = []
      for (i, part) in p.parts.indexed() {
        let ps = "${dir}/prog-${tgoos}.${i}.s"
        write_or_fail(os, dir, ps, part.bytes())
        progs.push(ps)
      }
    }
    if macho_as {
      // the objects from compiler/macho (decision 0182), on parallel
      // tasks for the parts
      let srcs = if p.parts.len() > 1 { p.parts } else { [code] }
      var objs: List[Str] = []
      let (assembled, nasm) = cached_macho_objects(os, ctx, srcs, tgoos == "linux", march == "amd64", jobs)
      for (i, r) in assembled.indexed() {
        let obj = if progs.len() > 1 { "${dir}/prog-${tgoos}.${i}.o" } else { "${dir}/prog-${tgoos}.o" }
        match r {
          Ok(b) => write_or_fail(os, dir, obj, b)
          Err(e) => fail(os, "assembler: ${e}")
        }
        objs.push(obj)
      }
      progs = objs
      t = lap(os, phases, "assemble", t)
      cache_note(os, phases, "objects", srcs.len() - nasm, srcs.len())
    }
    let srcs = progs + lk.srcs
    if no_cc {
      write_or_fail(os, dir_name(bin), "", b"")
      let why = macho_link(os, ctx, tgoos, flags, srcs, bin, o.strip, nolibc(os, o, c, tgoos))
      if !why.is_empty() {
        fail(os, why)
      }
      t = lap(os, phases, "link", t)
      bins.push((tg, bin))
      continue
    }
    let key = if macho_as { "" } else { native_bin_key(os, ctx, dir, cc, [march] + flags + lk.link_only, srcs) }
    let (hit, entry) = fetch_bin(os, ctx, key, bin)
    if !hit {
      write_or_fail(os, dir_name(bin), "", b"")
      var lsrcs = srcs
      if progs.len() > 1 && !macho_as {
        // the parts assembled by parallel cc processes, then linked
        let (objs, why, nasm) = cached_cc_assemble(os, ctx, cc, flags + memo_sysroot(os, ctx), progs, p.parts, jobs)
        if !why.is_empty() {
          os.stdio.eprint(why)
          fail(os, "${cc} failed")
        }
        lsrcs = objs + lk.srcs
        t = lap(os, phases, "assemble", t)
        cache_note(os, phases, "objects", progs.len() - nasm, progs.len())
      }
      let msg = cc_build(os, ctx, cc, flags + lk.link_only, lsrcs, bin)
      if !msg.is_empty() {
        os.stdio.eprint(msg)
        fail(os, "${cc} failed")
      }
      if gm.debug_info && tgoos == "darwin" {
        cc_dsym(os, bin)
      }
      store_bin(os, ctx, entry, bin)
    }
    t = lap(os, phases, "cc", t)
    bins.push((tg, bin))
  }
  if o.cmd == "asm" {
    return Native{pc: c.parse_cache}
  }
  finish(os, ctx, o, c, root, bins, tests, fz)
}

/// The tasks of the parallel stages of a build (ssa insert_rc_jobs,
/// arm64.generate_parallel, the parts' assembly): $XO_EMIT_JOBS, else
/// the physical cores, at most 16 and a third of the memory in GB. The
/// output does not depend on it.
fn emit_jobs(os: Os) -> Int {
  let j = Int.parse(os.env.get("XO_EMIT_JOBS") ?? "") ?? 0
  if j > 0 {
    return j
  }
  // the physical cores; each task holds about 1.2 GB of the self build
  // at its peak (bench/results/fast-builds-2026-10-13.md)
  ncores(os).min(16).min(mem_gb(os) / 3).max(1)
}

/// The linker of a host link with no --ld (decision 0182 next step 1 and
/// its 2026-10-16 addendum): compiler/macho on darwin when the assembler
/// is not --as=cc and no `use c` source is linked, else cc; --ld=cc
/// selects cc. (cc was the default again from 643b8261 to this change,
/// while macho's binaries waited at exec: an XProtect false positive,
/// gotchas/xprotect-false-positive-empty-list.md, and a path relinked
/// under a running exec, gotchas/amfi-gatekeeper-macho-layout.md.) For a
/// linux/arm64 target, from a linux host or cross built from any other,
/// a program with no C library links with the ELF linker's static mode
/// (decision 0243, as Go links); one with the C library (XO_NOLIBC=0, or
/// `use c`) keeps cc and glibc (a cross build of one: its assembly, as
/// before).
fn default_ld(os: Os, ctx: Ctx, o: Opts, c: check.Checker, tgoos: Str, code: Str, uses_time: Bool) -> Bool {
  if o.assembler == "cc" {
    return false
  }
  if tgoos == "linux" {
    return nolibc(os, o, c, tgoos)
  }
  if ctx.goos != "darwin" || tgoos != "darwin" {
    return false
  }
  for m in c.mods {
    if !m.c_prefix.is_empty() {
      return false
    }
  }
  true
}

/// A program lowered to SSA for one target OS, with the passes run: the
/// builder, the zone data std/time needs, and the time after.
struct Lowered {
  b: ssa.Builder
  tu: tzsel.TZUse
  t: Time
}

/// The SSA of the checked program for tgoos/tgoarch (the predeclared
/// `target`), then the passes; fails as the build does.
fn lower(os: Os, o: Opts, c: check.Checker, root: Str, tests: Bool, release: Bool, uses_time: Bool, tgoos: Str, tgoarch: Str, wasm: Bool, t0: Time) -> Lowered {
  // the runtime's profiler: in every build but a release one without
  // --profile-support (decision 0238); --profile asks for it too
  let prof = !release || o.profile_support || !o.profile.is_empty()
  // the amd64 backend lowers only cpu.xo's carry arithmetic yet
  let soft_cpu = o.backend == "amd64"
  var b = ssa.build_program_cpu(c, root, tests, release, tests && o.real, tgoos, tgoarch, wasm, !wasm && nolibc(os, o, c, tgoos), prof, o.trace_support, soft_cpu)
  b.imm_rc = o.backend != "llvm"
  b.m.nolibc_start = !wasm && nolibc(os, o, c, tgoos)
  b.m.nolibc = !wasm && nolibc(os, o, c, tgoos)
  var t = lap(os, o.phases, "ssa", t0)
  if !b.why.is_empty() {
    fail_unsupported(os, b.why)
  }
  if !b.errs.is_empty() {
    // what the builder does not lower: the Go driver's XO1201
    // diagnostics (ssa.NoGCDiagnostics); under switch point A the Go
    // driver builds it or reports them itself
    if !(os.env.get("XO1_FALLBACK") ?? "").is_empty() {
      fail_unsupported(os, "the SSA builder does not support ${b.errs[0].feature}")
    }
    let nd = ssa.nogc_diags(b)
    if o.json && o.cmd == "build" {
      os.stdio.print(build_json(false, [], nd))
    } else {
      print_diags(os, nd)
    }
    os.proc.exit(1)
  }
  for f in b.m.funcs {
    if !f.skip.is_empty() {
      fail_unsupported(os, "the SSA builder skipped ${f.name}: ${f.skip}")
    }
  }
  // the zone data std/time needs, noted as the Go builder lowers
  let tu = if uses_time { tzsel.tz_use(c, b.m, root) } else { tzsel.TZUse{} }
  t = lap(os, o.phases, "tz", t)
  // b.run_passes(), timed
  b.prune_unwind()
  t = lap(os, o.phases, "prune_unwind", t)
  b.add_landings()
  t = lap(os, o.phases, "add_landings", t)
  b.cleanup_all()
  t = lap(os, o.phases, "cleanup", t)
  rc_cached(os, b, release, emit_jobs(os), o.phases)
  t = lap(os, o.phases, "insert_rc", t)
  Lowered{b: b, tu: tu, t: t}
}

/// The end of a native build: the test list of a test binary, or the
/// result of `build` (`os/arch: path` lines on standard output, or the
/// JSON result).
fn finish(os: Os, ctx: Ctx, o: Opts, c: check.Checker, root: Str, bins: List[(Str, Str)], tests: Bool, fz: FuzzSet) -> Native {
  var host_bin = ""
  for (_, p) in bins {
    host_bin = p
  }
  if tests {
    let ts = test_infos(c, root, o.wd, fz)
    if !o.run_key.is_empty() && c.diags.is_empty() {
      run_store(os, ctx, o.run_key, c, o.std, o.wd, host_bin, ts, o.run_start)
    }
    return Native{bin: host_bin, tests: ts, pc: c.parse_cache}
  }
  if o.cmd == "build" {
    if o.json {
      os.stdio.print(build_json(true, bins, c.diags))
    } else {
      for (tg, p) in bins.sort_by(fn(x) { x.0 }) {
        os.stdio.println("${tg}: ${p}")
      }
    }
  }
  Native{bin: host_bin, pc: c.parse_cache}
}

/// The sources and flags a native link adds to the program's code
/// (buildArm64 and buildLLVM after the code): the zone data of std/time,
/// the runtime's I/O flags, and the inputs of `use c` (no C runtime since
/// decision 0234).
struct LinkInputs {
  srcs: List[Str] = []
  flags: List[Str] = []
  /// the link's only (not the assembler's): `-s` leaves the symbol
  /// table out (ld -s on Linux; ld64 ignores -s, so -x there, which
  /// keeps the exports and imports dyld needs)
  link_only: List[Str] = []
}

fn link_inputs(os: Os, ctx: Ctx, o: Opts, c: check.Checker, dir: Str, code: Str, uses_time: Bool, tu: tzsel.TZUse, no_cc: Bool, tgoos: Str, tgoarch: Str) -> LinkInputs {
  // no C runtime (decision 0234; std/llrt/xo_rt.c deleted after seed
  // 0.16.0)
  var lk = LinkInputs{}
  if o.strip {
    lk.link_only = if tgoos == "darwin" { ["-Wl,-x"] } else { ["-s"] }
  }
  // std/time: the program's zone data beside the runtime (timeFlags)
  if uses_time {
    if !(o.tzdata is "" | "embedded" | "system") {
      fail(os, "unknown --tzdata=${o.tzdata} (want embedded or system)")
    }
    let sel = tzsel.tz_select(os, ctx.std, tu, o.tzdata)
    if !sel.err.is_empty() {
      fail(os, sel.err)
    }
    match if no_cc { tz_object(os, dir, sel, tgoos, tgoarch) } else { tz_source(os, dir, sel) } {
      Ok(p) => lk.srcs.push(p)
      Err(e) => fail(os, "${e}")
    }
    if !(o.json && o.cmd == "build") {
      for n in sel.notes {
        os.stdio.eprintln(n)
      }
    }
  }
  // the adapters, link files, and libraries of `use c` (cInputs)
  let ci = c_inputs(os, c, dir)
  if !ci.err.is_empty() {
    fail(os, ci.err)
  }
  if nolibc(os, o, c, tgoos) {
    // a static program with no C library (decisions 0203, 0206)
    if !ci.srcs.is_empty() || !ci.flags.is_empty() {
      fail(os, "XO_NOLIBC=1: a program with `use c` links the C library (decision 0205)")
    }
    for n in (os.env.get("XO_LLRT_C") ?? "").split(",") {
      if n.trim() == "net" {
        // the C path of the network is the C library's sockets and
        // getaddrinfo (std/native/llrt/net_c.xo); `all` leaves the
        // network on Xo's, the only path with no C library
        fail(os, "XO_NOLIBC=1: XO_LLRT_C=net selects the C library's sockets and getaddrinfo (decision 0206 stage 3)")
      }
    }
    // the target's (a linux/amd64 cross build from an arm64 Mac took the
    // host's: arm64 flags and atomics assembly for an x86_64 link)
    let arch = tgoarch
    lk.flags = lk.flags + nolibc_flags(arch)
    if arch == "arm64" && !no_cc {
      // the arm64 emitter's read modify writes call libgcc's outline
      // atomics on Linux, which a link with no C library lacks (the ELF
      // linker synthesizes them itself)
      match nolibc_atomics(os, dir) {
        Ok(p) => lk.srcs.push(p)
        Err(e) => fail(os, "${e}")
      }
    }
  }
  lk.flags = lk.flags + ci.flags
  lk.srcs = lk.srcs + ci.srcs
  if tgoos == "darwin" && tgoarch == "amd64" {
    // the amd64 backend's darwin/amd64 program when the Mac's cc links it
    // (--as=cc, or `use c`; decision 0254 stage 6a)
    lk.flags = ["-arch", "x86_64"] + lk.flags
  }
  lk
}

/// Writes data to path (path "" only creates dir), or fails.
fn write_or_fail(os: Os, dir: Str, path: Str, data: Bytes) {
  match os.fs.create_dir_all(dir) {
    Ok(_) => {}
    Err(e) => fail(os, "${e}")
  }
  if path.is_empty() {
    return
  }
  let pd = dir_name(path)
  if pd != dir && pd != "." {
    os.fs.create_dir_all(pd).ignore_err("the write reports it")
  }
  match os.fs.write(path, data) {
    Ok(_) => {}
    Err(e) => fail(os, "${e}")
  }
}

/// `xo1 keys`: the cache keys this driver computes; none since the
/// prebuilt runtime's went with the C runtime (decision 0234).
fn keys(os: Os, ctx: Ctx, _cc: Str) -> () ! FsErr {
  let _o = os
  let _c = ctx
  Ok(())
}

/// The directory fault positions are relative to (internal/build
/// lineRoot): the nearest directory holding xo.mod at or above dir, else
/// dir itself, absolute.
fn line_root(os: Os, wd: Str, dir: Str) -> Str {
  var abs = dir.trim_suffix("/")
  if abs.starts_with("./") {
    abs = abs.trim_prefix("./")
  }
  if !is_abs_path(abs) {
    abs = if abs == "." { wd } else { "${wd}/${abs}" }
  }
  var d = abs
  while !d.is_empty() {
    if os.fs.exists("${d}/xo.mod").ok() ?? false {
      return rel_to(wd, d)
    }
    let parts = d.split("/")
    if parts.len() <= 1 {
      break
    }
    d = parts[0..parts.len() - 1].join("/")
  }
  rel_to(wd, abs)
}

/// p relative to wd when it is below it (the checker's file paths are
/// relative to the working directory for relative arguments).
fn rel_to(wd: Str, p: Str) -> Str {
  if p.starts_with("${wd}/") {
    return p.trim_prefix("${wd}/")
  }
  p
}

fn fail(os: Os, msg: Str) -> Never {
  os.stdio.eprintln("xo: ${msg}")
  os.proc.exit(1)
}

/// lap prints the time since t as phase name when on (--phase-times)
/// and returns the time now.
fn lap(os: Os, on: Bool, name: Str, t: Time) -> Time {
  if on {
    os.stdio.eprintln("phase ${name} ${os.clock.since(t).millis()} ms")
  }
  os.clock.now()
}

/// The optional passes $XO_PASSES turns off (arm64 passes.xo); a wrong
/// value fails the build.
fn passes_off(os: Os) -> List[Str] {
  let (off, err) = arm64.parse_passes(os.env.get("XO_PASSES") ?? "")
  if !err.is_empty() {
    fail(os, err)
  }
  off
}

/// arm64's inlining of mi, and whether the inlined module is to be
/// generated. When it does not verify the module is generated without
/// inlining (slower, still correct): said on standard error with the
/// first error (it names the function), and a failed build with
/// XO_INLINE_STRICT=1, which the Go tests set (internal/xotool), so a
/// broken inliner cannot pass the tests as a slow one
/// (gotchas/arm64-inline-verify-fallback.md). XO_INLINE_BREAK=1 breaks
/// the inlined module on purpose (internal/arm64 TestInlineFallbackLoud).
fn inline_or_say(os: Os, var mi: ssa.Module, jobs: Int) -> Bool {
  let deny = os.env.get("XO_INLINE_DENY") ?? ""
  if !deny.is_empty() {
    mi.inline_deny = deny.split(",")
  }
  mi.passes_off = passes_off(os)
  let errs = arm64.inline_check(mi, jobs, (os.env.get("XO_INLINE_BREAK") ?? "") == "1")
  if errs.is_empty() {
    return true
  }
  let msg = "the inlined arm64 module does not verify (${errs.len()} errors; the first: ${errs[0]})"
  if (os.env.get("XO_INLINE_STRICT") ?? "") == "1" {
    fail(os, "${msg}; failing the build (XO_INLINE_STRICT=1)")
  }
  os.stdio.eprintln("xo: warning: ${msg}, so it is built without inlining (slower; XO_INLINE_STRICT=1 makes this an error)")
  false
}

/// The checker's path of the std module `xo test --std-module` names
/// (check.Checker.std_test): `native/...` as given, `std/NAME` for a
/// plain NAME; "" for none.
fn std_test_path(m: Str) -> Str {
  if m.is_empty() || m.starts_with("native/") || m.starts_with("std/") {
    return m
  }
  "std/${m}"
}
