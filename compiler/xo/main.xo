// xo1: the self hosted compiler driver of the switch-over experiment
// (decision 0158): the lexer, parser, checker, SSA builder and its
// passes, and the arm64 emitter, all in Xo, then the system C compiler
// driver to assemble and link with the C runtime (std/llrt), as
// internal/build does for `xo build --backend=arm64` (decision 0174).
//
//   xo1 build [flags] [dir ...]          the directories are one program
//   xo1 run [flags] [dir] [--] [args]    build, then run it with args
//   xo1 test [flags] [dir ...]           build the tests and run them
//   xo1 asm [flags] [dir ...]            print the assembly or LLVM IR
//   xo1 keys [--std=DIR] [--cc=CC]       the cache keys, to compare
//
// The flags are `xo build|run|test`'s with Go's flag rules (opts.xo):
// --backend=arm64|llvm|go|wasm (the default is go as in cmd/xo; arm64
// with --no-gc and for asm),
// --targets, -o, --json, --release, --error-args, --no-mono,
// --no-arenas, --no-gc, --holes, --race, --tzdata, --seed, --explore,
// --record, --run, --cases, -v, --real, --offline, --workspace; and
// xo1's own: --std=DIR --wd=DIR --cc=CC --asm=PATH --go-tree=DIR
// --phase-times (the wall clock of each phase on standard error as
// `phase NAME MS ms` lines).
//
// A build writes to the Go driver's build directory (buildDir, under
// <user cache>/xo/build or $XO_BUILD_DIR) and links the binary there
// (bin/NAME) unless -o names one, printing `os/arch: path` (or the JSON
// result with --json); a check that fails prints its diagnostics as `xo`
// does (diag.xo) and exits 1. With XO_BIN_CACHE the link is looked up in
// and added to the binary cache under the Go driver's key (cache.xo).
//
// --backend=llvm (decision 0178) lowers the same SSA module with the
// LLVM emitter in Xo (compiler/llvm) and compiles the IR with clang
// ($XO_CLANG, else clang; --cc names another) and the C runtime, as
// internal/build buildLLVM does, split into XO_LLVM_SPLIT modules when
// that is set (split.xo, decision 0168); asm prints the IR.
//
// --as=macho (decision 0182): assemble with compiler/macho, cc links;
// --ld=macho: assemble and link with compiler/macho, no cc (ld.xo); with
// --target=linux/arm64 an ELF executable for glibc, from any host; a
// macho build does not use the binary cache.
//
// --backend=go (decision 0167) checks and generates Go with compiler/gen
// and builds it with the Go toolchain (gobackend.xo); the build tree
// (generated packages, runtime, build information) is the build
// directory, or --go-tree.
//
// The runtime sources are read from DIR/llrt (DIR the std directory,
// default std). A link takes the runtime from a prebuilt pack or the
// runtime object cache, the zone data of std/time, and the C inputs of
// `use c`, keyed as internal/build keys them, so both drivers share the
// caches. A target other than the host gets its assembly only, as
// internal/build does. It is not the released `xo` (decision 0150: that
// is the owner's decision after the fixed point).

use std/crypto
use std/debug
use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/macho
use github.com/xo-lang/xo/compiler/ssa
use github.com/xo-lang/xo/compiler/arm64
use github.com/xo-lang/xo/compiler/llvm
use github.com/xo-lang/xo/compiler/tzsel
use github.com/xo-lang/xo/compiler/cli/core
use github.com/xo-lang/xo/compiler/cli/modules
use github.com/xo-lang/xo/compiler/cli/semantic
use github.com/xo-lang/xo/compiler/cli/bind
use github.com/xo-lang/xo/compiler/cli/servers
use github.com/xo-lang/xo/compiler/cli/cmdhelp
use github.com/xo-lang/xo/compiler/cli/bench
use github.com/xo-lang/xo/compiler/hostpath

fn main(os0: Os) ! {
  // the path variables given as C:\x on Windows, as the path flags are
  // (opts.xo path_env)
  let os = path_env(os0)
  match target.os {
    Wasi => wasi_gate(os, os.env.args())
    Linux | Darwin | Windows => {}
  }
  // decision 0349's default (owner, 2026-10-22): three quarters of
  // physical memory, at least 16 GiB (18 GiB on a 24 GB Mac), counting
  // the bytes the heap hands out; a self build of xo peaks at 9.9 GB cold
  // and 11.2 GB warm, the LLVM build at 7.8 GB. XO_MAX_MEM sets another
  // (read by the runtime at start), 0 or off none; no default where the
  // physical memory is not read (Windows)
  if os.env.get("XO_MAX_MEM") == None {
    let total = debug.mem_total()
    if total > 0 {
      let floor = 16 * 1073741824
      let b = total / 4 * 3
      debug.mem_budget(if b > floor { b } else { floor })
    }
  }
  debug.mem_label("checking (the first phase)")
  let fr = front(os, os.env.args())
  if fr.code >= 0 {
    // help, or a usage error found before any command runs (opts.xo)
    os.proc.exit(fr.code)
  }
  let args = fr.args
  if !args.is_empty() && !(args[0] is "version" | "--version" | "help") {
    stale_std_note(os, args)
  }
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  if !args.is_empty() && modules.is_command(args[0]) { os.proc.exit(modules.run(os, os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? "", args)) }
  if !args.is_empty() && args[0] == "bind" { os.proc.exit(bind.run_std(os, args, check.std_dir(os.env, os.fs))) }
  if let Some(code) = servers.forward_cli(os, args) {
    // a running `xo serve` answered check or query
    os.proc.exit(code)
  }
  if !args.is_empty() && args[0] is "query" | "edit" {
    os.proc.exit(semantic.run(os, args))
  }
  // agents' lookups (decision 0261): xo def, refs, type, symbols, doc NAME
  if servers.is_agent_command(os, args) {
    os.proc.exit(servers.run_agent(os, args[0], args[1..]))
  }
  if !args.is_empty() && servers.is_command(args[0]) {
    os.proc.exit(servers.run(os, args[0], args[1..], servers.XO_VERSION))
  }
  if let Some(code) = version_cmd(os, args) {
    // the build stamps (decision 0264)
    os.proc.exit(code)
  }
  if vet_cost_cmd(args) {
    // the cost notes need the compiled program (decision 0327)
    os.proc.exit(core.run_extra(os, args, vet_cost(os, args)))
  }
  if core.is_command(args) {
    let (cd, cid) = check_cache(os, args)
    // `xo check --support`: the SSA builder through the front end cache,
    // as plain_support builds it (no target, the profiler kept)
    os.proc.exit(core.run_cached(os, args, [], cd, cid, fn(c: check.Checker) -> List[check.Diag] uses clock, env, fs, proc, rand, stdio {
      let bb = fe_cached_build(os, c, ".", false, false, false, "", "", false, false, true, false, false, false, false, [])
      if bb.why.is_empty() { ssa.nogc_diags(bb) } else { [] }
    }))
  }
  if !args.is_empty() && args[0] == "prof" {
    // a native program's raw profile as pprof and text (prof.xo,
    // decision 0245)
    os.proc.exit(prof_cmd(os, args[1..]))
  }
  if !args.is_empty() && args[0] == "trace" {
    // the execution trace's JSON and summary (trace.xo, decision 0240)
    os.proc.exit(trace_cmd(os, args[1..]))
  }
  if !args.is_empty() && args[0] == "bench" {
    // interleaved A/B measurement (compiler/cli/bench, decision 0340)
    if args.len() == 2 && cmdhelp.is_help_flag(args[1]) {
      os.stdio.println(cmdhelp.usage("bench"))
      os.proc.exit(0)
    }
    os.proc.exit(bench.run(os, bench.Host{goos: host_os(os)}, args[1..]))
  }
  if !args.is_empty() && args[0] == "clean" {
    // remove xo's caches (clean.xo)
    os.proc.exit(clean_cmd(os, args[1..]))
  }
  if !args.is_empty() && args[0] == "dev" {
    // hidden: the developer commands (dev.xo, decision 0209)
    os.proc.exit(dev_cmd(os, args[1..]))
  }
  if args.is_empty() || !(args[0] is "build" | "run" | "asm" | "keys" | "test") {
    os.stdio.eprint("xo: unknown command ${(if args.is_empty() { "" } else { args[0] }).quote()}\n\n${cmdhelp.top()}")
    os.proc.exit(2)
  }
  var o = parse_args(os, args)
  if o.cmd == "build" && !o.profile.is_empty() && (os.env.get("XO_PROF_SELF") ?? "").is_empty() {
    // `xo build --profile=cpu|heap`: a profile of the compiler itself, as
    // xo-build.cpu.pprof (and .heap.pprof) with their .txt in the working
    // directory (owner, 2026-10-21). The profiler is armed when a process
    // starts, so xo runs itself again with XO_PROF set; XO_PROF_SELF keeps
    // that run from doing the same (it drops XO_PROF from its own
    // environment once armed).
    os.proc.exit(profile_self(os, o, args))
  }
  // the tests `xo test --watch` selected (decision 0267)
  for name in (os.env.get("XO_TEST_ONLY") ?? "").split("\n") {
    if !name.is_empty() {
      o.topts.only.push(name)
    }
  }
  if o.watch {
    // decision 0267: build and run (or test), watch, rebuild, restart
    // when the program changed (run only the tests a change reaches)
    if o.cmd == "run" {
      os.proc.exit(watch_run(os, o, args))
    }
    if o.cmd == "test" {
      os.proc.exit(watch_test(os, o, args))
    }
    os.stdio.eprintln("xo ${o.cmd}: --watch is a flag of xo run and xo test")
    os.proc.exit(2)
  }
  let goos = host_os(os)
  var ctx = Ctx{goos: goos, std: o.std, xo: dir_name(o.std.trim_suffix("/")), cache: user_cache_dir(os, goos), tools: Some(Mutex[Map[Str, Str]].new({})), std_trees: Some(Mutex[Map[Str, Str]].new({}))}
  ctx.phases = o.phases
  ctx.bin_cache = bin_cache_dir(os, ctx, o.cmd == "test")
  if o.cmd is "build" | "run" | "test" {
    // the hidden stages of the final outputs, removed on a SIGINT or
    // SIGTERM during the build (ld.xo Stage, watch_stages)
    let stages = Chan[Str].new(cap: 256)
    let done = Chan[()].new(cap: 1)
    ctx.tmp_tag = os.rand.bytes(4).to_hex()
    ctx.stages = Some(stages)
    ctx.build_done = Some(done)
    watch_stages(os, stages, done)
  }
  if o.cmd == "keys" {
    keys(os, ctx, o.cc)?
    return
  }
  let what = if o.cmd == "asm" { "build" } else { o.cmd }
  // cmd/xo's checks of the flags, before anything is built
  // decision 0354: every setting of the release preset is allowed in any
  // build (--error-args=false needed --release before)
  // the default backend is the native one (decisions 0248 and 0270):
  // arm64 or amd64 by the targets' architecture, else the host's
  // (native_backend); asm prints the arm64 assembly. The flags only the
  // Go backend has (--hybrid, xo run --record) choose it (xo run --seed,
  // xo test --seed and --explore run natively, decision 0350); --holes builds natively too (2026-10-22). --race takes the native backend where a
  // ThreadSanitizer runtime ships for the target, else llvm
  // (race_backend, decision 0273 addendum).
  var backend = o.backend
  if backend.is_empty() {
    let go_only = o.hybrid || (o.cmd == "run" && !o.record.is_empty())
    if o.cmd == "asm" {
      backend = "arm64"
    } else if go_only {
      backend = "go"
    } else if o.race {
      backend = race_backend(os, ctx, o)
    } else {
      backend = native_backend(o)
    }
  }
  if !o.trace.is_empty() && backend == "go" {
    os.stdio.eprintln("xo ${what}: --trace needs a native backend (arm64, amd64, or llvm); a Go backend program traces with runtime/trace")
    os.proc.exit(2)
  }
  if !o.profile.is_empty() && backend == "go" {
    os.stdio.eprintln("xo ${what}: --profile needs a native backend (arm64, amd64, or llvm); a Go backend program profiles with runtime/pprof")
    os.proc.exit(2)
  }
  // --opt (decision 0354): the LLVM backend's levels; the native
  // backends have none
  if !o.opt.is_empty() && (backend is "arm64" | "amd64") {
    os.stdio.eprintln("xo ${what}: --opt=${o.opt}: the ${backend} backend has no optimization levels (--opt is for --backend=llvm)")
    os.proc.exit(2)
  }
  if !o.opt.is_empty() && backend == "go" {
    os.stdio.eprintln("xo ${what}: note: --opt=${o.opt} is for --backend=llvm; the Go backend builds as go build does")
  }
  if o.hybrid {
    if backend != "go" {
      os.stdio.eprintln("xo build: --hybrid needs the Go backend")
      os.proc.exit(2)
    }
  }
  if o.no_gc && backend == "go" {
    os.stdio.eprintln("xo ${what}: --no-gc needs a native backend (arm64, amd64, or llvm), not go")
    os.proc.exit(1)
  }
  if o.cmd == "build" && (o.ci || o.release) {
    // cmd/xo runBuild: a release (or --ci) build fails while a workspace
    // overrides a required module, then --ci fails on an unformatted
    // file or a dbg left in code (compiler/cli/core ci.xo)
    let cx = core_ctx(os, o)
    let code = core.release_check(os, cx, o.dirs, o.json, if o.release { "--release" } else { "--ci" })
    if code != 0 {
      os.proc.exit(code)
    }
    if o.ci {
      let code2 = core.ci_check(os, cx, o.dirs, o.json)
      if code2 != 0 {
        os.proc.exit(code2)
      }
    }
  }
  if o.hybrid {
    // decision 0084's Go assembler mode of the arm64 backend
    // (internal/arm64 goasm.go) is not in compiler/arm64, so the build is
    // a plain Go build: deprecated (owner, 2026-10-22; removed later),
    // with a warning on every use, --json too (on standard error)
    os.stdio.eprintln("xo: --hybrid is deprecated and will be removed: it is a plain Go backend build (no assembly since the Go compiler's removal, decision 0215); use --backend=go, or the native backend, the default")
  }
  if backend == "go" && !o.std_module.is_empty() {
    fail(os, "--std-module needs a native backend (arm64, amd64, or llvm): the Go backend's std is std/rt, in Go")
  }
  if backend == "go" && (o.cmd == "build" || o.cmd == "test" || o.cmd == "run") {
    build_go(os, ctx, o)?
    return
  }
  if !(backend is "arm64" | "amd64" | "llvm") && !(backend == "wasm" && o.cmd == "build") {
    fail(os, "--backend=${backend}: want arm64, amd64, llvm, or go for build, run, and test, or wasm for build")
  }
  if !(o.assembler is "" | "cc" | "macho") {
    fail(os, "--as=${o.assembler}: want cc or macho")
  }
  if !(o.linker is "" | "cc" | "macho") {
    fail(os, "--ld=${o.linker}: want cc or macho")
  }
  // the arm64 backend's --race (decision 0273 parts 2 and 3): its
  // ThreadSanitizer calls, linked by Xo's linker with the runtime
  // race_runtime finds; amd64's on darwin, Linux and Windows (Go's
  // race_windows_amd64.syso)
  if o.race && !(backend is "llvm" | "arm64" | "amd64") {
    fail(os, "the ${backend} backend does not support --race: use --backend=llvm (ThreadSanitizer) or --backend=go (Go's race detector)")
  }
  if o.holes && backend == "wasm" {
    fail(os, "the wasm backend does not support --holes")
  }
  // a run cache hit kept for XO_BACKEND_CACHE=verify (decision 0360)
  var verify_hit: RunHit? = None
  if o.cmd == "test" {
    if o.out.is_empty() && (backend is "arm64" | "amd64" | "llvm") {
      // the run cache (testcache.xo): an unchanged program's binary and
      // tests without a build; a std module's tests too (--std-module is
      // on the key's command line and the entry hashes the whole std
      // tree, its _test.xo included; they were left out when the flag
      // came, and a warm `xo test --std-module=native/path` checked and
      // built again, 0.55 to 0.83 s against Go's 0.07 to 0.4, 2026-10-21)
      let t0 = os.clock.now()
      o.run_start = t0.unix_millis()
      o.run_key = run_key(os, ctx, o, args, backend)
      let found = run_fetch(os, ctx, o.run_key)
      if verifying(os) {
        // XO_BACKEND_CACHE=verify: build anyway, compare after
        verify_hit = found
      } else if let Some(hit) = found {
        lap(os, o.phases, "run_cache", t0)
        // the build's warnings, as it printed them (decision 0360)
        replay_output(os, hit.output)
        var hto = o.topts
        hto.target = test_target(o)
        let code = run_tests(os, hit.bin, hit.tests, hto)
        prof_tests(os, o.topts)
        os.fs.remove(hit.bin).ignore_err("a prune removes it later")
        os.proc.exit(code)
      }
      lap(os, o.phases, "run_cache_miss", t0)
    }
  }
  if o.cmd == "build" && o.backend.is_empty() && !o.race {
    // with no --backend, each target with its own native backend
    // (arm64, amd64 and wasm); --targets=all is then the targets one
    // builds, without windows/arm64 (owner, 2026-10-22, decision 0270
    // addendum; --backend=go --targets=all keeps all seven)
    var ts = parse_targets(os, o.targets, "${ctx.goos}/${host_arch()}")
    if o.targets == "all" {
      ts = ts.filter(fn(t) { !target_backend(t).is_empty() })
      os.stdio.eprintln("xo build: --targets=all builds the targets a native backend builds; windows/arm64 needs --backend=go")
    }
    let groups = backend_groups(ts)
    if groups.len() > 1 || (groups.len() == 1 && groups[0].0.is_empty()) {
      build_by_backend(os, ctx, o, groups)
      return
    }
  }
  if o.cmd == "build" || (o.cmd == "run" && o.out.is_empty()) {
    // the run cache for a build or run (decision 0360 stage 1,
    // on by default, XO_WHOLE_BUILD=off): an unchanged program's binary, copied to the
    // output or run, with what its build printed
    // (not `xo run -o PATH`, as not `xo test -o`: a run's entry keeps no
    // outputs, so a hit wrote nothing to PATH, 2026-10-30)
    let t0 = os.clock.now()
    o.run_start = t0.unix_millis()
    o.run_key = whole_key(os, ctx, o, args, backend)
    if !o.run_key.is_empty() {
      ctx.run_cache = whole_cache_dir(os, ctx)
      var wc = ctx
      wc.bin_cache = ctx.run_cache
      let found = run_fetch(os, wc, o.run_key)
      if verifying(os) {
        verify_hit = found
      } else if let Some(hit) = found {
        lap(os, o.phases, "run_cache", t0)
        if o.cmd == "run" {
          replay_output(os, hit.output)
          let code = run_built(os, o, hit.bin)
          os.fs.remove(hit.bin).ignore_err("a prune removes it later")
          os.proc.exit(code)
        }
        let ok = whole_build_hit(os, hit)
        os.fs.remove(hit.bin).ignore_err("a prune removes it later")
        if ok {
          return
        }
      }
      lap(os, o.phases, "run_cache_miss", t0)
    }
  }
  // what a build stored in the run cache prints goes through a tee, for
  // the entry (decision 0360)
  var bos = os
  if !o.run_key.is_empty() {
    let tee = new_tee(os.stdio)
    ctx.tee = Some(tee)
    // and its Fs and Env recording what it reads, the entry's inputs
    // (decision 0360 stage 2)
    let rec = Mutex[Rec].new(Rec{})
    ctx.rec = Some(rec)
    bos = rec_os(tee_os(os, tee), rec, o.wd, rec_skip(os, ctx))
  }
  if cache_stats_on(os) {
    let st = Mutex[CStats].new(CStats{})
    ctx.cstats = Some(st)
    bos = stats_os(bos, ctx, st)
  }
  // separate compilation by default where it applies (decision 0388
  // stage 3, step d)
  let whole_os = bos
  bos = sepcomp_default(bos, ctx, o, backend)
  var nb = build_native(bos, ctx, o, backend)
  if nb.whole {
    // a program that uses C links with cc, which cannot read std's store:
    // the default's build is the whole program's instead
    if !sepcomp_facts_path(whole_os).is_empty() {
      fail(os, "XO_SEPCOMP: a program that uses C (`use c`) is linked by cc, which cannot read std's store; build it with XO_SEPCOMP=0")
    }
    nb = build_native(whole_os, ctx, o, backend)
  }
  if let Some(st) = ctx.cstats {
    os.stdio.eprint(cache_stats_text(st))
  }
  if let Some(h) = verify_hit {
    verify_entry(os, h, nb.bin, kept_output(ctx))
  }
  if o.cmd == "test" {
    var to = o.topts
    to.profile_dir = o.wd
    to.std = o.std
    to.target = test_target(o)
    let code = run_tests(os, nb.bin, nb.tests, to)
    prof_tests(os, to)
    if !o.trace.is_empty() {
      // a raw trace per test process (decision 0240)
      os.stdio.eprintln("xo test: execution traces in ${trace_path(to).replace("%p", "<pid>")}; read one with `xo trace FILE`")
    }
    os.proc.exit(code)
  }
  if o.cmd == "run" {
    if !o.record.is_empty() {
      os.stdio.eprintln("xo run: --record needs the Go backend")
      os.proc.exit(2)
    }
    os.proc.exit(run_built(os, o, nb.bin))
  }
}

/// Runs a built program for `xo run`: its arguments, --profile's and
/// --trace's files and conversions, --seed; the program's exit code.
fn run_built(os: Os, o: Opts, bin: Str) -> Int {
  // --profile: the raw profile beside the binary, then xo-cpu.pprof and
  // xo-heap.pprof (and their .txt) in the working directory (prof.xo,
  // decision 0245)
  let raw = "${bin}.prof.xoraw"
  var pe = if o.profile.is_empty() { [] } else { ["XO_PROF=${o.profile}", "XO_PROF_OUT=${raw}", "XO_PROF_QUIET=1"] }
  if !o.profile.is_empty() {
    os.fs.remove(raw).ignore_err("not there")
  }
  if !o.trace.is_empty() {
    // --trace (decision 0240): the raw file, then its JSON and summary
    pe.push("XO_TRACE=${o.trace}")
  }
  if o.topts.seed != 0 {
    // the deterministic scheduler's seed (decision 0350, det.xo)
    pe.push("XO_SEED=${o.topts.seed}")
  }
  let code = exec_binary(os, bin, o.prog_args, pe)
  if !o.profile.is_empty() {
    // xo:allow XO0903 a path it cannot stat is not a file argument
    if os.fs.exists(raw).ok() ?? false {
      match prof_convert(os, raw, "xo-cpu.pprof", "xo-heap.pprof", false, false) {
        Ok(_) => {}
        Err(e) => os.stdio.eprintln("xo run: ${e}")
      }
    }
    os.fs.remove(raw).ignore_err("not there")
  }
  if !o.trace.is_empty() {
    let _t = trace_convert(os, o.trace, o.trace + ".json", false)
  }
  code
}

/// What a native build made: the host binary ("" for asm or another
/// target only) and the tests of a test binary.
struct Native {
  bin: Str = ""
  /// The binaries built, (target, path).
  bins: List[(Str, Str)] = []
  tests: List[TestInfo] = []
  /// The checker's std parses, for the next build of the process
  /// (`xo dev build-each`, decision 0209).
  pc: Map[Str, check.ParseEntry] = {}
  /// Why the targets were skipped (Opts.skip_unsupported), "" when built.
  skipped: Str = ""
  /// Nothing built: the program uses C, which separate compilation
  /// cannot link (decision 0388), so it is to be built whole.
  whole: Bool = false
}

/// The native backend that builds target tg ("" for none): arm64 for
/// darwin/arm64 and linux/arm64, amd64 for linux, darwin and windows
/// amd64 (decision 0254), wasm for wasip1/wasm.
fn target_backend(tg: Str) -> Str {
  match tg {
    "darwin/arm64" | "linux/arm64" => "arm64"
    "linux/amd64" | "darwin/amd64" | "windows/amd64" => "amd64"
    "wasip1/wasm" => "wasm"
    _ => ""
  }
}

/// targets by the native backend that builds them, in the order of each
/// backend's first target; "" collects the targets none builds.
fn backend_groups(targets: List[Str]) -> List[(Str, List[Str])] {
  var gs: List[(Str, List[Str])] = []
  for tg in targets {
    let b = target_backend(tg)
    var found = false
    for (i, g) in gs.indexed() {
      if g.0 == b {
        var ts = g.1
        ts.push(tg)
        gs[i] = (b, ts)
        found = true
      }
    }
    if !found {
      gs.push((b, [tg]))
    }
  }
  gs
}

/// A build whose targets need several native backends (--targets=all
/// with no --backend; 0.25.2 failed with "the arm64 backend builds for
/// darwin/arm64 and linux/arm64, not linux/amd64"): each backend's
/// targets as one build_native, then one report of every binary; a
/// target no native backend builds (windows/arm64, when named:
/// --targets=all leaves it out) is an error naming --backend=go, after
/// the others are built.
fn build_by_backend(os: Os, ctx: Ctx, o: Opts, groups: List[(Str, List[Str])]) {
  var bins: List[(Str, Str)] = []
  var none: List[Str] = []
  var skipped: List[(List[Str], Str)] = []
  for (b, ts) in groups {
    if b.is_empty() {
      none = none + ts
      continue
    }
    var og = o
    og.targets = ts.join(",")
    og.many_targets = true
    og.part_of_many = true
    // --targets=all skips a target the program cannot support (the
    // owner's call on the 0.26.0 field report: a network program and
    // WASI's missing sockets), with a note; a named target still fails
    og.skip_unsupported = o.targets == "all"
    let nb = build_native(os, ctx, og, b)
    if !nb.skipped.is_empty() {
      skipped.push((ts, nb.skipped))
      continue
    }
    bins = bins + nb.bins
  }
  for (ts, why) in skipped {
    os.stdio.eprintln("xo build: skipped ${ts.join(", ")}: ${why} (--targets=all builds the targets the program supports)")
  }
  if o.json {
    os.stdio.print(build_json(none.is_empty(), bins, []))
  } else {
    for (tg, p) in bins.sort_by(fn(x) { x.0 }) {
      os.stdio.println("${tg}: ${p}")
    }
  }
  if !none.is_empty() {
    os.stdio.eprintln("xo build: no native backend builds ${none.join(", ")}: build it with --backend=go (the other targets are built)")
    os.proc.exit(1)
  }
}

/// The targets of --targets (internal/build ParseTargets): the host when
/// none is named, `all`, or a comma separated list of os/arch.
fn parse_targets(os: Os, s: Str, host: Str) -> List[Str] {
  if s.is_empty() {
    return [host]
  }
  if s == "all" {
    return ["linux/amd64", "linux/arm64", "darwin/amd64", "darwin/arm64", "windows/amd64", "windows/arm64", "wasip1/wasm"]
  }
  var out: List[Str] = []
  for p0 in s.split(",") {
    let p = p0.trim()
    let parts = p.split("/")
    if parts.len() != 2 || parts[0].is_empty() || parts[1].is_empty() {
      os.stdio.eprintln("xo build: bad target ${p.quote()}: want os/arch")
      os.proc.exit(2)
    }
    let tos = if parts[0] == "wasi" { "wasip1" } else { parts[0] }
    let arch = if parts[1] == "wasm32" { "wasm" } else { parts[1] }
    out.push("${tos}/${arch}")
  }
  out
}

/// The context of the compiler/cli/core checks (--ci, --release) for the
/// command line o: its std, working directory, and module flags.
fn core_ctx(os: Os, o: Opts) -> core.Ctx {
  var offline = os.env.get("XO_OFFLINE") ?? ""
  if o.offline == "1" {
    offline = "1"
  } else if o.offline == "0" {
    offline = ""
  }
  var work = os.env.get("XO_WORK") ?? ""
  if o.workspace == "off" {
    work = "off"
  } else if o.workspace == "on" {
    work = ""
  }
  core.Ctx{std: o.std, wd: o.wd, offline: offline, work: work}
}

/// The names in $XO_LLRT_C (comma separated; `all` selects every C
/// path). A name with no std/native/llrt/<name>_c.xo fails the build:
/// decision 0198 deleted most C paths, and a deleted name that was
/// ignored built the Xo path while claiming to test the C one
/// (knowledgebase/gotchas/deleted-llrt-switch-still-set.md).
fn llrt_c_names(os: Os, std: Str) -> List[Str] {
  var names: List[Str] = []
  for n0 in (os.env.get("XO_LLRT_C") ?? "").split(",") {
    let n = n0.trim()
    if n.is_empty() {
      continue
    }
    if n != "all" && os.fs.read("${std}/native/llrt/${n}_c.xo").is_err() {
      fail(os, "XO_LLRT_C=${n}: no C path named ${n} (std/native/llrt/${n}_c.xo); the C paths left are the std/native/llrt/*_c.xo files, decision 0198 deleted the others")
    }
    names.push(n)
  }
  names
}

/// The checker of a build: the native implementation modules when
/// native, the module environment, and the check of dirs; a check that
/// fails prints its diagnostics (or, with --json on build, the JSON
/// result) and exits 1. Warnings are printed and the build goes on.
fn check_program(os: Os, o: Opts, native: Bool) -> check.Checker {
  let (c, _) = check_program_ov(os, o, native, {})
  c
}

/// check_program with the files of ov (absolute path to source) in the
/// checker's overlay: the generated contract fuzz tests (decision 0250).
/// Their diagnostics are returned, never printed or kept in c.diags; with
/// an overlay the user's own are not printed again (the first check did).
fn check_program_ov(os: Os, o: Opts, native: Bool, ov: Map[Str, Bytes]) -> (check.Checker, List[check.Diag]) {
  var c = check.new_checker(os.fs, o.std)
  c.overlay = ov
  c.parse_cache = o.parse_cache
  c.native = native
  // a native build checks the runtime's bodies as it builds them
  // (decision 0247); XO_CHECK_EAGER=1 checks them all first, as before
  c.lazy = native && (os.env.get("XO_CHECK_EAGER") ?? "") != "1"
  // decision 0388 stage 1b's prototype: std's every non generic function
  // built, as std's object will be
  c.std_roots = (os.env.get("XO_STD_ROOTS") ?? "") == "1" || !std_obj_dir(os).is_empty()
  if c.std_roots {
    // every body is built, so every body is checked first
    c.lazy = false
  }
  // the native modules' function bodies parsed lazily too (decision 0351
  // stage 2): xo build and run only, opt in while it is measured
  // on by default (owner, 2026-10-23); XO_LAZY_PARSE=off parses every body
  c.lazy_parse = (o.cmd == "build" || o.cmd == "run") && (os.env.get("XO_LAZY_PARSE") ?? "") != "off" && !c.std_roots
  // decision 0291 (the switch, owner 2026-10-21): Map and Set are the
  // hybrid (the lists until written while shared twice, then the log);
  // XO_MAP_LOG=0 builds the lists alone (wasm too, since its hybrid's
  // checks were fixed, 2026-10-21); the hybrid branches (decision 0291
  // branching addendum, the default since the owner's 2026-10-22 rule:
  // HTTP CRUD xo bench --ab showed no loss) except on wasm, and
  // XO_MAP_LOG=1 builds the hybrid without branching
  c.map_log = (os.env.get("XO_MAP_LOG") ?? "") != "0"
  c.map_core = pass_on(os, "map_core")
  c.map_branch = (os.env.get("XO_MAP_LOG") ?? "") != "1"
  // the SSA builder's lowerings $XO_LOWER turns off (miscompile triage)
  let (lower_off, lower_err) = ssa.parse_lowerings(os.env.get("XO_LOWER") ?? "")
  if !lower_err.is_empty() {
    fail(os, lower_err)
  }
  c.lower_off = lower_off
  // loops without preemption polls (decision 0286 step 3's opt out)
  c.no_preempt = o.no_preempt || (os.env.get("XO_PREEMPT_POLLS") ?? "") == "off"
  // `xo run --seed=N` and `xo build --seed=N` (decision 0350): the
  // deterministic scheduler; a built program takes its seed from XO_SEED
  // (default 1)
  c.det = (o.cmd == "run" || o.cmd == "build") && o.topts.seed != 0
  // the settings --release presets, as given (decision 0354): the SSA
  // builder resolves them against the build's release mode
  c.set_debug_contracts = o.debug_contracts
  c.set_dbg = o.dbg
  c.set_error_args = o.error_args
  c.set_trace = o.trace_support
  // dwline.built(): the DWARF readers are in a program that has DWARF
  // (xo asm prints assembly and keeps them)
  // the native and LLVM backends; the Go backend's lists are Go slices (packed
  // already) and wasm keeps its own
  c.pack_lists = o.pack_lists && (o.backend.is_empty() || o.backend == "arm64" || o.backend == "amd64" || o.backend == "llvm")
  // the prototype is arm64's only (decision 0370)
  c.inline_str = o.inline_str && (o.backend == "arm64" || (o.backend.is_empty() && host_arch() == "arm64"))
  if o.inline_str && !c.inline_str && (o.cmd is "build" | "run" | "test") {
    // accepted, but nothing to do: say so (Intel tester, 0.32.0)
    os.stdio.eprintln("xo: warning: --inline-str has no effect here: it is the native arm64 backend's only (decision 0370)")
  }
  c.dwarf = o.cmd == "asm" || (!o.strip && debug_info_eff(o, o.release && o.cmd != "test") != "off")
  // --race: the builder declares a windows program's race exports
  // (native/llrt/cabi_race)
  c.race = o.race
  // decision 0318: SIGURG's preemption instead of loop polls
  c.async_preempt_ok = (o.backend is "arm64" | "amd64" | "llvm") && !o.race && (os.env.get("XO_ASYNC_PREEMPT") ?? "") != "0"
  c.async_preempt_llvm = o.backend == "llvm"
  // the C paths of ported runtime modules (decisions 0193, 0206)
  c.llrt_c = llrt_c_names(os, o.std)
  c.std_test = std_test_path(o.std_module)
  // decision 0348: a build reads no _test.xo file
  c.skip_tests = o.cmd == "build" || o.cmd == "run"
  // the build target's parse list (parse_prefetch, parse_list_store):
  // the files its last check parsed, parsed on tasks before this check,
  // for test builds too (2026-10-21: an `xo test` parsed std serially,
  // 0.14 s of a warm 0.5 s test build)
  var pdir = ""
  if native && ov.is_empty() && (o.cmd == "build" || o.cmd == "run" || o.cmd == "test") && (os.env.get("XO_FE_CACHE") ?? "") != "off" && backend_cache_mode(os) != "off" {
    let host = host_os(os)
    pdir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  }
  // the module check cache (decision 0220 addendum stage 2): a program
  // module unchanged since its last full check is not checked again; for
  // the builds only (a test build checks its tests' modules in full)
  if native && ov.is_empty() && (o.cmd == "build" || o.cmd == "run") && (os.env.get("XO_FE_CACHE") ?? "") != "off" && backend_cache_mode(os) != "off" {
    let host = host_os(os)
    let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
    let id = if dir.is_empty() { "" } else { cache_id(os) }
    if !id.is_empty() {
      c.mod_cache_dir = dir
      c.mod_verify = backend_cache_mode(os) == "verify"
      c.mod_flags = "${id}\nstd=${o.std} lazy=${c.lazy} llrt_c=${c.llrt_c.join(",")} std_test=${c.std_test}"
      // XO_CHK_CACHE=auto (one target): a skipped module is one whose
      // every body the front end cache replays, so the whole-program
      // passes see them (a body checked lazily after them built wrong
      // under XO_CHK_CACHE=1, 2026-10-19); scripts/gate.sh runs
      // TestModuleCheckAuto* for every compiler/check and compiler/ssa
      // change. =1 skips every unchanged module
      // auto is the default (owner, 2026-10-23, after the closure owner
      // and thunk replay fixes; it was the default for a night on
      // 2026-10-22 and reverted when xml_derive failed); XO_CHK_CACHE=off
      // turns it off
      let cc0 = os.env.get("XO_CHK_CACHE") ?? ""
      let cc = if cc0.is_empty() { "auto" } else { cc0 }
      // not under XO_ASSUME_BREAK=1 (decision 0342's test knob): a
      // skipped module's bodies come from the cache, so the call it breaks
      // may not be there and the check sees nothing to report
      c.mod_skip_on = (cc == "1" || (cc == "auto" && !o.many_targets)) && (os.env.get("XO_ASSUME_BREAK") ?? "") != "1"
      // auto: only modules whose every body the front end cache replays,
      // with a fallback (build_native) when one is built from source
      // anyway (gotchas/module-check-cache-skips-whole-program-passes.md)
      c.mod_skip_auto = cc == "auto"
      for p in o.chk_noskip {
        c.mod_noskip[p] = true
      }
      // std's declarations from their records (decision 0388 stage
      // 1a-ii): one entry per xo, std and flags, its fingerprint naming
      // the std files it was declared from. On by default for a build or
      // run that compiles separately (stage 2, 2026-10-28: the edit's
      // check 33 to 18 ms on fib); XO_STD_EXPORT=0 turns it off, 1 forces
      // it, verify compares
      let sx0 = os.env.get("XO_STD_EXPORT") ?? ""
      let sx = if sx0.is_empty() && !sepcomp_facts_path(os).is_empty() && (o.cmd is "build" | "run") { "1" } else { sx0 }
      if sx == "1" || sx == "verify" {
        c.std_export_on = true
        c.std_export_verify = sx == "verify"
        // one entry per std tree too (stage 2 piece 2): agents' worktrees
        // share one user cache, and one entry per flags would fail each
        // other's stamps and be rewritten every build
        // xo:allow XO0903 the working directory from $PWD when getcwd fails
        let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
        let std_abs = if check.is_rooted(o.std) { o.std } else { "${wd}/${o.std}" }
        c.std_export_key = crypto.sha256("stdx\n${c.mod_flags}\nnative=${c.native} skip_tests=${c.skip_tests}\nstd=${std_abs}".bytes()).to_hex()
        c.std_export_in = entry_get(os, dir, "stdx", c.std_export_key) ?? b""
        c.std_now_ms = os.clock.now().unix_millis()
        // the entry's header: when its stamps of std's files and
        // directories hold, its fingerprint is std's without a read
        if !c.std_export_verify {
          var why = "no entry"
          if let Some((h, _)) = check.decode_std_header(c.std_export_in) {
            why = "header failed"
            if check.header_holds(os.fs, h) {
              c.std_header_fp = h.fp
              why = "header held, no record"
              // piece 1: std's modules from the record's closure, no std
              // file read or parsed until a tree is needed
              if let Some(e) = check.decode_std_record(c.std_export_in, h.fp) {
                c.load_std_record(e)
                c.std_record = Some(e)
                why = "record loaded (${e.closure.len()} modules)"
              }
            }
          }
          if (os.env.get("XO_CACHE_STATS") ?? "") == "1" {
            os.stdio.eprintln("cache stdx ${why}")
          }
        }
      }
    }
  }
  // decision 0388 stage 3 (opt in): std's functions as externs, from
  // std's facts (stdf, std's object builder's)
  let sp = sepcomp_facts_path(os)
  if !sp.is_empty() {
    // stage 2 pieces 3 and 4: std's trees joined only where needed (its
    // SSA lowers no std body); a build or run only: xo doc, def, refs,
    // the LSP and test read declarations in full
    c.trees_lazy = o.cmd is "build" | "run"
    c.trees_test_pend = c.trees_lazy && (os.env.get("XO_STD_TREES_TEST") ?? "") == "1"
    let (f0, f1) = sepcomp_fact_files(os, sp)
    match os.fs.read(f0) {
      Ok(d) => {
        c.sepcomp_facts = d
      }
      Err(e) => fail(os, "XO_SEPCOMP_FACTS: ${f0}: ${e}")
    }
    if !f1.is_empty() {
      match os.fs.read(f1) {
        Ok(d) => {
          c.sepcomp_facts_conc = d
        }
        Err(e) => fail(os, "XO_SEPCOMP_FACTS: ${f1}: ${e}")
      }
    }
  }
  if !pdir.is_empty() {
    parse_prefetch(os, c, pdir)
  }
  var offline = os.env.get("XO_OFFLINE") ?? ""
  if o.offline == "1" {
    offline = "1"
  } else if o.offline == "0" {
    offline = ""
  }
  var work = os.env.get("XO_WORK") ?? ""
  if o.workspace == "off" {
    work = "off"
  } else if o.workspace == "on" {
    work = ""
  }
  c.set_mod_env(o.wd, os.env.get("XO_MODCACHE") ?? "", os.env.get("HOME") ?? "", os.env.get("XDG_CACHE_HOME") ?? "", offline, work)
  c.cbind_dir = os.env.get("XO_CBIND_DIR") ?? ""
  c.gobind_dir = os.env.get("XO_GOBIND_DIR") ?? ""
  c.walk = o.walk
  // binds a `use go` or `use c` missing from the cache first, as the
  // Go checker does (decision 0178 stage 6)
  // and fetches a module version missing from the module cache
  match c.check_dirs_fetching(os, o.dirs, fn(p: Str, v: Str) -> Str ! check.Problem { modules.fetch(os, o.wd, p, v) }) {
    Ok(_) => {}
    Err(e) => fail(os, "check: ${e}")
  }
  if !pdir.is_empty() {
    parse_list_store(os, c, pdir)
  }
  if o.phases {
    cache_note(os, true, "parse", c.parse_hits, c.parse_hits + c.parse_misses.len())
    if (os.env.get("XO_PARSE_STATS") ?? "") == "1" {
      for p in c.parse_misses {
        os.stdio.eprintln("parse miss ${p}")
      }
    }
  }
  if !c.unsupported.is_empty() {
    fail_unsupported(os, "unsupported: ${c.unsupported}")
  }
  // the generated tests' diagnostics apart from the user's
  var gen_ds: List[check.Diag] = []
  if !ov.is_empty() {
    var user: List[check.Diag] = []
    for d in c.diags {
      if is_fuzz_path(d.file) {
        gen_ds.push(d)
      } else {
        user.push(d)
      }
    }
    c.diags = user
  }
  var ds = c.diags
  var bad = blocks(ds, o.holes)
  if !bad && o.cmd != "test" {
    // the stamped constants (applyStamps), after a check that passed
    let sd = apply_stamps(c, o.stamps)
    if !sd.is_empty() {
      ds = ds + sd
      bad = true
    }
  }
  if bad {
    if o.json && o.cmd == "build" {
      os.stdio.print(build_json(false, [], ds))
    } else {
      print_diags(os, in_scope(os, o, ds))
    }
    os.proc.exit(1)
  }
  if !(o.json && o.cmd == "build") && ov.is_empty() {
    print_diags(os, in_scope(os, o, c.diags))
  }
  (c, gen_ds)
}

/// The diagnostics to print: every error, and the warnings of files in
/// the directories the command names (a build of compiler/xo does not
/// print compiler/ssa's warnings, though they are one module; `xo vet`
/// and `xo check` on that directory do). XO_WARNINGS=all prints them
/// all; the warnings left out are counted on one line.
fn in_scope(os: Os, o: Opts, ds: List[check.Diag]) -> List[check.Diag] {
  if (os.env.get("XO_WARNINGS") ?? "") == "all" {
    return ds
  }
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  let abs = fn(p: Str) -> Str { if is_abs_path(p) { p } else { "${wd}/${p}".replace("/./", "/") } }
  var roots: List[Str] = []
  for d in o.dirs {
    // "." and "./x" too: the root ends in "/", so abs's "/./" cleanup
    // sees it (`xo build .` counted its own warnings as outside, 0.25.2)
    roots.push(abs("${d.trim_suffix("/...").trim_suffix("/")}/"))
  }
  if roots.is_empty() {
    roots.push("${wd}/")
  }
  var out: List[check.Diag] = []
  var left = 0
  for d in ds {
    var shown = !d.warning || d.file.is_empty()
    let f = abs(d.file)
    for r in roots {
      // a file of the directory, or of one below it (a DIR/... walk,
      // decision 0345; a plain DIR loads no file below it)
      shown = shown || f.starts_with(r) || "${f}/" == r
    }
    if shown {
      out.push(d)
    } else {
      left += 1
    }
  }
  if left > 0 {
    os.stdio.eprintln("xo: ${left} warning${if left == 1 { "" } else { "s" }} in files outside the directories built (XO_WARNINGS=all prints them)")
  }
  out
}

/// The default native backend (decision 0270): arm64 or amd64 for the
/// architecture --targets names (the last one, so a mix fails on the
/// backend's own target check), else for the host's; llvm on a host
/// with neither (a wasm build of xo).
/// The backend --race builds with when none is given (decision 0273
/// addendum, owner 2026-10-22): the native one where a ThreadSanitizer
/// runtime ships for the target (race_runtime: lib/xo/race/), else llvm,
/// whose ThreadSanitizer comes with clang.
fn race_backend(os: Os, ctx: Ctx, o: Opts) -> Str {
  let b = native_backend(o)
  if b == "llvm" {
    return b
  }
  var tg = ctx.goos
  if !o.targets.is_empty() && o.targets != "all" {
    let parts = o.targets.split(",")[0].trim().split("/")
    if parts.len() == 2 {
      tg = parts[0]
    }
  }
  let (rt, _) = race_runtime(os, ctx, tg, b)
  if rt.is_empty() { "llvm" } else { b }
}

fn native_backend(o: Opts) -> Str {
  var arch = host_arch()
  if !o.targets.is_empty() && o.targets != "all" {
    for p in o.targets.split(",") {
      let parts = p.trim().split("/")
      if parts.len() == 2 && (parts[1] is "arm64" | "amd64" | "wasm" | "wasm32") {
        arch = if parts[1] == "wasm32" { "wasm" } else { parts[1] }
      }
    }
  }
  // wasip1/wasm alone: the wasm backend (it took the host's, and
  // --targets=wasip1/wasm failed naming the arm64 backend)
  if arch is "arm64" | "amd64" | "wasm" { arch } else { "llvm" }
}

/// A native build (arm64, amd64 or llvm, or wasm): check, SSA, passes,
/// code, then the link of the host target into the build directory or -o.
fn build_native(os: Os, ctx: Ctx, o0: Opts, backend: Str) -> Native {
  // the backend chosen (lower, nolibc and the link read o.backend), and
  // whether it was the default, for the errors that name it
  var o = o0
  if o.backend.is_empty() {
    o.backend_auto = true
    o.backend = backend
  }
  let phases = o.phases
  let goos = ctx.goos
  // LLVM builds for the host; the arm64 backend for arm64 (on an amd64
  // host its default is still the arm64 code of the host's OS)
  // amd64: Xo's own x86_64 backend (decision 0254), linux/amd64 only
  let march = if backend == "amd64" { "amd64" } else { "arm64" }
  let host = if backend == "llvm" { "${goos}/${host_arch()}" } else { "${goos}/${march}" }
  let targets = parse_targets(os, o.targets, host)
  o.many_targets = o.many_targets || targets.len() > 1
  // the LLVM backend: the host, or one other target clang cross
  // compiles for with the host's SDK (llvm_cross_triple: windows/arm64 on
  // windows/amd64, decision 0197), or Windows from any host given a
  // Windows sysroot (XO_WINSYSROOT)
  var ltarget = host
  var cross: List[Str] = []
  let winsysroot = os.env.get("XO_WINSYSROOT") ?? ""
  for tg in targets {
    if backend == "arm64" && !(tg is "darwin/arm64" | "linux/arm64") {
      fail(os, "the arm64 backend builds for darwin/arm64 and linux/arm64, not ${tg}")
    }
    if backend == "amd64" && !(tg is "linux/amd64" | "darwin/amd64" | "windows/amd64") {
      fail(os, "the amd64 backend builds for linux/amd64, darwin/amd64, and windows/amd64, not ${tg} (decision 0254)")
    }
    if backend == "llvm" && tg != host {
      let sysroot = if tg.starts_with("linux/") { os.env.get("XO_LINUXSYSROOT") ?? "" } else { winsysroot }
      let triple = llvm_cross_triple(host, tg, sysroot)
      if triple.is_empty() || targets.len() > 1 {
        let hint = if tg.starts_with("windows/") { " (set XO_WINSYSROOT to a Windows sysroot to cross build for Windows)" } else { "" }
        fail(os, "the LLVM backend builds for the host (${host}) only, not ${tg}${hint}")
      }
      ltarget = tg
      cross = llvm_cross_flags(host, triple, sysroot)
    }
  }
  // the link's context: its target OS (a cross build's)
  var lctx = ctx
  lctx.tgoos = ltarget.split("/")[0]
  let tests = o.cmd == "test"
  let release = o.release && !tests
  var t = os.clock.now()
  var c = check_program(os, o, true)
  var fz = FuzzSet{}
  if o.cmd == "test" {
    // contract fuzzing as generated property tests (decision 0250)
    let (c2, f2) = fuzz_check(os, o, c)
    c = c2
    fz = f2
    // --seed, --explore, or a test's `seed N` (decision 0350 stage 2):
    // the tests run on the deterministic scheduler
    c.det = o.topts.seed != 0 || o.explore > 0 || tests_seeded(c)
  }
  t = lap(os, phases, "check", t)
  // a module that uses C links with cc, which cannot read std's store
  // (decision 0388): the caller builds the whole program
  if !sepcomp_facts_path(os).is_empty() && c.mods.any(fn(m) { !m.c_prefix.is_empty() }) {
    return Native{whole: true}
  }
  if o.backend_auto {
    // a program with `use go` builds only with the Go backend: say so,
    // rather than the native build's errors on each Go use (decision 0248)
    for m in c.mods {
      if !m.go_path.is_empty() {
        os.stdio.eprintln("xo ${o.cmd}: this program uses the Go package \"${m.go_path}\" (`use go`), which needs the Go backend: add --backend=go (the default backend is native, decision 0248)")
        os.proc.exit(2)
      }
    }
  }
  var uses_time = false
  for m in c.mods {
    uses_time = uses_time || m.path == "native/time"
  }
  let root = line_root(os, o.wd, o.dirs[0])
  // the predeclared `target` of each target (internal/build's
  // ssa.Options GOOS, GOARCH): one SSA per target OS, as the Go driver
  // builds one per target; the first target's here, another OS's in the
  // arm64 loop below
  var tgoos = ""
  var tgoarch = ""
  if backend is "arm64" | "amd64" | "llvm" {
    tgoos = targets[0].split("/")[0]
    tgoarch = if backend == "llvm" { ltarget.split("/")[1] } else { march }
  } else if backend == "wasm" {
    // the architecture of a WASI module: std/native/llrt/sysio.xo's
    // Linux system calls are not for it (decision 0206); `target.os`
    // stays the host's (gotchas/wasm-target-os-is-the-host.md)
    tgoarch = "wasm"
  }
  // decision 0352: lower lets the checker go once the SSA is built, in a
  // native build for one target OS that is not a test (2026-10-26: also
  // under the module check cache's auto mode, the default since 2026-10-23,
  // whose retry reads only link_view's skip fields; strip was off for it, so
  // a default build kept the trees: 325 MB against 278 MB peak RSS)
  var one_os = true
  for tg in targets {
    one_os = one_os && tg.split("/")[0] == targets[0].split("/")[0]
  }
  let strip = (backend is "arm64" | "amd64") && one_os && !tests && (os.env.get("XO_KEEP_FRONT") ?? "") != "1"
  // the build information's source hashes, before lower lets the
  // checker go (decision 0354 stage 2)
  if !tests {
    o.binfo_sources = binfo_sources(c, root, o.wd)
    // the layout file (decision 0403): --layout=FILE, else the module
    // root's xo.layout when it is there; a source of the build, so its
    // hash is among the sources (the build id follows it)
    if o.layout != "off" {
      let lp = if o.layout.is_empty() { "${root}/xo.layout" } else { o.layout }
      match os.fs.read(lp) {
        Ok(b) => {
          o.layout_text = b.to_str() ?? ""
          o.binfo_sources["xo.layout"] = crypto.sha256(b).to_hex()
          // the file's functions as symbols, hot first, for the link
          // (stage 1b); a bad file is reported where the order is made
          if let Ok(l) = parse_layout(o.layout_text) {
            var names: List[Str] = []
            for (n, _) in l.fns {
              names.push(n)
            }
            o.layout_syms = layout_order(names, l).map(fn(i) { "_${arm64.mangle_fn(names[i])}" })
          }
        }
        Err(e) => if !o.layout.is_empty() {
          fail(os, "--layout: ${lp}: ${e}")
        }
      }
    }
  }
  // the retry's note names the cross module effect reads, which lower's
  // link_view no longer has the effect tables to find (decision 0352)
  var effect_reads: List[Str] = []
  if c.mod_skip_auto && c.skip_unsafe && (o.phases || !(os.env.get("XO_CHK_CACHE") ?? "").is_empty()) {
    effect_reads = c.effect_reads_across_modules()
  }
  var lo = lower(os, o, c, strip, root, tests, release, uses_time, tgoos, tgoarch, backend == "wasm", backend is "arm64" | "amd64", t)
  if c.mod_skip_auto && (!lo.b.skip_src.is_empty() || c.skip_unsafe) {
    // XO_CHK_CACHE=auto skipped a module a body of which was built from
    // source after the whole-program passes (or the checked bodies read
    // a skipped module's inferred effects): that build is dropped, and
    // the program checked again with those modules (all skipped ones
    // when unsafe) checked in full; nothing of the dropped build was
    // stored in the front end cache (bcache.xo)
    var no: List[Str] = []
    for (m, _) in c.mod_skip {
      if c.skip_unsafe || lo.b.skip_src.contains(m) {
        no.push(c.mods[m].path)
      }
    }
    // a note for --phase-times or an explicit XO_CHK_CACHE only: since
    // auto is the default (2026-10-22) the fallback is ordinary (a
    // program built for another target first, whose bodies the front end
    // cache keys apart), and a warning on every such build was noise
    if o.phases || !(os.env.get("XO_CHK_CACHE") ?? "").is_empty() {
      os.stdio.eprintln("xo: note: the module check cache skipped ${no.len()} module(s) a body of which was built from source (${no.sort().join(", ")}${if c.skip_unsafe { "; effects read across modules: ${effect_reads.join(", ")}" } else { "" }}); checking them again")
    }
    o.chk_noskip = o.chk_noskip + no
    c = check_program(os, o, true)
    lo = lower(os, o, c, false, root, tests, release, uses_time, tgoos, tgoarch, backend == "wasm", backend is "arm64" | "amd64", t)
  }
  t = lo.t
  if !lo.skipped.is_empty() {
    return Native{skipped: lo.skipped}
  }
  var b = lo.b
  let tu = lo.tu
  if backend == "wasm" {
    // the zone data std/time reads (as the native link embeds it)
    // one of several targets: NAME-wasip1-wasm.wasm in -o's directory,
    // else the working directory, as bin_path names the others
    var wout = o.out
    if o.many_targets {
      let base = "${prog_name(o.wd, o.dirs)}-wasip1-wasm.wasm"
      if o.out.is_empty() {
        wout = abs_of(o.wd, base)
      } else {
        let od = abs_of(o.wd, o.out).trim_suffix("/")
        write_or_fail(os, od, "", b"")
        wout = "${od}/${base}"
      }
    }
    if debug_info_eff(o, release) == "split" {
      fail(os, "--debug-info=split is for the native and LLVM backends' linux and darwin programs, not wasip1/wasm (decision 0355)")
    }
    let why = build_wasm(os, ctx, b.m, wout, o.wd, o.dirs[0], tzsel.tz_select(os, ctx.std, tu, o.tzdata, "wasip1"), o.skip_unsupported)
    if !why.is_empty() {
      return Native{skipped: why}
    }
    return Native{bins: if wout.is_empty() { [] } else { [("wasip1/wasm", wout)] }, pc: c.parse_cache}
  }
  // the build directory (buildDir, then the backend's subdirectory)
  let mode = if tests { 1 } else { 0 }
  let variant = if release { "release" } else { "" }
  // --std-module names no directory: the module keeps two std modules'
  // test binaries apart (gotchas/std-module-test-binary-shared.md)
  let smod = if o.std_module.is_empty() { "" } else { "std-module=${o.std_module}" }
  let bdir = match build_dir(os, ctx, o.wd, o.dirs, mode, false, false, false, [variant, smod]) {
    Ok(d) => d
    Err(e) => fail(os, "${e}")
  }
  var cc = o.cc
  var name = prog_name(o.wd, o.dirs)
  if tests {
    name = "${name}.test"
  }
  var out = o.out
  if !out.is_empty() {
    out = abs_of(o.wd, out)
    if is_dir(os, out) {
      // -o DIR, an existing directory: DIR/NAME, as go build -o does
      out = "${out.trim_suffix("/")}/"
    }
  }
  if backend == "llvm" {
    if cc.is_empty() {
      cc = find_clang(os)
      if cc.is_empty() {
        if o.backend_auto && o.race {
          fail(os, "--race: no native ThreadSanitizer runtime ships for ${ltarget} (lib/xo/race/; ${race_targets()} have one), so it builds with the LLVM backend, which needs clang: install it or set XO_CLANG")
        }
        if o.backend_auto {
          // the default backend on this host (decision 0248)
          fail(os, "the LLVM backend (the default on this host) needs clang: install it (xcode-select --install on macOS, your distribution's clang package on Linux) or set XO_CLANG, or build with --backend=go")
        }
        fail(os, "the LLVM backend needs clang: install it or set XO_CLANG")
      }
    }
    let cmaj = clang_major(os, cc)
    if cmaj > 0 && cmaj < CLANG_MIN {
      print_diags(os, [check.Diag{code: "XO1505", file: "", line: 0, col: 0, end_line: 0, end_col: 0, message: "the LLVM backend needs clang ${CLANG_MIN} or later, but ${cc} is clang ${cmaj}: install a newer clang and set XO_CLANG, or build with a native backend (the default)"}])
      os.proc.exit(1)
    }
    // DWARF line tables (decision 0239), as for arm64 below
    var lm = b.m
    lm.debug_info = o.cmd != "asm" && !o.strip && debug_info_eff(o, release) != "off"
    // the line root (the sources' names are relative to it: ssa file_name)
    // is the compilation directory, not the working directory, which
    // differs for `xo build DIR` (lldb opened the working directory's
    // main.xo, 2026-10-22); std's directory is relative to the latter
    // xo:allow XO0903 the working directory from $PWD when getcwd fails
    let cwd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
    lm.comp_dir = abs_line_root(os, cwd, o.dirs[0])
    let lsd = dir_name(ctx.std.trim_suffix("/"))
    lm.std_root = if is_abs_path(lsd) { lsd } else { "${cwd}/${lsd}" }
    if trimpath_eff(o) {
      lm.comp_dir = rel_or_dot(cwd, lm.comp_dir)
      lm.std_root = rel_or_dot(cwd, lm.std_root)
    }
    // whole program dead function removal, as for the native backends
    // below: a function only a folded target arm called (sanhook's
    // ThreadSanitizer threads, which call pthread and mmap) is not
    // emitted, so a split module or an O0 build does not reference
    // symbols the target lacks (gotchas/windows-llvm-split-link.md)
    if o.cmd != "asm" && (os.env.get("XO_DCE") ?? "") != "off" {
      let _d = arm64.drop_unreached(lm)
      t = lap(os, phases, "dce", t)
    }
    var g = llvm.new_gen(lm)
    g.goarch = tgoarch
    g.goos = tgoos
    // --race (decision 0241): ThreadSanitizer over every function
    g.tsan = o.race
    g.tsan_runtime = o.race && (os.env.get("XO_TSAN_RUNTIME") ?? "") == "1"
    let ir = g.generate()
    t = lap(os, phases, "emit", t)
    if !g.err.is_empty() {
      fail(os, g.err)
    }
    if !g.skipped.is_empty() {
      fail_unsupported(os, "the LLVM emitter skipped ${g.skipped[0]}")
    }
    // with no C library, no libgcc: arm64 atomics call the outline helpers
    // the link writes (nolibc_atomics), which dispatch on xo_lse
    let attr_flags = if nolibc(os, o, c, lctx.tgoos) && tgoarch == "arm64" { cross + ["-moutline-atomics"] } else { cross }
    let code = with_target_attrs(ir, clang_target_attrs(os, cc, attr_flags))
    if o.cmd == "asm" {
      os.stdio.print(code)
      lap(os, phases, "print", t)
      return Native{pc: c.parse_cache}
    }
    var split = split_config(os)
    if !split.err.is_empty() {
      fail(os, split.err)
    }
    if !o.opt.is_empty() {
      // --opt (decision 0354): in any build, release included
      split.opt = "-${o.opt}"
      split.opt_set = true
    } else if release {
      split.opt = "-O2"
    } else if tests && !split.opt_set {
      // a test binary is built at -O0, so with no LTO (decision 0236:
      // examples/notes-service's link 38.7 s at -O2, 5.4 s at -O0)
      split.opt = "-O0"
      // and split into modules whose objects the back-end cache keeps
      // (XO_LLVM_TEST_SPLIT, 2026-10-21): an edit compiles only the
      // modules it changed (json's edit build: 1.9 s in clang for the
      // whole IR). By default a module per source file, at most 32
      // (`files`); a number N hashes files into N modules. Measured
      // (bench/results/llvm-test-split-2026-10-21.md): files edits 352
      // and 378 ms in clang against 610 and 477 for 8 (json, compiler/ssa),
      // cold 1982 and 1133 against 1129 and 886
      let ts0 = os.env.get("XO_LLVM_TEST_SPLIT") ?? ""
      let ts = if ts0.is_empty() { "files" } else { ts0 }
      let tn = if ts == "files" { 32 } else { Int.parse(ts) ?? 8 }
      let cdir = backend_cache_dir(os, ctx)
      if split.modules == 1 && ts != "off" && tn > 1 && !cdir.is_empty() && !o.race && ltarget == host {
        split.modules = tn
        split.lto = "none"
        split.stable = true
        split.by_file = ts == "files"
        split.objcache = cdir
      }
    }
    // a large program with no XO_LLVM_SPLIT is split by its IR's size
    // (default_modules), so no single clang takes the whole IR
    if !split.modules_set && !split.stable && split.modules == 1 {
      split.modules = default_modules(code.len())
      if phases && split.modules > 1 {
        os.stdio.eprintln("llvm: IR ${code.len() / 1000000} MB split into ${split.modules} modules (${split.jobs} clang jobs, ${split.lto} LTO)")
      }
    }
    // a test build's split (stable) is made after a miss of the binary
    // cache, which keys it on the whole IR: a warm build does not split
    let parts = if split.stable { [code] } else { split_ir(code, split.modules, false, false) }
    let multi = parts.len() > 1 || split.stable
    var dir = "${bdir}/llvm"
    if o.race {
      dir = "${dir}-race"
    }
    if ltarget != host {
      dir = "${dir}-${ltarget.replace("/", "-")}"
    }
    if multi {
      // a split build has its own directory (a single module build of
      // the same program may run at the same time)
      dir = "${dir}-split${if split.stable { split.modules } else { parts.len() }}${if split.by_file { "files" } else { "" }}-${split.lto}"
    }
    // the IR and the split modules live in a directory of this build alone
    // (a concurrent build of another program with the same split settings
    // wrote the same names into the shared one), removed after the link;
    // XO_KEEP_ASM=1 keeps the shared directory. A program built without -o
    // stays in sdir
    let sdir = dir
    let work_keep = (os.env.get("XO_KEEP_ASM") ?? "") == "1"
    if !work_keep {
      dir = "${dir}-w-${os.rand.bytes(6).to_hex()}"
    }
    write_or_fail(os, dir, "", b"")
    var lls: List[Str] = []
    for (i, part) in parts.indexed() {
      let ll = if parts.len() > 1 { "${dir}/prog.${i}.ll" } else { "${dir}/prog.ll" }
      write_or_fail(os, dir, ll, part.bytes())
      lls.push(ll)
    }
    if !o.asm_path.is_empty() {
      write_or_fail(os, dir, o.asm_path, code.bytes())
    }
    t = lap(os, phases, "write", t)
    let bin = bin_path(sdir, out, name, ltarget, o.many_targets)
    var lk = link_inputs(os, ctx, o, c, dir, code, uses_time, tu, false, lctx.tgoos, tgoarch, "llvm", "")
    lk.flags = cross + lk.flags
    var race_rt = ""
    if o.race {
      // without the instrumentation of function entry and exit: it gives
      // a function a cleanup pad that resumes the unwind, which the Xo
      // fault unwinder cannot resume (gotchas/tsan-func-exit-pads.md)
      lk.flags = lk.flags + ["-fsanitize=thread", "-mllvm", "-tsan-instrument-func-entry-exit=0"]
      // xo's own ThreadSanitizer runtime (lib/xo/race, the native
      // backends'), not clang's: Apple clang 17's stopped at SIGILL on an
      // Intel Mac (field report on 0.26.0), and a clang without
      // compiler-rt has none; clang's when xo has none (a checkout)
      if lctx.tgoos == "darwin" || lctx.tgoos == "linux" {
        let (rp, _) = race_runtime(os, ctx, lctx.tgoos, tgoarch)
        race_rt = rp
      }
      if !race_rt.is_empty() {
        lk.link_only = lk.link_only + race_link_flags(lctx.tgoos, race_rt)
      }
    }
    let lto1 = single_lto(split)
    lk.flags = lk.flags + unroll_flags(split.opt, lctx.tgoos, if multi { split.lto } else { lto1 })
    var mode_flags = ["llvm", split.opt]
    if multi {
      mode_flags = mode_flags + ["split", split.lto]
    } else {
      mode_flags = mode_flags + ["lto", lto1]
    }
    let srcs = lls + lk.srcs
    // the DWARF embedded after the link (cc_dsym, decision 0346 stage
    // 3): room in the header for its segment, and the bundle for --dsym
    let dsym = lm.debug_info && lctx.tgoos == "darwin" && ctx.goos == "darwin"
    // the same room with -s or --release too, so debug information
    // changes no code address (internal/arm64 TestDebugInfoSameCode)
    let pad = if lctx.tgoos == "darwin" && ctx.goos == "darwin" { [DWARF_HEADERPAD] } else { [] }
    if dsym {
      mode_flags.push("dwarf-embed")
    }
    if dsym && o.dsym {
      mode_flags.push("dsym")
    }
    // --debug-info=split (decision 0355): dsymutil's dSYM stays beside a
    // darwin program; clang's linux link has no split (Xo's ELF linker
    // does it)
    let lsplit = lm.debug_info && debug_info_eff(o, release) == "split"
    if lsplit && !dsym {
      fail(os, "--debug-info=split on ${ltarget} needs the native backend's linker; the LLVM backend links with clang (decision 0355)")
    }
    if lsplit {
      mode_flags.push("debug-info=split")
    }
    let key = native_bin_key(os, ctx, dir, cc, mode_flags + pad + lk.flags + lk.link_only, srcs)
    // built in a hidden stage beside bin, then moved into place (Stage)
    let st = stage(os, ctx, bin)
    let (hit, entry) = fetch_bin(os, ctx, key, st.bin)
    if !hit {
      let lto = if multi { split.lto } else { lto1 }
      // darwin's linker records each object's path (the LTO object in dir)
      // in the program: relative to the private directory, two builds of
      // one program are equal byte for byte (as build_native's cc link)
      let oso_prefix = if dsym && dir != sdir { "${dir}/" } else { "" }
      let opad: List[Str] = if oso_prefix.is_empty() { [] } else { ["-Wl,-oso_prefix,${oso_prefix}"] }
      let lflags = (if dsym { lk.flags + lto_object_flags(os, dir, lto) + opad } else { lk.flags }) + pad + lk.link_only
      let msg = if split.stable {
        // beside dir, not in it: the binary cache's key hashes every
        // file of dir, and the modules are made only after its miss
        let mdir = "${dir}-modules"
        write_or_fail(os, mdir, "", b"")
        var mls: List[Str] = []
        for (i, part) in split_ir(code, split.modules, true, split.by_file).indexed() {
          let ll = "${mdir}/prog.${i}.ll"
          write_or_fail(os, mdir, ll, part.bytes())
          mls.push(ll)
        }
        let m = split_build(os, lctx, cc, mls, lk.srcs, st.bin, split, lflags)
        cache_note(os, phases, "llvm modules", split.reused, mls.len())
        m
      } else if multi {
        split_build(os, lctx, cc, lls, lk.srcs, st.bin, split, lflags)
      } else {
        cc_build(os, lctx, cc, [split.opt] + single_lto_flags(lto1) + ["-Wno-override-module"] + lflags, srcs, st.bin)
      }
      if !msg.is_empty() {
        os.stdio.eprint(msg)
        fail_stage(os, st, "${cc} failed${ir_failure_sources(os, lm, msg)}")
      }
      if dsym {
        cc_dsym(os, st.bin, o.dsym, lsplit, oso_prefix)
      }
      store_bin(os, ctx, entry, st.bin)
    }
    // xo:allow XO0903 no bundle staged: an earlier one beside bin goes
    let staged = os.fs.exists("${st.bin}.dSYM").ok() ?? false
    let cerr = st.commit(os)
    if !cerr.is_empty() {
      fail(os, cerr)
    }
    if !staged {
      // an earlier --dsym build's bundle, for another UUID (decision 0346)
      os.fs.remove_all("${bin}.dSYM").ignore_err("none from an earlier build")
    }
    if !race_rt.is_empty() && lctx.tgoos == "darwin" {
      // loaded by @rpath, beside the executable first (a cached binary's
      // new directory too)
      let rerr = race_rt_beside(os, race_rt, bin)
      if !rerr.is_empty() {
        fail(os, rerr)
      }
    }
    if !work_keep {
      os.fs.remove_all(dir).ignore_err("only disk: the prune takes it after 30 minutes")
      os.fs.remove_all("${dir}-modules").ignore_err("only disk: the prune takes it after 30 minutes")
    }
    lap(os, phases, "cc", t)
    return finish(os, ctx, o, c, root, [(ltarget, bin)], tests, fz)
  }
  // arm64 (and amd64, the arm64 MIR retargeted): the assembly of each
  // target; the host's is linked
  let sdir = "${bdir}/${march}"
  write_or_fail(os, sdir, "", b"")
  // the files of this build (the assembly, the part objects, the zone and
  // build information objects) are in a directory of its own: builds of
  // one program share sdir, and one writing prog-darwin.1.o while another
  // linked it gave "not a 64 bit Mach-O file" (two concurrent builds,
  // 2026-10-24; builds with other flags would link mismatched parts). The
  // program of a build without -o stays in sdir. XO_KEEP_ASM=1 keeps the
  // files where they were, in sdir.
  let work_keep = (os.env.get("XO_KEEP_ASM") ?? "") == "1"
  let dir = if work_keep { sdir } else { "${sdir}/w-${os.rand.bytes(6).to_hex()}" }
  write_or_fail(os, dir, "", b"")
  // decision 0352: a build for one target OS reads only the modules, the
  // diagnostics and (xo dev's reuse) the parse cache of the checker from
  // here on; the rest, held by c, the builder and lo, goes before
  // inlining (a test build keeps it: test_infos and run_store read it)
  if one_os && !tests && (os.env.get("XO_KEEP_FRONT") ?? "") != "1" {
    c = c.link_view(o.reuse_parse)
    b.c = c
    lo.b = b
  }
  var cur = b
  var cur_tu = tu
  var cur_os = tgoos
  var cur_rk = lo.rc_keys
  var mi = cur.m
  // the DWARF readers have their full bodies (dwline.built() folded true):
  // the inliner then decides as a build without them does there
  // (arm64/inline.xo release_view, decision 0354)
  mi.reader_bodies = o.cmd != "asm" && !o.strip && debug_info_eff(o, release) != "off"
  t = check_assumptions(os, mi, phases, t)
  let later = defer_inline_verify(os, o, march, release)
  // the inline cache's hits left undecoded until read (decision 0283
  // stage B), where the per-function cache is used
  let lazy_inl = (march == "arm64" || march == "amd64") && !o.race && !release && o.cmd != "asm" && !passes_changed(os) && backend_cache_mode(os) != "verify" && (os.env.get("XO_LAZY_INLINE") ?? "") != "off" && (os.env.get("XO_INLINE_BREAK") ?? "").is_empty()
  let (inl0, pend0, fb0) = inline_or_defer(os, mi, emit_jobs(os), phases, cur_os, release, cur_rk, later, lazy_inl)
  var inl = inl0
  var pend = pend0
  // the first verification error of an inlined module built without
  // inlining (its build information records it; "" for none)
  var inl_fb = fb0
  t = lap(os, phases, "inline", t)
  var bins: List[(Str, Str)] = []
  for (ti, tg) in targets.indexed() {
    let tgoos = tg.split("/")[0]
    if tgoos != cur_os {
      // another OS: its own SSA, its `target` that OS's
      let l = lower(os, o, c, false, root, tests, release, uses_time, tgoos, march, false, true, t)
      cur = l.b
      cur_tu = l.tu
      cur_os = tgoos
      cur_rk = l.rc_keys
      mi = cur.m
      mi.reader_bodies = o.cmd != "asm" && !o.strip && debug_info_eff(o, release) != "off"
      let ta = check_assumptions(os, mi, phases, l.t)
      let (inl2, pend2, fb2) = inline_or_defer(os, mi, emit_jobs(os), phases, cur_os, release, cur_rk, later, lazy_inl)
      inl = inl2
      pend = pend2
      inl_fb = fb2
      t = lap(os, phases, "inline", ta)
    }
    // arm64.generate_module(cur.m, tgoos, false), timed
    let jobs = emit_jobs(os)
    // with the per-function cache (decision 0220 addendum stage B)
    let (gm0, t1) = gen_module(os, o, ctx, c, if inl { mi } else { cur.m }, tgoos, release, jobs, phases, t)
    var gm = gm0
    t = t1
    // the inlined module's verification, deferred to here
    // (defer_inline_verify): the cache's keys computed once
    var pre: List[Str] = []
    if inl && pend {
      if (os.env.get("XO_INLINE_BREAK") ?? "") == "late" {
        // the deferred verification's fallback, for its test
        let _b = arm64.break_inlined(gm)
      }
      let (errs, keys) = verify_after_dce(os, gm, tgoos, jobs)
      t = lap(os, phases, "inline.verify", t)
      if inline_verified(os, errs) {
        pre = keys
      } else {
        inl_fb = fallback_text(errs)
        let (gm1, t2) = gen_module(os, o, ctx, c, cur.m, tgoos, release, jobs, phases, t)
        gm = gm1
        t = t2
      }
    }
    // decision 0352: the module before inlining was the verification's
    // fallback and the inlined one gen_module's input; past here only gm
    // is read (another target OS lowers its own), so the last target lets
    // both go before code generation
    if ti == targets.len() - 1 && (os.env.get("XO_KEEP_FRONT") ?? "") != "1" && (os.env.get("XO_KEEP_MODS") ?? "") != "1" {
      cur.m = ssa.Module{}
      mi = ssa.Module{}
      b.m = ssa.Module{}
      lo.b.m = ssa.Module{}
    }
    // the per-function and part cache, for arm64 and amd64 (their keys
    // and target directories name the architecture, m.goarch; amd64 since
    // 2026-10-26), not with $XO_PASSES changed either way (+ or -: its keys
    // do not say so), nor for --race (its instrumented code has the same
    // keys); windows since 2026-10-27: an entry carries the thunks and
    // weak symbols its functions call through (fcache.xo put_w64; they
    // were missing on a hit, an undefined xo_w64_WaitOnAddress)
    let (fc0, fdir, fpk) = if passes_changed(os) || gm.race { (arm64.FnCache{}, "", Pack{}) } else { fn_cache_load(os, ctx, gm, tgoos, jobs, release, pre) }
    var fc = fc0
    if !fdir.is_empty() && !fc.verify {
      // decision 0418: each part's new entries go to a file in the
      // build's spill directory as the part finishes, read back by the
      // store; a directory of its own, which the binary cache keys skip
      // (key_tree): in dir itself a cold build's spills changed the
      // link's key from the warm build's, which makes none, so the
      // second build missed the binary cache (TestMachoBinCache,
      // 2026-10-30); emptied first so an earlier build's do not pile up
      let sd = "${dir}/${SPILL_DIR}"
      os.fs.remove_all(sd).ignore_err("none from an earlier build")
      if os.fs.create_dir_all(sd).is_ok() {
        fc.spill_dir = sd
        fc.fs = Some(os.fs)
      }
    }
    if !fdir.is_empty() {
      t = lap(os, phases, "fn_keys", t)
    }
    // what the link needs of the module after the generation, read now so
    // the module's last use is the call: the parts take its functions'
    // bodies with them (arm64/parallel.xo generate_cached) and a copy
    // held here would keep every body to the end of the build
    let gdw = (gm.debug_info, gm.comp_dir, gm.std_root)
    let gstd_obj = gm.std_obj
    let gsep = gm.sepcomp_program
    var p = arm64.generate_cached(gm, if march == "amd64" { "${tgoos}-amd64" } else { tgoos }, jobs, fc)
    t = lap(os, phases, "emit", t)
    if !fdir.is_empty() {
      // a build the run cache keys (a test's, or a build's or run's under
      // on by default): the unchanged builds after it are served
      // whole, so its first is the only one that can pack the parts
      fn_cache_store(os, fdir, fpk, fc, fn_src(p), part_src(p), !o.run_key.is_empty())
      cache_note(os, phases, "functions", p.reused, fc.keys.len())
      if !fc.part_keys.is_empty() {
        cache_note(os, phases, "parts", p.parts_reused, fc.part_keys.len())
      }
      if !p.part_mismatches.is_empty() {
        fail(os, "XO_BACKEND_CACHE=verify: ${p.part_mismatches.len()} parts differ from their cache entries, the first part ${p.part_mismatches[0]}")
      }
      if !p.mismatches.is_empty() {
        fail(os, "XO_BACKEND_CACHE=verify: ${p.mismatches.len()} functions differ from their cache entries, the first ${p.mismatches[0]}")
      }
      // the per-function and part cache's stores (they were counted in
      // the next lap: darwin's hollow, windows' write)
      t = lap(os, phases, "fn_store", t)
    }
    write_dumps(os, p.dumps)
    let want = os.env.get("XO_DUMP_FN") ?? ""
    if !want.is_empty() && !p.dumps.any(fn(d) { d.0 == want }) {
      os.stdio.eprintln("xo: XO_DUMP_FN=${want}: no function of that name reached the backend (inlined into every caller and removed, unused, or misspelled; XO_INLINE_REPORT=1 lists the functions)")
    }
    if !p.err.is_empty() {
      fail(os, p.err)
    }
    if !p.skipped.is_empty() {
      fail_unsupported(os, "the emitter skipped ${p.skipped[0]}")
    }
    // the functions nothing reaches emptied (arm64 hollow.xo): Mach-O
    // (darwin) and ELF (linux) text, arm64 and amd64 (x86's emptied
    // bodies are `ud2`; darwin/amd64 on since 2026-10-26, decision 0371),
    // a program whose link has no `use c` objects (they could call an
    // export by name), not `xo asm`; XO_PASSES=-hollow keeps them
    // decision 0388 stage 3: std's object, linked with the program's
    // (XO_SEPCOMP); its functions call the program's main, which a reach
    // over the program's parts alone cannot see, so no hollowing
    let (sep_objs, sep_key) = sepcomp_objs(os, b.conc)
    let hollow_now = (tgoos is "darwin" | "linux") && (march == "arm64" || march == "amd64") && o.cmd != "asm" && !c.mods.any(fn(m) { !m.c_prefix.is_empty() }) && pass_on(os, "hollow") && sepcomp_facts_path(os).is_empty()
    // decision 0388's std store: the parts split into atoms, which the
    // link strips by symbol (every object path below assembles these)
    // (windows/amd64's COFF too: pelink strips by atom, pestrip.xo)
    if ((os.env.get("XO_STD_ROOTS") ?? "") == "1" || !std_obj_dir(os).is_empty() || gsep) && (tgoos is "darwin" | "windows" | "linux") {
      p.parts = p.parts.map(fn(x) { "\t.subsections_via_symbols\n${x}" })
    }
    // a split darwin build through the back-end cache, part by part
    // (asmparts.xo incr_hollow): only the parts an edit changed are
    // scanned, hollowed and assembled; their texts hollowed later only if
    // a tool reads them (hollow_late)
    // (amd64 too: it has no per-function cache, fdir, but incr_hollow needs
    // only the back-end cache, which it checks)
    let inc = if (tgoos is "darwin" | "linux") && o.cmd != "asm" && o.asm_path.is_empty() && p.parts.len() > 1 && backend_cache_mode(os) != "verify" { incr_hollow(os, ctx, p.parts, march, hollow_now, tgoos == "linux", jobs) } else { None }
    var hollow_late = false
    if inc.is_some() {
      hollow_late = hollow_now
      t = lap(os, phases, "hollow", t)
    } else if hollow_now {
      if p.parts.len() > 1 {
        p.parts = hollow_parts(p.parts, march, tgoos == "linux")
      } else {
        p.asm = hollow_parts([p.asm], march, tgoos == "linux")[0]
      }
      t = lap(os, phases, "hollow", t)
    }
    // a symbol of the program that nothing defines (arm64 undef.xo): an
    // rt.* intrinsic no backend lowers, called directly, would stop the
    // link with no hint of the call
    if tgoos == "darwin" && o.cmd != "asm" && !gstd_obj {
      let und0 = match inc {
        Some(r) => r.undef
        None => arm64.undefined_xo(if p.parts.len() > 1 { p.parts } else { [p.asm] })
      }
      let und = sepcomp_undefined(os, und0, sep_objs, b.conc)
      if !und.is_empty() {
        let (sym, at) = und[0]
        let rt = if sym.starts_with("_xo_x_") { "" } else { " (the runtime call rt.${sym.trim_prefix("_xo_")}: no backend lowers it, so call it through its std wrapper)" }
        fail(os, "`${sym}` is named in `${at}` but no function of the program defines it${rt}${if und.len() > 1 { "; ${und.len() - 1} more" } else { "" }}")
      }
      t = lap(os, phases, "undef", t)
    }
    // the whole text: empty with parts (p.text() joins them where read)
    let code = p.asm
    if o.cmd == "asm" {
      os.stdio.print(p.text())
      lap(os, phases, "print", t)
      continue
    }
    // the program's assembly files in the build directory, only where
    // a tool reads them (cc or clang assembling, a cross build's
    // assembly) or XO_KEEP_ASM=1 keeps them: Xo's assemblers read the
    // texts in memory, and xo's were 1.1 GB, written again as its parts
    // (2.2 GB a build; 24.7 GB of the cache in 40 minutes, 2026-10-21)
    let keep_asm = (os.env.get("XO_KEEP_ASM") ?? "") == "1"
    if !o.asm_path.is_empty() {
      write_or_fail(os, dir, o.asm_path, dw_real(gdw, p.text()).bytes())
    }
    // --ld=macho links arm64 programs without cc, linux/arm64 ones from
    // any host (decision 0182); with no --ld, the host's darwin/arm64
    // link is macho's when the pack has its runtime and no `use c`
    // source is linked, else cc's, and a linux/arm64 program with no C
    // library links with the ELF linker from any host, a cross build too
    // (default_ld, decision 0243: as GOOS=linux go build)
    // the amd64 backend's darwin/amd64 program, on an arm64 Mac or any
    // other host (decision 0254 stage 6a): Xo's Mach-O x86_64 assembler and linker
    // as darwin/arm64's (--as=cc for Apple's cc, which then links too)
    let mac_x86 = march == "amd64" && tg == "darwin/amd64"
    var no_cc = o.linker == "macho"
    if o.linker.is_empty() && (tg == host || tgoos == "linux" || tgoos == "darwin") {
      no_cc = default_ld(os, ctx, o, c, tgoos, code, uses_time)
    }
    if o.race && tgoos == "windows" && !nolibc(os, o, c, tgoos) {
      fail(os, "--race on windows links with Xo's PE linker and no C runtime (decision 0273's Windows addendum): not with XO_WIN_NOCRT=0")
    }
    if o.race && !no_cc && tgoos != "windows" {
      fail(os, "--race on the ${march} backend links with Xo's linker (not --ld=cc, decision 0273): darwin and linux")
    }
    let macho_as = if mac_x86 { o.assembler != "cc" } else { o.assembler == "macho" || (no_cc && o.assembler.is_empty()) }
    let win = march == "amd64" && tgoos == "windows"
    let asm_only = !win && tg != host && !(no_cc && (tgoos == "linux" || tgoos == "darwin")) && !mac_x86
    // a build that stops at the assembly leaves it as its product, in the
    // build directory itself, where the message names it
    let s = if asm_only { "${sdir}/prog-${tgoos}.s" } else { "${dir}/prog-${tgoos}.s" }
    // cc (or clang, windows) reads the whole file when there are no parts
    let cc_reads = if win { o.assembler == "cc" } else { !macho_as }
    if hollow_late && (keep_asm || asm_only || !macho_as) {
      // texts a tool reads after all
      if let Some(r) = inc {
        p.parts = incr_texts(p.parts, r, march)
      }
      t = lap(os, phases, "hollow", t)
    }
    if keep_asm || asm_only || (cc_reads && p.parts.len() <= 1) {
      write_or_fail(os, dir, s, dw_real(gdw, p.text()).bytes())
    }
    t = lap(os, phases, "write", t)
    if march == "amd64" && tgoos == "windows" {
      // the amd64 backend's windows/amd64 program (decision 0254 6b):
      // clang's assembler and lld-link (win_amd64_link)
      let wbin = bin_path(sdir, out, name, tg, o.many_targets)
      var wsrcs = [s]
      // each object's key for its PDB part (pe_link, cvobj obj_pdb): the
      // part's cache key and what dw_slots_obj patches into it
      var wkeys: List[Str] = []
      if p.parts.len() > 1 {
        wsrcs = []
        for (i, part) in p.parts.indexed() {
          let ps = "${dir}/prog-${tgoos}.${i}.s"
          if keep_asm || o.assembler == "cc" {
            write_or_fail(os, dir, ps, dw_real(gdw, part).bytes())
          }
          wsrcs.push(ps)
        }
      }
      if o.assembler != "cc" {
        // Xo's COFF writer (compiler/macho coff.xo, decision 0254 6b
        // step 3), the objects llvm-mc writes; --as=cc for clang's
        // on parallel tasks through the back-end cache's objects, as the
        // Mach-O and ELF parts (an edit's other parts not assembled again;
        // the objects keyed and assembled with the slots' placeholders,
        // then their real paths patched in, as the Mach-O parts: replacing
        // them in every part's text first was about 74 ms of the HTTP
        // server's edit, 2026-10-27)
        let texts = if p.parts.len() > 1 { p.parts } else { [code] }
        let (assembled, nasm, _) = cached_macho_objects(os, ctx, texts, false, true, true, jobs)
        // the PDB's GUID (ld.xo pdb_seed) from each part's content, not
        // its back-end cache key: the key carries cache_id, whose separate
        // compilation component names the facts files one way for cache
        // entries and another for an explicit XO_SEPCOMP_FACTS directory,
        // so two builds of one program got two GUIDs (2026-10-29,
        // gotchas/output-from-cache-keys-differs-cache-off.md: nothing in
        // the output comes from a cache key); the same with the cache off
        // (internal/arm64 TestBackendCacheEditIdentity)
        if gdw.0 {
          for k in part_keys("xo pdb v2 part", [], texts, jobs) {
            wkeys.push(crypto.sha256("pdb v2 ${k} ${gdw.1} ${gdw.2}".bytes()).to_hex())
          }
        }
        // the cache's keys, reads and the changed parts' assembly, then
        // the objects' slots patched and written for the PE linker
        t = lap(os, phases, "assemble.objects", t)
        var objs: List[Str] = []
        for (i, r) in assembled.indexed() {
          let obj = if texts.len() > 1 { "${dir}/prog-${tgoos}.${i}.obj" } else { "${dir}/prog-${tgoos}.obj" }
          match r {
            Ok(b) => write_or_fail(os, dir, obj, if gdw.0 { arm64.dw_slots_obj(b, gdw.1, gdw.2) } else { b })
            Err(e) => fail(os, "assembler: ${e}")
          }
          objs.push(obj)
        }
        wsrcs = objs
        t = lap(os, phases, "assemble.write", t)
        cache_note(os, phases, "objects", texts.len() - nasm, texts.len())
        if gstd_obj {
          // std's object for windows/amd64: its parts and their indexed
          // store (coffstore.xo) in the directory, not linked
          let sod = std_obj_dir(os)
          write_std_obj_coff(os, sod, objs)
          os.stdio.eprintln("std object: ${objs.len()} parts and std.store in ${sod}")
          lap(os, phases, "std_obj", t)
          continue
        }
      }
      write_or_fail(os, dir_name(wbin), "", b"")
      if nolibc(os, o, c, tgoos) {
        // Xo's PE linker, no C runtime (decision 0254 6b step 4): the
        // objects, the zone data's, imports by the table
        var zsrcs: List[Str] = []
        // link's steps under --phase-times, as link.NAME (2026-10-23:
        // CI's windows builds spent 540 s in link, the rest normal)
        var tl = os.clock.now()
        // (separate compilation, decision 0388: std's object names the
        // zone table whether the program uses time or not)
        if uses_time || !sepcomp_facts_path(os).is_empty() {
          let sel = tzsel.tz_select(os, ctx.std, cur_tu, o.tzdata, tgoos)
          if !sel.err.is_empty() {
            fail(os, sel.err)
          }
          if !(o.json && o.cmd == "build") {
            for n in sel.notes {
              os.stdio.eprintln(n)
            }
          }
          match tz_object(os, dir, sel, tgoos, tgoarch) {
            Ok(p) => zsrcs.push(p)
            Err(e) => fail(os, "${e}")
          }
          tl = lap(os, phases, "link.tz", tl)
        }
        // the build information (decision 0354 stage 2)
        match binfo_object(os, dir, native_build_info(os, ctx, o, "amd64", "${tgoos}/${tgoarch}", inl_fb), tgoos, tgoarch, true) {
          Ok(p) => zsrcs.push(p)
          Err(e) => fail(os, "${e}")
        }
        tl = lap(os, phases, "link.binfo", tl)
        if o.race {
          // ThreadSanitizer's Go flavor object (decision 0273's Windows
          // addendum)
          let (rp, rwhy) = race_runtime(os, ctx, tgoos, march)
          if !rwhy.is_empty() {
            fail(os, rwhy)
          }
          zsrcs.push(rp)
          tl = lap(os, phases, "link.race_runtime", tl)
        }
        let wst = stage(os, ctx, wbin)
        tl = lap(os, phases, "link.stage", tl)
        let why = pe_link(os, wsrcs + zsrcs, wst.bin, wbin, o.stamps, o.race, phases, trimpath_eff(o), backend_cache_dir(os, ctx), wkeys, !o.strip && debug_info_eff(o, release) != "off")
        tl = lap(os, phases, "link.pe_link", tl)
        if !why.is_empty() {
          fail_stage(os, wst, why)
        }
        let werr = wst.commit(os)
        if !werr.is_empty() {
          fail(os, werr)
        }
        tl = lap(os, phases, "link.commit", tl)
        t = lap(os, phases, "link", t)
        bins.push((tg, wbin))
        continue
      }
      // the zone data (a C source clang compiles) and `use c`'s inputs
      let wlk = link_inputs(os, ctx, o, c, dir, code, uses_time, cur_tu, false, tgoos, march, march, inl_fb)
      let wst = stage(os, ctx, wbin)
      let why = win_amd64_link(os, wsrcs + wlk.srcs, wst.bin, wlk.flags + wlk.link_only)
      if !why.is_empty() {
        fail_stage(os, wst, why)
      }
      let werr = wst.commit(os)
      if !werr.is_empty() {
        fail(os, werr)
      }
      t = lap(os, phases, "link", t)
      bins.push((tg, wbin))
      continue
    }
    if tg != host && !(no_cc && (tgoos == "linux" || tgoos == "darwin")) && !mac_x86 {
      // another target that links with cc (a `use c` source, --ld=cc):
      // the host's cc does not link it, and the build stopped at its
      // assembly with exit 0 and no binary (Intel field report b04)
      let why = "${tg} links with a C compiler (a `use c` source, --ld=cc, or a ${tgoos} program from ${host}), and xo does not cross link with one: build it on ${tg} (its assembly: ${s})"
      if o.skip_unsupported {
        return Native{skipped: why}
      }
      if o.json {
        os.stdio.print(build_json(false, [], []))
      }
      fail(os, why)
    }
    if cc.is_empty() && !no_cc {
      cc = find_cc(os)
      if cc.is_empty() {
        fail(os, "the arm64 backend needs a C compiler to assemble and link: install one (macOS: xcode-select --install; Debian or Ubuntu: apt-get install gcc, or clang) or set XO_CC")
      }
    }
    let bin = bin_path(sdir, out, name, tg, o.many_targets)
    // std's object (decision 0388) reads the zone table whether or not
    // this program uses time: a separately compiled program always has one
    let lk = link_inputs(os, ctx, o, c, dir, code, uses_time || !sepcomp_facts_path(os).is_empty(), cur_tu, no_cc, tgoos, march, march, inl_fb)
    let flags = ["-O2"] + lk.flags
    // the program's assembly: one file, or the files of a parallel
    // generation, which assemble apart (arm64.generate_parallel)
    var progs = [s]
    // each object's cache key, for the link's (macho_bin_key)
    var obj_keys: Map[Str, Str] = {}
    if p.parts.len() > 1 {
      progs = []
      for (i, part) in p.parts.indexed() {
        let ps = "${dir}/prog-${tgoos}.${i}.s"
        if keep_asm || !macho_as {
          write_or_fail(os, dir, ps, dw_real(gdw, part).bytes())
        }
        progs.push(ps)
      }
    }
    if macho_as {
      // the objects from compiler/macho (decision 0182), on parallel
      // tasks for the parts
      let srcs = if p.parts.len() > 1 { p.parts } else { [code] }
      var objs: List[Str] = []
      var assembled: List[Result[Bytes, Str]] = []
      var nasm = 0
      var okeys: List[Str] = []
      match inc {
        Some(r) => {
          assembled = r.objs
          nasm = r.nasm
          okeys = r.okeys
        }
        None => {
          let (a, n, ok) = cached_macho_objects(os, ctx, srcs, tgoos == "linux", march == "amd64", false, jobs)
          assembled = a
          nasm = n
          okeys = ok
        }
      }
      for (i, r) in assembled.indexed() {
        let obj = if progs.len() > 1 { "${dir}/prog-${tgoos}.${i}.o" } else { "${dir}/prog-${tgoos}.o" }
        match r {
          // the real paths in its .debug_str slots (a cached object
          // names no worktree)
          Ok(b) => {
            write_or_fail(os, dir, obj, if gdw.0 { arm64.dw_slots_obj(b, gdw.1, gdw.2) } else { b })
            // the link's key names the object by its cache key and what
            // the slots took, not by hashing its bytes again (about 5 ms
            // of llvm-fib's edit, 2026-10-27)
            if i < okeys.len() && !okeys[i].is_empty() {
              obj_keys[obj.trim_prefix("${dir}/")] = "obj ${okeys[i]} dw=${gdw.0} ${gdw.1} ${gdw.2}"
            }
          }
          Err(e) => fail(os, "assembler: ${e}")
        }
        objs.push(obj)
      }
      progs = objs
      t = lap(os, phases, "assemble", t)
      cache_note(os, phases, "objects", srcs.len() - nasm, srcs.len())
      if gstd_obj {
        // std's object: its parts and their indexed store in the
        // directory, not linked (the program's main is not in them)
        let sod = std_obj_dir(os)
        write_std_obj(os, sod, objs, tgoos == "linux")
        os.stdio.eprintln("std object: ${objs.len()} parts and std.store in ${sod}")
        lap(os, phases, "std_obj", t)
        continue
      }
    }
    // through std's store (XO_SEPCOMP_STORE, macho_link) std's objects
    // are not inputs: they stay for the undefined symbol check only
    let srcs = progs + lk.srcs + (if sepcomp_store(os, b.conc).is_empty() { sep_objs } else { [] })
    if no_cc {
      let nl = nolibc(os, o, c, tgoos)
      var race_rt = ""
      if o.race {
        let (rp, rwhy) = race_runtime(os, ctx, tgoos, march)
        if !rwhy.is_empty() {
          fail(os, rwhy)
        }
        race_rt = rp
      }
      // --debug-info=split (decision 0355): the DWARF in PROG.debug
      // (linux) or PROG.dSYM (darwin) beside the program, not in it
      let split_dbg = gdw.0 && debug_info_eff(o, release) == "split"
      // the link's own steps under --phase-times (link.key, link.fetch,
      // the link's link.* steps, link.store_bin, link.commit), as windows'
      var tl = os.clock.now()
      let mkey = macho_bin_key(os, ctx, dir, tgoos, flags + (if split_dbg { ["debug-info=split"] } else { [] }) + (if sep_key.is_empty() { [] } else { [sep_key] }), srcs, o.strip, nl, race_rt, o.dsym, release, obj_keys)
      tl = lap(os, phases, "link.key", tl)
      let mst = stage(os, ctx, bin)
      let (mhit, mentry) = fetch_bin(os, ctx, mkey, mst.bin)
      tl = lap(os, phases, "link.fetch", tl)
      if !mhit {
        var lctx = ctx
        lctx.sep_store = sepcomp_store(os, b.conc)
        // decision 0403 stage 1b: the layout's symbol order for the store
        // link (read after lctx was made, so set here)
        lctx.layout_order = o.layout_syms
        let why = macho_link(os, lctx, tgoos, flags, srcs, mst.bin, o.strip, nl, race_rt, o.dsym, split_dbg, release)
        if !why.is_empty() {
          fail_stage(os, mst, why)
        }
        tl = os.clock.now()
        store_bin(os, ctx, mentry, mst.bin)
        tl = lap(os, phases, "link.store_bin", tl)
      }
      let merr = mst.commit(os)
      if !merr.is_empty() {
        fail(os, merr)
      }
      let _tc = lap(os, phases, "link.commit", tl)
      if !race_rt.is_empty() && tgoos == "darwin" {
        // a cached link skipped macho_link's copy: the runtime beside
        // this output too
        let rerr = race_rt_beside(os, race_rt, bin)
        if !rerr.is_empty() {
          fail(os, rerr)
        }
      }
      if !o.dsym && !split_dbg {
        // an earlier --dsym or split build's bundle, for another UUID
        // (decisions 0346, 0355), and a split build's PROG.debug
        os.fs.remove_all("${bin}.dSYM").ignore_err("none from an earlier build")
        if tgoos == "linux" {
          os.fs.remove("${bin}.debug").ignore_err("none from an earlier build")
        }
      }
      t = lap(os, phases, "link", t)
      bins.push((tg, bin))
      continue
    }
    let cdsym = gdw.0 && tgoos == "darwin"
    // --debug-info=split with cc: dsymutil's dSYM beside the program on
    // darwin; cc's linux link has no split (Xo's ELF linker does it)
    let csplit = gdw.0 && debug_info_eff(o, release) == "split"
    if csplit && tgoos != "darwin" {
      fail(os, "--debug-info=split on ${tg} needs Xo's ELF linker, and this program links with cc (a `use c` source or --ld=cc) (decision 0355)")
    }
    // the header room for the embedded DWARF in every darwin cc link,
    // -s too, so debug information changes no code address
    // (TestDebugInfoSameCode); the key tells the two apart
    let cpad: List[Str] = if tgoos == "darwin" { [DWARF_HEADERPAD] } else { [] }
    let pad = cpad + (if cdsym { ["dwarf-embed"] + (if o.dsym { ["dsym"] } else { [] }) } else { [] })
    let key = if macho_as { "" } else { native_bin_key(os, ctx, dir, cc, [march] + flags + pad + lk.link_only, srcs) }
    let cst = stage(os, ctx, bin)
    let (hit, entry) = fetch_bin(os, ctx, key, cst.bin)
    if !hit {
      var lsrcs = srcs
      if progs.len() > 1 && !macho_as {
        // the parts assembled by parallel cc processes, then linked
        let (objs, why, nasm) = cached_cc_assemble(os, ctx, cc, flags + memo_sysroot(os, ctx), progs, p.parts.map(fn(x) { dw_real(gdw, x) }), jobs)
        if !why.is_empty() {
          os.stdio.eprint(why)
          fail_stage(os, cst, "${cc} failed")
        }
        lsrcs = objs + lk.srcs
        t = lap(os, phases, "assemble", t)
        cache_note(os, phases, "objects", progs.len() - nasm, progs.len())
      }
      // darwin's linker records each object's path in the program (the debug
      // map, N_OSO): relative to the private directory, two builds of one
      // program are byte for byte equal (TestModuleCheckAuto)
      let oso_prefix = if tgoos == "darwin" && dir != sdir { "${dir}/" } else { "" }
      let opad: List[Str] = if oso_prefix.is_empty() { [] } else { ["-Wl,-oso_prefix,${oso_prefix}"] }
      let msg = cc_build(os, ctx, cc, flags + cpad + opad + lk.link_only, lsrcs, cst.bin)
      if !msg.is_empty() {
        os.stdio.eprint(msg)
        fail_stage(os, cst, "${cc} failed")
      }
      if cdsym {
        cc_dsym(os, cst.bin, o.dsym, csplit, oso_prefix)
      }
      store_bin(os, ctx, entry, cst.bin)
    }
    // xo:allow XO0903 no bundle staged: an earlier one beside bin goes
    let cstaged = os.fs.exists("${cst.bin}.dSYM").ok() ?? false
    let cerr = cst.commit(os)
    if !cerr.is_empty() {
      fail(os, cerr)
    }
    if !cstaged {
      // an earlier --dsym build's bundle, for another UUID (decision 0346)
      os.fs.remove_all("${bin}.dSYM").ignore_err("none from an earlier build")
    }
    if !keep_asm {
      // linked: cc's assembly files are not read again (the next build
      // writes them before it keys its link)
      for ps in progs {
        if ps.ends_with(".s") {
          os.fs.remove(ps).ignore_err("not there")
        }
      }
    }
    t = lap(os, phases, "cc", t)
    bins.push((tg, bin))
  }
  if dir != sdir {
    os.fs.remove_all(dir).ignore_err("only disk: the prune takes it after 30 minutes")
  }
  if !inl_fb.is_empty() {
    // the last line before the outputs (owner, 2026-10-24: the warning
    // at the inlining step scrolled past or was cut by `| tail -1`, and
    // a fallback build was measured as a slowdown)
    os.stdio.eprintln("xo: warning: built without inlining (${inl_fb}): slower than it should be; `xo version -m BINARY` shows it, XO_INLINE_STRICT=1 makes it an error")
  }
  if o.cmd == "asm" {
    return Native{pc: c.parse_cache}
  }
  finish(os, ctx, o, c, root, bins, tests, fz)
}

/// The tasks of the parallel stages of a build (ssa insert_rc_jobs,
/// The generated text t with the real paths in its .debug_str slots
/// (arm64.dw_slots_text), for every reader but compiler/macho's
/// assembler, whose objects are patched (arm64.dw_slots_obj).
fn dw_real(gm: (Bool, Str, Str), t: Str) -> Str {
  if gm.0 { arm64.dw_slots_text(t, gm.1, gm.2) } else { t }
}

/// arm64.generate_parallel, the parts' assembly): $XO_EMIT_JOBS, else
/// the physical cores, at most 16 and a third of the memory in GB. The
/// output does not depend on it.
fn emit_jobs(os: Os) -> Int {
  let j = Int.parse(os.env.get("XO_EMIT_JOBS") ?? "") ?? 0
  if j > 0 {
    return j
  }
  // the physical cores; each task holds about 1.2 GB of the self build
  // at its peak (bench/results/fast-builds-2026-10-13.md)
  ncores(os).min(16).min(mem_gb(os) / 3).max(1)
}

/// The linker of a host link with no --ld (decision 0182 next step 1 and
/// its 2026-10-16 addendum): compiler/macho on darwin when the assembler
/// is not --as=cc and no `use c` source is linked, else cc; --ld=cc
/// selects cc. (cc was the default again from 643b8261 to this change,
/// while macho's binaries waited at exec: an XProtect false positive,
/// gotchas/xprotect-false-positive-empty-list.md, and a path relinked
/// under a running exec, gotchas/amfi-gatekeeper-macho-layout.md.) For a
/// linux/arm64 target, from a linux host or cross built from any other,
/// a program with no C library links with the ELF linker's static mode
/// (decision 0243, as Go links); one with the C library (XO_NOLIBC=0, or
/// `use c`) keeps cc and glibc (a cross build of one fails: xo does not
/// cross link with cc). A darwin program with no `use c` source links
/// with Xo's Mach-O linker from any host, as GOOS=darwin go build does
/// (Windows field report W5 on 0.26.0: it stopped at its assembly).
fn default_ld(os: Os, ctx: Ctx, o: Opts, c: check.Checker, tgoos: Str, code: Str, uses_time: Bool) -> Bool {
  if o.assembler == "cc" {
    return false
  }
  if tgoos == "linux" {
    // --race too: ThreadSanitizer's static archive, linked whole by Xo's
    // ELF linker with the C library (decision 0273)
    return nolibc(os, o, c, tgoos) || o.race
  }
  if tgoos != "darwin" {
    return false
  }
  for m in c.mods {
    if !m.c_prefix.is_empty() {
      return false
    }
  }
  true
}

/// A program lowered to SSA for one target OS, with the passes run: the
/// builder, the zone data std/time needs, and the time after.
struct Lowered {
  b: ssa.Builder
  tu: tzsel.TZUse
  t: Time
  /// the functions' reference counting keys ([] without the cache)
  rc_keys: List[Str] = []
  /// why the program cannot be built for this target, when the build
  /// skips such a target (Opts.skip_unsupported)
  skipped: Str = ""
}

/// The SSA of the checked program for tgoos/tgoarch (the predeclared
/// `target`), then the passes; fails as the build does.
/// lazy: the arm64 and amd64 backends, whose inliner decodes the cached
/// reference counting it reads (bcache.xo rc_cached); the module may
/// then hold undecoded functions (ssa Module.lazy) until it inlines.
fn lower(os: Os, o: Opts, var c: check.Checker, strip: Bool, root: Str, tests: Bool, release: Bool, uses_time: Bool, tgoos: Str, tgoarch: Str, wasm: Bool, lazy: Bool, t0: Time) -> Lowered {
  // the runtime's profiler: in every build but a release one without
  // --profile-support (decision 0238); --profile asks for it too
  let prof = profile_support_eff(o, release) || !o.profile.is_empty()
  // the amd64 backend lowers only cpu.xo's carry arithmetic yet
  let soft_cpu = o.backend == "amd64"
  // the runtime's overrun check (XO_HEAP_GUARD=1, ssa Builder.heap_guard)
  let heap_guard = !wasm && (os.env.get("XO_HEAP_GUARD") ?? "") == "1"
  var b = fe_cached_build(os, c, root, tests, release, tests && o.real, tgoos, tgoarch, wasm, !wasm && nolibc(os, o, c, tgoos), prof, trace_support_eff(o, release), soft_cpu, heap_guard, o.phases, o.stamps)
  if b.trees_missing {
    // a std body the facts did not make extern met a tree the record
    // left pending (ssa contract.xo body, decision 0388 stage 2): every
    // tree joined, the front end built again; never a body-less build
    c.join_all_trees()
    b = fe_cached_build(os, c, root, tests, release, tests && o.real, tgoos, tgoarch, wasm, !wasm && nolibc(os, o, c, tgoos), prof, trace_support_eff(o, release), soft_cpu, heap_guard, o.phases, o.stamps)
    if o.phases {
      os.stdio.eprintln("phase std_trees_rebuild (a std body outside the facts: every tree joined, built again)")
    }
  }
  b.imm_rc = o.backend != "llvm"
  b.m.nolibc_start = !wasm && nolibc(os, o, c, tgoos)
  b.m.nolibc = !wasm && nolibc(os, o, c, tgoos)
  b.m.op_verify = (os.env.get("XO_OP_VERIFY") ?? "") == "1"
  var t = lap(os, o.phases, "ssa", t0)
  if (os.env.get("XO_FE_STATS") ?? "") == "1" {
    for (k, v) in b.fe_stats {
      os.stdio.eprintln("fe ${k} ${v}")
    }
  }
  if !b.why.is_empty() {
    if o.cmd == "run" && b.why.starts_with("no `main`") {
      os.stdio.eprintln(run_no_main(os, o.wd, o.dirs[0], "has no main function"))
      os.proc.exit(1)
    }
    if o.skip_unsupported {
      return Lowered{b: b, tu: tzsel.TZUse{}, t: t, skipped: b.why}
    }
    fail_unsupported(os, b.why)
  }
  if !b.errs.is_empty() || !b.lazy_diags.is_empty() {
    // what the builder does not lower: the Go driver's XO1201
    // diagnostics (ssa.NoGCDiagnostics), and a native body's own check
    // errors; under switch point A the Go driver builds it or reports
    // them itself
    if !(os.env.get("XO1_FALLBACK") ?? "").is_empty() && !b.errs.is_empty() {
      fail_unsupported(os, "the SSA builder does not support ${b.errs[0].feature}")
    }
    let nd = ssa.nogc_diags(b)
    if o.json && o.cmd == "build" {
      os.stdio.print(build_json(false, [], nd))
    } else {
      print_diags(os, nd)
    }
    os.proc.exit(1)
  }
  for f in b.m.funcs {
    if !f.skip.is_empty() {
      fail_unsupported(os, "the SSA builder skipped ${f.name}: ${f.skip}")
    }
  }
  // the zone data std/time needs, noted as the Go builder lowers
  let tu = if uses_time { tzsel.tz_use(c, b.m, root) } else { tzsel.TZUse{} }
  t = lap(os, o.phases, "tz", t)
  // the passes run in a scope whose one task lets the front end go
  let lo = scope s {
    if strip {
      // decision 0352: the SSA is built and nothing after reads the
      // checker but the link's view, so its syntax trees and tables go
      // here, before the passes' peak (the caller's c is this variable).
      // The last reference is the task's: the release (7 ms of an edit of
      // llvm-fib, 20 of the HTTP server's, on the build's thread) runs
      // beside the passes
      let old = c
      c = c.link_view(o.reuse_parse)
      b.c = c
      let _f = s.spawn(fn() -> Int { old.mods.len() })
      // the marker TestFrontEndFreedByDefault looks for in --phase-times
      t = lap(os, o.phases, "front_end_freed", t)
    }
    // b.run_passes(), timed; may_fault's scans on tasks
    b.m.jobs = emit_jobs(os)
    let tp = t
    b.keep_unwind_names = !(os.env.get("XO_STD_FACTS_DUMP") ?? "").is_empty() || !(os.env.get("XO_STD_FACTS_VERIFY") ?? "").is_empty()
    b.prune_unwind()
    t = lap(os, o.phases, "prune_unwind.unwind", t)
    b.fold_known_calls()
    t = lap(os, o.phases, "prune_unwind.fold", t)
    let _p = lap(os, o.phases, "prune_unwind", tp)
    landings_cleanup_cached(os, b, release, fe_settings(c, root, tests, release, tests && o.real, tgoos, tgoarch, wasm, !wasm && nolibc(os, o, c, tgoos), prof, trace_support_eff(o, release), soft_cpu, heap_guard), emit_jobs(os), o.phases)
    t = os.clock.now()
    // the reference counting's optional pass (rc.xo chain_pads)
    b.m.passes_off = passes_off(os)
    b.m.rc_check = (os.env.get("XO_RC_CHECK") ?? "") == "1"
    // a callee per constant argument (decision 0368), before the reference
    // counting so its caches see the clones as functions
    b.specialize_args()
    t = lap(os, o.phases, "specialize_args", t)
    let rk = rc_cached(os, b, release, emit_jobs(os), o.phases, lazy)
    t = lap(os, o.phases, "insert_rc", t)
    Lowered{b: b, tu: tu, t: t, rc_keys: rk}
  }
  lo
}

/// The end of a native build: the test list of a test binary, or the
/// result of `build` (`os/arch: path` lines on standard output, or the
/// JSON result).
fn finish(os: Os, ctx: Ctx, o: Opts, c: check.Checker, root: Str, bins: List[(Str, Str)], tests: Bool, fz: FuzzSet) -> Native {
  // the outputs are in place: a stop from here on is the program's
  if let Some(d) = ctx.build_done {
    let _ = d.try_send(())
  }
  var host_bin = ""
  for (_, p) in bins {
    host_bin = p
  }
  if tests {
    let ts = test_infos(c, root, o.wd, fz)
    if !o.run_key.is_empty() {
      // with the warnings the build printed, which a hit prints again
      // (decision 0360; a build with a warning was not stored before)
      run_store(os, ctx, o.run_key, c, o.std, o.wd, host_bin, ts, RunOut{output: kept_output(ctx)}, o.run_start)
    }
    return Native{bin: host_bin, tests: ts, pc: c.parse_cache}
  }
  if o.cmd == "build" && !o.part_of_many {
    if o.json {
      os.stdio.print(build_json(true, bins, c.diags))
    } else {
      for (tg, p) in bins.sort_by(fn(x) { x.0 }) {
        os.stdio.println("${tg}: ${p}")
      }
    }
  }
  // a windows build's PDB beside its .exe goes in the entry as a side
  // file, which a hit writes with the binary; a PDB this build did not
  // write (an older build's, under -s) stores no entry, since a hit
  // cannot know it
  var sides: List[Str] = []
  var stale_side = false
  for (_, p) in bins {
    if p.ends_with(".exe") {
      if let Ok(Some(fi)) = os.fs.stat("${p.trim_suffix(".exe")}.pdb") {
        if fi.modified.unix_millis() >= o.run_start {
          sides.push(".pdb")
        } else {
          stale_side = true
        }
      }
    }
  }
  if !o.run_key.is_empty() && !ctx.run_cache.is_empty() && bins.len() == 1 && !stale_side {
    // a build's or run's entry (decision 0360 stage 1): a build's output
    // paths, so a hit writes them
    var wc = ctx
    wc.bin_cache = ctx.run_cache
    run_store(os, wc, o.run_key, c, o.std, o.wd, host_bin, [], RunOut{output: kept_output(ctx), outs: if o.cmd == "build" { bins } else { [] }, sides: if o.cmd == "build" { sides } else { [] }}, o.run_start)
  }
  Native{bin: host_bin, bins: bins, pc: c.parse_cache}
}

/// The sources and flags a native link adds to the program's code
/// (buildArm64 and buildLLVM after the code): the zone data of std/time,
/// the runtime's I/O flags, and the inputs of `use c` (no C runtime since
/// decision 0234).
struct LinkInputs {
  srcs: List[Str] = []
  flags: List[Str] = []
  /// the link's only (not the assembler's): `-s` leaves the symbol
  /// table out (ld -s on Linux; ld64 ignores -s, so -x there, which
  /// keeps the exports and imports dyld needs)
  link_only: List[Str] = []
}

fn link_inputs(os: Os, ctx: Ctx, o: Opts, c: check.Checker, dir: Str, code: Str, uses_time: Bool, tu: tzsel.TZUse, no_cc: Bool, tgoos: Str, tgoarch: Str, backend: Str, inline_fb: Str) -> LinkInputs {
  // no C runtime (decision 0234; std/llrt/xo_rt.c deleted after seed
  // 0.16.0)
  var lk = LinkInputs{}
  if o.strip {
    lk.link_only = if tgoos == "darwin" { ["-Wl,-x"] } else { ["-s"] }
  }
  // the build information (decision 0354 stage 2)
  match binfo_object(os, dir, native_build_info(os, ctx, o, backend, "${tgoos}/${tgoarch}", inline_fb), tgoos, tgoarch, no_cc) {
    Ok(p) => {
      lk.srcs.push(p)
      if !no_cc {
        lk.link_only = lk.link_only + binfo_link_flags(tgoos)
      }
    }
    Err(e) => fail(os, "${e}")
  }
  // std/time: the program's zone data beside the runtime (timeFlags)
  if uses_time {
    if !(o.tzdata is "" | "embedded" | "system") {
      fail(os, "unknown --tzdata=${o.tzdata} (want embedded or system)")
    }
    let sel = tzsel.tz_select(os, ctx.std, tu, o.tzdata, tgoos)
    if !sel.err.is_empty() {
      fail(os, sel.err)
    }
    match if no_cc { tz_object(os, dir, sel, tgoos, tgoarch) } else { tz_source(os, dir, sel) } {
      Ok(p) => lk.srcs.push(p)
      Err(e) => fail(os, "${e}")
    }
    if !(o.json && o.cmd == "build") {
      for n in sel.notes {
        os.stdio.eprintln(n)
      }
    }
  }
  // the adapters, link files, and libraries of `use c` (cInputs)
  let ci = c_inputs(os, c, dir)
  if !ci.err.is_empty() {
    fail(os, ci.err)
  }
  if nolibc(os, o, c, tgoos) {
    // a static program with no C library (decisions 0203, 0206)
    if !ci.srcs.is_empty() || !ci.flags.is_empty() {
      fail(os, "XO_NOLIBC=1: a program with `use c` links the C library (decision 0205)")
    }
    for n in (os.env.get("XO_LLRT_C") ?? "").split(",") {
      if n.trim() == "net" {
        // the C path of the network is the C library's sockets and
        // getaddrinfo (std/native/llrt/net_c.xo); `all` leaves the
        // network on Xo's, the only path with no C library
        fail(os, "XO_NOLIBC=1: XO_LLRT_C=net selects the C library's sockets and getaddrinfo (decision 0206 stage 3)")
      }
    }
    // the target's (a linux/amd64 cross build from an arm64 Mac took the
    // host's: arm64 flags and atomics assembly for an x86_64 link)
    let arch = tgoarch
    lk.flags = lk.flags + nolibc_flags(arch)
    if arch == "arm64" && !no_cc {
      // the arm64 emitter's read modify writes call libgcc's outline
      // atomics on Linux, which a link with no C library lacks (the ELF
      // linker synthesizes them itself)
      match nolibc_atomics(os, dir) {
        Ok(p) => lk.srcs.push(p)
        Err(e) => fail(os, "${e}")
      }
    }
  }
  lk.flags = lk.flags + ci.flags
  lk.srcs = lk.srcs + ci.srcs
  if tgoos == "darwin" && tgoarch == "amd64" {
    // the amd64 backend's darwin/amd64 program when the Mac's cc links it
    // (--as=cc, or `use c`; decision 0254 stage 6a)
    lk.flags = ["-arch", "x86_64"] + lk.flags
  }
  lk
}

/// Writes data to path (path "" only creates dir), or fails.
fn write_or_fail(os: Os, dir: Str, path: Str, data: Bytes) {
  match os.fs.create_dir_all(dir) {
    Ok(_) => {}
    Err(e) => fail(os, "${e}")
  }
  if path.is_empty() {
    return
  }
  let pd = dir_name(path)
  if pd != dir && pd != "." {
    os.fs.create_dir_all(pd).ignore_err("the write reports it")
  }
  match os.fs.write(path, data) {
    Ok(_) => {}
    Err(e) => fail(os, "${e}")
  }
}

/// `xo1 keys`: the cache keys this driver computes; none since the
/// prebuilt runtime's went with the C runtime (decision 0234).
fn keys(os: Os, ctx: Ctx, _cc: Str) -> () ! FsErr {
  let _o = os
  let _c = ctx
  Ok(())
}

/// The directory fault positions are relative to (internal/build
/// lineRoot): the nearest directory holding xo.mod at or above dir, else
/// dir itself, absolute.
fn line_root(os: Os, wd: Str, dir: Str) -> Str {
  var abs = dir.trim_suffix("/")
  if abs.starts_with("./") {
    abs = abs.trim_prefix("./")
  }
  if !is_abs_path(abs) {
    abs = if abs == "." { wd } else { "${wd}/${abs}" }
  }
  var d = abs
  while !d.is_empty() {
    // xo:allow XO0903 a directory it cannot stat is not a module root
    if os.fs.exists("${d}/xo.mod").ok() ?? false {
      return rel_to(wd, d)
    }
    let parts = d.split("/")
    if parts.len() <= 1 {
      break
    }
    d = parts[0..parts.len() - 1].join("/")
  }
  rel_to(wd, abs)
}

/// p relative to wd when it is below it (the checker's file paths are
/// relative to the working directory for relative arguments).
fn rel_to(wd: Str, p: Str) -> Str {
  if p.starts_with("${wd}/") {
    return p.trim_prefix("${wd}/")
  }
  p
}

/// Writes each function's SSA and MIR text (arm64 Program.dumps: the
/// function an internal error stopped on, or $XO_DUMP_FN's) to
/// $XO_DUMP_DIR (else $TMPDIR, else /tmp) as xo-ir-NAME.txt, and names the
/// file on standard error (2026-10-21, the owner's approval).
fn write_dumps(os: Os, dumps: List[(Str, Str)]) {
  if dumps.is_empty() {
    return
  }
  var dir = os.env.get("XO_DUMP_DIR") ?? hostpath.temp_dir(os.env)
  while dir.len() > 1 && dir.ends_with("/") {
    dir = dir[0..dir.len() - 1]
  }
  for (name, text) in dumps {
    var file = BytesBuilder.with_capacity(name.len())
    for c in name.bytes() {
      let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_'
      file.write_byte(if ok { c } else { '_' })
    }
    let path = "${dir}/xo-ir-${file.freeze().to_str() ?? "fn"}.txt"
    match os.fs.write(path, text.bytes()) {
      Ok(_) => os.stdio.eprintln("xo: the SSA and MIR of ${name}: ${path}")
      Err(e) => os.stdio.eprintln("xo: could not write the IR of ${name} to ${path}: ${e}")
    }
  }
}

/// The Xo functions holding the lines of the generated IR a failed clang
/// names (llvm.clang_ir_refs): ", in the IR of file:line:col: in `f`"
/// per line, "" when it names none (a code generator bug that points at
/// the Xo source, the language poll, 2026-10-21).
fn ir_failure_sources(os: Os, m: ssa.Module, msg: Str) -> Str {
  var out = StrBuilder.new()
  for (path, n) in llvm.clang_ir_refs(msg) {
    match os.fs.read(path) {
      Ok(b) => {
        let at = llvm.ir_line_source(m, b.to_str() ?? "", n, "${path}:${n}")
        out.write("\n  the generated IR of ${at}")
      }
      // xo:allow XO0903 a part that cannot be read back names no function; clang's own message stays
      Err(_) => {}
    }
  }
  out.freeze()
}

fn fail(os: Os, msg: Str) -> Never {
  os.stdio.eprintln("xo: ${msg}")
  os.proc.exit(1)
}

/// lap prints the time since t as phase name when on (--phase-times)
/// and returns the time now.
fn lap(os: Os, on: Bool, name: Str, t: Time) -> Time {
  // the memory budget's report names the phase in progress (decision
  // 0349): the one after the phase that just ended
  debug.mem_label("building, past phase ${name}")
  if on {
    // with the heap's use so far (decision 0349's measure, in MiB)
    // to the hundredth of a millisecond: whole milliseconds dropped half
    // a millisecond a lap, and a phase's laps fell 4 ms short of it
    // (the link's twelve, 2026-10-29)
    os.stdio.eprintln("phase ${name} ${ms2(os.clock.since(t))} ms (heap ${debug.mem_mapped() / 1048576} MB, peak ${debug.mem_peak() / 1048576} MB)")
  }
  os.clock.now()
}

/// d in milliseconds with two decimals ("3.42"), rounded down.
fn ms2(d: Duration) -> Str {
  let h = d.nanos() / 10000
  let f = h % 100
  "${h / 100}.${if f < 10 { "0" } else { "" }}${f}"
}

/// The optional passes $XO_PASSES turns off (arm64 passes.xo); a wrong
/// value fails the build.
/// Whether the optional pass name is on ($XO_PASSES does not turn it
/// off): the driver's own passes' check, which internal/repotest
/// TestPassesListed finds by this form.
fn pass_on(os: Os, name: Str) -> Bool {
  !passes_off(os).contains(name)
}

fn passes_off(os: Os) -> List[Str] {
  let (off, _on, err) = arm64.parse_passes(os.env.get("XO_PASSES") ?? "")
  if !err.is_empty() {
    fail(os, err)
  }
  off
}

/// Whether $XO_PASSES changes which passes run, with a `-name` or a
/// `+name` entry. The caches' keys do not say which passes ran, so any
/// entry turns them off (a `-hollow` build must not reuse a plain
/// build's entries, or the reverse).
fn passes_changed(os: Os) -> Bool {
  let (off, on, err) = arm64.parse_passes(os.env.get("XO_PASSES") ?? "")
  if !err.is_empty() {
    fail(os, err)
  }
  // XO_THREAD_SWITCH (a per function filter of decision 0397's pass, for
  // bisecting) changes the code the same way
  !off.is_empty() || !on.is_empty() || !(os.env.get("XO_THREAD_SWITCH") ?? "").is_empty()
}

/// arm64's inlining of mi, and whether the inlined module is to be
/// generated. When it does not verify the module is generated without
/// inlining (slower, still correct): said on standard error with the
/// first error (it names the function), and a failed build with
/// XO_INLINE_STRICT=1, which the Go tests set (internal/xotool), so a
/// broken inliner cannot pass the tests as a slow one
/// (gotchas/arm64-inline-verify-fallback.md). XO_INLINE_BREAK=1 breaks
/// the inlined module on purpose (internal/arm64 TestInlineFallbackLoud).
fn inline_or_say(os: Os, var mi: ssa.Module, jobs: Int, phases: Bool, tgoos: Str, release: Bool, rc_keys: List[Str]) -> Bool {
  let (ok, _, _) = inline_or_defer(os, mi, jobs, phases, tgoos, release, rc_keys, false, false)
  ok
}

/// inline_or_say, or with later, when the module changed, its
/// verification left to the caller (verify_after_dce): whether the
/// inlined module is to be generated, and whether its verification is
/// pending, and the first verification error when it fell back ("" when
/// not). With lazy the inline cache's hits are left undecoded (arm64
/// inline_cached, decision 0283 stage B).
fn inline_or_defer(os: Os, var mi: ssa.Module, jobs: Int, phases: Bool, tgoos: Str, release: Bool, rc_keys: List[Str], later: Bool, lazy: Bool) -> (Bool, Bool, Str) {
  let deny = os.env.get("XO_INLINE_DENY") ?? ""
  if !deny.is_empty() {
    mi.inline_deny = deny.split(",")
  }
  mi.passes_off = passes_off(os)
  // XO_INLINE_REPORT=NAME (a part of the names, or 1 for every function):
  // how the inliner takes each, on standard error
  let report = os.env.get("XO_INLINE_REPORT") ?? ""
  if !report.is_empty() {
    for l in arm64.inline_report(mi, report) {
      os.stdio.eprintln(l)
    }
  }
  // arm64.inline_check(mi, jobs, ...), its two halves timed
  var t = os.clock.now()
  let changed = inline_through_cache(os, mi, rc_keys, jobs, release, (os.env.get("XO_INLINE_BREAK") ?? "") == "1", phases, lazy)
  t = lap(os, phases, "inline.apply", t)
  if changed && later {
    return (true, true, "")
  }
  let errs = if changed { verify_inlined(os, mi, tgoos, jobs, release) } else { [] }
  lap(os, phases, "inline.verify", t)
  (inline_verified(os, errs), false, fallback_text(errs))
}

/// The module m made ready for the arm64 generator: its undecoded
/// functions decoded, dead functions removed (not for `xo asm` or
/// XO_DCE=off), and the generation flags of the target and options set;
/// the module and the time after (the dce phase).
fn gen_module(os: Os, o: Opts, ctx: Ctx, c: check.Checker, m: ssa.Module, tgoos: Str, release: Bool, jobs: Int, phases: Bool, t0: Time) -> (ssa.Module, Time) {
  var gm = m
  var t = t0
  // the module without inlining holds the undecoded functions still (the
  // inline cache's hits stay undecoded: their readers force them)
  ssa.force_lazy_unfacted(gm, jobs)
  // whole program dead function removal (arm64 reach.xo); not for `xo
  // asm`, which shows every function (xo dev codegen reads inlined ones)
  if o.cmd != "asm" && (os.env.get("XO_DCE") ?? "") != "off" {
    let d = arm64.drop_unreached(gm)
    // XO_DCE=debug says how many, =list also which
    let how = os.env.get("XO_DCE") ?? ""
    if how == "debug" || how == "list" {
      let ls = d.split("\n")
      os.stdio.eprintln("dce: ${ls[0]}")
      if how == "list" {
        for n in ls[1..ls.len()] {
          os.stdio.eprintln("dce dropped ${n}")
        }
      }
    }
    t = lap(os, phases, "dce", t)
  }
  gm.passes_off = passes_off(os)
  // decision 0403 stage 1: the functions' order from the layout file; a
  // profile of another target is ignored with one line
  if !o.layout_text.is_empty() {
    match parse_layout(o.layout_text) {
      Ok(l) => {
        let want = "${tgoos}/${gm.goarch}"
        if !l.target.is_empty() && l.target != want {
          os.stdio.eprintln("layout: the layout file is ${l.target}'s, ignored for ${want}")
        } else {
          let names = gm.funcs.map(fn(f: ssa.Func) -> Str { f.name })
          gm.fn_order = layout_order(names, l)
          if (os.env.get("XO_CACHE_STATS") ?? "") == "1" {
            var hit = 0
            for n in names {
              if (l.fns.get(n) ?? 0) > 0 {
                hit += 1
              }
            }
            os.stdio.eprintln("layout: ${hit} of ${l.fns.len()} sampled functions matched, ${names.len()} functions ordered")
          }
        }
      }
      Err(e) => fail(os, "layout file: ${e}")
    }
  }
  // decision 0388 stage 4: XO_STD_OBJ=DIR builds std's object
  gm.std_obj = !std_obj_dir(os).is_empty() && gm.std_store
  // decision 0388 stage 3: a separately compiled program's side
  // (sepcomp_program, set by XO_SEPCOMP) has its helpers weak and its
  // parts in store mode, as std's object
  gm.sepcomp_program = !sepcomp_facts_path(os).is_empty()
  gm.weak_shared = gm.std_obj || gm.sepcomp_program
  if gm.sepcomp_program {
    gm.std_store = true
  }
  // XO_DUMP_FN=NAME: that function's SSA and MIR to a file (write_dumps)
  gm.dump_fn = os.env.get("XO_DUMP_FN") ?? ""
  gm.race = o.race
  gm.arm64_regs = Int.parse(os.env.get("XO_ARM64_REGS") ?? "") ?? 0
  gm.arm64_pad = Int.parse(os.env.get("XO_ARM64_PAD") ?? "") ?? 0
  gm.thread_switch_only = os.env.get("XO_THREAD_SWITCH") ?? ""
  if gm.thread_switch_only.starts_with("@") {
    let nf = gm.thread_switch_only[1..gm.thread_switch_only.len()]
    for n in (os.fs.read_text(nf).ok() ?? "").split("\n") {
      if !n.trim().is_empty() {
        gm.thread_switch_names[n.trim()] = true
      }
    }
  }
  gm.poison_frames = (os.env.get("XO_POISON_FRAMES") ?? "") == "1"
  // DWARF line tables (decision 0239): on, except for `xo asm`, -s, and
  // a release build without --debug-info
  gm.debug_info = o.cmd != "asm" && !o.strip && debug_info_eff(o, release) != "off"
  // a string literal's address in a variable's location: not through
  // dsymutil (a cc link on macOS), which relocates it as the function's
  let own_ld = o.linker == "macho" || (o.linker.is_empty() && default_ld(os, ctx, o, c, tgoos, "", false))
  gm.dw_data_addrs = gm.debug_info && (tgoos != "darwin" || own_ld)
  // the line root (the sources' names are relative to it: ssa file_name)
  // is the compilation directory, not the working directory, which
  // differs for `xo build DIR` (lldb opened the working directory's
  // main.xo, 2026-10-22); std's directory is relative to the latter
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  let cwd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  gm.comp_dir = abs_line_root(os, cwd, o.dirs[0])
  let sd = dir_name(ctx.std.trim_suffix("/"))
  gm.std_root = if is_abs_path(sd) { sd } else { "${cwd}/${sd}" }
  if trimpath_eff(o) {
    gm.comp_dir = rel_or_dot(cwd, gm.comp_dir)
    gm.std_root = rel_or_dot(cwd, gm.std_root)
  }
  (gm, t)
}

/// Decision 0342: every call, closure, and field access of the module to
/// generate agrees with this build's definitions (ssa
/// check_assumptions); XO1510 and exit 1 on a mismatch, since a cached
/// piece is stale. XO_ASSUME_CHECK=off skips it (its cost is measured
/// with xo bench --ab).
fn check_assumptions(os: Os, var m: ssa.Module, phases: Bool, t: Time) -> Time {
  if (os.env.get("XO_ASSUME_CHECK") ?? "") == "off" {
    return t
  }
  if (os.env.get("XO_ASSUME_BREAK") ?? "") == "1" {
    let _b = m.break_a_call()
  }
  let errs = m.check_assumptions()
  let t2 = lap(os, phases, "assume", t)
  if errs.is_empty() {
    return t2
  }
  var ds: List[check.Diag] = []
  for e in errs[0..errs.len().min(5)] {
    ds.push(check.Diag{code: "XO1510", file: "", line: 0, col: 0, end_line: 0, end_col: 0, message: "a function disagrees with this build's definitions (a stale cached piece; decision 0342): ${e}; rebuild with XO_BACKEND_CACHE=off and report it"})
  }
  print_diags(os, ds)
  os.proc.exit(1)
  t2
}

/// What a build that fell back from inlining records and summarizes:
/// how many functions failed the verification and the first error
/// ("" when it verified).
fn fallback_text(errs: List[Str]) -> Str {
  if errs.is_empty() {
    return ""
  }
  var fns: Map[Str, Bool] = {}
  for e in errs {
    fns[e.split(": ")[0]] = true
  }
  let n = fns.len()
  "${n} ${if n == 1 { "function" } else { "functions" }} did not verify; the first: ${errs[0]}"
}

/// Whether the inlined module verified (errs empty); else says so on
/// standard error (it is built without inlining), or fails the build
/// with XO_INLINE_STRICT=1.
fn inline_verified(os: Os, errs: List[Str]) -> Bool {
  if errs.is_empty() {
    return true
  }
  let msg = "the inlined arm64 module does not verify (${errs.len()} errors; the first: ${errs[0]})"
  if (os.env.get("XO_INLINE_STRICT") ?? "") == "1" {
    fail(os, "${msg}; failing the build (XO_INLINE_STRICT=1)")
  }
  os.stdio.eprintln("xo: warning: ${msg}, so it is built without inlining (slower; XO_INLINE_STRICT=1 makes this an error)")
  false
}

/// Whether the inlined module's verification waits until after dead
/// function removal and the generation flags, where the per-function
/// cache's keys (arm64.function_keys) serve both it and the cache: they
/// were computed twice an edit build, 0.2 to 0.5 s each for xo. Only
/// where the cache is used (arm64 and amd64, no XO_PASSES, no --race, not
/// --release or verify) and not with XO_INLINE_BREAK=1, whose test
/// breaks a function dead function removal may drop (XO_INLINE_BREAK=late
/// breaks one after it, for the test of this path).
fn defer_inline_verify(os: Os, o: Opts, march: Str, release: Bool) -> Bool {
  (march == "arm64" || march == "amd64") && !o.race && !release && !passes_changed(os) && (os.env.get("XO_INLINE_BREAK") ?? "") != "1" && backend_cache_mode(os) != "verify" && !cache_id(os).is_empty()
}

/// The checker's path of the std module `xo test --std-module` names
/// (check.Checker.std_test): `native/...` as given, `std/NAME` for a
/// plain NAME; "" for none.
fn std_test_path(m: Str) -> Str {
  if m.is_empty() || m.starts_with("native/") || m.starts_with("std/") {
    return m
  }
  "std/${m}"
}

/// The module check cache of `xo check` (decision 0351 addendum,
/// 2026-10-23): the backend cache directory and this xo's cache ID, as a
/// build's (XO_CHK_CACHE=off, XO_FE_CACHE=off or XO_BACKEND_CACHE=off
/// turn it off), or ("", "") for another command.
fn check_cache(os: Os, args: List[Str]) -> (Str, Str) {
  var i = 0
  while i < args.len() && (args[i].starts_with("--std=") || args[i].starts_with("--wd=")) {
    i += 1
  }
  if i >= args.len() || args[i] != "check" {
    return ("", "")
  }
  if (os.env.get("XO_CHK_CACHE") ?? "") == "off" || (os.env.get("XO_FE_CACHE") ?? "") == "off" || backend_cache_mode(os) == "off" {
    return ("", "")
  }
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  if dir.is_empty() {
    return ("", "")
  }
  let id = cache_id(os)
  if id.is_empty() { ("", "") } else { (dir, id) }
}

/// The parts with the functions nothing reaches emptied (arm64 hollow.xo)
/// for march, ELF or Mach-O.
fn hollow_parts(ps: List[Str], march: Str, elf: Bool) -> List[Str] {
  let (hp, _hs) = if march == "amd64" {
    arm64.hollow_unreached_amd64(ps, elf)
  } else if elf {
    arm64.hollow_unreached_elf(ps)
  } else {
    arm64.hollow_unreached(ps)
  }
  hp
}

/// XO_STD_OBJ=DIR (decision 0388 stage 4): an XO_STD_ROOTS build that
/// writes std's object (its parts without the program's functions, and
/// their store) to DIR instead of linking; "" for none (darwin/arm64).
fn std_obj_dir(os: Os) -> Str {
  os.env.get("XO_STD_OBJ") ?? ""
}

/// std's object files for an XO_SEPCOMP build (decision 0388 stage 3):
/// the .o files of XO_SEPCOMP_OBJS, in name order, and a key token of
/// their names, sizes and times for the binary cache; none otherwise.
fn sepcomp_objs(os: Os, conc: Bool) -> (List[Str], Str) {
  if sepcomp_facts_path(os).is_empty() {
    return ([], "")
  }
  // through std's store (XO_SEPCOMP_STORE, macho_link reads it): no
  // object files; the key token is the store's size and time
  let store = sepcomp_store(os, conc)
  if !store.is_empty() {
    match os.fs.stat(store) {
      Ok(Some(i)) => return ([], "sepcomp-store ${i.size}:${i.modified}")
      _ => fail(os, "XO_SEPCOMP_STORE=${store}: not found")
    }
  }
  let dir0 = os.env.get("XO_SEPCOMP_OBJS") ?? ""
  // a directory of both variants: conc0-std and conc1-std
  let sub = "${dir0}/${if conc { "conc1-std" } else { "conc0-std" }}"
  let dir = if os.fs.exists(sub).ok() ?? false { sub } else { dir0 }
  if dir.is_empty() {
    fail(os, "XO_SEPCOMP=1 links with std's object: set XO_SEPCOMP_OBJS to the directory of its .o files")
  }
  var names: List[Str] = []
  var info: Map[Str, Str] = {}
  for fi in os.fs.read_dir(dir).ok() ?? [] {
    if !fi.is_dir && fi.name.ends_with(".o") {
      names.push(fi.name)
      info[fi.name] = "${fi.size}:${fi.modified}"
    }
  }
  if names.is_empty() {
    fail(os, "XO_SEPCOMP_OBJS=${dir}: no .o file")
  }
  var paths: List[Str] = []
  var key = "sepcomp-objs"
  for n in names.sort() {
    paths.push("${dir}/${n}")
    key = "${key} ${n}=${info.get(n) ?? ""}"
  }
  (paths, key)
}

/// und without the names std's object files define (decision 0388): a
/// program's call of a std function is an undefined symbol its object
/// leaves to std's.
fn sepcomp_undefined(os: Os, und: List[(Str, Str)], objs: List[Str], conc: Bool) -> List[(Str, Str)] {
  if und.is_empty() {
    return und
  }
  var defs: Set[Str] = #{}
  let store = sepcomp_store(os, conc)
  if !store.is_empty() {
    match os.fs.read(store) {
      Ok(b) => {
        match macho.store_defs(b) {
          Ok(ss) => {
            for s in ss {
              defs.add(s)
            }
          }
          Err(e) => fail(os, "XO_SEPCOMP_STORE=${store}: ${e}")
        }
      }
      Err(e) => fail(os, "XO_SEPCOMP_STORE=${store}: ${e}")
    }
    return und.filter(fn(u) { !defs.contains(u.0) })
  }
  if objs.is_empty() {
    return und
  }
  for p in objs {
    match os.fs.read(p) {
      Ok(b) => {
        match macho.defined_symbols(p, b) {
          Ok(ss) => {
            for s in ss {
              defs.add(s)
            }
          }
          Err(e) => fail(os, "XO_SEPCOMP_OBJS: ${e}")
        }
      }
      Err(e) => fail(os, "XO_SEPCOMP_OBJS: ${p}: ${e}")
    }
  }
  und.filter(fn(u) { !defs.contains(u.0) })
}

/// XO_SEPCOMP_FACTS's files: a file serves both concurrency variants; a
/// directory holds conc0.stdf and conc1.stdf, std built with it off and
/// on (decision 0388: concurrency changes std's facts).
fn sepcomp_fact_files(os: Os, p: Str) -> (Str, Str) {
  // the default's two files (sepcomp_default)
  let pc = os.env.get("XO_SEPCOMP_FACTS_CONC") ?? ""
  if !pc.is_empty() {
    return (p, pc)
  }
  match os.fs.stat(p) {
    Ok(Some(i)) => if i.is_dir { ("${p}/conc0.stdf", "${p}/conc1.stdf") } else { (p, "") }
    _ => (p, "")
  }
}
