// The run cache of `xo test` on the native backends (decision 0236
// addendum): a test binary and its test list, found by a key known
// before the check (xo's identity, the command line without the flags
// that only change the run, the XO_ environment, the C toolchain, the
// SDK, the runtime pack), so a run with no input changed skips the
// check, the SSA, the passes, and the link. The entry also lists what
// the build read, each with the SHA-256 of its contents: every file of
// the std tree, every file of each module directory the program uses
// (the .xo files, a `use c` module's C, xo.mod), the directory
// listings (a new file misses), and xo.mod, xo.lock, xo.work, and
// xo.work.lock from the working directory up. An entry is used only
// when all of them still match. It lives in the bin cache (XO_BIN_CACHE,
// run/<key>.m and run/<key>.bin), so `XO_BIN_CACHE=off` turns it off.
// The entry keeps the warnings the build printed and a hit prints them
// again, so a hit never hides one (decision 0360; before, a build with
// a warning was not stored, and such a program never hit). A build whose
// inputs changed while it ran is not stored.
//
// `xo build` and `xo run` use the same entries (decision 0360; on by
// default, XO_WHOLE_BUILD=off turns it off): the key's command line is theirs (it names
// the subcommand, so their entries never meet a test run's), an entry
// also keeps the outputs a build wrote (target and path), and a hit
// copies the binary to each output, or runs it.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/prune
use std/crypto
use github.com/xo-lang/xo/compiler/hostpath

/// A stored run: the binary and its tests.
struct RunHit {
  bin: Str
  tests: List[TestInfo]
  /// what the build printed (Tee.text: its warnings, a build's output
  /// lines or --json report), printed again on a hit
  output: Str = ""
  /// the outputs a `xo build` wrote: (target, path)
  outs: List[(Str, Str)] = []
}

/// What a build stores beside its binary (run_store).
struct RunOut {
  output: Str = ""
  outs: List[(Str, Str)] = []
}

/// Whether `xo build` and `xo run` use the run cache (decision 0360: on
/// by default since the owner's decision of 2026-10-23; XO_WHOLE_BUILD=off
/// turns it off, and XO_BIN_CACHE=off turns off every run cache entry).
fn whole_build_on(os: Os) -> Bool {
  (os.env.get("XO_WHOLE_BUILD") ?? "") != "off"
}

/// The flags of `xo test` that only change how the tests run, not the
/// binary: left out of the key.
fn run_only_flag(name: Str) -> Bool {
  name is "run" | "seed" | "cases" | "timeout" | "v" | "json" | "phase-times"
}

/// The flags among run_only_flag's that take a value.
fn run_flag_takes_value(name: Str) -> Bool {
  name is "run" | "seed" | "cases" | "timeout"
}

/// The key of a test run, "" when the cache is off or xo's identity is
/// unknown.
fn run_key(os: Os, ctx: Ctx, o: Opts, args: List[Str], backend: Str) -> Str {
  if ctx.bin_cache.is_empty() {
    return ""
  }
  let id = self_id(os)
  if id.is_empty() {
    return ""
  }
  var k = new_key("testrun v1")
  k.str(id)
  k.str(backend)
  k.str(o.wd)
  k.str(o.std)
  // the command line, without the flags that only change the run (a
  // test's), or the report (--phase-times), and without a `xo run`
  // program's arguments
  var kept: List[Str] = []
  var skip_next = false
  for a in args {
    if skip_next {
      skip_next = false
      continue
    }
    if a == "--" && o.cmd == "run" {
      break
    }
    if a.starts_with("-") && a != "-" {
      let body = a.trim_prefix("-").trim_prefix("-")
      let name = body.split("=")[0]
      if (o.cmd == "test" && run_only_flag(name)) || name == "phase-times" {
        skip_next = run_flag_takes_value(name) && !body.contains("=")
        continue
      }
    }
    kept.push(a)
  }
  k.strs(kept)
  // --seed and --explore leave the key's command line, but build the
  // deterministic flavor (decision 0350 stage 2): a seeded run after a
  // plain one reused the plain binary
  k.str("det ${o.topts.seed != 0 || o.explore > 0}")
  // the environment that can change a build: every XO_ variable (but
  // XO_TEST_JOBS, how many test processes run at once, and
  // XO_TEST_ONLY, which of the tests run), and where tools
  // and modules are found
  var env: List[Str] = []
  for (n, v) in os.env.vars().entries() {
    if (n.starts_with("XO_") && !(n is "XO_TEST_JOBS" | "XO_TEST_ONLY")) || n is "PATH" | "HOME" | "XDG_CACHE_HOME" | "CC" | "SDKROOT" | "DEVELOPER_DIR" {
      env.push("${n}=${v}")
    }
  }
  k.strs(env.sort())
  k.str("${host_os(os)}/${host_arch()}")
  // the C toolchain the link uses, the SDK, and the prebuilt runtime
  k.str(tool_id_memo(os, ctx, if o.cc.is_empty() { find_cc(os) } else { o.cc }, ["--version"]))
  if backend == "llvm" {
    k.str(tool_id_memo(os, ctx, if o.cc.is_empty() { find_clang(os) } else { o.cc }, ["--version"]))
  }
  let memo = sysroot_memo(os, ctx)
  if !memo.is_empty() {
    // xo:allow XO0903 a memo: a failed read only changes the key, a cache miss
    k.str((os.fs.read_text(memo).ok() ?? "").trim())
  }
  k.sum()
}

fn run_entry(ctx: Ctx, key: Str) -> Str {
  "${ctx.bin_cache}/run/${key[0..2]}/${key}"
}

fn hex_field(s: Str) -> Str {
  "x${s.bytes().to_hex()}"
}

fn unhex_field(f: Str) -> Str {
  match Bytes.from_hex(f.trim_prefix("x")) {
    Some(b) => b.to_str() ?? ""
    None => ""
  }
}

fn sha_of(os: Os, p: Str) -> Str {
  match os.fs.read(p) {
    Ok(b) => crypto.sha256(b).to_hex()
    Err(_) => "none"
  }
}

/// The SHA-256 of the sorted names of dir's entries (a slash after a
/// directory's), "none" when it cannot be read.
fn listing_of(os: Os, dir: Str) -> Str {
  match os.fs.read_dir(dir) {
    Ok(fis) => {
      var ns: List[Str] = []
      for fi in fis {
        ns.push(if fi.is_dir { "${fi.name}/" } else { fi.name })
      }
      crypto.sha256(ns.sort().join("\n").bytes()).to_hex()
    }
    Err(_) => "none"
  }
}

/// The SHA-256 of every path under dir (a slash after a directory's),
/// sorted; "none" when it cannot be walked.
fn walk_of(os: Os, dir: Str) -> Str {
  match os.fs.walk(dir) {
    Ok(all) => {
      var names: List[Str] = []
      for fi in all {
        names.push(if fi.is_dir { "${fi.path}/" } else { fi.path })
      }
      crypto.sha256(names.sort().join("\n").bytes()).to_hex()
    }
    Err(_) => "none"
  }
}

/// How many of an entry's files run_fetch hashes one by one before the
/// rest go to tasks.
const RUN_SERIAL_FILES = 16

/// The (SHA-256, path) of an entry's files after its first
/// RUN_SERIAL_FILES, which run_fetch hashes on tasks.
fn later_files(text: Str) -> List[(Str, Str)] {
  var out: List[(Str, Str)] = []
  var n = 0
  for l in text.split("\n") {
    if l.starts_with("file ") {
      let f = l.split(" ")
      if f.len() == 3 {
        n += 1
        if n > RUN_SERIAL_FILES {
          out.push((f[1], unhex_field(f[2])))
        }
      }
    }
  }
  out
}

/// Whether each (SHA-256, path) still holds those contents, hashed on
/// tasks: a hit hashed 449 files one by one, 13 ms of llvm-fib's 20 ms
/// warm rebuild (2026-10-26). Stops early once one differs.
fn files_unchanged(os: Os, xs: List[(Str, Str)]) -> Bool {
  let n = xs.len()
  if n == 0 {
    return true
  }
  let next = Atomic[Int].new(0)
  let bad = Atomic[Int].new(0)
  scope s {
    for _ in 0..emit_jobs(os).min((n + 31) / 32).max(1) {
      let _t = s.spawn(fn() {
        while bad.get() == 0 {
          let i = next.add(32) - 32
          if i >= n {
            break
          }
          for j in i..(i + 32).min(n) {
            let (sum, p) = xs[j]
            if sha_of(os, p) != sum {
              bad.set(1)
              break
            }
          }
        }
      })
    }
  }
  bad.get() == 0
}

/// The stored run of key when every input it lists is unchanged.
fn run_fetch(os: Os, ctx: Ctx, key: Str) -> RunHit? {
  if key.is_empty() {
    return None
  }
  let entry = run_entry(ctx, key)
  let text = match os.fs.read_text("${entry}.m") {
    Ok(t) => t
    Err(_) => return None
  }
  let bin = "${entry}.bin"
  match os.fs.stat(bin) {
    Ok(Some(fi)) => {
      if fi.is_dir {
        return None
      }
    }
    _ => return None
  }
  var tests: List[TestInfo] = []
  var output = ""
  var outs: List[(Str, Str)] = []
  var head = false
  // the first files (run_store writes the program's own first) are
  // hashed in order, so an edit misses at its first file; the rest
  // (std's, hundreds) on tasks after the walk (later_files)
  var nfiles = 0
  for l in text.split("\n") {
    if l.is_empty() {
      continue
    }
    let f = l.split(" ")
    if f[0] == "xo-testrun-v1" {
      head = true
    } else if f[0] == "file" && f.len() == 3 {
      nfiles += 1
      if nfiles <= RUN_SERIAL_FILES && sha_of(os, unhex_field(f[2])) != f[1] {
        return None
      }
    } else if f[0] == "dir" && f.len() == 3 {
      if listing_of(os, unhex_field(f[2])) != f[1] {
        return None
      }
    } else if f[0] == "walk" && f.len() == 3 {
      if walk_of(os, unhex_field(f[2])) != f[1] {
        return None
      }
    } else if f[0] == "probe" && f.len() == 3 {
      if probe_again(os, unhex_field(f[2])) != unhex_field(f[1]) {
        return None
      }
    } else if f[0] == "env" && f.len() == 3 {
      if env_again(os, unhex_field(f[2])) != unhex_field(f[1]) {
        return None
      }
    } else if f[0] == "output" && f.len() == 2 {
      output = unhex_field(f[1])
    } else if f[0] == "out" && f.len() == 3 {
      outs.push((unhex_field(f[1]), unhex_field(f[2])))
    } else if f[0] == "test" && f.len() == 10 {
      let eff = unhex_field(f[7])
      tests.push(TestInfo{index: Int.parse(f[2]) ?? -1, name: unhex_field(f[1]), module: unhex_field(f[3]), dir: unhex_field(f[4]), loc: unhex_field(f[5]), seed: Int.parse(f[6]) ?? 0, effects: if eff.is_empty() { [] } else { eff.split(",") }, prop: f[8] == "1", skip: unhex_field(f[9])})
    } else {
      return None
    }
  }
  if !head || !files_unchanged(os, later_files(text)) {
    return None
  }
  prune.mark_used_within(os.fs, os.clock, "${entry}.m", BIN_TOUCH)
  prune.mark_used_within(os.fs, os.clock, bin, BIN_TOUCH)
  // the run uses a copy outside the cache, so a prune cannot remove the
  // binary between its test processes, however long they run
  // (the .exe a Windows program needs to run: field report W3)
  let run = "${hostpath.temp_dir(os.env)}/xo-run-${os.rand.bytes(8).to_hex()}${hostpath.exe_suffix(if hostpath.windows() { "windows" } else { "" })}"
  match os.fs.copy(bin, run) {
    Ok(_) => {}
    Err(_) => {
      os.fs.remove(run).ignore_err("a failed copy")
      return None
    }
  }
  Some(RunHit{bin: run, tests: tests, output: output, outs: outs})
}

/// The files and directories a test build of c read (run_fetch's
/// inputs): the std tree, each non-std module's directory, and the
/// module files from wd up. None when a directory cannot be listed: a run
/// stored with fewer inputs could be fetched after one of the others
/// changed (XO0903).
fn run_inputs(os: Os, c: check.Checker, std: Str, wd: Str) -> (List[Str], List[Str])? {
  var files: List[Str] = []
  var dirs: List[Str] = []
  let sd = std.trim_suffix("/")
  dirs.push(sd)
  match os.fs.walk(sd) {
    Ok(all) => {
      for fi in all {
        if fi.is_dir {
          dirs.push(fi.path)
        } else {
          files.push(fi.path)
        }
      }
    }
    Err(_) => return None
  }
  var seen: Map[Str, Bool] = {}
  for m in c.mods {
    if m.is_std || m.native || m.dir.is_empty() {
      continue
    }
    let d = abs_path(wd, m.dir)
    if d.starts_with("${sd}/") || seen.contains(d) {
      continue
    }
    seen[d] = true
    dirs.push(d)
    match os.fs.read_dir(d) {
      Ok(fis) => {
        for fi in fis {
          if !fi.is_dir {
            files.push("${d}/${fi.name}")
          }
        }
      }
      Err(_) => return None
    }
  }
  // the files embed constants embed (decision 0304): a change to one
  // changes the program
  for p in c.embedded_paths() {
    files.push(abs_path(wd, p))
  }
  var d = wd
  while true {
    for n in ["xo.mod", "xo.lock", "xo.work", "xo.work.lock"] {
      files.push("${d}/${n}")
    }
    let up = dir_name(d)
    if up == d || up.is_empty() {
      break
    }
    d = up
  }
  Some((files, dirs))
}

/// Stores the run of key: bin, its tests, and the inputs c read, with
/// their contents now. Not when an input changed after start (the build
/// may have read the older contents).
fn run_store(os: Os, ctx: Ctx, key: Str, c: check.Checker, std: Str, wd: Str, bin: Str, tests: List[TestInfo], ro: RunOut, start: Int) {
  if key.is_empty() || bin.is_empty() {
    return
  }
  // the recorded reads (recorder.xo), else the whole std tree and every
  // module directory
  var files: List[Str] = []
  // the SHA-256 of a file's contents where the build hashed them as it read
  var sums: Map[Str, Str] = {}
  var dirs: List[Str] = []
  var walks: List[Str] = []
  var extra: List[Str] = []
  // a build's own outputs and what it wrote are not its inputs: a
  // probe of the output before it existed would miss every next build
  var made: Map[Str, Bool] = {}
  for (_, o) in ro.outs {
    made[abs_path(wd, o)] = true
  }
  match ctx.rec {
    Some(m) => {
      let rec = m.with(fn(r) { r })
      for (p, _) in rec.written {
        made[p] = true
      }
      let own = fn(p: Str) -> Bool { made.contains(p) }
      files = rec.reads.keys().sort().filter(fn(p) { !own(p) })
      sums = rec.reads
      for p in rec.lists.keys().sort() {
        if own(p) {
          continue
        }
        if (rec.lists.get(p) ?? "") == "walk" {
          walks.push(p)
        } else {
          dirs.push(p)
        }
      }
      for k in rec.probes.keys().sort() {
        // "KIND PATH": a probe of the build's own output is left out
        let kind = k.split(" ")[0]
        if kind.len() < k.len() && own(k[kind.len() + 1..]) {
          continue
        }
        extra.push("probe ${hex_field(rec.probes.get(k) ?? "")} ${hex_field(k)}\n")
      }
      for n in rec.env.keys().sort() {
        extra.push("env ${hex_field(rec.env.get(n) ?? "")} ${hex_field(n)}\n")
      }
    }
    None => {
      match run_inputs(os, c, std, wd) {
        Some((fs, ds)) => {
          files = fs
          dirs = ds
        }
        None => return
      }
    }
  }
  // the working directory's files first: run_fetch stops at the first
  // changed file, and an edit changes the program, not std (in path order
  // std came first wherever it sorts before the program, so an edit's
  // miss hashed all 195 std files first, about 20 ms, 2026-10-26)
  let pre = if wd.ends_with("/") { wd } else { "${wd}/" }
  files = files.filter(fn(p) { p.starts_with(pre) }) + files.filter(fn(p) { !p.starts_with(pre) })
  var b = StrBuilder.new()
  b.write("xo-testrun-v1\n")
  // a build's own outputs are not its inputs: `xo build -o prog .`
  // writes into the module's directory (its listing keeps the name)
  var outputs: Map[Str, Bool] = {}
  for (_, o) in ro.outs {
    outputs[abs_path(wd, o)] = true
  }
  for p in files {
    if outputs.contains(p) {
      continue
    }
    match os.fs.stat(p) {
      Ok(Some(fi)) => {
        if fi.modified.unix_millis() >= start {
          return
        }
      }
      _ => {}
    }
    let sum = sums.get(p) ?? ""
    b.write("file ${if sum.is_empty() { sha_of(os, p) } else { sum }} ${hex_field(p)}\n")
  }
  for d in dirs {
    b.write("dir ${listing_of(os, d)} ${hex_field(d)}\n")
  }
  for d in walks {
    b.write("walk ${walk_of(os, d)} ${hex_field(d)}\n")
  }
  for l in extra {
    b.write(l)
  }
  if !ro.output.is_empty() {
    b.write("output ${hex_field(ro.output)}\n")
  }
  for (tg, p) in ro.outs {
    b.write("out ${hex_field(tg)} ${hex_field(p)}\n")
  }
  for t in tests {
    b.write("test ${hex_field(t.name)} ${t.index} ${hex_field(t.module)} ${hex_field(t.dir)} ${hex_field(t.loc)} ${t.seed} ${hex_field(t.effects.join(","))} ${if t.prop { "1" } else { "0" }} ${hex_field(t.skip)}\n")
  }
  let entry = run_entry(ctx, key)
  match os.fs.create_dir_all(dir_name(entry)) {
    Ok(_) => {}
    Err(_) => return
  }
  let tag = os.rand.bytes(6).to_hex()
  // the binary first: a manifest is never seen without it
  let tb = "${entry}.bin.tmp-${tag}"
  match os.fs.copy(bin, tb) {
    Ok(_) => {}
    Err(_) => {
      os.fs.remove(tb).ignore_err("a failed store")
      return
    }
  }
  match os.fs.rename(tb, "${entry}.bin") {
    Ok(_) => {}
    Err(_) => {
      os.fs.remove(tb).ignore_err("another process stored it")
      return
    }
  }
  let tm = "${entry}.m.tmp-${tag}"
  match os.fs.write(tm, b.freeze().bytes()) {
    Ok(_) => {
      match os.fs.rename(tm, "${entry}.m") {
        Ok(_) => {}
        Err(_) => os.fs.remove(tm).ignore_err("another process stored it")
      }
    }
    Err(_) => os.fs.remove(tm).ignore_err("a failed store")
  }
  prune_bins(os, ctx)
}
