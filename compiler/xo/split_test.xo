// Tests of the LLVM IR split (split.xo).

test "a split part that defines a function with a personality declares the personality" {
  // the result type holds a `(` inside a quoted name, which once made the
  // scan of the define line read its quotes the wrong way round and miss
  // `personality ptr @pers`: that part had no declaration of it
  let ir = "target triple = \"arm64-apple-macosx\"\n\ndefine hidden i64 @pers(i64 %a0) #1 {\n  ret i64 0\n}\n\ndefine hidden %\"e.Result[(), Error]\" @\"x.main.main\"(i64 %v0) #1 personality ptr @pers {\n  %v1 = add i64 %v0, 1\n  %v2 = add i64 %v1, 2\n  ret i64 %v2\n}\n"
  let parts = split_ir(ir, 2, false, false)
  expect(parts.len()) == 2
  for p in parts {
    if p.contains("define hidden %\"e.Result") {
      expect(p.contains("declare hidden i64 @pers(")) == true
    }
  }
}

test "the unroll iteration cap goes only to a clang that knows it" {
  expect(unroll_cap_ok(18, 0)) == false
  expect(unroll_cap_ok(19, 0)) == true
  expect(unroll_cap_ok(0, 16)) == false
  expect(unroll_cap_ok(0, 17)) == true
  expect(unroll_cap_ok(0, 0)) == true
  expect(parse_apple_major("Apple clang version 21.0.0 (clang-2100.3.34.2)\nTarget: arm64")) == 21
  expect(parse_apple_major("Ubuntu clang version 18.1.3 (1ubuntu1)")) == 0
  expect(parse_clang_major("Ubuntu clang version 18.1.3 (1ubuntu1)")) == 18
  expect(unroll_flags("-O2", "linux", "none", false)) == ["-mllvm", "-pragma-unroll-threshold=300"]
  expect(unroll_flags("-O2", "linux", "none", true).len()) == 4
}
