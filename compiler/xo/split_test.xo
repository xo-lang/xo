// Tests of the LLVM IR split (split.xo).

test "a split part that defines a function with a personality declares the personality" {
  // the result type holds a `(` inside a quoted name, which once made the
  // scan of the define line read its quotes the wrong way round and miss
  // `personality ptr @pers`: that part had no declaration of it
  let ir = "target triple = \"arm64-apple-macosx\"\n\ndefine hidden i64 @pers(i64 %a0) #1 {\n  ret i64 0\n}\n\ndefine hidden %\"e.Result[(), Error]\" @\"x.main.main\"(i64 %v0) #1 personality ptr @pers {\n  %v1 = add i64 %v0, 1\n  %v2 = add i64 %v1, 2\n  ret i64 %v2\n}\n"
  let parts = split_ir(ir, 2, false, false)
  expect(parts.len()) == 2
  for p in parts {
    if p.contains("define hidden %\"e.Result") {
      expect(p.contains("declare hidden i64 @pers(")) == true
    }
  }
}

test "the unroll iteration cap goes only to a clang that knows it" {
  expect(unroll_cap_ok(18, 0)) == false
  expect(unroll_cap_ok(19, 0)) == true
  expect(unroll_cap_ok(0, 16)) == false
  expect(unroll_cap_ok(0, 17)) == true
  expect(unroll_cap_ok(0, 0)) == true
  expect(parse_apple_major("Apple clang version 21.0.0 (clang-2100.3.34.2)\nTarget: arm64")) == 21
  expect(parse_apple_major("Ubuntu clang version 18.1.3 (1ubuntu1)")) == 0
  expect(parse_clang_major("Ubuntu clang version 18.1.3 (1ubuntu1)")) == 18
  expect(unroll_flags("-O2", "linux", "none", false)) == ["-mllvm", "-pragma-unroll-threshold=300"]
  expect(unroll_flags("-O2", "linux", "none", true).len()) == 4
}

test "a module with a giant function compiles without the AArch64 machine combiner" {
  var big = StrBuilder.new()
  big.write("define hidden void @\"x.main\"() {\n")
  for i in 0..GIANT_FN_BLOCKS + 1 {
    big.write("b${i}:\n  br label %b${i + 1}\n")
  }
  big.write("b${GIANT_FN_BLOCKS + 1}:\n")
  big.write("  ret void\n}\n")
  let small = "define hidden i64 @f() {\n  ret i64 0\n}\n"
  expect(ir_has_giant_fn(small + big.freeze())) == true
  // blocks in several smaller functions do not add up, and a long
  // function of few blocks is no giant
  var long = StrBuilder.new()
  long.write("define hidden void @g() {\n")
  for i in 0..GIANT_FN_BLOCKS * 4 {
    long.write("  %v${i} = add i64 0, ${i}\n")
  }
  long.write("  ret void\n}\n")
  expect(ir_has_giant_fn(small + small + long.freeze())) == false
  expect(giant_fn_flags("darwin", "arm64", "none")) == ["-mllvm", "-aarch64-enable-mcr=false"]
  expect(giant_fn_flags("darwin", "arm64", "thin")) == ["-mllvm", "-aarch64-enable-mcr=false", "-Wl,-mllvm,-aarch64-enable-mcr=false"]
  expect(giant_fn_flags("linux", "arm64", "full")) == ["-mllvm", "-aarch64-enable-mcr=false", "-Wl,-plugin-opt=-aarch64-enable-mcr=false"]
  expect(giant_fn_flags("linux", "amd64", "none")) == []
}

test "a -O0 build's constant time functions go to a module of their own (decision 0619)" {
  let ir = "target triple = \"arm64-apple-macosx\"\n\ndefine internal i64 @\"x.ct.pick\"(i64 %v0) #1 {\n  ret i64 %v0\n}\n\ndefine hidden i64 @\"x.main.main\"(i64 %v0) #1 {\n  %v1 = call i64 @\"x.ct.pick\"(i64 %v0)\n  ret i64 %v1\n}\n"
  let parts = ct_split(ir)
  expect(parts.len()) == 2
  expect(has_ct_def(parts[0])) == false
  expect(has_ct_def(parts[1])) == true
  // the main module calls pick by a declaration; pick is no longer internal
  expect(parts[0].contains("declare")) == true
  expect(parts[1].contains("define hidden i64 @\"x.ct.pick\"")) == true
  // no constant time function: one module
  expect(ct_split("define hidden i64 @\"x.main.main\"() #1 {\n  ret i64 0\n}\n").len()) == 1
  expect(ct_def("@\"x.rsa.pkcs1_unpad\"")) == true
  expect(ct_def("@\"x.rsakit.f\"")) == false
}

test "a split module compiles with a cross build's architecture, ABI and CPU" {
  // riscv64's flags (llvm_cross_flags): a module compiled without them took
  // a host clang.cfg's -mcpu=generic, which clang refuses for riscv64
  let flags = ["--target=riscv64-linux-gnu", "--sysroot=/s", "-fuse-ld=lld", "-march=rv64gc", "-mabi=lp64d", "-mcpu=generic-rv64", "-mllvm", "-x=1", "-O2"]
  expect(split_compile_flags(flags)) == ["--target=riscv64-linux-gnu", "-march=rv64gc", "-mabi=lp64d", "-mcpu=generic-rv64", "-mllvm", "-x=1"]
  expect(split_compile_flags(["-fsanitize=thread", "-fuse-ld=lld"])) == ["-fsanitize=thread"]
}

test "riscv64 IR states its floating point ABI as a module flag, which every split module keeps" {
  let ir = "define hidden i64 @a() #1 {\n  ret i64 0\n}\n!llvm.module.flags = !{!1000009, !1000010}\n!1000009 = !{i32 7, !\"Dwarf Version\", i32 5}\n!1000010 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
  let out = with_target_abi(ir, "lp64d")
  expect(out.contains("!llvm.module.flags = !{!1000009, !1000010, !1000011}")) == true
  expect(out.contains("!1000011 = !{i32 1, !\"target-abi\", !\"lp64d\"}")) == true
  let bare = with_target_abi("define hidden i64 @a() #1 {\n  ret i64 0\n}\n", "lp64d")
  expect(bare.contains("!llvm.module.flags = !{!1}\n!1 = !{i32 1, !\"target-abi\", !\"lp64d\"}")) == true
}

test "arm64 -O0 compiles of IR use SelectionDAG, as -O1 and up" {
  // GlobalISel (clang's arm64 -O0 default) and SelectionDAG lower a large
  // aggregate argument differently: a -O0 module calling a -O2 one (a
  // test build's module with a constant time function) passed the wrong
  // value (gotchas/llvm-globalisel-aggregate-args.md)
  expect(isel_flags("-O0", "arm64")) == ["-fno-global-isel"]
  expect(isel_flags("-O2", "arm64")) == []
  expect(isel_flags("-O0", "amd64")) == []
  let c = SplitConfig{opt: "-O0", lto: "none", arch: "arm64"}
  let o0 = module_args("-O0", c, [], [])
  expect(o0.contains("-fno-global-isel")) == true
  expect(module_args("-O2", c, [], []).contains("-fno-global-isel")) == false
  expect(module_args("-O0", SplitConfig{opt: "-O0", lto: "none", arch: "amd64"}, [], []).contains("-fno-global-isel")) == false
}
