// `xo run --watch` (decision 0267): build and run the program, then
// watch its module's sources; after a change, rebuild and restart the
// program only when the built binary changed (a test-only edit, a
// comment, or a file the build does not read leaves it running). A
// restart is a graceful handoff: SIGTERM, up to --grace for the program
// to exit, then SIGKILL, then the new binary. A failed build keeps the
// old program running. Each cycle builds in a child `xo build` (a build
// that fails exits its process); the on-disk caches keep it fast.
// --json prints one object a cycle, also written to last.json in the
// watch's cache directory (watch_dir), which also holds the builds: the
// watch writes nothing into the project. A stop request (SIGINT, SIGTERM;
// core 7.5) stops the program as a restart would and ends the watch.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/cli/semantic
use github.com/xo-lang/xo/compiler/parser
use std/crypto
use std/task

/// The files a cycle compares: path to "size:modified".
struct Snapshot {
  stamps: Map[Str, Str] = {}
  hashes: Map[Str, Str] = {}
}

/// Whether the watcher looks at path: the sources and module files of
/// the module tree, not its caches, test data, or dot directories.
fn watched_path(rel: Str) -> Bool {
  for part in rel.split("/") {
    if part.starts_with(".") || part == "testdata" {
      return false
    }
  }
  let base = rel.split("/").last() ?? rel
  base.ends_with(".xo") || base.ends_with(".c") || base.ends_with(".h") || base is "xo.mod" | "xo.lock" | "xo.work" | "xo.work.lock"
}

/// Moves the built binary next over bin; the reason it could not, or "".
fn install(fs: Fs, next: Str, bin: Str) -> Str uses (fs.read, fs.write) {
  match fs.rename(next, bin) {
    Ok(_) => {}
    Err(e) => return "xo run --watch: install ${bin}: ${e}\n"
  }
  // the debug information beside the binary under its name (NAME.dSYM),
  // where lldb and the symbolizer look
  fs.remove_all("${bin}.dSYM").ignore_err("an old one may not exist")
  if fs.exists("${next}.dSYM").ok() ?? false {
    fs.rename("${next}.dSYM", "${bin}.dSYM").ignore_err("only the debugger's view of the frames")
  }
  ""
}

/// The cache directory of a watch of the module at root:
/// <user cache>/xo/watch/<hash of root>, holding its builds and
/// last.json, so a watch writes nothing into the project.
fn watch_dir(os: Os, root: Str) -> Str {
  "${user_cache_dir(os, host_os(os))}/xo/watch/${crypto.sha256(root.bytes()).to_hex()[0..16]}"
}

/// The watched files under root and their size and modified time;
/// without tests, no _test.xo file (a build reads none, decision 0348).
fn snapshot(os: Os, root: Str, tests: Bool) -> Map[Str, Str] {
  var out: Map[Str, Str] = {}
  // xo:allow XO0903 an empty snapshot looks like a change: one extra rebuild
  let all = os.fs.walk(root).ok() ?? []
  for fi in all {
    if fi.is_dir {
      continue
    }
    let rel = fi.path.trim_prefix(root + "/")
    if watched_path(rel) && (tests || !rel.ends_with("_test.xo")) {
      out[fi.path] = "${fi.size}:${fi.modified.unix_millis()}"
    }
  }
  // the files embed constants name (decision 0304): the program changes
  // with them
  var dirs: List[Str] = []
  for (p, _) in out.entries() {
    if p.ends_with(".xo") {
      for d in embed_watch_dirs(os, p) {
        dirs.push(d)
      }
    }
  }
  for fi in all {
    if fi.is_dir || out.contains(fi.path) {
      continue
    }
    if dirs.any(fn(d) { fi.path == d || fi.path.starts_with("${d}/") }) {
      out[fi.path] = "${fi.size}:${fi.modified.unix_millis()}"
    }
  }
  out
}

/// The paths a .xo file's `embed("...")` patterns name, for watching: a
/// plain path itself, or a glob's leading directory (its segments before
/// the first with a `*`, `?`, or `[`). A text scan, not a check: watching
/// a little more than is embedded only rebuilds once more.
fn embed_watch_dirs(os: Os, file: Str) -> List[Str] {
  // xo:allow XO0903 a file it cannot read adds no embedded paths; the build reports the error
  let src = (os.fs.read(file).ok() ?? b"").to_str() ?? ""
  let dir = dir_name(file)
  var out: List[Str] = []
  var rest = src
  while let Some(i) = rest.find("embed(\"") {
    rest = rest[i + 7..]
    let j = rest.find("\"") ?? -1
    if j < 0 {
      break
    }
    var pat = rest[0..j].trim_prefix("all:")
    var keep: List[Str] = []
    for seg in pat.split("/") {
      if seg.contains("*") || seg.contains("?") || seg.contains("[") {
        break
      }
      keep.push(seg)
    }
    if !keep.is_empty() && !keep.any(fn(s) { s == ".." }) {
      out.push("${dir}/${keep.join("/")}")
    } else if keep.is_empty() {
      out.push(dir)
    }
  }
  out
}

/// The files whose stamp differs between old and now (added, removed,
/// or changed), sorted.
fn stamp_changes(old: Map[Str, Str], now: Map[Str, Str]) -> List[Str] {
  var out: List[Str] = []
  for (p, s) in now {
    if old.get(p) != Some(s) {
      out.push(p)
    }
  }
  for (p, _) in old {
    if !now.contains(p) {
      out.push(p)
    }
  }
  out.sort()
}

/// The flags of the `xo run` command line a cycle's `xo build` takes:
/// every flag before the directory, but --watch and --grace.
fn build_flags(args: List[Str]) -> List[Str] {
  let vals = value_flags()
  var out: List[Str] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "--" || !a.starts_with("-") || a == "-" {
      break
    }
    let name = a.trim_prefix("-").trim_prefix("-").split("=")[0]
    let takes = !a.contains("=") && vals.contains(name) && i + 1 < args.len()
    if !(name is "watch" | "grace") {
      out.push(a)
      if takes {
        out.push(args[i + 1])
      }
    }
    i += if takes { 2 } else { 1 }
  }
  out
}

/// The outcome of a cycle's build: its status and its output (the
/// diagnostics; with --json the build's JSON result).
struct Built {
  ok: Bool
  out: Str
}

fn build_once(os: Os, o: Opts, xo_bin: Str, flags: List[Str], out: Str) -> Built {
  var words = ["build"] + flags + ["-o", out]
  if o.json {
    words.push("--json")
  }
  words.push(o.dirs[0])
  let cmd = os.proc.cmd(xo_bin, words).dir(o.wd).set_env("PWD", o.wd).set_env("XO_STD", o.std)
  match cmd.output() {
    Ok(r) => {
      let text = (r.stdout.to_str() ?? "") + (r.stderr.to_str() ?? "")
      Built{ok: r.code == 0, out: text}
    }
    Err(e) => Built{ok: false, out: "${e}"}
  }
}

/// A running program: its process and the channel its waiter sends the
/// exit status on.
struct Running {
  child: Child
  done: Chan[Int]
}

/// Starts bin with the program's arguments on xo's own streams.
fn start_prog(os: Os, o: Opts, bin: Str) -> Running? {
  match os.proc.cmd(bin, o.prog_args).dir(o.wd).inherit().spawn() {
    Ok(ch) => Some(Running{child: ch, done: Chan[Int].new(cap: 1)})
    Err(e) => {
      os.stdio.eprintln("xo run --watch: start ${bin}: ${e}")
      None
    }
  }
}

/// Stops r: SIGTERM, up to grace for it to exit, then SIGKILL. Its
/// status, or -1 when it was killed.
fn stop_prog(os: Os, r: Running, grace: Duration) -> Int {
  os.proc.kill(r.child.pid(), "TERM").ignore_err("it may have exited already")
  select {
    c = r.done.recv() => c ?? -1
    after grace => {
      r.child.kill()
      let _ = r.done.recv()
      -1
    }
  }
}

/// One cycle's report, as text on standard error or a JSON object on
/// standard output (and in last.json).
struct Cycle {
  n: Int
  changed: List[Str] = []
  build: Str = ""
  output: Str = ""
  restarted: Bool = false
  pid: Int = 0
  exited: Int = -2
}

fn cycle_json(c: Cycle) -> Str {
  var b = StrBuilder.new()
  b.write("{\"cycle\":${c.n},\"changed\":[")
  for (i, p) in c.changed.indexed() {
    if i > 0 {
      b.write(",")
    }
    b.write(json_str(p))
  }
  b.write("],\"build\":${json_str(c.build)},\"output\":${json_str(c.output)},\"restarted\":${c.restarted},\"pid\":${c.pid}")
  if c.exited != -2 {
    b.write(",\"exited\":${c.exited}")
  }
  b.write("}")
  b.freeze()
}

fn report(os: Os, o: Opts, dir: Str, c: Cycle) {
  let j = cycle_json(c)
  os.fs.write("${dir}/last.json", (j + "\n").bytes()).ignore_err("last.json is a convenience")
  if o.json {
    os.stdio.println(j)
    return
  }
  if c.build == "exited" {
    os.stdio.eprintln("xo run --watch: the program exited with status ${c.exited}; waiting for changes")
    return
  }
  if !c.output.is_empty() {
    os.stdio.eprint(c.output)
  }
  let what = match c.build {
    "failed" => "build failed; the running program is unchanged"
    "unchanged" => "the program did not change; not restarted"
    _ => if c.restarted { "rebuilt; restarted (pid ${c.pid})" } else { "rebuilt" }
  }
  os.stdio.eprintln("xo run --watch: ${what}")
}

/// `xo run --watch`: its exit status (only on a setup failure; it runs
/// until interrupted).
fn watch_run(os: Os, o: Opts, args: List[Str]) -> Int {
  let xo_bin = check.executable(os.env, os.fs)
  let root = abs_path(o.wd, line_root(os, o.wd, o.dirs[0]))
  let dir = watch_dir(os, root)
  for d in ["${dir}/build", "${dir}/run"] {
    match os.fs.create_dir_all(d) {
      Ok(_) => {}
      Err(e) => {
        os.stdio.eprintln("xo run --watch: ${d}: ${e}")
        return 1
      }
    }
  }
  // the program's own name (ps, crash reports), built in build/ and
  // moved to run/ with its NAME.dSYM
  let name = prog_name(o.wd, o.dirs)
  let bin = "${dir}/run/${name}"
  let next = "${dir}/build/${name}"
  let flags = build_flags(args)
  var n = 0
  var running: Running? = None
  var bin_hash = ""
  var seen = snapshot(os, root, false)
  // the first build; without it there is nothing to run until a change
  var pending = true
  var changed: List[Str] = []
  while true {
    if pending {
      pending = false
      n += 1
      var c = Cycle{n: n, changed: changed}
      let b = build_once(os, o, xo_bin, flags, next)
      c.output = b.out
      if !b.ok {
        c.build = "failed"
      } else if sha_of(os, next) == bin_hash && running.is_some() {
        c.build = "unchanged"
      } else {
        c.build = "rebuilt"
        if let Some(r) = running {
          let _ = stop_prog(os, r, o.grace)
          running = None
        }
        let why = install(os.fs, next, bin)
        if !why.is_empty() {
          // the old binary would start again and the cycle say "rebuilt":
          // report it, and the next change rebuilds and installs again
          c.build = "failed"
          c.output = c.output + why
          report(os, o, dir, c)
          changed = []
          continue
        }
        bin_hash = sha_of(os, bin)
        running = start_prog(os, o, bin)
        if let Some(r) = running {
          c.restarted = n > 1
          c.pid = r.child.pid()
          let waiter_child = r.child
          let waiter_done = r.done
          let _w = os.tasks.spawn_background(fn() {
            // xo:allow XO0903 a program that cannot be waited for is reported as exit -1
            let code = waiter_child.wait().ok() ?? -1
            let _ = waiter_done.try_send(code)
          })
        }
      }
      report(os, o, dir, c)
      changed = []
    }
    // a tick: the program's exit, or 200 ms, then the sources
    let done = match running {
      Some(r) => r.done
      None => Chan[Int].new(cap: 1)
    }
    select {
      code = done.recv() => {
        running = None
        n += 1
        report(os, o, dir, Cycle{n: n, build: "exited", exited: code ?? -1})
      }
      _s = task.stopping().recv() => {
        if let Some(r) = running {
          let _ = stop_prog(os, r, o.grace)
        }
        return 0
      }
      after 200ms => {}
    }
    let now = snapshot(os, root, false)
    var diff = stamp_changes(seen, now)
    if diff.is_empty() {
      continue
    }
    // debounce: wait until the tree holds still for 100 ms
    var cur = now
    while true {
      os.clock.sleep(100ms)
      let again = snapshot(os, root, false)
      if stamp_changes(cur, again).is_empty() {
        break
      }
      cur = again
    }
    diff = stamp_changes(seen, cur)
    seen = cur
    changed = diff
    pending = true
  }
  0
}

// `xo test --watch` (decision 0267): run the tests, then after each
// change only the tests the change reaches: a test whose own text
// changed or that is new, every test of a changed _test.xo file, and a
// test that names a definition whose hash changed (semantic.module_defs:
// a definition's hash covers the definitions of its module it uses, so
// an edit deep in a call chain changes the hash of every function
// above it). A test reaches the definitions it names (an identifier of
// its text matching a definition's name or method name), so the set errs
// toward rerunning. A change to a module file (xo.mod, xo.lock) reruns
// every test, as does `a` and Enter.

/// A test block: where it is, its name, its text's hash, and the words
/// of its text.
struct TestBlock {
  file: Str
  name: Str
  hash: Str
  words: Map[Str, Bool] = {}
}

/// What a cycle compares: each definition's hash by key, its name, and
/// the test blocks.
struct TestState {
  defs: Map[Str, Str] = {}
  names: Map[Str, Str] = {}
  tests: List[TestBlock] = []
}

fn is_word_byte(c: Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

/// The identifiers of text (runs of letters, digits, and underscores).
fn words_of(text: Bytes) -> Map[Str, Bool] {
  var out: Map[Str, Bool] = {}
  var i = 0
  let n = text.len()
  while i < n {
    if !is_word_byte(Int(text[i])) {
      i += 1
      continue
    }
    var j = i
    while j < n && is_word_byte(Int(text[j])) {
      j += 1
    }
    out[(text[i..j]).to_str() ?? ""] = true
    i = j
  }
  out
}

fn lit_text(l: parser.StringLit) -> Str {
  var b = StrBuilder.new()
  for p in l.parts {
    b.write(p.text.to_str() ?? "")
  }
  b.freeze()
}

fn test_state(os: Os, root: Str) -> TestState {
  var st = TestState{}
  for d in semantic.module_defs(os.fs, root, "watch").ok() ?? [] {
    st.defs[d.key] = d.hash
    st.names[d.key] = d.name
  }
  // xo:allow XO0903 a walk it cannot do reruns every test: no stale result
  for fi in os.fs.walk(root).ok() ?? [] {
    let rel = fi.path.trim_prefix(root + "/")
    if fi.is_dir || !rel.ends_with(".xo") || !watched_path(rel) {
      continue
    }
    // xo:allow XO0903 an unreadable file reruns its tests: no stale result
    let src = os.fs.read(fi.path).ok() ?? "".bytes()
    let r = parser.parse_file(fi.path.bytes(), src, false)
    for d in r.file.decls {
      if let TestDecl(d: td) = d {
        let text = src[td.span.start.offset..td.span.end.offset]
        let name = match td.name {
          Some(l) => lit_text(l)
          None => ""
        }
        st.tests.push(TestBlock{file: fi.path, name: name, hash: crypto.sha256(text).to_hex(), words: words_of(text)})
      }
    }
  }
  st
}

/// The tests of now a change from before reaches (see above); all of
/// them when all.
fn affected(before: TestState, now: TestState, changed: List[Str], all: Bool) -> List[Str] {
  var run: Map[Str, Bool] = {}
  var every = all || changed.any(fn(p) { !p.ends_with(".xo") })
  // the names of the definitions whose hash changed, appeared, or went
  var moved: Map[Str, Bool] = {}
  for (k, h) in now.defs {
    if before.defs.get(k) != Some(h) {
      moved[now.names.get(k) ?? ""] = true
    }
  }
  for (k, _) in before.defs {
    if !now.defs.contains(k) {
      moved[before.names.get(k) ?? ""] = true
    }
  }
  var old: Map[Str, Bool] = {}
  for t in before.tests {
    old["${t.file}\n${t.name}\n${t.hash}"] = true
  }
  for t in now.tests {
    var hit = every || !old.contains("${t.file}\n${t.name}\n${t.hash}")
    hit = hit || (t.file.ends_with("_test.xo") && changed.contains(t.file))
    if !hit {
      for (name, _) in moved {
        let last = name.split(".").last() ?? name
        if t.words.contains(last) {
          hit = true
          break
        }
      }
    }
    if hit {
      run[t.name] = true
    }
  }
  var out: List[Str] = []
  for (name, _) in run {
    out.push(name)
  }
  out.sort()
}

/// One test cycle's report.
struct TestCycle {
  n: Int
  changed: List[Str] = []
  ran: List[Str] = []
  unaffected: Int = 0
  status: Int = 0
  results: List[Str] = []
}

fn test_cycle_json(c: TestCycle) -> Str {
  let strs = fn(xs: List[Str]) -> Str { "[" + xs.map(fn(x: Str) { json_str(x) }).join(",") + "]" }
  "{\"cycle\":${c.n},\"changed\":${strs(c.changed)},\"ran\":${strs(c.ran)},\"unaffected\":${c.unaffected},\"status\":${c.status},\"results\":[${c.results.join(",")}]}"
}

/// Runs the selected tests (all when only is None) in a child xo test;
/// its status and, with --json, its result lines.
fn run_test_child(os: Os, o: Opts, xo_bin: Str, flags: List[Str], only: List[Str]?) -> (Int, List[Str]) {
  var words = ["test"] + flags + (if o.json { ["--json"] } else { [] }) + dir_words(o)
  var cmd = os.proc.cmd(xo_bin, words).dir(o.wd).set_env("PWD", o.wd).set_env("XO_STD", o.std)
  if let Some(names) = only {
    cmd = cmd.set_env("XO_TEST_ONLY", names.join("\n"))
  }
  if !o.json {
    // xo:allow XO0903 a command that cannot run is reported as exit 1
    return (cmd.inherit().run().ok() ?? 1, [])
  }
  match cmd.output() {
    Ok(r) => {
      var lines: List[Str] = []
      for l in (r.stdout.to_str() ?? "").split("\n") {
        if l.starts_with("{") {
          lines.push(l)
        }
      }
      if r.code != 0 && lines.is_empty() {
        // the build failed: its diagnostics
        lines.push("{\"output\":${json_str((r.stdout.to_str() ?? "") + (r.stderr.to_str() ?? ""))}}")
      }
      (r.code, lines)
    }
    Err(e) => (1, ["{\"output\":${json_str("${e}")}}"])
  }
}

/// `xo test --watch`: runs until a stop request.
fn watch_test(os: Os, o: Opts, args: List[Str]) -> Int {
  let xo_bin = check.executable(os.env, os.fs)
  let root = abs_path(o.wd, line_root(os, o.wd, o.dirs[0]))
  let dir = watch_dir(os, root)
  os.fs.create_dir_all(dir).ignore_err("last.json is a convenience")
  let flags = build_flags(args)
  // lines typed on standard input: `a` (or `all`) reruns every test
  let typed = Chan[Str].new(cap: 16)
  let _r = os.tasks.spawn_background(fn() {
    while true {
      match os.stdio.read_line() {
        Ok(Some(l)) => {
          let _ = typed.try_send(l.trim())
        }
        _ => break
      }
    }
  })
  var seen = snapshot(os, root, true)
  var state = test_state(os, root)
  var n = 0
  var pending = true
  var all = true
  var changed: List[Str] = []
  while true {
    if pending {
      pending = false
      n += 1
      var c = TestCycle{n: n, changed: changed}
      var only: List[Str]? = None
      let now = test_state(os, root)
      if !all {
        let names = affected(state, now, changed, false)
        c.unaffected = now.tests.len() - names.len()
        only = Some(names)
        c.ran = names
      } else {
        c.ran = now.tests.map(fn(t: TestBlock) { t.name })
      }
      state = now
      let none = match only {
        Some(ns) => ns.is_empty()
        None => false
      }
      if !none {
        let (code, lines) = run_test_child(os, o, xo_bin, flags, only)
        c.status = code
        c.results = lines
      }
      let j = test_cycle_json(c)
      os.fs.write("${dir}/last.json", (j + "\n").bytes()).ignore_err("last.json is a convenience")
      if o.json {
        os.stdio.println(j)
      } else {
        os.stdio.eprintln("xo test --watch: ran ${c.ran.len()} test(s), ${c.unaffected} unaffected; `a` and Enter runs all")
      }
      all = false
      changed = []
    }
    select {
      l = typed.recv() => {
        if (l ?? "") is "a" | "all" {
          all = true
          pending = true
        }
      }
      _s = task.stopping().recv() => return 0
      after 200ms => {}
    }
    if pending {
      continue
    }
    let now = snapshot(os, root, true)
    if stamp_changes(seen, now).is_empty() {
      continue
    }
    var cur = now
    while true {
      os.clock.sleep(100ms)
      let again = snapshot(os, root, true)
      if stamp_changes(cur, again).is_empty() {
        break
      }
      cur = again
    }
    changed = stamp_changes(seen, cur)
    seen = cur
    pending = true
  }
  0
}
