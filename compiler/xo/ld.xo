// --ld=macho (decision 0182): the link without a C compiler. compiler/macho
// links the program's objects (assembled by compiler/macho; no C runtime
// since decision 0234, so no pack's rt.o) into a signed executable (the
// Security framework is loaded at run time, std/native/llrt/tlscert.xo);
// for
// linux/arm64 (stage 3) into an ELF executable that imports glibc.

use github.com/xo-lang/xo/compiler/macho
use github.com/xo-lang/xo/compiler/prune
use std/crypto
use github.com/xo-lang/xo/compiler/tzsel
use std/task

/// Links prog (an object) into out for tgoos; "" on success, else why
/// not. strip leaves the local symbols out (`-s`); release keeps the
/// local function symbols only (`--release`, LinkOpts.release); nolibc: a
/// Linux
/// program with no C library, linked static (decision 0243); race_rt:
/// for --race (decision 0273 part 3), ThreadSanitizer's runtime, a dylib
/// the executable loads by that path ("" for none); dsym: also write
/// out.dSYM (--dsym; the executable carries its DWARF, decision 0346).
fn macho_link(os: Os, ctx: Ctx, tgoos: Str, flags: List[Str], srcs: List[Str], out: Str, strip: Bool, nolibc: Bool, race_rt: Str, dsym: Bool, split: Bool, release: Bool) -> Str {
  if tgoos == "linux" {
    if !race_rt.is_empty() && nolibc {
      return "--race links with the C library (ThreadSanitizer's runtime needs it): not with XO_NOLIBC=1"
    }
    // --race: ThreadSanitizer's static archive, whole (its __tsan_init
    // in a .preinit_array no symbol reaches, decision 0273 part 3)
    return elf_link(os, ctx, flags, srcs, out, nolibc, strip, race_rt, split, release)
  }
  let (objs, bad) = ld_objects(srcs)
  if !bad.is_empty() {
    return bad
  }
  let _f = flags
  // decision 0388 stage 4's indexed store, before the std object builder
  // makes one: XO_STD_STORE=PATH on an XO_STD_ROOTS=1 build packs the
  // build's parts (prog-darwin.N.o) into the store at PATH when it is not
  // there, else links through it without reading them
  let store_path = if tgoos == "darwin" { os.env.get("XO_STD_STORE") ?? "" } else { "" }
  var store = "".bytes()
  if !store_path.is_empty() {
    match os.fs.read(store_path) {
      Ok(b) => store = b
      Err(_) => {}
    }
  }
  // decision 0388 stage 3: a separately compiled program links through
  // std's store (XO_SEPCOMP_STORE=PATH, xo dev stdobj's std.store):
  // every input is the program's, kept whole, and std is read from PATH
  let sep_store = if tgoos == "darwin" && store_path.is_empty() { ctx.sep_store } else { "" }
  let tr = os.clock.now()
  if !sep_store.is_empty() {
    // mapped, not copied (decision 0402): the link touches only the live
    // atoms' pages; the store is only ever replaced by rename (stdcache.xo)
    match read_mapped(ctx.real_fs ?? os.fs, sep_store) {
      Ok(b) => store = b
      Err(e) => return "XO_SEPCOMP_STORE=${sep_store}: ${fs_reason(e)}"
    }
    let _r = lap(os, ctx.phases, "link.read_store", tr)
  }
  // the program's objects read and the link's options (link.inputs)
  let tin = os.clock.now()
  let store_check = !store_path.is_empty() && !store.is_empty() && (os.env.get("XO_STD_STORE_CHECK") ?? "") == "1"
  var ins: List[macho.LinkInput] = []
  var parts: List[macho.LinkInput] = []
  for p in objs {
    let part = !store_path.is_empty() && base_name(p).starts_with("prog-darwin.") && p.ends_with(".o")
    if part && !store.is_empty() && !store_check {
      continue
    }
    match os.fs.read(p) {
      Ok(b) => if part { parts.push(macho.LinkInput{path: p, data: b}) } else { ins.push(macho.LinkInput{path: p, data: b}) }
      Err(e) => return "${p}: ${e}"
    }
  }
  if !store_path.is_empty() && store.is_empty() {
    match macho.store_encode(parts) {
      Ok(b) => {
        match os.fs.write(store_path, b) {
          Ok(_) => {}
          Err(e) => return "XO_STD_STORE=${store_path}: ${fs_reason(e)}"
        }
      }
      Err(e) => return "XO_STD_STORE=${store_path}: ${e}"
    }
  }
  var dylibs = ["/usr/lib/libSystem.B.dylib"]
  var rpaths: List[Str] = []
  if !race_rt.is_empty() {
    // its interceptors (malloc, pthread_create, ...) take effect through
    // its __interpose section, whatever the lookup order. Loaded by
    // @rpath, found beside the executable first (a copy put there, as
    // Xcode embeds a sanitizer's runtime), then in the toolchain's race
    // directory: a binary that loaded the toolchain's path outlived
    // neither a move nor a removal of the toolchain (field report on
    // 0.26.0, 2026-10-23)
    dylibs.push("@rpath/${base_name(race_rt)}")
    rpaths = ["@executable_path", dir_name(race_rt)]
    let cerr = race_rt_beside(os, race_rt, out)
    if !cerr.is_empty() {
      return cerr
    }
  }
  // --debug-info=split (decision 0355): no __DWARF in the program, its
  // DWARF in the dSYM
  // -s: no debug information either way (a separately compiled program's
  // std store carries DWARF the program's own build left out)
  if (os.env.get("XO_CACHE_STATS") ?? "") == "1" && !ctx.layout_order.is_empty() {
    os.stdio.eprintln("link: layout order of ${ctx.layout_order.len()} symbols, first ${ctx.layout_order[0]}")
  }
  // std's half (decision 0409) puts the program after std, so a layout
  // file's order across both (decision 0403) turns it off
  let opts = macho.LinkOpts{name: base_name(out), dylibs: dylibs, rpaths: rpaths, strip: strip, order: ctx.layout_order, embed_dwarf: !split && !strip, dsym: (dsym || split) && !strip, release: release, program_dwarf: !sep_store.is_empty(), std_parts: std_parts_dir(os, sep_store), prog_osos: prog_debug_objects(os, sep_store, ins), hash_pages: Some(par_page_hashes), split_prog: !sep_store.is_empty() && ctx.layout_order.is_empty() && (os.env.get("XO_STD_HALF") ?? "") != "off"}
  let _in = lap(os, ctx.phases, "link.inputs", tin)
  let ts = os.clock.now()
  let linked = if store.is_empty() { macho.link_debug(parts + ins, opts) } else { link_store_laps(os, ctx, ins, store, opts, prep_dir(os, sep_store)) }
  if !store.is_empty() {
    if !store_path.is_empty() {
      os.stdio.eprintln("store link ${os.clock.since(ts).nanos() / 1000} us (${store.len()} store bytes)")
    }
    // XO_STD_STORE_REPEAT=N: N more links, timed (a measurement)
    let rep = Int.parse(os.env.get("XO_STD_STORE_REPEAT") ?? "0") ?? 0
    // the store link's std half (decision 0409, on unless
    // XO_STD_HALF=off): each round reads it from the cache (the first
    // link wrote it) and links from it, checked against the first link
    let first = match linked {
      Ok((b, _)) => b
      Err(_) => b""
    }
    for _ in 0..rep {
      if opts.split_prog {
        let t1 = os.clock.now()
        let parsed = match macho.parse_link_inputs(ins) {
          Ok(x) => x
          Err(_) => continue
        }
        let hf = half_file_for(os, prep_file_for(os, prep_dir(os, sep_store), sep_store, store.len(), parsed, opts), opts)
        if let Some(h) = half_load(os, hf) {
          var s = macho.store_prepare_half(parsed, h, opts)
          let dp = os.clock.since(t1).nanos() / 1000
          let t2 = os.clock.now()
          let why = s.resolve_half(h)
          let dr = os.clock.since(t2).nanos() / 1000
          if !why.is_empty() {
            os.stdio.eprintln("half: ${why}")
            continue
          }
          let t3 = os.clock.now()
          let el = s.layout()
          if !el.is_empty() || !s.half_pins_ok(h) {
            os.stdio.eprintln("half: std's fixed sections moved")
            continue
          }
          let got = s.finish_after_layout()
          let df = os.clock.since(t3).nanos() / 1000
          let same = match got {
            Ok((b, _)) => if b == first { "equal" } else { "DIFFERS (${b.len()} and ${first.len()} bytes)" }
            Err(e) => "failed: ${e}"
          }
          os.stdio.eprintln("store link ${dp + dr + df} us (prepare ${dp}, resolve ${dr}, finish ${df}) half ${same}, std relocations kept ${h.kept} dropped ${h.dropped}")
          continue
        }
        os.stdio.eprintln("half: none in the cache (${hf})")
      }
      // the steps timed: prepare (the walk, the live atoms read), resolve,
      // finish (layout, relocation, the image)
      let t1 = os.clock.now()
      let parsed = match macho.parse_link_inputs(ins) {
        Ok(x) => x
        Err(_) => continue
      }
      match macho.store_prepare_cached(parsed, store, opts, prep_load(os, prep_file_for(os, prep_dir(os, sep_store), sep_store, store.len(), parsed, opts))) {
        Ok(s0) => {
          var s = s0
          let dp = os.clock.since(t1).nanos() / 1000
          let t2 = os.clock.now()
          let _e = s.resolve()
          let dr = os.clock.since(t2).nanos() / 1000
          let t3 = os.clock.now()
          s.finish().ignore_err("a timing run: the first link reported")
          let df = os.clock.since(t3).nanos() / 1000
          os.stdio.eprintln("store link ${dp + dr + df} us (prepare ${dp}, resolve ${dr}, finish ${df})")
        }
        Err(_) => {}
      }
    }
  }
  if store_check {
    // the same link from the parts themselves: byte for byte
    let want = macho.link_debug(parts + ins, opts)
    match (linked, want) {
      (Ok((b1, d1)), Ok((b2, d2))) => if b1 != b2 || d1 != d2 {
        return "XO_STD_STORE_CHECK=1: the store's link differs from the parts' (${b1.len()} and ${b2.len()} bytes)"
      }
      _ => return "XO_STD_STORE_CHECK=1: one of the two links failed"
    }
    os.stdio.eprintln("store check: the store's link is the parts' byte for byte")
  }
  match linked {
    Ok((b, dsym)) => {
      // a new file, renamed over the old: the kernel caches the
      // signature of a file it ran
      let tw = os.clock.now()
      let werr = write_exe(os, out, b)
      let _w = lap(os, ctx.phases, "link.write_exe", tw)
      if !werr.is_empty() {
        return werr
      }
      if !dsym.is_empty() {
        // --dsym: the DWARF as a bundle too (decision 0239), for tools
        // that want one: PROG.dSYM/Contents/Resources/DWARF/PROG
        let dir = "${out}.dSYM/Contents/Resources/DWARF"
        match os.fs.create_dir_all(dir) {
          Ok(_) => {}
          Err(e) => return "cannot write the debug information to ${out}.dSYM: ${fs_reason(e)}"
        }
        match os.fs.write("${dir}/${base_name(out)}", dsym) {
          Ok(_) => {}
          Err(e) => return "cannot write the debug information to ${out}.dSYM: ${fs_reason(e)}"
        }
      }
      ""
    }
    Err(e) => "link: ${e}"
  }
}

/// clang's link flags for xo's ThreadSanitizer runtime race_rt in place
/// of clang's own (the LLVM backend's --race): darwin's dylib by @rpath,
/// beside the executable first, then race_rt's directory (race_rt_beside
/// puts the copy there); linux's static archive whole, its interceptors
/// exported as clang's own link does.
fn race_link_flags(tgoos: Str, race_rt: Str) -> List[Str] {
  if tgoos == "darwin" {
    return ["-fno-sanitize-link-runtime", race_rt, "-Wl,-rpath,@executable_path", "-Wl,-rpath,${dir_name(race_rt)}"]
  }
  ["-fno-sanitize-link-runtime", "-Wl,--whole-archive", race_rt, "-Wl,--no-whole-archive", "-rdynamic", "-lpthread", "-ldl", "-lm", "-lrt"]
}

/// Copies the darwin race runtime race_rt beside the executable out
/// (unless it is there already), which loads it by @rpath with
/// @executable_path first: "" or why not.
fn race_rt_beside(os: Os, race_rt: Str, out: Str) -> Str {
  let near = "${dir_name(out)}/${base_name(race_rt)}"
  if near == race_rt {
    return ""
  }
  match os.fs.read(race_rt) {
    Ok(data) => {
      // xo:allow XO0903 a copy that cannot be read is written again
      let same = match os.fs.read(near) {
        Ok(old) => old == data
        Err(_) => false
      }
      if same { "" } else { write_exe(os, near, data) }
    }
    Err(e) => "${race_rt}: ${e}"
  }
}

/// The targets a ThreadSanitizer runtime ships for (lib/xo/race/GOOS-ARCH/,
/// scripts/race-runtime.sh and release.sh) and its file there: the one
/// list race_runtime and the --race messages read.
fn race_files() -> List[(Str, Str)] {
  [("darwin/arm64", "libclang_rt.tsan_osx_dynamic.dylib"), ("darwin/amd64", "libclang_rt.tsan_osx_dynamic.dylib"), ("linux/arm64", "libclang_rt.tsan-aarch64.a"), ("linux/amd64", "libclang_rt.tsan-x86_64.a"), ("windows/amd64", "race_windows_amd64.syso")]
}

/// race_files' targets as prose: "darwin/arm64, ... and windows/amd64".
fn race_targets() -> Str {
  var ts: List[Str] = []
  for (t, _) in race_files() {
    ts.push(t)
  }
  "${ts[0..ts.len() - 1].join(", ")} and ${ts[ts.len() - 1]}"
}

/// ThreadSanitizer's runtime for a native --race executable of tgoos and
/// march (decision 0273 part 3), or why there is none: $XO_RACE_RUNTIME,
/// else race/GOOS-ARCH/ beside xo's std: a release's lib/xo/race (std in
/// lib/xo/std), a seed's or checkout's lib/xo/race (std in std/,
/// scripts/race-runtime.sh writes it there).
fn race_runtime(os: Os, ctx: Ctx, tgoos: Str, march: Str) -> (Str, Str) {
  let env = os.env.get("XO_RACE_RUNTIME") ?? ""
  if !env.is_empty() {
    return (env, "")
  }
  var file = ""
  for (t, f) in race_files() {
    if t == "${tgoos}/${march}" {
      file = f
    }
  }
  if file.is_empty() {
    return ("", "--race: no ThreadSanitizer runtime ships for ${tgoos}/${march} (${race_targets()} have one; XO_RACE_RUNTIME names one): use --backend=llvm")
  }
  let root = dir_name(ctx.std.trim_suffix("/"))
  let rel = "${tgoos}-${march}/${file}"
  for p in ["${root}/race/${rel}", "${root}/lib/xo/race/${rel}"] {
    // xo:allow XO0903 a candidate it cannot stat is skipped; the link reports a missing one
    if os.fs.exists(p).ok() ?? false {
      return (p, "")
    }
  }
  ("", "--race: no ThreadSanitizer runtime for ${tgoos}/${march} (${root}/lib/xo/race/${rel}; XO_RACE_RUNTIME names one): use --backend=llvm")
}

/// The objects a --ld=macho link takes from srcs, and why not ("" when
/// it can). srcs are the program's objects (one, or one per part of a
/// parallel generation, decision 0220), then objects (the zone data) and
/// C sources, which this linker cannot compile (an xo_rt.c is skipped: a
/// driver before decision 0234 listed it). Taking only srcs[0] as the
/// program dropped the later parts of a split program and read the
/// runtime's source as a C source to compile
/// (gotchas/macho-link-split-objects.md).
fn ld_objects(srcs: List[Str]) -> (List[Str], Str) {
  var objs: List[Str] = []
  for src in srcs {
    if base_name(src) == "xo_rt.c" {
      continue
    }
    if !src.ends_with(".o") && !src.ends_with(".a") {
      return ([], "--ld=macho links no C sources (${src}): link with cc")
    }
    objs.push(src)
  }
  (objs, "")
}

/// The ELF link of stage 3: the program's objects (and the zone data's)
/// into out, dynamically linked against glibc, or static with no C
/// library under XO_NOLIBC (decision 0243); "" on success, else why
/// not.
/// split (decision 0355): the DWARF and symbols in out.debug, which
/// out's .gnu_debuglink names, both with the same GNU build id.
fn elf_link(os: Os, ctx: Ctx, flags: List[Str], srcs: List[Str], out: Str, static: Bool, strip: Bool, whole: Str, split: Bool, release: Bool) -> Str {
  let (objs, bad) = ld_objects(srcs)
  if !bad.is_empty() {
    return bad
  }
  let _f = flags
  // decision 0388 stage 4's indexed store on ELF, as macho_link's:
  // XO_STD_STORE=PATH packs the parts (prog-linux.N.o) into it when it
  // is not there, else links through it; XO_STD_STORE_CHECK=1 also links
  // the parts and fails on a difference
  let store_path = os.env.get("XO_STD_STORE") ?? ""
  var store = "".bytes()
  if !store_path.is_empty() {
    match os.fs.read(store_path) {
      Ok(b) => store = b
      Err(_) => {}
    }
  }
  // a separately compiled program through std's store (as macho_link),
  // read only when the link needs its bytes: a link from std's half
  // (decision 0420) needs only its length, for the prepare key (the
  // store's read was about 3 ms of an HTTP edit's 18 ms link, 2026-10-30)
  var lazy = ""
  var store_n = 0
  if store_path.is_empty() && !ctx.sep_store.is_empty() {
    let sp = ctx.sep_store
    match os.fs.stat(sp) {
      Ok(Some(i)) => {
        lazy = sp
        store_n = i.size
      }
      Ok(None) => return "XO_SEPCOMP_STORE=${sp}: not found"
      Err(e) => return "XO_SEPCOMP_STORE=${sp}: ${fs_reason(e)}"
    }
  }
  let through = !store.is_empty() || !lazy.is_empty()
  if lazy.is_empty() {
    store_n = store.len()
  }
  let store_check = !store_path.is_empty() && !store.is_empty() && (os.env.get("XO_STD_STORE_CHECK") ?? "") == "1"
  var ins: List[macho.LinkInput] = []
  var parts: List[macho.LinkInput] = []
  for p in objs {
    let part = !store_path.is_empty() && base_name(p).starts_with("prog-linux.") && p.ends_with(".o")
    if part && !store.is_empty() && !store_check {
      continue
    }
    match os.fs.read(p) {
      Ok(b) => if part { parts.push(macho.LinkInput{path: p, data: b}) } else { ins.push(macho.LinkInput{path: p, data: b}) }
      Err(e) => return "${p}: ${e}"
    }
  }
  if !store_path.is_empty() && store.is_empty() {
    match macho.store_encode_elf(parts) {
      Ok(b) => {
        match os.fs.write(store_path, b) {
          Ok(_) => {}
          Err(e) => return "XO_STD_STORE=${store_path}: ${fs_reason(e)}"
        }
      }
      Err(e) => return "XO_STD_STORE=${store_path}: ${e}"
    }
  }
  if !whole.is_empty() {
    match os.fs.read(whole) {
      Ok(b) => ins.push(macho.LinkInput{path: whole, data: b, whole: true})
      Err(e) => return "${whole}: ${e}"
    }
  }
  let debug_link = if split { "${base_name(out)}.debug" } else { "" }
  // the program's own sections after std's, and std's half (decision
  // 0420), unless XO_STD_HALF=off
  let eopts = macho.ElfLinkOpts{static: static, strip: strip, debug_link: debug_link, release: release, split_prog: !ctx.sep_store.is_empty() && (os.env.get("XO_STD_HALF") ?? "") != "off"}
  let ts = os.clock.now()
  let linked = if !through { macho.link_elf_split(parts + ins, eopts) } else { elf_store_laps(os, ctx, ins, store, lazy, store_n, eopts) }
  if !store_path.is_empty() && !store.is_empty() {
    os.stdio.eprintln("store link ${os.clock.since(ts).nanos() / 1000} us (${store.len()} store bytes)")
  }
  if through {
    // XO_STD_STORE_REPEAT=N: N more links, timed (a measurement), each
    // checked against the first
    let rep = Int.parse(os.env.get("XO_STD_STORE_REPEAT") ?? "0") ?? 0
    let first = match linked {
      Ok((b, _)) => b
      Err(_) => b""
    }
    for _ in 0..rep {
      let t1 = os.clock.now()
      let prog = match macho.parse_elf_inputs(ins) {
        Ok(x) => x
        Err(e) => return e
      }
      let pf = elf_prep_file(os, ctx.sep_store, store_n, prog, eopts)
      if let Some(h) = elf_half_load(os, elf_half_file_for(pf, eopts)) {
        // the link from std's half, as elf_store_laps makes it
        var s = macho.elf_store_prepare_half(prog, h, eopts)
        let dp = os.clock.since(t1).nanos() / 1000
        let t2 = os.clock.now()
        let why = s.resolve_half(h)
        let dr = os.clock.since(t2).nanos() / 1000
        if !why.is_empty() {
          os.stdio.eprintln(why)
          continue
        }
        let t3 = os.clock.now()
        let _l = s.layout()
        if !s.half_pins_ok(h) {
          os.stdio.eprintln("half: std's fixed sections moved")
          continue
        }
        let got = s.write()
        let df = os.clock.since(t3).nanos() / 1000
        let same = match got {
          Ok((b, _)) => if b == first { "equal" } else { "DIFFERS" }
          Err(e) => "failed: ${e}"
        }
        os.stdio.eprintln("store link ${dp + dr + df} us (prepare ${dp}, resolve ${dr}, finish ${df}) half ${same}, std relocations kept ${h.kept} dropped ${h.dropped}")
        continue
      }
      if store.is_empty() {
        // mapped, as macho_link's (decision 0402)
        match read_mapped(ctx.real_fs ?? os.fs, lazy) {
          Ok(b) => store = b
          Err(e) => return "XO_SEPCOMP_STORE=${lazy}: ${fs_reason(e)}"
        }
      }
      match macho.elf_store_prepare(prog, store, eopts, prep_load(os, pf)) {
        Ok(s0) => {
          var s = s0
          let dp = os.clock.since(t1).nanos() / 1000
          let t2 = os.clock.now()
          let _e = s.resolve()
          let dr = os.clock.since(t2).nanos() / 1000
          let t3 = os.clock.now()
          let _l = s.layout()
          let got = s.write()
          let df = os.clock.since(t3).nanos() / 1000
          let same = match got {
            Ok((b, _)) => if b == first { "equal" } else { "DIFFERS" }
            Err(e) => "failed: ${e}"
          }
          os.stdio.eprintln("store link ${dp + dr + df} us (prepare ${dp}, resolve ${dr}, finish ${df}) ${same}")
        }
        Err(_) => {}
      }
    }
  }
  if store_check {
    match (linked, macho.link_elf_split(parts + ins, eopts)) {
      (Ok((b1, d1)), Ok((b2, d2))) => if b1 != b2 || d1 != d2 {
        // both kept beside the output, to compare
        os.fs.write("${store_path}.store-link", b1).ignore_err("only for comparing")
        os.fs.write("${store_path}.parts-link", b2).ignore_err("only for comparing")
        return "XO_STD_STORE_CHECK=1: the store's link differs from the parts' (${b1.len()} and ${b2.len()} bytes; ${store_path}.store-link and .parts-link)"
      }
      (Err(e), _) => return "XO_STD_STORE_CHECK=1: the store's link failed: ${e}"
      (_, Err(e)) => return "XO_STD_STORE_CHECK=1: the parts' link failed: ${e}"
    }
    os.stdio.eprintln("store check: the store's link is the parts' byte for byte")
  }
  match linked {
    Ok((b, dbg)) => {
      if split {
        match os.fs.write("${out}.debug", dbg) {
          Ok(_) => {}
          Err(e) => return "cannot write the debug information to ${out}.debug: ${fs_reason(e)}"
        }
      }
      write_exe(os, out, b)
    }
    Err(e) => "link: ${e}"
  }
}

/// tzSource as an object: the zone data std/time reads (xo_tz_mode,
/// xo_tz_zip_len, xo_tz_zip, xo_tz_blobs, and the table of them that
/// xo_tz_table returns to std/native/llrt/tzhost.xo), as
/// assembly for compiler/macho (Mach-O, or ELF for goos linux); the path
/// of the object.
fn tz_object(os: Os, dir: Str, sel: tzsel.TZSel, goos: Str, goarch: Str) -> Str ! FsErr {
  if goos == "linux" {
    return tz_object_elf(os, dir, sel, goarch == "amd64")
  }
  if goos == "windows" {
    return tz_object_coff(os, dir, sel)
  }
  var b = BytesBuilder.new()
  b.write_str("// The zone data of the program (decisions 0094, 0157, 0182).\n")
  b.write_str("\t.section __TEXT,__const\n\t.globl _xo_tz_mode\n\t.p2align 3\n_xo_tz_mode:\n\t.quad ${sel.mode}\n")
  let zip = if sel.mode == 1 { sel.zip } else { "".bytes() }
  b.write_str("\t.globl _xo_tz_zip_len\n\t.p2align 3\n_xo_tz_zip_len:\n\t.quad ${zip.len()}\n")
  b.write_str("\t.globl _xo_tz_zip\n_xo_tz_zip:\n")
  if zip.is_empty() {
    b.write_str("\t.byte 0\n")
  } else {
    asm_bytes(b, zip)
  }
  let n = if sel.mode == 0 { sel.names.len() } else { 0 }
  for i in 0..n {
    b.write_str("Lxo_tzd${i}:\n")
    if sel.data[i].is_empty() {
      b.write_str("\t.byte 0\n")
    } else {
      asm_bytes(b, sel.data[i])
    }
  }
  b.write_str("\t.section __TEXT,__cstring,cstring_literals\n")
  for i in 0..n {
    b.write_str("Lxo_tzn${i}:\n")
    asm_bytes(b, sel.names[i].bytes())
    b.write_str("\t.byte 0\n")
  }
  b.write_str("\t.section __DATA,__const\n\t.globl _xo_tz_blobs\n\t.p2align 3\n_xo_tz_blobs:\n")
  for i in 0..n {
    b.write_str("\t.quad Lxo_tzn${i}\n\t.quad Lxo_tzd${i}\n\t.quad ${sel.data[i].len()}\n")
  }
  b.write_str("\t.quad 0\n\t.quad 0\n\t.quad 0\n")
  // the table std/native/llrt/tzhost.xo reads through rttime.tz_table
  // (work item B27): the mode, the zip and its length, the blobs
  b.write_str("\t.p2align 3\nLxo_tzt:\n\t.quad ${sel.mode}\n\t.quad _xo_tz_zip\n\t.quad ${zip.len()}\n\t.quad _xo_tz_blobs\n")
  b.write_str("\t.section __TEXT,__text,regular,pure_instructions\n\t.globl _xo_tz_table\n\t.p2align 2\n_xo_tz_table:\n")
  if goarch == "amd64" {
    b.write_str("\tleaq Lxo_tzt(%rip), %rax\n\tretq\n")
  } else {
    b.write_str("\tadrp x0, Lxo_tzt@PAGE\n\tadd x0, x0, Lxo_tzt@PAGEOFF\n\tret\n")
  }
  let obj = match if goarch == "amd64" { macho.assemble_macho_amd64(b.freeze(), (11, 0)) } else { macho.assemble(b.freeze()) } {
    Ok(o) => o
    Err(e) => fault("the zone data does not assemble: ${e}")
  }
  let path = "${dir}/xo_tzdata.o"
  os.fs.write(path, obj)?
  Ok(path)
}

/// tz_object's ELF assembly: the same symbols without the underscore,
/// `.L` labels, the names in .rodata and the table of pointers in
/// .data.rel.ro.
fn tz_object_elf(os: Os, dir: Str, sel: tzsel.TZSel, amd64: Bool) -> Str ! FsErr {
  var b = BytesBuilder.new()
  b.write_str("// The zone data of the program (decisions 0094, 0157, 0182).\n")
  b.write_str("\t.section .rodata\n\t.globl xo_tz_mode\n\t.p2align 3\nxo_tz_mode:\n\t.quad ${sel.mode}\n")
  let zip = if sel.mode == 1 { sel.zip } else { "".bytes() }
  b.write_str("\t.globl xo_tz_zip_len\n\t.p2align 3\nxo_tz_zip_len:\n\t.quad ${zip.len()}\n")
  b.write_str("\t.globl xo_tz_zip\nxo_tz_zip:\n")
  if zip.is_empty() {
    b.write_str("\t.byte 0\n")
  } else {
    asm_bytes(b, zip)
  }
  let n = if sel.mode == 0 { sel.names.len() } else { 0 }
  for i in 0..n {
    b.write_str(".Lxo_tzd${i}:\n")
    if sel.data[i].is_empty() {
      b.write_str("\t.byte 0\n")
    } else {
      asm_bytes(b, sel.data[i])
    }
  }
  for i in 0..n {
    b.write_str(".Lxo_tzn${i}:\n")
    asm_bytes(b, sel.names[i].bytes())
    b.write_str("\t.byte 0\n")
  }
  b.write_str("\t.section .data.rel.ro,\"aw\",@progbits\n\t.globl xo_tz_blobs\n\t.p2align 3\nxo_tz_blobs:\n")
  for i in 0..n {
    b.write_str("\t.quad .Lxo_tzn${i}\n\t.quad .Lxo_tzd${i}\n\t.quad ${sel.data[i].len()}\n")
  }
  b.write_str("\t.quad 0\n\t.quad 0\n\t.quad 0\n")
  // the table of tz_object's Mach-O form
  b.write_str("\t.p2align 3\n.Lxo_tzt:\n\t.quad ${sel.mode}\n\t.quad xo_tz_zip\n\t.quad ${zip.len()}\n\t.quad xo_tz_blobs\n")
  if amd64 {
    b.write_str("\t.text\n\t.globl xo_tz_table\n\t.p2align 4\nxo_tz_table:\n\tleaq .Lxo_tzt(%rip), %rax\n\tretq\n")
  } else {
    b.write_str("\t.text\n\t.globl xo_tz_table\n\t.p2align 2\nxo_tz_table:\n\tadrp x0, .Lxo_tzt\n\tadd x0, x0, :lo12:.Lxo_tzt\n\tret\n")
  }
  let src = b.freeze()
  let obj = match if amd64 { macho.assemble_elf_amd64(src) } else { macho.assemble_elf(src) } {
    Ok(o) => o
    Err(e) => fault("the zone data does not assemble: ${e}")
  }
  let path = "${dir}/xo_tzdata.o"
  os.fs.write(path, obj)?
  Ok(path)
}

/// data as .ascii lines of 64 bytes, printable ASCII as is (but \\ and
/// \"), other bytes as three digit octal escapes.
fn asm_bytes(var b: BytesBuilder, data: Bytes) {
  var i = 0
  while i < data.len() {
    let end = if i + 64 < data.len() { i + 64 } else { data.len() }
    b.write_str("\t.ascii \"")
    for k in i..end {
      let c = data[k]
      if c == '"' || c == '\\' {
        b.write_byte('\\')
        b.write_byte(c)
      } else if c >= 32 && c < 127 {
        b.write_byte(c)
      } else {
        let v = Int(c)
        b.write_str("\\${v / 64}${v / 8 % 8}${v % 8}")
      }
    }
    b.write_str("\"\n")
    i = end
  }
}

/// tz_object's COFF x86-64 form (windows/amd64 with Xo's PE linker,
/// decision 0254 6b step 4): the ELF form's symbols in .rdata and .data.
fn tz_object_coff(os: Os, dir: Str, sel: tzsel.TZSel) -> Str ! FsErr {
  var b = BytesBuilder.new()
  b.write_str("// The zone data of the program (decisions 0094, 0157, 0182).\n")
  b.write_str("\t.section .rdata,\"dr\"\n\t.globl xo_tz_mode\n\t.p2align 3\nxo_tz_mode:\n\t.quad ${sel.mode}\n")
  let zip = if sel.mode == 1 { sel.zip } else { "".bytes() }
  b.write_str("\t.globl xo_tz_zip_len\n\t.p2align 3\nxo_tz_zip_len:\n\t.quad ${zip.len()}\n")
  b.write_str("\t.globl xo_tz_zip\nxo_tz_zip:\n")
  if zip.is_empty() {
    b.write_str("\t.byte 0\n")
  } else {
    asm_bytes(b, zip)
  }
  let n = if sel.mode == 0 { sel.names.len() } else { 0 }
  for i in 0..n {
    b.write_str(".Lxo_tzd${i}:\n")
    if sel.data[i].is_empty() {
      b.write_str("\t.byte 0\n")
    } else {
      asm_bytes(b, sel.data[i])
    }
  }
  for i in 0..n {
    b.write_str(".Lxo_tzn${i}:\n")
    asm_bytes(b, sel.names[i].bytes())
    b.write_str("\t.byte 0\n")
  }
  b.write_str("\t.data\n\t.globl xo_tz_blobs\n\t.p2align 3\nxo_tz_blobs:\n")
  for i in 0..n {
    b.write_str("\t.quad .Lxo_tzn${i}\n\t.quad .Lxo_tzd${i}\n\t.quad ${sel.data[i].len()}\n")
  }
  b.write_str("\t.quad 0\n\t.quad 0\n\t.quad 0\n")
  b.write_str("\t.p2align 3\n.Lxo_tzt:\n\t.quad ${sel.mode}\n\t.quad xo_tz_zip\n\t.quad ${zip.len()}\n\t.quad xo_tz_blobs\n")
  b.write_str("\t.text\n\t.globl xo_tz_table\n\t.p2align 4\nxo_tz_table:\n\tleaq .Lxo_tzt(%rip), %rax\n\tretq\n")
  let obj = match macho.assemble_coff_amd64(b.freeze()) {
    Ok(o) => o
    Err(e) => fault("the zone data does not assemble: ${e}")
  }
  let path = "${dir}/xo_tzdata.obj"
  os.fs.write(path, obj)?
  Ok(path)
}

/// Links the windows/amd64 COFF objects at paths into bin with Xo's PE
/// linker (decision 0254 6b step 4): the entry xo_win_start
/// (cabi_wincrt.xo), the imports by macho.pe_imports. race: a --race
/// program, at its fixed base (ThreadSanitizer's application range ends
/// at 0xe0_0000_0000; Go's linker turns ASLR off for it too). "" or why
/// not.
/// bin is where the program is written (a stage's, ld.xo Stage), out
/// the path it will have: the debug directory names out's PDB (trim: by its
/// file name only).
/// phases: each step's time on stderr (--phase-times, as pe.NAME).
/// cdir and keys: the back-end cache and the first objects' keys for their
/// PDB parts (the PDB from each object's cached part, pdb_parts, unless
/// XO_PDB_OBJ=0).
fn pe_link(os: Os, paths: List[Str], bin: Str, out: Str, stamps: List[(Str, Str)], race: Bool, phases: Bool, trim: Bool, cdir: Str, keys0: List[Str], debug: Bool, later: Mutex[List[PdbLater]]?) -> Str { pe_link_half(os, paths, bin, out, stamps, race, phases, trim, cdir, keys0, debug, later, true) }

/// pe_link, through std's half when use_half and one is cached (decision
/// 0409 on PE); a link the half cannot serve is made again without it.
fn pe_link_half(os: Os, paths: List[Str], bin: Str, out: Str, stamps: List[(Str, Str)], race: Bool, phases: Bool, trim: Bool, cdir: Str, keys0: List[Str], debug: Bool, later: Mutex[List[PdbLater]]?, use_half: Bool) -> Str {
  var t = os.clock.now()
  var keys = keys0
  // decision 0388 stage 4's store for windows/amd64: XO_STD_STORE=PATH on
  // an XO_STD_ROOTS=1 build packs the build's parts (prog-windows.N.obj)
  // into the store at PATH when it is not there, else links through it
  // without reading them (XO_STD_STORE_CHECK=1: and the parts' link, which
  // must be the same bytes)
  let store_path = os.env.get("XO_STD_STORE") ?? ""
  var store = "".bytes()
  if !store_path.is_empty() {
    match os.fs.read(store_path) {
      Ok(b) => store = b
      Err(_) => {}
    }
  }
  let store_check = !store.is_empty() && (os.env.get("XO_STD_STORE_CHECK") ?? "") == "1"
  // decision 0388 stage 3: a separately compiled program links through
  // std's store (XO_SEPCOMP_STORE=PATH, std.store of `xo dev stdobj` or
  // the std cache): every input is the program's, kept whole, std read
  // from PATH and its PDB parts from PATH.pdb
  let sep_store = if store_path.is_empty() { os.env.get("XO_SEPCOMP_STORE") ?? "" } else { "" }
  // (read when the link needs it: a link from std's half does not)
  var sep_size = 0
  if !sep_store.is_empty() {
    match os.fs.stat(sep_store) {
      Ok(Some(fi)) => sep_size = fi.size
      Ok(None) => return "XO_SEPCOMP_STORE=${sep_store}: not found"
      Err(e) => return "XO_SEPCOMP_STORE=${sep_store}: ${fs_reason(e)}"
    }
  }
  let store_file = if sep_store.is_empty() { store_path } else { sep_store }
  t = lap(os, phases, "pe.read_store ${store.len()} bytes", t)
  var objs: List[macho.CObj] = []
  var parts: List[macho.CObj] = []
  var rest: List[macho.CObj] = []
  // what the PDB's GUID is made from (pdb_seed): each object's cache key,
  // or for one with none its bytes' hash
  var seed = BytesBuilder.new()
  seed.write_str("xo pdb guid v1\n")
  for (pi, p) in paths.indexed() {
    let part = !store_path.is_empty() && base_name(p).starts_with("prog-windows.") && p.ends_with(".obj")
    if part && !store.is_empty() && !store_check {
      continue
    }
    let b = match os.fs.read(p) {
      Ok(b) => b
      Err(e) => return "${p}: ${e}"
    }
    if pi < keys.len() && !keys[pi].is_empty() {
      seed.write_str("key ${keys[pi]}\n")
    } else if !keys.is_empty() {
      seed.write_str("obj ${crypto.sha256(b).to_hex()}\n")
    }
    match macho.read_coff(p, b) {
      Ok(o) => {
        objs.push(o)
        if part {
          parts.push(o)
        } else {
          rest.push(o)
        }
      }
      Err(e) => return e
    }
  }
  t = lap(os, phases, "pe.inputs ${rest.len()} objects", t)
  var check_objs: List[macho.CObj] = []
  // a link through the store: its objects' PDB maps and parts
  var smaps: List[macho.StoreMap] = []
  // (its PDB parts file, read when the PDB is made: after the program
  // starts for xo run and xo test)
  var store_pdb = ""
  // the program's first object after std's store's (decision 0409 on PE:
  // its own sections after std's), -1 without a store link
  var prog_from = -1
  // std's half's cache file ("": none) and the half the link is from
  var hf = ""
  var half: macho.PeHalf? = None
  // the id of the half this link's std objects are (used or just
  // captured), "" for none: the PDB's std part is cached for it
  var half_id = ""
  if !store_path.is_empty() && store.is_empty() {
    match macho.coff_store_encode(parts) {
      Ok(b) => match os.fs.write(store_path, b) {
        Ok(_) => {}
        Err(e) => return "XO_STD_STORE=${store_path}: ${fs_reason(e)}"
      }
      Err(e) => return "XO_STD_STORE=${store_path}: ${e}"
    }
    // the parts' PDB parts beside it (coffstore.xo coff_store_pdb)
    match os.fs.write("${store_path}.pdb", macho.coff_store_pdb(parts)) {
      Ok(_) => {}
      Err(e) => return "XO_STD_STORE=${store_path}.pdb: ${fs_reason(e)}"
    }
  } else if !store.is_empty() || !sep_store.is_empty() {
    // the prepare cache (as darwin's store link: the live atoms, the
    // units whose DWARF goes and the symbol renumbering, keyed by what the
    // program takes from the store)
    let pf = coff_prep_file(os, prep_dir(os, sep_store), sep_store, if sep_store.is_empty() { store.len() } else { sep_size }, rest, "xo_win_start", true)
    t = lap(os, phases, "pe.prep_key", t)
    // std's half (decision 0409 on PE): std's objects as the last full
    // link with this key left them, the store not read
    // (not with XO_STD_STORE_CHECK, whose parts' link has other objects
    // before the program's)
    let split = (os.env.get("XO_STD_HALF") ?? "") != "off" && !store_check
    hf = if split && !sep_store.is_empty() { pe_half_file_for(pf, debug, race) } else { "" }
    if use_half {
      half = pe_half_load(os, hf)
    }
    let so = match half {
      Some(h) => {
        t = lap(os, phases, "pe.store std's half", t)
        macho.CoffStore{objs: macho.pe_half_objs(h), maps: h.maps}
      }
      None => {
        if store.is_empty() {
          match os.fs.read(sep_store) {
            Ok(b) => store = b
            Err(e) => return "XO_SEPCOMP_STORE=${sep_store}: ${fs_reason(e)}"
          }
          t = lap(os, phases, "pe.read_store ${store.len()} bytes", t)
        }
        match macho.coff_store_objs_cached(store, rest, "xo_win_start", true, prep_load(os, pf)) {
          Ok((so, prep, hit)) => {
            if !hit {
              prep_put(os, pf, prep)
            }
            t = lap(os, phases, "pe.store ${if hit { "prepare cache hit" } else { "prepared" }}", t)
            so
          }
          Err(e) => return "XO_STD_STORE=${store_file}: ${e}"
        }
      }
    }
    if store_check {
      check_objs = objs
    }
    objs = so.objs + rest
    smaps = so.maps
    if split {
      prog_from = so.objs.len()
    }
    store_pdb = "${store_file}.pdb"
    if sep_store.is_empty() {
      // (the parts' PDB part keys name objects no longer linked)
      keys = []
    } else {
      // the program's objects keep theirs, after the store's
      var k2: List[Str] = List.with_capacity(so.objs.len() + keys.len())
      for _ in so.objs {
        k2.push("")
      }
      keys = k2 + keys
      // std's store is part of what made the image (its path is its
      // std cache key)
      seed.write_str("store ${sep_store}\n")
    }
  }
  // a program with DWARF gets a PDB next to it (decision 0344), which its
  // debug directory names; with `-s` or --debug-info=off none, though
  // std's store's objects carry DWARF (decision 0388)
  var dwarf = false
  for ob in if debug { objs } else { [] } {
    for s in ob.sects {
      dwarf = dwarf || s.name == ".debug_info"
    }
  }
  t = lap(os, phases, "pe.read ${paths.len()} objects", t)
  let pdb = if dwarf { "${bin.trim_suffix(".exe")}.pdb" } else { "" }
  // the debug directory names the PDB where it will be, not in the
  // stage: the same program has the same bytes
  // (--trimpath: just its file name, as MSVC's /pdbaltpath:%_PDB%; the
  // debuggers look beside the executable first, and the record then holds
  // no path of the machine that built it)
  var pdb_named = if dwarf { "${out.trim_suffix(".exe")}.pdb" } else { "" }
  if dwarf && trim {
    pdb_named = base_name(pdb_named)
  }
  // the debug directory names it with backslashes, as MSVC's and lld's
  // linkers do: dbghelp finds a PDB moved since by its base name, which
  // an older one takes after the last backslash only
  let res = pe_resources(bin, stamps)
  let peo = macho.PEOpts{entry: "xo_win_start", imports: macho.pe_imports(), resources: res, fixed_base: race, pdb: pdb_named.replace("/", "\\"), debug: debug, prog_from: prog_from}
  if store_check {
    // the store's link against the parts' (strip by atom): the same image
    match (macho.link_pe(objs, peo), macho.link_pe(check_objs, peo)) {
      (Ok(a), Ok(b)) => if a != b {
        return "XO_STD_STORE_CHECK=1: the store's link differs from the parts' (${a.len()} and ${b.len()} bytes)"
      }
      (Err(e), _) => return "XO_STD_STORE_CHECK=1: the store's link: ${e}"
      (_, Err(e)) => return "XO_STD_STORE_CHECK=1: the parts' link: ${e}"
    }
  }
  match macho.link_pe_layout(objs, peo) {
    Ok((img0, layout)) => {
      t = lap(os, phases, "pe.link_pe ${img0.len()} bytes", t)
      match half {
        Some(h) => if !macho.pe_half_pins_ok(h, layout) {
          // std's sections moved (the program grew the headers): the full
          // link, whose half replaces this one
          return pe_link_half(os, paths, bin, out, stamps, race, phases, trim, cdir, keys0, debug, later, false)
        } else {
          half_id = h.id
        }
        None => if !hf.is_empty() {
          match macho.capture_pe_half(img0, layout, prog_from) {
            Some(h) => {
              half_id = os.rand.bytes(12).to_hex()
              let b = macho.pe_half_encode(h with {maps: smaps, id: half_id})
              cache_put(os, hf, b)
              prune_backend_cache(os, "stdhalf", dir_name(dir_name(hf)), b.len())
            }
            None => {}
          }
          t = lap(os, phases, "pe.half_save", t)
        }
      }
      // XO_STD_STORE_REPEAT=N: N more layouts, timed and checked against
      // the first (a measurement: XO_PROF of link_pe_layout's parts)
      let rep = Int.parse(os.env.get("XO_STD_STORE_REPEAT") ?? "0") ?? 0
      if rep > 0 {
        let tr = os.clock.now()
        var same = true
        for _ in 0..rep {
          match macho.link_pe_layout(objs, peo) {
            Ok((b, _)) => same = same && b == img0
            Err(e) => return e
          }
        }
        os.stdio.eprintln("pe link x${rep}: ${os.clock.since(tr).nanos() / 1000 / rep} us each, ${if same { "equal" } else { "DIFFERENT" }}")
        // std's half (decision 0409 on PE): the link from it, the same bytes?
        match macho.capture_pe_half(img0, layout, prog_from) {
          Some(h0) => {
            // through the cache's bytes, as a hit reads it
            let enc = macho.pe_half_encode(h0 with {maps: smaps})
            let h = match macho.pe_half_decode(enc) {
              Some(x) => x
              None => return "pe half: the encoded half does not decode"
            }
            os.stdio.eprintln("pe half: ${enc.len()} bytes encoded, maps ${h.maps.len()} of ${smaps.len()}")
            let hobjs = macho.pe_half_objs(h) + objs[prog_from..objs.len()]
            let th = os.clock.now()
            match macho.link_pe_layout(hobjs, peo) {
              Ok((b, _)) => os.stdio.eprintln("pe half: ${os.clock.since(th).nanos() / 1000} us, ${if b == img0 { "half equal" } else { "half DIFFERENT (${b.len()} and ${img0.len()} bytes)" }}, ${h.kept} relocations kept, ${h.dropped} dropped")
              Err(e) => os.stdio.eprintln("pe half: ${e}")
            }
          }
          None => os.stdio.eprintln("pe half: none (not split, or program thread locals)")
        }
      }
      var img = img0
      // xo run and xo test: the image stamped with its PDB's GUID now and
      // the PDB made while the program runs (finish_pdbs; an HTTP server
      // edit's link spent 28 of its 58 ms on the PDB, 2026-10-30)
      let defer_pdb = dwarf && later.is_some() && (os.env.get("XO_PDB_OBJ") ?? "") != "0" && !store_check && (os.env.get("XO_PDB_OBJ_CHECK") ?? "").is_empty()
      if defer_pdb {
        let sd = if keys.is_empty() { b"" } else { pdb_seed(seed, race, pdb_named, res) }
        match macho.pe_pdb_stamped(img0, sd) {
          Ok((i2, _)) => {
            img = i2
            let job = PdbLater{img: i2, img0: img0, layout: layout, store_pdb: store_pdb, smaps: smaps, cdir: cdir, keys: keys, pre_file: pdb_pre_file(hf, half_id), half_id: half_id, seed: sd, path: "${out.trim_suffix(".exe")}.pdb"}
            if let Some(m) = later {
              m.with(fn(var l) { l.push(job) })
            }
            t = lap(os, phases, "pe.pdb_stamp (the PDB after the program starts)", t)
          }
          Err(e) => return "${bin}: the PDB: ${e}"
        }
      } else if dwarf {
        // each object's part from the back-end cache (the same bytes as the
        // image path, XO_PDB_OBJ=0; an HTTP server edit's 64 ms to 31)
        let per_obj = (os.env.get("XO_PDB_OBJ") ?? "") != "0"
        // (no keys, no back-end cache or a link through the store: the
        // image's own hash, cheaper than hashing every object)
        let sd = if keys.is_empty() { b"" } else { pdb_seed(seed, race, pdb_named, res) }
        let pdb_r = if per_obj {
          // through the store: its objects' parts from std.store.pdb, the
          // other objects' made
          let (pre, nst, parts, wstd) = pdb_pre(os, layout, store_pdb, smaps, cdir, keys, pdb_pre_file(hf, half_id), half_id)
          t = lap(os, phases, "pe.pdb_parts", t)
          let r = pdb_make(os, img0, pre, sd, pdb_pre_file(hf, half_id), half_id, wstd)
          if store_check && nst > 0 {
            // the store's parts' PDB against the image's DWARF's, in a link
            // that keeps the DWARF whole (the parts are made from whole
            // DWARF; the image's own is cut to its live functions)
            let wso = match macho.coff_store_objs(store, rest, "xo_win_start", false) {
              Ok(x) => x
              Err(e) => return "XO_STD_STORE_CHECK=1: the store with whole DWARF: ${e}"
            }
            let whole = match macho.link_pe_layout(wso.objs + rest, peo with {dwtrim: false}) {
              Ok(x) => x
              Err(e) => return "XO_STD_STORE_CHECK=1: the link with whole DWARF: ${e}"
            }
            let (wimg, wl) = whole
            let wpre = macho.pre_procs_store(parts, wl.objs, wl, wso.maps, false)
            match (macho.pe_pdb_seeded(wimg, None, Some(wpre), sd), macho.pe_pdb_seeded(wimg, None, None, sd)) {
              (Ok((_, a)), Ok((_, b))) => if a != b {
                return "XO_STD_STORE_CHECK=1: the PDB from the store's parts differs from the image's (${a.len()} and ${b.len()} bytes)"
              }
              _ => return "XO_STD_STORE_CHECK=1: a PDB failed"
            }
          }
          r
        } else {
          macho.pe_pdb_seeded(img0, None, None, sd)
        }
        match pdb_r {
          Ok((i2, p)) => {
            img = i2
            t = lap(os, phases, "pe.pdb ${p.len()} bytes", t)
            // per-object CodeView, step 1 (Xo Lang 2's design note): each
            // object's own DWARF against the image's, function by function
            let check = os.env.get("XO_PDB_OBJ_CHECK") ?? ""
            if check == "1" {
              os.stdio.eprintln("xo: XO_PDB_OBJ_CHECK: ${macho.obj_check(img0, layout.objs)}")
            }
            // step 2a: the PDB from the objects' DWARF and the layout
            // against the image's, byte for byte
            // step 2a': each function's rows and inline sites from its own
            // object (macho obj_pdb, pre_procs)
            if check == "3" {
              let t3 = os.clock.now()
              var parts: List[macho.ObjPdb?] = []
              for ob in layout.objs {
                parts.push(macho.obj_pdb(ob).ok())
              }
              let parts_ms = os.clock.since(t3).millis()
              let tp = os.clock.now()
              let pre = macho.pre_procs(parts, layout.objs, layout)
              let pre_ms = os.clock.since(tp).millis()
              let tq = os.clock.now()
              match macho.pe_pdb_seeded(img0, None, Some(pre), sd) {
                Ok((i3, p3)) => os.stdio.eprintln("xo: XO_PDB_OBJ_CHECK=3: the PDB from the objects' parts ${if p3 == p && i3 == i2 { "is identical" } else { "differs (sizes ${p3.len()} and ${p.len()})" }}; parts ${parts_ms} ms, merge ${pre_ms} ms, pdb ${os.clock.since(tq).millis()} ms")
                Err(e) => os.stdio.eprintln("xo: XO_PDB_OBJ_CHECK=3: ${e}")
              }
            }
            if check == "2" {
              let t2 = os.clock.now()
              let facts = macho.merge_facts(layout.objs, layout)
              let merge_ms = os.clock.since(t2).millis()
              let tm = os.clock.now()
              match macho.pe_pdb_seeded(img0, Some(facts), None, sd) {
                Ok((i3, p3)) => {
                  var diff = -1
                  let n = if p3.len() < p.len() { p3.len() } else { p.len() }
                  for k in 0..n {
                    if p3[k] != p[k] {
                      diff = k
                      break
                    }
                  }
                  let same = diff < 0 && p3.len() == p.len() && i3 == i2
                  os.stdio.eprintln("xo: XO_PDB_OBJ_CHECK=2: the PDB from the objects ${if same { "is identical" } else { "differs (first byte ${diff}, sizes ${p3.len()} and ${p.len()}, image ${if i3 == i2 { "same" } else { "differs" }})" }}; merge ${merge_ms} ms, pdb ${os.clock.since(tm).millis()} ms")
                }
                Err(e) => os.stdio.eprintln("xo: XO_PDB_OBJ_CHECK=2: ${e}")
              }
            }
            if let Err(e) = os.fs.write(pdb, p) {
              return "${pdb}: ${e}"
            }
            t = lap(os, phases, "pe.pdb_write", t)
          }
          Err(e) => return "${bin}: the PDB: ${e}"
        }
      }
      let _t = lap(os, phases, "pe.write_start", t)
      match os.fs.write(bin, img) {
        Ok(_) => ""
        Err(e) => "${bin}: ${e}"
      }
    }
    Err(e) => e
  }
}

/// A Windows program's resources: the manifest (UTF-8, long paths) and
/// the version information, named by the executable, its version that
/// of the stamp VERSION (`--stamp VERSION=1.2.3`, any case, a leading v
/// dropped), else 0.0.0.0.
fn pe_resources(bin: Str, stamps: List[(Str, Str)]) -> List[macho.PERes] {
  let segs = bin.split("/")
  let file = segs[segs.len() - 1]
  let name = file.trim_suffix(".exe")
  var text = "0.0.0.0"
  var parts: List[Int] = []
  for (k, v) in stamps {
    if k.to_lower() == "version" {
      text = v
      for f in v.trim_prefix("v").split(".") {
        var n = 0
        var any = false
        for c in f.bytes() {
          if c < '0' || c > '9' {
            break
          }
          n = n * 10 + Int(c - '0')
          any = true
        }
        if !any || parts.len() == 4 {
          break
        }
        parts.push(n)
      }
    }
  }
  let strings = [("FileDescription", name), ("FileVersion", text), ("InternalName", name), ("OriginalFilename", file), ("ProductName", name), ("ProductVersion", text)]
  [macho.PERes{typ: 24, id: 1, data: macho.pe_manifest()}, macho.PERes{typ: 16, id: 1, data: macho.pe_version(parts, strings)}]
}

/// Writes the program b to out: a new file OUT.tmp, made executable and
/// renamed over out (the kernel caches the signature of a file it ran).
/// On any failure OUT.tmp is removed and the error says what went wrong
/// in words, "" on success.
fn write_exe(os: Os, out: Str, b: Bytes) -> Str {
  let tmp = "${out}.tmp"
  var r = os.fs.write(tmp, b)
  if r.is_ok() {
    r = os.fs.set_mode(tmp, 0o755)
    // a WASI host decides the modes (the xo that runs as a wasm module
    // cannot set one): the file is written without
    if let Err(Io(_, msg)) = r {
      if msg.starts_with("operation not supported (WASI") {
        r = Ok(())
      }
    }
  }
  if r.is_ok() {
    r = os.fs.rename(tmp, out)
  }
  match r {
    Ok(_) => ""
    Err(e) => {
      os.fs.remove(tmp).ignore_err("a failed write leaves nothing behind; a tmp that was never made is NotFound")
      match e {
        IsDir(_) => "cannot write the program to ${out}: it is a directory (-o DIR writes DIR/NAME when DIR exists)"
        _ => "cannot write the program to ${out}: ${fs_reason(e)}"
      }
    }
  }
}

/// An Fs error in words, without the record's syntax.
fn fs_reason(e: FsErr) -> Str {
  match e {
    NotFound(p) => "${p}: no such file or directory"
    Exists(p) => "${p}: file exists"
    NotEmpty(p) => "${p}: directory not empty"
    NotDir(p) => "${p}: a parent is not a directory"
    IsDir(p) => "${p}: is a directory"
    Denied(p) => "${p}: permission denied"
    Io(p, msg) => "${p}: ${msg}"
    Canceled => "canceled"
  }
}

/// A final output (the -o file, a build directory's bin/NAME) built in a
/// hidden staging directory beside it, DIR/.NAME.tmp-TAG-RAND, under its
/// own name (NAME, with NAME.dSYM or NAME.pdb beside it), then renamed
/// into place: no visible file appears in DIR while a build runs, two
/// builds of the same output never share a temporary, the linkers see
/// the final name (ld64 names the ad hoc code signature after the file),
/// and a failed or interrupted build leaves nothing (the stop watcher
/// removes the stages a SIGINT or SIGTERM catches; decision 0345).
struct Stage {
  /// the staging directory
  dir: Str
  /// the final output
  out: Str
  /// where the build writes the output: dir/NAME
  bin: Str
  /// staged away from out (its directory cannot hold the stage: -o
  /// /dev/null): commit writes the program's bytes to out, no rename
  copy: Bool = false
}

/// The stage of final output out, its directory created and announced
/// to the stop watcher.
fn stage(os: Os, ctx: Ctx, out: Str) -> Stage {
  let tag = if ctx.tmp_tag.is_empty() { "0" } else { ctx.tmp_tag }
  let d = "${dir_name(out)}/.${base_name(out)}.tmp-${tag}-${os.rand.bytes(4).to_hex()}"
  if let Some(ch) = ctx.stages {
    let _ = ch.try_send(d)
  }
  match os.fs.create_dir_all(d) {
    Ok(_) => Stage{dir: d, out: out, bin: "${d}/${base_name(out)}"}
    Err(e) => {
      // the output's directory takes no stage (-o /dev/null: /dev is not
      // writable, though /dev/null is; dfd47760e's stages broke that
      // idiom): stage in the user cache and write the program to out
      let away = "${ctx.cache}/xo/build/.stage-${tag}-${os.rand.bytes(4).to_hex()}"
      if !ctx.cache.is_empty() && os.fs.create_dir_all(away).is_ok() {
        if let Some(ch) = ctx.stages {
          let _ = ch.try_send(away)
        }
        return Stage{dir: away, out: out, bin: "${away}/${base_name(out)}", copy: true}
      }
      fail(os, "cannot write the program to ${out}: ${fs_reason(e)}")
    }
  }
}

/// Moves what the build wrote in the stage into place, the debug
/// information first and the program last, and removes the stage; ""
/// on success, else why (and the stage is removed).
fn (s: Stage) commit(os: Os) -> Str {
  if s.copy {
    // the program's bytes written to out (a device such as /dev/null, or
    // a file in a directory that takes no stage); debug information
    // beside it is dropped with the stage
    let r = match os.fs.read(s.bin) {
      Ok(data) => match os.fs.write(s.out, data) {
        Ok(_) => ""
        Err(e) => "cannot write the program to ${s.out}: ${fs_reason(e)}"
      }
      Err(e) => "cannot write the program to ${s.out}: ${fs_reason(e)}"
    }
    s.abandon(os)
    return r
  }
  let es = match os.fs.read_dir(s.dir) {
    Ok(l) => l
    Err(e) => {
      s.abandon(os)
      return "cannot write the program to ${s.out}: ${fs_reason(e)}"
    }
  }
  let target = dir_name(s.out)
  let name = base_name(s.out)
  // a directory where the program goes: fail before anything moves, so
  // no debug information is left beside it
  if let Ok(Some(fi)) = os.fs.stat(s.out) {
    if fi.is_dir {
      s.abandon(os)
      return "cannot write the program to ${s.out}: it is a directory (-o DIR writes DIR/NAME when DIR exists)"
    }
  }
  var order: List[Str] = []
  for e in es {
    if e.name != name {
      order.push(e.name)
    }
  }
  if es.any(fn(e) { e.name == name }) {
    order.push(name)
  }
  for n in order {
    let dst = "${target}/${n}"
    if n != name {
      // a bundle (NAME.dSYM) or file of an earlier build: replaced
      os.fs.remove_all(dst).ignore_err("none from an earlier build")
    }
    match os.fs.rename("${s.dir}/${n}", dst) {
      Ok(_) => {}
      Err(e) => {
        s.abandon(os)
        return match e {
          IsDir(_) | NotEmpty(_) => "cannot write the program to ${dst}: it is a directory (-o DIR writes DIR/NAME when DIR exists)"
          _ => "cannot write the program to ${dst}: ${fs_reason(e)}"
        }
      }
    }
  }
  s.abandon(os)
  ""
}

/// Removes the stage and whatever is in it.
fn (s: Stage) abandon(os: Os) {
  os.fs.remove_all(s.dir).ignore_err("the stop watcher or another process removed it")
}

/// fail, after removing the stage.
fn fail_stage(os: Os, s: Stage, msg: Str) -> Never {
  s.abandon(os)
  fail(os, msg)
}

/// The stop watcher: on the first SIGINT or SIGTERM (a stop request,
/// core 7.5) it removes every stage this process announced and exits
/// 130, so an interrupted build leaves no temporary behind.
fn watch_stages(os: Os, ch: Chan[Str], done: Chan[()]) {
  // the WASI build has no signals, and its task.stopping() is the handle 0
  // (compiler/wasm call.xo): a recv on it read a channel at address 0
  // (decision 0405)
  if target.os == TargetOs.Wasi {
    return
  }
  let _w = os.tasks.spawn_background(fn() {
    let _ = task.stopping().recv()
    if done.try_recv().is_some() {
      // built: the stop is the program's (xo run, xo test)
      return
    }
    while let Some(d) = ch.try_recv() {
      os.fs.remove_all(d).ignore_err("committed or abandoned already")
    }
    os.stdio.eprintln("xo: interrupted")
    os.proc.exit(130)
  })
}

/// A windows/amd64 PDB pe_link leaves for after the link (xo run and
/// xo test make it while the program runs, finish_pdbs): the image as
/// written (stamped with the PDB's GUID, macho.pe_pdb_stamped) and
/// before, and what its PDB is made from.
struct PdbLater {
  img: Bytes
  img0: Bytes
  layout: macho.PELayout
  store_pdb: Str
  smaps: List[macho.StoreMap]
  cdir: Str
  keys: List[Str]
  /// the PDB's cached std part and its half's id (pdb_pre)
  pre_file: Str
  half_id: Str
  seed: Bytes
  /// beside the program's final path
  path: Str
}

/// The PDB's functions from each object's part (pdb_parts; through the
/// store: its objects' from std.store.pdb), how many objects the
/// store's parts cover (0: none), and the parts.
fn pdb_pre(os: Os, layout: macho.PELayout, store_pdb: Str, smaps: List[macho.StoreMap], cdir: Str, keys: List[Str], pre_file: Str, half_id: Str) -> (macho.PreProcs, Int, List[macho.ObjPdb?], macho.PdbStd?) {
  let prog = fn(n: Int) -> List[macho.ObjPdb?] { pdb_parts(os, layout.objs[n..layout.objs.len()], cdir, if keys.len() > n { keys[n..keys.len()] } else { [] }) }
  // std's part as the half's link left it: std's parts not read; with the
  // writer's std part too, std's functions are not even decoded (the
  // writer has them placed)
  if !store_pdb.is_empty() && !smaps.is_empty() {
    let wstd = pdb_std_load(os, pdb_std_file(pre_file), half_id)
    if let Some(std) = pdb_pre_load(os, pre_file, half_id, wstd.is_some()) {
      var parts: List[macho.ObjPdb?] = List.with_capacity(layout.objs.len())
      for _ in 0..smaps.len() {
        parts.push(None)
      }
      parts = parts + prog(smaps.len())
      return (macho.pre_procs_from(parts, layout.objs, layout, smaps, true, Some(std), smaps.len(), parts.len()), smaps.len(), parts, wstd)
    }
  }
  let store_parts = if store_pdb.is_empty() { [] } else { macho.coff_store_pdb_read(os.fs.read(store_pdb).ok() ?? "".bytes()) }
  let nst = if store_parts.len() == smaps.len() { smaps.len() } else { 0 }
  let parts = if nst > 0 { store_parts + prog(nst) } else { pdb_parts(os, layout.objs, cdir, keys) }
  if nst > 0 {
    // std's types first (cv_types_split) in every link through the store,
    // so the PDB is the same with and without a cached std part
    let std = macho.pre_procs_std(macho.pre_procs_from(parts, layout.objs, layout, smaps, true, None, 0, nst))
    if !pre_file.is_empty() {
      let b = PDB_PRE_MAGIC.bytes() + "${half_id}\n".bytes() + macho.enc_pre_procs(std)
      cache_put(os, pre_file, b)
      prune_backend_cache(os, "stdhalf", dir_name(dir_name(pre_file)), b.len())
    }
    return (macho.pre_procs_from(parts, layout.objs, layout, smaps, true, Some(std), nst, parts.len()), nst, parts, None)
  }
  (macho.pre_procs_store(parts, layout.objs, layout, if nst > 0 { smaps } else { [] }, true), nst, parts, None)
}

const PDB_PRE_MAGIC = "xopdbpre1\n"

/// The PDB of pre (pe_pdb_seeded), with std's part of it (macho.PdbStd)
/// from <pre_file>w when it was made for the half of id, else made and
/// kept there: std's placed functions, their module records and line
/// blocks are the same in every link from that half.
fn pdb_make(os: Os, img: Bytes, pre: macho.PreProcs, seed: Bytes, pre_file: Str, id: Str, std: macho.PdbStd?) -> Result[(Bytes, Bytes), Str] {
  let wf = if id.is_empty() || pre.std_procs == 0 { "" } else { pdb_std_file(pre_file) }
  let head = PDB_STD_MAGIC.bytes() + "${id}\n".bytes()
  match macho.pe_pdb_std(img, pre, seed, std) {
    Ok((i2, pdb, made)) => {
      if let Some(m) = made {
        if !wf.is_empty() {
          let b = head + macho.enc_pdb_std(m)
          cache_put(os, wf, b)
          prune_backend_cache(os, "stdhalf", dir_name(dir_name(wf)), b.len())
        }
      }
      Ok((i2, pdb))
    }
    Err(e) => Err(e)
  }
}

const PDB_STD_MAGIC = "xopdbstd1\n"

/// The file of the PDB writer's std part beside the PDB's std part f.
fn pdb_std_file(f: Str) -> Str { if f.is_empty() { "" } else { "${f}w" } }

/// The PDB writer's std part in f when it was made for the half of id.
fn pdb_std_load(os: Os, f: Str, id: Str) -> macho.PdbStd? {
  if f.is_empty() || id.is_empty() {
    return None
  }
  let b = cache_get(os, f) ?? return None
  let head = PDB_STD_MAGIC.bytes() + "${id}\n".bytes()
  if b.len() < head.len() || b[0..head.len()] != head {
    return None
  }
  macho.dec_pdb_std(b[head.len()..b.len()])
}

/// The file of the PDB's std part for std's half in hf of id ("" for none).
fn pdb_pre_file(hf: Str, id: Str) -> Str { if hf.is_empty() || id.is_empty() { "" } else { "${hf}.pdb" } }

/// The PDB's std part in f when it was made for the half of id, or None.
fn pdb_pre_load(os: Os, f: Str, id: Str, lazy: Bool) -> macho.PreProcs? {
  if f.is_empty() || id.is_empty() {
    return None
  }
  let b = cache_get(os, f) ?? return None
  let head = PDB_PRE_MAGIC.bytes() + "${id}\n".bytes()
  if b.len() < head.len() || b[0..head.len()] != head {
    return None
  }
  if lazy { macho.dec_pre_procs_lazy(b[head.len()..b.len()]) } else { macho.dec_pre_procs(b[head.len()..b.len()]) }
}

/// Makes and writes the PDBs pe_link left for after the link
/// (PdbLater), each written whole or not at all (write_atomic); "" or
/// why one failed. xo run and xo test call it after starting the program
/// and wait for it before they exit.
fn finish_pdbs(os: Os, later: Mutex[List[PdbLater]]?) -> Str {
  let jobs = match later {
    Some(m) => m.with(fn(var l) {
      let x = l
      l = []
      x
    })
    None => []
  }
  var why = ""
  for j in jobs {
    let (pre, _, _, wstd) = pdb_pre(os, j.layout, j.store_pdb, j.smaps, j.cdir, j.keys, j.pre_file, j.half_id)
    match pdb_make(os, j.img0, pre, j.seed, j.pre_file, j.half_id, wstd) {
      Ok((i2, p)) => {
        if i2 != j.img {
          why = "${j.path}: the program's debug directory does not name this PDB"
          continue
        }
        if let Err(e) = write_atomic(os.fs, j.path, p) {
          why = "${j.path}: ${e}"
        }
      }
      Err(e) => why = "${j.path}: ${e}"
    }
  }
  why
}

/// Each object's PDB part (macho obj_pdb): from the back-end cache under
/// "pdb" by its key, else made and stored; an object with no key (the
/// zone data's, a build with no cache) is made each time.
fn pdb_parts(os: Os, objs: List[macho.CObj], cdir: Str, keys: List[Str]) -> List[macho.ObjPdb?] {
  var out: List[macho.ObjPdb?] = []
  var stored = 0
  for (i, o) in objs.indexed() {
    let k = if i < keys.len() && !cdir.is_empty() { keys[i] } else { "" }
    if !k.is_empty() {
      if let Some(b) = entry_get(os, cdir, "pdb", k) {
        if let Some(p) = macho.dec_obj_pdb(b) {
          out.push(Some(p))
          continue
        }
      }
    }
    let p = macho.obj_pdb(o).ok()
    if !k.is_empty() {
      if let Some(x) = p {
        stored += entry_put(os, cdir, "pdb", k, macho.enc_obj_pdb(x))
      }
    }
    out.push(p)
  }
  if stored > 0 {
    prune_backend_cache(os, "pdb", cdir, stored)
  }
  out
}

/// std's object (XO_STD_OBJ=DIR, decision 0388 stage 4): the part
/// objects objs copied into sod, with their indexed store, std.store.
fn write_std_obj(os: Os, sod: Str, objs: List[Str], elf: Bool) {
  var ins: List[macho.LinkInput] = []
  for ob in objs {
    match os.fs.read(ob) {
      Ok(b) => {
        write_or_fail(os, sod, "${sod}/${base_name(ob)}", b)
        ins.push(macho.LinkInput{path: base_name(ob), data: b})
      }
      Err(e) => fail(os, "${ob}: ${e}")
    }
  }
  match if elf { macho.store_encode_elf(ins) } else { macho.store_encode(ins) } {
    Ok(b) => write_or_fail(os, sod, "${sod}/std.store", b)
    Err(e) => fail(os, "XO_STD_OBJ=${sod}: ${e}")
  }
}

/// write_std_obj for windows/amd64's COFF parts (coffstore.xo).
fn write_std_obj_coff(os: Os, sod: Str, objs: List[Str]) {
  var cs: List[macho.CObj] = []
  for ob in objs {
    match os.fs.read(ob) {
      Ok(b) => {
        write_or_fail(os, sod, "${sod}/${base_name(ob)}", b)
        match macho.read_coff(base_name(ob), b) {
          Ok(c) => cs.push(c)
          Err(e) => fail(os, "${ob}: ${e}")
        }
      }
      Err(e) => fail(os, "${ob}: ${e}")
    }
  }
  match macho.coff_store_encode(cs) {
    Ok(b) => write_or_fail(os, sod, "${sod}/std.store", b)
    Err(e) => fail(os, "XO_STD_OBJ=${sod}: ${e}")
  }
  write_or_fail(os, sod, "${sod}/std.store.pdb", macho.coff_store_pdb(cs))
}

/// The PDB GUID's seed: the objects' part of it (pe_link) and the link's
/// own inputs (the base, the PDB's name, the resources), so equal builds
/// get equal GUIDs and a change to code, debug information or the image's
/// options a new one, with no hash of the whole image (about 3 ms of an
/// HTTP server edit, 2026-10-28).
fn pdb_seed(var seed: BytesBuilder, race: Bool, pdb: Str, res: List[macho.PERes]) -> Bytes {
  seed.write_str("race ${race}\npdb ${pdb}\n")
  for r in res {
    seed.write_str("res ${r.typ} ${r.id} ${r.lang} ${crypto.sha256(r.data).to_hex()}\n")
  }
  seed.freeze()
}

/// macho.link_store in its steps, each a link.* lap under --phase-times
/// (link.store_prepare, link.resolve, link.layout, link.synthesize,
/// link.write): the same link, its time by step.
fn link_store_laps(os: Os, ctx: Ctx, ins: List[macho.LinkInput], store: Bytes, opts: macho.LinkOpts, pdir: Str) -> Result[(Bytes, Bytes), Str] {
  var t = os.clock.now()
  // the program's objects parsed once, for the cache's key and the link
  let parsed = match macho.parse_link_inputs(ins) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let pf = prep_file_for(os, pdir, ctx.sep_store, store.len(), parsed, opts)
  let hf = half_file_for(os, pf, opts)
  if let Some(h) = half_load(os, hf) {
    match link_from_half(os, ctx, parsed, h, opts, t) {
      Some(r) => return r
      // the half cannot serve this link: the full link below, whose half
      // replaces it
      None => {}
    }
  }
  var s = match macho.store_prepare_cached(parsed, store, opts, prep_load(os, pf)) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  prep_save(os, pf, s)
  t = lap(os, ctx.phases, "link.store_prepare", t)
  let er = s.resolve()
  if !er.is_empty() {
    return Err(er)
  }
  t = lap(os, ctx.phases, "link.resolve", t)
  let el = s.layout()
  if !el.is_empty() {
    return Err(el)
  }
  t = lap(os, ctx.phases, "link.layout", t)
  let es = s.synthesize()
  if !es.is_empty() {
    return Err(es)
  }
  t = lap(os, ctx.phases, "link.synthesize", t)
  let r = s.write()
  t = lap(os, ctx.phases, "link.write", t)
  if r.is_ok() {
    half_save(os, hf, s)
    let _h = lap(os, ctx.phases, "link.half_save", t)
  }
  r
}

/// An ELF store link with its steps timed (link.store_prepare,
/// link.resolve, link.layout, link.write: --phase-times).
/// lazy: the store's path when store is not read yet (n its length),
/// read only if the link is not from std's half.
fn elf_store_laps(os: Os, ctx: Ctx, ins: List[macho.LinkInput], store0: Bytes, lazy: Str, n: Int, opts: macho.ElfLinkOpts) -> Result[(Bytes, Bytes), Str] {
  var t = os.clock.now()
  // the program's objects parsed once, for the cache's key and the link
  let prog = match macho.parse_elf_inputs(ins) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let pf = elf_prep_file(os, ctx.sep_store, n, prog, opts)
  let hf = elf_half_file_for(pf, opts)
  if let Some(h) = elf_half_load(os, hf) {
    match link_from_elf_half(os, ctx, prog, h, opts, t) {
      Some(r) => return r
      // the half cannot serve this link: the full link below, whose half
      // replaces it
      None => {}
    }
  }
  var store = store0
  if store.is_empty() {
    // mapped, as macho_link's (decision 0402)
    match read_mapped(ctx.real_fs ?? os.fs, lazy) {
      Ok(b) => store = b
      Err(e) => return Err("XO_SEPCOMP_STORE=${lazy}: ${fs_reason(e)}")
    }
    t = lap(os, ctx.phases, "link.read_store", t)
  }
  var s = match macho.elf_store_prepare(prog, store, opts, prep_load(os, pf)) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  if !pf.is_empty() && !s.hit {
    let b = macho.prep_encode(s.prep)
    cache_put(os, pf, b)
    prune_backend_cache(os, "prep", dir_name(dir_name(pf)), b.len())
  }
  t = lap(os, ctx.phases, "link.store_prepare", t)
  let er = s.resolve()
  if !er.is_empty() {
    return Err(er)
  }
  t = lap(os, ctx.phases, "link.resolve", t)
  let el = s.layout()
  if !el.is_empty() {
    return Err(el)
  }
  t = lap(os, ctx.phases, "link.layout", t)
  let r = s.write()
  t = lap(os, ctx.phases, "link.write", t)
  if r.is_ok() && !hf.is_empty() {
    match s.capture_half() {
      Some(h) => {
        let b = macho.elf_half_encode(h)
        cache_put(os, hf, b)
        prune_backend_cache(os, "stdhalf", dir_name(dir_name(hf)), b.len())
      }
      None => {}
    }
    let _h = lap(os, ctx.phases, "link.half_save", t)
  }
  r
}

/// An ELF store link from std's half h (decision 0420, E4): None when the
/// half cannot give the full link's bytes (link_from_half's reasons), the
/// caller then links in full.
fn link_from_elf_half(os: Os, ctx: Ctx, prog: macho.ElfProg, h: macho.ElfHalf, opts: macho.ElfLinkOpts, t0: Time) -> Result[(Bytes, Bytes), Str]? {
  var t = t0
  var s = macho.elf_store_prepare_half(prog, h, opts)
  t = lap(os, ctx.phases, "link.store_prepare", t)
  if !s.resolve_half(h).is_empty() {
    return None
  }
  t = lap(os, ctx.phases, "link.resolve", t)
  let el = s.layout()
  if !el.is_empty() {
    return Some(Err(el))
  }
  if !s.half_pins_ok(h) {
    return None
  }
  t = lap(os, ctx.phases, "link.layout", t)
  let r = s.write()
  let _t = lap(os, ctx.phases, "link.write", t)
  Some(r)
}

/// std's half for a PE store link with the prepare cache's file pf (as
/// half_file_for's), "" for none: the link's options that change std's
/// objects or their places (DWARF kept, a --race build's fixed base).
fn pe_half_file_for(pf: Str, debug: Bool, race: Bool) -> Str {
  if pf.is_empty() {
    return ""
  }
  let k = "pe\n${base_name(pf)}\n${debug}\n${race}\n"
  "${dir_name(dir_name(pf))}/stdhalf/${crypto.sha256(k.bytes()).to_hex()[0..40]}"
}

/// The PE half in f, marked used (pruned with the cache), or None.
fn pe_half_load(os: Os, f: Str) -> macho.PeHalf? {
  if f.is_empty() {
    return None
  }
  match cache_get(os, f) {
    Some(b) => macho.pe_half_decode(b)
    None => None
  }
}

/// std's half for an ELF store link with the prepare cache's file pf (as
/// half_file_for's), "" for none.
fn elf_half_file_for(pf: Str, opts: macho.ElfLinkOpts) -> Str {
  if pf.is_empty() || !opts.split_prog {
    return ""
  }
  let k = "elf\n${base_name(pf)}\n${opts.interp}\n${opts.entry}\n${opts.static}\n${opts.strip}\n${opts.release}\n${opts.debug_link}\n"
  "${dir_name(dir_name(pf))}/stdhalf/${crypto.sha256(k.bytes()).to_hex()[0..40]}"
}

/// The ELF half in f, marked used (pruned with the cache), or None.
fn elf_half_load(os: Os, f: Str) -> macho.ElfHalf? {
  if f.is_empty() {
    return None
  }
  match cache_get(os, f) {
    Some(b) => macho.elf_half_decode(b)
    None => None
  }
}

/// The ELF prepare cache's file for a store link through store (as
/// prep_file_for's, with macho.elf_prep_key), "" for none.
fn elf_prep_file(os: Os, store: Str, n: Int, prog: macho.ElfProg, opts: macho.ElfLinkOpts) -> Str {
  let dir = prep_dir(os, store)
  if dir.is_empty() {
    return ""
  }
  "${dir}/${crypto.sha256("${self_id(os)}\n${store}\n${n}\n".bytes() + macho.elf_prep_key(prog, opts)).to_hex()[0..40]}"
}

/// A store link from std's half h (decision 0409): None when the half
/// cannot give the full link's bytes (a program definition or common
/// symbol it does not know, std's fixed sections elsewhere: the program
/// gained a section kind and the header grew), the caller then links in
/// full.
fn link_from_half(os: Os, ctx: Ctx, parsed: macho.ParsedInputs, h: macho.StdHalf, opts: macho.LinkOpts, t0: Time) -> Result[(Bytes, Bytes), Str]? {
  var t = t0
  var s = macho.store_prepare_half(parsed, h, opts)
  t = lap(os, ctx.phases, "link.store_prepare", t)
  if !s.resolve_half(h).is_empty() {
    return None
  }
  t = lap(os, ctx.phases, "link.resolve", t)
  let el = s.layout()
  if !el.is_empty() {
    return Some(Err(el))
  }
  if !s.half_pins_ok(h) {
    return None
  }
  t = lap(os, ctx.phases, "link.layout", t)
  let es = s.synthesize()
  if !es.is_empty() {
    return Some(Err(es))
  }
  t = lap(os, ctx.phases, "link.synthesize", t)
  let r = s.write()
  let _t = lap(os, ctx.phases, "link.write", t)
  Some(r)
}

/// std's half for a store link with the prepare cache's file pf: beside
/// it in <backend cache>/stdhalf, keyed by pf's key and the options that
/// size the header or change std's bytes; "" for none (no prepare
/// cache, or the program's sections not their own: XO_STD_HALF=off).
fn half_file_for(os: Os, pf: Str, opts: macho.LinkOpts) -> Str {
  if pf.is_empty() || !opts.split_prog {
    return ""
  }
  let k = "${base_name(pf)}\n${opts.dylibs.join(",")}\n${opts.rpaths.join(",")}\n${opts.entry}\n${opts.embed_dwarf}\n${opts.dsym}\n${opts.std_parts.is_empty()}\n${opts.program_dwarf}\n${opts.strip}\n${opts.release}\n"
  "${dir_name(dir_name(pf))}/stdhalf/${crypto.sha256(k.bytes()).to_hex()[0..40]}"
}

/// The half in f, marked used (pruned with the cache), or None.
fn half_load(os: Os, f: Str) -> macho.StdHalf? {
  if f.is_empty() {
    return None
  }
  match cache_get(os, f) {
    Some(b) => macho.half_decode(b)
    None => None
  }
}

/// A full link's half written to f for the next link (tmp and rename).
fn half_save(os: Os, f: Str, s: macho.StoreLink) {
  if f.is_empty() {
    return
  }
  match s.capture_half() {
    Some(h) => {
      let b = macho.half_encode(h)
      cache_put(os, f, b)
      prune_backend_cache(os, "stdhalf", dir_name(dir_name(f)), b.len())
    }
    None => {}
  }
}

/// The prepare cache's directory for a separately compiled link through
/// std's store at store (macho prepcache.xo): beside std's entries in
/// the back-end cache, "" (no cache) when the store is not one std's
/// cache named by its content (only that name stands for its bytes
/// without hashing them) or XO_PREP_CACHE=off.
fn prep_dir(os: Os, store: Str) -> Str {
  let base = base_name(store)
  if store.is_empty() || (os.env.get("XO_PREP_CACHE") ?? "") == "off" || base.len() != 70 || !base.ends_with(".store") {
    return ""
  }
  "${dir_name(dir_name(store))}/prep"
}

/// The prepare cache's file for this link ("" for none): named by xo's
/// own identity, the store's path (named by its content) and length,
/// and macho.prep_key.
fn prep_file_for(os: Os, dir: Str, store: Str, n: Int, parsed: macho.ParsedInputs, opts: macho.LinkOpts) -> Str {
  if dir.is_empty() {
    return ""
  }
  "${dir}/${crypto.sha256("${self_id(os)}\n${store}\n${n}\n".bytes() + macho.prep_key(parsed, opts)).to_hex()[0..40]}"
}

/// The cached decisions in f, marked used (pruned with the cache), or
/// None.
fn prep_load(os: Os, f: Str) -> macho.Prep? {
  if f.is_empty() {
    return None
  }
  match cache_get(os, f) {
    Some(b) => macho.prep_decode(b)
    None => None
  }
}

/// A miss's decisions written to f for the next link (tmp and rename).
fn prep_save(os: Os, f: Str, s: macho.StoreLink) {
  if s.hit {
    return
  }
  prep_put(os, f, s.prep)
}

/// The PE link's prepare cache file ("" for none): as prep_file_for, keyed
/// by macho.coff_prep_key.
fn coff_prep_file(os: Os, dir: Str, store: Str, n: Int, prog: List[macho.CObj], entry: Str, dwtrim: Bool) -> Str {
  if dir.is_empty() {
    return ""
  }
  "${dir}/${crypto.sha256("${self_id(os)}\n${store}\n${n}\n".bytes() + macho.coff_prep_key(prog, entry, dwtrim)).to_hex()[0..40]}"
}

/// Decisions p written to f (tmp and rename) and counted in the back-end
/// cache's store accounting.
fn prep_put(os: Os, f: Str, p: macho.Prep) {
  if f.is_empty() {
    return
  }
  let b = macho.prep_encode(p)
  cache_put(os, f, b)
  // the back-end cache's store accounting (store-log, the prune's burst)
  prune_backend_cache(os, "prep", dir_name(dir_name(f)), b.len())
}

/// The code signature's page hashes (macho LinkOpts.hash_pages) on up to
/// 4 workers, 32 pages a claim: an HTTP server's image is about 1700
/// pages, hashed one after another 2.5 ms of its 23 ms store link
/// (2026-10-29).
fn par_page_hashes(b: Bytes, pages: List[(Int, Int)]) -> List[Bytes] {
  let n = pages.len()
  let chunk = 32
  let nc = (n + chunk - 1) / chunk
  let w = nc.min(4).max(1)
  let next = Atomic[Int].new(0)
  let parts = scope sc {
    var ts = []
    for _ in 0..w {
      ts.push(sc.spawn(fn() -> List[(Int, List[Bytes])] {
        var mine: List[(Int, List[Bytes])] = []
        while true {
          let c = next.add(1) - 1
          if c >= nc {
            break
          }
          let lo = c * chunk
          let hi = (lo + chunk).min(n)
          var hs: List[Bytes] = List.with_capacity(hi - lo)
          for i in lo..hi {
            let (s, e) = pages[i]
            hs.push(crypto.sha256(b[s..e]))
          }
          mine.push((c, hs))
        }
        mine
      }))
    }
    var all: List[(Int, List[Bytes])] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var by: List[List[Bytes]] = List.with_capacity(nc)
  for _ in 0..nc {
    by.push([])
  }
  for (c, hs) in parts {
    by[c] = hs
  }
  var out: List[Bytes] = List.with_capacity(n)
  for hs in by {
    for h in hs {
      out.push(h)
    }
  }
  out
}

/// std's part objects beside a separately compiled link's store (decision
/// 0401: its debug map names them), "" when there are none (another
/// target's store, or one the cache made before it kept them).
fn std_parts_dir(os: Os, store: Str) -> Str {
  if store.is_empty() {
    return ""
  }
  let d = "${store}.parts"
  // xo:allow XO0903 none: the link embeds std's DWARF as before
  if os.fs.exists("${d}/prog-darwin.0.o").ok() ?? false { d } else { "" }
}

/// The program's objects kept for a separately compiled link's debug map
/// (decision 0401): each copied once to the back-end cache's dbgobj/,
/// named by its bytes' SHA-256 (the same object, the same path), and
/// marked used by every link that names it (the map gives it time 0, so
/// lldb reads it whatever its mtime); (input path, kept path) each. None
/// without std's parts beside the store (no map).
fn prog_debug_objects(os: Os, store: Str, ins: List[macho.LinkInput]) -> List[(Str, Str)] {
  if std_parts_dir(os, store).is_empty() {
    return []
  }
  let dir = "${dir_name(dir_name(store))}/dbgobj"
  os.fs.create_dir_all(dir).ignore_err("the map then names objects that are not there: lldb shows no program variables")
  var out: List[(Str, Str)] = []
  for inp in ins {
    let kept = "${dir}/${crypto.sha256(inp.data).to_hex()[0..32]}.o"
    // xo:allow XO0903 a first build writes it
    if os.fs.exists(kept).ok() ?? false {
      prune.mark_used_within(os.fs, os.clock, kept, BACKEND_TOUCH)
    } else {
      let tmp = "${kept}.tmp-${os.rand.bytes(6).to_hex()}"
      if os.fs.write(tmp, macho.debug_map_object(inp.data)).is_ok() {
        os.fs.rename(tmp, kept).ignore_err("another build kept it")
      }
      os.fs.remove(tmp).ignore_err("renamed, or a failed write")
    }
    out.push((inp.path, kept))
  }
  out
}
