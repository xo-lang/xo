// Tests of the `use c` adapter compile (cffi.xo).

test "a failed adapter compile names the header and the C declaration" {
  let src = "/c/build/arm64/w-1/cffi/xo_c_nmc_e4.c"
  let data = "// Code generated by xo bind --c from C header nmc.h. DO NOT EDIT.\n// Adapters with the calling convention of the native runtime (decision 0116).\n\n#include \"nmc.h\"\n\n// int64_t nmc_self(int64_t nmc_self)\nint64_t xo_c_nmc_self(int64_t xo_a0) {\n\treturn 0;\n}\n\n// struct nmc_buf nmc_bytes(int64_t n, int64_t v)\nvoid *xo_c_nmc_bytes(int64_t xo_a0, int64_t xo_a1, int64_t *xo_len) {\n\tint64_t n = 0;\n}\n".bytes()
  let out = "${src}:13:10: error: redefinition of 'n'\n1 error generated.\n"
  let note = adapter_note(src, data, out)
  expect(note.contains("`use c \"nmc.h\"`")) == true
  expect(note.contains("`struct nmc_buf nmc_bytes(int64_t n, int64_t v)`")) == true
  // a program's own C file, and output naming no line, have no note
  expect(adapter_note("/w/prog/nmc.c", data, "/w/prog/nmc.c:3:1: error: x\n")) == ""
  expect(adapter_note(src, data, "ld: error\n")) == ""
}
