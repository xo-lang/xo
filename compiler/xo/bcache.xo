// The back-end cache (decision 0220 addendum) in <user cache>/xo/backend
// ($XO_BACKEND_CACHE_DIR): obj/, the objects of the parts of a split arm64
// assembly by the hash of their assembly and the assembler's identity
// (stage A), and fn/, the canonical texts of functions by the hash of
// what their code depends on (stage B, compiler/arm64 fcache.xo).
// $XO_BACKEND_CACHE: on (the default), verify (every function generated
// and compared with its entry; a difference fails the build), off. Entries
// are files named by their key, marked used and pruned by compiler/prune
// (decision 0223).

use github.com/xo-lang/xo/compiler/arm64
use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/lexer
use github.com/xo-lang/xo/compiler/parser
use github.com/xo-lang/xo/compiler/prune
use github.com/xo-lang/xo/compiler/ssa
use std/crypto
use std/internal

/// $XO_BACKEND_CACHE: "off", "verify", or "on" (the default).
fn backend_cache_mode(os: Os) -> Str {
  let v = os.env.get("XO_BACKEND_CACHE") ?? ""
  if v == "off" || v == "verify" { v } else { "on" }
}

/// The cache's directory, "" when it is off.
fn backend_cache_dir(os: Os, ctx: Ctx) -> Str {
  if backend_cache_mode(os) == "off" {
    return ""
  }
  let d = os.env.get("XO_BACKEND_CACHE_DIR") ?? ""
  if !d.is_empty() {
    return d
  }
  "${ctx.cache}/xo/backend"
}

/// The identity of the running compiler: the SHA-256 of its executable;
/// "" when it cannot be read (the cache is then not used).
///
/// Memoized in the cache's selfid/ directory under the hash of the
/// executable's path, size, and modified time (a rebuilt or replaced
/// binary has another): hashing the 54 MB executable took about 0.1 s,
/// and three phases (rc_cached, fn_cache_load, the assembly parts) did it
/// on every build (2026-10-15). A limit: an executable rewritten in
/// place within the same millisecond at the same size keeps the old
/// identity (FileInfo has no inode or change time; xobuild and seed
/// installs write a new file); XO_BACKEND_CACHE=off avoids the memo.
/// The identity the backend caches key on (decision 0275): the code
/// generation key stamped into this xo, so its entries are shared with
/// every xo built from the same backend sources; xo's own binary
/// (self_id) when unstamped. The binary and test run caches keep
/// self_id: a link and a test run read the driver too.
fn cache_id(os: Os) -> Str {
  let id = if XO_CODEGEN_KEY.len() == 64 { "codegen ${XO_CODEGEN_KEY}" } else { self_id(os) }
  // a separately compiled build (decision 0388 stage 3) by the facts it
  // read: its entries are not a whole-program build's
  let sp = sepcomp_facts_path(os)
  if id.is_empty() || sp.is_empty() {
    return id
  }
  // each facts file by its path, size and time, hashed only while its
  // time is within Go's 2 s settling window (check.stamp_files): every
  // cache asks for the id, and hashing the facts each time cost about
  // 4 ms a build
  let (f0, f1) = sepcomp_fact_files(os, sp)
  let stamps = match check.stamp_files(os.fs, [f0, f1].filter(fn(f) { !f.is_empty() }), os.clock.now().unix_millis()) {
    Some(ss) => ss
    None => return id
  }
  var b = StrBuilder.new()
  for st in stamps {
    b.write("${st.path.len()}:${st.path} ${st.size} ${st.mtime} ${st.sha}\n")
  }
  "${id} sepcomp ${crypto.sha256(b.freeze().bytes()).to_hex()}"
}

/// XO_SEPCOMP_FACTS when XO_SEPCOMP=1, else "".
fn sepcomp_facts_path(os: Os) -> Str {
  if (os.env.get("XO_SEPCOMP") ?? "") != "1" {
    return ""
  }
  os.env.get("XO_SEPCOMP_FACTS") ?? ""
}

fn self_id(os: Os) -> Str {
  let p = check.executable(os.env, os.fs)
  if p.is_empty() {
    return ""
  }
  var memo = ""
  match os.fs.stat(p) {
    Ok(Some(st)) => {
      let dir = backend_cache_dir(os, Ctx{goos: host_os(os), std: "", xo: "", cache: user_cache_dir(os, host_os(os))})
      if !dir.is_empty() {
        let k = crypto.sha256("xo self id v1\n${p.len()}:${p}\n${st.size}\n${st.modified.unix_millis()}\n".bytes()).to_hex()
        memo = "${dir}/selfid/${k}"
        match os.fs.read(memo) {
          Ok(b) => {
            let id = b.to_str() ?? ""
            if id.len() == 64 {
              return id
            }
          }
          // xo:allow XO0903 a memo: a failed read hashes the binary again
          Err(_) => {}
        }
      }
    }
    _ => {}
  }
  let id = match os.fs.read(p) {
    Ok(b) => crypto.sha256(b).to_hex()
    // xo:allow XO0903 no id: the build runs without the backend cache
    Err(_) => ""
  }
  if !memo.is_empty() && !id.is_empty() {
    cache_put(os, memo, id.bytes())
  }
  id
}

/// The per-function cache of an arm64 generation of m for tgoos (stage
/// B, compiler/arm64 fcache.xo): every function's key and the entries the
/// cache holds for them, and the cache directory; none (an empty
/// FnCache, "") when the cache is off, for a --release build, or for a
/// module of one part. The entries come through the target's pack
/// (cache_get_packed), which fn_cache_store updates.
/// pre: the keys when the caller has them (verify_after_dce's, of this
/// module), else [].
fn fn_cache_load(os: Os, ctx: Ctx, m: ssa.Module, tgoos: Str, jobs: Int, release: Bool, pre: List[Str]) -> (arm64.FnCache, Str, Pack) {
  let dir = backend_cache_dir(os, ctx)
  if dir.is_empty() || release {
    return (arm64.FnCache{}, "", Pack{})
  }
  let id = cache_id(os)
  if id.is_empty() {
    return (arm64.FnCache{}, "", Pack{})
  }
  let keys = if pre.is_empty() { arm64.function_keys(m, tgoos, id, jobs) } else { pre }
  if keys.is_empty() {
    return (arm64.FnCache{}, "", Pack{})
  }
  let verify = backend_cache_mode(os) == "verify"
  let target = "${tgoos}-${m.goarch}"
  // the parts first (stage D 2e, compiler/arm64 partcache.xo): a part
  // read from its entry needs none of its functions' entries
  let pkeys = arm64.part_keys(m, tgoos, keys)
  let (pents, ppk) = cache_get_packed(os, dir, "part", target, pkeys, jobs)
  var want = keys
  if !verify && !pkeys.is_empty() {
    let plist = arm64.part_ranges(m)
    want = []
    for p in 0..pkeys.len() {
      if !pkeys[p].is_empty() && pents.contains(pkeys[p]) {
        continue
      }
      for fi in plist[p] {
        want.push(keys[fi])
      }
    }
  }
  let (entries, pk) = cache_get_packed(os, dir, "fn", target, want, jobs)
  // pk whole: its shared pack fields too (a Pack literal of the other fields
  // left fn out of the shared and the cold-pack stores: fn was 313 GB loose
  // and 177 GB in target packs of the store-log's 2,205 GB, 2026-10-24)
  var fpk = pk
  fpk.parts = ppk
  (arm64.FnCache{keys: keys, entries: entries, verify: verify, part_keys: pkeys, part_entries: pents}, dir, fpk)
}

/// Stores the entries a cached generation made (fn_cache_load's dir),
/// functions' and parts', and updates the target's packs with them and
/// the hits of fc. first_parts: a module of fewer than PART_PACK_FIRST
/// parts, or of parts under PART_PACK_FIRST_BYTES in all, packs them on
/// the target's first build (a build the run cache keys: its unchanged
/// rebuilds never reach the back end, so its first edit regenerated every
/// part, 2026-10-21; the HTTP server's 35 parts, 2026-10-27).
fn fn_cache_store(os: Os, dir: Str, pk: Pack, fc: arm64.FnCache, stores: List[(Str, Bytes)], part_stores: List[(Str, Bytes)], first_parts: Bool) {
  if dir.is_empty() {
    return
  }
  pack_store(os, pk, fc.entries, stores)
  // parts only in the target's pack: a part is one program's (its split,
  // its namespace), and its text is large (xo: 34 parts, 328 MB), so
  // no loose copy for other programs to share
  if let Some(pp) = pk.parts {
    if pp.fresh && first_parts && !part_stores.is_empty() && (fc.part_keys.len() < PART_PACK_FIRST || parts_bytes(part_stores) < PART_PACK_FIRST_BYTES) {
      // a small test module's parts on the target's first build: they
      // have no loose copies to come back from. A large module's wait
      // for the second build: xo's (650 MB) written by every gate's
      // self-build in a new worktree were never read again (a rebase
      // keeps none of them either), 27 GB an hour of the prune's churn
      // (2026-10-22)
      os.fs.create_dir_all(pp.dir).ignore_err("no pack: the parts are made again")
      pack_write(os, pp, part_stores)
    } else {
      pack_store(os, pp, fc.part_entries, part_stores)
    }
  }
  if stores.is_empty() {
    return
  }
  let n = store_entries(os, dir, "fn", pk, stores)
  prune_backend_cache(os, "fn", dir, n)
}

/// insert_rc through the per-function cache (stage C, compiler/ssa
/// rccache.xo) in <user cache>/xo/backend/rc; the plain insert_rc_jobs
/// when the cache is off, for a --release build, or for a module under
/// 256 functions. verify computes every function and fails the build
/// when an entry differs. Returns the functions' keys, [] when the cache
/// is not used (the inliner's cache chains them, stage D part 2a).
/// lazy (the arm64 and amd64 backends, whose inliner forces what it
/// reads, stage D 2b): a hit whose inline summary the cache also holds
/// (sum/, same key) is left undecoded (ssa Module.lazy); the summaries
/// of the other functions are stored for the next build.
fn rc_cached(os: Os, var b: ssa.Builder, release: Bool, jobs: Int, phases: Bool, lazy: Bool) -> List[Str] {
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  // (with XO_PASSES, either way, the entries' keys do not say which
  // passes ran; passes_changed reads both - and + names)
  if dir.is_empty() || release || b.m.funcs.len() < 256 || passes_changed(os) {
    no_std_facts_dump(os)
    b.insert_rc_jobs(jobs)
    return []
  }
  let id = cache_id(os)
  if id.is_empty() {
    no_std_facts_dump(os)
    b.insert_rc_jobs(jobs)
    return []
  }
  var t = os.clock.now()
  let t0 = t
  // insert_rc_plan, its two halves timed
  // the borrow inference incremental over the target's record of the
  // last build's flags (decision 0283 stage A); in full with verify.
  // XO_BORROW_CHECK=1 also runs the full one and fails the build when
  // the flags differ
  let bpath = borrow_record_path(os, dir, b.m.goarch)
  let full_mode = backend_cache_mode(os) == "verify"
  let check = (os.env.get("XO_BORROW_CHECK") ?? "") == "1"
  let (r0, rec, nd, same) = if full_mode { (b.rc_prepare(jobs), {}, b.m.funcs.len(), true) } else { b.rc_prepare_incr(jobs, id, borrow_record_read(os, bpath), check) }
  if !same {
    fail(os, "XO_BORROW_CHECK=1: the incremental borrow inference differs from the full one (${nd} of ${b.m.funcs.len()} functions inferred)")
  }
  if !full_mode {
    borrow_record_write(os, bpath, rec)
  }
  if phases {
    os.stdio.eprintln("cache borrows ${b.m.funcs.len() - nd}/${b.m.funcs.len()} kept")
  }
  t = lap(os, phases, "insert_rc.borrows", t)
  var r = r0
  if !full_mode {
    // decision 0322 (rc_prepare applies it itself)
    r.apply_uniq(b.m)
  }
  t = lap(os, phases, "insert_rc.uniq_var_params", t)
  let tk = ssa.type_keys(b.m)
  t = lap(os, phases, "insert_rc.types", t)
  let plan = b.insert_rc_keys(r, tk, id, jobs)
  t = lap(os, phases, "insert_rc.keys", t)
  let _p = lap(os, phases, "insert_rc.plan", t0)
  let (entries, pk) = cache_get_packed(os, dir, "rc", b.m.goarch, plan.keys, jobs)
  let (sums, spk) = if lazy { cache_get_packed(os, dir, "sum", b.m.goarch, plan.keys, jobs) } else { ({}, Pack{}) }
  t = lap(os, phases, "insert_rc.read", t)
  let out = b.insert_rc_apply(plan, entries, sums, backend_cache_mode(os) == "verify", jobs)
  // decision 0388: std's facts from this whole-program build, in stdf's
  // codec (the stand-in for std's object builder's, and what it must
  // write for the same std and flags)
  let sfd = os.env.get("XO_STD_FACTS_DUMP") ?? ""
  if !sfd.is_empty() {
    let fs = ssa.std_facts_of_std(b.m, b, plan)
    match os.fs.write(sfd, ssa.encode_std_facts(fs)) {
      Ok(_) => {}
      Err(e) => fail(os, "XO_STD_FACTS_DUMP=${sfd}: ${e}")
    }
    if phases {
      var nb = 0
      for x in fs {
        if x.borrowed.any(fn(v) { v }) {
          nb += 1
        }
      }
      os.stdio.eprintln("stdf ${fs.len()} std functions written to ${sfd} (${nb} with a borrowed parameter)")
    }
  }
  // decision 0388: std's object builder's facts against this whole-program
  // build's, by name: a calling convention that differs (borrowed or var
  // parameters, catches) or a fact less conservative fails the build
  let sfv = os.env.get("XO_STD_FACTS_VERIFY") ?? ""
  if !sfv.is_empty() {
    let got = match os.fs.read(sfv) {
      Ok(d) => {
        match ssa.decode_std_facts(d) {
          Some(fs) => fs
          None => fail(os, "XO_STD_FACTS_VERIFY=${sfv}: not std facts of ${ssa.STD_FACTS_VERSION}")
        }
      }
      Err(e) => fail(os, "XO_STD_FACTS_VERIFY=${sfv}: ${e}")
    }
    let d = ssa.diff_std_facts(ssa.std_facts_of_std(b.m, b, plan), got)
    if !d.errors.is_empty() {
      fail(os, "XO_STD_FACTS_VERIFY=${sfv}: ${d.errors.len()} of the ${d.common} std functions both name differ from this build's, the first: ${d.errors[0]}")
    }
    if phases {
      var kinds: List[Str] = []
      for (k, ns) in d.conservative {
        kinds.push("${k} ${ns.len()}")
      }
      os.stdio.eprintln("stdf verify: ${d.common} std functions, 0 errors; more conservative: ${if kinds.is_empty() { "none" } else { kinds.join(", ") }}")
    }
  }
  t = lap(os, phases, "insert_rc.apply", t)
  pack_store(os, pk, entries, out.stores)
  if lazy {
    // the summaries of the functions decoded or computed here, on tasks
    // (a cold build of xo: every function, 1.7 s on one)
    var todo: List[Int] = []
    for (fi, k) in plan.keys.indexed() {
      if !k.is_empty() && !b.m.lazy.contains(fi) && !sums.contains(k) {
        todo.push(fi)
      }
    }
    let new_sums = sums_of(b.m, plan.keys, todo, jobs)
    let sn = store_entries(os, dir, "sum", spk, new_sums)
    pack_store(os, spk, sums, new_sums)
    if sn > 0 {
      prune_backend_cache(os, "sum", dir, sn)
    }
    if phases {
      os.stdio.eprintln("cache rc ${b.m.lazy.len()}/${plan.keys.len()} undecoded")
    }
    t = lap(os, phases, "insert_rc.sums", t)
  }
  let n = store_entries(os, dir, "rc", pk, out.stores)
  if !out.stores.is_empty() {
    prune_backend_cache(os, "rc", dir, n)
  }
  cache_note(os, phases, "rc", out.reused, plan.keys.len())
  if !out.mismatches.is_empty() {
    fail(os, "XO_BACKEND_CACHE=verify: ${out.mismatches.len()} functions' reference counting differs from their cache entries, the first ${out.mismatches[0]}")
  }
  plan.keys
}

/// The build target's record of the last build's borrowed flags for
/// the incremental borrow inference (ssa rc_prepare_incr, decision 0283
/// stage A): pack <slot>/borrow/list, a body hash and its flags a line.
fn borrow_record_path(os: Os, dir: Str, goarch: Str) -> Str {
  "${pack_dir(os, dir, "borrow", goarch)}/list"
}

fn borrow_record_read(os: Os, path: Str) -> Map[Str, List[Bool]] {
  var prev: Map[Str, List[Bool]] = {}
  for line in ((os.fs.read(path).ok() ?? b"").to_str() ?? "").split("\n") {
    let sp = line.split(" ")
    if sp.len() == 2 {
      var fl: List[Bool] = []
      for c in sp[1].bytes() {
        fl.push(c == 0x31)
      }
      prev[sp[0]] = fl
    }
  }
  prev
}

fn borrow_record_write(os: Os, path: Str, rec: Map[Str, List[Bool]]) {
  var w = StrBuilder.new()
  for (h, fl) in rec {
    w.write(h)
    w.write(" ")
    for x in fl {
      w.write(if x { "1" } else { "0" })
    }
    w.write("\n")
  }
  cache_put(os, path, w.freeze().bytes())
}
/// The version of std_tree_sum's hash (its memo's signature).
const STD_SUM_VERSION = "xo std sum v4 (interfaces from tokens, per file)"

/// The hash of every std source under dir (its .xo files, by path
/// relative to dir and interface: parser.iface_text, the tokens outside
/// function and test bodies, without comments or layout): the front end
/// cache's key of a std body (ssa fe_keys), the same for every program. A
/// comment or body edit in std keeps it (2026-10-21: the full sources
/// were hashed, so a comment added to json.xo missed every std body of
/// every program); the edited body's own key, its text, changes. "" when
/// dir cannot be walked (std bodies then share no key with another build).
/// Each file's interface hash is kept in the cache
/// (cache/stdsums/<hash of dir>, a line per file: path, size, modification
/// time, hash) and computed again only for a file whose size or time
/// differs or that changed in the last 2 s (a change within one clock
/// tick): an edit to one std file parsed every std file again, 0.8 to
/// 1.9 s of the next build (2026-10-21).
fn std_tree_sum(os: Os, dir: Str, cache: Str) -> Str {
  let all = match os.fs.walk(dir) {
    Ok(fs) => fs
    Err(_) => return ""
  }
  let memo = "${cache}/stdsums/${crypto.sha256(dir.bytes()).to_hex()[0..32]}"
  var known: Map[Str, (Str, Str)] = {}
  if !cache.is_empty() {
    // xo:allow XO0903 a memo: a failed read hashes the files again
    let text = (os.fs.read(memo).ok() ?? b"").to_str() ?? ""
    let lines = text.split("\n")
    if !lines.is_empty() && lines[0] == STD_SUM_VERSION {
      for line in lines[1..lines.len()] {
        let f = line.split(" ")
        if f.len() == 4 {
          known[f[0]] = ("${f[1]} ${f[2]}", f[3])
        }
      }
    }
  }
  let recent = os.clock.now().unix_millis() - 2000
  var files: List[(Str, Str, Bool)] = []
  for fi in all {
    if !fi.is_dir && fi.path.ends_with(".xo") {
      files.push((fi.path, "${fi.size} ${fi.modified.unix_millis()}", fi.modified.unix_millis() >= recent))
    }
  }
  var h = BytesBuilder.new()
  h.write_str("${STD_SUM_VERSION}\n")
  var out = StrBuilder.new()
  out.write("${STD_SUM_VERSION}\n")
  var changed = false
  for (p, st, fresh_edit) in files.sort_by(fn(f) { f.0 }) {
    // relative: std's own paths have no spaces, the memo's separator
    let rel = p.trim_prefix("${dir}/")
    var fh = ""
    if let Some((kst, kh)) = known.get(rel) {
      if kst == st && !fresh_edit {
        fh = kh
      }
    }
    if fh.is_empty() {
      match os.fs.read(p) {
        // the tokens alone (iface_text_lex): a parse of every std file
        // took 0.8 to 1.9 s of a cold build (2026-10-21)
        Ok(b) => fh = crypto.sha256(parser.iface_text_lex(b)).to_hex()
        Err(_) => return ""
      }
      changed = true
    }
    h.write_str("${rel} ${fh}\n")
    if !fresh_edit {
      out.write("${rel} ${st} ${fh}\n")
    }
  }
  if (changed || known.len() != files.len()) && !cache.is_empty() {
    cache_put(os, memo, out.freeze().bytes())
  }
  crypto.sha256(h.freeze()).to_hex()
}

/// The program c checked, for the front end cache's hint: its root
/// modules' paths and absolute directories (a root's dir is as named,
/// "." for most builds).
fn fe_program_id(os: Os, c: check.Checker) -> Str {
  // xo:allow XO0903 the working directory from $PWD when getcwd fails
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  var b = StrBuilder.new()
  for md in c.mods {
    if md.root {
      b.write("${md.path} ${abs_of(wd, md.dir)}\n")
    }
  }
  b.freeze()
}

/// The SSA builder through the front end cache (decision 0220 addendum
/// stage 2, compiler/ssa fecache.xo): the keys of the program's bodies,
/// their entries from the target's "fe" pack, the build, then the new
/// entries stored. Without the cache, ssa.build_program_cpu.
/// The root as the front end cache's keys of the program's own bodies
/// see it: with the build's stamps (decision 0264), which replace const
/// literals of the root modules after the check (stamp.xo), so a body
/// that reads one is keyed by its stamped value, not the source text.
/// std bodies never see stamps; their keys do not read the root's text.
fn stamp_root(root: Str, stamps: List[(Str, Str)]) -> Str {
  if stamps.is_empty() {
    return root
  }
  var b = StrBuilder.new()
  for (n, v) in stamps.sort_by(fn(s) { s.0 }) {
    b.write("${n.len()}:${n}=${v.len()}:${v}\n")
  }
  "${root}\nstamps ${crypto.sha256(b.freeze().bytes()).to_hex()}"
}

/// What the front end cache's keys hash of the build's settings besides
/// the compiler's identity: the checker's and the builder's flags; the
/// cleanup cache's keys hash it too (decision 0382).
fn fe_settings(c: check.Checker, root: Str, tests: Bool, release: Bool, real: Bool, tgoos: Str, tgoarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace: Bool, soft_cpu: Bool, heap_guard: Bool) -> Str {
  "maplog=${c.map_log}\nmapcore=${c.map_core}\nmapbr=${c.map_branch}\nnopreempt=${c.no_preempt}\ndet=${c.det}\nsettings=${c.set_debug_contracts},${c.set_dbg},${c.set_error_args},${c.set_trace}\ndwarf=${c.dwarf}\ninlstr=${c.inline_str}\nrace=${c.race}\nasync=${c.async_preempt_ok}\n${ssa.fe_flags(root, tests, release, real, tgoos, tgoarch, wasm, nolibc, prof, trace, soft_cpu, heap_guard)}"
}

/// add_landings and cleanup through the cleanup cache (decision 0382,
/// default on since 2026-10-27, XO_CHAIN_KEYS=0 turns it off): after
/// fold_known_calls, each function's
/// cln key (ssa clncache.xo); a function whose entry decodes takes its
/// form after the cleanup from the entry and neither pass runs for it;
/// the others run as before and are stored, but for one whose landings
/// grew the module. verify runs both passes on every function and fails
/// the build when a function's entry differs. The plain passes when it is
/// off, the cache is off, for a --release build, for a module under 256
/// functions, or with XO_PASSES.
fn landings_cleanup_cached(os: Os, var b: ssa.Builder, release: Bool, settings: Str, jobs: Int, phases: Bool) {
  var t = os.clock.now()
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  let id = if (os.env.get("XO_CHAIN_KEYS") ?? "") == "0" || dir.is_empty() || release || b.m.funcs.len() < 256 || !b.m.passes_off.is_empty() { "" } else { cache_id(os) }
  if id.is_empty() {
    b.add_landings()
    t = lap(os, phases, "add_landings", t)
    b.cleanup_all_jobs(jobs)
    let _t = lap(os, phases, "cleanup", t)
    return
  }
  let verify = backend_cache_mode(os) == "verify"
  let faults = ssa.cln_faults(b.m)
  let tk = ssa.type_keys(b.m)
  let flags = b.cln_flags("${settings}\nimm=${b.imm_rc} nolibc=${b.m.nolibc_start},${b.m.nolibc} opv=${b.m.op_verify}")
  let facts = b.cln_facts()
  let keys = ssa.cln_keys(b.m, faults, tk, id, flags, facts, jobs)
  t = lap(os, phases, "cln.keys", t)
  let (entries, pk) = cache_get_packed(os, dir, "cln", b.m.goarch, keys, jobs)
  let hits = ssa.cln_hits(b.m, keys, entries, jobs)
  t = lap(os, phases, "cln.read", t)
  // the full key of each body an entry is stored for (a miss), and with
  // verify of every one: an entry whose full key is not this body's was
  // found by a key that left out an input
  var fidx: List[Int] = []
  for (fi, k) in keys.indexed() {
    if verify || !entries.contains(k) {
      fidx.push(fi)
    }
  }
  let full = ssa.cln_full_keys(b.m, faults, tk, id, flags, facts, fidx, jobs)
  var bad: List[Str] = []
  if verify {
    for (fi, k) in keys.indexed() {
      if let Some(old) = entries.get(k) {
        if ssa.cln_full_of(old) != (full.get(fi) ?? "") {
          bad.push("${b.m.funcs[fi].name} (its key matched an entry made from another body: the key leaves out an input)")
        }
      }
    }
  }
  var skip: Map[Int, Bool] = {}
  if !verify {
    for (fi, _) in hits {
      skip[fi] = true
    }
  }
  let grew = b.add_landings_with(faults, skip)
  t = lap(os, phases, "add_landings", t)
  b.cleanup_skip_jobs(jobs, skip)
  t = lap(os, phases, "cleanup", t)
  var todo: List[Int] = []
  for fi in 0..keys.len() {
    if !skip.contains(fi) && !grew[fi] {
      todo.push(fi)
    }
  }
  var stores: List[(Str, Bytes)] = []
  // each function's entry as the cleanup left it, for its body id
  var ents: Map[Int, Bytes] = {}
  for (fi, e) in ssa.cln_encode(b.m, todo, jobs) {
    ents[fi] = e
    let k = keys[fi]
    match entries.get(k) {
      Some(old) => {
        if verify && ssa.cln_body(old) != e {
          bad.push(b.m.funcs[fi].name)
        }
      }
      None => stores.push((k, ssa.cln_seal(e, full.get(fi) ?? "")))
    }
  }
  for (fi, g) in hits {
    if !verify {
      b.m.funcs[fi] = g
      ents[fi] = ssa.cln_body(entries.get(keys[fi]) ?? b"")
    }
  }
  // each function's body id, which the reference counting's keys hash in
  // place of the body: the hash of what the cleanup left (its entry, by
  // content, not by the key that found it: a cold build that runs its
  // front end twice keyed one body two ways, 2026-10-27); one whose
  // landings grew the module, or that an entry cannot hold, is keyed by
  // its body
  b.m.body_ids = ssa.body_ids_of(b.m, ents, tk, jobs)
  pack_store(os, pk, entries, stores)
  let n = store_entries(os, dir, "cln", pk, stores)
  if !stores.is_empty() {
    prune_backend_cache(os, "cln", dir, n)
  }
  cache_note(os, phases, "cln", skip.len(), keys.len())
  let _t = lap(os, phases, "cln.store", t)
  if !bad.is_empty() {
    fail(os, "XO_BACKEND_CACHE=verify: ${bad.len()} functions' landings and cleanup differ from their cache entries, the first ${bad[0]}")
  }
}

fn fe_cached_build(os: Os, c: check.Checker, root: Str, tests: Bool, release: Bool, real: Bool, tgoos: Str, tgoarch: Str, wasm: Bool, nolibc: Bool, prof: Bool, trace: Bool, soft_cpu: Bool, heap_guard: Bool, phases: Bool, stamps: List[(Str, Str)]) -> ssa.Builder {
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  let id = if dir.is_empty() || (os.env.get("XO_FE_CACHE") ?? "") == "off" { "" } else { cache_id(os) }
  // decision 0388: XO_STD_CONC=0|1 fixes the unwinding checks (std's
  // object and facts, one per variant)
  let conc_fixed = match os.env.get("XO_STD_CONC") ?? "" {
    "0" => 0
    "1" => 1
    _ => -1
  }
  if id.is_empty() {
    return ssa.build_program_fe(c, root, tests, release, real, tgoos, tgoarch, wasm, nolibc, prof, trace, soft_cpu, heap_guard, ssa.FeCache{conc_fixed: conc_fixed})
  }
  var t = os.clock.now()
  var fe = ssa.FeCache{on: true, verify: backend_cache_mode(os) == "verify", break_name: os.env.get("XO_FE_BREAK") ?? "", recorder: self_id(os)}
  fe.keys = ssa.fe_keys(c, "${id}\n${fe_settings(c, root, tests, release, real, tgoos, tgoarch, wasm, nolibc, prof, trace, soft_cpu, heap_guard)}", stamp_root(root, stamps), std_tree_sum(os, c.std_root(), dir))
  t = lap(os, phases, "fe.keys", t)
  // the own flags the last build of this program ended with (a hint):
  // read that variant and start as it did; with none (its first build)
  // read both common variants
  let fl = ssa.fe_flags(root, tests, release, real, tgoos, tgoarch, wasm, nolibc, prof, trace, soft_cpu, heap_guard)
  let hint_path = "${dir}/fe-hint/${crypto.sha256("${id}\n${fl}\n${fe_program_id(os, c)}".bytes()).to_hex()[0..32]}"
  // xo:allow XO0903 a hint: with none the build reads both common variants
  var hint = (os.fs.read(hint_path).ok() ?? b"").to_str() ?? ""
  let own_hint = !hint.is_empty()
  if hint.is_empty() {
    // a program the cache has not seen here (a new directory: the
    // program's id names its directory) starts as the last build of any
    // program did (decision 0351): reading both variants doubled its
    // lookups, and one variant is never stored (5,389 failed opens for
    // hello); a wrong guess only misses
    // xo:allow XO0903 a hint: with none the build reads both common variants
    hint = (os.fs.read("${dir}/fe-hint/last").ok() ?? b"").to_str() ?? ""
  }
  let owns = if hint.is_empty() { ssa.fe_common_owns() } else { [hint] }
  fe.start_conc = hint.starts_with("conc=true ")
  fe.conc_fixed = conc_fixed
  var keys: List[Str] = []
  for (_, k) in fe.keys {
    for own in owns {
      keys.push(ssa.fe_variant(k, own))
    }
  }
  let (entries0, pk0) = cache_get_packed(os, dir, "fe", "${tgoos}/${tgoarch}", keys, 8)
  var entries = entries0
  var pk = pk0
  fe.entries = entries
  t = lap(os, phases, "fe.read", t)
  var b = ssa.build_program_fe(c, root, tests, release, real, tgoos, tgoarch, wasm, nolibc, prof, trace, soft_cpu, heap_guard, fe)
  var tries = 0
  while !b.fe.bad.is_empty() {
    // an entry whose checks passed and whose commit did not (a front end
    // cache bug, never a silent difference): the build is dropped and
    // made again without it, the body built fresh replaces the entry and
    // the pack is rewritten without the old one; a third failure builds
    // without entries (gotchas/fe-cache-entry-does-not-replay.md)
    tries += 1
    // the dropped build's counts (XO_FE_STATS=1): its misses name why an
    // entry's replay failed (a closure's own entry that misses fails it),
    // and only the final build's counts are printed after
    if (os.env.get("XO_FE_STATS") ?? "") == "1" {
      for (k, v) in b.fe_stats {
        os.stdio.eprintln("fe dropped ${k} ${v}")
      }
    }
    for x in b.fe.bad {
      // "KEY (FUNCTION, recorded by xo ID)"; this xo is self_id
      let k = x.split(" ")[0]
      // the entry kept for a look (which xo wrote it, what it needs):
      // $XO_FE_KEEP_DIR, else the cache's fe-bad directory
      let keep = os.env.get("XO_FE_KEEP_DIR") ?? "${dir}/fe-bad"
      let kept = "${keep}/${k}"
      if let Some(d) = fe.entries.get(k) {
        cache_put(os, kept, d)
      }
      os.stdio.eprintln("xo: warning: the front end cache entry ${x} did not replay in xo ${fe.recorder} (kept as ${kept}); building again without it")
      let _ = fe.entries.remove(k)
      let _ = entries.remove(k)
    }
    if tries >= 3 {
      fe.entries = {}
    }
    pk.compact = true
    b = ssa.build_program_fe(c, root, tests, release, real, tgoos, tgoarch, wasm, nolibc, prof, trace, soft_cpu, heap_guard, fe)
  }
  t = lap(os, phases, "fe.build", t)
  if c.mod_skip_auto && !b.skip_src.is_empty() {
    // a skipped module's body was built from source (XO_CHK_CACHE=auto):
    // build_native drops this build, so none of it is stored
    return b
  }
  // the entries of bodies that made closures, with their closures'
  b.fe_finalize()
  let fin = b.fe_final_own()
  if fin != hint || !own_hint {
    cache_put(os, hint_path, fin.bytes())
  }
  if fin != hint {
    cache_put(os, "${dir}/fe-hint/last", fin.bytes())
  }
  let n = store_entries(os, dir, "fe", pk, b.fe.stores)
  pack_store(os, pk, entries, b.fe.stores)
  if n > 0 {
    prune_backend_cache(os, "fe", dir, n)
  }
  if phases {
    os.stdio.eprintln("cache fe ${b.fe.hits}/${b.fe.hits + b.fe.misses} bodies")
  }
  if !b.fe.mismatches.is_empty() {
    fail(os, "XO_BACKEND_CACHE=verify: ${b.fe.mismatches.len()} function bodies' SSA differs from their front end cache entries, the first ${b.fe.mismatches[0]}")
  }
  // the module check cache's entries: the modules checked in full now,
  // only when a build reads them (XO_CHK_CACHE=1 or auto, or verify):
  // with the module skip off by default every build wrote entries no
  // build read (cache chk 0/21 on each xo build, 2026-10-22)
  let chk_on = c.mod_skip_on || c.mod_verify
  if !c.std_export_bad.is_empty() {
    fail(os, "XO_STD_EXPORT=verify: std's records differ from its declarations: ${c.std_export_bad}")
  }
  if !c.std_export_out.is_empty() && !c.std_export_key.is_empty() {
    let _n = entry_put(os, c.mod_cache_dir, "stdx", c.std_export_key, c.std_export_out)
  }
  var mn = 0
  var mdiff: List[Str] = []
  for (k, e) in if chk_on { c.mod_cache_entries(b.mod_scans, b.nofe_mods, b.nofe_fos) } else { [] } {
    let p = entry_path(c.mod_cache_dir, "chk", k)
    if c.mod_verify {
      match os.fs.read(p) {
        Ok(old) => {
          if old != e {
            for (m, mk) in c.mod_keys {
              if mk == k {
                mdiff.push(c.mods[m].path)
              }
            }
          }
          continue
        }
        // xo:allow XO0903 verify mode: an entry it cannot read is stored again
        Err(_) => {}
      }
    }
    cache_put(os, p, e)
    mn += e.len()
  }
  if !mdiff.is_empty() {
    fail(os, "XO_BACKEND_CACHE=verify: ${mdiff.len()} modules' check differs from their cache entries, the first ${mdiff[0]}")
  }
  if mn > 0 {
    prune_backend_cache(os, "chk", dir, mn)
  }
  if phases {
    if chk_on {
      os.stdio.eprintln("cache chk ${c.mod_skip.len()}/${c.mod_keys.len()} modules")
    } else {
      os.stdio.eprintln("cache chk off (XO_CHK_CACHE=off)")
    }
    if c.std_export_on {
      os.stdio.eprintln("cache stdx ${if c.std_export_used { "used" } else { "declared" }}")
    }
  }
  b
}

/// The encoded inline summaries (arm64 inlsum.xo) of functions idx of m,
/// by their keys, on up to jobs tasks.
fn sums_of(m: ssa.Module, keys: List[Str], idx: List[Int], jobs: Int) -> List[(Str, Bytes)] {
  let n = idx.len()
  let next = Atomic[Int].new(0)
  scope s {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(s.spawn(fn() -> List[(Str, Bytes)] {
        var mine: List[(Str, Bytes)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for j in i..(i + 64).min(n) {
            let fi = idx[j]
            mine.push((keys[fi], arm64.encode_sum(arm64.fn_sum(m.funcs[fi]))))
          }
        }
        mine
      }))
    }
    var all: List[(Str, Bytes)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
}

/// With --phase-times: `cache WHAT HITS/TOTAL reused` on stderr.
fn cache_note(os: Os, on: Bool, what: Str, hits: Int, total: Int) {
  if on {
    os.stdio.eprintln("cache ${what} ${hits}/${total} reused")
  }
}

/// arm64.inline_apply through the cache (decision 0220 addendum stage D
/// part 2a, compiler/arm64 inlcache.xo): the inline key of each function
/// chained from the reference counting keys (rc_keys, rc_cached's), the
/// entries in <cache>/inl, a hit read instead of inlined. The plain
/// inline_apply without rc_keys (the cache off, --release, a small
/// module). verify inlines every function and fails the build when an
/// entry differs. Whether the module changed.
fn inline_through_cache(os: Os, var mi: ssa.Module, rc_keys: List[Str], jobs: Int, release: Bool, brk: Bool, phases: Bool, lazy: Bool) -> Bool {
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  if dir.is_empty() || release || rc_keys.is_empty() {
    return arm64.inline_apply(mi, brk)
  }
  var t = os.clock.now()
  let ik = arm64.inline_keys(mi, rc_keys, jobs)
  let keys = ik.keys
  t = lap(os, phases, "inline.keys", t)
  let (entries, pk) = cache_get_packed(os, dir, "inl", mi.goarch, keys, jobs)
  t = lap(os, phases, "inline.read", t)
  let out = arm64.inline_cached(mi, ik, entries, backend_cache_mode(os) == "verify", brk, jobs, lazy)
  pack_store(os, pk, entries, out.stores)
  let n = store_entries(os, dir, "inl", pk, out.stores)
  if !out.stores.is_empty() {
    prune_backend_cache(os, "inl", dir, n)
  }
  var nk = 0
  for k in keys {
    if !k.is_empty() {
      nk += 1
    }
  }
  cache_note(os, phases, "inline", out.reused, nk)
  if !out.mismatches.is_empty() {
    fail(os, "XO_BACKEND_CACHE=verify: ${out.mismatches.len()} functions' inlining differs from their cache entries, the first ${out.mismatches[0]}")
  }
  out.changed
}

/// The verification of the inlined module mi (inline_or_say) through the
/// set of verified keys (decision 0220 addendum stage D): a function
/// whose verify key (ssa verify_keys over arm64.function_keys) verified
/// in an earlier build is not verified again, which gives the errors a
/// full verification gives (none from such a function). The set is one
/// file per compiler, <cache>/ver/<identity>, rewritten with this
/// build's keys after a clean verification that found new ones. Every
/// function is verified with the cache off, verify, --release, or a
/// module the emitter's cache does not split.
fn verify_inlined(os: Os, var mi: ssa.Module, tgoos: Str, jobs: Int, release: Bool) -> List[Str] {
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  if dir.is_empty() || release || backend_cache_mode(os) == "verify" {
    ssa.force_lazy(mi, [], jobs)
    return mi.verify_all_jobs(jobs)
  }
  let id = cache_id(os)
  if id.is_empty() {
    ssa.force_lazy(mi, [], jobs)
    return mi.verify_all_jobs(jobs)
  }
  let keys = arm64.function_keys(mi, tgoos, id, jobs)
  if keys.is_empty() {
    ssa.force_lazy(mi, [], jobs)
    return mi.verify_all_jobs(jobs)
  }
  verify_by_keys(os, mi, keys, dir, id, jobs)
}

/// verify_inlined of the module made ready for generation (main.xo
/// gen_module: dead functions removed, flags set), by the per-function
/// cache's keys of it, which it returns for fn_cache_load ([] when it
/// computed none).
fn verify_after_dce(os: Os, var mi: ssa.Module, tgoos: Str, jobs: Int) -> (List[Str], List[Str]) {
  let host = host_os(os)
  let dir = backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
  let id = cache_id(os)
  if dir.is_empty() || id.is_empty() {
    ssa.force_lazy(mi, [], jobs)
    return (mi.verify_all_jobs(jobs), [])
  }
  let keys = arm64.function_keys(mi, tgoos, id, jobs)
  if keys.is_empty() {
    ssa.force_lazy(mi, [], jobs)
    return (mi.verify_all_jobs(jobs), [])
  }
  (verify_by_keys(os, mi, keys, dir, id, jobs), keys)
}

/// verify_inlined's work with the function keys: a function whose
/// verify key verified before is skipped, and the set is rewritten with
/// this build's after a clean verification that found new ones.
fn verify_by_keys(os: Os, var mi: ssa.Module, keys: List[Str], dir: Str, id: Str, jobs: Int) -> List[Str] {
  let vk = mi.verify_keys(keys)
  let path = "${dir}/ver/${id}"
  var known: Map[Str, Bool] = {}
  if let Some(b) = cache_get(os, path) {
    for l in (b.to_str() ?? "").split("\n") {
      if !l.is_empty() {
        known[l] = true
      }
    }
  }
  var skip: List[Bool] = []
  var fresh = 0
  for k in vk {
    let s = !k.is_empty() && known.contains(k)
    skip.push(s)
    if !k.is_empty() && !s {
      fresh += 1
    }
  }
  // the functions to verify, decoded (the inline cache's hits left
  // undecoded, decision 0283 stage B, are skipped or read here)
  var vidx: List[Int] = []
  for (fi, s) in skip.indexed() {
    if !s {
      vidx.push(fi)
    }
  }
  // none to verify: force_lazy decodes every undecoded function for an
  // empty list, which an edit that adds no reachable function hit, all
  // 1,300 of llvm-fib's inline hits decoded and none verified (2026-10-26)
  if !vidx.is_empty() {
    ssa.force_lazy(mi, vidx, jobs)
  }
  let errs = mi.verify_jobs_skip(jobs, skip)
  if errs.is_empty() && fresh > 0 {
    // the keys of earlier builds too (an edit and its revert), until
    // they outnumber this build's four to one
    var keep = known
    if known.len() > 4 * vk.len() {
      keep = {}
    }
    for k in vk {
      if !k.is_empty() {
        keep[k] = true
      }
    }
    var sb = StrBuilder.new()
    for (k, _) in keep {
      sb.write(k)
      sb.write("\n")
    }
    cache_put(os, path, sb.freeze().bytes())
  }
  errs
}

/// The entries of keys under kind that the cache holds (cache_get), read
/// on up to jobs tasks: thousands of small files, which one task reads in
/// about a second.
fn cache_get_all(os: Os, dir: Str, kind: Str, keys: List[Str], jobs: Int) -> Map[Str, Bytes] {
  // the shard directories the cache holds for kind, listed once: a key
  // whose shard is not there is not opened. A cold build's keys are all
  // new, and each failed open cost about 10 ms on the Windows CI runner
  // (21,413 of them in a cold CRUD build, 2026-10-23); with no kind
  // directory at all, none is opened. A shard made after the listing
  // only means an entry made again.
  // (Only the shard names: listing a shard to open just the keys it holds
  // was measured on the 23 GB user cache, 2026-10-24: a shard of the fe
  // kind holds about 2,000 entries and lists in 7 ms, so a build touching
  // every shard paid 1.8 s to save about 4,000 failed opens at tens of
  // microseconds each; 5c9fe1bf1 stat'ed them too, gotchas/
  // fs-read-dir-stats-every-entry.md. A cache that has every shard keeps
  // opening, as before.)
  // names only (internal.dir_names); a kind directory holds only shard
  // directories
  // (A Fs that refuses dir_names, a wrapped one such as XO_CACHE_STATS's,
  // lists the kind directory with read_dir: it holds only the 256 shard
  // directories. Taking the refusal for an empty cache made every lookup
  // a miss: a build under XO_CACHE_STATS=1 ran cold, 2026-10-24.)
  var shards: Map[Str, Bool] = {}
  match internal.dir_names(os.fs, "${dir}/${kind}") {
    Ok(names) => {
      for nm in names {
        shards[nm] = true
      }
    }
    Err(FsErr.Denied(_)) => {
      if let Ok(fis) = os.fs.read_dir("${dir}/${kind}") {
        for fi in fis {
          shards[fi.name] = true
        }
      }
    }
    // no kind directory yet: no shard
    Err(_) => {}
  }
  var seen: Map[Str, Bool] = {}
  var ks: List[Str] = []
  for k in keys {
    if k.len() >= 2 && !seen.contains(k) && shards.contains(k[0..2]) {
      seen[k] = true
      ks.push(k)
    }
  }
  let n = ks.len()
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(sc.spawn(fn() -> List[(Str, Bytes)] {
        var mine: List[(Str, Bytes)] = []
        while true {
          let i = next.add(64) - 64
          if i >= n {
            break
          }
          for j in i..(i + 64).min(n) {
            if let Some(b) = entry_get(os, dir, kind, ks[j]) {
              mine.push((ks[j], b))
            }
          }
        }
        mine
      }))
    }
    var all: List[(Str, Bytes)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var entries: Map[Str, Bytes] = {}
  for (k, b) in done {
    entries[k] = b
  }
  entries
}

/// The path of the entry of key in the cache dir under kind ("obj").
fn entry_path(dir: Str, kind: Str, key: Str) -> Str {
  "${dir}/${kind}/${key[0..2]}/${key}"
}

/// The entry at path, marked used (prune.mark_used_within BACKEND_TOUCH);
/// None when the cache does not hold it.
fn cache_get(os: Os, path: Str) -> Option[Bytes] {
  match os.fs.read(path) {
    Ok(b) => {
      prune.mark_used_within(os.fs, os.clock, path, BACKEND_TOUCH)
      Some(b)
    }
    // xo:allow XO0903 a cache miss: the body is built again
    Err(_) => None
  }
}

/// Stores data as the entry at path: written under a temporary name and
/// renamed into place, so a reader never sees half of it.
fn cache_put(os: Os, path: Str, data: Bytes) {
  match os.fs.create_dir_all(dir_name(path)) {
    Ok(_) => {}
    Err(_) => return
  }
  let tmp = "${path}.tmp-${os.rand.bytes(6).to_hex()}"
  match os.fs.write(tmp, data) {
    Ok(_) => {
      match os.fs.rename(tmp, path) {
        Ok(_) => {}
        Err(_) => os.fs.remove(tmp).ignore_err("another process stored it")
      }
    }
    Err(_) => os.fs.remove(tmp).ignore_err("a failed store")
  }
}

/// A hit refreshes an entry's time once it is a minute old, so the
/// prune's order tracks use within BACKEND_KEEP.
const BACKEND_TOUCH: Duration = 1m

/// A cache entry is read whole and never needed again by the build that
/// stored it, so removing a young one costs only a later hit: two
/// minutes, not prune.KEEP's two hours, which kept a morning of
/// parallel builds (17 GiB in 15 minutes, 2026-10-16) out of reach of
/// the cap.
const BACKEND_KEEP: Duration = 2m

/// The back-end cache's default cap, in GiB (owner, 2026-10-21: 16, was 8):
/// the agents' builds used about 8.8 GB of it within two hours, so at 8 a
/// prune evicted entries the next builds stored again, and each burst of
/// stores set off another prune unlinking tens of thousands of files (a
/// warm build of xo: insert_rc.sums 85.9 s).
const BACKEND_CAP_GB = 16

/// Prunes the cache (prune.run, decision 0223) after stored new bytes:
/// hourly, or sooner once an eighth of the cap was stored since the
/// last prune; the entries unused for a week ($XO_CACHE_MAX_AGE), then
/// the least recently used past BACKEND_CAP_GB ($XO_BACKEND_CACHE_MAX
/// bytes, or $XO_CACHE_MAX_GB) across every kind together.
///
/// A due prune runs in a detached `xo dev prune-backend DIR`
/// (prune_backend_child), so no build waits on it (2026-10-21: builds of
/// two dev goldens timed out at 240 s inside a prune's walk of 500,000
/// files); $XO_PRUNE_DETACH=off, or a host without /bin/sh, prunes in
/// the build, one slice.
fn prune_backend_cache(os: Os, kind: Str, dir: Str, stored: Int) {
  prune.note_stored(os.fs, dir, stored)
  note_store(os, kind, dir, stored)
  let p = backend_policy(os)
  if !(os.fs.exists("${dir}/prune-stamp").ok() ?? false) {
    // a new cache: its stamp (prune.due), its first prune an interval on
    os.fs.write("${dir}/prune-stamp", b"").ignore_err("only the interval")
    return
  }
  if !prune.due(os.fs, os.clock, dir, p) {
    return
  }
  if !backend_prune_allowed(os, dir, p) || !prune_version_ok(os, dir) {
    return
  }
  if (os.env.get("XO_PRUNE_DETACH") ?? "") == "off" || host_os(os) == "windows" {
    let _s = prune.run(os.fs, os.clock, dir, p)
    return
  }
  // one child a minute at most: the builds that find it due at once
  let mark = "${dir}/prune-spawned"
  if let Ok(Some(fi)) = os.fs.stat(mark) {
    if os.clock.since(fi.modified) < 1m {
      return
    }
  }
  os.fs.write(mark, b"").ignore_err("only limits the children")
  os.fs.set_modified(mark, os.clock.now()).ignore_err("only limits the children")
  let xo = check.executable(os.env, os.fs)
  // without the build's profile and trace settings: the child would
  // write its profile at the build's path first, and the build's could
  // not be written (2026-10-21: a cold self-build's profile was the
  // child's 0.5 s)
  // its output and exit status go to DIR/prune-child.log: a child that
  // faulted was invisible (2026-10-21: an overflow faulted every child
  // for two hours while the cache grew to 49 GB)
  let script = "( XO_PROF= XO_PROF_OUT= XO_TRACE= XO_TRACE_OUT= \"$0\" dev prune-backend \"$1\"; echo \"$(date +%s) prune-backend exit $?\" ) </dev/null >>\"$1/prune-child.log\" 2>&1 &"
  os.proc.cmd("/bin/sh", ["-c", script, xo, dir]).run().ignore_err("a prune that does not start runs on a later build")
}

/// Whether the back-end cache in dir may be pruned under p: not the
/// user's own cache (<user cache>/xo/backend) with a cap under
/// BACKEND_MIN_CAP, which only a test sets ($XO_BACKEND_CACHE_MAX=1) and
/// which would empty every agent's warm cache; $XO_PRUNE_FORCE=1 allows it.
fn backend_prune_allowed(os: Os, dir: Str, p: prune.Policy) -> Bool {
  if p.max_bytes <= 0 || p.max_bytes >= BACKEND_MIN_CAP || (os.env.get("XO_PRUNE_FORCE") ?? "") == "1" {
    return true
  }
  let host = host_os(os)
  dir.trim_suffix("/") != "${user_cache_dir(os, host)}/xo/backend"
}

/// Keeps the log at path (prune-child.log) under 1 MiB: past it, its last
/// 256 KiB stay.
fn trim_log(os: Os, path: Str) {
  if let Ok(Some(fi)) = os.fs.stat(path) {
    if fi.size > 1048576 {
      if let Ok(b) = os.fs.read(path) {
        cache_put(os, path, b[b.len() - 262144..b.len()])
      }
    }
  }
}

/// The back-end cache's prune policy version (prune_version_ok): raised
/// with every change to how the cache is pruned (its cap, its accounting).
/// 4: whole-walk LRU, gone entries counted (2026-10-21).
const BACKEND_PRUNE_VERSION: Int = 4

/// Whether this xo may prune the back-end cache in dir: a cache whose
/// DIR/prune-version is newer than BACKEND_PRUNE_VERSION is managed by a
/// newer xo, and an older one leaves it alone (it still reads and writes
/// entries). An older or missing version is replaced by this one.
/// (2026-10-21: xos from that morning, with an 8 GiB cap and a prune that
/// logged nothing, ran beside today's and took the cache to 3.55 GB.)
fn prune_version_ok(os: Os, dir: Str) -> Bool {
  let p = "${dir}/prune-version"
  // xo:allow XO0903 no file: no prune has stamped the cache yet
  let v = Int.parse(((os.fs.read(p).ok() ?? b"").to_str() ?? "").trim()) ?? 0
  if v > BACKEND_PRUNE_VERSION {
    return false
  }
  if v < BACKEND_PRUNE_VERSION {
    cache_put(os, p, "${BACKEND_PRUNE_VERSION}\n".bytes())
  }
  true
}

/// The smallest cap the user's own back-end cache is pruned to
/// (backend_prune_allowed).
const BACKEND_MIN_CAP: Int = 64 * 1024 * 1024

/// The back-end cache's prune policy (prune_backend_cache): a week's
/// age, the cap, a slice of shards per run (BACKEND_WALK of walking).
fn backend_policy(os: Os) -> prune.Policy {
  let base = prune.from_env(os.env, prune.Policy{max_age: 168h, max_bytes: BACKEND_CAP_GB * prune.GB, keep: BACKEND_KEEP, every: BACKEND_EVERY, walk_budget: BACKEND_WALK})
  var p = cap_env(os, base, "XO_BACKEND_CACHE_MAX")
  p.burst = p.max_bytes / 8
  // the cap counts the disk the cache uses: 4 KiB blocks (a file of 300
  // bytes takes 4096)
  p.block = 4096
  // a target's directories left empty by a build that never came back go
  // after an hour, not a week (compiler/prune Policy.empty_idle)
  p.empty_idle = 1h
  p
}

/// A slice of the back-end cache's shards is walked for this long per
/// run, and a run is due this often (prune.Policy.walk_budget).
const BACKEND_WALK: Duration = 300ms
const BACKEND_EVERY: Duration = 1m

/// `xo dev prune-backend DIR`: slices of the back-end cache in DIR until
/// it is under its cap (or the whole cache was walked, or a minute
/// passed); the child prune_backend_cache starts.
fn prune_backend_child(os: Os, dir: Str) -> Int {
  trim_log(os, "${dir}/prune-child.log")
  var p = backend_policy(os)
  if !backend_prune_allowed(os, dir, p) || !prune_version_ok(os, dir) {
    return 1
  }
  // no removal budget and no interval: the child is the only runner;
  // and every shard walked in a run, so the sizes it acts on are current
  // (300 ms slices left the ledger stale for 10 minutes while packs grew,
  // 2026-10-21: the ledger said 16 GB of a 49 GB cache)
  p.budget = 0s
  p.every = 0s
  p.walk_budget = 60s
  // pack/ (a slot per build target in one directory) is read no more
  // since packs/<xx>/ (2026-10-21): its 138,000 slots made each run's
  // listing of the shards take 4 to 5 s, so a run walked one shard;
  // retired whole and removed here, off the builds
  prune.retire(os.fs, os.clock, dir, "pack")
  prune.prune_trash(os.fs, dir)
  let t0 = os.clock.now()
  var slices = 0
  while {
    let st = prune.run(os.fs, os.clock, dir, p)
    slices += 1
    // done under the cap, or when a run removed nothing (what is left was
    // used within keep)
    // (every shard measured once: before, the ledger's sum is short)
    if !st.ran || (st.unmeasured == 0 && (st.removed.is_empty() || p.max_bytes <= 0 || st.bytes <= p.max_bytes)) || os.clock.since(t0) > 60s || slices > 4096 {
      break
    }
  }
  0
}

// Packs (decision 0220 addendum stage D 2d): after an edit, reading the
// entries as about 30,000 files cost 1.7 s of CPU (open, read, the used
// mark's stat), so each build target (the working directory, the
// command line without its flags and output path, and the target) also keeps its rc, inl, and fn entries
// in a few segment files per kind, <cache>/packs/<xx>/<slot>/<kind>/s-<hex>,
// each read with one open. A segment is PACK_VERSION, a line, the count,
// each entry's key and length (unsigned varints), then the entries' bytes
// in that order. The loose files stay the shared store: a key the pack
// lacks is read from its file, and stores go there too, so other
// programs and targets keep their hits. A build appends one segment of
// the entries it used that its pack lacked; past PACK_SEGS segments, or
// a pack holding over twice what the build used, it writes one segment
// of what it used and removes the segments it read. A target's first
// build only creates the directory and counts it, and the second counts
// again, so a program built once or twice (a golden) costs no second
// copy (the third writes the segments, 2026-10-21); the parts have no
// loose copies, so they are packed on the second build (a test build's
// of fewer than PART_PACK_FIRST parts on the first: the run cache serves
// its unchanged rebuilds, so its second back end build is an edit). A
// build that used none of its pack's entries (after a rebase: xo's parts
// 0/116) rewrites the pack instead of appending. Segments are written whole
// and renamed into place (cache_put); a segment another build removed
// while this one listed it reads as missing, and its keys come from the
// loose files.
// The prune treats each segment as one entry, marked used when read.

const PACK_VERSION = "xo pack v1"

/// A test build of a module of fewer parts writes its parts pack on its
/// build target's first build: the compiler has 116 (650 MB); the
/// largest golden 10 (http_conn_fault, 31 MB of parts), an HTTP server
/// about 7 to 9, a hello program 3 (m.funcs holds the runtime),
/// 2026-10-20.
const PART_PACK_FIRST = 16
/// Or a module whose parts are under this many bytes in all: the HTTP
/// server has 35 parts (8.4 MB as a packed segment, 2026-10-27) and regenerated every one
/// on the first edit after a cold build (emit 67 ms against 24 ms with
/// them), while the compiler's (650 MB packed), written once by each gate's self
/// build and never read, stay on the second build
/// (gotchas/first-build-parts-pack-unread.md)
const PART_PACK_FIRST_BYTES = 128 * 1048576
const PACK_SEGS = 4
/// The builds of a target that only count before its pack is written: the
/// first creates the directory, the second counts, the third writes. The
/// second build used to write every entry again as segments (12.6 GiB
/// and 1,645 files for the golden run, no faster than cold, 2026-10-21);
/// a target built twice, as a test run's goldens are, never pays for it.
const PACK_AFTER = 2

/// One kind's pack for a build target, as cache_get_packed read it.
struct Pack {
  /// The cache directory, for the prune's stored bytes.
  root: Str = ""
  /// <cache>/pack/<slot>/<kind>; "" when packs are not used.
  dir: Str = ""
  /// The segments read (file names).
  segs: List[Str] = []
  /// The entries those segments hold.
  held: Int = 0
  /// The keys whose entries came from the pack.
  from_pack: Map[Str, Bool] = {}
  /// The target's first build: no pack directory yet.
  fresh: Bool = false
  /// The shared pack of this kind and target (shared_pack_dir), "" when
  /// it is off: where a build's many new entries go (store_entries).
  shared_dir: Str = ""
  /// The entries this build read from the shared pack, its segments
  /// then, and how many entries they held: store_entries compacts by
  /// them as shared_store does.
  shared_used: Map[Str, Bytes] = {}
  shared_segs: List[Str] = []
  shared_held: Int = 0
  /// The builds of this target that left the pack empty (the file "seen"
  /// in its directory): segments are written once PACK_AFTER were counted.
  seen: Int = 0
  /// Count the builds before writing (every kind but the parts, which
  /// have no loose copies to serve in the meantime).
  wait: Bool = false
  /// Rewrite the pack with the entries used, dropping the rest (an entry
  /// that did not replay must not be read again).
  compact: Bool = false
  /// fn_cache_load's: the pack of the parts' entries beside the
  /// functions'
  parts: Option[Pack] = None
}

/// The pack directory of kind for this build and target: flags such as
/// --phase-times and the output path (-o) do not change it, so a verify
/// build or one with another output shares the edit loop's pack (the keys
/// decide what an entry is; the target only groups the entries one edit
/// loop uses).
fn pack_dir(os: Os, dir: Str, kind: Str, target: Str) -> Str {
  // xo:allow XO0903 the working directory only names the build in the cache
  let cwd = os.fs.cwd_path().ok() ?? ""
  let words = pack_words(os.env.args())
  let id = crypto.sha256("${PACK_VERSION}\n${cwd}\n${words.join("\n")}\n${target}\n".bytes()).to_hex()
  // under packs/<two hex>/ (2026-10-21): the prune walks the cache in
  // slices of such shards, and pack/ held 138,000 slots in one directory
  "${dir}/packs/${id[0..2]}/${id[2..32]}/${kind}"
}

/// The words of a command line that name its build target: not the flags,
/// and not the value of a flag that takes one as the next argument (`-o
/// OUT`, `--stamp NAME=VALUE`, `--std DIR`, value_flags). scripts/xobuild
/// stamps the commit and the source key (`--stamp XO_SOURCE_KEY=...`), so
/// each tree key was a new target: its first build wrote xo's whole parts
/// pack (678 MB) and no later build found it (2026-10-22: 56 such
/// segments, 8.3 GB of the 16 GiB cap, none read again).
fn pack_words(args: List[Str]) -> List[Str] {
  let vals = value_flags()
  var words: List[Str] = []
  var skip = false
  for a in args {
    if skip {
      skip = false
    } else if a.starts_with("-") {
      let name = a.trim_prefix("-").trim_prefix("-")
      skip = !name.contains("=") && vals.contains(name)
    } else {
      words.push(a)
    }
  }
  words
}

/// cache_get_all through the build target's pack (above): the entries
/// of keys the pack holds, the rest from the loose files.
fn cache_get_packed(os: Os, dir: Str, kind: Str, target: Str, keys: List[Str], jobs: Int) -> (Map[Str, Bytes], Pack) {
  var p = Pack{root: dir, dir: pack_dir(os, dir, kind, target), wait: kind != "part"}
  var want: Map[Str, Bool] = {}
  for k in keys {
    if !k.is_empty() {
      want[k] = true
    }
  }
  var entries: Map[Str, Bytes] = {}
  match os.fs.read_dir(p.dir) {
    Ok(list) => {
      if let Ok(b) = os.fs.read("${p.dir}/seen") {
        p.seen = Int.parse(b.to_str() ?? "") ?? 0
      }
      for fi in list {
        if !is_segment(fi.name) {
          continue
        }
        let path = "${p.dir}/${fi.name}"
        match os.fs.read(path) {
          Ok(rb) => {
            prune.mark_used_within(os.fs, os.clock, path, BACKEND_TOUCH)
            // a damaged compressed segment holds no entry; the next
            // compaction replaces it
            let b = segment_bytes(fi.name, rb) ?? b""
            p.segs.push(fi.name)
            for (k, lo, hi) in pack_index(b) {
              p.held += 1
              if want.contains(k) && !entries.contains(k) {
                entries[k] = b[lo..hi]
                p.from_pack[k] = true
              }
            }
          }
          // xo:allow XO0903 a pack segment it cannot read is a miss: its bodies are built again
          Err(_) => {}
        }
      }
    }
    Err(_) => p.fresh = true
  }
  // the front end's keys its last build asked for and found nowhere
  // (decision 0351): fe.keys has one key per checked body and the front
  // end stores only the reachable ones (4,146 of hello's 5,373 never
  // are), so each was a failed open on every build. A key in the list is
  // not read loose; one the build stores is found in the pack first.
  let neg_path = "${p.dir}/neg"
  // only with a formed pack: before it forms, the build stores its
  // entries loose, and a listed key would hide one
  let neg_on = kind == "fe" && !p.segs.is_empty()
  var neg: Map[Str, Bool] = {}
  var neg_text = ""
  if neg_on {
    // xo:allow XO0903 no list: every key not in the pack is read loose
    neg_text = (os.fs.read(neg_path).ok() ?? b"").to_str() ?? ""
    for k in neg_text.split("\n") {
      if !k.is_empty() {
        neg[k] = true
      }
    }
  }
  // the shared pack (decision 0351, Accepted: on by default, owner
  // 2026-10-23; XO_SHARED_PACK=off turns it off): what this target's
  // pack lacks, before any loose file
  let sh_on = kind != "part" && (os.env.get("XO_SHARED_PACK") ?? "") != "off"
  let sdir = if sh_on { shared_pack_dir(dir, kind, target) } else { "" }
  p.shared_dir = sdir
  // a build target without a formed pack (a new directory) takes the
  // shared copy of the last formed pack's list: the keys found nowhere
  // even with a pack, so stored by no build (9,520 failed opens for
  // hello in a new directory)
  let sh_neg = sh_on && kind == "fe" && !neg_on
  if sh_neg {
    // xo:allow XO0903 no shared list: every key not in a pack is read loose
    let t = (os.fs.read("${sdir}/neg").ok() ?? b"").to_str() ?? ""
    for k in t.split("\n") {
      if !k.is_empty() {
        neg[k] = true
      }
    }
  }
  var shared: Map[Str, Bytes] = {}
  var sh_segs: List[Str] = []
  var sh_held = 0
  if sh_on {
    var need: Map[Str, Bool] = {}
    for (k, _) in want {
      if !entries.contains(k) && !neg.contains(k) {
        need[k] = true
      }
    }
    if !need.is_empty() {
      let (g, sg, sh) = shared_read(os, sdir, need)
      shared = g
      sh_segs = sg
      sh_held = sh
      p.shared_used = g
      p.shared_segs = sg
      p.shared_held = sh
      for (k, b) in shared {
        entries[k] = b
      }
    }
  }
  var rest: List[Str] = []
  for (k, _) in want {
    if !entries.contains(k) && !neg.contains(k) {
      rest.push(k)
    }
  }
  let loose = cache_get_all(os, dir, kind, rest, jobs)
  if sh_on && loose.len() >= SHARED_MIN {
    shared_store(os, dir, sdir, shared, loose, sh_segs, sh_held)
  }
  // XO_FE_STATS=1: how many entries came from loose files (one open
  // each) against the directory's pack (decision 0351)
  if (os.env.get("XO_FE_STATS") ?? "") == "1" {
    os.stdio.eprintln("cache loose ${kind} ${loose.len()} of ${want.len()} (pack ${p.from_pack.len()}, shared ${shared.len()}, missing ${rest.len() - loose.len()})")
  }
  for (k, b) in loose {
    entries[k] = b
  }
  if neg_on {
    var missing: List[Str] = []
    for (k, _) in want {
      if !entries.contains(k) {
        missing.push(k)
      }
    }
    let text = missing.sort().join("\n")
    if text != neg_text {
      cache_put(os, neg_path, text.bytes())
      if sh_on {
        // the shared copy for new build targets (sh_neg)
        os.fs.create_dir_all(sdir).ignore_err("no shared list: new directories read loose")
        cache_put(os, "${sdir}/neg", text.bytes())
      }
    }
  }
  (entries, p)
}

/// A build's new entries of kind (stores): one segment of the shared pack
/// when they are many (COLD_PACK_MIN or more: a cold build's, about 5,800
/// files of std's bodies for a hello, which a Windows runner writes
/// slowly; lead-approved item (A), 2026-10-23), else a loose file each, as
/// before. Every reader looks in the shared pack before the loose files
/// (cache_get_packed). The bytes written loose, for the caller's prune
/// (pack_write counts a segment itself).
fn store_entries(os: Os, dir: Str, kind: Str, p: Pack, stores: List[(Str, Bytes)]) -> Int {
  // on by default (owner, 2026-10-24; XO_COLD_PACK=off writes loose files):
  // it was opt in from the evening of 2026-10-23 because main's builds took
  // about 10 minutes each on the Windows CI runner's 31 GB cache and the Mac
  // did not reproduce it (decision 0351 addenda)
  if !p.shared_dir.is_empty() && stores.len() >= COLD_PACK_MIN && (os.env.get("XO_COLD_PACK") ?? "") != "off" {
    // shared_store's rule: a new segment, or past PACK_SEGS segments (or
    // a pack holding more than twice what this build used) one segment
    // of what it used and made, replacing the old. Appending alone grew
    // the pack by a segment per new xo (each CI run's: 12.6 MB a
    // generation of a windows --race build, 114 MB in 11 segments after
    // eight, every build reading them all; 2026-10-23)
    var made: Map[Str, Bytes] = {}
    for (k, e) in stores {
      made[k] = e
    }
    shared_store(os, dir, p.shared_dir, p.shared_used, made, p.shared_segs, p.shared_held)
    return 0
  }
  var n = 0
  for (k, e) in stores {
    n += entry_put(os, dir, kind, k, e)
  }
  n
}

/// store_entries writes a segment from this many new entries up.
const COLD_PACK_MIN = 64

/// A build that read at least this many entries loose adds them to the
/// shared pack (decision 0351).
const SHARED_MIN = 64

/// The shared pack of kind for target (decision 0351): one per kind and
/// target for every program and directory, read after the build target's
/// own pack (pack_dir) and before loose files. It settles on the entries
/// every program uses (std and the runtime): each build that reads many
/// entries loose appends them, and a compaction keeps what the compacting
/// build used.
fn shared_pack_dir(dir: Str, kind: Str, target: Str) -> Str {
  let id = crypto.sha256("${PACK_VERSION}\nshared\n${target}\n".bytes()).to_hex()
  "${dir}/packs/shared/${id[0..30]}/${kind}"
}

/// The entries of the shared pack at sdir for the keys need: them, the
/// segments read, and how many entries those hold.
fn shared_read(os: Os, sdir: Str, need: Map[Str, Bool]) -> (Map[Str, Bytes], List[Str], Int) {
  var got: Map[Str, Bytes] = {}
  var segs: List[Str] = []
  var held = 0
  // xo:allow XO0903 no shared pack yet: every entry is read loose
  for fi in os.fs.read_dir(sdir).ok() ?? [] {
    if !is_segment(fi.name) {
      continue
    }
    let path = "${sdir}/${fi.name}"
    // xo:allow XO0903 a segment it cannot read (another build compacted it) is a miss
    if let Ok(rb) = os.fs.read(path) {
      prune.mark_used_within(os.fs, os.clock, path, BACKEND_TOUCH)
      let b = segment_bytes(fi.name, rb) ?? b""
      segs.push(fi.name)
      for (k, lo, hi) in pack_index(b) {
        held += 1
        if need.contains(k) && !got.contains(k) {
          got[k] = b[lo..hi]
        }
      }
    }
  }
  (got, segs, held)
}

/// Adds the entries a build read loose to the shared pack at sdir: a new
/// segment, or, past PACK_SEGS segments or when the pack holds more than
/// twice what this build used of it, one segment of what it used (the
/// entries read from it and the loose ones) replacing the old.
fn shared_store(os: Os, root: Str, sdir: Str, used: Map[Str, Bytes], loose: Map[Str, Bytes], segs: List[Str], held: Int) {
  os.fs.create_dir_all(sdir).ignore_err("no shared pack: the loose files serve")
  let p = Pack{root: root, dir: sdir}
  var items: List[(Str, Bytes)] = []
  for (k, b) in loose {
    items.push((k, b))
  }
  if segs.len() >= PACK_SEGS || held > 2 * (used.len() + loose.len()) + 64 {
    for (k, b) in used {
      if !loose.contains(k) {
        items.push((k, b))
      }
    }
    var old = 0
    for s in segs {
      if let Ok(Some(fi)) = os.fs.stat("${sdir}/${s}") {
        old += fi.size
      }
    }
    pack_write_counted(os, p, items, old)
    for s in segs {
      os.fs.remove("${sdir}/${s}").ignore_err("another build compacted it")
    }
  } else {
    pack_write(os, p, items)
  }
}

/// The keys of a segment with their bytes' range in b, [] when b is not
/// a whole segment of this version.
fn pack_index(b: Bytes) -> List[(Str, Int, Int)] {
  let head = "${PACK_VERSION}\n".bytes()
  if b.len() < head.len() || b[0..head.len()] != head {
    return []
  }
  var pos = head.len()
  let (n, p1) = get_uv(b, pos)
  pos = p1
  if n < 0 {
    return []
  }
  var ks: List[(Str, Int)] = []
  for _ in 0..n {
    let (kl, p2) = get_uv(b, pos)
    if kl < 0 || p2 + kl > b.len() {
      return []
    }
    let k = b[p2..p2 + kl].to_str() ?? ""
    let (len, p3) = get_uv(b, p2 + kl)
    if len < 0 {
      return []
    }
    ks.push((k, len))
    pos = p3
  }
  var out: List[(Str, Int, Int)] = List.with_capacity(ks.len())
  for (k, len) in ks {
    if pos + len > b.len() {
      return []
    }
    out.push((k, pos, pos + len))
    pos += len
  }
  out
}

/// The unsigned varint at b[pos], and the position after it; -1 when b
/// ends inside it or it is too long.
fn get_uv(b: Bytes, pos: Int) -> (Int, Int) {
  var v = 0
  var shift = 0
  var i = pos
  while i < b.len() && shift < 63 {
    let c = Int(b[i])
    v = v | ((c & 127) << shift)
    i += 1
    if c < 128 {
      return (v, i)
    }
    shift += 7
  }
  (-1, i)
}

fn put_uv(var w: BytesBuilder, v0: Int) {
  var v = v0
  while v >= 128 {
    w.write_byte(UInt8((v & 127) | 128))
    v = v >> 7
  }
  w.write_byte(UInt8(v))
}

/// Updates the build target's pack p after a build used entries (its
/// hits, from the pack or the loose files) and stores (its new entries):
/// see the section comment.
fn pack_store(os: Os, p: Pack, entries: Map[Str, Bytes], stores: List[(Str, Bytes)]) {
  if p.dir.is_empty() {
    return
  }
  if p.fresh && p.wait {
    cache_put(os, "${p.dir}/seen", "1".bytes())
    return
  }
  if p.fresh {
    os.fs.create_dir_all(p.dir).ignore_err("no pack: the loose files serve")
    return
  }
  if p.wait && p.segs.is_empty() && p.seen < PACK_AFTER {
    cache_put(os, "${p.dir}/seen", "${p.seen + 1}".bytes())
    return
  }
  var used: List[(Str, Bytes)] = []
  var extra: List[(Str, Bytes)] = []
  var seen: Map[Str, Bool] = {}
  for (k, b) in entries {
    seen[k] = true
    // an entry the shared pack served stays there: copying it into every
    // build target's pack wrote the same entries once per target (a
    // compiler build target: 443 MB of inl, rc, fe and sum segments, and
    // the store-log's 1,300 GB of pack segments in 52 hours, 2026-10-24)
    // (not fe: its target pack, with its list of keys no build stored, is
    // what spares the lookups of the 4,300 bodies a program lacks; a pack
    // without segments has no list, and a new directory's build opened
    // each of them: TestFrontCacheNegKeys, TestSharedPackNegKeys)
    if p.shared_used.contains(k) && !p.from_pack.contains(k) && !p.dir.ends_with("/fe") {
      continue
    }
    used.push((k, b))
    if !p.from_pack.contains(k) {
      extra.push((k, b))
    }
  }
  for (k, b) in stores {
    if !seen.contains(k) {
      seen[k] = true
      used.push((k, b))
      extra.push((k, b))
    }
  }
  // no entry from the pack: its segments hold another tree's entries
  // (a rebase), so they are replaced, not kept beside the new one
  if p.compact || p.segs.len() >= PACK_SEGS || p.held > 2 * used.len() + 64 || (p.held > 0 && p.from_pack.is_empty()) {
    // a compaction replaces the segments it read: only what it adds
    // counts as stored for the prune's burst (a warm build of xo
    // rewrote about 1 GB of packs and set off a prune of the whole
    // cache on every build, 2026-10-21)
    var old = 0
    for s in p.segs {
      if let Ok(Some(fi)) = os.fs.stat("${p.dir}/${s}") {
        old += fi.size
      }
    }
    pack_write_counted(os, p, used, old)
    for s in p.segs {
      os.fs.remove("${p.dir}/${s}").ignore_err("another build compacted it")
    }
  } else if !extra.is_empty() {
    pack_write(os, p, extra)
  }
}

/// One line of DIR/store-log per store: `UNIX store KIND BYTES id ID`,
/// ID the first 12 hex digits of the hash of the cache identity
/// (cache_id: the code generation key), so the prune's churn splits into
/// the entries of new keys (a push that changed code generation) and
/// repeats of known ones (2026-10-22). KIND is fe, fn, inl, rc, sum,
/// obj, hobj (a hollowed part's object and its undefined-symbol facts),
/// hfacts (a part's hollow facts), hextra (an ELF part's extra labels),
/// chk, or pack/KIND for a pack segment.
fn note_store(os: Os, kind: Str, dir: Str, n: Int) {
  if n <= 0 {
    return
  }
  let id = crypto.sha256(cache_id(os).bytes()).to_hex()[0..12]
  os.fs.append("${dir}/store-log", "${os.clock.now().unix()} store ${kind} ${n} id ${id}\n".bytes()).ignore_err("only the log")
}

/// Writes items as a new segment of p.
/// The bytes of a build's part entries, before the pack's compression.
fn parts_bytes(items: List[(Str, Bytes)]) -> Int {
  var n = 0
  for (_, b) in items {
    n += b.len()
  }
  n
}

fn pack_write(os: Os, p: Pack, items: List[(Str, Bytes)]) { pack_write_counted(os, p, items, 0) }

/// pack_write, counting for the prune only the bytes past replaced (the
/// segments a compaction removes).
fn pack_write_counted(os: Os, p: Pack, items: List[(Str, Bytes)], replaced: Int) {
  var n = 0
  for (_, b) in items {
    n += b.len()
  }
  var w = BytesBuilder.with_capacity(n + 80 * items.len() + 32)
  w.write_str("${PACK_VERSION}\n")
  put_uv(w, items.len())
  for (k, b) in items {
    put_uv(w, k.len())
    w.write_str(k)
    put_uv(w, b.len())
  }
  for (_, b) in items {
    w.write(b)
  }
  // compressed (decision 0365): a z- segment
  let z = compress_on(os)
  let data = if z { zpack(w.freeze()) } else { w.freeze() }
  cache_put(os, "${p.dir}/${if z { "z-" } else { "s-" }}${os.rand.bytes(8).to_hex()}", data)
  prune_backend_cache(os, "pack/${base_name(p.dir)}", p.root, (data.len() - replaced).max(0))
}

/// The file of the build target's parse list (parse_prefetch).
fn parse_list_path(os: Os, dir: Str) -> Str {
  "${pack_dir(os, dir, "parse", "")}/list"
}

/// The parse prefetch (decision 0220 addendum stage 2): the files the
/// build target's last check parsed (parse_list_store) are read and
/// parsed on tasks into the checker's parse cache before the check,
/// which reuses a parse whose path, bytes, and mode match and parses
/// any other file itself.
fn parse_prefetch(os: Os, var c: check.Checker, dir: Str) {
  // xo:allow XO0903 the parse prefetch only saves time; the check reads every file itself
  let data = os.fs.read(parse_list_path(os, dir)).ok() ?? b""
  var todo: List[(Str, Bytes, Bool, Bool)] = []
  for line in (data.to_str() ?? "").split("\n") {
    let sig = line.starts_with("s ")
    if !sig && !line.starts_with("f ") {
      continue
    }
    let path = line[2..line.len()]
    match os.fs.read(c.source_path(path)) {
      Ok(b) => todo.push((path, b, sig, !sig && c.parse_lazy_path(path)))
      // xo:allow XO0903 the parse prefetch only saves time; the check reads every file itself
      Err(_) => {}
    }
  }
  let n = todo.len()
  if n == 0 {
    return
  }
  let next = Atomic[Int].new(0)
  let parsed = scope s {
    var ts = []
    for _ in 0..emit_jobs(os).min(n).max(1) {
      ts.push(s.spawn(fn() -> List[(Str, check.ParseEntry)] {
        var mine: List[(Str, check.ParseEntry)] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          let (path, src, sig, lazy) = todo[i]
          mine.push((path, check.parse_entry(path, src, sig, lazy)))
        }
        mine
      }))
    }
    var all: List[(Str, check.ParseEntry)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  for (path, e) in parsed {
    if !c.parse_cache.contains(path) {
      c.parse_cache[path] = e
    }
  }
}

/// After the check: the files it parsed, as the build target's parse
/// list, when they changed (from the target's second build); the parses of program files leave the parse
/// cache (it carries std's alone to a process's next program).
fn parse_list_store(os: Os, var c: check.Checker, dir: Str) {
  var out = StrBuilder.new()
  for (path, sig) in c.parsed {
    out.write(if sig { "s " } else { "f " })
    out.write(path)
    out.write("\n")
  }
  let list = out.freeze().bytes()
  let p = parse_list_path(os, dir)
  match os.fs.read(p) {
    Ok(old) => {
      if old != list {
        cache_put(os, p, list)
      }
    }
    // a target's first build writes it too: the next builds of an
    // unchanged program hit the test run cache and check nothing, so the
    // first edit build found no list and parsed every file itself
    // (2026-10-21: 0 of 185 parses reused in an edit build of
    // `xo test --std-module=native/path`); a list is a few KB
    Err(_) => cache_put(os, p, list)
  }
  var keep: Map[Str, check.ParseEntry] = {}
  for (path, e) in c.parse_cache {
    if path.starts_with("std/") {
      keep[path] = e
    }
  }
  c.parse_cache = keep
}

/// `xo dev iface-check DIR`: for every .xo file under DIR, and for
/// mutations of it (identifiers renamed through the file, a comment
/// added, `pub` added before a top level `fn`), whether
/// parser.iface_text_lex (std_tree_sum's) gives iface_text's text; a
/// line per difference, exit 1 when any. Files that do not parse are
/// skipped (a build of them fails first).
fn iface_check_cmd(os: Os, dir: Str) -> Int {
  let all = match os.fs.walk(dir) {
    Ok(fs) => fs
    Err(e) => {
      os.stdio.eprintln("iface-check: ${e}")
      return 2
    }
  }
  var files = 0
  var cases = 0
  var bad = 0
  for fi in all {
    if fi.is_dir || !fi.path.ends_with(".xo") {
      continue
    }
    let src = match os.fs.read(fi.path) {
      Ok(b) => b
      Err(_) => continue
    }
    if parser.parse_file(fi.path.bytes(), src, true).hard {
      continue
    }
    files += 1
    var variants: List[(Str, Bytes)] = [("as is", src)]
    let toks = lexer.lex(src).tokens
    var idents: List[Int] = []
    for (k, t) in toks.indexed() {
      if t.kind == lexer.Kind.Ident {
        idents.push(k)
      }
    }
    // up to 24 identifiers spread through the file, each renamed
    let step = (idents.len() / 24).max(1)
    var n = 0
    while n < idents.len() {
      let t = toks[idents[n]]
      let at = t.span.end.offset
      variants.push(("rename ${t.text.to_str() ?? ""} at ${t.span.start.line}", src[0..at] + b"Q" + src[at..src.len()]))
      n += step
    }
    // a comment at the start of the line of every 8th newline
    var nl = 0
    for (k, t) in toks.indexed() {
      if t.kind == lexer.Kind.Newline {
        nl += 1
        if nl % 8 == 0 && k + 1 < toks.len() {
          let at = toks[k + 1].span.start.offset
          variants.push(("comment at ${toks[k + 1].span.start.line}", src[0..at] + b"// x\n" + src[at..src.len()]))
        }
      }
    }
    // pub before each top level fn that has none
    for (k, t) in toks.indexed() {
      if t.kind == lexer.Kind.Fn && (k == 0 || toks[k - 1].kind == lexer.Kind.Newline) {
        let at = t.span.start.offset
        variants.push(("pub at ${t.span.start.line}", src[0..at] + b"pub " + src[at..src.len()]))
      }
    }
    for (what, v) in variants {
      if parser.parse_file(fi.path.bytes(), v, true).hard {
        continue
      }
      cases += 1
      if parser.iface_text(fi.path.bytes(), v) != parser.iface_text_lex(v) {
        bad += 1
        os.stdio.println("DIFF ${fi.path}: ${what}")
      }
    }
  }
  os.stdio.println("iface-check: ${files} files, ${cases} cases, ${bad} differ")
  if bad > 0 { 1 } else { 0 }
}

/// XO_STD_FACTS_DUMP is written, and XO_STD_FACTS_VERIFY checked, where
/// insert_rc takes the cache's path (rc_cached): a build that does not
/// fails instead of doing neither.
fn no_std_facts_dump(os: Os) {
  let p = os.env.get("XO_STD_FACTS_DUMP") ?? os.env.get("XO_STD_FACTS_VERIFY") ?? ""
  if !p.is_empty() {
    fail(os, "XO_STD_FACTS_DUMP=${p} is not written by this build: its reference counting does not take the backend cache's path (XO_BACKEND_CACHE=off, XO_PASSES, --release, or a program of under 256 functions)")
  }
}
