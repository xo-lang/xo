// `xo1 build --backend=wasm` (decision 0179): the SSA module after the
// passes lowered by compiler/wasm to a WebAssembly module whose only
// imports are WASI preview1's (no C compiler, no linker), written to OUT
// (default <name>.wasm) with its WAT text beside it (OUT with .wat). A
// program the backend does not support yet fails with its reason; no
// module is written.
//
// build_wasm cannot fail with an error: an error result would record its
// arguments for the error trace (decision 0104), whose Debug text of the
// Module collides with compiler/lexer's Kind in the Go SSA builder
// (gotchas/ssa-debug-helper-unqualified-type-name.md).

use github.com/xo-lang/xo/compiler/ssa
use github.com/xo-lang/xo/compiler/tzsel
use github.com/xo-lang/xo/compiler/wasm

/// skip (Opts.skip_unsupported): what the backend does not support is
/// returned (the target skipped) instead of failing the build; "" when
/// the module was written.
fn build_wasm(os: Os, ctx: Ctx, m: ssa.Module, out0: Str, wd: Str, dir: Str, tz: tzsel.TZSel, skip: Bool) -> Str {
  if !tz.err.is_empty() {
    fail(os, tz.err)
  }
  for n in tz.notes {
    os.stdio.eprintln(n)
  }
  let p = wasm.generate_tz(m, false, false, false, tz)
  if !p.err.is_empty() {
    if skip {
      return p.err
    }
    fail(os, "the wasm backend: ${p.err}")
  }
  var out = out0
  if out.is_empty() {
    let parts = dir.trim_suffix("/").split("/")
    let last = parts[parts.len() - 1]
    let name = if last == "." || last.is_empty() { base_name(wd) } else { last }
    out = "${name}.wasm"
  }
  // NAME.wasm and NAME.wat built in a hidden stage beside them, then
  // moved into place (ld.xo Stage)
  let st = stage(os, ctx, abs_of(wd, out))
  match os.fs.write(st.bin, p.wasm) {
    Ok(_) => {}
    Err(e) => fail_stage(os, st, "cannot write the program to ${out}: ${fs_reason(e)}")
  }
  match os.fs.write("${st.bin.trim_suffix(".wasm")}.wat", p.wat.bytes()) {
    Ok(_) => {}
    Err(e) => fail_stage(os, st, "cannot write ${out.trim_suffix(".wasm")}.wat: ${fs_reason(e)}")
  }
  let err = st.commit(os)
  if !err.is_empty() {
    fail(os, err)
  }
  ""
}
