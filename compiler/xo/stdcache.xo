// std's object for separately compiled builds (decision 0388): its
// store (link_store's input) and its facts (the program's front end's)
// for one target and concurrency variant, kept in the back-end cache as
// two files, std/<key>.store and std/<key>.stdf, and built on the first
// build that wants them (xo dev stdobj, in a directory of its own, then
// renamed into place: concurrent builds each build it and the last
// rename wins, the same bytes). The prune treats them as any entry; a
// pair with one file gone is built again. Any failure leaves the build
// whole-program.

use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/macho
use github.com/xo-lang/xo/compiler/prune
use std/crypto

/// The version of std's entries: a new one when the store's layout or
/// the facts' codec changes (with STORE_MAGIC, gotchas/store-format-magic.md).
const STD_CACHE_VERSION = 1

/// The key of std's entries for target, conc and test (decision 0436:
/// std built in test mode for `xo test`): the code generation
/// identity of this xo (cache_id's, without a separately compiled
/// build's facts, which these are), the target, the variant, and every
/// std source's path, size and modification time (a body edit in a
/// development std changes the object, unlike std_tree_sum's interface
/// hash); "" when xo's identity or std cannot be read.
fn std_cache_key(os: Os, ctx: Ctx, std: Str, tgoos: Str, tgoarch: Str, conc: Bool, tmode: Bool) -> Str {
  let id = if XO_CODEGEN_KEY.len() == 64 { "codegen ${XO_CODEGEN_KEY}" } else { self_id(os) }
  if id.is_empty() {
    return ""
  }
  let tree = std_tree_lines(os, ctx, std)
  if tree.is_empty() {
    return ""
  }
  crypto.sha256("${std_key_head(id, tgoos, tgoarch, conc, tmode)}${tree}".bytes()).to_hex()
}

/// The part of std_cache_key before std's tree lines.
fn std_key_head(id: Str, tgoos: Str, tgoarch: Str, conc: Bool, tmode: Bool) -> Str {
  "xo std v${STD_CACHE_VERSION}\n${id}\n${tgoos}/${tgoarch}\nconc=${conc}\n${if tmode { "test=1\n" } else { "" }}"
}

/// std's .xo files under std (not its tests), one "PATH SIZE MTIME" line each in path
/// order, the part of std_cache_key every variant shares: walked once a
/// process (Ctx.std_trees); "" when std cannot be walked.
fn std_tree_lines(os: Os, ctx: Ctx, std: Str) -> Str {
  if let Some(m) = ctx.std_trees {
    if let Some(t) = m.with(fn(t) { t.get(std) }) {
      return t
    }
  }
  let files = match os.fs.walk(std) {
    Ok(fs) => fs
    Err(_) => return ""
  }
  var b = StrBuilder.new()
  for f in files.sort_by(fn(f: FileInfo) -> Str { f.path }) {
    // not std's tests: no variant reads them (a build skips them, decision
    // 0348; a test variant is a program's test build, and only
    // --std-module loads a module's tests), so editing one keeps the
    // variants (`xo test --std-module` after a test edit)
    if !f.is_dir && f.path.ends_with(".xo") && !f.path.ends_with("_test.xo") {
      b.write("${f.path.trim_prefix(std)} ${f.size} ${f.modified.unix_millis()}\n")
    }
  }
  let t = b.freeze()
  if let Some(m) = ctx.std_trees {
    m.with(fn(var tr) { tr[std] = t })
  }
  t
}

/// The paths of std's store and facts for the target and variant, built
/// into the cache when missing; None when the cache is off or the build
/// failed (the caller builds the whole program). phases: one line on
/// standard error saying which.
fn std_variant(os: Os, ctx: Ctx, tgoos: Str, tgoarch: Str, conc: Bool, tmode: Bool, phases: Bool) -> (Str, Str)? {
  // a release's own (lib/xo/stdstore beside its std, which never
  // changes): this xo's, by its identity
  if let Some(p) = std_released(os, ctx.std, tgoos, tgoarch, conc, tmode) {
    if phases {
      os.stdio.eprintln("cache std released conc=${conc}${tv(tmode)}")
    }
    return Some(p)
  }
  if on_wasi() {
    // no process builds std's store here (decision 0405): a release's
    // prebuilt one above, else the whole program is built
    if phases {
      os.stdio.eprintln("cache std off (the WASI build starts no process): the whole program is built")
    }
    return None
  }
  let dir = std_cache_dir(os)
  if dir.is_empty() {
    if phases {
      os.stdio.eprintln("cache std off (XO_BACKEND_CACHE=off): the whole program is built")
    }
    return None
  }
  let key = std_cache_key(os, ctx, ctx.std, tgoos, tgoarch, conc, tmode)
  if key.is_empty() {
    return None
  }
  let store = "${dir}/std/${key}.store"
  let facts = "${dir}/std/${key}.stdf"
  let have = (os.fs.exists(store).ok() ?? false) && (os.fs.exists(facts).ok() ?? false)
  if have {
    prune.mark_used_within(os.fs, os.clock, store, BACKEND_TOUCH)
    prune.mark_used_within(os.fs, os.clock, facts, BACKEND_TOUCH)
    // xo:allow XO0903 only a windows store has its PDB parts
    if os.fs.exists("${store}.pdb").ok() ?? false {
      prune.mark_used_within(os.fs, os.clock, "${store}.pdb", BACKEND_TOUCH)
    }
    // a darwin store's part objects (decision 0401), which a debug map
    // names with a time of 0, so marking them used keeps lldb reading them
    std_parts_used(os, "${store}.parts")
    if phases {
      os.stdio.eprintln("cache std ${key[0..12]} conc=${conc}${tv(tmode)} reused")
    }
    return Some((store, facts))
  }
  // the background child (std_variant_peek's) builds only while it
  // holds the lock: one background build at a time, every variant; the
  // lock goes with its process, so a builder that died leaves none
  let child = (os.env.get("XO_STD_BG_CHILD") ?? "") == "1"
  var held: FileLock? = None
  if child {
    os.fs.create_dir_all("${dir}/std").ignore_err("the lock's open reports it")
    match os.fs.try_lock("${dir}/std/${STD_BG_LOCK}") {
      Ok(Some(l)) => held = Some(l)
      _ => return None
    }
    os.fs.write("${dir}/std/${STD_BG_INFO}", "${tgoos}/${tgoarch} conc=${conc}${tv(tmode)} since ${os.clock.now().format_rfc3339()}\n".bytes()).ignore_err("only what xo dev stdcache shows")
  }
  // built in a directory of its own under the cache, then each file
  // renamed into place (a reader sees a whole file or none)
  let tmp = "${dir}/std/.build-${os.rand.bytes(6).to_hex()}"
  let t0 = os.clock.now()
  let xo = check.executable(os.env, os.fs)
  let env = ["XO_STD=${ctx.std}", "XO_BACKEND_CACHE_DIR=${tmp}/cache", "XO_SEPCOMP=", "XO_SEPCOMP_FACTS=", "XO_SEPCOMP_STORE=", "XO_SEPCOMP_FACTS_CONC=", "XO_SEPCOMP_STORE_CONC=", "XO_SEPCOMP_DEFAULT=", "XO_STD_OBJ=", "XO_STD_ROOTS=", "XO_STD_STORE=", "XO_STD_BG_CHILD=", "XO_SEPCOMP_BG=0"] + STD_CODE_ENV.map(fn(n) { "${n}=" })
  let run = match env_command(os, env + [xo, "dev", "stdobj", "--target=${tgoos}/${tgoarch}", "--conc=${if conc { "1" } else { "0" }}"] + (if tmode { ["--test"] } else { [] }) + ["--facts=${tmp}/std.stdf", "${tmp}/obj"]).output() {
    Ok(r) => (r.code == 0, if r.code == 0 { "" } else { "xo dev stdobj exit ${r.code}: ${stdobj_said(r.stderr.to_str() ?? "")}" })
    Err(e) => (false, "starting ${xo}: ${e}")
  }
  let (ok, why0) = run
  var why = why0
  var done = false
  if ok {
    // a windows store's PDB parts (coffstore.xo coff_store_pdb), which
    // pe_link reads beside XO_SEPCOMP_STORE, before the store: a reader
    // that sees the store sees them (without them the link reads std's
    // DWARF for the PDB, slower and the same)
    // xo:allow XO0903 only a windows store has them
    if os.fs.exists("${tmp}/obj/std.store.pdb").ok() ?? false {
      os.fs.rename("${tmp}/obj/std.store.pdb", "${store}.pdb").ignore_err("the link reads std's DWARF instead")
    }
    match os.fs.rename("${tmp}/obj/std.store", store) {
      Ok(_) => {
        match os.fs.rename("${tmp}/std.stdf", facts) {
          Ok(_) => { done = true }
          Err(e) => { why = "renaming the facts: ${e}" }
        }
      }
      Err(e) => { why = "renaming the store: ${e}" }
    }
    if done && tgoos == "darwin" {
      // std's part objects, which a separately compiled program's debug
      // map names (decision 0401: lldb reads std's DWARF from them); the
      // directory renamed into place whole, each object's DWARF
      // pointers first made what lldb reads (macho debug_map_object)
      debug_map_parts(os, "${tmp}/obj")
      os.fs.rename("${tmp}/obj", "${store}.parts").ignore_err("another build placed them, or the debug map falls back to std's embedded DWARF")
    }
  }
  os.fs.remove_all(tmp).ignore_err("only disk: the prune takes a leftover build directory")
  // a failed build leaves its reason beside the store's name, so the
  // builds that find no store say why instead of going whole program in
  // silence (2026-10-29: a std edit that only the store's full check
  // rejected hid every separately compiled build for hours); the key
  // changes with std's files, so a fixed std builds again
  // the marker names the std tree it failed for: the key follows std's
  // relative paths, sizes and times, not its place, so another copy of the
  // same std shares it (b26, owner's v0.38.1 evaluation: a deleted
  // release smoke test's std turned separate compilation off for the
  // intact install)
  if !done {
    os.fs.write("${store}.failed", "${why}\nstd ${ctx.std}\n".bytes()).ignore_err("only the warning")
  } else {
    os.fs.remove("${store}.failed").ignore_err("none was there")
    if tmode {
      // what the key hashed, for a --std-module run after a source edit
      // (std_variant_near)
      let id = if XO_CODEGEN_KEY.len() == 64 { "codegen ${XO_CODEGEN_KEY}" } else { self_id(os) }
      os.fs.write("${dir}/std/${key}.tree", "${std_key_head(id, tgoos, tgoarch, conc, tmode)}${std_tree_lines(os, ctx, ctx.std)}".bytes()).ignore_err("only a --std-module run after an edit misses")
    }
  }
  if let Some(l) = held {
    os.fs.remove("${dir}/std/${STD_BG_INFO}").ignore_err("only what xo dev stdcache shows")
    l.unlock()
  }
  if phases {
    os.stdio.eprintln("cache std ${key[0..12]} conc=${conc}${tv(tmode)} ${if done { "built" } else { "failed (${why}): the whole program is built" }} in ${os.clock.since(t0).millis()} ms")
  }
  if done { Some((store, facts)) } else { None }
}

/// How long a failed std store build stops separately compiled builds
/// before one is tried again.
const STD_FAILED_TTL = 1h

/// The reason of a failed store build that holds for std (its marker
/// at path names this std tree and is under STD_FAILED_TTL old), or None:
/// no marker, one of another tree or of an older xo (no std line), or one
/// past its time; a marker that does not hold is removed, so the next
/// build tries again.
fn std_failed_here(os: Os, path: Str, std: Str) -> Str? {
  let b = os.fs.read(path).ok() ?? return None
  let lines = (b.to_str() ?? "").trim().split("\n")
  let why = if lines.is_empty() { "" } else { lines[0].trim() }
  var here = false
  for l in lines {
    if l.starts_with("std ") && l[4..] == std {
      here = true
    }
  }
  var fresh = false
  if let Ok(Some(fi)) = os.fs.stat(path) {
    fresh = os.clock.since(fi.modified) < STD_FAILED_TTL
  }
  if here && fresh {
    return Some(why)
  }
  os.fs.remove(path).ignore_err("the next build tries again either way")
  None
}

/// What a failed `xo dev stdobj` said: its first diagnostic line (file:
/// line: error ...), else its last line.
fn stdobj_said(stderr: Str) -> Str {
  let lines = stderr.trim().split("\n")
  for l in lines {
    if l.contains(": error ") {
      return l.trim()
    }
  }
  lines.last() ?? ""
}

/// " test=1" for std's test variant (decision 0436) in the lines
/// --phase-times and xo dev stdcache print, else "".
fn tv(tmode: Bool) -> Str {
  if tmode { " test=1" } else { "" }
}

/// The lock a background build of std's variants holds, and what it is
/// building, in the cache's std directory.
const STD_BG_LOCK = ".bg.lock"
const STD_BG_INFO = ".bg-info"

/// The paths of std's store and facts for the target and variant when
/// they are ready (a release's, or the cache's), else None after starting
/// their build in the background (a detached, niced `xo dev stdcache`)
/// for the next build: the build that asked goes whole program, never
/// slower than without separate compilation (decision 0388, the default).
/// XO_SEPCOMP_BG=0 starts none; one runs at a time; phases: a line on
/// standard error saying which.
fn std_variant_peek(os: Os, ctx: Ctx, tgoos: Str, tgoarch: Str, conc: Bool, tmode: Bool, phases: Bool) -> (Str, Str)? {
  if let Some(p) = std_released(os, ctx.std, tgoos, tgoarch, conc, tmode) {
    if phases {
      os.stdio.eprintln("cache std released conc=${conc}${tv(tmode)}")
    }
    return Some(p)
  }
  let dir = std_cache_dir(os)
  if dir.is_empty() || on_wasi() {
    return None
  }
  let key = std_cache_key(os, ctx, ctx.std, tgoos, tgoarch, conc, tmode)
  if key.is_empty() {
    return None
  }
  let store = "${dir}/std/${key}.store"
  let facts = "${dir}/std/${key}.stdf"
  if (os.fs.exists(store).ok() ?? false) && (os.fs.exists(facts).ok() ?? false) {
    prune.mark_used_within(os.fs, os.clock, store, BACKEND_TOUCH)
    prune.mark_used_within(os.fs, os.clock, facts, BACKEND_TOUCH)
    // xo:allow XO0903 only a windows store has its PDB parts
    if os.fs.exists("${store}.pdb").ok() ?? false {
      prune.mark_used_within(os.fs, os.clock, "${store}.pdb", BACKEND_TOUCH)
    }
    std_parts_used(os, "${store}.parts")
    if phases {
      os.stdio.eprintln("cache std ${key[0..12]} conc=${conc}${tv(tmode)} reused")
    }
    return Some((store, facts))
  }
  let say = fn(why: Str) {
    if phases {
      os.stdio.eprintln("std variant: miss, ${why}")
    }
  }
  // a build of this variant failed for this std less than an hour ago:
  // one warning, every build; a marker of another std tree (one that
  // shares the key: the same files elsewhere) or an older one is retried
  // (b26: a deleted std's failure turned the install's off for good)
  if let Some(why) = std_failed_here(os, "${store}.failed", ctx.std) {
    os.stdio.eprintln("xo: warning: separate compilation is off: std's store build failed (${why}); the whole program is built (retried after an hour; ${store}.failed)")
    return None
  }
  if (os.env.get("XO_SEPCOMP_BG") ?? "") == "0" {
    say("the whole program is built (XO_SEPCOMP_BG=0)")
    return None
  }
  if host_os(os) == "windows" {
    // no detached child there yet (prune_bins runs inline the same way)
    say("the whole program is built (no background build on windows)")
    return None
  }
  // one background build at a time: a held lock is a build running
  os.fs.create_dir_all("${dir}/std").ignore_err("the lock's open reports it")
  match os.fs.try_lock("${dir}/std/${STD_BG_LOCK}") {
    Ok(Some(l)) => l.unlock()
    Ok(None) => {
      say("a background build is running, the whole program is built")
      return None
    }
    Err(_) => return None
  }
  let xo = check.executable(os.env, os.fs)
  // its own std, cache and target (the child holds the lock while it
  // builds; two that start at once build one, the other finds it held)
  let script = "XO_STD_BG_CHILD=1 XO_STD=\"$1\" XO_PROF= XO_PROF_OUT= XO_TRACE= XO_TRACE_OUT= nice -n 10 \"$0\" dev stdcache --conc=$2 --target=$3 $4 </dev/null >/dev/null 2>&1 &"
  os.proc.cmd("/bin/sh", ["-c", script, xo, ctx.std, if conc { "1" } else { "0" }, "${tgoos}/${tgoarch}", if tmode { "--test" } else { "" }]).run().ignore_err("a build that does not start starts on a later build")
  say("building in the background, the whole program is built")
  None
}

/// What a background build of std's variants is building ("" for none).
fn std_bg_running(os: Os) -> Str {
  let dir = std_cache_dir(os)
  if dir.is_empty() {
    return ""
  }
  match os.fs.try_lock("${dir}/std/${STD_BG_LOCK}") {
    Ok(Some(l)) => {
      l.unlock()
      ""
    }
    Ok(None) => ((os.fs.read("${dir}/std/${STD_BG_INFO}").ok() ?? b"").to_str() ?? "").trim()
    Err(_) => ""
  }
}

/// The back-end cache's directory std's entries live under ("" when the
/// cache is off).
fn std_cache_dir(os: Os) -> Str {
  let host = host_os(os)
  backend_cache_dir(os, Ctx{goos: host, std: "", xo: "", cache: user_cache_dir(os, host)})
}

/// The release's store and facts for the target and variant: in
/// lib/xo/stdstore beside std (std at <prefix>/lib/xo/std, the release
/// layout), <os>-<arch>-conc<N>[-test].store and .stdf, used when the .id file
/// beside them names this xo's code generation identity; None otherwise.
fn std_released(os: Os, std: Str, tgoos: Str, tgoarch: Str, conc: Bool, tmode: Bool) -> (Str, Str)? {
  if XO_CODEGEN_KEY.len() != 64 || !std.trim_suffix("/").ends_with("/lib/xo/std") {
    return None
  }
  let base = "${dir_name(std.trim_suffix("/"))}/stdstore/${tgoos}-${tgoarch}-conc${if conc { 1 } else { 0 }}${if tmode { "-test" } else { "" }}"
  // xo:allow XO0903 no release store: the cache's is used
  let id = (os.fs.read("${base}.id").ok() ?? b"").to_str() ?? ""
  if id.trim() != XO_CODEGEN_KEY {
    return None
  }
  // a windows store's PDB parts beside it (pe_link reads PATH.pdb): one
  // shipped without them is not used, as the cache's are kept together
  let pdb = tgoos != "windows" || (os.fs.exists("${base}.store.pdb").ok() ?? false)
  let have = pdb && (os.fs.exists("${base}.store").ok() ?? false) && (os.fs.exists("${base}.stdf").ok() ?? false)
  if have { Some(("${base}.store", "${base}.stdf")) } else { None }
}

/// Marks each of a store's part objects used (decision 0401: they go
/// with the store, which the prune keeps while builds use it).
fn std_parts_used(os: Os, dir: Str) {
  match os.fs.read_dir(dir) {
    Ok(fs) => {
      for f in fs {
        if !f.is_dir {
          prune.mark_used_within(os.fs, os.clock, f.path, BACKEND_TOUCH)
        }
      }
    }
    Err(_) => {}
  }
}

/// Each part object of dir rewritten for a debug map (macho
/// debug_map_object); a part it cannot rewrite stays as built (lldb then
/// misplaces its functions' addresses).
fn debug_map_parts(os: Os, dir: Str) {
  match os.fs.read_dir(dir) {
    Ok(fs) => {
      for f in fs {
        if f.is_dir || !f.path.ends_with(".o") {
          continue
        }
        match os.fs.read(f.path) {
          Ok(b) => {
            let m = macho.debug_map_object(b)
            if m.len() == b.len() && m != b {
              os.fs.write(f.path, m).ignore_err("the part stays as built")
            }
          }
          Err(_) => {}
        }
      }
    }
    Err(_) => {}
  }
}

/// The std modules a --std-module run of m builds from source (item 2 of
/// the test speed queue): m and every native std module that imports it,
/// directly or not (their store code may hold m's old bodies inlined and
/// its old layouts), as check's module paths ("native/NAME"). Read from
/// the `use` lines of std/native's sources.
fn std_source_set(os: Os, std: Str, m: Str) -> Set[Str] {
  let root = std.trim_suffix("/")
  let top = m.trim_prefix("std/").trim_prefix("native/")
  // each native module's imports, by its name
  var imps: Map[Str, List[Str]] = {}
  for e in os.fs.read_dir("${root}/native").ok() ?? [] {
    var files: List[Str] = []
    var name = ""
    if e.is_dir {
      name = e.name
      for f in os.fs.read_dir("${root}/native/${e.name}").ok() ?? [] {
        if !f.is_dir && f.name.ends_with(".xo") && !f.name.ends_with("_test.xo") {
          files.push("${root}/native/${e.name}/${f.name}")
        }
      }
    } else if e.name.ends_with(".xo") && !e.name.ends_with("_test.xo") {
      name = e.name.trim_suffix(".xo")
      files.push("${root}/native/${e.name}")
    }
    for f in files {
      for l in (os.fs.read_text(f).ok() ?? "").split("\n") {
        if let Some(rest) = l.cut_prefix("use std/") {
          let dep = rest.trim().trim_prefix("native/").split(" ")[0]
          var cur = imps.get(name) ?? []
          cur.push(dep)
          imps[name] = cur
        }
      }
    }
  }
  var set: Set[Str] = #{top}
  var grew = true
  while grew {
    grew = false
    for (n, deps) in imps.entries() {
      if !set.contains(n) && deps.any(fn(d) { set.contains(d) }) {
        set.add(n)
        grew = true
      }
    }
  }
  var out: Set[Str] = #{}
  for n in set.to_list() {
    out.add("native/${n}")
  }
  out
}

/// A test variant for a --std-module run whose module (or an importer of
/// it) was edited since the variant was built (item 2 of the test speed
/// queue): one whose .tree file equals this std's tree once the files of
/// src's modules (std_source_set's, built from source by this run) are
/// left out on both sides. The rest of std is the same, and none of it
/// imports a module of src, so its store code is the code this std
/// compiles to. None when there is none.
fn std_variant_near(os: Os, ctx: Ctx, tgoos: Str, tgoarch: Str, conc: Bool, src: Set[Str], phases: Bool) -> (Str, Str)? {
  let dir = std_cache_dir(os)
  if dir.is_empty() || on_wasi() || src.is_empty() {
    return None
  }
  let id = if XO_CODEGEN_KEY.len() == 64 { "codegen ${XO_CODEGEN_KEY}" } else { self_id(os) }
  if id.is_empty() {
    return None
  }
  let tree = std_tree_lines(os, ctx, ctx.std)
  if tree.is_empty() {
    return None
  }
  let want = std_key_head(id, tgoos, tgoarch, conc, true) + tree_without(tree, src)
  for e in os.fs.read_dir("${dir}/std").ok() ?? [] {
    if e.is_dir || !e.name.ends_with(".tree") {
      continue
    }
    let key = e.name.trim_suffix(".tree")
    let got = match os.fs.read_text("${dir}/std/${e.name}") {
      Ok(t) => t
      Err(_) => continue
    }
    let nl = got.find("test=1\n") ?? -1
    if nl < 0 || got[0..nl + 7] + tree_without(got[nl + 7..], src) != want {
      continue
    }
    let store = "${dir}/std/${key}.store"
    let facts = "${dir}/std/${key}.stdf"
    if (os.fs.exists(store).ok() ?? false) && (os.fs.exists(facts).ok() ?? false) {
      prune.mark_used_within(os.fs, os.clock, store, BACKEND_TOUCH)
      prune.mark_used_within(os.fs, os.clock, facts, BACKEND_TOUCH)
      std_parts_used(os, "${store}.parts")
      if phases {
        os.stdio.eprintln("cache std ${key[0..12]} conc=${conc} test=1 reused, ${src.len()} module(s) from source")
      }
      return Some((store, facts))
    }
  }
  None
}

/// std's tree lines without the files of src's modules ("native/NAME":
/// the lines of native/NAME.xo and native/NAME/...).
fn tree_without(tree: Str, src: Set[Str]) -> Str {
  var b = StrBuilder.new()
  for l in tree.split("\n") {
    if l.is_empty() {
      continue
    }
    let p = l.split(" ")[0].trim_prefix("/")
    let i = p.find("/") ?? -1
    let j = if i < 0 { -1 } else { p[i + 1..].find("/") ?? -1 }
    let top = if j < 0 { p.trim_suffix(".xo") } else { p[0..i + 1 + j] }
    if !src.contains(top) {
      b.write("${l}\n")
    }
  }
  b.freeze()
}
