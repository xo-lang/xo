// `xo dev` (decision 0209): the hidden developer commands. `dump` runs a
// compiler component's own command line (its dump_main) in this
// process, and the rest (goldens, errorcheck, codegen) are
// compiler/cli/dev's (`rtpack` went with the C runtime, decision 0234).
//
//   xo dev dump lex|ast|types|ssa|asm|llvm|go [flags] PATH...
//   xo dev edges [--out=FILE] DIR (the resolved references of a program)
//   xo dev goldens|errorcheck|codegen [flags] DIR...

use github.com/xo-lang/xo/compiler/lexer
use github.com/xo-lang/xo/compiler/parser
use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/ssa
use github.com/xo-lang/xo/compiler/arm64
use github.com/xo-lang/xo/compiler/llvm
use github.com/xo-lang/xo/compiler/gen
use github.com/xo-lang/xo/compiler/cli/dev
use github.com/xo-lang/xo/compiler/cli/servers

fn dev_cmd(os: Os, args: List[Str]) -> Int {
  if args.is_empty() {
    os.stdio.eprintln(dev.usage())
    return 2
  }
  match args[0] {
    "dump" => dump_cmd(os, args[1..])
    "edges" => servers.edges_cmd(os, args[1..])
    "build-each" => build_each_cmd(os, args[1..])
    "stdobj" => stdobj_cmd(os, args[1..])
    "stdcache" => stdcache_cmd(os, args[1..])
    // parser.iface_text_lex against iface_text on every file under a
    // directory and mutations of it (TestIfaceLexMatchesParse)
    "iface-check" => if args.len() == 2 { iface_check_cmd(os, args[1]) } else { 2 }
    // the back-end cache's detached prune (bcache.xo prune_backend_cache)
    "prune-backend" => if args.len() == 2 { prune_backend_child(os, args[1]) } else { 2 }
    "prune-bins" => if args.len() == 2 { prune_bins_child(os, args[1]) } else { 2 }
    _ => {
      let goos = host_os(os)
      let h = dev.Host{
        xo: check.executable(os.env, os.fs),
        std: check.std_dir(os.env, os.fs),
        cache: user_cache_dir(os, goos),
        host: "${goos}/${host_arch()}",
        passes: arm64.passes(),
      }
      dev.run(os, h, args)
    }
  }
}

/// stdcache_cmd is `xo dev stdcache [--conc=0|1] [--target=OS/ARCH] [--peek]`:
/// std's store and facts for the variant from the back-end cache
/// (stdcache.xo std_variant, built on a miss), their paths on two lines;
/// exit 1 when there are none (decision 0388). The release prebuilds the
/// host's with it. --peek: std_variant_peek's answer instead (a miss
/// starts the build in the background and exits 1).
fn stdcache_cmd(os: Os, args: List[Str]) -> Int {
  let host = host_os(os)
  var conc = false
  var goos = host
  var goarch = host_arch()
  var peek = false
  for a in args {
    if a == "--peek" {
      peek = true
    } else if a == "--conc=1" {
      conc = true
    } else if a == "--conc=0" {
      conc = false
    } else if a.starts_with("--target=") && a.contains("/") {
      let t = a.trim_prefix("--target=").split("/")
      goos = t[0]
      goarch = t[1]
    } else {
      os.stdio.eprintln("usage: xo dev stdcache [--conc=0|1] [--target=OS/ARCH] [--peek]")
      return 2
    }
  }
  let ctx = Ctx{goos: host, std: check.std_dir(os.env, os.fs), xo: "", cache: user_cache_dir(os, host)}
  if (os.env.get("XO_STD_BG_CHILD") ?? "") != "1" {
    let bg = std_bg_running(os)
    if !bg.is_empty() {
      os.stdio.eprintln("xo dev stdcache: a background build is running (${bg})")
    }
  }
  let got = if peek { std_variant_peek(os, ctx, goos, goarch, conc, true) } else { std_variant(os, ctx, goos, goarch, conc, true) }
  match got {
    Some((store, facts)) => {
      os.stdio.println(store)
      os.stdio.println(facts)
      0
    }
    None => 1
  }
}

/// stdobj_cmd is `xo dev stdobj [--conc=0|1] [--facts=FILE] [--target=OS/ARCH]
/// OUT`: std's
/// object for one variant (decision 0388): the part objects and their
/// store (std.store) in OUT, built from an empty program (XO_STD_OBJ,
/// XO_STD_CONC, no dead function removal, no hollowing), and with
/// --facts its facts (an XO_STD_ROOTS build's XO_STD_FACTS_DUMP, in a
/// cold cache of its own: a warm one's undecoded bodies carry fewer known
/// results). conc defaults to 0. The empty program and the cache go when
/// it is done.
fn stdobj_cmd(os: Os, args: List[Str]) -> Int {
  var conc = "0"
  var facts = ""
  // a target other than the host's (`--target=os/arch`, passed on)
  var target = ""
  var out = ""
  for a in args {
    if a.starts_with("--conc=") {
      conc = a.trim_prefix("--conc=")
    } else if a.starts_with("--facts=") {
      facts = a.trim_prefix("--facts=")
    } else if a.starts_with("--target=") {
      target = a
    } else if out.is_empty() && !a.starts_with("-") {
      out = a
    } else {
      out = ""
      break
    }
  }
  if out.is_empty() || !(conc is "0" | "1") {
    os.stdio.eprintln("usage: xo dev stdobj [--conc=0|1] [--facts=FILE] [--target=OS/ARCH] OUT")
    return 2
  }
  let wd = os.env.get("PWD") ?? "."
  // (check.is_rooted: C:/x is absolute on windows too; CI 40816535382:
  // std's variant directory was joined onto the working directory)
  if !check.is_rooted(out) {
    out = "${wd}/${out}"
  }
  if !facts.is_empty() && !check.is_rooted(facts) {
    facts = "${wd}/${facts}"
  }
  let prog = "${out}/.stdobj-prog"
  write_or_fail(os, prog, "${prog}/xo.mod", "module stdobj\nedition preview\n".bytes())
  write_or_fail(os, prog, "${prog}/main.xo", "fn main(os: Os) {\n}\n".bytes())
  let xo = check.executable(os.env, os.fs)
  let base = ["PWD=${prog}", "XO_STD_CONC=${conc}", "XO_DCE=off"]
  let tg: List[Str] = if target.is_empty() { [] } else { [target] }
  let obj_args = base + ["XO_STD_OBJ=${out}", "XO_PASSES=-hollow", xo, "build"] + tg + ["-o", "${prog}/x", prog]
  let facts_args = base + ["XO_STD_ROOTS=1", "XO_STD_FACTS_DUMP=${facts}", "XO_BACKEND_CACHE=on", "XO_BACKEND_CACHE_DIR=${prog}/cache", "XO_BUILD_DIR=${prog}/build", xo, "build"] + tg + ["-o", "${prog}/xf", prog]
  // the object and the facts at once: two builds of std whole, each
  // most of the time (about 8 s each on the Mac, 2026-10-28)
  let results = scope s {
    let a = s.spawn(fn() -> (Int, Str) { stdobj_run(os, prog, obj_args) })
    let b = s.spawn(fn() -> (Int, Str) { if facts.is_empty() { (0, "") } else { stdobj_run(os, prog, facts_args) } })
    [a.await, b.await]
  }
  var code = 0
  for (c, err) in results {
    if c != 0 {
      os.stdio.eprint(err)
      code = c
    }
  }
  os.fs.remove_all(prog).ignore_err("only disk: a leftover empty program")
  code
}

/// One build of `xo dev stdobj` (env and its command) in the program's
/// directory dir: its exit code and standard error. The directory, not
/// the caller's: the build's compilation directory (its .debug_str
/// comp_dir slots, in every object of std's store) came from the
/// working directory, so std's bytes depended on where the build that
/// started `xo dev stdcache` ran, and a deleted working directory failed
/// the build ("no `main` function"; gotchas/stdobj-cwd-in-std-bytes.md).
fn stdobj_run(os: Os, dir: Str, args: List[Str]) -> (Int, Str) {
  match env_command(os, args).dir(dir).output() {
    Ok(r) => (r.code, r.stderr.to_str() ?? "")
    Err(e) => (1, "xo dev stdobj: ${e}\n")
  }
}

/// build_each_cmd is `xo dev build-each [build flags] -- OUT DIR [OUT DIR
/// ...]`: the native build of each program DIR into OUT, one after
/// another in this process, carrying the checker's std parses from one
/// build to the next (decision 0209, std once per worker). It prints
/// `== build DIR` before and `== built DIR MS` after each; a build that
/// fails ends the process as `xo build` does, after its marker, so the
/// caller (xo dev goldens) knows which one failed and starts another
/// worker for the rest.
fn build_each_cmd(os: Os, args: List[Str]) -> Int {
  var flags: List[Str] = []
  var pairs: List[Str] = []
  var sep = false
  var from_stdin = false
  for a in args {
    if !sep && a == "--" {
      sep = true
    } else if sep {
      pairs.push(a)
    } else if a == "--stdin" {
      from_stdin = true
    } else {
      flags.push(a)
    }
  }
  if (!from_stdin && pairs.is_empty()) || pairs.len() % 2 != 0 {
    os.stdio.eprintln("usage: xo dev build-each [--stdin] [build flags] -- OUT DIR [OUT DIR ...]")
    return 2
  }
  let goos = host_os(os)
  var pc: Map[Str, check.ParseEntry] = {}
  var i = 0
  while {
    if i >= pairs.len() {
      if !from_stdin {
        break
      }
      // --stdin: the next `OUT<tab>DIR` line, until the input ends
      // xo:allow XO0903 end of input or an error ends the interactive loop
      let line = os.stdio.read_line().ok() ?? None
      match line {
        Some(l) => {
          let f = l.split("\t")
          if f.len() != 2 {
            continue
          }
          pairs.push(f[0])
          pairs.push(f[1])
        }
        None => break
      }
    }
    let out = pairs[i]
    let dir = pairs[i + 1]
    os.stdio.println("== build ${dir}")
    let t0 = os.clock.now()
    var o = parse_args(os, ["build"] + flags + ["-o", out, dir])
    o.parse_cache = pc
    o.reuse_parse = true
    let ctx = Ctx{goos: goos, std: o.std, xo: dir_name(o.std.trim_suffix("/")), cache: user_cache_dir(os, goos)}
    let backend = if o.backend.is_empty() { native_backend(o) } else { o.backend }
    let nb = build_native(os, ctx, o, backend)
    pc = nb.pc
    os.stdio.println("== built ${dir} ${os.clock.since(t0).millis()}")
    i += 2
  }
  0
}

/// dump_cmd is `xo dev dump KIND args...`: the component's command line,
/// with --std of this xo unless args name one.
fn dump_cmd(os: Os, args: List[Str]) -> Int {
  if args.is_empty() {
    os.stdio.eprintln("usage: xo dev dump lex|ast|types|ssa|asm|llvm|go [flags] PATH...")
    return 2
  }
  var rest = args[1..]
  if args[0] != "lex" && args[0] != "ast" && !rest.any(fn(a: Str) { a.starts_with("--std=") }) {
    rest = ["--std=${check.std_dir(os.env, os.fs)}"] + rest
  }
  match args[0] {
    "lex" => lexer.dump_main(os, rest)
    "ast" => parser.dump_main(os, rest)
    "types" => check.dump_main(os, rest)
    "ssa" => ssa.dump_main(os, rest)
    "asm" => arm64.dump_main(os, rest)
    "llvm" => llvm.dump_main(os, rest)
    "go" => gen.dump_main(os, rest)
    _ => {
      os.stdio.eprintln("xo dev dump: unknown kind ${args[0].quote()} (lex, ast, types, ssa, asm, llvm, go)")
      2
    }
  }
}
