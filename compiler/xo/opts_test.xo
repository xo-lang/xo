// The command line's path normalization on a Windows host (opts.xo
// os_path, path_env_over): `\` as `/`, UNC paths, and nothing changed on
// other hosts (a `\` is a character of a name there).

test "path variables given with backslashes are normalized on a windows host only" {
  let vars: Map[Str, Str] = {"XO_STD": "C:\\xo\\std", "XO_SEPCOMP_STORE": "\\\\srv\\share\\store", "XO_BACKEND_CACHE_DIR": "D:/cache", "XO_DUMP_DIR": "C:\\tmp", "HOME": "C:\\Users\\x", "XO_PASSES": "a\\b"}
  let over = path_env_over(vars, true)
  expect(over.get("XO_STD")) == Some("C:/xo/std")
  expect(over.get("XO_SEPCOMP_STORE")) == Some("//srv/share/store")
  expect(over.get("XO_DUMP_DIR")) == Some("C:/tmp")
  // already in / form, not a path variable, not a known variable: untouched
  expect(over.get("XO_BACKEND_CACHE_DIR")) == None
  expect(over.get("HOME")) == None
  expect(over.get("XO_PASSES")) == None
  expect(path_env_over(vars, false).len()) == 0
}

test "every classified path variable is a PATH_ENV entry" {
  for n in ["XO_STD", "XO_MODCACHE", "XO_BACKEND_CACHE_DIR", "XO_SEPCOMP_STORE", "XO_SEPCOMP_STORE_CONC", "XO_SEPCOMP_FACTS", "XO_SEPCOMP_FACTS_CONC", "XO_STD_STORE", "XO_STD_OBJ", "XO_SYSROOT", "XO_WINSYSROOT", "XO_LINUXSYSROOT", "XO_GOBIND", "XO_GOCACHE", "XO_BUILD_DIR", "XO_CBIND_DIR", "XO_GOBIND_DIR", "XO_BIN_CACHE", "XO_DUMP_DIR", "XO_FE_KEEP_DIR", "XO_STD_FACTS_DUMP"] {
    expect(PATH_ENV.contains(n)) == true
  }
}

// Task #244 (the owner's 0.51.1 Windows evaluation, bug 23): a library
// build with no --targets on a Windows host builds the host's DLL, by
// the steps --targets=windows/ARCH chooses.
test "a library build with no targets names the windows host's target" {
  let host = host_arch()
  if host is "arm64" | "amd64" {
    expect(lib_host_targets(Opts{lib: "shared"}, "windows")) == "windows/${host}"
  }
  expect(lib_host_targets(Opts{lib: "shared", backend: "arm64"}, "windows")) == "windows/arm64"
  expect(lib_host_targets(Opts{lib: "shared", backend: "amd64"}, "windows")) == "windows/amd64"
  // given targets, other hosts and programs are as they were
  expect(lib_host_targets(Opts{lib: "shared", targets: "windows/arm64"}, "windows")) == "windows/arm64"
  expect(lib_host_targets(Opts{lib: "shared", targets: "wasip1/wasm"}, "windows")) == "wasip1/wasm"
  expect(lib_host_targets(Opts{lib: "shared"}, "linux")) == ""
  expect(lib_host_targets(Opts{lib: "static"}, "darwin")) == ""
  expect(lib_host_targets(Opts{}, "windows")) == ""
}

// a bare --since takes no value (decision 0701): the front took the
// directory after it as the value and did not convert its `\` on Windows
// (task #605, 2026-11-21)
test "a bare --since leaves the next argument to the directories" {
  expect(takes_next_arg(value_flags(), "since")) == false
  expect(takes_next_arg(value_flags(), "o")) == true
  expect(takes_next_arg(value_flags(), "backend")) == true
  expect(takes_next_arg(value_flags(), "race")) == false
}
