// Tests of xo run --watch's install step.

test "a built binary that cannot be installed is reported, not run as the old one" {
  os.fs.create_dir_all("w")?
  os.fs.write("w/next", b"new")?
  expect(install(os.fs, "w/next", "w/prog")) == ""
  expect(os.fs.read("w/prog")?) == b"new"
  // no next (a failed move): the reason, which the cycle reports as failed
  expect(install(os.fs, "w/next", "w/prog").contains("install w/prog")) == true
}

test "a stop removes a stage and its tomb, and a stage already gone is no error" {
  // (a writer racing the removal is not modelled: MemFs's write makes
  // missing parents, the real filesystem's does not, std.md 8.3)
  os.fs.create_dir_all("o/.p.tmp-1-a/p.dSYM/Contents")?
  os.fs.write("o/.p.tmp-1-a/p", b"bin")?
  os.fs.write("o/.p.tmp-1-a/p.dSYM/Contents/f", b"dwarf")?
  os.fs.write("o/keep", b"k")?
  remove_stage(os.fs, os.clock, os.stdio, "o/.p.tmp-1-a")
  // neither the stage nor its tomb (o/.xo-stop.p.tmp-1-a) is left
  expect(os.fs.walk("o")?.map(fn(e: FileInfo) -> Str { e.path })) == ["o/keep"]
  remove_stage(os.fs, os.clock, os.stdio, "o/.p.tmp-1-b")
  expect(os.fs.walk("o")?.map(fn(e: FileInfo) -> Str { e.path })) == ["o/keep"]
}

test "a build removes the tombs an earlier stopped build of its output left" {
  os.fs.create_dir_all("o/.xo-stop.p.tmp-1-a/p.dSYM")?
  os.fs.write("o/.xo-stop.p.tmp-1-a/p", b"bin")?
  os.fs.create_dir_all("o/.xo-stop.q.tmp-1-a")?
  os.fs.write("o/p", b"old")?
  remove_tombs(os.fs, "o/p")
  // q's tomb is another output's
  expect(os.fs.read_dir("o")?.map(fn(e: FileInfo) -> Str { e.name })) == [".xo-stop.q.tmp-1-a", "p"]
}
