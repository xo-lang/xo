// C library builds (decision 0574): the header
// of a library's exports, and a static library's archive.
use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/parser

/// The C header of c's library: xo_init and the root package's `as c`
/// functions, in their modules' and names' order, as C prototypes.
fn c_header(c: check.Checker, guard: Str) -> Str {
  var out: List[Str] = ["/* Generated by xo build --lib (decision 0574). Do not edit. */\n#ifndef ${guard}\n#define ${guard}\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n/* Starts the Xo runtime; the library runs it when loaded, and a second call does nothing. */\nint64_t xo_init(int argc, char **argv, char **envp);\n\n/* A Bytes argument: n bytes at p, borrowed for the call (Xo copies them). */\ntypedef struct XoBytes { const uint8_t *p; int64_t n; } XoBytes;\n\n/* A Str argument: n bytes of UTF-8 text at p (no NUL needed), borrowed for the call (Xo copies them; each byte of an invalid sequence becomes U+FFFD). */\ntypedef struct XoStr { const char *p; int64_t n; } XoStr;\n\n/* The calling thread's last error text, from the last function that set its err to 1 there (the next error replaces it), or NULL. */\nconst char *xo_last_error(void);\n\n/* A value of another type: kept by the library until xo_release (a released handle faults when used). */\ntypedef uint64_t XoHandle;\nvoid xo_release(XoHandle h);\n"]
  for m in c.root_mods {
    var names: List[Str] = []
    for (n, o) in c.mods[m].members {
      if c.objs[o].kind == check.ObjKind.Func && c.objs[o].recv < 0 && !c.objs[o].fn_decl.is_empty() {
        names.push(n.to_str() ?? "")
      }
    }
    for n in names.sort() {
      let o = c.mods[m].members.get(n.bytes()) ?? -1
      for cl in c.objs[o].fn_decl[0].clauses {
        if let parser.Clause.CExportClause(name: cn, ..) = cl {
          var ps: List[Str] = []
          for p in c.objs[o].params {
            ps.push("${c_type(c.show(p.ty))} ${p.name.to_str() ?? "p"}")
          }
          if c.objs[o].err >= 0 {
            // an error result: 0 or 1 through err (NULL: not stored), the
            // text in xo_last_error
            ps.push("int32_t *err")
          }
          let r = if c.objs[o].result == c.unit_ty { "void" } else { c_type(c.show(c.objs[o].result)) }
          out.push("\n/* ${n} */\n${r} ${cn.to_str() ?? ""}(${if ps.is_empty() { "void" } else { ps.join(", ") }});\n")
        }
      }
    }
  }
  out.push("\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
  out.join("")
}

/// The C type of a boundary type's name.
fn c_type(t: Str) -> Str {
  match t {
    "Int" => "int64_t"
    "Float" => "double"
    "Bytes" => "XoBytes"
    "Str" => "XoStr"
    _ => if t.ends_with("?") && !(t[0..t.len() - 1] is "Int" | "Float" | "Bool" | "Str" | "Bytes") && !t.starts_with("fn") {
      // an Option (the checker shows Option[T] as T?), decision 0574: 0
      // for None, else the value's handle
      "XoHandle /* ${t[0..t.len() - 1]} or 0 */"
    } else {
      "XoHandle /* ${t} */"
    }
  }
}

/// The header's path beside a library out: its base without `lib` and
/// the extension, then `.h`.
fn c_header_path(out: Str) -> (Str, Str) {
  let slash = out.rfind("/") ?? -1
  let dir = if slash >= 0 { out[0..slash + 1] } else { "" }
  var base = out[slash + 1..out.len()]
  for ext in [".dylib", ".so", ".a"] {
    base = base.trim_suffix(ext)
  }
  base = base.trim_prefix("lib")
  (dir + base + ".h", base.to_upper().replace("-", "_").replace(".", "_") + "_H")
}

/// Writes the static library out (an `ar` archive) of srcs on goos:
/// each source assembled or compiled with cc and flags, the constructor
/// (c_ctor_asm), all joined into one object (cc -r: a C program's link
/// takes an archive's member only for a symbol it needs, which would
/// leave the constructor out); the error text, or "" when it was written.
fn ar_static(os: Os, goos: Str, cc: Str, flags: List[Str], srcs: List[Str], out: Str) -> Str {
  var objs: List[Str] = []
  for (i, s) in srcs.indexed() {
    if s.ends_with(".o") || s.ends_with(".a") {
      objs.push(s)
      continue
    }
    let obj = "${out}.${i}.o"
    let why = cc_object(os, cc, flags + ["-fexceptions", "-funwind-tables"], s, obj)
    if !why.is_empty() {
      return why
    }
    objs.push(obj)
  }
  let cs = "${out}.ctor.s"
  if let Err(e) = os.fs.write(cs, c_ctor_asm(goos).bytes()) {
    return "write ${cs}: ${e}"
  }
  let why = cc_object(os, cc, flags, cs, "${out}.ctor.o")
  os.fs.remove(cs).ignore_err("staged")
  if !why.is_empty() {
    return why
  }
  objs.push("${out}.ctor.o")
  let one = "${out}.lib.o"
  var msg = run_out(os, cc, flags + ["-r", "-nostdlib", "-o", one] + objs)
  for ob in objs {
    if ob.starts_with("${out}.") {
      os.fs.remove(ob).ignore_err("a staged object")
    }
  }
  if !msg.is_empty() {
    return msg
  }
  var members = [one]
  if goos == "darwin" {
    // the runtime's weak references the object leaves undefined (the
    // ThreadSanitizer fiber hooks), which a program's link passes as -U:
    // absolute symbols at 0 in a member of their own, so the C program's
    // link resolves them as a program's weak reference with no
    // definition reads
    var undef: Set[Str] = #{}
    match os.proc.cmd("nm", ["-u", one]).output() {
      Ok(r) => {
        for l in (r.stdout.to_str() ?? "").split("\n") {
          undef.add(l.trim())
        }
      }
      Err(e) => return "nm: ${e}"
    }
    var a: List[Str] = []
    for w in weak_undefined_args(os, srcs) {
      let sym = w.trim_prefix("-Wl,-U,")
      if undef.contains(sym) {
        a.push("\t.globl ${sym}\n\t.set ${sym}, 0\n")
      }
    }
    if !a.is_empty() {
      let ws = "${out}.weak.s"
      if let Err(e) = os.fs.write(ws, a.join("").bytes()) {
        return "write ${ws}: ${e}"
      }
      let why2 = cc_object(os, cc, flags, ws, "${out}.weak.o")
      os.fs.remove(ws).ignore_err("staged")
      if !why2.is_empty() {
        return why2
      }
      members.push("${out}.weak.o")
    }
  }
  os.fs.remove(out).ignore_err("no earlier archive")
  msg = match os.proc.cmd("ar", ["rcs", out] + members).set_env("ZERO_AR_DATE", "1").output() {
    Ok(r) => if r.code == 0 { "" } else { "ar: ${r.stdout.to_str() ?? ""}${r.stderr.to_str() ?? ""}" }
    Err(e) => "ar: ${e}"
  }
  for m in members {
    os.fs.remove(m).ignore_err("a staged object")
  }
  msg
}

/// cc with flags compiling or assembling src into obj; the error text, or
/// "".
fn cc_object(os: Os, cc: Str, flags: List[Str], src: Str, obj: Str) -> Str {
  run_out(os, cc, flags + ["-c", src, "-o", obj])
}

/// Runs cmd with args: "" when it exited 0, else its output.
fn run_out(os: Os, cmd: Str, args: List[Str]) -> Str {
  match os.proc.cmd(cmd, args).output() {
    Ok(r) => if r.code == 0 { "" } else { "${cmd} ${args.join(" ")}: ${r.stdout.to_str() ?? ""}${r.stderr.to_str() ?? ""}" }
    Err(e) => "${cmd}: ${e}"
  }
}

/// The C names of the root package's `as c` functions, in their modules'
/// and names' order.
fn c_export_names(c: check.Checker) -> List[Str] {
  var out: List[Str] = []
  for m in c.root_mods {
    var names: List[Str] = []
    for (n, o) in c.mods[m].members {
      if c.objs[o].kind == check.ObjKind.Func && c.objs[o].recv < 0 && !c.objs[o].fn_decl.is_empty() {
        names.push(n.to_str() ?? "")
      }
    }
    for n in names.sort() {
      let o = c.mods[m].members.get(n.bytes()) ?? -1
      for cl in c.objs[o].fn_decl[0].clauses {
        if let parser.Clause.CExportClause(name: cn, ..) = cl {
          out.push(cn.to_str() ?? "")
        }
      }
    }
  }
  out
}

/// The path in dir and the text of a shared library's symbol list on
/// goos: darwin's exported symbols list, or a linux version script, of
/// xo_init and the exports.
fn c_exports_list(exports: List[Str], dir: Str, goos: Str) -> (Str, Str) {
  let names = ["xo_init", "xo_last_error", "xo_release"] + exports
  if goos == "darwin" {
    var b: List[Str] = []
    for n in names {
      b.push("_${n}\n")
    }
    return ("${dir}/exports.txt", b.join(""))
  }
  var b: List[Str] = ["{\n  global:\n"]
  for n in names {
    b.push("    ${n};\n")
  }
  b.push("  local: *;\n};\n")
  ("${dir}/exports.map", b.join(""))
}

/// The assembly of a shared library's constructor entry on goos: xo_init
/// in darwin's __mod_init_func or ELF's .init_array, which the loader
/// calls with (argc, argv, envp) before dlopen returns or main runs.
fn c_ctor_asm(goos: Str) -> Str {
  if goos == "darwin" {
    return "\t.section __DATA,__mod_init_func,mod_init_funcs\n\t.p2align 3\n\t.quad _xo_init\n"
  }
  "\t.section .init_array,\"aw\",@init_array\n\t.p2align 3\n\t.quad xo_init\n\t.section .note.GNU-stack,\"\",@progbits\n"
}
