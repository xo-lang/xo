// The pieces of internal/build xo1 shares between its steps: the host,
// the user cache directory, finding programs on PATH, the identity of a
// tool (toolID), and the hash a cache key accumulates (binKey). Each one
// computes what the Go driver computes, so both drivers find the same
// entries in the same caches.

use std/crypto
use github.com/xo-lang/xo/compiler/hostpath

/// The host's GOOS ("darwin", "linux", or "windows"): Windows is the OS
/// this xo was built for (decision 0197), the others from `uname -s`.
/// The host's OS by name: the OS this xo was built for (hostpath.host).
/// It ran `uname -s` as a subprocess, 1 to 2 ms a call, and self_id
/// alone called it four times a build (2026-10-28: 3 to 7 ms of a 109 ms
/// edit).
fn host_os(_os: Os) -> Str {
  hostpath.host()
}

/// The host's GOARCH: the architecture this xo was built for (a
/// linux/amd64 release's xo1 is an amd64 binary, decision 0178 switch
/// point B; built by the LLVM backend on an x86-64 host, where xo1's
/// LLVM builds target the host and --no-gc defaults to LLVM).
fn host_arch() -> Str {
  match target.arch {
    Amd64 => "amd64"
    Arm64 => "arm64"
    Wasm32 => "wasm"
  }
}

/// Whether this xo runs on Windows (the OS it was built for).
fn is_windows() -> Bool { hostpath.windows() }

/// Whether p is absolute: rooted at / on every host, and on Windows a
/// drive path (C:/x, C:\x; paths reach xo with / separators there,
/// std.md 3.1).
fn is_abs_path(p: Str) -> Bool { hostpath.is_abs(p) }

/// The null device for a tool's input or output.
fn dev_null() -> Str {
  if is_windows() { "NUL" } else { "/dev/null" }
}

/// os.UserCacheDir: ~/Library/Caches on macOS; $XDG_CACHE_HOME when it is
/// absolute, else ~/.cache, on Linux; %LocalAppData% on Windows (with /
/// separators). "" when there is no home.
fn user_cache_dir(os: Os, goos: Str) -> Str {
  if goos == "windows" {
    return (os.env.get("LocalAppData") ?? "").replace("\\", "/")
  }
  if goos == "linux" {
    let x = os.env.get("XDG_CACHE_HOME") ?? ""
    if x.starts_with("/") {
      return x
    }
  }
  let home = os.env.get("HOME") ?? ""
  if home.is_empty() {
    return ""
  }
  if goos == "darwin" {
    return "${home}/Library/Caches"
  }
  "${home}/.cache"
}

/// exec.LookPath: name when it holds a slash and is an executable file,
/// else the first executable file name in a directory of $PATH; "" when
/// there is none.
fn look_path(os: Os, name: Str) -> Str {
  if is_windows() {
    return look_path_windows(os.env, os.fs, name)
  }
  if name.contains("/") {
    return if is_exec(os.fs, name) { name } else { "" }
  }
  for d in (os.env.get("PATH") ?? "").split(":") {
    let dir = if d.is_empty() { "." } else { d }
    let p = "${dir}/${name}"
    if is_exec(os.fs, p) {
      return p
    }
  }
  ""
}

/// exec.LookPath on Windows: a name holding \\, /, or : is a path, tried
/// as written when it has an extension and with each extension of
/// %PATHEXT%; else each directory of %PATH% (; separated) in turn. The
/// result uses / separators.
fn look_path_windows(env: Env, fs: Fs, name: Str) -> Str uses env, fs.read {
  let n = name.replace("\\", "/")
  if n.contains("/") || n.contains(":") {
    return find_exe_windows(env, fs, n)
  }
  for d0 in (env.get("PATH") ?? "").split(";") {
    let d = d0.trim_prefix("\"").trim_suffix("\"").replace("\\", "/").trim_suffix("/")
    if d.is_empty() {
      continue
    }
    let p = find_exe_windows(env, fs, "${d}/${n}")
    if !p.is_empty() {
      return p
    }
  }
  ""
}

/// exec's findExecutable on Windows: p when its last element has an
/// extension and it exists, else p with the first extension of %PATHEXT%
/// that exists; "" when none does.
fn find_exe_windows(env: Env, fs: Fs, p: Str) -> Str uses env, fs.read {
  let last = base_name(p)
  if last.contains(".") && is_exec(fs, p) {
    return p
  }
  let pe = env.get("PATHEXT") ?? ""
  for e in (if pe.is_empty() { ".com;.exe;.bat;.cmd" } else { pe }).split(";") {
    if !e.is_empty() && is_exec(fs, p + e.to_lower()) {
      return p + e.to_lower()
    }
  }
  ""
}

/// A file that is not a directory (the native Fs has no permission bits
/// yet, decision 0163, so the execute bit LookPath also wants is not
/// checked).
fn is_exec(fs: Fs, p: Str) -> Bool uses fs.read {
  match fs.stat(p) {
    Ok(Some(fi)) => !fi.is_dir
    _ => false
  }
}

/// Runs cmd with args and returns its combined output and Go's error
/// text ("" on success), as exec.Command(...).CombinedOutput does.
fn combined(os: Os, cmd: Str, args: List[Str]) -> (Str, Str) {
  match os.proc.run(cmd, args) {
    Ok(r) => {
      let out = (r.stdout.to_str() ?? "") + (r.stderr.to_str() ?? "")
      if r.code != 0 {
        return (out, "exit status ${r.code}")
      }
      (out, "")
    }
    Err(e) => ("", "exec: ${e}")
  }
}

/// toolID: the output of the command, and the path, size, and
/// modification time (Unix nanoseconds) of the program it runs.
fn tool_id(os: Os, goos: Str, name: Str, args: List[Str]) -> Str {
  let (out, err) = combined(os, name, args)
  var id = out
  if !err.is_empty() {
    id = "error ${err}"
  }
  let p = look_path(os, name)
  if !p.is_empty() {
    match os.fs.stat(p) {
      Ok(Some(fi)) => {
        let ns = mtime_ns(os, goos, p)
        if !ns.is_empty() {
          id = "${id}\n${p} ${fi.size} ${ns}"
        }
      }
      _ => {}
    }
  }
  id
}

/// tool_id, once per process for a tool (its path and arguments): a build
/// asks for the C compiler's id in the run cache key and again in the
/// backend's keys, two process spawns each. A tool that changed between
/// two xo processes still changes the id, the memo lives in ctx.
///
/// Across processes too, in the backend cache's toolid/ directory under
/// the hash of the arguments and tool_stamp: `cc --version` and stat(1)
/// took 9.2 and 2.3 ms on the Mac, on every build, hit or miss of the run
/// cache (2026-10-26). The limit is self_id's: a tool replaced by one of
/// the same size and the same modified time (to the millisecond) keeps
/// the old id; installers and xcode-select switches change the stamp,
/// and XO_BACKEND_CACHE=off avoids the memo.
fn tool_id_memo(os: Os, ctx: Ctx, name: Str, args: List[Str]) -> Str {
  let m = match ctx.tools {
    Some(m) => m
    None => return tool_id(os, ctx.goos, name, args)
  }
  let k = "${look_path(os, name)}\x00${name}\x00${args.join("\x00")}"
  if let Some(v) = m.with(fn(t) { t.get(k) }) {
    return v
  }
  var memo = ""
  let st = tool_stamp(os, ctx.goos, name)
  let dir = backend_cache_dir(os, ctx)
  if !st.is_empty() && !dir.is_empty() {
    memo = "${dir}/toolid/${crypto.sha256("xo tool id v1\n${k}\n${st}".bytes()).to_hex()}"
    match os.fs.read(memo) {
      Ok(b) => {
        if let Some(v) = b.to_str() {
          m.with(fn(var t) { t[k] = v })
          return v
        }
      }
      // xo:allow XO0903 a memo: a failed read runs the tool
      Err(_) => {}
    }
  }
  let id = tool_id(os, ctx.goos, name, args)
  m.with(fn(var t) { t[k] = id })
  if !memo.is_empty() {
    cache_put(os, memo, id.bytes())
  }
  id
}

/// What tool_id_memo's memo is keyed on, "" when the tool is not found
/// (no memo): the path of each file the tool's run goes through, with its
/// size and modified time in milliseconds: name on PATH, each symbolic
/// link it follows, and on macOS, for a /usr/bin shim (cc, clang), the
/// developer directory xcrun picks (DEVELOPER_DIR, else xcode-select's
/// link, else the Command Line Tools) and the tool and clang in it,
/// with the environment xcrun reads.
fn tool_stamp(os: Os, goos: Str, name: Str) -> Str {
  if is_windows() {
    return ""
  }
  var p = look_path(os, name)
  if p.is_empty() {
    return ""
  }
  var b = StrBuilder.new()
  var hops = 0
  while hops < 16 {
    b.write(file_stamp(os, p))
    let t = match os.fs.read_link(p) {
      Ok(Some(t)) => t
      _ => break
    }
    p = if hostpath.is_abs(t) { t } else { "${dir_name(p)}/${t}" }
    hops += 1
  }
  if goos == "darwin" && p.starts_with("/usr/bin/") {
    let dev0 = os.env.get("DEVELOPER_DIR") ?? ""
    let dev = if !dev0.is_empty() {
      dev0
    } else {
      match os.fs.read_link("/var/db/xcode_select_link") {
        Ok(Some(t)) => t
        _ => "/Library/Developer/CommandLineTools"
      }
    }
    b.write("dev ${dev}\nenv ${os.env.get("TOOLCHAINS") ?? ""}\x00${os.env.get("SDKROOT") ?? ""}\n")
    let base = p.trim_prefix("/usr/bin/")
    for d in ["${dev}/usr/bin", "${dev}/Toolchains/XcodeDefault.xctoolchain/usr/bin"] {
      b.write(file_stamp(os, "${d}/${base}"))
      b.write(file_stamp(os, "${d}/clang"))
    }
  }
  b.freeze()
}

/// A line naming p's size and modified time (milliseconds, following
/// links), "-" for both when it cannot be read.
fn file_stamp(os: Os, p: Str) -> Str {
  match os.fs.stat(p) {
    Ok(Some(fi)) => "${p} ${fi.size} ${fi.modified.unix_millis()}\n"
    _ => "${p} - -\n"
  }
}

/// The modification time of p in Unix nanoseconds (os.Stat's ModTime
/// followed by UnixNano), from stat(1): FileInfo.modified is not finer
/// than a millisecond.
fn mtime_ns(os: Os, goos: Str, p: Str) -> Str {
  // GNU stat on Linux and on Windows (Git for Windows' usr/bin)
  let args = if goos != "darwin" { ["-L", "-c", "%.9Y", p] } else { ["-L", "-f", "%Fm", p] }
  let (out, err) = combined(os, "stat", args)
  if !err.is_empty() {
    return ""
  }
  let t = out.trim()
  let parts = t.split(".")
  if parts.len() != 2 || parts[1].len() != 9 {
    return ""
  }
  let sec = Int.parse(parts[0]) ?? 0
  let frac = Int.parse(parts[1]) ?? 0
  "${sec * 1000000000 + frac}"
}

/// A cache key (internal/build binKey): length prefixed strings hashed
/// with SHA-256.
struct Key {
  b: BytesBuilder
}

fn new_key(kind: Str) -> Key {
  var k = Key{b: BytesBuilder.new()}
  k.str("xo-bincache v1 ${kind}")
  k
}

fn (var k: Key) str(s: Str) {
  k.b.write_str("${s.len()}:")
  k.b.write_str(s)
  k.b.write_str("\n")
}

fn (var k: Key) data(d: Bytes) {
  k.b.write_str("${d.len()}:")
  k.b.write(d)
  k.b.write_str("\n")
}

fn (var k: Key) strs(ss: List[Str]) {
  k.str("${ss.len()}")
  for s in ss {
    k.str(s)
  }
}

fn (var k: Key) sum() -> Str {
  crypto.sha256(k.b.freeze()).to_hex()
}

/// Go's %q of a []string: ["a" "b"].
fn go_q(ss: List[Str]) -> Str {
  var parts: List[Str] = []
  for s in ss {
    parts.push(s.quote())
  }
  "[${parts.join(" ")}]"
}

/// A word quoted for sh.
fn sh_q(s: Str) -> Str {
  "'${s.replace("'", "'\\''")}'"
}

/// The last path element.
fn base_name(p: Str) -> Str {
  let parts = p.trim_suffix("/").split("/")
  parts[parts.len() - 1]
}

/// The directory of p ("." for a bare name).
fn dir_name(p: Str) -> Str {
  let parts = p.split("/")
  if parts.len() <= 1 {
    return "."
  }
  let d = parts[0..parts.len() - 1].join("/")
  if d.is_empty() { "/" } else { d }
}

/// Every file under dir (path relative to dir, slash separated), sorted.
fn files_under(os: Os, dir: Str) -> List[Str] ! FsErr {
  var out: List[Str] = []
  // the walk joins paths as Go's filepath.Join does, which drops a
  // leading "./" (the root "." when --std is the relative "std")
  var base = dir
  while base.starts_with("./") {
    base = base.trim_prefix("./")
  }
  for fi in os.fs.walk(dir)? {
    if !fi.is_dir {
      if fi.path.starts_with("${dir}/") {
        out.push(fi.path.trim_prefix("${dir}/"))
      } else {
        out.push(fi.path.trim_prefix("${base}/"))
      }
    }
  }
  out.sort()
}
