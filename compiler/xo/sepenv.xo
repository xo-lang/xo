// Separate compilation by default (decision 0388 stage 3, step d): the
// build's environment with the std variant the driver chose, so every
// reader of XO_SEPCOMP, XO_SEPCOMP_FACTS and XO_SEPCOMP_STORE (the
// opt in's variables) sees the default's choice.

/// An environment with some variables replaced.
struct SepEnv {
  inner: Env
  over: Map[Str, Str]
}

fn (e: SepEnv) get(name: Str) -> Str? uses env {
  match e.over.get(name) {
    Some(v) => Some(v)
    None => e.inner.get(name)
  }
}

fn (e: SepEnv) vars() -> Map[Str, Str] uses env {
  var all = e.inner.vars()
  for (k, v) in e.over {
    all[k] = v
  }
  all
}

fn (e: SepEnv) args() -> List[Str] uses env { e.inner.args() }
fn (e: SepEnv) program() -> Str uses env { e.inner.program() }
fn (e: SepEnv) home() -> Str ! EnvErr uses env { e.inner.home() }
fn (e: SepEnv) only(names: List[Str]) -> Env { e.inner.only(names) }
fn (e: SepEnv) config_dir() -> Str ! EnvErr uses env { e.inner.config_dir() }
fn (e: SepEnv) cache_dir() -> Str ! EnvErr uses env { e.inner.cache_dir() }

/// os with the variables of over set.
fn with_env(os: Os, over: Map[Str, Str]) -> Os {
  Os{net: os.net, fs: os.fs, clock: os.clock, rand: os.rand, env: SepEnv{inner: os.env, over: over}, proc: os.proc, stdio: os.stdio, tasks: os.tasks}
}

/// std's store a separately compiled build links with, for its
/// concurrency: XO_SEPCOMP_STORE, or XO_SEPCOMP_STORE_CONC when the
/// program is concurrent and it is set (the default sets both); "" for a
/// whole program.
fn sepcomp_store(os: Os, conc: Bool) -> Str {
  if sepcomp_facts_path(os).is_empty() {
    return ""
  }
  let sc = if conc { os.env.get("XO_SEPCOMP_STORE_CONC") ?? "" } else { "" }
  if !sc.is_empty() {
    return sc
  }
  os.env.get("XO_SEPCOMP_STORE") ?? ""
}

/// Separate compilation by default (decision 0388 stage 3, step d): os
/// with XO_SEPCOMP and std's variants (both concurrency settings, the
/// build picks one) when this build can take it, else os unchanged.
/// XO_SEPCOMP set (1 or 0) is the user's choice and wins. Only a native
/// darwin or linux, arm64 or amd64, build or run for the host, not
/// --release, --race or a cc link,
/// with the passes as they are; std's variants from the std cache
/// (std_variant_peek: a release's prebuilt ones, else the cache's; a
/// miss builds the whole program, as before, and starts the variant's
/// build in the background, so no build is slower than a whole program's;
/// ADR 0388 Progress). On by default since 2026-10-28;
/// XO_SEPCOMP_DEFAULT=0 (or XO_SEPCOMP=0) turns it off.
fn sepcomp_default(os: Os, ctx: Ctx, o: Opts, backend: Str) -> Os {
  if os.env.get("XO_SEPCOMP") != None || (os.env.get("XO_SEPCOMP_DEFAULT") ?? "") == "0" {
    return os
  }
  let host = host_os(os)
  let arch = host_arch()
  // darwin and linux, arm64 and amd64 (std's Mach-O and ELF stores,
  // decision 0388)
  let served = (host is "darwin" | "linux") && (arch is "arm64" | "amd64")
  if !(o.cmd is "build" | "run") || backend != arch || !served || o.release || o.race || o.linker == "cc" || o.assembler == "cc" || passes_changed(os) || std_code_changed(os, o) {
    return os
  }
  if !(o.targets.is_empty() || o.targets == "${host}/${arch}") {
    return os
  }
  let v0 = match std_variant_peek(os, ctx, host, arch, false, o.phases) {
    Some(v) => v
    None => return os
  }
  let v1 = match std_variant_peek(os, ctx, host, arch, true, o.phases) {
    Some(v) => v
    None => return os
  }
  with_env(os, {"XO_SEPCOMP": "1", "XO_SEPCOMP_FACTS": v0.1, "XO_SEPCOMP_FACTS_CONC": v1.1, "XO_SEPCOMP_STORE": v0.0, "XO_SEPCOMP_STORE_CONC": v1.0})
}

/// The variables that change the code std's functions compile to
/// (TestStdCodeEnvListed keeps it to codegen_test.go's keyed and bypass
/// variables, and XO_LLRT_C and XO_STD_CONC): std's variants are
/// built without them (stdcache.xo clears them), so a build that sets
/// one compiles the whole program.
const STD_CODE_ENV = ["XO_ARM64_PAD", "XO_ARM64_REGS", "XO_ASYNC_PREEMPT", "XO_HEAP_GUARD", "XO_INLINE_DENY", "XO_LOWER", "XO_MAP_LOG", "XO_NATIVE_RACE", "XO_NOLIBC", "XO_POISON_FRAMES", "XO_PREEMPT_POLLS", "XO_LLRT_C", "XO_STD_CONC"]

/// Whether this build compiles std's functions to other code than its
/// variants hold, which are built with the default settings: a variable
/// of STD_CODE_ENV set, or a flag that changes std's code (--seed and
/// --explore: the deterministic scheduler; the memory, preemption and
/// release settings; profiling and tracing support; --hybrid).
fn std_code_changed(os: Os, o: Opts) -> Bool {
  if STD_CODE_ENV.any(fn(n) { !(os.env.get(n) ?? "").is_empty() }) {
    return true
  }
  o.topts.seed != 0 || o.explore > 0 || o.no_mono || o.no_arenas || o.no_preempt || o.no_gc || o.holes || o.hybrid || !o.opt.is_empty() || !o.profile.is_empty() || !o.record.is_empty() || o.error_args != -1 || o.debug_contracts != -1 || o.dbg != -1 || o.trace_support != -1 || o.profile_support != -1 || !o.pack_lists || o.inline_str
}
