// The native link (internal/build ccBuild): the C compiler driver
// assembles the program and links it with the C runtime (std/llrt) and
// the system libraries,
// trying the macOS SDKs internal/build tries until one links.
use github.com/xo-lang/xo/compiler/check
use github.com/xo-lang/xo/compiler/macho

/// What every step needs: the host, the std directory, the repository
/// root (std/..), and the user cache directory.
struct Ctx {
  goos: Str
  std: Str
  xo: Str
  cache: Str
  // std's store a separately compiled program links with (decision
  // 0388 stage 3: sepcomp_store, for the build's concurrency); "" for
  // a whole program
  sep_store: Str = ""
  // decision 0563: a darwin store link of a build meant to leave this
  // machine (--release, an explicit --trimpath; opts.xo ship_build) writes
  // no debug map (decision 0401), whose objects are named by their paths
  // in the back-end cache, and embeds std's DWARF as a whole program does
  no_debug_map: Bool = false
  // the text atoms' order for a store link (decision 0403 stage 1b):
  // symbols, hot first; empty for the store's order
  layout_order: List[Str] = []
  // the entitlements of a darwin program's ad hoc signature (macho_ents)
  entitlements: List[Str] = []
  // the OS a link targets when it is not goos (an LLVM cross build for
  // Windows, decision 0197); "" for the host
  tgoos: Str = ""
  // the cache of linked binaries (bin_cache_dir), "" when it is off
  bin_cache: Str = ""
  // this process's tag in the hidden staging directories of its final
  // outputs (DIR/.NAME.tmp-TAG-RAND, ld.xo Stage), and where each stage
  // directory is announced for the stop watcher (main.xo): Xo has no
  // call for its own process id, so a random tag stands for it
  tmp_tag: Str = ""
  stages: Chan[Str]? = None
  // sent once the outputs are in place (finish): the stop watcher then
  // leaves a SIGINT to the program xo run or xo test runs
  build_done: Chan[()]? = None
  // the stop watcher's handshake with the steps that make directories in a
  // stage or run a child writing one (stage_enter: cc_dsym's dsymutil,
  // --dsym's bundle), which could make a removed stage again
  stage_stop: StageStop? = None
  // xo run's and xo test's windows/amd64 PDBs, made while the program
  // runs (ld.xo PdbLater, finish_pdbs); None: made in the link
  pdb_later: Mutex[List[PdbLater]]? = None
  // a build stored in the run cache (decision 0360): what it printed,
  // kept for the entry, and the entries' directory when it is not
  // bin_cache (a build's or run's: whole_cache_dir)
  tee: Tee? = None
  run_cache: Str = ""
  // what the build read (recorder.xo), for the entry's input list
  rec: Mutex[Rec]? = None
  // XO_CACHE_STATS=1: the build's cache file operations (cachestats.xo)
  cstats: Mutex[CStats]? = None
  // the process's Fs before the recorder and the cache statistics wrap
  // it: the link maps std's store through it (decision 0402: a wrapped Fs
  // is a user value, which read_mapped reads); the store is under the
  // cache, which neither records
  real_fs: Fs? = None
  // the C tool ids this process asked for (tool_id_memo): the run cache's
  // key and the backend's keys ask the same `cc --version` in one build
  tools: Mutex[Map[Str, Str]]? = None
  // --phase-times: the link's own steps as link.* laps (ld.xo)
  phases: Bool = false
  // std's .xo files as std_cache_key lists them, by std directory, made
  // once a process (sepcomp_default asks for both variants' keys)
  std_trees: Mutex[Map[Str, Str]]? = None
  // a linux build's part objects held in memory, by the path they would
  // have in the build's directory: Xo's ELF linker reads them from here
  // instead of a copy of the cached bytes written for every build (3.6 MB
  // of a warm hello, 2026-11-06); darwin writes them (its debug map names
  // the files a debugger reads)
  mem_objs: Map[Str, Bytes] = {}
}

/// The OS the link of ctx targets: the host unless a cross build set it.
fn link_os(ctx: Ctx) -> Str {
  if ctx.tgoos.is_empty() { ctx.goos } else { ctx.tgoos }
}

/// The cc link flag that leaves room in the executable's header for the
/// __DWARF segment's load command embed_dsym adds (ld64 left 32 bytes;
/// 8 sections take 712, a dSYM with accelerator tables more).
const DWARF_HEADERPAD = "-Wl,-headerpad,0x1000"

/// ccBuild: compiles and links srcs into bin with cc and flags; returns
/// the compiler's output of the failed link, "" on success. The sources
/// are the program's assembly or IR and other C sources (no C runtime
/// since decision 0234).
/// PROG.dSYM after a darwin link through cc (decision 0239: the LLVM
/// backend's link and --ld=cc; compiler/macho writes its own, ld.xo).
/// dsymutil, which the Command Line Tools have, gathers the DWARF of the
/// objects the executable's debug map names (the build directory's .o
/// files, or with LTO the object lto_object_flags keeps) into the
/// bundle where lldb and the profiler look. Without dsymutil, or when it
/// fails, the program has no dSYM and the build goes on. (With Xcode
/// 26.6 selected against the macOS 27 SDK the cc link itself fails,
/// gotchas/xcode-ld-vs-clt-sdk27.md; DEVELOPER_DIR picks the tools.)
/// Decision 0346 stage 3: the bundle's DWARF is then embedded in the
/// executable, as compiler/macho's link writes it, and the bundle kept
/// only for --dsym (keep); when embedding fails the bundle stays and a
/// warning says why.
fn cc_dsym(os: Os, ctx: Ctx, bin: Str, keep: Bool, split: Bool, oso_prefix: Str, ents: List[Str]) {
  // dsymutil is a child the stop does not reach, and it makes the
  // bundle's directories itself: the stop watcher waits for it
  if !stage_enter(ctx) {
    return
  }
  cc_dsym_run(os, bin, keep, split, oso_prefix, ents)
  stage_leave(ctx)
}

fn cc_dsym_run(os: Os, bin: Str, keep: Bool, split: Bool, oso_prefix: Str, ents: List[Str]) {
  let d = "${bin}.dSYM"
  os.fs.remove_all(d).ignore_err("none from an earlier link")
  // the object paths in bin are relative to oso_prefix when the link was given
  // -oso_prefix (a build's private directory, build_native)
  let dargs = if oso_prefix.is_empty() { [bin, "-o", d] } else { [bin, "-o", d, "--oso-prepend-path=${oso_prefix}"] }
  match os.proc.run("dsymutil", dargs) {
    Ok(r) => if r.code != 0 {
      os.fs.remove_all(d).ignore_err("a failed dsymutil")
      return
    }
    // xo:allow XO0903 dsymutil is optional: no dSYM, as on a system without it
    Err(_) => return
  }
  if split {
    // --debug-info=split (decision 0355): the bundle stays beside bin
    return
  }
  let why = embed_dsym(os, bin, ents)
  if !why.is_empty() {
    os.stdio.eprintln("xo: ${base_name(bin)}'s DWARF stays in its dSYM: ${why}")
  } else if !keep {
    os.fs.remove_all(d).ignore_err("the program carries its DWARF")
  }
}

/// Moves the DWARF of bin's dSYM into bin (macho.embed_dwarf), signed with
/// the entitlements ents (macho_ents); "" or why not.
fn embed_dsym(os: Os, bin: Str, ents: List[Str]) -> Str {
  let exe = match os.fs.read(bin) {
    Ok(b) => b
    Err(e) => return "reading ${bin}: ${e}"
  }
  let dw = match os.fs.read(dsym_dwarf(bin)) {
    Ok(b) => b
    Err(e) => return "reading its dSYM: ${e}"
  }
  match macho.embed_dwarf(exe, dw, base_name(bin), ents) {
    Ok(out) => write_exe(os, bin, out)
    Err(e) => e
  }
}

/// The linker option opt with the path p as its argument, passed through
/// cc by -Xlinker: `-Wl,` splits its text at commas, so a path with a
/// comma (a Go test's directory names its subtest) reached ld as two
/// arguments, and the second as an input file it could not open
/// (gotchas/wl-path-comma-splits.md).
fn wl_path(opt: Str, p: Str) -> List[Str] { ["-Xlinker", opt, "-Xlinker", p] }

/// The link flags that keep the object of an LTO link in the build
/// directory dir (ld64's -object_path_lto: a file for full LTO, a
/// directory for thin), so dsymutil finds its DWARF after the link; none
/// without LTO, whose objects are the build directory's already.
fn lto_object_flags(os: Os, dir: Str, lto: Str) -> List[Str] {
  match lto {
    "full" => wl_path("-object_path_lto", "${dir}/lto.o")
    "thin" => {
      os.fs.create_dir_all("${dir}/lto").ignore_err("the link reports it")
      wl_path("-object_path_lto", "${dir}/lto")
    }
    _ => []
  }
}

fn cc_build(os: Os, ctx: Ctx, cc: Str, flags0: List[Str], srcs: List[Str], bin: Str) -> Str {
  // libraries of `use c` go after the objects (splitLibs)
  var flags: List[Str] = []
  var libs: List[Str] = []
  for f in flags0 {
    if f.starts_with("-l") && f.len() > 2 {
      libs.push(f)
    } else {
      flags.push(f)
    }
  }
  var cands: List[Str] = []
  let memo = sysroot_memo(os, ctx)
  if !memo.is_empty() {
    match os.fs.read_text(memo) {
      Ok(t) => cands.push(t.trim())
      // xo:allow XO0903 a memo: a failed read finds the sysroot again
      Err(_) => {}
    }
  }
  cands = cands + sysroot_candidates(os, ctx)
  var first = ""
  for root in cands {
    let (out, ok) = try_link(os, ctx, cc, flags, libs, srcs, bin, root)
    if ok {
      if !memo.is_empty() {
        os.fs.create_dir_all(dir_name(memo)).ignore_err("the memo only saves time")
        os.fs.write(memo, "${root}\n".bytes()).ignore_err("the memo only saves time")
      }
      return ""
    }
    // report an SDK independent failure over an SDK mismatch
    if first.is_empty() || (first.contains("tapi error") && !out.contains("tapi error")) {
      first = out
    }
    // only a link failure is worth another SDK
    if !out.contains("linker command failed") {
      return out
    }
  }
  first
}

/// The weak references of the program's assembly or LLVM IR (decision
/// 0232: `.weak_reference _sym`, `declare extern_weak ... @sym(`) as
/// macOS ld's `-U` flags, which leave a symbol no image defines 0 (ld
/// rejects even a weak reference to one otherwise). An object's
/// references are read from its source beside it (.s or .ll), when there
/// is one, and from the object itself otherwise (no source, or a reused
/// object's stub .s).
fn weak_undefined_args(os: Os, srcs: List[Str]) -> List[Str] {
  var seen: Set[Str] = #{}
  var out: List[Str] = []
  for s in srcs {
    var paths = [s]
    if s.ends_with(".o") {
      let base = s.trim_suffix(".o")
      paths = ["${base}.s", "${base}.ll"]
      // xo:allow XO0903 an object it cannot stat is read from its source
      let has_src = (os.fs.exists("${base}.s").ok() ?? false) || (os.fs.exists("${base}.ll").ok() ?? false)
      // a reused cc object's .s is a one-line stub naming its back-end
      // cache key (CC_OBJ_STUB), which holds no weak references
      let stub = match os.fs.read_text("${base}.s") {
        Ok(x) => x.starts_with(CC_OBJ_STUB)
        // xo:allow XO0903 no .s: the .ll or the object is read below
        Err(_) => false
      }
      if !has_src || stub {
        // xo's own assembler writes no .s (b03, field report on 0.26.0:
        // a darwin/amd64 build linked by cc lacked every -U and ld
        // refused the ThreadSanitizer and fiber hooks): the object's own
        // weak references
        match os.fs.read(s) {
          Ok(b) => {
            for sym in macho.weak_undefined(s, b) {
              if !seen.contains(sym) {
                seen.add(sym)
                out = out + ["-Wl,-U,${sym}"]
              }
            }
          }
          // xo:allow XO0903 an unreadable object fails the link itself
          Err(_) => {}
        }
        continue
      }
    }
    for p in paths {
      if !(p.ends_with(".s") || p.ends_with(".ll")) {
        continue
      }
      let text = match os.fs.read_text(p) {
        Ok(t) => t
        Err(_) => continue
      }
      if !text.contains(".weak_reference") && !text.contains("extern_weak") {
        continue
      }
      for line in text.lines() {
        let l = line.trim()
        var sym = ""
        if l.starts_with(".weak_reference ") {
          sym = l.trim_prefix(".weak_reference ").trim()
        } else if l.starts_with("declare extern_weak ") && l.contains("@") {
          let at = l.split("@")[1]
          sym = "_" + at.split("(")[0]
        }
        if !sym.is_empty() && !seen.contains(sym) {
          seen.add(sym)
          out = out + ["-Wl,-U,${sym}"]
        }
      }
    }
  }
  out
}

/// One link with the SDK root ("" the compiler's default): its output,
/// whether it succeeded, and whether the local compile of the runtime
/// failed. rti is the index of the runtime in srcs (-1 for none), shipped
/// the pack's object ("" when none is used).
fn try_link(os: Os, ctx: Ctx, cc: Str, flags: List[Str], libs: List[Str], srcs: List[Str], bin: Str, root: Str) -> (Str, Bool) {
  // faults unwind through the frames of generated code (decision 0085):
  // every frame needs unwind tables (`use c` sources too)
  var args = flags + ["-fexceptions", "-funwind-tables", "-o", bin]
  if !root.is_empty() {
    args = args + ["-isysroot", root]
  }
  args = args + srcs + libs + sys_link_args(link_os(ctx), flags)
  if link_os(ctx) == "darwin" {
    args = args + weak_undefined_args(os, srcs)
  }
  // darwin: ld64 writes each object's modification time into the debug
  // map's OSO entries, which the UUID and the code signature hash, so two
  // links of the same objects differed; ZERO_AR_DATE=1 writes 0 instead
  // (reproducible builds; dsymutil skips the time check for 0)
  let c = if link_os(ctx) == "darwin" { os.proc.cmd(cc, args).set_env("ZERO_AR_DATE", "1") } else { os.proc.cmd(cc, args) }
  match c.output() {
    Ok(r) => ((r.stdout.to_str() ?? "") + (r.stderr.to_str() ?? ""), r.code == 0)
    Err(e) => ("${cc}: ${e}", false)
  }
}

/// sysLinkArgs: the system libraries and linker of a native link on goos.
/// Windows (decision 0197): lld-link, which reads the LTO bitcode MSVC's
/// link.exe cannot, with the import libraries of the DLLs Xo calls
/// (std/native/sys_windows.xo: kernel32, ws2_32 for Winsock, bcrypt,
/// synchronization for WaitOnAddress, ntdll for the AFD polls, shell32
/// for CommandLineToArgvW, crypt32 for the root store; decision 0234,
/// was xo_rt.c's #pragma comment(lib)), and the C library the MSVC one
/// clang picks; /Brepro makes the link deterministic: lld-link
/// writes a hash of the output in the COFF header's time stamp (and the
/// debug directory) instead of the link time, so a rebuild is byte
/// identical (gotchas/windows-lld-link-time-stamp.md); /debug:symtab
/// keeps a COFF symbol table in the file (not mapped, no PDB), which the
/// profiler and the fault traceback read (std/native/llrt/prof.xo
/// coff_symbols, decision 0238). A Linux link with
/// XO_NOLIBC=1 (the runtime compiled with nolibc_flags) is static with no
/// C library, keeping only the sections the program reaches (decision
/// 0206), with the .eh_frame_hdr table the Xo unwinder searches (a
/// static link has none by default).
fn sys_link_args(goos: Str, flags: List[Str]) -> List[Str] {
  // the import libraries are internal/xotool's WindowsLinkLibs too (the test
  // harness's own links, cc.go compileC; TestWindowsLinkLibs keeps them equal)
  if goos == "windows" {
    return ["-fuse-ld=lld", "-Wl,/Brepro", "-Wl,/debug:symtab", "-lkernel32", "-lws2_32", "-lbcrypt", "-lsynchronization", "-lntdll", "-lshell32", "-lcrypt32"]
  }
  if goos == "linux" && flags.contains("-DXO_NOLIBC") {
    return ["-static", "-nostdlib", "-Wl,--gc-sections", "-Wl,--eh-frame-hdr"]
  }
  ["-lm", "-lpthread"]
}

/// Whether a link for tgoos has no C library (decisions 0203, 0206,
/// 0243): on Linux, the default for a program with no `use c` module, as
/// Go links static binaries with no libc; XO_NOLIBC=0 links the C
/// library, and XO_NOLIBC=1 asks for none (an error with `use c`).
/// --race links the C library always: ThreadSanitizer's runtime is
/// built on it (a static -nostdlib link of it cannot work).
fn nolibc(os: Os, o: Opts, c: check.Checker, tgoos: Str) -> Bool {
  if tgoos == "windows" {
    // the amd64 backend's windows/amd64 program with no `use c` has no C
    // runtime and is linked by Xo's PE linker (decision 0254 6b step 4);
    // XO_WIN_NOCRT=0 keeps the MSVC C runtime and lld-link; a `use c`
    // program too when every binding is a prebuilt object (std/sqlite's,
    // decision 0534 stage 2)
    // (windows/arm64 always: Xo's PE linker is its only link, decision
    // 0569 stage 1)
    if o.backend == "arm64" {
      return true
    }
    return o.backend == "amd64" && (os.env.get("XO_WIN_NOCRT") ?? "") != "0" && !uses_c_source(os, o.std, c, tgoos)
  }
  if tgoos != "linux" || o.race {
    return false
  }
  match os.env.get("XO_NOLIBC") ?? "" {
    "0" => false
    "1" => true
    _ => !uses_c(c)
  }
}

/// Whether a module of the program binds C (`use c`) with no prebuilt
/// object for tgoos's amd64 (sqlite_prebuilt).
fn uses_c_source(os: Os, std: Str, c: check.Checker, tgoos: Str) -> Bool {
  for m in c.mods {
    if !m.c_prefix.is_empty() && sqlite_prebuilt(os, std, m, tgoos, "amd64").is_empty() {
      return true
    }
  }
  false
}

/// Whether a module of the program binds C (`use c`).
fn uses_c(c: check.Checker) -> Bool {
  for m in c.mods {
    if !m.c_prefix.is_empty() {
      return true
    }
  }
  false
}

/// The C compiler flags of the runtime with no C library (decision 0206):
/// std/llrt/xo_nolibc.c defines the C library functions it calls, each
/// function in its own section for --gc-sections; no stack protector or
/// fortified calls (they live in libc), and on arm64 the atomics as calls
/// of the outline helpers nolibc_atomics writes, which use the LSE
/// instructions when the CPU has them (xo_lse; inline they would be
/// ARMv8.0's load and store exclusive loops).
fn nolibc_flags(arch: Str) -> List[Str] {
  var out = ["-DXO_NOLIBC", "-ffunction-sections", "-fdata-sections", "-fno-stack-protector", "-U_FORTIFY_SOURCE"]
  if arch == "arm64" {
    out.push("-moutline-atomics")
  }
  out
}

/// Writes dir/xo_atomics.s, libgcc's outline atomics helpers
/// (`__aarch64_cas8_acq` and the other read modify writes of 4 and 8
/// bytes in every model) that the arm64 emitter's code and the LLVM
/// emitter's (-moutline-atomics) call on Linux, for a link with no C
/// library and so no libgcc (decision 0206 stage 2; the bodies are the
/// ELF linker's, macho.outline_atomic_lse, with the LSE dispatch on the
/// program's xo_lse). Each in its own section, for --gc-sections. The
/// path.
fn nolibc_atomics(os: Os, dir: Str) -> Str ! FsErr {
  var b = BytesBuilder.new()
  b.write_str("// Code generated by xo build. DO NOT EDIT.\n// libgcc's outline atomics, for a link with no C library (decision 0206).\n")
  // their LSE paths (cc's assembler takes cas, swp and ldadd only so)
  b.write_str("\t.arch_extension lse\n")
  for op in ["cas", "swp", "ldadd", "ldclr", "ldeor", "ldset"] {
    for size in ["4", "8"] {
      for model in ["relax", "acq", "rel", "acq_rel"] {
        let n = "__aarch64_${op}${size}_${model}"
        b.write_str("\t.section .text.${n},\"ax\",%progbits\n")
        b.write_str(macho.outline_atomic_lse(n, true) ?? "")
      }
    }
  }
  b.write_str("\t.section .note.GNU-stack,\"\",%progbits\n")
  let path = "${dir}/xo_atomics.s"
  os.fs.write(path, b.freeze())?
  Ok(path)
}

/// nolibc_atomics for windows/arm64 (decision 0569 stage 1), as COFF
/// text (no `.type`): each tests xo_lse, defined here and set by
/// cabi_wincrt.xo xo_win_start from IsProcessorFeaturePresent's
/// PF_ARM_V81_ATOMIC_INSTRUCTIONS_AVAILABLE, and takes the LSE
/// instruction or the load and store exclusive loop. The path.
fn win_arm64_atomics(os: Os, dir: Str) -> Str ! FsErr {
  var b = BytesBuilder.new()
  b.write_str("// Code generated by xo build. DO NOT EDIT.\n// libgcc's outline atomics, for windows/arm64 (decisions 0206, 0569).\n")
  b.write_str("\t.arch_extension lse\n\t.data\n\t.globl xo_lse\nxo_lse:\n\t.byte 0\n\t.text\n")
  for op in ["cas", "swp", "ldadd", "ldclr", "ldeor", "ldset"] {
    for size in ["4", "8"] {
      for model in ["relax", "acq", "rel", "acq_rel"] {
        let body = macho.outline_atomic_lse("__aarch64_${op}${size}_${model}", true) ?? ""
        for line in body.split("\n") {
          if !line.is_empty() && !line.starts_with("\t.type ") {
            b.write_str("${line}\n")
          }
        }
      }
    }
  }
  let path = "${dir}/xo_atomics.s"
  os.fs.write(path, b.freeze())?
  Ok(path)
}

/// The directories of a Windows sysroot (root, XO_WINSYSROOT: xwin's
/// --use-winsysroot-style layout) for arch (arm64 or x64): the include
/// directories (MSVC's, then the SDK's ucrt, um and shared) and the
/// library directories (the SDK's um and ucrt, then MSVC's), the newest
/// version of each first (decision 0569: `use c` on windows/arm64).
fn win_sdk_dirs(os: Os, root: Str, arch: Str) -> (List[Str], List[Str]) {
  var inc: List[Str] = []
  var lib: List[Str] = []
  let msvc = sub_dirs(os, "${root}/VC/Tools/MSVC")
  for m in msvc {
    inc.push("${m}/include")
  }
  for k in sub_dirs(os, "${root}/Windows Kits/10/Include") {
    for part in ["ucrt", "um", "shared"] {
      inc.push("${k}/${part}")
    }
  }
  for k in sub_dirs(os, "${root}/Windows Kits/10/Lib") {
    lib.push("${k}/um/${arch}")
    lib.push("${k}/ucrt/${arch}")
  }
  for m in msvc {
    lib.push("${m}/lib/${arch}")
  }
  (inc, lib)
}

/// The directories in dir by path, the greatest name (the newest
/// version) first; none when dir cannot be read.
fn sub_dirs(os: Os, dir: Str) -> List[Str] {
  var names: List[Str] = []
  if let Ok(fis) = os.fs.read_dir(dir) {
    for f in fis {
      if f.is_dir {
        names.push(f.name)
      }
    }
  }
  names.sort().reverse().map(fn(n) { "${dir}/${n}" })
}

/// The import library of `link "name"` in dirs (name.lib, the file
/// name's case ignored: the SDK has User32.Lib and kernel32.Lib), or ""
/// when none has it.
fn win_find_lib(os: Os, dirs: List[Str], name: Str) -> Str {
  let want = "${name.to_lower()}.lib"
  for d in dirs {
    if let Ok(fis) = os.fs.read_dir(d) {
      for f in fis {
        if !f.is_dir && f.name.to_lower() == want {
          return "${d}/${f.name}"
        }
      }
    }
  }
  ""
}

/// sysrootCandidates: $XO_SYSROOT alone, else (macOS) the default, the
/// SDK xcrun names, Xcode's, and the Command Line Tools' newest first.
fn sysroot_candidates(os: Os, ctx: Ctx) -> List[Str] {
  let env_root = os.env.get("XO_SYSROOT") ?? ""
  if !env_root.is_empty() {
    return [env_root]
  }
  if link_os(ctx) != "darwin" {
    return [""]
  }
  var out = [""]
  match os.proc.run("xcrun", ["--show-sdk-path"]) {
    Ok(r) => {
      if r.code == 0 {
        out.push((r.stdout.to_str() ?? "").trim())
      }
    }
    // xo:allow XO0903 an SDK probe: the next candidate, or the link's own error
    Err(_) => {}
  }
  out.push("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk")
  let clt = "/Library/Developer/CommandLineTools/SDKs"
  var ms: List[Str] = []
  match os.fs.read_dir(clt) {
    Ok(fis) => {
      for fi in fis {
        if fi.name.starts_with("MacOSX") && fi.name.ends_with(".sdk") {
          ms.push("${clt}/${fi.name}")
        }
      }
    }
    // xo:allow XO0903 an SDK probe: the next candidate, or the link's own error
    Err(_) => {}
  }
  out + ms.sort().reverse()
}

/// sysrootMemo: the file remembering the SDK that linked last time, ""
/// with $XO_SYSROOT.
fn sysroot_memo(os: Os, ctx: Ctx) -> Str {
  if !(os.env.get("XO_SYSROOT") ?? "").is_empty() || ctx.cache.is_empty() || link_os(ctx) != ctx.goos {
    return ""
  }
  "${ctx.cache}/xo/llvm-sysroot"
}

/// CC: $XO_CC, then cc, then clang, as a path; "" when there is none.
fn find_cc(os: Os) -> Str {
  let c = os.env.get("XO_CC") ?? ""
  if !c.is_empty() {
    return look_path(os, c)
  }
  for n in ["cc", "clang"] {
    let p = look_path(os, n)
    if !p.is_empty() {
      return p
    }
  }
  ""
}

fn min(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

/// strings.Fields.
fn words(s: Str) -> List[Str] {
  var out: List[Str] = []
  for w in s.replace("\t", " ").replace("\n", " ").split(" ") {
    if !w.is_empty() {
      out.push(w)
    }
  }
  out
}

/// Assembles and links the amd64 backend's windows/amd64 assembly srcs
/// into bin (decision 0254 6b, the plan's first step): clang
/// ($XO_CLANG, else clang) assembles with LLVM's assembler and links
/// with lld-link, the Windows sysroot of a cross build from
/// $XO_WINSYSROOT, the libraries of sys_link_args. "" when it worked,
/// else why not.
fn win_amd64_link(os: Os, srcs: List[Str], bin: Str, flags: List[Str]) -> Str {
  let clang = os.env.get("XO_CLANG") ?? "clang"
  let sysroot = os.env.get("XO_WINSYSROOT") ?? ""
  var args = ["--target=x86_64-pc-windows-msvc"]
  if !sysroot.is_empty() {
    args = args + ["-Xmicrosoft-windows-sys-root", sysroot]
  }
  args = args + flags + srcs + ["-o", bin] + sys_link_args("windows", [])
  let (out, err) = combined(os, clang, args)
  if !err.is_empty() {
    return "${clang}: ${err}\n${out}"
  }
  ""
}

/// The entitlements of a darwin program's ad hoc signature (decision
/// 0253 point 5): get-task-allow on a development build with debug
/// information (debug, so xo debug can control it; never a release build
/// or -s), then each --entitlement.
fn macho_ents(o: Opts, release: Bool, debug: Bool) -> List[Str] {
  var out: List[Str] = []
  if debug && !release && !o.strip {
    out.push("com.apple.security.get-task-allow")
  }
  for e in o.entitlements {
    if !out.contains(e) {
      out.push(e)
    }
  }
  out
}
