// The split LLVM build (decision 0168; internal/llvm modules.go Split,
// internal/build llvmsplit.go): XO_LLVM_SPLIT divides the IR into that
// many modules, compiled by at most XO_LLVM_JOBS clang processes at once
// and linked with XO_LLVM_LTO (thin, the default, or none). The modules
// are the bytes the Go driver writes for the same IR and count, so both
// drivers share the binary cache entry.

use std/crypto
use std/debug

/// SplitConfig: the module count (1: one module with full LTO), the job
/// bound, and the LTO mode of split builds.
struct SplitConfig {
  modules: Int = 1
  /// XO_LLVM_SPLIT named the count (the size based default stays off)
  modules_set: Bool = false
  jobs: Int = 6
  lto: Str = "thin"
  /// clang's optimization level of the program's IR ($XO_LLVM_OPT: O0,
  /// O1, O2, O3; a release build always O2, decision 0220)
  opt: Str = "-O2"
  /// The LTO of a single module build ($XO_LLVM_LTO: full, thin, none;
  /// "" picks by opt, single_lto)
  single: Str = ""
  /// $XO_LLVM_OPT named the level (a test build is -O0 otherwise)
  opt_set: Bool = false
  /// why the environment is wrong ("" when it is not)
  err: Str = ""
  /// functions placed by their names' hash, not by size (test builds:
  /// an edit leaves the other modules' text as it was)
  stable: Bool = false
  /// the back-end cache's directory: each module's object kept by its IR
  /// ("llobj"), so an edit compiles only the modules it changed; "" off
  objcache: Str = ""
  /// the modules taken from objcache (split_build)
  reused: Int = 0
  /// a stable split with a module per source file (at most modules of
  /// them; XO_LLVM_TEST_SPLIT=files), not files hashed into modules
  by_file: Bool = false
}

/// The clang jobs a split build runs at once by default: the cores, and
/// no more than three quarters of physical memory, less what xo's own heap
/// holds now (the IR is made by then), fits at 3.5 GB a job (a clang of a
/// 90 MB module, bench/results/fast-builds-2026-10-13.md), at least 1.
/// An LLVM build of xo on the 24 GB Mac (xo's heap 7.8 GB) ran six clangs
/// beside it and its process group reached 22 GB (2026-10-22); it now runs
/// two, and a small program still gets one per core up to the memory's
/// share. XO_LLVM_JOBS overrides.
fn default_jobs(os: Os) -> Int {
  var total = debug.mem_total()
  if total <= 0 {
    total = mem_gb(os) * 1000000000
  }
  let room = total / 4 * 3 - debug.mem_mapped()
  let per = 3500000000
  ncores(os).min(room / per).max(1)
}

/// The IR size above which a build with no XO_LLVM_SPLIT is split, and the
/// size of each module then: one clang of the whole IR of xo grew past
/// 15 GB (2026-10-22, the process group at 22 GB on a 24 GB Mac), while a
/// clang of a 90 MB module takes about 3.5 GB.
const SPLIT_AT = 100000000
const SPLIT_PART = 50000000

/// The modules a build of IR of n bytes is split into by default: 1 up
/// to SPLIT_AT, else one per SPLIT_PART bytes (thin LTO across them).
fn default_modules(n: Int) -> Int {
  if n <= SPLIT_AT {
    return 1
  }
  (n + SPLIT_PART - 1) / SPLIT_PART
}

/// LLVMSplitConfig from the environment.
fn split_config(os: Os) -> SplitConfig {
  var c = SplitConfig{jobs: default_jobs(os)}
  // a value none of these accepts is an error, not the default (an
  // XO_LLVM_LTO=off build linked with thin LTO for 90 minutes,
  // 2026-10-21)
  let ns = os.env.get("XO_LLVM_SPLIT") ?? ""
  c.modules_set = !ns.is_empty()
  let n = Int.parse(ns) ?? 0
  if n > 1 {
    c.modules = n
  } else if !ns.is_empty() && Int.parse(ns).is_none() {
    c.err = "XO_LLVM_SPLIT=${ns}: the number of modules is a whole number"
  }
  let js = os.env.get("XO_LLVM_JOBS") ?? ""
  let j = Int.parse(js) ?? 0
  if j > 0 {
    c.jobs = j
  } else if !js.is_empty() && Int.parse(js).is_none() {
    c.err = "XO_LLVM_JOBS=${js}: the number of clang jobs is a whole number"
  }
  let l0 = os.env.get("XO_LLVM_LTO") ?? ""
  // off is none's other name
  let l = if l0 == "off" { "none" } else { l0 }
  if l == "none" || l == "thin" {
    c.lto = l
  }
  if l is "none" | "thin" | "full" {
    c.single = l
  } else if !l.is_empty() {
    c.err = "XO_LLVM_LTO=${l0}: link time optimization is none (or off), thin, or full"
  }
  let o = os.env.get("XO_LLVM_OPT") ?? ""
  if o is "O0" | "O1" | "O2" | "O3" {
    c.opt = "-${o}"
    c.opt_set = true
  } else if !o.is_empty() {
    // was ignored: an Os build ran at O2 (gotchas/llvm-opt-level-os-ignored.md)
    c.err = "XO_LLVM_OPT=${o}: the level is O0, O1, O2, or O3"
  }
  c
}

/// runtime.NumCPU: on Linux /sys/devices/system/cpu/online, else sysctl
/// or nproc (1 when none answers).
fn ncpu(os: Os) -> Int {
  // the WASI build starts no process (decision 0405): one worker
  if target.os == TargetOs.Wasi {
    return 1
  }
  if target.os == TargetOs.Linux {
    let on = online_cpus(os)
    if !on.is_empty() {
      return on.len()
    }
  }
  let (out, err) = combined(os, "sysctl", ["-n", "hw.ncpu"])
  if err.is_empty() {
    if let Some(n) = Int.parse(out.trim()) {
      return n
    }
  }
  let (out2, err2) = combined(os, "nproc", [])
  if err2.is_empty() {
    if let Some(n) = Int.parse(out2.trim()) {
      return n
    }
  }
  1
}

/// The physical cores (decision 0220: parallel jobs by cores, not
/// hardware threads): on Linux the distinct (core, package) pairs of the
/// online CPUs' sysfs topology, else sysctl hw.physicalcpu, else the
/// distinct (core, socket) pairs of lscpu, else ncpu. emit_jobs asks on
/// every call: on Linux it spawned sysctl (which fails there) and lscpu
/// each time, several times a build (2026-10-30).
fn ncores(os: Os) -> Int {
  // the WASI build starts no process (decision 0405): one worker
  if target.os == TargetOs.Wasi {
    return 1
  }
  // probed once a process (host_counts)
  if let Some(n) = Int.parse(os.env.get("XO_HOST_CORES") ?? "") {
    if n > 0 {
      return n
    }
  }
  if target.os == TargetOs.Linux {
    let n = sysfs_cores(os)
    if n > 0 {
      return n
    }
  }
  if target.os == TargetOs.Windows {
    // the logical processors Windows sets for every process (sysctl,
    // lscpu and nproc are not there: ncores was 1, one emit job)
    if let Some(n) = Int.parse(os.env.get("NUMBER_OF_PROCESSORS") ?? "") {
      if n > 0 {
        return n
      }
    }
  }
  let (out, err) = combined(os, "sysctl", ["-n", "hw.physicalcpu"])
  if err.is_empty() {
    if let Some(n) = Int.parse(out.trim()) {
      if n > 0 {
        return n
      }
    }
  }
  let (out2, err2) = combined(os, "lscpu", ["-p=Core,Socket"])
  if err2.is_empty() {
    var seen: Set[Str] = #{}
    for l in out2.split("\n") {
      let t = l.trim()
      if !t.is_empty() && !t.starts_with("#") {
        seen.add(t)
      }
    }
    if seen.len() > 0 {
      return seen.len()
    }
  }
  ncpu(os)
}

/// The machine's memory in GB: the runtime's count (debug.mem_total, no
/// process), else hw.memsize or /proc/meminfo's MemTotal, 16 when none
/// answers.
fn mem_gb(os: Os) -> Int {
  // the WASI build starts no process (decision 0405): one worker
  if target.os == TargetOs.Wasi {
    return 16
  }
  let mt = debug.mem_total()
  if mt > 0 {
    return mt / 1000000000
  }
  if target.os == TargetOs.Darwin {
    let (out, err) = combined(os, "sysctl", ["-n", "hw.memsize"])
    if err.is_empty() {
      if let Some(n) = Int.parse(out.trim()) {
        return n / 1000000000
      }
    }
  }
  match os.fs.read_text("/proc/meminfo") {
    Ok(t) => {
      for l in t.split("\n") {
        if l.starts_with("MemTotal:") {
          let f = l.trim_prefix("MemTotal:").trim().trim_suffix("kB").trim()
          if let Some(kb) = Int.parse(f) {
            return kb / 1000000
          }
        }
      }
    }
    // xo:allow XO0903 a memory size probe: the default size when it fails
    Err(_) => {}
  }
  16
}

/// The LTO mode of a single module build: $XO_LLVM_LTO, else none at -O0
/// (the link's whole program optimization and code generation ran on one
/// core for most of an unoptimized build of compiler/xo) and full
/// otherwise.
fn single_lto(c: SplitConfig) -> Str {
  if !c.single.is_empty() {
    return c.single
  }
  if c.opt == "-O0" { "none" } else { "full" }
}

/// clang's flags of a single module build's LTO mode.
fn single_lto_flags(mode: Str) -> List[Str] {
  match mode {
    "full" => ["-flto"]
    "thin" => ["-flto=thin"]
    _ => []
  }
}

/// The limits of the loops the IR marks for full unrolling (decision
/// 0338: the loops with Float arithmetic, llvm func.xo loop_md): an
/// unrolled size of 300, -O3's unroll threshold, instead of LLVM's 16,384
/// for a marked loop, and at most 32 iterations instead of 1,000,000 (a
/// marked loop of 20,000 iterations around inlined loops kept clang's
/// compile of a small program busy for over 13 minutes); every other loop
/// keeps the level's own threshold (decision 0333's module wide 300 cost
/// xo's own build 12.8% more CPU). For compiling and
/// for an LTO link (lto, the build's mode), which unrolls again: neither
/// Apple's clang nor Debian's passes `-mllvm` to the linker's LTO, so
/// darwin's ld64 gets `-mllvm` and a Linux linker the plugin's option
/// (which GNU ld refuses without LTO). nbody at -O3's speed (2,318 to
/// 1,160 M instructions). Among the link flags, so the binary cache keys
/// on it and split_build compiles with it.
fn unroll_flags(opt: Str, goos: Str, lto: Str) -> List[Str] {
  if opt == "-O0" {
    return []
  }
  var out: List[Str] = []
  for u in ["-pragma-unroll-threshold=300", "-pragma-unroll-full-max-iterations=32"] {
    out = out + ["-mllvm", u]
    if lto != "none" {
      out.push(if goos == "darwin" { "-Wl,-mllvm,${u}" } else { "-Wl,-plugin-opt=${u}" })
    }
  }
  out
}

/// ltoFlags of a split build.
fn lto_flags(lto: Str) -> List[Str] {
  if lto == "thin" { ["-flto=thin"] } else { [] }
}

/// A top level item of the IR: a function or a constant.
struct IRItem {
  name: Str
  text: Str
  refs: List[Str] = []
  helper: Bool = false
  decl: Str = ""
}

/// The IR cut into its header, constants, and functions (parseIR).
struct ParsedIR {
  header: Str = ""
  /// The `module asm` lines (the XO_NOLIBC process entry): one module
  /// defines them, or _start is defined twice.
  masm: Str = ""
  globals: List[IRItem] = []
  global_at: Map[Str, Int] = {}
  defs: List[IRItem] = []
  def_at: Map[Str, Int] = {}
  /// The numbered metadata lines (`!N = ...`), in order, by their `!N`:
  /// a module of a stable split takes those its own text reaches
  /// (meta_closure), so a line moved in one function's debug info
  /// changes only its module
  meta: List[(Str, Str)] = []
  meta_at: Map[Str, Int] = {}
}

/// parseIR: top level entities start a line, function bodies end at a
/// line "}", constants are one line; every other line is the header.
fn parse_ir(ir: Str) -> ParsedIR {
  var p = ParsedIR{}
  var header = StrBuilder.new()
  let lines = ir.split("\n")
  // each line with its newline (the last one has none when ir does not
  // end in one)
  var i = 0
  let n = lines.len()
  while i < n {
    var line = lines[i]
    if i < n - 1 {
      line = line + "\n"
    }
    if line.is_empty() {
      i += 1
      continue
    }
    if line.starts_with("define ") {
      var text = StrBuilder.new()
      text.write(line)
      i += 1
      while i < n {
        var l = lines[i]
        if i < n - 1 {
          l = l + "\n"
        }
        text.write(l)
        i += 1
        if l == "}\n" || l == "}" {
          break
        }
      }
      // a blank line after a body goes with it
      while i < n - 1 && lines[i].is_empty() {
        text.write("\n")
        i += 1
      }
      let body = text.freeze()
      let name = def_symbol(line)
      var d = IRItem{name: name, text: body, helper: name.starts_with("@\"xo.")}
      let lb = line.bytes()
      let bb = body.bytes()
      // the define line from its parameter list on (after the symbol: the
      // result type before it can hold a `(` inside a quoted name, as
      // `%"e.Result[(), Error]"`, which made the scan read the line's
      // quotes the wrong way round and miss the `personality` symbol)
      let from = index_byte(lb, '@') + name.len()
      d.refs = symbol_refs(bb[lb.len()..bb.len()], name) + symbol_refs(lb[from..lb.len()], name)
      d.decl = decl_of(line)
      p.def_at[name] = p.defs.len()
      p.defs.push(d)
      continue
    }
    if line.starts_with("@") {
      let name = symbol_at(line.bytes(), 0)
      let lb = line.bytes()
      let g = IRItem{name: name, text: line, refs: symbol_refs(lb[name.len()..lb.len()], name)}
      p.global_at[name] = p.globals.len()
      p.globals.push(g)
      i += 1
      continue
    }
    if line.starts_with("module asm ") {
      p.masm = p.masm + line
    } else if line.len() > 1 && line.bytes()[1] >= '0' && line.bytes()[1] <= '9' && line.starts_with("!") {
      let id = line.split(" ")[0]
      p.meta_at[id] = p.meta.len()
      p.meta.push((id, line))
    } else {
      header.write(line)
    }
    i += 1
  }
  p.header = header.freeze()
  p
}

fn index_byte(b: Bytes, c: UInt8) -> Int {
  for i in 0..b.len() {
    if b[i] == c {
      return i
    }
  }
  -1
}

/// defSymbol: the symbol a define line defines.
fn def_symbol(line: Str) -> Str {
  let b = line.bytes()
  symbol_at(b, index_byte(b, '@'))
}

/// symbolAt: the symbol starting at the @ at b[i]: @"quoted" or @plain.
fn symbol_at(b: Bytes, i: Int) -> Str {
  var j = i + 1
  if j < b.len() && b[j] == '"' {
    var k = j + 1
    while k < b.len() && b[k] != '"' {
      k += 1
    }
    return b[i..k + 1].to_str() ?? ""
  }
  while j < b.len() && is_sym_char(b[j]) {
    j += 1
  }
  b[i..j].to_str() ?? ""
}

fn is_sym_char(c: UInt8) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$' ||
    c == '-'
}

/// symbolRefs: the symbols b mentions other than self, skipping string
/// literals, quoted local and type names, and comments.
fn symbol_refs(b: Bytes, self: Str) -> List[Str] {
  var seen: Map[Str, Bool] = {}
  seen[self] = true
  var out: List[Str] = []
  var i = 0
  while i < b.len() {
    let c = b[i]
    if c == '"' {
      var k = i + 1
      while k < b.len() && b[k] != '"' {
        k += 1
      }
      if k >= b.len() {
        return out
      }
      i = k
    } else if c == ';' {
      var k = i
      while k < b.len() && b[k] != '\n' {
        k += 1
      }
      if k >= b.len() {
        return out
      }
      i = k
    } else if c == '@' {
      let s = symbol_at(b, i)
      i += s.len() - 1
      if s.len() > 1 && !seen.contains(s) {
        seen[s] = true
        out.push(s)
      }
    }
    i += 1
  }
  out
}

/// declOf: the declaration other modules use for a define line: hidden
/// linkage, the parameter list, and the attribute groups.
fn decl_of(line: Str) -> Str {
  var rest = line.trim_prefix("define ")
  rest = rest.trim_prefix("internal ")
  rest = rest.trim_prefix("hidden ")
  let b = rest.bytes()
  let at = index_byte(b, '@')
  let name = symbol_at(b, at)
  var i = at + name.len()
  var depth = 0
  while i < b.len() {
    let c = b[i]
    if c == '"' {
      var k = i + 1
      while k < b.len() && b[k] != '"' {
        k += 1
      }
      i = k + 1
      continue
    }
    if c == '(' {
      depth += 1
    } else if c == ')' {
      depth -= 1
      if depth == 0 {
        break
      }
    }
    i += 1
  }
  var out = StrBuilder.new()
  out.write("declare hidden ")
  out.write(b[0..i + 1].to_str() ?? "")
  let tail = b[i + 1..b.len()].to_str() ?? ""
  for f in tail.replace("\t", " ").replace("\n", " ").split(" ") {
    if f.starts_with("#") {
      out.write(" ${f}")
    }
  }
  out.write("\n")
  out.freeze()
}

/// llvm.Split: the IR divided into n modules, the functions placed
/// largest first onto the lightest module, each module with the
/// constants and helpers it uses and declarations of the functions of
/// other modules it calls (internal to hidden linkage for those). n <= 1,
/// or fewer than two functions, gives the IR back as one module.
fn split_ir(ir: Str, n0: Int, stable: Bool, by_file: Bool) -> List[Str] {
  if n0 <= 1 {
    return [ir]
  }
  let p = parse_ir(ir)
  var fns: List[Int] = []
  for (i, d) in p.defs.indexed() {
    if !d.helper {
      fns.push(i)
    }
  }
  if fns.len() < 2 {
    return [ir]
  }
  var n = min(n0, fns.len())
  // by_file: the files in order, each its own module (wrapping past n)
  var file_at: Map[Str, Int] = {}
  if stable && by_file {
    var keys: Map[Str, Bool] = {}
    for i in fns {
      keys[def_file_key(p, p.defs[i])] = true
    }
    for (k, key) in keys.keys().sort().indexed() {
      file_at[key] = k
    }
    n = min(n0, file_at.len()).max(1)
  }
  // largest first (stable: ties keep the order of the IR)
  var keyed: List[(Int, Int)] = []
  for (k, i) in fns.indexed() {
    keyed.push((k, i))
  }
  let order = keyed.sort_by(fn(e) { (0 - p.defs[e.1].text.len()) * 10000000 + e.0 })
  var home: List[Int] = []
  for _ in p.defs {
    home.push(-1)
  }
  var load: List[Int] = []
  for _ in 0..n {
    load.push(0)
  }
  for (_, i) in order {
    var m = 0
    if stable {
      // by source file (the file of its debug info's subprogram), else
      // by name: the same module whatever the other functions' sizes,
      // and a line added to a file moves the debug lines of that file's
      // functions only
      let key = def_file_key(p, p.defs[i])
      if by_file {
        m = (file_at.get(key) ?? 0) % n
      } else {
        var hv = 2166136261
        for ch in key.bytes() {
          hv = ((hv ^ Int(ch)) * 16777619) % 4294967296
        }
        m = hv % n
      }
    } else {
      for k in 1..n {
        if load[k] < load[m] {
          m = k
        }
      }
    }
    home[i] = m
    load[m] += p.defs[i].text.len()
  }
  var members: List[List[Int]] = []
  for _ in 0..n {
    members.push([])
  }
  for i in 0..p.defs.len() {
    if home[i] >= 0 {
      members[home[i]].push(i)
    }
  }
  var used: List[Map[Str, Bool]] = []
  var exported: Map[Int, Bool] = {}
  for m in 0..n {
    var u: Map[Str, Bool] = {}
    var work: List[Str] = []
    for i in members[m] {
      for r in p.defs[i].refs {
        if !u.contains(r) {
          u[r] = true
          work.push(r)
        }
      }
    }
    while !work.is_empty() {
      let r = work.pop() ?? ""
      var refs: List[Str] = []
      if let Some(g) = p.global_at.get(r) {
        refs = p.globals[g].refs
      } else if let Some(i) = p.def_at.get(r) {
        if p.defs[i].helper {
          refs = p.defs[i].refs
        }
      }
      for x in refs {
        if !u.contains(x) {
          u[x] = true
          work.push(x)
        }
      }
    }
    for r in u.keys() {
      if let Some(i) = p.def_at.get(r) {
        if !p.defs[i].helper && home[i] != m {
          exported[i] = true
        }
      }
    }
    used.push(u)
  }
  var out: List[Str] = []
  for m in 0..n {
    var b = StrBuilder.new()
    b.write(p.header)
    if m == 0 {
      b.write(p.masm)
    }
    b.write("\n")
    // the metadata this module's text reaches (all of it for a split by
    // size: those modules are compiled together each time)
    var roots: List[Str] = [p.header]
    for g in p.globals {
      if used[m].contains(g.name) {
        roots.push(g.text)
      }
    }
    for (i, d) in p.defs.indexed() {
      if home[i] == m || (d.helper && used[m].contains(d.name)) {
        roots.push(d.text)
      }
    }
    let keep: Map[Int, Bool] = if stable { meta_closure(p, roots) } else { {} }
    // a stable module's metadata is numbered by itself (`!0` up, in the
    // IR's order): the IR numbers it for the whole program, so a variable
    // added to one function would renumber every module (meta_renumber)
    var renum: Map[Str, Str] = {}
    for (k, (id, line)) in p.meta.indexed() {
      if !stable || keep.contains(k) {
        b.write(line)
        if stable {
          renum[id] = "!${renum.len()}"
        }
      }
    }
    b.write("\n")
    for g in p.globals {
      if used[m].contains(g.name) {
        b.write(g.text)
      }
    }
    b.write("\n")
    for (i, d) in p.defs.indexed() {
      if !used[m].contains(d.name) || home[i] == m {
        continue
      }
      if d.helper {
        b.write(d.text)
      } else {
        b.write(d.decl)
      }
    }
    b.write("\n")
    for i in members[m] {
      let d = p.defs[i]
      if exported.contains(i) && d.text.starts_with("define internal ") {
        b.write("define hidden ")
        b.write(d.text.trim_prefix("define internal "))
      } else {
        b.write(d.text)
      }
    }
    out.push(if stable { meta_renumber(b.freeze(), renum) } else { b.freeze() })
  }
  out
}

/// The key a stable split places d by: the DIFile line of the
/// subprogram on its define line (`!dbg !N`, then `file: !M`), else its
/// name.
fn def_file_key(p: ParsedIR, d: IRItem) -> Str {
  let first = d.text.split("\n")[0]
  if let Some(at) = first.find("!dbg !") {
    let refs = meta_refs(first[at + 5..first.len()])
    if !refs.is_empty() {
      if let Some(k) = p.meta_at.get(refs[0]) {
        let sp = p.meta[k].1
        if let Some(fa) = sp.find("file: !") {
          let frefs = meta_refs(sp[fa + 6..sp.len()])
          if !frefs.is_empty() {
            if let Some(fk) = p.meta_at.get(frefs[0]) {
              // without its `!M = `: the number may change, the file not
              let fl = p.meta[fk].1
              return fl[(fl.find(" = ") ?? 0)..fl.len()]
            }
          }
        }
      }
    }
  }
  d.name
}

/// The indexes in p.meta of the metadata texts reach: each `!N` they
/// name, and each one those lines name in turn.
fn meta_closure(p: ParsedIR, texts: List[Str]) -> Map[Int, Bool] {
  var seen: Map[Int, Bool] = {}
  var work: List[Int] = []
  for t in texts {
    for id in meta_refs(t) {
      if let Some(k) = p.meta_at.get(id) {
        if !seen.contains(k) {
          seen[k] = true
          work.push(k)
        }
      }
    }
  }
  while !work.is_empty() {
    let k = work.pop() ?? 0
    let line = p.meta[k].1
    // the line's own id is its first word: skip it
    let at = line.find(" = ") ?? 0
    for id in meta_refs(line[at..line.len()]) {
      if let Some(j) = p.meta_at.get(id) {
        if !seen.contains(j) {
          seen[j] = true
          work.push(j)
        }
      }
    }
  }
  seen
}

/// t with each `!N` outside quotes that renum names replaced by its new
/// number (an IR string is quoted, its quotes escaped as \22).
fn meta_renumber(t: Str, renum: Map[Str, Str]) -> Str {
  let b = t.bytes()
  var out = StrBuilder.new()
  var at = 0
  var quoted = false
  var i = 0
  while i < b.len() {
    let c = b[i]
    if c == '"' {
      quoted = !quoted
      i += 1
    } else if !quoted && c == '!' && i + 1 < b.len() && b[i + 1] >= '0' && b[i + 1] <= '9' {
      var j = i + 1
      while j < b.len() && b[j] >= '0' && b[j] <= '9' {
        j += 1
      }
      if let Some(n) = renum.get(t[i..j]) {
        out.write(t[at..i])
        out.write(n)
        at = j
      }
      i = j
    } else {
      i += 1
    }
  }
  out.write(t[at..t.len()])
  out.freeze()
}

/// The `!N` references in t (outside quotes).
fn meta_refs(t: Str) -> List[Str] {
  var out: List[Str] = []
  let b = t.bytes()
  var i = 0
  var quoted = false
  while i < b.len() {
    if b[i] == '"' {
      quoted = !quoted
      i += 1
    } else if !quoted && b[i] == '!' && i + 1 < b.len() && b[i + 1] >= '0' && b[i + 1] <= '9' {
      var j = i + 1
      while j < b.len() && b[j] >= '0' && b[j] <= '9' {
        j += 1
      }
      out.push(t[i..j])
      i = j
    } else {
      i += 1
    }
  }
  out
}

/// splitBuild: compiles the modules lls in parallel (at most c.jobs
/// clang processes), then links their objects with the other sources
/// into bin through cc_build. The compiler's output of a failure, "" on
/// success.
fn split_build(os: Os, ctx: Ctx, clang: Str, lls: List[Str], others: List[Str], bin: Str, var c: SplitConfig, flags: List[Str]) -> Str {
  var objs: List[Str] = []
  for ll in lls {
    objs.push(ll.trim_suffix(".ll") + ".o")
  }
  // a cross build's target (the IR names none, so clang would compile
  // the modules for the host), and --race's ThreadSanitizer pass and its
  // option (`-mllvm` and the next flag), which compiling needs too
  var target: List[Str] = []
  var i = 0
  while i < flags.len() {
    let f = flags[i]
    if f.starts_with("--target=") || f.starts_with("-fsanitize=") {
      target.push(f)
    } else if f == "-mllvm" && i + 1 < flags.len() {
      target.push(f)
      target.push(flags[i + 1])
      i += 1
    }
    i += 1
  }
  // the modules whose objects the cache holds (by the IR, the clang and
  // its arguments) are not compiled
  var keys: List[Str] = []
  var todo: List[Int] = []
  for (i, ll) in lls.indexed() {
    let args = [c.opt] + lto_flags(c.lto) + target + ["-Wno-override-module", "-fexceptions", "-funwind-tables"]
    var k = ""
    if !c.objcache.is_empty() {
      match os.fs.read(ll) {
        Ok(ir) => {
          var h = BytesBuilder.new()
          h.write_str("xo llvm module object v1\n${clang}\n${args.join(" ")}\n")
          h.write(ir)
          k = crypto.sha256(h.freeze()).to_hex()
        }
        // xo:allow XO0903 compiled instead
        Err(_) => {}
      }
    }
    keys.push(k)
    if !k.is_empty() {
      if let Some(o) = entry_get(os, c.objcache, "llobj", k) {
        if os.fs.write(objs[i], o).is_ok() {
          c.reused += 1
          continue
        }
      }
    }
    todo.push(i)
  }
  var ti = 0
  var running: List[(Int, Child)] = []
  var fails: List[Str] = []
  while ti < todo.len() || !running.is_empty() {
    while ti < todo.len() && running.len() < c.jobs {
      let next = todo[ti]
      ti += 1
      // in the module's directory, by its base name: the bitcode records
      // its source file's name, which ThinLTO's names of promoted locals
      // hash, so the build's random directory made two builds of the same
      // IR differ (gotchas/windows-thinlto-module-path.md)
      let args = [c.opt] + lto_flags(c.lto) + target + ["-Wno-override-module", "-fexceptions", "-funwind-tables", "-c", base_name(lls[next]), "-o", base_name(objs[next])]
      match os.proc.cmd(clang, args).dir(dir_name(lls[next])).merge_stderr().spawn() {
        Ok(ch) => running.push((next, ch))
        Err(e) => fails.push("${lls[next]}: ${e}\n")
      }
    }
    if running.is_empty() {
      break
    }
    // the oldest first: its output, then its status
    let (k, ch) = running[0]
    running = running[1..running.len()]
    var outb = BytesBuilder.new()
    var reading = true
    while reading {
      match ch.read(65536) {
        Ok(Some(data)) => outb.write(data)
        _ => reading = false
      }
    }
    match ch.wait() {
      Ok(code) => {
        if code != 0 {
          fails.push("${lls[k]}: exit status ${code}\n${outb.freeze().to_str() ?? ""}")
        } else if !keys[k].is_empty() {
          if let Ok(o) = os.fs.read(objs[k]) {
            let _ = entry_put(os, c.objcache, "llobj", keys[k], o)
          }
        }
      }
      Err(e) => fails.push("${lls[k]}: ${e}\n")
    }
  }
  if !fails.is_empty() {
    return fails[0]
  }
  let lf = ["-O2"] + lto_flags(c.lto) + ["-Wno-override-module"]
  cc_build(os, ctx, clang, lf + flags, objs + others, bin)
}

/// The online CPUs' numbers (/sys/devices/system/cpu/online: "0-63" or
/// "0,2-5"), [] when it cannot be read.
fn online_cpus(os: Os) -> List[Int] {
  // xo:allow XO0903 a CPU count probe: the caller falls back to sysctl and nproc
  let t = os.fs.read_text("/sys/devices/system/cpu/online").ok() ?? return []
  var out: List[Int] = []
  for part in t.trim().split(",") {
    let ab = part.split("-")
    let a = Int.parse(ab[0].trim()) ?? return []
    let b = if ab.len() > 1 { Int.parse(ab[1].trim()) ?? return [] } else { a }
    for i in a..b + 1 {
      out.push(i)
    }
  }
  out
}

/// The distinct (core_id, physical_package_id) pairs of the online
/// CPUs' sysfs topology, as lscpu -p=Core,Socket counts them; 0 when a
/// file cannot be read.
fn sysfs_cores(os: Os) -> Int {
  var seen: Set[Str] = #{}
  for i in online_cpus(os) {
    let d = "/sys/devices/system/cpu/cpu${i}/topology"
    // xo:allow XO0903 a core count probe: the caller falls back to lscpu
    let core = os.fs.read_text("${d}/core_id").ok() ?? return 0
    // xo:allow XO0903 a core count probe: the caller falls back to lscpu
    let pkg = os.fs.read_text("${d}/physical_package_id").ok() ?? return 0
    seen.add("${core.trim()},${pkg.trim()}")
  }
  seen.len()
}

/// os with XO_HOST_CORES set to the host's physical cores (ncores),
/// probed once, unless it is set already: the jobs of a build are sized
/// by them many times (emit_jobs), and each probe was a process on
/// macOS and Linux.
fn host_counts(os: Os) -> Os {
  if os.env.get("XO_HOST_CORES") != None || target.os == TargetOs.Wasi {
    return os
  }
  // the command (front's: after --std= and --wd=): only those that
  // compile; a lookup (def, refs, doc) or version starts no probe
  let args = os.env.args()
  var i = 0
  while i < args.len() && (args[i].starts_with("--std=") || args[i].starts_with("--wd=")) {
    i += 1
  }
  if i >= args.len() || !(args[i] is "build" | "run" | "test" | "check" | "asm" | "keys" | "vet" | "dev" | "bench") {
    return os
  }
  with_env(os, {"XO_HOST_CORES": "${ncores(os)}"})
}
