// Tests of the tool lookups (exec.LookPath's Windows rules).

test "look_path_windows finds clang.exe in %PATH% with or without %PATHEXT%" {
  // a file with no permission bits (Windows has none): only its existence
  // and extension count
  os.fs.create_dir_all("C:/Program Files/LLVM/bin")?
  os.fs.write("C:/Program Files/LLVM/bin/clang.exe", b"")?
  os.fs.create_dir_all("C:/Windows/System32")?
  os.env.set("PATH", "C:\\Windows\\System32;\"C:\\Program Files\\LLVM\\bin\\\";")
  os.env.set("PATHEXT", ".COM;.EXE;.BAT;.CMD")
  expect(look_path_windows(os.env, os.fs, "clang")) == "C:/Program Files/LLVM/bin/clang.exe"
  os.env.set("PATHEXT", "")
  expect(look_path_windows(os.env, os.fs, "clang")) == "C:/Program Files/LLVM/bin/clang.exe"
  // a path ($XO_CLANG): as written with an extension, else with one
  expect(look_path_windows(os.env, os.fs, "C:\\Program Files\\LLVM\\bin\\clang.exe")) == "C:/Program Files/LLVM/bin/clang.exe"
  expect(look_path_windows(os.env, os.fs, "C:/Program Files/LLVM/bin/clang")) == "C:/Program Files/LLVM/bin/clang.exe"
  expect(look_path_windows(os.env, os.fs, "nothere")) == ""
}

test "look_path_windows does not take a file without an extension" {
  // exec.LookPath's rule, and CreateProcess runs only .exe files: the
  // test clang cache once named its wrapper `clang` on Windows, so
  // $XO_CLANG pointed at a file xo1 rejected and every LLVM golden failed
  // with "needs clang" while clang.exe was on PATH (2026-10-21)
  os.fs.create_dir_all("C:/Temp/xo-clangcache-1")?
  os.fs.write("C:/Temp/xo-clangcache-1/clang", b"")?
  expect(look_path_windows(os.env, os.fs, "C:/Temp/xo-clangcache-1/clang")) == ""
  os.fs.write("C:/Temp/xo-clangcache-1/clang.exe", b"")?
  expect(look_path_windows(os.env, os.fs, "C:/Temp/xo-clangcache-1/clang")) == "C:/Temp/xo-clangcache-1/clang.exe"
}

test "path_env_over gives a Windows host's path variables with / and leaves the rest" {
  let vars = {"XO_STD": "C:\\xo\\std", "XO_BACKEND_CACHE_DIR": "C:\\Users\\u\\AppData\\Local\\xo", "XO_MODCACHE": "D:/mods", "XO_SEPCOMP_STORE": "\\\\server\\share\\std.store", "XO_INLINE_DENY": "a\\b", "XO_BUILD_DIR": "rel\\dir"}
  let over = path_env_over(vars, true)
  expect(over.get("XO_STD")) == Some("C:/xo/std")
  expect(over.get("XO_BACKEND_CACHE_DIR")) == Some("C:/Users/u/AppData/Local/xo")
  expect(over.get("XO_SEPCOMP_STORE")) == Some("//server/share/std.store")
  expect(over.get("XO_BUILD_DIR")) == Some("rel/dir")
  // already slashed: unchanged, so not overridden
  expect(over.get("XO_MODCACHE")) == None
  // not a path variable
  expect(over.get("XO_INLINE_DENY")) == None
  // elsewhere \ is part of a name
  expect(path_env_over(vars, false).len()) == 0
}
