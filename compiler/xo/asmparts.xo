// The assembly files of a parallel arm64 generation (arm64
// generate_parallel, bench/results/fast-builds-2026-10-13.md) assemble
// apart: by compiler/macho on parallel tasks, or by parallel `cc -c`
// processes, before one link.

use github.com/xo-lang/xo/compiler/arm64
use github.com/xo-lang/xo/compiler/macho
use std/crypto

/// The objects of the assembly files srcs (ELF when elf, else Mach-O; a
/// windows/amd64 COFF object when coff) by compiler/macho, on up to jobs
/// tasks, in the order of srcs.
fn macho_objects(srcs: List[Str], elf: Bool, amd64: Bool, coff: Bool, jobs: Int) -> List[Result[Bytes, Str]] {
  let n = srcs.len()
  let w = jobs.min(n)
  if w <= 1 {
    var out: List[Result[Bytes, Str]] = []
    for s in srcs {
      out.push(if coff { assemble_coff(s) } else { assemble_one(s, elf, amd64) })
    }
    return out
  }
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..w {
      ts.push(sc.spawn(fn() -> List[(Int, Result[Bytes, Str])] {
        var mine: List[(Int, Result[Bytes, Str])] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          mine.push((i, if coff { assemble_coff(srcs[i]) } else { assemble_one(srcs[i], elf, amd64) }))
        }
        mine
      }))
    }
    var all: List[(Int, Result[Bytes, Str])] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[Result[Bytes, Str]] = []
  for _ in 0..n {
    out.push(Err("not assembled"))
  }
  for (i, r) in done {
    out[i] = r
  }
  out
}

/// A windows/amd64 COFF object of the amd64 backend's text src (decision
/// 0254 6b step 3).
fn assemble_coff(src: Str) -> Result[Bytes, Str] {
  macho.assemble_coff_amd64(src.bytes())
}

fn assemble_one(src: Str, elf: Bool, amd64: Bool) -> Result[Bytes, Str] {
  if amd64 && !elf {
    // x86_64 Mach-O (decision 0254 stage 6a: darwin/amd64)
    return macho.assemble_macho_amd64(src.bytes(), (11, 0))
  }
  if amd64 {
    // x86_64 ELF (decision 0254: the amd64 backend's text)
    return macho.assemble_elf_amd64(src.bytes())
  }
  if elf { macho.assemble_elf(src.bytes()) } else { macho.assemble(src.bytes()) }
}

/// The -isysroot of the SDK the last link used (cc_build's memo), so the
/// parts' objects are built for the SDK the link targets; none when there
/// is no memo.
fn memo_sysroot(os: Os, ctx: Ctx) -> List[Str] {
  let memo = sysroot_memo(os, ctx)
  if memo.is_empty() {
    return []
  }
  // xo:allow XO0903 a memo: a failed read finds the sysroot again
  let root = (os.fs.read_text(memo).ok() ?? "").trim()
  if root.is_empty() {
    return []
  }
  ["-isysroot", root]
}

/// Assembles the files srcs with `cc -c` (the flags a compile takes from
/// the link's), at most jobs processes at once: the objects beside them,
/// and the output of the first failure ("" when none failed). Each runs in
/// its source's directory on the base names: an ELF object names its
/// source, and the build's directory is random (main.xo `w-`), so the
/// back-end cache (cached_cc_assemble) keyed on the full path never hit.
fn cc_assemble(os: Os, cc: Str, flags: List[Str], srcs: List[Str], jobs: Int) -> (List[Str], Str) {
  let cflags = asm_cflags(flags)
  var objs: List[Str] = []
  for s in srcs {
    objs.push(s.trim_suffix(".s") + ".o")
  }
  var next = 0
  var running: List[(Int, Child)] = []
  var fails: List[Str] = []
  while next < srcs.len() || !running.is_empty() {
    while next < srcs.len() && running.len() < jobs.max(1) {
      match os.proc.cmd(cc, cflags + ["-c", base_name(srcs[next]), "-o", base_name(objs[next])]).dir(dir_name(srcs[next])).merge_stderr().spawn() {
        Ok(ch) => running.push((next, ch))
        Err(e) => fails.push("${srcs[next]}: ${e}\n")
      }
      next += 1
    }
    if running.is_empty() {
      break
    }
    // the oldest first: its output, then its status
    let (k, ch) = running[0]
    running = running[1..running.len()]
    var outb = BytesBuilder.new()
    var reading = true
    while reading {
      match ch.read(65536) {
        Ok(Some(data)) => outb.write(data)
        _ => reading = false
      }
    }
    match ch.wait() {
      Ok(code) => {
        if code != 0 {
          fails.push("${srcs[k]}: exit status ${code}\n${outb.freeze().to_str() ?? ""}")
        }
      }
      Err(e) => fails.push("${srcs[k]}: ${e}\n")
    }
  }
  if !fails.is_empty() {
    return (objs, fails[0])
  }
  (objs, "")
}

/// The back-end cache keys of srcs (bcache.xo): the SHA-256 of prefix,
/// tags[i] (when given), and each source, on up to jobs tasks, in the
/// order of srcs.
fn part_keys(prefix: Str, tags: List[Str], srcs: List[Str], jobs: Int) -> List[Str] {
  let n = srcs.len()
  let w = jobs.min(n).max(1)
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..w {
      ts.push(sc.spawn(fn() -> List[(Int, Str)] {
        var mine: List[(Int, Str)] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          var b = BytesBuilder.new()
          b.write_str(prefix)
          b.write_str("\x00")
          if i < tags.len() {
            b.write_str(tags[i])
          }
          b.write_str("\x00")
          b.write_str(srcs[i])
          mine.push((i, crypto.sha256(b.freeze()).to_hex()))
        }
        mine
      }))
    }
    var all: List[(Int, Str)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[Str] = []
  for _ in 0..n {
    out.push("")
  }
  for (i, k) in done {
    out[i] = k
  }
  out
}

/// macho_objects through the back-end cache (decision 0220 addendum): a
/// part whose assembly the cache holds is not assembled again. A program
/// of one file does not use the cache.
/// Also the objects' keys ([] without the cache), which a tail entry
/// records (tail_put).
/// The back-end cache's keys of the objects of srcs (cached_macho_objects'),
/// computed with the cache on or off; [] for one part or no xo identity.
/// windows/amd64's COFF objects since 2026-10-27 (their own keys; the
/// Mach-O and ELF keys as before).
fn macho_object_keys(os: Os, srcs: List[Str], elf: Bool, coff: Bool, jobs: Int) -> List[Str] {
  let id = cache_id(os)
  if srcs.len() < 2 || id.is_empty() {
    return []
  }
  part_keys("xo backend v1 obj macho elf=${elf}${if coff { " coff=true" } else { "" }} ${id}", [], srcs, jobs)
}

fn cached_macho_objects(os: Os, ctx: Ctx, srcs: List[Str], elf: Bool, amd64: Bool, coff: Bool, jobs: Int) -> (List[Result[Bytes, Str]], Int, List[Str]) {
  // $XO_SIZE_CAUSES=FILE (decision 0443, xo dev size --by-cause): every
  // arm64 or amd64 part (not windows' COFF) assembled again, past the cache, with its code's bytes per
  // function and cause written to FILE
  let causes = os.env.get("XO_SIZE_CAUSES") ?? ""
  if !causes.is_empty() && !coff {
    return (causes_objects(os, srcs, elf, amd64, jobs, causes), srcs.len(), [])
  }
  let dir = backend_cache_dir(os, ctx)
  if dir.is_empty() || srcs.len() < 2 {
    return (macho_objects(srcs, elf, amd64, coff, jobs), srcs.len(), [])
  }
  let id = cache_id(os)
  if id.is_empty() {
    return (macho_objects(srcs, elf, amd64, coff, jobs), srcs.len(), [])
  }
  let keys = macho_object_keys(os, srcs, elf, coff, jobs)
  var out: List[Result[Bytes, Str]] = []
  var miss: List[Int] = []
  var msrcs: List[Str] = []
  for (i, k) in keys.indexed() {
    match entry_get(os, dir, "obj", k) {
      Some(b) => out.push(Ok(b))
      None => {
        out.push(Err("not assembled"))
        miss.push(i)
        msrcs.push(srcs[i])
      }
    }
  }
  if miss.is_empty() {
    return (out, 0, keys)
  }
  var n = 0
  for (j, r) in macho_objects(msrcs, elf, amd64, coff, jobs).indexed() {
    let i = miss[j]
    out[i] = r
    match r {
      Ok(b) => {
        n += entry_put(os, dir, "obj", keys[i], b)
      }
      Err(_) => {}
    }
  }
  prune_backend_cache(os, "obj", dir, n)
  (out, miss.len(), keys)
}

// ---------------------------------------------------------------------------
// Hollowing a split darwin build part by part (2026-10-26): a part's
// facts (arm64 hollow.xo HFacts: its functions, what each names, its
// roots) are kept by the hash of its text, the reach runs over every
// part's facts, and a part's object (and its undefined-symbol facts) by
// the hash of its text and the names of its functions the reach left
// dead, which with the text fix the hollowed text. So an edit scans,
// hollows, hashes and assembles only the parts it changed (or whose dead
// set it changed), not every part: llvm-fib's edit spent 28 ms in hollow,
// 21 in the undefined-symbol scan and 7 to 25 assembling.

const HOLLOW_INCR_VERSION = "xo backend v1 hollow incr"

/// incr_hollow's result: each part's object (Ok, or the assembler's
/// error), the undefined symbols (arm64 undef_combine), how many parts
/// were assembled, and each part's facts and live chunks (to hollow its
/// text when a tool reads it: incr_texts).
struct IncrOut {
  objs: List[Result[Bytes, Str]] = []
  undef: List[(Str, Str)] = []
  nasm: Int = 0
  facts: List[arm64.HFacts] = []
  live: List[List[Bool]] = []
  /// each object's key in the cache (hobj), which fixes its bytes
  okeys: List[Str] = []
  /// the build's elf and hollow, for incr_texts when facts and live were
  /// not read (a whole hit, incr_whole)
  elf: Bool = false
  hollow: Bool = false
}

/// The objects of parts (Mach-O, arm64 or amd64) with the functions
/// nothing reaches emptied when hollow, through the back-end cache, and
/// the undefined symbols; None without the cache (the build then hollows
/// and assembles the whole text).
fn incr_hollow(os: Os, ctx: Ctx, parts: List[Str], tags: List[Str], march: Str, hollow: Bool, elf: Bool, jobs: Int) -> IncrOut? {
  let dir = backend_cache_dir(os, ctx)
  let id = cache_id(os)
  if dir.is_empty() || id.is_empty() || parts.len() < 2 {
    return None
  }
  let amd64 = march == "amd64"
  // a part the part cache fixes (arm64 part_tags) by its tag, every
  // other by its text
  var ktags: List[Str] = []
  var ksrcs: List[Str] = []
  for (i, t) in parts.indexed() {
    let g = if i < tags.len() { tags[i] } else { "" }
    ktags.push(g)
    ksrcs.push(if g.is_empty() { t } else { "" })
  }
  let tk = part_keys("${HOLLOW_INCR_VERSION} facts ${id} elf=${elf}", ktags, ksrcs, jobs)
  // ELF: an ELF part's scan reads the labels without the xo_ prefix that
  // every part defines (hollow_extra), so each part's are kept by its text
  // and a facts entry is keyed by its text and the hash of them all
  var labels: List[Str] = []
  var fstored = 0
  if elf {
    for (i, k) in tk.indexed() {
      match entry_get(os, dir, "hextra", k) {
        Some(b) => {
          for l in (b.to_str() ?? "").split("\n") {
            if !l.is_empty() {
              labels.push(l)
            }
          }
        }
        None => {
          let ls = arm64.hollow_extra_of(parts[i])
          fstored += entry_put(os, dir, "hextra", k, ls.join("\n").bytes())
          labels = labels + ls
        }
      }
    }
  }
  let (extra, first) = arm64.hollow_extra_from(labels)
  let eh = if elf { crypto.sha256(labels.join("\n").bytes()).to_hex() } else { "" }
  var fk: List[Str] = []
  for k in tk {
    fk.push(if elf { crypto.sha256("${k}\x00${eh}".bytes()).to_hex() } else { k })
  }
  // the parts' facts keys fix every part's facts, so the reach and each
  // part's dead set, so its object key: a build whose whole key hits
  // reads the object keys and the objects without a part's facts or the
  // reach (hollow_live and the facts' decode were most of a warm build's
  // hollow, 2026-11-07 profile)
  let wk = crypto.sha256("${HOLLOW_INCR_VERSION} whole ${id} amd64=${amd64} elf=${elf} hollow=${hollow}\x00${fk.join("\n")}".bytes()).to_hex()
  if let Some(w) = incr_whole(os, dir, wk, fk.len()) {
    var o = w
    o.elf = elf
    o.hollow = hollow
    return Some(o)
  }
  // each part's facts, from the cache or scanned (on tasks)
  var facts: List[arm64.HFacts] = []
  var miss: List[Int] = []
  for (i, k) in fk.indexed() {
    var f = arm64.HFacts{}
    var hit = false
    if let Some(b) = entry_get(os, dir, "hfacts", k) {
      if let Some(d) = arm64.hfacts_decode(b.to_str() ?? "") {
        f = d
        hit = true
      }
    }
    if !hit {
      miss.push(i)
    }
    facts.push(f)
  }
  if !miss.is_empty() {
    let next = Atomic[Int].new(0)
    let n = miss.len()
    let done = scope sc {
      var ts = []
      for _ in 0..jobs.min(n).max(1) {
        ts.push(sc.spawn(fn() -> List[(Int, arm64.HFacts)] {
          var mine: List[(Int, arm64.HFacts)] = []
          while true {
            let j = next.add(1) - 1
            if j >= n {
              break
            }
            let i = miss[j]
            mine.push((i, arm64.hollow_scan(parts[i], elf, extra, first)))
          }
          mine
        }))
      }
      var all: List[(Int, arm64.HFacts)] = []
      for t in ts {
        all = all + t.await
      }
      all
    }
    for (i, f) in done {
      facts[i] = f
      fstored += entry_put(os, dir, "hfacts", fk[i], arm64.hfacts_encode(f).bytes())
    }
  }
  // counted toward the prune and logged (store-log), as every kind is
  prune_backend_cache(os, "hfacts", dir, fstored)
  let live = incr_live(facts, elf, hollow)
  let trap = if amd64 { arm64.HOLLOW_UD2 } else { "brk #${arm64.HOLLOW_BRK}" }
  // each part's object and undefined-symbol facts, by its text and dead set
  var out = IncrOut{facts: facts, live: live, elf: elf, hollow: hollow}
  var okeys: List[Str] = []
  var ufs: List[arm64.UFacts] = []
  var amiss: List[Int] = []
  for i in 0..tk.len() {
    let dead = arm64.hollow_dead_names(facts[i], live[i])
    let ok = crypto.sha256("${HOLLOW_INCR_VERSION} obj ${id} amd64=${amd64} elf=${elf} hollow=${hollow}\x00${fk[i]}\x00${dead.join("\n")}".bytes()).to_hex()
    okeys.push(ok)
    var u = arm64.UFacts{}
    var got = false
    if let Some(ub) = entry_get(os, dir, "hufacts", ok) {
      if let Some(d) = arm64.ufacts_decode(ub.to_str() ?? "") {
        if let Some(ob) = entry_get(os, dir, "hobj", ok) {
          u = d
          out.objs.push(Ok(ob))
          got = true
        }
      }
    }
    if !got {
      out.objs.push(Err("not assembled"))
      amiss.push(i)
    }
    ufs.push(u)
  }
  if !amiss.is_empty() {
    var stored = 0
    for (j, (r, u)) in hollow_objects(parts, facts, live, amiss, trap, elf, amd64, jobs).indexed() {
      let i = amiss[j]
      out.objs[i] = r
      ufs[i] = u
      match r {
        Ok(b) => {
          stored += entry_put(os, dir, "hobj", okeys[i], b)
          stored += entry_put(os, dir, "hufacts", okeys[i], arm64.ufacts_encode(u).bytes())
        }
        Err(_) => {}
      }
    }
    prune_backend_cache(os, "hobj", dir, stored)
  }
  out.nasm = amiss.len()
  out.okeys = okeys
  out.undef = arm64.undef_combine(ufs)
  var all_ok = true
  for r in out.objs {
    if r is Err(_) {
      all_ok = false
    }
  }
  if all_ok {
    prune_backend_cache(os, "hwhole", dir, entry_put(os, dir, "hwhole", wk, okeys.join("\n").bytes()))
  }
  Some(out)
}

/// incr_hollow's result from the whole build's entry (its object keys,
/// one per part, under wk): each object and its undefined-symbol facts
/// read by its key; None when any is missing, and the build takes the
/// part by part path.
fn incr_whole(os: Os, dir: Str, wk: Str, n: Int) -> IncrOut? {
  let b = entry_get(os, dir, "hwhole", wk)?
  let ks = (b.to_str() ?? "").split("\n")
  if ks.len() != n {
    return None
  }
  var out = IncrOut{okeys: ks}
  var ufs: List[arm64.UFacts] = []
  for k in ks {
    let ub = entry_get(os, dir, "hufacts", k)?
    let u = arm64.ufacts_decode(ub.to_str() ?? "")?
    let ob = entry_get(os, dir, "hobj", k)?
    out.objs.push(Ok(ob))
    ufs.push(u)
  }
  out.undef = arm64.undef_combine(ufs)
  Some(out)
}

/// Whether each chunk of each part is kept: reached (hollow_live) when
/// hollow, else every one.
fn incr_live(facts: List[arm64.HFacts], elf: Bool, hollow: Bool) -> List[List[Bool]] {
  if hollow {
    return arm64.hollow_live(facts, elf)
  }
  var live: List[List[Bool]] = []
  for f in facts {
    var l: List[Bool] = []
    for _ in 0..f.chunks.len() {
      l.push(true)
    }
    live.push(l)
  }
  live
}

/// The objects and undefined-symbol facts of the parts amiss, hollowed, in
/// amiss's order. Each task rewrites a part's text and drops it once its
/// object is built: a list of every part's hollowed text beside the parts
/// was the self build's peak (decision 0448 stage 3).
fn hollow_objects(parts: List[Str], facts: List[arm64.HFacts], live: List[List[Bool]], amiss: List[Int], trap: Str, elf: Bool, amd64: Bool, jobs: Int) -> List[(Result[Bytes, Str], arm64.UFacts)] {
  let n = amiss.len()
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..jobs.min(n).max(1) {
      ts.push(sc.spawn(fn() -> List[(Int, Result[Bytes, Str], arm64.UFacts)] {
        var mine: List[(Int, Result[Bytes, Str], arm64.UFacts)] = []
        while true {
          let j = next.add(1) - 1
          if j >= n {
            break
          }
          let i = amiss[j]
          let (t, _, _) = arm64.hollow_rewrite(parts[i], facts[i], live[i], trap)
          let r = assemble_one(t, elf, amd64)
          // the undefined-symbol check is Mach-O's (main.xo, darwin)
          let u = if elf { arm64.UFacts{} } else { arm64.undef_scan(t) }
          mine.push((j, r, u))
        }
        mine
      }))
    }
    var all: List[(Int, Result[Bytes, Str], arm64.UFacts)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[(Result[Bytes, Str], arm64.UFacts)] = []
  for _ in 0..n {
    out.push((Err("not assembled"), arm64.UFacts{}))
  }
  for (j, r, u) in done {
    out[j] = (r, u)
  }
  out
}

/// The hollowed texts of an incr_hollow build, for a tool that reads them
/// (--ld=cc, XO_KEEP_ASM=1).
fn incr_texts(parts: List[Str], inc: IncrOut, march: Str) -> List[Str] {
  let trap = if march == "amd64" { arm64.HOLLOW_UD2 } else { "brk #${arm64.HOLLOW_BRK}" }
  var facts = inc.facts
  var live = inc.live
  if facts.len() != parts.len() {
    // a whole hit (incr_whole) read no facts: scan the parts again
    var labels: List[Str] = []
    if inc.elf {
      for p in parts {
        labels = labels + arm64.hollow_extra_of(p)
      }
    }
    let (extra, first) = arm64.hollow_extra_from(labels)
    facts = []
    for p in parts {
      facts.push(arm64.hollow_scan(p, inc.elf, extra, first))
    }
    live = incr_live(facts, inc.elf, inc.hollow)
  }
  var out: List[Str] = []
  for (i, p) in parts.indexed() {
    let (t, _, _) = arm64.hollow_rewrite(p, facts[i], live[i], trap)
    out.push(t)
  }
  out
}

/// The flags of a `cc -c` of assembly: the link's flags without the
/// libraries, library directories, linker flags, and inputs.
fn asm_cflags(flags: List[Str]) -> List[Str] {
  var cflags: List[Str] = []
  var skip = false
  for f in flags {
    // -Xlinker and its argument (wl_path) are the link's
    if skip || f == "-Xlinker" {
      skip = !skip && f == "-Xlinker"
      continue
    }
    if !(f.starts_with("-l") || f.starts_with("-L") || f.starts_with("-Wl,") || f.ends_with(".a") || f.ends_with(".o")) {
      cflags.push(f)
    }
  }
  cflags
}

/// The back-end cache keys of cc's objects of the assembly texts, whose
/// files are named names (base names: an ELF object names its source):
/// cc's identity, the compile flags of the link's flags, each name and
/// text.
fn cc_obj_keys(os: Os, ctx: Ctx, cc: Str, flags: List[Str], names: List[Str], texts: List[Str], jobs: Int) -> List[Str] {
  let prefix = "xo backend v1 obj cc\x00${tool_id_memo(os, ctx, cc, ["--version"])}\x00${asm_cflags(flags).join("\x00")}"
  part_keys(prefix, names, texts, jobs)
}

/// The first line of the .s a lean build writes for a part whose cc
/// object the back-end cache holds, followed by the key: the link reads
/// that object's weak references itself (weak_undefined_args).
const CC_OBJ_STUB = "# xo: the object of back-end cache key "

/// Whether the back-end cache holds cc's object of key (cc_obj_keys).
fn cc_obj_held(os: Os, ctx: Ctx, key: Str) -> Bool {
  let dir = backend_cache_dir(os, ctx)
  !dir.is_empty() && (os.fs.exists(zentry_path(dir, "obj", key, compress_on(os))).ok() ?? false)
}

/// cc_assemble through the back-end cache (decision 0220 addendum): the
/// object of a part the cache holds (keyed by the C compiler's identity,
/// the flags, the source's base name, which an ELF object names, and its
/// assembly text, or keys0[i] when given: cc_obj_keys) is written beside
/// it, the others' texts (text_of) written and assembled by cc.
fn cached_cc_assemble(os: Os, ctx: Ctx, cc: Str, flags: List[Str], srcs: List[Str], text_of: fn(Int) -> Str, keys0: List[Str], jobs: Int) -> (List[Str], Str, Int) {
  let dir = backend_cache_dir(os, ctx)
  if dir.is_empty() || srcs.len() < 2 {
    // (with no cache the caller wrote every part's text: cc_obj_held)
    let (objs, why) = cc_assemble(os, cc, flags, srcs, jobs)
    return (objs, why, srcs.len())
  }
  var texts: List[Str] = []
  if keys0.len() != srcs.len() {
    for i in 0..srcs.len() {
      texts.push(text_of(i))
    }
  }
  let keys = if keys0.len() == srcs.len() { keys0 } else { cc_obj_keys(os, ctx, cc, flags, srcs.map(fn(s) { base_name(s) }), texts, jobs) }
  var objs: List[Str] = []
  var miss: List[Int] = []
  var msrcs: List[Str] = []
  for (i, s) in srcs.indexed() {
    let obj = s.trim_suffix(".s") + ".o"
    objs.push(obj)
    var hit = false
    match entry_get(os, dir, "obj", keys[i]) {
      Some(b) => hit = os.fs.write(obj, b).is_ok()
      None => {}
    }
    if !hit {
      miss.push(i)
      msrcs.push(s)
    }
  }
  if miss.is_empty() {
    return (objs, "", 0)
  }
  // the texts of the parts cc assembles: the caller wrote a key line for
  // a part whose object the cache held when it looked (cc_obj_held)
  for i in miss {
    if keys0.len() == srcs.len() {
      if let Err(e) = os.fs.write(srcs[i], text_of(i).bytes()) {
        return (objs, "${srcs[i]}: ${e}\n", miss.len())
      }
    }
  }
  let (_, why) = cc_assemble(os, cc, flags, msrcs, jobs)
  if !why.is_empty() {
    return (objs, why, miss.len())
  }
  var n = 0
  for i in miss {
    match os.fs.read(objs[i]) {
      Ok(b) => {
        n += entry_put(os, dir, "obj", keys[i], b)
      }
      // xo:allow XO0903 an object not stored in the cache is built again
      Err(_) => {}
    }
  }
  prune_backend_cache(os, "obj", dir, n)
  (objs, "", miss.len())
}

/// The objects of the arm64 or amd64 assembly files srcs, as macho_objects makes
/// them, with the rows of their code's bytes per function and cause
/// (macho.assemble_causes, decision 0443) written to path, a part's rows
/// after the part before it.
fn causes_objects(os: Os, srcs: List[Str], elf: Bool, amd64: Bool, jobs: Int, path: Str) -> List[Result[Bytes, Str]] {
  let n = srcs.len()
  let w = jobs.min(n).max(1)
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..w {
      ts.push(sc.spawn(fn() -> List[(Int, Result[(Bytes, Str), Str])] {
        var mine: List[(Int, Result[(Bytes, Str), Str])] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          let src = srcs[i].bytes()
          mine.push((i, if amd64 { macho.assemble_causes_amd64(src, elf) } else { macho.assemble_causes(src, elf) }))
        }
        mine
      }))
    }
    var all: List[(Int, Result[(Bytes, Str), Str])] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[Result[Bytes, Str]] = []
  var rows: List[Str] = []
  for _ in 0..n {
    out.push(Err("not assembled"))
    rows.push("")
  }
  for (i, r) in done {
    match r {
      Ok((obj, rs)) => {
        out[i] = Ok(obj)
        rows[i] = rs
      }
      Err(e) => out[i] = Err(e)
    }
  }
  match os.fs.write(path, rows.join("").bytes()) {
    Ok(_) => {}
    Err(e) => os.stdio.eprint("xo: XO_SIZE_CAUSES: ${e}\n")
  }
  out
}
