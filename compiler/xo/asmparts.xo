// The assembly files of a parallel arm64 generation (arm64
// generate_parallel, bench/results/fast-builds-2026-10-13.md) assemble
// apart: by compiler/macho on parallel tasks, or by parallel `cc -c`
// processes, before one link.

use github.com/xo-lang/xo/compiler/arm64
use github.com/xo-lang/xo/compiler/macho
use std/crypto

/// The objects of the assembly files srcs (ELF when elf, else Mach-O) by
/// compiler/macho, on up to jobs tasks, in the order of srcs.
fn macho_objects(srcs: List[Str], elf: Bool, amd64: Bool, jobs: Int) -> List[Result[Bytes, Str]] {
  let n = srcs.len()
  let w = jobs.min(n)
  if w <= 1 {
    var out: List[Result[Bytes, Str]] = []
    for s in srcs {
      out.push(assemble_one(s, elf, amd64))
    }
    return out
  }
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..w {
      ts.push(sc.spawn(fn() -> List[(Int, Result[Bytes, Str])] {
        var mine: List[(Int, Result[Bytes, Str])] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          mine.push((i, assemble_one(srcs[i], elf, amd64)))
        }
        mine
      }))
    }
    var all: List[(Int, Result[Bytes, Str])] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[Result[Bytes, Str]] = []
  for _ in 0..n {
    out.push(Err("not assembled"))
  }
  for (i, r) in done {
    out[i] = r
  }
  out
}

/// A windows/amd64 COFF object of the amd64 backend's text src (decision
/// 0254 6b step 3).
fn assemble_coff(src: Str) -> Result[Bytes, Str] {
  macho.assemble_coff_amd64(src.bytes())
}

fn assemble_one(src: Str, elf: Bool, amd64: Bool) -> Result[Bytes, Str] {
  if amd64 && !elf {
    // x86_64 Mach-O (decision 0254 stage 6a: darwin/amd64)
    return macho.assemble_macho_amd64(src.bytes(), (11, 0))
  }
  if amd64 {
    // x86_64 ELF (decision 0254: the amd64 backend's text)
    return macho.assemble_elf_amd64(src.bytes())
  }
  if elf { macho.assemble_elf(src.bytes()) } else { macho.assemble(src.bytes()) }
}

/// The -isysroot of the SDK the last link used (cc_build's memo), so the
/// parts' objects are built for the SDK the link targets; none when there
/// is no memo.
fn memo_sysroot(os: Os, ctx: Ctx) -> List[Str] {
  let memo = sysroot_memo(os, ctx)
  if memo.is_empty() {
    return []
  }
  // xo:allow XO0903 a memo: a failed read finds the sysroot again
  let root = (os.fs.read_text(memo).ok() ?? "").trim()
  if root.is_empty() {
    return []
  }
  ["-isysroot", root]
}

/// Assembles the files srcs with `cc -c` (the flags a compile takes from
/// the link's), at most jobs processes at once: the objects beside them,
/// and the output of the first failure ("" when none failed).
fn cc_assemble(os: Os, cc: Str, flags: List[Str], srcs: List[Str], jobs: Int) -> (List[Str], Str) {
  let cflags = asm_cflags(flags)
  var objs: List[Str] = []
  for s in srcs {
    objs.push(s.trim_suffix(".s") + ".o")
  }
  var next = 0
  var running: List[(Int, Child)] = []
  var fails: List[Str] = []
  while next < srcs.len() || !running.is_empty() {
    while next < srcs.len() && running.len() < jobs.max(1) {
      match os.proc.cmd(cc, cflags + ["-c", srcs[next], "-o", objs[next]]).merge_stderr().spawn() {
        Ok(ch) => running.push((next, ch))
        Err(e) => fails.push("${srcs[next]}: ${e}\n")
      }
      next += 1
    }
    if running.is_empty() {
      break
    }
    // the oldest first: its output, then its status
    let (k, ch) = running[0]
    running = running[1..running.len()]
    var outb = BytesBuilder.new()
    var reading = true
    while reading {
      match ch.read(65536) {
        Ok(Some(data)) => outb.write(data)
        _ => reading = false
      }
    }
    match ch.wait() {
      Ok(code) => {
        if code != 0 {
          fails.push("${srcs[k]}: exit status ${code}\n${outb.freeze().to_str() ?? ""}")
        }
      }
      Err(e) => fails.push("${srcs[k]}: ${e}\n")
    }
  }
  if !fails.is_empty() {
    return (objs, fails[0])
  }
  (objs, "")
}

/// The back-end cache keys of srcs (bcache.xo): the SHA-256 of prefix,
/// tags[i] (when given), and each source, on up to jobs tasks, in the
/// order of srcs.
fn part_keys(prefix: Str, tags: List[Str], srcs: List[Str], jobs: Int) -> List[Str] {
  let n = srcs.len()
  let w = jobs.min(n).max(1)
  let next = Atomic[Int].new(0)
  let done = scope sc {
    var ts = []
    for _ in 0..w {
      ts.push(sc.spawn(fn() -> List[(Int, Str)] {
        var mine: List[(Int, Str)] = []
        while true {
          let i = next.add(1) - 1
          if i >= n {
            break
          }
          var b = BytesBuilder.new()
          b.write_str(prefix)
          b.write_str("\x00")
          if i < tags.len() {
            b.write_str(tags[i])
          }
          b.write_str("\x00")
          b.write_str(srcs[i])
          mine.push((i, crypto.sha256(b.freeze()).to_hex()))
        }
        mine
      }))
    }
    var all: List[(Int, Str)] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: List[Str] = []
  for _ in 0..n {
    out.push("")
  }
  for (i, k) in done {
    out[i] = k
  }
  out
}

/// macho_objects through the back-end cache (decision 0220 addendum): a
/// part whose assembly the cache holds is not assembled again. A program
/// of one file does not use the cache.
/// Also the objects' keys ([] without the cache), which a tail entry
/// records (tail_put).
fn cached_macho_objects(os: Os, ctx: Ctx, srcs: List[Str], elf: Bool, amd64: Bool, jobs: Int) -> (List[Result[Bytes, Str]], Int, List[Str]) {
  let dir = backend_cache_dir(os, ctx)
  if dir.is_empty() || srcs.len() < 2 {
    return (macho_objects(srcs, elf, amd64, jobs), srcs.len(), [])
  }
  let id = cache_id(os)
  if id.is_empty() {
    return (macho_objects(srcs, elf, amd64, jobs), srcs.len(), [])
  }
  let keys = part_keys("xo backend v1 obj macho elf=${elf} ${id}", [], srcs, jobs)
  var out: List[Result[Bytes, Str]] = []
  var miss: List[Int] = []
  var msrcs: List[Str] = []
  for (i, k) in keys.indexed() {
    match entry_get(os, dir, "obj", k) {
      Some(b) => out.push(Ok(b))
      None => {
        out.push(Err("not assembled"))
        miss.push(i)
        msrcs.push(srcs[i])
      }
    }
  }
  if miss.is_empty() {
    return (out, 0, keys)
  }
  var n = 0
  for (j, r) in macho_objects(msrcs, elf, amd64, jobs).indexed() {
    let i = miss[j]
    out[i] = r
    match r {
      Ok(b) => {
        n += entry_put(os, dir, "obj", keys[i], b)
      }
      Err(_) => {}
    }
  }
  prune_backend_cache(os, "obj", dir, n)
  (out, miss.len(), keys)
}

// ---------------------------------------------------------------------------
// Hollowing a split darwin build part by part (2026-10-26): a part's
// facts (arm64 hollow.xo HFacts: its functions, what each names, its
// roots) are kept by the hash of its text, the reach runs over every
// part's facts, and a part's object (and its undefined-symbol facts) by
// the hash of its text and the names of its functions the reach left
// dead, which with the text fix the hollowed text. So an edit scans,
// hollows, hashes and assembles only the parts it changed (or whose dead
// set it changed), not every part: llvm-fib's edit spent 28 ms in hollow,
// 21 in the undefined-symbol scan and 7 to 25 assembling.

const HOLLOW_INCR_VERSION = "xo backend v1 hollow incr"

/// incr_hollow's result: each part's object (Ok, or the assembler's
/// error), the undefined symbols (arm64 undef_combine), how many parts
/// were assembled, and each part's facts and live chunks (to hollow its
/// text when a tool reads it: incr_texts).
struct IncrOut {
  objs: List[Result[Bytes, Str]] = []
  undef: List[(Str, Str)] = []
  nasm: Int = 0
  facts: List[arm64.HFacts] = []
  live: List[List[Bool]] = []
}

/// The objects of parts (Mach-O, arm64 or amd64) with the functions
/// nothing reaches emptied when hollow, through the back-end cache, and
/// the undefined symbols; None without the cache (the build then hollows
/// and assembles the whole text).
fn incr_hollow(os: Os, ctx: Ctx, parts: List[Str], march: Str, hollow: Bool, jobs: Int) -> IncrOut? {
  let dir = backend_cache_dir(os, ctx)
  let id = cache_id(os)
  if dir.is_empty() || id.is_empty() || parts.len() < 2 {
    return None
  }
  let amd64 = march == "amd64"
  let tk = part_keys("${HOLLOW_INCR_VERSION} facts ${id}", [], parts, jobs)
  // each part's facts, from the cache or scanned (on tasks)
  var facts: List[arm64.HFacts] = []
  var miss: List[Int] = []
  for (i, k) in tk.indexed() {
    var f = arm64.HFacts{}
    var hit = false
    if let Some(b) = entry_get(os, dir, "hfacts", k) {
      if let Some(d) = arm64.hfacts_decode(b.to_str() ?? "") {
        f = d
        hit = true
      }
    }
    if !hit {
      miss.push(i)
    }
    facts.push(f)
  }
  if !miss.is_empty() {
    let (extra, first) = arm64.hollow_extra(parts, false)
    let next = Atomic[Int].new(0)
    let n = miss.len()
    let done = scope sc {
      var ts = []
      for _ in 0..jobs.min(n).max(1) {
        ts.push(sc.spawn(fn() -> List[(Int, arm64.HFacts)] {
          var mine: List[(Int, arm64.HFacts)] = []
          while true {
            let j = next.add(1) - 1
            if j >= n {
              break
            }
            let i = miss[j]
            mine.push((i, arm64.hollow_scan(parts[i], false, extra, first)))
          }
          mine
        }))
      }
      var all: List[(Int, arm64.HFacts)] = []
      for t in ts {
        all = all + t.await
      }
      all
    }
    for (i, f) in done {
      facts[i] = f
      let _ = entry_put(os, dir, "hfacts", tk[i], arm64.hfacts_encode(f).bytes())
    }
  }
  var live: List[List[Bool]] = []
  if hollow {
    live = arm64.hollow_live(facts, false)
  } else {
    for f in facts {
      var l: List[Bool] = []
      for _ in 0..f.chunks.len() {
        l.push(true)
      }
      live.push(l)
    }
  }
  let trap = if amd64 { arm64.HOLLOW_UD2 } else { "brk #${arm64.HOLLOW_BRK}" }
  // each part's object and undefined-symbol facts, by its text and dead set
  var out = IncrOut{facts: facts, live: live}
  var okeys: List[Str] = []
  var ufs: List[arm64.UFacts] = []
  var amiss: List[Int] = []
  for (i, k) in tk.indexed() {
    let dead = arm64.hollow_dead_names(facts[i], live[i])
    let ok = crypto.sha256("${HOLLOW_INCR_VERSION} obj ${id} amd64=${amd64} hollow=${hollow}\x00${k}\x00${dead.join("\n")}".bytes()).to_hex()
    okeys.push(ok)
    var u = arm64.UFacts{}
    var got = false
    if let Some(ub) = entry_get(os, dir, "hufacts", ok) {
      if let Some(d) = arm64.ufacts_decode(ub.to_str() ?? "") {
        if let Some(ob) = entry_get(os, dir, "hobj", ok) {
          u = d
          out.objs.push(Ok(ob))
          got = true
        }
      }
    }
    if !got {
      out.objs.push(Err("not assembled"))
      amiss.push(i)
    }
    ufs.push(u)
  }
  if !amiss.is_empty() {
    var texts: List[Str] = []
    for i in amiss {
      let (t, _, _) = arm64.hollow_rewrite(parts[i], facts[i], live[i], trap)
      texts.push(t)
    }
    var stored = 0
    for (j, r) in macho_objects(texts, false, amd64, jobs).indexed() {
      let i = amiss[j]
      out.objs[i] = r
      let u = arm64.undef_scan(texts[j])
      ufs[i] = u
      match r {
        Ok(b) => {
          stored += entry_put(os, dir, "hobj", okeys[i], b)
          let _ = entry_put(os, dir, "hufacts", okeys[i], arm64.ufacts_encode(u).bytes())
        }
        Err(_) => {}
      }
    }
    prune_backend_cache(os, "hobj", dir, stored)
  }
  out.nasm = amiss.len()
  out.undef = arm64.undef_combine(ufs)
  Some(out)
}

/// The hollowed texts of an incr_hollow build, for a tool that reads them
/// (--ld=cc, XO_KEEP_ASM=1).
fn incr_texts(parts: List[Str], inc: IncrOut, march: Str) -> List[Str] {
  let trap = if march == "amd64" { arm64.HOLLOW_UD2 } else { "brk #${arm64.HOLLOW_BRK}" }
  var out: List[Str] = []
  for (i, p) in parts.indexed() {
    let (t, _, _) = arm64.hollow_rewrite(p, inc.facts[i], inc.live[i], trap)
    out.push(t)
  }
  out
}

/// The flags of a `cc -c` of assembly: the link's flags without the
/// libraries, library directories, linker flags, and inputs.
fn asm_cflags(flags: List[Str]) -> List[Str] {
  var cflags: List[Str] = []
  for f in flags {
    if !(f.starts_with("-l") || f.starts_with("-L") || f.starts_with("-Wl,") || f.ends_with(".a") || f.ends_with(".o")) {
      cflags.push(f)
    }
  }
  cflags
}

/// cc_assemble through the back-end cache (decision 0220 addendum): the
/// object of a part the cache holds (keyed by the C compiler's identity,
/// the flags, the source's path, which an ELF object names, and its
/// assembly texts[i]) is written beside it, the others assembled by cc.
fn cached_cc_assemble(os: Os, ctx: Ctx, cc: Str, flags: List[Str], srcs: List[Str], texts: List[Str], jobs: Int) -> (List[Str], Str, Int) {
  let dir = backend_cache_dir(os, ctx)
  if dir.is_empty() || srcs.len() < 2 || texts.len() != srcs.len() {
    let (objs, why) = cc_assemble(os, cc, flags, srcs, jobs)
    return (objs, why, srcs.len())
  }
  let prefix = "xo backend v1 obj cc\x00${tool_id_memo(os, ctx, cc, ["--version"])}\x00${asm_cflags(flags).join("\x00")}"
  let keys = part_keys(prefix, srcs, texts, jobs)
  var objs: List[Str] = []
  var miss: List[Int] = []
  var msrcs: List[Str] = []
  for (i, s) in srcs.indexed() {
    let obj = s.trim_suffix(".s") + ".o"
    objs.push(obj)
    var hit = false
    match entry_get(os, dir, "obj", keys[i]) {
      Some(b) => hit = os.fs.write(obj, b).is_ok()
      None => {}
    }
    if !hit {
      miss.push(i)
      msrcs.push(s)
    }
  }
  if miss.is_empty() {
    return (objs, "", 0)
  }
  let (_, why) = cc_assemble(os, cc, flags, msrcs, jobs)
  if !why.is_empty() {
    return (objs, why, miss.len())
  }
  var n = 0
  for i in miss {
    match os.fs.read(objs[i]) {
      Ok(b) => {
        n += entry_put(os, dir, "obj", keys[i], b)
      }
      // xo:allow XO0903 an object not stored in the cache is built again
      Err(_) => {}
    }
  }
  prune_backend_cache(os, "obj", dir, n)
  (objs, "", miss.len())
}
