// The LLVM backend's clang (internal/build llvm.go, decision 0178): which
// clang, the target attributes of the generated functions, and where
// they go in the IR.

/// Clang: $XO_CLANG, then clang on PATH, as a path; "" when there is
/// none.
fn find_clang(os: Os) -> Str {
  let c = os.env.get("XO_CLANG") ?? ""
  if !c.is_empty() {
    return look_path(os, c)
  }
  look_path(os, "clang")
}

/// The major version of an LLVM clang (`clang version N...`), or 0 for
/// none or another compiler: Apple's clang numbers its versions apart
/// from LLVM's (its 15 is LLVM 16), and a --cc that is not clang has no
/// such line.
fn clang_major(os: Os, clang: Str) -> Int {
  let (out, err) = combined(os, clang, ["--version"])
  if !err.is_empty() {
    return 0
  }
  parse_clang_major(out)
}

/// The version line's major number (clang_major), 0 when there is none.
fn parse_clang_major(out: Str) -> Int {
  let first = out.split("\n")[0]
  if first.contains("Apple clang") {
    return 0
  }
  let i = first.find("clang version ") ?? -1
  if i < 0 {
    return 0
  }
  let rest = first[i + "clang version ".len()..first.len()]
  let dot = rest.find(".") ?? rest.len()
  Int.parse(rest[0..dot]) ?? 0
}

/// The oldest LLVM clang the LLVM backend builds with: the generated IR
/// calls llvm.threadlocal.address (LLVM 16), which clang 15 links as an
/// undefined function (gotchas/llvm-thread-local-constant.md).
const CLANG_MIN = 16

/// ClangTargetAttrs: the LLVM function attributes of the target clang
/// compiles C for by default (its -target-cpu and -target-feature
/// arguments, from `clang -###`, decision 0119); "" when clang reports
/// neither.
fn clang_target_attrs(os: Os, clang: Str, cross: List[Str]) -> Str {
  // cross: a cross build's --target (llvm_cross_triple)
  let (out, err) = combined(os, clang, ["-###"] + cross + ["-c", "-x", "c", dev_null(), "-o", dev_null()])
  if !err.is_empty() {
    return ""
  }
  parse_target_attrs(out)
}

/// LLVMCrossTriple: the clang target triple of an LLVM build for t on
/// host ("os/arch"), when it is not the host and clang cross compiles for
/// it: on Windows (decision 0197, stage 3) the MSVC build tools carry both
/// the x64 and the ARM64 libraries, so windows/amd64 builds windows/arm64
/// and the reverse; on any other host, both Windows targets when winsysroot
/// (XO_WINSYSROOT) names a Windows sysroot; on darwin/arm64, darwin/amd64
/// (the macOS SDK carries both architectures), and from macOS linux/amd64
/// when sysroot (XO_LINUXSYSROOT) names a glibc sysroot (2026-10-15, to
/// build the x86_64 unwinder of decision 0221 stage 2 on the Mac). ""
/// otherwise. sysroot: XO_WINSYSROOT for a Windows target, else
/// XO_LINUXSYSROOT.
fn llvm_cross_triple(host: Str, t: Str, winsysroot: Str) -> Str {
  if host == "darwin/arm64" && t == "darwin/amd64" {
    return "x86_64-apple-macosx"
  }
  if host.starts_with("darwin/") && t == "linux/amd64" && !winsysroot.is_empty() {
    return "x86_64-linux-gnu"
  }
  if !t.starts_with("windows/") || host == t {
    return ""
  }
  if !host.starts_with("windows/") && winsysroot.is_empty() {
    return ""
  }
  match t {
    "windows/arm64" => "aarch64-pc-windows-msvc"
    "windows/amd64" => "x86_64-pc-windows-msvc"
    _ => ""
  }
}

/// The clang flags of a cross build for triple: --target, and from a host
/// other than Windows the Windows sysroot (MSVC's C library and the
/// Windows SDK in the layout of clang-cl's /winsysroot, e.g. made by
/// `xwin splat --use-winsysroot-style`), where clang finds the headers
/// and lld-link the libraries (decision 0197, cross builds).
fn llvm_cross_flags(host: Str, triple: Str, winsysroot: Str) -> List[Str] {
  if triple.contains("linux") {
    // a glibc sysroot (Debian's libc6-dev, linux-libc-dev, libgcc-10-dev
    // unpacked), linked with lld (clang $XO_CLANG must carry it)
    return ["--target=${triple}", "--sysroot=${winsysroot}", "-fuse-ld=lld"]
  }
  if host.starts_with("windows/") || !triple.contains("windows") {
    return ["--target=${triple}"]
  }
  ["--target=${triple}", "-Xmicrosoft-windows-sys-root", winsysroot]
}

/// parseTargetAttrs: the target CPU and features of the cc1 line.
fn parse_target_attrs(out: Str) -> Str {
  var cpu = ""
  var feats: List[Str] = []
  for line in out.split("\n") {
    if !line.contains("\"-cc1\"") {
      continue
    }
    let args = quoted_args(line)
    var i = 0
    while i + 1 < args.len() {
      if args[i] == "-target-cpu" {
        cpu = args[i + 1]
      } else if args[i] == "-target-feature" {
        feats.push(args[i + 1])
      }
      i += 1
    }
  }
  var parts: List[Str] = []
  if !cpu.is_empty() {
    parts.push("\"target-cpu\"=\"${cpu}\"")
  }
  if !feats.is_empty() {
    parts.push("\"target-features\"=\"${feats.join(",")}\"")
  }
  parts.join(" ")
}

/// The texts between double quotes on line, escapes kept as written
/// (the regular expression "((?:[^"\\]|\\.)*)" of llvm.go): a quote
/// after an odd number of backslashes does not end the text.
fn quoted_args(line: Str) -> List[Str] {
  let pieces = line.split("\"")
  var out: List[Str] = []
  var inside = false
  var cur = ""
  var i = 1
  while i < pieces.len() {
    if !inside {
      inside = true
      cur = pieces[i]
    } else if odd_backslashes(cur) {
      cur = "${cur}\"${pieces[i]}"
    } else {
      out.push(cur)
      inside = false
    }
    i += 1
  }
  out
}

/// Whether s ends in an odd number of backslashes.
fn odd_backslashes(s: Str) -> Bool {
  var n = 0
  var t = s
  while t.ends_with("\\") {
    n += 1
    t = t.trim_suffix("\\")
  }
  n % 2 == 1
}

/// withTargetAttrs: attrs added to the attribute groups of the
/// generated function definitions (the first of each).
fn with_target_attrs(ir: Str, attrs: Str) -> Str {
  if attrs.is_empty() {
    return ir
  }
  var s = ir
  for g in ["attributes #1 = { uwtable", "attributes #4 = { nounwind alwaysinline"] {
    let parts = s.split("${g} }")
    if parts.len() > 1 {
      s = parts[0] + "${g} ${attrs} }" + parts[1..parts.len()].join("${g} }")
    }
  }
  s
}
