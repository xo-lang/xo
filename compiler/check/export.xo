// Std's checked declarations as records (decision 0388 stage 1a-ii): the
// objects, types, effect sets and effect variables the std tree's
// declare, resolve_types and resolve_sigs made (one block of each table
// since 1a-i), with no syntax tree. A function's declaration, a
// parameter's or field's default and a constant's value are counted, not
// stored: their trees come from the files' parses, joined by position.

use std/crypto
use github.com/xo-lang/xo/compiler/parser

/// The bounds of the std tree's block in each of the checker's tables,
/// [lo, hi): set by Checker.run after the std phases.
pub struct StdBlock {
  pub obj_lo: Int = 0
  pub obj_hi: Int = 0
  pub ty_lo: Int = 0
  pub ty_hi: Int = 0
  pub eset_lo: Int = 0
  pub eset_hi: Int = 0
  pub evar_lo: Int = 0
  pub evar_hi: Int = 0
}

/// The records of std's block, and what refers into it from outside the
/// tables: each std module's members and each std file's declaration
/// objects (by path), the named types of no type arguments, and the
/// functions inferred or declared realtime.
pub struct StdExport {
  pub block: StdBlock
  pub objs: List[Obj] = []
  /// per object, its trees' counts (obj_trees): the records leave the
  /// trees out
  pub trees: List[List[Int]] = []
  pub tys: List[Ty] = []
  pub esets: List[List[EffItem]] = []
  pub evars: List[Int] = []
  pub members: List[(Str, List[(Bytes, Int)])] = []
  pub decl_objs: List[(Str, List[Int])] = []
  pub named0: List[(Int, Int)] = []
  pub inferred_fns: List[Int] = []
  pub realtime_fns: List[Int] = []
  /// the indices outside the block the records name, by path: the std
  /// modules, their Module objects and their files
  pub mod_ids: List[(Int, Str)] = []
  pub mod_objs: List[(Int, Str)] = []
  pub file_ids: List[(Int, Str)] = []
  /// std's module closure (decision 0388 stage 2 piece 1): each std
  /// module in check order with its files and their imports, so a loader
  /// makes std's modules from the record without reading or parsing a
  /// std file (load_std_record)
  pub closure: List[StdModRec] = []
}

/// One std module of the closure, as new_module and the loaders set it.
pub struct StdModRec {
  pub path: Str
  pub name: Str
  pub dir: Str
  pub is_prelude: Bool = false
  pub native: Bool = false
  pub implements: Str = ""
  pub files: List[StdFileRec] = []
}

/// One file of a std module: what SrcFile holds without its parse (the
/// interface hash for the caches' keys, the content's hash for a key
/// that would hash the source), and its imports (the local name, the
/// `use` path as written, the module it names).
pub struct StdFileRec {
  pub path: Str
  pub iface: Str = ""
  pub sha: Str = ""
  pub sig: Bool = false
  pub is_test: Bool = false
  pub imports: List[(Str, Str, Str)] = []
  /// the byte range of each top-level declaration (decision 0428), so a
  /// declaration parses alone; none when the file had diagnostics
  pub ranges: List[parser.DeclRange] = []
}

const EXPORT_VERSION = "xo std export v4 (declaration ranges in the file records)"

/// The std block's records as the checker holds them now.
pub fn (c: Checker) std_export() -> StdExport {
  let b = c.std_block
  var e = StdExport{block: b}
  for o in b.obj_lo..b.obj_hi {
    e.objs.push(c.objs[o])
    e.trees.push(obj_trees(c.objs[o]))
  }
  for t in b.ty_lo..b.ty_hi {
    e.tys.push(c.tys[t])
  }
  for s in b.eset_lo..b.eset_hi {
    e.esets.push(c.esets[s])
  }
  for v in b.evar_lo..b.evar_hi {
    e.evars.push(c.evars[v])
  }
  // in the order the std phases ran (c.order), not the modules' load
  // order, which a second check of the same program can change
  for mi in c.order {
    let md = c.mods[mi]
    if !md.std_tree {
      continue
    }
    var ms: List[(Bytes, Int)] = []
    for (k, o) in md.members.entries() {
      ms.push((k, o))
    }
    e.members.push((md.path, ms))
    var rec = StdModRec{path: md.path, name: md.name, dir: md.dir, is_prelude: md.is_prelude, native: md.native, implements: md.implements}
    for f in md.files {
      let sf = c.files[f]
      var fr = StdFileRec{path: sf.path, iface: sf.iface, sha: crypto.sha256(sf.src).to_hex(), sig: sf.sig, is_test: sf.is_test, ranges: sf.ast.ranges}
      var locals: List[Str] = []
      for (k, _) in sf.imports.entries() {
        locals.push(text(k))
      }
      for k in locals.sort() {
        if let Some(im) = sf.imports.get(k.bytes()) {
          fr.imports.push((k, text(im.path), if im.module >= 0 { c.mods[im.module].path } else { "" }))
        }
      }
      rec.files.push(fr)
    }
    e.closure.push(rec)
    e.mod_ids.push((c.mod_index.get(md.path) ?? -1, md.path))
    e.mod_objs.push((md.obj, md.path))
    for f in md.files {
      e.file_ids.push((f, c.files[f].path))
      e.decl_objs.push((c.files[f].path, c.files[f].decl_objs))
    }
  }
  for (o, t) in c.named0.entries() {
    if o >= b.obj_lo && o < b.obj_hi {
      e.named0.push((o, t))
    }
  }
  for f in c.inferred_fns {
    if f >= b.obj_lo && f < b.obj_hi {
      e.inferred_fns.push(f)
    }
  }
  for f in c.realtime_fns {
    if f >= b.obj_lo && f < b.obj_hi {
      e.realtime_fns.push(f)
    }
  }
  e
}

// ---------------------------------------------------------------------------
// The codec: varints (signed values zigzag), length prefixed bytes.

struct ExW {
  b: BytesBuilder
}

fn (var w: ExW) uv(v0: Int) {
  var v = v0
  while v >= 128 {
    w.b.write_byte(UInt8((v & 127) | 128))
    v = v >> 7
  }
  w.b.write_byte(UInt8(v))
}

fn (var w: ExW) sv(v: Int) {
  w.uv(if v < 0 { ((-v) << 1) - 1 } else { v << 1 })
}

fn (var w: ExW) bytes(d: Bytes) {
  w.uv(d.len())
  w.b.write(d)
}

fn (var w: ExW) str(s: Str) {
  w.bytes(s.bytes())
}

fn (var w: ExW) bool(x: Bool) {
  w.uv(if x { 1 } else { 0 })
}

fn (var w: ExW) ints(xs: List[Int]) {
  w.uv(xs.len())
  for x in xs {
    w.sv(x)
  }
}

fn (var w: ExW) span(s: Span) {
  w.uv(s.start.offset)
  w.uv(s.start.line)
  w.uv(s.start.col)
  w.uv(s.end.offset)
  w.uv(s.end.line)
  w.uv(s.end.col)
}

struct ExR {
  d: Bytes
  at: Int = 0
  ok: Bool = true
}

fn (var r: ExR) uv() -> Int {
  var v = 0
  var sh = 0
  while true {
    if r.at >= r.d.len() || sh > 63 {
      r.ok = false
      return 0
    }
    let c = Int(r.d[r.at])
    r.at += 1
    v = v | ((c & 127) << sh)
    if c < 128 {
      break
    }
    sh += 7
  }
  v
}

fn (var r: ExR) sv() -> Int {
  let u = r.uv()
  if (u & 1) == 1 { -((u + 1) >> 1) } else { u >> 1 }
}

fn (var r: ExR) bytes() -> Bytes {
  let n = r.uv()
  if !r.ok || n > r.d.len() - r.at {
    r.ok = false
    return b""
  }
  let out = r.d[r.at..r.at + n]
  r.at += n
  out
}

fn (var r: ExR) str() -> Str {
  r.bytes().to_str() ?? ""
}

fn (var r: ExR) bool() -> Bool {
  r.uv() == 1
}

fn (var r: ExR) ints() -> List[Int] {
  let n = r.uv()
  if !r.ok || n > r.d.len() {
    r.ok = false
    return []
  }
  var out = List[Int].with_capacity(n)
  for _ in 0..n {
    out.push(r.sv())
  }
  out
}

fn (var r: ExR) span() -> Span {
  let so = r.uv()
  let sl = r.uv()
  let sc = r.uv()
  let eo = r.uv()
  let el = r.uv()
  let ec = r.uv()
  Span{start: parser.Pos{offset: so, line: sl, col: sc}, end: parser.Pos{offset: eo, line: el, col: ec}}
}

fn obj_kind_int(k: ObjKind) -> Int {
  match k {
    ObjKind.Func => 0
    ObjKind.Const => 1
    ObjKind.Type => 2
    ObjKind.TParam => 3
    ObjKind.Local => 4
    ObjKind.Module => 5
  }
}

fn obj_kind_of(n: Int) -> ObjKind {
  match n {
    0 => ObjKind.Func
    1 => ObjKind.Const
    2 => ObjKind.Type
    3 => ObjKind.TParam
    4 => ObjKind.Local
    _ => ObjKind.Module
  }
}

fn ty_kind_int(k: TyKind) -> Int {
  match k {
    TyKind.Named => 0
    TyKind.Tuple => 1
    TyKind.Func => 2
    TyKind.Param => 3
    TyKind.Var => 4
    TyKind.Bad => 5
    TyKind.EffArg => 6
  }
}

fn ty_kind_of(n: Int) -> TyKind {
  match n {
    0 => TyKind.Named
    1 => TyKind.Tuple
    2 => TyKind.Func
    3 => TyKind.Param
    4 => TyKind.Var
    5 => TyKind.Bad
    _ => TyKind.EffArg
  }
}

/// The counts of an object's trees, in record order: each field's
/// default, the function's declaration, each parameter's default, the
/// constant's value and the let's value.
fn obj_trees(x: Obj) -> List[Int] {
  var t: List[Int] = []
  for f in x.fields {
    t.push(f.default.len())
  }
  t.push(x.fn_decl.len())
  for p in x.params {
    t.push(p.default.len())
  }
  t.push(x.const_val.len())
  t.push(x.let_value.len())
  t
}

fn (var w: ExW) obj(x: Obj, t: List[Int]) {
  var ti = 0
  w.uv(obj_kind_int(x.kind))
  w.bytes(x.name)
  w.sv(x.module)
  w.str(x.file)
  w.uv(x.line)
  w.uv(x.col)
  w.str(x.local)
  w.bool(x.effect)
  w.ints(x.tparams)
  w.bool(x.is_pub)
  w.str(x.tkind)
  w.uv(x.fields.len())
  for f in x.fields {
    w.bytes(f.name)
    w.sv(f.ty)
    w.bool(f.is_pub)
    w.uv(t[ti])
    ti += 1
    w.uv(f.line)
    w.uv(f.col)
    w.bytes(f.wire)
    w.bytes(f.json_key)
    w.bool(f.omit_empty)
    w.bytes(f.json_wire)
    w.bytes(f.sql_wire)
    w.bytes(f.xml_wire)
    w.bytes(f.sql_key)
  }
  w.uv(x.variants.len())
  for v in x.variants {
    w.bytes(v.name)
    w.uv(v.index)
    w.uv(v.fields.len())
    for vf in v.fields {
      w.bytes(vf.name)
      w.bool(vf.from)
      w.sv(vf.ty)
      w.uv(vf.line)
      w.uv(vf.col)
    }
    w.bool(v.unit)
    w.uv(v.line)
    w.uv(v.col)
  }
  w.ints(x.iface_meths)
  w.sv(x.target)
  w.uv(x.derives.len())
  for d in x.derives {
    w.str(d)
  }
  w.bool(x.opaque)
  w.uv(x.methods.len())
  for (k, f) in x.methods.entries() {
    w.bytes(k)
    w.sv(f)
  }
  w.uv(x.statics.len())
  for (k, f) in x.statics.entries() {
    w.bytes(k)
    w.sv(f)
  }
  w.bool(x.resolving)
  w.bool(x.resolved)
  w.sv(x.decl_file)
  w.sv(x.decl_idx)
  w.uv(t[ti])
  ti += 1
  w.uv(x.params.len())
  for p in x.params {
    w.bytes(p.name)
    w.sv(p.ty)
    w.bool(p.is_var)
    w.uv(t[ti])
    ti += 1
    w.uv(p.line)
    w.uv(p.col)
  }
  w.sv(x.result)
  w.sv(x.err)
  w.sv(x.recv)
  w.sv(x.recv_ty)
  w.bool(x.recv_var)
  w.bool(x.is_static)
  w.bool(x.static_const)
  w.bool(x.iface)
  w.uv(x.own_tparams)
  w.sv(x.declared)
  w.bool(x.sig_done)
  w.sv(x.body_eff)
  w.bool(x.moves)
  w.bool(x.move_only)
  w.bool(x.realtime)
  w.span(x.realtime_span)
  w.sv(x.ty)
  w.bool(x.done)
  w.bool(x.checking)
  w.bool(x.mutable)
  w.bool(x.is_const)
  w.uv(t[ti])
  ti += 1
  w.sv(x.vctx)
  w.sv(x.frame)
  w.sv(x.group_frame)
  w.bool(x.awaited)
  w.bool(x.used)
  w.span(x.let_span)
  w.uv(t[ti])
  w.sv(x.constraint)
  w.bool(x.implicit)
  w.bool(x.elided)
  w.str(x.elided_file)
  w.span(x.elided_at)
  w.str(x.elided_text)
}

/// An object's record; its trees (fn_decl, defaults, const_val,
/// let_value) are empty, their counts in the second result.
fn (var r: ExR) obj() -> (Obj, List[Int]) {
  var x = Obj{kind: obj_kind_of(r.uv()), name: r.bytes()}
  var trees: List[Int] = []
  x.module = r.sv()
  x.file = r.str()
  x.line = r.uv()
  x.col = r.uv()
  x.local = r.str()
  x.effect = r.bool()
  x.tparams = r.ints()
  x.is_pub = r.bool()
  x.tkind = r.str()
  let nf = r.uv()
  for _ in 0..nf {
    if !r.ok {
      break
    }
    let name = r.bytes()
    let ty = r.sv()
    let is_pub = r.bool()
    trees.push(r.uv())
    let line = r.uv()
    let col = r.uv()
    x.fields.push(FieldInfo{name: name, ty: ty, is_pub: is_pub, line: line, col: col, wire: r.bytes(), json_key: r.bytes(), omit_empty: r.bool(), json_wire: r.bytes(), sql_wire: r.bytes(), xml_wire: r.bytes(), sql_key: r.bytes()})
  }
  let nv = r.uv()
  for _ in 0..nv {
    if !r.ok {
      break
    }
    let name = r.bytes()
    let index = r.uv()
    let nvf = r.uv()
    var vfs: List[VFieldInfo] = []
    for _ in 0..nvf {
      if !r.ok {
        break
      }
      vfs.push(VFieldInfo{name: r.bytes(), from: r.bool(), ty: r.sv(), line: r.uv(), col: r.uv()})
    }
    x.variants.push(VariantInfo{name: name, index: index, fields: vfs, unit: r.bool(), line: r.uv(), col: r.uv()})
  }
  x.iface_meths = r.ints()
  x.target = r.sv()
  let nd = r.uv()
  for _ in 0..nd {
    if !r.ok {
      break
    }
    x.derives.push(r.str())
  }
  x.opaque = r.bool()
  let nm = r.uv()
  for _ in 0..nm {
    if !r.ok {
      break
    }
    let k = r.bytes()
    x.methods[k] = r.sv()
  }
  let ns = r.uv()
  for _ in 0..ns {
    if !r.ok {
      break
    }
    let k = r.bytes()
    x.statics[k] = r.sv()
  }
  x.resolving = r.bool()
  x.resolved = r.bool()
  x.decl_file = r.sv()
  x.decl_idx = r.sv()
  trees.push(r.uv())
  let np = r.uv()
  for _ in 0..np {
    if !r.ok {
      break
    }
    let name = r.bytes()
    let ty = r.sv()
    let is_var = r.bool()
    trees.push(r.uv())
    x.params.push(ParamInfo{name: name, ty: ty, is_var: is_var, line: r.uv(), col: r.uv()})
  }
  x.result = r.sv()
  x.err = r.sv()
  x.recv = r.sv()
  x.recv_ty = r.sv()
  x.recv_var = r.bool()
  x.is_static = r.bool()
  x.static_const = r.bool()
  x.iface = r.bool()
  x.own_tparams = r.uv()
  x.declared = r.sv()
  x.sig_done = r.bool()
  x.body_eff = r.sv()
  x.moves = r.bool()
  x.move_only = r.bool()
  x.realtime = r.bool()
  x.realtime_span = r.span()
  x.ty = r.sv()
  x.done = r.bool()
  x.checking = r.bool()
  x.mutable = r.bool()
  x.is_const = r.bool()
  trees.push(r.uv())
  x.vctx = r.sv()
  x.frame = r.sv()
  x.group_frame = r.sv()
  x.awaited = r.bool()
  x.used = r.bool()
  x.let_span = r.span()
  trees.push(r.uv())
  x.constraint = r.sv()
  x.implicit = r.bool()
  x.elided = r.bool()
  x.elided_file = r.str()
  x.elided_at = r.span()
  x.elided_text = r.str()
  (x, trees)
}

fn (var w: ExW) ty(t: Ty) {
  w.uv(ty_kind_int(t.kind))
  w.sv(t.obj)
  w.ints(t.args)
  w.uv(t.vars.len())
  for v in t.vars {
    w.bool(v)
  }
  w.sv(t.result)
  w.sv(t.err)
  w.sv(t.ref)
  w.sv(t.eff)
}

fn (var r: ExR) ty() -> Ty {
  var t = Ty{kind: ty_kind_of(r.uv())}
  t.obj = r.sv()
  t.args = r.ints()
  let nv = r.uv()
  for _ in 0..nv {
    if !r.ok {
      break
    }
    t.vars.push(r.bool())
  }
  t.result = r.sv()
  t.err = r.sv()
  t.ref = r.sv()
  t.eff = r.sv()
  t
}

fn (var w: ExW) eff_item(e: EffItem) {
  w.str(e.label)
  w.sv(e.param)
  w.sv(e.evar)
  w.sv(e.fn_obj)
  w.uv(e.sub.len())
  for (k, v) in e.sub.entries() {
    w.sv(k)
    w.sv(v)
  }
  w.bool(e.has_sub)
  w.str(e.file)
  w.span(e.span)
  w.str(e.via)
}

fn (var r: ExR) eff_item() -> EffItem {
  var e = EffItem{label: r.str(), param: r.sv(), evar: r.sv(), fn_obj: r.sv()}
  let n = r.uv()
  for _ in 0..n {
    if !r.ok {
      break
    }
    let k = r.sv()
    e.sub[k] = r.sv()
  }
  e.has_sub = r.bool()
  e.file = r.str()
  e.span = r.span()
  e.via = r.str()
  e
}

/// The records as bytes.
pub fn encode_std_export(e: StdExport) -> Bytes {
  var w = ExW{b: BytesBuilder.new()}
  w.str(EXPORT_VERSION)
  let b = e.block
  for v in [b.obj_lo, b.obj_hi, b.ty_lo, b.ty_hi, b.eset_lo, b.eset_hi, b.evar_lo, b.evar_hi] {
    w.uv(v)
  }
  w.uv(e.objs.len())
  for (i, x) in e.objs.indexed() {
    w.obj(x, e.trees[i])
  }
  w.uv(e.tys.len())
  for t in e.tys {
    w.ty(t)
  }
  w.uv(e.esets.len())
  for s in e.esets {
    w.uv(s.len())
    for it in s {
      w.eff_item(it)
    }
  }
  w.ints(e.evars)
  w.uv(e.members.len())
  for (p, ms) in e.members {
    w.str(p)
    w.uv(ms.len())
    for (k, o) in ms {
      w.bytes(k)
      w.sv(o)
    }
  }
  w.uv(e.decl_objs.len())
  for (p, ds) in e.decl_objs {
    w.str(p)
    w.ints(ds)
  }
  w.uv(e.named0.len())
  for (o, t) in e.named0 {
    w.sv(o)
    w.sv(t)
  }
  w.ints(e.inferred_fns)
  w.ints(e.realtime_fns)
  for xs in [e.mod_ids, e.mod_objs, e.file_ids] {
    w.uv(xs.len())
    for (i, p) in xs {
      w.sv(i)
      w.str(p)
    }
  }
  w.uv(e.closure.len())
  for rec in e.closure {
    w.str(rec.path)
    w.str(rec.name)
    w.str(rec.dir)
    w.bool(rec.is_prelude)
    w.bool(rec.native)
    w.str(rec.implements)
    w.uv(rec.files.len())
    for fr in rec.files {
      w.str(fr.path)
      w.str(fr.iface)
      w.str(fr.sha)
      w.bool(fr.sig)
      w.bool(fr.is_test)
      w.uv(fr.imports.len())
      for (k, raw, mp) in fr.imports {
        w.str(k)
        w.str(raw)
        w.str(mp)
      }
      w.uv(fr.ranges.len())
      for dr in fr.ranges {
        w.uv(dr.start.offset)
        w.uv(dr.start.line)
        w.uv(dr.start.col)
        w.uv(dr.end)
        w.uv(dr.n)
      }
    }
  }
  w.b.freeze()
}

/// The records of d, or None when d is not an export of this version or
/// is damaged (a miss, never a wrong table).
pub fn decode_std_export(d: Bytes) -> Option[StdExport] {
  var r = ExR{d: d}
  if r.str() != EXPORT_VERSION {
    return None
  }
  var b = StdBlock{}
  b.obj_lo = r.uv()
  b.obj_hi = r.uv()
  b.ty_lo = r.uv()
  b.ty_hi = r.uv()
  b.eset_lo = r.uv()
  b.eset_hi = r.uv()
  b.evar_lo = r.uv()
  b.evar_hi = r.uv()
  var e = StdExport{block: b}
  let no = r.uv()
  for _ in 0..no {
    if !r.ok {
      return None
    }
    let (x, t) = r.obj()
    e.objs.push(x)
    e.trees.push(t)
  }
  let nt = r.uv()
  for _ in 0..nt {
    if !r.ok {
      return None
    }
    e.tys.push(r.ty())
  }
  let ne = r.uv()
  for _ in 0..ne {
    if !r.ok {
      return None
    }
    let n = r.uv()
    var s: List[EffItem] = []
    for _ in 0..n {
      if !r.ok {
        return None
      }
      s.push(r.eff_item())
    }
    e.esets.push(s)
  }
  e.evars = r.ints()
  let nm = r.uv()
  for _ in 0..nm {
    if !r.ok {
      return None
    }
    let p = r.str()
    let n = r.uv()
    var ms: List[(Bytes, Int)] = []
    for _ in 0..n {
      if !r.ok {
        return None
      }
      let k = r.bytes()
      ms.push((k, r.sv()))
    }
    e.members.push((p, ms))
  }
  let nd = r.uv()
  for _ in 0..nd {
    if !r.ok {
      return None
    }
    let p = r.str()
    e.decl_objs.push((p, r.ints()))
  }
  let nn = r.uv()
  for _ in 0..nn {
    if !r.ok {
      return None
    }
    let o = r.sv()
    e.named0.push((o, r.sv()))
  }
  e.inferred_fns = r.ints()
  e.realtime_fns = r.ints()
  var maps: List[List[(Int, Str)]] = []
  for _ in 0..3 {
    let n = r.uv()
    var xs: List[(Int, Str)] = []
    for _ in 0..n {
      if !r.ok {
        return None
      }
      let i = r.sv()
      xs.push((i, r.str()))
    }
    maps.push(xs)
  }
  if maps.len() == 3 {
    e.mod_ids = maps[0]
    e.mod_objs = maps[1]
    e.file_ids = maps[2]
  }
  let ncl = r.uv()
  for _ in 0..ncl {
    if !r.ok {
      return None
    }
    var rec = StdModRec{path: r.str(), name: r.str(), dir: r.str()}
    rec.is_prelude = r.bool()
    rec.native = r.bool()
    rec.implements = r.str()
    let nf = r.uv()
    for _ in 0..nf {
      if !r.ok {
        return None
      }
      var fr = StdFileRec{path: r.str(), iface: r.str(), sha: r.str()}
      fr.sig = r.bool()
      fr.is_test = r.bool()
      let ni = r.uv()
      for _ in 0..ni {
        if !r.ok {
          return None
        }
        let k = r.str()
        let raw = r.str()
        let mp = r.str()
        fr.imports.push((k, raw, mp))
      }
      let nr = r.uv()
      for _ in 0..nr {
        if !r.ok {
          return None
        }
        let so = r.uv()
        let sl = r.uv()
        let sc = r.uv()
        let end = r.uv()
        let n = r.uv()
        fr.ranges.push(parser.DeclRange{start: parser.Pos{offset: so, line: sl, col: sc}, end: end, n: n})
      }
      rec.files.push(fr)
    }
    e.closure.push(rec)
  }
  if !r.ok || r.at != d.len() || e.objs.len() != b.obj_hi - b.obj_lo || e.tys.len() != b.ty_hi - b.ty_lo {
    return None
  }
  Some(e)
}

// ---------------------------------------------------------------------------
// Relocation: the records renumbered for another checker, whose std block
// starts where its tables end now and whose modules and files are found
// by path.

/// The index maps of a relocation.
struct Reloc {
  b: StdBlock
  d_obj: Int
  d_ty: Int
  d_eset: Int
  d_evar: Int
  objs: Map[Int, Int] = {}
  mods: Map[Int, Int] = {}
  files: Map[Int, Int] = {}
  ok: Bool = true
}

fn (var r: Reloc) obj(o: Int) -> Int {
  if o < 0 {
    return o
  }
  if o >= r.b.obj_lo && o < r.b.obj_hi {
    return o + r.d_obj
  }
  match r.objs.get(o) {
    Some(n) => n
    None => {
      r.ok = false
      o
    }
  }
}

/// A type outside the block is one of the checker's first two, unit and
/// `<error>` (new_checker), the same in every checker.
fn (var r: Reloc) ty(t: Int) -> Int {
  if t < 0 {
    return t
  }
  if t >= r.b.ty_lo && t < r.b.ty_hi {
    return t + r.d_ty
  }
  if t > 1 {
    r.ok = false
  }
  t
}

fn (var r: Reloc) eset(s: Int) -> Int {
  if s >= r.b.eset_lo && s < r.b.eset_hi {
    return s + r.d_eset
  }
  if s >= 0 {
    r.ok = false
  }
  s
}

fn (var r: Reloc) evar(v: Int) -> Int {
  if v >= r.b.evar_lo && v < r.b.evar_hi {
    return v + r.d_evar
  }
  if v >= 0 {
    r.ok = false
  }
  v
}

fn (var r: Reloc) idx(m: Map[Int, Int], i: Int) -> Int {
  if i < 0 {
    return i
  }
  match m.get(i) {
    Some(n) => n
    None => {
      r.ok = false
      i
    }
  }
}

fn (var r: Reloc) objs_of(xs: List[Int]) -> List[Int] {
  var out = List[Int].with_capacity(xs.len())
  for x in xs {
    out.push(r.obj(x))
  }
  out
}

fn (var r: Reloc) tys_of(xs: List[Int]) -> List[Int] {
  var out = List[Int].with_capacity(xs.len())
  for x in xs {
    out.push(r.ty(x))
  }
  out
}

fn (var r: Reloc) eff_item(e: EffItem) -> EffItem {
  var x = e
  x.param = r.obj(e.param)
  x.evar = r.evar(e.evar)
  x.fn_obj = r.obj(e.fn_obj)
  var sub: Map[Int, Int] = {}
  for (k, v) in e.sub.entries() {
    sub[r.obj(k)] = r.ty(v)
  }
  x.sub = sub
  x
}

fn (var r: Reloc) obj_rec(x0: Obj) -> Obj {
  var x = x0
  x.module = r.idx(r.mods, x0.module)
  x.tparams = r.objs_of(x0.tparams)
  var fs: List[FieldInfo] = []
  for f in x0.fields {
    var g = f
    g.ty = r.ty(f.ty)
    fs.push(g)
  }
  x.fields = fs
  var vs: List[VariantInfo] = []
  for v in x0.variants {
    var w = v
    var vfs: List[VFieldInfo] = []
    for vf in v.fields {
      var g = vf
      g.ty = r.ty(vf.ty)
      vfs.push(g)
    }
    w.fields = vfs
    vs.push(w)
  }
  x.variants = vs
  x.iface_meths = r.objs_of(x0.iface_meths)
  x.target = r.ty(x0.target)
  var ms: Map[Bytes, Int] = {}
  for (k, f) in x0.methods.entries() {
    ms[k] = r.obj(f)
  }
  x.methods = ms
  var ss: Map[Bytes, Int] = {}
  for (k, f) in x0.statics.entries() {
    ss[k] = r.obj(f)
  }
  x.statics = ss
  x.decl_file = r.idx(r.files, x0.decl_file)
  var ps: List[ParamInfo] = []
  for p in x0.params {
    var g = p
    g.ty = r.ty(p.ty)
    ps.push(g)
  }
  x.params = ps
  x.result = r.ty(x0.result)
  x.err = r.ty(x0.err)
  x.recv = r.obj(x0.recv)
  x.recv_ty = r.ty(x0.recv_ty)
  x.declared = r.eset(x0.declared)
  x.body_eff = r.eset(x0.body_eff)
  x.ty = r.ty(x0.ty)
  x.constraint = r.ty(x0.constraint)
  x
}

fn (var r: Reloc) ty_rec(t0: Ty) -> Ty {
  var t = t0
  t.obj = r.obj(t0.obj)
  t.args = r.tys_of(t0.args)
  t.result = r.ty(t0.result)
  t.err = r.ty(t0.err)
  t.ref = r.ty(t0.ref)
  t.eff = r.eset(t0.eff)
  t
}

/// e renumbered for c, whose std block starts at at's lows (the ends of
/// its tables when the std phases would run) and whose std modules and
/// files are already loaded; None when a module or file e names is not
/// loaded in c, or a record refers outside what relocation knows (then
/// the records cannot serve c).
pub fn (c: Checker) relocate_export(e: StdExport, at: StdBlock) -> Option[StdExport] {
  let b = e.block
  var r = Reloc{b: b, d_obj: at.obj_lo - b.obj_lo, d_ty: at.ty_lo - b.ty_lo, d_eset: at.eset_lo - b.eset_lo, d_evar: at.evar_lo - b.evar_lo}
  for (i, p) in e.mod_ids {
    match c.mod_index.get(p) {
      Some(m) => {
        r.mods[i] = m
      }
      None => return None
    }
  }
  for (o, p) in e.mod_objs {
    match c.mod_index.get(p) {
      Some(m) => {
        r.objs[o] = c.mods[m].obj
      }
      None => return None
    }
  }
  var fpath: Map[Str, Int] = {}
  for (f, sf) in c.files.indexed() {
    fpath[sf.path] = f
  }
  for (f, p) in e.file_ids {
    match fpath.get(p) {
      Some(n) => {
        r.files[f] = n
      }
      None => return None
    }
  }
  var out = StdExport{block: StdBlock{obj_lo: at.obj_lo, obj_hi: at.obj_lo + (b.obj_hi - b.obj_lo), ty_lo: at.ty_lo, ty_hi: at.ty_lo + (b.ty_hi - b.ty_lo), eset_lo: at.eset_lo, eset_hi: at.eset_lo + (b.eset_hi - b.eset_lo), evar_lo: at.evar_lo, evar_hi: at.evar_lo + (b.evar_hi - b.evar_lo)}, trees: e.trees}
  for x in e.objs {
    out.objs.push(r.obj_rec(x))
  }
  for t in e.tys {
    out.tys.push(r.ty_rec(t))
  }
  for s in e.esets {
    var items: List[EffItem] = []
    for it in s {
      items.push(r.eff_item(it))
    }
    out.esets.push(items)
  }
  for v in e.evars {
    out.evars.push(r.eset(v))
  }
  for (p, ms) in e.members {
    var ns: List[(Bytes, Int)] = []
    for (k, o) in ms {
      ns.push((k, r.obj(o)))
    }
    out.members.push((p, ns))
  }
  for (p, ds) in e.decl_objs {
    out.decl_objs.push((p, r.objs_of(ds)))
  }
  for (o, t) in e.named0 {
    out.named0.push((r.obj(o), r.ty(t)))
  }
  out.inferred_fns = r.objs_of(e.inferred_fns)
  out.realtime_fns = r.objs_of(e.realtime_fns)
  for (i, p) in e.mod_ids {
    out.mod_ids.push((r.idx(r.mods, i), p))
  }
  for (o, p) in e.mod_objs {
    out.mod_objs.push((r.obj(o), p))
  }
  for (f, p) in e.file_ids {
    out.file_ids.push((r.idx(r.files, f), p))
  }
  out.closure = e.closure
  if !r.ok {
    return None
  }
  Some(out)
}

// ---------------------------------------------------------------------------
// Installing: the records in place of the std phases, their trees joined
// from the files' parses.

/// What the std block is declared from: the flags the loader and the std
/// phases read and each std module's files with their contents' digests,
/// in order; records serve a checker only with the same fingerprint.
pub fn (c: Checker) std_fingerprint(std_mods: List[Int]) -> Str {
  var h = BytesBuilder.new()
  h.write_str("${EXPORT_VERSION}\n${c.native} ${c.lazy} ${c.lazy_parse} ${c.decls_only} ${c.skip_tests} ${c.std_test} ${c.runtime_files} ${c.llrt_c.join(",")} ${c.body_words.join(",")}\n")
  for m in std_mods {
    h.write_str("${c.mods[m].path}\n")
    for f in c.mods[m].files {
      h.write_str("${c.files[f].path} ${c.files[f].src.len()} ")
      h.write(crypto.sha256(c.files[f].src))
      h.write_str("\n")
    }
  }
  crypto.sha256(h.freeze()).to_hex()
}

/// The top level declaration i of file f, if the file has one there:
/// from its tree, or, for a record file still unloaded, the declaration
/// ensure_decl parsed alone (decision 0428).
pub fn (c: Checker) top_decl(f: Int, i: Int) -> Option[parser.Decl] {
  if f < 0 || f >= c.files.len() || i < 0 {
    return None
  }
  if c.files[f].unloaded {
    return c.decl_parsed.get(f)?.get(i)
  }
  if i >= c.files[f].ast.decls.len() {
    return None
  }
  Some(c.files[f].ast.decls[i])
}


/// x with its trees (counted in t) joined from the parses of c's files:
/// a function's declaration (an interface method's from its interface,
/// whose record is ty_rec), parameters' and fields' defaults; None when one
/// is not where the record says.
fn (c: Checker) join_trees(x0: Obj, t: List[Int], owner: Option[Obj]) -> Option[Obj] {
  var x = x0
  var ti = 0
  if !x.fields.is_empty() {
    var sfields: List[parser.Field] = []
    if let Some(d) = c.top_decl(x.decl_file, x.decl_idx) {
      match d {
        StructDecl(d: sd) => {
          sfields = sd.fields
        }
        _ => {}
      }
    }
    var fs: List[FieldInfo] = []
    for f in x.fields {
      var g = f
      if t[ti] > 0 {
        var found = false
        for fl in sfields {
          if fl.name.name == f.name {
            if let Some(e) = fl.default {
              g.default = [e]
              found = true
            }
            break
          }
        }
        if !found {
          return None
        }
      }
      ti += 1
      fs.push(g)
    }
    x.fields = fs
  }
  if t[ti] > 0 {
    var fd: Option[parser.FnDecl] = None
    if x.iface {
      if let Some(ow) = owner {
        if let Some(d) = c.top_decl(ow.decl_file, ow.decl_idx) {
          match d {
            InterfaceDecl(d: id) => {
              for md in id.methods {
                if md.name.name == x.name && md.name.span.start.line == x.line && md.name.span.start.col == x.col {
                  fd = Some(md)
                  break
                }
              }
            }
            _ => {}
          }
        }
      }
    } else if let Some(d) = c.top_decl(x.decl_file, x.decl_idx) {
      match d {
        FnDecl(d: f) => {
          if f.name.name == x.name {
            fd = Some(f)
          }
        }
        _ => {}
      }
    }
    match fd {
      Some(f) => {
        x.fn_decl = [f]
      }
      None => return None
    }
  }
  ti += 1
  var ps: List[ParamInfo] = []
  for p in x.params {
    var g = p
    if t[ti] > 0 {
      var found = false
      if !x.fn_decl.is_empty() {
        for q in x.fn_decl[0].params {
          if q.name.name == p.name {
            if let Some(e) = q.default {
              g.default = [e]
              found = true
            }
            break
          }
        }
      }
      if !found {
        return None
      }
    }
    ti += 1
    ps.push(g)
  }
  x.params = ps
  // a constant's or let's value: only locals have them, never std's block
  if t[ti] > 0 || t[ti + 1] > 0 {
    return None
  }
  Some(x)
}

/// Installs e, relocated for c (its block starting at the ends of c's
/// tables), in place of the std phases: true when it did; false, with
/// nothing changed, when a tree cannot be joined.
pub fn (var c: Checker) install_std(e: StdExport) -> Bool {
  let lo = e.block.obj_lo
  var objs: List[Obj] = []
  var pending: List[(Int, List[Int], Int)] = []
  for (i, x) in e.objs.indexed() {
    // an object of a file not parsed (trees_lazy): installed without
    // its trees, its counts kept for need_tree; an interface's method
    // (no file of its own) by its interface's file
    var tf = x.decl_file
    if x.iface && x.recv >= lo && x.recv - lo < e.objs.len() {
      tf = e.objs[x.recv - lo].decl_file
    }
    if c.trees_lazy && tf >= 0 && tf < c.files.len() && c.files[tf].unloaded {
      var has = false
      for t in e.trees[i] {
        if t > 0 {
          has = true
        }
      }
      if has {
        pending.push((lo + i, e.trees[i], if x.iface { x.recv } else { -1 }))
      }
      objs.push(x)
      continue
    }
    let owner = if x.iface && x.recv >= lo && x.recv - lo < e.objs.len() { Some(e.objs[x.recv - lo]) } else { None }
    match c.join_trees(x, e.trees[i], owner) {
      Some(y) => objs.push(y)
      None => {
        let fp = if x.decl_file >= 0 && x.decl_file < c.files.len() { "${c.files[x.decl_file].path} unloaded=${c.files[x.decl_file].unloaded}" } else { "file ${x.decl_file}" }
        c.std_export_why = "the trees of ${text(x.name)} (${fp}, counts ${e.trees[i].len()}) are not where the record says"
        return false
      }
    }
  }
  for (o, t, recv) in pending {
    c.tree_pending[o] = (t, recv)
  }
  var fpath: Map[Str, Int] = {}
  for (f, sf) in c.files.indexed() {
    fpath[sf.path] = f
  }
  for o in objs {
    c.objs.push(o)
  }
  for t in e.tys {
    c.tys.push(t)
  }
  for s in e.esets {
    c.esets.push(s)
  }
  for v in e.evars {
    c.evars.push(v)
  }
  for (p, ms) in e.members {
    if let Some(m) = c.mod_index.get(p) {
      var mm: Map[Bytes, Int] = {}
      for (k, o) in ms {
        mm[k] = o
      }
      c.mods[m].members = mm
    }
  }
  for (p, ds) in e.decl_objs {
    if let Some(f) = fpath.get(p) {
      c.files[f].decl_objs = ds
    }
  }
  for (o, t) in e.named0 {
    c.named0[o] = t
  }
  for f in e.inferred_fns {
    c.inferred_fns.push(f)
  }
  for f in e.realtime_fns {
    c.realtime_fns.push(f)
  }
  c.std_block = e.block
  true
}

/// What std the records were declared from (decision 0388 stage 2,
/// piece 2): the fingerprint of its sources, and the stamps of its files
/// and directories, so a loader can tell the records still describe the
/// std tree without reading or hashing a file (header_holds).
pub struct StdHeader {
  pub fp: Str
  pub files: List[FileStamp] = []
  pub dirs: List[DirStamp] = []
}

const ENTRY_VERSION = "xo std entry v2 (header: fingerprint, file and directory stamps)"

/// The trees of object o joined when install_std left them pending
/// (trees_lazy): its file parsed (ensure_tree), its owner's too, and the
/// object replaced by its joined self. Nothing for an object with its
/// trees already.
pub fn (var c: Checker) need_tree(o: Int) uses fs.read {
  if o < 0 || o >= c.objs.len() {
    return
  }
  let f = c.objs[o].decl_file
  // the file's tree first (a constant's initializer is read from the
  // tree itself, with no joined part to count)
  if f >= 0 && f < c.files.len() && c.files[f].unloaded {
    c.ensure_decl(f, c.objs[o].decl_idx)
  }
  let (t, recv) = match c.tree_pending.get(o) {
    Some(p) => p
    None => return
  }
  c.tree_pending.remove(o)
  var owner: Option[Obj] = None
  if recv >= 0 && recv < c.objs.len() {
    let rf = c.objs[recv].decl_file
    if rf >= 0 && rf < c.files.len() {
      c.ensure_decl(rf, c.objs[recv].decl_idx)
    }
    owner = Some(c.objs[recv])
  }
  match c.join_trees(c.objs[o], t, owner) {
    Some(y) => c.objs[o] = y
    None => fault("internal: the trees of ${text(c.objs[o].name)} are not where std's record says (${if f >= 0 && f < c.files.len() { c.files[f].path } else { "an interface's method" }})")
  }
  // a body joined after check_module ran over its (then empty) file:
  // marked for the lazy check as check_module would have, so the SSA
  // builder's check_lazy checks it before lowering it
  if !c.objs[o].fn_decl.is_empty() && c.objs[o].module >= 0 && c.lazy_mod(c.objs[o].module) && !c.lazy_fns.contains(o) {
    c.lazy_fns[o] = true
    c.check_fn_defaults(o)
  }
}

/// The type of std's native module that implements std type o (the
/// member of the same name, as ssa impl_type finds it), or -1.
fn (c: Checker) native_twin(o: Int) -> Int {
  let om = c.objs[o].module
  if om < 0 || !c.mods[om].is_std {
    return -1
  }
  for m in c.order {
    if c.mods[m].native && c.mods[m].implements == c.mods[om].path {
      let t = c.mods[m].members.get(c.objs[o].name) ?? -1
      return if t >= 0 && c.objs[t].kind == ObjKind.Type { t } else { -1 }
    }
  }
  -1
}

/// Every std tree joined (the SSA builder's fallback, build_program_fe):
/// each record module's files parsed and each pending object joined.
pub fn (var c: Checker) join_all_trees() uses fs.read {
  for m in 0..c.mods.len() {
    c.ensure_tree(m)
  }
  var pending: List[Int] = []
  for (o, _) in c.tree_pending {
    pending.push(o)
  }
  for o in pending.sort() {
    c.need_tree(o)
  }
}

/// A cache entry: the header, then the records.
pub fn encode_std_entry(h: StdHeader, e: StdExport) -> Bytes {
  var w = ExW{b: BytesBuilder.new()}
  w.str(ENTRY_VERSION)
  w.str(h.fp)
  w.uv(h.files.len())
  for st in h.files {
    w.str(st.path)
    w.uv(st.size)
    w.uv(st.mtime)
    w.str(st.sha)
  }
  w.uv(h.dirs.len())
  for ds in h.dirs {
    w.str(ds.path)
    w.uv(ds.mtime)
    w.uv(ds.names.len())
    for n in ds.names {
      w.str(n)
    }
  }
  w.b.write(encode_std_export(e))
  w.b.freeze()
}

/// The header of entry d and where the records start; None for an entry
/// of another version.
pub fn decode_std_header(d: Bytes) -> Option[(StdHeader, Int)] {
  if d.is_empty() {
    return None
  }
  var r = ExR{d: d}
  if r.str() != ENTRY_VERSION || !r.ok {
    return None
  }
  var h = StdHeader{fp: r.str()}
  let nf = r.uv()
  for _ in 0..nf {
    if !r.ok {
      return None
    }
    let path = r.str()
    let size = r.uv()
    let mtime = r.uv()
    let sha = r.str()
    h.files.push(FileStamp{path: path, size: size, mtime: mtime, sha: sha})
  }
  let nd = r.uv()
  for _ in 0..nd {
    if !r.ok {
      return None
    }
    let path = r.str()
    let mtime = r.uv()
    let nn = r.uv()
    var names: List[Str] = []
    for _ in 0..nn {
      names.push(r.str())
    }
    h.dirs.push(DirStamp{path: path, mtime: mtime, names: names})
  }
  if !r.ok {
    return None
  }
  Some((h, r.at))
}

/// The path of the recording run's file id f (file_ids), None when it
/// is not a std file of the record.
pub fn (e: StdExport) file_index(f: Int) -> Option[Str] {
  for (i, p) in e.file_ids {
    if i == f {
      return Some(p)
    }
  }
  None
}

/// The index of the file at path p, None when the checker has none.
pub fn (c: Checker) file_by_path(p: Str) -> Option[Int] {
  for (i, sf) in c.files.indexed() {
    if sf.path == p {
      return Some(i)
    }
  }
  None
}

/// The records of entry d when its fingerprint is fp (the loader's,
/// load_std_record).
pub fn decode_std_record(d: Bytes, fp: Str) -> Option[StdExport] { decode_std_entry(d, fp) }

/// The records of entry d when its fingerprint is fp.
fn decode_std_entry(d: Bytes, fp: Str) -> Option[StdExport] {
  match decode_std_header(d) {
    Some((h, at)) => {
      if h.fp != fp {
        return None
      }
      decode_std_export(d[at..])
    }
    None => None
  }
}

/// The header of the records declared from std_mods, fingerprint fp, at
/// now (milliseconds since 1970): every std file's stamp and every
/// directory's; a header with no files (a file or directory that could
/// not be stamped) never holds.
pub fn (c: Checker) std_header(std_mods: List[Int], fp: Str, now: Int) -> StdHeader uses fs.read {
  var paths: List[Str] = []
  var srcs: List[Bytes] = []
  var dirs: Map[Str, Bool] = {}
  for m in std_mods {
    for f in c.mods[m].files {
      if c.files[f].generated {
        continue
      }
      let p = c.source_path(c.files[f].path)
      paths.push(p)
      srcs.push(c.files[f].src)
      dirs[parent_dir(p)] = true
    }
  }
  // a header that never holds: the next build takes the full path
  let none = StdHeader{fp: fp}
  var files = match stamp_files(c.fs, paths, now) {
    Some(st) => st
    None => return none
  }
  // a file or directory changed after the build started (now) may not
  // be what the records were declared from (a std edit during the
  // declaring build): no header; and a hash kept for a file inside the
  // settle window is the hash of the bytes the checker parsed, not of a
  // fresh read, so a mid-build edit fails the next build's stamps
  for (i, st) in files.indexed() {
    if st.mtime > now {
      return none
    }
    if !st.sha.is_empty() {
      files[i].sha = crypto.sha256(srcs[i]).to_hex()
    }
  }
  let ds = match stamp_dirs(c.fs, dirs.keys().sort(), now) {
    Some(st) => st
    None => return none
  }
  for st in ds {
    if st.mtime > now {
      return none
    }
  }
  StdHeader{fp: fp, files: files, dirs: ds}
}

/// Whether the std tree is as header h stamped it: every file and
/// directory holds (stamps_hold, dir_stamps_hold).
pub fn header_holds(fs: Fs, h: StdHeader) -> Bool uses fs.read {
  !h.files.is_empty() && stamps_hold(fs, h.files) && dir_stamps_hold(fs, h.dirs)
}

/// XO_STD_EXPORT=verify: "" when the entry in std_export_in (if its
/// fingerprint is fp) relocates to at and joins its trees to exactly
/// mine, the records this checker declared; else how it differs.
fn (c: Checker) verify_std_entry(fp: Str, at: StdBlock, mine: StdExport) -> Str {
  let e = match decode_std_entry(c.std_export_in, fp) {
    Some(x) => x
    None => return ""
  }
  let r = match c.relocate_export(e, at) {
    Some(x) => x
    None => return "the records do not relocate"
  }
  if encode_std_export(r) != encode_std_export(mine) {
    return export_diff(r, mine)
  }
  let lo = r.block.obj_lo
  for (i, x) in r.objs.indexed() {
    let owner = if x.iface && x.recv >= lo && x.recv - lo < r.objs.len() { Some(r.objs[x.recv - lo]) } else { None }
    match c.join_trees(x, r.trees[i], owner) {
      Some(y) => {
        let z = c.objs[lo + i]
        if y.fn_decl.len() != z.fn_decl.len() || (!y.fn_decl.is_empty() && y.fn_decl[0].span != z.fn_decl[0].span) {
          return "object ${lo + i} (${text(z.name)}): its declaration joins elsewhere"
        }
        for (j, p) in y.params.indexed() {
          if p.default.len() != z.params[j].default.len() {
            return "object ${lo + i} (${text(z.name)}): parameter ${j}'s default"
          }
        }
        for (j, f) in y.fields.indexed() {
          if f.default.len() != z.fields[j].default.len() {
            return "object ${lo + i} (${text(z.name)}): field ${j}'s default"
          }
        }
      }
      None => return "object ${lo + i} (${text(x.name)}): a tree does not join"
    }
  }
  ""
}

/// Where two exports first differ (XO_STD_EXPORT=verify's message).
fn export_diff(a: StdExport, b: StdExport) -> Str {
  if a.objs.len() != b.objs.len() || a.tys.len() != b.tys.len() || a.esets.len() != b.esets.len() || a.evars.len() != b.evars.len() {
    return "the blocks' sizes differ: objects ${a.objs.len()} and ${b.objs.len()}, types ${a.tys.len()} and ${b.tys.len()}, effect sets ${a.esets.len()} and ${b.esets.len()}, effect variables ${a.evars.len()} and ${b.evars.len()}"
  }
  for (i, x) in a.objs.indexed() {
    var wa = ExW{b: BytesBuilder.new()}
    wa.obj(x, a.trees[i])
    var wb = ExW{b: BytesBuilder.new()}
    wb.obj(b.objs[i], b.trees[i])
    if wa.b.freeze() != wb.b.freeze() {
      return "object ${a.block.obj_lo + i} (${text(x.name)}, ${x.file}:${x.line}) differs"
    }
  }
  for (i, t) in a.tys.indexed() {
    var wa = ExW{b: BytesBuilder.new()}
    wa.ty(t)
    var wb = ExW{b: BytesBuilder.new()}
    wb.ty(b.tys[i])
    if wa.b.freeze() != wb.b.freeze() {
      return "type ${a.block.ty_lo + i} differs (kind ${ty_kind_int(t.kind)} and ${ty_kind_int(b.tys[i].kind)}, object ${t.obj} and ${b.tys[i].obj})"
    }
  }
  for (i, s) in a.esets.indexed() {
    if s.len() != b.esets[i].len() {
      return "effect set ${a.block.eset_lo + i} differs in size"
    }
  }
  if a.evars != b.evars {
    return "the effect variables differ"
  }
  if a.members.len() != b.members.len() || a.decl_objs.len() != b.decl_objs.len() {
    return "the modules or files listed differ"
  }
  for (i, (p, ms)) in a.members.indexed() {
    let (q, ns) = b.members[i]
    if p != q || ms.len() != ns.len() {
      var ka: List[Str] = []
      for (k, _) in ms {
        ka.push(text(k))
      }
      var kb: List[Str] = []
      for (k, _) in ns {
        kb.push(text(k))
      }
      let only_a = ka.filter(fn(k) { !kb.contains(k) })
      let only_b = kb.filter(fn(k) { !ka.contains(k) })
      return "module ${p}'s members differ: ${ms.len()} and ${ns.len()}; only in the records: ${only_a.join(" ")}; only declared: ${only_b.join(" ")}"
    }
  }
  if a.named0 != b.named0 {
    return "the named types differ"
  }
  if a.inferred_fns != b.inferred_fns || a.realtime_fns != b.realtime_fns {
    return "the inferred or realtime functions differ"
  }
  "the records differ in their module, file or Module object maps"
}

// ---------------------------------------------------------------------------
// Std's files by their stat (decision 0388 stage 2, piece 2): a build that
// does not read std's sources still knows they are the ones the records
// were made from. Go's file hash cache rule: a file's size and modification
// time stand for its content only when it was last modified more than two
// seconds before they were recorded (an edit within the clock's grain
// keeps both); a younger file's content hash is recorded and checked.

/// One file as the records saw it.
pub struct FileStamp {
  pub path: Str
  pub size: Int
  /// its modification time, milliseconds since 1970
  pub mtime: Int
  /// the SHA-256 of its content, kept only when it was not settled
  pub sha: Str = ""
}

/// The settling window of Go's rule, in milliseconds.
const STAMP_SETTLE_MS = 2000

/// The stamps of paths at now (milliseconds since 1970): each file's size
/// and time, and for one modified within STAMP_SETTLE_MS of now its
/// content's hash; None when a file cannot be read.
pub fn stamp_files(fs: Fs, paths: List[Str], now: Int) -> Option[List[FileStamp]] uses fs.read {
  var out: List[FileStamp] = []
  for p in paths {
    let info = match fs.stat(p) {
      Ok(Some(i)) => i
      _ => return None
    }
    var st = FileStamp{path: p, size: info.size, mtime: info.modified.unix_millis()}
    if now - st.mtime <= STAMP_SETTLE_MS {
      match fs.read(p) {
        Ok(b) => {
          st.sha = crypto.sha256(b).to_hex()
        }
        Err(_) => return None
      }
    }
    out.push(st)
  }
  Some(out)
}

/// A directory as the records saw it (decision 0388 stage 2, piece 2):
/// its modification time (a file added or removed changes it), and for
/// one modified within STAMP_SETTLE_MS of now its .xo entries' names,
/// sorted, which dir_stamps_hold compares by read_dir. Every directory
/// is stamped on its own: a subdirectory's change leaves its parent's
/// time alone.
pub struct DirStamp {
  pub path: Str
  pub mtime: Int
  pub names: List[Str] = []
}

/// The .xo entries of directory p, sorted.
fn xo_names(fs: Fs, p: Str) -> Option[List[Str]] uses fs.read {
  match fs.read_dir(p) {
    Ok(fis) => {
      var names: List[Str] = []
      for fi in fis {
        if !fi.is_dir && fi.name.ends_with(".xo") {
          names.push(fi.name)
        }
      }
      Some(names.sort())
    }
    Err(_) => None
  }
}

/// The stamps of directories paths at now: each one's time and, for one
/// not settled, its .xo names; None when one cannot be read.
pub fn stamp_dirs(fs: Fs, paths: List[Str], now: Int) -> Option[List[DirStamp]] uses fs.read {
  var out: List[DirStamp] = []
  for p in paths {
    let info = match fs.stat(p) {
      Ok(Some(i)) => i
      _ => return None
    }
    var st = DirStamp{path: p, mtime: info.modified.unix_millis()}
    if now - st.mtime <= STAMP_SETTLE_MS {
      match xo_names(fs, p) {
        Some(ns) => st.names = ns
        None => return None
      }
    }
    out.push(st)
  }
  Some(out)
}

/// Whether every directory is still as stamped: the same time and, for
/// a stamp with names, the same .xo entries.
pub fn dir_stamps_hold(fs: Fs, stamps: List[DirStamp]) -> Bool uses fs.read {
  for st in stamps {
    let info = match fs.stat(st.path) {
      Ok(Some(i)) => i
      _ => return false
    }
    if info.modified.unix_millis() != st.mtime {
      return false
    }
    if !st.names.is_empty() {
      match xo_names(fs, st.path) {
        Some(ns) => {
          if ns != st.names {
            return false
          }
        }
        None => return false
      }
    }
  }
  true
}

/// Whether every file is still as stamped: the same size and time and,
/// for a stamp with a hash, the same content.
pub fn stamps_hold(fs: Fs, stamps: List[FileStamp]) -> Bool uses fs.read {
  for st in stamps {
    let info = match fs.stat(st.path) {
      Ok(Some(i)) => i
      _ => return false
    }
    if info.size != st.size || info.modified.unix_millis() != st.mtime {
      return false
    }
    if !st.sha.is_empty() {
      match fs.read(st.path) {
        Ok(b) => {
          if crypto.sha256(b).to_hex() != st.sha {
            return false
          }
        }
        Err(_) => return false
      }
    }
  }
  true
}
