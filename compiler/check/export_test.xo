// The std export's codec (decision 0388 stage 1a-ii).

/// A checker over a one-file program and the test's small prelude.
fn export_checker(os: testing.TestOs) -> Checker ! FsErr {
  let _out = check_files(os, "app", [("app/main.xo", "fn main() {\n  print(\"hi\")\n}\n")])?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["app"]) {
    expect(e) == ""
  }
  Ok(c)
}

test "the std block's records encode, decode and encode again to the same bytes" {
  let c = export_checker(os)?
  let b = c.std_block
  expect(b.obj_hi > b.obj_lo) == true
  let d = encode_std_export(c.std_export())
  match decode_std_export(d) {
    Some(e2) => {
      expect(e2.objs.len()) == b.obj_hi - b.obj_lo
      expect(encode_std_export(e2) == d) == true
    }
    None => expect("decoded") == "None"
  }
}

test "a damaged or truncated export decodes to None" {
  let c = export_checker(os)?
  let d = encode_std_export(c.std_export())
  expect(decode_std_export(d[0..d.len() - 1]).is_none()) == true
  expect(decode_std_export(b"xo std export v0").is_none()) == true
  expect(decode_std_export(d + b"x").is_none()) == true
}

test "records exported by one program, relocated, equal another program's own" {
  let a = export_checker(os)?
  // a second root module: one more Module object before the std block
  os.fs.create_dir_all("lib")?
  os.fs.write("lib/lib.xo", b"fn helper() -> Int {\n  1\n}\n")?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["app", "lib"]) {
    expect(e) == ""
  }
  expect(c.std_block.obj_lo != a.std_block.obj_lo) == true
  match c.relocate_export(a.std_export(), c.std_block) {
    Some(e) => expect(encode_std_export(e) == encode_std_export(c.std_export())) == true
    None => expect("relocated") == "None"
  }
}

test "the records hold std's module closure: each std module's files and imports" {
  let c = export_checker(os)?
  let e = c.std_export()
  expect(e.closure.len() > 0) == true
  let r0 = e.closure[0]
  expect(r0.path.is_empty()) == false
  expect(r0.files.len() > 0) == true
  expect(r0.files[0].sha.len()) == 64
  match decode_std_export(encode_std_export(e)) {
    Some(e2) => expect(e2.closure.len()) == e.closure.len()
    None => expect("decoded") == "None"
  }
}

test "a std file edited within the clock's grain, its size kept, is seen" {
  os.fs.create_dir_all("std")?
  os.fs.write("std/a.xo", b"fn a() -> Int { 1 }\n")?
  let info = (os.fs.stat("std/a.xo")? ?? FileInfo{name: "", path: "", is_dir: false, size: 0, modified: Time.UNIX_EPOCH})
  // stamped at once: the file is not settled, so its content is hashed
  let now = info.modified.unix_millis()
  match stamp_files(os.fs, ["std/a.xo"], now) {
    Some(st) => {
      expect(st[0].sha.is_empty()) == false
      expect(stamps_hold(os.fs, st)) == true
      // the same size, the same second
      os.fs.write("std/a.xo", b"fn a() -> Int { 2 }\n")?
      expect(stamps_hold(os.fs, st)) == false
    }
    None => expect("stamped") == "None"
  }
}

test "a settled std file is trusted by its size and time" {
  os.fs.create_dir_all("std")?
  os.fs.write("std/b.xo", b"fn b() -> Int { 1 }\n")?
  let info = (os.fs.stat("std/b.xo")? ?? FileInfo{name: "", path: "", is_dir: false, size: 0, modified: Time.UNIX_EPOCH})
  match stamp_files(os.fs, ["std/b.xo"], info.modified.unix_millis() + 10000) {
    Some(st) => {
      expect(st[0].sha.is_empty()) == true
      expect(stamps_hold(os.fs, st)) == true
    }
    None => expect("stamped") == "None"
  }
}

test "an entry's header round trips and holds until a std file, directory or name changes" {
  os.fs.create_dir_all("std/sub")?
  os.fs.write("std/c.xo", b"fn c() -> Int { 1 }\n")?
  os.fs.write("std/sub/d.xo", b"fn d() -> Int { 1 }\n")?
  let info = (os.fs.stat("std/c.xo")? ?? FileInfo{name: "", path: "", is_dir: false, size: 0, modified: Time.UNIX_EPOCH})
  // settled: 10 s after the writes, so the stamps are sizes and times alone
  let now = info.modified.unix_millis() + 10000
  let files = stamp_files(os.fs, ["std/c.xo", "std/sub/d.xo"], now) ?? []
  let dirs = stamp_dirs(os.fs, ["std", "std/sub"], now) ?? []
  expect(files.len()) == 2
  expect(dirs.len()) == 2
  expect(dirs[0].names.is_empty()) == true
  let h = StdHeader{fp: "fp1", files: files, dirs: dirs}
  let d = encode_std_entry(h, StdExport{block: StdBlock{}})
  match decode_std_header(d) {
    Some((h2, at)) => {
      expect(h2.fp) == "fp1"
      expect(h2.files.len()) == 2
      expect(h2.dirs.len()) == 2
      expect(h2.dirs[1].path) == "std/sub"
      expect(at > 0) == true
      expect(header_holds(os.fs, h2)) == true
      // a file's size changed: seen by its stamp
      os.fs.write("std/sub/d.xo", b"fn d() -> Int { 10 }\n")?
      expect(header_holds(os.fs, h2)) == false
    }
    None => expect("decoded") == "None"
  }
  // an entry of another version has no header
  expect(decode_std_header(b"xo std entry v1\n") == None) == true
  // a header with no files never holds
  expect(header_holds(os.fs, StdHeader{fp: "x"})) == false
}

test "a directory changed within the clock's grain is stamped by its names" {
  os.fs.create_dir_all("std/fresh")?
  os.fs.write("std/fresh/a.xo", b"fn a() -> Int { 1 }\n")?
  let info = (os.fs.stat("std/fresh")? ?? FileInfo{name: "", path: "", is_dir: false, size: 0, modified: Time.UNIX_EPOCH})
  // stamped at once: not settled, so the names are kept
  let ds = stamp_dirs(os.fs, ["std/fresh"], info.modified.unix_millis()) ?? []
  expect(ds.len()) == 1
  expect(ds[0].names) == ["a.xo"]
  expect(dir_stamps_hold(os.fs, ds)) == true
  // a file removed and another added in the same second: seen by the names
  os.fs.remove("std/fresh/a.xo")?
  os.fs.write("std/fresh/b.xo", b"fn b() -> Int { 1 }\n")?
  expect(dir_stamps_hold(os.fs, ds)) == false
}

test "a std file written after the build started gives a header that never holds" {
  let c = export_checker(os)?
  var std_mods: List[Int] = []
  for (m, md) in c.mods.indexed() {
    if md.std_tree {
      std_mods.push(m)
    }
  }
  expect(std_mods.is_empty()) == false
  // the prelude's time is after a start time in the past: no header
  let h = c.std_header(std_mods, "fp", 1000)
  expect(h.files.is_empty()) == true
  expect(header_holds(os.fs, h)) == false
  // at a start time after every write, the header holds, and a hash
  // kept for an unsettled file is the parsed bytes'
  let info = (os.fs.stat("std/prelude.xo")? ?? FileInfo{name: "", path: "", is_dir: false, size: 0, modified: Time.UNIX_EPOCH})
  let h2 = c.std_header(std_mods, "fp", info.modified.unix_millis() + 1)
  expect(h2.files.is_empty()) == false
  expect(header_holds(os.fs, h2)) == true
}
