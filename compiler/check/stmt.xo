// Modules, bodies, and statements (internal/check/stmt.go, groups.go):
// function contexts, blocks, `let`, `var`, assignment, loops, returns,
// constants, contracts, tests, and the task failure rules of scopes and
// groups (core 7.1), which decide the error types of closures.

use github.com/xo-lang/xo/compiler/parser

/// A loop being checked.
struct LoopFrame {
  label: Bytes
  has_break: Bool = false
}

/// The function, closure, or test whose body is being checked
/// (stmt.go fnCtx).
struct Ctx {
  parent: Int = -1
  /// The declared function, -1 for closures, tests, and initializers.
  fn_obj: Int = -1
  name: Str
  result: Int
  /// The declared error type, -1 when it cannot fail.
  err: Int = -1
  /// The inferred error type of a closure (a variable), -1 for none.
  err_var: Int = -1
  is_test: Bool = false
  closure: Bool = false
  loops: List[LoopFrame] = []
  /// Checking an ensures clause (`result`, `old`).
  in_ensures: Bool = false
  /// The effects performed by the body (an effect set).
  eff: Int = -1
  /// The frame of the tasks started on `os.tasks`, and of the tasks
  /// started on groups whose origin is not visible; -1 until used.
  groups: Int = -1
  ext: Int = -1
}

/// The tasks spawned on one `scope s` handle or group (core 7.1).
struct ScopeFrame {
  ctx: Int
  spawns: List[Spawn] = []
}

/// A spawned task: the call, its error type, and the local its handle
/// is bound to (-1 for none).
struct Spawn {
  span: Span
  call: Int
  err: Int
  bound: Int = -1
}

fn (var c: Checker) push_ctx(x0: Ctx) -> Int {
  let saved = c.ctx
  var x = x0
  if x.eff < 0 {
    x.eff = c.new_eset([])
  }
  c.ctxs.push(x)
  c.ctx = c.ctxs.len() - 1
  saved
}

/// The context of initializers (defaults, constants, invariants).
fn (var c: Checker) sink_ctx() -> Ctx {
  Ctx{name: "initializer", result: c.unit_ty}
}

/// The type parameters of the enclosing functions as a type environment.
fn (c: Checker) local_env() -> TypeEnv {
  var env = TypeEnv{file: c.cur_file, mod: c.cur_mod}
  var x = c.ctx
  while x >= 0 {
    let fo = c.ctxs[x].fn_obj
    if fo >= 0 {
      for p in c.objs[fo].tparams {
        env.params[c.objs[p].name] = p
      }
    }
    x = c.ctxs[x].parent
  }
  env
}

/// The expected type of a function body.
fn (c: Checker) body_want(x: Int) -> Want {
  let cx = c.ctxs[x]
  if cx.err >= 0 {
    return ret_want(cx.result, cx.err)
  }
  if c.is_unit(cx.result) {
    return discard()
  }
  want(cx.result)
}

// ---------------------------------------------------------------------------
// Modules and bodies

fn (var c: Checker) check_module(m: Int) {
  c.cur_mod = m
  let lazy = c.lazy_mod(m)
  // a skipped module's bodies the build will build from source
  // (ModEntry.eager): checked now, before the whole-program passes
  var eager: Map[Str, Bool] = {}
  if c.mod_skip.contains(m) {
    for n in (c.mod_entries.get(m) ?? ModEntry{}).eager {
      eager[n] = true
    }
  }
  for f in c.mods[m].files {
    c.set_file(f)
    let decls = c.files[f].ast.decls
    for (i, d) in decls.indexed() {
      match d {
        FnDecl(d: fd) => {
          let fo = c.files[f].decl_objs[i]
          if fo >= 0 && (fd.recv != None || c.is_scope_entry(f, i, fd.name.name)) {
            if lazy && (eager.is_empty() || !eager.contains(c.eager_name(fo))) {
              c.lazy_fns[fo] = true
              c.check_fn_defaults(fo)
            } else if c.bodies_filtered() && fd.lazy.is_some() && !c.body_spells(f, fd) {
              // body_words: a body that spells no name is left empty, in
              // the declaration and the file's tree alike (every later
              // pass walks one or the other), and not checked
              var nf = fd
              nf.body = Some(parser.Block{span: fd.span})
              nf.lazy = None
              c.objs[fo].fn_decl = [nf]
              c.files[f].ast.decls[i] = parser.Decl.FnDecl(d: nf)
              c.lazy_fns[fo] = true
              c.check_fn_defaults(fo)
            } else {
              if !eager.is_empty() {
                c.eager_fns[fo] = true
              }
              if fd.lazy.is_some() {
                // body_words: the body parsed, in the file's tree too; a
                // program body that does not parse (bench/paper's blind
                // solutions) reports its syntax errors, as a full parse
                // would, and stays empty instead of stopping the lookup
                if !c.parse_body_words(fo) {
                  c.files[f].ast.decls[i] = parser.Decl.FnDecl(d: c.objs[fo].fn_decl[0])
                  c.lazy_fns[fo] = true
                  c.check_fn_defaults(fo)
                  continue
                }
                c.files[f].ast.decls[i] = parser.Decl.FnDecl(d: c.objs[fo].fn_decl[0])
              }
              c.check_fn_decl(c.objs[fo].fn_decl[0], fo)
            }
          }
        }
        TestDecl(d: td) => c.check_test(td)
        ConstDecl(d: cd) => {
          if c.is_scope_entry(f, i, cd.name.name) {
            c.const_type(c.files[f].decl_objs[i])
          }
        }
        StructDecl(d: sd) => {
          if c.is_scope_entry(f, i, sd.name.name) {
            let t = c.files[f].decl_objs[i]
            c.check_struct_extras(t, sd)
            c.check_derives(t, sd.derive)
          }
        }
        EnumDecl(d: ed) => {
          if c.is_scope_entry(f, i, ed.name.name) {
            c.check_derives(c.files[f].decl_objs[i], ed.derive)
          }
        }
        TypeDecl(d: td) => {
          if !td.derive.is_empty() && c.is_scope_entry(f, i, td.name.name) {
            c.check_newtype_derives(c.files[f].decl_objs[i], td.derive)
          }
        }
        _ => {}
      }
    }
  }
}

fn (var c: Checker) check_fn_decl(fd: parser.FnDecl, fo: Int) {
  if !c.objs[fo].sig_done {
    return
  }
  let saved_scopes = c.scopes
  let saved = c.push_ctx(Ctx{fn_obj: fo, name: c.display_name(fo), result: c.objs[fo].result, err: c.objs[fo].err})
  let cx = c.ctx
  let body_eff = c.ctxs[cx].eff
  c.objs[fo].body_eff = body_eff
  c.scopes = []
  c.push_scope()
  if let Some(r) = fd.recv {
    if !c.objs[fo].is_static {
      let rv = c.declare_local(r.name, c.objs[fo].recv_ty, if r.is_var { "var-recv" } else { "recv" })
      c.objs[rv].vctx = cx
      c.recv_var[fo] = rv
    }
  }
  var pvs: List[Int] = []
  for p in c.objs[fo].params {
    let pv = c.objs.len()
    c.objs.push(Obj{kind: ObjKind.Local, name: p.name, file: c.path, line: p.line, col: p.col, local: if p.is_var { "var-param" } else { "param" }, ty: p.ty, mutable: p.is_var, vctx: cx})
    c.declare_var(pv)
    pvs.push(pv)
    if !p.default.is_empty() && !c.lazy_fns.contains(fo) {
      c.check_default(p.default[0], p.ty)
    }
  }
  c.param_vars[fo] = pvs
  c.check_clauses(fd, fo)
  if let Some(b) = fd.body {
    c.block(b, c.body_want(cx))
    c.bodies.push(BodyRef{file: c.cur_file, body: b})
  }
  c.finish_groups(cx)
  c.ctx = saved
  c.scopes = saved_scopes
  if c.objs[fo].declared >= 0 && fd.body != None {
    let (title, edits) = c.log_fix(fd)
    c.obligations.push(EffOb{kind: ObKind.Decl, sub: body_eff, sup: c.objs[fo].declared, file: c.path, span: fd.name.span, fo: fo, log_title: title, log_edits: edits})
  }
}

/// Whether module m's function bodies wait for check_lazy: a native
/// module of a lazy run, but not the std module under test (std_test),
/// which is checked in full like any root module.
fn (c: Checker) lazy_mod(m: Int) -> Bool {
  (c.lazy && c.mods[m].native && !c.mods[m].root) || c.mod_skip.contains(m)
}

/// The default values of std module m's function parameters and struct
/// fields, for a build that does not check its bodies (the Go backend's;
/// check_bodies_of in run).
fn (var c: Checker) check_std_defaults(m: Int) {
  c.cur_mod = m
  for f in c.mods[m].files {
    c.set_file(f)
    let decls = c.files[f].ast.decls
    for (i, d) in decls.indexed() {
      let o = c.files[f].decl_objs[i]
      if o < 0 {
        continue
      }
      match d {
        FnDecl(..) => c.check_fn_defaults(o)
        StructDecl(..) => {
          for fl in c.objs[o].fields {
            if !fl.default.is_empty() {
              c.check_default(fl.default[0], fl.ty)
            }
          }
        }
        _ => {}
      }
    }
  }
}

/// The default values of fo's parameters (check_fn_decl's), for a
/// function whose body waits for check_lazy: a caller's build reads them.
fn (var c: Checker) check_fn_defaults(fo: Int) {
  for p in c.objs[fo].params {
    if !p.default.is_empty() {
      c.check_default(p.default[0], p.ty)
    }
  }
}

/// Whether the unparsed body of fd in file f spells one of body_words.
fn (c: Checker) body_spells(f: Int, fd: parser.FnDecl) -> Bool {
  let lb = match fd.lazy {
    Some(x) => x
    None => return true
  }
  let src = c.files[f].src
  let text = src[lb.start.offset..lb.end.min(src.len())]
  c.body_words.any(fn(w) { spells_ident(text, w) })
}

/// Parses fo's body when the lazy parse skipped it (decision 0351 stage
/// 2): the sentinel body becomes the real one in fo's declaration, which
/// every later reader (the check, the SSA builder) sees. A syntax error
/// in it is a std file's (TestStdChecks reports it), so the build stops.
pub fn (var c: Checker) force_body(fo: Int) uses fs.read {
  if fo >= 0 {
    c.need_tree(fo)
  }
  if fo < 0 || c.objs[fo].fn_decl.is_empty() {
    return
  }
  let fd = c.objs[fo].fn_decl[0]
  if let Some(lb) = fd.lazy {
    let f = c.objs[fo].decl_file
    let (b, ds) = parser.parse_body(c.files[f].path.bytes(), c.files[f].src, lb)
    if !ds.is_empty() {
      fault("a lazily parsed body of ${c.files[f].path} does not parse: ${ds[0].message.to_str() ?? "?"} (XO_LAZY_PARSE=off parses it in full)")
    }
    var nf = fd
    nf.body = Some(b)
    nf.lazy = None
    c.objs[fo].fn_decl = [nf]
  }
}

/// force_body for a body_words lookup (xo refs): a body with syntax
/// errors adds them to the diagnostics and becomes an empty block, and
/// the result is false; true when the body parsed.
fn (var c: Checker) parse_body_words(fo: Int) -> Bool {
  let fd = c.objs[fo].fn_decl[0]
  let lb = match fd.lazy {
    Some(x) => x
    None => return true
  }
  let f = c.objs[fo].decl_file
  let (b, ds) = parser.parse_body(c.files[f].path.bytes(), c.files[f].src, lb)
  var nf = fd
  nf.lazy = None
  if ds.is_empty() {
    nf.body = Some(b)
    c.objs[fo].fn_decl = [nf]
    return true
  }
  c.diags = c.diags + parse_diags(c.files[f].path, ds)
  nf.body = Some(parser.Block{span: fd.span})
  c.objs[fo].fn_decl = [nf]
  false
}

/// Checks the body of fo when it waits for check_lazy (decision 0247),
/// as run would have, and returns the errors it reported (none for a
/// std that TestStdChecks checks in full). The flow passes, effect
/// obligations, and unused name reports of run are not run for it: they
/// only report diagnostics, which an eager check of std already has.
pub fn (var c: Checker) check_lazy(fo: Int) -> List[Diag] uses fs.read {
  c.force_body(fo)
  if !(c.lazy_fns.get(fo) ?? false) {
    return []
  }
  c.lazy_fns[fo] = false
  let saved_file = c.cur_file
  let saved_mod = c.cur_mod
  let saved_path = c.path
  let n0 = c.diags.len()
  let nr0 = c.never_results.len()
  let nx0 = c.xml_calls.len()
  c.cur_mod = c.objs[fo].module
  c.set_file(c.objs[fo].decl_file)
  c.check_fn_decl(c.objs[fo].fn_decl[0], fo)
  // the whole-program passes ran: its xml.encode_value and xml.decode
  // calls are rewritten here, or the build met them as std calls (XO1201)
  c.rewrite_xml_calls(nx0)
  // run's: a closure result that nothing determined and whose body
  // never completes is Never
  for t in c.never_results[nr0..] {
    if c.is_open_var(t) {
      c.unify(t, c.named("Never"))
    }
  }
  if saved_file >= 0 {
    c.set_file(saved_file)
  }
  c.cur_mod = saved_mod
  c.path = saved_path
  var errs: List[Diag] = []
  for d in c.diags[n0..] {
    if !d.warning {
      errs.push(d)
    }
  }
  errs
}

fn (var c: Checker) check_default(e: Expr, t: Int) {
  let saved_scopes = c.scopes
  let saved = c.push_ctx(c.sink_ctx())
  c.scopes = []
  c.push_scope()
  c.check_ty(e, t)
  c.ctx = saved
  c.scopes = saved_scopes
}

/// The end of a function declaration's header: its result type, last
/// parameter, or name (stmt.go fdHeaderEnd).
fn fd_header_end(fd: parser.FnDecl) -> parser.Pos {
  if let Some(r) = fd.result {
    return parser.type_span(r).end
  }
  if !fd.params.is_empty() {
    return fd.params[fd.params.len() - 1].span.end
  }
  fd.name.span.end
}

fn (var c: Checker) check_clauses(fd: parser.FnDecl, fo: Int) {
  for cl in fd.clauses {
    match cl {
      RequiresClause(cond: cond, els: els, ..) => {
        let p = c.pure_start()
        c.check_ty(cond, c.named("Bool"))
        c.pure_end(p, parser.expr_span(cond))
        if let Some(e) = els {
          if c.objs[fo].err < 0 {
            let d = c.error("XO0205", parser.expr_span(e), "`requires ... else` returns an error, but `${c.display_name(fo)}` cannot fail")
            c.fix(d, "declare an error type: `! E`", [c.insert_edit(fd_header_end(fd), " ! Error")])
            continue
          }
          let p2 = c.pure_start()
          c.check_ty(e, c.objs[fo].err)
          c.pure_end(p2, parser.expr_span(e))
        }
      }
      EnsuresClause(span: span, cond: cond, ..) => {
        c.push_scope()
        let rv = c.objs.len()
        c.objs.push(Obj{kind: ObjKind.Local, name: b"result", file: c.path, line: span.start.line, col: span.start.col, local: "predeclared", ty: c.objs[fo].result, vctx: c.ctx})
        c.declare_var(rv)
        // the binding of `result` (check.go rec.resultVar, read by the SSA
        // builder)
        c.result_vars[c.name_key(span.start.offset)] = rv
        let saved = c.ctxs[c.ctx].in_ensures
        c.ctxs[c.ctx].in_ensures = true
        let p = c.pure_start()
        c.check_ty(cond, c.named("Bool"))
        c.pure_end(p, parser.expr_span(cond))
        c.ctxs[c.ctx].in_ensures = saved
        c.pop_scope()
      }
      _ => {}
    }
  }
}

fn (var c: Checker) check_struct_extras(t: Int, sd: parser.StructDecl) {
  for f in c.objs[t].fields {
    if !f.default.is_empty() {
      c.check_default(f.default[0], f.ty)
    }
  }
  let inv = match sd.inv {
    Some(x) => x
    None => return
  }
  let saved_scopes = c.scopes
  let saved = c.push_ctx(c.sink_ctx())
  c.scopes = []
  c.push_scope()
  var vars: List[Int] = []
  for f in c.objs[t].fields {
    let fv = c.objs.len()
    c.objs.push(Obj{kind: ObjKind.Local, name: f.name, file: c.path, line: f.line, col: f.col, local: "param", ty: f.ty, vctx: c.ctx})
    c.declare_var(fv)
    vars.push(fv)
  }
  // the field bindings (check.go rec.invVars, read by the SSA builder)
  c.inv_vars[t] = vars
  let p = c.pure_start()
  c.check_ty(inv, c.named("Bool"))
  c.pure_end(p, parser.expr_span(inv))
  c.ctx = saved
  c.scopes = saved_scopes
}

fn (var c: Checker) check_test(td: parser.TestDecl) {
  let saved_scopes = c.scopes
  let saved = c.push_ctx(Ctx{name: "test", result: c.unit_ty, err: c.named("Error"), is_test: true})
  let cx = c.ctx
  c.scopes = []
  c.push_scope()
  let tm = c.testing_mod()
  var os_ty = c.bad_ty
  if tm >= 0 {
    let o = c.mods[tm].members.get(b"TestOs") ?? -1
    if o >= 0 {
      os_ty = c.mk_named(o, [])
    }
  }
  let os = c.objs.len()
  c.objs.push(Obj{kind: ObjKind.Local, name: b"os", local: "predeclared", ty: os_ty, vctx: cx})
  c.scopes[0][b"os"] = os
  let tkey = c.test_key(c.cur_file, td)
  c.test_os[tkey] = os
  var env = TypeEnv{file: c.cur_file, mod: c.cur_mod}
  var pvs: List[Int] = []
  for p in td.params {
    c.check_name(p.name, "parameter")
    var pt = c.bad_ty
    if let Some(t) = p.typ {
      pt = c.resolve_type(t, env)
    }
    let pv = c.declare_local(p.name, pt, "param")
    c.objs[pv].vctx = cx
    pvs.push(pv)
  }
  c.test_params[tkey] = pvs
  if !td.effects.is_empty() {
    c.resolve_effects(td.effects, env)
  }
  if let Some(b) = td.body {
    c.block(b, c.body_want(cx))
    c.bodies.push(BodyRef{file: c.cur_file, body: b})
  }
  c.finish_groups(cx)
  c.ctx = saved
  c.scopes = saved_scopes
}

/// The type of a constant, checking its initializer on first use.
fn (var c: Checker) const_type(co: Int) -> Int {
  if c.objs[co].done {
    return c.objs[co].ty
  }
  c.need_tree(co)
  let f = c.objs[co].decl_file
  let cd = match c.top_decl(f, c.objs[co].decl_idx) {
    Some(ConstDecl(d: x)) => x
    _ => fault("a constant's declaration")
  }
  if c.objs[co].checking {
    c.error_at(f, "XO0407", cd.name.span, "constant `${text(cd.name.name)}` refers to itself")
    c.objs[co].ty = c.bad_ty
    return c.bad_ty
  }
  c.objs[co].checking = true
  let saved_mod = c.cur_mod
  let saved_file = c.cur_file
  let saved_path = c.path
  c.set_file(f)
  var w = -1
  if let Some(tt) = cd.typ {
    var env = TypeEnv{file: f, mod: c.objs[co].module}
    w = c.resolve_type(tt, env)
  }
  let saved_scopes = c.scopes
  let saved = c.push_ctx(c.sink_ctx())
  c.scopes = []
  c.push_scope()
  var t = -1
  if w >= 0 {
    t = c.check_ty(cd.value, w)
  } else {
    t = c.infer(cd.value, -1)
  }
  // the initializer runs once, at first use, so it may call functions
  // but perform no effect, and the value holds no handle (decision 0332)
  let eff = c.ctxs[c.ctx].eff
  if !c.esets[eff].is_empty() {
    c.obligations.push(EffOb{kind: ObKind.Const, sub: eff, sup: c.new_eset([]), file: c.path, span: parser.expr_span(cd.value)})
  }
  c.ctx = saved
  c.scopes = saved_scopes
  if !c.is_bad(t) {
    let h = c.const_handle(t, [], 16)
    if !h.is_empty() {
      c.error_at(f, "XO0416", cd.name.span, "constant `${text(cd.name.name)}` holds a `${h}`; a constant is an immutable value shared by every task, not a global variable (decision 0332)")
    }
  }
  c.cur_mod = saved_mod
  c.cur_file = saved_file
  c.path = saved_path
  c.objs[co].ty = c.deep_copy(t)
  c.objs[co].done = true
  c.objs[co].checking = false
  c.objs[co].ty
}

/// t with every bound variable replaced (types.go deep).
fn (var c: Checker) deep_copy(t0: Int) -> Int {
  let t = c.resolve(t0)
  let x = c.tys[t]
  match x.kind {
    Named | Tuple => {
      if x.args.is_empty() {
        return t
      }
      var args: List[Int] = []
      for a in x.args {
        args.push(c.deep_copy(a))
      }
      c.new_ty(Ty{kind: x.kind, obj: x.obj, args: args})
    }
    Func => {
      var args: List[Int] = []
      for a in x.args {
        args.push(c.deep_copy(a))
      }
      var e = -1
      if x.err >= 0 {
        e = c.deep_copy(x.err)
        if c.is_never(e) {
          e = -1
        }
      }
      c.new_ty(Ty{kind: TyKind.Func, args: args, vars: x.vars, result: c.deep_copy(x.result), err: e})
    }
    Param | Var | Bad | EffArg => t
  }
}

/// The name of a handle type (Mutex, Chan, Atomic, Task, a file; is_handle)
/// in a value of type t at any depth, "" for none (decision 0332, XO0416).
fn (var c: Checker) const_handle(t0: Int, seen: List[Int], depth: Int) -> Str {
  if t0 < 0 || depth <= 0 {
    return ""
  }
  let t = c.resolve(t0)
  let x = c.tys[t]
  match x.kind {
    Tuple => {
      for e in x.args {
        let h = c.const_handle(e, seen, depth - 1)
        if !h.is_empty() {
          return h
        }
      }
      ""
    }
    Named => {
      let o = x.obj
      if c.is_handle(o) {
        return text(c.objs[o].name)
      }
      for a in x.args {
        if c.tys[a].kind != TyKind.EffArg {
          let h = c.const_handle(a, seen, depth - 1)
          if !h.is_empty() {
            return h
          }
        }
      }
      if seen.contains(o) {
        return ""
      }
      var seen2 = seen
      seen2.push(o)
      let sm = c.args_subst(c.objs[o].tparams, x.args)
      var fts: List[Int] = []
      let tk = c.objs[o].tkind
      if tk == "struct" {
        for fl in c.objs[o].fields {
          fts.push(c.subst(fl.ty, sm))
        }
      } else if tk == "enum" {
        for v in c.objs[o].variants {
          for fl in v.fields {
            fts.push(c.subst(fl.ty, sm))
          }
        }
      } else if (tk == "newtype" || tk == "alias") && c.objs[o].target >= 0 {
        fts.push(c.subst(c.objs[o].target, sm))
      }
      for ft in fts {
        let h = c.const_handle(ft, seen2, depth - 1)
        if !h.is_empty() {
          return h
        }
      }
      ""
    }
    Func | Param | Var | Bad | EffArg => ""
  }
}

/// XO0408 for the parts of a block `const` initializer that are not
/// compile time values (core 3.1; a module constant may call functions,
/// decision 0332).
fn (var c: Checker) check_const_expr(e: Expr) {
  match e {
    IntLit(..) | FloatLit(..) | DurationLit(..) | RuneLit(..) | BytesLit(..) | UnitExpr(..) | BadExpr(..) => {}
    StringLit(s) => {
      for p in s.parts {
        if let Some(x) = p.expr {
          c.check_const_expr(x)
        }
      }
    }
    Ident(id) => {
      if let Some(i) = c.name_at.get(c.name_key(id.span.start.offset)) {
        let o = c.names[i].obj
        if o >= 0 && c.objs[o].kind == ObjKind.Local && !c.objs[o].is_const {
          c.const_bad(parser.expr_span(e), "a local binding")
        }
      }
    }
    SelectorExpr(x: x, ..) => c.check_const_expr(x)
    ParenExpr(x: x, ..) => c.check_const_expr(x)
    UnaryExpr(x: x, ..) => c.check_const_expr(x)
    BinaryExpr(x: x, y: y, ..) => {
      c.check_const_expr(x)
      c.check_const_expr(y)
    }
    TupleExpr(elems: els, ..) | ListLit(elems: els, ..) | SetLit(elems: els, ..) => {
      for x in els {
        c.check_const_expr(x)
      }
    }
    MapLit(entries: entries, ..) => {
      for en in entries {
        c.check_const_expr(en.key)
        c.check_const_expr(en.value)
      }
    }
    StructLit(fields: fields, ..) => {
      for f in fields {
        c.check_const_expr(f.value)
      }
    }
    CallExpr(args: args, ..) => {
      let key = c.expr_key(e)
      if let Some(fo) = c.fn_calls.get(key) {
        c.const_bad(parser.expr_span(e), "the call to `${c.display_name(fo)}`")
        return
      }
      if c.ctor_calls.contains(key) {
        for a in args {
          c.check_const_expr(a.value)
        }
        return
      }
      c.const_bad(parser.expr_span(e), "a call")
    }
    _ => c.const_bad(parser.expr_span(e), "this expression")
  }
}

fn (var c: Checker) const_bad(sp: Span, what: Str) {
  c.error("XO0408", sp, "${what} is not a compile time value; a block `const` initializer may use literals, other constants, struct and enum construction, and collection literals of those (a module `const` may call functions, decision 0332; core 3.1)")
}

// ---------------------------------------------------------------------------
// Derives (stmt.go checkDerives)

/// A newtype's derives (decision 0390): `Ord` only, the order of its
/// value, which must be Ord; its equality, hashing and JSON are its
/// value's already (core 2.8).
fn (var c: Checker) check_newtype_derives(t: Int, ids: List[Ident]) {
  for id in ids {
    let n = text(id.name)
    if !is_derivable(id.name) {
      // derives_of reported it
      continue
    }
    if n != "Ord" {
      c.error("XO0404", id.span, "a newtype derives only `Ord`: `${text(c.objs[t].name)}` has its value's equality, hashing and JSON already (core 2.8, decision 0390)")
      continue
    }
    let vt = c.objs[t].target
    if vt < 0 || c.is_bad(vt) || c.mentions_param(vt) {
      continue
    }
    if !c.is_ord(vt) {
      c.error("XO0404", id.span, "`derive Ord` needs the newtype's value to implement `Ord`, but `${text(c.objs[t].name)}` holds `${c.show(vt)}`")
    }
  }
}

fn (var c: Checker) check_derives(t: Int, ids: List[Ident]) {
  for id in ids {
    let n = text(id.name)
    if n == "SqlRow" {
      c.check_sql_row_derive(t, id)
      continue
    }
    if !(derivable(n) ?? Derivable{name: n, kind: DeriveKind.Text, marker: false, fields_must: false}).fields_must {
      continue
    }
    let iface = c.named(n)
    var fts: List[Int] = []
    var names: List[Str] = []
    for f in c.objs[t].fields {
      fts.push(f.ty)
      names.push(text(f.name))
    }
    for v in c.objs[t].variants {
      for f in v.fields {
        fts.push(f.ty)
        names.push("${text(v.name)}.${if f.from { "from" } else { text(f.name) }}")
      }
    }
    for (i, ft) in fts.indexed() {
      if c.mentions_param(ft) {
        continue
      }
      if !c.implements(ft, iface, no_span()) {
        c.error("XO0404", id.span, "`derive ${n}` needs every field to implement `${n}`, but `${names[i]}` has type `${c.show(ft)}`")
      }
    }
  }
}

fn (var c: Checker) check_sql_row_derive(t: Int, id: Ident) {
  if c.objs[t].tkind != "struct" {
    c.error("XO0407", id.span, "`derive SqlRow` applies only to structs; `${text(c.objs[t].name)}` is not one")
    return
  }
  if !c.objs[t].tparams.is_empty() {
    c.error("XO0407", id.span, "`derive SqlRow` needs a struct without type parameters; `${text(c.objs[t].name)}` has some")
    return
  }
  for f in c.objs[t].fields {
    if !c.is_sql_column(f.ty) {
      let d = c.error("XO0404", id.span, "`derive SqlRow` needs every field to be a column type, but `${text(f.name)}` has type `${c.show(f.ty)}`")
      c.note(d, "column types are Int, Float, Str, Bool, Time, and Bytes, an Option of one for a column that may be NULL, and List[Int] and List[Str] for arrays (std.md 10.4)")
    }
  }
}

fn is_sql_column_name(n: Bytes) -> Bool {
  (text(n)) is "Int" | "Float" | "Str" | "Bool" | "Time" | "Bytes"
}

fn (c: Checker) is_sql_column(t: Int) -> Bool {
  let r = c.resolve(t)
  if c.tys[r].kind != TyKind.Named || c.objs[c.tys[r].obj].module != c.prelude {
    return false
  }
  let o = c.tys[r].obj
  if c.objs[o].name == b"Option" && c.tys[r].args.len() == 1 {
    let e = c.named_obj(c.tys[r].args[0])
    return e >= 0 && c.objs[e].module == c.prelude && is_sql_column_name(c.objs[e].name)
  }
  if c.objs[o].name == b"List" && c.tys[r].args.len() == 1 {
    // array columns (decision 0278): Row.ints and Row.strs
    let e = c.named_obj(c.tys[r].args[0])
    return e >= 0 && c.objs[e].module == c.prelude && (text(c.objs[e].name)) is "Int" | "Str"
  }
  is_sql_column_name(c.objs[o].name)
}

// ---------------------------------------------------------------------------
// Blocks and statements

/// Checks a block against w and returns its type.
fn (var c: Checker) block(b: Block, w: Want) -> Int {
  c.push_scope()
  let n = b.stmts.len()
  for (i, s) in b.stmts.indexed() {
    if i == n - 1 {
      if let ExprStmt(x: x, ..) = s {
        let t = if w.kind == 0 { c.infer(x, -1) } else { c.check(x, w) }
        c.pop_scope()
        return t
      }
    }
    c.stmt(s)
  }
  var t = c.unit_ty
  if n > 0 && c.stmt_never(b.stmts[n - 1]) {
    t = c.named("Never")
  }
  // a block that ends in a statement that did not parse has no type to
  // report: the parse error said what is wrong (2026-10-24: `let Some(pub)
  // = x else ...` then `pub + 1` added "expected `Int`, found `()`")
  if n > 0 {
    if let BadStmt(_) = b.stmts[n - 1] {
      t = c.bad_ty
    }
  }
  c.pop_scope()
  if w.kind == 0 {
    return t
  }
  var end = b.span
  end.start = b.span.end
  if end.start.col > 1 {
    end.start.col -= 1
    end.start.offset -= 1
  }
  c.coerce_to(t, w, end, [])
}

/// Whether a block never completes normally.
fn (c: Checker) block_never(b: Block) -> Bool {
  let n = b.stmts.len()
  if n == 0 {
    return false
  }
  if let ExprStmt(x: x, ..) = b.stmts[n - 1] {
    if let WhileExpr(body: body, ..) = x {
      return !has_break_block(body, b"", 0)
    }
    if c.never_expr.contains(c.expr_key(x)) {
      return true
    }
  }
  c.stmt_never(b.stmts[n - 1])
}

/// Whether a statement never completes.
fn (c: Checker) stmt_never(s: Stmt) -> Bool {
  match s {
    ReturnStmt(..) | BreakStmt(..) | ContinueStmt(..) => true
    WhileStmt(label: label, cond: cond, pattern: pattern, body: body, ..) => {
      let l = match label {
        Some(id) => id.name
        None => b""
      }
      cond == None && pattern.is_empty() && !has_break_block(body, l, 0)
    }
    ExprStmt(x: x, ..) => {
      let t = c.type_of(x)
      t >= 0 && c.is_never(t)
    }
    _ => false
  }
}

/// Whether body contains a break that exits the loop with the given
/// label (depth counts the loops nested inside it).
fn has_break_block(b: Block, label: Bytes, depth: Int) -> Bool {
  for s in b.stmts {
    if has_break_stmt(s, label, depth) {
      return true
    }
  }
  false
}

fn has_break_stmt(s: Stmt, label: Bytes, depth: Int) -> Bool {
  match s {
    BreakStmt(label: l, ..) => {
      match l {
        None => depth == 0
        Some(id) => !label.is_empty() && id.name == label
      }
    }
    ForStmt(iter: iter, bound: bound, body: body, ..) => {
      has_break_expr(iter, label, depth) || has_break_exprs(bound, label, depth) || has_break_block(body, label, depth + 1)
    }
    WhileStmt(cond: cond, value: value, bound: bound, body: body, ..) => {
      if let Some(x) = cond {
        if has_break_expr(x, label, depth) {
          return true
        }
      }
      has_break_exprs(value, label, depth) || has_break_exprs(bound, label, depth) || has_break_block(body, label, depth + 1)
    }
    ExprStmt(x: x, ..) => has_break_expr(x, label, depth)
    LetStmt(value: value, ..) => has_break_expr(value, label, depth)
    VarStmt(value: value, ..) => has_break_expr(value, label, depth)
    ConstDecl(d: cd) => has_break_expr(cd.value, label, depth)
    AssignStmt(target: target, value: value, ..) => has_break_expr(target, label, depth) || has_break_expr(value, label, depth)
    DeferStmt(body: body, ..) => has_break_stmt(body, label, depth)
    ReturnStmt(value: value, ..) => {
      match value {
        Some(x) => has_break_expr(x, label, depth)
        None => false
      }
    }
    _ => false
  }
}

fn has_break_exprs(es: List[Expr], label: Bytes, depth: Int) -> Bool {
  for e in es {
    if has_break_expr(e, label, depth) {
      return true
    }
  }
  false
}

fn has_break_opt(e: Expr?, label: Bytes, depth: Int) -> Bool {
  match e {
    Some(x) => has_break_expr(x, label, depth)
    None => false
  }
}

fn has_break_expr(e: Expr, label: Bytes, depth: Int) -> Bool {
  match e {
    StringLit(s) => {
      for p in s.parts {
        if has_break_opt(p.expr, label, depth) {
          return true
        }
      }
      false
    }
    ParenExpr(x: x, ..) => has_break_expr(x, label, depth)
    TupleExpr(elems: els, ..) | ListLit(elems: els, ..) | SetLit(elems: els, ..) => has_break_exprs(els, label, depth)
    MapLit(entries: entries, ..) => {
      for en in entries {
        if has_break_expr(en.key, label, depth) || has_break_expr(en.value, label, depth) {
          return true
        }
      }
      false
    }
    StructLit(typ: typ, fields: fields, ..) => {
      if has_break_expr(typ, label, depth) {
        return true
      }
      for f in fields {
        if has_break_expr(f.value, label, depth) {
          return true
        }
      }
      false
    }
    WithExpr(x: x, fields: fields, ..) => {
      if has_break_expr(x, label, depth) {
        return true
      }
      for f in fields {
        if has_break_expr(f.value, label, depth) {
          return true
        }
      }
      false
    }
    UnaryExpr(x: x, ..) => has_break_expr(x, label, depth)
    BinaryExpr(x: x, y: y, ..) => has_break_expr(x, label, depth) || has_break_expr(y, label, depth)
    IsExpr(x: x, ..) => has_break_expr(x, label, depth)
    RangeExpr(lo: lo, hi: hi, ..) => has_break_opt(lo, label, depth) || has_break_opt(hi, label, depth)
    SelectorExpr(x: x, ..) => has_break_expr(x, label, depth)
    CallExpr(fun: fun, args: args, ..) => {
      if has_break_expr(fun, label, depth) {
        return true
      }
      for a in args {
        if has_break_expr(a.value, label, depth) {
          return true
        }
      }
      false
    }
    TypeArgsExpr(x: x, ..) => has_break_expr(x, label, depth)
    IndexExpr(x: x, index: index, ..) => has_break_expr(x, label, depth) || has_break_expr(index, label, depth)
    TryExpr(x: x, ..) => has_break_expr(x, label, depth)
    IfExpr(e: x) => {
      if has_break_opt(x.cond, label, depth) || has_break_opt(x.value, label, depth) || has_break_block(x.then, label, depth) {
        return true
      }
      has_break_opt(x.els, label, depth)
    }
    MatchExpr(subject: subject, arms: arms, ..) => {
      if has_break_expr(subject, label, depth) {
        return true
      }
      for arm in arms {
        if has_break_opt(arm.guard, label, depth) {
          return true
        }
        if let Some(b) = arm.body {
          if has_break_stmt(b, label, depth) {
            return true
          }
        }
      }
      false
    }
    ScopeExpr(body: body, ..) => has_break_block(body, label, depth)
    SelectExpr(arms: arms, ..) => {
      for arm in arms {
        if has_break_opt(arm.op, label, depth) || has_break_opt(arm.after, label, depth) {
          return true
        }
        if let Some(b) = arm.body {
          if has_break_stmt(b, label, depth) {
            return true
          }
        }
      }
      false
    }
    Block(b) => has_break_block(b, label, depth)
    WhileExpr(body: body, ..) => has_break_block(body, label, depth + 1)
    _ => false
  }
}

fn label_name(l: Ident?) -> Bytes {
  match l {
    Some(id) => id.name
    None => b""
  }
}

/// An expression statement: a call's effects go to a set of their own as
/// well (discards), so XO0209 can tell, once effects are solved, a call
/// that only computes the value it discards (decision 0258).
fn (var c: Checker) expr_stmt(x: Expr) {
  var call = x
  while true {
    if let ParenExpr(x: inner, ..) = call {
      call = inner
    } else {
      break
    }
  }
  let is_call = if let CallExpr(..) = call { true } else { false }
  // native std modules call memory and system intrinsics whose effects
  // are not tracked (decision 0258)
  let native = c.cur_mod >= 0 && c.mods[c.cur_mod].native
  if !is_call || native || c.ctx < 0 || c.ctxs[c.ctx].eff < 0 {
    c.check(x, discard())
    return
  }
  let saved = c.ctxs[c.ctx].eff
  let sink = c.new_eset([])
  c.ctxs[c.ctx].eff = sink
  let m0 = c.mut_calls
  let t = c.check(x, discard())
  c.ctxs[c.ctx].eff = saved
  for it in c.esets[sink] {
    c.esets[saved].push(it)
  }
  if c.mut_calls != m0 || c.is_bad(t) || c.is_never(t) || c.is_result(t) || c.is_unit(t) {
    return
  }
  let sp = parser.expr_span(x)
  var what = "this call"
  var fixes: List[DFix] = []
  var operands: List[Int] = []
  if let CallExpr(fun: fun, args: args, ..) = call {
    let n = callee_name(fun)
    if !n.is_empty() {
      what = "`${n}(...)`"
    }
    // `.ignore_err("reason")` is how a Result is discarded (core 2.6);
    // `dbg(x)` prints, its value returned for use in expressions (core 11.4)
    if n == "ignore_err" || n.ends_with(".ignore_err") || n == "dbg" {
      return
    }
    for a in args {
      operands.push(c.type_of(a.value))
    }
    match fun {
      SelectorExpr(x: recv, ..) => operands.push(c.type_of(recv))
      _ => {}
    }
    // a call of a function value (not a declared function) may do
    // anything its closure captured
    if !c.fn_calls.contains(c.expr_key(call)) {
      operands.push(c.type_of(fun))
    }
    // a method of a `var` binding: assign the result back
    if let SelectorExpr(x: recv, ..) = fun {
      if let Ident(id) = recv {
        let v = c.lookup_local(id.name)
        if v >= 0 && c.objs[v].mutable && c.objs[v].vctx == c.ctx && c.objs[v].ty >= 0 && c.show(c.objs[v].ty) == c.show(t) {
          fixes.push(DFix{title: "assign the result back to `${text(id.name)}`", edits: [c.insert_edit(sp.start, "${text(id.name)} = ")]})
        }
      }
    }
  }
  fixes.push(DFix{title: "discard the result on purpose", edits: [c.insert_edit(sp.start, "let _ = ")]})
  c.discards.push(Discard{eff: sink, file: c.path, span: sp, t: t, what: what, fixes: fixes, operands: operands})
}

/// Whether a value of type t can reach state a call may change without
/// performing an effect: a function value (what it captured), a handle
/// (Atomic, Chan, Mutex, Scope, Task, a file; is_handle), an interface
/// value, or a type not known here (a type parameter, a type still
/// open, an unrecorded operand), in it at any depth.
fn (var c: Checker) reaches_state(t0: Int, seen: List[Int], depth: Int) -> Bool {
  if t0 < 0 || depth <= 0 {
    return true
  }
  let t = c.resolve(t0)
  let x = c.tys[t]
  match x.kind {
    Func | Param | Var => true
    Bad | EffArg => false
    Tuple => {
      for e in x.args {
        if c.reaches_state(e, seen, depth - 1) {
          return true
        }
      }
      false
    }
    Named => {
      let o = x.obj
      if c.is_handle(o) || c.objs[o].tkind == "interface" {
        return true
      }
      for a in x.args {
        if c.tys[a].kind != TyKind.EffArg && c.reaches_state(a, seen, depth - 1) {
          return true
        }
      }
      if seen.contains(o) {
        return false
      }
      var seen2 = seen
      seen2.push(o)
      let sm = c.args_subst(c.objs[o].tparams, x.args)
      let tk = c.objs[o].tkind
      if tk == "struct" {
        for f in c.objs[o].fields {
          if c.reaches_state(c.subst(f.ty, sm), seen2, depth - 1) {
            return true
          }
        }
      } else if tk == "enum" {
        for v in c.objs[o].variants {
          for f in v.fields {
            if c.reaches_state(c.subst(f.ty, sm), seen2, depth - 1) {
              return true
            }
          }
        }
      } else if (tk == "newtype" || tk == "alias") && c.objs[o].target >= 0 {
        return c.reaches_state(c.subst(c.objs[o].target, sm), seen2, depth - 1)
      }
      false
    }
  }
}

/// XO0209 for each discarded call that performs no effect (decision
/// 0258): it can only compute the value the statement drops.
fn (var c: Checker) report_discards() {
  let ds = c.discards
  for d in ds {
    let fl = c.flatten(d.eff, true)
    if !fl.labels.is_empty() || !fl.params.is_empty() {
      continue
    }
    var state = false
    for t in d.operands {
      state = state || c.reaches_state(t, [], 12)
    }
    if state {
      continue
    }
    let di = c.report(d.file, "XO0209", d.span, "the `${c.show(d.t)}` that ${d.what} returns is discarded, and the call does nothing else")
    if di < 0 {
      continue
    }
    c.note(di, "values are not changed in place: a method that returns a new value leaves its receiver as it was (core 2.6); write `let _ = ...` to discard on purpose")
    for f in d.fixes {
      c.fix(di, f.title, f.edits)
    }
  }
}

fn (var c: Checker) stmt(s: Stmt) {
  match s {
    ExprStmt(x: x, ..) => c.expr_stmt(x)
    LetStmt(span: span, pattern: pattern, typ: typ, value: value, is_var: is_var) => c.let_stmt(span, pattern, typ, value, is_var)
    VarStmt(name: name, typ: typ, value: value, ..) => c.var_stmt(name, typ, value)
    ConstDecl(d: cd) => c.local_const(cd)
    AssignStmt(span: span, op: op, target: target, value: value) => c.assign(span, op, target, value)
    DeferStmt(body: body, ..) => {
      // a deferred call runs for what it does at exit, or to fault there
      // (decision 0258: not XO0209)
      if let ExprStmt(x: x, ..) = body {
        c.check(x, discard())
      } else {
        c.stmt(body)
      }
    }
    ReturnStmt(span: span, value: value) => {
      let w = c.body_want(c.ctx)
      match value {
        None => {
          c.coerce_to(c.unit_ty, w, span, [])
        }
        Some(v) => {
          c.check(v, w)
        }
      }
    }
    BreakStmt(span: span, label: label) => c.jump(label, span, true)
    ContinueStmt(span: span, label: label) => c.jump(label, span, false)
    ForStmt(label: label, pattern: pattern, iter: iter, bound: bound, body: body, go_range: go_range, ..) => {
      let it = c.infer(iter, -1)
      var elem = c.bad_ty
      if go_range {
        elem = c.go_range(s, it)
      } else {
        elem = c.iter_elem(it, iter)
      }
      c.check_loop_bound(bound, [iter])
      c.loop_body(label_name(label), false, body, [pattern], elem, false)
    }
    WhileStmt(label: label, cond: cond, pattern: pattern, value: value, bound: bound, body: body, ..) => {
      if !pattern.is_empty() {
        let vt = c.infer(value[0], -1)
        c.check_loop_bound(bound, [])
        c.loop_body(label_name(label), false, body, pattern, vt, true)
        return
      }
      if let Some(x) = cond {
        c.check_ty(x, c.named("Bool"))
      }
      c.check_loop_bound(bound, [])
      c.loop_body(label_name(label), cond == None, body, [], -1, false)
    }
    BadStmt(..) => {}
    // a body the lazy parse skipped, read without parse_body (decision
    // 0351): a compiler bug, never an empty body
    LazyStmt(..) => fault("a lazily parsed function body was read before parse_body")
  }
}

/// Checks a loop body, binding pat (zero or one) against pat_ty first;
/// whether a `break` left the loop.
fn (var c: Checker) loop_body(label: Bytes, infinite: Bool, body: Block, pat: List[Pattern], pat_ty: Int, refutable: Bool) -> Bool {
  c.ctxs[c.ctx].loops.push(LoopFrame{label: label})
  c.push_scope()
  if !pat.is_empty() {
    if refutable {
      c.refutable_pattern(pat[0], pat_ty)
    } else {
      let ip = c.pattern(pat[0], pat_ty, false)
      c.require_irrefutable(ip, pat_ty, pat[0], "a `for` pattern")
    }
  }
  c.block(body, discard())
  c.pop_scope()
  let n = c.ctxs[c.ctx].loops.len()
  let lf = c.ctxs[c.ctx].loops[n - 1]
  c.ctxs[c.ctx].loops.pop()
  lf.has_break
}

fn (var c: Checker) jump(label: Ident?, sp: Span, is_break: Bool) {
  let kw = if is_break { "break" } else { "continue" }
  let n = c.ctxs[c.ctx].loops.len()
  if n == 0 {
    c.error("XO0607", sp, "`${kw}` outside a loop")
    return
  }
  let l = match label {
    None => {
      if is_break {
        c.ctxs[c.ctx].loops[n - 1].has_break = true
      }
      return
    }
    Some(id) => id
  }
  var names: List[Str] = []
  var i = n - 1
  while i >= 0 {
    if c.ctxs[c.ctx].loops[i].label == l.name {
      if is_break {
        c.ctxs[c.ctx].loops[i].has_break = true
      }
      return
    }
    if !c.ctxs[c.ctx].loops[i].label.is_empty() {
      names.push(text(c.ctxs[c.ctx].loops[i].label))
    }
    i -= 1
  }
  let d = c.error("XO0607", l.span, "loop label `${text(l.name)}` not found")
  let s = nearest(text(l.name), names)
  if !s.is_empty() {
    c.note(d, "did you mean `${s[0]}`?")
  }
}

/// The element type of an iterable (List, Set, Map, Range, Chan, Buf,
/// Bytes).
fn (var c: Checker) iter_elem(t: Int, e: Expr) -> Int {
  let r = c.resolve(t)
  if c.is_bad(r) {
    return c.bad_ty
  }
  if c.tys[r].kind == TyKind.Named && c.objs[c.tys[r].obj].module == c.prelude {
    let n = text(c.objs[c.tys[r].obj].name)
    if n is "List" | "Set" | "Range" | "Buf" | "Chan" {
      return c.tys[r].args[0]
    }
    if n == "Bytes" {
      return c.named("UInt8")
    }
    if n == "Map" {
      return c.mk_tuple([c.tys[r].args[0], c.tys[r].args[1]])
    }
  }
  if c.tys[r].kind == TyKind.Var {
    c.error("XO0405", parser.expr_span(e), "the type of the iterated value must be known here")
    return c.bad_ty
  }
  c.error("XO0406", parser.expr_span(e), "cannot iterate over `${c.show(t)}`; `for` works on List, Set, Map, Chan, Bytes, and ranges")
  c.bad_ty
}

fn (var c: Checker) let_stmt(span: Span, pattern: Pattern, typ: Type?, value: Expr, is_var: Bool) {
  var t = -1
  if let Some(tt) = typ {
    var env = c.local_env()
    let w = c.resolve_type(tt, env)
    t = c.check_ty(value, w)
    if c.is_bad(t) {
      t = w
    }
  } else {
    t = c.infer(value, -1)
  }
  if pattern is WildcardPat(..) {
    if c.is_result(t) {
      // stmt.go discardNeedsReason
      let d = c.error("XO0206", span, "`let _ =` discards a Result, so its error is ignored without a reason")
      if d >= 0 {
        c.note(d, "the value can fail with `${c.show(c.result_e(t))}`; propagate with `?`, match on it, or discard it with `.ignore_err(\"reason\")`, which yields an optional and records the reason (core 2.6)")
        c.fix(d, "discard with a reason", c.ignore_err_edits(value))
      }
    }
  }
  if let BindPat(name: bname, ..) = pattern {
    c.check_name(bname, "variable")
  }
  // `var PATTERN` (decision 0384): every name the pattern binds is var
  c.pat_local = if is_var { "var" } else { "let" }
  let first = c.objs.len()
  let ip = c.pattern(pattern, t, false)
  c.pat_local = "let"
  c.require_irrefutable(ip, t, pattern, if is_var { "a `var` pattern" } else { "a `let` pattern" })
  // the names a pattern bound: the statement's span, for XO0502's fix
  // that writes `var` in place of `let`
  for o in first..c.objs.len() {
    if c.objs[o].kind == ObjKind.Local && c.objs[o].local == "let" {
      c.objs[o].let_span = span
    }
  }
  if let BindPat(name: name, ..) = pattern {
    let v = c.lookup_local(name.name)
    if v >= 0 {
      c.objs[v].let_span = span
      c.objs[v].let_value = [value]
      c.note_spawn_binding(value, v)
      c.note_group_binding(value, v)
    }
  }
}

/// Edits appending `.ignore_err("TODO: reason")` to e, parenthesized when
/// it is not a simple operand (stmt.go ignoreErrEdits).
fn (c: Checker) ignore_err_edits(e: Expr) -> List[DEdit] {
  let sp = parser.expr_span(e)
  let call = ".ignore_err(\"TODO: reason\")"
  if e is Ident(..) | CallExpr(..) | SelectorExpr(..) | IndexExpr(..) | TryExpr(..) | ParenExpr(..) | TypeArgsExpr(..) {
    return [c.insert_edit(sp.end, call)]
  }
  [c.insert_edit(sp.start, "("), c.insert_edit(sp.end, ")${call}")]
}

/// A block `const` (core 3.1): an immutable binding whose initializer is
/// a compile time value.
fn (var c: Checker) local_const(cd: parser.ConstDecl) {
  var t = -1
  if let Some(tt) = cd.typ {
    var env = c.local_env()
    let w = c.resolve_type(tt, env)
    t = c.check_ty(cd.value, w)
    if c.is_bad(t) {
      t = w
    }
  } else {
    t = c.infer(cd.value, -1)
  }
  let before = c.diags.len()
  c.check_const_expr(cd.value)
  let name = text(cd.name.name)
  if c.diags.len() > before && name.to_upper() != name {
    while c.diags.len() > before {
      c.diags.pop()
    }
    let d = c.error("XO0408", parser.expr_span(cd.value), "`const ${name}` is initialized with a value computed at run time")
    c.note(d, "a TypeScript and JavaScript `const` binding is Xo's `let`; an Xo `const` is a compile time UPPER_SNAKE constant (core 3.1)")
    let cs = cd.span.start
    c.fix(d, "write `let`", [c.replace_edit(Span{start: cs, end: parser.Pos{offset: cs.offset + 5, line: cs.line, col: cs.col + 5}}, "let")])
    let v = c.declare_local(cd.name, t, "let")
    c.objs[v].vctx = c.ctx
    return
  }
  c.check_name(cd.name, "constant")
  let v = c.declare_local(cd.name, t, "let")
  c.objs[v].is_const = true
  c.objs[v].const_val = [cd.value]
  c.objs[v].vctx = c.ctx
}

fn (var c: Checker) var_stmt(name: Ident, typ: Type?, value: Expr) {
  var t = -1
  if let Some(tt) = typ {
    var env = c.local_env()
    let w = c.resolve_type(tt, env)
    t = c.check_ty(value, w)
    if c.is_bad(t) {
      t = w
    }
  } else {
    t = c.infer(value, -1)
  }
  c.check_name(name, "variable")
  let v = c.declare_local(name, t, "var")
  c.objs[v].vctx = c.ctx
  c.note_spawn_binding(value, v)
  c.note_group_binding(value, v)
}

// ---------------------------------------------------------------------------
// Assignment (core 5.2, 3.4)

fn compound_op(k: parser.Kind) -> parser.Kind {
  match k {
    PlusAssign => parser.Kind.Plus
    MinusAssign => parser.Kind.Minus
    StarAssign => parser.Kind.Star
    SlashAssign => parser.Kind.Slash
    PercentAssign => parser.Kind.Percent
    AmpAssign => parser.Kind.Amp
    PipeAssign => parser.Kind.Pipe
    CaretAssign => parser.Kind.Caret
    ShlAssign => parser.Kind.Shl
    ShrAssign => parser.Kind.Shr
    _ => parser.Kind.Illegal
  }
}

fn (var c: Checker) assign(span: Span, op: parser.Kind, target: Expr, value: Expr) {
  if c.assign_decl_habit(op, target, value) {
    return
  }
  if op == parser.Kind.Assign {
    if let IndexExpr(..) = unparen(target) {
      c.map_store = c.expr_key(unparen(target))
    }
  }
  if op != parser.Kind.Assign {
    c.map_upd = c.expr_key(unparen(target))
    c.map_upd_op = op_text(op)
    c.map_upd_val = c.src_of(parser.expr_span(value))
    c.map_upd_span = Some(Span{start: parser.expr_span(target).start, end: parser.expr_span(value).end})
  }
  let tt = c.place_type(target)
  c.map_store = -1
  c.map_upd = -1
  c.require_mutable(target, "XO0502", "assignment")
  if op == parser.Kind.Assign {
    c.check_ty(value, tt)
    return
  }
  let bop = compound_op(op)
  let yt = c.infer(value, c.operand_hint(bop, tt))
  let rt = c.binary_type(bop, tt, yt, span)
  if !c.is_bad(rt) && !c.assignable(rt, tt, span) {
    c.error("XO0401", span, "`${op_text(op)}` produces `${c.show(rt)}`, which cannot be stored in `${c.show(tt)}`")
  }
}

/// Python's `x = v` for an undeclared x: XO0601, and x is declared from
/// then on (habits.go habitAssignDecl).
fn (var c: Checker) assign_decl_habit(op: parser.Kind, target: Expr, value: Expr) -> Bool {
  let id = match target {
    Ident(id) => id
    _ => return false
  }
  if op != parser.Kind.Assign || id.name == b"_" || c.lookup_local(id.name) >= 0 || c.lookup_module_obj(c.cur_mod, id.name) >= 0 || c.file_import(id.name) != None || c.ctx < 0 {
    return false
  }
  if (text(id.name)) is "true" | "false" | "target" | "self" | "os" | "expect" | "testing" {
    return false
  }
  let t = c.infer(value, -1)
  let n = text(id.name)
  let d = c.error("XO0601", id.span, "name `${n}` not found")
  c.habit_note(d, "`${n} = v` declares a variable in Python; Xo declares a name before assigning it: `var ${n} = v`, or `let ${n} = v` when it never changes (core 3.1)")
  c.fix(d, "declare with `var`", [c.insert_edit(id.span.start, "var ")])
  let v = c.declare_local(id, t, "var")
  c.objs[v].vctx = c.ctx
  true
}

/// The type of an assignment target, not counted as a read.
fn (var c: Checker) place_type(e: Expr) -> Int {
  match e {
    Ident(id) => {
      let v = c.lookup_local(id.name)
      if v < 0 {
        return c.infer(e, -1)
      }
      c.record(id, v)
      c.set_type(e, c.objs[v].ty)
      c.objs[v].ty
    }
    SelectorExpr(span: span, x: x, sel: sel) => {
      let bt = c.place_type(x)
      let t = c.field_of(bt, span, x, sel, true)
      c.set_type(e, t)
      t
    }
    IndexExpr(span: span, x: x, index: index) => {
      let bt = c.place_type(x)
      let t = c.index_type(bt, span, index)
      c.set_type(e, t)
      if c.is_prelude(bt, "Map") && c.map_store != c.expr_key(e) {
        let d = c.error("XO0410", span, "changing a Map element in place faults when the key is missing")
        c.map_update_fix(d, t, x, index, c.map_upd == c.expr_key(e))
      }
      t
    }
    ParenExpr(x: x, ..) => c.place_type(x)
    _ => {
      c.infer(e, -1)
      c.error("XO0502", parser.expr_span(e), "cannot assign to this expression; only bindings, fields, and elements of `var` bindings can be assigned")
      c.bad_ty
    }
  }
}

// ---------------------------------------------------------------------------
// Tasks: scopes and groups (core 7.1)

/// Records that a spawned task's handle is bound to v.
fn (var c: Checker) note_spawn_binding(e: Expr, v: Int) {
  if !(e is CallExpr(..)) {
    return
  }
  let key = c.expr_key(e)
  for sc in c.scopes {
    for (_, o) in sc.entries() {
      let f = c.objs[o].frame
      if f >= 0 {
        c.bind_spawn(f, key, v)
      }
    }
  }
  var x = c.ctx
  while x >= 0 {
    if c.ctxs[x].groups >= 0 {
      c.bind_spawn(c.ctxs[x].groups, key, v)
    }
    if c.ctxs[x].ext >= 0 {
      c.bind_spawn(c.ctxs[x].ext, key, v)
    }
    x = c.ctxs[x].parent
  }
}

fn (var c: Checker) bind_spawn(f: Int, key: Int, v: Int) {
  for (i, sp) in c.frames[f].spawns.indexed() {
    if sp.call == key {
      c.frames[f].spawns[i].bound = v
    }
  }
}

/// The frame of `h.group()` when e is one, else -1.
fn (c: Checker) group_call_frame(e: Expr) -> Int {
  if let CallExpr(fun: fun, args: args, ..) = e {
    if let SelectorExpr(x: x, sel: sel, ..) = fun {
      if sel.name == b"group" && args.is_empty() {
        if let Ident(id) = x {
          let v = c.lookup_local(id.name)
          if v >= 0 {
            return c.objs[v].frame
          }
        }
      }
    }
  }
  -1
}

/// Records that v holds the group created by `h.group()`.
fn (var c: Checker) note_group_binding(e: Expr, v: Int) {
  let x = unparen(e)
  let f = c.group_call_frame(x)
  if f >= 0 {
    c.objs[v].group_frame = f
    return
  }
  if let Ident(id) = x {
    let o = c.lookup_local(id.name)
    if o >= 0 && o != v && c.objs[o].group_frame >= 0 {
      c.objs[v].group_frame = c.objs[o].group_frame
    }
  }
}

/// The frame that owns the tasks of group recv, or -1 when its origin
/// is not visible here.
fn (var c: Checker) group_frame_of(recv: Expr) -> Int {
  let f = c.group_call_frame(recv)
  if f >= 0 {
    return f
  }
  match recv {
    ParenExpr(x: x, ..) => c.group_frame_of(x)
    Ident(id) => {
      let v = c.lookup_local(id.name)
      if v >= 0 {
        return c.objs[v].group_frame
      }
      -1
    }
    SelectorExpr(x: x, sel: sel, ..) => {
      // `os.tasks` of main or of a test: the root scope of that body
      let id = match x {
        Ident(i) => i
        _ => return -1
      }
      if sel.name != b"tasks" {
        return -1
      }
      let v = c.lookup_local(id.name)
      if v < 0 || c.objs[v].vctx < 0 || !c.is_os_value(v) {
        return -1
      }
      let vx = c.objs[v].vctx
      if c.ctxs[vx].groups < 0 {
        c.ctxs[vx].groups = c.frames.len()
        c.frames.push(ScopeFrame{ctx: vx})
      }
      c.ctxs[vx].groups
    }
    _ => -1
  }
}

/// Whether v is the `os` of a test or the `os: Os` parameter of `main`.
fn (c: Checker) is_os_value(v: Int) -> Bool {
  if c.objs[v].local == "predeclared" && c.objs[v].name == b"os" {
    return true
  }
  if !(c.objs[v].local is "param" | "var-param") || !c.is_prelude(c.objs[v].ty, "Os") {
    return false
  }
  let fo = c.ctxs[c.objs[v].vctx].fn_obj
  fo >= 0 && c.objs[fo].recv < 0 && c.objs[fo].name == b"main"
}

/// Notes a task started on a group for the failure rule.
fn (var c: Checker) record_group_spawn(recv: Expr, call: Expr) {
  let (span, _, args) = call_parts(call)
  if args.len() != 1 {
    return
  }
  let at = c.type_of(args[0].value)
  if at < 0 {
    return
  }
  let r = c.resolve(at)
  if c.tys[r].kind != TyKind.Func || c.tys[r].err < 0 {
    return
  }
  let site = Spawn{span: span, call: c.expr_key(call), err: c.tys[r].err}
  let f = c.group_frame_of(recv)
  if f >= 0 {
    c.frames[f].spawns.push(site)
    return
  }
  if c.ctxs[c.ctx].ext < 0 {
    c.ctxs[c.ctx].ext = c.frames.len()
    c.frames.push(ScopeFrame{ctx: c.ctx})
  }
  let e = c.ctxs[c.ctx].ext
  c.frames[e].spawns.push(site)
}

/// Applies the failure rule to the group tasks of a finished body.
fn (var c: Checker) finish_groups(x: Int) {
  let g = c.ctxs[x].groups
  if g >= 0 {
    for sp in c.frames[g].spawns {
      if sp.bound >= 0 && c.objs[sp.bound].awaited {
        continue
      }
      let saved = c.ctx
      c.ctx = x
      c.propagate(sp.err, sp.span, "XO0801", "this task")
      c.ctx = saved
    }
  }
  let ext = c.ctxs[x].ext
  if ext < 0 {
    return
  }
  for sp in c.frames[ext].spawns {
    if sp.bound >= 0 && c.objs[sp.bound].awaited {
      continue
    }
    let e = c.resolve(sp.err)
    if c.is_bad(e) || c.is_never(e) || c.is_open_var(e) {
      continue
    }
    let d = c.error("XO0801", sp.span, "a task started on a task group from outside this function can fail with `${c.show(e)}`; handle the error inside the task, or bind its handle and await it")
    c.note(d, "a failing group task fails the scope that created the group, which this function cannot see (core 7.1)")
  }
}

/// XO0410's note for `m[k] op= v` and `m[k].f = v`, and for a compound
/// assignment to a number or Str element its fix: `m.update(k, ZERO,
/// fn(var e) { e op= v })`, which starts a missing key at ZERO.
fn (var c: Checker) map_update_fix(d: Int, t: Int, m: Expr, k: Expr, compound: Bool) {
  let zero = if c.is_prelude(t, "Str") { "\"\"" } else if c.is_float(t) { "0.0" } else if c.is_int(t) { "0" } else { "" }
  if !compound || zero.is_empty() {
    c.note(d, "use `m.update(k, init, fn(var v) { ... })`, or assign the whole value with `m[k] = v` (core 3.6)")
    return
  }
  let sp = c.map_upd_span ?? return
  let ms = c.operand_src(m)
  let ks = c.src_of(parser.expr_span(k))
  let upd = "${ms}.update(${ks}, ${zero}, fn(var e) { e ${c.map_upd_op} ${c.map_upd_val} })"
  c.note(d, "`${upd}` starts a missing key at ${zero}; `m.get(k)` and `m.contains(k)` test for it (core 3.6, spec/std.md 2.4)")
  c.fix(d, "use update", [c.replace_edit(sp, upd)])
}
