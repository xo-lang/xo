// Names, selectors, and calls (internal/check/call.go): identifiers,
// module members, fields, methods, statics, variants, function values,
// conversions, and the matching of arguments to parameters.

use github.com/xo-lang/xo/compiler/lexer
use github.com/xo-lang/xo/compiler/parser

type Arg = parser.Arg

fn (c: Checker) in_test_context() -> Bool {
  (c.ctx >= 0 && c.ctxs[c.ctx].is_test) || (c.cur_file >= 0 && c.files[c.cur_file].is_test)
}

/// Marks a local as read and records the resolution; its type.
fn (var c: Checker) use_var(id: Ident, v: Int) -> Int {
  c.mark_used(v)
  c.record(id, v)
  c.objs[v].ty
}

/// A variant named name of the enum hint expects (core 2.3: the prefix
/// may be omitted when the expected type is known): (enum, position),
/// or (-1, -1).
fn (var c: Checker) variant_from_hint(name: Bytes, hint: Int) -> (Int, Int) {
  if hint < 0 {
    return (-1, -1)
  }
  let h = c.resolve(hint)
  if c.tys[h].kind != TyKind.Named {
    return (-1, -1)
  }
  let o = c.tys[h].obj
  if c.objs[o].tkind != "enum" {
    let el = c.option_elem(h)
    if el >= 0 {
      return c.variant_from_hint(name, el)
    }
    return (-1, -1)
  }
  let v = c.variant_pos(o, name)
  if v >= 0 {
    return (o, v)
  }
  (-1, -1)
}

/// Some, None, Ok, or Err: (enum, position), or (-1, -1).
fn (c: Checker) prelude_variant(name: Bytes) -> (Int, Int) {
  if name == b"Some" || name == b"None" {
    let o = c.prelude_obj("Option")
    return (o, c.variant_pos(o, name))
  }
  if name == b"Ok" || name == b"Err" {
    let o = c.prelude_obj("Result")
    return (o, c.variant_pos(o, name))
  }
  (-1, -1)
}

fn (var c: Checker) ident(id: Ident, hint: Int) -> Int {
  let name = id.name
  let v = c.lookup_local(name)
  if v >= 0 {
    return c.use_var(id, v)
  }
  if name == b"true" || name == b"false" {
    return c.named("Bool")
  }
  if name == b"target" {
    return c.named("Target")
  }
  if is_upper_camel(name) {
    let (e, vp) = c.variant_from_hint(name, hint)
    if e >= 0 {
      return c.construct(e, vp, [], false, [], hint, id.span, id, c.key_of(id.span, 0))
    }
    if name == b"None" {
      let (pe, pv) = c.prelude_variant(name)
      return c.construct(pe, pv, [], false, [], hint, id.span, id, c.key_of(id.span, 0))
    }
    let (pe, _) = c.prelude_variant(name)
    if pe >= 0 {
      c.error("XO0407", id.span, "`${text(name)}` needs an argument: `${text(name)}(x)`")
      return c.bad_ty
    }
  }
  if c.in_test_context() && name == b"testing" {
    c.error("XO0407", id.span, "`testing` is a module, not a value")
    return c.bad_ty
  }
  if c.file_import(name) != None {
    c.use_import(name)
    c.error("XO0407", id.span, "`${text(name)}` is a module, not a value")
    return c.bad_ty
  }
  let o = c.lookup_module_obj(c.cur_mod, name)
  if o >= 0 {
    match c.objs[o].kind {
      Func => {
        c.record(id, o)
        return c.func_value(o, [], false, id.span)
      }
      Const => {
        c.record(id, o)
        return c.const_type(o)
      }
      Type => {
        let d = c.error("XO0407", id.span, "`${text(name)}` is a type, not a value")
        if c.objs[o].tkind == "struct" && !c.objs[o].opaque {
          c.note(d, "build a value with a struct literal: `${text(name)}{...}`")
        }
        return c.bad_ty
      }
      TParam | Local | Module => {}
    }
  }
  if name == b"result" || name == b"old" {
    c.error("XO0601", id.span, "`${text(name)}` is only defined inside an `ensures` clause (core 9.1)")
    return c.bad_ty
  }
  if c.in_test_context() && name == b"expect" {
    c.error("XO0407", id.span, "`expect` must be called: `expect(x) == y`")
    return c.bad_ty
  }
  if (name == b"os" || name == b"expect") && !c.in_test_context() {
    let d = c.unresolved(id.span, "name", text(name), c.visible_value_names())
    c.note(d, "`${text(name)}` is predeclared only in test blocks (core 9.2); `main` receives `os: Os` as a parameter")
    return c.bad_ty
  }
  if is_upper_camel(name) && hint >= 0 {
    let h = c.resolve(hint)
    if c.tys[h].kind == TyKind.Named && c.objs[c.tys[h].obj].tkind == "enum" {
      let eo = c.tys[h].obj
      var cands: List[Str] = []
      for vi in c.objs[eo].variants {
        cands.push(text(vi.name))
      }
      c.unresolved(id.span, "variant of `${text(c.objs[eo].name)}`", text(name), cands)
      return c.bad_ty
    }
  }
  let (t, ok) = c.habit_name(id, hint)
  if ok {
    return t
  }
  let d = c.unresolved(id.span, "name", text(name), c.visible_value_names())
  c.std_import_hint(d, text(name))
  c.qualified_hint(d, text(name))
  c.bad_ty
}

/// When an unresolved name is a std module this file does not import
/// (`json.encode(x)` without `use std/json`): the note and fix that add
/// the `use`, ahead of qualified_hint's members of imported modules
/// that share the name (`http.json`), which are rarely what was meant.
fn (var c: Checker) std_import_hint(d: Int, name: Str) {
  if d < 0 || c.cur_file < 0 || name.is_empty() || name.contains("/") || name.contains(".") {
    return
  }
  let imps = c.files[c.cur_file].ast.imports
  if imps.any(fn(u) { text(u.path) == "std/${name}" }) {
    return
  }
  if (c.fs.read("${c.std_dir}/${name}.xo").ok() ?? None) == None {
    return
  }
  c.note(d, "`${name}` is the std module `std/${name}`: add `use std/${name}`")
  if imps.is_empty() {
    c.fix(d, "add `use std/${name}`", [c.insert_edit(parser.Pos{line: 1, col: 1, offset: 0}, "use std/${name}\n\n")])
  } else {
    c.fix(d, "add `use std/${name}`", [c.insert_edit(imps[imps.len() - 1].span.end, "\nuse std/${name}")])
  }
}

/// Notes where an unresolved name is declared when it exists in a std
/// module that must be named: `FsOp` is `testing.FsOp` (call.go
/// qualifiedHint).
fn (var c: Checker) qualified_hint(d: Int, name: Str) {
  if d < 0 {
    return
  }
  var paths: List[Str] = []
  for (p, _) in c.mod_index.entries() {
    paths.push(p)
  }
  for p in paths.sort() {
    let m = c.mod_index.get(p) ?? -1
    if !c.mods[m].is_std || c.mods[m].is_prelude {
      continue
    }
    if c.mods[m].members.contains(name.bytes()) {
      c.note(d, "`${name}` is declared in `${c.mods[m].path}`; refer to it as `${c.mods[m].name}.${name}` (core 2.3, 4.1)")
      if c.mods[m].name == "testing" && c.in_test_context() {
        let df = c.diags[d]
        c.fix(d, "qualify as `testing.${name}`", [DEdit{span: JSpan{file: df.file, line: df.line, col: df.col, end_line: df.line, end_col: df.col}, replace: "testing."}])
      }
    }
  }
}

/// The unresolved value names of other languages (habits.go habitName):
/// the diagnostic is the usual one, and the type keeps what follows from
/// cascading as the Go checker does.
fn (var c: Checker) habit_name(id: Ident, hint: Int) -> (Int, Bool) {
  let name = text(id.name)
  let null_lang = match name {
    "nil" => "Go and Swift"
    "null" => "TypeScript, Kotlin, and Java"
    "undefined" => "TypeScript"
    "NULL" => "C"
    "nullptr" => "C++"
    "Nil" => "Ruby"
    _ => ""
  }
  if !null_lang.is_empty() {
    let d = c.error("XO0601", id.span, "name `${name}` not found")
    c.habit_note(d, "`${name}` is ${null_lang}; Xo has no null: a value that may be absent is `T?`, written `None` when absent and handled with `?`, `??`, `if let`, or `match`; a failure is `Err(e)` in a function declared `-> T ! E` (core 2.5, 2.6)")
    if hint >= 0 && c.option_elem(hint) >= 0 {
      c.fix(d, "write `None`", [c.replace_edit(id.span, "None")])
      return (hint, true)
    }
    return (c.bad_ty, true)
  }
  if name is "this" | "self" {
    let recv = c.receiver_name()
    let d = c.error("XO0601", id.span, "name `${name}` not found")
    let lang = if name == "self" { "Python, Rust, and Swift" } else { "TypeScript, Kotlin, and Java" }
    if !recv.is_empty() && recv != name {
      c.habit_note(d, "`${name}` is the ${lang} receiver; an Xo method names its receiver, here `${recv}` (core 3.4)")
      c.fix(d, "write `${recv}`", [c.replace_edit(id.span, recv)])
      let v = c.lookup_local(recv.bytes())
      if v >= 0 {
        return (c.use_var(Ident{span: id.span, name: recv.bytes()}, v), true)
      }
      return (c.bad_ty, true)
    }
    c.habit_note(d, "`${name}` is the ${lang} receiver; Xo methods name their receiver, `fn (p: P) name()`, and plain functions have none (core 3.4)")
    return (c.bad_ty, true)
  }
  if name == "pass" {
    // Python's empty statement; a variable named `pass` resolves first.
    let d = c.error("XO0601", id.span, "name `${name}` not found")
    c.habit_note(d, "`pass` is Python's empty statement; an empty Xo block is `{}`, and the unit value is `()` (core 3.2)")
    c.fix(d, "write `()`", [c.replace_edit(id.span, "()")])
    return (c.unit_ty, true)
  }
  if name is "True" | "False" {
    let d = c.error("XO0601", id.span, "name `${name}` not found")
    c.habit_note(d, "`${name}` is Python syntax; Xo writes `${name.to_lower()}` (core 1.6)")
    c.fix(d, "write `${name.to_lower()}`", [c.replace_edit(id.span, name.to_lower())])
    return (c.named("Bool"), true)
  }
  (-1, false)
}

/// The receiver name of the method being checked (through closures).
fn (c: Checker) receiver_name() -> Str {
  var x = c.ctx
  while x >= 0 {
    let fo = c.ctxs[x].fn_obj
    if fo >= 0 && !c.objs[fo].fn_decl.is_empty() {
      if let Some(r) = c.objs[fo].fn_decl[0].recv {
        return text(r.name.name)
      }
    }
    x = c.ctxs[x].parent
  }
  ""
}

/// The function type of fo (without receiver).
fn (var c: Checker) sig_of(fo: Int) -> Int {
  var ps: List[Int] = []
  var vs: List[Bool] = []
  for p in c.objs[fo].params {
    ps.push(p.ty)
    vs.push(p.is_var)
  }
  var eff = c.objs[fo].declared
  if eff < 0 {
    // the inferred effects of a non pub function, which Type.String
    // does not print
    eff = c.new_eset([EffItem{fn_obj: fo}])
  }
  c.mk_func(ps, vs, c.objs[fo].result, c.objs[fo].err, eff)
}

/// A declared function used as a value: its type parameters are
/// instantiated with fresh variables (or targs).
fn (var c: Checker) func_value(fo: Int, targs: List[Int], has_targs: Bool, sp: Span) -> Int {
  if !c.objs[fo].sig_done {
    return c.bad_ty
  }
  c.check_ceiling(fo, sp)
  let sm = c.fresh_subst(fo, {}, targs, has_targs, sp)
  var ft = c.subst(c.sig_of(fo), sm)
  let e = c.tys[ft].err
  if e >= 0 && c.is_never(e) {
    ft = c.mk_func(c.tys[ft].args, c.tys[ft].vars, c.tys[ft].result, -1, c.tys[ft].eff)
  }
  ft
}

/// Maps the type parameters of fo not already in pre to explicit type
/// arguments (its own parameters) or fresh variables.
fn (var c: Checker) fresh_subst(fo: Int, pre: Subst, targs0: List[Int], has_targs0: Bool, sp: Span) -> Subst {
  var sm = pre
  var targs = targs0
  var has_targs = has_targs0
  let tps = c.objs[fo].tparams
  var type_own = 0
  for p in tps {
    if !c.objs[p].implicit && !c.objs[p].effect {
      type_own += 1
    }
  }
  if has_targs && targs.len() != type_own {
    c.error("XO0403", sp, "`${c.display_name(fo)}` takes ${type_own} type argument(s), found ${targs.len()}")
    targs = []
    has_targs = false
  }
  var i = 0
  for p in tps {
    if sm.contains(p) {
      continue
    }
    if c.objs[p].effect {
      sm[p] = c.call_effarg()
      continue
    }
    if has_targs && !c.objs[p].implicit {
      sm[p] = targs[i]
      i += 1
      continue
    }
    sm[p] = c.new_var()
  }
  sm
}

// ---------------------------------------------------------------------------
// Selectors

fn (var c: Checker) selector(span: Span, x: Expr, sel: Ident, hint: Int) -> Int {
  if let Ident(id) = x {
    if c.lookup_local(id.name) < 0 {
      if let Some(imp) = c.file_import(id.name) {
        c.use_import(id.name)
        if imp.module >= 0 {
          c.record(id, c.mods[imp.module].obj)
        }
        return c.module_member(imp.module, id.name, span, sel, [], false, hint)
      }
      if id.name == b"testing" && c.in_test_context() {
        let tm = c.testing_mod()
        if tm >= 0 {
          c.record(id, c.mods[tm].obj)
        }
        return c.module_member(tm, b"testing", span, sel, [], false, hint)
      }
    }
  }
  let r = c.type_of_expr(x)
  if r.obj >= 0 {
    return c.type_member(r.obj, r.args, r.has_args, span, x, sel, hint, [])
  }
  let bt = c.infer(x, -1)
  c.safe_nav_fix(span, x, sel)
  c.field_of(bt, span, x, sel, false)
}

/// The fix of the XO0205 of a one step optional chain, `u?.name` with
/// nothing chained after it: `u.map(fn(u) { u.name })` (habits.go
/// safeNavFix).
fn (var c: Checker) safe_nav_fix(span: Span, x: Expr, sel: Ident) {
  let (tsp, inner) = match x {
    TryExpr(span: tsp, x: inner) => (tsp, inner)
    _ => return
  }
  let key = c.key_of(tsp, 23)
  if !c.safe_navs.contains(key) {
    return
  }
  let id = match inner {
    Ident(id) => id
    _ => return
  }
  let i = c.safe_nav_diag.get(key) ?? -1
  if i < 0 || i >= c.diags.len() {
    return
  }
  let src = c.files[c.cur_file].src
  let e = span.end.offset
  if e < src.len() && find_in(b".([?", src[e..e + 1], 0) >= 0 {
    return
  }
  if c.diags[i].code != "XO0205" || !c.diags[i].fixes.is_empty() {
    return
  }
  let n = text(id.name)
  c.fix(i, "write `.map(...)`", [c.replace_edit(span, "${n}.map(fn(${n}) { ${n}.${text(sel.name)} })")])
}

fn (c: Checker) pub_in(o: Int, m: Int) -> Bool {
  if m == c.cur_mod || c.mods[m].is_std {
    return true
  }
  match c.objs[o].kind {
    Func | Const | Type => c.objs[o].is_pub
    TParam | Local | Module => true
  }
}

fn (var c: Checker) module_member(m: Int, imp_name: Bytes, span: Span, sel: Ident, targs: List[Int], has_targs: Bool, hint: Int) -> Int {
  if m < 0 {
    return c.bad_ty
  }
  let name = sel.name
  let o = c.mods[m].members.get(name) ?? -1
  if o < 0 {
    if c.go_skipped(m, text(name), sel.span) || c.c_skipped(m, text(name), sel.span) {
      return c.bad_ty
    }
    let d = c.unresolved(sel.span, "member of module `${text(imp_name)}`", text(name), sorted_names(c.mods[m].members))
    c.module_member_habit(d, c.mods[m].path, text(name))
    return c.bad_ty
  }
  if !c.pub_in(o, m) {
    c.pub_fix(c.error("XO0605", sel.span, "`${text(name)}` is not `pub` in module `${c.mods[m].path}`"), o)
  }
  c.portable_check(m, sel)
  match c.objs[o].kind {
    Func => {
      c.record(sel, o)
      return c.func_value(o, targs, has_targs, span)
    }
    Const => {
      c.record(sel, o)
      return c.const_type(o)
    }
    Type => c.error("XO0407", span, "`${text(imp_name)}.${text(name)}` is a type, not a value")
    TParam | Local | Module => {}
  }
  c.bad_ty
}

/// `Type.Variant`, `Type.CONST`, or a static function used as a value
/// or called (call is the CallExpr, zero or one element).
fn (var c: Checker) type_member(obj0: Int, targs0: List[Int], has_targs0: Bool, span: Span, x: Expr, sel: Ident, hint: Int, call: List[Expr]) -> Int {
  var obj = obj0
  var targs = targs0
  var has_targs = has_targs0
  if c.objs[obj].tkind == "alias" {
    let r = c.alias_named(obj, targs, has_targs, parser.expr_span(x))
    if r.obj < 0 {
      return c.bad_ty
    }
    obj = r.obj
    targs = r.args
    has_targs = r.has_args
  }
  let name = sel.name
  if c.objs[obj].tkind == "enum" {
    let v = c.variant_pos(obj, name)
    if v >= 0 {
      return c.construct(obj, v, targs, has_targs, call, hint, span, sel, c.key_of(span, 19))
    }
  }
  let fo = c.objs[obj].statics.get(name) ?? -1
  if fo >= 0 && c.objs[fo].kind == ObjKind.Const {
    // a type constant, `Int.max` (decision 0587)
    c.record(sel, fo)
    if !call.is_empty() {
      let d = c.error("XO0407", parser.expr_span(call[0]), "`${text(c.objs[obj].name)}.${text(name)}` is a constant, not a function")
      if name == b"max" || name == b"min" {
        c.note(d, "the larger or smaller of two values is the method: `a.${text(name)}(b)`")
      }
      return c.bad_ty
    }
    return c.const_type(fo)
  }
  if fo >= 0 {
    c.record(sel, fo)
    if c.objs[fo].static_const {
      if !call.is_empty() {
        c.error("XO0407", parser.expr_span(call[0]), "`${text(c.objs[obj].name)}.${text(name)}` is a constant, not a function")
        return c.bad_ty
      }
      return c.objs[fo].result
    }
    if !call.is_empty() {
      return c.call_static(obj, targs, has_targs, fo, call[0], hint)
    }
    let pre = c.static_subst(obj, targs, has_targs, fo)
    return c.subst(c.sig_of(fo), c.fresh_subst(fo, pre, [], false, span))
  }
  var cands: List[Str] = []
  for vi in c.objs[obj].variants {
    cands.push(text(vi.name))
  }
  for (n, _) in c.objs[obj].statics.entries() {
    cands.push(text(n))
  }
  var what = "associated function or constant of `${c.qual_name(obj)}`"
  if c.objs[obj].tkind == "enum" {
    what = "variant of `${c.qual_name(obj)}`"
  }
  let d = c.unresolved(sel.span, what, text(name), cands.sort())
  if d >= 0 && nearest(text(name), cands).is_empty() {
    c.statics_note(d, obj, text(name), cands)
  }
  let is_method = c.objs[obj].methods.contains(name)
  if d >= 0 && is_method {
    c.note(d, "`${text(name)}` is a method; call it on a value of type `${text(c.objs[obj].name)}`")
  }
  if d >= 0 && !is_method && c.objs[obj].module != c.prelude {
    // Associated functions other languages have (decision 0087).
    let on = text(c.objs[obj].name)
    if name == b"new" {
      c.habit_note(d, "`${on}::new(...)` is a Rust and Swift constructor; Xo builds a struct with a literal naming every field, `${on}{field: value}`, or with a plain function such as `new_${to_snake(c.objs[obj].name)}(...)` (core 2.2)")
    } else if name == b"parse" {
      c.habit_note(d, "`${on}` has no `parse` in the std library (spec/std.md); parse the parts yourself, for example `Int.parse(s)` and `1s * n` for a duration")
    }
  }
  if !call.is_empty() {
    c.numeric_conversion_hint(d, obj, span, call[0])
  }
  c.bad_ty
}

/// The conversion a missing associated function of a prelude type was
/// meant to be (agents wrote `Str.from_bytes`, `Bytes.from_list` and
/// `Int.wrapping_from`, 2026-11-08: nine XO0601 in one file, each with no
/// "did you mean" since no name is close), or "".
fn conversion_hint(on: Str, name: Str) -> Str {
  if on == "Str" && (name == "from_bytes" || name == "from_utf8" || name == "from_utf8_lossy") {
    return "a Str from Bytes is `b.to_str()` (None if not valid UTF-8) or `b.to_str_lossy()` (spec/std.md 2.2)"
  }
  if on == "Bytes" && (name == "from_str" || name == "from_string" || name == "from" || name == "from_list" || name == "from_utf8") {
    return "Bytes from a Str is `s.bytes()`; from numbers, write them to a `BytesBuilder` (`write_byte`) or use a literal `b\"...\"` (spec/std.md 2.2)"
  }
  if on == "Int" && name == "wrapping_from" {
    return "`wrapping_from` belongs to the sized integer types (`UInt8.wrapping_from(n)`); to get an Int from any number write `Int(x)` (spec/std.md 2.1)"
  }
  ""
}

/// A note on d for an associated function no name is close to: the
/// conversion it was meant to be, else the type's variants, associated
/// functions and constants (the first 12, then `xo doc`), as neighbours_note
/// does for a method.
fn (var c: Checker) statics_note(d: Int, obj: Int, name: Str, cands: List[Str]) {
  let on = text(c.objs[obj].name)
  let lname = name.to_lower()
  if c.objs[obj].module == c.prelude && c.objs[obj].statics.contains(b"max") && (lname.starts_with("max") || lname.starts_with("min")) {
    // Java's Long.MAX_VALUE, C#'s int.MaxValue (owner tester, 2026-11-10):
    // the bounds are the type constants `T.max` and `T.min` (decision 0587)
    let w = if lname.starts_with("max") { "max" } else { "min" }
    c.habit_note(d, "the bounds of `${on}` are the type constants `${on}.max` and `${on}.min`; `a.${w}(b)` is the ${if w == "max" { "larger" } else { "smaller" }} of two values (spec/std.md 2.1)")
    return
  }
  if c.objs[obj].module == c.prelude {
    let h = conversion_hint(on, name)
    if !h.is_empty() {
      c.note(d, h)
      return
    }
  }
  if cands.is_empty() {
    c.note(d, "`${on}` has no associated functions or constants (`xo doc ${on}` lists its methods)")
    return
  }
  let shown = if cands.len() > 12 { "${cands[0..12].join(", ")}, ... (`xo doc ${on}` lists all ${cands.len()})" } else { cands.join(", ") }
  c.note(d, "`${on}` has ${shown}")
}

/// `Float.from(n)` (call.go numericConversionHint): an associated
/// function that does not exist, called on a numeric type with one
/// numeric argument, is the conversion `Float(n)`; its fix comes first.
/// The argument is checked here (the failed call does not check it).
fn (var c: Checker) numeric_conversion_hint(d: Int, obj: Int, sel_span: Span, call: Expr) {
  if d < 0 || c.objs[obj].module != c.prelude || (!is_int_name(c.objs[obj].name) && !is_float_name(c.objs[obj].name)) {
    return
  }
  if let CallExpr(args: args, ..) = call {
    if args.len() != 1 || args[0].name != None {
      return
    }
    if unparen(args[0].value) is FnLit(..) {
      return
    }
    // bound first: is_numeric's receiver is read before its argument
    // (receiver-read-before-args), and infer may add types
    let at = c.infer(args[0].value, -1)
    if !c.is_numeric(at) {
      return
    }
    let on = text(c.objs[obj].name)
    c.note(d, "convert with `${on}(x)`: a numeric conversion is a call on the type name, from any numeric type (std.md 2.1)")
    var fixes = [DFix{title: "convert with `${on}(x)`", edits: [c.replace_edit(sel_span, on)]}]
    for f in c.diags[d].fixes {
      fixes.push(f)
    }
    c.diags[d].fixes = fixes
  }
}

/// The implicit receiver parameters of a static function bound to the
/// type arguments written on the type (or fresh variables).
fn (var c: Checker) static_subst(obj: Int, targs: List[Int], has_targs: Bool, fo: Int) -> Subst {
  var sm: Subst = {}
  let rt = c.objs[fo].recv_ty
  if rt < 0 || c.tys[rt].kind != TyKind.Named {
    return sm
  }
  for (i, a) in c.tys[rt].args.indexed() {
    if c.tys[a].kind != TyKind.Param || !c.objs[c.tys[a].obj].implicit {
      continue
    }
    if has_targs && i < targs.len() {
      sm[c.tys[a].obj] = targs[i]
    } else {
      sm[c.tys[a].obj] = c.new_var()
    }
  }
  for (i, a) in c.tys[rt].args.indexed() {
    let ax = c.tys[a]
    if ax.kind != TyKind.EffArg || ax.eff < 0 || c.esets[ax.eff].len() != 1 || c.esets[ax.eff][0].param < 0 {
      continue
    }
    let p = c.esets[ax.eff][0].param
    if has_targs && i < targs.len() && c.tys[targs[i]].kind == TyKind.EffArg {
      sm[p] = targs[i]
      continue
    }
    sm[p] = c.call_effarg()
  }
  sm
}

fn (var c: Checker) call_static(obj: Int, targs0: List[Int], has_targs0: Bool, fo: Int, call: Expr, hint: Int) -> Int {
  var targs = targs0
  var has_targs = has_targs0
  if has_targs && targs.len() != c.objs[obj].tparams.len() {
    if let CallExpr(fun: fun, ..) = call {
      c.error("XO0403", parser.expr_span(fun), "`${c.qual_name(obj)}` takes ${c.objs[obj].tparams.len()} type argument(s), found ${targs.len()}")
    }
    targs = []
    has_targs = false
  }
  c.call_func(fo, c.static_subst(obj, targs, has_targs, fo), [], false, call, hint, [])
}

fn is_tuple_index(name: Bytes) -> Bool {
  if name.is_empty() {
    return false
  }
  for i in 0..name.len() {
    if name[i] < '0' || name[i] > '9' {
      return false
    }
  }
  true
}

fn (var c: Checker) field_of(bt: Int, span: Span, x: Expr, sel: Ident, place: Bool) -> Int {
  let r = c.resolve(bt)
  let name = sel.name
  if c.is_bad(r) {
    return c.bad_ty
  }
  let k = c.tys[r].kind
  if k == TyKind.Var {
    c.error("XO0405", parser.expr_span(x), "the type of this value must be known before `.${text(name)}`; annotate it")
    return c.bad_ty
  }
  if k == TyKind.Tuple && is_tuple_index(name) {
    let i = Int.parse(text(name)) ?? 1000000
    let els = c.tys[r].args
    if i < els.len() {
      return els[i]
    }
    c.error("XO0601", sel.span, "tuple `${c.show(r)}` has no field `${text(name)}`; its fields are `.0` to `.${els.len() - 1}`")
    return c.bad_ty
  }
  if k == TyKind.Named {
    let o = c.tys[r].obj
    if c.objs[o].tkind == "newtype" && is_tuple_index(name) {
      if name == b"0" {
        return c.subst(c.objs[o].target, c.args_subst(c.objs[o].tparams, c.tys[r].args))
      }
      c.error("XO0601", sel.span, "newtype `${c.show(r)}` has one field, `.0`")
      return c.bad_ty
    }
    if c.objs[o].module == c.prelude && c.objs[o].name == b"Task" && name == b"await" && !place {
      if let Ident(id) = x {
        let v = c.lookup_local(id.name)
        if v >= 0 {
          c.objs[v].awaited = true
        }
      }
      return c.call_result(c.tys[r].args[0], c.tys[r].args[1])
    }
    if c.objs[o].tkind == "struct" && !c.objs[o].opaque {
      let fi = c.field_index(o, name)
      if fi >= 0 {
        let f = c.objs[o].fields[fi]
        c.record_text(sel, c.field_text(o, f))
        if c.field_hidden(o, f.is_pub) {
          c.internal_note(c.error("XO0605", sel.span, "field `${text(name)}` of `${text(c.objs[o].name)}` is not `pub`"), o)
        }
        return c.subst(f.ty, c.args_subst(c.objs[o].tparams, c.tys[r].args))
      }
    }
  }
  if !place {
    let (m, sm) = c.find_method(r, text(name))
    if m >= 0 {
      c.record(sel, m)
      if c.objs[m].recv_var {
        c.error("XO0407", span, "method `${text(name)}` mutates its receiver and cannot be used as a value")
        return c.bad_ty
      }
      let fs = c.fresh_subst(m, sm, [], false, span)
      // the substitution of a method value (check.go rec.subst, read
      // by the SSA builder's method values)
      c.ref_subst[c.key_of(span, 19)] = fs
      return c.subst(c.sig_of(m), fs)
    }
  }
  let (t, ok) = c.habit_field(bt, span, x, sel, place)
  if ok {
    return t
  }
  c.no_member(r, sel, place)
  c.bad_ty
}

/// `xs.length` and friends (habits.go habitField): XO0601, then the
/// method call it stands for.
fn (var c: Checker) habit_field(bt: Int, span: Span, x: Expr, sel: Ident, place: Bool) -> (Int, Bool) {
  if place {
    return (-1, false)
  }
  if sel.name == b"0" && c.show(bt) == "uuid.Uuid" {
    // the text 0.33.0 deprecated (XO0912, decision 0387)
    let d = c.error("XO0601", sel.span, "`uuid.Uuid` has no field `0`: a Uuid is two Ints since 0.34.0, and `u.display()` is its text (decision 0387)")
    c.note(d, "`u.bytes()` gives its 16 bytes, `uuid.parse(s)` makes a Uuid from a text, and `u < v` orders Uuids as their bytes (spec/std.md 24)")
    c.fix(d, "write `.display()`", [c.replace_edit(sel.span, "display()")])
    return (c.bad_ty, true)
  }
  if c.is_prelude(bt, "Os") && (text(sel.name) is "args" | "argv" | "Args") {
    return (c.os_args_habit(span, x, sel), true)
  }
  let xo = match text(sel.name) {
    "length" | "count" | "size" => "len"
    "isEmpty" => "is_empty"
    _ => return (-1, false)
  }
  let r = c.resolve(bt)
  let (m, _) = c.find_method_any(r, xo)
  if m < 0 {
    return (-1, false)
  }
  let d = c.error("XO0601", sel.span, "`${c.show(bt)}` has no field `${text(sel.name)}`")
  c.habit_note(d, "`.${text(sel.name)}` is a property in TypeScript, Swift, and Kotlin; in Xo it is a method call, `.${xo}()` (spec/std.md 2)")
  c.fix(d, "write `.${xo}()`", [c.replace_edit(sel.span, "${xo}()")])
  let nsel = Ident{span: sel.span, name: xo.bytes()}
  let call = Expr.CallExpr(span: span, fun: Expr.SelectorExpr(span: span, x: x, sel: nsel), args: [])
  (c.call_method(bt, span, x, nsel, [], false, call, -1), true)
}

/// Whether a field of struct o that is (or is not) `pub` is hidden from
/// the module being checked (XO0605): another module's non-pub field; std's
/// modules and their native implementations see each other's, including
/// an `@internal` struct's (decision 0440).
fn (c: Checker) field_hidden(o: Int, is_pub: Bool) -> Bool {
  let m = c.objs[o].module
  let cm = c.cur_mod
  !is_pub && m != cm && !((c.mods[m].is_std || c.mods[m].native) && (c.mods[cm].is_std || c.mods[cm].native))
}

/// The note on XO0605 for a field of an `@internal` std struct: its
/// fields are std's, and the public way, from its doc (decision 0440).
fn (var c: Checker) internal_note(d: Int, o: Int) {
  if d < 0 || !c.objs[o].std_internal {
    return
  }
  let way = c.objs[o].internal_hint
  c.note(d, "the fields of `${c.qual_name(o)}` are private to std (decision 0440)${if way.is_empty() { "" } else { "; ${way}" }}")
}

/// `os.args` (Go's os.Args, Python's sys.argv) and `os.args()`: XO0601
/// naming `os.env.args()`, which leaves out the program name (decision
/// 0438). No fix: `os.args[1]` becomes `os.env.args()[0]`, so a rewrite
/// of the name alone changes an index's meaning. The value checks as
/// `x.env.args()`.
fn (var c: Checker) os_args_habit(span: Span, x: Expr, sel: Ident) -> Int {
  let d = c.error("XO0601", sel.span, "`Os` has no field or method `${text(sel.name)}`")
  c.habit_note(d, "did you mean `os.env.args()`? it leaves out the program name, so Go's `os.Args[1]` is `os.env.args()[0]`; `os.env.program()` is the name (spec/std.md 3)")
  let env = Expr.SelectorExpr(span: span, x: x, sel: Ident{span: sel.span, name: b"env"})
  let call = Expr.CallExpr(span: span, fun: Expr.SelectorExpr(span: span, x: env, sel: Ident{span: sel.span, name: b"args"}), args: [])
  c.infer(call, -1)
}

/// XO0601 for a missing field or method (call.go noMember).
fn (var c: Checker) no_member(t: Int, sel: Ident, place: Bool) {
  let what = if place { "field" } else { "field or method" }
  var cands: List[Str] = []
  let r = c.resolve(t)
  if c.tys[r].kind == TyKind.Named {
    let o = c.tys[r].obj
    if c.go_skipped(c.objs[o].module, "${text(c.objs[o].name)}.${text(sel.name)}", sel.span) {
      return
    }
  }
  if c.tys[r].kind == TyKind.Named {
    let o = c.tys[r].obj
    if c.objs[o].tkind == "struct" && !c.objs[o].opaque {
      for f in c.objs[o].fields {
        cands.push(text(f.name))
      }
    }
    if !place {
      for (n, _) in c.objs[o].methods.entries() {
        cands.push(text(n))
      }
      for m in c.objs[o].iface_meths {
        cands.push(text(c.objs[m].name))
      }
    }
  }
  let d = c.unresolved(sel.span, "${what} of `${c.show(t)}`", text(sel.name), cands.sort())
  if d >= 0 {
    c.fake_method_note(d, t, text(sel.name))
    if nearest(text(sel.name), cands).is_empty() {
      c.neighbours_note(d, t, text(sel.name), cands, place)
    }
    let inner = c.option_elem(t)
    if inner >= 0 {
      let (m, _) = c.find_method(inner, text(sel.name))
      if m >= 0 {
        c.note(d, "the value is optional; unwrap it first with `?`, `??`, `if let`, or `match` (core 2.5)")
      }
    }
    if c.is_result(t) {
      let (m, _) = c.find_method(c.result_t(t), text(sel.name))
      if m >= 0 {
        c.note(d, "the value is a Result; propagate with `?` first")
        c.fix(d, "propagate with ?", [DEdit{span: JSpan{file: c.path, line: sel.span.start.line, col: sel.span.start.col - 1, end_line: sel.span.start.line, end_col: sel.span.start.col - 1}, replace: "?"}])
      }
    }
  }
}

/// The test fake of each capability (std/testing, spec/std.md 8.1).
fn capability_fake(name: Str) -> Str {
  match name {
    "Net" => "FakeNet"
    "Clock" => "FakeClock"
    "Fs" => "MemFs"
    "Env" => "FakeEnv"
    "Stdio" => "FakeStdio"
    "Proc" => "FakeProc"
    _ => ""
  }
}

/// A note on d when capability t lacks method name but its test fake has
/// it (a control method such as FakeNet's `handle`): the helper must take
/// the fake (owner, 2026-11-05, from the agents' survey: aws-19's helper
/// took `n: Net` to register handlers and was told only that `Net` has no
/// method `handle`).
fn (var c: Checker) fake_method_note(d: Int, t: Int, name: Str) {
  let r = c.resolve(t)
  if c.tys[r].kind != TyKind.Named || !c.is_prelude(r, text(c.objs[c.tys[r].obj].name)) {
    return
  }
  let fake = capability_fake(text(c.objs[c.tys[r].obj].name))
  let tm = c.testing_mod()
  if fake.is_empty() || tm < 0 {
    return
  }
  let fo = c.lookup_module_obj(tm, fake.bytes())
  if fo < 0 || c.objs[fo].kind != ObjKind.Type || !c.objs[fo].methods.contains(name.bytes()) {
    return
  }
  c.note(d, "did you mean `testing.${fake}`? `${name}` is a method of the test fake, which a test's `os.${fake_field(fake)}` is; a helper that calls it takes `testing.${fake}`, not `${c.show(t)}` (spec/std.md 8.1)")
}

/// The prelude number types a method missing on one may be found on.
const NUMBER_TYPES: List[Str] = ["Int", "Float", "Float32", "Int8", "Int16", "Int32", "UInt8", "UInt16", "UInt32", "UInt64", "Rune"]

/// When no name is close to name (no "did you mean"): a note naming what
/// t does have, its fields and methods (the first 12, then `xo doc`), or
/// that it has none, and the number type that has name when t is one
/// (owner, 2026-11-05, from the agents' survey: `Float32.to_bits` got a
/// bare XO0601, and `Float32` has no methods).
fn (var c: Checker) neighbours_note(d: Int, t: Int, name: Str, cands: List[Str], place: Bool) {
  let r = c.resolve(t)
  if c.tys[r].kind != TyKind.Named {
    return
  }
  let tn = c.show(t)
  if NUMBER_TYPES.contains(tn) && c.is_prelude(r, tn) && c.prelude >= 0 {
    var has: List[Str] = []
    for other in NUMBER_TYPES {
      if other == tn {
        continue
      }
      let o = c.lookup_module_obj(c.prelude, other.bytes())
      if o >= 0 && c.objs[o].methods.contains(name.bytes()) {
        has.push("`${other}`")
      }
    }
    if !has.is_empty() {
      c.note(d, "`${name}` is a method of ${has.join(", ")}, not of `${tn}` (spec/std.md 2.1)")
    }
  }
  let what = if place { "fields" } else { "fields or methods on a value" }
  if cands.is_empty() {
    c.note(d, "`${tn}` has no ${what} (`xo doc ${tn}` lists its static functions)")
    return
  }
  let shown = if cands.len() > 12 { "${cands[0..12].join(", ")}, ... (`xo doc ${tn}` lists all ${cands.len()})" } else { cands.join(", ") }
  c.note(d, "`${tn}` has ${shown}")
}

/// The TestOs field holding fake (std/testing.xo).
fn fake_field(fake: Str) -> Str {
  match fake {
    "FakeNet" => "net"
    "FakeClock" => "clock"
    "MemFs" => "fs"
    "FakeEnv" => "env"
    "FakeStdio" => "stdio"
    "FakeSecrets" => "secrets"
    _ => "proc"
  }
}

/// `f[T]` outside a call: a generic function value.
fn (var c: Checker) type_args_value(span: Span, x: Expr, types: List[Type], hint: Int) -> Int {
  let targs = c.resolve_type_args(types)
  match x {
    Ident(id) => {
      let o = c.lookup_module_obj(c.cur_mod, id.name)
      if o >= 0 && c.objs[o].kind == ObjKind.Func && c.lookup_local(id.name) < 0 {
        c.record(id, o)
        return c.func_value(o, targs, true, span)
      }
    }
    SelectorExpr(span: sspan, x: inner, sel: sel) => {
      if let Ident(id) = inner {
        if c.lookup_local(id.name) < 0 {
          if let Some(imp) = c.file_import(id.name) {
            c.use_import(id.name)
            if imp.module >= 0 {
              c.record(id, c.mods[imp.module].obj)
            }
            return c.module_member(imp.module, id.name, sspan, sel, targs, true, hint)
          }
        }
      }
    }
    _ => {}
  }
  let r = c.type_of_expr(Expr.TypeArgsExpr(span: span, x: x, types: types))
  if r.obj >= 0 {
    c.error("XO0407", span, "a type is not a value")
    return c.bad_ty
  }
  c.infer(x, -1)
  c.error("XO0407", span, "type arguments are only allowed on generic functions and types")
  c.bad_ty
}

fn (var c: Checker) resolve_type_args(ts: List[Type]) -> List[Int] {
  var env = c.local_env()
  var out: List[Int] = []
  for t in ts {
    out.push(c.resolve_type(t, env))
  }
  out
}

// ---------------------------------------------------------------------------
// Calls

fn unparen(e: Expr) -> Expr {
  match e {
    ParenExpr(x: x, ..) => unparen(x)
    _ => e
  }
}

fn (var c: Checker) call(e: Expr, span: Span, fun: Expr, args: List[Arg], hint: Int) -> Int {
  match fun {
    Ident(id) => return c.call_ident(e, id, [], false, hint)
    SelectorExpr(span: sspan, x: x, sel: sel) => return c.call_selector(e, sspan, x, sel, [], false, hint)
    TypeArgsExpr(x: x, types: types, ..) => {
      let targs = c.resolve_type_args(types)
      match x {
        Ident(id) => return c.call_ident(e, id, targs, true, hint)
        SelectorExpr(span: sspan, x: inner, sel: sel) => return c.call_selector(e, sspan, inner, sel, targs, true, hint)
        _ => {}
      }
    }
    _ => {}
  }
  let ft = c.infer(fun, -1)
  c.call_value(ft, e, hint, "")
}

fn call_parts(call: Expr) -> (Span, Expr, List[Arg]) {
  match call {
    CallExpr(span: span, fun: fun, args: args) => (span, fun, args)
    _ => fault("not a call")
  }
}

fn (var c: Checker) call_ident(call: Expr, id: Ident, targs: List[Int], has_targs: Bool, hint: Int) -> Int {
  let (span, fun, args) = call_parts(call)
  let name = id.name
  let v = c.lookup_local(name)
  if v >= 0 {
    let t = c.use_var(id, v)
    if has_targs {
      c.error("XO0407", parser.expr_span(fun), "`${text(name)}` is a value and takes no type arguments")
    }
    return c.call_value(t, call, hint, text(name))
  }
  if name == b"expect" && c.in_test_context() && !c.mods[c.cur_mod].members.contains(name) {
    if args.len() != 1 {
      c.error("XO0403", span, "`expect` takes one argument")
      for a in args {
        c.infer(a.value, -1)
      }
      return c.unit_ty
    }
    c.check_ty(args[0].value, c.named("Bool"))
    return c.unit_ty
  }
  if name == b"old" && c.ctx >= 0 && c.ctxs[c.ctx].in_ensures {
    if args.len() != 1 {
      c.error("XO0403", span, "`old` takes one argument")
      return c.bad_ty
    }
    return c.infer(args[0].value, hint)
  }
  if is_upper_camel(name) && !c.mods[c.cur_mod].members.contains(name) {
    let (e, vp) = c.variant_from_hint(name, hint)
    if e >= 0 {
      return c.construct(e, vp, targs, has_targs, [call], hint, span, id, c.expr_key(call))
    }
    let (pe, pv) = c.prelude_variant(name)
    if pe >= 0 {
      return c.construct(pe, pv, targs, has_targs, [call], hint, span, id, c.expr_key(call))
    }
  }
  if c.file_import(name) != None {
    c.use_import(name)
    c.error("XO0407", id.span, "`${text(name)}` is a module and cannot be called")
    c.infer_args(args)
    return c.bad_ty
  }
  let o = c.lookup_module_obj(c.cur_mod, name)
  if o >= 0 {
    match c.objs[o].kind {
      Func => {
        c.record(id, o)
        return c.call_func(o, {}, targs, has_targs, call, hint, [])
      }
      Type => {
        c.record(id, o)
        return c.type_call(o, targs, has_targs, call, hint)
      }
      Const => {
        c.record(id, o)
        return c.call_value(c.const_type(o), call, hint, text(name))
      }
      TParam | Local | Module => {}
    }
  }
  if (text(name)) is "spawn" | "spawn_background" | "go" {
    let d = c.error("XO0803", id.span, "`${text(name)}` without a scope handle: tasks are started with `s.spawn(f)` inside `scope s { ... }`, so no task outlives its scope (core 7.1)")
    c.fix(d, "use a scope", [c.insert_edit(id.span.start, "s.")])
    c.infer_args(args)
    return c.bad_ty
  }
  if hint >= 0 && is_upper_camel(name) {
    let h = c.resolve(hint)
    if c.tys[h].kind == TyKind.Named && c.objs[c.tys[h].obj].tkind == "enum" {
      let eo = c.tys[h].obj
      var cands: List[Str] = []
      for vi in c.objs[eo].variants {
        cands.push(text(vi.name))
      }
      c.unresolved(id.span, "variant of `${text(c.objs[eo].name)}`", text(name), cands)
      c.infer_args(args)
      return c.bad_ty
    }
  }
  let (ht, hok) = c.habit_call(call, id, hint)
  if hok {
    return ht
  }
  c.unresolved(id.span, "function", text(name), c.visible_value_names())
  c.infer_args(args)
  c.bad_ty
}

/// `flag.continue_on_error()`: when the fix of an unresolved module member
/// that is called with no arguments names a constant
/// (`flag.CONTINUE_ON_ERROR`), the fix drops the `()` too, or it would
/// leave XO0407 (decision 0440).
fn (var c: Checker) const_fix_drops_call(d: Int, m: Int, sel: Ident, call: Expr, args: List[Arg]) {
  if d < 0 || !args.is_empty() || c.diags[d].fixes.is_empty() || c.diags[d].fixes[0].edits.len() != 1 {
    return
  }
  let name = c.diags[d].fixes[0].edits[0].replace
  let o = c.mods[m].members.get(name.bytes()) ?? -1
  if o < 0 || c.objs[o].kind != ObjKind.Const {
    return
  }
  let (span, _, _) = call_parts(call)
  c.diags[d].fixes[0] = DFix{title: "replace with `${name}`, a constant (no call)", edits: [c.replace_edit(Span{start: sel.span.start, end: span.end}, name)]}
  c.note(d, "`${name}` is a constant, not a function: write it without `()`")
}

/// Checks the arguments of a call whose callee could not be typed;
/// closures get a bad hint (their parameter types are unknowable).
fn (var c: Checker) infer_args(args: List[Arg]) {
  for a in args {
    if unparen(a.value) is FnLit(..) {
      c.infer(a.value, c.bad_ty)
      continue
    }
    c.infer(a.value, -1)
  }
}

fn (var c: Checker) call_selector(call: Expr, sspan: Span, x: Expr, sel: Ident, targs: List[Int], has_targs: Bool, hint: Int) -> Int {
  let (_, fun, args) = call_parts(call)
  if let Ident(id) = x {
    if c.lookup_local(id.name) < 0 {
      var m = -1
      var found = false
      if let Some(imp) = c.file_import(id.name) {
        c.use_import(id.name)
        m = imp.module
        found = true
      } else if id.name == b"testing" && c.in_test_context() {
        m = c.testing_mod()
        found = true
      }
      if found {
        if m < 0 {
          c.infer_args(args)
          return c.bad_ty
        }
        c.record(id, c.mods[m].obj)
        let o = c.mods[m].members.get(sel.name) ?? -1
        if o < 0 {
          if c.go_skipped(m, text(sel.name), sel.span) || c.c_skipped(m, text(sel.name), sel.span) {
            c.infer_args(args)
            return c.bad_ty
          }
          let d = c.unresolved(sel.span, "member of module `${text(id.name)}`", text(sel.name), sorted_names(c.mods[m].members))
          c.module_member_habit(d, c.mods[m].path, text(sel.name))
          c.const_fix_drops_call(d, m, sel, call, args)
          c.infer_args(args)
          return c.bad_ty
        }
        if !c.pub_in(o, m) {
          c.pub_fix(c.error("XO0605", sel.span, "`${text(sel.name)}` is not `pub` in module `${c.mods[m].path}`"), o)
        }
        c.portable_check(m, sel)
        c.record(sel, o)
        match c.objs[o].kind {
          Func => return c.call_func(o, {}, targs, has_targs, call, hint, [])
          Type => return c.type_call(o, targs, has_targs, call, hint)
          Const => return c.call_value(c.const_type(o), call, hint, text(sel.name))
          TParam | Local | Module => {}
        }
        return c.bad_ty
      }
    }
  }
  if let Ident(id) = x {
    if c.lookup_local(id.name) < 0 && c.file_import(id.name) == None && c.lookup_module_obj(c.cur_mod, id.name) < 0 {
      let (ht, hok) = c.habit_module_call(call, id, sel)
      if hok {
        return ht
      }
    }
  }
  let r = c.type_of_expr(x)
  if r.obj >= 0 {
    if has_targs {
      c.error("XO0407", parser.expr_span(fun), "type arguments go on the type: `${text(c.objs[r.obj].name)}[...].${text(sel.name)}(...)`")
    }
    return c.type_member(r.obj, r.args, r.has_args, sspan, x, sel, hint, [call])
  }
  let bt = c.infer(x, -1)
  c.call_method(bt, sspan, x, sel, targs, has_targs, call, hint)
}

fn (var c: Checker) call_method(bt: Int, sspan: Span, x: Expr, sel: Ident, targs: List[Int], has_targs: Bool, call: Expr, hint: Int) -> Int {
  let (span, _, args) = call_parts(call)
  let r = c.resolve(bt)
  let name = sel.name
  if c.is_bad(r) {
    c.infer_args(args)
    return c.bad_ty
  }
  let k = c.tys[r].kind
  if k == TyKind.Var {
    c.error("XO0405", parser.expr_span(x), "the type of this value must be known before `.${text(name)}(...)`; annotate it")
    c.infer_args(args)
    return c.bad_ty
  }
  let is_named = k == TyKind.Named
  // `xs.sort(fn(a, b) { a > b })`: Go's sort.Slice and JavaScript's
  // comparator; one error naming the key form, not an arity error plus
  // the closure's own (owner tester, 2026-11-10)
  if is_named && (name == b"sort" || name == b"sort_in_place") && args.len() == 1 && c.list_elem(r) >= 0 {
    if let FnLit(fl) = args[0].value {
      if fl.params.len() == 2 {
        // decision 0586: name the comparator form, `sort_with`, with the
        // body's comparison rewritten to an Ordering (`a > b` to
        // `b.cmp(a)`, `a < b` to `a.cmp(b)`)
        let w = if name == b"sort" { "sort_with" } else { "sort_in_place_with" }
        let d = c.error("XO0403", span, "`${text(name)}` takes no comparator: a comparator sort is `${w}`, whose comparator returns an `Ordering`")
        var cmp = ""
        var csp = span
        if !fl.body.stmts.is_empty() {
          if let ExprStmt(_, BinaryExpr(bsp, op, bx, by)) = fl.body.stmts[fl.body.stmts.len() - 1] {
            let xs = c.src_of(parser.expr_span(bx))
            let ys = c.src_of(parser.expr_span(by))
            if op == lexer.Kind.Gt || op == lexer.Kind.GtEq {
              cmp = "${ys}.cmp(${xs})"
            } else if op == lexer.Kind.Lt || op == lexer.Kind.LtEq {
              cmp = "${xs}.cmp(${ys})"
            }
            csp = bsp
          }
        }
        let shown = if cmp == "" { "a.cmp(b)" } else { cmp }
        c.habit_note(d, "a comparator `fn(a, b)` is Go's sort.Slice and JavaScript's sort; Xo's returns Less, Equal or Greater: `xs.${w}(fn(a, b) { ${shown} })`, stable (decision 0586, spec/std.md 2); or sort by a key, `xs.${text(name)}_by(fn(x) { x.field })`, and `${text(name)}_by_desc` for descending order")
        if cmp != "" {
          c.fix(d, "use `${w}`", [c.replace_edit(sel.span, w), c.replace_edit(csp, cmp)])
        }
        return if name == b"sort" { r } else { c.unit_ty }
      }
    }
  }
  if is_named && c.is_prelude(r, "Task") && name == b"await" {
    let d = c.error("XO0407", span, "`await` is written without parentheses: `t.await` (core 7.1)")
    c.fix(d, "remove the parentheses", [c.replace_edit(Span{start: sspan.end, end: span.end}, "")])
    return c.field_of(bt, sspan, x, sel, false)
  }
  if k == TyKind.Tuple && is_tuple_index(name) {
    return c.call_value(c.field_of(bt, sspan, x, sel, false), call, hint, text(name))
  }
  if is_named && c.objs[c.tys[r].obj].tkind == "newtype" && is_tuple_index(name) {
    return c.call_value(c.field_of(bt, sspan, x, sel, false), call, hint, text(name))
  }
  let (m, _) = c.find_method_any(r, text(name))
  if m < 0 {
    if is_named && c.objs[c.tys[r].obj].tkind == "struct" && !c.objs[c.tys[r].obj].opaque && c.field_index(c.tys[r].obj, name) >= 0 {
      let ft = c.field_of(bt, sspan, x, sel, false)
      return c.call_value(ft, call, hint, text(name))
    }
    if (name == b"min" || name == b"max" || name == b"clamp") && c.is_ord(r) {
      let want_n = if name == b"clamp" { 2 } else { 1 }
      if args.len() != want_n {
        c.error("XO0403", span, "`${text(name)}` takes ${want_n} argument(s), found ${args.len()}")
      }
      for a in args {
        c.check_ty(a.value, r)
      }
      return r
    }
    if name == b"cmp" && c.is_ord(r) {
      // `a.cmp(b)`, the order `<` uses as an Ordering (decision 0586)
      if args.len() != 1 {
        c.error("XO0403", span, "`cmp` takes 1 argument, found ${args.len()}")
      }
      for a in args {
        c.check_ty(a.value, r)
      }
      return c.named("Ordering")
    }
    if name == b"display" && args.is_empty() && targs.is_empty() && c.implements_name(r, "Display", sel.span) {
      return c.named("Str")
    }
    if name == b"debug" && args.is_empty() && targs.is_empty() {
      return c.named("Str")
    }
    if (name == b"spawn" || name == b"spawn_background") && !c.is_prelude(r, "Scope") {
      c.error("XO0803", sel.span, "`${text(name)}` is called on `${c.show(r)}`, not on a scope handle; tasks are started with `s.spawn(f)` inside `scope s { ... }` (core 7.1)")
      c.infer_args(args)
      return c.bad_ty
    }
    let (ht, hok) = c.habit_method(bt, r, sspan, x, sel, call, hint)
    if hok {
      return ht
    }
    c.no_member(r, sel, false)
    c.infer_args(args)
    return c.bad_ty
  }
  c.record(sel, m)
  if c.objs[m].is_static {
    c.error("XO0407", sel.span, "`${text(name)}` is an associated function; call it on the type: `${text(c.objs[c.objs[m].recv].name)}.${text(name)}(...)`")
    c.infer_args(args)
    return c.bad_ty
  }
  if !c.objs[m].is_pub && c.objs[m].module != c.cur_mod && !c.objs[m].iface && !c.prelude_iface_method(r, m, sel.span) {
    c.pub_fix(c.error("XO0605", sel.span, "method `${text(name)}` of `${text(c.objs[c.objs[m].recv].name)}` is not `pub` in module `${c.mods[c.objs[m].module].path}`"), m)
  }
  var pre: Subst = {}
  if c.objs[m].iface {
    if is_named {
      let rargs = c.tys[r].args
      for (i, p) in c.objs[c.objs[m].recv].tparams.indexed() {
        if i < rargs.len() {
          pre[p] = rargs[i]
        }
      }
    }
  } else {
    for p in c.objs[m].tparams {
      if c.objs[p].implicit {
        if c.objs[p].effect {
          pre[p] = c.fresh_effarg()
        } else {
          pre[p] = c.new_var()
        }
      }
    }
    if !c.unify(c.subst(c.objs[m].recv_ty, pre), r) {
      let d = c.error("XO0601", sel.span, "method `${text(name)}` is not defined on `${c.show(r)}`")
      c.note(d, "`${text(name)}` is only defined on `${c.show_raw(c.objs[m].recv_ty)}`")
      c.infer_args(args)
      return c.bad_ty
    }
  }
  if c.objs[m].recv_var {
    c.require_mutable(x, "XO0501", "method `${text(name)}`")
  }
  let t = c.call_func(m, pre, targs, has_targs, call, hint, [x])
  if is_named && (name == b"read" || name == b"read_text" || name == b"contains") && c.is_embed_dir(r) {
    c.embed_path_check(x, args)
  }
  if c.is_prelude(r, "Scope") && (name == b"spawn" || name == b"spawn_background") {
    c.record_spawn(x, call, t)
  }
  if c.is_task_group(r) && (name == b"spawn" || name == b"spawn_background") {
    c.record_group_spawn(x, call)
  }
  t
}

/// A method by name on a named type, an interface, or a constrained type
/// parameter (applicability is checked by the caller).
fn (var c: Checker) find_method_any(t0: Int, name: Str) -> (Int, Subst) {
  let t = c.resolve(t0)
  let x = c.tys[t]
  match x.kind {
    Named => {
      if c.objs[x.obj].tkind == "interface" {
        return c.find_method(t, name)
      }
      let m = c.objs[x.obj].methods.get(name.bytes()) ?? -1
      if m >= 0 {
        return (m, {})
      }
      (-1, {})
    }
    Param => {
      let ct = c.objs[x.obj].constraint
      if ct >= 0 {
        return c.find_method_any(ct, name)
      }
      (-1, {})
    }
    Tuple | Func | Var | Bad | EffArg => (-1, {})
  }
}

fn (c: Checker) is_task_group(t: Int) -> Bool {
  let o = c.named_obj(t)
  o >= 0 && c.objs[o].module >= 0 && c.mods[c.objs[o].module].path == "std/task" && c.objs[o].name == b"Group"
}

/// Notes a spawned task for the child failure rule (core 7.1).
fn (var c: Checker) record_spawn(recv: Expr, call: Expr, task_t: Int) {
  let r = c.resolve(task_t)
  if c.tys[r].kind != TyKind.Named || c.tys[r].args.len() != 2 {
    return
  }
  let err_t = c.tys[r].args[1]
  let span = parser.expr_span(call)
  var frame = -1
  if let Ident(id) = recv {
    let v = c.lookup_local(id.name)
    if v >= 0 {
      frame = c.objs[v].frame
    }
  }
  if frame >= 0 {
    c.frames[frame].spawns.push(Spawn{span: span, call: c.expr_key(call), err: err_t})
    return
  }
  let e = c.resolve(err_t)
  if !c.is_bad(e) && !c.is_never(e) && !c.is_open_var(e) {
    let d = c.error("XO0801", span, "a task spawned on a scope handle from outside this function can fail with `${c.show(e)}`; handle the error inside the task")
    c.note(d, "child failures propagate out of the scope that owns the handle (core 7.1)")
  }
}

/// A call of a declared function or method (pre binds receiver type
/// parameters; recv is the receiver expression, zero or one element).
fn (var c: Checker) call_func(fo: Int, pre: Subst, targs: List[Int], has_targs: Bool, call: Expr, hint: Int, recv: List[Expr]) -> Int {
  let (span, fun, args) = call_parts(call)
  if !c.objs[fo].sig_done {
    c.infer_args(args)
    return c.bad_ty
  }
  let sm = c.fresh_subst(fo, pre, targs, has_targs, parser.expr_span(fun))
  let result = c.subst(c.objs[fo].result, sm)
  var err_t = -1
  if c.objs[fo].err >= 0 {
    err_t = c.subst(c.objs[fo].err, sm)
  }
  if hint >= 0 {
    let h = c.resolve(hint)
    if !c.is_open_var(h) && !c.is_interface(h) {
      if err_t < 0 {
        c.try_unify(result, h)
      } else if !c.has_open_vars(err_t) && c.is_result(h) {
        c.try_unify(c.call_result(result, err_t), h)
      } else if !c.is_result(h) {
        c.try_unify(result, h)
      }
    }
  }
  var params: List[ParamInfo] = []
  for p in c.objs[fo].params {
    var q = p
    q.ty = c.subst(p.ty, sm)
    params.push(q)
  }
  c.fn_calls[c.expr_key(call)] = fo
  c.call_infos[c.expr_key(call)] = CallInfo{fn_obj: fo, recv: recv, subst: sm}
  if !recv.is_empty() || c.objs[fo].tparams.len() != 1 || !(text(c.objs[fo].name) is "encode_value" | "decode" | "decode_all" | "encode_all" | "marshal" | "unmarshal" | "unmarshal_prefix") || c.objs[fo].module < 0 || !(c.mods[c.objs[fo].module].path is "std/xml" | "std/yaml" | "std/cbor" | "std/protobuf") {
    // not one of std/xml's derive Xml calls or std/yaml's derive Yaml calls
  } else {
    c.xml_calls.push((c.expr_key(call), call, fo, c.cur_file))
  }
  let lazy_log = c.objs[fo].module >= 0 && c.mods[c.objs[fo].module].path == "std/log" && (text(c.objs[fo].name) is "debug" | "info" | "warn" | "error")
  let eff0 = c.ctx_eff_len()
  c.check_args(params, call, c.display_name(fo), false, fo, -1, -1)
  if lazy_log {
    c.warn_lazy_log_args(call, fo, eff0)
  }
  // constraints
  for p in c.objs[fo].tparams {
    let ct = c.objs[p].constraint
    if ct < 0 || c.objs[p].effect {
      continue
    }
    let at = c.resolve(sm.get(p) ?? c.bad_ty)
    if c.is_open_var(at) || c.is_bad(at) {
      continue
    }
    let st = c.subst(ct, sm)
    let cn = c.resolve(st)
    if c.tys[cn].kind != TyKind.Named {
      continue
    }
    if c.implements(at, cn, span) {
      c.need_go_comparable(fo, p, at, cn, span)
    } else {
      let vm = c.var_self_conflict(at, cn)
      if vm >= 0 {
        let _ = c.var_self_error(span, at, cn, vm)
        continue
      }
      let d = c.error("XO0404", span, "`${c.show(at)}` does not implement `${c.show_raw(cn)}`, required by `${text(c.objs[p].name)}` of `${c.display_name(fo)}`")
      let co = c.tys[cn].obj
      if c.objs[co].module == c.prelude {
        let cname = text(c.objs[co].name)
        if cname is "Eq" | "Hash" {
          c.note_incomparable(d, c.incomparable(at))
        }
        if suggests_derive(cname) {
          c.note(d, "add `derive ${cname}` to the type declaration (core 2.9)")
        }
      }
    }
  }
  for p in c.objs[fo].tparams {
    if c.objs[p].effect || c.objs[p].implicit {
      continue
    }
    let v = sm.get(p) ?? -1
    if v >= 0 && c.tys[v].kind == TyKind.Var && c.tys[v].ref < 0 && (c.objs[fo].err < 0 || !c.mentions(c.objs[fo].err, p)) {
      c.type_arg_vars.push(TypeArgVar{v: v, param: text(c.objs[p].name), fn_name: c.display_name(fo), file: c.path, span: parser.expr_span(fun)})
    }
  }
  // an error type that nothing determined: the call cannot fail
  if err_t >= 0 {
    let ev = c.resolve(err_t)
    if c.tys[ev].kind == TyKind.Var {
      c.bind(ev, c.named("Never"))
    }
  }
  for p in c.objs[fo].tparams {
    if !c.objs[p].effect {
      continue
    }
    let a = sm.get(p) ?? -1
    if a < 0 || c.tys[a].kind != TyKind.EffArg || c.tys[a].eff < 0 {
      continue
    }
    c.close_eff(c.tys[a].eff, true)
  }
  // effects
  c.check_ceiling(fo, span)
  if c.objs[fo].declared >= 0 {
    c.perform(c.performed(c.subst_eff(c.objs[fo].declared, sm, 0), c.path, span, c.display_name(fo)))
    let caller = c.outer_fn()
    if caller >= 0 {
      var l = c.declared_callers.get(fo) ?? []
      if !l.contains(caller) {
        l.push(caller)
        c.declared_callers[fo] = l
      }
    }
  } else {
    c.perform(c.new_eset([EffItem{fn_obj: fo, sub: sm, has_sub: true, file: c.path, span: span, via: c.display_name(fo)}]))
  }
  c.call_result(result, err_t)
}

/// Matches arguments to parameters (positional first, then named,
/// defaults for the rest) and checks them; closures last, so their
/// parameter types are known. positional_only drops argument names
/// (a call of a function value, reported). A named argument names a
/// parameter of function ref_fo, or a field of variant ref_v of enum
/// ref_enum.
fn (var c: Checker) check_args(params: List[ParamInfo], call: Expr, fname: Str, positional_only: Bool, ref_fo: Int, ref_enum: Int, ref_v: Int) {
  let (span, _, args) = call_parts(call)
  let ckey = c.expr_key(call)
  let has_ci = c.call_infos.contains(ckey)
  var assigned: List[Int] = []
  for _ in params {
    assigned.push(-1)
  }
  var seen_named = false
  var pos = 0
  var ok = true
  for (ai, a) in args.indexed() {
    let named = if positional_only { None } else { a.name }
    match named {
      None => {
        if seen_named {
          c.error("XO0403", a.span, "positional arguments must come before named ones (core 3.2)")
          ok = false
          continue
        }
        if pos >= params.len() {
          c.error("XO0403", a.span, "too many arguments to `${fname}`: it takes ${params.len()}")
          c.infer(a.value, -1)
          ok = false
          continue
        }
        assigned[pos] = ai
        pos += 1
      }
      Some(n) => {
        seen_named = true
        var idx = -1
        for (i, p) in params.indexed() {
          if p.name == n.name {
            idx = i
          }
        }
        if idx < 0 {
          var pcands: List[Str] = []
          for p in params {
            pcands.push(text(p.name))
          }
          let d = c.error("XO0403", n.span, "`${fname}` has no parameter named `${text(n.name)}`")
          let s = nearest(text(n.name), pcands)
          if !s.is_empty() && d >= 0 {
            c.note(d, "did you mean `${s[0]}`?")
            c.fix(d, "replace with `${s[0]}`", [c.replace_edit(n.span, s[0])])
          }
          c.infer(a.value, -1)
          ok = false
          continue
        }
        if assigned[idx] >= 0 {
          c.error("XO0403", n.span, "parameter `${text(n.name)}` is given twice")
          c.infer(a.value, -1)
          ok = false
          continue
        }
        if ref_fo >= 0 {
          c.record_text(n, c.param_text(ref_fo, params[idx]))
        } else if ref_enum >= 0 {
          c.record_text(n, c.vfield_text(ref_enum, ref_v, c.objs[ref_enum].variants[ref_v].fields[idx]))
        }
        assigned[idx] = ai
      }
    }
  }
  var missing: List[Str] = []
  for (i, p) in params.indexed() {
    if assigned[i] < 0 {
      // the default's presence: the callee's trees joined now if std's
      // record left them pending (trees_lazy)
      if ref_fo >= 0 {
        c.need_tree(ref_fo)
      }
    }
    let has_default0 = if assigned[i] >= 0 { true } else if ref_fo >= 0 && i < c.objs[ref_fo].params.len() { !c.objs[ref_fo].params[i].default.is_empty() } else { !p.default.is_empty() }
    // a std function's trailing rt.Loc parameter: the call's position
    let has_default = has_default0 || ref_fo >= 0 && c.objs[ref_fo].module >= 0 && c.mods[c.objs[ref_fo].module].is_std && c.is_loc_type(p.ty)
    if assigned[i] < 0 && !has_default {
      missing.push(text(p.name))
    }
  }
  if !missing.is_empty() && ok {
    let d = c.error("XO0403", span, "missing argument(s) `${missing.join("`, `")}` in call to `${fname}`")
    for m in missing {
      if m == "reason" || m == "msg" {
        // Rust's `unwrap()` and Kotlin's `!!` take no reason; Xo's failure
        // points do (decision 0087).
        c.note(d, "Xo asks for a reason wherever a program may stop or drop an error, so the message names the invariant: `${fname}(..., \"why this cannot fail\")` (core 2.6, 3.6)")
        break
      }
    }
  }
  var aps: List[ArgParam] = []
  for pass in 0..2 {
    for (i, ai) in assigned.indexed() {
      if ai < 0 {
        continue
      }
      let e = args[ai].value
      let is_lit = e is FnLit(..)
      if is_lit != (pass == 1) {
        continue
      }
      if i == 0 && ref_fo >= 0 && c.objs[ref_fo].module == c.prelude && c.display_name(ref_fo) == "List.get" {
        c.check_index(e)
      } else if !c.go_any_list(ref_fo, e, params[i].ty) {
        c.check_ty(e, params[i].ty)
        if c.is_go_any_fn(ref_fo) {
          c.need_go_value(c.nat_at.get(c.expr_key(e)) ?? c.bad_ty, parser.expr_span(e), "`go.any`'s argument")
        }
        // `go.any(xs)` written for a Go function's `any` parameter
        if c.is_go_fn(ref_fo) && c.is_go_any(params[i].ty) {
          if let CallExpr(args: gargs, ..) = e {
            let gfo = (c.call_infos.get(c.expr_key(e)) ?? CallInfo{}).fn_obj
            if gargs.len() == 1 && c.is_go_any_fn(gfo) {
              c.warn_go_copy(ref_fo, c.nat_at.get(c.expr_key(gargs[0].value)) ?? c.bad_ty, parser.expr_span(gargs[0].value))
            }
          }
        }
      }
      if params[i].is_var {
        c.require_mutable(e, "XO0502", "passing to `var` parameter `${text(params[i].name)}`")
      }
      if has_ci {
        aps.push(ArgParam{arg: e, is_var: params[i].is_var})
      }
    }
  }
  var var_args: List[Expr] = []
  if has_ci {
    var ci = c.call_infos.get_or_fault(ckey, "has_ci")
    ci.params = aps
    c.call_infos[ckey] = ci
    let fo = ci.fn_obj
    if fo >= 0 && c.objs[fo].recv_var && !c.objs[fo].is_static {
      if let Some(r) = ci.recv.first() {
        var_args.push(r)
      }
    }
  }
  for (i, ai) in assigned.indexed() {
    if ai >= 0 && params[i].is_var {
      var_args.push(args[ai].value)
    }
  }
  c.check_var_aliases(var_args)
}

/// A call of a value of function type.
fn (var c: Checker) call_value(ft: Int, call: Expr, hint: Int, name0: Str) -> Int {
  let (_, fun, args) = call_parts(call)
  let r = c.resolve(ft)
  if c.is_bad(r) {
    c.infer_args(args)
    return c.bad_ty
  }
  if c.tys[r].kind != TyKind.Func {
    if c.tys[r].kind == TyKind.Var {
      c.error("XO0405", parser.expr_span(fun), "the type of this function value must be known here")
    } else {
      var what = name0
      if what.is_empty() {
        what = callee_name(fun)
      }
      if what.is_empty() {
        what = "this value"
      }
      c.error("XO0407", parser.expr_span(fun), "`${what}` is not a function (its type is `${c.show(ft)}`)")
    }
    c.infer_args(args)
    return c.bad_ty
  }
  var params: List[ParamInfo] = []
  let f = c.tys[r]
  for (i, p) in f.args.indexed() {
    params.push(ParamInfo{name: "#${i + 1}".bytes(), ty: p, is_var: f.vars[i]})
  }
  for a in args {
    if let Some(n) = a.name {
      c.error("XO0403", n.span, "a function value takes positional arguments only")
    }
  }
  let name = if name0.is_empty() { "function value" } else { name0 }
  c.value_calls[c.expr_key(call)] = true
  c.call_infos[c.expr_key(call)] = CallInfo{}
  c.check_args(params, call, name, true, -1, -1, -1)
  if f.eff >= 0 {
    let (span, _, _) = call_parts(call)
    c.perform(c.performed(f.eff, c.path, span, name))
  }
  c.call_result(f.result, f.err)
}

/// `T(x)`: numeric conversions (core 2.1) and newtype construction
/// (core 2.8).
fn (var c: Checker) type_call(obj0: Int, targs0: List[Int], has_targs0: Bool, call: Expr, hint: Int) -> Int {
  let (span, fun, args) = call_parts(call)
  var obj = obj0
  var targs = targs0
  var has_targs = has_targs0
  if c.objs[obj].tkind == "alias" {
    let r = c.alias_named(obj, targs, has_targs, parser.expr_span(fun))
    if r.obj < 0 {
      c.infer_args(args)
      return c.bad_ty
    }
    obj = r.obj
    targs = r.args
    has_targs = r.has_args
  }
  c.type_call_at[c.expr_key(call)] = obj
  let oname = text(c.objs[obj].name)
  if c.objs[obj].module == c.prelude && (is_int_name(c.objs[obj].name) || is_float_name(c.objs[obj].name)) {
    if args.len() != 1 || args[0].name != None {
      c.error("XO0403", span, "conversion `${oname}(x)` takes one positional argument")
      c.infer_args(args)
      return c.mk_named(obj, [])
    }
    let at = c.infer(args[0].value, -1)
    if is_int_name(c.objs[obj].name) && c.is_prelude(at, "Rune") {
      return c.mk_named(obj, [])
    }
    if !c.is_bad(at) && !c.is_numeric(at) && !c.is_open_var(at) {
      let d = c.error("XO0409", parser.expr_span(args[0].value), "cannot convert `${c.show(at)}` to `${oname}`; numeric conversions take a number")
      if c.is_prelude(at, "Str") {
        c.note(d, "parse text with `${oname}.parse(s)`, which returns `${oname}?` (core 2.1)")
      } else if c.is_prelude(at, "Rune") {
        c.note(d, "a Rune converts to an integer type, its code point: `Float(Int(r))` (core 2.1)")
      }
    }
    return c.mk_named(obj, [])
  }
  if c.objs[obj].module == c.prelude && oname == "Rune" {
    if args.len() != 1 || args[0].name != None {
      c.error("XO0403", span, "conversion `Rune(n)` takes one positional argument")
      c.infer_args(args)
      return c.named("Rune")
    }
    let at = c.infer(args[0].value, -1)
    if !c.is_bad(at) && !c.is_int(at) && !c.is_prelude(at, "Rune") && !c.is_open_var(at) {
      let d = c.error("XO0409", parser.expr_span(args[0].value), "cannot convert `${c.show(at)}` to `Rune`; a Rune is made from an integer code point")
      if c.is_prelude(at, "Str") {
        c.note(d, "the characters of a Str are `s.runes()` (std.md 2.2)")
      } else if c.is_float(at) {
        c.note(d, "convert to an integer first: `Rune(Int(x))` (core 2.1)")
      }
    }
    return c.named("Rune")
  }
  if c.objs[obj].tkind == "newtype" {
    let nt = c.instantiate(obj, targs, has_targs, parser.expr_span(fun))
    if nt < 0 {
      c.infer_args(args)
      return c.bad_ty
    }
    if hint >= 0 {
      c.try_unify(nt, hint)
    }
    if args.len() != 1 || args[0].name != None {
      c.error("XO0403", span, "newtype `${oname}(x)` takes one positional argument")
      c.infer_args(args)
      return nt
    }
    c.check_ty(args[0].value, c.subst(c.objs[obj].target, c.args_subst(c.objs[obj].tparams, c.tys[nt].args)))
    c.ctor_calls[c.expr_key(call)] = true
    return nt
  }
  let d = c.error("XO0407", parser.expr_span(fun), "`${c.qual_name(obj)}` is a type and cannot be called")
  if d >= 0 {
    if c.qual_name(obj) == "uuid.Uuid" {
      // 0.33.0's newtype constructor (XO0912, decision 0387)
      c.note(d, "a Uuid is two Ints since 0.34.0: `uuid.parse(s)?` makes one from a text, `uuid.from_bytes(b)?` from 16 bytes (spec/std.md 24, decision 0387)")
    } else if c.objs[obj].tkind == "struct" && !c.objs[obj].opaque {
      c.note(d, "build a struct with a literal: `${oname}{field: value}` (core 2.2)")
    } else if c.objs[obj].tkind == "enum" {
      c.note(d, "construct a variant: `${oname}.Variant(...)` (core 2.3)")
    } else if c.objs[obj].module == c.prelude && oname == "Str" {
      c.note(d, "convert to text with interpolation: `\"\${x}\"` (core 1.6)")
    }
  }
  c.infer_args(args)
  c.bad_ty
}

/// Builds variant v (a position) of enum (core 2.3); call is the
/// CallExpr (zero or one element), name the identifier naming the
/// variant.
fn (var c: Checker) construct(en: Int, v: Int, targs: List[Int], has_targs: Bool, call: List[Expr], hint: Int, sp: Span, name: Ident, ekey: Int) -> Int {
  c.ctor_at[ekey] = VRef{en: en, variant: v}
  c.record_text(name, c.variant_text(en, v))
  let nt = c.instantiate(en, targs, has_targs, sp)
  if nt < 0 {
    if !call.is_empty() {
      let (_, _, args) = call_parts(call[0])
      c.infer_args(args)
    }
    return c.bad_ty
  }
  if hint >= 0 {
    var h = c.resolve(hint)
    let el = c.option_elem(h)
    if el >= 0 && !(c.objs[en].module == c.prelude && c.objs[en].name == b"Option") {
      h = c.resolve(el)
    }
    c.try_unify(nt, h)
  }
  let s = c.args_subst(c.objs[en].tparams, c.tys[nt].args)
  let vi = c.objs[en].variants[v]
  if call.is_empty() {
    if !vi.fields.is_empty() {
      c.error("XO0403", sp, "variant `${text(vi.name)}` has fields; construct it with arguments: `${text(vi.name)}(...)`")
    }
    return nt
  }
  let (cspan, _, args) = call_parts(call[0])
  c.ctor_calls[c.expr_key(call[0])] = true
  if vi.unit || vi.fields.is_empty() {
    if !args.is_empty() {
      c.error("XO0403", cspan, "variant `${text(vi.name)}` has no fields")
      c.infer_args(args)
    }
    return nt
  }
  var params: List[ParamInfo] = []
  for f in vi.fields {
    let pname = if f.from { b"" } else { f.name }
    params.push(ParamInfo{name: pname, ty: c.subst(f.ty, s), is_var: false})
  }
  if vi.fields.len() > 1 {
    for a in args {
      if a.name == None {
        var names: List[Str] = []
        for f in vi.fields {
          names.push("${text(f.name)}: ...")
        }
        c.error("XO0403", a.span, "variant `${text(vi.name)}` has ${vi.fields.len()} fields; construct it with names: `${text(vi.name)}(${names.join(", ")})` (core 2.3)")
        c.infer_args(args)
        return nt
      }
    }
  }
  c.check_args(params, call[0], text(vi.name), false, -1, en, v)
  if vi.index == c.objs[en].catch_all && args.len() == 1 {
    c.catch_all_constant(en, vi, args[0].value)
  }
  nt
}

/// A valued enum's catch-all built from a constant that a named variant
/// has (`StorageClass.Unknown("STANDARD")`) is XO0435: a second spelling
/// of that variant, unequal to it (decision 0493).
fn (var c: Checker) catch_all_constant(en: Int, ca: VariantInfo, x: Expr) {
  let ik = c.objs[en].value_kind
  for o in c.objs[en].variants {
    if o.index == ca.index {
      continue
    }
    var same = false
    if ik == 1 {
      if let Some(n) = c.const_int(c.cur_file, x, 0) {
        same = n == o.ival
      }
    } else if let Some(sv) = c.const_str(c.cur_file, x, 0) {
      same = sv.bytes() == o.sval
    }
    if same {
      let en_name = text(c.objs[en].name)
      c.error("XO0435", parser.expr_span(x), "`${en_name}.${text(ca.name)}` of a value that `${en_name}.${text(o.name)}` has; write `${en_name}.${text(o.name)}` (the catch-all keeps only values no variant names, decision 0493)")
      return
    }
  }
}

/// Whether fun is the predeclared `expect` of a test (core 9.2).
fn (c: Checker) is_expect_call(fun: Expr) -> Bool {
  match fun {
    Ident(id) => id.name == b"expect" && c.in_test_context() && c.lookup_local(b"expect") < 0 && !c.mods[c.cur_mod].members.contains(b"expect")
    _ => false
  }
}

/// `expect(a) op b` as the comparison `a op b`.
fn (var c: Checker) expect_compare(span: Span, op: parser.Kind, call: Expr, cspan: Span, args: List[Arg], y: Expr) -> Int {
  if args.len() != 1 {
    c.error("XO0403", cspan, "`expect` takes one argument")
    c.infer_args(args)
    c.infer(y, -1)
    return c.unit_ty
  }
  let at = c.infer(args[0].value, -1)
  c.set_type(call, c.named("Bool"))
  if !(op is Eq | NotEq | Lt | LtEq | Gt | GtEq) {
    c.error("XO0406", span, "`expect(x)` must be followed by a comparison: ==, !=, <, <=, >, >=")
    c.infer(y, -1)
    return c.unit_ty
  }
  var yt = -1
  if c.is_open_var(at) {
    yt = c.infer(y, -1)
  } else {
    yt = c.infer(y, at)
  }
  c.binary_type(op, at, yt, span)
  c.unit_ty
}

/// A habit note for a std module member another language names
/// (`json.Marshal`, owner tester 2026-11-10): Xo's name for it.
fn (var c: Checker) module_member_habit(d: Int, path: Str, name: Str) {
  if d < 0 {
    return
  }
  let xo = match (path, name) {
    ("std/json", "Marshal") => "`json.encode_str(v)` (a Str; `json.encode(v)` gives Bytes)"
    ("std/json", "MarshalIndent") => "`json.encode_indent_str(v, prefix, indent)`"
    ("std/json", "Unmarshal") => "`json.decode_str[T](s)` (or `json.decode[T](bytes)`)"
    _ => ""
  }
  if !xo.is_empty() {
    c.habit_note(d, "`${name}` is Go's encoding/json name; Xo writes ${xo} for a type with `derive Json` (spec/std.md)")
  }
}

/// The intrinsics of native/rt a merged std module may call (decision
/// 0597): those every backend implements, the Go backend included
/// (std/rt Rt_cast, Rt_fault_at). Loc and fault_at (0597's amendment,
/// owner 2026-11-11): a trailing `at: rt.Loc` parameter, filled with the
/// call's position (is_loc_param), and a fault there.
/// fault_raise and task_deadline_left (owner, 2026-11-11, for std/task
/// alone): a fault at a recorded position, and the ns left before the
/// task's deadline.
pub const PORTABLE_INTRINSICS = ["cast", "Loc", "fault_at", "fault_raise", "task_deadline_left"]

/// Whether type t is native/rt's Loc: a trailing parameter of that type
/// takes no argument, each call fills it with its own position.
pub fn (c: Checker) is_loc_type(t: Int) -> Bool {
  if t < 0 {
    return false
  }
  let o = c.tys[c.resolve(t)].obj
  o >= 0 && text(c.objs[o].name) == "Loc" && c.objs[o].module >= 0 && c.mods[c.objs[o].module].path == "native/rt"
}

/// XO0609 when a merged std module (decision 0588) names a member of
/// native/rt that is not portable (decision 0597).
fn (var c: Checker) portable_check(m: Int, sel: Ident) {
  if c.cur_mod < 0 || !c.mods[c.cur_mod].merged || c.mods[m].path != "native/rt" {
    return
  }
  let n = text(sel.name)
  if !PORTABLE_INTRINSICS.contains(n) {
    let d = c.error("XO0609", sel.span, "`rt.${n}` is not a portable intrinsic: a merged std module calls only ${PORTABLE_INTRINSICS.map(fn(x: Str) -> Str { "`rt.${x}`" }).join(", ")} of native/rt (decision 0597)")
    c.note(d, "keep the call in the module's std/native/M_native.xo behind a bodyless declaration, or write it with prelude operations")
  }
}
