// The canonical dump, the names and diags sections of `xo typedump`
// (internal/check/dump.go, decision 0141).

/// Runs the checker's passes over the loaded modules (check.go run):
/// declarations, type declarations, and signatures of every module, then
/// the bodies of the user modules. The error is a prelude without a core
/// type the passes name (prelude_missing), found after the declarations.
fn (var c: Checker) run() -> () ! Str {
  // the std tree's modules are declared and resolved before the
  // program's, so their objects, types and effect sets come first in the
  // tables (decision 0388: std's checked declarations as one prefix); std
  // never imports a program module, so this is still an order in which
  // every import comes before its importer
  var std_mods: List[Int] = []
  var prog_mods: List[Int] = []
  for m in c.order {
    if c.mods[m].std_tree {
      std_mods.push(m)
    } else {
      prog_mods.push(m)
    }
  }
  let at = StdBlock{obj_lo: c.objs.len(), ty_lo: c.tys.len(), eset_lo: c.esets.len(), evar_lo: c.evars.len()}
  var fp = ""
  // stage 2 piece 1: modules made from the record have no trees yet.
  // install_std joins each recorded object's trees (its declaration,
  // defaults) from its file's parse: every file for a whole-program
  // build (its SSA lowers std bodies); for a separately compiled build
  // (trees_lazy, pieces 3 and 4) only the files holding a generic object
  // now (the SSA builder instantiates std generics transitively, inside
  // bodies the check never visits, so those trees must be there before
  // it runs), the rest on demand (need_tree: a constant's initializer,
  // a default's presence, a lazy body)
  // the generic objects whose declarations were parsed alone (decision
  // 0428): installed pending, then joined by need_tree, which marks a
  // joined body for the lazy check (check_module walks no declaration of
  // an unloaded file)
  var gen_objs: List[Int] = []
  if c.trees_lazy && c.std_record != None && !c.std_export_verify {
    if let Some(e) = c.std_record {
      // the rebuild's test: nothing parsed now, every tree pending
      let objs = if c.trees_test_pend { [] } else { e.objs }
      for (xi, x) in objs.indexed() {
        if x.decl_file >= 0 {
          let generic = !x.tparams.is_empty()
          let ri = x.recv - e.block.obj_lo
          let rgen = x.recv >= 0 && ri >= 0 && ri < e.objs.len() && !e.objs[ri].tparams.is_empty()
          if generic || rgen {
            if let Some(f) = e.file_index(x.decl_file) {
              if let Some(fi) = c.file_by_path(f) {
                // the declaration alone (decision 0428), and its generic
                // receiver's; ensure_decl parses the module when it cannot
                c.ensure_decl(fi, x.decl_idx)
                if c.decl_parse {
                  gen_objs.push(xi)
                }
                if rgen {
                  if let Some(rp) = e.file_index(e.objs[ri].decl_file) {
                    if let Some(rfi) = c.file_by_path(rp) {
                      c.ensure_decl(rfi, e.objs[ri].decl_idx)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } else {
    for m in std_mods {
      c.ensure_tree(m)
    }
  }
  if c.std_export_on {
    // piece 2: the entry's own fingerprint when its stamps held (no std
    // source read or hashed); verify always hashes
    fp = if !c.std_header_fp.is_empty() && !c.std_export_verify { c.std_header_fp } else { c.std_fingerprint(std_mods) }
    if !c.std_export_verify {
      let found = match c.std_record {
        Some(e) => Some(e)
        None => decode_std_entry(c.std_export_in, fp)
      }
      if let Some(e) = found {
        match c.relocate_export(e, at) {
          Some(r) => {
            c.std_export_used = c.install_std(r)
            if !c.std_export_used && c.std_export_why.is_empty() {
              c.std_export_why = "the records did not install"
            }
            if c.std_export_used {
              for xi in gen_objs {
                c.need_tree(at.obj_lo + xi)
              }
            }
          }
          None => c.std_export_why = "the records did not relocate"
        }
      } else {
        c.std_export_why = "no records for the fingerprint"
      }
    }
  }
  if !c.std_export_used {
    // the full path (no entry, a header that failed, or records that
    // did not install): every tree, declared from the sources
    for m in std_mods {
      c.ensure_tree(m)
    }
    c.std_block = at
    for m in std_mods {
      c.declare(m)
    }
  } else {
    // a std module the program imports that the record lacks (loaded
    // and parsed as before): declared after the records, its objects
    // past the block
    for m in std_mods {
      if !c.mods[m].from_record {
        c.declare(m)
      }
    }
  }
  let missing = c.prelude_missing()
  if !missing.is_empty() {
    return Err(missing)
  }
  if c.std_export_used {
    for m in std_mods {
      if !c.mods[m].from_record {
        c.resolve_types(m)
      }
    }
    for m in std_mods {
      if !c.mods[m].from_record {
        c.resolve_sigs(m)
      }
    }
  } else {
    for m in std_mods {
      c.resolve_types(m)
    }
    for m in std_mods {
      c.resolve_sigs(m)
    }
    c.std_block.obj_hi = c.objs.len()
    c.std_block.ty_hi = c.tys.len()
    c.std_block.eset_hi = c.esets.len()
    c.std_block.evar_hi = c.evars.len()
    if c.std_export_on {
      // never a record from a tree still pending: the declare path read
      // every tree above
      for m in std_mods {
        for f in c.mods[m].files {
          if c.files[f].unloaded {
            fault("internal: a std record from an unparsed file (${c.files[f].path})")
          }
        }
      }
      let mine = c.std_export()
      if c.std_export_verify {
        c.std_export_bad = c.verify_std_entry(fp, at, mine)
      }
      c.std_export_out = encode_std_entry(c.std_header(std_mods, fp, c.std_now_ms), mine)
    }
  }
  for m in prog_mods {
    c.declare(m)
  }
  c.check_export_names()
  for m in prog_mods {
    c.resolve_types(m)
  }
  for m in prog_mods {
    c.resolve_sigs(m)
  }
  for m in c.order {
    if !c.mods[m].is_std {
      c.check_derives_comparable(m)
    }
  }
  c.mod_cache_load()
  // check_bodies_of names modules as preload does (native/llrt/pool is
  // a file of the runtime module std/native/llrt): by mod_index
  var bodies: Set[Int] = #{}
  var body_files: List[Str] = []
  for p in c.check_bodies_of {
    if let Some(bm) = c.mod_index.get(p) {
      bodies.add(bm)
    }
    body_files.push("/${p}.xo")
  }
  // a runtime file loaded through another module too (std/native's
  // imports load the runtime as std/native/llrt): that module's bodies
  if !body_files.is_empty() {
    for (m, md) in c.mods.indexed() {
      if md.is_std && !bodies.contains(m) {
        for f in md.files {
          let fp = c.files[f].path
          if body_files.any(fn(s) { fp.ends_with(s) }) {
            bodies.add(m)
            break
          }
        }
      }
    }
  }
  for m in c.order {
    // a std module's bodies ship checked (TestStdChecks checks them in
    // full), so a build does not check them again: except one named in
    // check_bodies_of, and the std module under test
    // (`xo test --std-module`, a root module), whose test file's bodies
    // are its tests and are checked like a program's (2026-10-25: they
    // were built unchecked, so every prelude name in a `std/NAME` module's
    // test was XO1201, a list literal "support is planned")
    if !c.mods[m].is_std || bodies.contains(m) || c.mods[m].root {
      c.check_module(m)
    } else if !c.native {
      // the Go backend lowers a std declaration's default values itself
      // (gen std_default): a call or other expression there needs its
      // types and calls (DS-2's metrics corpus, 2026-10-26: `buckets:
      // List[Float] = latency_buckets()` was "unsupported std default
      // value"); the native backends read the implementation module's
      // (unchanged here)
      c.check_std_defaults(m)
    }
  }
  if c.mod_skip_auto && !c.mod_skip.is_empty() && !c.effect_reads_across_modules().is_empty() {
    c.skip_unsafe = true
  }
  c.rewrite_xml_calls(0)
  c.report_edition_aliases()
  c.check_key_types()
  c.solve_effects()
  c.report_discards()
  c.check_realtime()
  c.flow_bodies()
  c.check_time_layouts()
  c.report_unused()
  // check.go reportAmbiguous: a closure result that nothing determined
  // and whose body never completes is Never
  for t in c.never_results {
    if c.is_open_var(t) {
      c.unify(t, c.named("Never"))
    }
  }
  // XO0402: type parameters that nothing determined
  var done: List[Str] = []
  for tv in c.type_arg_vars {
    let key = "${tv.file}:${tv.span.start.offset}:${tv.span.end.offset}"
    if c.tys[tv.v].ref >= 0 || done.contains(key) {
      continue
    }
    done.push(key)
    let d = c.report(tv.file, "XO0402", tv.span, "cannot infer type argument `${tv.param}` of `${tv.fn_name}`")
    c.note(d, "write it explicitly: `${tv.fn_name}[T](...)`, or give the result an expected type (core 2.7)")
  }
  c.finish_renames()
  for m in c.order {
    if !c.mods[m].is_std && !c.lazy_mod(m) {
      // a lazy module's imports are used in bodies not checked yet
      c.check_unused_imports(m)
    }
  }
  c.mod_cache_replay()
}

/// Reports XO0110 for the imports of module m never referenced.
fn (var c: Checker) check_unused_imports(m: Int) {
  for f in c.mods[m].files {
    for u in c.files[f].ast.imports {
      for (_, imp) in c.files[f].imports.entries() {
        if imp.used || imp.span != u.span || text(u.path) == "native/llrt/cabi" || text(u.path).starts_with("native/llrt/cabi_") {
          // the native prelude imports the C ABI exports for the C
          // runtime, not for itself (decision 0207)
          continue
        }
        let d = c.error_at(f, "XO0110", u.span, "import `${text(u.path)}` is never used")
        c.fix(d, "remove the import", [DEdit{span: JSpan{file: c.files[f].path, line: u.span.start.line, col: u.span.start.col, end_line: u.span.end.line, end_col: u.span.end.col}, replace: ""}])
      }
    }
  }
}

/// The dump of the root modules: names, types, and diagnostics as
/// selected.
pub fn (c: Checker) dump(names: Bool, types: Bool, sigs: Bool, diags: Bool, full: Bool) -> Str {
  var out = StrBuilder.new()
  for m in c.root_mods {
    out.write("== module ${c.mods[m].path} ${c.mods[m].dir}\n")
    for f in c.mods[m].files {
      let path = c.files[f].path
      if names {
        out.write("-- names ${path}\n")
        var lines: List[Str] = []
        for r in c.names {
          if r.file == path {
            let what = if r.obj >= 0 { c.obj_text(r.obj) } else { r.what }
            lines.push("${pad(r.offset)}\t${r.line}:${r.col} ${text(r.name)} ${what}")
          }
        }
        for l in lines.sort() {
          out.write(after_tab(l))
          out.write("\n")
        }
      }
      if types {
        out.write("-- types ${path}\n")
        var lines: List[Str] = []
        for r in c.types {
          if r.file == f {
            // by start, then end descending, then text
            lines.push("${pad(r.start)}${pad(9999999999 - r.end)}\t${r.sline}:${r.scol}-${r.eline}:${r.ecol} ${r.kind} ${c.show(r.ty)}")
          }
        }
        for l in lines.sort() {
          out.write(after_tab(l))
          out.write("\n")
        }
      }
    }
    if sigs {
      out.write("-- sigs\n")
      c.dump_sigs(out, m)
    }
  }
  if diags {
    out.write("== diags\n")
    for l in diag_lines(c.diags) {
      out.write(l)
      out.write("\n")
    }
  }
  if full {
    out.write("== full\n")
    for l in full_lines(c.diags) {
      out.write(l)
      out.write("\n")
    }
  }
  out.freeze()
}

/// The lines of the full section: each diagnostic as `xo check --json`
/// prints it (diag.Diagnostic: severity, notes, fixes), sorted as
/// diag_lines with equal ones in report order (dump.go FullLines).
pub fn full_lines(ds: List[Diag]) -> List[Str] {
  var keyed: List[Str] = []
  for (i, d) in ds.indexed() {
    keyed.push("${d.file}\x00${pad(d.line)}${pad(d.col)}${d.code}\x00${d.message}\x00${pad(i)}\t${full_json(d)}")
  }
  var out: List[Str] = []
  for k in keyed.sort() {
    out.push(after_tab(k))
  }
  out
}

fn jspan_json(s: JSpan) -> Str {
  var out = "{\"file\":${json_html(s.file)},\"line\":${s.line},\"col\":${s.col}"
  if s.end_line != 0 {
    out = out + ",\"end_line\":${s.end_line}"
  }
  if s.end_col != 0 {
    out = out + ",\"end_col\":${s.end_col}"
  }
  out + "}"
}

fn full_json(d: Diag) -> Str {
  let sev = if d.note_sev { "note" } else if d.warning { "warning" } else { "error" }
  var notes: List[Str] = []
  for n in d.notes {
    var s = "{\"message\":${json_html(n.message)}"
    if let Some(sp) = n.span {
      s = s + ",\"span\":${jspan_json(sp)}"
    }
    notes.push(s + "}")
  }
  var fixes: List[Str] = []
  for f in d.fixes {
    var edits: List[Str] = []
    for e in f.edits {
      edits.push("{\"span\":${jspan_json(e.span)},\"replace\":${json_html(e.replace)}}")
    }
    fixes.push("{\"title\":${json_html(f.title)},\"edits\":[${edits.join(",")}]}")
  }
  let span = JSpan{file: d.file, line: d.line, col: d.col, end_line: d.end_line, end_col: d.end_col}
  "{\"code\":${json_html(d.code)},\"severity\":\"${sev}\",\"message\":${json_html(d.message)},\"span\":${jspan_json(span)},\"notes\":[${notes.join(",")}],\"fixes\":[${fixes.join(",")}]}"
}

/// The diagnostic lines, sorted by position, code, and message.
pub fn diag_lines(ds: List[Diag]) -> List[Str] {
  var keyed: List[Str] = []
  for d in ds {
    let json = "{\"code\":${json_str(d.code)},\"file\":${json_str(d.file)},\"line\":${d.line},\"col\":${d.col},\"end_line\":${d.end_line},\"end_col\":${d.end_col},\"message\":${json_str(d.message)}}"
    keyed.push("${d.file}\x00${pad(d.line)}${pad(d.col)}${d.code}\x00${d.message}\x00\t${json}")
  }
  var out: List[Str] = []
  for k in keyed.sort() {
    out.push(after_tab(k))
  }
  out
}

/// The signature and effects of every function and method declared in
/// module m (dump.go dumpSigs), sorted by file and position.
fn (c: Checker) dump_sigs(var out: StrBuilder, m: Int) {
  var fns: List[Int] = []
  for (_, o) in c.mods[m].members.entries() {
    let x = c.objs[o]
    if x.kind == ObjKind.Func {
      fns.push(o)
    } else if x.kind == ObjKind.Type {
      for (_, f) in x.methods.entries() {
        fns.push(f)
      }
      for (_, f) in x.statics.entries() {
        fns.push(f)
      }
      for f in x.iface_meths {
        fns.push(f)
      }
    }
  }
  var lines: List[Str] = []
  for f in fns {
    let x = c.objs[f]
    if !x.sig_done {
      continue
    }
    var line = "${pos_text(x.file, x.line, x.col)} ${c.display_name(f)} ${c.sig_text(f)}"
    let eff = c.fn_effects_text(f)
    if !eff.is_empty() {
      line = "${line} uses ${eff}"
    }
    lines.push("${x.file}\x00${pad(x.line)}${pad(x.col)}\t${line}")
  }
  for l in lines.sort() {
    out.write(after_tab(l))
    out.write("\n")
  }
}

/// The declared or inferred effects of function f as the sigs section
/// prints them.
fn (c: Checker) fn_effects_text(f: Int) -> Str {
  if c.objs[f].declared >= 0 {
    return c.eff_text(c.objs[f].declared)
  }
  if let Some(fl) = c.inferred.get(f) {
    return c.flat_text(fl)
  }
  ""
}

/// A signature without its effects: type parameters, receiver,
/// parameters, result, and error type (dump.go sigText).
fn (c: Checker) sig_text(f: Int) -> Str {
  let x = c.objs[f]
  var b = StrBuilder.new()
  if !x.tparams.is_empty() {
    b.write("[")
    for (i, p) in x.tparams.indexed() {
      if i > 0 {
        b.write(", ")
      }
      if c.objs[p].implicit {
        b.write("implicit ")
      }
      b.write(text(c.objs[p].name))
      if c.objs[p].effect {
        b.write(": Effects")
      } else if c.objs[p].constraint >= 0 {
        b.write(": ")
        b.write(c.show(c.objs[p].constraint))
      }
    }
    b.write("]")
  }
  b.write("(")
  if x.recv_ty >= 0 {
    if x.recv_var {
      b.write("var ")
    }
    b.write("self: ")
    b.write(c.show(x.recv_ty))
    if !x.params.is_empty() {
      b.write(", ")
    }
  }
  for (i, p) in x.params.indexed() {
    if i > 0 {
      b.write(", ")
    }
    if p.is_var {
      b.write("var ")
    }
    b.write("${text(p.name)}: ${c.show(p.ty)}")
  }
  b.write(")")
  if x.result >= 0 && !c.is_unit(x.result) {
    b.write(" -> ${c.show(x.result)}")
  }
  if x.err >= 0 {
    b.write(" ! ${c.show(x.err)}")
  }
  b.freeze()
}

fn (c: Checker) obj_text(o: Int) -> Str {
  let x = c.objs[o]
  let pos = if x.file.is_empty() { "-" } else { "${x.file}:${x.line}:${x.col}" }
  match x.kind {
    Local => "local ${x.local} ${pos}"
    Func => "fn ${c.mods[x.module].path} ${c.display_name(o)} ${pos}"
    Const => "const ${c.mods[x.module].path} ${text(x.name)} ${pos}"
    Type => "type ${c.mods[x.module].path} ${text(x.name)} ${pos}"
    TParam => "tparam ${text(x.name)} ${pos}"
    Module => "module ${c.mods[x.module].path}"
  }
}

/// n with leading zeros to 10 digits, for sorting.
fn pad(n: Int) -> Str {
  let s = "${n}"
  "0".repeat(10 - s.len()) + s
}

/// The text after the first tab.
fn after_tab(s: Str) -> Str {
  let b = s.bytes()
  for i in 0..b.len() {
    if b[i] == '\t' {
      return b[i + 1..].to_str() ?? ""
    }
  }
  s
}

/// A JSON string as Go's encoding/json writes it without HTML escaping.
fn json_str(s: Str) -> Str {
  json_quote(s, false)
}

/// s as a JSON string as json.Marshal writes it: `<`, `>`, and `&` escaped
/// (the full section: diag.Diagnostic marshals itself with json.Marshal).
fn json_html(s: Str) -> Str {
  json_quote(s, true)
}

fn json_quote(s: Str, html: Bool) -> Str {
  let b = s.bytes()
  var out = StrBuilder.new()
  out.write("\"")
  var run = 0
  var i = 0
  while i < b.len() {
    let ch = b[i]
    var esc = ""
    var width = 1
    if ch == '"' {
      esc = "\\\""
    } else if ch == '\\' {
      esc = "\\\\"
    } else if ch == '\n' {
      esc = "\\n"
    } else if ch == '\r' {
      esc = "\\r"
    } else if ch == '\t' {
      esc = "\\t"
    } else if ch < 0x20 || (html && (ch == '<' || ch == '>' || ch == '&')) {
      esc = "\\u00${b[i..i + 1].to_hex()}"
    } else if ch == 0xe2 && i + 2 < b.len() && b[i + 1] == 0x80 && (b[i + 2] == 0xa8 || b[i + 2] == 0xa9) {
      esc = if b[i + 2] == 0xa8 { "\\u2028" } else { "\\u2029" }
      width = 3
    }
    if esc.is_empty() {
      i += 1
      continue
    }
    if run < i {
      out.write(b[run..i].to_str() ?? "")
    }
    out.write(esc)
    i += width
    run = i
  }
  if run < b.len() {
    out.write(b[run..].to_str() ?? "")
  }
  out.write("\"")
  out.freeze()
}
