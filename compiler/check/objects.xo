// The checker's tables: objects, modules, files, and what it records
// (decision 0141). The data is graph shaped (a scope maps names to
// objects, an object belongs to a module, a module has files that import
// other modules), and Xo values have no identity, so every node lives in
// a table of the Checker and refers to others by index: an object is an
// Int into `objs`, a module an Int into `mods`, a file an Int into
// `files`, a type an Int into `tys` (types.xo). -1 stands for "none".

use github.com/xo-lang/xo/compiler/parser

pub type Span = parser.Span
pub type Ident = parser.Ident

/// What an object is.
pub enum ObjKind {
  /// A function: top level, method, static, or interface method.
  Func
  /// A top level constant.
  Const
  /// A declared type: struct, enum, interface, alias, or newtype.
  Type
  /// A type parameter, declared or implicit.
  TParam
  /// A local binding: let, var, parameter, receiver, or predeclared.
  Local
  /// A module, the target of an import.
  Module
}

/// A struct field.
pub struct FieldInfo {
  pub name: Bytes
  pub ty: Int
  pub is_pub: Bool
  /// The default value: zero or one element.
  pub default: List[parser.Expr] = []
  pub line: Int
  pub col: Int
  /// its name on the wire as written, `kind as "type"` (decision 0277);
  /// empty for none
  pub wire: Bytes = b""
  /// its key in derived JSON and its column in a derived SqlRow: the wire
  /// name, else the name under the derive's `case:` rule, else the name
  /// (decision 0277; check decl.xo wire_keys)
  pub json_key: Bytes = b""
  /// `as "key,omitempty"`: derive Json leaves the field out when it is
  /// empty (decision 0309)
  pub omit_empty: Bool = false
  /// per-format overrides of the wire name (decision 0315): the key, empty
  /// for none (`json ",omitempty"` keeps the default key)
  pub json_wire: Bytes = b""
  pub sql_wire: Bytes = b""
  /// the `xml` string as written (Go's tag text), for derive Xml
  pub xml_wire: Bytes = b""
  pub sql_key: Bytes = b""
}

/// A field of an enum variant; a `from` field has no name.
pub struct VFieldInfo {
  pub name: Bytes
  pub from: Bool
  pub ty: Int
  pub line: Int = 0
  pub col: Int = 0
}

/// An enum variant.
pub struct VariantInfo {
  pub name: Bytes
  pub index: Int
  pub fields: List[VFieldInfo] = []
  /// Declared without parentheses.
  pub unit: Bool
  pub line: Int
  pub col: Int
}

/// A declared parameter of a function.
pub struct ParamInfo {
  pub name: Bytes
  pub ty: Int
  pub is_var: Bool
  /// The default value: zero or one element.
  pub default: List[parser.Expr] = []
  pub line: Int = 0
  pub col: Int = 0
}

/// A named entity. Positions are those of the declaring name.
pub struct Obj {
  pub kind: ObjKind
  pub name: Bytes
  /// The declaring module (Func, Const, Type), or the module a Module
  /// object stands for; -1 otherwise.
  pub module: Int = -1
  /// The declaring file, "" when there is none (the `os` of a test).
  pub file: Str = ""
  pub line: Int = 0
  pub col: Int = 0
  /// Local: let, var, param, var-param, recv, var-recv, or predeclared.
  pub local: Str = ""
  /// TParam: an effect variable (`fx: Effects`).
  pub effect: Bool = false
  /// Type, Func: type parameters (TParam objects); a function's implicit
  /// receiver parameters come first.
  pub tparams: List[Int] = []
  /// Func, Const, Type: declared `pub` (everything in std is).
  pub is_pub: Bool = false
  /// Type: struct, enum, interface, alias, or newtype.
  pub tkind: Str = ""

  // Types (decl.xo resolve_type_obj).
  pub fields: List[FieldInfo] = []
  pub variants: List[VariantInfo] = []
  /// Interface methods (Func objects).
  pub iface_meths: List[Int] = []
  /// Alias target or newtype underlying type.
  pub target: Int = -1
  pub derives: List[Str] = []
  /// An empty std struct: an opaque handle.
  pub opaque: Bool = false
  /// Methods and statics (Func objects) by name.
  pub methods: Map[Bytes, Int] = {}
  pub statics: Map[Bytes, Int] = {}
  pub resolving: Bool = false
  pub resolved: Bool = false
  /// The declaration: file and index in its declarations (Type, Func,
  /// Const), -1 for none.
  pub decl_file: Int = -1
  pub decl_idx: Int = -1

  // Functions (decl.xo resolve_sig).
  /// The declaration (zero or one element).
  pub fn_decl: List[parser.FnDecl] = []
  pub params: List[ParamInfo] = []
  pub result: Int = -1
  /// The error type, -1 when it cannot fail.
  pub err: Int = -1
  /// Methods: the receiver's Type object and receiver type.
  pub recv: Int = -1
  pub recv_ty: Int = -1
  pub recv_var: Bool = false
  /// A std function whose receiver is named `static`.
  pub is_static: Bool = false
  /// A static constant: `Time.UNIX_EPOCH`.
  pub static_const: Bool = false
  pub iface: Bool = false
  /// The number of type parameters the declaration writes.
  pub own_tparams: Int = 0
  /// The declared effects (an effect set), -1 when they are inferred
  /// (a function that is not pub and has no `uses`).
  pub declared: Int = -1
  pub sig_done: Bool = false
  /// The effects its body performs (an effect set), -1 until checked.
  pub body_eff: Int = -1
  /// A function whose doc comment says `@moves`: its receiver is moved
  /// by the call (core 5.3).
  pub moves: Bool = false
  /// A std struct whose doc comment says `@move_only`: its values move
  /// like the builders' (core 5.3).
  pub move_only: Bool = false
  /// Declared `uses realtime` (core 6.5), and where.
  pub realtime: Bool = false
  pub realtime_span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}

  // Constants and locals.
  /// Const, Local: the type, -1 until known.
  pub ty: Int = -1
  pub done: Bool = false
  pub checking: Bool = false
  /// Local: a `var` binding, parameter, or receiver.
  pub mutable: Bool = false
  /// Local: a block `const`.
  pub is_const: Bool = false
  /// Local: the value of a block `const` (zero or one element).
  pub const_val: List[parser.Expr] = []
  /// Local: the context (Ctx) it was declared in.
  pub vctx: Int = -1
  /// Local: the frame of the scope it names (`scope s`), or of the scope
  /// whose group it holds; -1 for none.
  pub frame: Int = -1
  pub group_frame: Int = -1
  /// Local: a task handle awaited somewhere.
  pub awaited: Bool = false
  /// Local: read somewhere (stmt.go VarObj.Used): a `let` or `var`
  /// binding never read is XO0110.
  pub used: Bool = false
  /// Local: bound by a `let` of a single name (stmt.go VarObj.decl): the
  /// statement's span and value (zero or one element), for the fixes of
  /// XO0201 and XO0502.
  pub let_span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  pub let_value: List[parser.Expr] = []

  // Type parameters.
  pub constraint: Int = -1
  pub implicit: Bool = false
  /// An implicit effect parameter for an effect argument left out (core
  /// 6.2): the function may perform it.
  pub elided: Bool = false
  /// Elided: the type written without its effect arguments that created
  /// it (file "" for none) and its text, for the XO0701 note.
  pub elided_file: Str = ""
  pub elided_at: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  pub elided_text: Str = ""
}

/// A module: a directory of .xo files, or a std declaration file.
pub struct Module {
  pub path: Str
  /// The default local name (core 4.1).
  pub name: Str
  pub dir: Str
  pub files: List[Int] = []
  /// Top level names to objects.
  pub members: Map[Bytes, Int] = {}
  pub is_std: Bool = false
  /// A module of the std tree (std, native, llrt), whose declarations
  /// never depend on the program's: declared and resolved before the
  /// program's modules (decision 0388), unlike a `use c` or `use go`
  /// binding module, which is_std too
  pub std_tree: Bool = false
  pub is_prelude: Bool = false
  /// Named on the command line (or found under a named directory).
  pub root: Bool = false
  /// An implementation module of the native backends (std/native/*.xo,
  /// decision 0074), loaded in native mode, and the std module path it
  /// implements ("std/prelude" for the prelude's).
  pub native: Bool = false
  pub implements: Str = ""
  /// Made from a std record (load_std_record, decision 0388 stage 2):
  /// its files unparsed until ensure_tree
  pub from_record: Bool = false
  pub tree_loaded: Bool = false
  /// 0 new, 1 loading its imports, 2 loaded (cycle detection).
  pub state: Int = 0
  /// The Module object that names it in records.
  pub obj: Int = -1
  /// "<path>@<version>" for a package of a required module version
  /// (check deps.go dependencyOf), else "".
  pub dependency: Str = ""
  /// A C header's binding (`use c`, cimport.xo): the adapters' symbol
  /// prefix ("" for other modules), the header as written, the
  /// declaration file, and the names it skipped with why.
  pub c_prefix: Str = ""
  pub c_header: Str = ""
  pub c_decl: Str = ""
  pub c_skipped: Map[Str, Str] = {}
  /// A Go package's binding (`use go`, goimport.xo): the Go import path
  /// ("" for other modules), the declaration file, and the names it
  /// skipped with why ("name" or "Type.name").
  pub go_path: Str = ""
  pub go_decl: Str = ""
  pub go_skipped: Map[Str, Str] = {}
  /// The Go adapter the binder wrote beside the declaration file, and
  /// for a third party package the `path version` requirements and the
  /// go.sum of the binding workspace (gobind.Binding Adapter, Require,
  /// Sum: the code generator's goBindings reads them).
  pub go_adapter: Str = ""
  pub go_require: List[Str] = []
  pub go_sum: Str = ""
  /// the binding workspace's go line (`go mod` raises it to the highest
  /// of its requirements'), "" for none
  pub go_line: Str = ""
  /// the project root whose binding cache holds it, for the `use go`
  /// lines of its declaration file (decision 0392)
  pub go_root: Str = ""
}

/// An import of a file: the module it names, -1 when the path did not
/// resolve (nothing more is reported about it).
pub struct Import {
  pub module: Int
  pub path: Bytes
  pub used: Bool = false
  /// The `use` declaration (for the unused import check).
  pub span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
}

/// One parsed source file.
pub struct SrcFile {
  pub path: Str
  pub module: Int
  pub ast: parser.File
  /// The hash of its interface (parser ParseResult.iface): the module
  /// check and front end caches' key of it (iface_closures)
  pub iface: Str = ""
  /// Local import names to imports.
  pub imports: Map[Bytes, Import] = {}
  /// The name ends in _test.xo.
  pub is_test: Bool = false
  /// Parsed as a signature file (a std module's std/<name>.xo).
  pub sig: Bool = false
  /// Made from a std record (load_std_record): no parse, no source,
  /// until ensure_tree reads and parses it.
  pub unloaded: Bool = false
  /// The expansion of the derives of another file (derive.xo): its
  /// diagnostics are reported at the fields they came from, and it has
  /// no naming or style findings.
  pub generated: Bool = false
  /// The source, for the habits that look at it.
  pub src: Bytes = b""
  /// Per declaration: the object it declares (a function, method,
  /// type, or constant), -1 for none (tests, duplicates, methods that
  /// did not attach).
  pub decl_objs: List[Int] = []
}

/// An xo.mod: the module path it declares and its directory.
pub struct ModRoot {
  pub path: Str
  pub dir: Str
  /// An `edition` line naming an old edition name (`edition 2026`), for
  /// XO1315: its line, column, and the name; "" for none.
  pub alias: Str = ""
  pub alias_line: Int = 0
  pub alias_col: Int = 0
  /// The keyword of the alias line: "edition" (xo.mod) or "xo" (xo.work).
  pub keyword: Str = "edition"
}

/// A diagnostic: code, span, message, severity, notes, and machine fixes
/// (diag.Diagnostic; decision 0141, stage 7).
pub struct Diag {
  pub code: Str
  pub file: Str
  pub line: Int
  pub col: Int
  pub end_line: Int
  pub end_col: Int
  pub message: Str
  /// Not an error: a warning, or a note (note_sev); every `rejected`
  /// test of the tools reads this field.
  pub warning: Bool = false
  /// Severity note (diag.Note: XO1315); warning is set too, since a note
  /// does not fail a check (diag.HasErrors).
  pub note_sev: Bool = false
  pub notes: List[DNote] = []
  pub fixes: List[DFix] = []
}

/// A source span as diagnostics print it (diag.Span): end_line and
/// end_col 0 are left out (a note's point location).
pub struct JSpan {
  pub file: Str
  pub line: Int
  pub col: Int
  pub end_line: Int = 0
  pub end_col: Int = 0
}

/// A note of a diagnostic (diag.NoteItem).
pub struct DNote {
  pub message: Str
  pub span: JSpan? = None
}

/// A machine fix (diag.Fix): its edits replace the text of their spans.
pub struct DFix {
  pub title: Str
  pub edits: List[DEdit]
}

/// One edit of a fix (diag.Edit).
pub struct DEdit {
  pub span: JSpan
  pub replace: Str
}

/// What an identifier resolved to: an object, or (obj -1) the text of a
/// field, variant, or parameter.
pub struct NameRec {
  pub file: Str
  pub offset: Int
  pub line: Int
  pub col: Int
  pub name: Bytes
  pub obj: Int
  pub what: Str = ""
}

/// The type of a checked expression (the types section).
pub struct TypeRec {
  pub file: Int
  pub start: Int
  pub end: Int
  pub sline: Int
  pub scol: Int
  pub eline: Int
  pub ecol: Int
  pub kind: Str
  pub ty: Int
}

/// The inference variable of a type parameter at a call (XO0402 when
/// nothing binds it).
pub struct TypeArgVar {
  pub v: Int
  pub param: Str
  pub fn_name: Str
  pub file: Str
  pub span: Span
}

/// A call of a declared function or a function value (check.go
/// callInfo): the callee (-1 for a function value), the receiver
/// expression of a method call (zero or one), and each argument with
/// whether its parameter is `var`.
pub struct CallInfo {
  pub fn_obj: Int = -1
  pub recv: List[parser.Expr] = []
  pub params: List[ArgParam] = []
  /// The type arguments of the callee's type parameters (check.go
  /// callInfo.sm).
  pub subst: Map[Int, Int] = {}
}

/// A variant: the enum's Type object and the variant's index.
pub struct VRef {
  pub en: Int
  pub variant: Int
}

/// An argument and whether its parameter is `var` (check.go argParam).
pub struct ArgParam {
  pub arg: parser.Expr
  pub is_var: Bool
}

/// A checked body for the flow checks (check.go bodyInfo).
pub struct BodyRef {
  pub file: Int
  pub body: parser.Block
}
