// Declarations, type declarations, signatures, and type expressions
// (internal/check/decl.go).

use github.com/xo-lang/xo/compiler/parser

/// The context of a type expression (decl.go typeEnv).
struct TypeEnv {
  file: Int = -1
  mod: Int = -1
  /// Type parameters in scope by name (TParam objects).
  params: Map[Bytes, Int] = {}
  /// Collect implicit receiver parameters (std encoding rule 5) into
  /// implicit_list.
  implicit: Bool = false
  implicit_list: List[Int] = []
  quiet: Bool = false
  /// The type parameter whose argument is being resolved.
  arg_param: Int = -1
  /// Collect the effect parameters of left out effect arguments.
  elided: Bool = false
  elided_list: List[Int] = []
}

/// e with the parameters ps added and no collection.
fn (c: Checker) env_with(e: TypeEnv, ps: List[Int]) -> TypeEnv {
  var n = e
  for p in ps {
    n.params[c.objs[p].name] = p
  }
  n.implicit = false
  n.implicit_list = []
  n.elided = false
  n.elided_list = []
  n
}

fn (var c: Checker) new_tparams(tps: List[parser.TypeParam]) -> List[Int] {
  var out: List[Int] = []
  for tp in tps {
    let p = c.new_tparam(tp.name.name, c.path, tp.name.span.start.line, tp.name.span.start.col)
    c.objs[p].effect = tp.effects
    c.check_name(tp.name, if tp.effects { "effect variable" } else { "type parameter" })
    out.push(p)
  }
  out
}

fn (var c: Checker) define(id: Ident, o: Int) {
  if id.name.is_empty() {
    return
  }
  let m = c.cur_mod
  if !c.mods[m].is_std && is_protected(id.name) {
    c.error("XO0603", id.span, "`${text(id.name)}` is predeclared and cannot be redefined at top level (core 1.4)")
    return
  }
  if let Some(prev) = c.mods[m].members.get(id.name) {
    let d = c.error("XO0603", id.span, "`${text(id.name)}` is already declared in this module")
    c.note_obj(d, prev, "previous declaration")
    return
  }
  c.mods[m].members[id.name] = o
}

// ---------------------------------------------------------------------------
// Declarations (decl.go declare)

/// Creates objects for the top level declarations of module m.
fn (var c: Checker) declare(m: Int) {
  for f in c.mods[m].files {
    c.set_file(f)
    for u in c.files[f].ast.imports {
      if let Some(a) = u.alias {
        c.check_name(a, "module")
      }
    }
    let decls = c.files[f].ast.decls
    for (i, d) in decls.indexed() {
      var o = -1
      match d {
        FnDecl(d: fd) => {
          if fd.recv == None {
            o = c.new_obj(ObjKind.Func, fd.name)
            c.objs[o].is_pub = fd.is_pub || c.mods[m].is_std
            c.objs[o].fn_decl = [fd]
            c.objs[o].moves = doc_moves(fd.doc)
            c.objs[o].decl_file = f
            c.objs[o].decl_idx = i
            c.check_name(fd.name, "function")
            c.define(fd.name, o)
          }
        }
        StructDecl(d: sd) => {
          o = c.declare_type(sd.name, sd.type_params, sd.is_pub, "struct", f, i)
          c.objs[o].opaque = c.mods[m].is_std && sd.fields.is_empty()
          // a std handle documented `@move_only` is moved like the builders
          // (core 5.3; std/compress's Compressor, decision 0305)
          c.objs[o].move_only = c.mods[m].is_std && doc_has(sd.doc, "@move_only")
        }
        EnumDecl(d: ed) => o = c.declare_type(ed.name, ed.type_params, ed.is_pub, "enum", f, i)
        InterfaceDecl(d: id) => o = c.declare_type(id.name, id.type_params, id.is_pub, "interface", f, i)
        TypeDecl(d: td) => o = c.declare_type(td.name, td.type_params, td.is_pub, if td.newtype { "newtype" } else { "alias" }, f, i)
        ConstDecl(d: cd) => {
          o = c.new_obj(ObjKind.Const, cd.name)
          c.objs[o].is_pub = cd.is_pub || c.mods[m].is_std
          c.objs[o].decl_file = f
          c.objs[o].decl_idx = i
          c.check_name(cd.name, "constant")
          c.define(cd.name, o)
        }
        _ => {}
      }
      c.files[f].decl_objs.push(o)
    }
  }
}

fn (var c: Checker) declare_type(name: Ident, tps: List[parser.TypeParam], is_pub: Bool, tkind: Str, f: Int, i: Int) -> Int {
  let o = c.new_obj(ObjKind.Type, name)
  c.objs[o].is_pub = is_pub || c.mods[c.cur_mod].is_std
  c.objs[o].tparams = c.new_tparams(tps)
  c.objs[o].tkind = tkind
  c.objs[o].decl_file = f
  c.objs[o].decl_idx = i
  c.check_name(name, if tkind == "interface" { "interface" } else { "type" })
  c.define(name, o)
  o
}

/// Whether declaration i of file f is the declaration its name resolves
/// to (not a duplicate).
fn (c: Checker) is_scope_entry(f: Int, i: Int, name: Bytes) -> Bool {
  let o = c.files[f].decl_objs[i]
  o >= 0 && (c.mods[c.files[f].module].members.get(name) ?? -1) == o
}

// ---------------------------------------------------------------------------
// Type declarations (decl.go resolveTypes)

/// Resolves the type declarations of m, by name.
fn (var c: Checker) resolve_types(m: Int) {
  c.cur_mod = m
  var names: List[Bytes] = []
  for (n, o) in c.mods[m].members.entries() {
    if c.objs[o].kind == ObjKind.Type {
      names.push(n)
    }
  }
  for n in names.sort() {
    let o = c.mods[m].members.get(n) ?? -1
    c.resolve_type_obj(o)
  }
}

fn (var c: Checker) resolve_type_obj(t: Int) {
  if c.objs[t].resolved || c.objs[t].resolving || c.objs[t].decl_file < 0 {
    return
  }
  c.objs[t].resolving = true
  let saved_mod = c.cur_mod
  let saved_file = c.cur_file
  let saved_path = c.path
  let f = c.objs[t].decl_file
  c.set_file(f)
  var env = c.env_with(TypeEnv{file: f, mod: c.objs[t].module}, c.objs[t].tparams)
  env.elided = true
  // a std type's tree, when its record left the file unparsed
  c.need_tree(t)
  let d = c.top_decl(f, c.objs[t].decl_idx) ?? fault("internal: type ${text(c.objs[t].name)}'s tree is not parsed (${c.files[f].path})")
  match d {
    StructDecl(d: sd) => {
      c.resolve_constraints(sd.type_params, c.objs[t].tparams, env)
      var seen: List[Bytes] = []
      var fields: List[FieldInfo] = []
      for fl in sd.fields {
        c.check_name(fl.name, "field")
        if seen.contains(fl.name.name) {
          c.error("XO0603", fl.name.span, "field `${text(fl.name.name)}` is declared twice")
          continue
        }
        seen.push(fl.name.name)
        let ft = c.resolve_type(fl.typ, env)
        var dflt: List[Expr] = []
        if let Some(e) = fl.default {
          dflt.push(e)
        }
        var wire = b""
        var omit = false
        if let Some(w) = fl.wire {
          // Go's tag options after a comma (decision 0309)
          let (key, opts) = wire_parts(w)
          if w.is_empty() {
            c.error("XO0412", fl.wire_span ?? fl.name.span, "field `${text(fl.name.name)}` has an empty wire name; write a key, or leave out `as \"\"` to use the field's name")
          }
          for o in opts {
            if o == b"omitempty" {
              omit = true
            } else {
              c.error("XO0422", fl.wire_span ?? fl.name.span, "unknown wire name option `${text(o)}` of field `${text(fl.name.name)}`; the only option is `omitempty` (decision 0309)")
            }
          }
          wire = key
        }
        // per-format overrides (decision 0315): the format's own string
        // replaces the name and its options for that format
        var json_wire = b""
        var sql_wire = b""
        var xml_wire = b""
        var seen_fmt: List[Bytes] = []
        for fw in fl.formats {
          if seen_fmt.contains(fw.format) {
            c.error("XO0423", fw.span, "field `${text(fl.name.name)}` has two `${text(fw.format)}` wire strings; keep one")
            continue
          }
          seen_fmt.push(fw.format)
          let (key, opts) = wire_parts(fw.wire)
          if fw.wire.is_empty() {
            c.error("XO0412", fw.span, "field `${text(fl.name.name)}` has an empty `${text(fw.format)}` wire name; write a key, or leave the string out to use the shared one")
          }
          if fw.format == b"json" {
            json_wire = key
            omit = false
            for o in opts {
              if o == b"omitempty" {
                omit = true
              } else {
                c.error("XO0422", fw.span, "unknown wire name option `${text(o)}` of field `${text(fl.name.name)}`; the only json option is `omitempty` (decision 0309)")
              }
            }
          } else if fw.format == b"sql" {
            sql_wire = key
            for o in opts {
              c.error("XO0422", fw.span, "unknown wire name option `${text(o)}` of field `${text(fl.name.name)}`; a `sql` column name takes no options")
            }
          } else {
            xml_wire = fw.wire
          }
        }
        fields.push(FieldInfo{name: fl.name.name, ty: ft, is_pub: fl.is_pub || c.mods[c.objs[t].module].is_std, default: dflt, line: fl.name.span.start.line, col: fl.name.span.start.col, wire: wire, omit_empty: omit, json_wire: json_wire, sql_wire: sql_wire, xml_wire: xml_wire})
      }
      c.objs[t].derives = c.derives_of(sd.derive)
      c.objs[t].fields = c.wire_keys(sd, fields, c.objs[t].derives)
    }
    EnumDecl(d: ed) => {
      c.resolve_constraints(ed.type_params, c.objs[t].tparams, env)
      var seen: List[Bytes] = []
      var vs: List[VariantInfo] = []
      for (i, v) in ed.variants.indexed() {
        c.check_name(v.name, "variant")
        if seen.contains(v.name.name) {
          c.error("XO0603", v.name.span, "variant `${text(v.name.name)}` is declared twice")
          continue
        }
        seen.push(v.name.name)
        var vi = VariantInfo{name: v.name.name, index: i, unit: v.fields == None, line: v.name.span.start.line, col: v.name.span.start.col}
        let vfs = v.fields ?? []
        var fseen: List[Bytes] = []
        for vf in vfs {
          var fo = VFieldInfo{name: b"", from: vf.from, ty: c.resolve_type(vf.typ, env)}
          if let Some(n) = vf.name {
            fo.name = n.name
            fo.line = n.span.start.line
            fo.col = n.span.start.col
            c.check_name(n, "field")
            if fseen.contains(n.name) {
              c.error("XO0603", n.span, "field `${text(n.name)}` is declared twice")
            }
            fseen.push(n.name)
          }
          if vf.from && vfs.len() != 1 {
            c.error("XO0403", vf.span, "a `from` variant has exactly one field (core 2.6)")
          }
          vi.fields.push(fo)
        }
        vs.push(vi)
      }
      // variant indexes are declaration positions (duplicates skipped
      // keep their index)
      c.objs[t].variants = vs
      c.objs[t].derives = c.derives_of(ed.derive)
    }
    InterfaceDecl(d: id) => {
      c.resolve_constraints(id.type_params, c.objs[t].tparams, env)
      var seen: List[Bytes] = []
      for md in id.methods {
        let fo = c.new_obj(ObjKind.Func, md.name)
        c.objs[fo].module = c.objs[t].module
        c.objs[fo].is_pub = true
        c.objs[fo].fn_decl = [md]
        c.objs[fo].iface = true
        c.objs[fo].recv = t
        c.check_name(md.name, "method")
        if seen.contains(md.name.name) {
          c.error("XO0603", md.name.span, "method `${text(md.name.name)}` is declared twice")
          continue
        }
        seen.push(md.name.name)
        if md.params.is_empty() || !md.params[0].is_self {
          if !c.mods[c.objs[t].module].is_std {
            c.error("XO0403", md.name.span, "interface method `${text(md.name.name)}` must take `self` first (core 2.4)")
          }
        }
        c.resolve_sig(fo, env, true)
        c.objs[t].iface_meths.push(fo)
      }
    }
    TypeDecl(d: td) => {
      c.resolve_constraints(td.type_params, c.objs[t].tparams, env)
      c.objs[t].target = match td.typ {
        Some(x) => c.resolve_type(x, env)
        None => c.bad_ty
      }
      c.objs[t].derives = c.derives_of(td.derive)
    }
    _ => {}
  }
  for p in env.elided_list {
    c.objs[t].tparams.push(p)
  }
  c.objs[t].resolving = false
  c.objs[t].resolved = true
  c.cur_mod = saved_mod
  c.cur_file = saved_file
  c.path = saved_path
}

fn (var c: Checker) resolve_constraints(tps: List[parser.TypeParam], ps: List[Int], var env: TypeEnv) {
  for (i, tp) in tps.indexed() {
    if let Some(ct0) = tp.constraint {
      if i < ps.len() {
        var ct = c.resolve_type(ct0, env)
        if !c.is_bad(ct) && !c.is_interface(ct) {
          c.error("XO0407", parser.type_span(ct0), "constraint `${c.show_raw(ct)}` is not an interface (core 2.7)")
          ct = -1
        }
        c.objs[ps[i]].constraint = ct
      }
    }
  }
}

/// The derives that map a field to an outside name (decision 0277): JSON
/// keys (and TOML's, which std/toml decodes through JSON) and SqlRow
/// columns. OpenApi and Proto generate nothing yet (core 2.9).
const WIRE_DERIVES = ["Json", "SqlRow"]

/// fields with their JSON keys and SqlRow columns set (decision 0277):
/// a field's `as "key"`, else its name under its derive's `case:` rule,
/// else its name. Checks the derive arguments (XO0413), two fields with
/// one key under a derive the struct has (XO0411), and warns about wire
/// names no derive uses (XO0414).
fn (var c: Checker) wire_keys(sd: parser.StructDecl, fields0: List[FieldInfo], derives: List[Str]) -> List[FieldInfo] {
  var fields = fields0
  var json_case = ""
  var sql_case = ""
  for a in sd.derive_args {
    let d = text(a.derive.name)
    let k = text(a.key.name)
    let v = text(a.value.name)
    if !(d is "Json" | "SqlRow") {
      c.error("XO0413", a.span, "`derive ${d}` takes no arguments; `case:` applies to `derive Json` and `derive SqlRow` (decision 0277)")
      continue
    }
    if k != "case" {
      c.error("XO0413", a.key.span, "unknown argument `${k}` of `derive ${d}`; it takes `case: snake | camel | pascal | kebab`")
      continue
    }
    if !(v is "snake" | "camel" | "pascal" | "kebab") {
      c.error("XO0413", a.value.span, "unknown case `${v}`; `case:` is one of snake, camel, pascal, kebab")
      continue
    }
    if d == "Json" { json_case = v } else { sql_case = v }
  }
  var any_wire = false
  for i in 0..fields.len() {
    let f = fields[i]
    any_wire = any_wire || !f.wire.is_empty() || f.omit_empty
    // the format's own string, else the shared `as`, else the field's
    // name under the case rule (decision 0315)
    fields[i].json_key = if !f.json_wire.is_empty() { f.json_wire } else if !f.wire.is_empty() { f.wire } else { wire_case(f.name, json_case) }
    fields[i].sql_key = if !f.sql_wire.is_empty() { f.sql_wire } else if !f.wire.is_empty() { f.wire } else { wire_case(f.name, sql_case) }
  }
  // an override for a format the struct does not derive (decision 0315)
  for fl in sd.fields {
    for fw in fl.formats {
      let d = derive_for_format(text(fw.format)) ?? "Json"
      if !derives.contains(d) {
        c.error("XO0424", fw.span, "field `${text(fl.name.name)}` has a `${text(fw.format)}` wire string, but `${text(sd.name.name)}` does not derive ${d}; add `derive ${d}` or remove the string")
      }
    }
  }
  for d in WIRE_DERIVES {
    if !derives.contains(d) {
      continue
    }
    var seen: Map[Bytes, Int] = {}
    for (i, f) in fields.indexed() {
      let key = if d == "Json" { f.json_key } else { f.sql_key }
      if let Some(j) = seen.get(key) {
        let sp = sd.fields[i].wire_span ?? sd.fields[i].name.span
        c.error("XO0411", sp, "fields `${text(fields[j].name)}` and `${text(f.name)}` both have the key `${text(key)}` in `derive ${d}`; give one of them another wire name")
      } else {
        seen[key] = i
      }
    }
  }
  if any_wire && !maps_field_names(derives) {
    for fl in sd.fields {
      if let Some(ws) = fl.wire_span {
        c.warn("XO0414", ws, "the wire name of field `${text(fl.name.name)}` is unused: no derive of `${text(sd.name.name)}` maps fields to keys (${field_name_derives().join(", ")})")
      }
    }
  }
  fields
}

/// A wire string's key and its comma separated options (Go's struct tag
/// form, decision 0309): `"email,omitempty"` is ("email", ["omitempty"]),
/// `",omitempty"` an empty key (the field's default key) with one option.
fn wire_parts(w: Bytes) -> (Bytes, List[Bytes]) {
  var parts: List[Bytes] = []
  var start = 0
  for i in 0..w.len() {
    if w[i] == ',' {
      parts.push(w[start..i])
      start = i + 1
    }
  }
  parts.push(w[start..w.len()])
  (parts[0], parts[1..parts.len()])
}

/// name (a snake_case field name) under a `case:` rule (decision 0277):
/// snake as is, camel `api_version` to `apiVersion`, pascal to
/// `ApiVersion`, kebab to `api-version`; "" is the name as is.
pub fn wire_case(name: Bytes, rule: Str) -> Bytes {
  if rule is "" | "snake" {
    return name
  }
  var b = BytesBuilder.new()
  var up = rule == "pascal"
  var first = true
  for ch in name {
    if ch == '_' {
      if rule == "kebab" {
        b.write_byte('-')
      } else if !first {
        up = true
      }
      continue
    }
    if up && ch >= 'a' && ch <= 'z' {
      b.write_byte(ch - 32)
    } else {
      b.write_byte(ch)
    }
    up = false
    first = false
  }
  b.freeze()
}

fn (var c: Checker) derives_of(ids: List[Ident]) -> List[Str] {
  var out: List[Str] = []
  for id in ids {
    if !is_derivable(id.name) {
      c.unresolved(id.span, "derivable interface", text(id.name), derivable_names())
      continue
    }
    out.push(text(id.name))
  }
  out
}

/// The resolved target of alias t, guarding cycles.
fn (var c: Checker) alias_target(t: Int, sp: Span) -> Int {
  if c.objs[t].resolving {
    c.error("XO0407", sp, "type alias `${text(c.objs[t].name)}` refers to itself")
    return c.bad_ty
  }
  c.resolve_type_obj(t)
  if c.objs[t].target < 0 {
    return c.bad_ty
  }
  c.objs[t].target
}

// ---------------------------------------------------------------------------
// Signatures (decl.go resolveSigs)

fn (var c: Checker) resolve_sigs(m: Int) {
  c.cur_mod = m
  for f in c.mods[m].files {
    c.set_file(f)
    let decls = c.files[f].ast.decls
    for (i, d) in decls.indexed() {
      let fd = match d {
        FnDecl(d: x) => x
        _ => continue
      }
      var fo = -1
      if fd.recv == None {
        fo = c.files[f].decl_objs[i]
        if !c.is_scope_entry(f, i, fd.name.name) {
          fo = c.new_obj(ObjKind.Func, fd.name)
          c.objs[fo].is_pub = fd.is_pub || c.mods[m].is_std
          c.objs[fo].fn_decl = [fd]
        }
      } else {
        fo = c.new_obj(ObjKind.Func, fd.name)
        c.objs[fo].is_pub = fd.is_pub || c.mods[m].is_std
        c.objs[fo].fn_decl = [fd]
        c.objs[fo].moves = doc_moves(fd.doc)
      }
      if fo >= 0 {
        // the SSA builder lowers the body in its file (decision 0150)
        c.objs[fo].decl_file = f
        c.objs[fo].decl_idx = i
      }
      var env = TypeEnv{file: f, mod: m}
      if fd.recv != None {
        if !c.attach_method(fo, fd, env) {
          continue
        }
        c.files[f].decl_objs[i] = fo
      }
      c.resolve_sig(fo, env, false)
    }
  }
}

/// Attaches method fo to its receiver type (decl.go attachMethod); the
/// implicit receiver parameters go into env.
fn (var c: Checker) attach_method(fo: Int, fd: parser.FnDecl, var env: TypeEnv) -> Bool {
  let recv = fd.recv ?? fault("a method has a receiver")
  var renv = env
  renv.implicit = true
  renv.implicit_list = []
  let rt = c.resolve_type(recv.typ, renv)
  c.objs[fo].recv_var = recv.is_var
  c.objs[fo].is_static = recv.name.name == b"static" && c.mods[c.cur_mod].is_std
  let r = c.resolve(rt)
  if c.tys[r].kind != TyKind.Named {
    if !c.is_bad(rt) {
      c.error("XO0407", parser.type_span(recv.typ), "a method receiver must be a named type, found `${c.show_raw(rt)}`")
    }
    return false
  }
  let t = c.tys[r].obj
  if c.objs[t].tkind == "interface" {
    c.error("XO0407", parser.type_span(recv.typ), "methods cannot be declared on interface `${text(c.objs[t].name)}`")
    return false
  }
  if c.objs[t].module != c.cur_mod {
    c.error("XO0606", fd.name.span, "method `${text(fd.name.name)}` is declared on `${c.qual_name(t)}` from another module; methods may be declared only in the module that declares the type (core 3.4)")
    return false
  }
  if !c.objs[fo].is_static {
    c.check_name(recv.name, "receiver")
  }
  c.check_name(fd.name, "method")
  c.objs[fo].recv = t
  c.objs[fo].recv_ty = rt
  for p in renv.implicit_list {
    c.objs[fo].tparams.push(p)
    env.params[c.objs[p].name] = p
  }
  let name = fd.name.name
  if c.objs[fo].is_static {
    c.objs[fo].static_const = fd.params.is_empty() && is_upper_snake(name)
    if let Some(prev) = c.objs[t].statics.get(name) {
      let d = c.error("XO0603", fd.name.span, "method `${text(name)}` is already declared on `${text(c.objs[t].name)}`")
      c.note_obj(d, prev, "previous declaration")
      return false
    }
  } else if let Some(prev) = c.objs[t].methods.get(name) {
    let d = c.error("XO0603", fd.name.span, "method `${text(name)}` is already declared on `${text(c.objs[t].name)}`")
    c.note_obj(d, prev, "previous declaration")
    return false
  }
  var is_field = false
  for fl in c.objs[t].fields {
    if fl.name == name {
      is_field = true
    }
  }
  if is_field && !c.mods[c.cur_mod].is_std {
    c.error("XO0603", fd.name.span, "`${text(name)}` is both a field and a method of `${text(c.objs[t].name)}`")
  }
  if c.objs[fo].is_static {
    c.objs[t].statics[name] = fo
  } else {
    c.objs[t].methods[name] = fo
  }
  true
}

/// Fills the parameters, result, and error type of fo from its
/// declaration (decl.go resolveSig).
fn (var c: Checker) resolve_sig(fo: Int, env0: TypeEnv, iface: Bool) {
  let fd = c.objs[fo].fn_decl[0]
  let own = c.new_tparams(fd.type_params)
  for p in own {
    c.objs[fo].tparams.push(p)
  }
  c.objs[fo].own_tparams = own.len()
  var env = c.env_with(env0, c.objs[fo].tparams)
  env.elided = true
  c.resolve_constraints(fd.type_params, own, env)
  var seen: List[Bytes] = []
  var params: List[ParamInfo] = []
  for p in fd.params {
    if p.is_self {
      continue
    }
    if !iface {
      c.check_name(p.name, "parameter")
    }
    if seen.contains(p.name.name) && p.name.name != b"_" {
      c.error("XO0603", p.name.span, "parameter `${text(p.name.name)}` is declared twice")
    }
    seen.push(p.name.name)
    var pt = c.bad_ty
    if let Some(t) = p.typ {
      pt = c.resolve_type(t, env)
    }
    var dflt: List[Expr] = []
    if let Some(e) = p.default {
      dflt.push(e)
    }
    params.push(ParamInfo{name: p.name.name, ty: pt, is_var: p.is_var, default: dflt, line: p.name.span.start.line, col: p.name.span.start.col})
  }
  c.objs[fo].params = params
  var renv = env
  renv.elided = false
  c.objs[fo].result = c.unit_ty
  if let Some(t) = fd.result {
    c.objs[fo].result = c.resolve_type(t, renv)
  }
  c.objs[fo].err = c.resolve_err_spec(fd.err, renv)
  if fd.bad_sig {
    // the parser reported its parameter list; no other error from it:
    // its parameters and result take anything (bad_ty)
    c.objs[fo].result = c.bad_ty
    c.objs[fo].err = -1
    var ps = c.objs[fo].params
    for i in 0..ps.len() {
      ps[i].ty = c.bad_ty
    }
    c.objs[fo].params = ps
  }
  var use_list: List[parser.Effect] = []
  var has_uses = false
  for cl in fd.clauses {
    if let UsesClause(effects: es, ..) = cl {
      has_uses = true
      for e in es {
        if e.sub == None && e.name.name == b"realtime" && !iface {
          // a discipline, not an effect (core 6.5)
          c.objs[fo].realtime = true
          c.objs[fo].realtime_span = e.span
          continue
        }
        use_list.push(e)
      }
    }
  }
  var set = c.resolve_effects(use_list, env)
  if c.objs[fo].realtime {
    c.realtime_fns.push(fo)
    c.objs[fo].decl_file = c.cur_file
    for e in use_list {
      var name = text(e.name.name)
      if let Some(s) = e.sub {
        name = "${name}.${text(s.name)}"
      }
      if is_effect_label(name) && name != "ffi" {
        let d = c.error("XO1405", e.span, "a real-time function may not perform `${name}`; the only effect it may declare is `ffi`")
        c.note_here(d, c.objs[fo].realtime_span, "`${c.display_name(fo)}` is real-time (core 6.5)")
      }
    }
  }
  for p in env.elided_list {
    c.objs[fo].tparams.push(p)
  }
  for p in c.objs[fo].tparams {
    if c.objs[p].elided {
      c.esets[set].push(EffItem{param: p})
    }
  }
  if c.objs[fo].is_pub || iface || c.mods[c.objs[fo].module].is_std || has_uses {
    c.objs[fo].declared = set
  } else {
    c.inferred_fns.push(fo)
  }
  c.objs[fo].sig_done = true
}

fn (var c: Checker) resolve_err_spec(es: parser.ErrSpec?, var env: TypeEnv) -> Int {
  let e = match es {
    Some(x) => x
    None => return -1
  }
  let t = match e.typ {
    Some(x) => c.resolve_type(x, env)
    None => return c.named("Error")
  }
  if c.is_never(t) {
    return -1
  }
  t
}

fn is_effect_label(name: Str) -> Bool {
  name is "net" | "net.dial" | "net.listen" | "fs" | "fs.read" | "fs.write" | "clock" | "rand" | "env" | "proc" | "stdio" | "ffi" | "log" | "go"
}

/// The effect set of effect labels and variables (decl.go
/// resolveEffects).
fn (var c: Checker) resolve_effects(effs: List[parser.Effect], env: TypeEnv) -> Int {
  var items: List[EffItem] = []
  for e in effs {
    var name = text(e.name.name)
    if let Some(s) = e.sub {
      name = "${name}.${text(s.name)}"
    }
    if is_effect_label(name) {
      items.push(EffItem{label: name})
      continue
    }
    if name == "realtime" {
      let d = c.error("XO0702", e.span, "`realtime` marks a function declaration; it cannot appear here")
      c.note(d, "write `uses realtime` on a `fn` declaration; closures, function types, and tests cannot be real-time (core 6.5)")
      continue
    }
    if e.sub == None {
      if let Some(p) = env.params.get(e.name.name) {
        if c.objs[p].effect {
          items.push(EffItem{param: p})
          continue
        }
      }
    }
    var cands = ["net", "net.dial", "net.listen", "fs", "fs.read", "fs.write", "clock", "rand", "env", "proc", "stdio", "ffi", "log", "go"]
    for (n, p) in env.params.entries() {
      if c.objs[p].effect {
        cands.push(text(n))
      }
    }
    let d = c.error("XO0702", e.span, "unknown effect `${name}`")
    if d >= 0 {
      let s = nearest(name, cands.sort())
      if !s.is_empty() {
        c.note(d, "did you mean `${s.join("`, `")}`?")
        c.fix(d, "replace with `${s[0]}`", [c.replace_edit(e.span, s[0])])
      } else {
        c.note(d, "effects are net, net.dial, net.listen, fs, fs.read, fs.write, clock, rand, env, proc, stdio, ffi, log, go, or an effect variable declared as `fx: Effects` (core 6.1, 6.2)")
      }
    }
  }
  c.new_eset(items)
}

// ---------------------------------------------------------------------------
// Type expressions (decl.go resolveType)

/// Resolves a type expression, recording its names.
fn (var c: Checker) resolve_type(t: Type, var env: TypeEnv) -> Int {
  match t {
    NamedType(span, path, args) => c.resolve_named_type(span, path, args, env)
    OptionalType(elem: e, ..) => c.option_of(c.resolve_type(e, env))
    TupleType(elems: es, ..) => {
      if es.is_empty() {
        return c.unit_ty
      }
      var el: List[Int] = []
      for e in es {
        el.push(c.resolve_type(e, env))
      }
      c.mk_tuple(el)
    }
    FnType(t: ft) => {
      var ps: List[Int] = []
      var vs: List[Bool] = []
      for p in ft.params {
        ps.push(c.resolve_type(p.typ, env))
        vs.push(p.is_var)
      }
      var r = c.unit_ty
      if let Some(x) = ft.result {
        r = c.resolve_type(x, env)
      }
      let e = c.resolve_err_spec(ft.err, env)
      var eff = -1
      if !ft.effects.is_empty() {
        eff = c.resolve_effects(ft.effects, env)
      }
      c.mk_func(ps, vs, r, e, eff)
    }
    BadType(..) => c.bad_ty
  }
}

fn (var c: Checker) resolve_named_type(span: Span, path: List[Ident], args: List[Type], var env: TypeEnv) -> Int {
  let last = path[path.len() - 1]
  var obj = -1
  if path.len() == 1 {
    let id = path[0]
    let name = id.name
    if let Some(p) = env.params.get(name) {
      if c.objs[p].effect {
        c.error("XO0407", span, "`${text(name)}` is an effect variable, not a type")
        return c.bad_ty
      }
      if !args.is_empty() {
        c.error("XO0403", span, "type parameter `${text(name)}` takes no type arguments")
      }
      c.record(id, p)
      return c.mk_param(p)
    }
    if name == b"Effects" {
      c.error("XO0407", span, "`Effects` is only valid as the kind of an effect variable: `fx: Effects` (core 6.2)")
      return c.bad_ty
    }
    let o = if env.mod >= 0 { c.lookup_module_obj(env.mod, name) } else { -1 }
    if o < 0 {
      if env.implicit && args.is_empty() && is_upper_camel(name) {
        let p = c.new_tparam(name, c.path, id.span.start.line, id.span.start.col)
        c.objs[p].implicit = true
        if env.arg_param >= 0 {
          c.objs[p].constraint = c.objs[env.arg_param].constraint
        }
        env.implicit_list.push(p)
        env.params[name] = p
        c.record(id, p)
        return c.mk_param(p)
      }
      let (ht, hok) = c.habit_type(span, path, args, env)
      if hok {
        return ht
      }
      if !env.quiet {
        c.unresolved(id.span, "type", text(name), c.visible_type_names(env))
      }
      return c.bad_ty
    }
    if c.objs[o].kind != ObjKind.Type {
      c.error("XO0407", span, "`${text(name)}` is not a type")
      return c.bad_ty
    }
    c.record(id, o)
    obj = o
  } else if path.len() == 2 {
    let mid = path[0]
    var imp: Import? = None
    if env.file >= 0 {
      imp = c.files[env.file].imports.get(mid.name)
      if imp == None && mid.name == b"testing" && (c.files[env.file].is_test || (c.ctx >= 0 && c.ctxs[c.ctx].is_test)) {
        imp = Some(Import{module: c.testing_mod(), path: b"std/testing"})
      }
    }
    let im = match imp {
      Some(x) => x
      None => {
        c.unresolved(mid.span, "module", text(mid.name), c.import_names(env.file))
        return c.bad_ty
      }
    }
    if env.file >= 0 && c.files[env.file].imports.contains(mid.name) && !im.used {
      var u = im
      u.used = true
      c.files[env.file].imports[mid.name] = u
    }
    let m = im.module
    if m < 0 {
      return c.bad_ty
    }
    c.record(mid, c.mods[m].obj)
    let o = c.mods[m].members.get(last.name) ?? -1
    if o < 0 {
      var tcands: List[Str] = []
      for (n, oo) in c.mods[m].members.entries() {
        if c.objs[oo].kind == ObjKind.Type {
          tcands.push(text(n))
        }
      }
      c.unresolved(last.span, "type of module `${text(mid.name)}`", text(last.name), tcands.sort())
      return c.bad_ty
    }
    if c.objs[o].kind != ObjKind.Type {
      c.error("XO0407", span, "`${text(mid.name)}.${text(last.name)}` is not a type")
      return c.bad_ty
    }
    if !c.objs[o].is_pub && m != env.mod {
      c.error("XO0605", last.span, "type `${text(last.name)}` is not `pub` in module `${c.mods[m].path}`")
    }
    c.record(last, o)
    obj = o
  } else {
    var parts: List[Str] = []
    for p in path {
      parts.push(text(p.name))
    }
    c.error("XO0601", span, "type path `${parts.join(".")}` has too many segments")
    return c.bad_ty
  }
  if !c.objs[obj].resolving {
    c.resolve_type_obj(obj)
  }
  var targs = c.resolve_args_for(obj, args, env)
  // Remember where an effect argument was left out, for the XO0701 note
  // on it (decision 0087).
  for a in targs {
    if c.tys[a].kind == TyKind.EffArg && c.tys[a].eff >= 0 {
      for it in c.esets[c.tys[a].eff] {
        if it.param >= 0 && c.objs[it.param].elided && c.objs[it.param].elided_file.is_empty() {
          c.objs[it.param].elided_file = if env.file >= 0 { c.files[env.file].path } else { c.path }
          c.objs[it.param].elided_at = span
          c.objs[it.param].elided_text = type_text(Type.NamedType(span: span, path: path, args: args))
        }
      }
    }
  }
  let ntp = c.objs[obj].tparams.len()
  if c.objs[obj].tkind == "alias" {
    if targs.len() != ntp {
      c.error("XO0403", span, "`${text(c.objs[obj].name)}` takes ${ntp} type argument(s), found ${targs.len()}")
      return c.bad_ty
    }
    let target = c.alias_target(obj, span)
    return c.subst(target, c.args_subst(c.objs[obj].tparams, targs))
  }
  if targs.len() != ntp {
    if env.implicit && targs.is_empty() {
      // a receiver `List` without arguments: fully generic
      for p in c.objs[obj].tparams {
        let ip = c.new_tparam(c.objs[p].name, "", 0, 0)
        c.objs[ip].implicit = true
        c.objs[ip].effect = c.objs[p].effect
        c.objs[ip].elided = c.objs[p].effect
        c.objs[ip].constraint = c.objs[p].constraint
        env.implicit_list.push(ip)
        if c.objs[p].effect {
          targs.push(c.effarg(c.new_eset([EffItem{param: ip}])))
        } else {
          targs.push(c.mk_param(ip))
        }
      }
    } else {
      c.error("XO0403", span, "`${c.qual_name(obj)}` takes ${ntp} type argument(s), found ${targs.len()}")
      return c.bad_ty
    }
  }
  let n = c.mk_named(obj, targs)
  if env.mod >= 0 && !c.mods[env.mod].is_std && c.objs[obj].module == c.prelude && (c.objs[obj].name == b"Map" || c.objs[obj].name == b"Set") {
    c.check_key_type(n, c.path, span)
  }
  n
}

/// A type expression as text (habits.go typeText).
fn type_text(t: Type) -> Str {
  match t {
    NamedType(path: path, args: args, ..) => {
      var parts: List[Str] = []
      for p in path {
        parts.push(text(p.name))
      }
      var s = parts.join(".")
      if !args.is_empty() {
        var ats: List[Str] = []
        for a in args {
          ats.push(type_text(a))
        }
        s = "${s}[${ats.join(", ")}]"
      }
      s
    }
    OptionalType(elem: e, ..) => "${type_text(e)}?"
    TupleType(elems: es, ..) => {
      var parts: List[Str] = []
      for e in es {
        parts.push(type_text(e))
      }
      "(${parts.join(", ")})"
    }
    _ => "..."
  }
}

/// The type arguments written for obj; when every effect argument is
/// left out, each effect parameter gets an elided argument.
fn (var c: Checker) resolve_args_for(obj: Int, wr: List[Type], var env: TypeEnv) -> List[Int] {
  let tps = c.objs[obj].tparams
  var non_eff = 0
  for p in tps {
    if !c.objs[p].effect {
      non_eff += 1
    }
  }
  var out: List[Int] = []
  if wr.len() == tps.len() || wr.len() != non_eff || (wr.is_empty() && env.implicit) {
    for (i, a) in wr.indexed() {
      let tp = if i < tps.len() { tps[i] } else { -1 }
      out.push(c.resolve_type_arg(a, tp, env))
    }
    return out
  }
  var i = 0
  for tp in tps {
    if c.objs[tp].effect {
      out.push(c.elided_effect(obj, tp, env))
      continue
    }
    out.push(c.resolve_type_arg(wr[i], tp, env))
    i += 1
  }
  out
}

/// The argument of effect parameter tp of obj left out: an implicit
/// effect parameter of what is being declared, or an open effect set.
fn (var c: Checker) elided_effect(obj: Int, tp: Int, var env: TypeEnv) -> Int {
  if !env.implicit && !env.elided {
    return c.fresh_effarg()
  }
  let p = c.new_tparam("${text(c.objs[obj].name)}.${text(c.objs[tp].name)}".bytes(), "", 0, 0)
  c.objs[p].implicit = true
  c.objs[p].effect = true
  c.objs[p].elided = true
  if env.implicit {
    env.implicit_list.push(p)
  } else {
    env.elided_list.push(p)
  }
  c.effarg(c.new_eset([EffItem{param: p}]))
}

fn (var c: Checker) resolve_type_arg(a: Type, tp: Int, var env: TypeEnv) -> Int {
  if tp >= 0 && c.objs[tp].effect {
    var items: List[EffItem] = []
    c.effect_arg(a, env, items)
    return c.effarg(c.new_eset(items))
  }
  let saved = env.arg_param
  env.arg_param = tp
  let t = c.resolve_type(a, env)
  env.arg_param = saved
  t
}

/// Checks an effect set written as a type argument.
fn (var c: Checker) effect_arg(a: Type, var env: TypeEnv, var items: List[EffItem]) {
  match a {
    TupleType(elems: es, ..) => {
      for e in es {
        c.effect_arg(e, env, items)
      }
      return
    }
    NamedType(span: span, path: path, args: args) => {
      if args.is_empty() && path.len() <= 2 {
        var name = text(path[0].name)
        if path.len() == 2 {
          name = "${name}.${text(path[1].name)}"
        }
        if is_effect_label(name) {
          items.push(EffItem{label: name})
          return
        }
        if path.len() == 1 {
          if let Some(p) = env.params.get(path[0].name) {
            if c.objs[p].effect {
              items.push(EffItem{param: p})
              return
            }
          }
          if env.implicit && is_snake(path[0].name) {
            let p = c.new_tparam(path[0].name, "", 0, 0)
            c.objs[p].implicit = true
            c.objs[p].effect = true
            env.implicit_list.push(p)
            env.params[path[0].name] = p
            items.push(EffItem{param: p})
            return
          }
        }
        c.error("XO0702", span, "unknown effect `${name}` in an effect argument")
        return
      }
    }
    _ => {}
  }
  c.error("XO0702", parser.type_span(a), "an effect argument must be an effect label, an effect variable, or a parenthesized list of them")
}

/// Whether a doc comment holds the marker word.
fn doc_has(doc: parser.Doc?, word: Str) -> Bool {
  if let Some(d) = doc {
    return (text(d.text)).contains(word)
  }
  false
}

/// Whether a doc comment marks a function `@moves` (decl.go Moves).
fn doc_moves(doc: parser.Doc?) -> Bool {
  if let Some(d) = doc {
    return (text(d.text)).contains("@moves")
  }
  false
}
