// derive expansion (decision 0315, addendum 1): `derive Xml` becomes
// ordinary Xo functions, parsed into the module as a file of their own.
// A struct T gets
//   xml_write__T(v: T, var w, name: Str)    the encoder, into an xmlcodec.Writer
//   xml_from_tree__T(e: xml.Element) -> T   the decoder
//   xml_encode__T(v: T, indent: Str = "")   what xml.encode_value[T] becomes
//   xml_decode__T(text: Str) -> T           what xml.decode[T] becomes
// built from std/xmlcodec's pieces, with Go's encoding/xml field rules
// (the `xml` wire string holds Go's tag text). Each emitted line carries
// the span of the field it came from, so a diagnostic in generated code
// is reported at the user's field (Checker.report).

use github.com/xo-lang/xo/compiler/parser

/// A field's role and name from its xml tag (marshal.go structFieldInfo).
struct XmlTag {
  /// the element or attribute name
  name: Str
  /// the `a>b` parents of the name
  parents: List[Str]
  attr: Bool = false
  chardata: Bool = false
  omitempty: Bool = false
  skip: Bool = false
  /// the wire string had an error (reported)
  bad: Bool = false
}

/// The shape of a field's type: one value, an Option, or a List of a
/// scalar (Str, Int, Float, Bool) or of a struct that derives Xml.
struct XmlShape {
  /// 0 one value, 1 Option, 2 List
  coll: Int
  /// Str, Int, Float, Bool, or "" for a struct
  scalar: Str
  /// the struct's module qualifier with its dot, `other.`, or ""
  qual: Str
  /// the struct's name
  sname: Str
}

/// Source text under construction: one span per line.
struct Emit {
  lines: List[Str] = []
  spans: List[Span] = []
}

fn (var em: Emit) ln(s: Str, sp: Span) {
  em.lines.push(s)
  em.spans.push(sp)
}

fn is_scalar_name(n: Str) -> Bool {
  n is "Str" | "Int" | "Float" | "Bool"
}

/// The shape of t, or None when derive Xml does not map it.
fn xml_shape(t: parser.Type) -> XmlShape? {
  match t {
    OptionalType(_, elem) => match xml_base(elem) {
      Some(s) => Some(XmlShape{coll: 1, scalar: s.scalar, qual: s.qual, sname: s.sname})
      None => None
    }
    NamedType(_, path, args) => {
      if path.len() == 1 && args.len() == 1 && (text(path[0].name) is "Option" | "List") {
        return match xml_base(args[0]) {
          Some(s) => Some(XmlShape{coll: if text(path[0].name) == "Option" { 1 } else { 2 }, scalar: s.scalar, qual: s.qual, sname: s.sname})
          None => None
        }
      }
      xml_base(t)
    }
    TupleType(..) | FnType(..) | BadType(..) => None
  }
}

fn xml_base(t: parser.Type) -> XmlShape? {
  match t {
    NamedType(_, path, args) => {
      if !args.is_empty() || path.is_empty() || path.len() > 2 {
        return None
      }
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && is_scalar_name(n) {
        return Some(XmlShape{coll: 0, scalar: n, qual: "", sname: ""})
      }
      if path.len() == 1 && (n is "Option" | "List" | "Map" | "Set" | "Time" | "Bytes" | "Duration") {
        return None
      }
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      Some(XmlShape{coll: 0, scalar: "", qual: q, sname: n})
    }
    OptionalType(..) | TupleType(..) | FnType(..) | BadType(..) => None
  }
}

/// The source text of the shape's type.
fn shape_type(s: XmlShape) -> Str {
  let base = if s.scalar.is_empty() { "${s.qual}${s.sname}" } else { s.scalar }
  if s.coll == 1 {
    "${base}?"
  } else if s.coll == 2 {
    "List[${base}]"
  } else {
    base
  }
}

/// The text of a value x of the shape's scalar for an attribute or leaf.
fn scalar_text(scalar: Str, x: Str) -> Str {
  if scalar == "Str" {
    x
  } else if scalar == "Float" {
    "xmlcodec.float_text(" + x + ")"
  } else { "\"$" + "{" + x + "}\"" }
}

/// The value read from the text expression s.
fn scalar_read(scalar: Str, s: Str) -> Str {
  match scalar {
    "Int" => "xmlcodec.int_of(${s})?"
    "Float" => "xmlcodec.float_of(${s})?"
    "Bool" => "xmlcodec.bool_of(${s})?"
    _ => s
  }
}

/// The zero value of the shape (Go leaves an absent field zero).
fn shape_zero(s: XmlShape) -> Str {
  if s.coll == 1 {
    return "None"
  }
  if s.coll == 2 {
    return "[]"
  }
  match s.scalar {
    "Str" => "\"\""
    "Int" => "0"
    "Float" => "0.0"
    "Bool" => "false"
    _ => "${s.qual}xml_zero__${s.sname}()"
  }
}

/// The condition that a value x of the shape is not empty (omitempty).
fn nonempty(s: XmlShape, x: Str) -> Str {
  if s.coll == 2 {
    return "!${x}.is_empty()"
  }
  if s.coll == 1 {
    return "${x} != None"
  }
  match s.scalar {
    "Str" => "!${x}.is_empty()"
    "Int" => "${x} != 0"
    "Float" => "${x} != 0.0"
    "Bool" => x
    _ => "true"
  }
}

fn quote_str(s: Str) -> Str {
  s.quote()
}

fn path_list(parents: List[Str]) -> Str {
  var parts: List[Str] = []
  for p in parents {
    parts.push(quote_str(p))
  }
  "[${parts.join(", ")}]"
}

/// The field's xml tag: the `xml` wire string, else the shared `as`
/// string, else the field's name; Go's tag grammar (`ID,attr`, `a>b>c`,
/// `-`). Errors are XO0426 at the field.
fn (var c: Checker) xml_tag(f: parser.Field, shape: XmlShape, file: Int) -> XmlTag {
  var wire: Str? = None
  for fw in f.formats {
    if fw.format == b"xml" {
      wire = Some(text(fw.wire))
    }
  }
  if wire == None {
    if let Some(w) = f.wire {
      wire = Some(text(w))
    }
  }
  let sp = f.wire_span ?? f.name.span
  let raw = wire ?? text(f.name.name)
  var tag = XmlTag{name: "", parents: []}
  if raw == "-" {
    tag.skip = true
    return tag
  }
  let parts = raw.split(",")
  var name = parts[0]
  if name.is_empty() {
    name = text(f.name.name)
  }
  for i in 1..parts.len() {
    let o = parts[i]
    if o == "attr" {
      tag.attr = true
    } else if o == "chardata" {
      tag.chardata = true
    } else if o == "omitempty" {
      tag.omitempty = true
    } else if o is "innerxml" | "comment" | "any" || o.starts_with("any") {
      tag.bad = true
      c.error_at(file, "XO0426", sp, "`${o}` in an xml wire string is not supported by `derive Xml` yet (decision 0315); the supported options are attr, chardata, and omitempty")
    } else {
      tag.bad = true
      c.error_at(file, "XO0426", sp, "unknown option `${o}` in the xml wire string `${raw}`; the options are attr, chardata, and omitempty")
    }
  }
  if name.contains(">") {
    let segs = name.split(">")
    for s in segs {
      if s.is_empty() {
        tag.bad = true
        c.error_at(file, "XO0426", sp, "an empty name in the path `${name}` of the xml wire string")
      }
    }
    tag.parents = segs[0..segs.len() - 1]
    name = segs[segs.len() - 1]
    if tag.attr {
      tag.bad = true
      c.error_at(file, "XO0426", sp, "an attribute cannot have a path: `${raw}` has both `attr` and `>`")
    }
  }
  tag.name = name
  if tag.chardata && (shape.coll != 0 || shape.scalar != "Str") {
    tag.bad = true
    c.error_at(file, "XO0426", sp, "`chardata` needs a Str field; `${text(f.name.name)}` has another type")
  }
  if tag.attr && (shape.coll == 2 || shape.scalar.is_empty()) {
    tag.bad = true
    c.error_at(file, "XO0426", sp, "`attr` needs a Str, Int, Float, or Bool field (or an Option of one); `${text(f.name.name)}` has another type")
  }
  if tag.attr && tag.chardata {
    tag.bad = true
    c.error_at(file, "XO0426", sp, "`attr` and `chardata` together on one field")
  }
  tag
}

/// The encoder of struct sd.
fn (var c: Checker) xml_encoder(sd: parser.StructDecl, shapes: List[XmlShape?], tags: List[XmlTag], em: Emit) -> Emit {
  var e = em
  let sp = sd.name.span
  let n = text(sd.name.name)
  let pub_ = if sd.is_pub { "pub " } else { "" }
  e.ln("${pub_}fn xml_write__${n}(v: ${n}, var w: xmlcodec.Writer, name: Str) {", sp)
  e.ln("  var attrs: List[xml.Attr] = []", sp)
  // the attributes first: they are in the start tag
  for (i, f) in sd.fields.indexed() {
    let shape = match shapes[i] {
      Some(s) => s
      None => continue
    }
    let tag = tags[i]
    if tag.skip || !tag.attr {
      continue
    }
    let fsp = f.name.span
    let v = "v.${text(f.name.name)}"
    if tag.attr {
      let name = quote_str(tag.name)
      let guard = if tag.omitempty { "  if ${nonempty(shape, v)} {" } else { "" }
      if tag.omitempty {
        e.ln(guard, fsp)
      }
      if shape.coll == 1 {
        e.ln("  if let Some(x) = ${v} { attrs.push(xmlcodec.attr(${name}, ${scalar_text(shape.scalar, "x")})) }", fsp)
      } else {
        e.ln("  attrs.push(xmlcodec.attr(${name}, ${scalar_text(shape.scalar, v)}))", fsp)
      }
      if tag.omitempty {
        e.ln("  }", fsp)
      }
    }
  }
  e.ln("  xmlcodec.write_start(w, name, attrs)", sp)
  for (i, f) in sd.fields.indexed() {
    let shape = match shapes[i] {
      Some(s) => s
      None => continue
    }
    let tag = tags[i]
    if tag.skip || tag.attr {
      continue
    }
    let fsp = f.name.span
    let v = "v.${text(f.name.name)}"
    if tag.chardata {
      e.ln("  xmlcodec.write_chardata(w, ${v})", fsp)
      continue
    }
    let par = path_list(tag.parents)
    let name = quote_str(tag.name)
    let open = !tag.parents.is_empty()
    // one element for x, a scalar's text or a struct's tree: the
    // statements, a struct's parents opened first as a leaf opens them
    var one: List[Str] = []
    if shape.scalar.is_empty() {
      one = ["xmlcodec.write_open(w, ${par})", "${shape.qual}xml_write__${shape.sname}(@, w, ${name})"]
    } else {
      one = ["xmlcodec.write_leaf(w, ${par}, ${name}, ${scalar_text(shape.scalar, "@")})"]
    }
    var head = ""
    var x = "x"
    if shape.coll == 1 {
      // Go opens the parents unless the value is nil
      head = "if let Some(x) = ${v} {"
      if open {
        one.insert(0, "xmlcodec.write_open(w, ${par})")
      }
    } else if shape.coll == 2 {
      if open {
        e.ln("  xmlcodec.write_open(w, ${par})", fsp)
      }
      head = "for x in ${v} {"
    } else {
      if open {
        e.ln("  xmlcodec.write_open(w, ${par})", fsp)
      }
      x = v
      if tag.omitempty {
        head = "if ${nonempty(shape, v)} {"
      }
    }
    if head.is_empty() {
      for st in one {
        e.ln("  ${st.replace("@", x)}", fsp)
      }
    } else {
      e.ln("  ${head}", fsp)
      for st in one {
        e.ln("    ${st.replace("@", x)}", fsp)
      }
      e.ln("  }", fsp)
    }
  }
  e.ln("  xmlcodec.write_end(w, name)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn xml_encode__${n}(v: ${n}, indent: Str = \"\") -> Str ! xml.XmlErr {", sp)
  e.ln("  var w = xmlcodec.writer(indent)", sp)
  e.ln("  xml_write__${n}(v, w, ${quote_str(n)})", sp)
  e.ln("  Ok(xmlcodec.written(w))", sp)
  e.ln("}", sp)
  e
}

/// The decoder of struct sd: the zero value, a merge of an element into
/// a value (Go's Unmarshal sets the fields an element mentions and keeps
/// the rest), and the decoders built from them. Attributes are read
/// first, then the elements in document order, as Go reads them.
fn (var c: Checker) xml_decoder(sd: parser.StructDecl, shapes: List[XmlShape?], tags: List[XmlTag], em: Emit) -> Emit {
  var e = em
  let sp = sd.name.span
  let n = text(sd.name.name)
  let pub_ = if sd.is_pub { "pub " } else { "" }
  var zeros: List[Str] = []
  for (i, f) in sd.fields.indexed() {
    let shape = match shapes[i] {
      Some(s) => s
      None => continue
    }
    zeros.push("${text(f.name.name)}: ${shape_zero(shape)}")
  }
  e.ln("${pub_}fn xml_zero__${n}() -> ${n} { ${n}{${zeros.join(", ")}} }", sp)
  e.ln("${pub_}fn xml_merge__${n}(base: ${n}, e: xml.Element) -> ${n} ! xml.XmlErr {", sp)
  var attr_lines: List[(Str, Span)] = []
  var elem_lines: List[(Str, Span)] = []
  var paths: List[Str] = []
  for (i, f) in sd.fields.indexed() {
    let shape = match shapes[i] {
      Some(s) => s
      None => continue
    }
    let tag = tags[i]
    let fsp = f.name.span
    let fname = text(f.name.name)
    let x = "f_${fname}"
    if tag.skip {
      e.ln("  let ${x}: ${shape_type(shape)} = base.${fname}", fsp)
      continue
    }
    if tag.chardata {
      continue
    }
    e.ln("  var ${x}: ${shape_type(shape)} = base.${fname}", fsp)
    if tag.attr {
      let val = scalar_read(shape.scalar, "a.value")
      let set = if shape.coll == 1 { "Some(${val})" } else { val }
      attr_lines.push(("    if a.name.local == ${quote_str(tag.name)} { ${x} = ${set} }", fsp))
      continue
    }
    let k = paths.len()
    paths.push(path_list(tag.parents + [tag.name]))
    var set = ""
    if shape.scalar.is_empty() {
      let q = shape.qual
      if shape.coll == 1 {
        set = "${x} = Some(${q}xml_merge__${shape.sname}(${x} ?? ${q}xml_zero__${shape.sname}(), c)?)"
      } else if shape.coll == 2 {
        set = "${x}.push(${q}xml_from_tree__${shape.sname}(c)?)"
      } else {
        set = "${x} = ${q}xml_merge__${shape.sname}(${x}, c)?"
      }
    } else {
      let val = scalar_read(shape.scalar, "xmlcodec.direct_text(c)")
      if shape.coll == 1 {
        set = "${x} = Some(${val})"
      } else if shape.coll == 2 {
        set = "${x}.push(${val})"
      } else {
        set = "${x} = ${val}"
      }
    }
    elem_lines.push(("    if ev.field == ${k} { ${set} }", fsp))
  }
  if !attr_lines.is_empty() {
    e.ln("  for a in e.attrs {", sp)
    for (l, fsp) in attr_lines {
      e.ln(l, fsp)
    }
    e.ln("  }", sp)
  }
  if !elem_lines.is_empty() {
    e.ln("  for ev in xmlcodec.events(e, [${paths.join(", ")}]) {", sp)
    e.ln("    let c = ev.el", sp)
    for (l, fsp) in elem_lines {
      e.ln(l, fsp)
    }
    e.ln("  }", sp)
  }
  var inits: List[Str] = []
  for (i, f) in sd.fields.indexed() {
    let fname = text(f.name.name)
    if tags[i].chardata {
      inits.push("${fname}: xmlcodec.direct_text(e)")
    } else {
      inits.push("${fname}: f_${fname}")
    }
  }
  e.ln("  ${n}{${inits.join(", ")}}", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn xml_from_tree__${n}(e: xml.Element) -> ${n} ! xml.XmlErr { xml_merge__${n}(xml_zero__${n}(), e) }", sp)
  e.ln("${pub_}fn xml_decode__${n}(text: Str) -> ${n} ! xml.XmlErr { xml_from_tree__${n}(xmlcodec.parse_root(text)?) }", sp)
  e
}

// ---- derive Yaml (decision 0512): the type directed decoder ----

/// The source text of t and a name for it that is a valid identifier, or None
/// when derive Yaml does not map the type (Str, Int, Float, Bool, Option, List,
/// Map[Str, V], and structs that derive Yaml, alone or nested).
fn yaml_type_text(t: parser.Type) -> Str? {
  match t {
    OptionalType(_, elem) => match yaml_type_text(elem) {
      Some(x) => Some("${x}?")
      None => None
    }
    NamedType(_, path, args) => {
      if path.is_empty() || path.len() > 2 {
        return None
      }
      let n = text(path[path.len() - 1].name)
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      if path.len() == 1 && args.is_empty() && is_scalar_name(n) {
        return Some(n)
      }
      if path.len() == 1 && args.len() == 1 && (n is "Option" | "List") {
        return match yaml_type_text(args[0]) {
          Some(x) => Some("${n}[${x}]")
          None => None
        }
      }
      if path.len() == 1 && args.len() == 2 && n == "Map" {
        if !names_type(args[0], "Str") {
          return None
        }
        return match yaml_type_text(args[1]) {
          Some(x) => Some("Map[Str, ${x}]")
          None => None
        }
      }
      if !args.is_empty() || (path.len() == 1 && n == "Set") {
        return None
      }
      Some("${q}${n}")
    }
    TupleType(..) | FnType(..) | BadType(..) => None
  }
}

/// Whether a null node decodes into a value of t (Option, List, Map), as Go's
/// pointer, slice and map kinds; the other kinds leave an element out.
fn yaml_nullable(t: parser.Type) -> Bool {
  match t {
    OptionalType(..) => true
    NamedType(_, path, _) => path.len() == 1 && (text(path[0].name) is "Option" | "List" | "Map")
    _ => false
  }
}

fn yaml_mangle(x: Str) -> Str {
  x.replace("[", "_L").replace("]", "_R").replace(", ", "_C").replace("?", "_o").replace(".", "_d")
}

/// The function that reads node `i` of Doc `d` as type t, `(d, i, var st) ->
/// (Bool, T) ! yaml.YamlErr` (defined once into em; the Bool is whether a value was
/// read: a null or a mismatch leaves a field alone and drops a list item, as
/// yaml.v3 does), with the zero value text of t; None for a type derive Yaml
/// does not map.
fn (var c: Checker) yaml_reader(t: parser.Type, sp: Span, em: Emit, var done: Map[Str, Bool]) -> (Str, Str, Emit)? {
  let tx = yaml_type_text(t) ?? return None
  var e = em
  let h = "yaml_dec__${yaml_mangle(tx)}"
  let sig = "fn ${h}__b(d: yaml.Doc, i: Int, var st: yaml.Dec) -> (Bool, ${tx}) ! yaml.YamlErr"
  let osig = "fn ${h}(d: yaml.Doc, i: Int, var st: yaml.Dec) -> (Bool, ${tx}) ! yaml.YamlErr"
  let wrap = "fn ${h}(d: yaml.Doc, i: Int, var st: yaml.Dec) -> (Bool, ${tx}) ! yaml.YamlErr { let entered = yaml.tick(d, i, st)?; let r = ${h}__b(d, i, st); yaml.leave(st, entered); r }"
  match t {
    OptionalType(_, elem) => {
      let (inner, _, e2) = c.yaml_reader(elem, sp, e, done) ?? return None
      e = e2
      if !done.contains(h) {
        done[h] = true
        e.ln("${osig} {", sp)
        e.ln("  if yaml.is_null(d, i) { return Ok((true, None)) }", sp)
        e.ln("  let (ok, v) = ${inner}(d, i, st)?", sp)
        e.ln("  if !ok { return Ok((false, None)) }", sp)
        e.ln("  Ok((true, Some(v)))", sp)
        e.ln("}", sp)
      }
      return Some((h, "None", e))
    }
    NamedType(_, path, args) => {
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && args.is_empty() && is_scalar_name(n) {
        let (fnn, zero) = match n {
          "Str" => ("yaml.to_str", "\"\"")
          "Int" => ("yaml.to_int", "0")
          "Float" => ("yaml.to_float", "0.0")
          _ => ("yaml.to_bool", "false")
        }
        return Some((fnn, zero, e))
      }
      if path.len() == 2 && args.is_empty() && n == "Node" && text(path[0].name) == "yaml" {
        return Some(("yaml.to_node_field", "yaml.zero_node()", e))
      }
      if path.len() == 2 && args.is_empty() && n == "Civil" && text(path[0].name) == "time" {
        return Some(("yaml.to_civil", "yaml.zero_civil()", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Time" {
        return Some(("yaml.to_time", "Time.UNIX_EPOCH", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Duration" {
        return Some(("yaml.to_duration", "Duration.from_nanos(0)", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Bytes" {
        return Some(("yaml.to_bytes", "b\"\"", e))
      }
      if path.len() == 1 && args.len() == 1 && n == "Option" {
        let (inner, _, e2) = c.yaml_reader(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${osig} {", sp)
          e.ln("  if yaml.is_null(d, i) { return Ok((true, None)) }", sp)
          e.ln("  let (ok, v) = ${inner}(d, i, st)?", sp)
          e.ln("  if !ok { return Ok((false, None)) }", sp)
          e.ln("  Ok((true, Some(v)))", sp)
          e.ln("}", sp)
        }
        return Some((h, "None", e))
      }
      if path.len() == 1 && args.len() == 1 && n == "List" {
        let (inner, _, e2) = c.yaml_reader(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln(wrap, sp)
          e.ln("${sig} {", sp)
          e.ln("  var out: ${tx} = []", sp)
          e.ln("  if yaml.is_null(d, i) { return Ok((true, out)) }", sp)
          e.ln("  let (ok, its) = yaml.items(d, i, ${quote_str(tx)}, st)", sp)
          e.ln("  if !ok { return Ok((false, out)) }", sp)
          e.ln("  for it in its {", sp)
          e.ln("    let (ok2, v) = ${inner}(d, it, st)?", sp)
          e.ln("    if ok2 { out.push(v) }", sp)
          e.ln("  }", sp)
          e.ln("  Ok((true, out))", sp)
          e.ln("}", sp)
        }
        return Some((h, "[]", e))
      }
      if path.len() == 1 && args.len() == 2 && n == "Map" {
        let (inner, _, e2) = c.yaml_reader(args[1], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln(wrap, sp)
          e.ln("${sig} {", sp)
          e.ln("  var out: ${tx} = {}", sp)
          e.ln("  if yaml.is_null(d, i) { return Ok((true, out)) }", sp)
          e.ln("  let (ok, ps) = yaml.pairs(d, i, ${quote_str(tx)}, st)?", sp)
          e.ln("  if !ok { return Ok((false, out)) }", sp)
          e.ln("  for (k, v, _) in ps {", sp)
          e.ln("    if v < 0 {", sp)
          e.ln("      let _ = yaml.bad_key(d, v, st)?", sp)
          e.ln("      continue", sp)
          e.ln("    }", sp)
          e.ln("    let (ok2, x) = ${inner}(d, v, st)?", sp)
          e.ln("    if ok2 || yaml.is_null(d, v) { out[k] = x }", sp)
          e.ln("  }", sp)
          e.ln("  Ok((true, out))", sp)
          e.ln("}", sp)
        }
        return Some((h, "{}", e))
      }
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      return Some(("${q}yaml_from_node__${n}", "${q}yaml_zero__${n}()", e))
    }
    _ => return None
  }
}

/// A field's yaml.v3 struct tag, from its shared `as "name,options"` wire name or its
/// own `yaml "name,options"`: the key, and the options omitempty, flow, inline; a
/// wire name `-` leaves the field out.
struct YamlOpts {
  key: Str
  omit: Bool
  flow: Bool
  inline: Bool
  skip: Bool
}

/// The qualifier ("" or "pkg.") and name of a field type that is a plain struct name.
fn yaml_struct_name(t: parser.Type) -> (Str, Str)? {
  match t {
    NamedType(_, path, args) => {
      if args.is_empty() && (path.len() == 1 || path.len() == 2) {
        let n = text(path[path.len() - 1].name)
        if is_scalar_name(n) || n is "List" | "Map" | "Option" {
          return None
        }
        let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
        return Some((q, n))
      }
      None
    }
    _ => None
  }
}

fn yaml_opts(fl: parser.Field) -> YamlOpts {
  var o = YamlOpts{key: text(fl.name.name), omit: false, flow: false, inline: false, skip: false}
  var wire: Str? = None
  for fw in fl.formats {
    if fw.format == b"yaml" {
      wire = Some(text(fw.wire))
    }
  }
  if wire == None {
    if let Some(w) = fl.wire {
      wire = Some(text(w))
    }
  }
  if let Some(w) = wire {
    if w == "-" {
      o.skip = true
      return o
    }
    let parts = w.split(",")
    if !parts[0].is_empty() {
      o.key = parts[0]
    }
    for opt in parts[1..] {
      if opt == "omitempty" {
        o.omit = true
      } else if opt == "flow" {
        o.flow = true
      } else if opt == "inline" {
        o.inline = true
      }
    }
  }
  o
}

fn (var c: Checker) yaml_decoder(sd: parser.StructDecl, em: Emit, var done: Map[Str, Bool], file: Int) -> Emit? {
  var e = em
  let sp = sd.name.span
  let n = text(sd.name.name)
  let pub_ = if sd.is_pub { "pub " } else { "" }
  var readers: List[Str] = []
  var zeros: List[Str] = []
  var keys: List[Str] = []
  var types: List[Str] = []
  var vreaders: List[Str] = []
  var ok = true
  for fl in sd.fields {
    let (rd, zero, e2) = c.yaml_reader(fl.typ, fl.name.span, e, done) ?? {
      c.error_at(file, "XO0425", fl.name.span, "`derive Yaml` maps a Str, Int, Float, Bool, a Duration, Bytes, a yaml.Node, an Option, a List, a Map[Str, V] of those, or a struct that derives Yaml; field `${text(fl.name.name)}` is another type (decision 0512)")
      ok = false
      continue
    }
    e = e2
    readers.push(rd)
    zeros.push("${text(fl.name.name)}: ${zero}")
    let yo = yaml_opts(fl)
    var key = if yo.skip { "-" } else if yo.inline { "<<inline>>" } else { yo.key }
    var vrd = ""
    if yo.inline {
      if let Some(vt) = yaml_map_value(fl.typ) {
        // an inline map takes the keys no field does (yaml.v3's InlineMap)
        let (r2, _, e3) = c.yaml_reader(vt, fl.name.span, e, done) ?? return None
        e = e3
        vrd = r2
        key = "<<inlinemap>>"
      }
    }
    vreaders.push(vrd)
    keys.push(key)
    types.push(yaml_type_text(fl.typ) ?? "Str")
  }
  if !ok {
    return None
  }
  e.ln("${pub_}fn yaml_zero__${n}() -> ${n} { ${n}{${zeros.join(", ")}} }", sp)
  e.ln("${pub_}fn yaml_merge__${n}(base: ${n}, d: yaml.Doc, i: Int, var st: yaml.Dec) -> (Bool, ${n}) ! yaml.YamlErr {", sp)
  e.ln("  if yaml.is_null(d, i) { return Ok((false, base)) }", sp)
  e.ln("  let (ok, ps) = yaml.pairs(d, i, ${quote_str(n)}, st)?", sp)
  e.ln("  if !ok { return Ok((false, base)) }", sp)
  for (j, fl) in sd.fields.indexed() {
    e.ln("  var f_${text(fl.name.name)}: ${types[j]} = base.${text(fl.name.name)}", fl.name.span)
  }
  e.ln("  for (k, v, kl) in ps {", sp)
  e.ln("    if v < 0 {", sp)
  e.ln("      let _ = yaml.bad_key(d, v, st)?", sp)
  e.ln("      continue", sp)
  e.ln("    }", sp)
  var inl: List[Int] = []
  var first = true
  for (j, fl) in sd.fields.indexed() {
    if keys[j] == "-" {
      continue
    }
    if keys[j] == "<<inline>>" {
      inl.push(j)
      continue
    }
    if keys[j] == "<<inlinemap>>" {
      continue
    }
    e.ln("    ${if first { "" } else { "} else " }}if k == ${quote_str(keys[j])} {", fl.name.span)
    first = false
    e.ln("      let (ok2, x) = ${readers[j]}(d, v, st)?", fl.name.span)
    e.ln("      if ok2 { f_${text(fl.name.name)} = x }", fl.name.span)
  }
  // a key no field of its own names goes to each inline struct (yaml.v3 flattens
  // them), and is an error when the decode is strict and no field at all takes it
  e.ln("    ${if first { "{" } else { "} else {" }}", sp)
  for j in inl {
    let fl = sd.fields[j]
    let inner = yaml_struct_name(fl.typ) ?? {
      c.error_at(file, "XO0425", fl.name.span, "`inline` needs a field that is a struct deriving Yaml; `${text(fl.name.name)}` is not one (decision 0512)")
      return None
    }
    e.ln("      f_${text(fl.name.name)} = ${inner.0}yaml_set__${inner.1}(f_${text(fl.name.name)}, k, v, d, st)?", fl.name.span)
  }
  var struct_known: List[Str] = []
  for j in inl {
    let inner = yaml_struct_name(sd.fields[j].typ) ?? return None
    struct_known.push("${inner.0}yaml_known__${inner.1}(k)")
  }
  for (j, fl) in sd.fields.indexed() {
    if keys[j] == "<<inlinemap>>" {
      e.ln("      if !(${if struct_known.is_empty() { "false" } else { struct_known.join(" || ") }}) {", fl.name.span)
      e.ln("        let (ok2, x) = ${vreaders[j]}(d, v, st)?", fl.name.span)
      e.ln("        if ok2 || yaml.is_null(d, v) { f_${text(fl.name.name)}[k] = x }", fl.name.span)
      e.ln("      }", fl.name.span)
    }
  }
  e.ln("      if st.strict && !yaml_known__${n}(k) { yaml.unknown_field(st, k, kl, ${quote_str(n)}) }", sp)
  e.ln("    }", sp)
  e.ln("  }", sp)
  var inits: List[Str] = []
  for fl in sd.fields {
    inits.push("${text(fl.name.name)}: f_${text(fl.name.name)}")
  }
  e.ln("  Ok((true, ${n}{${inits.join(", ")}}))", sp)
  e.ln("}", sp)
  var known: List[Str] = []
  for (j, fl) in sd.fields.indexed() {
    if keys[j] == "-" {
      continue
    }
    if keys[j] == "<<inlinemap>>" {
      known.push("true")
    } else if keys[j] == "<<inline>>" {
      let inner = yaml_struct_name(fl.typ) ?? return None
      known.push("${inner.0}yaml_known__${inner.1}(k)")
    } else {
      known.push("k == ${quote_str(keys[j])}")
    }
  }
  e.ln("${pub_}fn yaml_known__${n}(k: Str) -> Bool { ${if known.is_empty() { "false" } else { known.join(" || ") }} }", sp)
  e.ln("${pub_}fn yaml_set__${n}(base: ${n}, k: Str, v: Int, d: yaml.Doc, var st: yaml.Dec) -> ${n} ! yaml.YamlErr {", sp)
  e.ln("  var b = base", sp)
  var firstk = true
  for (j, fl) in sd.fields.indexed() {
    if keys[j] == "-" || keys[j] == "<<inline>>" || keys[j] == "<<inlinemap>>" {
      continue
    }
    e.ln("  ${if firstk { "" } else { "} else " }}if k == ${quote_str(keys[j])} {", fl.name.span)
    firstk = false
    e.ln("    let (ok2, x) = ${readers[j]}(d, v, st)?", fl.name.span)
    e.ln("    if ok2 { b.${text(fl.name.name)} = x }", fl.name.span)
  }
  for j in inl {
    let fl = sd.fields[j]
    let inner = yaml_struct_name(fl.typ) ?? return None
    e.ln("  ${if firstk { "{" } else { "} else {" }}", sp)
    firstk = false
    e.ln("    b.${text(fl.name.name)} = ${inner.0}yaml_set__${inner.1}(b.${text(fl.name.name)}, k, v, d, st)?", fl.name.span)
  }
  if !firstk {
    e.ln("  }", sp)
  }
  e.ln("  b", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn yaml_from_node__${n}(d: yaml.Doc, i: Int, var st: yaml.Dec) -> (Bool, ${n}) ! yaml.YamlErr { let entered = yaml.tick(d, i, st)?; let r = yaml_merge__${n}(yaml_zero__${n}(), d, i, st); yaml.leave(st, entered); r }", sp)
  e.ln("${pub_}fn yaml_decode_all__${n}(text: Str, strict: Bool = false) -> List[${n}] ! yaml.YamlErr {", sp)
  e.ln("  let docs = yaml.parse_docs(text)?", sp)
  e.ln("  var out: List[${n}] = []", sp)
  e.ln("  for d in docs {", sp)
  e.ln("    let r = yaml.root(d)", sp)
  e.ln("    if r < 0 {", sp)
  e.ln("      out.push(yaml_zero__${n}())", sp)
  e.ln("      continue", sp)
  e.ln("    }", sp)
  e.ln("    var st = yaml.dec_new(strict)", sp)
  e.ln("    let (_, v) = yaml_from_node__${n}(d, r, st)?", sp)
  e.ln("    if st.errs.len() > 0 { return Err(yaml.errors(st)) }", sp)
  e.ln("    out.push(v)", sp)
  e.ln("  }", sp)
  e.ln("  Ok(out)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn yaml_decode__${n}(text: Str, strict: Bool = false) -> ${n} ! yaml.YamlErr {", sp)
  e.ln("  let d = yaml.parse_doc(text)?", sp)
  e.ln("  let r = yaml.root(d)", sp)
  e.ln("  if r < 0 { return Ok(yaml_zero__${n}()) }", sp)
  e.ln("  var st = yaml.dec_new(strict)", sp)
  e.ln("  let (_, v) = yaml_from_node__${n}(d, r, st)?", sp)
  e.ln("  if st.errs.len() > 0 { return Err(yaml.errors(st)) }", sp)
  e.ln("  Ok(v)", sp)
  e.ln("}", sp)
  Some(e)
}

/// The function that writes a value of type t into an Enc, `(var w: yaml.Enc,
/// v: T)` (defined once into em); None for a type derive Yaml does not map.
fn (var c: Checker) yaml_writer(t: parser.Type, sp: Span, em: Emit, var done: Map[Str, Bool]) -> (Str, Emit)? {
  let tx = yaml_type_text(t) ?? return None
  var e = em
  let h = "yaml_enc__${yaml_mangle(tx)}"
  let sig = "fn ${h}(var w: yaml.Enc, v: ${tx})"
  match t {
    OptionalType(_, elem) => {
      let (inner, e2) = c.yaml_writer(elem, sp, e, done) ?? return None
      e = e2
      if !done.contains(h) {
        done[h] = true
        e.ln("${sig} {", sp)
        e.ln("  if let Some(x) = v {", sp)
        e.ln("    ${inner}(w, x)", sp)
        e.ln("  } else {", sp)
        e.ln("    yaml.put_null(w)", sp)
        e.ln("  }", sp)
        e.ln("}", sp)
      }
      return Some((h, e))
    }
    NamedType(_, path, args) => {
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && args.is_empty() && is_scalar_name(n) {
        if !done.contains(h) {
          done[h] = true
          let body = match n {
            "Str" => "yaml.put_str(w, v)"
            "Int" => "yaml.put_int(w, v)"
            "Float" => "yaml.put_float(w, v)"
            _ => "yaml.put_bool(w, v)"
          }
          e.ln("${sig} { ${body} }", sp)
        }
        return Some((h, e))
      }
      if path.len() == 2 && args.is_empty() && n == "Node" && text(path[0].name) == "yaml" {
        return Some(("yaml.put_node", e))
      }
      if path.len() == 2 && args.is_empty() && n == "Civil" && text(path[0].name) == "time" {
        return Some(("yaml.put_civil", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Time" {
        return Some(("yaml.put_time", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Duration" {
        return Some(("yaml.put_duration", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Bytes" {
        return Some(("yaml.put_bytes", e))
      }
      if path.len() == 1 && args.len() == 1 && n == "Option" {
        let (inner, e2) = c.yaml_writer(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  if let Some(x) = v {", sp)
          e.ln("    ${inner}(w, x)", sp)
          e.ln("  } else {", sp)
          e.ln("    yaml.put_null(w)", sp)
          e.ln("  }", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      if path.len() == 1 && args.len() == 1 && n == "List" {
        let (inner, e2) = c.yaml_writer(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  yaml.seq_start(w)", sp)
          e.ln("  for x in v { ${inner}(w, x) }", sp)
          e.ln("  yaml.seq_end(w)", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      if path.len() == 1 && args.len() == 2 && n == "Map" {
        let (inner, e2) = c.yaml_writer(args[1], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  yaml.map_start(w)", sp)
          e.ln("  for k in yaml.sorted_keys(v.keys()) {", sp)
          e.ln("    yaml.put_str(w, k)", sp)
          e.ln("    ${inner}(w, v.get(k) ?? fault(\"yaml: map key\"))", sp)
          e.ln("  }", sp)
          e.ln("  yaml.map_end(w)", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      return Some(("${q}yaml_write__${n}", e))
    }
    _ => return None
  }
}

/// The value type of a `Map[Str, V]`, for an inline map field.
fn yaml_map_value(t: parser.Type) -> parser.Type? {
  match t {
    NamedType(_, path, args) => {
      if path.len() == 1 && args.len() == 2 && text(path[0].name) == "Map" && names_type(args[0], "Str") {
        return Some(args[1])
      }
      None
    }
    _ => None
  }
}

/// The encoder of a struct: `yaml_write__N(var w, v)` writes it as a mapping, and
/// `yaml_encode__N(v) -> Str ! yaml.YamlErr` is what yaml.encode_value[N] becomes.
fn (var c: Checker) yaml_encoder(sd: parser.StructDecl, em: Emit, var done: Map[Str, Bool], file: Int) -> Emit? {
  var e = em
  let sp = sd.name.span
  let n = text(sd.name.name)
  let pub_ = if sd.is_pub { "pub " } else { "" }
  var body: List[Str] = []
  var tail: List[Str] = []
  var ok = true
  for fl in sd.fields {
    let yo = yaml_opts(fl)
    let f = text(fl.name.name)
    if yo.skip {
      continue
    }
    if yo.inline && yaml_map_value(fl.typ) != None {
      // an inline map's entries follow the fields, by sorted key
      let vt = yaml_map_value(fl.typ) ?? return None
      let (iw, e2) = c.yaml_writer(vt, fl.name.span, e, done) ?? return None
      e = e2
      tail.push("  for k in yaml.sorted_keys(v.${f}.keys()) {")
      tail.push("    yaml.put_str(w, k)")
      tail.push("    yaml.set_flow(w, false)")
      tail.push("    ${iw}(w, v.${f}.get(k) ?? fault(\"yaml: map key\"))")
      tail.push("  }")
      continue
    }
    if yo.inline {
      // the fields of an inline struct are written into this mapping
      let inner = yaml_struct_name(fl.typ) ?? {
        c.error_at(file, "XO0425", fl.name.span, "`inline` needs a field that is a struct deriving Yaml; `${f}` is not one (decision 0512)")
        return None
      }
      body.push("  ${inner.0}yaml_fields__${inner.1}(w, v.${f})")
      continue
    }
    let (wr, e2) = c.yaml_writer(fl.typ, fl.name.span, e, done) ?? return None
    e = e2
    let key = yo.key
    let omit = yo.omit
    let flow = yo.flow
    let tx = yaml_type_text(fl.typ) ?? "Str"
    var zero = ""
    if omit {
      zero = match tx {
        "Str" => "v.${f} == \"\""
        "Int" => "v.${f} == 0"
        "Float" => "v.${f} == 0.0"
        "Bool" => "!v.${f}"
        "Duration" => "v.${f}.nanos() == 0"
        "Time" => "v.${f} == Time.UNIX_EPOCH"
        "Bytes" => "v.${f}.len() == 0"
        _ => if tx.starts_with("List[") || tx.starts_with("Map[") {
          "v.${f}.len() == 0"
        } else if tx.ends_with("?") || tx.starts_with("Option[") {
          "v.${f} == None"
        } else {
          ""
        }
      }
      if zero.is_empty() {
        c.error_at(file, "XO0425", fl.name.span, "`omitempty` on field `${f}` needs a Str, Int, Float, Bool, Duration, Bytes, Option, List or Map field (decision 0512)")
        ok = false
      }
    }
    var st: List[Str] = []
    st.push("  yaml.put_str(w, ${quote_str(key)})")
    st.push("  yaml.set_flow(w, ${flow})")
    st.push("  ${wr}(w, v.${f})")
    if omit {
      body.push("  if !(${zero}) {")
      for l in st {
        body.push("  ${l}")
      }
      body.push("  }")
    } else {
      for l in st {
        body.push(l)
      }
    }
  }
  if !ok {
    return None
  }
  e.ln("${pub_}fn yaml_fields__${n}(var w: yaml.Enc, v: ${n}) {", sp)
  for l in body {
    e.ln(l, sp)
  }
  for l in tail {
    e.ln(l, sp)
  }
  e.ln("}", sp)
  e.ln("${pub_}fn yaml_write__${n}(var w: yaml.Enc, v: ${n}) {", sp)
  e.ln("  yaml.map_start(w)", sp)
  e.ln("  yaml_fields__${n}(w, v)", sp)
  e.ln("  yaml.map_end(w)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn yaml_encode_all__${n}(docs: List[${n}], indent: Int = 4) -> Str ! yaml.YamlErr {", sp)
  e.ln("  var ws: List[yaml.Enc] = []", sp)
  e.ln("  for v in docs {", sp)
  e.ln("    var w = yaml.enc_new()", sp)
  e.ln("    yaml_write__${n}(w, v)", sp)
  e.ln("    ws.push(w)", sp)
  e.ln("  }", sp)
  e.ln("  yaml.finish_all(ws, indent)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn yaml_encode__${n}(v: ${n}, indent: Int = 4) -> Str ! yaml.YamlErr {", sp)
  e.ln("  var w = yaml.enc_new()", sp)
  e.ln("  yaml_write__${n}(w, v)", sp)
  e.ln("  yaml.finish(w, indent)", sp)
  e.ln("}", sp)
  Some(e)
}

// ---- derive Cbor (decision 0527): readers and writers over cbor.Value ----

/// The function that reads a cbor.Value as type t, `(x, var st: cbor.Unm) ->
/// (Bool, T)` (defined once into em; the Bool is whether a value was read: a
/// mismatch leaves a field alone and drops a list item, the type error is kept
/// in st), with the zero value text of t; None for a type derive Cbor does not map.
fn (var c: Checker) cbor_reader(t: parser.Type, sp: Span, em: Emit, var done: Map[Str, Bool]) -> (Str, Str, Emit)? {
  let tx = yaml_type_text(t) ?? return None
  var e = em
  let h = "cbor_rd__${yaml_mangle(tx)}"
  let sig = "fn ${h}(x: cbor.Value, var st: cbor.Unm) -> (Bool, ${tx})"
  match t {
    OptionalType(_, elem) => {
      let (inner, _, e2) = c.cbor_reader(elem, sp, e, done) ?? return None
      e = e2
      if !done.contains(h) {
        done[h] = true
        e.ln("${sig} {", sp)
        e.ln("  if cbor.is_null(x) { return (true, None) }", sp)
        e.ln("  let (ok, v) = ${inner}(x, st)", sp)
        e.ln("  if !ok { return (false, None) }", sp)
        e.ln("  (true, Some(v))", sp)
        e.ln("}", sp)
      }
      return Some((h, "None", e))
    }
    NamedType(_, path, args) => {
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && args.is_empty() && is_scalar_name(n) {
        let (fnn, zero) = match n {
          "Str" => ("cbor.to_str", "\"\"")
          "Int" => ("cbor.to_int", "0")
          "Float" => ("cbor.to_float", "0.0")
          _ => ("cbor.to_bool", "false")
        }
        return Some((fnn, zero, e))
      }
      if path.len() == 1 && args.is_empty() && n == "Bytes" {
        return Some(("cbor.to_bytes", "b\"\"", e))
      }
      if path.len() == 2 && args.is_empty() && n == "Value" && text(path[0].name) == "cbor" {
        return Some(("cbor.to_value", "cbor.Value.Null", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Time" {
        return Some(("cbor.to_time", "Time.UNIX_EPOCH", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Duration" {
        return Some(("cbor.to_duration", "Duration.from_nanos(0)", e))
      }
      if path.len() == 1 && args.len() == 1 && n == "Option" {
        let (inner, _, e2) = c.cbor_reader(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  if cbor.is_null(x) { return (true, None) }", sp)
          e.ln("  let (ok, v) = ${inner}(x, st)", sp)
          e.ln("  if !ok { return (false, None) }", sp)
          e.ln("  (true, Some(v))", sp)
          e.ln("}", sp)
        }
        return Some((h, "None", e))
      }
      if path.len() == 1 && args.len() == 1 && n == "List" {
        let (inner, izero, e2) = c.cbor_reader(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  var out: ${tx} = []", sp)
          e.ln("  if cbor.is_null(x) { return (true, out) }", sp)
          e.ln("  let (ok, its) = cbor.items(x, ${quote_str(tx)}, st)", sp)
          e.ln("  if !ok { return (false, out) }", sp)
          e.ln("  for it in its {", sp)
          e.ln("    let (ok2, v) = ${inner}(it, st)", sp)
          e.ln("    out.push(if ok2 { v } else { ${izero} })", sp)
          e.ln("  }", sp)
          e.ln("  (true, out)", sp)
          e.ln("}", sp)
        }
        return Some((h, "[]", e))
      }
      if path.len() == 1 && args.len() == 2 && n == "Map" {
        let (inner, izero, e2) = c.cbor_reader(args[1], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  var out: ${tx} = {}", sp)
          e.ln("  if cbor.is_null(x) { return (true, out) }", sp)
          e.ln("  let (ok, ps) = cbor.pairs(x, ${quote_str(tx)}, st)", sp)
          e.ln("  if !ok { return (false, out) }", sp)
          e.ln("  for (k, v) in ps {", sp)
          e.ln("    let (okk, key) = cbor.to_str(k, st)", sp)
          e.ln("    if !okk { continue }", sp)
          e.ln("    let (ok2, val) = ${inner}(v, st)", sp)
          e.ln("    out[key] = if ok2 { val } else { ${izero} }", sp)
          e.ln("  }", sp)
          e.ln("  (true, out)", sp)
          e.ln("}", sp)
        }
        return Some((h, "{}", e))
      }
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      return Some(("${q}cbor_rd__${n}", "${q}cbor_zero__${n}()", e))
    }
    _ => return None
  }
}

/// The function that turns a value of type t into a cbor.Value, `(v: T) ->
/// cbor.Value` (defined once into em); None for a type derive Cbor does not map.
fn (var c: Checker) cbor_writer(t: parser.Type, sp: Span, em: Emit, var done: Map[Str, Bool]) -> (Str, Emit)? {
  let tx = yaml_type_text(t) ?? return None
  var e = em
  let h = "cbor_wr__${yaml_mangle(tx)}"
  let sig = "fn ${h}(v: ${tx}) -> cbor.Value"
  match t {
    OptionalType(_, elem) => {
      let (inner, e2) = c.cbor_writer(elem, sp, e, done) ?? return None
      e = e2
      if !done.contains(h) {
        done[h] = true
        e.ln("${sig} {", sp)
        e.ln("  if let Some(x) = v { ${inner}(x) } else { cbor.Value.Null }", sp)
        e.ln("}", sp)
      }
      return Some((h, e))
    }
    NamedType(_, path, args) => {
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && args.is_empty() && (is_scalar_name(n) || n == "Bytes") {
        if !done.contains(h) {
          done[h] = true
          let body = match n {
            "Str" => "cbor.Value.TextString(s: v)"
            "Int" => "cbor.from_int(v)"
            "Float" => "cbor.Value.Float(f: v)"
            "Bytes" => "cbor.Value.ByteString(b: v)"
            _ => "cbor.Value.Bool(b: v)"
          }
          e.ln("${sig} { ${body} }", sp)
        }
        return Some((h, e))
      }
      if path.len() == 2 && args.is_empty() && n == "Value" && text(path[0].name) == "cbor" {
        return Some(("cbor.from_value", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Time" {
        return Some(("cbor.from_time", e))
      }
      if path.len() == 1 && args.is_empty() && n == "Duration" {
        return Some(("cbor.from_duration", e))
      }
      if path.len() == 1 && args.len() == 1 && n == "Option" {
        let (inner, e2) = c.cbor_writer(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  if let Some(x) = v { ${inner}(x) } else { cbor.Value.Null }", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      if path.len() == 1 && args.len() == 1 && n == "List" {
        let (inner, e2) = c.cbor_writer(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  var out: List[cbor.Value] = []", sp)
          e.ln("  for x in v { out.push(${inner}(x)) }", sp)
          e.ln("  cbor.Value.Array(items: out)", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      if path.len() == 1 && args.len() == 2 && n == "Map" {
        let (inner, e2) = c.cbor_writer(args[1], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  var out: List[(cbor.Value, cbor.Value)] = []", sp)
          e.ln("  for k in cbor.sorted_keys(v.keys()) {", sp)
          e.ln("    out.push((cbor.Value.TextString(s: k), ${inner}(v.get(k) ?? fault(\"cbor: map key\"))))", sp)
          e.ln("  }", sp)
          e.ln("  cbor.Value.Map(pairs: out)", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      return Some(("${q}cbor_wr__${n}", e))
    }
    _ => return None
  }
}

/// The function that writes a value of type t's encoding into a BytesBuilder,
/// `(v: T, det: Bool, var out: BytesBuilder) -> () ! cbor.CborErr` (defined
/// once into em; decision 0559); None for a type derive Cbor does not map.
fn (var c: Checker) cbor_putter(t: parser.Type, sp: Span, em: Emit, var done: Map[Str, Bool]) -> (Str, Emit)? {
  let tx = yaml_type_text(t) ?? return None
  var e = em
  let h = "cbor_pt__${yaml_mangle(tx)}"
  let sig = "fn ${h}(v: ${tx}, det: Bool, var out: BytesBuilder) -> () ! cbor.CborErr"
  var elem: parser.Type? = None
  match t {
    OptionalType(_, el) => elem = Some(el)
    NamedType(_, path, args) => {
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && args.len() == 1 && n == "Option" {
        elem = Some(args[0])
      }
    }
    _ => return None
  }
  if let Some(el) = elem {
    let (inner, e2) = c.cbor_putter(el, sp, e, done) ?? return None
    e = e2
    if !done.contains(h) {
      done[h] = true
      e.ln("${sig} {", sp)
      e.ln("  if let Some(x) = v { ${inner}(x, det, out)? } else { out.write_byte(UInt8(246)) }", sp)
      e.ln("  Ok(())", sp)
      e.ln("}", sp)
    }
    return Some((h, e))
  }
  match t {
    NamedType(_, path, args) => {
      let n = text(path[path.len() - 1].name)
      if path.len() == 1 && args.is_empty() && (is_scalar_name(n) || n == "Bytes" || n == "Time" || n == "Duration") {
        if !done.contains(h) {
          done[h] = true
          let body = match n {
            "Str" => "cbor.put_text(out, v)"
            "Int" => "cbor.put_int(out, v)"
            "Float" => "cbor.put_float(out, v)"
            "Bytes" => "cbor.put_bytes(out, v)"
            "Time" => "cbor.put_value(out, cbor.from_time(v), det)?"
            "Duration" => "cbor.put_value(out, cbor.from_duration(v), det)?"
            _ => "out.write_byte(UInt8(if v { 245 } else { 244 }))"
          }
          e.ln("${sig} {", sp)
          e.ln("  ${body}", sp)
          e.ln("  Ok(())", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      if path.len() == 2 && args.is_empty() && n == "Value" && text(path[0].name) == "cbor" {
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} { cbor.put_value(out, v, det) }", sp)
        }
        return Some((h, e))
      }
      if path.len() == 1 && args.len() == 1 && n == "List" {
        let (inner, e2) = c.cbor_putter(args[0], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          e.ln("${sig} {", sp)
          e.ln("  cbor.put_head(out, 4, v.len())", sp)
          e.ln("  for x in v { ${inner}(x, det, out)? }", sp)
          e.ln("  Ok(())", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      if path.len() == 1 && args.len() == 2 && n == "Map" {
        let (inner, e2) = c.cbor_putter(args[1], sp, e, done) ?? return None
        e = e2
        if !done.contains(h) {
          done[h] = true
          // cbor_wr__'s order (sorted_keys), and the encoder's when det
          e.ln("${sig} {", sp)
          e.ln("  cbor.put_head(out, 5, v.len())", sp)
          e.ln("  let ks = if det { cbor.det_keys(v.keys()) } else { cbor.sorted_keys(v.keys()) }", sp)
          e.ln("  for k in ks {", sp)
          e.ln("    cbor.put_text(out, k)", sp)
          e.ln("    ${inner}(v.get(k) ?? fault(\"cbor: map key\"), det, out)?", sp)
          e.ln("  }", sp)
          e.ln("  Ok(())", sp)
          e.ln("}", sp)
        }
        return Some((h, e))
      }
      let q = if path.len() == 2 { "${text(path[0].name)}." } else { "" }
      return Some(("${q}cbor_put__${n}", e))
    }
    _ => return None
  }
}

/// A CBOR head's bytes (major type, argument n >= 0), for keys written at derive time.
fn cbor_head_bytes(major: Int, n: Int) -> List[Int] {
  let m = major << 5
  if n < 24 {
    return [m | n]
  }
  var w = 8
  var ai = 27
  if n < 256 {
    w = 1
    ai = 24
  } else if n < 65536 {
    w = 2
    ai = 25
  } else if n < 4294967296 {
    w = 4
    ai = 26
  }
  var out = [m | ai]
  var i = w - 1
  while i >= 0 {
    out.push((n >> (8 * i)) & 255)
    i -= 1
  }
  out
}

/// A key's encoding: the text key's head and bytes, or the integer's.
fn cbor_key_bytes(key: Str, asint: Bool, ki: Int) -> List[Int] {
  if asint {
    if ki >= 0 {
      return cbor_head_bytes(0, ki)
    }
    return cbor_head_bytes(1, -1 - ki)
  }
  var out = cbor_head_bytes(3, key.len())
  for b in key.bytes() {
    out.push(Int(b))
  }
  out
}

/// Bytes literal source for bs (every byte as \xNN).
fn cbor_bytes_lit(bs: List[Int]) -> Str {
  let hex = "0123456789abcdef"
  var out = "b\""
  for b in bs {
    out = "${out}\\x${hex[(b >> 4)..(b >> 4) + 1]}${hex[(b & 15)..(b & 15) + 1]}"
  }
  "${out}\""
}

/// RFC 8949 4.2.1's order of two encoded keys: bytewise, a prefix first.
fn cbor_key_less(a: List[Int], b: List[Int]) -> Bool {
  var i = 0
  while i < a.len() && i < b.len() {
    if a[i] != b[i] {
      return a[i] < b[i]
    }
    i += 1
  }
  a.len() < b.len()
}

/// A field's CBOR struct tag, from its shared `as "name,options"` wire name or
/// its own `cbor "name,options"`: the key, and the options omitempty, omitzero,
/// keyasint; a wire name `-` leaves the field out.
struct CborOpts {
  key: Str
  omit: Bool
  keyasint: Bool
  toarray: Bool
  skip: Bool
  /// the first option that is none of the above
  bad: Str
}

fn cbor_opts(fl: parser.Field, rule: Str) -> CborOpts {
  var o = CborOpts{key: text(wire_case(fl.name.name, rule)), omit: false, keyasint: false, toarray: false, skip: false, bad: ""}
  var wire: Str? = None
  for fw in fl.formats {
    if fw.format == b"cbor" {
      wire = Some(text(fw.wire))
    }
  }
  if wire == None {
    if let Some(w) = fl.wire {
      wire = Some(text(w))
    }
  }
  if let Some(w) = wire {
    if w == "-" {
      o.skip = true
      return o
    }
    let parts = w.split(",")
    if !parts[0].is_empty() {
      o.key = parts[0]
    }
    for opt in parts[1..] {
      if opt == "omitempty" || opt == "omitzero" {
        o.omit = true
      } else if opt == "keyasint" {
        o.keyasint = true
      } else if opt == "toarray" {
        o.toarray = true
      } else if o.bad.is_empty() {
        o.bad = opt
      }
    }
  }
  o
}

/// The test that a field value is empty, for omitempty ("" when the type has none).
fn cbor_empty_test(tx: Str, f: Str) -> Str {
  match tx {
    "Str" => "v.${f} == \"\""
    "Int" => "v.${f} == 0"
    "Float" => "v.${f} == 0.0"
    "Bool" => "!v.${f}"
    "Bytes" => "v.${f}.len() == 0"
    "Duration" => "v.${f}.nanos() == 0"
    "Time" => "v.${f} == Time.UNIX_EPOCH"
    _ => if tx.starts_with("List[") || tx.starts_with("Map[") {
      "v.${f}.len() == 0"
    } else if tx.ends_with("?") || tx.starts_with("Option[") {
      "v.${f} == None"
    } else {
      ""
    }
  }
}

/// The reader, writer and entry points of a struct that derives Cbor.
fn (var c: Checker) cbor_codec(sd: parser.StructDecl, em: Emit, var done: Map[Str, Bool], file: Int) -> Emit? {
  var e = em
  let sp = sd.name.span
  let n = text(sd.name.name)
  let pub_ = if sd.is_pub { "pub " } else { "" }
  var zeros: List[Str] = []
  var inits: List[Str] = []
  var decls: List[Str] = []
  var arms: List[Str] = []
  var puts: List[Str] = []
  var exact: List[Str] = []
  var fold: List[Str] = []
  var iarms: List[Str] = []
  var seen_decls: List[Str] = []
  var nfound = 0
  var ok = true
  var toarray = false
  var rule = ""
  for a in sd.derive_args {
    if text(a.derive.name) == "Cbor" && text(a.key.name) == "case" {
      rule = text(a.value.name)
    }
  }
  var pos_rd: List[Str] = []
  var pos_wr: List[Str] = []
  var pos_f: List[Str] = []
  var pos_pt: List[Str] = []
  // the direct writer's fields (decision 0559): key encoding, write line, omit test
  var put_keys: List[List[Int]] = []
  var put_lines: List[Str] = []
  var put_omit: List[Str] = []
  for fl in sd.fields {
    let f = text(fl.name.name)
    let co = cbor_opts(fl, rule)
    if co.toarray {
      toarray = true
    }
    if !co.bad.is_empty() {
      c.error_at(file, "XO0422", fl.name.span, "unknown cbor option `${co.bad}` of field `${f}`; the options are omitempty, omitzero, keyasint and toarray (decision 0527)")
      ok = false
      continue
    }
    let (rd, zero, e2) = c.cbor_reader(fl.typ, fl.name.span, e, done) ?? {
      c.error_at(file, "XO0425", fl.name.span, "`derive Cbor` maps a Str, Int, Float, Bool, Bytes, a cbor.Value, an Option, a List, a Map[Str, V] of those, or a struct that derives Cbor; field `${f}` is another type (decision 0527)")
      ok = false
      continue
    }
    e = e2
    let (wr, e3) = c.cbor_writer(fl.typ, fl.name.span, e, done) ?? return None
    e = e3
    let (pt, e4) = c.cbor_putter(fl.typ, fl.name.span, e, done) ?? return None
    e = e4
    zeros.push("${f}: ${zero}")
    inits.push("${f}: f_${f}")
    if co.skip {
      decls.push("  let f_${f} = base.${f}")
      continue
    }
    pos_rd.push(rd)
    pos_wr.push(wr)
    pos_pt.push(pt)
    pos_f.push(f)
    let tx = yaml_type_text(fl.typ) ?? "Str"
    decls.push("  var f_${f}: ${tx} = base.${f}")
    var keyval = ""
    var kb = cbor_key_bytes(co.key, false, 0)
    if co.keyasint {
      let ki = Int.parse(co.key) ?? {
        c.error_at(file, "XO0425", fl.name.span, "`keyasint` needs an integer wire name; `${co.key}` is not one (decision 0527)")
        ok = false
        continue
      }
      keyval = "cbor.from_int(${ki})"
      kb = cbor_key_bytes("", true, ki)
      iarms.push("      ${if iarms.is_empty() { "" } else { "else " }}if i == ${ki} { idx = ${nfound} }")
    } else {
      keyval = "cbor.Value.TextString(s: ${quote_str(co.key)})"
    }
    // fxamacker matches a key's text exactly first (a keyasint field's text is
    // the number), then ignoring case; the first key to reach a field wins
    exact.push("${if exact.is_empty() { "" } else { "else " }}if s == ${quote_str(co.key)} { idx = ${nfound} }")
    fold.push("${if fold.is_empty() { "" } else { "else " }}if sl == ${quote_str(co.key.to_lower())} { idx = ${nfound} }")
    seen_decls.push("  var seen_${nfound} = false")
    arms.push("    ${if arms.is_empty() { "" } else { "} else " }}if idx == ${nfound} {")
    arms.push("      let (ok2, x) = ${rd}(v, st)")
    arms.push("      if ok2 { f_${f} = x }")
    nfound += 1
    var line = "  ps.push((${keyval}, ${wr}(v.${f})))"
    if co.omit {
      let zt = cbor_empty_test(tx, f)
      if zt.is_empty() {
        c.error_at(file, "XO0425", fl.name.span, "`omitempty` on field `${f}` needs a Str, Int, Float, Bool, Bytes, Option, List or Map field (decision 0527)")
        ok = false
        continue
      }
      line = "  if !(${zt}) { ps.push((${keyval}, ${wr}(v.${f}))) }"
      put_omit.push(zt)
    } else {
      put_omit.push("")
    }
    puts.push(line)
    put_keys.push(kb)
    put_lines.push("out.write(${cbor_bytes_lit(kb)}); ${pt}(v.${f}, det, out)?")
  }
  if !ok {
    return None
  }
  e.ln("${pub_}fn cbor_zero__${n}() -> ${n} { ${n}{${zeros.join(", ")}} }", sp)
  e.ln("${pub_}fn cbor_rd__${n}(x: cbor.Value, var st: cbor.Unm) -> (Bool, ${n}) {", sp)
  e.ln("  let base = cbor_zero__${n}()", sp)
  e.ln("  if cbor.is_null(x) { return (false, base) }", sp)
  if toarray {
    e.ln("  let (ok, its) = cbor.items(x, ${quote_str(n)}, st)", sp)
    e.ln("  if !ok { return (false, base) }", sp)
    e.ln("  if its.len() != ${pos_f.len()} {", sp)
    e.ln("    cbor.bad_arity(st, ${quote_str(n)}, its.len(), ${pos_f.len()})", sp)
    e.ln("    return (false, base)", sp)
    e.ln("  }", sp)
    for l in decls {
      e.ln(l, sp)
    }
    for (j, f) in pos_f.indexed() {
      e.ln("  let (o${j}, x${j}) = ${pos_rd[j]}(its[${j}], st)", sp)
      e.ln("  if o${j} { f_${f} = x${j} }", sp)
    }
    e.ln("  (true, ${n}{${inits.join(", ")}})", sp)
    e.ln("}", sp)
    e.ln("${pub_}fn cbor_wr__${n}(v: ${n}) -> cbor.Value {", sp)
    e.ln("  var out: List[cbor.Value] = []", sp)
    for (j, f) in pos_f.indexed() {
      e.ln("  out.push(${pos_wr[j]}(v.${f}))", sp)
    }
    e.ln("  cbor.Value.Array(items: out)", sp)
    e.ln("}", sp)
    e.ln("${pub_}fn cbor_put__${n}(v: ${n}, det: Bool, var out: BytesBuilder) -> () ! cbor.CborErr {", sp)
    e.ln("  cbor.put_head(out, 4, ${pos_f.len()})", sp)
    for (j, f) in pos_f.indexed() {
      e.ln("  ${pos_pt[j]}(v.${f}, det, out)?", sp)
    }
    e.ln("  Ok(())", sp)
    e.ln("}", sp)
    return Some(c.cbor_entries(n, pub_, sp, e))
  }
  e.ln("  let (ok, ps) = cbor.pairs(x, ${quote_str(n)}, st)", sp)
  e.ln("  if !ok { return (false, base) }", sp)
  for l in decls {
    e.ln(l, sp)
  }
  for l in seen_decls {
    e.ln(l, sp)
  }
  e.ln("  for (k, v) in ps {", sp)
  e.ln("    var idx = -1", sp)
  e.ln("    if let Some(s) = cbor.key_text(k) {", sp)
  e.ln("      let sl = s.to_lower()", sp)
  e.ln("      ${exact.join(" ")}${if exact.is_empty() { "" } else { " else " }}{", sp)
  e.ln("        ${fold.join(" ")}", sp)
  e.ln("      }", sp)
  if iarms.is_empty() {
    e.ln("    }", sp)
  } else {
    e.ln("    } else if let Some(i) = cbor.key_int(k) {", sp)
    e.ln("      ${iarms.join(" ")}", sp)
    e.ln("    }", sp)
  }
  e.ln("    if idx < 0 {", sp)
  e.ln("      cbor.unknown_key(st, ${quote_str(n)}, k)", sp)
  e.ln("      continue", sp)
  e.ln("    }", sp)
  for j in 0..seen_decls.len() {
    e.ln("    if idx == ${j} { if seen_${j} { continue }; seen_${j} = true }", sp)
  }
  for l in arms {
    e.ln(l, sp)
  }
  if !arms.is_empty() {
    e.ln("    }", sp)
  }
  e.ln("  }", sp)
  e.ln("  (true, ${n}{${inits.join(", ")}})", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn cbor_wr__${n}(v: ${n}) -> cbor.Value {", sp)
  e.ln("  var ps: List[(cbor.Value, cbor.Value)] = []", sp)
  for l in puts {
    e.ln(l, sp)
  }
  e.ln("  cbor.Value.Map(pairs: ps)", sp)
  e.ln("}", sp)
  e = c.cbor_struct_put(n, pub_, sp, e, put_keys, put_lines, put_omit)
  Some(c.cbor_entries(n, pub_, sp, e))
}

/// A field's protobuf tag, `proto "N,options"`: the number and the options zigzag and
/// fixed (decision 0530); bad is the first other option, num 0 when missing.
struct ProtoOpts {
  /// 0 when missing, -1 for a oneof (`proto "oneof"`), -2 for the unknown field bytes (`proto "unknown"`)
  num: Int
  zigzag: Bool
  fixed: Bool
  bad: Str
}

fn proto_opts(fl: parser.Field) -> ProtoOpts {
  var o = ProtoOpts{num: 0, zigzag: false, fixed: false, bad: ""}
  for fw in fl.formats {
    if fw.format == b"proto" {
      let parts = text(fw.wire).split(",")
      o.num = if parts[0] == "oneof" { -1 } else if parts[0] == "unknown" { -2 } else { Int.parse(parts[0]) ?? 0 }
      for opt in parts[1..] {
        if opt == "zigzag" {
          o.zigzag = true
        } else if opt == "fixed" {
          o.fixed = true
        } else if o.bad.is_empty() {
          o.bad = opt
        }
      }
    }
  }
  o
}

/// How derive Proto writes and reads one element type: wire type, the expression that appends the
/// value $V to the buffer $B, the reader function, the value from the read result $X, and the test
/// that $V is not the proto3 default.
struct ProtoElem {
  wire: Int
  enc: Str
  rd: Str
  conv: Str
  nonzero: Str
  zero: Str
  packable: Bool
  /// a message merges into the value already read ($R), as Go does; empty for other types
  merge: Str
  /// the bytes enc writes for $V, without the tag (protobuf-go's size pass, decision 0549)
  size: Str = ""
}

fn proto_elem(tx: Str, po: ProtoOpts, enums: Map[Str, Str]) -> ProtoElem? {
  if let Some(first) = enums.get(tx) {
    // an Int valued enum: its value is the number on the wire; a closed enum maps an unknown number to its first variant
    let zero = if first == "open" { "${tx}.from(0)" } else { "(${tx}.from(0) ?? ${tx}.${first})" }
    let conv = if first == "open" { "${tx}.from($X.to_bits())" } else { "(${tx}.from($X.to_bits()) ?? ${zero})" }
    return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, UInt64.from_bits($V.value()))", rd: "protobuf.read_varint", conv: conv, nonzero: "$V.value() != 0", zero: zero, packable: true, merge: "", size: "protobuf.size_varint(UInt64.from_bits($V.value()))"})
  }
  if tx == "Int" {
    if po.zigzag {
      return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, protobuf.encode_zigzag($V))", rd: "protobuf.read_varint", conv: "protobuf.decode_zigzag($X)", nonzero: "$V != 0", zero: "0", packable: true, merge: "", size: "protobuf.size_varint(protobuf.encode_zigzag($V))"})
    }
    if po.fixed {
      return Some(ProtoElem{wire: 1, enc: "protobuf.put_fixed64($B, UInt64.from_bits($V))", rd: "protobuf.read_fixed64", conv: "$X.to_bits()", nonzero: "$V != 0", zero: "0", packable: true, merge: "", size: "8"})
    }
    return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, UInt64.from_bits($V))", rd: "protobuf.read_varint", conv: "$X.to_bits()", nonzero: "$V != 0", zero: "0", packable: true, merge: "", size: "protobuf.size_varint(UInt64.from_bits($V))"})
  }
  if tx == "Int32" {
    if po.zigzag {
      return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, protobuf.encode_zigzag(Int($V)))", rd: "protobuf.read_varint", conv: "Int32.wrapping_from(protobuf.decode_zigzag(UInt64.from_bits($X.to_bits() & 4294967295)))", nonzero: "$V != Int32.wrapping_from(0)", zero: "Int32.wrapping_from(0)", packable: true, merge: "", size: "protobuf.size_varint(protobuf.encode_zigzag(Int($V)))"})
    }
    if po.fixed {
      return Some(ProtoElem{wire: 5, enc: "protobuf.put_fixed32($B, UInt32.wrapping_from(Int($V)))", rd: "protobuf.read_fixed32", conv: "Int32.wrapping_from(Int($X))", nonzero: "$V != Int32.wrapping_from(0)", zero: "Int32.wrapping_from(0)", packable: true, merge: "", size: "4"})
    }
    return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, UInt64.from_bits(Int($V)))", rd: "protobuf.read_varint", conv: "Int32.wrapping_from($X.to_bits())", nonzero: "$V != Int32.wrapping_from(0)", zero: "Int32.wrapping_from(0)", packable: true, merge: "", size: "protobuf.size_varint(UInt64.from_bits(Int($V)))"})
  }
  if tx == "UInt32" {
    if po.fixed {
      return Some(ProtoElem{wire: 5, enc: "protobuf.put_fixed32($B, $V)", rd: "protobuf.read_fixed32", conv: "$X", nonzero: "$V != UInt32.wrapping_from(0)", zero: "UInt32.wrapping_from(0)", packable: true, merge: "", size: "4"})
    }
    return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, UInt64.from_bits(Int($V)))", rd: "protobuf.read_varint", conv: "UInt32.wrapping_from($X.to_bits())", nonzero: "$V != UInt32.wrapping_from(0)", zero: "UInt32.wrapping_from(0)", packable: true, merge: "", size: "protobuf.size_varint(UInt64.from_bits(Int($V)))"})
  }
  if tx == "UInt64" {
    if po.fixed {
      return Some(ProtoElem{wire: 1, enc: "protobuf.put_fixed64($B, $V)", rd: "protobuf.read_fixed64", conv: "$X", nonzero: "$V.to_bits() != 0", zero: "UInt64.from_bits(0)", packable: true, merge: "", size: "8"})
    }
    return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, $V)", rd: "protobuf.read_varint", conv: "$X", nonzero: "$V.to_bits() != 0", zero: "UInt64.from_bits(0)", packable: true, merge: "", size: "protobuf.size_varint($V)"})
  }
  if tx == "Float32" {
    return Some(ProtoElem{wire: 5, enc: "protobuf.put_fixed32($B, $V.to_bits())", rd: "protobuf.read_fixed32", conv: "Float32.from_bits($X)", nonzero: "$V.to_bits() != UInt32.wrapping_from(0)", zero: "Float32.from_bits(UInt32.wrapping_from(0))", packable: true, merge: "", size: "4"})
  }
  if tx == "Bool" {
    return Some(ProtoElem{wire: 0, enc: "protobuf.put_varint($B, UInt64.from_bits(if $V { 1 } else { 0 }))", rd: "protobuf.read_varint", conv: "$X.to_bits() != 0", nonzero: "$V", zero: "false", packable: true, merge: "", size: "1"})
  }
  if tx == "Float" {
    return Some(ProtoElem{wire: 1, enc: "protobuf.put_fixed64($B, UInt64.from_bits($V.to_bits()))", rd: "protobuf.read_fixed64", conv: "Float.from_bits($X.to_bits())", nonzero: "$V.to_bits() != 0", zero: "0.0", packable: true, merge: "", size: "8"})
  }
  if tx == "Str" {
    return Some(ProtoElem{wire: 2, enc: "protobuf.put_bytes($B, $V.bytes())", rd: "protobuf.read_bytes", conv: "($X.to_str() ?? return Err(protobuf.ProtoErr.Utf8))", nonzero: "!$V.is_empty()", zero: "\"\"", packable: false, merge: "", size: "protobuf.size_varint(UInt64.wrapping_from($V.bytes().len())) + $V.bytes().len()"})
  }
  if tx == "Bytes" {
    return Some(ProtoElem{wire: 2, enc: "protobuf.put_bytes($B, $V)", rd: "protobuf.read_bytes", conv: "$X", nonzero: "$V.len() > 0", zero: "b\"\"", packable: false, merge: "", size: "protobuf.size_varint(UInt64.wrapping_from($V.len())) + $V.len()"})
  }
  if !tx.is_empty() && !tx.contains("[") && tx.bytes()[0] >= 65 && tx.bytes()[0] <= 90 {
    // a struct deriving Proto (its generated functions must exist; a plain field is always written)
    return Some(ProtoElem{wire: 2, enc: "proto_cwrite__${tx}($B, $V, sz__, at__)", rd: "protobuf.read_bytes", conv: "proto_unmarshal__${tx}($X)?", nonzero: "true", zero: "proto_zero__${tx}()", packable: false, merge: "proto_merge__${tx}($R, $X)?", size: "proto_csize__${tx}($V, sz__)"})
  }
  None
}

/// The text of a field type for derive Proto: yaml_type_text, and a Map keyed by Int, Str or Bool.
fn proto_type_text(t: parser.Type) -> Str? {
  match t {
    NamedType(_, path, args) => {
      if path.len() == 1 && args.len() == 2 && text(path[0].name) == "Map" {
        let k = yaml_type_text(args[0]) ?? return None
        if !(k is "Int" | "Str" | "Bool") {
          return None
        }
        let v = yaml_type_text(args[1]) ?? return None
        return Some("Map[${k}, ${v}]")
      }
      yaml_type_text(t)
    }
    _ => yaml_type_text(t)
  }
}

/// The bytes of the tag of field k with wire type w (a varint of k << 3 | w).
fn proto_tag_size(k: Int, w: Int) -> Int {
  var x = (k << 3) | w
  var n = 1
  while x >= 128 {
    x = x >> 7
    n += 1
  }
  n
}

fn proto_sub(t: Str, b: Str, v: Str, x: Str) -> Str {
  t.replace("$B", b).replace("$V", v).replace("$X", x)
}

/// A field's write into `b` with its key (`num << 3 | wire`): the
/// element's writer of the tag's builder, where it is one std/protobuf
/// has a keyed form of (put_key_varint, put_key_fixed32, put_key_bytes,
/// and a nested message's proto_kwrite__T), so the key and the value or
/// length go out together; otherwise the tag, then the writer.
fn proto_keyed(enc: Str, num: Int, wire: Int, v: Str) -> Str {
  let key = (num << 3) | wire
  for (from, to) in [("protobuf.put_varint($B, ", "protobuf.put_key_varint"), ("protobuf.put_fixed32($B, ", "protobuf.put_key_fixed32"), ("protobuf.put_bytes($B, ", "protobuf.put_key_bytes")] {
    if enc.starts_with(from) {
      return "${to}(b, ${key}, ${proto_sub(enc[from.len()..enc.len()], "", v, "")}"
    }
  }
  if enc.starts_with("proto_cwrite__") {
    let at = enc.find("($B, ") ?? -1
    if at > 0 {
      return "proto_kwrite__${enc[14..at]}(b, ${key}, ${proto_sub(enc[at + 5..enc.len()], "", v, "")}"
    }
  }
  proto_sub(enc, "protobuf.put_tag(b, ${num}, ${wire})", v, "")
}

/// `proto_zero__N`, `proto_marshal__N` and `proto_unmarshal__N` for a struct deriving Proto: Int, Bool,
/// Float, Str, Bytes and nested Proto struct fields, with Option (explicit presence) and List (packed
/// for the numeric types), proto3 implicit presence otherwise (a zero value is not written), fields
/// in declaration order.
fn (var c: Checker) proto_codec(sd: parser.StructDecl, em: Emit, file: Int, enums: Map[Str, Str], oneofs: Map[Str, List[(Int, Str, Str)]]) -> Emit? {
  var e = em
  let sp = sd.name.span
  let n = text(sd.name.name)
  let pub_ = if sd.is_pub { "pub " } else { "" }
  var zeros: List[Str] = []
  var wr: List[Str] = []
  // oneofs are written after the other fields, as Go does
  var wr_one: List[Str] = []
  // proto_size__N's lines, in the order of wr and wr_one (protobuf-go's size pass)
  var sz: List[Str] = []
  var sz_one: List[Str] = []
  var helpers: List[Str] = []
  var rd: List[(Str, List[Str])] = []
  var ok = true
  var used: List[Int] = []
  var unknown_f = ""
  for fl in sd.fields {
    let f = text(fl.name.name)
    let po = proto_opts(fl)
    if po.num == -2 {
      if unknown_f != "" || (proto_type_text(fl.typ) ?? "") != "Bytes" {
        c.error_at(file, "XO0422", fl.name.span, "`proto \"unknown\"` marks one `Bytes` field that keeps the unknown fields of a message (decision 0530)")
        ok = false
      } else {
        unknown_f = f
      }
      continue
    }
    if po.num != -1 && (po.num < 1 || po.num > 536870911 || (po.num >= 19000 && po.num <= 19999)) {
      c.error_at(file, "XO0422", fl.name.span, "field `${f}` of a `derive Proto` struct needs a field number in 1 to 536870911 outside 19000 to 19999, written `${f} proto \"N\": T` (decision 0530), or `proto \"oneof\"` for an enum of oneof variants")
      ok = false
      continue
    }
    if !po.bad.is_empty() {
      c.error_at(file, "XO0422", fl.name.span, "unknown proto option `${po.bad}` of field `${f}`; the options are zigzag and fixed (decision 0530)")
      ok = false
      continue
    }
    if po.num != -1 && used.contains(po.num) {
      c.error_at(file, "XO0422", fl.name.span, "field number ${po.num} of `${f}` is used twice (decision 0530)")
      ok = false
      continue
    }
    var tx = proto_type_text(fl.typ) ?? ""
    var kind = 0
    if tx.starts_with("Option[") && tx.ends_with("]") {
      kind = 1
      tx = tx[7..tx.len() - 1]
    } else if tx.ends_with("?") {
      kind = 1
      tx = tx[0..tx.len() - 1]
    } else if tx.starts_with("List[") && tx.ends_with("]") {
      kind = 2
      tx = tx[5..tx.len() - 1]
    }
    if po.num == -1 {
      let ovs = oneofs.get(tx) ?? []
      if ovs.is_empty() {
        c.error_at(file, "XO0425", fl.name.span, "`proto \"oneof\"` on `${f}` needs an enum declared in this file whose variants each have one field and a field number, `Circle as \"2\"(r: Int)` (decision 0530)")
        ok = false
        continue
      }
      var arms: List[Str] = []
      var sarms: List[Str] = []
      var first_zero = ""
      for (num, vn, vt) in ovs {
        let ve = proto_elem(vt, po, enums) ?? {
          c.error_at(file, "XO0425", fl.name.span, "the variant `${vn}` of `${tx}` has a type `derive Proto` does not map (decision 0530)")
          ok = false
          continue
        }
        if used.contains(num) {
          c.error_at(file, "XO0422", fl.name.span, "field number ${num} of variant `${vn}` is used twice (decision 0530)")
          ok = false
          continue
        }
        used.push(num)
        if first_zero.is_empty() {
          first_zero = "${tx}.${vn}(${ve.zero})"
        }
        arms.push("      ${vn}(x) => { b = ${proto_keyed(ve.enc, num, ve.wire, "x")} }")
        sarms.push("      ${vn}(x) => { s += ${proto_tag_size(num, ve.wire)} + ${proto_sub(ve.size, "", "x", "")} }")
        var val = proto_sub(ve.conv, "", "", "x")
        if !ve.merge.is_empty() {
          // the same message variant read before merges, as Go does
          let hn = "proto_cur__${n}__${f}__${vn}"
          helpers.push("fn ${hn}(c: ${tx}?) -> ${vt} {")
          helpers.push("  if let Some(x) = c {")
          helpers.push("    match x {")
          helpers.push("      ${vn}(p) => { return p }")
          helpers.push("      _ => {}")
          helpers.push("    }")
          helpers.push("  }")
          helpers.push("  ${ve.zero}")
          helpers.push("}")
          val = proto_sub(ve.merge, "", "", "x").replace("$R", "${hn}(${if kind == 1 { "r.${f}" } else { "Some(r.${f})" }})")
        }
        rd.push((" num == ${num} && wire == ${ve.wire}", ["let (x, n2) = ${ve.rd}(data, at)?", "at = n2", "r.${f} = ${if kind == 1 { "Some(" } else { "" }}${tx}.${vn}(${val})${if kind == 1 { ")" } else { "" }}"]))
      }
      if kind == 1 {
        zeros.push("${f}: None")
        wr_one.push("  if let Some(ov) = v.${f} {")
        wr_one.push("    match ov {")
        sz_one.push("  if let Some(ov) = v.${f} {")
        sz_one.push("    match ov {")
      } else {
        zeros.push("${f}: ${first_zero}")
        wr_one.push("  {")
        wr_one.push("    match v.${f} {")
        sz_one.push("  {")
        sz_one.push("    match v.${f} {")
      }
      for l in arms {
        wr_one.push(l)
      }
      for l in sarms {
        sz_one.push(l)
      }
      wr_one.push("    }")
      wr_one.push("  }")
      sz_one.push("    }")
      sz_one.push("  }")
      continue
    }
    used.push(po.num)
    let k = po.num
    if kind == 0 && tx.starts_with("Map[") && tx.ends_with("]") {
      let kv = tx[4..tx.len() - 1].split(", ")
      let kel = if kv.len() == 2 { proto_elem(kv[0], ProtoOpts{num: 0, zigzag: false, fixed: false, bad: ""}, enums) } else { None }
      let vel = if kv.len() == 2 && !kv[1].contains("[") { proto_elem(kv[1], po, enums) } else { None }
      if let Some(ke) = kel {
        if let Some(ve) = vel {
          if kv[0] == "Int" || kv[0] == "Str" || kv[0] == "Bool" {
            zeros.push("${f}: {}")
            // an entry is written in place after its size, as a nested message is
            // an entry's message value sizes go to a list of its own: the size pass walks the map
            // unsorted, the writer in key order
            let esz = "${proto_tag_size(1, ke.wire)} + ${proto_sub(ke.size, "", "k", "")} + ${proto_tag_size(2, ve.wire)} + ${proto_sub(ve.size, "", "val", "")}".replace("sz__", "msz__")
            wr.push("  for k in v.${f}.keys().sort() {")
            wr.push("    let val = v.${f}.get(k) ?? ${ve.zero}")
            wr.push("    var msz__: List[Int] = []")
            wr.push("    var mat__ = 0")
            wr.push("    b = protobuf.put_key_varint(b, ${(k << 3) | 2}, UInt64.wrapping_from(${esz}))")
            wr.push("    b = ${proto_keyed(ke.enc, 1, ke.wire, "k")}")
            wr.push("    b = ${proto_keyed(ve.enc, 2, ve.wire, "val").replace("sz__", "msz__").replace("at__", "mat__")}")
            wr.push("  }")
            sz.push("  for (k, val) in v.${f} {")
            sz.push("    var msz__: List[Int] = []")
            sz.push("    let es = ${esz}")
            sz.push("    s += ${proto_tag_size(k, 2)} + protobuf.size_varint(UInt64.wrapping_from(es)) + es")
            sz.push("  }")
            rd.push((" num == ${k} && wire == 2", ["let (x, n2) = protobuf.read_bytes(data, at)?", "at = n2", "var ek = ${ke.zero}", "var ev = ${ve.zero}", "var q = 0", "while q < x.len() {", "  let (en, ew, q1) = protobuf.read_tag(x, q)?", "  q = q1", "  if en == 1 && ew == ${ke.wire} {", "    let (y, q2) = ${ke.rd}(x, q)?", "    q = q2", "    ek = ${proto_sub(ke.conv, "", "", "y")}", "  } else if en == 2 && ew == ${ve.wire} {", "    let (y, q2) = ${ve.rd}(x, q)?", "    q = q2", "    ev = ${if ve.merge.is_empty() { proto_sub(ve.conv, "", "", "y") } else { proto_sub(ve.merge, "", "", "y").replace("$R", "ev") }}", "  } else {", "    q = protobuf.skip_field(x, q, en, ew)?", "  }", "}", "r.${f}[ek] = ev"]))
            continue
          }
        }
      }
    }
    let el = proto_elem(tx, po, enums) ?? {
      c.error_at(file, "XO0425", fl.name.span, "`derive Proto` maps an Int, Int32, UInt32, UInt64, Float, Float32, Bool, Str, Bytes, an Int valued enum of the same file or a struct deriving Proto, alone or in an Option or List; `${f}` is not one (decision 0530)")
      ok = false
      continue
    }
    let w = el.wire
        if kind == 0 {
      zeros.push("${f}: ${el.zero}")
      wr.push("  if ${proto_sub(el.nonzero, "", "v.${f}", "")} { b = ${proto_keyed(el.enc, k, w, "v.${f}")} }")
      sz.push("  if ${proto_sub(el.nonzero, "", "v.${f}", "")} { s += ${proto_tag_size(k, w)} + ${proto_sub(el.size, "", "v.${f}", "")} }")
      var val = proto_sub(el.conv, "", "", "x")
      if !el.merge.is_empty() {
        val = proto_sub(el.merge, "", "", "x").replace("$R", "r.${f}")
      }
      rd.push((" num == ${k} && wire == ${w}", ["let (x, n2) = ${el.rd}(data, at)?", "at = n2", "r.${f} = ${val}"]))
    } else if kind == 1 {
      zeros.push("${f}: None")
      wr.push("  if let Some(x) = v.${f} { b = ${proto_keyed(el.enc, k, w, "x")} }")
      sz.push("  if let Some(x) = v.${f} { s += ${proto_tag_size(k, w)} + ${proto_sub(el.size, "", "x", "")} }")
      var val = proto_sub(el.conv, "", "", "x")
      if !el.merge.is_empty() {
        val = proto_sub(el.merge, "", "", "x").replace("$R", "(r.${f} ?? ${el.zero})")
      }
      rd.push((" num == ${k} && wire == ${w}", ["let (x, n2) = ${el.rd}(data, at)?", "at = n2", "r.${f} = Some(${val})"]))
    } else {
      zeros.push("${f}: []")
      if el.packable {
        // packed: the payload's size, then its elements in place
        let psz = if el.size == "8" || el.size == "4" || el.size == "1" { "v.${f}.len() * ${el.size}" } else { "proto_psize__${n}__${f}(v.${f})" }
        if !(el.size == "8" || el.size == "4" || el.size == "1") {
          helpers.push("fn proto_psize__${n}__${f}(l: List[${tx}]) -> Int {")
          helpers.push("  var p = 0")
          helpers.push("  for x in l { p += ${proto_sub(el.size, "", "x", "")} }")
          helpers.push("  p")
          helpers.push("}")
        }
        wr.push("  if v.${f}.len() > 0 {")
        wr.push("    b = protobuf.put_key_varint(b, ${(k << 3) | 2}, UInt64.wrapping_from(${psz}))")
        wr.push("    for x in v.${f} { b = ${proto_sub(el.enc, "b", "x", "")} }")
        wr.push("  }")
        sz.push("  if v.${f}.len() > 0 {")
        sz.push("    let ps = ${psz}")
        sz.push("    s += ${proto_tag_size(k, 2)} + protobuf.size_varint(UInt64.wrapping_from(ps)) + ps")
        sz.push("  }")
        rd.push((" num == ${k} && wire == 2", ["let (x, n2) = protobuf.read_bytes(data, at)?", "at = n2", "var q = 0", "while q < x.len() {", "  let (y, q2) = ${el.rd}(x, q)?", "  q = q2", "  r.${f}.push(${proto_sub(el.conv, "", "", "y")})", "}"]))
      } else {
        wr.push("  for x in v.${f} { b = ${proto_keyed(el.enc, k, w, "x")} }")
        sz.push("  for x in v.${f} { s += ${proto_tag_size(k, w)} + ${proto_sub(el.size, "", "x", "")} }")
      }
      rd.push((" num == ${k} && wire == ${w}", ["let (x, n2) = ${el.rd}(data, at)?", "at = n2", "r.${f}.push(${proto_sub(el.conv, "", "", "x")})"]))
    }
  }
  if !ok {
    return None
  }
  if unknown_f != "" {
    zeros.push("${unknown_f}: b\"\"")
    wr_one.push("  b.write(v.${unknown_f})")
    sz_one.push("  s += v.${unknown_f}.len()")
  }
  for l in helpers {
    e.ln(l, sp)
  }
  e.ln("${pub_}fn proto_zero__${n}() -> ${n} { ${n}{${zeros.join(", ")}} }", sp)
  // protobuf-go's shape: a size pass, then one buffer of that size that every nested message, packed
  // list and map entry is written into in place (decision 0549), where each was a Bytes of its own
  // the size pass records each nested message's size in sz__, in the order the writer meets them
  // (protobuf-go caches sizes in the message), so a message's size is computed once, not once per level
  e.ln("${pub_}fn proto_sizes__${n}(v: ${n}, var sz__: List[Int]) -> Int {", sp)
  e.ln("  var s = 0", sp)
  for l in sz {
    e.ln(l, sp)
  }
  for l in sz_one {
    e.ln(l, sp)
  }
  e.ln("  let _ = sz__.len()", sp)
  e.ln("  s", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn proto_size__${n}(v: ${n}) -> Int {", sp)
  e.ln("  var sz__: List[Int] = []", sp)
  e.ln("  proto_sizes__${n}(v, sz__)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn proto_csize__${n}(v: ${n}, var sz__: List[Int]) -> Int {", sp)
  e.ln("  let at = sz__.len()", sp)
  e.ln("  sz__.push(0)", sp)
  e.ln("  let n = proto_sizes__${n}(v, sz__)", sp)
  e.ln("  sz__[at] = n", sp)
  e.ln("  protobuf.size_varint(UInt64.wrapping_from(n)) + n", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn proto_write__${n}(b0: BytesBuilder, v: ${n}, sz__: List[Int], var at__: Int) -> BytesBuilder {", sp)
  e.ln("  var b = b0", sp)
  for l in wr {
    e.ln(l, sp)
  }
  for l in wr_one {
    e.ln(l, sp)
  }
  e.ln("  let _ = sz__.len() + at__", sp)
  e.ln("  b", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn proto_cwrite__${n}(b: BytesBuilder, v: ${n}, sz__: List[Int], var at__: Int) -> BytesBuilder {", sp)
  e.ln("  let n = sz__[at__]", sp)
  e.ln("  at__ += 1", sp)
  e.ln("  proto_write__${n}(protobuf.put_varint(b, UInt64.wrapping_from(n)), v, sz__, at__)", sp)
  e.ln("}", sp)
  // the same with the field's key written with the length (proto_keyed)
  e.ln("${pub_}fn proto_kwrite__${n}(b: BytesBuilder, key: Int, v: ${n}, sz__: List[Int], var at__: Int) -> BytesBuilder {", sp)
  e.ln("  let n = sz__[at__]", sp)
  e.ln("  at__ += 1", sp)
  e.ln("  proto_write__${n}(protobuf.put_key_varint(b, key, UInt64.wrapping_from(n)), v, sz__, at__)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn proto_marshal__${n}(v: ${n}) -> Bytes {", sp)
  e.ln("  var sz__: List[Int] = []", sp)
  e.ln("  let n = proto_sizes__${n}(v, sz__)", sp)
  e.ln("  var at__ = 0", sp)
  e.ln("  proto_write__${n}(BytesBuilder.with_capacity(n), v, sz__, at__).freeze()", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn proto_unmarshal__${n}(data: Bytes) -> ${n} ! protobuf.ProtoErr { proto_merge__${n}(proto_zero__${n}(), data) }", sp)
  e.ln("${pub_}fn proto_merge__${n}(r0: ${n}, data: Bytes) -> ${n} ! protobuf.ProtoErr {", sp)
  e.ln("  var r = r0", sp)
  e.ln("  var at = 0", sp)
  e.ln("  while at < data.len() {", sp)
  e.ln("    let t0 = at", sp)
  e.ln("    let (num, wire, nx) = protobuf.read_tag(data, at)?", sp)
  e.ln("    at = nx", sp)
  e.ln("    if num > 536870911 { return Err(protobuf.ProtoErr.BadTag) }", sp)
  var first = true
  for (cond, lines) in rd {
    e.ln("    ${if first { "if" } else { "} else if" }}${cond} {", sp)
    for l in lines {
      e.ln("      ${l}", sp)
    }
    first = false
  }
  if first {
    e.ln("    at = protobuf.skip_field(data, at, num, wire)?", sp)
    if unknown_f != "" {
      e.ln("    var ub = BytesBuilder.new()", sp)
      e.ln("    ub.write(r.${unknown_f})", sp)
      e.ln("    ub.write(data[t0..at])", sp)
      e.ln("    r.${unknown_f} = ub.freeze()", sp)
    }
  } else {
    e.ln("    } else {", sp)
    e.ln("      at = protobuf.skip_field(data, at, num, wire)?", sp)
    if unknown_f != "" {
      e.ln("      var ub = BytesBuilder.new()", sp)
      e.ln("      ub.write(r.${unknown_f})", sp)
      e.ln("      ub.write(data[t0..at])", sp)
      e.ln("      r.${unknown_f} = ub.freeze()", sp)
    }
    e.ln("    }", sp)
  }
  e.ln("  }", sp)
  e.ln("  Ok(r)", sp)
  e.ln("}", sp)
  Some(e)
}

/// A map struct's direct writer `cbor_put__N` (decision 0559): the key of each
/// field a constant, the fields in declaration order, and when det in RFC 8949
/// 4.2.1's order of their encoded keys, both computed here; a field with an omit
/// test is counted out of the map's head before the fields are written.
fn (var c: Checker) cbor_struct_put(n: Str, pub_: Str, sp: Span, em: Emit, keys: List[List[Int]], lines: List[Str], omit: List[Str]) -> Emit {
  var e = em
  var canon: List[Int] = []
  for i in 0..keys.len() {
    var at = canon.len()
    while at > 0 && cbor_key_less(keys[i], keys[canon[at - 1]]) {
      at -= 1
    }
    canon.insert(at, i)
  }
  var same = true
  for (j, i) in canon.indexed() {
    if i != j {
      same = false
    }
  }
  e.ln("${pub_}fn cbor_put__${n}(v: ${n}, det: Bool, var out: BytesBuilder) -> () ! cbor.CborErr {", sp)
  var any_omit = false
  for t in omit {
    if !t.is_empty() {
      any_omit = true
    }
  }
  if any_omit {
    e.ln("  var cnt = ${keys.len()}", sp)
    for t in omit {
      if !t.is_empty() {
        e.ln("  if ${t} { cnt -= 1 }", sp)
      }
    }
    e.ln("  cbor.put_head(out, 5, cnt)", sp)
  } else {
    e.ln("  cbor.put_head(out, 5, ${keys.len()})", sp)
  }
  let one = fn(i: Int) -> Str {
    if omit[i].is_empty() { "  ${lines[i]}" } else { "  if !(${omit[i]}) { ${lines[i]} }" }
  }
  if same {
    for i in 0..keys.len() {
      e.ln(one(i), sp)
    }
  } else {
    e.ln("  if det {", sp)
    for i in canon {
      e.ln("  ${one(i)}", sp)
    }
    e.ln("  } else {", sp)
    for i in 0..keys.len() {
      e.ln("  ${one(i)}", sp)
    }
    e.ln("  }", sp)
  }
  e.ln("  Ok(())", sp)
  e.ln("}", sp)
  e
}

/// `cbor_marshal__N`, `cbor_unmarshal__N` and `cbor_unmarshal_prefix__N`, over the
/// struct's `cbor_wr__N` and `cbor_rd__N`.
fn (var c: Checker) cbor_entries(n: Str, pub_: Str, sp: Span, em: Emit) -> Emit {
  var e = em
  e.ln("${pub_}fn cbor_marshal__${n}(v: ${n}, deterministic: Bool = true) -> Bytes ! cbor.CborErr {", sp)
  e.ln("  var out = BytesBuilder.new()", sp)
  e.ln("  cbor_put__${n}(v, deterministic, out)?", sp)
  e.ln("  Ok(out.freeze())", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn cbor_unmarshal__${n}(data: Bytes, strict: Bool = false, max_depth: Int = 128) -> ${n} ! cbor.CborErr {", sp)
  e.ln("  let x = cbor.decode(data, max_depth, false)?", sp)
  e.ln("  var st = cbor.unm_new(strict)", sp)
  e.ln("  let (_, v) = cbor_rd__${n}(x, st)", sp)
  e.ln("  if let Some(err) = cbor.dec_error(st) { return Err(err) }", sp)
  e.ln("  Ok(v)", sp)
  e.ln("}", sp)
  e.ln("${pub_}fn cbor_unmarshal_prefix__${n}(data: Bytes, strict: Bool = false, max_depth: Int = 128) -> (${n}, Int) ! cbor.CborErr {", sp)
  e.ln("  let (x, used) = cbor.decode_prefix(data, max_depth, false)?", sp)
  e.ln("  var st = cbor.unm_new(strict)", sp)
  e.ln("  let (_, v) = cbor_rd__${n}(x, st)", sp)
  e.ln("  if let Some(err) = cbor.dec_error(st) { return Err(err) }", sp)
  e.ln("  Ok((v, used))", sp)
  e.ln("}", sp)
  e
}

/// The codec of an enum that derives Cbor (decision 0527), as source: a unit variant is the text of its name, a variant
/// with fields a one entry map from its name to a map of its fields (the field name is the key), or, for a lone unnamed
/// `from` field, to that value. The functions are `cbor_zero__E`, `cbor_wr__E`, `cbor_rd__E` and the three entry points.
fn (var c: Checker) cbor_enum_codec(ed: parser.EnumDecl, em: Emit, var done: Map[Str, Bool], file: Int) -> Emit? {
  var e = em
  let sp = ed.name.span
  let n = text(ed.name.name)
  let pub_ = if ed.is_pub { "pub " } else { "" }
  var rule = ""
  for a in ed.derive_args {
    if text(a.derive.name) == "Cbor" && text(a.key.name) == "case" {
      rule = text(a.value.name)
    }
  }
  var wr: List[Str] = []
  var rd_text: List[Str] = []
  var rd_map: List[Str] = []
  var zero = ""
  var ok = true
  for (vi, v) in ed.variants.indexed() {
    let vn = text(v.name.name)
    let wire = if let Some(w) = v.wire { text(w) } else { if rule.is_empty() { vn } else { text(wire_case(snake_of(v.name.name), rule)) } }
    let key = "cbor.Value.TextString(s: ${quote_str(wire)})"
    match v.fields {
      None => {
        if vi == 0 {
          zero = "${n}.${vn}"
        }
        wr.push("    ${vn} => ${key}")
        rd_text.push("  if name == ${quote_str(wire)} { return (true, ${n}.${vn}) }")
        rd_map.push("    if name == ${quote_str(wire)} { return (true, ${n}.${vn}) }")
      }
      Some(fs) => {
        var binds: List[Str] = []
        var entries: List[Str] = []
        var decls: List[Str] = []
        var arms: List[Str] = []
        var args: List[Str] = []
        var zeros: List[Str] = []
        let lone = fs.len() == 1 && fs[0].name == None
        for (i, f) in fs.indexed() {
          let (r, z, e2) = c.cbor_reader(f.typ, f.span, e, done) ?? {
            c.error_at(file, "XO0425", f.span, "`derive Cbor` maps a Str, Int, Float, Bool, Bytes, a cbor.Value, an Option, a List, a Map[Str, V] of those, a struct or enum that derives Cbor; field ${i + 1} of variant `${vn}` is another type (decision 0527)")
            ok = false
            continue
          }
          e = e2
          let (w, e3) = c.cbor_writer(f.typ, f.span, e, done) ?? return None
          e = e3
          binds.push("f${i}")
          zeros.push(z)
          decls.push("      var f${i} = ${z}")
          if lone {
            entries.push("${w}(f${i})")
            arms.push("      let (ok0, t0) = ${r}(ps[0].1, st)")
            arms.push("      if ok0 { f0 = t0 }")
            args.push("f0")
          } else {
            let fname = if let Some(id) = f.name { text(id.name) } else { "f${i}" }
            entries.push("(cbor.Value.TextString(s: ${quote_str(fname)}), ${w}(f${i}))")
            let kw = if i == 0 { "if" } else { "} else if" }
            arms.push("        ${kw} kn == ${quote_str(fname)} {")
            arms.push("          let (ok1, t1) = ${r}(fv, st)")
            arms.push("          if ok1 { f${i} = t1 }")
            args.push(if let Some(id) = f.name { "${text(id.name)}: f${i}" } else { "f${i}" })
          }
        }
        if vi == 0 {
          zero = "${n}.${vn}(${zeros.join(", ")})"
        }
        let inner = if lone { entries[0] } else { "cbor.Value.Map(pairs: [${entries.join(", ")}])" }
        wr.push("    ${vn}(${binds.join(", ")}) => cbor.Value.Map(pairs: [(${key}, ${inner})])")
        var body: List[Str] = []
        body.push("    if name == ${quote_str(wire)} {")
        for d in decls {
          body.push(d)
        }
        if lone {
          for a in arms {
            body.push(a)
          }
        } else {
          body.push("      let (okm, fs) = cbor.pairs(ps[0].1, ${quote_str("${n}.${vn}")}, st)")
          body.push("      if !okm { return (false, z) }")
          body.push("      for (fk, fv) in fs {")
          body.push("        let kn = cbor.key_text(fk) ?? \"\"")
          for a in arms {
            body.push(a)
          }
          body.push("        } else {")
          body.push("          cbor.unknown_key(st, ${quote_str("${n}.${vn}")}, fk)")
          body.push("        }")
          body.push("      }")
        }
        body.push("      return (true, ${n}.${vn}(${args.join(", ")}))")
        body.push("    }")
        for b in body {
          rd_map.push(b)
        }
      }
    }
  }
  if !ok {
    return None
  }
  if ed.variants.is_empty() {
    return None
  }
  e.ln("fn cbor_zero__${n}() -> ${n} { ${zero} }", sp)
  e.ln("fn cbor_put__${n}(v: ${n}, det: Bool, var out: BytesBuilder) -> () ! cbor.CborErr { cbor.put_value(out, cbor_wr__${n}(v), det) }", sp)
  e.ln("fn cbor_wr__${n}(v: ${n}) -> cbor.Value {", sp)
  e.ln("  match v {", sp)
  for w in wr {
    e.ln(w, sp)
  }
  e.ln("  }", sp)
  e.ln("}", sp)
  e.ln("fn cbor_rd__${n}(x: cbor.Value, var st: cbor.Unm) -> (Bool, ${n}) {", sp)
  e.ln("  let z = cbor_zero__${n}()", sp)
  e.ln("  if let Some(name) = cbor.key_text(x) {", sp)
  for r in rd_text {
    e.ln("  ${r}", sp)
  }
  e.ln("    cbor.bad_variant(st, ${quote_str(n)}, name)", sp)
  e.ln("    return (false, z)", sp)
  e.ln("  }", sp)
  e.ln("  let (okp, ps) = cbor.pairs(x, ${quote_str(n)}, st)", sp)
  e.ln("  if !okp { return (false, z) }", sp)
  e.ln("  if ps.len() != 1 {", sp)
  e.ln("    cbor.bad_variant(st, ${quote_str(n)}, \"a map that is not one entry\")", sp)
  e.ln("    return (false, z)", sp)
  e.ln("  }", sp)
  e.ln("  let name = cbor.key_text(ps[0].0) ?? \"\"", sp)
  for r in rd_map {
    e.ln(r, sp)
  }
  e.ln("  cbor.bad_variant(st, ${quote_str(n)}, name)", sp)
  e.ln("  (false, z)", sp)
  e.ln("}", sp)
  e = c.cbor_entries(n, pub_, sp, e)
  Some(e)
}

/// The methods of a valued enum (decision 0269), as source: one constant
/// a variant (the declared expression, or the previous plus one, or the
/// variant's name for a `Str`), `value()`, `E.from(v)`, and `E.all()`.
/// A catch-all last variant (decision 0493, `Unknown(value: Str)`) has
/// no constant: `value()` is its field, `from` returns it for a value no
/// other variant has (so `E`, not `E?`), `E.known(v)` is the strict
/// lookup, and `all()` leaves it out. A faulty enum is left to the
/// checker's own errors (XO0428, XO0429, XO0434).
fn (var c: Checker) valued_enum_methods(file: Int, ed: parser.EnumDecl, em0: Emit) -> Emit {
  var em = em0
  let vt = match ed.value_type {
    Some(x) => text(x.name)
    None => return em
  }
  if (vt != "Int" && vt != "Str") || !ed.type_params.is_empty() || ed.variants.is_empty() {
    return em
  }
  // the catch-all's name, when the last variant is one
  var catch = ""
  for (i, v) in ed.variants.indexed() {
    if let Some(fs) = v.fields {
      if i != ed.variants.len() - 1 || fs.len() != 1 || fs[0].from || v.value != None || !names_type(fs[0].typ, vt) {
        return em
      }
      catch = text(v.name.name)
    }
  }
  let named = if catch.is_empty() { ed.variants.len() } else { ed.variants.len() - 1 }
  if named == 0 {
    return em
  }
  let n = text(ed.name.name)
  let pub_ = if ed.is_pub { "pub " } else { "" }
  let sp = ed.name.span
  let src = c.files[file].src
  for i in 0..named {
    let v = ed.variants[i]
    var body = ""
    if let Some(x) = v.value {
      let xs = parser.expr_span(x)
      body = text(src[xs.start.offset..xs.end.offset])
    } else if vt == "Str" {
      body = "\"${text(v.name.name)}\""
    } else if i == 0 {
      body = "0"
    } else {
      body = "${n}__V${i - 1} + 1"
    }
    em.ln("const ${n}__V${i}: ${vt} = ${body}", v.name.span)
  }
  em.ln("${pub_}fn (e: ${n}) value() -> ${vt} {", sp)
  em.ln("  match e {", sp)
  for i in 0..named {
    let v = ed.variants[i]
    em.ln("    ${text(v.name.name)} => ${n}__V${i}", v.name.span)
  }
  if !catch.is_empty() {
    em.ln("    ${catch}(v) => v", ed.variants[named].name.span)
  }
  em.ln("  }", sp)
  em.ln("}", sp)
  // the strict lookup: `from` of a closed enum, `known` of an open one
  let strict = if catch.is_empty() { "from" } else { "known" }
  em.ln("${pub_}fn (static: ${n}) ${strict}(v: ${vt}) -> ${n}? {", sp)
  for i in 0..named {
    let v = ed.variants[i]
    em.ln("  if v == ${n}__V${i} { return Some(${n}.${text(v.name.name)}) }", v.name.span)
  }
  em.ln("  None", sp)
  em.ln("}", sp)
  if !catch.is_empty() {
    em.ln("${pub_}fn (static: ${n}) from(v: ${vt}) -> ${n} { ${n}.known(v) ?? ${n}.${catch}(v) }", sp)
  }
  var all: List[Str] = []
  for i in 0..named {
    all.push("${n}.${text(ed.variants[i].name.name)}")
  }
  em.ln("${pub_}fn (static: ${n}) all() -> List[${n}] { [${all.join(", ")}] }", sp)
  em
}

/// Whether t is the plain type name n (`Str`, no module, no arguments).
fn names_type(t: parser.Type, n: Str) -> Bool {
  match t {
    NamedType(path: p, args: a, ..) => p.len() == 1 && a.is_empty() && text(p[0].name) == n
    _ => false
  }
}

/// The expansion of every `derive Xml` struct of f as one source text,
/// with the span each line is reported at; "" when there is none.
fn (var c: Checker) expand_derives(file: Int, f: parser.File) -> (Str, List[Span]) {
  var em = Emit{}
  var any = false
  // the structs of this file that do not derive Xml
  var plain: Map[Str, Bool] = {}
  for d in f.decls {
    if let StructDecl(s) = d {
      var has = false
      for id in s.derive {
        if id.name == b"Xml" {
          has = true
        }
      }
      if !has {
        plain[text(s.name.name)] = true
      }
    }
  }
  for d in f.decls {
    let sd = match d {
      StructDecl(s) => s
      _ => continue
    }
    var derived = false
    for id in sd.derive {
      if id.name == b"Xml" {
        derived = true
      }
    }
    if !derived {
      continue
    }
    if !sd.type_params.is_empty() {
      c.error_at(file, "XO0425", sd.name.span, "`derive Xml` needs a struct without type parameters; `${text(sd.name.name)}` has some")
      continue
    }
    var shapes: List[XmlShape?] = []
    var tags: List[XmlTag] = []
    var ok = true
    for fl in sd.fields {
      let shape = xml_shape(fl.typ)
      if shape == None {
        c.error_at(file, "XO0425", fl.name.span, "`derive Xml` maps a Str, Int, Float, Bool, or a struct that derives Xml, alone, as an Option, or in a List; field `${text(fl.name.name)}` is another type (decision 0315)")
        ok = false
      }
      shapes.push(shape)
      tags.push(c.xml_tag(fl, shape ?? XmlShape{coll: 0, scalar: "Str", qual: "", sname: ""}, file))
    }
    for (i, fl) in sd.fields.indexed() {
      if tags[i].bad {
        ok = false
      }
      let sh = match shapes[i] {
        Some(x) => x
        None => continue
      }
      if sh.scalar.is_empty() && sh.qual.is_empty() && plain.contains(sh.sname) {
        c.error_at(file, "XO0425", fl.name.span, "field `${text(fl.name.name)}` is the struct `${sh.sname}`, which does not derive Xml; add `derive Xml` to it (decision 0315)")
        ok = false
      }
    }
    if !ok {
      continue
    }
    any = true
    em = c.xml_encoder(sd, shapes, tags, em)
    em = c.xml_decoder(sd, shapes, tags, em)
  }
  let any_xml = any
  var any_yaml = false
  var ydone: Map[Str, Bool] = {}
  for d in f.decls {
    let sd = match d {
      StructDecl(s) => s
      _ => continue
    }
    var derived = false
    for id in sd.derive {
      if id.name == b"Yaml" {
        derived = true
      }
    }
    if !derived {
      continue
    }
    if !sd.type_params.is_empty() {
      c.error_at(file, "XO0425", sd.name.span, "`derive Yaml` needs a struct without type parameters; `${text(sd.name.name)}` has some")
      continue
    }
    if let Some(e2) = c.yaml_decoder(sd, em, ydone, file) {
      em = e2
      any = true
      any_yaml = true
      if let Some(e3) = c.yaml_encoder(sd, em, ydone, file) {
        em = e3
      }
    }
  }
  var any_cbor = false
  var cdone: Map[Str, Bool] = {}
  for d in f.decls {
    let sd = match d {
      StructDecl(s) => s
      _ => continue
    }
    var derived = false
    for id in sd.derive {
      if id.name == b"Cbor" {
        derived = true
      }
    }
    if !derived {
      continue
    }
    if !sd.type_params.is_empty() {
      c.error_at(file, "XO0425", sd.name.span, "`derive Cbor` needs a struct without type parameters; `${text(sd.name.name)}` has some")
      continue
    }
    if let Some(e2) = c.cbor_codec(sd, em, cdone, file) {
      em = e2
      any = true
      any_cbor = true
    }
  }
  var any_proto = false
  // enums of oneof variants of this file: (field number, variant, type) per variant
  var poneofs: Map[Str, List[(Int, Str, Str)]] = {}
  for d in f.decls {
    if let EnumDecl(ed) = d {
      var vs: List[(Int, Str, Str)] = []
      var good = ed.value_type == None && !ed.variants.is_empty()
      for v in ed.variants {
        let fs = v.fields ?? []
        let wn = if let Some(w) = v.wire { Int.parse(text(w)) ?? 0 } else { 0 }
        if fs.len() != 1 || wn < 1 {
          good = false
          continue
        }
        vs.push((wn, text(v.name.name), yaml_type_text(fs[0].typ) ?? ""))
      }
      if good {
        poneofs[text(ed.name.name)] = vs
      }
    }
  }
  // Int valued enums of this file: "open" with a catch-all variant, else the first variant
  var penums: Map[Str, Str] = {}
  for d in f.decls {
    if let EnumDecl(ed) = d {
      if let Some(vt) = ed.value_type {
        if text(vt.name) == "Int" && !ed.variants.is_empty() {
          var open = false
          for v in ed.variants {
            if v.fields != None {
              open = true
            }
          }
          penums[text(ed.name.name)] = if open { "open" } else { text(ed.variants[0].name.name) }
        }
      }
    }
  }
  for d in f.decls {
    let sd = match d {
      StructDecl(s) => s
      _ => continue
    }
    var pd = false
    for id in sd.derive {
      if id.name == b"Proto" {
        pd = true
      }
    }
    if !pd {
      continue
    }
    if !sd.type_params.is_empty() {
      c.error_at(file, "XO0425", sd.name.span, "`derive Proto` needs a struct without type parameters; `${text(sd.name.name)}` has some")
      continue
    }
    if let Some(e2) = c.proto_codec(sd, em, file, penums, poneofs) {
      em = e2
      any = true
      any_proto = true
    }
  }
  for d in f.decls {
    if let EnumDecl(ed) = d {
      var cb = false
      for id in ed.derive {
        if id.name == b"Cbor" {
          cb = true
        }
      }
      if cb {
        if ed.value_type != None || !ed.type_params.is_empty() {
          c.error_at(file, "XO0425", ed.name.span, "`derive Cbor` on an enum needs a plain enum without type parameters; `${text(ed.name.name)}` is a valued or generic one (decision 0527)")
        } else if let Some(e2) = c.cbor_enum_codec(ed, em, cdone, file) {
          em = e2
          any = true
          any_cbor = true
        }
      }
      if ed.value_type != None {
        em = c.valued_enum_methods(file, ed, em)
        any = true
      }
    }
  }
  if !any {
    return ("", [])
  }
  var head: List[Str] = []
  var seen: Map[Str, Bool] = {}
  if any_xml {
    head.push("use std/xml")
    head.push("use std/xmlcodec")
    seen["std/xml"] = true
    seen["std/xmlcodec"] = true
  }
  if any_yaml {
    head.push("use std/yaml")
    seen["std/yaml"] = true
  }
  if any_proto {
    head.push("use std/protobuf")
    seen["std/protobuf"] = true
  }
  if any_cbor {
    head.push("use std/cbor")
    seen["std/cbor"] = true
  }
  for u in f.imports {
    let p = text(u.path)
    if u.go || u.c || seen.contains(p) {
      continue
    }
    seen[p] = true
    if let Some(a) = u.alias {
      head.push("use ${p} as ${text(a.name)}")
    } else {
      head.push("use ${p}")
    }
  }
  var spans: List[Span] = []
  for _ in head {
    spans.push(no_span())
  }
  (head.join("\n") + "\n" + em.lines.join("\n") + "\n", spans + em.spans)
}

/// Points each call of xml.encode_value[T] and xml.decode[T] at the
/// function `derive Xml` generated for T (a call of an ordinary function,
/// so no backend knows about it); XO0427 for a T that is not a struct
/// deriving Xml, or is a type parameter. Only the calls from index
/// `from` on: check_lazy rewrites the calls of a body it checks after
/// the whole-program passes (a skipped module's, XO_CHK_CACHE=auto).
fn (var c: Checker) rewrite_xml_calls(from: Int) {
  for (key, call, fo, file) in c.xml_calls[from..] {
    let ci = match c.call_infos.get(key) {
      Some(x) => x
      None => continue
    }
    let tp = c.objs[fo].tparams[0]
    let t = c.resolve(ci.subst.get(tp) ?? c.bad_ty)
    if c.is_bad(t) {
      continue
    }
    let sp = parser.expr_span(call)
    // (the call's file is its own: report by the span in the current file
    // only for a call in the program's main file)
    let fname = text(c.objs[fo].name)
    let mpath = c.mods[c.objs[fo].module].path
    let cbor = mpath == "std/cbor"
    var dname = "Xml"
    if cbor {
      dname = "Cbor"
    } else if mpath == "std/protobuf" {
      dname = "Proto"
    } else if mpath == "std/yaml" {
      dname = "Yaml"
    }
    if c.tys[t].kind == TyKind.Named && !c.derives(c.tys[t].obj, dname) {
      // the constraint check reported it (XO0404)
      continue
    }
    if c.tys[t].kind != TyKind.Named {
      let d = c.error_at(file, "XO0427", sp, "`${dname.to_lower()}.${fname}` needs a concrete struct that derives ${dname}; `${c.show(t)}` is not one (a type parameter cannot be used: call it where the type is known)")
      c.note(d, "call it where the struct is known, or add `derive ${dname}` to it (decision 0315)")
      continue
    }
    let o = c.tys[t].obj
    let want = if cbor { "cbor_${fname}__${text(c.objs[o].name)}" } else if dname == "Proto" { "proto_${fname}__${text(c.objs[o].name)}" } else { "${dname.to_lower()}_${if fname == "decode" { "decode" } else if fname == "decode_all" { "decode_all" } else if fname == "encode_all" { "encode_all" } else { "encode" }}__${text(c.objs[o].name)}" }
    let g = c.mods[c.objs[o].module].members.get(want.bytes()) ?? -1
    if g < 0 {
      c.error("XO0427", sp, "DEBUG no generated function ${want}")
      continue
    }
    c.call_infos[key] = CallInfo{fn_obj: g, recv: ci.recv, params: ci.params, subst: {}}
    c.fn_calls[key] = g
  }
}
