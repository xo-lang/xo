// Where the running `xo` finds its files (decision 0178 switch point B):
// the binary through Env.program, as os.Executable and
// filepath.EvalSymlinks find it for the Go `xo` (internal/build
// RTPackRoot), and the std sources of a release archive, lib/xo/std
// beside the binary's bin directory. One place for xo1 and every command
// of compiler/cli.

/// The running binary, absolute with its symbolic links followed:
/// Env.program as the program was started, a name without a slash looked
/// up in $PATH as exec does, a relative path joined to $PWD. "" when it
/// cannot be found.
pub fn executable(env: Env, fs: Fs) -> Str uses (env, fs.read) {
  var p = env.program()
  if p.is_empty() {
    return ""
  }
  // Windows: argv[0] as typed, with \ separators (cmd.exe passes
  // C:\x\bin\xo.exe, or xo for a name found on %PATH%)
  if is_windows_target() {
    p = p.replace("\\", "/")
  }
  if !p.contains("/") {
    p = in_path(env, fs, p)
    if p.is_empty() {
      return ""
    }
  }
  if !is_rooted(p) {
    let wd = fs.cwd_path().ok() ?? env.get("PWD") ?? ""
    if wd.is_empty() {
      return clean(p)
    }
    p = join(wd, p)
  }
  eval_links(fs, clean(p))
}

/// The std sources the checker reads: $XO_STD, else lib/xo/std of an
/// installed layout (bin/xo beside lib/), else std beside the binary or
/// in its parent directory (a release archive's bin/xo beside std/, as
/// scripts/release.sh lays it out, or a binary built into the
/// repository's .tools or bin), else "std" in the working directory.
pub fn std_dir(env: Env, fs: Fs) -> Str uses (env, fs.read) {
  let e = env.get("XO_STD") ?? ""
  if !e.is_empty() {
    return e
  }
  let exe = executable(env, fs)
  if !exe.is_empty() {
    let d = parent_dir(exe)
    for cand in [join(d, "../lib/xo/std"), join(d, "std"), join(d, "../std")] {
      if fs.exists(join(cand, "prelude.xo")).ok() ?? false {
        return cand
      }
    }
  }
  "std"
}

/// exec.LookPath for a name without a slash: the first file of that name
/// in a $PATH directory; on Windows also the name with each extension of
/// %PATHEXT% when it has none (cmd.exe runs `xo` as xo.exe and passes
/// `xo` as the program name).
fn in_path(env: Env, fs: Fs, name: Str) -> Str uses (env, fs.read) {
  let win = is_windows_target()
  let sep = if win { ";" } else { ":" }
  var names = [name]
  if win && !name.contains(".") {
    let pe = env.get("PATHEXT") ?? ""
    for e in (if pe.is_empty() { ".com;.exe;.bat;.cmd" } else { pe }).split(";") {
      if !e.is_empty() {
        names.push(name + e.to_lower())
      }
    }
  }
  for d0 in (env.get("PATH") ?? "").split(sep) {
    let d = d0.trim_prefix("\"").trim_suffix("\"").replace("\\", "/")
    for n in names {
      let p = join(if d.is_empty() { "." } else { d }, n)
      match fs.stat(p) {
        Ok(Some(fi)) => {
          if !fi.is_dir {
            return p
          }
        }
        _ => {}
      }
    }
  }
  ""
}

/// Whether this program was built for Windows.
fn is_windows_target() -> Bool {
  match target.os {
    Windows => true
    Darwin | Linux | Wasi => false
  }
}

/// The path with the links of its last element followed (a release's
/// bin/xo linked from a package manager's bin directory), at most 40
/// times as filepath.EvalSymlinks allows.
fn eval_links(fs: Fs, path: Str) -> Str uses fs.read {
  var p = path
  var n = 0
  while n < 40 {
    let target = match fs.read_link(p) {
      Ok(Some(t)) => t
      _ => return p
    }
    p = if is_rooted(target) { clean(target) } else { join(parent_dir(p), target) }
    n += 1
  }
  p
}

/// The absolute path with the links of every element followed
/// (filepath.EvalSymlinks, and what getcwd returns in that directory:
/// macOS's /var/folders/... is /private/var/folders/...); a relative
/// path, or more than 40 links, is returned cleaned.
pub fn real_path(fs: Fs, path: Str) -> Str uses fs.read {
  if !path.starts_with("/") {
    return clean(path)
  }
  var parts = clean(path).split("/")
  var out = ""
  var i = 0
  var hops = 0
  while i < parts.len() {
    let part = parts[i]
    i += 1
    if part.is_empty() {
      continue
    }
    let p = "${out}/${part}"
    match fs.read_link(p) {
      Ok(Some(t)) => {
        hops += 1
        if hops > 40 {
          return clean(path)
        }
        // the target, then the rest, resolved again from the root
        let next = if t.starts_with("/") { t } else { "${if out.is_empty() { "/" } else { out }}/${t}" }
        parts = clean(next).split("/") + parts[i..]
        out = ""
        i = 0
      }
      _ => out = p
    }
  }
  if out.is_empty() { "/" } else { out }
}

/// p made absolute against the checker's working directory
/// (filepath.Abs), for the commands' messages.
pub fn (c: Checker) abs_path(p: Str) -> Str {
  c.abs(p)
}
