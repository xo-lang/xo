// Loading: the module directories under the named directories, the user
// modules they import (through xo.mod), and the std declaration files, as
// internal/check/load.go does. Paths stay relative to the working
// directory, as the Go checker prints them; an xo.mod above the working
// directory is not looked for.

use github.com/xo-lang/xo/compiler/lexer
use github.com/xo-lang/xo/compiler/parser

/// The checker: its tables (objects.xo), the state of the walk
/// (resolve.xo), and what it recorded.
/// A test body's `x?` on an Option (decision 0347): it fails the test
/// as `x.or_err(msg)?` would.
pub struct TestMissing {
  /// `missing value: ` and the source text of x.
  pub msg: Str
  /// Str's type, the error's type before it converts to Error.
  pub str_ty: Int
}

pub struct Checker {
  fs: Fs
  /// Where the std declaration files are read from.
  std_dir: Str
  pub objs: List[Obj] = []
  /// The std tree's block in objs, tys, esets and evars (Checker.run,
  /// decision 0388): what std_export records
  pub std_block: StdBlock = StdBlock{}
  /// decision 0388 stage 1a-ii (XO_STD_EXPORT=1): std's declarations
  /// from the records in std_export_in (an entry of the back-end cache,
  /// read by the driver) when their fingerprint matches; else declared
  /// and resolved, and their entry left in std_export_out for the driver
  /// to store under std_export_key
  pub std_export_on: Bool = false
  /// decision 0388 stage 3 (XO_SEPCOMP=1): std's facts (stdf's bytes);
  /// the SSA builder makes each std function they name an extern
  /// instead of building its body
  pub sepcomp_facts: Bytes = b""
  /// the facts of std built with concurrency on, for a build whose
  /// builder turns it on (XO_SEPCOMP_FACTS a directory: conc1.stdf);
  /// empty when one file serves both
  pub sepcomp_facts_conc: Bytes = b""
  pub std_export_key: Str = ""
  pub std_export_in: Bytes = b""
  /// stage 2 piece 2: the fingerprint of std_export_in's header when its
  /// stamps held at load (header_holds), "" otherwise (the fingerprint is
  /// then hashed from std's sources as before); the time the driver
  /// started, for the stamps the entry written gets (std_header)
  pub std_header_fp: Str = ""
  pub std_now_ms: Int = 0
  /// the entry's records when the driver loaded std's modules from them
  /// (load_std_record), so run installs them without decoding again
  pub std_record: Option[StdExport] = None
  /// stage 2 pieces 3 and 4: std's trees joined only where needed (the
  /// driver sets it for a separately compiled build, whose SSA lowers no
  /// std body): install_std leaves an object of an unparsed file without
  /// its trees and keeps their counts here (object to (counts, owner
  /// object or -1)); need_tree joins one on demand
  pub trees_lazy: Bool = false
  /// XO_STD_TREES_TEST=1 (the rebuild's test): no tree parsed before
  /// install, every recorded object pending, so the SSA builder meets a
  /// pending tree and the driver's rebuild runs
  pub trees_test_pend: Bool = false
  /// why the records were not used, for XO_CACHE_STATS ("" when used)
  pub std_export_why: Str = ""
  pub tree_pending: Map[Int, (List[Int], Int)] = {}
  /// decision 0428: a record file's declarations parsed one range at a
  /// time (ensure_decl) while the file stays unloaded, its ast.decls
  /// empty; the driver sets it with trees_lazy unless XO_STD_DECL_PARSE=off
  pub decl_parse: Bool = false
  /// the declarations ensure_decl parsed: file to (index to tree)
  pub decl_parsed: Map[Int, Map[Int, parser.Decl]] = {}
  pub std_export_out: Bytes = b""
  pub std_export_used: Bool = false
  /// XO_STD_EXPORT=verify: std declared as usual and its records, when
  /// an entry matches, compared with it; std_export_bad says how they
  /// differ
  pub std_export_verify: Bool = false
  pub std_export_bad: Str = ""
  pub mods: List[Module] = []
  pub mod_index: Map[Str, Int] = {}
  pub files: List[SrcFile] = []
  /// Modules in dependency order: a module after the modules it imports.
  pub order: List[Int] = []
  pub prelude: Int = -1
  roots: List[ModRoot] = []
  /// The root modules of the run, in the order of their directories.
  pub root_mods: List[Int] = []
  /// Why the run cannot be checked here (`use go`, a parse error), or "".
  pub unsupported: Str = ""
  /// The move walk (core 5.3, decision 0300): whether the current path
  /// has ended (a return, break, continue, or a Never call), and the
  /// loops it is inside, innermost last.
  mv_dead: Bool = false
  /// Per file: the files its embed constants embed (decision 0304), and
  /// the program's embedded bytes so far.
  pub embeds: Map[Int, List[EmbedFile]] = {}
  embed_total: Int = 0
  /// The paths each embed.Dir constant holds, by "module\nname"
  /// (XO1511).
  embed_dir_keys: Map[Str, List[Str]] = {}
  mv_frames: List[MvFrame] = []
  /// A directory of the run that could not be listed for a reason other
  /// than not existing or not being readable (an I/O error, such as no
  /// file descriptors left), or "": check_dirs fails with it rather than
  /// check the program without that directory's modules.
  walk_err: Str = ""
  /// The directories (absolute) a command named as DIR/..., whose
  /// directories below check_dirs walks (decision 0345); a directory
  /// named plainly is that directory alone.
  pub walk: List[Str] = []
  /// Every directory given is walked, as DIR/... (the editor's and the
  /// agent tools' checks of a workspace or repository root, decision
  /// 0289).
  pub walk_all: Bool = false
  /// Entries and .xo files the walks of check_dirs have looked at, for
  /// the bound of decision 0345.
  walk_seen: Int = 0
  walk_xo: Int = 0
  /// How many of check_dirs' directories the command line named, or -1
  /// for all: the ones after them are workspace modules (workspace_dirs),
  /// and one with no .xo file of its own is left out, not an error.
  pub named_dirs: Int = -1
  /// Optional SSA builder lowerings turned off, by name ($XO_LOWER,
  /// `-name` entries, comma separated; compiler/ssa lowerings.xo): miscompile
  /// triage inside one commit, as XO_PASSES is for the native passes.
  pub lower_off: List[Str] = []
  /// Functions `xo dev dump ssa --fn=NAME` names (display name, or
  /// module.name): the SSA builder declares each non generic one as a
  /// root, so a function main does not reach is built too.
  pub dump_roots: List[Str] = []
  /// every non generic function of a std module is a root of the build
  /// (decision 0388 stage 1b: std's object, XO_STD_ROOTS=1)
  pub std_roots: Bool = false
  /// Native mode (check.Options.Native): the implementation modules of
  /// the native backends are loaded and checked too (load_native).
  pub native: Bool = false
  /// Lazy runtime bodies (decision 0247): in native mode, the function
  /// bodies of the implementation and runtime modules (Module.native) are
  /// checked when the SSA builder first builds them (check_lazy), not by
  /// run; a build reaches a small part of the runtime. A plain `xo check`
  /// sets it too, unless it checks std itself (decision 0351 addendum,
  /// 2026-10-23); the checker's own runs check every body.
  /// Function bodies of the native modules a lazy run checks lazily
  /// are parsed lazily too (decision 0351 stage 2, on by default;
  /// XO_LAZY_PARSE=off turns it off):
  /// skipped by their braces, parsed when check_lazy forces them.
  pub lazy_parse: Bool = false
  /// xo refs (2026-10-26): a program file's function bodies are parsed
  /// and checked only when their text spells one of these words (the
  /// names looked for), the others keep their signature only: a body that
  /// does not spell a name holds no reference to it, and a check of every
  /// body held 1.9 GB at the xo root. Empty: every body.
  pub body_words: List[Str] = []
  /// Lookups that read declarations only (xo def, doc and symbols by
  /// name, 2026-10-26): no function body is parsed or checked, as if
  /// body_words spelled nothing.
  pub decls_only: Bool = false
  pub lazy: Bool = false
  /// Map and Set as decision 0291's hybrid (every backend since 2026-10-21,
  /// the playground's too; compiler/xo main.xo turns it off for
  /// XO_MAP_LOG=0): the builder's map_type and map.xo read it
  pub map_log: Bool = true
  /// A Map's key side generated once per key type (decision 0372 stage
  /// A; compiler/xo main.xo turns it off for XO_PASSES=-map_core): map.xo
  /// reads it
  pub map_core: Bool = true
  /// Decision 0291's branching (the default since 2026-10-22; compiler/xo
  /// main.xo turns it off for XO_MAP_LOG=1): ssa.Module map_branch
  pub map_branch: Bool = false
  /// asynchronous preemption may replace the loop polls (decision 0318):
  /// a native backend (arm64, amd64), not --race, XO_ASYNC_PREEMPT not 0;
  /// the builder decides per target (darwin and linux)
  pub async_preempt_ok: Bool = false
  /// the LLVM backend's (decision 0318 stage 4): not on Windows, whose
  /// linker defines no section bounds for the program's text
  pub async_preempt_llvm: Bool = false
  /// no preemption polls in loops (decision 0286 step 3): `--no-preempt`
  /// or XO_PREEMPT_POLLS=off, for tight loop benchmarks; a task that
  /// loops without calling the runtime can then starve its worker
  pub no_preempt: Bool = false
  /// a deterministic run (decision 0350): `xo run --seed`; the builder
  /// decides native/llrt/det.built() true, so the runtime's det branches
  /// are built (one worker, a seeded pick at scheduling points), and
  /// loops get no preemption polls
  /// The settings --release presets, as given (decision 0354): -1 when
  /// not given (the build's preset), else 0 or 1. The SSA builder reads
  /// them (debug_contracts_on, dbg_on, error_args_on, trace_on).
  pub set_debug_contracts: Int = -1
  pub set_dbg: Int = -1
  pub set_error_args: Int = -1
  pub set_trace: Int = -1
  /// Whether the program carries DWARF (decision 0355, 0354's addendum):
  /// a call of native/llrt/dwline.built() is this, so a build without
  /// debug info (--release's default, -s) neither builds nor links the
  /// DWARF readers, which could find nothing.
  pub dwarf: Bool = true
  /// --pack-lists (decision 0369): sized integer lists keep their width
  pub pack_lists: Bool = false
  /// --inline-str (decision 0370): a call of native/llrt/inlstr.built()
  /// is this, and the arm64 backend keeps a short Str's text in its words
  pub inline_str: Bool = false
  pub det: Bool = false
  /// --race (decision 0273): set by the driver; on windows the builder
  /// declares std/native/llrt/cabi_race.xo's exports, the functions the
  /// instrumented code calls
  pub race: Bool = false
  /// The functions of the native modules whose bodies run left to
  /// check_lazy (true), and those it checked (false).
  pub lazy_fns: Map[Int, Bool] = {}
  /// The functions of skipped modules checked before the whole-program
  /// passes (their entries' eager lists, check_module): the builder may
  /// build these from source without the module falling back.
  pub eager_fns: Map[Int, Bool] = {}
  /// The module check cache (modcache.xo): its directory ("" off), the
  /// flags in its keys, the program modules' keys, the modules skipped
  /// (their bodies lazy) and their entries.
  pub mod_cache_dir: Str = ""
  pub mod_flags: Str = ""
  pub mod_keys: Map[Int, Str] = {}
  pub mod_skip: Map[Int, Bool] = {}
  /// XO_BACKEND_CACHE=verify: every module checked, its entry compared
  /// after the build (compiler/xo bcache.xo)
  pub mod_verify: Bool = false
  /// XO_CHK_CACHE=1: modules with an entry are skipped (opt in)
  pub mod_skip_on: Bool = false
  /// XO_CHK_CACHE=auto: a module is skipped only when its entry says
  /// every body of it the last full build built had a front end cache
  /// entry (ModEntry.fe_complete), so no body of it is built from source
  /// after the whole-program passes; mod_noskip names modules (paths)
  /// checked in full regardless (the driver's fallback)
  pub mod_skip_auto: Bool = false
  pub mod_noskip: Map[Str, Bool] = {}
  /// The bodies checked read the inferred effects of a function of
  /// another module (effect_reads_across_modules): skipping is unsound,
  /// the driver checks again without it
  pub skip_unsafe: Bool = false
  mod_entries: Map[Int, ModEntry] = {}
  /// $XO_LLRT_C: the runtime modules (or `all`) loaded from their C path,
  /// std/native/llrt/<name>_c.xo, where they have one (load.go
  /// LLRTUsesC; decisions 0193, 0206).
  pub llrt_c: List[Str] = []
  /// Modules a name lookup reads that the program may not import (the
  /// agent tools' resolver and `xo vet` of a std directory, decision
  /// 0289): `std/NAME`, `native/NAME`, and `native/llrt/NAME`, loaded
  /// with the program's modules, not roots.
  pub preload: List[Str] = []
  /// Std and runtime modules (paths, as preload's, found by mod_index) whose function bodies
  /// are checked too, as a program's: `xo refs` of a std or runtime name
  /// finds the calls inside them (otherwise std bodies are not checked).
  pub check_bodies_of: List[Str] = []
  /// The runtime directory (std/native/llrt) as what it is, one module
  /// per file loaded by imports, never one directory module whose names
  /// collide: the editor's and the agent tools' checks (xo def, refs) set
  /// it; xo check and vet of that directory keep loading it as a
  /// directory.
  pub runtime_files: Bool = false
  /// Directories find_module_dirs skips (absolute): the agent tools'
  /// check of a root leaves out a module whose missing binding stopped
  /// the previous check (agent.xo agent_session).
  pub exclude_dirs: List[Str] = []
  /// find_module_dirs walks `testdata` directories too (`xo refs
  /// --testdata`: the program goldens under internal/*/testdata).
  pub walk_testdata: Bool = false
  /// A walked module (walk_all, below a root) is checked only when one of
  /// its .xo files holds one of these texts (xo refs: the last segment of
  /// each name looked for; a module that does not spell the name cannot
  /// refer to it, and the one declaring it does). Empty: every one.
  pub testdata_words: List[Str] = []
  /// The module roots a walk left out because a module checked before
  /// them has their module path: (root, path, the root kept).
  pub same_path: List[(Str, Str, Str)] = []
  /// check_dirs checks one module of each module path and names the others
  /// (same_path): the editor's and the agent lookups' checker, and xo
  /// check's, vet's and query's (which check the others on their own).
  pub split_same_path: Bool = false
  /// The `testdata` directories find_module_dirs left out, as it found
  /// them, so a lookup at a root can say what it did not check.
  pub testdata_skipped: List[Str] = []
  /// The main modules whose requirements need a fetch (the reason the
  /// check stops, Checker.unsupported), each found in one pass: a lookup
  /// at a root leaves them out and checks again, as for bind_misses.
  pub fetch_dirs: List[Str] = []
  /// How a pattern's names are declared: "let", or "var" while a `var`
  /// pattern statement binds them (decision 0384).
  pat_local: Str = "let"
  /// The std module under test (`xo test --std-module`, decision 0262):
  /// its path (`std/json`, `native/http`, `native/llrt/scan`), or "".
  /// That module's _test.xo file, beside its source, is loaded with it,
  /// and it is the run's root module in place of any directory.
  pub std_test: Str = ""
  /// `xo build` and `xo run` (decision 0348): `_test.xo` files are
  /// neither listed nor parsed, so their declarations, errors, and
  /// imports do not exist for the build.
  pub skip_tests: Bool = false
  /// $XO_CBIND_DIR: where C bindings are cached (cimport.xo), "" for
  /// `<module root>/.xo/cbind`.
  pub cbind_dir: Str = ""
  /// $XO_GOBIND_DIR: the `use go` binding cache, when set; else
  /// `<module root>/.xo/gobind`.
  pub gobind_dir: Str = ""
  /// The bindings the run needs (bindmiss.xo): `use go` packages without
  /// a current binding and `use c` headers, for check_dirs_bound to bind;
  /// and the ones whose binding failed, by key, with the binder's
  /// message, each reported once.
  pub bind_misses: List[BindMiss] = []
  pub bind_failed: Map[Str, Str] = {}
  bind_reported: Set[Str] = #{}
  /// Module versions (path@version) missing from the module cache, for
  /// check_dirs_fetching to fetch; and the ones whose fetch failed, with
  /// the fetcher's problem.
  pub fetch_misses: List[Str] = []
  pub fetch_failed: Map[Str, Problem] = {}
  /// The xo.mod files of checked modules whose `edition` line names an
  /// old edition name (XO1315), by display path.
  edition_aliases: Map[Str, ModRoot] = {}
  /// The vouch lines of the consuming modules (vouch.xo), read once.
  vouches: List[Vouch] = []
  vouches_read: Bool = false
  /// The escape hatches of required module versions met (vouch.xo).
  pub hatches: List[EscapeHatch] = []
  /// The `os` binding and the `for` parameters of each test block, by
  /// test_key (Info.TestOs, Info.TestParams).
  test_os: Map[Int, Int] = {}
  test_params: Map[Int, List[Int]] = {}
  /// The environment and the dependencies of the main modules
  /// (modfile.xo, deps.xo).
  deps: DepState = DepState{}

  // The walk: the current module and file, local scopes (innermost
  // last), the function context, and what it records.
  cur_mod: Int = -1
  cur_file: Int = -1
  path: Str = ""
  scopes: List[Map[Bytes, Int]] = []
  /// Function contexts (stmt.xo); ctx is the current one, -1 outside
  /// bodies.
  ctxs: List[Ctx] = []
  ctx: Int = -1

  // Types (types.xo, infer.xo).
  pub tys: List[Ty] = []
  /// Variables bound since the start (unify), for undo.
  trail: List[Int] = []
  pub unit_ty: Int = -1
  bad_ty: Int = -1
  /// Named types without arguments, by Type object.
  named0: Map[Int, Int] = {}
  /// Effect sets and effect variables (effects.xo): a variable holds
  /// the set it is bound to, -1 while open.
  esets: List[List[EffItem]] = []
  evars: List[Int] = []
  /// Result types of closures whose body never completes: Never when
  /// nothing else determines them (check.go reportAmbiguous).
  never_results: List[Int] = []
  /// Inference variables of explicit type parameters at calls; unbound
  /// ones at the end are XO0402 (check.go typeArgVars).
  type_arg_vars: List[TypeArgVar] = []
  /// Map and Set types reported for their keys, by file and type
  /// (comparable.go keyReported).
  key_reported: Map[Str, Bool] = {}
  /// Functions whose effects are inferred (not pub, no `uses`), their
  /// effects once solved, and the effect obligations (effects.xo).
  inferred_fns: List[Int] = []
  inferred: Map[Int, Flat] = {}
  obligations: List[EffOb] = []
  /// Bound effect sets unify met that must be equal (an effect argument
  /// of a type, a function type inside one): assignable turns them into
  /// obligations both ways at its span (core 6.2).
  eff_eqs: List[(Int, Int)] = []
  /// Effect variables a call instantiated for its own effect parameters
  /// (call_effarg), and the tails a function argument leaves open on
  /// them: a function argument's effects are a lower bound until an
  /// exact use (a type's effect argument) binds the tail.
  /// Indexed by effect variable (ids are never reused): EV_CALL, EV_TAIL,
  /// or 0 (also past the end).
  evar_kind: List[Int] = []
  /// Above zero while a checking site's unify runs (eff_pair).
  eff_track: Int = 0
  /// Above zero while func_assignable unifies parameter types: a tail is
  /// not bound there (a parameter's effects are checked one way, by an
  /// obligation, and must not widen the call's variable).
  no_tail: Int = 0
  /// Functions declared `uses realtime` (realtime.xo).
  pub realtime_fns: List[Int] = []
  /// Calls of function values, by key (realtime.xo).
  value_calls: Map[Int, Bool] = {}
  /// The target of a plain `m[k] = v` (stmt.xo assign), by key.
  map_store: Int = -1
  /// The `m[k]` of a `m[k]?` or `m[k] ?? d` (expr.xo try_expr, binary),
  /// by key, and its operator: XO0410 then suggests `m.get(k)`.
  map_opt: Int = -1
  map_opt_form: Str = ""
  /// A compound assignment `m[k] op= v` (stmt.xo assign): the target's
  /// key, the operator, v's source, and the statement's span, for
  /// XO0410's `update` fix.
  map_upd: Int = -1
  map_upd_op: Str = ""
  map_upd_val: Str = ""
  map_upd_span: Span? = None
  /// Calls whose value an expression statement discards, decided once
  /// effects are solved (XO0209, decision 0258), and how many times
  /// require_mutable ran (a call that mutates is not one of them).
  discards: List[Discard] = []
  mut_calls: Int = 0
  /// Scope and group frames of spawned tasks (stmt.xo).
  frames: List[ScopeFrame] = []
  /// `x?.f` optional chains reported as XO0205, by key of the `x?`.
  safe_navs: Map[Int, Bool] = {}
  /// The index in diags of the XO0205 of each optional chain, by key
  /// (habits.go safeNavDiag).
  safe_nav_diag: Map[Int, Int] = {}
  /// `x?` on an Option directly in a test body (decision 0347), by key
  /// of the `?`.
  pub test_missing: Map[Int, TestMissing] = {}
  /// Calls of declared functions (by key) and their function; calls
  /// that construct a variant or newtype (for XO0408).
  fn_calls: Map[Int, Int] = {}
  ctor_calls: Map[Int, Bool] = {}

  // Value semantics (stage 5, flow.xo).
  /// The calls of declared functions and function values, by key: the
  /// callee, the receiver, and the arguments with their `var` flags
  /// (check.go callInfo).
  pub call_infos: Map[Int, CallInfo] = {}
  /// The local each binding name declares, by name_key of the name (the
  /// declaring half of check.go identObj; uses are name records).
  pub decl_at: Map[Int, Int] = {}
  /// XO0101 renames of local names, extended to their uses at the end.
  renames: List[Rename] = []
  /// Bodies checked, for the flow checks: closures before the body
  /// holding them (check.go bodies).
  bodies: List[BodyRef] = []
  /// Locals never read, collected when their scope closes (XO0110).
  unused: List[Int] = []
  /// Locals reported as lost updates (XO0520), not also as unused.
  lost_vars: Map[Int, Bool] = {}
  /// The files whose parse reported an error: their unused bindings are
  /// not reported (a read inside the part that did not parse is lost;
  /// 2026-10-24: `Some(pub) =>` made two lets "never used", printed before
  /// the parse error)
  parse_failed: Map[Str, Bool] = {}
  /// Calls warned about as split critical sections (XO0804), by key.
  split_warned: Map[Int, Bool] = {}

  // Results.
  pub names: List[NameRec] = []
  /// Name records by file and offset (name_key).
  pub name_at: Map[Int, Int] = {}
  /// Whether a Named type without type arguments is comparable, by Type
  /// object (infer.xo is_eq_type).
  comparable_at: Map[Int, Bool] = {}
  pub types: List[TypeRec] = []
  pub type_at: Map[Int, Int] = {}
  /// Expressions of type Never checked against an expected type, by key.
  never_expr: Map[Int, Bool] = {}
  pub diags: List[Diag] = []

  // What the SSA builder reads (internal/check info.go records, decision
  // 0150), keyed like type_at (key_of: file, span, kind; a pattern's kind
  // is PAT_KIND + its index).
  /// The type of an expression before implicit conversion (info.go
  /// NaturalType): recorded by infer.
  pub nat_at: Map[Int, Int] = {}
  /// the next IntLit inferred has a minus written on it (unary, XO0421)
  pub neg_lit: Bool = false
  /// The variant an identifier, selector, or call constructs (Ctor).
  pub ctor_at: Map[Int, VRef] = {}
  /// The type of a conversion or newtype construction `T(x)` (TypeCall).
  pub type_call_at: Map[Int, Int] = {}
  /// The type of the value a pattern matches (PatType), the variant a
  /// variant pattern names (PatVariant), and the newtype a pattern
  /// unwraps (PatNewtype).
  pub pat_type_at: Map[Int, Int] = {}
  pub pat_variant_at: Map[Int, VRef] = {}
  pub pat_newtype_at: Map[Int, Int] = {}
  /// The receiver and parameter bindings of a function body, by function
  /// object (RecvVar, ParamVars), and the parameter bindings of a closure
  /// by the key of its literal (ClosureParams).
  pub recv_var: Map[Int, Int] = {}
  pub param_vars: Map[Int, List[Int]] = {}
  pub closure_vars: Map[Int, List[Int]] = {}
  /// The type arguments of a method used as a value, by the key of its
  /// selector (check.go rec.subst, Info.RefSubst).
  pub ref_subst: Map[Int, Subst] = {}
  /// The `result` binding of an ensures clause, by file and offset of the
  /// clause (check.go rec.resultVar), and the field bindings of a struct
  /// invariant, by Type object (rec.invVars).
  pub result_vars: Map[Int, Int] = {}
  pub inv_vars: Map[Int, List[Int]] = {}
  seen: Map[Str, Bool] = {}
  /// A generated file (derive.xo), by path: the file whose derives it
  /// expands and the span each of its lines is reported at.
  gen_origin: Map[Str, Str] = {}
  /// The calls of xml.encode_value and xml.decode, rewritten to the
  /// generated function of their type (derive.xo rewrite_xml_calls).
  xml_calls: List[(Int, Expr, Int, Int)] = []
  gen_spans: Map[Str, List[Span]] = {}
  /// Sources that replace the files on disk, by absolute path
  /// (check.CheckOverlay: `xo fix` checks rewritten sources unwritten).
  pub overlay: Map[Str, Bytes] = {}
  /// The parses of std files to reuse (parse_cached): empty in a fresh
  /// checker; a caller checking several programs passes it on.
  pub parse_cache: Map[Str, ParseEntry] = {}
  /// parse_cached's reuses, and the paths it parsed itself (--phase-times
  /// prints them: the parses the prefetch did not cover, on the check's
  /// critical path)
  pub parse_hits: Int = 0
  pub parse_misses: List[Str] = []
  /// The files parsed, by path, and whether as declarations only (the
  /// driver's parse prefetch, compiler/xo bcache.xo).
  pub parsed: List[(Str, Bool)] = []
}

/// The directory the checker reads std from.
pub fn (c: Checker) std_root() -> Str {
  c.std_dir
}

/// A fresh checker reading std declarations from std_dir.
pub fn new_checker(fs: Fs, std_dir: Str) -> Checker {
  var c = Checker{fs: fs, std_dir: std_dir}
  c.unit_ty = c.new_ty(Ty{kind: TyKind.Tuple})
  c.bad_ty = c.new_ty(Ty{kind: TyKind.Bad})
  c
}

/// Loads the modules under dirs and the std modules they need, then
/// resolves every user module. Errors are I/O failures of the named
/// directories, as in check.Check.
pub fn (var c: Checker) check_dirs(dirs: List[Str]) -> () ! Str uses fs.read {
  c.load_prelude()
  if c.prelude < 0 {
    return Err(c.prelude_missing())
  }
  if !c.std_test.is_empty() {
    return c.check_std_test()
  }
  if c.std_roots {
    // decision 0388 1b: std's object holds every std module, whether the
    // program imports it or not
    for e in c.list_dir(c.std_dir) {
      let n = e.name.trim_suffix(".xo")
      if !e.is_dir && e.name.ends_with(".xo") && !e.name.ends_with("_test.xo") && !(n is "prelude" | "go") {
        let _m = c.load_std(n)
      }
    }
  }
  for d in dirs {
    let st = c.fs.stat(d).ok() ?? None
    match st {
      Some(info) => {
        if !info.is_dir {
          return Err("${d} is not a directory (a module is a directory, core 1.1)")
        }
      }
      None => return Err("stat ${d}: no such file or directory")
    }
  }
  var module_dirs: List[Str] = []
  for (di, d) in dirs.indexed() {
    if c.runtime_files && !c.std_dir.is_empty() && c.abs(clean(d)) == c.abs(join(join(c.std_dir, "native"), "llrt")) {
      // the runtime directory itself: each file is its own module
      // (native/llrt/pool), checked with its body, never one directory
      // module whose names collide
      for e in c.list_dir(clean(d)) {
        if !e.is_dir && e.name.ends_with(".xo") && !e.name.ends_with("_test.xo") && !e.name.ends_with("_c.xo") {
          let p = "native/llrt/${e.name.trim_suffix(".xo")}"
          if !c.preload.contains(p) {
            c.preload.push(p)
          }
          if !c.check_bodies_of.contains(p) {
            c.check_bodies_of.push(p)
          }
        }
      }
      continue
    }
    let cd = clean(d)
    if c.walk_all || c.walk.contains(c.abs(cd)) {
      c.walk_seen = 0
      c.walk_xo = 0
      c.find_module_dirs(cd, true, module_dirs)
      if c.walk_seen > MAX_WALK_ENTRIES || c.walk_xo > MAX_WALK_XO {
        return Err(walk_limit_error(if cd == "/" { "/..." } else { "${cd}/..." }))
      }
    } else if c.list_dir(cd).any(fn(e) { !e.is_dir && e.name.ends_with(".xo") }) {
      if !module_dirs.contains(cd) {
        module_dirs.push(cd)
      }
    } else if c.walk_err.is_empty() && (c.named_dirs < 0 || di < c.named_dirs) {
      return Err(no_sources_error(cd))
    }
  }
  if !c.walk_err.is_empty() {
    return Err(c.walk_err)
  }
  if c.walk_all && !c.testdata_words.is_empty() {
    var kept: List[Str] = []
    for d in module_dirs {
      if c.dir_spells(d, c.testdata_words) {
        kept.push(d)
      }
    }
    module_dirs = kept
  }
  module_dirs = module_dirs.sort()
  // a walk of a root that holds two modules with one module path (copies
  // of a program, bench/xo/v0.4 and bench/paper/v0.3's example.com/notes)
  // checks the first only: load_dir finds a path's module by the path, so
  // the second's files were never read and their references missing
  // without a word (2026-10-26). The others are named (same_path), for a
  // checker that asks (split_same_path): the lookups report them, and xo
  // check, vet and query check each on its own (cli/core load_mode_cached).
  if c.split_same_path {
    var by_path: Map[Str, Str] = {}
    var kept: List[Str] = []
    for d in module_dirs {
      let p = c.module_path_for(d)
      match by_path.get(p) {
        Some(first) => {
          let (root, mpath) = match c.find_mod_root(d) {
            Some(r) => (r.dir, r.path)
            None => (d, p)
          }
          let first_root = match c.find_mod_root(first) {
            Some(r) => r.dir
            None => first
          }
          if !c.same_path.any(fn(x) { x.0 == root }) {
            c.same_path.push((root, mpath, first_root))
          }
        }
        None => {
          by_path[p] = d
          kept.push(d)
        }
      }
    }
    module_dirs = kept
  }
  // resolve the requirements of every main module before loading, so
  // imports of required modules find their selected versions
  for dir in module_dirs {
    if let Some(r) = c.find_mod_root(dir) {
      // which modules need a fetch, each of them: the first reason stays
      let first = c.unsupported
      c.unsupported = ""
      c.resolve_deps(r)
      if !c.unsupported.is_empty() && !c.fetch_dirs.contains(r.dir) {
        c.fetch_dirs.push(r.dir)
      }
      if !first.is_empty() {
        c.unsupported = first
      }
    }
  }
  for dir in module_dirs {
    let m = c.load_dir(dir)
    c.mods[m].root = true
    c.root_mods.push(m)
  }
  if !c.walk_err.is_empty() {
    return Err(c.walk_err)
  }
  for p in c.preload {
    if p.starts_with("native/llrt/") {
      c.load_runtime_module(p)
    } else if p.starts_with("std/") {
      c.load_std(p.trim_prefix("std/"))
    } else if p.starts_with("native/") {
      // an implementation module loads with its std module (load_native,
      // in native mode), and when named here (xo def native/prelude.f,
      // prelude.f) in any mode; an intrinsics module (native/rtcrypto) by
      // itself
      let sm = c.load_std(p.trim_prefix("native/"))
      if sm < 0 {
        c.load_native_rt(p)
      } else if !c.native {
        let _m = c.load_impl(c.mods[sm].path)
      }
    }
  }
  if c.native {
    c.load_native()
  } else {
    c.load_go_compiled()
  }
  if c.unsupported.is_empty() {
    c.run()?
  }
  if c.bodies_filtered() {
    c.empty_lazy_bodies()
  }
}

/// Whether function bodies are parsed and checked only when they spell
/// one of body_words (none with decls_only).
pub fn (c: Checker) bodies_filtered() -> Bool {
  c.decls_only || !c.body_words.is_empty()
}

/// body_words: the function bodies still unparsed after
/// the check (declarations the check did not reach: a duplicate, a module
/// that stopped) left empty, so no later reader meets the lazy parse's
/// marker; none of them was checked, so none holds a resolved reference.
fn (var c: Checker) empty_lazy_bodies() {
  for f in 0..c.files.len() {
    let n = c.files[f].ast.decls.len()
    for i in 0..n {
      if let parser.Decl.FnDecl(d: fd) = c.files[f].ast.decls[i] {
        if fd.lazy.is_some() {
          var nf = fd
          nf.body = Some(parser.Block{span: fd.span})
          nf.lazy = None
          c.files[f].ast.decls[i] = parser.Decl.FnDecl(d: nf)
        }
      }
    }
  }
}

/// check_dirs for a std module under test (std_test): loads it, with
/// its test file, and the implementation modules, then makes it the root
/// module, so its tests run with private access (decision 0262).
fn (var c: Checker) check_std_test() -> () ! Str uses fs.read {
  let p = c.std_test
  if p.starts_with("native/llrt/") {
    c.load_runtime_module(p)
  } else if p.starts_with("native/") {
    // the implementation module loads with the std module it implements
    c.load_std(p.trim_prefix("native/"))
  } else {
    c.load_std(p.trim_prefix("std/"))
  }
  if c.native {
    c.load_native()
  } else {
    c.load_go_compiled()
  }
  let m = match c.mod_index.get(p) {
    Some(m) => m
    None => return Err("std module ${p} not found in ${c.std_dir}")
  }
  c.mods[m].root = true
  c.root_mods.push(m)
  if c.unsupported.is_empty() {
    c.run()?
  }
}

/// Parses the test file of module m into it when m is the std module
/// under test: file is m's source (`std/native/llrt/scan.xo`), the test
/// file is beside it (`scan_test.xo`; a runtime module loaded from its C
/// path, scan_c.xo, has the same test file).
fn (var c: Checker) load_std_tests(m: Int, file: Str) {
  if c.std_test.is_empty() || c.mods[m].path != c.std_test {
    return
  }
  let name = "${file.trim_suffix(".xo").trim_suffix("_c")}_test.xo"
  if let Some(src) = c.fs.read("${c.std_dir}/${name.trim_prefix("std/")}").ok() {
    c.parse_into(m, name, src, false)
  }
}

/// Appends dir and every directory below it that holds .xo files,
/// skipping testdata, dot, underscore (decision 0210), and vendor
/// directories below the top.
fn (var c: Checker) find_module_dirs(dir: Str, top: Bool, var out: List[Str]) {
  if c.walk_seen > MAX_WALK_ENTRIES || c.walk_xo > MAX_WALK_XO {
    return
  }
  let entries = c.list_dir(dir)
  c.walk_seen += entries.len()
  var has_xo = false
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") && !(c.skip_tests && e.name.ends_with("_test.xo")) {
      has_xo = true
      c.walk_xo += 1
    }
  }
  if has_xo && !out.contains(dir) {
    out.push(dir)
  }
  for e in entries {
    if !e.is_dir {
      continue
    }
    let sub = join(dir, e.name)
    if e.name == "testdata" && c.walk_testdata {
      // walked as asked: its modules are checked with the others
    } else if walk_skips(e.name) {
      if e.name == "testdata" {
        c.testdata_skipped.push(sub)
      }
      continue
    }
    // the std tree of this checker (a checkout's std/ under a workspace
    // root): its modules load as std, never as program directories
    if !c.std_dir.is_empty() && c.abs(sub) == c.abs(c.std_dir) {
      continue
    }
    // the runtime (std/native/llrt): one module per file, loaded by the
    // imports that name them (native/llrt/pool); as one directory module
    // their names collide (pool.park_wait, poll.park_wait)
    if c.runtime_files && !c.std_dir.is_empty() && c.abs(sub) == c.abs(join(join(c.std_dir, "native"), "llrt")) {
      continue
    }
    if !c.exclude_dirs.is_empty() && c.exclude_dirs.contains(c.abs(sub)) {
      continue
    }
    c.find_module_dirs(sub, false, out)
  }
}

/// Whether one of the .xo files directly in dir holds one of words.
fn (var c: Checker) dir_spells(dir: Str, words: List[Str]) -> Bool uses fs.read {
  for e in c.list_dir(dir) {
    if e.is_dir || !e.name.ends_with(".xo") {
      continue
    }
    // xo:allow XO0903 a file it cannot read is checked, as without the filter
    let b = c.fs.read(join(dir, e.name)).ok() ?? return true
    for w in words {
      if spells_ident(b, w) {
        return true
      }
    }
  }
  false
}

/// Whether src holds w as a whole identifier: not inside a longer one
/// (`decode` in `json.decode(`, not in `decode_all` or `xdecode`). An
/// empty w is in every text.
pub fn spells_ident(src: Bytes, w: Str) -> Bool {
  let wb = w.bytes()
  let m = wb.len()
  if m == 0 {
    return true
  }
  let n = src.len()
  let f = wb[0]
  var i = 0
  while i + m <= n {
    if src[i] == f {
      var j = 1
      while j < m && src[i + j] == wb[j] {
        j += 1
      }
      if j == m && (i == 0 || !ident_byte(src[i - 1])) && (i + m == n || !ident_byte(src[i + m])) {
        return true
      }
    }
    i += 1
  }
  false
}

fn ident_byte(c: UInt8) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

/// walk_skips reports whether a DIR/... walk skips the directory named
/// name, as the go command does: testdata, vendor (with or without
/// modules.txt: vendored code is checked only when named), and names
/// starting with `.` or `_` (decision 0210 and its 2026-10-23 notes:
/// every walk, parse and fmt too).
pub fn walk_skips(name: Str) -> Bool {
  name == "testdata" || name == "vendor" || name.starts_with(".") || name.starts_with("_")
}

/// The most .xo files, and directory entries, a DIR/... walk looks at
/// before it refuses (decision 0345; agent.xo's --dir bound): the xo
/// checkout has about 1,800 .xo files, and `xo build /...` or
/// `$HOME/...` would load every tree below.
pub const MAX_WALK_XO = 6000
pub const MAX_WALK_ENTRIES = 60000

/// The error of a walk of pattern (DIR/...) over the bound.
pub fn walk_limit_error(pattern: Str) -> Str {
  "${pattern} holds more than ${MAX_WALK_XO} .xo files or ${MAX_WALK_ENTRIES} entries, the limit of a DIR/... walk (decision 0345): name a module or repository directory"
}

/// The error of a directory named plainly that holds no .xo file.
pub fn no_sources_error(dir: Str) -> Str {
  "${dir} has no .xo files: a directory means that directory alone; ${if dir == "/" { "/..." } else { "${dir}/..." }} covers the directories below it (decision 0345)"
}

/// The entries of dir: none when it does not exist or cannot be read
/// (Denied), and none with walk_err set for any other failure, so a
/// transient error never drops a directory's modules silently (an
/// `xo def` at a repository root answered "no declaration" for the
/// compiler's own names under memory pressure, 2026-10-21).
fn (var c: Checker) list_dir(dir: Str) -> List[FileInfo] uses fs.read {
  let (es, err) = listing(c.fs.read_dir(dir), dir)
  if !err.is_empty() && c.walk_err.is_empty() {
    c.walk_err = err
  }
  es
}

/// A directory listing r of the walk: its entries; none and no error when
/// dir is gone, unreadable (Denied), or not a directory; none and the
/// error for any other failure.
fn listing(r: Result[List[FileInfo], FsErr], dir: Str) -> (List[FileInfo], Str) {
  match r {
    Ok(es) => (es, "")
    Err(NotFound(_)) | Err(Denied(_)) | Err(NotDir(_)) => ([], "")
    Err(e) => ([], "read ${dir}: ${e}")
  }
}

/// A module source read r: the bytes; None and no error for a file
/// removed since the listing; None and the error for any other failure
/// (checking the module without the file would answer for a different
/// program).
fn source_bytes(r: Result[Bytes, FsErr], p: Str) -> (Bytes?, Str) {
  match r {
    Ok(b) => (Some(b), "")
    Err(NotFound(_)) => (None, "")
    Err(e) => (None, "read ${p}: ${e}")
  }
}

fn (var c: Checker) load_prelude() {
  c.prelude = c.load_std("prelude")
  if c.prelude >= 0 {
    c.mods[c.prelude].is_prelude = true
  }
  // std/testing provides the predeclared `os`, `expect`, and `testing`
  // of test blocks (core 9.2), which a build or run (skip_tests) does not
  // read (parse_into, decision 0389): it imports std/http, sql, log and
  // json, whose implementations and runtime modules a program without
  // them never needs (llvm-fib parsed 195 std files, 59 of which hold
  // code it runs)
  if !c.skip_tests {
    c.load_std("testing")
  }
}

/// Why the std directory cannot be checked against, or "": no
/// prelude.xo in it (xo1 run outside a release layout with no $XO_STD
/// falls back to ./std, which TestCLIPattern hit on 2026-10-13), or a
/// prelude lacking a core type every check names (an $XO_STD naming
/// another directory; checked by run after the declarations, which fill the
/// members). An error of check_dirs, which every command
/// prints, rather than a fault in prelude_obj during the run.
fn (c: Checker) prelude_missing() -> Str {
  let hint = "set XO_STD to the std directory, or run xo from a release archive, bin/xo beside std/ (or lib/xo/std)"
  if c.prelude < 0 {
    return "std library not found: no ${join(c.std_dir, "prelude.xo")} (${hint})"
  }
  var lacks: List[Str] = []
  for name in ["Bool", "Int", "Never", "Option", "Result", "Str"] {
    let ok = match c.mods[c.prelude].members.get(name.bytes()) {
      Some(o) => c.objs[o].kind == ObjKind.Type
      None => false
    }
    if !ok {
      lacks.push(name)
    }
  }
  if lacks.is_empty() {
    return ""
  }
  "std library ${c.std_dir} does not match this xo: its prelude.xo lacks ${lacks.join(", ")} (${hint})"
}

/// Loads std/<name>.xo, or returns -1 when there is none.
fn (var c: Checker) load_std(name: Str) -> Int {
  let path = "std/${name}"
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let src = c.fs.read("${c.std_dir}/${name}.xo").ok() ?? None
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module(path, name, "std", true)
  c.mods[m].std_tree = true
  c.parse_into(m, "std/${name}.xo", data, true)
  c.load_std_tests(m, "std/${name}.xo")
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// The std modules the Go backend compiles from their native
/// implementation (decision 0312): std/go_compiled.txt, one name a line
/// (`path`), `#` comments.
fn (c: Checker) go_compiled() -> List[Str] {
  let data = c.fs.read("${c.std_dir}/go_compiled.txt").ok() ?? None
  let text = match data {
    Some(b) => b.to_str() ?? ""
    None => return []
  }
  var out: List[Str] = []
  for l in text.split("\n") {
    let t = l.trim()
    if !t.is_empty() && !t.starts_with("#") {
      out.push(t)
    }
  }
  out
}

/// load_native for the Go backend: the implementations of the std
/// modules in go_compiled only, until no new one appears (decision 0312).
fn (var c: Checker) load_go_compiled() {
  let names = c.go_compiled()
  if names.is_empty() {
    return
  }
  var done: Map[Str, Bool] = {}
  while {
    var todo: List[Str] = []
    for m in c.mods {
      if m.is_std && !done.contains(m.path) && m.path.starts_with("std/") && names.contains(m.path.trim_prefix("std/")) {
        todo.push(m.path)
      }
    }
    if todo.is_empty() {
      return
    }
    for path in todo.sort() {
      done[path] = true
      let name = path.trim_prefix("std/")
      let src = c.fs.read("${c.std_dir}/native/${name}.xo").ok() ?? None
      let data = match src {
        Some(b) => b
        None => continue
      }
      let m = c.new_module("native/${name}", name, "std/native", false)
      c.mods[m].std_tree = true
      c.mods[m].native = true
      c.mods[m].implements = path
      c.parse_into(m, "std/native/${name}.xo", data, false)
      c.mods[m].state = 1
      c.load_imports(m)
      c.mods[m].state = 2
      c.order.push(m)
    }
  }
}

/// Loads the implementation modules of the native backends (load.go
/// loadNative, decision 0074): std/native/<name>.xo for the prelude and
/// every std module loaded so far, until no new std module appears (an
/// implementation may import more). They are checked like user modules.
fn (var c: Checker) load_native() {
  var done: Map[Str, Bool] = {}
  while {
    var todo: List[Str] = []
    for m in c.mods {
      if m.is_std && !done.contains(m.path) && m.path.starts_with("std/") {
        todo.push(m.path)
      }
    }
    if todo.is_empty() {
      return
    }
    for path in todo.sort() {
      done[path] = true
      let _m = c.load_impl(path)
    }
  }
}

/// The implementation module std/native/<name>.xo of the std module path
/// (std/<name>), loaded once; -1 when there is none. load_native loads
/// them in order, and an implementation module's `use native/<name>`
/// (decision 0319) loads that one at once: loaded as an intrinsics module
/// instead, its functions were runtime calls (`rt.new_stream`) when it
/// sorted after the importer.
fn (var c: Checker) load_impl(path: Str) -> Int {
  let name = path.trim_prefix("std/")
  if let Some(m) = c.mod_index.get("native/${name}") {
    return m
  }
  let src = c.fs.read("${c.std_dir}/native/${name}.xo").ok() ?? None
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module("native/${name}", name, "std/native", false)
  c.mods[m].std_tree = true
  c.mods[m].native = true
  c.mods[m].implements = path
  c.parse_into(m, "std/native/${name}.xo", data, false)
  c.load_std_tests(m, "std/native/${name}.xo")
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// Loads the runtime module std/native/llrt/<name>.xo (load.go
/// loadRuntimeModule, decision 0180): part of the native runtime written
/// in Xo, checked and compiled with the program like an implementation
/// module (it implements no std module). -1 when there is none.
fn (var c: Checker) load_runtime_module(path: Str) -> Int {
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let name = path.trim_prefix("native/llrt/")
  var file = "${path}.xo"
  var src: Bytes? = None
  if c.llrt_c.contains(name) || c.llrt_c.contains("all") {
    // the C path of a ported part of the runtime, kept selectable until
    // the Xo one meets the bar (decisions 0180, 0193)
    src = c.fs.read("${c.std_dir}/${path}_c.xo").ok()
    if src.is_some() {
      file = "${path}_c.xo"
    }
  }
  if src.is_none() {
    src = c.fs.read("${c.std_dir}/${file}").ok()
  }
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module(path, name, "std/native/llrt", false)
  c.mods[m].std_tree = true
  c.mods[m].native = true
  c.parse_into(m, "std/${file}", data, false)
  c.load_std_tests(m, "std/${file}")
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// Loads the intrinsics module of the native backends, std/native/rt.xo
/// (load.go loadNativeRT): bodiless declarations lowered to calls of the
/// C runtime. -1 when there is none.
fn (var c: Checker) load_native_rt(path: Str) -> Int {
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let src = c.fs.read("${c.std_dir}/${path}.xo").ok() ?? None
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module(path, path.trim_prefix("native/"), "std/native", true)
  c.mods[m].std_tree = true
  c.parse_into(m, "std/${path}.xo", data, true)
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

fn (var c: Checker) new_module(path: Str, name: Str, dir: Str, is_std: Bool) -> Int {
  let m = c.mods.len()
  let obj = c.objs.len()
  c.objs.push(Obj{kind: ObjKind.Module, name: name.bytes(), module: m})
  c.mods.push(Module{path: path, name: name, dir: dir, is_std: is_std, obj: obj})
  c.mod_index[path] = m
  m
}

/// Parses a file into module m. The parser's diagnostics join the run's;
/// after errors the tree is the one the Go parser recovers (soft errors,
/// decision 0087, and resynchronization after hard ones), which is
/// checked as usual.
fn (var c: Checker) parse_into(m: Int, path: Str, src: Bytes, sig: Bool) {
  let (r, ast) = c.parse_file_ast(path, src, sig)
  let f = c.files.len()
  c.files.push(SrcFile{path: path, module: m, ast: ast, iface: r.iface, is_test: path.ends_with("_test.xo"), sig: sig, src: src})
  c.mods[m].files.push(f)
  if !c.mods[m].is_std && !sig {
    c.add_derived_file(m, path, f, r)
  }
}

/// The parse of src as path (parse_cached), its diagnostics reported,
/// and its tree with the test blocks cut for a build.
fn (var c: Checker) parse_file_ast(path: Str, src: Bytes, sig: Bool) -> (parser.ParseResult, parser.File) {
  let r = c.parse_cached(path, src, sig)
  c.parsed.push((path, sig))
  c.diags = c.diags + parse_diags(path, r.diags)
  if !r.diags.is_empty() {
    c.parse_failed[path] = true
  }
  var ast = r.file
  if c.skip_tests {
    // a build or run reads no test block (decision 0389, as 0348 reads
    // no _test.xo file): it is neither declared nor checked, so its
    // errors and its std/testing do not exist for the build
    var ds: List[parser.Decl] = []
    var cut = false
    for d in ast.decls {
      if let TestDecl(..) = d {
        cut = true
      } else {
        ds.push(d)
      }
    }
    if cut {
      // the ranges of the declarations kept (a test's range holds only
      // the test), so a range's indexes stay those of ast.decls
      var rs: List[parser.DeclRange] = []
      var k = 0
      for dr in ast.ranges {
        var has_test = false
        for j in k..k + dr.n {
          if let TestDecl(..) = r.file.decls[j] {
            has_test = true
          }
        }
        if !has_test {
          rs.push(dr)
        } else if dr.n != 1 {
          rs = []
          break
        }
        k += dr.n
      }
      ast.decls = ds
      ast.ranges = if rs.is_empty() || k != r.file.decls.len() { [] } else { rs }
    }
  }
  (r, ast)
}

/// Declaration i of record file f parsed alone (decision 0428): the
/// record's range holding it, through parser.parse_decl as ensure_tree's
/// parse would have, kept in decl_parsed while the file stays unloaded.
/// The whole module (ensure_tree) when decl_parse is off, the file has no
/// ranges, or the range does not parse alone.
pub fn (var c: Checker) ensure_decl(f: Int, i: Int) uses fs.read {
  if f < 0 || f >= c.files.len() || !c.files[f].unloaded || i < 0 {
    return
  }
  if let Some(m) = c.decl_parsed.get(f) {
    if m.contains(i) {
      return
    }
  }
  let rs = c.files[f].ast.ranges
  if !c.decl_parse || rs.is_empty() {
    c.ensure_tree(c.files[f].module)
    return
  }
  var k = 0
  for dr in rs {
    if i < k + dr.n {
      if c.files[f].src.is_empty() {
        match c.fs.read(c.source_path(c.files[f].path)) {
          Ok(b) => c.files[f].src = b
          Err(_) => return
        }
      }
      let lazy = !c.files[f].sig && c.parse_lazy_path(c.files[f].path)
      match parser.parse_decl(c.files[f].path.bytes(), c.files[f].src, dr, c.files[f].sig, lazy) {
        Some(ds) => {
          var m = c.decl_parsed.get(f) ?? {}
          for (j, d) in ds.indexed() {
            m[k + j] = d
          }
          c.decl_parsed[f] = m
        }
        None => c.ensure_tree(c.files[f].module)
      }
      return
    }
    k += dr.n
  }
  c.ensure_tree(c.files[f].module)
}

/// std's modules from the records' closure (decision 0388 stage 2 piece
/// 1): every module and file of e.closure made as the loaders would
/// make them, in the record's order (the check order of the run that
/// declared them), with no std file read or parsed: a file holds its
/// path, interface hash and imports; its tree and source come with
/// ensure_tree when something needs them. Runs before the prelude is
/// loaded, so load_std and load_impl find each module made.
pub fn (var c: Checker) load_std_record(e: StdExport) {
  var made: List[Int] = []
  for rec in e.closure {
    if c.mod_index.contains(rec.path) {
      made.push(c.mod_index.get(rec.path) ?? -1)
      continue
    }
    let m = c.new_module(rec.path, rec.name, rec.dir, !rec.native)
    c.mods[m].std_tree = true
    c.mods[m].is_prelude = rec.is_prelude
    c.mods[m].native = rec.native
    c.mods[m].implements = rec.implements
    c.mods[m].from_record = true
    if rec.is_prelude {
      c.prelude = m
    }
    for fr in rec.files {
      let f = c.files.len()
      let z = parser.Pos{offset: 0, line: 0, col: 0}
      c.files.push(SrcFile{path: fr.path, module: m, ast: parser.File{span: Span{start: z, end: z}, name: fr.path.bytes(), ranges: fr.ranges}, sha: fr.sha, iface: fr.iface, is_test: fr.is_test, sig: fr.sig, unloaded: true})
      c.mods[m].files.push(f)
    }
    made.push(m)
  }
  // the imports, once every module they name exists
  for (i, rec) in e.closure.indexed() {
    let m = made[i]
    if m < 0 || !c.mods[m].from_record {
      continue
    }
    for (j, fr) in rec.files.indexed() {
      if j >= c.mods[m].files.len() {
        break
      }
      let f = c.mods[m].files[j]
      var im: Map[Bytes, Import] = {}
      for (k, raw, mp) in fr.imports {
        im[k.bytes()] = Import{module: if mp.is_empty() { -1 } else { c.mod_index.get(mp) ?? -1 }, path: raw.bytes(), used: true}
      }
      c.files[f].imports = im
    }
  }
  for m in made {
    if m >= 0 && c.mods[m].from_record && c.mods[m].state < 2 {
      c.mods[m].state = 2
      c.order.push(m)
    }
  }
}

/// The trees of a module made from a std record (load_std_record): its
/// files read and parsed, once, where a check needs a declaration's
/// tree (install_std's join, const_type) or a body.
pub fn (var c: Checker) ensure_tree(m: Int) uses fs.read {
  if m < 0 || !c.mods[m].from_record || c.mods[m].tree_loaded {
    return
  }
  c.mods[m].tree_loaded = true
  for f in c.mods[m].files {
    if !c.files[f].unloaded {
      continue
    }
    let path = c.files[f].path
    let data = match c.fs.read(c.source_path(path)) {
      Ok(b) => b
      // a file gone since the record: its declarations stay as recorded;
      // the next build's header fails and declares again
      Err(_) => continue
    }
    let (r, ast) = c.parse_file_ast(path, data, c.files[f].sig)
    c.files[f].ast = ast
    c.files[f].src = data
    c.files[f].unloaded = false
    if !c.mods[m].is_std && !c.files[f].sig {
      c.add_derived_file(m, path, f, r)
    }
  }
}

/// The expansion of the `derive Xml` structs of file f (derive.xo) as a
/// file of module m, next to it.
fn (var c: Checker) add_derived_file(m: Int, path: Str, f: Int, r: parser.ParseResult) {
  let (src, spans) = c.expand_derives(f, r.file)
  if src.is_empty() {
    return
  }
  let gpath = "${path}#derive"
  let g = parser.parse_file(gpath.bytes(), src.bytes(), false)
  c.gen_origin[gpath] = path
  c.gen_spans[gpath] = spans
  c.diags = c.diags + parse_diags(gpath, g.diags)
  if !g.diags.is_empty() {
    c.parse_failed[gpath] = true
  }
  let gf = c.files.len()
  c.files.push(SrcFile{path: gpath, module: m, ast: g.file, iface: "${r.iface}#derive", generated: true, src: src.bytes()})
  c.mods[m].files.push(gf)
}

/// One parse of a std file kept for the next checker of the process
/// (decision 0209, std once per process).
pub struct ParseEntry {
  src: Bytes
  sig: Bool
  r: parser.ParseResult
  /// a lazy parse (parse_lazy_path): its bodies skipped
  lazy: Bool = false
}

/// parse_cached parses src, reusing the parse of a std or std/native
/// file with the same bytes from parse_cache (a parse is a function of
/// the path, the bytes, and sig) and adding new ones to it. A process that
/// checks many programs (xo dev goldens' builds, check --each, check
/// --bench) carries parse_cache from one checker to the next.
fn (var c: Checker) parse_cached(path: Str, src: Bytes, sig: Bool) -> parser.ParseResult {
  let lazy = !sig && c.parse_lazy_path(path)
  if let Some(e) = c.parse_cache.get(path) {
    if e.sig == sig && e.src == src && e.lazy == lazy {
      c.parse_hits += 1
      return e.r
    }
  }
  c.parse_misses.push(if sig { "s ${path}" } else { path })
  if !path.starts_with("std/") {
    // a program file's parse is in the cache only when the driver
    // parsed it ahead
    if lazy {
      return parser.parse_file_lazy(path.bytes(), src, sig)
    }
    return parser.parse_file(path.bytes(), src, sig)
  }
  let r = if lazy { parser.parse_file_lazy(path.bytes(), src, sig) } else { parser.parse_file(path.bytes(), src, sig) }
  c.parse_cache[path] = ParseEntry{src: src, sig: sig, r: r, lazy: lazy}
  r
}

/// Whether the file at path is parsed lazily (decision 0351 stage 2): a
/// native module's file in a lazy run with lazy_parse, whose bodies wait
/// for check_lazy anyway (lazy_mod), but not the std module under test,
/// which is checked in full.
pub fn (c: Checker) parse_lazy_path(path: Str) -> Bool {
  if c.bodies_filtered() {
    // std's files too: a std module whose bodies refs checks (its
    // preloads) checks only those that spell a name
    return true
  }
  c.lazy && c.lazy_parse && path.starts_with("std/native/") && (c.std_test.is_empty() || !path.starts_with("std/${c.std_test}/") && path != "std/${c.std_test}.xo")
}

/// A parse of src at path for parse_cache, made ahead of the check (the
/// driver's parse prefetch parses on tasks).
pub fn parse_entry(path: Str, src: Bytes, sig: Bool, lazy: Bool) -> ParseEntry {
  ParseEntry{src: src, sig: sig, r: if lazy { parser.parse_file_lazy(path.bytes(), src, sig) } else { parser.parse_file(path.bytes(), src, sig) }, lazy: lazy}
}

/// Where the checker reads the file it parses as path: std's under the
/// std directory, the rest relative to the working directory.
pub fn (c: Checker) source_path(path: Str) -> Str {
  if path.starts_with("std/") {
    return "${c.std_dir}/${path.trim_prefix("std/")}"
  }
  path
}

/// The diagnostics of the parse of the file at path, as the checker
/// reports them.
pub fn parse_diags(path: Str, ds: List[parser.Diag]) -> List[Diag] {
  var out: List[Diag] = []
  for d in ds {
    var notes: List[DNote] = []
    for n in d.notes {
      var nsp: JSpan? = None
      if let Some(s) = n.span {
        nsp = Some(JSpan{file: path, line: s.start.line, col: s.start.col, end_line: s.end.line, end_col: s.end.col})
      }
      notes.push(DNote{message: lossy_str(n.message), span: nsp})
    }
    var fixes: List[DFix] = []
    for f in d.fixes {
      var edits: List[DEdit] = []
      for e in f.edits {
        edits.push(DEdit{span: JSpan{file: path, line: e.span.start.line, col: e.span.start.col, end_line: e.span.end.line, end_col: e.span.end.col}, replace: lossy_str(e.replace)})
      }
      fixes.push(DFix{title: lossy_str(f.title), edits: edits})
    }
    out.push(Diag{code: d.code, file: path, line: d.span.start.line, col: d.span.start.col, end_line: d.span.end.line, end_col: d.span.end.col, message: lossy_str(d.message), notes: notes, fixes: fixes})
  }
  out
}

/// b as text, with U+FFFD for each invalid byte (as Go's JSON encoding of
/// a message prints it).
fn lossy_str(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = BytesBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write_rune(r)
    i += n
  }
  out.freeze().to_str() ?? ""
}

/// Looks for xo.mod in dir or its parents and registers it (check.go
/// findModRoot; above the working directory only when it is known).
fn (var c: Checker) find_mod_root(dir: Str) -> ModRoot? {
  var d = c.display(dir)
  while {
    let data = c.read_source(join(d, "xo.mod"))
    if let Some(b) = data {
      var path = ""
      var r = ModRoot{path: "", dir: d}
      for (i, line) in scan_lines(b).indexed() {
        let fs = fields(line)
        if fs.len() == 2 && fs[0] == "module" && path.is_empty() {
          path = fs[1]
        }
        if fs.len() == 2 && fs[0] == "edition" && edition_alias_of(fs[1]) != "" {
          // check edition.go: an old name of an edition (XO1315); an
          // unknown edition fails the Go checker's run
          r.alias = fs[1]
          r.alias_line = i + 1
          r.alias_col = (line.find(fs[1]) ?? 0) + 1
        }
      }
      if path.is_empty() {
        return None
      }
      r.path = path
      var known = false
      for x in c.roots {
        if x.path == r.path && x.dir == r.dir {
          known = true
        }
      }
      if !known {
        c.roots.push(r)
      }
      return Some(r)
    }
    match c.up(d) {
      Some(p) => d = p
      None => return None
    }
  }
  None
}

/// The import path of the module in dir.
fn (var c: Checker) module_path_for(dir: Str) -> Str {
  if let Some(r) = c.find_mod_root(dir) {
    let rel = rel_path(r.dir, c.display(dir))
    if rel == "." {
      return r.path
    }
    return "${r.path}/${rel}"
  }
  clean(dir)
}

fn (var c: Checker) load_dir(dir0: Str) -> Int {
  let dir = c.rel_dir(dir0)
  let path = c.module_path_for(dir)
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let (name, _) = local_name(path)
  let m = c.new_module(path, name, dir, false)
  if let Some(r) = c.find_mod_root(dir) {
    c.mods[m].dependency = c.dependency_of(r.dir)
    if !r.alias.is_empty() && c.mods[m].dependency.is_empty() {
      c.edition_aliases[c.rel_dir(join(r.dir, "xo.mod"))] = r
    }
  }
  let entries = c.list_dir(dir)
  var names: List[Str] = []
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") && !(c.skip_tests && e.name.ends_with("_test.xo")) {
      names.push(e.name)
    }
  }
  // files only in the overlay (generated test files, decision 0250)
  if !c.overlay.is_empty() {
    let ad = c.abs(dir).trim_suffix("/")
    for p in c.overlay.keys() {
      if p.ends_with(".xo") && dir_of_path(p) == ad && !(c.skip_tests && p.ends_with("_test.xo")) {
        let n = p.trim_prefix(ad + "/")
        if !names.contains(n) {
          names.push(n)
        }
      }
    }
  }
  for n in names.sort() {
    let p = join(dir, n)
    let src = match c.overlay.get(c.abs(p)) {
      Some(b) => b
      None => {
        let (b, err) = source_bytes(c.fs.read(p), p)
        if !err.is_empty() && c.walk_err.is_empty() {
          c.walk_err = err
        }
        match b {
          Some(x) => x
          None => continue
        }
      }
    }
    c.parse_into(m, p, src, false)
  }
  // embed constants become literals before anything reads the module
  // (decision 0304)
  c.expand_embeds(m)
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// Resolves each file's `use` declarations, loading modules as needed.
fn (var c: Checker) load_imports(m: Int) {
  for f in c.mods[m].files {
    for u in c.files[f].ast.imports {
      if u.path.is_empty() {
        continue
      }
      if u.go {
        c.load_go_import(m, f, u)
        continue
      }
      if u.c {
        c.load_c_import(m, f, u)
        continue
      }
      let upath = u.path.to_str() ?? ""
      let p = clean(upath)
      var imp_name = ""
      if let Some(a) = u.alias {
        imp_name = a.name.to_str() ?? ""
      } else {
        let (name, ok) = local_name(p)
        imp_name = name
        if !ok {
          let d = c.error_at(f, "XO0602", u.span, "import `${p}` needs `as`: `${name}` is not a valid module name")
          if d >= 0 {
            var alt = to_snake(name.bytes())
            let (_, ok2) = local_name(alt)
            if !ok2 || alt.is_empty() {
              alt = "m_${trim_underscores(to_snake(name.bytes()))}"
            }
            c.note(d, "the local name is the last path segment with `-` replaced by `_` (core 4.1)")
            c.fix(d, "add `as ${alt}`", [DEdit{span: JSpan{file: c.files[f].path, line: u.span.end.line, col: u.span.end.col, end_line: u.span.end.line, end_col: u.span.end.col}, replace: " as ${alt}"}])
          }
          imp_name = ""
        }
      }
      var dep = -1
      if p == "std/internal" && !c.internal_visible(m) {
        // std/internal (decision 0214): only std and the toolchain's own
        // modules see it
        dep = -1
      } else if p.starts_with("std/") {
        dep = c.load_std(p.trim_prefix("std/"))
      } else if p.starts_with("native/") {
        // the intrinsics of the native backends: only their
        // implementation modules see them (decision 0074), and other
        // intrinsics modules
        dep = -1
        if p.starts_with("native/llrt/") {
          // a runtime module written in Xo (decision 0180):
          // implementation and runtime modules see it
          if c.mods[m].native {
            dep = c.load_runtime_module(p)
          }
        } else if c.mods[m].native || (c.mods[m].is_std && c.mods[m].path.starts_with("native/")) {
          let name = p.trim_prefix("native/")
          if c.native && c.mods[m].native && c.load_std(name) >= 0 {
            // another std module's implementation (decision 0319), with
            // the std module it implements
            dep = c.load_impl("std/${name}")
          }
          if dep < 0 {
            dep = c.load_native_rt(p)
          }
        }
      } else if let Some(x) = c.mod_index.get(p) {
        dep = x
      } else if let Some(r) = c.owner_root(p) {
        let rel = p.trim_prefix(r.path).trim_prefix("/")
        let dir = join(r.dir, rel)
        let st = c.fs.stat(dir).ok() ?? None
        if let Some(info) = st {
          if info.is_dir {
            dep = c.load_dir(dir)
          }
        }
      }
      if dep >= 0 && !c.mods[m].is_std {
        c.check_deny(m, f, u, p)
      }
      if p != upath {
        // XO0158 already explains the path.
        dep = -1
      } else if dep < 0 && c.unrequired(f, u, p) {
        // reported (or explained on the xo.mod line)
      } else if dep < 0 {
        let d = c.error_at(f, "XO0601", u.span, "module `${p}` not found")
        if p.starts_with("std/") {
          var cands: List[Str] = []
          let entries = c.fs.read_dir(c.std_dir).ok() ?? []
          for e in entries {
            if e.name.ends_with(".xo") && e.name != "prelude.xo" && e.name != "internal.xo" {
              cands.push("std/${e.name.trim_suffix(".xo")}")
            }
          }
          let s = nearest(p, cands.sort())
          if !s.is_empty() {
            c.note(d, "did you mean `${s.join("`, `")}`?")
          }
        }
      } else if c.mods[dep].state == 1 {
        c.error_at(f, "XO0604", u.span, "import cycle: `${c.mods[m].path}` imports `${c.mods[dep].path}`, which imports it back")
        dep = -1
      } else if !c.mods[m].is_std {
        c.check_required(m, f, u, p)
      }
      if imp_name.is_empty() {
        continue
      }
      let key = imp_name.bytes()
      if let Some(prev) = c.files[f].imports.get(key) {
        c.error_at(f, "XO0603", u.span, "`${imp_name}` is already imported by `use ${prev.path.to_str() ?? ""}`")
        continue
      }
      // an import that did not resolve was reported (or explained) and
      // counts as used
      c.files[f].imports[key] = Import{module: dep, path: u.path, used: dep < 0, span: u.span}
    }
  }
}

/// Whether module m may import std/internal (load.go internalVisible,
/// decision 0214): std modules, their native implementations, and the
/// toolchain's own modules (github.com/xo-lang/xo and below).
fn (c: Checker) internal_visible(m: Int) -> Bool {
  let path = c.mods[m].path
  c.mods[m].is_std || c.mods[m].native || path == "github.com/xo-lang/xo" || path.starts_with("github.com/xo-lang/xo/")
}

/// strings.Trim(s, "_").
fn trim_underscores(s: Str) -> Str {
  var t = s
  while t.starts_with("_") {
    t = t.trim_prefix("_")
  }
  while t.ends_with("_") {
    t = t.trim_suffix("_")
  }
  t
}

/// The xo.mod whose module path is the longest prefix of path.
fn (c: Checker) owner_root(path: Str) -> ModRoot? {
  var best: ModRoot? = None
  var best_len = -1
  for r in c.roots {
    if (path == r.path || path.starts_with("${r.path}/")) && r.path.len() > best_len {
      best = Some(r)
      best_len = r.path.len()
    }
  }
  best
}

// ---------------------------------------------------------------------------
// Paths

/// A module's local name from its import path (core 4.1): the last
/// segment with `-` replaced by `_`, skipping a /vN suffix of a remote
/// path; false when that is not an identifier or is a keyword.
fn local_name(path0: Str) -> (Str, Bool) {
  var path = path0
  if is_remote(path) {
    path = major_suffix(path)
  }
  let name = base(path).replace("-", "_")
  if name.is_empty() || lexer.lookup(name) != lexer.Kind.Ident {
    return (name, false)
  }
  let b = name.bytes()
  for i in 0..b.len() {
    let ch = b[i]
    if !(ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (i > 0 && ch >= '0' && ch <= '9')) {
      return (name, false)
    }
  }
  (name, true)
}

/// A path whose first segment contains a dot names a remote module.
fn is_remote(path: Str) -> Bool {
  let first = path.split("/")[0]
  first.contains(".")
}

/// Removes a /vN major version suffix (N >= 2).
fn major_suffix(path: Str) -> Str {
  let segs = path.split("/")
  if segs.len() < 2 {
    return path
  }
  let last = segs[segs.len() - 1].bytes()
  if last.len() < 2 || last[0] != 'v' || last[1] == '0' {
    return path
  }
  for i in 1..last.len() {
    if last[i] < '0' || last[i] > '9' {
      return path
    }
  }
  if last.len() == 2 && last[1] == '1' {
    return path
  }
  var out: List[Str] = []
  for i in 0..segs.len() - 1 {
    out.push(segs[i])
  }
  out.join("/")
}

/// The volume of an absolute Windows path with / separators ("C:" of
/// "C:/x", the form paths reach Xo in there, std.md 3.1, and
/// "//server/share" of a UNC path given as \\server\share, hostpath's
/// volume_w rule); "" for every other path, and on every other host.
pub fn path_volume(p: Str) -> Str {
  let windows = match target.os {
    Windows => true
    Darwin | Linux | Wasi => false
  }
  if !windows {
    return ""
  }
  if p.len() >= 3 && p[1..2] == ":" && p[2..3] == "/" {
    return p[0..2]
  }
  if p.starts_with("//") && !p.starts_with("///") {
    let parts = p[2..].split("/")
    if parts.len() >= 2 && !parts[0].is_empty() && !parts[1].is_empty() {
      return "//${parts[0]}/${parts[1]}"
    }
  }
  ""
}

/// Whether p is absolute: rooted at /, or a Windows drive path (C:/x).
pub fn is_rooted(p: Str) -> Bool {
  p.starts_with("/") || !path_volume(p).is_empty()
}

/// path.Clean for slash separated paths (filepath.Clean with / on
/// Windows: the drive stays, the rest is cleaned as rooted).
fn clean(p: Str) -> Str {
  if p.is_empty() {
    return "."
  }
  let vol = path_volume(p)
  if !vol.is_empty() {
    // the rest is cleaned as rooted at the volume (`//srv/share/a/..` is
    // `//srv/share/`, as filepath.Clean keeps a UNC root)
    let rest = clean(p[vol.len()..])
    return if vol.starts_with("//") && rest == "/" { vol + "/" } else { vol + rest }
  }
  let rooted = p.starts_with("/")
  var out: List[Str] = []
  for s in p.split("/") {
    if s.is_empty() || s == "." {
      continue
    }
    if s == ".." {
      if !out.is_empty() && out[out.len() - 1] != ".." {
        out.pop()
        continue
      }
      if rooted {
        continue
      }
    }
    out.push(s)
  }
  let body = out.join("/")
  if rooted {
    return "/${body}"
  }
  if body.is_empty() {
    return "."
  }
  body
}

fn join(a: Str, b: Str) -> Str {
  if a == "." || a.is_empty() {
    return clean(b)
  }
  clean("${a}/${b}")
}

fn base(p: Str) -> Str {
  let segs = clean(p).split("/")
  segs[segs.len() - 1]
}

fn parent(p: Str) -> Str {
  let c = clean(p)
  if c == "." {
    return ".."
  }
  if c == ".." || c.ends_with("/..") {
    return "${c}/.."
  }
  let segs = c.split("/")
  if segs.len() == 1 {
    return "."
  }
  var out: List[Str] = []
  for i in 0..segs.len() - 1 {
    out.push(segs[i])
  }
  out.join("/")
}

/// The path of target relative to dir, where dir is target or one of its
/// parents.
fn rel_path(dir: Str, target: Str) -> Str {
  let d = clean(dir)
  let t = clean(target)
  if d == t {
    return "."
  }
  if d == "." {
    return t
  }
  t.trim_prefix("${d}/")
}

/// Splits a line on spaces and tabs.
fn split_fields(line: Str) -> List[Str] {
  var out: List[Str] = []
  for w in line.replace("\t", " ").split(" ") {
    if !w.is_empty() {
      out.push(w)
    }
  }
  out
}

/// check edition.go EditionAliases: the edition an old edition name
/// stands for, or "" (decision 0155: `edition 2026` is `preview`).
fn edition_alias_of(s: Str) -> Str {
  if s == "2026" { "preview" } else { "" }
}

/// check edition.go reportEditionAliases: the fixable note XO1315 on
/// every `edition` line of a checked module's xo.mod that uses an old
/// edition name, in file order.
fn (var c: Checker) report_edition_aliases() {
  var files: List[Str] = []
  for (f, _) in c.edition_aliases.entries() {
    files.push(f)
  }
  for f in files.sort() {
    let r = c.edition_aliases.get(f) ?? ModRoot{path: "", dir: ""}
    let ed = edition_alias_of(r.alias)
    let sp = Span{start: parser.Pos{offset: 0, line: r.alias_line, col: r.alias_col}, end: parser.Pos{offset: 0, line: r.alias_line, col: r.alias_col + r.alias.len()}}
    let kw = r.keyword
    let d = c.report(f, "XO1315", sp, "`${kw} ${r.alias}` is the old name of `${kw} ${ed}`")
    if d >= 0 {
      c.diags[d].note_sev = true
      c.diags[d].warning = true
    }
    c.note(d, "before 1.0 the only edition is `${ed}` (decision 0155); the alias keeps building during the 0.x releases")
    c.fix(d, "rewrite `${kw} ${r.alias}` to `${kw} ${ed}`", [DEdit{span: JSpan{file: f, line: sp.start.line, col: sp.start.col, end_line: sp.end.line, end_col: sp.end.col}, replace: ed}])
  }
}

/// The directory of an absolute path: what precedes its last `/`.
fn dir_of_path(p: Str) -> Str {
  let parts = p.split("/")
  if parts.len() <= 1 {
    return ""
  }
  parts[0..parts.len() - 1].join("/")
}

/// A call an expression statement discards the value of (XO0209): its
/// effects, file, span, type, callee text, and the fixes made where it
/// was checked (their edits name its file).
struct Discard {
  eff: Int
  file: Str
  span: Span
  t: Int
  what: Str
  fixes: List[DFix] = []
  /// the types of the receiver, the arguments, and a called function
  /// value: a call that reaches state through one (reaches_state) is
  /// not reported
  operands: List[Int] = []
}

/// What a native build reads of the checker once the program is lowered
/// (decision 0352): the modules (their paths and `use c` prefixes for
/// the link), the diagnostics, and the parse cache when keep_parse (a
/// caller that reuses it). Every file, object and type goes, which held
/// the build's front end alive through code generation and the link.
pub fn (c: Checker) link_view(keep_parse: Bool) -> Checker {
  var v = Checker{fs: c.fs, std_dir: c.std_dir}
  v.mods = c.mods
  v.diags = c.diags
  // what a module check cache retry reads after the lowering (build_native)
  v.mod_skip = c.mod_skip
  v.mod_skip_auto = c.mod_skip_auto
  v.skip_unsafe = c.skip_unsafe
  if keep_parse {
    v.parse_cache = c.parse_cache
  }
  v
}
