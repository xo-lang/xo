// Tests of the self hosted checker. The comparison with the Go checker is
// internal/selfhost's TestSelfhostChecker (decision 0141).

/// A small prelude for checks in the test's in memory file system.
const PRELUDE = """
  struct Int {}
  struct Str {}
  struct List[T] {}
  enum Option[T] {
    None
    Some(v: T)
  }
  struct Os {}
  fn print(s: Str)
  struct Bool {}
  struct Float {}
  enum Never {}
  enum Result[T, E] {
    Ok(v: T)
    Err(e: E)
  }
  interface Display {
    fn display(self) -> Str
  }
  interface Error {
    fn display(self) -> Str
  }
  fn (xs: List[T]) len() -> Int
  fn (xs: List[T]) reverse() -> List[T]
  fn (var xs: List[T]) push(x: T)
  struct Atomic {}
  fn (a: Atomic) add(n: Int) -> Int
  struct Int8 {}
  struct Int32 {}
  struct UInt8 {}
  struct UInt64 {}
  """

/// Checks the module in dir after writing files (path, source) and the
/// small prelude, and returns the names, types, and diags dump.
fn check_files(os: testing.TestOs, dir: Str, files: List[(Str, Str)]) -> Str ! FsErr {
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", PRELUDE.bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.create_dir_all(dir)?
  for (p, src) in files {
    os.fs.write(p, src.bytes())?
  }
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs([dir]) {
    return Ok("error ${e}")
  }
  if !c.unsupported.is_empty() {
    return Ok("unsupported ${c.unsupported}")
  }
  Ok(c.dump(true, true, false, true, false))
}

/// The lines of a dump after its module header, without the file headers.
fn lines(dump: Str) -> List[Str] {
  dump.split("\n").filter(fn(l) { !l.is_empty() && !l.starts_with("==") && !l.starts_with("--") })
}

test "paths clean, join, and relate like Go's path package" {
  expect(clean("a/./b/../c/")) == "a/c"
  expect(clean("")) == "."
  expect(clean("../x/..")) == ".."
  expect(join(".", "a/b")) == "a/b"
  expect(join("a", "../b")) == "b"
  expect(parent("a/b")) == "a"
  expect(parent("a")) == "."
  expect(parent(".")) == ".."
  expect(rel_path("a", "a/b/c")) == "b/c"
  expect(rel_path("a/b", "a/b")) == "."
  expect(base("x/y/z")) == "z"
}

test "windows volumes: drives and UNC shares (hostpath's rule), on a windows target" {
  let win = match target.os {
    Windows => true
    Darwin | Linux | Wasi | FreeBSD => false
  }
  if win {
    expect(path_volume("C:/x/y")) == "C:"
    expect(path_volume("//srv/share/x")) == "//srv/share"
    expect(path_volume("//srv")) == ""
    expect(path_volume("///x")) == ""
    expect(path_volume("C:x")) == ""
    expect(is_rooted("C:/x")) == true
    expect(is_rooted("//srv/share")) == true
    expect(is_rooted("x/y")) == false
    expect(clean("C:/a/../b/./c")) == "C:/b/c"
    expect(clean("//srv/share/a/../b")) == "//srv/share/b"
    expect(clean("//srv/share/a/..")) == "//srv/share/"
    expect(join("//srv/share", "x/../y")) == "//srv/share/y"
  } else {
    expect(path_volume("C:/x/y")) == ""
    expect(path_volume("//srv/share/x")) == ""
    expect(is_rooted("//srv/share")) == true
    expect(clean("//srv/share/a/..")) == "/srv/share"
  }
}

test "an import's local name is its last segment" {
  expect(local_name("std/http")) == ("http", true)
  expect(local_name("example.com/rate-limit")) == ("rate_limit", true)
  expect(local_name("github.com/acme/billing/v2")) == ("billing", true)
  expect(local_name("example.com/app/v1")) == ("v1", true)
  expect(local_name("example.com/match")) == ("match", false)
  expect(local_name("example.com/2fa")) == ("2fa", false)
}

test "JSON strings are escaped as encoding/json does without HTML escaping" {
  expect(json_str("a \"b\" \\ <c>")) == "\"a \\\"b\\\" \\\\ <c>\""
  expect(json_str("tab\there\n")) == "\"tab\\there\\n\""
  expect(json_str("\x01")) == "\"\\u0001\""
}

test "locals, parameters, functions, and types resolve" {
  let out = check_files(os, "m", [("m/main.xo", """
    fn twice(x: Int) -> Int {
      let y = x
      add(y, y)
    }

    fn add(a: Int, b: Int) -> Int {
      a
    }
    """)])?
  let ls = lines(out)
  expect(ls.contains("1:13 Int type std/prelude Int std/prelude.xo:1:8")) == true
  expect(ls.contains("2:11 x local param m/main.xo:1:10")) == true
  expect(ls.contains("3:3 add fn m add m/main.xo:6:4")) == true
  expect(ls.contains("3:7 y local let m/main.xo:2:7")) == true
  expect(ls.contains("7:3 a local param m/main.xo:6:8")) == true
}

test "shadowing in a nested block is allowed, in the same block it is XO0603" {
  let out = check_files(os, "s", [("s/main.xo", """
    fn f(x: Int) -> Int {
      let y = x
      {
        let y = 1
        print(y)
      }
      let y = 2
      y
    }
    """)])?
  let ls = lines(out)
  expect(ls.contains("5:11 y local let s/main.xo:4:9")) == true
  expect(ls.contains("8:3 y local let s/main.xo:7:7")) == true
  expect(ls.any(fn(l) { l.contains("\"XO0603\"") && l.contains("\"line\":7") })) == true
}

test "undefined names are XO0601, UpperCamel ones too when no enum is expected" {
  let out = check_files(os, "u", [("u/main.xo", """
    fn f() -> Int {
      missing(Red, other)
    }
    """)])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("function `missing` not found") })) == true
  expect(ls.any(fn(l) { l.contains("name `other` not found") })) == true
  expect(ls.any(fn(l) { l.contains("name `Red` not found") })) == true
}

test "expressions get their types after implicit conversion" {
  let out = check_files(os, "t", [("t/main.xo", """
    fn f(x: Int) -> Int? {
      let y: Int? = x
      let z = [x, 2]
      if z.len() == 0 { None } else { y }
    }
    """)])?
  let ls = lines(out)
  expect(ls.contains("2:17-2:18 Ident Int?")) == true
  expect(ls.contains("3:11-3:17 ListLit List[Int]")) == true
  expect(ls.contains("3:15-3:16 IntLit Int")) == true
  expect(ls.contains("4:6-4:13 CallExpr Int")) == true
  expect(ls.contains("4:21-4:25 Ident Int?")) == true
  expect(ls.contains("4:8 len fn std/prelude List.len std/prelude.xo:23:18")) == true
  expect(ls.contains("4:21 None variant std/prelude Option.None std/prelude.xo:5:3")) == true
}

test "a value of the wrong type is XO0401" {
  let out = check_files(os, "w", [("w/main.xo", """
    fn f(x: Int) -> Str {
      x
    }
    """)])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("\"XO0401\"") && l.contains("expected `Str`, found `Int`") })) == true
}

test "a destructuring assignment checks each place, its value against their types, and a place named twice (decision 0536)" {
  let out = check_files(os, "d", [("d/main.xo", """
    fn pair() -> (Int, Str) {
      (1, "a")
    }

    fn f() -> Int {
      var a = 1
      var b = 2
      (a, b) = (b, a)
      var n: Int32 = 0
      var s = ""
      (n, s) = (7, "x")
      (_, s) = pair()
      let c = 3
      (a, c) = (1, 2)
      (a, a) = (1, 2)
      (a, b) += (1, 2)
      (a, s) = (1, 2)
      (a, s) = (1, "x", 3)
      if n > 0 {
        return 0
      }
      a + b + c + s.len()
    }
    """)])?
  let ls = lines(out)
  let errs = ls.filter(fn(l) { l.contains("\"XO") })
  expect(errs.any(fn(l) { l.contains("\"XO0502\"") && l.contains("`c` to be `var`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0539\"") && l.contains("`a` is assigned twice") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0502\"") && l.contains("`+=` needs a single target") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0401\"") && l.contains("expected `Str`, found `Int`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0401\"") && l.contains("found `(Int, Str, Int)`") })) == true
  expect(errs.filter(fn(l) { l.contains("\"XO0502\"") }).len()) == 2
  expect(errs.filter(fn(l) { l.contains("\"XO0539\"") }).len()) == 1
  expect(errs.filter(fn(l) { l.contains("\"XO0401\"") }).len()) == 2
}

test "a struct target follows let's struct pattern rules, and its shorthand and `..` stay out of struct literals (decision 0538)" {
  let out = check_files(os, "d", [("d/main.xo", """
    struct P {
      x: Int
      y: Int
    }

    enum E {
      A
    }

    fn f() -> Int {
      var x = 1
      var y = 2
      var s = ""
      let c = 3
      P{x, y} = P{x: 5, y: 6}
      P{x, ..} = P{x: 7, y: 8}
      P{x} = P{x: 1, y: 2}
      P{x, c} = P{x: 1, y: 2}
      P{x: c, y} = P{x: 1, y: 2}
      P{x, y: x} = P{x: 1, y: 2}
      P{x: s, y} = P{x: 1, y: 2}
      P{x, y} += P{x: 1, y: 2}
      E{x, ..} = E.A
      let p = P{x}
      let q = P{x: 1, ..}
      x + y + c + s.len() + p.x + q.y
    }
    """)])?
  let ls = lines(out)
  let errs = ls.filter(fn(l) { l.contains("\"XO") })
  expect(errs.any(fn(l) { l.contains("\"XO0302\"") && l.contains("does not mention field(s) `y`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0601\"") && l.contains("`P` has no field `c`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0502\"") && l.contains("`c` to be `var`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0539\"") && l.contains("`x` is assigned twice") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0401\"") && l.contains("field `x` is `Int`, which cannot be stored in `Str`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0502\"") && l.contains("`+=` needs a single target") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0302\"") && l.contains("`E` is not a struct type") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0160\"") && l.contains("a struct literal writes `x: value`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0160\"") && l.contains("`..` in a struct literal") })) == true
  expect(errs.filter(fn(l) { l.contains("\"XO0160\"") }).len()) == 2
}

test "a list target is XO0303 unless it is `[..]`, as let's list patterns, and `..` stays out of list literals (decision 0538)" {
  let out = check_files(os, "d", [("d/main.xo", """
    fn f() -> Int {
      let xs = [1, 2, 3]
      var a = 0
      var b = 0
      let c = 4
      [a, b] = xs
      [a, ..] = xs
      [] = xs
      (a, [b]) = (1, xs)
      [c, ..] = xs
      [..] = xs
      (a, [..]) = (5, xs)
      [..] += xs
      let ys = [a, ..]
      a + b + c + ys.len()
    }
    """)])?
  let ls = lines(out)
  let errs = ls.filter(fn(l) { l.contains("\"XO") })
  expect(errs.filter(fn(l) { l.contains("\"XO0303\"") && l.contains("a list target must match every list") }).len()) == 5
  expect(errs.any(fn(l) { l.contains("\"XO0502\"") && l.contains("`c` to be `var`") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0502\"") && l.contains("`+=` needs a single target") })) == true
  expect(errs.any(fn(l) { l.contains("\"XO0160\"") && l.contains("`..` in a list literal") })) == true
  expect(errs.len()) == 8
}

test "an Option where a Result is expected, and `x ?? Err(e)`, name or_err (XO0401)" {
  // aws-19, 2026-11-06: `Time.parse_rfc3339(s) ?? Err(...)` and an
  // Option returned as a Result; the prelude's or_err was not found
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", PRELUDE.bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.create_dir_all("o")?
  os.fs.write("o/main.xo", """
    fn find(k: Int) -> Int? {
      if k > 0 { Some(k) } else { None }
    }

    fn a(k: Int) -> Result[Int, Str] {
      find(k)
    }

    fn b(k: Int) -> Int ! Str {
      let v = find(k) ?? Err("missing")
      Ok(v)
    }
    """.bytes())?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["o"]) {
    fault("check: ${e}")
  }
  let ds = c.diags.filter(fn(d) { d.code == "XO0401" })
  expect(ds.len()) == 2
  expect(ds[0].notes.any(fn(n) { n.message.contains("`.or_err(e)` turns it into this Result") })) == true
  expect(ds[1].notes.any(fn(n) { n.message.contains("`find(k).or_err(\"missing\")?` fails with the error") })) == true
  expect(ds[1].fixes.filter(fn(f) { f.title == "use `.or_err(...)?`" }).map(fn(f) { f.edits.map(fn(e) { e.replace }) })) == [["find(k).or_err(\"missing\")?"]]
}

test "a pure caller performing a bare receiver's effect gets a note and a fix naming it (XO0701)" {
  // aws-19, 2026-11-06: a pub method on a bare `Box` may perform the
  // struct's fx by its signature (core 6.2); its body performs none, so
  // the fix writes `Box[fx]` on the callee's receiver
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", PRELUDE.bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.create_dir_all("bx")?
  os.fs.write("bx/main.xo", """
    pub struct Box[fx: Effects] {
      get: fn() -> Int uses fx
    }

    pub fn (b: Box) name() -> Str {
      "box"
    }

    pub fn (b: Box) run() -> Int {
      b.get()
    }

    pub fn (b: Box[fx]) label() -> Str {
      b.name()
    }

    pub fn (b: Box[fx]) count() -> Int {
      b.run()
    }
    """.bytes())?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["bx"]) {
    fault("check: ${e}")
  }
  let ds = c.diags.filter(fn(d) { d.code == "XO0701" })
  expect(ds.len()) == 2
  expect(ds[0].notes.any(fn(n) { n.message.contains("only through `Box`") })) == true
  expect(ds[0].fixes.map(fn(f) { f.edits.map(fn(e) { e.replace }) })) == [["[fx]"]]
  // run's body performs fx, so `Box[fx]` on run would be wrong: the fix
  // declares it on count instead (the corrected clause, lead 2026-11-08)
  expect(ds[1].fixes.map(fn(f) { f.edits.map(fn(e) { e.replace }) })) == [[" uses fx"]]
}

test "an integer literal must fit its type (XO0421)" {
  let out = check_files(os, "r", [("r/main.xo", """
    const MIN: Int = -9223372036854775808

    fn small(b: Int8) -> Int8 { b }

    fn f() -> List[Int] {
      let ok8: Int8 = -128
      let big8: Int8 = 300
      let low8: Int8 = -129
      let paren8: Int8 = -(128)
      let neg: UInt8 = -1
      let zero: UInt8 = -0
      let top: UInt64 = 18446744073709551615
      let over = 9223372036854775808
      let hex: Int32 = 0x8000_0000
      let call = small(128)
      [MIN, Int(ok8), Int(big8), Int(low8), Int(paren8), Int(neg), Int(zero), Int(top), over, Int(hex), Int(call)]
    }
    """)])?
  let ls = lines(out).filter(fn(l) { l.contains("\"XO0421\"") })
  expect(ls.len()) == 7
  expect(ls.any(fn(l) { l.contains("the integer literal 300 does not fit `Int8`") })) == true
  expect(ls.any(fn(l) { l.contains("the integer literal -129 does not fit `Int8`") })) == true
  expect(ls.filter(fn(l) { l.contains("the integer literal 128 does not fit `Int8`") }).len()) == 2
  expect(ls.any(fn(l) { l.contains("the integer literal -1 does not fit `UInt8`") })) == true
  expect(ls.any(fn(l) { l.contains("the integer literal 9223372036854775808 does not fit `Int`") })) == true
  expect(ls.any(fn(l) { l.contains("the integer literal 0x8000_0000 does not fit `Int32`") })) == true
}

test "a file with a parse error is checked past it, as the Go checker does" {
  let out = check_files(os, "p", [("p/main.xo", "fn f() {\n  let = 1\n}\n\nfn g() -> Int {\n  \"s\"\n}\n")])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("\"XO0165\"") && l.contains("expected a pattern, found `=`") })) == true
  expect(ls.any(fn(l) { l.contains("\"XO0401\"") && l.contains("expected `Int`, found `Str`") })) == true
}

test "time layouts parse as the runtime does" {
  expect(time_layout_parse("{year}-{month}-{day}")) == ""
  expect(time_layout_parse("{hour12}:{minute}")) == "{hour12} needs {ampm} (or use {hour}, 00 to 23)"
  expect(time_layout_parse("{yera}")) == "unknown field {yera}"
  expect(time_layout_parse("{month:long}")) == "{month:long}: the forms are {month}, {month:1}, {month:short}, {month:name}"
  expect(time_layout_parse("a}")) == "unmatched } (a literal brace is written {rbrace})"
  expect(time_layout_parse("{year")) == "unclosed { (a literal brace is written {lbrace})"
  expect(xo_quote("a\"$\n")) == "\"a\\\"\\$\\n\""
}

test "constant time layouts are checked in the files that import std/time, by any name (XO0420)" {
  os.fs.create_dir_all("std")?
  os.fs.write("std/time.xo", b"pub fn check_layout(layout: Str) -> Str {\n  layout\n}\n")?
  let out = check_files(os, "tl", [
    ("tl/a.xo", "use std/time as clock\n\npub fn a() -> Str {\n  clock.check_layout(\"{yera}\")\n}\n"),
    ("tl/b.xo", "fn check_layout(layout: Str) -> Str {\n  layout\n}\n\npub fn b() -> Str {\n  check_layout(\"{yera}\")\n}\n"),
    ("tl/c.xo", "use std/time\n\npub fn c() -> Str {\n  time.check_layout(\"{year}\")\n}\n"),
  ])?
  let bad = lines(out).filter(fn(l) { l.contains("\"XO0420\"") })
  expect(bad.len()) == 1
  expect(bad[0].contains("\"file\":\"tl/a.xo\"")) == true
}

test "a name against its convention is XO0101" {
  let out = check_files(os, "n", [("n/main.xo", """
    fn GetName(userId: Int) -> Int {
      let maxCount = userId
      maxCount
    }
    """)])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("function name `GetName` must be snake_case") })) == true
  expect(ls.any(fn(l) { l.contains("parameter name `userId` must be snake_case") })) == true
  expect(ls.any(fn(l) { l.contains("variable name `maxCount` must be snake_case") })) == true
}

test "versions, module paths, ceilings, and deny rules read as internal/mod reads them" {
  expect(compare_versions("v1.2.0", "v1.10.0")) == -1
  expect(compare_versions("v1.0.0-rc.1", "v1.0.0")) == -1
  expect(compare_versions("v1.0.0-rc.2", "v1.0.0-rc.10")) == -1
  expect(compare_versions("v1.0.0-alpha", "v1.0.0-1")) == 1
  expect(valid_version("v01.0.0")) == false
  expect(valid_version("v1.0")) == false
  expect(major_mismatch("example.com/a", "v2.0.0")) == "example.com/a v2.0.0: major version 2 needs the module path example.com/a/v2"
  expect(major_mismatch("example.com/a/v3", "v2.0.0")) == "example.com/a/v3 v2.0.0: a module path ending in /v3 takes only v3.x.y versions"
  expect(valid_path("example.com/a/b")) == true
  expect(valid_path("example/a")) == false
  expect(escape_path("example.com/Acme/X")) == "example.com/!acme/!x"
  let cl = parse_ceiling(["uses", "(clock,", "fs.read)"]).ok() ?? Ceiling{}
  expect(ceiling_text(cl)) == "uses clock, fs.read"
  expect(ceiling_admits(cl, "fs.read")) == true
  expect(ceiling_admits(Ceiling{effects: ["fs"]}, "fs.write")) == true
  expect(ceiling_admits(cl, "fs.write")) == false
  let d = parse_deny("xo.mod", 3, " a.com/x -> a.com/y/..., std/time").ok() ?? Deny{from: "", line: 0}
  expect(deny_matches(d, "a.com/x", "a.com/y/z")) == "a.com/y/..."
  expect(deny_matches(d, "a.com/x", "std/json")) == ""
  expect(fields(" a\tb  c ")) == ["a", "b", "c"]
  expect(scan_lines(b"a\r\nb\n")) == ["a", "b"]
}

test "Go bindings, vouches, and effect locks read as internal/gobind and internal/mod read them" {
  let h = go_binding_header(b"// Code generated by xo bind from Go package strconv. DO NOT EDIT.\n// xo-bind: v5 go1.26.1\n// go-package: strconv\n// go-target: linux/arm64\n// go-standard: true\n// skip: format_complex: parameter c: Go type complex128 has no Xo counterpart (strconv.FormatComplex)\n// skip: odd\n\nuse std/go\n// skip: late: not a header line (x.Y)\n")
  expect(h.version) == 5
  expect(h.name) == "strconv"
  expect(h.target) == "linux/arm64"
  expect(h.standard) == true
  // the platform a binding is for: $GOOS/$GOARCH, else this xo's (tier 69)
  expect(go_target("linux", "amd64")) == "linux/amd64"
  expect(go_target("", "").contains("/")) == true
  expect(go_target("plan9", "").starts_with("plan9/")) == true
  expect(h.skipped.get("format_complex") ?? "") == "parameter c: Go type complex128 has no Xo counterpart"
  expect(h.skipped.contains("odd")) == true
  expect(h.skipped.contains("late")) == false
  expect(go_rerun_key(["b", "a", "Type.m"])) == "Type.m a b"
  expect(go_pin_for({"example.com/a": "v1.0.0", "example.com/a/b": "v2.0.0"}, "example.com/a/b/c")) == ("example.com/a/b", "v2.0.0")
  expect(go_pin_for({"example.com/a": "v1.0.0"}, "example.com/ab")) == ("", "")
  expect(go_pure_package("net/url")) == true
  expect(go_pure_package("os/exec")) == false
  expect(go_unquote("\"zlib.h\"") ?? "") == "zlib.h"
  expect(go_unquote("\"a\\\"b\"") ?? "") == "a\"b"
  expect(go_unquote("`raw`") ?? "") == "raw"
  expect(go_unquote("zlib.h") == None) == true
  expect(parse_vouch("xo.mod", 4, ["vouch", "example.com/z", "v1.2.0", "c", "\"zlib.h\"", "uses", "none"]).is_ok()) == true
  let bad = match parse_vouch("xo.mod", 5, ["vouch", "example.com/z", "v1.2.0", "go", "\"os\"", "uses", "net"]) {
    Ok(_) => ""
    Err(p) => p.msg
  }
  expect(bad) == "malformed vouch: a go vouch takes no `uses`: calls into Go always perform `go`"
  expect(suggest_vouch("example.com/z", "v1.2.0", "c", "zlib.h", Some([]))) == "vouch example.com/z v1.2.0 c \"zlib.h\" uses none"
  expect(parse_effects_text("net,clock") ?? []) == ["clock", "net"]
  expect(parse_effects_text("none") ?? ["x"]) == []
  expect(parse_effects_text("net,bogus") == None) == true
  expect(effects_text([])) == "none"
  expect(edition_alias_of("2026")) == "preview"
  expect(edition_alias_of("preview")) == ""
  expect(last_index("a (b) (c)", " (")) == 5
}

test "real_path follows the links of every element, as getcwd reports" {
  os.fs.create_dir_all("/private/var/folders/t").or_fault("mkdir")
  os.fs.symlink("/private/var", "/var").or_fault("var")
  os.fs.symlink("t", "/private/var/folders/u").or_fault("u")
  expect(real_path(os.fs, "/var/folders/t")) == "/private/var/folders/t"
  expect(real_path(os.fs, "/var/folders/u/./x/..")) == "/private/var/folders/t"
  expect(real_path(os.fs, "/private/var/folders")) == "/private/var/folders"
  expect(real_path(os.fs, "rel/../a")) == "a"
  expect(real_path(os.fs, "/")) == "/"
}

test "C ABI export names that two export modules define are paired, XO0608's check" {
  expect(export_clashes(["a", "b", "c"]).len()) == 0
  let got = export_clashes(["a", "poll_wait", "b", "poll_wait", "a"])
  expect(got.len()) == 2
  expect(got[0].0) == 1
  expect(got[0].1) == 3
  expect(got[1].0) == 0
  expect(got[1].1) == 4
  expect(xo_x_export_module("native/llrt/cabi")) == true
  expect(xo_x_export_module("native/llrt/cabi_poll")) == true
  expect(xo_x_export_module("native/llrt/cabi_libc")) == false
  expect(xo_x_export_module("native/llrt/poll")) == false
}

test "File, FileLock, Child, and values holding them are not comparable (XO0404)" {
  // decision 0112's rule for the handles that came after its list
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", "${PRELUDE}\nstruct File {}\nstruct FileLock {}\nstruct Child {}\n".bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.create_dir_all("h")?
  os.fs.write("h/main.xo", """
    struct Job {
      id: Int
      lock: FileLock
    }

    fn files(a: File, b: File) -> Bool {
      a == b
    }

    fn jobs(a: Job, b: Job) -> Bool {
      a != b
    }

    fn results(a: Result[Child, Str], b: Result[Child, Str]) -> Bool {
      a == b
    }

    fn ids(a: Job, b: Job) -> Bool {
      a.id == b.id
    }
    """.bytes())?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["h"]) {
    fault("check: ${e}")
  }
  let ls = lines(c.dump(true, true, false, true, false)).filter(fn(l) { l.contains("\"XO0404\"") })
  expect(ls.len()) == 3
  expect(ls.any(fn(l) { l.contains("`File` does not implement `Eq`") })) == true
  expect(ls.any(fn(l) { l.contains("`Job` does not implement `Eq`, so it cannot be compared with `!=`") })) == true
  expect(ls.any(fn(l) { l.contains("`Result[Child, Str]` does not implement `Eq`") })) == true
}

test "a long chain of operators gets every node's type, and one error where it goes wrong (infer_left)" {
  var terms: List[Str] = []
  for i in 0..400 {
    terms.push("${i}")
  }
  let out = check_files(os, "ch", [("ch/main.xo", "fn f(x: Int, s: Str) -> Int {\n  x + ${terms.join(" + ")}\n}\n\nfn g(x: Int, s: Str) -> Int {\n  x + 1 + s + 2 + 3\n}\n")])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.starts_with("2:") && l.contains(" BinaryExpr Int") }).len()) == 400
  let errs = ls.filter(fn(l) { l.contains("\"XO0406\"") })
  expect(errs.len()) == 1
  expect(errs[0].contains("\"line\":6,\"col\":3")) == true
}

test "the directory above . is unknown when the working directory is relative" {
  var c = new_checker(os.fs, "std")
  c.deps.wd = "."
  expect(c.up(".")) == None
  c.deps.wd = "/a/b"
  expect(c.up(".")) == Some("/a")
}

test "a long else if chain is checked in a loop with each branch's error (if_expr)" {
  var arms: List[Str] = []
  for i in 0..300 {
    arms.push("if x == ${i} {\n    ${i}\n  }")
  }
  let src = "fn f(x: Int) -> Int {\n  ${arms.join(" else ")} else {\n    0\n  }\n}\n\nfn g(x: Int) -> Int {\n  if x == 1 {\n    1\n  } else if x == 2 {\n    \"two\"\n  } else {\n    3\n  }\n}\n"
  let out = check_files(os, "ei", [("ei/main.xo", src)])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.contains(" IfExpr Int") }).len()) >= 300
  let errs = ls.filter(fn(l) { l.contains("\"XO0401\"") })
  expect(errs.len()) == 1
}

test "a discarded result of a call that only computes it is XO0209 (decision 0258)" {
  let out = check_files(os, "d", [("d/main.xo", """
    fn helper(x: Int) -> Int {
      x * 2
    }

    fn f(a: Atomic, g: fn(Int) -> Int) -> List[Int] {
      var xs = [3, 1, 2]
      xs.reverse()
      helper(4)
      let _ = xs.reverse()
      xs = xs.reverse()
      xs.push(4)
      a.add(1)
      g(1)
      dbg(xs.len())
      xs
    }
    """)])?
  let ls = lines(out).filter(fn(l) { l.contains("\"XO0209\"") })
  expect(ls.len()) == 2
  expect(ls[0].contains("`xs.reverse(...)`")) == true
  expect(ls[0].contains("the `List[Int]` that")) == true
  expect(ls[1].contains("`helper(...)`")) == true
}

test "only functions that are not pub, not std's and with no uses have inferred effects (XO_CHK_CACHE=auto rests on it)" {
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", PRELUDE.bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.create_dir_all("m")?
  os.fs.write("m/main.xo", """
    pub fn api(x: Int) -> Int {
      helper(x)
    }

    fn helper(x: Int) -> Int {
      x
    }

    fn main() {
      let f = fn(y: Int) -> Int { helper(y) }
      let _ = f(api(1))
    }
    """.bytes())?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["m"]) {
    expect(e) == ""
  }
  var names: List[Str] = []
  for f in c.inferred_fns {
    expect(c.objs[f].is_pub) == false
    names.push(text(c.objs[f].name))
  }
  expect(names.contains("helper")) == true
  expect(names.contains("api")) == false
  expect(c.effect_reads_across_modules()) == []
}

test "the walk skips a directory that is gone and fails on any other listing error" {
  let fi = FileInfo{name: "a.xo", path: "d/a.xo", size: 1, is_dir: false, modified: os.clock.now()}
  expect(listing(Ok([fi]), "d").0.len()) == 1
  expect(listing(Err(FsErr.NotFound(path: "d")), "d")) == ([], "")
  expect(listing(Err(FsErr.Denied(path: "d")), "d")) == ([], "")
  // a listing that failed for another reason (no file descriptors or
  // memory) dropped the directory's modules silently before 2026-10-21
  let (es, err) = listing(Err(FsErr.Io(path: "d", msg: "too many open files")), "d")
  expect(es.is_empty()) == true
  expect(err.contains("read d") && err.contains("too many open files")) == true
  expect(source_bytes(Ok(b"x"), "d/a.xo")) == (Some(b"x"), "")
  expect(source_bytes(Err(FsErr.NotFound(path: "d/a.xo")), "d/a.xo")) == (None, "")
  expect(source_bytes(Err(FsErr.Io(path: "d/a.xo", msg: "input/output error")), "d/a.xo").1.contains("read d/a.xo")) == true
}

test "the module audits read a whole tree or fail (XO1318)" {
  os.fs.create_dir_all("dep/net")?
  os.fs.write("dep/xo.mod", b"module ex.com/dep\n")?
  os.fs.write("dep/a.xo", b"pub fn f() uses fs.read {}\n")?
  os.fs.write("dep/net/b.xo", b"pub fn g() uses net {}\n")?
  let c = new_checker(os.fs, "std")
  expect(c.module_effects("dep")) == Ok(["fs.read", "net"])
  expect(c.hash_dir("dep").map(fn(h) { h.starts_with("h1:") })) == Ok(true)
  expect(tree_listing(Err(FsErr.NotFound(path: "x")), "x")) == Ok([])
  expect(tree_listing(Err(FsErr.Io(path: "x", msg: "input/output error")), "x").is_err()) == true
  expect(unreadable_tree("ex.com/m", "v1.0.0", "effects", "read x: boom").code) == "XO1318"
}

test "a std struct documented @move_only moves like the builders (XO0510), a user one does not" {
  // core 5.3, decision 0305: std/compress's Compressor and Decompressor
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", PRELUDE.bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.write("std/zz.xo", """
    /// A handle.
    /// @move_only
    struct Z {}
    fn z() -> Z
    fn (var x: Z) step() -> Int
    """.bytes())?
  os.fs.create_dir_all("m")?
  os.fs.write("m/main.xo", """
    use std/zz

    /// @move_only
    struct Mine {
      n: Int
    }

    fn std_moves() -> Int {
      var a = zz.z()
      var b = a
      b.step() + a.step()
    }

    fn user_copies(m: Mine) -> Int {
      let k = m
      k.n + m.n
    }
    """.bytes())?
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs(["m"]) {
    fault("check: ${e}")
  }
  let ls = lines(c.dump(true, true, false, true, false)).filter(fn(l) { l.contains("\"XO0510\"") })
  expect(ls.len()) == 1
  expect(ls.any(fn(l) { l.contains("use of moved value `a`") })) == true
}

test "a user type with a generic method implements an interface's generic method" {
  // structural's substitutions make the method's own type parameters
  // after identical's receiver was read: it faulted past the end of
  // c.tys (2026-10-21, a user Rand with shuffle[T])
  let src = """
    interface Shuf {
      fn shuffle[T](self, xs: List[T]) -> List[T]
    }

    struct Rev {}

    fn (r: Rev) shuffle[T](xs: List[T]) -> List[T] { xs.reverse() }

    struct Bad {}

    fn (r: Bad) shuffle(xs: List[Int]) -> List[Int] { xs }

    fn f() -> Shuf { Rev{} }

    fn g() -> Shuf { Bad{} }
    """
  let out = check_files(os, "m", [("m/main.xo", src)])?
  let errs = lines(out).filter(fn(l) { l.contains("XO0401") })
  // f's Rev converts; g's Bad, with no type parameter, does not
  expect(errs.len()) == 1
  expect(errs[0].contains("\"line\":15,") && errs[0].contains("found `Bad`")) == true
}

test "a go.mod's go line" {
  expect(go_mod_go_line("module m\n\ngo 1.26.0 // the toolchain's\n\nrequire x v1\n")) == "1.26.0"
  expect(go_mod_go_line("module m\n")) == ""
}

test "link_view keeps the build's settings, which the cleanup cache's key reads after the lowering" {
  var c = new_checker(os.fs, "std")
  c.map_log = false
  c.map_core = false
  c.map_branch = true
  c.async_preempt_ok = true
  c.async_preempt_llvm = true
  c.no_preempt = true
  c.set_debug_contracts = 1
  c.set_dbg = 0
  c.set_error_args = 1
  c.set_trace = 0
  c.dwarf = false
  c.pack_lists = true
  c.inline_str = true
  c.det = true
  c.race = true
  let v = c.link_view(false)
  expect(v.map_log) == false
  expect(v.map_core) == false
  expect(v.map_branch) == true
  expect(v.async_preempt_ok) == true
  expect(v.async_preempt_llvm) == true
  expect(v.no_preempt) == true
  expect(v.set_debug_contracts) == 1
  expect(v.set_dbg) == 0
  expect(v.set_error_args) == 1
  expect(v.set_trace) == 0
  expect(v.dwarf) == false
  expect(v.pack_lists) == true
  expect(v.inline_str) == true
  expect(v.det) == true
  expect(v.race) == true
}

test "a valued enum reports a duplicate value (XO0428) and an invalid one (XO0429), decision 0269" {
  let out = check_files(os, "v", [("v/main.xo", """
    enum Dup: Int { A = 1, B = 1 }
    enum Bad: Float { A = 1.5 }
    enum Ok: Str { A, B = "bee" }

    fn main() {
      let _ = Ok.A.value()
      let _ = Ok.from("bee")
      let _ = Ok.all()
    }
    """)])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.contains("\"XO0428\"") }).len()) == 1
  expect(ls.filter(fn(l) { l.contains("\"XO0429\"") }).len()) == 1
}

test "a valued enum's catch-all (decision 0493): a misplaced or mistyped one is XO0434, one built from a named variant's constant XO0435" {
  let out = check_files(os, "c", [("c/main.xo", """
    enum NotLast: Str { A = "a", U(value: Str), B = "b" }
    enum WrongType: Str { A = "a", U(value: Int) }
    enum HasValue: Str { A = "a", U(value: Str) = "u" }
    enum Open: Str { A = "a", U(value: Str) }

    fn f(s: Str) -> Open {
      let _ = Open.U("new")
      let _ = Open.known(s)
      let _ = Open.all()
      let _ = Open.from(s).value()
      Open.U("a")
    }
    """)])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.contains("\"XO0434\"") }).len()) == 3
  expect(ls.filter(fn(l) { l.contains("\"XO0435\"") }).len()) == 1
  expect(ls.filter(fn(l) { l.contains("\"XO0401\"") }).len()) == 0
}

test "var self interface methods (decision 0613): declared, satisfied by var or plain methods, a var method for a plain self one is XO0439, an immutable receiver XO0501" {
  let out = check_files(os, "v", [("v/main.xo", """
    interface Loader {
      fn load(var self, n: Int)
      fn total(self) -> Int
    }

    interface Reader {
      fn read(self, n: Int)
    }

    struct Box {
      items: List[Int] = []
    }

    fn (var b: Box) load(n: Int) { b.items.push(n) }

    fn (b: Box) total() -> Int { b.items.len() }

    fn (var b: Box) read(n: Int) { b.items.push(n) }

    struct Plain {
      n: Int = 0
    }

    fn (p: Plain) load(n: Int) {}

    fn (p: Plain) total() -> Int { p.n }

    fn fill[T: Loader](var t: T) -> Int {
      t.load(1)
      t.total()
    }

    fn peek[T: Loader](t: T) {
      t.load(1)
    }

    fn reads[T: Reader](t: T) {
      t.read(1)
    }

    fn g() -> Int {
      var b = Box{}
      var p = Plain{}
      reads(b)
      let _r: Reader = b
      fill(b) + fill(p)
    }
    """)])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.contains("\"XO0439\"") }).len()) == 2
  expect(ls.filter(fn(l) { l.contains("\"XO0501\"") }).len()) == 1
  expect(ls.filter(fn(l) { l.contains("\"XO0403\"") || l.contains("\"XO0160\"") || l.contains("\"XO0404\"") || l.contains("\"XO0401\"") }).len()) == 0
}

test "for over a type with next() (decision 0494): a `?` that does not match next() is XO0436, once" {
  let out = check_files(os, "n", [("n/main.xo", """
    struct C {
      n: Int
    }

    fn (var c: C) next() -> Int? { None }

    struct F {
      n: Int
    }

    fn (var f: F) next() -> Int? ! Str { Ok(None) }

    fn g() -> Int ! Str {
      var total = 0
      var c = C{n: 1}
      for x in c { total += x }
      var f = F{n: 1}
      for x? in f { total += x }
      for x? in c { total += x }
      for x in f { total += x }
      for x? in [1] { total += x }
      Ok(total)
    }
    """)])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.contains("\"XO0436\"") }).len()) == 3
  expect(ls.filter(fn(l) { l.contains("\"XO0406\"") }).len()) == 0
}

test "a bare const in a pattern matches by equality and a misspelled one is XO0430 (decision 0269)" {
  let out = check_files(os, "p", [("p/main.xo", """
    const OK = 200

    fn f(s: Int) -> Int {
      match s {
        OK => 1
        OKK => 2
        _ => 0
      }
    }
    """)])?
  let ls = lines(out)
  expect(ls.filter(fn(l) { l.contains("\"XO0430\"") }).len()) == 1
  expect(ls.filter(fn(l) { l.contains("\"XO0302\"") }).len()) == 0
}
