// Effect sets (internal/check/effects.go): the `uses` of a function
// type and the effect arguments of a type (`Cache[K, V, E, net.dial]`),
// with effect variables bound by unification; the effects each body
// performs, the inferred effects of functions that are not pub
// (solve_effects, a fixpoint), and the obligations checked against them
// (XO0701), stage 4 of decision 0141.

use github.com/xo-lang/xo/compiler/parser

/// Whether function fo declares a network effect (`uses net`, `net.dial`
/// or `net.listen`): the SSA builder's test for a std function that waits
/// on the network (ssa/call.xo net_waits).
pub fn (c: Checker) declares_net(fo: Int) -> Bool {
  let set = c.objs[fo].declared
  if set < 0 || set >= c.esets.len() {
    return false
  }
  for it in c.esets[set] {
    if it.label == "net" || it.label.starts_with("net.") {
      return true
    }
  }
  false
}

/// One member of an effect set: a label, an effect parameter (a TParam
/// object), an effect variable, or the (inferred) effects of a function
/// that is not pub, with the substitution of its effect parameters at
/// the call (has_sub: one was given).
pub struct EffItem {
  pub label: Str = ""
  pub param: Int = -1
  pub evar: Int = -1
  pub fn_obj: Int = -1
  pub sub: Map[Int, Int] = {}
  pub has_sub: Bool = false
  /// Where the effect is performed (file "" for nowhere: a declaration's
  /// item) and through which callee, for the call chain of XO0701.
  pub file: Str = ""
  pub span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  pub via: Str = ""
  /// The callee's effect parameter this item was substituted for at a
  /// call (subst_eff), -1 for none: XO0701's receiver note names it.
  pub from_param: Int = -1
}

/// An effect set with function items expanded: its labels and effect
/// parameters, each with the item that witnesses it (effects.go
/// flatEff).
pub struct Flat {
  pub labels: List[Str] = []
  pub params: List[Int] = []
  pub label_items: List[EffItem] = []
  pub param_items: List[EffItem] = []
}

/// A copy of set s whose items without a place are attributed to the call
/// at sp in file of the callee via (effects.go EffSet.performed).
fn (var c: Checker) performed(s: Int, file: Str, sp: Span, via: Str) -> Int {
  if s < 0 {
    return s
  }
  var out: List[EffItem] = []
  for it0 in c.esets[s] {
    var it = it0
    if it.file.is_empty() {
      it.file = file
      it.span = sp
      it.via = via
    }
    out.push(it)
  }
  c.new_eset(out)
}

/// The kind of requirement an obligation states, for its message.
enum ObKind {
  /// A function declaration's `uses` (or none, when pub).
  Decl
  /// A closure's `uses`.
  Closure
  /// A function value used where a function type is expected.
  FuncType
  /// A method that implements an interface method.
  Iface
  /// A contract clause or invariant, which must be pure.
  Pure
  /// An effect set fixed by a type (an effect argument, a function type
  /// inside a type), which must match exactly (core 6.2).
  Same
  /// A const initializer, which must be pure (decision 0332, XO0415).
  Const
}

/// The effects of sub must be within those of sup (effects.go
/// effObligation), reported at span of file.
struct EffOb {
  kind: ObKind
  sub: Int
  sup: Int
  file: Str
  span: Span
  /// Decl: the function; Iface: the method.
  fo: Int = -1
  /// FuncType: the expected function type; Iface: the type used.
  ty: Int = -1
  /// Iface: the interface type and the interface method's name.
  iface: Int = -1
  meth: Str = ""
  /// Closure: its ` uses ...` clause (file "" for none), which a fix may
  /// remove so its effects are inferred.
  uses_file: Str = ""
  uses_clause: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  /// Decl: where the fix that declares the missing effects goes (UsesFix);
  /// None when no fix applies (a declaration without a body).
  uses_fix: UsesFix? = None
}

/// A declaration's `uses` clause as XO0701's fix edits it: the effects it
/// writes, and where the missing ones go: after the last of them
/// (append), else where a new clause goes, after the error or result
/// type, or before the body (before_body: `uses ... {`). An empty
/// clause (`uses ()`) is replaced whole, from start to at (replace).
struct UsesFix {
  written: List[Str]
  start: parser.Pos = parser.Pos{offset: 0, line: 0, col: 0}
  at: parser.Pos
  append: Bool
  before_body: Bool
  replace: Bool = false
}

/// The fix that adds `log` to a function's `uses` clause when only `log`
/// is missing (habits.go addLogFix, decision 0156): append `, log` to an
/// existing clause, or a new `uses log` after the signature.
fn uses_fix_of(fd: parser.FnDecl) -> UsesFix? {
  for cl in fd.clauses {
    match cl {
      parser.Clause.UsesClause(span, effects, _) => {
        if effects.is_empty() {
          return Some(UsesFix{written: [], start: span.start, at: span.end, append: false, before_body: false, replace: true})
        } else {
          var written: List[Str] = []
          for e in effects {
            written.push(if let Some(sb) = e.sub { "${text(e.name.name)}.${text(sb.name)}" } else { text(e.name.name) })
          }
          return Some(UsesFix{written: written, at: effects[effects.len() - 1].span.end, append: true, before_body: false})
        }
      }
      _ => {}
    }
  }
  if let Some(es) = fd.err {
    return Some(UsesFix{written: [], at: es.span.end, append: false, before_body: false})
  }
  if let Some(t) = fd.result {
    return Some(UsesFix{written: [], at: parser.type_span(t).end, append: false, before_body: false})
  }
  if let Some(b) = fd.body {
    return Some(UsesFix{written: [], at: b.span.start, append: false, before_body: true})
  }
  None
}

/// XO0701's fix on a declaration: the missing effects (labels and the
/// function's own effect variables) added to its `uses` clause, or a new
/// clause, titled with the whole corrected clause (`uses (net.dial,
/// fx)`), so an agent applies it as it stands (Azure's azquery send(),
/// 2026-11-08: a function generic over fx that forgot `fx`). None when a
/// missing one is an omitted effect argument, which no `uses` list can
/// name (elided_effect_note has its fix).
fn (c: Checker) uses_fix_edit(ob: EffOb, missing: List[Str], sub: Flat, sup: Flat) -> (Str, DEdit, Str)? {
  for p in sub.params {
    if !sup.params.contains(p) && c.objs[p].elided {
      return None
    }
  }
  uses_edit(ob, missing)
}

/// The edit that adds missing to ob's `uses` clause, its title, and the
/// corrected clause; None when ob has no place for one.
fn uses_edit(ob: EffOb, missing: List[Str]) -> (Str, DEdit, Str)? {
  let uf = ob.uses_fix ?? return None
  var all = uf.written
  for m in missing {
    if !all.contains(m) {
      all.push(m)
    }
  }
  let clause = if all.len() == 1 { "uses ${all[0]}" } else { "uses (${all.join(", ")})" }
  let added = missing.join(", ")
  if uf.replace {
    return Some(("write the clause `${clause}`", DEdit{span: JSpan{file: ob.file, line: uf.start.line, col: uf.start.col, end_line: uf.at.line, end_col: uf.at.col}, replace: clause}, clause))
  }
  let (title, ins) = if uf.append {
    ("add `${missing.join("`, `")}` to the `uses` clause: `${clause}`", ", ${added}")
  } else if uf.before_body {
    ("add the clause `${clause}`", "uses ${added} ")
  } else {
    ("add the clause `${clause}`", " uses ${added}")
  }
  Some((title, DEdit{span: JSpan{file: ob.file, line: uf.at.line, col: uf.at.col, end_line: uf.at.line, end_col: uf.at.col}, replace: ins}, clause))
}

/// The note on an XO0701 whose missing effect is an elided effect
/// parameter (habits.go elidedEffectNote), with the fix removing the
/// closure's `uses` clause.
fn (var c: Checker) elided_effect_note(d: Int, sub: Flat, sup: Flat, ob: EffOb) {
  for p in sub.params {
    let o = c.objs[p]
    if sup.params.contains(p) || !o.elided || o.elided_from.is_empty() {
      continue
    }
    let from = o.elided_from[0]
    var tn = from.text
    if let Some(i) = tn.find("[") {
      tn = text(tn.bytes()[0..i])
    }
    c.diags[d].notes.push(DNote{message: "`${text(o.name)}` is the effect argument left out of `${from.text}` here; an omitted effect argument stays an abstract effect variable of the function (core 6.2), as Rust and TypeScript generics would infer it, so a `uses` list cannot name it: write the effect argument, `${tn}[..., net.dial]` naming the effects of the value passed in, or let the closure's effects be inferred", span: Some(JSpan{file: from.file, line: from.at.start.line, col: from.at.start.col})})
    // the threaded form (decision 0522): name the effect so the function
    // and the closure can list it
    var fx = text(o.name)
    if let Some(i) = fx.rfind(".") {
      fx = text(fx.bytes()[i + 1..])
    }
    c.note(d, "to pass the caller's effects through, name the effect parameter and list it: `fn f[${fx}: Effects](x: ${tn}[${fx}]) uses (..., ${fx})`, with `${fx}` in the closure's `uses` too (decision 0522)")
    // the fix `xo fix` applies first: the argument written as no effects,
    // what a value that performs none (a Postgres or in memory sql.Db)
    // has; a caller passing the value along gets the same note and fix
    // in turn. Only for a type written bare (its one effect parameter
    // left out); with other arguments the note says what to write.
    if !from.text.contains("[") {
      c.fix(d, "write the effect argument: `${from.text}[()]`, a value that performs no effects (the effects of the value passed in when it performs some)", [DEdit{span: JSpan{file: from.file, line: from.at.end.line, col: from.at.end.col, end_line: from.at.end.line, end_col: from.at.end.col}, replace: "[()]"}])
    }
    if !ob.uses_file.is_empty() {
      c.fix(d, "remove the closure's `uses` clause so its effects are inferred", [DEdit{span: JSpan{file: ob.uses_file, line: ob.uses_clause.start.line, col: ob.uses_clause.start.col, end_line: ob.uses_clause.end.line, end_col: ob.uses_clause.end.col}, replace: ""}])
    }
    return
  }
}

/// The note on an XO0701 whose missing effect reaches it only through a
/// called function's implicit effect variable: an effect argument left out
/// of its receiver or parameter type (`fn (b: Box) name()`), which a pub
/// signature counts as performed (core 6.2) though the body performs
/// none. The fix names the argument (`Box[fx]`), an effect parameter that
/// is performed only when `uses` lists it (lead, 2026-11-06, from Xo
/// Azure 1's azcore).
fn (var c: Checker) implicit_callee_note(d: Int, sub: Flat, sup: Flat) {
  for (k, p) in sub.params.indexed() {
    let q = sub.param_items[k].from_param
    if sup.params.contains(p) || q < 0 {
      continue
    }
    let o = c.objs[q]
    if !o.elided || !o.effect {
      continue
    }
    // the callee is the function whose body obligation has q among its
    // type parameters; a body that performs q keeps the signature right
    var callee = -1
    var performs = false
    for ob in c.obligations {
      if ob.kind == ObKind.Decl && ob.fo >= 0 && c.objs[ob.fo].tparams.contains(q) {
        performs = c.flatten(ob.sub, true).params.contains(q)
        callee = ob.fo
        break
      }
    }
    if callee < 0 || performs {
      continue
    }
    // where the argument was left out: a parameter's type records it; a
    // bare receiver (`fn (b: Box)`) is its declaration's receiver type
    var from = ElidedFrom{file: "", at: no_span(), text: ""}
    if !o.elided_from.is_empty() {
      from = o.elided_from[0]
    } else if !c.objs[callee].fn_decl.is_empty() && c.objs[callee].decl_file >= 0 {
      if let Some(r) = c.objs[callee].fn_decl[0].recv {
        from = ElidedFrom{file: c.files[c.objs[callee].decl_file].path, at: parser.type_span(r.typ), text: type_text(r.typ)}
      }
    }
    if from.file.is_empty() {
      continue
    }
    var fx = text(o.name)
    if let Some(i) = fx.rfind(".") {
      fx = text(fx.bytes()[i + 1..])
    }
    let name = c.display_name(callee)
    c.diags[d].notes.push(DNote{message: "`${name}` performs `${text(c.objs[p].name)}` here only through `${from.text}`, whose effect argument is left out: a pub signature counts it as performed (core 6.2), though the body of `${name}` performs none; written as a named parameter, `${from.text}[${fx}]`, it is performed only when `uses` lists it", span: Some(JSpan{file: from.file, line: from.at.start.line, col: from.at.start.col})})
    if !from.text.contains("[") {
      c.fix(d, "name the effect argument of `${name}`'s `${from.text}`: `${from.text}[${fx}]`", [DEdit{span: JSpan{file: from.file, line: from.at.end.line, col: from.at.end.col, end_line: from.at.end.line, end_col: from.at.end.col}, replace: "[${fx}]"}])
    }
    return
  }
}

/// A new effect set (an index into esets).
fn (var c: Checker) new_eset(items: List[EffItem]) -> Int {
  let i = c.esets.len()
  c.esets.push(items)
  i
}

/// A set holding one fresh effect variable.
fn (var c: Checker) fresh_eset() -> Int {
  let v = c.evars.len()
  c.evars.push(-1)
  c.new_eset([EffItem{evar: v}])
}

/// An effect argument holding a fresh effect variable.
fn (var c: Checker) fresh_effarg() -> Int {
  let s = c.fresh_eset()
  c.new_ty(Ty{kind: TyKind.EffArg, eff: s})
}

/// evar_kind values: a call's own effect variable, and a tail.
const EV_CALL = 1
const EV_TAIL = 2

/// Whether effect variable v is of kind k (evar_kind).
fn (c: Checker) evar_is(v: Int, k: Int) -> Bool {
  v >= 0 && v < c.evar_kind.len() && c.evar_kind[v] == k
}

/// Marks effect variable v as of kind k.
fn (var c: Checker) mark_evar(v: Int, k: Int) {
  while c.evar_kind.len() <= v {
    c.evar_kind.push(0)
  }
  c.evar_kind[v] = k
}

/// An effect argument for a call's own effect parameter (EV_CALL).
fn (var c: Checker) call_effarg() -> Int {
  let s = c.fresh_eset()
  c.mark_evar(c.esets[s][0].evar, EV_CALL)
  c.new_ty(Ty{kind: TyKind.EffArg, eff: s})
}

/// Closes a call's open variables in set s to the empty set: those at
/// its top, and the tails reached through bound call variables.
fn (var c: Checker) close_eff(s: Int, top: Bool) {
  if s < 0 {
    return
  }
  for it in c.esets[s] {
    if it.evar < 0 {
      continue
    }
    let r = c.evars[it.evar]
    if r >= 0 {
      if c.evar_is(it.evar, EV_CALL) {
        c.close_eff(r, false)
      }
    } else if top || c.evar_is(it.evar, EV_TAIL) {
      c.bind_eff(it.evar, c.new_eset([]))
    }
  }
}

fn (var c: Checker) effarg(s: Int) -> Int {
  c.new_ty(Ty{kind: TyKind.EffArg, eff: s})
}

/// The first unbound effect variable of set s, or -1.
fn (c: Checker) open_evar(s: Int) -> Int {
  if s < 0 {
    return -1
  }
  for it in c.esets[s] {
    if it.evar >= 0 {
      let r = c.evars[it.evar]
      if r < 0 {
        return it.evar
      }
      let v = c.open_evar(r)
      if v >= 0 {
        return v
      }
    }
  }
  -1
}

/// Binds effect variable v to set s, on the trail.
fn (var c: Checker) bind_eff(v: Int, s: Int) {
  c.evars[v] = s
  c.trail.push(-(v + 1))
}

/// Binds an open effect variable of either set to the other; two sets
/// with none open must be equal, which assignable checks (eff_eqs).
fn (var c: Checker) unify_eff(a: Int, b: Int) {
  let va = c.open_evar(a)
  if c.no_tail > 0 && (c.evar_is(va, EV_TAIL) || c.evar_is(c.open_evar(b), EV_TAIL)) {
    return
  }
  if va >= 0 && b >= 0 && c.open_evar(b) != va {
    c.bind_eff(va, b)
    if c.evar_is(va, EV_TAIL) {
      // a lower bound meets an exact set: the bound must be within it
      c.eff_pair(a, b)
    }
    return
  }
  let vb = c.open_evar(b)
  if vb >= 0 && a >= 0 && c.open_evar(a) != vb {
    c.bind_eff(vb, a)
    if c.evar_is(vb, EV_TAIL) {
      c.eff_pair(a, b)
    }
    return
  }
  if va < 0 && vb < 0 && a != b && (a >= 0 || b >= 0) {
    let ea = if a >= 0 { a } else { c.new_eset([]) }
    let eb = if b >= 0 { b } else { c.new_eset([]) }
    c.eff_pair(ea, eb)
  }
}

/// The equal effect sets unify met since eff_eqs had n entries become
/// obligations both ways at sp (core 6.2: a type's effect argument is
/// not widened or narrowed), for the expected type dst.
fn (var c: Checker) same_effects(n: Int, dst: Int, sp: Span) {
  var i = n
  while i < c.eff_eqs.len() {
    let (a, b) = c.eff_eqs[i]
    if sp.start.line > 0 {
      c.obligations.push(EffOb{kind: ObKind.Same, sub: a, sup: b, file: c.path, span: sp, ty: dst})
      c.obligations.push(EffOb{kind: ObKind.Same, sub: b, sup: a, file: c.path, span: sp, ty: dst})
    }
    i += 1
  }
  c.drop_eff_eqs(n)
}

/// Records sets a and b as equal while a checking site tracks them
/// (eff_track: assignable, join, ?); a hint's unify records nothing.
fn (var c: Checker) eff_pair(a: Int, b: Int) {
  if c.eff_track > 0 {
    c.eff_eqs.push((a, b))
  }
}

/// try_unify, recording the equal effect sets it meets (eff_eqs).
fn (var c: Checker) unify_tracked(a: Int, b: Int) -> Bool {
  c.eff_track += 1
  let ok = c.try_unify(a, b)
  c.eff_track -= 1
  ok
}

/// Forgets the equal effect sets past the first n.
fn (var c: Checker) drop_eff_eqs(n: Int) {
  while c.eff_eqs.len() > n {
    c.eff_eqs.pop()
  }
}

/// s with effect parameters replaced through sm (an effect parameter
/// maps to an EffArg type) and bound variables by what they stand for;
/// function items without a substitution get sm.
fn (var c: Checker) subst_eff(s: Int, sm: Subst, depth: Int) -> Int {
  if s < 0 || sm.is_empty() || depth > 50 {
    return s
  }
  var changes = false
  for it in c.esets[s] {
    if (it.evar >= 0 && c.evars[it.evar] >= 0) || (it.param >= 0 && sm.contains(it.param)) || (it.fn_obj >= 0 && !it.has_sub) {
      changes = true
    }
  }
  if !changes {
    return s
  }
  var out: List[EffItem] = []
  for it0 in c.esets[s] {
    var it = it0
    if it.evar >= 0 && c.evars[it.evar] >= 0 {
      let r = c.subst_eff(c.evars[it.evar], sm, depth + 1)
      for x in c.esets[r] {
        out.push(x)
      }
      continue
    }
    if it.fn_obj >= 0 && !it.has_sub {
      it.sub = sm
      it.has_sub = true
    }
    if it.param >= 0 {
      if let Some(t) = sm.get(it.param) {
        if c.tys[t].kind == TyKind.EffArg && c.tys[t].eff >= 0 {
          for x0 in c.esets[c.tys[t].eff] {
            var x = x0
            if x.from_param < 0 {
              x.from_param = it.param
            }
            if x.file.is_empty() {
              x.file = it.file
              x.span = it.span
              x.via = it.via
            }
            out.push(x)
          }
          continue
        }
      }
    }
    out.push(it)
  }
  c.new_eset(out)
}

/// The number of effect items the current body has performed so far.
fn (c: Checker) ctx_eff_len() -> Int {
  if c.ctx < 0 || c.ctxs[c.ctx].eff < 0 {
    return 0
  }
  c.esets[c.ctxs[c.ctx].eff].len()
}

/// XO0438 (decision 0558): the arguments of a log call, performed since
/// effect item eff0, include an effect other than `log`; they only run
/// when the record is written.
fn (var c: Checker) warn_lazy_log_args(call: Expr, fo: Int, eff0: Int) {
  if c.ctx < 0 || c.ctxs[c.ctx].eff < 0 {
    return
  }
  let items = c.esets[c.ctxs[c.ctx].eff]
  var i = eff0
  while i < items.len() {
    let it = items[i]
    if it.label != "" && it.label != "log" {
      let (span, _, _) = call_parts(call)
      c.warn("XO0438", span, "an argument of `${c.display_name(fo)}` performs `${it.label}`, but arguments are evaluated only when the record is at or above the configured level (decision 0558); do the work before the call if it must always run")
      return
    }
    i += 1
  }
}

/// The span of no place: an obligation needs a place to be recorded.
fn no_span() -> Span {
  Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
}

/// Adds the items of set s to the effects of the current body.
fn (var c: Checker) perform(s: Int) {
  if c.ctx < 0 || s < 0 {
    return
  }
  let e = c.ctxs[c.ctx].eff
  if e < 0 {
    return
  }
  // std's own logging stays ambient: a std or native module may write
  // log records without declaring `log` (decision 0156). The effect is
  // introduced only by the pub std/log functions, so dropping the `log`
  // label here keeps it off std's inferred effects; user code gets it.
  let strip = c.cur_mod >= 0 && (c.mods[c.cur_mod].is_std || c.mods[c.cur_mod].native)
  for it in c.esets[s] {
    if strip && it.label == "log" {
      continue
    }
    c.esets[e].push(it)
  }
}

/// The text of set s: its labels and effect parameters, sorted, joined
/// with ", " (effects.go EffSet.String: function items are dropped
/// unless they declare their effects).
pub fn (c: Checker) eff_text(s: Int) -> Str {
  if s < 0 {
    return ""
  }
  c.flat_text(c.flatten(s, false))
}

// ---------------------------------------------------------------------------
// Flattening and solving (effects.go flatten, solveEffects)

fn (f: Flat) size() -> Int {
  f.labels.len() + f.params.len()
}

/// Whether label l is in f directly or through its parent (`fs.read`
/// is covered by `fs`).
fn (f: Flat) covers_label(l: Str) -> Bool {
  if f.labels.contains(l) {
    return true
  }
  let b = l.bytes()
  for i in 0..b.len() {
    if b[i] == '.' {
      return i > 0 && f.labels.contains(b[..i].to_str() ?? "")
    }
  }
  false
}

/// The text of f: labels and parameter names, sorted, joined by ", ".
fn (c: Checker) flat_text(f: Flat) -> Str {
  var parts = f.labels
  for p in f.params {
    parts.push(text(c.objs[p].name))
  }
  parts.sort().join(", ")
}

/// Set s expanded; with_inferred uses the inferred effects of functions
/// (else their items are dropped).
fn (c: Checker) flatten(s: Int, with_inferred: Bool) -> Flat {
  var out = Flat{}
  c.flatten_into(out, s, with_inferred, 0, EffItem{})
  out
}

/// Expands set s into out; the items of s without a place are attributed
/// to the place of at (effects.go flattenInto of a set made by
/// EffSet.performed).
fn (c: Checker) flatten_into(var out: Flat, s: Int, with_inferred: Bool, depth: Int, at: EffItem) {
  if s < 0 || depth > 50 {
    return
  }
  for it0 in c.esets[s] {
    var it = it0
    if it.file.is_empty() && !at.file.is_empty() {
      it.file = at.file
      it.span = at.span
      it.via = at.via
    }
    if it.from_param < 0 {
      it.from_param = at.from_param
    }
    if !it.label.is_empty() {
      if !out.labels.contains(it.label) {
        out.labels.push(it.label)
        out.label_items.push(it)
      }
    } else if it.param >= 0 {
      if !out.params.contains(it.param) {
        out.params.push(it.param)
        out.param_items.push(it)
      }
    } else if it.evar >= 0 {
      c.flatten_into(out, c.evars[it.evar], with_inferred, depth + 1, EffItem{from_param: it.from_param})
    } else if it.fn_obj >= 0 {
      let d = c.objs[it.fn_obj].declared
      if d >= 0 {
        c.flatten_into(out, d, with_inferred, depth + 1, EffItem{file: it.file, span: it.span, via: c.display_name(it.fn_obj)})
        continue
      }
      if !with_inferred {
        continue
      }
      let fl = c.inferred.get(it.fn_obj) ?? Flat{}
      for l in fl.labels {
        if !out.labels.contains(l) {
          out.labels.push(l)
          out.label_items.push(it)
        }
      }
      for p in fl.params {
        if it.has_sub {
          if let Some(a) = it.sub.get(p) {
            if c.tys[a].kind == TyKind.EffArg {
              c.flatten_into(out, c.tys[a].eff, with_inferred, depth + 1, EffItem{file: it.file, span: it.span, via: it.via})
              continue
            }
          }
        }
        if !out.params.contains(p) {
          out.params.push(p)
          out.param_items.push(it)
        }
      }
    }
  }
}

/// Computes the effects of every inferred function by fixpoint, then
/// checks every obligation (XO0701).
fn (var c: Checker) solve_effects() {
  for f in c.inferred_fns {
    c.inferred[f] = Flat{}
  }
  var changed = true
  while changed {
    changed = false
    for f in c.inferred_fns {
      let nf = c.flatten(c.objs[f].body_eff, true)
      if nf.size() != (c.inferred.get(f) ?? Flat{}).size() {
        c.inferred[f] = nf
        changed = true
      }
    }
  }
  var seen: Map[Str, Bool] = {}
  // per declared function, the declared functions that call it and their
  // Decl obligations (built on the first XO0701 of a declaration)
  var callers: Map[Int, List[Int]] = {}
  var decl_ob: Map[Int, Int] = {}
  var callers_built = false
  for ob in c.obligations {
    let sub = c.flatten(ob.sub, true)
    let sup = c.flatten(ob.sup, true)
    var missing: List[Str] = []
    for l in sub.labels.sort() {
      if !sup.covers_label(l) {
        missing.push(l)
      }
    }
    var params: List[Str] = []
    for p in sub.params {
      if !sup.params.contains(p) {
        params.push(text(c.objs[p].name))
      }
    }
    for p in params.sort() {
      missing.push(p)
    }
    if missing.is_empty() {
      continue
    }
    // an exact set is checked both ways; one report per place
    let key = if ob.kind == ObKind.Same { "${ob.file}:${ob.span.start.offset}:${ob.span.end.offset}|same" } else { "${ob.file}:${ob.span.start.offset}:${ob.span.end.offset}|${missing.join(" ")}" }
    if seen.contains(key) {
      continue
    }
    seen[key] = true
    let list = "`${missing.join("`, `")}`"
    let msg = if ob.kind == ObKind.Pure {
      "contract clauses must be pure, but this one performs ${list}"
    } else if ob.kind == ObKind.Const {
      "a const initializer must be pure (it runs once, at the constant's first use; decision 0332), but this one performs ${list}"
    } else {
      // an interface's text names the method that performs them
      // ("..., but `T.m` performs `x`"; it read "..., but `T.m`, but
      // performs" until 2026-11-05)
      if ob.kind == ObKind.Iface { "${c.ob_what(ob, c.flat_text(sup))} performs ${list}" } else { "${c.ob_what(ob, c.flat_text(sup))}, but performs ${list}" }
    }
    let code = if ob.kind == ObKind.Const { "XO0415" } else { "XO0701" }
    let d = c.report(ob.file, code, ob.span, msg)
    if d < 0 {
      continue
    }
    c.elided_effect_note(d, sub, sup, ob)
    c.implicit_callee_note(d, sub, sup)
    // the corrected clause, when those notes gave no fix of their own
    // (theirs name an effect argument instead; lead, 2026-11-08)
    var uses_fix: (Str, DEdit, Str)? = None
    if ob.kind == ObKind.Decl && c.diags[d].fixes.is_empty() {
      uses_fix = c.uses_fix_edit(ob, missing, sub, sup)
      if let Some((_, _, clause)) = uses_fix {
        c.note(d, "declare them: `${clause}` (`xo fix` writes it)")
      }
    }
    var chain_edits: List[DEdit] = []
    // the item witnessing the first missing effect: a label, else a
    // parameter (in the order of sub)
    var first = EffItem{}
    var key0 = ""
    var found = false
    for l in sub.labels.sort() {
      if !sup.covers_label(l) {
        let k = sub.labels.index_of(l) ?? 0
        first = sub.label_items[k]
        key0 = l
        found = true
        break
      }
    }
    if !found {
      for (k, p) in sub.params.indexed() {
        if !sup.params.contains(p) {
          first = sub.param_items[k]
          key0 = text(c.objs[p].name)
          break
        }
      }
    }
    c.effect_chain(d, first, key0)
    // the callers that would miss the same labels once this one declares
    // them, in one note, so one round of edits fixes the chain (owner,
    // 2026-11-05, from the agents' survey: getcheck.xo's check_fetched,
    // then cli.xo's run_get, took two runs of xo check)
    if ob.kind == ObKind.Decl && ob.fo >= 0 {
      if !callers_built {
        let (cs, dob) = c.decl_callers()
        callers = cs
        decl_ob = dob
        callers_built = true
      }
      var labels: List[Str] = []
      for l in missing {
        if sub.labels.contains(l) {
          labels.push(l)
        }
      }
      if !labels.is_empty() {
        chain_edits = c.caller_chain_note(d, ob.fo, labels, callers, decl_ob)
      }
    }
    if let Some((title, e, _)) = uses_fix {
      // the callers' clauses in the same fix, so one `xo fix` checks clean
      var edits = [e]
      for ce in chain_edits {
        edits.push(ce)
      }
      c.fix(d, if chain_edits.is_empty() { title } else { "${title}, and in its callers" }, edits)
    }
  }
}

/// The direct callers of each function: of a declared one from the calls
/// that recorded them (declared_callers), of one whose effects are
/// inferred from the function items of each body's effects; and the
/// index in c.obligations of each declared function's Decl obligation.
fn (c: Checker) decl_callers() -> (Map[Int, List[Int]], Map[Int, Int]) {
  var callers: Map[Int, List[Int]] = c.declared_callers
  var decl_ob: Map[Int, Int] = {}
  var bodies: List[(Int, Int)] = []
  for (i, ob) in c.obligations.indexed() {
    if ob.kind == ObKind.Decl && ob.fo >= 0 {
      decl_ob[ob.fo] = i
      bodies.push((ob.fo, ob.sub))
    }
  }
  for f in c.inferred_fns {
    bodies.push((f, c.objs[f].body_eff))
  }
  for (f, s0) in bodies {
    var stack: List[Int] = [s0]
    var n = 0
    while !stack.is_empty() && n < 1000 {
      n += 1
      let set = stack.pop() ?? -1
      if set < 0 {
        continue
      }
      for it in c.esets[set] {
        if it.evar >= 0 {
          stack.push(c.evars[it.evar])
        } else if it.fn_obj >= 0 {
          var l = callers.get(it.fn_obj) ?? []
          if !l.contains(f) {
            l.push(f)
            callers[it.fn_obj] = l
          }
        }
      }
    }
  }
  (callers, decl_ob)
}

/// A note on d naming the declared functions above fo that would miss
/// labels once fo declares them (each caller's own declaration does not
/// cover them), walking up through those callers, at most 12; returns
/// the edits adding the labels each one lacks to its `uses` clause.
fn (var c: Checker) caller_chain_note(d: Int, fo: Int, labels: List[Str], callers: Map[Int, List[Int]], decl_ob: Map[Int, Int]) -> List[DEdit] {
  var found: List[Str] = []
  var edits: List[DEdit] = []
  var visited: Map[Int, Bool] = {}
  visited[fo] = true
  var queue: List[Int] = [fo]
  var qi = 0
  while qi < queue.len() && found.len() < 12 {
    let f = queue[qi]
    qi += 1
    for g in callers.get(f) ?? [] {
      if visited.contains(g) {
        continue
      }
      visited[g] = true
      let oi = decl_ob.get(g) ?? -1
      if oi < 0 {
        // its effects are inferred: they take the labels, and its own
        // callers are the next to check
        queue.push(g)
        continue
      }
      let gob = c.obligations[oi]
      let sup = c.flatten(gob.sup, true)
      if labels.all(fn(l) { sup.covers_label(l) }) {
        continue
      }
      found.push("`${c.display_name(g)}` (${gob.file}:${gob.span.start.line})")
      if let Some((_, e, _)) = uses_edit(gob, labels.filter(fn(l) { !sup.covers_label(l) })) {
        edits.push(e)
      }
      queue.push(g)
    }
  }
  if found.is_empty() {
    return edits
  }
  let list = "`${labels.join("`, `")}`"
  c.note(d, "once `${c.display_name(fo)}` declares ${list}, these callers need it too: ${found.join(", ")}")
  edits
}

/// The call chain that performs effect key, from item w, as notes on d
/// (effects.go effectChain, chainSteps).
fn (var c: Checker) effect_chain(d: Int, w0: EffItem, key: Str) {
  var w = w0
  var visited: List[Int] = []
  for _ in 0..20 {
    if w.fn_obj >= 0 && c.objs[w.fn_obj].declared < 0 {
      c.chain_note(d, w, "calls `${c.display_name(w.fn_obj)}`, which performs `${key}`")
      if visited.contains(w.fn_obj) {
        return
      }
      visited.push(w.fn_obj)
      let fl = match c.inferred.get(w.fn_obj) {
        Some(x) => x
        None => return
      }
      var next = EffItem{}
      var ok = false
      if let Some(k) = fl.labels.index_of(key) {
        next = fl.label_items[k]
        ok = true
      } else {
        for (k, p) in fl.params.indexed() {
          if text(c.objs[p].name) == key {
            next = fl.param_items[k]
            ok = true
          }
        }
      }
      if !ok {
        return
      }
      w = next
      continue
    }
    var via = w.via
    if w.fn_obj >= 0 {
      via = c.display_name(w.fn_obj)
    }
    if via.is_empty() {
      via = "this"
    }
    if !w.file.is_empty() {
      c.chain_note(d, w, "`${via}` uses `${key}` here")
    }
    return
  }
}

/// A note at the place of item w (its full span).
fn (var c: Checker) chain_note(d: Int, w: EffItem, msg: Str) {
  if w.file.is_empty() {
    c.diags[d].notes.push(DNote{message: msg, span: Some(JSpan{file: "", line: 0, col: 0})})
    return
  }
  c.diags[d].notes.push(DNote{message: msg, span: Some(JSpan{file: w.file, line: w.span.start.line, col: w.span.start.col, end_line: w.span.end.line, end_col: w.span.end.col})})
}

/// What an obligation requires, given the text of its allowed effects.
fn (c: Checker) ob_what(ob: EffOb, s: Str) -> Str {
  match ob.kind {
    Decl => {
      let name = c.display_name(ob.fo)
      if !s.is_empty() {
        return "`${name}` declares `uses ${s}`"
      }
      if c.objs[ob.fo].is_pub {
        return "`${name}` is pub with no `uses` clause, so it is pure"
      }
      "`${name}` is pure"
    }
    Closure => if s.is_empty() { "the closure declares no effects" } else { "the closure declares `uses ${s}`" }
    FuncType => if s.is_empty() { "the expected function type `${c.show(ob.ty)}` is pure" } else { "the expected function type allows only `${s}`" }
    Iface => {
      let head = "`${c.show_raw(ob.ty)}` is used as `${c.show_raw(ob.iface)}`, whose method `${ob.meth}`"
      if s.is_empty() {
        return "${head} is pure, but `${c.display_name(ob.fo)}`"
      }
      "${head} allows only `${s}`, but `${c.display_name(ob.fo)}`"
    }
    Same => if s.is_empty() { "the expected type `${c.show(ob.ty)}` fixes these effects as pure" } else { "the expected type `${c.show(ob.ty)}` fixes these effects as `${s}`" }
    Pure | Const => ""
  }
}

/// The effects of the current body while f runs go to a set of their
/// own; a contract expression must perform none (stmt.go pureClause).
fn (var c: Checker) pure_start() -> Int {
  let saved = c.ctxs[c.ctx].eff
  c.ctxs[c.ctx].eff = c.new_eset([])
  saved
}

fn (var c: Checker) pure_end(saved: Int, sp: Span) {
  let sink = c.ctxs[c.ctx].eff
  c.ctxs[c.ctx].eff = saved
  if !c.esets[sink].is_empty() {
    c.obligations.push(EffOb{kind: ObKind.Pure, sub: sink, sup: c.new_eset([]), file: c.path, span: sp})
  }
}
