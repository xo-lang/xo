// Effect sets (internal/check/effects.go): the `uses` of a function
// type and the effect arguments of a type (`Cache[K, V, E, net.dial]`),
// with effect variables bound by unification; the effects each body
// performs, the inferred effects of functions that are not pub
// (solve_effects, a fixpoint), and the obligations checked against them
// (XO0701), stage 4 of decision 0141.

use github.com/xo-lang/xo/compiler/parser

/// One member of an effect set: a label, an effect parameter (a TParam
/// object), an effect variable, or the (inferred) effects of a function
/// that is not pub, with the substitution of its effect parameters at
/// the call (has_sub: one was given).
pub struct EffItem {
  pub label: Str = ""
  pub param: Int = -1
  pub evar: Int = -1
  pub fn_obj: Int = -1
  pub sub: Map[Int, Int] = {}
  pub has_sub: Bool = false
  /// Where the effect is performed (file "" for nowhere: a declaration's
  /// item) and through which callee, for the call chain of XO0701.
  pub file: Str = ""
  pub span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  pub via: Str = ""
}

/// An effect set with function items expanded: its labels and effect
/// parameters, each with the item that witnesses it (effects.go
/// flatEff).
pub struct Flat {
  pub labels: List[Str] = []
  pub params: List[Int] = []
  pub label_items: List[EffItem] = []
  pub param_items: List[EffItem] = []
}

/// A copy of set s whose items without a place are attributed to the call
/// at sp in file of the callee via (effects.go EffSet.performed).
fn (var c: Checker) performed(s: Int, file: Str, sp: Span, via: Str) -> Int {
  if s < 0 {
    return s
  }
  var out: List[EffItem] = []
  for it0 in c.esets[s] {
    var it = it0
    if it.file.is_empty() {
      it.file = file
      it.span = sp
      it.via = via
    }
    out.push(it)
  }
  c.new_eset(out)
}

/// The kind of requirement an obligation states, for its message.
enum ObKind {
  /// A function declaration's `uses` (or none, when pub).
  Decl
  /// A closure's `uses`.
  Closure
  /// A function value used where a function type is expected.
  FuncType
  /// A method that implements an interface method.
  Iface
  /// A contract clause or invariant, which must be pure.
  Pure
  /// An effect set fixed by a type (an effect argument, a function type
  /// inside a type), which must match exactly (core 6.2).
  Same
  /// A const initializer, which must be pure (decision 0332, XO0415).
  Const
}

/// The effects of sub must be within those of sup (effects.go
/// effObligation), reported at span of file.
struct EffOb {
  kind: ObKind
  sub: Int
  sup: Int
  file: Str
  span: Span
  /// Decl: the function; Iface: the method.
  fo: Int = -1
  /// FuncType: the expected function type; Iface: the type used.
  ty: Int = -1
  /// Iface: the interface type and the interface method's name.
  iface: Int = -1
  meth: Str = ""
  /// Closure: its ` uses ...` clause (file "" for none), which a fix may
  /// remove so its effects are inferred.
  uses_file: Str = ""
  uses_clause: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
  /// Decl: the fix that adds `log` to the `uses` clause when only `log`
  /// is missing (decision 0156); empty when no fix applies.
  log_title: Str = ""
  log_edits: List[DEdit] = []
}

/// The fix that adds `log` to a function's `uses` clause when only `log`
/// is missing (habits.go addLogFix, decision 0156): append `, log` to an
/// existing clause, or a new `uses log` after the signature.
fn (c: Checker) log_fix(fd: parser.FnDecl) -> (Str, List[DEdit]) {
  for cl in fd.clauses {
    match cl {
      parser.Clause.UsesClause(_, effects, _) => {
        if !effects.is_empty() {
          let last = effects[effects.len() - 1].span
          return ("add `log` to the `uses` clause", [c.insert_edit(last.end, ", log")])
        }
      }
      _ => {}
    }
  }
  if let Some(es) = fd.err {
    return ("add a `uses log` clause", [c.insert_edit(es.span.end, " uses log")])
  }
  if let Some(t) = fd.result {
    return ("add a `uses log` clause", [c.insert_edit(parser.type_span(t).end, " uses log")])
  }
  ("", [])
}

/// The note on an XO0701 whose missing effect is an elided effect
/// parameter (habits.go elidedEffectNote), with the fix removing the
/// closure's `uses` clause.
fn (var c: Checker) elided_effect_note(d: Int, sub: Flat, sup: Flat, ob: EffOb) {
  for p in sub.params {
    let o = c.objs[p]
    if sup.params.contains(p) || !o.elided || o.elided_file.is_empty() {
      continue
    }
    var tn = o.elided_text
    if let Some(i) = tn.find("[") {
      tn = text(tn.bytes()[0..i])
    }
    c.diags[d].notes.push(DNote{message: "`${text(o.name)}` is the effect argument left out of `${o.elided_text}` here; an omitted effect argument stays an abstract effect variable of the function (core 6.2), as Rust and TypeScript generics would infer it, so a `uses` list cannot name it: write the effect argument, `${tn}[..., net.dial]` naming the effects of the value passed in, or let the closure's effects be inferred", span: Some(JSpan{file: o.elided_file, line: o.elided_at.start.line, col: o.elided_at.start.col})})
    if !ob.uses_file.is_empty() {
      c.fix(d, "remove the closure's `uses` clause so its effects are inferred", [DEdit{span: JSpan{file: ob.uses_file, line: ob.uses_clause.start.line, col: ob.uses_clause.start.col, end_line: ob.uses_clause.end.line, end_col: ob.uses_clause.end.col}, replace: ""}])
    }
    return
  }
}

/// A new effect set (an index into esets).
fn (var c: Checker) new_eset(items: List[EffItem]) -> Int {
  let i = c.esets.len()
  c.esets.push(items)
  i
}

/// A set holding one fresh effect variable.
fn (var c: Checker) fresh_eset() -> Int {
  let v = c.evars.len()
  c.evars.push(-1)
  c.new_eset([EffItem{evar: v}])
}

/// An effect argument holding a fresh effect variable.
fn (var c: Checker) fresh_effarg() -> Int {
  let s = c.fresh_eset()
  c.new_ty(Ty{kind: TyKind.EffArg, eff: s})
}

/// evar_kind values: a call's own effect variable, and a tail.
const EV_CALL = 1
const EV_TAIL = 2

/// Whether effect variable v is of kind k (evar_kind).
fn (c: Checker) evar_is(v: Int, k: Int) -> Bool {
  v >= 0 && v < c.evar_kind.len() && c.evar_kind[v] == k
}

/// Marks effect variable v as of kind k.
fn (var c: Checker) mark_evar(v: Int, k: Int) {
  while c.evar_kind.len() <= v {
    c.evar_kind.push(0)
  }
  c.evar_kind[v] = k
}

/// An effect argument for a call's own effect parameter (EV_CALL).
fn (var c: Checker) call_effarg() -> Int {
  let s = c.fresh_eset()
  c.mark_evar(c.esets[s][0].evar, EV_CALL)
  c.new_ty(Ty{kind: TyKind.EffArg, eff: s})
}

/// Closes a call's open variables in set s to the empty set: those at
/// its top, and the tails reached through bound call variables.
fn (var c: Checker) close_eff(s: Int, top: Bool) {
  if s < 0 {
    return
  }
  for it in c.esets[s] {
    if it.evar < 0 {
      continue
    }
    let r = c.evars[it.evar]
    if r >= 0 {
      if c.evar_is(it.evar, EV_CALL) {
        c.close_eff(r, false)
      }
    } else if top || c.evar_is(it.evar, EV_TAIL) {
      c.bind_eff(it.evar, c.new_eset([]))
    }
  }
}

fn (var c: Checker) effarg(s: Int) -> Int {
  c.new_ty(Ty{kind: TyKind.EffArg, eff: s})
}

/// The first unbound effect variable of set s, or -1.
fn (c: Checker) open_evar(s: Int) -> Int {
  if s < 0 {
    return -1
  }
  for it in c.esets[s] {
    if it.evar >= 0 {
      let r = c.evars[it.evar]
      if r < 0 {
        return it.evar
      }
      let v = c.open_evar(r)
      if v >= 0 {
        return v
      }
    }
  }
  -1
}

/// Binds effect variable v to set s, on the trail.
fn (var c: Checker) bind_eff(v: Int, s: Int) {
  c.evars[v] = s
  c.trail.push(-(v + 1))
}

/// Binds an open effect variable of either set to the other; two sets
/// with none open must be equal, which assignable checks (eff_eqs).
fn (var c: Checker) unify_eff(a: Int, b: Int) {
  let va = c.open_evar(a)
  if c.no_tail > 0 && (c.evar_is(va, EV_TAIL) || c.evar_is(c.open_evar(b), EV_TAIL)) {
    return
  }
  if va >= 0 && b >= 0 && c.open_evar(b) != va {
    c.bind_eff(va, b)
    if c.evar_is(va, EV_TAIL) {
      // a lower bound meets an exact set: the bound must be within it
      c.eff_pair(a, b)
    }
    return
  }
  let vb = c.open_evar(b)
  if vb >= 0 && a >= 0 && c.open_evar(a) != vb {
    c.bind_eff(vb, a)
    if c.evar_is(vb, EV_TAIL) {
      c.eff_pair(a, b)
    }
    return
  }
  if va < 0 && vb < 0 && a != b && (a >= 0 || b >= 0) {
    let ea = if a >= 0 { a } else { c.new_eset([]) }
    let eb = if b >= 0 { b } else { c.new_eset([]) }
    c.eff_pair(ea, eb)
  }
}

/// The equal effect sets unify met since eff_eqs had n entries become
/// obligations both ways at sp (core 6.2: a type's effect argument is
/// not widened or narrowed), for the expected type dst.
fn (var c: Checker) same_effects(n: Int, dst: Int, sp: Span) {
  var i = n
  while i < c.eff_eqs.len() {
    let (a, b) = c.eff_eqs[i]
    if sp.start.line > 0 {
      c.obligations.push(EffOb{kind: ObKind.Same, sub: a, sup: b, file: c.path, span: sp, ty: dst})
      c.obligations.push(EffOb{kind: ObKind.Same, sub: b, sup: a, file: c.path, span: sp, ty: dst})
    }
    i += 1
  }
  c.drop_eff_eqs(n)
}

/// Records sets a and b as equal while a checking site tracks them
/// (eff_track: assignable, join, ?); a hint's unify records nothing.
fn (var c: Checker) eff_pair(a: Int, b: Int) {
  if c.eff_track > 0 {
    c.eff_eqs.push((a, b))
  }
}

/// try_unify, recording the equal effect sets it meets (eff_eqs).
fn (var c: Checker) unify_tracked(a: Int, b: Int) -> Bool {
  c.eff_track += 1
  let ok = c.try_unify(a, b)
  c.eff_track -= 1
  ok
}

/// Forgets the equal effect sets past the first n.
fn (var c: Checker) drop_eff_eqs(n: Int) {
  while c.eff_eqs.len() > n {
    c.eff_eqs.pop()
  }
}

/// s with effect parameters replaced through sm (an effect parameter
/// maps to an EffArg type) and bound variables by what they stand for;
/// function items without a substitution get sm.
fn (var c: Checker) subst_eff(s: Int, sm: Subst, depth: Int) -> Int {
  if s < 0 || sm.is_empty() || depth > 50 {
    return s
  }
  var changes = false
  for it in c.esets[s] {
    if (it.evar >= 0 && c.evars[it.evar] >= 0) || (it.param >= 0 && sm.contains(it.param)) || (it.fn_obj >= 0 && !it.has_sub) {
      changes = true
    }
  }
  if !changes {
    return s
  }
  var out: List[EffItem] = []
  for it0 in c.esets[s] {
    var it = it0
    if it.evar >= 0 && c.evars[it.evar] >= 0 {
      let r = c.subst_eff(c.evars[it.evar], sm, depth + 1)
      for x in c.esets[r] {
        out.push(x)
      }
      continue
    }
    if it.fn_obj >= 0 && !it.has_sub {
      it.sub = sm
      it.has_sub = true
    }
    if it.param >= 0 {
      if let Some(t) = sm.get(it.param) {
        if c.tys[t].kind == TyKind.EffArg && c.tys[t].eff >= 0 {
          for x0 in c.esets[c.tys[t].eff] {
            var x = x0
            if x.file.is_empty() {
              x.file = it.file
              x.span = it.span
              x.via = it.via
            }
            out.push(x)
          }
          continue
        }
      }
    }
    out.push(it)
  }
  c.new_eset(out)
}

/// The span of no place: an obligation needs a place to be recorded.
fn no_span() -> Span {
  Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
}

/// Adds the items of set s to the effects of the current body.
fn (var c: Checker) perform(s: Int) {
  if c.ctx < 0 || s < 0 {
    return
  }
  let e = c.ctxs[c.ctx].eff
  if e < 0 {
    return
  }
  // std's own logging stays ambient: a std or native module may write
  // log records without declaring `log` (decision 0156). The effect is
  // introduced only by the pub std/log functions, so dropping the `log`
  // label here keeps it off std's inferred effects; user code gets it.
  let strip = c.cur_mod >= 0 && (c.mods[c.cur_mod].is_std || c.mods[c.cur_mod].native)
  for it in c.esets[s] {
    if strip && it.label == "log" {
      continue
    }
    c.esets[e].push(it)
  }
}

/// The text of set s: its labels and effect parameters, sorted, joined
/// with ", " (effects.go EffSet.String: function items are dropped
/// unless they declare their effects).
fn (c: Checker) eff_text(s: Int) -> Str {
  if s < 0 {
    return ""
  }
  c.flat_text(c.flatten(s, false))
}

// ---------------------------------------------------------------------------
// Flattening and solving (effects.go flatten, solveEffects)

fn (f: Flat) size() -> Int {
  f.labels.len() + f.params.len()
}

/// Whether label l is in f directly or through its parent (`fs.read`
/// is covered by `fs`).
fn (f: Flat) covers_label(l: Str) -> Bool {
  if f.labels.contains(l) {
    return true
  }
  let b = l.bytes()
  for i in 0..b.len() {
    if b[i] == '.' {
      return i > 0 && f.labels.contains(b[..i].to_str() ?? "")
    }
  }
  false
}

/// The text of f: labels and parameter names, sorted, joined by ", ".
fn (c: Checker) flat_text(f: Flat) -> Str {
  var parts = f.labels
  for p in f.params {
    parts.push(text(c.objs[p].name))
  }
  parts.sort().join(", ")
}

/// Set s expanded; with_inferred uses the inferred effects of functions
/// (else their items are dropped).
fn (c: Checker) flatten(s: Int, with_inferred: Bool) -> Flat {
  var out = Flat{}
  c.flatten_into(out, s, with_inferred, 0, EffItem{})
  out
}

/// Expands set s into out; the items of s without a place are attributed
/// to the place of at (effects.go flattenInto of a set made by
/// EffSet.performed).
fn (c: Checker) flatten_into(var out: Flat, s: Int, with_inferred: Bool, depth: Int, at: EffItem) {
  if s < 0 || depth > 50 {
    return
  }
  for it0 in c.esets[s] {
    var it = it0
    if it.file.is_empty() && !at.file.is_empty() {
      it.file = at.file
      it.span = at.span
      it.via = at.via
    }
    if !it.label.is_empty() {
      if !out.labels.contains(it.label) {
        out.labels.push(it.label)
        out.label_items.push(it)
      }
    } else if it.param >= 0 {
      if !out.params.contains(it.param) {
        out.params.push(it.param)
        out.param_items.push(it)
      }
    } else if it.evar >= 0 {
      c.flatten_into(out, c.evars[it.evar], with_inferred, depth + 1, EffItem{})
    } else if it.fn_obj >= 0 {
      let d = c.objs[it.fn_obj].declared
      if d >= 0 {
        c.flatten_into(out, d, with_inferred, depth + 1, EffItem{file: it.file, span: it.span, via: c.display_name(it.fn_obj)})
        continue
      }
      if !with_inferred {
        continue
      }
      let fl = c.inferred.get(it.fn_obj) ?? Flat{}
      for l in fl.labels {
        if !out.labels.contains(l) {
          out.labels.push(l)
          out.label_items.push(it)
        }
      }
      for p in fl.params {
        if it.has_sub {
          if let Some(a) = it.sub.get(p) {
            if c.tys[a].kind == TyKind.EffArg {
              c.flatten_into(out, c.tys[a].eff, with_inferred, depth + 1, EffItem{file: it.file, span: it.span, via: it.via})
              continue
            }
          }
        }
        if !out.params.contains(p) {
          out.params.push(p)
          out.param_items.push(it)
        }
      }
    }
  }
}

/// Computes the effects of every inferred function by fixpoint, then
/// checks every obligation (XO0701).
fn (var c: Checker) solve_effects() {
  for f in c.inferred_fns {
    c.inferred[f] = Flat{}
  }
  var changed = true
  while changed {
    changed = false
    for f in c.inferred_fns {
      let nf = c.flatten(c.objs[f].body_eff, true)
      if nf.size() != (c.inferred.get(f) ?? Flat{}).size() {
        c.inferred[f] = nf
        changed = true
      }
    }
  }
  var seen: Map[Str, Bool] = {}
  for ob in c.obligations {
    let sub = c.flatten(ob.sub, true)
    let sup = c.flatten(ob.sup, true)
    var missing: List[Str] = []
    for l in sub.labels.sort() {
      if !sup.covers_label(l) {
        missing.push(l)
      }
    }
    var params: List[Str] = []
    for p in sub.params {
      if !sup.params.contains(p) {
        params.push(text(c.objs[p].name))
      }
    }
    for p in params.sort() {
      missing.push(p)
    }
    if missing.is_empty() {
      continue
    }
    // an exact set is checked both ways; one report per place
    let key = if ob.kind == ObKind.Same { "${ob.file}:${ob.span.start.offset}:${ob.span.end.offset}|same" } else { "${ob.file}:${ob.span.start.offset}:${ob.span.end.offset}|${missing.join(" ")}" }
    if seen.contains(key) {
      continue
    }
    seen[key] = true
    let list = "`${missing.join("`, `")}`"
    let msg = if ob.kind == ObKind.Pure {
      "contract clauses must be pure, but this one performs ${list}"
    } else if ob.kind == ObKind.Const {
      "a const initializer must be pure (it runs once, at the constant's first use; decision 0332), but this one performs ${list}"
    } else {
      "${c.ob_what(ob, c.flat_text(sup))}, but performs ${list}"
    }
    let code = if ob.kind == ObKind.Const { "XO0415" } else { "XO0701" }
    let d = c.report(ob.file, code, ob.span, msg)
    if d < 0 {
      continue
    }
    if missing.len() == 1 && missing[0] == "log" && !ob.log_title.is_empty() {
      c.fix(d, ob.log_title, ob.log_edits)
    }
    c.elided_effect_note(d, sub, sup, ob)
    // the item witnessing the first missing effect: a label, else a
    // parameter (in the order of sub)
    var first = EffItem{}
    var key0 = ""
    var found = false
    for l in sub.labels.sort() {
      if !sup.covers_label(l) {
        let k = sub.labels.index_of(l) ?? 0
        first = sub.label_items[k]
        key0 = l
        found = true
        break
      }
    }
    if !found {
      for (k, p) in sub.params.indexed() {
        if !sup.params.contains(p) {
          first = sub.param_items[k]
          key0 = text(c.objs[p].name)
          break
        }
      }
    }
    c.effect_chain(d, first, key0)
  }
}

/// The call chain that performs effect key, from item w, as notes on d
/// (effects.go effectChain, chainSteps).
fn (var c: Checker) effect_chain(d: Int, w0: EffItem, key: Str) {
  var w = w0
  var visited: List[Int] = []
  for _ in 0..20 {
    if w.fn_obj >= 0 && c.objs[w.fn_obj].declared < 0 {
      c.chain_note(d, w, "calls `${c.display_name(w.fn_obj)}`, which performs `${key}`")
      if visited.contains(w.fn_obj) {
        return
      }
      visited.push(w.fn_obj)
      let fl = match c.inferred.get(w.fn_obj) {
        Some(x) => x
        None => return
      }
      var next = EffItem{}
      var ok = false
      if let Some(k) = fl.labels.index_of(key) {
        next = fl.label_items[k]
        ok = true
      } else {
        for (k, p) in fl.params.indexed() {
          if text(c.objs[p].name) == key {
            next = fl.param_items[k]
            ok = true
          }
        }
      }
      if !ok {
        return
      }
      w = next
      continue
    }
    var via = w.via
    if w.fn_obj >= 0 {
      via = c.display_name(w.fn_obj)
    }
    if via.is_empty() {
      via = "this"
    }
    if !w.file.is_empty() {
      c.chain_note(d, w, "`${via}` uses `${key}` here")
    }
    return
  }
}

/// A note at the place of item w (its full span).
fn (var c: Checker) chain_note(d: Int, w: EffItem, msg: Str) {
  if w.file.is_empty() {
    c.diags[d].notes.push(DNote{message: msg, span: Some(JSpan{file: "", line: 0, col: 0})})
    return
  }
  c.diags[d].notes.push(DNote{message: msg, span: Some(JSpan{file: w.file, line: w.span.start.line, col: w.span.start.col, end_line: w.span.end.line, end_col: w.span.end.col})})
}

/// What an obligation requires, given the text of its allowed effects.
fn (c: Checker) ob_what(ob: EffOb, s: Str) -> Str {
  match ob.kind {
    Decl => {
      let name = c.display_name(ob.fo)
      if !s.is_empty() {
        return "`${name}` declares `uses ${s}`"
      }
      if c.objs[ob.fo].is_pub {
        return "`${name}` is pub with no `uses` clause, so it is pure"
      }
      "`${name}` is pure"
    }
    Closure => if s.is_empty() { "the closure declares no effects" } else { "the closure declares `uses ${s}`" }
    FuncType => if s.is_empty() { "the expected function type `${c.show(ob.ty)}` is pure" } else { "the expected function type allows only `${s}`" }
    Iface => {
      let head = "`${c.show_raw(ob.ty)}` is used as `${c.show_raw(ob.iface)}`, whose method `${ob.meth}`"
      if s.is_empty() {
        return "${head} is pure, but `${c.display_name(ob.fo)}`"
      }
      "${head} allows only `${s}`, but `${c.display_name(ob.fo)}`"
    }
    Same => if s.is_empty() { "the expected type `${c.show(ob.ty)}` fixes these effects as pure" } else { "the expected type `${c.show(ob.ty)}` fixes these effects as `${s}`" }
    Pure | Const => ""
  }
}

/// The effects of the current body while f runs go to a set of their
/// own; a contract expression must perform none (stmt.go pureClause).
fn (var c: Checker) pure_start() -> Int {
  let saved = c.ctxs[c.ctx].eff
  c.ctxs[c.ctx].eff = c.new_eset([])
  saved
}

fn (var c: Checker) pure_end(saved: Int, sp: Span) {
  let sink = c.ctxs[c.ctx].eff
  c.ctxs[c.ctx].eff = saved
  if !c.esets[sink].is_empty() {
    c.obligations.push(EffOb{kind: ObKind.Pure, sub: sink, sup: c.new_eset([]), file: c.path, span: sp})
  }
}
