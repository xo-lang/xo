{
  "comment": "Highlights ```xo fenced code blocks in Markdown with source.xo.",
  "scopeName": "markdown.xo.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#xo-code-block" }],
  "repository": {
    "xo-code-block": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(xo)(?:\\s+[^`~]*)?$)",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.xo",
          "patterns": [{ "include": "source.xo" }]
        }
      ]
    }
  }
}
