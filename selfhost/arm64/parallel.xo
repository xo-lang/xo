// Parallel generation (bench/results/fast-builds-2026-10-13.md): the
// functions of a large module are cut into parts by their size, each
// part generated by its own emitter on a task, its string, position,
// and helper labels in a namespace of its own ("pN_"), and the parts'
// assembly joined in order. The parts depend only on the module, never
// on the number of tasks, so the assembly is the same for any number of
// jobs; a module of one part is generated as before.

use github.com/xo-lang/xo/selfhost/ssa

/// A module of fewer functions than PART_FUNCS is one part. A larger one
/// is cut by its contents (decision 0220 addendum): after a function whose
/// name hashes to 0 modulo PART_CUT once the part has PART_MIN functions,
/// or at PART_MAX functions; a short last part joins the one before. An
/// edit moves the cuts of its own part at most, so the other parts'
/// assembly (and their cached objects) stay the same.
const PART_FUNCS = 256
const PART_MIN = 64
const PART_CUT = 128
const PART_MAX = 512

/// What one part generated: its assembly (text, helpers, call site
/// tables, data), its failure and skipped functions, and the program
/// wide code it needs.
struct Part {
  asm: Str = ""
  err: Str = ""
  skipped: List[Str] = []
  restorer_ref: Bool = false
  words_ref: Bool = false
  static_ref: Bool = false
  clone_ref: Bool = false
  sched_ref: Bool = false
  personality_ref: Bool = false
  wants: List[Want] = []
}

/// A helper a part uses, generated by the last file: op 0 rc_helper(kind,
/// t), 1 elem_helper(kind, t), 2 env_drop(fi), 3 env_share(fi), 4
/// eq_helper(t), 5 box_share(t), 6 box_drop(t), 7 mem_drop(t).
struct Want {
  op: Int
  kind: Str = ""
  t: Int = -1
  fi: Int = -1
}

/// For a part of a split generation (defer_helpers): records the helper
/// of key under its global name (helper_ext) and reports true, its body
/// left to the last file; false otherwise.
fn (var g: G) defers(key: Str, w: Want) -> Bool {
  if !g.defer_helpers {
    return false
  }
  g.helped[key] = g.helper_ext(key)
  g.wants.push(w)
  true
}

/// The global name of the helper of key in a split generation: xo_h and
/// the FNV-1a hash of the key, so every part names it alike.
fn (g: G) helper_ext(key: Str) -> Str {
  // 60 bits of it in ten base 62 digits: the name is in every call of
  // the helper (millions of lines of selfhost/xo), so it is kept short
  g.sym("xo_h${base62(fnv(key), 10)}")
}

/// The FNV-1a hash of s.
fn fnv(s: Str) -> Int {
  var h = -3750763034362895579
  for c in s.bytes() {
    h = (h ^ Int(c)).wrapping_mul(1099511628211)
  }
  h
}

/// The low 60 bits of h in n base 62 digits, the lowest first.
fn base62(h: Int, n: Int) -> Str {
  let digits = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
  var v = h & 1152921504606846975
  var b = StrBuilder.new()
  for _ in 0..n {
    let d = v % 62
    b.write(digits[d..d + 1])
    v = v / 62
  }
  b.freeze()
}

/// The global label that names the helper of key in the last file of a
/// split generation, before its local label; "" otherwise. Two keys of
/// one global name fail the generation.
fn (var g: G) alias(key: Str) -> Str {
  if !g.split || g.defer_helpers {
    return ""
  }
  let ext = g.helper_ext(key)
  if let Some(k) = g.ext_keys.get(ext) {
    if k != key {
      g.fail("helpers `${k}` and `${key}` have one name ${ext}")
    }
  }
  g.ext_keys[ext] = key
  "${g.hidden_global(ext)}${ext}:\n"
}

/// Generates the helper a part wanted (Want), once.
fn (var g: G) gen_want(w: Want) {
  match w.op {
    0 => {
      let _s = g.rc_helper(w.kind, w.t)
    }
    1 => {
      let _s = g.elem_helper(w.kind, w.t)
    }
    2 => {
      let _s = g.env_drop(w.fi)
    }
    3 => {
      let _s = g.env_share(w.fi)
    }
    4 => {
      let _s = g.eq_helper(w.t)
    }
    5 => {
      let _s = g.box_share(w.t)
    }
    7 => {
      let _s = g.mem_drop(w.t)
    }
    _ => {
      let _s = g.box_drop(w.t)
    }
  }
}

/// The first function of each part and, last, the count of functions
/// (the cuts by contents above); [0, n] is one part.
pub fn part_bounds(m: ssa.Module) -> List[Int] {
  let n = m.funcs.len()
  if n < PART_FUNCS {
    return [0, n]
  }
  var out = [0]
  var start = 0
  for (fi, f) in m.funcs.indexed() {
    let k = fi + 1 - start
    if fi + 1 < n && k >= PART_MIN && (k >= PART_MAX || fnv(f.name) % PART_CUT == 0) {
      out.push(fi + 1)
      start = fi + 1
    }
  }
  if out.len() > 1 && n - start < PART_MIN {
    out.pop()
  }
  out.push(n)
  out
}

/// The label namespace of each part: "p", the hash of its first
/// function's name, and "_", so a part's labels do not depend on the
/// parts before it; a repeated one gets the part's index too.
fn part_names(m: ssa.Module, bounds: List[Int]) -> List[Str] {
  var seen: Map[Str, Bool] = {}
  var out: List[Str] = []
  for p in 0..bounds.len() - 1 {
    var ns = "p${base62(fnv(m.funcs[bounds[p]].name), 6)}_"
    if let Some(_) = seen.get(ns) {
      ns = "${ns}${p}_"
    }
    seen[ns] = true
    out.push(ns)
  }
  out
}

/// Generates m (after the passes and inlining) for os on up to jobs
/// tasks: the assembly generate gives for a module of one part, else
/// the parts' assembly in order, then the entry, the exports, and the
/// program wide code once.
pub fn generate_parallel(m: ssa.Module, os: Str, jobs: Int) -> Program {
  let bounds = part_bounds(m)
  let np = bounds.len() - 1
  if np <= 1 {
    var g = new_gen(m, os)
    return g.generate()
  }
  var g = new_gen(m, os)
  g.find_addr_taken()
  let main = g.by_name.get("main") ?? -1
  if main < 0 {
    return Program{asm: "", err: "arm64 backend: no main", skipped: []}
  }
  let taken = g.addr_taken
  let names = part_names(m, bounds)
  var parts: List[Part] = []
  let w = jobs.min(np)
  if w <= 1 {
    for p in 0..np {
      parts.push(gen_part(m, os, taken, bounds[p], bounds[p + 1], names[p]))
    }
  } else {
    // each task takes the next part until none is left
    let next = Atomic[Int].new(0)
    let done = scope s {
      var ts = []
      for _ in 0..w {
        ts.push(s.spawn(fn() -> List[(Int, Part)] {
          var mine: List[(Int, Part)] = []
          while true {
            let p = next.add(1) - 1
            if p >= np {
              break
            }
            mine.push((p, gen_part(m, os, taken, bounds[p], bounds[p + 1], names[p])))
          }
          mine
        }))
      }
      var all: List[(Int, Part)] = []
      for t in ts {
        all = all + t.await
      }
      all
    }
    for _ in 0..np {
      parts.push(Part{})
    }
    for (p, part) in done {
      parts[p] = part
    }
  }
  // the last file: the entry and exports, and the program wide code the
  // parts use
  g.split = true
  g.entry(main)
  g.exports()
  var files: List[Str] = []
  var skipped: List[Str] = []
  for part in parts {
    files.push(part.asm)
    if g.err.is_empty() && !part.err.is_empty() {
      g.err = part.err
    }
    skipped = skipped + part.skipped
    g.restorer_ref = g.restorer_ref || part.restorer_ref
    g.words_ref = g.words_ref || part.words_ref
    g.static_ref = g.static_ref || part.static_ref
    g.clone_ref = g.clone_ref || part.clone_ref
    g.sched_ref = g.sched_ref || part.sched_ref
    g.personality_ref = g.personality_ref || part.personality_ref
    // the helpers the part named, each generated once
    for w in part.wants {
      g.gen_want(w)
    }
  }
  var out: List[Str] = []
  g.file_header(out)
  out.push(g.section("text"))
  out.push(g.text.join(""))
  out.push(g.helpers.join(""))
  g.trampolines(out)
  out.push(g.lsdas.join(""))
  g.shared_code(out)
  g.data(out)
  g.end_data(out)
  files.push(out.join(""))
  Program{asm: files.join(""), err: g.err, skipped: skipped + g.skipped, parts: files}
}

/// Part functions lo..hi of m by an emitter of its own, its labels in
/// namespace ns and its functions numbered from 0, as a file of its own.
fn gen_part(m: ssa.Module, os: Str, taken: Map[Str, Bool], lo: Int, hi: Int, ns: Str) -> Part {
  var g = new_gen(m, os)
  g.addr_taken = taken
  g.ns = ns
  g.split = true
  g.defer_helpers = true
  for fi in lo..hi {
    g.function(fi)
  }
  var out: List[Str] = []
  g.file_header(out)
  out.push(g.section("text"))
  out.push(g.text.join(""))
  out.push(g.lsdas.join(""))
  g.data(out)
  if os == "linux" {
    out.push("\t.section .note.GNU-stack,\"\",@progbits\n")
  }
  Part{asm: out.join(""), err: g.err, skipped: g.skipped, restorer_ref: g.restorer_ref, words_ref: g.words_ref, static_ref: g.static_ref, clone_ref: g.clone_ref, sched_ref: g.sched_ref, personality_ref: g.personality_ref, wants: g.wants}
}
