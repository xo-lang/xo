// DWARF line tables (decision 0239): each function emitted with debug
// information on records its source file, its begin and end labels, and
// a row label wherever the source line changes (emit.xo); the part's
// records become .debug_line (a DWARF 5 line program, one sequence per
// function), .debug_abbrev, and .debug_info (a compile unit with a
// subprogram per function). Addresses are `.quad label` (absolute
// relocations only, which every assembler and selfhost/macho handle);
// every length is counted here, so no label differences are needed.

/// The debug sections of the part, or "" with none.
fn (g: G) debug_sections(with_static: Bool) -> Str {
  if !g.m.debug_info || (g.dbgs.is_empty() && !with_static) {
    return ""
  }
  let mac = g.os == "darwin"
  // the functions: file, name, begin, end, rows (label, packed line,
  // inline site), inline sites (callee, file, call line, parent)
  var files: List[Str] = []
  var file_at: Map[Str, Int] = {}
  var recs: List[DbgFunc] = []
  for d in g.dbgs {
    let p = d.split("\t")
    if p.len() != 6 && p.len() != 7 {
      continue
    }
    let file = if p[0].is_empty() { "<generated>" } else { p[0] }
    let fi = file_index(file, files, file_at)
    var sites: List[DbgSite] = []
    if !p[5].is_empty() {
      for s in p[5].split(";") {
        let q = s.split("|")
        if q.len() == 4 {
          let sf = if q[1].is_empty() { file } else { q[1] }
          sites.push(DbgSite{callee: q[0], file: file_index(sf, files, file_at), call_line: Int.parse(q[2]) ?? 0, parent: Int.parse(q[3]) ?? -1})
        }
      }
    }
    var rows: List[DbgRow] = []
    for r in p[4].split(";") {
      let lr = r.split(" ")
      if lr.len() == 3 {
        let site = Int.parse(lr[2]) ?? -1
        let rf = if site >= 0 && site < sites.len() { sites[site].file } else { fi }
        rows.push(DbgRow{label: lr[0], line: Int.parse(lr[1]) ?? 0, file: rf, site: if site < sites.len() { site } else { -1 }})
      }
    }
    var vars: List[DbgVar] = []
    if p.len() == 7 && !p[6].is_empty() {
      for v in p[6].split(";") {
        let q = v.split("|")
        if q.len() != 5 {
          continue
        }
        var ents: List[DbgLoc] = []
        if !q[4].is_empty() {
          for e in q[4].split("~") {
            let t = e.split(" ")
            if t.len() == 3 {
              ents.push(DbgLoc{start: t[0], end: t[1], ops: t[2]})
            }
          }
        }
        vars.push(DbgVar{name: q[0], ty: q[1], param: q[2] == "1", line: Int.parse(q[3]) ?? 0, locs: ents})
      }
    }
    recs.push(DbgFunc{file: fi, name: p[1], begin: p[2], end: p[3], rows: rows, sites: sites, vars: vars})
  }
  if files.is_empty() {
    // a unit for xo_static alone (the last file of a split build)
    files.push("<generated>")
  }
  let dir = if g.m.comp_dir.is_empty() { "." } else { g.m.comp_dir }
  var out = StrBuilder.new()
  // .debug_line
  var hdr = Dw{}
  hdr.u8(1) // minimum_instruction_length
  hdr.u8(1) // maximum_operations_per_instruction
  hdr.u8(1) // default_is_stmt
  hdr.u8(251) // line_base -5
  hdr.u8(14) // line_range
  hdr.u8(13) // opcode_base
  for n in [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1] {
    hdr.u8(n)
  }
  // directories: the compile directory, and the one std/'s file names
  // are relative to
  let stdd = !g.m.std_root.is_empty()
  hdr.u8(1) // directory_entry_format_count
  hdr.uleb(1) // DW_LNCT_path
  hdr.uleb(8) // DW_FORM_string
  hdr.uleb(if stdd { 2 } else { 1 })
  hdr.str(dir)
  if stdd {
    hdr.str(g.m.std_root)
  }
  hdr.u8(2) // file_name_entry_format_count
  hdr.uleb(1) // DW_LNCT_path
  hdr.uleb(8) // DW_FORM_string
  hdr.uleb(2) // DW_LNCT_directory_index
  hdr.uleb(15) // DW_FORM_udata
  hdr.uleb(files.len())
  for f in files {
    hdr.str(f)
    hdr.uleb(if stdd && f.starts_with("std/") { 1 } else { 0 })
  }
  var prog = Dw{}
  for fr in recs {
    prog.u8(4) // DW_LNS_set_file
    prog.uleb(fr.file)
    var file = fr.file
    var line = 1
    // the sequence starts at the function (its prologue takes the first
    // statement's line), then a row per label (an inlined callee's rows
    // in its own file)
    var rows = fr.rows
    if !rows.is_empty() {
      rows.insert(0, DbgRow{label: fr.begin, line: rows[0].line, file: rows[0].file, site: rows[0].site})
    }
    for row in rows {
      let ln = row.line / 4096
      let col = row.line % 4096
      prog.u8(0)
      prog.uleb(9)
      prog.u8(2) // DW_LNE_set_address
      prog.quad(row.label)
      if row.file != file {
        prog.u8(4) // DW_LNS_set_file
        prog.uleb(row.file)
        file = row.file
      }
      if ln != line {
        prog.u8(3) // DW_LNS_advance_line
        prog.sleb(ln - line)
        line = ln
      }
      prog.u8(5) // DW_LNS_set_column
      prog.uleb(col)
      prog.u8(1) // DW_LNS_copy
    }
    prog.u8(0)
    prog.uleb(9)
    prog.u8(2)
    prog.quad(fr.end)
    prog.u8(0)
    prog.uleb(1)
    prog.u8(1) // DW_LNE_end_sequence
  }
  // unit_length covers version (2), sizes (2), header_length (4), the
  // header, and the program
  let line_len = 2 + 2 + 4 + hdr.n + prog.n
  out.write(if mac { "\t.section __DWARF,__debug_line,regular,debug\n" } else { "\t.section .debug_line,\"\",@progbits\n" })
  let line_lab = g.local("xo_dwline_${g.ns}")
  out.write("${line_lab}:\n")
  out.write("\t.long ${line_len}\n\t.short 5\n\t.byte 8\n\t.byte 0\n\t.long ${hdr.n}\n")
  out.write(hdr.text())
  out.write(prog.text())
  // .debug_abbrev
  out.write(if mac { "\t.section __DWARF,__debug_abbrev,regular,debug\n" } else { "\t.section .debug_abbrev,\"\",@progbits\n" })
  let abbrev_lab = g.local("xo_dwabbrev_${g.ns}")
  out.write("${abbrev_lab}:\n")
  // 1: compile_unit, children: stmt_list, low_pc, high_pc (the part's
  // functions are one run of its text; at fixed places, bytes 13, 17,
  // and 25, for selfhost/macho dsym.xo), producer, language, name,
  // comp_dir; 2: subprogram, children: name, low_pc, high_pc; 3: an
  // inlined callee's abstract subprogram: name, inline (1, inlined); 4:
  // inlined_subroutine, children (the calls inlined into it):
  // abstract_origin (unit relative), low_pc, high_pc, call_file,
  // call_line, call_column
  // (1 also: loclists_base and addr_base, at bytes 38 and 42, after the
  // language, for dsym.xo; dsymutil turns the location lists into
  // indexes of an address table and needs the unit's addr_base to give
  // it; decision 0252; for
  // dsym.xo; decision 0252) 5: base_type: name, encoding, byte_size; 6:
  // structure_type, children: name, byte_size; 7: member: name, type,
  // data_member_location; 8: variable and 9: formal_parameter: name,
  // type, decl_line, location (loclistx); 10: the global variable
  // xo_static (decision 0253: the debugger finds the runtime's records
  // through it): name, type, external, location (exprloc, DW_OP_addr);
  // 11: array_type, children: type; 12: subrange_type: count
  out.write("\t.byte 1, 0x11, 1, 0x10, 0x17, 0x11, 0x01, 0x12, 0x01, 0x25, 0x08, 0x13, 0x05, 0x8c, 0x01, 0x17, 0x73, 0x17, 0x03, 0x08, 0x1b, 0x08, 0, 0\n")
  out.write("\t.byte 2, 0x2e, 1, 0x03, 0x08, 0x11, 0x01, 0x12, 0x01, 0, 0\n")
  out.write("\t.byte 3, 0x2e, 0, 0x03, 0x08, 0x20, 0x0b, 0, 0\n")
  out.write("\t.byte 4, 0x1d, 1, 0x31, 0x13, 0x11, 0x01, 0x12, 0x01, 0x58, 0x0f, 0x59, 0x0f, 0x57, 0x0f, 0, 0\n")
  out.write("\t.byte 5, 0x24, 0, 0x03, 0x08, 0x3e, 0x0b, 0x0b, 0x0b, 0, 0\n")
  out.write("\t.byte 6, 0x13, 1, 0x03, 0x08, 0x0b, 0x0f, 0, 0\n")
  out.write("\t.byte 7, 0x0d, 0, 0x03, 0x08, 0x49, 0x13, 0x38, 0x0f, 0, 0\n")
  out.write("\t.byte 8, 0x34, 0, 0x03, 0x08, 0x49, 0x13, 0x3b, 0x0f, 0x02, 0x22, 0, 0\n")
  out.write("\t.byte 9, 0x05, 0, 0x03, 0x08, 0x49, 0x13, 0x3b, 0x0f, 0x02, 0x22, 0, 0\n")
  out.write("\t.byte 10, 0x34, 0, 0x03, 0x08, 0x49, 0x13, 0x3f, 0x19, 0x02, 0x18, 0, 0\n")
  out.write("\t.byte 11, 0x01, 1, 0x49, 0x13, 0, 0\n")
  out.write("\t.byte 12, 0x21, 0, 0x37, 0x05, 0, 0\n")
  out.write("\t.byte 0\n")
  // .debug_info
  var die = Dw{}
  die.uleb(1)
  die.offset(if mac { "0" } else { line_lab })
  let st = g.tramp("xo_static")
  die.quad(if recs.is_empty() { st } else { recs[0].begin })
  die.quad(if recs.is_empty() { st } else { recs[recs.len() - 1].end })
  die.str("xo")
  die.u16(0x0c) // DW_LANG_C99: no code for Xo
  // the offsets table of this unit's .debug_loclists, past its 12 byte
  // header (dsym.xo moves it by where the object's chunk lands)
  let ll_base = g.local("xo_dwllbase_${g.ns}")
  die.offset(if mac { "12" } else { ll_base })
  let addr_base = g.local("xo_dwaddrbase_${g.ns}")
  die.offset(if mac { "8" } else { addr_base })
  die.str(files[0])
  die.str(dir)
  // the types of the variables (unit relative offsets, by type name)
  var tys: Map[Str, Int] = {}
  for fr in recs {
    for v in fr.vars {
      let _t = g.dw_type(die, tys, v.ty)
    }
  }
  if with_static {
    // xo_static: STATIC_WORDS words (gen.xo end_data) of Int
    var it = tys.get("Int") ?? -1
    if it < 0 {
      it = 12 + die.n
      die.uleb(5)
      die.str("Int")
      die.u8(5) // DW_ATE_signed
      die.u8(8)
      tys["Int"] = it
    }
    let arr = 12 + die.n
    die.uleb(11)
    die.u32(it)
    die.uleb(12)
    die.u16(STATIC_WORDS)
    die.u8(0)
    die.uleb(10)
    die.str("xo_static")
    die.u32(arr)
    die.uleb(9) // the expression's length: DW_OP_addr and 8 bytes
    die.u8(0x03)
    die.quad(st)
  }
  var lists: List[List[DbgLoc]] = []
  // the runs of inlined code (outermost sites) of each function, and an
  // abstract subprogram per callee they name (unit relative offset: the
  // 12 byte unit header, then the entries)
  var origin: Map[Str, Int] = {}
  for fr in recs {
    for row in fr.rows {
      for s in site_chain(fr, row.site) {
        let callee = fr.sites[s].callee
        if !origin.contains(callee) {
          origin[callee] = 12 + die.n
          die.uleb(3)
          die.str(callee)
          die.u8(1)
        }
      }
    }
  }
  for fr in recs {
    die.uleb(2)
    die.str(fr.name)
    die.quad(fr.begin)
    die.quad(fr.end)
    var chains: List[List[Int]] = []
    for row in fr.rows {
      chains.push(site_chain(fr, row.site))
    }
    inline_level(die, fr, chains, origin, 0, fr.rows.len(), 0)
    // its variables (decision 0252), each with a location list
    for v in fr.vars {
      die.uleb(if v.param { 9 } else { 8 })
      die.str(v.name)
      die.u32(tys.get(v.ty) ?? 0)
      die.uleb(v.line / 4096)
      die.uleb(lists.len())
      lists.push(v.locs)
    }
    die.u8(0)
  }
  die.u8(0)
  // unit_length covers version (2), unit_type (1), address_size (1),
  // debug_abbrev_offset (4), and the entries
  out.write(if mac { "\t.section __DWARF,__debug_info,regular,debug\n" } else { "\t.section .debug_info,\"\",@progbits\n" })
  out.write("\t.long ${2 + 1 + 1 + 4 + die.n}\n\t.short 5\n\t.byte 1\n\t.byte 8\n")
  out.write("\t.long ${if mac { "0" } else { abbrev_lab }}\n")
  out.write(die.text())
  // .debug_loclists: the header, an offset per list (from the end of the
  // header, DW_AT_loclists_base), then the lists of DW_LLE_start_end
  // entries
  var body = Dw{}
  var offs: List[Int] = []
  for l in lists {
    offs.push(4 * lists.len() + body.n)
    for e in l {
      body.u8(7) // DW_LLE_start_end
      body.quad(e.start)
      body.quad(e.end)
      let ops = e.ops.split(",")
      body.uleb(ops.len())
      for o in ops {
        body.u8(Int.parse(o) ?? 0)
      }
    }
    body.u8(0) // DW_LLE_end_of_list
  }
  out.write(if mac { "\t.section __DWARF,__debug_loclists,regular,debug\n" } else { "\t.section .debug_loclists,\"\",@progbits\n" })
  out.write("\t.long ${2 + 1 + 1 + 4 + 4 * lists.len() + body.n}\n\t.short 5\n\t.byte 8\n\t.byte 0\n\t.long ${lists.len()}\n")
  out.write("${ll_base}:\n")
  for o in offs {
    out.write("\t.long ${o}\n")
  }
  out.write(body.text())
  // .debug_addr: an empty address table (addr_base above)
  out.write(if mac { "\t.section __DWARF,__debug_addr,regular,debug\n" } else { "\t.section .debug_addr,\"\",@progbits\n" })
  out.write("\t.long 4\n\t.short 5\n\t.byte 8\n\t.byte 0\n${addr_base}:\n")
  out.write(g.section("text"))
  out.freeze()
}

/// A function's debug record, parsed.
struct DbgFunc {
  file: Int
  name: Str
  begin: Str
  end: Str
  rows: List[DbgRow]
  sites: List[DbgSite]
  vars: List[DbgVar] = []
}

/// A variable of a function (dwvars.xo): its name, its type's name,
/// whether a parameter, its packed declaration line, and its locations.
struct DbgVar {
  name: Str
  ty: Str
  param: Bool
  line: Int
  locs: List[DbgLoc]
}

/// A location entry: from label start to label end, the bytes of a
/// DWARF expression (comma separated).
struct DbgLoc {
  start: Str
  end: Str
  ops: Str
}

/// The unit relative offset of the DWARF type named n (an SSA type of
/// the module, dwvars.xo dv_type_ok), written into die before the
/// subprograms the first time it is asked for, its fields' types first.
fn (g: G) dw_type(var die: Dw, var tys: Map[Str, Int], n: Str) -> Int {
  if let Some(o) = tys.get(n) {
    return o
  }
  let t = g.m.type_at.get(n) ?? -1
  if t < 0 {
    return 0
  }
  let x = g.m.types[t]
  let enc = match x.kind {
    Float => 4 // DW_ATE_float
    Bool => 2 // DW_ATE_boolean
    Int => if x.unsigned { 7 } else { 5 } // DW_ATE_unsigned, DW_ATE_signed
    _ => 0
  }
  if enc != 0 {
    let o = 12 + die.n
    die.uleb(5)
    die.str(n)
    die.u8(enc)
    die.u8(if enc == 4 && x.bits == 32 { 4 } else { 8 })
    tys[n] = o
    return o
  }
  // a struct or tuple: its fields at their word offsets
  var names: List[Str] = []
  var types: List[Int] = []
  if x.fields.is_empty() {
    for (i, e) in x.elems.indexed() {
      names.push("${i}")
      types.push(e)
    }
  } else {
    for f in x.fields {
      names.push(f.name)
      types.push(f.ty)
    }
  }
  var refs: List[Int] = []
  for ft in types {
    refs.push(g.dw_type(die, tys, g.m.types[ft].name))
  }
  let o = 12 + die.n
  die.uleb(6)
  die.str(n)
  die.uleb(8 * g.dw_words(t))
  var at = 0
  for (i, fname) in names.indexed() {
    die.uleb(7)
    die.str(fname)
    die.u32(refs[i])
    die.uleb(8 * at)
    at += g.dw_words(types[i])
  }
  die.u8(0)
  tys[n] = o
  o
}

/// The words of a type dw_type describes: one for Int, Float, and Bool,
/// the sum of the fields' for a struct or tuple (gen.xo layout's count).
fn (g: G) dw_words(t: Int) -> Int {
  let x = g.m.types[t]
  if x.fields.is_empty() && x.elems.is_empty() {
    return 1
  }
  var n = 0
  for f in x.fields {
    n += g.dw_words(f.ty)
  }
  for e in x.elems {
    n += g.dw_words(e)
  }
  n
}

/// A row: its label, packed line, file (the unit's index), and inline
/// site (-1: the function's own code).
struct DbgRow {
  label: Str
  line: Int
  file: Int
  site: Int
}

/// An inline site: the callee, its file, the call's packed line, and the
/// enclosing site (-1: the function).
struct DbgSite {
  callee: Str
  file: Int
  call_line: Int
  parent: Int
}

/// The index of file in files, added once.
fn file_index(file: Str, var files: List[Str], var at: Map[Str, Int]) -> Int {
  if let Some(k) = at.get(file) {
    return k
  }
  files.push(file)
  at[file] = files.len() - 1
  files.len() - 1
}

/// The inlined_subroutine entries of rows [i0, i1) of fr at nesting
/// level `level` (0: called from the function itself): consecutive rows
/// whose chain has the same site at that level make one, to the next
/// row (or the function's end), with the deeper levels inside it.
fn inline_level(var die: Dw, fr: DbgFunc, chains: List[List[Int]], origin: Map[Str, Int], i0: Int, i1: Int, level: Int) {
  var i = i0
  while i < i1 {
    let s = if level < chains[i].len() { chains[i][level] } else { -1 }
    if s < 0 {
      i += 1
      continue
    }
    var j = i + 1
    while j < i1 && level < chains[j].len() && chains[j][level] == s {
      j += 1
    }
    let site = fr.sites[s]
    die.uleb(4)
    die.u32(origin.get(site.callee) ?? 0)
    die.quad(fr.rows[i].label)
    die.quad(if j < fr.rows.len() { fr.rows[j].label } else { fr.end })
    // the call is in the enclosing site's file (the function's at level 0)
    let cfile = if site.parent >= 0 && site.parent < fr.sites.len() { fr.sites[site.parent].file } else { fr.file }
    die.uleb(cfile)
    die.uleb(site.call_line / 4096)
    die.uleb(site.call_line % 4096)
    inline_level(die, fr, chains, origin, i, j, level + 1)
    die.u8(0)
    i = j
  }
}

/// The sites holding site s, outermost first (empty for none).
fn site_chain(fr: DbgFunc, s: Int) -> List[Int] {
  var out: List[Int] = []
  var k = s
  var guard = 0
  while k >= 0 && k < fr.sites.len() && guard < 64 {
    out.insert(0, k)
    k = fr.sites[k].parent
    guard += 1
  }
  out
}

/// Debug section bytes as assembler directives, with their count.
struct Dw {
  lines: List[Str] = []
  n: Int = 0
}

fn (var d: Dw) u8(v: Int) {
  d.lines.push("\t.byte ${v & 255}\n")
  d.n += 1
}

fn (var d: Dw) u16(v: Int) {
  d.lines.push("\t.short ${v & 65535}\n")
  d.n += 2
}

fn (var d: Dw) u32(v: Int) {
  d.lines.push("\t.long ${v}\n")
  d.n += 4
}

fn (var d: Dw) offset(sym: Str) {
  d.lines.push("\t.long ${sym}\n")
  d.n += 4
}

fn (var d: Dw) quad(sym: Str) {
  d.lines.push("\t.quad ${sym}\n")
  d.n += 8
}

fn (var d: Dw) uleb(v0: Int) {
  var v = v0
  var bs: List[Str] = []
  while true {
    var b = v & 127
    v = v >> 7
    if v != 0 {
      b = b | 128
    }
    bs.push("${b}")
    if v == 0 {
      break
    }
  }
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

fn (var d: Dw) sleb(v0: Int) {
  var v = v0
  var bs: List[Str] = []
  while true {
    let b = v & 127
    v = v >> 7
    let done = (v == 0 && b & 64 == 0) || (v == -1 && b & 64 != 0)
    bs.push("${if done { b } else { b | 128 }}")
    if done {
      break
    }
  }
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

/// A NUL terminated string (DW_FORM_string), as bytes (no escaping).
fn (var d: Dw) str(s: Str) {
  var bs: List[Str] = []
  for c in s.bytes() {
    bs.push("${Int(c)}")
  }
  bs.push("0")
  d.lines.push("\t.byte ${bs.join(", ")}\n")
  d.n += bs.len()
}

fn (d: Dw) text() -> Str {
  d.lines.join("")
}
