// Tests of the self hosted parser. The byte for byte comparison with the
// Go parser is internal/selfhost's TestSelfhostParserDifferential.

fn parse(src: Str) -> ParseResult {
  parse_file(b"t.xo", src.bytes(), false)
}

fn accepts(src: Str) -> Bool {
  parse(src).diags.is_empty()
}

fn first_code(src: Str) -> Str {
  parse(src).diags.first().map(fn(d) { d.code }) ?? ""
}

/// The dump lines of src without the header and spans.
fn shape(src: Str) -> List[Str] {
  let text = dump("t.xo", src.bytes(), false)
  var out: List[Str] = []
  for line in text.split("\n").filter(fn(l) { !l.is_empty() && !l.starts_with("==") }) {
    let trimmed = line.trim()
    let parts = trimmed.split(" ")
    out.push(if parts.len() > 1 && parts[0].ends_with(":") { "${parts[0]} ${parts[1]}" } else { parts[0] })
  }
  out
}

test "declarations of every kind parse" {
  let src = """
    use std/http
    use go "strings" as gs

    /// A point.
    pub struct Point[T: Ord] {
      pub x: T
      y: T = 0
    } invariant x >= y derive Json

    enum Shape {
      Circle(r: Int)
      Wrap(from Err)
      Dot
    }

    interface Area {
      fn area(self) -> Float
    }

    type Id = Int
    type Name struct(Str)
    const MAX: Int = 3

    fn (var p: Point[Int]) move(dx: Int = 1) -> Int ! Err uses net
      requires dx > 0 else Err.Bad
      ensures(debug) true
    {
      p.x += dx
      p.x
    }

    test "t" for n: Int seed 7 uses clock {
      expect(n) == n
    }
    """
  expect(accepts(src)) == true
  let r = parse(src)
  expect(r.file.imports.len()) == 2
  expect(r.file.decls.len()) == 8
}

test "operator precedence matches core 15" {
  let s = shape("fn f() {\n  a ?? b || c && d == e .. f + g * h\n}\n")
  expect(s.contains("x: BinaryExpr")) == true
  // ?? is the root: the statement's expression is a Coalesce.
  let text = dump("t.xo", b"fn f() {\n  a ?? b || c && d == e + g * h\n}\n", false)
  expect(text.contains("x: BinaryExpr 2:3:11-2:32:40 op=Coalesce")) == true
  expect(text.contains("op=Star")) == true
}

test "patterns of every kind parse" {
  let src = """
    fn f(x: T) {
      match x {
        _ => 0
        1 | 2 => 1
        -3..=5 => 2
        (a, b) => 3
        Some(v) if v > 0 => 4
        Shape.Rect(w: w, ..) => 5
        Point{x: 0, ..} => 6
        [first, .., last] => 7
        "s" => 8
      }
    }
    """
  expect(accepts(src)) == true
  let s = shape(src)
  for kind in ["WildcardPat", "OrPat", "RangePat", "TuplePat", "VariantPat", "StructPat", "ListPat", "LitPat"] {
    expect(s.any(fn(l) { l.ends_with(kind) })) == true
  }
}

test "expressions: literals, postfix, closures, control flow" {
  let src = """
    fn f() {
      let m = {"a": 1}
      let s = #{1, 2}
      let t = (1, "x\${m}", 'c', 1.5, 2s, b"z", ???)
      let g = fn(a, var b: Int) -> Int ! E uses clock { a }
      let r = json.decode[User](b)?.name ?? "none"
      let p = Point{x: 1, y: 2} with {x: 3}
      let v = xs[1..] + xs[..=2] + xs[i]
      let w = if let Some(q) = m.get("a") { q } else if c { 1 } else { 2 }
      scope s {
        s.spawn(fn() {
          select {
            v = ch.recv() => ()
            after 1s => ()
          }
        })
      }
      outer: for (k, v) in m {
        while k > 0 {
          break outer
        }
        while let Some((a, _)) = q.pop() bound 8 {
          continue
        }
      }
      defer { close() }
      x.0 += 1
      return
    }
    """
  expect(accepts(src)) == true
}

test "errors and habits of other languages are rejected" {
  expect(first_code("fn f() {\n  let x = [1\n  2]\n}\n")) == "XO0161"
  expect(first_code("fn f() {\n  if c {\n  }\n  else {\n  }\n}\n")) == "XO0162"
  expect(first_code("fn f() {\n  if p == P{x: 1} {\n  }\n}\n")) == "XO0163"
  expect(first_code("fn f() {\n  x := 1\n}\n")) == "XO0177"
  expect(first_code("fn f() {\n  let x = a and b\n}\n")) == "XO0177"
  expect(first_code("fn f() -> map[Int]Str {\n}\n")) == "XO0177"
  expect(first_code("fn f() {\n  throw(e)\n}\n")) == "XO0177"
  expect(first_code("let x = 1\n")) == "XO0168"
  expect(first_code("fn f() {\n")) == "XO0164"
  expect(first_code("fn f() {\n  \"\${a b}\"\n}\n")) == "XO0160"
  // Lexical errors reject the file with the lexer's code.
  expect(first_code("fn f() {\n  @\n}\n")) == "XO0150"
}

test "Go's for range is kept for the checker, marked go_range" {
  let text = dump("t.xo", b"fn f() {\n  for i, x := range xs {\n  }\n}\n", false)
  expect(text.contains("ForStmt 2:3:11-3:4:37 go_range")) == true
  expect(text.contains("pattern: TuplePat")) == true
}

test "signature mode allows bodiless functions" {
  expect(accepts("fn len() -> Int\n")) == false
  expect(parse_file(b"t.xo", b"fn len() -> Int\n", true).diags.is_empty()) == true
}

test "habits of other languages are soft errors with the Xo form recovered" {
  // Go's `x := 1` with a later assignment becomes a `var`.
  let r = parse("fn f() {\n  x := 1\n  x = 2\n}\n")
  expect(r.hard) == false
  expect(r.diags.len()) == 1
  expect(r.diags[0].code) == "XO0177"
  let text = dump("t.xo", b"fn f() {\n  x := 1\n  x = 2\n}\n", false)
  expect(text.contains("VarStmt")) == true
  // Several habits in one file: each is reported once, in source order.
  let many = parse("func f(a int) {\n  let b = a and true\n  b++\n}\n")
  expect(many.hard) == false
  expect(many.diags.map(fn(d) { d.code })) == ["XO0177", "XO0177", "XO0177", "XO0177"]
  // `class` resynchronizes at the next declaration, like the Go parser.
  let cls = parse("class P {\n  x: Int\n}\n\nfn g() {\n}\n")
  expect(cls.hard) == false
  expect(cls.file.decls.len()) == 2
  // A hard error still stops the parse.
  expect(parse("fn f() {\n  let = 1\n}\n").hard) == true
}

test "doc comments attach to declarations, fields, and variants" {
  let text = dump("t.xo", b"/// one\n/// two\nstruct S {\n  /// f\n  f: Int\n}\n", false)
  expect(text.contains("doc: Doc 1:1:0-2:8:15 text=\"one\\x0atwo\"")) == true
  expect(text.contains("doc: Doc 4:3:29-4:8:34 text=\"f\"")) == true
}
