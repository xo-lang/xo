// The Xo lexer, written in Xo: a faithful port of internal/lexer (core 1).
//
// Newlines become Newline tokens when the last token on the line can end a
// statement (core 1.3), except when the next non blank, non comment line
// starts with a single `.`, which continues the previous line. A string
// literal with `${expr}` interpolation is one String token holding the
// literal parts and the raw source of each expression; lex_range lexes
// those expressions. Diagnostics carry the same codes and messages as the
// Go lexer, and the dump (dump.xo) prints the same text as `xo lexdump`.

// Byte values. Xo has no byte or character literal that is an Int (a rune
// literal is a Rune, which does not convert to Int), so they are named.
const C_TAB = 0x09
const C_NL = 0x0a
const C_CR = 0x0d
const C_SPACE = 0x20
const C_BANG = 0x21
const C_QUOTE = 0x22
const C_HASH = 0x23
const C_DOLLAR = 0x24
const C_PERCENT = 0x25
const C_AMP = 0x26
const C_APOS = 0x27
const C_LPAREN = 0x28
const C_RPAREN = 0x29
const C_STAR = 0x2a
const C_PLUS = 0x2b
const C_COMMA = 0x2c
const C_MINUS = 0x2d
const C_DOT = 0x2e
const C_SLASH = 0x2f
const C_0 = 0x30
const C_9 = 0x39
const C_COLON = 0x3a
const C_SEMI = 0x3b
const C_LT = 0x3c
const C_EQ = 0x3d
const C_GT = 0x3e
const C_QUESTION = 0x3f
const C_LBRACK = 0x5b
const C_BACKSLASH = 0x5c
const C_RBRACK = 0x5d
const C_CARET = 0x5e
const C_UNDERSCORE = 0x5f
const C_LOWER_A = 0x61
const C_LOWER_B = 0x62
const C_LOWER_E = 0x65
const C_LOWER_F = 0x66
const C_LOWER_N = 0x6e
const C_LOWER_O = 0x6f
const C_LOWER_R = 0x72
const C_LOWER_T = 0x74
const C_LOWER_U = 0x75
const C_LOWER_X = 0x78
const C_LOWER_Z = 0x7a
const C_LBRACE = 0x7b
const C_PIPE = 0x7c
const C_RBRACE = 0x7d
const C_TILDE = 0x7e

/// Marks an interpolation in the flattened text of a triple quoted string.
const MARKER = 0x01

const MAX_INT = 9223372036854775807
const MAX_U64: UInt64 = 18446744073709551615

/// The output of lex and lex_range. Tokens always end with Eof.
pub struct LexResult {
  pub tokens: List[Token]
  pub comments: List[Comment]
  pub diags: List[Diag]
}

struct Lexer {
  src: Bytes
  off: Int
  end: Int
  line: Int
  col: Int
  /// Set when lexing an interpolated expression: no Newline tokens.
  range_mode: Bool
  toks: List[Token] = []
  comments: List[Comment] = []
  diags: List[Diag] = []
  /// The last significant token, for newline insertion.
  last: Kind = Kind.Newline
}

/// A raw part of a string literal before escapes are decoded.
struct Piece {
  expr: Bool
  raw: Bytes
  /// Position of raw in the source.
  start: Pos
}

/// Tokenizes a whole file.
pub fn lex(src: Bytes) -> LexResult {
  var l = Lexer{src: src, off: 0, end: src.len(), line: 1, col: 1, range_mode: false}
  l.run()
  LexResult{tokens: l.toks, comments: l.comments, diags: l.diags}
}

/// Tokenizes src[start.offset..end] with positions continuing from start.
/// Used for interpolated expressions; never emits Newline tokens.
pub fn lex_range(src: Bytes, start: Pos, end: Int) -> LexResult {
  var l = Lexer{src: src, off: start.offset, end: end, line: start.line, col: start.col, range_mode: true}
  l.run()
  LexResult{tokens: l.toks, comments: l.comments, diags: l.diags}
}

fn is_letter(c: Int) -> Bool {
  c == C_UNDERSCORE || (c >= C_LOWER_A && c <= C_LOWER_Z) || (c >= 0x41 && c <= 0x5a)
}

fn is_digit(c: Int) -> Bool {
  c >= C_0 && c <= C_9
}

fn is_hex(c: Int) -> Bool {
  is_digit(c) || ((c | 0x20) >= C_LOWER_A && (c | 0x20) <= C_LOWER_F)
}

/// Whether a newline after k terminates a statement (core 1.3). `???`
/// counts as a literal.
fn ends_statement(k: Kind) -> Bool {
  k is Ident | Int | Float | Duration | Rune | String | RawString | Bytes | ImportPath | Hole | RParen | RBrack | RBrace | Question | Return | Break | Continue
}

fn (l: Lexer) pos() -> Pos {
  Pos{offset: l.off, line: l.line, col: l.col}
}

fn (l: Lexer) span(start: Pos) -> Span {
  Span{start: start, end: l.pos()}
}

/// The byte n past the current one, or 0 past the end.
fn (l: Lexer) peek(n: Int) -> Int {
  if l.off + n < l.end { Int(l.src[l.off + n]) } else { 0 }
}

/// The current byte; the caller checks l.off < l.end.
fn (l: Lexer) cur() -> Int {
  Int(l.src[l.off])
}

/// Moves past one byte, tracking lines and columns.
fn (var l: Lexer) advance() {
  if l.off >= l.end {
    return
  }
  if Int(l.src[l.off]) == C_NL {
    l.line += 1
    l.col = 1
  } else {
    l.col += 1
  }
  l.off += 1
}

fn (var l: Lexer) advance_n(n: Int) {
  for _ in 0..n {
    l.advance()
  }
}

fn (var l: Lexer) error(code: Str, sp: Span, message: Bytes) {
  l.diags.push(Diag{code: code, span: sp, message: message})
}

/// Appends a token of kind from start to the current position.
fn (var l: Lexer) emit(kind: Kind, start: Pos, value: Bytes) {
  l.toks.push(Token{kind: kind, span: l.span(start), text: l.src[start.offset..l.off], value: value})
  l.last = kind
}

fn (var l: Lexer) run() {
  while {
    l.skip_space_and_comments()
    if l.off >= l.end {
      if !l.range_mode && ends_statement(l.last) {
        let p = l.pos()
        l.toks.push(Token{kind: Kind.Newline, span: Span{start: p, end: p}, text: b""})
      }
      let p = l.pos()
      l.toks.push(Token{kind: Kind.Eof, span: Span{start: p, end: p}, text: b""})
      return
    }
    l.next()
  }
}

/// Skips blanks and comments and handles newlines.
fn (var l: Lexer) skip_space_and_comments() {
  while l.off < l.end {
    let c = l.cur()
    if c == C_SPACE || c == C_TAB || c == C_CR {
      l.advance()
    } else if c == C_NL {
      let start = l.pos()
      l.advance()
      if !l.range_mode && ends_statement(l.last) && !l.continues_line() {
        l.toks.push(Token{kind: Kind.Newline, span: l.span(start), text: b"\n"})
        l.last = Kind.Newline
      }
    } else if c == C_SLASH && l.peek(1) == C_SLASH {
      l.comment()
    } else {
      return
    }
  }
}

/// Whether the next line holding a token starts with a single `.` (core
/// 1.3). Blank lines and comment lines are skipped.
fn (l: Lexer) continues_line() -> Bool {
  var i = l.off
  while i < l.end {
    let c = Int(l.src[i])
    if c == C_SPACE || c == C_TAB || c == C_CR || c == C_NL {
      i += 1
    } else if c == C_SLASH && i + 1 < l.end && Int(l.src[i + 1]) == C_SLASH {
      while i < l.end && Int(l.src[i]) != C_NL {
        i += 1
      }
    } else if c == C_DOT {
      return !(i + 1 < l.end && Int(l.src[i + 1]) == C_DOT)
    } else {
      return false
    }
  }
  false
}

/// Whether b starts with n slashes.
fn slashes(b: Bytes, n: Int) -> Bool {
  if b.len() < n {
    return false
  }
  for i in 0..n {
    if Int(b[i]) != C_SLASH {
      return false
    }
  }
  true
}

fn (var l: Lexer) comment() {
  let start = l.pos()
  while l.off < l.end && l.cur() != C_NL {
    l.advance()
  }
  let all = l.src[start.offset..l.off]
  let doc = slashes(all, 3) && !slashes(all, 4)
  var text = if doc { all[3..] } else { all[2..] }
  if text.len() > 0 && Int(text[0]) == C_SPACE {
    text = text[1..]
  }
  if text.len() > 0 && Int(text[text.len() - 1]) == C_CR {
    text = text[..text.len() - 1]
  }
  l.comments.push(Comment{span: l.span(start), text: text, doc: doc})
}

fn (var l: Lexer) next() {
  let start = l.pos()
  let c = l.cur()

  // Import path directly after `use`.
  if l.last == Kind.Use && !l.range_mode {
    l.import_path(start)
    return
  }

  if c == C_LOWER_R && (l.peek(1) == C_QUOTE || (l.peek(1) == C_HASH && l.raw_hashes(1) > 0)) {
    l.raw_string(start)
    return
  }
  if c == C_LOWER_B && l.peek(1) == C_QUOTE {
    l.bytes_lit(start)
    return
  }
  if is_letter(c) {
    while l.off < l.end && (is_letter(l.cur()) || is_digit(l.cur())) {
      l.advance()
    }
    let word = l.src[start.offset..l.off].to_str().or_fault("identifiers are ASCII")
    l.emit(lookup(word), start, b"")
    return
  }
  if is_digit(c) {
    l.number(start)
    return
  }
  if c == C_QUOTE {
    l.string_lit(start)
    return
  }
  if c == C_APOS {
    l.rune_lit(start)
    return
  }

  let (k, n) = l.operator()
  if n > 0 {
    l.advance_n(n)
    if k == Kind.Newline {
      // ';'
      l.toks.push(Token{kind: Kind.Newline, span: l.span(start), text: b";"})
      l.last = Kind.Newline
      return
    }
    l.emit(k, start, b"")
    return
  }

  // Invalid character: skip the whole UTF-8 sequence.
  let (r, size) = decode_rune(l.src, l.off, l.end)
  l.advance_n(size)
  l.error(INVALID_CHAR, l.span(start), "invalid character ".bytes() + quote_rune(r))
  l.emit(Kind.Illegal, start, b"")
}

/// Counts `#` bytes at offset i from the current position and returns the
/// count if they are followed by `"`, else 0.
fn (l: Lexer) raw_hashes(i: Int) -> Int {
  var n = 0
  while l.peek(i + n) == C_HASH {
    n += 1
  }
  if l.peek(i + n) == C_QUOTE { n } else { 0 }
}

/// The operator at the current position and its length, or (Illegal, 0).
fn (l: Lexer) operator() -> (Kind, Int) {
  let c1 = l.peek(1)
  let c2 = l.peek(2)
  match l.peek(0) {
    0x2b => if c1 == C_EQ { (Kind.PlusAssign, 2) } else { (Kind.Plus, 1) }
    0x2d => {
      if c1 == C_EQ {
        (Kind.MinusAssign, 2)
      } else if c1 == C_GT {
        (Kind.Arrow, 2)
      } else {
        (Kind.Minus, 1)
      }
    }
    0x2a => if c1 == C_EQ { (Kind.StarAssign, 2) } else { (Kind.Star, 1) }
    0x2f => if c1 == C_EQ { (Kind.SlashAssign, 2) } else { (Kind.Slash, 1) }
    0x25 => if c1 == C_EQ { (Kind.PercentAssign, 2) } else { (Kind.Percent, 1) }
    0x3c => {
      if c1 == C_LT {
        if c2 == C_EQ { (Kind.ShlAssign, 3) } else { (Kind.Shl, 2) }
      } else if c1 == C_EQ {
        (Kind.LtEq, 2)
      } else {
        (Kind.Lt, 1)
      }
    }
    0x3e => {
      if c1 == C_GT {
        if c2 == C_EQ { (Kind.ShrAssign, 3) } else { (Kind.Shr, 2) }
      } else if c1 == C_EQ {
        (Kind.GtEq, 2)
      } else {
        (Kind.Gt, 1)
      }
    }
    0x26 => {
      if c1 == C_AMP {
        (Kind.AndAnd, 2)
      } else if c1 == C_EQ {
        (Kind.AmpAssign, 2)
      } else {
        (Kind.Amp, 1)
      }
    }
    0x7c => {
      if c1 == C_PIPE {
        (Kind.OrOr, 2)
      } else if c1 == C_EQ {
        (Kind.PipeAssign, 2)
      } else {
        (Kind.Pipe, 1)
      }
    }
    0x5e => if c1 == C_EQ { (Kind.CaretAssign, 2) } else { (Kind.Caret, 1) }
    0x7e => (Kind.Tilde, 1)
    0x21 => if c1 == C_EQ { (Kind.NotEq, 2) } else { (Kind.Bang, 1) }
    0x3f => {
      if c1 == C_QUESTION {
        if c2 == C_QUESTION { (Kind.Hole, 3) } else { (Kind.Coalesce, 2) }
      } else {
        (Kind.Question, 1)
      }
    }
    0x3d => {
      if c1 == C_EQ {
        (Kind.Eq, 2)
      } else if c1 == C_GT {
        (Kind.FatArrow, 2)
      } else {
        (Kind.Assign, 1)
      }
    }
    0x2e => {
      if c1 == C_DOT {
        if c2 == C_EQ { (Kind.DotDotEq, 3) } else { (Kind.DotDot, 2) }
      } else {
        (Kind.Dot, 1)
      }
    }
    0x2c => (Kind.Comma, 1)
    0x3a => (Kind.Colon, 1)
    0x3b => (Kind.Newline, 1)
    0x28 => (Kind.LParen, 1)
    0x29 => (Kind.RParen, 1)
    0x5b => (Kind.LBrack, 1)
    0x5d => (Kind.RBrack, 1)
    0x7b => (Kind.LBrace, 1)
    0x7d => (Kind.RBrace, 1)
    0x23 => if c1 == C_LBRACE { (Kind.HashLBrace, 2) } else { (Kind.Illegal, 0) }
    _ => (Kind.Illegal, 0)
  }
}

fn is_path_char(c: Int) -> Bool {
  is_letter(c) || is_digit(c) || c == C_MINUS || c == C_DOT || c == C_SLASH
}

/// Whether b holds `//`.
fn has_double_slash(b: Bytes) -> Bool {
  for i in 1..b.len() {
    if Int(b[i]) == C_SLASH && Int(b[i - 1]) == C_SLASH {
      return true
    }
  }
  false
}

/// Lexes the path after `use`: segments of letters, digits, `_`, `-`, and
/// `.` separated by `/`.
fn (var l: Lexer) import_path(start: Pos) {
  while l.off < l.end && is_path_char(l.cur()) {
    l.advance()
  }
  if l.off == start.offset {
    // Not a path at all; lex the token normally so the parser reports it.
    l.last = Kind.Illegal
    l.next()
    return
  }
  let text = l.src[start.offset..l.off]
  l.emit(Kind.ImportPath, start, text)
  if Int(text[0]) == C_SLASH || Int(text[text.len() - 1]) == C_SLASH || has_double_slash(text) {
    l.error(MALFORMED_IMPORT_PATH, l.span(start), "malformed import path ".bytes() + quote_plain(text))
  }
}

/// The nanoseconds in one duration unit, or None for an unknown suffix.
fn duration_unit(suffix: Bytes) -> Int? {
  match suffix.to_str() ?? "" {
    "ns" => Some(1)
    "us" => Some(1_000)
    "ms" => Some(1_000_000)
    "s" => Some(1_000_000_000)
    "m" => Some(60 * 1_000_000_000)
    "h" => Some(3600 * 1_000_000_000)
    _ => None
  }
}

fn (var l: Lexer) digits() {
  while l.off < l.end && (is_digit(l.cur()) || l.cur() == C_UNDERSCORE) {
    l.advance()
  }
}

/// b without its `_` bytes.
fn remove_underscores(b: Bytes) -> Bytes {
  var out = b""
  var run = 0
  for i in 0..b.len() {
    if Int(b[i]) == C_UNDERSCORE {
      out = out + b[run..i]
      run = i + 1
    }
  }
  if run == 0 { b } else { out + b[run..] }
}

/// Whether every `_` in s sits between two digits of the base.
fn valid_underscores(s: Bytes, base: Int) -> Bool {
  for i in 0..s.len() {
    if Int(s[i]) != C_UNDERSCORE {
      continue
    }
    if i == 0 || i == s.len() - 1 {
      return false
    }
    let prev = Int(s[i - 1])
    let next = Int(s[i + 1])
    let ok = if base == 16 { is_hex(prev) && is_hex(next) } else { is_digit(prev) && is_digit(next) }
    if !ok {
      return false
    }
  }
  true
}

/// The result of strconv.ParseUint.
enum Parsed {
  Value(n: UInt64)
  Syntax
  OutOfRange
}

/// strconv.ParseUint(s, base, 64) for a non empty s: the first problem in
/// reading order decides between a syntax and a range error, as in Go.
fn parse_uint(s: Bytes, base: Int) -> Parsed {
  let b = UInt64(base)
  let cutoff = MAX_U64 / b + 1
  var n: UInt64 = 0
  for i in 0..s.len() {
    let c = Int(s[i])
    let d = if is_digit(c) {
      c - C_0
    } else if (c | 0x20) >= C_LOWER_A && (c | 0x20) <= C_LOWER_Z {
      (c | 0x20) - C_LOWER_A + 10
    } else {
      return Parsed.Syntax
    }
    if d >= base {
      return Parsed.Syntax
    }
    if n >= cutoff {
      return Parsed.OutOfRange
    }
    n = n * b
    let du = UInt64(d)
    if n > MAX_U64 - du {
      return Parsed.OutOfRange
    }
    n = n + du
  }
  Parsed.Value(n)
}

/// Validates digits for base and returns the value, or reports why not.
fn (var l: Lexer) parse_int(body: Bytes, base: Int, sp: Span) -> UInt64? {
  if body.is_empty() {
    l.error(MALFORMED_NUMBER, sp, "number literal has no digits".bytes())
    return None
  }
  // 0x_ff is allowed, as in Go.
  let digits = if base != 10 && Int(body[0]) == C_UNDERSCORE { body[1..] } else { body }
  if !valid_underscores(digits, base) {
    l.error(MALFORMED_NUMBER, sp, "misplaced `_` in number literal".bytes())
    return None
  }
  let clean = remove_underscores(digits)
  if clean.is_empty() {
    l.error(MALFORMED_NUMBER, sp, "number literal has no digits".bytes())
    return None
  }
  match parse_uint(clean, base) {
    Value(n) => Some(n)
    OutOfRange => {
      l.error(MALFORMED_NUMBER, sp, "integer literal out of range".bytes())
      None
    }
    Syntax => {
      l.error(MALFORMED_NUMBER, sp, "invalid digit in base ${base} literal".bytes())
      None
    }
  }
}

fn (var l: Lexer) number(start: Pos) {
  var kind = Kind.Int
  var base = 10
  let p1 = l.peek(1) | 0x20
  if l.cur() == C_0 && (p1 == C_LOWER_X || p1 == C_LOWER_O || p1 == C_LOWER_B) {
    base = if p1 == C_LOWER_X { 16 } else if p1 == C_LOWER_O { 8 } else { 2 }
    l.advance_n(2)
    while l.off < l.end && (is_hex(l.cur()) || l.cur() == C_UNDERSCORE) {
      l.advance()
    }
  } else if l.last == Kind.Dot {
    // A tuple field index (`t.0`, core 3.5): plain digits only, so `t.0.1`
    // is two field accesses rather than `t.` and `0.1`.
    l.digits()
  } else {
    l.digits()
    if l.peek(0) == C_DOT && is_digit(l.peek(1)) {
      kind = Kind.Float
      l.advance()
      l.digits()
    }
    let sign = l.peek(1) == C_PLUS || l.peek(1) == C_MINUS
    if (l.peek(0) | 0x20) == C_LOWER_E && (is_digit(l.peek(1)) || (sign && is_digit(l.peek(2)))) {
      kind = Kind.Float
      l.advance_n(2)
      l.digits()
    }
  }
  let num_end = l.off
  // Suffix: a duration unit or an error.
  while l.off < l.end && (is_letter(l.cur()) || is_digit(l.cur())) {
    l.advance()
  }
  let suffix = l.src[num_end..l.off]
  let digits = l.src[start.offset..num_end]
  let sp = l.span(start)

  if !suffix.is_empty() {
    let text = l.src[start.offset..l.off]
    var value = b""
    if let Some(unit) = duration_unit(suffix) {
      if kind != Kind.Int || base != 10 {
        l.error(INVALID_DURATION, sp, "duration literal ".bytes() + quote_plain(text) + " must be a decimal integer followed by a unit".bytes())
      } else if let Some(v) = l.parse_int(digits, 10, sp) {
        if v > UInt64(MAX_INT) || Int(v) > MAX_INT / unit {
          l.error(MALFORMED_NUMBER, sp, "duration literal ".bytes() + quote_plain(text) + " overflows a 64 bit nanosecond count".bytes())
        } else {
          value = itoa(Int(v) * unit)
        }
      }
    } else {
      l.error(INVALID_DURATION, sp, "invalid suffix ".bytes() + quote_plain(suffix) + " on number literal; duration units are ns, us, ms, s, m, h".bytes())
    }
    l.emit(Kind.Duration, start, value)
    return
  }

  if kind == Kind.Float {
    if valid_underscores(digits, 10) {
      l.emit(kind, start, remove_underscores(digits))
    } else {
      l.error(MALFORMED_NUMBER, sp, "misplaced `_` in number literal ".bytes() + quote_plain(digits))
      l.emit(kind, start, b"")
    }
    return
  }
  let body = if base != 10 { digits[2..] } else { digits }
  let value = match l.parse_int(body, base, sp) {
    Some(v) => "${v}".bytes()
    None => b""
  }
  l.emit(kind, start, value)
}

/// Whether `"` followed by `hashes` `#` bytes starts at the current position.
fn (l: Lexer) at_closing(hashes: Int) -> Bool {
  if l.off + hashes >= l.end || l.cur() != C_QUOTE {
    return false
  }
  for k in 1..=hashes {
    if Int(l.src[l.off + k]) != C_HASH {
      return false
    }
  }
  true
}

/// b with every CR LF replaced by LF.
fn replace_crlf(b: Bytes) -> Bytes {
  var out = b""
  var run = 0
  var i = 0
  while i + 1 < b.len() {
    if Int(b[i]) == C_CR && Int(b[i + 1]) == C_NL {
      out = out + b[run..i]
      run = i + 1
    }
    i += 1
  }
  if run == 0 { b } else { out + b[run..] }
}

fn (var l: Lexer) raw_string(start: Pos) {
  l.advance() // r
  var hashes = 0
  while l.peek(0) == C_HASH {
    hashes += 1
    l.advance()
  }
  l.advance() // "
  let body_start = l.off
  while l.off < l.end {
    if l.at_closing(hashes) {
      let body = l.src[body_start..l.off]
      l.advance_n(hashes + 1)
      l.emit(Kind.RawString, start, replace_crlf(body))
      return
    }
    l.advance()
  }
  let closing = "\"" + "#".repeat(hashes)
  l.emit(Kind.RawString, start, l.src[body_start..l.off])
  l.error(UNTERMINATED_STRING, l.span(start), "raw string literal not terminated; expected ${closing}".bytes())
}

/// Scans the body of a bytes or rune literal up to the closing `quote`, a
/// newline, or the end. Reports whether it was terminated.
fn (var l: Lexer) quoted_body(quote: Int) -> Bool {
  while l.off < l.end {
    let c = l.cur()
    if c == quote {
      return true
    }
    if c == C_NL {
      return false
    }
    if c == C_BACKSLASH && l.off + 1 < l.end {
      l.advance_n(2)
    } else {
      l.advance()
    }
  }
  false
}

fn (var l: Lexer) bytes_lit(start: Pos) {
  l.advance() // b
  l.advance() // "
  let raw_start = l.pos()
  let terminated = l.quoted_body(C_QUOTE)
  let raw = l.src[raw_start.offset..l.off]
  if terminated {
    l.advance()
  }
  let sp = l.span(start)
  if !terminated {
    l.error(UNTERMINATED_STRING, sp, "bytes literal not terminated".bytes())
  }
  let value = l.cook(raw, raw_start, true)
  l.emit(Kind.Bytes, start, value)
}

fn (var l: Lexer) rune_lit(start: Pos) {
  l.advance() // '
  let raw_start = l.pos()
  let terminated = l.quoted_body(C_APOS)
  let raw = l.src[raw_start.offset..l.off]
  if terminated {
    l.advance()
  }
  let sp = l.span(start)
  if !terminated {
    l.error(INVALID_RUNE, sp, "rune literal not terminated".bytes())
    l.emit(Kind.Rune, start, b"")
    return
  }
  let v = l.cook(raw, raw_start, false)
  if rune_count(v) != 1 {
    l.error(INVALID_RUNE, sp, "rune literal must hold exactly one character".bytes())
    l.emit(Kind.Rune, start, b"")
    return
  }
  l.emit(Kind.Rune, start, v)
}

/// The value of hex digits as strconv.ParseUint(hex, 16, 32) reads them,
/// or None when one is not a hex digit or the value needs more than 32 bits.
fn parse_hex32(hex: Bytes) -> Int? {
  var v = 0
  for i in 0..hex.len() {
    let c = Int(hex[i])
    if !is_hex(c) {
      return None
    }
    let d = if is_digit(c) { c - C_0 } else { (c | 0x20) - C_LOWER_A + 10 }
    v = v * 16 + d
    if v > 0xffffffff {
      return None
    }
  }
  Some(v)
}

/// The index of the first `}` in b at or after from, relative to from.
fn index_rbrace(b: Bytes, from: Int) -> Int {
  for i in from..b.len() {
    if Int(b[i]) == C_RBRACE {
      return i - from
    }
  }
  -1
}

/// Decodes escape sequences in raw (which starts at pos). With bytes set,
/// \xHH may be any byte; in text it must be ASCII.
fn (var l: Lexer) cook(raw: Bytes, pos: Pos, bytes: Bool) -> Bytes {
  var has_escape = false
  for i in 0..raw.len() {
    if Int(raw[i]) == C_BACKSLASH {
      has_escape = true
      break
    }
  }
  if !has_escape {
    return raw
  }
  var out = b""
  var run = 0
  var col = pos.col
  var line = pos.line
  var off = pos.offset
  var i = 0
  while i < raw.len() {
    let c = Int(raw[i])
    if c != C_BACKSLASH {
      if c == C_NL {
        line += 1
        col = 1
      } else {
        col += 1
      }
      off += 1
      i += 1
      continue
    }
    out = out + raw[run..i]
    let here = Pos{offset: off, line: line, col: col}
    if i + 1 >= raw.len() {
      l.error(INVALID_ESCAPE, escape_span(here, 1), "incomplete escape sequence".bytes())
      run = raw.len()
      break
    }
    var n = 2
    let e = Int(raw[i + 1])
    if e == C_LOWER_N {
      out = out + b"\n"
    } else if e == C_LOWER_T {
      out = out + b"\t"
    } else if e == C_LOWER_R {
      out = out + b"\r"
    } else if e == C_0 {
      out = out + b"\0"
    } else if e == C_BACKSLASH || e == C_QUOTE || e == C_APOS || e == C_DOLLAR {
      out = out + raw[i + 1..i + 2]
    } else if e == C_LOWER_X {
      if i + 4 <= raw.len() && is_hex(Int(raw[i + 2])) && is_hex(Int(raw[i + 3])) {
        let v = parse_hex32(raw[i + 2..i + 4]) ?? 0
        if !bytes && v > 0x7f {
          l.error(INVALID_ESCAPE, escape_span(here, 4), "\\x escape above \\x7f in a string; use \\u{...}".bytes())
        }
        out = out + byte_bytes(v)
        n = 4
      } else {
        l.error(INVALID_ESCAPE, escape_span(here, 2), "\\x escape needs two hex digits".bytes())
      }
    } else if e == C_LOWER_U {
      let end = index_rbrace(raw, i)
      if i + 2 < raw.len() && Int(raw[i + 2]) == C_LBRACE && end > 3 {
        let hex = raw[i + 3..i + end]
        match parse_hex32(hex) {
          Some(v) if v <= 0x10ffff && !(v >= 0xd800 && v <= 0xdfff) && hex.len() <= 6 => {
            out = out + encode_rune(v)
          }
          _ => l.error(INVALID_ESCAPE, escape_span(here, end + 1), "invalid unicode escape \\u{".bytes() + hex + "}".bytes())
        }
        n = end + 1
      } else {
        l.error(INVALID_ESCAPE, escape_span(here, 2), "unicode escape must be written \\u{XXXX}".bytes())
      }
    } else {
      // Go's %c of the byte: bytes above 0x7f print as U+0080 to U+00FF.
      l.error(INVALID_ESCAPE, escape_span(here, 2), "unknown escape sequence \\".bytes() + encode_rune(e))
    }
    i += n
    col += n
    off += n
    run = i
  }
  if run < raw.len() {
    out = out + raw[run..]
  }
  out
}

/// The span of an n byte escape sequence at p (on one line).
fn escape_span(p: Pos, n: Int) -> Span {
  Span{start: p, end: Pos{offset: p.offset + n, line: p.line, col: p.col + n}}
}

/// The position after text that starts at p.
fn end_pos(p: Pos, text: Bytes) -> Pos {
  var line = p.line
  var col = p.col
  for i in 0..text.len() {
    if Int(text[i]) == C_NL {
      line += 1
      col = 1
    } else {
      col += 1
    }
  }
  Pos{offset: p.offset + text.len(), line: line, col: col}
}

fn (var l: Lexer) string_lit(start: Pos) {
  let triple = l.peek(1) == C_QUOTE && l.peek(2) == C_QUOTE
  if triple {
    l.advance_n(3)
  } else {
    l.advance()
  }
  var pieces: List[Piece] = []
  // The current literal piece: its start, the raw text collected before a
  // skipped CR, and the offset where the uncollected raw text begins.
  var cur_start = l.pos()
  var acc = b""
  var seg = l.off
  var terminated = false
  while l.off < l.end {
    let c = l.cur()
    if c == C_QUOTE && (!triple || (l.peek(1) == C_QUOTE && l.peek(2) == C_QUOTE)) {
      terminated = true
      break
    }
    if c == C_NL && !triple {
      break
    }
    if c == C_BACKSLASH && l.off + 1 < l.end && Int(l.src[l.off + 1]) != C_NL {
      l.advance_n(2)
      continue
    }
    if c == C_DOLLAR && l.peek(1) == C_LBRACE {
      // Flush the literal piece.
      let raw = acc + l.src[seg..l.off]
      if !raw.is_empty() {
        pieces.push(Piece{expr: false, raw: raw, start: cur_start})
      }
      acc = b""
      let open = l.pos()
      l.advance_n(2)
      let expr_start = l.pos()
      let end = l.scan_interp(l.off, triple)
      if end < 0 {
        // Unterminated: consume to end of line or string.
        while l.off < l.end && l.cur() != C_NL && l.cur() != C_QUOTE {
          l.advance()
        }
        l.error(UNTERMINATED_INTERP, l.span(open), "`\${` is not closed by `}`".bytes())
        cur_start = l.pos()
        seg = l.off
        continue
      }
      while l.off < end {
        l.advance()
      }
      let text = l.src[expr_start.offset..end]
      l.advance() // }
      if is_blank(text) {
        l.error(EMPTY_INTERP, l.span(open), "empty interpolation `\${}`".bytes())
      } else {
        pieces.push(Piece{expr: true, raw: text, start: expr_start})
      }
      cur_start = l.pos()
      seg = l.off
      continue
    }
    if c == C_CR && l.peek(1) == C_NL {
      acc = acc + l.src[seg..l.off]
      l.advance()
      seg = l.off
      continue
    }
    l.advance()
  }
  let last_raw = acc + l.src[seg..l.off]
  if !last_raw.is_empty() {
    pieces.push(Piece{expr: false, raw: last_raw, start: cur_start})
  }
  if terminated {
    if triple {
      l.advance_n(3)
    } else {
      l.advance()
    }
  }
  let sp = l.span(start)
  if !terminated {
    l.error(UNTERMINATED_STRING, sp, "string literal not terminated".bytes())
  }
  let final_pieces = if triple { strip_indent(pieces) } else { pieces }
  var parts: List[StrPart] = []
  for p in final_pieces {
    if p.expr {
      parts.push(StrPart{is_expr: true, text: p.raw, span: Span{start: p.start, end: end_pos(p.start, p.raw)}})
      continue
    }
    let cooked = l.cook(p.raw, p.start, false)
    if cooked.is_empty() {
      continue
    }
    parts.push(StrPart{is_expr: false, text: cooked, span: Span{start: p.start, end: end_pos(p.start, p.raw)}})
  }
  l.toks.push(Token{kind: Kind.String, span: sp, text: l.src[start.offset..l.off], parts: parts, triple: triple})
  l.last = Kind.String
}

/// Index of the first occurrence of `"` followed by `hashes` `#` in
/// src[from..end], or -1.
fn (l: Lexer) find_closing(from: Int, hashes: Int) -> Int {
  var i = from
  while i + hashes < l.end {
    if Int(l.src[i]) == C_QUOTE {
      var ok = true
      for k in 1..=hashes {
        if Int(l.src[i + k]) != C_HASH {
          ok = false
          break
        }
      }
      if ok {
        return i
      }
    }
    i += 1
  }
  -1
}

/// Finds the `}` that closes an interpolation whose expression starts at
/// off. Skips nested braces, strings, raw strings, and runes. Returns -1 if
/// the interpolation is not closed (or, in a one line string, if a newline
/// comes first).
fn (l: Lexer) scan_interp(off: Int, multiline: Bool) -> Int {
  var depth = 0
  var i = off
  while i < l.end {
    let c = Int(l.src[i])
    if c == C_NL && !multiline {
      return -1
    } else if c == C_LBRACE {
      depth += 1
    } else if c == C_RBRACE {
      if depth == 0 {
        return i
      }
      depth -= 1
    } else if c == C_LOWER_R && i + 1 < l.end && (Int(l.src[i + 1]) == C_QUOTE || Int(l.src[i + 1]) == C_HASH) && (i == off || !is_letter(Int(l.src[i - 1])) && !is_digit(Int(l.src[i - 1]))) {
      var j = i + 1
      var h = 0
      while j < l.end && Int(l.src[j]) == C_HASH {
        h += 1
        j += 1
      }
      if j < l.end && Int(l.src[j]) == C_QUOTE {
        let k = l.find_closing(j + 1, h)
        if k < 0 {
          return -1
        }
        i = k + h
      }
    } else if c == C_QUOTE {
      // Nested string; may itself contain interpolations.
      var j = i + 1
      while j < l.end && Int(l.src[j]) != C_QUOTE {
        let cj = Int(l.src[j])
        if cj == C_NL && !multiline {
          return -1
        }
        if cj == C_BACKSLASH {
          j += 2
        } else if cj == C_DOLLAR && j + 1 < l.end && Int(l.src[j + 1]) == C_LBRACE {
          let e = l.scan_interp(j + 2, multiline)
          if e < 0 {
            return -1
          }
          j = e + 1
        } else {
          j += 1
        }
      }
      if j >= l.end {
        return -1
      }
      i = j
    } else if c == C_APOS {
      var j = i + 1
      while j < l.end && Int(l.src[j]) != C_APOS && Int(l.src[j]) != C_NL {
        if Int(l.src[j]) == C_BACKSLASH {
          j += 1
        }
        j += 1
      }
      i = j
    }
    i += 1
  }
  -1
}

/// Whether every byte of b is a space or a tab.
fn is_space_tab(b: Bytes) -> Bool {
  for i in 0..b.len() {
    let c = Int(b[i])
    if c != C_SPACE && c != C_TAB {
      return false
    }
  }
  true
}

/// The number of leading spaces and tabs of b.
fn leading_space_tab(b: Bytes) -> Int {
  var n = 0
  while n < b.len() && (Int(b[n]) == C_SPACE || Int(b[n]) == C_TAB) {
    n += 1
  }
  n
}

/// Splits b at every byte sep, like strings.Split with a one byte separator.
fn split_byte(b: Bytes, sep: Int) -> List[Bytes] {
  var out: List[Bytes] = []
  var run = 0
  for i in 0..b.len() {
    if Int(b[i]) == sep {
      out.push(b[run..i])
      run = i + 1
    }
  }
  out.push(b[run..])
  out
}

/// Joins parts with the byte sep between them.
fn join_byte(parts: List[Bytes], sep: Bytes) -> Bytes {
  var out = b""
  for (i, p) in parts.indexed() {
    if i > 0 {
      out = out + sep
    }
    out = out + p
  }
  out
}

/// Applies the triple quoted string rules: the line holding the opening
/// quotes is dropped when it is blank, the line holding the closing quotes
/// is dropped when it is blank, and the common leading indentation of the
/// remaining non blank lines is removed. Indentation is measured on the raw
/// source, so an interpolation counts as non blank content.
fn strip_indent(pieces: List[Piece]) -> List[Piece] {
  var flat = b""
  var exprs: List[Piece] = []
  for p in pieces {
    if p.expr {
      flat = flat + byte_bytes(MARKER)
      exprs.push(p)
    } else {
      flat = flat + p.raw
    }
  }
  var lines = split_byte(flat, C_NL)
  var kept_first = true
  if lines.len() > 1 && is_space_tab(lines[0]) {
    lines = lines[1..]
    kept_first = false
  }
  if lines.len() > 1 && is_space_tab(lines[lines.len() - 1]) {
    lines = lines[..lines.len() - 1]
  }
  // A first line with content (text right after the opening quotes) is
  // neither measured nor stripped.
  let first = if kept_first { 1 } else { 0 }
  var indent = -1
  for i in first..lines.len() {
    let ln = lines[i]
    if is_space_tab(ln) {
      continue
    }
    let n = leading_space_tab(ln)
    if indent < 0 || n < indent {
      indent = n
    }
  }
  if indent < 0 {
    indent = 0
  }
  for i in first..lines.len() {
    let ln = lines[i]
    lines[i] = if is_space_tab(ln) { b"" } else { ln[indent..] }
  }
  let joined = join_byte(lines, b"\n")
  // Rebuild pieces. Literal pieces lose their exact source position after
  // stripping; they keep the position of the first original piece, which
  // is only used for escape error locations.
  var out: List[Piece] = []
  var lit_start = Pos{offset: 0, line: 0, col: 0}
  if let Some(p) = pieces.first() {
    lit_start = p.start
  }
  for (i, s) in split_byte(joined, MARKER).indexed() {
    if !s.is_empty() {
      out.push(Piece{expr: false, raw: s, start: lit_start})
    }
    if let Some(e) = exprs.get(i) {
      out.push(e)
      let after = end_pos(e.start, e.raw)
      lit_start = Pos{offset: after.offset + 1, line: after.line, col: after.col + 1}
    }
  }
  out
}
