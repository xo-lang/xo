// Value semantics (stage 5 of decision 0141), a port of
// internal/check/flow.go and of the mutability rules of stmt.go and
// call.go: `var` places (XO0501, XO0502), `var` arguments that overlap
// (XO0503), moves of move only values (XO0510), updates of copies that
// are never written back (XO0520), split critical sections (XO0804, a
// warning), and bindings never read (XO0110, XO0201).
//
// The Go checker keys its maps by node pointers; here an identifier is
// keyed by its offset (name_key), a call by its expression key, and a
// loop by its kind and offset. What an identifier names comes from the
// name records (uses) and decl_at (the names a pattern or `var`
// declares), the two halves of check.go identObj.

use github.com/xo-lang/xo/selfhost/parser

// ---------------------------------------------------------------------------
// Places and mutability (stmt.go placeRoot, requireMutable)

/// The binding at the root of a place expression: `x`, `x.f`, `x[i]`.
fn place_root(e: Expr) -> Ident? {
  match e {
    Ident(id) => Some(id)
    SelectorExpr(x: x, ..) => place_root(x)
    IndexExpr(x: x, ..) => place_root(x)
    ParenExpr(x: x, ..) => place_root(x)
    _ => None
  }
}

/// Checks that e is a place rooted at a mutable binding of the current
/// function: a `var` binding, `var` parameter, or `var` receiver (core
/// 5.2). code is XO0501 for `var` method calls and XO0502 otherwise.
fn (var c: Checker) require_mutable(e: Expr, code: Str, what: Str) {
  let id = match place_root(e) {
    Some(x) => x
    None => {
      c.error(code, parser.expr_span(e), "${what} needs a `var` binding, but the receiver is a temporary value")
      return
    }
  }
  let v = c.lookup_local(id.name)
  if v < 0 {
    return // reported as unresolved by the type check
  }
  if c.objs[v].mutable && c.objs[v].vctx == c.ctx {
    return
  }
  if c.objs[v].mutable {
    let d = c.error(code, id.span, "${what} mutates `${text(id.name)}`, which is captured by a closure; closures capture by value (core 3.3)")
    c.note_obj(d, v, "`${text(id.name)}` is declared here, outside the closure")
    c.note(d, "to share mutable state with a closure, capture a `Mutex` or `Atomic` handle (core 5.4)")
    return
  }
  let kind = match c.objs[v].local {
    "param" | "var-param" => "an immutable parameter"
    "recv" | "var-recv" => "a receiver that is not `var`"
    "predeclared" => "a predeclared name"
    _ => "an immutable binding"
  }
  let d = c.error(code, id.span, "${what} needs `${text(id.name)}` to be `var`, but it is ${kind}")
  if d >= 0 && c.objs[v].local == "let" && !c.objs[v].let_value.is_empty() && !c.objs[v].file.is_empty() {
    let ls = c.objs[v].let_span.start
    c.fix(d, "declare `${text(id.name)}` with `var`", [c.replace_edit(Span{start: ls, end: parser.Pos{offset: ls.offset + 3, line: ls.line, col: ls.col + 3}}, "var")])
    c.note(d, "TypeScript's `let` can be reassigned; Xo's `let` cannot, like `const`, and `var` declares a binding that changes (core 3.1)")
  }
  c.note_obj(d, v, "`${text(id.name)}` is declared here")
}

/// One step of a place path: a field, or an index whose constant text is
/// key (known) or unknown (call.go placeSeg).
struct PlaceSeg {
  field: Bytes
  key: Str
  known: Bool
}

/// The root binding of a place expression and the fields and indexes
/// below it, or None when e is not a place (call.go placePath).
fn place_path(e0: Expr) -> (Ident, List[PlaceSeg])? {
  var segs: List[PlaceSeg] = []
  var e = e0
  while {
    match e {
      ParenExpr(x: x, ..) => e = x
      SelectorExpr(x: x, sel: sel, ..) => {
        segs.insert(0, PlaceSeg{field: sel.name, key: "", known: false})
        e = x
      }
      IndexExpr(x: x, index: index, ..) => {
        let (k, ok) = const_key(index)
        segs.insert(0, PlaceSeg{field: b"", key: k, known: ok})
        e = x
      }
      Ident(id) => return Some((id, segs))
      _ => return None
    }
  }
  None
}

/// The text of an index that is a literal integer or a string literal
/// without interpolation (call.go constKey).
fn const_key(e: Expr) -> (Str, Bool) {
  match e {
    ParenExpr(x: x, ..) => const_key(x)
    IntLit(value: value, ..) => ("i${text(value)}", true)
    StringLit(s) => {
      var b = BytesBuilder.new()
      for p in s.parts {
        if p.expr != None {
          return ("", false)
        }
        b.write(p.text)
      }
      ("s${text(b.freeze())}", true)
    }
    _ => ("", false)
  }
}

/// A place passed to a `var` parameter, for the alias check.
struct VarPlace {
  e: Expr
  root: Int
  name: Bytes
  segs: List[PlaceSeg]
}

/// Two `var` arguments of one call that name overlapping places (decision
/// 0111): the same binding where one path is a prefix of the other,
/// unless a step differs for certain (XO0503, call.go checkVarAliases).
fn (var c: Checker) check_var_aliases(es: List[Expr]) {
  if es.len() < 2 {
    return
  }
  var ps: List[VarPlace] = []
  for e in es {
    if let Some((id, segs)) = place_path(e) {
      ps.push(VarPlace{e: e, root: c.lookup_local(id.name), name: id.name, segs: segs})
    }
  }
  for j in 1..ps.len() {
    for i in 0..j {
      let a = ps[i]
      let b = ps[j]
      if a.name != b.name || a.root != b.root {
        continue
      }
      var distinct = false
      var k = 0
      while k < a.segs.len() && k < b.segs.len() {
        let x = a.segs[k]
        let y = b.segs[k]
        if x.field != y.field || (x.field.is_empty() && x.known && y.known && x.key != y.key) {
          distinct = true
          break
        }
        k += 1
      }
      if distinct {
        continue
      }
      let at = c.src_of(parser.expr_span(a.e))
      let bt = c.src_of(parser.expr_span(b.e))
      var d = -1
      if at == bt {
        d = c.error("XO0503", parser.expr_span(b.e), "`${bt}` is passed to two `var` parameters of one call (decision 0111)")
        c.note_here(d, parser.expr_span(a.e), "first passed here")
      } else {
        d = c.error("XO0503", parser.expr_span(b.e), "`${bt}` overlaps `${at}`, and both are passed to `var` parameters of one call (decision 0111)")
        c.note_here(d, parser.expr_span(a.e), "`${at}` is passed to a `var` parameter here")
      }
      c.note(d, "copy one of them into a temporary (`var tmp = ${bt}`), pass that, and store it back after the call; or take one `var` parameter of a struct that holds both")
      break
    }
  }
}

// ---------------------------------------------------------------------------
// The tree as nodes (walk.go children, inspect)

/// A node of a body: an expression, a statement, or a block held by a
/// statement or an `if` (the Go checker's ast.Node).
enum Node {
  NExpr(e: Expr)
  NStmt(s: Stmt)
  NBlock(b: Block)
}

fn push_opt(var out: List[Node], e: Expr?) {
  if let Some(x) = e {
    out.push(Node.NExpr(x))
  }
}

/// The direct children of n in source order (walk.go children): patterns
/// and types are not visited.
fn children(n: Node) -> List[Node] {
  var out: List[Node] = []
  match n {
    NBlock(b) => {
      for s in b.stmts {
        out.push(Node.NStmt(s))
      }
    }
    NStmt(s) => {
      match s {
        ExprStmt(x: x, ..) => out.push(Node.NExpr(x))
        LetStmt(value: value, ..) => out.push(Node.NExpr(value))
        VarStmt(value: value, ..) => out.push(Node.NExpr(value))
        AssignStmt(target: target, value: value, ..) => {
          out.push(Node.NExpr(target))
          out.push(Node.NExpr(value))
        }
        DeferStmt(body: body, ..) => out.push(Node.NStmt(body))
        ReturnStmt(value: value, ..) => push_opt(out, value)
        ForStmt(iter: iter, bound: bound, body: body, ..) => {
          out.push(Node.NExpr(iter))
          for b in bound {
            out.push(Node.NExpr(b))
          }
          out.push(Node.NBlock(body))
        }
        WhileStmt(cond: cond, value: value, bound: bound, body: body, ..) => {
          push_opt(out, cond)
          for v in value {
            out.push(Node.NExpr(v))
          }
          for b in bound {
            out.push(Node.NExpr(b))
          }
          out.push(Node.NBlock(body))
        }
        ConstDecl(d: cd) => out.push(Node.NExpr(cd.value))
        BreakStmt(..) | ContinueStmt(..) | BadStmt(..) => {}
      }
    }
    NExpr(e) => {
      match e {
        StringLit(s) => {
          for p in s.parts {
            push_opt(out, p.expr)
          }
        }
        ParenExpr(x: x, ..) => out.push(Node.NExpr(x))
        TupleExpr(elems: els, ..) | ListLit(elems: els, ..) | SetLit(elems: els, ..) => {
          for x in els {
            out.push(Node.NExpr(x))
          }
        }
        MapLit(entries: entries, ..) => {
          for en in entries {
            out.push(Node.NExpr(en.key))
            out.push(Node.NExpr(en.value))
          }
        }
        StructLit(fields: fields, ..) => {
          for f in fields {
            out.push(Node.NExpr(f.value))
          }
        }
        UnaryExpr(x: x, ..) => out.push(Node.NExpr(x))
        BinaryExpr(x: x, y: y, ..) => {
          out.push(Node.NExpr(x))
          out.push(Node.NExpr(y))
        }
        IsExpr(x: x, ..) => out.push(Node.NExpr(x))
        RangeExpr(lo: lo, hi: hi, ..) => {
          push_opt(out, lo)
          push_opt(out, hi)
        }
        SelectorExpr(x: x, ..) => out.push(Node.NExpr(x))
        CallExpr(fun: fun, args: args, ..) => {
          out.push(Node.NExpr(fun))
          for a in args {
            out.push(Node.NExpr(a.value))
          }
        }
        TypeArgsExpr(x: x, ..) => out.push(Node.NExpr(x))
        IndexExpr(x: x, index: index, ..) => {
          out.push(Node.NExpr(x))
          out.push(Node.NExpr(index))
        }
        TryExpr(x: x, ..) => out.push(Node.NExpr(x))
        WithExpr(x: x, fields: fields, ..) => {
          out.push(Node.NExpr(x))
          for f in fields {
            out.push(Node.NExpr(f.value))
          }
        }
        IfExpr(e: ie) => {
          push_opt(out, ie.cond)
          push_opt(out, ie.value)
          out.push(Node.NBlock(ie.then))
          push_opt(out, ie.els)
        }
        MatchExpr(subject: subject, arms: arms, ..) => {
          out.push(Node.NExpr(subject))
          for a in arms {
            push_opt(out, a.guard)
            if let Some(b) = a.body {
              out.push(Node.NStmt(b))
            }
          }
        }
        ScopeExpr(body: body, ..) => out.push(Node.NBlock(body))
        SelectExpr(arms: arms, ..) => {
          for a in arms {
            push_opt(out, a.op)
            push_opt(out, a.after)
            if let Some(b) = a.body {
              out.push(Node.NStmt(b))
            }
          }
        }
        Block(b) => {
          for s in b.stmts {
            out.push(Node.NStmt(s))
          }
        }
        FnLit(f) => out.push(Node.NBlock(f.body))
        WhileExpr(body: body, ..) => out.push(Node.NBlock(body))
        Ident(..) | IntLit(..) | FloatLit(..) | DurationLit(..) | RuneLit(..) | BytesLit(..) | HoleExpr(..) | UnitExpr(..) | BadExpr(..) => {}
      }
    }
  }
  out
}

/// The nodes the inspect passes look at (identifiers, calls, `if`s,
/// assignments, `let` and `var` statements) at or below a node, in source
/// order (walk.go inspect, filtered). A direct walk: building the child
/// lists of every node made the flow checks most of the checker's time.
fn pre_expr(e0: Expr, idents: Bool, var out: List[Node]) {
  // an `else if` chain in a loop (its `else` is the last thing visited),
  // not a call per `if`: the recursion overflowed a browser worker's
  // stack in the wasm build of the compiler (decision 0242)
  var e = e0
  while true {
    match e {
      Ident(..) => {
        if idents {
          out.push(Node.NExpr(e))
        }
        return
      }
      CallExpr(..) | IfExpr(_) => out.push(Node.NExpr(e))
      _ => {}
    }
    match e {
      StringLit(s) => {
        for p in s.parts {
          if let Some(x) = p.expr {
            pre_expr(x, idents, out)
          }
        }
      }
      ParenExpr(x: x, ..) | UnaryExpr(x: x, ..) | IsExpr(x: x, ..) | SelectorExpr(x: x, ..) | TypeArgsExpr(x: x, ..) | TryExpr(x: x, ..) => pre_expr(x, idents, out)
      TupleExpr(elems: els, ..) | ListLit(elems: els, ..) | SetLit(elems: els, ..) => {
        for x in els {
          pre_expr(x, idents, out)
        }
      }
      MapLit(entries: entries, ..) => {
        for en in entries {
          pre_expr(en.key, idents, out)
          pre_expr(en.value, idents, out)
        }
      }
      StructLit(fields: fields, ..) => {
        for f in fields {
          pre_expr(f.value, idents, out)
        }
      }
      BinaryExpr(x: x, y: y, ..) => {
        pre_expr(x, idents, out)
        pre_expr(y, idents, out)
      }
      RangeExpr(lo: lo, hi: hi, ..) => {
        if let Some(x) = lo {
          pre_expr(x, idents, out)
        }
        if let Some(x) = hi {
          pre_expr(x, idents, out)
        }
      }
      CallExpr(fun: fun, args: args, ..) => {
        pre_expr(fun, idents, out)
        for a in args {
          pre_expr(a.value, idents, out)
        }
      }
      IndexExpr(x: x, index: index, ..) => {
        pre_expr(x, idents, out)
        pre_expr(index, idents, out)
      }
      WithExpr(x: x, fields: fields, ..) => {
        pre_expr(x, idents, out)
        for f in fields {
          pre_expr(f.value, idents, out)
        }
      }
      IfExpr(e: ie) => {
        if let Some(x) = ie.cond {
          pre_expr(x, idents, out)
        }
        if let Some(x) = ie.value {
          pre_expr(x, idents, out)
        }
        pre_block(ie.then, idents, out)
        if let Some(x) = ie.els {
          e = x
          continue
        }
      }
      MatchExpr(subject: subject, arms: arms, ..) => {
        pre_expr(subject, idents, out)
        for a in arms {
          if let Some(g) = a.guard {
            pre_expr(g, idents, out)
          }
          if let Some(b) = a.body {
            pre_stmt(b, idents, out)
          }
        }
      }
      SelectExpr(arms: arms, ..) => {
        for a in arms {
          if let Some(x) = a.op {
            pre_expr(x, idents, out)
          }
          if let Some(x) = a.after {
            pre_expr(x, idents, out)
          }
          if let Some(b) = a.body {
            pre_stmt(b, idents, out)
          }
        }
      }
      ScopeExpr(body: body, ..) | WhileExpr(body: body, ..) => pre_block(body, idents, out)
      Block(b) => pre_block(b, idents, out)
      FnLit(f) => pre_block(f.body, idents, out)
      Ident(..) | IntLit(..) | FloatLit(..) | DurationLit(..) | RuneLit(..) | BytesLit(..) | HoleExpr(..) | UnitExpr(..) | BadExpr(..) => {}
    }
    return
  }
}

fn pre_stmt(s: Stmt, idents: Bool, var out: List[Node]) {
  match s {
    AssignStmt(..) | LetStmt(..) | VarStmt(..) => out.push(Node.NStmt(s))
    _ => {}
  }
  match s {
    ExprStmt(x: x, ..) => pre_expr(x, idents, out)
    LetStmt(value: value, ..) | VarStmt(value: value, ..) => pre_expr(value, idents, out)
    AssignStmt(target: target, value: value, ..) => {
      pre_expr(target, idents, out)
      pre_expr(value, idents, out)
    }
    DeferStmt(body: body, ..) => pre_stmt(body, idents, out)
    ReturnStmt(value: value, ..) => {
      if let Some(x) = value {
        pre_expr(x, idents, out)
      }
    }
    ForStmt(iter: iter, bound: bound, body: body, ..) => {
      pre_expr(iter, idents, out)
      for b in bound {
        pre_expr(b, idents, out)
      }
      pre_block(body, idents, out)
    }
    WhileStmt(cond: cond, value: value, bound: bound, body: body, ..) => {
      if let Some(x) = cond {
        pre_expr(x, idents, out)
      }
      for v in value {
        pre_expr(v, idents, out)
      }
      for b in bound {
        pre_expr(b, idents, out)
      }
      pre_block(body, idents, out)
    }
    ConstDecl(d: cd) => pre_expr(cd.value, idents, out)
    BreakStmt(..) | ContinueStmt(..) | BadStmt(..) => {}
  }
}

fn pre_block(b: Block, idents: Bool, var out: List[Node]) {
  for s in b.stmts {
    pre_stmt(s, idents, out)
  }
}

/// The calls, `if`s, assignments, and `let` and `var` statements of a
/// body, in source order: the nodes the inspect passes act on.
fn all_nodes(b: Block) -> List[Node] {
  var out: List[Node] = []
  pre_block(b, false, out)
  out
}

/// The identifiers at or below e, in source order.
fn expr_idents(e: Expr) -> List[Node] {
  var out: List[Node] = []
  pre_expr(e, true, out)
  out
}

// ---------------------------------------------------------------------------
// The walk of the update checks (flow.go walkDecl and walk)

/// An identifier or a `var` statement met by the flow walk, with its
/// context: inside a `defer`, inside a closure (depth), and the loops
/// around it.
struct FlowSite {
  /// The identifier, or the name a `var` statement declares.
  id: Ident
  /// A `var` statement and its value (zero or one element).
  var_value: List[Expr] = []
  in_defer: Bool
  in_fn: Int
  loops: List[Int]
}

/// The state of the flow walk.
struct FlowWalk {
  sites: List[FlowSite] = []
  loops: List[Int] = []
}

/// Walks a body in the order of flow.go walk: children in source order,
/// but an assignment's value before its target, a `defer` body marked,
/// and the loops (For, While, WhileExpr) around each site. walkDecl is
/// the same walk without the closures (in_fn 0) and its order of `var`
/// statements is the same.
fn fw_expr(e0: Expr, in_defer: Bool, in_fn: Int, var w: FlowWalk) {
  // an `else if` chain in a loop (its `else` is the last thing visited),
  // not a call per `if`: the recursion overflowed a browser worker's
  // stack in the wasm build of the compiler (decision 0242)
  var e = e0
  while true {
    match e {
      Ident(id) => w.sites.push(FlowSite{id: id, in_defer: in_defer, in_fn: in_fn, loops: w.loops})
      StringLit(s) => {
        for p in s.parts {
          if let Some(x) = p.expr {
            fw_expr(x, in_defer, in_fn, w)
          }
        }
      }
      ParenExpr(x: x, ..) | UnaryExpr(x: x, ..) | IsExpr(x: x, ..) | SelectorExpr(x: x, ..) | TypeArgsExpr(x: x, ..) | TryExpr(x: x, ..) => fw_expr(x, in_defer, in_fn, w)
      TupleExpr(elems: els, ..) | ListLit(elems: els, ..) | SetLit(elems: els, ..) => {
        for x in els {
          fw_expr(x, in_defer, in_fn, w)
        }
      }
      MapLit(entries: entries, ..) => {
        for en in entries {
          fw_expr(en.key, in_defer, in_fn, w)
          fw_expr(en.value, in_defer, in_fn, w)
        }
      }
      StructLit(fields: fields, ..) => {
        for f in fields {
          fw_expr(f.value, in_defer, in_fn, w)
        }
      }
      BinaryExpr(x: x, y: y, ..) => {
        fw_expr(x, in_defer, in_fn, w)
        fw_expr(y, in_defer, in_fn, w)
      }
      RangeExpr(lo: lo, hi: hi, ..) => {
        if let Some(x) = lo {
          fw_expr(x, in_defer, in_fn, w)
        }
        if let Some(x) = hi {
          fw_expr(x, in_defer, in_fn, w)
        }
      }
      CallExpr(fun: fun, args: args, ..) => {
        fw_expr(fun, in_defer, in_fn, w)
        for a in args {
          fw_expr(a.value, in_defer, in_fn, w)
        }
      }
      IndexExpr(x: x, index: index, ..) => {
        fw_expr(x, in_defer, in_fn, w)
        fw_expr(index, in_defer, in_fn, w)
      }
      WithExpr(x: x, fields: fields, ..) => {
        fw_expr(x, in_defer, in_fn, w)
        for f in fields {
          fw_expr(f.value, in_defer, in_fn, w)
        }
      }
      IfExpr(e: ie) => {
        if let Some(x) = ie.cond {
          fw_expr(x, in_defer, in_fn, w)
        }
        if let Some(x) = ie.value {
          fw_expr(x, in_defer, in_fn, w)
        }
        fw_block(ie.then, in_defer, in_fn, w)
        if let Some(x) = ie.els {
          e = x
          continue
        }
      }
      MatchExpr(subject: subject, arms: arms, ..) => {
        fw_expr(subject, in_defer, in_fn, w)
        for a in arms {
          if let Some(g) = a.guard {
            fw_expr(g, in_defer, in_fn, w)
          }
          if let Some(b) = a.body {
            fw_stmt(b, in_defer, in_fn, w)
          }
        }
      }
      SelectExpr(arms: arms, ..) => {
        for a in arms {
          if let Some(x) = a.op {
            fw_expr(x, in_defer, in_fn, w)
          }
          if let Some(x) = a.after {
            fw_expr(x, in_defer, in_fn, w)
          }
          if let Some(b) = a.body {
            fw_stmt(b, in_defer, in_fn, w)
          }
        }
      }
      ScopeExpr(body: body, ..) => fw_block(body, in_defer, in_fn, w)
      WhileExpr(span: sp, body: body) => {
        w.loops.push(sp.start.offset * 4 + 3)
        fw_block(body, in_defer, in_fn, w)
        w.loops.pop()
      }
      Block(b) => fw_block(b, in_defer, in_fn, w)
      FnLit(f) => fw_block(f.body, in_defer, in_fn + 1, w)
      IntLit(..) | FloatLit(..) | DurationLit(..) | RuneLit(..) | BytesLit(..) | HoleExpr(..) | UnitExpr(..) | BadExpr(..) => {}
    }
    return
  }
}

fn fw_stmt(s: Stmt, in_defer: Bool, in_fn: Int, var w: FlowWalk) {
  match s {
    ExprStmt(x: x, ..) => fw_expr(x, in_defer, in_fn, w)
    LetStmt(value: value, ..) => fw_expr(value, in_defer, in_fn, w)
    VarStmt(name: name, value: value, ..) => {
      w.sites.push(FlowSite{id: name, var_value: [value], in_defer: in_defer, in_fn: in_fn, loops: w.loops})
      fw_expr(value, in_defer, in_fn, w)
    }
    AssignStmt(target: target, value: value, ..) => {
      // the value is evaluated before the target is written
      fw_expr(value, in_defer, in_fn, w)
      fw_expr(target, in_defer, in_fn, w)
    }
    DeferStmt(body: body, ..) => fw_stmt(body, true, in_fn, w)
    ReturnStmt(value: value, ..) => {
      if let Some(x) = value {
        fw_expr(x, in_defer, in_fn, w)
      }
    }
    ForStmt(span: sp, iter: iter, bound: bound, body: body, ..) => {
      w.loops.push(sp.start.offset * 4 + 1)
      fw_expr(iter, in_defer, in_fn, w)
      for b in bound {
        fw_expr(b, in_defer, in_fn, w)
      }
      fw_block(body, in_defer, in_fn, w)
      w.loops.pop()
    }
    WhileStmt(span: sp, cond: cond, value: value, bound: bound, body: body, ..) => {
      w.loops.push(sp.start.offset * 4 + 2)
      if let Some(x) = cond {
        fw_expr(x, in_defer, in_fn, w)
      }
      for v in value {
        fw_expr(v, in_defer, in_fn, w)
      }
      for b in bound {
        fw_expr(b, in_defer, in_fn, w)
      }
      fw_block(body, in_defer, in_fn, w)
      w.loops.pop()
    }
    ConstDecl(d: cd) => fw_expr(cd.value, in_defer, in_fn, w)
    BreakStmt(..) | ContinueStmt(..) | BadStmt(..) => {}
  }
}

fn fw_block(b: Block, in_defer: Bool, in_fn: Int, var w: FlowWalk) {
  for s in b.stmts {
    fw_stmt(s, in_defer, in_fn, w)
  }
}

fn flow_walk(body: Block) -> List[FlowSite] {
  var w = FlowWalk{}
  fw_block(body, false, 0, w)
  w.sites
}

/// The `var` statements of a body outside nested closures, with the
/// loops around each (flow.go walkDecl). copy_out keeps only those
/// initialized with a copy out of a collection; otherwise those not
/// already lost.
fn (c: Checker) flow_cands(sites: List[FlowSite], copy_out: Bool) -> List[FlowCand] {
  var out: List[FlowCand] = []
  for st in sites {
    if st.in_fn > 0 {
      continue
    }
    let value = match st.var_value.first() {
      Some(x) => x
      None => continue
    }
    let v = c.ident_obj(st.id)
    if v < 0 {
      continue
    }
    if (copy_out && c.copy_out_init(value)) || (!copy_out && !c.lost_vars.contains(v)) {
      out.push(FlowCand{v: v, value: value, loops: st.loops})
    }
  }
  out
}

/// The occurrences of the candidate locals (flow.go walk, made once for
/// all candidates): kinds gives each occurrence's kind by name_key, -1
/// to skip it.
fn (c: Checker) cand_events(sites: List[FlowSite], cands: List[FlowCand], kinds: Map[Int, Int]) -> Map[Int, List[FlowEvent]] {
  var set: Map[Int, Bool] = {}
  for cd in cands {
    set[cd.v] = true
  }
  var out: Map[Int, List[FlowEvent]] = {}
  for st in sites {
    if !st.var_value.is_empty() {
      continue
    }
    let v = c.ident_obj(st.id)
    if v < 0 || !set.contains(v) {
      continue
    }
    let k = kinds.get(c.name_key(st.id.span.start.offset)) ?? -1
    if k >= 0 {
      let ev = FlowEvent{id: st.id, kind: k, in_defer: st.in_defer, loops: st.loops}
      out.update(v, [], fn(var evs) { evs.push(ev) })
    }
  }
  out
}

/// The local an identifier names, as check.go identObj: a use records
/// it, a pattern or `var` declares it; -1 for none.
fn (c: Checker) ident_obj(id: Ident) -> Int {
  let key = c.name_key(id.span.start.offset)
  if let Some(o) = c.decl_at.get(key) {
    return o
  }
  if let Some(i) = c.name_at.get(key) {
    let o = c.names[i].obj
    if o >= 0 && c.objs[o].kind == ObjKind.Local {
      return o
    }
  }
  -1
}

/// The span of a local's declaring name.
fn (c: Checker) obj_span(o: Int) -> Span {
  let x = c.objs[o]
  Span{start: parser.Pos{offset: 0, line: x.line, col: x.col}, end: parser.Pos{offset: 0, line: x.line, col: x.col + x.name.len()}}
}

// ---------------------------------------------------------------------------
// The flow checks of one body (flow.go flowBody)

fn (var c: Checker) flow_bodies() {
  let saved_file = c.cur_file
  let saved_mod = c.cur_mod
  let saved_path = c.path
  for b in c.bodies {
    c.set_file(b.file)
    let nodes = all_nodes(b.body)
    let sites = flow_walk(b.body)
    // the move walk acts only at identifiers of move only locals
    if c.names_move_only(sites) {
      c.check_moves(b.body)
    }
    c.lost_updates(sites, nodes)
    c.stored_updates(sites, nodes)
    c.split_critical_sections(nodes)
  }
  if saved_file >= 0 {
    c.set_file(saved_file)
  }
  c.cur_mod = saved_mod
  c.path = saved_path
}

// ---------------------------------------------------------------------------
// Moves (core 5.3)

fn (c: Checker) is_move_only(t: Int) -> Bool {
  if t < 0 {
    return false
  }
  let r = c.resolve(t)
  if c.tys[r].kind != TyKind.Named || c.objs[c.tys[r].obj].module != c.prelude {
    return false
  }
  let n = c.objs[c.tys[r].obj].name
  n == b"Buf" || n == b"StrBuilder" || n == b"BytesBuilder"
}

/// The moved locals and where each was moved.
type Moved = Map[Int, Span]

fn union_moved(a: Moved, b: Moved) -> Moved {
  var out = a
  for (k, v) in b.entries() {
    if !out.contains(k) {
      out[k] = v
    }
  }
  out
}

/// Whether an identifier of the walk names a local of a move only type.
fn (c: Checker) names_move_only(sites: List[FlowSite]) -> Bool {
  for st in sites {
    if st.var_value.is_empty() {
      let v = c.ident_obj(st.id)
      if v >= 0 && c.is_move_only(c.objs[v].ty) {
        return true
      }
    }
  }
  false
}

fn (var c: Checker) check_moves(body: Block) {
  var moved: Moved = {}
  c.mv_block(body, true, moved)
}

fn (var c: Checker) mv_block(b: Block, tail_moves: Bool, var moved: Moved) {
  let n = b.stmts.len()
  for (i, s) in b.stmts.indexed() {
    if let ExprStmt(x: x, ..) = s {
      if i == n - 1 && tail_moves {
        c.mv_expr(x, true, moved)
        continue
      }
    }
    c.mv_stmt(s, moved)
  }
}

fn (var c: Checker) mv_stmt(s: Stmt, var moved: Moved) {
  match s {
    ExprStmt(x: x, ..) => c.mv_expr(x, false, moved)
    LetStmt(pattern: pattern, value: value, ..) => {
      c.mv_expr(value, true, moved)
      // a binding declared in a loop body is a new binding each time
      // round: a move in the last iteration does not carry over
      if let BindPat(name: name, ..) = pattern {
        let v = c.ident_obj(name)
        if v >= 0 {
          moved.remove(v)
        }
      }
    }
    VarStmt(name: name, value: value, ..) => {
      c.mv_expr(value, true, moved)
      let v = c.ident_obj(name)
      if v >= 0 {
        moved.remove(v)
      }
    }
    AssignStmt(op: op, target: target, value: value, ..) => {
      c.mv_expr(value, true, moved)
      if let Ident(id) = target {
        if op == parser.Kind.Assign {
          let v = c.ident_obj(id)
          if v >= 0 {
            moved.remove(v) // reassignment gives the binding a new value
          }
          return
        }
      }
      c.mv_expr(target, false, moved)
    }
    DeferStmt(body: body, ..) => c.mv_stmt(body, moved)
    ReturnStmt(value: value, ..) => {
      if let Some(x) = value {
        c.mv_expr(x, true, moved)
      }
    }
    ForStmt(iter: iter, body: body, ..) => {
      c.mv_expr(iter, false, moved)
      c.mv_loop(body, moved)
    }
    WhileStmt(cond: cond, value: value, body: body, ..) => {
      if let Some(x) = cond {
        c.mv_expr(x, false, moved)
      }
      for x in value {
        c.mv_expr(x, false, moved)
      }
      c.mv_loop(body, moved)
    }
    BreakStmt(..) | ContinueStmt(..) | BadStmt(..) | ConstDecl(_) => {}
  }
}

/// A loop body walked twice, so a move in one iteration is seen by the
/// next; the loop may also not run at all.
fn (var c: Checker) mv_loop(body: Block, var moved: Moved) {
  let before = moved
  c.mv_block(body, false, moved)
  c.mv_block(body, false, moved)
  moved = union_moved(before, moved)
}

/// Walks e; mv is true when e's value is moved (bound, passed to a non
/// var parameter, returned, stored).
fn (var c: Checker) mv_expr(e: Expr, mv: Bool, var moved: Moved) {
  match e {
    Ident(id) => {
      let v = c.ident_obj(id)
      if v < 0 || !c.is_move_only(c.objs[v].ty) {
        return
      }
      if let Some(at) = moved.get(v) {
        let d = c.error("XO0510", id.span, "use of moved value `${text(id.name)}`")
        c.note_here(d, at, "`${text(id.name)}` was moved here")
        c.note(d, "`Buf`, `StrBuilder`, and `BytesBuilder` are move only: assigning, passing, returning, freezing, or capturing in a closure moves them (core 5.3)")
        return
      }
      if mv {
        moved[v] = id.span
      }
    }
    ParenExpr(x: x, ..) => c.mv_expr(x, mv, moved)
    CallExpr(fun: fun, args: args, ..) => {
      let ci = c.call_infos.get(c.expr_key(e))
      var recv: List[Expr] = []
      var fn_moves = false
      var no_params = false
      var var_args: List[Int] = []
      var known: List[Int] = []
      if let Some(info) = ci {
        recv = info.recv
        fn_moves = info.fn_obj >= 0 && c.objs[info.fn_obj].moves
        no_params = info.fn_obj < 0 && info.params.is_empty()
        for p in info.params {
          let k = c.expr_key(p.arg)
          known.push(k)
          if p.is_var {
            var_args.push(k)
          }
        }
      }
      var walked = false
      if let Some(r) = recv.first() {
        let rk = c.expr_key(r)
        if let SelectorExpr(x: sx, ..) = fun {
          if c.expr_key(sx) == rk {
            c.mv_expr(r, fn_moves, moved)
          } else {
            c.mv_expr(fun, false, moved)
          }
          walked = true
        } else if let TypeArgsExpr(x: tx, ..) = fun {
          if let SelectorExpr(x: sx, ..) = tx {
            if c.expr_key(sx) == rk {
              c.mv_expr(r, fn_moves, moved)
            }
          }
          walked = true
        }
      }
      if !walked {
        c.mv_expr(fun, false, moved)
      }
      for a in args {
        let k = c.expr_key(a.value)
        if !known.contains(k) && ci != None && no_params {
          c.mv_expr(a.value, true, moved)
          continue
        }
        c.mv_expr(a.value, !var_args.contains(k), moved)
      }
    }
    FnLit(f) => {
      // captured move only values move into the closure
      var ids: List[Node] = []
      pre_block(f.body, true, ids)
      for n in ids {
        if let NExpr(Ident(id)) = n {
          let v = c.ident_obj(id)
          if v >= 0 && c.objs[v].vctx >= 0 && c.is_move_only(c.objs[v].ty) && !c.declared_within(v, f.span) {
            c.mv_expr(Expr.Ident(id), true, moved)
          }
        }
      }
    }
    Block(b) => c.mv_block(b, mv, moved)
    IfExpr(e: x) => {
      if let Some(cond) = x.cond {
        c.mv_expr(cond, false, moved)
      }
      if let Some(v) = x.value {
        c.mv_expr(v, false, moved)
      }
      let start = moved
      c.mv_block(x.then, mv, moved)
      let after_then = moved
      moved = start
      if let Some(els) = x.els {
        c.mv_expr(els, mv, moved)
      }
      moved = union_moved(after_then, moved)
    }
    MatchExpr(subject: subject, arms: arms, ..) => {
      c.mv_expr(subject, false, moved)
      let start = moved
      var result = moved
      for arm in arms {
        moved = start
        if let Some(g) = arm.guard {
          c.mv_expr(g, false, moved)
        }
        if let Some(body) = arm.body {
          if let ExprStmt(x: bx, ..) = body {
            c.mv_expr(bx, mv, moved)
          } else {
            c.mv_stmt(body, moved)
          }
        }
        result = union_moved(result, moved)
      }
      moved = result
    }
    SelectExpr(arms: arms, ..) => {
      let start = moved
      var result = moved
      for arm in arms {
        moved = start
        if let Some(op) = arm.op {
          c.mv_expr(op, false, moved)
        }
        if let Some(af) = arm.after {
          c.mv_expr(af, false, moved)
        }
        if let Some(body) = arm.body {
          c.mv_stmt(body, moved)
        }
        result = union_moved(result, moved)
      }
      moved = result
    }
    WhileExpr(body: body, ..) => c.mv_loop(body, moved)
    ScopeExpr(body: body, ..) => c.mv_block(body, mv, moved)
    StructLit(fields: fields, ..) => {
      for f in fields {
        c.mv_expr(f.value, true, moved)
      }
    }
    WithExpr(x: x, fields: fields, ..) => {
      c.mv_expr(x, false, moved)
      for f in fields {
        c.mv_expr(f.value, true, moved)
      }
    }
    ListLit(elems: els, ..) | SetLit(elems: els, ..) | TupleExpr(elems: els, ..) => {
      for x in els {
        c.mv_expr(x, true, moved)
      }
    }
    MapLit(entries: entries, ..) => {
      for en in entries {
        c.mv_expr(en.key, true, moved)
        c.mv_expr(en.value, true, moved)
      }
    }
    _ => {
      for ch in children(Node.NExpr(e)) {
        match ch {
          NExpr(x) => c.mv_expr(x, false, moved)
          NStmt(s) => c.mv_stmt(s, moved)
          NBlock(_) => {}
        }
      }
    }
  }
}

/// Whether local v is declared inside the closure spanning sp.
fn (c: Checker) declared_within(v: Int, sp: Span) -> Bool {
  let x = c.objs[v]
  if x.file != c.path {
    return false
  }
  let after_start = x.line > sp.start.line || (x.line == sp.start.line && x.col >= sp.start.col)
  let end_col = x.col + x.name.len()
  let before_end = x.line < sp.end.line || (x.line == sp.end.line && end_col <= sp.end.col)
  after_start && before_end
}

// ---------------------------------------------------------------------------
// Lost updates (core 5.2, decision 0023)

/// Whether e copies an element out of a collection: `m.get(k)`, `m[k]`,
/// `xs[i]`, `xs.get(i)`, `first`, `last`, `find`, optionally followed by
/// `??`, `?`, or `.or_err(...)?` (core 5.2, decision 0034).
fn (c: Checker) copy_out_init(e0: Expr) -> Bool {
  var e = e0
  while {
    match e {
      ParenExpr(x: x, ..) => e = x
      TryExpr(x: x, ..) => {
        e = x
        if let CallExpr(fun: fun, ..) = x {
          if let SelectorExpr(x: sx, sel: sel, ..) = fun {
            if sel.name == b"or_err" {
              e = sx
            }
          }
        }
      }
      BinaryExpr(op: op, x: x, ..) => {
        if op != parser.Kind.Coalesce {
          return false
        }
        e = x
      }
      _ => break
    }
  }
  match e {
    IndexExpr(x: x, index: index, ..) => {
      if index is RangeExpr(..) {
        return false
      }
      c.is_list_or_map(c.type_of(x))
    }
    CallExpr(fun: fun, ..) => {
      if let SelectorExpr(x: sx, sel: sel, ..) = fun {
        if sel.name == b"get" || sel.name == b"first" || sel.name == b"last" || sel.name == b"find" {
          return c.is_list_or_map(c.type_of(sx))
        }
      }
      false
    }
    _ => false
  }
}

fn (c: Checker) is_list_or_map(t: Int) -> Bool {
  t >= 0 && (c.is_prelude(t, "List") || c.is_prelude(t, "Map"))
}

/// An occurrence of a candidate binding (flow.go luEvent, suEvent).
struct FlowEvent {
  id: Ident
  /// Lost updates: a mutation, a store; stored updates: 0 store, 1
  /// reset, 2 mutate.
  mutate: Bool = false
  store: Bool = false
  kind: Int = 0
  in_defer: Bool
  loops: List[Int]
}

/// A candidate binding: a `var` and the loops around its declaration.
struct FlowCand {
  v: Int
  value: Expr
  loops: List[Int]
}

/// The kinds of an occurrence for lost updates: a read, a mutation (an
/// assignment target, a `var` receiver or argument), or a store (the
/// whole binding passed to a call or assigned).
const EV_READ = 0
const EV_MUTATE = 1
const EV_STORE = 2

/// XO0520 for a `var` copied out of a collection, changed, and never
/// stored again (flow.go lostUpdates).
fn (var c: Checker) lost_updates(sites: List[FlowSite], nodes: List[Node]) {
  let cands = c.flow_cands(sites, true)
  if cands.is_empty() {
    return
  }
  // mutation sites: assignment targets, var receivers, var arguments
  var mutating: Map[Int, Bool] = {}
  for n in nodes {
    match n {
      NStmt(AssignStmt(target: target, ..)) => {
        if let Some(id) = place_root(target) {
          mutating[c.name_key(id.span.start.offset)] = true
        }
      }
      NExpr(e) => {
        if e is CallExpr(..) {
          if let Some(ci) = c.call_infos.get(c.expr_key(e)) {
            if ci.fn_obj >= 0 && c.objs[ci.fn_obj].recv_var {
              if let Some(r) = ci.recv.first() {
                if let Some(id) = place_root(r) {
                  mutating[c.name_key(id.span.start.offset)] = true
                }
              }
            }
            for p in ci.params {
              if p.is_var {
                if let Some(id) = place_root(p.arg) {
                  mutating[c.name_key(id.span.start.offset)] = true
                }
              }
            }
          }
        }
      }
      NBlock(_) => {}
      _ => {}
    }
  }
  // store sites: the whole value passed as a call argument (which may
  // store it, as `m.put(k, v)` does) or assigned as a whole
  var storing: Map[Int, Bool] = {}
  for n in nodes {
    match n {
      NExpr(CallExpr(args: args, ..)) => {
        for a in args {
          if let Ident(id) = unparen(a.value) {
            storing[c.name_key(id.span.start.offset)] = true
          }
        }
      }
      NStmt(AssignStmt(value: value, ..)) => {
        if let Ident(id) = unparen(value) {
          storing[c.name_key(id.span.start.offset)] = true
        }
      }
      NBlock(_) => {}
      _ => {}
    }
  }
  var kinds: Map[Int, Int] = {}
  for st in sites {
    if st.var_value.is_empty() {
      let k = c.name_key(st.id.span.start.offset)
      if mutating.contains(k) {
        kinds[k] = EV_MUTATE
      } else if storing.contains(k) {
        kinds[k] = EV_STORE
      } else {
        kinds[k] = EV_READ
      }
    }
  }
  let all_events = c.cand_events(sites, cands, kinds)
  for cd in cands {
    let events = all_events.get(cd.v) ?? []
    var lost = -1
    for (i, ev) in events.indexed() {
      if ev.kind != EV_MUTATE {
        continue
      }
      // A copy out of a collection that is changed must be stored again
      // after its last change; reading it afterwards is not enough.
      var read_after = false
      for (j, r) in events.indexed() {
        if r.kind != EV_STORE {
          continue
        }
        if r.in_defer || j > i {
          read_after = true
          break
        }
        // a read earlier in a loop body that also contains the mutation
        // runs again on the next iteration
        for l in ev.loops {
          if cd.loops.contains(l) {
            continue
          }
          if r.loops.contains(l) {
            read_after = true
          }
        }
        if read_after {
          break
        }
      }
      if !read_after {
        lost = i
      }
    }
    if lost < 0 {
      continue
    }
    c.lost_vars[cd.v] = true
    let vn = text(c.objs[cd.v].name)
    let d = c.error("XO0520", events[lost].id.span, "mutation of `${vn}` is never written back")
    if d >= 0 {
      c.note_here(d, parser.expr_span(cd.value), "`${vn}` is a copy of a collection element taken here; changing it does not change the collection (core 5.2)")
      c.note(d, "write it back (for example `m.put(k, ${vn})`) or mutate in place with `update` (core 5.2)")
    }
  }
}

// ---------------------------------------------------------------------------
// Values mutated after being stored (core 5.2, decision 0034)

const SU_STORE = 0
const SU_RESET = 1
const SU_MUTATE = 2

fn is_store_method(name: Bytes) -> Bool {
  name == b"push" || name == b"put" || name == b"insert" || name == b"set" || name == b"add" || name == b"update"
}

/// A prelude List, Map, or Set.
fn (c: Checker) is_collection(t: Int) -> Bool {
  t >= 0 && (c.is_prelude(t, "List") || c.is_prelude(t, "Map") || c.is_prelude(t, "Set"))
}

/// XO0520 for a local `var` changed after being stored into a collection
/// and not stored again (flow.go storedUpdates).
fn (var c: Checker) stored_updates(sites: List[FlowSite], nodes: List[Node]) {
  let cands = c.flow_cands(sites, false)
  if cands.is_empty() {
    return
  }
  // classify identifier occurrences
  var kinds: Map[Int, Int] = {}
  for n in nodes {
    match n {
      NStmt(AssignStmt(op: op, target: target, value: value, ..)) => {
        var done = false
        if let Ident(id) = target {
          if op == parser.Kind.Assign {
            kinds[c.name_key(id.span.start.offset)] = SU_RESET
            done = true
          }
        }
        if !done {
          if let Some(id) = place_root(target) {
            kinds[c.name_key(id.span.start.offset)] = SU_MUTATE
          }
        }
        if let IndexExpr(x: ix, ..) = target {
          if op == parser.Kind.Assign && c.is_collection(c.type_of(ix)) {
            if let Ident(id) = unparen(value) {
              kinds[c.name_key(id.span.start.offset)] = SU_STORE
            }
          }
        }
      }
      NExpr(e) => {
        if !(e is CallExpr(..)) {
          continue
        }
        let ci = match c.call_infos.get(c.expr_key(e)) {
          Some(x) => x
          None => continue
        }
        if ci.fn_obj >= 0 && c.objs[ci.fn_obj].recv_var {
          if let Some(r) = ci.recv.first() {
            if let Some(id) = place_root(r) {
              kinds[c.name_key(id.span.start.offset)] = SU_MUTATE
            }
            let fo = ci.fn_obj
            if is_store_method(c.objs[fo].name) && c.objs[fo].recv >= 0 && c.objs[c.objs[fo].recv].module == c.prelude && c.is_collection(c.type_of(r)) {
              for p in ci.params {
                if p.is_var {
                  continue
                }
                if let Ident(id) = unparen(p.arg) {
                  kinds[c.name_key(id.span.start.offset)] = SU_STORE
                }
              }
            }
          }
        }
        for p in ci.params {
          if p.is_var {
            if let Some(id) = place_root(p.arg) {
              kinds[c.name_key(id.span.start.offset)] = SU_MUTATE
            }
          }
        }
      }
      NBlock(_) => {}
      _ => {}
    }
  }
  let all_events = c.cand_events(sites, cands, kinds)
  for cd in cands {
    let events = all_events.get(cd.v) ?? []
    var lost = -1
    var stored_at = -1
    for (i, ev) in events.indexed() {
      if ev.kind != SU_MUTATE || ev.in_defer {
        continue
      }
      var before = -1
      for (j, s) in events.indexed() {
        if s.kind != SU_STORE || s.in_defer {
          continue
        }
        if (j < i && !reset_between(events, j, i)) || (j > i && shared_loop(ev, s, cd.loops)) {
          before = j
          break
        }
      }
      if before < 0 {
        continue
      }
      var again = false
      for (j, s) in events.indexed() {
        if s.kind != SU_STORE {
          continue
        }
        if s.in_defer || (j > i && !reset_between(events, i, j)) || (j < i && shared_loop(ev, s, cd.loops)) {
          again = true
          break
        }
      }
      if !again {
        lost = i
        stored_at = before
      }
    }
    if lost < 0 {
      continue
    }
    c.lost_vars[cd.v] = true
    let vn = text(c.objs[cd.v].name)
    let d = c.error("XO0520", events[lost].id.span, "mutation of `${vn}` is never written back")
    if d >= 0 {
      c.note_here(d, events[stored_at].id.span, "`${vn}` was stored into a collection here; the stored copy does not see later changes (core 5.2)")
      c.note(d, "make the change before storing `${vn}`, or store it again after the change")
    }
  }
}

/// A loop around both events that does not enclose the declaration runs
/// them again in the next iteration.
fn shared_loop(a: FlowEvent, b: FlowEvent, decl_loops: List[Int]) -> Bool {
  for l in a.loops {
    if decl_loops.contains(l) {
      continue
    }
    if b.loops.contains(l) {
      return true
    }
  }
  false
}

fn reset_between(events: List[FlowEvent], i: Int, j: Int) -> Bool {
  for k in i + 1..j {
    if events[k].kind == SU_RESET {
      return true
    }
  }
  false
}

// ---------------------------------------------------------------------------
// Split critical sections (core 5.4)

/// `a` or `a.b.c` for comparing mutex receivers; other expressions give
/// "".
fn path_text(e: Expr) -> Str {
  match unparen(e) {
    Ident(id) => text(id.name)
    SelectorExpr(x: x, sel: sel, ..) => {
      let p = path_text(x)
      if p.is_empty() {
        return ""
      }
      "${p}.${text(sel.name)}"
    }
    _ => ""
  }
}

/// The receiver path of a `<mutex>.with(...)` call (with read set, also
/// of `with_read`), and the call; "" when e is not one.
fn (c: Checker) mutex_with(e: Expr, read: Bool) -> (Str, Expr) {
  let call = unparen(e)
  if let CallExpr(fun: fun, ..) = call {
    if let SelectorExpr(x: sx, sel: sel, ..) = fun {
      if sel.name != b"with" && !(read && sel.name == b"with_read") {
        return ("", call)
      }
      let t = c.type_of(sx)
      if t < 0 || !c.is_prelude(t, "Mutex") {
        return ("", call)
      }
      return (path_text(sx), call)
    }
  }
  ("", call)
}

/// The first identifier in n naming a tainted local (of mutex, or of any
/// when mutex is ""), or None.
fn (c: Checker) tainted_ref(e: Expr, tainted: Map[Int, Str], mutex: Str) -> Ident? {
  if tainted.is_empty() {
    return None
  }
  for m in expr_idents(e) {
    if let NExpr(Ident(id)) = m {
      let v = c.ident_obj(id)
      if v >= 0 {
        let mu = tainted.get(v) ?? ""
        if !mu.is_empty() && (mutex.is_empty() || mu == mutex) {
          return Some(id)
        }
      }
    }
  }
  None
}

/// XO0804 (a warning) when a value read inside one `m.with(...)` is used
/// inside a later `m.with(...)` on the same mutex (flow.go
/// splitCriticalSections).
fn (var c: Checker) split_critical_sections(nodes: List[Node]) {
  var tainted: Map[Int, Str] = {}
  // decided[m]: a stale value a branch already acted on
  var decided: Map[Str, Ident] = {}
  for n in nodes {
    match n {
      NStmt(LetStmt(pattern: pattern, value: value, ..)) => {
        let (mu, _) = c.mutex_with(value, true)
        var taint = mu
        if mu.is_empty() {
          if let Some(id) = c.tainted_ref(value, tainted, "") {
            taint = tainted.get(c.ident_obj(id)) ?? ""
          } else {
            continue
          }
        }
        // only a top level binding: walk.go visits no patterns below it
        if let BindPat(name: name, ..) = pattern {
          let v = c.ident_obj(name)
          if v >= 0 {
            tainted[v] = taint
          }
        }
      }
      NStmt(VarStmt(name: name, value: value, ..)) => {
        let v = c.ident_obj(name)
        if v >= 0 {
          let (mu, _) = c.mutex_with(value, true)
          if !mu.is_empty() {
            tainted[v] = mu
          } else if let Some(id) = c.tainted_ref(value, tainted, "") {
            tainted[v] = tainted.get(c.ident_obj(id)) ?? ""
          }
        }
      }
      NExpr(e) => {
        match e {
          IfExpr(e: ie) => {
            let cond = ie.cond ?? ie.value
            if let Some(cx) = cond {
              if let Some(id) = c.tainted_ref(cx, tainted, "") {
                let mu = tainted.get(c.ident_obj(id)) ?? ""
                if !decided.contains(mu) {
                  decided[mu] = id
                }
              }
            }
          }
          CallExpr(..) => {
            let (mu, call) = c.mutex_with(e, false)
            let key = c.expr_key(call)
            if mu.is_empty() || c.split_warned.contains(key) {
              continue
            }
            if let Some(id) = decided.get(mu) {
              c.split_warned[key] = true
              let d = c.warn("XO0804", parser.expr_span(call), "this `${mu}.with` acts on a decision about `${text(id.name)}`, which was read in an earlier `${mu}.with`")
              c.note(d, "another task may have changed it since; do the check and the action in one `with` (core 5.4)")
              continue
            }
            if let CallExpr(args: args, ..) = call {
              for a in args {
                if let Some(id) = c.tainted_ref(a.value, tainted, mu) {
                  c.split_warned[key] = true
                  let d = c.warn("XO0804", id.span, "`${text(id.name)}` was read in an earlier `${mu}.with`; another task may have changed it since")
                  c.note(d, "do the read and the update in one `with` so the check and the action are atomic (core 5.4)")
                  break
                }
              }
            }
          }
          _ => {}
        }
      }
      NBlock(_) => {}
      _ => {}
    }
  }
}

// ---------------------------------------------------------------------------
// Unused bindings (stmt.go reportUnused)

/// XO0110 for `let` and `var` bindings never read, and XO0201 for a
/// Result bound to a name never read, except the lost updates (XO0520 is
/// the more precise diagnostic).
fn (var c: Checker) report_unused() {
  for v in c.unused {
    if c.lost_vars.contains(v) {
      continue
    }
    let o = c.objs[v]
    if c.is_result(o.ty) {
      // A Result bound to a name that is never read is an ignored error,
      // even when the name starts with `_` (core 2.6).
      let d = c.report(o.file, "XO0201", c.obj_span(v), "result bound to `${text(o.name)}` is never used, so its error is ignored")
      if d >= 0 {
        c.note(d, "the value can fail with `${c.show(c.result_e(o.ty))}`; propagate with `?`, match on it, or discard it with `.ignore_err(\"reason\")` (core 2.6)")
        if !o.let_value.is_empty() {
          let saved = c.path
          c.path = o.file
          var edits = [c.replace_edit(c.obj_span(v), "_")]
          for e in c.ignore_err_edits(o.let_value[0]) {
            edits.push(e)
          }
          c.path = saved
          c.fix(d, "discard with a reason", edits)
        }
      }
      continue
    }
    let d = c.report(o.file, "XO0110", c.obj_span(v), "`${text(o.name)}` is never used")
    if d >= 0 && c.dollar_habit(d, v) {
      continue
    }
    if d >= 0 {
      c.note(d, "prefix the name with `_` or write `_` to discard it (core 3.1)")
      c.fix(d, "rename to `_${text(o.name)}`", [DEdit{span: JSpan{file: o.file, line: c.obj_span(v).start.line, col: c.obj_span(v).start.col, end_line: c.obj_span(v).end.line, end_col: c.obj_span(v).end.col}, replace: "_${text(o.name)}"}])
    }
  }
}
