// The canonical dump, the names and diags sections of `xo typedump`
// (internal/check/dump.go, decision 0141).

/// Runs the checker's passes over the loaded modules (check.go run):
/// declarations, type declarations, and signatures of every module, then
/// the bodies of the user modules.
fn (var c: Checker) run() {
  for m in c.order {
    c.declare(m)
  }
  for m in c.order {
    c.resolve_types(m)
  }
  for m in c.order {
    c.resolve_sigs(m)
  }
  for m in c.order {
    if !c.mods[m].is_std {
      c.check_derives_comparable(m)
    }
  }
  for m in c.order {
    if !c.mods[m].is_std {
      c.check_module(m)
    }
  }
  c.check_key_types()
  // check.go reportAmbiguous: a closure result that nothing determined
  // and whose body never completes is Never
  for t in c.never_results {
    if c.is_open_var(t) {
      c.unify(t, c.named("Never"))
    }
  }
  // XO0402: type parameters that nothing determined
  var done: List[Str] = []
  for tv in c.type_arg_vars {
    let key = "${tv.file}:${tv.span.start.offset}:${tv.span.end.offset}"
    if c.tys[tv.v].ref >= 0 || done.contains(key) {
      continue
    }
    done.push(key)
    c.report(tv.file, "XO0402", tv.span, "cannot infer type argument `${tv.param}` of `${tv.fn_name}`")
  }
  for m in c.order {
    if !c.mods[m].is_std {
      c.check_unused_imports(m)
    }
  }
}

/// Reports XO0110 for the imports of module m never referenced.
fn (var c: Checker) check_unused_imports(m: Int) {
  for f in c.mods[m].files {
    for u in c.files[f].ast.imports {
      for (_, imp) in c.files[f].imports.entries() {
        if imp.used || imp.span != u.span {
          continue
        }
        c.error_at(f, "XO0110", u.span, "import `${text(u.path)}` is never used")
      }
    }
  }
}

/// The dump of the root modules: names, types, and diagnostics as
/// selected.
pub fn (c: Checker) dump(names: Bool, types: Bool, sigs: Bool, diags: Bool) -> Str {
  var out = StrBuilder.new()
  for m in c.root_mods {
    out.write("== module ${c.mods[m].path} ${c.mods[m].dir}\n")
    for f in c.mods[m].files {
      let path = c.files[f].path
      if names {
        out.write("-- names ${path}\n")
        var lines: List[Str] = []
        for r in c.names {
          if r.file == path {
            let what = if r.obj >= 0 { c.obj_text(r.obj) } else { r.what }
            lines.push("${pad(r.offset)}\t${r.line}:${r.col} ${text(r.name)} ${what}")
          }
        }
        for l in lines.sort() {
          out.write(after_tab(l))
          out.write("\n")
        }
      }
      if types {
        out.write("-- types ${path}\n")
        var lines: List[Str] = []
        for r in c.types {
          if r.file == f {
            // by start, then end descending, then text
            lines.push("${pad(r.start)}${pad(9999999999 - r.end)}\t${r.sline}:${r.scol}-${r.eline}:${r.ecol} ${r.kind} ${c.show(r.ty)}")
          }
        }
        for l in lines.sort() {
          out.write(after_tab(l))
          out.write("\n")
        }
      }
    }
    if sigs {
      out.write("-- sigs\n")
      c.dump_sigs(out, m)
    }
  }
  if diags {
    out.write("== diags\n")
    for l in diag_lines(c.diags) {
      out.write(l)
      out.write("\n")
    }
  }
  out.freeze()
}

/// The diagnostic lines, sorted by position, code, and message.
pub fn diag_lines(ds: List[Diag]) -> List[Str] {
  var keyed: List[Str] = []
  for d in ds {
    let json = "{\"code\":${json_str(d.code)},\"file\":${json_str(d.file)},\"line\":${d.line},\"col\":${d.col},\"end_line\":${d.end_line},\"end_col\":${d.end_col},\"message\":${json_str(d.message)}}"
    keyed.push("${d.file}\x00${pad(d.line)}${pad(d.col)}${d.code}\x00${d.message}\x00\t${json}")
  }
  var out: List[Str] = []
  for k in keyed.sort() {
    out.push(after_tab(k))
  }
  out
}

/// The signature and effects of every function and method declared in
/// module m (dump.go dumpSigs), sorted by file and position.
fn (c: Checker) dump_sigs(var out: StrBuilder, m: Int) {
  var fns: List[Int] = []
  for (_, o) in c.mods[m].members.entries() {
    let x = c.objs[o]
    if x.kind == ObjKind.Func {
      fns.push(o)
    } else if x.kind == ObjKind.Type {
      for (_, f) in x.methods.entries() {
        fns.push(f)
      }
      for (_, f) in x.statics.entries() {
        fns.push(f)
      }
      for f in x.iface_meths {
        fns.push(f)
      }
    }
  }
  var lines: List[Str] = []
  for f in fns {
    let x = c.objs[f]
    if !x.sig_done {
      continue
    }
    var line = "${pos_text(x.file, x.line, x.col)} ${c.display_name(f)} ${c.sig_text(f)}"
    let eff = c.fn_effects_text(f)
    if !eff.is_empty() {
      line = "${line} uses ${eff}"
    }
    lines.push("${x.file}\x00${pad(x.line)}${pad(x.col)}\t${line}")
  }
  for l in lines.sort() {
    out.write(after_tab(l))
    out.write("\n")
  }
}

/// The declared or inferred effects of function f as the sigs section
/// prints them.
fn (c: Checker) fn_effects_text(f: Int) -> Str {
  if c.objs[f].declared >= 0 {
    return c.eff_text(c.objs[f].declared)
  }
  ""
}

/// A signature without its effects: type parameters, receiver,
/// parameters, result, and error type (dump.go sigText).
fn (c: Checker) sig_text(f: Int) -> Str {
  let x = c.objs[f]
  var b = StrBuilder.new()
  if !x.tparams.is_empty() {
    b.write("[")
    for (i, p) in x.tparams.indexed() {
      if i > 0 {
        b.write(", ")
      }
      if c.objs[p].implicit {
        b.write("implicit ")
      }
      b.write(text(c.objs[p].name))
      if c.objs[p].effect {
        b.write(": Effects")
      } else if c.objs[p].constraint >= 0 {
        b.write(": ")
        b.write(c.show(c.objs[p].constraint))
      }
    }
    b.write("]")
  }
  b.write("(")
  if x.recv_ty >= 0 {
    if x.recv_var {
      b.write("var ")
    }
    b.write("self: ")
    b.write(c.show(x.recv_ty))
    if !x.params.is_empty() {
      b.write(", ")
    }
  }
  for (i, p) in x.params.indexed() {
    if i > 0 {
      b.write(", ")
    }
    if p.is_var {
      b.write("var ")
    }
    b.write("${text(p.name)}: ${c.show(p.ty)}")
  }
  b.write(")")
  if x.result >= 0 && !c.is_unit(x.result) {
    b.write(" -> ${c.show(x.result)}")
  }
  if x.err >= 0 {
    b.write(" ! ${c.show(x.err)}")
  }
  b.freeze()
}

fn (c: Checker) obj_text(o: Int) -> Str {
  let x = c.objs[o]
  let pos = if x.file.is_empty() { "-" } else { "${x.file}:${x.line}:${x.col}" }
  match x.kind {
    Local => "local ${x.local} ${pos}"
    Func => "fn ${c.mods[x.module].path} ${c.display_name(o)} ${pos}"
    Const => "const ${c.mods[x.module].path} ${text(x.name)} ${pos}"
    Type => "type ${c.mods[x.module].path} ${text(x.name)} ${pos}"
    TParam => "tparam ${text(x.name)} ${pos}"
    Module => "module ${c.mods[x.module].path}"
  }
}

/// n with leading zeros to 10 digits, for sorting.
fn pad(n: Int) -> Str {
  let s = "${n}"
  "0".repeat(10 - s.len()) + s
}

/// The text after the first tab.
fn after_tab(s: Str) -> Str {
  let b = s.bytes()
  for i in 0..b.len() {
    if b[i] == '\t' {
      return b[i + 1..].to_str() ?? ""
    }
  }
  s
}

/// A JSON string as Go's encoding/json writes it without HTML escaping.
fn json_str(s: Str) -> Str {
  let b = s.bytes()
  var out = StrBuilder.new()
  out.write("\"")
  var run = 0
  var i = 0
  while i < b.len() {
    let ch = b[i]
    var esc = ""
    var width = 1
    if ch == '"' {
      esc = "\\\""
    } else if ch == '\\' {
      esc = "\\\\"
    } else if ch == '\n' {
      esc = "\\n"
    } else if ch == '\r' {
      esc = "\\r"
    } else if ch == '\t' {
      esc = "\\t"
    } else if ch < 0x20 {
      esc = "\\u00${b[i..i + 1].to_hex()}"
    } else if ch == 0xe2 && i + 2 < b.len() && b[i + 1] == 0x80 && (b[i + 2] == 0xa8 || b[i + 2] == 0xa9) {
      esc = if b[i + 2] == 0xa8 { "\\u2028" } else { "\\u2029" }
      width = 3
    }
    if esc.is_empty() {
      i += 1
      continue
    }
    if run < i {
      out.write(b[run..i].to_str() ?? "")
    }
    out.write(esc)
    i += width
    run = i
  }
  if run < b.len() {
    out.write(b[run..].to_str() ?? "")
  }
  out.write("\"")
  out.freeze()
}
