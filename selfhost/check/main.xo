// xocheck: the self hosted checker's command line (decision 0141).
//
//   check [--section=S] [--std=DIR] [--each] <dirs...>   print the dump
//   check [--std=DIR] [--each] --bench=N <dirs...>        check N times, print the time
//
// The dump is the names, types, sigs, diags, and full sections of `xo
// typedump` (the Go checker) for the same directories: --section takes a
// comma separated list of them (default all five). --each checks every directory as a run of
// its own, each preceded by `=== check <dir>`. Std declarations are read
// from DIR (default std). A run that cannot be checked here (`use go`,
// `use c`, a dependency missing from the module cache while online)
// prints `== unsupported <why>`. --wd=DIR names the absolute working
// directory (default $PWD), which module loading needs for the paths Go
// prints absolute and for xo.mod and xo.work files above it; XO_MODCACHE,
// XO_OFFLINE, and XO_WORK are read as internal/mod reads them.

fn main(os: Os) ! {
  var repeat = 0
  var each = false
  var names = true
  var types = true
  var sigs = true
  var diags = true
  var full = true
  var std_dir = "std"
  var wd = os.env.get("PWD") ?? ""
  var dirs: List[Str] = []
  for a in os.env.args() {
    if a.starts_with("--bench=") {
      repeat = Int.parse(a.trim_prefix("--bench=")) ?? fault("--bench needs a number")
    } else if a.starts_with("--section=") {
      let s = a.trim_prefix("--section=")
      names = s.contains("names") || s == "all"
      types = s.contains("types") || s == "all"
      sigs = s.contains("sigs") || s == "all"
      diags = s.contains("diags") || s == "all"
      full = s.contains("full") || s == "all"
    } else if a.starts_with("--std=") {
      std_dir = a.trim_prefix("--std=")
    } else if a.starts_with("--wd=") {
      wd = a.trim_prefix("--wd=")
    } else if a == "--each" {
      each = true
    } else {
      dirs.push(a)
    }
  }
  if dirs.is_empty() {
    os.stdio.eprintln("usage: check [--section=names,types,sigs,diags,full] [--std=DIR] [--each] [--bench=N] <dirs...>")
    os.proc.exit(2)
  }
  let modcache = os.env.get("XO_MODCACHE") ?? ""
  let home = os.env.get("HOME") ?? ""
  let xdg = os.env.get("XDG_CACHE_HOME") ?? ""
  let offline = os.env.get("XO_OFFLINE") ?? ""
  let work = os.env.get("XO_WORK") ?? ""
  var runs: List[List[Str]] = [dirs]
  if each {
    runs = []
    for d in dirs {
      runs.push([d])
    }
  }
  if repeat > 0 {
    let t0 = os.clock.now()
    var mods = 0
    for _ in 0..repeat {
      for r in runs {
        var c = new_checker(os.fs, std_dir)
        c.set_mod_env(wd, modcache, home, xdg, offline, work)
        match c.check_dirs(r) {
          Ok(_) => mods += c.root_mods.len()
          Err(e) => fault("check: ${e}")
        }
      }
    }
    let elapsed = os.clock.now() - t0
    os.stdio.println("checked ${runs.len()} runs x ${repeat}: ${mods} modules in ${elapsed.nanos() / 1_000_000} ms")
    return
  }
  var out = StrBuilder.new()
  for r in runs {
    if each {
      out.write("=== check ${r[0]}\n")
    }
    var c = new_checker(os.fs, std_dir)
    c.set_mod_env(wd, modcache, home, xdg, offline, work)
    match c.check_dirs(r) {
      Ok(_) => {
        if c.unsupported.is_empty() {
          out.write(c.dump(names, types, sigs, diags, full))
        } else {
          out.write("== unsupported ${c.unsupported}\n")
        }
      }
      Err(e) => out.write("== error ${e}\n")
    }
  }
  os.stdio.print(out.freeze())
}
