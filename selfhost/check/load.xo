// Loading: the module directories under the named directories, the user
// modules they import (through xo.mod), and the std declaration files, as
// internal/check/load.go does. Paths stay relative to the working
// directory, as the Go checker prints them; an xo.mod above the working
// directory is not looked for.

use github.com/xo-lang/xo/selfhost/lexer
use github.com/xo-lang/xo/selfhost/parser

/// The checker: its tables (objects.xo), the state of the walk
/// (resolve.xo), and what it recorded.
pub struct Checker {
  fs: Fs
  /// Where the std declaration files are read from.
  std_dir: Str
  pub objs: List[Obj] = []
  pub mods: List[Module] = []
  pub mod_index: Map[Str, Int] = {}
  pub files: List[SrcFile] = []
  /// Modules in dependency order: a module after the modules it imports.
  pub order: List[Int] = []
  pub prelude: Int = -1
  roots: List[ModRoot] = []
  /// The root modules of the run, in the order of their directories.
  pub root_mods: List[Int] = []
  /// Why the run cannot be checked here (`use go`, a parse error), or "".
  pub unsupported: Str = ""
  /// Native mode (check.Options.Native): the implementation modules of
  /// the native backends are loaded and checked too (load_native).
  pub native: Bool = false
  /// $XO_LLRT_C: the runtime modules (or `all`) loaded from their C path,
  /// std/native/llrt/<name>_c.xo, where they have one (load.go
  /// LLRTUsesC; decisions 0193, 0206).
  pub llrt_c: List[Str] = []
  /// $XO_CBIND_DIR: where C bindings are cached (cimport.xo), "" for
  /// `<module root>/.xo/cbind`.
  pub cbind_dir: Str = ""
  /// $XO_GOBIND_DIR: the `use go` binding cache, when set; else
  /// `<module root>/.xo/gobind`.
  pub gobind_dir: Str = ""
  /// The bindings the run needs (bindmiss.xo): `use go` packages without
  /// a current binding and `use c` headers, for check_dirs_bound to bind;
  /// and the ones whose binding failed, by key, with the binder's
  /// message, each reported once.
  pub bind_misses: List[BindMiss] = []
  pub bind_failed: Map[Str, Str] = {}
  bind_reported: Set[Str] = #{}
  /// Module versions (path@version) missing from the module cache, for
  /// check_dirs_fetching to fetch; and the ones whose fetch failed, with
  /// the fetcher's problem.
  pub fetch_misses: List[Str] = []
  pub fetch_failed: Map[Str, Problem] = {}
  /// The xo.mod files of checked modules whose `edition` line names an
  /// old edition name (XO1315), by display path.
  edition_aliases: Map[Str, ModRoot] = {}
  /// The vouch lines of the consuming modules (vouch.xo), read once.
  vouches: List[Vouch] = []
  vouches_read: Bool = false
  /// The escape hatches of required module versions met (vouch.xo).
  pub hatches: List[EscapeHatch] = []
  /// The `os` binding and the `for` parameters of each test block, by
  /// test_key (Info.TestOs, Info.TestParams).
  test_os: Map[Int, Int] = {}
  test_params: Map[Int, List[Int]] = {}
  /// The environment and the dependencies of the main modules
  /// (modfile.xo, deps.xo).
  deps: DepState = DepState{}

  // The walk: the current module and file, local scopes (innermost
  // last), the function context, and what it records.
  cur_mod: Int = -1
  cur_file: Int = -1
  path: Str = ""
  scopes: List[Map[Bytes, Int]] = []
  /// Function contexts (stmt.xo); ctx is the current one, -1 outside
  /// bodies.
  ctxs: List[Ctx] = []
  ctx: Int = -1

  // Types (types.xo, infer.xo).
  pub tys: List[Ty] = []
  /// Variables bound since the start (unify), for undo.
  trail: List[Int] = []
  pub unit_ty: Int = -1
  bad_ty: Int = -1
  /// Named types without arguments, by Type object.
  named0: Map[Int, Int] = {}
  /// Effect sets and effect variables (effects.xo): a variable holds
  /// the set it is bound to, -1 while open.
  esets: List[List[EffItem]] = []
  evars: List[Int] = []
  /// Result types of closures whose body never completes: Never when
  /// nothing else determines them (check.go reportAmbiguous).
  never_results: List[Int] = []
  /// Inference variables of explicit type parameters at calls; unbound
  /// ones at the end are XO0402 (check.go typeArgVars).
  type_arg_vars: List[TypeArgVar] = []
  /// Map and Set types reported for their keys, by file and type
  /// (comparable.go keyReported).
  key_reported: Map[Str, Bool] = {}
  /// Functions whose effects are inferred (not pub, no `uses`), their
  /// effects once solved, and the effect obligations (effects.xo).
  inferred_fns: List[Int] = []
  inferred: Map[Int, Flat] = {}
  obligations: List[EffOb] = []
  /// Functions declared `uses realtime` (realtime.xo).
  realtime_fns: List[Int] = []
  /// Calls of function values, by key (realtime.xo).
  value_calls: Map[Int, Bool] = {}
  /// The target of a plain `m[k] = v` (stmt.xo assign), by key.
  map_store: Int = -1
  /// Scope and group frames of spawned tasks (stmt.xo).
  frames: List[ScopeFrame] = []
  /// `x?.f` optional chains reported as XO0205, by key of the `x?`.
  safe_navs: Map[Int, Bool] = {}
  /// The index in diags of the XO0205 of each optional chain, by key
  /// (habits.go safeNavDiag).
  safe_nav_diag: Map[Int, Int] = {}
  /// Calls of declared functions (by key) and their function; calls
  /// that construct a variant or newtype (for XO0408).
  fn_calls: Map[Int, Int] = {}
  ctor_calls: Map[Int, Bool] = {}

  // Value semantics (stage 5, flow.xo).
  /// The calls of declared functions and function values, by key: the
  /// callee, the receiver, and the arguments with their `var` flags
  /// (check.go callInfo).
  pub call_infos: Map[Int, CallInfo] = {}
  /// The local each binding name declares, by name_key of the name (the
  /// declaring half of check.go identObj; uses are name records).
  pub decl_at: Map[Int, Int] = {}
  /// XO0101 renames of local names, extended to their uses at the end.
  renames: List[Rename] = []
  /// Bodies checked, for the flow checks: closures before the body
  /// holding them (check.go bodies).
  bodies: List[BodyRef] = []
  /// Locals never read, collected when their scope closes (XO0110).
  unused: List[Int] = []
  /// Locals reported as lost updates (XO0520), not also as unused.
  lost_vars: Map[Int, Bool] = {}
  /// Calls warned about as split critical sections (XO0804), by key.
  split_warned: Map[Int, Bool] = {}

  // Results.
  pub names: List[NameRec] = []
  /// Name records by file and offset (name_key).
  pub name_at: Map[Int, Int] = {}
  /// Whether a Named type without type arguments is comparable, by Type
  /// object (infer.xo is_eq_type).
  comparable_at: Map[Int, Bool] = {}
  pub types: List[TypeRec] = []
  pub type_at: Map[Int, Int] = {}
  /// Expressions of type Never checked against an expected type, by key.
  never_expr: Map[Int, Bool] = {}
  pub diags: List[Diag] = []

  // What the SSA builder reads (internal/check info.go records, decision
  // 0150), keyed like type_at (key_of: file, span, kind; a pattern's kind
  // is PAT_KIND + its index).
  /// The type of an expression before implicit conversion (info.go
  /// NaturalType): recorded by infer.
  pub nat_at: Map[Int, Int] = {}
  /// The variant an identifier, selector, or call constructs (Ctor).
  pub ctor_at: Map[Int, VRef] = {}
  /// The type of a conversion or newtype construction `T(x)` (TypeCall).
  pub type_call_at: Map[Int, Int] = {}
  /// The type of the value a pattern matches (PatType), the variant a
  /// variant pattern names (PatVariant), and the newtype a pattern
  /// unwraps (PatNewtype).
  pub pat_type_at: Map[Int, Int] = {}
  pub pat_variant_at: Map[Int, VRef] = {}
  pub pat_newtype_at: Map[Int, Int] = {}
  /// The receiver and parameter bindings of a function body, by function
  /// object (RecvVar, ParamVars), and the parameter bindings of a closure
  /// by the key of its literal (ClosureParams).
  pub recv_var: Map[Int, Int] = {}
  pub param_vars: Map[Int, List[Int]] = {}
  pub closure_vars: Map[Int, List[Int]] = {}
  /// The type arguments of a method used as a value, by the key of its
  /// selector (check.go rec.subst, Info.RefSubst).
  pub ref_subst: Map[Int, Subst] = {}
  /// The `result` binding of an ensures clause, by file and offset of the
  /// clause (check.go rec.resultVar), and the field bindings of a struct
  /// invariant, by Type object (rec.invVars).
  pub result_vars: Map[Int, Int] = {}
  pub inv_vars: Map[Int, List[Int]] = {}
  seen: Map[Str, Bool] = {}
  /// Sources that replace the files on disk, by absolute path
  /// (check.CheckOverlay: `xo fix` checks rewritten sources unwritten).
  pub overlay: Map[Str, Bytes] = {}
}

/// A fresh checker reading std declarations from std_dir.
pub fn new_checker(fs: Fs, std_dir: Str) -> Checker {
  var c = Checker{fs: fs, std_dir: std_dir}
  c.unit_ty = c.new_ty(Ty{kind: TyKind.Tuple})
  c.bad_ty = c.new_ty(Ty{kind: TyKind.Bad})
  c
}

/// Loads the modules under dirs and the std modules they need, then
/// resolves every user module. Errors are I/O failures of the named
/// directories, as in check.Check.
pub fn (var c: Checker) check_dirs(dirs: List[Str]) -> () ! Str uses fs.read {
  c.load_prelude()
  if c.prelude < 0 {
    return Err(c.prelude_missing())
  }
  for d in dirs {
    let st = c.fs.stat(d).ok() ?? None
    match st {
      Some(info) => {
        if !info.is_dir {
          return Err("${d} is not a directory (a module is a directory, core 1.1)")
        }
      }
      None => return Err("stat ${d}: no such file or directory")
    }
  }
  var module_dirs: List[Str] = []
  for d in dirs {
    c.find_module_dirs(clean(d), true, module_dirs)
  }
  module_dirs = module_dirs.sort()
  // resolve the requirements of every main module before loading, so
  // imports of required modules find their selected versions
  for dir in module_dirs {
    if let Some(r) = c.find_mod_root(dir) {
      c.resolve_deps(r)
    }
  }
  for dir in module_dirs {
    let m = c.load_dir(dir)
    c.mods[m].root = true
    c.root_mods.push(m)
  }
  if c.native {
    c.load_native()
  }
  if c.unsupported.is_empty() {
    c.run()?
  }
}

/// Appends dir and every directory below it that holds .xo files,
/// skipping testdata, dot, underscore (decision 0210), and vendor
/// directories below the top.
fn (var c: Checker) find_module_dirs(dir: Str, top: Bool, var out: List[Str]) {
  let entries = c.fs.read_dir(dir).ok() ?? []
  var has_xo = false
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") {
      has_xo = true
    }
  }
  if has_xo && !out.contains(dir) {
    out.push(dir)
  }
  for e in entries {
    if !e.is_dir {
      continue
    }
    let sub = join(dir, e.name)
    if e.name == "testdata" || e.name.starts_with(".") || e.name.starts_with("_") || c.is_vendor_dir(sub) {
      continue
    }
    c.find_module_dirs(sub, false, out)
  }
}

fn (c: Checker) is_vendor_dir(dir: Str) -> Bool {
  base(dir) == "vendor" && (c.fs.exists(join(dir, "modules.txt")).ok() ?? false)
}

fn (var c: Checker) load_prelude() {
  c.prelude = c.load_std("prelude")
  if c.prelude >= 0 {
    c.mods[c.prelude].is_prelude = true
  }
  // std/testing provides the predeclared `os`, `expect`, and `testing`
  // of test blocks (core 9.2), so it is always loaded.
  c.load_std("testing")
}

/// Why the std directory cannot be checked against, or "": no
/// prelude.xo in it (xo1 run outside a release layout with no $XO_STD
/// falls back to ./std, which TestCLIPattern hit on 2026-10-13), or a
/// prelude lacking a core type every check names (an $XO_STD naming
/// another directory; checked by run after the declarations, which fill the
/// members). An error of check_dirs, which every command
/// prints, rather than a fault in prelude_obj during the run.
fn (c: Checker) prelude_missing() -> Str {
  let hint = "set XO_STD to the std directory, or run xo from a release layout, bin/xo beside lib/xo/std"
  if c.prelude < 0 {
    return "std library not found: no ${join(c.std_dir, "prelude.xo")} (${hint})"
  }
  var lacks: List[Str] = []
  for name in ["Bool", "Int", "Never", "Option", "Result", "Str"] {
    let ok = match c.mods[c.prelude].members.get(name.bytes()) {
      Some(o) => c.objs[o].kind == ObjKind.Type
      None => false
    }
    if !ok {
      lacks.push(name)
    }
  }
  if lacks.is_empty() {
    return ""
  }
  "std library ${c.std_dir} does not match this xo: its prelude.xo lacks ${lacks.join(", ")} (${hint})"
}

/// Loads std/<name>.xo, or returns -1 when there is none.
fn (var c: Checker) load_std(name: Str) -> Int {
  let path = "std/${name}"
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let src = c.fs.read("${c.std_dir}/${name}.xo").ok() ?? None
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module(path, name, "std", true)
  c.parse_into(m, "std/${name}.xo", data, true)
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// Loads the implementation modules of the native backends (load.go
/// loadNative, decision 0074): std/native/<name>.xo for the prelude and
/// every std module loaded so far, until no new std module appears (an
/// implementation may import more). They are checked like user modules.
fn (var c: Checker) load_native() {
  var done: Map[Str, Bool] = {}
  while {
    var todo: List[Str] = []
    for m in c.mods {
      if m.is_std && !done.contains(m.path) && m.path.starts_with("std/") {
        todo.push(m.path)
      }
    }
    if todo.is_empty() {
      return
    }
    for path in todo.sort() {
      done[path] = true
      let name = path.trim_prefix("std/")
      let src = c.fs.read("${c.std_dir}/native/${name}.xo").ok() ?? None
      let data = match src {
        Some(b) => b
        None => continue
      }
      let m = c.new_module("native/${name}", name, "std/native", false)
      c.mods[m].native = true
      c.mods[m].implements = path
      c.parse_into(m, "std/native/${name}.xo", data, false)
      c.mods[m].state = 1
      c.load_imports(m)
      c.mods[m].state = 2
      c.order.push(m)
    }
  }
}

/// Loads the runtime module std/native/llrt/<name>.xo (load.go
/// loadRuntimeModule, decision 0180): part of the native runtime written
/// in Xo, checked and compiled with the program like an implementation
/// module (it implements no std module). -1 when there is none.
fn (var c: Checker) load_runtime_module(path: Str) -> Int {
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let name = path.trim_prefix("native/llrt/")
  var file = "${path}.xo"
  var src: Bytes? = None
  if c.llrt_c.contains(name) || c.llrt_c.contains("all") {
    // the C path of a ported part of the runtime, kept selectable until
    // the Xo one meets the bar (decisions 0180, 0193)
    src = c.fs.read("${c.std_dir}/${path}_c.xo").ok()
    if src.is_some() {
      file = "${path}_c.xo"
    }
  }
  if src.is_none() {
    src = c.fs.read("${c.std_dir}/${file}").ok()
  }
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module(path, name, "std/native/llrt", false)
  c.mods[m].native = true
  c.parse_into(m, "std/${file}", data, false)
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// Loads the intrinsics module of the native backends, std/native/rt.xo
/// (load.go loadNativeRT): bodiless declarations lowered to calls of the
/// C runtime. -1 when there is none.
fn (var c: Checker) load_native_rt(path: Str) -> Int {
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let src = c.fs.read("${c.std_dir}/${path}.xo").ok() ?? None
  let data = match src {
    Some(b) => b
    None => return -1
  }
  let m = c.new_module(path, path.trim_prefix("native/"), "std/native", true)
  c.parse_into(m, "std/${path}.xo", data, true)
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

fn (var c: Checker) new_module(path: Str, name: Str, dir: Str, is_std: Bool) -> Int {
  let m = c.mods.len()
  let obj = c.objs.len()
  c.objs.push(Obj{kind: ObjKind.Module, name: name.bytes(), module: m})
  c.mods.push(Module{path: path, name: name, dir: dir, is_std: is_std, obj: obj})
  c.mod_index[path] = m
  m
}

/// Parses a file into module m. The parser's diagnostics join the run's;
/// after errors the tree is the one the Go parser recovers (soft errors,
/// decision 0087, and resynchronization after hard ones), which is
/// checked as usual.
fn (var c: Checker) parse_into(m: Int, path: Str, src: Bytes, sig: Bool) {
  let r = parser.parse_file(path.bytes(), src, sig)
  c.diags = c.diags + parse_diags(path, r.diags)
  let f = c.files.len()
  c.files.push(SrcFile{path: path, module: m, ast: r.file, is_test: path.ends_with("_test.xo"), src: src})
  c.mods[m].files.push(f)
}

/// The diagnostics of the parse of the file at path, as the checker
/// reports them.
pub fn parse_diags(path: Str, ds: List[parser.Diag]) -> List[Diag] {
  var out: List[Diag] = []
  for d in ds {
    var notes: List[DNote] = []
    for n in d.notes {
      var nsp: JSpan? = None
      if let Some(s) = n.span {
        nsp = Some(JSpan{file: path, line: s.start.line, col: s.start.col, end_line: s.end.line, end_col: s.end.col})
      }
      notes.push(DNote{message: lossy_str(n.message), span: nsp})
    }
    var fixes: List[DFix] = []
    for f in d.fixes {
      var edits: List[DEdit] = []
      for e in f.edits {
        edits.push(DEdit{span: JSpan{file: path, line: e.span.start.line, col: e.span.start.col, end_line: e.span.end.line, end_col: e.span.end.col}, replace: lossy_str(e.replace)})
      }
      fixes.push(DFix{title: lossy_str(f.title), edits: edits})
    }
    out.push(Diag{code: d.code, file: path, line: d.span.start.line, col: d.span.start.col, end_line: d.span.end.line, end_col: d.span.end.col, message: lossy_str(d.message), notes: notes, fixes: fixes})
  }
  out
}

/// b as text, with U+FFFD for each invalid byte (as Go's JSON encoding of
/// a message prints it).
fn lossy_str(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = BytesBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write_rune(r)
    i += n
  }
  out.freeze().to_str() ?? ""
}

/// Looks for xo.mod in dir or its parents and registers it (check.go
/// findModRoot; above the working directory only when it is known).
fn (var c: Checker) find_mod_root(dir: Str) -> ModRoot? {
  var d = c.display(dir)
  while {
    let data = c.read_source(join(d, "xo.mod"))
    if let Some(b) = data {
      var path = ""
      var r = ModRoot{path: "", dir: d}
      for (i, line) in scan_lines(b).indexed() {
        let fs = fields(line)
        if fs.len() == 2 && fs[0] == "module" && path.is_empty() {
          path = fs[1]
        }
        if fs.len() == 2 && fs[0] == "edition" && edition_alias_of(fs[1]) != "" {
          // check edition.go: an old name of an edition (XO1315); an
          // unknown edition fails the Go checker's run
          r.alias = fs[1]
          r.alias_line = i + 1
          r.alias_col = (line.find(fs[1]) ?? 0) + 1
        }
      }
      if path.is_empty() {
        return None
      }
      r.path = path
      var known = false
      for x in c.roots {
        if x.path == r.path && x.dir == r.dir {
          known = true
        }
      }
      if !known {
        c.roots.push(r)
      }
      return Some(r)
    }
    match c.up(d) {
      Some(p) => d = p
      None => return None
    }
  }
  None
}

/// The import path of the module in dir.
fn (var c: Checker) module_path_for(dir: Str) -> Str {
  if let Some(r) = c.find_mod_root(dir) {
    let rel = rel_path(r.dir, c.display(dir))
    if rel == "." {
      return r.path
    }
    return "${r.path}/${rel}"
  }
  clean(dir)
}

fn (var c: Checker) load_dir(dir0: Str) -> Int {
  let dir = c.rel_dir(dir0)
  let path = c.module_path_for(dir)
  if let Some(m) = c.mod_index.get(path) {
    return m
  }
  let (name, _) = local_name(path)
  let m = c.new_module(path, name, dir, false)
  if let Some(r) = c.find_mod_root(dir) {
    c.mods[m].dependency = c.dependency_of(r.dir)
    if !r.alias.is_empty() && c.mods[m].dependency.is_empty() {
      c.edition_aliases[c.rel_dir(join(r.dir, "xo.mod"))] = r
    }
  }
  let entries = c.fs.read_dir(dir).ok() ?? []
  var names: List[Str] = []
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") {
      names.push(e.name)
    }
  }
  for n in names.sort() {
    let p = join(dir, n)
    let src = c.overlay.get(c.abs(p)) ?? (c.fs.read(p).ok() ?? b"")
    c.parse_into(m, p, src, false)
  }
  c.mods[m].state = 1
  c.load_imports(m)
  c.mods[m].state = 2
  c.order.push(m)
  m
}

/// Resolves each file's `use` declarations, loading modules as needed.
fn (var c: Checker) load_imports(m: Int) {
  for f in c.mods[m].files {
    for u in c.files[f].ast.imports {
      if u.path.is_empty() {
        continue
      }
      if u.go {
        c.load_go_import(m, f, u)
        continue
      }
      if u.c {
        c.load_c_import(m, f, u)
        continue
      }
      let upath = u.path.to_str() ?? ""
      let p = clean(upath)
      var imp_name = ""
      if let Some(a) = u.alias {
        imp_name = a.name.to_str() ?? ""
      } else {
        let (name, ok) = local_name(p)
        imp_name = name
        if !ok {
          let d = c.error_at(f, "XO0602", u.span, "import `${p}` needs `as`: `${name}` is not a valid module name")
          if d >= 0 {
            var alt = to_snake(name.bytes())
            let (_, ok2) = local_name(alt)
            if !ok2 || alt.is_empty() {
              alt = "m_${trim_underscores(to_snake(name.bytes()))}"
            }
            c.note(d, "the local name is the last path segment with `-` replaced by `_` (core 4.1)")
            c.fix(d, "add `as ${alt}`", [DEdit{span: JSpan{file: c.files[f].path, line: u.span.end.line, col: u.span.end.col, end_line: u.span.end.line, end_col: u.span.end.col}, replace: " as ${alt}"}])
          }
          imp_name = ""
        }
      }
      var dep = -1
      if p.starts_with("std/") {
        dep = c.load_std(p.trim_prefix("std/"))
      } else if p.starts_with("native/") {
        // the intrinsics of the native backends: only their
        // implementation modules see them (decision 0074), and other
        // intrinsics modules
        dep = -1
        if p.starts_with("native/llrt/") {
          // a runtime module written in Xo (decision 0180):
          // implementation and runtime modules see it
          if c.mods[m].native {
            dep = c.load_runtime_module(p)
          }
        } else if c.mods[m].native || (c.mods[m].is_std && c.mods[m].path.starts_with("native/")) {
          dep = c.load_native_rt(p)
        }
      } else if let Some(x) = c.mod_index.get(p) {
        dep = x
      } else if let Some(r) = c.owner_root(p) {
        let rel = p.trim_prefix(r.path).trim_prefix("/")
        let dir = join(r.dir, rel)
        let st = c.fs.stat(dir).ok() ?? None
        if let Some(info) = st {
          if info.is_dir {
            dep = c.load_dir(dir)
          }
        }
      }
      if dep >= 0 && !c.mods[m].is_std {
        c.check_deny(m, f, u, p)
      }
      if p != upath {
        // XO0158 already explains the path.
        dep = -1
      } else if dep < 0 && c.unrequired(f, u, p) {
        // reported (or explained on the xo.mod line)
      } else if dep < 0 {
        let d = c.error_at(f, "XO0601", u.span, "module `${p}` not found")
        if p.starts_with("std/") {
          var cands: List[Str] = []
          let entries = c.fs.read_dir(c.std_dir).ok() ?? []
          for e in entries {
            if e.name.ends_with(".xo") && e.name != "prelude.xo" {
              cands.push("std/${e.name.trim_suffix(".xo")}")
            }
          }
          let s = nearest(p, cands.sort())
          if !s.is_empty() {
            c.note(d, "did you mean `${s.join("`, `")}`?")
          }
        }
      } else if c.mods[dep].state == 1 {
        c.error_at(f, "XO0604", u.span, "import cycle: `${c.mods[m].path}` imports `${c.mods[dep].path}`, which imports it back")
        dep = -1
      } else if !c.mods[m].is_std {
        c.check_required(m, f, u, p)
      }
      if imp_name.is_empty() {
        continue
      }
      let key = imp_name.bytes()
      if let Some(prev) = c.files[f].imports.get(key) {
        c.error_at(f, "XO0603", u.span, "`${imp_name}` is already imported by `use ${prev.path.to_str() ?? ""}`")
        continue
      }
      // an import that did not resolve was reported (or explained) and
      // counts as used
      c.files[f].imports[key] = Import{module: dep, path: u.path, used: dep < 0, span: u.span}
    }
  }
}

/// strings.Trim(s, "_").
fn trim_underscores(s: Str) -> Str {
  var t = s
  while t.starts_with("_") {
    t = t.trim_prefix("_")
  }
  while t.ends_with("_") {
    t = t.trim_suffix("_")
  }
  t
}

/// The xo.mod whose module path is the longest prefix of path.
fn (c: Checker) owner_root(path: Str) -> ModRoot? {
  var best: ModRoot? = None
  var best_len = -1
  for r in c.roots {
    if (path == r.path || path.starts_with("${r.path}/")) && r.path.len() > best_len {
      best = Some(r)
      best_len = r.path.len()
    }
  }
  best
}

// ---------------------------------------------------------------------------
// Paths

/// A module's local name from its import path (core 4.1): the last
/// segment with `-` replaced by `_`, skipping a /vN suffix of a remote
/// path; false when that is not an identifier or is a keyword.
fn local_name(path0: Str) -> (Str, Bool) {
  var path = path0
  if is_remote(path) {
    path = major_suffix(path)
  }
  let name = base(path).replace("-", "_")
  if name.is_empty() || lexer.lookup(name) != lexer.Kind.Ident {
    return (name, false)
  }
  let b = name.bytes()
  for i in 0..b.len() {
    let ch = b[i]
    if !(ch == '_' || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (i > 0 && ch >= '0' && ch <= '9')) {
      return (name, false)
    }
  }
  (name, true)
}

/// A path whose first segment contains a dot names a remote module.
fn is_remote(path: Str) -> Bool {
  let first = path.split("/")[0]
  first.contains(".")
}

/// Removes a /vN major version suffix (N >= 2).
fn major_suffix(path: Str) -> Str {
  let segs = path.split("/")
  if segs.len() < 2 {
    return path
  }
  let last = segs[segs.len() - 1].bytes()
  if last.len() < 2 || last[0] != 'v' || last[1] == '0' {
    return path
  }
  for i in 1..last.len() {
    if last[i] < '0' || last[i] > '9' {
      return path
    }
  }
  if last.len() == 2 && last[1] == '1' {
    return path
  }
  var out: List[Str] = []
  for i in 0..segs.len() - 1 {
    out.push(segs[i])
  }
  out.join("/")
}

/// The volume of an absolute Windows path with / separators ("C:" of
/// "C:/x", the form paths reach Xo in there, std.md 3.1); "" for every
/// other path, and on every other host.
pub fn path_volume(p: Str) -> Str {
  let windows = match target.os {
    Windows => true
    Darwin | Linux | Wasi => false
  }
  if windows && p.len() >= 3 && p[1..2] == ":" && p[2..3] == "/" {
    return p[0..2]
  }
  ""
}

/// Whether p is absolute: rooted at /, or a Windows drive path (C:/x).
pub fn is_rooted(p: Str) -> Bool {
  p.starts_with("/") || !path_volume(p).is_empty()
}

/// path.Clean for slash separated paths (filepath.Clean with / on
/// Windows: the drive stays, the rest is cleaned as rooted).
fn clean(p: Str) -> Str {
  if p.is_empty() {
    return "."
  }
  let vol = path_volume(p)
  if !vol.is_empty() {
    return vol + clean(p[2..])
  }
  let rooted = p.starts_with("/")
  var out: List[Str] = []
  for s in p.split("/") {
    if s.is_empty() || s == "." {
      continue
    }
    if s == ".." {
      if !out.is_empty() && out[out.len() - 1] != ".." {
        out.pop()
        continue
      }
      if rooted {
        continue
      }
    }
    out.push(s)
  }
  let body = out.join("/")
  if rooted {
    return "/${body}"
  }
  if body.is_empty() {
    return "."
  }
  body
}

fn join(a: Str, b: Str) -> Str {
  if a == "." || a.is_empty() {
    return clean(b)
  }
  clean("${a}/${b}")
}

fn base(p: Str) -> Str {
  let segs = clean(p).split("/")
  segs[segs.len() - 1]
}

fn parent(p: Str) -> Str {
  let c = clean(p)
  if c == "." {
    return ".."
  }
  if c == ".." || c.ends_with("/..") {
    return "${c}/.."
  }
  let segs = c.split("/")
  if segs.len() == 1 {
    return "."
  }
  var out: List[Str] = []
  for i in 0..segs.len() - 1 {
    out.push(segs[i])
  }
  out.join("/")
}

/// The path of target relative to dir, where dir is target or one of its
/// parents.
fn rel_path(dir: Str, target: Str) -> Str {
  let d = clean(dir)
  let t = clean(target)
  if d == t {
    return "."
  }
  if d == "." {
    return t
  }
  t.trim_prefix("${d}/")
}

/// Splits a line on spaces and tabs.
fn split_fields(line: Str) -> List[Str] {
  var out: List[Str] = []
  for w in line.replace("\t", " ").split(" ") {
    if !w.is_empty() {
      out.push(w)
    }
  }
  out
}

/// check edition.go EditionAliases: the edition an old edition name
/// stands for, or "" (decision 0155: `edition 2026` is `preview`).
fn edition_alias_of(s: Str) -> Str {
  if s == "2026" { "preview" } else { "" }
}

/// check edition.go reportEditionAliases: the fixable note XO1315 on
/// every `edition` line of a checked module's xo.mod that uses an old
/// edition name, in file order.
fn (var c: Checker) report_edition_aliases() {
  var files: List[Str] = []
  for (f, _) in c.edition_aliases.entries() {
    files.push(f)
  }
  for f in files.sort() {
    let r = c.edition_aliases.get(f) ?? ModRoot{path: "", dir: ""}
    let ed = edition_alias_of(r.alias)
    let sp = Span{start: parser.Pos{offset: 0, line: r.alias_line, col: r.alias_col}, end: parser.Pos{offset: 0, line: r.alias_line, col: r.alias_col + r.alias.len()}}
    let kw = r.keyword
    let d = c.report(f, "XO1315", sp, "`${kw} ${r.alias}` is the old name of `${kw} ${ed}`")
    if d >= 0 {
      c.diags[d].note_sev = true
      c.diags[d].warning = true
    }
    c.note(d, "before 1.0 the only edition is `${ed}` (decision 0155); the alias keeps building during the 0.x releases")
    c.fix(d, "rewrite `${kw} ${r.alias}` to `${kw} ${ed}`", [DEdit{span: JSpan{file: f, line: sp.start.line, col: sp.start.col, end_line: sp.end.line, end_col: sp.end.col}, replace: ed}])
  }
}
