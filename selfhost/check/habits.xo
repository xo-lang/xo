// Habits of other languages that do not resolve (internal/check/habits.go,
// decision 0087), as far as the names and types stages need them: the
// diagnostic (XO0601) and the type the Go checker continues with, so
// what follows cascades the same way. Notes and fixes are stage 7.

use github.com/xo-lang/xo/selfhost/parser

/// The words of an identifier in any convention, lower case.
fn words(s: Bytes) -> List[Str] {
  var out: List[Str] = []
  var cur: List[Bytes] = []
  for i in 0..s.len() {
    let r = s[i]
    if r == '_' || r == '-' {
      if !cur.is_empty() {
        out.push(join_bytes(cur).to_lower())
        cur = []
      }
      continue
    }
    if r >= 'A' && r <= 'Z' {
      let prev_lower = i > 0 && ((s[i - 1] >= 'a' && s[i - 1] <= 'z') || (s[i - 1] >= '0' && s[i - 1] <= '9'))
      let next_lower = i + 1 < s.len() && s[i + 1] >= 'a' && s[i + 1] <= 'z'
      let prev_upper = i > 0 && s[i - 1] >= 'A' && s[i - 1] <= 'Z'
      if prev_lower || (prev_upper && next_lower) {
        if !cur.is_empty() {
          out.push(join_bytes(cur).to_lower())
          cur = []
        }
      }
    }
    cur.push(s[i..i + 1])
  }
  if !cur.is_empty() {
    out.push(join_bytes(cur).to_lower())
  }
  out
}

fn join_bytes(bs: List[Bytes]) -> Str {
  var b = StrBuilder.new()
  for x in bs {
    b.write(text(x))
  }
  b.freeze()
}

fn to_snake(s: Bytes) -> Str {
  words(s).join("_")
}

/// The source of sp in the current file.
fn (c: Checker) src_of(sp: Span) -> Str {
  let src = c.files[c.cur_file].src
  if sp.start.offset < 0 || sp.end.offset > src.len() || sp.start.offset > sp.end.offset {
    return ""
  }
  text(src[sp.start.offset..sp.end.offset])
}

/// T of List[T], or -1.
fn (c: Checker) list_elem(t: Int) -> Int {
  let r = c.resolve(t)
  if c.is_prelude(r, "List") {
    return c.tys[r].args[0]
  }
  -1
}

fn print_name(name: Str) -> Bool {
  name is "println" | "print" | "printf" | "puts" | "echo" | "fmt.Println" | "fmt.Print" | "fmt.Printf" | "fmt.Sprintf" | "console.log" | "console.error" | "System.out.println" | "eprintln"
}

/// A call of an unresolved function name (habits.go habitCall). Each
/// habit is a function of its own: one function of all of them has a
/// frame over the arm64 backend's 28 KiB limit (gotcha
/// arm64-large-frame).
fn (var c: Checker) habit_call(call: Expr, id: Ident, hint: Int) -> (Int, Bool) {
  let (span, _, args) = call_parts(call)
  let name = text(id.name)
  if print_name(name) {
    return (c.habit_print(args, name, id.span), true)
  }
  let n = args.len()
  match name {
    "len" | "count" | "size" => {
      if n != 1 {
        return (-1, false)
      }
      return (c.habit_infer_one(args, id, c.named("Int")), true)
    }
    "append" => {
      if n < 2 {
        return (-1, false)
      }
      return (c.habit_append(args, id, hint), true)
    }
    "range" => {
      if n < 1 || n > 2 {
        return (-1, false)
      }
      return (c.habit_range(span, args, id, hint), true)
    }
    "str" | "String" | "toString" => {
      if n != 1 {
        return (-1, false)
      }
      return (c.habit_infer_one(args, id, c.named("Str")), true)
    }
    "int" | "float" => {
      if n != 1 {
        return (-1, false)
      }
      return (c.habit_infer_one(args, id, c.named(if name == "int" { "Int" } else { "Float" })), true)
    }
    "sorted" | "reversed" | "abs" => {
      if n != 1 {
        return (-1, false)
      }
      c.error("XO0601", id.span, "function `${name}` not found")
      return (c.infer(args[0].value, hint), true)
    }
    "min" | "max" => {
      if n != 2 {
        return (-1, false)
      }
      return (c.habit_min_max(args, id, hint), true)
    }
    "panic" => {
      if n != 1 {
        return (-1, false)
      }
      return (c.habit_infer_one(args, id, c.named("Never")), true)
    }
    "delete" => {
      if n != 2 {
        return (-1, false)
      }
      return (c.habit_infer_all(args, id, c.unit_ty), true)
    }
    "map" | "filter" => {
      if n != 2 {
        return (-1, false)
      }
      return (c.habit_map(span, args, id, hint), true)
    }
    "list" | "set" | "enumerate" => {
      if n != 1 {
        return (-1, false)
      }
      return (c.habit_list(span, args, id, hint), true)
    }
    "sum" => {
      if n != 1 {
        return (-1, false)
      }
      return (c.habit_sum(args, id), true)
    }
    "make" | "new" => {
      c.error("XO0601", id.span, "function `${name}` not found")
      return (c.bad_ty, true)
    }
    "assert" => return (c.habit_infer_all(args, id, c.unit_ty), true)
    "typeof" | "type" | "isinstance" => return (c.habit_infer_all(args, id, c.bad_ty), true)
    _ => {}
  }
  (-1, false)
}

/// XO0601 for the call's name, its one argument inferred; t.
fn (var c: Checker) habit_infer_one(args: List[Arg], id: Ident, t: Int) -> Int {
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  c.infer(args[0].value, -1)
  t
}

/// XO0601 for the call's name, its arguments inferred; t.
fn (var c: Checker) habit_infer_all(args: List[Arg], id: Ident, t: Int) -> Int {
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  c.infer_args(args)
  t
}

/// Go's `append(xs, v...)`: the list's type.
fn (var c: Checker) habit_append(args: List[Arg], id: Ident, hint: Int) -> Int {
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  let t = c.infer(args[0].value, hint)
  for i in 1..args.len() {
    c.infer(args[i].value, c.list_elem(t))
  }
  t
}

/// Python's `range(n)` and `range(a, b)`: the range `0..n` or `a..b`.
fn (var c: Checker) habit_range(span: Span, args: List[Arg], id: Ident, hint: Int) -> Int {
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  var lo = Expr.IntLit(span: span, raw: b"0", value: b"0")
  var hi = args[0].value
  if args.len() == 2 {
    lo = args[0].value
    hi = args[1].value
  }
  c.infer(Expr.RangeExpr(span: span, lo: Some(lo), hi: Some(hi), inclusive: false), hint)
}

/// `min(a, b)` and `max(a, b)`: a's type.
fn (var c: Checker) habit_min_max(args: List[Arg], id: Ident, hint: Int) -> Int {
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  let t = c.infer(args[0].value, hint)
  c.check_ty(args[1].value, t)
  t
}

/// Python's `map(f, xs)` and `filter(f, xs)`: the method call
/// `xs.map(f)` (a range becomes a list first).
fn (var c: Checker) habit_map(span: Span, args: List[Arg], id: Ident, hint: Int) -> Int {
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  var on = args[1].value
  if c.is_prelude(c.infer(args[1].value, -1), "Range") {
    on = Expr.CallExpr(span: args[1].span, fun: Expr.SelectorExpr(span: id.span, x: args[1].value, sel: Ident{span: id.span, name: b"to_list"}), args: [])
  }
  let m = Expr.CallExpr(span: span, fun: Expr.SelectorExpr(span: id.span, x: on, sel: Ident{span: id.span, name: id.name}), args: [args[0]])
  c.infer(m, hint)
}

/// Python's `list(x)`, `set(x)`, `enumerate(x)`: the method call
/// `x.to_list()`, `x.to_set()`, `x.indexed()`.
fn (var c: Checker) habit_list(span: Span, args: List[Arg], id: Ident, hint: Int) -> Int {
  let name = text(id.name)
  let t = c.infer(args[0].value, -1)
  let r = c.resolve(t)
  var kind = ""
  if c.tys[r].kind == TyKind.Named && c.objs[c.tys[r].obj].module == c.prelude {
    kind = text(c.objs[c.tys[r].obj].name)
  }
  let m = match name {
    "list" => "to_list"
    "set" => "to_set"
    _ => "indexed"
  }
  c.error("XO0601", id.span, "function `${name}` not found")
  if name == "list" && kind == "List" {
    return t
  }
  if kind.is_empty() {
    return c.bad_ty
  }
  let msel = Ident{span: id.span, name: m.bytes()}
  let mcall = Expr.CallExpr(span: span, fun: Expr.SelectorExpr(span: id.span, x: args[0].value, sel: msel), args: [])
  c.call_method(t, id.span, args[0].value, msel, [], false, mcall, hint)
}

/// Python's `sum(xs)`: the list's element type.
fn (var c: Checker) habit_sum(args: List[Arg], id: Ident) -> Int {
  let t = c.infer(args[0].value, -1)
  c.error("XO0601", id.span, "function `${text(id.name)}` not found")
  let e = c.list_elem(t)
  if e >= 0 {
    return e
  }
  c.bad_ty
}

/// A print function of another language (habits.go habitPrint): XO0601
/// on the name (on the module part of `fmt.Println`), the arguments
/// inferred, `()`.
fn (var c: Checker) habit_print(args: List[Arg], name: Str, at0: Span) -> Int {
  var at = at0
  var what = "function `${name}` not found"
  let b = name.bytes()
  for i in 0..b.len() {
    if b[i] == '.' {
      what = "name `${text(b[0..i])}` not found"
      at = Span{start: at0.start, end: parser.Pos{offset: at0.start.offset + i, line: at0.start.line, col: at0.start.col + i}}
      break
    }
  }
  c.error("XO0601", at, what)
  for a in args {
    c.infer(a.value, -1)
  }
  c.unit_ty
}

/// `fmt.Println(...)`, `Math.max(a, b)` and the like when the module
/// name does not resolve (habits.go habitModuleCall).
fn (var c: Checker) habit_module_call(call: Expr, md: Ident, sel: Ident) -> (Int, Bool) {
  let (_, fun, args) = call_parts(call)
  let mname = text(md.name)
  if !(mname is "fmt" | "console" | "System" | "Math" | "String" | "math" | "strings" | "strconv" | "errors" | "time") {
    return (-1, false)
  }
  var full = "${mname}.${text(sel.name)}"
  if full == "String.from" || full == "String.new" {
    c.error("XO0601", md.span, "name `${mname}` not found")
    if full == "String.new" && args.is_empty() {
      return (c.named("Str"), true)
    }
    if args.len() == 1 {
      c.infer(args[0].value, -1)
      return (c.named("Str"), true)
    }
    c.infer_args(args)
    return (c.named("Str"), true)
  }
  if mname == "String" {
    return (-1, false)
  }
  if mname == "System" {
    full = c.src_of(parser.expr_span(fun))
  }
  if print_name(full) {
    return (c.habit_print(args, full, parser.expr_span(fun)), true)
  }
  c.error("XO0601", md.span, "name `${mname}` not found")
  c.infer_args(args)
  (c.bad_ty, true)
}

/// The Xo method another language's method name stands for, or "".
fn method_habit(name: Str) -> Str {
  match name {
    "length" | "size" | "count" => "len"
    "append" | "add" | "push_back" => "push"
    "includes" | "contains_key" | "containsKey" | "has_key" | "has" => "contains"
    "toUpperCase" | "upper" | "uppercase" | "to_uppercase" => "to_upper"
    "toLowerCase" | "lower" | "lowercase" | "to_lowercase" => "to_lower"
    "strip" => "trim"
    "lstrip" | "trimStart" => "trim_start"
    "rstrip" | "trimEnd" => "trim_end"
    "startswith" | "hasPrefix" => "starts_with"
    "endswith" | "hasSuffix" => "ends_with"
    "items" => "entries"
    "sorted" => "sort"
    "reversed" => "reverse"
    "replaceAll" => "replace"
    "set" => "put"
    "firstOrNull" => "first"
    "lastOrNull" => "last"
    "isEmpty" => "is_empty"
    _ => ""
  }
}

/// A method call that does not resolve on a value of type r (habits.go
/// habitMethod).
fn (var c: Checker) habit_method(bt: Int, r: Int, sspan: Span, x: Expr, sel: Ident, call: Expr, hint: Int) -> (Int, Bool) {
  let (span, _, args) = call_parts(call)
  let name = text(sel.name)
  let report = "`${c.show(bt)}` has no field or method `${name}`"
  if (name is "clone" | "to_owned" | "as_str" | "iter" | "into_iter" | "borrow" | "as_ref" | "collect" | "copy" | "toList") && args.is_empty() {
    c.error("XO0601", sel.span, report)
    return (bt, true)
  }
  let opt = c.option_elem(r)
  let res = c.is_result(r)
  match name {
    "unwrap" | "get" | "orElseThrow" => {
      if !(name == "get" && opt < 0) && (opt >= 0 || res) {
        c.error("XO0601", sel.span, report)
        if opt >= 0 {
          return (opt, true)
        }
        return (c.result_t(r), true)
      }
    }
    "expect" => {
      if args.len() == 1 && (opt >= 0 || res) {
        let elem = if opt >= 0 { opt } else { c.result_t(r) }
        c.error("XO0601", sel.span, report)
        c.check_ty(args[0].value, c.named("Str"))
        return (elem, true)
      }
    }
    "or_err" => {
      if res && args.len() == 1 && args[0].name == None {
        c.error("XO0601", sel.span, report)
        let t = c.result_t(r)
        return (c.result_of(t, c.infer(args[0].value, -1)), true)
      }
    }
    "to_string" | "toString" | "ToString" | "description" => {
      if args.is_empty() {
        c.error("XO0601", sel.span, report)
        return (c.named("Str"), true)
      }
    }
    "join" => {
      if c.is_prelude(r, "Str") && args.len() == 1 {
        c.error("XO0601", sel.span, report)
        c.infer(args[0].value, -1)
        return (c.named("Str"), true)
      }
    }
    "push_str" | "forEach" | "for_each" => {
      c.error("XO0601", sel.span, report)
      c.infer_args(args)
      return (c.unit_ty, true)
    }
    "substring" | "substr" | "slice" => {
      if c.is_prelude(r, "Str") || c.list_elem(r) >= 0 {
        c.error("XO0601", sel.span, report)
        c.infer_args(args)
        return (bt, true)
      }
    }
    _ => {}
  }
  var xo = method_habit(name)
  if xo.is_empty() {
    let snake = to_snake(sel.name)
    if snake != name {
      xo = snake
    }
  }
  if xo.is_empty() {
    return (-1, false)
  }
  let (m, _) = c.find_method_any(r, xo)
  if m < 0 {
    return (-1, false)
  }
  if (name is "count" | "size" | "length") && !args.is_empty() {
    return (-1, false)
  }
  c.error("XO0601", sel.span, report)
  let nsel = Ident{span: sel.span, name: xo.bytes()}
  let ncall = Expr.CallExpr(span: span, fun: Expr.SelectorExpr(span: sspan, x: x, sel: nsel), args: args)
  (c.call_method(bt, sspan, x, nsel, [], false, ncall, hint), true)
}

/// The Xo type another language's type name stands for: `*` for a box
/// (the type argument), `!` for none, `()`, "" for tuple and optional
/// spellings, else the Xo name; `-` when the name is not a habit.
fn type_habit(name: Str) -> Str {
  match name {
    "String" | "string" | "str" => "Str"
    "int" | "i64" | "int64" | "Integer" | "Long" | "isize" | "usize" => "Int"
    "number" | "Number" | "f64" | "float64" | "float" | "double" | "Double" => "Float"
    "i32" | "int32" => "Int32"
    "i16" | "int16" => "Int16"
    "i8" | "int8" => "Int8"
    "u8" | "uint8" | "byte" | "Byte" => "UInt8"
    "u16" | "uint16" => "UInt16"
    "u32" | "uint32" => "UInt32"
    "u64" | "uint64" | "uint" => "UInt64"
    "f32" | "float32" => "Float32"
    "bool" | "boolean" | "Boolean" => "Bool"
    "char" | "rune" | "Character" | "Char" => "Rune"
    "Vec" | "Array" | "ArrayList" | "MutableList" | "list" => "List"
    "HashMap" | "BTreeMap" | "Dictionary" | "dict" | "MutableMap" | "Record" => "Map"
    "HashSet" | "BTreeSet" | "MutableSet" | "set" | "frozenset" => "Set"
    "tuple" | "Optional" | "Maybe" => ""
    "error" | "Exception" | "Throwable" => "Error"
    "void" | "Void" | "Unit" | "NoneType" => "()"
    "Box" | "Rc" | "Arc" => "*"
    "RefCell" | "any" | "Any" | "object" | "Object" | "unknown" | "Self" => "!"
    "Hashable" => "Hash"
    "Comparable" => "Ord"
    "Equatable" => "Eq"
    "Codable" | "Serialize" => "Json"
    _ => "-"
  }
}

/// An unresolved type name of another language (habits.go habitType).
fn (var c: Checker) habit_type(span: Span, path: List[Ident], args: List[Type], var env: TypeEnv) -> (Int, Bool) {
  let id = path[0]
  let name = text(id.name)
  let xo = type_habit(name)
  if xo == "-" {
    return (-1, false)
  }
  if !env.quiet {
    c.error("XO0601", id.span, "type `${name}` not found")
  }
  if xo == "*" {
    if args.len() == 1 {
      return (c.resolve_type(args[0], env), true)
    }
    return (c.bad_ty, true)
  }
  if xo == "!" {
    return (c.bad_ty, true)
  }
  if xo.is_empty() {
    if name == "tuple" {
      if !args.is_empty() {
        var el: List[Int] = []
        for a in args {
          el.push(c.resolve_type(a, env))
        }
        return (c.new_ty(Ty{kind: TyKind.Tuple, args: el}), true)
      }
    } else if args.len() == 1 {
      return (c.option_of(c.resolve_type(args[0], env)), true)
    }
    return (c.bad_ty, true)
  }
  if xo == "()" {
    return (c.unit_ty, true)
  }
  (c.resolve_named_type(span, [Ident{span: id.span, name: xo.bytes()}], args, env), true)
}
