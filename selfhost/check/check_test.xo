// Tests of the self hosted checker. The comparison with the Go checker is
// internal/selfhost's TestSelfhostChecker (decision 0141).

/// A small prelude for checks in the test's in memory file system.
const PRELUDE = """
  struct Int {}
  struct Str {}
  struct List[T] {}
  enum Option[T] {
    None
    Some(v: T)
  }
  struct Os {}
  fn print(s: Str)
  struct Bool {}
  struct Float {}
  enum Never {}
  enum Result[T, E] {
    Ok(v: T)
    Err(e: E)
  }
  interface Display {
    fn display(self) -> Str
  }
  interface Error {
    fn display(self) -> Str
  }
  fn (xs: List[T]) len() -> Int
  """

/// Checks the module in dir after writing files (path, source) and the
/// small prelude, and returns the names, types, and diags dump.
fn check_files(os: testing.TestOs, dir: Str, files: List[(Str, Str)]) -> Str ! FsErr {
  os.fs.create_dir_all("std")?
  os.fs.write("std/prelude.xo", PRELUDE.bytes())?
  os.fs.write("std/testing.xo", b"")?
  os.fs.create_dir_all(dir)?
  for (p, src) in files {
    os.fs.write(p, src.bytes())?
  }
  var c = new_checker(os.fs, "std")
  if let Err(e) = c.check_dirs([dir]) {
    return Ok("error ${e}")
  }
  if !c.unsupported.is_empty() {
    return Ok("unsupported ${c.unsupported}")
  }
  Ok(c.dump(true, true, false, true, false))
}

/// The lines of a dump after its module header, without the file headers.
fn lines(dump: Str) -> List[Str] {
  dump.split("\n").filter(fn(l) { !l.is_empty() && !l.starts_with("==") && !l.starts_with("--") })
}

test "paths clean, join, and relate like Go's path package" {
  expect(clean("a/./b/../c/")) == "a/c"
  expect(clean("")) == "."
  expect(clean("../x/..")) == ".."
  expect(join(".", "a/b")) == "a/b"
  expect(join("a", "../b")) == "b"
  expect(parent("a/b")) == "a"
  expect(parent("a")) == "."
  expect(parent(".")) == ".."
  expect(rel_path("a", "a/b/c")) == "b/c"
  expect(rel_path("a/b", "a/b")) == "."
  expect(base("x/y/z")) == "z"
}

test "an import's local name is its last segment" {
  expect(local_name("std/http")) == ("http", true)
  expect(local_name("example.com/rate-limit")) == ("rate_limit", true)
  expect(local_name("github.com/acme/billing/v2")) == ("billing", true)
  expect(local_name("example.com/app/v1")) == ("v1", true)
  expect(local_name("example.com/match")) == ("match", false)
  expect(local_name("example.com/2fa")) == ("2fa", false)
}

test "JSON strings are escaped as encoding/json does without HTML escaping" {
  expect(json_str("a \"b\" \\ <c>")) == "\"a \\\"b\\\" \\\\ <c>\""
  expect(json_str("tab\there\n")) == "\"tab\\there\\n\""
  expect(json_str("\x01")) == "\"\\u0001\""
}

test "locals, parameters, functions, and types resolve" {
  let out = check_files(os, "m", [("m/main.xo", """
    fn twice(x: Int) -> Int {
      let y = x
      add(y, y)
    }

    fn add(a: Int, b: Int) -> Int {
      a
    }
    """)])?
  let ls = lines(out)
  expect(ls.contains("1:13 Int type std/prelude Int std/prelude.xo:1:8")) == true
  expect(ls.contains("2:11 x local param m/main.xo:1:10")) == true
  expect(ls.contains("3:3 add fn m add m/main.xo:6:4")) == true
  expect(ls.contains("3:7 y local let m/main.xo:2:7")) == true
  expect(ls.contains("7:3 a local param m/main.xo:6:8")) == true
}

test "shadowing in a nested block is allowed, in the same block it is XO0603" {
  let out = check_files(os, "s", [("s/main.xo", """
    fn f(x: Int) -> Int {
      let y = x
      {
        let y = 1
        print(y)
      }
      let y = 2
      y
    }
    """)])?
  let ls = lines(out)
  expect(ls.contains("5:11 y local let s/main.xo:4:9")) == true
  expect(ls.contains("8:3 y local let s/main.xo:7:7")) == true
  expect(ls.any(fn(l) { l.contains("\"XO0603\"") && l.contains("\"line\":7") })) == true
}

test "undefined names are XO0601, UpperCamel ones too when no enum is expected" {
  let out = check_files(os, "u", [("u/main.xo", """
    fn f() -> Int {
      missing(Red, other)
    }
    """)])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("function `missing` not found") })) == true
  expect(ls.any(fn(l) { l.contains("name `other` not found") })) == true
  expect(ls.any(fn(l) { l.contains("name `Red` not found") })) == true
}

test "expressions get their types after implicit conversion" {
  let out = check_files(os, "t", [("t/main.xo", """
    fn f(x: Int) -> Int? {
      let y: Int? = x
      let z = [x, 2]
      if z.len() == 0 { None } else { y }
    }
    """)])?
  let ls = lines(out)
  expect(ls.contains("2:17-2:18 Ident Int?")) == true
  expect(ls.contains("3:11-3:17 ListLit List[Int]")) == true
  expect(ls.contains("3:15-3:16 IntLit Int")) == true
  expect(ls.contains("4:6-4:13 CallExpr Int")) == true
  expect(ls.contains("4:21-4:25 Ident Int?")) == true
  expect(ls.contains("4:8 len fn std/prelude List.len std/prelude.xo:23:18")) == true
  expect(ls.contains("4:21 None variant std/prelude Option.None std/prelude.xo:5:3")) == true
}

test "a value of the wrong type is XO0401" {
  let out = check_files(os, "w", [("w/main.xo", """
    fn f(x: Int) -> Str {
      x
    }
    """)])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("\"XO0401\"") && l.contains("expected `Str`, found `Int`") })) == true
}

test "a file with a parse error is checked past it, as the Go checker does" {
  let out = check_files(os, "p", [("p/main.xo", "fn f() {\n  let = 1\n}\n\nfn g() -> Int {\n  \"s\"\n}\n")])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("\"XO0165\"") && l.contains("expected a pattern, found `=`") })) == true
  expect(ls.any(fn(l) { l.contains("\"XO0401\"") && l.contains("expected `Int`, found `Str`") })) == true
}

test "time layouts parse as the runtime does" {
  expect(time_layout_parse("{year}-{month}-{day}")) == ""
  expect(time_layout_parse("{hour12}:{minute}")) == "{hour12} needs {ampm} (or use {hour}, 00 to 23)"
  expect(time_layout_parse("{yera}")) == "unknown field {yera}"
  expect(time_layout_parse("{month:long}")) == "{month:long}: the forms are {month}, {month:1}, {month:short}, {month:name}"
  expect(time_layout_parse("a}")) == "unmatched } (a literal brace is written {rbrace})"
  expect(time_layout_parse("{year")) == "unclosed { (a literal brace is written {lbrace})"
  expect(xo_quote("a\"$\n")) == "\"a\\\"\\$\\n\""
}

test "a name against its convention is XO0101" {
  let out = check_files(os, "n", [("n/main.xo", """
    fn GetName(userId: Int) -> Int {
      let maxCount = userId
      maxCount
    }
    """)])?
  let ls = lines(out)
  expect(ls.any(fn(l) { l.contains("function name `GetName` must be snake_case") })) == true
  expect(ls.any(fn(l) { l.contains("parameter name `userId` must be snake_case") })) == true
  expect(ls.any(fn(l) { l.contains("variable name `maxCount` must be snake_case") })) == true
}

test "versions, module paths, ceilings, and deny rules read as internal/mod reads them" {
  expect(compare_versions("v1.2.0", "v1.10.0")) == -1
  expect(compare_versions("v1.0.0-rc.1", "v1.0.0")) == -1
  expect(compare_versions("v1.0.0-rc.2", "v1.0.0-rc.10")) == -1
  expect(compare_versions("v1.0.0-alpha", "v1.0.0-1")) == 1
  expect(valid_version("v01.0.0")) == false
  expect(valid_version("v1.0")) == false
  expect(major_mismatch("example.com/a", "v2.0.0")) == "example.com/a v2.0.0: major version 2 needs the module path example.com/a/v2"
  expect(major_mismatch("example.com/a/v3", "v2.0.0")) == "example.com/a/v3 v2.0.0: a module path ending in /v3 takes only v3.x.y versions"
  expect(valid_path("example.com/a/b")) == true
  expect(valid_path("example/a")) == false
  expect(escape_path("example.com/Acme/X")) == "example.com/!acme/!x"
  let cl = parse_ceiling(["uses", "(clock,", "fs.read)"]).ok() ?? Ceiling{}
  expect(ceiling_text(cl)) == "uses clock, fs.read"
  expect(ceiling_admits(cl, "fs.read")) == true
  expect(ceiling_admits(Ceiling{effects: ["fs"]}, "fs.write")) == true
  expect(ceiling_admits(cl, "fs.write")) == false
  let d = parse_deny("xo.mod", 3, " a.com/x -> a.com/y/..., std/time").ok() ?? Deny{from: "", line: 0}
  expect(deny_matches(d, "a.com/x", "a.com/y/z")) == "a.com/y/..."
  expect(deny_matches(d, "a.com/x", "std/json")) == ""
  expect(fields(" a\tb  c ")) == ["a", "b", "c"]
  expect(scan_lines(b"a\r\nb\n")) == ["a", "b"]
}

test "Go bindings, vouches, and effect locks read as internal/gobind and internal/mod read them" {
  let h = go_binding_header(b"// Code generated by xo bind from Go package strconv. DO NOT EDIT.\n// xo-bind: v5 go1.26.1\n// go-package: strconv\n// go-standard: true\n// skip: format_complex: parameter c: Go type complex128 has no Xo counterpart (strconv.FormatComplex)\n// skip: odd\n\nuse std/go\n// skip: late: not a header line (x.Y)\n")
  expect(h.version) == 5
  expect(h.name) == "strconv"
  expect(h.standard) == true
  expect(h.skipped.get("format_complex") ?? "") == "parameter c: Go type complex128 has no Xo counterpart"
  expect(h.skipped.contains("odd")) == true
  expect(h.skipped.contains("late")) == false
  expect(go_rerun_key(["b", "a", "Type.m"])) == "Type.m a b"
  expect(go_pin_for({"example.com/a": "v1.0.0", "example.com/a/b": "v2.0.0"}, "example.com/a/b/c")) == "v2.0.0"
  expect(go_pin_for({"example.com/a": "v1.0.0"}, "example.com/ab")) == ""
  expect(go_pure_package("net/url")) == true
  expect(go_pure_package("os/exec")) == false
  expect(go_unquote("\"zlib.h\"") ?? "") == "zlib.h"
  expect(go_unquote("\"a\\\"b\"") ?? "") == "a\"b"
  expect(go_unquote("`raw`") ?? "") == "raw"
  expect(go_unquote("zlib.h") == None) == true
  expect(parse_vouch("xo.mod", 4, ["vouch", "example.com/z", "v1.2.0", "c", "\"zlib.h\"", "uses", "none"]).is_ok()) == true
  let bad = match parse_vouch("xo.mod", 5, ["vouch", "example.com/z", "v1.2.0", "go", "\"os\"", "uses", "net"]) {
    Ok(_) => ""
    Err(p) => p.msg
  }
  expect(bad) == "malformed vouch: a go vouch takes no `uses`: calls into Go always perform `go`"
  expect(suggest_vouch("example.com/z", "v1.2.0", "c", "zlib.h", Some([]))) == "vouch example.com/z v1.2.0 c \"zlib.h\" uses none"
  expect(parse_effects_text("net,clock") ?? []) == ["clock", "net"]
  expect(parse_effects_text("none") ?? ["x"]) == []
  expect(parse_effects_text("net,bogus") == None) == true
  expect(effects_text([])) == "none"
  expect(edition_alias_of("2026")) == "preview"
  expect(edition_alias_of("preview")) == ""
  expect(last_index("a (b) (c)", " (")) == 5
}

test "real_path follows the links of every element, as getcwd reports" {
  os.fs.create_dir_all("/private/var/folders/t").or_fault("mkdir")
  os.fs.symlink("/private/var", "/var").or_fault("var")
  os.fs.symlink("t", "/private/var/folders/u").or_fault("u")
  expect(real_path(os.fs, "/var/folders/t")) == "/private/var/folders/t"
  expect(real_path(os.fs, "/var/folders/u/./x/..")) == "/private/var/folders/t"
  expect(real_path(os.fs, "/private/var/folders")) == "/private/var/folders"
  expect(real_path(os.fs, "rel/../a")) == "a"
  expect(real_path(os.fs, "/")) == "/"
}

test "C ABI export names that two export modules define are paired, XO0608's check" {
  expect(export_clashes(["a", "b", "c"]).len()) == 0
  let got = export_clashes(["a", "poll_wait", "b", "poll_wait", "a"])
  expect(got.len()) == 2
  expect(got[0].0) == 1
  expect(got[0].1) == 3
  expect(got[1].0) == 0
  expect(got[1].1) == 4
  expect(xo_x_export_module("native/llrt/cabi")) == true
  expect(xo_x_export_module("native/llrt/cabi_poll")) == true
  expect(xo_x_export_module("native/llrt/cabi_libc")) == false
  expect(xo_x_export_module("native/llrt/poll")) == false
}
