// The checker's tables: objects, modules, files, and what it records
// (decision 0141). The data is graph shaped (a scope maps names to
// objects, an object belongs to a module, a module has files that import
// other modules), and Xo values have no identity, so every node lives in
// a table of the Checker and refers to others by index: an object is an
// Int into `objs`, a module an Int into `mods`, a file an Int into
// `files`, a type an Int into `tys` (types.xo). -1 stands for "none".

use github.com/xo-lang/xo/selfhost/parser

pub type Span = parser.Span
pub type Ident = parser.Ident

/// What an object is.
pub enum ObjKind {
  /// A function: top level, method, static, or interface method.
  Func
  /// A top level constant.
  Const
  /// A declared type: struct, enum, interface, alias, or newtype.
  Type
  /// A type parameter, declared or implicit.
  TParam
  /// A local binding: let, var, parameter, receiver, or predeclared.
  Local
  /// A module, the target of an import.
  Module
}

/// A struct field.
pub struct FieldInfo {
  pub name: Bytes
  pub ty: Int
  pub is_pub: Bool
  /// The default value: zero or one element.
  pub default: List[parser.Expr] = []
  pub line: Int
  pub col: Int
}

/// A field of an enum variant; a `from` field has no name.
pub struct VFieldInfo {
  pub name: Bytes
  pub from: Bool
  pub ty: Int
  pub line: Int = 0
  pub col: Int = 0
}

/// An enum variant.
pub struct VariantInfo {
  pub name: Bytes
  pub index: Int
  pub fields: List[VFieldInfo] = []
  /// Declared without parentheses.
  pub unit: Bool
  pub line: Int
  pub col: Int
}

/// A declared parameter of a function.
pub struct ParamInfo {
  pub name: Bytes
  pub ty: Int
  pub is_var: Bool
  /// The default value: zero or one element.
  pub default: List[parser.Expr] = []
  pub line: Int = 0
  pub col: Int = 0
}

/// A named entity. Positions are those of the declaring name.
pub struct Obj {
  pub kind: ObjKind
  pub name: Bytes
  /// The declaring module (Func, Const, Type), or the module a Module
  /// object stands for; -1 otherwise.
  pub module: Int = -1
  /// The declaring file, "" when there is none (the `os` of a test).
  pub file: Str = ""
  pub line: Int = 0
  pub col: Int = 0
  /// Local: let, var, param, var-param, recv, var-recv, or predeclared.
  pub local: Str = ""
  /// TParam: an effect variable (`fx: Effects`).
  pub effect: Bool = false
  /// Type, Func: type parameters (TParam objects); a function's implicit
  /// receiver parameters come first.
  pub tparams: List[Int] = []
  /// Func, Const, Type: declared `pub` (everything in std is).
  pub is_pub: Bool = false
  /// Type: struct, enum, interface, alias, or newtype.
  pub tkind: Str = ""

  // Types (decl.xo resolve_type_obj).
  pub fields: List[FieldInfo] = []
  pub variants: List[VariantInfo] = []
  /// Interface methods (Func objects).
  pub iface_meths: List[Int] = []
  /// Alias target or newtype underlying type.
  pub target: Int = -1
  pub derives: List[Str] = []
  /// An empty std struct: an opaque handle.
  pub opaque: Bool = false
  /// Methods and statics (Func objects) by name.
  pub methods: Map[Bytes, Int] = {}
  pub statics: Map[Bytes, Int] = {}
  pub resolving: Bool = false
  pub resolved: Bool = false
  /// The declaration: file and index in its declarations (Type, Func,
  /// Const), -1 for none.
  pub decl_file: Int = -1
  pub decl_idx: Int = -1

  // Functions (decl.xo resolve_sig).
  /// The declaration (zero or one element).
  pub fn_decl: List[parser.FnDecl] = []
  pub params: List[ParamInfo] = []
  pub result: Int = -1
  /// The error type, -1 when it cannot fail.
  pub err: Int = -1
  /// Methods: the receiver's Type object and receiver type.
  pub recv: Int = -1
  pub recv_ty: Int = -1
  pub recv_var: Bool = false
  /// A std function whose receiver is named `static`.
  pub is_static: Bool = false
  /// A static constant: `Time.UNIX_EPOCH`.
  pub static_const: Bool = false
  pub iface: Bool = false
  /// The number of type parameters the declaration writes.
  pub own_tparams: Int = 0
  /// The declared effects (an effect set), -1 when they are inferred
  /// (a function that is not pub and has no `uses`).
  pub declared: Int = -1
  pub sig_done: Bool = false
  /// The effects its body performs (an effect set), -1 until checked.
  pub body_eff: Int = -1
  /// A function whose doc comment says `@moves`: its receiver is moved
  /// by the call (core 5.3).
  pub moves: Bool = false
  /// Declared `uses realtime` (core 6.5), and where.
  pub realtime: Bool = false
  pub realtime_span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}

  // Constants and locals.
  /// Const, Local: the type, -1 until known.
  pub ty: Int = -1
  pub done: Bool = false
  pub checking: Bool = false
  /// Local: a `var` binding, parameter, or receiver.
  pub mutable: Bool = false
  /// Local: a block `const`.
  pub is_const: Bool = false
  /// Local: the value of a block `const` (zero or one element).
  pub const_val: List[parser.Expr] = []
  /// Local: the context (Ctx) it was declared in.
  pub vctx: Int = -1
  /// Local: the frame of the scope it names (`scope s`), or of the scope
  /// whose group it holds; -1 for none.
  pub frame: Int = -1
  pub group_frame: Int = -1
  /// Local: a task handle awaited somewhere.
  pub awaited: Bool = false
  /// Local: read somewhere (stmt.go VarObj.Used): a `let` or `var`
  /// binding never read is XO0110.
  pub used: Bool = false

  // Type parameters.
  pub constraint: Int = -1
  pub implicit: Bool = false
  /// An implicit effect parameter for an effect argument left out (core
  /// 6.2): the function may perform it.
  pub elided: Bool = false
}

/// A module: a directory of .xo files, or a std declaration file.
pub struct Module {
  pub path: Str
  /// The default local name (core 4.1).
  pub name: Str
  pub dir: Str
  pub files: List[Int] = []
  /// Top level names to objects.
  pub members: Map[Bytes, Int] = {}
  pub is_std: Bool = false
  pub is_prelude: Bool = false
  /// Named on the command line (or found under a named directory).
  pub root: Bool = false
  /// 0 new, 1 loading its imports, 2 loaded (cycle detection).
  pub state: Int = 0
  /// The Module object that names it in records.
  pub obj: Int = -1
}

/// An import of a file: the module it names, -1 when the path did not
/// resolve (nothing more is reported about it).
pub struct Import {
  pub module: Int
  pub path: Bytes
  pub used: Bool = false
  /// The `use` declaration (for the unused import check).
  pub span: Span = Span{start: parser.Pos{offset: 0, line: 0, col: 0}, end: parser.Pos{offset: 0, line: 0, col: 0}}
}

/// One parsed source file.
pub struct SrcFile {
  pub path: Str
  pub module: Int
  pub ast: parser.File
  /// Local import names to imports.
  pub imports: Map[Bytes, Import] = {}
  /// The name ends in _test.xo.
  pub is_test: Bool = false
  /// The source, for the habits that look at it.
  pub src: Bytes = b""
  /// Per declaration: the object it declares (a function, method,
  /// type, or constant), -1 for none (tests, duplicates, methods that
  /// did not attach).
  pub decl_objs: List[Int] = []
}

/// An xo.mod: the module path it declares and its directory.
pub struct ModRoot {
  pub path: Str
  pub dir: Str
}

/// A diagnostic: code, span, and message (notes and fixes are a later
/// stage, decision 0141).
pub struct Diag {
  pub code: Str
  pub file: Str
  pub line: Int
  pub col: Int
  pub end_line: Int
  pub end_col: Int
  pub message: Str
}

/// What an identifier resolved to: an object, or (obj -1) the text of a
/// field, variant, or parameter.
pub struct NameRec {
  pub file: Str
  pub offset: Int
  pub line: Int
  pub col: Int
  pub name: Bytes
  pub obj: Int
  pub what: Str = ""
}

/// The type of a checked expression (the types section).
pub struct TypeRec {
  pub file: Int
  pub start: Int
  pub end: Int
  pub sline: Int
  pub scol: Int
  pub eline: Int
  pub ecol: Int
  pub kind: Str
  pub ty: Int
}

/// The inference variable of a type parameter at a call (XO0402 when
/// nothing binds it).
pub struct TypeArgVar {
  pub v: Int
  pub param: Str
  pub fn_name: Str
  pub file: Str
  pub span: Span
}

/// A call of a declared function or a function value (check.go
/// callInfo): the callee (-1 for a function value), the receiver
/// expression of a method call (zero or one), and each argument with
/// whether its parameter is `var`.
pub struct CallInfo {
  pub fn_obj: Int = -1
  pub recv: List[parser.Expr] = []
  pub params: List[ArgParam] = []
}

/// An argument and whether its parameter is `var` (check.go argParam).
pub struct ArgParam {
  pub arg: parser.Expr
  pub is_var: Bool
}

/// A checked body for the flow checks (check.go bodyInfo).
pub struct BodyRef {
  pub file: Int
  pub body: parser.Block
}
