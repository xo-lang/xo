// The x86-64 assembler (decision 0254, stage 1): the amd64 emitter's
// AT&T text into an ELF64 relocatable object, as `clang -c -target
// x86_64-unknown-linux-gnu` writes it. The parse, the directives, the
// data sections, the symbols and the object writer are the arm64
// assembler's (asm.xo, elf.xo); here are the instructions (encoded by
// enc_amd64.xo), the code sections as bytes, LLVM's long NOP padding, the
// x86-64 relocations, and branch relaxation.
//
// Relaxation as LLVM's: a jmp or jcc to a label starts in its short form
// (rel8) and becomes long (rel32) when the target is out of reach or
// needs a relocation, never back. The whole source is parsed again with
// the long set until a pass adds none, so labels, CFI offsets, .size and
// alignment padding are always those of the final layout.

/// ELF relocation types (elf.h, x86-64).
const R_X86_64_64 = 1
const R_X86_64_PC32 = 2
const R_X86_64_PLT32 = 4
const R_X86_64_32 = 10
const R_X86_64_32S = 11
const R_X86_64_GOTPCREL = 9
const R_X86_64_TLSGD = 19
const R_X86_64_TLSLD = 20
const R_X86_64_DTPOFF32 = 21
const R_X86_64_GOTTPOFF = 22
const R_X86_64_TPOFF32 = 23
const R_X86_64_GOTPCRELX = 41
const R_X86_64_REX_GOTPCRELX = 42

/// A branch to a label: its number in the source, section, offset of its
/// first byte, form, target, and condition (-1 for jmp, -2 for call).
struct XBr {
  seq: Int
  sect: Int
  at: Int
  long: Bool
  sym: Int
  cc: Int
  line: Int
}

/// A fixup of an x86-64 code section: at byte `at` of section sect, size
/// bytes, pc relative or not, to sym (minus sym2, -1 for none) plus
/// addend, with the operator rel ("", "PLT", "GOTPCREL", "TPOFF",
/// "GOTTPOFF"); rex when the instruction has a REX prefix (GOTPCRELX
/// against REX_GOTPCRELX).
struct XFx {
  sect: Int
  at: Int
  size: Int
  pcrel: Bool
  sym: Int
  sym2: Int = -1
  addend: Int = 0
  rel: Str = ""
  rex: Bool = false
  /// a GOTPCREL the linker may relax (GOTPCRELX): a mov load, an indirect
  /// call or jmp, a test, or an ALU operation reg <- mem, as LLVM's
  relax: Bool = false
  line: Int
}

/// assemble_elf_amd64: the ELF64 relocatable object of src (the amd64
/// emitter's linux/amd64 assembly), or the first error as "line N: why".
pub fn assemble_elf_amd64(src: Bytes) -> Result[Bytes, Str] {
  var long: Map[Int, Bool] = {}
  while true {
    var a = Asm{elf: true, amd64: true, xlong: long}
    a.parse(src)
    if !a.err.is_empty() {
      return Err(a.err)
    }
    var grew = false
    for br in a.xbrs {
      if !br.long && !a.x86_short_reaches(br) {
        long[br.seq] = true
        grew = true
      }
    }
    if grew {
      continue
    }
    a.finish()
    if !a.err.is_empty() {
      return Err(a.err)
    }
    return Ok(a.write_elf())
  }
  Err("unreachable")
}

/// Whether a short branch reaches its target with no relocation: a label
/// of its own section, not global or weak, within a signed byte of the
/// branch's end.
fn (a: Asm) x86_short_reaches(br: XBr) -> Bool {
  let s = a.syms[br.sym]
  if s.sect != br.sect || s.global || s.weak {
    return false
  }
  let d = s.off - (br.at + 2)
  d >= -128 && d <= 127
}

fn (var a: Asm) push_code(b: List[Int]) {
  for v in b {
    a.sects[a.cur].words.push(v & 0xff)
  }
}

/// An instruction line.
fn (var a: Asm) x86_instruction(l: Bytes) {
  var k = 0
  while k < l.len() && !is_space(l[k]) {
    k += 1
  }
  let m = bstr(l[0..k])
  let rest = trim(l[k..])
  let ops = split_x86_operands(rest)
  // direct branches: placed here, their targets resolved after layout
  if ops.len() == 1 && !ops[0].is_empty() && ops[0][0] != '*' && ops[0][0] != '%' && ops[0][0] != '$' {
    let cc = if m is "jmp" | "jmpq" { -1 } else if m is "call" | "callq" { -2 } else if m.starts_with("j") { x86_cc(m[1..]) } else { -3 }
    if cc >= -2 {
      return a.x86_branch(cc, ops[0])
    }
  }
  let r = encode_x86_line(l)
  if !r.err.is_empty() {
    return a.fail(r.err)
  }
  let base = a.code_len(a.cur)
  let rex = x86_has_rex(r.b)
  let relax = x86_gotpcrel_relaxable(r.b)
  for f in r.fixes {
    var s = a.sym(f.sym)
    a.register(s)
    var s2 = -1
    if !f.sym2.is_empty() {
      s2 = a.sym(f.sym2)
      a.register(s2)
    }
    a.xfixes.push(XFx{sect: a.cur, at: base + f.at, size: f.size, pcrel: f.pcrel, sym: s, sym2: s2, addend: f.addend, rel: f.rel, rex: rex, relax: relax, line: a.line})
  }
  a.push_code(r.b)
}

/// Whether the instruction bytes b have a REX prefix (after legacy
/// prefixes).
fn x86_has_rex(b: List[Int]) -> Bool {
  for v in b {
    if v is 0x66 | 0xf2 | 0xf3 | 0xf0 | 0x64 | 0x65 | 0x2e {
      continue
    }
    return v >= 0x40 && v <= 0x4f
  }
  false
}

/// Whether an instruction's GOTPCREL is relaxable (LLVM's
/// reloc_riprel_4byte_relax kinds): opcode 8b (mov load), ff /2 or /4
/// (indirect call, jmp), 85 (test), or 03 to 3b reg <- r/m (add, or,
/// adc, sbb, and, sub, xor, cmp).
fn x86_gotpcrel_relaxable(b: List[Int]) -> Bool {
  var i = 0
  while i < b.len() && (b[i] is 0x66 | 0xf2 | 0xf3 | 0xf0 | 0x64 | 0x65 || (b[i] >= 0x40 && b[i] <= 0x4f)) {
    i += 1
  }
  if i >= b.len() {
    return false
  }
  let o = b[i]
  if o == 0x8b || o == 0x85 {
    return true
  }
  if o == 0xff && i + 1 < b.len() {
    let r = (b[i + 1] >> 3) & 7
    return r == 2 || r == 4
  }
  o <= 0x3b && (o & 7) == 3
}

/// A direct jmp, jcc or call to the label or symbol t.
fn (var a: Asm) x86_branch(cc: Int, t0: Bytes) {
  var t = t0
  if t.len() > 4 && bstr(t[t.len() - 4..]) == "@PLT" {
    // `call sym@PLT`: a call is PLT32 either way
    t = t[0..t.len() - 4]
  }
  let name = unquote(t) ?? t
  let s = a.label_sym(name)
  a.register(s)
  let at = a.code_len(a.cur)
  if cc == -2 {
    a.push_code([0xe8, 0, 0, 0, 0])
    a.xfixes.push(XFx{sect: a.cur, at: at + 1, size: 4, pcrel: true, sym: s, addend: -4, rel: "PLT", line: a.line})
    return
  }
  let seq = a.xseq
  a.xseq += 1
  let long = a.xlong.contains(seq)
  a.xbrs.push(XBr{seq: seq, sect: a.cur, at: at, long: long, sym: s, cc: cc, line: a.line})
  if !long {
    a.push_code([if cc < 0 { 0xeb } else { 0x70 + cc }, 0])
    a.xfixes.push(XFx{sect: a.cur, at: at + 1, size: 1, pcrel: true, sym: s, addend: -1, line: a.line})
    return
  }
  if cc < 0 {
    a.push_code([0xe9, 0, 0, 0, 0])
    a.xfixes.push(XFx{sect: a.cur, at: at + 1, size: 4, pcrel: true, sym: s, addend: -4, rel: "PLT", line: a.line})
  } else {
    a.push_code([0x0f, 0x80 + cc, 0, 0, 0, 0])
    a.xfixes.push(XFx{sect: a.cur, at: at + 2, size: 4, pcrel: true, sym: s, addend: -4, rel: "PLT", line: a.line})
  }
}

/// LLVM's x86 NOPs by length (X86AsmBackend::writeNopData, at most 10
/// bytes for the generic x86-64 CPU).
fn x86_nop(n: Int) -> List[Int] {
  match n {
    1 => [0x90]
    2 => [0x66, 0x90]
    3 => [0x0f, 0x1f, 0x00]
    4 => [0x0f, 0x1f, 0x40, 0x00]
    5 => [0x0f, 0x1f, 0x44, 0x00, 0x00]
    6 => [0x66, 0x0f, 0x1f, 0x44, 0x00, 0x00]
    7 => [0x0f, 0x1f, 0x80, 0x00, 0x00, 0x00, 0x00]
    8 => [0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]
    9 => [0x66, 0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]
    _ => [0x66, 0x2e, 0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]
  }
}

/// .p2align p in a code section: LLVM's long NOPs, 10 bytes at a time.
fn (var a: Asm) x86_pad(p: Int) {
  let al = pow2(p)
  var n = (al - a.code_len(a.cur) % al) % al
  while n > 0 {
    let k = n.min(10)
    a.push_code(x86_nop(k))
    n -= k
  }
}

/// Writes the little endian value v into n bytes of code section si at
/// off.
fn (var a: Asm) put_code(si: Int, off: Int, v: Int, n: Int) {
  for k in 0..n {
    a.sects[si].words[off + k] = (v >> (8 * k)) & 0xff
  }
}

/// The code fixups: references to labels of their own section resolved,
/// the rest relocated.
fn (var a: Asm) x86_apply_fixes() {
  for f in a.xfixes {
    let s = a.syms[f.sym]
    if f.sym2 >= 0 {
      match a.rel_value(f.sym, f.sym2, f.addend) {
        Some(v) => a.put_code(f.sect, f.at, v, f.size)
        None => {
          a.err = "line ${f.line}: a difference of symbols in different sections"
          return
        }
      }
      continue
    }
    let local = s.sect == f.sect && !s.global && !s.weak
    if f.rel is "" | "PLT" && f.pcrel && local {
      let v = s.off + f.addend - f.at
      if f.size == 1 && (v < -128 || v > 127) {
        a.err = "line ${f.line}: internal: a short branch out of reach"
        return
      }
      a.put_code(f.sect, f.at, v, f.size)
      continue
    }
    let typ = match f.rel {
      "PLT" => R_X86_64_PLT32
      "GOTPCREL" => if !f.relax { R_X86_64_GOTPCREL } else if f.rex { R_X86_64_REX_GOTPCRELX } else { R_X86_64_GOTPCRELX }
      "TPOFF" => R_X86_64_TPOFF32
      "GOTTPOFF" => R_X86_64_GOTTPOFF
      "TLSGD" => R_X86_64_TLSGD
      "TLSLD" => R_X86_64_TLSLD
      "DTPOFF" => R_X86_64_DTPOFF32
      _ => {
        if f.pcrel && f.size == 4 {
          R_X86_64_PC32
        } else if !f.pcrel && f.size == 8 {
          R_X86_64_64
        } else if !f.pcrel && f.size == 4 {
          R_X86_64_32S
        } else {
          a.err = "line ${f.line}: a ${f.size} byte reference to ${bstr(s.name)}"
          return
        }
      }
    }
    if f.rel is "TPOFF" | "GOTTPOFF" | "TLSGD" | "TLSLD" | "DTPOFF" {
      a.syms[f.sym].kind = STT_TLS
    }
    a.elf_reloc(f.sect, f.at, typ, f.sym, f.addend)
  }
}

/// The DWARF register number of an x86-64 .cfi_ register operand.
fn x86_dwarf_reg(b: Bytes) -> Int {
  let s = bstr(b)
  match s {
    "%rax" => 0
    "%rdx" => 1
    "%rcx" => 2
    "%rbx" => 3
    "%rsi" => 4
    "%rdi" => 5
    "%rbp" => 6
    "%rsp" => 7
    "%rip" => 16
    _ => {
      if s.starts_with("%r") {
        let n = parse_int(b[2..]) ?? -1
        if n >= 8 && n < 16 {
          return n
        }
      }
      if s.starts_with("%xmm") {
        let n = parse_int(b[4..]) ?? -1
        if n >= 0 && n < 16 {
          return 17 + n
        }
      }
      -1
    }
  }
}
