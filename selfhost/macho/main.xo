// macho: the self hosted Mach-O assembler and linker of decision 0182.
//
//   macho asm [-o OUT.o] [--minos=X.Y] [--bench=N] IN.s   assemble the arm64 emitter's
//                                            assembly into an object
//
// The package is also the library xo1 (selfhost/xo) calls: assemble.

fn main(os: Os) ! {
  let args = os.env.args()
  if args.is_empty() || args[0] != "asm" {
    usage(os)
  }
  var out = ""
  var repeat = 0
  var minos = (11, 0)
  var ins: List[Str] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "-o" && i + 1 < args.len() {
      out = args[i + 1]
      i += 1
    } else if a.starts_with("--minos=") {
      let v = a.trim_prefix("--minos=").split(".")
      minos = (Int.parse(v[0]) ?? 11, if v.len() > 1 { Int.parse(v[1]) ?? 0 } else { 0 })
    } else if a.starts_with("--bench=") {
      repeat = Int.parse(a.trim_prefix("--bench=")) ?? 0
    } else {
      ins.push(a)
    }
    i += 1
  }
  if ins.len() != 1 {
    usage(os)
  }
  let src = os.fs.read(ins[0])?
  if repeat > 0 {
    let t0 = os.clock.now()
    var size = 0
    for _ in 0..repeat {
      match assemble_for(src, minos) {
        Ok(b) => size = b.len()
        Err(e) => fail(os, "${ins[0]}: ${e}")
      }
    }
    let el = os.clock.now() - t0
    os.stdio.println("assembled ${ins[0]} x ${repeat}: ${size} bytes, ${el.nanos() / 1000000 / repeat} ms each")
    return
  }
  if out.is_empty() {
    out = ins[0].trim_suffix(".s") + ".o"
  }
  match assemble_for(src, minos) {
    Ok(b) => os.fs.write(out, b)?
    Err(e) => fail(os, "${ins[0]}: ${e}")
  }
}

fn usage(os: Os) -> Never {
  os.stdio.eprintln("usage: macho asm [-o OUT.o] [--minos=X.Y] [--bench=N] IN.s")
  os.proc.exit(2)
}

fn fail(os: Os, msg: Str) -> Never {
  os.stdio.eprintln("macho: ${msg}")
  os.proc.exit(1)
}
