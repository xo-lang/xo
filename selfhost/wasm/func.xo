// Functions (decision 0179): one wasm function per SSA function, its
// parameters the leaves of the entry block's, its results the leaves of
// every result (multiple results for `var` parameters). The control flow
// graph is a dispatch loop: a `loop` around one `block` per SSA block,
// innermost first, entered through a `br_table` on the block number; a
// block's code follows the end of its wasm block, so a jump to the next
// block falls through and any other sets the number and branches to the
// loop. Block parameters are locals the edges assign (all arguments are
// pushed before any is stored, a parallel copy).

use github.com/xo-lang/xo/selfhost/ssa

fn (var g: Gen) func(fi: Int) {
  let f = g.m.funcs[fi]
  if !f.skip.is_empty() {
    g.fail("the SSA builder skipped ${f.name}: ${f.skip}")
    return
  }
  g.f = f
  g.fi = fi
  g.vbase = []
  g.blk = []
  for _ in 0..f.values.len() {
    g.vbase.push(-1)
    g.blk.push(-1)
  }
  for (bi, b) in f.blocks.indexed() {
    for p in b.params {
      g.blk[p] = bi
    }
    for v in b.instrs {
      g.blk[v] = bi
    }
  }
  var ps: List[Str] = []
  g.tslots = []
  g.scr = {}
  g.scr_n = {}
  g.hptr = []
  g.hparam = []
  g.hval = []
  g.hro = []
  for (i, p) in f.blocks[0].params.indexed() {
    if g.homes[fi].contains(i) {
      // the address of its home (home.xo)
      g.hptr.push(ps.len())
      g.hparam.push(i)
      g.hval.push(p)
      g.hro.push(g.rhomes[fi].contains(i))
      ps.push("i32")
      continue
    }
    g.vbase[p] = ps.len()
    for l in g.leaves(f.values[p].ty) {
      ps.push(l)
    }
  }
  var rs: List[Str] = []
  for (k, r) in f.results.indexed() {
    if g.home_result(fi, k) {
      continue
    }
    for l in g.leaves(r) {
      rs.push(l)
    }
  }
  g.cur = FnText{nparams: ps.len()}
  g.nres_leaves = rs.len()
  g.zexit = false
  g.pc_local = g.tmp("i32")
  g.plan_locals()
  g.su = g.susp.len() > fi && g.susp[fi]
  g.segs = []
  g.nres = 0
  let nb = f.blocks.len()
  g.nuse = []
  for _ in 0..f.values.len() {
    g.nuse.push(0)
  }
  for x in f.values {
    for a in x.args {
      if a >= 0 {
        g.nuse[a] += 1
      }
    }
    for e in x.succs {
      for a in f.edges[e].args {
        if a >= 0 {
          g.nuse[a] += 1
        }
      }
    }
  }
  for (bi, b) in f.blocks.indexed() {
    // where the block's code starts (layout.xo places it)
    g.e("@block ${bi}")
    // snapshots of a home's value taken where the block starts (home.xo)
    for prm in b.params {
      g.take_snaps(prm)
    }
    if g.annotate {
      g.e(";; @block")
    }
    if g.unwind_block(bi) {
      if g.annotate {
        g.e(";; @unwind_exit")
      }
      // the function's unwind exit: the fault goes on to the caller,
      // which reads no result (zeros, as any fault exit)
      g.e("global.get $faulting")
      g.e("global.set $prop")
      g.zero_exit()
      continue
    }
    var j = 0
    while j < b.instrs.len() {
      g.scr_n = {}
      if g.annotate {
        let x = g.f.values[b.instrs[j]]
        var what = ssa.op_name(x.op)
        if x.op == ssa.Op.Call {
          if let S(n) = x.aux {
            what = if g.by_name.contains(n) { "call ${if g.homes[g.by_name.get(n) ?? 0].is_empty() { "fn" } else { "fn_home" }}" } else { "call ${n}" }
          }
        }
        g.e(";; @${what}")
      }
      let n = g.release_run(b.instrs, j)
      if n > 0 {
        if g.annotate {
          g.e(";; @release_run")
        }
        j += n
        continue
      }
      g.instr(b.instrs[j], bi)
      if !g.err.is_empty() && !g.all {
        return
      }
      j += 1
    }
  }
  let body = g.cur.lines
  g.cur.lines = []
  // a home whose chain does not stay in memory: its parameter is loaded
  // at entry (before a resumed task restores its locals)
  for (h, p) in g.hval.indexed() {
    if !g.hok[h] {
      g.mem_push(g.hptr[h], 0, g.leaves(f.values[p].ty))
      g.set_range(g.loc(p), g.nleaves(f.values[p].ty))
    }
  }
  // a function that can suspend (rt3.xo) saves its locals and its resume
  // point when the code it calls suspends, and restores them when the
  // scheduler resumes the task (the stack rewinds)
  var frame = 0
  var fa = -1
  var tys: List[Str] = []
  if g.su {
    frame = g.cur.nparams + g.cur.locals.len()
    for l in ps {
      tys.push(l)
    }
    for l in g.cur.locals {
      tys.push(l)
    }
    fa = g.tmp("i32")
    g.e("global.get $sstate")
    g.e("i32.const 2")
    g.e("i32.eq")
    g.e("if")
    g.e("i32.const ${8 * frame}")
    g.e("call $ss_pop")
    g.set(fa)
    for (k, t) in tys.indexed() {
      g.get(fa)
      g.e("${t}.load offset=${8 * k}")
      g.set(k)
    }
    g.e("end")
  }
  if g.zexit {
    g.e("block $Z")
  }
  if g.su {
    g.e("block $S")
  }
  // structured control flow when the graph allows it, else the dispatch
  // loop (layout.xo)
  g.why_dispatch = if g.su { "suspends" } else { "" }
  if g.su || !g.structured(body, nb) {
    g.dispatch(body, nb)
  }
  g.e("unreachable")
  if g.su {
    g.e("end")
    g.e("i32.const ${8 * frame}")
    g.e("call $ss_push")
    g.set(fa)
    for (k, t) in tys.indexed() {
      g.get(fa)
      g.get(k)
      g.e("${t}.store offset=${8 * k}")
    }
    g.push_zeros(rs)
    if g.zexit {
      g.e("return")
    }
  }
  if g.zexit {
    g.e("end")
    g.zero_homes()
    g.push_zeros(rs)
  }
  g.coalesce_locals(g.pc_local)
  g.renumber_locals()
  var head = "(func $f${fi}"
  if !ps.is_empty() {
    head = "${head} (param ${ps.join(" ")})"
  }
  if !rs.is_empty() {
    head = "${head} (result ${rs.join(" ")})"
  }
  if !g.cur.locals.is_empty() {
    head = "${head} (local ${g.cur.locals.join(" ")})"
  }
  var b = StrBuilder.new()
  var note = ""
  if g.annotate && !g.hok.is_empty() {
    // which homes keep their chain in memory (home.xo)
    var hs: List[Str] = []
    for (h, ok) in g.hok.indexed() {
      hs.push(if g.hro[h] { "ro" } else if ok { "held" } else { "fallback" })
    }
    note = " (homes: ${hs.join(" ")})"
  }
  if g.annotate && !g.why_dispatch.is_empty() {
    note = "${note} (dispatch: ${g.why_dispatch})"
  }
  b.write("  ;; ${comment_text(f.name)}${note}\n  ${head}\n")
  for l in g.cur.lines {
    b.write("    ")
    b.write(l)
    b.write("\n")
  }
  b.write("  )\n")
  g.funcs.push(b.freeze())
}

/// Renumbers the locals of the function in the current buffer so the
/// most used ones have the indexes below 128, which take one byte (the
/// index of every `local.get` and `local.set` is a LEB128 number; the
/// self hosted checker's functions have thousands of locals). Those come
/// first and the rest after, each group by type, so the run length coded
/// declarations stay short.
fn (var g: Gen) renumber_locals() {
  let np = g.cur.nparams
  let nl = g.cur.locals.len()
  if np + nl <= 128 {
    return
  }
  var count: List[Int] = []
  for _ in 0..nl {
    count.push(0)
  }
  for l in g.cur.lines {
    if l.starts_with("local.") && l.len() > 10 {
      let i = (Int.parse(l[10..l.len()]) ?? 0) - np
      if i >= 0 && i < nl {
        count[i] += 1
      }
    }
  }
  // the hot locals: the most used, up to the one byte indexes left
  let room = 128 - np
  var order: List[Int] = []
  for i in 0..nl {
    order.push(i)
  }
  var hot: List[Bool] = []
  for _ in 0..nl {
    hot.push(false)
  }
  if room > 0 {
    // a bucket per use count (counts above 4096 share the top one)
    var buckets: List[List[Int]] = []
    for _ in 0..4097 {
      buckets.push([])
    }
    for i in 0..nl {
      buckets[count[i].min(4096)].push(i)
    }
    var taken = 0
    var c = 4096
    while c > 1 && taken < room {
      for i in buckets[c] {
        if taken < room {
          hot[i] = true
          taken += 1
        }
      }
      c -= 1
    }
  }
  var newidx: List[Int] = []
  for _ in 0..nl {
    newidx.push(0)
  }
  var types: List[Str] = []
  var next = np
  for group in [true, false] {
    for t in ["i32", "i64", "f64"] {
      for i in 0..nl {
        if hot[i] == group && g.cur.locals[i] == t {
          newidx[i] = next
          types.push(t)
          next += 1
        }
      }
    }
  }
  if types.len() != nl {
    return
  }
  var lines: List[Str] = []
  for l in g.cur.lines {
    if l.starts_with("local.") && l.len() > 10 {
      let i = (Int.parse(l[10..l.len()]) ?? 0) - np
      if i >= 0 && i < nl {
        lines.push("${l[0..10]}${newidx[i]}")
        continue
      }
    }
    lines.push(l)
  }
  g.cur.lines = lines
  g.cur.locals = types
}

/// Starts a resume point before a call that can suspend (a dispatch
/// label of its own); -1 in a function that cannot suspend.
fn (var g: Gen) resume_point() -> Int {
  if !g.su {
    return -1
  }
  let id = g.f.blocks.len() + g.nres
  let label = "$R${g.nres}"
  g.nres += 1
  g.e("@resume ${label}")
  id
}

/// After the call of resume point id: when the callee suspended, this
/// function saves its frame and returns too.
fn (var g: Gen) suspend_check(id: Int) {
  if id < 0 {
    return
  }
  g.e("global.get $sstate")
  g.e("i32.const 1")
  g.e("i32.eq")
  g.e("if")
  g.e("i32.const ${id}")
  g.set(g.pc_local)
  g.e("br $S")
  g.e("end")
}

/// A name in a WAT line comment (no line breaks).
fn comment_text(s: Str) -> Str {
  s.replace("\n", " ")
}

/// Assigns the locals of the function's values before it is lowered:
/// values whose live ranges do not overlap share locals (a linear scan
/// over the blocks in order, each value's range widened to one interval
/// from its first to its last live position, which is safe for any
/// control flow). One set of locals per value made a function of the
/// self hosted checker hold 3.5 million locals (Checker, 253 leaves,
/// copied by every field update and `var` call); V8 takes 50,000.
fn (var g: Gen) plan_locals() {
  let f = g.f
  let nv = f.values.len()
  var bstart: List[Int] = []
  var bend: List[Int] = []
  var pos: List[Int] = []
  for _ in 0..nv {
    pos.push(-1)
  }
  var p = 0
  for b in f.blocks {
    bstart.push(p)
    for prm in b.params {
      pos[prm] = p
    }
    p += 1
    for v in b.instrs {
      pos[v] = p
      p += 1
    }
    bend.push(p - 1)
  }
  g.plan_homes(pos, [], bend)
  var lo: List[Int] = []
  var hi: List[Int] = []
  for v in 0..nv {
    lo.push(pos[v])
    hi.push(pos[v])
  }
  // a snapshot (home.xo) lives from where it is taken
  for (rep, d) in g.snapdef.entries() {
    lo[rep] = lo[rep].min(pos[d])
    hi[rep] = hi[rep].max(pos[d])
  }
  // a block parameter is written at the end of each predecessor (the
  // edge's copy)
  for (bi, b) in f.blocks.indexed() {
    if bi == 0 {
      continue
    }
    for e in b.preds {
      let at = bend[f.edges[e].from]
      for prm in b.params {
        lo[prm] = lo[prm].min(at)
        hi[prm] = hi[prm].max(at)
      }
    }
  }
  var stamp: List[Int] = []
  for _ in f.blocks {
    stamp.push(-1)
  }
  var work: List[Int] = []
  for (bi, b) in f.blocks.indexed() {
    for x in b.instrs {
      let xp = pos[x]
      var us: List[Int] = []
      for a in f.values[x].args {
        us.push(a)
      }
      for e in f.values[x].succs {
        for a in f.edges[e].args {
          us.push(a)
        }
      }
      for a0 in us {
        if a0 < 0 || pos[a0] < 0 {
          continue
        }
        // a use of a field read that reads a snapshot is a use of the
        // snapshot, which lives from where it is taken
        let a = if g.snaprep[a0] >= 0 { g.snaprep[a0] } else { a0 }
        let d = if g.snaprep[a0] >= 0 { g.blk[g.snapdef.get(a) ?? a] } else { g.blk[a0] }
        lo[a] = lo[a].min(xp)
        hi[a] = hi[a].max(xp)
        if d == bi {
          continue
        }
        // live from the start of this block, and back through the
        // predecessors to the defining block
        lo[a] = lo[a].min(bstart[bi])
        stamp[bi] = a
        work.push(bi)
        while let Some(w) = work.pop() {
          for e in f.blocks[w].preds {
            let pb = f.edges[e].from
            if pb == d || stamp[pb] == a {
              // live out of it (the use block itself, around a loop)
              hi[a] = hi[a].max(bend[pb])
              continue
            }
            if stamp[pb] != a {
              stamp[pb] = a
              lo[a] = lo[a].min(bstart[pb])
              hi[a] = hi[a].max(bend[pb])
              work.push(pb)
            }
          }
        }
      }
    }
  }

  // a field of a struct or tuple (a `var` call's result, a field read) is
  // that value's locals, which then stay as long as the field does: no
  // copy (not for a block parameter, which its edges rewrite)
  var src: List[Int] = []
  for _ in 0..nv {
    src.push(-1)
  }
  g.alias = []
  for _ in 0..nv {
    g.alias.push(false)
  }
  var isparam: List[Bool] = []
  for _ in 0..nv {
    isparam.push(false)
  }
  for (bi, b) in f.blocks.indexed() {
    if bi > 0 {
      for prm in b.params {
        isparam[prm] = true
      }
    }
  }
  var atpos: List[Int] = []
  for _ in 0..p {
    atpos.push(-1)
  }
  for b in f.blocks {
    for v in b.instrs {
      atpos[pos[v]] = v
    }
  }
  for q in 0..p {
    let vi = atpos[q]
    if vi < 0 {
      continue
    }
    let x = f.values[vi]
    if x.op == ssa.Op.Field && x.args.len() == 1 && g.nleaves(x.ty) > 0 && g.held[vi] < 0 && g.mfield[vi] < 0 {
      let a = x.args[0]
      if pos[a] >= 0 && f.values[a].op != ssa.Op.Undef && g.held[a] < 0 && g.mfield[a] < 0 {
        src[vi] = a
        g.alias[vi] = true
      }
    }
  }
  // the struct (and the struct it is a field of, and so on) lives as
  // long as the field (blocks are not in dominance order: walk chains)
  for q in 0..p {
    let vi = atpos[q]
    if vi < 0 || !g.alias[vi] {
      continue
    }
    var w = vi
    while src[w] >= 0 {
      w = src[w]
      // a snapshot's read stands for the snapshot
      let t = if g.snaprep[w] >= 0 { g.snaprep[w] } else { w }
      hi[t] = hi[t].max(hi[vi])
      lo[t] = lo[t].min(lo[vi])
    }
  }
  // the scan: values by the start of their range; locals come back to
  // a pool per leaf signature after the end of a range
  var starts: List[List[Int]] = []
  var ends: List[List[Int]] = []
  for _ in 0..p + 1 {
    starts.push([])
    ends.push([])
  }
  for v in 0..nv {
    // an undefined value keeps zeroed locals of its own
    if pos[v] < 0 || g.vbase[v] >= 0 || g.alias[v] || g.held[v] >= 0 || g.mfield[v] >= 0 || (g.snaprep[v] >= 0 && g.snaprep[v] != v) || g.nleaves(f.values[v].ty) == 0 || f.values[v].op == ssa.Op.Undef {
      continue
    }
    starts[lo[v]].push(v)
    ends[hi[v]].push(v)
  }
  var pool: Map[Str, List[Int]] = {}
  var moved: List[Bool] = []
  for _ in 0..nv {
    moved.push(false)
  }
  g.inplace = []
  for _ in 0..nv {
    g.inplace.push(false)
  }
  for q in 0..p {
    if q > 0 {
      for v in ends[q - 1] {
        if moved[v] {
          continue
        }
        let key = g.alloc_leaves(v).join(" ")
        var l = pool.get(key) ?? []
        l.push(g.vbase[v])
        pool[key] = l
      }
    }
    for v in starts[q] {
      let x = f.values[v]
      if x.op == ssa.Op.SetField && x.args.len() == 2 {
        // a field update of a struct that dies here is made in place:
        // only the field's leaves are written
        let a = x.args[0]
        if hi[a] == q && pos[v] == q && g.vbase[a] >= 0 && !moved[a] && f.values[a].ty == x.ty {
          g.vbase[v] = g.vbase[a]
          moved[a] = true
          g.inplace[v] = true
          continue
        }
      }
      let ls = g.alloc_leaves(v)
      let key = ls.join(" ")
      var l = pool.get(key) ?? []
      if let Some(b) = l.pop() {
        g.vbase[v] = b
        pool[key] = l
      } else {
        g.vbase[v] = g.tmps(ls)
      }
    }
  }
  // the field reads of one snapshot share its locals
  for v in 0..nv {
    let r = g.snaprep[v]
    if r >= 0 && r != v {
      g.vbase[v] = g.vbase[r]
    }
  }
  // the fields: their struct's locals at the field's offset
  for q in 0..p {
    let v = atpos[q]
    if v >= 0 && g.alias[v] {
      g.alias_base(v, src)
    }
  }
}

/// The first local of the aliased field v: its struct's (resolved
/// first when it is a field too) plus the field's offset.
fn (var g: Gen) alias_base(v: Int, src: List[Int]) -> Int {
  if g.vbase[v] >= 0 {
    return g.vbase[v]
  }
  let a = src[v]
  let ab = if g.alias[a] { g.alias_base(a, src) } else { g.loc(a) }
  let i = match g.f.values[v].aux {
    I(n) => n
    _ => 0
  }
  g.vbase[v] = ab + g.field_off(g.f.values[a].ty, i)
  g.vbase[v]
}

/// The first local of value v (allocated at its first use). A value in
/// memory (home.xo) is loaded into new locals here, where it is used.
fn (var g: Gen) loc(v: Int) -> Int {
  let (mp, _) = g.mem_of(v)
  if mp >= 0 {
    let ls = g.leaves(g.vty(v))
    let b = g.scratch(ls)
    g.push(v)
    g.set_range(b, ls.len())
    return b
  }
  if g.vbase[v] < 0 {
    g.vbase[v] = g.tmps(g.leaves(g.f.values[v].ty))
  }
  g.vbase[v]
}

fn (var g: Gen) vty(v: Int) -> Int {
  g.f.values[v].ty
}

/// Pushes the leaves of value v.
fn (var g: Gen) push(v: Int) {
  let (mp, mo) = g.mem_of(v)
  if mp >= 0 {
    g.mem_push(mp, mo, g.leaves(g.vty(v)))
    return
  }
  let n = g.nleaves(g.vty(v))
  if n > 0 {
    g.push_range(g.loc(v), n)
  }
}

/// Pushes leaves k0 to k1 of value v.
fn (var g: Gen) push_part(v: Int, k0: Int, k1: Int) {
  let (mp, mo) = g.mem_of(v)
  if mp >= 0 {
    let ls = g.leaves(g.vty(v))
    for k in k0..k1 {
      g.get(mp)
      g.e("${ls[k]}.load offset=${mo + 8 * k}")
    }
    return
  }
  let b = g.loc(v)
  for k in k0..k1 {
    g.get(b + k)
  }
}

/// Defines value v from the leaves on the stack.
fn (var g: Gen) def(v: Int) {
  let n = g.nleaves(g.vty(v))
  if n > 0 {
    g.set_range(g.loc(v), n)
  }
}

fn (var g: Gen) arg(v: Int, i: Int) -> Int {
  g.f.values[v].args[i]
}

/// `i32.const addr i32.const len` of the fault position of v.
fn (var g: Gen) locp(v: Int) -> Str {
  g.litp(g.f.values[v].pos)
}

/// A jump to block b (layout.xo lowers it: a `br` to b's label, or the
/// dispatch loop's `i32.const b`, `local.set PC`, `br $L`).
fn (var g: Gen) goto(b: Int) {
  g.e("@goto ${b}")
}

/// Leaves the code of v after a fault: to its landing block when it has
/// one (decision 0085), else back to the caller (the results are never
/// read: the caller tests the flag). $prop tells that the fault is
/// passing through frames (raised or handed on by rt.fault_continue); a
/// landing stops it there, and the cleanup code runs normally (a packed
/// `with` closure then returns with the fault still set, as the native
/// landing pads do).
fn (var g: Gen) fault_exit(v: Int) {
  let pad = g.f.values[v].pad
  if pad >= 0 {
    g.e("i32.const 0")
    g.e("global.set $prop")
    let t = g.f.term(g.blk[pad])
    let e = g.f.values[t].succs[0]
    g.goto(g.f.edges[e].to)
    return
  }
  g.zero_exit()
}

/// Returns zero results: the leaves are pushed once, after the dispatch
/// loop (`$Z`), which every fault exit of the function branches to.
fn (var g: Gen) zero_exit() {
  if g.nres_leaves > 0 || !g.hptr.is_empty() {
    g.zexit = true
    g.e("br $Z")
    return
  }
  g.e("return")
}

/// Whether block bi is an unwind exit the backend lowers as a fault exit:
/// it hands the fault on (rt.fault_continue) and returns placeholder
/// values (constants, empty lists, and aggregates of them, which only
/// this block uses), in a program where no task waits, so unwinding is
/// always a fault and the caller reads no result. A `Checker` method's
/// unwind exit built and returned its 253 leaves.
fn (var g: Gen) unwind_block(bi: Int) -> Bool {
  if g.blocks_wait {
    return false
  }
  let b = g.f.blocks[bi]
  if !b.params.is_empty() || b.instrs.is_empty() {
    return false
  }
  var cont = false
  for (k, v) in b.instrs.indexed() {
    let x = g.f.values[v]
    let last = k == b.instrs.len() - 1
    if last != (x.op == ssa.Op.Return) {
      return false
    }
    match x.op {
      Return | Const | Struct | Tuple | Variant => {}
      Retain | Release => {
        if g.blk[x.args[0]] != bi {
          return false
        }
      }
      Call => {
        let name = match x.aux {
          S(s) => s
          _ => ""
        }
        if name == "rt.fault_continue" {
          cont = true
        } else if name != "rt.rl_empty" {
          return false
        }
      }
      _ => return false
    }
  }
  cont
}

/// Lowers the run of releases of fields of one struct at instrs[j] (a
/// `field` and its only use, a `release`; or a `release` of a field read
/// that is its struct's locals or memory) as one call of a helper given
/// the whole struct, or its address when it is in memory (home.xo), when
/// that is shorter: the landing pads of a `Checker` method released its
/// 220 heap fields one by one. Returns the instructions it took, 0 for
/// none.
fn (var g: Gen) release_run(instrs: List[Int], j: Int) -> Int {
  var k = j
  var c = -1
  var fields: List[Int] = []
  var cost = 0
  var last = j
  while k < instrs.len() {
    let x = g.f.values[instrs[k]]
    var fv = -1
    var step = 0
    if x.op == ssa.Op.Field && k + 1 < instrs.len() {
      let rx = g.f.values[instrs[k + 1]]
      if rx.op == ssa.Op.Release && rx.args[0] == instrs[k] && g.nuse[instrs[k]] == 1 && !g.snapped(instrs[k]) {
        fv = instrs[k]
        step = 2
      } else if g.no_code(instrs[k]) {
        // a field read that is its struct's locals or memory (the SSA
        // reads a call's `var` result once per release): no code
        k += 1
        continue
      }
    } else if x.op == ssa.Op.Release {
      let a = x.args[0]
      if a >= 0 && g.f.values[a].op == ssa.Op.Field && ((g.alias.len() > a && g.alias[a]) || g.mfield[a] >= 0) {
        fv = a
        step = 1
      }
    }
    if fv < 0 {
      break
    }
    let fx = g.f.values[fv]
    let a = fx.args[0]
    if c >= 0 && !g.same_place(a, c) {
      break
    }
    let at = g.vty(a)
    if !(g.kind(at) is ssa.Kind.Struct | ssa.Kind.Tuple) || g.f.values[a].op == ssa.Op.Const {
      break
    }
    let i = match fx.aux {
      I(n) => n
      _ => -1
    }
    if i < 0 || fields.contains(i) || !g.heap(fx.ty) {
      break
    }
    c = a
    fields.push(i)
    cost += g.nleaves(fx.ty) + 2
    k += step
    last = k
  }
  k = last
  if c < 0 || fields.len() < 2 {
    return 0
  }
  let (mp, mo) = g.mem_of(c)
  if mp >= 0 {
    g.get(mp)
    if mo > 0 {
      g.e("i32.const ${mo}")
      g.e("i32.add")
    }
    g.e("call ${g.drop_mem_fields_fn(g.vty(c), fields)}")
    return k - j
  }
  if cost <= g.nleaves(g.vty(c)) + 2 {
    return 0
  }
  if g.alloc_leaves(c).len() < g.nleaves(g.vty(c)) {
    // a call's result whose trailing fields stay in their homes (a var
    // parameter's write back, home.xo alloc_leaves) has locals for its
    // leading fields only: pushing all its leaves would read other
    // values' locals (an invalid module: tls13srv.pump, 2026-10-16), so
    // its fields are released one by one
    return 0
  }
  g.push(c)
  g.e("call ${g.drop_fields_fn(g.vty(c), fields)}")
  k - j
}

/// Whether lowering value v emits no code: a field read that is its
/// struct's locals or memory (plan_locals, home.xo).
fn (g: Gen) no_code(v: Int) -> Bool {
  g.f.values[v].op == ssa.Op.Field && ((g.alias.len() > v && g.alias[v]) || g.held[v] >= 0 || g.mfield[v] >= 0)
}

/// Whether values a and c of one type are in the same place now: one
/// value, or the same memory (a home's value, or a field of it), or the
/// same locals (field reads aliasing one struct's locals; the SSA reads
/// the `var` result of a call once per use).
fn (g: Gen) same_place(a: Int, c: Int) -> Bool {
  if a == c {
    return true
  }
  if g.f.values[a].ty != g.f.values[c].ty {
    return false
  }
  let (ma, oa) = g.mem_of(a)
  let (mc, oc) = g.mem_of(c)
  if ma >= 0 || mc >= 0 {
    return ma == mc && oa == oc
  }
  g.alias.len() > a && g.alias[a] && g.alias[c] && g.vbase[a] >= 0 && g.vbase[a] == g.vbase[c]
}

/// Tests the fault flag after v.
fn (var g: Gen) check_fault(v: Int) {
  g.e("global.get $prop")
  g.e("if")
  g.fault_exit(v)
  g.e("end")
}

/// The assignments and the jump of edge e from block bi.
fn (var g: Gen) edge(e: Int, bi: Int) {
  let ed = g.f.edges[e]
  let ps = g.f.blocks[ed.to].params
  for (k, a) in ed.args.indexed() {
    if a >= 0 && g.held[ps[k]] < 0 {
      g.push(a)
    }
  }
  var k = ps.len() - 1
  while k >= 0 {
    if ed.args[k] >= 0 && g.held[ps[k]] < 0 {
      g.def(ps[k])
    }
    k -= 1
  }
  // the dispatch loop falls through to the next block (an edge is the
  // last code of its block)
  g.e("@edge ${ed.to}")
}

fn (var g: Gen) binop(v: Int, ins: Str) {
  g.push(g.arg(v, 0))
  g.push(g.arg(v, 1))
  g.e(ins)
  g.def(v)
}

/// A checked operation: the runtime function fn on the operands and the
/// position, then the fault test.
fn (var g: Gen) checked(v: Int, fname: Str, nargs: Int) {
  for i in 0..nargs {
    g.push(g.arg(v, i))
  }
  g.e(g.locp(v))
  g.e("call ${fname}")
  g.def(v)
  g.check_fault(v)
}

fn (var g: Gen) instr(v: Int, bi: Int) {
  let x = g.f.values[v]
  let t = x.ty
  match x.op {
    Param | Cap | Undef | Share => {}
    Const => g.constant(v)
    Add | Sub | Mul => {
      let opn = if x.op == ssa.Op.Add { "add" } else if x.op == ssa.Op.Sub { "sub" } else { "mul" }
      if g.kind(t) == ssa.Kind.Float {
        g.binop(v, "f64.${opn}")
      } else if !x.pos.is_empty() {
        g.checked(v, "$${opn}_chk", 2)
      } else {
        g.binop(v, "i64.${opn}")
      }
    }
    Div | Rem => {
      let opn = if x.op == ssa.Op.Div { "div" } else { "rem" }
      if g.kind(t) == ssa.Kind.Float {
        g.binop(v, if x.op == ssa.Op.Rem { "call $fmod" } else { "f64.div" })
      } else if !x.pos.is_empty() {
        g.checked(v, "$${opn}_chk", 2)
      } else {
        g.binop(v, "i64.${opn}_s")
      }
    }
    Neg => {
      if g.kind(t) == ssa.Kind.Float {
        g.push(g.arg(v, 0))
        g.e("f64.neg")
        g.def(v)
      } else if !x.pos.is_empty() {
        g.checked(v, "$neg_chk", 1)
      } else {
        g.e("i64.const 0")
        g.push(g.arg(v, 0))
        g.e("i64.sub")
        g.def(v)
      }
    }
    And | Or | Xor => {
      let opn = if x.op == ssa.Op.And { "and" } else if x.op == ssa.Op.Or { "or" } else { "xor" }
      let w = if g.kind(t) == ssa.Kind.Bool { "i32" } else { "i64" }
      g.binop(v, "${w}.${opn}")
    }
    Not => {
      g.push(g.arg(v, 0))
      if g.kind(t) == ssa.Kind.Bool {
        g.e("i32.eqz")
      } else {
        g.e("i64.const -1")
        g.e("i64.xor")
      }
      g.def(v)
    }
    Shl | Shr => {
      let opn = if x.op == ssa.Op.Shl { "shl" } else { "shr" }
      if !x.pos.is_empty() {
        g.checked(v, "$${opn}_chk", 2)
      } else {
        g.binop(v, if x.op == ssa.Op.Shl { "i64.shl" } else { "i64.shr_s" })
      }
    }
    Eq | Ne | Lt | Le | Gt | Ge => g.compare(v)
    IntToFloat => {
      g.push(g.arg(v, 0))
      g.e("f64.convert_i64_s")
      g.def(v)
    }
    FloatToInt => {
      if !x.pos.is_empty() {
        g.checked(v, "$ftoi_chk", 1)
        return
      }
      g.push(g.arg(v, 0))
      g.e("i64.trunc_sat_f64_s")
      g.def(v)
    }
    IntConv => {
      g.push(g.arg(v, 0))
      g.def(v)
    }
    Struct | Tuple => {
      for a in x.args {
        g.push(a)
      }
      g.def(v)
    }
    Field => {
      let a = x.args[0]
      let i = match x.aux {
        I(n) => n
        _ => 0
      }
      if (g.alias.len() > v && g.alias[v]) || g.held[v] >= 0 || g.mfield[v] >= 0 || g.snapped(v) {
        // v is the field's leaves in a's locals (plan_locals), or in
        // memory (home.xo: the `var` result of a call that updated the
        // home, or a read loaded where it is used)
        return
      }
      let off = g.field_off(g.vty(a), i)
      g.push_part(a, off, off + g.nleaves(t))
      g.def(v)
    }
    SetField => {
      let a = x.args[0]
      let at = g.vty(a)
      let i = match x.aux {
        I(n) => n
        _ => 0
      }
      let off = g.field_off(at, i)
      let n = g.nleaves(g.field_ty(at, i))
      if g.held[v] >= 0 {
        // the struct dies here and its home holds v (home.xo)
        if n > 0 {
          let b = g.loc(x.args[1])
          g.mem_store(g.hptr[g.held[v]], 8 * off, b, g.leaves(g.field_ty(at, i)))
        }
        g.take_snaps(v)
        return
      }
      if g.inplace.len() > v && g.inplace[v] {
        // the struct dies here and v has its locals (plan_locals)
        if n > 0 {
          g.push(x.args[1])
          g.set_range(g.loc(v) + off, n)
        }
        return
      }
      g.push_part(a, 0, off)
      g.push(x.args[1])
      g.push_part(a, off + n, g.nleaves(at))
      g.def(v)
    }
    Variant => {
      let tag = match x.aux {
        I(n) => n
        _ => 0
      }
      g.e("i64.const ${tag}")
      var used = 0
      for a in x.args {
        let ls = g.leaves(g.vty(a))
        let b = g.loc(a)
        for (k, l) in ls.indexed() {
          g.get(b + k)
          g.to_word(l)
        }
        used += ls.len()
      }
      for _ in used..g.words(t) {
        g.e("i64.const 0")
      }
      g.def(v)
    }
    Tag => {
      g.push_part(x.args[0], 0, 1)
      g.def(v)
    }
    Payload => {
      let (tag, fi) = match x.aux {
        P(a, b) => (a, b)
        _ => (0, 0)
      }
      let a = x.args[0]
      let off = 1 + g.payload_off(g.vty(a), tag, fi)
      let (mp, mo) = g.mem_of(a)
      if mp >= 0 {
        for (k, l) in g.leaves(t).indexed() {
          g.get(mp)
          g.e("i64.load offset=${mo + 8 * (off + k)}")
          g.from_word(l)
        }
        g.def(v)
        return
      }
      let b = g.loc(a)
      for (k, l) in g.leaves(t).indexed() {
        g.get(b + off + k)
        g.from_word(l)
      }
      g.def(v)
    }
    Box => {
      let a = x.args[0]
      let ls = g.leaves(g.vty(a))
      let p = g.loc(v)
      g.e("i32.const ${8 + 8 * ls.len()}")
      g.e("call $alloc")
      g.set(p)
      g.get(p)
      g.e("i32.const 1")
      g.e("i32.store")
      g.store_leaves(p, 8, g.loc(a), ls)
    }
    Unbox => {
      let a = x.args[0]
      g.load_leaves(g.loc(a), 8, g.loc(v), g.leaves(t))
    }
    Closure => g.closure(v)
    Capture => {
      let i = match x.aux {
        I(n) => n
        _ => 0
      }
      var off = 0
      for k in 0..i {
        off += g.nleaves(g.f.captures[k])
      }
      let env = g.loc(x.args[0]) + 1
      g.load_leaves(env, 8 + 8 * off, g.loc(v), g.leaves(t))
    }
    CallValue => {
      let id = g.resume_point()
      var ps: List[Str] = []
      for a in x.args {
        for l in g.leaves(g.vty(a)) {
          ps.push(l)
        }
        g.push(a)
      }
      let s = g.sig(ps, g.leaves(t))
      g.get(g.loc(x.args[0]))
      g.e("call_indirect (type ${s})")
      g.suspend_check(id)
      g.def(v)
      g.check_fault(v)
    }
    Call => g.call(v)
    Fault => {
      g.push(x.args[0])
      g.e(g.locp(v))
      g.e("call $fault_str")
      g.fault_exit(v)
    }
    Retain | Release => {
      let a = x.args[0]
      let at = g.vty(a)
      if g.f.values[a].op == ssa.Op.Const || !g.heap(at) {
        return
      }
      g.push(a)
      let fname = g.rc_fn(if x.op == ssa.Op.Retain { "dup" } else { "drop" }, at)
      g.e("call ${fname}")
    }
    Reuse => {
      let a = x.args[0]
      let at = g.vty(a)
      if g.kind(at) != ssa.Kind.List {
        g.fail("the wasm backend does not reuse `${g.m.types[at].name}`")
        return
      }
      let cp = g.lcopy_fn(at)
      g.push(a)
      g.e("i32.load")
      g.e("i32.const 1")
      g.e("i32.ne")
      g.e("if (result i32)")
      g.push(a)
      g.e("call ${cp}")
      g.e("else")
      g.push(a)
      g.e("end")
      g.def(v)
    }
    Jump => g.edge(x.succs[0], bi)
    Branch => {
      let yes = x.succs[0]
      let no = x.succs[1]
      g.push(x.args[0])
      g.e("if")
      g.edge(yes, bi)
      g.e("else")
      g.edge(no, bi)
      g.e("end")
    }
    Return => {
      // a `var` result passed by reference is stored in its home unless
      // the home holds it; values are read before any home is written
      var stores: List[(Int, Int)] = []
      for (k, a) in x.args.indexed() {
        let h = g.result_home(k)
        if h >= 0 && g.held[a] != h {
          stores.push((h, g.loc(a)))
        }
      }
      for (k, a) in x.args.indexed() {
        if g.result_home(k) < 0 {
          g.push(a)
        }
      }
      for (h, b) in stores {
        g.mem_store(g.hptr[h], 0, b, g.leaves(g.f.values[g.hval[h]].ty))
      }
      g.e("return")
    }
    Unreachable => g.e("unreachable")
    Rebind => {
      // the function value of another code with the same environment
      let name = match x.aux {
        S(s) => s
        _ => ""
      }
      let ci = g.by_name.get(name) ?? -1
      if ci < 0 {
        g.fail("the wasm backend does not rebind to `${name}`")
        return
      }
      g.e("i32.const ${g.table_index("$f${ci}")}")
      g.push_part(x.args[0], 1, 2)
      g.def(v)
    }
    FuncAddr => {
      // a function's table index (task entry points, list drops)
      let name = match x.aux {
        S(s) => s
        _ => ""
      }
      let ci = g.by_name.get(name) ?? -1
      if ci < 0 {
        g.fail("the wasm backend does not take the address of `${name}`")
        return
      }
      g.e("i64.const ${g.table_index("$f${ci}")}")
      g.def(v)
    }
    Drop => g.fail("the wasm backend does not support `${ssa.op_name(x.op)}` (stage 2)")
  }
}

fn (var g: Gen) constant(v: Int) {
  let x = g.f.values[v]
  match x.aux {
    I(n) => {
      if g.kind(x.ty) == ssa.Kind.Float {
        g.e("i64.const ${float_bits(Float(n))}")
        g.e("f64.reinterpret_i64")
      } else {
        g.e("i64.const ${n}")
      }
    }
    F(f) => {
      g.e("i64.const ${float_bits(f)}")
      g.e("f64.reinterpret_i64")
    }
    B(b) => g.e(if b { "i32.const 1" } else { "i32.const 0" })
    S(s) => {
      g.e("i32.const ${g.str_obj(s.bytes())}")
      g.e("i32.const ${s.len()}")
    }
    Bs(b) => {
      g.e("i32.const ${g.str_obj(b)}")
      g.e("i32.const ${b.len()}")
    }
    None | P(..) => {
      if g.nleaves(x.ty) > 0 {
        g.fail("the wasm backend does not support a constant of `${g.m.types[x.ty].name}`")
      }
      return
    }
  }
  g.def(v)
}

fn (var g: Gen) compare(v: Int) {
  let x = g.f.values[v]
  let a = x.args[0]
  let at = g.vty(a)
  let opn = ssa.op_name(x.op)
  match g.kind(at) {
    Int => {
      let ins = if opn is "eq" | "ne" { opn } else { "${opn}_s" }
      g.binop(v, "i64.${ins}")
    }
    Bool => {
      let ins = if opn is "eq" | "ne" { opn } else { "${opn}_u" }
      g.binop(v, "i32.${ins}")
    }
    Float => {
      if opn is "eq" | "ne" {
        g.binop(v, "f64.${opn}")
      } else {
        // the total order (decision 0053): runtime helpers
        g.binop(v, "call $f${opn}")
      }
    }
    Unit => {
      g.e(if opn is "eq" | "le" | "ge" { "i32.const 1" } else { "i32.const 0" })
      g.def(v)
    }
    Str | Struct | Tuple | Enum | List => {
      if !(opn is "eq" | "ne") {
        g.fail("the wasm backend does not order `${g.m.types[at].name}`")
        return
      }
      let fname = g.eq_fn(at)
      g.push(a)
      g.push(x.args[1])
      g.e("call ${fname}")
      if opn == "ne" {
        g.e("i32.eqz")
      }
      g.def(v)
    }
    _ => g.fail("the wasm backend does not compare `${g.m.types[at].name}`")
  }
}

fn (var g: Gen) closure(v: Int) {
  let x = g.f.values[v]
  let name = match x.aux {
    S(s) => s
    _ => ""
  }
  let ci = g.by_name.get(name) ?? -1
  if ci < 0 || !g.m.funcs[ci].indirect {
    g.fail("the wasm backend does not support a closure of `${name}`")
    return
  }
  let idx = g.table_index("$f${ci}")
  let b = g.loc(v)
  g.e("i32.const ${idx}")
  g.set(b)
  if x.args.is_empty() {
    g.e("i32.const 0")
    g.set(b + 1)
    return
  }
  var n = 0
  for a in x.args {
    n += g.nleaves(g.vty(a))
  }
  let drop = g.envdrop_fn(ci)
  let env = b + 1
  g.e("i32.const ${8 + 8 * n}")
  g.e("call $alloc")
  g.set(env)
  g.get(env)
  g.e("i32.const 1")
  g.e("i32.store")
  g.get(env)
  g.e("i32.const ${g.table_index(drop)}")
  g.e("i32.store offset=4")
  var off = 0
  for a in x.args {
    let ls = g.leaves(g.vty(a))
    if !ls.is_empty() {
      g.store_leaves(env, 8 + 8 * off, g.loc(a), ls)
    }
    off += ls.len()
  }
}

/// The smallest Int (math.MinInt64).
const MIN_INT = -9223372036854775807 - 1

/// The IEEE 754 bits of x (math.Float64bits; selfhost/llvm text.xo):
/// halving and doubling are exact, so the exponent and the mantissa are
/// found by scaling. A NaN has the bits of Go's math.NaN().
fn float_bits(x: Float) -> Int {
  if x != x {
    return 0x7FF8000000000001
  }
  var a = x
  var neg = false
  if x < 0.0 || (x == 0.0 && "${x}".starts_with("-")) {
    neg = true
    a = -x
  }
  var bits = 0
  if a == 0.0 {
    bits = 0
  } else if a > 1.7976931348623157e308 {
    bits = 2047 << 52
  } else {
    var e = 0
    while a >= 2.0 {
      a = a / 2.0
      e += 1
    }
    while a < 1.0 && e > -1022 {
      a = a * 2.0
      e -= 1
    }
    if a < 1.0 {
      bits = Int(a * 4503599627370496.0)
    } else {
      bits = ((e + 1023) << 52) | Int((a - 1.0) * 4503599627370496.0)
    }
  }
  if neg {
    return bits | MIN_INT
  }
  bits
}
