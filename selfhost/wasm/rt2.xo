    (func $b64_ok (param $o i32) (param $n i32) (result i32)
      local.get $o
      local.get $n
      i32.const 0
      call $b64_dec
      i32.const 0
      i32.ge_s)

    (func $b64_decode (param $o i32) (param $n i32) (result i32 i32) (local $k i32) (local $s i32)
      local.get $o
      local.get $n
      i32.const 0
      call $b64_dec
      local.tee $k
      i32.const 0
      i32.lt_s
      if
        i32.const ${empty}
        i32.const 0
        return
      end
      local.get $k
      call $rs_new
      local.set $s
      local.get $o
      local.get $n
      local.get $s
      i32.const 8
      i32.add
      call $b64_dec
      drop
      local.get $s
      local.get $k)

    (func $isdig (param $c i32) (result i32)
      local.get $c
      i32.const 48
      i32.sub
      i32.const 10
      i32.lt_u)

    ;; time.ParseDuration of s with its white space trimmed (std/rt
    ;; parseDuration, xo_std.c n_parse_duration): the nanoseconds and
    ;; whether it parsed
    (func $dur_parse (param $o i32) (param $n i32) (result i64 i32)
      (local $t i32) (local $p i32) (local $e i32) (local $i i32) (local $neg i32) (local $d i64) (local $v i64)
      (local $f i64) (local $scale f64) (local $pl i32) (local $pre i32) (local $post i32) (local $pf i32) (local $ovf i32)
      (local $us i32) (local $ul i32) (local $unit i64) (local $c i32) (local $ok i32) (local $y i64) (local $out i64) (local $c1 i32)
      local.get $o
      local.get $n
      i64.const 0
      call $str_trim
      local.set $e
      local.tee $t
      i32.const 8
      i32.add
      local.set $p
      block $ret
        local.get $e
        if
          local.get $p
          i32.load8_u
          local.tee $c
          i32.const 45
          i32.eq
          local.get $c
          i32.const 43
          i32.eq
          i32.or
          if
            local.get $c
            i32.const 45
            i32.eq
            local.set $neg
            i32.const 1
            local.set $i
          end
        end
        local.get $e
        local.get $i
        i32.sub
        i32.const 1
        i32.eq
        if
          local.get $p
          local.get $i
          i32.add
          i32.load8_u
          i32.const 48
          i32.eq
