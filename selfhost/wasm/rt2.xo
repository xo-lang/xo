      local.get $f
      i64.reinterpret_f64)

    (func $float_from_bits (param $b i64) (result f64)
      local.get $b
      f64.reinterpret_i64)

    ;; whether a op b fits an Int (op 0 +, 1 -, 2 *, 3 /)
    (func $int_fits (param $op i64) (param $a i64) (param $b i64) (result i32) (local $r i64)
      local.get $op
      i64.eqz
      if
        local.get $a
        local.get $b
        i64.add
        local.set $r
        local.get $a
        local.get $r
        i64.xor
        local.get $b
        local.get $r
        i64.xor
        i64.and
        i64.const 0
        i64.ge_s
        return
      end
      local.get $op
      i64.const 1
      i64.eq
      if
        local.get $a
        local.get $b
        i64.sub
        local.set $r
        local.get $a
        local.get $b
        i64.xor
        local.get $a
        local.get $r
        i64.xor
        i64.and
        i64.const 0
        i64.ge_s
        return
      end
      local.get $op
      i64.const 2
      i64.eq
      if
        ;; a * b fits when b is 0, or (a * b) / b == a without the one
        ;; overflowing division
        local.get $b
        i64.eqz
        if
          i32.const 1
          return
        end
        local.get $b
        i64.const -1
        i64.eq
        if
          local.get $a
          i64.const 0x8000000000000000
          i64.ne
          return
        end
        local.get $a
        local.get $b
        i64.mul
        local.get $b
        i64.div_s
        local.get $a
        i64.eq
        return
      end
      local.get $b
      i64.eqz
      if
        i32.const 0
        return
      end
      local.get $b
      i64.const -1
      i64.eq
      local.get $a
      i64.const 0x8000000000000000
      i64.eq
      i32.and
      i32.eqz)

    ;; unpadded base64 (RawURLEncoding when url, else RawStdEncoding)
    (func $crypto_b64 (param $o i32) (param $n i32) (param $url i32) (result i32 i32) (local $s i32) (local $k i32) (local $i i32) (local $c i32)
      local.get $o
      local.get $n
      call $b64_encode
      local.set $k
      local.set $s
      ;; drop the padding
      block $x
        loop $l
          local.get $k
          i32.eqz
          br_if $x
          local.get $s
          local.get $k
          i32.add
          i32.load8_u offset=7
          i32.const 61
          i32.ne
          br_if $x
          local.get $k
          i32.const 1
          i32.sub
          local.set $k
          br $l
        end
      end
      local.get $url
      if
        block $x
          loop $l
            local.get $i
            local.get $k
            i32.ge_u
            br_if $x
            local.get $s
            local.get $i
            i32.add
            local.tee $c
            i32.load8_u offset=8
            i32.const 43
            i32.eq
            if
              local.get $c
              i32.const 45
              i32.store8 offset=8
            end
            local.get $c
            i32.load8_u offset=8
            i32.const 47
            i32.eq
            if
              local.get $c
              i32.const 95
              i32.store8 offset=8
            end
            local.get $i
            i32.const 1
            i32.add
            local.set $i
            br $l
          end
        end
      end
      local.get $s
      local.get $k)

    ;; real-time sections (decision 0133): the allocations inside the
    ;; outermost one are counted, and its exit faults when there was one
    ;; (XO-F007); objects are freed at once (one thread, nothing to wait
    ;; for)
    (func $realtime_enter
      global.get $rtdepth
      i32.eqz
      if
        global.get $total
        global.get $rtskip
        i64.sub
        global.set $rtmark
      end
      global.get $rtdepth
      i32.const 1
      i32.add
      global.set $rtdepth)

    (func $realtime_exit (param $p i32) (param $n i32) (param $lo i32) (param $ln i32) (local $k i64) (local $m i32) (local $mn i32)
      global.get $rtdepth
      i32.const 1
      i32.sub
      global.set $rtdepth
      global.get $rtdepth
      i32.const 0
      i32.gt_s
      if
        return
      end
      i32.const 0
      global.set $rtdepth
      global.get $total
      global.get $rtskip
      i64.sub
      global.get $rtmark
      i64.sub
      local.tee $k
      i64.eqz
      if
        return
      end
      i32.const 0
      call $rs_new
      i32.const 0
      ${rt1}
      call $sapp
      local.get $p
      i32.const 8
      i32.add
      local.get $n
      i32.const 128
      local.get $n
      i32.const 128
      i32.lt_u
      select
      call $sapp
      ${rt2}
      call $sapp
      local.get $k
      call $sapp_int
      ${rt3}
      call $sapp
      local.set $mn
      local.set $m
      local.get $k
      i64.const 1
      i64.ne
      if
        local.get $m
        local.get $mn
        i32.const 115
        call $sapp_byte
        local.set $mn
        local.set $m
      end
      local.get $m
      local.get $mn
      local.get $lo
      i32.const 8
      i32.add
      local.get $ln
      call $fault_set)

    ;; the value of hex digit c (either case), or -1
    (func $hexv (param $c i32) (result i32)
      local.get $c
      i32.const 48
      i32.sub
      i32.const 10
      i32.lt_u
      if
        local.get $c
        i32.const 48
        i32.sub
        return
      end
      local.get $c
      i32.const 32
      i32.or
      i32.const 97
      i32.sub
      i32.const 6
      i32.lt_u
      if
        local.get $c
        i32.const 32
        i32.or
        i32.const 87
        i32.sub
        return
      end
      i32.const -1)

    ;; whether s is hexadecimal that hex.DecodeString accepts
    (func $bytes_hex_ok (param $o i32) (param $n i32) (result i32) (local $i i32)
      local.get $n
      i32.const 1
      i32.and
      if
        i32.const 0
        return
      end
      block $x
        loop $l
          local.get $i
          local.get $n
          i32.ge_u
          br_if $x
          local.get $o
          local.get $i
          i32.add
          i32.load8_u offset=8
          call $hexv
          i32.const 0
          i32.lt_s
          if
            i32.const 0
            return
          end
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $l
        end
      end
      i32.const 1)

    ;; the bytes of hexadecimal that bytes_hex_ok accepted
    (func $bytes_from_hex (param $o i32) (param $n i32) (result i32 i32) (local $s i32) (local $i i32) (local $k i32)
      local.get $n
      i32.const 1
      i32.shr_u
      local.tee $k
      call $rs_new
      local.set $s
      block $x
        loop $l
          local.get $i
          local.get $k
          i32.ge_u
          br_if $x
          local.get $s
          local.get $i
          i32.add
          local.get $o
          local.get $i
          i32.const 1
          i32.shl
          i32.add
          local.tee $n
          i32.load8_u offset=8
          call $hexv
          i32.const 4
          i32.shl
          local.get $n
          i32.load8_u offset=9
          call $hexv
          i32.or
          i32.store8 offset=8
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $l
        end
      end
      local.get $s
      local.get $k)

    ;; the k digits of v at p (zero padded)
    (func $putd (param $p i32) (param $v i64) (param $k i32)
      block $x
        loop $l
          local.get $k
          i32.eqz
          br_if $x
          local.get $k
          i32.const 1
          i32.sub
          local.tee $k
          local.get $p
          i32.add
          local.get $v
          i64.const 10
          i64.rem_u
          i32.wrap_i64
          i32.const 48
          i32.add
          i32.store8
          local.get $v
          i64.const 10
          i64.div_u
          local.set $v
          br $l
        end
      end)

    ;; s + the text of a Time, RFC 3339 in UTC with the nanoseconds
    ;; trimmed (xo_std.c n_fmt_time; the civil date by Howard Hinnant's
    ;; algorithm); years 0 to 9999
    (func $rs_append_time (param $a i32) (param $an i32) (param $t i64) (result i32 i32)
      (local $secs i64) (local $ns i64) (local $days i64) (local $rem i64) (local $z i64) (local $era i64) (local $doe i64)
      (local $yoe i64) (local $y i64) (local $doy i64) (local $mp i64) (local $d i64) (local $m i64) (local $k i32) (local $fl i32)
      local.get $t
      i64.const 1000000000
      i64.div_s
      local.set $secs
      local.get $t
      i64.const 1000000000
      i64.rem_s
      local.tee $ns
      i64.const 0
      i64.lt_s
      if
        local.get $ns
        i64.const 1000000000
        i64.add
        local.set $ns
        local.get $secs
        i64.const 1
        i64.sub
        local.set $secs
      end
      local.get $secs
      i64.const 86400
      i64.div_s
      local.set $days
      local.get $secs
      i64.const 86400
      i64.rem_s
      local.tee $rem
      i64.const 0
      i64.lt_s
      if
        local.get $rem
        i64.const 86400
        i64.add
        local.set $rem
        local.get $days
        i64.const 1
        i64.sub
        local.set $days
      end
      local.get $days
      i64.const 719468
      i64.add
      local.tee $z
      local.get $z
      i64.const 146096
      i64.sub
      local.get $z
      i64.const 0
      i64.ge_s
      select
      i64.const 146097
      i64.div_s
      local.set $era
      local.get $z
      local.get $era
      i64.const 146097
      i64.mul
      i64.sub
      local.set $doe
      local.get $doe
      local.get $doe
      i64.const 1460
      i64.div_s
      i64.sub
      local.get $doe
      i64.const 36524
      i64.div_s
      i64.add
      local.get $doe
      i64.const 146096
      i64.div_s
      i64.sub
      i64.const 365
      i64.div_s
      local.set $yoe
      local.get $yoe
      local.get $era
      i64.const 400
      i64.mul
      i64.add
      local.set $y
      local.get $doe
      local.get $yoe
      i64.const 365
      i64.mul
      local.get $yoe
      i64.const 4
      i64.div_s
      i64.add
      local.get $yoe
      i64.const 100
      i64.div_s
      i64.sub
      i64.sub
      local.set $doy
      local.get $doy
      i64.const 5
      i64.mul
      i64.const 2
      i64.add
      i64.const 153
      i64.div_s
      local.set $mp
      local.get $doy
      local.get $mp
      i64.const 153
      i64.mul
      i64.const 2
      i64.add
      i64.const 5
      i64.div_s
      i64.sub
      i64.const 1
      i64.add
      local.set $d
      local.get $mp
      i64.const 3
      i64.add
      local.get $mp
      i64.const 9
      i64.sub
      local.get $mp
      i64.const 10
      i64.lt_s
      select
      local.tee $m
      i64.const 2
      i64.le_s
      if
        local.get $y
        i64.const 1
        i64.add
        local.set $y
      end
      ;; YYYY-MM-DDTHH:MM:SS at 1984
      i32.const 1984
      local.get $y
      i32.const 4
      call $putd
      i32.const 1988
      i32.const 45
      i32.store8
      i32.const 1989
      local.get $m
      i32.const 2
      call $putd
      i32.const 1991
      i32.const 45
      i32.store8
      i32.const 1992
      local.get $d
      i32.const 2
      call $putd
      i32.const 1994
      i32.const 84
      i32.store8
      i32.const 1995
      local.get $rem
      i64.const 3600
      i64.div_s
      i32.const 2
      call $putd
      i32.const 1997
      i32.const 58
      i32.store8
      i32.const 1998
      local.get $rem
      i64.const 60
      i64.div_s
      i64.const 60
      i64.rem_s
      i32.const 2
      call $putd
      i32.const 2000
      i32.const 58
      i32.store8
      i32.const 2001
      local.get $rem
      i64.const 60
      i64.rem_s
      i32.const 2
      call $putd
      i32.const 19
      local.set $k
      local.get $ns
      i64.eqz
      i32.eqz
      if
        i32.const 2003
        i32.const 46
        i32.store8
        i32.const 2004
        local.get $ns
        i32.const 9
        call $putd
        i32.const 9
        local.set $fl
        block $x
          loop $l
            local.get $fl
            i32.const 2003
            i32.add
            i32.load8_u
            i32.const 48
            i32.ne
            br_if $x
            local.get $fl
            i32.const 1
            i32.sub
            local.set $fl
            br $l
          end
        end
        i32.const 20
        local.get $fl
        i32.add
        local.set $k
      end
      local.get $k
      i32.const 1984
      i32.add
      i32.const 90
      i32.store8
      local.get $a
      local.get $an
      i32.const 1984
      local.get $k
      i32.const 1
      i32.add
      call $sapp)
  """
}

/// The runtime functions of rt2.xo called with the operands' leaves under
/// their std/llrt names (rt.<name> is $<name>).
fn rt2_direct(name: Str) -> Bool {
  name is "rs_append_time" | "bytes_hex_ok" | "bytes_from_hex" | "floor_div" | "int_wrap" | "int_fits" | "crypto_b64" | "realtime_enter" | "realtime_exit" | "rand_int" | "rand_float" | "rand_bool" | "rand_bytes" | "duration_parse_ok" | "duration_parse" | "str_byte" | "bytes_span" | "rs_append_bytes" | "rune_is_space" | "utf8_valid" | "bytes_decode" | "bytes_rune_count" | "int_parse_ok" | "int_parse" | "str_of_byte" | "str_replace" | "b64_encode" | "b64_ok" | "b64_decode" | "u64_mul_hi" | "float_bits" | "float_from_bits" | "bytes_word" | "mem_load" | "mem_store" | "mem_copy" | "mem_move" | "mem_set" | "mem_cmp" | "popcount" | "ctz" | "clz" | "bytes_eq16" | "bytes_high16" | "rs_put_word" | "rs_set_len"
}
