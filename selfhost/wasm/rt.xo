    (func $str_contains (param $o i32) (param $n i32) (param $q i32) (param $m i32) (result i32) (local $i i32)
      block $x
        loop $l
          local.get $i
          local.get $m
          i32.add
          local.get $n
          i32.gt_u
          br_if $x
          local.get $o
