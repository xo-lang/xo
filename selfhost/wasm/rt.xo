          local.get $s
          local.get $n
          local.get $e
          i32.load
          i32.const 8
          i32.add
          local.get $e
          i32.load offset=8
          call $sapp
          local.set $n
          local.set $s
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $lp
        end
      end
      local.get $s
      local.get $n)

    ;; whether the byte at p continues a UTF-8 sequence
    (func $cont (param $p i32) (result i32)
      local.get $p
      i32.load8_u
      i32.const 192
      i32.and
      i32.const 128
      i32.eq)

    ;; the size of the valid UTF-8 sequence of at least two bytes at p (n
    ;; bytes left), 0 when invalid (Go's utf8.DecodeRune)
    (func $utf8_size (param $p i32) (param $n i32) (result i32) (local $b0 i32) (local $b1 i32) (local $lo i32) (local $hi i32)
      local.get $p
      i32.load8_u
      local.set $b0
      local.get $b0
      i32.const 194
      i32.lt_u
      local.get $b0
      i32.const 245
      i32.ge_u
      i32.or
      local.get $n
      i32.const 2
      i32.lt_u
      i32.or
      if
        i32.const 0
        return
      end
      local.get $p
      i32.load8_u offset=1
      local.set $b1
      local.get $b0
      i32.const 224
      i32.lt_u
      if
        local.get $p
        i32.const 1
        i32.add
        call $cont
        i32.const 1
        i32.shl
        return
      end
      i32.const 128
      local.set $lo
      i32.const 191
      local.set $hi
      local.get $b0
      i32.const 224
      i32.eq
      if
        i32.const 160
        local.set $lo
      end
      local.get $b0
      i32.const 237
      i32.eq
      if
        i32.const 159
        local.set $hi
      end
      local.get $b0
      i32.const 240
      i32.eq
      if
        i32.const 144
        local.set $lo
      end
      local.get $b0
      i32.const 244
      i32.eq
      if
        i32.const 143
        local.set $hi
      end
      local.get $b1
      local.get $lo
      i32.lt_u
      local.get $b1
      local.get $hi
      i32.gt_u
      i32.or
      local.get $n
      i32.const 3
      i32.lt_u
      i32.or
      if
        i32.const 0
        return
      end
      local.get $p
      i32.const 2
      i32.add
      call $cont
      i32.eqz
      if
        i32.const 0
        return
      end
      local.get $b0
      i32.const 240
      i32.lt_u
      if
        i32.const 3
        return
      end
      local.get $n
      i32.const 4
      i32.lt_u
      if
        i32.const 0
        return
      end
      local.get $p
      i32.const 3
      i32.add
      call $cont
      i32.const 2
      i32.shl)

    (func $str_rune_count (param $o i32) (param $n i32) (result i64) (local $i i32) (local $c i64) (local $sz i32) (local $p i32)
      block $x
        loop $l
          local.get $i
          local.get $n
          i32.ge_u
          br_if $x
          i32.const 1
          local.set $sz
          local.get $o
          i32.const 8
          i32.add
          local.get $i
          i32.add
          local.tee $p
          i32.load8_u
          i32.const 128
          i32.ge_u
          if
            local.get $p
            local.get $n
            local.get $i
            i32.sub
            call $utf8_size
            local.tee $sz
            i32.eqz
            if
              i32.const 1
              local.set $sz
            end
          end
          local.get $i
          local.get $sz
          i32.add
          local.set $i
          local.get $c
          i64.const 1
          i64.add
          local.set $c
          br $l
        end
      end
      local.get $c)

    (func $hexd (param $d i32) (result i32)
      local.get $d
      i32.const 48
      i32.add
      local.get $d
      i32.const 87
      i32.add
      local.get $d
      i32.const 10
      i32.lt_u
      select)

    ;; a + b in double quotes with the escapes of Debug of a Str
    ;; (xo_rs_append_quote; consumes a, borrows b)
    (func $rs_append_quote (param $a i32) (param $an i32) (param $b i32) (param $bn i32) (result i32 i32)
      (local $i i32) (local $c i32) (local $sz i32) (local $p i32)
      local.get $a
      local.get $an
      i32.const 34
      call $sapp_byte
      local.set $an
      local.set $a
      block $x
        loop $l
          local.get $i
          local.get $bn
          i32.ge_u
          br_if $x
          local.get $b
          i32.const 8
          i32.add
          local.get $i
          i32.add
          local.tee $p
          i32.load8_u
          local.set $c
          i32.const 1
          local.set $sz
          block $done
            local.get $c
            i32.const 128
            i32.ge_u
            if
              local.get $p
              local.get $bn
              local.get $i
              i32.sub
              call $utf8_size
              local.tee $sz
              i32.eqz
              local.get $sz
              i32.const 3
              i32.eq
              local.get $c
              i32.const 239
              i32.eq
              i32.and
              local.get $p
              i32.load8_u offset=1
              i32.const 191
              i32.eq
              i32.and
              local.get $p
              i32.load8_u offset=2
              i32.const 189
              i32.eq
              i32.and
              i32.or
              if
                local.get $sz
                i32.eqz
                if
                  i32.const 1
                  local.set $sz
                end
                local.get $a
                local.get $an
                ${fffd}
                call $sapp
                local.set $an
                local.set $a
                br $done
              end
              local.get $a
              local.get $an
              local.get $p
              local.get $sz
              call $sapp
              local.set $an
              local.set $a
              br $done
            end
            local.get $c
            i32.const 34
            i32.eq
            local.get $c
            i32.const 92
            i32.eq
            i32.or
            if
              local.get $a
              local.get $an
              i32.const 92
              call $sapp_byte
              local.get $c
              call $sapp_byte
              local.set $an
              local.set $a
              br $done
            end
            local.get $c
            i32.const 10
            i32.eq
            local.get $c
            i32.const 9
            i32.eq
            i32.or
            local.get $c
            i32.const 13
            i32.eq
            i32.or
            local.get $c
            i32.eqz
            i32.or
            if
              local.get $a
              local.get $an
              i32.const 92
              call $sapp_byte
              i32.const 110
              local.set $p
              local.get $c
              i32.const 9
              i32.eq
              if
                i32.const 116
                local.set $p
              end
              local.get $c
              i32.const 13
              i32.eq
              if
                i32.const 114
                local.set $p
              end
              local.get $c
              i32.eqz
              if
                i32.const 48
                local.set $p
              end
              local.get $p
              call $sapp_byte
              local.set $an
              local.set $a
              br $done
            end
            local.get $c
            i32.const 32
            i32.lt_u
            local.get $c
            i32.const 127
            i32.eq
            i32.or
            if
              local.get $a
              local.get $an
              i32.const 92
              call $sapp_byte
              i32.const 120
              call $sapp_byte
              local.get $c
              i32.const 4
              i32.shr_u
              call $hexd
              call $sapp_byte
              local.get $c
              i32.const 15
              i32.and
              call $hexd
              call $sapp_byte
              local.set $an
              local.set $a
              br $done
            end
            local.get $a
            local.get $an
            local.get $c
            call $sapp_byte
            local.set $an
            local.set $a
          end
          local.get $i
          local.get $sz
          i32.add
          local.set $i
          br $l
        end
      end
      local.get $a
      local.get $an
      i32.const 34
      call $sapp_byte)

    (func $elem (param $p i32) (param $i i64) (param $es i32) (result i32)
      local.get $p
      i32.const 16
      i32.add
      local.get $i
      i32.wrap_i64
      local.get $es
      i32.mul
      i32.add)

    (func $idx_chk (param $p i32) (param $i i64) (param $es i32) (param $lp i32) (param $ln i32) (result i32)
      local.get $i
      local.get $p
      i32.load offset=4
      i64.extend_i32_u
      i64.ge_u
      if
        local.get $i
        local.get $p
        i32.load offset=4
        i64.extend_i32_u
        i32.const 0
        local.get $lp
        local.get $ln
        call $fault_index
        i32.const 0
        return
      end
      local.get $p
      local.get $i
      local.get $es
      call $elem)

  """
}
