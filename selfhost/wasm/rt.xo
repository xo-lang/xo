            local.get $c
            i32.const 10
            i32.eq
            local.get $c
            i32.const 9
            i32.eq
            i32.or
            local.get $c
            i32.const 13
            i32.eq
            i32.or
            local.get $c
            i32.eqz
            i32.or
            if
              local.get $a
              local.get $an
              i32.const 92
              call $sapp_byte
              i32.const 110
              local.set $p
              local.get $c
              i32.const 9
              i32.eq
              if
                i32.const 116
                local.set $p
              end
              local.get $c
              i32.const 13
              i32.eq
              if
                i32.const 114
                local.set $p
              end
              local.get $c
              i32.eqz
              if
                i32.const 48
                local.set $p
              end
              local.get $p
              call $sapp_byte
              local.set $an
              local.set $a
              br $done
            end
            local.get $c
            i32.const 32
            i32.lt_u
            local.get $c
            i32.const 127
            i32.eq
            i32.or
            if
              local.get $a
              local.get $an
              i32.const 92
              call $sapp_byte
              i32.const 120
              call $sapp_byte
              local.get $c
              i32.const 4
              i32.shr_u
              call $hexd
              call $sapp_byte
              local.get $c
              i32.const 15
              i32.and
              call $hexd
              call $sapp_byte
              local.set $an
              local.set $a
              br $done
            end
            local.get $a
            local.get $an
            local.get $c
            call $sapp_byte
            local.set $an
            local.set $a
          end
          local.get $i
          local.get $sz
          i32.add
          local.set $i
          br $l
        end
      end
      local.get $a
      local.get $an
      i32.const 34
      call $sapp_byte)

    (func $elem (param $p i32) (param $i i64) (param $es i32) (result i32)
      local.get $p
      i32.const 16
      i32.add
      local.get $i
      i32.wrap_i64
      local.get $es
      i32.mul
      i32.add)

    (func $idx_chk (param $p i32) (param $i i64) (param $es i32) (param $lp i32) (param $ln i32) (result i32)
      local.get $i
      local.get $p
      i32.load offset=4
      i64.extend_i32_u
      i64.ge_u
      if
        local.get $i
        local.get $p
        i32.load offset=4
        i64.extend_i32_u
        i32.const 0
        local.get $lp
        local.get $ln
        call $fault_index
        i32.const 0
        return
      end
      local.get $p
      local.get $i
      local.get $es
      call $elem)

  """
}
