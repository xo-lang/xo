      i32.or
      local.get $r
      i32.const 8192
      i32.ge_u
      local.get $r
      i32.const 8202
      i32.le_u
      i32.and
      i32.or)

    ;; whether the rune at p (n bytes left) is a space: its size, else 0
    (func $space_at (param $p i32) (param $n i32) (result i32) (local $sz i32)
      local.get $p
      i32.load8_u
      i32.const 128
      i32.lt_u
      if
        local.get $p
        i32.load8_u
        call $is_space
        return
      end
      local.get $p
      local.get $n
      call $utf8_size
      local.tee $sz
      i32.eqz
      if
        i32.const 0
        return
      end
      local.get $p
      local.get $sz
      call $utf8_rune
      call $is_space
      if
        local.get $sz
        return
      end
      i32.const 0)

    ;; strings.TrimSpace (mode 0), TrimLeftFunc (1), TrimRightFunc (2)
    ;; with unicode.IsSpace
    (func $str_trim (param $o i32) (param $n i32) (param $mode i64) (result i32 i32) (local $p i32) (local $lo i32) (local $hi i32) (local $st i32) (local $sz i32)
      local.get $o
      i32.const 8
      i32.add
      local.set $p
      local.get $n
      local.set $hi
      local.get $mode
      i64.const 2
      i64.ne
      if
        block $x
          loop $l
            local.get $lo
            local.get $hi
            i32.ge_u
            br_if $x
            local.get $p
            local.get $lo
            i32.add
            local.get $hi
            local.get $lo
            i32.sub
            call $space_at
            local.tee $sz
            i32.eqz
            br_if $x
            local.get $lo
            local.get $sz
            i32.add
            local.set $lo
            br $l
          end
        end
      end
      local.get $mode
      i64.const 1
      i64.ne
      if
        block $x
          loop $l
            local.get $hi
            local.get $lo
            i32.le_u
            br_if $x
            ;; the rune ending at hi
            local.get $hi
            i32.const 1
            i32.sub
            local.set $st
            block $y
              loop $m
                local.get $st
                local.get $lo
                i32.gt_u
                local.get $hi
                local.get $st
                i32.sub
                i32.const 4
                i32.lt_u
                i32.and
                local.get $p
                local.get $st
                i32.add
                call $cont
                i32.and
                i32.eqz
                br_if $y
                local.get $st
                i32.const 1
                i32.sub
                local.set $st
                br $m
              end
            end
            local.get $p
            local.get $st
            i32.add
            local.get $hi
            local.get $st
            i32.sub
            call $space_at
            local.tee $sz
            i32.eqz
            br_if $x
            local.get $st
            local.get $sz
            i32.add
            local.get $hi
            i32.ne
            br_if $x
            local.get $st
            local.set $hi
            br $l
          end
        end
      end
      i32.const 0
      call $rs_new
      i32.const 0
      local.get $p
      local.get $lo
      i32.add
      local.get $hi
      local.get $lo
      i32.sub
      call $sapp)

    (func $bytes_hex (param $o i32) (param $n i32) (result i32 i32) (local $s i32) (local $i i32) (local $c i32)
      local.get $n
      i32.const 1
      i32.shl
      call $rs_new
      local.set $s
      block $x
        loop $l
          local.get $i
          local.get $n
          i32.ge_u
          br_if $x
          local.get $o
          local.get $i
          i32.add
          i32.load8_u offset=8
          local.set $c
          local.get $s
          local.get $i
          i32.const 1
          i32.shl
          i32.add
          local.get $c
          i32.const 4
          i32.shr_u
          call $hexd
          i32.store8 offset=8
          local.get $s
          local.get $i
          i32.const 1
          i32.shl
          i32.add
          local.get $c
          i32.const 15
          i32.and
          call $hexd
          i32.store8 offset=9
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $l
        end
      end
      local.get $s
      local.get $n
      i32.const 1
      i32.shl)

    ;; env.args(): the arguments after the program name (WASI args_get)
    (func $env_args (result i32) (local $argc i32) (local $argv i32) (local $buf i32) (local $l i32) (local $i i32) (local $p i32) (local $k i32)
      i32.const 0
      i32.const 4
      call $args_sizes_get
      drop
      i32.const 0
      i32.load
      local.set $argc
      local.get $argc
      i32.const 2
      i32.shl
      i32.const 4
      i32.add
      call $alloc
      local.set $argv
      i32.const 4
      i32.load
      i32.const 1
      i32.add
      call $alloc
      local.set $buf
      local.get $argv
      local.get $buf
      call $args_get
      drop
      local.get $argc
      i32.const 16
      call $rl_new_n
      local.set $l
      i32.const 1
      local.set $i
      block $x
        loop $lp
          local.get $i
          local.get $argc
          i32.ge_u
          br_if $x
          local.get $argv
          local.get $i
          i32.const 2
          i32.shl
          i32.add
          i32.load
          local.tee $p
          call $strlen
          local.set $k
          local.get $l
          local.get $p
          local.get $k
          call $list_add_str
          local.set $l
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $lp
        end
      end
      local.get $argv
      call $free
      local.get $buf
      call $free
      local.get $l)

    (func $strlen (param $p i32) (result i32) (local $n i32)
      block $x
        loop $l
          local.get $p
          local.get $n
          i32.add
          i32.load8_u
          i32.eqz
          br_if $x
          local.get $n
          i32.const 1
          i32.add
          local.set $n
          br $l
        end
      end
      local.get $n)

    ;; env.get(name): the value in a list of one, or the empty list
    (func $env_get (param $o i32) (param $n i32) (result i32) (local $c i32) (local $vv i32) (local $buf i32) (local $i i32) (local $p i32) (local $k i32) (local $l i32)
      i32.const 0
      i32.const 4
      call $environ_sizes_get
      drop
      i32.const 0
      i32.load
      local.set $c
      local.get $c
      i32.const 2
      i32.shl
      i32.const 4
      i32.add
      call $alloc
      local.set $vv
      i32.const 4
      i32.load
      i32.const 1
      i32.add
      call $alloc
      local.set $buf
      local.get $vv
      local.get $buf
      call $environ_get
      drop
      i32.const ${empty}
      local.set $l
      block $x
        loop $lp
          local.get $i
          local.get $c
          i32.ge_u
          br_if $x
          local.get $vv
          local.get $i
          i32.const 2
          i32.shl
          i32.add
          i32.load
          local.tee $p
          call $strlen
          local.tee $k
          local.get $n
          i32.gt_u
          if
            local.get $p
            local.get $n
            i32.add
            i32.load8_u
            i32.const 61
            i32.eq
            if
              local.get $p
              local.get $o
              i32.const 8
              i32.add
              local.get $n
              call $mem_at
              if
                i32.const 1
                i32.const 16
                call $rl_new_n
                local.get $p
                local.get $n
                i32.add
                i32.const 1
                i32.add
                local.get $k
                local.get $n
                i32.sub
                i32.const 1
                i32.sub
                call $list_add_str
                local.set $l
                br $x
              end
            end
          end
          local.get $i
          i32.const 1
          i32.add
          local.set $i
          br $lp
        end
      end
      local.get $vv
      call $free
      local.get $buf
      call $free
      local.get $l)

    (func $elem (param $p i32) (param $i i64) (param $es i32) (result i32)
      local.get $p
      i32.const 16
      i32.add
      local.get $i
      i32.wrap_i64
      local.get $es
      i32.mul
      i32.add)

    (func $idx_chk (param $p i32) (param $i i64) (param $es i32) (param $lp i32) (param $ln i32) (result i32)
      local.get $i
      local.get $p
      i32.load offset=4
      i64.extend_i32_u
      i64.ge_u
      if
        local.get $i
        local.get $p
        i32.load offset=4
        i64.extend_i32_u
        i32.const 0
        local.get $lp
        local.get $ln
        call $fault_index
        i32.const 0
        return
      end
      local.get $p
      local.get $i
      local.get $es
      call $elem)

  """
}
