      i64.sub)

    (func $abs_chk (param $a i64) (param $lp i32) (param $ln i32) (result i64)
      local.get $a
      i64.const ${MIN_INT}
      i64.eq
      if
        local.get $a
        local.get $lp
        local.get $ln
        call $fault_abs
        i64.const 0
