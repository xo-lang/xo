    ;; a + b in double quotes with the escapes of Debug of a Str
    ;; (xo_rs_append_quote; consumes a, borrows b)
    (func $rs_append_quote (param $a i32) (param $an i32) (param $b i32) (param $bn i32) (result i32 i32)
      (local $i i32) (local $c i32) (local $sz i32) (local $p i32)
      local.get $a
      local.get $an
      i32.const 34
      call $sapp_byte
      local.set $an
      local.set $a
      block $x
        loop $l
          local.get $i
          local.get $bn
          i32.ge_u
          br_if $x
          local.get $b
          i32.const 8
          i32.add
          local.get $i
          i32.add
          local.tee $p
          i32.load8_u
          local.set $c
          i32.const 1
          local.set $sz
          block $done
            local.get $c
            i32.const 128
            i32.ge_u
            if
              local.get $p
              local.get $bn
              local.get $i
              i32.sub
              call $utf8_size
              local.tee $sz
              i32.eqz
              local.get $sz
              i32.const 3
              i32.eq
              local.get $c
              i32.const 239
              i32.eq
              i32.and
              local.get $p
              i32.load8_u offset=1
              i32.const 191
              i32.eq
              i32.and
              local.get $p
              i32.load8_u offset=2
              i32.const 189
              i32.eq
              i32.and
              i32.or
              if
                local.get $sz
                i32.eqz
                if
                  i32.const 1
                  local.set $sz
                end
                local.get $a
                local.get $an
                ${fffd}
                call $sapp
                local.set $an
                local.set $a
                br $done
              end
              local.get $a
              local.get $an
              local.get $p
              local.get $sz
              call $sapp
              local.set $an
              local.set $a
              br $done
            end
