    (func $shl_chk (param $a i64) (param $b i64) (param $lp i32) (param $ln i32) (result i64) (local $r i64)
      local.get $b
      i64.const 64
      i64.ge_u
      if
        local.get $b
        local.get $lp
        local.get $ln
        call $fault_shift
