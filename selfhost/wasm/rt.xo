      call $sapp)

    ;; whether the m bytes at q are at p
    (func $mem_at (param $p i32) (param $q i32) (param $m i32) (result i32) (local $i i32)
      block $x
        loop $l
          local.get $i
          local.get $m
          i32.ge_u
          br_if $x
          local.get $p
          local.get $i
          i32.add
          i32.load8_u
          local.get $q
          local.get $i
          i32.add
          i32.load8_u
          i32.ne
