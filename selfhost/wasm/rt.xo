    ;; lists: an object {rc, len, cap, pad, elements}
    (func $rl_new (param $cap i32) (param $es i32) (result i32) (local $p i32)
      local.get $cap
      local.get $es
      i32.mul
      i32.const 16
      i32.add
      call $alloc
      local.tee $p
      i32.const 1
      i32.store
      local.get $p
      i32.const 0
      i32.store offset=4
      local.get $p
      local.get $cap
      i32.store offset=8
      local.get $p)

    (func $rl_new_n (param $n i32) (param $es i32) (result i32)
      local.get $n
      i32.const 4
      local.get $n
      i32.const 4
      i32.gt_s
      select
      local.get $es
      call $rl_new)

    ;; doubles the capacity of a unique full list
    (func $rl_grow (param $p i32) (param $es i32) (result i32) (local $cap i32) (local $q i32)
      local.get $p
      i32.load offset=8
      i32.const 1
      i32.shl
      local.tee $cap
      i32.const 4
      local.get $cap
      i32.const 4
      i32.gt_u
      select
      local.tee $cap
      local.get $es
      i32.mul
      i32.const 16
      i32.add
      call $alloc
      local.tee $q
      local.get $p
      local.get $p
      i32.load offset=4
      local.get $es
      i32.mul
      i32.const 16
      i32.add
      memory.copy
      local.get $q
      local.get $cap
      i32.store offset=8
      local.get $p
      call $free
      local.get $q)

    ;; room for one more element of a unique list: the list (grown when
    ;; full, its length counted) and the address of the new slot
    (func $rl_slot (param $p i32) (param $es i32) (result i32 i32) (local $n i32)
      local.get $p
      i32.load offset=4
      local.tee $n
      local.get $p
      i32.load offset=8
      i32.eq
      if
        local.get $p
        local.get $es
        call $rl_grow
        local.set $p
      end
      local.get $p
      local.get $n
      i32.const 1
      i32.add
      i32.store offset=4
      local.get $p
      local.get $p
      i32.const 16
      i32.add
      local.get $n
      local.get $es
      i32.mul
      i32.add)

    ;; the prelude's Str operations (std/llrt xo_std.c): operands are
    ;; borrowed, a Str result is new
    (func $str_slice (param $o i32) (param $n i32) (param $lo i64) (param $hi i64) (result i32 i32)
      local.get $lo
      i64.const 0
      i64.lt_s
