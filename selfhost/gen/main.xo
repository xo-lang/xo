// xogen: the self hosted Go code generator's command line (decision
// 0167).
//
//   gen [--std=DIR] [--wd=DIR] [--each] [--test] [--no-mono] [--no-ranges]
//       [--no-arenas] [--release] [--no-error-args] <dirs...>
//
// It checks the directories as `xo build` does for the Go backend
// (selfhost/check, not in native mode) and prints the files the
// generator writes, sorted by path, each after `== file <path>`, with
// the text of each package before internal/gen's last step (blank uses,
// repeated //line directives, gofmt), then `== skipped` and one line per
// declaration left out (`<file> <declaration>: <why>`). A run the
// checker rejects prints `== rejected`; one the checker cannot check
// (`use go`) `== unsupported <why>`; one the generator fails on `== error
// <why>`. --prep applies that last step but gofmt to the text of each
// package (format_prep, goblank.xo) and prints `== prepped` first.
// --each generates every directory as a run of its own, each
// preceded by `=== gen <dir>`. --wd is the working directory relative
// paths are relative to (default $PWD).

use github.com/xo-lang/xo/selfhost/check

fn dump_body(os: Os, args: List[Str]) ! {
  var each = false
  var prep = false
  var opts = Opts{arenas: true}
  var std_dir = "std"
  var wd = os.env.get("PWD") ?? ""
  var dirs: List[Str] = []
  for a in args {
    if a.starts_with("--std=") {
      std_dir = a.trim_prefix("--std=")
    } else if a.starts_with("--wd=") {
      wd = a.trim_prefix("--wd=")
    } else if a == "--each" {
      each = true
    } else if a == "--prep" {
      prep = true
    } else if a.starts_with("--prep-check=") {
      // debugging: where format_prep fails to parse a Go file
      let src = os.fs.read_text(a.trim_prefix("--prep-check="))?
      os.stdio.println(blank_parse_error(src))
      return
    } else if a == "--test" {
      opts.test_mode = true
    } else if a == "--no-mono" {
      opts.no_mono = true
    } else if a == "--no-ranges" {
      opts.no_ranges = true
    } else if a == "--no-arenas" {
      opts.arenas = false
    } else if a == "--release" {
      opts.release = true
    } else if a == "--no-error-args" {
      opts.no_error_args = true
    } else {
      dirs.push(a)
    }
  }
  if dirs.is_empty() {
    os.stdio.eprintln("usage: gen [--std=DIR] [--wd=DIR] [--each] [--test] [--no-mono] [--no-ranges] [--no-arenas] <dirs...>")
    os.proc.exit(2)
  }
  opts.wd = wd
  let modcache = os.env.get("XO_MODCACHE") ?? ""
  let home = os.env.get("HOME") ?? ""
  let xdg = os.env.get("XDG_CACHE_HOME") ?? ""
  let offline = os.env.get("XO_OFFLINE") ?? ""
  let work = os.env.get("XO_WORK") ?? ""
  let cbind = os.env.get("XO_CBIND_DIR") ?? ""
  var runs: List[List[Str]] = [dirs]
  if each {
    runs = []
    for d in dirs {
      runs.push([d])
    }
  }
  for r in runs {
    os.stdio.print(run_one(os, r, each, prep, opts, std_dir, wd, [modcache, home, xdg, offline, work, cbind]))
  }
}

/// What one run prints.
fn run_one(os: Os, r: List[Str], each: Bool, prep: Bool, opts: Opts, std_dir: Str, wd: Str, env: List[Str]) -> Str uses fs.read {
  var out = ""
  if each {
    out = "=== gen ${r[0]}\n"
  }
  var c = check.new_checker(os.fs, std_dir)
  c.set_mod_env(wd, env[0], env[1], env[2], env[3], env[4])
  c.cbind_dir = env[5]
  match c.check_dirs(r) {
    Ok(_) => {}
    Err(e) => return out + "== error ${e}\n"
  }
  if !c.unsupported.is_empty() {
    return out + "== unsupported ${c.unsupported}\n"
  }
  if rejected(c, opts.holes) {
    return out + "== rejected\n"
  }
  var o = opts
  o.line_root = line_root(os, wd, r[0])
  o.gc = gc_text(os, o.line_root)
  let prog = generate(c, o)
  if !prog.err.is_empty() {
    return out + "== error ${prog.err.replace("\n", " ")}\n"
  }
  var b = StrBuilder.new()
  b.write(out)
  if prep {
    b.write("== prepped\n")
  }
  for f in prog.files.sort_by(fn(f: GFile) -> Str { f.path }) {
    b.write("== file ${f.path}\n")
    if prep && f.path.starts_with("m/") && f.path.ends_with("/xo.go") {
      b.write(format_prep(f.text))
    } else {
      b.write(f.text)
    }
  }
  b.write("== skipped\n")
  for s in prog.skipped {
    b.write(s + "\n")
  }
  b.freeze()
}

/// Whether the checker reported an error (build.go checkOpts): an error,
/// or a hole without --holes.
fn rejected(c: check.Checker, holes: Bool) -> Bool {
  for d in c.diags {
    if !d.warning || (d.code == "XO0900" && !holes) {
      return true
    }
  }
  false
}

/// The directory //line paths are relative to (internal/build
/// lineRoot): the nearest directory holding xo.mod at or above dir, else
/// dir itself, absolute.
fn line_root(os: Os, wd: Str, dir: Str) -> Str {
  var abs = dir
  if !abs.starts_with("/") {
    abs = "${wd}/${abs}"
  }
  abs = clean_path(abs)
  var d = abs
  while true {
    if os.fs.exists("${d}/xo.mod").ok() ?? false {
      return d
    }
    if d == "/" {
      break
    }
    let i = last_slash(d)
    let parent = if i <= 0 { "/" } else { d.bytes()[0..i].to_str() ?? "/" }
    if parent == d {
      break
    }
    d = parent
  }
  abs
}

fn last_slash(s: Str) -> Int {
  let bs = s.bytes()
  var i = bs.len() - 1
  while i >= 0 {
    if bs[i] == '/' {
      return i
    }
    i -= 1
  }
  -1
}

/// The `gc` lines of the xo.mod at root as the statement main runs
/// (gcConfig, decision 0065), "" for none.
fn gc_text(os: Os, root: Str) -> Str {
  let text = match os.fs.read_text("${root}/xo.mod") {
    Ok(t) => t
    Err(_) => return ""
  }
  var percent = -1
  var min_heap = -1
  var limit = -1
  for l in text.lines() {
    let fs = fields(l)
    if fs.len() != 3 || fs[0] != "gc" {
      continue
    }
    if fs[1] == "percent" {
      percent = if fs[2] == "off" { -2 } else { Int.parse(fs[2]) ?? -1 }
    } else if fs[1] == "min_heap" {
      min_heap = byte_size(fs[2])
    } else if fs[1] == "memory_limit" {
      limit = byte_size(fs[2])
    }
  }
  if percent == -1 && min_heap == -1 && limit == -1 {
    return ""
  }
  if percent == 0 && min_heap == 0 && limit == 0 {
    return ""
  }
  "rt.GCConfig(${percent}, ${min_heap}, ${limit}); "
}

fn fields(l: Str) -> List[Str] {
  var out: List[Str] = []
  for p in l.replace("\t", " ").split(" ") {
    if !p.is_empty() {
      out.push(p)
    }
  }
  out
}

/// A byte size with an optional unit (parseByteSize), -1 when invalid.
fn byte_size(s: Str) -> Int {
  for (suf, n) in [("KiB", 1024), ("MiB", 1048576), ("GiB", 1073741824), ("TiB", 1099511627776), ("KB", 1000), ("MB", 1000000), ("GB", 1000000000), ("TB", 1000000000000), ("B", 1)] {
    if s.ends_with(suf) {
      return (Int.parse(s.trim_suffix(suf)) ?? -1) * n
    }
  }
  Int.parse(s) ?? -1
}

/// dump_main is this component's command line with args, for `xo dev
/// dump` (decision 0209) as for the component's own binary; the exit
/// status.
pub fn dump_main(os: Os, args: List[Str]) -> Int uses (clock, env, fs.read, fs.write, proc, stdio) {
  match dump_body(os, args) {
    Ok(_) => 0
    Err(e) => {
      os.stdio.eprintln("${e.debug()}")
      1
    }
  }
}

fn main(os: Os) {
  os.proc.exit(dump_main(os, os.env.args()))
}
