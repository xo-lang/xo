// Calls (fromssa.go call and rtCall): of functions of the module, of
// the operations lowered inline (lists, strings, numbers, Stdio), and of
// the task runtime (`rt.name` is the C function xo_name, decision 0068).

use github.com/xo-lang/xo/selfhost/ssa

/// The object, data pointer, and length of a Str (strParts).
fn (var g: Gen) str_parts(x: Str) -> (Str, Str, Str) {
  let obj = g.def("extractvalue %xo.str ${x}, 0")
  let data = g.def("getelementptr i8, ptr ${obj}, i64 16")
  let n = g.def("extractvalue %xo.str ${x}, 1")
  (obj, data, n)
}

fn (var g: Gen) mk_str(v: Int, obj: Str, n: Str) {
  let t = g.def("insertvalue %xo.str undef, ptr ${obj}, 0")
  g.set(v, "insertvalue %xo.str ${t}, i64 ${n}, 1")
}

/// Lowers call v (call).
fn (var g: Gen) call(v: Int) {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  let args = x.args
  let vt = x.ty
  // the alias scopes of a list access (decision 0211, noalias.xo)
  let md = g.sc_md(v)
  let callee = g.by_name.get(name) ?? -1
  if callee >= 0 {
    g.user_call(v, callee)
    return
  }
  if name == "rt.landing" {
    // a check only a fault takes: never true here; the landing pads
    // enter its first successor (decision 0085)
    g.alias(v, "false")
    return
  }
  if name.starts_with("rt.") {
    g.rt_call(v)
    return
  }
  match name {
    "list.new" => {
      let et = g.m.types[vt].elems[0]
      if args.len() == 1 {
        // with room for a number of elements
        let a0 = g.op(args[0])
        // obj.xo's export, with no C level
        let r = g.def("call i64 @xo_x_obj_rl_new_n(i64 ${a0}, i64 ${g.size(et)}) #6")
        g.set(v, "inttoptr i64 ${r} to ptr")
        return
      }
      // the shared empty list, immortal: the first push allocates
      // (xo_rl_grow), as on arm64
      g.alias(v, g.empty_list())
    }
    "list.len" => {
      let a0 = g.op(args[0])
      let n = g.list_len(a0, md)
      g.alias(v, n)
    }
    "list.index" => {
      let et = vt
      if !x.pos.is_empty() {
        let a0 = g.op(args[0])
        let n = g.list_len(a0, md)
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let l = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n}, i64 ptrtoint (ptr ${l} to i64))")
      }
      let a0 = g.op(args[0])
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, a0, a1)
      if g.kind(et) == ssa.Kind.Unit {
        return
      }
      if g.is_agg(et) && g.root_borrowed(args[0]) {
        g.addr[v] = p
      }
      let l = g.ll(et)
      g.set(v, "load ${l}, ptr ${p}${TBAA_ELEM}${md}")
    }
    "list.take" => {
      // element i moves out (decision 0169); its slot gets a
      // placeholder that releasing ignores until list.set stores back
      let et = g.m.types[vt].elems[1]
      let l = g.op(args[0])
      if !x.pos.is_empty() {
        let n = g.list_len(l, md)
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let lc = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n}, i64 ptrtoint (ptr ${lc} to i64))")
      }
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, l, a1)
      let el = g.ll(et)
      let ev = g.def("load ${el}, ptr ${p}${TBAA_ELEM}${md}")
      let el2 = g.ll(et)
      let h = g.hole(et)
      g.emit("store ${el2} ${h}, ptr ${p}${TBAA_ELEM}${md}")
      let rt = g.ll(vt)
      let t = g.def("insertvalue ${rt} undef, ptr ${l}, 0")
      let el3 = g.ll(et)
      g.set(v, "insertvalue ${rt} ${t}, ${el3} ${ev}, 1")
    }
    "list.get" => {
      let ot = vt
      let et = g.m.types[g.vty(args[0])].elems[0]
      let some = g.m.variant_index(ot, "Some")
      let none = g.m.variant_index(ot, "None")
      let a0 = g.op(args[0])
      let n = g.list_len(a0, md)
      let a1 = g.op(args[1])
      let inr = g.def("icmp ult i64 ${a1}, ${n}")
      let yes = g.new_label("get")
      let no = g.new_label("none")
      let end = g.new_label("gend")
      g.emit("br i1 ${inr}, label %${yes}, label %${no}")
      g.start(yes)
      let b0 = g.op(args[0])
      let b1 = g.op(args[1])
      let p = g.elem_ptr(et, b0, b1)
      var ev = "zeroinitializer"
      if g.kind(et) != ssa.Kind.Unit {
        let l = g.ll(et)
        ev = g.def("load ${l}, ptr ${p}${TBAA_ELEM}${md}")
      }
      let sv = g.variant(ot, some, [ev])
      let yes_end = g.label
      g.emit("br label %${end}")
      g.start(no)
      let nv = g.variant(ot, none, [])
      let no_end = g.label
      g.emit("br label %${end}")
      g.start(end)
      let ol = g.ll(ot)
      g.set(v, "phi ${ol} [ ${sv}, %${yes_end} ], [ ${nv}, %${no_end} ]")
    }
    "list.set" => {
      let et = g.vty(args[2])
      let l = g.op(args[0])
      if !x.pos.is_empty() {
        let n = g.list_len(l, md)
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let lc = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_index(i64 ${b1}, i64 ${n}, i64 ptrtoint (ptr ${lc} to i64))")
      }
      let a1 = g.op(args[1])
      let p = g.elem_ptr(et, l, a1)
      if g.heap(et) {
        let el = g.ll(et)
        let old = g.def("load ${el}, ptr ${p}${TBAA_ELEM}${md}")
        let h = g.rc_fn("drop", et)
        let el2 = g.ll(et)
        g.emit("call void ${h}(${el2} ${old})")
      }
      if g.kind(et) != ssa.Kind.Unit {
        let t2 = g.typed(args[2])
        g.emit("store ${t2}, ptr ${p}${TBAA_ELEM}${md}")
      }
      g.alias(v, l)
    }
    "list.push" => {
      let et = g.vty(args[1])
      let l = g.op(args[0])
      let n = g.list_len(l, md)
      let cp = g.def("getelementptr %xo.rlist, ptr ${l}, i32 0, i32 2")
      let c = g.def("load i64, ptr ${cp}${TBAA_HDR}${md}")
      let full = g.def("icmp eq i64 ${n}, ${c}")
      let from = g.label
      let grow = g.new_label("grow")
      let room = g.new_label("room")
      g.emit("br i1 ${full}, label %${grow}, label %${room}, !prof !0")
      g.start(grow)
      let l2 = g.def("call ptr @xo_rl_grow(ptr ${l}, i64 ${g.size(et)})")
      g.emit("br label %${room}")
      g.start(room)
      let lm = g.def("phi ptr [ ${l}, %${from} ], [ ${l2}, %${grow} ]")
      if g.kind(et) != ssa.Kind.Unit {
        let p = g.elem_ptr(et, lm, n)
        let t1 = g.typed(args[1])
        g.emit("store ${t1}, ptr ${p}${TBAA_ELEM}${md}")
      }
      let n1 = g.def("add nuw nsw i64 ${n}, 1")
      let lp = g.def("getelementptr %xo.rlist, ptr ${lm}, i32 0, i32 1")
      g.emit("store i64 ${n1}, ptr ${lp}${TBAA_HDR}${md}")
      g.alias(v, lm)
    }
    "list.pop" => {
      let lt = g.vty(args[0])
      let et = g.m.types[lt].elems[0]
      let ot = g.m.types[vt].elems[1]
      let some = g.m.variant_index(ot, "Some")
      let none = g.m.variant_index(ot, "None")
      let l = g.op(args[0])
      let n = g.list_len(l, md)
      let c = g.def("icmp sgt i64 ${n}, 0")
      let yes = g.new_label("pop")
      let no = g.new_label("empty")
      let end = g.new_label("pend")
      g.emit("br i1 ${c}, label %${yes}, label %${no}")
      g.start(yes)
      let n1 = g.def("sub i64 ${n}, 1")
      let lp = g.def("getelementptr %xo.rlist, ptr ${l}, i32 0, i32 1")
      g.emit("store i64 ${n1}, ptr ${lp}${TBAA_HDR}${md}")
      var ev = "zeroinitializer"
      if g.kind(et) != ssa.Kind.Unit {
        let p = g.elem_ptr(et, l, n1)
        let el = g.ll(et)
        ev = g.def("load ${el}, ptr ${p}${TBAA_ELEM}${md}")
      }
      let sv = g.variant(ot, some, [ev])
      let yes_end = g.label
      g.emit("br label %${end}")
      g.start(no)
      let nv = g.variant(ot, none, [])
      let no_end = g.label
      g.emit("br label %${end}")
      g.start(end)
      let ol = g.ll(ot)
      let o = g.def("phi ${ol} [ ${sv}, %${yes_end} ], [ ${nv}, %${no_end} ]")
      let rt = g.ll(vt)
      let t = g.def("insertvalue ${rt} undef, ptr ${l}, 0")
      let ol2 = g.ll(ot)
      g.set(v, "insertvalue ${rt} ${t}, ${ol2} ${o}, 1")
    }
    "str.concat" => {
      let a0 = g.op(args[0])
      let (ao, _, an) = g.str_parts(a0)
      let a1 = g.op(args[1])
      let (bo, _, bn) = g.str_parts(a1)
      // obj.xo's export, with no C level
      let pa = g.def("ptrtoint ptr ${ao} to i64")
      let pb = g.def("ptrtoint ptr ${bo} to i64")
      let r = g.def("call i64 @xo_x_obj_rs_concat(i64 ${pa}, i64 ${an}, i64 ${pb}, i64 ${bn}) #6")
      let obj = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("add i64 ${an}, ${bn}")
      g.mk_str(v, obj, n)
    }
    "str.concat_int" | "str.concat_float" => {
      let a0 = g.op(args[0])
      let (ao, _, an) = g.str_parts(a0)
      let slot = g.alloca("i64")
      let a1 = g.op(args[1])
      // obj.xo and cabi.xo through their exports, not inlined (the C
      // entries stay for code of earlier compilers)
      let pa = g.def("ptrtoint ptr ${ao} to i64")
      let ps = g.def("ptrtoint ptr ${slot} to i64")
      let r = if name == "str.concat_int" {
        g.def("call i64 @xo_x_obj_rs_concat_int(i64 ${pa}, i64 ${an}, i64 ${a1}, i64 ${ps}) #8")
      } else {
        g.def("call i64 @xo_x_obj_rs_concat_float(i64 ${pa}, i64 ${an}, double ${a1}, i64 ${ps}) #8")
      }
      let obj = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, obj, n)
    }
    "str.eq" => {
      let a0 = g.op(args[0])
      let (_, ad, an) = g.str_parts(a0)
      let a1 = g.op(args[1])
      let (_, bd, bn) = g.str_parts(a1)
      // obj.xo's str_eq, inlined at the call (xo_str_eq stays for code of
      // earlier compilers)
      let pa = g.def("ptrtoint ptr ${ad} to i64")
      let pb = g.def("ptrtoint ptr ${bd} to i64")
      let r = g.def("call i64 @xo_x_obj_str_eq(i64 ${pa}, i64 ${an}, i64 ${pb}, i64 ${bn}) #6")
      g.set(v, "icmp ne i64 ${r}, 0")
    }
    "str.cmp" => {
      let a0 = g.op(args[0])
      let (_, ad, an) = g.str_parts(a0)
      let a1 = g.op(args[1])
      let (_, bd, bn) = g.str_parts(a1)
      let pa = g.def("ptrtoint ptr ${ad} to i64")
      let pb = g.def("ptrtoint ptr ${bd} to i64")
      g.set(v, "call i64 @xo_x_obj_str_cmp(i64 ${pa}, i64 ${an}, i64 ${pb}, i64 ${bn}) #6")
    }
    "str.of_int" | "str.of_float" => {
      let slot = g.alloca("i64")
      let (fnn, at) = if name == "str.of_float" { ("@xo_x_obj_rs_of_float", "double") } else { ("@xo_x_obj_rs_of_int", "i64") }
      let a0 = g.op(args[0])
      let ps = g.def("ptrtoint ptr ${slot} to i64")
      let r = g.def("call i64 ${fnn}(${at} ${a0}, i64 ${ps}) #8")
      let obj = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, obj, n)
    }
    "str.of_bool" => {
      let a0 = g.op(args[0])
      let t = g.str_const("true")
      let f = g.str_const("false")
      g.set(v, "select i1 ${a0}, %xo.str ${t}, %xo.str ${f}")
    }
    "Stdio.print" | "Stdio.println" | "Stdio.eprint" | "Stdio.eprintln" => {
      let a1 = g.op(args[1])
      let (_, d, n) = g.str_parts(a1)
      let fnn = "@xo_${name.trim_prefix("Stdio.")}"
      g.emit("call void ${fnn}(ptr ${d}, i64 ${n})")
    }
    "Int.min" | "Int.max" | "Float.min" | "Float.max" => {
      let lt = g.ll(vt)
      if g.kind(vt) == ssa.Kind.Int {
        let a0 = g.op(args[0])
        let a1 = g.op(args[1])
        let c = g.def("icmp slt i64 ${a0}, ${a1}")
        let b0 = g.op(args[0])
        let b1 = g.op(args[1])
        if name.ends_with(".min") {
          g.set(v, "select i1 ${c}, ${lt} ${b0}, ${lt} ${b1}")
        } else {
          g.set(v, "select i1 ${c}, ${lt} ${b1}, ${lt} ${b0}")
        }
        return
      }
      // the total order, the receiver on a tie (std.md 1, decisions/0053):
      // min is `b < a ? b : a`, max `a < b ? b : a`
      if name.ends_with(".min") {
        let a1 = g.op(args[1])
        let a0 = g.op(args[0])
        let o = g.float_order(ssa.Op.Lt, a1, a0)
        let c = g.def(o)
        let b1 = g.op(args[1])
        let b0 = g.op(args[0])
        g.set(v, "select i1 ${c}, double ${b1}, double ${b0}")
      } else {
        let a0 = g.op(args[0])
        let a1 = g.op(args[1])
        let o = g.float_order(ssa.Op.Lt, a0, a1)
        let c = g.def(o)
        let b1 = g.op(args[1])
        let b0 = g.op(args[0])
        g.set(v, "select i1 ${c}, double ${b1}, double ${b0}")
      }
    }
    "Int.abs" => {
      if !x.pos.is_empty() {
        let a0 = g.op(args[0])
        let bad = g.def("icmp eq i64 ${a0}, ${IMMORTAL}")
        let b0 = g.op(args[0])
        let l = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_abs(i64 ${b0}, i64 ptrtoint (ptr ${l} to i64))")
      }
      let a0 = g.op(args[0])
      let neg = g.def("icmp slt i64 ${a0}, 0")
      let b0 = g.op(args[0])
      let m = g.def("sub nsw i64 0, ${b0}")
      let c0 = g.op(args[0])
      g.set(v, "select i1 ${neg}, i64 ${m}, i64 ${c0}")
    }
    "Float.sqrt" | "Float.floor" | "Float.ceil" | "Float.trunc" | "Float.round" | "Float.abs" => {
      var intr = name.trim_prefix("Float.")
      if intr == "abs" {
        intr = "fabs"
      }
      let a0 = g.op(args[0])
      g.set(v, "call double @llvm.${intr}.f64(double ${a0})")
    }
    "Float.is_nan" => {
      let a0 = g.op(args[0])
      let b0 = g.op(args[0])
      g.set(v, "fcmp uno double ${a0}, ${b0}")
    }
    "bytes.index" => {
      // b[i] on Bytes (decision 0081)
      let a0 = g.op(args[0])
      let (_, d, n) = g.str_parts(a0)
      if !x.pos.is_empty() {
        let a1 = g.op(args[1])
        let bad = g.def("icmp uge i64 ${a1}, ${n}")
        let b1 = g.op(args[1])
        let l = g.loc(v)
        g.fault_if(bad, "@xo_x_fault_raise_bytes_index(i64 ${b1}, i64 ${n}, i64 ptrtoint (ptr ${l} to i64))")
      }
      let a1 = g.op(args[1])
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${a1}")
      let c = g.def("load i8, ptr ${p}${md}")
      g.set(v, "zext i8 ${c} to i64")
    }
    "Str.len" => {
      let a0 = g.op(args[0])
      g.set(v, "extractvalue %xo.str ${a0}, 1")
    }
    "Str.is_empty" => {
      let a0 = g.op(args[0])
      let n = g.def("extractvalue %xo.str ${a0}, 1")
      g.set(v, "icmp eq i64 ${n}, 0")
    }
    _ => g.fail("the SSA lowering does not support the runtime call `${name}`")
  }
}

/// A call of function callee of the module (call's first part): struct
/// and enum arguments of 256 bytes or more by reference (decision 0145),
/// passed in place when they sit in memory nothing writes during the
/// call (0147), and the results of `var` parameters by reference read
/// back.
fn (var g: Gen) user_call(v: Int, callee: Int) {
  let x = g.f.values[v]
  let br = g.by_ref_of(callee)
  if !br.is_empty() && g.stage < 2 {
    g.unsupported("a call passing a parameter by reference (decision 0145)")
  }
  var args: List[Str] = []
  var slots: List[Str] = []
  var used: Map[Str, Int] = {}
  // every operand is read before anything is stored: a value held in a
  // memory is loaded before another argument overwrites it
  var st_ts: List[Int] = []
  var st_xs: List[Str] = []
  var st_ps: List[Str] = []
  for (i, a) in x.args.indexed() {
    slots.push("")
    let p = g.addr[a]
    if !p.is_empty() && !br.is_empty() && br[i] && !g.is_var_param(callee, i) {
      // in memory nothing writes during the call: passed as it is
      args.push("ptr ${p}")
      continue
    }
    if !br.is_empty() && br[i] {
      let lt = g.ll(g.vty(a))
      let sl = g.slot(lt, used)
      slots[i] = sl
      args.push("ptr ${sl}")
      let m = g.held_at(v, a)
      if m >= 0 && g.held.mems[m].ptr == sl {
        continue // already in its slot (decision 0148)
      }
      st_ts.push(g.vty(a))
      st_xs.push(g.op(a))
      st_ps.push(sl)
      continue
    }
    args.push(g.typed(a))
  }
  for k in 0..st_ts.len() {
    g.store_ref(st_ts[k], st_xs[k], st_ps[k])
  }
  let rl = g.res_ll(callee)
  var c = "${rl} ${fname(aux_str(x.aux))}(${args.join(", ")})"
  if g.inl.contains(aux_str(x.aux)) {
    c = "${c} #6"
  }
  let kept = g.kept_results(callee)
  let results = g.m.funcs[callee].results
  if kept.len() == results.len() {
    if g.kind(x.ty) == ssa.Kind.Unit {
      g.raise("", c)
      return
    }
    g.raise(vname(v), c)
    return
  }
  // rebuild the results the SSA call has: the `var` parameters passed by
  // reference are read back from their memory
  let r = g.tmp()
  g.raise(r, c)
  let full = g.full_res_ll(callee)
  var cur = "undef"
  var ki = 0
  let vps = g.m.funcs[callee].var_params
  for (k, rt) in results.indexed() {
    var y = ""
    if k > 0 && br[vps[k - 1]] {
      if g.lazy_result(v, k) {
        y = "undef" // read from memory where it is used (decision 0148)
      } else {
        y = g.load_ref(rt, slots[vps[k - 1]])
      }
    } else {
      if g.is_void(rt) {
        y = "zeroinitializer"
      } else if kept.len() == 1 {
        y = r
      } else {
        let rl2 = g.res_ll(callee)
        y = g.def("extractvalue ${rl2} ${r}, ${ki}")
      }
      ki += 1
    }
    let tl = g.ll(rt)
    cur = g.def("insertvalue ${full} ${cur}, ${tl} ${y}, ${k}")
  }
  g.alias(v, cur)
}

/// Whether the runtime call name (`rt.*`) can raise a fault
/// (ssa.RuntimeRaises).
fn runtime_raises(name: Str) -> Bool {
  ssa.faulting_rt(name) || name == "rt.fault_continue"
}

/// The address of the runtime's immortal empty list (xo_rt.c
/// xo_empty_list), declared once.
fn (var g: Gen) empty_list() -> Str {
  g.llvm_decl("@xo_empty_list", "@xo_empty_list = external global [3 x i64]")
  "@xo_empty_list"
}

/// Lowers the runtime intrinsics that are an instruction or two
/// (decision 0193 step 3): rt.int_wrap with a constant op (0 +, 1 -, 2
/// *, 3 << and 4 >> logical by the amount mod 64; decision 0195: 5
/// rotate right mod 64, 6 the low 32 bits rotated right mod 32 and zero
/// extended, 7 the bytes reversed), rt.u64_mul_hi (an i128 multiply), the
/// bits of a Float both ways, and rt.bytes_word (an unchecked load of 8
/// bytes);
/// the scan intrinsics of decision 0201:
/// rt.popcount, rt.ctz, rt.clz (llvm.ctpop, cttz, ctlz), and
/// rt.bytes_eq16 and rt.bytes_high16 (a <16 x i8> compare narrowed to 4
/// bits a byte, which arm64 selects as cmeq and shrn), and the string
/// writes of Bytes.to_hex: rt.rs_put_word (an unchecked store of 8 bytes
/// into a new string with room) and rt.rs_set_len (the same object with a
/// new length); whether v was one (fromssa.go inlineRT).
fn (var g: Gen) inline_rt(v: Int) -> Bool {
  let x = g.f.values[v]
  match aux_str(x.aux) {
    "rt.int_wrap" => {
      let c = g.f.values[x.args[0]]
      if c.op != ssa.Op.Const {
        return false
      }
      let op = match c.aux {
        I(n) => n
        _ => -1
      }
      if op < 0 || op > 7 {
        return false
      }
      let a = g.op(x.args[1])
      var b = g.op(x.args[2])
      if op == 5 {
        g.llvm_decl("@llvm.fshr.i64", "declare i64 @llvm.fshr.i64(i64, i64, i64)")
        g.set(v, "call i64 @llvm.fshr.i64(i64 ${a}, i64 ${a}, i64 ${b})")
        return true
      }
      if op == 6 {
        g.llvm_decl("@llvm.fshr.i32", "declare i32 @llvm.fshr.i32(i32, i32, i32)")
        let x32 = g.def("trunc i64 ${a} to i32")
        let n32 = g.def("trunc i64 ${b} to i32")
        g.set(v, "zext i32 ${g.def("call i32 @llvm.fshr.i32(i32 ${x32}, i32 ${x32}, i32 ${n32})")} to i64")
        return true
      }
      if op == 7 {
        g.llvm_decl("@llvm.bswap.i64", "declare i64 @llvm.bswap.i64(i64)")
        g.set(v, "call i64 @llvm.bswap.i64(i64 ${a})")
        return true
      }
      if op >= 3 {
        b = g.def("and i64 ${b}, 63")
      }
      g.set(v, "${["add", "sub", "mul", "shl", "lshr"][op]} i64 ${a}, ${b}")
    }
    // decision 0222: a value barrier, as BoringSSL's value_barrier_w: an
    // empty asm the optimizer cannot see through, with no side effect
    // (it may still be merged or dropped when unused)
    "rt.ct_barrier" => g.set(v, "call i64 asm \"\", \"=r,0\"(i64 ${g.op(x.args[0])})")
    "rt.u64_mul_hi" => {
      let a = g.def("zext i64 ${g.op(x.args[0])} to i128")
      let b = g.def("zext i64 ${g.op(x.args[1])} to i128")
      let p = g.def("mul i128 ${a}, ${b}")
      g.set(v, "trunc i128 ${g.def("lshr i128 ${p}, 64")} to i64")
    }
    // decision 0231: the carry out of a + b and the borrow out of a - b
    // (std/native/llrt/cpu.xo), which arm64 selects as adds/adcs chains
    "rt.u64_carry" | "rt.u64_borrow" => {
      let f = if aux_str(x.aux) == "rt.u64_carry" { "uadd" } else { "usub" }
      g.llvm_decl("@llvm.${f}.with.overflow.i64", "declare {i64, i1} @llvm.${f}.with.overflow.i64(i64, i64)")
      let r = g.def("call {i64, i1} @llvm.${f}.with.overflow.i64(i64 ${g.op(x.args[0])}, i64 ${g.op(x.args[1])})")
      g.set(v, "zext i1 ${g.def("extractvalue {i64, i1} ${r}, 1")} to i64")
    }
    // decision 0231: the carry-less product's halves and the AES rounds
    // (cpu.xo, run only when cpu.hw() has them) as inline asm, so no
    // target feature is needed on the function; a pure asm, so the two
    // halves of one product share the instruction
    "rt.clmul_lo" | "rt.clmul_hi" => {
      let a = g.def("insertelement <2 x i64> undef, i64 ${g.op(x.args[0])}, i32 0")
      let b = g.def("insertelement <2 x i64> undef, i64 ${g.op(x.args[1])}, i32 0")
      let asm = if g.arch() == "amd64" { "asm \"pclmulqdq $$0, $2, $0\", \"=x,0,x\"" } else { "asm \".arch_extension crypto\\0Apmull $0.1q, $1.1d, $2.1d\", \"=w,w,w\"" }
      let r = g.def("call <2 x i64> ${asm}(<2 x i64> ${a}, <2 x i64> ${b})")
      g.set(v, "extractelement <2 x i64> ${r}, i32 ${if aux_str(x.aux) == "rt.clmul_lo" { 0 } else { 1 }}")
    }
    "rt.aes_round" | "rt.aes_last" => {
      let last = aux_str(x.aux) == "rt.aes_last"
      let p = g.raw_ptr(x.args[0])
      let s = g.def("load <16 x i8>, ptr ${p}, align 1")
      let k = g.def("load <16 x i8>, ptr ${g.raw_ptr(x.args[1])}, align 1")
      var r = ""
      if g.arch() == "amd64" {
        // AESENC's key is after the round: the key xored before, a zero
        // key after (AESENCLAST: the next key)
        let sk = g.def("xor <16 x i8> ${s}, ${k}")
        if last {
          let k2 = g.def("load <16 x i8>, ptr ${g.raw_ptr(x.args[2])}, align 1")
          r = g.def("call <16 x i8> asm \"aesenclast $2, $0\", \"=x,0,x\"(<16 x i8> ${sk}, <16 x i8> ${k2})")
        } else {
          r = g.def("call <16 x i8> asm \"aesenc $2, $0\", \"=x,0,x\"(<16 x i8> ${sk}, <16 x i8> zeroinitializer)")
        }
      } else if last {
        let e = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\", \"=w,0,w\"(<16 x i8> ${s}, <16 x i8> ${k})")
        let k2 = g.def("load <16 x i8>, ptr ${g.raw_ptr(x.args[2])}, align 1")
        r = g.def("xor <16 x i8> ${e}, ${k2}")
      } else {
        r = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\\0Aaesmc $0.16b, $0.16b\", \"=w,0,w\"(<16 x i8> ${s}, <16 x i8> ${k})")
      }
      g.emit("store <16 x i8> ${r}, ptr ${p}, align 1")
    }
    "rt.aes_enc10" | "rt.aes_enc12" | "rt.aes_enc14" => {
      // the whole block unrolled, the state an SSA value (the rounds of
      // rt.aes_round without the loads and stores between them)
      let nr = Int.parse(aux_str(x.aux).trim_prefix("rt.aes_enc")) ?? 10
      let p = g.raw_ptr(x.args[0])
      let kp = g.raw_ptr(x.args[1])
      var ks: List[Str] = []
      for r in 0..nr + 1 {
        let q = g.def("getelementptr i8, ptr ${kp}, i64 ${16 * r}")
        ks.push(g.def("load <16 x i8>, ptr ${q}, align 1"))
      }
      var s = g.def("load <16 x i8>, ptr ${p}, align 1")
      if g.arch() == "amd64" {
        s = g.def("xor <16 x i8> ${s}, ${ks[0]}")
        for r in 1..nr {
          s = g.def("call <16 x i8> asm \"aesenc $2, $0\", \"=x,0,x\"(<16 x i8> ${s}, <16 x i8> ${ks[r]})")
        }
        s = g.def("call <16 x i8> asm \"aesenclast $2, $0\", \"=x,0,x\"(<16 x i8> ${s}, <16 x i8> ${ks[nr]})")
      } else {
        for r in 0..nr - 1 {
          s = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\\0Aaesmc $0.16b, $0.16b\", \"=w,0,w\"(<16 x i8> ${s}, <16 x i8> ${ks[r]})")
        }
        s = g.def("call <16 x i8> asm \".arch_extension crypto\\0Aaese $0.16b, $2.16b\", \"=w,0,w\"(<16 x i8> ${s}, <16 x i8> ${ks[nr - 1]})")
        s = g.def("xor <16 x i8> ${s}, ${ks[nr]}")
      }
      g.emit("store <16 x i8> ${s}, ptr ${p}, align 1")
    }
    "rt.cpuid1_ecx" => {
      if g.arch() == "amd64" {
        let r = g.def("call { i32, i32, i32, i32 } asm \"cpuid\", \"={ax},={bx},={cx},={dx},0,2\"(i32 1, i32 0)")
        g.set(v, "zext i32 ${g.def("extractvalue { i32, i32, i32, i32 } ${r}, 2")} to i64")
      } else {
        g.set(v, "add i64 0, 0")
      }
    }
    // decision 0195: the conversions of UInt64 and Float32
    "rt.u64_to_float" => g.set(v, "uitofp i64 ${g.op(x.args[0])} to double")
    "rt.f32_round" => g.set(v, "fpext float ${g.def("fptrunc double ${g.op(x.args[0])} to float")} to double")
    "rt.i64_to_f32" => g.set(v, "fpext float ${g.def("sitofp i64 ${g.op(x.args[0])} to float")} to double")
    "rt.float_bits" => g.set(v, "bitcast double ${g.op(x.args[0])} to i64")
    "rt.float_from_bits" => g.set(v, "bitcast i64 ${g.op(x.args[0])} to double")
    "rt.bytes_word" => {
      let (_, d, _) = g.str_parts(g.op(x.args[0]))
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      g.set(v, "load i64, ptr ${p}, align 1${g.sc_md(v)}")
    }
    "rt.sys6" => {
      // a Linux system call (decision 0206): inline asm with the number
      // and six arguments in the registers of the target's convention
      var ops: List[Str] = []
      for a in x.args {
        ops.push("i64 ${g.op(a)}")
      }
      let cons = if g.arch() == "amd64" {
        "\"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\""
      } else {
        "\"svc #0\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}\""
      }
      g.set(v, "call i64 asm sideeffect ${cons}(${ops.join(", ")})")
    }
    "rt.sys_restorer" => {
      g.sigreturn()
      g.set(v, "ptrtoint ptr @xo_sigreturn to i64")
    }
    "rt.call_c2" => {
      // a C ABI call of an address (decision 0206 stage 2)
      let p = g.def("inttoptr i64 ${g.op(x.args[0])} to ptr")
      g.set(v, "call i64 ${p}(i64 ${g.op(x.args[1])}, i64 ${g.op(x.args[2])})")
    }
    "rt.sys_words" => {
      // 16 words of process state (decision 0206 stage 2): weak, one
      // object for every module of a split build
      if !g.emitted.contains("@.xo.sys_words") {
        g.emitted["@.xo.sys_words"] = true
        g.helpers.push("@.xo.sys_words = weak global [16 x i64] zeroinitializer, align 8\n\n")
      }
      g.set(v, "ptrtoint ptr @.xo.sys_words to i64")
    }
    "rt.static_word" => {
      // word k of 64 words of process globals (decision 0207, work item
      // B02): weak, one object for every module of a split build
      if !g.emitted.contains("@.xo.static") {
        g.emitted["@.xo.static"] = true
        g.helpers.push("@.xo.static = weak global [64 x i64] zeroinitializer, align 8\n\n")
      }
      let p = g.def("getelementptr [64 x i64], ptr @.xo.static, i64 0, i64 ${g.op(x.args[0])}")
      g.set(v, "ptrtoint ptr ${p} to i64")
    }
    "rt.sys_clone" => {
      g.clone_tramp()
      var ops: List[Str] = []
      for a in x.args {
        ops.push("i64 ${g.op(a)}")
      }
      g.set(v, "call i64 @xo_clone(${ops.join(", ")})")
    }
    // decision 0212 (sched.xo): calls of the switch and the thread
    // locals, defined at the first use
    "rt.stack_switch" => {
      g.sched_switch()
      return false
    }
    "rt.unwind_save" | "rt.unwind_resume" => {
      // calls of the unwinder's trampolines (decision 0221)
      g.unwind_fns()
      return false
    }
    "rt.fiber_start_addr" => {
      g.sched_switch()
      g.set(v, "ptrtoint ptr @xo_fiber_entry to i64")
    }
    "rt.tlocal_get" | "rt.tlocal_set" | "rt.tlocal_addr" => {
      g.sched_tlocal()
      return false
    }
    // the runtime's immortal placeholders: their addresses, no call
    // (xo_rt.c xo_empty_list, xo_zero_handle)
    "rt.rl_empty" => g.alias(v, g.empty_list())
    "rt.h_zero" => {
      g.llvm_decl("@xo_zero_handle", "@xo_zero_handle = external global [2 x i64]")
      g.alias(v, "@xo_zero_handle")
    }
    "rt.popcount" => g.set(v, "call i64 @llvm.ctpop.i64(i64 ${g.op(x.args[0])})")
    "rt.ctz" => g.set(v, "call i64 @llvm.cttz.i64(i64 ${g.op(x.args[0])}, i1 false)")
    "rt.clz" => g.set(v, "call i64 @llvm.ctlz.i64(i64 ${g.op(x.args[0])}, i1 false)")
    "rt.bytes_eq16" | "rt.bytes_high16" => {
      let (_, d, _) = g.str_parts(g.op(x.args[0]))
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      let w = g.def("load <16 x i8>, ptr ${p}, align 1${g.sc_md(v)}")
      var e = ""
      if aux_str(x.aux) == "rt.bytes_eq16" {
        let c = g.def("trunc i64 ${g.op(x.args[2])} to i8")
        var r = g.def("insertelement <16 x i8> poison, i8 ${c}, i64 0")
        r = g.def("shufflevector <16 x i8> ${r}, <16 x i8> poison, <16 x i32> zeroinitializer")
        e = g.def("icmp eq <16 x i8> ${w}, ${r}")
      } else {
        e = g.def("icmp slt <16 x i8> ${w}, zeroinitializer")
      }
      let m = g.def("sext <16 x i1> ${e} to <16 x i8>")
      var h = g.def("bitcast <16 x i8> ${m} to <8 x i16>")
      h = g.def("lshr <8 x i16> ${h}, <i16 4, i16 4, i16 4, i16 4, i16 4, i16 4, i16 4, i16 4>")
      let n = g.def("trunc <8 x i16> ${h} to <8 x i8>")
      g.set(v, "bitcast <8 x i8> ${n} to i64")
    }
    "rt.rs_put_word" => {
      let x0 = g.op(x.args[0])
      let (_, d, _) = g.str_parts(x0)
      let p = g.def("getelementptr i8, ptr ${d}, i64 ${g.op(x.args[1])}")
      g.emit("store i64 ${g.op(x.args[2])}, ptr ${p}, align 1")
      g.alias(v, x0)
    }
    "rt.rs_set_len" => {
      let obj = g.def("extractvalue %xo.str ${g.op(x.args[0])}, 0")
      g.mk_str(v, obj, g.op(x.args[1]))
    }
    "rt.slot_load" | "rt.slot_store" | "rt.slot_swap" | "rt.slot_cas" | "rt.slot_add" | "rt.slot_addr" | "rt.fence" | "rt.spin_hint" => g.atomic(v)
    _ => return g.inline_raw(v)
  }
  true
}

/// The pointer of the address operand a (inlineRaw's ptr).
fn (var g: Gen) raw_ptr(a: Int) -> Str { g.def("inttoptr i64 ${g.op(a)} to ptr") }

/// The pointer of address a plus off (inlineRaw's at).
fn (var g: Gen) raw_at(a: Int, off: Int) -> Str {
  let p = g.raw_ptr(a)
  g.def("getelementptr i8, ptr ${p}, i64 ${g.op(off)}")
}

/// Lowers the raw memory intrinsics (decision 0207, fromssa.go
/// inlineRaw): loads and stores of a constant width at an address,
/// llvm.memcpy, llvm.memmove, llvm.memset, the platform's memcmp, a
/// string with its length set, and an object's address both ways;
/// whether v was one.
fn (var g: Gen) inline_raw(v: Int) -> Bool {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  match name {
    "rt.mem_load" => {
      let w = match g.f.values[x.args[2]].aux {
        I(n) => n
        _ => 8
      }
      let p = g.raw_at(x.args[0], x.args[1])
      if w == 8 {
        g.set(v, "load i64, ptr ${p}, align 1")
      } else {
        let it = "i${8 * w}"
        g.set(v, "zext ${it} ${g.def("load ${it}, ptr ${p}, align 1")} to i64")
      }
    }
    "rt.mem_store" => {
      let w = match g.f.values[x.args[3]].aux {
        I(n) => n
        _ => 8
      }
      let p = g.raw_at(x.args[0], x.args[1])
      let y = g.op(x.args[2])
      if w == 8 {
        g.emit("store i64 ${y}, ptr ${p}, align 1")
      } else {
        let it = "i${8 * w}"
        g.emit("store ${it} ${g.def("trunc i64 ${y} to ${it}")}, ptr ${p}, align 1")
      }
    }
    "rt.mem_copy" | "rt.mem_move" => {
      let f = if name == "rt.mem_move" { "@llvm.memmove.p0.p0.i64" } else { "@llvm.memcpy.p0.p0.i64" }
      g.llvm_decl(f, "declare void ${f}(ptr, ptr, i64, i1)")
      let d = g.raw_ptr(x.args[0])
      let s = g.raw_ptr(x.args[1])
      g.emit("call void ${f}(ptr ${d}, ptr ${s}, i64 ${g.op(x.args[2])}, i1 false)")
    }
    "rt.mem_set" => {
      g.llvm_decl("@llvm.memset.p0.i64", "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
      let d = g.raw_ptr(x.args[0])
      let b = g.def("trunc i64 ${g.op(x.args[1])} to i8")
      g.emit("call void @llvm.memset.p0.i64(ptr ${d}, i8 ${b}, i64 ${g.op(x.args[2])}, i1 false)")
    }
    "rt.prefetch" => {
      // read, high locality, data (decision 0207 stage 3)
      g.llvm_decl("@llvm.prefetch.p0", "declare void @llvm.prefetch.p0(ptr, i32, i32, i32)")
      let p = g.raw_ptr(x.args[0])
      g.emit("call void @llvm.prefetch.p0(ptr ${p}, i32 0, i32 3, i32 1)")
    }
    "rt.mem_cmp" => {
      g.llvm_decl("@memcmp", "declare i32 @memcmp(ptr, ptr, i64)")
      let a = g.raw_ptr(x.args[0])
      let b = g.raw_ptr(x.args[1])
      let r = g.def("call i32 @memcmp(ptr ${a}, ptr ${b}, i64 ${g.op(x.args[2])})")
      g.set(v, "sext i32 ${r} to i64")
    }
    "rt.obj_addr" => {
      var o = g.op(x.args[0])
      if g.m.types[g.vty(x.args[0])].kind == ssa.Kind.Str {
        o = g.def("extractvalue %xo.str ${o}, 0")
      }
      g.set(v, "ptrtoint ptr ${o} to i64")
    }
    "rt.obj_at" => {
      let p = g.raw_ptr(x.args[0])
      g.emit("call void ${g.rc_fn("dup", x.ty)}(ptr ${p})")
      g.alias(v, p)
    }
    _ => return false
  }
  true
}

/// The pause hint of a spin loop on goarch ("" the compiler's own; the
/// predeclared `target` of internal/ssa's build_target.go), as inline
/// asm (spinHintAsm): `yield` on arm64, `pause` on amd64, as the C
/// runtime's spin_relax; "" (nothing) elsewhere.
fn spin_hint_asm(goarch: Str) -> Str {
  var arch = goarch
  if arch.is_empty() {
    arch = match target.arch {
      Arm64 => "arm64"
      Wasm32 => "wasm"
      Amd64 => "amd64"
    }
  }
  match arch {
    "arm64" => "call void asm sideeffect \"yield\", \"\"()"
    "amd64" => "call void asm sideeffect \"pause\", \"\"()"
    _ => ""
  }
}

/// The memory order of argument k of value v (decision 0200; ordArg):
/// its constant 0 relaxed, 1 acquire, 2 release, 3 acq_rel, 4 seq_cst;
/// a value that is not one of them is seq_cst.
fn (var g: Gen) ord_arg(v: Int, k: Int) -> Int {
  let x = g.f.values[v]
  if k >= x.args.len() {
    return 4
  }
  let c = g.f.values[x.args[k]]
  if c.op != ssa.Op.Const {
    return 4
  }
  match c.aux {
    I(n) => if n >= 0 && n <= 4 { n } else { 4 }
    _ => 4
  }
}

/// The address of the cell (container, index) of an atomic: the list's
/// element, or an Atomic's value (the same layout: a header of three
/// words, then words; cellAddr).
fn (var g: Gen) cell_addr(v: Int) -> Str {
  let x = g.f.values[v]
  let l = g.op(x.args[0])
  if g.kind(g.vty(x.args[0])) == ssa.Kind.Int {
    // the address form (decision 0207): word i from the address
    let p = g.def("inttoptr i64 ${l} to ptr")
    let o = g.def("shl i64 ${g.op(x.args[1])}, 3")
    return g.def("getelementptr i8, ptr ${p}, i64 ${o}")
  }
  let c = g.f.values[x.args[1]]
  if c.op == ssa.Op.Const {
    if let I(k) = c.aux {
      return g.def("getelementptr i8, ptr ${l}, i64 ${24 + 8 * k}")
    }
  }
  let o = g.def("shl i64 ${g.op(x.args[1])}, 3")
  let o2 = g.def("add i64 ${o}, 24")
  g.def("getelementptr i8, ptr ${l}, i64 ${o2}")
}

/// The i64 of an Int or Bool operand (a Bool cell holds 0 or 1).
fn (var g: Gen) word_of(a: Int) -> Str {
  let o = g.op(a)
  if g.kind(g.vty(a)) == ssa.Kind.Bool {
    return g.def("zext i1 ${o} to i64")
  }
  o
}

/// Sets v, an Int or a Bool, to the i64 r.
fn (var g: Gen) atomic_result(v: Int, r: Str) {
  if g.kind(g.vty(v)) == ssa.Kind.Bool {
    g.set(v, "icmp ne i64 ${r}, 0")
    return
  }
  g.alias(v, r)
}

/// Lowers the atomics and fences of decision 0200 inline (atomic): load
/// atomic, store atomic, atomicrmw, cmpxchg, and fence with the order's
/// LLVM ordering (relaxed is monotonic; a load takes no release and a
/// store no acquire, and a cmpxchg fails with the strongest ordering
/// allowed there). The spin hint is the target's pause hint as inline
/// asm (spin_hint_asm), as the C runtime's spin_relax.
fn (var g: Gen) atomic(v: Int) {
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  if name == "rt.spin_hint" {
    let asm = spin_hint_asm(g.m.goarch)
    if !asm.is_empty() {
      g.emit(asm)
    }
    return
  }
  if name == "rt.fence" {
    let o = g.ord_arg(v, 0)
    if o > 0 {
      g.emit("fence ${["", "acquire", "release", "acq_rel", "seq_cst"][o]}")
    }
    return
  }
  let p = g.cell_addr(v)
  if name == "rt.slot_addr" {
    g.set(v, "ptrtoint ptr ${p} to i64")
    return
  }
  let o = g.ord_arg(v, x.args.len() - 1)
  let ord = ["monotonic", "acquire", "release", "acq_rel", "seq_cst"][o]
  match name {
    "rt.slot_load" => {
      let lo = if o == 0 { "monotonic" } else if o == 1 { "acquire" } else { "seq_cst" }
      g.atomic_result(v, g.def("load atomic i64, ptr ${p} ${lo}, align 8"))
    }
    "rt.slot_store" => {
      let so = if o == 0 { "monotonic" } else if o == 2 { "release" } else { "seq_cst" }
      g.emit("store atomic i64 ${g.word_of(x.args[2])}, ptr ${p} ${so}, align 8")
    }
    "rt.slot_swap" | "rt.slot_add" => {
      let op = if name == "rt.slot_swap" { "xchg" } else { "add" }
      g.atomic_result(v, g.def("atomicrmw ${op} ptr ${p}, i64 ${g.word_of(x.args[2])} ${ord}, align 8"))
    }
    _ => {
      // rt.slot_cas, strong
      let old = g.word_of(x.args[2])
      let new = g.word_of(x.args[3])
      let fail = ["monotonic", "acquire", "monotonic", "acquire", "seq_cst"][o]
      let r = g.def("cmpxchg ptr ${p}, i64 ${old}, i64 ${new} ${ord} ${fail}, align 8")
      g.set(v, "extractvalue { i64, i1 } ${r}, 1")
    }
  }
}

/// Declares the LLVM intrinsic sym once, among the runtime declarations
/// of the calls used (decision 0195; llvmDecl).
fn (var g: Gen) llvm_decl(sym: Str, decl: Str) {
  if !g.emitted.contains(sym) {
    g.emitted[sym] = true
    g.rt_decls.push("${decl}\n")
  }
}

/// Lowers a call of the task runtime (rtCall): an Int is an i64, a Bool
/// an i64 0 or 1, a List or handle a pointer, a Str its bytes and length;
/// the result is void or one of those.
fn (var g: Gen) rt_call(v: Int) {
  if aux_str(g.f.values[v].aux).starts_with("rt.pc.") {
    g.platform_call(v)
    return
  }
  if g.inline_rt(v) {
    return
  }
  let x = g.f.values[v]
  let name = aux_str(x.aux)
  // the shields and budgets are ctx.xo's and budget.xo's exports,
  // defined in the module (decision 0229): called directly, their
  // pointers passed as Ints, with no declaration
  let export = xo_export(name)
  let sym = if export.is_empty() { "@xo_${name.trim_prefix("rt.")}" } else { "@${export}" }
  // `rt.rs_*` functions take their Str operands as the string object
  // (the first is consumed, decision 0074); the others its bytes
  let obj = name.starts_with("rt.rs_")
  var params: List[Str] = []
  var args: List[Str] = []
  for a in x.args {
    let at = g.vty(a)
    match g.kind(at) {
      Int => {
        params.push("i64")
        args.push("i64 ${g.op(a)}")
      }
      Float => {
        params.push("double")
        args.push("double ${g.op(a)}")
      }
      Bool => {
        params.push("i64")
        let o = g.op(a)
        let z = g.def("zext i1 ${o} to i64")
        args.push("i64 ${z}")
      }
      List | Handle => {
        params.push("ptr")
        args.push("ptr ${g.op(a)}")
      }
      Str => {
        let o0 = g.op(a)
        let (o, d0, n) = g.str_parts(o0)
        let d = if obj { o } else { d0 }
        params.push("ptr")
        params.push("i64")
        args.push("ptr ${d}")
        args.push("i64 ${n}")
      }
      _ => {
        g.fail("the runtime call `${name}` takes a `${g.m.types[at].name}`")
        return
      }
    }
  }
  var ret = "void"
  var slot = ""
  match g.kind(x.ty) {
    Unit => {}
    Int | Bool => ret = "i64"
    Float => ret = "double"
    List | Handle => ret = "ptr"
    Str => {
      // the string object; its length through a pointer
      ret = "ptr"
      slot = g.alloca("i64")
      params.push("ptr")
      args.push("ptr ${slot}")
    }
    _ => {
      g.fail("the runtime call `${name}` returns a `${g.m.types[x.ty].name}`")
      return
    }
  }
  if !export.is_empty() {
    // the exports return Ints: a pointer result comes back through an
    // inttoptr below
    for i in 0..args.len() {
      if args[i].starts_with("ptr ") {
        let p = g.def("ptrtoint ${args[i]} to i64")
        args[i] = "i64 ${p}"
      }
    }
  } else if !g.emitted.contains(sym) && !g.decls.contains(" ${sym}(") {
    g.emitted[sym] = true
    var attr = "#2"
    if runtime_raises(name) {
      attr = "#5" // it raises faults: not nounwind (decision 0085)
    }
    g.rt_decls.push("declare ${ret} ${sym}(${params.join(", ")}) ${attr}\n")
  }
  // the exports that never raise or unwind (heapos.xo's platform calls,
  // anyval.xo) are nounwind and not inlined at the call, as their C
  // forwarders were (declared nounwind, defined in the C object): inlined
  // into the heap's fast paths, the slow paths cost LLVM alloc tasks and
  // strings 1.10 and 1.03 times the instructions (2026-10-15)
  let nounw = if !export.is_empty() && (name.starts_with("rt.heap_") || name is "rt.any_new" | "rt.any_get") { " #8" } else { "" }
  if !export.is_empty() && ret == "ptr" {
    let r = g.tmp()
    g.raise(r, "i64 ${sym}(${args.join(", ")})${nounw}")
    if g.kind(x.ty) == ssa.Kind.Str {
      // obj.xo's builders: the string object, its length in the slot
      let o = g.def("inttoptr i64 ${r} to ptr")
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, o, n)
      return
    }
    if ssa.rt_export_none(name) {
      // 0 for none: the zero handle or the empty list (ssa/exports.xo)
      let p = g.def("inttoptr i64 ${r} to ptr")
      let z = g.def("icmp eq i64 ${r}, 0")
      var none = ""
      if g.kind(x.ty) == ssa.Kind.List {
        none = g.empty_list()
      } else {
        g.llvm_decl("@xo_zero_handle", "@xo_zero_handle = external global [2 x i64]")
        none = "@xo_zero_handle"
      }
      g.set(v, "select i1 ${z}, ptr ${none}, ptr ${p}")
      return
    }
    g.set(v, "inttoptr i64 ${r} to ptr")
    return
  }
  let c = "${ret} ${sym}(${args.join(", ")})${nounw}"
  match g.kind(x.ty) {
    Unit => g.raise("", c)
    Bool => {
      let r = g.tmp()
      g.raise(r, c)
      g.set(v, "icmp ne i64 ${r}, 0")
    }
    Str => {
      let o = g.tmp()
      g.raise(o, c)
      let n = g.def("load i64, ptr ${slot}")
      g.mk_str(v, o, n)
    }
    _ => g.raise(vname(v), c)
  }
}

/// The parts of a platform call's name `rt.pc.<os>.<sym>[/<n>]`
/// (decision 0213): the OS, the C symbol, and the number of fixed
/// parameters of a variadic function (-1 when it is not one).
fn platform_parts(name: Str) -> (Str, Str, Int) {
  let rest = name.trim_prefix("rt.pc.")
  let parts = rest.split(".")
  if parts.len() < 2 {
    return ("", rest, -1)
  }
  let sv = parts[1].split("/")
  var n = -1
  if sv.len() == 2 {
    n = Int.parse(sv[1]) ?? -1
  }
  (parts[0], sv[0], n)
}

/// Lowers a call of a platform library function (decision 0213,
/// std/native/sys_<os>.xo): a call of the bare C symbol, declared with
/// the C types of the declaration (an Int i64, an Int32 or UInt32 i32, a
/// Float double, Bytes the pointer to its data; `...` after the fixed
/// parameters of a variadic function), `dllimport` on Windows. A call
/// for another OS (an arm of a `match` on `target.os` the passes keep)
/// is a trap.
fn (var g: Gen) platform_call(v: Int) {
  let x = g.f.values[v]
  let (os, sym, nfixed) = platform_parts(aux_str(x.aux))
  let rk = g.kind(x.ty)
  if os == "cp" {
    // rt.sym_present (decision 0232): the weak symbol's address against
    // null (a function declaration, so a symbol with a C call
    // declaration too must be declared extern_weak the same way)
    g.llvm_decl("@${sym}", "declare extern_weak void @${sym}()")
    g.set(v, "icmp ne ptr @${sym}, null")
    return
  }
  if os != g.os() && os != "c" && os != "cw" {
    g.llvm_decl("@llvm.trap", "declare void @llvm.trap() cold noreturn nounwind")
    g.emit("call void @llvm.trap()")
    match rk {
      Int => g.alias(v, "0")
      Float => g.alias(v, "0.0")
      _ => {}
    }
    return
  }
  var params: List[Str] = []
  var args: List[Str] = []
  for a in x.args {
    let at = g.vty(a)
    match g.kind(at) {
      Int => {
        if g.m.types[at].bits == 32 {
          params.push("i32")
          args.push("i32 ${g.def("trunc i64 ${g.op(a)} to i32")}")
        } else {
          params.push("i64")
          args.push("i64 ${g.op(a)}")
        }
      }
      Float => {
        params.push("double")
        args.push("double ${g.op(a)}")
      }
      Str => {
        let (_, d, _) = g.str_parts(g.op(a))
        params.push("ptr")
        args.push("ptr ${d}")
      }
      _ => {
        g.fail("the platform call `${sym}` takes a `${g.m.types[at].name}`")
        return
      }
    }
  }
  let i32r = rk == ssa.Kind.Int && g.m.types[x.ty].bits == 32
  var ret = "void"
  match rk {
    Unit => {}
    Int => ret = if i32r { "i32" } else { "i64" }
    Float => ret = "double"
    _ => {
      g.fail("the platform call `${sym}` returns a `${g.m.types[x.ty].name}`")
      return
    }
  }
  var decl_params = params.join(", ")
  var fty = ""
  if nfixed >= 0 && nfixed <= params.len() {
    var fixed: List[Str] = []
    for i in 0..nfixed {
      fixed.push(params[i])
    }
    fixed.push("...")
    decl_params = fixed.join(", ")
    fty = "(${decl_params}) "
  }
  let dll = if os == "windows" { "dllimport " } else if os == "cw" { "extern_weak " } else { "" }
  g.llvm_decl("@${sym}", "declare ${dll}${ret} @${sym}(${decl_params}) nounwind")
  let c = "call ${ret} ${fty}@${sym}(${args.join(", ")})"
  match rk {
    Unit => g.emit(c)
    Int => {
      if i32r {
        let r = g.def(c)
        let ext = if g.m.types[x.ty].unsigned { "zext" } else { "sext" }
        g.set(v, "${ext} i32 ${r} to i64")
      } else {
        g.set(v, c)
      }
    }
    _ => g.set(v, c)
  }
}

/// The Xo export a runtime call name goes to directly (decision 0229:
/// ctx.xo's shields, budget.xo's tick, open, and end, tasks.xo
/// and scopes), or "" for the C
/// runtime's xo_<name>.
fn xo_export(name: Str) -> Str {
  if name is "rt.shield_begin" | "rt.shield_end" | "rt.shield_abort" | "rt.unwinding" {
    return "xo_x_ctx_${name.trim_prefix("rt.")}"
  }
  if name is "rt.sched_hook" | "rt.task_done" | "rt.task_unwound" | "rt.task_await" | "rt.task_result" | "rt.scope_fail_task" | "rt.scope_fail_site" | "rt.scope_group" | "rt.fault_rethrow" | "rt.scope_cancel" | "rt.prog_group_set" | "rt.prog_group_clear" | "rt.prog_group" | "rt.task_spawn" | "rt.scope_open" | "rt.scope_close" | "rt.mutex_new" | "rt.mutex_lock" | "rt.mutex_unlock" | "rt.mutex_rlock" | "rt.mutex_runlock" | "rt.chan_new" | "rt.chan_send" | "rt.chan_recv" | "rt.chan_try_send" | "rt.chan_try_recv" | "rt.chan_close" | "rt.chan_len" | "rt.select_new" | "rt.select_recv" | "rt.select_send" | "rt.select_wait" | "rt.select_take" | "rt.atomic_new" | "rt.const_once" {
    return "xo_x_${name.trim_prefix("rt.")}"
  }
  if name is "rt.tick" | "rt.budget_open" | "rt.budget_end" {
    return "xo_x_budget_${name.trim_prefix("rt.").trim_prefix("budget_")}"
  }
  if name is "rt.fault_raise" | "rt.fault_continue" | "rt.fault_take" | "rt.fault_msg" | "rt.fault_loc" | "rt.fault_detail" | "rt.fault_at" {
    // fault.xo's raise, continue, and record through their exports
    // (xo-fa; the C xo_fault_* stay for code of earlier compilers)
    return "xo_x_${name.trim_prefix("rt.")}"
  }
  if name is "rt.heap_big" | "rt.heap_big_resize" | "rt.heap_big_release" | "rt.heap_grow" | "rt.heap_lock" | "rt.heap_unlock" | "rt.any_new" | "rt.any_get" {
    // heapos.xo's platform calls (B21) and anyval.xo through their
    // exports
    return "xo_x_${name.trim_prefix("rt.")}"
  }
  if name is "rt.rs_append" | "rt.rs_push_byte" | "rt.rs_push_word" | "rt.rs_push_words" | "rt.rs_append_bytes" | "rt.rs_with_cap" {
    // obj.xo's string builders, as on arm64
    return "xo_x_obj_${name.trim_prefix("rt.")}"
  }
  // the net, clock and scope checks, shutdown and real-time sections
  // (ssa/exports.xo, shared with arm64)
  ssa.rt_export(name)
}
