// The command lines (cmd/xo mod.go): flags as Go's flag package parses
// them, the module flags every command takes (--offline, --workspace),
// and the human and JSON output of xo get, xo mod, and xo vendor.

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/cli/cmdhelp

/// The commands of this package, for the driver's dispatch.
pub fn is_command(name: Str) -> Bool {
  name is "get" | "mod" | "vendor" | "publish" | "audit"
}

/// Runs `xo <args>` for a module command (args[0] is the command) in the
/// working directory wd and returns the exit status.
pub fn run(os: Os, wd: Str, args: List[Str]) -> Int uses (fs, net, proc, env, stdio, rand) {
  var c = new_ctx(os, wd)
  let rest = match c.module_flags(args.len() > 0, if args.is_empty() { [] } else { args[1..] }) {
    Ok(r) => r
    Err(e) => {
      os.stdio.eprintln("xo ${args[0]}: ${e}")
      return 2
    }
  }
  match args[0] {
    "get" => c.run_get(rest)
    "mod" => c.run_mod(rest)
    "vendor" => c.run_vendor(rest)
    "publish" => c.run_publish(rest)
    "audit" => c.run_audit(rest)
    _ => {
      os.stdio.eprintln("xo: unknown command ${args[0].quote()}")
      2
    }
  }
}

/// cmd/xo moduleFlags: removes --offline (XO_OFFLINE=1) and
/// --workspace=off|on (XO_WORK=off) before a `--`.
fn (var c: ModCtx) module_flags(has: Bool, args: List[Str]) -> List[Str] ! Str uses fs.read {
  var out: List[Str] = []
  for (i, a) in args.indexed() {
    if a == "--" {
      for j in i..args.len() {
        out.push(args[j])
      }
      break
    }
    if a == "--offline" || a == "-offline" || a == "--offline=true" {
      c.setenv("XO_OFFLINE", "1")
    } else if a == "--offline=false" {
      c.setenv("XO_OFFLINE", "")
    } else if a.starts_with("--workspace=") || a.starts_with("-workspace=") {
      let (_, v, _) = cut(a, "=")
      if v == "off" {
        c.setenv("XO_WORK", "off")
      } else if v == "on" || v == "auto" {
        c.setenv("XO_WORK", "")
      } else {
        return Err("--workspace=${v}: want off or on")
      }
    } else {
      out.push(a)
    }
  }
  Ok(out)
}

// ---------------------------------------------------------------------------
// Flags (Go's flag package)

/// One flag: a string flag with its default, or a bool flag (default
/// false), and its usage text.
struct FlagDef {
  name: Str
  is_bool: Bool = false
  def: Str = ""
  usage: Str
}

fn flag_str(name: Str, def: Str, usage: Str) -> FlagDef {
  FlagDef{name: name, def: def, usage: usage}
}

fn flag_bool(name: Str, usage: Str) -> FlagDef {
  FlagDef{name: name, is_bool: true, usage: usage}
}

/// The flags of one command.
struct FlagSet {
  name: Str
  defs: List[FlagDef] = []
  /// Parsed values: a bool flag is "true" or "false".
  vals: Map[Str, Str] = {}
  /// The arguments after the flags.
  args: List[Str] = []
}

fn (f: FlagSet) def_of(name: Str) -> FlagDef? {
  for d in f.defs {
    if d.name == name {
      return Some(d)
    }
  }
  None
}

fn (f: FlagSet) str(name: Str) -> Str {
  match f.vals.get(name) {
    Some(v) => v
    None => match f.def_of(name) {
      Some(d) => d.def
      None => ""
    }
  }
}

fn (f: FlagSet) on(name: Str) -> Bool {
  (f.vals.get(name) ?? "false") == "true"
}

/// flag.FlagSet.Parse: flags until the first argument that is not one
/// (or `--`); false after printing the error and the usage (exit status
/// 2).
fn (c: ModCtx) parse_flags(var f: FlagSet, args: List[Str]) -> Bool uses stdio {
  var i = 0
  while i < args.len() {
    let a = args[i]
    if a.len() < 2 || !a.starts_with("-") {
      break
    }
    var name = a.trim_prefix("-")
    if name.starts_with("-") {
      name = name.trim_prefix("-")
      if name.is_empty() {
        i += 1
        break
      }
    }
    if name.starts_with("-") || name.starts_with("=") {
      return c.flag_fail(f, "bad flag syntax: ${a}")
    }
    var value = ""
    var has_value = false
    if let Some(eq) = name.find("=") {
      value = name[eq + 1..]
      name = name[..eq]
      has_value = true
    }
    let d = match f.def_of(name) {
      Some(x) => x
      None => {
        if name == "h" || name == "help" {
          c.print_usage(f)
          return false
        }
        return c.flag_fail(f, "flag provided but not defined: -${name}")
      }
    }
    if d.is_bool {
      if has_value {
        let b = match value {
          "1" | "t" | "T" | "TRUE" | "true" | "True" => "true"
          "0" | "f" | "F" | "FALSE" | "false" | "False" => "false"
          _ => return c.flag_fail(f, "invalid boolean value ${value.quote()} for -${name}: parse error")
        }
        f.vals[name] = b
      } else {
        f.vals[name] = "true"
      }
    } else {
      if !has_value {
        if i + 1 >= args.len() {
          return c.flag_fail(f, "flag needs an argument: -${name}")
        }
        i += 1
        value = args[i]
      }
      f.vals[name] = value
    }
    i += 1
  }
  var rest: List[Str] = []
  while i < args.len() {
    rest.push(args[i])
    i += 1
  }
  f.args = rest
  true
}

fn (c: ModCtx) flag_fail(f: FlagSet, msg: Str) -> Bool uses stdio {
  c.os.stdio.eprintln(msg)
  c.print_usage(f)
  false
}

/// flag.UnquoteUsage: the back quoted name in a usage text (removing the
/// quotes), else "string" for a string flag and "" for a bool one.
fn unquote_usage(d: FlagDef) -> (Str, Str) {
  match d.usage.find("`") {
    Some(i) => {
      let rest = d.usage[i + 1..]
      match rest.find("`") {
        Some(j) => {
          let name = rest[..j]
          return (name, d.usage[..i] + name + rest[j + 1..])
        }
        None => {}
      }
    }
    None => {}
  }
  (if d.is_bool { "" } else { "string" }, d.usage)
}

/// The usage message: `Usage of <name>:` and flag.PrintDefaults.
fn (c: ModCtx) print_usage(f: FlagSet) uses stdio {
  let u = cmdhelp.usage_of(f.name)
  if !u.is_empty() {
    // the command's usage (selfhost/cli/cmdhelp)
    c.os.stdio.eprint(u)
    return
  }
  var b = StrBuilder.new()
  b.write("Usage of ${f.name}:\n")
  for d in f.defs.sort_by(fn(x) { x.name }) {
    var line = "  -${d.name}"
    let (name, usage) = unquote_usage(d)
    if !name.is_empty() {
      line = "${line} ${name}"
    }
    if line.len() <= 4 {
      line = "${line}\t"
    } else {
      line = "${line}\n    \t"
    }
    line = line + usage.replace("\n", "\n    \t")
    if !d.is_bool && !d.def.is_empty() {
      line = "${line} (default ${d.def.quote()})"
    }
    b.write("${line}\n")
  }
  c.os.stdio.eprint(b.freeze())
}

// ---------------------------------------------------------------------------
// Output

fn (c: ModCtx) out(s: Str) uses stdio {
  c.os.stdio.print(s)
}

fn (c: ModCtx) print_problems(ps: List[check.Problem]) uses stdio {
  for p in ps {
    c.os.stdio.eprintln(problem_human(p))
  }
}

/// cmd/xo modRootOf: the main module directory for a module command
/// (mod.ModRoot: the nearest xo.mod at or above dir).
fn (c: ModCtx) mod_root_of(dir: Str, cmd: Str) -> Str? uses (fs.read, stdio) {
  var d = c.abs(dir)
  while true {
    if c.exists("${d}/xo.mod") {
      return Some(d)
    }
    if d == "/" {
      break
    }
    d = dir_of(d)
  }
  c.os.stdio.eprintln("xo ${cmd}: no xo.mod in ${dir} or above")
  None
}

fn change_json(ch: Change) -> J {
  var fs: List[(Str, J)] = [("path", J.S(s: ch.path))]
  if !ch.old.is_empty() {
    fs.push(("old", J.S(s: ch.old)))
  }
  if !ch.new.is_empty() {
    fs.push(("new", J.S(s: ch.new)))
  }
  J.O(fields: fs)
}

fn module_json(m: check.DepModule) -> J {
  var fs: List[(Str, J)] = [("path", J.S(s: m.path))]
  if !m.version.is_empty() {
    fs.push(("version", J.S(s: m.version)))
  }
  fs.push(("dir", J.S(s: m.dir)))
  if m.workspace {
    fs.push(("workspace", J.B(b: true)))
  }
  if m.vendored {
    fs.push(("vendored", J.B(b: true)))
  }
  if m.direct {
    fs.push(("direct", J.B(b: true)))
  }
  J.O(fields: fs)
}

/// cmd/xo reportChanges: requirement changes as JSON or as lines; diffs
/// are the API and effect changes of upgraded or downgraded modules.
fn (c: ModCtx) report_changes(changes: List[Change], probs: List[check.Problem], as_json: Bool, diffs: List[ApiChanges]) -> Int uses stdio {
  if as_json {
    var fs: List[(Str, J)] = [("ok", J.B(b: probs.is_empty())), ("changes", J.A(xs: changes.map(change_json)))]
    if !diffs.is_empty() {
      fs.push(("api", J.A(xs: diffs.map(api_changes_json))))
    }
    fs.push(("diagnostics", problems_json(probs)))
    c.out(encode_json(J.O(fields: fs)))
  } else {
    c.print_problems(probs)
    for ch in changes {
      if ch.old.is_empty() {
        c.out("added ${ch.path} ${ch.new}\n")
      } else if ch.new.is_empty() {
        c.out("removed ${ch.path} ${ch.old}\n")
      } else {
        c.out("${ch.path} ${ch.old} => ${ch.new}\n")
      }
    }
    c.print_api_changes(diffs)
  }
  if probs.is_empty() { 0 } else { 1 }
}

/// `xo get [--dir=<dir>] [--json] [-u] [--accept-effects] <path>[@version]...`.
fn (var c: ModCtx) run_get(args: List[Str]) -> Int uses (fs, net, proc, stdio, rand) {
  var fl = FlagSet{name: "get", defs: [flag_str("dir", ".", "a directory of the main module"), flag_bool("json", "print the result as JSON"), flag_bool("u", "upgrade to the latest versions (every requirement when no path is given)"), flag_bool("accept-effects", "record the new versions' effects in xo.lock even when they are wider than the locked ones (decision 0156)")]}
  if !c.parse_flags(fl, args) {
    return 2
  }
  let root = match c.mod_root_of(fl.str("dir"), "get") {
    Some(r) => r
    None => return 2
  }
  var targets = fl.args
  if targets.is_empty() && fl.on("u") {
    let (f0, probs) = c.chk.read_mod_file(root)
    if !probs.is_empty() {
      return c.report_changes([], probs, fl.on("json"), [])
    }
    if let Some(f) = f0 {
      for r in f.reqs {
        targets.push("${r.path}@latest")
      }
    }
  }
  if targets.is_empty() {
    c.os.stdio.eprintln("xo get: no module path given (xo get <path>[@version], or xo get -u)")
    return 2
  }
  var changes: List[Change] = []
  var probs: List[check.Problem] = []
  for a in targets {
    let (cs, ps) = c.get(root, a, fl.on("accept-effects"))
    changes = changes + cs
    probs = probs + ps
    if !ps.is_empty() {
      break
    }
  }
  let diffs = c.upgrade_diffs(root, changes)
  c.report_changes(changes, probs, fl.on("json"), diffs)
}

/// `xo mod tidy|accept-effects|clean|proxy`.
fn (var c: ModCtx) run_mod(args: List[Str]) -> Int uses (fs, net, proc, stdio, rand) {
  if args.is_empty() {
    c.os.stdio.eprintln("xo mod: want a subcommand: tidy, accept-effects, clean, proxy")
    c.os.stdio.eprint(cmdhelp.usage("mod"))
    return 2
  }
  let rest = args[1..]
  match args[0] {
    "tidy" => {
      var fl = FlagSet{name: "mod tidy", defs: dir_json_flags()}
      if !c.parse_flags(fl, rest) {
        return 2
      }
      let root = match c.mod_root_of(fl.str("dir"), "mod tidy") {
        Some(r) => r
        None => return 2
      }
      let (changes, probs) = c.tidy(root)
      c.report_changes(changes, probs, fl.on("json"), [])
    }
    "accept-effects" => c.run_accept_effects(rest)
    "clean" => {
      let dir = c.cache_dir()
      match c.remove_tree(dir) {
        Ok(_) => {}
        Err(e) => {
          c.os.stdio.eprintln("xo mod clean: ${e}")
          return 1
        }
      }
      c.out("removed ${dir}\n")
      0
    }
    "proxy" => c.run_mod_proxy(rest)
    _ => {
      c.os.stdio.eprintln("xo mod: unknown subcommand ${args[0].quote()} (want tidy, accept-effects, clean, or proxy)")
      c.os.stdio.eprint(cmdhelp.usage("mod"))
      2
    }
  }
}

fn effect_change_json(ch: EffectChange) -> J {
  let old = match ch.old {
    Some(o) => jstrs(o)
    None => J.Null
  }
  J.O(fields: [("path", J.S(s: ch.path)), ("old", old), ("new", jstrs(ch.new))])
}

/// `xo mod accept-effects [--dir=<dir>] [--json] [<module path>...]`.
fn (var c: ModCtx) run_accept_effects(args: List[Str]) -> Int uses (fs, net, proc, stdio, rand) {
  var fl = FlagSet{name: "mod accept-effects", defs: dir_json_flags()}
  if !c.parse_flags(fl, args) {
    return 2
  }
  let root = match c.mod_root_of(fl.str("dir"), "mod accept-effects") {
    Some(r) => r
    None => return 2
  }
  let (changes, probs) = c.accept_effects(root, fl.args)
  if fl.on("json") {
    c.out(encode_json(J.O(fields: [("ok", J.B(b: probs.is_empty())), ("effects", J.A(xs: changes.map(effect_change_json))), ("diagnostics", problems_json(probs))])))
  } else {
    c.print_problems(probs)
    for ch in changes {
      let old = match ch.old {
        Some(o) => check.effects_text(o)
        None => "unlocked"
      }
      c.out("${ch.path} effects ${old} => ${check.effects_text(ch.new)}\n")
    }
  }
  if probs.is_empty() { 0 } else { 1 }
}

/// `xo vendor [--dir=<dir>] [--json]`.
fn (var c: ModCtx) run_vendor(args: List[Str]) -> Int uses (fs, net, proc, stdio, rand) {
  var fl = FlagSet{name: "vendor", defs: dir_json_flags()}
  if !c.parse_flags(fl, args) {
    return 2
  }
  let root = match c.mod_root_of(fl.str("dir"), "vendor") {
    Some(r) => r
    None => return 2
  }
  let (mods, probs) = c.vendor(root)
  if fl.on("json") {
    c.out(encode_json(J.O(fields: [("ok", J.B(b: probs.is_empty())), ("modules", J.A(xs: mods.map(module_json))), ("diagnostics", problems_json(probs))])))
  } else {
    c.print_problems(probs)
    for m in mods {
      c.out("vendored ${m.path} ${m.version}\n")
    }
  }
  if probs.is_empty() { 0 } else { 1 }
}

// ---------------------------------------------------------------------------
// API changes of upgrades (cmd/xo publish.go upgradeDiffs)

/// What one requirement change does to the exports and effects of the
/// module (cmd/xo apiChanges).
struct ApiChanges {
  path: Str
  old: Str
  new: Str
  /// The changes, each with whether it breaks callers, as
  /// release.Change.Describe words them.
  changes: List[ApiChange] = []
  above_ceiling: List[Str] = []
}

struct ApiChange {
  text: Str
  breaking: Bool
  json: J
}

fn api_changes_json(a: ApiChanges) -> J {
  var fs: List[(Str, J)] = [("path", J.S(s: a.path)), ("old", J.S(s: a.old)), ("new", J.S(s: a.new)), ("changes", J.A(xs: a.changes.map(fn(ch) { ch.json })))]
  if !a.above_ceiling.is_empty() {
    fs.push(("above_ceiling", jstrs(a.above_ceiling)))
  }
  J.O(fields: fs)
}

/// cmd/xo printAPIChanges.
fn (c: ModCtx) print_api_changes(diffs: List[ApiChanges]) uses stdio {
  for d in diffs {
    c.out("  ${d.path} ${d.old} => ${d.new}:\n")
    if d.changes.is_empty() && d.above_ceiling.is_empty() {
      c.out("    no API or effect changes\n")
      continue
    }
    for ch in d.changes {
      let mark = if ch.breaking { "!" } else { " " }
      c.out("  ${mark} ${ch.text}\n")
    }
    for a in d.above_ceiling {
      c.out("  ! above the effect ceiling: ${a}; calls of it are XO1309\n")
    }
  }
}

/// --dir and --json, as most module commands define them.
fn dir_json_flags() -> List[FlagDef] {
  [flag_str("dir", ".", "a directory of the main module"), flag_bool("json", "print the result as JSON")]
}
