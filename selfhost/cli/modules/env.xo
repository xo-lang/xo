// The module commands in Xo (decision 0178 stage 4): `xo get`, `xo mod
// tidy|accept-effects|clean|proxy`, `xo vendor`, `xo publish`, and `xo
// audit`, ported from cmd/xo (mod.go, publish.go, audit.go),
// internal/mod, and internal/sumdb's client. xo.mod, xo.work, and xo.lock
// are read by selfhost/check (modfile.xo); this package fetches (git, the
// module proxy protocol, the checksum log), resolves (minimal version
// selection), and writes xo.mod, xo.lock, and vendor/ byte for byte as
// internal/mod does.
//
// This file: the environment of a command (the variables internal/mod
// reads, with the overrides of --offline and --workspace) and file system
// paths. Every path here is absolute, as internal/mod's are.

use github.com/xo-lang/xo/selfhost/check

/// The environment of one module command.
pub struct ModCtx {
  os: Os
  /// Reads xo.mod, xo.work, and xo.lock (absolute paths: no working
  /// directory is given to it).
  chk: check.Checker
  /// The working directory, absolute.
  wd: Str
  /// The environment, with the overrides of the module flags.
  env: Map[Str, Str] = {}
  goos: Str = "darwin"
  /// mod locations: Locate answers that needed git, by git location.
  locations: Map[Str, Location] = {}
}

/// A context for a command run in wd with the program's environment.
pub fn new_ctx(os: Os, wd: Str) -> ModCtx uses (env, proc, fs.read) {
  var chk = check.new_checker(os.fs, "std")
  let vars = os.env.vars()
  var c = ModCtx{os: os, chk: chk, wd: clean(wd), env: vars}
  c.goos = host_os(os)
  c.sync()
  c
}

/// Tells the checker the current environment (after a module flag
/// changed it).
fn (var c: ModCtx) sync() uses fs.read {
  c.chk.set_mod_env("", c.cache_dir(), c.getenv("HOME"), "", c.getenv("XO_OFFLINE"), c.getenv("XO_WORK"))
}

fn (c: ModCtx) getenv(name: Str) -> Str {
  c.env.get(name) ?? ""
}

/// Sets (value "" unsets) an environment variable of the command.
fn (var c: ModCtx) setenv(name: Str, value: Str) uses fs.read {
  if value.is_empty() {
    c.env.remove(name)
  } else {
    c.env[name] = value
  }
  c.sync()
}

/// p made absolute against the working directory and cleaned
/// (filepath.Abs).
fn (c: ModCtx) abs(p: Str) -> Str {
  if p.starts_with("/") {
    return clean(p)
  }
  clean("${c.wd}/${p}")
}

/// mod.CacheDir: $XO_MODCACHE, or <user cache dir>/xo/mod.
fn (c: ModCtx) cache_dir() -> Str {
  let d = c.getenv("XO_MODCACHE")
  if !d.is_empty() {
    return c.abs(d)
  }
  let u = c.user_cache_dir()
  if !u.is_empty() {
    return "${u}/xo/mod"
  }
  "/tmp/xo-mod"
}

/// os.UserCacheDir: ~/Library/Caches on macOS; $XDG_CACHE_HOME when it is
/// absolute, else ~/.cache, elsewhere. "" when there is no home.
fn (c: ModCtx) user_cache_dir() -> Str {
  if c.goos != "darwin" {
    let x = c.getenv("XDG_CACHE_HOME")
    if x.starts_with("/") {
      return x
    }
  }
  let home = c.getenv("HOME")
  if home.is_empty() {
    return ""
  }
  if c.goos == "darwin" {
    return "${home}/Library/Caches"
  }
  "${home}/.cache"
}

/// mod.Offline: XO_OFFLINE set (by --offline) and not 0 or false.
fn (c: ModCtx) offline() -> Bool {
  let v = c.getenv("XO_OFFLINE")
  !v.is_empty() && v != "0" && v != "false"
}

/// mod.WorkOff: XO_WORK=off (set by --workspace=off).
fn (c: ModCtx) work_off() -> Bool {
  c.getenv("XO_WORK") == "off"
}

fn host_os(os: Os) -> Str uses proc {
  match os.proc.run("uname", ["-s"]) {
    Ok(r) => {
      if (r.stdout.to_str() ?? "").trim() == "Linux" {
        return "linux"
      }
    }
    Err(_) => {}
  }
  "darwin"
}

// ---------------------------------------------------------------------------
// Paths

/// path.Clean.
fn clean(p: Str) -> Str {
  if p.is_empty() {
    return "."
  }
  let rooted = p.starts_with("/")
  var out: List[Str] = []
  for s in p.split("/") {
    if s.is_empty() || s == "." {
      continue
    }
    if s == ".." {
      if !out.is_empty() && out[out.len() - 1] != ".." {
        out.pop()
        continue
      }
      if rooted {
        continue
      }
    }
    out.push(s)
  }
  let body = out.join("/")
  if rooted {
    return "/${body}"
  }
  if body.is_empty() {
    return "."
  }
  body
}

/// filepath.Join of two parts.
fn join(a: Str, b: Str) -> Str {
  if a.is_empty() {
    return clean(b)
  }
  if b.is_empty() {
    return clean(a)
  }
  clean("${a}/${b}")
}

/// filepath.Dir.
fn dir_of(p: Str) -> Str {
  let c = clean(p)
  match last_index(c, "/") {
    None => "."
    Some(0) => "/"
    Some(i) => c[..i]
  }
}

/// filepath.Base.
fn base_of(p: Str) -> Str {
  let c = clean(p)
  if c == "/" {
    return "/"
  }
  match last_index(c, "/") {
    None => c
    Some(i) => c[i + 1..]
  }
}

/// The byte index of the last sep in s.
fn last_index(s: Str, sep: Str) -> Int? {
  var found: Int? = None
  var from = 0
  while from <= s.len() {
    match s[from..].find(sep) {
      Some(i) => {
        found = Some(from + i)
        from = from + i + 1
      }
      None => return found
    }
  }
  found
}

/// filepath.Rel for a target at or below base (both clean and absolute).
fn rel_below(base: Str, target: Str) -> Str {
  if target == base {
    return "."
  }
  if base == "/" {
    return target.trim_prefix("/")
  }
  target.trim_prefix("${base}/")
}

/// filepath.IsLocal for a slash path: not empty, not absolute, and not
/// leaving its directory.
fn is_local(p: Str) -> Bool {
  if p.is_empty() || p.starts_with("/") {
    return false
  }
  let c = clean(p)
  c != ".." && !c.starts_with("../")
}

/// strings.Cut: the text before and after the first sep, and whether
/// sep was found.
fn cut(s: Str, sep: Str) -> (Str, Str, Bool) {
  match s.find(sep) {
    Some(i) => (s[..i], s[i + sep.len()..], true)
    None => (s, "", false)
  }
}
