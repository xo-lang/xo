// The checks of the other commands (check, vet, doc, query, the LSP, and
// xo1's builds) fetch what the module cache lacks as the Go checker does
// (its loader calls mod.Download, decision 0178 switch point B): the Xo
// checker reads the cache only and lists the versions it missed
// (Checker.missing), so the check runs again after they are fetched.

use github.com/xo-lang/xo/selfhost/check

/// check_dirs of a copy of c0 with every missing module version fetched
/// into the module cache of the environment (mod.Download, from the
/// XO_PROXY sources): a version whose fetch fails is reported as the Go
/// checker reports it (XO1302 with the fetch's error and notes, or the
/// settings' problem). wd is the working directory of the command.
pub fn check_fetching(os: Os, wd: Str, c0: check.Checker, dirs: List[Str]) -> check.Checker ! Str uses (fs, env, net, proc, rand) {
  var probs: Map[Str, check.Problem] = {}
  var round = 0
  while true {
    var c = c0
    c.fetch_problems = probs
    c.check_dirs(dirs)?
    // each round fetches or fails at least one version, so it ends; the
    // bound only guards against a cache that loses what was fetched
    if c.missing_mods.is_empty() || round >= 64 {
      return Ok(c)
    }
    for (p, v) in c.missing_mods {
      var mc = new_ctx(os, if wd.is_empty() { os.env.get("PWD") ?? "." } else { wd })
      match mc.download(p, v) {
        Ok(_) => {}
        Err(pr) => probs["${p}@${v}"] = pr
      }
    }
    round += 1
  }
  Ok(c0)
}
