// The native link (internal/build ccBuild): the C compiler driver
// assembles the program and links it with the C runtime (std/llrt), the
// TLS library when the program uses std/http, and the system libraries,
// trying the macOS SDKs internal/build tries until one links.

/// What every step needs: the host, the std directory, the repository
/// root (std/.. : third_party), and the user cache directory.
struct Ctx {
  goos: Str
  std: Str
  xo: Str
  cache: Str
  // the OS a link targets when it is not goos (an LLVM cross build for
  // Windows, decision 0197); "" for the host
  tgoos: Str = ""
}

/// The OS the link of ctx targets: the host unless a cross build set it.
fn link_os(ctx: Ctx) -> Str {
  if ctx.tgoos.is_empty() { ctx.goos } else { ctx.tgoos }
}

/// ccBuild: compiles and links srcs into bin with cc and flags; returns
/// the compiler's output of the failed link, "" on success. The sources
/// are the program's assembly, the runtime (xo_rt.c), and other C
/// sources; tls says the program calls std/http's runtime.
fn cc_build(os: Os, ctx: Ctx, cc: Str, flags0: List[Str], srcs: List[Str], bin: Str, tls: Bool) -> Str {
  // libraries of `use c` go after the objects (splitLibs)
  var flags: List[Str] = []
  var libs: List[Str] = []
  for f in flags0 {
    if f.starts_with("-l") && f.len() > 2 {
      libs.push(f)
    } else {
      flags.push(f)
    }
  }
  // the C runtime from a release's prebuilt objects when one matches
  // the flags and these sources (decision 0157)
  let rti = runtime_index(srcs, flags)
  var shipped = ("", "")
  if rti >= 0 {
    shipped = shipped_runtime(os, ctx, ctx.std, flags, tls)
  }
  var cands: List[Str] = []
  let memo = sysroot_memo(os, ctx)
  if !memo.is_empty() {
    match os.fs.read_text(memo) {
      Ok(t) => cands.push(t.trim())
      Err(_) => {}
    }
  }
  cands = cands + sysroot_candidates(os, ctx)
  var first = ""
  for root in cands {
    let (out, ok, rt_fail) = try_link(os, ctx, cc, flags, libs, srcs, bin, tls, root, rti, shipped)
    if ok {
      if !memo.is_empty() {
        os.fs.create_dir_all(dir_name(memo)).ignore_err("the memo only saves time")
        os.fs.write(memo, "${root}\n".bytes()).ignore_err("the memo only saves time")
      }
      return ""
    }
    if rt_fail {
      return out + "\n" + rtpack_hint(os, ctx)
    }
    // report an SDK independent failure over an SDK mismatch
    if first.is_empty() || (first.contains("tapi error") && !out.contains("tapi error")) {
      first = out
    }
    // only a link failure is worth another SDK
    if !out.contains("linker command failed") {
      return out
    }
  }
  first
}

/// One link with the SDK root ("" the compiler's default): its output,
/// whether it succeeded, and whether the local compile of the runtime
/// failed. rti is the index of the runtime in srcs (-1 for none), shipped
/// the pack's object and TLS library ("" when none is used).
fn try_link(os: Os, ctx: Ctx, cc: Str, flags: List[Str], libs: List[Str], srcs0: List[Str], bin: Str, tls: Bool,
  root: Str, rti: Int, shipped: (Str, Str)) -> (Str, Bool, Bool) {
  // the C runtime raises faults through the frames of generated code
  // and its own (decision 0085): every frame needs unwind tables
  var args = flags + ["-fexceptions", "-funwind-tables", "-o", bin]
  if !root.is_empty() {
    args = args + ["-isysroot", root]
  }
  var srcs = srcs0
  var tls_link: List[Str] = []
  let (sobj, slib) = shipped
  if !sobj.is_empty() {
    srcs[rti] = sobj
    if tls {
      tls_link = [slib] + tls_system_libs(link_os(ctx))
    }
  } else {
    var tls_compile: List[Str] = []
    if tls {
      // std/http's TLS (decision 0105)
      let t = tls_args(os, ctx, cc, flags, root)
      if !t.err.is_empty() {
        return (t.err, false, false)
      }
      tls_compile = t.compile
      tls_link = t.link
      args = args + t.compile
    }
    // the C runtime compiled once per flags and sources (rtobj.go)
    if rti >= 0 && !rtobj_dir(os, ctx).is_empty() {
      let r = runtime_object(os, ctx, cc, flags, root, tls_compile, srcs[rti])
      if r.failed {
        return (r.out, false, true)
      }
      if !r.obj.is_empty() {
        srcs[rti] = r.obj
      }
    }
  }
  args = args + srcs + tls_link + libs + sys_link_args(link_os(ctx), flags)
  match os.proc.run(cc, args) {
    Ok(r) => {
      let out = (r.stdout.to_str() ?? "") + (r.stderr.to_str() ?? "")
      let ok = r.code == 0
      // with the object cache off the runtime is compiled in the link
      (out, ok, !ok && sobj.is_empty() && rti >= 0 && mentions_runtime(out))
    }
    Err(e) => ("${cc}: ${e}", false, false)
  }
}

/// sysLinkArgs: the system libraries and linker of a native link on goos.
/// Windows (decision 0197): lld-link, which reads the LTO bitcode MSVC's
/// link.exe cannot; the runtime names its import libraries itself
/// (#pragma comment(lib), std/llrt/xo_win.c), and the C library is the
/// MSVC one clang picks; /Brepro makes the link deterministic: lld-link
/// writes a hash of the output in the COFF header's time stamp (and the
/// debug directory) instead of the link time, so a rebuild is byte
/// identical (gotchas/windows-lld-link-time-stamp.md). A Linux link with
/// XO_NOLIBC=1 (the runtime compiled with nolibc_flags) is static with no
/// C library, keeping only the sections the program reaches (decision
/// 0206).
fn sys_link_args(goos: Str, flags: List[Str]) -> List[Str] {
  if goos == "windows" {
    return ["-fuse-ld=lld", "-Wl,/Brepro"]
  }
  if goos == "linux" && flags.contains("-DXO_NOLIBC") {
    return ["-static", "-nostdlib", "-Wl,--gc-sections"]
  }
  ["-lm", "-lpthread"]
}

/// Whether a link for tgoos has no C library: XO_NOLIBC=1 on Linux
/// (decisions 0203, 0206; stage 1 is opt in).
fn nolibc(os: Os, tgoos: Str) -> Bool { tgoos == "linux" && (os.env.get("XO_NOLIBC") ?? "") == "1" }

/// The C compiler flags of the runtime with no C library (decision 0206):
/// std/llrt/xo_nolibc.c defines the C library functions it calls, each
/// function in its own section for --gc-sections; no stack protector or
/// fortified calls (they live in libc), and on arm64 the LSE atomics
/// inline instead of libgcc's outline helpers.
fn nolibc_flags(arch: Str) -> List[Str] {
  var out = ["-DXO_NOLIBC", "-ffunction-sections", "-fdata-sections", "-fno-stack-protector", "-U_FORTIFY_SOURCE"]
  if arch == "arm64" {
    out.push("-mno-outline-atomics")
  }
  out
}

/// rtPackHint: the hint of a failed local compile of the runtime.
fn rtpack_hint(os: Os, ctx: Ctx) -> Str {
  var why = "packs are off (XO_RTPACK=off)"
  if (os.env.get("XO_RTPACK") ?? "") != "off" {
    match load_rtpack(os, ctx, ctx.std) {
      None => why = "no pack root was found"
      Some(p) => why = p.why
    }
  }
  if why.is_empty() {
    why = "the link's flags are not those of a prebuilt variant"
  }
  var install = "install clang or gcc (Debian or Ubuntu: apt-get install clang)"
  if ctx.goos == "darwin" {
    install = "install the Command Line Tools (xcode-select --install)"
  }
  "hint: the C runtime (std/llrt) was compiled locally because no prebuilt runtime matched: ${why}; ${install}, or set XO_RTPACK to the lib/xo/rtpack directory of a release of xo built from the same sources (knowledgebase/decisions/0157-prebuilt-runtime-objects.md)"
}

/// sysrootCandidates: $XO_SYSROOT alone, else (macOS) the default, the
/// SDK xcrun names, Xcode's, and the Command Line Tools' newest first.
fn sysroot_candidates(os: Os, ctx: Ctx) -> List[Str] {
  let env_root = os.env.get("XO_SYSROOT") ?? ""
  if !env_root.is_empty() {
    return [env_root]
  }
  if link_os(ctx) != "darwin" {
    return [""]
  }
  var out = [""]
  match os.proc.run("xcrun", ["--show-sdk-path"]) {
    Ok(r) => {
      if r.code == 0 {
        out.push((r.stdout.to_str() ?? "").trim())
      }
    }
    Err(_) => {}
  }
  out.push("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk")
  let clt = "/Library/Developer/CommandLineTools/SDKs"
  var ms: List[Str] = []
  match os.fs.read_dir(clt) {
    Ok(fis) => {
      for fi in fis {
        if fi.name.starts_with("MacOSX") && fi.name.ends_with(".sdk") {
          ms.push("${clt}/${fi.name}")
        }
      }
    }
    Err(_) => {}
  }
  out + ms.sort().reverse()
}

/// sysrootMemo: the file remembering the SDK that linked last time, ""
/// with $XO_SYSROOT.
fn sysroot_memo(os: Os, ctx: Ctx) -> Str {
  if !(os.env.get("XO_SYSROOT") ?? "").is_empty() || ctx.cache.is_empty() || link_os(ctx) != ctx.goos {
    return ""
  }
  "${ctx.cache}/xo/llvm-sysroot"
}

/// CC: $XO_CC, then cc, then clang, as a path; "" when there is none.
fn find_cc(os: Os) -> Str {
  let c = os.env.get("XO_CC") ?? ""
  if !c.is_empty() {
    return look_path(os, c)
  }
  for n in ["cc", "clang"] {
    let p = look_path(os, n)
    if !p.is_empty() {
      return p
    }
  }
  ""
}

/// The C compiler flags of the runtime's Fs operations, standard input,
/// and Proc.run, when the code calls them (internal/build IOFlags).
fn io_flags(code: Str) -> List[Str] {
  var out: List[Str] = []
  for sym in ["xo_fs_stat", "xo_fs_names", "xo_fs_write", "xo_fs_rename", "xo_fs_remove", "xo_fs_mkdir_all",
    "xo_fs_chtimes", "xo_fs_create_temp", "xo_fs_cwd", "xo_fs_case_sensitive", "xo_fs_canceled", "xo_fs_info",
    "xo_time_of", "xo_time_ns",
    // handles, copies, modes, links, locks (decision 0172)
    "xo_fs_open", "xo_fs_file_", "xo_fs_copy", "xo_fs_perm", "xo_fs_chmod", "xo_fs_symlink", "xo_fs_read_link",
    "xo_fs_lock", "xo_fs_unlock",
    // the system calls under std/native/llrt/fspath.xo (decision 0193 step 6)
    "xo_fs_raw_"] {
    if calls_sym(code, sym) {
      out.push("-DXO_FS")
      break
    }
  }
  for sym in ["xo_stdin_", "xo_tw_set_input", "xo_tw_set_tty", "xo_isatty", "xo_term_width"] {
    if calls_sym(code, sym) {
      out.push("-DXO_STDIN")
      break
    }
  }
  if calls_sym(code, "xo_proc_") {
    out.push("-DXO_PROC")
  }
  // the C path of the number and time text (decision 0193), which only
  // XO_LLRT_C=text builds call
  for sym in ["xo_int_parse", "xo_rs_append_duration", "xo_rs_append_time", "xo_rs_append_quote", "xo_duration_parse",
    "xo_time_parse"] {
    if calls_sym(code, sym) {
      out.push("-DXO_TEXT_C")
      break
    }
  }
  // and of the leaf text of Display and Debug (decision 0193 step 5,
  // XO_LLRT_C=show)
  for sym in ["xo_rs_append_u64", "xo_rs_append_rune_quote"] {
    if calls_sym(code, sym) {
      out.push("-DXO_SHOW_C")
      break
    }
  }
  // and of the report of a property test's case (decision 0193 step 5,
  // XO_LLRT_C=report)
  if calls_sym(code, "xo_prop_report") {
    out.push("-DXO_REPORT_C")
  }
  // and of the zone rules (decision 0193 step 5, XO_LLRT_C=tz)
  for sym in ["xo_tz_load", "xo_tz_offset", "xo_tz_abbr"] {
    if calls_sym(code, sym) {
      out.push("-DXO_TZ_C")
      break
    }
  }
  // and of Atomic's operations (decision 0200, XO_LLRT_C=atomic); not
  // xo_atomic_new, which the Xo path calls too
  for sym in ["xo_atomic_get", "xo_atomic_set", "xo_atomic_swap", "xo_atomic_cas", "xo_atomic_add", "xo_atomic_max"] {
    if calls_sym(code, sym) {
      out.push("-DXO_ATOMIC_C")
      break
    }
  }
  // and of the Fs path policy (decision 0193 step 6, XO_LLRT_C=fspath)
  for sym in ["xo_fs_mkdir_all", "xo_fs_remove_all", "xo_fs_create_temp", "xo_fs_cwd"] {
    if calls_sym(code, sym) {
      out.push("-DXO_FSPATH_C")
      break
    }
  }
  // and of the scalar values of property tests (decision 0195,
  // XO_LLRT_C=gen; xo_gen_size also names xo_gen_sized)
  for sym in ["xo_gen_size", "xo_gen_any_int", "xo_gen_float", "xo_gen_rune", "xo_gen_str", "xo_gen_duration", "xo_gen_time"] {
    if calls_sym(code, sym) {
      out.push("-DXO_GEN_C")
      break
    }
  }
  // and of MemFs.fail_next's pattern match (decision 0195,
  // XO_LLRT_C=glob)
  if calls_sym(code, "xo_test_glob") {
    out.push("-DXO_GLOB_C")
  }
  // and of the hashes of std/crypto (decision 0195, XO_LLRT_C=digest)
  for sym in ["xo_crypto_sha256", "xo_crypto_hmac_sha256", "xo_crypto_pbkdf2", "xo_crypto_argon2id", "xo_crypto_b64", "xo_crypto_verify_password"] {
    if calls_sym(code, sym) {
      out.push("-DXO_DIGEST_C")
      break
    }
  }
  // and of the integer operations of generated code and the intrinsics
  // (decision 0195, XO_LLRT_C=ints)
  for sym in ["xo_int_op", "xo_int_conv", "xo_int_in_range", "xo_rune_of", "xo_rune_valid", "xo_floor_div", "xo_str_hash",
    // the C versions of the intrinsics (a non-constant op of int_wrap)
    "xo_int_wrap", "xo_u64_mul_hi", "xo_float_bits", "xo_float_from_bits", "xo_bytes_word", "xo_int_fits", "xo_u64_to_float", "xo_f32_round", "xo_i64_to_f32"] {
    if calls_sym(code, sym) {
      out.push("-DXO_INTS_C")
      break
    }
  }
  // and of the reference counts (decision 0207 stage 2, XO_LLRT_C=rc)
  for sym in ["xo_rc_inc_c", "xo_rc_dec_c", "xo_rc_dec_shared_c", "xo_rc_claim_c", "xo_rc_mark_c"] {
    if calls_sym(code, sym) {
      out.push("-DXO_RC_C")
      break
    }
  }
  // and of the heap (decision 0207 stage 3, XO_LLRT_C=alloc)
  for sym in ["xo_alloc_new_c", "xo_alloc_free_c", "xo_alloc_refill_c", "xo_alloc_free_mt_c", "xo_alloc_resize_c"] {
    if calls_sym(code, sym) {
      out.push("-DXO_ALLOC_C")
      break
    }
  }
  out
}

/// Whether code refers to the runtime symbol sym, not only names it in a
/// string literal (internal/build callsSym): xo1's own tables above are
/// string data in its assembly.
fn calls_sym(code: Str, sym: Str) -> Bool {
  for p in [" ", "\t", "_", "@", ":", ","] {
    if code.contains(p + sym) {
      return true
    }
  }
  false
}
