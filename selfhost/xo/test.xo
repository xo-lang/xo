// Native test binaries (`xo test --no-gc`, cmd/xo nativetest.go,
// decision 0083): the test binary runs one test per process (XO_TEST
// names it, XO_TEST_SEED seeds it), so a fault fails that test only; the
// results print as the Go driver prints them. A property test runs its
// cases, each in a process of its own, and a failure is shrunk
// (XO_PROP_REPLAY, XO_PROP_BEST), as std/rt's runProperty does.
//
// Not here yet: tests with `uses` (real capabilities, `--real`) are
// reported as skipped, as the Go driver does without --real; the
// contract fuzz tests the Go driver lists as skipped are not listed; a
// test that does not finish is not stopped (the native Proc has no
// timeout yet).

use github.com/xo-lang/xo/selfhost/check


/// A test of the binary (internal/build TestInfo).
struct TestInfo {
  index: Int
  name: Str
  module: Str
  dir: Str
  loc: Str
  seed: Int = 0
  effects: List[Str] = []
  prop: Bool = false
}

/// testInfos: the test blocks of the root modules in the order the test
/// binary numbers them (module, file, declaration).
fn test_infos(c: check.Checker, root: Str, wd: Str) -> List[TestInfo] {
  var out: List[TestInfo] = []
  var i = 0
  for m in c.root_mods {
    for f in c.mods[m].files {
      for d in c.files[f].ast.decls {
        if let TestDecl(d: td) = d {
          var name = StrBuilder.new()
          if let Some(n) = td.name {
            for p in n.parts {
              name.write(p.text.to_str() ?? "")
            }
          }
          var ti = TestInfo{index: i, name: name.freeze(), module: c.mods[m].path, dir: abs_path(wd, c.mods[m].dir),
            loc: "${c.files[f].path.trim_prefix(root + "/")}:${td.span.start.line}:${td.span.start.col}",
            prop: !td.params.is_empty()}
          if let Some(IntLit(value: v, ..)) = td.seed {
            ti.seed = Int.parse(v.to_str() ?? "") ?? 0
          }
          for e in td.effects {
            var u = e.name.name.to_str() ?? ""
            if let Some(s) = e.sub {
              u = "${u}.${s.name.to_str() ?? ""}"
            }
            ti.effects.push(u)
          }
          out.push(ti)
          i += 1
        }
      }
    }
  }
  out
}

fn abs_path(wd: Str, p: Str) -> Str {
  if p.starts_with("/") {
    return p
  }
  if p == "." || p.is_empty() {
    return wd
  }
  "${wd}/${p.trim_prefix("./")}"
}

/// The options of `xo1 test`.
struct TestOpts {
  seed: Int = 0
  run: Str = ""
  json: Bool = false
  verbose: Bool = false
  cases: Int = 0
}

/// The outcome of a test: pass, fail, or skip, the message, and the
/// lines it logged.
struct Outcome {
  status: Str
  msg: Str = ""
  logs: List[Str] = []
}

/// What a property case reported (cmd/xo propCase).
struct PropCase {
  choices: List[Int] = []
  reported: Bool = false
  input: Str = ""
  not_smaller: Bool = false
}

/// runNativeTests: runs every test of bin and prints the results; the
/// exit status.
fn run_tests(os: Os, bin: Str, tests: List[TestInfo], o: TestOpts) -> Int {
  var pass = 0
  var failed = 0
  var skip = 0
  for t in tests {
    if !o.run.is_empty() && !t.name.contains(o.run) {
      continue
    }
    var s = t.seed
    if s == 0 {
      s = o.seed
    }
    if s == 0 {
      s = 1
    }
    var out = Outcome{status: "pass"}
    if !t.effects.is_empty() {
      out = Outcome{status: "skip", msg: "uses ${t.effects.join(", ")}: run with `xo test --real` for real capabilities"}
    } else if t.prop {
      out = run_property(os, bin, t, s, if o.cases <= 0 { 100 } else { o.cases })
    } else {
      let (oc, _) = run_test_env(os, bin, t, s, [])
      out = oc
    }
    if out.status == "pass" {
      pass += 1
    } else if out.status == "fail" {
      failed += 1
    } else {
      skip += 1
    }
    if o.json {
      // the fields in encoding/json's order of a map: sorted keys
      var rec = "{"
      if !out.logs.is_empty() && (out.status == "fail" || o.verbose) {
        var ls: List[Str] = []
        for l in out.logs {
          ls.push(json_str(l))
        }
        rec = "${rec}\"log\":[${ls.join(",")}],"
      }
      rec = "${rec}\"loc\":${json_str(t.loc)},\"message\":${json_str(out.msg)},\"module\":${json_str(t.module)},\"name\":${json_str(t.name)},\"seed\":${s},\"status\":${json_str(out.status)}}"
      os.stdio.println(rec)
      continue
    }
    if out.status == "fail" {
      os.stdio.println("--- FAIL: ${t.name} (${t.loc}, seed ${s})")
      for l in out.msg.trim_end().split("\n") {
        os.stdio.println("    ${l}")
      }
      print_logs(os, out.logs)
    } else if out.status == "skip" && o.verbose {
      os.stdio.println("--- SKIP: ${t.name} (${out.msg})")
    } else if out.status == "pass" && o.verbose {
      os.stdio.println("--- PASS: ${t.name}")
      print_logs(os, out.logs)
    }
  }
  if !o.json {
    let status = if failed > 0 { "FAIL" } else { "ok" }
    os.stdio.println("${status}: ${pass} passed, ${failed} failed, ${skip} skipped")
  }
  if failed > 0 { 1 } else { 0 }
}

fn print_logs(os: Os, lines: List[Str]) {
  if lines.is_empty() {
    return
  }
  os.stdio.println("    log:")
  for l in lines {
    os.stdio.println("      ${l}")
  }
}

/// A JSON string as encoding/json writes it (HTML characters escaped).
fn json_str(s: Str) -> Str {
  var b = StrBuilder.new()
  b.write("\"")
  for r in s.runes() {
    let n = Int(r)
    if r == '"' {
      b.write("\\\"")
    } else if r == '\\' {
      b.write("\\\\")
    } else if r == '\n' {
      b.write("\\n")
    } else if r == '\r' {
      b.write("\\r")
    } else if r == '\t' {
      b.write("\\t")
    } else if n < 32 || r == '<' || r == '>' || r == '&' || n == 8232 || n == 8233 {
      b.write("\\u${hex4(n)}")
    } else {
      b.write("${r}")
    }
  }
  b.write("\"")
  b.freeze()
}

fn hex4(n: Int) -> Str {
  let digits = "0123456789abcdef"
  var out = ""
  var v = n
  for _ in 0..4 {
    out = digits[v % 16..v % 16 + 1] + out
    v = v / 16
  }
  out
}

/// runNativeTestEnv: test t of bin with seed s and the extra environment
/// (NAME=value words), in the test's module directory.
fn run_test_env(os: Os, bin: Str, t: TestInfo, s: Int, env: List[Str]) -> (Outcome, PropCase) {
  var words = ["XO_TEST=${t.index}", "XO_TEST_SEED=${s}"] + env
  var q: List[Str] = []
  for w in words {
    q.push(sh_q(w))
  }
  let script = "cd ${sh_q(t.dir)} && exec env ${q.join(" ")} ${sh_q(bin)}"
  let r = match os.proc.run("sh", ["-c", script]) {
    Ok(r) => r
    Err(e) => return (Outcome{status: "fail", msg: "${e}"}, PropCase{})
  }
  let stdout = r.stdout.to_str() ?? ""
  let stderr = r.stderr.to_str() ?? ""
  var logs: List[Str] = []
  var fail_msg: List[Str] = []
  var pc = PropCase{}
  var input = StrBuilder.new()
  var failing = false
  for l in trim_nl(stdout).split("\n") {
    if failing {
      fail_msg.push(l)
    } else if l == "XO-TEST-FAIL" {
      failing = true
    } else if l.starts_with("XO-TEST-LOG ") {
      logs.push(l.trim_prefix("XO-TEST-LOG "))
    } else if l.starts_with("XO-PROP-CHOICES") {
      pc.reported = true
      for f in l.trim_prefix("XO-PROP-CHOICES").trim().split(",") {
        if let Some(v) = Int.parse(f) {
          if v >= 0 {
            pc.choices.push(v)
          }
        }
      }
    } else if l.starts_with("XO-PROP-INPUT ") {
      input.write(l.trim_prefix("XO-PROP-INPUT ") + "\n")
    } else if l == "XO-PROP-NOT-SMALLER" {
      pc.not_smaller = true
    }
  }
  pc.input = input.freeze()
  let code = r.code
  if code == 0 {
    return (Outcome{status: "pass", logs: logs}, pc)
  }
  if code == 3 && pc.not_smaller {
    return (Outcome{status: "skip"}, pc)
  }
  if failing {
    return (Outcome{status: "fail", msg: fail_msg.join("\n"), logs: logs}, pc)
  }
  var msg = trim_nl(stderr)
  if msg.is_empty() {
    msg = "the test exited with status ${code}"
  }
  (Outcome{status: "fail", msg: msg, logs: logs}, pc)
}

/// strings.TrimRight(s, "\n")
fn trim_nl(s: Str) -> Str {
  var t = s
  while t.ends_with("\n") {
    t = t.trim_suffix("\n")
  }
  t
}

/// runNativeProperty: the cases of property test t, each in a process of
/// its own, and the first failing input, shrunk.
fn run_property(os: Os, bin: Str, t: TestInfo, seed: Int, cases: Int) -> Outcome {
  for i in 0..cases {
    let case_seed = seed.wrapping_mul(1000003).wrapping_add(i)
    let (out, pc) = run_test_env(os, bin, t, seed, ["XO_PROP_SEED=${u64_str(case_seed)}"])
    if out.status != "fail" {
      continue
    }
    if pc.reported {
      let (s_in, s_out, steps) = shrink(os, bin, t, seed, pc.choices)
      if steps > 0 {
        return Outcome{status: "fail", msg: "property failed on case ${i + 1}; shrunk in ${steps} steps to\n${s_in}${s_out.msg}", logs: s_out.logs}
      }
    }
    return Outcome{status: "fail", msg: "property failed on case ${i + 1} with\n${pc.input}${out.msg}", logs: out.logs}
  }
  Outcome{status: "pass"}
}

/// An Int read as a uint64, in decimal (strconv.FormatUint).
fn u64_str(n: Int) -> Str {
  if n >= 0 {
    return "${n}"
  }
  // n + 2^64 = (n / 10 + ...) without overflow: split off the last digit
  // of the unsigned value
  let hi = (n >> 1) & 9223372036854775807
  let q = hi / 5
  let r = n.wrapping_sub(q.wrapping_mul(10))
  "${q}${r}"
}

fn join_choices(cs: List[Int]) -> Str {
  var parts: List[Str] = []
  for c in cs {
    parts.push(u64_str(c))
  }
  parts.join(",")
}

/// shrinkNative: deletes runs of choices, then lowers each by binary
/// search, keeping every edit that still fails with smaller choices,
/// within 2000 tries; the best input, its outcome, and the steps.
fn shrink(os: Os, bin: Str, t: TestInfo, seed: Int, failing: List[Int]) -> (Str, Outcome, Int) {
  var best = failing
  var best_in = ""
  var best_out = Outcome{status: "fail"}
  var steps = 0
  var budget = 2000
  var improved = true
  while improved && budget > 0 {
    improved = false
    var k = 8
    while k >= 1 && !improved {
      var i = 0
      while i + k <= best.len() && !improved && budget > 0 {
        let cand = best[0..i] + best[i + k..best.len()]
        budget -= 1
        let (out, pc) = run_test_env(os, bin, t, seed, ["XO_PROP_REPLAY=${join_choices(cand)}", "XO_PROP_BEST=${join_choices(best)}"])
        if !pc.not_smaller && pc.reported && out.status == "fail" {
          best = pc.choices
          best_in = pc.input
          best_out = out
          steps += 1
          improved = true
        }
        i += 1
      }
      k = k / 2
    }
    var i = 0
    while i < best.len() && !improved {
      if best[i] != 0 {
        var lo = 0
        var hi = best[i] + 0
        while lo < hi && budget > 0 {
          let mid = lo + (hi - lo) / 2
          var cand = best
          if i >= cand.len() {
            break
          }
          cand[i] = mid
          budget -= 1
          let (out, pc) = run_test_env(os, bin, t, seed, ["XO_PROP_REPLAY=${join_choices(cand)}", "XO_PROP_BEST=${join_choices(best)}"])
          if !pc.not_smaller && pc.reported && out.status == "fail" {
            best = pc.choices
            best_in = pc.input
            best_out = out
            steps += 1
            hi = mid
            improved = true
          } else {
            lo = mid + 1
          }
        }
      }
      i += 1
    }
  }
  (best_in, best_out, steps)
}
