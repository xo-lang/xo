// Native test binaries (`xo test --no-gc`, cmd/xo nativetest.go,
// decision 0083): the test binary runs one test per process (XO_TEST
// names it, XO_TEST_SEED seeds it), so a fault fails that test only; the
// results print as the Go driver prints them. A property test runs its
// cases, each in a process of its own, and a failure is shrunk
// (XO_PROP_REPLAY, XO_PROP_BEST), as std/rt's runProperty does.
//
// By default the tests and property cases run in batches (decision
// 0235): one process runs many of them in sequence (XO_TEST_BATCH), the
// test world reset between them, and a run the process does not survive
// (a failure, a fault, a deadlock) runs again alone, so its outcome and
// message are the one process mode's. Shrinking's replays go to one
// test binary over a pipe (XO_TEST_SERVE, serve_run). XO_TEST_BATCH=0
// in the environment of `xo test` runs one process per test, case, and
// replay.
//
// Tests with `uses` are skipped unless `--real` gives them real
// capabilities (XO_TEST_REAL, decision 0120). Not here yet: a test that
// does not finish is not stopped (the native Proc has no timeout yet).

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/gen

/// A test of the binary (internal/build TestInfo).
struct TestInfo {
  index: Int
  name: Str
  module: Str
  dir: Str
  loc: Str
  seed: Int = 0
  effects: List[Str] = []
  prop: Bool = false
  /// Why the test does not run natively (a contract fuzz test), or "".
  skip: Str = ""
}

/// testInfos: the test blocks of the root modules in the order the test
/// binary numbers them (module, file, declaration).
fn test_infos(c: check.Checker, root: Str, wd: Str) -> List[TestInfo] {
  var out: List[TestInfo] = []
  var i = 0
  // the contract fuzz tests the Go backend runs (core 9.1) are listed
  // where it lists them, before the test blocks of their file that follow
  // them, as skipped
  var fuzz_at: Map[Int, List[TestInfo]] = {}
  for ft in gen.contract_fuzz_targets(c) {
    let o = c.objs[ft.fo]
    let ti = TestInfo{index: -1, name: ft.name, module: c.mods[o.module].path, dir: abs_path(wd, c.mods[o.module].dir), loc: "${o.file.trim_prefix(root + "/")}:${o.fn_decl[0].span.start.line}:${o.fn_decl[0].span.start.col}", skip: "contract fuzzing is not available without a garbage collector (`--no-gc`) yet (support is planned)"}
    var l = fuzz_at.get(ft.fo) ?? []
    l.push(ti)
    fuzz_at[ft.fo] = l
  }
  var held: List[TestInfo] = []
  for m in c.root_mods {
    for f in c.mods[m].files {
      let file = c.files[f]
      for (di, d) in file.ast.decls.indexed() {
        if let FnDecl(..) = d {
          let o = if di < file.decl_objs.len() { file.decl_objs[di] } else { -1 }
          held = held + (fuzz_at.get(o) ?? [])
        }
        if let TestDecl(d: td) = d {
          out = out + held
          held = []
          var name = StrBuilder.new()
          if let Some(n) = td.name {
            for p in n.parts {
              name.write(p.text.to_str() ?? "")
            }
          }
          var ti = TestInfo{index: i, name: name.freeze(), module: c.mods[m].path, dir: abs_path(wd, c.mods[m].dir), loc: "${c.files[f].path.trim_prefix(root + "/")}:${td.span.start.line}:${td.span.start.col}", prop: !td.params.is_empty()}
          if let Some(IntLit(value: v, ..)) = td.seed {
            ti.seed = Int.parse(v.to_str() ?? "") ?? 0
          }
          for e in td.effects {
            var u = e.name.name.to_str() ?? ""
            if let Some(s) = e.sub {
              u = "${u}.${s.name.to_str() ?? ""}"
            }
            ti.effects.push(u)
          }
          out.push(ti)
          i += 1
        }
      }
    }
  }
  out + held
}

fn abs_path(wd: Str, p: Str) -> Str {
  if is_abs_path(p) {
    return p
  }
  if p == "." || p.is_empty() {
    return wd
  }
  "${wd}/${p.trim_prefix("./")}"
}

/// The options of `xo1 test`.
struct TestOpts {
  seed: Int = 0
  /// --real: the tests that declare `uses` run with real capabilities.
  real: Bool = false
  run: Str = ""
  json: Bool = false
  verbose: Bool = false
  cases: Int = 0
  /// --timeout: the real time a test (a property case, a replay) may
  /// take before the harness kills its process (std/rt's -timeout,
  /// 60 s); 0 for no limit.
  timeout: Duration = 60s
}

/// The outcome of a test: pass, fail, or skip, the message, and the
/// lines it logged.
struct Outcome {
  status: Str
  msg: Str = ""
  logs: List[Str] = []
}

/// What a property case reported (cmd/xo propCase).
struct PropCase {
  choices: List[Int] = []
  reported: Bool = false
  input: Str = ""
  not_smaller: Bool = false
  /// What the test wrote to the standard streams itself (not the
  /// harness's lines): a test with real stdio (`--real`).
  out: List[Str] = []
  err_out: Str = ""
}

/// runNativeTests: runs every test of bin and prints the results; the
/// exit status.
fn run_tests(os: Os, bin: Str, tests: List[TestInfo], o: TestOpts) -> Int {
  // the real time limit of each run (--timeout, 0 for none)
  let limit = o.timeout
  var pass = 0
  var failed = 0
  var skip = 0
  // the outcomes of the tests run in batches, by place in tests; the
  // rest run below, one process each
  var pre: Map[Int, Outcome] = {}
  if (os.env.get("XO_TEST_BATCH") ?? "") != "0" {
    pre = run_batched(os, bin, limit, tests, o)
  }
  for (k, t) in tests.indexed() {
    if !o.run.is_empty() && !t.name.contains(o.run) {
      continue
    }
    var s = t.seed
    if s == 0 {
      s = o.seed
    }
    if s == 0 {
      s = 1
    }
    var out = Outcome{status: "pass"}
    if !t.skip.is_empty() {
      out = Outcome{status: "skip", msg: t.skip}
    } else if !t.effects.is_empty() && !o.real {
      out = Outcome{status: "skip", msg: "uses ${t.effects.join(", ")}: run with `xo test --real` for real capabilities"}
    } else if !t.effects.is_empty() {
      // real capabilities for the declared effects (decision 0120); what
      // a test with real stdio printed goes where the Go backend's test
      // binary prints it
      let (oc, pc) = run_test_env(os, bin, limit, t, s, ["XO_TEST_REAL=${t.effects.join(",")}"])
      out = oc
      if t.effects.contains("stdio") {
        for l in pc.out {
          os.stdio.println(l)
        }
        if out.status == "pass" && !pc.err_out.is_empty() {
          os.stdio.eprint(pc.err_out)
        }
      }
    } else if let Some(bo) = pre.get(k) {
      out = bo
    } else if t.prop {
      out = run_property(os, bin, limit, t, s, if o.cases <= 0 { 100 } else { o.cases })
    } else {
      let (oc, _) = run_test_env(os, bin, limit, t, s, [])
      out = oc
    }
    if out.status == "pass" {
      pass += 1
    } else if out.status == "fail" {
      failed += 1
    } else {
      skip += 1
    }
    if o.json {
      // the fields in encoding/json's order of a map: sorted keys
      var rec = "{"
      if !out.logs.is_empty() && (out.status == "fail" || o.verbose) {
        var ls: List[Str] = []
        for l in out.logs {
          ls.push(json_str(l))
        }
        rec = "${rec}\"log\":[${ls.join(",")}],"
      }
      rec = "${rec}\"loc\":${json_str(t.loc)},\"message\":${json_str(out.msg)},\"module\":${json_str(t.module)},\"name\":${json_str(t.name)},\"seed\":${s},\"status\":${json_str(out.status)}}"
      os.stdio.println(rec)
      continue
    }
    if out.status == "fail" {
      os.stdio.println("--- FAIL: ${t.name} (${t.loc}, seed ${s})")
      for l in out.msg.trim_end().split("\n") {
        os.stdio.println("    ${l}")
      }
      print_logs(os, out.logs)
    } else if out.status == "skip" && o.verbose {
      os.stdio.println("--- SKIP: ${t.name} (${out.msg})")
    } else if out.status == "pass" && o.verbose {
      os.stdio.println("--- PASS: ${t.name}")
      print_logs(os, out.logs)
    }
  }
  if !o.json {
    let status = if failed > 0 { "FAIL" } else { "ok" }
    os.stdio.println("${status}: ${pass} passed, ${failed} failed, ${skip} skipped")
  }
  if failed > 0 { 1 } else { 0 }
}

fn print_logs(os: Os, lines: List[Str]) {
  if lines.is_empty() {
    return
  }
  os.stdio.println("    log:")
  for l in lines {
    os.stdio.println("      ${l}")
  }
}

/// A JSON string as encoding/json writes it (HTML characters escaped).
fn json_str(s: Str) -> Str {
  var b = StrBuilder.new()
  b.write("\"")
  for r in s.runes() {
    let n = Int(r)
    if r == '"' {
      b.write("\\\"")
    } else if r == '\\' {
      b.write("\\\\")
    } else if r == '\n' {
      b.write("\\n")
    } else if r == '\r' {
      b.write("\\r")
    } else if r == '\t' {
      b.write("\\t")
    } else if n < 32 || r == '<' || r == '>' || r == '&' || n == 8232 || n == 8233 {
      b.write("\\u${hex4(n)}")
    } else {
      b.write("${r}")
    }
  }
  b.write("\"")
  b.freeze()
}

fn hex4(n: Int) -> Str {
  let digits = "0123456789abcdef"
  var out = ""
  var v = n
  for _ in 0..4 {
    out = digits[v % 16..v % 16 + 1] + out
    v = v / 16
  }
  out
}

/// runNativeTestEnv: test t of bin with seed s and the extra environment
/// (NAME=value words), in the test's module directory.
fn run_test_env(os: Os, bin: Str, limit: Duration, t: TestInfo, s: Int, env: List[Str]) -> (Outcome, PropCase) {
  let words = ["XO_TEST=${t.index}", "XO_TEST_SEED=${s}"] + env
  let r = run_proc(test_cmd(os, bin, t.dir, words), limit)
  if !r.failed.is_empty() {
    return (Outcome{status: "fail", msg: r.failed}, PropCase{})
  }
  let (o, pc) = parse_run(r.out, r.err, r.code)
  if r.timed_out {
    return (Outcome{status: "fail", msg: timeout_msg(limit), logs: o.logs}, pc)
  }
  (o, pc)
}

/// A timed out run's message (std/rt's runOneTest).
fn timeout_msg(limit: Duration) -> Str { "the test did not finish within ${limit} of real time" }

/// Kills child when limit passes with no event on ev (a run that began
/// and did not end in time; killed is set then); returns when ev closes.
/// No polling: a run that ends costs no wait (a 20 ms poll here made each
/// shrinking replay 20 ms slower, 2026-10-15).
fn watchdog(ev: Chan[Int], limit: Duration, killed: Atomic[Int], child: Child) uses clock {
  var open = true
  while open {
    select {
      e = ev.recv() => {
        if e.is_none() {
          open = false
        }
      }
      after limit => {
        killed.set(1)
        child.kill()
        open = false
      }
    }
  }
}

/// What a test binary's process wrote, its status, and whether a run in
/// it timed out (the harness killed it), or why it did not start.
struct Ran {
  out: Str = ""
  err: Str = ""
  code: Int = 0
  timed_out: Bool = false
  failed: Str = ""
}

/// Runs c to its end, reading both streams as they come; with a limit
/// (not 0) a watchdog kills the process when a run in it takes longer:
/// a run starts with the process and again at each XO-TEST-BEGIN line
/// of a batch. Only the child this call started is killed.
fn run_proc(c: Cmd, limit: Duration) -> Ran uses (proc, clock) {
  let child = match c.spawn() {
    Ok(ch) => ch
    Err(e) => return Ran{failed: "${e}"}
  }
  // the reader sends an event per XO-TEST-BEGIN and closes ev at the
  // end of the output; the watchdog's timer restarts at each event
  let ev = Chan[Int].new(cap: 1024)
  let killed = Atomic[Int].new(0)
  let (out, err) = scope s {
    let to = s.spawn(fn() -> Bytes {
      var b = BytesBuilder.new()
      // how much of "XO-TEST-BEGIN\n" a line has matched so far (-1:
      // inside a line that is not it)
      let pat = "XO-TEST-BEGIN\n".bytes()
      var at = 0
      while true {
        let chunk = match child.read(65536) {
          Ok(Some(x)) => x
          _ => break
        }
        for x in chunk {
          if at >= 0 && x == pat[at] {
            at += 1
            if at == pat.len() {
              let _sent = ev.try_send(1)
              at = 0
            }
          } else {
            at = if x == 10 { 0 } else { -1 }
          }
        }
        b.write(chunk)
      }
      ev.close()
      b.freeze()
    })
    let te = s.spawn(fn() -> Bytes {
      var b = BytesBuilder.new()
      while true {
        match child.read_err(65536) {
          Ok(Some(x)) => b.write(x)
          _ => break
        }
      }
      b.freeze()
    })
    if limit > 0s {
      s.spawn(fn() { watchdog(ev, limit, killed, child) })
    }
    (to.await, te.await)
  }
  let code = child.wait().ok() ?? 1
  Ran{out: out.to_str() ?? "", err: err.to_str() ?? "", code: code, timed_out: killed.get() != 0}
}

/// The outcome of a run from what its process wrote and its status
/// (run_test_env's; a serving binary's run that ended is status 0, or 3
/// when it was not smaller).
fn parse_run(stdout: Str, stderr: Str, code: Int) -> (Outcome, PropCase) {
  var logs: List[Str] = []
  var fail_msg: List[Str] = []
  var pc = PropCase{}
  var input = StrBuilder.new()
  var failing = false
  for l in trim_nl(stdout).split("\n") {
    if failing {
      fail_msg.push(l)
    } else if l == "XO-TEST-FAIL" {
      failing = true
    } else if l.starts_with("XO-TEST-LOG ") {
      logs.push(l.trim_prefix("XO-TEST-LOG "))
    } else if l.starts_with("XO-PROP-CHOICES") {
      pc.reported = true
      for f in l.trim_prefix("XO-PROP-CHOICES").trim().split(",") {
        if let Some(v) = Int.parse(f) {
          if v >= 0 {
            pc.choices.push(v)
          }
        }
      }
    } else if l.starts_with("XO-PROP-INPUT ") {
      input.write(l.trim_prefix("XO-PROP-INPUT ") + "\n")
    } else if l == "XO-PROP-NOT-SMALLER" {
      pc.not_smaller = true
    } else if !l.starts_with("XO-") {
      pc.out.push(l)
    }
  }
  pc.input = input.freeze()
  pc.err_out = stderr
  if code == 0 {
    return (Outcome{status: "pass", logs: logs}, pc)
  }
  if code == 3 && pc.not_smaller {
    return (Outcome{status: "skip"}, pc)
  }
  if failing {
    return (Outcome{status: "fail", msg: fail_msg.join("\n"), logs: logs}, pc)
  }
  var msg = trim_nl(stderr)
  if msg.is_empty() {
    msg = "the test exited with status ${code}"
  }
  (Outcome{status: "fail", msg: msg, logs: logs}, pc)
}

/// A run of a batch: test k of the list (t), its seed, and the property
/// case (-1 for a test that is not a property test).
struct Run {
  k: Int
  t: TestInfo
  seed: Int
  case: Int = -1
}

/// The seed test t runs with (its own, else --seed's, else 1).
fn test_seed(t: TestInfo, o: TestOpts) -> Int {
  if t.seed != 0 {
    return t.seed
  }
  if o.seed != 0 {
    return o.seed
  }
  1
}

/// Runs the tests that need no real capability, and every case of the
/// property tests among them, in batches (decision 0235): a process runs
/// the runs of one directory in order (XO_TEST_BATCH), bracketing each
/// with XO-TEST-BEGIN and XO-TEST-END. A run that began and did not end
/// (the process failed, faulted, or exited in it) runs again alone, as
/// run_tests and run_property run it; the next process starts after it.
/// A process that ends early (the test binary could not reset the test
/// world) leaves the rest to the next one. The outcomes, by place in
/// tests.
fn run_batched(os: Os, bin: Str, limit: Duration, tests: List[TestInfo], o: TestOpts) -> Map[Int, Outcome] {
  var runs: List[Run] = []
  for (k, t) in tests.indexed() {
    if (!o.run.is_empty() && !t.name.contains(o.run)) || !t.skip.is_empty() || !t.effects.is_empty() {
      continue
    }
    let s = test_seed(t, o)
    if t.prop {
      for c in 0..(if o.cases <= 0 { 100 } else { o.cases }) {
        runs.push(Run{k: k, t: t, seed: s, case: c})
      }
    } else {
      runs.push(Run{k: k, t: t, seed: s})
    }
  }
  // chunks of whole tests (a property test's cases stay together, so
  // its first failing case is the one reported), one directory each,
  // of about runs / jobs runs: they run in parallel processes and the
  // outcomes print in order afterwards, as one process would give them
  let jobs = if runs.len() > 1 { test_jobs(os) } else { 1 }
  let target = (runs.len() + jobs - 1) / jobs
  var chunks: List[List[Run]] = []
  var cur: List[Run] = []
  var i = 0
  while i < runs.len() {
    var j = i + 1
    while j < runs.len() && runs[j].k == runs[i].k {
      j += 1
    }
    if !cur.is_empty() && (cur.len() >= target || cur[0].t.dir != runs[i].t.dir) {
      chunks.push(cur)
      cur = []
    }
    cur = cur + runs[i..j]
    i = j
  }
  if !cur.is_empty() {
    chunks.push(cur)
  }
  if chunks.len() <= 1 || jobs <= 1 {
    var all: Map[Int, Outcome] = {}
    for c in chunks {
      for (k, v) in run_chunk(os, bin, limit, c, o).entries() {
        all[k] = v
      }
    }
    return all
  }
  let next = Atomic[Int].new(0)
  let n = chunks.len()
  let parts = scope sc {
    var ts = []
    for _ in 0..jobs.min(n) {
      ts.push(sc.spawn(fn() -> List[Map[Int, Outcome]] {
        var mine: List[Map[Int, Outcome]] = []
        while true {
          let ci = next.add(1) - 1
          if ci >= n {
            break
          }
          mine.push(run_chunk(os, bin, limit, chunks[ci], o))
        }
        mine
      }))
    }
    var all: List[Map[Int, Outcome]] = []
    for t in ts {
      all = all + t.await
    }
    all
  }
  var out: Map[Int, Outcome] = {}
  for m in parts {
    for (k, v) in m.entries() {
      out[k] = v
    }
  }
  out
}

/// The test processes `xo test` runs at once: $XO_TEST_JOBS, else the
/// physical cores (the build's ncores). The report does not depend on it.
fn test_jobs(os: Os) -> Int {
  let j = Int.parse(os.env.get("XO_TEST_JOBS") ?? "") ?? 0
  if j > 0 {
    return j
  }
  ncores(os).max(1)
}

/// The runs of a chunk in batches (run_batched's processes, in order):
/// the outcomes of the tests they decided.
fn run_chunk(os: Os, bin: Str, limit: Duration, runs: List[Run], o: TestOpts) -> Map[Int, Outcome] {
  var out: Map[Int, Outcome] = {}
  var i = 0
  while i < runs.len() {
    // the runs of the process: from i on, in one directory, without the
    // cases of a property test already decided
    var batch: List[Run] = []
    var j = i
    while j < runs.len() && runs[j].t.dir == runs[i].t.dir {
      if !(runs[j].case >= 0 && out.contains(runs[j].k)) {
        batch.push(runs[j])
      }
      j += 1
    }
    if batch.is_empty() {
      i = j
      continue
    }
    let (segs, ended, code, timed_out) = run_batch(os, bin, limit, batch)
    // the runs that ended in the process
    var n = 0
    while n < segs.len() && ended[n] {
      let r = batch[n]
      if r.case < 0 {
        let (po, _) = parse_run(segs[n], "", 0)
        out[r.k] = Outcome{status: "pass", logs: po.logs}
      }
      n += 1
    }
    if n < segs.len() && timed_out {
      // run n did not finish in time and its process was killed: it
      // fails as alone (std/rt's runOneTest), without running again
      let r = batch[n]
      let (so, spc) = parse_run(segs[n], "", 1)
      let to = Outcome{status: "fail", msg: timeout_msg(limit), logs: so.logs}
      if r.case < 0 {
        out[r.k] = to
      } else {
        out[r.k] = prop_failed(os, bin, limit, r.t, r.seed, r.case, to, spc)
      }
      n += 1
    } else if n < segs.len() {
      // run n began and the process ended in it: it runs alone
      let r = batch[n]
      if r.case < 0 {
        let (oc, _) = run_test_env(os, bin, limit, r.t, r.seed, [])
        out[r.k] = oc
      } else if let Some(po) = prop_case(os, bin, limit, r.t, r.seed, r.case) {
        out[r.k] = po
      }
      n += 1
    } else if code != 0 || n == 0 {
      // the process failed after its last run ended, or ran none: the
      // runs of this batch go to one process each
      for r in batch {
        if r.case < 0 {
          let _o = out.remove(r.k)
        }
      }
      return out
    }
    // a property test whose cases all ran without failing passes
    for r in batch[0..n] {
      if r.case >= 0 && !out.contains(r.k) && r.case == (if o.cases <= 0 { 100 } else { o.cases }) - 1 {
        out[r.k] = Outcome{status: "pass"}
      }
    }
    // the next process starts at the first run not done
    let last = batch[n - 1]
    var next = i
    while next < runs.len() && !(runs[next].k == last.k && runs[next].case == last.case) {
      next += 1
    }
    i = next + 1
  }
  out
}

/// Runs batch in one process (XO_TEST_BATCH): the output lines of each
/// run that began, whether it ended, the process's status, and whether
/// its last run timed out.
fn run_batch(os: Os, bin: Str, limit: Duration, batch: List[Run]) -> (List[Str], List[Bool], Int, Bool) {
  var parts: List[Str] = []
  var i = 0
  while i < batch.len() {
    let r = batch[i]
    if r.case < 0 {
      parts.push("${r.t.index}/${r.seed}")
      i += 1
      continue
    }
    // consecutive cases of a property test as one range
    var j = i
    while j + 1 < batch.len() && batch[j + 1].k == r.k && batch[j + 1].case == batch[j].case + 1 {
      j += 1
    }
    parts.push("${r.t.index}/${r.seed}/${r.case}-${batch[j].case}")
    i = j + 1
  }
  let first = batch[0]
  let words = ["XO_TEST=${first.t.index}", "XO_TEST_SEED=${first.seed}", "XO_TEST_BATCH=${parts.join(",")}"]
  var segs: List[Str] = []
  var ended: List[Bool] = []
  let r = run_proc(test_cmd(os, bin, first.t.dir, words), limit)
  if !r.failed.is_empty() {
    return (segs, ended, 1, false)
  }
  var lines: List[Str] = []
  var open = false
  for l in trim_nl(r.out).split("\n") {
    if l == "XO-TEST-BEGIN" {
      if open {
        segs[segs.len() - 1] = lines.join("\n")
      }
      lines = []
      open = true
      segs.push("")
      ended.push(false)
    } else if l == "XO-TEST-END" && open {
      segs[segs.len() - 1] = lines.join("\n")
      ended[ended.len() - 1] = true
      open = false
    } else if open {
      lines.push(l)
    }
  }
  if open {
    segs[segs.len() - 1] = lines.join("\n")
  }
  (segs, ended, r.code, r.timed_out)
}

/// Case c of property test t run alone (run_property's step): the test's
/// outcome when the case fails (shrunk), None when it passes.
fn prop_case(os: Os, bin: Str, limit: Duration, t: TestInfo, seed: Int, c: Int) -> Outcome? {
  let case_seed = seed.wrapping_mul(1000003).wrapping_add(c)
  let (out, pc) = run_test_env(os, bin, limit, t, seed, ["XO_PROP_SEED=${u64_str(case_seed)}"])
  if out.status != "fail" {
    return None
  }
  Some(prop_failed(os, bin, limit, t, seed, c, out, pc))
}

/// Property test t's outcome when its case c failed with out (pc what
/// the case reported): shrunk when the choices were reported.
fn prop_failed(os: Os, bin: Str, limit: Duration, t: TestInfo, seed: Int, c: Int, out: Outcome, pc: PropCase) -> Outcome {
  if pc.reported {
    let (s_in, s_out, steps) = shrink(os, bin, limit, t, seed, pc.choices)
    if steps > 0 {
      return Outcome{status: "fail", msg: "property failed on case ${c + 1}; shrunk in ${steps} steps to\n${s_in}${s_out.msg}", logs: s_out.logs}
    }
  }
  Outcome{status: "fail", msg: "property failed on case ${c + 1} with\n${pc.input}${out.msg}", logs: out.logs}
}

/// The test binary bin run in dir with the NAME=value words added to the
/// environment: started directly (the harness used `sh -c 'cd dir &&
/// exec env words bin'`, three execs per run, until 2026-10-15).
fn test_cmd(os: Os, bin: Str, dir: Str, words: List[Str]) -> Cmd {
  // PWD as the shell's cd left it
  var c = os.proc.cmd(bin, []).dir(dir).set_env("PWD", dir)
  for w in words {
    let i = w.find("=") ?? w.len()
    c = c.set_env(w[0..i], if i < w.len() { w[i + 1..w.len()] } else { "" })
  }
  c
}

/// strings.TrimRight(s, "\n")
fn trim_nl(s: Str) -> Str {
  var t = s
  while t.ends_with("\n") {
    t = t.trim_suffix("\n")
  }
  t
}

/// runNativeProperty: the cases of property test t, each in a process of
/// its own, and the first failing input, shrunk.
fn run_property(os: Os, bin: Str, limit: Duration, t: TestInfo, seed: Int, cases: Int) -> Outcome {
  for i in 0..cases {
    let case_seed = seed.wrapping_mul(1000003).wrapping_add(i)
    let (out, pc) = run_test_env(os, bin, limit, t, seed, ["XO_PROP_SEED=${u64_str(case_seed)}"])
    if out.status != "fail" {
      continue
    }
    return prop_failed(os, bin, limit, t, seed, i, out, pc)
  }
  Outcome{status: "pass"}
}

/// An Int read as a uint64, in decimal (strconv.FormatUint).
fn u64_str(n: Int) -> Str {
  if n >= 0 {
    return "${n}"
  }
  // n + 2^64 = (n / 10 + ...) without overflow: split off the last digit
  // of the unsigned value
  let hi = (n >> 1) & 9223372036854775807
  let q = hi / 5
  let r = n.wrapping_sub(q.wrapping_mul(10))
  "${q}${r}"
}

fn join_choices(cs: List[Int]) -> Str {
  var parts: List[Str] = []
  for c in cs {
    parts.push(u64_str(c))
  }
  parts.join(",")
}

/// shrinkNative: deletes runs of choices, then lowers each by binary
/// search, keeping every edit that still fails with smaller choices,
/// within 2000 tries; the best input, its outcome, and the steps.
fn shrink(os: Os, bin: Str, limit: Duration, t: TestInfo, seed: Int, failing: List[Int]) -> (Str, Outcome, Int) {
  var best = failing
  var best_in = ""
  var best_out = Outcome{status: "fail"}
  var steps = 0
  var budget = 2000
  // the replays go to one test binary over a pipe (serve_run) unless
  // XO_TEST_BATCH=0
  var srv = Server{off: (os.env.get("XO_TEST_BATCH") ?? "") == "0"}
  var improved = true
  while improved && budget > 0 {
    improved = false
    var k = 8
    while k >= 1 && !improved {
      var i = 0
      while i + k <= best.len() && !improved && budget > 0 {
        let cand = best[0..i] + best[i + k..best.len()]
        budget -= 1
        let (out, pc, s2) = serve_run(os, bin, limit, t, seed, join_choices(cand), join_choices(best), srv)
        srv = s2
        if !pc.not_smaller && pc.reported && out.status == "fail" {
          best = pc.choices
          best_in = pc.input
          best_out = out
          steps += 1
          improved = true
        }
        i += 1
      }
      k = k / 2
    }
    var i = 0
    while i < best.len() && !improved {
      if best[i] != 0 {
        var lo = 0
        var hi = best[i] + 0
        while lo < hi && budget > 0 {
          let mid = lo + (hi - lo) / 2
          var cand = best
          if i >= cand.len() {
            break
          }
          cand[i] = mid
          budget -= 1
          let (out, pc, s2) = serve_run(os, bin, limit, t, seed, join_choices(cand), join_choices(best), srv)
        srv = s2
          if !pc.not_smaller && pc.reported && out.status == "fail" {
            best = pc.choices
            best_in = pc.input
            best_out = out
            steps += 1
            hi = mid
            improved = true
          } else {
            lo = mid + 1
          }
        }
      }
      i += 1
    }
  }
  serve_end(srv)
  (best_in, best_out, steps)
}

/// A test binary serving runs read from its standard input
/// (XO_TEST_SERVE, decision 0235): the child, whether it is running, the
/// runs it ended, and whether serving is off (one process per run).
struct Server {
  child: Child? = None
  runs: Int = 0
  off: Bool = false
}

/// A shrinking replay (choices replay, best so far best) of property
/// test t run by the serving binary of srv, started when none runs: the
/// outcome as run_test_env gives it, and the server after. A run the
/// binary does not survive ends the server; unless it was the server's
/// first run it runs again alone (run_test_env), so a failure's report
/// is the one process mode's.
fn serve_run(os: Os, bin: Str, limit: Duration, t: TestInfo, seed: Int, replay: Str, best: Str, srv: Server) -> (Outcome, PropCase, Server) {
  let alone = ["XO_PROP_REPLAY=${replay}", "XO_PROP_BEST=${best}"]
  if srv.off {
    let (o, pc) = run_test_env(os, bin, limit, t, seed, alone)
    return (o, pc, srv)
  }
  var s = srv
  if s.child.is_none() {
    match test_cmd(os, bin, t.dir, ["XO_TEST=${t.index}", "XO_TEST_SEED=${seed}", "XO_TEST_SERVE=1"]).spawn() {
      Ok(c) => {
        s.child = Some(c)
        s.runs = 0
      }
      Err(_) => {
        let (o, pc) = run_test_env(os, bin, limit, t, seed, alone)
        return (o, pc, s)
      }
    }
  }
  let c = match s.child {
    Some(c) => c
    None => return (Outcome{status: "fail"}, PropCase{}, s)
  }
  if c.write("${t.index}/${seed}/r=${replay}/b=${best}\n".bytes()).is_err() {
    serve_end(s)
    let (o, pc) = run_test_env(os, bin, limit, t, seed, alone)
    return (o, pc, Server{})
  }
  // the run's lines up to XO-TEST-END; a watchdog kills the binary
  // when the run takes longer than the limit
  let ev = Chan[Int].new(cap: 1)
  let killed = Atomic[Int].new(0)
  let (lines, begun, ended) = scope sc {
    let rd = sc.spawn(fn() -> (List[Str], Bool, Bool) {
      var ls: List[Str] = []
      var b = false
      var e = false
      while true {
        let l = match c.read_line() {
          Ok(Some(l)) => l
          _ => break
        }
        if l == "XO-TEST-BEGIN" {
          b = true
        } else if l == "XO-TEST-END" {
          e = true
          break
        } else if b {
          ls.push(l)
        }
      }
      ev.close()
      (ls, b, e)
    })
    if limit > 0s {
      sc.spawn(fn() { watchdog(ev, limit, killed, c) })
    }
    rd.await
  }
  let out = lines.join("\n")
  if killed.get() != 0 {
    // the replay did not finish in time: it fails as alone, and the
    // binary is gone
    c.wait().ignore_err("the killed server's status is not the replay's")
    let (o, pc) = parse_run(out, "", 1)
    return (Outcome{status: "fail", msg: timeout_msg(limit), logs: o.logs}, pc, Server{})
  }
  if ended {
    s.runs += 1
    let (o, pc) = parse_run(out, "", 0)
    if pc.not_smaller {
      // a process of its own exits with status 3 here
      let (o3, pc3) = parse_run(out, "", 3)
      return (o3, pc3, s)
    }
    return (o, pc, s)
  }
  // the binary ended in the run (or before it): its status and errors
  var err = BytesBuilder.new()
  while true {
    match c.read_err(65536) {
      Ok(Some(b)) => err.write(b)
      _ => break
    }
  }
  let code = c.wait().ok() ?? 1
  let first = s.runs == 0
  if begun && first {
    let (o, pc) = parse_run(out, err.freeze().to_str() ?? "", code)
    return (o, pc, Server{})
  }
  let (o, pc) = run_test_env(os, bin, limit, t, seed, alone)
  (o, pc, Server{})
}

/// Ends the serving binary of srv, if one runs: end of input, then its
/// exit.
fn serve_end(srv: Server) {
  if let Some(c) = srv.child {
    c.close_stdin()
    c.wait().ignore_err("the server's status after its last run does not matter")
  }
}
