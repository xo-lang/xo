// The command line of xo1 (decision 0178 stage 1): the flags of `xo
// build`, `xo run`, and `xo test` (cmd/xo build.go) with Go's flag
// package rules, so the same command lines work with both drivers:
// `-name` or `--name`, `--name=value` or `--name value` for a flag with
// a value, `--name` or `--name=false` for a boolean; parsing stops at the
// first argument that is not a flag or after `--`. xo1's own flags
// (--std, --wd, --cc, --asm, --go-tree, --phase-times, --target) are
// parsed the same way.

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/cli/cmdhelp

/// Everything a command line sets.
struct Opts {
  cmd: Str = ""
  std: Str = "std"
  wd: Str = ""
  cc: Str = ""
  out: Str = ""
  asm_path: Str = ""
  /// --tzdata: "embedded" (the default, as cmd/xo's flag) or "system".
  tzdata: Str = "embedded"
  /// --targets (comma separated os/arch, or all) or xo1's --target.
  targets: Str = ""
  /// --backend as given ("" when not given: go, or arm64 with --no-gc and
  /// for asm; main.xo).
  backend: Str = ""
  go_tree: Str = ""
  /// --as and --ld (decision 0182): cc, or macho (selfhost/macho; --ld=macho
  /// implies --as=macho); "" when not given: main.xo default_ld picks
  /// macho for a darwin/arm64 host link the pack covers, else cc.
  assembler: Str = ""
  linker: Str = ""
  phases: Bool = false
  /// The run cache's key of a native `xo test` (testcache.xo), "" for
  /// none, and when the build started (Unix milliseconds).
  run_key: Str = ""
  run_start: Int = 0
  json: Bool = false
  ci: Bool = false
  release: Bool = false
  /// -s: no debug information; --debug-info: debug information in a
  /// release build too (decision 0239)
  strip: Bool = false
  debug_info: Bool = false
  error_args: Bool = true
  hybrid: Bool = false
  no_mono: Bool = false
  no_arenas: Bool = false
  no_gc: Bool = false
  holes: Bool = false
  race: Bool = false
  /// --profile: the sampling profiles run and test take (decision 0238:
  /// "cpu", "heap", or "cpu,heap"; XO_PROF for the program), "" for none.
  profile: Str = ""
  real: Bool = false
  record: Str = ""
  explore: Int = 0
  /// --offline: "1" on, "0" off, "" not given (XO_OFFLINE decides).
  offline: Str = ""
  /// --workspace: "off", "on", or "" not given (XO_WORK decides).
  workspace: Str = ""
  /// --stamp NAME=VALUE, in command line order.
  stamps: List[(Str, Str)] = []
  topts: TestOpts = TestOpts{}
  /// The directories (build, test, asm) or the one directory of run.
  dirs: List[Str] = []
  /// run: the program's arguments (after the directory, or after --).
  prog_args: List[Str] = []
  /// The std parses of an earlier build of this process (`xo dev
  /// build-each`, decision 0209); empty for a command line.
  parse_cache: Map[Str, check.ParseEntry] = {}
}

/// The flags that take a value (every other known flag is a boolean).
fn value_flags() -> List[Str] {
  ["o", "targets", "target", "backend", "tzdata", "stamp", "seed", "explore", "record", "run", "cases", "timeout", "std", "wd", "cc", "asm", "go-tree", "workspace", "as", "ld", "profile"]
}

/// The boolean flags.
fn bool_flags() -> List[Str] {
  ["json", "ci", "release", "error-args", "hybrid", "mono", "no-mono", "arenas", "no-arenas", "no-gc", "holes", "race", "v", "real", "phase-times", "offline", "s", "debug-info"]
}

/// The usage of xo1's hidden commands (asm, keys) and of an unknown one;
/// build, run, and test print `xo`'s usage (selfhost/cli/cmdhelp), which
/// leaves out xo1's own flags.
fn usage_line() -> Str {
  "usage: xo1 build|run|test|asm|keys [flags] [dir ...] (run: [dir] [--] [args]); flags: --std=DIR --wd=DIR --cc=CC --tzdata=embedded|system --targets=OS/ARCH,... --backend=arm64|llvm|go|wasm --go-tree=DIR --as=cc|macho --ld=cc|macho -o OUT --asm=PATH --json --ci --release --error-args=false --stamp NAME=VALUE --no-mono --no-arenas --no-gc --holes --race --profile=cpu|heap|cpu,heap --seed=N --explore=N --record=FILE --run=SUB --cases=N --timeout=D --real -v --phase-times"
}

/// usage prints why and the usage of the command cmd on standard error
/// and exits 2 (a usage error).
fn usage(os: Os, cmd: Str, why: Str) -> Never {
  if !why.is_empty() {
    os.stdio.eprintln(why)
  }
  let u = cmdhelp.usage(cmd)
  if u.is_empty() {
    os.stdio.eprintln(usage_line())
  } else {
    os.stdio.eprint(u)
  }
  os.proc.exit(2)
}

/// What front decided: exit with code (code >= 0), or run the command
/// line args.
struct Front {
  code: Int = -1
  args: List[Str] = []
}

/// front handles what every command line shares before a command runs:
/// `xo` alone (the command list on standard error, exit 2), `xo help
/// [command]` and -h or --help anywhere before `--` (run: before its
/// directory) on standard output (exit 0), and the package pattern
/// `D/...` (decision 0210, spec/core.md 10.1), which a command that takes
/// directories reads as D (each of them already covers the directories
/// below D) once D/... is known to match a directory with .xo files. The
/// global --std=DIR and --wd=DIR may come before the command
/// (selfhost/cli/core).
fn front(os: Os, args: List[Str]) -> Front {
  var i = 0
  while i < args.len() && (args[i].starts_with("--std=") || args[i].starts_with("--wd=")) {
    i += 1
  }
  if i >= args.len() {
    os.stdio.eprint(cmdhelp.top())
    return Front{code: 2}
  }
  let cmd = args[i]
  if cmd == "help" || cmdhelp.is_help_flag(cmd) {
    if i + 1 < args.len() {
      let u = cmdhelp.usage(args[i + 1])
      if u.is_empty() {
        os.stdio.eprint("xo help: unknown command ${args[i + 1].quote()}\n\n${cmdhelp.top()}")
        return Front{code: 2}
      }
      os.stdio.print(u)
      return Front{code: 0}
    }
    os.stdio.print(cmdhelp.top())
    return Front{code: 0}
  }
  if !cmdhelp.is_command(cmd) {
    return Front{args: args}
  }
  let dirs = cmdhelp.takes_dirs(cmd)
  let vals = if cmd is "build" | "run" | "test" { value_flags() } else { [] }
  let wd = os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""
  var out: List[Str] = []
  for k in 0..i + 1 {
    out.push(path_arg(args[k]))
  }
  var j = i + 1
  var program = false
  while j < args.len() {
    let a = args[j]
    if program || a == "--" {
      out.push(a)
      program = true
      j += 1
      continue
    }
    if cmdhelp.is_help_flag(a) {
      os.stdio.print(cmdhelp.usage(cmd))
      return Front{code: 0}
    }
    if a.starts_with("-") && a != "-" {
      out.push(path_arg(a))
      // a value flag given without = takes the next argument
      let flag = a.trim_prefix("-").trim_prefix("-")
      if !a.contains("=") && vals.contains(flag) && j + 1 < args.len() {
        j += 1
        out.push(if path_flags().contains(flag) { os_path(args[j]) } else { args[j] })
      }
      j += 1
      continue
    }
    if dirs && cmdhelp.is_pattern(a) {
      if cmd == "run" {
        os.stdio.eprintln("xo run: ${a}: run takes one directory, not a package pattern")
        return Front{code: 2}
      }
      let d = cmdhelp.pattern_dir(a)
      if d.is_empty() {
        os.stdio.eprintln(cmdhelp.pattern_error(cmd, a))
        return Front{code: 2}
      }
      if is_dir(os, abs_in(wd, d)) && !has_sources(os, abs_in(wd, d)) {
        os.stdio.eprintln(cmdhelp.no_match_error(cmd, a))
        return Front{code: 1}
      }
      out.push(os_path(d))
    } else {
      out.push(if dirs { os_path(a) } else { a })
    }
    if cmd == "run" {
      // the directory; the program's arguments follow
      program = true
    }
    j += 1
  }
  Front{args: out}
}

/// The value flags that name a file or directory.
fn path_flags() -> List[Str] {
  ["o", "std", "wd", "tzdata", "record", "cc", "asm", "go-tree", "workspace", "as", "ld"]
}

/// A path argument as the rest of xo takes it: on Windows `\` is a
/// separator (std.md 3.1: `C:\data` is absolute), and the checker and
/// driver split paths only at `/`, so `C:\x\selfhost\xo` becomes
/// `C:/x/selfhost/xo` (gotchas/windows-seed-xo1306-module-not-required.md);
/// elsewhere `\` is an ordinary character of a name.
fn os_path(p: Str) -> Str {
  if is_windows() { p.replace("\\", "/") } else { p }
}

/// arg with os_path applied to the value of a path flag (`-o=C:\x`,
/// `--std=C:\x`); other arguments unchanged.
fn path_arg(arg: Str) -> Str {
  if !arg.starts_with("-") || !arg.contains("=") {
    return arg
  }
  let eq = arg.find("=") ?? 0
  let name = arg[0..eq]
  if path_flags().contains(name.trim_prefix("-").trim_prefix("-")) { "${name}=${os_path(arg[eq + 1..])}" } else { arg }
}

/// p against the working directory wd (unless absolute).
fn abs_in(wd: Str, p: Str) -> Str {
  if p.starts_with("/") || wd.is_empty() { p } else { "${wd}/${p}" }
}

fn is_dir(os: Os, p: Str) -> Bool {
  os.fs.read_dir(p).is_ok()
}

/// Whether dir or a directory below it holds a .xo file, below the top
/// skipping what the commands' walks skip: testdata, vendor, and names
/// starting with . or _ (decision 0210).
fn has_sources(os: Os, dir: Str) -> Bool {
  let entries = os.fs.read_dir(dir).ok() ?? []
  for e in entries {
    if !e.is_dir && e.name.ends_with(".xo") {
      return true
    }
  }
  for e in entries {
    if e.is_dir && !(e.name is "testdata" | "vendor") && !e.name.starts_with(".") && !e.name.starts_with("_") {
      if has_sources(os, "${dir}/${e.name}") {
        return true
      }
    }
  }
  false
}

/// help prints the usage of the command cmd on standard output and exits
/// 0 (-h, --help).
fn help(os: Os, cmd: Str) -> Never {
  let u = cmdhelp.usage(cmd)
  if u.is_empty() {
    os.stdio.println(usage_line())
  } else {
    os.stdio.print(u)
  }
  os.proc.exit(0)
}

/// parse_args reads the command line (args[0] is the command).
fn parse_args(os: Os, args: List[Str]) -> Opts {
  var o = Opts{cmd: args[0], wd: os.fs.cwd_path().ok() ?? os.env.get("PWD") ?? ""}
  // the std sources: $XO_STD, else lib/xo/std of a release layout beside
  // the binary (check.std_dir, as every command finds it); --std
  // overrides it
  o.std = check.std_dir(os.env, os.fs)
  let vals = value_flags()
  let bools = bool_flags()
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a == "--" {
      i += 1
      break
    }
    if !a.starts_with("-") || a == "-" {
      break
    }
    var name = a.trim_prefix("-")
    name = name.trim_prefix("-")
    var value = ""
    var has_value = false
    let eq = name.split("=")
    if eq.len() > 1 {
      value = eq[1..eq.len()].join("=")
      name = eq[0]
      has_value = true
    }
    if name == "h" || name == "help" {
      help(os, o.cmd)
    }
    if vals.contains(name) {
      if !has_value {
        if i + 1 >= args.len() {
          usage(os, o.cmd, "flag needs an argument: -${name}")
        }
        value = args[i + 1]
        i += 1
      }
      set_value(os, o, name, value)
    } else if bools.contains(name) {
      var on = true
      if has_value {
        if value is "true" | "1" | "t" | "T" | "TRUE" | "True" {
          on = true
        } else if value is "false" | "0" | "f" | "F" | "FALSE" | "False" {
          on = false
        } else {
          usage(os, o.cmd, "invalid boolean value \"${value}\" for -${name}: parse error")
        }
      }
      set_bool(os, o, name, on)
    } else {
      usage(os, o.cmd, "flag provided but not defined: -${name}")
    }
    i += 1
  }
  var rest: List[Str] = []
  while i < args.len() {
    rest.push(args[i])
    i += 1
  }
  if o.cmd == "run" {
    // cmd/xo runRun: the directory, then the program's arguments after
    // an optional --
    var dir = "."
    var r = rest
    if !r.is_empty() {
      if r[0] != "--" {
        dir = r[0]
        r = r[1..r.len()]
      }
      if !r.is_empty() && r[0] == "--" {
        r = r[1..r.len()]
      }
    }
    o.dirs = [dir]
    o.prog_args = r
    return o
  }
  o.dirs = if rest.is_empty() { ["."] } else { rest }
  o
}

fn set_value(os: Os, var o: Opts, name: Str, v: Str) {
  if name == "o" {
    o.out = v
  } else if name == "targets" || name == "target" {
    o.targets = v
  } else if name == "backend" {
    o.backend = v
  } else if name == "tzdata" {
    o.tzdata = v
  } else if name == "stamp" {
    let parts = v.split("=")
    if parts.len() < 2 || parts[0].is_empty() {
      usage(os, o.cmd, "invalid value \"${v}\" for flag -stamp: --stamp ${v.quote()}: want NAME=VALUE (NAME is a `const NAME: Str` of the main module)")
    }
    var kept: List[(Str, Str)] = []
    for (n, x) in o.stamps {
      if n != parts[0] {
        kept.push((n, x))
      }
    }
    kept.push((parts[0], parts[1..parts.len()].join("=")))
    o.stamps = kept
  } else if name == "seed" {
    o.topts.seed = int_flag(os, o.cmd, name, v)
  } else if name == "explore" {
    o.explore = int_flag(os, o.cmd, name, v)
  } else if name == "cases" {
    o.topts.cases = int_flag(os, o.cmd, name, v)
  } else if name == "timeout" {
    o.topts.timeout = match Duration.parse(v) {
      Ok(d) => d
      Err(_) => usage(os, o.cmd, "invalid value \"${v}\" for flag -${name}: parse error")
    }
  } else if name == "record" {
    o.record = v
  } else if name == "profile" {
    // decision 0238: the CPU profile, the heap profile, or both
    if v != "cpu" && v != "heap" && v != "cpu,heap" && v != "heap,cpu" {
      usage(os, o.cmd, "invalid value \"${v}\" for flag -profile: want cpu, heap, or cpu,heap")
    }
    o.profile = v
    o.topts.profile = v
  } else if name == "run" {
    o.topts.run = v
  } else if name == "std" {
    o.std = v
  } else if name == "wd" {
    o.wd = v
  } else if name == "cc" {
    o.cc = look_path(os, v)
  } else if name == "asm" {
    o.asm_path = v
  } else if name == "as" {
    o.assembler = v
  } else if name == "ld" {
    o.linker = v
    if v == "macho" {
      o.assembler = "macho"
    }
  } else if name == "go-tree" {
    o.go_tree = v
  } else if name == "workspace" {
    // cmd/xo moduleFlags: XO_WORK for this run
    if v == "off" {
      o.workspace = "off"
    } else if v is "on" | "auto" {
      o.workspace = "on"
    } else {
      os.stdio.eprintln("xo ${o.cmd}: --workspace=${v}: want off or on")
      os.proc.exit(2)
    }
  }
}

fn set_bool(os: Os, var o: Opts, name: Str, on: Bool) {
  if name == "json" {
    o.json = on
    o.topts.json = on
  } else if name == "ci" {
    o.ci = on
  } else if name == "release" {
    o.release = on
  } else if name == "s" {
    o.strip = on
  } else if name == "debug-info" {
    o.debug_info = on
  } else if name == "error-args" {
    o.error_args = on
  } else if name == "hybrid" {
    o.hybrid = on
  } else if name == "mono" {
    o.no_mono = o.no_mono || !on
  } else if name == "no-mono" {
    o.no_mono = on
  } else if name == "arenas" {
    o.no_arenas = o.no_arenas || !on
  } else if name == "no-arenas" {
    o.no_arenas = on
  } else if name == "no-gc" {
    o.no_gc = on
  } else if name == "holes" {
    o.holes = on
  } else if name == "race" {
    o.race = on
  } else if name == "v" {
    o.topts.verbose = on
  } else if name == "real" {
    o.real = on
    o.topts.real = on
  } else if name == "phase-times" {
    o.phases = on
  } else if name == "offline" {
    o.offline = if on { "1" } else { "0" }
  }
}

fn int_flag(os: Os, cmd: Str, name: Str, v: Str) -> Int {
  match Int.parse(v) {
    Some(n) => n
    None => usage(os, cmd, "invalid value \"${v}\" for flag -${name}: parse error")
  }
}
