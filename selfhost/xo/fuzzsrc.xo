// Native contract fuzzing (decision 0250): each contract fuzz target of
// the Go backend (gen.contract_fuzz_targets) as a property test in a
// generated test file beside its source file, held in the checker's
// overlay (never written): `test "contract fuzz: F" for p: T, ... {
// if !(REQUIRES) { return } F(p, ...) }`. The native test binary then
// runs it as any property test: generated inputs, cases, shrinking.

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/gen
use github.com/xo-lang/xo/selfhost/parser

/// A contract fuzz test's regression data (rt.RegressRecord's call,
/// result, and parameters) and where its target is.
struct FuzzMeta {
  /// the call with {i} for the i-th parameter, `{0}.m(...)` for a method
  call: Str
  /// "result" (an error result), "value", or "unit"
  result: Str
  names: List[Str] = []
  caps: List[Str] = []
  vars: List[Bool] = []
  /// the target's `file:line:col`, the test's location in reports
  loc: Str = ""
}

/// A generated test: its name, the target object, the overlay file and
/// lines it occupies, and its metadata.
struct FuzzGen {
  name: Str
  fo: Int
  path: Str
  first: Int
  last: Int
  meta: FuzzMeta
}

/// The generated test file of the source file at path (absolute):
/// `<dir>/<base>.xo_contract_fuzz_test.xo` (no user file is named so).
fn fuzz_path(path: Str) -> Str {
  let base = path.trim_suffix(".xo")
  "${base}.xo_contract_fuzz_test.xo"
}

/// Whether path is a generated contract fuzz test file.
fn is_fuzz_path(path: Str) -> Bool { path.ends_with(".xo_contract_fuzz_test.xo") }

/// The source text of span in src.
fn span_text(src: Bytes, sp: parser.Span) -> Str {
  if sp.start.offset < 0 || sp.end.offset > src.len() || sp.start.offset >= sp.end.offset {
    return ""
  }
  src[sp.start.offset..sp.end.offset].to_str() ?? ""
}

/// The overlay (absolute path to source) and the tests it holds, for the
/// contract fuzz targets of c not in skip (by name: targets whose test did
/// not check once).
fn fuzz_sources(c: check.Checker, wd: Str, skip: Map[Str, Bool], var why: Map[Str, Str]) -> (Map[Str, Bytes], List[FuzzGen]) {
  var files: Map[Str, Str] = {}
  var lines: Map[Str, Int] = {}
  var gens: List[FuzzGen] = []
  for ft in gen.contract_fuzz_targets(c) {
    if skip.contains(ft.name) {
      continue
    }
    let o = c.objs[ft.fo]
    if o.fn_decl.is_empty() {
      continue
    }
    let fd = o.fn_decl[0]
    // the target's file: its source and use declarations
    var fi = -1
    for (k, f) in c.files.indexed() {
      if f.path == o.file {
        fi = k
      }
    }
    if fi < 0 {
      continue
    }
    let file = c.files[fi]
    let src = file.src
    let path = fuzz_path(abs_path(wd, file.path))
    if !files.contains(path) {
      var b = StrBuilder.new()
      b.write("// Generated by xo test: contract fuzzing (decision 0250).\n")
      var n = 1
      for u in file.ast.imports {
        let t = span_text(src, u.span)
        if !t.is_empty() {
          b.write(t)
          b.write("\n")
          n += 1
        }
      }
      b.write("\n")
      n += 1
      files[path] = b.freeze()
      lines[path] = n
    }
    // the parameters: the receiver, then the declared ones, as written
    var names: List[Str] = []
    var types: List[Str] = []
    var vars: List[Bool] = []
    var caps: List[Str] = []
    var ok = true
    var recv = false
    if let Some(r) = fd.recv {
      recv = true
      names.push(r.name.name.to_str() ?? "")
      types.push(span_text(src, parser.type_span(r.typ)))
      vars.push(r.is_var)
      caps.push("")
    }
    for p in fd.params {
      let ty = match p.typ {
        Some(t) => span_text(src, parser.type_span(t))
        None => ""
      }
      names.push(p.name.name.to_str() ?? "")
      types.push(ty)
      vars.push(p.is_var)
      caps.push(cap_of(ty))
    }
    for (k, t) in types.indexed() {
      if caps[k] == "os" {
        ok = false
        why[ft.name] = "it takes `${names[k]}: Os`, which a test cannot pass"
      } else if t.is_empty() || names[k].is_empty() {
        ok = false
        why[ft.name] = "a parameter's name or type is not in its source"
      }
    }
    if !ok {
      continue
    }
    var reqs: List[Str] = []
    for cl in fd.clauses {
      if let RequiresClause(cond: cond, ..) = cl {
        reqs.push(span_text(src, parser.expr_span(cond)))
      }
    }
    // the test
    let fname = fd.name.name.to_str() ?? ""
    let first = lines.get(path) ?? 1
    var gen_ps: List[Str] = []
    for (k, n) in names.indexed() {
      if caps[k].is_empty() {
        gen_ps.push("${n}: ${types[k]}")
      }
    }
    var text = StrBuilder.new()
    if gen_ps.is_empty() {
      text.write("test ${ft.name.quote()} {\n")
    } else {
      text.write("test ${ft.name.quote()} for ${gen_ps.join(", ")} {\n")
    }
    var cond: List[Str] = []
    for r in reqs {
      cond.push("(${r})")
    }
    // capabilities from the test's os; var parameters as var locals
    var args: List[Str] = []
    for (k, n) in names.indexed() {
      if !caps[k].is_empty() {
        text.write("  let ${n} = os.${caps[k]}\n")
      }
    }
    if !cond.is_empty() {
      text.write("  if !(${cond.join(" && ")}) {\n    return\n  }\n")
    }
    for (k, n) in names.indexed() {
      if vars[k] && caps[k].is_empty() {
        text.write("  var fz_${n} = ${n}\n")
        args.push("fz_${n}")
      } else {
        args.push(n)
      }
    }
    var call = ""
    var tmpl = ""
    if recv {
      call = "${args[0]}.${fname}(${args[1..args.len()].join(", ")})"
      var ph: List[Str] = []
      for k in 1..names.len() {
        ph.push("{${k}}")
      }
      tmpl = "{0}.${fname}(${ph.join(", ")})"
    } else {
      call = "${fname}(${args.join(", ")})"
      var ph: List[Str] = []
      for k in 0..names.len() {
        ph.push("{${k}}")
      }
      tmpl = "${fname}(${ph.join(", ")})"
    }
    var result = "unit"
    if fd.err != None {
      result = "result"
      text.write("  ${call}.ignore_err(\"contract fuzz: only a fault fails this test\")\n")
    } else if fd.result != None {
      result = "value"
      text.write("  let _ = ${call}\n")
    } else {
      text.write("  ${call}\n")
    }
    text.write("}\n\n")
    let t = text.freeze()
    files[path] = (files.get(path) ?? "") + t
    let n = t.split("\n").len() - 1
    lines[path] = first + n
    let loc = "${o.file}:${fd.span.start.line}:${fd.span.start.col}"
    gens.push(FuzzGen{name: ft.name, fo: ft.fo, path: path, first: first, last: first + n - 1, meta: FuzzMeta{call: tmpl, result: result, names: names, caps: caps, vars: vars, loc: loc}})
  }
  var out: Map[Str, Bytes] = {}
  for p in files.keys() {
    out[p] = (files.get(p) ?? "").bytes()
  }
  (out, gens)
}

/// The TestOs field of a capability parameter's type as written, "" for
/// none, "os" for Os (gen cap_field).
fn cap_of(ty: Str) -> Str {
  match ty {
    "Net" | "Fs" | "Clock" | "Rand" | "Env" | "Proc" | "Stdio" => ty.to_lower()
    "Os" => "os"
    _ => ""
  }
}

/// The generated contract fuzz tests of a native `xo test`, and the
/// targets dropped (their test did not check) with the first reason.
struct FuzzSet {
  gens: List[FuzzGen] = []
  dropped: Map[Str, Str] = {}
}

/// Whether diagnostic file f (as the checker reports it) is the
/// generated file at path (absolute).
fn same_file(path: Str, wd: Str, f: Str) -> Bool {
  path == abs_path(wd, f) || path.ends_with("/" + f.trim_prefix("./"))
}

/// The program checked again with its contract fuzz targets as generated
/// property tests (decision 0250), and the set: a test that does not
/// check is dropped (and counted as not fuzzed) and the rest checked
/// again, at most three times; with none left, c as it was.
fn fuzz_check(os: Os, o: Opts, c: check.Checker) -> (check.Checker, FuzzSet) {
  var skip: Map[Str, Bool] = {}
  var dropped: Map[Str, Str] = {}
  for _ in 0..3 {
    let (ov, gens) = fuzz_sources(c, o.wd, skip, dropped)
    if gens.is_empty() {
      return (c, FuzzSet{dropped: dropped})
    }
    let (c2, gd) = check_program_ov(os, o, true, ov)
    var again = false
    for d in gd {
      // an unused name (the copied `use` lines the tests do not need)
      // does not change the tests
      if d.warning || d.code == "XO0110" {
        continue
      }
      var hit = false
      for g in gens {
        if same_file(g.path, o.wd, d.file) && d.line >= g.first && d.line <= g.last {
          hit = true
          if !skip.contains(g.name) {
            skip[g.name] = true
            dropped[g.name] = "its generated test does not check (${d.code}: ${d.message})"
            again = true
          }
        }
      }
      if !hit {
        // outside every test (the copied `use` lines): the file's tests
        for g in gens {
          if same_file(g.path, o.wd, d.file) && !skip.contains(g.name) {
            skip[g.name] = true
            dropped[g.name] = "its generated test does not check (${d.code}: ${d.message})"
            again = true
          }
        }
      }
    }
    if !again {
      return (c2, FuzzSet{gens: gens, dropped: dropped})
    }
  }
  (c, FuzzSet{dropped: dropped})
}
