// Zone data per use (internal/build tzdata.go, std.md 13, decisions 0094
// and 0157): a native program that uses std/time is compiled with
// xo_tzdata.c beside the runtime (so the runtime's object
// does not depend on the program). xo_tz_mode is 0 with the TZif data of
// each constant zone name `time.zone` is called with, 1 with the whole
// zoneinfo.zip when a name is known only at run time, 2 with
// --tzdata=system (the host's database). The data comes from Go's
// lib/time/zoneinfo.zip: $XO_ZONEINFO, else the copy a release ships
// beside the runtime pack (lib/xo/zoneinfo.zip, decision 0157 next step
// 1), else `go env GOROOT`'s, as the Go driver's does.

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/ssa

/// What a program needs of the zone database (ssa.TZUse): the constant
/// names, sorted, and the calls whose name is known only at run time.
struct TZUse {
  names: List[Str] = []
  dynamic: List[Str] = []
}

/// The zone use of the program b built. The Go builder notes each call
/// of std/time's `zone` it lowers: a constant name argument by name, any
/// other argument (or `time.zone` as a function value) by position. This
/// takes the calls from the module xo1 built (so only reachable code
/// counts, as there) and asks the source whether each constant argument
/// was written as a string literal: the SSA builder folds `let n = "X"`
/// into the constant too, which the Go builder counts as dynamic.
fn tz_use(c: check.Checker, m: ssa.Module, root: Str) -> TZUse {
  var ssa_names: List[Str] = []
  var ssa_dynamic = false
  for f in m.funcs {
    for v in f.values {
      let is_zone = match v.aux {
        ssa.Aux.S(s: s) => s == "time.zone"
        _ => false
      }
      if !is_zone || f.name == "time.zone" {
        continue
      }
      if v.op != ssa.Op.Call {
        ssa_dynamic = true
        continue
      }
      var name = ""
      var known = false
      if v.args.len() > 0 && v.args[0] >= 0 && v.args[0] < f.values.len() {
        let a = f.values[v.args[0]]
        if a.op == ssa.Op.Const {
          match a.aux {
            ssa.Aux.S(s: s) => {
              name = s
              known = true
            }
            ssa.Aux.Bs(b: bs) => {
              name = bs.to_str() ?? ""
              known = true
            }
            _ => {}
          }
        }
      }
      if known {
        ssa_names.push(name)
      } else {
        ssa_dynamic = true
      }
    }
  }
  if ssa_names.is_empty() && !ssa_dynamic {
    return TZUse{}
  }
  // the calls in the source: literal names and the positions of the
  // others
  var literal: List[Str] = []
  var at: List[Str] = []
  for rec in c.names {
    if rec.obj < 0 || rec.obj >= c.objs.len() || (rec.name.to_str() ?? "") != "zone" {
      continue
    }
    let o = c.objs[rec.obj]
    if o.kind != check.ObjKind.Func || o.module < 0 {
      continue
    }
    let om = c.mods[o.module]
    if !(om.path == "std/time" || om.implements == "std/time") {
      continue
    }
    var src = b""
    var user = false
    for sf in c.files {
      if sf.path == rec.file {
        src = sf.src
        user = !c.mods[sf.module].is_std
        break
      }
    }
    if !user {
      continue
    }
    match literal_arg(src, rec.offset + 4) {
      Some(s) => literal.push(s)
      None => at.push("${rec.file.trim_prefix(root + "/")}:${rec.line}:${call_col(src, rec.offset, rec.col)}")
    }
  }
  var u = TZUse{}
  for n in ssa_names {
    if literal.contains(n) {
      if !u.names.contains(n) {
        u.names.push(n)
      }
    } else {
      ssa_dynamic = true
    }
  }
  u.names = u.names.sort()
  if ssa_dynamic {
    u.dynamic = at.sort()
    if u.dynamic.is_empty() {
      u.dynamic = ["time.zone"]
    }
  }
  u
}

/// The string literal argument of the call whose callee name ends at i:
/// `zone("Europe/Paris")` (spaces allowed); None for anything else.
fn literal_arg(src: Bytes, i0: Int) -> Str? {
  var i = skip_space(src, i0)
  if i >= src.len() || src[i] != '(' {
    return None
  }
  i = skip_space(src, i + 1)
  if i >= src.len() || src[i] != '"' {
    return None
  }
  let start = i + 1
  var j = start
  while j < src.len() && src[j] != '"' {
    if src[j] == '\\' || src[j] == '\n' {
      return None
    }
    j += 1
  }
  if j >= src.len() {
    return None
  }
  let k = skip_space(src, j + 1)
  if k >= src.len() || src[k] != ')' {
    return None
  }
  src[start..j].to_str()
}

fn skip_space(src: Bytes, i0: Int) -> Int {
  var i = i0
  while i < src.len() && (src[i] == ' ' || src[i] == '\t' || src[i] == '\n' || src[i] == '\r') {
    i += 1
  }
  i
}

/// The column of the call whose callee name starts at offset (column
/// col): the start of its qualifier when it is `time.zone`.
fn call_col(src: Bytes, offset: Int, col: Int) -> Int {
  if offset < 1 || src[offset - 1] != '.' {
    return col
  }
  var i = offset - 1
  while i > 0 && is_ident_byte(src[i - 1]) {
    i -= 1
  }
  col - (offset - i)
}

fn is_ident_byte(c: UInt8) -> Bool {
  let n = Int(c)
  n == 95 || (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}

/// The zone data a program embeds (tzSel): mode 0, 1, or 2 as
/// xo_tz_mode, the whole database (mode 1), the constant names with data
/// and their TZif data (mode 0), and the build notes.
struct TZSel {
  mode: Int = 0
  zip: Bytes = b""
  names: List[Str] = []
  data: List[Bytes] = []
  notes: List[Str] = []
  err: Str = ""
}

/// tzSelect for the native backends; tzdata is --tzdata ("" or
/// "embedded", or "system").
fn tz_select(os: Os, tu: TZUse, tzdata: Str) -> TZSel {
  if tzdata == "system" {
    if tu.names.is_empty() && tu.dynamic.is_empty() {
      return TZSel{}
    }
    return TZSel{mode: 2}
  }
  var names: List[Str] = []
  for n in tu.names {
    if n != "UTC" && n != "" && n != "Local" {
      names.push(n)
    }
  }
  if names.is_empty() && tu.dynamic.is_empty() {
    return TZSel{}
  }
  let (zip, err) = zoneinfo_zip(os)
  if !err.is_empty() {
    return TZSel{err: err}
  }
  if !tu.dynamic.is_empty() {
    var notes: List[Str] = []
    for at in tu.dynamic {
      notes.push("${at}: note: time.zone with a name known only at run time embeds the whole zone database (${(zip.len() + 512) / 1024} KB); pass a constant name to embed only that zone, or build with --tzdata=system to read the host's database")
    }
    return TZSel{mode: 1, zip: zip, notes: notes}
  }
  var sel = TZSel{}
  for n in names {
    match zip_entry(zip, n) {
      Ok(Some(d)) => {
        sel.names.push(n)
        sel.data.push(d)
      }
      Ok(None) => sel.notes.push("note: zone ${n.quote()} is not in the zone database; time.zone returns ZoneErr.Unknown for it")
      Err(e) => return TZSel{err: "zone data: ${e}"}
    }
  }
  sel
}

/// zoneinfoZip: $XO_ZONEINFO, else the zoneinfo.zip a release ships
/// (shipped_zoneinfo), else the one of `go env GOROOT`; the data and an
/// error text.
fn zoneinfo_zip(os: Os) -> (Bytes, Str) {
  var path = os.env.get("XO_ZONEINFO") ?? ""
  if path.is_empty() {
    path = shipped_zoneinfo(os)
  }
  if path.is_empty() {
    let gocmd = os.env.get("XO_GO") ?? "go"
    match os.proc.run(gocmd, ["env", "GOROOT"]) {
      Ok(r) => {
        if r.code != 0 {
          return (b"", "zone data: cannot find GOROOT: exit status ${r.code} (a release has lib/xo/zoneinfo.zip; set XO_ZONEINFO to a zoneinfo.zip, or build with --tzdata=system)")
        }
        path = "${(r.stdout.to_str() ?? "").trim()}/lib/time/zoneinfo.zip"
      }
      Err(e) => return (b"", "zone data: cannot find GOROOT: ${e} (a release has lib/xo/zoneinfo.zip; set XO_ZONEINFO to a zoneinfo.zip, or build with --tzdata=system)")
    }
  }
  match os.fs.read(path) {
    Ok(d) => (d, "")
    Err(e) => (b"", "zone data: ${e} (set XO_ZONEINFO to a zoneinfo.zip)")
  }
}

/// The zone database of a release (scripts/release.sh copies Go's
/// zoneinfo.zip to lib/xo/zoneinfo.zip): beside the running binary's
/// lib/xo; "" when it does not exist.
fn shipped_zoneinfo(os: Os) -> Str {
  var cands: List[Str] = []
  let exe = check.executable(os.env, os.fs)
  if !exe.is_empty() {
    cands.push("${dir_name(dir_name(exe))}/lib/xo/zoneinfo.zip")
  }
  for c in cands {
    if os.fs.exists(c).ok() ?? false {
      return c
    }
  }
  ""
}

fn le16(b: Bytes, i: Int) -> Int {
  Int(b[i]) + Int(b[i + 1]) * 256
}

fn le32(b: Bytes, i: Int) -> Int {
  le16(b, i) + le16(b, i + 2) * 65536
}

/// The contents of the named member of a zip archive whose members are
/// stored (Go's zoneinfo.zip is made with `zip -0`); None when there is
/// no such member.
fn zip_entry(z: Bytes, name: Str) -> Bytes? ! Str {
  // the end of central directory record, at most 64 KiB of comment
  var e = z.len() - 22
  while e >= 0 && !(le32(z, e) == 101010256) {
    if z.len() - e > 65536 + 22 {
      return Err("not a zip archive")
    }
    e -= 1
  }
  if e < 0 {
    return Err("not a zip archive")
  }
  let count = le16(z, e + 10)
  var p = le32(z, e + 16)
  let want = name.bytes()
  for _ in 0..count {
    if p + 46 > z.len() || le32(z, p) != 33639248 {
      return Err("bad central directory")
    }
    let method = le16(z, p + 10)
    let csize = le32(z, p + 20)
    let nlen = le16(z, p + 28)
    let xlen = le16(z, p + 30)
    let clen = le16(z, p + 32)
    let off = le32(z, p + 42)
    if z[p + 46..p + 46 + nlen] == want {
      if method != 0 {
        return Err("${name} is compressed (method ${method}); xo1 reads stored members only")
      }
      if off + 30 > z.len() || le32(z, off) != 67324752 {
        return Err("bad local header of ${name}")
      }
      let start = off + 30 + le16(z, off + 26) + le16(z, off + 28)
      return Ok(Some(z[start..start + csize]))
    }
    p += 46 + nlen + xlen + clen
  }
  Ok(None)
}

/// tzSource: xo_tzdata.c in dir for sel; its path.
fn tz_source(os: Os, dir: Str, sel: TZSel) -> Str ! FsErr {
  var b = BytesBuilder.new()
  b.write_str("// Code generated by xo build. DO NOT EDIT.\n// The zone data of the program (decisions 0094, 0157).\n\n#include <stdint.h>\n\n")
  b.write_str("typedef struct {\n\tconst char *name;\n\tconst char *data;\n\tint64_t len;\n} xo_tz_blob;\n\n")
  b.write_str("const int64_t xo_tz_mode = ${sel.mode};\n")
  if sel.mode == 1 {
    b.write_str("const int64_t xo_tz_zip_len = ${sel.zip.len()};\nconst char xo_tz_zip[] =\n")
    c_bytes(b, sel.zip)
    b.write_str(";\n")
  } else {
    b.write_str("const int64_t xo_tz_zip_len = 0;\nconst char xo_tz_zip[1] = {0};\n")
  }
  b.write_str("const xo_tz_blob xo_tz_blobs[] = {\n")
  if sel.mode == 0 {
    for i in 0..sel.names.len() {
      b.write_str("\t{${sel.names[i].quote()},\n")
      c_bytes(b, sel.data[i])
      b.write_str("\t, ${sel.data[i].len()}},\n")
    }
  }
  b.write_str("\t{0, 0, 0},\n};\n")
  // the table std/native/llrt/tzhost.xo reads through rttime.tz_table
  // (work item B27): the mode, the zip and its length, the blobs
  let zl = if sel.mode == 1 { sel.zip.len() } else { 0 }
  b.write_str("\nconst void *const xo_tz_tab[4] = {(const void *)(intptr_t)${sel.mode}, xo_tz_zip, (const void *)(intptr_t)${zl}, xo_tz_blobs};\n")
  b.write_str("int64_t xo_tz_table(void) { return (int64_t)(intptr_t)xo_tz_tab; }\n")
  let path = "${dir}/xo_tzdata.c"
  os.fs.write(path, b.freeze())?
  Ok(path)
}

/// cBytes: data as C string literals, printable ASCII as is, other bytes
/// as three digit octal escapes, 64 bytes a line.
fn c_bytes(var b: BytesBuilder, data: Bytes) {
  if data.is_empty() {
    b.write_str("\t\"\"\n")
    return
  }
  var i = 0
  while i < data.len() {
    b.write_str("\t\"")
    var j = i
    let end = if i + 64 < data.len() { i + 64 } else { data.len() }
    while j < end {
      let c = Int(data[j])
      if c == 34 || c == 92 || c == 63 {
        b.write_byte(UInt8(92))
        b.write_byte(data[j])
      } else if c >= 32 && c < 127 {
        b.write_byte(data[j])
      } else {
        b.write_byte(UInt8(92))
        b.write_byte(UInt8(48 + c / 64))
        b.write_byte(UInt8(48 + c / 8 % 8))
        b.write_byte(UInt8(48 + c % 8))
      }
      j += 1
    }
    b.write_str("\"\n")
    i += 64
  }
}
