// `xo rtpack` (cmd/xo rtpack.go, internal/build BuildRTPack; decision
// 0157): the prebuilt runtime of the arm64 backend for a release.
//
//   xo rtpack [--target=os/arch] [--cc="cmd args"] [-o dir]
//   xo rtpack --status
//   xo rtpack --key [--target=os/arch]
//
// The first form compiles every variant of the C runtime (std/llrt)
// into dir/<os>-<arch> (default lib/xo/rtpack) with the manifest
// rtpack.json; scripts/release.sh runs it (the TLS library and its
// archive went with Mbed TLS, 2026-10-15). --cc is a command line split
// at spaces (a cross compiler for another target). --status prints the pack this xo uses for the host; --key the
// key a pack for the target must have.

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/cli/core
use std/crypto

fn rtpack_cmd(os: Os, args: List[Str]) -> Int {
  let goos = host_os(os)
  let std_dir = check.std_dir(os.env, os.fs)
  let ctx = Ctx{goos: goos, std: std_dir, xo: dir_name(std_dir.trim_suffix("/")), cache: user_cache_dir(os, goos)}
  var fl = core.new_flags("rtpack")
  fl.str_flag("target", "${goos}/${host_arch()}", "target os/arch")
  fl.str_flag("cc", "", "C compiler command (default the host's C compiler)")
  fl.str_flag("o", "lib/xo/rtpack", "pack root")
  fl.bool_flag("status", "print the pack this xo uses for the host")
  fl.bool_flag("key", "print the key of a pack for the target")
  if !fl.parse(os, args) {
    return 2
  }
  if !fl.args.is_empty() {
    os.stdio.eprintln("usage: xo rtpack [--target=os/arch] [--cc=cmd] [-o dir] | --status | --key")
    return 2
  }
  if fl.get_bool("status") {
    os.stdio.println(rtpack_status(os, ctx, ctx.std))
    return 0
  }
  // build.ParseTargets of one target
  let target = fl.get_str("target")
  let tparts = target.trim().split("/")
  if target.contains(",") || target == "all" || tparts.len() != 2 || tparts[0].is_empty() || tparts[1].is_empty() {
    os.stdio.eprintln("xo rtpack: bad --target ${core.go_quote(target)}")
    return 2
  }
  var tos = tparts[0]
  var tarch = tparts[1]
  if tos == "wasi" {
    tos = "wasip1"
  }
  if tarch == "wasm32" {
    tarch = "wasm"
  }
  if fl.get_bool("key") {
    match rtpack_key_for(os, ctx, ctx.std, tos, tarch) {
      Ok(k) => os.stdio.println(k)
      Err(e) => {
        os.stdio.eprintln("xo rtpack: ${e}")
        return 1
      }
    }
    return 0
  }
  let (dir, err) = build_rtpack(os, ctx, tos, tarch, words(fl.get_str("cc")), fl.get_str("o"))
  if !err.is_empty() {
    os.stdio.eprintln("xo rtpack: ${err}")
    return 1
  }
  os.stdio.println(dir)
  0
}

/// strings.Fields.
fn words(s: Str) -> List[Str] {
  var out: List[Str] = []
  for w in s.replace("\t", " ").replace("\n", " ").split(" ") {
    if !w.is_empty() {
      out.push(w)
    }
  }
  out
}

/// BuildRTPack: every variant of the runtime compiled with rtpack_flags
/// into a work directory mapped to /xo (-ffile-prefix-map), the manifest
/// written, and the directory moved to out/<os>-<arch>. Returns that
/// directory, or an error text.
fn build_rtpack(os: Os, ctx: Ctx, tos: Str, tarch: Str, cc0: List[Str], out: Str) -> (Str, Str) {
  if !(tarch == "arm64" && (tos == "darwin" || tos == "linux")) {
    return ("", "prebuilt runtimes are built for [darwin/arm64 linux/arm64], not ${tos}/${tarch}")
  }
  var cc = cc0
  if cc.is_empty() {
    if tos != ctx.goos || host_arch() != "arm64" {
      return ("", "building the runtime for ${tos}/${tarch} on ${ctx.goos}/${host_arch()} needs a cross compiler (--cc, for example \"zig cc -target aarch64-linux-gnu.2.31\")")
    }
    let c = find_cc(os)
    if c.is_empty() {
      return ("", "the arm64 backend needs a C compiler to assemble and link: install one (macOS: xcode-select --install; Debian or Ubuntu: apt-get install gcc, or clang) or set XO_CC")
    }
    cc = [c]
  }
  let key = match rtpack_key(os, ctx, ctx.std, tos) {
    Ok(k) => k
    Err(e) => return ("", "${e}")
  }
  // the work directory (os.MkdirTemp("", "xo-rtpack-"))
  var tmp_root = os.env.get("TMPDIR") ?? ""
  if tmp_root.is_empty() {
    tmp_root = "/tmp"
  }
  let work = "${tmp_root.trim_suffix("/")}/xo-rtpack-${os.rand.bytes(6).to_hex()}"
  let (dir, err) = build_rtpack_in(os, ctx, work, tos, cc, key, out)
  os.fs.remove_all(work).ignore_err("a temporary directory")
  (dir, err)
}

fn build_rtpack_in(os: Os, ctx: Ctx, work: Str, tos: Str, cc: List[Str], key: Str, out: Str) -> (Str, Str) {
  // the sources: the runtime (writeRuntime: std/llrt/*.c)
  let llrt = "${work}/llrt"
  match os.fs.create_dir_all(llrt) {
    Ok(_) => {}
    Err(e) => return ("", "${e}")
  }
  let ents = match os.fs.read_dir("${ctx.std}/llrt") {
    Ok(es) => es
    Err(e) => return ("", "${e}")
  }
  for fi in ents {
    if fi.is_dir || !fi.name.ends_with(".c") {
      continue
    }
    match os.fs.read("${ctx.std}/llrt/${fi.name}") {
      Ok(data) => match os.fs.write("${llrt}/${fi.name}", data) {
        Ok(_) => {}
        Err(e) => return ("", "${e}")
      }
      Err(e) => return ("", "${e}")
    }
  }
  let rt = "${llrt}/xo_rt.c"
  let stage = "${work}/pack"
  match os.fs.create_dir_all(stage) {
    Ok(_) => {}
    Err(e) => return ("", "${e}")
  }
  let base = rtpack_flags(tos) + ["-ffile-prefix-map=${work}=/xo"]
  // the variants
  var cmds: List[List[Str]] = []
  var labels: List[Str] = []
  for i in 0..VARIANTS {
    let args = cc + base + variant_defines(i)
    cmds.push(args + ["-c", "-o", "${stage}/${variant_file(i)}", rt])
    labels.push("compiling the runtime (${variant_file(i)})")
  }
  let failed = run_jobs(os, "${work}/jobs", cmds, labels)
  if !failed.is_empty() {
    return ("", failed)
  }
  // the manifest (json.MarshalIndent with a tab); the compiler is the
  // first line of its --version output whatever its exit status (zig cc
  // prints its version and fails on a glibc version in the target)
  var compiler = ""
  match os.proc.run(cc[0], cc[1..] + ["--version"]) {
    Ok(r) => compiler = ((r.stdout.to_str() ?? "").split("\n")[0]).trim()
    Err(_) => {}
  }
  let names = match os.fs.read_dir(stage) {
    Ok(es) => es.map(fn(e) { e.name }).sort()
    Err(e) => return ("", "${e}")
  }
  var files: List[Str] = []
  for n in names {
    match os.fs.read("${stage}/${n}") {
      Ok(data) => files.push("\t\t${core.jstr_html(n)}: \"${crypto.sha256(data).to_hex()}\"")
      Err(e) => return ("", "${e}")
    }
  }
  let flags = rtpack_flags(tos).map(fn(f: Str) -> Str { "\t\t${core.jstr_html(f)}" })
  let m = "{\n\t\"format\": 2,\n\t\"target\": ${core.jstr_html("${tos}/arm64")},\n\t\"key\": ${core.jstr_html(key)},\n\t\"compiler\": ${core.jstr_html(compiler)},\n\t\"flags\": [\n${flags.join(",\n")}\n\t],\n\t\"files\": {\n${files.join(",\n")}\n\t}\n}\n"
  match os.fs.write("${stage}/rtpack.json", m.bytes()) {
    Ok(_) => {}
    Err(e) => return ("", "${e}")
  }
  let dst = core.join_path(out, "${tos}-arm64")
  match os.fs.create_dir_all(out) {
    Ok(_) => {}
    Err(e) => return ("", "${e}")
  }
  match os.fs.remove_all(dst) {
    Ok(_) => {}
    Err(e) => return ("", "${e}")
  }
  match os.fs.rename(stage, dst) {
    Ok(_) => {}
    Err(_) => {
      // another file system: copy
      match os.fs.create_dir_all(dst) {
        Ok(_) => {}
        Err(e) => return ("", "${e}")
      }
      for n in names + ["rtpack.json"] {
        match os.fs.read("${stage}/${n}") {
          Ok(data) => match os.fs.write("${dst}/${n}", data) {
            Ok(_) => {}
            Err(e) => return ("", "${e}")
          }
          Err(e) => return ("", "${e}")
        }
      }
    }
  }
  (dst, "")
}

/// run_jobs runs each command of cmds (its words) from a shell script
/// under job_dir, as many at once as the host has cores (`xargs -P`), and
/// returns "" when every one succeeds, else the first failed one's output
/// followed by its label. job_dir is removed after.
fn run_jobs(os: Os, job_dir: Str, cmds: List[List[Str]], labels: List[Str]) -> Str {
  match os.fs.create_dir_all(job_dir) {
    Ok(_) => {}
    Err(e) => return "${e}"
  }
  var list = StrBuilder.new()
  for (i, words) in cmds.indexed() {
    var line = StrBuilder.new()
    var first = true
    for w in words {
      if !first {
        line.write(" ")
      }
      first = false
      line.write(sh_q(w))
    }
    let log = "${job_dir}/${i}.log"
    let script = "${job_dir}/${i}.sh"
    let body = "${line.freeze()} > ${sh_q(log)} 2>&1 || { echo ${sh_q(labels[i])} >> ${sh_q(log)}; exit 1; }\nrm -f ${sh_q(log)}\n"
    match os.fs.write(script, body.bytes()) {
      Ok(_) => {}
      Err(e) => return "${e}"
    }
    list.write("${script}\n")
  }
  match os.fs.write("${job_dir}/all", list.freeze().bytes()) {
    Ok(_) => {}
    Err(e) => return "${e}"
  }
  let (n, _) = combined(os, "getconf", ["_NPROCESSORS_ONLN"])
  var jobs = Int.parse(n.trim()) ?? 4
  if jobs < 1 {
    jobs = 1
  }
  let (out, err) = combined(os, "sh", ["-c", "xargs -P ${jobs} -n 1 sh < ${sh_q(job_dir + "/all")}"])
  var failed = ""
  if !err.is_empty() {
    // the first failed command's output
    for k in 0..cmds.len() {
      if failed.is_empty() {
        failed = os.fs.read_text("${job_dir}/${k}.log").ok() ?? ""
      }
    }
    if failed.is_empty() {
      failed = "${labels.join(", ")}: ${err}\n${out}"
    }
  }
  os.fs.remove_all(job_dir).ignore_err("only space")
  failed
}
