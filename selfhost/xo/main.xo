// xo1: the self hosted compiler driver of the switch-over experiment
// (decision 0158): the lexer, parser, checker, SSA builder and its
// passes, and the arm64 emitter, all in Xo, then the system C compiler
// driver to assemble and link with the C runtime (std/llrt), as
// internal/build does for `xo build --backend=arm64` (decision 0174).
//
//   xo1 build [flags] [-o OUT] [--asm=PATH] [--target=OS/arm64] <dir>
//   xo1 build --backend=go [flags] [-o OUT] [--go-tree=DIR] <dir>
//   xo1 build --backend=wasm [flags] [-o OUT.wasm] <dir>   (wasm.xo)
//   xo1 test [flags] [--run=SUB] [--seed=N] [--cases=N] [--json] [-v] <dir>
//   xo1 asm [--std=DIR] [--wd=DIR] [--target=OS/arm64] <dir>
//   xo1 keys [--std=DIR] [--cc=CC]   the cache keys, to compare
//
// flags: --std=DIR --wd=DIR --cc=CC --tzdata=embedded|system
//
// --backend=go (decision 0167) checks and generates Go with selfhost/gen
// and builds it with the Go toolchain (gobackend.xo); the build tree
// (generated packages, runtime, build information) goes to --go-tree,
// default OUT.go.d.
//
// The runtime sources are read from DIR/llrt (DIR the std directory,
// default std), the TLS library's from DIR/../third_party. A link takes
// the runtime from a prebuilt pack or the runtime object cache, the TLS
// library of std/http, the zone data of std/time, and the C inputs of
// `use c`, keyed as internal/build keys them, so both drivers share the
// caches. A target other than the host gets its assembly only, as
// internal/build does. It is not the released `xo` (decision 0150: that
// is the owner's decision after the fixed point).

use github.com/xo-lang/xo/selfhost/check
use github.com/xo-lang/xo/selfhost/ssa
use github.com/xo-lang/xo/selfhost/arm64

fn main(os: Os) ! {
  let args = os.env.args()
  if args.is_empty() || !(args[0] is "build" | "asm" | "keys" | "test") {
    os.stdio.eprintln("usage: xo1 build|test|asm|keys [--std=DIR] [--wd=DIR] [--cc=CC] [--tzdata=embedded|system] [--target=OS/arm64] [--backend=arm64|go|wasm] [--go-tree=DIR] [-o OUT] [--asm=PATH] <dir>")
    os.proc.exit(2)
  }
  let cmd = args[0]
  var std_dir = "std"
  var wd = os.env.get("PWD") ?? ""
  var cc = ""
  var out = ""
  var asm_path = ""
  var tzdata = ""
  var target = ""
  var topts = TestOpts{}
  var backend = "arm64"
  var go_tree = ""
  var dirs: List[Str] = []
  var i = 1
  while i < args.len() {
    let a = args[i]
    if a.starts_with("--std=") {
      std_dir = a.trim_prefix("--std=")
    } else if a.starts_with("--wd=") {
      wd = a.trim_prefix("--wd=")
    } else if a.starts_with("--cc=") {
      cc = look_path(os, a.trim_prefix("--cc="))
    } else if a.starts_with("--tzdata=") {
      tzdata = a.trim_prefix("--tzdata=")
    } else if a.starts_with("--asm=") {
      asm_path = a.trim_prefix("--asm=")
    } else if a.starts_with("--backend=") {
      backend = a.trim_prefix("--backend=")
    } else if a.starts_with("--go-tree=") {
      go_tree = a.trim_prefix("--go-tree=")
    } else if a.starts_with("--target=") || a.starts_with("--targets=") {
      target = a.split("=")[1]
    } else if a.starts_with("--run=") {
      topts.run = a.trim_prefix("--run=")
    } else if a.starts_with("--seed=") {
      topts.seed = Int.parse(a.trim_prefix("--seed=")) ?? 0
    } else if a.starts_with("--cases=") {
      topts.cases = Int.parse(a.trim_prefix("--cases=")) ?? 0
    } else if a == "--json" {
      topts.json = true
    } else if a == "-v" {
      topts.verbose = true
    } else if a == "-o" && i + 1 < args.len() {
      out = args[i + 1]
      i += 1
    } else {
      dirs.push(a)
    }
    i += 1
  }
  let goos = host_os(os)
  let ctx = Ctx{goos: goos, std: std_dir, xo: dir_name(std_dir.trim_suffix("/")), cache: user_cache_dir(os, goos)}
  if cmd == "keys" {
    keys(os, ctx, cc)?
    return
  }
  // the target: the host, or linux/arm64 (assembly only)
  var tgoos = goos
  if !target.is_empty() {
    if !(target is "darwin/arm64" | "linux/arm64") {
      fail(os, "the arm64 backend builds for darwin/arm64 and linux/arm64, not ${target}")
    }
    tgoos = target.split("/")[0]
  }
  if dirs.len() != 1 {
    os.stdio.eprintln("xo1: name one directory")
    os.proc.exit(2)
  }
  if backend == "go" && cmd == "build" {
    if !target.is_empty() {
      fail(os, "--backend=go builds for the host only here")
    }
    build_go(os, std_dir, wd, out, go_tree, tzdata, dirs[0])?
    return
  }
  if backend != "arm64" && !(backend == "wasm" && cmd == "build") {
    fail(os, "--backend=${backend}: want arm64, or go or wasm for build")
  }
  var c = check.new_checker(os.fs, std_dir)
  c.native = true
  c.set_mod_env(wd, os.env.get("XO_MODCACHE") ?? "", os.env.get("HOME") ?? "", os.env.get("XDG_CACHE_HOME") ?? "",
    os.env.get("XO_OFFLINE") ?? "", os.env.get("XO_WORK") ?? "")
  c.cbind_dir = os.env.get("XO_CBIND_DIR") ?? ""
  match c.check_dirs(dirs) {
    Ok(_) => {}
    Err(e) => fail(os, "check: ${e}")
  }
  if !c.unsupported.is_empty() {
    fail(os, "unsupported: ${c.unsupported}")
  }
  for d in c.diags {
    if !d.warning || d.code == "XO0900" {
      fail(os, "the program does not check (run xo check)")
    }
  }
  var uses_time = false
  for m in c.mods {
    uses_time = uses_time || m.path == "native/time"
  }
  let root = line_root(os, wd, dirs[0])
  let tests = cmd == "test"
  var b = ssa.build_program(c, root, tests)
  if !b.why.is_empty() {
    fail(os, b.why)
  }
  for f in b.m.funcs {
    if !f.skip.is_empty() {
      fail(os, "the SSA builder skipped ${f.name}: ${f.skip}")
    }
  }
  // the zone data std/time needs, noted as the Go builder lowers
  let tu = if uses_time { tz_use(c, b.m, root) } else { TZUse{} }
  b.run_passes()
  if backend == "wasm" {
    build_wasm(os, b.m, out, wd, dirs[0])?
    return
  }
  let p = arm64.generate_module(b.m, tgoos, false)
  if !p.err.is_empty() {
    fail(os, p.err)
  }
  if !p.skipped.is_empty() {
    fail(os, "the emitter skipped ${p.skipped[0]}")
  }
  if cmd == "asm" {
    os.stdio.print(p.asm)
    return
  }
  let parts = dirs[0].trim_suffix("/").split("/")
  var name = parts[parts.len() - 1]
  if name == "." || name.is_empty() {
    name = base_name(wd)
  }
  if tests {
    name = "${name}.test"
  }
  if out.is_empty() {
    out = name
    if tests {
      // the test binary goes to the cache, as `xo test` builds it
      let tdir = "${ctx.cache}/xo/xo1-test"
      os.fs.create_dir_all(tdir)?
      out = "${tdir}/${name}"
    }
  }
  if asm_path.is_empty() {
    asm_path = "${out}.s"
  }
  os.fs.write(asm_path, p.asm.bytes())?
  if tgoos != goos {
    // another target: its assembly only (internal/build buildArm64)
    os.stdio.println("${target}: ${asm_path}")
    return
  }
  // the C runtime next to the assembly (writeRuntime)
  let rtdir = "${out}.rt"
  os.fs.create_dir_all(rtdir)?
  for fi in os.fs.read_dir("${std_dir}/llrt")? {
    if fi.name.ends_with(".c") {
      os.fs.write("${rtdir}/${fi.name}", os.fs.read("${std_dir}/llrt/${fi.name}")?)?
    }
  }
  if cc.is_empty() {
    cc = find_cc(os)
    if cc.is_empty() {
      fail(os, "the arm64 backend needs a C compiler to assemble and link: install one (macOS: xcode-select --install; Debian or Ubuntu: apt-get install gcc, or clang) or set XO_CC")
    }
  }
  var flags = ["-O2"]
  var srcs = [asm_path, "${rtdir}/xo_rt.c"]
  // std/time: XO_TIME and the program's zone data beside the runtime
  // (timeFlags)
  if uses_time {
    if !(tzdata == "" || tzdata == "embedded" || tzdata == "system") {
      fail(os, "unknown --tzdata=${tzdata} (want embedded or system)")
    }
    let sel = tz_select(os, tu, tzdata)
    if !sel.err.is_empty() {
      fail(os, sel.err)
    }
    flags.push("-DXO_TIME")
    srcs.push(tz_source(os, rtdir, sel)?)
    for n in sel.notes {
      os.stdio.eprintln(n)
    }
  }
  flags = flags + io_flags(p.asm)
  // the adapters, link files, and libraries of `use c` (cInputs)
  let ci = c_inputs(os, c, rtdir)
  if !ci.err.is_empty() {
    fail(os, ci.err)
  }
  flags = flags + ci.flags
  srcs = srcs + ci.srcs
  let msg = cc_build(os, ctx, cc, flags, srcs, out, needs_tls(p.asm))
  if !msg.is_empty() {
    os.stdio.eprint(msg)
    fail(os, "${cc} failed")
  }
  if tests {
    var bin = out
    if !bin.starts_with("/") {
      bin = "${wd}/${bin}"
    }
    os.proc.exit(run_tests(os, bin, test_infos(c, root, wd), topts))
  }
}

/// `xo1 keys`: the cache keys and directories this driver computes, to
/// compare with the Go driver's (`xo rtpack --key`, the directories under
/// the user cache): the prebuilt runtime keys of both targets, the pack
/// status, the TLS library directory for the C compiler with the SDK of
/// the last link, and the runtime object of a plain program.
fn keys(os: Os, ctx: Ctx, cc0: Str) -> () ! FsErr {
  let cc = if cc0.is_empty() { find_cc(os) } else { cc0 }
  os.stdio.println("rtpack darwin/arm64 ${rtpack_key(os, ctx, ctx.std, "darwin")?}")
  os.stdio.println("rtpack linux/arm64 ${rtpack_key(os, ctx, ctx.std, "linux")?}")
  os.stdio.println(rtpack_status(os, ctx, ctx.std))
  os.stdio.println("tls source ${tls_source_hash(os, ctx.xo)?}")
  var root = ""
  let memo = sysroot_memo(os, ctx)
  if !memo.is_empty() {
    root = (os.fs.read_text(memo).ok() ?? "").trim()
  }
  let (_, dir, err) = tls_dir(os, ctx, cc, [], root)
  os.stdio.println("tls ${dir}${err} (cc ${cc}, sysroot ${root})")
}

/// The directory fault positions are relative to (internal/build
/// lineRoot): the nearest directory holding xo.mod at or above dir, else
/// dir itself, absolute.
fn line_root(os: Os, wd: Str, dir: Str) -> Str {
  var abs = dir.trim_suffix("/")
  if abs.starts_with("./") {
    abs = abs.trim_prefix("./")
  }
  if !abs.starts_with("/") {
    abs = if abs == "." { wd } else { "${wd}/${abs}" }
  }
  var d = abs
  while !d.is_empty() {
    if os.fs.exists("${d}/xo.mod").ok() ?? false {
      return rel_to(wd, d)
    }
    let parts = d.split("/")
    if parts.len() <= 1 {
      break
    }
    d = parts[0..parts.len() - 1].join("/")
  }
  rel_to(wd, abs)
}

/// p relative to wd when it is below it (the checker's file paths are
/// relative to the working directory for relative arguments).
fn rel_to(wd: Str, p: Str) -> Str {
  if p.starts_with("${wd}/") {
    return p.trim_prefix("${wd}/")
  }
  p
}

fn fail(os: Os, msg: Str) -> Never {
  os.stdio.eprintln("xo1: ${msg}")
  os.proc.exit(1)
}
