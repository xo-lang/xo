// The ui-todo client: the App's update and view for the browser, built
// for wasm with the server (its `embed.build`, decision 0663). The std/ui
// runtime runs it on every event to show the predicted page.
use std/ui
use example.com/uitodo/todo

fn main(os: Os) ! {
  ui.client_main(os.stdio, todo.app())?
}
