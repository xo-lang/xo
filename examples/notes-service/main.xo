// notes-service: a small HTTP JSON service with users and expiring notes.
//
// - Users and notes live in std/sql (the in memory driver).
// - The /notes routes sit in their own router behind an auth middleware
//   (mounted, so GET /health needs no exemption). The middleware resolves
//   `Authorization: Bearer <token>` to a User and hands it to handlers as a
//   typed request value; it fails with ApiErr, mapped like handler errors.
// - Tokens are stored as SHA-256 digests and compared in constant time.
// - A background task purges expired notes every PURGE_EVERY.
// - Shutdown is two phase (core 7.5): the first signal stops the server
//   accepting, in flight requests finish, then main returns.
use std/crypto
use std/http
use std/log
use std/sql

const SCHEMA = "CREATE TABLE users (id SERIAL, name TEXT NOT NULL, token_sha256 TEXT NOT NULL UNIQUE); CREATE TABLE notes (id SERIAL, owner INT NOT NULL, body TEXT NOT NULL, created TIMESTAMP NOT NULL, expires TIMESTAMP NOT NULL)"

const PURGE_EVERY = 1m

pub struct User {
  id: Int
  name: Str
}

/// The authenticated user, set by `auth` for the routes behind it.
pub fn user_key() -> http.Key[User] {
  http.key("user")
}

pub struct Note {
  id: Int
  owner: Int
  body: Str
  created: Time
  expires: Time
} derive Json

struct NewNote {
  body: Str
  ttl_secs: Int = 3600
} derive Json

enum ApiErr {
  Unauthorized
  BadRequest(msg: Str)
  NotFound(id: Int)
  Db(from sql.SqlErr)
}

fn (e: ApiErr) status() -> Int {
  match e {
    Unauthorized => 401
    BadRequest(_) => 400
    NotFound(_) => 404
    Db(_) => 500
  }
}

fn (e: ApiErr) display() -> Str {
  match e {
    Unauthorized => "missing or invalid bearer token"
    BadRequest(msg) => msg
    NotFound(id) => "note ${id} not found"
    Db(inner) => "database error: ${inner}"
  }
}

// ---- storage ----

pub fn open_db() -> sql.Db ! sql.SqlErr {
  sql.memory(SCHEMA)
}

/// The stored form of a token: its SHA-256 digest. Tokens are random
/// (crypto.token), so no salt or stretching is needed, and the digest can
/// be looked up by value.
pub fn token_digest(token: Str) -> Bytes {
  crypto.sha256(token.bytes())
}

pub fn add_user(db: sql.Db, name: Str, token: Str) -> Int ! sql.SqlErr uses net.dial {
  db.exec("INSERT INTO users (name, token_sha256) VALUES ($1, $2)", [sql.str(name), sql.str(token_digest(token).to_hex())])?.last_insert_id
}

fn user_for_token(db: sql.Db, token: Str) -> User? ! sql.SqlErr uses net.dial {
  let digest = token_digest(token)
  match db.query_one("SELECT id, name, token_sha256 FROM users WHERE token_sha256 = $1", [sql.str(digest.to_hex())]) {
    Ok(row) => {
      let stored = Bytes.from_hex(row.str("token_sha256")?) ?? b""
      if !crypto.equal(stored, digest) {
        return None
      }
      Some(User{id: row.int("id")?, name: row.str("name")?})
    }
    Err(NoRows) => None
    Err(e) => Err(e)
  }
}

fn row_note(r: sql.Row) -> Note ! sql.SqlErr {
  Note{
    id: r.int("id")?,
    owner: r.int("owner")?,
    body: r.str("body")?,
    created: r.time("created")?,
    expires: r.time("expires")?,
  }
}

fn insert_note(db: sql.Db, owner: Int, body: Str, now: Time, ttl: Duration) -> Note ! sql.SqlErr uses net.dial {
  let expires = now + ttl
  let id = db.exec("INSERT INTO notes (owner, body, created, expires) VALUES ($1, $2, $3, $4)", [sql.int(owner), sql.str(body), sql.time(now), sql.time(expires)])?.last_insert_id
  Note{id: id, owner: owner, body: body, created: now, expires: expires}
}

fn list_notes(db: sql.Db, owner: Int) -> List[Note] ! sql.SqlErr uses net.dial {
  let rows = db.query("SELECT * FROM notes WHERE owner = $1 ORDER BY id", [sql.int(owner)])?
  rows.map(row_note)
}

fn get_note(db: sql.Db, owner: Int, id: Int) -> Note ! ApiErr uses net.dial {
  match db.query_one("SELECT * FROM notes WHERE id = $1 AND owner = $2", [sql.int(id), sql.int(owner)]) {
    Ok(row) => row_note(row)?
    Err(NoRows) => Err(ApiErr.NotFound(id: id))
    Err(e) => Err(ApiErr.Db(e))
  }
}

fn delete_note(db: sql.Db, owner: Int, id: Int) -> () ! ApiErr uses net.dial {
  let res = db.exec("DELETE FROM notes WHERE id = $1 AND owner = $2", [sql.int(id), sql.int(owner)])?
  if res.rows_affected == 0 {
    return Err(ApiErr.NotFound(id: id))
  }
}

/// Deletes notes whose expiry is at or before `now`; returns how many.
pub fn purge_expired(db: sql.Db, now: Time) -> Int ! sql.SqlErr uses net.dial {
  db.exec("DELETE FROM notes WHERE expires <= $1", [sql.time(now)])?.rows_affected
}

/// Runs until cancelled. A failed purge is logged and retried next tick;
/// a purge cut short by shutdown is not a failure.
pub fn purge_loop(db: sql.Db, clock: Clock, every: Duration) uses (net.dial, clock) {
  while {
    clock.sleep(every)
    match purge_expired(db, clock.now()) {
      Ok(n) => {
        if n > 0 {
          log.info("purged expired notes", {"count": n})
        }
      }
      Err(Canceled) => return
      Err(e) => log.warn("purge failed", {"err": "${e}"})
    }
  }
}

// ---- http ----

fn bearer(req: http.Request) -> Str? {
  let h = req.header("Authorization")?
  if !h.starts_with("Bearer ") {
    return None
  }
  let t = h.trim_prefix("Bearer ").trim()
  if t.is_empty() { None } else { Some(t) }
}

/// Resolves the bearer token to a User and passes it on as a typed request
/// value. Clients cannot set request values, so nothing they send is
/// trusted as identity. Errors map to responses through ApiErr.status.
fn auth(db: sql.Db) -> fn(http.Request, http.Next) -> http.Response ! ApiErr uses net.dial {
  fn(req, next) -> http.Response ! ApiErr {
    let token = bearer(req).or_err(ApiErr.Unauthorized)?
    let user = user_for_token(db, token)?.or_err(ApiErr.Unauthorized)?
    next(req.with_value(user_key(), user))
  }
}

fn current_user(req: http.Request) -> User ! ApiErr {
  req.value(user_key()).or_err(ApiErr.Unauthorized)
}

pub fn routes(db: sql.Db, clock: Clock) -> http.Router uses (net.dial, clock) {
  var notes = http.router()
  notes.wrap(auth(db))
  notes.handle("POST /notes", fn(req) -> http.Response ! ApiErr {
    let uid = current_user(req)?.id
    let n = req.json[NewNote]().map_err(fn(e) { ApiErr.BadRequest(msg: "${e}") })?
    if n.body.is_empty() {
      return Err(ApiErr.BadRequest(msg: "body must not be empty"))
    }
    if n.ttl_secs <= 0 {
      return Err(ApiErr.BadRequest(msg: "ttl_secs must be positive"))
    }
    let note = insert_note(db, uid, n.body, clock.now(), 1s * n.ttl_secs)?
    http.json(201, note)
  })
  notes.handle("GET /notes", fn(req) -> http.Response ! ApiErr {
    let uid = current_user(req)?.id
    http.json(200, list_notes(db, uid)?)
  })
  notes.handle("GET /notes/{id:Int}", fn(req) -> http.Response ! ApiErr {
    let uid = current_user(req)?.id
    http.json(200, get_note(db, uid, req.param_int("id"))?)
  })
  notes.handle("DELETE /notes/{id:Int}", fn(req) -> http.Response ! ApiErr {
    let uid = current_user(req)?.id
    delete_note(db, uid, req.param_int("id"))?
    http.empty(204)
  })
  var r = http.router()
  r.handle("GET /health", fn(_req) { http.json(200, {"status": "ok"}) })
  r.mount("", notes)
  r
}

/// Serves until the first stop signal, with the purge job in the background.
pub fn run(os: Os, db: sql.Db, addr: Str) ! uses (net.listen, net.dial, clock) {
  let l = os.net.listen(addr)?
  let srv = http.server(l, routes(db, os.clock))
  // the bound address: the real port when addr asked for ":0"
  log.info("listening", {"addr": l.addr()})
  scope s {
    s.spawn_background(fn() { purge_loop(db, os.clock, PURGE_EVERY) })
    srv.serve()?
  }
  log.info("stopped")
}

fn main(os: Os) ! {
  let db = open_db()?
  let token = match os.env.get("NOTES_TOKEN") {
    Some(t) => t
    None => {
      // a fresh random token, shown once; only its digest is stored
      let t = crypto.token(os.rand)
      os.stdio.println("admin token: ${t}")
      t
    }
  }
  add_user(db, "admin", token)?
  let addr = os.env.get("NOTES_ADDR") ?? "127.0.0.1:8080"
  run(os, db, addr)?
}
