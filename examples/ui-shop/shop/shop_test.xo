use std/ui
use std/url

test "a cart is bounded by stock and a checkout takes the stock" {
  var m = app().init
  for _ in 0..3 {
    m = update(m, Msg.Add(user: "ann", sku: "pot"))
  }
  expect(m.carts.get("ann") ?? {}) == {"pot": 1}
  m = update(m, Msg.Checkout(user: "ann"))
  expect(stock_of(m, "pot")) == 0
  expect(m.orders) == 1
  m = update(m, Msg.Add(user: "bob", sku: "pot"))
  expect((m.carts.get("bob") ?? {}).len()) == 0
}

test "redact leaves the viewer's cart only, and allow binds Msgs to the principal" {
  var m = update(update(app().init, Msg.Add(user: "ann", sku: "tea")), Msg.Add(user: "bob", sku: "mug"))
  let r = redact(m, "bob")
  expect(r.carts.len()) == 1
  expect(r.carts.contains("bob")) == true
  expect(ui.render(view(r)).contains("Cart of bob")) == true
  expect(allow(m, "ann", Msg.Add(user: "bob", sku: "tea"))) == false
  expect(allow(m, "ann", Msg.Checkout(user: "ann"))) == true
}

test "a viewer with no cart yet still sees their own name" {
  let r = redact(app().init, "cy")
  expect(ui.render(view(r)).contains("Cart of cy")) == true
}

test "the URL filters and sorts the catalog for this viewer only" {
  let m = redact(app().init, "ann")
  let drinks = ui.render(view_at(m, url.parse_query("tag=drink")?))
  expect(drinks.contains("Green tea")) == true
  expect(drinks.contains("Teapot")) == false
  let cheap = ui.render(view_at(m, url.parse_query("sort=price&tag=kitchen")?))
  let mug = cheap.find("Mug") ?? 0
  let pot = cheap.find("Teapot") ?? 0
  expect(mug < pot) == true
  // the links keep the other filter
  expect(cheap.contains("href=\"?sort=price&amp;tag=drink\"")) == true
}

test "user state: a cart is bounded by stock, Buy empties it and orders it" {
  let m = user_app().init
  var c: Map[Str, Int] = {}
  for _ in 0..3 {
    let (n, out) = cart_step(m, c, CartAct.Put(sku: "pot"))
    expect(out.len()) == 0
    c = n
  }
  expect(c) == {"pot": 1}
  let (after, orders) = cart_step(m, c, CartAct.Buy)
  expect(after.len()) == 0
  expect(orders) == [Order.Place(cart: {"pot": 1})]
  let m2 = order(m, orders[0])
  expect(shared_stock(m2, "pot")) == 0
  expect(m2.orders) == 1
  // a second order of the same pot no longer fits: the stock stays
  let m3 = order(m2, Order.Place(cart: {"pot": 1}))
  expect(m3) == m2
}

test "user state: the page shows the principal's cart and keeps the filters" {
  let m = user_app().init
  let page = ui.render(cart_view(m, {"tea": 2}, url.parse_query("tag=kitchen")?))
  expect(page.contains("2 x Green tea")) == true
  expect(page.contains("Mug")) == true
  expect(page.contains("(20 left)")) == false
  expect(page.contains("data-xo-uclick")) == true
}
