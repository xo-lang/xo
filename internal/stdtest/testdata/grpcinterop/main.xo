// Interop with grpc-go (decision 0535): `serve` prints its address and serves the methods of internal/stdtest/grpcref's
// interop handler, `client ADDR` makes the calls against a grpc-go server; the test (TestGrpcInterop) crosses them.
use std/grpc
use std/http
use std/tls

fn handlers(clock: Clock[clock]) -> grpc.Server {
  var srv = grpc.server(clock).with_max_send(1000)
  srv.stream("/t.S/Echo", fn(call, recv, send) -> () ! grpc.Status {
    let req = recv.next()? ?? b""
    if call.metadata.get("x-fail") == Some("1") {
      return Err(grpc.Status{code: grpc.Code.NotFound, message: "no such user \u{e9}%", details: b""})
    }
    if call.metadata.get("x-md") == Some("1") {
      send.set_trailer("x-t", "tv")
      // header metadata set, then sent with more; after that set_header and send_header fail
      var late: List[Str] = []
      if let Err(e) = send.set_header("x-h", "hv") {
        late.push("set ${e.display()}")
      }
      if let Err(e) = send.send_header({"x-s": "sv"}) {
        late.push("send ${e.display()}")
      }
      if let Err(e) = send.set_header("x-z", "zv") {
        late.push("set2 ${e.display()}")
      }
      if let Err(e) = send.send_header() {
        late.push("send2 ${e.display()}")
      }
      send.set_trailer("x-late", late.join("; "))
    }
    send.send(req + (call.metadata.get("x-who") ?? "").bytes())?
  })
  srv.stream("/t.S/Big", fn(_call, recv, send) -> () ! grpc.Status {
    let _req = recv.next()?
    send.send("b".repeat(2000).bytes())?
  })
  srv.stream("/t.S/Count", fn(_call, recv, send) -> () ! grpc.Status {
    let m = recv.next()? ?? b"0"
    let n = Int.parse(m.to_str() ?? "0") ?? 0
    for i in 0..n {
      send.send("${i}".bytes())?
    }
  })
  srv.stream("/t.S/Sum", fn(_call, recv, send) -> () ! grpc.Status {
    var total = 0
    while true {
      match recv.next()? {
        Some(m) => {
          total += Int.parse(m.to_str() ?? "0") ?? 0
        }
        None => break
      }
    }
    send.send("${total}".bytes())?
  })
  srv.stream("/t.S/Echo2", fn(_call, recv, send) -> () ! grpc.Status {
    while true {
      match recv.next()? {
        Some(m) => send.send(m)?
        None => break
      }
    }
    return Err(grpc.Status{code: grpc.Code.Aborted, message: "done", details: b""})
  })
  srv
}

fn show(r: Result[Bytes, grpc.Status]) -> Str {
  match r {
    Ok(b) => "ok ${b.to_str() ?? "?"}"
    Err(e) => "err ${e.display()}"
  }
}

fn calls(os: Os, c: grpc.Client) {
  os.stdio.println("echo: ${show(c.unary("/t.S/Echo", "hi ".bytes(), {"x-who": "bob"}))}")
  os.stdio.println("gzip: ${show(c.with_gzip().unary("/t.S/Echo", "hi ".bytes(), {"x-who": "bob"}))}")
  os.stdio.println("fail: ${show(c.unary("/t.S/Echo", b"x", {"x-fail": "1"}))}")
  os.stdio.println("missing: ${show(c.unary("/t.S/Missing", b"x"))}")
  let counted = c.call("/t.S/Count", {}, None, fn(cc) -> List[Str] ! grpc.Status {
    cc.send(b"3")?
    cc.close_send()
    var out: List[Str] = []
    while true {
      match cc.recv()? {
        Some(m) => out.push(m.to_str() ?? "?")
        None => break
      }
    }
    Ok(out)
  })
  match counted {
    Ok(l) => os.stdio.println("count: ${l}")
    Err(e) => os.stdio.println("count: ${e.display()}")
  }
  let summed = c.call("/t.S/Sum", {}, None, fn(cc) -> Str ! grpc.Status {
    for i in 1..5 {
      cc.send("${i}".bytes())?
    }
    cc.close_send()
    let m = cc.recv()? ?? b"?"
    Ok(m.to_str() ?? "?")
  })
  match summed {
    Ok(t) => os.stdio.println("sum: ${t}")
    Err(e) => os.stdio.println("sum: ${e.display()}")
  }
  let echoed = c.call("/t.S/Echo2", {}, None, fn(cc) -> List[Str] ! grpc.Status {
    var out: List[Str] = []
    for i in 0..3 {
      cc.send("m${i}".bytes())?
      let m = cc.recv()? ?? b"?"
      out.push(m.to_str() ?? "?")
    }
    cc.close_send()
    match cc.recv() {
      Ok(None) => out.push("end")
      Ok(Some(m)) => out.push("extra ${m.len()}")
      Err(e) => out.push(e.display())
    }
    Ok(out)
  })
  match echoed {
    Ok(l) => os.stdio.println("bidi: ${l}")
    Err(e) => os.stdio.println("bidi: ${e.display()}")
  }
  let md = c.call("/t.S/Echo", {"x-who": "bob", "x-md": "1"}, None, fn(cc) -> Str ! grpc.Status {
    cc.send("hi ".bytes())?
    cc.close_send()
    let m = cc.recv()? ?? b"?"
    let _end = cc.recv()?
    Ok("ok ${m.to_str() ?? "?"} header ${show_md(cc.header()?)} trailer ${show_md(cc.trailer())}")
  })
  match md {
    Ok(t) => os.stdio.println("md: ${t}")
    Err(e) => os.stdio.println("md: err ${e.display()}")
  }
  os.stdio.println("recvlimit: ${show(c.with_max_recv(2).unary("/t.S/Echo", "hi ".bytes(), {"x-who": "bob"}))}")
  os.stdio.println("sendlimit: ${show(c.with_max_send(2).unary("/t.S/Echo", "hi ".bytes()))}")
  os.stdio.println("big: ${show(c.unary("/t.S/Big", b"x"))}")
  os.stdio.println("gziplimit: ${show(c.with_gzip().with_max_recv(100).unary("/t.S/Big", b"x"))}")
}

fn show_md(md: Map[Str, Str]) -> Str {
  var parts: List[Str] = []
  for k in md.keys().sort() {
    // an Xo server's head has a Date (std/http adds one; grpc-go's server sends none)
    if k == "date" {
      continue
    }
    parts.push("${k}=${md.get(k) ?? ""}")
  }
  "[${parts.join(" ")}]"
}

// The mutual TLS case (map.txt grpc.behavior.mtls; grpcref's tlsinterop.go is the oracle): DIR holds ca.pem and the
// server and client pairs the test wrote. /t.S/Who answers the connection's AuthInfo as the handler sees it.
fn who(call: grpc.Call) -> Str {
  let ai = call.auth_info
  match ai.tls {
    Some(st) => {
      let cn = if st.peer_certificates.is_empty() { "none" } else { st.peer_certificates[0].subject.common_name }
      "auth ${ai.auth_type} ${ai.level.display()} ${st.version} client=${cn} chains=${st.verified_chains.len()} authorization=${call.metadata.get("authorization") ?? ""}"
    }
    None => "auth ${ai.auth_type}"
  }
}

fn tls_files(os: Os, dir: Str) -> (Bytes, http.TlsCert, http.TlsCert) {
  let read = fn(name: Str) -> Bytes { os.fs.read("${dir}/${name}").or_fault("read ${name}") }
  let ca = read("ca.pem")
  (ca, http.tls_cert(read("server.pem"), read("server.key")).or_fault("server pair"), http.tls_cert(read("client.pem"), read("client.key")).or_fault("client pair"))
}

fn tls_serve(os: Os, dir: Str) {
  let (ca, srv_cert, _) = tls_files(os, dir)
  var srv = grpc.server(os.clock)
  srv.unary("/t.S/Who", fn(call, _req) -> Bytes ! grpc.Status { Ok(who(call).bytes()) })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_client_auth(tls.ClientAuth.RequireAndVerify, roots: Some(tls.roots(ca).or_fault("roots"))).with_tls([srv_cert])
  os.stdio.println(hs.addr())
  hs.serve().ignore_err("the test kills the process")
}

fn tls_client(os: Os, addr: Str, dir: Str) {
  let (ca, _, cli_cert) = tls_files(os, dir)
  let seen = Mutex[List[Str]].new([])
  let token = grpc.PerRpcCreds{metadata: fn(ri) -> Map[Str, Str] ! grpc.Status uses sync {
    seen.with(fn(var l) { l.push("${ri.method} ${ri.audience} ${ri.auth_info.auth_type} ${ri.auth_info.level.display()}") })
    Ok({"authorization": "Bearer tls-token"})
  }}
  let hc = http.client(os.net, timeout: 30s).with_roots(ca).or_fault("roots").with_cert(cli_cert)
  let c = grpc.client(hc, "https://${addr}").with_per_rpc_creds(token)
  match c.unary("/t.S/Who", b"x") {
    Ok(b) => os.stdio.println("who: ${b.to_str() ?? "?"}")
    Err(e) => os.stdio.println("who: err ${e.display()}")
  }
  for l in seen.with_read(fn(l) { l }) {
    os.stdio.println("creds: ${l.replace(addr, "ADDR")}")
  }
}

fn main(os: Os) {
  let args = os.env.args()
  if args.len() == 0 {
    os.stdio.println("usage: serve | client ADDR")
    return
  }
  if args[0] == "serve-tls" {
    tls_serve(os, args[1])
    return
  }
  if args[0] == "client-tls" {
    tls_client(os, args[1], args[2])
    return
  }
  if args[0] == "serve" {
    match os.net.listen("127.0.0.1:0") {
      Ok(l) => {
        let hs = http.server(l, handlers(os.clock).router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
        os.stdio.println(hs.addr())
        hs.serve().ignore_err("the test kills the process")
      }
      Err(e) => os.stdio.println("listen failed: ${e}")
    }
  } else {
    calls(os, grpc.client(http.client(os.net, timeout: 30s), "http://${args[1]}"))
  }
}
