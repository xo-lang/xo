/// (code point, Go's validDelim: usable as sep, and as comment, where 0 is none)
const VALID_CASES: List[(Int, Bool, Bool)] = [
  (0, false, true),
  (1, true, true),
  (9, true, true),
  (10, false, false),
  (11, true, true),
  (12, true, true),
  (13, false, false),
  (32, true, true),
  (34, false, false),
  (35, true, true),
  (44, true, true),
  (59, true, true),
  (65, true, true),
  (127, true, true),
  (128, true, true),
  (163, true, true),
  (233, true, true),
  (8192, true, true),
  (8232, true, true),
  (55295, true, true),
  (57344, true, true),
  (64976, true, true),
  (65533, false, false),
  (65535, true, true),
  (65536, true, true),
  (128512, true, true),
  (1114111, true, true),
]

fn recs_of(rs: List[List[Str]]) -> Str {
  var parts: List[Str] = []
  for r in rs {
    parts.push("${r.len()}\u{0}" + r.join("\u{0}"))
  }
  "${parts.len()}\u{1f}" + parts.join("\u{1e}")
}

fn read_of(text: Str, sep: Rune, comment: Rune, fields: Int, lazy: Bool, trim: Bool) -> Str {
  match csv.parse(text, sep: sep, comment: comment, fields: fields, lazy_quotes: lazy, trim_leading_space: trim) {
    Ok(rs) => recs_of(rs)
    Err(e) => "err ${e.display()}"
  }
}

fn first_read(bad: List[(Str, Rune, Rune, Int, Bool, Bool, Str, Str)]) -> List[(Str, Rune, Rune, Int, Bool, Bool, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

fn first_write(bad: List[(List[List[Str]], Rune, Bool, Str, Str)]) -> List[(List[List[Str]], Rune, Bool, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

fn first_trip(bad: List[(List[List[Str]], Rune, Str, Str)]) -> List[(List[List[Str]], Rune, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

fn first_delim(bad: List[(Int, Bool, Bool, Bool, Bool)]) -> List[(Int, Bool, Bool, Bool, Bool)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

test "parse is Go's csv.Reader: quoting, embedded newlines, lazy quotes, field counts, comments, trimming" {
  var bad: List[(Str, Rune, Rune, Int, Bool, Bool, Str, Str)] = []
  for (text, sep, comment, fields, lazy, trim, want) in READ_CASES {
    let got = read_of(text, sep, comment, fields, lazy, trim)
    if got != want {
      bad.push((text, sep, comment, fields, lazy, trim, got, want))
    }
  }
  expect(first_read(bad)) == []
}

test "parse on a view of a longer text" {
  // error positions shift with the line before the text, so errors are
  // covered by the test above, on the text itself
  var bad: List[(Str, Rune, Rune, Int, Bool, Bool, Str, Str)] = []
  for (text, sep, comment, fields, lazy, trim, want) in READ_CASES {
    if want.starts_with("err ") {
      continue
    }
    let long = "\n" + text
    let view = long[1..long.len()]
    let got = read_of(view, sep, comment, fields, lazy, trim)
    if got != want {
      bad.push((text, sep, comment, fields, lazy, trim, got, want))
    }
  }
  expect(first_read(bad)) == []
}

test "format is Go's csv.Writer: quoting decisions and CRLF" {
  var bad: List[(List[List[Str]], Rune, Bool, Str, Str)] = []
  for (rows, sep, crlf, want) in WRITE_CASES {
    let got = csv.format(rows, sep: sep, crlf: crlf)
    if got != want {
      bad.push((rows, sep, crlf, got, want))
    }
  }
  expect(first_write(bad)) == []
}

test "format quotes a record of one empty field, as std/csv documents" {
  // Go's Writer writes an empty line for these, which Go's Reader skips
  expect(csv.format([[""]])) == "\"\"\n"
  expect(csv.format([[""]], crlf: true)) == "\"\"\r\n"
  expect(csv.format([[""], [""], ["a"]])) == "\"\"\n\"\"\na\n"
  expect(csv.format([["", ""]])) == ",\n"
}

test "format then parse is the same records" {
  var bad: List[(List[List[Str]], Rune, Str, Str)] = []
  for (rows, sep) in ROUND_TRIP {
    let got = match csv.parse(csv.format(rows, sep: sep), sep: sep) {
      Ok(rs) => recs_of(rs)
      Err(e) => "err ${e.display()}"
    }
    let want = recs_of(rows)
    if got != want {
      bad.push((rows, sep, got, want))
    }
  }
  expect(first_trip(bad)) == []
}

test "valid_sep and valid_comment are Go's validDelim" {
  var bad: List[(Int, Bool, Bool, Bool, Bool)] = []
  for (cp, sep, comment) in VALID_CASES {
    let r = Rune(cp)
    let got_sep = csv.valid_sep(r)
    let got_comment = csv.valid_comment(r)
    if got_sep != sep || got_comment != comment {
      bad.push((cp, got_sep, got_comment, sep, comment))
    }
  }
  expect(first_delim(bad)) == []
}
