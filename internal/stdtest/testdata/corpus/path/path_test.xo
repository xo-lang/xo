fn show(bad: List[(Str, Str, Str, Str)]) -> List[(Str, Str, Str, Str)] {
  bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]
}

test "clean, dir, base and ext are Go's" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (p, cl, di, ba, ex) in CONV_CASES {
    if path.clean(p) != cl {
      bad.push(("clean", p, path.clean(p), cl))
    }
    if path.dir(p) != di {
      bad.push(("dir", p, path.dir(p), di))
    }
    if path.base(p) != ba {
      bad.push(("base", p, path.base(p), ba))
    }
    if path.ext(p) != ex {
      bad.push(("ext", p, path.ext(p), ex))
    }
  }
  expect(show(bad)) == []
}

test "split is Go's Split" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (p, d, f) in SPLIT_CASES {
    let (gd, gf) = path.split(p)
    if gd != d || gf != f {
      bad.push((p, "${gd}\u{0}${gf}", "${d}\u{0}${f}", "${d}\u{1}${f}"))
    }
  }
  expect(show(bad)) == []
}

test "join is Go's Join" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (a, b, want) in JOIN_CASES {
    let got = path.join(a, b)
    if got != want {
      bad.push((a, b, got, want))
    }
  }
  expect(show(bad)) == []
}

test "is_abs is Go's IsAbs" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (p, want) in IS_ABS_CASES {
    let got = "${path.is_abs(p)}"
    if got != want {
      bad.push((p, "", got, want))
    }
  }
  expect(show(bad)) == []
}

test "match is Go's Match" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (pat, name, want) in MATCH_CASES {
    let got = match path.is_match(pat, name) {
      Ok(v) => "${v}"
      Err(_) => "err"
    }
    if got != want {
      bad.push((pat, name, got, want))
    }
  }
  expect(show(bad)) == []
}

test "a view of a longer text is Go's" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (p, cl, di, ba, ex) in CONV_CASES {
    let long = "<<" + p + ">>"
    let v = long[2..(long.len() - 2)]
    if path.clean(v) != cl {
      bad.push(("clean", p, path.clean(v), cl))
    }
    if path.dir(v) != di {
      bad.push(("dir", p, path.dir(v), di))
    }
    if path.base(v) != ba {
      bad.push(("base", p, path.base(v), ba))
    }
    if path.ext(v) != ex {
      bad.push(("ext", p, path.ext(v), ex))
    }
    let (sd, sf) = path.split(v)
    let (d, f) = path.split(p)
    if sd != d || sf != f {
      bad.push(("split", p, "${sd}\u{0}${sf}", "${d}\u{0}${f}"))
    }
    if path.is_abs(v) != path.is_abs(p) {
      bad.push(("is_abs", p, "${path.is_abs(v)}", "${path.is_abs(p)}"))
    }
  }
  expect(show(bad)) == []
}
