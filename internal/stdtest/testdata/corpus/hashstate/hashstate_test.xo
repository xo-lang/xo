fn shake_of(i: Int) -> crypto.Shake {
  match i {
    0 => crypto.shake128()
    1 => crypto.shake256()
    2 => crypto.cshake128(b"N", b"S")
    3 => crypto.cshake256(b"", b"custom")
    4 => crypto.cshake128(b"other", b"")
    _ => fault("shake")
  }
}

