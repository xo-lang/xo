test "invalid/inline-table/overwrite-01.toml" {
  let got = tf_line("a.b=0\n# Since table \"a\" is already defined, it can't be replaced by an inline table.\na={}\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-02.toml" {
  let got = tf_line("a={}\n# Inline tables are immutable and can't be extended\n[a.b]\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-03.toml" {
  let got = tf_line("a = { b = 1 }\na.b = 2\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-04.toml" {
  let got = tf_line("inline-t = { nest = {} }\n\n[[inline-t.nest]]\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-05.toml" {
  let got = tf_line("inline-t = { nest = {} }\n\n[inline-t.nest]\n")
  if got != "err" {
    fault("got " + got)
  }
}

