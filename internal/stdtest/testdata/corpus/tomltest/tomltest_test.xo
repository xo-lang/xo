test "valid/float/inf-and-nan.toml" {
  let got = tf_line("# We don't encode +nan and -nan back with the signs; many languages don't\n# support a sign on NaN (it doesn't really make much sense).\nnan = nan\nnan_neg = -nan\nnan_plus = +nan\ninfinity = inf\ninfinity_neg = -inf\ninfinity_plus = +inf\n")
  if got != "err" {
    fault("got " + got)
  }
}

