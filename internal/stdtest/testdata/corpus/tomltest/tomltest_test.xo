  if got != "ok {6861736823746167:{2321:s686173682062616e67,61727233:[s23,s23,s232323],61727234:[n1,n2,n3,n4],61727235:[[[[[s23]]]]],74626c31:{23:s7d23}},73656374696f6e:{38:s6569676874,656c6576656e:f4622438362537734963,66697665:f4617878467915022336,666f7572:s23206e6f20636f6d6d656e740a23206e6f7220746869730a23616c736f206e6f7420636f6d6d656e74,6f6e65:s3131,736978:n6,74656e:n1000,7468726565:s23,74776f:s323223}}" {
    fault("got " + got)
  }
}

