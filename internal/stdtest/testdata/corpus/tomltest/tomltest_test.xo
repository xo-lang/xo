  if got != "ok {636f6e7472696275746f7273:[s466f6f20426172203c666f6f406578616d706c652e636f6d3e,{656d61696c:s62617a717578406578616d706c652e636f6d,6e616d65:s42617a20517578,75726c:s68747470733a2f2f6578616d706c652e636f6d2f62617a717578}],6d69786564:[{6b:s61},s62,n1]}" {
    fault("got " + got)
  }
}

