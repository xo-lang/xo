// Generated by internal/stdtest/tomlfuzz_test.go from toml-test v1.5.0's TOML 1.0.0
// documents (internal/stdtest/testdata/toml-test, MIT): 543 run, 10 not UTF-8 and so
// not run; do not edit: XO_TOMLFUZZ_WRITE=1 go test ./internal/stdtest -run TestTomlCorpusCurrent
// rewrites it.
use std/json
use std/toml

fn tf_r(v: json.Value) -> Str {
  match v {
    json.Value.Null => "null"
    json.Value.Bool(b) => if b { "t" } else { "f" }
    json.Value.Int(n) => "n${n}"
    json.Value.Num(f) => {
      if f == f.floor() && f.abs() < 9.2e18 {
        return "n${Int(f)}"
      }
      "f${f.to_bits()}"
    }
    json.Value.Str(s) => "s${tf_frac(s).bytes().to_hex()}"
    json.Value.List(items) => {
      var parts: List[Str] = []
      for x in items {
        parts.push(tf_r(x))
      }
      "[" + parts.join(",") + "]"
    }
    json.Value.Object(fields) => {
      var parts: List[Str] = []
      for (k, x) in fields {
        parts.push("${k.bytes().to_hex()}:${tf_r(x)}")
      }
      "{" + parts.sort().join(",") + "}"
    }
    _ => "other"
  }
}

/// s with the trailing zeros of a seconds fraction dropped (".600" is
/// ".6", ".000" nothing): toml-test compares datetimes as instants.
fn tf_frac(s: Str) -> Str {
  let b = s.bytes()
  var i = 3
  while i < b.len() && !(b[i] == 46 && b[i - 3] == 58) {
    i += 1
  }
  if i >= b.len() {
    return s
  }
  var j = i + 1
  while j < b.len() && b[j] >= 48 && b[j] <= 57 {
    j += 1
  }
  var k = j
  while k > i + 1 && b[k - 1] == 48 {
    k -= 1
  }
  if k == i + 1 {
    k = i
  }
  s[..k] + s[j..]
}

fn tf_line(text: Str) -> Str {
  match toml.to_json(text) {
    Ok(j) => match json.parse_value(j) {
      Ok(v) => "ok " + tf_r(v)
      Err(e) => "bad json " + e.msg
    }
    Err(_) => "err"
  }
}

