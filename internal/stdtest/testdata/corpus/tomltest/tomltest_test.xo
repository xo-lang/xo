  let got = tf_line("ints = [1, 2, 3, ]\nfloats = [1.1, 2.1, 3.1]\nstrings = [\"a\", \"b\", \"c\"]\ndates = [\n  1987-07-05T17:45:00Z,\n  1979-05-27T07:32:00Z,\n  2006-06-01T11:00:00Z,\n]\ncomments = [\n         1,\n         2, #this is ok\n]\n")
  if got != "ok {636f6d6d656e7473:[n1,n2],6461746573:[s313938372d30372d30355431373a34353a30305a,s313937392d30352d32375430373a33323a30305a,s323030362d30362d30315431313a30303a30305a],666c6f617473:[f4607632778762754458,f4611911198408756429,f4614162998222441677],696e7473:[n1,n2,n3],737472696e6773:[s61,s62,s63]}" {
    fault("got " + got)
  }
}

