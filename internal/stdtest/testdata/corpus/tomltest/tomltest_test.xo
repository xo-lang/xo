  let got = tf_line("a = { b = 1, b.c = 2 }\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-07.toml" {
  let got = tf_line("tab = { inner.table = [{}], inner.table.val = \"bad\" }")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-08.toml" {
  let got = tf_line("tab = { inner = { dog = \"best\" }, inner.cat = \"worst\" }")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-09.toml" {
  let got = tf_line("[tab.nested]\ninline-t = { nest = {} }\n\n[tab]\nnested.inline-t.nest = 2\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/overwrite-10.toml" {
  let got = tf_line("# Set implicit \"b\", overwrite \"b\" (illegal!) and then set another implicit.\n#\n# Caused panic: https://github.com/BurntSushi/toml/issues/403\na = {b.a = 1, b = 2, b.c = 3}\n")
  if got != "err" {
    fault("got " + got)
  }
}

test "invalid/inline-table/trailing-comma.toml" {
  let got = tf_line("# A terminating comma (also called trailing comma) is not permitted after the\n# last key/value pair in an inline table\nabc = { abc = 123, }\n")
