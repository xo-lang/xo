test "valid/string/raw.toml" {
  let got = tf_line("backspace = 'This string has a \\b backspace character.'\ntab = 'This string has a \\t tab character.'\nunescaped_tab = 'This string has an \t unescaped tab character.'\nnewline = 'This string has a \\n new line character.'\nformfeed = 'This string has a \\f form feed character.'\ncarriage = 'This string has a \\r carriage return character.'\nslash = 'This string has a \\/ slash character.'\nbackslash = 'This string has a \\\\ backslash character.'\n")
  if got != "ok {6261636b736c617368:s5468697320737472696e67206861732061205c5c206261636b736c617368206368617261637465722e,6261636b7370616365:s5468697320737472696e67206861732061205c62206261636b7370616365206368617261637465722e,6361727269616765:s5468697320737472696e67206861732061205c722063617272696167652072657475726e206368617261637465722e,666f726d66656564:s5468697320737472696e67206861732061205c6620666f726d2066656564206368617261637465722e,6e65776c696e65:s5468697320737472696e67206861732061205c6e206e6577206c696e65206368617261637465722e,736c617368:s5468697320737472696e67206861732061205c2f20736c617368206368617261637465722e,746162:s5468697320737472696e67206861732061205c7420746162206368617261637465722e,756e657363617065645f746162:s5468697320737472696e672068617320616e200920756e6573636170656420746162206368617261637465722e}" {
    fault("got " + got)
  }
}

test "valid/string/raw-multiline.toml" {
  let got = tf_line("# Single ' should be allowed.\noneline = '''This string has a ' quote character.'''\n\n# A newline immediately following the opening delimiter will be trimmed.\nfirstnl = '''\nThis string has a ' quote character.'''\n\n# All other whitespace and newline characters remain intact.\nmultiline = '''\nThis string\nhas ' a quote character\nand more than\none newline\nin it.'''\n\n# Tab character in literal string does not need to be escaped\nmultiline_with_tab = '''First line\n\t Followed by a tab'''\n\nthis-str-has-apostrophes='''' there's one already\n'' two more\n'''''\n")
  if got != "ok {66697273746e6c:s5468697320737472696e6720686173206120272071756f7465206368617261637465722e,6d756c74696c696e655f776974685f746162:s4669727374206c696e650a0920466f6c6c6f776564206279206120746162,6d756c74696c696e65:s5468697320737472696e670a686173202720612071756f7465206368617261637465720a616e64206d6f7265207468616e0a6f6e65206e65776c696e650a696e2069742e,6f6e656c696e65:s5468697320737472696e6720686173206120272071756f7465206368617261637465722e,746869732d7374722d6861732d61706f7374726f70686573:s272074686572652773206f6e6520616c72656164790a27272074776f206d6f72650a2727}" {
    fault("got " + got)
  }
}

test "valid/string/simple.toml" {
  let got = tf_line("answer = \"You are not drinking enough whisky.\"\n")
  if got != "ok {616e73776572:s596f7520617265206e6f74206472696e6b696e6720656e6f75676820776869736b792e}" {
    fault("got " + got)
  }
}

test "valid/string/start-mb.toml" {
  let got = tf_line("# Start first line with a multibyte character.\n#\n# https://github.com/marzer/tomlplusplus/issues/190\ns1 = \"§\"\ns2 = '§'\ns3 = \"\"\"\\\n§\"\"\"\ns4 = \"\"\"\n§\"\"\"\ns5 = \"\"\"§\"\"\"\ns6 = '''\n§'''\ns7 = '''§'''\n")
  if got != "ok {7331:sc2a7,7332:sc2a7,7333:sc2a7,7334:sc2a7,7335:sc2a7,7336:sc2a7,7337:sc2a7}" {
    fault("got " + got)
  }
}

test "valid/string/unicode-escape.toml" {
  let got = tf_line("delta-1 = \"\\u03B4\"\ndelta-2 = \"\\U000003B4\"\na       = \"\\u0061\"\nb       = \"\\u0062\"\nc       = \"\\U00000063\"\nnull-1  = \"\\u0000\"\nnull-2  = \"\\U00000000\"\n\nml-delta-1 = \"\"\"\\u03B4\"\"\"\nml-delta-2 = \"\"\"\\U000003B4\"\"\"\nml-a       = \"\"\"\\u0061\"\"\"\nml-b       = \"\"\"\\u0062\"\"\"\nml-c       = \"\"\"\\U00000063\"\"\"\nml-null-1  = \"\"\"\\u0000\"\"\"\nml-null-2  = \"\"\"\\U00000000\"\"\"\n")
  if got != "ok {61:s61,62:s62,63:s63,64656c74612d31:sceb4,64656c74612d32:sceb4,6d6c2d61:s61,6d6c2d62:s62,6d6c2d63:s63,6d6c2d64656c74612d31:sceb4,6d6c2d64656c74612d32:sceb4,6d6c2d6e756c6c2d31:s00,6d6c2d6e756c6c2d32:s00,6e756c6c2d31:s00,6e756c6c2d32:s00}" {
    fault("got " + got)
  }
}

test "valid/string/unicode-literal.toml" {
  let got = tf_line("answer = \"δ\"\n")
  if got != "ok {616e73776572:sceb4}" {
    fault("got " + got)
  }
}

test "valid/string/with-pound.toml" {
  let got = tf_line("pound = \"We see no # comments here.\"\npoundcomment = \"But there are # some comments here.\" # Did I # mess you up?\n")
  if got != "ok {706f756e64636f6d6d656e74:s42757420746865726520617265202320736f6d6520636f6d6d656e747320686572652e,706f756e64:s576520736565206e6f202320636f6d6d656e747320686572652e}" {
    fault("got " + got)
  }
}

test "valid/table/array-implicit.toml" {
  let got = tf_line("[[albums.songs]]\nname = \"Glory Days\"\n")
  if got != "ok {616c62756d73:{736f6e6773:[{6e616d65:s476c6f72792044617973}]}}" {
    fault("got " + got)
  }
}

test "valid/table/array-implicit-and-explicit-after.toml" {
  let got = tf_line("[[a.b]]\nx = 1\n\n[a]\ny = 2\n")
  if got != "ok {61:{62:[{78:n1}],79:n2}}" {
    fault("got " + got)
  }
}

test "valid/table/array-many.toml" {
  let got = tf_line("[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n\n[[people]]\nfirst_name = \"Eric\"\nlast_name = \"Clapton\"\n\n[[people]]\nfirst_name = \"Bob\"\nlast_name = \"Seger\"\n")
  if got != "ok {70656f706c65:[{66697273745f6e616d65:s4272756365,6c6173745f6e616d65:s537072696e67737465656e},{66697273745f6e616d65:s45726963,6c6173745f6e616d65:s436c6170746f6e},{66697273745f6e616d65:s426f62,6c6173745f6e616d65:s5365676572}]}" {
    fault("got " + got)
  }
}

test "valid/table/array-nest.toml" {
  let got = tf_line("[[albums]]\nname = \"Born to Run\"\n\n  [[albums.songs]]\n  name = \"Jungleland\"\n\n  [[albums.songs]]\n  name = \"Meeting Across the River\"\n\n[[albums]]\nname = \"Born in the USA\"\n  \n  [[albums.songs]]\n  name = \"Glory Days\"\n\n  [[albums.songs]]\n  name = \"Dancing in the Dark\"\n")
  if got != "ok {616c62756d73:[{6e616d65:s426f726e20746f2052756e,736f6e6773:[{6e616d65:s4a756e676c656c616e64},{6e616d65:s4d656574696e67204163726f737320746865205269766572}]},{6e616d65:s426f726e20696e2074686520555341,736f6e6773:[{6e616d65:s476c6f72792044617973},{6e616d65:s44616e63696e6720696e20746865204461726b}]}]}" {
    fault("got " + got)
  }
}

test "valid/table/array-one.toml" {
  let got = tf_line("[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n")
  if got != "ok {70656f706c65:[{66697273745f6e616d65:s4272756365,6c6173745f6e616d65:s537072696e67737465656e}]}" {
    fault("got " + got)
  }
}

test "valid/table/array-table-array.toml" {
  let got = tf_line("[[a]]\n    [[a.b]]\n        [a.b.c]\n            d = \"val0\"\n    [[a.b]]\n        [a.b.c]\n            d = \"val1\"\n")
  if got != "ok {61:[{62:[{63:{64:s76616c30}},{63:{64:s76616c31}}]}]}" {
    fault("got " + got)
  }
}

test "valid/table/array-within-dotted.toml" {
  let got = tf_line("[fruit]\napple.color = \"red\"\n\n[[fruit.apple.seeds]]\nsize = 2\n")
  if got != "ok {6672756974:{6170706c65:{636f6c6f72:s726564,7365656473:[{73697a65:n2}]}}}" {
    fault("got " + got)
  }
}

test "valid/table/empty.toml" {
  let got = tf_line("[a]\n")
  if got != "ok {61:{}}" {
    fault("got " + got)
  }
}

test "valid/table/empty-name.toml" {
  let got = tf_line("['']\nx = 1\n\n[\"\".a]\nx = 2\n\n[a.'']\nx = 3\n")
  if got != "ok {61:{:{78:n3}},:{61:{78:n2},78:n1}}" {
    fault("got " + got)
  }
}

test "valid/table/keyword.toml" {
  let got = tf_line("[true]\n\n[false]\n\n[inf]\n\n[nan]\n\n\n")
  if got != "ok {66616c7365:{},696e66:{},6e616e:{},74727565:{}}" {
    fault("got " + got)
  }
}

test "valid/table/names.toml" {
  let got = tf_line("[a.b.c]\n[a.\"b.c\"]\n[a.'d.e']\n[a.' x ']\n[ d.e.f ]\n[ g . h . i ]\n[ j . \"ʞ\" . 'l' ]\n\n[x.1.2]\n")
  if got != "ok {61:{207820:{},622e63:{},62:{63:{}},642e65:{}},64:{65:{66:{}}},67:{68:{69:{}}},6a:{ca9e:{6c:{}}},78:{31:{32:{}}}}" {
    fault("got " + got)
  }
}

test "valid/table/no-eol.toml" {
  let got = tf_line("[table]\n")
  if got != "ok {7461626c65:{}}" {
    fault("got " + got)
  }
}

test "valid/table/sub.toml" {
  let got = tf_line("[a]\nkey = 1\n\n# a.extend is a key inside the \"a\" table.\n[a.extend]\nkey = 2\n\n[a.extend.more]\nkey = 3\n")
  if got != "ok {61:{657874656e64:{6b6579:n2,6d6f7265:{6b6579:n3}},6b6579:n1}}" {
    fault("got " + got)
  }
}

test "valid/table/sub-empty.toml" {
  let got = tf_line("[a]\n[a.b]\n")
  if got != "ok {61:{62:{}}}" {
    fault("got " + got)
  }
}

test "valid/table/whitespace.toml" {
  let got = tf_line("[\"valid key\"]\n")
  if got != "ok {76616c6964206b6579:{}}" {
    fault("got " + got)
  }
}

test "valid/table/with-literal-string.toml" {
  let got = tf_line("['a']\n[a.'\"b\"']\n[a.'\"b\"'.c]\nanswer = 42 \n")
  if got != "ok {61:{226222:{63:{616e73776572:n42}}}}" {
    fault("got " + got)
  }
}

test "valid/table/with-pound.toml" {
  let got = tf_line("[\"key#group\"]\nanswer = 42\n")
  if got != "ok {6b65792367726f7570:{616e73776572:n42}}" {
    fault("got " + got)
  }
}

test "valid/table/with-single-quotes.toml" {
  let got = tf_line("['a']\n[a.'b']\n[a.'b'.c]\nanswer = 42 \n")
  if got != "ok {61:{62:{63:{616e73776572:n42}}}}" {
    fault("got " + got)
  }
}

test "valid/table/without-super.toml" {
  let got = tf_line("# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n[x] # defining a super-table afterwards is ok\n")
  if got != "ok {78:{79:{7a:{77:{}}}}}" {
    fault("got " + got)
  }
}

