test "crypto.hmac md5 is Go's HMAC-MD5" {
  var bad: List[(Str, Str, Str)] = []
  for (key, msg, want) in MD5_HMACS {
    let got = crypto.hmac(crypto.Hash.Md5, key, msg).to_hex()
    if got != want {
      bad.push(("key ${key.to_hex().len()} msg ${msg.to_hex().len()}", got, want))
    }
  }
  expect(show3(bad)) == []
}

