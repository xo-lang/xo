test "crypto.hmac sha224 is Go's HMAC-SHA224" {
  var bad: List[(Str, Str, Str)] = []
  for (key, msg, want) in SHA224_HMACS {
    let got = crypto.hmac(crypto.Hash.Sha224, key, msg).to_hex()
    if got != want {
      bad.push(("key ${key.to_hex().len()} msg ${msg.to_hex().len()}", got, want))
    }
  }
  expect(show3(bad)) == []
}

