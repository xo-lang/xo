  ("^\\p{ControlZ}\$", "\u{6dad}\u{cd750}\u{fffd}\u{90b7c}\u{9428f}\u{1e9f9}H\u{64069}\u{a1}\u{fed90}\u{70702}\u{df}\u{16485}\u{d002}M\u{303e8}\u{5}\u{82b1e}}\u{f3}\u{2ee7}\u{eea4d}\u{2aa}\u{ba1dd}", "err"),
  ("^[\\p{syriac}\\p{Greek}]\$", "\u{c24c}\u{701}\u{e0001}\u{3000}\u{70e}\u{710}\u{70d}\u{3000}\u{3000}\u{701}\u{86a}\u{86a}\u{70e}\u{74b}\u{74b}S\u{749}\u{9d}\u{86a}\u{869}\u{fffd}\u{70d}\u{ac63}\u{a257f}", "010001100111000010110100"),
  ("^\\P{Gurmukhi}\$", "\u{8e}\u{4337f}\u{48258}\u{a40}\u{bb32}-\u{1952c}\u{a4c}\u{ba}\u{bebb}\u{a49}\u{a2a}\u{a0f}\u{5e5c}\u{5}\u{1a}\u{e0}\u{a32}j\u{a0f}\u{e7c}\u{a66}\u{9a231}\u{e9}", "111011101110011110101011"),
  ("^\\p{o}\$", "\u{860}\u{2028}\u{bc430}\u{4d93a}\u{14}\u{e}\u{62540}\u{10881}\u{108a7}\u{9d}\u{108a7}\u{d}\u{108a6}\u{e0001}\u{108a8}\u{108a8}\u{1089f}\u{108a7}\u{10880}\u{c8}.\u{1087f}\u{10880}\u{1089f}", "err"),
  ("^[^\\p{Latin}]\$", "\u{3000}\u{1d2b}\u{e2f2}\u{13}\u{3}\u{581f}\u{2b9}\u{10784}\u{a0}\u{214f}\u{a2e95}\u{ff59}\u{ab66}\u{1d5b}\u{1f600}B\u{f7}\u{8440b}\u{a7d5}\u{1d25}\u{1d64}\u{10000}\u{b7}\u{2e1}", "111111101110001011000110"),
