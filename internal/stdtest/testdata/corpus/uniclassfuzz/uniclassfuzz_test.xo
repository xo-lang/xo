  ("^\\p{ADLAM}\$", "\u{34db}\u{58c39}\u{fb}\u{2731}\u{b7}\u{e0001}\u{10ffff}\u{e0001}\u{10ffff}\u{1e95e}g\u{dc}\u{1e95f}\u{1e94a}\u{7dbf}=\u{1e950}\u{20a}\u{361b}\u{1e951}\u{10000}\u{e0001}\u{1e958} ", "000000000100110010010010"),
  ("^[\\p{Oriya}\\p{Greek}]\$", "\u{b6}\u{f630}M\u{e5}\u{b54}\u{fc43}a\u{b2f}l\u{b56}\u{95}\u{ba684}\u{b66}\u{88}\u{a8b6}\u{b76}\u{e376}\u{b48}\u{10ffff}\u{b5c}\u{2028}\u{b74e}k\u{85}", "000000010100100101010000"),
  ("^\\p{reiZe}\$", "\u{f8}\u{a981}\u{a9cc}\u{4e89}\u{a12df}\u{e0b9}\u{e0001}\u{a9da}\u{6d7f7}\u{be541}\u{45ca}R\u{a9d8}\u{a9de}\u{39c8}\u{bdc3}\u{6a780}\u{a9df}\u{be}\u{95}\u{fffd}\u{a9de}~\u{e0001}", "err"),
  ("^\\p{Vithkuqi}\$", "\u{4b0b7}\u{4a41f}\u{a85d}\u{9d6e8}\u{105a2}\u{1d}\u{5f0c}\u{d4}\u{417d}\u{1057b}\u{c3}\u{1058b}\u{b}\u{d5}\u{10571}\u{5c11}\u{fffd}\u{105bc}\u{10832b}\u{725be}\u{d8}\u{105b1}\u{24}\u{6}", "000000000000001001000100"),
  ("^\\p{Adlam}\$", "\u{d46b}\u{2}u\u{160d4}\u{e0001}\u{10ffff}\u{1e95f}\u{f9}\u{93}\u{1e960}\u{f3}\u{1e94a}\u{1e900}\u{1e94c}\u{df}\u{1e95e}[\u{1e959}\u{e0001}\u{4c0f}\u{56d0a}\u{d1}\u{c35ef}\u{65cd}", "000000100001100101000000"),
  ("^\\pZ\$", "\u{106618}\u{6c8db}\u{3179}\u{1f600}\u{9}\u{3000}\u{fe}\u{c9}\u{f26b}\u{5515}\u{202a}\u{3587}]\u{2028}\u{1681}\u{bed80}\u{3000}\u{2a53}\u{2028}\u{10f243}\u{2fff}!\u{2001}\u{b6}", "000001000000010010100010"),
  ("^\\p{Kannada}\$", "\u{3000}\u{ce6}\u{5c98}\u{cb6}N\u{cdc}\u{cdf}\u{c93}\u{cdd}\u{e0001}\u{2ea69}\u{ccb}\u{c81}\u{cb2}\u{c80}\u{86}\u{2028}\u{c7f}\u{cef}\u{cdd}V\u{3000}\u{85}\u{cd6}", "010100011001111000110001"),
  ("^\\p{Georgian}\$", "\u{1cc0}\u{10c6}\u{2028}\u{10ffff}\u{1cbc}\u{1100}\u{531df}\u{1f600}\u{10fb}\u{1c91}\u{1100}y\u{a223}\u{1cbe}\u{6a5b}\u{10d1}\u{3}\u{1100}\u{1cba}<\u{2d24}\u{2028}u\u{2028}", "000000000100010100101000"),
  ("(?i)^\\p{Han}\$", "\u{10ffff}\u{2ebe1}\u{35181}\u{2b741}\u{c574}\u{2fa1d}\u{b4}\u{1a}\u{9fff}\u{16fe1}\u{2eff}\u{df}|\u{2b81f}\u{cd}\u{b6}\u{921e2}\u{9ff55}\u{1fd6}\u{7b6f3}\u{1f600}\u{3028}\u{ac}\u{16fe4}", "000101001000000000000100"),
  ("^\\p{finalpunctuation}\$", "\u{dde1b}\u{cefd4}\u{fb7fc}\u{97769}\u{ac}\u{7f6f}\u{a4}\u{c4119}\u{be}\u{9e0f}\u{f0}\u{80d8a}\u{10ffff}\u{3000}\u{af01f}\u{3714f}\u{64a44}\u{f1}\u{7f9a9}\u{1f600}\u{e91c}\u{ee089}\u{2b2d3}\u{b3}", "000000000000000000000000"),
  ("^\\p{Medefaidrin}\$", "\u{9940f}\u{16e3f}\u{8545c}\u{e3c93}\u{574}\u{16e99}\u{16e9b}\u{f4ad5}\u{8}\u{cf998}\u{16e40}\u{16e40}\u{10000}\u{c7}\u{10ffff}\u{f630}\u{16e41}g\u{16e3f}\u{7cf9}\u{16e41}\u{d3331}\u{a439e}\u{ee}", "000001000011000010001000"),
  ("^\\p{Thaana}\$", "\u{e5488}\u{9abe1}\u{7b1}\u{7b0}\u{7b1}\u{7b0}\u{e1cde}\u{f821}\u{7b2}l\u{7abc}8\u{781}\u{781}\u{e8}R\u{780}\u{7b1}\u{7b1}\u{2028}\u{77f}\u{781}\u{3000}\u{1f600}", "001111000000110011100100"),
  ("^\\P{Grantha}\$", "\u{1134c}\u{11313}\u{10ffff}\u{1134a}\u{1134c}\u{e1}\u{a2}\u{11343}\u{ec832}\u{11374}C&\u{11333}\u{300c}\u{10000}\u{1130f}s\u{11334}\u{105b9}\u{11328}\u{1134e}\u{1134c}\u{11334}\u{e4}", "001101101011011011101011"),
  ("^\\p{Tamil}\$", "\u{b9b}\u{ebfa}\u{f721d}\u{bc9}\u{12000}\u{9}\u{e0001}\u{11ff0}\u{11fff}\u{faadb}\u{506e}\u{bae}\u{7f}\u{baa}\u{4cbe0}\u{10000}\u{ba3}x\u{10ffff}\u{dc}\u{12000}\u{1e}\u{bd0}\u{ae}", "000000011001010010000010"),
  ("(?i)^\\p{NKO}\$", "\u{fffd}\u{e77a}\u{f7}\u{7c1}\u{7fb}\u{894fe}\u{7bf}\u{f8}\u{3000}U\u{7ff}\u{d4}\u{ab}\u{2028}\u{7c0}\u{800}\u{2028}H\u{7fe}\u{10000}\u{7ff}\u{6ab4}\u{81b5}\u{3239}", "000100000010001000101000"),
  ("^\\p{Cuneiform}\$", "\u{5c48}\u{1246d}\u{a7bd}S\u{11fff}\u{42644}\u{ca5bc}\u{12475}\u{1246f}\u{12401}\u{12400}\u{1137c}\u{ac3}\u{12398}\u{ff}\u{1246f}\u{1f600}\u{e4}\u{a2}\u{12480}\u{12544}\u{dce74}\u{80d2e}\u{12400}", "010000000110010000010001"),
  ("^[^\\p{Sm}]\$", "\u{fffd}\u{ff1f}\u{fb2a}\u{1f600}\u{b3}=\u{1f600}\u{2119}\u{58b4}\u{608}\u{3917e}\u{24cb}\u{10000}\u{b12a}\u{f5}\u{8d}\u{21af}M\u{1eef0}\u{2b30}\u{fffd}\u{d8}\u{ceeac}\u{2b44}", "111110111011111111001110"),
  ("^[^\\p{Pf}]\$", "\u{1f600}\u{2e05}\u{2e1d}\u{2e0d}D\u{2e04}\u{98}\u{201d}\u{19}\u{479d}\u{8e}u\u{bc55}\u{2e0e}\u{2e1d}\u{fffd}\u{2028}\u{201c}\u{2028}\u{ee}6\u{c7}\u{d8}\u{a0}", "100011101111110111111111"),
  ("^\\p{Separator}\$", "\u{6951d}\u{3b546}\u{e2}\u{d5d98}\u{ab587}\u{b1152}\u{59809}\u{e3}\u{fffd}\u{60ed}\u{3f00e}\u{bf749}\u{fe088}\u{103e62}\u{55991}\u{e6cdd},\u{c8d77}\u{fe}\u{e6bc}\u{e0825}\u{d7}\u{9a22e}\u{e0001}", "000000000000000000000000"),
  ("^\\p{Pi}\$", "t\u{10ffff}\u{9b20e}\u{e65a}\u{3c04e}\u{2e01}\u{24}\u{ba5f}\u{9b}}\u{f35}\u{2e1b}a\u{2018}\u{aa}\u{bea}\u{fffd}\u{ab}\u{2e03}\u{2567}\u{aa}\u{eb8fa}\u{eb76}\u{8ed9}", "000000000000010001000000"),
