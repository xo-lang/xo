  ("^[^\\p{Soyombo}]\$", "\u{1f600}\u{ea}\u{f9}\u{e0}\u{5e55}\u{11a4f}\u{11aa2}\u{11aa1}\u{101502}\u{11aa3}e\u{3eb05}\u{11a50}\u{f25f0}\u{11a4f}\u{3000}\u{15e9}\u{11a50}\u{b27eb}\u{11aa3}\u{11aa3}\u{a3}\u{e0001}\u{11aa2}", "111111001111011110111110"),
  ("^[\\p{Inherited}\\p{Greek}]\$", "\u{de}\u{b}\u{da}\u{f2190}\u{ea}\u{1cd0}\u{f630e}\u{1f600}\u{1cf9}'+\u{1d18b}\u{fffd}\u{d0}\u{1d1ae}\u{11db}\u{2028}\u{7fc89}\u{f7}\u{36e}\u{89}1.\u{27ab0}", "000001001001000000010000"),
  ("^\\p{nNNe}\$", "\u{207c}\u{21a7}\u{23e0}\u{5b09}\u{c}\u{10000}#\u{cd2c0}\u{2028}A\u{29db}\u{2b45}\u{21a1}\u{82c7}\u{ff1d}\u{e9f3}\u{1d770}\u{1d735}\u{54a1}\u{b}\u{27c1}\u{80}\u{27c3}\u{1f600}", "err"),
