  ("^\\p{Tagbanwa}\$", "\u{d89ff}@\u{1760}\u{5fd7}\u{28582}\u{e5f9}\u{2028}\u{ed}\u{2028}\u{1760}\u{5ece3}\u{1760}\u{1773}\u{10ffff}\u{a1}\u{b8}\u{1760}\u{3000}\u{176c}@\u{176b}\u{1e}\u{10ffff}\u{93}", "001000000101100010101000"),
  ("^\\P{Ne}\$", "\u{11401}y\u{a8}\u{68fdc}\u{1145a}2\u{1145e}\u{11462}\u{b700}\u{4319}\u{3000}\u{11401}\u{ba2ec}\u{c4a09}\u{1145d}\u{1145a}\u{cdc3d}\u{1145b}\u{b0}\u{11460}\u{aa}\u{10ffff}\u{1145e}\u{f70ad}", "err"),
  ("^\\p{tifinagh}\$", "\u{2d70}G\u{ce62}\u{fffd}\u{2d80}\u{2d6f}^#\u{2d7f}\u{3a06}(\u{2d7e}\u{7ba52}\u{2d71}\u{2d7e}*\u{2d80}\u{2d6f}\u{2028}\u{2d67}\u{422f9}\u{3033}\u{2d30}\u{2d7e}", "100001001000000001010010"),
  ("^\\p{Pf}\$", "\u{f2}F\u{2e0d}8\u{2e1e}\u{2019}\u{2e21}\u{2e0b}\u{201a}{\u{10000}\u{2e04}\u{9a}\u{6fb5e}\u{e225}\u{1d}\u{75fb8}\u{f86f}\u{6bde5}\u{8f902}\u{ba}\u{2e03}\u{2e04}\u{5a072}", "001001100000000000000100"),
  ("^\\p{C}\$", "\u{a143}\u{1075}\u{119a0}\u{5175}\u{2028}\u{3b03}/\u{1f46}\u{10ffff}\u{2028}\u{137f}\u{d}\u{f8}\u{3000}\u{180e}\u{9669}\u{10d39}\u{b58}\u{1c649}\u{1d17b}\u{18c2}\u{3000}\u{17}\u{20106}", "000000011011001001100010"),
