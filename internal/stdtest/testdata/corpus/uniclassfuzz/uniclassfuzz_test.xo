  ("(?i)^\\p{Modifierletter}\$", "0\u{51914}\u{ef5a}\u{9c2ab}\u{8639}\u{8e4a1}\u{79155}\u{85fb}\u{bd125}\u{2028}\u{47524}\u{1066ee}\u{a1}X\u{cc2ec}\u{7ff8c}\u{10c}\u{219e}\u{34274}\u{5a595}\u{24}\u{d16d9}g\u{1f600}", "000000000000000000000000"),
  ("^\\P{Connectorpunctuation}\$", "\u{3000}\u{739b7}\u{c891c}\u{e3769}\u{dca30}\u{10f4c7}\u{a40f6}\u{61bc0}\u{fd61f}\u{c2e86}\u{1f785}\u{10000}\u{12}\u{98458}\u{8e4f}\u{172}\u{d657f}\u{94671}\u{fddaa}\u{8bd08}\u{637eb}\u{fd}\u{5}\u{3000}", "111111111111111111111111"),
  ("^\\p{Unassigned}\$", "\u{99}\u{3000}\u{d5}\u{6293e}\u{e0001}\u{b2}t\u{c339a}\u{78e6c}x\u{efbea}\u{3000}\u{7dd91}\u{5a108}\u{360e2}\u{8}\u{6d7f4}\u{d1d0b}\u{e0001}\u{fb18}\u{40056}\u{9bacd}\u{4539}\u{b4855}", "000100011010111011011101"),
