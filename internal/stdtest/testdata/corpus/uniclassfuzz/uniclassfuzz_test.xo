  ("^\\p{Assigned}\$", "\u{7018f}\u{b8f5b}\u{c8}\u{9c7d}\u{108033}\u{abb24}\u{b3}\u{10959}\u{14}\u{b2bbd}\u{140d8}\u{fffd}\u{2b090}\u{8e}\u{50038}\u{3a42c}\u{57d2}\u{e0001}\u{517c5}\u{f356b}\u{39f3}\u{4a449}\u{28f8a}\u{2d224}", "001110101001110011011011"),
  ("^\\P{Glagolitic}\$", "\u{9b}\u{c88cd}\u{1e01a}\u{1e020}\u{fffd}\u{38b52}\u{fc1d}\u{1e026}k\u{a7f2}\u{b6}\u{1e007}\u{3000}U\u{1e022}\u{1e008}\u{1e022}\u{1b}\u{95}\u{8ee10}\u{f}\u{efec0}\u{1054}\u{8b}", "111011101111111011111111"),
  ("^\\p{McZ}\$", "\u{1f600}\u{e2}\u{10000}\u{d399b}\u{aaf5}\u{11727}\u{1}\u{90}\u{c01}\u{7b0dc}\u{1062}\u{456a}\u{1032}\u{1f07}\u{1b83}\u{119e4}\u{115af}E\u{1715}\u{112e2}\u{d45}\u{57ebf}\u{11cb1}\u{62d1e}", "err"),
  ("^[\\p{modifierletter}\\p{Greek}]\$", "\u{aa7fa}\u{10000}\u{157}\u{f1}\u{d4}r\u{9024}\u{555b8}\u{2028}\u{e5942}\u{1b51b}\u{5c49e}\u{7005}\u{c4b9}\u{a3326}\u{1c34}\u{338b1}\u{7f6ff}\u{488c7}\u{91}\u{9d621}L,\u{27364}", "000000000000000000000000"),
  ("^\\p{Hatran}\$", "\u{c7}\u{108f4}\u{1f}\u{108ff}\u{108f4}\u{108f4}\u{fffd}\u{10ffff}\u{108fe}\u{108f3}\u{10000}\u{108f4}\u{13cf}\u{108f3}\u{108ff}\u{1e}\u{e0001}\u{1f600}\u{1f600}\u{10ffff}\u{bd}\u{95}\u{b507a}\u{1f600}", "010111001001001000000000"),
  ("^[\\p{Bengali}\\p{Greek}]\$", "\u{980}\u{9b5}K\u{9ca}\u{98d} \u{982}\u{9b1}\u{9c7}\u{fffd}\u{1645}\u{c854a}]\u{6}\u{4}\u{86cf}\u{f9f20}h\u{1f600}\u{9d8}\u{9b9}\u{1064aa}\u{10ffff}\u{528b8}", "100000101000000000001000"),
  ("^\\p{Cs}\$", "\u{8b}\u{3f697}\u{c9}q\u{e000}\u{89}\u{e000}\u{f6}\u{625d}\u{636c3}o\u{99}\u{d9216}?\u{fd6b}\u{fffd}\u{fa27}\u{b0}\u{e0001};5\u{e5e4}\u{8268}\u{10ffff}", "000000000000000000000000"),
  ("^[^\\p{Gurmukhi-}]\$", "\u{a76}J\u{a12}\u{bfe4d}\u{a3f}\u{a42}*\u{3a32}\u{d}\u{a77}\u{a33}\u{ac606}\u{c41b}\u{e0001}\u{10000}\u{c}\u{98}\u{a38}\u{a65}\u{a36}\u{a34}\u{a76}\u{8e}\u{a40}", "011100111101111110101010"),
  ("^\\p{BATAK}\$", "\u{10000}\u{1bfb}\u{9b}\u{1bf2}P\u{1c00}\u{4163d}\u{7165}\u{1bfd}\u{1bfc}\u{9d}+\u{ec}\u{fc})\u{fd0b}\u{81}\u{1f600}l\u{1bfe}\u{1bfd}\u{1bc0}\u{cba7}\u{7b1d}", "000100001100000000011100"),
  ("^\\p{Rejan}\$", "\u{a953}\u{a95e}\u{f016}_\u{a953}\u{a960}\u{e0001}\u{50183}\u{9550}\u{3186}\u{a954}\u{c8}\u{a95f}O\u{2028}\u{a92f}\u{a931}\u{a92f}\u{a95e}\u{10ffff}\u{a954}\u{4358}\u{a953}\u{a95f}", "err"),
  ("^\\p{Vithkuqi}\$", "\u{10570}\u{105a2}\u{be}\u{9c74}\u{105a3}`\u{52fe}\u{7e976}\u{3000}\u{10594}\u{105b1}\u{2028}\u{10595}\u{105b1}\u{ae97}\u{e4}\u{8e311}\u{d5744}\u{6}\u{2028}\u{98}\u{1606}\u{105b3}{", "100010000110110000000010"),
  ("^[\\p{Hangul}\\p{Greek}]\$", "\u{d}\u{10ffff}kj\u{321d}\u{3000}\u{ba}\u{8b}\u{857ab}\u{d3}\u{ba}\u{1f600}\u{10ffff}\u{fc}\u{3048}\u{d7a2}`\u{ffd0}\u{10000}\u{1f600}\u{c4377}\u{a97d}\u{3000}L", "000010000000000100000000"),
  ("(?i)^\\p{Limbu}\$", "\u{b9}\u{1944}\u{5691c}\u{9b}~\u{3000}\u{192a}\u{f5c8b}\u{98}\u{1945}\u{2028}\u{2bc8a}\u{3000}\u{1931}\u{fffd}\u{fffd}\u{1fd74}\u{18ff}\u{3000}\u{1a}\u{1921}\u{e98b}\u{191d}\u{80}", "010000100100010000001010"),
  ("^[\\p{NKO}\\p{Greek}]\$", "\u{7fa}\u{7c1}\u{7c0}\u{5cba}\u{4a0b}\u{7fe}\u{72ee}\u{7fc}\u{aa}\u{1f600}\u{800}\u{b721c}\u{7fd}\u{7fd}\u{e1c7}\u{fafb}\u{ca}\u{7fc}\u{7f9}\u{4436}\u{c648}\u{7ff}\u{10ffff}\u{7fa}", "111001000000110000100101"),
  ("^\\p{Lati-n}\$", "\u{ff22}\u{16f82}\u{1d2b}\u{c9ce9}\u{2161}\u{d7}\u{1d25}N\u{b5}\u{f0df9}\u{2c5f}\u{6ef63}\u{83}\u{102eff}\u{1d61}\u{a7d9}\u{10000}\u{b8017}\u{55b7}\u{c6}\u{c0}`\u{f9}{", "100010110000000100011010"),
  ("^\\P{Tagbanwa}\$", "\u{c9}\u{10000}\u{176d}\u{1771}\u{10916d}\u{5aac}\u{1772}\u{d8e1e}\u{55ee}\u{2028}\u{6cbc5}\u{1761}\u{176c}\u{1772}\u{94}\u{1761}\u{6c28}MI\u{f8}\u{8f}\u{1772}\u{41ac}\u{176c}", "111111011110001011111010"),
  ("^[^\\p{Casedletter}]\$", "\u{605bc}\u{67c0}\u{3000}\u{48ecc}\u{aeb36}\u{80921}\u{38fc9}\u{ad756}\u{d6a4a}\u{ebb74}\u{1aab9}m\u{e0001}\u{4e638}\u{1522}\u{c5563}\u{7e2a0}\u{10ffff}\u{e0001}\u{2d68}_\u{5a56}\u{21280}\u{d5846}", "111111111110111111111111"),
  ("^[\\p{Mo}\\p{Greek}]\$", "\u{352ad}\u{18a9}\u{18ab}\u{11660}}y\u{1821}\u{a}\u{18aa}+\u{1f600}\u{521c8}\u{10000}\u{0},\u{1f600}\u{bead}H\u{11660}\u{1803}\u{e7}\u{3cca5}\u{1877}\u{1f600}", "err"),
  ("(?i)^\\p{Carian}\$", "\u{90159}\u{16aab}\u{3000}\u{102d1}\u{102a0}\u{3000}\u{2028}\u{c4754}\u{102cf}\u{102a0}\u{8a}\u{fffd}\u{102d1}\u{102d0}\u{e0001}\u{102cf}\u{efec5}L\u{102d0}\u{f}\u{1f600}\u{e0001}\u{9c05}\u{e0001}", "000010001100010100100000"),
  ("^\\p{S}\$", "\u{3}\u{d129}}\u{471df}\u{6c36}\u{3000}\u{f964}\u{6f6b2}\u{7f}\u{11a50}\u{11a4f}\u{fffd}\u{3000}2\u{6770}\u{11aa2}\u{11aa3}w\u{11aa1}\u{f8}\u{de}\u{11a51}\u{11aa3}\u{fd}", "000000000001000000000000"),
  ("(?i)^\\p{Buhid}\$", "\u{1740}'\u{1754}\u{d8}\u{ac}\u{1741}\u{eefad}\u{3159}\u{1754}\u{e0001}\u{1752}\u{1752}\u{48f8}\u{1753}\u{41a3}\u{1740}\u{1754}\u{17}\u{1752}\u{9}\u{173f}\u{4b01}H\u{5c}", "100001000011010100100000"),
  ("^\\p{Lisu}\$", "\u{51ad1}\u{11fb0}\u{a4d0}\u{a500}\u{ec}\u{a5f5}\u{11faf}\u{11fb0}\u{11fb0}\u{4d4d}\u{11faf}\u{4511}\u{d19c}\u{e7}\u{42334}\u{e6}\u{bd22}\u{11fb0}\u{239d}\u{fffd}\u{a500}\u{a4fe}\u{fffd}\u{a4ff}", "011000011000000001000101"),
  ("^\\P{Syriac}\$", "\u{74f}\u{86b}\u{700}\u{70f}\u{1f600}\u{19}\u{70c}\u{2028}\u{f36b}\u{9}\u{5b3a6}9\u{9f}}\u{98e91}\u{e0001}\u{74a}\u{3000}\u{70e}\u{74e}\u{bbd8}\u{95}\u{db}\u{e72c5}", "010011011111111101101111"),
  ("^\\p{Combiningmark}\$", "\u{12035}\u{9884}\u{8de38}\u{bf9b}\u{49bed}\u{10ffff}\u{8}\u{10000}\u{f6}\u{c2938}\u{721ab}\u{7fae6}\u{e4}\u{be474}\u{e0001}\u{2028}\u{8a}\u{48743}\u{69c2}\u{a908a}\u{70bec}\u{485e}\u{a38c9}\u{12d64}", "000000000000000000000000"),
  ("^[\\p{Cuneiform}\\p{Greek}]\$", "F\u{bdb6}\u{dc}\u{44a20}\u{7}\u{98}GT\u{1246f}\u{12001}\u{42497}\u{12542}\u{12400}\u{ff}\u{12399}\u{a03c}\u{12401}\u{12543}\u{1239a}\u{12001}\u{f7865}\u{12398}\u{12544}\u{12475}", "000000000101101011010100"),
  ("^[^\\p{N}]\$", "\u{16b5a}\u{7}\u{e35c4}\u{e}\u{325e}\u{f648}\u{aeb60}\u{b47}\u{214f}\u{c7e}\u{10857}\u{10106}\u{7a4f6}\u{2efe}\u{c0}\u{1072c2}\u{353bf}\u{ed0}\u{2adec}\u{e6}\u{b8}\u{1fdc1}\u{3250}\u{110f1}", "111101111011111110111110"),
  ("^\\p{tkLN}\$", "\u{5cf}\u{fa77}\u{5f5}\u{2759b}\u{fb4e}\u{10ffff}\u{10000}\u{bb}\u{fb35}\u{5c6}\u{fb43}\u{fb42}\u{fb44}\u{fb40}m\u{6c35}\u{3000}8\u{18c6}\u{f71ea}\u{fb}\u{fb4f}\u{2028}\u{fffd}", "err"),
  ("^\\p{Zl}\$", "\u{c2}\u{2027}\u{66cd}\u{2027}\u{ef}\u{1f600}\u{2028}\u{1f600}\u{3d0fd}\u{98}\u{2029}\u{2028}u\u{2027}\u{d4830}\u{20a4}\u{f35e}\u{2028}\u{11}\u{2027}\u{10}\u{4}\u{98}\u{2027}", "000000100001000001000000"),
  ("^\\p{MODIFIERLETTER}\$", "\u{4f1ef}\u{8c}&V\u{c7d2a}\u{a5f21}\u{e971e}\u{1e8b0}\u{f1a65}\u{10ffff}+\u{6c266}\u{5be}\u{2028}*\u{78b5a}\u{d5a9d}\u{4fd6}\u{28ec1}\u{10}\u{c6}b\u{8ebc6}\u{eea21}", "000000000000000000000000"),
  ("^\\p{Braille}\$", "\u{f3506}\u{27ff}\u{46ab}\u{6f59d}O\u{3000}\u{d}@\u{28fe}\u{102ea8}\u{d4}9\u{2345b}\u{27ff}\u{1f7e2}\u{aceb}\u{61f89}\u{10ffff}\u{28fe}\u{be}U\u{b057a}Lh", "000000001000000000100000"),
  ("^\\P{Currencysymbol}\$", "\u{bf}\u{f8}\u{9973b}\u{ca}\u{c82bf}\u{3000}\u{23869}\u{96fdf}\u{8b7d}\u{315e3}\u{dac7c}\u{bc2c}\u{fb}\u{9b}\u{6be7e}\u{fffd}\u{2fb55}\u{629b}\u{11607}\u{3f432}\u{e2}\u{ad}\u{c9de3}\u{fffd}", "111111111111111111111111"),
  ("^[\\p{Chorasmian}\\p{Greek}]\$", "\u{d636}\u{10fb0}\u{10fcc}\u{10fcb}\u{10fb0}\u{10fcc}\u{10fcc}\u{10fca}\u{bf}\u{6f121}\u{4a36}\u{10fcc}\u{10fb1}\u{e2}\u{7abf}\u{10fcb}\u{10fcc}\u{10fcb}\u{2ffe}\u{6}\u{10faf}\u{10faf}\u{10fca}\u{10fca}", "010110010000100101000011"),
  ("^\\p{tSZekl}\$", "\u{e5fb3}\u{963c6}?\u{b5}E\u{41c78}\u{78fc9}\u{68cd}\u{86ef9}\u{1f600}\u{1f600}\u{2a69a}\u{cd585}\u{5887e}\u{e826f}\u{32d22}\u{217d4}\u{cda2}3\u{cc256}\u{10000}\u{59f7e}\u{599df}\u{3000}", "err"),
