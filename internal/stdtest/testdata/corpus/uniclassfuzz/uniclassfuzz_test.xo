  ("^[\\p{Nushu}\\p{Greek}]\$", "\u{cf}\u{c5}\u{1f600}\u{1b16f}\u{1b2fa}\u{1b16f}\u{c23e3}\u{eb}t\u{2f4a}\u{1b2fc}\u{4ef1a}\u{1b171}\u{1b171}\u{aa}\u{f}\u{19}\u{b0}\u{d42ba}\u{1b170}\u{1b2fb}\u{e3}\u{c4}\u{b6b7}", "000010000000110000011000"),
  ("^\\p{Brahmi}\$", "\u{11080}v\u{1107f}\u{11000} \u{10ffff}6L\u{451ea}\u{82}\u{11001}\u{ea}\u{a4}\u{f}\u{1107e}\u{b7}\u{1107e}\u{11080}\u{11074}\u{d}\u{f60f}-\u{11076}\u{11080}", "001100000010000000100000"),
  ("^[\\p{Openpunctuation}\\p{Greek}]\$", "\u{bf150}V\u{ff4e8}\u{1012dc}\u{89}\u{b}\u{2028}\u{64ad}\u{716f2}\u{7b14}\u{ad53d}\u{cc57f}\u{fd954}\u{9cab1}\u{d675}\u{4f162}U5f\u{3cbcd}\u{79fcb}\u{fffd}\u{caca}\u{7b337}", "000000000000000000000000"),
  ("^[^\\p{P_s}]\$", "\u{2028}\u{e84b9}\u{201a}\u{10000}\u{e9dc}\u{29fb}\u{315}\u{c674}2\u{2028}\u{93939}|\u{201a}\u{ff07}\u{fe37}\u{2028}F\u{ec}\u{b514}\u{614f7}\u{b2}\u{e5}\u{ff3b}\u{10000}", "110111111111010111111101"),
