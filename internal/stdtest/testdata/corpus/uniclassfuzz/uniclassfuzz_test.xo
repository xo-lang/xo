  ("^\\p{Co}\$", "\u{f8ff}\u{26f3f}\u{a3fa}\u{24}\u{e001}|\u{a1}\u{10fffc}\u{10fffe}\u{31c4}|\u{ad44c}m\u{c506}\u{a4}\u{ffffd}3\u{effff}\u{10fffe}\u{9ef68}\u{10fffc}\u{d740}\u{b3}6", "100010010000000100001000"),
  ("^\\p{O}\$", "*\u{4d2f7}\u{f768a}\u{fffd}\u{d4fb8}\u{f8947}\u{51a1a}\u{4410}\u{d7}\u{fc789}\u{101f0}\u{a0b58}\u{9eb62}\u{ec}L\u{6dc88}\u{485fc}\u{fffd}\u{10ffff}\u{db}\u{2028}\u{ed}\u{22}\u{714b7}", "err"),
  ("^\\p{Privateuse}\$", "\u{f9}\u{95c2}\u{fb3b9}\u{675a}\u{5c508}\u{b36c9}\u{10000}\u{9f}\u{9d285}\u{13}\u{10ffff}\u{10ffff}\u{b2f4b}\u{1d}\u{8ec24}\u{a7992}\u{2e2fe}\u{f0}\u{1f600}\u{e4}\u{77fd}\u{b68ab}\u{10000}\u{1725e}", "001000000000000000000000"),
  ("^\\P{Modifiersymbol}\$", "9\u{e0081}\u{fa2}\u{b198}\u{eb}G\u{102f17}\u{338e9}\u{1f600}\u{fab5d}\u{10000}\u{20c3}\u{3e8ec}\u{9c43f}\u{3feb8}\u{22008}\u{b6cab}\u{1e}\u{fb}\u{1c}\u{b6}\u{e9c89}O\u{aa}", "111111111111111111111111"),
  ("(?i)^\\p{Bamum}\$", "\u{16800}\u{a6a1}\u{34d75}a\u{3000}G\u{2927f}\u{a6f8}\u{16a38}\u{1f600}\u{e0001}\u{a6a0}\u{16a39}\u{3c6}\u{ca}\u{e0001}\u{a69f}\u{263e4}\u{3000}\u{a6f7}\u{8e9b}\u{0}\u{3000}\u{a6a0}", "110000001001000000010001"),
  ("^\\P{Sk}\$", "\u{ab5b}\u{e2}\u{10000}\u{61125}\u{ff3e}\u{24935}\u{bc8d}\u{888}*\u{fffd}\u{18ce6}\u{efca6}\u{2e4}\u{9e}\u{97cfa}\u{1fc0}\u{b7}\u{a701}6\u{93}\u{b7}2L\u{ae}", "011101101111111010111111"),
  ("^[^\\p{Hiragana}]\$", "\u{1b14f}\u{e411}|\u{30a0}\u{a2e4}\u{1b001}\u{1b11f}\u{0}8\u{1b000}Q\u{3095}\u{30a0}\u{1f1ff}\u{89}\u{d41}\u{309d}\u{309e}\u{e0001}\u{1b131}\u{2028}\u{e5849}\u{1b14f}\u{3000}", "111110011110111100111111"),
  ("^[\\p{Cuneiform}\\p{Greek}]\$", "\u{5d7ec}\u{84}\u{10000}\u{75a0}`k\u{df}\u{1246f}\u{f2cac}\u{b0}\u{1b}\u{10ffff}\u{12000}\u{12000}\u{7b97b}\u{7827}W>\u{8508}\u{12470}\u{ca6c6}\u{c}\u{6a254}%", "000000000000110000010000"),
  ("^\\p{Lycian}\$", "\u{1029c}\u{10281}\u{1029b}\u{10ffff}\u{2028}\u{3e85}\u{2028}\u{1029b}\u{1029d}}\u{1029c}\u{10280}\u{1d343}o\u{1029c}\u{3000}\u{db25d}\u{10280}\u{bd}\u{1029c}\u{37270}\u{1029b}\u{a}\u{c7}", "111000010011001001010100"),
  ("^[^\\p{z}]\$", "\u{e0001}M\u{2030}\u{2fff}\u{11}\u{205f}&\u{b940b}\u{e0001}\u{74181}\u{1fff}\u{205f}\u{f8}\u{d0}\u{c6}\u{8c6c}\u{de}\u{727}\u{1680}\u{72a71}\u{2028}\u{2029}\u{93}t", "111110111110111111010011"),
  ("^\\p{Number}\$", "\u{cf169}>\u{1f598}\u{ece}\u{823ce}\u{fb290}^w\u{2f803}\u{e2}\u{7e27}\u{6233c}\u{fb}F\u{c8}\u{2f617}\u{29ed5}\u{5e7e5}\u{b8df4}\u{10000}\u{d135}\u{6bcdc}\u{85}\u{f9}", "000000000000000000000000"),
  ("^[^\\p{Lt}]\$", "\u{10000}\u{1f8e}\u{44e5}\u{1cc}\u{ab}\u{1f9f}\u{1f8e}\u{7363}\u{1fbc}\u{1f9f}\u{f04ee}\u{43473}\u{1fcd}\u{6262}\u{1fb0}\u{1f3}\u{1f99}\u{b246b}\u{1ca}\u{10000}\u{fb}\u{1f98}\u{10000}\u{3000}", "101110010011111101111011"),
  ("(?i)^\\p{Devanagari}\$", "\u{a900}:\u{81}\u{f2}\u{d719}\u{11aff}n\u{794f}*\u{da}\u{fffd}\u{967}\u{a8df}\u{3778}\u{2060}\u{d69e4}\u{98}\u{a8e0}\u{b4}\u{1d53}\u{5362c}\u{d9}\u{8ff}\u{e0001}", "000000000001000001000000"),
  ("^[\\p{Hatran}\\p{Greek}]\$", "\u{1f600}\u{7dfb}\u{ad6c6}\u{108f5}\u{108f4}\u{b8ded}\u{108f1}Q*\u{1f600}\u{2028}\u{108f3}\u{6c89}\u{108f4}\u{2028}\u{21d8}\u{108ff}\u{3a8b9}\u{108f1}\u{d6d1}M\u{108f6}\u{91}\u{108f4}", "000110100000010010100001"),
  ("^\\p{Gothics}\$", "\u{10331}\u{9ffb}\u{10290e}\u{b4}\u{10331}\u{c0c05}\u{9d}\u{1032f}\u{1034a}\u{10349}\u{2983}\u{8e40b}\u{f4111}\u{1034a}\u{1034a}\u{10331}\u{9e7e}\u{f3}\u{c5}\u{92ce0}!\u{1034b}\u{10330}\u{10330}", "err"),
  ("^\\p{Shavian}\$", "\u{c7cc}\u{5b5c}\u{8d}\u{10451}\u{9447}\u{10000}\u{3000}\u{9b31b}\u{fffd}\u{10451}*\u{1047f}=\u{e0001}\u{418b}\u{f229}\u{4410}\u{10451}\u{1f600}\u{10480}\u{9e1c}\u{1047f}\u{934}\u{10480}", "000100000101000001000100"),
  ("^[^\\p{Khudawadi}]\$", "\u{112f1}\u{bb}\u{257bb}\u{112ef}\u{112f9}\u{112b1}\u{cc}\u{39b23}\u{112ef}\u{112e9}\u{112e9}\u{10ffff}\u{112b1}\u{f9}\u{1f600}\u{5c}\u{112b0}\u{112fa}\u{11}M\u{3b053}\u{60ac}\u{10ffff}\u{a4}", "011100111001011101111111"),
  ("^[\\p{Miao}\\p{Greek}]\$", "\u{16f90}\u{1f600}w\u{f1}\u{99e3}\u{16f8e}\u{8e}\u{cc}\u{16fa0}\u{16f4b}\u{16f9e}\u{92}\u{8e}\u{10ffff}\u{c867}\u{b2}\u{3229}\u{e0001}\u{e4}\u{96}\u{10000}\u{5a569}G\u{3000}", "100000000010000000000000"),
  ("^[^\\p{Enclosingmark}]\$", "\u{a7615}\u{ae42f}\u{2b44}\u{a1c8}\u{e4}\u{bc7e}\u{701c5}\u{14cc1}\u{dc0f9}\u{2ad9e}R\u{e0001}l\u{f3}\u{df}\u{80c31}\u{efacf}\u{8d02c}\u{e0001}\u{e63f3}\u{10000}\u{c617a}\u{3c13f}\u{45b23}", "111111111111111111111111"),
  ("^\\P{Lowercaseletter}\$", "\u{c3}\u{485b9}\u{345ca}\u{e88d2}\u{f3}\u{29b29}\u{4a05c}\u{3595}\u{ee0b7}\u{ffec9}\u{5}\u{ce18}\u{5}\u{11}\u{5ccea}\u{fffd}\u{f37da}\u{37ec}\u{6075}\u{10ffff}\u{3000}\u{c85fb}\u{1}\u{dd325}", "111101111111111111111111"),
  ("^[^\\p{Tangut}]\$", "\u{3000}\u{aaa1},#\u{95}\u{2028}\u{16fff}\u{e4}\u{18d08}\u{ab}\u{14550}\u{187f8}\u{16fdf}\u{1f600}\u{10023b}\u{8cfc}\u{8bcaa}\u{18aff}\u{72d40}\u{187f6}\u{16fdf}\u{bc3c}\u{b}\u{107b76}", "111111110111111110101111"),
  ("^\\p{Armenian}\$", "\u{3}y\u{fb14}\u{f0}\u{fb13}\u{58c}\u{98b3}\u{590}\u{532}\u{10000}\u{fffd}\u{559}\u{e1}\u{fb18}\u{2c36}\u{559}\u{557}\u{2028}\u{88f4}\u{11ac}\u{87b2}\u{17}\u{55a}\u{8d79}", "001010001001000100000010"),
  ("^[\\p{Medefaidrinx}\\p{Greek}]\$", "\u{16e9a}\u{18}\u{10000}\u{e9a3}4\u{b4}\u{fffd}\u{16e9a}\u{1ffd}\u{a8}\u{16e9b}\u{16e41}\u{16e99}\u{f4}\u{de}\u{10000}\u{16e99}\u{1f3cc}\u{10000}\u{16e9b}\u{e0001}\u{86}\u{16e3f}\u{92}", "err"),
  ("^[^\\p{NewaZ}]\$", "\u{11400}\u{2ade}\u{73ef4}\u{9d}\u{11460}\u{9f}pw\u{1145c}\u{5382}\u{1145a}\u{10ffff}\u{1145c}.\u{c31bf}\u{14}\u{4253}\u{2ff}\u{a7}\u{48110}+\u{10}\u{f07b2}\u{113ff}", "err"),
  ("(?i)^\\p{Ori_ya}\$", "\u{b01}\u{86}\u{b76}\u{2028}\u{b00}\u{b66}\u{b49}\u{b33}\u{bb85}\u{d5}B\u{b76}/\u{b04}\u{b33}\u{b39}\u{b14}\u{a6}\u{b30}\u{b7}\u{f8661}\u{c8d}:\u{ab}", "101001010001001110100000"),
  ("^\\p{Nabataean}\$", "\u{108ae}_\u{e34b5}\u{10b773}\u{108ae}\u{cb}\u{6dc5b}\u{b7284}\u{86}\u{1089d}\u{95f4c}\u{ea2bf}\u{1089e}\u{4ddb}\u{10880}\u{1089e}\u{108af}\u{1089d}\u{d9669}\u{1939}\u{10880}\u{7f}\u{108ae}\u{108ae}", "100010000100101111001011"),
  ("^\\pC\$", "''\u{f55c}\u{ab16}\u{10a58}\u{1037b}\u{f0}\u{b54a6}\u{4457}\u{108f6}R\u{83}\u{f8}\u{8b}\u{cb19}\u{c28}\u{1f1e6}\u{aa38}\u{3d5e}\u{eb7}\u{7ee0}\u{f47b5}\u{bb}\u{a1ce}", "001001010101010001000100"),
  ("(?i)^\\p{Tibetan}\$", "\u{76e51}\u{10ffff}\u{eff}\u{81}\u{fcd},[\u{d535}\u{fcf}\u{fcd}\u{eff}\u{fffd}\u{84cd}\u{fcb}\u{f7b12}\u{58e8}\u{96}\u{f47}\u{e9fe}\u{fd3}\u{fbe}\u{fcd}\u{f46}\u{f97}", "000000001000010001011011"),
  ("^[\\p{Zs}\\p{Greek}]\$", "\u{202f}\u{1680}\u{513e}\u{afd3}\u{3e38f}S\u{205f}\u{2009}\u{f8}\u{c656d}\u{205e}\u{1f}\u{10000}\u{3000}\u{af}k=\u{c}\u{85}\u{1681}\u{a1}\u{2030}\u{2002}\u{9f}", "110000110000010000000010"),
  ("^[\\p{Ethiopic}\\p{Greek}]\$", "\u{5c}\u{d07d7}X\u{e0001}\u{177c2}\u{2daf}\u{125b}\u{ab10}\u{12c5}\u{135c}\u{1317}\u{3000}\u{3019f}\u{2cc2}\u{86}\u{a1}\u{2dde}\u{d2}\u{c1}\u{c5}\u{c11d9}\u{12c3}\u{ab08}\u{1255}", "000000101000000010000101"),
  ("(?i)^\\p{Lao}\$", "\u{65ef}\u{b3}\u{ed0}\u{fb}\u{2893}\u{3000}\u{3000}\u{ec7}\u{3000}\u{8e78d}\u{51d9}8s\u{ea7}\u{e8b}\u{ec0}\u{ecd}\u{ea9}\u{ecf}}\u{dc}\u{a538}\u{ff86e}\u{ed1}", "001000000000010111000001"),
  ("^[\\p{C}\\p{Greek}]\$", "\u{1e}\u{7f}\u{9e}\u{d45}\u{2cdf}\u{202f9}\u{d8aca}5\u{e64f}\u{109d2}\u{2877}\u{1d507}\u{11939}\u{e5a4a}\u{e5}\u{128f}\u{1b7f}\u{2093d}\u{1944}\u{e0001}\u{7f}\u{1e}\u{93687}\u{201fc}", "111100101000110110011110"),
  ("^\\p{Tibetan}\$", "\u{f97}\u{ee299}\u{4d0f}\u{fbe}\u{16}\u{fbf}\u{fbb}\u{2c684}\u{84}\u{d9}\u{19f22}\u{f47}\u{fcd}\u{3000}\u{cd}\u{f6c}\u{fce}\u{f48}\u{28ed1}\u{f96}\u{fbb}\u{fce}\u{90}\u{b5}", "100101100001000110011100"),
  ("^\\p{Lc}\$", "\u{10f0cd}\u{b7}\u{11b1a}\u{925f8}\u{e8}\u{3667a}\u{3000}*\u{2a58e}\u{6ecc8}\u{e6128}\u{ed}\u{2008}\u{c020d}\u{d32f1}\u{ab}\u{ade14}\u{a9400}\u{3000}n\u{3000}\u{cf12}\u{b08f6}\u{53fd6}", "000010000001000000010000"),
  ("^\\p{Sharada}\$", "\u{6539b}\u{fffd}\u{1117f}\u{111de}\u{111df}\u{111e0}\u{111de}\u{40ac3}\u{1a272}\u{1117f}\u{2028}\u{11180}M\u{111e0}\u{7d7a}l\u{2680}\u{5c5}\u{111e0}\u{11181}\u{111de}\u{1f600}\u{567b2}\u{e0}", "000110100001000000011000"),
  ("^[\\p{SUNDANESE}\\p{Greek}]\$", "\u{b914c}[\u{3000}\u{2028}\u{f84ed}\u{1cc1}\u{3e65}\u{1cc1}\u{1b81}\u{10000}\u{1b80}\u{f5}\u{1bbe}\u{fffd}\u{10a236}\u{1b81}\u{e3e4}\u{3000}\u{ca35f}\u{1cbf}\u{2f31}P\u{1cc6}\u{e0001}", "000001011010100100000010"),
  ("^\\P{Pia}\$", "\u{5c}\u{d0}2\u{a7}\u{e0001}\u{201d}\u{ea}\u{a9}\u{201a}\u{a3}\u{2e05}\u{2e0b}\u{eb}\u{2e08}\u{d6}\u{1f600}\u{b0}\u{3000}\u{ab}\u{4}\u{ac}\u{10000}\u{c700c}\u{201f}", "err"),
  ("^\\p{Han}\$", "\u{b9}\u{3400}\u{fffd}\u{33ff}\u{1f600}\u{a010}\u{e0001}\u{10ffff}\u{3005}\u{16fe1}\u{2ef4}\u{eb41e}\u{16fe2}\u{20000}\u{2fa1c}\u{fa6c}\u{87a52}\u{3020}\u{10ffff}\u{2b73f}\u{a09c}\u{2ef2}\u{ac}\u{d8}", "010000001000111100000100"),
  ("^\\p{Choras}\$", "\u{10fca}\u{10fcb}}\u{16}\u{f4396}\u{10fb1}\u{4cdb}^\u{768cf}\u{3000}\u{10fca}\u{fa}\u{99}\u{a1}\u{10fcc}\u{10faf}\u{fd45}}\u{10fcb}\u{5c}\u{5a18}\u{10fb0}\u{10fb0}\u{e0001}", "err"),
  ("^\\p{NL}\$", "\u{9e}\u{2189}\u{10ffff}\u{1013f}\u{1ab2}\u{208c5}\u{a9}?9\u{d35a}\u{1034a}\u{e0001}\u{3028}\u{10340}\u{ea07}\u{af}\u{6263c}\u{10340}\u{1f600}\u{5f03}\u{fa}\u{15}\u{2187}\u{303b}", "000000000010100000000010"),
  ("^\\p{Tamil}\$", "\u{b9e}\u{bcf}\u{e3}*\u{4ac92}\u{3000}\u{b9c}\u{c0}\u{9d}@\u{460b}\u{b35b1}\u{85}\u{4c1b4}.\u{1293}\u{11fbf}\u{b8d}\u{8204}\u{1dcf}\u{df}\u{ee}\u{b9b}\u{d180c}", "100000100000000000000000"),
  ("^\\p{Lycian}\$", "^\u{6dc3}\u{10280}\u{df}\u{8a47a}\u{1029d}\u{e5}\u{406dd}\u{96}\u{1029b}\u{10281}\u{1029d}\u{10ffff}\u{10280}\u{1027f}S\u{1029b}\u{fffd}\u{1ab4d}\u{ebde9}\u{10281}\u{10281}\u{f6}\u{22}", "001000000110010010001100"),
  ("^\\p{Bamum}\$", "\u{16a38}Q\u{a2}\u{535c9}\u{9c}\u{16a38}\u{2}\u{16801}\u{16801}\u{167ff}\u{a6a1}\u{a6a0}\u{17}\u{a6a0}\u{16a39}\u{4821}\u{a59fd}\u{a6f6}\u{e2}\u{a6f7}\u{e0001}\u{167ff}\u{167ff}\u{1cf65}", "100001011011010001010000"),
  ("^[\\p{Commo n}\\p{Greek}]\$", "\u{2028}\u{d4}\u{5ee96}\u{bba7}\u{ff02}\u{17}\u{9d}\u{2028}k\u{d6}\u{605}\u{2ea}\u{10000}\u{2b96}\u{fffd}\u{33ff}\u{fffd}'\u{2028}\u{1fadc}\u{fa}\u{fd3f}\u{1f600}\u{a9d0}", "100011110010001111100110"),
  ("^\\p{G}\$", "\u{f742}\u{a66}\u{d62ff}\u{b8}\u{c6}\u{ed}\u{1f600}\u{dc}\u{a3e}\u{a66}\u{a02}\u{fffd}\u{be}\u{f7055}\u{a3d}\u{e9}\u{a28}\u{b7fe5}\u{9cc5e}\u{a34}\u{86}\u{a0b}\u{937c}\u{f8}", "err"),
  ("^\\P{Letternumber}\$", "\u{8ebc1}\u{e0001}d\u{c3f73}\u{2daff}\u{88bbd}\u{dd39c}\u{47d7f}\u{e6119}\u{ed}\u{7e3fc}\u{196c}\u{d9e2b}\u{859e1}\u{a0dc1}\u{ec5cf}\u{df}\u{b73a7}\u{3514b}\u{d169}\u{d581}\u{f4874}\u{23004}\u{5a3e2}", "111111111111111111111111"),
  ("^\\P{Nd}\$", "\u{1a55}\u{1f600}\u{4811d}\u{6477}\u{11c4f}\u{6a59a}\u{266e7}\u{91}\u{110f9}~\u{fffd}\u{10ffff}\u{e0001}\u{fffd}\u{d8bc9}\u{a70}\u{118ea}P\u{634ad}\u{7d6a}\u{f91d}\u{17e1}\u{cea}\u{c0f3f}", "111111110111111111111001"),
  ("^\\p{Manichaean}\$", "\u{f1}\u{10ac0}\u{10af5}\u{10abf}W\u{10ae6}\u{84471}\u{10aeb}\u{a3}\u{10aeb}\u{96}\u{bd}\u{e0001}\u{3000}\u{bec4e}\u{10aea}\u{1f600}\u{ae}\u{5cf34}\u{ca6f6}'\u{10aea}\u{b415}\u{afb}", "011001010100000000000000"),
  ("^\\pC\$", "\u{10eb1}\u{7fa20}\u{4771b}+\u{91c9}m\u{a1}\u{10ffff}\u{10b77}\u{864fd}\u{df}\u{fd}\u{22}\u{af}{\u{1004e}\u{10b91}H\u{1f600}\u{f4}\u{187f8}\u{1aff3}\u{eeea}\u{ae}", "011000011100000100001010"),
  ("^\\p{Titlecaseletter}\$", "\u{a749b}\u{1f600}\u{651bf}\u{c68b5}\u{10000}K\u{3000}\u{e86c2}\u{dc}\u{253c5}\u{2}\u{1b9e6}\u{6a2e7}\u{17}\u{8ef7b}\u{2028}\u{8a05}\u{2028}\u{950d8}\u{10d24c}\u{fe}\u{3000}\u{e1067}\u{eaeda}", "000000000000000000000000"),
  ("(?i)^\\p{Nonspa}\$", "\u{a3533}\u{b20f7}\u{3000}\u{1fa93}\u{a89a2}\u{7f715}\u{11e21}\u{d97bc}^\u{2028}l\u{a8}\u{c1}\u{a96fe}\u{c}u\u{af790}\u{104b58}\u{8c}\u{1f600}\u{cc}\u{7963f}\u{8cd8f}\u{1de85}", "err"),
  ("^\\P{Initialpunctuation}\$", "\u{315a}\u{89ea0};\u{8b1d1}\u{9ad81}\u{222e0}\u{488d5}{\u{7f84e}\u{4bf3d}\u{5123e}\u{e5615}\u{5f58e}\u{360af}\u{900c6}\u{2ca7}\u{53514}\u{c003b}\u{84}\u{cdd8}\u{d9b}\u{a}\u{c8}V", "111111111111111111111111"),
  ("^\\p{cherokee}\$", "_\u{18}\u{139f}\u{5095}\u{1f600}\u{13f6}\u{aa}\u{ab6f}~\u{abc0}\u{13f5}\u{abbe}*\u{ab6f}\u{3000}\u{d7}\u{13fe}\u{13fc}\u{13f6}\u{13f4}\u{13a1}\u{e1726}\u{83}\u{5f36}", "000000000011000001011000"),
  ("^[\\p{Vithkuqi}\\p{Greek}]\$", "\u{1057b}\u{9}\u{fffd}\u{10596}\u{fffd}O\u{1058c}\u{105ba}\u{86}\u{10594}\u{10595}\u{61e92}\u{10ffff}\u{10595}-\u{aa}\u{b6d5e}\u{b203}\u{84}\u{105a2}\u{1057d}\u{b5eb}\u{1058a}\u{10570}", "000000100110010000001011"),
  ("^\\p{Thaana}\$", "f\u{7e9a}\u{10000}\u{3000}\u{781}\u{5aad}\u{7b0}\u{7b1}\u{9e}\u{781}\u{fffd}.\u{781}\u{e602}\u{cf}\u{8905f}\u{ec}\u{9a8d}\u{b9b7}\u{77f}\u{91}\u{2028}\u{c9ca7}\u{77f}", "000010110100100000000000"),
