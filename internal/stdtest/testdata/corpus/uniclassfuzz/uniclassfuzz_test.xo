  ("(?i)^\\p{Bengali}\$", "\u{fb36c}\u{10aa3b}\u{2028}\u{94}\u{5d26}\u{9c8}\u{fc}\u{9b7}\u{c8}\u{f94eb}\u{52c4c}\u{e0001}\u{9d7}\u{fffd}\u{9c7}\u{e7e3}\u{10eb78}\u{1f600}\u{922}\u{9ab}\u{9b1}\u{af}\u{9d3f}\u{a98e}", "000001010000101000010000"),
  ("^[^\\p{Closepunctuation}]\$", "\u{e6f0b}\u{1f600}\u{fffd}\u{adbec}\u{1083f}\u{102249}&\u{8e66e}\u{1b}\u{69ead}w\u{2d5b4}\u{9175b}\u{101e8d}z\u{e0001}\u{ed}\u{b188a}\u{108ea8}\u{6b243}\u{2028}MZ\u{251ff}", "111111111111111111111111"),
  ("^\\p{Othernumber}\$", "\u{3000}\u{3}\u{39c30}\u{93caf}\u{49c41}\u{de158}\u{d7711}\u{e0001}\u{755f}\u{1f600}#\u{c16cb}\u{8774}\u{109648}+\u{1a261}\u{10000}\u{d4930}\u{50b1d}\u{c57b5}\u{c4}\u{13d20}\u{621ea}*", "000000000000000000000000"),
  ("^[\\p{Vai}\\p{Greek}]\$", "\u{a500}\u{106c22}\u{fffd}\u{a62a}\u{f0a9}\u{a62c}\u{a62a}t\u{1d}\u{a62c}\u{9025b}\u{a62b}\u{7223d}\u{c137}\u{99f69}\u{a62a}\u{cb}\u{a4ff}\u{9f32}\u{b930}\u{3000}\u{fa885}\u{dc}\u{9f}", "100100100001000100000000"),
