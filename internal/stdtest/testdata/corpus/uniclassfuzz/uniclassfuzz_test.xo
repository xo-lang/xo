  ("^[^\\p{Syriacx}]\$", "\u{b6}\u{fe}b\u{63a7}\u{86a}\u{d4542}\u{fffd}\u{710}X\u{e8}\u{d6}\u{4781b}\u{737ef}L\u{10000}\u{bdda}\u{70d}\u{e1}\u{2028}\u{861}\u{74e}<\u{f2a26}\u{346b}", "err"),
  ("^\\P{Myanmar}\$", "\u{1000}\u{de}\u{109f}x\u{e446}\u{aa5f}N\u{85cc7}\u{5cfe3}\u{a9df}S\u{aa7e}\u{e2}\u{a9e0}\u{8f}\u{a9e0}|\u{17}\u{10a0}\u{1000}\u{fd}\u{aa80}\u{a9e1}\u{ead3}", "010111111110101011101101"),
  ("^[^\\p{Myanmar}]\$", "\u{a9ff}\u{fb}\u{315a}\u{81}\u{c9597}\u{a9e1}\u{18d2}\u{a9fd}\u{b7}\u{566b8}\u{b6}\u{6b882}M\u{aa60}\u{109f}\u{70df9}\u{aa80}\u{dbefc}\u{3be7}\u{9c}\u{2028}\u{2028}\u{a9df}\u{3924}", "111110101111100111111111"),
  ("^\\p{Common}\$", "\u{ed97}\u{1f77b}a\u{f6}\u{10000}r\u{bf}\u{cb4a}\u{3000}\u{3ed92}\u{d0bc1}\u{8ff5}\u{1070e2}\u{eb}\u{91}\u{ad}\u{3000}\u{fe6a}\u{96}\u{1f23b}\u{af}\u{1d7cd}\u{15}\u{d0}", "010000101000001111111010"),
  ("(?i)^\\p{Hangul}\$", "\u{b3}\u{a3a13}\u{ffd9}\u{327e}1\u{50484}}\u{f9}\u{e803}\u{ffcf}\u{1f600}\u{f6}\u{d7a4}n\u{327f}\u{ff9f}1\u{ffdd}Z\u{2028}\u{a960}\u{318d}\u{ffc3}\u{ffd8}", "000100000100000000001110"),
  ("^\\p{Duployan}\$", "\u{e8}\u{9b}r\u{812d}\u{1bc7c}\u{1bc7d}\u{1bc90}\u{e0001}\u{7447f}\u{1bc9e}\u{1bc90}\u{1bbff}j\u{5013}\u{e0001}\u{e0001}\u{69dd7}\u{a8}\u{fffd}\u{5436}\u{84}\u{c5}\u{3000}\u{3000}", "000010100110000000000000"),
