  ("^\\p{Khmer}\$", "?\u{e0001}\u{9538a}\u{117d7}\u{1a00}+\u{f10ae}\u{17e1}\u{f2}\u{e0001}\u{5a14}\u{1a00}\u{17f8}\u{bc61}\u{10ffff}\u{1982}\u{fffd}\u{10ffff}\u{4da9}\u{1780}\u{dbd2a}\u{9d}\u{17dd}\u{1f600}", "000000010000100000010010"),
  ("^\\p{Limbu}\$", "\u{f3}\u{ab}\u{1950}\u{193c}\u{193a}\u{1f600}\u{3}\u{1944}[\u{1944}\u{1901}\u{e1b5}\u{1930}\u{10ffff}\u{cd37}\u{1945}\u{193f}\u{1901}\u{5828}\u{1931}\u{747d}\u{fd99b}\u{f48e8}\u{192c}", "000010010110100101010000"),
  ("(?i)^\\p{Lo}\$", "\u{f183e}\u{f1}\u{61a1e}\u{9f}\u{a9e6}\u{fb4e8}\u{9e}\u{ce}\u{ffcae}E\u{10ffff}\u{1751}\u{94}\u{10000}\u{b8b}\u{9b6}\u{9af}\u{a61f}\u{f9a9}\u{3b1b8}I\u{1ee53}\u{1f600}\u{b5}", "000000000001010111100000"),
  ("^\\p{Tirh_uta}\$", "\u{114c8}\u{114c7}\u{16ca}\u{bf}\u{114d1}\u{8c}k?\u{1147f}\u{1147f}\u{1f600}\u{114d9}\u{114c8}\u{114c8}\u{114da}r\u{114c7}\u{e672}\u{5117}\u{11480}\u{49bf5}\u{542d}\u{114cf}\u{c532}", "010010000001000010010000"),
  ("^[^\\p{Phoenician}]\$", "\u{10920}\u{d1adf}\u{78a4}\u{1f600}\u{9b}\u{108ff}\u{108ff}\u{a49cb}\u{f247}\u{1}\u{1091a}\u{10ffff}\u{ad1}\u{e0001}\u{611d}\u{1f600}\u{e0}\u{d0a6}\u{ad26}\u{ac7c}\u{1091a}\u{10900}j\u{3000}", "111111111101111111110011"),
