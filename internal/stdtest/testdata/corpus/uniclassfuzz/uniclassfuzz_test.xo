  ("^\\p{Miao}\$", "\u{c886}\u{16eff}\u{16f4a}\u{7d74}X\u{53277}\u{40e8}\u{16f4b}\u{16f4e}\u{c8}<\u{d37ba}\u{16f4a}\u{16f86}\u{16f49}\u{16f4b}\u{16f9e}\u{5b863}\u{a4961}\u{de}\u{16f49}\u{563e8}\u{3ef8}\u{16f90}", "001000000000111010001001"),
  ("^[^\\p{n}]\$", "\u{3000}\u{1bba}P\u{d1}\u{1d7ce}\u{1b}\u{fd74e}\u{b4bf}\u{965}\u{2028}5\u{f6}\u{b070}\u{e0001}\u{1b50}1\u{a1721}\u{bef}\u{e5}x\u{e5}\u{caa81}\u{89}\u{1e71}", "111101111101110010111111"),
  ("^\\p{Modifiersymbol}\$", "\u{3c87e}\u{f2e9c}\u{b8490}V\u{90}\u{192f4}\u{20eb}\u{b3397}\u{a40f}\u{93}\u{10ffff}\u{9f04}\u{8fb61}\u{6947}\u{fbfb9}\u{132ea}\u{1f600}\u{6fd5f}o\u{1f600}\u{e0001}_\u{1036e6}\u{3bd06}", "000000000000000000000000"),
