  ("^[\\p{Duployan}\\p{Greek}]\$", "\u{be}\u{ae}\u{9270}\u{2028}\u{8a39}\u{1bc69}\u{3000}!\u{1bca0}\u{bf}\u{7d76}\u{1108}\u{1bc8f}\u{1bc01}\u{1bc87}\u{1bc89}s\u{1bc8f}\u{1bc9f}\u{444b0}\u{1bc69}\u{1bc9e}\u{1bc6f}\u{e6}", "000001000000011000101100"),
  ("(?i)^\\p{Carian}\$", "\u{9ac}\u{102d0}\u{bc01a}]\u{f}\u{1029f}\u{102cf}\u{17c02}\u{a1ee}\u{1029f}\u{f57e0}\u{4ec51}\u{102a0}O\u{102a0}\u{102a0}\u{49a6f}\u{e2f8}u\u{102a0}\u{102cf}X\u{c3}\u{e592}", "010000100000101100011000"),
  ("^[\\p{r}\\p{Greek}]\$", "\u{1f600}\u{169c}\u{1681}\u{169c}\u{a38f3}\u{1680}\u{1680}\u{169d}\u{169d}\u{be}\u{1681}\u{10ffff}\u{db}\u{7fe08}\u{167f}\u{1681}\u{fffd}F\u{4e7b4}\u{e7}\u{e0001}\u{87ee}\u{1680}\u{96420}", "err"),
  ("(?i)^\\p{Siddham}\$", "\u{4bdf1}\u{11580}\u{f6}\u{1157f}\u{115b4}\u{11580}\u{115b5}\u{11580}\u{11580}\u{e0001}\u{115dc}\u{115b4}\u{a9}\u{7633}\u{4d9b}\u{3000}\u{13}\u{e0001}\u{286af}\u{115b8}\u{29ed}_\u{115b8}\u{11580}", "010011111011000000010011"),
  ("^[^\\p{Balinese}]\$", "\u{97a38}\u{1b01}\u{12}\u{1b7d}\u{fc3f}\u{9e}\u{2028}\u{fd24a}\u{6e093}m\u{1b4f}\u{1b51}\u{1aff}\u{1b01}\u{71532}\u{1b7f}\u{1b00}\u{1b4f}\u{56de}\u{13a69}\u{1b4c}\u{5e22}\u{e0001}\u{10000}", "101011111110101101110111"),
