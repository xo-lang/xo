  ("^\\p{Tagalog}\$", "\u{1701}\u{e1}\u{1f600}\u{bb}\u{102b00}\u{16ff}\u{2713}F\u{2028}\u{171f}\u{50316}\u{171e}\u{1700}\u{1720}9\u{e8}\u{25dc}\u{1716}I\u{2028}\u{88}Y\u{171e}\u{10000}", "100000000100100000000000"),
  ("^\\p{Zl}\$", "\u{2027}\u{b8}\u{f7}\u{2028}\u{f79a0}\u{2029}\u{1cc73}\u{2029}\u{2028}\u{fffd}\u{7e07}\u{d7478}\u{2027}\u{e7}\u{2028}\u{13}\u{2028}8\u{af}\u{2028}\u{2029}\u{2027}\u{186d}\u{2029}", "000100001000001010010000"),
  ("^[^\\p{Ugaritic}]\$", "\u{1039c}\u{3000}\u{b4}\u{1039f}\u{a68ae}\u{103a0}\u{c8}\u{2bff3}\u{e0001}\u{e0001}\u{fffd}\u{c9b1}\u{1f600}\u{1f600}\u{a34a}\u{103a0}\u{d7}\u{103a0}\u{1039f}\u{2028}\u{fb437}\u{6}\u{1039e}\u{1039e}", "011011111111111111011111"),
  ("^\\p{Co}\$", "\u{ffffd}\u{e0}\u{299bc}h\u{10fffe}\u{b}\u{100001}\u{e4ef}\u{f8}\u{e000}\u{2e00}\u{2cf6f}\u{bd25}\u{ffffc}\u{10ffff}\u{95}\u{f0000}\u{86}\u{f1}\u{ac}\u{2028}\u{a5a89}\u{ffffd}\u{10ffff}", "100000110100010010000010"),
