  ("^\\p{Ad-lam}\$", "\u{1e951}\u{ae}\u{1e95d}\u{ff}\u{1e95e}\u{1e950}\u{a1c0f}\u{7dd3e}\u{1e95d}\u{1e95f}\u{1e95e}\u{1e95f}\u{1e8ff}\u{74217}\u{e0001}\u{636f}p\u{1e950}\u{1b0a3}3\u{3719}\u{1e959}\u{88}\u{ae}", "100011000111000001000100"),
  ("^\\P{Oriya}\$", "\u{5c5e}\u{b4c}\u{b58}\u{b03}\u{b4b}\u{b43}f\u{e8}\u{b60}\u{24ec}\u{1c}\u{b33}G\u{b77}\u{b2a}\u{b32}\u{b2f}-\u{af}\u{aafa}\u{e0001}\u{b65}\u{30e3}\u{c638}", "101000110110100001111111"),
  ("^\\p{Finalpunctuation}\$", "\u{c4}\u{ca10e}\u{109ce7}\u{821e3}\u{10ffff}\u{8c673}\u{e0001}\u{1034d0}\u{5c3a7}\u{4344}\u{82}\u{53a77}1\u{aaa42}\u{72f7}\u{236db}\u{e0001}\u{ae}\u{705ed}\u{1e}\u{168b}d\u{27a6}\u{5}", "000000000000000000000000"),
  ("^\\p{Nd}\$", "\u{2504}\u{af8e1}t\u{3000}\u{112f0}\u{82842}2\u{e562}\u{fffd}\u{3000}\u{87}\u{1bb1}%\u{8e}\u{aa50}!\u{c6}\u{f42c6}\u{aee45}\u{8}\u{abef}\u{675d1})\u{8c0a9}", "000010100001001000000000"),
