  ("(?i)^\\p{Bhaiksuki}\$", "\u{11c35}\u{f226a}\u{cd}\u{5}\u{b2f94}\u{e0001}!\u{11c46}\u{c5e3}\u{cc737}\u{a4}\u{11c45}\u{11c01}\u{11c4f}\u{11c35}\u{ec}\u{10000}6>\u{a2680}\u{e0001}\u{11c45}\u{9}\u{11c37}", "100000000001101000000100"),
  ("^[\\p{Lc}\\p{Greek}]\$", "\u{723df}\u{5d6c9}\u{e0001}\u{10ffff}\u{d5}\u{82}\u{e2481}\u{2028}\u{da9ac}\u{e0001}\u{44c8}l\u{101e0e}\u{14871}\u{10f0fa}\u{e50c}\u{1f600}\u{f3d70}\u{f727f}\u{c306}\u{96a3c}\u{6c8b7}\u{99}\u{358d4}", "000010000001000000000000"),
