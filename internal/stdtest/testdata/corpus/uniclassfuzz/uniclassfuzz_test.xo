  ("^\\P{Javanese}\$", "\u{a9cc}\u{c65ef}\u{1b}\u{a0}\u{a9cc}\u{aaf6}\u{a97f}\u{a9d1}\u{eb3e1}\u{3000}\u{e0001}3\u{dcf44}\u{10000}\u{a9df}\u{a9de}\u{df}\u{a9de}\u{fffd}\u{1f600}\u{a9df}\u{a9dd}\u{f3}\u{10f731}", "011101101111110010110111"),
  ("^\\p{Limbu}\$", "\u{e0001}\u{10ffff}9\u{e00a}\u{1931}\u{1945}\u{2028}\u{192c}\u{10000}\u{2ba50}\u{1901}\u{cdaa6}\u{cf}\u{96}\u{193f}\u{191d}\u{192a}\u{aab9}\u{eaf76}\u{bdcbf}\u{193b}\u{bde4}\u{10000}\u{d2}", "000011000010000110001000"),
  ("^[^\\p{BOPOMOFO}]\$", "\u{e0001}\u{fffd}\u{1c79d}\u{10000}\u{6195b}\u{9136}\u{2028}\u{11};\u{31be}\u{31c0}\u{d381}\u{91}\u{3105}\u{319f}\u{319f}\u{3000}FnJ\u{312e}\u{c65d9}\u{32f3}\u{4ae8f}", "111111111011101111110111"),
  ("^\\p{DOGRA}\$", "\u{1f600}\u{11}\u{1183c},\u{117ff}\u{11801}\u{a934b}\u{b8a}\u{11801}\u{e7}\u{10000}\u{bd}\u{1f600}\u{11801}\u{1183a}\u{117ff}\u{11800}\u{75381}{\u{14}\u{19}\u{1f600}\u{1183c}\u{1183b}", "000001001000011010000001"),
