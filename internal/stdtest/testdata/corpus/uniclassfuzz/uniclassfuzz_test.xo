  ("^\\p{HEBREW}\$", "\u{1f600}\u{c4805}\u{16}\u{ad}\u{88f3}\u{ec3c8}k\u{5f3}\u{b574b}b\u{fb42}\u{fb3f}\u{3000}\u{4f8d}\u{381d}%\u{fffd}\u{fb40}\u{8185}\u{fb37}\u{590}\u{87}\u{10fbe3}\u{fb4f}", "000000010000000001000001"),
  ("^\\p{Hanuno}\$", "\u{1734}\u{6d0ce}\u{1721}\u{8}\u{a3}\u{e0001}\u{1720}\u{97}\u{1734}\u{a6}\u{e}\u{171f}\u{7ad36}\u{1720}\u{84}\u{3f083}\u{171f}\u{1721}X5\u{1721}\u{1721}\u{9a}\u{1720}", "err"),
  ("^[\\p{Hanunoo}\\p{Greek}]\$", "4\u{10ffff}\u{1734}\u{3000}\u{1721}e\u{9732a}W\u{aa28}\u{a6}\u{e0001}\u{1f600}\u{1720}\u{1733}\u{1734}\u{e0001}>\u{10000}\u{fffd}\u{1721}\u{aee59}\u{5cb8e}\u{1734}\u{8aad}", "001010000000111000010010"),
  ("^\\P{Z}\$", "\u{167f}\u{e0001}|\u{2028}\u{2fff}\u{3000}\u{3000}\u{b4}\u{362fd}\u{e5}\u{41a80}\u{a3398}\u{2fff}\u{bd}\u{5918}\u{bb}\u{f9}\u{2fff}\u{2009}\u{270e}\u{ab}\u{2001}\u{1680}\u{24}", "111010011111111111011001"),
  ("^\\p{othernumber}\$", "\u{bf}\u{2028}\u{c2}\u{8dd41}\u{f7}\u{98a22}\u{b42e9}\u{99}\u{14d8f}\u{3ac0a}\u{5f13f}\u{d7fca}\u{8d}\u{e9}\u{e799d}=\u{2f15b}\u{49d45}\u{84ad4}\u{34062}\u{10ffff}\u{fffd}\u{7c2b5}\u{c3a25}", "000000000000000000000000"),
  ("^[^\\p{Punct}]\$", "\u{76591}\u{c9}\u{e0001}\u{3000}\u{82b1e}\u{1665}h\u{995ff}\u{10000}\u{5c90a}\u{5af93}\u{1f600}\u{23915}\u{b1}\u{f1}\u{1082e7}\u{2028}\u{22889}\u{2028}\u{8e84f}\u{cbb2f}\u{8c5e7}\u{c9d88}\u{f0a74}", "111111111111111111111111"),
