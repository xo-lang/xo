  ("^[^\\p{L}]\$", "\u{10914}\u{df}\u{938f6}\u{97f}\u{3e49}\u{1ee50}\u{16b63}\u{10ffff}\u{1980}W\u{1f}\u{10b41}\u{e0001}\u{3000}\u{2d7f}\u{1b2fc}\u{a37}\u{9f}\u{1a17} \u{7dd4}\u{f919c}\u{108f3}\u{9f31}", "001001010010111111110110"),
