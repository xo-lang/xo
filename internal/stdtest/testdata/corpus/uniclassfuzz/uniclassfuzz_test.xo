  ("^\\p{Armenian}\$", "\u{759bf}\u{283}\u{d1f82}\u{555}\u{fb18}\u{58d}+\u{fb}\u{590}\u{fb12}\u{532}\u{f5bd1}\u{5fe0}\u{d4}F\u{d5}\u{e0001}\u{559}W\u{1f600}\u{ba}\u{58e}\u{58f}\u{531}", "000101000010000001000111"),
  ("^[\\p{Modifiersymbol}\\p{Greek}]\$", "\u{7096}\u{24}\u{34bca}\u{7fc74}\u{e0001}\u{5534b}\u{28cd}\u{7}\u{239d2}\u{dcf1c}\u{a4}\u{f17f7}\u{b3302}\u{12}\u{ec}\u{49f2}\u{eb89}\u{af}\u{1d}\u{20a6}\u{4333a}\u{80}\u{117d1}\u{f45d0}", "000000000000000001000000"),
