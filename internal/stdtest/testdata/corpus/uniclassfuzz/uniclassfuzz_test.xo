  ("^\\p{Grantha}\$", "\u{c7}O\u{16}\u{11332}\u{fffd}\u{10000}(\u{1b}\u{99}\u{e7}\u{bd469}\u{24da9}L\u{10ffff}\u{1132a}4\u{12}\u{1132a}\u{11327}\u{11330}\u{1136b}\u{11305}\u{77b3}\u{2028}", "000100000000001001111100"),
  ("^[^\\p{Spacingmark}]\$", "\u{b8570}\u{7cb7d}\u{df59f} \u{6b90c}\u{b0}\u{c88c}\u{b2266}\u{b}\u{1f600}\u{88}(\u{2d8d7}+\u{12c71}\u{a9}\u{24}\u{56aa6}\u{44fee}`\u{1a}\u{99eda}\u{19bb}\u{7407e}", "111111111111111111111111"),
  ("(?i)^\\p{lowercaseletter}\$", "\u{a0}\u{3b5a}\u{cc161}\u{77d1b}\u{1fe23}\u{11226}\u{577ff}\u{cdf26}mz\u{2028}\u{8582f}\u{fffd}\u{97971}\u{1c}\u{dbcd0}\u{10000}\u{818c6}\u{b7}\u{effb9}/\u{f502}\u{10000}\u{27c}", "000000001100000000000001"),
  ("^[^\\p{Sm}]\$", "\u{207c}\u{10000}-\u{fffd}\u{1b}\u{5e6b8}\u{e0001}\u{87}\u{1303c}\u{2b2f}\u{29d6}\u{ac}\u{21d1f}\u{2193}\u{fe67}\u{8}\u{2998}s\u{1f600}\u{72257}\u{7}\u{2119}\u{d7}\u{81}", "011111111100101111111101"),
  ("^[\\p{Duployan}\\p{Greek}]\$", "\u{a9ad}\u{2028}\u{1bc91}\u{9c}\u{1bc87}\u{b1}\u{132a}\u{1bc9f}\u{97}\u{ed3ce}\u{a40a}\u{1bc90}\u{be036}\u{1718}\u{af}\u{1bc81}\u{1bc7c}\u{10ffff}\u{1f}\u{1bc87}\u{10000}\u{1bc9e}j\u{4f1f3}", "001010010001000110010100"),
