  ("^[^\\p{Cham}]\$", "\u{10ffff}s\u{1d}\u{a9ff}\u{aa5f}\u{3000}\u{ff84}\u{fffd}\u{a671f}\u{aa4e}\u{aa3f}\u{505b}\u{e5}\u{91}_\u{aa59}\u{3664}\u{10ffff}\u{bf}-\u{86d9}\u{96dc8}\u{aa37}\u{aa37}", "111101111111111011111111"),
  ("^\\P{Thaana}\$", "\u{7b1}\u{780}\u{42c63}\u{fb4e}\u{e}\u{c761f}\u{1c}\u{7b2}\u{10ffff}\u{7b1}\u{62454}\u{780}\u{1f600}\u{7b2}\u{7b1}\u{bb}\u{968f5}\u{15c7b}b\u{88a9}\u{7b0}\u{77f}\u{10ac4f}\u{8f}", "001111111010110111110111"),
  ("^\\p{Lowercaseletter}\$", "\u{db}\u{14}\u{75c09}\u{ea}X\u{84bed}\u{f2}\u{10b2be}\u{e0001}\u{10af1f}\u{42520}\u{e116e}\u{bc}\u{91ac2}\u{9b}\u{d2}\u{25333}\u{af053}\u{774d7}\u{cb}\u{b212e}\u{4}\u{9ebae}\u{104a4e}", "000100100000000000000000"),
  ("^\\P{Lc}\$", "\u{48fb2}\u{fb8b2}\u{f3}Z\u{10bf}\u{f4}`\u{d1}\u{fa}\u{102d7d}\u{fffd}\u{2ecc6}\u{1099d9}\u{a87ee}\u{d7}\u{45b7}\u{698b2}\u{3000}\u{f301e}\u{84485}\u{106986}\u{10e13c}\u{e0001}\u{54de}", "110000100111111111111111"),
  ("(?i)^\\p{Ethiopic}\$", "\u{1f600}\u{7bda}\u{95}\u{33add}\u{1314}\u{1e7ef}\u{2da7}h\u{c2}\u{3000}\u{2af1e}\u{128f}\u{b1}\u{55137}\u{fc0f8}n\u{19}\u{128a}'\u{1f600}\u{2dde}\u{ab0e}\u{e276}\u{2dbe}", "000010000000000001001101"),
  ("^\\p{Lowercaseletter}\$", "\u{10df4f}+;\u{4791c}\u{cc0ca}\u{67141}\u{a0bf6}\u{1f600}\u{e0001}\u{b4aa0}\u{10000};\u{71a9c}\u{cb128}\u{5259a}\u{3000}\u{c8}\u{9e523}\u{dd2f4}\u{7ae9f}\u{3fe85}\u{d25fe}\u{c82c}\u{f3}", "000000000000000000000001"),
  ("^\\p{Carian}\$", "\u{10ffff}\u{10000}\u{11aab}\u{4fc6}\u{102a1}\u{99}\u{102d1}\u{8018}\u{102a1}\u{102cf}\u{3000}\u{ed}\u{e8}\u{102a0}\u{2028}\u{8e18}\u{102d1}\u{1029f}\u{1029f}\u{2028}\u{4b665}\u{102d0}\u{aef}\u{102cf}", "000010001100010000000101"),
