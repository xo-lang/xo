  ("(?i)^\\p{Grantha}\$", "\u{11339}\u{1134f}\u{e2}\u{85}\u{11310}\u{f162}K<\u{11332}\u{e7}\u{11363}\u{1134f}\u{cd84d}\u{5228}\u{9214}b\u{1133a}\u{f340}\u{c832}\u{ad039}\u{f1}\u{1134a}\u{25f6b}\u{10ffff}", "100010001010000000000000"),
  ("^\\P{Thai}\$", "\u{7a2f9}\u{e5a}\u{1c}\u{22}\u{2e162}\u{e02}\u{15}\u{22}\u{1b}\u{6d7b}\u{3000}\u{1f600}\u{e3a}\u{3000}\u{e39}\u{8b}\u{10ffff}\u{e40}\u{e39}\u{7d78}\u{ecf6}\u{e3a}\u{10ffff})", "101110111111010110011011"),
  ("^\\p{cc}\$", "\u{1f600}\u{2028} \u{a26fe}\u{9e}\u{2028}\u{1}\u{c3}l\u{7f}\u{d000}\u{cf}\u{a0}\u{b3}\u{e4da}\u{ef}\u{e5}\u{1b}\u{57321}\u{10000}\u{0}\u{b3}\u{6f8f}\u{9f}", "000010100100000001001001"),
