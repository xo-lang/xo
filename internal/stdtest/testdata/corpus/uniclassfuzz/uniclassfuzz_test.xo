  ("^[\\p{Enclosingmark}\\p{Greek}]\$", "\u{8001b}\u{bcc81}\u{5032f}Y\u{13b8d}\u{41b7c}\u{87a}\u{15}\u{e8}\u{50c8c}\u{3000}\u{6ff27}\u{91}\u{19c4}\u{f1b4}\u{a228c}\u{2028}\u{1f600}\u{a57dc}\u{7a993}\u{b4}\u{f4}\u{db1f1}\u{cfbd4}", "000000000000000000000000"),
  ("(?i)^\\p{Ahom}\$", "\u{11730}\u{1171c}_\u{a2ca}\u{1172c}\u{11700}\u{71d1}\u{e0001}\u{11745}\u{5ea5}\u{fcd0d}\u{1a}\u{f7732}\u{72e6}\u{f4b5}\u{a23b}\u{b7fe}\u{79006}\u{1171a}\u{7fc0e}\u{11730}\u{18df6}\u{1c988}\u{f606}", "100001001000000000101000"),
  ("^[^\\p{Punct}]\$", "\u{20232}\u{798b7}\u{d96e9}\u{a1c}\u{95fd}\u{ab}\u{bcc4a}\u{17ddb}\u{93}\u{9107d}\u{c563}P\u{8f6cd}\u{ad}\u{f4}\u{fffd}\u{b8}\u{cb54}\u{fca4}\u{cc6b}\u{982bd}\u{b8e49}\u{77c14}\u{e0001}", "111110111111111111111111"),
