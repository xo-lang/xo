  ("^\\p{Other}\$", "\u{10000}\u{77c4}\u{fc25e}\u{7b531}\u{f61cf}\u{565d8}\u{7d4f9}\u{a3742}\u{df5bd}\u{7d3f}o\u{5d3e8}\u{c76cf}\u{27acf}\u{a}\u{cf94e}\u{c4}\u{9e297}\u{dc}\u{4be0}\u{f3f88}\u{37e7}\u{8e}\u{a78a}", "001111111001101101001010"),
  ("(?i)^\\p{Buginese}\$", "\u{1a1f}\u{b41d}k\u{1a1d}\u{1a20}\u{f280}\u{58f4a}\u{15be8}\u{1a}\u{10}\u{1f600}\u{f8}_\u{1a01}\u{2b43c}\u{fda6}\u{1a20}\u{321c8}\u{1f600}\u{2028}=\u{e0001}\u{8f}\u{1a1c}", "100000000000010000000000"),
  ("^\\P{Cyrillic}\$", "\u{fe2e}\u{1e031}\u{1d36}\u{fe2e}\u{2ddf}\u{83bd}\u{bf}\u{60233}\u{89}\u{1c88}\u{1c80}\u{a640}\u{a8}\u{1d2c}\u{b3}\u{e65f0}\u{de}\u{1e090}\u{9f}\u{1d2c}\u{caac}\u{2ddf}\u{1d78}\u{2de1}", "001011111000111111111100"),
  ("^\\p{Tagbanwa}\$", "\u{a}R\u{2028}\u{1761}\u{45a1}\u{3000}\u{176f}\u{ae70}\u{176f}\u{176c}\u{4fed}\u{176f}\u{a7}\u{a0}\u{e0001}\u{fe}\u{1771}\u{a0e5}\u{1774}\u{176e}\u{68289}\u{176b}\u{1773}\u{1770}", "000100101101000000010111"),
  ("^\\p{palmyrene}\$", "\u{fd2e}\u{f7}\u{10861}\u{1085f}\u{638b}\u{10880}\u{2f66}\u{b303}\u{59833}\u{514c}\u{15}\u{6bb96}\u{5f7ce}I\u{10860}\u{1f600}\u{10860}\u{1085f}\u{3121}\u{1f600}\u{1085f}\u{10ffff}\u{b5}\u{10860}", "001000000000001010000001"),
  ("(?i)^\\p{Number}\$", "\u{1016fc}\u{f09c4};\u{57e94}\u{ec50}\u{94a00}\u{10c5d}\u{d2ded}\u{de8a6}\u{286fc}\u{57f73}\u{ce49b}\u{d0526}3\u{9c}\u{5db4}\u{2ccef}\u{83}\u{ea}\u{2fae0}\u{91}\u{df}\u{c7745}\u{a9fa}", "000000000000010000000000"),
  ("^\\p{Tangut}\$", "v\u{96}\u{18afe}\u{18afe}\u{54339}\u{18800}\u{fc2a}\u{18d00}\u{187f6}\u{fc}\u{187f7}\u{951d4}\u{16}\u{10ffff}\u{17000}\u{e0001}\u{1567f}\u{e924}[\u{18801}%\u{2ac83}\u{18d09}\u{fffd}", "001101011010001000010000"),
  ("^[^\\p{Pia}]\$", "\u{d466}\u{2e08}\u{6126}\u{2e1d}\u{5}\u{2e03}\u{2e05}\u{2e09}\u{8a9f}\u{3ed3}\u{9087c}\u{94}\u{48185}\u{10ffff}I\u{201a}\u{5eb64}\u{80}\u{e4aae}gY\u{24}\u{be8f8}\u{fffd}", "err"),
