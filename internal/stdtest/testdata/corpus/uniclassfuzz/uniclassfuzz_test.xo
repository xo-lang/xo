  ("^[\\p{Thai}\\p{Greek}]\$", "0\u{c9}\u{e02}\u{49ff}\u{e7}\u{4ab9}\u{e41}4\u{e3f}\u{d8}\u{e5a}\u{1f600}\u{e40}\u{66c9a}\u{3cfb2}\u{e02}f\u{c1}ph\u{cc9e}\u{e5a}\u{e41}\u{e3b}", "001000100010100100000110"),
  ("^[\\p{Vithkuqi}\\p{Greek}]\$", "\u{eb}\u{10594}\u{7f79}\u{db}\u{10ffff}\u{18}\u{105a3}\u{10000}\u{a3}\u{10595}\u{ed}\u{1057c}\u{e0001}\u{20578}\u{d499b}\u{e5}\u{105b9}\u{1058a}\u{105b0}\u{10593}\u{1058b}\u{10598}\u{7b744}\u{1058b}", "010000100101000011100100"),
  ("^\\p{Cn}\$", "\u{da}\u{10ffff}\u{3000}\u{68179}\u{b48}\u{10}\u{cd6f}\u{11366}\u{dbabb}\u{6e921}\u{88}\u{a8}\u{11ff1}\u{16f8d}\u{b34}\u{cf}\u{1de8}\u{1000b}\u{10000}\u{d77d1}\u{c4}\u{3000}\u{9fad6}Z", "010100001100011000010010"),
  ("^\\P{Latin}\$", "\u{2189}\u{1d26}\u{a7da}\u{e6244}\u{4b691}\u{d93f2}\u{ff22}\u{35f09}\u{c2450}\u{1f600}\u{1b}\u{2028}\u{3000}\u{2e1}\u{a7d5}\u{ba}\u{200d}a\u{cc}\u{2e1}\u{1dbe}\u{2080}\u{2779}\u{ab68}", "111111011111100010000110"),
  ("^\\P{Modi}\$", "\u{1f600}\u{11659}\u{13e7}\u{2313}\u{11601}\u{66de}\u{c6}\u{8e}\u{3000}\u{11644}\u{5f14d}\u{6e93}\u{11644}V\u{11643}\u{11645}\u{15}\u{1f600}\u{115ff}\u{11658}\u{b8c8}\u{11658}\u{95}\u{e6}", "101101111011010111101011"),
  ("^\\p{Co}\$", "\u{f0001}\u{11a66}\u{10fffe}Z\u{caf4b}\u{a9}\u{e0001}\u{18}\u{c749}\u{25131}\u{a6}\u{e000}\u{75a0}\u{804b}\u{f8fe}\u{568d}\u{5adb}\u{fffff}\u{bb}\u{10fffc}\u{23a3}\u{e000}\u{ffffe}\u{fffff}", "100000000001001000010100"),
  ("^[^\\p{GOTHIC}]\$", "\u{51c24}\u{3a6}\u{6aca}\u{10349}\u{10349}OQ\u{c390}\u{10331}\u{fffd}\u{1032f}\u{10330}\u{1032f}\u{2028}\u{d4}\u{b2}\u{cd}\u{1032f}\u{10349}\u{1c5e1}\u{5ba7}\u{10f566}\u{3000}\u{9d8e}", "111001110110111111011111"),
  ("^\\p{mongolian}\$", "\u{1879}\u{9d}\u{1819}\u{fffd}\u{f}\u{1821}\u{fffd}\u{1878}?\u{1166b}\u{3000}\u{d7}\u{1881}\u{187f}\u{1166b}\u{2028}\u{ad}\u{a4}\u{10000}\u{1821}\u{1819}\u{1821}\u{591a}\u{2bd5}", "001001010100101000011100"),
  ("^[^\\p{Myanmar}]\$", "\u{f39df}\u{8ab8d}\u{b6}\u{aa80}\u{4e596}\u{b}\u{10ffff}\u{fff}\u{109e}\u{a806f}%\u{fffd}\u{959bf}W\u{3000}\u{aa61}\u{2028}\u{ac}\u{aa7e}\u{e43db}\u{10a0}\u{a9ff})\u{109e}", "111111110111111011011110"),
  ("^\\p{Pi}\$", "\u{2e05}\u{2e0a}\u{b7}\u{201b}\u{fe}P\u{3000}\u{2017}\u{201b}\u{2e03}\u{10ffff}\u{d8263}\u{201d}\u{aa}\u{2e1c}\u{b7}\u{ab}\u{14}\u{f}\u{10000}\u{3ba9c}\u{fe}\u{c3}\u{296a}", "000100001000001010000000"),
  ("^\\P{Samaritan}\$", "\u{82f}\u{d3d6}\u{aa}\u{a3103}\u{f33bf}\u{7ff}\u{1a}\u{3000}\u{2d1d}\u{801}\u{7ff}*\u{ca}4\u{7f}\u{92}\u{fffd}\u{801}\u{1f600}\u{76a2}\u{1c}\u{76b00}\u{830}\u{83e}", "111111111011111110111100"),
  ("^[^\\p{Sharada}]\$", "\u{111df}r\u{fffd}x\u{8e}\u{fe6e}\u{ad}\u{bc}\u{1d}\u{8d84}\u{e0001}\u{111e0}\u{da}\u{989d}\u{707a}=\u{1f600}\u{bcfd6}\u{4974}\u{11180}\u{ef7db}\u{df}\u{111de}:", "011111111111111111101101"),
  ("^[\\p{Connectorpunctuation}\\p{Greek}]\$", "\u{af5db}\u{19}\u{6ea8}\u{a5632}\u{107bdd}\u{fffd}\u{feee4}\u{9c}\u{b87ca}\u{7c311}\u{fe}\u{4ddce}\u{49efb}\u{66c01}\u{f597d}\u{101d69}\u{ab4b3}\u{24}\u{a4}\u{fb}\u{aa843}\u{19b24}\u{1f600}t", "000000000000000000000000"),
  ("^\\p{Sc}\$", "\u{af0}\u{bbda}\u{1e2ff}U'\u{abb3f}\u{10000}E\u{26f83}\u{f9cd5}%\u{10ffff}\u{17dc}\u{ffe5}\u{ffe5}\u{2028}\u{17}\u{ffe0}\u{9fa}\u{7f}\u{d7}\u{1754}\u{17da}\u{3000}", "001000000000011001000000"),
  ("(?i)^\\p{Manichaean}\$", "\u{10aeb}\u{a469}\u{e132f}\u{b8}\u{e7}\u{10aec}\u{10ae6}\u{e0001}\u{10ae7}\u{9f9d}\u{10af5}\u{10aea}\u{10aeb}h\u{fffd}\u{10aeb}\u{988d4}\u{10aec}\u{10ac1}T\u{1f600}\u{86c4}\u{e0001}\u{fe57}", "100001100010100101100000"),
