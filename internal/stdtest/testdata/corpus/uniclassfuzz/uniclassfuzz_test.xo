  ("^[^\\p{Finalpunctuationa}]\$", "\u{a21e}\u{f8}\u{48409}\u{c5830}\u{44851}\u{fffd}\u{5}\u{ecea3}=\u{326f9}\u{5c6fd}\u{a01fc}\u{10000}\u{2e76}\u{ff085}\u{bb}\u{cfb14}\u{bb}\u{798ab}\u{c5e1e}\u{3000}\u{dd96b}\u{14c06}\u{16}", "err"),
