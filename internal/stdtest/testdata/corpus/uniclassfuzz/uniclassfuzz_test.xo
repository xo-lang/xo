  ("^\\p{Sharada}\$", "\u{11180}\u{1f600}\u{10}\u{eb}\u{1117f}\u{cc}\u{1117f}\u{cba5}\u{10000}\u{b4}u\u{111de}\u{2ca26}\u{459e}\u{1117f}\u{1117f}\u{111df}\u{c58}\u{1c}\u{111df}\u{6f1e}\u{82dbd}\u{caa0}\u{1f600}", "100000000001000010010000"),
  ("^[^\\p{Currencysymbol}]\$", "\u{10000}\u{9c}\u{f4}\u{c2aa}\u{8715}\u{fffd}\u{5c63c}\u{3000}\u{de}\u{fb00}\u{eabf2}\u{f9}\u{f4585}\u{e5fd2}\u{4a3d}\u{c08cb}\u{aa57f}\u{f059}x\u{84ac9}\u{d19aa}\u{b1921}\u{ee}\u{62f2}", "111111111111111111111111"),
  ("^[\\p{Pd}\\p{Greek}]\$", "\u{3030}\u{9c}\u{e8}\u{fe57}\u{88}\u{eb}m\u{2e3c}\u{2e5d}\u{10000}\u{b9d08}\u{1f600}\u{22}\u{10000}\u{58a}\u{9}\u{2e40}s\u{3000}\u{c3114}\u{58b}\u{bc89}\u{301d};", "100000001000001010000000"),
