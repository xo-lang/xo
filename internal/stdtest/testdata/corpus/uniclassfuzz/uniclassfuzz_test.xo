  ("^[^\\p{Grantha}]\$", "\u{8a}\u{10ffff}\u{1133c}\u{1136b}\u{11312}\u{dd2}\u{cdb1c}\u{b9}\u{11375}\u{81a5}\u{1134a}\u{11306}\u{11334}\u{78b6a}\u{1134b}\u{7aa34}\u{fd}\u{5d61}\u{2028}\u{8d75}\u{dd}\u{1136f}\u{2028}\u{aa1b}", "110011111110110111111111"),
  ("^\\p{Mongolian}\$", "\u{10ffff}\u{1877}\u{b7}\u{1801}\u{e0}\u{b79e6}\u{10ffff}\u{1166b}T(\u{480e5}\u{1805}\u{1}\u{a2}\u{2ed4}\u{1806}\u{ad}\u{1f600}\u{a7dae}\u{1800}\u{1806}\u{c1dfe}\u{10c7e2}\u{b6e0b}", "010100010000000100011000"),
  ("^\\p{Lineseparator}\$", "\u{9f915}\u{c9489}\u{1ef2b}\u{596a2}\u{c3ba}\u{1008a0}\u{876ef}\u{3000}\u{6457f}\u{2028}\u{a17e}\u{3a0b}\u{1f600}\u{4fa2}\u{eb}\u{5f9b5}\u{30891}\u{d176c}\u{c7}\u{9737a}\u{10000}\u{72cb1}\u{420f9}\u{10452e}", "000000000100000000000000"),
  ("^\\p{Or}\$", "\u{b56}\u{91091}\u{ce}\u{d3}\u{b39}\u{b3a}O\u{b11}\u{10000}\u{10ffff}\u{b5f}\u{1cff}\u{2f928}jl\u{b78}\u{6573}\u{29c7}\u{b9}\u{335fd}\u{ca}\u{10db4e}\u{b12}\u{22f1}", "err"),
  ("^[\\p{Nandinagari}\\p{Greek}]\$", "\u{119e4}\u{119a7}*\u{c4}\u{cb}\u{119aa}\u{119a1}m\u{1c6fc}\u{119d6}\u{10000}\u{119e4}?\u{10bc98}\u{119aa}\u{88}\u{ea54}\u{119a6}\u{119d7}\u{ac674}\u{e0001}\u{9d}\u{119aa}\u{119e3}", "110001100101001001100011"),
