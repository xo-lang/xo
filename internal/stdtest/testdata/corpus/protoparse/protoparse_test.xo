  optional float opt_float = 20;\n  optional double opt_double = 21;\n\n  optional bytes opt_bytes = 8;\n  optional string opt_string = 9;\n  optional Enum opt_enum = 10;\n  optional Nested opt_message = 11;\n}\n\nmessage OptionalEnums {\n  optional Enum opt_enum = 1;\n\n  enum NestedEnum {\n    CERO = 0;\n    UNO = 1;\n    DOS = 2;\n    DIEZ = 10;\n  }\n  NestedEnum opt_nested_enum = 3;\n}\n\nenum Enum {\n  ZERO = 0;\n  ONE = 1;\n  TWO = 2;\n  TEN = 10;\n}\n\n// Message contains enum fields.\nmessage Enums {\n  Enum s_enum = 1;\n\n  enum NestedEnum {\n    CERO = 0;\n    UNO = 1;\n    DOS = 2;\n    DIEZ = 10;\n  }\n  NestedEnum s_nested_enum = 3;\n}\n\n// Message contains nested message field.\nmessage Nests {\n  Nested s_nested = 2;\n}\n\n// Message type used as submessage.\nmessage Nested {\n  string s_string = 1;\n  Nested s_nested = 2;\n}\n\n// Message contains oneof field.\nmessage Oneofs {\n  oneof union {\n    Enum oneof_enum = 1;\n    string oneof_string = 2;\n    Nested oneof_nested = 3;\n  }\n}\n\n// Message contains map fields.\nmessage Maps {\n  map<int32, string> int32_to_str = 1;\n  map<bool, uint32> bool_to_uint32 = 2;\n  map<uint64, Enum> uint64_to_enum = 3;\n  map<string, Nested> str_to_nested = 4;\n  map<string, Oneofs> str_to_oneofs = 5;\n}\n\n// Message for testing json_name option.\nmessage JSONNames {\n  string s_string = 1 [json_name = \"foo_bar\"];\n}\n\n// Message contains reserved field name.\nmessage ReservedFieldNames {\n  reserved \"reserved_field\";\n  int32 opt_int32 = 1;\n}\n", 11, 1, 0),
]

test "std/protoparse reads the proto3 files of real projects" {
  var bad: List[Str] = []
  for (name, text, msgs, enums, rpcs) in FILES {
    match protoparse.parse(text) {
      Ok(f) => {
        var r = 0
        for s in f.services {
          r += s.rpcs.len()
        }
        if f.messages.len() != msgs || f.enums.len() != enums || r != rpcs {
          bad.push("${name}: got ${f.messages.len()} messages ${f.enums.len()} enums ${r} rpcs, want ${msgs} ${enums} ${rpcs}")
        }
        match protoparse.gen(f) {
          Ok(a) => {
            let b = protoparse.gen(f).or_fault("gen again")
            if a != b {
              bad.push("${name}: gen is not deterministic")
            }
          }
          // a type from an imported file is not known to one file's gen
          Err(e) => if !text.contains("\nimport ") { bad.push("${name}: gen: ${e}") }
        }
      }
      Err(e) => bad.push("${name}: ${e}")
    }
  }
  if !bad.is_empty() {
    fault("${bad.len()} of ${FILES.len()} files differ, first: ${bad[0]}")
  }
}
