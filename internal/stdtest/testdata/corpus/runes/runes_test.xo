  "plane 8: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 9: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 10: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 11: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 12: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 13: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 14: letters=0 digits=0 spaces=0 prints=240 upper=0 lower=0 title=0 punct=0 control=0 graphic=240 mark=240 symbol=0 number=0 len=262144 case=0",
