test "Rune.quote is Go's QuoteRune" {
  expect(QUOTES.len() >= 430)
  var bad: List[Str] = []
  for (v, want) in QUOTES {
    let got = Rune(v).quote()
    if got != want {
      bad.push("u+${v}: ${got} want ${want}")
    }
  }
  expect(show(bad)) == []
}
