// Generated by scripts/stdcorpus from Go's unicode package and strconv.IsPrint, on every Unicode scalar value: the counts of each Rune class per plane of 0x10000 code points, the sum of the UTF-8 lengths, and a hash of Go's ToLower, ToUpper and ToTitle; against Rune.is_letter, is_digit, is_space, is_print, is_upper, is_lower, is_title, is_punct, is_control, is_graphic, is_mark, is_symbol, is_number, utf8_len, to_lower, to_upper and to_title, plus the boundaries and the values Rune.try rejects (Go's unicode is Copyright 2009 The Go Authors, BSD-style license) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.

/// One line per plane of 0x10000 code points, plane 0 first, as the test
/// below builds them: every class count, the UTF-8 lengths summed, and
/// the case hash.
const PLANES: List[Str] = [
  "plane 0: letters=48965 digits=370 spaces=25 prints=55508 upper=1127 lower=1445 title=31 punct=625 control=65 graphic=55524 mark=1338 symbol=3844 number=735 len=188288 case=886293283",
  "plane 1: letters=17135 digits=310 spaces=0 prints=23246 upper=704 lower=788 title=0 punct=217 control=0 graphic=23246 mark=872 symbol=3926 number=1096 len=262144 case=299908581",
  "plane 2: letters=60873 digits=0 spaces=0 prints=60873 upper=0 lower=0 title=0 punct=0 control=0 graphic=60873 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 3: letters=9131 digits=0 spaces=0 prints=9131 upper=0 lower=0 title=0 punct=0 control=0 graphic=9131 mark=0 symbol=0 number=0 len=262144 case=0",
  "plane 4: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
