  "plane 16: letters=0 digits=0 spaces=0 prints=0 upper=0 lower=0 title=0 punct=0 control=0 graphic=0 mark=0 symbol=0 number=0 len=262144 case=0",
]

/// The bounds of the tables, each in full: (code point, the line).
const BOUNDS: List[(Int, Str)] = [
  (0, "u+0: upper=false lower=false title=false punct=false control=true graphic=false mark=false symbol=false number=false len=1 up=0 lo=0 ti=0"),
  (31, "u+31: upper=false lower=false title=false punct=false control=true graphic=false mark=false symbol=false number=false len=1 up=31 lo=31 ti=31"),
  (32, "u+32: upper=false lower=false title=false punct=false control=false graphic=true mark=false symbol=false number=false len=1 up=32 lo=32 ti=32"),
  (65, "u+65: upper=true lower=false title=false punct=false control=false graphic=true mark=false symbol=false number=false len=1 up=65 lo=97 ti=65"),
  (97, "u+97: upper=false lower=true title=false punct=false control=false graphic=true mark=false symbol=false number=false len=1 up=65 lo=97 ti=65"),
  (126, "u+126: upper=false lower=false title=false punct=false control=false graphic=true mark=false symbol=true number=false len=1 up=126 lo=126 ti=126"),
  (127, "u+127: upper=false lower=false title=false punct=false control=true graphic=false mark=false symbol=false number=false len=1 up=127 lo=127 ti=127"),
  (128, "u+128: upper=false lower=false title=false punct=false control=true graphic=false mark=false symbol=false number=false len=2 up=128 lo=128 ti=128"),
  (160, "u+160: upper=false lower=false title=false punct=false control=false graphic=true mark=false symbol=false number=false len=2 up=160 lo=160 ti=160"),
  (255, "u+255: upper=false lower=true title=false punct=false control=false graphic=true mark=false symbol=false number=false len=2 up=376 lo=255 ti=376"),
  (256, "u+256: upper=true lower=false title=false punct=false control=false graphic=true mark=false symbol=false number=false len=2 up=256 lo=257 ti=256"),
  (2047, "u+2047: upper=false lower=false title=false punct=false control=false graphic=true mark=false symbol=true number=false len=2 up=2047 lo=2047 ti=2047"),
  (2048, "u+2048: upper=false lower=false title=false punct=false control=false graphic=true mark=false symbol=false number=false len=3 up=2048 lo=2048 ti=2048"),
  (55295, "u+55295: upper=false lower=false title=false punct=false control=false graphic=false mark=false symbol=false number=false len=3 up=55295 lo=55295 ti=55295"),
  (57344, "u+57344: upper=false lower=false title=false punct=false control=false graphic=false mark=false symbol=false number=false len=3 up=57344 lo=57344 ti=57344"),
  (65535, "u+65535: upper=false lower=false title=false punct=false control=false graphic=false mark=false symbol=false number=false len=3 up=65535 lo=65535 ti=65535"),
  (65536, "u+65536: upper=false lower=false title=false punct=false control=false graphic=true mark=false symbol=false number=false len=4 up=65536 lo=65536 ti=65536"),
  (1114111, "u+1114111: upper=false lower=false title=false punct=false control=false graphic=false mark=false symbol=false number=false len=4 up=1114111 lo=1114111 ti=1114111"),
]

/// The values Rune.try must reject: negative, the surrogate range, above
/// the last code point.
const NOT_RUNES: List[Int] = [-1, 55296, 57343, 1114112]

fn bit(b: Bool, v: Int) -> Int {
  if b {
    return v
  }
  0
}

fn show(bad: List[Str]) -> List[Str] {
  bad[0..(if bad.len() < 5 { bad.len() } else { 5 })]
}

fn line_of(i: Int) -> Str {
  let r = Rune(i)
  "u+${i}: upper=${r.is_upper()} lower=${r.is_lower()} title=${r.is_title()} punct=${r.is_punct()} control=${r.is_control()} graphic=${r.is_graphic()} mark=${r.is_mark()} symbol=${r.is_symbol()} number=${r.is_number()} len=${r.utf8_len()} up=${Int(r.to_upper())} lo=${Int(r.to_lower())} ti=${Int(r.to_title())}"
}

test "every scalar value is Go's, per plane" {
  var bad: List[Str] = []
  var plane = 0
  while plane <= 16 {
    var letters = 0
    var digits = 0
    var spaces = 0
    var prints = 0
    var uppers = 0
    var lowers = 0
    var titles = 0
    var puncts = 0
    var controls = 0
    var graphics = 0
    var marks = 0
    var symbols = 0
    var numbers = 0
    var lens = 0
    var h = 0
    var i = plane * 0x10000
    while i < (plane + 1) * 0x10000 {
      if let Some(r) = Rune.try(i) {
        letters += bit(r.is_letter(), 1)
        digits += bit(r.is_digit(), 1)
        spaces += bit(r.is_space(), 1)
        prints += bit(r.is_print(), 1)
        uppers += bit(r.is_upper(), 1)
        lowers += bit(r.is_lower(), 1)
        titles += bit(r.is_title(), 1)
        puncts += bit(r.is_punct(), 1)
        controls += bit(r.is_control(), 1)
        graphics += bit(r.is_graphic(), 1)
        marks += bit(r.is_mark(), 1)
        symbols += bit(r.is_symbol(), 1)
        numbers += bit(r.is_number(), 1)
        lens += r.utf8_len()
        let lo = Int(r.to_lower())
        let up = Int(r.to_upper())
        let ti = Int(r.to_title())
        if lo != i || up != i || ti != i {
          h = (h * 31 + i * 7 + lo * 3 + up * 5 + ti * 11) % 1000000007
        }
      }
      i += 1
    }
    let got = "plane ${plane}: letters=${letters} digits=${digits} spaces=${spaces} prints=${prints} upper=${uppers} lower=${lowers} title=${titles} punct=${puncts} control=${controls} graphic=${graphics} mark=${marks} symbol=${symbols} number=${numbers} len=${lens} case=${h}"
    if got != PLANES[plane] {
      bad.push("${got}\n want ${PLANES[plane]}")
    }
    plane += 1
  }
  expect(show(bad)) == []
}

test "the boundaries of the tables" {
  var bad: List[Str] = []
  for (i, want) in BOUNDS {
    let got = line_of(i)
    if got != want {
      bad.push("${got}\n want ${want}")
    }
  }
  expect(show(bad)) == []
}

test "Rune.try rejects what is not a scalar value" {
  var bad: List[Str] = []
  for i in NOT_RUNES {
    match Rune.try(i) {
      Some(r) => bad.push("u+${i} is a rune: ${Int(r)}")
      None => {}
    }
  }
  expect(show(bad)) == []
}
