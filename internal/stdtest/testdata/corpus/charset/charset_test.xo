fn bytes_of_hex(h: Str) -> Bytes {
  Bytes.from_hex(h) ?? b""
}

fn hex_of(b: Bytes) -> Str {
  var s = ""
  let digits = "0123456789abcdef"
  for c in b {
    let v = Int(c)
    s = s + digits[v >> 4..(v >> 4) + 1] + digits[v & 15..(v & 15) + 1]
  }
  s
}

fn units_text(u: List[Int]) -> Str {
  var parts: List[Str] = []
  for v in u {
    parts.push("${v}")
  }
  parts.join(" ")
}

fn units_of(s: Str) -> List[Int] {
  var out: List[Int] = []
  if s == "" {
    return out
  }
  for p in s.split(" ") {
    out.push(Int.parse(p) ?? -1)
  }
  out
}

fn first12(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 12 { bad.len() } else { 12 })]
}

test "decode with lossy is x/text's decoder (and Go's range over a string for UTF-8)" {
  var bad: List[(Str, Str, Str)] = []
  for (cs, h, want) in DECODE {
    let got = charset.decode(bytes_of_hex(h), cs, lossy: true).ok() ?? "<err>"
    if got != want {
      bad.push(("${cs} ${h}", got, want))
    }
  }
  expect(first12(bad)) == []
}

test "decode without lossy fails exactly when lossy replaced something invalid" {
  for (cs, h, _want) in DECODE {
    let b = bytes_of_hex(h)
    let strict = charset.decode(b, cs)
    let lossy = charset.decode(b, cs, lossy: true).ok() ?? "<err>"
    match strict {
      Ok(s) => {
        expect(s) == lossy
      }
      Err(e) => {
        // the error is at an offset inside the input, and the lossy text has a U+FFFD
        expect(e.offset >= 0 && e.offset < b.len()) == true
        expect(lossy.contains("\u{fffd}")) == true
      }
    }
  }
}

test "decode errors name the first bad byte" {
  expect(charset.decode(b"ab\xc3", charset.Charset.Utf8).err().map(fn(e) { e.display() })) == Some("charset: invalid UTF-8 at byte 2")
  expect(charset.decode(b"A\x00B", charset.Charset.Utf16Le).err().map(fn(e) { e.display() })) == Some("charset: odd number of UTF-16 bytes at byte 2")
  expect(charset.decode(b"A\x00\x3d\xd8B\x00", charset.Charset.Utf16Le).err().map(fn(e) { e.display() })) == Some("charset: unpaired UTF-16 surrogate at byte 2")
  expect(charset.decode(b"\xde\x00", charset.Charset.Utf16Be).err().map(fn(e) { e.display() })) == Some("charset: unpaired UTF-16 surrogate at byte 0")
  expect(charset.decode(b"\xff\xfeA\x00", charset.Charset.Utf16Bom).ok()) == Some("A")
  expect(charset.decode(b"\xfe\xff\x00A", charset.Charset.Utf16Bom).ok()) == Some("A")
  expect(charset.decode(b"A\x00", charset.Charset.Utf16Bom).ok()) == Some("A")
  expect(charset.decode(b"\xff\xfeA\x00", charset.Charset.Utf16Le).ok()) == Some("\u{feff}A")
}

test "encode is x/text's encoder, an error where it has one" {
  var bad: List[(Str, Str, Str)] = []
  for (cs, t, want) in ENCODE {
    var got = "err"
    match charset.encode(t, cs) {
      Ok(b) => got = hex_of(b)
      Err(_) => {}
    }
    if got != want {
      bad.push(("${cs} ${t}", got, want))
    }
  }
  expect(first12(bad)) == []
}

test "encode errors name the character and its byte offset" {
  expect(charset.encode("a€", charset.Charset.Latin1).err().map(fn(e) { e.display() })) == Some("charset: character U+20AC is not in latin1 at byte 1")
  expect(charset.encode("x😀", charset.Charset.Windows1252).err().map(fn(e) { e.display() })) == Some("charset: character U+1F600 is not in windows-1252 at byte 1")
  expect(charset.encode("€", charset.Charset.Windows1252).ok().map(hex_of)) == Some("80")
}

test "decode then encode is the identity for every byte of the single byte charsets" {
  var all = BytesBuilder.new()
  for i in 0..256 {
    all.write_byte(UInt8(i))
  }
  let b = all.freeze()
  for cs in [charset.Charset.Latin1, charset.Charset.Windows1252] {
    let text = charset.decode(b, cs).ok() ?? ""
    expect(charset.encode(text, cs).ok()) == Some(b)
  }
}

test "utf16_units is Go's utf16.Encode" {
  var bad: List[(Str, Str, Str)] = []
  for (t, want) in UNITS {
    let got = units_text(charset.utf16_units(t))
    if got != want {
      bad.push((t, got, want))
    }
  }
  expect(first12(bad)) == []
}

test "from_utf16_units is Go's utf16.Decode, and a value outside 0 to 65535 is U+FFFD" {
  var bad: List[(Str, Str, Str)] = []
  for (u, want) in FROM_UNITS {
    let got = charset.from_utf16_units(units_of(u))
    if got != want {
      bad.push((u, got, want))
    }
  }
  expect(first12(bad)) == []
  expect(charset.from_utf16_units([65, 70000, -1, 66])) == "A\u{fffd}\u{fffd}B"
}

test "lookup is the Encoding Standard's labels for the supported charsets" {
  for (label, want) in LABELS {
    let got = charset.lookup(label)
    match want {
      "utf-8" => expect(got) == Some(charset.Charset.Utf8)
      "utf-16le" => expect(got) == Some(charset.Charset.Utf16Le)
      "utf-16be" => expect(got) == Some(charset.Charset.Utf16Be)
      "windows-1252" => expect(got) == Some(charset.Charset.Windows1252)
      _ => expect(got) == None
    }
  }
  expect(charset.lookup("utf-16")) == Some(charset.Charset.Utf16Bom)
  expect(charset.lookup(" UTF-16 ")) == Some(charset.Charset.Utf16Bom)
}
