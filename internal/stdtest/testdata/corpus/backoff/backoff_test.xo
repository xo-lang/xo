// Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/backoff

/// A Rand whose float() answers rs in turn (then 0.5).
struct Seq {
  rs: List[Float]
  at: Mutex[Int]
}

fn seq(rs: List[Float]) -> Seq { Seq{rs: rs, at: Mutex[Int].new(0)} }

fn (s: Seq) float() -> Float uses rand {
  let i = s.at.with(fn(var n: Int) { n += 1; n - 1 })
  s.rs.get(i) ?? 0.5
}
fn (s: Seq) int(lo: Int, hi: Int) -> Int uses rand { lo }
fn (s: Seq) bool() -> Bool uses rand { false }
fn (s: Seq) bytes(n: Int) -> Bytes uses rand { Bytes.zeroed(n) }
fn (s: Seq) shuffle[T](xs: List[T]) -> List[T] uses rand { xs }

fn ns(n: Int) -> Duration { Duration.from_nanos(n) }

test "a delay is drawn from [d - r d, d + r d] as Go's getRandomValueFromInterval (TestGetRandomizedInterval)" {
  let b = backoff.Backoff{initial: ns(2), randomization: 0.5}
  expect(b.delay(0, seq([0.0]))) == ns(1)
  expect(b.delay(0, seq([0.33]))) == ns(1)
  expect(b.delay(0, seq([0.34]))) == ns(2)
  expect(b.delay(0, seq([0.66]))) == ns(2)
  expect(b.delay(0, seq([0.67]))) == ns(3)
  expect(b.delay(0, seq([0.99]))) == ns(3)
}

test "the delays grow by the multiplier up to max_interval (TestBackOff)" {
  let b = backoff.Backoff{initial: 500ms, randomization: 0.1, multiplier: 2.0, max_interval: 5s}
  expect(b.delay(0, seq([0.0]))) == ns(450000000)
  expect(b.delay(1, seq([0.25]))) == ns(950000000)
  expect(b.delay(2, seq([0.5]))) == ns(2000000000)
  expect(b.delay(3, seq([0.75]))) == ns(4200000000)
  expect(b.delay(4, seq([0.999]))) == ns(5499000000)
  expect(b.delay(5, seq([0.1]))) == ns(4600000000)
  expect(b.delay(6, seq([0.9]))) == ns(5400000000)
  expect(b.delay(7, seq([0.3]))) == ns(4800000000)
  expect(b.delay(8, seq([0.6]))) == ns(5100000000)
  expect(b.delay(9, seq([0.999999999]))) == ns(5500000000)
}

test "the defaults are cenkalti's: 500ms times 1.5 up to 60s" {
  let b = backoff.Backoff{randomization: 0.0}
  var got: List[Duration] = []
  for i in 0..12 {
    got.push(b.delay(i, seq([])))
  }
  expect(got) == [ns(500000000), ns(750000000), ns(1125000000), ns(1687500000), ns(2531250000), ns(3796875000), ns(5695312500), ns(8542968750), ns(12814453125), ns(19221679687), ns(28832519530), ns(43248779295)]
  expect(backoff.Backoff{}.max_elapsed) == 15m
}

test "a huge multiplier stops at max_interval (TestBackOffOverflow)" {
  let b = backoff.Backoff{initial: ns(4611686018427387903), multiplier: 2.1, max_interval: ns(4611686018427387904), randomization: 0.0}
  expect(b.delay(1, seq([]))) == ns(4611686018427387904)
  expect(b.delay(5, seq([]))) == ns(4611686018427387904)
}

enum Fail {
  Again
  Fatal
}

test "retry calls op until it succeeds and sleeps the delays between (TestRetry)" {
  let calls = Mutex[Int].new(0)
  let r = backoff.retry(backoff.Backoff{randomization: 0.0}, os.clock, seq([]), fn() -> Int ! Fail {
    let n = calls.with(fn(var c: Int) { c += 1; c })
    if n < 3 { Err(Fail.Again) } else { Ok(n) }
  }, backoff.always())
  expect(r) == Ok(3)
  expect(os.clock.sleeps()) == [500ms, 750ms]
}

test "a permanent error stops retry at once (TestRetryPermanent)" {
  let calls = Mutex[Int].new(0)
  let r = backoff.retry(backoff.Backoff{}, os.clock, seq([]), fn() -> Int ! Fail {
    calls.with(fn(var c: Int) { c += 1 })
    Err(Fail.Fatal)
  }, fn(e: Fail) { e == Fail.Again })
  expect(r) == Err(Fail.Fatal)
  expect(calls.with_read(fn(c: Int) { c })) == 1
  expect(os.clock.sleeps()) == []
}

test "max_tries counts the calls of op" {
  let calls = Mutex[Int].new(0)
  let r = backoff.retry(backoff.Backoff{max_tries: 4, randomization: 0.0, initial: 1s, multiplier: 2.0}, os.clock, seq([]), fn() -> Int ! Fail {
    calls.with(fn(var c: Int) { c += 1 })
    Err(Fail.Again)
  }, backoff.always())
  expect(r) == Err(Fail.Again)
  expect(calls.with_read(fn(c: Int) { c })) == 4
  expect(os.clock.sleeps()) == [1s, 2s, 4s]
}

test "retry stops before a sleep that would pass max_elapsed (TestMaxElapsedTime)" {
  let calls = Mutex[Int].new(0)
  let r = backoff.retry(backoff.Backoff{max_elapsed: 10s, randomization: 0.0, initial: 1s, multiplier: 2.0}, os.clock, seq([]), fn() -> Int ! Fail {
    calls.with(fn(var c: Int) { c += 1 })
    Err(Fail.Again)
  }, backoff.always())
  expect(r) == Err(Fail.Again)
  // 1s, 2s, 4s sleep (7s); the next 8s would end at 15s
  expect(os.clock.sleeps()) == [1s, 2s, 4s]
  expect(calls.with_read(fn(c: Int) { c })) == 4
}

test "retry_notify tells each error and the delay before its sleep (TestRetryNotify)" {
  let calls = Mutex[Int].new(0)
  let seen = Mutex[List[Duration]].new([])
  let asked = Mutex[Int].new(0)
  let r = backoff.retry_notify(backoff.Backoff{randomization: 0.0}, os.clock, seq([]), fn() -> Int ! Fail {
    let n = calls.with(fn(var c: Int) { c += 1; c })
    if n < 4 { Err(Fail.Again) } else { Ok(n) }
  }, fn(e: Fail) {
    // a retryable with an effect: it reads the clock
    let _now = os.clock.now()
    asked.with(fn(var a: Int) { a += 1 })
    e == Fail.Again
  }, fn(_e: Fail, d: Duration) { seen.with(fn(var l: List[Duration]) { l.push(d) }) })
  expect(r) == Ok(4)
  expect(seen.with_read(fn(l: List[Duration]) { l })) == [500ms, 750ms, 1125ms]
  expect(os.clock.sleeps()) == [500ms, 750ms, 1125ms]
  expect(asked.with_read(fn(a: Int) { a })) == 3
}

test "retry_notify does not notify an error it answers" {
  let seen = Mutex[Int].new(0)
  let r = backoff.retry_notify(backoff.Backoff{}, os.clock, seq([]), fn() -> Int ! Fail { Err(Fail.Fatal) }, fn(e: Fail) { e == Fail.Again }, fn(_e: Fail, _d: Duration) { seen.with(fn(var n: Int) { n += 1 }) })
  expect(r) == Err(Fail.Fatal)
  expect(seen.with_read(fn(n: Int) { n })) == 0
  expect(os.clock.sleeps()) == []
}
