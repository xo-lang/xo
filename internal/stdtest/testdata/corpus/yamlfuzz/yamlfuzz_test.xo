test "yaml fuzz: decode into a struct that derives Yaml is yaml.v3's Unmarshal" {
  for (text, want) in CASES {
    expect(show(text)) == want
  }
}

test "yaml fuzz: parse_all, encode_node and to_json are yaml.v3's" {
  for (text, nodes, emit, json) in NODE_CASES {
    expect(show_nodes(text)) == nodes
    if emit != "SKIP" {
      expect(show_emit(text)) == emit
    }
    if json != "SKIP" {
      expect(show_json(text)) == json
    }
  }
}
