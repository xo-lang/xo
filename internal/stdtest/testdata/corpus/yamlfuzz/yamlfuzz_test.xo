/// (the YAML text, what yaml.v3 parses it into as Node trees, writes back for the first, and decodes into an any then json.Marshal writes)
const NODE_CASES: List[(Str, Str, Str, Str)] = [
  ("f: 1.5", "doc\n1  0 \"\" \"\" 1:1 ->- \"\" \"\" \"\"\n 4 !!map 0 \"\" \"\" 1:1 ->- \"\" \"\" \"\"\n  8 !!str 0 \"f\" \"\" 1:1 ->- \"\" \"\" \"\"\n  8 !!float 0 \"1.5\" \"\" 1:4 ->- \"\" \"\" \"\"\n", "OK f: 1.5\n", "OK {\"f\":1.5}"),
