  ("in: {x: 1, x: 2}\r\nin: 5\r\ns: é日本 # c\r\nm: {\"k k\": v}\r\n", "ERR \"yaml: unmarshal errors:\\n  line 2: mapping key \\\"in\\\" already defined at line 1\""),
  ("n : ~\nn: -1.9\nn: 1_00& # c\nl: [ 1 , 2 ]\nin:\n  x: 3\n  y: 4\no: !!binary aGVsbG8=\nzz: 123\n", "ERR \"yaml: unmarshal errors:\\n  line 2: mapping key \\\"n\\\" already defined at line 1\\n  line 3: mapping key \\\"n\\\" already defined at line 1\\n  line 3: mapping key \\\"n\\\" already defined at line 2\""),
  ("b: no\no: é日本\nn: 12e\ns: ~\nm: {a: b, a: c} # c\n", "ERR \"yaml: unmarshal errors:\\n  line 3: cannot unmarshal !!str `12e` into int\\n  line 5: mapping key \\\"a\\\" already defined at line 5\""),
  ("%YAML 1.1\n---\nbase: &a {n: 1, s: from_anchor}\n<<: *a\nzz: !!binary @@\ns: true\no: x # c\n", "ERR \"yaml: line 5: found character that cannot start any token\""),
  ("l:\n  - 1\n  - ~\n  - 3\nl: [0x10]\no:|\n  line1\n  line2\nl: ~\n# a comment\ns: &a v\nm: {? a} # c\n", "ERR \"yaml: line 6: could not find expected ':'\""),
]

test "yaml fuzz: decode into a struct that derives Yaml is yaml.v3's Unmarshal" {
  for (text, want) in CASES {
    expect(show(text)) == want
  }
}
