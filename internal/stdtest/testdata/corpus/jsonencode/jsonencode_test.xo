// Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/json

// The types the encode cases use. Declared here, not in std: the corpus is
// the program that uses them, as every corpus is.
enum Level {
  Low
  High
} derive Json

enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
} derive Json

type Email struct(Str)

struct Point {
  x: Int
  y: Int
} derive Json

struct Inner {
  id: Int
  name: Str
} derive Json

struct Scalars {
  i: Int
  f: Float
  b: Bool
  s: Str
} derive Json

struct Opts {
  a: Int?
  b: Str?
  c: Bool?
  d: List[Int]?
} derive Json

struct Enums {
  lvl: Level
  shape: Shape
} derive Json

struct Collections {
  l: List[Str]
  st: Set[Str]
  m: Map[Str, Int]
  pair: (Str, Int)
} derive Json

struct Special {
  bytes: Bytes
  dur: Duration
  when: Time
  mail: Email
} derive Json

struct Cased {
  a_b: Str
  c: Str
} derive Json(case: camel)

struct Wired {
  kind as "type": Str
  note as "note,omitempty": Str
  always: Str
} derive Json

struct Nested {
  inner: Inner
  list: List[Inner]
} derive Json

struct StrBox {
  s: Str
} derive Json

struct FloatBox {
  v: Float
} derive Json

struct IntBox {
  n: Int
} derive Json

