/// (value, Go's encoding/json text)
const NESTED_CASES: List[(Nested, Str)] = [
  (Nested{inner: Inner{id: 1, name: "n"}, list: []}, "{\"inner\":{\"id\":1,\"name\":\"n\"},\"list\":[]}"),
  (Nested{inner: Inner{id: 0, name: ""}, list: [Inner{id: 2, name: "m"}]}, "{\"inner\":{\"id\":0,\"name\":\"\"},\"list\":[{\"id\":2,\"name\":\"m\"}]}"),
]

/// (JSON text, its canonical text: parse_value then encode)
const VALUE_CASES: List[(Str, Str)] = [
  ("null", "null"),
  ("true", "true"),
  ("false", "false"),
  ("0", "0"),
  ("-0", "-0"),
  ("1", "1"),
  ("-1", "-1"),
  ("1.5", "1.5"),
  ("-1.5", "-1.5"),
  ("0.1", "0.1"),
  ("1e21", "1e+21"),
  ("1e-7", "1e-7"),
  ("\"a\"", "\"a\""),
  ("\"a\\\"b\"", "\"a\\\"b\""),
  ("\"tab\\there\"", "\"tab\\there\""),
  ("\"\"", "\"\""),
  ("[]", "[]"),
  ("[1,2,3]", "[1,2,3]"),
  ("[[1],[2]]", "[[1],[2]]"),
  ("{}", "{}"),
  ("{\"a\":1}", "{\"a\":1}"),
  ("{\"a\":1,\"b\":2}", "{\"a\":1,\"b\":2}"),
  ("{\"a\":{\"b\":[true,null]}}", "{\"a\":{\"b\":[true,null]}}"),
  ("{\"a\":1,\"b\":[{\"c\":\"d\"}]}", "{\"a\":1,\"b\":[{\"c\":\"d\"}]}"),
  ("[{\"a\":1},{\"a\":2}]", "[{\"a\":1},{\"a\":2}]"),
]

fn show3(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

test "encode of a Str is Go's" {
  var bad: List[(Str, Str, Str)] = []
  var i = 0
  for (v, want) in STR_CASES {
    let got = json.encode_str(v)
    if got != want {
      bad.push(("row ${i}", got, want))
    }
    let bytes_text = json.encode(v)
    if bytes_text.len() != got.len() || bytes_text.to_hex() != got.bytes().to_hex() {
      bad.push(("row ${i} as Bytes", bytes_text.to_hex(), got.bytes().to_hex()))
    }
    i += 1
  }
  expect(show3(bad)) == []
}

