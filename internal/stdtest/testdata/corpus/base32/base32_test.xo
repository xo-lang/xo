const VARIANTS: List[base32.Base32] = [base32.Base32.Std, base32.Base32.Hex, base32.Base32.RawStd, base32.Base32.RawHex]

test "encode writes Go's text" {
  var bad: List[(Int, Bytes, Str, Str)] = []
  for (k, data, want) in ENCODE {
    let got = base32.encode(data, VARIANTS[k])
    if got != want {
      bad.push((k, data, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]) == []
}

test "decode gives Go's bytes or Go's error offset" {
  var bad: List[(Int, Str, Str, Str)] = []
  for (k, s, want) in DECODE {
    let got = match base32.decode(s, VARIANTS[k]) {
      Ok(b) => "ok ${b.to_hex()}"
      Err(e) => "err ${e.at}"
    }
    if got != want {
      bad.push((k, s, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]) == []
}

test "decode error displays Go's error text" {
  var bad: List[(Int, Str, Str, Str)] = []
  for (k, s, want) in DECODEERR {
    let got = match base32.decode(s, VARIANTS[k]) {
      Ok(_) => "ok"
      Err(e) => e.display()
    }
    if got != want {
      bad.push((k, s, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]) == []
}
