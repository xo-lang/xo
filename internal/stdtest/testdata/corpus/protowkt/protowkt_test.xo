fn hex(b: Bytes) -> Str {
  let digits = "0123456789abcdef".bytes()
  var o = BytesBuilder.new()
  for c in b {
    o.write_byte(digits[Int(c) / 16])
    o.write_byte(digits[Int(c) % 16])
  }
  o.freeze().to_str_lossy()
}

fn unhex(s: Str) -> Bytes {
  var o = BytesBuilder.new()
  let b = s.bytes()
  var i = 0
  while i + 1 < b.len() {
    o.write_byte(UInt8.wrapping_from(nib(Int(b[i])) * 16 + nib(Int(b[i + 1]))))
    i += 2
  }
  o.freeze()
}

fn nib(c: Int) -> Int { if c >= 97 { c - 87 } else { c - 48 } }

fn val(v: protowkt.Value) -> Str {
  match v {
    Unset => "u"
    Null => "z"
    Number(x) => "n" + hexint(x.to_bits())
    Text(s) => "s${s.len()}:${s}"
    Flag(b) => if b { "b1" } else { "b0" }
    Object(s) => strct(s)
    Array(l) => lst(l)
  }
}

fn hexint(x: Int) -> Str {
  if x == 0 {
    return "0"
  }
  let digits = "0123456789abcdef".bytes()
  var out: List[Int] = []
  var v = x
  while v != 0 {
    out.push(Int(digits[v & 15]))
    v = v.shr_logical(4)
  }
  var o = BytesBuilder.new()
  var i = out.len() - 1
  while i >= 0 {
    o.write_byte(UInt8.wrapping_from(out[i]))
    i -= 1
  }
  o.freeze().to_str_lossy()
}

fn strct(s: protowkt.Struct) -> Str {
  let keys = s.fields.keys().sort_by(fn(k: Str) -> Str { k })
  var parts: List[Str] = []
  for k in keys {
    parts.push("${k.len()}:${k}=${val(s.fields.get(k) ?? protowkt.Value.Unset)}")
  }
  "{" + parts.join(",") + "}"
}

fn lst(l: protowkt.ListValue) -> Str {
  var parts: List[Str] = []
  for v in l.values {
    parts.push(val(v))
  }
  "[" + parts.join(",") + "]"
}

test "Timestamp and Duration" {
  for (h, want) in TIMESTAMPS {
    let m = protowkt.decode_timestamp(unhex(h)).or_fault("ts")
    expect("${m.seconds},${m.nanos}") == want
    expect(hex(protowkt.encode_timestamp(m))) == h
  }
  for (h, want) in DURATIONS {
    let m = protowkt.decode_duration(unhex(h)).or_fault("du")
    expect("${m.seconds},${m.nanos}") == want
    expect(hex(protowkt.encode_duration(m))) == h
  }
}

test "FieldMask, Any and Empty" {
  for (h, want) in MASKS {
    let m = protowkt.decode_field_mask(unhex(h)).or_fault("fm")
    expect("${m.paths.len()}|${m.paths.join("|")}") == want
    expect(hex(protowkt.encode_field_mask(m))) == h
  }
  for (h, want) in ANYS {
    let m = protowkt.decode_any(unhex(h)).or_fault("any")
    expect("${m.type_url.len()}:${m.type_url},${hex(m.value)}") == want
    expect(hex(protowkt.encode_any(m))) == h
  }
  for (h, _) in EMPTIES {
    let m = protowkt.decode_empty(unhex(h)).or_fault("empty")
    expect(hex(protowkt.encode_empty(m))) == h
  }
}

test "the wrappers" {
  for (h, want) in WRAPPERS {
    let b = unhex(h)
    if want.starts_with("d") {
      let m = protowkt.decode_double_value(b).or_fault("w")
      expect("d" + hexint(m.value.to_bits())) == want
      expect(hex(protowkt.encode_double_value(m))) == h
    } else if want.starts_with("f") {
      let m = protowkt.decode_float_value(b).or_fault("w")
      expect("f" + hexint(Int(m.value.to_bits()))) == want
      expect(hex(protowkt.encode_float_value(m))) == h
    } else if want.starts_with("i64:") {
      let m = protowkt.decode_int64_value(b).or_fault("w")
      expect("i64:${m.value}") == want
      expect(hex(protowkt.encode_int64_value(m))) == h
    } else if want.starts_with("u64:") {
      let m = protowkt.decode_uint64_value(b).or_fault("w")
      expect("u64:${m.value}") == want
      expect(hex(protowkt.encode_uint64_value(m))) == h
    } else if want.starts_with("i32:") {
      let m = protowkt.decode_int32_value(b).or_fault("w")
      expect("i32:${m.value}") == want
      expect(hex(protowkt.encode_int32_value(m))) == h
    } else if want.starts_with("u32:") {
      let m = protowkt.decode_uint32_value(b).or_fault("w")
      expect("u32:${m.value}") == want
      expect(hex(protowkt.encode_uint32_value(m))) == h
    } else if want.starts_with("bool:") {
      let m = protowkt.decode_bool_value(b).or_fault("w")
      expect("bool:${if m.value { 1 } else { 0 }}") == want
      expect(hex(protowkt.encode_bool_value(m))) == h
    } else if want.starts_with("str:") {
      let m = protowkt.decode_string_value(b).or_fault("w")
      expect("str:${m.value.len()}:${m.value}") == want
      expect(hex(protowkt.encode_string_value(m))) == h
    } else {
      let m = protowkt.decode_bytes_value(b).or_fault("w")
      expect("bytes:" + hex(m.value)) == want
      expect(hex(protowkt.encode_bytes_value(m))) == h
    }
  }
}

test "wire Go never writes: wide 32 bit varints, Empty's unknown fields" {
  for (h, want) in WIDE {
    let b = unhex(h)
    let k = want.split(":")[0]
    let got = if k == "ts" {
      let m = protowkt.decode_timestamp(b).or_fault("ts")
      "ts:${m.seconds},${m.nanos}|" + hex(protowkt.encode_timestamp(m))
    } else if k == "du" {
      let m = protowkt.decode_duration(b).or_fault("du")
      "du:${m.seconds},${m.nanos}|" + hex(protowkt.encode_duration(m))
    } else if k == "i32" {
      let m = protowkt.decode_int32_value(b).or_fault("i32")
      "i32:${m.value}|" + hex(protowkt.encode_int32_value(m))
    } else if k == "u32" {
      let m = protowkt.decode_uint32_value(b).or_fault("u32")
      "u32:${m.value}|" + hex(protowkt.encode_uint32_value(m))
    } else {
      "empty:|" + hex(protowkt.encode_empty(protowkt.decode_empty(b).or_fault("e")))
    }
    expect((h, got)) == (h, want)
  }
}

test "Value, Struct and ListValue" {
  for (h, want) in VALUES {
    let m = protowkt.decode_value(unhex(h)).or_fault("v")
    expect(val(m)) == want
    expect(hex(protowkt.encode_value(m))) == h
  }
  for (h, want) in STRUCTS {
    let m = protowkt.decode_struct(unhex(h)).or_fault("s")
    expect(strct(m)) == want
    expect(hex(protowkt.encode_struct(m))) == h
  }
  for (h, want) in LISTS {
    let m = protowkt.decode_list_value(unhex(h)).or_fault("l")
    expect(lst(m)) == want
    expect(hex(protowkt.encode_list_value(m))) == h
  }
}
