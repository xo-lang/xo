// and net/http; do not edit: XO_MIMEFUZZ_WRITE=1 go test ./internal/stdtest -run TestMimeFuzzCorpusCurrent
// rewrites it.
use std/mime

fn mf_parse(v: Str) -> Str {
  match mime.parse_media_type(v) {
    Ok(m) => {
      var keys: List[Str] = []
      for (k, _) in m.params {
        keys.push(k)
      }
      var out = "ok " + m.kind.bytes().to_hex()
      for k in keys.sort() {
        out = out + ";" + k.bytes().to_hex() + "=" + (m.params.get(k) ?? "").bytes().to_hex()
      }
      out
    }
    Err(e) => "err " + e.display()
  }
}

fn mf_format(kind: Str, names: List[Str], values: List[Str]) -> Str {
  var m: Map[Str, Str] = {}
  for i in 0..names.len() {
    m.put(names[i], values[i])
  }
  mime.format_media_type(kind, m)
}

fn mf_ext(e: Str) -> Str {
  match mime.type_by_extension(e) {
    Some(t) => "some " + t
    None => "none"
  }
}

fn expect(got: Str, want: Str) {
  if got != want {
    fault("got " + got)
  }
}

