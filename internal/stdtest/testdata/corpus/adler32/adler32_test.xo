// Generated by scripts/stdcorpus from Go's hash/adler32 (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/adler32

fn buf(n: Int, seed: Int) -> Bytes {
  var b = BytesBuilder.with_capacity(n)
  var x = seed
  for _ in 0..n {
    x = (x * 1103515245 + 12345) % 2147483648
    b.write_byte(UInt8((x >> 16) & 255))
  }
  b.freeze()
}

fn splits(n: Int) -> List[Int] {
  [0, 1, n / 3, n / 2, n - 1, n].filter(fn(a) { a >= 0 && a <= n })
}

