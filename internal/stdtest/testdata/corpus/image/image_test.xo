  ("RGBA", b"\x25\x28\x60\x8a\x19\x64\x14\xbd\x19\x0f\x18\x27\x16\x3e\x3a\xa7\xc5\xb0\x0d\xd2\x26\x88\xbb\xd1", [], b"\x25\x28\x60\x8a\x19\x64\x14\xbd\x19\x0f\x18\x27\x16\x3e\x3a\xa7\xc5\xb0\x0d\xd2\x26\x88\xbb\xd1", b"\x44\x4a\xb2\x8a\x21\x87\x1b\xbd\xa4\x62\x9d\x27\x21\x5f\x58\xa7\xf0\xd6\x0f\xd2\x2e\xa6\xe5\xd1"),
