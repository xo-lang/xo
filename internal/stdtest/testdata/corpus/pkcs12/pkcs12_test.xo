// Generated by scripts/stdcorpus from golang.org/x/crypto/pkcs12's three test files, with passwords, truncations and bit flips, against std/x509's parse_pkcs12 (Go's pkcs12 tests are Copyright 2015 The Go Authors, BSD-style license) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/base64
use std/x509

const PFX: List[(Str, Str, Str, Str)] = [
  ("openssl, right password: chain.p12", "", "s3cret", "OK cn=leaf.example.com ca=1"),
  ("openssl, wrong password: chain.p12", "", "wrong", "ERR pkcs12: decryption password incorrect"),
  ("openssl, bit flipped: chain.p12", "", "s3cret", "ERR pkcs12: decryption password incorrect"),
  ("openssl, right password: nochain.p12", "", "", "OK cn=leaf.example.com ca=0"),
  ("openssl, wrong password: nochain.p12", "", "wrong", "ERR pkcs12: decryption password incorrect"),
  ("openssl, bit flipped: nochain.p12", "", "", "ERR pkcs12: decryption password incorrect"),
  ("empty password: Windows Azure Tools", "", "", "OK cn=Windows Azure Tools ca=0"),
  ("wrong password: Windows Azure Tools", "", "password", "ERR pkcs12: decryption password incorrect"),
  ("truncated: Windows Azure Tools", "", "", "ERR asn1"),
  ("one byte short: Windows Azure Tools", "", "", "ERR asn1"),
  ("bit flipped at 4: Windows Azure Tools", "", "", "ERR asn1"),
  ("bit flipped at 20: Windows Azure Tools", "", "", "ERR pkcs12: only password-protected PFX is implemented"),
  ("bit flipped at 60: Windows Azure Tools", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 400: Windows Azure Tools", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 900: Windows Azure Tools", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 2546: Windows Azure Tools", "", "", "ERR pkcs12: decryption password incorrect"),
  ("empty password: Windows IAS PEAP & LDAPS certificates", "", "", "OK cn=Windows IAS PEAP & LDAPS certificates ca=0"),
  ("wrong password: Windows IAS PEAP & LDAPS certificates", "", "password", "ERR pkcs12: decryption password incorrect"),
  ("truncated: Windows IAS PEAP & LDAPS certificates", "", "", "ERR asn1"),
  ("one byte short: Windows IAS PEAP & LDAPS certificates", "", "", "ERR asn1"),
  ("bit flipped at 4: Windows IAS PEAP & LDAPS certificates", "", "", "ERR asn1"),
  ("bit flipped at 20: Windows IAS PEAP & LDAPS certificates", "", "", "ERR pkcs12: only password-protected PFX is implemented"),
  ("bit flipped at 60: Windows IAS PEAP & LDAPS certificates", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 400: Windows IAS PEAP & LDAPS certificates", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 900: Windows IAS PEAP & LDAPS certificates", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 1827: Windows IAS PEAP & LDAPS certificates", "", "", "ERR pkcs12: decryption password incorrect"),
  ("empty password: testing@example.com", "", "", "OK cn=testing@example.com ca=0"),
  ("wrong password: testing@example.com", "", "password", "ERR pkcs12: decryption password incorrect"),
  ("truncated: testing@example.com", "", "", "ERR asn1"),
  ("one byte short: testing@example.com", "", "", "ERR asn1"),
  ("bit flipped at 4: testing@example.com", "", "", "ERR asn1"),
  ("bit flipped at 20: testing@example.com", "", "", "ERR pkcs12: only password-protected PFX is implemented"),
  ("bit flipped at 60: testing@example.com", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 400: testing@example.com", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 900: testing@example.com", "", "", "ERR pkcs12: decryption password incorrect"),
  ("bit flipped at 2484: testing@example.com", "", "", "ERR pkcs12: decryption password incorrect"),
]

fn summary(data: Bytes, pw: Str) -> Str {
  match x509.parse_pkcs12(data, pw) {
    Ok(p) => "OK cn=${p.certificate.subject.common_name} ca=${p.ca.len()}"
    Err(e) => if e.msg.contains("asn1:") || e.msg.contains("x509:") { "ERR asn1" } else { "ERR ${e.msg}" }
  }
}

test "parse_pkcs12 reads what golang.org/x/crypto/pkcs12 reads" {
  for (_, b64, pw, want) in PFX {
    let data = base64.decode(b64, base64.Base64.Std).ok() ?? b""
    let got = summary(data, pw)
    if want == "ERR asn1" {
      // a malformed file: an error, with its own wording
      expect(got.starts_with("ERR")) == true
    } else {
      expect(got) == want
    }
  }
}
