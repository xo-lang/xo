test "toml fuzz 282" {
  let bad = tf_check("[[key]]\r\n'lit' = 1e10\n[a.b]\nkey=[1, \"mixed\"]\n  # x = 1\n\"a\" = -0.0\r\n\"\" = \"\"\"multi\nline\"\"\"\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 283" {
  let bad = tf_check("  # x = 1\nb = -1\r\n\"a\" =false\r\n\"")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 284" {
  let bad = tf_check("1234 = { x = 1 }\n[\"\"]\na.b\t=\t+1\n[[\"\"]]\r\ntrue = \"s\"\r\n-\t= -0.0\nb =\tnan\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 285" {
  let bad = tf_check("[a . b]\r\na . b\t=\t-0.0\n[['lit']]\n\t\r\n[[.a]]\n")
  if bad != "" {
    fault(bad)
