test "toml fuzz 1482" {
  let bad = tf_check("[1234]\r\n\"a\" = false\n[a . b]\r\nn = 0x10000000000000000\n- =false\n[a.]\na = nan\n")
  if bad != "" {
    fault(bad)
  }
}

