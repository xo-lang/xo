test "toml fuzz 192" {
  let bad = tf_check("key\t= nan\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 193" {
  let bad = tf_check("\"a\"\t= 07:32:00\r\n[[\"qu-ted\"]]\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 194" {
  let bad = tf_check("'lit'= 1979-05-27T00:32:00.999999-07:00\na =1979-05-27T00:32:00.999999-07:00\n[a.\"b.c\"] é=\"\"\"multi\nline\"\"\" # trailing\nkey =\t1979-05-27\na =\"\"\"multi\nline\"\"\"\n\t\na . b =\t\"\\u00e9\"\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 195" {
  let bad = tf_check("bare-key_1= true\n[\"quoted\"]\na.b = 9223372036854775807\r\n\"quoted\"= [1, \"mixed\"]\n- = \"\"\n[['lit']]\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 196" {
  let bad = tf_check("a.\"b.c\"= 1.5 # trailing\r\n")
  if bad != "" {
    fault(bad)
  }
}

