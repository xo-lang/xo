test "toml fuzz 1807" {
  let bad = tf_check("a = \"\" # trailing\n[[[a]]]\nn = 0x000000000000000000000000000000000000000041\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1808" {
  let bad = tf_check("a.b = 0\na. =0o17\n\"qu#ted\" =\t1_000\r\na =1979-05-27T07:32:00Z\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1809" {
  let bad = tf_check("\n-\t=\t\"s\"\ntrue =\t1979-05-27\r\na.b =\t\"s\"\na . b\t= \"a\\nb\"\r\n[[\"\"]]\r\n[.a]\n'lit'={ x = 1, y = \"z\" }\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1810" {
  let bad = tf_check("bare-key_1 =\t1.5\n[[true]]\nb= 1979-05-27 # trailing\r\n==\t-1\n[\"a\"]\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1811" {
  let bad = tf_check("n = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF\n1234 = 1979-05-27T25:00:00\r\na.b={ a.b = 1 }\nn = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF\r\n[[é]]\r\n\"\" = [1, \"mixed\"]\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1812" {
  let bad = tf_check("\"a\" = 00:32:00.999999\n- =\t1979-05-27T07:32:00 # trailing\n[[a.b]]\nn = 0x10000000000000000\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1813" {
  let bad = tf_check("b\t=\t1 # trailing\r\na\t= { x = 1 }\nkey = \"\\uD800\"\r\n[['lit']]\nkey =0b101\nn = 9999999999999999999\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1814" {
  let bad = tf_check("\"quoted\" = [\"a\", 'b']\n[[a]]\na . b= 1979-05-27 # trailing\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1815" {
  let bad = tf_check("b=\t{}\r\na b= 0b101\na.b =\"a\\nb\"\r\n[-]\n[[bare-key_1]]\na.\"b.c\"=\tfalse # trailing\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 1816" {
  let bad = tf_check("true\t=[[1], [2, 3]]\n[\"quoted\"]\r\nkey\t=\ttrue\na . b = -inf\n[a]= { x = 1 }\na . b =\t\"\"\"multi\nline\"\"\"\n\"a\"\t=1979-05-27\r\n\"\"= \"\"\"multi\nline\"\"\"\r\n")
  if bad != "" {
