test "toml fuzz 344" {
  let bad = tf_check("n = -99999999999999999999\r\n[[a]]\na= 0x1F\n  # x = 1\r\n\"quoted\" ='lit\\n'\na.\"b.c\" = [[1], [2, 3]]\ntrue= {}\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 345" {
  let bad = tf_check("\n[a.b]\r\n= ='''raw\n''' # trailing\r\n1234\t= infinity\n# =\t{ x = 1, y = \"z, }\r\na=false\r\n# comment\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 346" {
  let bad = tf_check("a =\"\\U0001F600\"\na\t=\t{ x = 1 }\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 347" {
  let bad = tf_check("[[\"quoted\"]]\na.\"b.c\" = -9223372036854775808\r\n\"\" = {}\nbare-key_1= [[1], [2, 3]]\na = { a.b = 1 }\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 348" {
  let bad = tf_check("a . b =\"tab\\there\"\r\n[\"quoted\"]\r\nbare-key_1=\t\"\"\"a\\\n   b\"\"\"\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 349" {
  let bad = tf_check("a\t= \"tab\\there\"\n\"\" =9223372036854775807\ntrue =1_000\n\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 350" {
  let bad = tf_check("bare-key_1=\tinf\n[b]\nbare-key_1 = { x = 1, y = \"z\" }\r\na.\"b.c\"= {}\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 351" {
  let bad = tf_check("[.a]\r\n1234 = { a.b = 1 }\ntrue =\t[\"a\", 'b']\nbare-key_1 =\t[1, \"mixed\"]\n'lit' =\t[[1], [2, 3]]\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 352" {
  let bad = tf_check("'lit'\t=\t07:32:00\r\n.a =nan1\n  # x = 1\na.\"b.c\"= 0b101\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 353" {
  let bad = tf_check("n = 0xFFFFFFFFFFFFFFFF\n'lit'\t=\t[1, 2, 3] # trailing\r\ntrue = 1979-05-27\n[[a . b]]\r\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 354" {
  let bad = tf_check("key =-inf # trailing\n[a.\"b.c\"]\n[#]\n\t\n")
  if bad != "" {
    fault(bad)
  }
}

test "toml fuzz 355" {
  let bad = tf_check("# commen0\r\n\"\"=[]\r\na.b = 1.5\n1234 = { x = 1 }\na= [[1], [2, 3]]\r\n  # x = 1\r\n# comment\n\t\n")
  if bad != "" {
    fault(bad)
  }
}

