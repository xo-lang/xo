  let bad = tf_check("'lit'=\t{}\ntrue =\t1979-05-27T25:00:00\r\nkey=[1, 2, 3]\n[a] =[\n  1,\n  2,\n] # trailing\na=-inf\r\nb = -1\r\n\"a\"\t=1979-05-27T00:32:00.999999-07:00\r\n\t\r\n")
