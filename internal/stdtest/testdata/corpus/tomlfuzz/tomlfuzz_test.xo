  }
}

test "toml fuzz 200" {
  let bad = tf_check("n = 9999999999999999999999999999999999999999\r\nb\t= 6.626e-34\n\t\na.b\t= \"tab\\there\"\n1234 = 1979-05-27T07:32:00Z\r\nkey = 1_000.5\n[[a.\"b.c\"]]\r\n")
