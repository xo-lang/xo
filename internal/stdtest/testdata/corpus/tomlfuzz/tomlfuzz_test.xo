test "toml fuzz 1969" {
  let bad = tf_check("[[1234]]\r\n\"a\" =\"\\U0001F600\"\n\r\nb= 1e10\n[[true]]\r\na.\"b.c\"= [[1], [2, 3]]\r\n")
  if bad != "" {
    fault(bad)
  }
}

