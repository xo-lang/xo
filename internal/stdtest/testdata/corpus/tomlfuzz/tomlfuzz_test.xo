test "toml fuzz 360" {
  let bad = tf_check("a.\"b.c\" =[]\r\n[[\"a-]]\na = -1\n[b]\r\n-= 1979-05-27T07:32:00Z\na= []\n= ='lit\\n'\r\n")
  if bad != "" {
    fault(bad)
  }
}

