  let bad = tf_check("a . b =\t[[1], [2, 3]]\r\nbare-key_1 = \"a\\nb\"\na= \"\\U0001F600\"\r\na =\tfalse\n'lit' = 07:32:00\r\nb = { x = 1, y = \"z\" }\n")
  if bad != "" {
