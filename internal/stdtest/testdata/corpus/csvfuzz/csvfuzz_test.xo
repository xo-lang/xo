test "csv fuzz 1977" {
  let got = cf_read("a b\r a,,", ',', '\0', 0, false, false)
  if got != "ok [6120620d2061,,]" {
    fault("parse: got " + got)
  }
  let f = cf_format("a b\r a,,", ',', '\0', 0, false, false, true)
  if f != "226120622061222c2c0d0a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1978" {
  let got = cf_read("\"\"\n", ';', '#', -1, false, false)
  if got != "ok []" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1979" {
  let got = cf_read("é;\"q\"\r\u{0};;\"\"x;b\r\"a;b\"\nb;b;\r", ';', '#', 0, false, false)
  if got != "err parse error on line 1, column 6: extraneous or missing \" in quoted-field" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1980" {
  let got = cf_read("\r\na b|\"a\"\"b\"|b\n\n", '|', '\0', -1, true, false)
  if got != "ok [612062,612262,62]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\r\na b|\"a\"\"b\"|b\n\n", '|', '\0', -1, true, false, true)
  if f != "6120627c2261222262227c620d0a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1981" {
  let got = cf_read("\"a,b,\"\"\"\",a\rb\r", ',', '\0', -1, false, false)
  if got != "err parse error on line 1, column 14: extraneous or missing \" in quoted-field" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1982" {
  let got = cf_read("\n\"\"éa\rbéaé\r\"é\r\n\"\"é\"a\r\nb\"é  xé\r\u{0}", 'é', '\0', 0, false, false)
  if got != "err parse error on line 2, column 14: bare \" in non-quoted-field" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1983" {
  let got = cf_read("\r\n a,  x,b,b\n", ',', '\0', -1, false, false)
  if got != "ok [2061,202078,62,62]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\r\n a,  x,b,b\n", ',', '\0', -1, false, false, false)
  if f != "222061222c22202078222c622c620a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1984" {
  let got = cf_read("", ';', '\0', 2, true, true)
  if got != "ok " {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1985" {
  let got = cf_read("\", 99999999999999999999\r\n\r\n a,\"a\r\nb\"\n\r\n", ',', '#', 0, true, false)
  if got != "ok [2c2039393939393939393939393939393939393939390a0a20612c22610a62]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\", 99999999999999999999\r\n\r\n a,\"a\r\nb\"\n\r\n", ',', '#', 0, true, false, true)
  if f != "222c2039393939393939393939393939393939393939390d0a0d0a20612c2222610d0a62220d0a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1986" {
  let got = cf_read("\"a,b\",b,a b\r\"q\",9223372036854775807,a b\r\n\"\"\n\",\"\",\"a\" ", ',', '#', 0, false, false)
  if got != "err parse error on line 1, column 13: bare \" in non-quoted-field" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1987" {
  let got = cf_read("\"\"\ta\t\tb\n\n\r", '\t', '\0', 2, false, true)
  if got != "err record on line 1: wrong number of fields" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1988" {
  let got = cf_read("", 'é', '\0', 0, false, false)
  if got != "ok " {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1989" {
  let got = cf_read("\"q\",\"a\r\nb\",\"a\r\"\r# note\ra, a,a b,b\r", ',', '#', 2, false, false)
  if got != "err record on line 1; parse error on line 2, column 7: extraneous or missing \" in quoted-field" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1990" {
  let got = cf_read("\"a;b\"|\"q\"| a", '|', '#', 0, true, true)
  if got != "ok [613b62,71,61]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\"a;b\"|\"q\"| a", '|', '#', 0, true, true, false)
  if f != "613b627c717c610a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1991" {
  let got = cf_read("", ',', '#', 0, false, false)
  if got != "ok " {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1992" {
  let got = cf_read("\n\n\n# note\r\n", ',', '#', 2, false, false)
  if got != "ok " {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1993" {
  let got = cf_read(" a\n\"a\"\"b\"\r\n", '\t', '#', 2, true, false)
  if got != "err record on line 1: wrong number of fields" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1994" {
  let got = cf_read("  x\té\té\ta b\n", '\t', '#', -1, false, false)
  if got != "ok [202078,c3a9,c3a9,612062]" {
    fault("parse: got " + got)
  }
  let f = cf_format("  x\té\té\ta b\n", '\t', '#', -1, false, false, false)
  if f != "222020782209c3a909c3a9096120620a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1995" {
  let got = cf_read(" a;\"\"x;1;a b\r\n\n\r\n;\"a;b\";a\"b;\"a;b\"\n", ';', '#', -1, false, false)
  if got != "err parse error on line 1, column 5: extraneous or missing \" in quoted-field" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1996" {
  let got = cf_read("\r\n\"a\r\"\n\n", ',', '\0', -1, true, false)
  if got != "ok [610d]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\r\n\"a\r\"\n\n", ',', '\0', -1, true, false, true)
  if f != "2261220d0a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1997" {
  let got = cf_read("\"\"\r\n# note\n1\t\t\"a\nb\"\rb\t\t\"a\nb\"\t\"a;b\"\na\tb\n", '\t', '#', 2, false, false)
  if got != "err record on line 1: wrong number of fields" {
    fault("parse: got " + got)
  }
}

test "csv fuzz 1998" {
  let got = cf_read("\r  x;\"a\"\"b\"\n\n\n;\"a;b\";\"a;b\"\n", ';', '\0', -1, false, true)
  if got != "ok [78,612262][,613b62,613b62]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\r  x;\"a\"\"b\"\n\n\n;\"a;b\";\"a;b\"\n", ';', '\0', -1, false, true, false)
  if f != "783b2261222262220a3b22613b62223b22613b62220a" {
    fault("format: got " + f)
  }
}

test "csv fuzz 1999" {
  let got = cf_read("\n\r\n\n\"a;b\",-99999999999999999999,\"q\"", ',', '\0', -1, false, true)
  if got != "ok [613b62,2d3939393939393939393939393939393939393939,71]" {
    fault("parse: got " + got)
  }
  let f = cf_format("\n\r\n\n\"a;b\",-99999999999999999999,\"q\"", ',', '\0', -1, false, true, false)
  if f != "613b622c2d39393939393939393939393939393939393939392c710a" {
    fault("format: got " + f)
  }
}

