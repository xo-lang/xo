  (false, "0a0e662f5a5f3131332e70726f746f1a07612e70726f746f22f3050a0161121a0a0556616c756518ffffffff012001280c4800520556616c7565121c0a06e697a5e69cac189f9b012002280c4202280052066e616d65343112150a035a323318312003280c3a085c3030315c"),
  (false, ""),
  (false, ""),
  (false, "0a12667a2f5661"),
  (false, ""),
  (false, ""),
  (false, ""),
]

fn hex(b: Bytes) -> Str {
  let digits = "0123456789abcdef".bytes()
  var o = BytesBuilder.new()
  for c in b {
    o.write_byte(digits[Int(c) / 16])
    o.write_byte(digits[Int(c) % 16])
  }
  o.freeze().to_str_lossy()
}

fn unhex(s: Str) -> Bytes {
  var o = BytesBuilder.new()
  let b = s.bytes()
  var i = 0
  while i + 1 < b.len() {
    o.write_byte(UInt8.wrapping_from(nib(Int(b[i])) * 16 + nib(Int(b[i + 1]))))
    i += 2
  }
  o.freeze()
}

fn nib(c: Int) -> Int { if c >= 97 { c - 87 } else { c - 48 } }

fn tally(m: protodesc.MessageDesc) -> (Int, Int, Int) {
  var msgs = 1
  var fields = m.field.len()
  var enums = m.enum_type.len()
  for n in m.nested_type {
    let (a, b, c) = tally(n)
    msgs += a
    fields += b
    enums += c
  }
  (msgs, fields, enums)
}

test "protoc and protobuf-go descriptors decode and encode back to the same bytes" {
  for (name, pkg, _, _, _, _, _, h) in FILES {
    let raw = unhex(h)
    let d = protodesc.decode(raw).or_fault("decode " + name)
    expect(d.name) == name
    expect(d.package) == pkg
    expect(hex(protodesc.encode(d))) == h
  }
}

test "the counts agree with protodesc" {
  for (name, _, msgs, fields, enums, services, methods, h) in FILES {
    let d = protodesc.decode(unhex(h)).or_fault("decode " + name)
    var m = 0
    var f = 0
    var e = d.enum_type.len()
    for x in d.message_type {
      let (a, b, c) = tally(x)
      m += a
      f += b
      e += c
    }
    var me = 0
    for s in d.service {
      me += s.method.len()
    }
    expect(m) == msgs
    expect(f) == fields
    expect(e) == enums
    expect(d.service.len()) == services
    expect(me) == methods
  }
}

test "a truncated descriptor is an error, never a panic" {
  for (_, _, _, _, _, _, _, h) in FILES {
    let raw = unhex(h)
    var cut = 1
    while cut < raw.len() {
      let _ = protodesc.decode(raw[0..cut]).ignore_err("a truncated descriptor may be refused; only a panic fails")
      cut += 7
    }
  }
}

test "random descriptors decode and encode back to protobuf-go's bytes" {
  for (msgs, fields, enums, services, methods, h) in FUZZ {
    let d = protodesc.decode(unhex(h)).or_fault("decode " + h)
    expect(hex(protodesc.encode(d))) == h
    var m = 0
    var f = 0
    var e = d.enum_type.len()
    for x in d.message_type {
      let (a, b, c) = tally(x)
      m += a
      f += b
      e += c
    }
    var me = 0
    for s in d.service {
      me += s.method.len()
    }
    expect((m, f, e, d.service.len(), me)) == (msgs, fields, enums, services, methods)
  }
}

test "changed descriptor bytes protobuf-go accepts decode" {
  for (go_ok, h) in MUTATED {
    let ok = protodesc.decode(unhex(h)).is_ok()
    if go_ok {
      expect((h, ok)) == (h, true)
    }
  }
}
