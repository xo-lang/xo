// Generated by scripts/stdcorpus from protobuf-go v1.36.12's and grpc-go v1.79.2's own file descriptors (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.
use std/protodesc

/// (file name, package, messages, fields, enums, services, methods, serialized FileDescriptorProto as hex)
const FILES: List[(Str, Str, Int, Int, Int, Int, Int, Str)] = [
  ("google/protobuf/descriptor.proto", "google.protobuf", 34, 176, 20, 0, 0, ""),
  ("google/protobuf/any.proto", "google.protobuf", 1, 2, 0, 0, 0, ""),
  ("google/protobuf/api.proto", "google.protobuf", 3, 18, 0, 0, 0, ""),
  ("google/protobuf/duration.proto", "google.protobuf", 1, 2, 0, 0, 0, ""),
  ("google/protobuf/empty.proto", "google.protobuf", 1, 0, 0, 0, 0, ""),
  ("google/protobuf/field_mask.proto", "google.protobuf", 1, 1, 0, 0, 0, ""),
  ("google/protobuf/source_context.proto", "google.protobuf", 1, 1, 0, 0, 0, ""),
  ("google/protobuf/struct.proto", "google.protobuf", 4, 10, 1, 0, 0, ""),
  ("google/protobuf/timestamp.proto", "google.protobuf", 1, 2, 0, 0, 0, ""),
  ("google/protobuf/type.proto", "google.protobuf", 5, 28, 3, 0, 0, ""),
  ("google/protobuf/wrappers.proto", "google.protobuf", 9, 9, 0, 0, 0, ""),
  ("grpc/health/v1/health.proto", "grpc.health.v1", 5, 5, 1, 1, 3, ""),
  ("grpc/reflection/v1/reflection.proto", "grpc.reflection.v1", 8, 21, 0, 1, 1, ""),
  ("grpc/testing/test.proto", "grpc.testing", 0, 0, 0, 7, 20, ""),
  ("grpc/testing/messages.proto", "grpc.testing", 40, 95, 5, 0, 0, ""),
]

fn hex(b: Bytes) -> Str {
  let digits = "0123456789abcdef".bytes()
  var o = BytesBuilder.new()
  for c in b {
    o.write_byte(digits[Int(c) / 16])
    o.write_byte(digits[Int(c) % 16])
  }
  o.freeze().to_str_lossy()
}

fn unhex(s: Str) -> Bytes {
  var o = BytesBuilder.new()
  let b = s.bytes()
  var i = 0
  while i + 1 < b.len() {
    o.write_byte(UInt8.wrapping_from(nib(Int(b[i])) * 16 + nib(Int(b[i + 1]))))
    i += 2
  }
  o.freeze()
}

fn nib(c: Int) -> Int { if c >= 97 { c - 87 } else { c - 48 } }

fn tally(m: protodesc.MessageDesc) -> (Int, Int, Int) {
  var msgs = 1
  var fields = m.field.len()
  var enums = m.enum_type.len()
  for n in m.nested_type {
    let (a, b, c) = tally(n)
    msgs += a
    fields += b
    enums += c
  }
  (msgs, fields, enums)
}

test "protoc and protobuf-go descriptors decode and encode back to the same bytes" {
  for (name, pkg, _, _, _, _, _, h) in FILES {
    let raw = unhex(h)
    let d = protodesc.decode(raw).or_fault("decode " + name)
    expect(d.name) == name
    expect(d.package) == pkg
    expect(hex(protodesc.encode(d))) == h
  }
}

test "the counts agree with protodesc" {
  for (name, _, msgs, fields, enums, services, methods, h) in FILES {
    let d = protodesc.decode(unhex(h)).or_fault("decode " + name)
    var m = 0
    var f = 0
    var e = d.enum_type.len()
    for x in d.message_type {
      let (a, b, c) = tally(x)
      m += a
      f += b
      e += c
    }
    var me = 0
    for s in d.service {
      me += s.method.len()
    }
    expect(m) == msgs
    expect(f) == fields
    expect(e) == enums
    expect(d.service.len()) == services
    expect(me) == methods
  }
}

test "a truncated descriptor is an error, never a panic" {
  for (_, _, _, _, _, _, _, h) in FILES {
    let raw = unhex(h)
    var cut = 1
    while cut < raw.len() {
      let _ = protodesc.decode(raw[0..cut]).ignore_err("a truncated descriptor may be refused; only a panic fails")
      cut += 7
    }
  }
}
