6-10-21 k=v é\nabc xfoo 2026-10-21 k=v é\nabc xfoo 2026-10-21 k=v é\nabc xfoo 2026-10-21 k=v é\nabc xfoo 2026-10-21 k=v é\nabc xfoo 2026-10-21 k=v é\nabc xfoo 2026-10-21 k=v é\n", "", ".BéA=-_", "日xb-", "", "-日 -Aǅc=-", "bc", "", "A", "日éc_1.-x", "é c", "", "b\n.1@bA2c", "-", ".xBa 日", "", "x=日日__", "", "\n1B", "xc.-11 =日", ".xBé2-_=", "c=2a1", "a1b", " A._.é1", ""]

/// (pattern, what its RegexErr displays: Xo's wording around Go's code and expression)
const ERRS: List[(Str, Str)] = [
  ("(", "invalid regexp \"(\": missing closing ): `(`"),
  ("a)", "invalid regexp \"a)\": unexpected ): `a)`"),
  ("[a", "invalid regexp \"[a\": missing closing ]: `[a`"),
  ("*a", "invalid regexp \"*a\": missing argument to repetition operator: `*`"),
  ("a**", "invalid regexp \"a**\": invalid nested repetition operator: `**`"),
  ("a{2,1}", "invalid regexp \"a{2,1}\": invalid repeat count: `{2,1}`"),
  ("\\8", "invalid regexp \"\\\\8\": invalid escape sequence: `\\8`"),
  ("(?z)", "invalid regexp \"(?z)\": invalid or unsupported Perl syntax: `(?z`"),
  ("[z-a]", "invalid regexp \"[z-a]\": invalid character class range: `z-a`"),
  ("\\p{Foo}", "invalid regexp \"\\\\p{Foo}\": invalid character class range: `\\p{Foo}`"),
  ("a{1001}", "invalid regexp \"a{1001}\": invalid repeat count: `{1001}`"),
]

fn joined(l: List[Str]) -> Str { l.join("\u{1}") }

fn result(re: regexp.Regex, s: Str) -> Str {
  var parts: List[Str] = []
  parts.push(match re.find_index(s) {
    Some((a, b)) => "${a},${b}"
    None => "-"
  })
  parts.push(if s.len() > 10000 { "" } else { joined(re.find_all(s)) })
  parts.push(match re.captures(s) {
    Some(cs) => joined(cs.map(fn(c) { c ?? "\u{2}" }))
    None => "-"
  })
  if s.len() > 10000 {
    parts.push("${re.find_all(s).len()}")
    return parts.join("\u{3}")
  }
  parts.push(re.replace_all(s, "<$1>"))
  parts.push(re.replace_all_literal(s, "<$1>"))
  parts.push(joined(re.split(s)))
  parts.push(re.find_all_index(s).map(fn(m: (Int, Int)) -> Str { "${m.0},${m.1}" }).join(";"))
  parts.push(match re.captures_index(s) {
    Some(m) => spans(m)
    None => "-"
  })
  // Go's FindAllStringSubmatch gives "" for a group that did not take part
  parts.push(joined(re.captures_all(s).map(fn(m: List[Str?]) -> Str { m.map(fn(c: Str?) -> Str { c ?? "" }).join("\u{2}") })))
  parts.push(joined(re.captures_all_index(s).map(fn(m: List[(Int, Int)?]) -> Str { spans(m) })))
  parts.push(re.replace_all_with(s, fn(m: Str) -> Str { "[${m}]${m.len()}" }))
  parts.join("\u{3}")
}

fn spans(m: List[(Int, Int)?]) -> Str {
  m.map(fn(c: (Int, Int)?) -> Str {
    match c {
      Some((a, b)) => "${a},${b}"
      None => "x"
    }
  }).join(";")
}

/// The patterns of CASES from k of PARTS in turn: each a test of its own,
/// so a loaded host stays under xo test's 60 s per test (host 3 took 81 s
/// for the whole corpus in one test, 2026-11-11; host 4, 8 CPUs, ran two
/// of 4 parts past 60 s on the Go backend, 2026-11-15: now 8).
fn bad_in(k: Int) -> List[(Str, Str, Str, Str)] {
  var bad: List[(Str, Str, Str, Str)] = []
  for (j, (pat, ok, want)) in CASES.indexed() {
    if j % PARTS != k {
      continue
    }
    match regexp.compile(pat) {
      Ok(re) => {
        if !ok {
          bad.push((pat, "compiled", "", ""))
        } else {
          for (i, s) in INPUTS.indexed() {
            let got = result(re, s)
            if got != want[i] {
              bad.push((pat, s, got, want[i]))
            }
          }
        }
      }
      Err(_) => {
        if ok {
          bad.push((pat, "did not compile", "", ""))
        }
      }
    }
  }
  bad
}

const PARTS: Int = 8

test "regexp is Go's on the corpus, part 1 of 8" {
  let bad = bad_in(0)
  expect(bad[0..(if bad.len() < 10 { bad.len() } else { 10 })]) == []
}

