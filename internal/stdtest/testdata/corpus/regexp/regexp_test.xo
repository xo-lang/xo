  ("(?:a|é){1,2}c", true, ["-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}a\u{3}a\u{3}a", "-\u{3}\u{3}-\u{3}abc\u{3}abc\u{3}abc", "-\u{3}\u{3}-\u{3}aaa\u{3}aaa\u{3}aaa", "-\u{3}\u{3}-\u{3}ab\u{3}ab\u{3}ab", "-\u{3}\u{3}-\u{3}abcabc\u{3}abcabc\u{3}abcabc", "-\u{3}\u{3}-\u{3}foo bar\u{3}foo bar\u{3}foo bar", "-\u{3}\u{3}-\u{3}xfoo foo foox\u{3}xfoo foo foox\u{3}xfoo foo foox", "-\u{3}\u{3}-\u{3}a\nb\nc\u{3}a\nb\nc\u{3}a\nb\nc", "-\u{3}\u{3}-\u{3}2026-10-21\u{3}2026-10-21\u{3}2026-10-21", "-\u{3}\u{3}-\u{3}k=v one=two\u{3}k=v one=two\u{3}k=v one=two", "-\u{3}\u{3}-\u{3}bob@example.com x\u{3}bob@example.com x\u{3}bob@example.com x", "-\u{3}\u{3}-\u{3}é日本\u{3}é日本\u{3}é日本", "-\u{3}\u{3}-\u{3}ǆ\u{3}ǆ\u{3}ǆ", "-\u{3}\u{3}-\u{3}aXbXc\u{3}aXbXc\u{3}aXbXc", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}.BéA=-_\u{3}.BéA=-_\u{3}.BéA=-_", "-\u{3}\u{3}-\u{3}日xb-\u{3}日xb-\u{3}日xb-", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}-日 -Aǅc=-\u{3}-日 -Aǅc=-\u{3}-日 -Aǅc=-", "-\u{3}\u{3}-\u{3}bc\u{3}bc\u{3}bc", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}A\u{3}A\u{3}A", "3,6\u{3}éc\u{3}éc\u{3}日<>_1.-x\u{3}日<\$1>_1.-x\u{3}日\u{1}_1.-x", "-\u{3}\u{3}-\u{3}é c\u{3}é c\u{3}é c", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}b\n.1@bA2c\u{3}b\n.1@bA2c\u{3}b\n.1@bA2c", "-\u{3}\u{3}-\u{3}-\u{3}-\u{3}-", "-\u{3}\u{3}-\u{3}.xBa 日\u{3}.xBa 日\u{3}.xBa 日", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}x=日日__\u{3}x=日日__\u{3}x=日日__", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}\n1B\u{3}\n1B\u{3}\n1B", "-\u{3}\u{3}-\u{3}xc.-11 =日\u{3}xc.-11 =日\u{3}xc.-11 =日", "-\u{3}\u{3}-\u{3}.xBé2-_=\u{3}.xBé2-_=\u{3}.xBé2-_=", "-\u{3}\u{3}-\u{3}c=2a1\u{3}c=2a1\u{3}c=2a1", "-\u{3}\u{3}-\u{3}a1b\u{3}a1b\u{3}a1b", "-\u{3}\u{3}-\u{3} A._.é1\u{3} A._.é1\u{3} A._.é1", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}B\u{3}B\u{3}B"]),
  ("\\s*b(?:[^a]|x)*?.", true, ["-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}a\u{3}a\u{3}a", "1,3\u{3}bc\u{3}bc\u{3}a<>\u{3}a<\$1>\u{3}a\u{1}", "-\u{3}\u{3}-\u{3}aaa\u{3}aaa\u{3}aaa", "-\u{3}\u{3}-\u{3}ab\u{3}ab\u{3}ab", "1,3\u{3}bc\u{1}bc\u{3}bc\u{3}a<>a<>\u{3}a<\$1>a<\$1>\u{3}a\u{1}a\u{1}", "3,6\u{3} ba\u{3} ba\u{3}foo<>r\u{3}foo<\$1>r\u{3}foo\u{1}r", "-\u{3}\u{3}-\u{3}xfoo foo foox\u{3}xfoo foo foox\u{3}xfoo foo foox", "1,5\u{3}\nb\nc\u{3}\nb\nc\u{3}a<>\u{3}a<\$1>\u{3}a\u{1}", "-\u{3}\u{3}-\u{3}2026-10-21\u{3}2026-10-21\u{3}2026-10-21", "-\u{3}\u{3}-\u{3}k=v one=two\u{3}k=v one=two\u{3}k=v one=two", "0,2\u{3}bo\u{1}b@\u{3}bo\u{3}<><>example.com x\u{3}<\$1><\$1>example.com x\u{3}\u{1}\u{1}example.com x", "-\u{3}\u{3}-\u{3}é日本\u{3}é日本\u{3}é日本", "-\u{3}\u{3}-\u{3}ǆ\u{3}ǆ\u{3}ǆ", "2,4\u{3}bX\u{3}bX\u{3}aX<>c\u{3}aX<\$1>c\u{3}aX\u{1}c", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}.BéA=-_\u{3}.BéA=-_\u{3}.BéA=-_", "4,6\u{3}b-\u{3}b-\u{3}日x<>\u{3}日x<\$1>\u{3}日x\u{1}", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}-日 -Aǅc=-\u{3}-日 -Aǅc=-\u{3}-日 -Aǅc=-", "0,2\u{3}bc\u{3}bc\u{3}<>\u{3}<\$1>\u{3}\u{1}", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}A\u{3}A\u{3}A", "-\u{3}\u{3}-\u{3}日éc_1.-x\u{3}日éc_1.-x\u{3}日éc_1.-x", "-\u{3}\u{3}-\u{3}é c\u{3}é c\u{3}é c", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "0,3\u{3}b\n.\u{1}bA\u{3}b\n.\u{3}<>1@<>2c\u{3}<\$1>1@<\$1>2c\u{3}\u{1}1@\u{1}2c", "-\u{3}\u{3}-\u{3}-\u{3}-\u{3}-", "-\u{3}\u{3}-\u{3}.xBa 日\u{3}.xBa 日\u{3}.xBa 日", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}x=日日__\u{3}x=日日__\u{3}x=日日__", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}\n1B\u{3}\n1B\u{3}\n1B", "-\u{3}\u{3}-\u{3}xc.-11 =日\u{3}xc.-11 =日\u{3}xc.-11 =日", "-\u{3}\u{3}-\u{3}.xBé2-_=\u{3}.xBé2-_=\u{3}.xBé2-_=", "-\u{3}\u{3}-\u{3}c=2a1\u{3}c=2a1\u{3}c=2a1", "-\u{3}\u{3}-\u{3}a1b\u{3}a1b\u{3}a1b", "-\u{3}\u{3}-\u{3} A._.é1\u{3} A._.é1\u{3} A._.é1", "-\u{3}\u{3}-\u{3}\u{3}\u{3}", "-\u{3}\u{3}-\u{3}B\u{3}B\u{3}B"]),
]

const INPUTS: List[Str] = ["", "a", "abc", "aaa", "ab", "abcabc", "foo bar", "xfoo foo foox", "a\nb\nc", "2026-10-21", "k=v one=two", "bob@example.com x", "é日本", "ǆ", "aXbXc", "", ".BéA=-_", "日xb-", "", "-日 -Aǅc=-", "bc", "", "A", "日éc_1.-x", "é c", "", "b\n.1@bA2c", "-", ".xBa 日", "", "x=日日__", "", "\n1B", "xc.-11 =日", ".xBé2-_=", "c=2a1", "a1b", " A._.é1", "", "B"]

fn joined(l: List[Str]) -> Str { l.join("\u{1}") }

fn result(re: regexp.Regex, s: Str) -> Str {
  var parts: List[Str] = []
  parts.push(match re.find_index(s) {
    Some((a, b)) => "${a},${b}"
    None => "-"
  })
  parts.push(joined(re.find_all(s)))
  parts.push(match re.captures(s) {
    Some(cs) => joined(cs.map(fn(c) { c ?? "\u{2}" }))
    None => "-"
  })
  parts.push(re.replace_all(s, "<$1>"))
  parts.push(re.replace_all_literal(s, "<$1>"))
  parts.push(joined(re.split(s)))
  parts.join("\u{3}")
}

test "regexp is Go's on the corpus" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (pat, ok, want) in CASES {
    match regexp.compile(pat) {
      Ok(re) => {
        if !ok {
          bad.push((pat, "compiled", "", ""))
        } else {
          for (i, s) in INPUTS.indexed() {
            let got = result(re, s)
            if got != want[i] {
              bad.push((pat, s, got, want[i]))
            }
          }
        }
      }
      Err(_) => {
        if ok {
          bad.push((pat, "did not compile", "", ""))
        }
      }
    }
  }
  expect(bad[0..(if bad.len() < 10 { bad.len() } else { 10 })]) == []
}
