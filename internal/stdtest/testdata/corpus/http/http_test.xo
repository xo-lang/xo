// Generated by scripts/stdcorpus from std/http's StatusError through the interface, Router.call's rendering of a handler error that carries a status, of one that does not, and of a middleware's (std.md 4.2), and cookie parsing and rendering against Go's ParseCookie, ParseSetCookie and Cookie.String (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.
use std/http

enum RouteErr {
  Teapot
}
fn (e: RouteErr) status() -> Int { 418 }
fn (e: RouteErr) display() -> Str { "teapot" }

enum PlainErr {
  Broken
}
fn (e: PlainErr) display() -> Str { "broken" }

fn get(r: http.Router, path: Str) -> http.Response {
  let u = http.Url{scheme: "http", host: "h", port: None, path: path, query: {}}
  r.call(http.Request{method: "GET", path: path, url: u, headers: {}, body: b"", remote_ip: ""})
}

test "a handler's error with a status is a response with that status, through http.StatusError" {
  var r = http.router()
  r.handle("GET /teapot", fn(_q: http.Request) -> http.Response ! RouteErr { Err(RouteErr.Teapot) })
  let resp = get(r, "/teapot")
  expect(resp.status) == 418
  expect(resp.text()?) == "{\"error\":\"teapot\"}"
}

test "an error without a status is a 500 with the generic message, not its display" {
  var r = http.router()
  r.handle("GET /broken", fn(_q: http.Request) -> http.Response ! PlainErr { Err(PlainErr.Broken) })
  let resp = get(r, "/broken")
  expect(resp.status) == 500
  // the display is logged, not sent: a client learns nothing from it
  expect(resp.text()?) == "{\"error\":\"internal error\"}"
}

test "a middleware's error is rendered the same way" {
  var r = http.router()
  r.handle("GET /ok", fn(_q: http.Request) -> http.Response { http.text(200, "ok") })
  r.wrap(fn(_q: http.Request, _next: http.Next) -> http.Response ! RouteErr { Err(RouteErr.Teapot) })
  let resp = get(r, "/ok")
  expect(resp.status) == 418
  expect(resp.text()?) == "{\"error\":\"teapot\"}"
}

test "a value of the interface reads its status and its display" {
  let e: http.StatusError = RouteErr.Teapot
  expect(e.status()) == 418
  expect(e.display()) == "teapot"
}

/// (Cookie header value, Go's ParseCookie: each cookie's String joined with "|", or the error)
const COOKIE_LINES: List[(Str, Str)] = [
  ("a=b", "a=b"),
  ("a=b; c=d", "a=b|c=d"),
  ("a=b; c=d; e=f", "a=b|c=d|e=f"),
  ("a=b; a=c", "a=b|a=c"),
  (" a = b ; c = d ", "http: invalid cookie name"),
  ("a=", "a="),
  ("=b", "http: invalid cookie name"),
  ("a=b,c=d", "a=\"b,c=d\""),
  ("a=b; c", "http: '=' not found in cookie"),
  ("a", "http: '=' not found in cookie"),
  ("a=b; c=d; e", "http: '=' not found in cookie"),
  ("a=\"b\"", "a=\"b\""),
  ("a=\"b\\\"c\"", "http: invalid cookie value"),
  ("a=\"b", "http: invalid cookie value"),
  ("a b=c", "http: invalid cookie name"),
  ("a=b c", "a=\"b c\""),
  ("\$Version=1; a=b", "\$Version=1|a=b"),
  ("a=b; Expires=Wed, 09 Jun 2021 10:18:14 GMT", "a=b|Expires=\"Wed, 09 Jun 2021 10:18:14 GMT\""),
  ("a=b; b=c;", "http: '=' not found in cookie"),
  (";;a=b", "http: '=' not found in cookie"),
]

/// (Set-Cookie value, Go's ParseSetCookie: the cookie's String, or the error)
const SET_COOKIE_LINES: List[(Str, Str)] = [
  ("a=b", "a=b"),
  ("a=b; Path=/x", "a=b; Path=/x"),
  ("a=b; Domain=example.com", "a=b; Domain=example.com"),
  ("a=b; Secure", "a=b; Secure"),
  ("a=b; HttpOnly", "a=b; HttpOnly"),
  ("a=b; SameSite=Lax", "a=b; SameSite=Lax"),
  ("a=b; SameSite=Strict", "a=b; SameSite=Strict"),
  ("a=b; SameSite=None", "a=b; SameSite=None"),
  ("a=b; Max-Age=3600", "a=b; Max-Age=3600"),
  ("a=b; Max-Age=0", "a=b; Max-Age=0"),
  ("a=b; Max-Age=-1", "a=b; Max-Age=0"),
  ("a=b; Expires=Wed, 09 Jun 2021 10:18:14 GMT", "a=b; Expires=Wed, 09 Jun 2021 10:18:14 GMT"),
  ("a=b; Expires=Thu, 01 Jan 1970 00:00:00 GMT", "a=b; Expires=Thu, 01 Jan 1970 00:00:00 GMT"),
  ("a=b; Expires=Sat, 25 Dec 2021 23:59:59 GMT", "a=b; Expires=Sat, 25 Dec 2021 23:59:59 GMT"),
  ("a=b; Expires=Wednesday, 09-Jun-21 10:18:14 GMT", "a=b"),
  ("a=b; Expires=Wed, 09-Jun-2021 10:18:14 GMT", "a=b; Expires=Wed, 09 Jun 2021 10:18:14 GMT"),
  ("a=b; Expires=Wed, 09 Jun 2021 10:18:14", "a=b"),
  ("a=b; Expires=Wed Jun  9 10:18:14 2021", "a=b"),
  ("a=b; Path=/x; Domain=example.com; Secure; HttpOnly; SameSite=Lax; Max-Age=3600", "a=b; Path=/x; Domain=example.com; Max-Age=3600; HttpOnly; Secure; SameSite=Lax"),
  ("\"a\"=b", "http: invalid cookie name"),
  ("a=\"b\"", "a=\"b\""),
  ("a=b; Path", "a=b"),
  ("a", "http: '=' not found in cookie"),
  ("=b", "http: invalid cookie name"),
  ("a=b; Max-Age=abc", "a=b"),
  ("a=b; Domain=bad_domain", "a=b"),
  ("a=b; Path=/p; Path=/q", "a=b; Path=/q"),
  ("a=b; Unknown=1", "a=b"),
  ("a=b; Partitioned", "a=b; Partitioned"),
  ("a=b; SameSite=bogus", "a=b"),
]

fn cookie_lines_joined(cs: List[http.Cookie]) -> Str {
  cs.map(fn(c) { c.display() }).join("|")
}

test "parse_cookie is Go's ParseCookie and each cookie displays as Go's String" {
  var bad: List[(Str, Str, Str)] = []
  for (line, want) in COOKIE_LINES {
    let got = match http.parse_cookie(line) {
      Ok(cs) => cookie_lines_joined(cs)
      Err(e) => e.display()
    }
    if got != want {
      bad.push((line, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 10 { bad.len() } else { 10 })]) == []
}

test "parse_set_cookie is Go's ParseSetCookie and the cookie displays as Go's String" {
  var bad: List[(Str, Str, Str)] = []
  for (line, want) in SET_COOKIE_LINES {
    let got = match http.parse_set_cookie(line) {
      Ok(c) => c.display()
      Err(e) => e.display()
    }
    if got != want {
      bad.push((line, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 10 { bad.len() } else { 10 })]) == []
}
