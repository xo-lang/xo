use std/json
use std/jsonrpc

fn int_at(v: json.Value?, i: Int, key: Str) -> Int {
  let p = v ?? json.Value.Null
  let x = match p {
    json.Value.List(xs) => xs.get(i)
    _ => p.get(key)
  }
  match x {
    Some(json.Value.Int(n)) => n
    _ => 0
  }
}

/// The specification's example methods.
fn handle(r: jsonrpc.Request) -> json.Value ! jsonrpc.RpcError {
  if r.method == "subtract" {
    return Ok(json.Value.Int(int_at(r.params, 0, "minuend") - int_at(r.params, 1, "subtrahend")))
  }
  if r.method == "sum" {
    var t = 0
    if let Some(json.Value.List(xs)) = r.params {
      for x in xs {
        if let json.Value.Int(n) = x {
          t += n
        }
      }
    }
    return Ok(json.Value.Int(t))
  }
  if r.method == "get_data" {
    return Ok(json.Value.List([json.Value.Str("hello"), json.Value.Int(5)]))
  }
  if r.method == "update" || r.method.starts_with("notify_") {
    return Ok(json.Value.Null)
  }
  Err(jsonrpc.error_of(jsonrpc.METHOD_NOT_FOUND))
}

/// v as the oracle renders JSON: keys sorted, numbers as Go's float64.
fn canon(v: json.Value?) -> Str {
  match v {
    None => "-"
    Some(x) => canon_value(x)
  }
}

fn canon_value(v: json.Value) -> Str {
  match v {
    json.Value.Object(fs) => {
      var ks: List[Str] = []
      for (k, _) in fs {
        ks.push(k)
      }
      ks = ks.sort()
      var parts: List[Str] = []
      for k in ks {
        parts.push(json.Value.Str(k).encode() + ":" + canon_value(v.get(k) ?? json.Value.Null))
      }
      "{" + parts.join(",") + "}"
    }
    json.Value.List(xs) => {
      var parts: List[Str] = []
      for x in xs {
        parts.push(canon_value(x))
      }
      "[" + parts.join(",") + "]"
    }
    _ => v.encode()
  }
}

fn show_id(id: jsonrpc.Id?) -> Str {
  match id {
    None => "none"
    Some(jsonrpc.Id.Int(n)) => "int ${n}"
    Some(jsonrpc.Id.Str(s)) => "str ${s}"
  }
}

fn show(text: Str) -> Str {
  match jsonrpc.decode(text) {
    Err(_) => "error"
    Ok(jsonrpc.Message.Req(r)) => "request id=${show_id(r.id)} method=${r.method} params=${canon(r.params)}"
    Ok(jsonrpc.Message.Resp(r)) => {
      let s = "response id=${show_id(r.id)}"
      match r.error {
        Some(e) => s + " error=${e.code}/${e.message}/${canon(e.data)}"
        None => s + " result=${canon(Some(r.result))}"
      }
    }
  }
}

fn reencode(text: Str) -> Str {
  match jsonrpc.decode(text) {
    Ok(m) => jsonrpc.encode(m)
    Err(e) => "error ${e.code}"
  }
}

test "specification example: positional parameters" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42, 23], \"id\": 1}", handle)) == Some("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":19}")
}

test "specification example: positional parameters, swapped" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [23, 42], \"id\": 2}", handle)) == Some("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":-19}")
}

test "specification example: named parameters" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": {\"subtrahend\": 23, \"minuend\": 42}, \"id\": 3}", handle)) == Some("{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":19}")
}

test "specification example: named parameters, reordered" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": {\"minuend\": 42, \"subtrahend\": 23}, \"id\": 4}", handle)) == Some("{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":19}")
}

test "specification example: a notification" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"update\", \"params\": [1,2,3,4,5]}", handle)) == None
}

test "specification example: a notification without params" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"foobar\"}", handle)) == None
}

test "specification example: a non-existent method" {
  expect(jsonrpc.answer("{\"jsonrpc\": \"2.0\", \"method\": \"foobar\", \"id\": \"1\"}", handle)) == Some("{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}")
}

