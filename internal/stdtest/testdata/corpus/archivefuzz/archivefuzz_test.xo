// Generated by internal/stdtest/archivefuzz_test.go (seed 1, 2010 cases) from the Go
// backend's untar and unzip (Go's archive/tar and archive/zip); do not edit:
// XO_ARCHIVEFUZZ_WRITE=1 go test ./internal/stdtest -run TestArchiveFuzzCorpusCurrent rewrites it.
use std/archive

fn af_list(es: List[archive.Entry]) -> Str {
  var out = "ok "
  for e in es {
    out = out + "${e.path.bytes().to_hex()}:${e.mode}:${e.is_dir}:${e.modified.unix_millis()}:${e.data.to_hex()};"
  }
  out
}

fn af_untar(gz: Bytes) -> Str {
  match archive.gunzip(gz) {
    Ok(b) => match archive.untar(b) {
      Ok(es) => af_list(es)
      Err(e) => "err " + e.display()
    }
    Err(e) => "gunzip " + e.display()
  }
}

fn af_unzip(gz: Bytes) -> Str {
  match archive.gunzip(gz) {
    Ok(b) => match archive.unzip(b) {
      Ok(es) => af_list(es)
      Err(e) => "err " + e.display()
    }
    Err(e) => "gunzip " + e.display()
  }
}

