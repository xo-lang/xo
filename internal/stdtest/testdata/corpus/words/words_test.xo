  (-4866880404537995078, 3003706643693887093, "-1863173760844107985", "-7870587048231882171", "none", "-1", "std.md 2.1 checked: None on overflow; std.md 2.1 checked_div: None on a zero divisor or MinInt64 / -1"),
  (-2377927147360336371, 6180596160137596549, "3802669012777260178", "-8558523307497932920", "none", "0", "std.md 2.1 checked: None on overflow; std.md 2.1 checked_div: None on a zero divisor or MinInt64 / -1"),
