  (-947343654871041209, "some -947343654871041209", "std.md 2.2 Int64.try: Int64 has Int's range"),
  (3147790424037659096, "some 3147790424037659096", "std.md 2.2 Int64.try: Int64 has Int's range"),
  (79876466084125000, "some 79876466084125000", "std.md 2.2 Int64.try: Int64 has Int's range"),
  (6448003867665845275, "some 6448003867665845275", "std.md 2.2 Int64.try: Int64 has Int's range"),
  (-6385191596466280420, "some -6385191596466280420", "std.md 2.2 Int64.try: Int64 has Int's range"),
  (785295407437822083, "some 785295407437822083", "std.md 2.2 Int64.try: Int64 has Int's range"),
  (3546343826724305832, "some 3546343826724305832", "std.md 2.2 Int64.try: Int64 has Int's range"),
]

fn show3(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

fn opt_text(o: Int?) -> Str {
  match o {
    Some(n) => "some ${n}"
    None => "none"
  }
}

fn res_text(r: Result[Int, Str]) -> Str {
  match r {
    Ok(n) => "ok ${n}"
    Err(e) => "err ${e}"
  }
}

fn inc(n: Int) -> Int? { n.checked_add(1) }
fn nothing(_n: Int) -> Int? { None }

/// The unit separated keys of a SORT_STR_CASES row.
fn split_keys(s: Str) -> List[Str] {
  if s == "" {
    []
  } else {
    s.split("\u{1f}")
  }
}

test "Float.is_inf is Go's math.IsInf" {
  var bad: List[(Str, Str, Str)] = []
  for (bits, want, _) in IS_INF_CASES {
    let got = "${Float.from_bits(bits).is_inf()}"
    if got != "${want}" {
      bad.push(("bits ${bits}", got, "${want}"))
    }
  }
  expect(show3(bad)) == []
}

test "Str.unquote is Go's Unquote, and None when the result is not UTF-8" {
  var bad: List[(Str, Str, Str)] = []
  for (text, ok, want, _) in UNQUOTE_CASES {
    let got = match text.unquote() {
      Some(s) => "some ${s}"
      None => "none"
    }
    let want_text = if ok { "some ${want}" } else { "none" }
    if got != want_text {
      bad.push((text, got, want_text))
    }
  }
  expect(show3(bad)) == []
}

test "Option.or_err is Ok for Some and the error for None" {
  let some: Int? = Some(3)
  let none: Int? = None
  expect(res_text(some.or_err("e"))) == "ok 3"
  expect(res_text(none.or_err("e"))) == "err e"
  expect(res_text(Some(-7).or_err("e"))) == "ok -7"
}

test "Option.and_then runs its function on Some only" {
  let some: Int? = Some(3)
  let none: Int? = None
  expect(opt_text(some.and_then(inc))) == "some 4"
  expect(opt_text(none.and_then(inc))) == "none"
  expect(opt_text(some.and_then(nothing))) == "none"
  expect(opt_text(Some(9223372036854775807).and_then(inc))) == "none"
}

test "Duration.ceil_seconds rounds up only a positive remainder" {
  var bad: List[(Str, Str, Str)] = []
  for (nanos, want, _) in CEIL_CASES {
    let got = "${Duration.from_nanos(nanos).ceil_seconds()}"
    if got != "${want}" {
      bad.push(("nanos ${nanos}", got, "${want}"))
    }
  }
  expect(show3(bad)) == []
}

test "List.sort of Strs orders every shape Go's sort.Strings orders" {
  var bad: List[(Str, Str, Str)] = []
  for (keys, want, shape) in SORT_STR_CASES {
    let got = split_keys(keys).sort().join("\u{1f}")
    if got != want {
      bad.push((shape, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "List.sort leaves the receiver in its order and returns a new list" {
  let xs = ["b", "a", "c"]
  let s = xs.sort()
  expect(xs.join(",")) == "b,a,c"
  expect(s.join(",")) == "a,b,c"
  let one = ["a", "a", "b", "a"]
  let one_s = one.sort()
  expect(one.join(",")) == "a,a,b,a"
  expect(one_s.join(",")) == "a,a,a,b"
}

test "List.sort_by keeps equal keys in input order" {
  let xs = [("b", 1), ("a", 2), ("b", 3), ("a", 4), ("b", 5)]
  let got = xs.sort_by(fn(p) { p.0 })
  expect(got.map(fn(p) { "${p.0}${p.1}" }).join(",")) == "a2,a4,b1,b3,b5"
  let same = [("k", 3), ("k", 1), ("k", 2)]
  expect(same.sort_by(fn(p) { p.0 }).map(fn(p) { "${p.1}" }).join(",")) == "3,1,2"
}

test "List.sort_in_place orders every shape Go's sort.Strings orders" {
  var bad: List[(Str, Str, Str)] = []
  for (keys, want, shape) in SORT_STR_CASES {
    var xs = split_keys(keys)
    xs.sort_in_place()
    let got = xs.join("\u{1f}")
    if got != want {
      bad.push((shape, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "List.sort_in_place leaves a shared list alone and sorts its own binding" {
  var a = ["b", "c", "a"]
  let b = a
  a.sort_in_place()
  expect(a.join(",")) == "a,b,c"
  expect(b.join(",")) == "b,c,a"
  var unique = ["d", "b"]
  unique.sort_in_place()
  expect(unique.join(",")) == "b,d"
}

test "List.sort_in_place_by keeps equal keys in input order" {
  var xs = [("b", 1), ("a", 2), ("b", 3), ("a", 4), ("b", 5)]
  xs.sort_in_place_by(fn(p) { p.0 })
  expect(xs.map(fn(p) { "${p.0}${p.1}" }).join(",")) == "a2,a4,b1,b3,b5"
  var same = [("k", 3), ("k", 1), ("k", 2)]
  same.sort_in_place_by(fn(p) { p.0 })
  expect(same.map(fn(p) { "${p.1}" }).join(",")) == "3,1,2"
}

test "List.sort_in_place_by orders every shape Go's sort.Strings orders" {
  var bad: List[(Str, Str, Str)] = []
  for (keys, want, shape) in SORT_STR_CASES {
    var xs = split_keys(keys)
    xs.sort_in_place_by(fn(k) { k })
    let got = xs.join("\u{1f}")
    if got != want {
      bad.push((shape, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "List.sort orders keys that share a seven byte prefix" {
  var bad: List[(Str, Str, Str)] = []
  for (keys, want, shape) in SORT_PREFIX7_CASES {
    let got = split_keys(keys).sort().join("\u{1f}")
    if got != want {
      bad.push((shape, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "List.sort_by keeps equal keys in Go's sort.Stable order" {
  var bad: List[(Str, Str, Str)] = []
  for (keys, want, shape) in SORT_STABLE_CASES {
    let ks = split_keys(keys)
    var pairs: List[(Str, Int)] = []
    for i in 0..ks.len() {
      pairs.push((ks[i], i))
    }
    let got = pairs.sort_by(fn(p) { p.0 }).map(fn(p) { "${p.1}" }).join(",")
    if got != want {
      bad.push((shape, got, want))
    }
  }
  expect(show3(bad)) == []
}

/// The first 80 bytes of a range's text, since a thousand elements are not
/// a readable failure.
fn head80(s: Str) -> Str {
  s[0..(if s.len() < 80 { s.len() } else { 80 })]
}

test "Range.to_list is Go's slices.Collect over the range" {
  var bad: List[(Str, Str, Str)] = []
  for (lo, hi, inclusive, want, shape) in RANGE_CASES {
    let got = if inclusive { (lo..=hi).to_list() } else { (lo..hi).to_list() }
    let text = got.map(fn(n) { "${n}" }).join("\u{1f}")
    if text != want {
      bad.push((shape, head80(text), head80(want)))
    }
  }
  expect(show3(bad)) == []
}

test "Int64.try and UInt32.try are Go's range checks for the sized types" {
  var bad: List[(Str, Str, Str)] = []
  for (x, want, why) in TRY_I64_CASES {
    let got = match Int64.try(x) {
      Some(n) => "some ${n}"
      None => "none"
    }
    if got != want {
      bad.push((why, got, want))
    }
  }
  for (x, want, why) in TRY_U32_CASES {
    let got = match UInt32.try(x) {
      Some(n) => "some ${n}"
      None => "none"
    }
    if got != want {
      bad.push((why, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "Set.is_empty is false with elements, and true when there are none" {
  let some = ["a", "b", "a"].to_set()
  expect(some.len()) == 2
  expect(some.is_empty()) == false
  var s = ["a", "b"].to_set()
  expect(s.remove("a")) == true
  expect(s.is_empty()) == false
  expect(s.remove("b")) == true
  expect(s.is_empty()) == true
  expect(s.remove("b")) == false
  let none = ["x"].to_set().filter(fn(x) { false })
  expect(none.len()) == 0
  expect(none.is_empty()) == true
  var grown = none
  grown.add("y")
  expect(grown.is_empty()) == false
  expect(none.is_empty()) == true
}

fn stream_echo(s: Stream) -> () ! NetErr uses net {
  let got = s.read(64)?
  s.write(got ?? b"")?
  s.close()
}

fn stream_serve(l: Listener) -> () ! NetErr uses net {
  stream_echo(l.accept()?)
}

test "a dialed Conn and an accepted ServerConn read, write and close through Stream" {
  let l = os.net.listen("127.0.0.1:0")?
  let server = os.tasks.spawn(fn() ! NetErr { stream_serve(l) })
  let s: Stream = os.net.dial(l.addr())?
  s.write(b"hello stream")?
  expect(s.read(64)?) == Some(b"hello stream")
  s.close()
  let _ = server.await.ignore_err("the server ends when the connection closes")
  l.close()
}

test "create_dir_all_mode gives only the directories it makes the mode" {
  os.fs.create_dir_all("keep")?
  os.fs.set_mode("keep", 0o755)?
  create_dir_all_mode(os.fs, "keep/a/b", 0o700)?
  expect(os.fs.mode("keep")?) == 0o755
  expect(os.fs.mode("keep/a")?) == 0o700
  expect(os.fs.mode("keep/a/b")?) == 0o700
  create_dir_all_mode(os.fs, "keep/a", 0o750)?
  expect(os.fs.mode("keep/a")?) == 0o700
  create_dir_all_mode(os.fs, "top", 0o711)?
  expect(os.fs.mode("top")?) == 0o711
  os.fs.write("f.txt", b"x")?
  expect(create_dir_all_mode(os.fs, "f.txt/sub", 0o700).is_err()) == true
}

test "read_text_or and read_or answer the default only when the file is missing" {
  os.fs.write("present.txt", b"hello")?
  expect(read_text_or(os.fs, "present.txt", "none")?) == "hello"
  expect(read_or(os.fs, "present.txt", b"none")?) == b"hello"
  expect(read_text_or(os.fs, "missing.txt", "none")?) == "none"
  expect(read_or(os.fs, "missing.txt", b"none")?) == b"none"
  // an empty file is empty, not the default
  os.fs.write("empty.txt", b"")?
  expect(read_text_or(os.fs, "empty.txt", "none")?) == ""
  expect(read_or(os.fs, "empty.txt", b"none")?) == b""
  // an empty default is still a default
  expect(read_text_or(os.fs, "gone.txt", "")?) == ""
  expect(read_or(os.fs, "gone.txt", b"")?) == b""
}
