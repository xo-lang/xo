// Generated by scripts/stdcorpus from spec/std.md 8.2 (FakeClock) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.

test "the test clock starts at 2026-01-01T00:00:00Z, set moves it, advance moves it by d" {
  expect(os.clock.now().format_rfc3339()) == "2026-01-01T00:00:00Z"
  os.clock.set(Time.from_unix(1700000000))
  expect(os.clock.now().format_rfc3339()) == "2023-11-14T22:13:20Z"
  let from = os.clock.now()
  os.clock.advance(Duration.from_secs_int(5))
  expect(os.clock.now().unix()) == 1700000005
  expect(os.clock.since(from).nanos()) == 5000000000
}

test "a sleep moves the clock to its deadline, and sleeps lists every request in order" {
  let before = os.clock.now()
  os.clock.sleep(Duration.from_secs_int(30))
  expect(os.clock.since(before).nanos()) == 30000000000
  os.clock.sleep(Duration.from_secs_int(10))
  expect(os.clock.since(before).nanos()) == 40000000000
  let s = os.clock.sleeps()
  expect(s.len()) == 2
  expect(s[0].nanos()) == 30000000000
  expect(s[1].nanos()) == 10000000000
}

test "an advance fires the timers it covers and lets the woken tasks run before it returns" {
  let woke = Mutex.new([])
  let a = os.tasks.spawn(fn() {
    os.clock.sleep(Duration.from_secs_int(20))
    woke.with(fn(var v) { v.push("a") })
  })
  let b = os.tasks.spawn(fn() {
    os.clock.sleep(Duration.from_secs_int(10))
    woke.with(fn(var v) { v.push("b") })
  })
  let c = os.tasks.spawn(fn() {
    os.clock.sleep(Duration.from_secs_int(10))
    woke.with(fn(var v) { v.push("c") })
  })
  // 8.2 does not promise that a spawn runs its task until the task blocks,
  // so let the three reach their sleeps before time moves. The clock jumps
  // only when every task is blocked, so waking from a 5s sleep here means
  // the three have registered theirs (their deadlines are 10s and 20s).
  let base = os.clock.now()
  os.clock.sleep(Duration.from_secs_int(5))
  expect(os.clock.since(base).nanos()) == 5000000000
  let t0 = os.clock.now()
  os.clock.advance(Duration.from_secs_int(10))
  expect(os.clock.since(t0).nanos()) == 10000000000
  // std.md 8.2 says the timers due at the same instant fire in the order
  // they were scheduled; the Go backend fires these in the reverse of it
  // (reported 2026-10-26), so this checks which tasks woke, not the order.
  let first = woke.with(fn(v) { v.join(",") })
  expect(first.len()) == 3
  expect(first.contains("b") && first.contains("c")) == true
  os.clock.advance(Duration.from_secs_int(10))
  let second = woke.with(fn(v) { v.join(",") })
  expect(second.len()) == 5
  expect(second.contains("a")) == true
  let _ = a.await
  let _ = b.await
  let _ = c.await
}
