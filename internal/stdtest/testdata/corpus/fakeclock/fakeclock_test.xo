// Generated by scripts/stdcorpus from spec/std.md 8.2 (FakeClock) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.
use std/time

test "the test clock starts at 2026-01-01T00:00:00Z, set moves it, advance moves it by d" {
  expect(os.clock.now().format_rfc3339()) == "2026-01-01T00:00:00Z"
  os.clock.set(Time.from_unix(1700000000))
  expect(os.clock.now().format_rfc3339()) == "2023-11-14T22:13:20Z"
  let from = os.clock.now()
  os.clock.advance(Duration.from_secs_int(5))
  expect(os.clock.now().unix()) == 1700000005
  expect(os.clock.since(from).nanos()) == 5000000000
}

test "a ticker under the test clock ticks each period, and reset restarts it one new period from now" {
  let start = os.clock.now()
  let tk = time.ticker(os.clock, 50ms)
  let t1 = tk.wait()
  let t2 = tk.wait()
  expect((t1 - start).millis()) == 50
  expect((t2 - start).millis()) == 100
  // Go's Reset: the next tick one new period after the reset, not on the
  // old schedule
  os.clock.sleep(10ms)
  let r = tk.reset(20ms)
  let t3 = r.wait()
  let t4 = r.wait()
  expect((t3 - start).millis()) == 130
  expect((t4 - start).millis()) == 150
}

test "a sleep moves the clock to its deadline, and sleeps lists every request in order" {
  let before = os.clock.now()
  os.clock.sleep(Duration.from_secs_int(30))
  expect(os.clock.since(before).nanos()) == 30000000000
  os.clock.sleep(Duration.from_secs_int(10))
  expect(os.clock.since(before).nanos()) == 40000000000
  let s = os.clock.sleeps()
  expect(s.len()) == 2
  expect(s[0].nanos()) == 30000000000
  expect(s[1].nanos()) == 10000000000
}

test "an advance fires the timers it covers in scheduled order, and lets the woken tasks run before it returns" {
  let woke = Mutex.new([])
  let b = os.tasks.spawn(fn() {
    os.clock.sleep(Duration.from_secs_int(10))
    woke.with(fn(var v) { v.push("b") })
  })
  // b schedules its timer at the start and c schedules one at 5s, both due
  // at 10s, so "the order they were scheduled" is b then c whatever order
  // the scheduler starts the tasks in (8.2 promises no order for a spawn
  // until its task blocks). The clock jumps only when every task is
  // blocked, so each sleep below means the task before it has registered.
  let base = os.clock.now()
  os.clock.sleep(Duration.from_secs_int(5))
  expect(os.clock.since(base).nanos()) == 5000000000
  let c = os.tasks.spawn(fn() {
    os.clock.sleep(Duration.from_secs_int(5))
    woke.with(fn(var v) { v.push("c") })
  })
  os.clock.sleep(Duration.from_secs_int(1))
  let t0 = os.clock.now()
  os.clock.advance(Duration.from_secs_int(4))
  expect(os.clock.since(t0).nanos()) == 4000000000
  // the two timers due at 10s fired in the order they were scheduled (the
  // Go backend woke them in the reverse of it before 2026-10-26)
  let first = woke.with(fn(v) { v.join(",") })
  expect(first) == "b,c"
  // a timer beyond the advance's target does not fire until one covers it
  let d = os.tasks.spawn(fn() {
    os.clock.sleep(Duration.from_secs_int(20))
    woke.with(fn(var v) { v.push("d") })
  })
  let t1 = os.clock.now()
  os.clock.advance(Duration.from_secs_int(10))
  expect(os.clock.since(t1).nanos()) == 10000000000
  expect(woke.with(fn(v) { v.join(",") })) == "b,c"
  os.clock.advance(Duration.from_secs_int(10))
  expect(woke.with(fn(v) { v.join(",") })) == "b,c,d"
  let _ = b.await
  let _ = c.await
  let _ = d.await
}
