  ("-9223372036854775808", "ok -9223372036854775808", "ok -9.223372036854776e+18", "err strconv.ParseBool: parsing \"-9223372036854775808\": invalid syntax"),
  ("9223372036854775808", "err strconv.ParseInt: parsing \"9223372036854775808\": value out of range", "ok 9.223372036854776e+18", "err strconv.ParseBool: parsing \"9223372036854775808\": invalid syntax"),
  ("-9223372036854775809", "err strconv.ParseInt: parsing \"-9223372036854775809\": value out of range", "ok -9.223372036854776e+18", "err strconv.ParseBool: parsing \"-9223372036854775809\": invalid syntax"),
  ("99999999999999999999", "err strconv.ParseInt: parsing \"99999999999999999999\": value out of range", "ok 1e+20", "err strconv.ParseBool: parsing \"99999999999999999999\": invalid syntax"),
  ("123456789012345678", "ok 123456789012345678", "ok 1.2345678901234568e+17", "err strconv.ParseBool: parsing \"123456789012345678\": invalid syntax"),
  ("1e3", "err strconv.ParseInt: parsing \"1e3\": invalid syntax", "ok 1000", "err strconv.ParseBool: parsing \"1e3\": invalid syntax"),
  ("0.1", "err strconv.ParseInt: parsing \"0.1\": invalid syntax", "ok 0.1", "err strconv.ParseBool: parsing \"0.1\": invalid syntax"),
  (".5", "err strconv.ParseInt: parsing \".5\": invalid syntax", "ok 0.5", "err strconv.ParseBool: parsing \".5\": invalid syntax"),
  ("5.", "err strconv.ParseInt: parsing \"5.\": invalid syntax", "ok 5", "err strconv.ParseBool: parsing \"5.\": invalid syntax"),
  ("1e-400", "err strconv.ParseInt: parsing \"1e-400\": invalid syntax", "ok 0", "err strconv.ParseBool: parsing \"1e-400\": invalid syntax"),
  ("Inf", "err strconv.ParseInt: parsing \"Inf\": invalid syntax", "ok +Inf", "err strconv.ParseBool: parsing \"Inf\": invalid syntax"),
  ("NaN", "err strconv.ParseInt: parsing \"NaN\": invalid syntax", "ok NaN", "err strconv.ParseBool: parsing \"NaN\": invalid syntax"),
  ("infinity", "err strconv.ParseInt: parsing \"infinity\": invalid syntax", "ok +Inf", "err strconv.ParseBool: parsing \"infinity\": invalid syntax"),
  ("+Inf", "err strconv.ParseInt: parsing \"+Inf\": invalid syntax", "ok +Inf", "err strconv.ParseBool: parsing \"+Inf\": invalid syntax"),
  ("-Inf", "err strconv.ParseInt: parsing \"-Inf\": invalid syntax", "ok -Inf", "err strconv.ParseBool: parsing \"-Inf\": invalid syntax"),
  ("0x1p-2", "err strconv.ParseInt: parsing \"0x1p-2\": invalid syntax", "ok 0.25", "err strconv.ParseBool: parsing \"0x1p-2\": invalid syntax"),
  ("1,5", "err strconv.ParseInt: parsing \"1,5\": invalid syntax", "err strconv.ParseFloat: parsing \"1,5\": invalid syntax", "err strconv.ParseBool: parsing \"1,5\": invalid syntax"),
  ("1 000", "err strconv.ParseInt: parsing \"1 000\": invalid syntax", "err strconv.ParseFloat: parsing \"1 000\": invalid syntax", "err strconv.ParseBool: parsing \"1 000\": invalid syntax"),
  ("true", "err strconv.ParseInt: parsing \"true\": invalid syntax", "err strconv.ParseFloat: parsing \"true\": invalid syntax", "ok true"),
  ("TRUE", "err strconv.ParseInt: parsing \"TRUE\": invalid syntax", "err strconv.ParseFloat: parsing \"TRUE\": invalid syntax", "ok true"),
  (" True ", "err strconv.ParseInt: parsing \"True\": invalid syntax", "err strconv.ParseFloat: parsing \"True\": invalid syntax", "ok true"),
  ("t", "err strconv.ParseInt: parsing \"t\": invalid syntax", "err strconv.ParseFloat: parsing \"t\": invalid syntax", "ok true"),
  ("T", "err strconv.ParseInt: parsing \"T\": invalid syntax", "err strconv.ParseFloat: parsing \"T\": invalid syntax", "ok true"),
  ("1", "ok 1", "ok 1", "ok true"),
  ("0", "ok 0", "ok 0", "ok false"),
  ("yes", "err strconv.ParseInt: parsing \"yes\": invalid syntax", "err strconv.ParseFloat: parsing \"yes\": invalid syntax", "err strconv.ParseBool: parsing \"yes\": invalid syntax"),
  ("false", "err strconv.ParseInt: parsing \"false\": invalid syntax", "err strconv.ParseFloat: parsing \"false\": invalid syntax", "ok false"),
  ("F", "err strconv.ParseInt: parsing \"F\": invalid syntax", "err strconv.ParseFloat: parsing \"F\": invalid syntax", "ok false"),
  ("FALSE", "err strconv.ParseInt: parsing \"FALSE\": invalid syntax", "err strconv.ParseFloat: parsing \"FALSE\": invalid syntax", "ok false"),
  ("TRUEs", "err strconv.ParseInt: parsing \"TRUEs\": invalid syntax", "err strconv.ParseFloat: parsing \"TRUEs\": invalid syntax", "err strconv.ParseBool: parsing \"TRUEs\": invalid syntax"),
  ("2", "ok 2", "ok 2", "err strconv.ParseBool: parsing \"2\": invalid syntax"),
  (" 42 ", "ok 42", "ok 42", "err strconv.ParseBool: parsing \"42\": invalid syntax"),
  ("\r\n7\r\n", "ok 7", "ok 7", "err strconv.ParseBool: parsing \"7\": invalid syntax"),
  ("１２", "err strconv.ParseInt: parsing \"１２\": invalid syntax", "err strconv.ParseFloat: parsing \"１２\": invalid syntax", "err strconv.ParseBool: parsing \"１２\": invalid syntax"),
]

fn first_bad3[T](bad: List[T]) -> List[T] { bad[0..(if bad.len() < 20 { bad.len() } else { 20 })] }

fn err_text(e: xml.XmlErr) -> Str { "err ${e.line} ${e.msg}" }

fn show_opt(v: Str?) -> Str {
  match v {
    Some(s) => "some:${s}"
    None => "none"
  }
}

fn root_text(r: Result[xml.Element, xml.XmlErr]) -> Str {
  match r {
    Ok(e) => match e.encode(indent: "  ") {
      Ok(s) => "ok ${s}"
      Err(x) => err_text(x)
    }
    Err(x) => err_text(x)
  }
}

fn attr_report(e: xml.Element) -> Str {
  ["id", "class", "lang", "x"].map(fn(n) { "${n}=${show_opt(xmlcodec.attr_of(e, n))}" }).join(" ")
}

fn parse3(s: Str) -> Str {
  let i = match xmlcodec.int_of(s) {
    Ok(n) => "ok ${n}"
    Err(e) => "err ${e.msg}"
  }
  let f = match xmlcodec.float_of(s) {
    Ok(x) => "ok ${xmlcodec.float_text(x)}"
    Err(e) => "err ${e.msg}"
  }
  let b = match xmlcodec.bool_of(s) {
    Ok(v) => "ok ${v}"
    Err(e) => "err ${e.msg}"
  }
  "i=${i} f=${f} b=${b}"
}

fn nm(n: xml.Name) -> Str { "${n.space}:${n.local}" }

fn tok_text(t: xml.Token) -> Str {
  match t {
    xml.Token.Start(name, attrs) => "S(${nm(name)}[${attrs.map(fn(a) { "${nm(a.name)}=${a.value}" }).join(",")}])"
    xml.Token.End(name) => "E(${nm(name)})"
    xml.Token.Text(s) => "T(${s})"
    xml.Token.Comment(s) => "C(${s})"
    xml.Token.ProcInst(target, inst) => "P(${target},${inst})"
    xml.Token.Directive(s) => "D(${s})"
  }
}

fn built_text(e: xml.Element) -> Str {
  match e.encode() {
    Ok(s) => match xml.tokens(s) {
      Ok(ts) => ts.map(tok_text).join(" ")
      Err(x) => err_text(x)
    }
    Err(x) => err_text(x)
  }
}

test "parse_root, attr_of and direct_text are Go's" {
  var bad: List[(Str, Str, Str)] = []
  for (doc, want_root, _attrs, _direct, _parsed) in ROOT_DOCS {
    let r = xmlcodec.parse_root(doc)
    let got = root_text(r)
    if got != want_root {
      bad.push((doc, got, want_root))
      continue
    }
    match r {
      Ok(e) => {
        let got2 = attr_report(e)
        if got2 != _attrs {
          bad.push((doc, got2, _attrs))
        }
        let got3 = xmlcodec.direct_text(e)
        if got3 != _direct {
          bad.push((doc, got3, _direct))
        }
      }
      Err(..) => {}
    }
  }
  expect(first_bad3(bad)) == []
}

test "the text in numbers and booleans is read as Go's strconv does" {
  var bad: List[(Str, Str, Str)] = []
  for (doc, _want_root, _attrs, _direct, want) in ROOT_DOCS {
    match xmlcodec.parse_root(doc) {
      Ok(e) => {
        let got = parse3(xmlcodec.direct_text(e))
        if got != want {
          bad.push((doc, got, want))
        }
      }
      Err(..) => {
        if want != "" {
          bad.push((doc, "err", want))
        }
      }
    }
  }
  expect(first_bad3(bad)) == []
}

test "build with open_path, leaf, chardata and comment is Go's printer" {
  var bad: List[(Str, Str, Str)] = []
  for (name, attrs, pieces, want) in PIECE_ROWS {
    let got = built_text(xmlcodec.build(name, attrs, pieces))
    if got != want {
      bad.push((name, got, want))
    }
  }
  expect(first_bad3(bad)) == []
}

test "float_text is Go's FormatFloat 'g' -1 64" {
  var bad: List[(Str, Str, Str)] = []
  for (f, want) in FLOAT_TEXTS {
    let got = xmlcodec.float_text(f)
    if got != want {
      bad.push(("${f}", got, want))
    }
  }
  expect(first_bad3(bad)) == []
}

test "int_of, float_of and bool_of are Go's strconv" {
  var bad: List[(Str, Str, Str)] = []
  for (s, want_i, want_f, want_b) in PARSE_TEXTS {
    let i = match xmlcodec.int_of(s) {
      Ok(n) => "ok ${n}"
      Err(e) => "err ${e.msg}"
    }
    if i != want_i {
      bad.push((s, "int " + i, want_i))
    }
    let f = match xmlcodec.float_of(s) {
      Ok(x) => "ok ${xmlcodec.float_text(x)}"
      Err(e) => "err ${e.msg}"
    }
    if f != want_f {
      bad.push((s, "float " + f, want_f))
    }
    let b = match xmlcodec.bool_of(s) {
      Ok(v) => "ok ${v}"
      Err(e) => "err ${e.msg}"
    }
    if b != want_b {
      bad.push((s, "bool " + b, want_b))
    }
  }
  expect(first_bad3(bad)) == []
}
