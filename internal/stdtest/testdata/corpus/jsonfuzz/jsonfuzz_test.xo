struct JfFields {
  when: Time?
  data: Bytes?
  dur: Duration?
} derive Json

fn jf_fields(raw: Bytes) -> Str {
  match json.decode[JfFields](raw) {
    Ok(r) => {
      let w = match r.when {
        Some(t) => "${t.unix_nanos()}"
        None => "none"
      }
      let d = match r.data {
        Some(b) => b.to_hex()
        None => "none"
      }
      let u = match r.dur {
        Some(x) => "${x.nanos()}"
        None => "none"
      }
      "when=${w}|data=${d}|dur=${u}"
    }
    Err(_) => "err"
  }
}

test "json fields 0" {
  expect(jf_fields(b"{\x22dur\x22:\x229223372036854775807ns\x22,\x22when\x22:null}")) == "when=none|data=none|dur=9223372036854775807"
}

