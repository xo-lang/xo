  match json.decode[JfRec](raw) {
    Ok(r) => {
      let b = match r.b {
        Some(f) => "${f.to_bits()}"
        None => "none"
      }
      "a=${jf_oi(r.a)}|b=${b}|s=${r.s ?? "none"}"
    }
    Err(_) => "err"
  }
}

fn jf_one(raw: Bytes) -> Str {
  match json.decode[JfOne](raw) {
    Ok(r) => "a=${jf_oi(r.a)}"
    Err(_) => "err"
  }
}

fn jf_map(raw: Bytes) -> Str {
  match json.decode[Map[Str, Int]](raw) {
    Ok(m) => {
      var parts: List[Str] = []
      for (k, v) in m {
        parts.push("${k}=${v}")
      }
      parts.sort().join(",")
    }
    Err(_) => "err"
  }
}

test "json typed 0" {
  let raw = b"{\x22a\x22: 1, \x22a\x22: 2}"
  expect(jf_rec(raw)) == "a=2|b=none|s=none"
  expect(jf_one(raw)) == "a=2"
  expect(jf_map(raw)) == "a=2"
}

