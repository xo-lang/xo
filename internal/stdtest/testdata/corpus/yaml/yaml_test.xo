  ("&flowseq [\n a: b,\n &c c: d,\n { &e e: f },\n &g { g: h }\n]\n", "OK [{\"a\":\"b\"},{\"c\":\"d\"},{\"e\":\"f\"},{\"g\":\"h\"}]"),
  ("a: \"double\n  quotes\" # lala\nb: plain\n value  # lala\nc  : #lala\n  d\n? # lala\n - seq1\n: # lala\n - #lala\n  seq2\ne: &node # lala\n - x: y\nblock: > # lala\n  abcde\n", "ERR"),
  ("a: \"double\n  quotes\" # lala\nb: plain\n value  # lala\nc  : #lala\n  d\n? # lala\n - seq1\n: # lala\n - #lala\n  seq2\ne:\n &node # lala\n - x: y\nblock: > # lala\n  abcde\n", "ERR"),
  ("a: b\t\nseq:\t\n - a\t\nc: d\t#X\n", "OK {\"a\":\"b\",\"c\":\"d\",\"seq\":[\"a\"]}"),
  ("- [a, b , c ]\n- { \"a\"  : b\n   , c : 'd' ,\n   e   : \"f\"\n  }\n- [      ]\n", "OK [[\"a\",\"b\",\"c\"],{\"a\":\"b\",\"c\":\"d\",\"e\":\"f\"},[]]"),
  ("\"top1\" : \n  \"key1\" : &alias1 scalar1\n'top2' : \n  'key2' : &alias2 scalar2\ntop3: &node3 \n  *alias1 : scalar3\ntop4: \n  *alias2 : scalar4\ntop5   :    \n  scalar5\ntop6: \n  &anchor6 'key6' : scalar6\n", "OK {\"top1\":{\"key1\":\"scalar1\"},\"top2\":{\"key2\":\"scalar2\"},\"top3\":{\"scalar1\":\"scalar3\"},\"top4\":{\"scalar2\":\"scalar4\"},\"top5\":\"scalar5\",\"top6\":{\"key6\":\"scalar6\"}}"),
  ("key:\n  ok: 1\n wrong: 2\n", "ERR"),
  ("k1: v1\n k2: v2\n", "ERR"),
  ("key:\n   - ok\n   - also ok\n  - wrong\n", "ERR"),
