  ("---\n{ top1: [item1, {key2: value2}, item3], top2: value2 }\n", "OK {\"top1\":[\"item1\",{\"key2\":\"value2\"},\"item3\"],\"top2\":\"value2\"}"),
  ("---\n[\n  [ a, [ [[b,c]]: d, e]]: 23\n]\n", "ERR"),
  ("{ key: [[[\n  value\n ]]]\n}\n", "OK {\"key\":[[[\"value\"]]]}"),
