  ("# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up and away!\",\n  -123,\n  http://example.com/foo#bar ]\n", "ERR"),
  ("implicit block key : [\n  implicit flow key : value,\n ]\n", "OK {\"implicit block key\":[{\"implicit flow key\":\"value\"}]}"),
  ("1st non-empty\n\n 2nd non-empty \n\t3rd non-empty\n", "OK \"1st non-empty\\n2nd non-empty 3rd non-empty\""),
  ("- [ one, two, ]\n- [three ,four]\n", "OK [[\"one\",\"two\"],[\"three\",\"four\"]]"),
  ("[\n\"double\n quoted\", 'single\n           quoted',\nplain\n text, [ nested ],\nsingle: pair,\n]\n", "OK [\"double quoted\",\"single quoted\",\"plain text\",[\"nested\"],{\"single\":\"pair\"}]"),
  ("- { one : two , three: four , }\n- {five: six,seven : eight}\n", "OK [{\"one\":\"two\",\"three\":\"four\"},{\"five\":\"six\",\"seven\":\"eight\"}]"),
  ("{\n? explicit: entry,\nimplicit: entry,\n?\n}\n", "SKIP"),
  ("{\n\"adjacent\":value,\n\"readable\": value,\n\"empty\":\n}\n", "OK {\"adjacent\":\"value\",\"empty\":null,\"readable\":\"value\"}"),
  ("[\nfoo: bar\n]\n", "OK [{\"foo\":\"bar\"}]"),
  ("{\n  foo : !!str,\n  !!str : bar,\n}\n", "ERR"),
  ("[\n? foo\n bar : baz\n]\n", "OK [{\"foo bar\":\"baz\"}]"),
  ("- [ a, b ]\n- { a: b }\n- \"a\"\n- 'b'\n- c\n", "OK [[\"a\",\"b\"],{\"a\":\"b\"},\"a\",\"b\",\"c\"]"),
  ("- !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str\n", "OK [\"a\",\"b\",\"c\",\"c\",\"\"]"),
  ("{\n  ? foo :,\n  : bar,\n}\n", "ERR"),
  ("\"implicit block key\" : [\n  \"implicit flow key\" : value,\n ]\n", "OK {\"implicit block key\":[{\"implicit flow key\":\"value\"}]}"),
  ("---\n\"folded \nto a space,\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", "OK \"folded to a space,\\nto a line feed, or \\t \\tnon-content\""),
  ("\"folded \nto a space,\t\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", "OK \"folded to a space,\\nto a line feed, or \\t \\tnon-content\""),
  ("---\n\" 1st non-empty\n\n 2nd non-empty \n 3rd non-empty \"\n", "OK \" 1st non-empty\\n2nd non-empty 3rd non-empty \""),
  ("\" 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty \"\n", "OK \" 1st non-empty\\n2nd non-empty 3rd non-empty \""),
  ("---\n'here''s to \"quotes\"'\n", "OK \"here's to \\\"quotes\\\"\""),
  ("'here''s to \"quotes\"'\n", "OK \"here's to \\\"quotes\\\"\""),
  ("'implicit block key' : [\n  'implicit flow key' : value,\n ]\n", "OK {\"implicit block key\":[{\"implicit flow key\":\"value\"}]}"),
  ("---\n' 1st non-empty\n\n 2nd non-empty \n 3rd non-empty '\n", "OK \" 1st non-empty\\n2nd non-empty 3rd non-empty \""),
  ("' 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty '\n", "OK \" 1st non-empty\\n2nd non-empty 3rd non-empty \""),
  ("- | # Empty header↓\n literal\n- >1 # Indentation indicator↓\n  folded\n- |+ # Chomping indicator↓\n keep\n\n- >1- # Both indicators↓\n  strip\n", "OK [\"literal\\n\",\" folded\\n\",\"keep\\n\\n\",\" strip\"]"),
  (">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n", "OK \"\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\""),
  ("block sequence:\n  - one\n  - two : three\n", "OK {\"block sequence\":[\"one\",{\"two\":\"three\"}]}"),
  ("- # Empty\n- |\n block node\n- - one # Compact\n  - two # sequence\n- one: two # Compact mapping\n", "OK [null,\"block node\\n\",[\"one\",\"two\"],{\"one\":\"two\"}]"),
  ("block mapping:\n key: value\n", "OK {\"block mapping\":{\"key\":\"value\"}}"),
  ("? explicit key # Empty value\n? |\n  block key\n: - one # Explicit compact\n  - two # block value\n", "OK {\"block key\\n\":[\"one\",\"two\"],\"explicit key\":null}"),
  ("plain key: in-line value\n: # Both empty\n\"quoted key\":\n- entry\n", "ERR"),
  ("- sun: yellow\n- ? earth: blue\n  : moon: white\n", "ERR"),
  ("- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n detected\n", "OK [\"detected\\n\",\"\\n\\n# detected\\n\",\" explicit\\n\",\"detected\\n\"]"),
  ("- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n", "ERR"),
  ("-\n  \"flow in block\"\n- >\n Block scalar\n- !!map # Block collection\n  foo : bar\n", "OK [\"flow in block\",\"Block scalar\\n\",{\"foo\":\"bar\"}]"),
  ("literal: |2\n  value\nfolded: !foo >1\n value\n", "OK {\"folded\":\"value\\n\",\"literal\":\"value\\n\"}"),
  ("literal: |2\n  value\nfolded:\n   !foo\n  >1\n value\n", "OK {\"folded\":\"value\\n\",\"literal\":\"value\\n\"}"),
  ("sequence: !!seq\n- entry\n- !!seq\n - nested\nmapping: !!map\n foo: bar\n", "OK {\"mapping\":{\"foo\":\"bar\"},\"sequence\":[\"entry\",[\"nested\"]]}"),
  ("strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n", "OK {\"clip\":\"text\\n\",\"keep\":\"text\\n\",\"strip\":\"text\"}"),
  (" # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n", "OK {\"clip\":\"# text\\n\",\"keep\":\"# text\\n\\n\",\"strip\":\"# text\"}"),
  ("strip: >-\n\nclip: >\n\nkeep: |+\n\n", "OK {\"clip\":\"\",\"keep\":\"\\n\",\"strip\":\"\"}"),
  ("--- |\n literal\n \ttext\n\n\n", "OK \"literal\\n\\ttext\\n\""),
  ("|\n literal\n \ttext\n\n\n", "OK \"literal\\n\\ttext\\n\""),
  ("--- |\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "OK \"\\n\\nliteral\\n \\n\\ntext\\n\""),
  ("|\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "OK \"\\n\\nliteral\\n \\n\\ntext\\n\""),
  ("--- >\n folded\n text\n\n\n", "OK \"folded text\\n\""),
  (">\n folded\n text\n\n\n", "OK \"folded text\\n\""),
  ("%YAML 1.2\n---\nDocument\n... # Suffix\n", "ERR"),
  ("Bare\ndocument\n...\n# No document\n...\n|\n%!PS-Adobe-2.0 # Not the first line\n", "OK \"Bare document\""),
  ("---\n{ matches\n% : 20 }\n...\n---\n# Empty\n...\n", "ERR"),
  ("%YAML 1.2\n--- |\n%!PS-Adobe-2.0\n...\n%YAML 1.2\n---\n# Empty\n...\n", "ERR"),
  ("Mapping: Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", "OK {\"Mapping\":\"Document\"}"),
  ("Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", "OK \"Document\""),
  ("---\tscalar\n", "OK \"scalar\""),
  ("\t{}\n", "ERR"),
  ("\t[\n\t]\n", "ERR"),
  ("%TAG !prefix! tag:example.com,2011:\n--- !prefix!A\na: b\n--- !prefix!B\nc: d\n--- !prefix!C\ne: f\n", "OK {\"a\":\"b\"}"),
  ("foo: !!seq\n  - !!str a\n  - !!map\n    key: !!str value\n", "OK {\"foo\":[\"a\",{\"key\":\"value\"}]}"),
  ("!!map {\n  k: !!seq\n  [ a, !!str b]\n}\n", "OK {\"k\":[\"a\",\"b\"]}"),
  ("--- !!map\n? a\n: b\n--- !!seq\n- !!str c\n--- !!str\nd\ne\n", "OK {\"a\":\"b\"}"),
  (" - !!str a\n - b\n - !!int 42\n - d\n", "OK [\"a\",\"b\",42,\"d\"]"),
  ("? !!str a\n: !!int 47\n? c\n: !!str d\n", "OK {\"a\":47,\"c\":\"d\"}"),
  ("!!str a: b\nc: !!int 42\ne: !!str f\ng: h\n!!str 23: !!bool false\n", "OK {\"23\":false,\"a\":\"b\",\"c\":42,\"e\":\"f\",\"g\":\"h\"}"),
  ("- !!str\n-\n  !!null : a\n  b: !!str\n- !!str : !!null\n", "SKIP"),
  ("---\n---word1\nword2\n", "OK \"---word1 word2\""),
  ("---word1\nword2\n", "OK \"---word1 word2\""),
  ("---\n- !!int 1\n- !!int -2\n- !!int 33\n", "OK [1,-2,33]"),
  ("---\nplain: a\n       b # end of scalar\n       c\n", "ERR"),
  ("key1: \"quoted1\"\nkey2: \"quoted2\" trailing content\nkey3: \"quoted3\"\n", "ERR"),
  ("key1: \"quoted1\"\nkey2: \"quoted2\" no key: nor value\nkey3: \"quoted3\"\n", "ERR"),
  ("  [1, 2, 3]  \n  ", "OK [1,2,3]"),
  ("---\n---\n", "OK null"),
  ("--- foo  # comment\n--- foo  # comment\n", "OK \"foo\""),
  ("complex1:\n  ? - a\ncomplex2:\n  ? - a\n  : b\ncomplex3:\n  ? - a\n  : >\n    b\ncomplex4:\n  ? >\n    a\n  :\ncomplex5:\n  ? - a\n  : - b\n", "ERR"),
