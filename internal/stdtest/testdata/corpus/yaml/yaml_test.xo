  ("---\na: >2\n   more indented\n  regular\nb: >2\n\n\n   more indented\n  regular\n", "OK {\"a\":\" more indented\\nregular\\n\",\"b\":\"\\n\\n more indented\\nregular\\n\"}"),
  ("a:\n  b:\n    c: d\n  e:\n    f: g\nh: i\n", "OK {\"a\":{\"b\":{\"c\":\"d\"},\"e\":{\"f\":\"g\"}},\"h\":\"i\"}"),
