  ("d: &d [ &c [ &b [ &a [x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b ], *c, *c, *c, *c, *c, *c, *c, *c, *c ]\n", "ERR \"yaml: document contains excessive aliasing\""),
  ("d: [ [ &b [ &a [x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b ] ]\n", "leaves=900"),
  ("d: [[[ &a [x, x, x, x, x, x, x, x, x, x, x, x] ]]]\n", "leaves=12"),
  ("d: &d [ &c [ &b [ &a [x, x, x, x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b ], *c, *c, *c, *c, *c, *c, *c, *c, *c, *c, *c, *c ]\n", "ERR \"yaml: document contains excessive aliasing\""),
  ("d: [ [ &b [ &a [x, x, x, x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b ] ]\n", "leaves=2028"),
  ("d: &a [*a]\n", "ERR \"yaml: anchor 'a' value contains itself\""),
  ("d: [&a [[*a]]]\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!seq into string\""),
  ("d: [[[ [x] ]]]\nm: &a {z: *a}\n", "leaves=1"),
  ("d: *a\n", "ERR \"yaml: unknown anchor 'a' referenced\""),
  ("x: &a [y]\nd: [[[*a, *a]], [[*a]]]\n", "leaves=3"),
]

const MARSHALED: Str = "name: orders\napiVersion: v1\nport: 8080\nratio: 2.5\n\"on\": true\no: hi\nnone: null\nitems:\n    - \"n\": 1\n      tags:\n        - a\n        - b c\n    - \"n\": 2\n      tags: []\nm:\n    a: 3\n    b9: 2\n    b10: 1\nempty: []\ntext: |\n    l1\n    l2\n\"yes\": \"yes\"\nnum: \"123\"\ninner:\n    \"n\": 7\n    tags:\n        - 'x: y'\n        - '- z'\n        - \"\"\n"

const MARSHALED2: Str = "name: orders\napiVersion: v1\nport: 8080\nratio: 2.5\n\"on\": true\no: hi\nnone: null\nitems:\n  - \"n\": 1\n    tags:\n      - a\n      - b c\n  - \"n\": 2\n    tags: []\nm:\n  a: 3\n  b9: 2\n  b10: 1\nempty: []\ntext: |\n  l1\n  l2\n\"yes\": \"yes\"\nnum: \"123\"\ninner:\n  \"n\": 7\n  tags:\n    - 'x: y'\n    - '- z'\n    - \"\"\n"

const MARSHALED_OPTS: Str = "d: [1, 2]\ne: {a: 2, z: 1}\nf: {x: 1, \"y\": 2}\ng: [p, q r]\ni: [{x: 3, \"y\": 4}]\nj: \"l1\\nl2\"\nm:\n    - 5\na: s\nb: 2\nc:\n    - 1\nd: []\ne: {}\nf: {x: 0, \"y\": 0}\nh: \"\"\ni: []\nj: x\nk: true\nl: 1.5\nm: []\n"

test "decode into a struct that derives Yaml is yaml.v3's Unmarshal, errors included" {
  for (text, want) in CASES {
    expect(show(text)) == want
  }
}

test "alias expansion is limited as yaml.v3 limits it" {
  for (text, want) in DEEP {
    expect(show_deep(text)) == want
  }
}

test "encode_value is yaml.v3's Marshal" {
  let c = Cfg{name: "orders", api_version: "v1", port: 8080, ratio: 2.5, on: true, o: Some("hi"), none: None, items: [Item{n: 1, tags: ["a", "b c"]}, Item{n: 2, tags: []}], m: {"b10": 1, "b9": 2, "a": 3}, empty: [], text: "l1\nl2\n", yes: "yes", num: "123", inner: Item{n: 7, tags: ["x: y", "- z", ""]}}
  expect(yaml.encode_value[Cfg](c).ok()) == Some(MARSHALED)
  expect(yaml.encode_value[Cfg](c, 2).ok()) == Some(MARSHALED2)
}

test "encode_value honors omitempty and flow as yaml.v3 does" {
  let a = Opts{a: "", b: 0, c: [], d: [1, 2], e: {"z": 1, "a": 2}, f: P{x: 1, y: 2}, g: ["p", "q r"], h: None, i: [P{x: 3, y: 4}], j: "l1\nl2", k: false, l: 0.0, m: [5]}
  let b = Opts{a: "s", b: 2, c: [1], d: [], e: {}, f: P{x: 0, y: 0}, g: [], h: Some(""), i: [], j: "x", k: true, l: 1.5, m: []}
  expect((yaml.encode_value[Opts](a).ok() ?? "") + (yaml.encode_value[Opts](b).ok() ?? "")) == MARSHALED_OPTS
}
