  ("unicode: \"Sosa did fine.\\u263A\"\ncontrol: \"\\b1998\\t1999\\t2000\\n\"\nhex esc: \"\\x0d\\x0a is \\r\\n\"\n\nsingle: '\"Howdy!\" he cried.'\nquoted: ' # Not a ''comment''.'\ntie-fighter: '|\\-*-/|'\n", "OK unicode: \"Sosa did fine.☺\"\ncontrol: \"\\b1998\\t1999\\t2000\\n\"\nhex esc: \"\\r\\n is \\r\\n\"\nsingle: '\"Howdy!\" he cried.'\nquoted: ' # Not a ''comment''.'\ntie-fighter: '|\\-*-/|'\n"),
  ("plain:\n  This unquoted scalar\n  spans many lines.\n\nquoted: \"So does this\n  quoted scalar.\\n\"\n", "OK plain: This unquoted scalar spans many lines.\nquoted: \"So does this quoted scalar.\\n\"\n"),
  ("hr:  65    # Home runs\navg: 0.278 # Batting average\nrbi: 147   # Runs Batted In\n", "OK hr: 65 # Home runs\navg: 0.278 # Batting average\nrbi: 147 # Runs Batted In\n"),
  ("%TAG ! tag:clarkevans.com,2002:\n--- !shape\n  # Use the ! handle for presenting\n  # tag:clarkevans.com,2002:circle\n- !circle\n  center: &ORIGIN {x: 73, y: 129}\n  radius: 7\n- !line\n  start: *ORIGIN\n  finish: { x: 89, y: 102 }\n- !label\n  start: *ORIGIN\n  color: 0xFFEEBB\n  text: Pretty vector drawing.\n", "OK !<tag:clarkevans.com,2002:shape>\n- !<tag:clarkevans.com,2002:circle>\n  # Use the ! handle for presenting\n  # tag:clarkevans.com,2002:circle\n  center: &ORIGIN {x: 73, y: 129}\n  radius: 7\n- !<tag:clarkevans.com,2002:line>\n  start: *ORIGIN\n  finish: {x: 89, y: 102}\n- !<tag:clarkevans.com,2002:label>\n  start: *ORIGIN\n  color: 0xFFEEBB\n  text: Pretty vector drawing.\n"),
  ("# Sets are represented as a\n# Mapping where each key is\n# associated with a null value\n--- !!set\n? Mark McGwire\n? Sammy Sosa\n? Ken Griff\n", "OK !!set\n# Sets are represented as a\n# Mapping where each key is\n# associated with a null value\nMark McGwire:\nSammy Sosa:\nKen Griff:\n"),
  ("# The !!omap tag is one of the optional types\n# introduced for YAML 1.1. In 1.2, it is not\n# part of the standard tags and should not be\n# enabled by default.\n# Ordered maps are represented as\n# A sequence of mappings, with\n# each mapping having one key\n--- !!omap\n- Mark McGwire: 65\n- Sammy Sosa: 63\n- Ken Griffy: 58\n", "OK !!omap\n# The !!omap tag is one of the optional types\n# introduced for YAML 1.1. In 1.2, it is not\n# part of the standard tags and should not be\n# enabled by default.\n# Ordered maps are represented as\n# A sequence of mappings, with\n# each mapping having one key\n- Mark McGwire: 65\n- Sammy Sosa: 63\n- Ken Griffy: 58\n"),
  ("--- !<tag:clarkevans.com,2002:invoice>\ninvoice: 34843\ndate   : 2001-01-23\nbill-to: &id001\n    given  : Chris\n    family : Dumars\n    address:\n        lines: |\n            458 Walkman Dr.\n            Suite #292\n        city    : Royal Oak\n        state   : MI\n        postal  : 48046\nship-to: *id001\nproduct:\n    - sku         : BL394D\n      quantity    : 4\n      description : Basketball\n      price       : 450.00\n    - sku         : BL4438H\n      quantity    : 1\n      description : Super Hoop\n      price       : 2392.00\ntax  : 251.42\ntotal: 4443.52\ncomments:\n    Late afternoon is best.\n    Backup contact is Nancy\n    Billsmer @ 338-4338.\n", "OK !<tag:clarkevans.com,2002:invoice>\ninvoice: 34843\ndate: 2001-01-23\nbill-to: &id001\n    given: Chris\n    family: Dumars\n    address:\n        lines: |\n            458 Walkman Dr.\n            Suite #292\n        city: Royal Oak\n        state: MI\n        postal: 48046\nship-to: *id001\nproduct:\n    - sku: BL394D\n      quantity: 4\n      description: Basketball\n      price: 450.00\n    - sku: BL4438H\n      quantity: 1\n      description: Super Hoop\n      price: 2392.00\ntax: 251.42\ntotal: 4443.52\ncomments: Late afternoon is best. Backup contact is Nancy Billsmer @ 338-4338.\n"),
  ("---\nTime: 2001-11-23 15:01:42 -5\nUser: ed\nWarning:\n  This is an error message\n  for the log file\n---\nTime: 2001-11-23 15:02:31 -5\nUser: ed\nWarning:\n  A slightly different error\n  message.\n---\nDate: 2001-11-23 15:03:17 -5\nUser: ed\nFatal:\n  Unknown variable \"bar\"\nStack:\n  - file: TopClass.py\n    line: 23\n    code: |\n      x = MoreObject(\"345\\n\")\n  - file: MoreClass.py\n    line: 58\n    code: |-\n      foo = bar\n", "OK Time: 2001-11-23 15:01:42 -5\nUser: ed\nWarning: This is an error message for the log file\n"),
  ("american:\n  - Boston Red Sox\n  - Detroit Tigers\n  - New York Yankees\nnational:\n  - New York Mets\n  - Chicago Cubs\n  - Atlanta Braves\n", "OK american:\n    - Boston Red Sox\n    - Detroit Tigers\n    - New York Yankees\nnational:\n    - New York Mets\n    - Chicago Cubs\n    - Atlanta Braves\n"),
  ("-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n", "OK - name: Mark McGwire\n  hr: 65\n  avg: 0.278\n- name: Sammy Sosa\n  hr: 63\n  avg: 0.288\n"),
  ("- [name        , hr, avg  ]\n- [Mark McGwire, 65, 0.278]\n- [Sammy Sosa  , 63, 0.288]\n", "OK - [name, hr, avg]\n- [Mark McGwire, 65, 0.278]\n- [Sammy Sosa, 63, 0.288]\n"),
  ("Mark McGwire: {hr: 65, avg: 0.278}\nSammy Sosa: {\n    hr: 63,\n    avg: 0.288\n  }\n", "OK Mark McGwire: {hr: 65, avg: 0.278}\nSammy Sosa: {hr: 63, avg: 0.288}\n"),
  ("# Ranking of 1998 home runs\n---\n- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n\n# Team ranking\n---\n- Chicago Cubs\n- St Louis Cardinals\n", "OK # Ranking of 1998 home runs\n- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n\n# Team ranking\n"),
  ("---\ntime: 20:03:20\nplayer: Sammy Sosa\naction: strike (miss)\n...\n---\ntime: 20:03:47\nplayer: Sammy Sosa\naction: grand slam\n...\n", "OK time: 20:03:20\nplayer: Sammy Sosa\naction: strike (miss)\n"),
  ("---\nhr: # 1998 hr ranking\n  - Mark McGwire\n  - Sammy Sosa\nrbi:\n  # 1998 rbi ranking\n  - Sammy Sosa\n  - Ken Griffey\n", "OK hr: # 1998 hr ranking\n    - Mark McGwire\n    - Sammy Sosa\nrbi:\n    # 1998 rbi ranking\n    - Sammy Sosa\n    - Ken Griffey\n"),
  ("# Tabs and spaces\nquoted: \"Quoted \t\"\nblock:\t|\n  void main() {\n  \tprintf(\"Hello, world!\\n\");\n  }\n", "OK # Tabs and spaces\nquoted: \"Quoted \\t\"\nblock: |\n    void main() {\n    \tprintf(\"Hello, world!\\n\");\n    }\n"),
  ("sequence:\n- one\n- two\nmapping:\n  ? sky\n  : blue\n  sea : green\n", "OK sequence:\n    - one\n    - two\nmapping:\n    sky: blue\n    sea: green\n"),
  ("sequence: [ one, two, ]\nmapping: { sky: blue, sea: green }\n", "OK sequence: [one, two]\nmapping: {sky: blue, sea: green}\n"),
  ("# Comment only.\n", "SKIP"),
  ("anchored: !local &anchor value\nalias: *anchor\n", "OK anchored: &anchor !local value\nalias: *anchor\n"),
  ("literal: |\n  some\n  text\nfolded: >\n  some\n  text\n", "OK literal: |\n    some\n    text\nfolded: >\n    some text\n\n"),
  ("single: 'text'\ndouble: \"text\"\n", "OK single: 'text'\ndouble: \"text\"\n"),
  ("%YAML 1.2\n--- text\n", "ERR \"yaml: found incompatible YAML document\""),
  ("  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.\n", "OK # Leading comment line spaces are\n# neither content nor indentation.\n\nNot indented:\n    By one space: |\n        By four\n          spaces\n    Flow style: [By two, # in flow style\n        Also by two, # are neither\n        Still by two, # content nor\n    ] # indentation.\n"),
  ("  # Comment\n   \n\n\n", "SKIP"),
  ("key:    # Comment\n        # lines\n  value\n\n\n", "OK key: value # Comment\n# lines\n"),
  ("{ first: Sammy, last: Sosa }:\n# Statistics:\n  hr:  # Home runs\n     65\n  avg: # Average\n   0.278\n", "OK ? {first: Sammy, last: Sosa}\n:   # Statistics:\n    hr: 65 # Home runs\n    avg: 0.278 # Average\n"),
  ("%FOO  bar baz # Should be ignored\n              # with a warning.\n---\n\"foo\"\n", "ERR \"yaml: found unknown directive name\""),
  ("%FOO  bar baz # Should be ignored\n              # with a warning.\n--- \"foo\"\n", "ERR \"yaml: found unknown directive name\""),
  ("%YAML 1.3 # Attempt parsing\n          # with a warning\n---\n\"foo\"\n", "ERR \"yaml: found incompatible YAML document\""),
  ("%TAG !yaml! tag:yaml.org,2002:\n---\n!yaml!str \"foo\"\n", "OK !!str \"foo\"\n"),
  ("# Private\n---\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n", "OK # Private\n!foo \"bar\"\n"),
  ("# Private\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n", "OK # Private\n!foo \"bar\"\n"),
  ("%TAG !! tag:example.com,2000:app/\n---\n!!int 1 - 3 # Interval, not integer\n", "OK !<tag:example.com,2000:app/int> 1 - 3 # Interval, not integer\n"),
  ("? a\n: -\tb\n  -  -\tc\n     - d\n", "ERR \"yaml: line 2: found character that cannot start any token\""),
  ("%TAG !e! tag:example.com,2000:app/\n---\n!e!foo \"bar\"\n", "OK !<tag:example.com,2000:app/foo> \"bar\"\n"),
  ("%TAG !m! !my-\n--- # Bulb here\n!m!light fluorescent\n...\n%TAG !m! !my-\n--- # Color here\n!m!light green\n", "OK # Bulb here\n!my-light fluorescent\n"),
  ("%TAG !e! tag:example.com,2000:app/\n---\n- !e!foo \"bar\"\n", "OK - !<tag:example.com,2000:app/foo> \"bar\"\n"),
  ("!!str &a1 \"foo\":\n  !!str bar\n&a2 baz : *a1\n", "OK &a1 !!str \"foo\": !!str bar\n&a2 baz: *a1\n"),
  ("!<tag:yaml.org,2002:str> foo :\n  !<!bar> baz\n", "OK !!str foo: !bar baz\n"),
  ("%TAG !e! tag:example.com,2000:app/\n---\n- !local foo\n- !!str bar\n- !e!tag%21 baz\n", "OK - !local foo\n- !!str bar\n- !<tag:example.com,2000:app/tag%21> baz\n"),
  ("# Assuming conventional resolution:\n- \"12\"\n- 12\n- ! 12\n", "OK # Assuming conventional resolution:\n- \"12\"\n- 12\n- 12\n"),
  ("First occurrence: &anchor Value\nSecond occurrence: *anchor\n", "OK First occurrence: &anchor Value\nSecond occurrence: *anchor\n"),
  ("- foo:\t bar\n- - baz\n  -\tbaz\n", "ERR \"yaml: line 3: found character that cannot start any token\""),
  ("plain: text\n  lines\nquoted: \"text\n  \tlines\"\nblock: |\n  text\n   \tlines\n", "OK plain: text lines\nquoted: \"text lines\"\nblock: |\n    text\n     \tlines\n"),
  ("Folding:\n  \"Empty line\n\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n", "OK Folding: \"Empty line\\nas a line feed\"\nChomping: |\n    Clipped empty lines\n"),
  ("Folding:\n  \"Empty line\n   \t\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n", "OK Folding: \"Empty line\\nas a line feed\"\nChomping: |\n    Clipped empty lines\n"),
  ("--- >-\n  trimmed\n  \n \n\n  as\n  space\n", "OK >-\n    trimmed\n\n\n\n    as space\n"),
  (">-\n  trimmed\n  \n \n\n  as\n  space\n", "OK >-\n    trimmed\n\n\n\n    as space\n"),
  (">\n  foo \n \n  \t bar\n\n  baz\n", "OK \"foo \\n\\n\\t bar\\n\\nbaz\\n\"\n"),
  ("---\n\"\n  foo \n \n    bar\n\n  baz\n\"\n", "OK \" foo\\nbar\\nbaz \"\n"),
  ("\"\n  foo \n \n  \t bar\n\n  baz\n\"\n", "OK \" foo\\nbar\\nbaz \"\n"),
  ("key:    # Comment\n  value\n", "OK key: value # Comment\n"),
  ("First occurrence: &anchor Foo\nSecond occurrence: *anchor\nOverride anchor: &anchor Bar\nReuse anchor: *anchor\n", "OK First occurrence: &anchor Foo\nSecond occurrence: *anchor\nOverride anchor: &anchor Bar\nReuse anchor: *anchor\n"),
  ("# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up and away!\",\n  -123,\n  http://example.com/foo#bar ]\n", "ERR \"yaml: line 7: did not find expected node content\""),
  ("implicit block key : [\n  implicit flow key : value,\n ]\n", "OK implicit block key: [{implicit flow key: value}]\n"),
  ("1st non-empty\n\n 2nd non-empty \n\t3rd non-empty\n", "OK |-\n    1st non-empty\n    2nd non-empty 3rd non-empty\n"),
  ("- [ one, two, ]\n- [three ,four]\n", "OK - [one, two]\n- [three, four]\n"),
  ("[\n\"double\n quoted\", 'single\n           quoted',\nplain\n text, [ nested ],\nsingle: pair,\n]\n", "OK [\"double quoted\", 'single quoted', plain text, [nested], {single: pair}]\n"),
  ("- { one : two , three: four , }\n- {five: six,seven : eight}\n", "OK - {one: two, three: four}\n- {five: six, seven: eight}\n"),
  ("{\n? explicit: entry,\nimplicit: entry,\n?\n}\n", "OK {explicit: entry, implicit: entry, '': ''}\n"),
  ("{\n\"adjacent\":value,\n\"readable\": value,\n\"empty\":\n}\n", "OK {\"adjacent\": value, \"readable\": value, \"empty\": ''}\n"),
  ("[\nfoo: bar\n]\n", "OK [{foo: bar}]\n"),
  ("{\n  foo : !!str,\n  !!str : bar,\n}\n", "ERR \"yaml: line 2: did not find expected ',' or '}'\""),
  ("[\n? foo\n bar : baz\n]\n", "OK [{foo bar: baz}]\n"),
  ("- [ a, b ]\n- { a: b }\n- \"a\"\n- 'b'\n- c\n", "OK - [a, b]\n- {a: b}\n- \"a\"\n- 'b'\n- c\n"),
  ("- !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str\n", "OK - !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str\n"),
  ("{\n  ? foo :,\n  : bar,\n}\n", "ERR \"yaml: line 2: did not find expected node content\""),
  ("\"implicit block key\" : [\n  \"implicit flow key\" : value,\n ]\n", "OK \"implicit block key\": [{\"implicit flow key\": value}]\n"),
  ("---\n\"folded \nto a space,\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", "OK \"folded to a space,\\nto a line feed, or \\t \\tnon-content\"\n"),
  ("\"folded \nto a space,\t\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", "OK \"folded to a space,\\nto a line feed, or \\t \\tnon-content\"\n"),
  ("---\n\" 1st non-empty\n\n 2nd non-empty \n 3rd non-empty \"\n", "OK \" 1st non-empty\\n2nd non-empty 3rd non-empty \"\n"),
  ("\" 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty \"\n", "OK \" 1st non-empty\\n2nd non-empty 3rd non-empty \"\n"),
  ("---\n'here''s to \"quotes\"'\n", "OK 'here''s to \"quotes\"'\n"),
  ("'here''s to \"quotes\"'\n", "OK 'here''s to \"quotes\"'\n"),
  ("'implicit block key' : [\n  'implicit flow key' : value,\n ]\n", "OK 'implicit block key': [{'implicit flow key': value}]\n"),
  ("---\n' 1st non-empty\n\n 2nd non-empty \n 3rd non-empty '\n", "OK ' 1st non-empty\n\n    2nd non-empty 3rd non-empty '\n"),
  ("' 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty '\n", "OK ' 1st non-empty\n\n    2nd non-empty 3rd non-empty '\n"),
  ("- | # Empty header↓\n literal\n- >1 # Indentation indicator↓\n  folded\n- |+ # Chomping indicator↓\n keep\n\n- >1- # Both indicators↓\n  strip\n", "OK - | # Empty header↓\n  literal\n- >4 # Indentation indicator↓\n   folded\n- |+ # Chomping indicator↓\n  keep\n\n- >4- # Both indicators↓\n   strip\n"),
  (">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n", "OK >4\n    folded line\n\n    next line\n\n      * bullet\n\n      * list\n      * lines\n\n    last line\n\n\n# Comment\n"),
  ("block sequence:\n  - one\n  - two : three\n", "OK block sequence:\n    - one\n    - two: three\n"),
  ("- # Empty\n- |\n block node\n- - one # Compact\n  - two # sequence\n- one: two # Compact mapping\n", "OK -\n# Empty\n- |\n  block node\n- - one # Compact\n  - two # sequence\n- one: two # Compact mapping\n"),
  ("block mapping:\n key: value\n", "OK block mapping:\n    key: value\n"),
  ("? explicit key # Empty value\n? |\n  block key\n: - one # Explicit compact\n  - two # block value\n", "OK explicit key: # Empty value\n? |\n    block key\n:   - one # Explicit compact\n    - two # block value\n"),
  ("plain key: in-line value\n: # Both empty\n\"quoted key\":\n- entry\n", "ERR \"yaml: line 1: did not find expected key\""),
  ("- sun: yellow\n- ? earth: blue\n  : moon: white\n", "OK - sun: yellow\n- ? earth: blue\n  : moon: white\n"),
  ("- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n detected\n", "OK - |\n  detected\n- >4\n\n  # detected\n\n- |4\n   explicit\n- >\n  detected\n\n"),
  ("- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n", "ERR \"yaml: line 9: found a tab character where an indentation space is expected\""),
  ("-\n  \"flow in block\"\n- >\n Block scalar\n- !!map # Block collection\n  foo : bar\n", "OK - \"flow in block\"\n- >\n  Block scalar\n\n- !!map\n  foo: bar # Block collection\n"),
  ("literal: |2\n  value\nfolded: !foo >1\n value\n", "OK literal: |\n    value\nfolded: !foo >\n    value\n\n"),
  ("literal: |2\n  value\nfolded:\n   !foo\n  >1\n value\n", "OK literal: |\n    value\nfolded: !foo >\n    value\n\n"),
  ("sequence: !!seq\n- entry\n- !!seq\n - nested\nmapping: !!map\n foo: bar\n", "OK sequence: !!seq\n    - entry\n    - !!seq\n      - nested\nmapping: !!map\n    foo: bar\n"),
  ("strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n", "OK strip: |-\n    text\nclip: |\n    text\nkeep: |\n    text\n"),
  (" # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n", "OK # Strip\n# Comments:\nstrip: |-\n    # text\n# Clip\n# comments:\nclip: |\n    # text\n# Keep\n# comments:\nkeep: |+\n    # text\n\n\n# Trail\n# comments.\n"),
  ("strip: >-\n\nclip: >\n\nkeep: |+\n\n", "OK strip: \"\"\nclip: \"\"\nkeep: |4+\n"),
  ("--- |\n literal\n \ttext\n\n\n", "OK |\n    literal\n    \ttext\n"),
  ("|\n literal\n \ttext\n\n\n", "OK |\n    literal\n    \ttext\n"),
  ("--- |\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "OK \"\\n\\nliteral\\n \\n\\ntext\\n\"\n\n# Comment\n"),
  ("|\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "OK \"\\n\\nliteral\\n \\n\\ntext\\n\"\n\n# Comment\n"),
  ("--- >\n folded\n text\n\n\n", "OK >\n    folded text\n\n"),
  (">\n folded\n text\n\n\n", "OK >\n    folded text\n\n"),
  ("%YAML 1.2\n---\nDocument\n... # Suffix\n", "ERR \"yaml: found incompatible YAML document\""),
  ("Bare\ndocument\n...\n# No document\n...\n|\n%!PS-Adobe-2.0 # Not the first line\n", "OK Bare document\n"),
  ("---\n{ matches\n% : 20 }\n...\n---\n# Empty\n...\n", "ERR \"yaml: line 1: did not find expected ',' or '}'\""),
