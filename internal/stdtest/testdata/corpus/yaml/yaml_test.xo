  ("Mapping: Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", "OK Mapping: Document\n"),
  ("Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", "OK Document\n"),
  ("---\tscalar\n", "OK scalar\n"),
  ("\t{}\n", "ERR \"yaml: found character that cannot start any token\""),
  ("\t[\n\t]\n", "ERR \"yaml: found character that cannot start any token\""),
  ("%TAG !prefix! tag:example.com,2011:\n--- !prefix!A\na: b\n--- !prefix!B\nc: d\n--- !prefix!C\ne: f\n", "OK !<tag:example.com,2011:A>\na: b\n"),
  ("foo: !!seq\n  - !!str a\n  - !!map\n    key: !!str value\n", "OK foo: !!seq\n    - !!str a\n    - !!map\n      key: !!str value\n"),
  ("!!map {\n  k: !!seq\n  [ a, !!str b]\n}\n", "OK !!map {k: !!seq [a, !!str b]}\n"),
  ("--- !!map\n? a\n: b\n--- !!seq\n- !!str c\n--- !!str\nd\ne\n", "OK !!map\na: b\n"),
  (" - !!str a\n - b\n - !!int 42\n - d\n", "OK - !!str a\n- b\n- !!int 42\n- d\n"),
  ("? !!str a\n: !!int 47\n? c\n: !!str d\n", "OK !!str a: !!int 47\nc: !!str d\n"),
  ("!!str a: b\nc: !!int 42\ne: !!str f\ng: h\n!!str 23: !!bool false\n", "OK !!str a: b\nc: !!int 42\ne: !!str f\ng: h\n!!str 23: !!bool false\n"),
  ("- !!str\n-\n  !!null : a\n  b: !!str\n- !!str : !!null\n", "OK - !!str\n- !!null '': a\n  b: !!str\n- !!str '': !!null\n"),
  ("---\n---word1\nword2\n", "OK '---word1 word2'\n"),
  ("---word1\nword2\n", "OK '---word1 word2'\n"),
  ("---\n- !!int 1\n- !!int -2\n- !!int 33\n", "OK - !!int 1\n- !!int -2\n- !!int 33\n"),
