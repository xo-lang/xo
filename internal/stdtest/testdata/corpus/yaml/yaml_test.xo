  ("literal: |\n  some\n  text\nfolded: >\n  some\n  text\n", "OK {\"folded\":\"some text\\n\",\"literal\":\"some\\ntext\\n\"}"),
  ("single: 'text'\ndouble: \"text\"\n", "OK {\"double\":\"text\",\"single\":\"text\"}"),
  ("%YAML 1.2\n--- text\n", "ERR"),
  ("  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.\n", "OK {\"Not indented\":{\"By one space\":\"By four\\n  spaces\\n\",\"Flow style\":[\"By two\",\"Also by two\",\"Still by two\"]}}"),
  ("  # Comment\n   \n\n\n", "OK null"),
