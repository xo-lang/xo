  ("Folding:\n  \"Empty line\n\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n", "OK {\"Chomping\":\"Clipped empty lines\\n\",\"Folding\":\"Empty line\\nas a line feed\"}"),
  ("Folding:\n  \"Empty line\n   \t\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n", "OK {\"Chomping\":\"Clipped empty lines\\n\",\"Folding\":\"Empty line\\nas a line feed\"}"),
