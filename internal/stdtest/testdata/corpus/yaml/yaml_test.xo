  ("d: [ [ &b [ &a [x, x], *a, *a ], *b, *b ] ]\n", "leaves=18"),
  ("d: [[[ &a [x, x, x] ]]]\n", "leaves=3"),
  ("d: &d [ &c [ &b [ &a [x, x, x], *a, *a, *a ], *b, *b, *b ], *c, *c, *c ]\n", "leaves=192"),
  ("d: [ [ &b [ &a [x, x, x], *a, *a, *a ], *b, *b, *b ] ]\n", "leaves=48"),
  ("d: [[[ &a [x, x, x, x, x] ]]]\n", "leaves=5"),
  ("d: &d [ &c [ &b [ &a [x, x, x, x, x], *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b ], *c, *c, *c, *c, *c ]\n", "leaves=1080"),
  ("d: [ [ &b [ &a [x, x, x, x, x], *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b ] ]\n", "leaves=180"),
  ("d: [[[ &a [x, x, x, x, x, x, x, x, x] ]]]\n", "leaves=9"),
  ("d: &d [ &c [ &b [ &a [x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b ], *c, *c, *c, *c, *c, *c, *c, *c, *c ]\n", "ERR \"yaml: document contains excessive aliasing\""),
  ("d: [ [ &b [ &a [x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b ] ]\n", "leaves=900"),
  ("d: [[[ &a [x, x, x, x, x, x, x, x, x, x, x, x] ]]]\n", "leaves=12"),
  ("d: &d [ &c [ &b [ &a [x, x, x, x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b ], *c, *c, *c, *c, *c, *c, *c, *c, *c, *c, *c, *c ]\n", "ERR \"yaml: document contains excessive aliasing\""),
  ("d: [ [ &b [ &a [x, x, x, x, x, x, x, x, x, x, x, x], *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a, *a ], *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b, *b ] ]\n", "leaves=2028"),
  ("d: &a [*a]\n", "ERR \"yaml: anchor 'a' value contains itself\""),
  ("d: [&a [[*a]]]\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!seq into string\""),
  ("d: [[[ [x] ]]]\nm: &a {z: *a}\n", "leaves=1"),
  ("d: *a\n", "ERR \"yaml: unknown anchor 'a' referenced\""),
  ("x: &a [y]\nd: [[[*a, *a]], [[*a]]]\n", "leaves=3"),
]

/// (a document, what yaml.v3 decodes it into Top as: an inline struct and a skipped field)
const INLINE: List[(Str, Str)] = [
  ("id: 5\nextra: q\nhidden: 4\nn: 8\nmeta: {name: z, tags: [p, q]}\nunknown: 1\n", "id=5 meta=z/p,q extra=q hidden=0 n=8"),
  ("id: x\nn: y\nmeta: {name: 1}\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!str `x` into int\\n  line 2: cannot unmarshal !!str `y` into int\""),
  ("n: 1\nid: 2\nid: 3\n", "ERR \"yaml: unmarshal errors:\\n  line 3: mapping key \\\"id\\\" already defined at line 2\""),
  ("meta: [1]\nextra: [2]\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!seq into Meta\\n  line 2: cannot unmarshal !!seq into string\""),
  ("{id: 1, meta: {tags: [a, b, c]}, extra: e}", "id=1 meta=/a,b,c extra=e hidden=0 n=0"),
  ("", "id=0 meta=/ extra= hidden=0 n=0"),
  ("id: ~\nmeta: ~\nn: ~\n", "id=0 meta=/ extra= hidden=0 n=0"),
]

/// (a document, what yaml.v3 decodes it into Top as with KnownFields(true))
const STRICT: List[(Str, Str)] = [
  ("id: 5\nextra: q\nn: 8\n", "id=5 meta=/ extra=q hidden=0 n=8"),
  ("id: 5\nunknown: 1\nn: 8\nother: [1]\n", "ERR \"yaml: unmarshal errors:\\n  line 2: field unknown not found in type Top\\n  line 4: field other not found in type Top\""),
  ("hidden: 4\nid: 1\n", "ERR \"yaml: unmarshal errors:\\n  line 1: field hidden not found in type Top\""),
  ("meta: {name: z, nope: 1}\n", "ERR \"yaml: unmarshal errors:\\n  line 1: field nope not found in type Meta\""),
  ("x: 1\nid: bad\ny: 2\n", "ERR \"yaml: unmarshal errors:\\n  line 1: field x not found in type Top\\n  line 2: cannot unmarshal !!str `bad` into int\\n  line 3: field y not found in type Top\""),
  ("{id: 1, zz: 2}", "ERR \"yaml: unmarshal errors:\\n  line 1: field zz not found in type Top\""),
  ("", "id=0 meta=/ extra= hidden=0 n=0"),
]

