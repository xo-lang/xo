fn run2(name: Str, x: Float, y: Float) -> Int {
  let f = match name {
    "signbit" => return if x.signbit() { 1 } else { 0 }
    "lgamma_sign" => return x.lgamma().1
    "modf_int" => x.modf().0
    "modf_frac" => x.modf().1
    "round_to_even" => x.round_to_even()
    "acosh" => x.acosh()
    "asinh" => x.asinh()
    "atanh" => x.atanh()
    "erf" => x.erf()
    "erfc" => x.erfc()
    "erfinv" => x.erfinv()
    "erfcinv" => x.erfcinv()
    "gamma" => x.gamma()
    "lgamma" => x.lgamma().0
    "next_after" => x.next_after(y)
    _ => x.remainder(y)
  }
  f.to_bits()
}

test "go math, second set (task #383): every function's bits on special and random inputs" {
  var bad: List[Str] = []
  var by: Map[Str, Int] = {}
  for (name, xb, yb, want) in MATH2 {
    let got = run2(name, Float.from_bits(xb), Float.from_bits(yb))
    let nan = name != "signbit" && name != "lgamma_sign" && Float.from_bits(got).is_nan() && Float.from_bits(want).is_nan()
    if got != want && !nan {
      by.put(name, (by.get(name) ?? 0) + 1)
      if bad.len() < 12 {
        bad.push("${name}(${Float.from_bits(xb)}, ${Float.from_bits(yb)}) = ${Float.from_bits(got)}, want ${Float.from_bits(want)}")
      }
    }
  }
  expect((by, bad)) == ({}, [])
}

test "the Float constants are Go's (task #383)" {
  expect([Float.ln2, Float.ln10, Float.log2e, Float.log10e, Float.sqrt2].map(fn(f: Float) -> Int { f.to_bits() })) == [4604418534313441775, 4612367379483415830, 4609176140021203710, 4601495173785380110, 4609047870845172685]
}
