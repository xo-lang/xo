fn run(name: Str, x: Float, y: Float) -> Float {
  match name {
    "exp" => x.exp()
    "exp2" => x.exp2()
    "expm1" => x.expm1()
    "log" => x.log()
    "log2" => x.log2()
    "log10" => x.log10()
    "log1p" => x.log1p()
    "sin" => x.sin()
    "cos" => x.cos()
    "tan" => x.tan()
    "asin" => x.asin()
    "acos" => x.acos()
    "atan" => x.atan()
    "sinh" => x.sinh()
    "cosh" => x.cosh()
    "tanh" => x.tanh()
    "cbrt" => x.cbrt()
    "pow" => x.pow(y)
    "atan2" => x.atan2(y)
    "hypot" => x.hypot(y)
    _ => x.mod(y)
  }
}

test "go math: every function's bits on special and random inputs" {
  var bad: List[Str] = []
  var by: Map[Str, Int] = {}
  for (name, xb, yb, want) in MATH {
    let got = run(name, Float.from_bits(xb), Float.from_bits(yb))
    let w = Float.from_bits(want)
    if !(got.to_bits() == want || (got.is_nan() && w.is_nan())) {
      by.put(name, (by.get(name) ?? 0) + 1)
      if bad.len() < 12 {
        bad.push("${name}(${Float.from_bits(xb)}, ${Float.from_bits(yb)}) = ${got}, want ${w}")
      }
    }
  }
  expect((by, bad)) == ({}, [])
}
