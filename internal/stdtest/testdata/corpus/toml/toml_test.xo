use std/toml

struct Point {
  x: Int
  y: Int
} derive Json

struct Server {
  name: Str
  ports: List[Int]
  tags: List[Str]
} derive Json

struct Inner {
  deep: Str
  pts: List[Point]
  empty: List[Int]
} derive Json

struct Mid {
  level: Int
  grid: List[List[Int]]
  inner: Inner
} derive Json

struct Config {
  title: Str
  ratio: Float
  on: Bool
  origin: Point
  mid: Mid
  servers: List[Server]
  last: List[Str]
} derive Json

fn sample() -> Config {
  Config{
    title: "it's \"x\"",
    ratio: 0.5,
    on: true,
    origin: Point{x: 1, y: -2},
    mid: Mid{level: 3, grid: [[1, 2], [], [3]], inner: Inner{deep: "d", pts: [Point{x: 4, y: 5}, Point{x: 6, y: 7}], empty: []}},
    servers: [Server{name: "a", ports: [80, 443], tags: []}, Server{name: "b", ports: [], tags: ["t1", "t 2"]}],
    last: ["z"],
  }
}

