// Generated by internal/stdtest/mailfuzz_test.go (seed 1, 2000 cases) from Go's
// net/mail; do not edit: XO_MAILFUZZ_WRITE=1 go test ./internal/stdtest -run TestMailFuzzCorpusCurrent
// rewrites it.
use std/mail

fn ml_addr_text(a: mail.Address) -> Str {
  a.name.bytes().to_hex() + "|" + a.address.bytes().to_hex() + "|" + a.display().bytes().to_hex()
}

fn ml_addr(s: Str) -> Str {
  match mail.parse_address(s) {
    Ok(a) => "ok " + ml_addr_text(a)
    Err(e) => "err " + e.display()
  }
}

fn ml_list(s: Str) -> Str {
  match mail.parse_address_list(s) {
    Ok(l) => {
      var parts: List[Str] = []
      for a in l {
        parts.push(ml_addr_text(a))
      }
      "ok " + parts.join(";")
    }
    Err(e) => "err " + e.display()
  }
}

fn ml_msg(s: Str) -> Str {
  match mail.read_message(s.bytes()) {
    Ok(m) => {
      var keys: List[Str] = []
      for (k, _) in m.headers {
        if !keys.contains(k) {
          keys.push(k)
        }
      }
      var out = "ok "
      for k in keys.sort() {
        out = out + k.bytes().to_hex() + "="
        for (k2, v) in m.headers {
          if k2 == k {
            out = out + v.bytes().to_hex() + ","
          }
        }
        out = out + ";"
      }
      out + "|" + m.body.to_hex()
    }
    Err(e) => "err " + e.display()
  }
}

fn ml_date(s: Str) -> Str {
  match mail.parse_date(s) {
    Ok(t) => "ok ${t.unix_millis()}"
    Err(e) => "err " + e.display()
  }
}

fn expect(got: Str, want: Str) {
  if got != want {
    fault("got " + got)
  }
}

