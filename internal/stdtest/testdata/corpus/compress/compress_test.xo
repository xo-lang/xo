  ("zlib", b"x\x9c", 1073741824, "err unexpected EOF"),
  ("gzip", b"x\x9d", 1073741824, "err unexpected EOF"),
  ("deflate", b"x\x9d", 1073741824, "err unexpected EOF"),
  ("zlib", b"x\x9d", 1073741824, "err zlib: invalid header"),
  ("gzip", b"y\x9c", 1073741824, "err unexpected EOF"),
  ("deflate", b"y\x9c", 1073741824, "err unexpected EOF"),
  ("zlib", b"y\x9c", 1073741824, "err zlib: invalid header"),
  ("gzip", b"x\xbb\x00\x00\x00\x01", 1073741824, "err unexpected EOF"),
  ("deflate", b"x\xbb\x00\x00\x00\x01", 1073741824, "err flate: corrupt input before offset 5"),
  ("zlib", b"x\xbb\x00\x00\x00\x01", 1073741824, "err unexpected EOF"),
  ("gzip", b"x\xbb\x00\x00\x00\x02", 1073741824, "err unexpected EOF"),
  ("deflate", b"x\xbb\x00\x00\x00\x02", 1073741824, "err flate: corrupt input before offset 5"),
  ("zlib", b"x\xbb\x00\x00\x00\x02", 1073741824, "err zlib: invalid dictionary"),
  ("gzip", b"\x1f", 1073741824, "err unexpected EOF"),
  ("deflate", b"\x1f", 1073741824, "err flate: corrupt input before offset 1"),
  ("zlib", b"\x1f", 1073741824, "err unexpected EOF"),
  ("gzip", b"\x1f\x8b", 1073741824, "err unexpected EOF"),
  ("deflate", b"\x1f\x8b", 1073741824, "err flate: corrupt input before offset 1"),
  ("zlib", b"\x1f\x8b", 1073741824, "err zlib: invalid header"),
  ("gzip", b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff", 1073741824, "err unexpected EOF"),
  ("deflate", b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff", 1073741824, "err flate: corrupt input before offset 1"),
  ("zlib", b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff", 1073741824, "err zlib: invalid header"),
]

fn data(seed: Int, n: Int, k: Int) -> Bytes {
  var x = seed & 0x7fffffff
  var b = BytesBuilder.with_capacity(n)
  var i = 0
  while i < n {
    x = (x * 1103515245 + 12345) & 0x7fffffff
    let v = x >> 8
    b.write_byte(UInt8(if k < 256 { 97 + v % k } else { v & 255 }))
    i += 1
  }
  b.freeze()
}

fn sha8(b: Bytes) -> Str { crypto.sha256(b)[0..8].to_hex() }

fn level(n: Int) -> compress.Level { compress.Level.Of(n) }

fn first_bad[T](bad: List[T]) -> List[T] { bad[0..(if bad.len() < 20 { bad.len() } else { 20 })] }

test "every level writes Go's bytes" {
  var bad: List[(Str, Int, Int, Int, Int, Str, Str)] = []
  for (f, lv, seed, n, k, want) in WRITE {
    let d = data(seed, n, k)
    let out = match f {
      "gzip" => compress.gzip(d, level(lv))
      "deflate" => compress.deflate(d, level(lv))
      _ => compress.zlib(d, level(lv))
    }
    let got = "${out.len()} ${sha8(out)}"
    if got != want {
      bad.push((f, lv, seed, n, k, got, want))
    }
  }
  expect(first_bad(bad)) == []
}

test "the decoders give Go's output or error, bounded by max_size" {
  var bad: List[(Str, Int, Str, Str)] = []
  for (i, (f, s, max, want)) in READ.indexed() {
    let r = match f {
      "gzip" => compress.gunzip(s, max_size: max)
      "deflate" => compress.inflate(s, max_size: max)
      _ => compress.unzlib(s, max_size: max)
    }
    let got = match r {
      Ok(b) => "ok ${b.len()} ${sha8(b)}"
      Err(e) => "err ${e.msg}"
    }
    if got != want {
      bad.push((f, i, got, want))
    }
  }
  expect(first_bad(bad)) == []
}
