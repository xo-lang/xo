// Generated by scripts/stdcorpus from archive/tar and archive/zip reading the fixtures this generator writes with Go's writers (and, for zip64, lays out by hand), compared entry by entry: path, size, permission bits, whether a directory, the modified time and the SHA-256 of the data, plus the archives Xo's path rules refuse (an absolute path, one leaving the root, a symbolic link, a hard link). Go's archive tests are Copyright 2009 The Go Authors, BSD-style license) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/archive
use std/crypto

/// USTAR: a directory, two files and an empty one
const TAR_PLAIN: Str = ""

/// PAX: a path of 150 bytes and a nanosecond time
const TAR_LONG_PAX: Str = ""

/// USTAR: a 150 byte path split over the prefix field
const TAR_USTAR_PREFIX: Str = ""

/// GNU: a 140 byte path in a long name entry
const TAR_GNU_LONG: Str = ""

/// PAX: a record a reader must ignore next to a long path
const TAR_PAX_EXTRA: Str = ""

/// PAX: a global header holding a comment, then a file (git archive's shape); the header describes the archive, so untar skips it
const TAR_PAX_GLOBAL: Str = ""

/// GNU PAX sparse 0.1: two blocks in a 2048 byte file, so 2036 bytes of holes; the map is in GNU.sparse.offset and GNU.sparse.numbytes records and the header's size is the physical 12 bytes
const TAR_SPARSE_01: Str = ""

/// GNU PAX sparse 1.0: the same two blocks, with the map as the first block of the data area and GNU.sparse.realsize for the logical size
const TAR_SPARSE_10: Str = ""

/// USTAR: no entries
const TAR_EMPTY: Str = ""

/// USTAR: a symbolic link
const TAR_SYMLINK: Str = ""

/// USTAR: a hard link
const TAR_HARDLINK: Str = ""

/// USTAR: /etc/passwd
const TAR_ABSOLUTE: Str = ""

/// USTAR: ../out
const TAR_DOTDOT: Str = ""

/// a directory, a deflated file, a UTF-8 name and an empty file
const ZIP_PLAIN: Str = ""

/// a file long enough that deflate does real work
const ZIP_BIGGER: Str = ""

/// a stored file with zip64 sizes and offset
const ZIP64: Str = ""

/// no entries
const ZIP_EMPTY: Str = "504b0506000000000000000000000000000000000000"

/// /etc/passwd
const ZIP_ABSOLUTE: Str = ""

/// ../out
const ZIP_DOTDOT: Str = ""

/// (fixture, Go's reading of it: path, size, octal mode, is_dir, modified, SHA-256 of the data; entries by newline)
const TAR_CASES: List[(Str, Str)] = [
  (TAR_PLAIN, "dir\t0\t755\ttrue\t2023-11-14T22:13:20Z\te3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\ndir/a.txt\t6\t644\tfalse\t2023-11-14T22:13:20Z\t5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03\ndir/b.bin\t4\t600\tfalse\t2023-11-14T22:13:20Z\t3d1f57c984978ef98a18378c8166c1cb8ede02c03eeb6aee7e2f121dfeee3e56\nempty\t0\t644\tfalse\t2023-11-14T22:13:20Z\te3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
  (TAR_LONG_PAX, "deep/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/file.txt\t5\t644\tfalse\t2023-11-14T22:13:20.123456789Z\tbbdbb75b415ee9a40f0b3796a8b41a0b7723afe5726b870474ad220a4886d06d"),
  (TAR_USTAR_PREFIX, "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/f\t7\t644\tfalse\t2023-11-14T22:13:20Z\t5a958fd0cb0435992ec0b7afb3255dbe976078447b0fe2830119c083b9eae082"),
  (TAR_GNU_LONG, "gnu/gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg\t4\t644\tfalse\t2023-11-14T22:13:20Z\t307ef1117d7124e7b80527fbc30fb8de42da797c7bc4714d682b023b42094473"),
  (TAR_PAX_EXTRA, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/f\t4\t644\tfalse\t2023-11-14T22:13:20Z\td0a5fb2e3d323d934006976084f40e7d21ddb72156f9c21083096a02d8ff7af9"),
  (TAR_PAX_GLOBAL, "f.txt\t3\t644\tfalse\t2023-11-14T22:13:20Z\t98ea6e4f216f2fb4b69fff9b3a44842c38686ca685f3f55dc48c5d3fb1107be4"),
  (TAR_SPARSE_01, "sparse.bin\t2048\t644\tfalse\t2023-11-14T22:13:20Z\tf6db0c4e0f26069983d817c7e69b2ca1622140dea2b290f6c82dde7daf507234"),
  (TAR_SPARSE_10, "sparse.bin\t2048\t644\tfalse\t2023-11-14T22:13:20Z\tf6db0c4e0f26069983d817c7e69b2ca1622140dea2b290f6c82dde7daf507234"),
  (TAR_EMPTY, ""),
]

/// (fixture, Go's reading of it, the same way as TAR_CASES)
const ZIP_CASES: List[(Str, Str)] = [
  (ZIP_PLAIN, "dir\t0\t755\ttrue\t2023-11-14T22:13:20Z\te3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\ndir/a.txt\t6\t644\tfalse\t2023-11-14T22:13:20Z\t5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03\nnaïve/日本語.txt\t8\t644\tfalse\t2023-11-14T22:13:20Z\tebc45fabefbabdd06424b3c476b11e93fec784069ff10844e7383d59f491f8cb\nempty\t0\t644\tfalse\t2023-11-14T22:13:20Z\te3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
  (ZIP_BIGGER, "text.txt\t1760\t644\tfalse\t2023-11-14T22:13:20Z\t026d6d27fce71345b48717feea6d882e6acbdeeecec2cd8a50ec72e17984b7ca"),
  (ZIP64, "big/name.txt\t6\t666\tfalse\t2023-11-14T22:13:20Z\t5a839952ecf37f9e7bf190f4ce7af7744b543fe5f7643a19a2d752d0767090b6"),
  (ZIP_EMPTY, ""),
]

/// (fixture, why Xo refuses it: Go reads all of these, and std/archive.xo's path rules refuse them)
const TAR_REFUSED: List[(Str, Str)] = [
  (TAR_SYMLINK, "links are an error (std/archive.xo)"),
  (TAR_HARDLINK, "links are an error (std/archive.xo)"),
  (TAR_ABSOLUTE, "an absolute path is an error (std/archive.xo)"),
  (TAR_DOTDOT, "a path leaving the root is an error (std/archive.xo)"),
]

/// (fixture, why Xo refuses it, as TAR_REFUSED)
const ZIP_REFUSED: List[(Str, Str)] = [
  (ZIP_ABSOLUTE, "an absolute path is an error (std/archive.xo)"),
  (ZIP_DOTDOT, "a path leaving the root is an error (std/archive.xo)"),
]

fn show3(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

/// The corpus's shape of a list of entries, the same shape the generator's Go
/// side takes: path, size, octal mode, is_dir, modified, SHA-256 of the data.
fn summarize(entries: List[archive.Entry]) -> Str {
  var out = ""
  for e in entries {
    if out != "" {
      out = out + "\n"
    }
    out = out + "${e.path}\t${e.data.len()}\t${e.mode.to_str_base(8)}\t${e.is_dir}\t${e.modified}\t${crypto.sha256(e.data).to_hex()}"
  }
  out
}

test "untar reads what Go's archive/tar reads" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, want) in TAR_CASES {
    let data = Bytes.from_hex(hex_text) ?? b""
    let got = match archive.untar(data) {
      Ok(entries) => summarize(entries)
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push((hex_text[0..16], got, want))
    }
  }
  expect(show3(bad)) == []
}

test "unzip reads what Go's archive/zip reads" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, want) in ZIP_CASES {
    let data = Bytes.from_hex(hex_text) ?? b""
    let got = match archive.unzip(data) {
      Ok(entries) => summarize(entries)
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push((hex_text[0..16], got, want))
    }
  }
  expect(show3(bad)) == []
}

test "untar refuses what std/archive.xo says it refuses" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, why) in TAR_REFUSED {
    let data = Bytes.from_hex(hex_text) ?? b""
    match archive.untar(data) {
      Ok(_) => bad.push((why, "read", "refused"))
      Err(_) => {}
    }
  }
  expect(show3(bad)) == []
}

test "unzip refuses what std/archive.xo says it refuses" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, why) in ZIP_REFUSED {
    let data = Bytes.from_hex(hex_text) ?? b""
    match archive.unzip(data) {
      Ok(_) => bad.push((why, "read", "refused"))
      Err(_) => {}
    }
  }
  expect(show3(bad)) == []
}
