/// Go's archive for the zip_writer test below
const ZIP_STREAMED: Str = "71454 cd62683cbcb37487a97ff17a3214fa6ba5cef9344475db356714a35996d909f8"
/// Go's prefix and archive with SetOffset(100)
const ZIP_OFFSET: Str = "1186 171d703d84a0b725ea44e89782e585b7c582de1e7f52dc49febccb86f3d82251"
/// Go's prefix and archive with SetOffset(100)
const ZIP_OFFSET_STREAMED: Str = "1186 171d703d84a0b725ea44e89782e585b7c582de1e7f52dc49febccb86f3d82251"

fn zdata(seed: Int, n: Int) -> Bytes {
  var x = seed & 0x7fffffff
  var b = BytesBuilder.with_capacity(n)
  var i = 0
  while i < n {
    x = (x * 1103515245 + 12345) & 0x7fffffff
    b.write_byte(UInt8(97 + (x >> 8) % 26))
    i += 1
  }
  b.freeze()
}

fn zdata256(seed: Int, n: Int, k: Int) -> Bytes {
  var x = seed & 0x7fffffff
  var b = BytesBuilder.with_capacity(n)
  var i = 0
  while i < n {
    x = (x * 1103515245 + 12345) & 0x7fffffff
    let v = x >> 8
    b.write_byte(UInt8(if k < 256 { 97 + v % k } else { v & 255 }))
    i += 1
  }
  b.freeze()
}

fn comment_of(k: Int) -> Str {
  match k {
    1 => "hello"
    2 => "h\u{e9}llo \u{2713} tab\tnl\n"
    3 => "c".repeat(65535)
    4 => "c".repeat(65536)
    _ => ""
  }
}

fn sum_of(b: Bytes) -> Str { "${b.len()} ${crypto.sha256(b).to_hex()}" }

test "zip with a comment and either method writes Go's bytes (zip.Store, Writer.SetComment), and zip_reader reads them back" {
  var bad: List[(Int, Str, Str)] = []
  for (i, (spec, k, store, want)) in ZIP_METHOD.indexed() {
    var es: List[archive.Entry] = []
    for (p, seed, n, mode, sec, is_dir) in spec {
      es.push(archive.Entry{path: p, data: zdata(seed, n), mode: mode, is_dir: is_dir, modified: Time.UNIX_EPOCH + Duration.from_nanos(sec * 1000000000)})
    }
    let method = if store { archive.ZipMethod.Store } else { archive.ZipMethod.Deflate }
    let got = match archive.zip(es, comment: comment_of(k), method: method) {
      Ok(b) => {
        let back = match archive.zip_reader(b) {
          Ok(r) => {
            var ok = r.comment() == comment_of(k)
            for (j, f) in r.files().indexed() {
              ok = ok && (f.method == (if store || f.is_dir { 0 } else { 8 })) && ((r.read(f).ok() ?? b"-") == es[j].data)
            }
            ok
          }
          Err(_) => false
        }
        if back { sum_of(b) } else { "read back differs" }
      }
      Err(e) => "err ${e.display()}"
    }
    if got != want {
      bad.push((i, got, want))
    }
  }
  expect(show3(bad.map(fn(x) { ("${x.0}", x.1, x.2) }))) == []
}

test "zip_reader gives Go's Reader.Comment" {
  var got: List[Str] = []
  var want: List[Str] = []
  for (data, c) in ZIP_COMMENTS {
    got.push(match archive.zip_reader(data) {
      Ok(r) => r.comment()
      Err(e) => "err ${e.display()}"
    })
    want.push(c)
  }
  expect(got) == want
}

test "zip_writer with set_comment and stored entries writes Go's bytes" {
  var f = os.fs.create("m.zip")?
  var w = archive.zip_writer(f)
  w.add(archive.file("s.txt", b"stored stored stored"), method: archive.ZipMethod.Store)?
  w.create("d.txt", 0o600)?
  w.write(zdata256(9, 4000, 3))?
  w.create("s2", method: archive.ZipMethod.Store)?
  let big = zdata256(10, 70000, 256)
  w.write(big[0..30000])?
  w.write(big[30000..])?
  w.set_comment("streamed")?
  expect(w.set_comment("c".repeat(65536)).is_err()) == true
  w.close()?
  f.close()?
  let data = os.fs.read("m.zip")?
  expect(sum_of(data)) == ZIP_STREAMED
  let r = archive.zip_open(os.fs.open("m.zip")?, data.len())?
  expect(r.comment()) == "streamed"
  expect(r.files().map(fn(x) { x.method })) == [0, 8, 0]
}

test "zip with offset after a prefix writes Go's bytes (Writer.SetOffset), and zip_reader reads it" {
  let pre = zdata256(11, 100, 256)
  let es = [archive.file("f0", b"one one one"), archive.file("f1", zdata256(12, 3000, 3))]
  let z = archive.zip(es, comment: "sfx", offset: 100)?
  let whole = pre + z
  expect(sum_of(whole)) == ZIP_OFFSET
  let r = archive.zip_reader(whole)?
  expect(r.comment()) == "sfx"
  expect(r.read(r.files()[1])?) == es[1].data
  var f = os.fs.create("sfx.zip")?
  f.write(pre)?
  var w = archive.zip_writer(f)
  w.set_offset(100)
  w.add(es[0])?
  w.add(es[1])?
  w.set_comment("sfx")?
  w.close()?
  f.close()?
  expect(sum_of(os.fs.read("sfx.zip")?)) == ZIP_OFFSET_STREAMED
}

/// Go's tar.Writer archive for the tar_writer test: length and SHA-256
const TAR_WRITER: Str = "77312 30f46f4ab5e620290e247afd6b2bf3bba218a292080f19e8db45388c52b7d1cf"
/// each step's error, "" for none
const TAR_WRITER_ERRS: List[Str] = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "archive/tar: write too long", "", "", "", "archive/tar: missed writing 2 bytes", "archive/tar: missed writing 2 bytes", "archive/tar: write too long", ""]

fn tw_rec(r: Result[(), archive.ArchiveErr]) -> Str {
  match r {
    Ok(_) => ""
    Err(e) => {
      let m = e.display()
      // Go's text without the archive: tar_writer: prefix
      if m.starts_with("archive: tar_writer: ") { m[21..] } else { m }
    }
  }
}

test "tar_writer writes Go's tar.Writer archive and its errors" {
  var f = os.fs.create("tw.tar")?
  var w = archive.tar_writer(f)
  var errs: List[Str] = []
  let t = Time.UNIX_EPOCH + Duration.from_nanos(1700000000 * 1000000000)
  errs.push(tw_rec(w.create("a.txt", 11, modified: t)))
  errs.push(tw_rec(w.write(b"hello tar\n!")))
  errs.push(tw_rec(w.add(archive.Entry{path: "d", data: b"", mode: 0o755, is_dir: true, modified: t})))
  let big = zdata256(21, 70000, 256)
  errs.push(tw_rec(w.create("big.bin", big.len(), mode: 0o600)))
  var at = 0
  while at < big.len() {
    let end = if at + 9000 < big.len() { at + 9000 } else { big.len() }
    errs.push(tw_rec(w.write(big[at..end])))
    at = end
  }
  let long = "dir/".repeat(30) + "f\u{e9}.txt"
  errs.push(tw_rec(w.create(long, 3, modified: t + Duration.from_nanos(123456789))))
  errs.push(tw_rec(w.write(b"abc")))
  errs.push(tw_rec(w.create("short", 10, modified: t)))
  errs.push(tw_rec(w.write(b"0123456789ABCDE")))
  errs.push(tw_rec(w.flush()))
  errs.push(tw_rec(w.create("miss", 5, modified: t)))
  errs.push(tw_rec(w.write(b"xyz")))
  errs.push(tw_rec(w.flush()))
  errs.push(tw_rec(w.create("next", 0, modified: t)))
  errs.push(tw_rec(w.write(b"...")))
  errs.push(tw_rec(w.close()))
  f.close()?
  expect(errs) == TAR_WRITER_ERRS
  let data = os.fs.read("tw.tar")?
  expect(sum_of(data)) == TAR_WRITER
}
