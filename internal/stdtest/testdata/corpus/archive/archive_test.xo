/// (fixture, why Xo refuses it: Go reads all of these, and std/archive.xo's path rules refuse them)
const TAR_REFUSED: List[(Str, Str)] = [
  (TAR_SYMLINK, "links are an error (std/archive.xo)"),
  (TAR_HARDLINK, "links are an error (std/archive.xo)"),
  (TAR_ABSOLUTE, "an absolute path is an error (std/archive.xo)"),
  (TAR_DOTDOT, "a path leaving the root is an error (std/archive.xo)"),
]

/// (fixture, why Xo refuses it, as TAR_REFUSED)
const ZIP_REFUSED: List[(Str, Str)] = [
  (ZIP_ABSOLUTE, "an absolute path is an error (std/archive.xo)"),
  (ZIP_DOTDOT, "a path leaving the root is an error (std/archive.xo)"),
]

fn show3(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

/// The corpus's shape of a list of entries, the same shape the generator's Go
/// side takes: path, size, octal mode, is_dir, modified, SHA-256 of the data.
fn summarize(entries: List[archive.Entry]) -> Str {
  var out = ""
  for e in entries {
    if out != "" {
      out = out + "\n"
    }
    out = out + "${e.path}\t${e.data.len()}\t${e.mode.to_str_base(8)}\t${e.is_dir}\t${e.modified}\t${crypto.sha256(e.data).to_hex()}"
  }
  out
}

test "untar reads what Go's archive/tar reads" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, want) in TAR_CASES {
    let data = Bytes.from_hex(hex_text) ?? b""
    let got = match archive.untar(data) {
      Ok(entries) => summarize(entries)
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push((hex_text[0..16], got, want))
    }
  }
  expect(show3(bad)) == []
}

test "unzip reads what Go's archive/zip reads" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, want) in ZIP_CASES {
    let data = Bytes.from_hex(hex_text) ?? b""
    let got = match archive.unzip(data) {
      Ok(entries) => summarize(entries)
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push((hex_text[0..16], got, want))
    }
  }
  expect(show3(bad)) == []
}

test "untar refuses what std/archive.xo says it refuses" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, why) in TAR_REFUSED {
    let data = Bytes.from_hex(hex_text) ?? b""
    match archive.untar(data) {
      Ok(_) => bad.push((why, "read", "refused"))
      Err(_) => {}
    }
  }
  expect(show3(bad)) == []
}

test "unzip refuses what std/archive.xo says it refuses" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, why) in ZIP_REFUSED {
    let data = Bytes.from_hex(hex_text) ?? b""
    match archive.unzip(data) {
      Ok(_) => bad.push((why, "read", "refused"))
      Err(_) => {}
    }
  }
  expect(show3(bad)) == []
}
fn read_all(data: Bytes) -> List[archive.Entry] ! archive.ArchiveErr {
  let r = archive.zip_reader(data)?
  var out: List[archive.Entry] = []
  for f in r.files() {
    out.push(archive.Entry{path: f.path, data: r.read(f)?, mode: f.mode, is_dir: f.is_dir, modified: f.modified})
  }
  out
}

test "zip_reader reads one entry at a time what unzip reads" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, _want) in ZIP_CASES {
    let data = Bytes.from_hex(hex_text) ?? b""
    let got = match read_all(data) {
      Ok(entries) => summarize(entries)
      Err(e) => "!error ${e.display()}"
    }
    let ref = match archive.unzip(data) {
      Ok(entries) => summarize(entries)
      Err(e) => "!error ${e.display()}"
    }
    // the error texts differ in their prefix (zip_reader: and unzip:)
    if got.starts_with("!error") != ref.starts_with("!error") || (!got.starts_with("!error") && got != ref) {
      bad.push((hex_text[0..16], got, ref))
    }
  }
  for (hex_text, why) in ZIP_REFUSED {
    let data = Bytes.from_hex(hex_text) ?? b""
    match read_all(data) {
      Ok(_) => bad.push((why, "read", "refused"))
      Err(_) => {}
    }
  }
  expect(show3(bad)) == []
}

test "zip_reader lists sizes and kinds before inflating" {
  let data = archive.zip([archive.file("a.txt", b"hello hello hello hello"), archive.dir("d"), archive.file("d/b", b"")]).ok() ?? b""
  let r = archive.zip_reader(data).ok() ?? fault("reader")
  let fs = r.files()
  expect(fs.map(fn(f) { f.path })) == ["a.txt", "d", "d/b"]
  expect(fs.map(fn(f) { f.size })) == [23, 0, 0]
  expect(fs.map(fn(f) { f.is_dir })) == [false, true, false]
  expect(r.read(fs[0]).ok() ?? b"") == b"hello hello hello hello"
  expect(r.read(fs[1]).ok() ?? b"x") == b""
}
test "zip_writer writes what unzip and zip_reader read" {
  var f = os.fs.create("out.zip")?
  var w = archive.zip_writer(f)
  w.add(archive.file("a.txt", b"hello hello hello hello"))?
  w.add(archive.dir("d"))?
  w.create("d/big", 0o600)?
  var want = ""
  for i in 0..50 {
    let line = "line ${i} of the streamed entry\n"
    want += line
    w.write(line.bytes())?
  }
  w.add(archive.file("z", b""))?
  w.close()?
  f.close()?
  let data = os.fs.read("out.zip")?
  let got = archive.unzip(data)?
  expect(got.map(fn(e) { e.path })) == ["a.txt", "d", "d/big", "z"]
  expect(got[0].data) == b"hello hello hello hello"
  expect(got[1].is_dir) == true
  expect(got[2].mode) == 0o600
  expect(got[2].data) == want.bytes()
  expect(got[3].data) == b""
  let r = archive.zip_reader(data)?
  expect(r.files().map(fn(x) { x.size })) == [23, 0, want.len(), 0]
}

test "zip_writer refuses a bad path and a write without create" {
  var f = os.fs.create("o.zip")?
  var w = archive.zip_writer(f)
  expect(w.add(archive.file("../x", b"1")).is_err()) == true
  expect(w.write(b"x").is_err()) == true
  w.close()?
}
fn read_all_open(fs: Fs, hex_text: Str) -> List[archive.Entry] ! archive.ArchiveErr {
  let data = Bytes.from_hex(hex_text) ?? b""
  fs.write("c.zip", data).ok() ?? fault("write")
  let f = fs.open("c.zip").ok() ?? fault("open")
  let r = archive.zip_open(f, data.len())?
  var out: List[archive.Entry] = []
  for z in r.files() {
    out.push(archive.Entry{path: z.path, data: r.read(z)?, mode: z.mode, is_dir: z.is_dir, modified: z.modified})
  }
  f.close().ok() ?? fault("close")
  out
}

test "zip_open reads a File as zip_reader reads the bytes" {
  var bad: List[(Str, Str, Str)] = []
  for (hex_text, _want) in ZIP_CASES {
    let data = Bytes.from_hex(hex_text) ?? b""
    let ref = match read_all(data) {
      Ok(entries) => summarize(entries)
      Err(_e) => "!error"
    }
    let got = match read_all_open(os.fs, hex_text) {
      Ok(entries) => summarize(entries)
      Err(_e) => "!error"
    }
    if got != ref {
      bad.push((hex_text[0..16], got, ref))
    }
  }
  expect(show3(bad)) == []
}

test "zip_open walks a large archive from the File" {
  var es: List[archive.Entry] = []
  for i in 0..300 {
    es.push(archive.file("dir/f${i}.txt", ("entry ${i} " + "x".repeat(i * 7)).bytes()))
  }
  let data = archive.zip(es)?
  os.fs.write("big.zip", data)?
  let f = os.fs.open("big.zip")?
  let r = archive.zip_open(f, data.len())?
  let fs = r.files()
  expect(fs.len()) == 300
  expect(r.read(fs[299])?) == es[299].data
  expect(r.read(fs[0])?) == es[0].data
  expect(archive.zip_open(f, 10).is_err()) == true
  f.close()?
}

