/// Go's archive of ZIP_RAW: length and SHA-256
const ZIP_RAW_WANT: Str = "2653 66a1457ff41eaf8e1ef2d029fd322ac860b8a5395999090b1998e00d8d4eb767"

test "copy writes Go's Writer.Copy of every entry, and raw and data_offset are Go's OpenRaw and DataOffset" {
  for (i, (src, want, parts)) in ZIP_COPY.indexed() {
    let r = archive.zip_reader(src)?
    let name = "copy${i}.zip"
    var f = os.fs.create(name)?
    var w = archive.zip_writer(f)
    var got: List[Str] = []
    for z in r.files() {
      w.copy(r, z)?
      got.push("${r.data_offset(z)?}:${crypto.sha256(r.raw(z)?).to_hex()[0..16]}")
    }
    w.close()?
    f.close()?
    expect((i, sum_of(os.fs.read(name)?))) == (i, want)
    expect((i, got.join(" "))) == (i, parts)
    // the copy reads back as the source does
    let back = archive.zip_reader(os.fs.read(name)?)?
    for (j, z) in back.files().indexed() {
      expect(back.read(z)?) == r.read(r.files()[j])?
    }
  }
}

test "add_raw writes Go's Writer.CreateRaw of the same header" {
  var f = os.fs.create("raw.zip")?
  var w = archive.zip_writer(f)
  for (p, method, flags, mode, is_dir, sec, crc, size, raw) in ZIP_RAW {
    let z = archive.ZipFile{path: p, size: size, compressed: raw.len(), mode: mode, is_dir: is_dir, modified: Time.UNIX_EPOCH + Duration.from_nanos(sec * 1000000000), offset: 0, method: method, flags: flags, crc: crc}
    w.add_raw(z, raw)?
  }
  w.close()?
  f.close()?
  let data = os.fs.read("raw.zip")?
  expect(sum_of(data)) == ZIP_RAW_WANT
  let r = archive.zip_reader(data)?
  expect(r.files().len()) == ZIP_RAW.len()
}

/// Go's tar.Writer archive for the tar_writer test: length and SHA-256
const TAR_WRITER: Str = "77312 30f46f4ab5e620290e247afd6b2bf3bba218a292080f19e8db45388c52b7d1cf"
/// each step's error, "" for none
const TAR_WRITER_ERRS: List[Str] = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "archive/tar: write too long", "", "", "", "archive/tar: missed writing 2 bytes", "archive/tar: missed writing 2 bytes", "archive/tar: write too long", ""]

fn tw_rec(r: Result[(), archive.ArchiveErr]) -> Str {
  match r {
    Ok(_) => ""
    Err(e) => {
      let m = e.display()
      // Go's text without the archive: tar_writer: prefix
      if m.starts_with("archive: tar_writer: ") { m[21..] } else { m }
    }
  }
}

test "tar_writer writes Go's tar.Writer archive and its errors" {
  var f = os.fs.create("tw.tar")?
  var w = archive.tar_writer(f)
  var errs: List[Str] = []
  let t = Time.UNIX_EPOCH + Duration.from_nanos(1700000000 * 1000000000)
  errs.push(tw_rec(w.create("a.txt", 11, modified: t)))
  errs.push(tw_rec(w.write(b"hello tar\n!")))
  errs.push(tw_rec(w.add(archive.Entry{path: "d", data: b"", mode: 0o755, is_dir: true, modified: t})))
  let big = zdata256(21, 70000, 256)
  errs.push(tw_rec(w.create("big.bin", big.len(), mode: 0o600)))
  var at = 0
  while at < big.len() {
    let end = if at + 9000 < big.len() { at + 9000 } else { big.len() }
    errs.push(tw_rec(w.write(big[at..end])))
    at = end
  }
  let long = "dir/".repeat(30) + "f\u{e9}.txt"
  errs.push(tw_rec(w.create(long, 3, modified: t + Duration.from_nanos(123456789))))
  errs.push(tw_rec(w.write(b"abc")))
  errs.push(tw_rec(w.create("short", 10, modified: t)))
  errs.push(tw_rec(w.write(b"0123456789ABCDE")))
  errs.push(tw_rec(w.flush()))
  errs.push(tw_rec(w.create("miss", 5, modified: t)))
  errs.push(tw_rec(w.write(b"xyz")))
  errs.push(tw_rec(w.flush()))
  errs.push(tw_rec(w.create("next", 0, modified: t)))
  errs.push(tw_rec(w.write(b"...")))
  errs.push(tw_rec(w.close()))
  f.close()?
  expect(errs) == TAR_WRITER_ERRS
  let data = os.fs.read("tw.tar")?
  expect(sum_of(data)) == TAR_WRITER
}

fn tr_all(fs: Fs, path: Str, chunk: Int) -> List[archive.Entry] ! archive.ArchiveErr {
  let f = match fs.open(path) {
    Ok(x) => x
    Err(e) => return Err(archive.ArchiveErr{msg: e.display()})
  }
  var r = archive.tar_reader(f)
  var out: List[archive.Entry] = []
  while true {
    let h = match r.next()? {
      Some(x) => x
      None => break
    }
    var b = BytesBuilder.new()
    while true {
      match r.read(chunk)? {
        Some(part) => b.write(part)
        None => break
      }
    }
    let data = b.freeze()
    if data.len() != h.size {
      return Err(archive.ArchiveErr{msg: "size ${h.size} read ${data.len()}"})
    }
    out.push(archive.Entry{path: h.path, data: data, mode: h.mode, is_dir: h.is_dir, modified: h.modified})
  }
  out
}

fn tr_ref(data: Bytes) -> Str {
  match archive.untar(data) {
    Ok(entries) => summarize(entries)
    Err(e) => {
      let m = e.display()
      "!error " + (if m.starts_with("archive: untar: ") { "archive: tar_reader: " + m[16..] } else { m })
    }
  }
}

fn tr_got(fs: Fs, data: Bytes, chunk: Int) -> Str ! FsErr {
  fs.write("tr.tar", data)?
  match tr_all(fs, "tr.tar", chunk) {
    Ok(entries) => summarize(entries)
    Err(e) => "!error ${e.display()}"
  }
}

test "tar_reader reads entry by entry what untar reads" {
  var bad: List[(Str, Str, Str)] = []
  var all: List[Bytes] = []
  for (hex_text, _want) in TAR_CASES {
    all.push(Bytes.from_hex(hex_text) ?? b"")
  }
  for (hex_text, _why) in TAR_REFUSED {
    all.push(Bytes.from_hex(hex_text) ?? b"")
  }
  var runs = 0
  for data in all {
    var cuts = [data.len()]
    var at = 0
    while at < data.len() {
      cuts.push(at)
      cuts.push(at + 100)
      cuts.push(at + 511)
      at += 512
    }
    for cut in cuts {
      if cut > data.len() {
        continue
      }
      let part = data[0..cut]
      let want = tr_ref(part)
      for chunk in [1, 7, 512, 100000] {
        let got = tr_got(os.fs, part, chunk)?
        runs += 1
        if got != want {
          bad.push(("${data.len()} cut ${cut} chunk ${chunk}", got, want))
        }
      }
    }
  }
  expect(show3(bad)) == []
  // every fixture and cut, with four read sizes
  expect(runs) == 832
}

test "tar_reader streams a large entry" {
  var b = BytesBuilder.new()
  var i = 0
  while i < 200000 {
    b.write_byte(UInt8(97 + (i * 7 + i / 300) % 26))
    i += 1
  }
  let t = Time.UNIX_EPOCH + Duration.from_nanos(1700000000 * 1000000000)
  let es = [archive.Entry{path: "dir/".repeat(30) + "big.bin", data: b.freeze(), mode: 0o600, is_dir: false, modified: t}, archive.dir("d"), archive.file("d/x", b"x")]
  let data = archive.tar(es)?
  expect(tr_got(os.fs, data, 4097)?) == summarize(es)
  expect(tr_got(os.fs, data, 70000)?) == summarize(es)
  // next skips an entry's unread data
  os.fs.write("tr.tar", data)?
  var r = archive.tar_reader(os.fs.open("tr.tar")?)
  let h = r.next()? ?? fault("first")
  expect(h.size) == 200000
  expect((r.read(10)? ?? b"").len()) == 10
  expect((r.next()? ?? fault("dir")).is_dir) == true
  expect(r.read(10)?) == None
  expect((r.next()? ?? fault("x")).path) == "d/x"
  expect(r.read(10)?) == Some(b"x")
  expect(r.next()?) == None
}

/// Go's tar.Writer.AddFS and zip.Writer.AddFS of the add_fs tree: length and SHA-256
const TAR_ADD_FS: Str = "78848 082a512a25297638a8f39613bb16bf870df0bf8a2dab5e353dba36fb85f34faa"
const ZIP_ADD_FS: Str = "71306 149d350dfdc16cf35511bc301da03c55af899d2fb43883511a3e51c51b22431c"

fn tree_time(k: Int) -> Time { Time.UNIX_EPOCH + Duration.from_nanos((1700000000 + k * 60) * 1000000000) }

/// The tree of addFSCorpus under dir: files first, then each one's mode
/// and time, directories last (a file written into one changes its time).
fn add_fs_tree(root: Fs, dir: Str) -> Fs ! FsErr uses fs {
  let long = "long/" + "n".repeat(120) + "\u{e9}.txt"
  let files: List[(Str, Bytes, Int, Int)] = [("a.txt", b"hello add_fs\n", 0o644, 0), ("bin/big.bin", zdata256(31, 70000, 256), 0o600, 2), ("bin/run.sh", b"#!/bin/sh\necho hi\n", 0o755, 3), (long, b"long name\n", 0o644, 6), ("z\u{e9}.txt", b"", 0o640, 7)]
  let t = root.sub(dir)
  t.create_dir_all("bin")?
  t.create_dir_all("empty")?
  t.create_dir_all("long")?
  for (p, data, mode, k) in files {
    t.write(p, data)?
    t.set_mode(p, mode)?
    t.set_modified(p, tree_time(k))?
  }
  for (p, mode, k) in [("bin", 0o750, 1), ("empty", 0o700, 4), ("long", 0o755, 5)] {
    t.set_mode(p, mode)?
    t.set_modified(p, tree_time(k))?
  }
  Ok(t)
}

test "TarWriter.add_fs and ZipWriter.add_fs write Go's Writer.AddFS archives" {
  let t = add_fs_tree(os.fs, "addfs")?
  var f = os.fs.create("addfs.tar")?
  var w = archive.tar_writer(f)
  w.add_fs(t)?
  w.close()?
  f.close()?
  expect(sum_of(os.fs.read("addfs.tar")?)) == TAR_ADD_FS
  var g = os.fs.create("addfs.zip")?
  var z = archive.zip_writer(g)
  z.add_fs(t)?
  z.close()?
  g.close()?
  expect(sum_of(os.fs.read("addfs.zip")?)) == ZIP_ADD_FS
  // the entries read back as the tree has them
  let es = archive.untar(os.fs.read("addfs.tar")?)?
  expect(es.map(fn(e: archive.Entry) -> Str { e.path })) == ["a.txt", "bin", "bin/big.bin", "bin/run.sh", "empty", "long", "long/" + "n".repeat(120) + "\u{e9}.txt", "z\u{e9}.txt"]
  expect(es[2].data) == zdata256(31, 70000, 256)
  expect(es[2].mode) == 0o600
  expect(es[1].is_dir) == true
}

test "add_fs stops at a symbolic link, and at a missing root" {
  let t = os.fs.sub("addlink")
  t.create_dir_all(".")?
  t.write("x", b"x")?
  t.symlink("x", "y")?
  var f = os.fs.create("addlink.tar")?
  var w = archive.tar_writer(f)
  expect(w.add_fs(t).err().map(fn(e: archive.ArchiveErr) -> Str { e.display() })) == Some("archive: tar_writer: tar: cannot add non-regular file \"y\"")
  f.close()?
  var g = os.fs.create("addlink.zip")?
  var z = archive.zip_writer(g)
  expect(z.add_fs(t).err().map(fn(e: archive.ArchiveErr) -> Str { e.display() })) == Some("archive: zip_writer: zip: cannot add non-regular file \"y\"")
  expect(z.add_fs(os.fs.sub("no-such-dir")).is_err()) == true
  g.close()?
}
