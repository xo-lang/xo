  (2024, 12, 31, 2400, 2, 29, 137025, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (8020, 6, 27, 4102, 11, 13, -1430882, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (6876, 7, 22, 5957, 2, 16, -335815, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (1900, 3, 1, 2100, 2, 28, 73048, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (4973, 1, 10, 2024, 12, 31, -1076745, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (5957, 2, 16, 3099, 8, 27, -1043671, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (3278, 9, 17, 2400, 2, 29, -320884, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (2026, 6, 30, 3689, 3, 4, 607281, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (1969, 12, 31, 1970, 1, 5, 5, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
  (5021, 5, 25, 3162, 1, 8, -679123, "std.md 13.2 Date.days_until (whole days between the two midnights UTC)"),
]

fn show3(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

test "Duration.parse is Go's ParseDuration and Duration displays as Go's String" {
  var bad: List[(Str, Str, Str)] = []
  for (text, ok, want) in DUR_CASES {
    let got = match Duration.parse(text) {
      Ok(d) => "${d}"
      Err(_) => "!error"
    }
    let want_text = if ok { want } else { "!error" }
    if got != want_text {
      bad.push((text, got, want_text))
    }
  }
  expect(show3(bad)) == []
}

test "Duration.parse reads back what a Duration displays" {
  var bad: List[(Str, Str, Str)] = []
  for (text, ok, want) in DUR_CASES {
    if !ok {
      continue
    }
    let got = match Duration.parse(want) {
      Ok(d) => "${d}"
      Err(_) => "!error"
    }
    if got != want {
      bad.push((text, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "from_nanos, from_millis, millis and nanos are Go's" {
  var bad: List[(Str, Str, Str)] = []
  for (ns, want, want_ms) in DUR_NANO_CASES {
    let d = Duration.from_nanos(ns)
    let got = "${d} ${d.millis()} ${d.nanos()}"
    let want_all = "${want} ${want_ms} ${ns}"
    if got != want_all {
      bad.push(("nanos ${ns}", got, want_all))
    }
  }
  for (ms, want, want_ns) in DUR_MILLI_CASES {
    let d = Duration.from_millis(ms)
    let got = "${d} ${d.nanos()}"
    let want_all = "${want} ${want_ns}"
    if got != want_all {
      bad.push(("millis ${ms}", got, want_all))
    }
  }
  expect(show3(bad)) == []
}

test "Time.parse_rfc3339 and format_rfc3339 are Go's RFC 3339 in UTC" {
  var bad: List[(Str, Str, Str)] = []
  for (text, ok, want_text, want_secs, want_ms) in RFC_CASES {
    let got = match Time.parse_rfc3339(text) {
      Some(t) => "${t.format_rfc3339()} ${t.unix()} ${t.unix_millis()}"
      None => "!none"
    }
    let want = if ok {
      "${want_text} ${want_secs} ${want_ms}"
    } else {
      "!none"
    }
    if got != want {
      bad.push((text, got, want))
    }
  }
  expect(show3(bad)) == []
}

test "a layout formats as its Go reference layout and parses back" {
  var bad: List[(Str, Str, Str)] = []
  for (xo, _go, secs, want) in LAYOUT_CASES {
    let t = Time.from_unix(secs)
    let z = time.utc()
    let got = time.format(t, z, xo)
    if got != want {
      bad.push((xo, got, want))
    }
    let cached = time.layout(xo)
    let got2 = cached.format(t, z)
    if got2 != want {
      bad.push((xo, got2, want))
    }
    if cached.display() != xo {
      bad.push((xo, cached.display(), xo))
    }
    // a layout with a date and a time is the only one a round trip can
    // reproduce: the others drop the part they do not name
    if xo.contains("{year}") && xo.contains("{hour}") {
      let back = match cached.parse(want, z) {
        Ok(x) => "${x.unix()}"
        Err(_) => "!err"
      }
      if back != "${secs}" {
        bad.push((xo, back, "${secs}"))
      }
    }
  }
  expect(show3(bad)) == []
}

test "a layout displays as its text, and check_layout decides" {
  let t = Time.from_unix(1700000000)
  let z = time.utc()
  let d = time.layout(time.DATE)
  expect(d.format(t, z)) == "2023-11-14"
  expect(d.display()) == time.DATE
  let ok = match time.check_layout("{year}-{month}") {
    Ok(_) => true
    Err(_) => false
  }
  expect(ok) == true
  let bad = match time.check_layout(not_const("{yr}")) {
    Ok(_) => "ok"
    Err(e) => e.display()
  }
  expect(bad.starts_with("bad layout")) == true
}

/// A layout the checker cannot see through, so it is checked at run time
/// (a constant layout is an error at compile time, XO0420).
fn not_const(s: Str) -> Str { s }

test "from_unix and unix agree with Go" {
  var bad: List[(Str, Str, Str)] = []
  for (secs, want_ms, want_text) in UNIX_CASES {
    let t = Time.from_unix(secs)
    let got = "${t.unix()} ${t.unix_millis()} ${t.format_rfc3339()}"
    let want = "${secs} ${want_ms} ${want_text}"
    if got != want {
      bad.push(("unix ${secs}", got, want))
    }
  }
  expect(show3(bad)) == []
}

test "from_unix_millis and unix_millis agree with Go" {
  var bad: List[(Str, Str, Str)] = []
  for (ms, want_secs, want_text) in MILLI_CASES {
    let t = Time.from_unix_millis(ms)
    let got = "${t.unix()} ${t.unix_millis()} ${t.format_rfc3339()}"
    let want = "${want_secs} ${ms} ${want_text}"
    if got != want {
      bad.push(("millis ${ms}", got, want))
    }
  }
  expect(show3(bad)) == []
}

test "UNIX_EPOCH is from_unix 0" {
  expect(Time.UNIX_EPOCH.unix()) == 0
  expect(Time.UNIX_EPOCH.unix_millis()) == 0
  expect("${Time.UNIX_EPOCH}") == "1970-01-01T00:00:00Z"
}

test "Date.weekday is Go's Weekday" {
  var bad: List[(Str, Str, Str)] = []
  for (y, m, d, want, _) in DATE_WEEKDAY_CASES {
    let got = match time.date(y, m, d) {
      Ok(dt) => "${dt.weekday()}"
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push(("${y}-${m}-${d}", got, want))
    }
  }
  expect(show3(bad)) == []
}

test "Date.add_days is Go's AddDate(0, 0, n)" {
  var bad: List[(Str, Str, Str)] = []
  for (y, m, d, n, want, _) in DATE_DAYS_CASES {
    let got = match time.date(y, m, d) {
      Ok(dt) => "${dt.add_days(n)}"
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push(("${y}-${m}-${d} plus ${n} days", got, want))
    }
  }
  expect(show3(bad)) == []
}

test "Date.add_months clamps the day" {
  var bad: List[(Str, Str, Str)] = []
  for (y, m, d, n, want, _) in DATE_MONTHS_CASES {
    let got = match time.date(y, m, d) {
      Ok(dt) => "${dt.add_months(n)}"
      Err(e) => "!error ${e.display()}"
    }
    if got != want {
      bad.push(("${y}-${m}-${d} plus ${n} months", got, want))
    }
  }
  expect(show3(bad)) == []
}

test "Date.days_until is the whole days between the two dates" {
  var bad: List[(Str, Str, Str)] = []
  for (y1, m1, d1, y2, m2, d2, want, _) in DATE_UNTIL_CASES {
    let got = match time.date(y1, m1, d1) {
      Ok(a) => match time.date(y2, m2, d2) {
        Ok(b) => "${a.days_until(b)}"
        Err(e) => "!error ${e.display()}"
      }
      Err(e) => "!error ${e.display()}"
    }
    if got != "${want}" {
      bad.push(("${y1}-${m1}-${d1} to ${y2}-${m2}-${d2}", got, "${want}"))
    }
  }
  expect(show3(bad)) == []
}

test "local with a fake Env reads no TZ and gives utc" {
  let z = time.local(os.env)?
  expect(z.name()) == "UTC"
}
