// Generated by scripts/stdcorpus from a Go slice model of a double ended
// queue. Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/deque

fn show(x: Int?) -> Str {
  match x {
    Some(v) => "${v}"
    None => "none"
  }
}

test "an empty deque" {
  var d: deque.Deque[Int] = deque.new()
  expect(d.len()) == 0
  expect(d.is_empty()) == true
  expect(show(d.pop_front())) == "none"
  expect(show(d.pop_back())) == "none"
  expect(show(d.front())) == "none"
  expect(show(d.back())) == "none"
  expect(show(d.get(0))) == "none"
  expect(d.to_list()) == []
}

test "a copy shares until written (List's value semantics)" {
  var a: deque.Deque[Int] = deque.new(cap: 2)
  a.push_back(1)
  a.push_back(2)
  var b = a
  b.push_front(0)
  expect(a.to_list()) == [1, 2]
  expect(b.to_list()) == [0, 1, 2]
}

test "heap elements survive the ring's growth and wrap" {
  var d: deque.Deque[Str] = deque.new()
  for i in 0..20 {
    d.push_back("s${i}")
    let _ = d.pop_front()
    d.push_front("f${i}")
  }
  expect(d.len()) == 20
  expect(d.front()) == Some("f19")
  expect(d.back()) == Some("s19")
}

