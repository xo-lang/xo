fn unhex(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

/// Where got and want first differ, with some text around it from each.
fn first_diff(got: Str, want: Str) -> Str {
  let g = got.bytes()
  let w = want.bytes()
  var i = 0
  while i < g.len() && i < w.len() && g[i] == w[i] {
    i += 1
  }
  let lo = (i - 30).max(0)
  "at ${i}: got ${g[lo..(i + 40).min(g.len())].to_str_lossy().quote()} want ${w[lo..(i + 40).min(w.len())].to_str_lossy().quote()}"
}

fn opts(fl: Int) -> prototext.Opts {
  prototext.Opts{multiline: (fl & 1) != 0, emit_ascii: (fl & 2) != 0, emit_unknown: (fl & 4) != 0, allow_partial: (fl & 8) != 0}
}

test "marshal: Go's prototext.Marshal of the message the wire bytes hold" {
  let r = protojson.registry_from_set(unhex(SCHEMA)).or_fault("schema")
  var bad: List[Str] = []
  for (name, fl, wire, want) in MARSHAL {
    let got = match prototext.marshal(r, name, unhex(wire), opts(fl)) {
      Ok(t) => t
      Err(e) => "ERR:" + e.display()
    }
    if got != want {
      bad.push("${name} ${fl} ${wire[0..wire.len().min(40)]}: " + first_diff(got, want))
    }
  }
  expect(bad[0..bad.len().min(4)]) == []
}

fn uopts(fl: Int) -> prototext.UnmarshalOpts {
  prototext.UnmarshalOpts{allow_partial: (fl & 1) != 0, discard_unknown: (fl & 2) != 0, recursion_limit: if (fl & 4) != 0 { 3 } else { 0 }}
}

test "unmarshal: the wire of what Go's prototext.Unmarshal makes of the text" {
  let r = protojson.registry_from_set(unhex(SCHEMA)).or_fault("schema")
  var bad: List[Str] = []
  for (name, fl, text, want) in UNMARSHAL {
    let got = match prototext.unmarshal_bytes(r, name, unhex(text), uopts(fl)) {
      Ok(w) => w.to_hex()
      Err(e) => "ERR:" + e.display()
    }
    // unmarshal takes the text as a Str when it is UTF-8
    match unhex(text).to_str() {
      Some(st) => {
        let got2 = match prototext.unmarshal(r, name, st, uopts(fl)) {
          Ok(w) => w.to_hex()
          Err(e) => "ERR:" + e.display()
        }
        if got2 != got {
          bad.push("${name} ${fl} unmarshal of the Str: " + first_diff(got2, got))
        }
      }
      None => {}
    }
    if got != want {
      bad.push("${name} ${fl} ${unhex(text)[0..text.len().min(120) / 2].to_str_lossy().quote()}: " + first_diff(got, want))
    }
  }
  expect(bad[0..bad.len().min(6)]) == []
}

test "format: Go's prototext.Format" {
  let r = protojson.registry_from_set(unhex(SCHEMA)).or_fault("schema")
  var bad: List[Str] = []
  for (name, wire, want) in FORMAT {
    let got = prototext.format(r, name, unhex(wire))
    if got != want {
      bad.push("${name} ${wire[0..wire.len().min(40)]}: " + first_diff(got, want))
    }
  }
  expect(bad[0..bad.len().min(4)]) == []
}
