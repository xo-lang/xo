/// (JSON text, the Go twin re-encoded)
const SCALARS_VALUES: List[(Str, Str)] = [
  ("{\"i\":1,\"f\":1.5,\"b\":true,\"s\":\"x\"}", "{\"i\":1,\"f\":1.5,\"b\":true,\"s\":\"x\"}"),
  ("{\"i\":-1,\"f\":-0.0,\"b\":false,\"s\":\"\"}", "{\"i\":-1,\"f\":-0,\"b\":false,\"s\":\"\"}"),
  ("{\"i\":0,\"f\":1e21,\"b\":false,\"s\":\"tab\\there\"}", "{\"i\":0,\"f\":1e+21,\"b\":false,\"s\":\"tab\\there\"}"),
  (" {\"i\": 2 , \"f\": 0.5 , \"b\": true , \"s\": \"y\" } ", "{\"i\":2,\"f\":0.5,\"b\":true,\"s\":\"y\"}"),
  ("{\"i\":9223372036854775807,\"f\":5e-324,\"b\":true,\"s\":\"z\"}", "{\"i\":9223372036854775807,\"f\":5e-324,\"b\":true,\"s\":\"z\"}"),
  ("{\"i\":-9223372036854775808,\"f\":1.7976931348623157e+308,\"b\":true,\"s\":\"\"}", "{\"i\":-9223372036854775808,\"f\":1.7976931348623157e+308,\"b\":true,\"s\":\"\"}"),
  ("{\"i\":1,\"f\":1.5,\"b\":true,\"s\":\"x\",\"extra\":123,\"more\":[1]}", "{\"i\":1,\"f\":1.5,\"b\":true,\"s\":\"x\"}"),
  ("{\"i\":1,\"i\":2,\"f\":1.5,\"b\":true,\"s\":\"x\"}", "{\"i\":2,\"f\":1.5,\"b\":true,\"s\":\"x\"}"),
]

fn show3(bad: List[(Str, Str, Str)]) -> List[(Str, Str, Str)] {
  bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]
}

fn int_opt_text(o: Int?) -> Str {
  match o {
    Some(n) => "some ${n}"
    None => "none"
  }
}

/// One typed decode: the value re-encoded, or !error.
fn typed_got[T: Json](text: Str) -> Str {
  match json.decode_str[T](text) {
    Ok(v) => json.encode_str(v)
    Err(e) => "!error ${e.path}: ${e.msg}"
  }
}

test "decode of a struct's fields is Go's, then re-encodes as Go does" {
  var bad: List[(Str, Str, Str)] = []
  for (text, ok, want, why) in SCALARS_CASES {
    let got = match json.decode_str[Scalars](text) {
      Ok(v) => json.encode_str(v)
      Err(_) => "!error"
    }
    let want_text = if ok { want } else { "!error" }
    if got != want_text {
      bad.push(("${text} (${why})", got, want_text))
    }
  }
  expect(show3(bad)) == []
}

