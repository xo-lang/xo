// Generated by scripts/stdcorpus from encoding/json decoding into Go twins of the corpus's types — the text std/rt/json.go encodes, so a decode that differs shows — for std/json's decode and decode_str, then parse_value and from_value against the Value rules of decision 0299 (Int or Float, object key order, duplicate keys) and the malformed texts Go's scanner refuses; Patch[T] fields and their apply_to and apply_opt; Time and Duration fields as std.md 5 and decision 0364 read them (Go's encoding/json tests are Copyright 2009 The Go Authors, BSD-style license) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.

use std/json

// The types the decode cases use, the same shapes as the encode corpus.
enum Level {
  Low
  High
} derive Json

enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
} derive Json

type Email struct(Str)

struct Point {
  x: Int
  y: Int
} derive Json

struct Inner {
  id: Int
  name: Str
} derive Json

struct Scalars {
  i: Int
  f: Float
  b: Bool
  s: Str
} derive Json

struct Opts {
  a: Int?
  b: Str?
  c: Bool?
  d: List[Int]?
} derive Json

struct Enums {
  lvl: Level
  shape: Shape
} derive Json

struct Collections {
  l: List[Str]
  st: Set[Str]
  m: Map[Str, Int]
  pair: (Str, Int)
} derive Json

struct Special {
  bytes: Bytes
  dur: Duration
  when: Time
  mail: Email
} derive Json

struct Defaulted {
  n: Int = 7
  s: Str = "d"
} derive Json

struct Nested {
  inner: Inner
  list: List[Inner]
} derive Json

struct Patched {
  p: json.Patch[Int]
  q: Int
} derive Json

