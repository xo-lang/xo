  expect(show([b"\xef\xbb\xbf:msg", b"\x0d:", b":\x0d", b"\x0a: ", b"b\x0d\x0a\x0a\x0d", b"dat", b"a:1\x0d\x0ad", b"ata\x0d", b"\x0ad", b"ata:-1", b"\x0d\x0a\x0d\x0a", b":-1\x0dx:", b" \x0ddata", b":", b"1\x0d\x0aeve", b"n", b"t:1"])) == "message\u{1}\u{1}1\n\n-1\u{2}last= retry=none"
}

test "random stream 44 (go-sse agrees on its events with data)" {
