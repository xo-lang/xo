  expect(show([body])) == "message\u{1}\u{1}:\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}:\u{2}last= retry=none"
  expect(show([b"x:-1\x0a\x0d", b"\x0a\x0dda", b"ta::", b"\x0d\x0a", b"\x0d\x0a"])) == "message\u{1}\u{1}:\u{2}last= retry=none"
}

test "random stream 45 (go-sse agrees on its events with data)" {
  let body = b"data\x0a: b\x0adata:\xc3\xa9t\xc3\xa9\x0adata:msg\x0d\x0d\x0aid:\x0d\x0aid:\xc3\xa9t\xc3\xa9\x0d\x0adat:\xc3\xa9t\xc3\xa9\x0aData:7x\x0d\x0aevent\x0adat\x0adata:a:b\x0aretry:\xc3\xa9t\xc3\xa9\x0d\x0aevent:-1\x0d\x0a"
  expect(show([body])) == "message\u{1}\u{1}\nété\nmsg\u{2}last=été retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\nété\nmsg\u{2}last=été retry=none"
  expect(show([b"data\x0a: ", b"b", b"\x0adata:", b"\xc3\xa9t", b"\xc3\xa9", b"\x0adata", b":msg\x0d\x0d", b"\x0aid:\x0d\x0a", b"id:\xc3", b"\xa9", b"t\xc3\xa9\x0d", b"\x0ad", b"at:\xc3\xa9", b"t\xc3\xa9\x0a", b"Dat", b"a:7x\x0d\x0ae", b"ven", b"t\x0adat\x0ad", b"ata:a", b":b\x0are", b"tr", b"y:\xc3\xa9t\xc3\xa9", b"\x0d\x0aeve", b"nt:-1", b"\x0d", b"\x0a"])) == "message\u{1}\u{1}\nété\nmsg\u{2}last=été retry=none"
}

