// Generated by scripts/stdcorpus/sseoracle: the WHATWG event stream
// interpretation, checked against the web-platform-tests eventsource
// cases (BSD 3-Clause) and github.com/tmaxmax/go-sse v0.12.0 (MIT).
// Do not edit: regenerate with go run ./scripts/stdcorpus sse.

use std/sse

/// The events of chunks fed in order, then the stream's state, in the
/// oracle's render: type, id and data split by \u{1}, events by \u{2}.
fn show(chunks: List[Bytes]) -> Str {
  var p = sse.parser()
  var o = StrBuilder.new()
  for c in chunks {
    match p.feed(c) {
      Ok(evs) => {
        for e in evs {
          o.write("${e.event}\u{1}${e.id}\u{1}${e.data}\u{2}")
        }
      }
      Err(e) => return "error: ${e.display()}"
    }
  }
  let retry = match p.retry() {
    Some(n) => "${n}"
    None => "none"
  }
  o.write("last=${p.last_event_id()} retry=${retry}")
  o.freeze()
}

fn bytewise(b: Bytes) -> List[Bytes] {
  var out: List[Bytes] = []
  for i in 0..b.len() {
    out.push(b[i..i + 1])
  }
  out
}

test "wpt format-bom" {
  let body = b"\xef\xbb\xbfdata:1\x0a\x0a\xef\xbb\xbfdata:2\x0a\x0adata:3\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}1\u{2}message\u{1}\u{1}3\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}1\u{2}message\u{1}\u{1}3\u{2}last= retry=none"
  expect(show([b"\xef\xbb\xbfd", b"ata:", b"1\x0a", b"\x0a\xef\xbb\xbfdat", b"a", b":2\x0a\x0ad", b"ata", b":3\x0a\x0a\x0a"])) == "message\u{1}\u{1}1\u{2}message\u{1}\u{1}3\u{2}last= retry=none"
}

test "wpt format-bom-2" {
  let body = b"\xef\xbb\xbf\xef\xbb\xbfdata:1\x0a\x0adata:2\x0a\x0adata:3\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}2\u{2}message\u{1}\u{1}3\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}2\u{2}message\u{1}\u{1}3\u{2}last= retry=none"
  expect(show([b"\xef\xbb\xbf\xef", b"\xbb\xbfdat", b"a", b":", b"1\x0a\x0adata", b":2\x0a", b"\x0ad", b"ata", b":", b"3\x0a", b"\x0a\x0a"])) == "message\u{1}\u{1}2\u{2}message\u{1}\u{1}3\u{2}last= retry=none"
}

test "wpt format-bom-split" {
  let body = b"\xef\xbb\xbfdata:1\x0a\x0adata:2\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}1\u{2}message\u{1}\u{1}2\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}1\u{2}message\u{1}\u{1}2\u{2}last= retry=none"
  expect(show([b"\xef\xbb\xbf", b"data:1", b"\x0a\x0adat", b"a:2\x0a\x0a"])) == "message\u{1}\u{1}1\u{2}message\u{1}\u{1}2\u{2}last= retry=none"
}

test "wpt format-comments" {
  let body = b"data:1\x0d:\x00\x0a:\x0d\x0adata:2\x0a:\x0ddata:3\x0a:data:fail\x0d:\x0adata:4\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}1\n2\n3\n4\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}1\n2\n3\n4\u{2}last= retry=none"
  expect(show([b"dat", b"a", b":1\x0d:", b"\x00\x0a:\x0d\x0ada", b"ta:2", b"\x0a:xx", b"xxxxxxx", b"xxxxxxx", b"xxxxxx", b"xxxxxx", b"xxxx", b"xxxx", b"xxxxxxx", b"x", b"x", b"xxxxx", b"xx", b"xxxxx", b"xxxxx", b"x", b"x", b"xxxxx", b"xxx", b"xxxxx", b"xxxxxxx", b"xxxxxx", b"xxx", b"xx", b"xxxx", b"x", b"x", b"xxxx", b"xx", b"xxxx", b"xxxxxxx", b"x", b"x", b"xxxx", b"xxxxx", b"xxxx", b"xxxxx", b"xxxxx", b"x", b"xxxxxxx", b"xxx", b"xx", b"xxxxxxx", b"xxxxxx", b"xx", b"xxxxxxx", b"xx", b"xx", b"xxxxxxx", b"x", b"x", b"xxxx", b"xxxxxxx", b"xxxx", b"xxxxxx", b"xxxxxx", b"xxx", b"x", b"xxxxxxx", b"xx", b"xxx", b"xxxxxxx", b"xxxxxxx", b"x", b"xxx", b"x", b"xxxx", b"xxxxxxx", b"xxxxx", b"xxxxxxx", b"xxxx", b"xx", b"xx", b"xxx", b"xxxx", b"xxx", b"xxxx", b"xxx", b"xxxx", b"xxxxxxx", b"xxxx", b"xx", b"x", b"xx", b"xxxxx", b"x", b"xxxxxx", b"xxxxx", b"xxx", b"xxxxxxx", b"xxxx", b"xxxxxxx", b"xx", b"x", b"xx", b"xxxx", b"xxxx", b"xxxxxx", b"xxxxxxx", b"xxxx", b"xx", b"xxxxxxx", b"xxxx", b"x", b"xx", b"xxxxxx", b"xxx", b"xxxx", b"xxx", b"xxxxxxx", b"xx", b"xx", b"xxxxxxx", b"x", b"xx", b"xxxx", b"xxxx", b"x", b"xxxxx", b"xx", b"xxxxxx", b"x", b"x", b"xxxxxxx", b"xx", b"x", b"x", b"x", b"xxxx", b"xxxxx", b"xxx", b"xxxxxx", b"xx", b"xxx", b"xx", b"xxxxx", b"x", b"xxx", b"xxxxxxx", b"xxxx", b"xxxxx", b"xxxx", b"xx", b"xxxxxxx", b"x", b"xxxxxxx", b"xxxxxx", b"xxxxxxx", b"xxxxx", b"xxxxxxx", b"xxxx", b"xxxxxx", b"xxxxxxx", b"xxxx", b"xx", b"xxx", b"x", b"xxxxxx", b"x", b"xxxxx", b"xxxxx", b"xxxxxxx", b"xxxxxx", b"xx", b"xxxxx", b"xx", b"x", b"xxxx", b"x", b"xxxx", b"x", b"xxxxx", b"xx", b"x", b"xx", b"xxxxxx", b"xxxxxx", b"xx", b"xxxxx", b"xxxxxx", b"xxxxx", b"xxxxx", b"xxxxx", b"xxxxxxx", b"xx", b"xxx", b"xxxxxx", b"xx", b"xxx", b"xxxx", b"xxxxxx", b"xxxx", b"xxx", b"xxxx", b"xxxxxxx", b"x", b"xxxxxxx", b"xx", b"xxx", b"x", b"xx", b"xxxx", b"xxxxx", b"xxxxxx", b"xxxxxx", b"xxx", b"xxxxx", b"xx", b"xxxxxxx", b"xxxxxxx", b"xxxxx", b"xxxxxx", b"xxxx", b"xx", b"xxxx", b"xxxxxx", b"xxxx