  expect(show([b"data:a:", b"b\x0deve", b"n", b"t:042\x0d\x0a", b"Da", b"ta:-1", b"\x0a\x0a\x0aev", b"ent\x0d\x0d", b"\x0aretry:", b"\x00\x0a\x0d\x0aeve", b"nt:", b"\xc3\xa9t\xc3\xa9", b"\x0d\x0ddata", b"::\x0did: ", b"b\x0d\x0a\x0a", b"da", b"ta:7x\x0d\x0d"])) == "042\u{1}\u{1}a:b\u{2}message\u{1}b\u{1}:\u{2}message\u{1}b\u{1}7x\u{2}last=b retry=none"
}

test "random stream 43 (go-sse agrees on its events with data)" {
  let body = b"\xef\xbb\xbf:msg\x0d::\x0d\x0a: b\x0d\x0a\x0a\x0ddata:1\x0d\x0adata\x0d\x0adata:-1\x0d\x0a\x0d\x0a:-1\x0dx: \x0ddata:1\x0d\x0aevent:1"
  expect(show([body])) == "message\u{1}\u{1}1\n\n-1\u{2}last= retry=none"
