", b"xxxxx", b"xxxxxxx", b"xx", b"xx", b"xxxxxx", b"x", b"xxx", b"xxxxxxx", b"xxxx", b"xxx", b"xxxxx", b"x", b"x", b"xxxxx", b"xxxxxx", b"xxxxxxx", b"x", b"xxxxxxx", b"xxx", b"x", b"xxxxx", b"xxx", b"xxx", b"xxxxxx", b"x", b"xxxxx", b"xxxx", b"xxxxxx", b"xxxx", b"xxx", b"xxxxxxx", b"xxxx", b"xxx", b"xxxxxxx", b"x", b"x", b"xxx", b"xxxxxxx", b"x", b"xxx", b"xxxxxx", b"xxxxx", b"xxxxxx", b"xxxx", b"x", b"x", b"xxxxxxx", b"xxxxxx", b"xxxxx", b"xxxxxxx", b"xx", b"xxxxxxx", b"xxxxxxx", b"xxxx", b"xxxxxx", b"x", b"xxx", b"x", b"xxxxxxx", b"xxxxxxx", b"xxxxx", b"xxxx", b"x", b"xxxxxx", b"x", b"xxxxxxx", b"xxxxx", b"xxx", b"x", b"x", b"xx", b"x", b"xxxxx", b"xxx", b"xxx", b"xxx", b"xxxxx", b"xx", b"xxx", b"xxx", b"xxx", b"xx", b"xxx", b"xxx", b"xxxxx", b"xxxx", b"x", b"x", b"xxxxx", b"xxx", b"xx", b"xxxxx", b"x", b"xxxx", b"x", b"xx", b"xx", b"xxxxxx", b"xxxxx", b"xx", b"xxx", b"xxxxxx", b"xxxx", b"xx", b"x", b"xxxxx", b"xxx", b"x", b"xx", b"xxxx", b"xxxxxx", b"x", b"x", b"xxxxx", b"xxxx", b"xxxxxx", b"x", b"xxxxx", b"xx", b"xxxxxxx", b"xxxx", b"xxxxxx", b"xxxxxxx", b"xxxx", b"x", b"xxxxxx", b"xxxxxx", b"xxxxxx", b"xx", b"xxxxx", b"xxxxxxx", b"xxxx", b"xxxx", b"x", b"xx", b"xxx", b"xx", b"xxxxxxx", b"xx", b"xxxxx", b"x", b"xxxxxxx", b"xxxx", b"xx", b"xxx", b"xxxxxxx", b"xxxxxx", b"xxxx", b"xxxxx", b"xxxxxx", b"xxxxx", b"xxx", b"xxxxxxx", b"x", b"x", b"xxxx", b"xxx", b"x", b"xxxxxxx", b"x", b"xxxxxxx", b"xxxxx", b"x", b"xxx", b"x", b"xxxxxx", b"xxxxxx", b"xxxx", b"xxx", b"xxxxxxx", b"x", b"xxxxxxx", b"xxxxx", b"xxx\x0adat", b"a:", b"4\x0a\x0a"])) == "message\u{1}\u{1}1\n2\n3\n4\u{2}last= retry=none"
}

test "wpt format-data-before-final-empty-line" {
  let body = b"retry:1000\x0adata:test1\x0a\x0aid:test\x0adata:test2\x0a"
  expect(show([body])) == "message\u{1}\u{1}test1\u{2}last=test retry=1000"
  expect(show(bytewise(body))) == "message\u{1}\u{1}test1\u{2}last=test retry=1000"
  expect(show([b"retry:1", b"000", b"\x0adata", b":test1", b"\x0a\x0ai", b"d:", b"t", b"est\x0ada", b"ta:te", b"st2\x0a"])) == "message\u{1}\u{1}test1\u{2}last=test retry=1000"
}

test "wpt format-field-data" {
  let body = b"data:\x0a\x0adata\x0adata\x0a\x0adata:test\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}\u{2}message\u{1}\u{1}\n\u{2}message\u{1}\u{1}test\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\u{2}message\u{1}\u{1}\n\u{2}message\u{1}\u{1}test\u{2}last= retry=none"
  expect(show([b"dat", b"a", b":\x0a\x0adat", b"a\x0a", b"data", b"\x0a\x0a", b"data:te", b"st\x0a\x0a\x0a"])) == "message\u{1}\u{1}\u{2}message\u{1}\u{1}\n\u{2}message\u{1}\u{1}test\u{2}last= retry=none"
}

test "wpt format-field-event-empty" {
  let body = b"event: \x0adata:data\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}data\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}data\u{2}last= retry=none"
  expect(show([b"ev", b"ent: \x0ad", b"ata", b":data\x0a\x0a", b"\x0a"])) == "message\u{1}\u{1}data\u{2}last= retry=none"
}

test "wpt format-field-event" {
  let body = b"event:test\x0adata:x\x0a\x0adata:x\x0a\x0a\x0a"
  expect(show([body])) == "test\u{1}\u{1}x\u{2}message\u{1}\u{1}x\u{2}last= retry=none"
  expect(show(bytewise(body))) == "test\u{1}\u{1}x\u{2}message\u{1}\u{1}x\u{2}last= retry=none"
  expect(show([b"even", b"t:", b"test", b"\x0adata:", b"x", b"\x0a\x0ad", b"ata:x", b"\x0a\x0a", b"\x0a"])) == "test\u{1}\u{1}x\u{2}message\u{1}\u{1}x\u{2}last= retry=none"
}

test "wpt format-field-id (last-event-id.py)" {
  let body = b"id: \xe2\x80\xa6\x0aretry: 200\x0adata: hello\x0a\x0a"
  expect(show([body])) == "message\u{1}…\u{1}hello\u{2}last=… retry=200"
  expect(show(bytewise(body))) == "message\u{1}…\u{1}hello\u{2}last=… retry=200"
  expect(show([b"id", b": \xe2", b"\x80\xa6\x0are", b"t", b"r", b"y: 2", b"00\x0ad", b"ata", b": hel", b"lo\x0a", b"\x0a"])) == "message\u{1}…\u{1}hello\u{2}last=… retry=200"
}

test "wpt format-field-parsing" {
  let body = b"data:\x00\x0adata:  2\x0dData:1\x0adata\x00:2\x0adata:1\x0d\x00data:4\x0ada-ta:3\x0ddata_5\x0adata:3\x0ddata:\x0d\x0a data:32\x0adata:4\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}\u{0}\n 2\n1\n3\n\n4\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\u{0}\n 2\n1\n3\n\n4\u{2}last= retry=none"
  expect(show([b"da", b"ta:\x00\x0ad", b"a", b"ta: ", b" 2\x0dData", b":1\x0ada", b"ta", b"\x00:2", b"\x0ada", b"t", b"a:1\x0d", b"\x00d", b"a", b"ta:4\x0a", b"da-ta", b":3\x0dd", b"at", b"a_5\x0a", b"dat", b"a", b":3\x0ddat", b"a:\x0d", b"\x0a data", b":", b"32\x0adata", b":4\x0a", b"\x0a"])) == "message\u{1}\u{1}\u{0}\n 2\n1\n3\n\n4\u{2}last= retry=none"
}

test "wpt format-field-retry-empty" {
  let body = b"retry\x0adata:test\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}test\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}test\u{2}last= retry=none"
  expect(show([b"retr", b"y\x0ada", b"ta:t", b"est\x0a\x0a\x0a"])) == "message\u{1}\u{1}test\u{2}last= retry=none"
}

test "wpt format-field-retry" {
  let body = b"retry:03000\x0adata:x\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}x\u{2}last= retry=3000"
  expect(show(bytewise(body))) == "message\u{1}\u{1}x\u{2}last= retry=3000"
  expect(show([b"ret", b"ry:030", b"00\x0ad", b"a", b"ta:x", b"\x0a\x0a\x0a"])) == "message\u{1}\u{1}x\u{2}last= retry=3000"
}

test "wpt format-field-retry-bogus" {
  let body = b"retry:3000\x0aretry:1000x\x0adata:x\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}x\u{2}last= retry=3000"
  expect(show(bytewise(body))) == "message\u{1}\u{1}x\u{2}last= retry=3000"
  expect(show([b"ret", b"r", b"y:3", b"0", b"00", b"\x0a", b"r", b"etry:1", b"00", b"0x\x0adata", b":x\x0a\x0a", b"\x0a"])) == "message\u{1}\u{1}x\u{2}last= retry=3000"
}

test "wpt format-field-retry-bogus-2" {
  let body = b"retry:1000\x0aretry:5000x\x0adata:x\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}x\u{2}last= retry=1000"
  expect(show(bytewise(body))) == "message\u{1}\u{1}x\u{2}last= retry=1000"
  expect(show([b"ret", b"ry", b":", b"1000\x0are", b"t", b"ry:5000", b"x\x0a", b"data:", b"x\x0a", b"\x0a\x0a"])) == "message\u{1}\u{1}x\u{2}last= retry=1000"
}

test "wpt format-field-unknown" {
  let body = b"data:test\x0a data\x0adata\x0afoobar:xxx\x0ajustsometext\x0a:thisisacommentyay\x0adata:test\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}test\n\ntest\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}test\n\ntest\u{2}last= retry=none"
  expect(show([b"data:", b"t", b"es", b"t\x0a data", b"\x0adata\x0af", b"oobar:", b"xxx\x0ajus", b"tsomete", b"xt", b"\x0a", b":thi", b"si", b"sa", b"comment", b"yay\x0ada", b"ta:test", b"\x0a\x0a\x0a"])) == "message\u{1}\u{1}test\n\ntest\u{2}last= retry=none"
}

test "wpt format-leading-space" {
  let body = b"data:\x09test\x0ddata: \x0adata:test\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}\ttest\n\ntest\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\ttest\n\ntest\u{2}last= retry=none"
  expect(show([b"data:", b"\x09tes", b"t\x0d", b"data: ", b"\x0adata", b":te", b"s", b"t\x0a\x0a\x0a"])) == "message\u{1}\u{1}\ttest\n\ntest\u{2}last= retry=none"
}

test "wpt format-newlines" {
  let body = b"data:test\x0d\x0adata\x0adata:test\x0d\x0a\x0d\x0a"
  expect(show([body])) == "message\u{1}\u{1}test\n\ntest\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}test\n\ntest\u{2}last= retry=none"
  expect(show([b"d", b"ata", b":test\x0d\x0a", b"data\x0ad", b"ata:tes", b"t\x0d\x0a", b"\x0d\x0a"])) == "message\u{1}\u{1}test\n\ntest\u{2}last= retry=none"
}

test "wpt format-null-character" {
  let body = b"data:\x00\x0a\x0a\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}\u{0}\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\u{0}\u{2}last= retry=none"
  expect(show([b"data", b":\x00\x0a\x0a\x0a\x0a\x0a"])) == "message\u{1}\u{1}\u{0}\u{2}last= retry=none"
}

test "wpt format-utf-8" {
  let body = b"data:ok\xe2\x80\xa6\x0a\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}ok…\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}ok…\u{2}last= retry=none"
  expect(show([b"data:ok", b"\xe2\x80\xa6\x0a\x0a\x0a"])) == "message\u{1}\u{1}ok…\u{2}last= retry=none"
}

test "wpt event-data (message2.py)" {
  let body = b"data:msg\x0adata: msg\x0a\x0a:\x0afalsefield:msg\x0a\x0afalsefield:msg\x0aData:data\x0a\x0adata\x0a\x0adata:end\x0a\x0a"
  expect(show([body])) == "message\u{1}\u{1}msg\nmsg\u{2}message\u{1}\u{1}\u{2}message\u{1}\u{1}end\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}msg\nmsg\u{2}message\u{1}\u{1}\u{2}message\u{1}\u{1}end\u{2}last= retry=none"
  expect(show([b"data:m", b"sg\x0ad", b"ata", b": ", b"msg\x0a\x0a:\x0a", b"f", b"alsefie", b"ld:msg\x0a", b"\x0a", b"falsef", b"ield:ms", b"g", b"\x0aD", b"ata:", b"data\x0a\x0a", b"data", b"\x0a\x0adata:", b"e", b"nd\x0a\x0a"])) == "message\u{1}\u{1}msg\nmsg\u{2}message\u{1}\u{1}\u{2}message\u{1}\u{1}end\u{2}last= retry=none"
}

test "random stream 0 (go-sse agrees on its events with data)" {
  let body = b"dat:msg\x0ddata:1\x0d\x0a:042\x0d\x0a\x0d\x0a\x0ddat:7x\x0ddata:\x0d\x0adata:\x00\x0d\x0adat: b\x0ddata:-1\x0d\x0adata: \x0a"
  expect(show([body])) == "message\u{1}\u{1}1\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}1\u{2}last= retry=none"
  expect(show([b"dat", b":", b"msg", b"\x0ddata:", b"1\x0d\x0a:0", b"42\x0d\x0a\x0d", b"\x0a\x0ddat", b":7x\x0dda", b"ta:\x0d\x0ada", b"ta:\x00", b"\x0d\x0a", b"dat:", b" b\x0ddata", b":-", b"1", b"\x0d\x0a", b"data: ", b"\x0a"])) == "message\u{1}\u{1}1\u{2}last= retry=none"
}

test "random stream 1 (go-sse agrees on its events with data)" {
  let body = b"dat:\x00\x0d\x0d\x0aData::\x0d\x0aretry:a:b\x0d: b\x0d\x0adata"
  expect(show([body])) == "last= retry=none"
  expect(show(bytewise(body))) == "last= retry=none"
  expect(show([b"dat:", b"\x00\x0d\x0d\x0a", b"Da", b"ta:", b":", b"\x0d\x0aretry", b":a", b":b\x0d: b", b"\x0d", b"\x0ada", b"ta"])) == "last= retry=none"
}

test "random stream 2 (go-sse agrees on its events with data)" {
  let body = b"\xef\xbb\xbfdata: \x0d\x0adata::\x0d:msg\x0ax:\x0d\x0ax\x0dretry:a\x0d\x0adat:-1\x0d\x0a\x0aid:a\x0ddata:\xff\xfe\x0d\x0a\x0d\x0a: \x0adata:  c\x0aid:042\x0d"
  expect(show([body])) == "message\u{1}\u{1}\n:\u{2}message\u{1}a\u{1}��\u{2}last=042 retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\n:\u{2}message\u{1}a\u{1}��\u{2}last=042 retry=none"
  expect(show([b"\xef\xbb\xbf", b"da", b"ta: \x0d\x0ad", b"ata::\x0d", b":msg\x0ax", b":\x0d\x0ax", b"\x0dr", b"et", b"ry:", b"a\x0d\x0adat:", b"-1\x0d", b"\x0a\x0a", b"id", b":a", b"\x0dd", b"ata", b":\xff\xfe\x0d\x0a\x0d\x0a", b":", b" \x0ada", b"ta", b": ", b" c", b"\x0aid:0", b"42", b"\x0d"])) == "message\u{1}\u{1}\n:\u{2}message\u{1}a\u{1}��\u{2}last=042 retry=none"
}

test "random stream 3 (go-sse agrees on its events with data)" {
  let body = b"id\x0d\x0a\x0d\x0aretry: \x0aid:  c\x0d\x0a\x0a:  c\x0ddata:7x\x0d\x0aid:a\x0adata:a:b\x0aData:msg\x0d\x0a\x0d\x0a\x0ddat:msg\x0d\x0adata::\x0d\x0a"
  expect(show([body])) == "message\u{1}a\u{1}7x\na:b\u{2}last=a retry=none"
  expect(show(bytewise(body))) == "message\u{1}a\u{1}7x\na:b\u{2}last=a retry=none"
  expect(show([b"id\x0d\x0a\x0d\x0ar", b"etry:", b" \x0a", b"id: ", b" c", b"\x0d\x0a", b"\x0a", b": ", b" c\x0dd", b"ata:7x\x0d", b"\x0aid:a\x0ad", b"a", b"t", b"a:a:b\x0aD", b"ata:", b"m", b"sg", b"\x0d\x0a\x0d", b"\x0a\x0ddat:", b"msg\x0d\x0ad", b"ata::\x0d", b"\x0a"])) == "message\u{1}a\u{1}7x\na:b\u{2}last=a retry=none"
}

test "random stream 4 (go-sse agrees on its events with data)" {
  let body = b"\x0a:\x00\x0ax\x0adata:a\x0d\x0a\x0d\x0aid\x0d\x0a\x0d\x0adata: b\x0dData:msg\x0adat:  c\x0d\x0adata:\x0d\x0a\x0d\x0a"
  expect(show([body])) == "message\u{1}\u{1}a\u{2}message\u{1}\u{1}b\n\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}a\u{2}message\u{1}\u{1}b\n\u{2}last= retry=none"
  expect(show([b"\x0a:\x00\x0ax\x0a", b"data:a\x0d", b"\x0a", b"\x0d", b"\x0aid\x0d\x0a\x0d\x0a", b"dat", b"a: ", b"b", b"\x0dData:m", b"sg\x0a", b"d", b"at:", b"  c\x0d\x0ad", b"ata:\x0d\x0a\x0d", b"\x0a"])) == "message\u{1}\u{1}a\u{2}message\u{1}\u{1}b\n\u{2}last= retry=none"
}

test "random stream 5 (go-sse agrees on its events with data)" {
  let body = b"data:\xff\xfe\x0adat:msg\x0d\x0a:1\x0aevent:a:b\x0a:a:b\x0a\x0ddata: \x0a\x0d\x0adata:  c\x0d\x0aData\x0d\x0aid:\xff\xfe"
  expect(show([body])) == "a:b\u{1}\u{1}��\u{2}message\u{1}\u{1}\u{2}last= retry=none"
  expect(show(bytewise(body))) == "a:b\u{1}\u{1}��\u{2}message\u{1}\u{1}\u{2}last= retry=none"
  expect(show([b"data:\xff", b"\xfe\x0ada", b"t:msg\x0d", b"\x0a:1\x0aeve", b"nt:", b"a", b":b\x0a:", b"a:b\x0a\x0dda", b"t", b"a", b":", b" ", b"\x0a\x0d\x0ad", b"ata:", b"  c\x0d\x0a", b"Data\x0d\x0a", b"id:\xff", b"\xfe"])) == "a:b\u{1}\u{1}��\u{2}message\u{1}\u{1}\u{2}last= retry=none"
}

test "random stream 6 (go-sse agrees on its events with data)" {
  let body = b"retry: \x0d\x0a\x0d\x0a\x0aid:1\x0d\x0a\x0d\x0aevent:a\x0d\x0adata: b\x0did\x0ddata:a:b\x0adat\x0d\x0d\x0d\x0aretry:7x\x0a\x0a"
  expect(show([body])) == "a\u{1}\u{1}b\na:b\u{2}last= retry=none"
  expect(show(bytewise(body))) == "a\u{1}\u{1}b\na:b\u{2}last= retry=none"
  expect(show([b"r", b"etry: ", b"\x0d\x0a\x0d", b"\x0a\x0a", b"id:1\x0d\x0a", b"\x0d\x0a", b"eve", b"nt:a", b"\x0d\x0adata:", b" b\x0d", b"id\x0ddata", b":", b"a:b\x0adat", b"\x0d", b"\x0d\x0d\x0aret", b"ry:7x\x0a\x0a"])) == "a\u{1}\u{1}b\na:b\u{2}last= retry=none"
}

test "random stream 7 (go-sse agrees on its events with data)" {
  let body = b"dat\x0adata:a:b\x0d\x0a\x0ddat: \x0a\x0d\x0d\x0adata\x0a:msg\x0d\x0adata:msg\x0a"
  expect(show([body])) == "message\u{1}\u{1}a:b\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}a:b\u{2}last= retry=none"
  expect(show([b"dat\x0a", b"data", b":a:b\x0d\x0a\x0d", b"dat: \x0a\x0d", b"\x0d\x0a", b"data", b"\x0a:msg", b"\x0d", b"\x0a", b"data:", b"msg\x0a"])) == "message\u{1}\u{1}a:b\u{2}last= retry=none"
}

test "random stream 8 (go-sse agrees on its events with data)" {
  let body = b"retry:\xff\xfe\x0d\x0aData:7x\x0a\x0a"
  expect(show([body])) == "last= retry=none"
  expect(show(bytewise(body))) == "last= retry=none"
  expect(show([b"retry:\xff", b"\xfe\x0d\x0aData", b":7x\x0a\x0a"])) == "last= retry=none"
}

test "random stream 9 (go-sse agrees on its events with data)" {
  let body = b":1\x0ddata:7x\x0a\x0d\x0a\x0d:1\x0dData:-1\x0d\x0adata:msg\x0d"
  expect(show([body])) == "message\u{1}\u{1}7x\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}7x\u{2}last= retry=none"
  expect(show([b":", b"1\x0d", b"data", b":7x\x0a", b"\x0d\x0a", b"\x0d:1\x0dDat", b"a:-1", b"\x0d\x0adata:", b"msg\x0d"])) == "message\u{1}\u{1}7x\u{2}last= retry=none"
}

test "random stream 10 (go-sse agrees on its events with data)" {
  let body = b"event:a:b\x0d\x0adata:a:b\x0ddat:042\x0devent:\x0d\x0a:msg\x0ddata:7x\x0d\x0a"
  expect(show([body])) == "last= retry=none"
  expect(show(bytewise(body))) == "last= retry=none"
  expect(show([b"eve", b"nt:a:b", b"\x0d\x0a", b"da", b"t", b"a:a:b\x0d", b"d", b"a", b"t:04", b"2", b"\x0d", b"e", b"vent:\x0d", b"\x0a:m", b"sg\x0ddata", b":7x\x0d\x0a"])) == "last= retry=none"
}

test "random stream 11 (go-sse agrees on its events with data)" {
  let body = b"\xef\xbb\xbfid:7x\x0ddata:\xc3\xa9t\xc3\xa9\x0ax\x0ddata:\xff\xfe\x0d\x0a\x0ddata:-1\x0a\x0d\x0a\x0d\x0adat:a\x0d\x0a\x0d\x0d\x0a\x0a:  c\x0d\x0d\x0a"
  expect(show([body])) == "message\u{1}7x\u{1}été\n��\u{2}message\u{1}7x\u{1}-1\u{2}last=7x retry=none"
  expect(show(bytewise(body))) == "message\u{1}7x\u{1}été\n��\u{2}message\u{1}7x\u{1}-1\u{2}last=7x retry=none"
  expect(show([b"\xef\xbb\xbfid:", b"7x\x0dd", b"ata:\xc3", b"\xa9", b"t\xc3\xa9\x0ax\x0d", b"data:\xff", b"\xfe\x0d\x0a\x0dd", b"ata:-1", b"\x0a\x0d", b"\x0a\x0d\x0a", b"da", b"t:a\x0d", b"\x0a", b"\x0d", b"\x0d", b"\x0a\x0a", b":  ", b"c\x0d\x0d\x0a"])) == "message\u{1}7x\u{1}été\n��\u{2}message\u{1}7x\u{1}-1\u{2}last=7x retry=none"
}

test "random stream 12 (go-sse agrees on its events with data)" {
  let body = b"\xef\xbb\xbfData: b\x0dx:msg\x0a: \x0d\x0d\x0aevent:042\x0ddata:a\x0d\x0a:\xff\xfe\x0aid\x0d\x0d\x0a\x0a\x0did: b\x0d\x0a\x0ddata\x0d\x0a:1"
  expect(show([body])) == "042\u{1}\u{1}a\u{2}last=b retry=none"
  expect(show(bytewise(body))) == "042\u{1}\u{1}a\u{2}last=b retry=none"
  expect(show([b"\xef\xbb\xbfData", b": b", b"\x0dx:m", b"s", b"g\x0a: \x0d\x0d", b"\x0ae", b"vent:", b"042\x0dd", b"a", b"ta", b":a", b"\x0d\x0a", b":\xff\xfe\x0a", b"id\x0d", b"\x0d\x0a\x0a\x0did:", b" b\x0d\x0a\x0dda", b"ta\x0d\x0a:1"])) == "042\u{1}\u{1}a\u{2}last=b retry=none"
}

test "random stream 13 (go-sse agrees on its events with data)" {
  let body = b"\xef\xbb\xbfdat:1\x0a: b\x0d\x0a\x0d:  c\x0a\x0d:  c\x0d\x0adata\x0d\x0a\x0d\x0a"
  expect(show([body])) == "message\u{1}\u{1}\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\u{2}last= retry=none"
  expect(show([b"\xef\xbb\xbfda", b"t:1", b"\x0a: b\x0d", b"\x0a\x0d", b":  c\x0a", b"\x0d:  c\x0d\x0a", b"data\x0d\x0a", b"\x0d\x0a"])) == "message\u{1}\u{1}\u{2}last= retry=none"
}

test "random stream 14 (go-sse agrees on its events with data)" {
  let body = b"data:  c\x0d\x0adat\x0d\x0aData:1\x0d\x0a\x0d\x0adat\x0d\x0aevent:msg\x0d\x0aevent:a:b\x0d\x0a\x0aData\x0aid:\x00\x0d\x0a"
  expect(show([body])) == "message\u{1}\u{1} c\u{2}last= retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1} c\u{2}last= retry=none"
  expect(show([b"d", b"at", b"a:  c", b"\x0d\x0adat\x0d\x0a", b"Dat", b"a", b":", b"1\x0d\x0a", b"\x0d\x0ada", b"t\x0d\x0a", b"ev", b"en", b"t:", b"msg", b"\x0d\x0aev", b"ent:", b"a:b\x0d\x0a\x0aD", b"ata\x0a", b"id:\x00\x0d\x0a"])) == "message\u{1}\u{1} c\u{2}last= retry=none"
}

test "random stream 15 (go-sse agrees on its events with data)" {
  let body = b"data:\x00\x0d\x0adata:  c\x0d\x0a\x0d\x0d\x0a\x0d\x0ax:042\x0did:  c\x0ddata:  c\x0d\x0a:  c\x0d\x0adata:\x0d\x0adat\x0d\x0a:7x\x0d"
  expect(show([body])) == "message\u{1}\u{1}\u{0}\n c\u{2}last= c retry=none"
  expect(show(bytewise(body))) == "message\u{1}\u{1}\u{0}\n c\u{2}last= c retry=none"
  expect(show([b"data:\x00\x0d", b"\x0adata: ", b" c\x0d", b"\x0a\x0d\x0d\x0a\x0d\x0a", b"x:04", b"2\x0did:  ", b"c\x0ddata:", b"  c\x0d\x0a: ", b" ", b"c\x0d", b"\x0adata:\x0d", b"\x0adat\x0d", b"\x0a:", b"7x\x0d"])) == "message\u{1}\u{1}\u{0}\n c\u{2}last= c retry=none"
}

test "random stream 16 (go-sse agrees on its events with data)" {
  let body = b"\x0a\x0d\x0d\x0adat\x0d\x0adata:  c\x0a:\xff\xfe\x0d\x0a:\x00\x0ddata:042"
  expect(show([body])) == "last= retry=none"
  expect(show(bytewise(body))) == "last= retry=none"
  expect(show([b"\x0a", b"\x0d\x0d\x0ada", b"t\x0d\x0ad", b"ata:  ", b"c\x0a:\xff", b"\xfe\x0d\x0a:", b"\x00\x0dda", b"ta:", b"04", b"2"])) == "last= retry=none"
}

test "random stream 17 (go-sse agrees on its events with data)" {
  let body = b"\xef\xbb\xbf\x0a: b\x0ddata: \x0a\x0ax:a:b\x0d\x0aid: b\x0d\x0did:\x00\x0aData::\x0d\x0adata:msg\x0a:\xc3\xa9t\xc3\xa9"
  expect(show([body])) == "message\u{1}\u{1}\u{2}last=b retry=none"
