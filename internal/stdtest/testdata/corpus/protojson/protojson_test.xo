fn hex(b: Bytes) -> Str {
  let digits = "0123456789abcdef".bytes()
  var o = BytesBuilder.new()
  for c in b {
    o.write_byte(digits[Int(c) / 16])
    o.write_byte(digits[Int(c) % 16])
  }
  o.freeze().to_str_lossy()
}

fn unhex(s: Str) -> Bytes {
  var o = BytesBuilder.new()
  let b = s.bytes()
  var i = 0
  while i + 1 < b.len() {
    o.write_byte(UInt8.wrapping_from(nib(Int(b[i])) * 16 + nib(Int(b[i + 1]))))
    i += 2
  }
  o.freeze()
}

fn nib(c: Int) -> Int { if c >= 97 { c - 87 } else { c - 48 } }

fn registry() -> protojson.Registry {
  protojson.registry_from_set(unhex(SCHEMA)).or_fault("schema")
}

fn opts(flags: Int) -> protojson.Opts {
  protojson.Opts{proto_names: flags & 1 != 0, emit_defaults: flags & 2 != 0, emit_unpopulated: flags & 8 != 0, enum_numbers: flags & 4 != 0, discard_unknown: false}
}

test "marshal equals Go's protojson" {
  let r = registry()
  for (name, flags, wire, want) in MARSHAL {
    let got = protojson.marshal(r, name, unhex(wire), opts(flags)).or_fault("marshal " + name)
    if got != want {
      expect("${name} ${flags} ${wire}: ${got}") == "${name} ${flags} ${wire}: ${want}"
    }
  }
}

test "marshal of proto2 required fields equals Go's protojson, a missing one an error" {
  let r = registry()
  for (name, wire, want, partial) in MARSHAL2 {
    let got = match protojson.marshal(r, name, unhex(wire), opts(0)) {
      Ok(j) => j
      Err(_) => "error"
    }
    if got != want {
      expect("${name} ${wire}: ${got}") == "${name} ${wire}: ${want}"
    }
    let pgot = match protojson.marshal(r, name, unhex(wire), protojson.Opts{allow_partial: true}) {
      Ok(j) => j
      Err(_) => "error"
    }
    if pgot != partial {
      expect("partial ${name} ${wire}: ${pgot}") == "partial ${name} ${wire}: ${partial}"
    }
  }
}

test "multiline marshal equals Go's protojson Multiline and Indent" {
  let r = registry()
  for (name, indent, wire, want) in MULTILINE {
    let got = protojson.marshal(r, name, unhex(wire), protojson.Opts{multiline: true, indent: indent}).or_fault("marshal " + name)
    if got != want {
      expect("${name} ${indent.quote()} ${wire}: ${got}") == "${name} ${indent.quote()} ${wire}: ${want}"
    }
  }
  expect(protojson.marshal(r, "pjt.Scalars", b"", protojson.Opts{indent: "x"}) is Err(_)) == true
}

test "normalize equals Go's proto.Unmarshal then Marshal, unknown fields kept" {
  let r = registry()
  for (name, input, want) in NORMALIZE {
    let got = match protojson.normalize(r, name, unhex(input)) {
      Ok(b) => hex(b)
      Err(_) => "error"
    }
    if got != want {
      expect("${name} ${input}: ${got}") == "${name} ${input}: ${want}"
    }
  }
}

test "unmarshal with AllowPartial and RecursionLimit equals Go's protojson" {
  let r = registry()
  for (name, input, partial, limit, want) in UNMARSHAL_OPTS {
    let got = match protojson.unmarshal(r, name, input, protojson.Opts{allow_partial: partial, recursion_limit: limit}) {
      Ok(b) => hex(b)
      Err(_) => "error"
    }
    if got != want {
      expect("${name} ${input} ${partial} ${limit}: ${got}") == "${name} ${input} ${partial} ${limit}: ${want}"
    }
  }
}

test "unmarshal equals Go's protojson, errors included" {
  let r = registry()
  for (name, input, want) in UNMARSHAL {
    let got = match protojson.unmarshal(r, name, input, opts(0)) {
      Ok(b) => hex(b)
      Err(_) => "error"
    }
    if got != want {
      expect("${name} ${input}: ${got}") == "${name} ${input}: ${want}"
    }
  }
}
