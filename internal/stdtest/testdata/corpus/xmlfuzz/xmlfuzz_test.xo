  let strict = xf_line(doc, 0)
  if strict != "err XML syntax error on line 1: expected element name after <" {
    fault("strict: got " + strict)
  }
  let html = xf_line(doc, 1)
  if html != "err XML syntax error on line 1: expected element name after <" {
    fault("html: got " + html)
  }
  let raw = xf_line(doc, 2)
  if raw != "err XML syntax error on line 1: expected element name after <" {
    fault("raw: got " + raw)
  }
}

