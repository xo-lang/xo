// Generated by scripts/stdcorpus from std/metrics' Registry.counter, gauge and histogram, their series with label values, `observe` against the default latency buckets, and Registry.text's Prometheus 0.0.4 exposition line for line (std.md 37) (go1.26.1).
// Do not edit: regenerate with go run ./scripts/stdcorpus.
use std/http
use std/metrics

test "a counter, a gauge and a histogram expose Prometheus text (std.md 37)" {
  let r = metrics.registry()
  let reqs = r.counter("requests_total", "Requests by route.", ["route"])
  reqs.inc(["a"])
  reqs.add(2.0, ["a"])
  reqs.inc(["b"])
  let inflight = r.gauge("in_flight", "Requests being served.")
  inflight.set(3.0)
  inflight.add(-1.0)
  let b = metrics.latency_buckets()
  expect(b.len()) == 11
  expect(b[0]) == 0.005
  expect(b[10]) == 10.0
  // buckets is left to its default (latency_buckets(), the only call default
  // in std), so this is the program that proves the default evaluates on
  // every backend
  let lat = r.histogram("req_seconds", "Request latency.", [])
  // 0.25 and 0.5 are bucket bounds: each lands in its own bucket and every
  // later one, since the counts are cumulative
  lat.observe(0.25)
  lat.observe(0.5)
  let t = r.text()
  // instruments in the order they were made, each with its HELP and TYPE
  expect(t.contains("# HELP requests_total Requests by route.\n# TYPE requests_total counter\n")) == true
  expect(t.contains("requests_total{route=\"a\"} 3\n")) == true
  expect(t.contains("requests_total{route=\"b\"} 1\n")) == true
  expect(t.contains("# HELP in_flight Requests being served.\n# TYPE in_flight gauge\n")) == true
  expect(t.contains("\nin_flight 2\n")) == true
  expect(t.contains("# TYPE req_seconds histogram\n")) == true
  expect(t.contains("req_seconds_bucket{le=\"0.005\"} 0\n")) == true
  expect(t.contains("req_seconds_bucket{le=\"0.1\"} 0\n")) == true
  expect(t.contains("req_seconds_bucket{le=\"0.25\"} 1\n")) == true
  expect(t.contains("req_seconds_bucket{le=\"0.5\"} 2\n")) == true
  expect(t.contains("req_seconds_bucket{le=\"10\"} 2\n")) == true
  expect(t.contains("req_seconds_bucket{le=\"+Inf\"} 2\n")) == true
  expect(t.contains("req_seconds_sum 0.75\n")) == true
  expect(t.contains("req_seconds_count 2\n")) == true
  expect(t.contains("xo_metrics_dropped_total 0\n")) == true
  // one line per bucket plus +Inf, the sum and the count
  let lines = t.split("\n")
  var buckets = 0
  for line in lines {
    if line.contains("req_seconds_bucket{") {
      buckets += 1
    }
  }
  expect(buckets) == 12
  // the exposition ends with a newline, so the last piece is empty
  expect(lines[lines.len() - 1]) == ""
}

test "a series is one per label value, and its labels are in the order the instrument named them" {
  let r = metrics.registry()
  let c = r.counter("hits_total", "Hits.", ["method", "code"])
  c.inc(["GET", "200"])
  c.inc(["GET", "200"])
  c.inc(["POST", "500"])
  let t = r.text()
  expect(t.contains("hits_total{method=\"GET\",code=\"200\"} 2\n")) == true
  expect(t.contains("hits_total{method=\"POST\",code=\"500\"} 1\n")) == true
  // two series, the two header lines of the instrument, and the three
  // lines of the dropped counter, plus the empty piece after the last
  // newline
  expect(t.split("\n").len()) == 8
}

test "remove drops one series and says whether there was one, reset drops them all (DeleteLabelValues, Reset)" {
  let r = metrics.registry()
  let c = r.counter("jobs_total", "Jobs.", ["queue"])
  c.inc(["a"])
  c.inc(["b"])
  let h = r.histogram("job_seconds", "Job time.", ["queue"], [1.0])
  h.observe(0.5, ["a"])
  h.observe(2.0, ["b"])
  let s = r.summary("job_bytes", "Job size.", ["queue"], [(0.5, 0.05)])
  s.observe(10.0, ["a"])
  s.observe(20.0, ["b"])
  expect(c.remove(["a"])) == true
  // a second remove finds nothing, and so do label values never seen
  expect(c.remove(["a"])) == false
  expect(c.remove(["zz"])) == false
  expect(h.remove(["b"])) == true
  expect(h.remove(["b"])) == false
  expect(s.remove(["a"])) == true
  expect(s.remove(["a"])) == false
  let t = r.text()
  expect(t.contains("jobs_total{queue=\"a\"}")) == false
  expect(t.contains("jobs_total{queue=\"b\"} 1\n")) == true
  expect(t.contains("job_seconds_bucket{queue=\"b\"")) == false
  expect(t.contains("job_seconds_bucket{queue=\"a\",le=\"1\"} 1\n")) == true
  expect(t.contains("job_seconds_count{queue=\"a\"} 1\n")) == true
  expect(t.contains("job_bytes_sum{queue=\"a\"}")) == false
  expect(t.contains("job_bytes{queue=\"b\",quantile=\"0.5\"} 20\n")) == true
  expect(t.contains("job_bytes_count{queue=\"b\"} 1\n")) == true
  c.reset()
  h.reset()
  s.reset()
  let after = r.text()
  expect(after.contains("jobs_total{")) == false
  expect(after.contains("job_seconds_bucket{")) == false
  expect(after.contains("job_seconds_count{")) == false
  expect(after.contains("job_bytes{")) == false
  expect(after.contains("job_bytes_count{")) == false
  // a series made again after reset starts from zero
  c.inc(["b"])
  expect(r.text().contains("jobs_total{queue=\"b\"} 1\n")) == true
}

test "handler_at answers the text exposition at the clock's time" {
  let r = metrics.registry()
  let g = r.gauge("temp", "Temperature.")
  g.set(21.5)
  let serve = r.handler_at(os.clock)
  let u = http.Url{scheme: "http", host: "h", port: None, path: "/metrics", query: {}}
  let resp = serve(http.Request{method: "GET", path: "/metrics", url: u, headers: {}, body: b"", remote_ip: ""})
  expect(resp.status) == 200
  expect(resp.headers.get("Content-Type")) == Some("text/plain; version=0.0.4; charset=utf-8")
  let body = resp.body.to_str_lossy()
  expect(body) == r.text(Some(os.clock.now()))
  expect(body.contains("\ntemp 21.5\n")) == true
}

test "the default latency buckets are the eleven up to ten seconds" {
  let b = metrics.latency_buckets()
  expect(b.len()) == 11
  expect(b[0]) == 0.005
  expect(b[5]) == 0.25
  expect(b[10]) == 10.0
  let r = metrics.registry()
  // the buckets argument is omitted: buckets = latency_buckets() is the
  // only call default in std, and the Go backend rejected it until f623b4826
  // ("unsupported std default value"), so this corpus is the cross backend
  // proof that the default evaluates
  let h = r.histogram("plain_seconds", "Buckets defaulted.", [])
  h.observe(0.001)
  h.observe(30.0)
  let t = r.text()
  for v in ["0.005", "0.01", "0.025", "0.05", "0.1", "0.25", "0.5", "1", "2.5", "5", "10"] {
    expect(t.contains("plain_seconds_bucket{le=\"${v}\"} ")) == true
  }
  // 0.001 is under the first bound and 30 is over the last, so only +Inf
  // counts both
  expect(t.contains("plain_seconds_bucket{le=\"0.005\"} 1\n")) == true
  expect(t.contains("plain_seconds_bucket{le=\"10\"} 1\n")) == true
  expect(t.contains("plain_seconds_bucket{le=\"+Inf\"} 2\n")) == true
  expect(t.contains("plain_seconds_sum 30.001\n")) == true
  expect(t.contains("plain_seconds_count 2\n")) == true
}
