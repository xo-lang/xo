  expect("stream write", cz_stream_pack("zlib", 1, b"stream stream abcthe the abcthe xo zz01234567890123456789xo abcstream xo stream abcabcstream \xc3\xa9abcabcstream the abc\x0astream stream 0123456789the stream the ", 4).to_hex(), "78014c8c4b0ac0200c44f73d458ed0ffe738b104dc88a059046fd473f4624598a28b309390f7b226e1400876b77aa13aa816a994719a9775db8ff36acd627d0167b133b0fbcfefc3ae5ba11d00219a52bd50d6241c48bdd0170000ffff3e403529")
