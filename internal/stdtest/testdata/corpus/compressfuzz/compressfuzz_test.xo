  expect("one shot", cz_unpack("gzip", s, 1073741824), "ok 30313233343536373839616263616263616263746865207468652073747265616d20c3a96162636162630a7a7a786f206162637a7a616263616263")
  expect("stream", cz_stream_unpack("gzip", s, 5), "ok 30313233343536373839616263616263616263746865207468652073747265616d20c3a96162636162630a7a7a786f206162637a7a616263616263")
  expect("max_size", cz_unpack("gzip", s, 58), "err gzip: output exceeds max_size (58 bytes)")
  expect("write", cz_pack("gzip", 6, b"0123456789abcabcabcthe the stream \xc3\xa9abcabc\x0azzxo abczzabcabc").to_hex(), "1f8b08000000000000ff3230343236313533b7b04c4c4a86a0928c5405102e2e294a4dcc5538bc1222cc55555591af9098945c55051100040000ffff67c1ec123b000000")
  expect("stream write", cz_stream_pack("gzip", 6, b"0123456789abcabcabcthe the stream \xc3\xa9abcabc\x0azzxo abczzabcabc", 5).to_hex(), "1f8b08000000000000ff3230343236313533b7b04c4c4a86a0928c5405102e2e294a4dcc5538bc1222cc55555591af9098945c55051100040000ffff67c1ec123b000000")
}

