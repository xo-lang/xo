  expect("stream", cz_stream_unpack("deflate", s, 8), "ok d582be4c240b1cbebf0f2dc89b6ef47e3b8c415d4124f4148c75cb0d8e08ead9e5843e54a0d922f5b80ded3a7f9306f8c8")
