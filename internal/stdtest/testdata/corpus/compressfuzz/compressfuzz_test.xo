  let s = b"x^JLJ\x06\x04\x00\x00\xf7\xff\x02M\x01'"
  expect("one shot", cz_unpack("zlib", s, 1073741824), "err flate: corrupt input before offset 9")
  expect("stream", cz_stream_unpack("zlib", s, 8).split(" ")[0], "err")
}

test "compress fuzz 1993" {
  let s = b"*\xc9JU\xa8\xc8\x07\xa1\xe2\x92\xa2\xd4\xc4\x5c\x85\xc3+\xa1\x0c\xae\x8a|\x85\xaa*..\xb88\x86R\x90@UUU\x15 \x00\x00\xff\xff"
  expect("one shot", cz_unpack("deflate", s, 1073741824), "ok 746a6520786f20786f2073747265616d20c3a973747265616d200a786f207a7a0a0a73747265616d20c3a9746a6520786f20786f2073747265616d20746a65207a7a7a7a")
  expect("stream", cz_stream_unpack("deflate", s, 1), "ok 746a6520786f20786f2073747265616d20c3a973747265616d200a786f207a7a0a0a73747265616d20c3a9746a6520786f20786f2073747265616d20746a65207a7a7a7a")
  expect("max_size", cz_unpack("deflate", s, 67), "err flate: output exceeds max_size (67 bytes)")
}

test "compress fuzz 1994" {
  let s = b"\x1f\x8b\x08\x12\x00\x00\x00\x00\x00\xffa commen\x00\xb4\xbdJ\x1a\x15II\x80\x00\x00\x00\xbf\xff\xad\x22\x0e\xfd\x06\x01\x00\x00"
  expect("one shot", cz_unpack("gzip", s, 1073741824), "err gzip: invalid header")
  expect("stream", cz_stream_unpack("gzip", s, 8).split(" ")[0], "err")
}

test "compress fuzz 1995" {
  let s = b"Jr\xa8EGp\xb1\xa8w\x89II\xc9\xdb\x8d\x7f\x9dO,\xcb\xbeF\x94\x02\xa0\xb1\x00Q\xc0K\xd6O\x1a\x95W7\xa34\xd2\x13?^G\xa8\xed\x05(\x110\x9d\x1d\xa5\x95\xbc\x7f\x13\xd1C?91)\xf9/\x1d`[\x92\x87\xd5\xf9Z`\xaa\xbf\xd9MjRC\xb1=\x11\x00"
  expect("one shot", cz_unpack("deflate", s, 1073741824), "err flate: corrupt input before offset 7")
  expect("stream", cz_stream_unpack("deflate", s, 5).split(" ")[0], "err")
}

test "compress fuzz 1996" {
  let s = b"x^J\xa6\x0d\x00\x04\x00\x00\xff\xff\xc8\xfe!\xa6"
  expect("one shot", cz_unpack("zlib", s, 1073741824), "ok 636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363")
  expect("stream", cz_stream_unpack("zlib", s, 3), "ok 636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363")
  expect("max_size", cz_unpack("zlib", s, 86), "err zlib: output exceeds max_size (86 bytes)")
  expect("write", cz_pack("zlib", 4, b"ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc").to_hex(), "785e4aa60d00040000ffffc8fe21a6")
  expect("stream write", cz_stream_pack("zlib", 4, b"ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", 3).to_hex(), "785e4aa60d00040000ffffc8fe21a6")
}

test "compress fuzz 1997" {
  let s = b"x\x9c}A\x1a\xae\xab\xbc\x04\x00\x00\x00"
  expect("one shot", cz_unpack("zlib", s, 1073741824), "err flate: corrupt input before offset 5")
  expect("stream", cz_stream_unpack("zlib", s, 2).split(" ")[0], "err")
}

