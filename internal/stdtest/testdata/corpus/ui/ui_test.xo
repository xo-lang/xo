// std/ui from outside the module: an App, its Server and Replicas, the
// Host's routes, the predicting client and the page layer (decisions 0659,
// 0668, 0670). The module's own tests are in std/ui_test.xo.
use std/http
use std/json
use std/sql
use std/ui
use std/url

struct Count {
  n: Int
  who: List[Str]
} derive Eq, Json, Debug

enum Act {
  Inc(by: Int)
  Join(who: Str)
} derive Eq, Json, Debug

fn step(c: Count, a: Act) -> Count {
  var m = c
  match a {
    Inc(by) => { m.n = m.n + by }
    Join(who) => { m.who.push(who) }
  }
  m
}

fn show(c: Count) -> ui.Html {
  ui.el("p", [ui.on("click", Act.Inc(by: 1))], [ui.text("n=${c.n}")])
}

fn counter() -> ui.App[Count, Act] {
  ui.app(Count{n: 0, who: []}, step, show)
}

test "a replica predicts and the server confirms" {
  let app = counter().confirming(fn(a: Act) -> Bool {
    match a {
      Join(_) => true
      Inc(_) => false
    }
  })
  var s = ui.server(app)
  var r = ui.replica(app, "a", app.init, 0)
  r.send(Act.Inc(by: 2))
  r.send(Act.Join(who: "ann"))
  expect(r.model().n) == 2
  expect(r.awaiting().len()) == 1
  expect(r.confirmed().n) == 0
  expect(r.pending()) == 2
  r.receive(s.receive(r.outbox()))
  expect(r.pending()) == 0
  expect(r.version()) == 2
  expect(s.version()) == 2
  expect(s.applied("a")) == 2
  expect(r.model()) == s.model()
  s.apply(Act.Inc(by: 5))
  r.receive(s.reply("a", r.version()))
  expect(r.model().n) == 7
  s.compact(1)
  expect(s.model().who) == ["ann"]
}

test "receive_as refuses a Msg its principal may not send" {
  var s = ui.server(counter())
  let only_inc = fn(m: Count, p: Str, a: Act) -> Bool {
    match a {
      Inc(_) => true
      Join(_) => false
    }
  }
  let up = ui.Up{client: "c", ver: 0, msgs: [ui.Envelope{seq: 1, msg: Act.Join(who: "bob")}]}
  expect(s.receive_as(up, "bob", only_inc).is_some()) == true
  expect(s.model().who.len()) == 0
}

test "predict renders pending Msgs over the confirmed model" {
  let out = ui.predict(counter(), ui.ClientIn{model: Count{n: 1, who: []}, pending: [Act.Inc(by: 3)]})
  expect(out.html.contains("n=4")) == true
  expect(out.awaiting) == 0
  expect(ui.field("q").len() > 0) == true
}

test "the host serves the page and applies server Msgs" {
  var h = ui.host(counter(), title: "Count")
  var r = http.router()
  h.mount(r)
  let p = r.call(http.new_request("GET", "/"))
  expect(p.status) == 200
  expect(p.text()?.contains("n=0")) == true
  h.apply(Act.Inc(by: 1))
  expect(h.model().n) == 1
  expect(h.live()) == 0
  let page = ui.page(counter(), Count{n: 9, who: []}, 3, title: "Count")
  expect(page.contains("n=9")) == true
}

test "a server page and its runtime" {
  let s = ui.plain("Search", ui.el("form", [ui.attr("method", "get")], []), prefix: "/app")
  expect(s.contains("data-xo-page")) == true
  var r = http.router()
  ui.serve_runtime(r, prefix: "/app")
  let js = r.call(http.new_request("GET", ui.runtime_url("/app")))
  expect(js.status) == 200
}

test "Scopes on one store and Hosts on one bus act as one (decision 0686)" {
  let st = ui.memory_store()
  var a = ui.scope(counter(), st, key: "room")
  var b = ui.scope(counter(), st, key: "room")
  a.receive(ui.Up{client: "x", ver: 0, msgs: [ui.Envelope{seq: 1, msg: Act.Inc(by: 2)}]})?
  let all = fn(m: Count, p: Str, e: Act) -> Bool { true }
  let d = b.receive_as(ui.Up{client: "y", ver: 0, msgs: [ui.Envelope{seq: 1, msg: Act.Join(who: "ann")}]}, "ann", all)?
  expect(d.is_some()) == true
  b.apply(Act.Inc(by: 1))?
  a.catch_up()?
  expect(a.model()) == b.model()
  expect(a.version()) == 3
  expect(a.reply("x", 0)?.entries.len()) == 3
  a.compact(1)?
  let bus = ui.local_bus()
  let h1 = ui.host_with(counter(), st, bus, scope: "room")
  let h2 = ui.host_with(counter(), st, bus, scope: "room")
  h1.try_apply(Act.Inc(by: 4))?
  expect(h2.model().n) == 7
}

test "a Host polls its store for another instance's appends (decision 0686)" {
  // no bus between them: only the poll tells h2
  let st = ui.memory_store()
  let h1 = ui.host_with(counter(), st, ui.local_bus(), scope: "room")
  let h2 = ui.host_with(counter(), st, ui.local_bus(), scope: "room")
  expect(h2.model().n) == 0
  expect(h2.poll()) == 0
  h1.try_apply(Act.Inc(by: 3))?
  expect(h2.poll()) == 1
  expect(h2.poll()) == 0
  expect(h2.model().n) == 3
  scope s {
    h2.poll_every(s.group(), os.clock, every: 10ms)
    s.cancel()
  }
}

test "a directory store keeps a scope's log in files" {
  let st = ui.dir_store(os.fs, "/ui")
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == true
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == false
  expect((st.read)("k", 0)?.len()) == 1
}

test "a Postgres bus is made from a database, a task group and a clock" {
  scope s {
    let g = s.group()
    let b = ui.pg_bus(sql.memory()?, g, os.clock)
    // a database without NOTIFY: the instance's own subscribers still hear it
    let heard = Chan[Int].new(cap: 4)
    (b.subscribe)(fn(k: Str, v: Int) uses sync { let _f = heard.try_send(v) })
    (b.publish)("k", 1)
    var v = -1
    while v < 0 {
      v = heard.recv() ?? 0
    }
    expect(v) == 1
  }
}

test "a URL view renders from the page's query" {
  let app = counter().with_url_view(fn(m: Count, q: url.Values) -> ui.Html {
    ui.text("n=${m.n} sort=${q.get("sort") ?? "none"}")
  })
  let page = ui.page(app, Count{n: 0, who: []}, 0, query: "sort=new")
  expect(page.contains("n=0 sort=new")) == true
}

test "a SQL store keeps a scope's log in tables" {
  let st = ui.sql_store(sql.memory()?)?
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == true
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == false
  expect((st.read)("k", 0)?.len()) == 1
}

test "a bucket store keeps a scope's log in objects, created only when new" {
  let objs = Mutex[Map[Str, Bytes]].new({})
  let o = ui.Objects{
    create: fn(k: Str, v: Bytes) -> Bool ! Str uses sync {
      Ok(objs.with(fn(var m) {
        if m.contains(k) {
          return false
        }
        m.put(k, v)
        true
      }))
    },
    put: fn(k: Str, v: Bytes) -> () ! Str uses sync {
      objs.with(fn(var m) { m.put(k, v) })
      Ok(())
    },
    get: fn(k: Str) -> Bytes? ! Str uses sync { Ok(objs.with_read(fn(m) { m.get(k) })) },
    list: fn(p: Str, after: Str) -> List[Str] ! Str uses sync { Ok(objs.with_read(fn(m) { m.keys() }).filter(fn(k) { k.starts_with(p) && k > after }).sort()) },
  }
  let st = ui.object_store(o)
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == true
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == false
  expect((st.read)("k", 0)?.len()) == 1
}

// A Join asks for a greeting command; Inc asks for none.
fn greetings(c: Count, a: Act) -> List[Str] {
  match a {
    Join(who) => if c.who.contains(who) { [] } else { ["greet:${who}"] }
    Inc(_) => []
  }
}

test "commands run once for each committed Msg and answer with a server Msg (decision 0692)" {
  let ran = Mutex[List[Str]].new([])
  let cm = ui.commands(os.tasks, greetings, fn(c: Str) -> Act? uses sync {
    ran.with(fn(var l) { l.push(c) })
    Some(Act.Inc(by: 10))
  })
  var h = ui.host(counter(), commands: cm)
  h.apply(Act.Join(who: "ann"))
  h.apply(Act.Join(who: "ann"))
  h.apply(Act.Inc(by: 1))
  var i = 0
  while (h.commands_running() > 0 || h.model().n < 11) && i < 5000 {
    os.clock.sleep(1ms)
    i += 1
  }
  expect(h.commands_running()) == 0
  expect(ran.with_read(fn(l) { l.clone() })) == ["greet:ann"]
  expect(h.model().n) == 11
}

// A principal's own draft (App.with_user, decision 0672): typed on one
// device, seen on another, never by anyone else.
fn draft_step(c: Count, d: Str, a: Str) -> (Str, List[Act]) {
  (a, [])
}

fn draft_show(c: Count, d: Str, q: url.Values) -> ui.Html {
  ui.el("p", [ui.on_user("input", "typed")], [ui.text("n=${c.n} draft=${d}")])
}

fn who(req: http.Request) -> Str? uses sync {
  req.header("X-User")
}

fn sync_user(r: http.Router, user: Str, client: Str, up: ui.UserUp) -> ui.UserDown? {
  let body = json.encode_str(ui.Up[Act]{client: client, ver: 0, msgs: [], user: Some(up)})
  let resp = r.call(http.new_request("POST", "/_xo/sync?thin=1", headers: {"Content-Type": "application/json", "X-User": user}, body: body.bytes()))
  let s = json.decode_str[ui.Sync[Count, Act]](resp.text() ?? "").ok() ?? return None
  s.user
}

test "each principal's own state follows it across devices (decision 0672)" {
  let app = counter().with_user("", draft_step, draft_show)
  expect(ui.render(ui.el("b", [ui.on_user("click", "x")]))) == "<b data-xo-uclick=\"&#34;x&#34;\"></b>"
  var h = ui.host(app, auth: Some(who))
  var r = http.router()
  h.mount(r)
  let d1 = sync_user(r, "ann", "phone", ui.UserUp{ver: 0, msgs: [ui.Envelope{seq: 1, msg: json.encode_str("milk")}]}) ?? return Err("no user state")
  expect(d1.acked) == 1
  expect(d1.state) == "\"milk\""
  let d2 = sync_user(r, "ann", "laptop", ui.UserUp{ver: 0, msgs: []}) ?? return Err("no user state")
  expect(d2.ver) == d1.ver
  expect(d2.state) == "\"milk\""
  let d3 = sync_user(r, "bob", "b", ui.UserUp{ver: 0, msgs: []}) ?? return Err("no user state")
  expect(d3.state) == "\"\""
  expect(r.call(http.new_request("GET", "/", headers: {"X-User": "ann"})).text()?.contains("draft=milk")) == true
}
