// std/ui from outside the module: an App, its Server and Replicas, the
// Host's routes, the predicting client and the page layer (decisions 0659,
// 0668, 0670). The module's own tests are in std/ui_test.xo.
use std/http
use std/sql
use std/ui

struct Count {
  n: Int
  who: List[Str]
} derive Eq, Json, Debug

enum Act {
  Inc(by: Int)
  Join(who: Str)
} derive Eq, Json, Debug

fn step(c: Count, a: Act) -> Count {
  var m = c
  match a {
    Inc(by) => { m.n = m.n + by }
    Join(who) => { m.who.push(who) }
  }
  m
}

fn show(c: Count) -> ui.Html {
  ui.el("p", [ui.on("click", Act.Inc(by: 1))], [ui.text("n=${c.n}")])
}

fn counter() -> ui.App[Count, Act] {
  ui.app(Count{n: 0, who: []}, step, show)
}

test "a replica predicts and the server confirms" {
  let app = counter().confirming(fn(a: Act) -> Bool {
    match a {
      Join(_) => true
      Inc(_) => false
    }
  })
  var s = ui.server(app)
  var r = ui.replica(app, "a", app.init, 0)
  r.send(Act.Inc(by: 2))
  r.send(Act.Join(who: "ann"))
  expect(r.model().n) == 2
  expect(r.awaiting().len()) == 1
  expect(r.confirmed().n) == 0
  expect(r.pending()) == 2
  r.receive(s.receive(r.outbox()))
  expect(r.pending()) == 0
  expect(r.version()) == 2
  expect(s.version()) == 2
  expect(s.applied("a")) == 2
  expect(r.model()) == s.model()
  s.apply(Act.Inc(by: 5))
  r.receive(s.reply("a", r.version()))
  expect(r.model().n) == 7
  s.compact(1)
  expect(s.model().who) == ["ann"]
}

test "receive_as refuses a Msg its principal may not send" {
  var s = ui.server(counter())
  let only_inc = fn(m: Count, p: Str, a: Act) -> Bool {
    match a {
      Inc(_) => true
      Join(_) => false
    }
  }
  let up = ui.Up{client: "c", ver: 0, msgs: [ui.Envelope{seq: 1, msg: Act.Join(who: "bob")}]}
  expect(s.receive_as(up, "bob", only_inc).is_some()) == true
  expect(s.model().who.len()) == 0
}

test "predict renders pending Msgs over the confirmed model" {
  let out = ui.predict(counter(), ui.ClientIn{model: Count{n: 1, who: []}, pending: [Act.Inc(by: 3)]})
  expect(out.html.contains("n=4")) == true
  expect(out.awaiting) == 0
  expect(ui.field("q").len() > 0) == true
}

test "the host serves the page and applies server Msgs" {
  var h = ui.host(counter(), title: "Count")
  var r = http.router()
  h.mount(r)
  let p = r.call(http.new_request("GET", "/"))
  expect(p.status) == 200
  expect(p.text()?.contains("n=0")) == true
  h.apply(Act.Inc(by: 1))
  expect(h.model().n) == 1
  expect(h.live()) == 0
  let page = ui.page(counter(), Count{n: 9, who: []}, 3, title: "Count")
  expect(page.contains("n=9")) == true
}

test "a server page and its runtime" {
  let s = ui.plain("Search", ui.el("form", [ui.attr("method", "get")], []), prefix: "/app")
  expect(s.contains("data-xo-page")) == true
  var r = http.router()
  ui.serve_runtime(r, prefix: "/app")
  let js = r.call(http.new_request("GET", ui.runtime_url("/app")))
  expect(js.status) == 200
}

test "Scopes on one store and Hosts on one bus act as one (decision 0686)" {
  let st = ui.memory_store()
  var a = ui.scope(counter(), st, key: "room")
  var b = ui.scope(counter(), st, key: "room")
  a.receive(ui.Up{client: "x", ver: 0, msgs: [ui.Envelope{seq: 1, msg: Act.Inc(by: 2)}]})?
  let all = fn(m: Count, p: Str, e: Act) -> Bool { true }
  let d = b.receive_as(ui.Up{client: "y", ver: 0, msgs: [ui.Envelope{seq: 1, msg: Act.Join(who: "ann")}]}, "ann", all)?
  expect(d.is_some()) == true
  b.apply(Act.Inc(by: 1))?
  a.catch_up()?
  expect(a.model()) == b.model()
  expect(a.version()) == 3
  expect(a.reply("x", 0)?.entries.len()) == 3
  a.compact(1)?
  let bus = ui.local_bus()
  let h1 = ui.host_with(counter(), st, bus, scope: "room")
  let h2 = ui.host_with(counter(), st, bus, scope: "room")
  h1.try_apply(Act.Inc(by: 4))?
  expect(h2.model().n) == 7
}

test "a directory store keeps a scope's log in files" {
  let st = ui.dir_store(os.fs, "/ui")
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == true
  expect((st.append)("k", ui.Batch{after: 0, count: 1, data: b"[]"})?) == false
  expect((st.read)("k", 0)?.len()) == 1
}

test "a Postgres bus is made from a database, a task group and a clock" {
  scope s {
    let g = s.group()
    let b = ui.pg_bus(sql.memory()?, g, os.clock)
    // a database without NOTIFY: the instance's own subscribers still hear it
    let heard = Chan[Int].new(cap: 4)
    (b.subscribe)("k", fn(v: Int) uses sync { let _f = heard.try_send(v) })
    (b.publish)("k", 1)
    var v = -1
    while v < 0 {
      v = heard.recv() ?? 0
    }
    expect(v) == 1
  }
}
