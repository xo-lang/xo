fn runes_of(h: Str) -> Str {
  if h.is_empty() {
    return ""
  }
  var out = StrBuilder.new()
  for p in h.split(" ") {
    out.write("${Rune(Int.parse_base(p, 16) ?? 0)}")
  }
  out.freeze()
}

test "every rune a form changes is normalized as x/text does" {
  var bad: List[Str] = []
  for e in RUNES {
    let s = "${Rune(e.0)}"
    let want = [if e.1.is_empty() { s } else { runes_of(e.1) }, if e.2.is_empty() { s } else { runes_of(e.2) }, if e.3.is_empty() { s } else { runes_of(e.3) }, if e.4.is_empty() { s } else { runes_of(e.4) }]
    let got = [norm.normalize(s, norm.Form.Nfc), norm.normalize(s, norm.Form.Nfd), norm.normalize(s, norm.Form.Nfkc), norm.normalize(s, norm.Form.Nfkd)]
    for i in 0..4 {
      if got[i] != want[i] {
        bad.push("U+${e.0.to_str_base(16)} form ${i}")
      }
    }
  }
  expect(bad[0..(if bad.len() < 8 { bad.len() } else { 8 })]) == []
}

test "seeded strings of the runes that matter, with is_normalized" {
  var bad: List[Str] = []
  for e in STRINGS {
    let s = runes_of(e.0)
    let forms = [norm.Form.Nfc, norm.Form.Nfd, norm.Form.Nfkc, norm.Form.Nfkd]
    let want = [e.1, e.2, e.3, e.4]
    for i in 0..4 {
      let got = norm.normalize(s, forms[i])
      if got != runes_of(want[i]) {
        bad.push("${e.0} form ${i}")
      }
      let flag = e.5[i..i + 1] == "1"
      if norm.is_normalized(s, forms[i]) != flag {
        bad.push("${e.0} is_normalized ${i}")
      }
    }
  }
  expect(bad[0..(if bad.len() < 8 { bad.len() } else { 8 })]) == []
}

test "runes no form changes are returned as they are" {
  var bad: List[Int] = []
  var r = 0
  while r < 0x110000 {
    if r < 0xD800 || r > 0xDFFF {
      let s = "${Rune(r)}"
      if norm.normalize(s, norm.Form.Nfc) != s && !has(r) {
        bad.push(r)
      }
    }
    r += 7
  }
  expect(bad.len()) == 0
}

fn has(r: Int) -> Bool {
  for e in RUNES {
    if e.0 == r {
      return true
    }
  }
  false
}

test "a handful of known cases" {
  expect(norm.normalize("e\u{301}", norm.Form.Nfc)) == "\u{e9}"
  expect(norm.normalize("\u{e9}", norm.Form.Nfd)) == "e\u{301}"
  expect(norm.normalize("\u{fb01}", norm.Form.Nfkc)) == "fi"
  expect(norm.normalize("\u{fb01}", norm.Form.Nfc)) == "\u{fb01}"
  expect(norm.normalize("\u{ac00}", norm.Form.Nfd)) == "\u{1100}\u{1161}"
  expect(norm.normalize("\u{1100}\u{1161}\u{11a8}", norm.Form.Nfc)) == "\u{ac01}"
  expect(norm.normalize("a\u{323}\u{307}", norm.Form.Nfc)) == "\u{1ea1}\u{307}"
  expect(norm.normalize("a\u{307}\u{323}", norm.Form.Nfc)) == "\u{1ea1}\u{307}"
  expect(norm.is_normalized("abc", norm.Form.Nfc)) == true
  expect(norm.is_normalized("e\u{301}", norm.Form.Nfc)) == false
  expect(norm.unicode_version()) == "15.0.0"
}
