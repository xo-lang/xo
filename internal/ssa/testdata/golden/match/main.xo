// Enum construction and match with variant, literal, range, or, and
// guard patterns; `??` on Option; `if let`.
enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
  Empty
}

fn area(s: Shape) -> Float {
  match s {
    Circle(r) => 3.0 * r * r
    Rect(w, h) if w == h => w * w
    Rect(w, h) => w * h
    Empty => 0.0
  }
}

fn bucket(n: Int) -> Str {
  match n {
    0 => "zero"
    1 | 2 | 3 => "small"
    4..=9 => "medium"
    _ => "large"
  }
}

fn main(os: Os) {
  var xs: List[Int] = [5]
  let top = xs.pop() ?? 0
  if let Rect(w, _) = Shape.Rect(w: 2.0, h: 3.0) {
    os.stdio.println("w ${w}")
  }
  os.stdio.println("${area(Shape.Circle(1.0))} ${bucket(top)} ${area(Shape.Empty)}")
}
