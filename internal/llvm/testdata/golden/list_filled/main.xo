// List.filled (decision 0671): n copies of x; bulk paths for UInt8 and Int
// from 64 elements on the native targets, pushes for other types and
// wasm. Writes and pushes after a bulk fill, and n = 0.
struct P { a: Int, s: Str }

fn main(os: Os) {
  let z = List[UInt8].filled(100000, 0)
  let f = List[UInt8].filled(70, 0xAB)
  let s = List[UInt8].filled(3, 7)
  let i0 = List[Int].filled(1000, 0)
  let i7 = List[Int].filled(65, -7)
  let e = List[Int].filled(0, 1)
  let p = List[P].filled(100, P{a: 1, s: "x"})
  let strs = List[Str].filled(80, "hi")
  var w = List[UInt8].filled(64, 1)
  w[63] = 9
  w.push(5)
  var sum = 0
  for x in z { sum += Int(x) }
  os.stdio.println("${z.len()} ${sum} ${f.len()} ${f[0]} ${f[69]} ${s} ${i0.len()} ${i0[999]} ${i7.len()} ${i7[0]} ${i7[64]} ${e.len()}")
  os.stdio.println("${p.len()} ${p[99].a} ${p[0].s} ${strs.len()} ${strs[79]} ${w.len()} ${w[62]} ${w[63]} ${w[64]}")
}
