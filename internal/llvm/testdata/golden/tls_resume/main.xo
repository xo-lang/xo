// std/tls's session resumption (decision 0644 T3, T4): a client's
// session_cache (Go's ClientSessionCache, NewLRUClientSessionCache) and
// session_tickets_disabled; a server's session_tickets_disabled,
// session_ticket_keys (Go's SetSessionTicketKeys, rotation by order) and
// a listener's automatic keys; the hooks on a resumed connection, as
// handshake_client_test.go's TestResumption and handshake_server_test.go's
// TestServerResumption run them, on TLS 1.3 and TLS 1.2.
use std/tls
use std/x509
use std/crypto
use std/base64
use std/netip

struct Issued {
  cert: x509.Certificate
  key: crypto.PrivateKey
}

/// A PEM block of der on one line (PEM readers ignore line lengths).
fn pem_block(kind: Str, der: Bytes) -> Bytes {
  "-----BEGIN ${kind}-----\n${base64.encode(der)}\n-----END ${kind}-----\n".bytes()
}

fn issue(os: Os, name: Str, parent: Issued?, ca: Bool, eku: List[x509.ExtKeyUsage], now: Time) -> Issued uses rand {
  let key = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256).or_fault("key")
  let usage = if ca { [x509.KeyUsage.CertSign, x509.KeyUsage.DigitalSignature] } else { [x509.KeyUsage.DigitalSignature] }
  let ips = if ca { [] } else { [netip.parse_addr("127.0.0.1").or_fault("ip")] }
  let t = x509.Template{subject: x509.Name{common_name: name}, not_before: now - 1h, not_after: now + 24h, ip_addresses: ips, is_ca: ca, key_usage: usage, ext_key_usage: eku}
  let (pc, pk) = match parent {
    Some(p) => (Some(p.cert), p.key)
    None => (None, key)
  }
  Issued{cert: x509.create_certificate(os.rand, t, key.public_key(), pc, pk).or_fault("cert ${name}"), key: key}
}

fn tls_pair(i: Issued, chain: List[x509.Certificate]) -> tls.TlsCert {
  var pem = i.cert.pem()
  for c in chain {
    pem = pem + c.pem()
  }
  tls.cert(pem, pem_block("PRIVATE KEY", crypto.marshal_private_key(i.key))).or_fault("pair")
}



/// What each end saw of one connection.
fn serve(l: tls.TlsListener, n: Int) -> List[Str] uses net {
  var out: List[Str] = []
  for _i in 0..n {
    let c = match l.accept() {
      Ok(c) => c
      Err(e) => {
        out.push("accept: ${e}")
        continue
      }
    }
    match c.handshake() {
      Ok(_) => {
        // a reply, so the client reads the tickets the server sent
        c.write(b"hi").ignore_err("the client may be gone")
        let st = c.state()
        out.push("resumed ${st.did_resume}")
        match c.read(16) {
          _ => {}
        }
      }
      Err(e) => out.push("${e}")
    }
    c.close()
  }
  out
}

/// One client connection: whether it resumed, the version, and the
/// server certificates and chains it reports.
fn dial(os: Os, addr: Str, cfg: tls.ClientConfig) -> Str uses net, clock {
  match tls.dial_config(os.net, addr, cfg, timeout: Some(5s)) {
    Ok(c) => {
      let r = match c.read(16) {
        Ok(Some(b)) => b.to_str() ?? "?"
        Ok(None) => "EOF"
        Err(e) => "${e}"
      }
      let st = c.state()
      c.write(b"bye").ignore_err("the server may be gone")
      c.close()
      "${tls.version_name(st.version)} resumed ${st.did_resume} peer ${st.peer_certificates.len()} chains ${st.verified_chains.len()} read ${r}"
    }
    Err(e) => "${e}"
  }
}

/// n connections from clients made by mk (the i-th gets i) to a listener
/// of cfg: each client's line and the server's.
fn run(os: Os, cfg: tls.ServerConfig, n: Int, mk: fn(Int) -> tls.ClientConfig) -> List[Str] uses net, clock {
  let l = tls.listen(os.net, "127.0.0.1:0", cfg).or_fault("listen")
  var out: List[Str] = []
  scope s {
    let t = s.spawn(fn() -> List[Str] { serve(l, n) })
    var mine: List[Str] = []
    for i in 0..n {
      mine.push(dial(os, l.addr(), mk(i)))
    }
    let theirs = t.await
    for i in 0..n {
      out.push("  ${i + 1}: client ${mine[i]}; server ${if i < theirs.len() { theirs[i] } else { "?" }}")
    }
  }
  l.close()
  out
}

fn show(os: Os, what: Str, lines: List[Str]) uses stdio {
  os.stdio.println(what)
  for l in lines {
    os.stdio.println(l)
  }
}

fn main(os: Os) uses net, stdio, rand, clock {
  let now = os.clock.now()
  let ca = issue(os, "Xo Test CA", None, true, [], now)
  let server = issue(os, "server", Some(ca), false, [x509.ExtKeyUsage.ServerAuth], now)
  let roots = tls.roots_of([ca.cert]).or_fault("roots")
  let pair = tls_pair(server, [])
  let k1 = tls.ticket_key(b"k".repeat(32)).or_fault("k1")
  let k2 = tls.ticket_key(b"j".repeat(32)).or_fault("k2")
  let short = match tls.ticket_key(b"k".repeat(31)) {
    Ok(_) => "ok"
    Err(e) => "${e}"
  }
  os.stdio.println("ticket_key of 31 bytes: ${short}")
  for v in [tls.VERSION_TLS13, tls.VERSION_TLS12] {
    os.stdio.println("== ${tls.version_name(v)}")
    let base = tls.ServerConfig{certificates: [pair], max_version: v}
    let cache = tls.lru_session_cache(0)
    let cc = tls.ClientConfig{server_name: "127.0.0.1", roots: Some(roots), session_cache: Some(cache)}
    show(os, "a listener's automatic keys:", run(os, base, 3, fn(_i: Int) -> tls.ClientConfig { cc }))
    show(os, "no session cache:", run(os, base, 2, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: None} }))
    let c2 = tls.lru_session_cache(0)
    show(os, "client session_tickets_disabled:", run(os, base, 2, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c2), session_tickets_disabled: true} }))
    let c3 = tls.lru_session_cache(0)
    show(os, "server session_tickets_disabled:", run(os, base with {session_tickets_disabled: true}, 2, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c3)} }))
    // sessions under set keys open on another listener with the key
    let c4 = tls.lru_session_cache(0)
    show(os, "session_ticket_keys [k1]:", run(os, base with {session_ticket_keys: [k1]}, 1, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c4)} }))
    show(os, "another listener, keys [k2, k1]:", run(os, base with {session_ticket_keys: [k2, k1]}, 1, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c4)} }))
    let c5 = tls.lru_session_cache(0)
    show(os, "session_ticket_keys [k1] then a listener with [k2]:", run(os, base with {session_ticket_keys: [k1]}, 1, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c5)} }) + run(os, base with {session_ticket_keys: [k2]}, 1, fn(_i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c5)} }))
    // the hooks on a resumed connection
    let c6 = tls.lru_session_cache(0)
    let seen = Mutex[List[Str]].new([])
    let hooked = cc with {session_cache: Some(c6), verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
      seen.with(fn(var l: List[Str]) { l.push("vpc") })
      Ok(())
    }), verify_connection: Some(fn(st: tls.ConnState) -> () ! Str {
      seen.with(fn(var l: List[Str]) { l.push("vc resumed ${st.did_resume} peer ${st.peer_certificates.len()}") })
      Ok(())
    })}
    show(os, "hooks:", run(os, base, 2, fn(_i: Int) -> tls.ClientConfig { hooked }))
    os.stdio.println("  hook calls: ${seen.with(fn(var l: List[Str]) -> List[Str] { l })}")
    // a resumed session is checked again: another name does not resume it
    let c7 = tls.lru_session_cache(0)
    show(os, "verify_connection refuses the resumed one:", run(os, base, 2, fn(i: Int) -> tls.ClientConfig { cc with {session_cache: Some(c7), verify_connection: Some(fn(st: tls.ConnState) -> () ! Str { if st.did_resume { Err("no resumption") } else { Ok(()) } })} }))
    let c8 = tls.lru_session_cache(0)
    show(os, "Verify.None, then Verify.Full:", run(os, base, 2, fn(i: Int) -> tls.ClientConfig { if i == 0 { cc with {session_cache: Some(c8), verify: tls.Verify.None, verify_connection: Some(fn(st: tls.ConnState) -> () ! Str { Ok(()) })} } else { cc with {session_cache: Some(c8)} } }))
  }
  os.stdio.println("done")
}
