// WsConn deadlines over TLS (decision 0430): a peer that does not read
// fills the buffers until the write deadline passes, on the server (the
// handed over TLS connection) and on a wss:// client (its TlsConn); the
// error sticks; a read past its deadline fails the same way. Test
// certificate as websocket_tls's. The Go backend and the native one must
// agree.
use std/http
use std/websocket

fn flood(c: websocket.WsConn) -> Str {
  let chunk = Bytes.zeroed(65536)
  var sent = 0
  while {
    match c.write(websocket.Message{kind: websocket.Kind.Binary, data: chunk}) {
      Ok(_) => sent += 1
      Err(e) => return "${e} after more than one message: ${sent > 1}"
    }
  }
  "unreachable"
}

fn main(os: Os) {
  let clock = os.clock
  let release: Chan[()] = Chan[()].new(cap: 1)
  let saw: Chan[Str] = Chan[Str].new(cap: 4)
  var r = http.router()
  r.handle("GET /flood", fn(req) {
    websocket.upgrade(req, fn(c) {
      c.set_write_deadline(clock, Some(clock.now() + 200ms))
      saw.send("server flood: ${flood(c)}")
      match c.write_text("again") {
        Ok(_) => saw.send("server write again: ok")
        Err(e) => saw.send("server write again: ${e}")
      }
      let _ = release.recv()
    })
  })
  r.handle("GET /sink", fn(req) {
    // reads nothing until released
    websocket.upgrade(req, fn(_c) { let _ = release.recv() })
  })
  let cert = match http.tls_cert(good_cert(), good_key()) {
    Ok(c) => c
    Err(e) => {
      os.stdio.println("cert: ${e}")
      return
    }
  }
  match os.net.listen("127.0.0.1:0") {
    Ok(l) => {
      let srv = http.server(l, r).with_tls([cert])
      let port = srv.addr().split(":")[1]
      scope s {
        s.spawn_background(fn() {
          match srv.serve() {
            Ok(_) => ()
            Err(e) => os.stdio.println("serve failed: ${e}")
          }
        })
        match websocket.dial(os.net, "wss://localhost:${port}/flood", roots: ca_pem()) {
          Ok(c) => {
            os.stdio.println(saw.recv() ?? "?")
            os.stdio.println(saw.recv() ?? "?")
            release.send(())
            c.close().ignore_err("test")
          }
          Err(e) => os.stdio.println("dial failed: ${e}")
        }
        match websocket.dial(os.net, "wss://localhost:${port}/sink", roots: ca_pem()) {
          Ok(c) => {
            c.set_read_deadline(clock, Some(clock.now() + 50ms))
            match c.read() {
              Ok(_) => os.stdio.println("client read: a message")
              Err(e) => os.stdio.println("client read: ${e}")
            }
            c.set_write_deadline(clock, Some(clock.now() + 200ms))
            os.stdio.println("client flood: ${flood(c)}")
            c.set_write_deadline(clock, None)
            match c.write_text("again") {
              Ok(_) => os.stdio.println("client write again: ok")
              Err(e) => os.stdio.println("client write again: ${e}")
            }
            release.send(())
          }
          Err(e) => os.stdio.println("dial failed: ${e}")
        }
      }
    }
    Err(e) => os.stdio.println("listen failed: ${e}")
  }
  os.stdio.println("done")
}

