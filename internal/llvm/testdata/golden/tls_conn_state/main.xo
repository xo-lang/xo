// std/tls's TlsConn.state() and the name functions (decision 0644 T2):
// Go's ConnectionState of a client to a local std/http TLS server (golden
// http_tls's test certificates), and Go's CipherSuiteName, VersionName and
// CurveID.String (tls_test.go TestVersionName's cases among them).
use std/http
use std/tls
use std/x509

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello") })
  r
}

fn main(os: Os) {
  for id in [0x1301, 0x1302, 0x1303, 0xc02b, 0xc030, 0xcca8, 0xc013, 0x0005, 0x000a, 0x009d, 0xc027, 0x0000, 0x00ff, 0xfefe] {
    os.stdio.println("suite ${id}: ${tls.cipher_suite_name(id)}")
  }
  for v in [0x0300, 0x0301, 0x0302, 0x0303, 0x0304, 0x012a] {
    os.stdio.println("version ${v}: ${tls.version_name(v)}")
  }
  for g in [23, 24, 25, 29, 4587, 4588, 4589, 0, 30] {
    os.stdio.println("curve ${g}: ${tls.curve_name(g)}")
  }
  let ca = x509.parse_pem(ca_pem()).or_fault("ca")
  let roots = tls.roots_of(ca).or_fault("roots_of")
  let good = http.tls_cert(good_cert(), good_key()).or_fault("good")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l, routes()).with_tls([good])
  scope s {
    s.spawn_background(fn() {
      match srv.serve() {
        Ok(_) => ()
        Err(e) => os.stdio.println("serve failed: ${e}")
      }
    })
    let c = os.net.dial(l.addr()).or_fault("dial")
    let t = tls.client(c, "localhost", roots: Some(roots), alpn: ["http/1.1"]).or_fault("client")
    let st = t.state()
    os.stdio.println("version ${tls.version_name(st.version)} complete ${st.handshake_complete} resumed ${st.did_resume}")
    os.stdio.println("suite ${tls.cipher_suite_name(st.cipher_suite)} curve ${tls.curve_name(st.curve_id)}")
    os.stdio.println("alpn ${st.negotiated_protocol} mutual ${st.negotiated_protocol_is_mutual} server name ${st.server_name}")
    os.stdio.println("peer ${st.peer_certificates.map(fn(x) { x.subject.common_name }).join(",")}")
    os.stdio.println("chains ${st.verified_chains.map(fn(ch) { ch.map(fn(x) { x.subject.common_name }).join(" > ") }).join(" | ")}")
    os.stdio.println("ocsp ${st.ocsp_response.len()} scts ${st.signed_certificate_timestamps.len()} ech ${st.ech_accepted}")
    t.close()
  }
  os.stdio.println("done")
}

