// Division and remainder of narrow integers by constants (2026-10-19):
// the divisor is a narrow constant's word, which the native backends
// see through for powers of two (masks and shifts) and, on x86_64, for
// the others (a multiply high instead of idivq). Every quotient and
// remainder of edge dividends must equal the other backends'.

fn int8_2(a: Int8) -> (Int8, Int8) { (a / 2, a % 2) }
fn int8_3(a: Int8) -> (Int8, Int8) { (a / 3, a % 3) }
fn int8_7(a: Int8) -> (Int8, Int8) { (a / 7, a % 7) }
fn int8_8(a: Int8) -> (Int8, Int8) { (a / 8, a % 8) }
fn int8_10(a: Int8) -> (Int8, Int8) { (a / 10, a % 10) }
fn int8_n7(a: Int8) -> (Int8, Int8) { (a / (-7), a % (-7)) }
fn int8_n8(a: Int8) -> (Int8, Int8) { (a / (-8), a % (-8)) }
fn int16_2(a: Int16) -> (Int16, Int16) { (a / 2, a % 2) }
fn int16_3(a: Int16) -> (Int16, Int16) { (a / 3, a % 3) }
fn int16_7(a: Int16) -> (Int16, Int16) { (a / 7, a % 7) }
fn int16_8(a: Int16) -> (Int16, Int16) { (a / 8, a % 8) }
fn int16_10(a: Int16) -> (Int16, Int16) { (a / 10, a % 10) }
fn int16_251(a: Int16) -> (Int16, Int16) { (a / 251, a % 251) }
fn int16_n7(a: Int16) -> (Int16, Int16) { (a / (-7), a % (-7)) }
fn int16_n8(a: Int16) -> (Int16, Int16) { (a / (-8), a % (-8)) }
fn int32_2(a: Int32) -> (Int32, Int32) { (a / 2, a % 2) }
fn int32_3(a: Int32) -> (Int32, Int32) { (a / 3, a % 3) }
fn int32_7(a: Int32) -> (Int32, Int32) { (a / 7, a % 7) }
fn int32_8(a: Int32) -> (Int32, Int32) { (a / 8, a % 8) }
fn int32_10(a: Int32) -> (Int32, Int32) { (a / 10, a % 10) }
fn int32_251(a: Int32) -> (Int32, Int32) { (a / 251, a % 251) }
fn int32_n7(a: Int32) -> (Int32, Int32) { (a / (-7), a % (-7)) }
fn int32_n8(a: Int32) -> (Int32, Int32) { (a / (-8), a % (-8)) }
fn int32_46000(a: Int32) -> (Int32, Int32) { (a / 46000, a % 46000) }
fn uint8_2(a: UInt8) -> (UInt8, UInt8) { (a / 2, a % 2) }
fn uint8_3(a: UInt8) -> (UInt8, UInt8) { (a / 3, a % 3) }
fn uint8_7(a: UInt8) -> (UInt8, UInt8) { (a / 7, a % 7) }
fn uint8_8(a: UInt8) -> (UInt8, UInt8) { (a / 8, a % 8) }
fn uint8_10(a: UInt8) -> (UInt8, UInt8) { (a / 10, a % 10) }
fn uint8_251(a: UInt8) -> (UInt8, UInt8) { (a / 251, a % 251) }
fn uint16_2(a: UInt16) -> (UInt16, UInt16) { (a / 2, a % 2) }
fn uint16_3(a: UInt16) -> (UInt16, UInt16) { (a / 3, a % 3) }
fn uint16_7(a: UInt16) -> (UInt16, UInt16) { (a / 7, a % 7) }
fn uint16_8(a: UInt16) -> (UInt16, UInt16) { (a / 8, a % 8) }
fn uint16_10(a: UInt16) -> (UInt16, UInt16) { (a / 10, a % 10) }
fn uint16_251(a: UInt16) -> (UInt16, UInt16) { (a / 251, a % 251) }
fn uint32_2(a: UInt32) -> (UInt32, UInt32) { (a / 2, a % 2) }
fn uint32_3(a: UInt32) -> (UInt32, UInt32) { (a / 3, a % 3) }
fn uint32_7(a: UInt32) -> (UInt32, UInt32) { (a / 7, a % 7) }
fn uint32_8(a: UInt32) -> (UInt32, UInt32) { (a / 8, a % 8) }
fn uint32_10(a: UInt32) -> (UInt32, UInt32) { (a / 10, a % 10) }
fn uint32_251(a: UInt32) -> (UInt32, UInt32) { (a / 251, a % 251) }

fn main(os: Os) {
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_2(Int8(a))
    os.stdio.println("int8_2 ${a} ${q} ${r}")
  }
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_3(Int8(a))
    os.stdio.println("int8_3 ${a} ${q} ${r}")
  }
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_7(Int8(a))
    os.stdio.println("int8_7 ${a} ${q} ${r}")
  }
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_8(Int8(a))
    os.stdio.println("int8_8 ${a} ${q} ${r}")
  }
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_10(Int8(a))
    os.stdio.println("int8_10 ${a} ${q} ${r}")
  }
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_n7(Int8(a))
    os.stdio.println("int8_n7 ${a} ${q} ${r}")
  }
  for a in [-128, -127, -121, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 126, 127] {
    let (q, r) = int8_n8(Int8(a))
    os.stdio.println("int8_n8 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_2(Int16(a))
    os.stdio.println("int16_2 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_3(Int16(a))
    os.stdio.println("int16_3 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_7(Int16(a))
    os.stdio.println("int16_7 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_8(Int16(a))
    os.stdio.println("int16_8 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_10(Int16(a))
    os.stdio.println("int16_10 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_251(Int16(a))
    os.stdio.println("int16_251 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_n7(Int16(a))
    os.stdio.println("int16_n7 ${a} ${q} ${r}")
  }
  for a in [-32768, -32767, -32761, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 32766, 32767] {
    let (q, r) = int16_n8(Int16(a))
    os.stdio.println("int16_n8 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_2(Int32(a))
    os.stdio.println("int32_2 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_3(Int32(a))
    os.stdio.println("int32_3 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_7(Int32(a))
    os.stdio.println("int32_7 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_8(Int32(a))
    os.stdio.println("int32_8 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_10(Int32(a))
    os.stdio.println("int32_10 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_251(Int32(a))
    os.stdio.println("int32_251 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_n7(Int32(a))
    os.stdio.println("int32_n7 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_n8(Int32(a))
    os.stdio.println("int32_n8 ${a} ${q} ${r}")
  }
  for a in [-2147483648, -2147483647, -2147483641, -46001, -46000, -251, -10, -9, -8, -7, -3, -2, -1, 0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 2147483646, 2147483647] {
    let (q, r) = int32_46000(Int32(a))
    os.stdio.println("int32_46000 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 254, 255] {
    let (q, r) = uint8_2(UInt8(a))
    os.stdio.println("uint8_2 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 254, 255] {
    let (q, r) = uint8_3(UInt8(a))
    os.stdio.println("uint8_3 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 254, 255] {
    let (q, r) = uint8_7(UInt8(a))
    os.stdio.println("uint8_7 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 254, 255] {
    let (q, r) = uint8_8(UInt8(a))
    os.stdio.println("uint8_8 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 254, 255] {
    let (q, r) = uint8_10(UInt8(a))
    os.stdio.println("uint8_10 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 254, 255] {
    let (q, r) = uint8_251(UInt8(a))
    os.stdio.println("uint8_251 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 65534, 65535] {
    let (q, r) = uint16_2(UInt16(a))
    os.stdio.println("uint16_2 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 65534, 65535] {
    let (q, r) = uint16_3(UInt16(a))
    os.stdio.println("uint16_3 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 65534, 65535] {
    let (q, r) = uint16_7(UInt16(a))
    os.stdio.println("uint16_7 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 65534, 65535] {
    let (q, r) = uint16_8(UInt16(a))
    os.stdio.println("uint16_8 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 65534, 65535] {
    let (q, r) = uint16_10(UInt16(a))
    os.stdio.println("uint16_10 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 65534, 65535] {
    let (q, r) = uint16_251(UInt16(a))
    os.stdio.println("uint16_251 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 4294967294, 4294967295] {
    let (q, r) = uint32_2(UInt32(a))
    os.stdio.println("uint32_2 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 4294967294, 4294967295] {
    let (q, r) = uint32_3(UInt32(a))
    os.stdio.println("uint32_3 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 4294967294, 4294967295] {
    let (q, r) = uint32_7(UInt32(a))
    os.stdio.println("uint32_7 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 4294967294, 4294967295] {
    let (q, r) = uint32_8(UInt32(a))
    os.stdio.println("uint32_8 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 4294967294, 4294967295] {
    let (q, r) = uint32_10(UInt32(a))
    os.stdio.println("uint32_10 ${a} ${q} ${r}")
  }
  for a in [0, 1, 2, 3, 7, 8, 9, 10, 250, 251, 252, 45999, 46000, 46001, 4294967294, 4294967295] {
    let (q, r) = uint32_251(UInt32(a))
    os.stdio.println("uint32_251 ${a} ${q} ${r}")
  }
}
