// Header names stored by Request.with_header (canonical_key: the common
// names answered with constants, http1.common_name) against Go's rule
// written here (textproto.CanonicalMIMEHeaderKey for token names: upper
// at the start and after a dash, lower elsewhere), on deterministic case
// variants of the common names and of others.
use std/http

const NAMES: List[Str] = ["Host", "Accept", "Cookie", "User-Agent", "Connection", "Content-Type", "Authorization", "Content-Length", "Accept-Encoding", "Accept-Language", "X-Request-Id", "Etag", "Hostname", "Accept-Charset", "Content-Types", "Te", "a", "x-a-b-c"]

fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

fn reference(s: Str) -> Str {
  var out = BytesBuilder.new()
  var up = true
  for b in s.bytes() {
    var c = Int(b)
    if up && c >= 97 && c <= 122 {
      c = c - 32
    } else if !up && c >= 65 && c <= 90 {
      c = c + 32
    }
    out.write_byte(UInt8(c))
    up = c == 45
  }
  out.freeze().to_str() ?? ""
}

/// s with the case of byte i flipped when bit i of mask is set.
fn vary(s: Str, mask: Int) -> Str {
  var out = BytesBuilder.new()
  var i = 0
  for b in s.bytes() {
    var c = Int(b)
    if ((mask >> (i % 30)) & 1) == 1 {
      if c >= 97 && c <= 122 {
        c = c - 32
      } else if c >= 65 && c <= 90 {
        c = c + 32
      }
    }
    out.write_byte(UInt8(c))
    i += 1
  }
  out.freeze().to_str() ?? ""
}

fn main(os: Os) {
  var x = 99
  var bad = 0
  var lower = 0
  for i in 0..3000 {
    x = next(x)
    let name = NAMES[i % NAMES.len()]
    // every 4th the all lower case form (HTTP/2's), else a random mix
    let v = if i % 4 == 0 { name.to_lower() } else { vary(name, x) }
    if v == name.to_lower() {
      lower += 1
    }
    let req = http.new_request("GET", "http://x/", {}).with_header(v, "val")
    if req.headers.keys() != [reference(v)] || req.header(v) != Some("val") || req.header(name.to_lower()) != Some("val") {
      bad += 1
      if bad <= 3 {
        os.stdio.println("  ${v}: stored as ${req.headers.keys().len()} keys")
      }
    }
  }
  os.stdio.println("canonical names: 3000 checked (${lower} lower case), ${bad} mismatches")
}
