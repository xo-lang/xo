// TLS 1.2 session tickets on the server (std/native/llrt/tls12srv.xo with
// tlsticket.xo, RFC 5077, as Go's handshake_server.go): crypto/tls's
// client with a session cache against crypto/tls's server, a full
// handshake that issues a ticket (K1) then one that resumes it (K2),
// through internal.crypto_op("tls12.server") with the time (which turns
// tickets on; the ticket key and IVs come from the 0x22 random source on
// both sides). Then the resumption Go declines: tickets off, the ticket
// past its lifetime, a corrupted ticket, the session's suite disabled
// (each a full handshake the recorded client cannot finish), and a byte
// at a time.
use std/internal

const CERT_P256: Str = ""
const KEY_P256_D: Str = "9f21bbe70040d0bb7340fd3894b1390a7fc575741aa8ff9bb82c754c6fcef8b0"
const SERVER_X25519: Str = "2222222222222222222222222222222222222222222222222222222222222222"
const SERVER_P256: Str = "2260222222222222222222222222222222222222222222222222222222222222"
const SERVER_P384: Str = "226022222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222"
// K1: suite c02b curve 29 cert p256 alpn [] [] -> ""
const K1_C_HS: Str = ""
const K1_C_APP: Str = "170303001c0000000000000001b330aa255a0dabdefbdf472e1dcbb605afeffa52150303001a000000000000000286740e91831fd7cc745d61a78c633daa6aed"
const K1_S_HS: Str = ""
const K1_SIG: Str = "3044022071721d467bb2e11cbed89b68e86f7f01e14e91f58fab3e7c45fcbb116dc404e60220531628171b2b3cfb95fc8bd3b9ee9e1b8f9bc0df6c584cdc53c0e322a7b30670"
// K2: suite c02b curve 29 cert p256 alpn [] [] -> ""
const K2_C_HS: Str = ""
const K2_C_APP: Str = "170303001c0000000000000001b330aa255a0dabdefbdf472e1dcbb605afeffa52150303001a000000000000000286740e91831fd7cc745d61a78c633daa6aed"
const K2_S_HS: Str = ""
const K2_SIG: Str = ""

// 2026-10-15, and 8 days later
const NOW: Int = 1792022400
const LATER: Int = 1792713600

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

fn pack(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    out.write_byte(UInt8(b.len() / 65536))
    out.write_byte(UInt8(b.len() / 256 % 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

fn splice(s: Str, lo: Int, hi: Int, r: Str) -> Str {
  let b = s.bytes()
  "${b[0..lo].to_str() ?? ""}${r}${b[hi..b.len()].to_str() ?? ""}"
}

fn named(w: Str) -> Str {
  if w == K1_S_HS {
    "<K1 server flight>"
  } else if w == K2_S_HS {
    "<K2 server flight>"
  } else if w.contains("<ske-ok>") {
    "<a full server flight, signature verified>"
  } else if w.len() > 120 {
    "${w.bytes()[0..32].to_str() ?? ""}...${w.bytes()[w.len() - 16..w.len()].to_str() ?? ""} (${w.len() / 2} bytes)"
  } else {
    w
  }
}

const KEYS: Str = "${SERVER_X25519}${SERVER_P256}${SERVER_P384}"

fn serve(os: Os, title: Str, chs: Str, capp: Str, sig: Str, suites: Str, chunk: Int, now: Str) uses stdio {
  let parts = pack([hex(chs), hex(capp), hex(CERT_P256), hex(KEY_P256_D), hex(sig)])
  let r = internal.crypto_op("tls12.server", hex(KEYS), parts, b"", "${suites} 29,23,24 - p256 ${chunk} 1 ${now}".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for w in line.split(" ") {
        ws.push(named(w))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

const SUITES: Str = "c02b,c02f,c02c,c030,cca9,cca8,c009,c013,c00a,c014"

fn main(os: Os) uses stdio {
  serve(os, "K1 full handshake, a ticket issued", K1_C_HS, K1_C_APP, K1_SIG, SUITES, 0, "${NOW}")
  serve(os, "K2 resumed", K2_C_HS, K2_C_APP, "", SUITES, 0, "${NOW}")
  serve(os, "K2 resumed, a byte at a time", K2_C_HS, K2_C_APP, "", SUITES, 1, "${NOW}")
  serve(os, "K2 with tickets off", K2_C_HS, K2_C_APP, "", SUITES, 0, "-")
  serve(os, "K2 past the ticket's lifetime", K2_C_HS, K2_C_APP, "", SUITES, 0, "${LATER}")
  // a byte of the ticket (well inside the ClientHello's session_ticket
  // extension) changed
  let at = (K2_C_HS.find("0023") ?? 0) + 40
  serve(os, "K2 with a corrupted ticket", splice(K2_C_HS, at, at + 2, "00"), K2_C_APP, "", SUITES, 0, "${NOW}")
  serve(os, "K2 with the session's suite disabled", K2_C_HS, K2_C_APP, "", "c02f,c02c,c030,cca9", 0, "${NOW}")
}
