// Another module's function as a value (native XO1201 "the name `m`
// here" before 2026-11-04, aws report entry 3): passed, stored in a
// struct field, returned, and put in a list.

use github.com/xo-lang/xo/test/fn_value_qualified/m

struct Codec {
  enc: fn(Int) -> Str
}

fn apply(f: fn(Int) -> Int, n: Int) -> Int { f(n) }

fn pick(twice: Bool) -> fn(Int) -> Int {
  if twice {
    return m.double
  }
  fn(n: Int) -> Int { n }
}

fn main(os: Os) {
  os.stdio.println("${apply(m.double, 21)}")
  let c = Codec{enc: m.label}
  os.stdio.println(c.enc(7))
  os.stdio.println("${pick(true)(5)} ${pick(false)(5)}")
  let fs: List[fn(Int) -> Int] = [m.double, fn(n: Int) -> Int { n + 1 }]
  var total = 0
  for f in fs {
    total += f(10)
  }
  os.stdio.println("${total}")
}
