// Float.copysign, frexp and ldexp (Go's math.Copysign, Frexp, Ldexp) and
// Float32's limits, on every backend; the values are Go's.
fn main(os: Os) {
  for f in [0.0, -0.0, 1.0, -1.5, 3.0, 1024.0, 0.1, 5e-324, 2.2250738585072014e-308, 1.7976931348623157e308, Float.inf, -Float.inf, Float.nan] {
    let (frac, e) = f.frexp()
    os.stdio.println("${f} copysign- ${f.copysign(-1.0)} copysign+ ${f.copysign(0.0)} frexp ${frac} ${e} back ${frac.ldexp(e)}")
  }
  for (x, e) in [(1.0, 1023), (1.0, 1024), (1.0, -1074), (1.0, -1075), (0.75, -1074), (3.0, -1076), (1.5, 100), (-2.0, 3), (0.5, 9223372036854775807), (0.5, -9223372036854775807), (0.5, Int.min), (1.0, Int.min), (1.0, Int.max)] {
    os.stdio.println("ldexp ${x} ${e} = ${x.ldexp(e)}")
  }
  os.stdio.println("${Float(Float32.max)} ${Float(Float32.smallest_nonzero)}")
}
