// amqp.dial over TLS takes the server name from ConnOptions.hostname when it is set (go-amqp's HostName), so a client can
// verify the namespace's name through a TLS proxy: the test server's certificate names localhost and good.test and 127.0.0.1;
// dialing the address 127.0.0.1 with the hostname good.test connects, with wrong.test the certificate check fails.
use std/amqp
use std/http
use std/tls

fn err_text(e: amqp.AmqpErr) -> Str {
  match e {
    Net(m) => m
    Protocol(m) => m
    Decode(m) => m
    Encode(m) => m
    Peer(w) => w.condition
    Auth(_, m) => m
  }
}

fn try_dial(os: Os, port: Str, hostname: Str) -> Str {
  let roots = match tls.roots(ca_pem()) {
    Ok(r) => r
    Err(e) => return "roots: ${e}"
  }
  let opts = amqp.ConnOptions{tls_roots: Some(roots), hostname: hostname, timeout_ms: 500, clock: Some(os.clock), sasl: amqp.Sasl.Anonymous}
  match amqp.dial(os.net, "amqps://127.0.0.1:${port}", opts) {
    Ok(_) => "connected"
    Err(e) => {
      let t = err_text(e)
      if t.contains("certificate") || t.contains("x509") { "certificate error: ${t}" } else { "after the handshake: ${t}" }
    }
  }
}

fn main(os: Os) {
  var r = http.router()
  r.handle("GET /", fn(_req) { http.text(200, "ok") })
  let cert = match http.tls_cert(good_cert(), good_key()) {
    Ok(c) => c
    Err(e) => {
      os.stdio.println("cert: ${e}")
      return
    }
  }
  match os.net.listen("127.0.0.1:0") {
    Ok(l) => {
      let srv = http.server(l, r).with_tls([cert])
      let port = srv.addr().split(":")[1]
      scope s {
        s.spawn_background(fn() {
          match srv.serve() {
            Ok(_) => ()
            Err(e) => os.stdio.println("serve failed: ${e}")
          }
        })
        os.stdio.println("hostname good.test: ${try_dial(os, port, "good.test")}")
        os.stdio.println("hostname wrong.test: ${try_dial(os, port, "wrong.test")}")
        os.stdio.println("no hostname: ${try_dial(os, port, "")}")
        s.cancel()
      }
    }
    Err(e) => os.stdio.println("listen failed: ${e}")
  }
}

