// A function with more locals than the wasm backend keeps as wasm
// locals (func.xo FRAME_MIN) keeps the rest in a frame on a stack in
// linear memory; recursing 200 deep needs several of that stack's
// chunks (a frame is about 1.1 KB: 200 deep takes the 64, 128 and 256 KB
// ones), given back on the way out, then taken again (decision 0447
// queue, component size: the stack was one resident 16 MB block). The
// a values are used before the recursive call and after it, so they
// stay live across it (used only after, they were computed there).

fn deep(n: Int, s: Int) -> Int {
  if n == 0 {
    return s % 1000
  }
  let a0 = n * 1 + 0 + s % 7
  let a1 = n * 2 + 1 + s % 7
