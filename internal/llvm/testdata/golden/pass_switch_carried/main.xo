// thread_switch copies the latch, header and dispatch into each arm of a
// jump table loop; the arms swap loop-carried values and set a Bool the
// loop test reads.
fn vm(code: List[Int], k: Int) -> Int {
  var pc = 0
  var a = k
  var b = 0
  var c = 1
  var go = true
  var n = 0
  while go && pc < code.len() && n < 10000 {
    n += 1
    match code[pc] {
      0 => {
        let t = a
        a = b
        b = t
      }
      1 => a = a + b
      2 => {
        b = (b * 2 + c) % 100003
        c = c + 1
      }
      3 => {
        let t = c
        c = a
        a = t
      }
      4 => go = a < 1000
      5 => {
        if a % 2 == 1 {
          pc = 0 - 1
        }
        a = a + 1
      }
      6 => b = b - a
      7 => {
        let m = a
        go = m != b
      }
      _ => c = c ^ a
    }
    pc += 1
  }
  n * 1000000 + (a % 1000) * 1000 + (b % 1000).abs() + c % 7
}

fn tags(xs: List[Int]) -> Int {
  var s = 0
  var last = 0
  var run = 0
  for x in xs {
    match x % 6 {
      0 => {
        s += last
        last = x
      }
      1 => {
        let t = run
        run = last
        last = t + x
      }
      2 => run += 1
      3 => s = s * 3 + run
      4 => {
        last = s
        s = run
      }
      _ => s -= x
    }
  }
  s * 1000 + last * 10 + run
}

// the dispatch shape thread_switch takes: `while true`, the header runs
// straight into the table, every arm jumps back through one latch; the
// arms rotate scalars the latch and the header read
fn vm2(code: List[Int], k: Int) -> Int {
  var pc = 0
  var a = k
  var b = 1
  var c = 2
  var steps = 0
  var last = 0
  while true {
    steps += 1
    if steps > 20000 {
      break
    }
    match code[pc] {
      0 => {
        let t = a
        a = b
        b = c
        c = t
      }
      1 => a = (a + b) % 10007
      2 => {
        last = pc
        b = (b * 3 + steps) % 10007
      }
      3 => {
        if a % 2 == 0 {
          pc = 0 - 1
        }
        a = a + 1
      }
      4 => {
        let t = c
        c = pc
        pc = t % code.len() - 1
        if pc < 0 - 1 {
          pc = 0 - 1
        }
      }
      5 => {
        if steps > 5000 || a > 3000 {
          break
        }
      }
      6 => c = c ^ last
      7 => {
        let t = b
        b = a % 101
        a = t + c
      }
      8 => last = last + a - b
      9 => {
        if (a ^ b) % 4 == 1 {
          pc = pc - 2
        }
      }
      _ => break
    }
    pc += 1
  }
  steps * 1000000 + a * 100 + b % 100 + c % 7
}

fn main(os: Os) {
  let k = (os.env.args().len() + 1)
  let progs = [[1, 2, 0, 1, 3, 4, 5], [2, 2, 1, 7, 0, 6, 3, 8, 5], [0, 0, 1, 1, 2, 3, 6, 7, 4, 5], [5, 1, 2, 3], [8, 8, 2, 1, 7]]
  for p in progs {
    os.stdio.println("vm ${vm(p, k)}")
  }
  var xs: List[Int] = []
  for i in 0..200 {
    xs.push((i * 37 + k) % 101)
  }
  os.stdio.println("tags ${tags(xs)}")
  for p in [[1, 2, 0, 1, 3, 5, 10], [2, 2, 1, 6, 0, 3, 5, 4, 1, 1], [0, 1, 2, 4, 1, 5, 3], [6, 1, 2, 0, 5, 3, 10], [7, 8, 9, 1, 2, 7, 0, 5, 9, 3, 8, 10], [9, 9, 1, 7, 2, 8, 5, 0, 3, 6, 10]] {
    os.stdio.println("vm2 ${vm2(p, k)}")
  }
}
