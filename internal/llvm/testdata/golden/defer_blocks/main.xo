// defer (core 3.5, decision 0009) on every way out of a block: the end
// of the block, return, `?`, break, continue, and value blocks. Faults
// are left out: the native backends exit without running deferred code.
enum E {
  Fail
} derive Display

fn work(stdio: Stdio, fail: Bool) -> Int ! E uses stdio {
  defer stdio.println("cleanup work")
  stdio.println("working")
  if fail {
    return Err(E.Fail)
  }
  42
}

fn early(stdio: Stdio, n: Int) -> Str uses stdio {
  defer stdio.println("leave early(${n})")
  if n > 0 {
    return "positive"
  }
  "non-positive"
}

fn with_try(stdio: Stdio) -> Int ! E uses stdio {
  defer stdio.println("with_try deferred")
  let v = work(stdio, true)?
  v + 1
}

fn nested(stdio: Stdio, n: Int) -> Int uses stdio {
  var total = 0
  defer stdio.println("nested total ${total}")
  for i in 0..n {
    defer {
      defer stdio.println("inner of ${i}")
      stdio.println("outer of ${i}")
    }
    if i == 2 {
      return total
    }
    total += i + 10
  }
  total
}

fn loop_value(stdio: Stdio) -> List[Str] uses stdio {
  var out: List[Str] = []
  var i = 0
  while i < 4 {
    defer i += 1
    if i == 1 {
      continue
    }
    defer out.push("seen ${i}")
    if i == 3 {
      break
    }
  }
  stdio.println("loop ended at ${i}")
  out
}

fn main(os: Os) {
  defer os.stdio.println("main deferred 1")
  defer os.stdio.println("main deferred 2")
  os.stdio.println("work ok: ${work(os.stdio, false).ok() ?? 0}")
  os.stdio.println("early: ${early(os.stdio, 1)} ${early(os.stdio, 0)}")
  os.stdio.println("with_try: ${with_try(os.stdio).is_err()}")
  for i in 0..3 {
    defer os.stdio.println("end of iteration ${i}")
    if i == 1 {
      continue
    }
    os.stdio.println("iteration ${i}")
  }
  var x = 1
  {
    defer os.stdio.println("block sees x=${x}")
    x = 2
  }
  let v = {
    defer os.stdio.println("value block deferred")
    10
  }
  os.stdio.println("v=${v}")
  outer: for i in 0..5 {
    defer os.stdio.println("leaving ${i}")
    if i == 2 {
      break outer
    }
  }
  os.stdio.println("nested ${nested(os.stdio, 4)}")
  for s in loop_value(os.stdio) {
    os.stdio.println(s)
  }
}
