// zip64 writing (decision 0499): past 65,534 entries archive.zip and
// archive.zip_writer write the zip64 end record and its locator, as Go's
// writer does (the Go backend's is Go's), so 65,535, 65,536 and 65,537
// entries read back whole, the classic end record's count is 0xffff, and
// the native bytes equal the Go backend's (the want below holds a hash of
// each archive). Before the decision both refused the 65,536th entry, and
// native zip() before that wrote the count modulo 65,536.
use std/archive
use std/crypto

fn entries(n: Int) -> List[archive.Entry] {
  var out: List[archive.Entry] = []
  for i in 0..n {
    out.push(archive.file("e${i}", "${i}".bytes()))
  }
  out
}

fn check(os: Os, what: Str, z: Bytes) {
  match archive.unzip(z) {
    Ok(es) => {
      var ok = 0
      for i in 0..es.len() {
        if es[i].path == "e${i}" && es[i].data == "${i}".bytes() {
          ok += 1
        }
      }
      os.stdio.println("${what}: ${es.len()} entries read back, ${ok} right")
    }
    Err(e) => os.stdio.println("${what}: unzip ${e}")
  }
}

fn main(os: Os) {
  for n in [65534, 65535, 65536, 65537] {
    match archive.zip(entries(n)) {
      Ok(z) => {
        // the end record's entry count: 0xffff when the zip64 record holds it
        let k = z.len() - 22
        let count = Int(z[k + 10]) | (Int(z[k + 11]) << 8)
        os.stdio.println("zip ${n}: ${z.len()} bytes, end record count ${count}, sha256 ${crypto.sha256(z).to_hex()[0..16]}")
        check(os, "  read", z)
      }
      Err(e) => os.stdio.println("zip ${n}: ${e}")
    }
  }
  let p = "zip_entry_limit_tmp.zip"
  os.fs.remove(p).ok()
  let f = os.fs.create(p).or_fault("create")
  var w = archive.zip_writer(f)
  for e in entries(65536) {
    w.add(e).or_fault("add")
  }
  w.create("e65536", 0o644).or_fault("create entry")
  w.write(b"65536").or_fault("write")
  w.close().or_fault("close writer")
  f.close().or_fault("close")
  let z = os.fs.read(p).or_fault("read")
  os.stdio.println("zip_writer 65537: ${z.len()} bytes, sha256 ${crypto.sha256(z).to_hex()[0..16]}")
  check(os, "  read", z)
  os.fs.remove(p).or_fault("cleanup")
}
