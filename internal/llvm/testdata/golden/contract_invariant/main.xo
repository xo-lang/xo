// Struct invariants (core 9.1) on the native backends: checked after
// construction (literals, defaults) and after every `var` method (on
// success only for a method that can fail). The last call breaks one in
// a `var` method.

struct Range {
  lo: Int
  hi: Int
} invariant lo <= hi

struct Percent {
  value: Int = 0
  label: Str = "p"
} invariant value >= 0 && value <= 100 && !label.is_empty()

enum RangeErr {
  TooWide
} derive Display

fn (var r: Range) widen(by: Int) {
  r.lo -= by
  r.hi += by
}

fn (var r: Range) shrink(by: Int) {
  r.lo += by
  r.hi -= by
}

// breaks the invariant, but fails: not checked
fn (var r: Range) try_flip(limit: Int) -> Int ! RangeErr {
  let lo = r.lo
  r.lo = r.hi + 1
  if r.hi - lo > limit {
    return Err(RangeErr.TooWide)
  }
  r.lo = lo
  r.hi - r.lo
}

fn (r: Range) width() -> Int { r.hi - r.lo }

fn main(os: Os) {
  let p = Percent{}
  let q = Percent{value: 50, label: "half"}
  os.stdio.println("${p.value} ${p.label} ${q.value} ${q.label}")
  let ok = Range{lo: 1, hi: 2}
  os.stdio.println("ok ${ok.lo} width ${ok.width()}")
  var r = Range{lo: 0, hi: 4}
  r.widen(1)
  os.stdio.println("widened ${r.lo}..${r.hi}")
  match r.try_flip(2) {
    Ok(w) => os.stdio.println("flip ${w}")
    Err(e) => os.stdio.println("flip failed: ${e} ${r.lo}..${r.hi}")
  }
  var s = Range{lo: 0, hi: 1}
  os.stdio.println("flip small ${s.try_flip(5).ok() ?? -1}")
  os.stdio.println("shrink past the invariant next")
  r.shrink(10)
  os.stdio.println("never ${r.lo}")
}
