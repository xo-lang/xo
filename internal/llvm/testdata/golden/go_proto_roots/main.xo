// Every root kind of the Go backend's protocol method walk (decision
// 0542), each reaching a type only through it: a type the walk missed has
// no XoEq or XoHash on --backend=go, and the program faults with "xo
// internal: XoEq not generated", so this golden's output is the same on
// every backend only while the walk finds every root.

// reached only through a field of a compared struct
struct Inner {
  tags: List[Str]
}

struct Outer {
  name: Str
  inner: Inner
}

// reached only as a Map key, and its payload type through it
enum Color {
  Red
  Rgb(shade: Shade)
}

struct Shade {
  level: Int
}

// reached only as a type argument of a constrained generic function
struct Pair {
  a: Int
  b: Str
}

fn same[T: Eq](x: T, y: T) -> Bool {
  x == y
}

// reached only through an interface value's dynamic type
interface Named {
  fn name(self) -> Str
}

struct Dog {
  n: Str
  owner: Owner
}

struct Owner {
  id: Int
}

fn (d: Dog) name() -> Str { d.n }

// reached only through an Option compared with ==
struct Boxed {
  v: Int
}

// never compared, hashed or generated: its methods may be left out
struct Unused {
  x: Int
}

// reached only as a Set element, through a newtype of a struct
struct Loc {
  line: Int
}

type Code struct(Loc)

// reached only as the element a list searches for (the runtime's
// List_contains and List_index_of compare with Eq)
struct Wanted {
  id: Int
}

struct Spot {
  name: Str
}

// reached only through an unconstrained type parameter that is compared
struct Plain {
  v: Int
}

fn alike[T](x: T, y: T) -> Bool {
  x == y
}

// reached only as the key of a Map a generic function builds
struct TallyKey {
  k: Int
}

fn tally[K](xs: List[K]) -> Map[K, Int] {
  var m: Map[K, Int] = {}
  for x in xs {
    m[x] = (m.get(x) ?? 0) + 1
  }
  m
}

// reached only through a generic that passes its type parameter to one
// that compares
struct Deep {
  d: Int
}

fn inner_eq[U](a: U, b: U) -> Bool {
  a == b
}

fn outer_eq[T](a: T, b: T) -> Bool {
  inner_eq(a, b)
}

// reached only through prelude searches and sets inside generics
struct HasT {
  h: Int
}

fn has[T](xs: List[T], x: T) -> Bool {
  xs.contains(x)
}

struct UniqT {
  u: Int
}

fn uniq[T](xs: List[T]) -> Int {
  xs.to_set().len()
}

// reached only as the element of a Set inside a generic struct
struct BagT {
  b: Int
}

struct Bag[T] {
  items: Set[T]
}

fn main(os: Os) {
  let o1 = Outer{name: "a", inner: Inner{tags: ["x", "y"]}}
  let o2 = Outer{name: "a", inner: Inner{tags: ["x", "y"]}}
  let o3 = Outer{name: "a", inner: Inner{tags: ["x"]}}
  os.stdio.println("outer: ${o1 == o2} ${o1 == o3} ${o1 != o3}")
  var counts: Map[Color, Int] = {}
  counts[Color.Rgb(Shade{level: 3})] = 1
  counts[Color.Red] = 2
  counts[Color.Rgb(Shade{level: 3})] = (counts.get(Color.Rgb(Shade{level: 3})) ?? 0) + 10
  os.stdio.println("colors: ${counts.len()} ${counts.get(Color.Rgb(Shade{level: 3})) ?? -1} ${counts.get(Color.Rgb(Shade{level: 4})) ?? -1}")
  os.stdio.println("pairs: ${same(Pair{a: 1, b: "x"}, Pair{a: 1, b: "x"})} ${same(Pair{a: 1, b: "x"}, Pair{a: 2, b: "x"})}")
  let d1: Named = Dog{n: "rex", owner: Owner{id: 1}}
  let d2: Named = Dog{n: "rex", owner: Owner{id: 1}}
  let d3: Named = Dog{n: "rex", owner: Owner{id: 2}}
  os.stdio.println("named: ${d1 == d2} ${d1 == d3}")
  let b1: Boxed? = Some(Boxed{v: 1})
  let b2: Boxed? = Some(Boxed{v: 1})
  let b3: Boxed? = None
  os.stdio.println("boxed: ${b1 == b2} ${b1 == b3}")
  let u = Unused{x: 7}
  os.stdio.println("unused: ${u.x}")
  var seen: Set[Code] = #{}
  seen.add(Code(Loc{line: 1}))
  seen.add(Code(Loc{line: 1}))
  seen.add(Code(Loc{line: 2}))
  os.stdio.println("codes: ${seen.len()} ${seen.contains(Code(Loc{line: 2}))}")
  let ws = [Wanted{id: 1}, Wanted{id: 2}]
  os.stdio.println("wanted: ${ws.contains(Wanted{id: 2})} ${ws.contains(Wanted{id: 3})}")
  let sp = [Spot{name: "a"}, Spot{name: "b"}]
  os.stdio.println("spot: ${sp.index_of(Spot{name: "b"}) ?? -1}")
  os.stdio.println("plain: ${alike(Plain{v: 1}, Plain{v: 1})} ${alike(Plain{v: 1}, Plain{v: 2})}")
  let tl = tally([TallyKey{k: 1}, TallyKey{k: 2}, TallyKey{k: 1}])
  os.stdio.println("tally: ${tl.len()} ${tl.get(TallyKey{k: 1}) ?? -1}")
  os.stdio.println("deep: ${outer_eq(Deep{d: 1}, Deep{d: 1})} ${outer_eq(Deep{d: 1}, Deep{d: 2})}")
  os.stdio.println("has: ${has([HasT{h: 1}], HasT{h: 1})} ${has([HasT{h: 1}], HasT{h: 2})}")
  os.stdio.println("uniq: ${uniq([UniqT{u: 1}, UniqT{u: 1}, UniqT{u: 2}])}")
  var bag = Bag[BagT]{items: #{}}
  bag.items.add(BagT{b: 1})
  bag.items.add(BagT{b: 1})
  os.stdio.println("bag: ${bag.items.len()} ${bag.items.contains(BagT{b: 1})}")
}
