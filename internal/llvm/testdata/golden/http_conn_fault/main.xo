// A fault in the server's own connection code (not a handler's, which
// http_fault covers) ends that connection only, as Go's net/http
// recovers per connection: logged as "http: panic serving", the server
// serving on, nothing live at exit. The fault comes from the servers'
// test probe (XO_HTTP_FAULT_PROBE=1, env.txt): /xo-fault-probe/conn in
// the HTTP/1.1 reader, /xo-fault-probe/frame in the HTTP/2 frame
// handling (the connection ends), /xo-fault-probe/stream in an HTTP/2
// stream's request (the stream is reset, no log line, as net/http).
// Before the fix the native server stopped answering anyone
// (gotchas/native-server-unisolated-fault-wedges.md). A fresh client
// after each HTTP/2 probe, and the HTTP/1.1 probe on a raw connection:
// what a client retries on a dropped connection (Go's Transport sends the
// GET again) is not under test.
use std/http

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /ok", fn(_req) { http.text(200, "ok") })
  r
}

fn show(os: Os, label: Str, r: Result[http.Response, http.ClientErr]) {
  match r {
    Ok(resp) => os.stdio.println("${label}: ${resp.status} ${resp.text() ?? "?"}")
    Err(_) => os.stdio.println("${label}: failed")
  }
}

/// Sends a request on a connection of its own and reads until the server
/// closes it: the bytes answered.
fn raw(os: Os, addr: Str, req: Str) -> Int {
  let c = os.net.dial(addr).or_fault("dial")
  c.write(req.bytes()).or_fault("write")
  var n = 0
  while true {
    match c.read(4096) {
      Ok(Some(b)) => n += b.len()
      _ => break
    }
  }
  c.close()
  n
}

fn main(os: Os) {
  let cert = http.tls_cert(good_cert(), good_key()).or_fault("cert")
  let l1 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l2 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let plain = http.server(l1, routes())
  let tls = http.server(l2, routes()).with_tls([cert])
  let h1 = "http://${l1.addr()}"
  let h2 = "https://${l2.addr()}"
  scope s {
    for srv in [plain, tls] {
      s.spawn_background(fn() {
        match srv.serve() {
          Ok(_) => ()
          Err(e) => os.stdio.println("serve failed: ${e}")
        }
      })
    }
    show(os, "http/1.1 ok", http.client(os.net, timeout: 5s).get(h1 + "/ok"))
    // Connection: close, so that without the probe (a 404) it ends too
    let n = raw(os, l1.addr(), "GET /xo-fault-probe/conn HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    os.stdio.println("http/1.1 connection fault: closed, ${n} bytes answered")
    show(os, "http/1.1 ok after", http.client(os.net, timeout: 5s).get(h1 + "/ok"))
    let c = fn() -> http.Client { http.client(os.net, timeout: 5s).with_roots(ca_pem()).or_fault("roots") }
    show(os, "http/2 ok", c().get(h2 + "/ok"))
    show(os, "http/2 stream fault", c().get(h2 + "/xo-fault-probe/stream"))
    show(os, "http/2 ok after stream", c().get(h2 + "/ok"))
    show(os, "http/2 frame fault", c().get(h2 + "/xo-fault-probe/frame"))
    show(os, "http/2 ok after frame", c().get(h2 + "/ok"))
  }
  os.stdio.println("servers stopped")
}

