// An HTTP/2 client fails the connection on a server SETTINGS value out of
// range, as Go 1.26.11's transport does (Setting.Valid, the fix for
// GO-2026-4918): MAX_FRAME_SIZE outside 16384 to 2^24-1 and ENABLE_PUSH
// or ENABLE_CONNECT_PROTOCOL above 1 are PROTOCOL_ERROR, INITIAL_WINDOW_SIZE
// above 2^31-1 is FLOW_CONTROL_ERROR, and a payload that is not whole
// settings FRAME_SIZE_ERROR. Before the fix the client ignored
// the value and took the 200 that followed it. A raw h2c server sends the
// SETTINGS frame, then HEADERS (":status 200", end of stream) on stream 1.
use std/http

fn serve_once(os: Os, setting: Str) -> Str ! {
  let raw = os.net.listen("127.0.0.1:0")?
  let addr = "${raw.addr()}"
  var out = ""
  scope s {
    s.spawn_background(fn() {
      let c = match raw.accept() {
        Ok(c) => c
        Err(_) => return
      }
      let n = setting.len() / 2
      let frames = Bytes.from_hex("0000" + "0123456789abcdef"[n / 16..n / 16 + 1] + "0123456789abcdef"[n % 16..n % 16 + 1] + "040000000000" + setting + "00000101050000000188") ?? b""
      c.write(frames).ignore_err("frames")
      while true {
        match c.read(4096) {
          Ok(Some(_)) => ()
          _ => break
        }
      }
      c.close()
    })
    let c = http.client(os.net, timeout: 10s).with_protocols(#{http.Protocol.UnencryptedHttp2})
    out = match c.get("http://${addr}/") {
      Ok(r) => "status ${r.status}"
      Err(e) => "error: ${e}".replace(addr, "ADDR")
    }
    raw.close()
  }
  out
}

fn main(os: Os) ! {
  for (name, setting) in [
    ("MAX_FRAME_SIZE 16384", "000500004000"),
    ("MAX_FRAME_SIZE 0", "000500000000"),
    ("MAX_FRAME_SIZE 16383", "000500003fff"),
    ("MAX_FRAME_SIZE 2^24", "000501000000"),
    ("INITIAL_WINDOW_SIZE 2^31", "000480000000"),
    ("ENABLE_PUSH 2", "000200000002"),
    ("ENABLE_CONNECT_PROTOCOL 2", "000800000002"),
    ("ENABLE_PUSH 1 and an unknown setting", "000200000001ffff12345678"),
    ("a payload of 5 bytes", "0005000040"),
  ] {
    os.stdio.println("${name}: ${serve_once(os, setting)?}")
  }
}
