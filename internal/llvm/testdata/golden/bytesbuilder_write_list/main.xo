// BytesBuilder.write_list and Bytes.from_list (decision 0667): runs below
// and above the native word path's eight bytes and the copy at 256, values
// 250 to 255 (a word access to a packed element or a checked shift on wasm
// gets them wrong), no aliasing of the list afterwards, and the range
// fault at the caller's line.
fn sum(b: Bytes) -> Int {
  var s = 0
  for (i, x) in b.indexed() {
    s = (s * 31 + Int(x) + i) % 1000000007
  }
  s
}

fn main(os: Os) {
  let k = os.env.args().len()
  var l: List[UInt8] = []
  for i in 0..1000 {
    l.push(UInt8((i * 7 + 250) % 256))
  }
  for (from, to) in [(0, 0), (0, 1), (3, 10), (0, 8), (5, 21), (1, 255), (0, 256), (7, 263), (0, 1000), (999, 1000)] {
    var b = BytesBuilder.new()
    b.write_str("ab")
    b.write_list(l, from + k - k, to)
    b.write_byte(9)
    let out = b.freeze()
    var ok = out.len() == to - from + 3 && out[0] == 97 && out[out.len() - 1] == 9
    for j in from..to {
      if out[j - from + 2] != l[j] {
        ok = false
      }
    }
    os.stdio.println("${from}..${to} len=${out.len()} ok=${ok} sum=${sum(out)}")
  }
  let all = Bytes.from_list(l)
  os.stdio.println("from_list len=${all.len()} sum=${sum(all)} first=${all[0]} last=${all[999]}")
  let e: List[UInt8] = []
  os.stdio.println("empty len=${Bytes.from_list(e).len()}")
  var big = BytesBuilder.with_capacity(4)
  for _ in 0..5 {
    big.write_list(l, 0, 1000)
  }
  let g = big.freeze()
  os.stdio.println("five len=${g.len()} sum=${sum(g)}")
  var m: List[UInt8] = [1, 2, 3]
  let fb = Bytes.from_list(m)
  m[0] = 9
  var mb = BytesBuilder.new()
  mb.write_list(m, 0, 3)
  m[1] = 8
  let c = mb.freeze()
  os.stdio.println("copies ${fb[0]} ${c[0]} ${c[1]}")
  var bad = BytesBuilder.new()
  bad.write_list(l, 10, 1001 + k - k)
  os.stdio.println("not reached")
}
