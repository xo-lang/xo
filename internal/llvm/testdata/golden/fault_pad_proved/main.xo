// A fault the operands prove (csv.parse's inlined check_delims with a
// constant invalid separator) inside an isolated function: the block
// that faults ends in a call that does not return, and its landing pad
// is reached from no branch once the check is decided. The pad must
// still be emitted (arm64 mir.xo msuccs; 2026-10-23: "LpGL1jtk_f1_b74 is
// used but not defined" from the assembler on arm64 and amd64).
use std/csv
use std/task

fn parse_bad() -> Str ! Int {
  match csv.parse("a,b\n", sep: '"') {
    Ok(rs) => "${rs.len()}"
    Err(e) => "err ${e}"
  }
}

fn parse_good() -> Str ! Int {
  match csv.parse("a;b\n", sep: ';') {
    Ok(rs) => "${rs.len()} ${rs[0].len()}"
    Err(e) => "err ${e}"
  }
}

fn show(stdio: Stdio, label: Str, r: Result[Str, task.Isolated[Int]]) uses stdio {
  match r {
    Ok(v) => stdio.println("${label}: ok ${v}")
    Err(task.Isolated.Faulted(info)) => stdio.println("${label}: ${info.msg}")
    Err(task.Isolated.Failed(e)) => stdio.println("${label}: failed ${e}")
  }
}

fn main(os: Os) {
  show(os.stdio, "bad", task.isolate(parse_bad))
  show(os.stdio, "good", task.isolate(parse_good))
  show(os.stdio, "format", task.isolate(fn() -> Str ! Int { csv.format([["a", "b"]], sep: '"') }))
}
