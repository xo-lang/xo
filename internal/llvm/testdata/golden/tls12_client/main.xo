// The TLS 1.2 client of the native backends' TLS (std/native/llrt/tls12.xo,
// decision 0202) against crypto/tls's server, through
// internal.crypto_op("tls12.client"), whose Go reference (std/rt
// internal_tls12.go) drives crypto/tls's client over the same bytes. The
// traces were recorded from crypto/tls's client and server (Go 1.26.1,
// GODEBUG=cryptocustomrand=1, random sources repeating 0x11 for the
// client and 0x22 for the server, so the client's random, session id,
// and ECDHE keys are fixed and the Xo client is given the same key), with
// a test CA and leaves for example.test: each suite, X25519, P-256, and
// P-384, ECDSA P-256, ECDSA P-384, and RSA-PSS signatures, ALPN; the
// server's flights whole and a byte at a time; then the failures: an
// expired chain, another host, no root, a corrupted Finished record, a
// corrupted ServerKeyExchange signature, a suite and a curve not
// offered, ALPN not offered or not matching, a corrupted record after
// the handshake; a server asking for a certificate (the client sends an
// empty one), a server's fatal alert, a warning alert before the
// handshake (ignored), and bytes that are not TLS. Then the client
// offering TLS 1.3 and 1.2 in one ClientHello (crypto/tls's; tls13.xo
// sends it and hands a TLS 1.2 ServerHello over to tls12.resume) against
// a TLS 1.2 server, and the server random carrying RFC 8446's downgrade
// sentinels.
use std/internal

const CA: Str = ""
const CLIENT_X25519: Str = "1111111111111111111111111111111111111111111111111111111111111111"
const CLIENT_P256: Str = "1153111111111111111111111111111111111111111111111111111111111111"
const CLIENT_P384: Str = "115311111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111"
// A: suite c02b curve 29 cert p256 alpn [] [] -> ""
const A_C_HS: Str = ""
const A_C_APP: Str = "170303001c00000000000000014b290322c70c11a10b5be132142d20ef85a785a3150303001a0000000000000002cd01b127e283a311b3afbde6a030d69ae482"
const A_S_HS: Str = ""
const A_S_APP: Str = "1703030021000000000000000110a2271226239457616d7ef3712b4d3e0ac5902c526f59bec6150303001a0000000000000002cf08b4902957eef4da303ca0873e2861dfa0"
// B: suite c02c curve 23 cert p384 alpn [] [] -> ""
const B_C_HS: Str = ""
const B_C_APP: Str = "170303001c0000000000000001b0619daf3321dcf9d489281d1e3f594f9b63ead5150303001a0000000000000002f324a135f00138a3abf0c806e5359cf5994e"
const B_S_HS: Str = ""
const B_S_APP: Str = "17030300210000000000000001cb8b08d952812beb4835397e74e1620775353a5b3bcb65aaf1150303001a000000000000000236eee5fb9dbb49782ff703059fd053e0b955"
// C: suite cca8 curve 24 cert rsa alpn [] [] -> ""
const C_C_HS: Str = ""
const C_C_APP: Str = "1703030014bd838a80f7225799b03d666fcf72091c18501bc515030300129e2941b97ebc12f14dd9f0ad181e5385ab35"
const C_S_HS: Str = ""
const C_S_APP: Str = "1703030019677d8d2c458dce9ec94a6a9d26a58673e79cae25793906f6b615030300124519714676fd2ac453b1902fbbf2fa7d2361"
// D: suite c02f curve 29 cert rsa alpn [h2 http/1.1] [http/1.1] -> "http/1.1"
const D_C_HS: Str = ""
const D_C_APP: Str = "170303001c0000000000000001f86bfb55034194b14dacbfdd66b9ec26bcf31dc0150303001a0000000000000002b42e621c7b30eba00def5097e7f6ec23889d"
const D_S_HS: Str = ""
const D_S_APP: Str = "17030300210000000000000001a7dfb14c151512a9f8312dce5bafc5b6eecbb52bbc1d57a2a6150303001a0000000000000002451f8849b9bc252b20826cfa883e0aea4602"
// E: suite c030 curve 29 cert rsa alpn [] [] -> ""
const E_C_HS: Str = ""
const E_C_APP: Str = "170303001c000000000000000167e8d839b1ab47a1271d751e6d3220c3f648c997150303001a00000000000000020c6ffccb94a449288aeda13f3916c1a59ee5"
const E_S_HS: Str = ""
const E_S_APP: Str = "170303002100000000000000018d31dbe31e528822ae0649bdf784f14ded90b3d6944477faf8150303001a0000000000000002ccd54932034ef30807ec25de4cd931b7f0a0"
// F: suite cca9 curve 29 cert p256 alpn [] [] -> ""
const F_C_HS: Str = ""
const F_C_APP: Str = "1703030014d3c0f1c97f12cbca9ef456ccd155ec9ce9b006e01503030012bbb9881ca86c37b74aa50724c5cfa9746660"
const F_S_HS: Str = ""
const F_S_APP: Str = "17030300195aaafe31df428789149bd148934bc850f8844ace6d754927cc150303001223406efc869fd1b4c691aae265a0f7d2b9b6"

// G: suite c02b curve 29 cert p256 alpn [] [] -> ""
const G_C_HS: Str = ""
const G_C_APP: Str = "170303001c00000000000000013dcf5c1c7b806f558962b8bb39990071581ba3a8150303001a0000000000000002f9ceac0c3dcbedc49ba55062a1ee37a4a242"
const G_S_HS: Str = ""
const G_S_APP: Str = "17030300210000000000000001264cb9d928acdaf77ed91e18b94572ec16eefff7b8b004f4f0150303001a000000000000000275e53edb80475b7b9a22801c1dbfef624761"

// H: suite c02b curve 29 cert p256 alpn [] [] -> ""
const H_C_HS: Str = ""
const H_C_APP: Str = "170303001c000000000000000161cf476e1d4b6ac024c31a22afb1e51e5a65083c150303001a00000000000000025eb969f4eb9fd72367b4b1ce2ddbb2d039a6"
const H_S_HS: Str = ""
const H_S_APP: Str = "17030300210000000000000001a15f3f91db3d3c266c33be042fd6a48de766ddaa9b11c2ca05150303001a0000000000000002f372aef3298ddaa522422bc53c8d90b12709"

// 2026-10-15 (inside the certificates' validity, 2026 to 2036), and 2040
const NOW: Int = 1792022400
const LATE: Int = 2208988800

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

/// The parts as 3 byte lengths and bytes.
fn pack(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    out.write_byte(UInt8(b.len() / 65536))
    out.write_byte(UInt8(b.len() / 256 % 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

/// s with the hex digits from lo to hi replaced by r.
fn splice(s: Str, lo: Int, hi: Int, r: Str) -> Str {
  let b = s.bytes()
  "${b[0..lo].to_str() ?? ""}${r}${b[hi..b.len()].to_str() ?? ""}"
}

/// A trace's records named in the lines.
struct Names {
  c_hs: Str
  c_app: Str
}

fn named(w: Str, n: Names) -> Str {
  if w == n.c_hs {
    "<client flight>"
  } else if w == n.c_app {
    "<client data and close_notify>"
  } else if w.len() > 120 {
    "${w.bytes()[0..32].to_str() ?? ""}...${w.bytes()[w.len() - 16..w.len()].to_str() ?? ""} (${w.len() / 2} bytes)"
  } else {
    w
  }
}

fn replay(os: Os, title: Str, key: Str, shs: Str, sapp: Str, root: Str, now: Int, host: Str, suites: Str, groups: Str, alpn: Str, chunk: Int, n: Names) uses stdio {
  let parts = pack([hex(shs), hex(sapp), "ping".bytes(), hex(root)])
  let r = internal.crypto_op("tls12.client", hex(key), parts, b"", "${now} ${host} ${suites} ${groups} ${alpn} ${chunk}".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for w in line.split(" ") {
        ws.push(named(w, n))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

/// The ClientHello message of a client's first record.
fn hello_msg(c_hs: Str) -> Bytes {
  let b = hex(c_hs)
  let n = Int(b[3]) * 256 + Int(b[4])
  b[5..5 + n]
}

fn combined(os: Os, title: Str, shs: Str, n: Names) uses stdio {
  let parts = pack([hello_msg(H_C_HS), hex(shs), hex(H_S_APP), "ping".bytes(), hex(CA)])
  let r = internal.crypto_op("tls12.combined", hex(CLIENT_X25519), parts, b"", "${NOW} example.test c02b 29,23,24 - 0".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for w in line.split(" ") {
        ws.push(named(w, n))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

fn run(os: Os, title: Str, key: Str, shs: Str, sapp: Str, suite: Str, group: Str, alpn: Str, n: Names) uses stdio { replay(os, title, key, shs, sapp, CA, NOW, "example.test", suite, group, alpn, 0, n) }

fn main(os: Os) uses stdio {
  let a = Names{c_hs: A_C_HS, c_app: A_C_APP}
  run(os, "A ecdsa p256, x25519, aes128-gcm", CLIENT_X25519, A_S_HS, A_S_APP, "c02b", "29", "-", a)
  run(os, "B ecdsa p384, p256, aes256-gcm", CLIENT_P256, B_S_HS, B_S_APP, "c02c", "23", "-", Names{c_hs: B_C_HS, c_app: B_C_APP})
  run(os, "C rsa-pss, p384, chacha20", CLIENT_P384, C_S_HS, C_S_APP, "cca8", "24", "-", Names{c_hs: C_C_HS, c_app: C_C_APP})
  run(os, "D rsa-pss, x25519, aes128-gcm, alpn", CLIENT_X25519, D_S_HS, D_S_APP, "c02f", "29", "h2,http/1.1", Names{c_hs: D_C_HS, c_app: D_C_APP})
  run(os, "E rsa-pss, x25519, aes256-gcm", CLIENT_X25519, E_S_HS, E_S_APP, "c030", "29", "-", Names{c_hs: E_C_HS, c_app: E_C_APP})
  run(os, "F ecdsa p256, x25519, chacha20", CLIENT_X25519, F_S_HS, F_S_APP, "cca9", "29", "-", Names{c_hs: F_C_HS, c_app: F_C_APP})
  replay(os, "A byte at a time", CLIENT_X25519, A_S_HS, A_S_APP, CA, NOW, "example.test", "c02b", "29", "-", 1, a)
  replay(os, "expired", CLIENT_X25519, A_S_HS, A_S_APP, CA, LATE, "example.test", "c02b", "29", "-", 0, a)
  replay(os, "other host", CLIENT_X25519, A_S_HS, A_S_APP, CA, NOW, "other.test", "c02b", "29", "-", 0, a)
  replay(os, "no root", CLIENT_X25519, A_S_HS, A_S_APP, "", NOW, "example.test", "c02b", "29", "-", 0, a)
  let fin = A_S_HS.len() - 20
  run(os, "corrupt finished", CLIENT_X25519, splice(A_S_HS, fin, fin + 2, "00"), A_S_APP, "c02b", "29", "-", a)
  let at = (A_S_HS.find("3044022071721d46") ?? 0) + 20
  run(os, "corrupt signature", CLIENT_X25519, splice(A_S_HS, at, at + 2, "00"), A_S_APP, "c02b", "29", "-", a)
  run(os, "suite not offered", CLIENT_X25519, A_S_HS, A_S_APP, "c02f", "29", "-", a)
  run(os, "curve not offered", CLIENT_P256, A_S_HS, A_S_APP, "c02b", "23", "-", a)
  run(os, "alpn not offered", CLIENT_X25519, D_S_HS, D_S_APP, "c02f", "29", "-", a)
  run(os, "alpn not matching", CLIENT_X25519, D_S_HS, D_S_APP, "c02f", "29", "h2", a)
  run(os, "corrupt data record", CLIENT_X25519, A_S_HS, splice(A_S_APP, 40, 42, "00"), "c02b", "29", "-", a)
  run(os, "G certificate requested", CLIENT_X25519, G_S_HS, G_S_APP, "c02b", "29", "-", Names{c_hs: G_C_HS, c_app: G_C_APP})
  run(os, "server alert", CLIENT_X25519, "15030300020228", "", "c02b", "29", "-", a)
  run(os, "warning first", CLIENT_X25519, "15030300020170${A_S_HS}", A_S_APP, "c02b", "29", "-", a)
  run(os, "not tls", CLIENT_X25519, "485454502f312e3120343030", "", "c02b", "29", "-", a)
  let h = Names{c_hs: H_C_HS, c_app: H_C_APP}
  combined(os, "H one hello for 1.3 and 1.2, the server picks 1.2", H_S_HS, h)
  // the last 8 bytes of the server random (hex digits 70 to 86 of the
  // first record: header, message header, version, random)
  combined(os, "H downgrade sentinel 1.2", splice(H_S_HS, 70, 86, "444f574e47524401"), h)
  combined(os, "H downgrade sentinel 1.1", splice(H_S_HS, 70, 86, "444f574e47524400"), h)
}
