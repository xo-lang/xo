// X.509 chain verification of the native backends' TLS
// (std/native/llrt/x509verify.xo, the zero-C audit's B31) against Go's
// x509.Verify through internal.crypto_op: chains through intermediates,
// host names (DNS, wildcard, IP), validity times, unknown and wrong
// roots, extended key usages nested through the chain, DNS name
// constraints (permitted, excluded, a wildcard under an excluded name),
// path lengths, a parent that is not a CA or may not sign certificates,
// an unhandled critical extension, and RSA keys. The certificates were
// made by Go.
use std/internal

const ROOT: Str = ""
const ROOT_OTHER: Str = ""
const FAKE_ROOT: Str = ""
const INTER: Str = ""
const LEAF: Str = ""
const DIRECT: Str = ""
const EVIL: Str = ""
const BAD: Str = ""
const STAR_BAD: Str = ""
const BARE: Str = ""
const INTER2: Str = ""
const DEEP: Str = ""
const INTER_OLD: Str = ""
const LEAF_OLD: Str = ""
const INTER_CLIENT: Str = ""
const LEAF_SERVER: Str = ""
const NOT_CA: Str = ""
const LEAF_NOTCA: Str = ""
const NO_CERTSIGN: Str = ""
const LEAF_NOKEY: Str = ""
const CRIT: Str = ""
const RSA_SELF: Str = ""
const RSA_ROOT: Str = ""
const RSA_LEAF: Str = ""

const T0: Int = 1767323045
const SERVER: Str = "1.3.6.1.5.5.7.3.1"
const CLIENT: Str = "1.3.6.1.5.5.7.3.2"
const ANY: Str = "2.5.29.37.0"

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

/// The certificates as a list of 2 byte lengths and DERs.
fn pack(xs: List[Str]) -> Bytes {
  var out = BytesBuilder.new()
  for x in xs {
    let b = hex(x)
    out.write_byte(UInt8(b.len() / 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

fn check(os: Os, name: Str, leaf: Str, inters: List[Str], roots: List[Str], now: Int, host: Str, usage: Str) uses stdio {
  let h = if host == "" { "-" } else { host }
  let r = internal.crypto_op("chain.verify", hex(leaf), pack(inters), pack(roots), "${now} ${h} ${usage}".bytes())
  os.stdio.println("${name}: ${r.to_str() ?? ""}")
}

fn main(os: Os) uses stdio {
  let now = T0 + 30 * 86400
  let late = T0 + 730 * 86400
  check(os, "chain", LEAF, [INTER], [ROOT], now, "www.example.com", SERVER)
  check(os, "wildcard", LEAF, [INTER], [ROOT], now, "foo.api.example.com", SERVER)
  check(os, "wildcard parent", LEAF, [INTER], [ROOT], now, "api.example.com", SERVER)
  check(os, "wildcard two labels", LEAF, [INTER], [ROOT], now, "a.b.api.example.com", SERVER)
  check(os, "ipv4", LEAF, [INTER], [ROOT], now, "192.0.2.1", SERVER)
  check(os, "ipv6", LEAF, [INTER], [ROOT], now, "2001:db8::1", SERVER)
  check(os, "other ip", LEAF, [INTER], [ROOT], now, "192.0.2.2", SERVER)
  check(os, "other host", LEAF, [INTER], [ROOT], now, "other.com", SERVER)
  check(os, "case", LEAF, [INTER], [ROOT], now, "WWW.Example.COM", SERVER)
  check(os, "trailing dot", LEAF, [INTER], [ROOT], now, "www.example.com.", SERVER)
  check(os, "leaf expired", LEAF, [INTER], [ROOT], late, "", SERVER)
  check(os, "leaf not yet", LEAF, [INTER], [ROOT], T0 - 100, "", SERVER)
  check(os, "no intermediate", LEAF, [], [ROOT], now, "", SERVER)
  check(os, "no root", LEAF, [INTER], [], now, "", SERVER)
  check(os, "fake root", LEAF, [INTER], [FAKE_ROOT], now, "", SERVER)
  check(os, "fake and real root", LEAF, [INTER], [FAKE_ROOT, ROOT], now, "", SERVER)
  check(os, "other root", LEAF, [INTER], [ROOT_OTHER], now, "", SERVER)
  check(os, "client", LEAF, [INTER], [ROOT], now, "", CLIENT)
  check(os, "any", LEAF, [INTER], [ROOT], now, "", ANY)
  check(os, "direct", DIRECT, [], [ROOT], now, "direct.example", SERVER)
  check(os, "direct client", DIRECT, [], [ROOT], now, "", CLIENT)
  check(os, "excess intermediates", DIRECT, [INTER, INTER2], [ROOT], now, "", SERVER)
  check(os, "not permitted", EVIL, [INTER], [ROOT], now, "", SERVER)
  check(os, "excluded", BAD, [INTER], [ROOT], now, "", SERVER)
  check(os, "wildcard over excluded", STAR_BAD, [INTER], [ROOT], now, "", SERVER)
  check(os, "permitted exact", BARE, [INTER], [ROOT], now, "example.com", SERVER)
  check(os, "path length", DEEP, [INTER, INTER2], [ROOT], now, "", SERVER)
  check(os, "missing link", DEEP, [INTER2], [ROOT], now, "", SERVER)
  check(os, "intermediate expired", LEAF_OLD, [INTER_OLD], [ROOT], now, "", SERVER)
  check(os, "nested usage", LEAF_SERVER, [INTER_CLIENT], [ROOT], now, "", SERVER)
  check(os, "nested usage client", LEAF_SERVER, [INTER_CLIENT], [ROOT], now, "", CLIENT)
  check(os, "nested usage any", LEAF_SERVER, [INTER_CLIENT], [ROOT], now, "", ANY)
  check(os, "parent not a ca", LEAF_NOTCA, [NOT_CA], [ROOT], now, "", SERVER)
  check(os, "parent without cert sign", LEAF_NOKEY, [NO_CERTSIGN], [ROOT], now, "", SERVER)
  check(os, "unhandled critical", CRIT, [], [ROOT], now, "", SERVER)
  check(os, "rsa leaf in roots", RSA_SELF, [], [RSA_SELF], now, "rsa.example", SERVER)
  check(os, "rsa self signed", RSA_SELF, [], [], now, "", SERVER)
  check(os, "rsa root", RSA_LEAF, [], [RSA_ROOT], now, "r.example", SERVER)
  check(os, "many candidates", LEAF, [INTER_OLD, INTER_CLIENT, INTER2, INTER], [ROOT_OTHER, FAKE_ROOT, ROOT], now, "", SERVER)
  check(os, "intermediate as leaf", INTER, [], [ROOT], now, "", SERVER)
  check(os, "root as leaf", ROOT, [], [ROOT], now, "", SERVER)
}
