// std/tls's verification and certificate hooks (decision 0644 T6):
// ClientConfig (client_config, dial_config) with Go's
// VerifyPeerCertificate, VerifyConnection, GetClientCertificate and
// Certificates, ServerConfig's VerifyPeerCertificate and
// VerifyConnection, and CertificateRequestInfo.SupportsCertificate, on
// TLS 1.3 and 1.2 (handshake_client_test.go TestVerifyPeerCertificate,
// TestVerifyConnection; common_test.go TestClientHelloInfo's
// SupportsCertificate cases). Both ends print what they saw.
use std/tls
use std/x509
use std/crypto
use std/base64
use std/netip

struct Issued {
  cert: x509.Certificate
  key: crypto.PrivateKey
}

/// A PEM block of der on one line (PEM readers ignore line lengths).
fn pem_block(kind: Str, der: Bytes) -> Bytes {
  "-----BEGIN ${kind}-----\n${base64.encode(der)}\n-----END ${kind}-----\n".bytes()
}

fn issue(os: Os, name: Str, parent: Issued?, ca: Bool, eku: List[x509.ExtKeyUsage], now: Time) -> Issued uses rand {
  let key = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256).or_fault("key")
  let usage = if ca { [x509.KeyUsage.CertSign, x509.KeyUsage.DigitalSignature] } else { [x509.KeyUsage.DigitalSignature] }
  let ips = if ca { [] } else { [netip.parse_addr("127.0.0.1").or_fault("ip")] }
  let t = x509.Template{subject: x509.Name{common_name: name}, not_before: now - 1h, not_after: now + 24h, ip_addresses: ips, is_ca: ca, key_usage: usage, ext_key_usage: eku}
  let (pc, pk) = match parent {
    Some(p) => (Some(p.cert), p.key)
    None => (None, key)
  }
  Issued{cert: x509.create_certificate(os.rand, t, key.public_key(), pc, pk).or_fault("cert ${name}"), key: key}
}

fn tls_pair(i: Issued, chain: List[x509.Certificate]) -> tls.TlsCert {
  var pem = i.cert.pem()
  for c in chain {
    pem = pem + c.pem()
  }
  tls.cert(pem, pem_block("PRIVATE KEY", crypto.marshal_private_key(i.key))).or_fault("pair")
}


fn cn(l: List[x509.Certificate]) -> Str { if l.is_empty() { "none" } else { l[0].subject.common_name } }

fn serve_one(l: tls.TlsListener) -> Str uses net {
  let c = match l.accept() {
    Ok(c) => c
    Err(e) => return "accept: ${e}"
  }
  let r = match c.handshake() {
    Ok(_) => {
      let s = c.state()
      // the client's read below sees this line or the server's alert
      c.write("hi".bytes()).ignore_err("the client may have gone")
      "server ok, client cert ${cn(s.peer_certificates)}"
    }
    Err(e) => "server: ${e}"
  }
  c.close()
  r
}

struct Case {
  label: Str
  server: tls.ServerConfig
  client: tls.ClientConfig
}

fn main(os: Os) uses net, stdio, rand, clock {
  let now = os.clock.now()
  let ca = issue(os, "Xo Test CA", None, true, [], now)
  let ca2 = issue(os, "Other CA", None, true, [], now)
  let server = issue(os, "server", Some(ca), false, [x509.ExtKeyUsage.ServerAuth], now)
  let alice = issue(os, "alice", Some(ca), false, [x509.ExtKeyUsage.ClientAuth], now)
  let bob = issue(os, "bob", Some(ca2), false, [x509.ExtKeyUsage.ClientAuth], now)
  let roots = tls.roots_of([ca.cert]).or_fault("roots")
  let both = tls.roots_of([ca.cert, ca2.cert]).or_fault("roots")
  let only2 = tls.roots_of([ca2.cert]).or_fault("roots")
  let scert = tls_pair(server, [])
  let acert = tls_pair(alice, [])
  let bcert = tls_pair(bob, [])
  let base = tls.ServerConfig{certificates: [scert], next_protos: ["h2", "http/1.1"]}
  let cbase = tls.ClientConfig{server_name: "127.0.0.1", roots: Some(roots), next_protos: ["http/1.1"]}
  // what the hooks saw, printed after each case
  let seen = Mutex[List[Str]].new([])
  for v in [tls.VERSION_TLS13, tls.VERSION_TLS12] {
    let vc = cbase with {max_version: v}
    let cases = [
      Case{label: "client verify_peer_certificate sees", server: base, client: vc with {verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
        let names = chains.map(fn(ch: List[x509.Certificate]) -> Str { ch.map(fn(x: x509.Certificate) -> Str { x.subject.common_name }).join(">") })
        seen.with(fn(var l) { l.push("vpc raw ${raw.len()} chains ${names}") })
        Ok(())
      })}},
      Case{label: "client verify_peer_certificate fails", server: base, client: vc with {verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str { Err("pin mismatch") })}},
      Case{label: "client verify_peer_certificate empty Err", server: base, client: vc with {verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str { Err("") })}},
      Case{label: "Verify.None with verify_peer_certificate", server: base, client: vc with {roots: None, verify: tls.Verify.None, verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
        seen.with(fn(var l) { l.push("vpc raw ${raw.len()} chains ${chains.len()}") })
        Ok(())
      })}},
      Case{label: "ChainOnly with verify_peer_certificate", server: base, client: vc with {server_name: "wrong.example", verify: tls.Verify.ChainOnly, verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
        seen.with(fn(var l) { l.push("vpc raw ${raw.len()} chains ${chains.len()}") })
        Ok(())
      })}},
      Case{label: "client verify_connection sees", server: base, client: vc with {verify_connection: Some(fn(s: tls.ConnState) -> () ! Str {
        seen.with(fn(var l) { l.push("vc ${tls.version_name(s.version)} complete ${s.handshake_complete} alpn ${s.negotiated_protocol} name ${s.server_name} peer ${cn(s.peer_certificates)} chains ${s.verified_chains.len()} resumed ${s.did_resume}") })
        Ok(())
      })}},
      Case{label: "client verify_connection fails", server: base, client: vc with {verify_connection: Some(fn(s: tls.ConnState) -> () ! Str { Err("refused by verify_connection") })}},
      Case{label: "both client hooks fail", server: base, client: vc with {verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str { Err("first") }), verify_connection: Some(fn(s: tls.ConnState) -> () ! Str { Err("second") })}},
      Case{label: "get_client_certificate gives alice", server: base with {client_auth: tls.ClientAuth.RequireAndVerify, client_cas: Some(both)}, client: vc with {get_client_certificate: Some(fn(i: tls.CertificateRequestInfo) -> tls.TlsCert? ! Str {
        seen.with(fn(var l) { l.push("cri version ${tls.version_name(i.version)} cas ${i.acceptable_cas.len()} schemes ${i.signature_schemes.len() > 0} alice ${i.supports_certificate(acert).is_ok()} bob ${i.supports_certificate(bcert).is_ok()}") })
        Ok(Some(acert))
      })}},
      Case{label: "get_client_certificate gives none", server: base with {client_auth: tls.ClientAuth.RequireAny}, client: vc with {get_client_certificate: Some(fn(i: tls.CertificateRequestInfo) -> tls.TlsCert? ! Str { Ok(None) })}},
      Case{label: "get_client_certificate fails", server: base with {client_auth: tls.ClientAuth.Request}, client: vc with {get_client_certificate: Some(fn(i: tls.CertificateRequestInfo) -> tls.TlsCert? ! Str { Err("no certificate for you") })}},
      Case{label: "certificates picks the one the CAs name", server: base with {client_auth: tls.ClientAuth.RequireAndVerify, client_cas: Some(only2)}, client: vc with {certificates: [acert, bcert]}},
      Case{label: "certificates none named", server: base with {client_auth: tls.ClientAuth.Request, client_cas: Some(only2)}, client: vc with {certificates: [acert, acert]}},
      Case{label: "server verify_peer_certificate sees none", server: base with {client_auth: tls.ClientAuth.Request, verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
        seen.with(fn(var l) { l.push("server vpc raw ${raw.len()} chains ${chains.len()}") })
        Ok(())
      })}, client: vc},
      Case{label: "server verify_peer_certificate sees alice", server: base with {client_auth: tls.ClientAuth.VerifyIfGiven, client_cas: Some(roots), verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
        seen.with(fn(var l) { l.push("server vpc raw ${raw.len()} chains ${chains.len()}") })
        Ok(())
      })}, client: vc with {certificates: [acert]}},
      Case{label: "server verify_peer_certificate fails", server: base with {client_auth: tls.ClientAuth.Request, verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str { Err("client not allowed") })}, client: vc with {certificates: [acert]}},
      Case{label: "server verify_peer_certificate not asked", server: base with {verify_peer_certificate: Some(fn(raw: List[Bytes], chains: List[List[x509.Certificate]]) -> () ! Str {
        seen.with(fn(var l) { l.push("server vpc called") })
        Ok(())
      })}, client: vc},
      Case{label: "server verify_connection sees", server: base with {verify_connection: Some(fn(s: tls.ConnState) -> () ! Str {
        seen.with(fn(var l) { l.push("server vc ${tls.version_name(s.version)} complete ${s.handshake_complete} alpn ${s.negotiated_protocol} name ${s.server_name} peer ${cn(s.peer_certificates)}") })
        Ok(())
      })}, client: vc},
      Case{label: "server verify_connection fails", server: base with {verify_connection: Some(fn(s: tls.ConnState) -> () ! Str { Err("server says no") })}, client: vc},
    ]
    os.stdio.println("== ${tls.version_name(v)}")
    for k in cases {
      seen.reset([])
      let tl = tls.listen(os.net, "127.0.0.1:0", k.server).or_fault("listen")
      scope s {
        let t = s.spawn(fn() -> Str { serve_one(tl) })
        let client = match tls.dial_config(os.net, tl.addr(), k.client, timeout: Some(5s)) {
          Ok(c) => {
            let r = match c.read(16) {
              Ok(Some(b)) => "client ok, read ${b.to_str() ?? "?"}"
              Ok(None) => "client ok, read EOF"
              Err(e) => "client ok, read: ${e}"
            }
            c.close()
            r
          }
          Err(e) => "client: ${e}"
        }
        let srv = t.await
        os.stdio.println("${k.label}: ${client}; ${srv}")
        for x in seen.with(fn(l) { l }) {
          os.stdio.println("  ${x}")
        }
      }
      tl.close()
    }
  }
  // client_config on a dialed connection, without a server name
  let tl = tls.listen(os.net, "127.0.0.1:0", base).or_fault("listen")
  scope s {
    let t = s.spawn(fn() -> Str { serve_one(tl) })
    let rc = os.net.dial(tl.addr()).or_fault("dial")
    let r = match tls.client_config(rc, cbase with {server_name: ""}) {
      Ok(c) => {
        c.close()
        "ok"
      }
      Err(e) => {
        // the server's handshake ends at the close
        rc.close()
        "${e}"
      }
    }
    let _ = t.await
    os.stdio.println("client_config without server_name: ${r}")
  }
  tl.close()
  os.stdio.println("done")
}
