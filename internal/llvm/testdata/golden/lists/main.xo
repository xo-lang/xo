struct Item {
  id: Int
  tags: List[Str]
}

fn total(xs: List[Int]) -> Int {
  var s = 0
  for x in xs {
    s += x
  }
  s
}

fn with_extra(xs: List[Int]) -> List[Int] {
  var ys = xs
  ys.push(100)
  ys
}

fn main(os: Os) {
  var xs: List[Int] = []
  for i in 0..10 {
    xs.push(i * i)
  }
  os.stdio.println("len ${xs.len()} sum ${total(xs)} xs[3] ${xs[3]}")
  let snapshot = xs
  xs[3] = -1
  xs.push(7)
  os.stdio.println("after ${xs[3]} ${xs.len()} snapshot ${snapshot[3]} ${snapshot.len()}")
  let ys = with_extra(xs)
  os.stdio.println("ys ${ys.len()} ${ys[ys.len() - 1]} xs ${xs.len()}")
  var grid: List[List[Int]] = []
  for r in 0..3 {
    var row: List[Int] = []
    for c in 0..3 {
      row.push(r * 3 + c)
    }
    grid.push(row)
  }
  let g2 = grid
  grid[1][1] = 42
  os.stdio.println("grid ${grid[1][1]} copy ${g2[1][1]} ${grid[2][0]}")
  var items = [Item{id: 1, tags: ["a"]}, Item{id: 2, tags: []}]
  let before = items
  items[0].tags.push("b")
  items[1].id = 20
  os.stdio.println("items ${items[0].tags.len()} ${before[0].tags.len()} ${items[1].id} ${before[1].id}")
  let base = items[0]
  var it = base
  it.tags.push("c")
  os.stdio.println("copied ${it.tags.len()} ${items[0].tags.len()}")
  var sum = 0
  for (i, x) in xs.indexed() {
    sum += i * x
  }
  os.stdio.println("indexed ${sum}")
  var grow = [1, 2, 3]
  for x in grow {
    grow.push(x * 10)
  }
  os.stdio.println("grow ${grow.len()} ${grow[5]}")
  xs.set(0, 5)
  os.stdio.println("set ${xs[0]} eq ${[1, 2] == [1, 2]} ${[1, 2] == [1, 3]} empty ${xs.is_empty()}")
}
