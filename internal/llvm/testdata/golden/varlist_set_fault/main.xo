// A `var List` element store inlined with its landing pad (task #418)
// faults with the caller's list and the stored string still owned once:
// the fault names the store, the list is intact.
fn put_from(var d: List[Str], i: Int, j: Int) {
  let t = d[j] + "!"
  d[i] = t
}

fn main(os: Os) {
  var s = ["a", "b", "c"]
  var k = 0
  while k < 4 {
    put_from(s, k % 3, (k + 1) % 3)
    k += 1
  }
  os.stdio.println("${s}")
  put_from(s, 7, 0)
  os.stdio.println("${s}")
}
