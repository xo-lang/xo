enum Tree {
  Leaf(v: Int)
  Node(left: Int, right: Int)
}

struct Point {
  x: Int
  y: Int
}

fn shape(xs: List[Int]) -> Str {
  match xs {
    [] => "empty"
    [x] => "one ${x}"
    [a, b] => "two ${a}+${b}"
    [first, .., last] => "many ${first}..${last}"
  }
}

fn describe(r: Result[Int?, Str]) -> Str {
  match r {
    Ok(Some(n)) if n > 100 => "big ${n}"
    Ok(Some(n)) => "some ${n}"
    Ok(None) => "none"
    Err(msg) => "err ${msg}"
  }
}

fn kind(c: Rune) -> Str {
  match c {
    'a'..='z' => "lower"
    'A'..='Z' => "upper"
    '0'..='9' => "digit"
    _ => "other"
  }
}

fn main(os: Os) {
  os.stdio.println("${shape([])} | ${shape([7])} | ${shape([1, 2])} | ${shape([1, 2, 3, 4])}")
  os.stdio.println("${describe(Ok(Some(500)))} | ${describe(Ok(Some(5)))} | ${describe(Ok(None))} | ${describe(Err("x"))}")
  os.stdio.println("${kind('q')} ${kind('Q')} ${kind('7')} ${kind('!')}")
  let p = Point{x: 3, y: 4}
  match p {
    Point{x: 0, ..} => os.stdio.println("on axis")
    Point{x: x, y: y} => os.stdio.println("point ${x},${y}")
  }
  let pair = (Tree.Leaf(1), Tree.Node(left: 2, right: 3))
  match pair {
    (Leaf(a), Node(left: l, ..)) => os.stdio.println("leaf ${a} node ${l}")
    _ => os.stdio.println("other")
  }
  for t in [Tree.Leaf(5), Tree.Node(left: 1, right: 9)] {
    match t {
      Leaf(v) | Node(left: v, ..) => os.stdio.print("v=${v} ")
    }
  }
  os.stdio.println("")
  let r: Result[Int, Str] = Err("boom")
  os.stdio.println("is ${r is Err(_)} ${r is Ok(_)} ${Some(3) is Some(3)} ${(1, 2) is (1, _)}")
  let opt: Str? = Some("hi")
  if let Some(s) = opt {
    os.stdio.println("if let ${s}")
  }
  if let s = opt {
    os.stdio.println("shorthand ${s}")
  }
  let (a, (b, c)) = (1, (2, 3))
  os.stdio.println("nested ${a + b + c}")
  let flag = true
  let text = match flag {
    true => "yes"
    false => "no"
  }
  os.stdio.println(text)
  let code = 503
  let msg = match code {
    200..=299 => "ok"
    429 | 503 => "retry later"
    _ => "error"
  }
  os.stdio.println(msg)
  let s = "GET"
  match s {
    "GET" => os.stdio.println("get")
    _ => os.stdio.println("other")
  }
}
