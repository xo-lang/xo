// derive Cbor on an enum (decision 0527): a unit variant is the text of its name, a variant with fields a one entry
// map from its name to a map of its fields (a lone unnamed field is the value itself); marshal then unmarshal round
// trips, an unknown variant is a CborErr.Type, and an enum field of a struct follows the same form.
use std/cbor

enum Shape {
  Empty
  Circle(radius: Float)
  Rect(w: Int, h: Int)
  Label(from Str)
} derive Cbor

struct Scene {
  name: Str
  main: Shape
  extras: List[Shape]
} derive Cbor

fn show(s: Shape) -> Str {
  match s {
    Empty => "empty"
    Circle(r) => "circle ${r}"
    Rect(w, h) => "rect ${w}x${h}"
    Label(t) => "label ${t}"
  }
}

fn main(os: Os) {
  for s in [Shape.Empty, Shape.Circle(radius: 1.5), Shape.Rect(w: 3, h: 4), Shape.Label("hi")] {
    let data = cbor.marshal(s).ok() ?? fault("marshal")
    let back = cbor.unmarshal[Shape](data).ok() ?? fault("unmarshal")
    os.stdio.println("${show(back)} ${data.len()}")
  }
  let scene = Scene{name: "s", main: Shape.Rect(w: 1, h: 2), extras: [Shape.Empty, Shape.Label("x")]}
  let sd = cbor.marshal(scene).ok() ?? fault("marshal scene")
  let sb = cbor.unmarshal[Scene](sd).ok() ?? fault("unmarshal scene")
  os.stdio.println("${sb.name} ${show(sb.main)} ${sb.extras.len()} ${show(sb.extras[1])}")
  // hand written: {"Rect": {"w": 5, "h": 6}} then an unknown variant
  let rect = cbor.encode(cbor.Value.Map(pairs: [(cbor.Value.TextString(s: "Rect"), cbor.Value.Map(pairs: [(cbor.Value.TextString(s: "h"), cbor.Value.Uint(n: UInt64(6))), (cbor.Value.TextString(s: "w"), cbor.Value.Uint(n: UInt64(5)))]))]), true).ok() ?? fault("encode")
  os.stdio.println(show(cbor.unmarshal[Shape](rect).ok() ?? fault("rect")))
  let bad = cbor.encode(cbor.Value.TextString(s: "Triangle"), true).ok() ?? fault("encode bad")
  match cbor.unmarshal[Shape](bad) {
    Ok(_) => os.stdio.println("bad variant accepted")
    Err(e) => os.stdio.println("bad variant: ${e}")
  }
}
