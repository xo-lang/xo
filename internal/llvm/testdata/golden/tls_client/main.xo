// std/tls (std.md 27, decision 0281): a TLS client on a connection the
// program dialed, against std/http servers with test certificates (those
// of golden http_tls): the three verification levels, roots, ALPN, the
// connection taken over, and the texts of each failure.
use std/http
use std/tls

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello over tls") })
  r
}

fn norm(s: Str, addrs: List[Str]) -> Str {
  var t = s
  for i in 0..addrs.len() {
    t = t.replace(addrs[i], "ADDR${i}")
  }
  // the time now varies: "current time <now> is after <limit>"
  let parts = t.split("current time ")
  if parts.len() == 2 {
    let rest = parts[1].split(" is ")
    if rest.len() == 2 {
      t = parts[0] + "current time NOW is " + rest[1]
    }
  }
  t
}

fn neterr(e: NetErr) -> Str {
  match e {
    NetErr.InvalidAddr(msg) => "InvalidAddr(${msg})"
    NetErr.Refused => "Refused"
    NetErr.Timeout => "Timeout"
    NetErr.Io(msg) => "Io(${msg})"
    NetErr.Canceled => "Canceled"
    NetErr.Denied(addr) => "Denied(${addr})"
  }
}

/// A GET /hello over t: the status line and the body's last line.
fn get(t: tls.TlsConn) -> Str ! NetErr uses net {
  t.write("GET /hello HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n".bytes())?
  var all = b""
  while {
    match t.read(4096)? {
      Some(b) => all = all + b
      None => break
    }
  }
  let lines = (all.to_str() ?? "").split("\r\n")
  "${lines[0]} / ${lines[lines.len() - 1]}"
}

fn attempt(os: Os, label: Str, addrs: List[Str], addr: Str, host: Str, roots: tls.Roots?, verify: tls.Verify, alpn: List[Str] = []) {
  let c = os.net.dial(addr).or_fault("dial")
  match tls.client(c, host, roots: roots, verify: verify, alpn: alpn) {
    Ok(t) => {
      match get(t) {
        Ok(s) => os.stdio.println("${label}: ${t.version()} alpn=\"${t.alpn()}\" ${s}")
        Err(e) => os.stdio.println("${label}: request: ${norm(neterr(e), addrs)}")
      }
      t.close()
    }
    Err(e) => os.stdio.println("${label}: ${norm(neterr(e), addrs)}")
  }
}

fn main(os: Os) {
  match tls.roots(b"not pem") {
    Ok(_) => os.stdio.println("roots: ok?")
    Err(e) => os.stdio.println("roots: ${e.msg}")
  }
  let ca = tls.roots(ca_pem()).or_fault("roots")
  let good = http.tls_cert(good_cert(), good_key()).or_fault("good")
  let expired = http.tls_cert(expired_cert(), expired_key()).or_fault("expired")
  let unknown = http.tls_cert(unknown_cert(), unknown_key()).or_fault("unknown")
  let wrongip = http.tls_cert(wrongip_cert(), wrongip_key()).or_fault("wrongip")
  let l1 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l2 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l3 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l4 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l5 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let servers = [
    http.server(l1, routes()).with_tls([good]),
    http.server(l2, routes()).with_tls([expired]),
    http.server(l3, routes()).with_tls([unknown]),
    http.server(l4, routes()).with_tls([wrongip]),
    http.server(l5, routes()),
  ]
  let addrs = [l1.addr(), l2.addr(), l3.addr(), l4.addr(), l5.addr()]
  scope s {
    for srv in servers {
      s.spawn_background(fn() {
        match srv.serve() {
          Ok(_) => ()
          Err(e) => os.stdio.println("serve failed: ${e}")
        }
      })
    }
    attempt(os, "full", addrs, l1.addr(), "127.0.0.1", Some(ca), tls.Verify.Full)
    attempt(os, "alpn", addrs, l1.addr(), "127.0.0.1", Some(ca), tls.Verify.Full, alpn: ["http/1.1"])
    attempt(os, "full wrong ip", addrs, l4.addr(), "127.0.0.1", Some(ca), tls.Verify.Full)
    attempt(os, "chain only wrong ip", addrs, l4.addr(), "127.0.0.1", Some(ca), tls.Verify.ChainOnly)
    attempt(os, "full other name", addrs, l1.addr(), "db.example", Some(ca), tls.Verify.Full)
    attempt(os, "chain only other name", addrs, l1.addr(), "db.example", Some(ca), tls.Verify.ChainOnly)
    attempt(os, "full unknown ca", addrs, l3.addr(), "127.0.0.1", Some(ca), tls.Verify.Full)
    attempt(os, "chain only unknown ca", addrs, l3.addr(), "127.0.0.1", Some(ca), tls.Verify.ChainOnly)
    attempt(os, "none unknown ca", addrs, l3.addr(), "127.0.0.1", Some(ca), tls.Verify.None)
    attempt(os, "none system roots", addrs, l3.addr(), "127.0.0.1", None, tls.Verify.None)
    attempt(os, "chain only expired", addrs, l2.addr(), "127.0.0.1", Some(ca), tls.Verify.ChainOnly)
    attempt(os, "none expired", addrs, l2.addr(), "127.0.0.1", Some(ca), tls.Verify.None)
    attempt(os, "not tls", addrs, l5.addr(), "127.0.0.1", Some(ca), tls.Verify.Full)
    // the connection belongs to the TlsConn
    let c = os.net.dial(l1.addr()).or_fault("dial")
    let t = tls.client(c, "127.0.0.1", roots: Some(ca)).or_fault("client")
    match c.write(b"x") {
      Ok(_) => os.stdio.println("write after upgrade: ok?")
      Err(e) => os.stdio.println("write after upgrade: ${neterr(e)}")
    }
    match c.read(1) {
      Ok(_) => os.stdio.println("read after upgrade: ok?")
      Err(e) => os.stdio.println("read after upgrade: ${neterr(e)}")
    }
    match tls.client(c, "127.0.0.1", roots: Some(ca)) {
      Ok(_) => os.stdio.println("second upgrade: ok?")
      Err(e) => os.stdio.println("second upgrade: ${neterr(e)}")
    }
    match get(t) {
      Ok(r) => os.stdio.println("still works: ${r}")
      Err(e) => os.stdio.println("still works: ${neterr(e)}")
    }
    t.close()
    match t.read(10) {
      Ok(_) => os.stdio.println("read after close: ok?")
      Err(e) => os.stdio.println("read after close: ${neterr(e)}")
    }
  }
  os.stdio.println("done")
}

