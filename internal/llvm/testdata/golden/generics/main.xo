struct Pair[A, B] {
  first: A
  second: B
}

enum Tree[T] {
  Leaf(v: T)
  Node(l: Tree[T], r: Tree[T])
}

fn largest[T: Ord](xs: List[T], init: T) -> T {
  var best = init
  for x in xs {
    if x > best {
      best = x
    }
  }
  best
}

fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] { Pair{first: p.second, second: p.first} }

fn count[T](t: Tree[T]) -> Int {
  match t {
    Leaf(_) => 1
    Node(l, r) => count(l) + count(r)
  }
}

fn sum_tree(t: Tree[Int]) -> Int {
  match t {
    Leaf(v) => v
    Node(l, r) => sum_tree(l) + sum_tree(r)
  }
}

fn first_or[T](xs: List[T], d: T) -> T { xs.get(0) ?? d }

fn main(os: Os) {
  os.stdio.println("largest ${largest([3, 9, 2], 0)} ${largest([1.5, -2.0], -10.0)} ${largest(["b", "z", "a"], "")}")
  let p = swap(Pair{first: 1, second: "one"})
  os.stdio.println("swap ${p.first} ${p.second}")
  let t = Tree.Node(l: Tree.Leaf(v: 1), r: Tree.Node(l: Tree.Leaf(v: 2), r: Tree.Leaf(v: 3)))
  os.stdio.println("tree ${count(t)} ${sum_tree(t)}")
  let empty: List[Str] = []
  os.stdio.println("first_or ${first_or([5], 0)} ${first_or(empty, "none")}")
}
