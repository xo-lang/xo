// Push runs across a value that may fault (pushrun.xo: a checked `p + 1`
// between pushes, whose landing branch splits the block): the run's last
// push stores all its values, and a fault between them unwinds through
// the pad that releases the list (inside task.isolate, which catches it
// and checks for leaks).
use std/task

fn show(stdio: Stdio, label: Str, r: Result[Str, task.Isolated[Int]]) uses stdio {
  match r {
    Ok(v) => stdio.println("${label}: ok ${v}")
    Err(task.Isolated.Faulted(info)) => stdio.println("${label}: ${info.msg}")
    Err(task.Isolated.Failed(e)) => stdio.println("${label}: failed ${e}")
  }
}

fn triples(xs: List[Int]) -> List[Int] {
  var tape = List[Int].with_capacity(2)
  var s: Str = "held"
  for x in xs {
    tape.push(4)
    tape.push(x + 1)
    tape.push(x * 2)
    s = s + "."
  }
  tape.push(s.len())
  tape
}

fn sum(t: List[Int]) -> Int {
  var h = 0
  for v in t {
    h = (h * 31 + v) % 1000000007
  }
  h
}

fn main(os: Os) {
  let io = os.stdio
  var xs: List[Int] = []
  for i in 0..1000 {
    xs.push(i * 7919 - 3000000)
  }
  let t = triples(xs)
  io.println("${t.len()} ${sum(t)} ${t[0]} ${t[1]} ${t[2]} ${t[t.len() - 1]}")
  let big = 9223372036854775807
  show(io, "overflow first", task.isolate(fn() -> Str ! Int { "${triples([big, 1]).len()}" }))
  show(io, "overflow later", task.isolate(fn() -> Str ! Int { "${triples([1, 2, 3, big]).len()}" }))
  show(io, "second op", task.isolate(fn() -> Str ! Int { "${triples([5000000000000000000]).len()}" }))
}
