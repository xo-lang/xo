  ]
}

fn main(os: Os) uses stdio, rand {
  for (alg, d, der) in cases() {
    match crypto.ecdsa_private_key(alg, d) {
      Ok(k) => {
        let sig = crypto.sign_raw_ecdsa(os.rand, k, crypto.Hash.Sha256, b"msg").ok() ?? b""
        os.stdio.println("${if alg == crypto.KeyAlg.EcdsaP256 { "p256" } else { "p521" }} public ${crypto.marshal_public_key(k.public_key()) == der} verify ${crypto.verify_raw_ecdsa(k.public_key(), crypto.Hash.Sha256, b"msg", sig)}")
      }
      Err(e) => os.stdio.println("err ${e.display()}")
    }
  }
  let zero = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  for d in [zero, zero[1..], b"", zero + b"\x01"] {
    match crypto.ecdsa_private_key(crypto.KeyAlg.EcdsaP256, d) {
      Ok(_) => os.stdio.println("accepted")
      Err(e) => os.stdio.println("err ${e.display()}")
    }
  }
  match crypto.ecdsa_private_key(crypto.KeyAlg.Ed25519, zero) {
    Ok(_) => os.stdio.println("accepted")
    Err(e) => os.stdio.println("err ${e.display()}")
  }
}
