// The address intrinsics of decision 0233 through std/internal's test
// hook (std/native/internal.xo rt_op): cabi.xo's fmt_int called through
// rt.fn_addr's address (05 31: the length of "12345" and its "1"), and
// rt.frame_addr (01 01 01: not 0, a callee's frame below it, within
// 64 KiB); and rt.sym_addr (decision 0234): xo_entry's address not 0,
// and strlen of seven bytes through the C library's address (01 07);
// and on Linux the auxiliary vector read from memory after the start's
// environment, its AT_PHDR /proc/self/auxv's, AT_PAGESZ set (01 01 01;
// gotchas/linux-auxv-proc.md).
use std/internal

fn main(os: Os) {
  os.stdio.println(internal.crypto_op("rt.fn_addr", b"", b"", b"", b"").to_hex())
  os.stdio.println(internal.crypto_op("rt.frame_addr", b"", b"", b"", b"").to_hex())
  os.stdio.println(internal.crypto_op("rt.sym_addr", b"", b"", b"", b"").to_hex())
  os.stdio.println(internal.crypto_op("rt.auxv", b"", b"", b"", b"").to_hex())
}
