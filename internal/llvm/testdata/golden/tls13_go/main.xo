// The TLS 1.3 client of the native backends' TLS (std/native/llrt/tls13.xo,
// the zero-C audit's B31) replaying traces of Go's crypto/tls server
// (recorded once by a Go program driving the Go reference
// client of std/rt's internal_tls13.go, the server accepting its
// Finished and reading its close_notify) through internal.crypto_op,
// against that Go client: a HelloRetryRequest from X25519 to P-256 with
// ChaCha20-Poly1305 and ALPN, a CertificateRequest answered by an empty
// Certificate with AES-256-GCM and SHA-384, a P-384 ECDSA server and a
// KeyUpdate asking for the client's, an Ed25519 server over a P-256
// share; fed whole and a byte at a time; then the certificate expired
// and no root.
use std/internal

const ROOT: Str = ""
const HRR_CHACHA_START: Str = "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f204142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f60"
const HRR_CHACHA_KEY: Str = "1112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30"
const HRR_CHACHA_SERVER_HS: Str = ""
const HRR_CHACHA_SERVER_POST: Str = "17030300236be2619d3397a8d0276d2a6429a898593268f6368f2e865848e370ece94a0c03dc00ba"
const HRR_CHACHA_CH: Str = ""
const HRR_CHACHA_FLIGHT: Str = ""
const HRR_CHACHA_APP: Str = "170303001cd5cdc8ea6667c8c65c858be821f8be6b78edccc6218cc7496e5eef8a"
const HRR_CHACHA_REPLY: Str = ""
const HRR_CHACHA_BYE: Str = "1703030013d695d8d62e2c2a221b2f67b1cec6950c16b0d2"
const CERTREQ_AES256_START: Str = "02030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f6061"
const CERTREQ_AES256_KEY: Str = "12131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
const CERTREQ_AES256_SERVER_HS: Str = ""
const CERTREQ_AES256_SERVER_POST: Str = "1703030023343eeef69f245aa5bb9bd4afa55764da5ed2ef1457d02ce904c9778854addd99f7d79d170303001653ce31aec856802da18b2eb97af748f6e2c6e74122f41703030028556f1f9e6f5a34736a2f8065e59332f66554203fbbc3375f44380ed45def038458dd5e09080b8768"
const CERTREQ_AES256_CH: Str = ""
const CERTREQ_AES256_FLIGHT: Str = "140303000101170303004dbe8785d90d730b4f90e0cf681f5854f211d74229874556d642ac04478996585b382f7e2835710b5498d9ac2ab1393800d24becdcb7aabe1b7050301d83b012fe489b95e0d5f9b611992642e782"
const CERTREQ_AES256_APP: Str = "170303001ca9101040e78f1caf832e994c656ceeb1fa1744ebd1d31ff150fb996f"
const CERTREQ_AES256_REPLY: Str = "1703030016ffadea0ac24a6809ffb22768b701adf5bd7be9b15215"
const CERTREQ_AES256_BYE: Str = "170303001347f4f712494993f2e70636f957caf4d5b51bc9"
const ED25519_P256_START: Str = "030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162"
const ED25519_P256_KEY: Str = "131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132"
const ED25519_P256_SERVER_HS: Str = ""
const ED25519_P256_SERVER_POST: Str = "1703030023396d5dc87b809bcc1d3cae07201beb40fdd34ab3300d58e6845ab2bd89feec466601cb"
const ED25519_P256_CH: Str = ""
const ED25519_P256_FLIGHT: Str = "1403030001011703030035639cd07021cd63a49e5c449c4a7ce4ea012598d603e63d8dd68354c948d0b54634b8fbc101eeb6babffc8d48f56dc18739df825024"
const ED25519_P256_APP: Str = "170303001cc4467c3a252580d054b074e3252332820d739d94d62c39255151e82d"
const ED25519_P256_REPLY: Str = ""
const ED25519_P256_BYE: Str = "1703030013f99876cafc3eb56163f82f87e326f75f00573b"

// 2026-05-28, inside the certificates' validity, and two years later
const NOW: Int = 1780000000
const LATE: Int = 1843072000

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

/// The parts as 3 byte lengths and bytes.
fn pack(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    out.write_byte(UInt8(b.len() / 65536))
    out.write_byte(UInt8(b.len() / 256 % 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

/// A recorded trace and what the client sent in it.
struct Trace {
  start: Str
  key: Str
  server_hs: Str
  server_post: Str
  ch: Str
  flight: Str
  app: Str
  reply: Str
  bye: Str
}

/// w named when it is what the client sent in the trace, or as text when
/// it is the data received.
fn name(t: Trace, w: Str, got: Bool) -> Str {
  if w == t.ch {
    "<ClientHello>"
  } else if w == t.flight {
    "<client flight>"
  } else if w == t.app {
    "<client data>"
  } else if w == t.reply && w != "" {
    "<client KeyUpdate>"
  } else if w == t.bye {
    "<client close_notify>"
  } else if got {
    "\"${hex(w).to_str() ?? ""}\""
  } else {
    w
  }
}

fn replay(os: Os, title: Str, t: Trace, root: Str, now: Int, suites: Str, groups: Str, alpn: Str, chunk: Int) uses stdio {
  let parts = pack([hex(t.server_hs), hex(t.server_post), "GET / trace".bytes(), hex(root)])
  let r = internal.crypto_op("tls13.replay", hex(t.start), parts, hex(t.key), "${now} tls.example ${suites} ${chunk} build ${groups} ${alpn}".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for (i, w) in line.split(" ").indexed() {
        ws.push(name(t, w, line.starts_with("got ") && i == 1))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

fn main(os: Os) uses stdio {
  let hrr = Trace{start: HRR_CHACHA_START, key: HRR_CHACHA_KEY, server_hs: HRR_CHACHA_SERVER_HS, server_post: HRR_CHACHA_SERVER_POST, ch: HRR_CHACHA_CH, flight: HRR_CHACHA_FLIGHT, app: HRR_CHACHA_APP, reply: HRR_CHACHA_REPLY, bye: HRR_CHACHA_BYE}
  let req = Trace{start: CERTREQ_AES256_START, key: CERTREQ_AES256_KEY, server_hs: CERTREQ_AES256_SERVER_HS, server_post: CERTREQ_AES256_SERVER_POST, ch: CERTREQ_AES256_CH, flight: CERTREQ_AES256_FLIGHT, app: CERTREQ_AES256_APP, reply: CERTREQ_AES256_REPLY, bye: CERTREQ_AES256_BYE}
  let ed = Trace{start: ED25519_P256_START, key: ED25519_P256_KEY, server_hs: ED25519_P256_SERVER_HS, server_post: ED25519_P256_SERVER_POST, ch: ED25519_P256_CH, flight: ED25519_P256_FLIGHT, app: ED25519_P256_APP, reply: ED25519_P256_REPLY, bye: ED25519_P256_BYE}
  replay(os, "hello retry, chacha20-poly1305, alpn", hrr, ROOT, NOW, "1303", "29,23", "h2,http/1.1", 0)
  replay(os, "hello retry, a byte at a time", hrr, ROOT, NOW, "1303", "29,23", "h2,http/1.1", 1)
  replay(os, "certificate request, aes-256-gcm, p-384, key update", req, ROOT, NOW, "1302", "29", "-", 0)
  replay(os, "key update, a byte at a time", req, ROOT, NOW, "1302", "29", "-", 1)
  replay(os, "ed25519 over p-256", ed, ROOT, NOW, "1301", "23", "-", 0)
  replay(os, "expired", ed, ROOT, LATE, "1301", "23", "-", 0)
  replay(os, "no root", ed, "", NOW, "1301", "23", "-", 0)
}
