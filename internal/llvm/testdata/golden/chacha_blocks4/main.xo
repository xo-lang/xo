// Decision 0329: ChaCha20's key stream four blocks (256 bytes) at a time
// in vector registers (cpu.chacha_blocks4: NEON on arm64, LLVM vectors,
// the portable body elsewhere). Every length class around 256 and long
// inputs, at two counters, as a SHA-256 of the output: TestGolden diffs
// the native output against the Go backend's, which is Go's ChaCha20
// (std/rt internal_crypto.go).
use std/internal

const HEX: Str = "0123456789abcdef"

fn hex(b: Bytes) -> Str {
  var out = StrBuilder.new()
  for i in 0..b.len() {
    let v = Int(b[i])
    out.write(HEX[(v >> 4)..(v >> 4) + 1])
    out.write(HEX[(v & 15)..(v & 15) + 1])
  }
  out.freeze()
}

fn nib(c: Int) -> Int { if c <= 57 { c - 48 } else { c - 87 } }


fn op(o: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes { internal.crypto_op(o, a, b, c, d) }

// n bytes of a deterministic pattern
fn pattern(n: Int, seed: Int) -> Bytes {
  var s = ""
  var x = seed
  for _ in 0..n {
    x = (x * 1103515245 + 12345) % 2147483648
    let b = (x / 65536) % 256
    s = s + HEX[b / 16..b / 16 + 1] + HEX[b % 16..b % 16 + 1]
  }
  Bytes.from_hex(s) ?? b""
}

fn main(os: Os) {
  let k = pattern(32, 1)
  let nonce = pattern(12, 3)
  for ctr in [b"0", b"7"] {
    for n in [0, 1, 63, 64, 65, 128, 255, 256, 257, 300, 511, 512, 513, 767, 768, 1000, 1024, 1500, 4096, 4101] {
      let out = op("chacha.xor", k, nonce, ctr, pattern(n, n + 11))
      os.stdio.println("ctr ${ctr.to_str() ?? "?"} n ${n}: ${out.len()} ${hex(op("hash.sha256", out, b"", b"", b""))}")
    }
  }
}
