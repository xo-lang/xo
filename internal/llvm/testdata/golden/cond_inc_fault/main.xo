// A conditional count, `if c { k += 1 }`, which arm64 adds as the
// condition's 0 or 1 without a branch (task #446): it faults on
// overflow only when the condition holds, as the branch did.
fn count_from(k0: Int, xs: List[Float]) -> Int {
  var k = k0
  for x in xs {
    if x < 1.0 {
      k += 1
    }
  }
  k
}

fn main(os: Os) {
  let big = 9223372036854775807
  os.stdio.println("count: ${count_from(0, [0.5, 2.0, 0.25, 1.0])}")
  os.stdio.println("max, none below: ${count_from(big, [1.5, 2.0, 3.0])}")
  os.stdio.println("max, one below")
  os.stdio.println("never: ${count_from(big, [1.5, 0.5])}")
}
