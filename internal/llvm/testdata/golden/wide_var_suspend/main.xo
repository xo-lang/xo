  s39: Str = "s39"
}

// a wide `var` parameter (passed by home) whose callee suspends: the
// caller must read back the callee's updates, not a copy made again when
// the call resumes
fn work(var m: M, k: Int) -> Int {
  let r = scope s {
    let a = s.spawn(fn() -> Int { k + 1 })
    let b = s.spawn(fn() -> Int { k + 2 })
    a.await + b.await
  }
  m.funcs.push(r)
  m.n += r
  m.l3.push(r)
  r
}

fn run(k: Int) -> Int {
  var m = M{}
  for i in 0..10 { m.funcs.push(i) }
  let keep = m
  let r = work(m, k)
  if m.funcs.len() != 11 || m.n != r || keep.funcs.len() != 10 || m.l3.len() != 2 {
    return -1
  }
  r
}

fn main(os: Os) {
  var bad = 0
  var t = 0
  for k in 0..500 {
    let r = run(k)
    if r < 0 { bad += 1 } else { t += r }
  }
  os.stdio.println("bad=${bad} t=${t}")
}
