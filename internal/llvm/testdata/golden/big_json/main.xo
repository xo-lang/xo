// std/big's BigInt (a bare JSON number through json.Number, decision 0673),
// BigRat and BigFloat in JSON (derive Json(via: Str), decision
// 0478) as Go's encoding/json writes and reads *big.Rat and *big.Float:
// their MarshalText and UnmarshalText. The via functions are std
// declarations whose bodies are std/native/big.xo's on the native
// backends.
use std/big
use std/json

struct I {
  n: big.BigInt
  l: List[big.BigInt]
} derive Json

fn deci(s: Str) -> Str {
  match json.decode_str[I](s) {
    Ok(x) => "${x.n} ${x.l.len()}"
    Err(e) => "err ${e.msg}"
  }
}

struct T {
  r: big.BigRat
  f: big.BigFloat
} derive Json

fn dec(s: Str) -> Str {
  match json.decode_str[T](s) {
    Ok(t) => "${t.r.rat_text()} ${t.f.text('g', -1)} ${t.f.prec()}"
    Err(e) => "err ${e.msg}"
  }
}

fn main(os: Os) {
  let f2 = big.parse_float("1e100", 10, 200).or_fault("1e100")
  os.stdio.println(json.encode_str(T{r: big.rat(big.from_int(3), big.from_int(-4)), f: big.from_float(0.1)}))
  os.stdio.println(json.encode_str(T{r: big.rat(big.from_int(10), big.from_int(2)), f: f2}))
  os.stdio.println(json.encode_str([big.rat_from_int(7), big.rat(big.from_int(1), big.from_int(3))]))
  os.stdio.println(json.to_value(big.inf(true)).encode())
  os.stdio.println(dec("{\"r\":\"-3/4\",\"f\":\"0.1\"}"))
  os.stdio.println(dec("{\"r\":\"0x10\",\"f\":\"1e100\"}"))
  os.stdio.println(dec("{\"r\":\"1.25\",\"f\":\"-Inf\"}"))
  os.stdio.println(dec("{\"r\":\"1/0\",\"f\":\"1\"}"))
  os.stdio.println(dec("{\"r\":\"1\",\"f\":\"abc\"}"))
  os.stdio.println(dec("{\"r\":2,\"f\":\"1\"}"))
  // BigInt: Go's Int.MarshalJSON and UnmarshalJSON
  os.stdio.println(json.encode_str(I{n: big.parse("-123456789012345678901234567890").or_fault("n"), l: [big.from_int(0), big.from_int(7)]}))
  for s in ["{\"n\":98765432109876543210,\"l\":[1,-2]}", "{\"n\":-0,\"l\":[]}", "{\"n\":1.5,\"l\":[]}", "{\"n\":1e3,\"l\":[]}", "{\"n\":\"12\",\"l\":[]}"] {
    os.stdio.println(deci(s))
  }
  os.stdio.println(json.to_value(big.from_int(42)).encode())
}
