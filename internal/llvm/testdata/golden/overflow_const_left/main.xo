    0 => {
      for i2 in 0..5 {
        acc = i2
      }
    }
    _ => {
      if 1 != 0 || p0 > p0 {
      }
    }
  }
  acc + 0
}

fn main(os: Os) {
  os.stdio.println("f1 ${f1(6)}")
}
