// X.509 parsing of the native backends' TLS (std/native/llrt/asn1.xo and
// x509.xo, the zero-C audit's B31) against Go's crypto/x509 through
// internal.crypto_op: the fields of certificates Go made (P-256, P-384,
// Ed25519, and RSA keys; ECDSA, Ed25519, PKCS #1 and PSS signatures;
// names, IPs, key usages, basic and name constraints, an unknown
// critical extension, a GeneralizedTime), signature checks, and
// malformed DER.
use std/internal

const ROOT: Str = ""
const INTER: Str = ""
const LEAF: Str = ""
const ED: Str = ""
const RSA: Str = ""
const PSS: Str = ""
const TWO: Str = ""

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

fn op(name: Str, a: Bytes, b: Bytes) -> Bytes { internal.crypto_op(name, a, b, b"", b"") }

/// b with the byte at i changed.
fn poke(b: Bytes, i: Int, v: Int) -> Bytes {
  var out = BytesBuilder.new()
  for k in 0..b.len() {
    if k == i {
      out.write_byte(UInt8(v))
    } else {
      out.write_byte(b[k])
    }
  }
  out.freeze()
}

fn main(os: Os) uses stdio {
  let names = ["root", "inter", "leaf", "ed", "rsa", "pss", "two"]
  let certs = [hex(ROOT), hex(INTER), hex(LEAF), hex(ED), hex(RSA), hex(PSS), hex(TWO)]
  for (i, c) in certs.indexed() {
    os.stdio.println("== ${names[i]}")
    os.stdio.print(op("x509.parse", c, b"").to_str() ?? "")
  }
  let pairs = [(0, 0), (1, 0), (2, 1), (6, 0), (2, 0), (1, 1), (3, 3), (6, 1), (4, 4), (5, 5), (5, 4), (4, 0), (0, 4)]
  for (a, b) in pairs {
    os.stdio.println("${names[a]} signed by ${names[b]} ${op("x509.signed_by", certs[a], certs[b]).to_hex()}")
  }
  let leafb = certs[2]
  let n = leafb.len()
  os.stdio.println("truncated ${op("x509.parse", leafb[0..n - 1], b"").to_str() ?? ""}")
  os.stdio.println("empty ${op("x509.parse", b"", b"").to_str() ?? ""}")
  var extra = BytesBuilder.new()
  for x in leafb {
    extra.write_byte(x)
  }
  extra.write_byte(0)
  os.stdio.println("trailing ${op("x509.parse", extra.freeze(), b"").to_str() ?? ""}")
  // the last byte of the signature changed: parses, does not verify
  let bad = poke(leafb, n - 1, Int(leafb[n - 1]) ^ 1)
  os.stdio.println("bad signature parses ${op("x509.parse", bad, b"").len() > 5} verifies ${op("x509.signed_by", bad, certs[1]).to_hex()}")
  // the long form length 0x82 at the start rewritten as 0x83 (not minimal)
  os.stdio.println("non minimal length ${op("x509.parse", poke(leafb, 1, 0x83), b"").to_str() ?? ""}")
}
