// Spill slots in stack words (arm64 regalloc, pass arg_slots): a value
// copied to a call's stack argument or result word, or to this
// function's own, lives there when no call in its range lets a callee
// write the word. Calls with stack arguments and results past the
// registers, values live across other such calls, a value passed on
// after a call that took the same word, results built from stack
// parameters, and a fault in a callee with stack arguments.
use std/task

struct Wide {
  a: Str
  b: Str
  c: Str
  d: Str
  e: Int
  f: Int
  g: Int
  h: Int
  i: Str
  j: Int
}

fn mix(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Str, j: Str, k: Int, l: Str) -> Int {
  a + b + c + d + e + f + g + h + i.len() + j.len() * 10 + k * 100 + l.len() * 1000
}

fn wide(s: Str, n: Int, a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, x: Str, y: Str) -> Wide {
  Wide{a: s, b: "${s}${n}", c: x, d: y, e: n + a, f: b + c, g: d + e, h: f, i: "${x}${y}", j: n}
}

fn check(at: Int, k: Int, a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, s: Str, t: Str) -> Int {
  if at == k {
    fault("check ${k} ${s}${t}")
  }
  a + b + c + d + e + f + s.len() + t.len()
}

fn run(at: Int) -> Int {
  let s1 = "one ${at}"
  let s2 = "two"
  let w = wide(s1, at, 1, 2, 3, 4, 5, 6, s2, "y")
  var n = mix(1, 2, 3, 4, 5, 6, 7, 8, w.a, w.b, w.e, w.i)
  n += check(at, 0, 1, 2, 3, 4, 5, 6, s1, w.c)
  // w.d was a stack word of wide's result and is passed after other calls
  n += mix(w.f, w.g, w.h, w.j, 0, 0, 0, 0, w.d, s2, n, s1)
  n += check(at, 1, n, 1, 1, 1, 1, 1, w.i, w.b)
  let w2 = wide(w.i, n, w.e, w.f, w.g, w.h, w.j, 0, w.a, w.d)
  n += check(at, 2, w2.e, w2.f, w2.g, w2.h, w2.j, 0, w2.b, w2.i)
  n + w2.a.len() + w2.c.len() + w.a.len()
}

fn main(os: Os) {
  for at in 0..4 {
    match task.isolate(fn() -> Int ! () { run(at) }) {
      Ok(v) => os.stdio.println("${at}: ok ${v}")
      Err(task.Isolated.Faulted(info)) => os.stdio.println("${at}: fault ${info.msg}")
      Err(_) => os.stdio.println("${at}: failed")
    }
  }
}
