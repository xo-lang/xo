// The native TLS primitives (work item B31, decision 0202) on the
// published test vectors: SHA-256, SHA-384, and SHA-512 (FIPS 180-4 examples),
// HMAC (RFC 4231 cases 1, 2, 6), HKDF (RFC 5869 cases 1 and 3), and
// TLS 1.3's HKDF-Expand-Label (RFC 8448's early and derived secrets),
// AES (FIPS 197 appendix C) and AES-GCM (the GCM specification's test
// cases 1 to 4, 15, 16; every length to 80 against Go). TestGolden diffs
// the native output against the Go backend's, which is Go's crypto
// (std/rt internal_crypto.go).
use std/internal

const HEX: Str = "0123456789abcdef"

fn hex(b: Bytes) -> Str {
  var out = StrBuilder.new()
  for i in 0..b.len() {
    let v = Int(b[i])
    out.write(HEX[(v >> 4)..(v >> 4) + 1])
    out.write(HEX[(v & 15)..(v & 15) + 1])
  }
  out.freeze()
}

fn nib(c: Int) -> Int { if c <= 57 { c - 48 } else { c - 87 } }

fn unhex(s: Str) -> Bytes {
  let b = s.bytes()
  var out = BytesBuilder.new()
  var i = 0
  while i + 1 < b.len() {
    out.write_byte(UInt8(nib(Int(b[i])) * 16 + nib(Int(b[i + 1]))))
    i += 2
  }
  out.freeze()
}

fn rep(x: Int, n: Int) -> Bytes {
  var out = BytesBuilder.new()
  for _ in 0..n {
    out.write_byte(UInt8(x))
  }
  out.freeze()
}

fn check(os: Os, name: Str, got: Bytes, want: Str) {
  let h = hex(got)
  let verdict = if h == want { "ok" } else { "MISMATCH want ${want}" }
  os.stdio.println("${name} ${verdict}")
}

fn op(o: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes { internal.crypto_op(o, a, b, c, d) }

fn main(os: Os) {
  let e = b""
  let abc = b"abc"
  let m448 = b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  let m896 = b"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
  check(os, "sha256 empty", op("hash.sha256", e, e, e, e), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  check(os, "sha256 abc", op("hash.sha256", abc, e, e, e), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  check(os, "sha256 448", op("hash.sha256", m448, e, e, e), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
  check(os, "sha384 empty", op("hash.sha384", e, e, e, e), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
  check(os, "sha384 abc", op("hash.sha384", abc, e, e, e), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
  check(os, "sha384 896", op("hash.sha384", m896, e, e, e), "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
  check(os, "sha512 empty", op("hash.sha512", e, e, e, e), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
  check(os, "sha512 abc", op("hash.sha512", abc, e, e, e), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
  check(os, "sha512 896", op("hash.sha512", m896, e, e, e), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")
  // every split point of a 200 byte message, every hash: the incremental
  // state against the one shot
  let long = rep(97, 200)
  for hn in ["256", "384", "512"] {
    var bad = 0
    for k in [0, 1, 55, 56, 63, 64, 65, 111, 112, 127, 128, 129, 199, 200] {
      let s = op("hash.split${hn}", long[0..k], long[k..200], e, e)
      let one = op("hash.sha${hn}", long, e, e, e)
      let part = op("hash.sha${hn}", long[0..k], e, e, e)
      let n = one.len()
      if hex(s[0..n]) != hex(part) || hex(s[n..2 * n]) != hex(one) || hex(s[2 * n..3 * n]) != hex(part) {
        bad += 1
      }
    }
    os.stdio.println("split${hn} bad ${bad}")
  }
  check(os, "hmac256 rfc4231 1", op("hmac.sha256", rep(11, 20), b"Hi There", e, e), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
  check(os, "hmac384 rfc4231 1", op("hmac.sha384", rep(11, 20), b"Hi There", e, e), "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")
  check(os, "hmac256 rfc4231 2", op("hmac.sha256", b"Jefe", b"what do ya want for nothing?", e, e), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  check(os, "hmac384 rfc4231 2", op("hmac.sha384", b"Jefe", b"what do ya want for nothing?", e, e), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
  check(os, "hmac512 rfc4231 1", op("hmac.sha512", rep(11, 20), b"Hi There", e, e), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
  check(os, "hmac512 rfc4231 2", op("hmac.sha512", b"Jefe", b"what do ya want for nothing?", e, e), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
  let big = b"Test Using Larger Than Block-Size Key - Hash Key First"
  check(os, "hmac256 rfc4231 6", op("hmac.sha256", rep(170, 131), big, e, e), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
  check(os, "hmac384 rfc4231 6", op("hmac.sha384", rep(170, 131), big, e, e), "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952")
  let ikm = rep(11, 22)
  let salt = unhex("000102030405060708090a0b0c")
  let info = unhex("f0f1f2f3f4f5f6f7f8f9")
  let prk1 = op("hkdf.extract256", salt, ikm, e, e)
  check(os, "hkdf rfc5869 1 prk", prk1, "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
  check(os, "hkdf rfc5869 1 okm", op("hkdf.expand256", prk1, info, b"42", e), "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
  let prk3 = op("hkdf.extract256", e, ikm, e, e)
  check(os, "hkdf rfc5869 3 prk", prk3, "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")
  check(os, "hkdf rfc5869 3 okm", op("hkdf.expand256", prk3, e, b"42", e), "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
  // SHA-384's HKDF, against Go only (no RFC 5869 case)
  let prk384 = op("hkdf.extract384", salt, ikm, e, e)
  os.stdio.println("hkdf384 prk ${hex(prk384)}")
  os.stdio.println("hkdf384 okm ${hex(op("hkdf.expand384", prk384, info, b"100", e))}")
  // RFC 8448: the early secret (no PSK) and its "derived" secret
  let early = op("hkdf.extract256", e, rep(0, 32), e, e)
  check(os, "tls13 early", early, "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
  let empty_hash = op("hash.sha256", e, e, e, e)
  check(os, "tls13 derived", op("hkdf.label256", early, b"derived", empty_hash, b"32"), "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
  os.stdio.println("label384 ${hex(op("hkdf.label384", prk384, b"key", e, b"32"))}")
  aes_checks(os)
}

fn aes_checks(os: Os) {
  let e = b""
  let pt = unhex("00112233445566778899aabbccddeeff")
  check(os, "aes128 fips197", op("aes.block", unhex("000102030405060708090a0b0c0d0e0f"), pt, e, e), "69c4e0d86a7b0430d8cdb78070b4c55a")
  check(os, "aes192 fips197", op("aes.block", unhex("000102030405060708090a0b0c0d0e0f1011121314151617"), pt, e, e), "dda97ca4864cdfe06eaf70a0ec0d7191")
  check(os, "aes256 fips197", op("aes.block", unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), pt, e, e), "8ea2b7ca516745bfeafc49904b496089")
  let z16 = rep(0, 16)
  let z12 = rep(0, 12)
  check(os, "gcm 1", op("aes.seal", z16, z12, e, e), "58e2fccefa7e3061367f1d57a4e7455a")
  check(os, "gcm 2", op("aes.seal", z16, z12, z16, e), "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf")
  let k = unhex("feffe9928665731c6d6a8f9467308308")
  let n = unhex("cafebabefacedbaddecaf888")
  let p = unhex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")
  let a = unhex("feedfacedeadbeeffeedfacedeadbeefabaddad2")
  check(os, "gcm 3", op("aes.seal", k, n, p, e), "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4")
  let s4 = op("aes.seal", k, n, p[0..60], a)
  check(os, "gcm 4", s4, "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47")
  let k2 = unhex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")
  check(os, "gcm 15 tag", op("aes.seal", k2, n, p, e)[64..80], "b094dac5d93471bdec1a502270e3cc6c")
  check(os, "gcm 16 tag", op("aes.seal", k2, n, p[0..60], a)[60..76], "76fc6ece0f4e1768cddf8853bb2d551b")
  check(os, "gcm 4 open", op("aes.open", k, n, s4, a), "01${hex(p[0..60])}")
  var bad = BytesBuilder.new()
  bad.write(s4[0..75])
  bad.write_byte(UInt8(Int(s4[75]) ^ 1))
  check(os, "gcm 4 open bad tag", op("aes.open", k, n, bad.freeze(), a), "00")
  check(os, "gcm 4 open bad aad", op("aes.open", k, n, s4, a[0..19]), "00")
  check(os, "gcm open short", op("aes.open", k, n, rep(0, 15), e), "00")
  // every length to 80 under each key size, the seals hashed (Go and
  // native must agree) and each opened again
  var all = BytesBuilder.new()
  var opened = 0
  var seed = op("hash.sha512", b"aes sweep", e, e, e)
  for len in 0..81 {
    seed = op("hash.sha512", seed, e, e, e)
    let key = seed[0..16 + 8 * (len % 3)]
    let nonce = seed[32..44]
    let msg = (op("hash.sha512", seed, b"1", e, e) + op("hash.sha512", seed, b"2", e, e))[0..len]
    let aad = seed[44..44 + len % 20]
    let sealed = op("aes.seal", key, nonce, msg, aad)
    all.write(sealed)
    if hex(op("aes.open", key, nonce, sealed, aad)) == "01${hex(msg)}" {
      opened += 1
    }
  }
  os.stdio.println("gcm sweep ${hex(op("hash.sha256", all.freeze(), e, e, e))} opened ${opened}")
}
