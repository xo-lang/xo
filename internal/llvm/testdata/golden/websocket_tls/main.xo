// std/websocket over TLS (decision 0313 stage 2): a server with a test
// certificate (http_tls's, ECDSA P-256, valid to 2120) and clients that
// dial wss:// with its CA as roots (echo of text and binary, a close),
// without them (the system roots: unknown authority), and with roots
// that are not PEM. The Go backend and the native one must agree.
use std/http
use std/websocket

fn echo(c: websocket.WsConn) {
  while true {
    match c.read() {
      Ok(m) => {
        if c.write(m) is Err(_) {
          return
        }
      }
      Err(_) => return
    }
  }
}

fn client(os: Os, url: Str) -> () ! websocket.WsErr {
  let c = websocket.dial(os.net, url, roots: ca_pem())?
  c.write_text("over tls")?
  let m = c.read()?
  os.stdio.println("echo: ${m.data.to_str() ?? "?"}")
  c.write(websocket.Message{kind: websocket.Kind.Binary, data: "x".repeat(70000).bytes()})?
  os.stdio.println("echo: ${c.read()?.data.len()} bytes")
  c.close(reason: "done")?
}

fn main(os: Os) {
  var r = http.router()
  r.handle("GET /echo", fn(req) { websocket.upgrade(req, echo) })
  let cert = match http.tls_cert(good_cert(), good_key()) {
    Ok(c) => c
    Err(e) => {
      os.stdio.println("cert: ${e}")
      return
    }
  }
  match os.net.listen("127.0.0.1:0") {
    Ok(l) => {
      let srv = http.server(l, r).with_tls([cert])
      let addr = srv.addr()
      let port = addr.split(":")[1]
      scope s {
        s.spawn_background(fn() {
          match srv.serve() {
            Ok(_) => ()
            Err(e) => os.stdio.println("serve failed: ${e}")
          }
        })
        match client(os, "wss://localhost:${port}/echo") {
          Ok(_) => os.stdio.println("wss: ok")
          Err(e) => os.stdio.println("wss: ${e}")
        }
        match websocket.dial(os.net, "wss://localhost:${port}/echo") {
          Ok(_) => os.stdio.println("system roots: connected?")
          Err(e) => os.stdio.println("system roots: ${e is websocket.WsErr.Net(_)}")
        }
        match websocket.dial(os.net, "wss://localhost:${port}/echo", roots: "not pem".bytes()) {
          Ok(_) => os.stdio.println("bad roots: connected?")
          Err(e) => os.stdio.println("bad roots: ${e}")
        }
      }
      os.stdio.println("done")
    }
    Err(e) => os.stdio.println("listen failed: ${e}")
  }
}

fn ca_pem() -> Bytes { "-----BEGIN CERTIFICATE-----\nMIIBXTCCAQOgAwIBAgIBAjAKBggqhkjOPQQDAjAVMRMwEQYDVQQDEwpYbyBUZXN0\nIENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMjAwMTAxMDAwMDAwWjAVMRMwEQYDVQQD\nEwpYbyBUZXN0IENBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEijw7AWGYTeLp\n/9oDX6t32fPfTkDcI/F29wXFQRBDz+0AxRDpI6PQf9UdiF9aZfB5AM5J3PdtARhw\nCIekwP7z7aNCMEAwDgYDVR0PAQH/BAQDAgKEMA8GA1UdEwEB/wQFMAMBAf8wHQYD\nVR0OBBYEFLrbZ5A0fzzE42xjrFaZTWKJC9Z6MAoGCCqGSM49BAMCA0gAMEUCIHzG\n+C1Oz2qF9sqKv6CMRcep89t3K01Um1dypPN+nE7ZAiEA3+DkafbsP8oH5cfghe/i\nMsgJIwR+YEK89sPkPWqn3nI=\n-----END CERTIFICATE-----\n".bytes() }
