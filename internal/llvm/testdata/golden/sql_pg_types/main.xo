// std/sql's typed readers of Postgres types (decision 0679) on every
// backend, through a driver that returns Postgres's text output: uuid,
// date (BC, wide years), time of day (24:00:00, fractions), interval
// (IntervalStyle postgres), inet and cidr, arrays through Row.elements;
// NULL through the _opt forms,
// other values as Mismatch; and the parameters' text.
use std/sql
use std/time
use std/uuid
use std/netip


struct Log {
  lines: Mutex[List[Str]]
  next: Atomic[Int]
}

fn (l: Log) add(s: Str) { l.lines.with(fn(var xs) { xs.push(s) }) }

struct FakeDriver {
  log: Log
  fail_password: Bool
}

struct FakeConn {
  id: Int
  log: Log
  broken: Atomic[Bool]
}

fn (d: FakeDriver) connect(net: Net, dsn: Str) -> sql.DriverConn ! sql.SqlErr uses net.dial {
  if d.fail_password {
    return Err(sql.SqlErr.Conn(msg: "password authentication failed"))
  }
  let id = d.log.next.add(1)
  d.log.add("connect ${id} ${dsn}")
  FakeConn{id: id, log: d.log, broken: Atomic.new(false)}
}

fn (c: FakeConn) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows ! sql.SqlErr uses net.dial {
  if q.starts_with("select lo") {
    // large objects (decision 0679): the call as the server gets it
    c.log.add("${q} ${args:?}")
    let v = if q.starts_with("select loread") {
      sql.SqlValue.Blob(b: b"abc")
    } else if q.starts_with("select lowrite") {
      sql.SqlValue.Integer(n: 2)
    } else if q.starts_with("select lo_unlink") {
      sql.SqlValue.Integer(n: if args == [sql.SqlValue.Integer(n: 9)] { 0 } else { 1 })
    } else {
      sql.SqlValue.Integer(n: 7)
    }
    return sql.DriverRows{columns: ["r"], rows: [[v]]}
  }
  if q == "PARAMS" {
    // each parameter as the driver receives it
    return sql.DriverRows{columns: ["p"], rows: args.map(fn(a) { [a] })}
  }
  // one row of Postgres text: a column per case, NULL as sql.null()
  var cols: List[Str] = []
  var vals: List[sql.SqlValue] = []
  for (i, t) in q.split(" ;; ").indexed() {
    cols.push("c${i}")
    vals.push(if t == "NULL" { sql.null() } else if t == "INT" { sql.int(7) } else if t == "FLOAT" { sql.float(1.5) } else if t == "AT" { sql.SqlValue.At(t: Time.from_unix(86400 + 1)) } else if t == "ARR" { sql.SqlValue.Array(items: [sql.SqlValue.Integer(n: 1), sql.SqlValue.Null]) } else { sql.str(t) })
  }
  sql.DriverRows{columns: cols, rows: [vals]}
}

fn (c: FakeConn) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  c.log.add("conn ${c.id} exec ${q}")
  sql.ExecResult{rows_affected: args.len(), last_insert_id: 0}
}

fn (c: FakeConn) begin() -> () ! sql.SqlErr uses net.dial { c.log.add("conn ${c.id} BEGIN") }
fn (c: FakeConn) commit() -> () ! sql.SqlErr uses net.dial { c.log.add("conn ${c.id} COMMIT") }
fn (c: FakeConn) rollback() -> () ! sql.SqlErr uses net.dial { c.log.add("conn ${c.id} ROLLBACK") }
fn (c: FakeConn) ping() -> () ! sql.SqlErr uses net.dial { c.log.add("conn ${c.id} ping") }
fn (c: FakeConn) close() { c.log.add("conn ${c.id} close") }
fn (c: FakeConn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr) -> Int ! sql.SqlErr uses net.dial {
  Err(sql.SqlErr.Driver(msg: "no COPY"))
}

/// COPY TO: two CopyData messages, then the rows the server reports.
fn (c: FakeConn) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  c.log.add("conn ${c.id} copy_to ${q}")
  if !q.contains("TO STDOUT") {
    return Err(sql.SqlErr.Server(code: "42601", msg: "syntax error"))
  }
  out(b"1\ta\n")?
  out(b"2\t\\N\n")?
  2
}

fn (c: FakeConn) is_broken() -> Bool { c.broken.get() }

/// No statements on the server: std/sql runs the text each time.
fn (c: FakeConn) prepare(q: Str) -> sql.DriverStmt? ! sql.SqlErr { None }

/// No LISTEN/NOTIFY and no notices (decision 0648 item 14).
fn (c: FakeConn) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial {
  Err(sql.SqlErr.Driver(msg: "no LISTEN/NOTIFY"))
}

fn (c: FakeConn) notices() -> List[sql.Notice] { [] }

fn (c: FakeConn) pipeline(batches: List[List[sql.BatchQuery]], in_tx: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr {
  Err(sql.SqlErr.Driver(msg: "fake: no batches"))
}

/// An array column's elements read by each reader.
fn el_uuids(r: sql.Row, c: Str) -> List[Str?] ! sql.SqlErr {
  var out: List[Str?] = []
  for e in r.elements(c)? {
    out.push(e.uuid_opt(c)?.map(fn(u) { u.display() }))
  }
  out
}

fn el_nums(r: sql.Row, c: Str) -> List[Str] ! sql.SqlErr {
  var out: List[Str] = []
  for e in r.elements(c)? {
    out.push(e.numeric(c)?.display())
  }
  out
}

fn el_ranges(r: sql.Row, c: Str) -> List[Str] ! sql.SqlErr {
  var out: List[Str] = []
  for e in r.elements(c)? {
    out.push("${e.range_int(c)?:?}")
  }
  out
}

fn el_strs(r: sql.Row, c: Str) -> List[Str?] ! sql.SqlErr {
  var out: List[Str?] = []
  for e in r.elements(c)? {
    out.push(e.str_opt(c)?)
  }
  out
}

fn el_ints(r: sql.Row, c: Str) -> List[Int?] ! sql.SqlErr {
  var out: List[Int?] = []
  for e in r.elements(c)? {
    out.push(e.int_opt(c)?)
  }
  out
}

fn el_first_int(r: sql.Row, c: Str) -> Int ! sql.SqlErr { r.elements(c)?[0].int(c) }

/// A numeric range with its bounds' display text.
fn nrange(r: sql.Range[sql.Numeric]) -> Str {
  match r {
    Empty => "empty"
    Span(lo, hi) => "${nedge(lo)} .. ${nedge(hi)}"
  }
}

fn nedge(e: sql.Edge[sql.Numeric]) -> Str {
  match e {
    Inclusive(n) => "inclusive ${n.display()}"
    Exclusive(n) => "exclusive ${n.display()}"
    Unbounded => "unbounded"
  }
}

/// A time range with its bounds as RFC 3339 text.
fn tr(r: sql.Range[Time]) -> Str {
  match r {
    Empty => "empty"
    Span(lo, hi) => "${edge(lo)} .. ${edge(hi)}"
  }
}

fn edge(e: sql.Edge[Time]) -> Str {
  match e {
    Inclusive(t) => "inclusive ${t.format_rfc3339()}"
    Exclusive(t) => "exclusive ${t.format_rfc3339()}"
    Unbounded => "unbounded"
  }
}

fn show[T: Debug](label: Str, r: Result[T, sql.SqlErr]) -> Str {
  match r {
    Ok(v) => "${label}: ${v:?}"
    Err(e) => "${label}: ${e}"
  }
}

fn main(os: Os) ! {
  let log = Log{lines: Mutex.new([]), next: Atomic.new(0)}
  let db = sql.open_driver(os.net, FakeDriver{log: log, fail_password: false}, "dsn")?
  let us = db.query_one("a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11 ;; 00000000-0000-0000-0000-000000000000 ;; NULL ;; not-a-uuid ;; INT", [])?
  for c in us.columns() {
    os.stdio.println(show("uuid ${c}", us.uuid(c).map(fn(u) { u.display() })))
  }
  os.stdio.println(show("uuid_opt c2", us.uuid_opt("c2")))
  let ds = db.query_one("2026-10-20 ;; 0044-03-15 BC ;; 0001-01-01 BC ;; 10000-01-01 ;; infinity ;; -infinity ;; 2026-1-2 ;; NULL", [])?
  for c in ds.columns() {
    os.stdio.println(show("date ${c}", ds.date(c)))
  }
  os.stdio.println(show("date_opt c7", ds.date_opt("c7")))
  let ts = db.query_one("12:30:00 ;; 00:00:00.000001 ;; 23:59:59.999999 ;; 24:00:00 ;; 24:00:01 ;; 12:30 ;; 12:30:00+05:30 ;; 1:02:03", [])?
  for c in ts.columns() {
    os.stdio.println(show("time ${c}", ts.time_of_day(c)))
  }
  let is = db.query_one("1 year 2 mons 3 days 04:05:06.789 ;; 00:00:00 ;; 3 days ;; -1 years -2 mons +3 days -04:05:06 ;; 1 day -00:00:01 ;; 100:00:00 ;; -00:00:00.5 ;; 1 week ;; 2 mons 1", [])?
  for c in is.columns() {
    os.stdio.println(show("interval ${c}", is.interval(c)))
  }
  os.stdio.println("duration: ${(is.interval("c1")? with {micros: 1500}).duration():?} ${is.interval("c0")?.duration():?}")
  let ps = db.query_one("192.168.0.1 ;; 10.1.2.3/8 ;; 10.0.0.0/8 ;; ::1 ;; 2001:db8::/32 ;; 300.1.1.1 ;; 10.0.0.0/33", [])?
  for c in ps.columns() {
    os.stdio.println(show("inet ${c}", ps.prefix(c).map(fn(p) { p.display() })))
  }
  let bs = db.query_one("2026-10-20 ;; infinity ;; -infinity ;; NULL ;; tomorrow", [])?
  for c in bs.columns() {
    os.stdio.println(show("date_bound ${c}", bs.date_bound(c)))
  }
  os.stdio.println(show("date_bound_opt c3", bs.date_bound_opt("c3")))
  os.stdio.println(show("time_bound c1", bs.time_bound("c1")))
  os.stdio.println(show("time_bound c2", bs.time_bound("c2")))
  os.stdio.println(show("time_bound c0", bs.time_bound("c0")))
  // wide timestamps as a UTC Civil (decision 0614, task #375): years past
  // Time's range, BC, offsets, MySQL DATETIME text, infinity, the zero date
  let ws = db.query_one("294276-12-31 23:59:59.999999+00 ;; 0044-03-15 12:00:00 BC ;; 2824-01-02 03:04:05-08 ;; 1677-09-21 00:00:00 ;; 9999-12-31 23:59:59.5 ;; 2024-01-02 03:04:05+05:30:15 ;; 0001-01-01 00:30:00+01 ;; AT ;; infinity ;; -infinity ;; NULL ;; 0000-00-00 00:00:00 ;; 2024-01-02 24:00:00 ;; 2024-01-02 03:04:05+5 ;; 2024-01-02", [])?
  for c in ws.columns() {
    os.stdio.println(show("civil ${c}", ws.civil(c)))
  }
  for c in ["c0", "c8", "c9"] {
    os.stdio.println(show("civil_bound ${c}", ws.civil_bound(c)))
  }
  os.stdio.println(show("civil_opt c10", ws.civil_opt("c10")))
  os.stdio.println(show("civil_bound_opt c10", ws.civil_bound_opt("c10")))
  let ms = db.query_one("08:00:2b:01:02:03 ;; 08:00:2b:01:02:03:04:05 ;; 08:00:2b:01:02 ;; 08-00-2b-01-02-03 ;; 0g:00:2b:01:02:03", [])?
  for c in ms.columns() {
    os.stdio.println(show("mac ${c}", ms.mac(c).map(fn(b) { b.to_hex() })))
  }
  // hstore texts: escapes, an empty hstore, a trailing comma, a bare value
  let hq = ["\"a\"=>\"1\", \"b\"=>NULL, \"q \\\"x\\\"\"=>\"back\\\\slash\"", "", "\"a\"=>\"1\",", "\"a\"=>1"]
  let hs = db.query_one(hq.join(" ;; "), [])?
  for c in hs.columns() {
    os.stdio.println(show("hstore ${c}", hs.hstore(c)))
  }
  // ranges: canonical, unbounded, empty, quoted and escaped bounds, bad text
  let rq = ["[1,5)", "(,10]", "empty", "[-3,)", " [\"7\",\"9\"] ", "[1,5", "[a,b)"]
  let ri = db.query_one(rq.join(" ;; "), [])?
  for c in ri.columns() {
    os.stdio.println(show("range_int ${c}", ri.range_int(c)))
  }
  let rd = db.query_one("[2026-01-01,2026-02-01) ;; [\"2026-03-01\",infinity) ;; (,0044-03-15 BC]", [])?
  for c in rd.columns() {
    os.stdio.println(show("range_date ${c}", rd.range_date(c)))
  }
  let rt = db.query_one("[\"2026-01-01 10:00:00\",\"2026-01-02 00:00:00.5\") ;; (\"2026-01-01 10:00:00+05:30\",] ;; [\"2026-01-01 10:00:00-03\",\"2026-01-01 11:00:00+00\"]", [])?
  for c in rt.columns() {
    os.stdio.println(show("range_time ${c}", rt.range_time(c).map(fn(r) { tr(r) })))
  }
  let mq = ["{[1,3),[5,7)}", "{}", "{(,0),[\"1\",2]}", "{[1,3)", "{[1,3)}x"]
  let mr = db.query_one(mq.join(" ;; "), [])?
  for c in mr.columns() {
    os.stdio.println(show("multirange_int ${c}", mr.multirange_int(c)))
  }
  let md = db.query_one("{[2026-01-01,2026-01-05),[2026-02-01,2026-02-02)}", [])?
  os.stdio.println(show("multirange_date c0", md.multirange_date("c0")))
  let mt = db.query_one("{[\"2026-01-01 10:00:00+00\",\"2026-01-01 11:00:00+00\")}", [])?
  os.stdio.println(show("multirange_time c0", mt.multirange_time("c0").map(fn(rs) { rs.map(fn(r) { tr(r) }) })))
  os.stdio.println(show("range_int_opt null", db.query_one("NULL", [])?.range_int_opt("c0")))
  // composites: NULL and empty fields, quotes, escapes, a nested record, bad text
  let cq = ["(1,\"a b\",)", "()", "(\"x\"\"y\",\"back\\\\slash\",\"\")", "(1,\"(2,\"\"q\"\")\")", "1,2", "(1,\"open)"]
  let cs = db.query_one(cq.join(" ;; "), [])?
  for c in cs.columns() {
    os.stdio.println(show("fields ${c}", cs.fields(c)))
  }
  let nested = (cs.fields("c3").ok() ?? []).get(1) ?? None
  os.stdio.println(show("parse_composite nested", sql.parse_composite(nested ?? "")))
  os.stdio.println(show("parse_composite bad", sql.parse_composite("(1")))
  os.stdio.println(show("fields_opt null", db.query_one("NULL", [])?.fields_opt("c0")))
  // numeric: scale, sign, NaN, infinities, an integer column, bad text, a float
  let nq = db.query_one("1.50 ;; -0.003 ;; 100 ;; NaN ;; -Infinity ;; INT ;; 1.2.3 ;; FLOAT", [])?
  for c in nq.columns() {
    os.stdio.println(show("numeric ${c}", nq.numeric(c).map(fn(n) { n.display() })))
  }
  let nr = db.query_one("[1.5,2.25) ;; (,0] ;; {[1,2.5),[3,)}", [])?
  os.stdio.println(show("range_num c0", nr.range_num("c0").map(fn(r) { nrange(r) })))
  os.stdio.println(show("range_num c1", nr.range_num("c1").map(fn(r) { nrange(r) })))
  os.stdio.println(show("multirange_num c2", nr.multirange_num("c2").map(fn(rs) { rs.map(fn(r) { nrange(r) }) })))
  let np = sql.parse_numeric("12.340")?
  os.stdio.println("numeric parts ${np:?} int ${np.to_int():?} float ${np.to_float()}")
  // arrays' elements: text arrays split, typed through each reader
  let ar = db.query_one(r#"{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11,NULL} ;; {1.50,NaN,"-3"} ;; {"[1,3)",empty} ;; {"a,b","q\"x",NULL,"NULL"} ;; ARR ;; {} ;; {{1,2},{3,4}} ;; INT ;; NULL"#, [])?
  os.stdio.println(show("elements c0", el_uuids(ar, "c0")))
  os.stdio.println(show("elements c1", el_nums(ar, "c1")))
  os.stdio.println(show("elements c2", el_ranges(ar, "c2")))
  os.stdio.println(show("elements c3", el_strs(ar, "c3")))
  os.stdio.println(show("elements c4", el_ints(ar, "c4")))
  for c in ["c5", "c6", "c7", "c8"] {
    os.stdio.println(show("elements ${c}", ar.elements(c).map(fn(es) { es.len() })))
  }
  os.stdio.println(show("elements_opt c8", ar.elements_opt("c8").map(fn(o) { o.map(fn(es) { es.len() }) })))
  os.stdio.println(show("element mismatch", el_first_int(ar, "c3")))
  // COPY TO: the data in order, an error from out, a server error
  let got = Mutex.new("")
  let cn = db.copy_to("COPY t TO STDOUT", fn(b) { got.with(fn(var g) { g = g + b.to_str_lossy() }) })?
  os.stdio.println("copy_to ${cn} ${got.with(fn(g) { g }):?}")
  let calls = Atomic.new(0)
  os.stdio.println(show("copy_to out err", db.copy_to("COPY t TO STDOUT", fn(b) -> () ! sql.SqlErr {
    calls.add(1)
    Err(sql.SqlErr.Driver(msg: "disk full"))
  })))
  os.stdio.println("out called ${calls.get()}")
  os.stdio.println(show("copy_to server err", db.copy_to("COPY t TO nowhere", fn(b) {})))
  let ctx = db.begin()?
  os.stdio.println(show("tx copy_to", ctx.copy_to("COPY (SELECT 1) TO STDOUT", fn(b) {})))
  ctx.rollback()?
  let mem = sql.memory()?
  os.stdio.println(show("memory copy_to", mem.copy_to("COPY t TO STDOUT", fn(b) {})))
  // large objects: the calls each Tx.lo_* sends, and pgx's checks
  let tx = db.begin()?
  let oid = tx.lo_create()?
  let lo = tx.lo_open(oid, mode: sql.LoMode.Read)?
  os.stdio.println("lo open ${oid} ${lo:?}")
  os.stdio.println(show("lo_write short", tx.lo_write(lo, b"xyz")))
  os.stdio.println(show("lo_read", tx.lo_read(lo, 10).map(fn(b) { b.to_hex() })))
  os.stdio.println(show("lo_read exact", tx.lo_read(lo, 3).map(fn(b) { b.to_hex() })))
  os.stdio.println(show("lo_read more", tx.lo_read(lo, 2).map(fn(b) { b.to_hex() })))
  os.stdio.println(show("lo_seek", tx.lo_seek(lo, -1, whence: 2)))
  os.stdio.println(show("lo_tell", tx.lo_tell(lo)))
  os.stdio.println(show("lo_truncate", tx.lo_truncate(lo, 1).map(fn(_) { "ok" })))
  os.stdio.println(show("lo_close", tx.lo_close(lo).map(fn(_) { "ok" })))
  os.stdio.println(show("lo_unlink", tx.lo_unlink(oid).map(fn(_) { "ok" })))
  os.stdio.println(show("lo_unlink missing", tx.lo_unlink(9).map(fn(_) { "ok" })))
  tx.commit()?
  for l in log.lines.with(fn(xs) { xs }) {
    if l.starts_with("select lo") {
      os.stdio.println("sent ${l}")
    }
  }
  let u = uuid.parse("a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11")?
  let p = netip.parse_prefix("10.1.0.0/16")?
  let params = [sql.uuid(u), sql.date(time.Date{year: 2026, month: 3, day: 9}), sql.date(time.Date{year: -43, month: 3, day: 15}), sql.time_of_day(time.ClockTime{hour: 7, minute: 5, second: 3, nanos: 120000000}), sql.interval(sql.Interval{months: 14, days: -3, micros: 5000001}), sql.prefix(p), sql.mac(b"\x08\x00\x2b\x01\x02\x03"), sql.hstore({"a": Some("1"), "b": None, "q \"x\"": Some("back\\slash")}), sql.date_bound(sql.Bound.Infinity), sql.date_bound(sql.Bound.Finite(v: time.Date{year: 2026, month: 1, day: 2})), sql.time_bound(sql.Bound.NegInfinity), sql.range_int(sql.Range.Span(lower: sql.Edge.Inclusive(v: 1), upper: sql.Edge.Exclusive(v: 5))), sql.range_int(sql.Range.Empty), sql.range_date(sql.Range.Span(lower: sql.Edge.Unbounded, upper: sql.Edge.Inclusive(v: time.Date{year: 2026, month: 1, day: 2}))), sql.range_time(sql.Range.Span(lower: sql.Edge.Inclusive(v: Time.from_unix(0)), upper: sql.Edge.Unbounded)), sql.multirange_int([sql.Range.Span(lower: sql.Edge.Inclusive(v: 1), upper: sql.Edge.Exclusive(v: 3)), sql.Range.Span(lower: sql.Edge.Exclusive(v: 5), upper: sql.Edge.Unbounded)]), sql.multirange_int([]), sql.composite([Some("1"), Some("a b"), None, Some(""), Some(" lead"), Some("q\"(x)\\")]), sql.composite([]), sql.numeric(sql.parse_numeric("-1.250")?), sql.range_num(sql.Range.Span(lower: sql.Edge.Inclusive(v: sql.Numeric.NaN), upper: sql.Edge.Unbounded))]
  for r in db.query("PARAMS", params)? {
    os.stdio.println("param ${r.value("p")?:?}")
  }
  db.close()?
}
