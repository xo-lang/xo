// HTTPS with std/http (std.md 4.6, decisions 0105 and 0106): servers
// with TLS certificates on 127.0.0.1:0 and clients calling them, with the
// texts of every TLS failure (an unknown authority, host names without
// the IP, an expired and a not yet valid certificate, plain HTTP on
// either side, a handshake that never comes), certificate and root
// loading errors, a redirect, and bodies over many TLS records. The
// certificates are test only (ECDSA P-256, generated once; valid to
// 2120 except "expired" and "future").
use std/http

fn describe(e: http.ClientErr, addrs: List[Str]) -> Str {
  var s = match e {
    http.ClientErr.InvalidUrl(msg) => "InvalidUrl(${msg})"
    http.ClientErr.Connect(msg) => "Connect(${msg})"
    http.ClientErr.Timeout => "Timeout"
    http.ClientErr.Protocol(msg) => "Protocol(${msg})"
    http.ClientErr.Canceled => "Canceled"
  }
  for i in 0..addrs.len() {
    s = s.replace(addrs[i], "ADDR${i}")
  }
  // the time now varies: "current time <now> is after <limit>"
  let parts = s.split("current time ")
  if parts.len() == 2 {
    let rest = parts[1].split(" is ")
    if rest.len() == 2 {
      s = parts[0] + "current time NOW is " + rest[1]
    }
  }
  s
}

fn show(os: Os, label: Str, addrs: List[Str], r: Result[http.Response, http.ClientErr]) {
  match r {
    Ok(resp) => {
      let body = resp.text() ?? "?"
      if body.len() > 200 {
        os.stdio.println("${label}: ${resp.status} (${body.len()} bytes)")
      } else {
        os.stdio.println("${label}: ${resp.status} ${body}")
      }
    }
    Err(e) => os.stdio.println("${label}: ${describe(e, addrs)}")
  }
}

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(req) { http.text(200, "hello, scheme \"${req.url.scheme}\"") })
  r.handle("POST /echo", fn(req) { http.text(200, "echo: ${req.body.to_str() ?? "?"}") })
  r.handle("GET /big", fn(_req) { http.text(200, "x".repeat(100000)) })
  r.handle("GET /moved", fn(_req) { http.empty(302).with_header("Location", "/hello") })
  r
}

fn cert(os: Os, label: Str, c: Bytes, k: Bytes) -> http.TlsCert? {
  match http.tls_cert(c, k) {
    Ok(tc) => Some(tc)
    Err(e) => {
      os.stdio.println("${label}: ${e.msg}")
      None
    }
  }
}

fn main(os: Os) {
  // certificate and key errors (tls.X509KeyPair's texts)
  let _ = cert(os, "no pem", b"", good_key())
  let _ = cert(os, "switched", good_key(), good_cert())
  let _ = cert(os, "cert as key", good_cert(), good_cert())
  let _ = cert(os, "no key", good_cert(), b"")
  let _ = cert(os, "other key", good_cert(), sni_key())
  match http.client(os.net).with_roots(b"not pem") {
    Ok(_) => os.stdio.println("roots: ok?")
    Err(e) => os.stdio.println("roots: ${e.msg}")
  }
  let good = cert(os, "good", good_cert(), good_key()).or_fault("good")
  let sni = cert(os, "sni", sni_cert(), sni_key()).or_fault("sni")
  let expired = cert(os, "expired", expired_cert(), expired_key()).or_fault("expired")
  let future = cert(os, "future", future_cert(), future_key()).or_fault("future")
  let unknown = cert(os, "unknown", unknown_cert(), unknown_key()).or_fault("unknown")
  let noip = cert(os, "noip", noip_cert(), noip_key()).or_fault("noip")
  let wrongip = cert(os, "wrongip", wrongip_cert(), wrongip_key()).or_fault("wrongip")
  let l1 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l2 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l3 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l4 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l5 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l6 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l7 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l8 = os.net.listen("127.0.0.1:0").or_fault("listen")
  // a listener nobody accepts on: the handshake never comes
  let silent = os.net.listen("127.0.0.1:0").or_fault("listen")
  let main_srv = http.server(l1, routes()).with_tls([good, sni])
  let servers = [
    main_srv,
    http.server(l2, routes()).with_tls([expired]),
    http.server(l3, routes()).with_tls([future]),
    http.server(l4, routes()).with_tls([unknown]),
    http.server(l5, routes()).with_tls([noip]),
    http.server(l6, routes()).with_tls([wrongip]),
    http.server(l7, routes()),
  ]
  let empty = http.server(l8, routes()).with_tls([])
  let addrs = [l1.addr(), l2.addr(), l3.addr(), l4.addr(), l5.addr(), l6.addr(), l7.addr(), silent.addr()]
  let base = "https://${l1.addr()}"
  let system = http.client(os.net, timeout: 5s)
  let c = http.client(os.net, timeout: 5s).with_roots(ca_pem()).or_fault("roots")
  scope s {
    for srv in servers {
      s.spawn_background(fn() {
        match srv.serve() {
          Ok(_) => ()
          Err(e) => os.stdio.println("serve failed: ${e}")
        }
      })
    }
    match empty.serve() {
      Ok(_) => os.stdio.println("empty: served?")
      Err(e) => os.stdio.println("empty: ${e}")
    }
    show(os, "hello", addrs, c.get(base + "/hello"))
    show(os, "echo", addrs, c.send(http.new_request("POST", base + "/echo", {}, "over tls".bytes())))
    show(os, "big", addrs, c.get(base + "/big"))
    show(os, "moved", addrs, c.get(base + "/moved"))
    // the text depends on the verifier (macOS: the Security framework,
    // which also rejects certificates valid for 100 years)
    match system.get(base + "/hello") {
      Ok(resp) => os.stdio.println("system roots: ${resp.status}?")
      Err(e) => os.stdio.println("system roots: ${describe(e, addrs).split("(")[0]}")
    }
    show(os, "expired", addrs, c.get("https://${l2.addr()}/hello"))
    show(os, "future", addrs, c.get("https://${l3.addr()}/hello"))
    show(os, "unknown", addrs, c.get("https://${l4.addr()}/hello"))
    show(os, "no ip", addrs, c.get("https://${l5.addr()}/hello"))
    show(os, "wrong ip", addrs, c.get("https://${l6.addr()}/hello"))
    show(os, "https to http", addrs, c.get("https://${l7.addr()}/hello"))
    show(os, "http to https", addrs, c.get("http://${l1.addr()}/hello"))
    show(os, "plain", addrs, c.get("http://${l7.addr()}/hello"))
    let quick = http.client(os.net, timeout: 300ms).with_roots(ca_pem()).or_fault("roots")
    show(os, "silent", addrs, quick.get("https://${silent.addr()}/hello"))
    silent.close()
  }
  os.stdio.println("done")
}

