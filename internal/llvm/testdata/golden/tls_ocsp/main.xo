// std/tls's OCSP stapling and Signed Certificate Timestamps (decision
// 0644 T10): TlsCert.with_ocsp_staple and
// with_signed_certificate_timestamps (Go's Certificate.OCSPStaple and
// SignedCertificateTimestamps) sent to a client that asks, read as
// ConnState.ocsp_response and signed_certificate_timestamps, on TLS 1.3
// (the leaf's Certificate entry) and TLS 1.2 (CertificateStatus, the
// ServerHello's SCTs), again on a resumed connection, and through
// get_certificate; after handshake_test.go's testOCSPResponse and
// testSCTs checks.
use std/tls
use std/x509
use std/crypto
use std/base64
use std/netip

struct Issued {
  cert: x509.Certificate
  key: crypto.PrivateKey
}

/// A PEM block of der on one line (PEM readers ignore line lengths).
fn pem_block(kind: Str, der: Bytes) -> Bytes {
  "-----BEGIN ${kind}-----\n${base64.encode(der)}\n-----END ${kind}-----\n".bytes()
}

fn issue(os: Os, name: Str, parent: Issued?, ca: Bool, eku: List[x509.ExtKeyUsage], now: Time) -> Issued uses rand {
  let key = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256).or_fault("key")
  let usage = if ca { [x509.KeyUsage.CertSign, x509.KeyUsage.DigitalSignature] } else { [x509.KeyUsage.DigitalSignature] }
  let ips = if ca { [] } else { [netip.parse_addr("127.0.0.1").or_fault("ip")] }
  let t = x509.Template{subject: x509.Name{common_name: name}, not_before: now - 1h, not_after: now + 24h, ip_addresses: ips, is_ca: ca, key_usage: usage, ext_key_usage: eku}
  let (pc, pk) = match parent {
    Some(p) => (Some(p.cert), p.key)
    None => (None, key)
  }
  Issued{cert: x509.create_certificate(os.rand, t, key.public_key(), pc, pk).or_fault("cert ${name}"), key: key}
}

fn tls_pair(i: Issued, chain: List[x509.Certificate]) -> tls.TlsCert {
  var pem = i.cert.pem()
  for c in chain {
    pem = pem + c.pem()
  }
  tls.cert(pem, pem_block("PRIVATE KEY", crypto.marshal_private_key(i.key))).or_fault("pair")
}



/// Serves n connections of l: a handshake, then a reply so the client
/// reads the tickets.
fn serve(l: tls.TlsListener, n: Int) uses net {
  for _i in 0..n {
    if let Ok(c) = l.accept() {
      if c.handshake().is_ok() {
        c.write(b"hi").ignore_err("the client may be gone")
        match c.read(16) {
          _ => {}
        }
      }
      c.close()
    }
  }
}

/// The client's view of the staple and SCTs on each of n connections.
fn run(os: Os, cfg: tls.ServerConfig, n: Int, cc: tls.ClientConfig) -> List[Str] uses net, clock {
  let l = tls.listen(os.net, "127.0.0.1:0", cfg).or_fault("listen")
  var out: List[Str] = []
  scope s {
    let t = s.spawn(fn() { serve(l, n) })
    for i in 0..n {
      let line = match tls.dial_config(os.net, l.addr(), cc, timeout: Some(5s)) {
        Ok(c) => {
          match c.read(16) {
            _ => {}
          }
          let st = c.state()
          c.write(b"bye").ignore_err("the server may be gone")
          c.close()
          "resumed ${st.did_resume} ocsp '${st.ocsp_response.to_str() ?? "?"}' scts ${st.signed_certificate_timestamps.map(fn(b: Bytes) -> Str { b.to_str() ?? "?" })}"
        }
        Err(e) => "${e}"
      }
      out.push("  ${i + 1}: ${line}")
    }
    t.await
  }
  l.close()
  out
}

fn show(os: Os, what: Str, lines: List[Str]) uses stdio {
  os.stdio.println(what)
  for l in lines {
    os.stdio.println(l)
  }
}

fn main(os: Os) uses net, stdio, rand, clock {
  let now = os.clock.now()
  let ca = issue(os, "Xo Test CA", None, true, [], now)
  let server = issue(os, "server", Some(ca), false, [x509.ExtKeyUsage.ServerAuth], now)
  let roots = tls.roots_of([ca.cert]).or_fault("roots")
  let plain = tls_pair(server, [])
  let stapled = plain.with_ocsp_staple(b"an OCSP response").with_signed_certificate_timestamps([b"sct one", b"sct two"])
  for v in [tls.VERSION_TLS13, tls.VERSION_TLS12] {
    os.stdio.println("== ${tls.version_name(v)}")
    let cc = tls.ClientConfig{server_name: "127.0.0.1", roots: Some(roots)}
    show(os, "a stapled certificate:", run(os, tls.ServerConfig{certificates: [stapled], max_version: v}, 1, cc))
    show(os, "no staple:", run(os, tls.ServerConfig{certificates: [plain], max_version: v}, 1, cc))
    show(os, "only SCTs:", run(os, tls.ServerConfig{certificates: [plain.with_signed_certificate_timestamps([b"just one"])], max_version: v}, 1, cc))
    show(os, "resumed, the session's again:", run(os, tls.ServerConfig{certificates: [stapled], max_version: v}, 2, cc with {session_cache: Some(tls.lru_session_cache(0))}))
    show(os, "get_certificate's:", run(os, tls.ServerConfig{certificates: [], max_version: v, get_certificate: Some(fn(h: tls.ClientHelloInfo) -> tls.TlsCert? ! Str { Ok(Some(stapled)) })}, 1, cc))
  }
  os.stdio.println("done")
}
