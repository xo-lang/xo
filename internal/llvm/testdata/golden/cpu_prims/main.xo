// The CPU instructions of std/native/llrt/cpu.xo (decision 0231 and its
// addendum's add with carry in) against a plain reference (std/rt
// cryptoCPU): the instructions on arm64 and LLVM (on a CPU that has
// them) and the constant time bodies (the `_soft` lines) on every
// backend.
use std/crypto
use std/internal

fn main(os: Os) {
  var seed = crypto.sha256(b"cpu_prims")
  let ones = Bytes.from_hex("ffffffffffffffffffffffffffffffff") ?? b""
  let zeros = Bytes.from_hex("00000000000000000000000000000000") ?? b""
  var inputs = [zeros, ones]
  for _ in 0..6 {
    seed = crypto.sha256(seed)
    inputs.push(seed[0..16])
    inputs.push(seed[16..32])
  }
  // AES-GCM over every tail length of the record path (Gcm.ctr's last
  // word, ghash_hw's last block), against Go's crypto/cipher on the Go
  // backend
  var msg = b""
  for _ in 0..7 {
    msg = msg + inputs[2] + inputs[3]
  }
  let key = inputs[4]
  let nonce = inputs[5][0..12]
  for n in [0, 1, 7, 8, 9, 15, 16, 17, 23, 24, 25, 31, 32, 33, 47, 63, 64, 65, 100, 127, 128, 129, 191, 192, 200, 224] {
    let sealed = internal.crypto_op("aes.seal", key, nonce, msg[0..n], msg[0..(n % 21)])
    let opened = internal.crypto_op("aes.open", key, nonce, sealed, msg[0..(n % 21)])
    os.stdio.println("gcm ${n} ${sealed.to_hex()} ${opened.to_hex()}")
  }
  // add with carry in (decision 0231's addendum): the sum and carry of
  // a + b + cin for cin 0 and 1, on the edge words and the inputs
  let edges = ["0000000000000000", "0100000000000000", "ffffffffffffff7f", "0000000000000080", "ffffffffffffffff", "feffffffffffffff"]
  for x in edges {
    for y in edges {
      let a = Bytes.from_hex(x) ?? b""
      let b = Bytes.from_hex(y) ?? b""
      let r = internal.crypto_op("cpu.adc", a, b, b"", b"")
      let rs = internal.crypto_op("cpu.adc_soft", a, b, b"", b"")
      os.stdio.println("adc ${x} ${y} ${r.to_hex()} ${rs.to_hex()}")
    }
  }
  // the signed high word of a product (cpu.mul_hi_signed, 2026-10-21:
  // smulh, imulq's high half, an i128 multiply) on the edge words
  for x in edges {
    for y in edges {
      let a = Bytes.from_hex(x) ?? b""
      let b = Bytes.from_hex(y) ?? b""
      let h = internal.crypto_op("cpu.mul_hi_signed", a, b, b"", b"")
      let hs = internal.crypto_op("cpu.mul_hi_signed_soft", a, b, b"", b"")
      os.stdio.println("mulhs ${x} ${y} ${h.to_hex()} ${hs.to_hex()}")
    }
  }
  for (i, a) in inputs.indexed() {
    let b = inputs[(i + 7) % inputs.len()]
    os.stdio.println("adc ${i} ${internal.crypto_op("cpu.adc", a, b, b"", b"").to_hex()} ${internal.crypto_op("cpu.adc_soft", a, b, b"", b"").to_hex()}")
  }
  // GHASH of 64 bytes (cpu.ghash4, decision 0339): the state a, the H
  // powers (p0, p1 a block), four blocks; NEON on arm64, the body
  // elsewhere
  for (i, a) in inputs.indexed() {
    var hk = b""
    for j in 1..5 {
      hk = hk + inputs[(i + j) % inputs.len()]
    }
    var blk = b""
    for j in 7..11 {
      blk = blk + inputs[(i + j) % inputs.len()]
    }
    let g = internal.crypto_op("cpu.ghash4", a, hk, blk, b"")
    let gs = internal.crypto_op("cpu.ghash4_soft", a, hk, blk, b"")
    os.stdio.println("ghash4 ${i} ${g.to_hex()} ${gs.to_hex()}")
  }
  for (i, a) in inputs.indexed() {
    let b = inputs[(i + 3) % inputs.len()]
    let c = inputs[(i + 5) % inputs.len()]
    for sfx in ["", "_soft"] {
      let k = internal.crypto_op("cpu.carry${sfx}", a, b, b"", b"")
      let m = internal.crypto_op("cpu.clmul${sfx}", a, b, b"", b"")
      let r = internal.crypto_op("cpu.aes_round${sfx}", a, b, b"", b"")
      let l = internal.crypto_op("cpu.aes_last${sfx}", a, b, c, b"")
      // eleven round keys from the inputs after a
      var ks = b""
      for j in 1..12 {
        ks = ks + inputs[(i + j) % inputs.len()]
      }
      let e = internal.crypto_op("cpu.aes_enc${sfx}", a, ks, b"", b"")
      os.stdio.println("${i}${sfx} carry ${k.to_hex()} clmul ${m.to_hex()} round ${r.to_hex()} last ${l.to_hex()} enc ${e.to_hex()}")
    }
  }
  // the GHASH loop (cpu.ghash_blocks): several 64 byte steps with the
  // state and H powers in registers on arm64 and LLVM, against the
  // portable body
  for (i, a) in inputs.indexed() {
    var hk = b""
    for j in 1..5 {
      hk = hk + inputs[(i + j) % inputs.len()]
    }
    for nb in [0, 1, 2, 4, 16] {
      var data = b""
      for j in 0..4 * nb {
        data = data + inputs[(i + 5 + j) % inputs.len()]
      }
      let g = internal.crypto_op("cpu.ghash_blocks", a, hk, data, b"")
      let gs = internal.crypto_op("cpu.ghash_blocks_soft", a, hk, data, b"")
      os.stdio.println("ghashn ${i} ${64 * nb} ${g.to_hex()} ${if g == gs { "same" } else { "soft ${gs.to_hex()}" }}")
    }
  }
  // AES-CTR runs (cpu.aes_ctr10, 12, 14): one loop with the keys, the
  // counter and four states in registers on arm64 and LLVM, against the
  // portable body; a counter that wraps (inc32) in the last runs
  for i in 0..inputs.len() {
    for nk in [11, 13, 15] {
      var ks = b""
      for j in 0..nk {
        ks = ks + inputs[(i + 2 + j) % inputs.len()]
      }
      let iv = if i % 3 == 0 { inputs[(i + 1) % inputs.len()][0..12] + (Bytes.from_hex("fffffffe") ?? b"") } else { inputs[(i + 1) % inputs.len()] }
      for nb in [0, 1, 2, 8] {
        var data = b""
        for j in 0..4 * nb {
          data = data + inputs[(i + j) % inputs.len()]
        }
        let e = internal.crypto_op("cpu.aes_ctr", data, ks, iv, b"")
        let es = internal.crypto_op("cpu.aes_ctr_soft", data, ks, iv, b"")
        os.stdio.println("ctr ${i} ${nk} ${64 * nb} ${internal.crypto_op("hash.sha256", e, b"", b"", b"").to_hex()} ${if e == es { "same" } else { "soft differs" }}")
      }
    }
  }
  // AES-GCM's bulk (cpu.aes_gcm_enc and aes_gcm_dec): the AES rounds and
  // GHASH products interleaved on arm64 and LLVM, apart and in place,
  // against the portable body
  for i in 0..inputs.len() {
    for nk in [11, 15] {
      var ks = b""
      for j in 0..nk {
        ks = ks + inputs[(i + 3 + j) % inputs.len()]
      }
      let iv = inputs[(i + 1) % inputs.len()]
      var d = inputs[(i + 2) % inputs.len()]
      for j in 0..4 {
        d = d + inputs[(i + 5 + j) % inputs.len()]
      }
      for nb in [0, 1, 2, 8] {
        var data = b""
        for j in 0..4 * nb {
          data = data + inputs[(i + j) % inputs.len()]
        }
        for op in ["aes_gcm_enc", "aes_gcm_dec", "aes_gcm_enc_ip", "aes_gcm_dec_ip"] {
          let e = internal.crypto_op("cpu.${op}", data, ks, iv, d)
          let es = internal.crypto_op("cpu.${op}_soft", data, ks, iv, d)
          os.stdio.println("${op} ${i} ${nk} ${64 * nb} ${internal.crypto_op("hash.sha256", e, b"", b"", b"").to_hex()} ${if e == es { "same" } else { "soft differs" }}")
        }
      }
    }
  }
  // four blocks at once (cpu.aes_enc10x4, 12x4, 14x4): the four states
  // side by side on arm64 and LLVM, against the portable body; 11, 13
  // and 15 round keys from the inputs
  for (i, a) in inputs.indexed() {
    let blocks = a + inputs[(i + 1) % inputs.len()] + inputs[(i + 2) % inputs.len()] + inputs[(i + 3) % inputs.len()]
    for nk in [11, 13, 15] {
      var ks = b""
      for j in 0..nk {
        ks = ks + inputs[(i + 4 + j) % inputs.len()]
      }
      let e = internal.crypto_op("cpu.aes_enc4", blocks, ks, b"", b"")
      let es = internal.crypto_op("cpu.aes_enc4_soft", blocks, ks, b"", b"")
      os.stdio.println("enc4 ${i} ${nk} ${e.to_hex()} ${if e == es { "same" } else { "soft ${es.to_hex()}" }}")
    }
  }
}
