// A close does not lose or wait on what is still queued (decision 0447,
// 2026-11-03): the server writes 1 MB to a client in the same program and
// closes; the client, reading all along, gets all of it and then the end
// of the stream, and only then waits for the server's word that it closed.
// On wasm a close used a blocking flush, which stopped every task, the
// reader too, so a program like this hung. Until 2026-11-04 the client read
// only after that word, so the server's write waited for room the unread
// client never made whenever the kernel's buffers had not grown to take
// 1 MB (tier 48; gotchas/unread-socket-write-needs-buffer-room.md).

fn main(os: Os) {
  let n = 1 << 20
  let wrote: Chan[()] = Chan[()].new(cap: 1)
  match os.net.listen("127.0.0.1:0") {
    Ok(l) => {
      let addr = l.addr()
      scope s {
        s.spawn(fn() {
          match l.accept() {
            Ok(c) => {
              let b = "x".bytes().repeat(n)
              match c.write(b) {
                Ok(_) => ()
                Err(e) => os.stdio.println("write: ${e}")
              }
              c.close()
              wrote.send(())
            }
            Err(e) => os.stdio.println("accept: ${e}")
          }
        })
        match os.net.dial(addr) {
          Ok(c) => {
            var got = 0
            var bad = 0
            while {
              match c.read(65536) {
                Ok(Some(b)) => {
                  for x in b {
                    if x != 120 {
                      bad = bad + 1
                    }
                  }
                  got = got + b.len()
                }
                Ok(None) => break
                Err(e) => {
                  os.stdio.println("read: ${e}")
                  break
                }
              }
            }
            // the end of the stream came after the server's close
            let _ = wrote.recv()
            os.stdio.println("read ${got} of ${n} bytes, ${bad} wrong, then the end")
            c.close()
          }
          Err(e) => os.stdio.println("dial: ${e}")
        }
      }
      l.close()
    }
    Err(e) => os.stdio.println("listen: ${e}")
  }
}
