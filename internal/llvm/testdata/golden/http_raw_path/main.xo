// The client sends a request's path as the caller wrote it (the aws-19 report,
// 2026-11-04): Go's url.Parse keeps RawPath when the default escaping of the
// decoded path differs, and EscapedPath returns it when it is a valid
// encoding of Path, so `%2B`, `%2F`, `%20`, `+` and UTF-8 escapes reach the
// server unchanged (SigV4 signs these bytes). The handler echoes what it saw.
use std/http

const PORT = 18737

fn main(os: Os) ! {
  var r = http.router()
  r.handle("GET /{rest...}", fn(req) -> http.Response {
    http.text(200, "${req.escaped_path()} | ${req.path} | ${req.raw_query()}")
  })
  let srv = http.server(os.net.listen("127.0.0.1:${PORT}")?, r)
  let client = http.client(os.net, timeout: 5s)
  scope s {
    s.spawn_background(fn() { srv.serve() })
    os.clock.sleep(100ms)
    for p in ["/bucket/a%20b%2Bc/%E1%88%B4//x", "/a+b", "/a%2Fb/c", "/plain/path", "/a%2fb", "/caf%C3%A9?x=a%20b&y=%2B", "/!*'()", "/a%25b", "/%7Euser", "/a b"] {
      let resp = client.send(http.new_request("GET", "http://127.0.0.1:${PORT}${p}"))?
      os.stdio.println("${p} => ${resp.status} ${resp.body.to_str() ?? ""}")
    }
  }
}
