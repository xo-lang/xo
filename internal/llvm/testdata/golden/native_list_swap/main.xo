// The element swap of decision 0374 (rt.list_swap, std/native/rt.xo):
// two strings and two ints swapped, and the identity swap i == j, through
// internal.crypto_op so every backend runs its own lowering (arm64,
// LLVM, WebAssembly) and the Go backend runs std/rt's answer. The strings
// move as references with no count either way, so a miscount shows as the
// wasm run's leak check at exit. Output: the strings' order, the ints',
// and the mismatches.
use std/internal

fn main(os: Os) uses stdio {
  os.stdio.println("${internal.crypto_op("rt.list_swap", b"", b"", b"", b"").to_str() ?? ""}")
}
