fn show(r: Result[http.Response, http.ClientErr], addr: Str) -> Str {
  match r {
    Ok(resp) => {
      let ks = resp.headers.keys().sort()
      var parts: List[Str] = []
      for k in ks {
        parts.push("${k.quote()}=${(resp.headers.get(k) ?? "").quote()}")
      }
      "${resp.status} [${parts.join(" ")}] body=${(resp.body.to_str() ?? "?").quote()}"
    }
    Err(e) => "err ${e}".replace(addr, "ADDR")
  }
}

fn main(os: Os) ! {
  let l = os.net.listen("127.0.0.1:0")?
  let addr = l.addr()
  let c = http.client(os.net, timeout: 5s)
  scope s {
    s.spawn_background(fn() {
      for raw in CASES {
        match l.accept() {
          Ok(conn) => {
            // read the request head, then answer and close
            var got = b""
            while !((got.to_str() ?? "").contains("\r\n\r\n")) {
              match conn.read(4096) {
                Ok(Some(b)) => got = got + b
                _ => break
              }
            }
            conn.write(raw).ignore_err("the client may have gone")
            conn.close()
          }
          Err(_) => return
        }
      }
    })
    for (i, _) in CASES.indexed() {
      os.stdio.println("${i} ${show(c.get("http://${addr}/x"), addr)}")
    }
  }
}
