const TICKET_MSG: Str = ""
const CLIENT_DATA: Str = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
const CLIENT_DATA_RECORD: Str = "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
const SERVER_DATA: Str = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
const SERVER_DATA_RECORD: Str = "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"
const CLIENT_ALERT: Str = "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
const SERVER_ALERT: Str = "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9"
const CERT: Str = ""
const RSA_KEY: Str = ""
const EE: Str = "000a00140012001d00170018001901000101010201030104001c0002400100000000"
const SERVER_RANDOM: Str = "a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e26928"
const SERVER_KEY: Str = "b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e"
