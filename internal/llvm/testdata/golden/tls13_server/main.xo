// The TLS 1.3 server of the native backends' TLS
// (std/native/llrt/tls13srv.xo, the zero-C audit's B31) through
// internal.crypto_op, against std/rt's internal_tls13srv.go (the server
// written out in Go with Go's crypto) and Go's crypto/tls: RFC 8448's
// simple 1-RTT handshake (section 3) from the server's side, its
// ServerHello, encrypted flight, ticket, data and alert records equal
// to the RFC's with the trace's random, X25519 key, PSS salt and
// extensions, fed whole and a byte at a time; then the failures and
// choices: a corrupted client Finished, a HelloRetryRequest for P-256,
// AES-256-GCM and ChaCha20-Poly1305 chosen, no common suite or group, a
// low order client share, a truncated ClientHello, a TLS 1.2 only
// ClientHello; then Go's crypto/tls client's recorded flights (RSA with
// ALPN, a HelloRetryRequest to P-256, Ed25519 with ChaCha20-Poly1305 over
// P-384) and its session resumption (a ticket, the resumed handshake, a
// bad binder, an expired ticket, a ticket of another key); then
// tls13.xo's client against this server in memory, as
// Go's crypto/tls client against its server (RSA, P-256, P-384 and
// Ed25519 certificates, ALPN chosen, refused and the h2 fallback, P-256
// and a HelloRetryRequest to P-384, no common group).
use std/internal

const HELLO_RECORD: Str = ""
const SERVER_HELLO: Str = "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"
