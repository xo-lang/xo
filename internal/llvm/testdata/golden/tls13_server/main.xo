const ED_CERT: Str = ""
const ED_KEY: Str = "b3a78bec7cc5eda2aca004cfeacadc4c2181fde26c6f1fee789c173908093b68"

// Go 1.26's crypto/tls client (default settings but the ones named)
// against internal_tls13srv.go's server, recorded once: its flights as
// the server read them, the server's random, ECDHE key and PSS salt
// fixed; the client finished each handshake and read "hello from xo"
const GO_RANDOM: Str = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
const GO_KEY: Str = "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"
const GO_KEY_P384: Str = "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30"
const GO_SALT: Str = "c0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedf"
const RSA_F0: Str = ""
const RSA_F1: Str = "140303000101170303003552da7208b418bd21717053e9e2b4ccabe0780bc42fc1cf3cd33f144a04719859607704e7c094c0f0ce05c516a3fb634f8ae42fb88a170303001c6e09f37c005eec1a0c57a2077c6fadb1e5dc327ac3310c985590695d"
const RSA_F2: Str = "170303001399f7e124d0140412f83ebab0a7c56b15141612"
