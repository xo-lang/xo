// std/crypto's keys and signatures (decision 0285): PEM, PKCS #8, SEC 1,
// and PKIX keys (generated by Go), JWK public keys (RFC 7517, RFC 8037),
// RSA PKCS #1 v1.5 and Ed25519 signatures (deterministic, so the bytes
// are compared), PSS and hedged ECDSA (verified), and keys from Rand,
// the same on every backend.
use std/crypto

const KEYS: Str = "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDIjyOIEVG4P1C6\nBaJiFdZqYiL1Nclm+zXFXJwpg8YLPwdL0ieeit3CE77Rn5FMqZlNO/JTa8fUK1Su\ns+FP7iWrPQf3D0DW873jChMNIP0XTLPuFzQcIVpE2QA4jdDpxiZhddXU1B/dU5lD\nJdrxOL8crHay89QNWlqE+4R9Buc0/9VeUpInPy37XynPepROCVPUy3B3xftQxBkP\ncguftIIA3jZj/OiyTPq6Mk/gAOL6L/7YEEDZOWHwxUjDjTCl1/dCuXSAyAU7UamL\nGlQOlPxEiHaG4PQUocb6fQtjcCTgXJyThzri7179RGTKyxTMZhKftvhft07sS/Bk\nVGQ7t7kbAgMBAAECggEASwLaP7h2j4pCx6h20Oeo/7X/rCW3U6huNohKMe7Cog8r\nS+zoe5Alm8Jl0qIzJnCiUTQ0EIZVwWGJdSP7B7mi5hZYBcvzLNIR+boZYQYvEslR\n3KFaEJFa4TgmMIC+G8lMLpRzavwBhPaQ8n/UkPbv56oLZSfz7iCWjXlC1r4/uF6z\nDC7Ol7rI2utj12JMrGvNV06cAp5CzcEB5QtZGR2z7bQ97j1G/VpgiTaYQOjz5hvw\nindmBkk7qf7DfASXHnB2ND1511gk4hTTdcPV8M1KTuMfUmQ0nEVa8e4J5paD/Nsy\nV6MIPOGLzLKFLzZr9s9oMQFFE8sL65aPru9zS4fwJQKBgQD3K9Ve53OZ978erifu\nTSt6YE2DQyIR/mxmwAEercGfgHtnWT9514rL3LvukRtkpQ0BpvBTOujFFN9sYpf5\nB+xbtk0WjYjZ951Ve6UeauDUXXR8uvBZjDuLCEy1RbI9hrYhfp0K37V6wgtIp4LU\nlBoFlomrfHI5tAsrR6SjKpaDvwKBgQDPuRQD19i7Ss3hOxuY3MhWTWp4nwlXAqqq\n/mMnT+05Pupdwq3LvNEWgjC1QJ4EJuGs6MTPFqTFiUk3L+K20fkIL4rQ25imx2xE\n3ldrvlrHjzUfgpM9IbVUg0SFdox17cmEwocrJtu902/b54EjTZVc9HDOBd1URkI6\ns7OG/NLxpQKBgQCMWgmZEFhmT3XpF/94o71Siii5pn9MNGqdld2M7CGMTsrEDruq\nligsRrU4bJFffxF5pK/GsybF8mpEA2BEeqlOEqCHc+sHykE+7yz9rrboIAEraoNc\ndfLBqf7U2DS0FzCIqHrIV+uXP2Rk5ym1SDvWfHrEM7Aw7/l/o/jq5h39xQKBgFUe\nSwRUI3yD559eoC1gcztiF7n7uVENR7Av86N9TgECNflbt+nfonItwRXUt6uN3zYC\nX/tYFQbY/cZ+edFec0SWbrSs932IBGaoEXyWEQ7rMOKLmBgZwvsxmxdxf5cnbEdZ\nixf0oWDEznZ3A+TaetUPWVYi8xIAhE0Xq/4phar9AoGBAKBGDdbWUzxcElb360sp\n31wEF86qskZrq896Se5GXNZO6mGBkK2dtH17VUb3D/LdroLg0gVenLceMSKUEMg+\n6HlzTfnguBq+ZI3mwyDPE48lYRWbGH4OPc4H8IxjNTZK8HgqzeGgFMA+zBAaGP9N\nallFtAOxeGnj0ZrJusFquq05\n-----END PRIVATE KEY-----\n-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg9n44dha9BfmzizkM\nMyONM4YJTuq6oUtvlwy+AITSSU2hRANCAARjBAUMthF1bLMPT2g1aht2KMs1bwg4\nhCdPvePmppTVB1hqX9AvTASbPEVNTG+yA5kDpgq0ky0CUDNkpN5aQclK\n-----END PRIVATE KEY-----\n-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEICGXYTbBXwBXaEhuhWoavlqWlVuXmpiv9x4R8Woz4E9r\n-----END PRIVATE KEY-----\n-----BEGIN EC PRIVATE KEY-----\nComment: SEC 1\n\nMHcCAQEEIPZ+OHYWvQX5s4s5DDMjjTOGCU7quqFLb5cMvgCE0klNoAoGCCqGSM49\nAwEHoUQDQgAEYwQFDLYRdWyzD09oNWobdijLNW8IOIQnT73j5qaU1QdYal/QL0wE\nmzxFTUxvsgOZA6YKtJMtAlAzZKTeWkHJSg==\n-----END EC PRIVATE KEY-----\n-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAyI8jiBFRuD9QugWiYhXW\namIi9TXJZvs1xVycKYPGCz8HS9InnordwhO+0Z+RTKmZTTvyU2vH1CtUrrPhT+4l\nqz0H9w9A1vO94woTDSD9F0yz7hc0HCFaRNkAOI3Q6cYmYXXV1NQf3VOZQyXa8Ti/\nHKx2svPUDVpahPuEfQbnNP/VXlKSJz8t+18pz3qUTglT1Mtwd8X7UMQZD3ILn7SC\nAN42Y/zoskz6ujJP4ADi+i/+2BBA2Tlh8MVIw40wpdf3Qrl0gMgFO1GpixpUDpT8\nRIh2huD0FKHG+n0LY3Ak4Fyck4c64u9e/URkyssUzGYSn7b4X7dO7EvwZFRkO7e5\nGwIDAQAB\n-----END PUBLIC KEY-----\n"

fn main(os: Os) ! {
  let blocks = crypto.pem_decode(KEYS)
  os.stdio.println("blocks ${blocks.map(fn(b) { b.kind }).join(", ")}")
  var privs: List[crypto.PrivateKey] = []
  for b in blocks {
    if b.kind.ends_with("PRIVATE KEY") {
      let k = crypto.parse_private_key(b.bytes).map_err(fn(e) { e.msg })?
      privs.push(k)
      os.stdio.println("${b.kind}: ${k.alg().debug()} ${k.debug()}")
    }
  }
  let rsa_pub = crypto.parse_public_key(blocks[4].bytes).map_err(fn(e) { e.msg })?
  os.stdio.println("public ${rsa_pub.alg().debug()} same as the private key's: ${rsa_pub == privs[0].public_key()}; EC PKCS #8 and SEC 1 the same key: ${privs[1].public_key() == privs[3].public_key()}")
  os.stdio.println("pem round trip: ${crypto.pem_decode(crypto.pem_encode(blocks[3]).map_err(fn(e) { e.msg })?) == [blocks[3]]}")
  let msg = b"the message"
  let rsig = crypto.sign(os.rand, privs[0], crypto.Hash.Sha256, msg).map_err(fn(e) { e.msg })?
  let esig = crypto.sign(os.rand, privs[2], crypto.Hash.Sha256, msg).map_err(fn(e) { e.msg })?
  os.stdio.println("rsa ${rsig.len()} ${crypto.digest(crypto.Hash.Sha256, rsig).to_hex()} ${crypto.verify(rsa_pub, crypto.Hash.Sha256, msg, rsig)} ${crypto.verify(rsa_pub, crypto.Hash.Sha256, b"other", rsig)}")
  os.stdio.println("ed25519 ${esig.to_hex()} ${crypto.verify(privs[2].public_key(), crypto.Hash.Sha256, msg, esig)}")
  for h in [crypto.Hash.Sha256, crypto.Hash.Sha384, crypto.Hash.Sha512] {
    let p = crypto.sign_pss(os.rand, privs[0], h, msg).map_err(fn(e) { e.msg })?
    let s = crypto.sign(os.rand, privs[1], h, msg).map_err(fn(e) { e.msg })?
    let raw = crypto.sign_raw_ecdsa(os.rand, privs[1], h, msg).map_err(fn(e) { e.msg })?
    os.stdio.println("${h.debug()}: pss ${crypto.verify_pss(rsa_pub, h, msg, p)} ecdsa ${crypto.verify(privs[1].public_key(), h, msg, s)} raw ${raw.len()} ${crypto.verify_raw_ecdsa(privs[1].public_key(), h, msg, raw)} wrong kind ${crypto.verify_pss(privs[1].public_key(), h, msg, p)}")
  }
  let ed = crypto.jwk_public_key("{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}").map_err(fn(e) { e.msg })?
  os.stdio.println("jwk ${ed.alg().debug()} ${crypto.marshal_public_key(ed).to_hex()}")
  for j in ["{\"kty\":\"oct\"}", "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"AA\",\"y\":\"AA\"}", "nope"] {
    os.stdio.println("jwk error: ${crypto.jwk_public_key(j).map_err(fn(e) { e.msg }).err() ?? "-"}")
  }
  for der in [b"", b"\x30\x00", blocks[4].bytes[0..20]] {
    os.stdio.println("bad key: ${crypto.parse_public_key(der).map_err(fn(e) { e.msg }).err() ?? "-"} / ${crypto.parse_private_key(der).map_err(fn(e) { e.msg }).err() ?? "-"}")
  }
  for a in [crypto.KeyAlg.EcdsaP256, crypto.KeyAlg.EcdsaP521, crypto.KeyAlg.Ed25519] {
    let k = crypto.generate_key(os.rand, a).map_err(fn(e) { e.msg })?
    let s = crypto.sign(os.rand, k, crypto.Hash.Sha256, msg).map_err(fn(e) { e.msg })?
    os.stdio.println("generated ${a.debug()}: ${crypto.verify(k.public_key(), crypto.Hash.Sha256, msg, s)}")
  }
  os.stdio.println("rsa generation: ${crypto.generate_key(os.rand, crypto.KeyAlg.Rsa).map_err(fn(e) { e.msg }).err() ?? "-"}")
}
