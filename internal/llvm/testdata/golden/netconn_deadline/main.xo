// Decision 0481: NetConn, Go's net.Conn, is the interface with the
// deadline setters that Conn, ServerConn and TlsConn satisfy, beside
// Stream. The queueworker shape: one code path talks to a server over
// plain TCP or TLS, chosen at run time with the type written on the `if`
// (core 2.10: without it the arms do not join), and sets its deadlines
// through the interface; a NetConn is also passed where a Stream is
// expected. Every backend must agree. The certificates are golden
// tls_client's.
use std/http
use std/tls

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello") })
  r
}

fn show(r: Result[Bytes?, NetErr]) -> Str {
  match r {
    Ok(Some(b)) => "data ${(b.to_str() ?? "?").split("\r\n")[0]}"
    Ok(None) => "end"
    Err(e) => "err ${e}"
  }
}

/// A Stream's first answer to a request (no deadlines here).
fn ask(s: Stream) -> Str uses net {
  s.write("GET /hello HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n".bytes()) ?? e => return "write ${e}"
  show(s.read(4096))
}

/// The worker: a read that times out through the interface, then a
/// request with the deadline cleared.
fn work(c: NetConn, clock: Clock) -> Str uses clock, net {
  c.set_read_deadline(clock, Some(clock.now() + 50ms))
  let first = show(c.read(64))
  c.set_deadline(clock, None)
  let answer = ask(c)
  c.set_write_deadline(clock, Some(clock.now() - 1s))
  let late = match c.write("x".bytes()) {
    Ok(_) => "write ok"
    Err(e) => "write ${e}"
  }
  c.close()
  "${first}; ${answer}; ${late}"
}

fn main(os: Os) {
  let clock = os.clock
  let ca = tls.roots(ca_pem()).or_fault("roots")
  let good = http.tls_cert(good_cert(), good_key()).or_fault("good")
  let lt = os.net.listen("127.0.0.1:0").or_fault("listen")
  let lp = os.net.listen("127.0.0.1:0").or_fault("listen")
  let st = http.server(lt, routes()).with_tls([good])
  let sp = http.server(lp, routes())
  scope s {
    s.spawn_background(fn() { st.serve().ignore_err("test") })
    s.spawn_background(fn() { sp.serve().ignore_err("test") })
    for use_tls in [false, true] {
      let addr = if use_tls { lt.addr() } else { lp.addr() }
      let raw = os.net.dial(addr).or_fault("dial")
      let c: NetConn = if use_tls { tls.client(raw, "localhost", roots: Some(ca)).or_fault("client") } else { raw }
      os.stdio.println("tls=${use_tls}: ${work(c, clock)}")
    }
  }
  os.stdio.println("done")
}

