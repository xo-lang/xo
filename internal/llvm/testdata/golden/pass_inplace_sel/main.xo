// pass hunt: inplace_elems (16+ word elements read where they lie, with
// writes and pushes to the same list near the reads), select_compares
// (lexicographic and chained compares), devirtualize (tiny tail wrappers).
struct Big {
  a: Int = 0
  b: Int = 0
  c: Int = 0
  d: Int = 0
  e: Int = 0
  f: Int = 0
  g: Int = 0
  h: Int = 0
  i: Int = 0
  j: Int = 0
  k: Int = 0
  l: Int = 0
  m: Int = 0
  n: Int = 0
  name: Str = ""
  tags: List[Int] = []
}

fn mk(x: Int) -> Big {
  Big{a: x, b: x * 3 % 7, c: x % 5, d: 100 - x, n: x * x, name: "b${x}", tags: [x, x + 1]}
}

// lexicographic: the first differing field decides
fn less(x: Big, y: Big) -> Bool {
  if x.c != y.c {
    return x.c < y.c
  }
  if x.b != y.b {
    return x.b > y.b
  }
  x.a < y.a
}

fn same_order(p: Int, q: Int, r: Int, s: Int) -> Bool { (p < q) == (r < s) }

fn pick(p: Int, q: Int, r: Int) -> Int {
  if p < q && q < r || r < q && q < p {
    return q
  }
  if (p < r) != (q < r) {
    return r
  }
  p
}

fn wrap1(f: fn(Int) -> Int, x: Int) -> Int { f(x) }
fn wrap2(f: fn(Int) -> Int, x: Int) -> Int { wrap1(f, x) }

fn sum_fields(var bs: List[Big]) -> Int {
  var t = 0
  for (i, x) in bs.indexed() {
    t += x.a + x.n
    if i % 4 == 0 && bs.len() < 40 {
      // grows the list while x (an element) is still read below
      bs.push(mk(t % 50))
    }
    t += x.d + x.tags.len() + x.name.len()
  }
  t
}

fn overwrite(var bs: List[Big]) -> Int {
  var t = 0
  for i in 0..bs.len() {
    let x = bs[i]
    bs[i] = mk(i + 1000)
    // x must be the old element
    t += x.a * 2 + x.c + bs[i].a
    let y = bs[(i + 1) % bs.len()]
    bs[(i + 1) % bs.len()].b = y.b + 1
    t += y.b
  }
  t
}

fn sort_ins(var bs: List[Big]) {
  for i in 1..bs.len() {
    var j = i
    while j > 0 && less(bs[j], bs[j - 1]) {
      let tmp = bs[j]
      bs[j] = bs[j - 1]
      bs[j - 1] = tmp
      j -= 1
    }
  }
}

// a lexicographic compare as a loop's branch (select_compares: the
// first compare's equality picks which compare decides)
fn count_less(xs: List[Int], ys: List[Int]) -> Int {
  var c = 0
  for i in 0..xs.len() - 1 {
    let a = xs[i]
    let b = ys[i]
    let a2 = xs[i + 1]
    let b2 = ys[i + 1]
    if (if a == b { a2 < b2 } else { a < b }) {
      c += 1
    }
    if (if a != a2 { a > a2 } else { b >= b2 }) {
      c += 10
    }
  }
  c
}

fn main(os: Os) {
  var xs: List[Int] = []
  var ys: List[Int] = []
  for i in 0..300 {
    xs.push(i * 7 % 5)
    ys.push(i * 3 % 4)
  }
  os.stdio.println("cl ${count_less(xs, ys)}")
  var bs: List[Big] = []
  for x in 0..20 {
    bs.push(mk(x * 7 % 23))
  }
  os.stdio.println("sum ${sum_fields(bs)} len ${bs.len()}")
  os.stdio.println("over ${overwrite(bs)}")
  sort_ins(bs)
  var line = ""
  for x in bs {
    line = line + "${x.c}/${x.b}/${x.a} "
  }
  os.stdio.println(line)
  var s = 0
  for p in 0..6 {
    for q in 0..6 {
      for r in 0..6 {
        s = s * 3 % 1000003 + pick(p, q, r)
        if same_order(p, q, r, p + q - 3) {
          s += 1
        }
      }
    }
  }
  let k = 5
  os.stdio.println("s ${s} w ${wrap2(fn(x: Int) -> Int { x * k + 1 }, 9)} ${wrap2(fn(x: Int) -> Int { x - k }, 2)}")
}
