// RSA encryption (decision 0618): ciphertexts from Go's crypto/rsa
// EncryptOAEP (SHA-1, SHA-256 with labels, SHA-512) and EncryptPKCS1v15
// under a 2048-bit key, each also changed (a flipped byte, one byte short,
// a leading or trailing extra byte, a wrong label), and ciphertexts at and
// above the modulus, decrypt to exactly Go's DecryptOAEP and
// DecryptPKCS1v15 outcome: the message or the one error text. Then Go's
// encryption limits and round trips with Rand. Written by oaepgen (Xo Lang
// 3, 2026-11-12).
use std/crypto

fn hash_named(n: Str) -> crypto.Hash {
  match n {
    "Sha1" => crypto.Hash.Sha1
    "Sha512" => crypto.Hash.Sha512
    _ => crypto.Hash.Sha256
  }
}

fn hb(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

fn main(os: Os) ! {
  let k = crypto.parse_private_key(hb(KEY)).map_err(fn(e) { e.msg })?
  let pk = k.public_key()
  var ok = 0
  var errs = 0
  var bad = 0
  for (scheme, h, label, c, want) in CASES {
    let got = if scheme == "oaep" {
      crypto.decrypt_oaep(k, hash_named(h), hb(c), label.bytes())
    } else {
      crypto.decrypt_pkcs1v15(k, hb(c))
    }
    let g = match got {
      Ok(m) => "ok:${m.to_hex()}"
      Err(e) => "err:${e.msg}"
    }
    if g != want {
      bad += 1
      os.stdio.println("mismatch ${scheme} ${h} ${label} ${c.len() / 2}: got ${g} want ${want}")
    } else if g.starts_with("ok:") {
      ok += 1
    } else {
      errs += 1
    }
  }
  os.stdio.println("go ciphertexts: ${ok} decrypted, ${errs} refused as Go refuses, ${bad} mismatches")
  for (scheme, h, n, want) in LIMITS {
    let msg = b"\x07".repeat(n)
    let got = if scheme == "oaep" {
      crypto.encrypt_oaep(os.rand, pk, hash_named(h), msg)
    } else {
      crypto.encrypt_pkcs1v15(os.rand, pk, msg)
    }
    let g = match got {
      Ok(c) => if c.len() == 256 { "ok" } else { "bad length ${c.len()}" }
      Err(e) => "err:${e.msg}"
    }
    os.stdio.println("limit ${scheme} ${h} ${n}: ${if g == want { "as Go" } else { "got ${g} want ${want}" }}")
  }
  for h in [crypto.Hash.Sha1, crypto.Hash.Sha256, crypto.Hash.Sha384, crypto.Hash.Sha512] {
    let msg = "a key to wrap ${h.debug()}".bytes()
    let c = crypto.encrypt_oaep(os.rand, pk, h, msg, "ctx".bytes()).map_err(fn(e) { e.msg })?
    let c2 = crypto.encrypt_oaep(os.rand, pk, h, msg, "ctx".bytes()).map_err(fn(e) { e.msg })?
    let m = crypto.decrypt_oaep(k, h, c, "ctx".bytes()).map_err(fn(e) { e.msg })?
    let wrong = crypto.decrypt_oaep(k, h, c, "other".bytes()).map_err(fn(e) { e.msg }).err() ?? "-"
    os.stdio.println("oaep round trip ${h.debug()}: ${m == msg}, randomized ${c != c2}, wrong label: ${wrong}")
  }
  let c = crypto.encrypt_pkcs1v15(os.rand, pk, "legacy".bytes()).map_err(fn(e) { e.msg })?
  let m = crypto.decrypt_pkcs1v15(k, c).map_err(fn(e) { e.msg })?
  os.stdio.println("pkcs1v15 round trip: ${m.to_str() ?? "-"}")
  let ek = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256).map_err(fn(e) { e.msg })?
  os.stdio.println("ecdsa key: ${crypto.encrypt_oaep(os.rand, ek.public_key(), crypto.Hash.Sha256, b"x").map_err(fn(e) { e.msg }).err() ?? "-"} / ${crypto.decrypt_oaep(ek, crypto.Hash.Sha256, c).map_err(fn(e) { e.msg }).err() ?? "-"}")
}

