use std/http

// Two request smuggling guards (std/changes/http.md, 2026-11-13).
// A server: a request with both Transfer-Encoding: chunked and
// Content-Length is framed by chunked alone, and the connection closes
// after the answer (RFC 9112 6.3), so a request pipelined after it is not
// read. Go's net/http keeps the connection open (want_go.txt).
// A server: a 2xx answer to CONNECT closes the connection after it, as
// Go's fix for GO-2026-6613 (Go 1.26.11 and later, every backend).
// A client: a CR or LF in with_host or User-Agent never reaches the wire
// (GO-2023-1878): an invalid Host fails before connecting (Go's HTTP/1
// sends an empty Host instead, want_go.txt), and User-Agent's newlines
// become spaces, as every other field's do (Go's Transport rejects the
// value, want_go.txt).

fn read_to_close(os: Os, c: Conn) -> Str {
  c.set_read_deadline(os.clock, Some(os.clock.now() + 5s))
  var got = b""
  while true {
    match c.read(4096) {
      Ok(Some(b)) => got = got + b
      _ => break
    }
  }
  got.to_str_lossy()
}

fn main(os: Os) ! {
  var r = http.router()
  r.handle("POST /echo", fn(req) { http.text(200, "echo [${req.body.to_str_lossy()}]") })
  r.handle("GET /next", fn(_req) { http.text(200, "next") })
  r.wrap(fn(q: http.Request, next: http.Next) -> http.Response { if q.method == "CONNECT" && !q.path.starts_with("/proxy/") { http.text(200, "tunnel") } else { next(q) } })
  let raw = os.net.listen("127.0.0.1:0")?
  // a ReverseProxy forwards only the query its parse and rewrite hook
  // saw (GO-2022-1038, GO-2026-4976)
  let p = http.reverse_proxy(http.client(os.net, 5s), http.parse_url("http://${raw.addr()}/").or_fault("url"))
  let hook_saw: Chan[Str] = Chan.new(4)
  let rp = p.with_rewrite(fn(inq: http.Request, out: http.Request) -> http.Request {
    var keys: List[Str] = []
    for (k, v) in inq.url.query {
      keys.push("${k}=${v}")
    }
    hook_saw.send(keys.sort().join("&"))
    out
  })
  r.handle_stream("/proxy/{rest...}", fn(req, body) { rp.serve(req, body) })
  let srv = http.server(os.net.listen("127.0.0.1:0")?, r)
  let seen: Chan[Str] = Chan.new(4)
  scope s {
    s.spawn_background(fn() { srv.serve().or_fault("serve") })
    s.spawn_background(fn() {
      while true {
        let c = match raw.accept() {
          Ok(c) => c
          Err(_) => return
        }
        var buf = b""
        while !buf.to_str_lossy().contains("\r\n\r\n") {
          match c.read(4096) {
            Ok(Some(b)) => buf = buf + b
            _ => break
          }
        }
        c.write(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").ignore_err("probe answer")
        c.close()
        seen.send(buf.to_str_lossy())
      }
    })

    let c = os.net.dial(srv.addr())?
    c.write(b"POST /echo HTTP/1.1\r\nHost: s\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\nGET /next HTTP/1.1\r\nHost: s\r\n\r\n")?
    let text = read_to_close(os, c)
    c.close()
    let first = text.split("\r\n").first() ?? ""
    os.stdio.println("CL with TE: ${first}")
    os.stdio.println("CL with TE: body ${if text.contains("echo [abc]") { "echo [abc]" } else { "missing" }}")
    os.stdio.println("CL with TE: Connection: close ${text.contains("\r\nConnection: close\r\n")}")
    os.stdio.println("CL with TE: pipelined request answered ${text.contains("\r\n\r\nnext")}")

    // a 2xx answer to CONNECT makes the connection a tunnel: the server
    // closes it rather than read the GET after it (GO-2026-6613)
    let c2 = os.net.dial(srv.addr())?
    c2.write(b"CONNECT a.test:443 HTTP/1.1\r\nHost: a.test:443\r\n\r\nGET /next HTTP/1.1\r\nHost: s\r\n\r\n")?
    let t2 = read_to_close(os, c2)
    c2.close()
    os.stdio.println("CONNECT: ${t2.split("\r\n").first() ?? ""}, request after it answered ${t2.contains("\r\n\r\nnext")}")

    // a ReverseProxy refuses CONNECT (Go 1.26.11, GO-2026-6605)
    let c3 = os.net.dial(srv.addr())?
    c3.write(b"CONNECT /proxy/p HTTP/1.1\r\nHost: s\r\n\r\n")?
    let t3 = read_to_close(os, c3)
    c3.close()
    os.stdio.println("proxy CONNECT: ${t3.split("\r\n").first() ?? ""}")

    let cl = http.client(os.net, 5s)
    for q in ["a=1&b=%zz&c=1;d=2", "x=1&y=2"] {
      cl.send(http.new_request("GET", "http://${srv.addr()}/proxy/p?${q}")).ignore_err("proxy probe")
      let w = seen.recv() ?? ""
      let line = w.split("\r\n").first() ?? ""
      os.stdio.println("proxy ${q.quote()}: hook saw ${(hook_saw.recv() ?? "").quote()}, upstream got ${line.quote()}")
    }

    match cl.send(http.new_request("GET", "http://${raw.addr()}/a").with_host("h\r\nX-Injected: 1")) {
      Ok(_) => {
        let w = seen.recv() ?? ""
        os.stdio.println("bad Host: sent, injected field ${w.contains("\r\nX-Injected:")}")
      }
      Err(e) => os.stdio.println("bad Host: ${if "${e}".contains("invalid Host header") { "invalid Host header" } else { "${e}" }}")
    }
    match cl.send(http.new_request("GET", "http://${raw.addr()}/b", {"User-Agent": "ua\r\nX-Injected: 2"})) {
      Ok(_) => {
        let w = seen.recv() ?? ""
        let ua = w.split("\r\n").filter(fn(l) { l.starts_with("User-Agent:") }).first() ?? "none"
        os.stdio.println("User-Agent: ${ua.quote()}, injected field ${w.contains("\r\nX-Injected:")}")
      }
      Err(e) => os.stdio.println("User-Agent: ${if "${e}".contains("invalid header field value") { "invalid header field value" } else { "${e}" }}")
    }
  }
}
