// The dup and drop helpers of a value of 2,061 words (aws issue 13,
// 2026-11-05): their stores and loads reached past the 32,760 bytes a
// scaled offset does, and native failed as "reference counting of
// `Result[D, Str]` (too many words)"; offsets past it now go through a
// register, as do a list element's words. D holds 1,030 Strs (two words
// each), just past the 1,023 that reach it.
struct A {
  s0: Str
  s1: Str
  s2: Str
  s3: Str
  s4: Str
  s5: Str
  s6: Str
  s7: Str
  s8: Str
  s9: Str
}
fn mk_a(t: Str) -> A {
  A{s0: "${t}.0", s1: "${t}.1", s2: "${t}.2", s3: "${t}.3", s4: "${t}.4", s5: "${t}.5", s6: "${t}.6", s7: "${t}.7", s8: "${t}.8", s9: "${t}.9"}
}
struct B {
  a0: A
  a1: A
  a2: A
  a3: A
  a4: A
  a5: A
  a6: A
  a7: A
  a8: A
  a9: A
}
fn mk_b(t: Str) -> B {
  B{a0: mk_a("${t}.0"), a1: mk_a("${t}.1"), a2: mk_a("${t}.2"), a3: mk_a("${t}.3"), a4: mk_a("${t}.4"), a5: mk_a("${t}.5"), a6: mk_a("${t}.6"), a7: mk_a("${t}.7"), a8: mk_a("${t}.8"), a9: mk_a("${t}.9")}
}
struct C {
  b0: B
  b1: B
  b2: B
  b3: B
  b4: B
  b5: B
  b6: B
  b7: B
  b8: B
  b9: B
}
fn mk_c(t: Str) -> C {
  C{b0: mk_b("${t}.0"), b1: mk_b("${t}.1"), b2: mk_b("${t}.2"), b3: mk_b("${t}.3"), b4: mk_b("${t}.4"), b5: mk_b("${t}.5"), b6: mk_b("${t}.6"), b7: mk_b("${t}.7"), b8: mk_b("${t}.8"), b9: mk_b("${t}.9")}
}
struct D {
  c0: C
  a0: A
  a1: A
  a2: A
}
fn mk_d(t: Str) -> D {
  D{c0: mk_c("${t}.c0"), a0: mk_a("${t}.0"), a1: mk_a("${t}.1"), a2: mk_a("${t}.2")}
}

fn make(ok: Bool, t: Str) -> Result[D, Str] {
  if ok {
    return Ok(mk_d(t))
  }
  Err("no ${t}")
}

fn line(r: Result[D, Str]) -> Str {
  match r {
    Ok(d) => "${d.c0.b9.a9.s9} ${d.a2.s9}"
    Err(e) => e
  }
}

fn main(os: Os) {
  // long enough to be counted (not inline), and not constant
  let tag = "a long tag past the inline Str size ${os.env.args().len()}"
  var keep: List[Result[D, Str]] = []
  for i in 0..3 {
    keep.push(make(i != 1, "${tag}#${i}"))
  }
  let again = keep
  keep.push(make(true, "last"))
  for r in again {
    os.stdio.println(line(r))
  }
  os.stdio.println("${keep.len()} ${again.len()}")
}
