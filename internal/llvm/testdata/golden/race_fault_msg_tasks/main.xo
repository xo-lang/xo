// Task #225: many tasks fault (isolated) on few workers. A fault's message
// goes through its worker thread's message buffer (fault.xo at), which
// tasks run one after the other on that worker write with no order a
// --race build sees: its writes are ignored there, so the --race build
// (TestRaceRuntimeInlinedUnchecked) reports nothing.
use std/task

fn boom(i: Int) -> Int {
  if i >= 0 {
    fault("boom ${i}")
  }
  i
}

fn main(os: Os) {
  let total = scope s {
    var hs: List[Task[Int, Never]] = []
    for t in 0..64 {
      hs.push(s.spawn(fn() -> Int {
        var n = 0
        for i in 0..50 {
          match task.isolate(fn() -> Int { boom(t * 100 + i) }) {
            Err(task.Isolated.Faulted(info)) => if info.msg == "boom ${t * 100 + i}" { n += 1 }
            _ => {}
          }
        }
        n
      }))
    }
    var sum = 0
    for h in hs {
      sum += h.await
    }
    sum
  }
  os.stdio.println("${total} faults kept their messages")
}
