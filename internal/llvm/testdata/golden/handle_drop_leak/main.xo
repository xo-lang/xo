// Runtime handles made with std/native/llrt tasks.make_handle (decision
// 0295) are freed whether closed or dropped: files opened with and
// without a read buffer and locks, closed, dropped open, and dropped in a
// task; channels dropped with values still buffered, mutexes holding a
// list, and child processes waited for or dropped. Run with XO_LEAKCHECK=1 as every golden is, a record the free hook
// does not free fails it. Each round locks its own file: a lock dropped
// held is released when its record is freed natively, but only when the
// collector runs on the Go backend. Its files live in a fresh directory
// under $TMPDIR, never beside the golden (a backend failing midway left
// h.txt and w.txt in testdata, and a commit took them).

fn round(fs: Fs, i: Int) -> Int ! FsErr uses fs {
  fs.write("h.txt", "line ${i}\nnext\n".bytes())?
  let f = fs.open("h.txt")?
  let first = f.read_line()? ?? ""
  // dropped open: its free hook closes it and frees the buffer
  if i % 2 == 0 {
    f.close()?
  }
  let w = fs.create("w.txt")?
  w.write(first.bytes())?
  if i % 3 == 0 {
    w.close()?
  }
  // odd rounds unlock; even ones drop the lock held, and freeing its
  // record closes the descriptor
  let l = fs.lock("h${i}.lock")?
  if i % 2 == 1 {
    l.unlock()
  }
  Ok(first.len())
}

fn shared_handles(i: Int) -> Int {
  let c = Chan[List[Int]].new(cap: 4)
  c.send([i, i + 1])
  c.send([i])
  let m = Mutex.new([i])
  let n = m.with(fn(var xs) -> Int {
    xs.push(1)
    xs.len()
  })
  n + (c.recv() ?? []).len()
}

fn children(p: Proc) -> Int ! ProcErr uses proc {
  let waited = p.cmd("true").spawn()?
  let code = waited.wait()?
  // dropped without a wait: its free hook closes its descriptors
  let _dropped = p.cmd("true").spawn()?
  Ok(code + 1)
}

fn main(os: Os) ! {
  let base = os.fs.sub(os.env.get("TMPDIR") ?? "/tmp")
  let name = "xo-handle-drop-leak-${os.rand.int(0, 1000000000)}"
  base.create_dir_all(name)?
  let fs = base.sub(name)
  var total = 0
  for i in 0..200 {
    total += round(fs, i)? + shared_handles(i)
  }
  var procs = 0
  for _ in 0..5 {
    procs += children(os.proc)?
  }
  let n = scope s {
    let t = s.spawn(fn() -> Int ! FsErr {
      let f = fs.open("h.txt")?
      let l = fs.try_lock("t.lock")?
      Ok((f.read_line()? ?? "").len() + (if l.is_some() { 1 } else { 0 }))
    })
    t.await?
  }
  let again = fs.try_lock("h1.lock")?
  os.stdio.println("total ${total} task ${n} relock ${again.is_some()} procs ${procs}")
  base.remove_all(name)?
}
