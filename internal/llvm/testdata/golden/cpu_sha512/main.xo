// SHA-512's compression of std/native/llrt/cpu.xo (sha512_block: SHA512H,
// SHA512H2, SHA512SU0 and SHA512SU1 on arm64; decision 0231's SHA-512
// addendum, 2026-11-03) against its portable body, through
// internal.crypto_op: the padded block of "abc" from the initial state
// (FIPS 180-4's digest), then 50 states and blocks from a SHA-256 stream;
// the lowered one runs only where cpu.hw() reports SHA-512 (else the body
// twice), and only whether the two agree is printed, the same on every
// machine. Then std's SHA-512 and SHA-384 (sha256.xo, which takes the
// instructions) on FIPS 180-4's message examples, and an HMAC.
use std/crypto
use std/internal

/// The 80 round constants as 8 byte little endian words (crypto_op's layout).
const K: Str = ""

/// SHA-512's initial state, the same layout.
const IV: Str = "08c9bcf367e6096a3ba7ca8485ae67bb2bf894fe72f36e3cf1361d5f3af54fa5d182e6ad7f520e511f6c3e2b8c68059b6bbd41fbabd9831f79217e1319cde05b"

/// The state as big endian bytes (the digest's order).
fn be_digest(st: Bytes) -> Str {
  var b = BytesBuilder.new()
  for i in 0..8 {
    for j in 0..8 {
      b.write_byte(st[8 * i + 7 - j])
    }
  }
  b.freeze().to_hex()
}

fn main(os: Os) uses stdio {
  let hw = Int.parse(internal.crypto_op("cpu.hw", b"", b"", b"", b"").to_str() ?? "0") ?? 0
  let lowered = if (hw & 4096) != 0 { "cpu.sha512_block" } else { "cpu.sha512_block_soft" }
  let k = Bytes.from_hex(K) ?? b""
  let iv = Bytes.from_hex(IV) ?? b""
  // "abc", 0x80, zeros, the bit length 24
  var blk = BytesBuilder.new()
  blk.write_str("abc")
  blk.write_byte(UInt8(0x80))
  for _ in 0..123 {
    blk.write_byte(UInt8(0))
  }
  blk.write_byte(UInt8(24))
  let abc = blk.freeze()
  let d1 = internal.crypto_op(lowered, iv, abc, k, b"")
  let d2 = internal.crypto_op("cpu.sha512_block_soft", iv, abc, k, b"")
  os.stdio.println("abc ${be_digest(d1)} ${if d1 == d2 { "same" } else { "differs" }}")
  var seed = crypto.digest(Sha256, b"cpu_sha512")
  var same = 0
  for i in 0..50 {
    let st = seed + crypto.digest(Sha256, seed + b"s")
    seed = crypto.digest(Sha256, st)
    var b = seed
    for j in 0..3 {
      b = b + crypto.digest(Sha256, seed + "${j}".bytes())
    }
    seed = crypto.digest(Sha256, b)
    let x = internal.crypto_op(lowered, st, b, k, b"")
    let y = internal.crypto_op("cpu.sha512_block_soft", st, b, k, b"")
    if x == y {
      same += 1
    } else {
      os.stdio.println("block ${i} differs: ${x.to_hex()} ${y.to_hex()}")
    }
  }
  os.stdio.println("blocks ${same} of 50 agree")
  os.stdio.println("sha512 abc ${crypto.digest(Sha512, "abc".bytes()).to_hex()}")
  os.stdio.println("sha512 two ${crypto.digest(Sha512, TWO.bytes()).to_hex()}")
  os.stdio.println("sha384 two ${crypto.digest(Sha384, TWO.bytes()).to_hex()}")
  os.stdio.println("hmac ${crypto.hmac(Sha512, b"key", "The quick brown fox jumps over the lazy dog".bytes()).to_hex()}")
}

/// FIPS 180-4's two block example for SHA-384 and SHA-512.
const TWO: Str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
