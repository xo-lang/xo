// A request's tls_state (std.md 4.3; Go's r.TLS): what the handshake
// negotiated over TLS (the version, the suite, the server name the
// client asked for, whether a session resumed, the client's
// certificates: none, the server asks for none), over HTTP/1.1 and
// HTTP/2 (the h2 client reaches the server by ALPN); None over plain
// HTTP and for a request built as a struct literal. An IP address
// carries no server name.
use std/http

fn state_text(req: http.Request) -> Str {
  match req.tls_state() {
    Some(s) => {
      let suite_ok = s.cipher_suite is "TLS_AES_128_GCM_SHA256" | "TLS_AES_256_GCM_SHA384" | "TLS_CHACHA20_POLY1305_SHA256"
      "tls=${req.tls()} version=${s.version} suite_ok=${suite_ok} server_name=\"${s.server_name}\" resumed=${s.resumed} peers=${s.peer_certificates.len()}"
    }
    None => "tls=${req.tls()} none"
  }
}

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /state", fn(req) { http.text(200, state_text(req)) })
  r
}

fn show(os: Os, label: Str, r: Result[http.Response, http.ClientErr]) {
  match r {
    Ok(resp) => os.stdio.println("${label}: ${resp.status} ${(resp.body.to_str() ?? "?").trim()}")
    Err(e) => os.stdio.println("${label}: error ${e}")
  }
}

fn serve_in(os: Os, srv: http.Server) {
  match srv.serve() {
    Ok(_) => ()
    Err(e) => os.stdio.println("serve failed: ${e}")
  }
}

fn main(os: Os) uses net, stdio {
  let lit = http.Request{method: "GET", path: "/state", url: http.Url{scheme: "http", host: "h", port: None, path: "/state", query: {}}, headers: {}, body: b"", remote_ip: ""}
  os.stdio.println("literal: ${state_text(lit)}")
  match (os.net.listen("127.0.0.1:0"), os.net.listen("127.0.0.1:0")) {
    (Ok(l1), Ok(l2)) => {
      let plain = http.server(l1, routes())
      let cert = http.tls_cert(good_cert(), good_key()).or_fault("cert")
      let tls = http.server(l2, routes()).with_tls([cert])
      let c = http.client(os.net, timeout: 5s).with_roots(ca_pem()).or_fault("roots")
      scope s {
        s.spawn_background(fn() { serve_in(os, plain) })
        s.spawn_background(fn() { serve_in(os, tls) })
        show(os, "plain", c.send(http.new_request("GET", "http://${plain.addr()}/state", {}, b"")))
        show(os, "tls", c.send(http.new_request("GET", "https://${tls.addr()}/state", {}, b"")))
        show(os, "tls again", c.send(http.new_request("GET", "https://${tls.addr()}/state", {}, b"")))
      }
    }
    _ => os.stdio.println("listen failed")
  }
}

