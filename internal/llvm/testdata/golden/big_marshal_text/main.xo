// std/big's text and JSON forms called directly (Go's Int.MarshalJSON and
// UnmarshalJSON, Float.MarshalText and UnmarshalText, Rat.MarshalText): the
// functions derive Json uses, the same on every backend (task #148).
use std/big
use std/json

fn main(os: Os) {
  for t in ["0", "-1", "123456789012345678901234567890", "-98765432109876543210"] {
    match big.parse(t) {
      Ok(x) => os.stdio.println("int_marshal ${t}: ${big.int_marshal(x).text}")
      Err(e) => os.stdio.println("parse ${t}: ${e}")
    }
  }
  for t in ["42", "-0", "1e3", "12x", "", "0x10", "+7"] {
    match big.int_unmarshal(json.Number{text: t}) {
      Ok(x) => os.stdio.println("int_unmarshal ${t.quote()}: ${x}")
      Err(e) => os.stdio.println("int_unmarshal ${t.quote()}: ${e}")
    }
  }
  for f in [0.0, 1.5, -2.25, 1e100, 1.0 / 3.0] {
    os.stdio.println("float_marshal ${f}: ${big.float_marshal(big.from_float(f))}")
  }
  for t in ["1.5", "-0", "1e-400", "0x1p-2", "Inf", "-inf", "1.5x", ""] {
    match big.float_unmarshal(t) {
      Ok(x) => os.stdio.println("float_unmarshal ${t.quote()}: ${big.float_marshal(x)}")
      Err(e) => os.stdio.println("float_unmarshal ${t.quote()}: ${e}")
    }
  }
  for (a, b) in [(1, 3), (-6, 4), (10, 5), (0, 7)] {
    os.stdio.println("rat_marshal ${a}/${b}: ${big.rat_marshal(big.rat(big.from_int(a), big.from_int(b)))}")
  }
}
