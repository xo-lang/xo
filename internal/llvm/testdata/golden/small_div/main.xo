// Divisions by constants of dividends whose bounds are small: a UInt8,
// a UInt16, an Int32 proven not negative, `x % k` (x86_64 multiplies by
// a small magic number and shifts, isel.xo sdiv_quot), against the
// same divisions by a variable, at the bounds and between.

fn by8(xs: List[UInt8], ks: List[Int]) -> (Int, Int) {
  var bad = 0
  var h = 0
  for x0 in xs {
    let x = Int(x0)
    if x / 3 != x / ks[0] || x % 3 != x % ks[0] { bad += 1 }
    h = (h * 31 + x / 3 + x % 3) % 1000000007
    if x / 5 != x / ks[1] || x % 5 != x % ks[1] { bad += 1 }
    h = (h * 31 + x / 5 + x % 5) % 1000000007
    if x / 6 != x / ks[2] || x % 6 != x % ks[2] { bad += 1 }
    h = (h * 31 + x / 6 + x % 6) % 1000000007
    if x / 7 != x / ks[3] || x % 7 != x % ks[3] { bad += 1 }
    h = (h * 31 + x / 7 + x % 7) % 1000000007
    if x / 9 != x / ks[4] || x % 9 != x % ks[4] { bad += 1 }
    h = (h * 31 + x / 9 + x % 9) % 1000000007
    if x / 10 != x / ks[5] || x % 10 != x % ks[5] { bad += 1 }
    h = (h * 31 + x / 10 + x % 10) % 1000000007
    if x / 11 != x / ks[6] || x % 11 != x % ks[6] { bad += 1 }
    h = (h * 31 + x / 11 + x % 11) % 1000000007
    if x / 12 != x / ks[7] || x % 12 != x % ks[7] { bad += 1 }
    h = (h * 31 + x / 12 + x % 12) % 1000000007
    if x / 13 != x / ks[8] || x % 13 != x % ks[8] { bad += 1 }
    h = (h * 31 + x / 13 + x % 13) % 1000000007
    if x / 25 != x / ks[9] || x % 25 != x % ks[9] { bad += 1 }
    h = (h * 31 + x / 25 + x % 25) % 1000000007
    if x / 60 != x / ks[10] || x % 60 != x % ks[10] { bad += 1 }
    h = (h * 31 + x / 60 + x % 60) % 1000000007
    if x / 100 != x / ks[11] || x % 100 != x % ks[11] { bad += 1 }
    h = (h * 31 + x / 100 + x % 100) % 1000000007
    if x / 127 != x / ks[12] || x % 127 != x % ks[12] { bad += 1 }
    h = (h * 31 + x / 127 + x % 127) % 1000000007
    if x / 255 != x / ks[13] || x % 255 != x % ks[13] { bad += 1 }
    h = (h * 31 + x / 255 + x % 255) % 1000000007
    if x / 641 != x / ks[14] || x % 641 != x % ks[14] { bad += 1 }
    h = (h * 31 + x / 641 + x % 641) % 1000000007
    if x / 1000 != x / ks[15] || x % 1000 != x % ks[15] { bad += 1 }
    h = (h * 31 + x / 1000 + x % 1000) % 1000000007
    if x / 3600 != x / ks[16] || x % 3600 != x % ks[16] { bad += 1 }
    h = (h * 31 + x / 3600 + x % 3600) % 1000000007
    if x / 10007 != x / ks[17] || x % 10007 != x % ks[17] { bad += 1 }
    h = (h * 31 + x / 10007 + x % 10007) % 1000000007
    if x / 65521 != x / ks[18] || x % 65521 != x % ks[18] { bad += 1 }
    h = (h * 31 + x / 65521 + x % 65521) % 1000000007
    if x / 1000003 != x / ks[19] || x % 1000003 != x % ks[19] { bad += 1 }
    h = (h * 31 + x / 1000003 + x % 1000003) % 1000000007
    if x / 2147483647 != x / ks[20] || x % 2147483647 != x % ks[20] { bad += 1 }
    h = (h * 31 + x / 2147483647 + x % 2147483647) % 1000000007
  }
  (bad, h)
}

fn by32(xs: List[Int], ks: List[Int]) -> (Int, Int) {
  var bad = 0
  var h = 0
  for v in xs {
    let w = Int32.try(v) ?? -1
    if w < 0 { continue }
    let x = Int(w)
    if x / 3 != x / ks[0] || x % 3 != x % ks[0] { bad += 1 }
    h = (h * 31 + x / 3 + x % 3) % 1000000007
    if x / 5 != x / ks[1] || x % 5 != x % ks[1] { bad += 1 }
    h = (h * 31 + x / 5 + x % 5) % 1000000007
    if x / 6 != x / ks[2] || x % 6 != x % ks[2] { bad += 1 }
    h = (h * 31 + x / 6 + x % 6) % 1000000007
    if x / 7 != x / ks[3] || x % 7 != x % ks[3] { bad += 1 }
    h = (h * 31 + x / 7 + x % 7) % 1000000007
    if x / 9 != x / ks[4] || x % 9 != x % ks[4] { bad += 1 }
    h = (h * 31 + x / 9 + x % 9) % 1000000007
    if x / 10 != x / ks[5] || x % 10 != x % ks[5] { bad += 1 }
    h = (h * 31 + x / 10 + x % 10) % 1000000007
    if x / 11 != x / ks[6] || x % 11 != x % ks[6] { bad += 1 }
    h = (h * 31 + x / 11 + x % 11) % 1000000007
    if x / 12 != x / ks[7] || x % 12 != x % ks[7] { bad += 1 }
    h = (h * 31 + x / 12 + x % 12) % 1000000007
    if x / 13 != x / ks[8] || x % 13 != x % ks[8] { bad += 1 }
    h = (h * 31 + x / 13 + x % 13) % 1000000007
    if x / 25 != x / ks[9] || x % 25 != x % ks[9] { bad += 1 }
    h = (h * 31 + x / 25 + x % 25) % 1000000007
    if x / 60 != x / ks[10] || x % 60 != x % ks[10] { bad += 1 }
    h = (h * 31 + x / 60 + x % 60) % 1000000007
    if x / 100 != x / ks[11] || x % 100 != x % ks[11] { bad += 1 }
    h = (h * 31 + x / 100 + x % 100) % 1000000007
    if x / 127 != x / ks[12] || x % 127 != x % ks[12] { bad += 1 }
    h = (h * 31 + x / 127 + x % 127) % 1000000007
    if x / 255 != x / ks[13] || x % 255 != x % ks[13] { bad += 1 }
    h = (h * 31 + x / 255 + x % 255) % 1000000007
    if x / 641 != x / ks[14] || x % 641 != x % ks[14] { bad += 1 }
    h = (h * 31 + x / 641 + x % 641) % 1000000007
    if x / 1000 != x / ks[15] || x % 1000 != x % ks[15] { bad += 1 }
    h = (h * 31 + x / 1000 + x % 1000) % 1000000007
    if x / 3600 != x / ks[16] || x % 3600 != x % ks[16] { bad += 1 }
    h = (h * 31 + x / 3600 + x % 3600) % 1000000007
    if x / 10007 != x / ks[17] || x % 10007 != x % ks[17] { bad += 1 }
    h = (h * 31 + x / 10007 + x % 10007) % 1000000007
    if x / 65521 != x / ks[18] || x % 65521 != x % ks[18] { bad += 1 }
    h = (h * 31 + x / 65521 + x % 65521) % 1000000007
    if x / 1000003 != x / ks[19] || x % 1000003 != x % ks[19] { bad += 1 }
    h = (h * 31 + x / 1000003 + x % 1000003) % 1000000007
    if x / 2147483647 != x / ks[20] || x % 2147483647 != x % ks[20] { bad += 1 }
    h = (h * 31 + x / 2147483647 + x % 2147483647) % 1000000007
    let y = v % 65536
    if y >= 0 && (y / 7 != y / ks[3] || y % 1000 != y % ks[15]) { bad += 1 }
  }
  (bad, h)
}

fn main(os: Os) {
  let io = os.stdio
  let ks = [3, 5, 6, 7, 9, 10, 11, 12, 13, 25, 60, 100, 127, 255, 641, 1000, 3600, 10007, 65521, 1000003, 2147483647]
  var bs: List[UInt8] = []
  for i in 0..256 { bs.push(UInt8(i)) }
  var xs = [0, 1, 2147483647, 2147483646, 2147483648, -1, 1073741824, 999999999, 2000000000]
  for d in ks {
    xs.push(d - 1)
    xs.push(d)
    xs.push(d + 1)
    xs.push(2147483647 - 2147483647 % d)
    xs.push(2147483647 - 2147483647 % d - 1)
  }
  var g = 12345
  for _ in 0..20000 {
    g = (g * 1103515245 + 12345) % 2147483648
    xs.push(g)
    xs.push(g % 70000)
  }
  let (b8, h8) = by8(bs, ks)
  let (b32, h32) = by32(xs, ks)
  io.println("${ks.len()} divisors: uint8 ${b8} wrong ${h8}, int32 ${b32} wrong ${h32}")
}
