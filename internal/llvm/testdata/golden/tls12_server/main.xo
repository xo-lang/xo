const B_S_HS: Str = ""
const B_SIG: Str = "3066023100a5b1c422c04d8e02cef96ac794008af23b0e95d904e0fec73c097cbcfb739ae715e1dee00ece116b6c95734fbae3d44d023100b8b7a6e5b8dd2e9c188aaea9dd5be15a80ddb1b26715b0102ff3fd2a55faf2f5dd65e222e8a3395ab80957849ad1aa23"
// C: suite cca8 curve 24 cert rsa alpn [] [] -> ""
const C_C_HS: Str = ""
const C_C_APP: Str = "1703030014bd838a80f7225799b03d666fcf72091c18501bc515030300129e2941b97ebc12f14dd9f0ad181e5385ab35"
const C_S_HS: Str = ""
const C_SIG: Str = ""
// D: suite c02f curve 29 cert rsa alpn [h2 http/1.1] [http/1.1] -> "http/1.1"
const D_C_HS: Str = ""
const D_C_APP: Str = "170303001c0000000000000001f86bfb55034194b14dacbfdd66b9ec26bcf31dc0150303001a0000000000000002b42e621c7b30eba00def5097e7f6ec23889d"
const D_S_HS: Str = ""
const D_SIG: Str = ""
// E: suite c030 curve 29 cert rsa alpn [] [] -> ""
const E_C_HS: Str = ""
const E_C_APP: Str = "170303001c000000000000000167e8d839b1ab47a1271d751e6d3220c3f648c997150303001a00000000000000020c6ffccb94a449288aeda13f3916c1a59ee5"
const E_S_HS: Str = ""
const E_SIG: Str = ""
// F: suite cca9 curve 29 cert p256 alpn [] [] -> ""
const F_C_HS: Str = ""
const F_C_APP: Str = "1703030014d3c0f1c97f12cbca9ef456ccd155ec9ce9b006e01503030012bbb9881ca86c37b74aa50724c5cfa9746660"
const F_S_HS: Str = ""
const F_SIG: Str = "3044022071721d467bb2e11cbed89b68e86f7f01e14e91f58fab3e7c45fcbb116dc404e60220531628171b2b3cfb95fc8bd3b9ee9e1b8f9bc0df6c584cdc53c0e322a7b30670"
// G: suite c02b curve 29 cert p256 alpn [] [] -> ""
const G_C_HS: Str = ""
const G_C_APP: Str = "170303001c00000000000000013dcf5c1c7b806f558962b8bb39990071581ba3a8150303001a0000000000000002f9ceac0c3dcbedc49ba55062a1ee37a4a242"
const G_S_HS: Str = ""
const G_SIG: Str = "3044022071721d467bb2e11cbed89b68e86f7f01e14e91f58fab3e7c45fcbb116dc404e60220531628171b2b3cfb95fc8bd3b9ee9e1b8f9bc0df6c584cdc53c0e322a7b30670"
// H: suite c02b curve 29 cert p256 alpn [] [] -> ""
const H_C_HS: Str = ""
const H_C_APP: Str = "170303001c000000000000000161cf476e1d4b6ac024c31a22afb1e51e5a65083c150303001a00000000000000025eb969f4eb9fd72367b4b1ce2ddbb2d039a6"
const H_S_HS: Str = ""
const H_SIG: Str = "3044022071721d467bb2e11cbed89b68e86f7f01e14e91f58fab3e7c45fcbb116dc404e60220531628171b2b3cfb95fc8bd3b9ee9e1b8f9bc0df6c584cdc53c0e322a7b30670"

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

/// The parts as 3 byte lengths and bytes.
fn pack(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    out.write_byte(UInt8(b.len() / 65536))
    out.write_byte(UInt8(b.len() / 256 % 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

fn u16(n: Int) -> Bytes {
  var out = BytesBuilder.new()
  out.write_byte(UInt8(n / 256 % 256))
  out.write_byte(UInt8(n % 256))
  out.freeze()
}

fn u24(n: Int) -> Bytes {
  var out = BytesBuilder.new()
  out.write_byte(UInt8(n / 65536))
  out.write_byte(UInt8(n / 256 % 256))
  out.write_byte(UInt8(n % 256))
  out.freeze()
}

fn cat(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

fn at16(b: Bytes, p: Int) -> Int { Int(b[p]) * 256 + Int(b[p + 1]) }

/// s with the hex digits from lo to hi replaced by r.
fn splice(s: Str, lo: Int, hi: Int, r: Str) -> Str {
  let b = s.bytes()
  "${b[0..lo].to_str() ?? ""}${r}${b[hi..b.len()].to_str() ?? ""}"
}

/// The first record of a client's handshake bytes (its ClientHello).
fn first_record(c_hs: Str) -> Bytes {
  let b = hex(c_hs)
  b[0..5 + at16(b, 3)]
}

/// The ClientHello record with its signature_algorithms extension's list
/// replaced by algs (the lengths fixed up).
fn with_sigalgs(rec: Bytes, algs: Bytes) -> Bytes {
  let m = rec[5..rec.len()]
  var p = 4 + 2 + 32
  p += 1 + Int(m[p])
  p += 2 + at16(m, p)
  p += 1 + Int(m[p])
  let head = m[4..p]
  p += 2
  var exts: List[Bytes] = []
  while p < m.len() {
    let t = at16(m, p)
    let n = at16(m, p + 2)
    if t == 13 {
      exts.push(cat([u16(13), u16(algs.len() + 2), u16(algs.len()), algs]))
    } else {
      exts.push(m[p..p + 4 + n])
    }
    p += 4 + n
  }
  let e = cat(exts)
  let body = cat([head, u16(e.len()), e])
  let msg = cat([b"\x01", u24(body.len()), body])
  cat([b"\x16\x03\x01", u16(msg.len()), msg])
}

/// A trace's server flight named in the lines.
fn named(w: Str, s_hs: Str) -> Str {
  if w == s_hs {
    "<server flight>"
  } else if w.contains("<sig-ok>") {
    "<server flight, signature verified, ${w.len() / 2} bytes>"
  } else if w.contains("<sig-bad>") {
    "<server flight, signature BAD>"
  } else if w.len() > 120 {
    "${w.bytes()[0..32].to_str() ?? ""}...${w.bytes()[w.len() - 16..w.len()].to_str() ?? ""} (${w.len() / 2} bytes)"
  } else {
    w
  }
}

fn serve(os: Os, title: Str, key: Str, chs: Bytes, capp: Str, cert: Str, skey: Str, sig: Str, suites: Str, groups: Str, alpn: Str, kt: Str, chunk: Int, mask: Int, s_hs: Str) uses stdio {
  let parts = pack([chs, hex(capp), hex(cert), hex(skey), hex(sig)])
  let ch = if chunk < 0 { "r" } else { "${chunk}" }
  let r = internal.crypto_op("tls12.server", hex(key), parts, b"", "${suites} ${groups} ${alpn} ${kt} ${ch} ${mask}".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for w in line.split(" ") {
        ws.push(named(w, s_hs))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

const SUITES: Str = "c02b,c02f,c02c,c030,cca9,cca8"
const GROUPS: Str = "29,23,24"

fn run(os: Os, title: Str, key: Str, chs: Str, capp: Str, cert: Str, skey: Str, sig: Str, kt: Str, alpn: Str, s_hs: Str) uses stdio { serve(os, title, key, hex(chs), capp, cert, skey, sig, SUITES, GROUPS, alpn, kt, 0, 0, s_hs) }

fn main(os: Os) uses stdio {
  run(os, "A ecdsa p256, x25519, aes128-gcm", SERVER_X25519, A_C_HS, A_C_APP, CERT_P256, KEY_P256_D, A_SIG, "p256", "-", A_S_HS)
  run(os, "B ecdsa p384, p256, aes256-gcm", SERVER_P256, B_C_HS, B_C_APP, CERT_P384, KEY_P384_D, B_SIG, "p384", "-", B_S_HS)
  run(os, "C rsa-pss signed here, p384, chacha20", SERVER_P384, C_C_HS, C_C_APP, CERT_RSA, KEY_RSA, "", "rsa", "-", C_S_HS)
  run(os, "D rsa-pss signed here, x25519, alpn", SERVER_X25519, D_C_HS, D_C_APP, CERT_RSA, KEY_RSA, "", "rsa", "http/1.1", D_S_HS)
  run(os, "E rsa-pss signed here, x25519, aes256-gcm", SERVER_X25519, E_C_HS, E_C_APP, CERT_RSA, KEY_RSA, "", "rsa", "-", E_S_HS)
  run(os, "F ecdsa p256, x25519, chacha20", SERVER_X25519, F_C_HS, F_C_APP, CERT_P256, KEY_P256_D, F_SIG, "p256", "-", F_S_HS)
  run(os, "H one hello for 1.3 and 1.2", SERVER_X25519, H_C_HS, H_C_APP, CERT_P256, KEY_P256_D, H_SIG, "p256", "-", H_S_HS)
  serve(os, "A byte at a time", SERVER_X25519, hex(A_C_HS), A_C_APP, CERT_P256, KEY_P256_D, A_SIG, SUITES, GROUPS, "-", "p256", 1, 0, A_S_HS)
  serve(os, "A through resume (tls13srv.xo's hand-off)", SERVER_X25519, hex(A_C_HS), A_C_APP, CERT_P256, KEY_P256_D, A_SIG, SUITES, GROUPS, "-", "p256", -1, 0, A_S_HS)
  serve(os, "ecdsa p256 signed here (masked)", SERVER_X25519, first_record(A_C_HS), "", CERT_P256, KEY_P256_D, "", SUITES, GROUPS, "-", "p256", 0, 1, A_S_HS)
  serve(os, "ecdsa p384 signed here (masked)", SERVER_P256, first_record(B_C_HS), "", CERT_P384, KEY_P384_D, "", SUITES, GROUPS, "-", "p384", 0, 1, B_S_HS)
  serve(os, "rsa pkcs1 v1.5 signed here", SERVER_X25519, with_sigalgs(first_record(E_C_HS), hex("04010501")), "", CERT_RSA, KEY_RSA, "", SUITES, GROUPS, "-", "rsa", 0, 0, E_S_HS)
  serve(os, "no signature algorithm in common", SERVER_X25519, with_sigalgs(first_record(E_C_HS), hex("0403")), "", CERT_RSA, KEY_RSA, "", SUITES, GROUPS, "-", "rsa", 0, 0, E_S_HS)
  serve(os, "no suite in common", SERVER_X25519, hex(A_C_HS), A_C_APP, CERT_P256, KEY_P256_D, A_SIG, "c02f", GROUPS, "-", "p256", 0, 0, A_S_HS)
  serve(os, "no curve in common", SERVER_X25519, hex(A_C_HS), A_C_APP, CERT_P256, KEY_P256_D, A_SIG, SUITES, "24", "-", "p256", 0, 0, A_S_HS)
  serve(os, "alpn not matching", SERVER_X25519, hex(D_C_HS), D_C_APP, CERT_RSA, KEY_RSA, "", SUITES, GROUPS, "h3", "rsa", 0, 0, D_S_HS)
  let ch = first_record(A_C_HS).len() * 2
  run(os, "corrupt client key exchange", SERVER_X25519, splice(A_C_HS, ch + 18, ch + 20, "21"), A_C_APP, CERT_P256, KEY_P256_D, A_SIG, "p256", "-", A_S_HS)
  let fin = A_C_HS.len() - 20
  run(os, "corrupt client finished", SERVER_X25519, splice(A_C_HS, fin, fin + 2, "00"), A_C_APP, CERT_P256, KEY_P256_D, A_SIG, "p256", "-", A_S_HS)
  run(os, "corrupt client data", SERVER_X25519, A_C_HS, splice(A_C_APP, 40, 42, "00"), CERT_P256, KEY_P256_D, A_SIG, "p256", "-", A_S_HS)
  run(os, "client alert", SERVER_X25519, "15030100020228", "", CERT_P256, KEY_P256_D, A_SIG, "p256", "-", A_S_HS)
  run(os, "not tls", SERVER_X25519, "474554202f20485454502f312e310d0a", "", CERT_P256, KEY_P256_D, A_SIG, "p256", "-", A_S_HS)
}
