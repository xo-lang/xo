// The TLS 1.3 client of the native backends' TLS (std/native/llrt/tls13.xo,
// the zero-C audit's B31) replaying RFC 8448's simple 1-RTT handshake
// (section 3) through internal.crypto_op, against a Go replay of the
// same trace (std/rt's internal_crypto.go): the client's ClientHello and
// ECDHE secret fixed to the trace's, the server's records fed whole and
// a byte at a time, the client's Finished, application data and alert
// records equal to the RFC's; then the failures: the certificate past
// its validity, a host it does not name, no root, a corrupted record, a
// wrong shared secret, a suite not offered.
use std/internal

const HELLO: Str = ""
const HELLO_RECORD: Str = ""
const SHARED: Str = "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"
const SERVER_HELLO: Str = "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"
const SERVER_FLIGHT: Str = ""
const CLIENT_FINISHED: Str = "170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546"
const TICKET: Str = ""
const CLIENT_DATA: Str = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
const CLIENT_DATA_RECORD: Str = "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
const SERVER_DATA: Str = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
const SERVER_DATA_RECORD: Str = "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"
const CLIENT_ALERT: Str = "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
const SERVER_ALERT: Str = "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9"
const CERT: Str = ""

// 2020-09-13, inside the RFC certificate's validity (2016-07-30 to
// 2026-07-30), and 2027-01-15 after it
const NOW: Int = 1600000000
const LATE: Int = 1800000000

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

/// The parts as 3 byte lengths and bytes.
fn pack(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    out.write_byte(UInt8(b.len() / 65536))
    out.write_byte(UInt8(b.len() / 256 % 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

/// The hex h named when it is one of the trace's records.
fn name(h: Str) -> Str {
  if h == HELLO_RECORD {
    "<ClientHello>"
  } else if h == CLIENT_FINISHED {
    "<client Finished>"
  } else if h == CLIENT_DATA_RECORD {
    "<client data>"
  } else if h == SERVER_DATA {
    "<server data>"
  } else if h == CLIENT_ALERT {
    "<client close_notify>"
  } else {
    h
  }
}

/// s with the hex digits from lo to hi replaced by r.
fn splice(s: Str, lo: Int, hi: Int, r: Str) -> Str {
  let b = s.bytes()
  "${b[0..lo].to_str() ?? ""}${r}${b[hi..b.len()].to_str() ?? ""}"
}

fn replay(os: Os, title: Str, flight: Str, shared: Str, root: Str, now: Int, host: Str, suite: Str, chunk: Int) uses stdio {
  let parts = pack([hex("${SERVER_HELLO}${flight}"), hex("${TICKET}${SERVER_DATA_RECORD}${SERVER_ALERT}"), hex(CLIENT_DATA), hex(root)])
  let r = internal.crypto_op("tls13.replay", hex(HELLO), parts, hex(shared), "${now} ${host} ${suite} ${chunk}".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for w in line.split(" ") {
        ws.push(name(w))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

fn main(os: Os) uses stdio {
  replay(os, "rfc 8448", SERVER_FLIGHT, SHARED, CERT, NOW, "-", "1301", 0)
  replay(os, "byte at a time", SERVER_FLIGHT, SHARED, CERT, NOW, "-", "1301", 1)
  replay(os, "expired", SERVER_FLIGHT, SHARED, CERT, LATE, "-", "1301", 0)
  replay(os, "host", SERVER_FLIGHT, SHARED, CERT, NOW, "example.com", "1301", 0)
  replay(os, "no root", SERVER_FLIGHT, SHARED, "", NOW, "-", "1301", 0)
  replay(os, "corrupt record", splice(SERVER_FLIGHT, 40, 42, "00"), SHARED, CERT, NOW, "-", "1301", 0)
  replay(os, "wrong secret", SERVER_FLIGHT, splice(SHARED, 0, 2, "00"), CERT, NOW, "-", "1301", 0)
  replay(os, "suite not offered", SERVER_FLIGHT, SHARED, CERT, NOW, "-", "1302", 0)
}
