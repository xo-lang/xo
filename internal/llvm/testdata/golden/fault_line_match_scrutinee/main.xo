// A fault raised inside cli.parse as a match scrutinee at the end of the
// file is reported at the call's line on every backend (the Go backend
// gave a line past the end of the file before 2026-11-07).
use std/cli

fn main(os: Os) {
  let app = cli.command("db", "Database tool.",
    flags: [cli.str_flag("url", "the database", short: "u"), cli.bool_flag("dry-run", "show only", short: "u")])
  match cli.parse(app, [], os.env) {
    Ok(p) => os.stdio.println("parsed ${p.command()}")
    Err(e) => os.stdio.println("error ${e}")
  }
}
