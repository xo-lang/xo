// Decision 0430: a TlsConn's deadlines are its connection's, as Go's
// tls.Conn. A read past its deadline is Timeout and the connection stays
// usable (the request then goes through); a deadline already passed
// fails a write at once; a deadline set on the Conn before tls.client
// limits the handshake (a server that never answers). Every backend must
// agree. The certificates are golden tls_client's.
use std/http
use std/tls

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello over tls") })
  r
}

fn show(r: Result[Bytes?, NetErr]) -> Str {
  match r {
    Ok(Some(b)) => "data ${(b.to_str() ?? "?").split("\r\n")[0]}"
    Ok(None) => "end"
    Err(e) => "err ${e}"
  }
}

fn main(os: Os) {
  let clock = os.clock
  let ca = tls.roots(ca_pem()).or_fault("roots")
  let good = http.tls_cert(good_cert(), good_key()).or_fault("good")
  let l1 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let l2 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l1, routes()).with_tls([good])
  scope s {
    s.spawn_background(fn() { srv.serve().ignore_err("test") })
    // a listener that accepts and never speaks: the handshake waits
    s.spawn_background(fn() {
      match l2.accept() {
        Ok(sc) => {
          clock.sleep(2s)
          sc.close()
        }
        Err(_) => ()
      }
    })
    let c = os.net.dial(l1.addr()).or_fault("dial")
    match tls.client(c, "localhost", roots: Some(ca)) {
      Ok(t) => {
        t.set_read_deadline(clock, Some(clock.now() + 50ms))
        os.stdio.println("1 ${show(t.read(64))}")
        t.set_read_deadline(clock, None)
        t.write("GET /hello HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n".bytes()) ?? e => os.stdio.println("write: ${e}")
        os.stdio.println("2 ${show(t.read(4096))}")
        t.set_write_deadline(clock, Some(clock.now() - 1s))
        match t.write("x".bytes()) {
          Ok(_) => os.stdio.println("3 write ok")
          Err(e) => os.stdio.println("3 write ${e}")
        }
        t.close()
      }
      Err(e) => os.stdio.println("client: ${e}")
    }
    let c2 = os.net.dial(l2.addr()).or_fault("dial")
    c2.set_deadline(clock, Some(clock.now() + 100ms))
    match tls.client(c2, "localhost", roots: Some(ca)) {
      Ok(_) => os.stdio.println("4 handshake ok?")
      Err(e) => os.stdio.println("4 handshake ${e}")
    }
    c2.close()
  }
  os.stdio.println("done")
}

