// The TLS 1.2 server's ECDHE CBC-SHA suites (std/native/llrt/tls12.xo
// and tls12srv.xo, decision 0202: the four Go's server enables by
// default, server side only) against crypto/tls's client, through
// internal.crypto_op("tls12.server"), whose Go reference drives
// crypto/tls's server over the same bytes. Traces as tls12_client's
// (random sources of 0x11 and 0x22 bytes, so every CBC record's explicit
// IV is 16 bytes of one of them): ECDSA with AES-128-CBC-SHA (the trace's
// signature handed in) and RSA with AES-256-CBC-SHA (signed here, PSS);
// then client records made with the sessions' real keys: valid data, the
// longest padding (255), bad padding under a good MAC, a bad MAC, a
// record shorter than an IV, a MAC, and a block, one not in whole blocks
// (every failure Go's one bad_record_mac); and a byte at a time.
use std/internal

const CERT_P256: Str = ""
const KEY_P256_D: Str = "9f21bbe70040d0bb7340fd3894b1390a7fc575741aa8ff9bb82c754c6fcef8b0"
const CERT_RSA: Str = ""
const KEY_RSA: Str = ""
const SERVER_X25519: Str = "2222222222222222222222222222222222222222222222222222222222222222"
// I: suite c009 curve 29 cert p256 alpn [] [] -> ""
const I_C_HS: Str = ""
const I_C_APP: Str = "1703030030111111111111111111111111111111111ac9bbd317a24e0007a05cbd435ab49948cd69eec35f5a14d4994cb7ff6b4b05150303003011111111111111111111111111111111c9f242501918ca5988f76ebb4a2fd6e976dc398d33dc255e947bb6c75bcd8584"
const I_S_HS: Str = ""
const I_SIG: Str = "3044022071721d467bb2e11cbed89b68e86f7f01e14e91f58fab3e7c45fcbb116dc404e60220531628171b2b3cfb95fc8bd3b9ee9e1b8f9bc0df6c584cdc53c0e322a7b30670"
// J: suite c014 curve 29 cert rsa alpn [] [] -> ""
const J_C_HS: Str = ""
const J_C_APP: Str = "1703030030111111111111111111111111111111119679a809d54dc6b7756273666737dc0bd0ae5b019c83f56f4a70ddc7dc539010150303003011111111111111111111111111111111408ad708189a3b533355898b6de2f49b1d33efb5976a029fc6af89ee9e7bdca6"
const J_S_HS: Str = ""
const J_SIG: Str = ""
const I_REC_VALID: Str = "1703030030111111111111111111111111111111111ac9bbd317a24e0007a05cbd435ab49948cd69eec35f5a14d4994cb7ff6b4b05150303003011111111111111111111111111111111c9f242501918ca5988f76ebb4a2fd6e976dc398d33dc255e947bb6c75bcd8584"
const I_REC_MAXPAD: Str = ""
const I_REC_BADPAD: Str = "1703030040111111111111111111111111111111111ac9bbd317a24e0007a05cbd435ab4991f915d2852c029d566985a114543534261501f80c8aa46a73b6f9fffca99fcc8"
const I_REC_BADMAC: Str = "17030300301111111111111111111111111111111173901fef23e3b336f58bde313a7eab0fc8adea5571723787f1b2c409b683e685"
const I_REC_SHORT: Str = "1703030020111111111111111111111111111111111ac9bbd317a24e0007a05cbd435ab499"
const I_REC_ODD: Str = "1703030032111111111111111111111111111111111ac9bbd317a24e0007a05cbd435ab4991f915d2852c029d566985a11454353429f73"
const J_REC_VALID: Str = "1703030030111111111111111111111111111111119679a809d54dc6b7756273666737dc0bd0ae5b019c83f56f4a70ddc7dc539010150303003011111111111111111111111111111111408ad708189a3b533355898b6de2f49b1d33efb5976a029fc6af89ee9e7bdca6"
const J_REC_MAXPAD: Str = ""
const J_REC_BADPAD: Str = "1703030040111111111111111111111111111111119679a809d54dc6b7756273666737dc0b72827a521fa2cbb74a67576d4b72f98711dd5500c7205afefe74d4998a9e7b58"
const J_REC_BADMAC: Str = "170303003011111111111111111111111111111111a71183b83c255a901937aa07247391349e0b99a71fff6702c572ecf49dbd1429"
const J_REC_SHORT: Str = "1703030020111111111111111111111111111111119679a809d54dc6b7756273666737dc0b"
const J_REC_ODD: Str = "1703030032111111111111111111111111111111119679a809d54dc6b7756273666737dc0b72827a521fa2cbb74a67576d4b72f9871dc7"

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

/// The parts as 3 byte lengths and bytes.
fn pack(xs: List[Bytes]) -> Bytes {
  var out = BytesBuilder.new()
  for b in xs {
    out.write_byte(UInt8(b.len() / 65536))
    out.write_byte(UInt8(b.len() / 256 % 256))
    out.write_byte(UInt8(b.len() % 256))
    for y in b {
      out.write_byte(y)
    }
  }
  out.freeze()
}

fn named(w: Str, s_hs: Str) -> Str {
  if w == s_hs {
    "<server flight>"
  } else if w.len() > 120 {
    "${w.bytes()[0..32].to_str() ?? ""}...${w.bytes()[w.len() - 16..w.len()].to_str() ?? ""} (${w.len() / 2} bytes)"
  } else {
    w
  }
}

const SUITES: Str = "c02b,c02f,c02c,c030,cca9,cca8,c009,c013,c00a,c014"

fn serve(os: Os, title: Str, chs: Str, capp: Str, cert: Str, key: Str, sig: Str, kt: Str, chunk: Int, s_hs: Str) uses stdio {
  let parts = pack([hex(chs), hex(capp), hex(cert), hex(key), hex(sig)])
  let r = internal.crypto_op("tls12.server", hex(SERVER_X25519), parts, b"", "${SUITES} 29,23,24 - ${kt} ${chunk} 0".bytes())
  os.stdio.println("${title}:")
  for line in (r.to_str() ?? "").split("\n") {
    if line != "" {
      var ws: List[Str] = []
      for w in line.split(" ") {
        ws.push(named(w, s_hs))
      }
      os.stdio.println("  ${ws.join(" ")}")
    }
  }
}

fn i(os: Os, title: Str, capp: Str) uses stdio { serve(os, title, I_C_HS, capp, CERT_P256, KEY_P256_D, I_SIG, "p256", 0, I_S_HS) }

fn j(os: Os, title: Str, capp: Str) uses stdio { serve(os, title, J_C_HS, capp, CERT_RSA, KEY_RSA, "", "rsa", 0, J_S_HS) }

fn main(os: Os) uses stdio {
  i(os, "I ecdsa, aes-128-cbc-sha, crypto/tls's records", I_C_APP)
  j(os, "J rsa (signed here), aes-256-cbc-sha, crypto/tls's records", J_C_APP)
  serve(os, "I byte at a time", I_C_HS, I_C_APP, CERT_P256, KEY_P256_D, I_SIG, "p256", 1, I_S_HS)
  i(os, "I valid", I_REC_VALID)
  i(os, "I padding 255", I_REC_MAXPAD)
  i(os, "I bad padding, good MAC", I_REC_BADPAD)
  i(os, "I bad MAC", I_REC_BADMAC)
  i(os, "I short record", I_REC_SHORT)
  i(os, "I not whole blocks", I_REC_ODD)
  j(os, "J valid", J_REC_VALID)
  j(os, "J padding 255", J_REC_MAXPAD)
  j(os, "J bad padding, good MAC", J_REC_BADPAD)
  j(os, "J bad MAC", J_REC_BADMAC)
  j(os, "J short record", J_REC_SHORT)
}
