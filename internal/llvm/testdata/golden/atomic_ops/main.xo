// Atomic[T]'s operations (std.md 2.7) as decision 0200 lowers them on
// the native backends: get, set, swap, compare_and_swap inline on the
// value's cell, add and max in std/native/llrt/atomic.xo; the C path is
// XO_LLRT_C=atomic. A sum that does not fit an Int faults at the call.
fn bump(a: Atomic[Int], n: Int) -> Int {
  a.add(n)
}

fn main(os: Os) {
  let a = Atomic[Int].new(-5)
  os.stdio.println("get ${a.get()} swap ${a.swap(7)} get ${a.get()}")
  os.stdio.println("cas ${a.compare_and_swap(7, 9)} ${a.compare_and_swap(7, 11)} get ${a.get()}")
  os.stdio.println("max ${a.max(3)} ${a.max(40)} ${a.max(40)} get ${a.get()}")
  os.stdio.println("add ${a.add(2)} ${a.add(-50)} ${a.add(0)}")
  a.set(0)
  let flag = Atomic[Bool].new(false)
  os.stdio.println("flag ${flag.get()} swap ${flag.swap(true)} ${flag.get()} cas ${flag.compare_and_swap(false, true)} ${flag.compare_and_swap(true, false)} ${flag.get()}")
  let hits = Atomic[Int].new(0)
  let top = Atomic[Int].new(0)
  scope s {
    for i in 0..8 {
      s.spawn(fn() {
        for k in 0..1000 {
          let _ = hits.add(1)
          let _ = top.max(i * 1000 + k)
          var done = false
          while !done {
            let v = a.get()
            done = a.compare_and_swap(v, v + 2)
          }
        }
      })
    }
  }
  os.stdio.println("tasks ${hits.get()} ${top.get()} ${a.get()}")
  let big = Atomic[Int].new(9223372036854775800)
  os.stdio.println("near ${bump(big, 7)}")
  os.stdio.println("never ${bump(big, 1)}")
}
