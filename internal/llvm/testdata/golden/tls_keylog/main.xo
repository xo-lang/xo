// std/tls's key_log (decision 0644 T8): Go's KeyLogWriter on both ends
// of a TLS 1.3 and a TLS 1.2 connection: the NSS key log lines (labels,
// one client random, the same secrets on both ends; TestKeyLogTLS12 and
// TestKeyLogTLS13 of handshake_client_test.go) and a failing writer on
// either end, with Go's errors.
use std/tls
use std/x509
use std/crypto
use std/base64
use std/netip

struct Issued {
  cert: x509.Certificate
  key: crypto.PrivateKey
}

/// A PEM block of der on one line (PEM readers ignore line lengths).
fn pem_block(kind: Str, der: Bytes) -> Bytes {
  "-----BEGIN ${kind}-----\n${base64.encode(der)}\n-----END ${kind}-----\n".bytes()
}

fn issue(os: Os, name: Str, parent: Issued?, ca: Bool, eku: List[x509.ExtKeyUsage], now: Time) -> Issued uses rand {
  let key = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256).or_fault("key")
  let usage = if ca { [x509.KeyUsage.CertSign, x509.KeyUsage.DigitalSignature] } else { [x509.KeyUsage.DigitalSignature] }
  let ips = if ca { [] } else { [netip.parse_addr("127.0.0.1").or_fault("ip")] }
  let t = x509.Template{subject: x509.Name{common_name: name}, not_before: now - 1h, not_after: now + 24h, ip_addresses: ips, is_ca: ca, key_usage: usage, ext_key_usage: eku}
  let (pc, pk) = match parent {
    Some(p) => (Some(p.cert), p.key)
    None => (None, key)
  }
  Issued{cert: x509.create_certificate(os.rand, t, key.public_key(), pc, pk).or_fault("cert ${name}"), key: key}
}

fn tls_pair(i: Issued, chain: List[x509.Certificate]) -> tls.TlsCert {
  var pem = i.cert.pem()
  for c in chain {
    pem = pem + c.pem()
  }
  tls.cert(pem, pem_block("PRIVATE KEY", crypto.marshal_private_key(i.key))).or_fault("pair")
}



/// One line's shape: its label, the client random's and the secret's
/// hex lengths, and whether it ends with a newline.
fn shape(l: Str) -> Str {
  let f = l.trim_end().split(" ")
  if f.len() != 3 {
    return "bad line"
  }
  "${f[0]} ${f[1].len()} ${f[2].len()} newline ${l.ends_with("\n")}"
}

fn logger(m: Mutex[List[Str]], fail: Str) -> fn(Str) -> () ! Str uses sync {
  fn(line: Str) -> () ! Str uses sync {
    if !fail.is_empty() {
      return Err(fail)
    }
    m.with(fn(var l: List[Str]) { l.push(line) })
    Ok(())
  }
}

fn serve_one(l: tls.TlsListener) -> Str uses net {
  let c = match l.accept() {
    Ok(c) => c
    Err(e) => return "accept: ${e}"
  }
  let r = match c.handshake() {
    Ok(_) => match c.read(16) {
      Ok(Some(b)) => "ok, read ${b.to_str() ?? "?"}"
      Ok(None) => "ok, read EOF"
      Err(e) => "ok, read: ${e}"
    }
    Err(e) => "${e}"
  }
  c.close()
  r
}

fn run(os: Os, v: Int, cfg: tls.ServerConfig, roots: tls.Roots, ccfg: tls.ClientConfig) -> Str uses net, clock {
  let tl = tls.listen(os.net, "127.0.0.1:0", cfg).or_fault("listen")
  var out = ""
  scope s {
    let t = s.spawn(fn() -> Str { serve_one(tl) })
    let cr = match tls.dial_config(os.net, tl.addr(), ccfg with {roots: Some(roots), max_version: v}, timeout: Some(5s)) {
      Ok(c) => {
        let w = match c.write(b"hi") {
          Ok(_) => "ok"
          Err(e) => "write: ${e}"
        }
        c.close()
        w
      }
      Err(e) => "${e}"
    }
    out = "client ${cr}; server ${t.await}"
  }
  tl.close()
  out
}

fn main(os: Os) uses net, stdio, rand, clock {
  let now = os.clock.now()
  let ca = issue(os, "Xo Test CA", None, true, [], now)
  let server = issue(os, "server", Some(ca), false, [x509.ExtKeyUsage.ServerAuth], now)
  let roots = tls.roots_of([ca.cert]).or_fault("roots")
  let pair = tls_pair(server, [])
  for v in [tls.VERSION_TLS13, tls.VERSION_TLS12] {
    os.stdio.println("== ${tls.version_name(v)}")
    let cm = Mutex[List[Str]].new([])
    let sm = Mutex[List[Str]].new([])
    let r = run(os, v, tls.ServerConfig{certificates: [pair], key_log: Some(logger(sm, ""))}, roots, tls.ClientConfig{server_name: "127.0.0.1", key_log: Some(logger(cm, ""))})
    os.stdio.println("both log: ${r}")
    let cl = cm.with(fn(var l: List[Str]) -> List[Str] { l })
    let sl = sm.with(fn(var l: List[Str]) -> List[Str] { l })
    for l in cl {
      os.stdio.println("  client ${shape(l)}")
    }
    os.stdio.println("  server lines ${sl.len()}, the client's: ${sl == cl}")
    var randoms: List[Str] = []
    for l in cl {
      randoms.push(l.split(" ")[1])
    }
    os.stdio.println("  one client random: ${randoms.all(fn(x: Str) -> Bool { x == randoms[0] })}")
    os.stdio.println("client only: ${run(os, v, tls.ServerConfig{certificates: [pair]}, roots, tls.ClientConfig{server_name: "127.0.0.1", key_log: Some(logger(Mutex[List[Str]].new([]), ""))})}")
    os.stdio.println("client key_log fails: ${run(os, v, tls.ServerConfig{certificates: [pair]}, roots, tls.ClientConfig{server_name: "127.0.0.1", key_log: Some(logger(cm, "disk full"))})}")
    os.stdio.println("client key_log empty Err: ${run(os, v, tls.ServerConfig{certificates: [pair]}, roots, tls.ClientConfig{server_name: "127.0.0.1", key_log: Some(fn(l: Str) -> () ! Str { Err("") })})}")
    os.stdio.println("server key_log fails: ${run(os, v, tls.ServerConfig{certificates: [pair], key_log: Some(logger(sm, "disk full"))}, roots, tls.ClientConfig{server_name: "127.0.0.1"})}")
  }
  os.stdio.println("done")
}
