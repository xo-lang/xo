// A `var` argument that is an element of a list (`step(c.items[i])`)
// with a large struct element: the native backends pass the element at
// its slot in the list instead of copying it out and back (list element
// homes, 2026-11-04). Values stay values: a copy of the list taken
// before is unchanged, and a fault in the callee leaves the list
// releasable (the leak check counts every allocation).
use std/task

struct Big {
  name: Str
  tags: List[Str]
  a0: Int
  a1: Int
  a2: Int
  a3: Int
  a4: Int
  a5: Int
  a6: Int
  a7: Int
  a8: Int
  a9: Int
  b0: Int
  b1: Int
  b2: Int
  b3: Int
  b4: Int
  b5: Int
  b6: Int
  b7: Int
  b8: Int
  b9: Int
  c0: Int
  c1: Int
  c2: Int
  c3: Int
  c4: Int
  c5: Int
  c6: Int
  c7: Int
  c8: Int
  c9: Int
}

struct Holder {
  items: List[Big]
  n: Int
}

fn big(name: Str) -> Big {
  Big{name: name, tags: [], a0: 0, a1: 1, a2: 2, a3: 3, a4: 4, a5: 5, a6: 6, a7: 7, a8: 8, a9: 9, b0: 0, b1: 0, b2: 0, b3: 0, b4: 0, b5: 0, b6: 0, b7: 0, b8: 0, b9: 0, c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0, c8: 0, c9: 9}
}

fn step(var b: Big, k: Int) {
  b.a0 += k
  b.c9 += 1
  b.tags.push("t${k}")
  b.name = "${b.name}+"
}

fn step_fault(var b: Big, k: Int) {
  b.tags.push("before")
  if k > 2 {
    fault("step ${k} on ${b.name}")
  }
  b.a0 += k
}

fn show(b: Big) -> Str {
  "${b.name} a0=${b.a0} c9=${b.c9} tags=${b.tags.len()}"
}

fn main(os: Os) {
  let io = os.stdio
  var h = Holder{items: [big("x"), big("y"), big("z")], n: 0}
  for i in 0..3 {
    step(h.items[i], i + 1)
  }
  step(h.items[1], 10)
  io.println("${show(h.items[0])} | ${show(h.items[1])} | ${show(h.items[2])}")

  // a copy kept: the update goes to h's list, the copy keeps its value
  let before = h.items
  step(h.items[2], 100)
  io.println("copy ${show(before[2])} now ${show(h.items[2])}")

  // a local list
  var xs = [big("p"), big("q")]
  var j = 0
  while j < 4 {
    step(xs[j % 2], j)
    j += 1
  }
  io.println("${show(xs[0])} | ${show(xs[1])}")

  // a fault in the callee unwinds with the list still releasable
  let r = task.isolate(fn() -> Int ! () {
    var ys = [big("f"), big("g")]
    step_fault(ys[0], 1)
    step_fault(ys[1], 5)
    ys.len()
  })
  match r {
    Ok(n) => io.println("ok ${n}")
    Err(task.Isolated.Faulted(info)) => io.println("fault: ${info.msg}")
    Err(_) => io.println("failed")
  }
}
