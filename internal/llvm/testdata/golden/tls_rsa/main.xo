// RSA of the native backends' TLS (std/native/llrt/bigmod.xo and
// rsa.xo, the zero-C audit's B31) against Go's crypto/rsa through
// internal.crypto_op: PKCS #1 and PKCS #8 keys of 2048, 1536, and 3001
// bits (a modulus that is no whole number of limbs or bytes), PKCS #1
// v1.5 signatures (deterministic, so compared byte for byte) with
// SHA-256, SHA-384, and SHA-512, PSS signatures from Go verified here
// and made here verified here, and changed inputs.
use std/crypto
use std/internal

const KEY0: Str = ""
const PSS0: Str = ""
const KEY1: Str = ""
const PSS1: Str = ""
const KEY2: Str = ""
const PSS2: Str = ""

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

fn op(name: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes { internal.crypto_op(name, a, b, c, d) }

fn id(h: Int) -> Bytes {
  var b = BytesBuilder.new()
  b.write_byte(UInt8(h))
  b.freeze()
}

/// b with its last byte changed.
fn flip(b: Bytes) -> Bytes {
  var out = BytesBuilder.new()
  for i in 0..b.len() {
    out.write_byte(if i == b.len() - 1 { b[i] ^ 1 } else { b[i] })
  }
  out.freeze()
}

fn main(os: Os) uses stdio, rand {
  let keys = [hex(KEY0), hex(KEY1), hex(KEY2)]
  let pss = [hex(PSS0), hex(PSS1), hex(PSS2)]
  let h256 = crypto.sha256(b"xo")
  let hashes = [h256, op("hash.sha384", b"xo", b"", b"", b""), op("hash.sha512", b"xo", b"", b"", b"")]
  for (i, k) in keys.indexed() {
    let pk = op("rsa.public", k, b"", b"", b"")
    os.stdio.println("key ${i} public ${pk.len()} ${crypto.sha256(pk).to_hex()}")
    for h in 0..3 {
      let sig = op("rsa.sign_pkcs1", id(h), k, hashes[h], b"")
      os.stdio.println("key ${i} pkcs1 ${h} ${crypto.sha256(sig).to_hex()} verify ${op("rsa.verify_pkcs1", id(h), pk, hashes[h], sig).to_hex()} changed ${op("rsa.verify_pkcs1", id(h), pk, flip(hashes[h]), sig).to_hex()}")
      let ps = op("rsa.sign_pss", id(h), k, hashes[h], b"")
      os.stdio.println("key ${i} pss ${h} ${ps.len()} verify ${op("rsa.verify_pss", id(h), pk, hashes[h], ps).to_hex()} changed ${op("rsa.verify_pss", id(h), pk, hashes[h], flip(ps)).to_hex()} as pkcs1 ${op("rsa.verify_pkcs1", id(h), pk, hashes[h], ps).to_hex()}")
    }
    os.stdio.println("key ${i} go pss ${op("rsa.verify_pss", id(0), pk, h256, pss[i]).to_hex()} wrong hash id ${op("rsa.verify_pss", id(1), pk, h256, pss[i]).to_hex()}")
  }
  os.stdio.println("bad key ${op("rsa.public", flip(keys[0]), b"", b"", b"").len()} ${op("rsa.sign_pkcs1", id(0), b"", h256, b"").len()}")
  let pk = op("rsa.public", keys[0], b"", b"", b"")
  os.stdio.println("short hash ${op("rsa.sign_pkcs1", id(0), keys[0], h256[0..31], b"").len()} long sig ${op("rsa.verify_pkcs1", id(0), pk, h256, hex(PSS2)).to_hex()}")
}
