const X25519_PKCS8: Str = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VuBCIEIKB/J/cPamoH+vnAmuBxpW1gcQsgzgofsDOWEvXIoK49\n-----END PRIVATE KEY-----\n"
const BAD_KEY: Str = "-----BEGIN PRIVATE KEY-----\nMAMCAQA=\n-----END PRIVATE KEY-----\n"

fn pair(os: Os, label: Str, c: Str, k: Str) -> http.TlsCert? {
  match http.tls_cert(c.bytes(), k.bytes()) {
    Ok(tc) => {
      os.stdio.println("${label}: ok")
      Some(tc)
    }
    Err(e) => {
      os.stdio.println("${label}: ${e.msg}")
      None
    }
  }
}

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello over tls") })
  r
}

fn main(os: Os) {
  let rsa1 = pair(os, "rsa pkcs1", RSA_CERT, RSA_PKCS1)
  let rsa8 = pair(os, "rsa pkcs8", RSA_CERT, RSA_PKCS8)
  let ec1 = pair(os, "p-256 sec1", EC_CERT, EC_SEC1)
  let ec8 = pair(os, "p-256 pkcs8", EC_CERT, EC_PKCS8)
  let e31 = pair(os, "p-384 sec1", EC384_CERT, EC384_SEC1)
  let e38 = pair(os, "p-384 pkcs8", EC384_CERT, EC384_PKCS8)
  let ed = pair(os, "ed25519 pkcs8", ED_CERT, ED_PKCS8)
  let _ = pair(os, "other rsa key", RSA_CERT, RSA2_PKCS1)
  let _ = pair(os, "rsa cert, ec key", RSA_CERT, EC_SEC1)
  let _ = pair(os, "p-256 cert, p-384 key", EC_CERT, EC384_SEC1)
  let _ = pair(os, "p-256 cert, ed25519 key", EC_CERT, ED_PKCS8)
  let _ = pair(os, "ed25519 cert, rsa key", ED_CERT, RSA_PKCS8)
  let _ = pair(os, "ed25519 cert, other key type", ED_CERT, EC_PKCS8)
  let _ = pair(os, "x25519 key", EC_CERT, X25519_PKCS8)
  let _ = pair(os, "bad key", EC_CERT, BAD_KEY)
  let goods = [("rsa pkcs1", RSA_CERT, rsa1), ("rsa pkcs8", RSA_CERT, rsa8), ("p-256 sec1", EC_CERT, ec1), ("p-256 pkcs8", EC_CERT, ec8), ("p-384 sec1", EC384_CERT, e31), ("p-384 pkcs8", EC384_CERT, e38)]
  // (not Ed25519 here: golden tls13_server serves an Ed25519 certificate)
  if !ed.is_some() {
    os.stdio.println("ed25519: none?")
  }
  for (label, c, tc) in goods {
    let l = os.net.listen("127.0.0.1:0").or_fault("listen")
    let srv = http.server(l, routes()).with_tls([tc.or_fault(label)])
    let cl = http.client(os.net, timeout: 5s).with_roots(c.bytes()).or_fault("roots")
    scope s {
      s.spawn_background(fn() {
        match srv.serve() {
          Ok(_) => ()
          Err(e) => os.stdio.println("serve failed: ${e}")
        }
      })
      match cl.get("https://${l.addr()}/hello") {
        Ok(resp) => os.stdio.println("get ${label}: ${resp.status} ${resp.body.to_str() ?? "?"}")
        Err(e) => os.stdio.println("get ${label}: ${e}")
      }
    }
  }
  os.stdio.println("done")
}
