// std/sql's Postgres driver (decision 0278) against fake servers on
// real local sockets: trust login, a simple query and an exec, errors in
// a result by SQLSTATE, cleartext passwords, and a server that goes away
// (the pool reconnects). The fakes answer with the backend messages a
// PostgreSQL 17 sends (recorded with pgx against a server in Docker).
// Native only: Postgres has no Go backend driver (spec/std.md 10).
use std/sql

// ---- a fake backend ----

fn be32(n: Int) -> Bytes {
  var b = BytesBuilder.with_capacity(4)
  for k in 0..4 {
    b.write_byte(UInt8((n >> (24 - 8 * k)) & 255))
  }
  b.freeze()
}

fn be16(n: Int) -> Bytes { be32(n)[2..] }

fn get32(b: Bytes, at: Int) -> Int {
  var n = 0
  for k in 0..4 {
    n = n * 256 + Int(b[at + k])
  }
  n
}

fn m(kind: Str, body: Bytes) -> Bytes { kind.bytes() + be32(body.len() + 4) + body }

fn cs(s: Str) -> Bytes { s.bytes() + b"\x00" }

fn auth_ok() -> Bytes { m("R", be32(0)) }
fn auth_cleartext() -> Bytes { m("R", be32(3)) }
fn ready() -> Bytes { m("Z", b"I") }
fn key_data() -> Bytes { m("K", be32(77) + be32(1234)) }
fn complete(tag: Str) -> Bytes { m("C", cs(tag)) }

/// RowDescription with each column's name and type OID.
fn row_desc(cols: List[(Str, Int)]) -> Bytes {
  var b = be16(cols.len())
  for (name, oid) in cols {
    b = b + cs(name) + be32(0) + be16(0) + be32(oid) + be16(-1) + be32(-1) + be16(0)
  }
  m("T", b)
}

fn data_row(vals: List[Str?]) -> Bytes {
  var b = be16(vals.len())
  for v in vals {
    b = b + match v {
      Some(s) => be32(s.len()) + s.bytes()
      None => be32(-1)
    }
  }
  m("D", b)
}

fn error_resp(code: Str, msg: Str, constraint: Str) -> Bytes {
  var b = cs("SERROR") + cs("C" + code) + cs("M" + msg)
  if !constraint.is_empty() {
    b = b + cs("n" + constraint)
  }
  m("E", b + b"\x00")
}

/// Reads one frontend message (or the startup packet when untyped) from c.
fn read_msg(c: ServerConn, var buf: Bytes, untyped: Bool) -> (Str, Bytes, Bytes) ! NetErr {
  while {
    let need = if untyped { 4 } else { 5 }
    if buf.len() >= need {
      let n = if untyped { get32(buf, 0) } else { 1 + get32(buf, 1) }
      if buf.len() >= n {
        let kind = if untyped { "" } else { buf[0..1].to_str() ?? "?" }
        let body = if untyped { buf[4..n] } else { buf[5..n] }
        return (kind, body, buf[n..])
      }
    }
    match c.read(4096)? {
      Some(b) => buf = buf + b
      None => return ("", b"", b"")
    }
  }
  ("", b"", b"")
}

/// A fake server: after startup, answer(kind, body) gives the bytes for
/// each message; the conversation ends at Terminate or end of stream.
fn serve(l: Listener, hello: Bytes, answer: fn(Str, Bytes) -> Bytes) -> () ! NetErr {
  while let Ok(c) = l.accept() {
    var buf = b""
    let (_, _, rest) = read_msg(c, buf, true)?
    buf = rest
    c.write(hello)?
    while {
      let (kind, body, rest2) = read_msg(c, buf, false)?
      buf = rest2
      if kind.is_empty() || kind == "X" {
        break
      }
      let out = answer(kind, body)
      if out.is_empty() {
        continue
      }
      c.write(out)?
    }
    c.close()
  }
}

fn hello_trust() -> Bytes { auth_ok() + key_data() + ready() }


fn dsn(addr: Str) -> Str { "postgres://app@${addr}/app?sslmode=disable" }

fn query_server(kind: Str, body: Bytes) -> Bytes {
  if kind != "Q" {
    return b""
  }
  let q = body[0..body.len() - 1].to_str() ?? ""
  if q.starts_with("SELECT") {
    return row_desc([("id", 23), ("name", 25), ("ok", 16), ("at", 1184)]) +
      data_row([Some("1"), Some("a"), Some("t"), Some("2026-10-20 12:34:56.5+00")]) +
      data_row([Some("2"), None, Some("f"), None]) + complete("SELECT 2") + ready()
  }
  complete("UPDATE 3") + ready()
}

fn error_server(kind: Str, body: Bytes) -> Bytes {
  if kind != "Q" {
    return b""
  }
  let q = body[0..body.len() - 1].to_str() ?? ""
  match q {
    "-- ping" => complete("") + ready()
    "dup" => error_resp("23505", "duplicate key value violates unique constraint \"t_name_key\"", "t_name_key") + ready()
    "syntax" => error_resp("42601", "syntax error at or near \"SELEC\"", "") + ready()
    "table" => error_resp("42P01", "relation \"nope\" does not exist", "") + ready()
    "zero" => error_resp("22012", "division by zero", "") + ready()
    _ => complete("SELECT 0") + ready()
  }
}

fn main(os: Os) ! {
  let l1 = os.net.listen("127.0.0.1:0")?
  let l2 = os.net.listen("127.0.0.1:0")?
  let l3 = os.net.listen("127.0.0.1:0")?
  let l4 = os.net.listen("127.0.0.1:0")?
  let got: Mutex[List[Str]] = Mutex.new([])
  let calls = Atomic.new(0)
  scope s {
    s.spawn_background(fn() -> () ! NetErr { serve(l1, hello_trust(), query_server)? })
    s.spawn_background(fn() -> () ! NetErr { serve(l2, hello_trust(), error_server)? })
    s.spawn_background(fn() -> () ! NetErr {
      serve(l3, auth_cleartext(), fn(kind, body) {
        if kind == "p" {
          got.with(fn(var xs) { xs.push(body[0..body.len() - 1].to_str() ?? "?") })
          return auth_ok() + ready()
        }
        complete("") + ready()
      })?
    })
    s.spawn_background(fn() -> () ! NetErr {
      while let Ok(c) = l4.accept() {
        var buf = b""
        let (_, _, rest) = read_msg(c, buf, true)?
        buf = rest
        c.write(hello_trust())?
        while {
          let (kind, _, rest2) = read_msg(c, buf, false)?
          buf = rest2
          if kind.is_empty() || kind == "X" {
            break
          }
          // the second statement: the server closes the connection
          if kind == "Q" && calls.add(1) == 2 {
            break
          }
          c.write(complete("SELECT 0") + ready())?
        }
        c.close()
      }
    })
    let db = sql.open(os.net, "postgres", dsn(l1.addr()))?
    let rows = db.query("SELECT id, name, ok, at FROM t")?
    os.stdio.println("rows ${rows.len()} ${rows[0].int("id").debug()} ${rows[0].str("name").debug()} ${rows[0].bool("ok").debug()} ${rows[0].time("at").map(fn(t) { t.unix_millis() }).debug()} ${rows[1].str_opt("name").debug()}")
    os.stdio.println("exec ${db.exec("UPDATE t SET x = 1").map(fn(r) { r.rows_affected }).debug()}")
    let db2 = sql.open(os.net, "postgres", dsn(l2.addr()))?
    for q in ["dup", "syntax", "table", "zero", "other"] {
      os.stdio.println("${q}: ${db2.exec(q).map(fn(r) { r.rows_affected }).debug()}")
    }
    let a3 = l3.addr()
    let hp = a3.split(":")
    let db3 = sql.open(os.net, "postgres", "host=${hp[0]} port=${hp[1]} user=app password='p w' sslmode=disable")?
    os.stdio.println("ping ${db3.ping().is_ok()} password ${got.with(fn(xs) { xs }).debug()}")
    let db4 = sql.open(os.net, "postgres", dsn(l4.addr()), max_open: 1)?
    os.stdio.println("gone ${db4.exec("x").map(fn(r) { r.rows_affected }).debug()}")
    os.stdio.println("again ${db4.exec("y").is_ok()}")
    s.cancel()
  }
}
