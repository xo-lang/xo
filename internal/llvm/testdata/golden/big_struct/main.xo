fn digest(b: Big) -> Int { b.i0 + b.i37 + b.i74 + b.i111 + b.i148 + b.i185 + b.i222 + b.i259 + b.i296 + b.s0.len() + b.s41.len() + b.s82.len() + b.s123.len() + b.s164.len() + b.s205.len() + b.s246.len() + b.s287.len() }

fn maybe(base: Int) -> Big ! Str {
  if base < 0 {
    return Err("negative")
  }
  make(base)
}

fn bump(var b: Big) {
  b.i0 += 1
  b.s299 = b.s299 + "!"
}

fn main(os: Os) {
  let a = make(1)
  var c = a
  bump(c)
  os.stdio.println("copy: a ${digest(a)} c ${digest(c)} a.i0 ${a.i0} c.i0 ${c.i0} c.s299 ${c.s299}")
  match maybe(2) {
    Ok(b) => os.stdio.println("result: ${digest(b)}")
    Err(e) => os.stdio.println("result: ${e}")
  }
  match maybe(-1) {
    Ok(b) => os.stdio.println("result: ${digest(b)}")
    Err(e) => os.stdio.println("result: ${e}")
  }
  let o: Big? = Some(make(3))
  os.stdio.println("option: ${o.map(fn(b) { digest(b) }) ?? -1}")
  var xs: List[Big] = []
  for k in 0..5 {
    xs.push(make(k * 10))
  }
  xs[2] = c
  var total = 0
  for b in xs {
    total += digest(b)
  }
  os.stdio.println("list: ${xs.len()} ${total}")
  var m: Map[Str, Big] = {}
  m.put("a", a)
  m.put("c", c)
  let m2 = m
  m.put("a", make(9))
  os.stdio.println("map: ${digest(m.get("a") ?? a)} ${digest(m2.get("a") ?? c)} ${m.len()}")
  let f = fn(k: Int) -> Int { digest(c) + k }
  os.stdio.println("closure: ${f(5)}")
  let h = Holder.Full(b: make(4))
  let hs = [h, Holder.Empty, h]
  var hn = 0
  for x in hs {
    match x {
      Holder.Full(b) => hn += b.i1
      Holder.Empty => hn += 1000
    }
  }
  os.stdio.println("enum: ${hn}")
  let rs = task.map_concurrent([1, 2, 3, 4], 2, fn(k) { make(k) })
  var rt = 0
  for r in rs {
    match r {
      Ok(b) => rt += digest(b)
      Err(_) => rt -= 1
    }
  }
  os.stdio.println("tasks: ${rt}")
}
