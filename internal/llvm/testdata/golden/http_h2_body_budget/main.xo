use std/http

// One HTTP/2 connection's buffered request bodies are capped at four
// times the body limit (XO_HTTP_MAX_BODY, 1 MiB here), by flow control:
// the native server gives the connection window back only while the
// bodies it buffered plus the window the client holds stay within the
// budget, and refuses a stream (RST_STREAM REFUSED_STREAM, before a
// handler saw it) only when the client has no window left and no body
// can end. A raw client that keeps to the windows sends eight uploads of
// 900 KB on one connection, interleaved: what it sent on unfinished
// streams stays within the budget, it never waits on a window that does
// not come, and each stream is answered or refused. The Go backend
// (net/http) reads the bodies as they come, so none is refused and the
// unfinished bodies are not bounded this way.

/// A frame header: length, type, flags, stream id.
fn frame(ty: Int, flags: Int, sid: Int, payload: Bytes) -> Bytes {
  let n = payload.len()
  var b = BytesBuilder.new()
  b.write_byte(UInt8((n >> 16) & 255))
  b.write_byte(UInt8((n >> 8) & 255))
  b.write_byte(UInt8(n & 255))
  b.write_byte(UInt8(ty))
  b.write_byte(UInt8(flags))
  b.write_byte(UInt8((sid >> 24) & 127))
  b.write_byte(UInt8((sid >> 16) & 255))
  b.write_byte(UInt8((sid >> 8) & 255))
  b.write_byte(UInt8(sid & 255))
  b.write(payload)
  b.freeze()
}

/// HPACK literal fields without indexing, new names.
fn fields(kv: List[(Str, Str)]) -> Bytes {
  var b = BytesBuilder.new()
  for (k, v) in kv {
    b.write_byte(0)
    b.write_byte(UInt8(k.len()))
    b.write(k.bytes())
    b.write_byte(UInt8(v.len()))
    b.write(v.bytes())
  }
  b.freeze()
}

fn u32(b: Bytes, i: Int) -> Int { (Int(b[i]) << 24) | (Int(b[i + 1]) << 16) | (Int(b[i + 2]) << 8) | Int(b[i + 3]) }

/// The server's frames so far: the connection window granted, the
/// initial stream window, and per stream (1, 3, ... 15) whether it was
/// refused and whether it was answered.
fn scan(all: Bytes) -> (Int, Int, List[Bool], List[Bool]) {
  var conn = 65535
  var swin = 65535
  var refused = [false, false, false, false, false, false, false, false]
  var answered = [false, false, false, false, false, false, false, false]
  var at = 0
  while at + 9 <= all.len() {
    let n = (Int(all[at]) << 16) | (Int(all[at + 1]) << 8) | Int(all[at + 2])
    if at + 9 + n > all.len() {
      break
    }
    let ty = all[at + 3]
    let sid = u32(all, at + 5) & 0x7fffffff
    let i = (sid - 1) / 2
    if ty == 4 && (Int(all[at + 4]) & 1) == 0 {
      var k = at + 9
      while k + 6 <= at + 9 + n {
        if ((Int(all[k]) << 8) | Int(all[k + 1])) == 4 { swin = u32(all, k + 2) }
        k += 6
      }
    }
    if ty == 8 && sid == 0 { conn += u32(all, at + 9) }
    if ty == 3 && sid % 2 == 1 && i < 8 && u32(all, at + 9) == 7 { refused[i] = true }
    if ty == 1 && sid % 2 == 1 && i < 8 { answered[i] = true }
    at += 9 + n
  }
  (conn, swin, refused, answered)
}

fn main(os: Os) ! {
  var r = http.router()
  r.handle("POST /up", fn(req) { http.text(200, "${req.body.len()}") })
  r.handle("GET /ok", fn(_req) { http.text(200, "ok") })
  let srv = http.server(os.net.listen("127.0.0.1:0")?, r).with_protocols(#{http.Protocol.Http1, http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { srv.serve().or_fault("serve") })
    let c = os.net.dial(srv.addr())?
    c.write(b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")?
    c.write(frame(4, 0, 0, b""))?
    let got = Mutex.new(b"")
    s.spawn_background(fn() {
      while true {
        match c.read(65536) {
          Ok(Some(b)) => got.with(fn(var g) { g = g + b })
          _ => break
        }
      }
    })
    os.clock.sleep(300ms)
    let total = 900000
    let chunk = Bytes.from_hex("61".repeat(15000)) ?? b""
    for i in 0..8 {
      c.write(frame(1, 4, 2 * i + 1, fields([(":method", "POST"), (":scheme", "http"), (":authority", "s"), (":path", "/up"), ("content-length", "${total}")])))?
    }
    var left = [total, total, total, total, total, total, total, total]
    var sent = 0
    var peak = 0
    var stalled = false
    var swin_ok = true
    while !stalled {
      let (conn, swin, refused, _) = scan(got.with_read(fn(g) { g }))
      swin_ok = swin_ok && swin >= total
      // the bytes on streams neither ended nor refused
      var open = 0
      var live = 0
      for i in 0..8 {
        if !refused[i] && left[i] > 0 {
          live += 1
          open += total - left[i]
        }
      }
      peak = peak.max(open)
      if live == 0 {
        break
      }
      var room = conn - sent
      if room <= 0 {
        // wait for a grant or a refusal; none in 3 s is a stall
        var waited = 0
        while waited < 60 {
          let (c2, _, r2, _) = scan(got.with_read(fn(g) { g }))
          if c2 != conn || r2 != refused {
            break
          }
          os.clock.sleep(50ms)
          waited += 1
        }
        stalled = waited == 60
        continue
      }
      for i in 0..8 {
        if !refused[i] && left[i] > 0 && room > 0 {
          let k = left[i].min(15000).min(room)
          left[i] -= k
          c.write(frame(0, if left[i] == 0 { 1 } else { 0 }, 2 * i + 1, chunk[0..k]))?
          sent += k
          room -= k
        }
      }
    }
    var waited = 0
    var done = false
    while waited < 100 && !done {
      let (_, _, refused, answered) = scan(got.with_read(fn(g) { g }))
      done = true
      for i in 0..8 {
        done = done && (refused[i] || answered[i])
      }
      if !done {
        os.clock.sleep(50ms)
        waited += 1
      }
    }
    let (_, _, refused, answered) = scan(got.with_read(fn(g) { g }))
    var nref = 0
    var nans = 0
    for i in 0..8 {
      if refused[i] { nref += 1 }
      if answered[i] && !refused[i] { nans += 1 }
    }
    c.close()
    os.stdio.println("stream window holds a body: ${swin_ok}")
    os.stdio.println("never stalled: ${!stalled}")
    os.stdio.println("unfinished bodies within the budget: ${peak <= 4 * 1048576}")
    os.stdio.println("streams refused: ${nref > 0}")
    os.stdio.println("every stream answered or refused: ${nref + nans == 8 && nans > 0}")
    let after = http.client(os.net, timeout: 5s).get("http://${srv.addr()}/ok")?
    os.stdio.println("serves after: ${after.status}")
  }
}
