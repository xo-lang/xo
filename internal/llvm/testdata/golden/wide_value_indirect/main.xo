// A value of 1,200 words (C: 6 B of 10 A of 10 Strs) through every
// indirect call kind (decision 0519): a closure taking it, a closure
// returning it, a function value, and an interface method (Display) whose
// receiver it is. The wasm backend passes a value word by word, and a
// WebAssembly engine accepts at most 1,000 parameters or results, so such a
// value goes through memory on both sides of the call.
struct A {
  s0: Str
  s1: Str
  s2: Str
  s3: Str
  s4: Str
  s5: Str
  s6: Str
  s7: Str
  s8: Str
  s9: Str
}
struct B {
  a0: A
  a1: A
  a2: A
  a3: A
  a4: A
  a5: A
  a6: A
  a7: A
  a8: A
  a9: A
}
struct C {
  b0: B
  b1: B
  b2: B
  b3: B
  b4: B
  b5: B
}
fn mk_a(t: Str) -> A {
  A{s0: "${t}.0", s1: "${t}.1", s2: "${t}.2", s3: "${t}.3", s4: "${t}.4", s5: "${t}.5", s6: "${t}.6", s7: "${t}.7", s8: "${t}.8", s9: "${t}.9"}
}
fn mk_b(t: Str) -> B {
  B{a0: mk_a("${t}.0"), a1: mk_a("${t}.1"), a2: mk_a("${t}.2"), a3: mk_a("${t}.3"), a4: mk_a("${t}.4"), a5: mk_a("${t}.5"), a6: mk_a("${t}.6"), a7: mk_a("${t}.7"), a8: mk_a("${t}.8"), a9: mk_a("${t}.9")}
}
fn mk_c(t: Str) -> C {
  C{b0: mk_b("${t}.0"), b1: mk_b("${t}.1"), b2: mk_b("${t}.2"), b3: mk_b("${t}.3"), b4: mk_b("${t}.4"), b5: mk_b("${t}.5")}
}

fn (c: C) display() -> Str {
  "C(${c.b0.a0.s0} ${c.b5.a9.s9})"
}

fn show(d: Display) -> Str {
  d.display()
}

fn pick(c: C) -> Str {
  c.b3.a4.s5
}

fn apply(f: fn(C) -> Str, c: C) -> Str {
  f(c)
}

fn main(os: Os) {
  let tag = "a long tag past the inline Str size"
  let c = mk_c(tag)
  let first = fn(x: C) -> Str { x.b0.a0.s0 }
  let make = fn(t: Str) -> C { mk_c(t) }
  os.stdio.println(first(c))
  let m = make("m")
  os.stdio.println(m.b5.a9.s9)
  os.stdio.println(apply(pick, c))
  os.stdio.println(apply(first, m))
  os.stdio.println(show(c))
  os.stdio.println("${m}")
}
