enum StoreErr {
  Missing(key: Str)
} derive Display

interface Store {
  fn get(self, key: Str) -> Str ! StoreErr
  fn name(self) -> Str
}

struct MapStore {
  data: Map[Str, Str]
}

fn (s: MapStore) get(key: Str) -> Str ! StoreErr {
  s.data.get(key).or_err(StoreErr.Missing(key: key))?
}

fn (s: MapStore) name() -> Str { "map" }

struct ConstStore {
  value: Str
}

fn (s: ConstStore) get(key: Str) -> Str { "${s.value}:${key}" }

fn (s: ConstStore) name() -> Str { "const" }

fn lookup(st: Store, key: Str) -> Str {
  match st.get(key) {
    Ok(v) => "${st.name()} ${v}"
    Err(e) => "${st.name()} ${e}"
  }
}

fn describe_all[T: Display](items: List[T]) -> Str {
  items.map(fn(i) { i.display() }).join(", ")
}

fn main(os: Os) {
  let stores: List[Store] = [MapStore{data: {"a": "1"}}, ConstStore{value: "c"}]
  for st in stores {
    os.stdio.println(lookup(st, "a"))
    os.stdio.println(lookup(st, "b"))
  }
  os.stdio.println(describe_all([StoreErr.Missing(key: "k")]))
  let shown: List[Display] = [1, "two", 3.5]
  for d in shown {
    os.stdio.print("${d.display()};")
  }
  os.stdio.println("")
}
