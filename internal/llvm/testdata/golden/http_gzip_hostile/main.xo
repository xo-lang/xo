// A hostile gzip response to a streaming HTTP client (0.51.1, 2026-11-14):
// about 1 MB of gzip (1000 members of 1 MiB of zeros) that inflates to
// 1000 MB. The client hands the body to its Decompressor at most 4 KiB at
// a time (http.xo GZ_SLICE), so one write's output stays near 4 MB however
// much the client reads at once; before, the whole body went in one write
// (heap peak 1409 MB, RSS 1064 MB; now 24 MB on the Mac). The heap's
// high-water mark must stay under 96 MB while the client reads all 1000
// MB, twice (std/debug mem_peak; 0 on the Go backend, whose client is Go's
// own). On linux/arm64 the peak depends on how many 4 MB output buffers are
// live at once, which scheduling decides: host 2 measured 34 to 42 MB alone
// and up to 47 MB with 8 copies running, the full tier 54 MB under suite
// load (task #77, 2026-11-15; XO_HEAP_MID_MAX=65536 did not change it). 96
// MB is 1.8 times the highest and 14 times under the bug it guards.
// Under the free check (XO_FREE_CHECK=1, xo test --check=free) every
// thread holds its last 65536 freed blocks poisoned and mapped (heapos.xo
// FQ_N), and the peak counts them: host 4 measured 96 to 117 MB there
// against 31 to 38 MB without it (task #371, 2026-11-18), so the bound is
// 256 MB, 2.2 times that and still 5.5 times under the bug.
use std/compress
use std/debug
use std/http

const OUT = 1048576000

/// OUT / 1 MiB gzip members of 1 MiB of zeros each, one after another (a
/// gzip stream may hold many members; the client decodes them all, as Go).
fn hostile() -> Bytes {
  let one = compress.gzip(Bytes.zeroed(1048576))
  var b = BytesBuilder.with_capacity(one.len() * (OUT / 1048576))
  for _ in 0..(OUT / 1048576) {
    b.write(one)
  }
  b.freeze()
}

fn main(os: Os) {
  let body = hostile()
  os.stdio.println("gzip body: about ${(body.len() + 512) / 1024} KB for ${OUT / 1048576} MB")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  var r = http.router()
  r.handle("GET /bomb", fn(_req) { http.Response{status: 200, headers: {"Content-Encoding": "gzip", "Content-Type": "text/plain"}, body: body} })
  let srv = http.server(l, r)
  let c = http.client(os.net, timeout: 60s)
  scope s {
    s.spawn_background(fn() { srv.serve().ignore_err("test server") })
    for size in [65536, 1048576] {
      // no Accept-Encoding of its own: the client asks for gzip and
      // decodes it (Go's Transport rule)
      let req = http.new_request("GET", "http://${l.addr()}/bomb")
      match c.open(req) {
        Ok(st) => {
          var total = 0
          var biggest = 0
          var bad = 0
          while let Some(b) = st.read(size).or_fault("read") {
            total += b.len()
            if b.len() > biggest {
              biggest = b.len()
            }
            for i in [0, b.len() - 1] {
              if b[i] != 0 {
                bad += 1
              }
            }
          }
          os.stdio.println("read(${size}): ${total} bytes, no read over ${size}: ${biggest <= size}, nonzero ${bad}")
        }
        Err(e) => os.stdio.println("open: ${e}")
      }
    }
  }
  let peak = debug.mem_peak()
  let bound = if (os.env.get("XO_FREE_CHECK") ?? "") == "1" { 268435456 } else { 100663296 }
  os.stdio.println("heap peak under its bound: ${peak < bound}")
  if peak >= bound {
    os.stdio.eprintln("heap peak ${peak / 1048576} MB, bound ${bound / 1048576} MB")
  }
}
