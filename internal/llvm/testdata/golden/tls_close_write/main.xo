// TlsConn.close_write, local_addr and remote_addr (decision 0644 T11;
// Go's Conn.CloseWrite: close_notify, then the connection's CloseWrite,
// tls_test.go TestConnCloseWrite): a request whose client half closes,
// the response read on the open half, and a write after close_write
// failing with Go's errShutdown text.
use std/http
use std/tls
use std/x509

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello") })
  r
}

fn main(os: Os) {
  let ca = x509.parse_pem(ca_pem()).or_fault("ca")
  let roots = tls.roots_of(ca).or_fault("roots_of")
  let good = http.tls_cert(good_cert(), good_key()).or_fault("good")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l, routes()).with_tls([good])
  scope s {
    s.spawn_background(fn() {
      match srv.serve() {
        Ok(_) => ()
        Err(e) => os.stdio.println("serve failed: ${e}")
      }
    })
    let t = tls.dial(os.net, l.addr(), server_name: "localhost", roots: Some(roots)).or_fault("dial")
    os.stdio.println("remote is the listener: ${t.remote_addr() == l.addr()} local: ${t.local_addr().starts_with("127.0.0.1:")}")
    t.write(b"GET /hello HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_fault("write")
    t.close_write().or_fault("close_write")
    match t.write(b"more") {
      Ok(_) => os.stdio.println("write after close_write: ok")
      Err(e) => os.stdio.println("write after close_write: ${e}")
    }
    var got = b""
    while let Some(b) = t.read(4096).or_fault("read") {
      got = got + b
    }
    let text = got.to_str_lossy()
    os.stdio.println("response: ${text.starts_with("HTTP/1.1 200")} ${text.ends_with("hello")}")
    t.close()
  }
  os.stdio.println("done")
}

