// Division and remainder by constants (decision 0194): the native
// backends lower them to a multiply high and shifts (powers of two to
// shifts); every quotient and remainder of edge dividends by edge
// divisors of both signs must equal the Go backend's. A division by a
// constant -1 still faults on the minimum (fault goldens).

fn d1(a: Int) -> (Int, Int) { (a / 1, a % 1) }
fn d1_q(a: Int) -> Int { a / 1 }
fn d1_r(a: Int) -> Int { a % 1 }
fn dn1(a: Int) -> (Int, Int) { (a / (-1), a % (-1)) }
fn dn1_q(a: Int) -> Int { a / (-1) }
fn dn1_r(a: Int) -> Int { a % (-1) }
fn d2(a: Int) -> (Int, Int) { (a / 2, a % 2) }
fn d2_q(a: Int) -> Int { a / 2 }
fn d2_r(a: Int) -> Int { a % 2 }
fn dn2(a: Int) -> (Int, Int) { (a / (-2), a % (-2)) }
fn dn2_q(a: Int) -> Int { a / (-2) }
fn dn2_r(a: Int) -> Int { a % (-2) }
fn d3(a: Int) -> (Int, Int) { (a / 3, a % 3) }
fn d3_q(a: Int) -> Int { a / 3 }
fn d3_r(a: Int) -> Int { a % 3 }
fn dn3(a: Int) -> (Int, Int) { (a / (-3), a % (-3)) }
fn dn3_q(a: Int) -> Int { a / (-3) }
fn dn3_r(a: Int) -> Int { a % (-3) }
fn d5(a: Int) -> (Int, Int) { (a / 5, a % 5) }
fn d5_q(a: Int) -> Int { a / 5 }
fn d5_r(a: Int) -> Int { a % 5 }
