fn dn7_r(a: Int) -> Int { a % (-7) }
fn d10(a: Int) -> (Int, Int) { (a / 10, a % 10) }
fn d10_q(a: Int) -> Int { a / 10 }
fn d10_r(a: Int) -> Int { a % 10 }
