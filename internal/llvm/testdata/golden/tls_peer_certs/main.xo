// std/tls's peer_certificates and roots_of with std/x509 (std.md 27, 39):
// the chain a local std/http server sends (golden http_tls's test
// certificates), parsed; Roots made of parsed certificates; and std/x509's
// verify of the chain the server sent.
use std/http
use std/tls
use std/x509

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello", fn(_req) { http.text(200, "hello") })
  r
}

fn show(c: x509.Certificate) -> Str {
  "${c.subject.display()} issuer=${c.issuer.display()} ca=${c.is_ca} dns=${c.dns_names.join(",")} ips=${c.ip_addresses.map(fn(a) { a.display() }).join(",")} sig=${c.signature_algorithm}"
}

fn main(os: Os) {
  let ca = x509.parse_pem(ca_pem()).or_fault("ca")
  match tls.roots_of([]) {
    Ok(_) => os.stdio.println("roots_of []: ok?")
    Err(e) => os.stdio.println("roots_of []: ${e.msg}")
  }
  let roots = tls.roots_of(ca).or_fault("roots_of")
  let good = http.tls_cert(good_cert(), good_key()).or_fault("good")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l, routes()).with_tls([good])
  scope s {
    s.spawn_background(fn() {
      match srv.serve() {
        Ok(_) => ()
        Err(e) => os.stdio.println("serve failed: ${e}")
      }
    })
    let c = os.net.dial(l.addr()).or_fault("dial")
    let t = tls.client(c, "127.0.0.1", roots: Some(roots)).or_fault("client")
    let peer = t.peer_certificates()
    os.stdio.println("peer certificates: ${peer.len()}")
    for p in peer {
      os.stdio.println("  ${show(p)}")
    }
    // the server's chain verifies with std/x509 too, at a fixed time
    let opts = x509.VerifyOptions{roots: ca, intermediates: peer[1..peer.len()], dns_name: "good.test", at: Time.from_unix(1767225600)}
    match peer[0].verify(opts) {
      Ok(chains) => os.stdio.println("verify: ${chains.map(fn(ch) { ch.map(fn(x) { x.subject.common_name }).join(" > ") }).join(" | ")}")
      Err(e) => os.stdio.println("verify: ${e.display()}")
    }
    match peer[0].verify(x509.VerifyOptions{roots: ca, dns_name: "other.test", at: Time.from_unix(1767225600)}) {
      Ok(_) => os.stdio.println("verify other name: ok?")
      Err(e) => os.stdio.println("verify other name: ${e.display()}")
    }
    t.close()
  }
  os.stdio.println("done")
}

// ---------------------------------------------------------------------------
