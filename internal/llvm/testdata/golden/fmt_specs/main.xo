// Format specs in interpolation (decision 0617 A, core 1.6): the
// integer and float rows print what Go's fmt prints for the same verbs
// (%6d, %-6d, %06d, %x, %X, %o, %b, %+d, %+08d, %08x; %.2f, %10.3f,
// %-10.1f, %e, %.3e, %g, %.4g, %+.1f, %010.2f, %+e), checked against
// go1.26.1 on 2026-11-12; then text, fill, center, other integer types,
// Float32 and a Display value.

struct P {
  x: Int
}

fn (self: P) display() -> Str { "P(${self.x})" }

fn main(os: Os) {
  let ints = [0, 7, -42, 255, 1 << 40, -9223372036854775807 - 1]
  for n in ints {
    os.stdio.println("${n}|${n:6}|${n:<6}|${n:06}|${n:x}|${n:X}|${n:o}|${n:b}|${n:+}|${n:+08}|${n:08x}")
  }
  let fls = [0.0, 3.14159, -2.5, 1e21, 1.5e-7, 123456.789]
  for f in fls {
    os.stdio.println("${f:.2f}|${f:10.3f}|${f:<10.1f}|${f:e}|${f:.3e}|${f:g}|${f:.4g}|${f:+.1f}|${f:010.2f}|${f:+e}")
  }
  let s = "hi"
  let u: UInt8 = 7
  let big: UInt64 = 18446744073709551615
  let g: Float32 = 1.5
  let p = P{x: 5}
  let m = {"k": 3}
  os.stdio.println("[${s:>5}] [${s:*<5}] [${s:^6}] [${s:é>4}] [${s:1}] [${s:s}]")
  os.stdio.println("[${u:>4}] [${u:04}] [${u:x}] [${big:>22}] [${g:.3f}] [${p:>6}] [${p:-^8}] [${p:?}]")
  os.stdio.println("[${m.get("k") ?? 0:03}] [${1 + 2:>3}] [${-n0():x}]")
}

fn n0() -> Int { 255 }
