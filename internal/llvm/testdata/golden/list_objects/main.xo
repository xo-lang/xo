// The list objects of std/native/llrt/obj.xo (decision 0226): the first
// push to an empty literal's list of elements too large for the small
// classes (each Big is 320 bytes, so 4 of them are past 1,024 bytes: the
// empty literal's growth takes the allocator's slow path), on one thread
// and in tasks; lists of strings (the drop callback per element); a
// shared list updated (the copy); growth from 4 to 4,096 elements.

struct Big {
  f0: Int
  f1: Int
  f2: Int
  f3: Int
  f4: Int
  f5: Int
  f6: Int
  f7: Int
  f8: Int
  f9: Int
  f10: Int
  f11: Int
  f12: Int
  f13: Int
  f14: Int
  f15: Int
  f16: Int
  f17: Int
  f18: Int
  f19: Int
  f20: Int
  f21: Int
  f22: Int
  f23: Int
  f24: Int
  f25: Int
  f26: Int
  f27: Int
  f28: Int
  f29: Int
  f30: Int
  f31: Int
  f32: Int
  f33: Int
  f34: Int
  f35: Int
  f36: Int
  f37: Int
  f38: Int
  f39: Int
}

fn bigs(n: Int) -> List[Big] {
  var xs: List[Big] = []
  for i in 0..n {
    xs.push(Big{f0: i + 0, f1: i + 1, f2: i + 2, f3: i + 3, f4: i + 4, f5: i + 5, f6: i + 6, f7: i + 7, f8: i + 8, f9: i + 9, f10: i + 10, f11: i + 11, f12: i + 12, f13: i + 13, f14: i + 14, f15: i + 15, f16: i + 16, f17: i + 17, f18: i + 18, f19: i + 19, f20: i + 20, f21: i + 21, f22: i + 22, f23: i + 23, f24: i + 24, f25: i + 25, f26: i + 26, f27: i + 27, f28: i + 28, f29: i + 29, f30: i + 30, f31: i + 31, f32: i + 32, f33: i + 33, f34: i + 34, f35: i + 35, f36: i + 36, f37: i + 37, f38: i + 38, f39: i + 39})
  }
  xs
}

fn sum(xs: List[Big]) -> Int {
  var s = 0
  for b in xs {
    s += b.f0 + b.f39
  }
  s
}

fn words(n: Int) -> List[Str] {
  var ws: List[Str] = []
  for i in 0..n {
    ws.push("w${i}")
  }
  ws
}

fn main(os: Os) {
  os.stdio.println("bigs ${sum(bigs(1))} ${sum(bigs(5))} ${sum(bigs(100))}")
  let got = scope s {
    let a = s.spawn(fn() { sum(bigs(7)) })
    let b = s.spawn(fn() { sum(bigs(300)) })
    a.await + b.await
  }
  os.stdio.println("tasks ${got}")
  var total = 0
  for k in 0..50 {
    let ws = words(k)
    total += ws.len()
  }
  os.stdio.println("words ${total} ${words(3).join(",")}")
  let base = words(4)
  var other = base
  other.push("extra")
  other[0] = "changed"
  os.stdio.println("shared ${base.join(",")} | ${other.join(",")}")
  var big: List[Int] = []
  for i in 0..4096 {
    big.push(i)
  }
  os.stdio.println("grow ${big.len()} ${big[4095]}")
}
