// Float arithmetic rounds every operation: no backend may fuse a multiply
// and an add into one (decision 0287, Go's portable math needs it). For
// x = 1 + 2^-30 and y = 1 - 2^-30, x*y is 1 - 2^-60, which rounds to 1.0,
// so x*y - 1 is 0; fused, it is -2^-60. The same through a variable, a
// function, a loop, and Go's math (whose digest changes if any product in
// it is fused), on every backend and optimization level.
fn mul_add(a: Float, b: Float, c: Float) -> Float { a * b + c }

fn main(os: Os) {
  let x = 1.0 + 9.313225746154785e-10
  let y = 1.0 - 9.313225746154785e-10
  let direct = x * y - 1.0
  let p = x * y
  let via_var = p - 1.0
  let via_fn = mul_add(x, y, -1.0)
  var acc = -1.0
  for _ in 0..1 {
    acc = x * y + acc
  }
  os.stdio.println("${direct.to_bits()} ${via_var.to_bits()} ${via_fn.to_bits()} ${acc.to_bits()}")
  // Go's math on inputs where a fused product changes the last bit
  var h = 0
  var v = 0.123456789
  for i in 0..2000 {
    let r = v.exp() + v.sin() + v.log1p() + v.pow(1.7) + v.atan2(1.3) + v.cbrt() + v.tanh()
    h = (h.wrapping_mul(31).wrapping_add(r.to_bits())).wrapping_mul(1000003) & 0xffffffffffff
    v = (v * 1.0071 + Float(i % 7) * 0.013).mod(40.0)
  }
  os.stdio.println("math digest ${h}")
  os.stdio.println("first ${(0.123456789).exp().to_bits()} ${(0.123456789).pow(1.7).to_bits()}")
}
