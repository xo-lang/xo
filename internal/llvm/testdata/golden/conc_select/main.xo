// select (core 7.3) without `after`: the first arm that can proceed, in
// order; a receive binds an Option; a send arm hands its value over
fn main(os: Os) {
  let results = Chan[Str].new()
  let got = scope s {
    s.spawn(fn() { results.send("hello") })
    var out = ""
    select {
      msg = results.recv() => out = msg ?? "closed"
    }
    out
  }
  os.stdio.println("select ${got}")

  // both ready: the first arm wins
  let a = Chan[Int].new(cap: 1)
  let b = Chan[Int].new(cap: 1)
  a.send(1)
  b.send(2)
  let first = select {
    x = a.recv() => x ?? 0
    y = b.recv() => (y ?? 0) * 10
  }
  os.stdio.println("first ${first} left ${a.len()} ${b.len()}")

  // a closed channel is ready with None
  let closed = Chan[Int].new()
  closed.close()
  select {
    v = closed.recv() => os.stdio.println("closed ${v.is_none()}")
    w = b.recv() => os.stdio.println("b ${w ?? 0}")
  }

  // a send arm waits for a receiver
  let out = Chan[Int].new()
  let received = scope s {
    let t = s.spawn(fn() { out.recv() ?? 0 })
    select {
      out.send(7) => os.stdio.println("sent")
    }
    t.await
  }
  os.stdio.println("received ${received}")

  // a select loop over two producers until both are closed
  let evens = Chan[Int].new(cap: 2)
  let odds = Chan[Int].new()
  let sum = scope s {
    s.spawn(fn() {
      for i in 0..50 {
        evens.send(i * 2)
      }
      evens.close()
    })
    s.spawn(fn() {
      for i in 0..50 {
        odds.send(i * 2 + 1)
      }
      odds.close()
    })
    var total = 0
    var open = 2
    var e_open = true
    var o_open = true
    while open > 0 {
      if e_open && o_open {
        select {
          v = evens.recv() => match v {
            Some(n) => total += n
            None => {
              e_open = false
              open -= 1
            }
          }
          v = odds.recv() => match v {
            Some(n) => total += n
            None => {
              o_open = false
              open -= 1
            }
          }
        }
      } else if e_open {
        match evens.recv() {
          Some(n) => total += n
          None => {
            e_open = false
            open -= 1
          }
        }
      } else {
        match odds.recv() {
          Some(n) => total += n
          None => {
            o_open = false
            open -= 1
          }
        }
      }
    }
    total
  }
  os.stdio.println("sum ${sum}")

  // a background task waiting in select is canceled at the end
  let never = Chan[Int].new()
  let never2 = Chan[Str].new()
  scope s {
    s.spawn_background(fn() {
      select {
        v = never.recv() => os.stdio.println("never ${v ?? 0}")
        w = never2.recv() => os.stdio.println("never2 ${w ?? ""}")
      }
    })
  }
  os.stdio.println("background select canceled")
}
