// Decision 0323: pairs of Float operations on adjacent fields become one
// two lane NEON operation on arm64. Each lane must round exactly as the
// scalar operation (decision 0287), so this prints the bits of every
// result: NaN, -0.0, the infinities, subnormals, a lane also read as a
// scalar, a store to another field between the two loads of a pair, a
// call between pairs, and a lane pair summed (faddp).

struct V {
  x: Float
  y: Float
  z: Float
  w: Float
}

fn bits(f: Float) -> Str {
  "${f.to_bits()}"
}

// x and y loaded, combined lane by lane, stored back
fn step(var vs: List[V], i: Int, j: Int, k: Float) {
  let dx = vs[i].x - vs[j].x
  let dy = vs[i].y - vs[j].y
  let qx = dx * k
  let qy = dy * k
  vs[i].x = vs[i].x + qx
  vs[i].y = vs[i].y + qy
  vs[j].x = vs[j].x / (qx + 1.0)
  vs[j].y = vs[j].y / (qy + 1.0)
}

// a lane read as a scalar too (dx printed), and a sum of the two lanes
fn norm2(vs: List[V], i: Int, j: Int, out: Stdio) -> Float {
  let dx = vs[i].x - vs[j].x
  let dy = vs[i].y - vs[j].y
  out.println("dx ${bits(dx)}")
  dx * dx + dy * dy
}

// a store to z between the loads of x and y's neighbours
fn mixed(var vs: List[V], i: Int) -> Float {
  let a = vs[i].z
  vs[i].z = a * 2.0
  let b = vs[i].w
  vs[i].w = b * 2.0
  a + b
}

fn noop(k: Int) -> Int {
  k + 1
}

// a call between the two halves of a pair's use
fn across(var vs: List[V], i: Int) -> Float {
  let x = vs[i].x * 3.0
  let n = noop(i)
  let y = vs[i].y * 3.0
  vs[i].x = x
  vs[i].y = y
  x + y + Float(n)
}

fn root2(var vs: List[V], i: Int) {
  vs[i].z = vs[i].x.sqrt()
  vs[i].w = vs[i].y.sqrt()
}

fn show(vs: List[V], out: Stdio) {
  for v in vs {
    out.println("${bits(v.x)} ${bits(v.y)} ${bits(v.z)} ${bits(v.w)}")
  }
}

fn main(os: Os) {
  let out = os.stdio
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  let tiny = 4.9406564584124654e-324
  // finite values whose last bits show any difference in rounding
  var vs = [
    V{x: 1.5, y: -0.0, z: 3.0, w: 4.0},
    V{x: 0.1, y: 0.2, z: tiny, w: 7.0},
    V{x: 1e300, y: -1e300, z: 2.5, w: tiny},
    V{x: 0.3, y: 0.7, z: 1e-300, w: -1e-300},
    V{x: 2.2250738585072014e-308, y: 1.0000000000000002, z: -3.0, w: 0.5},
  ]
  for r in 0..3 {
    for i in 0..vs.len() {
      for j in 0..vs.len() {
        if i != j {
          step(vs, i, j, 0.5 + Float(r))
        }
      }
    }
  }
  show(vs, out)
  out.println("norm ${bits(norm2(vs, 0, 4, out))}")
  out.println("norm ${bits(norm2(vs, 1, 3, out))}")
  out.println("mixed ${bits(mixed(vs, 1))} ${bits(vs[1].z)} ${bits(vs[1].w)}")
  out.println("across ${bits(across(vs, 4))} ${bits(vs[4].x)} ${bits(vs[4].y)}")
  root2(vs, 0)
  root2(vs, 3)
  out.println("root ${bits(vs[0].z)} ${bits(vs[0].w)} ${bits(vs[3].z)} ${bits(vs[3].w)}")
  // the special values, each pair once
  var sv = [
    V{x: nan, y: -0.0, z: inf, w: -inf},
    V{x: 0.0, y: 0.0, z: tiny, w: -tiny},
    V{x: inf, y: -inf, z: 0.0, w: -0.0},
  ]
  step(sv, 1, 0, 1.0)
  step(sv, 1, 2, -1.0)
  step(sv, 2, 1, 0.0)
  root2(sv, 1)
  show(sv, out)
  out.println("mixed ${bits(mixed(sv, 0))}")
}
