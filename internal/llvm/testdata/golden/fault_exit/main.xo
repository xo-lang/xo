// A fault that reaches main (core 8, decision 0085): the deferred code
// of every block and frame it leaves runs first, innermost first, then
// the process reports the fault and exits with status 70.
// internal/gen's defer_blocks ends this way.

fn leaf(stdio: Stdio, xs: List[Int], i: Int) -> Int uses stdio {
  defer stdio.println("leaf: deferred")
  xs[i] * 2
}

fn branch(stdio: Stdio, n: Int) -> Int uses stdio {
  defer stdio.println("branch: deferred")
  var xs: List[Int] = []
  for i in 0..n {
    xs.push(i)
  }
  var total = 0
  for i in 0..n + 2 {
    defer stdio.println("branch: leave ${i}")
    total += leaf(stdio, xs, i)
  }
  total
}

fn main(os: Os) {
  defer os.stdio.println("main deferred 1")
  defer os.stdio.println("main deferred 2")
  os.stdio.println("fault with defer pending")
  {
    defer os.stdio.println("runs during fault")
    let label = "label"
    os.stdio.println("total ${branch(os.stdio, 2)} ${label}")
  }
  os.stdio.println("never")
}
