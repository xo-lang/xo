enum Shape {
  Circle(r: Int)
  Rect(w: Int, h: Int)
  Tri(a: Int, b: Int, c: Int)
  Empty
}

fn area(s: Shape) -> Int {
  match s {
    Circle(r) => 3 * r * r
    Rect(w: w, h: h) => w * h
    Tri(a, b, ..) => a * b / 2
    Empty => 0
  }
}

fn describe(s: Shape) -> Str {
  match s {
    Circle(r) if r > 10 => "big circle"
    Circle(1) | Circle(2) => "tiny circle"
    Circle(_) => "circle"
    Rect(w, h) if w == h => "square ${w}"
    Rect(..) => "rect"
    Tri(a: 3, ..) => "tri from 3"
    Tri(..) => "tri"
    Empty => "empty"
  }
}

fn grade(n: Int) -> Str {
  match n {
    90..=100 => "A"
    80..=89 => "B"
    0 => "zero"
    -5..0 => "negative"
    _ => "other"
  }
}

fn word(s: Str) -> Int {
  match s {
    "one" => 1
    "two" => 2
    _ => 0
  }
}

fn main(os: Os) {
  let shapes = [Shape.Circle(2), Shape.Rect(w: 3, h: 4), Shape.Empty, Shape.Circle(r: 11), Shape.Tri(a: 3, b: 4, c: 5), Shape.Rect(w: 5, h: 5)]
  for s in shapes {
    os.stdio.println("${describe(s)} -> ${area(s)}")
  }
  os.stdio.println("${grade(95)} ${grade(85)} ${grade(0)} ${grade(-3)} ${grade(50)}")
  os.stdio.println("${word("one")} ${word("two")} ${word("three")}")
  os.stdio.println("eq ${Shape.Circle(2) == Shape.Circle(r: 2)} ${Shape.Empty == Shape.Circle(0)} is ${shapes[1] is Rect(..)} ${shapes[2] is Empty}")
}
