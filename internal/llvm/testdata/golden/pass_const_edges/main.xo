// Constants folded (literal operands after inlining) against the same
// operations on values the program reads at run time, at the edges of
// shifts, unsigned compares, division and 32 bit immediates; and a jump
// table over sparse and negative cases.
fn op_wrapping_add(a: Int, b: Int) -> Int { a.wrapping_add(b) }
fn op_wrapping_sub(a: Int, b: Int) -> Int { a.wrapping_sub(b) }
fn op_wrapping_mul(a: Int, b: Int) -> Int { a.wrapping_mul(b) }
fn op_shl(a: Int, b: Int) -> Int { a.wrapping_shl(b & 127) }
fn op_shr_l(a: Int, b: Int) -> Int { a.shr_logical(b & 127) }
fn op_shr(a: Int, b: Int) -> Int { a >> (b & 63) }
fn op_div(a: Int, b: Int) -> Int { if b == 0 || (b == -1 && a == -9223372036854775807 - 1) { 0 } else { a / b } }
fn op_rem(a: Int, b: Int) -> Int { if b == 0 || b == -1 { 0 } else { a % b } }
fn op_and(a: Int, b: Int) -> Int { a & b }
fn op_xor(a: Int, b: Int) -> Int { a ^ b }
fn op_lt(a: Int, b: Int) -> Int { if a < b { 1 } else { 0 } }
fn op_ltu(a: Int, b: Int) -> Int { if a.lt_unsigned(b) { 1 } else { 0 } }
fn op_hi(a: Int, b: Int) -> Int { a.mul_hi_unsigned(b) }

fn table(x: Int) -> Int {
  match x {
    -3 => 11
    -1 => 12
    0 => 13
    1 => 14
    2 => 15
    5 => 16
    6 => 17
    7 => 18
    9 => 19
    100 => 20
    _ => 21
  }
}

fn main(os: Os) {
