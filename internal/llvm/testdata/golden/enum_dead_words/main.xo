// Enum values whose active variant is smaller than the largest one
// (decision 0624: the words past the payload may be left unwritten, or
// hold +deadw_poison's pattern): returned from functions (registers and
// the stack), stored in a List (pushed and set, from calls and from
// variant literals), a Map and a struct, copied, compared, hashed and
// dropped (XO_LEAKCHECK=1 checks the heap after).
enum Shape {
  Dot
  Line(a: Str)
  Box(a: Str, b: Str, c: List[Int], d: Str)
}

struct Holder {
  s: Shape
  n: Int
}

fn make(i: Int) -> Shape {
  if i % 3 == 0 {
    return Shape.Dot
  }
  if i % 3 == 1 {
    return Shape.Line(a: "line ${i}")
  }
  Shape.Box(a: "a${i}", b: "b${i}", c: [i, i + 1], d: "d")
}

fn wrap(i: Int) -> Shape ! Str {
  if i % 4 == 0 {
    return Err("bad ${i}")
  }
  Ok(make(i))
}

/// A struct and a tuple built from variant literals (their dead words
/// sit inside the wider value), returned.
fn hold(i: Int) -> Holder {
  if i % 2 == 0 {
    return Holder{s: Shape.Dot, n: i}
  }
  Holder{s: Shape.Line(a: "h${i}"), n: i}
}

struct Pair {
  a: Shape
  b: Shape
  k: Int
}

fn pair(i: Int) -> Pair {
  Pair{a: Shape.Line(a: "pa${i}"), b: Shape.Dot, k: i}
}

fn tup(i: Int) -> (Shape, Int) {
  (Shape.Line(a: "t${i}"), i * 2)
}

fn name(s: Shape) -> Str {
  match s {
    Dot => "dot"
    Line(a) => a
    Box(a, b, c, d) => "${a}${b}${c.len()}${d}"
  }
}

fn run(out: Stdio) uses stdio {
  let os = Os2{stdio: out}
  {
    var xs: List[Shape] = []
    var m: Map[Shape, Int] = {}
    var hs: List[Holder] = []
    for i in 0..12 {
      let s = make(i)
      xs.push(s)
      m[s] = i
      hs.push(Holder{s: s, n: i})
      match wrap(i) {
        Ok(w) => os.stdio.println("${i} ok ${name(w)} same=${w == s}")
        Err(e) => os.stdio.println("${i} err ${e}")
      }
    }
    let copy = xs.clone()
    var eq = 0
    for i in 0..xs.len() {
      if copy[i] == xs[i] && hs[i].s == xs[i] {
        eq += 1
      }
    }
    os.stdio.println("equal ${eq} of ${xs.len()}, map ${m.len()} keys")
    os.stdio.println("dot ${m.get(Shape.Dot) ?? -1}, line 4 ${m.get(Shape.Line(a: "line 4")) ?? -1}")
    xs = []
    hs = []
  }
  {
    // variant literals stored into list elements (pushed and set)
    var ys: List[Shape] = []
    for i in 0..6 {
      ys.push(Shape.Line(a: "p${i}"))
      ys.push(Shape.Dot)
    }
    ys[1] = Shape.Line(a: "set")
    ys[2] = Shape.Dot
    var names: List[Str] = []
    for y in ys {
      names.push(name(y))
    }
    os.stdio.println("pushed ${names.join(",")}")
    var zs = ys.clone()
    zs[0] = Shape.Box(a: "x", b: "y", c: [1], d: "z")
    os.stdio.println("eq ${zs[1] == ys[1]} ${zs[0] == ys[0]} ${name(zs[0])}")
  }
  {
    // structs and tuples holding variant literals: returned, pushed
    var hs: List[Holder] = []
    var ps: List[Pair] = []
    for i in 0..4 {
      hs.push(hold(i))
      hs.push(Holder{s: Shape.Line(a: "lit${i}"), n: -i})
      ps.push(pair(i))
    }
    var parts: List[Str] = []
    for h in hs {
      parts.push("${name(h.s)}/${h.n}")
    }
    os.stdio.println("held ${parts.join(",")}")
    let p = pair(7)
    let (ts, tn) = tup(3)
    os.stdio.println("pair ${name(p.a)} ${name(p.b)} ${p.k} ${ps.len()} ${name(ps[2].a)}; tuple ${name(ts)} ${tn}")
  }
}

struct Os2 {
  stdio: Stdio
}

fn main(os: Os) {
  run(os.stdio)
  os.stdio.println("done")
}
