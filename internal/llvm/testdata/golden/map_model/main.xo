// Map against an insertion-ordered list of pairs (spec/std.md: put on an
// existing key keeps its position), under a deterministic sequence of
// puts and removes over small key spaces, so maps cross the tableless
// small map's size (compiler/ssa map.xo SMALL_MAP, 5) both ways: after
// every step the length, the keys in order, every value, a missing key,
// and equality with a map built fresh from the model. Int and Str keys
// (the Str keys share lengths and prefixes: the small map compares
// lengths first).

fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

fn find(ks: List[Int], k: Int) -> Int {
  for i in 0..ks.len() {
    if ks[i] == k {
      return i
    }
  }
  -1
}

fn key_str(k: Int) -> Str {
  match k % 3 {
    0 => "key-${k + 10}"
    1 => "kex-${k + 10}"
    _ => "k-${k}"
  }
}

fn int_model(os: Os, seed: Int, steps: Int, space: Int) -> Int {
  var m: Map[Int, Int] = {}
  var ks: List[Int] = []
  var vs: List[Int] = []
  var x = seed
  var bad = 0
  for i in 0..steps {
    x = next(x)
    let k = (x / 7) % space
    let at = find(ks, k)
    if x % 3 == 2 {
      let _r = m.remove(k)
      if at >= 0 {
        let _a = ks.remove_at(at)
        let _b = vs.remove_at(at)
      }
    } else {
      m.put(k, i)
      if at >= 0 {
        vs[at] = i
      } else {
        ks.push(k)
        vs.push(i)
      }
    }
    var fresh: Map[Int, Int] = {}
    for j in 0..ks.len() {
      fresh.put(ks[j], vs[j])
    }
    if m.len() != ks.len() || m.keys() != ks || m.values() != vs || m.get(space + 1) != None || m != fresh {
      bad += 1
      if bad == 1 {
        os.stdio.println("  int mismatch at step ${i}: map length ${m.len()}, model ${ks.len()}")
      }
    }
  }
  bad
}

fn str_model(os: Os, seed: Int, steps: Int, space: Int) -> Int {
  var m: Map[Str, Int] = {}
  var ks: List[Int] = []
  var vs: List[Int] = []
  var x = seed
  var bad = 0
  for i in 0..steps {
    x = next(x)
    let k = (x / 11) % space
    let at = find(ks, k)
    if x % 4 == 3 {
      let _r = m.remove(key_str(k))
      if at >= 0 {
        let _a = ks.remove_at(at)
        let _b = vs.remove_at(at)
      }
    } else {
      m.put(key_str(k), i)
      if at >= 0 {
        vs[at] = i
      } else {
        ks.push(k)
        vs.push(i)
      }
    }
    var names: List[Str] = []
    var ok = m.len() == ks.len()
    for j in 0..ks.len() {
      names.push(key_str(ks[j]))
      ok = ok && m.get(key_str(ks[j])) == Some(vs[j])
    }
    if !ok || m.keys() != names || m.contains("k-999") {
      bad += 1
      if bad == 1 {
        os.stdio.println("  str mismatch at step ${i}: map length ${m.len()}, model ${names.len()}")
      }
    }
  }
  bad
}

fn main(os: Os) {
  for space in [3, 5, 6, 9, 16] {
    os.stdio.println("int keys in ${space}: ${int_model(os, 7 + space, 600, space)} mismatches")
  }
  for space in [4, 6, 11] {
    os.stdio.println("str keys in ${space}: ${str_model(os, 13 + space, 600, space)} mismatches")
  }
}
