// A real-time program (a `uses realtime` function) whose tasks ping pong
// over channels: no wake may be deferred.
fn mix(a: Int, b: Int) -> Int uses realtime {
  a * 31 + b
}

fn main(os: Os) {
  let ping = Chan[Int].new()
  let pong = Chan[Int].new()
  let last = scope s {
    s.spawn(fn() {
      for v in ping {
        pong.send(v + 1)
      }
      pong.close()
    })
    var v = 0
    for _ in 0..20000 {
      ping.send(v)
      v = pong.recv() ?? -1
    }
    ping.close()
    v
  }
  os.stdio.println("rt ${last} ${mix(last, 1)}")
}
