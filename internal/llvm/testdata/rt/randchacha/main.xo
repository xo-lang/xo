fn main(os: Os) uses stdio, proc, rand {
  var bad = 0
  for (k, w) in WANT.indexed() {
    let got = internal.rt_probe("rand_kat", k, 0, 0, 0)
    if got != w {
      if bad < 5 {
        os.stdio.println("kat word ${k}: got ${got} want ${w}")
      }
      bad += 1
    }
  }
  os.stdio.println(if bad == 0 { "kat: ok" } else { "kat: FAIL (${bad} words)" })
  // a draw first, so the worker's state exists before the fork
  let _r = os.rand.int(0, 1000)
  let f = internal.rt_probe("rand_fork", 0, 0, 0, 0)
  os.stdio.println(if f == 1 { "fork: ok" } else { "fork: FAIL (${f})" })
  if bad != 0 || f != 1 {
    os.proc.exit(1)
  }
}
