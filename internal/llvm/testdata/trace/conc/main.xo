// The execution trace's test program (internal/llvm TestTrace, decision
// 0240): a channel ping-pong, a mutex, a sleep, a select, and a join.
fn main(os: Os) {
  let ch = Chan[Int].new(0)
  let done = Chan[Int].new(0)
  let m = Mutex[Int].new(0)
  // handshakes, so each park happens on a loaded host too (#66: the
  // sleeps alone raced there): held says _c holds the mutex, fin that
  // main's last statement in the scope ran
  let held = Chan[Int].new(0)
  let fin = Chan[Int].new(0)
  scope s {
    // a join that waits: this task, started first, sleeps after main's
    // last statement, so the scope's end waits for it (a task not yet
    // started main would run inline instead)
    let _e = s.spawn(fn() {
      let _ = fin.recv()
      os.clock.sleep(30ms)
    })
    let _a = s.spawn(fn() {
      for i in 0..200 {
        ch.send(i)
      }
      ch.close()
    })
    let _b = s.spawn(fn() {
      var sum = 0
      for v in ch {
        sum += v
        m.with(fn(var x) { x += 1 })
      }
      done.send(sum)
    })
    // holds the mutex for 30 ms after telling main, so main waits for it
    // (a mutex park)
    let _c = s.spawn(fn() {
      m.with(fn(var x) {
        held.send(1)
        os.clock.sleep(30ms)
        x += 1
      })
    })
    let _ = held.recv()
    m.with(fn(var x) { x += 1 })
    os.stdio.println("sum ${done.recv() ?? -1}")
    // a select that waits: the sender sleeps first (50 ms, a margin for
    // a loaded host)
    let late = Chan[Int].new(0)
    let _d = s.spawn(fn() {
      os.clock.sleep(50ms)
      late.send(1)
    })
    select {
      v = late.recv() => os.stdio.println("late ${v ?? -1}")
      after 10s => os.stdio.println("timeout")
    }
    fin.close()

  }
  os.stdio.println("count ${m.with_read(fn(x) { x })}")
}
