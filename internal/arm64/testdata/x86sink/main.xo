// x86_sink_loads and x86_const_imm (TestAmd64PassesFinish): loads read
// by one instruction (xs[i] + ys[i]), a store between a load and its read
// (zs[i] then zs[i + 1]), and constants past arm64's 12 bit immediates.

fn sum2(xs: List[Int], ys: List[Int]) -> Int {
  var s = 0
  for i in 0..xs.len() {
    s = s.wrapping_add(xs[i] + ys[i])
  }
  s
}

fn shift_in(var zs: List[Int]) -> Int {
  var i = 0
  while i + 1 < zs.len() {
    let a = zs[i]
    let b = zs[i + 1]
    zs[i] = b
    zs[i + 1] = a + 30000
    i += 2
  }
  zs[0]
}

fn main(os: Os) {
  let xs = [1, 2, 3, 4, 5, 6, 7, 8]
  var ys = [10, 20, 30, 40, 50, 60, 70, 80]
  var n = 0
  for v in xs {
    if v % 46000 > 55296 - 55290 {
      n += 1
    }
  }
  os.stdio.println("${sum2(xs, ys)} ${shift_in(ys)} ${n}")
}
