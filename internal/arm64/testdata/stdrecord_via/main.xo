use std/big
use std/json
use std/sql
use std/time
use std/uuid

struct Row {
  d: time.Date
  u: uuid.Uuid
  n: sql.Numeric
  i: big.BigInt
  f: big.BigFloat
  r: big.BigRat
} derive Json

fn main(os: Os) {
  let good = "{\"d\":\"2026-11-14\",\"u\":\"123e4567-e89b-12d3-a456-426614174000\",\"n\":12.50,\"i\":123456789012345678901234567890,\"f\":\"1.5\",\"r\":\"3/4\"}"
  match json.decode_str[Row](good) {
    Ok(row) => os.stdio.println("ok ${json.encode(row).to_str_lossy()}")
    Err(e) => os.stdio.println("err ${e}")
  }
  let bad = [
    "{\"d\":\"2026-13-40\",\"u\":\"123e4567-e89b-12d3-a456-426614174000\",\"n\":1,\"i\":1,\"f\":\"1\",\"r\":\"1\"}",
    "{\"d\":\"2026-11-14\",\"u\":\"not a uuid\",\"n\":1,\"i\":1,\"f\":\"1\",\"r\":\"1\"}",
    "{\"d\":\"2026-11-14\",\"u\":\"123e4567-e89b-12d3-a456-426614174000\",\"n\":1,\"i\":1,\"f\":\"1\",\"r\":\"1/0\"}",
  ]
  for s in bad {
    match json.decode_str[Row](s) {
      Ok(_) => os.stdio.println("accepted")
      Err(e) => os.stdio.println("err ${e}")
    }
  }
}
