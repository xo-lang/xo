enum Shape {
  Circle(r: Int)
  Rect(w: Int, h: Int)
  Empty
}

struct Item { name: Str, tags: List[Int] }

fn area(s: Shape) -> Int {
  match s {
    Shape.Circle(r) => 3 * r * r
    Shape.Rect(w, h) => w * h
    Shape.Empty => 0
  }
}

fn report(name: Str, xs: List[Int], m: Map[Str, Int], s: Shape, it: Item) -> Int {
  let total = xs.len() + m.len() + name.len() + it.tags.len()
  let a = area(s)
  total + a
}

fn main(os: Os) {
  var m: Map[Str, Int] = {}
  // a key the optimizer cannot know (the variable is never set): m.n stays
  // a value report reads at run time, which TestDebugTypes/llvm shows
  // (since d41fa5eed clang saw the map's header stores, folded m.n to 2,
  // and with it report's only location of m); before xs, whose location
  // in main the branch would end
  if (os.env.get("XO_DEBUGTYPES_NEVER") ?? "") == "yes" {
    m["three"] = 3
  }
  m["one"] = 1
  m["two"] = 2
  let xs = [10, 20, 30]
  let it = Item{name: "box", tags: [7, 8]}
  let sh = if xs.len() > 2 { Shape.Rect(w: 4, h: 5) } else { Shape.Circle(r: 1) }
  os.stdio.println("${report("hello", xs, m, sh, it)} ${marks(xs.len())}")
}

// types with no words (a List[()]'s items, a field of type ()): an empty
// structure each, not a reference to offset 0 (dwarfdump --verify)
struct Mark { v: () }

fn marks(n: Int) -> Int {
  var us: List[()] = []
  for _ in 0..n {
    us.push(())
  }
  let k = Mark{v: ()}
  let _u = k.v
  us.len()
}
