enum Shape {
  Circle(r: Int)
  Rect(w: Int, h: Int)
  Empty
}

struct Item { name: Str, tags: List[Int] }

fn area(s: Shape) -> Int {
  match s {
    Shape.Circle(r) => 3 * r * r
    Shape.Rect(w, h) => w * h
    Shape.Empty => 0
  }
}

fn report(name: Str, xs: List[Int], m: Map[Str, Int], s: Shape, it: Item) -> Int {
  let total = xs.len() + m.len() + name.len() + it.tags.len()
  let a = area(s)
  total + a
}

fn main(os: Os) {
  let xs = [10, 20, 30]
  var m: Map[Str, Int] = {}
  m["one"] = 1
  m["two"] = 2
  let it = Item{name: "box", tags: [7, 8]}
  let sh = if xs.len() > 2 { Shape.Rect(w: 4, h: 5) } else { Shape.Circle(r: 1) }
  os.stdio.println("${report("hello", xs, m, sh, it)}")
}
