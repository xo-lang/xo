// A recursive struct of more than 4,096 words: its `next` field is a Box
// (recursive values are boxed) whose words sit past arm64's 32760 byte
// scaled offset. Built, read through the box, compared, and released
// (2026-11-07: the native backend failed "box of `Node` (too many words)"
// and "equality of ... (too many words)" at such a size).

struct L0 {
  f0: Int = 0
  f1: Int = 1
  f2: Int = 2
  f3: Int = 3
  f4: Int = 4
  f5: Int = 5
  f6: Int = 6
  f7: Int = 7
}

struct L1 {
  s0: L0 = L0{}
  s1: L0 = L0{}
  s2: L0 = L0{}
  s3: L0 = L0{}
  s4: L0 = L0{}
  s5: L0 = L0{}
  s6: L0 = L0{}
  s7: L0 = L0{}
}

struct L2 {
  s0: L1 = L1{}
  s1: L1 = L1{}
  s2: L1 = L1{}
  s3: L1 = L1{}
  s4: L1 = L1{}
  s5: L1 = L1{}
  s6: L1 = L1{}
  s7: L1 = L1{}
}

struct L3 {
  s0: L2 = L2{}
  s1: L2 = L2{}
  s2: L2 = L2{}
  s3: L2 = L2{}
  s4: L2 = L2{}
  s5: L2 = L2{}
  s6: L2 = L2{}
  s7: L2 = L2{}
}

struct Node {
  core: L3 = L3{}
  name: Str
  next: Node? = None
}

fn tail_of(n: Node) -> Str {
  match n.next {
    Some(m) => "${m.name} ${m.core.s7.s7.s7.f7}"
    None => "-"
  }
}

fn main(os: Os) {
  var a = Node{name: "a"}
  a.core.s7.s7.s7.f7 = 77
  let b = Node{name: "b", next: a}
  let c = Node{name: "b", next: Node{name: "a"}}
  os.stdio.println(tail_of(b))
  os.stdio.println(tail_of(c))
  os.stdio.println("${b == c} ${b == b}")
}
