// A flag the loop clears before it breaks, tested after the loop: the
// test's false edge is entered through the join of the flag, from the
// break only (joinSource, decision 0184), but the loop's exit reaches
// the join too. The block after it took the registers the loop's body
// computed (the data address of b) and read them on that path before
// anything wrote them (gotchas/arm64-vreg-read-before-write-break-flag.md).
fn count(b: Bytes, hi: Int) -> Int {
  var i = 0
  var plain = true
  while i < hi {
    let c = Int(b[i])
    if c == 37 {
      plain = false
      break
    }
    i += 1
  }
  if plain {
    return -1
  }
  var n = 0
  while i < hi {
    if Int(b[i]) == 37 {
      n += 1
    }
    i += 1
  }
  n
}

fn main(os: Os) {
  let s = "ab%c%+d"
  os.stdio.println("${count(s.bytes(), s.len())} ${count("abc".bytes(), 3)} ${count("%".bytes(), 1)} ${count("".bytes(), 0)}")
}
