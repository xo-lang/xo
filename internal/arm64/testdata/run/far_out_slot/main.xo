/// Kept out of line by recursion.
fn total(b: Big, d: Int) -> Int {
  if d > 0 {
    return total(b, d - 1)
  }
  b.f1 + b.f599
}

fn show(b: Big, s: Str) -> Str {
  // through a function value: direct calls pass a struct this large by
  // reference (decision 0151), calls of function values pass its words
  let f = total
  let n = f(b, 1)
  var bb = BytesBuilder.new()
  bb.write_str("${n}${n}")
  bb.write_byte(UInt8(33))
  let t = bb.freeze().to_str() ?? ""
  t[0..t.len() - 1] + s
}

fn main(os: Os) {
  let b = Big{}
  os.stdio.println(show(b, "!"))
  os.stdio.println(show(b with {f1: 2}, "?"))
}
