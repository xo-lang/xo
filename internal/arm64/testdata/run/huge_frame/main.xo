// A function whose frame is past the 32 KiB reach of an sp relative
// ldr or str: 4500 Int and Float values live across calls, about 36 KiB
// of spill slots, and two stack parameters. The arm64 backend keeps x28
// free in such a function and addresses the far slots through it
// (decision 0144, gotchas/arm64-large-frame.md); it failed with "frame
// too large" past 28 KiB before. It runs on the main stack and on a
// task's fiber stack.

/// Kept out of line by recursion.
fn id(n: Int, d: Int) -> Int {
  if d > 0 {
    return id(n, d - 1)
  }
  n
}

/// Kept out of line by recursion.
fn fid(x: Float, d: Int) -> Float {
  if d > 0 {
    return fid(x, d - 1)
  }
  x
}

