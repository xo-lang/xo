// Compares that pick another compare (internal/arm64 selectCompares):
// lexicographic less on Int and Float fields (signed zeros), with the
// tie breaking compare different from the first. No NaN: the Go backend
// orders it last (std.md), the native backends use IEEE `<`
// (gotchas/native-float-nan-order.md).
struct Rec {
  key: Int
  id: Int
  w: Float
}

fn less(a: Rec, b: Rec) -> Bool {
  if a.key != b.key {
    return a.key < b.key
  }
  a.id < b.id
}

fn less_w(a: Rec, b: Rec) -> Bool {
  if a.w != b.w {
    return a.w < b.w
  }
  a.key > b.key
}

fn mixed(a: Int, b: Int, c: Int) -> Bool {
  if a == b {
    return c >= 3
  }
  b < c
}

fn main(os: Os) {
  let ws = [1.5, -2.0, 9.0, 1.5, 0.0, -0.0, 9.0, 7.25]
  var recs: List[Rec] = []
  var seed = 7
  for i in 0..64 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    recs.push(Rec{key: seed % 5, id: (seed / 7) % 4, w: ws[i % 8]})
  }
  var n = 0
  var m = 0
  var lt = 0
  for i in 0..64 {
    for j in 0..64 {
      if less(recs[i], recs[j]) {
        n += i * 64 + j
        lt += 1
      }
      if less_w(recs[i], recs[j]) {
        m += i + 3 * j
      }
    }
  }
  var k = 0
  for a in 0..6 {
    for b in 0..6 {
      for c in 0..6 {
        if mixed(a, b, c) {
          k = k * 3 % 1000003 + a + 7 * b + 49 * c
        }
      }
    }
  }
  os.stdio.println("less ${lt} ${n} less_w ${m} mixed ${k}")
}
