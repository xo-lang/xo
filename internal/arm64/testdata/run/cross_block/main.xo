// The shapes of the MIR passes that rely on other blocks
// (crossblock_test.go), run end to end against the Go backend: memos
// inherited across a pop and a join (popped, set_join), threadConst
// (get_or), threadCset (both), selectCompares and reuseFlags (less),
// placeLatches (sieve), hoistConsts (big_consts).
struct Item {
  key: Int
  id: Int
}

fn popped(n: Int) -> Int {
  var xs = [1, 2, 3]
  let a = xs[2]
  if n > 0 {
    let p = xs.pop() ?? 0
    xs.push(p * 10)
  }
  a + xs[2] + xs.len()
}

fn popped_fault(n: Int) -> Int {
  var xs = [1, 2, 3]
  let a = xs[2]
  if n > 0 {
    let p = xs.pop() ?? 0
    if p > 100 {
      xs.push(p)
    }
  }
  a + xs[2]
}

fn set_join(n: Int) -> Int {
  var xs = [1, 2, 3]
  let a = xs[1]
  if n > 0 {
    xs[1] = 50
  } else {
    xs[0] = 7
  }
  a + xs[1] + xs[0]
}

fn get_or(xs: List[Int], i: Int) -> Int {
  xs.get(i) ?? (-1)
}

fn small(x: Int) -> Bool {
  x < 10
}

fn both(a: Int, b: Int) -> Int {
  if small(a) && small(b) {
    1
  } else {
    if small(a) || !small(b) { 2 } else { 3 }
  }
}

fn less(a: Item, b: Item) -> Bool {
  if a.key != b.key { a.key < b.key } else { a.id < b.id }
}

fn count_less(xs: List[Item]) -> Int {
  var n = 0
  for a in xs {
    for b in xs {
      if less(a, b) {
        n += 1
      }
    }
  }
  n
}

fn sieve(n: Int) -> Int {
  var flags: List[Bool] = []
  for i in 0..n + 1 {
    flags.push(i >= 2)
  }
  var count = 0
  for i in 2..n + 1 {
    if flags[i] {
      count += 1
      var j = i * i
      while j <= n {
        flags[j] = false
        j += i
      }
    }
  }
  count
}

fn big_consts(n: Int) -> Int {
  var t = 0
  for i in 0..n {
    if i * 1000003 > 5000000 {
      t += 7777777
    } else {
      t = get_or([t, 123456789], i % 3)
    }
  }
  t
}

fn main(os: Os) {
  os.stdio.println("popped ${popped(1)} ${popped(0)}")
  os.stdio.println("set_join ${set_join(1)} ${set_join(0)}")
  os.stdio.println("get_or ${get_or([4, 5], 1)} ${get_or([4, 5], 2)} ${get_or([4, 5], -1)}")
  os.stdio.println("both ${both(1, 2)} ${both(1, 20)} ${both(20, 1)} ${both(20, 20)}")
  os.stdio.println("less ${count_less([Item{key: 1, id: 2}, Item{key: 1, id: 1}, Item{key: 0, id: 9}, Item{key: 1, id: 2}])}")
  os.stdio.println("sieve ${sieve(100)} ${sieve(2)} ${sieve(1)}")
  os.stdio.println("big ${big_consts(10)}")
  os.stdio.println("popped_fault ${popped_fault(0)}")
  os.stdio.println("popped_fault ${popped_fault(1)}")
}
