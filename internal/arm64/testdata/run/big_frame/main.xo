// A function whose frame spans several pages: 1100 values live across
// calls, each in its own spill slot (about 9 KiB). The arm64 backend
// probes every page of such a frame (gotchas/arm64-large-frame.md); it
// runs on the main stack and on a task's fiber stack, whose guard page
// the probes must hit before anything below it.

/// Kept out of line by recursion.
fn id(n: Int, d: Int) -> Int {
  if d > 0 {
    return id(n, d - 1)
  }
  n
}

