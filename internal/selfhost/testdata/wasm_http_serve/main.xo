// A wasi:http component (decision 0447) for a real host: TestWasmComponentServe
// runs it under `wasmtime serve` with only the proxy world's imports, one route
// for each WASI 0.2 function the runtime uses in place of preview 1.
use std/http

fn main(os: Os) {
  var r = http.router()
  r.handle("GET /", fn(q: http.Request) -> http.Response { http.text(200, "hello") })
  // past the 4096 bytes of one blocking-write-and-flush
  r.handle("GET /big", fn(q: http.Request) -> http.Response { http.text(200, "x".repeat(20000)) })
  r.handle("POST /echo", fn(q: http.Request) -> http.Response { http.text(200, "len ${q.body.len()}") })
  // handle_stream: the body read from the host's input-stream as it
  // arrives, in reads of at most 4096 bytes
  r.handle_stream("POST /stream", fn(q: http.Request, b: http.BodyReader) -> http.Response {
    var reads = 0
    var n = 0
    while true {
      match b.read(4096) {
        Ok(Some(d)) => {
          reads += 1
          n += d.len()
        }
        Ok(None) => break
        Err(e) => return http.text(500, "read: ${e}")
      }
    }
    http.text(200, "len ${n} reads ${reads} trailer ${b.trailers().get("X-Trail") ?? "-"}")
  })
  // one read, then the answer: the runtime drops the rest of the body
  r.handle_stream("POST /half", fn(q: http.Request, b: http.BodyReader) -> http.Response {
    let k = match b.read(4096) {
      Ok(Some(d)) => d.len()
      _ => -1
    }
    http.text(200, "first ${k > 0 && k <= 4096}")
  })
  // a streamed response's trailers (set_trailer) after its body; a name
  // a trailer may not carry is dropped
  r.handle("GET /trailer", fn(q: http.Request) -> http.Response {
    http.stream(200, fn(w) {
      w.write("hel".bytes())?
      w.write("lo".bytes())?
      w.set_trailer("x-checksum", "abc123")
      w.set_trailer("host", "evil")
    }).with_trailer_names(["X-Checksum"])
  })
  // a streamed body of 1 MiB in 64 KiB writes, sent as it is made
  r.handle("GET /stream-big", fn(q: http.Request) -> http.Response {
    http.stream(200, fn(w) {
      let piece = "b".repeat(65536).bytes()
      for _ in 0..16 {
        w.write(piece)?
      }
    })
  })
  r.handle("GET /head", fn(q: http.Request) -> http.Response { http.text(200, q.header("X-Test") ?? "-") })
  r.handle("GET /sleep", fn(q: http.Request) -> http.Response {
    let a = os.clock.now().unix_millis()
    os.clock.sleep(20ms)
    http.text(200, "slept ${os.clock.now().unix_millis() - a >= 20}")
  })
  r.handle("GET /now", fn(q: http.Request) -> http.Response { http.text(200, "after 2020 ${os.clock.now().unix() > 1577836800}") })
  r.handle("GET /rand", fn(q: http.Request) -> http.Response { http.text(200, "rand ${os.rand.bytes(32).len()}") })
  r.handle("GET /log", fn(q: http.Request) -> http.Response {
    os.stdio.println("to stdout ${"y".repeat(5000)}")
    os.stdio.eprintln("to stderr")
    http.text(200, "logged")
  })
  r.handle("GET /stdin", fn(q: http.Request) -> http.Response { 
    match os.stdio.read_line() {
      Ok(Some(l)) => http.text(200, "stdin ${l}")
      Ok(None) => http.text(200, "stdin at its end")
      Err(e) => http.text(200, "stdin ${e}")
    }
  })
  r.handle("GET /env", fn(q: http.Request) -> http.Response { http.text(200, "env ${os.env.get("PATH") ?? "-"} args ${os.env.args().len()}") })
  r.handle("GET /exit", fn(q: http.Request) -> http.Response {
    os.proc.exit(3)
  })
  r.handle("GET /fault", fn(q: http.Request) -> http.Response {
    let l: List[Int] = []
    http.text(200, "${l[q.path.len()]}")
  })
  http.serve_component(r)
}
