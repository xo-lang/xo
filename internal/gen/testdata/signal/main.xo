// Real signal path of the two phase shutdown (core 7.5), driven by
// TestSignal* in internal/gen/build_test.go. MODE picks the behavior.
use std/http
use std/task

fn wait_for_stop(os: Os) {
  select {
    _ = task.stopping().recv() => os.stdio.println("stop requested ${task.stop_requested()}")
  }
}

fn serve(os: Os) ! {
  let port = os.env.get("PORT") ?? "18733"
  var r = http.router()
  r.handle("GET /slow", fn(_req) {
    os.stdio.println("handling")
    os.clock.sleep(500ms)
    http.text(200, "slow done")
  })
  let srv = http.server(os.net.listen("127.0.0.1:${port}")?, r)
  os.stdio.println("ready")
  srv.serve()?
  os.stdio.println("serve returned")
}

// read_lines counts lines until the end of input or an error: a stop
// request or cancellation ends a blocked read_line with Canceled
// (decision 0088).
fn read_lines(os: Os) -> Str {
  var n = 0
  while {
    match os.stdio.read_line() {
      Ok(Some(_)) => n += 1
      Ok(None) => return "end of input after ${n} lines"
      Err(e) => return "read_line: ${e} after ${n} lines"
    }
  }
  "not reached"
}

fn read_stdin(os: Os, mode: Str) {
  if mode == "stdin" {
    os.stdio.println("ready")
    os.stdio.println(read_lines(os))
    return
  }
  // stdin_cancel: the scope cancels a reader blocked in read_line
  scope s {
    let t = s.spawn(fn() -> Str { read_lines(os) })
    os.stdio.println("ready")
    os.clock.sleep(300ms)
    s.cancel()
    os.stdio.println(t.await)
  }
}

fn main(os: Os) ! {
  let mode = os.env.get("MODE") ?? "cancel"
  if mode == "http" {
    serve(os)?
    return
  }
  if mode == "stdin" || mode == "stdin_cancel" {
    read_stdin(os, mode)
    return
  }
  if mode == "grace" {
    os.proc.set_grace(300ms)
  }
  defer os.stdio.println("cleanup ran")
  scope s {
    s.spawn_background(fn() {
      defer os.stdio.println("background stopped")
      os.clock.sleep(1h)
    })
    // defer is block scoped: it must sit in the scope body itself
    defer {
      if mode == "hung" {
        os.clock.sleep(1h)
      }
    }
    os.stdio.println("ready")
    wait_for_stop(os)
    if mode == "drain" {
      os.clock.sleep(200ms)
      os.stdio.println("drained")
      return
    }
    os.clock.sleep(1h)
  }
  os.stdio.println("not reached")
}
