use std/sql

struct Note {
  id: Int
  body: Str
  at: Time
  done: Bool
  score: Float
}

fn add(db: sql.Db, body: Str, at: Time) -> Int ! sql.SqlErr uses net.dial {
  db.exec("INSERT INTO notes (body, at, done, score) VALUES ($1, $2, $3, $4)", [sql.str(body), sql.time(at), sql.bool(false), sql.int(2)])?.last_insert_id
}

fn get(db: sql.Db, id: Int) -> Note ! sql.SqlErr uses net.dial {
  let r = db.query_one("SELECT * FROM notes WHERE id = $1", [sql.int(id)])?
  Note { id: r.int("id")?, body: r.str("body")?, at: r.time("at")?, done: r.bool("done")?, score: r.float("score")? }
}

test "fake_db round trips every column type" {
  let db = testing.fake_db("CREATE TABLE notes (id SERIAL, body TEXT, at TIMESTAMP, done BOOL, score REAL)")?
  let id = add(db, "hello", os.clock.now())?
  let n = get(db, id)?
  expect(n.body) == "hello"
  expect(n.at) == os.clock.now()
  expect(n.done) == false
  expect(n.score) == 2.0
  expect(add(db, "second", os.clock.now())?) == 2
}

test "errors are typed" {
  let db = sql.memory("CREATE TABLE notes (id SERIAL, body TEXT, at TIMESTAMP, done BOOL, score REAL)")?
  expect(get(db, 99) is Err(NoRows))
  expect(db.query("SELECT * FROM missing") is Err(NoTable(_)))
  expect(db.exec("INSERT INTO notes (body) VALUES (1)") is Err(Constraint(_, _, _)))
  expect(db.exec("INSERT INTO notes (nope) VALUES (1)") is Err(Syntax(_)))
}
