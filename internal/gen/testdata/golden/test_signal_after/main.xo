// SIGTERM delivered by `os.proc.signal_after` cancels main's root scope,
// including foreground tasks, so main exits cleanly (core 7.5, std 8.4).
fn tick(clock: Clock) {
  while {
    clock.sleep(1m)
  }
}

fn main(os: Os) ! {
  scope s {
    s.spawn_background(fn() { tick(os.clock) })
    s.spawn(fn() { tick(os.clock) })
    os.clock.sleep(24h)
  }
}
