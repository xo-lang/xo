type Email struct(Str)
type Wrap[T] struct(T)
type Pair struct((Int, Str))

fn domain(e: Email) -> Str {
  let Email(s) = e
  s
}

fn raw(e: Email) -> Str {
  e.0
}

fn kind(e: Email) -> Int {
  match e {
    Email("") => 0
    Email(s) => s.len()
  }
}

fn unwrap[T](w: Wrap[T]) -> T {
  w.0
}

fn first(p: Pair) -> Int {
  match p {
    Pair((0, _)) => -1
    Pair((n, s)) => n + s.len()
  }
}

fn main(os: Os) {
  var e = Email("a@b")
  let empty = Email("")
  os.stdio.println("${raw(e)} ${domain(e)} ${kind(e)} ${kind(empty)}")
  e.0 = "c@d.e"
  os.stdio.println(e.0)
  let w = Wrap("s")
  os.stdio.println("${unwrap(Wrap(41)) + 1} ${unwrap(w)}")
  let p0 = Pair((0, "x"))
  let p1 = Pair((2, "xy"))
  os.stdio.println("${first(p0)} ${first(p1)}")
  let es = [Email("x"), Email("yy")]
  let ls = es.map(fn(m) { m.0.len() })
  os.stdio.println("${ls.len()} ${ls[1]}")
}
