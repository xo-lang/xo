// Mutex.with_read (decision 0063): shared read only access. Readers run
// next to each other, writers exclude them, the value a reader gets is a
// copy it may change locally, and errors pass through.

struct Accounts {
  a: Int
  b: Int
  log: List[Int]
}

enum E {
  Empty
} derive Display

fn total(m: Mutex[Accounts]) -> Int {
  m.with_read(fn(s) { s.a + s.b })
}

fn last(m: Mutex[Accounts]) -> Int ! E {
  m.with_read(fn(s) -> Int ! E { s.log.last().or_err(E.Empty) })
}

fn main(os: Os) {
  let m = Mutex[Accounts].new(Accounts{a: 100, b: 0, log: []})
  let bad = Atomic[Int].new(0)
  let reads = Atomic[Int].new(0)
  scope s {
    for i in 0..4 {
      s.spawn(fn() {
        for j in 0..50 {
          m.with(fn(var st) {
            st.a -= 1
            st.b += 1
            st.log.push(i * 100 + j)
          })
        }
      })
    }
    for _ in 0..8 {
      s.spawn(fn() {
        for _ in 0..100 {
          if total(m) != 100 {
            bad.add(1)
          }
          reads.add(1)
        }
      })
    }
  }
  let (a, b, n) = m.with_read(fn(st) { (st.a, st.b, st.log.len()) })
  os.stdio.println("a ${a} b ${b} log ${n} reads ${reads.get()} bad ${bad.get()}")

  // a reader's copy may change; the protected value does not
  let grown = m.with_read(fn(st) {
    var mine = st.log
    mine.push(-1)
    mine.len()
  })
  os.stdio.println("copy ${grown} kept ${m.with_read(fn(st) { st.log.len() })}")

  let empty = Mutex[Accounts].new(Accounts{a: 0, b: 0, log: []})
  match last(empty) {
    Ok(v) => os.stdio.println("last ${v}")
    Err(e) => os.stdio.println("error ${e}")
  }
  os.stdio.println("last is set ${last(m).is_ok()}")

  os.stdio.println("re-entrant with_read next")
  m.with_read(fn(st) {
    m.with_read(fn(st2) { st2.a })
  })
}
