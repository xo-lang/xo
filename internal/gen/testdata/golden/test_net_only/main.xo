// Attenuation of a test's fakes (decisions 0156 and 0175): FakeNet.only,
// FakeEnv.only, and FakeProc.only deny what their lists do not admit,
// before the fake answers; also natively (cmd/xo TestNoGCTests).
use std/http

fn fetch(n: Net, url: Str) -> Str uses net.dial {
  match http.client(n).get(url) {
    Ok(r) => "${r.status} ${r.text() ?? "?"}"
    Err(e) => "${e}"
  }
}

test "FakeNet.only checks each request before the fake answers" {
  os.net.handle("GET /hi", fn(_req) { http.text(200, "hello") })
  let n = os.net.only(["api.test", "*.cdn.test"])
  expect(fetch(n, "http://api.test/hi")) == "200 hello"
  expect(fetch(n, "http://img.cdn.test/hi")) == "200 hello"
  expect(fetch(n, "http://cdn.test/hi")) == "Connect(msg: \"denied by Net.only: cdn.test:80\")"
  expect(fetch(n, "https://evil.test/hi")) == "Connect(msg: \"denied by Net.only: evil.test:443\")"
  expect(fetch(n.only(["img.cdn.test"]), "http://api.test/hi")) == "Connect(msg: \"denied by Net.only: api.test:80\")"
}

test "FakeNet.only denies dial and listen" {
  let n = os.net.only(["127.0.0.1:8080"])
  match n.dial("evil.test:1") {
    Ok(_) => expect(false) == true
    Err(e) => expect("${e}") == "denied by Net.only: evil.test:1"
  }
  match n.listen(":8080") {
    Ok(_) => expect(false) == true
    Err(e) => expect("${e}") == "denied by Net.only: :8080"
  }
}

test "FakeEnv.only and FakeProc.only" {
  os.env.set("A", "1")
  os.env.set("B", "2")
  let e = os.env.only(["A"])
  expect(e.get("A")) == Some("1")
  expect(e.get("B").is_some()) == false
  expect(e.vars().len()) == 1
  os.proc.on_run("git", ProcOutput{code: 0, stdout: b"ok\n", stderr: b""})
  let p = os.proc.only(["git"])
  match p.run("sh", []) {
    Ok(_) => expect(false) == true
    Err(e) => expect("${e}") == "denied by Proc.only: sh"
  }
  match p.cmd("sh").output() {
    Ok(_) => expect(false) == true
    Err(e) => expect("${e}") == "denied by Proc.only: sh"
  }
  expect(p.cmd("git").output().is_ok()) == true
}
