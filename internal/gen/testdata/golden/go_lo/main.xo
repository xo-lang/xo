// use go of samber/lo (darwin feedback b20): lo's generic functions
// constrained by its internal/constraints.Ordered (an alias of
// cmp.Ordered) bind as Ord, and the glue names cmp.Ordered, not the
// internal package a program cannot import.
use go "github.com/samber/lo"

fn main(os: Os) {
  os.stdio.println("${lo.uniq([3, 1, 3]):?}")
  os.stdio.println("${lo.max([4, 9, 2])}")
  os.stdio.println("${lo.min(["b", "a", "c"])}")
}
