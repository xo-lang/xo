enum Shape {
  Circle(r: Int)
  Rect(w: Int, h: Int)
  Empty
} derive Display, Ord

enum Wrapper {
  One(from Shape)
  Many(items: List[Shape])
}

fn area(s: Shape) -> Int {
  match s {
    Circle(r) => 3 * r * r
    Rect(w: w, h: h) => w * h
    Empty => 0
  }
}

fn main(os: Os) {
  let shapes = [Shape.Circle(2), Shape.Rect(w: 3, h: 4), Shape.Empty, Shape.Circle(r: 1)]
  for s in shapes {
    os.stdio.println("${s} -> ${area(s)}")
  }
  let w = Wrapper.One(Shape.Empty)
  let m = Wrapper.Many(items: shapes)
  match w {
    One(inner) => os.stdio.println("one ${inner}")
    Many(..) => os.stdio.println("many")
  }
  match m {
    Many(items: xs) => os.stdio.println("many ${xs.len()}")
    One(_) => os.stdio.println("one")
  }
  os.stdio.println("eq ${Shape.Circle(2) == Shape.Circle(r: 2)} ${Shape.Empty == Shape.Circle(0)}")
  os.stdio.println("ord ${Shape.Circle(5) < Shape.Rect(w: 1, h: 1)} ${Shape.Circle(1) < Shape.Circle(2)}")
  let sorted = shapes.sort()
  os.stdio.println("first ${sorted[0]} last ${sorted[3]}")
}
