enum LoadErr {
  NotFound(id: Int)
} derive Display

fn load(id: Int) -> Str ! LoadErr {
  if id > 10 {
    return Err(LoadErr.NotFound(id: id))
  }
  "user${id}"
}

fn profile(id: Int, name: Str) -> Str ! LoadErr {
  let u = load(id)?
  "${name}: ${u}"
}

fn main(os: Os) ! {
  os.stdio.println(profile(3, "a")?)
  os.stdio.println(profile(42, "b")?)
  os.stdio.println("never")
}
