use std/http

fn routes() -> http.Router {
  var r = http.router()
  r.handle("GET /hello/{name}", fn(req) { http.text(200, "hello ${req.param("name")}") })
  r.handle("POST /len", fn(req) { http.json(200, {"len": req.body.len()}) })
  r.handle("GET /big", fn(req) { http.text(200, "x".repeat(3000)) })
  r
}

fn main(os: Os) ! {
  // a port of the system's choice: the golden runs beside other test
  // processes that run it too
  let l = os.net.listen("127.0.0.1:0")?
  let base = "http://${l.addr()}"
  let srv = http.server(l, routes())
  let client = http.client(os.net, timeout: 5s)
  scope s {
    s.spawn_background(fn() { srv.serve() })
    os.clock.sleep(100ms)
    let a = client.get("${base}/hello/xo")?
    os.stdio.println("${a.status} ${a.body.to_str() ?? ""}")
    let b = client.post_json("${base}/len", "abcd")?
    os.stdio.println("${b.status} ${b.body.to_str() ?? ""} ${b.header("content-type") ?? ""}")
    // a body over net/http's 2 KiB buffer still carries its length
    let big = client.get("${base}/big")?
    os.stdio.println("${big.status} ${big.body.len()} ${big.header("content-length") ?? "chunked"}")
    let c = client.get("${base}/missing")?
    os.stdio.println("${c.status}")
    match client.get("http://127.0.0.1:1/") {
      Ok(_) => os.stdio.println("connected?")
      Err(Connect(_)) => os.stdio.println("connect error")
      Err(e) => os.stdio.println("other error ${e}")
    }
    match client.get("not a url") {
      Ok(_) => os.stdio.println("?")
      Err(InvalidUrl(_)) => os.stdio.println("invalid url")
      Err(e) => os.stdio.println("other error ${e}")
    }
  }
  os.stdio.println("server stopped")
}
