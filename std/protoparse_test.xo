// Hand written cases for the .proto parser and the derive Proto generator (decision 0530); the
// grammar is the protobuf language specification's proto3 subset.
fn must(src: Str) -> File {
  parse(src).or_fault("parse")
}

test "lexer: comments, numbers, strings and positions" {
  let ts = tokens("a // c\n/* x\ny */ 0x1F 1.5e-3 'q\\n' \"r\"").or_fault("tokens")
  expect(ts.len()) == 5
  expect(ts[0].text) == "a"
  expect(ts[1].text) == "0x1F"
  expect(ts[1].line) == 3
  expect(ts[2].kind == Kind.Float) == true
  expect(ts[3].text) == "q\n"
  expect(ts[4].kind == Kind.Str) == true
}

test "lexer errors carry a position" {
  match tokens("a\n  \"abc") {
    Ok(_) => fault("want error")
    Err(e) => {
      expect(e.line) == 2
      expect(e.col) == 3
    }
  }
  expect(tokens("/* open").is_err()) == true
}

test "file header: syntax, package, imports, options" {
  let f = must("syntax = \"proto3\";\npackage a.b.c;\nimport \"x.proto\";\nimport public \"y.proto\";\noption java_package = \"z\";")
  expect(f.syntax) == "proto3"
  expect(f.package) == "a.b.c"
  expect(f.imports.len()) == 2
  expect(f.imports[1]) == "y.proto"
}

test "message fields, labels, maps and field options" {
  let f = must("message M { int32 a = 1; repeated string b = 2 [packed = false]; optional bool c = 3; map<string, M> d = 4; .a.B e = 5; reserved 6, 8 to 9; }")
  let m = f.messages[0]
  expect(m.fields.len()) == 5
  expect(m.fields[1].repeated) == true
  expect(m.fields[2].optional) == true
  expect(m.fields[3].key) == "string"
  expect(m.fields[3].typ) == "M"
  expect(m.fields[4].typ) == ".a.B"
}

test "oneof, nested types and enums" {
  let f = must("message M { oneof k { int64 x = 1; string y = 2; } message In { int32 v = 1; } enum E { Z = 0; A = -1; B = 0x10; } }")
  let m = f.messages[0]
  expect(m.oneofs[0]) == "k"
  expect(m.fields[1].oneof) == "k"
  expect(m.nested[0].name) == "In"
  expect(m.enums[0].values[1].num) == -1
  expect(m.enums[0].values[2].num) == 16
}

test "services: the four streaming shapes" {
  let f = must("service S { rpc A(Q) returns (R); rpc B(Q) returns (stream R); rpc C(stream Q) returns (R); rpc D(stream Q) returns (stream R) { option deprecated = true; } }")
  let r = f.services[0].rpcs
  expect(r.len()) == 4
  expect(r[1].server_stream) == true
  expect(r[1].client_stream) == false
  expect(r[2].client_stream) == true
  expect(r[3].client_stream && r[3].server_stream) == true
}

test "parse errors: position and message" {
  match parse("message A {\n  int32 x = ;\n}") {
    Ok(_) => fault("want error")
    Err(e) => {
      expect(e.line) == 2
      expect(e.col) == 13
    }
  }
  expect(parse("message A { required int32 x = 1; }").is_err()) == true
  expect(parse("message A { int32 x = 1;").is_err()) == true
  // extend blocks (custom options) are skipped; required and group are proto2 only
  expect(parse("extend A { int32 x = 1; }").is_err()) == false
  expect(parse("message M { optional group G = 1 { optional int32 x = 1; } }").is_err()) == true
  expect(parse("syntax = proto3;").is_err()) == true
}

test "generator: scalars, options, nesting, oneof and enum names" {
  let f = must("message O { message I { sint32 z = 1; } enum K { U = 0; V = 1; } I i = 1; K k = 2; fixed64 f = 3; oneof w { string s = 4; I t = 5; } map<int64, I> m = 6; }")
  let src = gen(f).or_fault("gen")
  expect(src.contains("struct OI {")) == true
  expect(src.contains("z proto \"1,zigzag\": Int32")) == true
  expect(src.contains("enum OK: Int {")) == true
  expect(src.contains("i proto \"1\": OI")) == true
  expect(src.contains("k proto \"2\": OK")) == true
  expect(src.contains("f proto \"3,fixed\": UInt64")) == true
  expect(src.contains("enum OW {")) == true
  expect(src.contains("T as \"5\"(v: OI)")) == true
  expect(src.contains("w proto \"oneof\": OW?")) == true
  expect(src.contains("m proto \"6\": Map[Int, OI]")) == true
}

test "gen writes proto2 repeated numbers, Bools and enums unpacked, as protoc does, unless [packed = true]; proto3 only for [packed = false]" {
  let f2 = parse("syntax = \"proto2\";\nmessage M {\n  enum E { A = 0; }\n  repeated int32 a = 1;\n  repeated sint64 b = 2 [packed = true];\n  repeated E e = 3;\n  repeated string s = 4;\n  repeated M m = 5;\n  repeated bool f = 6;\n}\n")?
  let g2 = gen(f2)?
  expect(g2.contains("pub a proto \"1,unpacked\": List[Int32]")) == true
  expect(g2.contains("pub b proto \"2,zigzag\": List[Int]")) == true
  expect(g2.contains("pub e proto \"3,unpacked\": List[ME]")) == true
  expect(g2.contains("pub s proto \"4\": List[Str]")) == true
  expect(g2.contains("pub m proto \"5\": List[M]")) == true
  expect(g2.contains("pub f proto \"6,unpacked\": List[Bool]")) == true
  let f3 = parse("syntax = \"proto3\";\nmessage N {\n  repeated fixed32 a = 1 [packed = false];\n  repeated int64 b = 2;\n}\n")?
  let g3 = gen(f3)?
  expect(g3.contains("pub a proto \"1,fixed,unpacked\": List[UInt32]")) == true
  expect(g3.contains("pub b proto \"2\": List[Int]")) == true
}

test "editions: edition = \"2023\" parses; gen follows field_presence and repeated_field_encoding, file level and per field" {
  let f = must("edition = \"2023\";\npackage e;\noption features.repeated_field_encoding = EXPANDED;\nmessage M {\n  int32 a = 1;\n  int32 b = 2 [features.field_presence = IMPLICIT];\n  int64 c = 3 [features.field_presence = LEGACY_REQUIRED];\n  repeated int32 d = 4;\n  repeated int32 e = 5 [features.repeated_field_encoding = PACKED];\n  M m = 6;\n  reserved x, y;\n}\n")
  expect(f.syntax) == "editions"
  expect(f.edition) == "2023"
  expect(f.messages[0].reserved_names) == ["x", "y"]
  let g = gen(f).or_fault("gen")
  expect(g.contains("pub a proto \"1\": Int32?")) == true
  expect(g.contains("pub b proto \"2\": Int32\n")) == true
  expect(g.contains("pub c proto \"3\": Int\n")) == true
  expect(g.contains("pub d proto \"4,unpacked\": List[Int32]")) == true
  expect(g.contains("pub e proto \"5\": List[Int32]")) == true
  expect(g.contains("pub m proto \"6\": M?")) == true
  let i = must("edition = \"2023\";\noption features.field_presence = IMPLICIT;\nmessage N { int32 a = 1; }\n")
  expect(gen(i).or_fault("gen i").contains("pub a proto \"1\": Int32\n")) == true
  expect(parse("edition = \"2023\";\nmessage M { optional int32 a = 1; }").is_err()) == true
  expect(parse("edition = \"2023\";\nmessage M { required int32 a = 1; }").is_err()) == true
  expect(parse("edition = \"2023\";\nmessage M { reserved \"x\"; }").is_err()) == true
  expect(parse("edition = \"2022\";").is_err()) == true
}

test "gen writes a group and a DELIMITED message field with derive Proto's group option (decision 0530)" {
  let g2 = gen(must("syntax = \"proto2\";\nmessage M { optional group G = 1 { optional int32 a = 2; } repeated group R = 3 { optional int32 b = 4; } }")).or_fault("proto2")
  expect(g2.contains("g proto \"1,group\": MG?")) == true
  expect(g2.contains("r proto \"3,group\": List[MR]")) == true
  let e = gen(must("edition = \"2023\";\nmessage M { message I { int32 a = 1; } I i = 1 [features.message_encoding = DELIMITED]; I j = 2; }")).or_fault("field feature")
  expect(e.contains("i proto \"1,group\": MI?")) == true
  expect(e.contains("j proto \"2\": MI?")) == true
  // the file's default reaches message fields only: an enum, a scalar or a map keeps its encoding
  let fd = gen(must("edition = \"2023\";\noption features.message_encoding = DELIMITED;\nenum E { E_ZERO = 0; }\nmessage M { message I { int32 a = 1; } I i = 1; E e = 2; int32 n = 3; map<string, I> m = 4; I l = 5 [features.message_encoding = LENGTH_PREFIXED]; }")).or_fault("file feature")
  expect(fd.contains("i proto \"1,group\": MI?")) == true
  expect(fd.contains("e proto \"2\": E?")) == true
  expect(fd.contains("n proto \"3\": Int32?")) == true
  expect(fd.contains("m proto \"4\": Map[Str, MI]")) == true
  expect(fd.contains("l proto \"5\": MI?")) == true
  // a group in a oneof stays an error: derive Proto writes a oneof variant length prefixed
  expect(gen(must("edition = \"2023\";\nmessage M { message I { int32 a = 1; } oneof o { I i = 1 [features.message_encoding = DELIMITED]; } }")).is_err()) == true
}

test "generator: unknown types are an error" {
  expect(gen(must("message A { B b = 1; }")).is_err()) == true
}

fn lcg(x: Int) -> Int {
  (x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)) & 0x7fffffffffffffff
}

const SAMPLE: Str = "syntax = \"proto3\";\npackage a.b;\nimport \"x.proto\";\nenum E { Z = 0; ONE = 1; }\nmessage M {\n  int32 id = 1;\n  repeated string tags = 2;\n  optional bytes raw = 3;\n  map<string, int64> m = 4;\n  oneof k { string s = 5; int64 n = 6; }\n  message In { E e = 1; }\n  In in = 7;\n}\nservice S { rpc Get(M) returns (stream M); rpc Put(stream M) returns (M); }\n"

test "mutated .proto text is an error or a file, never a fault" {
  var x = 777
  let base = SAMPLE.bytes()
  for _ in 0..4000 {
    var b = BytesBuilder.with_capacity(base.len())
    x = lcg(x)
    let cut = (x >> 30) % (base.len() + 1)
    var i = 0
    while i < cut {
      x = lcg(x)
      let r = (x >> 33) % 40
      if r == 0 {
        // drop the byte
      } else if r == 1 {
        b.write_byte(UInt8.wrapping_from((x >> 20) & 127))
        b.write_byte(base[i])
      } else if r == 2 {
        b.write_byte(UInt8.wrapping_from(33 + (x >> 20) % 90))
      } else {
        b.write_byte(base[i])
      }
      i += 1
    }
    let text = b.freeze().to_str_lossy()
    match parse(text) {
      Ok(f) => {
        // a file the parser accepts generates or fails with a position, never faults
        match gen(f) {
          Ok(_) => {}
          Err(_) => {}
        }
      }
      Err(e) => expect(e.line >= 1) == true
    }
  }
}

test "proto2: labels, required, default, groups, extensions" {
  let f = must("syntax = \"proto2\";\nmessage M {\n  required int32 a = 1;\n  optional string b = 2 [default = \"x\"];\n  repeated int64 c = 3;\n  optional group Res = 4 {\n    required string url = 5;\n  }\n  extensions 100 to 199;\n  optional int32 e = 6 [deprecated = true];\n}\nextend M { optional int32 ext = 100; }")
  let m = f.messages[0]
  expect(f.syntax) == "proto2"
  expect(m.fields.len()) == 5
  expect(m.fields[0].required) == true
  expect(m.fields[1].optional) == true
  expect(m.fields[2].repeated) == true
  expect(m.fields[3].name) == "res"
  expect(m.fields[3].typ) == "Res"
  expect(m.nested[0].name) == "Res"
  expect(m.nested[0].fields[0].required) == true
  // the group becomes a nested message written with group tags
  expect(gen(f).or_fault("group gen").contains("res proto \"4,group\": MRes?")) == true
  let src = gen(must("syntax = \"proto2\";\nmessage M {\n  required int32 a = 1;\n  optional string b = 2 [default = \"x\"];\n}")).or_fault("gen")
  expect(src.contains("a proto \"1\": Int32")) == true
  expect(src.contains("b proto \"2\": Str?")) == true
}

test "proto2: unlabeled field and a oneof member" {
  expect(parse("syntax = \"proto2\"; message M { int32 a = 1; }").is_err()) == true
  let f = must("syntax = \"proto2\"; message M { oneof k { int32 a = 1; string b = 2; } }")
  expect(f.messages[0].fields.len()) == 2
}

test "gen_set: a type from an imported file resolves; one imported without public does not pass on" {
  let a = must("syntax = \"proto3\";\npackage x.a;\nmessage A { int32 v = 1; message In { string s = 1; } }\nenum K { Z = 0; }")
  let b = must("syntax = \"proto3\";\npackage x.b;\nimport public \"x/a.proto\";\nmessage B { x.a.A a = 1; .x.a.A.In i = 2; }")
  let c = must("syntax = \"proto3\";\npackage x.c;\nimport \"x/b.proto\";\nmessage C { x.b.B b = 1; x.a.A a = 2; }")
  let d = must("syntax = \"proto3\";\npackage x.d;\nimport \"x/c.proto\";\nmessage D { x.a.A a = 1; }")
  let out = gen_set([("x/a.proto", a), ("dir/x/b.proto", b), ("x/c.proto", c)]).or_fault("gen_set")
  expect(out[1].contains("a proto \"1\": A")) == true
  expect(out[1].contains("i proto \"2\": AIn")) == true
  // x/a.proto reaches C through b's `import public`
  expect(out[2].contains("a proto \"2\": A")) == true
  // D imports C, which imports B without public: A is not visible
  expect(gen_set([("x/a.proto", a), ("x/b.proto", b), ("x/c.proto", c), ("x/d.proto", d)]).is_err()) == true
  // the same file alone: the import is not in the set
  expect(gen(b).is_err()) == true
}

test "gen_set: an enum of an imported file resolves, the well-known types are std/protowkt's, and other types outside the set are errors (decision 0683 item 4)" {
  let a = must("syntax = \"proto2\";\npackage x.a;\nenum K { Z = 0; }\nmessage A { enum E { Y = 0; } }")
  let b = must("syntax = \"proto2\";\npackage x.b;\nimport \"x/a.proto\";\nmessage B { optional x.a.K k = 1; repeated x.a.K ks = 2; }")
  let c = must("syntax = \"proto3\";\npackage x.c;\nimport \"x/a.proto\";\nmessage C { x.a.A.E e = 1; }")
  let ob = gen_set([("x/a.proto", a), ("x/b.proto", b)]).or_fault("gen_set b")
  expect(ob[1].contains("pub k proto \"1\": K?")) == true
  // an imported enum is a number: unpacked in proto2 as in the file's own
  expect(ob[1].contains("pub ks proto \"2,unpacked\": List[K]")) == true
  expect(ob[1].contains("use ")) == false
  let oc = gen_set([("x/a.proto", a), ("x/c.proto", c)]).or_fault("gen_set c")
  expect(oc[1].contains("pub e proto \"1\": AE")) == true
  let s = gen(must("syntax = \"proto3\";\nimport \"google/protobuf/timestamp.proto\";\nimport \"google/protobuf/struct.proto\";\nmessage S { google.protobuf.Timestamp t = 1; repeated .google.protobuf.Value vs = 2; }")).or_fault("gen s")
  expect(s.starts_with("use std/protowkt\n\n")) == true
  expect(s.contains("pub t proto \"1\": protowkt.Timestamp")) == true
  expect(s.contains("pub vs proto \"2\": List[protowkt.Value]")) == true
  expect(gen(must("syntax = \"proto3\";\nmessage S { google.protobuf.Nope n = 1; }")).is_err()) == true
}

test "gen writes pub types and no use line (derive Proto needs none; an unused use is XO0110)" {
  let src = gen(must("message M { int32 v = 1; oneof w { string s = 2; } }\nenum K { Z = 0; }")).or_fault("gen")
  expect(src.contains("use ")) == false
  expect(src.contains("pub struct M {")) == true
  expect(src.contains("  pub v proto \"1\": Int32")) == true
  expect(src.contains("  pub w proto \"oneof\": MW?")) == true
  expect(src.contains("pub enum MW {")) == true
  expect(src.contains("pub enum K: Int {")) == true
}

test "a type name's parts may be apart, and a float may start with a dot (protoc reads both)" {
  let f = parse("syntax = \"proto2\";\npackage a . b;\nextend . google. // x\n  protobuf .\n FieldOptions {\n  optional float r = 50001 [default = .5];\n}\n").or_fault("parse")
  expect(f.package) == "a.b"
  expect(f.extends[0].extendee) == ".google.protobuf.FieldOptions"
  expect(f.extends[0].fields[0].default_value) == b".5"
  let toks = tokens(".25 a.").or_fault("tokens")
  expect(toks.map(fn(t: Token) -> Str { t.text })) == [".25", "a."]
  expect(toks[0].kind == Kind.Float) == true
}

test "an aggregate keeps a bracketed extension key, a list's elements, and an angle bracketed message" {
  let f = parse("syntax = \"proto2\";\noption (o) = { foo: \"a\" [x.y.ext]: \"b\" n: [1, 2] m < k: 3 > l: [{ k: 4 }, { k: 5 }] };\n").or_fault("parse")
  expect(aggregate_pairs(f.options[0].1)) == [("foo", b"a"), ("[x.y.ext]", b"b"), ("n", b"1"), ("n", b"2"), ("m.k", b"3"), ("l.k", b"4"), ("l.k", b"5")]
}

test "string escapes read as protoc reads them" {
  let toks = tokens("\"\\001\\a\\b\\f\\v\\x41\\u00e9\\101\\\"\\'\\\\z\"").or_fault("tokens")
  expect(toks[0].text.bytes()) == b"\x01\x07\x08\x0c\x0bA\xc3\xa9A\"'\\z"
}

test "a group in an extend block: its message among the scope's messages, where the extend is" {
  let f = parse("syntax = \"proto2\";\nmessage A { extensions 10 to 20; }\nextend A {\n  optional group G = 10 { optional int32 v = 1; }\n}\nmessage B {}\n").or_fault("parse")
  expect(f.messages.map(fn(m: Message) -> Str { m.name })) == ["A", "G", "B"]
  expect(f.extends[0].fields[0].group) == true
}

test "escapes giving invalid UTF-8 keep their bytes: a bytes default, string and aggregate option values" {
  let f = parse("syntax = \"proto2\";\noption (o) = \"a\\377b\";\noption (g) = { s: \"\\xff\" \"\\xfe\" };\nmessage M {\n  optional bytes b = 1 [default = \"\\377\\0\\x80\", (f) = \"\\303\" \"\\251\"];\n}\n").or_fault("parse")
  expect(f.options[0].1) == b"a\xffb"
  expect(aggregate_pairs(f.options[1].1)) == [("s", b"\xff\xfe")]
  let fl = f.messages[0].fields[0]
  expect(fl.default_value) == b"\xff\x00\x80"
  // adjacent literals join before they are read as UTF-8: two halves of é
  expect(fl.options) == [("(f)", b"\xc3\xa9")]
  let toks = tokens("\"\\377\"").or_fault("tokens")
  expect(toks[0].raw) == b"\xff"
  expect(toks[0].text) == "\u{fffd}"
}
