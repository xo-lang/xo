// std/big (spec/std.md 33, decision 0311). Declaration file; encoding
// rules are listed at the top of std/prelude.xo. Go's math/big Int as an
// immutable value: every operation returns a new BigInt, with Go's results
// and error texts. Variable time: not for secrets. Pure.

/// An integer of any size. `key` encodes it so that the derived order is
/// the numeric one: zero is [0]; a number of n 64 bit limbs is n (-n when
/// negative), then its limbs from the most significant, each xor the sign
/// bit (xor 2^63 - 1 when negative). Build one with the functions below,
/// not a literal.
struct BigInt {
  key: List[Int]
} derive Eq, Ord, Hash

/// `invalid number "12x" in base 10`, `invalid base 63` (Go's SetString
/// reports only false).
struct BigErr {
  msg: Str
}

fn (e: BigErr) display() -> Str

/// n (Go's NewInt).
fn from_int(n: Int) -> BigInt
/// The number s in base 2 to 62 (Go's SetString): an optional sign, then
/// digits; base 0 reads a 0b, 0o, 0, or 0x prefix and `_` between digits.
fn parse(s: Str, base: Int = 10) -> BigInt ! BigErr
/// The unsigned big-endian number b (Go's SetBytes).
fn from_bytes(b: Bytes) -> BigInt

fn (x: BigInt) add(y: BigInt) -> BigInt
fn (x: BigInt) sub(y: BigInt) -> BigInt
fn (x: BigInt) mul(y: BigInt) -> BigInt
/// x / y truncated toward zero (Go's Quo); a fault when y is 0.
fn (x: BigInt) quo(y: BigInt) -> BigInt
/// x - y * x.quo(y), with x's sign (Go's Rem).
fn (x: BigInt) rem(y: BigInt) -> BigInt
fn (x: BigInt) quo_rem(y: BigInt) -> (BigInt, BigInt)
/// Euclidean division (Go's Div): the remainder is never negative.
fn (x: BigInt) div(y: BigInt) -> BigInt
/// x mod y in 0 to |y| - 1 (Go's Mod).
fn (x: BigInt) mod(y: BigInt) -> BigInt
fn (x: BigInt) div_mod(y: BigInt) -> (BigInt, BigInt)
/// x to the y, mod |m| when m is given and not 0 (Go's Exp): y <= 0 gives
/// 1 without m; with m, a negative y uses x's inverse mod m, a fault when
/// there is none (Go returns nil).
fn (x: BigInt) exp(y: BigInt, m: BigInt? = None) -> BigInt
/// The greatest common divisor of |x| and |y|; 0 when both are 0.
fn (x: BigInt) gcd(y: BigInt) -> BigInt
/// x's inverse mod m, None when gcd(x, m) is not 1 (Go's ModInverse).
fn (x: BigInt) mod_inverse(m: BigInt) -> BigInt?
/// The floor of the square root; a fault when x < 0.
fn (x: BigInt) sqrt() -> BigInt
fn (x: BigInt) neg() -> BigInt
fn (x: BigInt) abs() -> BigInt
/// -1, 0, or 1.
fn (x: BigInt) sign() -> Int
/// -1, 0, or 1 as x <, ==, > y (also the operators).
fn (x: BigInt) cmp(y: BigInt) -> Int
fn (x: BigInt) cmp_abs(y: BigInt) -> Int
/// x * 2^n; a fault when n < 0.
fn (x: BigInt) lsh(n: Int) -> BigInt
/// x / 2^n rounded toward negative infinity (Go's Rsh); a fault when n < 0.
fn (x: BigInt) rsh(n: Int) -> BigInt
/// The bitwise operations on two's complement, as Go's And, Or, Xor,
/// AndNot, Not.
fn (x: BigInt) and(y: BigInt) -> BigInt
fn (x: BigInt) or(y: BigInt) -> BigInt
fn (x: BigInt) xor(y: BigInt) -> BigInt
fn (x: BigInt) and_not(y: BigInt) -> BigInt
fn (x: BigInt) not() -> BigInt
/// Bit i of x's two's complement (0 or 1); a fault when i < 0.
fn (x: BigInt) bit(i: Int) -> Int
/// The length of |x| in bits; 0 for 0.
fn (x: BigInt) bit_len() -> Int
/// The number of zero bits below the lowest one of |x|; 0 for 0.
fn (x: BigInt) trailing_zeros() -> Int
/// Whether x is probably prime: n Miller-Rabin rounds with Go's
/// pseudorandom bases plus a Baillie-PSW test (Go's ProbablyPrime); a
/// fault when n < 0.
fn (x: BigInt) probably_prime(n: Int) -> Bool
/// x in base 2 to 62: digits, then a to z, then A to Z (Go's Text); a
/// fault for another base.
fn (x: BigInt) text(base: Int = 10) -> Str
/// |x| big-endian, no leading zeros (Go's Bytes).
fn (x: BigInt) bytes() -> Bytes
/// |x| big-endian in len bytes, zeros first; a fault when it does not fit
/// (Go's FillBytes).
fn (x: BigInt) fill_bytes(len: Int) -> Bytes
/// x as an Int, None when it does not fit (Go's IsInt64 and Int64).
fn (x: BigInt) to_int() -> Int?
/// The Float nearest x (Go's Float64; out of range is +Inf or -Inf).
fn (x: BigInt) to_float() -> Float
/// x in base 10.
fn (x: BigInt) display() -> Str
fn (x: BigInt) debug() -> Str

// ---------------------------------------------------------------------------
// BigFloat (decision 0602): Go's math/big Float as an immutable value.

/// How a result is rounded to its precision (Go's RoundingMode, in Go's
/// order and with Go's names).
enum RoundingMode {
  ToNearestEven
  ToNearestAway
  ToZero
  AwayFromZero
  ToNegativeInf
  ToPositiveInf
} derive Display, Eq, Hash

/// How a result compares with the exact one (Go's Accuracy): Below is
/// smaller, Above larger.
enum Accuracy {
  Below
  Exact
  Above
} derive Display, Eq, Hash

/// A binary floating point number of any precision (Go's big.Float):
/// zero, finite or infinite (`form` 0, 1 or 2, Go's order), with a sign
/// (-0 and -Inf exist, NaN does not). A finite value is `mant` (positive,
/// no trailing zero bits, at most `prec` bits) times 2^(exp -
/// mant.bit_len()), so `exp` is Go's exponent. `prec` is in bits, 0 to
/// 2^32 - 1; `acc` is the accuracy of the operation that made the value.
/// Build one with the functions below, not a literal. Variable time.
struct BigFloat {
  prec: Int
  mode: RoundingMode
  acc: Accuracy
  form: Int
  neg: Bool
  mant: BigInt
  exp: Int
} derive Eq, Hash

/// x with prec bits (Go's NewFloat and SetFloat64; 0 means 53); a fault
/// for NaN.
fn from_float(x: Float, prec: Int = 0) -> BigFloat
/// n with prec bits (Go's SetInt64; 0 means 64).
fn float_from_int(n: Int, prec: Int = 0) -> BigFloat
/// x with prec bits (Go's SetInt; 0 means max(x.bit_len(), 64)).
fn (x: BigInt) to_big_float(prec: Int = 0) -> BigFloat
/// +Inf, or -Inf when neg (Go's SetInf).
fn inf(neg: Bool) -> BigFloat
/// s as a number (Go's ParseFloat): an optional sign, then digits with an
/// optional point and exponent ('e', or 'p' for a power of two), "Inf" or
/// "inf"; base 0 takes a 0b, 0o or 0x prefix and `_` separators; prec 0
/// means 64. Go's error texts.
fn parse_float(s: Str, base: Int = 0, prec: Int = 0, mode: RoundingMode = RoundingMode.ToNearestEven) -> BigFloat ! BigErr

/// The precision in bits (Go's Prec).
fn (x: BigFloat) prec() -> Int
/// The bits x needs to be exact; 0 unless finite (Go's MinPrec).
fn (x: BigFloat) min_prec() -> Int
fn (x: BigFloat) mode() -> RoundingMode
fn (x: BigFloat) acc() -> Accuracy
/// -1, 0 or 1 (Go's Sign; 0 for -0 too).
fn (x: BigFloat) sign() -> Int
/// Whether x is negative or -0 (Go's Signbit).
fn (x: BigFloat) signbit() -> Bool
fn (x: BigFloat) is_inf() -> Bool
/// Whether x is an integer; false for infinities (Go's IsInt).
fn (x: BigFloat) is_int() -> Bool
/// x rounded to prec bits by its mode (Go's SetPrec; 0 makes a finite x
/// zero); a fault when prec < 0.
fn (x: BigFloat) with_prec(prec: Int) -> BigFloat
/// x with another rounding mode, its accuracy Exact (Go's SetMode).
fn (x: BigFloat) with_mode(mode: RoundingMode) -> BigFloat

/// x + y at prec bits (0: max(x.prec, y.prec)) by x's mode; a fault for
/// infinities of opposite signs (Go's Add).
fn (x: BigFloat) add(y: BigFloat, prec: Int = 0) -> BigFloat
/// x - y, as add (Go's Sub).
fn (x: BigFloat) sub(y: BigFloat, prec: Int = 0) -> BigFloat
/// x * y, as add; a fault for zero times infinity (Go's Mul).
fn (x: BigFloat) mul(y: BigFloat, prec: Int = 0) -> BigFloat
/// x / y, as add; a fault for 0/0 and Inf/Inf (Go's Quo).
fn (x: BigFloat) quo(y: BigFloat, prec: Int = 0) -> BigFloat
/// The square root at prec bits (0: x.prec) by x's mode, Go's Newton
/// iteration; a fault when x < 0 (Go's Sqrt).
fn (x: BigFloat) sqrt(prec: Int = 0) -> BigFloat
/// -x and |x| at x's precision and mode (Go's Neg and Abs into a copy of x).
fn (x: BigFloat) neg() -> BigFloat
fn (x: BigFloat) abs() -> BigFloat
/// -1, 0 or 1 as x is below, equal to or above y; -0 equals 0 (Go's Cmp).
fn (x: BigFloat) cmp(y: BigFloat) -> Int
/// x * 2^e at x's precision (Go's SetMantExp(x, e)): past the exponent
/// range a zero or an infinity.
fn (x: BigFloat) mul_pow2(e: Int) -> BigFloat
/// (mant, exp) with x = mant * 2^exp and 0.5 <= |mant| < 1 (Go's
/// MantExp); zero and infinities are their own mant, with exp 0.
fn (x: BigFloat) mant_exp() -> (BigFloat, Int)

/// x truncated toward zero as an Int, clamped to its range (Go's Int64).
fn (x: BigFloat) to_int() -> (Int, Accuracy)
/// The Float nearest x, ties to even (Go's Float64).
fn (x: BigFloat) to_float() -> (Float, Accuracy)
/// x truncated toward zero; None for an infinity (Go's Int).
fn (x: BigFloat) to_big() -> (BigInt?, Accuracy)

/// x in format 'e', 'E', 'f', 'g', 'G' (prec digits; a negative prec is
/// the fewest that read back as x), 'b' (mantissa p exponent), 'p' (hex
/// mantissa, binary exponent) or 'x' (hex, prec digits); "%" and the
/// format for another (Go's Text).
fn (x: BigFloat) text(format: Int, prec: Int) -> Str
/// text('g', 10) (Go's String).
fn (x: BigFloat) display() -> Str
fn (x: BigFloat) debug() -> Str

// ---------------------------------------------------------------------------
// BigRat (decision 0608): Go's math/big Rat as an immutable value.

/// A rational number a/b in lowest terms with b > 0 (b is 1 for an
/// integer), so == is numeric equality. Build one with the functions
/// below, not a literal.
struct BigRat {
  a: BigInt
  b: BigInt
} derive Eq, Hash

/// a/b (Go's SetFrac); a fault when b is 0.
fn rat(a: BigInt, b: BigInt) -> BigRat
/// n/1 (Go's SetInt64).
fn rat_from_int(n: Int) -> BigRat
/// x/1 (Go's SetInt).
fn (x: BigInt) to_rat() -> BigRat
/// x exactly (Go's SetFloat64); None for NaN and the infinities.
fn rat_from_float(x: Float) -> BigRat?
/// Go's SetString: `a/b` (a with an optional sign and base prefix, b
/// with a base prefix, `0` alone meaning octal), or a number with an
/// optional sign, base prefix, fraction and `e` or `p` exponent. The
/// error is `math/big: cannot unmarshal "s" into a *big.Rat` (Go's
/// UnmarshalText; SetString reports only false).
fn parse_rat(s: Str) -> BigRat ! BigErr

fn (x: BigRat) add(y: BigRat) -> BigRat
fn (x: BigRat) sub(y: BigRat) -> BigRat
fn (x: BigRat) mul(y: BigRat) -> BigRat
/// x / y; a fault when y is 0.
fn (x: BigRat) quo(y: BigRat) -> BigRat
fn (x: BigRat) neg() -> BigRat
fn (x: BigRat) abs() -> BigRat
/// 1 / x; a fault when x is 0.
fn (x: BigRat) inv() -> BigRat
/// The numerator, with x's sign.
fn (x: BigRat) num() -> BigInt
/// The denominator, always positive (1 for an integer).
fn (x: BigRat) denom() -> BigInt
/// -1, 0, or 1.
fn (x: BigRat) sign() -> Int
/// -1, 0, or 1 as x <, ==, > y.
fn (x: BigRat) cmp(y: BigRat) -> Int
fn (x: BigRat) is_int() -> Bool
/// The Float nearest x and whether it is exact (Go's Float64).
fn (x: BigRat) to_float() -> (Float, Bool)
/// The number of decimal digits after the point that x needs, and
/// whether that many represent it exactly (Go's FloatPrec).
fn (x: BigRat) float_prec() -> (Int, Bool)
/// `a/b`, `/1` for an integer too (Go's String).
fn (x: BigRat) text() -> Str
/// `a/b`, or `a` for an integer (Go's RatString).
fn (x: BigRat) rat_text() -> Str
/// x in decimal with prec digits after the point, the last rounded half
/// away from zero (Go's FloatString).
fn (x: BigRat) float_text(prec: Int) -> Str
/// x rounded to a BigFloat of prec bits (Go's SetRat; prec 0 is the
/// larger of the numerator's and denominator's, at least 64).
fn (x: BigRat) to_big_float(prec: Int = 0, mode: RoundingMode = RoundingMode.ToNearestEven) -> BigFloat
/// x as a BigRat with Exact, or None and Above or Below for an infinity
/// (Go's Float.Rat).
fn (x: BigFloat) to_rat() -> (BigRat?, Accuracy)
fn (x: BigRat) display() -> Str
fn (x: BigRat) debug() -> Str
