// std/trace (spec/std.md 38, decision 0325). Encoding
// rules are listed at the top of std/prelude.xo. Request ids and a
// bounded ring of spans (what took how long inside a request), with no
// exporter: a handler reads the ring. A `traceparent`-style exporter is a
// program's own code over `Ring.spans`.
//
// std/trace on the native backends and, through std/go_compiled.txt, the
// Go backend (decisions 0312 and 0325): one source.

use std/http

/// One timed piece of work of a request: the request's id, the span's name
/// (`request` for the whole request, a program's own for the rest), when it
/// started (Unix milliseconds), how long it took (microseconds), and the
/// response status for `request` spans (0 otherwise).
///
/// The fields after `status` are OpenTelemetry's (decision 0580); all default to "as before" and
/// are left out of the JSON when empty, so a span that sets none of them reads and writes as it
/// did. `trace_id` (32 hex digits), `span_id` and `parent_id` (16; "root" makes a root span) name
/// the span; "" derives them as std/otlp always has. `kind` None keeps the request/internal rule,
/// `status_code` None the HTTP status rule. `start_ns` and `end_ns` (Unix nanoseconds, when
/// above 0) replace `start_ms` and `micros` in an export. `scope`, `scope_version` and
/// `schema_url` name the instrumentation scope ("" is the exporter's Resource scope).
pub struct Span {
  pub id: Str
  pub name: Str
  pub start_ms: Int
  pub micros: Int
  pub status: Int
  trace_id as ",omitempty": Str = ""
  span_id as ",omitempty": Str = ""
  parent_id as ",omitempty": Str = ""
  kind as ",omitempty": SpanKind? = None
  attributes as ",omitempty": List[Attr] = []
  events as ",omitempty": List[Event] = []
  status_code as ",omitempty": StatusCode? = None
  status_message as ",omitempty": Str = ""
  start_ns as ",omitempty": Int = 0
  end_ns as ",omitempty": Int = 0
  scope as ",omitempty": Str = ""
  scope_version as ",omitempty": Str = ""
  schema_url as ",omitempty": Str = ""
} derive Json

/// OTLP's SpanKind (the declaration order is OTLP's numbers).
pub enum SpanKind { Unspecified, Internal, Server, Client, Producer, Consumer } derive Json

/// OTLP's Status.code.
pub enum StatusCode { Unset, Ok, Error } derive Json

/// An attribute value: OTLP's scalar AnyValue kinds.
pub enum AttrValue {
  Str(v: Str)
  Int(v: Int)
  Float(v: Float)
  Bool(v: Bool)
} derive Json

/// One attribute: a key and its value.
pub struct Attr {
  pub key: Str
  pub value: AttrValue
} derive Json

/// A timestamped event inside a span (`time_ns` is Unix nanoseconds).
pub struct Event {
  pub name: Str
  pub time_ns: Int
  attributes as ",omitempty": List[Attr] = []
} derive Json

/// A bounded ring of the last `cap` spans. Cloning shares it. Its fields
/// are internal.
pub struct Ring {
  pub buf: Mutex[List[Span]]
  pub cap: Int
}

/// A ring of the last `cap` spans (default 1000).
pub fn ring(cap: Int = 1000) -> Ring {
  Ring{buf: Mutex[List[Span]].new([]), cap: if cap < 1 { 1 } else { cap }}
}

/// The request id middleware (`router.wrap(ring.middleware(rand, clock))`):
/// takes the id from the `X-Request-Id` header (when it is 1 to 64
/// printable characters) or makes a random 64 bit one, puts it in the
/// request (`id(req)`), answers it in the `X-Request-Id` header, and
/// records a `request` span.
pub fn (r: Ring) middleware(rand: Rand, clock: Clock) -> fn(http.Request, http.Next) -> http.Response uses (rand, clock) {
  fn(req, next) -> http.Response {
    let given = req.header("X-Request-Id") ?? ""
    let rid = if valid_id(given) { given } else { rand.bytes(8).to_hex() }
    let t0 = clock.now()
    var resp = next(req.with_value(key(), rid))
    let d = clock.since(t0)
    push(r, Span{id: rid, name: "request", start_ms: t0.unix_millis(), micros: d.nanos() / 1000, status: resp.status})
    resp.headers.put("X-Request-Id", rid)
    resp
  }
}

/// The id of a request that passed through the middleware, else "".
pub fn id(req: http.Request) -> Str {
  req.value(key()) ?? ""
}

/// Records a span of the work started at `start` that took `d`, for the
/// request `id`.
pub fn (r: Ring) record(id: Str, name: Str, start: Time, d: Duration) {
  push(r, Span{id: id, name: name, start_ms: start.unix_millis(), micros: d.nanos() / 1000, status: 0})
}

/// The spans, newest first, of at most `n` (all when n <= 0) whose
/// duration is at least `min`.
pub fn (r: Ring) spans(min: Duration, n: Int) -> List[Span] {
  let all = r.buf.with_read(fn(l: List[Span]) -> List[Span] { l })
  var out: List[Span] = []
  var i = all.len()
  let first = if all.len() > r.cap { all.len() - r.cap } else { 0 }
  while i > first {
    i -= 1
    let s = all[i]
    if s.micros * 1000 >= min.nanos() {
      out.push(s)
      if n > 0 && out.len() >= n {
        break
      }
    }
  }
  out
}

/// Starts and ends spans into a Ring with ids from `rand` and times from `clock`. Cloning shares it.
pub struct Recorder {
  pub ring: Ring
  pub clock: Clock
  pub rand: Rand
}

/// A recorder writing into `ring`.
pub fn recorder(ring: Ring, clock: Clock, rand: Rand) -> Recorder {
  Recorder{ring: ring, clock: clock, rand: rand}
}

/// A span in progress. Its ids are known at start, so a caller can hand them to children. Cloning
/// shares it. Its fields are internal.
pub struct Active {
  pub ring: Ring
  pub clock: Clock
  pub span: Mutex[Span]
  pub done: Mutex[Bool]
}

/// Starts a span. `parent` is the (trace id, span id) of its parent; None starts a new trace (16
/// random bytes; span ids are 8; never all zero). The span's id (the request id of the Ring) is
/// its trace id.
pub fn (r: Recorder) start(name: Str, parent: (Str, Str)? = None, kind: SpanKind = SpanKind.Internal, attributes: List[Attr] = [], scope: Str = "", scope_version: Str = "", schema_url: Str = "") -> Active uses (clock, rand) {
  let t = r.clock.now()
  let ns = unix_nanos(t)
  var tid = ""
  var pid = "root"
  match parent {
    Some((pt, ps)) => {
      tid = pt
      pid = ps
    }
    None => {
      tid = rand_hex(r.rand, 16)
    }
  }
  let s = Span{
    id: tid, name: name, start_ms: ns / 1000000, micros: 0, status: 0,
    trace_id: tid, span_id: rand_hex(r.rand, 8), parent_id: pid, kind: Some(kind),
    attributes: merge_attrs([], attributes), start_ns: ns, end_ns: ns, scope: scope, scope_version: scope_version, schema_url: schema_url,
  }
  Active{ring: r.ring, clock: r.clock, span: Mutex[Span].new(s), done: Mutex[Bool].new(false)}
}

/// The (trace id, span id) of the span, as hex.
pub fn (a: Active) ids() -> (Str, Str) {
  a.span.with_read(fn(s: Span) -> (Str, Str) { (s.trace_id, s.span_id) })
}

/// Adds attributes; a key already set takes the new value (OpenTelemetry's last value wins).
pub fn (a: Active) set_attributes(attrs: List[Attr]) {
  a.span.with(fn(var s: Span) {
    s = s with {attributes: merge_attrs(s.attributes, attrs)}
  })
}

/// Adds an event stamped now.
pub fn (a: Active) add_event(name: Str, attributes: List[Attr] = []) uses clock {
  let ns = unix_nanos(a.clock.now())
  a.span.with(fn(var s: Span) {
    var ev = s.events
    ev.push(Event{name: name, time_ns: ns, attributes: attributes})
    s = s with {events: ev}
  })
}

/// Sets the status. A message is kept for Error only, as OpenTelemetry Go does.
pub fn (a: Active) set_status(code: StatusCode, message: Str = "") {
  a.span.with(fn(var s: Span) {
    s = span_set_status(s, code, message)
  })
}

/// Ends the span now and records it into the Ring; ending again does nothing.
pub fn (a: Active) end() uses clock {
  let first = a.done.with(fn(var d: Bool) -> Bool {
    if d {
      return false
    }
    d = true
    true
  })
  if !first {
    return
  }
  let ns = unix_nanos(a.clock.now())
  let s = a.span.with(fn(var s: Span) -> Span {
    let end = if ns < s.start_ns { s.start_ns } else { ns }
    s = s with {end_ns: end, micros: (end - s.start_ns) / 1000}
    s
  })
  push(a.ring, s)
}

/// A handler answering the spans as JSON (`?slow=MILLIS&n=N`; defaults 0
/// and 100): `router.handle("GET /debug/requests", ring.handler(auth))`;
/// a request for which `auth` answers false gets 403.
pub fn (r: Ring) handler(auth: fn(http.Request) -> Bool) -> fn(http.Request) -> http.Response {
  fn(req) -> http.Response {
    if !auth(req) {
      return http.text(403, "forbidden\n")
    }
    let slow = Int.parse(req.query("slow") ?? "") ?? 0
    let n = Int.parse(req.query("n") ?? "") ?? 100
    http.json(200, r.spans(Duration.from_millis(slow), n))
  }
}

fn key() -> http.Key[Str] {
  http.key("xo.request_id")
}

/// 1 to 64 printable ASCII characters, no spaces.
fn valid_id(s: Str) -> Bool {
  if s.is_empty() || s.len() > 64 {
    return false
  }
  for c in s.bytes() {
    if Int(c) <= 32 || Int(c) >= 127 {
      return false
    }
  }
  true
}

// The list grows to twice the cap before it drops its oldest half, so a
// push copies cap spans once per cap pushes instead of on every push past
// the cap; ring_spans reads only the newest cap. The trim comes before the
// push: a write followed by a fault point inside a with keeps the old list
// alive for the rollback, so the push would copy the list.
fn push(r: Ring, s: Span) {
  let cap = r.cap
  r.buf.with(fn(var l: List[Span]) {
    if l.len() >= 2 * cap {
      l = l[l.len() - cap + 1..]
    }
    l.push(s)
  })
}

/// Unix nanoseconds of an instant.
fn unix_nanos(t: Time) -> Int {
  let s = t.unix()
  s * 1000000000 + (t - Time.from_unix(s)).nanos()
}

/// n random bytes as hex, never all zero.
fn rand_hex(rand: Rand, n: Int) -> Str uses rand {
  var b = rand.bytes(n)
  var zero = true
  for c in b {
    if c != 0 {
      zero = false
    }
  }
  if zero {
    b = rand.bytes(n)
    if b[0] == 0 && b[n - 1] == 0 {
      return "0".repeat(2 * n - 1) + "1"
    }
  }
  b.to_hex()
}

/// attrs merged into base: a key already there takes the new value in place.
fn merge_attrs(base: List[Attr], attrs: List[Attr]) -> List[Attr] {
  var out = base
  for a in attrs {
    var at = -1
    for (i, o) in out.indexed() {
      if o.key == a.key {
        at = i
      }
    }
    if at >= 0 {
      out[at] = a
    } else {
      out.push(a)
    }
  }
  out
}

/// OpenTelemetry Go's SetStatus: Unset changes nothing, Ok is final and drops its description, Error keeps the last message
/// (until an Ok).
fn span_set_status(s: Span, code: StatusCode, message: Str) -> Span {
  if s.status_code == Some(StatusCode.Ok) {
    return s
  }
  match code {
    StatusCode.Unset => s
    StatusCode.Ok => s with {status_code: Some(code), status_message: ""}
    StatusCode.Error => s with {status_code: Some(code), status_message: message}
  }
}
