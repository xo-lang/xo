// std/archive (spec/std.md 18, decision 0164). Declaration file;
// encoding rules are listed at the top of std/prelude.xo. gzip
// compression and tar and zip archives, in memory and pure: read and
// write the bytes with Fs.

/// A file or directory of an archive. `path` uses `/`; a directory's
/// `data` is empty (unzip and untar of an entry whose mode says directory
/// return no data for it, even when the archive stores some, decision 0164).
struct Entry {
  path: Str
  data: Bytes
  mode: Int
  is_dir: Bool
  modified: Time
}

/// Displays as `archive: ...`.
struct ArchiveErr {
  msg: Str
}

fn (e: ArchiveErr) display() -> Str

/// A file entry with mode 0o644 and the Unix epoch as its time.
fn file(path: Str, data: Bytes) -> Entry
/// A directory entry with mode 0o755.
fn dir(path: Str) -> Entry

/// data compressed in the gzip format (RFC 1952), at the default level.
fn gzip(data: Bytes) -> Bytes
/// More than max_size bytes of output is an error (`gunzip: gzip: output
/// exceeds max_size (N bytes)`), found as it passes max_size, so a small
/// hostile input cannot ask for more memory than max_size.
fn gunzip(data: Bytes, max_size: Int = 1073741824) -> Bytes ! ArchiveErr
/// A tar archive (POSIX ustar or PAX) of the entries, in order.
fn tar(entries: List[Entry]) -> Bytes ! ArchiveErr
/// A tar archive written entry by entry to a File (Go's tar.Writer):
/// memory is one entry's header, not the data. Headers are what `tar`
/// writes (USTAR, PAX when the name or time needs it). The File stays
/// the caller's: open it for writing, and close it after `close`.
/// @move_only
struct TarWriter {}

fn tar_writer(f: File) -> TarWriter
/// Writes an entry whose data is in hand (WriteHeader and Write).
fn (var w: TarWriter) add(e: Entry) -> () ! ArchiveErr uses fs.write
/// Starts a file entry of size bytes (WriteHeader: the size comes first in
/// tar); `write` gives it exactly that many. The entry before it must be
/// whole: else `tar_writer: archive/tar: missed writing N bytes`.
fn (var w: TarWriter) create(path: Str, size: Int, mode: Int = 0o644, modified: Time = Time.UNIX_EPOCH) -> () ! ArchiveErr uses fs.write
/// Data for the entry `create` started; past its size, the part that fits
/// is written and the rest is `tar_writer: archive/tar: write too long`.
fn (var w: TarWriter) write(data: Bytes) -> () ! ArchiveErr uses fs.write
/// The current entry's padding (Go's Flush): an error while it misses
/// bytes.
fn (var w: TarWriter) flush() -> () ! ArchiveErr uses fs.write
/// Flushes (its error, if any, is close's) and writes the two zero blocks
/// that end the archive.
/// @moves
fn (var w: TarWriter) close() -> () ! ArchiveErr uses fs.write

/// The entries of a tar archive. An entry whose path is absolute or
/// leaves the archive's root (`..`) is an error, as are links and devices.
fn untar(data: Bytes) -> List[Entry] ! ArchiveErr
/// How a zip entry's data is kept: deflated, or stored as it is (Go's
/// zip.Deflate and zip.Store). A directory is always stored.
enum ZipMethod {
  Deflate
  Store
} derive Eq, Debug

/// A zip archive of the entries, in order, each written by method, with
/// the archive comment comment (Go's Writer.SetComment: more than 65535
/// bytes is `zip: zip: Writer.Comment too long`). offset is where the
/// archive will start in its file (Go's Writer.SetOffset): the bytes to
/// append after offset bytes of something else, such as an executable.
fn zip(entries: List[Entry], comment: Str = "", method: ZipMethod = ZipMethod.Deflate, offset: Int = 0) -> Bytes ! ArchiveErr
/// The entries of a zip archive, with the same path rules as untar. An
/// archive whose files declare more than max_size bytes in all is an error
/// before any is inflated (`unzip: zip: files exceed max_size (N bytes)`),
/// and a file that inflates past its declared size stops there with Go's
/// `zip: not a valid zip file`.
fn unzip(data: Bytes, max_size: Int = 1073741824) -> List[Entry] ! ArchiveErr

/// One entry of a zip archive's central directory (decision 0479):
/// `size` is the inflated length and `compressed` the stored one. The
/// fields after `modified` are the header's own, for `ZipReader.read`.
struct ZipFile {
  path: Str
  size: Int
  compressed: Int
  mode: Int
  is_dir: Bool
  modified: Time
  offset: Int
  method: Int
  flags: Int
  crc: Int
}

/// A zip archive (in memory, or in a File) whose central directory was
/// read once and whose entries are inflated one at a time. @internal: use `zip_reader`,
/// `r.files()` and `r.read(f)`
struct ZipReader {
  data: Bytes
  list: List[ZipFile]
  file: File?
  total: Int
  note: Str = ""
}

/// The archive's directory, checked as `unzip` checks it (paths, kinds,
/// Go's errors); no entry is inflated.
fn zip_reader(data: Bytes) -> ZipReader ! ArchiveErr
/// The entries in directory order.
fn (r: ZipReader) files() -> List[ZipFile]
/// The archive comment (Go's Reader.Comment; a byte that is not UTF-8
/// reads as U+FFFD).
fn (r: ZipReader) comment() -> Str
/// One entry's contents, inflated and checked against its CRC; a
/// directory's is empty.
fn (r: ZipReader) read(f: ZipFile) -> Bytes ! ArchiveErr uses fs.read
/// A zip archive of size bytes in a File (`Fs.stat` gives the size), read
/// in place: the tail and the central directory are read now and an
/// entry's bytes when `read` asks, so an archive larger than memory can be
/// walked. The File stays the caller's and must stay open and unchanged.
fn zip_open(f: File, size: Int) -> ZipReader ! ArchiveErr uses fs.read

/// A zip archive written entry by entry to a File (decision 0479): memory
/// is the directory records, not the data. The File stays the caller's:
/// open it for writing, and close it after `close`. Entries are deflated;
/// an archive past 65,535 entries or 4 GiB is an error (no zip64).
/// @move_only
struct ZipWriter {}

fn zip_writer(f: File) -> ZipWriter
/// Writes an entry whose data is in hand, ending the entry before it.
fn (var w: ZipWriter) add(e: Entry, method: ZipMethod = ZipMethod.Deflate) -> () ! ArchiveErr uses fs.write
/// Starts a streamed file entry (its time the Unix epoch, as `file`),
/// ending the one before it; `write` gives it data.
fn (var w: ZipWriter) create(path: Str, mode: Int = 0o644, method: ZipMethod = ZipMethod.Deflate) -> () ! ArchiveErr uses fs.write
/// The archive comment `close` writes (Go's Writer.SetComment): more than
/// 65535 bytes is `zip_writer: zip: Writer.Comment too long`.
fn (var w: ZipWriter) set_comment(comment: Str) -> () ! ArchiveErr
/// Where the archive starts in its File (Go's Writer.SetOffset), for an
/// archive written after n bytes of something else; a fault once the
/// writer has written (`zip: SetOffset called after data was written`).
fn (var w: ZipWriter) set_offset(n: Int)
/// Data for the entry `create` started (a data descriptor follows it).
fn (var w: ZipWriter) write(data: Bytes) -> () ! ArchiveErr uses fs.write
/// Ends the last entry and writes the central directory.
/// @moves
fn (var w: ZipWriter) close() -> () ! ArchiveErr uses fs.write
