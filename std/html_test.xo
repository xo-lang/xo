// std/html: Go's escape_test.go cases (go1.26.1) and the round trip.
/// (description, html, unescaped): Go's unescapeTests.
const UNESCAPE: List[(Str, Str, Str)] = [
  ("copy", "A\ttext\nstring", "A\ttext\nstring"),
  ("simple", "&amp; &gt; &lt;", "& > <"),
  ("quot", "&quot;x&QUOT; &quot &QUOT", "\"x\" \" \""),
  ("stringEnd", "&amp &amp", "& &"),
  ("multiCodepoint", "text &gesl; blah", "text \u{22DB}\u{FE00} blah"),
  ("decimalEntity", "Delta = &#916; ", "Delta = \u{0394} "),
  ("hexadecimalEntity", "Lambda = &#x3bb; = &#X3Bb ", "Lambda = \u{03BB} = \u{03BB} "),
  ("numericEnds", "&# &#x &#128;43 &copy = &#169f = &#xa9", "&# &#x \u{20AC}43 \u{00A9} = \u{00A9}f = \u{00A9}"),
  ("numericReplacements", "Footnote&#x87;", "Footnote\u{2021}"),
  ("copySingleAmpersand", "&", "&"),
  ("copyAmpersandNonEntity", "text &test", "text &test"),
  ("copyAmpersandHash", "text &#", "text &#"),
]

test "unescape_string: Go's cases" {
  for (desc, h, want) in UNESCAPE {
    expect(unescape_string(h)) == want
    let _ = desc
  }
}

test "escape_string: the five characters, and the round trip" {
  expect(escape_string("<a href=\"x\">&'</a>")) == "&lt;a href=&#34;x&#34;&gt;&amp;&#39;&lt;/a&gt;"
  expect(escape_string("plain")) == "plain"
  for s in ["", "A\ttext\nstring", "<>&'\"", "\u{20AC} \u{03BB} \u{22DB}\u{FE00}", "&amp; stays &amp;", "x&#; &#x; &zzz;"] {
    expect(unescape_string(escape_string(s))) == s
  }
}

test "escape_string: each character at each place of 0 to 100, against a byte loop" {
  let subs = ["&amp;", "&#39;", "&#34;", "&lt;", "&gt;"]
  var k = 0
  for c in ["&", "'", "\"", "<", ">"] {
    for n in 0..101 {
      for at in 0..n {
        var src = StrBuilder.new()
        var want = StrBuilder.new()
        for j in 0..n {
          if j == at || j % 37 == 5 {
            src.write(c)
            want.write(subs[k])
          } else {
            src.write("x")
            want.write("x")
          }
        }
        expect(escape_string(src.freeze())) == want.freeze()
      }
    }
    k += 1
  }
}

test "unescape_string: legacy names, prefixes and a name followed by text" {
  // &copy without a semicolon, &copyright as the prefix copy + "right"
  expect(unescape_string("&copy &copyright &notit")) == "\u{00A9} \u{00A9}right \u{00AC}it"
  // an unknown name stays
  expect(unescape_string("&xyzzy; &xyzzy")) == "&xyzzy; &xyzzy"
  // invalid numeric references: U+FFFD, surrogates, beyond the range
  expect(unescape_string("&#0; &#xD800; &#x110000;")) == "\u{FFFD} \u{FFFD} \u{FFFD}"
}

test "escape_string: adjacent and trailing specials, multi-byte runs" {
  expect(escape_string("&&<>'\"")) == "&amp;&amp;&lt;&gt;&#39;&#34;"
  expect(escape_string("é<ü>日本'語\"")) == "é&lt;ü&gt;日本&#39;語&#34;"
  expect(escape_string("x&")) == "x&amp;"
  expect(escape_string("&x")) == "&amp;x"
  expect(escape_string("")) == ""
}

/// escape_string by replacement, the reference of the word skipping one
/// (`&` first, so the others' `&` stays).
fn escape_ref(s: Str) -> Str {
  s.replace("&", "&amp;").replace("'", "&#39;").replace("\"", "&#34;").replace("<", "&lt;").replace(">", "&gt;")
}

test "escape_string: each special at each place of 0 to 40, and near misses" {
  let letters = ["a", "b", "c", "d", "e", "f", "g", "h"]
  for c in ["&", "'", "\"", "<", ">", "%", "=", "?", "\u{00A6}"] {
    for p in 0..41 {
      var s = ""
      for j in 0..41 {
        s = s + (if j == p { c } else { letters[j % 8] })
      }
      expect(escape_string(s)) == escape_ref(s)
    }
  }
}
