// std/netip (spec/std.md 28, decision 0287). Declaration file; encoding
// rules are listed at the top of std/prelude.xo. Go's net/netip: IP
// addresses and prefixes as values. Pure but for lookup (decision 0406).

/// An IP address: `bits` is 32 for IPv4, 128 for IPv6, 0 for the zero
/// value; `hi` and `lo` its 16 bytes as two words (an IPv4 address as
/// ::ffff:a.b.c.d); `zone` an IPv6 zone. The order is Go's Addr.Compare.
struct Addr {
  bits: Int
  /// the first and last 8 bytes, the first byte highest, with the top
  /// bit flipped so that the derived order of the signed words is the
  /// order of the bytes
  hi: Int
  lo: Int
  zone: Str
} derive Ord

/// An address and a prefix length.
struct Prefix {
  addr: Addr
  len: Int
}

/// An address and a port (Go's AddrPort); the order is Go's Compare: the
/// address, then the port.
struct AddrPort {
  addr: Addr
  port: Int
} derive Ord

/// Go's texts: `ParseAddr("1.2.3"): IPv4 address too short`.
struct ParseErr {
  msg: Str
}

fn (e: ParseErr) display() -> Str

/// Go's ParseAddr: IPv4 (no leading zeros), IPv6, IPv4 in IPv6, zones.
fn parse_addr(s: Str) -> Addr ! ParseErr
/// The addresses of host, in the order Net.dial tries them (Go's
/// net.LookupIP through Net.lookup_host; decision 0406).
fn lookup(n: Net, host: Str) -> List[Addr] ! NetErr uses net.dial
/// Go's ParsePrefix: `10.0.0.0/8`, `2001:db8::/32`.
fn parse_prefix(s: Str) -> Prefix ! ParseErr
/// The address of 4 or 16 bytes (AddrFrom4, AddrFrom16); None for another length.
fn addr_from_bytes(b: Bytes) -> Addr?
fn (a: Addr) is_4() -> Bool
fn (a: Addr) is_6() -> Bool
fn (a: Addr) is_4in6() -> Bool
/// An IPv4 in IPv6 address as IPv4 (its zone dropped), others as they are.
fn (a: Addr) unmap() -> Addr
fn (a: Addr) is_loopback() -> Bool
fn (a: Addr) is_private() -> Bool
fn (a: Addr) is_unspecified() -> Bool
fn (a: Addr) is_link_local_unicast() -> Bool
fn (a: Addr) is_multicast() -> Bool
/// 4 bytes for IPv4, 16 for IPv6 (Go's AsSlice).
fn (a: Addr) bytes() -> Bytes
/// Go's String: `1.2.3.4`, `2001:db8::1`, `::ffff:1.2.3.4`, `fe80::1%eth0`.
fn (a: Addr) display() -> Str
fn (p: Prefix) contains(a: Addr) -> Bool
fn (p: Prefix) masked() -> Prefix
fn (p: Prefix) display() -> Str

/// Go's ParseAddrPort: `1.2.3.4:80`, `[2001:db8::1]:443`, `[fe80::1%eth0]:22`
/// (an IPv6 address in brackets, an IPv4 one without).
fn parse_addr_port(s: Str) -> AddrPort ! ParseErr
/// Go's AddrPortFrom; port is 0 to 65535 (its low 16 bits otherwise, as
/// Go's uint16).
fn addr_port(addr: Addr, port: Int) -> AddrPort
/// Go's AddrPort.String: `1.2.3.4:80`, `[2001:db8::1]:443`.
fn (p: AddrPort) display() -> Str
/// Go's Addr.Prefix: the prefix of the first bits bits, the rest zeroed
/// and the zone dropped; an error for bits below 0 or past the family's.
fn (a: Addr) prefix(bits: Int) -> Prefix ! ParseErr
/// Go's Addr.Next and Prev: the address after or before, None past the
/// end of the family (the zone kept).
fn (a: Addr) next() -> Addr?
fn (a: Addr) prev() -> Addr?
/// Go's WithZone: an IPv6 address with zone (empty: none); an IPv4
/// address as it is.
fn (a: Addr) with_zone(zone: Str) -> Addr
/// Go's PrefixFrom: addr (its zone dropped, not masked) and bits; None
/// for bits below 0 or past the family's.
fn prefix_from(addr: Addr, bits: Int) -> Prefix?
/// Go's Prefix.Bits.
fn (p: Prefix) bits() -> Int
/// Go's Prefix.Overlaps: whether some address is in both.
fn (p: Prefix) overlaps(o: Prefix) -> Bool
/// Go's Prefix.IsSingleIP: the length is the family's.
fn (p: Prefix) is_single_ip() -> Bool
