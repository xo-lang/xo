// std/protowkt (decision 0546, item 2). Encoding rules are
// listed at the top of std/prelude.xo. The well known types of protobuf's
// google/protobuf/*.proto as Xo values: Timestamp, Duration, Empty,
// FieldMask, Any and the nine wrappers derive Proto (decision 0549, their
// field types protobuf-go's: nanos and the 32 bit wrappers Int32 and
// UInt32), and Struct, Value and ListValue, whose Value is a oneof enum
// that holds them recursively, keep codecs written by hand. `encode_*` writes fields in field number order with
// proto3 implicit presence (a zero value is not written; a Value's member and
// a Struct's map entries are); `decode_*` keeps the last value of a field,
// skips unknown fields, and is the wire reader's errors. Pure.
//
// std/protowkt on the native backends (decision 0546): the well known types,
// read and written by hand with std/native/protodesc's wire helpers.

use std/protobuf
use std/protowire as pw

pub struct Timestamp {
  pub seconds proto "1": Int = 0
  pub nanos proto "2": Int32 = 0
} derive Eq, Proto

pub struct Duration {
  pub seconds proto "1": Int = 0
  pub nanos proto "2": Int32 = 0
} derive Eq, Proto

pub struct Empty {
  /// The fields a reader did not know, written back as protobuf-go does.
  pub unknown proto "unknown": Bytes = b""
} derive Eq, Proto

pub struct FieldMask {
  pub paths proto "1": List[Str] = []
} derive Eq, Proto

/// google.protobuf.Any: `type_url` names the packed message (`type.googleapis.com/pkg.Msg`), `value` is
/// its wire bytes.
pub struct Any {
  pub type_url proto "1": Str = ""
  pub value proto "2": Bytes = b""
} derive Eq, Proto

pub struct DoubleValue { pub value proto "1": Float = 0.0 } derive Proto

pub struct FloatValue { pub value proto "1": Float32 = 0.0 } derive Proto

pub struct Int64Value { pub value proto "1": Int = 0 } derive Eq, Proto

pub struct UInt64Value { pub value proto "1": UInt64 = 0 } derive Eq, Proto

pub struct Int32Value { pub value proto "1": Int32 = 0 } derive Eq, Proto

pub struct UInt32Value { pub value proto "1": UInt32 = 0 } derive Eq, Proto

pub struct BoolValue { pub value proto "1": Bool = false } derive Eq, Proto

pub struct StringValue { pub value proto "1": Str = "" } derive Eq, Proto

pub struct BytesValue { pub value proto "1": Bytes = b"" } derive Eq, Proto

/// google.protobuf.Value: the kind that is set, `Unset` when none is.
pub enum Value {
  Unset
  Null
  Number(v: Float)
  Text(v: Str)
  Flag(v: Bool)
  Object(v: Struct)
  Array(v: ListValue)
}

pub struct Struct {
  pub fields: Map[Str, Value] = {}
}

pub struct ListValue {
  pub values: List[Value] = []
}

pub fn encode_timestamp(m: Timestamp) -> Bytes { protobuf.marshal(m) }

pub fn decode_timestamp(b: Bytes) -> Timestamp ! protobuf.ProtoErr { protobuf.unmarshal[Timestamp](b) }

pub fn encode_duration(m: Duration) -> Bytes { protobuf.marshal(m) }

pub fn decode_duration(b: Bytes) -> Duration ! protobuf.ProtoErr { protobuf.unmarshal[Duration](b) }

pub fn encode_empty(m: Empty) -> Bytes { protobuf.marshal(m) }

pub fn decode_empty(b: Bytes) -> Empty ! protobuf.ProtoErr { protobuf.unmarshal[Empty](b) }

pub fn encode_field_mask(m: FieldMask) -> Bytes { protobuf.marshal(m) }

pub fn decode_field_mask(b: Bytes) -> FieldMask ! protobuf.ProtoErr { protobuf.unmarshal[FieldMask](b) }

pub fn encode_any(m: Any) -> Bytes { protobuf.marshal(m) }

pub fn decode_any(b: Bytes) -> Any ! protobuf.ProtoErr { protobuf.unmarshal[Any](b) }

pub fn encode_double_value(m: DoubleValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_double_value(b: Bytes) -> DoubleValue ! protobuf.ProtoErr { protobuf.unmarshal[DoubleValue](b) }

pub fn encode_float_value(m: FloatValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_float_value(b: Bytes) -> FloatValue ! protobuf.ProtoErr { protobuf.unmarshal[FloatValue](b) }

pub fn encode_int64_value(m: Int64Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_int64_value(b: Bytes) -> Int64Value ! protobuf.ProtoErr { protobuf.unmarshal[Int64Value](b) }

pub fn encode_uint64_value(m: UInt64Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_uint64_value(b: Bytes) -> UInt64Value ! protobuf.ProtoErr { protobuf.unmarshal[UInt64Value](b) }

pub fn encode_int32_value(m: Int32Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_int32_value(b: Bytes) -> Int32Value ! protobuf.ProtoErr { protobuf.unmarshal[Int32Value](b) }

pub fn encode_uint32_value(m: UInt32Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_uint32_value(b: Bytes) -> UInt32Value ! protobuf.ProtoErr { protobuf.unmarshal[UInt32Value](b) }

pub fn encode_bool_value(m: BoolValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_bool_value(b: Bytes) -> BoolValue ! protobuf.ProtoErr { protobuf.unmarshal[BoolValue](b) }

pub fn encode_string_value(m: StringValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_string_value(b: Bytes) -> StringValue ! protobuf.ProtoErr { protobuf.unmarshal[StringValue](b) }

pub fn encode_bytes_value(m: BytesValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_bytes_value(b: Bytes) -> BytesValue ! protobuf.ProtoErr { protobuf.unmarshal[BytesValue](b) }

/// A Struct's entries are written in key order (protobuf-go's Deterministic marshaling).
pub fn encode_value(m: Value) -> Bytes {
  var o = BytesBuilder.new()
  match m {
    Unset => {}
    Null => pw.wia(o, 1, 0)
    Number(v) => wfix64(o, 2, v.to_bits())
    Text(v) => pw.wsa(o, 3, v)
    Flag(v) => pw.wia(o, 4, if v { 1 } else { 0 })
    Object(v) => pw.wm(o, 5, encode_struct(v))
    Array(v) => pw.wm(o, 6, encode_list_value(v))
  }
  o.freeze()
}

pub fn decode_value(b: Bytes) -> Value ! protobuf.ProtoErr {
  var m = Value.Unset
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_v(f) {
      m = Value.Null
    } else if f.num == 2 && f.wire == 1 {
      m = Value.Number(Float.from_bits(f.v))
    } else if f.num == 3 && pw.is_s(f) {
      m = Value.Text(pw.text(f)?)
    } else if f.num == 4 && pw.is_v(f) {
      m = Value.Flag(f.v != 0)
    } else if f.num == 5 && pw.is_s(f) {
      m = Value.Object(decode_struct(f.data)?)
    } else if f.num == 6 && pw.is_s(f) {
      m = Value.Array(decode_list_value(f.data)?)
    }
  }
  Ok(m)
}

pub fn encode_struct(m: Struct) -> Bytes {
  var o = BytesBuilder.new()
  let keys = m.fields.keys().sort_by(fn(k: Str) -> Str { k })
  for k in keys {
    var e = BytesBuilder.new()
    pw.wsa(e, 1, k)
    pw.wm(e, 2, encode_value(m.fields.get(k) ?? Value.Unset))
    pw.wm(o, 1, e.freeze())
  }
  o.freeze()
}

pub fn decode_struct(b: Bytes) -> Struct ! protobuf.ProtoErr {
  var m = Struct{fields: {}}
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      var key = ""
      var val = Value.Unset
      for g in pw.walk(f.data)? {
        if g.num == 1 && pw.is_s(g) {
          key = pw.text(g)?
        } else if g.num == 2 && pw.is_s(g) {
          val = decode_value(g.data)?
        }
      }
      m.fields.put(key, val)
    }
  }
  Ok(m)
}

pub fn encode_list_value(m: ListValue) -> Bytes {
  var o = BytesBuilder.new()
  for v in m.values {
    pw.wm(o, 1, encode_value(v))
  }
  o.freeze()
}

pub fn decode_list_value(b: Bytes) -> ListValue ! protobuf.ProtoErr {
  var m = ListValue{values: []}
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      m.values.push(decode_value(f.data)?)
    }
  }
  Ok(m)
}

fn wfix64(var o: BytesBuilder, num: Int, v: Int) {
  pw.wtag(o, num, 1)
  for i in 0..8 {
    o.write_byte(UInt8.wrapping_from(v.shr_logical(8 * i) & 255))
  }
}
