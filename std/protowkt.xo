// std/protowkt (decision 0546, item 2). Encoding rules are
// listed at the top of std/prelude.xo. The well known types of protobuf's
// google/protobuf/*.proto as Xo values: Timestamp, Duration, Empty,
// FieldMask, Any and the nine wrappers derive Proto (decision 0549, their
// field types protobuf-go's: nanos and the 32 bit wrappers Int32 and
// UInt32), and Struct, Value and ListValue, whose Value is a oneof enum
// that holds them recursively, keep codecs written by hand. `encode_*` writes fields in field number order with
// proto3 implicit presence (a zero value is not written; a Value's member and
// a Struct's map entries are); `decode_*` keeps the last value of a field,
// skips unknown fields, and is the wire reader's errors. Pure.
//
// std/protowkt on the native backends (decision 0546): the well known types,
// read and written by hand with std/native/protodesc's wire helpers.

use std/protobuf
use std/protodesc
use std/protowire as pw
use std/json

pub struct Timestamp {
  pub seconds proto "1": Int = 0
  pub nanos proto "2": Int32 = 0
} derive Eq, Proto

pub struct Duration {
  pub seconds proto "1": Int = 0
  pub nanos proto "2": Int32 = 0
} derive Eq, Proto

pub struct Empty {
  /// The fields a reader did not know, written back as protobuf-go does.
  pub unknown proto "unknown": Bytes = b""
} derive Eq, Proto

pub struct FieldMask {
  pub paths proto "1": List[Str] = []
} derive Eq, Proto

/// google.protobuf.Any: `type_url` names the packed message (`type.googleapis.com/pkg.Msg`), `value` is
/// its wire bytes.
pub struct Any {
  pub type_url proto "1": Str = ""
  pub value proto "2": Bytes = b""
} derive Eq, Proto

pub struct DoubleValue { pub value proto "1": Float = 0.0 } derive Proto

pub struct FloatValue { pub value proto "1": Float32 = 0.0 } derive Proto

pub struct Int64Value { pub value proto "1": Int = 0 } derive Eq, Proto

pub struct UInt64Value { pub value proto "1": UInt64 = 0 } derive Eq, Proto

pub struct Int32Value { pub value proto "1": Int32 = 0 } derive Eq, Proto

pub struct UInt32Value { pub value proto "1": UInt32 = 0 } derive Eq, Proto

pub struct BoolValue { pub value proto "1": Bool = false } derive Eq, Proto

pub struct StringValue { pub value proto "1": Str = "" } derive Eq, Proto

pub struct BytesValue { pub value proto "1": Bytes = b"" } derive Eq, Proto

/// google.protobuf.Value: the kind that is set, `Unset` when none is.
pub enum Value {
  Unset
  Null
  Number(v: Float)
  Text(v: Str)
  Flag(v: Bool)
  Object(v: Struct)
  Array(v: ListValue)
}

pub struct Struct {
  pub fields: Map[Str, Value] = {}
}

pub struct ListValue {
  pub values: List[Value] = []
}

pub fn encode_timestamp(m: Timestamp) -> Bytes { protobuf.marshal(m) }

pub fn decode_timestamp(b: Bytes) -> Timestamp ! protobuf.ProtoErr { protobuf.unmarshal[Timestamp](b) }

pub fn encode_duration(m: Duration) -> Bytes { protobuf.marshal(m) }

pub fn decode_duration(b: Bytes) -> Duration ! protobuf.ProtoErr { protobuf.unmarshal[Duration](b) }

pub fn encode_empty(m: Empty) -> Bytes { protobuf.marshal(m) }

pub fn decode_empty(b: Bytes) -> Empty ! protobuf.ProtoErr { protobuf.unmarshal[Empty](b) }

pub fn encode_field_mask(m: FieldMask) -> Bytes { protobuf.marshal(m) }

pub fn decode_field_mask(b: Bytes) -> FieldMask ! protobuf.ProtoErr { protobuf.unmarshal[FieldMask](b) }

pub fn encode_any(m: Any) -> Bytes { protobuf.marshal(m) }

pub fn decode_any(b: Bytes) -> Any ! protobuf.ProtoErr { protobuf.unmarshal[Any](b) }

pub fn encode_double_value(m: DoubleValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_double_value(b: Bytes) -> DoubleValue ! protobuf.ProtoErr { protobuf.unmarshal[DoubleValue](b) }

pub fn encode_float_value(m: FloatValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_float_value(b: Bytes) -> FloatValue ! protobuf.ProtoErr { protobuf.unmarshal[FloatValue](b) }

pub fn encode_int64_value(m: Int64Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_int64_value(b: Bytes) -> Int64Value ! protobuf.ProtoErr { protobuf.unmarshal[Int64Value](b) }

pub fn encode_uint64_value(m: UInt64Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_uint64_value(b: Bytes) -> UInt64Value ! protobuf.ProtoErr { protobuf.unmarshal[UInt64Value](b) }

pub fn encode_int32_value(m: Int32Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_int32_value(b: Bytes) -> Int32Value ! protobuf.ProtoErr { protobuf.unmarshal[Int32Value](b) }

pub fn encode_uint32_value(m: UInt32Value) -> Bytes { protobuf.marshal(m) }

pub fn decode_uint32_value(b: Bytes) -> UInt32Value ! protobuf.ProtoErr { protobuf.unmarshal[UInt32Value](b) }

pub fn encode_bool_value(m: BoolValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_bool_value(b: Bytes) -> BoolValue ! protobuf.ProtoErr { protobuf.unmarshal[BoolValue](b) }

pub fn encode_string_value(m: StringValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_string_value(b: Bytes) -> StringValue ! protobuf.ProtoErr { protobuf.unmarshal[StringValue](b) }

pub fn encode_bytes_value(m: BytesValue) -> Bytes { protobuf.marshal(m) }

pub fn decode_bytes_value(b: Bytes) -> BytesValue ! protobuf.ProtoErr { protobuf.unmarshal[BytesValue](b) }

/// A Struct's entries are written in key order (protobuf-go's Deterministic marshaling).
pub fn encode_value(m: Value) -> Bytes {
  var o = BytesBuilder.new()
  match m {
    Unset => {}
    Null => pw.wia(o, 1, 0)
    Number(v) => wfix64(o, 2, v.to_bits())
    Text(v) => pw.wsa(o, 3, v)
    Flag(v) => pw.wia(o, 4, if v { 1 } else { 0 })
    Object(v) => pw.wm(o, 5, encode_struct(v))
    Array(v) => pw.wm(o, 6, encode_list_value(v))
  }
  o.freeze()
}

pub fn decode_value(b: Bytes) -> Value ! protobuf.ProtoErr {
  var m = Value.Unset
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_v(f) {
      m = Value.Null
    } else if f.num == 2 && f.wire == 1 {
      m = Value.Number(Float.from_bits(f.v))
    } else if f.num == 3 && pw.is_s(f) {
      m = Value.Text(pw.text(f)?)
    } else if f.num == 4 && pw.is_v(f) {
      m = Value.Flag(f.v != 0)
    } else if f.num == 5 && pw.is_s(f) {
      m = Value.Object(decode_struct(f.data)?)
    } else if f.num == 6 && pw.is_s(f) {
      m = Value.Array(decode_list_value(f.data)?)
    }
  }
  Ok(m)
}

pub fn encode_struct(m: Struct) -> Bytes {
  var o = BytesBuilder.new()
  let keys = m.fields.keys().sort_by(fn(k: Str) -> Str { k })
  for k in keys {
    var e = BytesBuilder.new()
    pw.wsa(e, 1, k)
    pw.wm(e, 2, encode_value(m.fields.get(k) ?? Value.Unset))
    pw.wm(o, 1, e.freeze())
  }
  o.freeze()
}

pub fn decode_struct(b: Bytes) -> Struct ! protobuf.ProtoErr {
  var m = Struct{fields: {}}
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      var key = ""
      var val = Value.Unset
      for g in pw.walk(f.data)? {
        if g.num == 1 && pw.is_s(g) {
          key = pw.text(g)?
        } else if g.num == 2 && pw.is_s(g) {
          val = decode_value(g.data)?
        }
      }
      m.fields.put(key, val)
    }
  }
  Ok(m)
}

pub fn encode_list_value(m: ListValue) -> Bytes {
  var o = BytesBuilder.new()
  for v in m.values {
    pw.wm(o, 1, encode_value(v))
  }
  o.freeze()
}

pub fn decode_list_value(b: Bytes) -> ListValue ! protobuf.ProtoErr {
  var m = ListValue{values: []}
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      m.values.push(decode_value(f.data)?)
    }
  }
  Ok(m)
}

fn wfix64(var o: BytesBuilder, num: Int, v: Int) {
  pw.wtag(o, num, 1)
  for i in 0..8 {
    o.write_byte(UInt8.wrapping_from(v.shr_logical(8 * i) & 255))
  }
}

// ---------------------------------------------------------------------------
// The helpers of protobuf-go's timestamppb, durationpb, anypb, fieldmaskpb
// and wrapperspb (BSD-3, Copyright 2020 The Go Authors), task #102.

/// Why a well known value is not valid, or an Any did not unpack: displays
/// as protobuf-go's error text (`proto: timestamp (seconds:-62135596801)
/// before 0001-01-01`). A message's text is `field:value` pairs with one
/// space between them, where Go's prototext puts one or two at random.
pub struct WktErr {
  pub msg: Str
}

pub fn (e: WktErr) display() -> Str { "proto: " + e.msg }

fn secs_nanos_text(secs: Int, nanos: Int) -> Str {
  var parts: List[Str] = []
  if secs != 0 {
    parts.push("seconds:${secs}")
  }
  if nanos != 0 {
    parts.push("nanos:${nanos}")
  }
  parts.join(" ")
}

/// timestamppb.New: the seconds and nanoseconds of t since the Unix epoch.
pub fn timestamp_of(t: Time) -> Timestamp {
  Timestamp{seconds: t.unix(), nanos: Int32.wrapping_from(t.nanosecond())}
}

/// timestamppb's AsTime: the instant, None when it is outside Time's range
/// (1677 to 2262; Go's time.Time reaches further). Nanos outside 0..1e9
/// carry into the seconds, as time.Unix does.
pub fn (ts: Timestamp) as_time() -> Time? {
  // time.Unix first carries nanos into the seconds (nanos then in
  // 0..1e9), so seconds just past Int's range with negative nanos still
  // fit
  var n = Int(ts.nanos)
  var secs = ts.seconds.checked_add(n / 1000000000)?
  n = n % 1000000000
  if n < 0 {
    n += 1000000000
    secs = secs.checked_sub(1)?
  }
  // a negative instant with nanos: (secs + 1) seconds less the rest, so
  // Int.min itself is reached
  let ns = if secs < 0 && n > 0 {
    secs.checked_add(1)?.checked_mul(1000000000)?.checked_add(n - 1000000000)?
  } else {
    secs.checked_mul(1000000000)?.checked_add(n)?
  }
  Some(Time.from_unix_nanos(ns))
}

/// timestamppb's IsValid: CheckValid finds nothing wrong.
pub fn (ts: Timestamp) is_valid() -> Bool { ts.check_valid() is Ok(_) }

/// timestamppb's CheckValid: seconds from 0001-01-01 to 9999-12-31 and
/// nanos in 0..1e9.
pub fn (ts: Timestamp) check_valid() -> () ! WktErr {
  let text = secs_nanos_text(ts.seconds, Int(ts.nanos))
  if ts.seconds < -62135596800 {
    return Err(WktErr{msg: "timestamp (${text}) before 0001-01-01"})
  }
  if ts.seconds > 253402300799 {
    return Err(WktErr{msg: "timestamp (${text}) after 9999-12-31"})
  }
  if ts.nanos < 0 || ts.nanos >= 1000000000 {
    return Err(WktErr{msg: "timestamp (${text}) has out-of-range nanos"})
  }
  Ok(())
}

/// durationpb.New of a Duration's nanoseconds (`duration_from_nanos(d.nanos())`;
/// this module's Duration hides the prelude's): whole seconds and the
/// nanoseconds left, both with the sign of ns.
pub fn duration_from_nanos(ns: Int) -> Duration {
  let secs = ns / 1000000000
  Duration{seconds: secs, nanos: Int32.wrapping_from((ns - secs * 1000000000))}
}

/// durationpb's AsDuration as nanoseconds (`Duration.from_nanos(dp.as_nanos())`
/// elsewhere), saturating at Int.min or Int.max when it does not fit (by the
/// seconds' sign).
pub fn (dp: Duration) as_nanos() -> Int {
  let secs = dp.seconds
  let nanos = Int(dp.nanos)
  let total = match secs.checked_mul(1000000000) {
    Some(s) => s.checked_add(nanos)
    None => None
  }
  match total {
    Some(t) => t
    None => if secs < 0 { Int.min } else { Int.max }
  }
}

/// durationpb's IsValid: CheckValid finds nothing wrong.
pub fn (dp: Duration) is_valid() -> Bool { dp.check_valid() is Ok(_) }

/// durationpb's CheckValid: at most 10000 years either way, nanos within a
/// second and with the seconds' sign.
pub fn (dp: Duration) check_valid() -> () ! WktErr {
  let text = secs_nanos_text(dp.seconds, Int(dp.nanos))
  if dp.seconds < -315576000000 {
    return Err(WktErr{msg: "duration (${text}) exceeds -10000 years"})
  }
  if dp.seconds > 315576000000 {
    return Err(WktErr{msg: "duration (${text}) exceeds +10000 years"})
  }
  if dp.nanos <= -1000000000 || dp.nanos >= 1000000000 {
    return Err(WktErr{msg: "duration (${text}) has out-of-range nanos"})
  }
  if (dp.seconds > 0 && dp.nanos < 0) || (dp.seconds < 0 && dp.nanos > 0) {
    return Err(WktErr{msg: "duration (${text}) has seconds and nanos with different signs"})
  }
  Ok(())
}

/// anypb.New and MarshalFrom: a message's wire bytes (`protobuf.marshal(m)`)
/// under the type URL `type.googleapis.com/` + full_name. A derive Proto
/// type has no descriptor, so the caller names it (`pkg.Msg`).
pub fn pack_any(full_name: Str, value: Bytes) -> Any {
  Any{type_url: "type.googleapis.com/" + full_name, value: value}
}

/// anypb's UnmarshalTo, its type check: the packed wire bytes when the Any
/// holds full_name (message_is), for `protobuf.unmarshal[T]`; else Go's
/// `mismatched message type` error.
pub fn (a: Any) unpack(full_name: Str) -> Bytes ! WktErr {
  if !a.message_is(full_name) {
    return Err(WktErr{msg: "mismatched message type: got ${full_name.quote()}, want ${a.message_name().quote()}"})
  }
  Ok(a.value)
}

/// anypb's MessageIs: the type URL is full_name or ends in `/` + full_name.
pub fn (a: Any) message_is(full_name: Str) -> Bool {
  let url = a.type_url
  if !url.ends_with(full_name) {
    return false
  }
  url.len() == full_name.len() || url.bytes()[url.len() - full_name.len() - 1] == 0x2f
}

/// anypb's MessageName: the type URL after its last `/`, "" when that is
/// not a valid full name (dot separated identifiers).
pub fn (a: Any) message_name() -> Str {
  let url = a.type_url
  let name = match url.rfind("/") {
    Some(i) => url[i + 1..]
    None => url
  }
  if valid_full_name(name) { name } else { "" }
}

/// protoreflect's FullName.IsValid.
fn valid_full_name(s: Str) -> Bool {
  let b = s.bytes()
  var i = 0
  var first = true
  while first || i < b.len() {
    if !first {
      if b[i] != 0x2e {
        return false
      }
      i += 1
    }
    first = false
    if i >= b.len() || !ident_start(b[i]) {
      return false
    }
    i += 1
    while i < b.len() && (ident_start(b[i]) || (b[i] >= 0x30 && b[i] <= 0x39)) {
      i += 1
    }
  }
  true
}

fn ident_start(c: UInt8) -> Bool { c == 0x5f || (c >= 0x61 && c <= 0x7a) || (c >= 0x41 && c <= 0x5a) }

/// fieldmaskpb's Normalize: the paths sorted (a `.` before any other byte)
/// without duplicates and without a path under another one.
pub fn (fm: FieldMask) normalize() -> FieldMask { FieldMask{paths: normalize_paths(fm.paths)} }

/// fieldmaskpb.Union: every path of the masks, normalized.
pub fn union_masks(masks: List[FieldMask]) -> FieldMask {
  var out: List[Str] = []
  for m in masks {
    for p in m.paths {
      out.push(p)
    }
  }
  FieldMask{paths: normalize_paths(out)}
}

/// fieldmaskpb.Intersect: the paths every mask covers, normalized.
pub fn intersect_masks(masks: List[FieldMask]) -> FieldMask {
  var out = union_masks(masks).paths
  for m in masks {
    let ss1 = normalize_paths(m.paths)
    let ss2 = normalize_paths(out)
    var next: List[Str] = []
    var i1 = 0
    var i2 = 0
    while i1 < ss1.len() && i2 < ss2.len() {
      let s1 = ss1[i1]
      let s2 = ss2[i2]
      if has_path_prefix(s1, s2) {
        next.push(s1)
        i1 += 1
      } else if has_path_prefix(s2, s1) {
        next.push(s2)
        i2 += 1
      } else if less_path(s1, s2) {
        i1 += 1
      } else {
        i2 += 1
      }
    }
    out = next
  }
  FieldMask{paths: normalize_paths(out)}
}

fn normalize_paths(paths: List[Str]) -> List[Str] {
  let sorted = paths.sort_with(fn(x: Str, y: Str) -> Ordering {
    if less_path(x, y) { Ordering.Less } else if less_path(y, x) { Ordering.Greater } else { Ordering.Equal }
  })
  var out: List[Str] = []
  for p in sorted {
    if out.len() > 0 && has_path_prefix(p, out[out.len() - 1]) {
      continue
    }
    out.push(p)
  }
  out
}

fn has_path_prefix(path: Str, prefix: Str) -> Bool {
  path.starts_with(prefix) && (path.len() == prefix.len() || path.bytes()[prefix.len()] == 0x2e)
}

/// Go's lessPath: bytes compared after subtracting `.` (mod 256), so `.`
/// sorts first; a prefix sorts before the longer path.
fn less_path(x: Str, y: Str) -> Bool {
  let a = x.bytes()
  let b = y.bytes()
  var i = 0
  while i < a.len() && i < b.len() {
    if a[i] != b[i] {
      return (Int(a[i]) - 0x2e + 256) % 256 < (Int(b[i]) - 0x2e + 256) % 256
    }
    i += 1
  }
  a.len() < b.len()
}

/// structpb.NewValue over a JSON value: null, a bool, a number (an Int as
/// its Float, as Go converts integers), text, a list and an object become
/// the Value kinds (an object's later duplicate key wins, as a Go map keeps
/// one); any other json.Value is Go's `invalid type` error.
pub fn value_from_json(v: json.Value) -> Value ! WktErr {
  match v {
    json.Value.Null => Ok(Value.Null)
    json.Value.Bool(b: b) => Ok(Value.Flag(b))
    json.Value.Int(n: n) => Ok(Value.Number(Float(n)))
    json.Value.Num(n: n) => Ok(Value.Number(n))
    json.Value.Str(s: s) => Ok(Value.Text(s))
    json.Value.List(items: items) => Ok(Value.Array(list_from_json(items)?))
    json.Value.Object(fields: _) => Ok(Value.Object(struct_from_json(v)?))
    _ => Err(WktErr{msg: "invalid type: ${v.encode()}"})
  }
}

/// structpb.NewStruct: an object's fields as a Struct; Go's `invalid type`
/// error for a value that is not an object or holds an unsupported one.
pub fn struct_from_json(v: json.Value) -> Struct ! WktErr {
  let fields = match v {
    json.Value.Object(fields: fs) => fs
    _ => return Err(WktErr{msg: "invalid type: ${v.encode()}"})
  }
  var m: Map[Str, Value] = {}
  for (k, x) in fields {
    m.put(k, value_from_json(x)?)
  }
  Ok(Struct{fields: m})
}

/// structpb.NewList: the items as a ListValue.
pub fn list_from_json(items: List[json.Value]) -> ListValue ! WktErr {
  var out: List[Value] = []
  for x in items {
    out.push(value_from_json(x)?)
  }
  Ok(ListValue{values: out})
}

/// structpb's AsInterface as a JSON value: a number is a Num (Go's float64),
/// NaN and the infinities the strings "NaN", "Infinity" and "-Infinity" (as
/// AsInterface gives them), an object's fields sorted by key, an unset
/// Value null (Go's nil).
pub fn (v: Value) to_json() -> json.Value {
  match v {
    Unset | Null => json.Value.Null
    Number(v: n) => if n.is_nan() {
      json.Value.Str("NaN")
    } else if n.is_inf() {
      json.Value.Str(if n > 0.0 { "Infinity" } else { "-Infinity" })
    } else {
      json.Value.Num(n)
    }
    Text(v: s) => json.Value.Str(s)
    Flag(v: b) => json.Value.Bool(b)
    Object(v: st) => st.to_json()
    Array(v: lv) => lv.to_json()
  }
}

/// structpb's AsMap as a JSON object, fields sorted by key.
pub fn (st: Struct) to_json() -> json.Value {
  var keys: List[Str] = []
  for (k, _) in st.fields {
    keys.push(k)
  }
  keys.sort_in_place()
  var fs: List[(Str, json.Value)] = []
  for k in keys {
    fs.push((k, (st.fields.get(k) ?? Value.Unset).to_json()))
  }
  json.Value.Object(fs)
}

/// structpb's AsSlice as a JSON list.
pub fn (lv: ListValue) to_json() -> json.Value {
  json.Value.List(lv.values.map(fn(x: Value) -> json.Value { x.to_json() }))
}

/// fieldmaskpb.New: a mask of `paths`, each checked against message `name`
/// (`pkg.Msg`) of `files` (std/protodesc, with every file the message's
/// fields need). A path is field names joined by `.`, each a field of the
/// message the one before it holds; a repeated or map field may only come
/// last, and a group is named by its message's name. The first path that
/// is not is the error (`proto: invalid path "x" for message "pkg.Msg"`),
/// where Go's New also returns the paths before it.
pub fn new_mask(files: List[protodesc.FileDesc], name: Str, paths: List[Str]) -> FieldMask ! WktErr {
  var fm = FieldMask{}
  fm.append(files, name, paths)?
  Ok(fm)
}

/// fieldmaskpb's Append: adds `paths` up to the first one that is not a
/// path of message `name` (as `new_mask`), which is the error.
pub fn (var fm: FieldMask) append(files: List[protodesc.FileDesc], name: Str, paths: List[Str]) -> () ! WktErr {
  let msgs = mask_messages(files)
  let n = valid_paths(msgs, name, paths)
  var i = 0
  while i < n {
    fm.paths.push(paths[i])
    i += 1
  }
  if n < paths.len() {
    return Err(WktErr{msg: "invalid path ${paths[n].quote()} for message ${name.quote()}"})
  }
  Ok(())
}

/// fieldmaskpb's IsValid: every path is a path of message `name` of `files`
/// (as `new_mask`).
pub fn (fm: FieldMask) is_valid(files: List[protodesc.FileDesc], name: Str) -> Bool {
  valid_paths(mask_messages(files), name, fm.paths) == fm.paths.len()
}

/// fieldmaskpb.New for a derive Proto message, from its descriptor
/// (`protowkt.new_field_mask(protobuf.descriptor[T](), paths)`, decision
/// 0683): `paths` as `new_mask` checks them, the error naming the message's
/// full name.
pub fn new_field_mask(md: protobuf.MessageDesc, paths: List[Str]) -> FieldMask ! WktErr {
  var fm = FieldMask{}
  fm.append_paths(md, paths)?
  Ok(fm)
}

/// fieldmaskpb's Append for a derive Proto message's descriptor
/// (`protobuf.descriptor[T]()`): adds `paths` up to the first one that is
/// not a path of the message (as `new_field_mask`), which is the error.
/// (`append` takes a message of std/protodesc files.)
pub fn (var fm: FieldMask) append_paths(md: protobuf.MessageDesc, paths: List[Str]) -> () ! WktErr {
  let n = desc_valid_paths(md, paths)
  var i = 0
  while i < n {
    fm.paths.push(paths[i])
    i += 1
  }
  if n < paths.len() {
    return Err(WktErr{msg: "invalid path ${paths[n].quote()} for message ${md.full_name.quote()}"})
  }
  Ok(())
}

/// fieldmaskpb's IsValid for a derive Proto message's descriptor
/// (`protobuf.descriptor[T]()`): every path is a path of the message (as
/// `new_field_mask`).
pub fn (fm: FieldMask) is_valid_for(md: protobuf.MessageDesc) -> Bool {
  desc_valid_paths(md, fm.paths) == fm.paths.len()
}

/// numValidPaths over a derive Proto descriptor: how many of paths, from
/// the first, are paths of md. A field is found by its .proto name; a
/// repeated or map field, or one that holds no message, ends a path.
fn desc_valid_paths(md: protobuf.MessageDesc, paths: List[Str]) -> Int {
  var i = 0
  while i < paths.len() {
    var cur: protobuf.MessageDesc? = Some(md)
    for field in paths[i].split(".") {
      let m = match cur {
        Some(m) => m
        None => return i
      }
      var found: protobuf.FieldDesc? = None
      for fd in m.fields {
        if fd.name == field {
          found = Some(fd)
          break
        }
      }
      let fd = match found {
        Some(fd) => fd
        None => return i
      }
      cur = if fd.cardinality != protobuf.Cardinality.Optional {
        None
      } else {
        match fd.message {
          Some(f) => Some(f())
          None => None
        }
      }
    }
    i += 1
  }
  paths.len()
}

/// The messages of files by full name (`pkg.Outer.Inner`).
fn mask_messages(files: List[protodesc.FileDesc]) -> Map[Str, protodesc.MessageDesc] {
  var out: Map[Str, protodesc.MessageDesc] = {}
  for f in files {
    let prefix = if f.package.is_empty() { "" } else { f.package + "." }
    for m in f.message_type {
      add_mask_message(out, prefix, m)
    }
  }
  out
}

fn add_mask_message(var out: Map[Str, protodesc.MessageDesc], prefix: Str, m: protodesc.MessageDesc) {
  let full = prefix + m.name
  out[full] = m
  for n in m.nested_type {
    add_mask_message(out, full + ".", n)
  }
}

/// numValidPaths: how many of paths, from the first, are paths of message name.
fn valid_paths(msgs: Map[Str, protodesc.MessageDesc], name: Str, paths: List[Str]) -> Int {
  var i = 0
  while i < paths.len() {
    var md = msgs.get(name)
    for field in paths[i].split(".") {
      let m = match md {
        Some(m) => m
        None => return i
      }
      let fd = match mask_field(msgs, m, field) {
        Some(fd) => fd
        None => return i
      }
      // the next message to search in; a repeated (or map) field only last
      md = if fd.label == protodesc.LABEL_REPEATED || (fd.kind != protodesc.TYPE_MESSAGE && fd.kind != protodesc.TYPE_GROUP) {
        None
      } else {
        msgs.get(fd.type_name.trim_prefix("."))
      }
    }
    i += 1
  }
  paths.len()
}

/// The field of m that a path segment names: a field by its name, except a
/// group, whose segment is its message's name (the field's name lowercased).
fn mask_field(msgs: Map[Str, protodesc.MessageDesc], m: protodesc.MessageDesc, seg: Str) -> protodesc.FieldDesc? {
  for fd in m.field {
    if fd.name == seg {
      if fd.kind == protodesc.TYPE_GROUP && group_name(msgs, fd) != seg {
        return None
      }
      return Some(fd)
    }
  }
  let lower = seg.to_lower()
  for fd in m.field {
    if fd.name == lower && fd.kind == protodesc.TYPE_GROUP && group_name(msgs, fd) == seg {
      return Some(fd)
    }
  }
  None
}

fn group_name(msgs: Map[Str, protodesc.MessageDesc], fd: protodesc.FieldDesc) -> Str {
  match msgs.get(fd.type_name.trim_prefix(".")) {
    Some(g) => g.name
    None => ""
  }
}
