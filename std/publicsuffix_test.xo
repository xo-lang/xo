test "public_suffix: Go's publicSuffixTestCases" {
  var bad: List[Str] = []
  for (d, want, icann) in PS_CASES {
    let (got, gi) = public_suffix(d)
    if got != want || gi != icann {
      bad.push("${d}: got (${got}, ${gi}), want (${want}, ${icann})")
    }
  }
  expect(bad.join("\n")) == ""
}

test "effective_tld_plus_one: Go's eTLDPlusOneTestCases" {
  var bad: List[Str] = []
  for (d, want) in ETLD1_CASES {
    let got = match effective_tld_plus_one(d) {
      Ok(s) => s
      Err(_) => ""
    }
    if got != want {
      bad.push("${d}: got ${got}, want ${want}")
    }
  }
  expect(bad.join("\n")) == ""
}

test "the errors' texts are Go's" {
  expect(effective_tld_plus_one(".com").err()?.msg) == "publicsuffix: empty label in domain \".com\""
  expect(effective_tld_plus_one("co.uk").err()?.msg) == "publicsuffix: cannot derive eTLD+1 for domain \"co.uk\""
}
