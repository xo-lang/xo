fn unhex(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

test "go digests and hmacs" {
  for (h, msg, want, key, mac) in CASES {
    let m = unhex(msg)
    expect(digest(h, m).to_hex()) == want
    expect(hmac(h, unhex(key), m).to_hex()) == mac
    expect(hash_size(h)) == want.len() / 2
  }
}

test "hashers in pieces match the one shot results" {
  for (h, msg, want, key, mac) in CASES {
    let m = unhex(msg)
    let cut = m.len() / 3
    var x = hasher(h)
    var y = hmac_hasher(h, unhex(key))
    x.write(m[0..cut])
    y.write(m[0..cut])
    let early = x.sum()
    x.write(m[cut..])
    y.write(m[cut..])
    expect(x.sum().to_hex()) == want
    expect(y.sum().to_hex()) == mac
    expect(x.written()) == m.len()
    expect(early) == digest(h, m[0..cut])
  }
}

test "a copied hasher is independent" {
  var a = hasher(crypto.Hash.Sha3_256)
  a.write(b"abc")
  var b = a
  b.write(b"def")
  expect(a.sum()) == digest(crypto.Hash.Sha3_256, b"abc")
  expect(b.sum()) == digest(crypto.Hash.Sha3_256, b"abcdef")
}
