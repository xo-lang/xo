test "go encoding/pem: Decode and EncodeToMemory" {
  for (input, want) in PEM {
    let got = pem_decode(input).map(fn(b) {
      let hs = b.headers.keys().sort().map(fn(k) { "${k}=${b.headers.get(k) ?? ""}" }).join("\n")
      let enc = match pem_encode(b) {
        Ok(s) => s
        Err(_) => "error"
      }
      (b.kind, hs, b.bytes.to_hex(), enc)
    })
    expect((input, got)) == (input, want)
  }
  expect(pem_encode(crypto.PemBlock{kind: "X", headers: {"a:b": "c"}, bytes: b""}).map_err(fn(e) { e.msg })) == Err("pem: cannot encode a header key that contains a colon")
}

