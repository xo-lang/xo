  ("304e30ab06072a8648ce3d020106052b81040021033a0004b1311e107d11b562a86e88f2364b589b35d1aec3e7939e9d7e3e453773dd2a87332a019ecc77f154ca898e2564ba7e976fc870d2d1b8eebf", Err("x509: malformed public key")),
  ("", Ok(("Rsa", ""))),
  ("302a300506032b6570032100127bf910f4500ece9d3d5f19a77136e1481d8cb1e08a7f332c43a9bfd328448e", Ok(("Ed25519", "302a300506032b6570032100127bf910f4500ece9d3d5f19a77136e1481d8cb1e08a7f332c43a9bfd328448e"))),
  ("3059301306072a8648ce3d020106082a6e48ce3d03010703420004e97828398f41e08d454cb0fa11fe491293782d6cffb74092b16c62424115c1b7effab60225e743456a6786d4f5f4aad132a35dad9e22ef45d9537ae385bd3a9c", Err("x509: unsupported elliptic curve")),
]

test "go x509: public keys parsed and marshaled" {
  var bad: List[Str] = []
  for (der, want) in PUBKEYS {
    let got = parse_public_key(Bytes.from_hex(der) ?? b"").map(fn(k) { ("${k.alg().debug()}", marshal_public_key(k).to_hex()) }).map_err(fn(e) { e.msg })
    if got != want {
      bad.push("${der}: got ${got.map(fn(x) { x.0 }).debug()} want ${want.map(fn(x) { x.0 }).debug()}")
    }
  }
  expect(bad) == []
}
