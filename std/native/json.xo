// std/json on the native backends (decision 0074): the codecs are
// generated per type by internal/ssa (build_json.go) and called through
// the intrinsics of native/rtjson; the parser and the tape readers they
// call are native/llrt/jsontext (decision 0193 step 4); std/rt/json.go is
// the reference.
use std/json
use native/llrt/jsontext
use native/rtjson

fn encode[T: Json](v: T) -> Bytes { rtjson.json_enc("", v).bytes() }

fn encode_str[T: Json](v: T) -> Str { rtjson.json_enc("", v) }

fn decode[T: Json](data: Bytes) -> T ! json.DecodeErr {
  let tape = jsontext.parse(data)
  if tape.is_empty() {
    return Err(syntax_failed(data))
  }
  match rtjson.json_dec[T](data, tape, 0) {
    Ok(v) => Ok(v)
    Err(e) => Err(json.DecodeErr{path: "$" + e.path, msg: e.msg})
  }
}

fn decode_str[T: Json](s: Str) -> T ! json.DecodeErr { decode(s.bytes()) }

fn decode_go[T: Json](data: Bytes) -> T ! json.DecodeErr {
  let tape = jsontext.parse(data)
  if tape.is_empty() {
    return Err(syntax_failed(data))
  }
  match rtjson.json_dec_go[T](data, tape, 0) {
    Ok(v) => Ok(v)
    Err(e) => Err(go_final(json.DecodeErr{path: "$" + e.path, msg: e.msg}))
  }
}

fn decode_go_str[T: Json](s: Str) -> T ! json.DecodeErr { decode_go(s.bytes()) }

/// A decode_go error as encoding/json words it (decision 0553): the
/// decoder's marker "@@go|STRUCT|KIND|LITERAL|TYPE" at path becomes
/// `json: cannot unmarshal KIND into Go struct field STRUCT.PATH of type TYPE`
/// (`Go value of type TYPE` outside a struct; the PATH has no list indices).
fn go_final(e: json.DecodeErr) -> json.DecodeErr {
  if !e.msg.starts_with("@@go|") {
    return e
  }
  let parts = e.msg[5..].split("|")
  if parts.len() < 4 {
    return e
  }
  let sname = parts[0]
  let lit = if parts[2] == "" { "" } else { " " + parts[2] }
  var ty = parts[3]
  var k = 4
  while k < parts.len() {
    ty = ty + "|" + parts[k]
    k += 1
  }
  // the path's bytes outside `[...]`, a byte at a time into a builder:
  // slicing the Str a byte at a time faulted inside a key's UTF-8
  // sequence (`{"é": "x"}`, the 0616 json review's F1)
  var fb = BytesBuilder.new()
  var in_idx = false
  let pb = e.path.bytes()
  var j = 1
  while j < pb.len() {
    if pb[j] == 91 {
      in_idx = true
    } else if pb[j] == 93 {
      in_idx = false
    } else if !in_idx && !(fb.len() == 0 && pb[j] == 46) {
      fb.write_byte(pb[j])
    }
    j += 1
  }
  let field = fb.freeze().to_str_lossy()
  let head = "json: cannot unmarshal ${parts[1]}${lit}"
  if sname == "" {
    return json.DecodeErr{path: e.path, msg: "${head} into Go value of type ${ty}"}
  }
  json.DecodeErr{path: e.path, msg: "${head} into Go struct field ${sname}.${field} of type ${ty}"}
}

/// "at $.user.email: expected string" (std.md 5).
fn decodeerr_display(e: json.DecodeErr) -> Str { "at ${e.path}: ${e.msg}" }

/// encoding/json's text of a syntax error (decision 0553): msg without
/// "invalid JSON: ", the end of a text as "unexpected end of JSON input".
fn decodeerr_go_text(e: json.DecodeErr) -> Str {
  if e.msg.starts_with("invalid JSON: ") {
    let m = e.msg[14..]
    return if m == "EOF" || m == "unexpected EOF" { "unexpected end of JSON input" } else { m }
  }
  e.msg
}

/// The DecodeErr of a text that is not JSON.
fn syntax_failed(src: Bytes) -> json.DecodeErr {
  json.DecodeErr{path: "$", msg: "invalid JSON: ${jsontext.parse_err(src)}"}
}

fn patch_apply_to[T](p: json.Patch[T], current: T) -> T {
  match p {
    Value(v) => v
    _ => current
  }
}

fn patch_apply_opt[T](p: json.Patch[T], current: T?) -> T? {
  match p {
    Absent => current
    Null => None
    Value(v) => Some(v)
  }
}

// ---------------------------------------------------------------------------
// Value (decision 0299): built from jsontext's tape, as decode reads it

/// None when a number is out of Float's range (strconv.ParseFloat's
/// range error, which decode reports as "cannot unmarshal number N into
/// Float"); bad_path names it.
fn value_at(src: Bytes, tape: List[Int], i: Int) -> json.Value? {
  let k = tape[i]
  if k == 0 {
    return Some(json.Value.Null)
  }
  if k == 1 || k == 2 {
    return Some(json.Value.Bool(b: k == 2))
  }
  if k == 3 {
    // the text "-0" is a Num: an Int has no sign of zero, as Go's float64 keeps it
    let neg_zero = tape[i + 2] == 2 && src[tape[i + 1]] == 45 && src[tape[i + 1] + 1] == 48
    if !neg_zero && jsontext.int_ok(src, tape, i) {
      return Some(json.Value.Int(n: jsontext.int_at(src, tape, i)))
    }
    let f = jsontext.float_opt(src, tape, i) ?? return None
    return Some(json.Value.Num(n: f))
  }
  if k == 4 {
    return Some(json.Value.Str(s: jsontext.str_at(src, tape, i)))
  }
  if k == 5 {
    var items: List[json.Value] = []
    var j = i + 3
    while j < tape[i + 2] {
      items.push(value_at(src, tape, j) ?? return None)
      j = jsontext.next(tape, j)
    }
    return Some(json.Value.List(items: items))
  }
  let ms = jsontext.members(src, tape, i)
  // a duplicate key's earlier values are dropped, but Go's decode still
  // fails on a number out of range in one (found by the json fuzz,
  // internal/stdtest/jsonfuzz_test.go, 2026-11-02)
  if ms.len() < 2 * tape[i + 1] && bad_path(src, tape, i) != None {
    return None
  }
  var fields: List[(Str, json.Value)] = []
  var m = 0
  while m + 1 < ms.len() {
    fields.push((jsontext.str_at(src, tape, ms[m]), value_at(src, tape, ms[m + 1]) ?? return None))
    m += 2
  }
  Some(json.Value.Object(fields: fields))
}

/// The decode path (".key", "[2]") of the first number at or under node i
/// that is out of Float's range, with that number's node, or None. An
/// object's members are walked as written, a duplicate key's earlier
/// values too, as Go's decode reads them.
fn bad_path(src: Bytes, tape: List[Int], i: Int) -> (Str, Int)? {
  let k = tape[i]
  if k == 3 {
    if !jsontext.int_ok(src, tape, i) && jsontext.float_opt(src, tape, i) == None {
      return Some(("", i))
    }
    return None
  }
  if k == 5 {
    var j = i + 3
    var n = 0
    while j < tape[i + 2] {
      if let Some((p, at)) = bad_path(src, tape, j) {
        return Some(("[${n}]" + p, at))
      }
      j = jsontext.next(tape, j)
      n += 1
    }
    return None
  }
  if k == 6 {
    // members as written: key node j, its value at j + 3
    var j = i + 3
    var m = 0
    while m < tape[i + 1] {
      if let Some((p, at)) = bad_path(src, tape, j + 3) {
        return Some(("." + jsontext.str_at(src, tape, j) + p, at))
      }
      j = jsontext.next(tape, j + 3)
      m += 1
    }
  }
  None
}

fn parse_value(text: Str) -> json.Value ! json.DecodeErr { parse_bytes(text.bytes()) }

/// parse_value of bytes that may hold invalid UTF-8 (decoded as decode
/// decodes it, Go's U+FFFD)
fn parse_bytes(src: Bytes) -> json.Value ! json.DecodeErr {
  let tape = jsontext.parse(src)
  if tape.is_empty() {
    return Err(syntax_failed(src))
  }
  match value_at(src, tape, 0) {
    Some(v) => Ok(v)
    None => {
      // Go's wording (encoding/json's UnmarshalTypeError), Xo's type
      let (p, at) = bad_path(src, tape, 0) ?? ("", 0)
      Err(json.DecodeErr{path: "$" + p, msg: jsontext.range_msg(src, tape, at, "Float")})
    }
  }
}

// to_value builds the Value with no text (a codec generated per type,
// compiler/ssa json_val): parse_value(encode_str(v)) gave the same Value
// through the text, 55% of toml.encode's time in its parse (2026-11-04).
// The helpers below give what that parse read from the encoder's text.
fn to_value[T: Json](v: T) -> json.Value { rtjson.json_val(v) }

/// The Value of a Float field: null for NaN and the infinities (the
/// encoder's text), an Int for a whole number above Int's minimum and
/// below 2^63 (its text has no point; the text of -2^63 reads back as a
/// Num, the parse's own bound; -0 is a Num, written "-0"), else the Num (the shortest text reads
/// back exactly).
fn val_float(f: Float) -> json.Value {
  let d = f - f
  if d != d {
    return json.Value.Null
  }
  // -0 stays a Num: an Int has no sign of zero, and the encoder writes "-0"
  if f.trunc() == f && f > -9223372036854775808.0 && f < 9223372036854775808.0 && !(f == 0.0 && f.to_bits() != 0) {
    return json.Value.Int(n: Int(f))
  }
  json.Value.Num(n: f)
}

/// The Value of a UInt64 field's word n: an Int up to Int's maximum, above
/// it the Num its unsigned text reads as (the half with the low bit kept
/// as a sticky bit rounds as the whole value does, then doubles exactly).
fn val_u64(n: Int) -> json.Value {
  if n >= 0 {
    return json.Value.Int(n: n)
  }
  let half = ((n >> 1) & 9223372036854775807) | (n & 1)
  json.Value.Num(n: Float(half) * 2.0)
}

/// The Value of a Bytes, Duration or Time field: the Str of the encoder's
/// text (base64, Go's duration and RFC 3339 forms), read back as parse
/// reads it.
fn val_bytes(v: Bytes) -> json.Value { parse_value(encode_str(v)).ok() ?? json.Value.Null }
fn val_duration(v: Duration) -> json.Value { parse_value(encode_str(v)).ok() ?? json.Value.Null }
fn val_time(v: Time) -> json.Value { parse_value(encode_str(v)).ok() ?? json.Value.Null }

/// The Value of a json.Value field: its text read back (a Trusted becomes
/// its Str, a whole Num an Int).
fn val_value(v: json.Value) -> json.Value { parse_value(value_encode(v)).ok() ?? json.Value.Null }

fn value_append(out: Str, v: json.Value) -> Str {
  match v {
    Null => out + "null"
    Bool(b) => out + (if b { "true" } else { "false" })
    Int(n) => out + "${n}"
    Num(n) => jsontext.append_float(out, n)
    Str(s) => jsontext.append_str(out, s)
    List(items) => {
      var o = out + "["
      for (k, x) in items.indexed() {
        if k > 0 {
          o = o + ","
        }
        o = value_append(o, x)
      }
      o + "]"
    }
    // trusted template content (decision 0408): the string, as any reader
    // but a template sees it
    Trusted(_, s) => jsontext.append_str(out, s)
    Object(fields) => {
      var o = out + "{"
      for (k, f) in fields.indexed() {
        if k > 0 {
          o = o + ","
        }
        o = value_append(jsontext.append_str(o, f.0) + ":", f.1)
      }
      o + "}"
    }
  }
}

fn value_encode(v: json.Value) -> Str { value_append("", v) }

fn encode_indent[T: Json](v: T, prefix: Str, indent: Str) -> Bytes { encode_indent_str(v, prefix, indent).bytes() }

fn encode_indent_str[T: Json](v: T, prefix: Str, indent: Str) -> Str {
  // the encoder's text is valid JSON, so the walk cannot fail
  indent_text(encode_str(v), prefix, indent).ok() ?? ""
}

fn indent(text: Str, prefix: Str, indent: Str) -> Str ! json.DecodeErr { indent_text(text, prefix, indent) }

fn indent_text(text: Str, prefix: Str, indent: Str) -> Str ! json.DecodeErr { walk_text(text, prefix, indent, true) }

fn walk_text(text: Str, prefix: Str, indent: Str, pretty: Bool) -> Str ! json.DecodeErr {
  let src = text.bytes()
  let tape = jsontext.parse(src)
  if tape.is_empty() {
    return Err(syntax_failed(src))
  }
  var out = BytesBuilder.new()
  write_node(src, tape, 0, prefix, indent, 0, pretty, out)
  if pretty {
    // Indent keeps the whitespace after the value (Go's appendIndent copies it); Compact drops it
    var end = src.len()
    while end > 0 && (src[end - 1] == 32 || src[end - 1] == 9 || src[end - 1] == 10 || src[end - 1] == 13) {
      end -= 1
    }
    out.write(src[end..src.len()])
  }
  Ok(out.freeze().to_str() ?? text)
}

fn compact(text: Str) -> Str ! json.DecodeErr { walk_text(text, "", "", false) }

fn html_escape(text: Str) -> Str {
  let b = text.bytes()
  var out = BytesBuilder.new()
  var start = 0
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    var w = 0
    var rep = ""
    if c == 0x3C {
      w = 1
      rep = "\\u003c"
    } else if c == 0x3E {
      w = 1
      rep = "\\u003e"
    } else if c == 0x26 {
      w = 1
      rep = "\\u0026"
    } else if c == 0xE2 && i + 2 < b.len() && Int(b[i + 1]) == 0x80 && (Int(b[i + 2]) == 0xA8 || Int(b[i + 2]) == 0xA9) {
      // U+2028 and U+2029, which end a line in JavaScript
      w = 3
      rep = if Int(b[i + 2]) == 0xA8 { "\\u2028" } else { "\\u2029" }
    }
    if w == 0 {
      i += 1
    } else {
      out.write(b[start..i])
      out.write_str(rep)
      i += w
      start = i
    }
  }
  if start == 0 {
    return text
  }
  out.write(b[start..b.len()])
  out.freeze().to_str() ?? text
}

/// A string node's b holds its raw length under jsontext's flag bits.
const RAW_LEN_MASK: Int = 2305843009213693951

/// Indent's walk over the tape (Go's appendIndent over its scanner's
/// events): scalars are copied from the text as they are; an array or
/// object opens, puts each element on a new line one level deeper, and
/// closes on a line of its own, except an empty one, which stays `[]` or
/// `{}`; a key is followed by `: `; with an empty prefix and indent the
/// output is Compact's.
fn write_node(src: Bytes, tape: List[Int], i: Int, prefix: Str, ind: Str, depth: Int, pretty: Bool, var out: BytesBuilder) {
  let k = tape[i]
  if k == 0 {
    out.write_str("null")
  } else if k == 1 {
    out.write_str("false")
  } else if k == 2 {
    out.write_str("true")
  } else if k == 3 {
    out.write(src[tape[i + 1]..tape[i + 1] + tape[i + 2]])
  } else if k == 4 {
    let n = tape[i + 2] & RAW_LEN_MASK
    out.write_byte(34)
    out.write(src[tape[i + 1]..tape[i + 1] + n])
    out.write_byte(34)
  } else if k == 5 {
    out.write_byte(91)
    var j = i + 3
    var first = true
    while j < tape[i + 2] {
      if !first {
        out.write_byte(44)
      }
      first = false
      newline(prefix, ind, depth + 1, pretty, out)
      write_node(src, tape, j, prefix, ind, depth + 1, pretty, out)
      j = jsontext.next(tape, j)
    }
    if !first {
      newline(prefix, ind, depth, pretty, out)
    }
    out.write_byte(93)
  } else {
    out.write_byte(123)
    var j = i + 3
    var first = true
    while j < tape[i + 2] {
      if !first {
        out.write_byte(44)
      }
      first = false
      newline(prefix, ind, depth + 1, pretty, out)
      // the key as it is spelled
      let n = tape[j + 2] & RAW_LEN_MASK
      out.write_byte(34)
      out.write(src[tape[j + 1]..tape[j + 1] + n])
      out.write_byte(34)
      out.write_byte(58)
      if pretty {
        out.write_byte(32)
      }
      let vj = jsontext.next(tape, j)
      write_node(src, tape, vj, prefix, ind, depth + 1, pretty, out)
      j = jsontext.next(tape, vj)
    }
    if !first {
      newline(prefix, ind, depth, pretty, out)
    }
    out.write_byte(125)
  }
}

fn newline(prefix: Str, ind: Str, depth: Int, pretty: Bool, var out: BytesBuilder) {
  if !pretty {
    return
  }
  out.write_byte(10)
  out.write_str(prefix)
  for _ in 0..depth {
    out.write_str(ind)
  }
}

fn value_get(v: json.Value, key: Str) -> json.Value? {
  match v {
    Object(fields) => {
      for (k, x) in fields {
        if k == key {
          return Some(x)
        }
      }
      None
    }
    _ => None
  }
}

// ---------------------------------------------------------------------------
// The streaming decoder (decision 0309): where each top level value ends,
// then parse_value on it, so the values and errors are parse_value's

struct Decoder {
  buf: Bytes
  max: Int
  /// an error found after values the same write returned: the next
  /// call's (Go's Decoder returns the values before it first)
  err: Str = ""
}

fn decoder(max_value: Int) -> Decoder { Decoder{buf: b"", max: max_value} }

fn is_space(c: Int) -> Bool { c == 32 || c == 9 || c == 10 || c == 13 }

fn digit(c: Int) -> Bool { c >= 48 && c <= 57 }

/// Where a number at b[i] ends (Go's scanner: -? (0 | [1-9][0-9]*)
/// (. [0-9]+)? ([eE] [+-]? [0-9]+)?): the first byte that cannot go on
/// it; one past a byte that breaks it (parse_value names the error); -1
/// when the input ends first.
fn number_end(b: Bytes, i: Int) -> Int {
  let n = b.len()
  var k = i
  // states: 0 start, 1 after -, 2 after a leading 0, 3 in the integer,
  // 4 after ., 5 in the fraction, 6 after e, 7 after the exponent's
  // sign, 8 in the exponent
  var st = 0
  while k < n {
    let c = Int(b[k])
    var next = -1
    if st == 0 {
      next = if c == 45 { 1 } else if c == 48 { 2 } else if digit(c) { 3 } else { -1 }
    } else if st == 1 {
      next = if c == 48 { 2 } else if digit(c) { 3 } else { -1 }
    } else if st == 2 || st == 3 {
      next = if st == 3 && digit(c) { 3 } else if c == 46 { 4 } else if c == 101 || c == 69 { 6 } else { -2 }
    } else if st == 4 || st == 5 {
      next = if digit(c) { 5 } else if st == 5 && (c == 101 || c == 69) { 6 } else if st == 5 { -2 } else { -1 }
    } else if st == 6 {
      next = if c == 43 || c == 45 { 7 } else if digit(c) { 8 } else { -1 }
    } else if st == 7 {
      next = if digit(c) { 8 } else { -1 }
    } else {
      next = if digit(c) { 8 } else { -2 }
    }
    if next == -2 {
      return k
    }
    if next == -1 {
      return k + 1
    }
    st = next
    k += 1
  }
  -1
}

/// Where a literal at b[i] ends: after true, false, or null; one past
/// the first byte that differs; -1 when the input ends first.
fn literal_end(b: Bytes, i: Int) -> Int {
  let c = Int(b[i])
  let lit = if c == 116 { b"true" } else if c == 102 { b"false" } else { b"null" }
  var k = 0
  while k < lit.len() {
    if i + k >= b.len() {
      return -1
    }
    if b[i + k] != lit[k] {
      return i + k + 1
    }
    k += 1
  }
  i + lit.len()
}

/// The end of the value at b[i] (exclusive), or -1 when the input so far
/// does not finish it.
fn value_end(b: Bytes, i: Int) -> Int {
  let n = b.len()
  let c = Int(b[i])
  if c == 123 || c == 91 {
    var depth = 0
    var k = i
    var in_str = false
    while k < n {
      let x = Int(b[k])
      if in_str {
        if x == 92 {
          k += 1
        } else if x == 34 {
          in_str = false
        }
      } else if x == 34 {
        in_str = true
      } else if x == 123 || x == 91 {
        depth += 1
      } else if x == 125 || x == 93 {
        depth -= 1
        if depth == 0 {
          return k + 1
        }
      }
      k += 1
    }
    return -1
  }
  if c == 34 {
    var k = i + 1
    while k < n {
      let x = Int(b[k])
      if x == 92 {
        k += 1
      } else if x == 34 {
        return k + 1
      }
      k += 1
    }
    return -1
  }
  if c == 45 || digit(c) {
    return number_end(b, i)
  }
  if c == 116 || c == 102 || c == 110 {
    return literal_end(b, i)
  }
  // a byte no value starts with: parse_value names it
  i + 1
}

fn stream_err(msg: Str) -> json.DecodeErr { json.DecodeErr{path: "$", msg: msg} }

/// The values of d.buf; with last, an unfinished value is an error.
fn (var d: Decoder) take(last: Bool) -> List[json.Value] ! json.DecodeErr {
  if !d.err.is_empty() {
    return Err(stream_err(d.err))
  }
  var out: List[json.Value] = []
  let b = d.buf
  let n = b.len()
  var i = 0
  var err = ""
  while true {
    while i < n && is_space(Int(b[i])) {
      i += 1
    }
    if i >= n {
      break
    }
    var end = value_end(b, i)
    if end < 0 && !last {
      // it may go on: wait for more, up to max_value
      if n - i > d.max {
        err = "invalid JSON: value exceeds max_value (${d.max} bytes)"
      }
      break
    }
    if end < 0 {
      end = n
    }
    if end - i > d.max {
      err = "invalid JSON: value exceeds max_value (${d.max} bytes)"
      break
    }
    match parse_bytes(b[i..end]) {
      Ok(v) => out.push(v)
      Err(e) => {
        // the input ran out (jsontext's texts, Go's)
        let short = e.msg == "invalid JSON: EOF" || e.msg.ends_with("unexpected end of JSON input")
        err = if short { "invalid JSON: unexpected EOF" } else { e.msg }
        break
      }
    }
    i = end
  }
  d.buf = b[i..n]
  if err.is_empty() {
    return out
  }
  if out.is_empty() {
    return Err(stream_err(err))
  }
  d.err = err
  out
}

fn (var d: Decoder) write(data: Bytes) -> List[json.Value] ! json.DecodeErr {
  let b0 = d.buf
  d.buf = b0 + data
  d.take(false)
}

fn (var d: Decoder) finish() -> List[json.Value] ! json.DecodeErr { d.take(true) }

// from_value reads v's tape (jsontext's format, written from the Value
// with its strings placed as they are and its numbers' text) with the
// decoder generated for T, as decode reads v's text: every decode rule
// and error is the same, without the escaping and the lexing of a text
// (it was decode(value_encode(v).bytes())).
fn from_value[T: Json](v: json.Value) -> T ! json.DecodeErr {
  var src = BytesBuilder.new()
  var tape: List[Int] = []
  value_tape(src, tape, v)
  match rtjson.json_dec[T](src.freeze(), tape, 0) {
    Ok(x) => Ok(x)
    Err(e) => Err(json.DecodeErr{path: "$" + e.path, msg: e.msg})
  }
}

/// Appends v's nodes to tape (three words each: kind, a, b; jsontext's
/// format) and the text they point at to src.
fn value_tape(var src: BytesBuilder, var tape: List[Int], v: json.Value) {
  match v {
    // kinds: 0 null, 1 false, 2 true, 3 number, 4 string, 5 array, 6 object
    Null => tape_node(tape, 0, 0, 0)
    Bool(b) => tape_node(tape, if b { 2 } else { 1 }, 0, 0)
    Int(n) => tape_text(src, tape, 3, "${n}")
    Num(n) => {
      // value_append's text: null for NaN and the infinities
      let s = jsontext.append_float("", n)
      if s == "null" {
        tape_node(tape, 0, 0, 0)
      } else {
        tape_text(src, tape, 3, s)
      }
    }
    Str(s) => tape_text(src, tape, 4, s)
    Trusted(_, s) => tape_text(src, tape, 4, s)
    List(items) => {
      let at = tape.len()
      tape_node(tape, 5, items.len(), 0)
      for x in items {
        value_tape(src, tape, x)
      }
      tape[at + 2] = tape.len()
    }
    Object(fields) => {
      let at = tape.len()
      tape_node(tape, 6, fields.len(), 0)
      for f in fields {
        tape_text(src, tape, 4, f.0)
        value_tape(src, tape, f.1)
      }
      tape[at + 2] = tape.len()
    }
  }
}

fn tape_node(var tape: List[Int], kind: Int, a: Int, b: Int) {
  tape.push(kind)
  tape.push(a)
  tape.push(b)
}

/// A number (kind 3) or string (kind 4) node whose text s goes at the end
/// of src, a string's as it is.
fn tape_text(var src: BytesBuilder, var tape: List[Int], kind: Int, s: Str) {
  let at = src.len()
  src.write_str(s)
  tape_node(tape, kind, at, if kind == 4 { jsontext.plain_str_b(s) } else { s.len() })
}

// ---------------------------------------------------------------------------
// The token reader (decision 0495): the state machine of Go's Decoder.Token
// (stream.go: tokenState, tokenStack, tokenValueAllowed, tokenValueEnd,
// tokenError). The states are Go's, in its order.

const T_TOP: Int = 0
const T_ARR_START: Int = 1
const T_ARR_VALUE: Int = 2
const T_ARR_COMMA: Int = 3
const T_OBJ_START: Int = 4
const T_OBJ_KEY: Int = 5
const T_OBJ_COLON: Int = 6
const T_OBJ_VALUE: Int = 7
const T_OBJ_COMMA: Int = 8

struct TokenReader {
  buf: Bytes
  pos: Int
  /// the bytes dropped from the front of buf (offset)
  base: Int
  max: Int
  state: Int
  /// the states of the enclosing arrays and objects (Go's tokenStack)
  stack: List[Int]
  eof: Bool
  /// an error found after tokens the same write returned: the next call's
  err: Str = ""
}

fn token_reader(max_token: Int) -> TokenReader {
  TokenReader{buf: b"", pos: 0, base: 0, max: max_token, state: T_TOP, stack: [], eof: false}
}

fn tokens(data: Bytes) -> TokenReader {
  TokenReader{buf: data, pos: 0, base: 0, max: data.len(), state: T_TOP, stack: [], eof: true}
}

fn value_allowed(st: Int) -> Bool { st == T_TOP || st == T_ARR_START || st == T_ARR_VALUE || st == T_OBJ_VALUE }

/// Go's tokenValueEnd: the state after a value.
fn after_value(st: Int) -> Int {
  if st == T_ARR_START || st == T_ARR_VALUE {
    return T_ARR_COMMA
  }
  if st == T_OBJ_VALUE {
    return T_OBJ_COMMA
  }
  st
}

/// Go's tokenError: the byte c where the state st does not allow it (an
/// object's first key has no context there).
fn bad_char(st: Int, c: Int) -> json.DecodeErr {
  let ctx = match st {
    T_ARR_COMMA => 2
    T_OBJ_START => 0
    T_OBJ_KEY => 3
    T_OBJ_COLON => 4
    T_OBJ_COMMA => 5
    _ => 1
  }
  stream_err("invalid JSON: " + jsontext.syntax_err(ctx, c))
}

fn eof_err() -> json.DecodeErr { stream_err("invalid JSON: unexpected EOF") }

/// parse_bytes' error for text the input ended in the middle of.
fn eof_mapped(e: json.DecodeErr) -> json.DecodeErr {
  if e.msg == "invalid JSON: EOF" || e.msg.ends_with("unexpected end of JSON input") { eof_err() } else { e }
}

/// The end of the string whose opening quote is b[i] (exclusive), -1 when
/// the input ends first; a control byte before the closing quote ends the
/// scan one past it, so the parse of the slice names it.
fn string_end(b: Bytes, i: Int) -> Int {
  let n = b.len()
  var k = i + 1
  while k < n {
    let x = Int(b[k])
    if x == 34 {
      return k + 1
    }
    if x == 92 {
      k += 2
      continue
    }
    if x < 32 {
      return k + 1
    }
    k += 1
  }
  -1
}

/// The string at b[lo..hi] (its quotes included), as decode reads it.
fn string_text(b: Bytes, lo: Int, hi: Int) -> Str ! json.DecodeErr {
  var plain = hi - lo >= 2 && b[hi - 1] == 34
  var k = lo + 1
  while plain && k < hi - 1 {
    let x = Int(b[k])
    if x < 32 || x == 92 || x >= 128 {
      plain = false
    }
    k += 1
  }
  if plain {
    return jsontext.slice_str(b, lo + 1, hi - 1)
  }
  let v = parse_bytes(b[lo..hi])?
  match v {
    Str(s) => s
    _ => ""
  }
}

fn (var r: TokenReader) skip_space() {
  let b = r.buf
  let n = b.len()
  var i = r.pos
  while i < n && is_space(Int(b[i])) {
    i += 1
  }
  r.pos = i
}

fn too_big(max: Int) -> json.DecodeErr { stream_err("invalid JSON: token exceeds max_token (${max} bytes)") }

/// The next token (Go's Token): None when the input is used up, or ends in
/// the middle of a token that the next write may finish.
fn (var r: TokenReader) pull() -> json.Token? ! json.DecodeErr {
  let b = r.buf
  let n = b.len()
  while true {
    r.skip_space()
    let i = r.pos
    if i >= n {
      if r.eof && r.stack.len() > 0 {
        return Err(eof_err())
      }
      return None
    }
    let c = Int(b[i])
    let st = r.state
    if c == 91 || c == 123 {
      if !value_allowed(st) {
        return Err(bad_char(st, c))
      }
      r.pos = i + 1
      r.stack.push(st)
      if c == 91 {
        r.state = T_ARR_START
        return Some(json.Token.ArrayStart)
      }
      r.state = T_OBJ_START
      return Some(json.Token.ObjectStart)
    }
    if c == 93 {
      if st != T_ARR_START && st != T_ARR_COMMA {
        return Err(bad_char(st, c))
      }
      r.pos = i + 1
      r.state = after_value(r.stack.pop() ?? T_TOP)
      return Some(json.Token.ArrayEnd)
    }
    if c == 125 {
      if st != T_OBJ_START && st != T_OBJ_COMMA {
        return Err(bad_char(st, c))
      }
      r.pos = i + 1
      r.state = after_value(r.stack.pop() ?? T_TOP)
      return Some(json.Token.ObjectEnd)
    }
    if c == 44 {
      if st == T_ARR_COMMA {
        r.pos = i + 1
        r.state = T_ARR_VALUE
        continue
      }
      if st == T_OBJ_COMMA {
        r.pos = i + 1
        r.state = T_OBJ_KEY
        continue
      }
      return Err(bad_char(st, c))
    }
    if c == 58 {
      if st != T_OBJ_COLON {
        return Err(bad_char(st, c))
      }
      r.pos = i + 1
      r.state = T_OBJ_VALUE
      continue
    }
    if c == 34 {
      let key = st == T_OBJ_START || st == T_OBJ_KEY
      if !key && !value_allowed(st) {
        return Err(bad_char(st, c))
      }
      let end = string_end(b, i)
      if end < 0 {
        if r.eof {
          return Err(eof_err())
        }
        if n - i > r.max {
          return Err(too_big(r.max))
        }
        return None
      }
      let s = string_text(b, i, end)?
      r.pos = end
      if key {
        r.state = T_OBJ_COLON
        return Some(json.Token.Key(s: s))
      }
      r.state = after_value(st)
      return Some(json.Token.Str(s: s))
    }
    let num = c == 45 || digit(c)
    let lit = c == 116 || c == 102 || c == 110
    if !num && !lit {
      return Err(bad_char(st, c))
    }
    if !value_allowed(st) {
      return Err(bad_char(st, c))
    }
    var end = if num { number_end(b, i) } else { literal_end(b, i) }
    if end < 0 {
      if !r.eof {
        if n - i > r.max {
          return Err(too_big(r.max))
        }
        return None
      }
      end = n
    }
    let v = match parse_bytes(b[i..end]) {
      Ok(v) => v
      Err(e) => return Err(eof_mapped(e))
    }
    r.pos = end
    r.state = after_value(st)
    if num {
      return Some(json.Token.Number(text: jsontext.slice_str(b, i, end)))
    }
    return Some(match v {
      Bool(x) => json.Token.Bool(b: x)
      _ => json.Token.Null
    })
  }
  None
}

/// The tokens the buffer holds; an error after some of them is the next
/// call's.
fn (var r: TokenReader) drain() -> List[json.Token] ! json.DecodeErr {
  if !r.err.is_empty() {
    return Err(stream_err(r.err))
  }
  var out: List[json.Token] = []
  while true {
    match r.pull() {
      Ok(t) => {
        match t {
          Some(x) => out.push(x)
          None => break
        }
      }
      Err(e) => {
        if out.is_empty() {
          return Err(e)
        }
        r.err = e.msg
        return out
      }
    }
  }
  out
}

fn (var r: TokenReader) write(data: Bytes) -> List[json.Token] ! json.DecodeErr {
  if r.pos > 0 {
    r.base += r.pos
    r.buf = r.buf[r.pos..]
    r.pos = 0
  }
  let b0 = r.buf
  r.buf = b0 + data
  r.drain()
}

fn (var r: TokenReader) finish() -> List[json.Token] ! json.DecodeErr {
  r.eof = true
  r.drain()
}

fn (var r: TokenReader) next() -> json.Token? ! json.DecodeErr {
  if !r.err.is_empty() {
    return Err(stream_err(r.err))
  }
  r.pull()
}

fn (var r: TokenReader) more() -> Bool {
  r.skip_space()
  let b = r.buf
  r.pos < b.len() && b[r.pos] != 93 && b[r.pos] != 125
}

fn (r: TokenReader) offset() -> Int { r.base + r.pos }

/// Past the white space, and the colon or comma Go's Token takes before
/// the value that follows a key or an element.
fn (var r: TokenReader) to_value() {
  r.skip_space()
  let b = r.buf
  if r.pos < b.len() {
    let c = Int(b[r.pos])
    if c == 58 && r.state == T_OBJ_COLON {
      r.pos += 1
      r.state = T_OBJ_VALUE
    } else if c == 44 && r.state == T_ARR_COMMA {
      r.pos += 1
      r.state = T_ARR_VALUE
    } else if c == 44 && r.state == T_OBJ_COMMA {
      r.pos += 1
      r.state = T_OBJ_KEY
    }
    r.skip_space()
  }
}

fn (var r: TokenReader) skip() -> () ! json.DecodeErr {
  r.to_value()
  let b = r.buf
  let n = b.len()
  let i = r.pos
  if i < n && (b[i] == 123 || b[i] == 91) && value_allowed(r.state) {
    // a whole array or object: found by its brackets, then checked
    let end = value_end(b, i)
    if end < 0 {
      return Err(eof_err())
    }
    let text = b[i..end]
    if jsontext.parse(text).is_empty() {
      return Err(stream_err("invalid JSON: ${jsontext.parse_err(text)}"))
    }
    r.pos = end
    r.state = after_value(r.state)
    return
  }
  match r.pull()? {
    Some(t) => {
      match t {
        Key(_) => return Err(stream_err("invalid JSON: no value to skip, an object key is next"))
        ObjectEnd => return Err(stream_err("invalid JSON: no value to skip, an object ends"))
        ArrayEnd => return Err(stream_err("invalid JSON: no value to skip, an array ends"))
        _ => ()
      }
    }
    None => return Err(eof_err())
  }
}

fn (var r: TokenReader) value() -> json.Value ! json.DecodeErr {
  r.to_value()
  let start = r.pos
  r.skip()?
  parse_bytes(r.buf[start..r.pos])
}

// ---------------------------------------------------------------------------
// The writer (decision 0495): encoding/json's string and float forms

struct JsonWriter {
  out: BytesBuilder
  /// one entry per open array (1) or object (0): bit 1 set once it holds
  /// an element, bit 2 set while an object's value is due
  stack: List[Int]
  html: Bool
  /// the values written at the top level
  top: Int
}

fn json_writer(escape_html: Bool) -> JsonWriter {
  JsonWriter{out: BytesBuilder.new(), stack: [], html: escape_html, top: 0}
}

/// A value starts here: the comma, or the newline between top level values.
fn (var w: JsonWriter) begin_value() {
  let n = w.stack.len()
  if n == 0 {
    if w.top > 0 {
      w.out.write_byte(10)
    }
    w.top += 1
    return
  }
  let t = w.stack[n - 1]
  if (t & 1) == 1 {
    if (t & 2) != 0 {
      w.out.write_byte(44)
    }
    w.stack[n - 1] = t | 2
    return
  }
  if (t & 4) == 0 {
    fault("json: a value is written where an object key is due")
  }
  w.stack[n - 1] = t - 4
}

fn (var w: JsonWriter) object_start() {
  w.begin_value()
  w.out.write_byte(123)
  w.stack.push(0)
}

fn (var w: JsonWriter) array_start() {
  w.begin_value()
  w.out.write_byte(91)
  w.stack.push(1)
}

fn (var w: JsonWriter) object_end() {
  let n = w.stack.len()
  if n == 0 || (w.stack[n - 1] & 1) == 1 || (w.stack[n - 1] & 4) != 0 {
    fault("json: object_end with no open object, or a key without its value")
  }
  w.out.write_byte(125)
  w.stack.pop()
}

fn (var w: JsonWriter) array_end() {
  let n = w.stack.len()
  if n == 0 || (w.stack[n - 1] & 1) == 0 {
    fault("json: array_end with no open array")
  }
  w.out.write_byte(93)
  w.stack.pop()
}

/// s as a JSON string, quotes included (Go's encodeState.string): a
/// word scan for the first byte to escape, the string as it is when
/// there is none, else one escaping pass from that byte.
fn (var w: JsonWriter) write_string(s: Str) {
  let i = jsontext.first_stop(s, w.html)
  w.out.write_byte(34)
  if i >= s.len() {
    w.out.write_str(s)
  } else {
    w.out.write_str(jsontext.append_escaped("", s, i, w.html))
  }
  w.out.write_byte(34)
}

fn (var w: JsonWriter) key(name: Str) {
  let n = w.stack.len()
  if n == 0 || (w.stack[n - 1] & 1) == 1 || (w.stack[n - 1] & 4) != 0 {
    fault("json: a key is written outside an object, or after a key")
  }
  let t = w.stack[n - 1]
  if (t & 2) != 0 {
    w.out.write_byte(44)
  }
  w.write_string(name)
  w.out.write_byte(58)
  w.stack[n - 1] = t | 6
}

fn (var w: JsonWriter) str(s: Str) {
  w.begin_value()
  w.write_string(s)
}

fn (var w: JsonWriter) int(n: Int) {
  w.begin_value()
  w.out.write_str("${n}")
}

fn (var w: JsonWriter) float(f: Float) -> () ! json.DecodeErr {
  if f != f {
    return Err(json.DecodeErr{path: "$", msg: "json: unsupported value: NaN"})
  }
  if f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {
    return Err(json.DecodeErr{path: "$", msg: "json: unsupported value: " + (if f > 0.0 { "+Inf" } else { "-Inf" })})
  }
  w.begin_value()
  w.out.write_str(jsontext.append_float("", f))
}

fn (var w: JsonWriter) number(text: Str) -> () ! json.DecodeErr {
  let b = text.bytes()
  let n = b.len()
  if n == 0 || !(b[0] == 45 || digit(Int(b[0]))) || is_space(Int(b[n - 1])) || jsontext.parse(b).is_empty() {
    return Err(json.DecodeErr{path: "$", msg: "json: invalid number literal " + "\"" + text + "\""})
  }
  w.begin_value()
  w.out.write_str(text)
}

fn (var w: JsonWriter) bool(b: Bool) {
  w.begin_value()
  w.out.write_str(if b { "true" } else { "false" })
}

fn (var w: JsonWriter) null() {
  w.begin_value()
  w.out.write_str("null")
}

fn (var w: JsonWriter) raw(text: Str) -> () ! json.DecodeErr {
  var c = compact(text)?
  if w.html {
    c = c.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
  }
  w.begin_value()
  w.out.write_str(c)
}

fn (var w: JsonWriter) value(v: json.Value) -> () ! json.DecodeErr {
  match v {
    Null => w.null()
    Bool(b) => w.bool(b)
    Int(n) => w.int(n)
    Num(n) => w.float(n)?
    Str(s) => w.str(s)
    Trusted(_, s) => w.str(s)
    List(items) => {
      w.array_start()
      for x in items {
        w.value(x)?
      }
      w.array_end()
    }
    Object(fields) => {
      w.object_start()
      for f in fields {
        w.key(f.0)
        w.value(f.1)?
      }
      w.object_end()
    }
  }
}

fn (var w: JsonWriter) finish() -> Bytes {
  if w.stack.len() > 0 {
    fault("json: finish with an array or object still open")
  }
  w.out.freeze()
}
