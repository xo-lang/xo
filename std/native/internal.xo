// std/internal on the native backends (decisions 0074 and 0214). std/rt's
// internal.go is the reference: only the root Fs takes the lock.
use native/llrt/aesgcm
use native/llrt/fsops
use native/llrt/hkdf
use native/llrt/hmac
use native/llrt/nistec
use native/llrt/rsa
use native/llrt/sha256
use native/llrt/sysio
use native/llrt/x509
use native/rt

struct SharedLock {
  h: rt.FsLock
}

fn lock_shared(f: Fs, p: Str) -> SharedLock ! FsErr uses fs.write {
  if rt.fs_mode(f) != 0 || rt.fs_root(f) != "" {
    return Err(FsErr.Denied(path: p))
  }
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let h = fsops.lock(p, true, p, true)
  if fsops.lock_held(h) {
    return SharedLock{h: h}
  }
  // the status as native/prelude's fs_err maps it
  match sysio.status() {
    1 => Err(FsErr.NotFound(path: p))
    4 => Err(FsErr.NotDir(path: p))
    5 => Err(FsErr.IsDir(path: p))
    6 => Err(FsErr.Denied(path: p))
    7 => Err(FsErr.Io(path: p, msg: sysio.msg()[1]))
    _ => Err(FsErr.Canceled)
  }
}

fn (l: SharedLock) unlock() { fsops.unlock(l.h) }

fn crypto_op(op: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes {
  let area = op.split(".")[0]
  let what = op.trim_prefix("${area}.")
  let r = match area {
    "hash" => sha256.op(what, a, b, c, d)
    "hmac" => hmac.op(what, a, b, c, d)
    "hkdf" => hkdf.op(what, a, b, c, d)
    "p256" => nistec.op(nistec.P256, what, a, b, c, d)
    "p384" => nistec.op(nistec.P384, what, a, b, c, d)
    "rsa" => rsa.op(what, a, b, c, d)
    "x509" => x509.op(what, a, b, c, d)
    "aes" => aesgcm.op(what, a, b, c, d)
    _ => None
  }
  r ?? fault("internal.crypto_op: unknown op ${op}")
}
