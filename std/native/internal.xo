struct SharedLock {
  h: rt.FsLock
}

fn lock_shared(f: Fs, p: Str) -> SharedLock ! FsErr uses fs.write {
  if rt.fs_mode(f) != 0 || rt.fs_root(f) != "" {
    return Err(FsErr.Denied(path: p))
  }
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let h = fsops.lock(p, true, p, true)
  if fsops.lock_held(h) {
    return SharedLock{h: h}
  }
  // the status as native/prelude's fs_err maps it
  match sysio.status() {
    1 => Err(FsErr.NotFound(path: p))
    4 => Err(FsErr.NotDir(path: p))
    5 => Err(FsErr.IsDir(path: p))
    6 => Err(FsErr.Denied(path: p))
    7 => Err(FsErr.Io(path: p, msg: sysio.msg()[1]))
    _ => Err(FsErr.Canceled)
  }
}

fn (l: SharedLock) unlock() { fsops.unlock(l.h) }

fn dir_names(f: Fs, dir: Str) -> List[Str] ! FsErr uses fs.read {
  if rt.fs_mode(f) != 0 || rt.fs_root(f) != "" {
    return Err(FsErr.Denied(path: dir))
  }
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let names = fsops.names(dir, dir)
  // the status as native/prelude's fs_err maps it
  match sysio.status() {
    0 => Ok(names)
    1 => Err(FsErr.NotFound(path: dir))
    4 => Err(FsErr.NotDir(path: dir))
    5 => Err(FsErr.IsDir(path: dir))
    6 => Err(FsErr.Denied(path: dir))
    7 => Err(FsErr.Io(path: dir, msg: sysio.msg()[1]))
    _ => Err(FsErr.Canceled)
  }
}

/// The check of std/native/sys_c.xo (decision 0232): "present", three
/// bytes: whether getpid returned a positive process ID (a strong C call),
/// whether getpid is linked, whether ThreadSanitizer is (rt.sym_present
/// of weak references; 0 in a build without it). "race_write": a planted
/// data race for the ThreadSanitizer test (internal/llvm TestTSanSameThreadRace).
fn sysc_op(what: Str, a: Bytes) -> Bytes? {
  if what == "race_write" {
    // a data race on purpose (testdata/tsan_race): a plain load and
    // store of a's first word, which the tasks calling it share
    let p = raw.bytes_addr(a)
    rt.mem_store(p, 0, rt.mem_load(p, 0, 8) + 1, 8)
    return Some(a)
  }
  if what == "heap_libc" {
    // whether the heap was mapped through the C library (a sanitizer
    // build, heapos.xo map)
    return Some(rt.rs_push_byte(rt.rs_with_cap(1), if heapos.libc_maps() > 0 { 1 } else { 0 }).bytes())
  }
  if what != "present" {
    return None
  }
  var s = rt.rs_with_cap(3)
  s = rt.rs_push_byte(s, if Int(sys_c.getpid()) > 0 { 1 } else { 0 })
  s = rt.rs_push_byte(s, if rt.sym_present("getpid") { 1 } else { 0 })
  s = rt.rs_push_byte(s, if rt.sym_present("__tsan_acquire") { 1 } else { 0 })
  Some(s.bytes())
}

/// The address intrinsics of decision 0233, for the golden rt_addrs and
/// test/codegen/fnaddr (no module xo's own build reaches calls them
/// before a seed has them). "fn_addr": cabi.xo's fmt_int called through
/// its address, the text's length and first byte (5 and '1' for 12345).
/// "frame_addr": whether the frame address is not 0, a callee's frame
/// is below it, and within 64 KiB.
fn rt_op(what: Str, a: Bytes) -> Bytes? {
  var s = rt.rs_with_cap(3)
  if what == "mem_check" {
    // libcstr's copies against byte loops: the mismatches, in decimal
    return Some("${probe_mem_check()}".bytes())
  }
  if what == "list_swap" {
    // rt.list_swap of decision 0374, for the golden native_list_swap: every
    // backend runs its own lowering, and the Go backend std/rt's answer
    return Some(probe_list_swap().bytes())
  }
  if what == "list_swap2" {
    // rt.list_swap2 of decision 0374 step 3, for the golden
    // native_list_swap2: every backend runs its own lowering, and the Go
    // backend std/rt's answer
    return Some(probe_list_swap2().bytes())
  }
  if what == "list_swap_at" {
    // the swap shape of test/codegen/lists: the first index proven, the
    // second not (calls.xo bounds_check, 2026-10-26)
    return Some("${probe_list_swap_at(a)}".bytes())
  }
  if what == "fn_addr" {
    let buf = rt.heap_large(32)
    let n = rt.call_c2(rt.fn_addr("fmt_int"), buf, 12345)
    s = rt.rs_push_byte(s, n)
    s = rt.rs_push_byte(s, rt.mem_load(buf, 0, 1))
    rt.heap_release(buf - 8)
    return Some(s.bytes())
  }
  if what == "alive" {
    // a raw address into bytes this function owns (gotchas
    // raw-address-outlives-bytes.md): the bytes are released after their
    // last use, so raw.alive after the last read through the address
    // keeps them; 64 more blocks of their size are made and filled in
    // between (they would take the bytes' block if it had been freed)
    let b = raw.bytes_buf(64)
    let p = raw.bytes_addr(b)
    rt.mem_set(p, 165, 64)
    var junk: List[Bytes] = []
    for _ in 0..64 {
      let j = raw.bytes_buf(64)
      rt.mem_set(raw.bytes_addr(j), 90, 64)
      junk.push(j)
    }
    var same = 1
    for i in 0..64 {
      if rt.mem_load(p, i, 1) != 165 {
        same = 0
      }
    }
    raw.alive(b)
    s = rt.rs_push_byte(s, same)
    s = rt.rs_push_byte(s, if junk.len() == 64 { 1 } else { 0 })
    return Some(s.bytes())
  }
  if what == "sym_addr" {
    // decision 0234: the generated entry's address, and the C library's
    // strlen (an XO_NOLIBC build's too) called through its own, of
    // "xxxxxxx"
    s = rt.rs_push_byte(s, if rt.sym_addr("xo_entry") != 0 { 1 } else { 0 })
    let buf = rt.heap_large(8)
    rt.mem_store(buf, 0, 33909456017848440, 8)
    s = rt.rs_push_byte(s, rt.call_c2(rt.sym_addr("strlen"), buf, 0))
    rt.heap_release(buf - 8)
    return Some(s.bytes())
  }
  if what == "auxv" {
    // the auxiliary vector read from memory after the start's
    // environment (linux.xo auxv_init): kept, its AT_PHDR the one
    // /proc/self/auxv gives, AT_PAGESZ set; 01 01 01 off Linux
    let onlinux = target.os == TargetOs.Linux
    s = rt.rs_push_byte(s, if !onlinux || linux.auxv_kept() { 1 } else { 0 })
    s = rt.rs_push_byte(s, if !onlinux || linux.auxval(3) == linux.auxval_proc(3) { 1 } else { 0 })
    s = rt.rs_push_byte(s, if !onlinux || linux.auxval(6) > 0 { 1 } else { 0 })
    return Some(s.bytes())
  }
  if what == "frame_addr" {
    let a = rt.frame_addr()
    let c = frame_below()
    s = rt.rs_push_byte(s, if a != 0 { 1 } else { 0 })
    s = rt.rs_push_byte(s, if c != 0 && c < a { 1 } else { 0 })
    s = rt.rs_push_byte(s, if a - c < 65536 { 1 } else { 0 })
    return Some(s.bytes())
  }
  None
}

fn obj_word[T](x: T) -> Int { rt.obj_addr(x) }

fn rt_queued() -> Int uses realtime { obj.rt_queued() }

fn rt_allocs() -> Int uses realtime { rtsec.allocs() }

fn rt_probe(op: Str, a: Int, b: Int, c: Int, d: Int) -> Int {
  match op {
    "live" | "total" => {
      // heapos.live writes both sums; its own block is one more of each
      let w = obj.alloc_obj(16)
      heapos.live(w, w + 8)
      let r = rt.mem_load(w, if op == "live" { 0 } else { 8 }, 8) - 1
      obj.free_obj(w)
      r
    }
    "chunks" => heapos.chunks()
    "io_chunk" => {
      // the chunk size of one read(2) or write(2) (raw.io_len): a for
      // tests (small, to make every transfer many chunks), 0 back to 1 GiB
      raw.set_io_chunk(a)
      0
    }
    "thread" => rt.tlocal_addr()
    "alloc" => obj.alloc_obj(a)
    "free" => {
      obj.free_obj(a)
      0
    }
    "resize" => obj.resize_obj(a, b, c)
    "fill" => {
      probe_fill(a, b, c)
      0
    }
    "check" => if probe_check(a, b, c, d) { 1 } else { 0 }
    "rs_cap" => {
      let o = obj.rs_new_obj(a)
      let cap = rt.mem_load(o, 8, 8)
      rt.mem_set(o + 16, 90, cap)
      obj.free_obj(o)
      cap
    }
    "obj" => {
      let o = obj.alloc_obj(16)
      rt.mem_store(o, 0, 1, 8)
      rt.mem_store(o, 8, a, 8)
      o
    }
    "word" => rt.mem_load(a, 8, 8)
    "inc" => {
      rc.inc(a)
      0
    }
    "dec" => rc.dec(a)
    "claim" => rc.claim(a)
    "mark" => rc.mark(a)
    "count" => rt.slot_load(a, 0, 0)
    "readers" => mutex.queued(a, false)
    "writers" => mutex.queued(a, true)
    "listed" => pool.scope_listed(a)
    "workers" => pool.alive(ctx.pool())
    "cpus" => pool.cpus(ctx.pool())
    "inherited" => probe_inherited()
    "qsort_fault" => {
      // a fault raised in a callback of the C library (decision 0241:
      // fault_shared.c): qsort's comparator is cabi.xo's fault_raise_msg,
      // and each of the four 16 byte elements holds "boom in qsort", so
      // the two elements qsort compares are the fault's message and
      // location. The Xo unwinder must find libc's unwind tables to walk
      // qsort's frames back to the caller; it never returns here
      let base = obj.alloc_obj(64)
      let text = "boom in qsort".bytes()
      for i in 0..4 {
        rt.mem_set(base + i * 16, 0, 16)
        for j in 0..text.len() {
          rt.mem_store(base, i * 16 + j, Int(text[j]), 1)
        }
      }
      sys_c.qsort(base, 4, 16, rt.fn_addr("fault_raise_msg"))
      obj.free_obj(base)
      0
    }
    _ => fault("internal.rt_probe: unknown op ${op}")
  }
}

/// rt_probe's "inherited" (decision 0241: evloop.c test_inherited,
/// gotchas/linux-epoll-inherited-socket.md): a pipe whose read end a
/// child process also holds is registered with the poller and freed,
/// then made readable: no event may reach the freed descriptor record
/// (epoll keys a registration by the open file, so without the
/// EPOLL_CTL_DEL of pd_close it outlives the close). 1 when it ran, 2
/// off Linux (kqueue drops a closed descriptor's events), 0 when a
/// system call failed.
fn probe_inherited() -> Int {
  if target.os != TargetOs.Linux {
    return 2
  }
  let fds = obj.alloc_obj(16)
  let ts = obj.alloc_obj(16)
  let x = obj.alloc_obj(8)
  rt.mem_store(x, 0, 120, 1)
  // inherited: the pipe is not close-on-exec
  if linux.pipe2(fds, 0) != 0 {
    return 0
  }
  let r = rt.mem_load(fds, 0, 4)
  let w = rt.mem_load(fds, 4, 4)
  // the child holds both ends for 0.3 s, making only system calls
  rt.mem_store(ts, 0, 0, 8)
  rt.mem_store(ts, 8, 300000000, 8)
  let pid = linux.fork()
  if pid == 0 {
    let _s = linux.nanosleep_at(ts)
    let _e = linux.exit_group(0)
  }
  let _n = sock.nonblock(r)
  let pd = poll.pd_open(r, false)
  poll.pd_free(pd)
  // the poller frees it at the top of its next turn
  poll.poke()
  rt.mem_store(ts, 8, 50000000, 8)
  let _a = linux.nanosleep_at(ts)
  // readable now, through the file the child still holds open
  let _w = linux.write_at(w, x, 1)
  let _b = linux.nanosleep_at(ts)
  poll.poke()
  rt.mem_store(ts, 8, 20000000, 8)
  let _c = linux.nanosleep_at(ts)
  if pid > 0 {
    let _d = linux.wait4(pid, 0)
  }
  let _f = linux.close(w)
  obj.free_obj(fds)
  obj.free_obj(ts)
  obj.free_obj(x)
  if pid < 0 { 0 } else { 1 }
}

/// The byte of tag t at i: rt_probe's "fill" and "check" pattern (every
/// byte up to 4 KiB, then one in every 4 KiB page, and the last).
fn probe_pat(t: Int, i: Int) -> Int {
  t.wrapping_mul(-7046029254386353131).wrapping_add(i.wrapping_mul(31)).shr_logical(56)
}

/// crypto_op's "rt.list_swap": the element swap of decision 0374 on a
/// list of strings and a list of ints, with the identity swap i == j
/// that must leave its element alone; the strings' order, the ints', and
/// the mismatches (0 when every element moved as it should). The strings
/// move as references without a count either way, so a miscount shows as
/// the golden's leak check (XO_LEAKCHECK=1) failing at exit.
fn probe_list_swap() -> Str {
  var xs: List[Str] = ["a", "b", "c", "d", "e"]
  rt.list_swap(xs, 0, 4)
  rt.list_swap(xs, 1, 1)
  rt.list_swap(xs, 2, 3)
  let want = ["e", "b", "d", "c", "a"]
  var bad = 0
  var o = ""
  for i in 0..5 {
    if xs[i] != want[i] {
      bad += 1
    }
    o = o + xs[i]
  }
  var ns: List[Int] = [10, 11, 12]
  rt.list_swap(ns, 0, 2)
  if ns[0] != 12 {
    bad += 1
  }
  if ns[1] != 11 {
    bad += 1
  }
  if ns[2] != 10 {
    bad += 1
  }
  // a packed list (decision 0369): one byte an element on the native
  // backends and LLVM and eight on wasm, so this row takes the other path
  // there; 255 and 250 would come back 0, -1 or a neighbour's byte through
  // a word or a signed load
  var ps: List[UInt8] = [0, 1, 2, 250, 255]
  rt.list_swap(ps, 0, 4)
  rt.list_swap(ps, 1, 3)
  let pwant: List[UInt8] = [255, 250, 2, 1, 0]
  for i in 0..5 {
    if ps[i] != pwant[i] {
      bad += 1
    }
  }
  "${o} ${ns[0]} ${ns[1]} ${ns[2]} ${ps[0]} ${ps[1]} ${ps[2]} ${ps[3]} ${ps[4]} ${bad}"
}

/// crypto_op's "rt.list_swap2": one element of each list swapped across
/// of decision 0374 step 3, on two string lists and two packed lists, with
/// the same list as both arguments (the list_swap case) and i == j; the
/// two lists' orders and the mismatches (0 when every element moved as it
/// should). The strings move as references without a count either way, so
/// a miscount shows as the golden's leak check (XO_LEAKCHECK=1) failing at
/// exit.
fn probe_list_swap2() -> Str {
  var xs: List[Str] = ["a", "b", "c", "d"]
  var ys: List[Str] = ["w", "x", "y", "z"]
  rt.list_swap2(xs, 0, ys, 3)
  rt.list_swap2(xs, 2, ys, 1)
  // the same list as both arguments, and the identity swap
  rt.list_swap2(ys, 0, ys, 3)
  rt.list_swap2(xs, 1, xs, 1)
  let xwant = ["z", "b", "x", "d"]
  let ywant = ["a", "c", "y", "w"]
  var bad = 0
  var o = ""
  var p = ""
  for i in 0..4 {
    if xs[i] != xwant[i] {
      bad += 1
    }
    if ys[i] != ywant[i] {
      bad += 1
    }
    o = o + xs[i]
    p = p + ys[i]
  }
  // packed lists (decision 0369): one byte an element on the native
  // backends and LLVM and eight on wasm, so these rows take the other path
  // there; 255, 250 and -32768 would come back 0, -1, 32768 or a
  // neighbour's byte through a word or a signed load
  var ps1: List[UInt8] = [0, 1, 2]
  var ps2: List[UInt8] = [250, 255, 7]
  rt.list_swap2(ps1, 0, ps2, 1)
  rt.list_swap2(ps1, 2, ps2, 0)
  let p1want: List[UInt8] = [255, 1, 250]
  let p2want: List[UInt8] = [2, 0, 7]
  for i in 0..3 {
    if ps1[i] != p1want[i] {
      bad += 1
    }
    if ps2[i] != p2want[i] {
      bad += 1
    }
  }
  var ss1: List[Int16] = [-32768, 5]
  var ss2: List[Int16] = [7, -2]
  rt.list_swap2(ss1, 0, ss2, 1)
  if ss1[0] != -2 || ss1[1] != 5 {
    bad += 1
  }
  if ss2[0] != 7 || ss2[1] != -32768 {
    bad += 1
  }
  "${o} ${p} ${ps1[0]} ${ps1[1]} ${ps1[2]} ${ps2[0]} ${ps2[1]} ${ps2[2]} ${ss1[0]} ${ss1[1]} ${ss2[0]} ${ss2[1]} ${bad}"
}

/// LZ4 block compression (decision 0365): std/native/llrt/lz4.xo.
pub fn lz4_compress(src: Bytes) -> Bytes { lz4.compress(src) }

pub fn lz4_decompress(src: Bytes, start: Int, n: Int) -> Bytes? { lz4.decompress(src, start, n) }

/// A swap whose first index a guard proves in range and whose second it
/// does not (test/codegen/intrinsics, 2026-10-26). Both arrive as entry
/// parameters, so neither is known non negative, which proven also asks:
/// two checks remain, where the parent's xo emitted none.
pub fn list_swap_at(xs: List[Int], i: Int, j: Int) {
  if i < xs.len() {
    rt.list_swap(xs, i, j)
  }
}

/// The same swap with both indexes known non negative (lengths) and proven
/// by the guards: no bounds check at all.
pub fn list_swap_both(xs: List[Int], ys: List[Int], zs: List[Int]) {
  let i = ys.len()
  let j = zs.len()
  if i < xs.len() && j < xs.len() {
    rt.list_swap(xs, i, j)
  }
}

/// crypto_op's "rt.list_swap_at": a swap whose first index a branch proves
/// in range and whose second index it does not, the shape that has to keep
/// the second index's bounds check (calls.xo bounds_check, 2026-10-26:
/// reading the index off the operation's own arguments checked j as i and
/// dropped its check). The golden list_swap_guard passes both indexes in
/// one Bytes, even positions summed into i and odd into j; both arrive
/// through a loop, so neither is a constant the compiler can fold away.
/// The mismatches (0).
fn probe_list_swap_at(a: Bytes) -> Int {
  var xs: List[Int] = [1, 2, 3]
  var i = 0
  var j = 0
  var k = 0
  while k < a.len() {
    if k % 2 == 0 {
      i += Int(a[k])
    } else {
      j += Int(a[k])
    }
    k += 1
  }
  if i < xs.len() {
    rt.list_swap(xs, i, j)
    rt.list_swap(xs, i, j)
  }
  var bad = 0
  for w in 0..3 {
    if xs[w] != 1 + w {
      bad += 1
    }
  }
  bad
}

/// crypto_op's "rt.mem_check": libcstr's memcpy, memmove, and memset against
/// byte loops, every size to 130 at source and destination alignments 0
/// to 7 (memcpy, memset) and memmove at every overlap shift from -40 to
/// 40; the mismatches (0 when they agree).
fn probe_mem_check() -> Int {
  // lists for the buffers (not obj.alloc_obj: reached from crypto_op, it
  // would take the heap's lock into every program of std/internal, which
  // the wasm backend does not have)
  var lb = mem_words(128)
  var lw = mem_words(128)
  var lt = mem_words(32)
  let buf = rt.obj_addr(lb).wrapping_add(rt.layout(2))
  let want = rt.obj_addr(lw).wrapping_add(rt.layout(2))
  let tmp = rt.obj_addr(lt).wrapping_add(rt.layout(2))
  var bad = 0
  for n in 0..131 {
    for sa in 0..8 {
      for da in 0..8 {
        mem_pattern(buf, n + sa)
        mem_pattern(want, n + sa)
        let s = buf + sa
        let d = buf + 512 + da
        for i in 0..n {
          rt.mem_store(want + 512 + da, i, rt.mem_load(want + sa, i, 1), 1)
        }
        if libcstr.memcpy(d, s, n) != d {
          bad += 1
        }
        bad += mem_diff(buf, want, 1024)
      }
      mem_pattern(buf, 0)
      mem_pattern(want, 0)
      for i in 0..n {
        rt.mem_store(want + sa, i, 0xa5, 1)
      }
      if libcstr.memset(buf + sa, 0x1a5, n) != buf + sa {
        bad += 1
      }
      bad += mem_diff(buf, want, 1024)
    }
    for shift in -40..41 {
      mem_pattern(buf, 0)
      mem_pattern(want, 0)
      let s = buf + 200
      let d = s + shift
      for i in 0..n {
        rt.mem_store(tmp, i, rt.mem_load(want + 200, i, 1), 1)
      }
      for i in 0..n {
        rt.mem_store(want + 200 + shift, i, rt.mem_load(tmp, i, 1), 1)
      }
      if libcstr.memmove(d, s, n) != d {
        bad += 1
      }
      bad += mem_diff(buf, want, 1024)
    }
  }
  // the lists outlive every access through their addresses
  lb[0] = 0
  lw[0] = 0
  lt[0] = 0
  bad
}

/// n zero words, this function's own list.
fn mem_words(n: Int) -> List[Int] {
  var l: List[Int] = List.with_capacity(n)
  for _ in 0..n {
    l.push(0)
  }
  l
}

/// The 1024 bytes at p set to a pattern (byte i: 7 i + 3 mod 251).
fn mem_pattern(p: Int, _n: Int) {
  for i in 0..1024 {
    rt.mem_store(p, i, (7 * i + 3) % 251, 1)
  }
}

/// The bytes of the n at a and b that differ.
fn mem_diff(a: Int, b: Int, n: Int) -> Int {
  var k = 0
  for i in 0..n {
    if rt.mem_load(a, i, 1) != rt.mem_load(b, i, 1) {
      k += 1
    }
  }
  k
}

fn probe_fill(p: Int, n: Int, t: Int) {
  let full = n.min(4096)
  for i in 0..full {
    rt.mem_store(p, i, probe_pat(t, i), 1)
  }
  var i = 4096
  while i < n {
    rt.mem_store(p, i, probe_pat(t, i), 1)
    i += 4096
  }
  if n > 0 {
    rt.mem_store(p, n - 1, probe_pat(t, n - 1), 1)
  }
}

fn probe_check(p: Int, n: Int, m: Int, t: Int) -> Bool {
  let full = n.min(4096)
  for i in 0..full {
    if rt.mem_load(p, i, 1) != probe_pat(t, i) {
      return false
    }
  }
  var i = 4096
  while i < n {
    if rt.mem_load(p, i, 1) != probe_pat(t, i) {
      return false
    }
    i += 4096
  }
  !(n > 0 && n == m && rt.mem_load(p, n - 1, 1) != probe_pat(t, n - 1))
}

/// The frame address of a function rt_op calls.
fn frame_below() -> Int { rt.frame_addr() }

fn crypto_op(op: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes {
  let area = op.split(".")[0]
  let what = op.trim_prefix("${area}.")
  let r = match area {
    "hash" => sha256.op(what, a, b, c, d)
    "hmac" => hmac.op(what, a, b, c, d)
    "hkdf" => hkdf.op(what, a, b, c, d)
    "p256" => nistec.op(nistec.P256, what, a, b, c, d)
    "p384" => nistec.op(nistec.P384, what, a, b, c, d)
    "p521" => nistec.op(nistec.P521, what, a, b, c, d)
    "p224" => nistec.op(nistec.P224, what, a, b, c, d)
    "rsa" => rsa.op(what, a, b, c, d)
    "x509" => x509.op(what, a, b, c, d)
    "aes" => aesgcm.op(what, a, b, c, d)
    "chacha" => chacha.op(what, a, b, c, d)
    "chain" => x509verify.op(what, a, b, c, d)
    "x25519" => x25519.op(what, a, b, c, d)
    "tls13" => tls13.op(what, a, b, c, d)
    "sha1" => sha1.op(what, a, b, c, d)
    "cpu" => cpu.op(what, a, b, c, d)
    "sysc" => sysc_op(what, a)
    "rt" => rt_op(what, a)
    "tls12" => if what == "server" { tls12srv.op(what, a, b, c, d) } else { tls12.op(what, a, b, c, d) }
    "tls13srv" => tls13srv.op(what, a, b, c, d)
    "sha3" => sha3.op(what, a, b, c, d)
    "mlkem" => mlkem.op(what, a, b, c, d)
    _ => None
  }
  r ?? fault("internal.crypto_op: unknown op ${op}")
}

// std/uuid's text (decision 0282; 2026-10-26: bytes() and from_bytes ran at
// 7.1x google/uuid's time a character at a time through a builder): the
// canonical text written and read with stores and loads into one buffer.

/// The lowercase hex digits, by value.
const UHEX: Bytes = b"0123456789abcdef"

/// The value of each byte as a hex digit, 0xff for none (google/uuid's
/// xvalues): one load a digit (a call each ran uuid_decode at 42 ns).
const UHEXVAL: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\xff\xff\xff\xff\xff\xff\xff\x0a\x0b\x0c\x0d\x0e\x0f\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x0a\x0b\x0c\x0d\x0e\x0f\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

/// The canonical text of the 16 bytes b, xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
/// (google/uuid's encodeHex); "" when b is not 16 bytes.
pub fn uuid_text(b: Bytes) -> Str {
  if b.len() != 16 {
    return ""
  }
  let out = raw.bytes_buf(36)
  let d = raw.bytes_addr(out)
  let s = raw.bytes_addr(b)
  let h = raw.bytes_addr(UHEX)
  var o = 0
  for i in 0..16 {
    if i == 4 || i == 6 || i == 8 || i == 10 {
      rt.mem_store(d, o, 45, 1)
      o += 1
    }
    let x = rt.mem_load(s, i, 1)
    rt.mem_store(d, o, rt.mem_load(h, x >> 4, 1), 1)
    rt.mem_store(d, o + 1, rt.mem_load(h, x & 15, 1), 1)
    o += 2
  }
  rt.cast[Bytes, Str](raw.bytes_len(out, 36))
}

/// The 16 bytes of a UUID's text in s from off: 36 characters with dashes
/// after the 8th, 12th, 16th and 20th digit (dashed), else 32 hex digits;
/// None when a dash or a digit is not where it should be, or s is short.
pub fn uuid_decode(s: Bytes, off: Int, dashed: Bool) -> Bytes? {
  let n = if dashed { 36 } else { 32 }
  if off < 0 || s.len() - off < n {
    return None
  }
  let a = raw.bytes_addr(s) + off
  if dashed && (rt.mem_load(a, 8, 1) != 45 || rt.mem_load(a, 13, 1) != 45 || rt.mem_load(a, 18, 1) != 45 || rt.mem_load(a, 23, 1) != 45) {
    return None
  }
  let out = raw.bytes_buf(16)
  let d = raw.bytes_addr(out)
  let t = raw.bytes_addr(UHEXVAL)
  var bad = 0
  var k = 0
  for i in 0..16 {
    if dashed && (i == 4 || i == 6 || i == 8 || i == 10) {
      k += 1
    }
    let hi = rt.mem_load(t, rt.mem_load(a, k, 1), 1)
    let lo = rt.mem_load(t, rt.mem_load(a, k + 1, 1), 1)
    // 0xff marks a non digit: one test after the loop
    bad = bad | hi | lo
    rt.mem_store(d, i, (hi << 4) | lo, 1)
    k += 2
  }
  if bad > 15 {
    return None
  }
  Some(raw.bytes_len(out, 16))
}
