// std/archive on the native backends (decisions 0164 and 0172): Go's
// compress/gzip, archive/tar, and archive/zip ported to Xo over
// std/native/llrt/flate.xo (compress/flate and hash/crc32, shared with
// std/compress since decision 0305),
// as far as std/rt archive.go uses them, so the bytes written and the
// errors read are the Go backend's, including PAX sparse tar files and
// zip64 archives (2026-10-21, std/native/archive_test.xo). Not ported:
// reading tar archives in the old V7 and STAR formats beyond their
// common fields.
use std/archive
use native/llrt/flate
use native/llrt/raw
use native/llrt/scan
use native/rt

// ---------------------------------------------------------------------------
// Bytes

fn byte_of(b: Bytes, i: Int) -> Int { Int(b[i]) }

/// strconv.Quote of bytes: \xNN for each byte of an invalid sequence
/// (url.xo's go_q).
fn go_q(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s.quote()
  }
  var out = StrBuilder.new()
  out.write("\"")
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if r == '\u{FFFD}' && n == 1 {
      let h = "0123456789abcdef"
      let v = Int(b[i])
      out.write("\\x" + h[v >> 4..(v >> 4) + 1] + h[v & 15..(v & 15) + 1])
    } else {
      let q = b[i..i + n].to_str().or_fault("rune").quote()
      out.write(q[1..q.len() - 1])
    }
    i += n
  }
  out.write("\"")
  out.freeze()
}

fn bytes_of(l: List[Int]) -> Bytes {
  var b = BytesBuilder.with_capacity(l.len())
  for x in l {
    b.write_byte(UInt8(x & 255))
  }
  b.freeze()
}

fn sub(b: Bytes, lo: Int, hi: Int) -> Bytes { b[lo..hi] }

fn put_u16(var b: BytesBuilder, v: Int) {
  b.write_byte(UInt8(v & 255))
  b.write_byte(UInt8((v >> 8) & 255))
}

fn put_u32(var b: BytesBuilder, v: Int) {
  put_u16(b, v & 65535)
  put_u16(b, (v >> 16) & 65535)
}

fn put_u64(var b: BytesBuilder, v: Int) {
  put_u32(b, v & 0xffffffff)
  put_u32(b, (v >> 32) & 0xffffffff)
}

fn get_u16(b: Bytes, i: Int) -> Int { byte_of(b, i) | (byte_of(b, i + 1) << 8) }

fn get_u32(b: Bytes, i: Int) -> Int { get_u16(b, i) | (get_u16(b, i + 2) << 16) }

/// A little endian uint64 (one at or above 2^63 is negative: callers
/// refuse it, as Go's checks against maxInt64 do).
/// The 64 bits as an Int (Go's int64(uint64): the top bit is the sign).
fn get_u64(b: Bytes, i: Int) -> Int { get_u32(b, i) | get_u32(b, i + 4).wrapping_shl(32) }

/// A list of n zeros in one allocation (decision 0207 stage 2).
fn zeros(n: Int) -> List[Int] { raw.zero_ints(n) }

// ---------------------------------------------------------------------------
// gzip (compress/gzip): no name, no time, default level; gunzip reads
// concatenated members

fn archive_err(msg: Str) -> archive.ArchiveErr { archive.ArchiveErr{msg: msg} }

fn archiveerr_display(e: archive.ArchiveErr) -> Str { "archive: ${e.msg}" }

fn gzip(data: Bytes) -> Bytes {
  var b = BytesBuilder.new()
  b.write(b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff")
  b.write(flate.deflate_bytes(data, 6))
  let t = flate.crc_table()
  put_u32(b, flate.crc32(t, 0, data))
  put_u32(b, data.len() & 0xffffffff)
  b.freeze()
}

fn gunzip(data: Bytes, max_size: Int) -> Bytes ! archive.ArchiveErr {
  // the limit max_size + 1, as std/compress's gunzip (Go's LimitReader)
  let max = if max_size < 0 { 0 } else { max_size }
  let too_big = archive_err("gunzip: gzip: output exceeds max_size (${max} bytes)")
  match flate.gunzip_members(data, max + 1) {
    Ok(out) => {
      if out.len() > max {
        return Err(too_big)
      }
      out
    }
    Err(e) => {
      if e == flate.LIMIT {
        return Err(too_big)
      }
      Err(archive_err("gunzip: ${e}"))
    }
  }
}

// ---------------------------------------------------------------------------
// Entries and paths (std/rt archive.go)

fn file(path: Str, data: Bytes) -> archive.Entry { archive.Entry{path: path, data: data, mode: 0o644, is_dir: false, modified: Time.UNIX_EPOCH} }

fn dir(path: Str) -> archive.Entry { archive.Entry{path: path, data: b"", mode: 0o755, is_dir: true, modified: Time.UNIX_EPOCH} }

/// path.Clean.
fn clean_path(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let rooted = p.starts_with("/")
  var parts: List[Str] = []
  for seg in p.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    if seg == ".." {
      if parts.len() > 0 && parts[parts.len() - 1] != ".." {
        match parts.pop() {
          _ => ()
        }
      } else if !rooted {
        parts.push("..")
      }
      continue
    }
    parts.push(seg)
  }
  let body = parts.join("/")
  if rooted {
    return "/" + body
  }
  if body == "" {
    return "."
  }
  body
}

/// archivePath: the cleaned path, or None for a path that is empty,
/// absolute, or leaves the root.
fn archive_path(p0: Str) -> Str? {
  let p = p0.replace("\\", "/")
  if p == "" || p.contains("\u{0}") || p.starts_with("/") || (p.len() >= 2 && byte_of(p.bytes(), 1) == 58) {
    return None
  }
  let clean = clean_path(p)
  if clean == ".." || clean.starts_with("../") || clean == "." {
    return None
  }
  Some(clean)
}

/// Why archive_path refused a name, for a reader's error: a NUL byte is its
/// own reason (the name is not a path at all), the rest leave the archive.
fn path_why(p: Str) -> Str {
  if p.contains("\u{0}") {
    return "contains a NUL byte"
  }
  "leaves the archive"
}

fn floor_div(a: Int, b: Int) -> Int {
  if a >= 0 {
    return a / b
  }
  0 - ((0 - a + b - 1) / b)
}

// ---------------------------------------------------------------------------
// tar (archive/tar): USTAR headers, PAX when a path or time needs one

fn is_ascii(s: Str) -> Bool {
  let b = s.bytes()
  var i = 0
  while i < b.len() {
    if byte_of(b, i) >= 0x80 {
      return false
    }
    i += 1
  }
  true
}

fn to_ascii(s: Str) -> Str {
  if is_ascii(s) {
    return s
  }
  var b = BytesBuilder.new()
  for r in s.runes() {
    let c = Int(r)
    if c < 0x80 && c != 0 {
      b.write_byte(UInt8(c))
    }
  }
  b.freeze().to_str() ?? ""
}

fn octal(x: Int) -> Str {
  if x == 0 {
    return "0"
  }
  var s = ""
  var v = x
  while v > 0 {
    s = "${v % 8}" + s
    v = v / 8
  }
  s
}

fn fits_octal(n: Int, x: Int) -> Bool { x >= 0 && (n >= 22 || x < (1 << ((n - 1) * 3))) }

/// formatString into blk[at:at+n].
fn fmt_str(var blk: List[Int], at: Int, n: Int, s: Str) {
  let b = s.bytes()
  var i = 0
  while i < n && i < b.len() {
    blk[at + i] = byte_of(b, i)
    i += 1
  }
  if b.len() < n {
    blk[at + b.len()] = 0
  }
  if b.len() > n && blk[at + n - 1] == 47 {
    var k = n - 1
    while k > 0 && byte_of(b, k - 1) == 47 {
      k -= 1
    }
    blk[at + k] = 0
  }
}

/// formatOctal into blk[at:at+n].
fn fmt_oct(var blk: List[Int], at: Int, n: Int, x0: Int) {
  var x = x0
  if !fits_octal(n, x) {
    x = 0
  }
  var s = octal(x)
  let pad = n - s.len() - 1
  if pad > 0 {
    s = "0".repeat(pad) + s
  }
  fmt_str(blk, at, n, s)
}

/// setFormat(USTAR | PAX): the magic and the checksum.
fn set_ustar(var blk: List[Int]) {
  let magic = [0x75, 0x73, 0x74, 0x61, 0x72, 0, 0x30, 0x30]
  var i = 0
  while i < 8 {
    blk[257 + i] = magic[i]
    i += 1
  }
  var sum = 0
  i = 0
  while i < 512 {
    if i >= 148 && i < 156 {
      sum += 32
    } else {
      sum += blk[i]
    }
    i += 1
  }
  fmt_oct(blk, 148, 7, sum)
  blk[155] = 32
}

/// templateV7Plus of a header.
fn tar_template(name: Str, mode: Int, size: Int, mtime: Int, flag: Int) -> List[Int] {
  var blk = zeros(512)
  blk[156] = flag
  fmt_str(blk, 0, 100, name)
  fmt_str(blk, 157, 100, "")
  fmt_oct(blk, 100, 8, mode)
  fmt_oct(blk, 108, 8, 0)
  fmt_oct(blk, 116, 8, 0)
  fmt_oct(blk, 124, 12, size)
  fmt_oct(blk, 136, 12, mtime)
  fmt_str(blk, 265, 32, "")
  fmt_str(blk, 297, 32, "")
  fmt_oct(blk, 329, 8, 0)
  fmt_oct(blk, 337, 8, 0)
  blk
}

/// splitUSTARPath: the prefix and the name, or None.
fn split_ustar(name: Str) -> (Str, Str)? {
  var length = name.len()
  if length <= 100 || !is_ascii(name) {
    return None
  }
  if length > 156 {
    length = 156
  } else if byte_of(name.bytes(), length - 1) == 47 {
    length -= 1
  }
  var i = length - 1
  while i >= 0 && byte_of(name.bytes(), i) != 47 {
    i -= 1
  }
  let nlen = name.len() - i - 1
  if i <= 0 || nlen > 100 || nlen == 0 || i > 155 {
    return None
  }
  Some((name[0..i], name[i + 1..]))
}

/// formatPAXTime of Unix nanoseconds.
fn pax_time(ns: Int) -> Str {
  var secs = floor_div(ns, 1000000000)
  var nsecs = ns - secs * 1000000000
  if nsecs == 0 {
    return "${secs}"
  }
  var sign = ""
  if secs < 0 {
    sign = "-"
    secs = 0 - (secs + 1)
    nsecs = 0 - (nsecs - 1000000000)
  }
  var frac = "${nsecs}"
  while frac.len() < 9 {
    frac = "0" + frac
  }
  var s = "${sign}${secs}.${frac}"
  while s.ends_with("0") {
    s = s[0..s.len() - 1]
  }
  s
}

fn pax_record(k: Str, v: Str) -> Str {
  var size = k.len() + v.len() + 3
  size += "${size}".len()
  var rec = "${size} ${k}=${v}\n"
  if rec.len() != size {
    size = rec.len()
    rec = "${size} ${k}=${v}\n"
  }
  rec
}

fn pad_block(var out: BytesBuilder, size: Int) {
  let pad = (512 - size % 512) % 512
  var i = 0
  while i < pad {
    out.write_byte(UInt8(0))
    i += 1
  }
}

/// path.Split then path.Join(dir, "PaxHeaders.0", file).
fn pax_name(real: Str) -> Str {
  var i = real.len() - 1
  while i >= 0 && byte_of(real.bytes(), i) != 47 {
    i -= 1
  }
  let d = real[0..i + 1]
  let f = real[i + 1..]
  var parts: List[Str] = []
  if d != "" {
    parts.push(d)
  }
  parts.push("PaxHeaders.0")
  if f != "" {
    parts.push(f)
  }
  clean_path(parts.join("/"))
}

/// The header block (and a PAX header before it when USTAR cannot hold
/// the name or the time) Go's tar.Writer writes for an entry
/// (Archive_tar's Header, FormatPAX).
fn tar_header(var out: BytesBuilder, p: Str, mode0: Int, size0: Int, is_dir: Bool, modified: Time) {
  var name = p
  var flag = 48
  var size = size0
  if is_dir {
    name = p + "/"
    flag = 53
    size = 0
  }
  let mode = mode0 & 0o7777
  let ns = (modified - Time.UNIX_EPOCH).nanos()
  let secs = floor_div(ns, 1000000000)
  var mtime_rec = ""
  var path_rec = ""
  var ustar = true
  if !is_ascii(name) || name.len() > 100 {
    if split_ustar(name).is_none() {
      ustar = false
    }
    path_rec = name
  }
  let fits = fits_octal(12, secs)
  if !fits || ns - secs * 1000000000 != 0 {
    // PAX is preferred: USTAR would lose the time
    ustar = false
    mtime_rec = pax_time(ns)
  }
  if ustar {
    var prefix = ""
    var short = name
    match split_ustar(name) {
      Some((a, b)) => {
        prefix = a
        short = b
      }
      None => ()
    }
    var blk = tar_template(short, mode, size, secs, flag)
    fmt_str(blk, 345, 155, prefix)
    set_ustar(blk)
    out.write(bytes_of(blk))
  } else {
    if path_rec != "" || mtime_rec != "" {
      // the records sorted by key
      var data = ""
      if mtime_rec != "" {
        data = data + pax_record("mtime", mtime_rec)
      }
      if path_rec != "" {
        data = data + pax_record("path", path_rec)
      }
      var pname = to_ascii(pax_name(name))
      if pname.len() > 100 {
        pname = pname[0..100]
      }
      while pname.ends_with("/") {
        pname = pname[0..pname.len() - 1]
      }
      var hb = zeros(512)
      hb[156] = 120
      fmt_str(hb, 0, 100, pname)
      fmt_oct(hb, 100, 8, 0)
      fmt_oct(hb, 108, 8, 0)
      fmt_oct(hb, 116, 8, 0)
      fmt_oct(hb, 124, 12, data.len())
      fmt_oct(hb, 136, 12, 0)
      set_ustar(hb)
      out.write(bytes_of(hb))
      out.write(data.bytes())
      pad_block(out, data.len())
    }
    var blk = tar_template(to_ascii(name), mode, size, secs, flag)
    set_ustar(blk)
    out.write(bytes_of(blk))
  }
}

fn tar(entries: List[archive.Entry]) -> Bytes ! archive.ArchiveErr {
  var out = BytesBuilder.new()
  for e in entries {
    let p = match archive_path(e.path) {
      Some(x) => x
      None => return Err(archive_err("bad entry path ${e.path.quote()}"))
    }
    tar_header(out, p, e.mode, e.data.len(), e.is_dir, e.modified)
    if !e.is_dir {
      out.write(e.data)
      pad_block(out, e.data.len())
    }
  }
  // two zero blocks end the archive
  out.write(bytes_of(zeros(1024)))
  out.freeze()
}

/// A tar archive written entry by entry to a File (Go's tar.Writer).
struct TarWriter {
  f: File
  /// bytes the current entry still needs, and its padding
  left: Int
  pad: Int
  done: Bool
}

fn tar_writer(f: File) -> TarWriter { TarWriter{f: f, left: 0, pad: 0, done: false} }

fn tw_err(msg: Str) -> archive.ArchiveErr { archive_err("tar_writer: ${msg}") }

fn (var w: TarWriter) put(b: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  match w.f.write(b) {
    Ok(_) => Ok(())
    Err(e) => Err(tw_err(e.display()))
  }
}

fn (var w: TarWriter) flush() -> () ! archive.ArchiveErr uses fs.write {
  if w.done {
    return Err(tw_err("archive/tar: write after close"))
  }
  if w.left > 0 {
    return Err(tw_err("archive/tar: missed writing ${w.left} bytes"))
  }
  if w.pad > 0 {
    w.put(bytes_of(zeros(w.pad)))?
    w.pad = 0
  }
  Ok(())
}

fn (var w: TarWriter) start(path: Str, mode: Int, size: Int, is_dir: Bool, modified: Time) -> () ! archive.ArchiveErr uses fs.write {
  w.flush()?
  let p = match archive_path(path) {
    Some(x) => x
    None => return Err(archive_err("bad entry path ${path.quote()}"))
  }
  if size < 0 {
    return Err(tw_err("archive/tar: negative size"))
  }
  var out = BytesBuilder.new()
  tar_header(out, p, mode, size, is_dir, modified)
  w.put(out.freeze())?
  if !is_dir {
    w.left = size
    w.pad = (512 - size % 512) % 512
  }
  Ok(())
}

fn (var w: TarWriter) add(e: archive.Entry) -> () ! archive.ArchiveErr uses fs.write {
  w.start(e.path, e.mode, e.data.len(), e.is_dir, e.modified)?
  if !e.is_dir {
    w.write(e.data)?
  }
  Ok(())
}

fn (var w: TarWriter) create(path: Str, size: Int, mode: Int, modified: Time) -> () ! archive.ArchiveErr uses fs.write {
  w.start(path, mode, size, false, modified)
}

fn (var w: TarWriter) write(data: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  if w.done {
    return Err(tw_err("archive/tar: write after close"))
  }
  if data.len() > w.left {
    // the part that fits is written (regFileWriter.Write)
    let part = data[0..w.left]
    w.left = 0
    w.put(part)?
    return Err(tw_err("archive/tar: write too long"))
  }
  w.left -= data.len()
  w.put(data)
}

/// Writer.AddFS: src.walk(".") with each entry's mode, a file copied in
/// 64 KiB reads (the size walk gave is the header's: a file that changed
/// meanwhile is write too long or missed bytes, as io.Copy into Go's
/// writer). A link is Go's non-regular file error.
fn (var w: TarWriter) add_fs(src: Fs) -> () ! archive.ArchiveErr uses fs {
  let list = match src.walk(".") {
    Ok(l) => l
    Err(e) => return Err(tw_err(e.display()))
  }
  for fi in list {
    if fi.is_symlink {
      return Err(tw_err("tar: cannot add non-regular file ${fi.path.quote()}"))
    }
    let mode = match src.mode(fi.path) {
      Ok(m) => m
      Err(e) => return Err(tw_err(e.display()))
    }
    if fi.is_dir {
      w.start(fi.path, mode, 0, true, fi.modified)?
      continue
    }
    w.start(fi.path, mode, fi.size, false, fi.modified)?
    let inp = match src.open(fi.path) {
      Ok(f) => f
      Err(e) => return Err(tw_err(e.display()))
    }
    let r = w.copy_from(inp)
    let cl = inp.close()
    r?
    if let Err(e) = cl {
      return Err(tw_err(e.display()))
    }
  }
  Ok(())
}

fn (var w: TarWriter) copy_from(inp: File) -> () ! archive.ArchiveErr uses fs {
  while {
    match inp.read(65536) {
      Ok(Some(b)) => w.write(b)?
      Ok(None) => return Ok(())
      Err(e) => return Err(tw_err(e.display()))
    }
  }
}

fn (var w: TarWriter) close() -> () ! archive.ArchiveErr uses fs.write {
  if w.done {
    return Ok(())
  }
  let r = w.flush()
  w.done = true
  r?
  w.put(bytes_of(zeros(1024)))
}

/// raw_cstr: parse_cstr's field as its bytes, for error messages, which
/// quote a name as Go does (\xNN for a byte outside UTF-8; std/rt and
/// unzip's go_q) while the entry's path is outside text (decision 0259).
fn raw_cstr(b: Bytes, at: Int, n: Int) -> Bytes {
  var i = 0
  while i < n && byte_of(b, at + i) != 0 {
    i += 1
  }
  sub(b, at, at + i)
}

fn parse_cstr(b: Bytes, at: Int, n: Int) -> Str {
  var i = 0
  while i < n && byte_of(b, at + i) != 0 {
    i += 1
  }
  // a name from the archive: outside bytes (decision 0259)
  scan.text_of(sub(b, at, at + i))
}

/// parseNumeric: the value, or None (ErrHeader).
fn parse_numeric(b: Bytes, at: Int, n: Int) -> Int? {
  let c0 = byte_of(b, at)
  if (c0 & 0x80) != 0 {
    let inv = if (c0 & 0x40) != 0 { 0xff } else { 0 }
    var x = 0
    var i = 0
    while i < n {
      var c = byte_of(b, at + i) ^ inv
      if i == 0 {
        c = c & 0x7f
      }
      if (x >> 55) > 0 {
        return None
      }
      x = (x << 8) | c
      i += 1
    }
    if inv == 0xff {
      return Some(0 - 1 - x)
    }
    return Some(x)
  }
  // octal: trimmed of spaces and NULs, up to a NUL
  var lo = at
  var hi = at + n
  while lo < hi && (byte_of(b, lo) == 32 || byte_of(b, lo) == 0) {
    lo += 1
  }
  while hi > lo && (byte_of(b, hi - 1) == 32 || byte_of(b, hi - 1) == 0) {
    hi -= 1
  }
  if lo == hi {
    return Some(0)
  }
  var k = lo
  while k < hi && byte_of(b, k) != 0 {
    k += 1
  }
  if k == lo {
    return None
  }
  var x = 0
  var i = lo
  while i < k {
    let c = byte_of(b, i)
    if c < 48 || c > 55 || x > 1152921504606846975 {
      return None
    }
    x = x * 8 + (c - 48)
    i += 1
  }
  Some(x)
}

fn is_zero_block(b: Bytes, at: Int) -> Bool {
  var i = 0
  while i < 512 {
    if byte_of(b, at + i) != 0 {
      return false
    }
    i += 1
  }
  true
}

const ERR_HEADER: Str = "untar: archive/tar: invalid tar header"

/// parsePAXTime: Unix nanoseconds, or None.
fn parse_pax_time(s: Str) -> Int? {
  var ss = s
  var sn = ""
  match s.find(".") {
    Some(i) => {
      ss = s[0..i]
      sn = s[i + 1..]
    }
    None => ()
  }
  let secs = match Int.parse(ss) {
    Some(v) => v
    None => return None
  }
  if sn == "" {
    return Some(secs.wrapping_mul(1000000000))
  }
  var nanos = 0
  var i = 0
  let sb = sn.bytes()
  while i < sb.len() {
    let c = byte_of(sb, i)
    if c < 48 || c > 57 {
      return None
    }
    if i < 9 {
      nanos = nanos * 10 + (c - 48)
    }
    i += 1
  }
  while i < 9 {
    nanos = nanos * 10
    i += 1
  }
  if ss.starts_with("-") {
    return Some(secs.wrapping_mul(1000000000).wrapping_sub(nanos))
  }
  Some(secs.wrapping_mul(1000000000).wrapping_add(nanos))
}

/// parsePAX of the records: the map, or None (ErrHeader).
fn parse_pax(text: Bytes) -> Map[Str, Str]? {
  var m: Map[Str, Str] = {}
  // GNU sparse format 0.0's repeated offset and numbytes records, joined
  // into a 0.1 map (parsePAX)
  var sparse: List[Str] = []
  var s = rt.cast[Bytes, Str](text)
  while s.len() > 0 {
    let sp = match s.find(" ") {
      Some(i) => i
      None => return None
    }
    let n = match Int.parse(s[0..sp]) {
      Some(v) => v
      None => return None
    }
    if n < 5 || n > s.len() {
      return None
    }
    let rest_n = n - (sp + 1)
    if rest_n <= 0 {
      return None
    }
    let rest = s[sp + 1..]
    let rec = rest[0..rest_n - 1]
    if rest.bytes()[rest_n - 1] != 10 {
      return None
    }
    let eq = match rec.find("=") {
      Some(i) => i
      None => return None
    }
    let k = rec[0..eq]
    let v = rec[eq + 1..]
    // validPAXRecord: a NUL is refused in the value of path, linkpath,
    // uname, and gname, and in any other record's key
    if k == "" {
      return None
    }
    if k == "path" || k == "linkpath" || k == "uname" || k == "gname" {
      if v.contains("\u{0}") {
        return None
      }
    } else if k.contains("\u{0}") {
      return None
    }
    if k == "GNU.sparse.offset" || k == "GNU.sparse.numbytes" {
      if (sparse.len() % 2 == 0) != (k == "GNU.sparse.offset") || v.contains(",") {
        return None
      }
      sparse.push(scan.text(v))
    } else {
      // keys and values from the archive: outside bytes (decision 0259);
      // the records are parsed on the raw bytes (their lengths count bytes)
      m.put(scan.text(k), scan.text(v))
      // the raw value under a key no archive can hold (a NUL in a key is
      // refused above), for error messages
      if k == "path" || k == "GNU.sparse.name" {
        m.put("\u{0}" + scan.text(k), v)
      }
    }
    s = rest[rest_n..]
  }
  if sparse.len() > 0 {
    m.put("GNU.sparse.map", sparse.join(","))
  }
  Some(m)
}

/// strconv.ParseInt(s, 10, 64) for the sparse maps' numbers.
fn sparse_int(s: Str) -> Int? {
  if s.is_empty() {
    return None
  }
  Int.parse(s)
}

/// readGNUSparsePAXHeaders, readGNUSparseMap1x0 and 0x1,
/// validateSparseEntries, and the sparse reader: None when the records
/// describe no sparse file, else its name ("" to keep the header's) and
/// its logical data made from the physical data phys.
/// The zero bytes a sparse file's holes may add to an archive's entries in
/// all (std/compress's max_size default): Go reads a sparse file lazily,
/// untar returns it whole, so a few KB of headers could declare terabytes.
const SPARSE_HOLES_MAX: Int = 1073741824

fn sparse_pax(records: Map[Str, Str], phys: Bytes, holes_left: Int) -> (Str, Bytes)? ! Str {
  let major = records.get("GNU.sparse.major") ?? ""
  let minor = records.get("GNU.sparse.minor") ?? ""
  var is1x0 = false
  if major == "0" && (minor == "0" || minor == "1") {
    is1x0 = false
  } else if major == "1" && minor == "0" {
    is1x0 = true
  } else if major != "" || minor != "" {
    return None
  } else if (records.get("GNU.sparse.map") ?? "") != "" {
    is1x0 = false
  } else {
    return None
  }
  let name = records.get("GNU.sparse.name") ?? ""
  var size = phys.len()
  var size_text = records.get("GNU.sparse.size") ?? ""
  if size_text == "" {
    size_text = records.get("GNU.sparse.realsize") ?? ""
  }
  if size_text != "" {
    size = match sparse_int(size_text) {
      Some(v) => v
      None => return Err(ERR_HEADER)
    }
  }
  var spd: List[Int] = []
  var data_at = 0
  if is1x0 {
    // the map in the data's first blocks: a count, then offset and
    // length, each on its own line
    var lines: List[Str] = []
    var line = BytesBuilder.new()
    var want = 1
    var read = 0
    var count = -1
    while lines.len() < want {
      if read + 512 > 1048576 {
        return Err("untar: archive/tar: sparse map too long")
      }
      if phys.len() - read < 512 {
        return Err("untar: unexpected EOF")
      }
      for b in phys[read..read + 512] {
        if b == 10 {
          lines.push(line.freeze().to_str() ?? "")
          line = BytesBuilder.new()
        } else {
          line.write_byte(b)
        }
      }
      read += 512
      if count < 0 && lines.len() >= 1 {
        count = match sparse_int(lines[0]) {
          Some(v) => v
          None => return Err(ERR_HEADER)
        }
        if count < 0 {
          return Err(ERR_HEADER)
        }
        want = 1 + 2 * count
      }
    }
    var i = 0
    while i < count {
      let off = sparse_int(lines[1 + 2 * i])
      let len = sparse_int(lines[2 + 2 * i])
      if off.is_none() || len.is_none() {
        return Err(ERR_HEADER)
      }
      spd.push(off ?? 0)
      spd.push(len ?? 0)
      i += 1
    }
    data_at = read
  } else {
    let count = match sparse_int(records.get("GNU.sparse.numblocks") ?? "") {
      Some(v) => v
      None => return Err(ERR_HEADER)
    }
    if count < 0 {
      return Err(ERR_HEADER)
    }
    let m = records.get("GNU.sparse.map") ?? ""
    let parts = if m == "" { [] } else { m.split(",") }
    if parts.len() != 2 * count {
      return Err(ERR_HEADER)
    }
    for x in parts {
      spd.push(match sparse_int(x) {
        Some(v) => v
        None => return Err(ERR_HEADER)
      })
    }
  }
  // validateSparseEntries
  if size < 0 {
    return Err(ERR_HEADER)
  }
  var pre_end = 0
  var k = 0
  while k < spd.len() {
    let off = spd[k]
    let len = spd[k + 1]
    if off < 0 || len < 0 || off > Int.max - len || off + len > size || pre_end > off {
      return Err(ERR_HEADER)
    }
    pre_end = off + len
    k += 2
  }
  // the logical data: the fragments from the physical data in order,
  // zeros between them; the zeros are at least size less the physical
  // data, which the archive's budget bounds
  if size - phys.len() > holes_left {
    return Err("untar: archive/tar: sparse files expand past 1 GiB")
  }
  let zeros = Bytes.zeroed(65536)
  var out = BytesBuilder.with_capacity(size)
  var at = 0
  var src = data_at
  k = 0
  while k < spd.len() {
    let off = spd[k]
    let len = spd[k + 1]
    k += 2
    if len == 0 {
      continue
    }
    while at < off {
      let z = if off - at < 65536 { off - at } else { 65536 }
      out.write(zeros[0..z])
      at += z
    }
    if phys.len() - src < len {
      return Err("untar: archive/tar: sparse file references non-existent data")
    }
    out.write(phys[src..src + len])
    src += len
    at += len
  }
  if src < phys.len() {
    return Err("untar: archive/tar: sparse file contains unreferenced data")
  }
  while at < size {
    let z = if size - at < 65536 { size - at } else { 65536 }
    out.write(zeros[0..z])
    at += z
  }
  Some((name, out.freeze()))
}

fn untar(data: Bytes) -> List[archive.Entry] ! archive.ArchiveErr {
  match untar_entries(data) {
    Ok(l) => l
    Err(e) => Err(archive_err(e))
  }
}

fn untar_entries(data: Bytes) -> List[archive.Entry] ! Str {
  let n = data.len()
  var pos = 0
  var out: List[archive.Entry] = []
  var st = UntarState{pax: {}, long_name: "", holes_left: SPARSE_HOLES_MAX}
  while true {
    match untar_step(data, pos, st, true)? {
      TarStep.Need(_) => return Err("untar: unexpected EOF")
      TarStep.End => break
      TarStep.Head(h) => {
        st = h.st
        var e = h.e
        pos = h.at
        if !e.is_dir && !h.sparse {
          if n - pos < h.nb {
            return Err("untar: unexpected EOF")
          }
          e.data = sub(data, pos, pos + h.nb)
        }
        out.push(e)
        pos += h.nb
        let pad = (512 - h.nb % 512) % 512
        if n - pos < pad {
          // a short padding ends the archive (tryReadFull's io.EOF)
          break
        }
        pos += pad
      }
    }
  }
  out
}

/// What untar carries from one header to the next: the PAX records and
/// GNU long name for the next entry, and the sparse expansion budget.
struct UntarState {
  pax: Map[Str, Str]
  long_name: Str
  /// long_name's bytes, for error messages
  long_raw: Bytes = b""
  holes_left: Int
}

/// A file or directory header read by untar_step: the entry (its data
/// empty unless the file is sparse, whose logical data is read whole),
/// where its data starts, its size in the archive, and the state after it.
struct TarHead {
  e: archive.Entry
  at: Int
  nb: Int
  sparse: Bool
  st: UntarState
}

enum TarStep {
  /// more input: data[pos..pos + n] is needed (only when not at EOF)
  Need(n: Int)
  End
  Head(h: TarHead)
}

/// Whether PAX records describe a GNU sparse file (sparse_pax's test).
fn is_sparse(records: Map[Str, Str]) -> Bool {
  let major = records.get("GNU.sparse.major") ?? ""
  let minor = records.get("GNU.sparse.minor") ?? ""
  if major == "0" && (minor == "0" || minor == "1") {
    return true
  }
  if major == "1" && minor == "0" {
    return true
  }
  if major != "" || minor != "" {
    return false
  }
  (records.get("GNU.sparse.map") ?? "") != ""
}

/// Reads from data[pos0..] the headers up to the next file or directory
/// (Go's Reader.Next with untar's checks). The input may stop short of the
/// archive's end when eof is false: where a step needs bytes past it, it
/// returns Need, and the caller runs it again from pos0 with more.
fn untar_step(data: Bytes, pos0: Int, st0: UntarState, eof: Bool) -> TarStep ! Str {
  let n = data.len()
  var pos = pos0
  var pax = st0.pax
  var long_name = st0.long_name
  var long_raw = st0.long_raw
  var holes_left = st0.holes_left
  while true {
    // readHeader
    if n - pos < 512 && !eof {
      return Ok(TarStep.Need(pos - pos0 + 512))
    }
    if pos == n {
      return Ok(TarStep.End)
    }
    if n - pos < 512 {
      return Err("untar: unexpected EOF")
    }
    if is_zero_block(data, pos) {
      pos += 512
      if n - pos < 512 && !eof {
        return Ok(TarStep.Need(pos - pos0 + 512))
      }
      if pos == n {
        return Ok(TarStep.End)
      }
      if n - pos < 512 {
        return Err("untar: unexpected EOF")
      }
      if is_zero_block(data, pos) {
        return Ok(TarStep.End)
      }
      return Err(ERR_HEADER)
    }
    // getFormat: the checksum
    let stored = match parse_numeric(data, pos + 148, 8) {
      Some(v) => v
      None => return Err(ERR_HEADER)
    }
    var unsigned = 0
    var signed = 0
    var i = 0
    while i < 512 {
      var c = byte_of(data, pos + i)
      if i >= 148 && i < 156 {
        c = 32
      }
      unsigned += c
      signed += if c >= 128 { c - 256 } else { c }
      i += 1
    }
    if stored != unsigned && stored != signed {
      return Err(ERR_HEADER)
    }
    let magic = sub(data, pos + 257, pos + 263)
    let version = sub(data, pos + 263, pos + 265)
    let trailer = sub(data, pos + 508, pos + 512)
    let ustar = magic == b"ustar\x00"
    let star = ustar && trailer == b"tar\x00"
    let gnu = magic == b"ustar " && version == b" \x00"
    let flag = byte_of(data, pos + 156)
    var name = parse_cstr(data, pos, 100)
    var name_raw = raw_cstr(data, pos, 100)
    let size0 = parse_numeric(data, pos + 124, 12)
    let mode0 = parse_numeric(data, pos + 100, 8)
    let mtime0 = parse_numeric(data, pos + 136, 12)
    if size0.is_none() || mode0.is_none() || mtime0.is_none() || parse_numeric(data, pos + 108, 8).is_none() || parse_numeric(data, pos + 116, 8).is_none() {
      return Err(ERR_HEADER)
    }
    if ustar || gnu {
      if parse_numeric(data, pos + 329, 8).is_none() || parse_numeric(data, pos + 337, 8).is_none() {
        return Err(ERR_HEADER)
      }
    }
    if star {
      if parse_numeric(data, pos + 476, 12).is_none() || parse_numeric(data, pos + 488, 12).is_none() {
        return Err(ERR_HEADER)
      }
      let prefix = parse_cstr(data, pos + 345, 131)
      if prefix != "" {
        name = prefix + "/" + name
        name_raw = raw_cstr(data, pos + 345, 131) + b"/" + name_raw
      }
    } else if gnu {
      // a writer before Go 1.8 put a USTAR prefix where GNU keeps the
      // access and change times: when those do not parse, the field is
      // the prefix if it is ASCII (Go's reader, issues 12594 and 21005)
      let bad_atime = byte_of(data, pos + 345) != 0 && parse_numeric(data, pos + 345, 12).is_none()
      let bad_ctime = byte_of(data, pos + 357) != 0 && parse_numeric(data, pos + 357, 12).is_none()
      if bad_atime || bad_ctime {
        let prefix = parse_cstr(data, pos + 345, 155)
        if prefix != "" && is_ascii(prefix) {
          name = prefix + "/" + name
          name_raw = raw_cstr(data, pos + 345, 155) + b"/" + name_raw
        }
      }
    } else if ustar {
      let prefix = parse_cstr(data, pos + 345, 155)
      if prefix != "" {
        name = prefix + "/" + name
        name_raw = raw_cstr(data, pos + 345, 155) + b"/" + name_raw
      }
    }
    var size = size0 ?? 0
    // Go's Time.UnixNano, which wraps for a time past 2262
    var mtime_ns = (mtime0 ?? 0).wrapping_mul(1000000000)
    let mode = mode0 ?? 0
    pos += 512
    // header only types have no data
    let header_only = flag == 49 || flag == 50 || flag == 51 || flag == 52 || flag == 53 || flag == 54
    var nb = size
    if header_only {
      nb = 0
    }
    if nb < 0 {
      return Err(ERR_HEADER)
    }
    if flag == 120 || flag == 103 || flag == 76 || flag == 75 {
      // a PAX header or a GNU long name: the next header's
      // readSpecialFile reads up to 1 MiB and a byte: too long only
      // when that much is there, else a short body's unexpected EOF
      if nb > 1048576 {
        if n - pos > 1048576 {
          return Err("untar: archive/tar: header field too long")
        }
        if !eof {
          return Ok(TarStep.Need(pos - pos0 + 1048577))
        }
      }
      if n - pos < nb {
        if !eof {
          return Ok(TarStep.Need(pos - pos0 + nb))
        }
        return Err("untar: unexpected EOF")
      }
      let body = sub(data, pos, pos + nb)
      pos += nb
      // the records are parsed before the padding is read (parsePAX,
      // then the next header's discard)
      if (flag == 120 || flag == 103) && parse_pax(body).is_none() {
        return Err(ERR_HEADER)
      }
      if flag == 103 {
        // Next returns a global header as a header under its own name (a
        // path record of its own replacing it), before its padding is
        // read, so untar checks that path before it skips the entry
        // (Reader.next, Archive_untar)
        var gname = name
        var graw = name_raw
        let gm = parse_pax(body) ?? {}
        match gm.get("path") {
          Some(v) => if v != "" {
            gname = v
            graw = (gm.get("\u{0}path") ?? v).bytes()
          }
          None => ()
        }
        if archive_path(gname).is_none() {
          return Err("untar: entry path ${go_q(graw)} ${path_why(gname)}")
        }
      }
      let pad = (512 - nb % 512) % 512
      if n - pos < pad {
        if !eof {
          return Ok(TarStep.Need(pos - pos0 + pad))
        }
        // the padding is read with tryReadFull, which gives io.EOF for
        // a short read too: the archive ends here, as in Go
        return Ok(TarStep.End)
      }
      pos += pad
      if flag == 120 || flag == 103 {
        pax = match parse_pax(body) {
          Some(m) => m
          None => return Err(ERR_HEADER)
        }
        if flag == 103 {
          // a global header (written by `git archive`, holding the
          // commit) describes the archive, not an entry: skipped (std.md
          // 18); the records and long name read before it are dropped,
          // as Reader.next returns with them unused
          pax = {}
          long_name = ""
          long_raw = b""
        }
      } else if flag == 76 {
        long_name = parse_cstr(body, 0, body.len())
        long_raw = raw_cstr(body, 0, body.len())
      }
      continue
    }
    // mergePAX
    let records = pax
    for (k, v) in pax.entries() {
      if v == "" {
        continue
      }
      if k == "path" {
        name = v
        name_raw = (pax.get("\u{0}path") ?? v).bytes()
      } else if k == "mtime" {
        mtime_ns = match parse_pax_time(v) {
          Some(t) => t
          None => return Err(ERR_HEADER)
        }
      } else if k == "size" {
        size = match Int.parse(v) {
          Some(x) => x
          None => return Err(ERR_HEADER)
        }
      } else if k == "uid" || k == "gid" {
        if Int.parse(v).is_none() {
          return Err(ERR_HEADER)
        }
      } else if k == "atime" || k == "ctime" {
        if parse_pax_time(v).is_none() {
          return Err(ERR_HEADER)
        }
      }
    }
    pax = {}
    if long_name != "" {
      name = long_name
      name_raw = long_raw
      long_name = ""
      long_raw = b""
    }
    var typ = flag
    if typ == 0 {
      typ = if name.ends_with("/") { 53 } else { 48 }
    }
    nb = size
    if header_only || typ == 53 {
      nb = 0
    }
    if nb < 0 {
      return Err(ERR_HEADER)
    }
    if flag == 83 {
      // an old GNU sparse file: its map is read and checked before the
      // entry is refused as neither a file nor a directory
      // (readOldGNUSparseMap, validateSparseEntries)
      if !gnu {
        return Err(ERR_HEADER)
      }
      let real = match parse_numeric(data, pos - 512 + 483, 12) {
        Some(v) => v
        None => return Err(ERR_HEADER)
      }
      var blk = pos - 512
      var at = 386
      var count = 4
      var ext = 482
      var pre_end = 0
      var ok = real >= 0
      // the map's bytes read so far, at most 1 MiB (Go 1.26.11's
      // readOldGNUSparseMap: the header's 97 bytes, then 512 a block)
      var total = 97
      while true {
        var k = 0
        while k < count {
          let e = blk + at + 24 * k
          if byte_of(data, e) == 0 {
            break
          }
          let off = parse_numeric(data, e, 12)
          let len = parse_numeric(data, e + 12, 12)
          if off.is_none() || len.is_none() {
            return Err(ERR_HEADER)
          }
          let o = off ?? 0
          let l = len ?? 0
          if o < 0 || l < 0 || o > Int.max - l || o + l > real || pre_end > o {
            ok = false
          } else {
            pre_end = o + l
          }
          k += 1
        }
        if byte_of(data, blk + ext) == 0 {
          break
        }
        if n - pos < 512 {
          if !eof {
            return Ok(TarStep.Need(pos - pos0 + 512))
          }
          return Err("untar: unexpected EOF")
        }
        blk = pos
        pos += 512
        at = 0
        count = 21
        ext = 504
        total += 512
        if total >= 1048576 {
          return Err("untar: archive/tar: sparse map too long")
        }
      }
      if !ok {
        return Err(ERR_HEADER)
      }
    }
    let p = match archive_path(name) {
      Some(x) => x
      None => return Err("untar: entry path ${go_q(name_raw)} ${path_why(name)}")
    }
    var e = archive.Entry{path: p, data: b"", mode: mode & 0o7777, is_dir: false, modified: Time.UNIX_EPOCH + Duration.from_nanos(mtime_ns)}
    var sparse = false
    if typ == 53 {
      e.is_dir = true
    } else if typ == 48 {
      if is_sparse(records) {
        // a GNU sparse file described by PAX records (handleSparseFile):
        // its map and data are read whole
        if n - pos < nb {
          if !eof {
            return Ok(TarStep.Need(pos - pos0 + nb))
          }
          return Err("untar: unexpected EOF")
        }
        match sparse_pax(records, sub(data, pos, pos + nb), holes_left) {
          Ok(Some((sname, logical))) => {
            holes_left -= logical.len() - nb
            if sname != "" {
              e.path = match archive_path(sname) {
                Some(x) => x
                None => return Err("untar: entry path ${go_q((records.get("\u{0}GNU.sparse.name") ?? sname).bytes())} ${path_why(sname)}")
              }
            }
            e.data = logical
            sparse = true
          }
          Ok(None) => {}
          Err(m) => return Err(m)
        }
      }
    } else {
      return Err("untar: entry ${go_q(name_raw)} is not a file or a directory")
    }
    return Ok(TarStep.Head(TarHead{e: e, at: pos, nb: nb, sparse: sparse, st: UntarState{pax: pax, long_name: long_name, long_raw: long_raw, holes_left: holes_left}}))
  }
  Ok(TarStep.End)
}

/// A tar archive read entry by entry from a File (Go's tar.Reader): memory
/// is a header's records and the input buffered for it, not the data (a
/// sparse file's data is the exception: it is read whole). The entries
/// and errors are untar's, `untar:` read as `tar_reader:`.
struct TarReader {
  f: File
  /// input read and not yet used: buf[at..]
  buf: Bytes
  at: Int
  eof: Bool
  st: UntarState
  /// the current entry's bytes left in the archive, and its padding
  left: Int
  pad: Int
  /// a sparse entry's logical data and how much of it read gave
  logical: Bytes
  lpos: Int
  sparse: Bool
  done: Bool
}

fn tar_reader(f: File) -> TarReader {
  TarReader{f: f, buf: b"", at: 0, eof: false, st: UntarState{pax: {}, long_name: "", holes_left: SPARSE_HOLES_MAX}, left: 0, pad: 0, logical: b"", lpos: 0, sparse: false, done: false}
}

fn tr_err(msg: Str) -> archive.ArchiveErr {
  archive_err("tar_reader: ${msg.cut_prefix("untar: ") ?? msg}")
}

/// Reads until buf[at..] holds k bytes or the File ends.
fn (var r: TarReader) fill(k: Int) -> () ! archive.ArchiveErr uses fs.read {
  if r.buf.len() - r.at >= k || r.eof {
    return Ok(())
  }
  var b = BytesBuilder.with_capacity(k)
  b.write(r.buf[r.at..r.buf.len()])
  while b.len() < k {
    let want = if k - b.len() > 65536 { k - b.len() } else { 65536 }
    match r.f.read(want) {
      Ok(Some(got)) => b.write(got)
      Ok(None) => {
        r.eof = true
        break
      }
      Err(e) => return Err(tr_err(e.display()))
    }
  }
  r.buf = b.freeze()
  r.at = 0
  Ok(())
}

/// Up to max bytes of the current entry's data in the archive (from the
/// buffer first), or None at the File's end.
fn (var r: TarReader) take(max: Int) -> Bytes? ! archive.ArchiveErr uses fs.read {
  let have = r.buf.len() - r.at
  if have > 0 {
    let k = if max < have { max } else { have }
    let out = r.buf[r.at..r.at + k]
    r.at += k
    return Ok(Some(out))
  }
  if r.eof {
    return Ok(None)
  }
  match r.f.read(max) {
    Ok(Some(got)) => Ok(Some(got))
    Ok(None) => {
      r.eof = true
      Ok(None)
    }
    Err(e) => Err(tr_err(e.display()))
  }
}

fn (var r: TarReader) next() -> archive.TarFile? ! archive.ArchiveErr uses fs.read {
  if r.done {
    return Ok(None)
  }
  // the rest of the current entry (discard), then its padding
  // (tryReadFull: short is the archive's end)
  while r.left > 0 {
    match r.take(r.left) {
      Ok(Some(got)) => r.left -= got.len()
      Ok(None) => {
        r.done = true
        return Err(tr_err("unexpected EOF"))
      }
      Err(e) => {
        r.done = true
        return Err(e)
      }
    }
  }
  if r.pad > 0 {
    r.fill(r.pad)?
    if r.buf.len() - r.at < r.pad {
      r.done = true
      return Ok(None)
    }
    r.at += r.pad
    r.pad = 0
  }
  r.logical = b""
  r.lpos = 0
  r.sparse = false
  while true {
    match untar_step(r.buf, r.at, r.st, r.eof) {
      Ok(TarStep.Need(k)) => {
        let had = r.buf.len() - r.at
        r.fill(k)?
        if r.buf.len() - r.at == had && !r.eof {
          return Err(tr_err("no progress"))
        }
      }
      Ok(TarStep.End) => {
        r.done = true
        return Ok(None)
      }
      Ok(TarStep.Head(h)) => {
        r.st = h.st
        r.at = h.at
        r.left = h.nb
        r.pad = (512 - h.nb % 512) % 512
        var size = h.nb
        if h.sparse {
          r.sparse = true
          r.logical = h.e.data
          size = h.e.data.len()
        }
        return Ok(Some(archive.TarFile{path: h.e.path, size: size, mode: h.e.mode, is_dir: h.e.is_dir, modified: h.e.modified}))
      }
      Err(m) => {
        r.done = true
        return Err(tr_err(m))
      }
    }
  }
  Ok(None)
}

fn (var r: TarReader) read(max: Int) -> Bytes? ! archive.ArchiveErr uses fs.read {
  if max <= 0 {
    return Ok(Some(b""))
  }
  if r.sparse {
    if r.lpos == r.logical.len() {
      return Ok(None)
    }
    let k = if max < r.logical.len() - r.lpos { max } else { r.logical.len() - r.lpos }
    let out = r.logical[r.lpos..r.lpos + k]
    r.lpos += k
    return Ok(Some(out))
  }
  if r.left == 0 {
    return Ok(None)
  }
  let want = if max < r.left { max } else { r.left }
  match r.take(want)? {
    Some(got) => {
      r.left -= got.len()
      Ok(Some(got))
    }
    None => {
      r.done = true
      Err(tr_err("unexpected EOF"))
    }
  }
}

// ---------------------------------------------------------------------------
// zip (archive/zip): deflated files with data descriptors, stored
// directories, Unix modes, extended timestamps

/// The civil date of Unix days (year, month, day).
fn civil(days: Int) -> (Int, Int, Int) {
  let z = days + 719468
  let era = floor_div(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  (if m <= 2 { y + 1 } else { y }, m, d)
}

/// Unix days of a civil date, the month normalized as time.Date does
/// (the day may run past the month).
fn days_from_civil(y0: Int, m0: Int, d: Int) -> Int {
  let carry = floor_div(m0 - 1, 12)
  var y = y0 + carry
  let m = m0 - carry * 12
  if m <= 2 {
    y -= 1
  }
  let era = floor_div(y, 400)
  let yoe = y - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468 + (d - 1)
}

/// detectUTF8: valid, and whether the name needs the UTF-8 flag.
fn detect_utf8(s: Str) -> (Bool, Bool) {
  let b = s.bytes()
  var require = false
  var i = 0
  while i < b.len() {
    let d = raw.bytes_decode(b, i)
    let r = d >> 3
    let size = d & 7
    i += size
    if r < 0x20 || r > 0x7d || r == 0x5c {
      if r == 0xfffd && size == 1 {
        return (false, false)
      }
      require = true
    }
  }
  (true, require)
}

struct ZipHdr {
  name: Str
  /// the name's bytes, which an error quotes as Go does (\xNN for a
  /// byte that is not UTF-8)
  raw: Bytes
  creator: Int
  flags: Int
  method: Int
  time: Int
  date: Int
  crc: Int
  csize: Int
  usize: Int
  extra: Bytes
  attrs: Int
  offset: Int
  /// the version needed to extract (20; 45 for zip64 on write)
  version: Int = 20
  /// the entry's comment, its bytes
  comment: Bytes = b""
  /// the central directory record read (ZipFile's _dir, for copy)
  rec: Bytes = b""
  /// written by copy or add_raw (Writer.CreateRaw): the header's own
  /// fields, sizes and CRC in the local header unless a descriptor follows
  is_raw: Bool = false
}

/// The directory record of an entry whose data is not yet written: its
/// name (a directory's ends with `/`), flags, method, MS-DOS and Unix
/// times, attributes and header offset (Writer.CreateHeader).
fn zip_new_header(p: Str, mode: Int, is_dir: Bool, modified: Time, offset: Int, store: Bool) -> ZipHdr {
  var name = p
  let perm = mode & 0o777
  var attrs = (0x8000 | perm) << 16
  var method = if store { 0 } else { 8 }
  var flags = 0x8
  if is_dir {
    name = p + "/"
    method = 0
    flags = 0
    attrs = ((0x4000 | perm) << 16) | 0x10
  }
  if (perm & 0o200) == 0 {
    attrs = attrs | 0x01
  }
  let (valid, require) = detect_utf8(name)
  if require && valid {
    flags = flags | 0x800
  }
  let ns = (modified - Time.UNIX_EPOCH).nanos()
  let secs = floor_div(ns, 1000000000)
  let days = floor_div(secs, 86400)
  let sod = secs - days * 86400
  let (year, month, day) = civil(days)
  let date = (day + (month << 5) + ((year - 1980) << 9)) & 65535
  let time = ((sod % 60) / 2 + (((sod / 60) % 60) << 5) + ((sod / 3600) << 11)) & 65535
  var xb = BytesBuilder.new()
  put_u16(xb, 0x5455)
  put_u16(xb, 5)
  xb.write_byte(UInt8(1))
  put_u32(xb, secs & 0xffffffff)
  ZipHdr{name: name, raw: name.bytes(), creator: 0x0314, flags: flags, method: method, time: time, date: date, crc: 0, csize: 0, usize: 0, extra: xb.freeze(), attrs: attrs, offset: offset}
}

/// The local file header of zf (sizes and CRC zero: they follow the data).
fn zip_local_header(zf: ZipHdr) -> Bytes {
  let nb = zf.raw
  var h = BytesBuilder.new()
  put_u32(h, 0x04034b50)
  put_u16(h, zf.version)
  put_u16(h, zf.flags)
  put_u16(h, zf.method)
  put_u16(h, zf.time)
  put_u16(h, zf.date)
  if zf.is_raw && (zf.flags & 0x8) == 0 {
    put_u32(h, zf.crc)
    put_u32(h, if zf.csize > 0xffffffff { 0xffffffff } else { zf.csize })
    put_u32(h, if zf.usize > 0xffffffff { 0xffffffff } else { zf.usize })
  } else {
    put_u32(h, 0)
    put_u32(h, 0)
    put_u32(h, 0)
  }
  put_u16(h, nb.len())
  put_u16(h, zf.extra.len())
  h.write(nb)
  h.write(zf.extra)
  h.freeze()
}

/// Whether an entry's sizes need the zip64 forms (Go's FileHeader.isZip64).
fn zip_is64(zf: ZipHdr) -> Bool { zf.csize >= 0xffffffff || zf.usize >= 0xffffffff }

/// The data descriptor after a deflated entry's data, with 64-bit sizes
/// for a zip64 entry (Go's writeDataDescriptor).
fn zip_descriptor(zf: ZipHdr) -> Bytes {
  var d = BytesBuilder.with_capacity(24)
  put_u32(d, 0x08074b50)
  put_u32(d, zf.crc)
  if zip_is64(zf) {
    put_u64(d, zf.csize)
    put_u64(d, zf.usize)
  } else {
    put_u32(d, zf.csize)
    put_u32(d, zf.usize)
  }
  d.freeze()
}

/// The central directory and the end record for files, the directory
/// starting at start (Go's Writer.Close): an entry past the 32-bit sizes
/// or offset gets the zip64 extra field, and an archive of 65,535 or more
/// entries, or a directory past the 32-bit size or offset, the zip64 end
/// record and its locator before the classic end record.
fn zip_central(files: List[ZipHdr], start: Int, comment: Str) -> Bytes {
  var out = BytesBuilder.new()
  var count = start
  for zf in files {
    let nb = zf.raw
    let big = zip_is64(zf)
    put_u32(out, 0x02014b50)
    put_u16(out, zf.creator)
    put_u16(out, if big && !zf.is_raw { 45 } else { zf.version })
    put_u16(out, zf.flags)
    put_u16(out, zf.method)
    put_u16(out, zf.time)
    put_u16(out, zf.date)
    put_u32(out, zf.crc)
    var extra = zf.extra
    if big || zf.offset >= 0xffffffff {
      put_u32(out, 0xffffffff)
      put_u32(out, 0xffffffff)
      var x = BytesBuilder.with_capacity(zf.extra.len() + 28)
      x.write(zf.extra)
      put_u16(x, 0x0001)
      put_u16(x, 24)
      put_u64(x, zf.usize)
      put_u64(x, zf.csize)
      put_u64(x, zf.offset)
      extra = x.freeze()
    } else {
      put_u32(out, zf.csize)
      put_u32(out, zf.usize)
    }
    put_u16(out, nb.len())
    put_u16(out, extra.len())
    put_u16(out, zf.comment.len())
    put_u16(out, 0)
    put_u16(out, 0)
    put_u32(out, zf.attrs)
    put_u32(out, if zf.offset > 0xffffffff { 0xffffffff } else { zf.offset })
    out.write(nb)
    out.write(extra)
    out.write(zf.comment)
    count += 46 + nb.len() + extra.len() + zf.comment.len()
  }
  var records = files.len()
  var size = count - start
  var offset = start
  if records >= 0xffff || size >= 0xffffffff || offset >= 0xffffffff {
    // the zip64 end of central directory record
    put_u32(out, 0x06064b50)
    put_u64(out, 44)
    put_u16(out, 45)
    put_u16(out, 45)
    put_u32(out, 0)
    put_u32(out, 0)
    put_u64(out, records)
    put_u64(out, records)
    put_u64(out, size)
    put_u64(out, offset)
    // and its locator: the record starts where the directory ends
    put_u32(out, 0x07064b50)
    put_u32(out, 0)
    put_u64(out, count)
    put_u32(out, 1)
    records = 0xffff
    size = 0xffffffff
    offset = 0xffffffff
  }
  put_u32(out, 0x06054b50)
  put_u16(out, 0)
  put_u16(out, 0)
  put_u16(out, records)
  put_u16(out, records)
  put_u32(out, size)
  put_u32(out, offset)
  put_u16(out, comment.len())
  out.write(comment.bytes())
  out.freeze()
}

/// Writer.SetComment's check.
fn zip_comment_ok(comment: Str) -> Bool { comment.len() <= 65535 }

const ERR_COMMENT: Str = "zip: Writer.Comment too long"

fn zip(entries: List[archive.Entry], comment: Str, method: archive.ZipMethod, offset: Int) -> Bytes ! archive.ArchiveErr {
  if !zip_comment_ok(comment) {
    return Err(archive_err("zip: ${ERR_COMMENT}"))
  }
  let store = method == archive.ZipMethod.Store
  let t = flate.crc_table()
  var out = BytesBuilder.new()
  var count = offset
  var files: List[ZipHdr] = []
  var zs = flate.new_stream(5)
  for e in entries {
    let p = match archive_path(e.path) {
      Some(x) => x
      None => return Err(archive_err("bad entry path ${e.path.quote()}"))
    }
    var zf = zip_new_header(p, e.mode, e.is_dir, e.modified, count, store)
    let hdr = zip_local_header(zf)
    out.write(hdr)
    count += hdr.len()
    if !e.is_dir {
      let comp = if store { e.data } else { flate.deflate_again(zs, e.data) }
      out.write(comp)
      count += comp.len()
      zf.crc = flate.crc32(t, 0, e.data)
      zf.csize = comp.len()
      zf.usize = e.data.len()
      let dd = zip_descriptor(zf)
      out.write(dd)
      count += dd.len()
    }
    files.push(zf)
  }
  out.write(zip_central(files, count, comment))
  out.freeze()
}

/// A zip archive being written to a File, entry by entry (decision 0479).
struct ZipWriter {
  f: File
  t: List[Int]
  files: List[ZipHdr]
  /// the bytes written so far
  pos: Int
  /// the entry being streamed, and whether there is one
  cur: ZipHdr
  open: Bool
  s: flate.Stream
  sum: Int
  done: Bool
  comment: Str = ""
  /// bytes put but not yet written: Go's zip.Writer writes through a
  /// 4096 byte bufio.Writer, so a header, a descriptor or a short
  /// deflate block is not a system call of its own
  pend: BytesBuilder = BytesBuilder.new()
}

fn zip_writer(f: File) -> ZipWriter {
  let none = ZipHdr{name: "", raw: b"", creator: 0, flags: 0, method: 0, time: 0, date: 0, crc: 0, csize: 0, usize: 0, extra: b"", attrs: 0, offset: 0}
  ZipWriter{f: f, t: flate.crc_table(), files: [], pos: 0, cur: none, open: false, s: flate.new_stream(5), sum: 0, done: false}
}

fn zw_err(e: FsErr) -> archive.ArchiveErr { archive_err("zip_writer: ${e.display()}") }

fn (var w: ZipWriter) put(b: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  w.pos += b.len()
  if w.pend.len() == 0 && b.len() >= ZW_BUF {
    // as bufio.Writer: a large write with nothing waiting goes straight on
    return w.write_out(b)
  }
  w.pend.write(b)
  if w.pend.len() >= ZW_BUF {
    return w.flush()
  }
  Ok(())
}

const ZW_BUF: Int = 4096

/// Writes the bytes put so far.
fn (var w: ZipWriter) flush() -> () ! archive.ArchiveErr uses fs.write {
  if w.pend.len() == 0 {
    return Ok(())
  }
  let b = w.pend.freeze()
  w.pend = BytesBuilder.new()
  w.write_out(b)
}

fn (var w: ZipWriter) write_out(b: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  match w.f.write(b) {
    Ok(_) => Ok(())
    Err(e) => Err(zw_err(e))
  }
}

/// Ends the entry being streamed: the last deflate block, the data
/// descriptor, and its directory record.
fn (var w: ZipWriter) end_entry() -> () ! archive.ArchiveErr uses fs.write {
  if !w.open {
    return Ok(())
  }
  if (w.cur.flags & 0x8) != 0 {
    if w.cur.method == 8 {
      w.s.close()
      let comp = w.s.take()
      w.cur.csize += comp.len()
      w.put(comp)?
    }
    w.cur.crc = w.sum
    w.put(zip_descriptor(w.cur))?
  }
  w.files.push(w.cur)
  w.open = false
  Ok(())
}

fn (var w: ZipWriter) start(p: Str, mode: Int, is_dir: Bool, modified: Time, store: Bool) -> () ! archive.ArchiveErr uses fs.write {
  if w.done {
    return Err(archive_err("zip_writer: closed"))
  }
  w.end_entry()?
  w.cur = zip_new_header(p, mode, is_dir, modified, w.pos, store)
  w.put(zip_local_header(w.cur))?
  w.open = true
  w.sum = 0
  if !is_dir && !store {
    w.s = flate.new_stream(5)
  }
  Ok(())
}

fn (var w: ZipWriter) add(e: archive.Entry, method: archive.ZipMethod) -> () ! archive.ArchiveErr uses fs.write {
  let p = match archive_path(e.path) {
    Some(x) => x
    None => return Err(archive_err("bad entry path ${e.path.quote()}"))
  }
  w.start(p, e.mode, e.is_dir, e.modified, method == archive.ZipMethod.Store)?
  if !e.is_dir {
    w.write(e.data)?
  }
  w.end_entry()
}

fn (var w: ZipWriter) create(path: Str, mode: Int, method: archive.ZipMethod) -> () ! archive.ArchiveErr uses fs.write {
  let p = match archive_path(path) {
    Some(x) => x
    None => return Err(archive_err("bad entry path ${path.quote()}"))
  }
  w.start(p, mode, false, Time.UNIX_EPOCH, method == archive.ZipMethod.Store)
}

/// Writer.CreateRaw and the raw bytes: the header as h says (sizes and
/// CRC in the local header unless a descriptor follows), raw, and the
/// descriptor when flags has bit 3; a directory gets no data.
fn (var w: ZipWriter) put_raw(h: ZipHdr, raw: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  if w.done {
    return Err(archive_err("zip_writer: closed"))
  }
  w.end_entry()?
  var zf = h
  zf.is_raw = true
  zf.offset = w.pos
  w.put(zip_local_header(zf))?
  let nb = zf.raw
  let is_dir = nb.len() > 0 && nb[nb.len() - 1] == 47
  if !is_dir {
    w.put(raw)?
    if (zf.flags & 0x8) != 0 {
      w.put(zip_descriptor(zf))?
    }
  } else if !raw.is_empty() {
    return Err(archive_err("zip_writer: zip: write to directory"))
  }
  w.files.push(zf)
  Ok(())
}

fn (var w: ZipWriter) copy(r: archive.ZipReader, f: archive.ZipFile) -> () ! archive.ArchiveErr uses fs {
  let raw = zipreader_raw(r, f)?
  var zf = zip_raw_header(f)
  if !f._dir.is_empty() {
    match zip_dir_header(f._dir, 0) {
      Ok((h, _)) => zf = h
      Err(e) => return Err(archive_err("zip_writer: ${e}"))
    }
    zf.csize = f.compressed
    zf.usize = f.size
  }
  w.put_raw(zf, raw)
}

/// The header add_raw writes for f (Writer.CreateRaw of a FileHeader with
/// f's name, method, flags, CRC and sizes, creator 0x0314, version 20,
/// SetMode and SetModTime of f's mode and time).
fn zip_raw_header(f: archive.ZipFile) -> ZipHdr {
  var zf = zip_new_header(f.path, f.mode, f.is_dir, f.modified, 0, false)
  zf.flags = f.flags
  zf.method = f.method
  zf.crc = f.crc
  zf.csize = f.compressed
  zf.usize = f.size
  zf.extra = b""
  zf
}

fn (var w: ZipWriter) add_raw(f: archive.ZipFile, raw: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  match archive_path(f.path) {
    Some(_) => ()
    None => return Err(archive_err("bad entry path ${f.path.quote()}"))
  }
  w.put_raw(zip_raw_header(f), raw)
}

/// Writer.AddFS: src.walk(".") with each entry's mode, deflated, a file
/// copied in 64 KiB reads. A link is Go's non-regular file error.
fn (var w: ZipWriter) add_fs(src: Fs) -> () ! archive.ArchiveErr uses fs {
  let list = match src.walk(".") {
    Ok(l) => l
    Err(e) => return Err(zw_err(e))
  }
  for fi in list {
    if fi.is_symlink {
      return Err(archive_err("zip_writer: zip: cannot add non-regular file ${fi.path.quote()}"))
    }
    let mode = match src.mode(fi.path) {
      Ok(m) => m
      Err(e) => return Err(zw_err(e))
    }
    let p = match archive_path(fi.path) {
      Some(x) => x
      None => return Err(archive_err("bad entry path ${fi.path.quote()}"))
    }
    w.start(p, mode, fi.is_dir, fi.modified, false)?
    if !fi.is_dir {
      let inp = match src.open(fi.path) {
        Ok(f) => f
        Err(e) => return Err(zw_err(e))
      }
      let r = w.copy_from(inp)
      let cl = inp.close()
      r?
      if let Err(e) = cl {
        return Err(zw_err(e))
      }
    }
    w.end_entry()?
  }
  Ok(())
}

fn (var w: ZipWriter) copy_from(inp: File) -> () ! archive.ArchiveErr uses fs {
  while {
    match inp.read(65536) {
      Ok(Some(b)) => w.write(b)?
      Ok(None) => return Ok(())
      Err(e) => return Err(zw_err(e))
    }
  }
}

fn (var w: ZipWriter) set_comment(comment: Str) -> () ! archive.ArchiveErr {
  if !zip_comment_ok(comment) {
    return Err(archive_err("zip_writer: ${ERR_COMMENT}"))
  }
  w.comment = comment
}

fn (var w: ZipWriter) set_offset(n: Int) {
  if w.pos != 0 {
    fault("zip: SetOffset called after data was written")
  }
  w.pos = n
}

fn (var w: ZipWriter) write(data: Bytes) -> () ! archive.ArchiveErr uses fs.write {
  if !w.open || (w.cur.flags & 0x8) == 0 {
    return Err(archive_err("zip_writer: write without create"))
  }
  w.sum = flate.crc32(w.t, w.sum, data)
  w.cur.usize += data.len()
  if w.cur.method == 0 {
    w.cur.csize += data.len()
    return w.put(data)
  }
  w.s.write(data)
  let comp = w.s.take()
  w.cur.csize += comp.len()
  w.put(comp)
}

fn (var w: ZipWriter) close() -> () ! archive.ArchiveErr uses fs.write {
  if w.done {
    return Err(archive_err("zip_writer: closed"))
  }
  w.end_entry()?
  w.done = true
  w.put(zip_central(w.files, w.pos, w.comment))?
  w.flush()
}

const ERR_FORMAT: Str = "zip: not a valid zip file"

/// readDirectoryHeader at pos: the file and the position after it, or
/// None at the end of the directory (ErrFormat or a short read).
/// readDirectoryHeader: the entry and the offset after it, or why the
/// directory stops: `unexpected EOF` (a short header), ERR_FORMAT (not a
/// header), or `EOF` (nothing left to read, which ends the read
/// with that error).
fn zip_dir_header(data: Bytes, pos: Int) -> (ZipHdr, Int) ! Str {
  let n = data.len()
  if pos < 0 || pos > n {
    return Err("unexpected EOF")
  }
  if pos == n {
    return Err("EOF")
  }
  if n - pos < 46 {
    return Err("unexpected EOF")
  }
  if get_u32(data, pos) != 0x02014b50 {
    return Err(ERR_FORMAT)
  }
  let csize = get_u32(data, pos + 20)
  let usize = get_u32(data, pos + 24)
  let nlen = get_u16(data, pos + 28)
  let xlen = get_u16(data, pos + 30)
  let clen = get_u16(data, pos + 32)
  let offset = get_u32(data, pos + 42)
  let p = pos + 46
  if nlen + xlen + clen > 0 && p == n {
    return Err("EOF")
  }
  if n - p < nlen + xlen + clen {
    return Err("unexpected EOF")
  }
  // a size or offset at its 32-bit maximum is in the zip64 extra field,
  // in the order usize, csize, offset (readDirectoryHeader)
  var need_u = usize == 0xffffffff
  var need_c = csize == 0xffffffff
  var need_o = offset == 0xffffffff
  var csize64 = csize
  var usize64 = usize
  var offset64 = offset
  let x = sub(data, p + nlen, p + nlen + xlen)
  var i = 0
  while x.len() - i >= 4 {
    let tag = get_u16(x, i)
    let fsize = get_u16(x, i + 2)
    i += 4
    if x.len() - i < fsize {
      break
    }
    var f = i
    let fend = i + fsize
    i = fend
    if tag != 1 {
      continue
    }
    if need_u {
      need_u = false
      if fend - f < 8 {
        return Err(ERR_FORMAT)
      }
      usize64 = get_u64(x, f)
      f += 8
    }
    if need_c {
      need_c = false
      if fend - f < 8 {
        return Err(ERR_FORMAT)
      }
      csize64 = get_u64(x, f)
      f += 8
    }
    if need_o {
      need_o = false
      if fend - f < 8 {
        return Err(ERR_FORMAT)
      }
      offset64 = get_u64(x, f)
    }
  }
  if need_c || need_o {
    return Err(ERR_FORMAT)
  }
  let zf = ZipHdr{name: scan.text_of(sub(data, p, p + nlen)), raw: sub(data, p, p + nlen), creator: get_u16(data, pos + 4), flags: get_u16(data, pos + 8), method: get_u16(data, pos + 10), time: get_u16(data, pos + 12), date: get_u16(data, pos + 14), crc: get_u32(data, pos + 16), csize: csize64, usize: usize64, extra: x, attrs: get_u32(data, pos + 38), offset: offset64, version: get_u16(data, pos + 6), comment: sub(data, p + nlen + xlen, p + nlen + xlen + clen), rec: sub(data, pos, p + nlen + xlen + clen)}
  (zf, p + nlen + xlen + clen)
}

/// The modification time of a central directory entry in Unix
/// nanoseconds: its extended (or NTFS, or Unix) timestamp, else its
/// MS-DOS time read as UTC.
fn zip_modified(zf: ZipHdr) -> Int {
  var mod = 0
  var found = false
  let x = zf.extra
  var i = 0
  while x.len() - i >= 4 {
    let tag = get_u16(x, i)
    let size = get_u16(x, i + 2)
    i += 4
    if x.len() - i < size {
      break
    }
    let fb = i
    i += size
    if tag == 0x5455 {
      if size >= 5 && (byte_of(x, fb) & 1) != 0 {
        mod = get_u32(x, fb + 1) * 1000000000
        found = true
      }
    } else if tag == 0x000d || tag == 0x5855 {
      if size >= 8 {
        mod = get_u32(x, fb + 4) * 1000000000
        found = true
      }
    } else if tag == 0x000a && size >= 4 {
      var k = fb + 4
      while fb + size - k >= 4 {
        let atag = get_u16(x, k)
        let asize = get_u16(x, k + 2)
        k += 4
        if fb + size - k < asize {
          break
        }
        if atag == 1 && asize == 24 {
          // int64(uint64), then Go's truncating / and %, and
          // UnixNano's wrapping
          let ts = get_u64(x, k)
          mod = (ts / 10000000 - 11644473600).wrapping_mul(1000000000).wrapping_add((ts % 10000000) * 100)
          found = true
        }
        k += asize
      }
    }
  }
  if found {
    return mod
  }
  let days = days_from_civil((zf.date >> 9) + 1980, (zf.date >> 5) & 15, zf.date & 31)
  (days * 86400 + (zf.time >> 11) * 3600 + ((zf.time >> 5) & 63) * 60 + (zf.time & 31) * 2) * 1000000000
}

fn unzip(data: Bytes, max_size: Int) -> List[archive.Entry] ! archive.ArchiveErr {
  match unzip_entries(data, max_size) {
    Ok(l) => l
    Err(e) => Err(archive_err("unzip: ${e}"))
  }
}

/// readDirectoryEnd: the offset of the end record, or -1.
fn zip_find_end(data: Bytes) -> Int {
  let size = data.len()
  var tries = 0
  while tries < 2 {
    var blen = if tries == 0 { 1024 } else { 65 * 1024 }
    if blen > size {
      blen = size
    }
    let lo = size - blen
    var i = blen - 22
    while i >= 0 {
      let at = lo + i
      if byte_of(data, at) == 80 && byte_of(data, at + 1) == 75 && byte_of(data, at + 2) == 5 && byte_of(data, at + 3) == 6 {
        let cl = byte_of(data, at + 20) | (byte_of(data, at + 21) << 8)
        if cl + 22 + i > blen {
          i = -1
        } else {
          return at
        }
        break
      }
      i -= 1
    }
    if tries == 1 || blen == size {
      return -1
    }
    tries += 1
  }
  -1
}

/// The central directory of a zip archive: its files in order, or why it
/// cannot be read (Reader.init).
fn zip_directory(data: Bytes) -> List[ZipHdr] ! Str { zip_directory_at(data, 0) }

/// zip_directory of an archive of which data holds the bytes from the
/// file offset shift to the end (an archive read from a File keeps its
/// tail and its directory, not its entries). An error "NEED n" says the
/// directory needs the bytes from the file offset n < shift.
fn zip_directory_at(data: Bytes, shift: Int) -> List[ZipHdr] ! Str {
  let size = shift + data.len()
  let end_off = zip_find_end(data)
  if end_off < 0 {
    return Err(ERR_FORMAT)
  }
  let records32 = get_u16(data, end_off + 10)
  let dir_size32 = get_u32(data, end_off + 12)
  let dir_off32 = get_u32(data, end_off + 16)
  let comment_len = get_u16(data, end_off + 20)
  if comment_len > data.len() - end_off - 22 {
    return Err("zip: invalid comment length")
  }
  var records = records32
  var dir_size = dir_size32
  var dir_off = dir_off32
  var end_at = shift + end_off
  // these values mean the archive may be zip64 (Go compares the 32-bit
  // size with 0xffff too): the zip64 end record through its locator
  if records == 0xffff || dir_size == 0xffff || dir_off == 0xffffffff {
    let loc = end_off - 20
    if loc >= 0 && get_u32(data, loc) == 0x07064b50 && get_u32(data, loc + 4) == 0 && get_u32(data, loc + 16) == 1 {
      let p = get_u64(data, loc + 8)
      if p < 0 || p > size - 56 {
        return Err("EOF")
      }
      if p < shift {
        return Err("NEED ${p}")
      }
      if get_u32(data, p - shift) != 0x06064b50 {
        return Err(ERR_FORMAT)
      }
      records = get_u64(data, p - shift + 32)
      dir_size = get_u64(data, p - shift + 40)
      dir_off = get_u64(data, p - shift + 48)
      end_at = p
    }
  }
  if dir_size < 0 || dir_off < 0 {
    return Err(ERR_FORMAT)
  }
  var base = end_at - dir_size - dir_off
  if base + dir_off < 0 || base + dir_off >= size {
    return Err(ERR_FORMAT)
  }
  if base > 0 {
    if dir_off < shift {
      return Err("NEED ${dir_off}")
    }
    match zip_dir_header(data, dir_off - shift) {
      Ok(_) => base = 0
      Err(_) => ()
    }
  }
  var files: List[ZipHdr] = []
  var pos = base + dir_off
  if pos < shift {
    return Err("NEED ${pos}")
  }
  pos -= shift
  var stop = ""
  while true {
    match zip_dir_header(data, pos) {
      Ok((zf, next)) => {
        var f = zf
        f.offset = f.offset.wrapping_add(base)
        files.push(f)
        pos = next
      }
      Err(e) => {
        if e == "EOF" {
          return Err(e)
        }
        stop = e
        break
      }
    }
  }
  // the count is compared in 16 bits; a wrong one returns why the
  // directory stopped (Reader.init)
  if (files.len() & 65535) != (records & 65535) {
    return Err(stop)
  }
  files
}

/// The path, permission bits and kind (true for a directory) of an
/// entry (FileHeader.Mode), or why it is refused: a path that leaves the
/// archive, a device, pipe, link or socket.
fn zip_meta(zf: ZipHdr) -> (Str, Int, Bool) ! Str {
  let p = match archive_path(zf.name) {
    Some(x) => x
    None => return Err("entry path ${go_q(zf.raw)} ${path_why(zf.name)}")
  }
  let creator = zf.creator >> 8
  var perm = 0
  var typ = 0
  if creator == 3 || creator == 19 {
    let m = zf.attrs >> 16
    perm = m & 0o777
    typ = m & 0xf000
  } else if creator == 11 || creator == 14 || creator == 0 {
    if (zf.attrs & 0x10) != 0 {
      typ = 0x4000
      perm = 0o777
    } else {
      perm = 0o666
    }
    if (zf.attrs & 0x01) != 0 {
      perm = perm & 0o555
    }
  }
  if typ == 0x4000 || zf.name.ends_with("/") {
    return Ok((p, perm, true))
  }
  // unixModeToFileMode marks only a device, pipe, link or socket; any
  // other file type, unknown ones too, is a regular file
  if typ == 0x6000 || typ == 0x2000 || typ == 0x1000 || typ == 0xa000 || typ == 0xc000 {
    return Err("entry ${go_q(zf.raw)} is not a file or a directory")
  }
  Ok((p, perm, false))
}

fn unzip_entries(data: Bytes, max_size: Int) -> List[archive.Entry] ! Str {
  let t = flate.crc_table()
  let fixed = flate.fixed_decoder()
  let files = zip_directory(data)?
  // the declared sizes bound what inflating may hold (zip_read stops an
  // entry past its own), so check their sum first
  let max = if max_size < 0 { 0 } else { max_size }
  var declared = 0
  for zf in files {
    declared += zf.usize
    if declared > max {
      return Err("zip: files exceed max_size (${max} bytes)")
    }
  }
  var out: List[archive.Entry] = []
  for zf in files {
    let (p, perm, is_dir) = zip_meta(zf)?
    var e = archive.Entry{path: p, data: b"", mode: perm, is_dir: is_dir, modified: Time.UNIX_EPOCH + Duration.from_nanos(zip_modified(zf))}
    if !is_dir {
      e.data = zip_read(data, zf, t, fixed)?
    }
    out.push(e)
  }
  out
}

/// A zip archive kept in memory with its central directory read once
/// (decision 0479): every entry is checked as unzip checks it, none is
/// inflated until read.
fn zip_reader(data: Bytes) -> archive.ZipReader ! archive.ArchiveErr {
  var list: List[archive.ZipFile] = []
  match zip_files_at(data, 0) {
    Ok(l) => list = l
    Err(e) => return Err(archive_err("zip_reader: ${e}"))
  }
  archive.ZipReader{data: data, list: list, file: None, total: 0, note: zip_comment_of(data)}
}

/// n bytes of f from the offset off, or why not.
fn read_span(f: File, off: Int, n: Int) -> Bytes ! archive.ArchiveErr uses fs.read {
  var out = BytesBuilder.with_capacity(n)
  var at = off
  while out.len() < n {
    let got = match f.read_at(at, n - out.len()) {
      Ok(x) => x
      Err(e) => return Err(archive_err("zip_open: ${e.display()}"))
    }
    match got {
      Some(b) => {
        if b.len() == 0 {
          return Err(archive_err("zip_open: unexpected EOF"))
        }
        out.write(b)
        at += b.len()
      }
      None => return Err(archive_err("zip_open: unexpected EOF"))
    }
  }
  out.freeze()
}

/// A zip archive of size bytes in the File f, read in place (decision
/// 0479): the tail and the central directory are read, each entry's
/// bytes only when it is read.
fn zip_open(f: File, size: Int) -> archive.ZipReader ! archive.ArchiveErr uses fs.read {
  if size < 22 {
    return Err(archive_err("zip_open: ${ERR_FORMAT}"))
  }
  var shift = if size > 67584 { size - 67584 } else { 0 }
  for _ in 0..3 {
    let data = read_span(f, shift, size - shift)?
    match zip_files_at(data, shift) {
      Ok(l) => return Ok(archive.ZipReader{data: b"", list: l, file: Some(f), total: size, note: zip_comment_of(data)})
      Err(e) => {
        if e.starts_with("NEED ") {
          let n = Int.parse(e[5..]) ?? -1
          if n >= 0 && n < shift {
            shift = n
            continue
          }
        }
        return Err(archive_err("zip_open: ${e}"))
      }
    }
  }
  Err(archive_err("zip_open: ${ERR_FORMAT}"))
}

fn zip_files_at(data: Bytes, shift: Int) -> List[archive.ZipFile] ! Str {
  let files = zip_directory_at(data, shift)?
  var out: List[archive.ZipFile] = []
  for zf in files {
    let (p, perm, is_dir) = zip_meta(zf)?
    out.push(archive.ZipFile{path: p, size: zf.usize, compressed: zf.csize, mode: perm, is_dir: is_dir, modified: Time.UNIX_EPOCH + Duration.from_nanos(zip_modified(zf)), offset: zf.offset, method: zf.method, flags: zf.flags, crc: zf.crc, _dir: zf.rec})
  }
  out
}

fn zipreader_files(r: archive.ZipReader) -> List[archive.ZipFile] { r.list }

fn zipreader_comment(r: archive.ZipReader) -> Str { r.note }

/// n bytes of the archive from off, fewer at its end (a ReaderAt's short
/// read), from memory or the File.
fn zr_bytes(r: archive.ZipReader, off: Int, n: Int) -> Bytes ! archive.ArchiveErr uses fs.read {
  match r.file {
    Some(file) => {
      if off >= r.total {
        return Ok(b"")
      }
      read_span(file, off, if off + n > r.total { r.total - off } else { n })
    }
    None => {
      let size = r.data.len()
      if off >= size {
        return Ok(b"")
      }
      Ok(sub(r.data, off, if off + n > size { size } else { off + n }))
    }
  }
}

/// findBodyOffset: the local header at f.offset read for its name and
/// extra lengths; the stored bytes' offset in the archive.
fn zipreader_data_offset(r: archive.ZipReader, f: archive.ZipFile) -> Int ! archive.ArchiveErr uses fs.read {
  if f.offset < 0 {
    return Err(archive_err("zip_reader: strings.Reader.ReadAt: negative offset"))
  }
  let head = zr_bytes(r, f.offset, 30)?
  if head.len() < 30 {
    return Err(archive_err("zip_reader: EOF"))
  }
  if get_u32(head, 0) != 0x04034b50 {
    return Err(archive_err("zip_reader: ${ERR_FORMAT}"))
  }
  Ok(f.offset + 30 + get_u16(head, 26) + get_u16(head, 28))
}

fn zipreader_raw(r: archive.ZipReader, f: archive.ZipFile) -> Bytes ! archive.ArchiveErr uses fs.read {
  let at = zipreader_data_offset(r, f)?
  zr_bytes(r, at, f.compressed)
}

/// The end record's comment (Reader.Comment), the directory already read.
fn zip_comment_of(data: Bytes) -> Str {
  let end_off = zip_find_end(data)
  if end_off < 0 {
    return ""
  }
  let n = get_u16(data, end_off + 20)
  scan.text_of(sub(data, end_off + 22, end_off + 22 + n))
}

/// The contents of one entry, inflated and checked (its CRC).
fn zipreader_read(r: archive.ZipReader, f: archive.ZipFile) -> Bytes ! archive.ArchiveErr uses fs.read {
  if f.is_dir {
    return Ok(b"")
  }
  var zf = ZipHdr{name: f.path, raw: b"", creator: 0, flags: f.flags, method: f.method, time: 0, date: 0, crc: f.crc, csize: f.compressed, usize: f.size, extra: b"", attrs: 0, offset: f.offset}
  var data = r.data
  match r.file {
    Some(file) => {
      let ho = f.offset
      if ho < 0 || ho + 30 > r.total {
        return Err(archive_err("zip_reader: EOF"))
      }
      let head = read_span(file, ho, 30)?
      let body = 30 + get_u16(head, 26) + get_u16(head, 28)
      var want = body + f.compressed + 16
      if ho + want > r.total {
        want = r.total - ho
      }
      data = read_span(file, ho, want)?
      zf.offset = 0
    }
    None => ()
  }
  match zip_read(data, zf, flate.crc_table(), flate.fixed_decoder()) {
    Ok(b) => b
    Err(e) => Err(archive_err("zip_reader: ${e}"))
  }
}

/// The contents of a file (File.Open and its checksumReader read to the
/// end).
fn zip_read(data: Bytes, zf: ZipHdr, t: List[Int], fixed: flate.HDec) -> Bytes ! Str {
  let size = data.len()
  let ho = zf.offset
  if ho < 0 {
    // the Go backend reads the archive through a strings.Reader
    return Err("strings.Reader.ReadAt: negative offset")
  }
  if ho >= size {
    return Err("EOF")
  }
  if size - ho < 30 {
    // strings.Reader.ReadAt's short read is io.EOF (findBodyOffset)
    return Err("EOF")
  }
  if get_u32(data, ho) != 0x04034b50 {
    return Err(ERR_FORMAT)
  }
  let body = ho + 30 + get_u16(data, ho + 26) + get_u16(data, ho + 28)
  var end = body + zf.csize
  if end > size {
    end = size
  }
  var content = b""
  if zf.method == 0 {
    if body < end {
      content = sub(data, body, end)
    }
    if content.len() > zf.usize {
      return Err(ERR_FORMAT)
    }
  } else if zf.method == 8 {
    // stop as the output passes the declared size (Go's checksumReader:
    // ErrFormat once more than UncompressedSize64 is read), instead of
    // inflating a hostile entry to the end first
    var f = flate.Inflater{data: data, pos: body, start: body, end: end, b: 0, nb: 0, out: [], out_start: 0, limit: zf.usize}
    match f.inflate(fixed) {
      Ok(_) => ()
      Err(e) => {
        if e == flate.LIMIT || f.out.len() > zf.usize {
          return Err(ERR_FORMAT)
        }
        return Err(e)
      }
    }
    if f.out.len() > zf.usize {
      return Err(ERR_FORMAT)
    }
    content = flate.list_bytes(f.out)
  } else {
    return Err("zip: unsupported compression algorithm")
  }
  if content.len() != zf.usize {
    return Err("unexpected EOF")
  }
  let sum = flate.crc32(t, 0, content)
  if (zf.flags & 0x8) != 0 {
    // the data descriptor after the body: an optional signature, the CRC
    let d = body + zf.csize
    var avail = size - d
    if avail > 16 {
      avail = 16
    }
    if avail < 4 {
      return Err("unexpected EOF")
    }
    let sig = get_u32(data, d) == 0x08074b50
    let need = if sig { 16 } else { 12 }
    if avail < need {
      return Err("unexpected EOF")
    }
    let crc_field = if sig { get_u32(data, d + 4) } else { get_u32(data, d) }
    if crc_field != zf.crc || sum != zf.crc {
      return Err("zip: checksum error")
    }
  } else if zf.crc != 0 && sum != zf.crc {
    return Err("zip: checksum error")
  }
  content
}
