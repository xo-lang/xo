/// The data of the generator's lcg(seed, n, k).
fn lcg(seed: Int, n: Int, k: Int) -> Bytes {
  var x = seed & 0x7fffffff
  var b = BytesBuilder.with_capacity(n)
  var i = 0
  while i < n {
    x = (x * 1103515245 + 12345) & 0x7fffffff
    let v = x >> 8
    b.write_byte(UInt8(if k < 256 { 97 + v % k } else { v & 255 }))
    i += 1
  }
  b.freeze()
}

fn sum(b: Bytes) -> Str { crypto.sha256(b)[0..8].to_hex() }

fn listing(r: Result[List[archive.Entry], archive.ArchiveErr]) -> Str {
  match r {
    Err(e) => "err ${e.display()}"
    Ok(es) => {
      var parts: List[Str] = []
      for e in es {
        parts.push("${e.path}|${e.mode.to_str_base(8)}|${e.is_dir}|${e.modified.unix_millis()}|${e.data.len()}|${sum(e.data)}")
      }
      parts.join(";")
    }
  }
}

fn entries(l: List[(Str, Int, Int, Int, Bool, Int)]) -> List[archive.Entry] {
  var out: List[archive.Entry] = []
  for (p, seed, n, mode, d, ms) in l {
    out.push(archive.Entry{path: p, data: if d { b"" } else { lcg(seed, n, 256) }, mode: mode, is_dir: d, modified: Time.from_unix_millis(ms)})
  }
  out
}

fn written(r: Result[Bytes, archive.ArchiveErr]) -> Str {
  match r {
    Ok(b) => "${b.len()} ${sum(b)}"
    Err(e) => "err ${e.display()}"
  }
}

test "gzip gives Go's bytes" {
  var bad: List[(Int, Int, Int, Str, Str)] = []
  for (seed, n, k, len, sha) in GO_GZIP {
    let z = gzip(lcg(seed, n, k))
    let got = "${z.len()} ${sum(z)}"
    if got != "${len} ${sha}" {
      bad.push((seed, n, k, got, "${len} ${sha}"))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}

test "gunzip of Go's streams, corrupted ones too" {
  var bad: List[(Int, Str, Str)] = []
  for (i, (z, want)) in GO_GUNZIP.indexed() {
    let got = match gunzip(z) {
      Ok(b) => "ok ${b.len()} ${sum(b)}"
      Err(e) => "err ${e.display()}"
    }
    if got != want {
      bad.push((i, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}

test "tar and zip give Go's bytes" {
  var bad: List[(Int, Str, Str)] = []
  for (i, (l, want_tar, want_zip)) in GO_WRITE.indexed() {
    let es = entries(l)
    let t = written(tar(es))
    let z = written(zip(es))
    if t != want_tar {
      bad.push((i, "tar " + t, want_tar))
    }
    if z != want_zip {
      bad.push((i, "zip " + z, want_zip))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}

test "untar and unzip of Go's test archives" {
  var bad: List[(Str, Str, Str)] = []
  for (name, data, want) in GO_READ {
    let got = if name.ends_with(".tar") { listing(untar(data)) } else { listing(unzip(data)) }
    if got != want {
      bad.push((name, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}
