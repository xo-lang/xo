// std/template on the native backends (decision 0299): Go's text/template
// ported to Xo (parse/lex.go, parse/parse.go, parse/node.go, exec.go,
// funcs.go of go1.26), executing over json.Value with the types Go's
// reflection sees in the Go backend's data (int64, float64, string, bool,
// []interface {}, map[string]interface {}, nil): the same output and
// error texts as std/rt's template.go, which runs text/template itself.
use std/json
use std/template
use std/html
use std/url
use native/rt

fn templateerr_display(e: template.TemplateErr) -> Str { e.msg }

// ---------------------------------------------------------------------------
// The lexer (parse/lex.go)

const I_ERROR = 0
const I_BOOL = 1
const I_CHAR = 2
const I_CHAR_CONST = 3
const I_COMMENT = 4
const I_COMPLEX = 5
const I_ASSIGN = 6
const I_DECLARE = 7
const I_EOF = 8
const I_FIELD = 9
const I_IDENT = 10
const I_LDELIM = 11
const I_LPAREN = 12
const I_NUMBER = 13
const I_PIPE = 14
const I_RAW_STRING = 15
const I_RDELIM = 16
const I_RPAREN = 17
const I_SPACE = 18
const I_STRING = 19
const I_TEXT = 20
const I_VARIABLE = 21
const I_KEYWORD = 22
const I_BLOCK = 23
const I_BREAK = 24
const I_CONTINUE = 25
const I_DOT = 26
const I_DEFINE = 27
const I_ELSE = 28
const I_END = 29
const I_IF = 30
const I_NIL = 31
const I_RANGE = 32
const I_TEMPLATE = 33
const I_WITH = 34

struct Item {
  typ: Int
  pos: Int
  val: Str
  line: Int
}

/// item.String: how an error shows a token.
fn item_text(i: Item) -> Str {
  if i.typ == I_EOF {
    return "EOF"
  }
  if i.typ == I_ERROR {
    return i.val
  }
  if i.typ > I_KEYWORD {
    return "<${i.val}>"
  }
  if i.val.runes().len() > 10 {
    return go_quote(i.val.runes()[0..10].map(fn(r) { "${r}" }).join("")) + "..."
  }
  go_quote(i.val)
}

fn keyword(word: Str) -> Int {
  match word {
    "." => I_DOT
    "block" => I_BLOCK
    "break" => I_BREAK
    "continue" => I_CONTINUE
    "define" => I_DEFINE
    "else" => I_ELSE
    "end" => I_END
    "if" => I_IF
    "range" => I_RANGE
    "nil" => I_NIL
    "template" => I_TEMPLATE
    "with" => I_WITH
    _ => 0
  }
}

struct Lexer {
  input: Bytes
  left: Bytes
  right: Bytes
  pos: Int = 0
  start: Int = 0
  at_eof: Bool = false
  paren_depth: Int = 0
  line: Int = 1
  start_line: Int = 1
  item: Item = Item{typ: I_EOF, pos: 0, val: "EOF", line: 1}
  inside_action: Bool = false
}

const EOF_R: Int = -1

fn is_space_r(r: Int) -> Bool { r == 32 || r == 9 || r == 13 || r == 10 }

fn is_alnum(r: Int) -> Bool { r == 95 || (r >= 0 && (Rune(r).is_letter() || Rune(r).is_digit())) }

/// Whether p is in b at at, compared by index (no slice: a call in a scan
/// loop makes no view, XO0913).
fn has_prefix_at(b: Bytes, at: Int, p: Bytes) -> Bool {
  if at + p.len() > b.len() {
    return false
  }
  for j in 0..p.len() {
    if b[at + j] != p[j] {
      return false
    }
  }
  true
}

/// strings.Index of p in b from from, relative to from; -1 when absent
/// (Bytes.find's scan, not a slice compared at every offset: XO0913).
fn index_of(b: Bytes, from: Int, p: Bytes) -> Int { b[from..b.len()].find(p) ?? -1 }

fn count_nl(b: Bytes, lo: Int, hi: Int) -> Int {
  var n = 0
  for k in lo..hi {
    if b[k] == '\n' {
      n += 1
    }
  }
  n
}

fn (var l: Lexer) next() -> Int {
  if l.pos >= l.input.len() {
    l.at_eof = true
    return EOF_R
  }
  let (r, w) = l.input.decode_rune(l.pos)
  l.pos += w
  if r == '\n' {
    l.line += 1
  }
  Int(r)
}

fn (var l: Lexer) backup() {
  if !l.at_eof && l.pos > 0 {
    // the start of the last rune
    var p = l.pos - 1
    while p > 0 && (l.input[p] & 0xC0) == 0x80 {
      p -= 1
    }
    if l.input[p] == '\n' {
      l.line -= 1
    }
    l.pos = p
  }
}

fn (var l: Lexer) peek() -> Int {
  let r = l.next()
  l.backup()
  r
}

fn (var l: Lexer) this_item(t: Int) -> Item {
  let i = Item{typ: t, pos: l.start, val: l.input[l.start..l.pos].to_str() ?? "", line: l.start_line}
  l.start = l.pos
  l.start_line = l.line
  i
}

fn (var l: Lexer) ignore() {
  l.line += count_nl(l.input, l.start, l.pos)
  l.start = l.pos
  l.start_line = l.line
}

fn (var l: Lexer) accept(valid: Str) -> Bool {
  let r = l.next()
  if r >= 0 && valid.contains("${Rune(r)}") {
    return true
  }
  l.backup()
  false
}

fn (var l: Lexer) accept_run(valid: Str) {
  while true {
    let r = l.next()
    if r < 0 || !valid.contains("${Rune(r)}") {
      break
    }
  }
  l.backup()
}

fn (var l: Lexer) errorf(msg: Str) {
  l.item = Item{typ: I_ERROR, pos: l.start, val: msg, line: l.start_line}
  l.start = 0
  l.pos = 0
  l.input = b""
}

fn left_trim_marker(b: Bytes, at: Int) -> Bool { at + 2 <= b.len() && b[at] == '-' && is_space_r(Int(b[at + 1])) }

fn right_trim_marker(b: Bytes, at: Int) -> Bool { at + 2 <= b.len() && is_space_r(Int(b[at])) && b[at + 1] == '-' }

fn (l: Lexer) at_right_delim() -> (Bool, Bool) {
  if right_trim_marker(l.input, l.pos) && has_prefix_at(l.input, l.pos + 2, l.right) {
    return (true, true)
  }
  if has_prefix_at(l.input, l.pos, l.right) {
    return (true, false)
  }
  (false, false)
}

fn (var l: Lexer) at_terminator() -> Bool {
  let r = l.peek()
  if is_space_r(r) {
    return true
  }
  if r == EOF_R || r == '.' || r == ',' || r == '|' || r == ':' || r == ')' || r == '(' {
    return true
  }
  has_prefix_at(l.input, l.pos, l.right)
}

/// The next item (nextItem): runs the state functions to the next emit.
fn (var l: Lexer) next_item() -> Item {
  l.item = Item{typ: I_EOF, pos: l.pos, val: "EOF", line: l.start_line}
  var state = if l.inside_action { 2 } else { 1 }
  while state != 0 {
    state = l.step(state)
  }
  l.item
}

// states: 1 text, 2 inside action, 3 left delim, 4 comment, 5 right delim,
// 6 space, 7 identifier, 8 field, 9 variable, 10 char, 11 number,
// 12 quote, 13 raw quote; 0 emitted
fn (var l: Lexer) step(state: Int) -> Int {
  match state {
    1 => l.lex_text()
    2 => l.lex_inside_action()
    3 => l.lex_left_delim()
    4 => l.lex_comment()
    5 => l.lex_right_delim()
    6 => l.lex_space()
    7 => l.lex_identifier()
    8 => l.lex_field_or_variable(I_FIELD)
    9 => {
      if l.at_terminator() {
        l.item = l.this_item(I_VARIABLE)
        0
      } else {
        l.lex_field_or_variable(I_VARIABLE)
      }
    }
    10 => l.lex_quoted('\'', I_CHAR_CONST, "unterminated character constant")
    11 => l.lex_number()
    12 => l.lex_quoted('"', I_STRING, "unterminated quoted string")
    13 => l.lex_raw_quote()
    _ => 0
  }
}

fn (var l: Lexer) emit(t: Int) -> Int {
  l.item = l.this_item(t)
  0
}

fn (var l: Lexer) lex_text() -> Int {
  let x = index_of(l.input, l.pos, l.left)
  if x >= 0 {
    if x > 0 {
      l.pos += x
      var trim = 0
      let delim_end = l.pos + l.left.len()
      if left_trim_marker(l.input, delim_end) {
        // rightTrimLength of the text before the delimiter
        var k = l.pos
        while k > l.start && is_space_r(Int(l.input[k - 1])) {
          k -= 1
        }
        trim = l.pos - k
      }
      l.pos -= trim
      l.line += count_nl(l.input, l.start, l.pos)
      let i = l.this_item(I_TEXT)
      l.pos += trim
      l.ignore()
      if i.val.len() > 0 {
        l.item = i
        return 0
      }
    }
    return 3
  }
  l.pos = l.input.len()
  if l.pos > l.start {
    l.line += count_nl(l.input, l.start, l.pos)
    return l.emit(I_TEXT)
  }
  l.emit(I_EOF)
}

fn (var l: Lexer) lex_left_delim() -> Int {
  l.pos += l.left.len()
  let trim_space = left_trim_marker(l.input, l.pos)
  let after = if trim_space { 2 } else { 0 }
  if has_prefix_at(l.input, l.pos + after, b"/*") {
    l.pos += after
    l.ignore()
    return 4
  }
  let i = l.this_item(I_LDELIM)
  l.inside_action = true
  l.pos += after
  l.ignore()
  l.paren_depth = 0
  l.item = i
  0
}

fn (var l: Lexer) lex_comment() -> Int {
  l.pos += 2
  let x = index_of(l.input, l.pos, b"*/")
  if x < 0 {
    l.errorf("unclosed comment")
    return 0
  }
  l.pos += x + 2
  let (delim, trim_space) = l.at_right_delim()
  if !delim {
    l.errorf("comment ends before closing delimiter")
    return 0
  }
  l.line += count_nl(l.input, l.start, l.pos)
  let _i = l.this_item(I_COMMENT)
  if trim_space {
    l.pos += 2
  }
  l.pos += l.right.len()
  if trim_space {
    while l.pos < l.input.len() && is_space_r(Int(l.input[l.pos])) {
      l.pos += 1
    }
  }
  l.ignore()
  1
}

fn (var l: Lexer) lex_right_delim() -> Int {
  let (_, trim_space) = l.at_right_delim()
  if trim_space {
    l.pos += 2
    l.ignore()
  }
  l.pos += l.right.len()
  let i = l.this_item(I_RDELIM)
  if trim_space {
    while l.pos < l.input.len() && is_space_r(Int(l.input[l.pos])) {
      l.pos += 1
    }
    l.ignore()
  }
  l.inside_action = false
  l.item = i
  0
}

fn (var l: Lexer) lex_inside_action() -> Int {
  let (delim, _) = l.at_right_delim()
  if delim {
    if l.paren_depth == 0 {
      return 5
    }
    l.errorf("unclosed left paren")
    return 0
  }
  let r = l.next()
  if r == EOF_R {
    l.errorf("unclosed action")
    return 0
  }
  if is_space_r(r) {
    l.backup()
    return 6
  }
  if r == '=' {
    return l.emit(I_ASSIGN)
  }
  if r == ':' {
    if l.next() != '=' {
      l.errorf("expected :=")
      return 0
    }
    return l.emit(I_DECLARE)
  }
  if r == '|' {
    return l.emit(I_PIPE)
  }
  if r == '"' {
    return 12
  }
  if r == '`' {
    return 13
  }
  if r == '$' {
    return 9
  }
  if r == '\'' {
    return 10
  }
  if r == '.' {
    if l.pos < l.input.len() {
      let c = l.input[l.pos]
      if c < '0' || c > '9' {
        return 8
      }
    }
    l.backup()
    return 11
  }
  if r == '+' || r == '-' || (r >= '0' && r <= '9') {
    l.backup()
    return 11
  }
  if is_alnum(r) {
    l.backup()
    return 7
  }
  if r == '(' {
    l.paren_depth += 1
    return l.emit(I_LPAREN)
  }
  if r == ')' {
    l.paren_depth -= 1
    if l.paren_depth < 0 {
      l.errorf("unexpected right paren")
      return 0
    }
    return l.emit(I_RPAREN)
  }
  if r <= 127 && r >= 32 && r != 127 {
    return l.emit(I_CHAR)
  }
  l.errorf("unrecognized character in action: ${go_unicode(r)}")
  0
}

fn (var l: Lexer) lex_space() -> Int {
  var num = 0
  while true {
    let r = l.peek()
    if !is_space_r(r) {
      break
    }
    let _n = l.next()
    num += 1
  }
  if right_trim_marker(l.input, l.pos - 1) && has_prefix_at(l.input, l.pos - 1 + 2, l.right) {
    l.backup()
    if num == 1 {
      return 5
    }
  }
  l.emit(I_SPACE)
}

fn (var l: Lexer) lex_identifier() -> Int {
  while true {
    let r = l.next()
    if !is_alnum(r) {
      l.backup()
      let word = l.input[l.start..l.pos].to_str() ?? ""
      if !l.at_terminator() {
        l.errorf("bad character ${go_unicode(r)}")
        return 0
      }
      let k = keyword(word)
      if k > I_KEYWORD {
        return l.emit(k)
      }
      if word.starts_with(".") {
        return l.emit(I_FIELD)
      }
      if word == "true" || word == "false" {
        return l.emit(I_BOOL)
      }
      return l.emit(I_IDENT)
    }
  }
  0
}

fn (var l: Lexer) lex_field_or_variable(typ: Int) -> Int {
  if l.at_terminator() {
    return l.emit(if typ == I_VARIABLE { I_VARIABLE } else { I_DOT })
  }
  var r = 0
  while true {
    r = l.next()
    if !is_alnum(r) {
      l.backup()
      break
    }
  }
  if !l.at_terminator() {
    l.errorf("bad character ${go_unicode(r)}")
    return 0
  }
  l.emit(typ)
}

fn (var l: Lexer) lex_quoted(q: Rune, typ: Int, msg: Str) -> Int {
  while true {
    let r = l.next()
    if r == '\\' {
      let r2 = l.next()
      if r2 != EOF_R && r2 != '\n' {
        continue
      }
      l.errorf(msg)
      return 0
    }
    if r == EOF_R || r == '\n' {
      l.errorf(msg)
      return 0
    }
    if r == Int(q) {
      break
    }
  }
  l.emit(typ)
}

fn (var l: Lexer) lex_raw_quote() -> Int {
  while true {
    let r = l.next()
    if r == EOF_R {
      l.errorf("unterminated raw quoted string")
      return 0
    }
    if r == '`' {
      break
    }
  }
  l.emit(I_RAW_STRING)
}

fn (var l: Lexer) scan_number() -> Bool {
  let _s = l.accept("+-")
  var digits = "0123456789_"
  if l.accept("0") {
    if l.accept("xX") {
      digits = "0123456789abcdefABCDEF_"
    } else if l.accept("oO") {
      digits = "01234567_"
    } else if l.accept("bB") {
      digits = "01_"
    }
  }
  l.accept_run(digits)
  if l.accept(".") {
    l.accept_run(digits)
  }
  if digits.len() == 11 && l.accept("eE") {
    let _a = l.accept("+-")
    l.accept_run("0123456789_")
  }
  if digits.len() == 23 && l.accept("pP") {
    let _a = l.accept("+-")
    l.accept_run("0123456789_")
  }
  let _i = l.accept("i")
  if is_alnum(l.peek()) {
    let _n = l.next()
    return false
  }
  true
}

fn (var l: Lexer) lex_number() -> Int {
  if !l.scan_number() {
    l.errorf("bad number syntax: ${go_quote(l.input[l.start..l.pos].to_str() ?? "")}")
    return 0
  }
  let sign = l.peek()
  if sign == '+' || sign == '-' {
    if !l.scan_number() || l.input[l.pos - 1] != 'i' {
      l.errorf("bad number syntax: ${go_quote(l.input[l.start..l.pos].to_str() ?? "")}")
      return 0
    }
    return l.emit(I_COMPLEX)
  }
  l.emit(I_NUMBER)
}

// ---------------------------------------------------------------------------
// Go's fmt and strconv texts

fn go_quote(s: Str) -> Str { s.quote() }

/// fmt's %#U: `U+0041 'A'` (the character when it is printable).
fn go_unicode(r: Int) -> Str {
  if r < 0 {
    return "U+FFFFFFFFFFFFFFFF"
  }
  var hex = r.to_str_base(16).to_upper()
  while hex.len() < 4 {
    hex = "0" + hex
  }
  if Rune(r).is_print() {
    return "U+${hex} '${Rune(r)}'"
  }
  "U+${hex}"
}

/// fmt's %v of a float64: the shortest 'g' text, as Xo's Float text
/// without its added ".0".
fn go_float(f: Float) -> Str {
  let s = "${f}"
  if s.ends_with(".0") && !s.contains("e") {
    return s[0..s.len() - 2]
  }
  s
}

// ---------------------------------------------------------------------------
// Nodes (parse/node.go)

struct Num {
  text: Str
  is_int: Bool = false
  int: Int = 0
  is_uint: Bool = false
  is_float: Bool = false
  float: Float = 0.0
  is_complex: Bool = false
  re: Float = 0.0
  im: Float = 0.0
}

enum Arg {
  Field(pos: Int, ident: List[Str])
  Chain(pos: Int, node: List[Arg], field: List[Str])
  Ident(pos: Int, name: Str)
  PipeA(pipe: List[Pipe])
  Variable(pos: Int, ident: List[Str])
  BoolA(pos: Int, b: Bool)
  Dot(pos: Int)
  NilA(pos: Int)
  Number(pos: Int, n: Num)
  StringA(pos: Int, quoted: Str, text: Str)
}

struct Cmd {
  pos: Int
  args: List[Arg] = []
}

struct Pipe {
  pos: Int
  line: Int
  is_assign: Bool = false
  decl: List[Str] = []
  cmds: List[Cmd] = []
}

enum Node {
  Text(pos: Int, text: Str)
  Action(pos: Int, line: Int, pipe: Pipe)
  Comment(pos: Int)
  If(pos: Int, line: Int, pipe: Pipe, list: List[Node], else_list: List[Node]?)
  Range(pos: Int, line: Int, pipe: Pipe, list: List[Node], else_list: List[Node]?)
  With(pos: Int, line: Int, pipe: Pipe, list: List[Node], else_list: List[Node]?)
  TemplateN(pos: Int, line: Int, name: Str, pipe: Pipe?)
  Break(pos: Int, line: Int)
  Continue(pos: Int, line: Int)
  End(pos: Int)
  Else(pos: Int, line: Int)
}

fn arg_pos(a: Arg) -> Int {
  match a {
    Field(pos, ..) => pos
    Chain(pos, ..) => pos
    Ident(pos, ..) => pos
    PipeA(p) => p[0].pos
    Variable(pos, ..) => pos
    BoolA(pos, ..) => pos
    Dot(pos) => pos
    NilA(pos) => pos
    Number(pos, ..) => pos
    StringA(pos, ..) => pos
  }
}

fn arg_text(a: Arg) -> Str {
  match a {
    Field(_, ident) => ident.map(fn(i) { "." + i }).join("")
    Chain(_, node, field) => {
      let base = match node[0] {
        PipeA(..) => "(" + arg_text(node[0]) + ")"
        _ => arg_text(node[0])
      }
      base + field.map(fn(f) { "." + f }).join("")
    }
    Ident(_, name) => name
    PipeA(p) => pipe_text(p[0])
    Variable(_, ident) => ident.join(".")
    BoolA(_, b) => if b { "true" } else { "false" }
    Dot(_) => "."
    NilA(_) => "nil"
    Number(_, n) => n.text
    StringA(_, quoted, _) => quoted
  }
}

fn cmd_text(c: Cmd) -> Str {
  c.args.map(fn(a) {
    match a {
      PipeA(..) => "(" + arg_text(a) + ")"
      _ => arg_text(a)
    }
  }).join(" ")
}

fn pipe_text(p: Pipe) -> Str {
  var s = ""
  if !p.decl.is_empty() {
    s = p.decl.join(", ") + (if p.is_assign { " = " } else { " := " })
  }
  s + p.cmds.map(cmd_text).join(" | ")
}

fn list_text(l: List[Node]) -> Str { l.map(node_text).join("") }

fn node_text(n: Node) -> Str {
  match n {
    Text(_, text) => go_quote(text)
    Action(_, _, pipe) => "{{${pipe_text(pipe)}}}"
    Comment(..) => "{{/* */}}"
    If(_, _, pipe, list, el) => ctl_text("if", pipe, list, el)
    Range(_, _, pipe, list, el) => ctl_text("range", pipe, list, el)
    With(_, _, pipe, list, el) => ctl_text("with", pipe, list, el)
    TemplateN(_, _, name, pipe) => match pipe {
      Some(p) => "{{template ${go_quote(name)} ${pipe_text(p)}}}"
      None => "{{template ${go_quote(name)}}}"
    }
    Break(..) => "{{break}}"
    Continue(..) => "{{continue}}"
    End(_) => "{{end}}"
    Else(..) => "{{else}}"
  }
}

fn ctl_text(name: Str, pipe: Pipe, list: List[Node], el: List[Node]?) -> Str {
  match el {
    Some(e) => "{{${name} ${pipe_text(pipe)}}}${list_text(list)}{{else}}${list_text(e)}{{end}}"
    None => "{{${name} ${pipe_text(pipe)}}}${list_text(list)}{{end}}"
  }
}

fn node_pos(n: Node) -> Int {
  match n {
    Text(pos, ..) => pos
    Action(pos, ..) => pos
    Comment(pos) => pos
    If(pos, ..) => pos
    Range(pos, ..) => pos
    With(pos, ..) => pos
    TemplateN(pos, ..) => pos
    Break(pos, ..) => pos
    Continue(pos, ..) => pos
    End(pos) => pos
    Else(pos, ..) => pos
  }
}

/// parse.IsEmptyTree.
fn is_empty_tree(l: List[Node]) -> Bool {
  for n in l {
    match n {
      Comment(..) => {}
      Text(_, t) => {
        if !t.trim().is_empty() {
          return false
        }
      }
      _ => return false
    }
  }
  true
}

/// A parsed template (parse.Tree): its name, the name of the template
/// whose text holds it (error locations), that text, and its nodes.
struct Tree {
  name: Str
  parse_name: Str
  text: Bytes
  root: List[Node]
}

// ---------------------------------------------------------------------------
// The parser (parse/parse.go)

const BUILTINS: List[Str] = ["and", "call", "html", "index", "slice", "js", "len", "not", "or", "print", "printf", "println", "urlquery", "eq", "ge", "gt", "le", "lt", "ne"]

struct Parser {
  /// the user functions' names (template.Template.funcs, decision 0408)
  funcs: List[Str] = []
  lex: Lexer
  name: Str
  parse_name: Str
  text: Bytes
  token: List[Item] = []
  peek_count: Int = 0
  vars: List[Str] = ["$"]
  action_line: Int = 0
  range_depth: Int = 0
  err: Str = ""
  trees: List[Tree] = []
}

/// The parse error, set once; every step returns at once after it.
fn (var p: Parser) fail(msg: Str) {
  if p.err.is_empty() {
    let line = if p.token.is_empty() { 0 } else { p.token[0].line }
    p.err = "template: ${p.parse_name}:${line}: ${msg}"
  }
}

fn (var p: Parser) next() -> Item {
  if p.token.is_empty() {
    p.token = [Item{typ: I_EOF, pos: 0, val: "", line: 0}, Item{typ: I_EOF, pos: 0, val: "", line: 0}, Item{typ: I_EOF, pos: 0, val: "", line: 0}]
  }
  if p.peek_count > 0 {
    p.peek_count -= 1
  } else {
    p.token[0] = p.lex.next_item()
  }
  p.token[p.peek_count]
}

fn (var p: Parser) backup() { p.peek_count += 1 }

fn (var p: Parser) backup2(t1: Item) {
  p.token[1] = t1
  p.peek_count = 2
}

fn (var p: Parser) backup3(t2: Item, t1: Item) {
  p.token[1] = t1
  p.token[2] = t2
  p.peek_count = 3
}

fn (var p: Parser) peek() -> Item {
  if p.token.is_empty() {
    p.token = [Item{typ: I_EOF, pos: 0, val: "", line: 0}, Item{typ: I_EOF, pos: 0, val: "", line: 0}, Item{typ: I_EOF, pos: 0, val: "", line: 0}]
  }
  if p.peek_count > 0 {
    return p.token[p.peek_count - 1]
  }
  p.peek_count = 1
  p.token[0] = p.lex.next_item()
  p.token[0]
}

fn (var p: Parser) next_non_space() -> Item {
  while true {
    let t = p.next()
    if t.typ != I_SPACE {
      return t
    }
  }
  p.next()
}

fn (var p: Parser) peek_non_space() -> Item {
  let t = p.next_non_space()
  p.backup()
  t
}

fn (var p: Parser) unexpected(t: Item, context: Str) {
  if t.typ == I_ERROR {
    var extra = ""
    if p.action_line != 0 && p.action_line != t.line {
      extra = " in action started at ${p.parse_name}:${p.action_line}"
      if t.val.ends_with(" action") {
        extra = extra[" in action".len()..]
      }
    }
    p.fail("${item_text(t)}${extra}")
    return
  }
  p.fail("unexpected ${item_text(t)} in ${context}")
}

fn (var p: Parser) expect(typ: Int, context: Str) -> Item {
  let t = p.next_non_space()
  if t.typ != typ {
    p.unexpected(t, context)
  }
  t
}

/// The top level of a template (Tree.parse); define blocks become trees.
fn (var p: Parser) parse() -> List[Node] {
  var root: List[Node] = []
  while p.err.is_empty() && p.peek().typ != I_EOF {
    if p.peek().typ == I_LDELIM {
      let delim = p.next()
      if p.next_non_space().typ == I_DEFINE {
        p.parse_definition()
        continue
      }
      p.backup2(delim)
    }
    let n = p.text_or_action()
    if !p.err.is_empty() {
      break
    }
    match n {
      End(..) => p.fail("unexpected ${node_text(n)}")
      Else(..) => p.fail("unexpected ${node_text(n)}")
      _ => root.push(n)
    }
  }
  root
}

/// Adds a tree (Tree.add): an empty later definition is ignored; two
/// non empty ones are an error.
fn (var p: Parser) add_tree(t: Tree) {
  var at = -1
  for (i, x) in p.trees.indexed() {
    if x.name == t.name {
      at = i
    }
  }
  if at < 0 {
    p.trees.push(t)
    return
  }
  if is_empty_tree(p.trees[at].root) {
    p.trees[at] = t
    return
  }
  if !is_empty_tree(t.root) {
    p.fail("template: multiple definition of template ${go_quote(t.name)}")
  }
}

fn (var p: Parser) parse_definition() {
  let context = "define clause"
  let t = p.next_non_space()
  if t.typ != I_STRING && t.typ != I_RAW_STRING {
    p.unexpected(t, context)
    return
  }
  let name = t.val.unquote() ?? ""
  let _e = p.expect(I_RDELIM, context)
  let saved_vars = p.vars
  p.vars = ["$"]
  let (list, end) = p.item_list()
  p.vars = saved_vars
  if !p.err.is_empty() {
    return
  }
  match end {
    End(..) => {}
    _ => {
      p.fail("unexpected ${node_text(end)} in ${context}")
      return
    }
  }
  p.add_tree(Tree{name: name, parse_name: p.parse_name, text: p.text, root: list})
}

fn (var p: Parser) item_list() -> (List[Node], Node) {
  var list: List[Node] = []
  while p.err.is_empty() && p.peek_non_space().typ != I_EOF {
    let n = p.text_or_action()
    match n {
      End(..) => return (list, n)
      Else(..) => return (list, n)
      _ => list.push(n)
    }
  }
  p.fail("unexpected EOF")
  (list, Node.End(pos: 0))
}

fn (var p: Parser) text_or_action() -> Node {
  let t = p.next_non_space()
  if t.typ == I_TEXT {
    return Node.Text(pos: t.pos, text: t.val)
  }
  if t.typ == I_LDELIM {
    p.action_line = t.line
    let n = p.action()
    p.action_line = 0
    return n
  }
  if t.typ == I_COMMENT {
    return Node.Comment(pos: t.pos)
  }
  p.unexpected(t, "input")
  Node.Comment(pos: 0)
}

fn (var p: Parser) action() -> Node {
  let t = p.next_non_space()
  if t.typ == I_BLOCK {
    return p.block_control()
  }
  if t.typ == I_BREAK || t.typ == I_CONTINUE {
    let what = if t.typ == I_BREAK { "{{break}}" } else { "{{continue}}" }
    let t2 = p.next_non_space()
    if t2.typ != I_RDELIM {
      p.unexpected(t2, what)
    }
    if p.range_depth == 0 {
      p.fail("${what} outside {{range}}")
    }
    return if t.typ == I_BREAK { Node.Break(pos: t.pos, line: t.line) } else { Node.Continue(pos: t.pos, line: t.line) }
  }
  if t.typ == I_ELSE {
    let pk = p.peek_non_space()
    if pk.typ == I_IF || pk.typ == I_WITH {
      return Node.Else(pos: pk.pos, line: pk.line)
    }
    let t2 = p.expect(I_RDELIM, "else")
    return Node.Else(pos: t2.pos, line: t2.line)
  }
  if t.typ == I_END {
    return Node.End(pos: p.expect(I_RDELIM, "end").pos)
  }
  if t.typ == I_IF || t.typ == I_RANGE || t.typ == I_WITH {
    return p.control(t.typ)
  }
  if t.typ == I_TEMPLATE {
    return p.template_control()
  }
  p.backup()
  let tok = p.peek()
  let pipe = p.pipeline("command", I_RDELIM)
  Node.Action(pos: tok.pos, line: tok.line, pipe: pipe)
}

fn (var p: Parser) control(kind: Int) -> Node {
  let context = if kind == I_IF { "if" } else if kind == I_RANGE { "range" } else { "with" }
  let nvars = p.vars.len()
  let pipe = p.pipeline(context, I_RDELIM)
  if kind == I_RANGE {
    p.range_depth += 1
  }
  let (list, next) = p.item_list()
  if kind == I_RANGE {
    p.range_depth -= 1
  }
  var else_list: List[Node]? = None
  if p.err.is_empty() {
    match next {
      Else(pos, ..) => {
        if kind == I_IF && p.peek().typ == I_IF {
          let _t = p.next()
          else_list = Some([p.control(I_IF)])
        } else if kind == I_WITH && p.peek().typ == I_WITH {
          let _t = p.next()
          else_list = Some([p.control(I_WITH)])
        } else {
          let (el, n2) = p.item_list()
          else_list = Some(el)
          match n2 {
            End(..) => {}
            _ => p.fail("expected end; found ${node_text(n2)}")
          }
        }
        let _p = pos
      }
      _ => {}
    }
  }
  p.vars = p.vars[0..nvars]
  if kind == I_IF {
    return Node.If(pos: pipe.pos, line: pipe.line, pipe: pipe, list: list, else_list: else_list)
  }
  if kind == I_RANGE {
    return Node.Range(pos: pipe.pos, line: pipe.line, pipe: pipe, list: list, else_list: else_list)
  }
  Node.With(pos: pipe.pos, line: pipe.line, pipe: pipe, list: list, else_list: else_list)
}

fn (var p: Parser) template_name(t: Item, context: Str) -> Str {
  if t.typ == I_STRING || t.typ == I_RAW_STRING {
    return t.val.unquote() ?? ""
  }
  p.unexpected(t, context)
  ""
}

fn (var p: Parser) template_control() -> Node {
  let context = "template clause"
  let t = p.next_non_space()
  let name = p.template_name(t, context)
  var pipe: Pipe? = None
  if p.next_non_space().typ != I_RDELIM {
    p.backup()
    pipe = Some(p.pipeline(context, I_RDELIM))
  }
  Node.TemplateN(pos: t.pos, line: t.line, name: name, pipe: pipe)
}

fn (var p: Parser) block_control() -> Node {
  let context = "block clause"
  let t = p.next_non_space()
  let name = p.template_name(t, context)
  let pipe = p.pipeline(context, I_RDELIM)
  let saved_vars = p.vars
  p.vars = ["$"]
  let (list, end) = p.item_list()
  p.vars = saved_vars
  match end {
    End(..) => {}
    _ => p.fail("unexpected ${node_text(end)} in ${context}")
  }
  if p.err.is_empty() {
    p.add_tree(Tree{name: name, parse_name: p.parse_name, text: p.text, root: list})
  }
  Node.TemplateN(pos: t.pos, line: t.line, name: name, pipe: Some(pipe))
}

fn (var p: Parser) pipeline(context: Str, end: Int) -> Pipe {
  let tok = p.peek_non_space()
  var pipe = Pipe{pos: tok.pos, line: tok.line}
  var more_decls = true
  while more_decls && p.err.is_empty() {
    more_decls = false
    let v = p.peek_non_space()
    if v.typ == I_VARIABLE {
      let _v = p.next()
      let after = p.peek()
      let next = p.peek_non_space()
      if next.typ == I_ASSIGN || next.typ == I_DECLARE {
        pipe.is_assign = next.typ == I_ASSIGN
        let _n = p.next_non_space()
        pipe.decl.push(v.val)
        p.vars.push(v.val)
      } else if next.typ == I_CHAR && next.val == "," {
        let _n = p.next_non_space()
        pipe.decl.push(v.val)
        p.vars.push(v.val)
        if context == "range" && pipe.decl.len() < 2 {
          let k = p.peek_non_space().typ
          if k == I_VARIABLE || k == I_RDELIM || k == I_RPAREN {
            more_decls = true
            continue
          }
          p.fail("range can only initialize variables")
          return pipe
        }
        p.fail("too many declarations in ${context}")
        return pipe
      } else if after.typ == I_SPACE {
        p.backup3(v, after)
      } else {
        p.backup2(v)
      }
    }
  }
  while p.err.is_empty() {
    let t = p.next_non_space()
    if t.typ == end {
      if pipe.cmds.is_empty() {
        p.fail("missing value for ${context}")
      }
      for (i, c) in pipe.cmds.indexed() {
        if i > 0 {
          match c.args[0] {
            BoolA(..) | Dot(..) | NilA(..) | Number(..) | StringA(..) => p.fail("non executable command in pipeline stage ${i + 1}")
            Field(..) | Chain(..) | Ident(..) | PipeA(..) | Variable(..) => {}
          }
        }
      }
      return pipe
    }
    if t.typ == I_BOOL || t.typ == I_CHAR_CONST || t.typ == I_COMPLEX || t.typ == I_DOT || t.typ == I_FIELD || t.typ == I_IDENT || t.typ == I_NUMBER || t.typ == I_NIL || t.typ == I_RAW_STRING || t.typ == I_STRING || t.typ == I_VARIABLE || t.typ == I_LPAREN {
      p.backup()
      pipe.cmds.push(p.command())
    } else {
      p.unexpected(t, context)
    }
  }
  pipe
}

fn (var p: Parser) command() -> Cmd {
  var cmd = Cmd{pos: p.peek_non_space().pos}
  while p.err.is_empty() {
    let _s = p.peek_non_space()
    match p.operand() {
      Some(a) => cmd.args.push(a)
      None => {}
    }
    let t = p.next()
    if t.typ == I_SPACE {
      continue
    }
    if t.typ == I_RDELIM || t.typ == I_RPAREN {
      p.backup()
    } else if t.typ != I_PIPE {
      p.unexpected(t, "operand")
    }
    break
  }
  if cmd.args.is_empty() && p.err.is_empty() {
    p.fail("empty command")
  }
  cmd
}

fn (var p: Parser) operand() -> Arg? {
  let node = p.term()?
  if p.peek().typ == I_FIELD {
    let pos = p.peek().pos
    var fields: List[Str] = []
    while p.peek().typ == I_FIELD {
      fields.push(p.next().val[1..])
    }
    match node {
      Field(_, ident) => return Some(Arg.Field(pos: pos, ident: ident + fields))
      Variable(_, ident) => return Some(Arg.Variable(pos: pos, ident: ident + fields))
      BoolA(..) | StringA(..) | Number(..) | NilA(..) | Dot(..) => {
        p.fail("unexpected . after term ${go_quote(arg_text(node))}")
        return Some(node)
      }
      Chain(..) | Ident(..) | PipeA(..) => return Some(Arg.Chain(pos: pos, node: [node], field: fields))
    }
  }
  Some(node)
}

fn (var p: Parser) term() -> Arg? {
  let t = p.next_non_space()
  if t.typ == I_IDENT {
    if !BUILTINS.contains(t.val) && !p.funcs.contains(t.val) {
      p.fail("function ${go_quote(t.val)} not defined")
    }
    return Some(Arg.Ident(pos: t.pos, name: t.val))
  }
  if t.typ == I_DOT {
    return Some(Arg.Dot(pos: t.pos))
  }
  if t.typ == I_NIL {
    return Some(Arg.NilA(pos: t.pos))
  }
  if t.typ == I_VARIABLE {
    let ident = t.val.split(".")
    if !p.vars.contains(ident[0]) {
      p.fail("undefined variable ${go_quote(ident[0])}")
    }
    return Some(Arg.Variable(pos: t.pos, ident: ident))
  }
  if t.typ == I_FIELD {
    return Some(Arg.Field(pos: t.pos, ident: t.val[1..].split(".")))
  }
  if t.typ == I_BOOL {
    return Some(Arg.BoolA(pos: t.pos, b: t.val == "true"))
  }
  if t.typ == I_CHAR_CONST || t.typ == I_COMPLEX || t.typ == I_NUMBER {
    match new_number(t.val, t.typ) {
      Ok(n) => return Some(Arg.Number(pos: t.pos, n: n))
      Err(e) => {
        p.fail(e)
        return None
      }
    }
  }
  if t.typ == I_LPAREN {
    return Some(Arg.PipeA(pipe: [p.pipeline("parenthesized pipeline", I_RPAREN)]))
  }
  if t.typ == I_STRING || t.typ == I_RAW_STRING {
    match t.val.unquote() {
      Some(s) => return Some(Arg.StringA(pos: t.pos, quoted: t.val, text: s))
      None => {
        p.fail("invalid syntax")
        return None
      }
    }
  }
  p.backup()
  None
}

/// parse.NumberNode (newNumber): a number's int, uint, and float
/// readings; a uint beyond Int's range keeps only is_uint and its float.
fn new_number(text: Str, typ: Int) -> Num ! Str {
  var n = Num{text: text}
  if typ == I_CHAR_CONST {
    match text.unquote() {
      Some(s) => {
        let r = s.runes()
        if r.len() != 1 {
          return Err("malformed character constant: ${text}")
        }
        n.is_int = true
        n.int = Int(r[0])
        n.is_uint = true
        n.is_float = true
        n.float = Float(Int(r[0]))
        return Ok(n)
      }
      None => return Err("malformed character constant: ${text}")
    }
  }
  if typ == I_COMPLEX || text.ends_with("i") {
    // strconv.ParseComplex: [real](+|-)imag i, or imag i
    let body = text[0..text.len() - 1]
    let bs = body.bytes()
    var split = -1
    var k = bs.len() - 1
    while k > 0 {
      if (bs[k] == '+' || bs[k] == '-') && bs[k - 1] != 'e' && bs[k - 1] != 'E' && bs[k - 1] != 'p' && bs[k - 1] != 'P' {
        split = k
        break
      }
      k -= 1
    }
    let re_text = if split < 0 { "0" } else { body[0..split] }
    let im_text = if split < 0 { body } else { body[split..] }
    let re = match Float.parse(re_text) {
      Some(x) => x
      None => return Err("illegal number syntax: ${go_quote(text)}")
    }
    let im = match Float.parse(if im_text == "+" || im_text == "-" { im_text + "1" } else { im_text }) {
      Some(x) => x
      None => return Err("illegal number syntax: ${go_quote(text)}")
    }
    n.is_complex = true
    n.re = re
    n.im = im
    // simplifyComplex: an imaginary part of zero is a float (and an int)
    if im == 0.0 {
      n.is_float = true
      n.float = re
      if re == re.floor() && re.abs() < 9223372036854775808.0 {
        n.is_int = true
        n.int = Int(re)
      }
    }
    return Ok(n)
  }
  match Int.parse_base(text, 0) {
    Some(i) => {
      n.is_int = true
      n.int = i
      n.is_uint = i >= 0
      n.is_float = true
      n.float = Float(i)
      return Ok(n)
    }
    None => {}
  }
  // a uint above Int's range (ParseUint succeeds, ParseInt fails)
  let digits = text.trim_prefix("+")
  if !digits.is_empty() && digits.runes().all(fn(r) { (r >= '0' && r <= '9') || r == '_' }) {
    match Float.parse(digits) {
      Some(f) => {
        if f < 18446744073709551616.0 {
          n.is_uint = true
          n.is_float = true
          n.float = f
          return Ok(n)
        }
      }
      None => {}
    }
  }
  match Float.parse(text) {
    Some(f) => {
      if !text.contains(".") && !text.contains("e") && !text.contains("E") && !text.contains("p") && !text.contains("P") {
        return Err("integer overflow: ${go_quote(text)}")
      }
      n.is_float = true
      n.float = f
      if f == f.floor() && f.abs() < 9223372036854775808.0 {
        n.is_int = true
        n.int = Int(f)
      }
      if f == f.floor() && f >= 0.0 && f < 18446744073709551616.0 {
        n.is_uint = true
      }
    }
    None => {}
  }
  if !n.is_int && !n.is_uint && !n.is_float {
    return Err("illegal number syntax: ${go_quote(text)}")
  }
  Ok(n)
}

// ---------------------------------------------------------------------------
// Values as Go's reflection sees the Go backend's data (exec.go)

enum V {
  /// reflect.Value{}: a missing key, nil data
  Invalid
  /// a nil interface{} inside a list or map
  NilIface
  Bool(b: Bool)
  /// ty: "int" (a constant) or "int64" (data)
  IntV(n: Int, ty: Str)
  /// a uint constant beyond int (only its error is reachable)
  FloatV(f: Float)
  ComplexV(re: Float, im: Float)
  StrV(s: Str)
  /// trusted content (decision 0408): kind html, css, js, jsstr, url,
  /// attr or srcset; a string to everything but the html mode's escapers
  TrustedV(kind: Str, s: Str)
  ListV(items: List[V])
  /// map[string]interface {}: keys sorted
  MapV(fields: List[(Str, V)])
  /// exec.go missingVal: no final argument
  Missing
}

/// A value and whether it is an interface{} holding it (a list's or a
/// map's element, until a pipeline unwraps it).
struct Val {
  v: V
  boxed: Bool = false
}

fn val(v: V) -> Val { Val{v: v} }

fn invalid() -> Val { Val{v: V.Invalid} }

/// A user function's call (decision 0408): every argument evaluated, the
/// values as json.Values, the result back as a value.
fn (var s: Ex) call_user(dot: Val, name: Str, args0: List[Arg], final: Val, cmd_pos: Int, cmd_kind: Int, cmd_tag: Int) -> Val ! Str {
  let f = match s.funcs.get(name) {
    Some(f) => f
    None => return Err(s.err("function ${go_quote(name)} not defined"))
  }
  let args = if args0.is_empty() { args0 } else { args0[1..] }
  var jargs: List[json.Value] = []
  for a in args {
    jargs.push(json_of(unbox(s.eval_arg(dot, a)?).v))
  }
  if !is_missing(final) {
    jargs.push(json_of(unbox(final).v))
  }
  match f(jargs) {
    Ok(j) => Ok(val(of_json(j, true)))
    Err(e) => {
      // evalCall: the error is at the command
      s.node_pos = cmd_pos
      s.node_kind = cmd_kind
      s.node_tag = cmd_tag
      Err(s.err("error calling ${name}: ${e}"))
    }
  }
}

/// An escaping function the html mode inserted (escape.go's funcMap).
fn is_esc_fn(name: Str) -> Bool { name.starts_with("_html_template_") || name == "_eval_args_" }

/// stringify (content.go): one string or trusted argument as it is with
/// its content type, anything else printed (nil arguments dropped) as
/// plain text.
fn stringify(argv: List[Val]) -> (Str, Int) {
  if argv.len() == 1 {
    match unbox(argv[0]).v {
      StrV(s) => return (s, CONTENT_TYPE_PLAIN)
      TrustedV(kind, s) => return (s, content_type_of_kind(kind))
      _ => {}
    }
  }
  var kept: List[Val] = []
  for a in argv {
    match unbox(a).v {
      Invalid | NilIface => {}
      _ => kept.push(a)
    }
  }
  (sprint(kept), CONTENT_TYPE_PLAIN)
}

/// jsValEscaper's input: a trusted JS value is its text, a trusted JS
/// string is quoted, one value is its JSON encoding (nil is null),
/// several are their printed text as a JSON string.
fn js_val_json(argv: List[Val]) -> Str {
  if argv.len() == 1 {
    let v = unbox(argv[0]).v
    match v {
      TrustedV(kind, s) => {
        if kind == "js" {
          return s
        }
        if kind == "jsstr" {
          return "\"" + s + "\""
        }
      }
      Invalid | NilIface => return "null"
      _ => {}
    }
    return json_html_safe(json_of(v).encode())
  }
  json_html_safe(json.Value.Str(s: sprint(argv)).encode())
}

/// encoding/json's Marshal escapes `<`, `>` and `&` inside strings as
/// \u003c, \u003e and \u0026 (std/json's encode does not); in a JSON
/// text they occur only inside strings, so the text is replaced whole.
fn json_html_safe(j: Str) -> Str {
  if !j.contains_any("<>&") {
    return j
  }
  j.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
}

/// An escaper's call: its arguments evaluated, the function applied.
fn (var s: Ex) call_escaper(dot: Val, name: Str, args0: List[Arg], final: Val) -> Val ! Str {
  let args = if args0.is_empty() { args0 } else { args0[1..] }
  var argv: List[Val] = []
  for a in args {
    argv.push(s.eval_arg(dot, a)?)
  }
  if !is_missing(final) {
    argv.push(final)
  }
  if name == "_html_template_jsvalescaper" {
    if argv.len() == 1 {
      match unbox(argv[0]).v {
        TrustedV(kind, s) => {
          if kind == "js" {
            return Ok(val(V.StrV(s: s)))
          }
          if kind == "jsstr" {
            return Ok(val(V.StrV(s: "\"" + s + "\"")))
          }
        }
        _ => {}
      }
    }
    return Ok(val(V.StrV(s: js_val_escaper_json(js_val_json(argv)))))
  }
  if name == "_eval_args_" {
    return Ok(val(V.StrV(s: eval_args(argv))))
  }
  let (text, t) = stringify(argv)
  let out = match name {
    "_html_template_attrescaper" => attr_escaper(text, t)
    "_html_template_commentescaper" => comment_escaper(text, t)
    "_html_template_cssescaper" => css_escaper(text, t)
    "_html_template_cssvaluefilter" => css_value_filter(text, t)
    "_html_template_htmlnamefilter" => html_name_filter(text, t)
    "_html_template_htmlescaper" => html_escaper(text, t)
    "_html_template_jsregexpescaper" => js_regexp_escaper(text, t)
    "_html_template_jsstrescaper" => js_str_escaper(text, t)
    "_html_template_jstmpllitescaper" => js_tmpl_lit_escaper(text, t)
    "_html_template_nospaceescaper" => html_nospace_escaper(text, t)
    "_html_template_rcdataescaper" => rcdata_escaper(text, t)
    "_html_template_srcsetescaper" => srcset_filter_and_escaper(text, t)
    "_html_template_urlescaper" => url_escaper(text, t)
    "_html_template_urlfilter" => url_filter(text, t)
    "_html_template_urlnormalizer" => url_normalizer(text, t)
    _ => return Err("function ${go_quote(name)} not defined")
  }
  Ok(val(V.StrV(s: out)))
}

/// A value as a json.Value (call_user's arguments).
fn json_of(v: V) -> json.Value {
  match v {
    Invalid | NilIface | Missing => json.Value.Null
    Bool(b) => json.Value.Bool(b: b)
    IntV(n, _) => json.Value.Int(n: n)
    FloatV(f) => json.Value.Num(n: f)
    ComplexV(re, _) => json.Value.Num(n: re)
    StrV(s) => json.Value.Str(s: s)
    TrustedV(kind, s) => json.Value.Trusted(kind: kind, s: s)
    ListV(items) => json.Value.List(items: items.map(fn(x) { json_of(x) }))
    MapV(fields) => json.Value.Object(fields: fields.map(fn(f: (Str, V)) { (f.0, json_of(f.1)) }))
  }
}

fn of_json(j: json.Value, inner: Bool) -> V {
  match j {
    Null => if inner { V.NilIface } else { V.Invalid }
    Bool(b) => V.Bool(b: b)
    Int(n) => V.IntV(n: n, ty: "int64")
    Num(n) => V.FloatV(f: n)
    Str(s) => V.StrV(s: s)
    // trusted content (decision 0408): a string until the html mode's
    // escaper reads the kind
    Trusted(kind, s) => V.TrustedV(kind: kind, s: s)
    List(items) => V.ListV(items: items.map(fn(x) { of_json(x, true) }))
    // in the data's order: a lookup takes a key's first field either
    // way, and map_order sorts only where the order shows (range, %v)
    Object(fields) => V.MapV(fields: fields.map(fn(f: (Str, json.Value)) { (f.0, of_json(f.1, true)) }))
  }
}

/// A map's fields in key order, as Go ranges over and prints a map: sorted
/// here, where the order shows, not in of_json at each render
/// (2026-10-27: sorting every object of the data was 11% of render);
/// a repeated key keeps every entry, each with its first field's value.
fn map_order(fields: List[(Str, V)]) -> List[(Str, V)] {
  var sorted = true
  for i in 1..fields.len() {
    if fields[i - 1].0 > fields[i].0 {
      sorted = false
      break
    }
  }
  let ps = if sorted { fields } else { fields.sort_by(fn(f: (Str, V)) { f.0 }) }
  var dup = false
  for i in 1..ps.len() {
    if ps[i - 1].0 == ps[i].0 {
      dup = true
      break
    }
  }
  if !dup {
    return ps
  }
  var out: List[(Str, V)] = []
  for p in ps {
    for f in fields {
      if f.0 == p.0 {
        out.push((p.0, f.1))
        break
      }
    }
  }
  out
}

/// The Go type of a value (reflect.Value.Type().String()).
fn type_name(x: Val) -> Str {
  if x.boxed {
    return "interface {}"
  }
  match x.v {
    Invalid => "<nil>"
    NilIface => "interface {}"
    Bool(..) => "bool"
    IntV(_, ty) => ty
    FloatV(..) => "float64"
    ComplexV(..) => "complex128"
    StrV(..) => "string"
    TrustedV(kind, _) => go_trusted_type(kind)
    ListV(..) => "[]interface {}"
    MapV(..) => "map[string]interface {}"
    Missing => "template.missingValType"
  }
}

/// indirectInterface: an interface{} becomes what it holds (a nil one
/// Invalid).
fn unbox(x: Val) -> Val {
  match x.v {
    NilIface => invalid()
    _ => Val{v: x.v}
  }
}

/// fmt's %v of a value (fmt.Fprint of an interface{} holding it).
fn fmt_v(v: V, top: Bool) -> Str {
  match v {
    Invalid => if top { "<no value>" } else { "<nil>" }
    NilIface => "<nil>"
    Bool(b) => if b { "true" } else { "false" }
    IntV(n, _) => "${n}"
    FloatV(f) => go_float(f)
    ComplexV(re, im) => "(" + go_float(re) + (if im >= 0.0 || im.is_nan() { "+" } else { "" }) + go_float(im) + "i)"
    StrV(s) => s
    TrustedV(_, s) => s
    ListV(items) => "[" + items.map(fn(x) { fmt_v(x, false) }).join(" ") + "]"
    MapV(fields) => "map[" + map_order(fields).map(fn(f) { f.0 + ":" + fmt_v(f.1, false) }).join(" ") + "]"
    Missing => "{}"
  }
}

/// isTrue (after indirectInterface); None when the value has no truth.
fn truth_of(x: Val) -> Bool? {
  match unbox(x).v {
    Invalid => Some(false)
    NilIface => Some(false)
    Bool(b) => Some(b)
    IntV(n, _) => Some(n != 0)
    FloatV(f) => Some(f != 0.0)
    ComplexV(re, im) => Some(re != 0.0 || im != 0.0)
    StrV(s) => Some(!s.is_empty())
    TrustedV(_, s) => Some(!s.is_empty())
    ListV(items) => Some(!items.is_empty())
    MapV(fields) => Some(!fields.is_empty())
    Missing => Some(true)
  }
}

// ---------------------------------------------------------------------------
// The executor (exec.go)

struct Var {
  name: Str
  value: Val
}

/// The node an error is reported at, kept as the node and written out
/// only when an error is built (state.errorf).
enum Ctx {
  Nothing
  OfNode(n: Node)
  OfPipe(p: Pipe)
  OfArg(a: Arg)
  OfCmd(c: Cmd)
}

fn ctx_text(c: Ctx) -> Str {
  match c {
    Nothing => ""
    OfNode(n) => node_text(n)
    OfPipe(p) => pipe_text(p)
    OfArg(a) => arg_text(a)
    OfCmd(c) => cmd_text(c)
  }
}

const CTX_NODE: Int = 1
const CTX_PIPE: Int = 2
const CTX_ARG: Int = 3
const CTX_CMD: Int = 4

/// The index of a's variant (with its kind and position it names one
/// argument of a tree: a PipeA and the first argument inside it share a
/// position, never a variant).
fn arg_tag(a: Arg) -> Int {
  match a {
    Field(..) => 0
    Chain(..) => 1
    Ident(..) => 2
    PipeA(..) => 3
    Variable(..) => 4
    BoolA(..) => 5
    Dot(..) => 6
    NilA(..) => 7
    Number(..) => 8
    StringA(..) => 9
  }
}

fn node_tag(n: Node) -> Int {
  match n {
    Text(..) => 0
    Action(..) => 1
    Comment(..) => 2
    If(..) => 3
    Range(..) => 4
    With(..) => 5
    TemplateN(..) => 6
    Break(..) => 7
    Continue(..) => 8
    End(..) => 9
    Else(..) => 10
  }
}

/// The node of the tree an error names: kind, variant and position.
fn ctx_find(list: List[Node], kind: Int, tag: Int, pos: Int) -> Ctx? {
  if kind == 0 {
    return None
  }
  for n in list {
    if kind == CTX_NODE && node_tag(n) == tag && node_pos(n) == pos {
      return Some(Ctx.OfNode(n))
    }
    let found = match n {
      Action(_, _, pipe) => ctx_in_pipe(pipe, kind, tag, pos)
      If(_, _, pipe, l, el) | Range(_, _, pipe, l, el) | With(_, _, pipe, l, el) => ctx_in_pipe(pipe, kind, tag, pos) ?? ctx_find(l, kind, tag, pos) ?? (match el {
        Some(e) => ctx_find(e, kind, tag, pos)
        None => None
      })
      TemplateN(_, _, _, pipe) => match pipe {
        Some(p) => ctx_in_pipe(p, kind, tag, pos)
        None => None
      }
      Text(..) | Comment(..) | Break(..) | Continue(..) | End(..) | Else(..) => None
    }
    if found is Some(_) {
      return found
    }
  }
  None
}

fn ctx_in_pipe(p: Pipe, kind: Int, tag: Int, pos: Int) -> Ctx? {
  if kind == CTX_PIPE && p.pos == pos {
    return Some(Ctx.OfPipe(p))
  }
  for c in p.cmds {
    if kind == CTX_CMD && c.pos == pos {
      return Some(Ctx.OfCmd(c))
    }
    let found = ctx_in_args(c.args, kind, tag, pos)
    if found is Some(_) {
      return found
    }
  }
  None
}

fn ctx_in_args(args: List[Arg], kind: Int, tag: Int, pos: Int) -> Ctx? {
  for a in args {
    if kind == CTX_ARG && arg_tag(a) == tag && arg_pos(a) == pos {
      return Some(Ctx.OfArg(a))
    }
    let found = match a {
      Chain(_, node, _) => ctx_in_args(node, kind, tag, pos)
      PipeA(ps) => {
        var r: Ctx? = None
        for q in ps {
          if r is None {
            r = ctx_in_pipe(q, kind, tag, pos)
          }
        }
        r
      }
      Field(..) | Ident(..) | Variable(..) | BoolA(..) | Dot(..) | NilA(..) | Number(..) | StringA(..) => None
    }
    if found is Some(_) {
      return found
    }
  }
  None
}

/// The trees of a parsed set, kept in the Template (std Parsed, opaque).
struct Parsed {
  trees: List[Tree] = []
  /// the html mode (decision 0408): the trees escaped from the root
  /// template, or the escaping error (reported by render, as Go does)
  escaped: List[Tree] = []
  esc_err: Str = ""
}

/// One template of the set as the executor sees it.
struct Ex {
  trees: List[Tree]
  /// the user functions (decision 0408)
  funcs: Map[Str, template.TemplateFn] = {}
  missing_error: Bool
  tree: Tree
  vars: List[Var] = []
  depth: Int = 0
  node_pos: Int = -1
  /// What the error text names (state.node): its kind (CTX_*), its
  /// variant's index, and node_pos; the node itself is found in tree only
  /// when an error is made (ctx_find), so a visit stores no value.
  node_kind: Int = 0
  node_tag: Int = 0
  out: Str = ""
}

fn (var s: Ex) at_arg(a: Arg) {
  s.node_pos = arg_pos(a)
  s.node_kind = CTX_ARG
  s.node_tag = arg_tag(a)
}

fn (var s: Ex) at_node(n: Node) {
  s.node_pos = node_pos(n)
  s.node_kind = CTX_NODE
  s.node_tag = node_tag(n)
}

/// The context set from a node or argument whose variant the caller has
/// already matched: its kind, variant index (node_tag, arg_tag) and
/// position, with no match of its own (2026-10-27: at_node and at_arg
/// matched each node twice at every visit, about 11% of render).
fn (var s: Ex) at(kind: Int, tag: Int, pos: Int) {
  s.node_pos = pos
  s.node_kind = kind
  s.node_tag = tag
}

fn (var s: Ex) at_pipe(p: Pipe) {
  s.node_pos = p.pos
  s.node_kind = CTX_PIPE
  s.node_tag = 0
}

/// state.errorf: Go's text with the location and the node.
fn (s: Ex) err(msg: Str) -> Str {
  if s.node_pos < 0 {
    return "template: ${s.tree.name}: ${msg}"
  }
  let text = s.tree.text
  let pos = if s.node_pos > text.len() { text.len() } else { s.node_pos }
  var last_nl = -1
  var lines = 1
  for k in 0..pos {
    if text[k] == '\n' {
      last_nl = k
      lines += 1
    }
  }
  let col = if last_nl < 0 { pos } else { pos - (last_nl + 1) }
  "template: ${s.tree.parse_name}:${lines}:${col}: executing ${go_quote(s.tree.name)} at <${ctx_text(ctx_find(s.tree.root, s.node_kind, s.node_tag, s.node_pos) ?? Ctx.Nothing)}>: ${msg}"
}

fn (var s: Ex) var_value(name: Str) -> Val ! Str {
  var i = s.vars.len() - 1
  while i >= 0 {
    if s.vars[i].name == name {
      return Ok(s.vars[i].value)
    }
    i -= 1
  }
  Err(s.err("undefined variable: ${name}"))
}

fn (var s: Ex) set_var(name: Str, v: Val) -> () ! Str {
  var i = s.vars.len() - 1
  while i >= 0 {
    if s.vars[i].name == name {
      s.vars[i].value = v
      return Ok(())
    }
    i -= 1
  }
  Err(s.err("undefined variable: ${name}"))
}

// walk results: 0 normal, 1 break, 2 continue
fn (var s: Ex) walk_list(dot: Val, list: List[Node]) -> Int ! Str {
  for n in list {
    let r = s.walk(dot, n)?
    if r != 0 {
      return Ok(r)
    }
  }
  Ok(0)
}

fn (var s: Ex) walk(dot: Val, n: Node) -> Int ! Str {
  // s.at with each variant's node_tag: the node is matched once
  match n {
    Action(pos, _, pipe) => {
      s.at(CTX_NODE, 1, pos)
      let v = s.eval_pipeline(dot, pipe)?
      if pipe.decl.is_empty() {
        s.at(CTX_NODE, 1, pos)
        match v.v {
          // an integer's digits appended to the output in place
          // (llrt_concat_int), where fmt_v made its text first (2026-10-28:
          // that text was 37% of render's allocations)
          IntV(n, _) => s.out = "${s.out}${n}"
          _ => s.out = s.out + fmt_v(v.v, true)
        }
      }
      Ok(0)
    }
    Break(pos, _) => {
      s.at(CTX_NODE, 7, pos)
      Ok(1)
    }
    Continue(pos, _) => {
      s.at(CTX_NODE, 8, pos)
      Ok(2)
    }
    Comment(pos) => {
      s.at(CTX_NODE, 2, pos)
      Ok(0)
    }
    If(pos, _, pipe, list, el) => {
      s.at(CTX_NODE, 3, pos)
      s.walk_if_with(false, dot, pipe, list, el)
    }
    With(pos, _, pipe, list, el) => {
      s.at(CTX_NODE, 5, pos)
      s.walk_if_with(true, dot, pipe, list, el)
    }
    Range(..) => s.walk_range(dot, n)
    TemplateN(pos, _, name, pipe) => {
      s.at(CTX_NODE, 6, pos)
      s.walk_template(dot, name, pipe)
    }
    Text(pos, text) => {
      s.at(CTX_NODE, 0, pos)
      s.out = s.out + text
      Ok(0)
    }
    End(..) | Else(..) => {
      s.at_node(n)
      Err(s.err("unknown node: ${node_text(n)}"))
    }
  }
}

/// Drops the variables declared since s.vars had mark entries, in place.
fn (var s: Ex) trunc_vars(mark: Int) {
  while s.vars.len() > mark {
    let _v = s.vars.pop()
  }
}

fn (var s: Ex) walk_if_with(with: Bool, dot: Val, pipe: Pipe, list: List[Node], el: List[Node]?) -> Int ! Str {
  let mark = s.vars.len()
  let v = s.eval_pipeline(dot, pipe)?
  let t = match truth_of(v) {
    Some(t) => t
    None => return Err(s.err("if/with can't use ${fmt_v(v.v, false)}"))
  }
  var r = 0
  if t {
    r = if with { s.walk_list(v, list)? } else { s.walk_list(dot, list)? }
  } else {
    match el {
      Some(e) => r = s.walk_list(dot, e)?
      None => {}
    }
  }
  s.trunc_vars(mark)
  Ok(r)
}

/// exec.go oneIteration: the range's variables set to index and elem, its
/// list walked with elem as dot; 1 for a break.
fn (var s: Ex) range_once(pipe: Pipe, list: List[Node], mark: Int, index: Val, elem: Val) -> Int ! Str {
  // setTopVar(1, elem), setTopVar(2, index)
  if !pipe.decl.is_empty() {
    if pipe.is_assign {
      if pipe.decl.len() > 1 {
        s.set_var(pipe.decl[0], index)?
      } else {
        s.set_var(pipe.decl[0], elem)?
      }
    } else {
      s.vars[s.vars.len() - 1].value = elem
    }
  }
  if pipe.decl.len() > 1 {
    if pipe.is_assign {
      s.set_var(pipe.decl[1], elem)?
    } else {
      s.vars[s.vars.len() - 2].value = index
    }
  }
  let r = s.walk_list(elem, list)?
  s.trunc_vars(mark)
  Ok(r)
}

/// exec.go walkRange: each element in turn, with no list of them built
/// first.
fn (var s: Ex) walk_range(dot: Val, n: Node) -> Int ! Str {
  let (pos, pipe, list, el) = match n {
    Range(at, _, p, l, e) => (at, p, l, e)
    _ => return Ok(0)
  }
  s.at(CTX_NODE, 4, pos)
  let mark0 = s.vars.len()
  let v = unbox(s.eval_pipeline(dot, pipe)?)
  let mark = s.vars.len()
  var any = false
  match v.v {
    IntV(k, ty) => {
      if pipe.decl.len() > 1 {
        return Err(s.err("can't use ${k} to iterate over more than one variable"))
      }
      for i in 0..(if k > 0 { k } else { 0 }) {
        any = true
        if s.range_once(pipe, list, mark, invalid(), val(V.IntV(n: i, ty: ty)))? == 1 {
          break
        }
      }
    }
    ListV(items) => {
      for (i, x) in items.indexed() {
        any = true
        if s.range_once(pipe, list, mark, val(V.IntV(n: i, ty: "int")), Val{v: x, boxed: true})? == 1 {
          break
        }
      }
    }
    MapV(fields) => {
      for (k, x) in map_order(fields) {
        any = true
        if s.range_once(pipe, list, mark, val(V.StrV(s: k)), Val{v: x, boxed: true})? == 1 {
          break
        }
      }
    }
    Invalid => {}
    NilIface | Bool(..) | FloatV(..) | ComplexV(..) | StrV(..) | TrustedV(..) | Missing => {
      return Err(s.err("range can't iterate over ${fmt_v(v.v, false)}"))
    }
  }
  if !any {
    match el {
      Some(e) => {
        let _r = s.walk_list(dot, e)?
      }
      None => {}
    }
  }
  s.trunc_vars(mark0)
  Ok(0)
}

fn (var s: Ex) walk_template(dot: Val, name: Str, pipe: Pipe?) -> Int ! Str {
  var tree: Tree? = None
  for t in s.trees {
    if t.name == name {
      tree = Some(t)
    }
  }
  let t = match tree {
    Some(x) => x
    None => return Err(s.err("template ${go_quote(name)} not defined"))
  }
  if s.depth == 100000 {
    return Err(s.err("exceeded maximum template depth (100000)"))
  }
  let d = match pipe {
    Some(p) => s.eval_pipeline(dot, p)?
    None => invalid()
  }
  var sub = Ex{trees: s.trees, funcs: s.funcs, missing_error: s.missing_error, tree: t, vars: [Var{name: "$", value: d}], depth: s.depth + 1}
  let _r = sub.walk_list(d, t.root)?
  s.out = s.out + sub.out
  Ok(0)
}

fn (var s: Ex) eval_pipeline(dot: Val, pipe: Pipe) -> Val ! Str {
  s.at_pipe(pipe)
  var value = val(V.Missing)
  for c in pipe.cmds {
    value = s.eval_command(dot, c, value)?
    // an interface{} result is unwrapped
    if value.boxed {
      value = unbox(value)
    }
  }
  for name in pipe.decl {
    if pipe.is_assign {
      s.set_var(name, value)?
    } else {
      s.vars.push(Var{name: name, value: value})
    }
  }
  Ok(value)
}

fn is_missing(x: Val) -> Bool { x.v is Missing }

fn (var s: Ex) not_a_function(args: List[Arg], final: Val) -> () ! Str {
  if args.len() > 1 || !is_missing(final) {
    return Err(s.err("can't give argument to non-function ${arg_text(args[0])}"))
  }
  Ok(())
}

fn (var s: Ex) eval_command(dot: Val, c: Cmd, final: Val) -> Val ! Str {
  let first = c.args[0]
  match first {
    Field(pos, ident) => {
      s.at(CTX_ARG, 0, pos)
      return s.eval_field_chain(dot, dot, first, ident, c.args, final)
    }
    Chain(pos, node, field) => {
      s.at(CTX_ARG, 1, pos)
      match node[0] {
        NilA(..) => return Err(s.err("indirection through explicit nil in ${arg_text(first)}"))
        _ => {}
      }
      let recv = s.eval_arg(dot, node[0])?
      return s.eval_field_chain(dot, recv, first, field, c.args, final)
    }
    Ident(_, name) => return s.eval_function(dot, first, name, c.args, final, c.pos, CTX_CMD, 0)
    PipeA(p) => {
      s.not_a_function(c.args, final)?
      return s.eval_pipeline(dot, p[0])
    }
    Variable(pos, ident) => {
      s.at(CTX_ARG, 4, pos)
      let v = s.var_value(ident[0])?
      if ident.len() == 1 {
        s.not_a_function(c.args, final)?
        return Ok(v)
      }
      return s.eval_field_chain(dot, v, first, ident[1..], c.args, final)
    }
    BoolA(..) | Dot(..) | NilA(..) | Number(..) | StringA(..) => {}
  }
  s.at_arg(first)
  s.not_a_function(c.args, final)?
  match first {
    BoolA(_, b) => Ok(val(V.Bool(b: b)))
    Dot(_) => Ok(dot)
    NilA(_) => Err(s.err("nil is not a command"))
    Number(_, n) => s.ideal_constant(n)
    StringA(_, _, text) => Ok(val(V.StrV(s: text)))
    Field(..) | Chain(..) | Ident(..) | PipeA(..) | Variable(..) => Err(s.err("can't evaluate command ${go_quote(arg_text(first))}"))
  }
}

fn (var s: Ex) ideal_constant(n: Num) -> Val ! Str {
  let t = n.text
  let hex_int = t.len() > 2 && t.starts_with("0") && (t[1..2] == "x" || t[1..2] == "X") && !t.contains("p") && !t.contains("P")
  let rune_int = t.starts_with("'")
  if n.is_complex {
    return Ok(val(V.ComplexV(re: n.re, im: n.im)))
  }
  if n.is_float && !hex_int && !rune_int && (t.contains(".") || t.contains("e") || t.contains("E") || t.contains("p") || t.contains("P")) {
    return Ok(val(V.FloatV(f: n.float)))
  }
  if n.is_int {
    return Ok(val(V.IntV(n: n.int, ty: "int")))
  }
  if n.is_uint {
    return Err(s.err("${t} overflows int"))
  }
  Ok(invalid())
}

fn (var s: Ex) eval_field_chain(dot: Val, recv0: Val, node: Arg, ident: List[Str], args: List[Arg], final: Val) -> Val ! Str {
  var recv = recv0
  for i in 0..ident.len() - 1 {
    recv = s.eval_field(ident[i], node, [], val(V.Missing), recv)?
  }
  s.eval_field(ident[ident.len() - 1], node, args, final, recv)
}

fn (var s: Ex) eval_field(name: Str, node: Arg, args: List[Arg], final: Val, recv: Val) -> Val ! Str {
  match recv.v {
    Invalid => {
      if s.missing_error {
        return Err(s.err("nil data; no entry for key ${go_quote(name)}"))
      }
      return Ok(invalid())
    }
    NilIface => return Err(s.err("nil pointer evaluating interface {}.${name}"))
    _ => {}
  }
  let typ = type_name(recv)
  let has_args = args.len() > 1 || !is_missing(final)
  match recv.v {
    MapV(fields) => {
      if has_args {
        return Err(s.err("${name} is not a method but has arguments"))
      }
      for (k, x) in fields {
        if k == name {
          return Ok(Val{v: x, boxed: true})
        }
      }
      if s.missing_error {
        return Err(s.err("map has no entry for key ${go_quote(name)}"))
      }
      Ok(invalid())
    }
    _ => Err(s.err("can't evaluate field ${name} in type ${typ}"))
  }
}

fn (var s: Ex) eval_arg(dot: Val, a: Arg) -> Val ! Str {
  s.at_arg(a)
  match a {
    Dot(_) => Ok(dot)
    NilA(_) => Ok(invalid())
    Field(_, ident) => s.eval_field_chain(dot, dot, a, ident, [a], val(V.Missing))
    Variable(_, ident) => {
      let v = s.var_value(ident[0])?
      if ident.len() == 1 {
        return Ok(v)
      }
      s.eval_field_chain(dot, v, a, ident[1..], [], val(V.Missing))
    }
    PipeA(p) => s.eval_pipeline(dot, p[0])
    Ident(_, name) => s.eval_function(dot, a, name, [a], val(V.Missing), arg_pos(a), CTX_ARG, arg_tag(a))
    Chain(_, node, field) => {
      let recv = s.eval_arg(dot, node[0])?
      s.eval_field_chain(dot, recv, a, field, [], val(V.Missing))
    }
    BoolA(_, b) => Ok(val(V.Bool(b: b)))
    Number(_, n) => s.ideal_constant(n)
    StringA(_, _, text) => Ok(val(V.StrV(s: text)))
  }
}

// ---------------------------------------------------------------------------
// Calls (exec.go evalFunction, evalCall) and the built in functions
// (funcs.go)

/// A builtin's parameters: fixed count, variadic, and whether the
/// fixed parameters are reflect.Value (else interface{} or string).
fn builtin_shape(name: Str) -> (Int, Bool) {
  match name {
    "and" | "or" | "call" | "index" | "slice" | "eq" => (1, true)
    "html" | "js" | "urlquery" | "print" | "println" => (0, true)
    "printf" => (1, true)
    "len" | "not" => (1, false)
    _ => (2, false)
  }
}

fn (var s: Ex) eval_function(dot: Val, node: Arg, name: Str, args0: List[Arg], final: Val, cmd_pos: Int, cmd_kind: Int, cmd_tag: Int) -> Val ! Str {
  s.at_arg(node)
  if is_esc_fn(name) {
    return s.call_escaper(dot, name, args0, final)
  }
  if !BUILTINS.contains(name) {
    return s.call_user(dot, name, args0, final, cmd_pos, cmd_kind, cmd_tag)
  }
  let args = if args0.is_empty() { args0 } else { args0[1..] }
  let (fixed, variadic) = builtin_shape(name)
  var num_in = args.len()
  if !is_missing(final) {
    num_in += 1
  }
  if variadic {
    if num_in < fixed {
      return Err(s.err("wrong number of args for ${name}: want at least ${fixed} got ${args.len()}"))
    }
  } else if num_in != fixed {
    return Err(s.err("wrong number of args for ${name}: want ${fixed} got ${num_in}"))
  }
  if name == "and" || name == "or" {
    var v = invalid()
    for a in args {
      v = s.eval_arg(dot, a)?
      if (truth_of(v) ?? false) == (name == "or") {
        return Ok(v)
      }
    }
    if !is_missing(final) {
      v = final
    }
    return Ok(v)
  }
  var argv: List[Val] = []
  for (i, a) in args.indexed() {
    if name == "printf" && i == 0 {
      argv.push(s.eval_string_arg(dot, a)?)
    } else {
      argv.push(s.eval_arg(dot, a)?)
    }
  }
  if !is_missing(final) {
    if name == "printf" && args.is_empty() {
      match unbox(final).v {
        StrV(..) | TrustedV(..) => argv.push(final)
        Invalid => return Err(s.err("invalid value; expected string"))
        _ => return Err(s.err("wrong type for value; expected string; got ${type_name(unbox(final))}"))
      }
    } else {
      argv.push(final)
    }
  }
  match call_builtin(name, args, argv) {
    Ok(v) => Ok(v)
    Err(e) => {
      // evalCall: s.at(node), the command (or the identifier as an argument)
      s.node_pos = cmd_pos
      s.node_kind = cmd_kind
      s.node_tag = cmd_tag
      Err(s.err("error calling ${name}: ${e}"))
    }
  }
}

/// printf's format argument (evalArg with a string parameter).
fn (var s: Ex) eval_string_arg(dot: Val, a: Arg) -> Val ! Str {
  match a {
    StringA(_, _, text) => Ok(val(V.StrV(s: text)))
    BoolA(..) | Number(..) | NilA(..) => {
      s.at_arg(a)
      match a {
        NilA(..) => Err(s.err("cannot assign nil to string"))
        _ => Err(s.err("expected string; found ${arg_text(a)}"))
      }
    }
    Field(..) | Chain(..) | Ident(..) | PipeA(..) | Variable(..) | Dot(..) => {
      let v = s.eval_arg(dot, a)?
      match unbox(v).v {
        StrV(..) | TrustedV(..) => Ok(unbox(v))
        Invalid => Err(s.err("invalid value; expected string"))
        _ => Err(s.err("wrong type for value; expected string; got ${type_name(unbox(v))}"))
      }
    }
  }
}

fn call_builtin(name: Str, args: List[Arg], argv: List[Val]) -> Val ! Str {
  match name {
    "not" => Ok(val(V.Bool(b: !(truth_of(argv[0]) ?? false))))
    "len" => fn_len(argv[0])
    "index" => fn_index(argv[0], argv[1..])
    "slice" => fn_slice(argv[0], argv[1..])
    "eq" => fn_eq(argv[0], argv[1..]).map(fn(b) { val(V.Bool(b: b)) })
    "ne" => fn_eq(argv[0], argv[1..2]).map(fn(b) { val(V.Bool(b: !b)) })
    "lt" => fn_lt(argv[0], argv[1]).map(fn(b) { val(V.Bool(b: b)) })
    "le" => {
      let l = fn_lt(argv[0], argv[1])?
      if l {
        return Ok(val(V.Bool(b: true)))
      }
      fn_eq(argv[0], argv[1..2]).map(fn(b) { val(V.Bool(b: b)) })
    }
    "gt" => {
      let l = fn_lt(argv[0], argv[1])?
      if l {
        return Ok(val(V.Bool(b: false)))
      }
      let e = fn_eq(argv[0], argv[1..2])?
      Ok(val(V.Bool(b: !e)))
    }
    "ge" => fn_lt(argv[0], argv[1]).map(fn(b) { val(V.Bool(b: !b)) })
    "print" => Ok(val(V.StrV(s: sprint(argv))))
    "println" => Ok(val(V.StrV(s: sprintln(argv))))
    "printf" => Ok(val(V.StrV(s: sprintf(fmt_text(argv[0]), argv[1..]))))
    "html" => Ok(val(V.StrV(s: html_escape(eval_args(argv)))))
    "js" => Ok(val(V.StrV(s: js_escape(eval_args(argv)))))
    "urlquery" => Ok(val(V.StrV(s: url.query_escape(eval_args(argv)))))
    "call" => {
      let fname = if args.is_empty() { fmt_v(argv[0].v, false) } else { arg_text(args[0]) }
      match unbox(argv[0]).v {
        Invalid => Err("call of nil")
        _ => Err("non-function ${fname} of type ${type_name(unbox(argv[0]))}")
      }
    }
    _ => Err("unknown function ${name}")
  }
}

fn fmt_text(x: Val) -> Str {
  match unbox(x).v {
    StrV(s) => s
    TrustedV(_, s) => s
    _ => ""
  }
}

/// The string of a string value (a trusted one too), or None.
fn str_of(v: V) -> Str? {
  match v {
    StrV(s) => Some(s)
    TrustedV(_, s) => Some(s)
    _ => None
  }
}

/// The Go type name of a trusted kind (template.HTML and its siblings).
fn go_trusted_type(kind: Str) -> Str {
  match kind {
    "html" => "template.HTML"
    "css" => "template.CSS"
    "js" => "template.JS"
    "jsstr" => "template.JSStr"
    "url" => "template.URL"
    "attr" => "template.HTMLAttr"
    "srcset" => "template.Srcset"
    _ => "string"
  }
}

/// funcs.go evalArgs: a lone string as it is, else fmt.Sprint.
fn eval_args(argv: List[Val]) -> Str {
  if argv.len() == 1 {
    match argv[0].v {
      StrV(s) => return s
      TrustedV(_, s) => return s
      _ => {}
    }
  }
  // printableValue: a nil argument is the string "<no value>"
  sprint(argv.map(fn(a) {
    match unbox(a).v {
      Invalid | NilIface => val(V.StrV(s: "<no value>"))
      _ => a
    }
  }))
}

fn fn_len(x: Val) -> Val ! Str {
  match x.v {
    NilIface => return Err("len of nil pointer")
    _ => {}
  }
  match unbox(x).v {
    StrV(s) => Ok(val(V.IntV(n: s.len(), ty: "int")))
    TrustedV(_, s) => Ok(val(V.IntV(n: s.len(), ty: "int")))
    ListV(items) => Ok(val(V.IntV(n: items.len(), ty: "int")))
    MapV(fields) => Ok(val(V.IntV(n: fields.len(), ty: "int")))
    Invalid => Err("reflect: call of reflect.Value.Type on zero Value")
    NilIface | Bool(..) | IntV(..) | FloatV(..) | ComplexV(..) | Missing => Err("len of type ${type_name(unbox(x))}")
  }
}

/// funcs.go indexArg.
fn index_arg(i0: Val, cap: Int) -> Int ! Str {
  let i = unbox(i0)
  match i.v {
    IntV(n, _) => {
      if n < 0 || n > cap {
        return Err("index out of range: ${n}")
      }
      Ok(n)
    }
    Invalid => Err("cannot index slice/array with nil")
    _ => Err("cannot index slice/array with type ${type_name(i)}")
  }
}

fn fn_index(item0: Val, indexes: List[Val]) -> Val ! Str {
  var item = unbox(item0)
  match item.v {
    Invalid => return Err("index of untyped nil")
    _ => {}
  }
  for ix in indexes {
    match item.v {
      NilIface => return Err("index of nil pointer")
      _ => {}
    }
    item = unbox(item)
    match item.v {
      ListV(items) => {
        let x = index_arg(ix, items.len())?
        if x == items.len() {
          return Err("reflect: slice index out of range")
        }
        item = Val{v: items[x], boxed: true}
      }
      StrV(str) => {
        let x = index_arg(ix, str.len())?
        if x == str.len() {
          return Err("reflect: string index out of range")
        }
        item = val(V.IntV(n: Int(str.bytes()[x]), ty: "uint8"))
      }
      TrustedV(_, str) => {
        let x = index_arg(ix, str.len())?
        if x == str.len() {
          return Err("reflect: string index out of range")
        }
        item = val(V.IntV(n: Int(str.bytes()[x]), ty: "uint8"))
      }
      MapV(fields) => {
        let k = unbox(ix)
        let key = match k.v {
          StrV(ks) => ks
          TrustedV(_, ks) => ks
          Invalid => return Err("value is nil; should be of type string")
          _ => return Err("value has type ${type_name(k)}; should be string")
        }
        var found = false
        for (fk, fx) in fields {
          if fk == key {
            item = Val{v: fx, boxed: true}
            found = true
            break
          }
        }
        if !found {
          item = Val{v: V.NilIface, boxed: true}
        }
      }
      Invalid | NilIface | Bool(..) | IntV(..) | FloatV(..) | ComplexV(..) | Missing => return Err("can't index item of type ${type_name(item)}")
    }
  }
  Ok(item)
}

fn fn_slice(item0: Val, indexes: List[Val]) -> Val ! Str {
  let item = unbox(item0)
  match item.v {
    Invalid => return Err("slice of untyped nil")
    _ => {}
  }
  if indexes.len() > 3 {
    return Err("too many slice indexes: ${indexes.len()}")
  }
  let n = match item.v {
    StrV(str) => {
      if indexes.len() == 3 {
        return Err("cannot 3-index slice a string")
      }
      str.len()
    }
    ListV(items) => items.len()
    _ => return Err("can't slice item of type ${type_name(item)}")
  }
  var idx = [0, n, n]
  for (i, ix) in indexes.indexed() {
    idx[i] = index_arg(ix, n)?
  }
  if idx[0] > idx[1] {
    return Err("invalid slice index: ${idx[0]} > ${idx[1]}")
  }
  if indexes.len() == 3 && idx[1] > idx[2] {
    return Err("invalid slice index: ${idx[1]} > ${idx[2]}")
  }
  match item.v {
    // a cut inside a rune: U+FFFD for each byte of it (decision 0259)
    StrV(str) => Ok(val(V.StrV(s: lossy(str.bytes()[idx[0]..idx[1]]))))
    ListV(items) => Ok(val(V.ListV(items: items[idx[0]..idx[1]])))
    _ => Ok(item)
  }
}

/// Bytes as Str, U+FFFD for each byte of an invalid sequence.
fn lossy(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = StrBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write("${r}")
    i += n
  }
  out.freeze()
}

// basicKind: 0 invalid, 1 bool, 3 int, 4 float, 5 string, 6 uint
fn basic_kind(x: Val) -> Int {
  match x.v {
    Bool(..) => 1
    IntV(_, ty) => if ty == "uint8" { 6 } else { 3 }
    FloatV(..) => 4
    ComplexV(..) => 2
    StrV(..) | TrustedV(..) => 5
    Invalid | NilIface | ListV(..) | MapV(..) | Missing => 0
  }
}

fn int_of(x: Val) -> Int {
  match x.v {
    IntV(n, _) => n
    _ => 0
  }
}

fn valid(x: Val) -> Bool { !(x.v is Invalid) }

fn fn_eq(a0: Val, rest: List[Val]) -> Bool ! Str {
  let a = unbox(a0)
  if rest.is_empty() {
    return Err("missing argument for comparison")
  }
  let k1 = basic_kind(a)
  for b0 in rest {
    let b = unbox(b0)
    let k2 = basic_kind(b)
    var t = false
    if k1 != k2 {
      if (k1 == 3 && k2 == 6) || (k1 == 6 && k2 == 3) {
        t = int_of(a) == int_of(b)
      } else if valid(a) && valid(b) {
        return Err("incompatible types for comparison: ${type_name(a)} and ${type_name(b)}")
      }
    } else {
      match (a.v, b.v) {
        (Bool(x), Bool(y)) => t = x == y
        (FloatV(x), FloatV(y)) => t = x == y
        (ComplexV(a1, b1), ComplexV(a2, b2)) => t = a1 == a2 && b1 == b2
        (IntV(x, _), IntV(y, _)) => t = x == y
        (StrV(x), StrV(y)) => t = x == y
        (StrV(x), TrustedV(_, y)) => t = x == y
        (TrustedV(_, x), StrV(y)) => t = x == y
        (TrustedV(_, x), TrustedV(_, y)) => t = x == y
        _ => {
          let n1 = !valid(a)
          let n2 = !valid(b)
          // canCompare: a list and a map are different kinds
          if !n1 && !n2 && ((a.v is ListV(..)) != (b.v is ListV(..))) {
            return Err("non-comparable types ${fmt_arg(a, 's', Spec{})}: ${type_name(a)}, ${type_name(b)}: ${fmt_arg(b, 'v', Spec{})}")
          }
          if n1 || n2 {
            t = n1 == n2
          } else {
            return Err("non-comparable type ${fmt_arg(b, 's', Spec{})}: ${type_name(b)}")
          }
        }
      }
    }
    if t {
      return Ok(true)
    }
  }
  Ok(false)
}

fn fn_lt(a0: Val, b0: Val) -> Bool ! Str {
  let a = unbox(a0)
  let k1 = basic_kind(a)
  if k1 == 0 {
    return Err("invalid type for comparison")
  }
  let b = unbox(b0)
  let k2 = basic_kind(b)
  if k2 == 0 {
    return Err("invalid type for comparison")
  }
  if k1 != k2 {
    if k1 == 3 && k2 == 6 {
      return Ok(int_of(a) < int_of(b))
    }
    if k1 == 6 && k2 == 3 {
      return Ok(int_of(b) >= 0 && int_of(a) < int_of(b))
    }
    return Err("incompatible types for comparison: ${type_name(a)} and ${type_name(b)}")
  }
  match (a.v, b.v) {
    (Bool(..), _) => Err("invalid type for comparison")
    (FloatV(x), FloatV(y)) => Ok(x < y)
    (IntV(x, _), IntV(y, _)) => Ok(x < y)
    (StrV(x), StrV(y)) => Ok(x < y)
    (StrV(x), TrustedV(_, y)) => Ok(x < y)
    (TrustedV(_, x), StrV(y)) => Ok(x < y)
    (TrustedV(_, x), TrustedV(_, y)) => Ok(x < y)
    _ => Err("invalid type for comparison")
  }
}

fn html_escape(s: Str) -> Str {
  var out = StrBuilder.new()
  for c in s.runes() {
    match c {
      '\0' => out.write("\u{FFFD}")
      '"' => out.write("&#34;")
      '\'' => out.write("&#39;")
      '&' => out.write("&amp;")
      '<' => out.write("&lt;")
      '>' => out.write("&gt;")
      _ => out.write("${c}")
    }
  }
  out.freeze()
}

fn js_escape(s: Str) -> Str {
  var out = StrBuilder.new()
  for c in s.runes() {
    let r = Int(c)
    match c {
      '\\' => out.write("\\\\")
      '\'' => out.write("\\'")
      '"' => out.write("\\\"")
      '<' => out.write("\\u003C")
      '>' => out.write("\\u003E")
      '&' => out.write("\\u0026")
      '=' => out.write("\\u003D")
      _ => {
        if r < 32 {
          let h = r.to_str_base(16).to_upper()
          out.write("\\u00" + (if h.len() < 2 { "0" + h } else { h }))
        } else if r >= 128 && !c.is_print() {
          var h = r.to_str_base(16).to_upper()
          while h.len() < 4 {
            h = "0" + h
          }
          out.write("\\u" + h)
        } else {
          out.write("${c}")
        }
      }
    }
  }
  out.freeze()
}

// ---------------------------------------------------------------------------
// fmt's Sprint, Sprintln, and Sprintf over the values

fn is_str_arg(x: Val) -> Bool { unbox(x).v is StrV(..) || unbox(x).v is TrustedV(..) }

fn sprint(args: List[Val]) -> Str {
  var out = ""
  var prev_str = false
  for (i, a) in args.indexed() {
    let is_str = is_str_arg(a)
    if i > 0 && !is_str && !prev_str {
      out = out + " "
    }
    out = out + fmt_v(unbox(a).v, false)
    prev_str = is_str
  }
  out
}

fn sprintln(args: List[Val]) -> Str { args.map(fn(a) { fmt_v(unbox(a).v, false) }).join(" ") + "\n" }

struct Spec {
  minus: Bool = false
  plus: Bool = false
  sharp: Bool = false
  space: Bool = false
  zero: Bool = false
  width: Int = -1
  prec: Int = -1
}

fn pad(s: Str, sp: Spec, numeric: Bool) -> Str {
  let n = s.runes().len()
  if sp.width <= n {
    return s
  }
  let fill = sp.width - n
  if sp.minus {
    return s + " ".repeat(fill)
  }
  if sp.zero && numeric {
    // zeros after a sign
    if s.starts_with("-") || s.starts_with("+") || s.starts_with(" ") {
      return s[0..1] + "0".repeat(fill) + s[1..]
    }
    return "0".repeat(fill) + s
  }
  if sp.zero {
    // Go's writePadding pads strings and bools with zeros too
    return "0".repeat(fill) + s
  }
  " ".repeat(fill) + s
}

/// fmt's badVerb: the value printed with %v and the verb's flags, width,
/// and precision.
fn bad_verb(verb: Rune, x: Val, sp: Spec) -> Str {
  match unbox(x).v {
    Invalid => "%!${verb}(<nil>)"
    _ => "%!${verb}(${type_name(unbox(x))}=${fmt_arg(x, 'v', sp)})"
  }
}

fn sign_prefix(neg: Bool, sp: Spec) -> Str {
  if neg {
    return "-"
  }
  if sp.plus {
    return "+"
  }
  if sp.space {
    return " "
  }
  ""
}

fn fmt_int(n: Int, verb: Rune, sp: Spec, ty: Str) -> Str? {
  let neg = n < 0
  let mag = if neg { if n == (-9223372036854775807 - 1) { "9223372036854775808" } else { "${-n}" } } else { "${n}" }
  var digits = ""
  var prefix = ""
  match verb {
    'd' | 'v' => digits = mag
    'b' => {
      digits = (if neg { -n } else { n }).to_str_base(2)
      if sp.sharp {
        prefix = "0b"
      }
    }
    'o' => {
      digits = (if neg { -n } else { n }).to_str_base(8)
      if sp.sharp {
        prefix = "0"
      }
    }
    'O' => {
      digits = (if neg { -n } else { n }).to_str_base(8)
      prefix = "0o"
    }
    'x' => {
      digits = (if neg { -n } else { n }).to_str_base(16)
      if sp.sharp {
        prefix = "0x"
      }
    }
    'X' => {
      digits = (if neg { -n } else { n }).to_str_base(16).to_upper()
      if sp.sharp {
        prefix = "0X"
      }
    }
    // Go's fmtC and fmtQc: an invalid code point is U+FFFD
    'c' => return Some(pad("${Rune.try(n) ?? '\u{FFFD}'}", sp, false))
    'q' => return Some(pad((Rune.try(n) ?? '\u{FFFD}').quote(), sp, false))
    'U' => {
      // the value as an unsigned 64 bit word, as Go's fmtUnicode
      var h = (if n < 0 { n.shr_logical(4).to_str_base(16) + (n & 15).to_str_base(16) } else { n.to_str_base(16) }).to_upper()
      while h.len() < 4 {
        h = "0" + h
      }
      return Some(pad("U+" + h, sp, false))
    }
    _ => return None
  }
  if sp.prec >= 0 {
    while digits.len() < sp.prec {
      digits = "0" + digits
    }
    if sp.prec == 0 && n == 0 {
      digits = ""
    }
  }
  let s = sign_prefix(neg, sp) + prefix + digits
  Some(pad(s, Spec{minus: sp.minus, zero: sp.zero && sp.prec < 0, width: sp.width}, true))
}

// Exact decimal digits of a float64 (strconv's decimal, without the
// shortest search): big numbers in base 10^9, little endian.

fn big_mul_small(var a: List[Int], m: Int) -> List[Int] {
  var carry = 0
  for i in 0..a.len() {
    let x = a[i] * m + carry
    a[i] = x % 1000000000
    carry = x / 1000000000
  }
  while carry > 0 {
    a.push(carry % 1000000000)
    carry = carry / 1000000000
  }
  a
}

fn big_text(a: List[Int]) -> Str {
  var s = "${a[a.len() - 1]}"
  var i = a.len() - 2
  while i >= 0 {
    var p = "${a[i]}"
    while p.len() < 9 {
      p = "0" + p
    }
    s = s + p
    i -= 1
  }
  s
}

/// The exact decimal digits of |f| (no leading zeros, "0" for zero) and
/// the position of the decimal point (digits before it).
fn exact_digits(f: Float) -> (Str, Int) {
  let bits = f.to_bits()
  let exp_bits = (bits >> 52) & 2047
  var mant = bits & 4503599627370495
  var e = 0
  if exp_bits == 0 {
    e = -1074
  } else {
    mant = mant | 4503599627370496
    e = exp_bits - 1075
  }
  if mant == 0 {
    return ("0", 1)
  }
  var big = [mant % 1000000000, mant / 1000000000 % 1000000000, mant / 1000000000000000000]
  while big.len() > 1 && big[big.len() - 1] == 0 {
    let _p = big.pop()
  }
  if e >= 0 {
    for _ in 0..e {
      big = big_mul_small(big, 2)
    }
    let t = big_text(big)
    return (trim_zeros(t), t.len())
  }
  for _ in 0..(-e) {
    big = big_mul_small(big, 5)
  }
  let t = big_text(big)
  (trim_zeros(t), t.len() - (-e))
}

/// decimal.Round at nd digits (half to even on an exact tie): the
/// digits (trailing zeros trimmed) and the new point.
fn round_digits(d0: Str, dp0: Int, nd: Int) -> (Str, Int) {
  let d = d0.bytes()
  if nd < 0 {
    return ("0", dp0)
  }
  if nd >= d.len() {
    return (trim_zeros(d0), dp0)
  }
  var up = false
  if d[nd] == '5' && nd + 1 == d.len() {
    up = nd > 0 && (d[nd - 1] - '0') % 2 == 1
  } else {
    // anything after a 5 makes it above half
    up = d[nd] > '5' || (d[nd] == '5')
  }
  if !up {
    let kept = d[0..nd].to_str() ?? ""
    if kept.is_empty() {
      return ("0", dp0)
    }
    return (trim_zeros(kept), dp0)
  }
  // add one at nd-1
  var i = nd - 1
  var bs = d[0..nd]
  var out = bs
  while i >= 0 && out[i] == '9' {
    i -= 1
  }
  if i < 0 {
    return ("1", dp0 + 1)
  }
  let head = out[0..i].to_str() ?? ""
  let digit = Rune(Int(out[i]) + 1)
  (trim_zeros(head + "${digit}"), dp0)
}

fn trim_zeros(s: Str) -> Str {
  var t = s
  while t.len() > 1 && t.ends_with("0") {
    t = t[0..t.len() - 1]
  }
  t
}

fn digit_at(d: Str, i: Int) -> Str { if i >= 0 && i < d.len() { d[i..i + 1] } else { "0" } }

/// strconv fmtF: digits d with point dp, prec digits after the point.
fn fmt_f_digits(d: Str, dp: Int, prec: Int) -> Str {
  var s = ""
  if dp > 0 {
    for i in 0..dp {
      s = s + digit_at(d, i)
    }
  } else {
    s = "0"
  }
  if prec > 0 {
    s = s + "."
    for i in 0..prec {
      s = s + digit_at(d, dp + i)
    }
  }
  s
}

/// strconv fmtE: d.ddde±XX with prec digits after the point.
fn fmt_e_digits(d: Str, dp: Int, prec: Int, upper: Bool) -> Str {
  var s = digit_at(d, 0)
  if prec > 0 {
    s = s + "."
    for i in 1..prec + 1 {
      s = s + digit_at(d, i)
    }
  }
  var exp = if d == "0" { 0 } else { dp - 1 }
  let sign = if exp < 0 { "-" } else { "+" }
  if exp < 0 {
    exp = -exp
  }
  let es = if exp < 10 { "0${exp}" } else { "${exp}" }
  s + (if upper { "E" } else { "e" }) + sign + es
}

/// strconv's %x of |f| (fmtX): 0x1.yyyyp+dd, the fraction rounded to prec
/// hex digits (prec < 0: as few as exact).
fn hex_float(f: Float, prec: Int, upper: Bool) -> Str {
  let bits = f.to_bits() & 9223372036854775807
  var exp = bits.shr_logical(52) & 2047
  var mant = bits & 4503599627370495
  if exp == 0 {
    exp += 1
  } else {
    mant = mant | 4503599627370496
  }
  exp -= 1023
  if mant == 0 {
    exp = 0
  }
  // the leading 1 (if any) at bit 60
  let b60 = 1152921504606846976
  mant = mant.wrapping_shl(8)
  while mant != 0 && (mant & b60) == 0 {
    mant = mant.wrapping_shl(1)
    exp -= 1
  }
  if prec >= 0 && prec < 15 {
    let shift = prec * 4
    let extra = mant.wrapping_shl(shift) & (b60 - 1)
    mant = mant.shr_logical(60 - shift)
    if (extra | (mant & 1)) > 576460752303423488 {
      mant += 1
    }
    mant = mant.wrapping_shl(60 - shift)
    if (mant & 2305843009213693952) != 0 {
      mant = mant.shr_logical(1)
      exp += 1
    }
  }
  let hex = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }
  var out = StrBuilder.new()
  out.write(if upper { "0X" } else { "0x" })
  out.write(if (mant.shr_logical(60) & 1) == 1 { "1" } else { "0" })
  mant = mant.wrapping_shl(4)
  if prec < 0 && mant != 0 {
    out.write(".")
    while mant != 0 {
      let d = mant.shr_logical(60) & 15
      out.write(hex[d..d + 1])
      mant = mant.wrapping_shl(4)
    }
  } else if prec > 0 {
    out.write(".")
    for _i in 0..prec {
      let d = mant.shr_logical(60) & 15
      out.write(hex[d..d + 1])
      mant = mant.wrapping_shl(4)
    }
  }
  out.write(if upper { "P" } else { "p" })
  out.write(if exp < 0 { "-" } else { "+" })
  let e = if exp < 0 { -exp } else { exp }
  out.write(if e < 10 { "0${e}" } else { "${e}" })
  out.freeze()
}

/// fmtFloat's # for %x: a point, and zeros to 6 (or the precision)
/// significant digits.
fn sharp_hex(body: Str, prec: Int) -> Str {
  let p = body.find("p") ?? (body.find("P") ?? body.len())
  var num = body[0..p]
  let tail = body[p..]
  var digits = if prec < 0 { 6 } else { prec }
  var seen = false
  for c in num.bytes() {
    if c == 46 {
      continue
    }
    if c != 48 {
      seen = true
    }
    if seen {
      digits -= 1
    }
  }
  if !num.contains(".") {
    num = num + "."
  }
  while digits > 0 {
    num = num + "0"
    digits -= 1
  }
  num + tail
}

fn fmt_float(f: Float, verb: Rune, sp: Spec) -> Str? {
  if verb == 'x' || verb == 'X' {
    if f.is_nan() || f.is_inf() {
      return fmt_float(f, 'g', sp)
    }
    let neg = f < 0.0 || (f == 0.0 && 1.0 / f < 0.0)
    var body = hex_float(f, sp.prec, verb == 'X')
    if sp.sharp {
      body = sharp_hex(body, sp.prec)
    }
    return Some(pad(sign_prefix(neg, sp) + body, sp, true))
  }
  if !(verb is 'v' | 'g' | 'G' | 'e' | 'E' | 'f' | 'F') {
    return None
  }
  if f.is_nan() {
    return Some(pad("NaN", Spec{minus: sp.minus, width: sp.width}, false))
  }
  if f.is_inf() {
    let s = if f > 0.0 { (if sp.plus { "+Inf" } else if sp.space { " Inf" } else { "+Inf" }) } else { "-Inf" }
    return Some(pad(s, Spec{minus: sp.minus, width: sp.width}, false))
  }
  let neg = f < 0.0 || (f == 0.0 && 1.0 / f < 0.0)
  let af = f.abs()
  var body = ""
  if (verb == 'v' || verb == 'g' || verb == 'G') && sp.prec < 0 {
    body = go_float(af)
    if verb == 'G' {
      body = body.to_upper()
    }
  } else {
    let (d0, dp0) = exact_digits(af)
    let prec = if sp.prec < 0 { 6 } else { sp.prec }
    if verb == 'f' || verb == 'F' {
      let (d, dp) = round_digits(d0, dp0, dp0 + prec)
      body = fmt_f_digits(d, dp, prec)
    } else if verb == 'e' || verb == 'E' {
      let (d, dp) = round_digits(d0, dp0, prec + 1)
      body = fmt_e_digits(d, dp, prec, verb == 'E')
    } else {
      var p = if prec == 0 { 1 } else { prec }
      let (d, dp) = round_digits(d0, dp0, p)
      var eprec = p
      if eprec > d.len() && d.len() >= dp {
        eprec = d.len()
      }
      let exp = dp - 1
      if exp < -4 || exp >= eprec {
        if p > d.len() {
          p = d.len()
        }
        body = fmt_e_digits(d, dp, p - 1, verb == 'G')
      } else {
        if p > dp {
          p = d.len()
        }
        body = fmt_f_digits(d, dp, if p - dp > 0 { p - dp } else { 0 })
      }
    }
  }
  Some(pad(sign_prefix(neg, sp) + body, sp, true))
}

fn fmt_str(s: Str, verb: Rune, sp: Spec) -> Str? {
  var t = s
  if sp.prec >= 0 && (verb == 's' || verb == 'v' || verb == 'q' || verb == 'x' || verb == 'X') {
    let rs = t.runes()
    if rs.len() > sp.prec {
      t = rs[0..sp.prec].map(fn(r) { "${r}" }).join("")
    }
  }
  match verb {
    's' | 'v' => Some(pad(t, sp, false))
    'q' => Some(pad(if sp.sharp && !t.contains("`") { "`" + t + "`" } else { t.quote() }, sp, false))
    'x' => Some(pad(t.bytes().to_hex(), sp, false))
    'X' => Some(pad(t.bytes().to_hex().to_upper(), sp, false))
    _ => None
  }
}

/// fmt's printArg of x with verb.
fn fmt_arg(x: Val, verb: Rune, sp: Spec) -> Str {
  let u = unbox(x)
  if verb == 'T' {
    return pad(match u.v {
      Invalid => "<nil>"
      _ => type_name(u)
    }, sp, false)
  }
  match u.v {
    Invalid => if verb == 'v' { pad("<nil>", sp, false) } else { bad_verb(verb, x, sp) }
    NilIface => if verb == 'v' { pad("<nil>", sp, false) } else { bad_verb(verb, x, sp) }
    Bool(b) => if verb == 't' || verb == 'v' { pad(if b { "true" } else { "false" }, sp, false) } else { bad_verb(verb, x, sp) }
    IntV(n, ty) => fmt_int(n, verb, sp, ty) ?? bad_verb(verb, x, sp)
    FloatV(f) => fmt_float(f, verb, sp) ?? bad_verb(verb, x, sp)
    ComplexV(re, im) => {
      match (fmt_float(re, verb, Spec{prec: sp.prec}), fmt_float(im, verb, Spec{prec: sp.prec, plus: true})) {
        (Some(a), Some(b)) => pad("(" + a + b + "i)", Spec{minus: sp.minus, width: sp.width}, false)
        _ => bad_verb(verb, x, sp)
      }
    }
    StrV(s) => fmt_str(s, verb, sp) ?? bad_verb(verb, x, sp)
    TrustedV(_, s) => fmt_str(s, verb, sp) ?? bad_verb(verb, x, sp)
    ListV(items) => "[" + items.map(fn(e) { fmt_elem(e, verb, sp) }).join(" ") + "]"
    MapV(fields) => "map[" + map_order(fields).map(fn(f) { fmt_arg(val(V.StrV(s: f.0)), verb, sp) + ":" + fmt_elem(f.1, verb, sp) }).join(" ") + "]"
    Missing => "{}"
  }
}

/// An element of a list or map: printValue prints a nil interface as
/// <nil> whatever the verb.
fn fmt_elem(e: V, verb: Rune, sp: Spec) -> Str {
  match e {
    NilIface => pad("<nil>", sp, false)
    _ => fmt_arg(Val{v: e, boxed: true}, verb, sp)
  }
}

fn sprintf(format: Str, args: List[Val]) -> Str {
  let rs = format.runes()
  var out = StrBuilder.new()
  var argn = 0
  var i = 0
  while i < rs.len() {
    let c = rs[i]
    if c != '%' {
      out.write("${c}")
      i += 1
      continue
    }
    i += 1
    var sp = Spec{}
    // flags
    while i < rs.len() {
      match rs[i] {
        '#' => sp.sharp = true
        '0' => sp.zero = !sp.minus
        '+' => sp.plus = true
        '-' => {
          sp.minus = true
          sp.zero = false
        }
        ' ' => sp.space = true
        _ => break
      }
      i += 1
    }
    // width
    if i < rs.len() && rs[i] == '*' {
      i += 1
      if argn < args.len() {
        match unbox(args[argn]).v {
          IntV(n, _) => {
            sp.width = if n < 0 { -n } else { n }
            if n < 0 {
              sp.minus = true
              sp.zero = false
            }
          }
          _ => out.write("%!(BADWIDTH)")
        }
        argn += 1
      } else {
        out.write("%!(BADWIDTH)")
      }
    } else {
      var w = -1
      while i < rs.len() && rs[i] >= '0' && rs[i] <= '9' {
        w = (if w < 0 { 0 } else { w }) * 10 + (Int(rs[i]) - 48)
        i += 1
      }
      sp.width = w
    }
    // precision
    if i < rs.len() && rs[i] == '.' {
      i += 1
      if i < rs.len() && rs[i] == '*' {
        i += 1
        if argn < args.len() {
          match unbox(args[argn]).v {
            IntV(n, _) => sp.prec = if n < 0 { -1 } else { n }
            _ => out.write("%!(BADPREC)")
          }
          argn += 1
        } else {
          out.write("%!(BADPREC)")
        }
      } else {
        var p = 0
        while i < rs.len() && rs[i] >= '0' && rs[i] <= '9' {
          p = p * 10 + (Int(rs[i]) - 48)
          i += 1
        }
        sp.prec = p
      }
    }
    if i >= rs.len() {
      out.write("%!(NOVERB)")
      break
    }
    let verb = rs[i]
    i += 1
    if verb == '%' {
      out.write("%")
      continue
    }
    if argn >= args.len() {
      out.write("%!${verb}(MISSING)")
      continue
    }
    out.write(fmt_arg(args[argn], verb, sp))
    argn += 1
  }
  if argn < args.len() {
    out.write("%!(EXTRA ")
    var parts: List[Str] = []
    for a in args[argn..] {
      let u = unbox(a)
      parts.push(match u.v {
        Invalid => "<nil>"
        _ => "${type_name(u)}=${fmt_v(u.v, false)}"
      })
    }
    out.write(parts.join(", "))
    out.write(")")
  }
  out.freeze()
}

// ---------------------------------------------------------------------------
// The module's functions

/// Parses the set's sources (template.Parse for each): the trees, or
/// Go's parse error.
fn parse_set(t: template.Template) -> List[Tree] ! template.TemplateErr {
  var trees: List[Tree] = []
  for (name, src) in t.sources {
    var fnames: List[Str] = []
    for (k, _) in t.funcs {
      fnames.push(k)
    }
    var p = Parser{lex: Lexer{input: src.bytes(), left: t.left.bytes(), right: t.right.bytes()}, name: name, parse_name: name, text: src.bytes(), trees: trees, funcs: fnames}
    let root = p.parse()
    if !p.err.is_empty() {
      return Err(template.TemplateErr{msg: p.err})
    }
    p.add_tree(Tree{name: name, parse_name: name, text: src.bytes(), root: root})
    if !p.err.is_empty() {
      return Err(template.TemplateErr{msg: p.err})
    }
    trees = p.trees
  }
  Ok(trees)
}

fn html(s: Str) -> json.Value { json.Value.Trusted(kind: "html", s: s) }
fn css(s: Str) -> json.Value { json.Value.Trusted(kind: "css", s: s) }
fn js(s: Str) -> json.Value { json.Value.Trusted(kind: "js", s: s) }
fn jsstr(s: Str) -> json.Value { json.Value.Trusted(kind: "jsstr", s: s) }
fn url(s: Str) -> json.Value { json.Value.Trusted(kind: "url", s: s) }
fn attr(s: Str) -> json.Value { json.Value.Trusted(kind: "attr", s: s) }
fn srcset(s: Str) -> json.Value { json.Value.Trusted(kind: "srcset", s: s) }

fn parse(name: Str, src: Str, left: Str = "{{", right: Str = "}}", funcs: Map[Str, template.TemplateFn] = {}) -> template.Template ! template.TemplateErr {
  let t = template.Template{name: name, sources: [(name, src)], funcs: funcs, left: if left.is_empty() { "{{" } else { left }, right: if right.is_empty() { "}}" } else { right }, parsed: rt.cast[Parsed, template.Parsed](Parsed{})}
  let trees = parse_set(t)?
  Ok(t with {parsed: rt.cast[Parsed, template.Parsed](Parsed{trees: trees})})
}

fn parse_html(name: Str, src: Str, left: Str = "{{", right: Str = "}}", funcs: Map[Str, template.TemplateFn] = {}) -> template.Template ! template.TemplateErr {
  let t = parse(name, src, left, right, funcs)?
  Ok(with_escaped(t with {html: true}))
}

/// The html mode's trees escaped from the root (its error kept for render).
fn with_escaped(t: template.Template) -> template.Template {
  let pp = rt.cast[template.Parsed, Parsed](t.parsed)
  match escape_set(pp.trees, t.name) {
    Ok(esc) => t with {parsed: rt.cast[Parsed, template.Parsed](pp with {escaped: esc, esc_err: ""})}
    Err(e) => t with {parsed: rt.cast[Parsed, template.Parsed](pp with {escaped: [], esc_err: e.msg})}
  }
}

fn template_add(t: template.Template, name: Str, src: Str) -> template.Template ! template.TemplateErr {
  let n = t with {sources: t.sources + [(name, src)]}
  let trees = parse_set(n)?
  let out = n with {parsed: rt.cast[Parsed, template.Parsed](Parsed{trees: trees})}
  Ok(if n.html { with_escaped(out) } else { out })
}

fn template_missing_key(t: template.Template, error: Bool) -> template.Template { t with {missing_key_error: error} }

fn template_render(t: template.Template, data: json.Value) -> Str ! template.TemplateErr { template_render_named(t, t.name, data) }

fn template_render_named(t: template.Template, name: Str, data: json.Value) -> Str ! template.TemplateErr {
  let pp = rt.cast[template.Parsed, Parsed](t.parsed)
  var trees = pp.trees
  if trees.is_empty() {
    trees = parse_set(t)?
  }
  if t.html {
    if name == t.name && pp.esc_err.is_empty() && !pp.escaped.is_empty() {
      trees = pp.escaped
    } else if name == t.name && !pp.esc_err.is_empty() {
      return Err(template.TemplateErr{msg: pp.esc_err})
    } else {
      trees = escape_set(trees, name)?
    }
  }
  var tree: Tree? = None
  for x in trees {
    if x.name == name {
      tree = Some(x)
    }
  }
  let tr = match tree {
    Some(x) => x
    None => return Err(template.TemplateErr{msg: "template: no template ${go_quote(name)} associated with template ${go_quote(t.name)}"})
  }
  let dot = val(of_json(data, false))
  var s = Ex{trees: trees, funcs: t.funcs, missing_error: t.missing_key_error, tree: tr, vars: [Var{name: "$", value: dot}]}
  match s.walk_list(dot, tr.root) {
    Ok(_) => Ok(s.out)
    Err(e) => Err(template.TemplateErr{msg: e})
  }
}

// ---------------------------------------------------------------------------
// escape.go, in std/native/template.xo (the tree's types live there):
// the walk over the parsed trees that inserts the escaping functions.
// Go edits nodes in place at commit; here the walk returns the rewritten
// nodes, and each (template, context) pair's rewritten tree is kept by
// its derived name, so commit is replacing the set's trees.

const ESC_FUNCS: List[Str] = ["_html_template_attrescaper", "_html_template_commentescaper", "_html_template_cssescaper", "_html_template_cssvaluefilter", "_html_template_htmlnamefilter", "_html_template_htmlescaper", "_html_template_jsregexpescaper", "_html_template_jsstrescaper", "_html_template_jstmpllitescaper", "_html_template_jsvalescaper", "_html_template_nospaceescaper", "_html_template_rcdataescaper", "_html_template_srcsetescaper", "_html_template_urlescaper", "_html_template_urlfilter", "_html_template_urlnormalizer", "_eval_args_"]

/// A context at a break or continue, with the action's line (Go's c.n).
struct RangeCtx {
  /// (the context, the action's position and line)
  breaks: List[(Context, Int, Int)] = []
  continues: List[(Context, Int, Int)] = []
}

struct Escaper {
  /// the set's trees by name (the parse result)
  trees: List[Tree]
  /// the output context of each template (by derived name) that has
  /// been, or is being, escaped
  output: Map[Str, Context] = {}
  /// the rewritten root of each template or derived template, by name
  rewritten: Map[Str, List[Node]] = {}
  /// the parse name of each derived template's original (error texts)
  derived_from: Map[Str, Str] = {}
  called: Map[Str, Bool] = {}
  /// the range loops being walked, innermost last
  range_ctx: List[RangeCtx] = []
  /// the tree whose text positions the error contexts use
  cur: Tree
}

/// Go's ErrorContext of a node: `parse_name:line:col`.
fn (e: Escaper) loc(pos: Int) -> Str {
  let text = e.cur.text[0..pos]
  let line = 1 + text.count(b"\n")
  let col = match text.rfind(b"\n") {
    Some(i) => pos - (i + 1)
    None => pos
  }
  "${e.cur.parse_name}:${line}:${col}"
}

fn (e: Escaper) err_node(code: Int, pos: Int, desc: Str) -> Context {
  Context{state: STATE_ERROR, err: Some(EscErr{code: code, name: e.loc(pos), line: 0, desc: desc})}
}

fn err_line(code: Int, line: Int, desc: Str) -> Context {
  Context{state: STATE_ERROR, err: Some(EscErr{code: code, name: "", line: line, desc: desc})}
}

/// escapeTemplate: the set's template name escaped from the text
/// context, its trees rewritten; Go's error otherwise.
fn escape_set(trees: List[Tree], name: Str) -> List[Tree] ! template.TemplateErr {
  var e = Escaper{trees: trees, cur: trees[0]}
  let (c, _) = e.escape_tree(Context{}, -1, name, 0)
  match c.err {
    Some(er) => {
      // the error names the template when it has no location
      // Go's escapeTemplate names the root template in an error with no
      // node location of its own
      let named = if er.name.is_empty() { er with {name: name} } else { er }
      return Err(template.TemplateErr{msg: named.display()})
    }
    None => {}
  }
  if c.state != STATE_TEXT {
    return Err(template.TemplateErr{msg: EscErr{code: ERR_END_CONTEXT, name: name, line: 0, desc: "ends in a non-text context: ${c.text()}"}.display()})
  }
  e.commit()
}

/// commit: the trees with their rewritten roots, the derived ones added.
fn (e: Escaper) commit() -> List[Tree] ! template.TemplateErr {
  var out: List[Tree] = []
  var seen: List[Str] = []
  for t in e.trees {
    match e.rewritten.get(t.name) {
      Some(root) => out.push(t with {root: root})
      None => out.push(t)
    }
    seen.push(t.name)
  }
  for (dname, root) in e.rewritten {
    if seen.contains(dname) {
      continue
    }
    let from = e.derived_from.get(dname) ?? dname
    let orig = e.find_tree(from) ?? e.trees[0]
    out.push(Tree{name: dname, parse_name: orig.parse_name, text: orig.text, root: root})
  }
  Ok(out)
}

fn (e: Escaper) find_tree(name: Str) -> Tree? {
  for t in e.trees {
    if t.name == name {
      return Some(t)
    }
  }
  None
}

fn (var e: Escaper) escape(c: Context, n: Node) -> (Context, Node) {
  match n {
    Action(pos, line, pipe) => e.escape_action(c, pos, line, pipe)
    Break(pos, line) => {
      e.push_break(c, pos, line)
      (Context{state: STATE_DEAD}, n)
    }
    Comment(..) => (c, n)
    Continue(pos, line) => {
      e.push_continue(c, pos, line)
      (Context{state: STATE_DEAD}, n)
    }
    If(pos, line, pipe, list, else_list) => {
      let (c1, l1, el1) = e.escape_branch(c, pos, line, list, else_list, "if")
      (c1, Node.If(pos: pos, line: line, pipe: pipe, list: l1, else_list: el1))
    }
    Range(pos, line, pipe, list, else_list) => {
      let (c1, l1, el1) = e.escape_branch(c, pos, line, list, else_list, "range")
      (c1, Node.Range(pos: pos, line: line, pipe: pipe, list: l1, else_list: el1))
    }
    With(pos, line, pipe, list, else_list) => {
      let (c1, l1, el1) = e.escape_branch(c, pos, line, list, else_list, "with")
      (c1, Node.With(pos: pos, line: line, pipe: pipe, list: l1, else_list: el1))
    }
    TemplateN(pos, line, name, pipe) => {
      let (c1, dname) = e.escape_tree(c, pos, name, line)
      (c1, Node.TemplateN(pos: pos, line: line, name: dname, pipe: pipe))
    }
    Text(pos, text) => {
      let (c1, t1) = escape_text(c, text)
      (c1, Node.Text(pos: pos, text: t1))
    }
    End(..) | Else(..) => (c, n)
  }
}

fn (var e: Escaper) push_break(c: Context, pos: Int, line: Int) {
  if e.range_ctx.is_empty() {
    return
  }
  let last = e.range_ctx.len() - 1
  var rc = e.range_ctx[last]
  rc.breaks.push((c, pos, line))
  e.range_ctx[last] = rc
}

fn (var e: Escaper) push_continue(c: Context, pos: Int, line: Int) {
  if e.range_ctx.is_empty() {
    return
  }
  let last = e.range_ctx.len() - 1
  var rc = e.range_ctx[last]
  rc.continues.push((c, pos, line))
  e.range_ctx[last] = rc
}

const PREDEFINED_ESCAPERS: List[Str] = ["html", "urlquery"]

fn cmd_ident(cmd: Cmd) -> Str? {
  if cmd.args.is_empty() {
    return None
  }
  match cmd.args[0] {
    Ident(_, name) => Some(name)
    _ => None
  }
}

/// escapeAction: the escaping functions an action needs in its context,
/// appended to its pipeline.
fn (var e: Escaper) escape_action(c0: Context, pos: Int, line: Int, pipe: Pipe) -> (Context, Node) {
  let node = Node.Action(pos: pos, line: line, pipe: pipe)
  if !pipe.decl.is_empty() {
    return (c0, node)
  }
  var c = nudge(c0)
  for (k, cmd) in pipe.cmds.indexed() {
    let ident = match cmd_ident(cmd) {
      Some(x) => x
      None => continue
    }
    if PREDEFINED_ESCAPERS.contains(ident) {
      if k < pipe.cmds.len() - 1 || (c.state == STATE_ATTR && c.delim == DELIM_SPACE_OR_TAG_END && ident == "html") {
        return (e.err_node(ERR_PREDEFINED_ESCAPER, pos, "predefined escaper ${go_quote(ident)} disallowed in template"), node)
      }
    }
  }
  var s: List[Str] = []
  let st = c.state
  if st == STATE_ERROR {
    return (c, node)
  } else if st == STATE_URL || st == STATE_CSS_DQ_STR || st == STATE_CSS_SQ_STR || st == STATE_CSS_DQ_URL || st == STATE_CSS_SQ_URL || st == STATE_CSS_URL {
    if c.url_part == URL_PART_NONE || c.url_part == URL_PART_PRE_QUERY {
      if c.url_part == URL_PART_NONE {
        s.push("_html_template_urlfilter")
      }
      if st == STATE_CSS_DQ_STR || st == STATE_CSS_SQ_STR {
        s.push("_html_template_cssescaper")
      } else {
        s.push("_html_template_urlnormalizer")
      }
    } else if c.url_part == URL_PART_QUERY_OR_FRAG {
      s.push("_html_template_urlescaper")
    } else {
      return (e.err_node(ERR_AMBIG_CONTEXT, pos, "${action_text(pipe)} appears in an ambiguous context within a URL"), node)
    }
  } else if st == STATE_META_CONTENT {
    // nothing
  } else if st == STATE_META_CONTENT_URL {
    s.push("_html_template_urlfilter")
  } else if st == STATE_JS {
    s.push("_html_template_jsvalescaper")
    c.js_ctx = JS_CTX_DIV_OP
  } else if st == STATE_JS_DQ_STR || st == STATE_JS_SQ_STR {
    s.push("_html_template_jsstrescaper")
  } else if st == STATE_JS_TMPL_LIT {
    s.push("_html_template_jstmpllitescaper")
  } else if st == STATE_JS_REGEXP {
    s.push("_html_template_jsregexpescaper")
  } else if st == STATE_CSS {
    s.push("_html_template_cssvaluefilter")
  } else if st == STATE_TEXT {
    s.push("_html_template_htmlescaper")
  } else if st == STATE_RCDATA {
    s.push("_html_template_rcdataescaper")
  } else if st == STATE_ATTR {
    // nothing
  } else if st == STATE_ATTR_NAME || st == STATE_TAG {
    c.state = STATE_ATTR_NAME
    s.push("_html_template_htmlnamefilter")
  } else if st == STATE_SRCSET {
    s.push("_html_template_srcsetescaper")
  } else if is_comment(st) {
    s.push("_html_template_commentescaper")
  }
  if c.delim == DELIM_SPACE_OR_TAG_END {
    s.push("_html_template_nospaceescaper")
  } else if c.delim != DELIM_NONE {
    s.push("_html_template_attrescaper")
  }
  (c, Node.Action(pos: pos, line: line, pipe: ensure_pipeline_contains(pipe, s)))
}

/// `{{pipeline}}` as Go prints an action node (the ambiguous URL error).
fn action_text(pipe: Pipe) -> Str { "{{" + pipe_text(pipe) + "}}" }

const EQUIV_ESCAPERS: List[(Str, Str)] = [("_html_template_attrescaper", "html"), ("_html_template_htmlescaper", "html"), ("_html_template_rcdataescaper", "html"), ("_html_template_urlescaper", "urlquery"), ("_html_template_urlnormalizer", "urlquery")]

fn normalize_esc_fn(e: Str) -> Str {
  for (k, v) in EQUIV_ESCAPERS {
    if k == e {
      return v
    }
  }
  e
}

/// redundantFuncs: (last, next) pairs where next adds nothing after last.
const REDUNDANT_FUNCS: List[(Str, Str)] = [("_html_template_commentescaper", "_html_template_attrescaper"), ("_html_template_commentescaper", "_html_template_htmlescaper"), ("_html_template_cssescaper", "_html_template_attrescaper"), ("_html_template_jsregexpescaper", "_html_template_attrescaper"), ("_html_template_jsstrescaper", "_html_template_attrescaper"), ("_html_template_jstmpllitescaper", "_html_template_attrescaper"), ("_html_template_urlescaper", "_html_template_urlnormalizer")]

fn ident_cmd(name: Str, pos: Int) -> Cmd { Cmd{pos: pos, args: [Arg.Ident(pos: pos, name: name)]} }

fn append_cmd(cmds: List[Cmd], cmd: Cmd) -> List[Cmd] {
  if !cmds.is_empty() {
    match (cmd_ident(cmds[cmds.len() - 1]), cmd_ident(cmd)) {
      (Some(last), Some(next)) => {
        for (a, b) in REDUNDANT_FUNCS {
          if a == last && b == next {
            return cmds
          }
        }
      }
      _ => {}
    }
  }
  cmds + [cmd]
}

/// ensurePipelineContains: the escapers s appended to the pipeline,
/// a predefined escaper (`html`, `urlquery`) at its end kept in place
/// of its equivalent and moved after its arguments' evaluation.
fn ensure_pipeline_contains(p: Pipe, s0: List[Str]) -> Pipe {
  if s0.is_empty() {
    return p
  }
  var s = s0
  var cmds = p.cmds
  var pipeline_len = cmds.len()
  if pipeline_len > 0 {
    let last_cmd = cmds[pipeline_len - 1]
    match cmd_ident(last_cmd) {
      Some(esc) => {
        if PREDEFINED_ESCAPERS.contains(esc) {
          if cmds.len() == 1 && last_cmd.args.len() > 1 {
            var args = last_cmd.args
            args[0] = Arg.Ident(pos: arg_pos(last_cmd.args[0]), name: "_eval_args_")
            cmds[0] = last_cmd with {args: args}
            cmds = append_cmd(cmds, ident_cmd(esc, p.pos))
            pipeline_len += 1
          }
          var dup = false
          for (i, escaper) in s0.indexed() {
            if normalize_esc_fn(esc) == normalize_esc_fn(escaper) {
              s[i] = esc
              dup = true
            }
          }
          if dup {
            pipeline_len -= 1
          }
        }
      }
      None => {}
    }
  }
  var new_cmds: List[Cmd] = []
  var inserted: List[Str] = []
  var i = 0
  while i < pipeline_len {
    let cmd = cmds[i]
    new_cmds.push(cmd)
    match cmd_ident(cmd) {
      Some(id) => inserted.push(normalize_esc_fn(id))
      None => {}
    }
    i += 1
  }
  for name in s {
    if !inserted.contains(normalize_esc_fn(name)) {
      new_cmds = append_cmd(new_cmds, ident_cmd(name, p.pos))
    }
  }
  p with {cmds: new_cmds}
}

/// escapeBranch: both branches walked, their end contexts joined; a
/// range body is walked twice (re-entry) with its breaks and continues.
fn (var e: Escaper) escape_branch(c: Context, pos: Int, line: Int, list: List[Node], else_list: List[Node]?, node_name: Str) -> (Context, List[Node], List[Node]?) {
  if node_name == "range" {
    e.range_ctx.push(RangeCtx{})
  }
  let (c00, l0) = e.escape_list(c, list)
  var c0 = c00
  if node_name == "range" {
    if c0.state != STATE_ERROR {
      c0 = e.join_range(c0, e.range_ctx[e.range_ctx.len() - 1])
    }
    e.range_ctx.pop()
    if c0.state == STATE_ERROR {
      return (c0, l0, else_list)
    }
    e.range_ctx.push(RangeCtx{})
    let (c1, _, _) = e.escape_list_conditionally(c0, list, false, "")
    c0 = e.join(c0, c1, pos, node_name)
    if c0.state == STATE_ERROR {
      e.range_ctx.pop()
      return (with_line_prefix(c0, line, "on range loop re-entry: "), l0, else_list)
    }
    c0 = e.join_range(c0, e.range_ctx[e.range_ctx.len() - 1])
    e.range_ctx.pop()
    if c0.state == STATE_ERROR {
      return (c0, l0, else_list)
    }
  }
  match else_list {
    Some(el) => {
      let (c1, el1) = e.escape_list(c, el)
      (e.join(c0, c1, pos, node_name), l0, Some(el1))
    }
    None => (e.join(c0, c, pos, node_name), l0, None)
  }
}

/// Go sets the error's Line and prefixes its description; an error with
/// a node location keeps showing that location (Error() checks the node
/// first).
fn with_line_prefix(c: Context, line: Int, prefix: Str) -> Context {
  match c.err {
    Some(er) => c with {err: Some(er with {line: if er.name.is_empty() { line } else { er.line }, desc: prefix + er.desc})}
    None => c
  }
}

/// joinRange: the loop's end context joined with each break's and
/// continue's (an error is at that action).
fn (e: Escaper) join_range(c00: Context, rc: RangeCtx) -> Context {
  var c0 = c00
  for (c, pos, line) in rc.breaks {
    c0 = e.join(c0, c, pos, "range")
    if c0.state == STATE_ERROR {
      return with_line_prefix(c0, line, "at range loop break: ")
    }
  }
  for (c, pos, line) in rc.continues {
    c0 = e.join(c0, c, pos, "range")
    if c0.state == STATE_ERROR {
      return with_line_prefix(c0, line, "at range loop continue: ")
    }
  }
  c0
}

fn (e: Escaper) join(a: Context, b: Context, pos: Int, node_name: Str) -> Context {
  let c = join_plain(a, b, node_name)
  match c.err {
    Some(er) => {
      if er.code == ERR_BRANCH_END && er.name.is_empty() {
        return c with {err: Some(er with {name: e.loc(pos)})}
      }
      c
    }
    None => c
  }
}

/// join: the context after two branches, or the branch end error (its
/// location is filled in by the caller).
fn join_plain(a: Context, b: Context, node_name: Str) -> Context {
  if a.state == STATE_ERROR {
    return a
  }
  if b.state == STATE_ERROR {
    return b
  }
  if a.state == STATE_DEAD {
    return b
  }
  if b.state == STATE_DEAD {
    return a
  }
  if a.eq(b) {
    return a
  }
  var c = a with {url_part: b.url_part}
  if c.eq(b) {
    return c with {url_part: URL_PART_UNKNOWN}
  }
  c = a with {js_ctx: b.js_ctx}
  if c.eq(b) {
    return c with {js_ctx: JS_CTX_UNKNOWN}
  }
  let na = nudge(a)
  let nb = nudge(b)
  if !(na.eq(a) && nb.eq(b)) {
    let j = join_plain(na, nb, node_name)
    if j.state != STATE_ERROR {
      return j
    }
  }
  Context{state: STATE_ERROR, err: Some(EscErr{code: ERR_BRANCH_END, name: "", line: 0, desc: "{{${node_name}}} branches end in different contexts: ${a.text()}, ${b.text()}"})}
}

fn (var e: Escaper) escape_list(c0: Context, nodes: List[Node]) -> (Context, List[Node]) {
  var c = c0
  var out: List[Node] = []
  var dead = false
  for m in nodes {
    if dead {
      out.push(m)
      continue
    }
    let (c1, m1) = e.escape(c, m)
    c = c1
    out.push(m1)
    if c.state == STATE_DEAD {
      dead = true
    }
  }
  (c, out)
}

/// escapeListConditionally: the list walked by a copy of the escaper,
/// whose results are kept only when the filter accepts the end context
/// (keep: the template body's rule, with its name; false for the range
/// re-entry probe).
fn (var e: Escaper) escape_list_conditionally(c: Context, nodes: List[Node], keep: Bool, tname: Str) -> (Context, Bool, List[Node]) {
  // Go's makeEscaper: the copy starts with the output contexts and no
  // calls of its own (the filter asks whether the body called itself)
  var e1 = e
  e1.called = {}
  let (c1, out) = e1.escape_list(c, nodes)
  var ok = false
  if keep {
    if c1.state == STATE_ERROR {
      ok = false
    } else if !(e1.called.get(tname) ?? false) {
      ok = true
    } else {
      ok = c.eq(c1)
    }
  }
  if ok {
    e.output = e1.output
    e.rewritten = e1.rewritten
    e.derived_from = e1.derived_from
    for (k, v) in e1.called {
      e.called.put(k, v)
    }
  }
  // the range contexts (breaks and continues) of the probe are kept
  // either way, as Go's shared rangeContext pointer does
  e.range_ctx = e1.range_ctx
  (c1, ok, out)
}

/// escapeTree: the template name walked from c, by its derived name.
fn (var e: Escaper) escape_tree(c: Context, pos: Int, name: Str, line: Int) -> (Context, Str) {
  let dname = c.mangle(name)
  e.called.put(dname, true)
  match e.output.get(dname) {
    Some(out) => return (out, dname)
    None => {}
  }
  let t = match e.find_tree(name) {
    Some(t) => t
    None => {
      let desc = if e.has_empty(name) { "${go_quote(name)} is an incomplete or empty template" } else { "no such template ${go_quote(name)}" }
      if pos >= 0 {
        return (e.err_node(ERR_NO_SUCH_TEMPLATE, pos, desc), dname)
      }
      return (err_line(ERR_NO_SUCH_TEMPLATE, line, desc), dname)
    }
  }
  if dname != name {
    e.derived_from.put(dname, name)
  }
  (e.compute_out_ctx(c, t, dname), dname)
}

/// A name the set declares with no tree (`{{define "x"}}{{end}}` parsed
/// to nothing): Go's "incomplete or empty template".
fn (e: Escaper) has_empty(name: Str) -> Bool { false }

fn (var e: Escaper) compute_out_ctx(c: Context, t: Tree, dname: Str) -> Context {
  let (c10, ok0) = e.escape_template_body(c, t, dname)
  var c1 = c10
  var ok = ok0
  if !ok {
    let (c2, ok2) = e.escape_template_body(c1, t, dname)
    if ok2 {
      c1 = c2
      ok = true
    }
  }
  if !ok && c1.state != STATE_ERROR {
    return Context{state: STATE_ERROR, err: Some(EscErr{code: ERR_OUTPUT_CONTEXT, name: "", line: 0, desc: "cannot compute output context for template ${dname}"})}
  }
  c1
}

fn (var e: Escaper) escape_template_body(c: Context, t: Tree, dname: Str) -> (Context, Bool) {
  e.output.put(dname, c)
  let saved = e.cur
  e.cur = t
  let (c1, ok, out) = e.escape_list_conditionally(c, t.root, true, dname)
  e.cur = saved
  if ok {
    e.rewritten.put(dname, out)
  }
  (c1, ok)
}

// ===========================================================================
// html/template's context machine and escapers (decision
// 0408), ported from Go's html/template (go1.26.1): context.go,
// transition.go, html.go, attr.go, url.go, js.go, css.go, error.go. The
// walk over the parsed tree lives in std/native/template.xo (the tree's
// types are there); these are pure functions over Bytes and Str (one file per std module, so they live here).

// ---------------------------------------------------------------------------
// context.go

/// The states (state_string.go gives the names).
const STATE_TEXT = 0
const STATE_TAG = 1
const STATE_ATTR_NAME = 2
const STATE_AFTER_NAME = 3
const STATE_BEFORE_VALUE = 4
const STATE_HTML_CMT = 5
const STATE_RCDATA = 6
const STATE_ATTR = 7
const STATE_URL = 8
const STATE_SRCSET = 9
const STATE_JS = 10
const STATE_JS_DQ_STR = 11
const STATE_JS_SQ_STR = 12
const STATE_JS_TMPL_LIT = 13
const STATE_JS_REGEXP = 14
const STATE_JS_BLOCK_CMT = 15
const STATE_JS_LINE_CMT = 16
const STATE_JS_HTML_OPEN_CMT = 17
const STATE_JS_HTML_CLOSE_CMT = 18
const STATE_CSS = 19
const STATE_CSS_DQ_STR = 20
const STATE_CSS_SQ_STR = 21
const STATE_CSS_DQ_URL = 22
const STATE_CSS_SQ_URL = 23
const STATE_CSS_URL = 24
const STATE_CSS_BLOCK_CMT = 25
const STATE_CSS_LINE_CMT = 26
const STATE_ERROR = 27
const STATE_META_CONTENT = 28
const STATE_META_CONTENT_URL = 29
const STATE_DEAD = 30

const STATE_NAMES: List[Str] = ["stateText", "stateTag", "stateAttrName", "stateAfterName", "stateBeforeValue", "stateHTMLCmt", "stateRCDATA", "stateAttr", "stateURL", "stateSrcset", "stateJS", "stateJSDqStr", "stateJSSqStr", "stateJSTmplLit", "stateJSRegexp", "stateJSBlockCmt", "stateJSLineCmt", "stateJSHTMLOpenCmt", "stateJSHTMLCloseCmt", "stateCSS", "stateCSSDqStr", "stateCSSSqStr", "stateCSSDqURL", "stateCSSSqURL", "stateCSSURL", "stateCSSBlockCmt", "stateCSSLineCmt", "stateError", "stateMetaContent", "stateMetaContentURL", "stateDead"]

const DELIM_NONE = 0
const DELIM_DOUBLE_QUOTE = 1
const DELIM_SINGLE_QUOTE = 2
const DELIM_SPACE_OR_TAG_END = 3
const DELIM_NAMES: List[Str] = ["delimNone", "delimDoubleQuote", "delimSingleQuote", "delimSpaceOrTagEnd"]

const URL_PART_NONE = 0
const URL_PART_PRE_QUERY = 1
const URL_PART_QUERY_OR_FRAG = 2
const URL_PART_UNKNOWN = 3
const URL_PART_NAMES: List[Str] = ["urlPartNone", "urlPartPreQuery", "urlPartQueryOrFrag", "urlPartUnknown"]

const JS_CTX_REGEXP = 0
const JS_CTX_DIV_OP = 1
const JS_CTX_UNKNOWN = 2
const JS_CTX_NAMES: List[Str] = ["jsCtxRegexp", "jsCtxDivOp", "jsCtxUnknown"]

const ELEMENT_NONE = 0
const ELEMENT_SCRIPT = 1
const ELEMENT_STYLE = 2
const ELEMENT_TEXTAREA = 3
const ELEMENT_TITLE = 4
const ELEMENT_META = 5
const ELEMENT_NAMES: List[Str] = ["elementNone", "elementScript", "elementStyle", "elementTextarea", "elementTitle", "elementMeta"]

const ATTR_NONE = 0
const ATTR_SCRIPT = 1
const ATTR_SCRIPT_TYPE = 2
const ATTR_STYLE = 3
const ATTR_URL = 4
const ATTR_SRCSET = 5
const ATTR_META_CONTENT = 6
const ATTR_NAMES: List[Str] = ["attrNone", "attrScript", "attrScriptType", "attrStyle", "attrURL", "attrSrcset", "attrMetaContent"]

/// An escaping error (error.go): the code (ERR_*), the template name and
/// line, and the description; display is Go's text.
struct EscErr {
  code: Int
  name: Str
  line: Int
  desc: Str
}

fn (e: EscErr) display() -> Str {
  if e.line != 0 {
    "html/template:${e.name}:${e.line}: ${e.desc}"
  } else if !e.name.is_empty() {
    "html/template:${e.name}: ${e.desc}"
  } else {
    "html/template: ${e.desc}"
  }
}

const OK = 0
const ERR_AMBIG_CONTEXT = 1
const ERR_BAD_HTML = 2
const ERR_BRANCH_END = 3
const ERR_END_CONTEXT = 4
const ERR_NO_SUCH_TEMPLATE = 5
const ERR_OUTPUT_CONTEXT = 6
const ERR_PARTIAL_CHARSET = 7
const ERR_PARTIAL_ESCAPE = 8
const ERR_RANGE_LOOP_REENTRY = 9
const ERR_SLASH_AMBIG = 10
const ERR_PREDEFINED_ESCAPER = 11
const ERR_JS_TMPL_LIT = 12

/// The escaper's context (context.go): where the next byte of output
/// lands. `n` (the template whose context is being computed, for
/// range break and continue) is the native walk's own record; `err`
/// is None until the first error.
struct Context {
  /// the defaults are STATE_TEXT, DELIM_NONE, URL_PART_NONE, JS_CTX_REGEXP,
  /// ATTR_NONE and ELEMENT_NONE (0 each; a field default names no constant
  /// on the native backends)
  state: Int = 0
  delim: Int = 0
  url_part: Int = 0
  js_ctx: Int = 0
  js_brace_depth: List[Int] = []
  attr: Int = 0
  element: Int = 0
  err: EscErr? = None
}

fn (c: Context) text() -> Str {
  let err = match c.err {
    Some(e) => e.display()
    None => "<nil>"
  }
  "{${STATE_NAMES[c.state]} ${DELIM_NAMES[c.delim]} ${URL_PART_NAMES[c.url_part]} ${JS_CTX_NAMES[c.js_ctx]} ${ATTR_NAMES[c.attr]} ${ELEMENT_NAMES[c.element]} ${err}}"
}

/// context.eq: the fields but js_brace_depth (Go compares the error
/// pointer; here the errors' values).
fn (c: Context) eq(d: Context) -> Bool {
  c.state == d.state && c.delim == d.delim && c.url_part == d.url_part && c.js_ctx == d.js_ctx && c.attr == d.attr && c.element == d.element && c.err == d.err
}

/// context.mangle: the derived template's name for a context.
fn (c: Context) mangle(template_name: Str) -> Str {
  if c.state == STATE_TEXT {
    return template_name
  }
  var s = template_name + "$htmltemplate_" + STATE_NAMES[c.state]
  if c.delim != DELIM_NONE {
    s = s + "_" + DELIM_NAMES[c.delim]
  }
  if c.url_part != URL_PART_NONE {
    s = s + "_" + URL_PART_NAMES[c.url_part]
  }
  if c.js_ctx != JS_CTX_REGEXP {
    s = s + "_" + JS_CTX_NAMES[c.js_ctx]
  }
  if c.attr != ATTR_NONE {
    s = s + "_" + ATTR_NAMES[c.attr]
  }
  if c.element != ELEMENT_NONE {
    s = s + "_" + ELEMENT_NAMES[c.element]
  }
  s
}

fn is_comment(s: Int) -> Bool {
  s == STATE_HTML_CMT || s == STATE_JS_BLOCK_CMT || s == STATE_JS_LINE_CMT || s == STATE_JS_HTML_OPEN_CMT || s == STATE_JS_HTML_CLOSE_CMT || s == STATE_CSS_BLOCK_CMT || s == STATE_CSS_LINE_CMT
}

fn is_in_tag(s: Int) -> Bool {
  s == STATE_TAG || s == STATE_ATTR_NAME || s == STATE_AFTER_NAME || s == STATE_BEFORE_VALUE || s == STATE_ATTR
}

fn is_in_script_literal(s: Int) -> Bool {
  s == STATE_JS_DQ_STR || s == STATE_JS_SQ_STR || s == STATE_JS_TMPL_LIT || s == STATE_JS_REGEXP
}

// ---------------------------------------------------------------------------
// transition.go: a function per state over the text, returning the
// context after it and how many bytes it consumed

fn esc_err(code: Int, desc: Str) -> Context {
  Context{state: STATE_ERROR, err: Some(EscErr{code: code, name: "", line: 0, desc: desc})}
}

/// Go's %q of bytes (strconv.Quote of the text).
fn go_quote_bytes(s: Bytes) -> Str { (s.to_str() ?? "").debug() }

fn transition(c: Context, s: Bytes) -> (Context, Int) { transition_in(c.state, c, s) }

/// transitionFunc[st](c, s): the state's function, with c as it is
/// (stripTags runs the RCDATA one on a context in another state).
fn transition_in(st: Int, c: Context, s: Bytes) -> (Context, Int) {
  if st == STATE_TEXT {
    return t_text(c, s)
  } else if st == STATE_TAG {
    return t_tag(c, s)
  } else if st == STATE_ATTR_NAME {
    return t_attr_name(c, s)
  } else if st == STATE_AFTER_NAME {
    return t_after_name(c, s)
  } else if st == STATE_BEFORE_VALUE {
    return t_before_value(c, s)
  } else if st == STATE_HTML_CMT {
    return t_html_cmt(c, s)
  } else if st == STATE_RCDATA {
    return t_special_tag_end(c, s)
  } else if st == STATE_ATTR {
    return (c, s.len())
  } else if st == STATE_URL {
    return t_url(c, s)
  } else if st == STATE_META_CONTENT {
    return t_meta_content(c, s)
  } else if st == STATE_META_CONTENT_URL {
    return t_meta_content_url(c, s)
  } else if st == STATE_SRCSET {
    return t_url(c, s)
  } else if st == STATE_JS {
    return t_js(c, s)
  } else if st == STATE_JS_DQ_STR {
    return t_js_delimited(c, s)
  } else if st == STATE_JS_SQ_STR {
    return t_js_delimited(c, s)
  } else if st == STATE_JS_REGEXP {
    return t_js_delimited(c, s)
  } else if st == STATE_JS_TMPL_LIT {
    return t_js_tmpl(c, s)
  } else if st == STATE_JS_BLOCK_CMT {
    return t_block_cmt(c, s)
  } else if st == STATE_JS_LINE_CMT {
    return t_line_cmt(c, s)
  } else if st == STATE_JS_HTML_OPEN_CMT {
    return t_line_cmt(c, s)
  } else if st == STATE_JS_HTML_CLOSE_CMT {
    return t_line_cmt(c, s)
  } else if st == STATE_CSS {
    return t_css(c, s)
  } else if st == STATE_CSS_DQ_STR {
    return t_css_str(c, s)
  } else if st == STATE_CSS_SQ_STR {
    return t_css_str(c, s)
  } else if st == STATE_CSS_DQ_URL {
    return t_css_str(c, s)
  } else if st == STATE_CSS_SQ_URL {
    return t_css_str(c, s)
  } else if st == STATE_CSS_URL {
    return t_css_str(c, s)
  } else if st == STATE_CSS_BLOCK_CMT {
    return t_block_cmt(c, s)
  } else if st == STATE_CSS_LINE_CMT {
    return t_line_cmt(c, s)
  }
  (c, s.len())
}

const COMMENT_START: Bytes = b"<!--"
const COMMENT_END: Bytes = b"-->"

fn t_text(c: Context, s: Bytes) -> (Context, Int) {
  var k = 0
  while true {
    var i = match s[k..].find(b"<") {
      Some(x) => k + x
      None => return (c, s.len())
    }
    if i + 1 == s.len() {
      return (c, s.len())
    }
    if has_prefix_at(s, i, COMMENT_START) {
      return (Context{state: STATE_HTML_CMT}, i + 4)
    }
    i += 1
    var end = false
    if s[i] == 47 {
      if i + 1 == s.len() {
        return (c, s.len())
      }
      end = true
      i += 1
    }
    let (j, e0) = eat_tag_name(s, i)
    if j != i {
      let e = if end { ELEMENT_NONE } else { e0 }
      return (Context{state: STATE_TAG, element: e}, j)
    }
    k = j
  }
  (c, s.len())
}

const ELEMENT_CONTENT_TYPE: List[Int] = [STATE_TEXT, STATE_JS, STATE_CSS, STATE_RCDATA, STATE_RCDATA, STATE_TEXT]

fn t_tag(c: Context, s: Bytes) -> (Context, Int) {
  let i = eat_white_space(s, 0)
  if i == s.len() {
    return (c, s.len())
  }
  if s[i] == 62 {
    if c.element == ELEMENT_META {
      return (Context{state: STATE_TEXT, element: ELEMENT_NONE}, i + 1)
    }
    return (Context{state: ELEMENT_CONTENT_TYPE[c.element], element: c.element}, i + 1)
  }
  let (j, err) = eat_attr_name(s, i)
  match err {
    Some(e) => return (Context{state: STATE_ERROR, err: Some(e)}, s.len())
    None => {}
  }
  if i == j {
    return (esc_err(ERR_BAD_HTML, "expected space, attr name, or end of tag, but got ${go_quote_bytes(s[i..])}"), s.len())
  }
  let attr_name = (s[i..j].to_str() ?? "").to_lower()
  var attr = ATTR_NONE
  if c.element == ELEMENT_SCRIPT && attr_name == "type" {
    attr = ATTR_SCRIPT_TYPE
  } else if c.element == ELEMENT_META && attr_name == "content" {
    attr = ATTR_META_CONTENT
  } else {
    let at = attr_type(attr_name)
    if at == CONTENT_TYPE_URL {
      attr = ATTR_URL
    } else if at == CONTENT_TYPE_CSS {
      attr = ATTR_STYLE
    } else if at == CONTENT_TYPE_JS {
      attr = ATTR_SCRIPT
    } else if at == CONTENT_TYPE_SRCSET {
      attr = ATTR_SRCSET
    }
  }
  let state = if j == s.len() { STATE_ATTR_NAME } else { STATE_AFTER_NAME }
  (Context{state: state, element: c.element, attr: attr}, j)
}

fn t_attr_name(c: Context, s: Bytes) -> (Context, Int) {
  let (i, err) = eat_attr_name(s, 0)
  match err {
    Some(e) => return (Context{state: STATE_ERROR, err: Some(e)}, s.len())
    None => {}
  }
  if i != s.len() {
    return (c with {state: STATE_AFTER_NAME}, i)
  }
  (c, i)
}

fn t_after_name(c: Context, s: Bytes) -> (Context, Int) {
  let i = eat_white_space(s, 0)
  if i == s.len() {
    return (c, s.len())
  }
  if s[i] != 61 {
    return (c with {state: STATE_TAG}, i)
  }
  (c with {state: STATE_BEFORE_VALUE}, i + 1)
}

const ATTR_START_STATES: List[Int] = [STATE_ATTR, STATE_JS, STATE_ATTR, STATE_CSS, STATE_URL, STATE_SRCSET, STATE_META_CONTENT]

fn t_before_value(c: Context, s: Bytes) -> (Context, Int) {
  var i = eat_white_space(s, 0)
  if i == s.len() {
    return (c, s.len())
  }
  var delim = DELIM_SPACE_OR_TAG_END
  if s[i] == 39 {
    delim = DELIM_SINGLE_QUOTE
    i += 1
  } else if s[i] == 34 {
    delim = DELIM_DOUBLE_QUOTE
    i += 1
  }
  (c with {state: ATTR_START_STATES[c.attr], delim: delim}, i)
}

fn t_html_cmt(c: Context, s: Bytes) -> (Context, Int) {
  match s.find(COMMENT_END) {
    Some(i) => (Context{}, i + 3)
    None => (c, s.len())
  }
}

const SPECIAL_TAG_END_MARKERS: List[Bytes] = [b"", b"script", b"style", b"textarea", b"title", b""]
const SPECIAL_TAG_END_PREFIX: Bytes = b"</"
const TAG_END_SEPARATORS: Str = "> \t\n\u{0C}/"

fn t_special_tag_end(c: Context, s: Bytes) -> (Context, Int) {
  if c.element != ELEMENT_NONE {
    if c.element == ELEMENT_SCRIPT && (is_in_script_literal(c.state) || is_comment(c.state)) {
      return (c, s.len())
    }
    match index_tag_end(s, SPECIAL_TAG_END_MARKERS[c.element]) {
      Some(i) => return (Context{}, i)
      None => {}
    }
  }
  (c, s.len())
}

/// indexTagEnd: where `</tag` followed by a separator starts, case
/// insensitively.
fn index_tag_end(s0: Bytes, tag: Bytes) -> Int? {
  var s = s0
  var res = 0
  let plen = SPECIAL_TAG_END_PREFIX.len()
  while s.len() > 0 {
    let i = match s.find(SPECIAL_TAG_END_PREFIX) {
      Some(x) => x
      None => return None
    }
    s = s[i + plen..]
    if tag.len() <= s.len() && tag.equal_fold(s[0..tag.len()]) {
      s = s[tag.len()..]
      if s.len() > 0 && TAG_END_SEPARATORS.bytes().contains(s[0..1]) {
        return Some(res + i)
      }
      res += tag.len()
    }
    res += i + plen
  }
  None
}

fn t_url(c: Context, s: Bytes) -> (Context, Int) {
  if s.contains_any("#?") {
    return (c with {url_part: URL_PART_QUERY_OR_FRAG}, s.len())
  }
  if s.len() != eat_white_space(s, 0) && c.url_part == URL_PART_NONE {
    return (c with {url_part: URL_PART_PRE_QUERY}, s.len())
  }
  (c, s.len())
}

fn t_js(c0: Context, s: Bytes) -> (Context, Int) {
  var c = c0
  var i = match s.find_any("\"`'/{}<-#") {
    Some(x) => x
    None => return (c with {js_ctx: next_js_ctx(s, c.js_ctx)}, s.len())
  }
  c.js_ctx = next_js_ctx(s[0..i], c.js_ctx)
  match s[i] {
    34 => {
      c.state = STATE_JS_DQ_STR
      c.js_ctx = JS_CTX_REGEXP
    }
    39 => {
      c.state = STATE_JS_SQ_STR
      c.js_ctx = JS_CTX_REGEXP
    }
    96 => {
      c.state = STATE_JS_TMPL_LIT
      c.js_ctx = JS_CTX_REGEXP
    }
    47 => {
      if i + 1 < s.len() && s[i + 1] == 47 {
        c.state = STATE_JS_LINE_CMT
        i += 1
      } else if i + 1 < s.len() && s[i + 1] == 42 {
        c.state = STATE_JS_BLOCK_CMT
        i += 1
      } else if c.js_ctx == JS_CTX_REGEXP {
        c.state = STATE_JS_REGEXP
      } else if c.js_ctx == JS_CTX_DIV_OP {
        c.js_ctx = JS_CTX_REGEXP
      } else {
        return (esc_err(ERR_SLASH_AMBIG, "'/' could start a division or regexp: ${go_quote_prefix(s[i..], 32)}"), s.len())
      }
    }
    60 => {
      if has_prefix_at(s, i, COMMENT_START) {
        c.state = STATE_JS_HTML_OPEN_CMT
        i += 3
      }
    }
    45 => {
      if i + 2 < s.len() && s[i..i + 3] == COMMENT_END {
        c.state = STATE_JS_HTML_CLOSE_CMT
        i += 2
      }
    }
    35 => {
      if i + 1 < s.len() && s[i + 1] == 33 {
        c.state = STATE_JS_LINE_CMT
        i += 1
      }
    }
    123 => {
      if c.js_brace_depth.is_empty() {
        return (c, i + 1)
      }
      let last = c.js_brace_depth.len() - 1
      c.js_brace_depth[last] = c.js_brace_depth[last] + 1
    }
    125 => {
      if c.js_brace_depth.is_empty() {
        return (c, i + 1)
      }
      let last = c.js_brace_depth.len() - 1
      c.js_brace_depth[last] = c.js_brace_depth[last] - 1
      if c.js_brace_depth[last] >= 0 {
        return (c, i + 1)
      }
      c.js_brace_depth = c.js_brace_depth[0..last]
      c.state = STATE_JS_TMPL_LIT
    }
    _ => {}
  }
  (c, i + 1)
}

/// Go's %.32q: the quoted text cut to n runes.
fn go_quote_prefix(s: Bytes, n: Int) -> Str {
  let t = s.to_str() ?? ""
  if t.rune_count() <= n {
    return t.debug()
  }
  var out = BytesBuilder.new()
  var k = 0
  for r in t.runes() {
    if k == n {
      break
    }
    out.write_rune(r)
    k += 1
  }
  (out.freeze().to_str() ?? "").debug()
}

fn t_js_tmpl(c0: Context, s: Bytes) -> (Context, Int) {
  var c = c0
  var k = 0
  while true {
    var i = match s[k..].find_any("`\\$") {
      Some(x) => k + x
      None => break
    }
    match s[i] {
      92 => {
        i += 1
        if i == s.len() {
          return (esc_err(ERR_PARTIAL_ESCAPE, "unfinished escape sequence in JS string: ${go_quote_bytes(s)}"), s.len())
        }
      }
      36 => {
        if s.len() >= i + 2 && s[i + 1] == 123 {
          c.js_brace_depth.push(0)
          c.state = STATE_JS
          return (c, i + 2)
        }
      }
      _ => {
        c.state = STATE_JS
        return (c, i + 1)
      }
    }
    k = i + 1
  }
  (c, s.len())
}

fn t_js_delimited(c0: Context, s: Bytes) -> (Context, Int) {
  var c = c0
  var specials = "\\\""
  if c.state == STATE_JS_SQ_STR {
    specials = "\\'"
  } else if c.state == STATE_JS_REGEXP {
    specials = "\\/[]"
  }
  var k = 0
  var in_charset = false
  while true {
    var i = match s[k..].find_any(specials) {
      Some(x) => k + x
      None => break
    }
    match s[i] {
      92 => {
        i += 1
        if i == s.len() {
          return (esc_err(ERR_PARTIAL_ESCAPE, "unfinished escape sequence in JS string: ${go_quote_bytes(s)}"), s.len())
        }
      }
      91 => in_charset = true
      93 => in_charset = false
      47 => {
        if i > 0 && i + 7 <= s.len() && s[i - 1..i + 7].to_lower() == b"</script" {
          i += 1
        } else if !in_charset {
          c.state = STATE_JS
          c.js_ctx = JS_CTX_DIV_OP
          return (c, i + 1)
        }
      }
      _ => {
        if !in_charset {
          c.state = STATE_JS
          c.js_ctx = JS_CTX_DIV_OP
          return (c, i + 1)
        }
      }
    }
    k = i + 1
  }
  if in_charset {
    return (esc_err(ERR_PARTIAL_CHARSET, "unfinished JS regexp charset: ${go_quote_bytes(s)}"), s.len())
  }
  (c, s.len())
}

fn t_block_cmt(c: Context, s: Bytes) -> (Context, Int) {
  let i = match s.find(b"*/") {
    Some(x) => x
    None => return (c, s.len())
  }
  let st = if c.state == STATE_JS_BLOCK_CMT { STATE_JS } else { STATE_CSS }
  (c with {state: st}, i + 2)
}

fn t_line_cmt(c: Context, s: Bytes) -> (Context, Int) {
  let (terminators, end_state) = if c.state == STATE_CSS_LINE_CMT {
    ("\n\u{0C}\r", STATE_CSS)
  } else {
    ("\n\r\u{2028}\u{2029}", STATE_JS)
  }
  match s.find_any(terminators) {
    Some(i) => (c with {state: end_state}, i)
    None => (c, s.len())
  }
}


const CSS_SPACE: Str = "\t\n\u{0C}\r "

fn t_css(c0: Context, s: Bytes) -> (Context, Int) {
  var c = c0
  var k = 0
  while true {
    let i = match s[k..].find_any("(\"'/") {
      Some(x) => k + x
      None => return (c, s.len())
    }
    match s[i] {
      40 => {
        let p = trim_right_bytes(s[0..i], CSS_SPACE)
        if ends_with_css_keyword(p, "url") {
          var j = s.len() - trim_left_bytes(s[i + 1..], CSS_SPACE).len()
          if j != s.len() && s[j] == 34 {
            c.state = STATE_CSS_DQ_URL
            j += 1
          } else if j != s.len() && s[j] == 39 {
            c.state = STATE_CSS_SQ_URL
            j += 1
          } else {
            c.state = STATE_CSS_URL
          }
          return (c, j)
        }
      }
      47 => {
        if i + 1 < s.len() {
          if s[i + 1] == 47 {
            c.state = STATE_CSS_LINE_CMT
            return (c, i + 2)
          } else if s[i + 1] == 42 {
            c.state = STATE_CSS_BLOCK_CMT
            return (c, i + 2)
          }
        }
      }
      34 => {
        c.state = STATE_CSS_DQ_STR
        return (c, i + 1)
      }
      39 => {
        c.state = STATE_CSS_SQ_STR
        return (c, i + 1)
      }
      _ => {}
    }
    k = i + 1
  }
  (c, s.len())
}

fn t_css_str(c0: Context, s: Bytes) -> (Context, Int) {
  var c = c0
  let end_and_esc = if c.state == STATE_CSS_DQ_STR || c.state == STATE_CSS_DQ_URL {
    "\\\""
  } else if c.state == STATE_CSS_SQ_STR || c.state == STATE_CSS_SQ_URL {
    "\\'"
  } else {
    "\\\t\n\u{0C}\r )"
  }
  var k = 0
  while true {
    var i = match s[k..].find_any(end_and_esc) {
      Some(x) => k + x
      None => {
        let (c2, nread) = t_url(c, decode_css(s[k..]))
        return (c2, k + nread)
      }
    }
    if s[i] == 92 {
      i += 1
      if i == s.len() {
        return (esc_err(ERR_PARTIAL_ESCAPE, "unfinished escape sequence in CSS string: ${go_quote_bytes(s)}"), s.len())
      }
    } else {
      c.state = STATE_CSS
      return (c, i + 1)
    }
    let (c3, _) = t_url(c, decode_css(s[0..i + 1]))
    c = c3
    k = i + 1
  }
  (c, s.len())
}

fn t_meta_content(c: Context, s: Bytes) -> (Context, Int) {
  var i = 0
  while i < s.len() {
    if i + 3 <= s.len() - 1 && s[i..i + 4].to_lower() == b"url=" {
      return (c with {state: STATE_META_CONTENT_URL}, i + 4)
    }
    i += 1
  }
  (c, s.len())
}

fn t_meta_content_url(c: Context, s: Bytes) -> (Context, Int) {
  var i = 0
  while i < s.len() {
    if s[i] == 59 {
      return (c with {state: STATE_META_CONTENT}, i + 1)
    }
    i += 1
  }
  (c, s.len())
}

/// eatAttrName: the end of the attribute name at i, or the error for a
/// quote or `<` inside it.
fn eat_attr_name(s: Bytes, i: Int) -> (Int, EscErr?) {
  var j = i
  while j < s.len() {
    let x = s[j]
    if x == 32 || x == 9 || x == 10 || x == 12 || x == 13 || x == 61 || x == 62 {
      return (j, None)
    }
    if x == 39 || x == 34 || x == 60 {
      return (-1, Some(EscErr{code: ERR_BAD_HTML, name: "", line: 0, desc: "${go_quote_bytes(s[j..j + 1])} in attribute name: ${go_quote_prefix(s, 32)}"}))
    }
    j += 1
  }
  (s.len(), None)
}

fn ascii_alpha(c: UInt8) -> Bool { (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn ascii_alpha_num(c: UInt8) -> Bool { ascii_alpha(c) || (c >= 48 && c <= 57) }

fn element_of(name: Str) -> Int {
  match name {
    "script" => ELEMENT_SCRIPT
    "style" => ELEMENT_STYLE
    "textarea" => ELEMENT_TEXTAREA
    "title" => ELEMENT_TITLE
    "meta" => ELEMENT_META
    _ => ELEMENT_NONE
  }
}

fn eat_tag_name(s: Bytes, i: Int) -> (Int, Int) {
  if i == s.len() || !ascii_alpha(s[i]) {
    return (i, ELEMENT_NONE)
  }
  var j = i + 1
  while j < s.len() {
    let x = s[j]
    if ascii_alpha_num(x) {
      j += 1
      continue
    }
    if (x == 58 || x == 45) && j + 1 < s.len() && ascii_alpha_num(s[j + 1]) {
      j += 2
      continue
    }
    break
  }
  (j, element_of((s[i..j].to_str() ?? "").to_lower()))
}

fn eat_white_space(s: Bytes, i: Int) -> Int {
  var j = i
  while j < s.len() {
    let x = s[j]
    if x == 32 || x == 9 || x == 10 || x == 12 || x == 13 {
      j += 1
      continue
    }
    return j
  }
  s.len()
}

fn trim_right_bytes(s: Bytes, chars: Str) -> Bytes {
  var n = s.len()
  while n > 0 && chars.bytes().contains(s[n - 1..n]) {
    n -= 1
  }
  s[0..n]
}

fn trim_left_bytes(s: Bytes, chars: Str) -> Bytes {
  var i = 0
  while i < s.len() && chars.bytes().contains(s[i..i + 1]) {
    i += 1
  }
  s[i..]
}

/// nudge: a context between attributes moved to where an action's
/// output would land (escape.go).
fn nudge(c: Context) -> Context {
  if c.state == STATE_TAG {
    return c with {state: STATE_ATTR_NAME}
  }
  if c.state == STATE_BEFORE_VALUE {
    return c with {state: ATTR_START_STATES[c.attr], delim: DELIM_SPACE_OR_TAG_END, attr: ATTR_NONE}
  }
  if c.state == STATE_AFTER_NAME {
    return c with {state: STATE_ATTR_NAME, attr: ATTR_NONE}
  }
  c
}

/// specialScriptTagRE: `<script`, `</script` or `<!--`, case
/// insensitively, at or after i.
fn find_special_script_tag(s: Bytes, from: Int) -> (Int, Int)? {
  var i = from
  while i < s.len() {
    let j = match s[i..].find(b"<") {
      Some(x) => i + x
      None => return None
    }
    let rest = s[j + 1..]
    if rest.len() >= 6 && rest[0..6].to_lower() == b"script" {
      return Some((j, 7))
    }
    if rest.len() >= 7 && rest[0..7].to_lower() == b"/script" {
      return Some((j, 8))
    }
    if rest.starts_with(b"!--") {
      return Some((j, 4))
    }
    i = j + 1
  }
  None
}

fn contains_special_script_tag(s: Bytes) -> Bool {
  match find_special_script_tag(s, 0) {
    Some(_) => true
    None => false
  }
}

/// escapeSpecialScriptTags: each match's `<` as `\x3C`.
fn escape_special_script_tags(s: Bytes) -> Bytes {
  var b = BytesBuilder.new()
  var written = 0
  var i = 0
  while true {
    match find_special_script_tag(s, i) {
      Some((j, n)) => {
        b.write(s[written..j])
        b.write_str("\\x3C")
        b.write(s[j + 1..j + n])
        written = j + n
        i = j + n
      }
      None => break
    }
  }
  b.write(s[written..])
  b.freeze()
}

/// contextAfterText: the context after a text run and how much of it
/// the transition read (an attribute value's end is its delimiter).
fn context_after_text(c: Context, s: Bytes) -> (Context, Int) {
  if c.delim == DELIM_NONE {
    let (c1, i) = t_special_tag_end(c, s)
    if i == 0 {
      return (c1, 0)
    }
    return transition(c, s[0..i])
  }
  var i = s.find_any(DELIM_ENDS[c.delim]) ?? s.len()
  if c.delim == DELIM_SPACE_OR_TAG_END {
    match s[0..i].find_any("\"'<=`") {
      Some(j) => return (esc_err(ERR_BAD_HTML, "${go_quote_bytes(s[j..j + 1])} in unquoted attr: ${go_quote_bytes(s[0..i])}"), s.len())
      None => {}
    }
  }
  if i == s.len() {
    // the value continues past this text: its entities decoded, run
    // through the state's transitions
    var c2 = c
    var u = html.unescape_string(s.to_str() ?? "").bytes()
    while !u.is_empty() {
      let (c3, i1) = transition(c2, u)
      c2 = c3
      u = u[i1..]
    }
    return (c2, s.len())
  }
  var element = c.element
  if c.state == STATE_ATTR && c.element == ELEMENT_SCRIPT && c.attr == ATTR_SCRIPT_TYPE && !is_js_type(s[0..i].to_str() ?? "") {
    element = ELEMENT_NONE
  }
  if c.delim != DELIM_SPACE_OR_TAG_END {
    i += 1
  }
  (Context{state: STATE_TAG, element: element}, i)
}

/// escapeText: the context after a text node, and the text with `<`
/// in text escaped where a tag could start, comments dropped, and
/// `<script` inside script literals escaped.
fn escape_text(c0: Context, text: Str) -> (Context, Str) {
  let s = text.bytes()
  var c = c0
  var written = 0
  var i = 0
  var b = BytesBuilder.new()
  while i != s.len() {
    let (c1, nread) = context_after_text(c, s[i..])
    let i1 = i + nread
    if c.state == STATE_TEXT || c.state == STATE_RCDATA {
      var end = i1
      if c1.state != c.state {
        var j = end - 1
        while j >= i {
          if s[j] == 60 {
            end = j
            break
          }
          j -= 1
        }
      }
      var j = i
      while j < end {
        if s[j] == 60 && !(s.len() - j >= 9 && s[j..j + 9].to_upper() == b"<!DOCTYPE") {
          b.write(s[written..j])
          b.write_str("&lt;")
          written = j + 1
        }
        j += 1
      }
    } else if is_comment(c.state) && c.delim == DELIM_NONE {
      if c.state == STATE_JS_BLOCK_CMT {
        if s[written..i1].contains_any("\n\r\u{2028}\u{2029}") {
          b.write_byte(10)
        } else {
          b.write_byte(32)
        }
      } else if c.state == STATE_CSS_BLOCK_CMT {
        b.write_byte(32)
      }
      written = i1
    }
    if c.state != c1.state && is_comment(c1.state) && c1.delim == DELIM_NONE {
      var cs = i1 - 2
      if c1.state == STATE_HTML_CMT || c1.state == STATE_JS_HTML_OPEN_CMT {
        cs -= 2
      } else if c1.state == STATE_JS_HTML_CLOSE_CMT {
        cs -= 1
      }
      b.write(s[written..cs])
      written = i1
    }
    if is_in_script_literal(c.state) && contains_special_script_tag(s[i..i1]) {
      b.write(s[written..i])
      b.write(escape_special_script_tags(s[i..i1]))
      written = i1
    }
    if i == i1 && c.state == c1.state {
      // Go panics ("infinite loop"); the port stops the text here
      return (esc_err(ERR_BAD_HTML, "infinite loop from ${c.text()} to ${c1.text()} on ${go_quote_bytes(s[0..i])}..${go_quote_bytes(s[i..])}"), text)
    }
    c = c1
    i = i1
  }
  if written != 0 && c.state != STATE_ERROR {
    if !is_comment(c.state) || c.delim != DELIM_NONE {
      b.write(s[written..])
    }
    return (c, b.freeze().to_str() ?? text)
  }
  (c, text)
}


// ---------------------------------------------------------------------------
// content.go and attr.go

const CONTENT_TYPE_PLAIN = 0
const CONTENT_TYPE_CSS = 1
const CONTENT_TYPE_HTML = 2
const CONTENT_TYPE_HTML_ATTR = 3
const CONTENT_TYPE_JS = 4
const CONTENT_TYPE_JS_STR = 5
const CONTENT_TYPE_URL = 6
const CONTENT_TYPE_SRCSET = 7
const CONTENT_TYPE_UNSAFE = 8

/// The content type of a Trusted value's kind (std/template's constructors).
fn content_type_of_kind(kind: Str) -> Int {
  match kind {
    "html" => CONTENT_TYPE_HTML
    "css" => CONTENT_TYPE_CSS
    "js" => CONTENT_TYPE_JS
    "jsstr" => CONTENT_TYPE_JS_STR
    "url" => CONTENT_TYPE_URL
    "attr" => CONTENT_TYPE_HTML_ATTR
    "srcset" => CONTENT_TYPE_SRCSET
    _ => CONTENT_TYPE_PLAIN
  }
}

/// attrTypeMap: the attribute names whose content type is not told by
/// the name (sorted by name for a binary search).
const ATTR_TYPES: List[(Str, Int)] = [
  ("accept", CONTENT_TYPE_PLAIN),
  ("accept-charset", CONTENT_TYPE_UNSAFE),
  ("action", CONTENT_TYPE_URL),
  ("alt", CONTENT_TYPE_PLAIN),
  ("archive", CONTENT_TYPE_URL),
  ("async", CONTENT_TYPE_UNSAFE),
  ("autocomplete", CONTENT_TYPE_PLAIN),
  ("autofocus", CONTENT_TYPE_PLAIN),
  ("autoplay", CONTENT_TYPE_PLAIN),
  ("background", CONTENT_TYPE_URL),
  ("border", CONTENT_TYPE_PLAIN),
  ("challenge", CONTENT_TYPE_UNSAFE),
  ("charset", CONTENT_TYPE_UNSAFE),
  ("checked", CONTENT_TYPE_PLAIN),
  ("cite", CONTENT_TYPE_URL),
  ("class", CONTENT_TYPE_PLAIN),
  ("classid", CONTENT_TYPE_URL),
  ("codebase", CONTENT_TYPE_URL),
  ("cols", CONTENT_TYPE_PLAIN),
  ("colspan", CONTENT_TYPE_PLAIN),
  ("content", CONTENT_TYPE_UNSAFE),
  ("contenteditable", CONTENT_TYPE_PLAIN),
  ("contextmenu", CONTENT_TYPE_PLAIN),
  ("controls", CONTENT_TYPE_PLAIN),
  ("coords", CONTENT_TYPE_PLAIN),
  ("crossorigin", CONTENT_TYPE_UNSAFE),
  ("data", CONTENT_TYPE_URL),
  ("datetime", CONTENT_TYPE_PLAIN),
  ("default", CONTENT_TYPE_PLAIN),
  ("defer", CONTENT_TYPE_UNSAFE),
  ("dir", CONTENT_TYPE_PLAIN),
  ("dirname", CONTENT_TYPE_PLAIN),
  ("disabled", CONTENT_TYPE_PLAIN),
  ("draggable", CONTENT_TYPE_PLAIN),
  ("dropzone", CONTENT_TYPE_PLAIN),
  ("enctype", CONTENT_TYPE_UNSAFE),
  ("for", CONTENT_TYPE_PLAIN),
  ("form", CONTENT_TYPE_UNSAFE),
  ("formaction", CONTENT_TYPE_URL),
  ("formenctype", CONTENT_TYPE_UNSAFE),
  ("formmethod", CONTENT_TYPE_UNSAFE),
  ("formnovalidate", CONTENT_TYPE_UNSAFE),
  ("formtarget", CONTENT_TYPE_PLAIN),
  ("headers", CONTENT_TYPE_PLAIN),
  ("height", CONTENT_TYPE_PLAIN),
  ("hidden", CONTENT_TYPE_PLAIN),
  ("high", CONTENT_TYPE_PLAIN),
  ("href", CONTENT_TYPE_URL),
  ("hreflang", CONTENT_TYPE_PLAIN),
  ("http-equiv", CONTENT_TYPE_UNSAFE),
  ("icon", CONTENT_TYPE_URL),
  ("id", CONTENT_TYPE_PLAIN),
  ("ismap", CONTENT_TYPE_PLAIN),
  ("keytype", CONTENT_TYPE_UNSAFE),
  ("kind", CONTENT_TYPE_PLAIN),
  ("label", CONTENT_TYPE_PLAIN),
  ("lang", CONTENT_TYPE_PLAIN),
  ("language", CONTENT_TYPE_UNSAFE),
  ("list", CONTENT_TYPE_PLAIN),
  ("longdesc", CONTENT_TYPE_URL),
  ("loop", CONTENT_TYPE_PLAIN),
  ("low", CONTENT_TYPE_PLAIN),
  ("manifest", CONTENT_TYPE_URL),
  ("max", CONTENT_TYPE_PLAIN),
  ("maxlength", CONTENT_TYPE_PLAIN),
  ("media", CONTENT_TYPE_PLAIN),
  ("mediagroup", CONTENT_TYPE_PLAIN),
  ("method", CONTENT_TYPE_UNSAFE),
  ("min", CONTENT_TYPE_PLAIN),
  ("multiple", CONTENT_TYPE_PLAIN),
  ("name", CONTENT_TYPE_PLAIN),
  ("novalidate", CONTENT_TYPE_UNSAFE),
  ("open", CONTENT_TYPE_PLAIN),
  ("optimum", CONTENT_TYPE_PLAIN),
  ("pattern", CONTENT_TYPE_UNSAFE),
  ("placeholder", CONTENT_TYPE_PLAIN),
  ("poster", CONTENT_TYPE_URL),
  ("preload", CONTENT_TYPE_PLAIN),
  ("profile", CONTENT_TYPE_URL),
  ("pubdate", CONTENT_TYPE_PLAIN),
  ("radiogroup", CONTENT_TYPE_PLAIN),
  ("readonly", CONTENT_TYPE_PLAIN),
  ("rel", CONTENT_TYPE_UNSAFE),
  ("required", CONTENT_TYPE_PLAIN),
  ("reversed", CONTENT_TYPE_PLAIN),
  ("rows", CONTENT_TYPE_PLAIN),
  ("rowspan", CONTENT_TYPE_PLAIN),
  ("sandbox", CONTENT_TYPE_UNSAFE),
  ("scope", CONTENT_TYPE_PLAIN),
  ("scoped", CONTENT_TYPE_PLAIN),
  ("seamless", CONTENT_TYPE_PLAIN),
  ("selected", CONTENT_TYPE_PLAIN),
  ("shape", CONTENT_TYPE_PLAIN),
  ("size", CONTENT_TYPE_PLAIN),
  ("sizes", CONTENT_TYPE_PLAIN),
  ("span", CONTENT_TYPE_PLAIN),
  ("spellcheck", CONTENT_TYPE_PLAIN),
  ("src", CONTENT_TYPE_URL),
  ("srcdoc", CONTENT_TYPE_HTML),
  ("srclang", CONTENT_TYPE_PLAIN),
  ("srcset", CONTENT_TYPE_SRCSET),
  ("start", CONTENT_TYPE_PLAIN),
  ("step", CONTENT_TYPE_PLAIN),
  ("style", CONTENT_TYPE_CSS),
  ("tabindex", CONTENT_TYPE_PLAIN),
  ("target", CONTENT_TYPE_PLAIN),
  ("title", CONTENT_TYPE_PLAIN),
  ("type", CONTENT_TYPE_UNSAFE),
  ("usemap", CONTENT_TYPE_URL),
  ("value", CONTENT_TYPE_UNSAFE),
  ("width", CONTENT_TYPE_PLAIN),
  ("wrap", CONTENT_TYPE_PLAIN),
  ("xmlns", CONTENT_TYPE_URL),
]

fn attr_type_lookup(name: Str) -> Int? {
  var lo = 0
  var hi = ATTR_TYPES.len()
  while lo < hi {
    let mid = (lo + hi) / 2
    let (n, t) = ATTR_TYPES[mid]
    if n == name {
      return Some(t)
    }
    if n < name {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  None
}

/// attrType: the content type of an attribute's value by its name.
fn attr_type(name0: Str) -> Int {
  var name = name0
  if name.starts_with("data-") {
    name = name[5..]
  } else {
    match name.find(":") {
      Some(i) => {
        if name[0..i] == "xmlns" {
          return CONTENT_TYPE_URL
        }
        name = name[i + 1..]
      }
      None => {}
    }
  }
  match attr_type_lookup(name) {
    Some(t) => return t
    None => {}
  }
  if name.starts_with("on") {
    return CONTENT_TYPE_JS
  }
  if name.contains("src") || name.contains("uri") || name.contains("url") {
    return CONTENT_TYPE_URL
  }
  CONTENT_TYPE_PLAIN
}


// ---------------------------------------------------------------------------
// html.go: the escapers take the command's text and content type (the
// walk in std/native/template.xo does stringify: one Trusted argument
// is (s, its kind's type), anything else the printed text and Plain)

/// filterFailsafe (url.go): what a filter returns for an unsafe value.
const FILTER_FAILSAFE: Str = "ZgotmplZ"

fn html_nospace_escaper(s: Str, t: Int) -> Str {
  if s.is_empty() {
    return FILTER_FAILSAFE
  }
  if t == CONTENT_TYPE_HTML {
    return html_replacer(strip_tags(s), HTML_NOSPACE_NORM, false)
  }
  html_replacer(s, HTML_NOSPACE, false)
}

fn attr_escaper(s: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_HTML {
    return html_replacer(strip_tags(s), HTML_NORM, true)
  }
  html_replacer(s, HTML_TABLE, true)
}

fn rcdata_escaper(s: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_HTML {
    return html_replacer(s, HTML_NORM, true)
  }
  html_replacer(s, HTML_TABLE, true)
}

fn html_escaper(s: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_HTML {
    return s
  }
  html_replacer(s, HTML_TABLE, true)
}

/// A replacement table: (byte, replacement), sorted by byte; the ones
/// of html.go.
const HTML_TABLE: List[(Int, Str)] = [(0, "\u{FFFD}"), (34, "&#34;"), (38, "&amp;"), (39, "&#39;"), (43, "&#43;"), (60, "&lt;"), (62, "&gt;")]
const HTML_NORM: List[(Int, Str)] = [(0, "\u{FFFD}"), (34, "&#34;"), (39, "&#39;"), (43, "&#43;"), (60, "&lt;"), (62, "&gt;")]
const HTML_NOSPACE: List[(Int, Str)] = [(0, "&#xfffd;"), (9, "&#9;"), (10, "&#10;"), (11, "&#11;"), (12, "&#12;"), (13, "&#13;"), (32, "&#32;"), (34, "&#34;"), (38, "&amp;"), (39, "&#39;"), (43, "&#43;"), (60, "&lt;"), (61, "&#61;"), (62, "&gt;"), (96, "&#96;")]
const HTML_NOSPACE_NORM: List[(Int, Str)] = [(0, "&#xfffd;"), (9, "&#9;"), (10, "&#10;"), (11, "&#11;"), (12, "&#12;"), (13, "&#13;"), (32, "&#32;"), (34, "&#34;"), (39, "&#39;"), (43, "&#43;"), (60, "&lt;"), (61, "&#61;"), (62, "&gt;"), (96, "&#96;")]

fn table_get(table: List[(Int, Str)], r: Int) -> Str {
  for (k, rep) in table {
    if k == r {
      return rep
    }
    if k > r {
      break
    }
  }
  ""
}

/// htmlReplacer: each rune in the table replaced; with bad_runes false,
/// the noncharacters U+FDD0 to U+FDEF and U+FFF0 to U+FFFF as numeric
/// references too.
fn html_replacer(s: Str, table: List[(Int, Str)], bad_runes: Bool) -> Str {
  let b = s.bytes()
  var out = BytesBuilder.new()
  var written = 0
  var i = 0
  while i < b.len() {
    let (r0, w) = b.decode_rune(i)
    let r = Int(r0)
    if r < 128 {
      let rep = table_get(table, r)
      if !rep.is_empty() {
        out.write(b[written..i])
        out.write_str(rep)
        written = i + w
      }
    } else if bad_runes {
      // the caller renders them as they are
    } else if (0xFDD0 <= r && r <= 0xFDEF) || (0xFFF0 <= r && r <= 0xFFFF) {
      out.write(b[written..i])
      out.write_str("&#x${hex_lower(r)};")
      written = i + w
    }
    i += w
  }
  if written == 0 {
    return s
  }
  out.write(b[written..])
  out.freeze().to_str() ?? s
}

const DELIM_ENDS: List[Str] = ["", "\"", "'", "\t\n\u{0C}\r >"]

/// stripTags: the text of html with its tags, comments and the content
/// of script and style elements removed.
fn strip_tags(html: Str) -> Str {
  let s = html.bytes()
  var out = BytesBuilder.new()
  var c = Context{}
  var i = 0
  var all_text = true
  while i != s.len() {
    if c.delim == DELIM_NONE {
      var st = c.state
      if c.element != ELEMENT_NONE && !is_in_tag(st) {
        st = STATE_RCDATA
      }
      let (d, nread) = transition_in(st, c, s[i..])
      let i1 = i + nread
      if c.state == STATE_TEXT || c.state == STATE_RCDATA {
        var j = i1
        if d.state != c.state {
          var j1 = j - 1
          while j1 >= i {
            if s[j1] == 60 {
              j = j1
              break
            }
            j1 -= 1
          }
        }
        out.write(s[i..j])
      } else {
        all_text = false
      }
      c = d
      i = i1
      continue
    }
    let i1 = match s[i..].find_any(DELIM_ENDS[c.delim]) {
      Some(x) => i + x
      None => break
    }
    var next = i1
    if c.delim != DELIM_SPACE_OR_TAG_END {
      next += 1
    }
    c = Context{state: STATE_TAG, element: c.element}
    i = next
  }
  if all_text {
    return html
  }
  if c.state == STATE_TEXT || c.state == STATE_RCDATA {
    out.write(s[i..])
  }
  out.freeze().to_str() ?? ""
}

/// htmlNameFilter: an attribute name a template computes, or the failsafe.
fn html_name_filter(s0: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_HTML_ATTR {
    return s0
  }
  if s0.is_empty() {
    return FILTER_FAILSAFE
  }
  let s = s0.to_lower()
  if attr_type(s) != CONTENT_TYPE_PLAIN {
    return FILTER_FAILSAFE
  }
  for c in s.bytes() {
    if (c >= 48 && c <= 57) || (c >= 97 && c <= 122) {
      continue
    }
    return FILTER_FAILSAFE
  }
  s
}

fn comment_escaper(s: Str, t: Int) -> Str { "" }

/// %x of a non negative Int.
fn hex_lower(n0: Int) -> Str {
  if n0 == 0 {
    return "0"
  }
  var n = n0
  var digits: List[Int] = []
  while n > 0 {
    digits.push(n % 16)
    n = n / 16
  }
  var b = BytesBuilder.new()
  for d in digits.reverse() {
    b.write_byte(HEX_DIGITS[d])
  }
  b.freeze().to_str() ?? ""
}


// ---------------------------------------------------------------------------
// url.go

fn url_filter(s: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_URL {
    return s
  }
  if !is_safe_url(s) {
    return "#" + FILTER_FAILSAFE
  }
  s
}

fn is_safe_url(s: Str) -> Bool {
  match s.find(":") {
    Some(i) => {
      let protocol = s[0..i]
      if !protocol.contains("/") {
        let p = protocol.to_lower()
        if p != "http" && p != "https" && p != "mailto" {
          return false
        }
      }
    }
    None => {}
  }
  true
}

fn url_escaper(s: Str, t: Int) -> Str { url_processor(false, s, t) }
fn url_normalizer(s: Str, t: Int) -> Str { url_processor(true, s, t) }

fn url_processor(norm0: Bool, s: Str, t: Int) -> Str {
  let norm = norm0 || t == CONTENT_TYPE_URL
  var b = BytesBuilder.new()
  if process_url_onto(s, norm, b) {
    return b.freeze().to_str() ?? s
  }
  s
}

fn is_hex(c: UInt8) -> Bool { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

const HEX_DIGITS: Bytes = b"0123456789abcdef"

/// processURLOnto: s percent encoded onto b (normalized keeps the
/// reserved characters and valid escapes); true when anything changed.
fn process_url_onto(s: Str, norm: Bool, var b: BytesBuilder) -> Bool {
  let bs = s.bytes()
  var written = 0
  var i = 0
  let n = bs.len()
  while i < n {
    let c = bs[i]
    var keep = false
    if c == 33 || c == 35 || c == 36 || c == 38 || c == 42 || c == 43 || c == 44 || c == 47 || c == 58 || c == 59 || c == 61 || c == 63 || c == 64 || c == 91 || c == 93 {
      keep = norm
    } else if c == 45 || c == 46 || c == 95 || c == 126 {
      keep = true
    } else if c == 37 {
      keep = norm && i + 2 < n && is_hex(bs[i + 1]) && is_hex(bs[i + 2])
    } else if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
      keep = true
    }
    if !keep {
      b.write(bs[written..i])
      b.write_byte(37)
      b.write_byte(HEX_DIGITS[Int(c) / 16])
      b.write_byte(HEX_DIGITS[Int(c) % 16])
      written = i + 1
    }
    i += 1
  }
  b.write(bs[written..])
  written != 0
}

fn srcset_filter_and_escaper(s0: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_SRCSET {
    return s0
  }
  if t == CONTENT_TYPE_URL {
    var b = BytesBuilder.new()
    var s = s0
    if process_url_onto(s0, true, b) {
      s = b.freeze().to_str() ?? s0
    }
    return s.replace(",", "%2c")
  }
  let bs = s0.bytes()
  var b = BytesBuilder.new()
  var written = 0
  var i = 0
  while i < bs.len() {
    if bs[i] == 44 {
      filter_srcset_element(bs, written, i, b)
      b.write_str(",")
      written = i + 1
    }
    i += 1
  }
  filter_srcset_element(bs, written, bs.len(), b)
  b.freeze().to_str() ?? s0
}

/// htmlSpaceAndASCIIAlnumBytes: a bit set over the bytes below 0x80.
const HTML_SPACE_AND_ALNUM: Bytes = b"\x00\x36\x00\x00\x01\x00\xff\x03\xfe\xff\xff\x07\xfe\xff\xff\x07"

fn is_html_space(c: UInt8) -> Bool {
  c <= 0x20 && (Int(HTML_SPACE_AND_ALNUM[Int(c) / 8]) & (1 << (Int(c) % 8))) != 0
}

fn is_html_space_or_ascii_alnum(c: UInt8) -> Bool {
  c < 0x80 && (Int(HTML_SPACE_AND_ALNUM[Int(c) / 8]) & (1 << (Int(c) % 8))) != 0
}

fn filter_srcset_element(s: Bytes, left: Int, right: Int, var b: BytesBuilder) {
  var start = left
  while start < right && is_html_space(s[start]) {
    start += 1
  }
  var end = right
  var i = start
  while i < right {
    if is_html_space(s[i]) {
      end = i
      break
    }
    i += 1
  }
  let url = s[start..end].to_str() ?? ""
  if is_safe_url(url) {
    var metadata_ok = true
    var j = end
    while j < right {
      if !is_html_space_or_ascii_alnum(s[j]) {
        metadata_ok = false
        break
      }
      j += 1
    }
    if metadata_ok {
      b.write(s[left..start])
      let _ = process_url_onto(url, true, b)
      b.write(s[end..right])
      return
    }
  }
  b.write_str("#")
  b.write_str(FILTER_FAILSAFE)
}


// ---------------------------------------------------------------------------
// css.go

/// The start of the last rune of b (a UTF-8 continuation byte scan).
fn last_rune_start(b: Bytes) -> Int {
  var i = b.len() - 1
  while i > 0 && (Int(b[i]) & 0xC0) == 0x80 {
    i -= 1
  }
  i
}

fn ends_with_css_keyword(b: Bytes, kw: Str) -> Bool {
  let i = b.len() - kw.len()
  if i < 0 {
    return false
  }
  if i != 0 {
    let head = b[0..i]
    let (r, _) = head.decode_rune(last_rune_start(head))
    if is_css_nmchar(Int(r)) {
      return false
    }
  }
  (b[i..].to_lower().to_str() ?? "") == kw
}

fn is_css_nmchar(r: Int) -> Bool {
  (r >= 97 && r <= 122) || (r >= 65 && r <= 90) || (r >= 48 && r <= 57) || r == 45 || r == 95 || (0x80 <= r && r <= 0xD7FF) || (0xE000 <= r && r <= 0xFFFD) || (0x10000 <= r && r <= 0x10FFFF)
}

/// decodeCSS: the CSS escapes of s decoded (`\\41 ` is `A`).
fn decode_css(s0: Bytes) -> Bytes {
  if !s0.contains(b"\\") {
    return s0
  }
  var s = s0
  var b = BytesBuilder.new()
  while s.len() != 0 {
    let i = s.find(b"\\") ?? s.len()
    b.write(s[0..i])
    s = s[i..]
    if s.len() < 2 {
      break
    }
    if is_hex(s[1]) {
      var j = 2
      while j < s.len() && j < 7 && is_hex(s[j]) {
        j += 1
      }
      var r = hex_decode(s[1..j])
      if r > 0x10FFFF {
        r = r / 16
        j -= 1
      }
      b.write_rune(Rune.try(r) ?? Rune.try(0xFFFD).or_fault("rune"))
      s = skip_css_space(s[j..])
    } else {
      let (_, n) = s.decode_rune(1)
      b.write(s[1..1 + n])
      s = s[1 + n..]
    }
  }
  b.freeze()
}

fn hex_decode(s: Bytes) -> Int {
  var n = 0
  for c in s {
    n = n * 16
    if c >= 48 && c <= 57 {
      n = n | (Int(c) - 48)
    } else if c >= 97 && c <= 102 {
      n = n | (Int(c) - 97 + 10)
    } else {
      n = n | (Int(c) - 65 + 10)
    }
  }
  n
}

fn skip_css_space(c: Bytes) -> Bytes {
  if c.is_empty() {
    return c
  }
  let x = c[0]
  if x == 9 || x == 10 || x == 12 || x == 32 {
    return c[1..]
  }
  if x == 13 {
    if c.len() >= 2 && c[1] == 10 {
      return c[2..]
    }
    return c[1..]
  }
  c
}

fn is_css_space(b: UInt8) -> Bool { b == 9 || b == 10 || b == 12 || b == 13 || b == 32 }

const CSS_TABLE: List[(Int, Str)] = [(0, "\\0"), (9, "\\9"), (10, "\\a"), (12, "\\c"), (13, "\\d"), (34, "\\22"), (38, "\\26"), (39, "\\27"), (40, "\\28"), (41, "\\29"), (43, "\\2b"), (47, "\\2f"), (58, "\\3a"), (59, "\\3b"), (60, "\\3c"), (62, "\\3e"), (92, "\\\\"), (123, "\\7b"), (125, "\\7d")]

fn css_escaper(s: Str, t: Int) -> Str {
  let bs = s.bytes()
  var b = BytesBuilder.new()
  var written = 0
  var i = 0
  while i < bs.len() {
    let (r0, w) = bs.decode_rune(i)
    let r = Int(r0)
    let repl = if r < 128 { table_get(CSS_TABLE, r) } else { "" }
    if repl.is_empty() {
      i += w
      continue
    }
    b.write(bs[written..i])
    b.write_str(repl)
    written = i + w
    if repl != "\\\\" && (written == bs.len() || is_hex(bs[written]) || is_css_space(bs[written])) {
      b.write_byte(32)
    }
    i += w
  }
  if written == 0 {
    return s
  }
  b.write(bs[written..])
  b.freeze().to_str() ?? s
}

fn css_value_filter(s: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_CSS {
    return s
  }
  let b = decode_css(s.bytes())
  var id = BytesBuilder.new()
  for (i, c) in b.indexed() {
    if c == 0 || c == 34 || c == 39 || c == 40 || c == 41 || c == 47 || c == 59 || c == 64 || c == 91 || c == 92 || c == 93 || c == 96 || c == 123 || c == 125 || c == 60 || c == 62 {
      return FILTER_FAILSAFE
    }
    if c == 45 {
      if i != 0 && b[i - 1] == 45 {
        return FILTER_FAILSAFE
      }
    } else if c < 0x80 && is_css_nmchar(Int(c)) {
      id.write_byte(c)
    }
  }
  let idl = id.freeze().to_lower()
  if idl.contains(b"expression") || idl.contains(b"mozbinding") {
    return FILTER_FAILSAFE
  }
  b.to_str() ?? s
}


// ---------------------------------------------------------------------------
// js.go

const JS_WHITESPACE: Str = "\u{0C}\n\r\t\u{0B}\u{20}\u{A0}\u{1680}\u{2000}\u{2001}\u{2002}\u{2003}\u{2004}\u{2005}\u{2006}\u{2007}\u{2008}\u{2009}\u{200A}\u{2028}\u{2029}\u{202F}\u{205F}\u{3000}\u{FEFF}"

const REGEXP_PRECEDER_KEYWORDS: List[Str] = ["break", "case", "continue", "delete", "do", "else", "finally", "in", "instanceof", "return", "throw", "try", "typeof", "void"]

/// nextJSCtx: whether a `/` after s starts a regexp or divides.
fn next_js_ctx(s0: Bytes, preceding: Int) -> Int {
  let s = trim_right_runes(s0, JS_WHITESPACE)
  if s.is_empty() {
    return preceding
  }
  let n = s.len()
  let c = s[n - 1]
  if c == 43 || c == 45 {
    var start = n - 1
    while start > 0 && s[start - 1] == c {
      start -= 1
    }
    if ((n - start) & 1) == 1 {
      return JS_CTX_REGEXP
    }
    return JS_CTX_DIV_OP
  }
  if c == 46 {
    if n != 1 && s[n - 2] >= 48 && s[n - 2] <= 57 {
      return JS_CTX_DIV_OP
    }
    return JS_CTX_REGEXP
  }
  if c == 44 || c == 60 || c == 62 || c == 61 || c == 42 || c == 37 || c == 38 || c == 124 || c == 94 || c == 63 || c == 33 || c == 126 || c == 40 || c == 91 || c == 58 || c == 59 || c == 123 || c == 125 {
    return JS_CTX_REGEXP
  }
  var j = n
  while j > 0 && is_js_ident_part(Int(s[j - 1])) {
    j -= 1
  }
  if REGEXP_PRECEDER_KEYWORDS.contains(s[j..].to_str() ?? "") {
    return JS_CTX_REGEXP
  }
  JS_CTX_DIV_OP
}

/// bytes.TrimRight with a rune set.
fn trim_right_runes(s: Bytes, chars: Str) -> Bytes {
  var n = s.len()
  while n > 0 {
    let st = last_rune_start(s[0..n])
    let (r, _) = s.decode_rune(st)
    if !chars.contains_rune(r) {
      break
    }
    n = st
  }
  s[0..n]
}

/// jsValEscaper over the value's JSON text (the walk marshals the
/// value: a Trusted js is its text, a Trusted jsstr is quoted, several
/// arguments their printed text as a JSON string; a value that cannot
/// be marshaled is " /* error */null " as Go writes it).
fn js_val_escaper_json(b0: Str) -> Str {
  let b = b0.bytes()
  if b.is_empty() {
    return " null "
  }
  let (first, _) = b.decode_rune(0)
  let (last, _) = b.decode_rune(last_rune_start(b))
  let pad = is_js_ident_part(Int(first)) || is_js_ident_part(Int(last))
  var buf = BytesBuilder.new()
  if pad {
    buf.write_byte(32)
  }
  var written = 0
  var i = 0
  var any = false
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    let repl = if Int(r) == 0x2028 { "\\u2028" } else if Int(r) == 0x2029 { "\\u2029" } else { "" }
    if !repl.is_empty() {
      buf.write(b[written..i])
      buf.write_str(repl)
      written = i + n
      any = true
    }
    i += n
  }
  if any || pad {
    buf.write(b[written..])
    if pad {
      buf.write_byte(32)
    }
    return buf.freeze().to_str() ?? b0
  }
  b0
}

fn js_str_escaper(s: Str, t: Int) -> Str {
  if t == CONTENT_TYPE_JS_STR {
    return js_replace(s, JS_STR_NORM)
  }
  js_replace(s, JS_STR)
}

fn js_tmpl_lit_escaper(s: Str, t: Int) -> Str { js_replace(s, JS_BQ_STR) }

fn js_regexp_escaper(s0: Str, t: Int) -> Str {
  let s = js_replace(s0, JS_REGEXP)
  if s.is_empty() {
    return "(?:)"
  }
  s
}

const LOW_UNICODE: List[Str] = ["\\u0000", "\\u0001", "\\u0002", "\\u0003", "\\u0004", "\\u0005", "\\u0006", "\\u0007", "\\u0008", "\\t", "\\n", "\\u000b", "\\f", "\\r", "\\u000e", "\\u000f", "\\u0010", "\\u0011", "\\u0012", "\\u0013", "\\u0014", "\\u0015", "\\u0016", "\\u0017", "\\u0018", "\\u0019", "\\u001a", "\\u001b", "\\u001c", "\\u001d", "\\u001e", "\\u001f"]

const JS_STR: List[(Int, Str)] = [(0, "\\u0000"), (9, "\\t"), (10, "\\n"), (11, "\\u000b"), (12, "\\f"), (13, "\\r"), (34, "\\u0022"), (38, "\\u0026"), (39, "\\u0027"), (43, "\\u002b"), (47, "\\/"), (60, "\\u003c"), (62, "\\u003e"), (92, "\\\\"), (96, "\\u0060")]
const JS_BQ_STR: List[(Int, Str)] = [(0, "\\u0000"), (9, "\\t"), (10, "\\n"), (11, "\\u000b"), (12, "\\f"), (13, "\\r"), (34, "\\u0022"), (36, "\\u0024"), (38, "\\u0026"), (39, "\\u0027"), (43, "\\u002b"), (47, "\\/"), (60, "\\u003c"), (62, "\\u003e"), (92, "\\\\"), (96, "\\u0060"), (123, "\\u007b"), (125, "\\u007d")]
const JS_STR_NORM: List[(Int, Str)] = [(0, "\\u0000"), (9, "\\t"), (10, "\\n"), (11, "\\u000b"), (12, "\\f"), (13, "\\r"), (34, "\\u0022"), (38, "\\u0026"), (39, "\\u0027"), (43, "\\u002b"), (47, "\\/"), (60, "\\u003c"), (62, "\\u003e"), (96, "\\u0060")]
const JS_REGEXP: List[(Int, Str)] = [(0, "\\u0000"), (9, "\\t"), (10, "\\n"), (11, "\\u000b"), (12, "\\f"), (13, "\\r"), (34, "\\u0022"), (36, "\\$"), (38, "\\u0026"), (39, "\\u0027"), (40, "\\("), (41, "\\)"), (42, "\\*"), (43, "\\u002b"), (45, "\\-"), (46, "\\."), (47, "\\/"), (60, "\\u003c"), (62, "\\u003e"), (63, "\\?"), (91, "\\["), (92, "\\\\"), (93, "\\]"), (94, "\\^"), (123, "\\{"), (124, "\\|"), (125, "\\}")]

/// replace: the low control characters, the table's runes, and U+2028
/// and U+2029 escaped.
fn js_replace(s: Str, table: List[(Int, Str)]) -> Str {
  let bs = s.bytes()
  var b = BytesBuilder.new()
  var written = 0
  var i = 0
  while i < bs.len() {
    let (r0, w) = bs.decode_rune(i)
    let r = Int(r0)
    var repl = ""
    if r < 32 {
      repl = LOW_UNICODE[r]
    } else if r < 128 {
      repl = table_get(table, r)
    } else if r == 0x2028 {
      repl = "\\u2028"
    } else if r == 0x2029 {
      repl = "\\u2029"
    }
    if repl.is_empty() {
      i += w
      continue
    }
    b.write(bs[written..i])
    b.write_str(repl)
    written = i + w
    i += w
  }
  if written == 0 {
    return s
  }
  b.write(bs[written..])
  b.freeze().to_str() ?? s
}

fn is_js_ident_part(r: Int) -> Bool {
  r == 36 || (r >= 48 && r <= 57) || (r >= 65 && r <= 90) || r == 95 || (r >= 97 && r <= 122)
}

const JS_MIME_TYPES: List[Str] = ["application/ecmascript", "application/javascript", "application/json", "application/ld+json", "application/x-ecmascript", "application/x-javascript", "module", "text/ecmascript", "text/javascript", "text/javascript1.0", "text/javascript1.1", "text/javascript1.2", "text/javascript1.3", "text/javascript1.4", "text/javascript1.5", "text/jscript", "text/livescript", "text/x-ecmascript", "text/x-javascript"]

/// isJSType: whether a script type attribute names JavaScript (or JSON).
fn is_js_type(mime0: Str) -> Bool {
  var mime = mime0
  match mime.find(";") {
    Some(i) => mime = mime[0..i]
    None => {}
  }
  JS_MIME_TYPES.contains(mime.to_lower().trim())
}
