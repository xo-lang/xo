// std/amqp: one pure source for the native backends and, through
// std/go_compiled.txt, the Go backend (decision 0312). Stage 1 of decision
// 0521: the AMQP 1.0 type system and its encoding, a port of
// github.com/Azure/go-amqp v1.7.0's internal/encoding (MIT, Copyright 2017
// Kale Blankenship and Microsoft). The encoder picks go-amqp's constructors
// (smalluint, smallint, str8 and vbin8 by size, always list32 and map32);
// the decoder takes every constructor of the specification.
use std/amqp
use std/task
use std/tls

fn enc_err(msg: Str) -> amqp.AmqpErr { amqp.AmqpErr.Encode(msg: msg) }

fn dec_err(msg: Str) -> amqp.AmqpErr { amqp.AmqpErr.Decode(msg: msg) }

fn be(out: BytesBuilder, v: Int, n: Int) -> BytesBuilder {
  var o = out
  var i = n - 1
  while i >= 0 {
    o.write_byte(UInt8(v.shr_logical(8 * i) & 255))
    i -= 1
  }
  o
}

fn put_code(out: BytesBuilder, c: Int) -> BytesBuilder {
  var o = out
  o.write_byte(UInt8(c))
  o
}

// ---------------------------------------------------------------------------
// Encoding

/// A variable length value (binary, string, symbol): code8 for up to 255
/// bytes, else code32.
fn put_var(out: BytesBuilder, code8: Int, code32: Int, b: Bytes) -> BytesBuilder {
  var o = out
  if b.len() < 256 {
    o = be(put_code(o, code8), b.len(), 1)
  } else {
    o = be(put_code(o, code32), b.len(), 4)
  }
  o.write(b)
  o
}

fn put_value(out: BytesBuilder, v: amqp.Value) -> BytesBuilder ! amqp.AmqpErr {
  var o = out
  match v {
    Null => put_code(o, 0x40)
    Bool(b) => put_code(o, if b { 0x41 } else { 0x42 })
    UByte(x) => be(put_code(o, 0x50), Int(x), 1)
    UShort(x) => be(put_code(o, 0x60), Int(x), 2)
    UInt(x) => {
      let n = Int(x)
      if n == 0 {
        put_code(o, 0x43)
      } else if n < 256 {
        be(put_code(o, 0x52), n, 1)
      } else {
        be(put_code(o, 0x70), n, 4)
      }
    }
    ULong(x) => {
      if x == 0 {
        put_code(o, 0x44)
      } else if x < 256 {
        be(put_code(o, 0x53), Int(x), 1)
      } else {
        be(put_code(o, 0x80), u64_int(x), 8)
      }
    }
    Byte(x) => be(put_code(o, 0x51), Int(x), 1)
    Short(x) => be(put_code(o, 0x61), Int(x), 2)
    Int(x) => {
      let n = Int(x)
      if n < 128 && n >= -128 {
        be(put_code(o, 0x54), n, 1)
      } else {
        be(put_code(o, 0x71), n, 4)
      }
    }
    Long(x) => {
      let n = Int(x)
      if n < 128 && n >= -128 {
        be(put_code(o, 0x55), n, 1)
      } else {
        be(put_code(o, 0x81), n, 8)
      }
    }
    Float(v) => be(put_code(o, 0x72), Int(v.to_bits()), 4)
    Double(x) => be(put_code(o, 0x82), x.to_bits(), 8)
    Decimal32(x) => be(put_code(o, 0x74), Int(x), 4)
    Decimal64(x) => be(put_code(o, 0x84), u64_int(x), 8)
    Decimal128(b) => {
      if b.len() != 16 {
        return Err(enc_err("decimal128 needs 16 bytes"))
      }
      o = put_code(o, 0x94)
      o.write(b)
      o
    }
    Char(r) => be(put_code(o, 0x73), Int(r), 4)
    Timestamp(ms) => be(put_code(o, 0x83), ms, 8)
    Uuid(b) => {
      if b.len() != 16 {
        return Err(enc_err("uuid needs 16 bytes"))
      }
      o = put_code(o, 0x98)
      o.write(b)
      o
    }
    Binary(b) => put_var(o, 0xa0, 0xb0, b)
    Str(s) => put_var(o, 0xa1, 0xb1, s.bytes())
    Symbol(s) => put_var(o, 0xa3, 0xb3, s.bytes())
    List(items) => {
      if items.len() == 0 {
        return Ok(put_code(o, 0x45))
      }
      var body = BytesBuilder.new()
      for it in items {
        body = put_value(body, it)?
      }
      let bb = body.freeze()
      o = be(put_code(o, 0xd0), bb.len() + 4, 4)
      o = be(o, items.len(), 4)
      o.write(bb)
      o
    }
    Map(pairs) => {
      var body = BytesBuilder.new()
      for (k, x) in pairs {
        body = put_value(body, k)?
        body = put_value(body, x)?
      }
      let bb = body.freeze()
      o = be(put_code(o, 0xd1), bb.len() + 4, 4)
      o = be(o, 2 * pairs.len(), 4)
      o.write(bb)
      o
    }
    Array(items) => put_array(o, items)?
    Described(d, x) => {
      o = put_code(o, 0x00)
      o = put_value(o, d)?
      put_value(o, x)?
    }
  }
}

/// u64's bits as an Int (wrapping above 2^63).
fn u64_int(x: UInt64) -> Int { x.to_bits() }

/// The kind of an array element: the constructor family.
fn kind(v: amqp.Value) -> Int {
  match v {
    Null => 0
    Bool(_) => 1
    UByte(_) => 2
    UShort(_) => 3
    UInt(_) => 4
    ULong(_) => 5
    Byte(_) => 6
    Short(_) => 7
    Int(_) => 8
    Long(_) => 9
    Float(_) => 10
    Double(_) => 11
    Decimal32(_) => 12
    Decimal64(_) => 13
    Decimal128(_) => 14
    Char(_) => 15
    Timestamp(_) => 16
    Uuid(_) => 17
    Binary(_) => 18
    Str(_) => 19
    Symbol(_) => 20
    Map(_) => 21
    _ => 99
  }
}

/// The integer of an element, for the width choice.
fn small(v: amqp.Value) -> Bool {
  match v {
    UInt(x) => Int(x) < 256
    ULong(x) => x < 256
    Int(x) => Int(x) < 128 && Int(x) >= -128
    Long(x) => Int(x) < 128 && Int(x) >= -128
    _ => false
  }
}

/// An array (go-amqp's arrayX Marshal): one constructor for all elements,
/// the narrow form when every element fits it.
fn put_array(out: BytesBuilder, items: List[amqp.Value]) -> BytesBuilder ! amqp.AmqpErr {
  var o = out
  if items.len() == 0 {
    return Err(enc_err("an empty array has no element type"))
  }
  let k = kind(items[0])
  if k == 0 || k == 99 {
    return Err(enc_err("unsupported array element type"))
  }
  var all_small = true
  for it in items {
    if kind(it) != k {
      return Err(enc_err("array elements of different types"))
    }
    if !small(it) {
      all_small = false
    }
  }
  var body = BytesBuilder.new()
  var code = 0
  if k == 1 {
    code = 0x56
    for it in items {
      body = put_byte_of(body, it)
    }
  } else if k == 2 || k == 6 {
    code = if k == 2 { 0x50 } else { 0x51 }
    for it in items {
      body = put_int_body(body, it, 1)
    }
  } else if k == 3 || k == 7 {
    code = if k == 3 { 0x60 } else { 0x61 }
    for it in items {
      body = put_int_body(body, it, 2)
    }
  } else if k == 4 {
    code = if all_small { 0x52 } else { 0x70 }
    for it in items {
      body = put_int_body(body, it, if all_small { 1 } else { 4 })
    }
  } else if k == 5 {
    code = if all_small { 0x53 } else { 0x80 }
    for it in items {
      body = put_int_body(body, it, if all_small { 1 } else { 8 })
    }
  } else if k == 8 {
    code = if all_small { 0x54 } else { 0x71 }
    for it in items {
      body = put_int_body(body, it, if all_small { 1 } else { 4 })
    }
  } else if k == 9 {
    code = if all_small { 0x55 } else { 0x81 }
    for it in items {
      body = put_int_body(body, it, if all_small { 1 } else { 8 })
    }
  } else if k == 10 {
    code = 0x72
    for it in items {
      body = put_int_body(body, it, 4)
    }
  } else if k == 11 {
    code = 0x82
    for it in items {
      body = put_int_body(body, it, 8)
    }
  } else if k == 12 {
    code = 0x74
    for it in items {
      body = put_int_body(body, it, 4)
    }
  } else if k == 13 {
    code = 0x84
    for it in items {
      body = put_int_body(body, it, 8)
    }
  } else if k == 14 || k == 17 {
    code = if k == 14 { 0x94 } else { 0x98 }
    for it in items {
      body.write(fixed_bytes(it))
    }
  } else if k == 15 {
    code = 0x73
    for it in items {
      body = put_int_body(body, it, 4)
    }
  } else if k == 16 {
    code = 0x83
    for it in items {
      body = put_int_body(body, it, 8)
    }
  } else if k == 18 || k == 19 || k == 20 {
    // variable width: one length width for all, by the longest
    var wide = false
    for it in items {
      if var_bytes(it).len() > 255 {
        wide = true
      }
    }
    let base = if k == 18 { 0xa0 } else if k == 19 { 0xa1 } else { 0xa3 }
    code = if wide { base + 0x10 } else { base }
    for it in items {
      let b = var_bytes(it)
      body = be(body, b.len(), if wide { 4 } else { 1 })
      body.write(b)
    }
  } else {
    // maps: map32 elements without their constructor
    code = 0xd1
    for it in items {
      let enc = put_value(BytesBuilder.new(), it)?.freeze()
      body.write(enc[1..])
    }
  }
  let bb = body.freeze()
  // the size counts the count and the element constructor
  // go-amqp always writes an array of maps with the wide header
  if bb.len() + 2 <= 255 && k != 21 {
    o = be(put_code(o, 0xe0), bb.len() + 2, 1)
    o = be(o, items.len(), 1)
  } else {
    o = be(put_code(o, 0xf0), bb.len() + 5, 4)
    o = be(o, items.len(), 4)
  }
  o = put_code(o, code)
  o.write(bb)
  o
}

fn put_byte_of(out: BytesBuilder, v: amqp.Value) -> BytesBuilder {
  var o = out
  match v {
    Bool(b) => o.write_byte(if b { 1 } else { 0 })
    _ => {}
  }
  o
}

/// The big endian body (n bytes) of an integer-like element.
fn put_int_body(out: BytesBuilder, v: amqp.Value, n: Int) -> BytesBuilder {
  match v {
    UByte(x) => be(out, Int(x), n)
    UShort(x) => be(out, Int(x), n)
    UInt(x) => be(out, Int(x), n)
    ULong(x) => be(out, u64_int(x), n)
    Byte(x) => be(out, Int(x), n)
    Short(x) => be(out, Int(x), n)
    Int(x) => be(out, Int(x), n)
    Long(x) => be(out, Int(x), n)
    Float(v) => be(out, Int(v.to_bits()), n)
    Double(x) => be(out, x.to_bits(), n)
    Decimal32(x) => be(out, Int(x), n)
    Decimal64(x) => be(out, u64_int(x), n)
    Char(r) => be(out, Int(r), n)
    Timestamp(ms) => be(out, ms, n)
    _ => out
  }
}

fn fixed_bytes(v: amqp.Value) -> Bytes {
  match v {
    Decimal128(b) => b
    Uuid(b) => b
    _ => b""
  }
}

fn var_bytes(v: amqp.Value) -> Bytes {
  match v {
    Binary(b) => b
    Str(s) => s.bytes()
    Symbol(s) => s.bytes()
    _ => b""
  }
}

fn encode(v: amqp.Value) -> Bytes ! amqp.AmqpErr {
  Ok(put_value(BytesBuilder.new(), v)?.freeze())
}

// ---------------------------------------------------------------------------
// Decoding

fn need(b: Bytes, pos: Int, n: Int) -> () ! amqp.AmqpErr {
  if n < 0 || pos + n > b.len() {
    return Err(dec_err("unexpected end of data"))
  }
  Ok(())
}

fn get_be(b: Bytes, pos: Int, n: Int) -> Int {
  var v = 0
  for i in 0..n {
    v = v.wrapping_shl(8) | Int(b[pos + i])
  }
  v
}

/// A signed value of n bytes.
fn get_signed(b: Bytes, pos: Int, n: Int) -> Int {
  let v = get_be(b, pos, n)
  if n == 8 {
    return v
  }
  let bits = 8 * n
  if (v >> (bits - 1)) & 1 == 1 { v - (1 << bits) } else { v }
}

/// The value at pos and the position after it.
fn get_value(b: Bytes, pos: Int, depth: Int) -> (amqp.Value, Int) ! amqp.AmqpErr {
  if depth > 64 {
    return Err(dec_err("values nested too deeply"))
  }
  need(b, pos, 1)?
  let c = Int(b[pos])
  let p = pos + 1
  if c == 0x00 {
    let (d, p1) = get_value(b, p, depth + 1)?
    let (x, p2) = get_value(b, p1, depth + 1)?
    return Ok((amqp.Value.Described(descriptor: d, value: x), p2))
  }
  if c == 0x40 {
    return Ok((amqp.Value.Null, p))
  }
  if c == 0x41 || c == 0x42 {
    return Ok((amqp.Value.Bool(v: c == 0x41), p))
  }
  if c == 0x56 {
    need(b, p, 1)?
    if Int(b[p]) > 1 {
      return Err(dec_err("invalid boolean"))
    }
    return Ok((amqp.Value.Bool(v: b[p] == 1), p + 1))
  }
  if c == 0x43 {
    return Ok((amqp.Value.UInt(v: UInt32(0)), p))
  }
  if c == 0x44 {
    return Ok((amqp.Value.ULong(v: UInt64(0)), p))
  }
  if c == 0x45 {
    return Ok((amqp.Value.List(items: []), p))
  }
  let w = fixed_width(c)
  if w >= 0 {
    need(b, p, w)?
    return Ok((fixed_value(b, c, p), p + w))
  }
  if c == 0xa0 || c == 0xa1 || c == 0xa3 || c == 0xb0 || c == 0xb1 || c == 0xb3 {
    let lw = if c < 0xb0 { 1 } else { 4 }
    need(b, p, lw)?
    let n = get_be(b, p, lw)
    need(b, p + lw, n)?
    let body = b[p + lw..p + lw + n]
    let end = p + lw + n
    if c == 0xa0 || c == 0xb0 {
      return Ok((amqp.Value.Binary(v: body), end))
    }
    let s = body.to_str() ?? return Err(dec_err("not a valid UTF-8 string"))
    if c == 0xa1 || c == 0xb1 {
      return Ok((amqp.Value.Str(v: s), end))
    }
    return Ok((amqp.Value.Symbol(v: s), end))
  }
  if c == 0xc0 || c == 0xd0 || c == 0xc1 || c == 0xd1 || c == 0xe0 || c == 0xf0 {
    let wide = c >= 0xd0 && c != 0xe0
    let lw = if wide { 4 } else { 1 }
    need(b, p, 2 * lw)?
    let size = get_be(b, p, lw)
    let count = get_be(b, p + lw, lw)
    let start = p + 2 * lw
    if size < lw {
      return Err(dec_err("invalid compound size"))
    }
    let end = p + lw + size
    need(b, p + lw, size)?
    // every element takes at least a byte
    if count > end - start && c != 0xe0 && c != 0xf0 {
      return Err(dec_err("compound count exceeds its size"))
    }
    if c == 0xc0 || c == 0xd0 {
      var items: List[amqp.Value] = []
      var q = start
      for _ in 0..count {
        let (x, q1) = get_value(b, q, depth + 1)?
        if q1 > end {
          return Err(dec_err("list element past its end"))
        }
        items.push(x)
        q = q1
      }
      if q != end {
        return Err(dec_err("list size mismatch"))
      }
      return Ok((amqp.Value.List(items: items), end))
    }
    if c == 0xc1 || c == 0xd1 {
      if count % 2 != 0 {
        return Err(dec_err("odd map count"))
      }
      var pairs: List[(amqp.Value, amqp.Value)] = []
      var q = start
      for _ in 0..count / 2 {
        let (k, q1) = get_value(b, q, depth + 1)?
        let (x, q2) = get_value(b, q1, depth + 1)?
        if q2 > end {
          return Err(dec_err("map element past its end"))
        }
        pairs.push((k, x))
        q = q2
      }
      if q != end {
        return Err(dec_err("map size mismatch"))
      }
      return Ok((amqp.Value.Map(pairs: pairs), end))
    }
    // array: one element constructor, then the bodies
    need(b, start, 1)?
    let ec = Int(b[start])
    var q = start + 1
    var items: List[amqp.Value] = []
    for _ in 0..count {
      if q > end {
        return Err(dec_err("array element past its end"))
      }
      let (x, q1) = get_body(b, ec, q, end, depth + 1)?
      items.push(x)
      q = q1
    }
    if q != end {
      return Err(dec_err("array size mismatch"))
    }
    return Ok((amqp.Value.Array(items: items), end))
  }
  Err(dec_err("unknown type code 0x${hex2(c)}"))
}

fn hex2(c: Int) -> Str {
  let h = "0123456789abcdef"
  h[c >> 4..(c >> 4) + 1] + h[c & 15..(c & 15) + 1]
}

/// An element of an array with constructor ec at q (ending by end).
fn get_body(b: Bytes, ec: Int, q: Int, end: Int, depth: Int) -> (amqp.Value, Int) ! amqp.AmqpErr {
  if ec == 0x41 || ec == 0x42 || ec == 0x43 || ec == 0x44 || ec == 0x45 || ec == 0x40 {
    // zero width constructors: the value is the constructor
    let v = if ec == 0x40 {
      amqp.Value.Null
    } else if ec == 0x41 || ec == 0x42 {
      amqp.Value.Bool(v: ec == 0x41)
    } else if ec == 0x43 {
      amqp.Value.UInt(v: UInt32(0))
    } else if ec == 0x44 {
      amqp.Value.ULong(v: UInt64(0))
    } else {
      amqp.Value.List(items: [])
    }
    return Ok((v, q))
  }
  let w = fixed_width(ec)
  if w >= 0 {
    need(b, q, w)?
    if ec == 0x56 && Int(b[q]) > 1 {
      return Err(dec_err("invalid boolean"))
    }
    return Ok((fixed_value(b, ec, q), q + w))
  }
  if ec == 0xa0 || ec == 0xa1 || ec == 0xa3 || ec == 0xb0 || ec == 0xb1 || ec == 0xb3 {
    // re-use get_value on a synthesized constructor
    let lw = if ec < 0xb0 { 1 } else { 4 }
    need(b, q, lw)?
    let n = get_be(b, q, lw)
    need(b, q + lw, n)?
    var tmp = BytesBuilder.new()
    tmp.write_byte(UInt8(ec))
    tmp.write(b[q..q + lw + n])
    let (v, _) = get_value(tmp.freeze(), 0, depth)?
    return Ok((v, q + lw + n))
  }
  if ec == 0xd1 || ec == 0xc1 {
    let lw = if ec == 0xd1 { 4 } else { 1 }
    need(b, q, lw)?
    let size = get_be(b, q, lw)
    need(b, q, lw + size)?
    var tmp = BytesBuilder.new()
    tmp.write_byte(UInt8(ec))
    tmp.write(b[q..q + lw + size])
    let (v, _) = get_value(tmp.freeze(), 0, depth)?
    return Ok((v, q + lw + size))
  }
  Err(dec_err("unsupported array element constructor 0x${hex2(ec)}"))
}

/// The body width of a fixed width constructor, or -1.
fn fixed_width(c: Int) -> Int {
  if c == 0x56 || c == 0x50 || c == 0x51 || c == 0x52 || c == 0x53 || c == 0x54 || c == 0x55 { return 1 }
  if c == 0x60 || c == 0x61 { return 2 }
  if c == 0x70 || c == 0x71 || c == 0x72 || c == 0x73 || c == 0x74 { return 4 }
  if c == 0x80 || c == 0x81 || c == 0x82 || c == 0x83 || c == 0x84 { return 8 }
  if c == 0x94 || c == 0x98 { return 16 }
  -1
}

fn fixed_value(b: Bytes, c: Int, p: Int) -> amqp.Value {
  if c == 0x56 { return amqp.Value.Bool(v: b[p] == 1) }
  if c == 0x50 { return amqp.Value.UByte(v: UInt8(get_be(b, p, 1))) }
  if c == 0x51 { return amqp.Value.Byte(v: Int8(get_signed(b, p, 1))) }
  if c == 0x52 { return amqp.Value.UInt(v: UInt32(get_be(b, p, 1))) }
  if c == 0x53 { return amqp.Value.ULong(v: UInt64(get_be(b, p, 1))) }
  if c == 0x54 { return amqp.Value.Int(v: Int32(get_signed(b, p, 1))) }
  if c == 0x55 { return amqp.Value.Long(v: Int64(get_signed(b, p, 1))) }
  if c == 0x60 { return amqp.Value.UShort(v: UInt16(get_be(b, p, 2))) }
  if c == 0x61 { return amqp.Value.Short(v: Int16(get_signed(b, p, 2))) }
  if c == 0x70 { return amqp.Value.UInt(v: UInt32(get_be(b, p, 4))) }
  if c == 0x71 { return amqp.Value.Int(v: Int32(get_signed(b, p, 4))) }
  if c == 0x72 { return amqp.Value.Float(v: Float32.from_bits(UInt32(get_be(b, p, 4)))) }
  if c == 0x73 { return amqp.Value.Char(v: Rune.try(get_be(b, p, 4)) ?? Rune.try(0xFFFD) ?? fault("rune")) }
  if c == 0x74 { return amqp.Value.Decimal32(bits: UInt32(get_be(b, p, 4))) }
  if c == 0x80 { return amqp.Value.ULong(v: UInt64.from_bits(get_be(b, p, 8))) }
  if c == 0x81 { return amqp.Value.Long(v: Int64(get_be(b, p, 8))) }
  if c == 0x82 { return amqp.Value.Double(v: Float.from_bits(get_be(b, p, 8))) }
  if c == 0x83 { return amqp.Value.Timestamp(ms: get_be(b, p, 8)) }
  if c == 0x84 { return amqp.Value.Decimal64(bits: UInt64.from_bits(get_be(b, p, 8))) }
  if c == 0x94 { return amqp.Value.Decimal128(bits: b[p..p + 16]) }
  amqp.Value.Uuid(bytes: b[p..p + 16])
}

fn decode(b: Bytes) -> (amqp.Value, Int) ! amqp.AmqpErr {
  get_value(b, 0, 0)
}

// ---------------------------------------------------------------------------
// Stage 2a: performatives and frames

fn vnull() -> amqp.Value { amqp.Value.Null }

fn vstr(s: Str) -> amqp.Value {
  if s == "" { amqp.Value.Null } else { amqp.Value.Str(v: s) }
}

fn vsym(s: Str) -> amqp.Value {
  if s == "" { amqp.Value.Null } else { amqp.Value.Symbol(v: s) }
}

fn vu32(x: UInt32) -> amqp.Value { amqp.Value.UInt(v: x) }

/// A uint that is null when it equals its default.
fn vint32d(x: Int, d: Int) -> amqp.Value {
  if x == d { amqp.Value.Null } else { amqp.Value.UInt(v: UInt32.wrapping_from(x)) }
}

fn vu32o(x: UInt32?) -> amqp.Value {
  match x {
    Some(v) => amqp.Value.UInt(v: v)
    None => amqp.Value.Null
  }
}

fn vbool(b: Bool) -> amqp.Value {
  if b { amqp.Value.Bool(v: true) } else { amqp.Value.Null }
}

fn vbin(b: Bytes) -> amqp.Value {
  if b.len() == 0 { amqp.Value.Null } else { amqp.Value.Binary(v: b) }
}

/// go-amqp's MultiSymbol: nothing for none, one symbol for one, else an array.
fn vsyms(xs: List[Str]) -> amqp.Value {
  if xs.len() == 0 { return amqp.Value.Null }
  if xs.len() == 1 { return amqp.Value.Symbol(v: xs[0]) }
  var items: List[amqp.Value] = []
  for s in xs { items.push(amqp.Value.Symbol(v: s)) }
  amqp.Value.Array(items: items)
}

fn vmap(xs: List[(Str, amqp.Value)], symbol_keys: Bool) -> amqp.Value {
  if xs.len() == 0 { return amqp.Value.Null }
  var pairs: List[(amqp.Value, amqp.Value)] = []
  for (k, v) in xs {
    let key = if symbol_keys { amqp.Value.Symbol(v: k) } else { amqp.Value.Str(v: k) }
    pairs.push((key, v))
  }
  amqp.Value.Map(pairs: pairs)
}

/// A described list, trailing nulls trimmed (an empty list is list0).
fn composite(code: Int, fields: List[amqp.Value]) -> amqp.Value {
  var n = fields.len()
  while n > 0 {
    match fields[n - 1] {
      Null => { n -= 1 }
      _ => { break }
    }
  }
  var items: List[amqp.Value] = []
  for i in 0..n { items.push(fields[i]) }
  amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64.from_bits(code)), value: amqp.Value.List(items: items))
}

fn error_value(e: amqp.WireError) -> amqp.Value {
  composite(0x1d, [vsym(e.condition), vstr(e.description), vmap(e.info, false)])
}

fn error_opt(e: amqp.WireError?) -> amqp.Value {
  match e {
    Some(x) => error_value(x)
    None => amqp.Value.Null
  }
}

fn state_value(s: amqp.DeliveryState) -> amqp.Value {
  match s {
    Received(n, o) => composite(0x23, [vu32(n), amqp.Value.ULong(v: o)])
    Accepted => composite(0x24, [])
    Rejected(e) => composite(0x25, [error_opt(e)])
    Released => composite(0x26, [])
    Modified(failed, undeliverable, ann) => {
      composite(0x27, [vbool(failed), vbool(undeliverable), if ann.len() == 0 { amqp.Value.Null } else { amqp.Value.Map(pairs: ann) }])
    }
  }
}

fn state_opt(s: amqp.DeliveryState?) -> amqp.Value {
  match s {
    Some(x) => state_value(x)
    None => amqp.Value.Null
  }
}

fn source_opt(s: amqp.Source?) -> amqp.Value {
  match s {
    Some(x) => {
      composite(0x28, [
        vstr(x.address), vint32d(x.durable, 0), vsym(x.expiry_policy), vint32d(x.timeout, 0),
        vbool(x.dynamic), vmap(x.dynamic_node_properties, true), vsym(x.distribution_mode),
        vmap(x.filter, true), x.default_outcome, vsyms(x.outcomes), vsyms(x.capabilities),
      ])
    }
    None => amqp.Value.Null
  }
}

fn target_opt(t: amqp.Target?) -> amqp.Value {
  match t {
    Some(x) => {
      composite(0x29, [
        vstr(x.address), vint32d(x.durable, 0), vsym(x.expiry_policy), vint32d(x.timeout, 0),
        vbool(x.dynamic), vmap(x.dynamic_node_properties, true), vsyms(x.capabilities),
      ])
    }
    None => amqp.Value.Null
  }
}

fn role_value(r: amqp.Role) -> amqp.Value {
  match r {
    Sender => amqp.Value.Bool(v: false)
    Receiver => amqp.Value.Bool(v: true)
  }
}

fn ssm_value(m: amqp.SenderSettleMode?) -> amqp.Value {
  match m {
    Some(Unsettled) => amqp.Value.UByte(v: UInt8(0))
    Some(Settled) => amqp.Value.UByte(v: UInt8(1))
    Some(Mixed) => amqp.Value.UByte(v: UInt8(2))
    None => amqp.Value.Null
  }
}

fn rsm_value(m: amqp.ReceiverSettleMode?) -> amqp.Value {
  match m {
    Some(First) => amqp.Value.UByte(v: UInt8(0))
    Some(Second) => amqp.Value.UByte(v: UInt8(1))
    None => amqp.Value.Null
  }
}

fn unsettled_value(xs: List[(Bytes, amqp.DeliveryState?)]) -> amqp.Value {
  if xs.len() == 0 { return amqp.Value.Null }
  var pairs: List[(amqp.Value, amqp.Value)] = []
  for (tag, st) in xs { pairs.push((amqp.Value.Binary(v: tag), state_opt(st))) }
  amqp.Value.Map(pairs: pairs)
}

fn body_value(b: amqp.FrameBody) -> amqp.Value {
  match b {
    Open(o) => {
      composite(0x10, [
        amqp.Value.Str(v: o.container_id), vstr(o.hostname), vint32d(o.max_frame_size, 4294967295),
        if o.channel_max == 65535 { amqp.Value.Null } else { amqp.Value.UShort(v: UInt16.wrapping_from(o.channel_max)) },
        if o.idle_timeout_ms == 0 { amqp.Value.Null } else { amqp.Value.UInt(v: UInt32(o.idle_timeout_ms)) },
        vsyms(o.outgoing_locales), vsyms(o.incoming_locales), vsyms(o.offered_capabilities),
        vsyms(o.desired_capabilities), vmap(o.properties, true),
      ])
    }
    Begin(x) => {
      composite(0x11, [
        match x.remote_channel {
          Some(c) => amqp.Value.UShort(v: c)
          None => amqp.Value.Null
        },
        vu32(x.next_outgoing_id), vu32(x.incoming_window), vu32(x.outgoing_window),
        vint32d(x.handle_max, 4294967295), vsyms(x.offered_capabilities), vsyms(x.desired_capabilities),
        vmap(x.properties, true),
      ])
    }
    Attach(x) => {
      composite(0x12, [
        amqp.Value.Str(v: x.name), vu32(x.handle), role_value(x.role), ssm_value(x.sender_settle_mode),
        rsm_value(x.receiver_settle_mode), source_opt(x.source), target_opt(x.target),
        unsettled_value(x.unsettled), vbool(x.incomplete_unsettled),
        match x.role {
          Receiver => amqp.Value.Null
          Sender => amqp.Value.UInt(v: UInt32.wrapping_from(x.initial_delivery_count))
        },
        if x.max_message_size == 0 { amqp.Value.Null } else { amqp.Value.ULong(v: UInt64.from_bits(x.max_message_size)) },
        vsyms(x.offered_capabilities), vsyms(x.desired_capabilities), vmap(x.properties, true),
      ])
    }
    Flow(x) => {
      composite(0x13, [
        vu32o(x.next_incoming_id), vu32(x.incoming_window), vu32(x.next_outgoing_id), vu32(x.outgoing_window),
        vu32o(x.handle), vu32o(x.delivery_count), vu32o(x.link_credit), vu32o(x.available),
        vbool(x.drain), vbool(x.echo), vmap(x.properties, true),
      ])
    }
    Transfer(x) => {
      composite(0x14, [
        vu32(x.handle), vu32o(x.delivery_id), vbin(x.delivery_tag), vu32o(x.message_format),
        vbool(x.settled), vbool(x.more), rsm_value(x.receiver_settle_mode), state_opt(x.state),
        vbool(x.resume), vbool(x.aborted), vbool(x.batchable),
      ])
    }
    Disposition(x) => {
      composite(0x15, [role_value(x.role), vu32(x.first), vu32o(x.last), vbool(x.settled), state_opt(x.state), vbool(x.batchable)])
    }
    Detach(x) => composite(0x16, [vu32(x.handle), vbool(x.closed), error_opt(x.error)])
    End(x) => composite(0x17, [error_opt(x.error)])
    Close(x) => composite(0x18, [error_opt(x.error)])
    SaslMechanisms(x) => composite(0x40, [vsyms(x.mechanisms)])
    SaslInit(x) => composite(0x41, [amqp.Value.Symbol(v: x.mechanism), vbin(x.initial_response), vstr(x.hostname)])
    SaslChallenge(x) => composite(0x42, [amqp.Value.Binary(v: x.challenge)])
    SaslResponse(x) => composite(0x43, [amqp.Value.Binary(v: x.response)])
    SaslOutcome(x) => composite(0x44, [amqp.Value.UByte(v: x.code), vbin(x.additional_data)])
    Empty => amqp.Value.Null
  }
}

fn is_sasl(b: amqp.FrameBody) -> Bool {
  match b {
    SaslMechanisms(_) => true
    SaslInit(_) => true
    SaslChallenge(_) => true
    SaslResponse(_) => true
    SaslOutcome(_) => true
    _ => false
  }
}

fn in_range(name: Str, x: Int, hi: Int) -> () ! amqp.AmqpErr {
  if x < 0 || x > hi { return Err(enc_err("${name} is out of range")) }
  Ok(())
}

fn check_ranges(b: amqp.FrameBody) -> () ! amqp.AmqpErr {
  match b {
    Open(o) => {
      in_range("max_frame_size", o.max_frame_size, 4294967295)?
      in_range("channel_max", o.channel_max, 65535)?
      in_range("idle_timeout_ms", o.idle_timeout_ms, 4294967295)?
    }
    Begin(x) => { in_range("handle_max", x.handle_max, 4294967295)? }
    Attach(x) => {
      in_range("initial_delivery_count", x.initial_delivery_count, 4294967295)?
      in_range("max_message_size", x.max_message_size, 9223372036854775807)?
      match x.source {
        Some(s) => {
          in_range("durable", s.durable, 4294967295)?
          in_range("timeout", s.timeout, 4294967295)?
        }
        None => {}
      }
      match x.target {
        Some(t) => {
          in_range("durable", t.durable, 4294967295)?
          in_range("timeout", t.timeout, 4294967295)?
        }
        None => {}
      }
    }
    _ => {}
  }
  Ok(())
}

fn encode_frame(f: amqp.Frame) -> Bytes ! amqp.AmqpErr {
  check_ranges(f.body)?
  var body = BytesBuilder.new()
  match f.body {
    Empty => {}
    _ => {
      body = put_value(body, body_value(f.body))?
      match f.body {
        Transfer(t) => { body.write(t.payload) }
        _ => {}
      }
    }
  }
  let total = 8 + body.len()
  var out = BytesBuilder.new()
  out = be(out, total, 4)
  out = be(out, 2, 1)
  out = be(out, if is_sasl(f.body) { 1 } else { 0 }, 1)
  out = be(out, Int(f.channel), 2)
  out.write(body.freeze())
  Ok(out.freeze())
}

// Decoding of frames

fn at(items: List[amqp.Value], i: Int) -> amqp.Value {
  if i < items.len() { items[i] } else { amqp.Value.Null }
}

fn want_str(v: amqp.Value) -> Str ! amqp.AmqpErr {
  match v {
    Null => Ok("")
    Str(s) => Ok(s)
    Symbol(s) => Ok(s)
    _ => Err(dec_err("expected a string"))
  }
}

fn want_u32(v: amqp.Value, d: UInt32) -> UInt32 ! amqp.AmqpErr {
  match v {
    Null => Ok(d)
    UInt(x) => Ok(x)
    UShort(x) => Ok(UInt32(Int(x)))
    UByte(x) => Ok(UInt32(Int(x)))
    _ => Err(dec_err("expected a uint"))
  }
}

fn want_u32o(v: amqp.Value) -> UInt32? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    _ => Ok(Some(want_u32(v, UInt32(0))?))
  }
}

fn want_bool(v: amqp.Value) -> Bool ! amqp.AmqpErr {
  match v {
    Null => Ok(false)
    Bool(b) => Ok(b)
    _ => Err(dec_err("expected a boolean"))
  }
}

fn want_bin(v: amqp.Value) -> Bytes ! amqp.AmqpErr {
  match v {
    Null => Ok(b"")
    Binary(x) => Ok(x)
    _ => Err(dec_err("expected binary"))
  }
}

fn want_syms(v: amqp.Value) -> List[Str] ! amqp.AmqpErr {
  var out: List[Str] = []
  match v {
    Null => {}
    Symbol(s) => { out.push(s) }
    Str(s) => { out.push(s) }
    Array(items) => {
      for x in items { out.push(want_str(x)?) }
    }
    List(items) => {
      for x in items { out.push(want_str(x)?) }
    }
    _ => { return Err(dec_err("expected symbols")) }
  }
  Ok(out)
}

fn want_smap(v: amqp.Value) -> List[(Str, amqp.Value)] ! amqp.AmqpErr {
  var out: List[(Str, amqp.Value)] = []
  match v {
    Null => {}
    Map(pairs) => {
      for (k, x) in pairs { out.push((want_str(k)?, x)) }
    }
    _ => { return Err(dec_err("expected a map")) }
  }
  Ok(out)
}

fn want_role(v: amqp.Value) -> amqp.Role ! amqp.AmqpErr {
  if want_bool(v)? { Ok(amqp.Role.Receiver) } else { Ok(amqp.Role.Sender) }
}

fn want_ssm(v: amqp.Value) -> amqp.SenderSettleMode? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    UByte(x) => {
      if Int(x) == 0 { return Ok(Some(amqp.SenderSettleMode.Unsettled)) }
      if Int(x) == 1 { return Ok(Some(amqp.SenderSettleMode.Settled)) }
      if Int(x) == 2 { return Ok(Some(amqp.SenderSettleMode.Mixed)) }
      Err(dec_err("bad sender-settle-mode"))
    }
    _ => Err(dec_err("expected a ubyte"))
  }
}

fn want_rsm(v: amqp.Value) -> amqp.ReceiverSettleMode? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    UByte(x) => {
      if Int(x) == 0 { return Ok(Some(amqp.ReceiverSettleMode.First)) }
      if Int(x) == 1 { return Ok(Some(amqp.ReceiverSettleMode.Second)) }
      Err(dec_err("bad receiver-settle-mode"))
    }
    _ => Err(dec_err("expected a ubyte"))
  }
}

/// The code and fields of a described list.
fn parts(v: amqp.Value) -> (Int, List[amqp.Value]) ! amqp.AmqpErr {
  match v {
    Described(d, body) => {
      match (d, body) {
        (ULong(c), List(items)) => Ok((c.to_bits(), items))
        _ => Err(dec_err("expected a described list"))
      }
    }
    _ => Err(dec_err("expected a described value"))
  }
}

fn want_error(v: amqp.Value) -> amqp.WireError? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    _ => {
      let (c, f) = parts(v)?
      if c != 0x1d { return Err(dec_err("expected an error")) }
      Ok(Some(amqp.WireError{condition: want_str(at(f, 0))?, description: want_str(at(f, 1))?, info: want_smap(at(f, 2))?}))
    }
  }
}

fn want_state(v: amqp.Value) -> amqp.DeliveryState? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    _ => {
      let (c, f) = parts(v)?
      if c == 0x23 {
        var off = UInt64.from_bits(0)
        match at(f, 1) {
          ULong(x) => { off = x }
          _ => {}
        }
        return Ok(Some(amqp.DeliveryState.Received(section_number: want_u32(at(f, 0), UInt32(0))?, section_offset: off)))
      }
      if c == 0x24 { return Ok(Some(amqp.DeliveryState.Accepted)) }
      if c == 0x25 { return Ok(Some(amqp.DeliveryState.Rejected(error: want_error(at(f, 0))?))) }
      if c == 0x26 { return Ok(Some(amqp.DeliveryState.Released)) }
      if c == 0x27 {
        var ann: List[(amqp.Value, amqp.Value)] = []
        match at(f, 2) {
          Map(p) => { ann = p }
          _ => {}
        }
        return Ok(Some(amqp.DeliveryState.Modified(delivery_failed: want_bool(at(f, 0))?, undeliverable_here: want_bool(at(f, 1))?, annotations: ann)))
      }
      Err(dec_err("unknown delivery state"))
    }
  }
}

fn want_source(v: amqp.Value) -> amqp.Source? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    _ => {
      let (c, f) = parts(v)?
      if c != 0x28 { return Err(dec_err("expected a source")) }
      Ok(Some(amqp.Source{
        address: want_str(at(f, 0))?, durable: want_int(at(f, 1), 0)?,
        expiry_policy: want_str(at(f, 2))?, timeout: want_int(at(f, 3), 0)?,
        dynamic: want_bool(at(f, 4))?, dynamic_node_properties: want_smap(at(f, 5))?,
        distribution_mode: want_str(at(f, 6))?, filter: want_smap(at(f, 7))?,
        default_outcome: at(f, 8), outcomes: want_syms(at(f, 9))?, capabilities: want_syms(at(f, 10))?}))
    }
  }
}

fn want_target(v: amqp.Value) -> amqp.Target? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    _ => {
      let (c, f) = parts(v)?
      if c != 0x29 { return Err(dec_err("expected a target")) }
      Ok(Some(amqp.Target{
        address: want_str(at(f, 0))?, durable: want_int(at(f, 1), 0)?,
        expiry_policy: want_str(at(f, 2))?, timeout: want_int(at(f, 3), 0)?,
        dynamic: want_bool(at(f, 4))?, dynamic_node_properties: want_smap(at(f, 5))?,
        capabilities: want_syms(at(f, 6))?}))
    }
  }
}

fn want_unsettled(v: amqp.Value) -> List[(Bytes, amqp.DeliveryState?)] ! amqp.AmqpErr {
  var out: List[(Bytes, amqp.DeliveryState?)] = []
  match v {
    Null => {}
    Map(pairs) => {
      for (k, x) in pairs { out.push((want_bin(k)?, want_state(x)?)) }
    }
    _ => { return Err(dec_err("expected a map")) }
  }
  Ok(out)
}

fn want_ulong(v: amqp.Value) -> UInt64 ! amqp.AmqpErr {
  match v {
    Null => Ok(UInt64.from_bits(0))
    ULong(x) => Ok(x)
    UInt(x) => Ok(UInt64.from_bits(Int(x)))
    _ => Err(dec_err("expected a ulong"))
  }
}

fn want_ushort(v: amqp.Value, d: UInt16) -> UInt16 ! amqp.AmqpErr {
  match v {
    Null => Ok(d)
    UShort(x) => Ok(x)
    UByte(x) => Ok(UInt16(Int(x)))
    _ => Err(dec_err("expected a ushort"))
  }
}

/// An unsigned wire integer (ubyte, ushort, uint or ulong) as an Int, d when null.
fn want_int(v: amqp.Value, d: Int) -> Int ! amqp.AmqpErr {
  match v {
    Null => Ok(d)
    UByte(x) => Ok(Int(x))
    UShort(x) => Ok(Int(x))
    UInt(x) => Ok(Int(x))
    ULong(x) => {
      let n = x.to_bits()
      if n < 0 { return Err(dec_err("ulong out of range")) }
      Ok(n)
    }
    _ => Err(dec_err("expected an unsigned integer"))
  }
}

fn want_millis(v: amqp.Value) -> Int ! amqp.AmqpErr {
  match v {
    Null => Ok(0)
    UInt(x) => Ok(Int(x))
    _ => Err(dec_err("expected a uint"))
  }
}

fn body_of(c: Int, f: List[amqp.Value], rest: Bytes) -> amqp.FrameBody ! amqp.AmqpErr {
  if c == 0x10 {
    return Ok(amqp.FrameBody.Open(v: amqp.Open{
      container_id: want_str(at(f, 0))?, hostname: want_str(at(f, 1))?,
      max_frame_size: want_int(at(f, 2), 4294967295)?, channel_max: want_int(at(f, 3), 65535)?,
      idle_timeout_ms: want_millis(at(f, 4))?, outgoing_locales: want_syms(at(f, 5))?,
      incoming_locales: want_syms(at(f, 6))?, offered_capabilities: want_syms(at(f, 7))?,
      desired_capabilities: want_syms(at(f, 8))?, properties: want_smap(at(f, 9))?}))
  }
  if c == 0x11 {
    var rc: UInt16? = None
    match at(f, 0) {
      Null => {}
      _ => { rc = Some(want_ushort(at(f, 0), UInt16(0))?) }
    }
    return Ok(amqp.FrameBody.Begin(v: amqp.Begin{
      remote_channel: rc, next_outgoing_id: want_u32(at(f, 1), UInt32(0))?,
      incoming_window: want_u32(at(f, 2), UInt32(0))?, outgoing_window: want_u32(at(f, 3), UInt32(0))?,
      handle_max: want_int(at(f, 4), 4294967295)?, offered_capabilities: want_syms(at(f, 5))?,
      desired_capabilities: want_syms(at(f, 6))?, properties: want_smap(at(f, 7))?}))
  }
  if c == 0x12 {
    return Ok(amqp.FrameBody.Attach(v: amqp.Attach{
      name: want_str(at(f, 0))?, handle: want_u32(at(f, 1), UInt32(0))?, role: want_role(at(f, 2))?,
      sender_settle_mode: want_ssm(at(f, 3))?, receiver_settle_mode: want_rsm(at(f, 4))?,
      source: want_source(at(f, 5))?, target: want_target(at(f, 6))?, unsettled: want_unsettled(at(f, 7))?,
      incomplete_unsettled: want_bool(at(f, 8))?, initial_delivery_count: want_int(at(f, 9), 0)?,
      max_message_size: want_int(at(f, 10), 0)?, offered_capabilities: want_syms(at(f, 11))?,
      desired_capabilities: want_syms(at(f, 12))?, properties: want_smap(at(f, 13))?}))
  }
  if c == 0x13 {
    return Ok(amqp.FrameBody.Flow(v: amqp.Flow{
      next_incoming_id: want_u32o(at(f, 0))?, incoming_window: want_u32(at(f, 1), UInt32(0))?,
      next_outgoing_id: want_u32(at(f, 2), UInt32(0))?, outgoing_window: want_u32(at(f, 3), UInt32(0))?,
      handle: want_u32o(at(f, 4))?, delivery_count: want_u32o(at(f, 5))?, link_credit: want_u32o(at(f, 6))?,
      available: want_u32o(at(f, 7))?, drain: want_bool(at(f, 8))?, echo: want_bool(at(f, 9))?,
      properties: want_smap(at(f, 10))?}))
  }
  if c == 0x14 {
    return Ok(amqp.FrameBody.Transfer(v: amqp.Transfer{
      handle: want_u32(at(f, 0), UInt32(0))?, delivery_id: want_u32o(at(f, 1))?,
      delivery_tag: want_bin(at(f, 2))?, message_format: want_u32o(at(f, 3))?,
      settled: want_bool(at(f, 4))?, more: want_bool(at(f, 5))?, receiver_settle_mode: want_rsm(at(f, 6))?,
      state: want_state(at(f, 7))?, resume: want_bool(at(f, 8))?, aborted: want_bool(at(f, 9))?,
      batchable: want_bool(at(f, 10))?, payload: rest}))
  }
  if c == 0x15 {
    return Ok(amqp.FrameBody.Disposition(v: amqp.Disposition{
      role: want_role(at(f, 0))?, first: want_u32(at(f, 1), UInt32(0))?, last: want_u32o(at(f, 2))?,
      settled: want_bool(at(f, 3))?, state: want_state(at(f, 4))?, batchable: want_bool(at(f, 5))?}))
  }
  if c == 0x16 {
    return Ok(amqp.FrameBody.Detach(v: amqp.Detach{
      handle: want_u32(at(f, 0), UInt32(0))?, closed: want_bool(at(f, 1))?, error: want_error(at(f, 2))?}))
  }
  if c == 0x17 { return Ok(amqp.FrameBody.End(v: amqp.End{error: want_error(at(f, 0))?})) }
  if c == 0x18 { return Ok(amqp.FrameBody.Close(v: amqp.Close{error: want_error(at(f, 0))?})) }
  if c == 0x40 { return Ok(amqp.FrameBody.SaslMechanisms(v: amqp.SaslMechanisms{mechanisms: want_syms(at(f, 0))?})) }
  if c == 0x41 {
    return Ok(amqp.FrameBody.SaslInit(v: amqp.SaslInit{
      mechanism: want_str(at(f, 0))?, initial_response: want_bin(at(f, 1))?, hostname: want_str(at(f, 2))?}))
  }
  if c == 0x42 { return Ok(amqp.FrameBody.SaslChallenge(v: amqp.SaslChallenge{challenge: want_bin(at(f, 0))?})) }
  if c == 0x43 { return Ok(amqp.FrameBody.SaslResponse(v: amqp.SaslResponse{response: want_bin(at(f, 0))?})) }
  if c == 0x44 {
    var code = UInt8(0)
    match at(f, 0) {
      UByte(x) => { code = x }
      _ => { return Err(dec_err("expected a ubyte code")) }
    }
    return Ok(amqp.FrameBody.SaslOutcome(v: amqp.SaslOutcome{code: code, additional_data: want_bin(at(f, 1))?}))
  }
  Err(dec_err("unknown performative"))
}

fn decode_frame(b: Bytes, max_size: Int = 4294967295) -> (amqp.Frame, Int) ! amqp.AmqpErr {
  need(b, 0, 8)?
  let size = get_be(b, 0, 4)
  let doff = Int(b[4])
  let ftype = Int(b[5])
  let channel = get_be(b, 6, 2)
  if size < 8 || doff < 2 || doff * 4 > size {
    return Err(dec_err("bad frame header"))
  }
  if size > max_size {
    return Err(dec_err("frame larger than the maximum frame size"))
  }
  need(b, 0, size)?
  if ftype != 0 && ftype != 1 {
    return Err(dec_err("unknown frame type"))
  }
  let start = doff * 4
  if start == size {
    if ftype == 1 { return Err(dec_err("an empty SASL frame")) }
    return Ok((amqp.Frame{channel: UInt16(channel), body: amqp.FrameBody.Empty}, size))
  }
  let (v, used) = get_value(b[0..size], start, 0)?
  let (c, f) = parts(v)?
  if ftype == 1 && (c < 0x40 || c > 0x44) { return Err(dec_err("not a SASL performative")) }
  if ftype == 0 && (c < 0x10 || c > 0x18) { return Err(dec_err("not an AMQP performative")) }
  let body = body_of(c, f, b[used..size])?
  Ok((amqp.Frame{channel: UInt16(channel), body: body}, size))
}

// ---------------------------------------------------------------------------
// Stage 2b-i: the connection

fn net_err(e: NetErr) -> amqp.AmqpErr { amqp.AmqpErr.Net(msg: "${e}") }

fn proto_err(msg: Str) -> amqp.AmqpErr { amqp.AmqpErr.Protocol(msg: msg) }

fn t_read(l: amqp.Transport, max: Int) -> Bytes? ! amqp.AmqpErr uses (net.dial, clock) {
  match l {
    Plain(c) => c.read(max).map_err(net_err)
    Tls(t) => t.read(max).map_err(net_err)
  }
}

fn t_write(l: amqp.Transport, data: Bytes) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  match l {
    Plain(c) => c.write(data).map_err(net_err)
    Tls(t) => t.write(data).map_err(net_err)
  }
}

fn t_close(l: amqp.Transport) {
  match l {
    Plain(c) => c.close()
    Tls(t) => t.close()
  }
}

/// The host, `host:port` and whether TLS is used, from `host:port`, `amqp://...` or `amqps://...`.
fn parse_addr(addr: Str) -> (Str, Str, Bool) {
  var rest = addr
  var secure = false
  if rest.starts_with("amqps://") {
    rest = rest[8..]
    secure = true
  } else if rest.starts_with("amqp://") {
    rest = rest[7..]
  }
  var end = rest.len()
  var i = 0
  while i < rest.len() {
    if rest[i..i + 1] == "/" {
      end = i
      break
    }
    i += 1
  }
  rest = rest[0..end]
  let default_port = if secure { "5671" } else { "5672" }
  if rest.starts_with("[") {
    var close = -1
    i = 0
    while i < rest.len() {
      if rest[i..i + 1] == "]" { close = i }
      i += 1
    }
    if close > 0 {
      let h = rest[1..close]
      if close + 1 < rest.len() && rest[close + 1..close + 2] == ":" { return (h, rest, secure) }
      return (h, "[" + h + "]:" + default_port, secure)
    }
  }
  var cl = -1
  i = 0
  while i < rest.len() {
    if rest[i..i + 1] == ":" { cl = i }
    i += 1
  }
  if cl < 0 { return (rest, rest + ":" + default_port, secure) }
  (rest[0..cl], rest, secure)
}

fn t_read_dl(l: amqp.Transport, k: Clock, at: Time?, max: Int) -> Bytes? ! NetErr uses (net.dial, clock) {
  match l {
    Plain(c) => {
      c.set_read_deadline(k, at)
      c.read(max)
    }
    Tls(t) => {
      t.set_read_deadline(k, at)
      t.read(max)
    }
  }
}

/// The earlier of two deadlines in Unix milliseconds, 0 meaning none.
fn first_of(a: Int, b: Int) -> Int {
  if a == 0 { return b }
  if b == 0 { return a }
  if a < b { a } else { b }
}

fn heartbeat_frame() -> amqp.Frame { amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Empty} }

/// Reads until at least n bytes are buffered. With a clock it also gives up after `timeout_ms`
/// without bytes, sends an empty frame at half the peer's idle timeout and fails when the peer
/// sent nothing for our idle timeout.
fn fill(var c: amqp.ConnState, n: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  match c.broken {
    Some(e) => return Err(e)
    None => {}
  }
  let k = match c.clock {
    Some(k) => k
    None => {
      while c.buf.len() < n {
        match t_read(c.link, 65536)? {
          Some(b) => c.buf = c.buf + b
          None => return Err(amqp.AmqpErr.Net(msg: "unexpected end of stream"))
        }
      }
      return Ok(())
    }
  }
  var wait_end = 0
  if c.timeout_ms > 0 { wait_end = k.now().unix_millis() + c.timeout_ms }
  while c.buf.len() < n {
    var at = wait_end
    if c.idle_timeout_ms > 0 { at = first_of(at, c.last_recv_ms + c.idle_timeout_ms) }
    if c.peer_idle_timeout_ms > 0 { at = first_of(at, c.last_send_ms + c.peer_idle_timeout_ms / 2) }
    let dl = if at > 0 { Some(Time.from_unix_millis(at)) } else { None }
    match t_read_dl(c.link, k, dl, 65536) {
      Ok(Some(b)) => {
        c.buf = c.buf + b
        c.last_recv_ms = k.now().unix_millis()
      }
      Ok(None) => return Err(amqp.AmqpErr.Net(msg: "unexpected end of stream"))
      Err(Timeout) => {
        let now = k.now().unix_millis()
        if c.idle_timeout_ms > 0 && now >= c.last_recv_ms + c.idle_timeout_ms {
          return Err(amqp.AmqpErr.Net(msg: "idle timeout: the peer sent nothing for ${c.idle_timeout_ms} ms"))
        }
        if wait_end > 0 && now >= wait_end { return Err(amqp.AmqpErr.Net(msg: "i/o timeout")) }
        if c.peer_idle_timeout_ms > 0 && now >= c.last_send_ms + c.peer_idle_timeout_ms / 2 {
          st_send(c, heartbeat_frame())?
        }
      }
      Err(e) => return Err(net_err(e))
    }
  }
  Ok(())
}

fn take(var c: amqp.ConnState, n: Int) -> Bytes ! amqp.AmqpErr uses (net.dial, clock) {
  fill(c, n)?
  let out = c.buf[0..n]
  c.buf = c.buf[n..]
  Ok(out)
}

fn st_send(var c: amqp.ConnState, f: amqp.Frame) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  match c.broken {
    Some(e) => return Err(e)
    None => {}
  }
  if c.closed { return Err(proto_err("the connection is closed")) }
  t_write(c.link, encode_frame(f)?)?
  match c.clock {
    Some(k) => { c.last_send_ms = k.now().unix_millis() }
    None => {}
  }
  Ok(())
}

fn read_frame(var c: amqp.ConnState) -> amqp.Frame ! amqp.AmqpErr uses (net.dial, clock) {
  fill(c, 4)?
  let size = get_be(c.buf, 0, 4)
  if size < 8 { return Err(dec_err("bad frame header")) }
  if size > c.max_frame_size { return Err(proto_err("frame of ${size} bytes is larger than the maximum frame size ${c.max_frame_size}")) }
  let raw = take(c, size)?
  let (f, _) = decode_frame(raw, c.max_frame_size)?
  Ok(f)
}

fn st_recv(var c: amqp.ConnState) -> amqp.Frame ! amqp.AmqpErr uses (net.dial, clock) {
  if c.mux { return Err(proto_err("recv is not available while the keepalive task reads the connection")) }
  if c.pending.len() > 0 {
    let f = c.pending[0]
    c.pending = c.pending[1..]
    return Ok(f)
  }
  read_frame(c)
}

fn proto_header(kind: Int) -> Bytes {
  var b = BytesBuilder.new()
  b.write(b"AMQP")
  b.write_byte(UInt8(kind))
  b.write_byte(UInt8(1))
  b.write_byte(UInt8(0))
  b.write_byte(UInt8(0))
  b.freeze()
}

/// Sends our protocol header and checks the peer answers with the same one.
fn exchange_header(var c: amqp.ConnState, kind: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  t_write(c.link, proto_header(kind))?
  let got = take(c, 8)?
  if got != proto_header(kind) {
    return Err(proto_err("unsupported protocol header ${got.to_hex()}"))
  }
  Ok(())
}

fn run_sasl(var c: amqp.ConnState, sasl: amqp.Sasl, hostname: Str) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  var mech = ""
  var initial = b""
  match sasl {
    None => return Ok(())
    Plain(user, password) => {
      mech = "PLAIN"
      var b = BytesBuilder.new()
      b.write_byte(UInt8(0))
      b.write(user.bytes())
      b.write_byte(UInt8(0))
      b.write(password.bytes())
      initial = b.freeze()
    }
    Anonymous => { mech = "ANONYMOUS" }
  }
  exchange_header(c, 3)?
  let first = read_frame(c)?
  match first.body {
    SaslMechanisms(m) => {
      if !m.mechanisms.contains(mech) {
        return Err(amqp.AmqpErr.Auth(code: -1, msg: "the server does not offer ${mech} (it offers ${m.mechanisms.join(", ")})"))
      }
    }
    _ => return Err(proto_err("expected sasl-mechanisms"))
  }
  st_send(c, amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.SaslInit(v: amqp.SaslInit{mechanism: mech, initial_response: initial, hostname: hostname})})?
  let out = read_frame(c)?
  match out.body {
    SaslOutcome(o) => {
      if Int(o.code) != 0 {
        return Err(amqp.AmqpErr.Auth(code: Int(o.code), msg: o.additional_data.to_str() ?? ""))
      }
    }
    SaslChallenge(_) => return Err(amqp.AmqpErr.Auth(code: -1, msg: "the server sent a SASL challenge, which ${mech} does not use"))
    _ => return Err(proto_err("expected sasl-outcome"))
  }
  Ok(())
}

fn dial(net: Net, addr: Str, opts: amqp.ConnOptions = amqp.ConnOptions{}) -> amqp.Connection ! amqp.AmqpErr uses (net.dial, clock) {
  if opts.max_frame_size < 512 { return Err(proto_err("max_frame_size must be at least 512")) }
  let (host, hostport, secure) = parse_addr(addr)
  let raw = if opts.timeout_ms > 0 {
    net.dial_timeout(hostport, Duration.from_millis(opts.timeout_ms)).map_err(net_err)?
  } else {
    net.dial(hostport).map_err(net_err)?
  }
  let link = if secure {
    amqp.Transport.Tls(t: tls.client(raw, if opts.hostname == "" { host } else { opts.hostname }, roots: opts.tls_roots, verify: opts.tls_verify).map_err(net_err)?)
  } else {
    amqp.Transport.Plain(c: raw)
  }
  if opts.clock is None && (opts.timeout_ms > 0 || opts.idle_timeout_ms > 0) {
    t_close(link)
    return Err(proto_err("timeout_ms and idle_timeout_ms need ConnOptions.clock"))
  }
  var c = amqp.ConnState{link: link, max_frame_size: opts.max_frame_size, clock: opts.clock,
    timeout_ms: opts.timeout_ms, idle_timeout_ms: opts.idle_timeout_ms}
  match opts.clock {
    Some(k) => {
      c.last_recv_ms = k.now().unix_millis()
      c.last_send_ms = c.last_recv_ms
    }
    None => {}
  }
  let hostname = if opts.hostname == "" { host } else { opts.hostname }
  match handshake(c, opts, hostname) {
    Ok(_) => Ok(amqp.Connection{st: Mutex[amqp.ConnState].new(c)})
    Err(e) => {
      t_close(c.link)
      Err(e)
    }
  }
}

fn handshake(var c: amqp.ConnState, opts: amqp.ConnOptions, hostname: Str) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  run_sasl(c, opts.sasl, hostname)?
  exchange_header(c, 0)?
  let id = if opts.container_id == "" { "xo-amqp" } else { opts.container_id }
  st_send(c, amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Open(v: amqp.Open{
    container_id: id, hostname: hostname, max_frame_size: opts.max_frame_size,
    channel_max: opts.channel_max, idle_timeout_ms: opts.idle_timeout_ms / 2, properties: opts.properties})})?
  let f = read_frame(c)?
  match f.body {
    Open(o) => {
      c.peer_container_id = o.container_id
      c.peer_properties = o.properties
      if o.max_frame_size > 0 { c.peer_max_frame_size = o.max_frame_size }
      if o.channel_max < opts.channel_max { c.peer_channel_max = o.channel_max } else { c.peer_channel_max = opts.channel_max }
      c.peer_idle_timeout_ms = o.idle_timeout_ms
      Ok(())
    }
    Close(x) => {
      match x.error {
        Some(e) => Err(amqp.AmqpErr.Peer(error: e))
        None => Err(proto_err("the peer closed the connection during open"))
      }
    }
    _ => Err(proto_err("expected open"))
  }
}

fn st_close(var c: amqp.ConnState, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  if c.closed { return Ok(()) }
  st_send(c, amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Close(v: amqp.Close{error: error})})?
  c.closed = true
  var result: amqp.AmqpErr? = None
  while true {
    let f = match read_frame(c) {
      Ok(f) => f
      Err(_) => break
    }
    match f.body {
      Close(x) => {
        match x.error {
          Some(e) => { result = Some(amqp.AmqpErr.Peer(error: e)) }
          None => {}
        }
        break
      }
      _ => {}
    }
  }
  t_close(c.link)
  match result {
    Some(e) => Err(e)
    None => Ok(())
  }
}

fn st_abort(var c: amqp.ConnState) {
  c.closed = true
  t_close(c.link)
}

/// Sends the Begin on channel `ch` and reserves the channel (in the same critical section that
/// picked it, so concurrent begins get distinct channels); a failure gives it back.
fn begin_send(var c: amqp.ConnState, ch: Int, opts: amqp.SessionOptions) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  c.channels.push(ch)
  match begin_send_frame(c, ch, opts) {
    Ok(_) => Ok(())
    Err(e) => {
      release_channel(c, ch)
      Err(e)
    }
  }
}

fn release_channel(var c: amqp.ConnState, ch: Int) {
  c.channels = c.channels.filter(fn(n: Int) { n != ch })
}

fn begin_send_frame(var c: amqp.ConnState, ch: Int, opts: amqp.SessionOptions) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  st_send(c, amqp.Frame{channel: UInt16.wrapping_from(ch), body: amqp.FrameBody.Begin(v: amqp.Begin{
    remote_channel: None, next_outgoing_id: UInt32(0),
    incoming_window: UInt32.wrapping_from(opts.incoming_window), outgoing_window: UInt32.wrapping_from(opts.outgoing_window),
    handle_max: opts.handle_max})})
}

fn begin_done(var c: amqp.ConnState, ch: Int, b: amqp.Begin, opts: amqp.SessionOptions) -> amqp.Session {
  c.sess.push(amqp.SessState{channel: ch, next_incoming_id: Int(b.next_outgoing_id), incoming_window: opts.incoming_window,
    initial_incoming_window: opts.incoming_window, remote_incoming_window: Int(b.incoming_window)})
  let rc = match b.remote_channel {
    Some(x) => Int(x)
    None => 0
  }
  amqp.Session{channel: ch, remote_channel: rc,
    remote_incoming_window: Int(b.incoming_window), remote_outgoing_window: Int(b.outgoing_window),
    remote_next_outgoing_id: Int(b.next_outgoing_id), incoming_window: opts.incoming_window,
    outgoing_window: opts.outgoing_window, handle_max: opts.handle_max, remote_handle_max: b.handle_max}
}

/// Takes the first queued frame on channel `ch` that is a Begin (`want_begin`) or an End.
fn pending_take(var c: amqp.ConnState, ch: Int, want_begin: Bool) -> amqp.Frame? {
  var i = 0
  while i < c.pending.len() {
    let f = c.pending[i]
    let hit = Int(f.channel) == ch && match f.body {
      Begin(_) => want_begin
      End(_) => !want_begin
      _ => false
    }
    if hit {
      c.pending = c.pending.filter(fn(g: amqp.Frame) { g != f })
      return Some(f)
    }
    i += 1
  }
  None
}

/// Waits (with the reader task) for the peer's Begin on `ch`.
fn step_begin(var c: amqp.ConnState, ch: Int, opts: amqp.SessionOptions) -> amqp.Session? ! amqp.AmqpErr uses (net.dial, clock) {
  match pending_take(c, ch, true) {
    Some(f) => {
      match f.body {
        Begin(b) => return Ok(Some(begin_done(c, ch, b, opts)))
        _ => {}
      }
    }
    None => {}
  }
  match pending_take(c, ch, false) {
    Some(f) => {
      match f.body {
        End(x) => {
          match x.error {
            Some(e) => {
              release_channel(c, ch)
              return Err(amqp.AmqpErr.Peer(error: e))
            }
            None => {
              release_channel(c, ch)
              return Err(proto_err("the peer ended the session during begin"))
            }
          }
        }
        _ => {}
      }
    }
    None => {}
  }
  Ok(None)
}

fn free_channel(c: amqp.ConnState) -> Int ! amqp.AmqpErr {
  var ch = 0
  while c.channels.contains(ch) { ch += 1 }
  if ch > c.peer_channel_max { return Err(proto_err("no free channel (channel-max ${c.peer_channel_max})")) }
  Ok(ch)
}

fn st_begin(var c: amqp.ConnState, opts: amqp.SessionOptions = amqp.SessionOptions{}) -> amqp.Session ! amqp.AmqpErr uses (net.dial, clock) {
  let ch = free_channel(c)?
  match st_begin_on(c, ch, opts) {
    Ok(z) => Ok(z)
    Err(e) => {
      release_channel(c, ch)
      Err(e)
    }
  }
}

fn st_begin_on(var c: amqp.ConnState, ch: Int, opts: amqp.SessionOptions) -> amqp.Session ! amqp.AmqpErr uses (net.dial, clock) {
  begin_send(c, ch, opts)?
  if c.mux { return Err(proto_err("internal: begin read the transport while the keepalive task owns it")) }
  while true {
    let f = read_frame(c)?
    match f.body {
      Begin(b) => {
        if Int(f.channel) != ch {
          c.pending.push(f)
        } else {
          return Ok(begin_done(c, ch, b, opts))
        }
      }
      End(x) => {
        if Int(f.channel) == ch {
          match x.error {
            Some(e) => return Err(amqp.AmqpErr.Peer(error: e))
            None => return Err(proto_err("the peer ended the session during begin"))
          }
        }
        c.pending.push(f)
      }
      Close(x) => {
        match x.error {
          Some(e) => return Err(amqp.AmqpErr.Peer(error: e))
          None => return Err(proto_err("the peer closed the connection"))
        }
      }
      Empty => {}
      _ => { c.pending.push(f) }
    }
  }
  Err(proto_err("unreachable"))
}

/// Waits (with the reader task) for the peer's End of session `s`.
fn step_end_session(var c: amqp.ConnState, s: amqp.Session) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) {
  match pending_take(c, s.channel, false) {
    Some(f) => {
      match f.body {
        End(x) => {
          c.channels = c.channels.filter(fn(n: Int) { n != s.channel })
          c.sess = c.sess.filter(fn(z: amqp.SessState) { z.channel != s.channel })
          match x.error {
            Some(e) => return Err(amqp.AmqpErr.Peer(error: e))
            None => return Ok(Some(true))
          }
        }
        _ => {}
      }
    }
    None => {}
  }
  Ok(None)
}

fn st_end_session(var c: amqp.ConnState, s: amqp.Session, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  st_send(c, amqp.Frame{channel: UInt16.wrapping_from(s.channel), body: amqp.FrameBody.End(v: amqp.End{error: error})})?
  if c.mux { return Err(proto_err("internal: end read the transport while the keepalive task owns it")) }
  while true {
    let f = read_frame(c)?
    match f.body {
      End(x) => {
        if Int(f.channel) == s.channel {
          c.channels = c.channels.filter(fn(n: Int) { n != s.channel })
          c.sess = c.sess.filter(fn(z: amqp.SessState) { z.channel != s.channel })
          match x.error {
            Some(e) => return Err(amqp.AmqpErr.Peer(error: e))
            None => return Ok(())
          }
        }
        c.pending.push(f)
      }
      Close(x) => {
        match x.error {
          Some(e) => return Err(amqp.AmqpErr.Peer(error: e))
          None => return Err(proto_err("the peer closed the connection"))
        }
      }
      Empty => {}
      _ => { c.pending.push(f) }
    }
  }
  Err(proto_err("unreachable"))
}

// Each call runs on the connection's state under its lock. The state keeps the call's writes when it
// fails (a failed call has still consumed bytes), so the error travels out of `with` as a value.

fn connection_send(c: amqp.Connection, f: amqp.Frame) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let e = c.st.with(fn(var s: amqp.ConnState) -> amqp.AmqpErr? uses (net.dial, clock) {
    match st_send(s, f) {
      Ok(_) => None
      Err(x) => Some(x)
    }
  })
  match e {
    Some(x) => Err(x)
    None => Ok(())
  }
}

fn connection_recv(c: amqp.Connection) -> amqp.Frame ! amqp.AmqpErr uses (net.dial, clock) {
  let r = c.st.with(fn(var s: amqp.ConnState) -> (amqp.Frame?, amqp.AmqpErr?) uses (net.dial, clock) {
    match st_recv(s) {
      Ok(f) => (Some(f), None)
      Err(x) => (None, Some(x))
    }
  })
  match r.1 {
    Some(x) => Err(x)
    None => {
      match r.0 {
        Some(f) => Ok(f)
        None => Err(proto_err("no frame"))
      }
    }
  }
}

fn connection_close(c: amqp.Connection, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  // 0: done (the result is in .1), 1: the reader task is running and our Close is out
  let r = c.st.with(fn(var s: amqp.ConnState) -> (Int, amqp.AmqpErr?) uses (net.dial, clock) {
    if s.closed { return (0, None) }
    if !s.mux {
      match st_close(s, error) {
        Ok(_) => return (0, None)
        Err(x) => return (0, Some(x))
      }
    }
    match st_send(s, amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Close(v: amqp.Close{error: error})}) {
      Ok(_) => {}
      Err(_) => {
        s.closed = true
        t_close(s.link)
        return (0, None)
      }
    }
    s.closing = true
    s.closed = true
    (1, None)
  })
  if r.0 == 0 { return fin_unit(r.1) }
  let done = await_cond(c, 0, fn(var s: amqp.ConnState) -> (amqp.AmqpErr?)? ! amqp.AmqpErr uses (net.dial, clock) {
    if s.close_done || !s.mux {
      t_close(s.link)
      return Ok(Some(s.close_err))
    }
    Ok(None)
  })?
  fin_unit(done)
}

fn connection_abort(c: amqp.Connection) {
  c.st.with(fn(var s: amqp.ConnState) { st_abort(s) })
}

fn connection_begin(c: amqp.Connection, opts: amqp.SessionOptions = amqp.SessionOptions{}) -> amqp.Session ! amqp.AmqpErr uses (net.dial, clock) {
  // with the reader task running only the Begin is sent here; otherwise the whole exchange runs
  let r = c.st.with(fn(var s: amqp.ConnState) -> (amqp.Session?, Int, amqp.AmqpErr?) uses (net.dial, clock) {
    if s.mux {
      match free_channel(s) {
        Ok(ch) => {
          match begin_send(s, ch, opts) {
            Ok(_) => return (None, ch, None)
            Err(x) => return (None, -1, Some(x))
          }
        }
        Err(x) => return (None, -1, Some(x))
      }
    }
    match st_begin(s, opts) {
      Ok(x) => (Some(x), -1, None)
      Err(x) => (None, -1, Some(x))
    }
  })
  match r.2 {
    Some(x) => return Err(x)
    None => {}
  }
  match r.0 {
    Some(x) => return Ok(x)
    None => {}
  }
  let ch = r.1
  await_cond(c, 0, fn(var s: amqp.ConnState) -> amqp.Session? ! amqp.AmqpErr uses (net.dial, clock) { step_begin(s, ch, opts) })
}

fn connection_end_session(c: amqp.Connection, sess: amqp.Session, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  // true: the reader task is running and only the End was sent here
  let r = c.st.with(fn(var s: amqp.ConnState) -> (Bool, amqp.AmqpErr?) uses (net.dial, clock) {
    if s.mux {
      match st_send(s, amqp.Frame{channel: UInt16.wrapping_from(sess.channel), body: amqp.FrameBody.End(v: amqp.End{error: error})}) {
        Ok(_) => return (true, None)
        Err(x) => return (false, Some(x))
      }
    }
    match st_end_session(s, sess, error) {
      Ok(_) => (false, None)
      Err(x) => (false, Some(x))
    }
  })
  if !r.0 { return fin_unit(r.1) }
  await_cond(c, 0, fn(var s: amqp.ConnState) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) { step_end_session(s, sess) })?
  Ok(())
}

/// The reader task of a connection with a keepalive: it owns the transport read (the lock is held
/// only to apply a frame, never while waiting for bytes), keeps a heartbeat going, fails the
/// connection when the peer is silent, and wakes the calls waiting on their own channels.
/// On the way out it hands the unused bytes back to the connection.
fn mux_loop(c: amqp.Connection, k: Clock, link: amqp.Transport, start: Bytes, idle: Int, peer: Int, max_frame: Int) uses (net.dial, clock) {
  var buf = start
  var last_recv = k.now().unix_millis()
  var failure: amqp.AmqpErr? = None
  var stop = false
  while !stop && failure is None {
    var size = 0
    if buf.len() >= 4 {
      size = get_be(buf, 0, 4)
      if size < 8 {
        failure = Some(dec_err("bad frame header"))
        break
      }
      if size > max_frame {
        failure = Some(proto_err("frame of ${size} bytes is larger than the maximum frame size ${max_frame}"))
        break
      }
    }
    if size > 0 && buf.len() >= size {
      let raw = buf[0..size]
      buf = buf[size..]
      let f = match decode_frame(raw, max_frame) {
        Ok(x) => x.0
        Err(e) => {
          failure = Some(e)
          break
        }
      }
      let is_close = match f.body {
        Close(_) => true
        _ => false
      }
      let seen = last_recv
      stop = c.st.with(fn(var s: amqp.ConnState) -> Bool uses (net.dial, clock) {
        s.last_recv_ms = seen
        var done = false
        match apply_frame(s, f) {
          Ok(_) => {}
          Err(e) => {
            done = true
            if is_close && s.closing {
              s.close_done = true
              match e {
                Peer(_) => { s.close_err = Some(e) }
                _ => {}
              }
            } else {
              s.broken = Some(e)
            }
          }
        }
        notify_waiters(s)
        done
      })
      continue
    }
    var at = 0
    if idle > 0 { at = first_of(at, last_recv + idle) }
    if peer > 0 {
      let ls = c.st.with_read(fn(s: amqp.ConnState) -> Int { s.last_send_ms })
      at = first_of(at, ls + peer / 2)
    }
    let dl = if at > 0 { Some(Time.from_unix_millis(at)) } else { None }
    match t_read_dl(link, k, dl, 65536) {
      Ok(Some(b)) => {
        buf = buf + b
        last_recv = k.now().unix_millis()
      }
      Ok(None) => { failure = Some(amqp.AmqpErr.Net(msg: "unexpected end of stream")) }
      Err(Timeout) => {
        let now = k.now().unix_millis()
        if idle > 0 && now >= last_recv + idle {
          failure = Some(amqp.AmqpErr.Net(msg: "idle timeout: the peer sent nothing for ${idle} ms"))
        } else if peer > 0 {
          let dead = c.st.with(fn(var s: amqp.ConnState) -> Bool uses (net.dial, clock) {
            if s.closed || now < s.last_send_ms + peer / 2 { return false }
            match st_send(s, heartbeat_frame()) {
              Ok(_) => false
              Err(x) => {
                s.broken = Some(x)
                true
              }
            }
          })
          if dead { stop = true }
        }
      }
      Err(e) => { failure = Some(net_err(e)) }
    }
  }
  mux_exit(c, failure, buf)
}

/// The reader task's last act: records why it stopped (a quiet stop after Close is no failure),
/// hands the unused bytes back and wakes everyone.
fn mux_exit(c: amqp.Connection, why: amqp.AmqpErr?, rest: Bytes) {
  c.st.with(fn(var s: amqp.ConnState) {
    match why {
      Some(e) => {
        if !s.closed && s.broken is None { s.broken = Some(e) }
      }
      None => {}
    }
    s.mux = false
    s.buf = rest + s.buf
    notify_waiters(s)
  })
}

fn connection_keepalive(c: amqp.Connection, g: task.Group) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let st = c.st.with(fn(var s: amqp.ConnState) -> (Clock?, amqp.Transport, Bytes, Int, Int, Int) uses (net.dial, clock) {
    if s.clock is None { return (None, s.link, b"", 0, 0, 0) }
    if s.mux || s.closed { return (None, s.link, b"", 0, 0, 0) }
    s.mux = true
    let start = s.buf
    s.buf = b""
    (s.clock, s.link, start, s.idle_timeout_ms, s.peer_idle_timeout_ms, s.max_frame_size)
  })
  match st.0 {
    None => Err(proto_err("keepalive needs ConnOptions.clock and an open connection without one running"))
    Some(k) => {
      g.spawn_background(fn() uses (net.dial, clock) { mux_loop(c, k, st.1, st.2, st.3, st.4, st.5) })
      Ok(())
    }
  }
}

fn connection_peer_container_id(c: amqp.Connection) -> Str { c.st.with_read(fn(s: amqp.ConnState) -> Str { s.peer_container_id }) }

fn connection_peer_max_frame_size(c: amqp.Connection) -> Int { c.st.with_read(fn(s: amqp.ConnState) -> Int { s.peer_max_frame_size }) }

fn connection_peer_channel_max(c: amqp.Connection) -> Int { c.st.with_read(fn(s: amqp.ConnState) -> Int { s.peer_channel_max }) }

fn connection_peer_idle_timeout_ms(c: amqp.Connection) -> Int { c.st.with_read(fn(s: amqp.ConnState) -> Int { s.peer_idle_timeout_ms }) }

fn connection_peer_properties(c: amqp.Connection) -> List[(Str, amqp.Value)] { c.st.with_read(fn(s: amqp.ConnState) -> List[(Str, amqp.Value)] { s.peer_properties }) }

// ---------------------------------------------------------------------------
// Stage 2c: messages

fn vtext(s: Str?) -> amqp.Value {
  match s {
    Some(x) => amqp.Value.Str(v: x)
    None => amqp.Value.Null
  }
}

fn vsymo(s: Str?) -> amqp.Value {
  match s {
    Some(x) => amqp.Value.Symbol(v: x)
    None => amqp.Value.Null
  }
}

fn vtime(t: Int?) -> amqp.Value {
  match t {
    Some(x) => amqp.Value.Timestamp(ms: x)
    None => amqp.Value.Null
  }
}

fn section(code: Int, v: amqp.Value) -> amqp.Value {
  amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64.from_bits(code)), value: v)
}

fn put_section(out: BytesBuilder, code: Int, v: amqp.Value) -> BytesBuilder ! amqp.AmqpErr {
  put_value(out, section(code, v))
}

fn encode_message(m: amqp.Message) -> Bytes ! amqp.AmqpErr {
  var out = BytesBuilder.new()
  match m.header {
    Some(h) => {
      out = put_value(out, composite(0x70, [
        amqp.Value.Bool(v: h.durable),
        if h.priority == 4 { amqp.Value.Null } else { amqp.Value.UByte(v: UInt8.wrapping_from(h.priority)) },
        if h.ttl_ms == 0 { amqp.Value.Null } else { amqp.Value.UInt(v: UInt32.wrapping_from(h.ttl_ms)) },
        vbool(h.first_acquirer),
        if h.delivery_count == 0 { amqp.Value.Null } else { amqp.Value.UInt(v: UInt32.wrapping_from(h.delivery_count)) },
      ]))?
    }
    None => {}
  }
  match m.delivery_annotations {
    Some(p) => { out = put_section(out, 0x71, amqp.Value.Map(pairs: p))? }
    None => {}
  }
  match m.annotations {
    Some(p) => { out = put_section(out, 0x72, amqp.Value.Map(pairs: p))? }
    None => {}
  }
  match m.properties {
    Some(p) => {
      out = put_value(out, composite(0x73, [
        p.message_id, vbin(p.user_id), vtext(p.to), vtext(p.subject), vtext(p.reply_to), p.correlation_id,
        vsymo(p.content_type), vsymo(p.content_encoding), vtime(p.absolute_expiry_ms), vtime(p.creation_ms),
        vtext(p.group_id),
        match p.group_sequence {
          Some(n) => amqp.Value.UInt(v: UInt32.wrapping_from(n))
          None => amqp.Value.Null
        },
        vtext(p.reply_to_group_id),
      ]))?
    }
    None => {}
  }
  match m.app_properties {
    Some(p) => {
      var pairs: List[(amqp.Value, amqp.Value)] = []
      for (k, v) in p { pairs.push((amqp.Value.Str(v: k), v)) }
      out = put_section(out, 0x74, amqp.Value.Map(pairs: pairs))?
    }
    None => {}
  }
  match m.body {
    Empty => {}
    Data(sections) => {
      for d in sections { out = put_section(out, 0x75, amqp.Value.Binary(v: d))? }
    }
    Value(v) => { out = put_section(out, 0x77, v)? }
    Sequence(sections) => {
      for s in sections { out = put_section(out, 0x76, amqp.Value.List(items: s))? }
    }
  }
  match m.footer {
    Some(p) => { out = put_section(out, 0x78, amqp.Value.Map(pairs: p))? }
    None => {}
  }
  Ok(out.freeze())
}

fn want_pairs(v: amqp.Value) -> List[(amqp.Value, amqp.Value)] ! amqp.AmqpErr {
  match v {
    Map(p) => Ok(p)
    _ => Err(dec_err("expected a map"))
  }
}

fn want_strv(v: amqp.Value) -> Str? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    Str(s) => Ok(Some(s))
    Symbol(s) => Ok(Some(s))
    _ => Err(dec_err("expected a string"))
  }
}

fn want_timev(v: amqp.Value) -> Int? ! amqp.AmqpErr {
  match v {
    Null => Ok(None)
    Timestamp(ms) => Ok(Some(ms))
    _ => Err(dec_err("expected a timestamp"))
  }
}

fn decode_message(b: Bytes) -> amqp.Message ! amqp.AmqpErr {
  var header: amqp.Header? = None
  var dann: List[(amqp.Value, amqp.Value)]? = None
  var ann: List[(amqp.Value, amqp.Value)]? = None
  var props: amqp.Properties? = None
  var app: List[(Str, amqp.Value)]? = None
  var footer: List[(amqp.Value, amqp.Value)]? = None
  var data: List[Bytes] = []
  var seq: List[List[amqp.Value]] = []
  var value: amqp.Value? = None
  var kinds = 0
  var pos = 0
  while pos < b.len() {
    let (v, n) = get_value(b, pos, 0)?
    pos = n
    let (c, f) = match v {
      Described(d, body) => {
        match d {
          ULong(x) => (x.to_bits(), body)
          _ => return Err(dec_err("a section needs a ulong descriptor"))
        }
      }
      _ => return Err(dec_err("a message section must be described"))
    }
    if c == 0x70 {
      if header is Some(..) { return Err(dec_err("a second header section")) }
      let items = match f {
        List(i) => i
        _ => return Err(dec_err("the header must be a list"))
      }
      var pri = 4
      match at(items, 1) {
        Null => {}
        x => { pri = want_int(x, 4)? }
      }
      header = Some(amqp.Header{durable: want_bool(at(items, 0))?, priority: pri, ttl_ms: want_int(at(items, 2), 0)?,
        first_acquirer: want_bool(at(items, 3))?, delivery_count: want_int(at(items, 4), 0)?})
    } else if c == 0x71 {
      dann = Some(want_pairs(f)?)
    } else if c == 0x72 {
      ann = Some(want_pairs(f)?)
    } else if c == 0x73 {
      if props is Some(..) { return Err(dec_err("a second properties section")) }
      let items = match f {
        List(i) => i
        _ => return Err(dec_err("the properties must be a list"))
      }
      var ub = b""
      match at(items, 1) {
        Null => {}
        Binary(x) => { ub = x }
        _ => return Err(dec_err("user-id must be binary"))
      }
      var gs: Int? = None
      match at(items, 11) {
        Null => {}
        x => { gs = Some(want_int(x, 0)?) }
      }
      props = Some(amqp.Properties{message_id: at(items, 0), user_id: ub, to: want_strv(at(items, 2))?,
        subject: want_strv(at(items, 3))?, reply_to: want_strv(at(items, 4))?, correlation_id: at(items, 5),
        content_type: want_strv(at(items, 6))?, content_encoding: want_strv(at(items, 7))?,
        absolute_expiry_ms: want_timev(at(items, 8))?, creation_ms: want_timev(at(items, 9))?,
        group_id: want_strv(at(items, 10))?, group_sequence: gs, reply_to_group_id: want_strv(at(items, 12))?})
    } else if c == 0x74 {
      var out: List[(Str, amqp.Value)] = []
      for (k, x) in want_pairs(f)? { out.push((want_str(k)?, x)) }
      app = Some(out)
    } else if c == 0x75 {
      if kinds != 0 && kinds != 1 { return Err(dec_err("mixed body sections")) }
      kinds = 1
      match f {
        Binary(x) => { data.push(x) }
        _ => return Err(dec_err("a data section must be binary"))
      }
    } else if c == 0x76 {
      if kinds != 0 && kinds != 2 { return Err(dec_err("mixed body sections")) }
      kinds = 2
      match f {
        List(i) => { seq.push(i) }
        _ => return Err(dec_err("a sequence section must be a list"))
      }
    } else if c == 0x77 {
      if kinds != 0 { return Err(dec_err("mixed body sections")) }
      kinds = 3
      value = Some(f)
    } else if c == 0x78 {
      footer = Some(want_pairs(f)?)
    } else {
      return Err(dec_err("unknown message section"))
    }
  }
  var body = amqp.Body.Empty
  if kinds == 1 { body = amqp.Body.Data(sections: data) }
  if kinds == 2 { body = amqp.Body.Sequence(sections: seq) }
  match value {
    Some(v) => { body = amqp.Body.Value(v: v) }
    None => {}
  }
  Ok(amqp.Message{header: header, delivery_annotations: dann, annotations: ann, properties: props,
    app_properties: app, body: body, footer: footer})
}

// ---------------------------------------------------------------------------
// Stage 3: links

fn m32(x: Int) -> Int { x & 4294967295 }

fn u32w(x: Int) -> UInt32 { UInt32.wrapping_from(m32(x)) }

fn ss_idx(c: amqp.ConnState, ch: Int) -> Int {
  var i = 0
  while i < c.sess.len() {
    if c.sess[i].channel == ch { return i }
    i += 1
  }
  -1
}

fn lk_remote(c: amqp.ConnState, ch: Int, h: Int) -> Int {
  var i = 0
  while i < c.links.len() {
    if c.links[i].channel == ch && c.links[i].remote_handle == h { return i }
    i += 1
  }
  -1
}

fn lk_named(c: amqp.ConnState, ch: Int, name: Str) -> Int {
  var i = 0
  while i < c.links.len() {
    if c.links[i].channel == ch && c.links[i].name == name && !c.links[i].attached { return i }
    i += 1
  }
  -1
}

fn put_link(var c: amqp.ConnState, l: amqp.LinkState) { c.links[l.id] = l }

fn put_sess(var c: amqp.ConnState, i: Int, z: amqp.SessState) { c.sess[i] = z }

fn frame_on(ch: Int, body: amqp.FrameBody) -> amqp.Frame {
  amqp.Frame{channel: UInt16.wrapping_from(ch), body: body}
}

/// A session Flow after the incoming window was used up.
fn send_session_flow(var c: amqp.ConnState, i: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let z = c.sess[i]
  st_send(c, frame_on(z.channel, amqp.FrameBody.Flow(v: amqp.Flow{
    next_incoming_id: Some(u32w(z.next_incoming_id)), incoming_window: u32w(z.incoming_window),
    next_outgoing_id: u32w(z.next_outgoing_id), outgoing_window: u32w(2048), handle: None, delivery_count: None,
    link_credit: None, available: None})))
}

/// A link Flow granting the receiver's credit.
fn send_link_flow(var c: amqp.ConnState, id: Int, drain: Bool = false) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let l = c.links[id]
  let z = c.sess[ss_idx(c, l.channel)]
  st_send(c, frame_on(l.channel, amqp.FrameBody.Flow(v: amqp.Flow{
    next_incoming_id: Some(u32w(z.next_incoming_id)), incoming_window: u32w(z.incoming_window),
    next_outgoing_id: u32w(z.next_outgoing_id), outgoing_window: u32w(2048), handle: Some(u32w(l.handle)),
    delivery_count: Some(u32w(l.delivery_count)), link_credit: Some(u32w(l.credit)), available: None, drain: drain})))
}

fn peer_err(e: amqp.WireError?, what: Str) -> amqp.AmqpErr {
  match e {
    Some(x) => amqp.AmqpErr.Peer(error: x)
    None => proto_err(what)
  }
}

/// Wakes every call waiting for a frame to be applied. The caller holds the lock.
fn notify_waiters(var c: amqp.ConnState) {
  for w in c.waiters {
    // a full channel already holds a wake-up
    let _ = w.try_send(true)
  }
  c.waiters = []
}

/// Runs `step` under the lock until it returns a value. A step that is not done registers the call
/// as a waiter (with the reader task running: the call then waits on its own channel, outside the
/// lock, with its own deadline) or reads and applies one frame itself (no reader task). A step
/// must be safe to run again. `timeout_ms` bounds the whole wait, 0 for none.
fn await_cond[R](c: amqp.Connection, timeout_ms: Int, step: fn(var amqp.ConnState) -> R? ! amqp.AmqpErr uses (net.dial, clock)) -> R ! amqp.AmqpErr uses (net.dial, clock) {
  var end_ms = 0
  var kk: Clock? = None
  if timeout_ms > 0 {
    match c.st.with_read(fn(s: amqp.ConnState) -> Clock? { s.clock }) {
      Some(k) => {
        kk = Some(k)
        end_ms = k.now().unix_millis() + timeout_ms
      }
      None => return Err(proto_err("a receive timeout needs ConnOptions.clock"))
    }
  }
  while true {
    let r = c.st.with(fn(var s: amqp.ConnState) -> (R?, amqp.AmqpErr?, Chan[Bool]?) uses (net.dial, clock) {
      match step(s) {
        Ok(Some(v)) => return (Some(v), None, None)
        Ok(None) => {}
        Err(e) => return (None, Some(e), None)
      }
      match s.broken {
        Some(e) => return (None, Some(e), None)
        None => {}
      }
      var left = 0
      if end_ms > 0 {
        match s.clock {
          Some(k) => {
            left = end_ms - k.now().unix_millis()
            if left <= 0 { return (None, Some(amqp.AmqpErr.Net(msg: "i/o timeout")), None) }
          }
          None => {}
        }
      }
      if s.mux {
        let w = Chan[Bool].new(cap: 1)
        s.waiters.push(w)
        return (None, None, Some(w))
      }
      let saved = s.timeout_ms
      if left > 0 { s.timeout_ms = left }
      let pr = pump(s)
      s.timeout_ms = saved
      match pr {
        Ok(_) => (None, None, None)
        Err(e) => (None, Some(e), None)
      }
    })
    match r.1 {
      Some(e) => return Err(e)
      None => {}
    }
    match r.0 {
      Some(v) => return Ok(v)
      None => {}
    }
    match r.2 {
      Some(w) => {
        match kk {
          Some(k) => {
            let left = end_ms - k.now().unix_millis()
            if left > 0 {
              select {
                _ = w.recv() => {}
                after 1ms * left => {}
              }
            }
          }
          None => { let _ = w.recv() }
        }
      }
      None => {}
    }
  }
  Err(proto_err("unreachable"))
}

/// Reads one frame (queued ones first) and applies it to the sessions and links.
fn pump(var c: amqp.ConnState) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  if c.mux { return Err(proto_err("internal: a call read the transport while the keepalive task owns it")) }
  let f = if c.pending.len() > 0 { take_pending(c) } else { read_frame(c)? }
  apply_frame(c, f)
}

/// Applies one frame to the sessions and links (the reader task calls it under the lock).
fn apply_frame(var c: amqp.ConnState, f: amqp.Frame) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let ch = Int(f.channel)
  match f.body {
    Flow(x) => {
      let si = ss_idx(c, ch)
      if si < 0 { return Ok(()) }
      var z = c.sess[si]
      let nin = match x.next_incoming_id {
        Some(n) => Int(n)
        None => 0
      }
      z.remote_incoming_window = m32(nin + Int(x.incoming_window) - z.next_outgoing_id)
      put_sess(c, si, z)
      match x.handle {
        Some(h) => {
          let li = lk_remote(c, ch, Int(h))
          if li >= 0 {
            var l = c.links[li]
            match l.role {
              Sender => {
                let dc = match x.delivery_count {
                  Some(n) => Int(n)
                  None => l.delivery_count
                }
                let lc = match x.link_credit {
                  Some(n) => Int(n)
                  None => 0
                }
                l.credit = m32(dc + lc - l.delivery_count)
                put_link(c, l)
                if x.echo { send_link_flow_sender(c, li)? }
              }
              Receiver => {
                // the sender's answer to our drain: it used or gave up the credit
                if x.drain && l.draining {
                  match x.delivery_count {
                    Some(n) => { l.delivery_count = Int(n) }
                    None => {}
                  }
                  l.credit = 0
                  l.draining = false
                  put_link(c, l)
                }
              }
            }
          }
        }
        None => {}
      }
    }
    Attach(x) => {
      let li = lk_named(c, ch, x.name)
      if li >= 0 {
        var l = c.links[li]
        l.remote_handle = Int(x.handle)
        l.remote_attach = Some(x)
        l.attached = true
        l.refused = match l.role {
          Sender => x.target is None
          Receiver => x.source is None
        }
        l.peer_max_message_size = x.max_message_size
        match l.role {
          Receiver => { l.delivery_count = x.initial_delivery_count }
          Sender => {}
        }
        put_link(c, l)
      }
    }
    Transfer(x) => {
      let li = lk_remote(c, ch, Int(x.handle))
      let si = ss_idx(c, ch)
      if li < 0 || si < 0 { return Ok(()) }
      var z = c.sess[si]
      z.incoming_window -= 1
      var l = c.links[li]
      match x.delivery_id {
        Some(id) => {
          z.next_incoming_id = m32(Int(id) + 1)
          if !l.partial_active {
            l.partial_active = true
            l.partial_id = Int(id)
            l.partial_tag = x.delivery_tag
            l.partial_settled = x.settled
            l.partial = b""
          }
        }
        None => {}
      }
      if x.aborted {
        l.partial_active = false
        l.partial = b""
      } else if l.partial_active {
        l.partial = l.partial + x.payload
        if x.settled { l.partial_settled = true }
        if !x.more {
          let m = decode_message(l.partial)?
          l.inbox.push(amqp.Delivery{message: m, id: l.partial_id, tag: l.partial_tag, settled: l.partial_settled, link: l.id})
          l.partial_active = false
          l.partial = b""
          l.delivery_count = m32(l.delivery_count + 1)
          l.credit -= 1
        }
      }
      put_link(c, l)
      if z.incoming_window < z.initial_incoming_window / 2 {
        z.incoming_window = z.initial_incoming_window
        put_sess(c, si, z)
        send_session_flow(c, si)?
      } else {
        put_sess(c, si, z)
      }
    }
    Disposition(x) => {
      match x.role {
        Receiver => {
          if x.settled {
            let lastid = match x.last {
              Some(n) => Int(n)
              None => Int(x.first)
            }
            var i = 0
            while i < c.links.len() {
              var l = c.links[i]
              if l.channel == ch && l.unsettled.len() > 0 {
                var keep: List[Int] = []
                for id in l.unsettled {
                  if id >= Int(x.first) && id <= lastid {
                    l.results.push((id, x.state))
                  } else {
                    keep.push(id)
                  }
                }
                l.unsettled = keep
                put_link(c, l)
              }
              i += 1
            }
          }
        }
        Sender => {
          // the peer's settlement of dispositions we sent unsettled (settle mode Second)
          let lastid = match x.last {
            Some(n) => Int(n)
            None => Int(x.first)
          }
          var i = 0
          while i < c.links.len() {
            var l = c.links[i]
            if l.channel == ch && l.waiting.len() > 0 {
              var keep: List[Int] = []
              for id in l.waiting {
                if id >= Int(x.first) && id <= lastid {
                  l.acks.push((id, x.state))
                } else {
                  keep.push(id)
                }
              }
              l.waiting = keep
              put_link(c, l)
            }
            i += 1
          }
        }
      }
    }
    Detach(x) => {
      let li = lk_remote(c, ch, Int(x.handle))
      if li >= 0 {
        var l = c.links[li]
        if !l.detached {
          l.detached = true
          l.error = x.error
          put_link(c, l)
          st_send(c, frame_on(ch, amqp.FrameBody.Detach(v: amqp.Detach{handle: u32w(l.handle), closed: x.closed, error: None})))?
        }
      }
    }
    End(x) => {
      if c.mux { c.pending.push(f) }
      let si = ss_idx(c, ch)
      if si >= 0 {
        var z = c.sess[si]
        z.ended = true
        put_sess(c, si, z)
        var i = 0
        while i < c.links.len() {
          var l = c.links[i]
          if l.channel == ch && !l.detached {
            l.detached = true
            l.error = x.error
            put_link(c, l)
          }
          i += 1
        }
      }
    }
    Close(x) => {
      c.closed = true
      return Err(peer_err(x.error, "the peer closed the connection"))
    }
    Begin(_) => { if c.mux { c.pending.push(f) } }
    _ => {}
  }
  Ok(())
}

fn take_pending(var c: amqp.ConnState) -> amqp.Frame {
  let f = c.pending[0]
  c.pending = c.pending[1..]
  f
}

/// A sender's Flow in answer to the peer's echo request.
fn send_link_flow_sender(var c: amqp.ConnState, id: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let l = c.links[id]
  let z = c.sess[ss_idx(c, l.channel)]
  st_send(c, frame_on(l.channel, amqp.FrameBody.Flow(v: amqp.Flow{
    next_incoming_id: Some(u32w(z.next_incoming_id)), incoming_window: u32w(z.incoming_window),
    next_outgoing_id: u32w(z.next_outgoing_id), outgoing_window: u32w(2048), handle: Some(u32w(l.handle)),
    delivery_count: Some(u32w(l.delivery_count)), link_credit: Some(u32w(0)), available: None})))
}

/// Fails when the link, its session or the connection is gone.
fn check_link(c: amqp.ConnState, id: Int) -> () ! amqp.AmqpErr {
  if c.closed { return Err(proto_err("the connection is closed")) }
  let l = c.links[id]
  if l.detached { return Err(peer_err(l.error, "the link was detached")) }
  let si = ss_idx(c, l.channel)
  if si < 0 || c.sess[si].ended { return Err(proto_err("the session has ended")) }
  Ok(())
}

fn new_link(var c: amqp.ConnState, s: amqp.Session, name: Str, role: amqp.Role) -> Int ! amqp.AmqpErr {
  let si = ss_idx(c, s.channel)
  if si < 0 { return Err(proto_err("unknown session")) }
  var z = c.sess[si]
  let h = z.next_handle
  z.next_handle += 1
  put_sess(c, si, z)
  let id = c.links.len()
  let nm = if name == "" { "xo-link-${id}" } else { name }
  c.links.push(amqp.LinkState{id: id, name: nm, channel: s.channel, handle: h, role: role})
  Ok(id)
}

/// Sets the receiver's outstanding credit to n and tells the peer.
fn grant_credit(var c: amqp.ConnState, id: Int, n: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  var l = c.links[id]
  l.credit = n
  put_link(c, l)
  send_link_flow(c, id)
}

fn tag_bytes(n: Int) -> Bytes {
  var b = BytesBuilder.new()
  b = be(b, m32(n), 4)
  b.freeze()
}

fn transfer_frame(l: amqp.LinkState, id: Int, tag: Bytes, first: Bool, settled: Bool, more: Bool, payload: Bytes, fmt: Int = 0) -> amqp.Frame {
  frame_on(l.channel, amqp.FrameBody.Transfer(v: amqp.Transfer{
    handle: u32w(l.handle), delivery_id: if first { Some(u32w(id)) } else { None },
    delivery_tag: if first { tag } else { b"" }, message_format: if first { Some(u32w(fmt)) } else { None },
    settled: settled, more: more, receiver_settle_mode: None, state: None, payload: payload}))
}

fn st_new_sender(var c: amqp.ConnState, s: amqp.Session, target: Str, opts: amqp.SenderOptions) -> Int ! amqp.AmqpErr uses (net.dial, clock) {
  let id = new_link(c, s, opts.name, amqp.Role.Sender)?
  let l = c.links[id]
  st_send(c, frame_on(s.channel, amqp.FrameBody.Attach(v: amqp.Attach{
    name: l.name, handle: u32w(l.handle), role: amqp.Role.Sender, sender_settle_mode: opts.settle_mode,
    receiver_settle_mode: None, source: Some(amqp.Source{address: opts.source, capabilities: opts.capabilities}),
    target: Some(amqp.Target{address: target, capabilities: opts.target_capabilities}),
    initial_delivery_count: 0, max_message_size: opts.max_message_size, properties: opts.properties})))?
  Ok(id)
}

fn st_new_receiver(var c: amqp.ConnState, s: amqp.Session, source: Str, opts: amqp.ReceiverOptions) -> Int ! amqp.AmqpErr uses (net.dial, clock) {
  let id = new_link(c, s, opts.name, amqp.Role.Receiver)?
  var l = c.links[id]
  l.credit_target = opts.credit
  l.second = match opts.settle_mode {
    Some(m) => m == amqp.ReceiverSettleMode.Second
    None => false
  }
  put_link(c, l)
  st_send(c, frame_on(s.channel, amqp.FrameBody.Attach(v: amqp.Attach{
    name: l.name, handle: u32w(l.handle), role: amqp.Role.Receiver, sender_settle_mode: opts.sender_settle_mode,
    receiver_settle_mode: opts.settle_mode,
    source: Some(amqp.Source{address: source, filter: opts.filters, capabilities: opts.source_capabilities}),
    target: Some(amqp.Target{address: opts.target, capabilities: opts.capabilities}),
    max_message_size: opts.max_message_size, properties: opts.properties})))?
  Ok(id)
}

/// Waits for the peer's Attach of link `id`.
fn step_attached(var c: amqp.ConnState, id: Int) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  let l = c.links[id]
  if l.attached && !l.refused { return Ok(Some(true)) }
  Ok(None)
}

/// Takes the session's send turn once the link has credit. Returns the transfer id, the tag and
/// the payload bytes per frame.
fn step_send_begin(var c: amqp.ConnState, id: Int, size: Int, fmt: Int) -> (Int, Bytes, Int)? ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  let l0 = c.links[id]
  if l0.peer_max_message_size > 0 && size > l0.peer_max_message_size {
    return Err(amqp.AmqpErr.Encode(msg: "the message is larger than the peer's maximum message size"))
  }
  if l0.credit <= 0 { return Ok(None) }
  let si = ss_idx(c, l0.channel)
  if c.sess[si].sending { return Ok(None) }
  var z = c.sess[si]
  z.sending = true
  put_sess(c, si, z)
  let tid = z.next_outgoing_id
  let tag = tag_bytes(l0.tag_counter)
  let probe = transfer_frame(l0, tid, tag, true, false, true, b"", fmt)
  var chunk = c.peer_max_frame_size - encode_frame(probe)?.len()
  if chunk < 1 { chunk = 1 }
  Ok(Some((tid, tag, chunk)))
}

/// Sends the frame of the payload that starts at `off` once the peer's window allows it; returns
/// where the next one starts.
fn step_send_chunk(var c: amqp.ConnState, id: Int, tid: Int, tag: Bytes, chunk: Int, payload: Bytes, off: Int, settled: Bool, fmt: Int) -> Int? ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  let l = c.links[id]
  let si = ss_idx(c, l.channel)
  if c.sess[si].remote_incoming_window <= 0 { return Ok(None) }
  var end = off + chunk
  if end > payload.len() { end = payload.len() }
  st_send(c, transfer_frame(l, tid, tag, off == 0, settled, end < payload.len(), payload[off..end], fmt))?
  var z = c.sess[si]
  z.remote_incoming_window -= 1
  put_sess(c, si, z)
  Ok(Some(end))
}

/// Ends the send turn; on success the delivery counts as sent.
fn st_send_done(var c: amqp.ConnState, id: Int, tid: Int, settled: Bool, sent: Bool) {
  var l = c.links[id]
  let si = ss_idx(c, l.channel)
  var z = c.sess[si]
  z.sending = false
  if sent {
    z.next_outgoing_id = m32(z.next_outgoing_id + 1)
    l.delivery_count = m32(l.delivery_count + 1)
    l.credit -= 1
    l.tag_counter += 1
    if !settled { l.unsettled.push(tid) }
    put_link(c, l)
  }
  put_sess(c, si, z)
  notify_waiters(c)
}

/// Waits for the peer's outcome of transfer `tid`.
fn step_result(var c: amqp.ConnState, id: Int, tid: Int) -> (amqp.DeliveryState?)? ! amqp.AmqpErr uses (net.dial, clock) {
  var r = c.links[id]
  var i = 0
  while i < r.results.len() {
    if r.results[i].0 == tid {
      let st = r.results[i].1
      r.results = r.results.filter(fn(p: (Int, amqp.DeliveryState?)) { p.0 != tid })
      put_link(c, r)
      return Ok(Some(st))
    }
    i += 1
  }
  check_link(c, id)?
  Ok(None)
}

/// One pass over a receiver: the next delivery, topping up credit as it goes.
fn step_receive(var c: amqp.ConnState, id: Int) -> amqp.Delivery? ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  var l = c.links[id]
  if l.inbox.len() > 0 {
    let d = l.inbox[0]
    l.inbox = l.inbox[1..]
    put_link(c, l)
    if l.credit <= l.credit_target / 2 {
      grant_credit(c, id, l.credit_target)?
    }
    return Ok(Some(d))
  }
  if l.credit <= 0 && l.credit_target > 0 {
    grant_credit(c, id, l.credit_target)?
  }
  Ok(None)
}

fn st_issue_credit(var c: amqp.ConnState, id: Int, n: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  var l = c.links[id]
  l.credit += n
  put_link(c, l)
  send_link_flow(c, id)
}

fn st_drain_begin(var c: amqp.ConnState, id: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  var l = c.links[id]
  l.draining = true
  put_link(c, l)
  send_link_flow(c, id, true)
}

fn step_drained(var c: amqp.ConnState, id: Int) -> List[amqp.Delivery]? ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  var l = c.links[id]
  if l.draining { return Ok(None) }
  let out = l.inbox
  l.inbox = []
  put_link(c, l)
  Ok(Some(out))
}

fn st_settle(var c: amqp.ConnState, id: Int, d: amqp.Delivery, state: amqp.DeliveryState) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  let l = c.links[id]
  if d.settled { return Ok(()) }
  if l.second {
    var z = l
    z.waiting.push(d.id)
    put_link(c, z)
    return st_send(c, frame_on(l.channel, amqp.FrameBody.Disposition(v: amqp.Disposition{
      role: amqp.Role.Receiver, first: u32w(d.id), last: None, settled: false, state: Some(state)})))
  }
  st_send(c, frame_on(l.channel, amqp.FrameBody.Disposition(v: amqp.Disposition{
    role: amqp.Role.Receiver, first: u32w(d.id), last: None, settled: true, state: Some(state)})))
}

/// The peer's answer to the unsettled disposition of delivery `did` (mode Second).
fn step_ack(var c: amqp.ConnState, id: Int, did: Int) -> (amqp.DeliveryState?)? ! amqp.AmqpErr uses (net.dial, clock) {
  check_link(c, id)?
  var l = c.links[id]
  var i = 0
  while i < l.acks.len() {
    if l.acks[i].0 == did {
      let st = l.acks[i].1
      var keep: List[(Int, amqp.DeliveryState?)] = []
      for a in l.acks {
        if a.0 != did { keep.push(a) }
      }
      l.acks = keep
      put_link(c, l)
      return Ok(Some(st))
    }
    i += 1
  }
  Ok(None)
}

/// Starts a link's close: sends Detach when the peer has not detached it yet.
fn st_link_close_begin(var c: amqp.ConnState, id: Int, error: amqp.WireError?) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let l = c.links[id]
  if !l.detached {
    st_send(c, frame_on(l.channel, amqp.FrameBody.Detach(v: amqp.Detach{handle: u32w(l.handle), closed: true, error: error})))?
  }
  Ok(())
}

fn step_detached(var c: amqp.ConnState, id: Int) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) {
  if c.links[id].detached { return Ok(Some(true)) }
  if c.closed { return Err(proto_err("the connection is closed")) }
  Ok(None)
}

fn fin_unit(e: amqp.AmqpErr?) -> () ! amqp.AmqpErr {
  match e {
    Some(x) => Err(x)
    None => Ok(())
  }
}

fn fin[T](v: T?, e: amqp.AmqpErr?) -> T ! amqp.AmqpErr {
  match e {
    Some(x) => Err(x)
    None => {
      match v {
        Some(y) => Ok(y)
        None => Err(proto_err("no result"))
      }
    }
  }
}

/// Runs `f` on the state under the lock; its error travels out of `with` as a value because the
/// state keeps the call's writes when it fails.
fn locked[R](c: amqp.Connection, f: fn(var amqp.ConnState) -> R ! amqp.AmqpErr uses (net.dial, clock)) -> R ! amqp.AmqpErr uses (net.dial, clock) {
  let r = c.st.with(fn(var z: amqp.ConnState) -> (R?, amqp.AmqpErr?) uses (net.dial, clock) {
    match f(z) {
      Ok(v) => (Some(v), None)
      Err(e) => (None, Some(e))
    }
  })
  fin(r.0, r.1)
}

fn connection_new_sender(c: amqp.Connection, s: amqp.Session, target: Str, opts: amqp.SenderOptions = amqp.SenderOptions{}) -> amqp.Sender ! amqp.AmqpErr uses (net.dial, clock) {
  let id = locked(c, fn(var z: amqp.ConnState) -> Int ! amqp.AmqpErr uses (net.dial, clock) { st_new_sender(z, s, target, opts) })?
  await_cond(c, 0, fn(var z: amqp.ConnState) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) { step_attached(z, id) })?
  let name = c.st.with_read(fn(z: amqp.ConnState) -> Str { z.links[id].name })
  Ok(amqp.Sender{conn: c, id: id, name: name, target: target})
}

fn connection_new_receiver(c: amqp.Connection, s: amqp.Session, source: Str, opts: amqp.ReceiverOptions = amqp.ReceiverOptions{}) -> amqp.Receiver ! amqp.AmqpErr uses (net.dial, clock) {
  let id = locked(c, fn(var z: amqp.ConnState) -> Int ! amqp.AmqpErr uses (net.dial, clock) { st_new_receiver(z, s, source, opts) })?
  await_cond(c, 0, fn(var z: amqp.ConnState) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) { step_attached(z, id) })?
  locked(c, fn(var z: amqp.ConnState) -> () ! amqp.AmqpErr uses (net.dial, clock) { grant_credit(z, id, opts.credit) })?
  let name = c.st.with_read(fn(z: amqp.ConnState) -> Str { z.links[id].name })
  Ok(amqp.Receiver{conn: c, id: id, name: name, source: source})
}

fn sender_send(x: amqp.Sender, m: amqp.Message, settled: Bool = false, message_format: Int = 0) -> amqp.DeliveryState? ! amqp.AmqpErr uses (net.dial, clock) {
  let payload = encode_message(m)?
  let c = x.conn
  let id = x.id
  let turn = await_cond(c, 0, fn(var z: amqp.ConnState) -> (Int, Bytes, Int)? ! amqp.AmqpErr uses (net.dial, clock) { step_send_begin(z, id, payload.len(), message_format) })?
  let tid = turn.0
  let tag = turn.1
  let chunk = turn.2
  var off = 0
  var first = true
  var failure: amqp.AmqpErr? = None
  while failure is None && (first || off < payload.len()) {
    let at = off
    match await_cond(c, 0, fn(var z: amqp.ConnState) -> Int? ! amqp.AmqpErr uses (net.dial, clock) {
      step_send_chunk(z, id, tid, tag, chunk, payload, at, settled, message_format)
    }) {
      Ok(n) => { off = n }
      Err(e) => { failure = Some(e) }
    }
    first = false
  }
  let ok = failure is None
  c.st.with(fn(var z: amqp.ConnState) { st_send_done(z, id, tid, settled, ok) })
  match failure {
    Some(e) => return Err(e)
    None => {}
  }
  if settled { return Ok(None) }
  await_cond(c, 0, fn(var z: amqp.ConnState) -> (amqp.DeliveryState?)? ! amqp.AmqpErr uses (net.dial, clock) { step_result(z, id, tid) })
}

fn link_close(c: amqp.Connection, id: Int, error: amqp.WireError?) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  locked(c, fn(var z: amqp.ConnState) -> () ! amqp.AmqpErr uses (net.dial, clock) { st_link_close_begin(z, id, error) })?
  await_cond(c, 0, fn(var z: amqp.ConnState) -> Bool? ! amqp.AmqpErr uses (net.dial, clock) { step_detached(z, id) })?
  let e = c.st.with_read(fn(z: amqp.ConnState) -> amqp.WireError? { z.links[id].error })
  match e {
    Some(x) => Err(amqp.AmqpErr.Peer(error: x))
    None => Ok(())
  }
}

fn sender_close(x: amqp.Sender, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  link_close(x.conn, x.id, error)
}

fn receiver_receive(r: amqp.Receiver, timeout_ms: Int = 0) -> amqp.Delivery ! amqp.AmqpErr uses (net.dial, clock) {
  let id = r.id
  await_cond(r.conn, timeout_ms, fn(var z: amqp.ConnState) -> amqp.Delivery? ! amqp.AmqpErr uses (net.dial, clock) { step_receive(z, id) })
}

fn receiver_remote_attach(r: amqp.Receiver) -> amqp.Attach? {
  let id = r.id
  r.conn.st.with_read(fn(z: amqp.ConnState) -> amqp.Attach? { z.links[id].remote_attach })
}

fn sender_remote_attach(x: amqp.Sender) -> amqp.Attach? {
  let id = x.id
  x.conn.st.with_read(fn(z: amqp.ConnState) -> amqp.Attach? { z.links[id].remote_attach })
}

fn receiver_issue_credit(r: amqp.Receiver, n: Int) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let id = r.id
  locked(r.conn, fn(var z: amqp.ConnState) -> () ! amqp.AmqpErr uses (net.dial, clock) { st_issue_credit(z, id, n) })
}

fn receiver_drain(r: amqp.Receiver, timeout_ms: Int = 0) -> List[amqp.Delivery] ! amqp.AmqpErr uses (net.dial, clock) {
  let id = r.id
  locked(r.conn, fn(var z: amqp.ConnState) -> () ! amqp.AmqpErr uses (net.dial, clock) { st_drain_begin(z, id) })?
  await_cond(r.conn, timeout_ms, fn(var z: amqp.ConnState) -> List[amqp.Delivery]? ! amqp.AmqpErr uses (net.dial, clock) { step_drained(z, id) })
}

fn settle(r: amqp.Receiver, d: amqp.Delivery, state: amqp.DeliveryState) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let e = r.conn.st.with(fn(var z: amqp.ConnState) -> amqp.AmqpErr? uses (net.dial, clock) {
    match st_settle(z, r.id, d, state) {
      Ok(_) => None
      Err(y) => Some(y)
    }
  })
  fin_unit(e)?
  let second = r.conn.st.with_read(fn(z: amqp.ConnState) -> Bool { z.links[r.id].second })
  if !second || d.settled { return Ok(()) }
  let id = r.id
  let did = d.id
  let answer = await_cond(r.conn, 0, fn(var z: amqp.ConnState) -> (amqp.DeliveryState?)? ! amqp.AmqpErr uses (net.dial, clock) { step_ack(z, id, did) })?
  match answer {
    Some(Rejected(error)) => {
      match error {
        Some(x) => return Err(amqp.AmqpErr.Peer(error: x))
        None => {}
      }
    }
    _ => {}
  }
  Ok(())
}

fn receiver_accept(r: amqp.Receiver, d: amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  settle(r, d, amqp.DeliveryState.Accepted)
}

fn receiver_reject(r: amqp.Receiver, d: amqp.Delivery, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  settle(r, d, amqp.DeliveryState.Rejected(error: error))
}

fn receiver_release(r: amqp.Receiver, d: amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  settle(r, d, amqp.DeliveryState.Released)
}

fn receiver_modify(r: amqp.Receiver, d: amqp.Delivery, delivery_failed: Bool = true, undeliverable_here: Bool = false, annotations: List[(Str, amqp.Value)] = []) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  var ann: List[(amqp.Value, amqp.Value)] = []
  for a in annotations {
    ann.push((amqp.Value.Symbol(v: a.0), a.1))
  }
  settle(r, d, amqp.DeliveryState.Modified(delivery_failed: delivery_failed, undeliverable_here: undeliverable_here, annotations: ann))
}

fn receiver_close(r: amqp.Receiver, error: amqp.WireError? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  link_close(r.conn, r.id, error)
}

// ---------------------------------------------------------------------------
// Stage 4: claims based security

fn cbs_put_token(c: amqp.Connection, s: amqp.Session, audience: Str, token: Str, token_type: Str = "servicebus.windows.net:sastoken", expiry_ms: Int = 0, expiration: amqp.Value? = None) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  let snd = connection_new_sender(c, s, "$cbs", amqp.SenderOptions{name: "cbs-sender"})?
  let rcv = match connection_new_receiver(c, s, "$cbs", amqp.ReceiverOptions{name: "cbs-receiver", target: "cbs", credit: 1}) {
    Ok(r) => r
    Err(e) => {
      sender_close(snd).ignore_err("the receiver's error is the one reported")
      return Err(e)
    }
  }
  var props: List[(Str, amqp.Value)] = [("operation", amqp.Value.Str(v: "put-token")), ("type", amqp.Value.Str(v: token_type)), ("name", amqp.Value.Str(v: audience))]
  match expiration {
    Some(v) => props.push(("expiration", v))
    None => { if expiry_ms != 0 { props.push(("expiration", amqp.Value.Timestamp(ms: expiry_ms))) } }
  }
  let req = amqp.Message{
    properties: Some(amqp.Properties{message_id: amqp.Value.Str(v: "1"), to: Some("$cbs"), reply_to: Some("cbs")}),
    app_properties: Some(props), body: amqp.Body.Value(v: amqp.Value.Str(v: token))}
  let result = cbs_exchange(snd, rcv, req)
  receiver_close(rcv).ignore_err("the put-token result is the one reported")
  sender_close(snd).ignore_err("the put-token result is the one reported")
  result
}

fn cbs_exchange(snd: amqp.Sender, rcv: amqp.Receiver, req: amqp.Message) -> () ! amqp.AmqpErr uses (net.dial, clock) {
  sender_send(snd, req)?
  let d = receiver_receive(rcv)?
  receiver_accept(rcv, d)?
  var code = -1
  var text = ""
  match d.message.app_properties {
    Some(ps) => {
      for (k, v) in ps {
        if k == "status-code" {
          match v {
            Int(x) => { code = Int(x) }
            Long(x) => { code = Int(x) }
            UInt(x) => { code = Int(x) }
            _ => {}
          }
        }
        if k == "status-description" {
          match v {
            Str(x) => { text = x }
            _ => {}
          }
        }
      }
    }
    None => {}
  }
  if code >= 200 && code < 300 { return Ok(()) }
  Err(amqp.AmqpErr.Peer(error: amqp.WireError{condition: "amqp:unauthorized-access", description: "cbs put-token failed with status ${code}: ${text}"}))
}
