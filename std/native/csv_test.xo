test "parse: Go's records, and an error where Go has one" {
  for (text, want) in GO_CASES {
    match csv.parse(text) {
      Ok(rs) => expect((text, rs.debug())) == (text, want)
      Err(_) => expect((text, want.starts_with("err "))) == (text, true)
    }
  }
}
