test "parse: Go's records and errors, with every option" {
  for (text, comment, fields, lazy, trim, want) in GO_CASES {
    let got = match csv.parse(text, comment: comment, fields: fields, lazy_quotes: lazy, trim_leading_space: trim) {
      Ok(rs) => rs.debug()
      Err(e) => "err ${e}"
    }
    expect((text, comment, fields, lazy, trim, got)) == (text, comment, fields, lazy, trim, want)
  }
}

test "format: Go's Writer" {
  for (rows, crlf, want) in GO_WRITES {
    expect((rows, csv.format(rows, crlf: crlf))) == (rows, want)
  }
}
