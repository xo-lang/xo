// std/path for the native backends (decision 0074): Go's path package,
// ported by its rules. The Go backend compiles this file too
// (std/go_compiled.txt, decision 0312). Paths are bytes; `/` is the only
// separator.

use std/path

/// Whether path has no empty, `.` or `..` element and no trailing `/`
/// (`/` alone counts as clean): clean returns such a path as it is.
fn is_clean(path: Bytes) -> Bool {
  let n = path.len()
  if n == 1 && path[0] == 47 {
    return true
  }
  if path[n - 1] == 47 {
    return false
  }
  var r = if path[0] == 47 { 1 } else { 0 }
  while r < n {
    var e = r
    while e < n && path[e] != 47 {
      e += 1
    }
    let len = e - r
    if len == 0 || len == 1 && path[r] == 46 || len == 2 && path[r] == 46 && path[r + 1] == 46 {
      return false
    }
    r = e + 1
  }
  true
}

/// Go's Clean: the shortest equivalent path (`.` and empty elements gone,
/// `..` taken against the element before it, a rooted `..` at the root
/// dropped), the input itself when nothing changes. Its elements are
/// found once as ranges of the input, then the result is written an
/// element at a time (2026-10-26: Go's lazybuf as a List[UInt8] written a
/// byte at a time was 22% of path's parts profile, and clean 54%).
fn clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let path = p.bytes()
  let n = path.len()
  let rooted = path[0] == 47
  // already clean (no empty, `.` or `..` element, no trailing `/`): the
  // path itself, with nothing allocated (dir's prefixes mostly are)
  if is_clean(path) {
    return p
  }
  // up to 8 kept elements in locals, each its start and end in one word
  // (start << 32 | end; a Str is under 4 GiB), -1 a `..` kept because
  // nothing before it absorbs it: no list to allocate (2026-10-27: the
  // list was 21% of an unclean dir); more go to clean_list
  var s0 = 0
  var s1 = 0
  var s2 = 0
  var s3 = 0
  var s4 = 0
  var s5 = 0
  var s6 = 0
  var s7 = 0
  var k = 0
  var bytes = 0
  var r = 0
  while r < n {
    while r < n && path[r] == 47 {
      r += 1
    }
    if r >= n {
      break
    }
    var e = r
    while e < n && path[e] != 47 {
      e += 1
    }
    let len = e - r
    var v = 0
    var push = true
    if len == 1 && path[r] == 46 {
      push = false
    } else if len == 2 && path[r] == 46 && path[r + 1] == 46 {
      let top = match k {
        0 => -1
        1 => s0
        2 => s1
        3 => s2
        4 => s3
        5 => s4
        6 => s5
        7 => s6
        _ => s7
      }
      if k > 0 && top >= 0 {
        k -= 1
        bytes -= (top & 0xFFFFFFFF) - top.shr_logical(32)
        push = false
      } else if rooted {
        push = false
      } else {
        v = -1
        bytes += 2
      }
    } else {
      v = r.wrapping_shl(32) | e
      bytes += len
    }
    if push {
      if k == 8 {
        return clean_list(p)
      }
      match k {
        0 => s0 = v
        1 => s1 = v
        2 => s2 = v
        3 => s3 = v
        4 => s4 = v
        5 => s5 = v
        6 => s6 = v
        _ => s7 = v
      }
      k += 1
    }
    r = e
  }
  if k == 0 {
    return if rooted { "/" } else { "." }
  }
  let total = bytes + k - 1 + (if rooted { 1 } else { 0 })
  if total == n {
    return p
  }
  var b = BytesBuilder.with_capacity(total)
  if rooted {
    b.write_byte(47)
  }
  for j in 0..k {
    if j > 0 {
      b.write_byte(47)
    }
    let sg = match j {
      0 => s0
      1 => s1
      2 => s2
      3 => s3
      4 => s4
      5 => s5
      6 => s6
      _ => s7
    }
    if sg < 0 {
      b.write_byte(46)
      b.write_byte(46)
    } else {
      var t = sg.shr_logical(32)
      let te = sg & 0xFFFFFFFF
      if te - t > 24 {
        b.write(path[t..te])
      } else {
        while t < te {
          b.write_byte(path[t])
          t += 1
        }
      }
    }
  }
  b.freeze().to_str() ?? ""
}

/// clean of a path that keeps more than 8 elements at once: their ranges
/// in a list.
fn clean_list(p: Str) -> Str {
  let path = p.bytes()
  let n = path.len()
  let rooted = path[0] == 47
  // the kept elements as (start, end) pairs; (-1, -1) is a `..` kept
  // because nothing before it can absorb it
  var segs = List[Int].with_capacity(n + 2)
  var r = 0
  while r < n {
    while r < n && path[r] == 47 {
      r += 1
    }
    if r >= n {
      break
    }
    var e = r
    while e < n && path[e] != 47 {
      e += 1
    }
    let len = e - r
    if len == 1 && path[r] == 46 {
      // `.`: nothing
    } else if len == 2 && path[r] == 46 && path[r + 1] == 46 {
      let k = segs.len()
      if k > 0 && segs[k - 2] >= 0 {
        let _ = segs.pop()
        let _ = segs.pop()
      } else if !rooted {
        segs.push(-1)
        segs.push(-1)
      }
    } else {
      segs.push(r)
      segs.push(e)
    }
    r = e
  }
  let count = segs.len() / 2
  if count == 0 {
    return if rooted { "/" } else { "." }
  }
  var total = if rooted { 1 } else { 0 }
  total += count - 1
  var k = 0
  while k < segs.len() {
    total += if segs[k] < 0 { 2 } else { segs[k + 1] - segs[k] }
    k += 2
  }
  // clean drops bytes, it never reorders them: an output as long as the
  // input is the input
  if total == n {
    return p
  }
  var b = BytesBuilder.with_capacity(total)
  if rooted {
    b.write_byte(47)
  }
  k = 0
  while k < segs.len() {
    if k > 0 {
      b.write_byte(47)
    }
    if segs[k] < 0 {
      b.write_byte(46)
      b.write_byte(46)
    } else {
      let t0 = segs[k]
      let te = segs[k + 1]
      var t = t0
      if te - t > 24 {
        b.write(path[t..te])
      } else {
        while t < te {
          b.write_byte(path[t])
          t += 1
        }
      }
    }
    k += 2
  }
  b.freeze().to_str() ?? ""
}

/// Go's Join of two elements: the non-empty ones joined by "/", cleaned.
fn join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return clean(b)
  }
  if b == "" {
    return clean(a)
  }
  clean(a + "/" + b)
}

// last_slash is the byte index of the last `/` of p, or -1.
fn last_slash(p: Str) -> Int {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 {
    if b[i] == 47 {
      return i
    }
    i -= 1
  }
  -1
}

/// Go's Dir: Clean(path[:lastSlash+1]). Clean drops a trailing `/` of a
/// path longer than `/`, so the prefix is cleaned without it: an already
/// clean directory is then returned as a view, with nothing allocated
/// (2026-10-27: with the `/` kept, is_clean never held and every dir
/// built its result, 70% of the parts row).
fn dir(p: Str) -> Str {
  let i = last_slash(p)
  if i <= 0 {
    return clean(p[0..i + 1])
  }
  clean(p[0..i])
}

/// Go's Base: the last element, trailing slashes dropped; found by index
/// and cut once (the port cut a copy per trailing slash and per step).
fn base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let b = p.bytes()
  var e = b.len()
  while e > 0 && b[e - 1] == 47 {
    e -= 1
  }
  if e == 0 {
    return "/"
  }
  var i = e - 1
  while i >= 0 && b[i] != 47 {
    i -= 1
  }
  if i < 0 && e == b.len() {
    return p
  }
  p[i + 1..e]
}

fn ext(p: Str) -> Str {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    if b[i] == 46 {
      return p[i..]
    }
    i -= 1
  }
  ""
}

/// Go's Split: the directory of p, up to and including its last `/`, and
/// the file after it.
fn split(p: Str) -> (Str, Str) {
  let i = last_slash(p)
  (p[0..i + 1], p[i + 1..])
}

/// Go's IsAbs: p starts with `/`.
fn is_abs(p: Str) -> Bool { p.len() > 0 && p.bytes()[0] == 47 }

fn patherr_display(e: path.PathErr) -> Str { "invalid path pattern ${e.pattern.quote()}: syntax error in pattern" }

// Go's path/match.go, ported below: a pattern is chunks, each a run of `*`
// and a non-star string; a chunk is literals, `?` and byte classes. A
// malformed chunk is reported (`bad`) even when the match fails. Go walks
// the pattern and the name by reslicing; here they are offsets into the
// two Bytes: a slice is a view (decision 0330) but pays a range check, a
// count and a drop each (2026-10-26: the slicing port ran match at 1.70x
// Go's time).

// get_esc is Go's getEsc on p[i..end]: a possibly escaped character of a
// byte class and the offset after it; bad when the class is malformed.
fn get_esc(p: Bytes, i0: Int, end: Int) -> (Int, Int, Bool) {
  var i = i0
  if i >= end || p[i] == 45 || p[i] == 93 {
    return (0, i, true)
  }
  if p[i] == 92 {
    i += 1
    if i >= end {
      return (0, i, true)
    }
  }
  let (r0, n) = p.decode_rune(i)
  let r = Int(r0)
  if r == 0xfffd && n == 1 {
    return (0, i, true)
  }
  if i + n >= end {
    return (0, i, true)
  }
  (r, i + n, false)
}

// match_chunk is Go's matchChunk: whether the chunk p[c0..ce] matches s
// from s0, with the offset in s after the match and whether the chunk is
// malformed.
fn match_chunk(p: Bytes, c0: Int, ce: Int, s: Bytes, s0: Int) -> (Int, Bool, Bool) {
  var c = c0
  var si = s0
  let sn = s.len()
  var failed = false
  while c < ce {
    if si >= sn {
      failed = true
    }
    let ch = p[c]
    if ch == 91 {
      // a byte class: `[`, `[^`, ranges and `]`, and one rune of s
      var r = 0
      if !failed {
        let (r0, n) = s.decode_rune(si)
        r = Int(r0)
        si += n
      }
      c += 1
      var negated = false
      if c < ce && p[c] == 94 {
        negated = true
        c += 1
      }
      var got = false
      var nrange = 0
      while true {
        if c < ce && p[c] == 93 && nrange > 0 {
          c += 1
          break
        }
        let (lo, next, bad) = get_esc(p, c, ce)
        if bad {
          return (0, false, true)
        }
        c = next
        var hi = lo
        if p[c] == 45 {
          let (h, next2, bad2) = get_esc(p, c + 1, ce)
          if bad2 {
            return (0, false, true)
          }
          hi = h
          c = next2
        }
        if lo <= r && r <= hi {
          got = true
        }
        nrange += 1
      }
      if got == negated {
        failed = true
      }
    } else if ch == 63 {
      if !failed {
        failed = s[si] == 47
        let (_, n) = s.decode_rune(si)
        si += n
      }
      c += 1
    } else if ch == 92 {
      c += 1
      if c >= ce {
        return (0, false, true)
      }
      if !failed {
        failed = p[c] != s[si]
        si += 1
      }
      c += 1
    } else {
      if !failed {
        failed = ch != s[si]
        si += 1
      }
      c += 1
    }
  }
  if failed {
    return (0, false, false)
  }
  (si, true, false)
}

// scan_chunk is Go's scanChunk from offset i0: whether a star precedes the
// next chunk, the chunk's start and end, and the offset of the rest.
fn scan_chunk(p: Bytes, i0: Int) -> (Bool, Int, Int, Int) {
  let n = p.len()
  var i = i0
  var star = false
  while i < n && p[i] == 42 {
    i += 1
    star = true
  }
  let start = i
  var inrange = false
  while i < n {
    let c = p[i]
    if c == 92 {
      if i + 1 < n {
        i += 1
      }
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 {
      if !inrange {
        return (star, start, i, i)
      }
    }
    i += 1
  }
  (star, start, n, n)
}

/// Go's Match: whether name matches the whole pattern.
fn is_match(pattern: Str, name0: Str) -> Bool ! path.PathErr {
  let pat = pattern.bytes()
  let name = name0.bytes()
  let pn = pat.len()
  let nn = name.len()
  var pi = 0
  var ni = 0
  while pi < pn {
    let (star, cs, ce, rest) = scan_chunk(pat, pi)
    pi = rest
    if star && cs == ce {
      // a trailing star matches the rest of the name unless it has a `/`
      var j = ni
      while j < nn {
        if name[j] == 47 {
          return false
        }
        j += 1
      }
      return true
    }
    let (t, ok, bad) = match_chunk(pat, cs, ce, name, ni)
    if bad {
      return Err(path.PathErr{pattern: pattern})
    }
    if ok && (t == nn || pi < pn) {
      ni = t
      continue
    }
    var advanced = false
    if star {
      // a star looks for the chunk's match after each byte it skips
      var i = ni
      while i < nn && name[i] != 47 {
        let (t2, ok2, bad2) = match_chunk(pat, cs, ce, name, i + 1)
        if ok2 {
          // a last chunk must exhaust the name
          if pi == pn && t2 < nn {
            i += 1
            continue
          }
          ni = t2
          advanced = true
          break
        }
        if bad2 {
          return Err(path.PathErr{pattern: pattern})
        }
        i += 1
      }
    }
    if advanced {
      continue
    }
    // no match: the rest of the pattern must still be well formed
    while pi < pn {
      let (_, cs2, ce2, rest2) = scan_chunk(pat, pi)
      pi = rest2
      let (_, _, bad3) = match_chunk(pat, cs2, ce2, b"", 0)
      if bad3 {
        return Err(path.PathErr{pattern: pattern})
      }
    }
    return false
  }
  ni == nn
}
