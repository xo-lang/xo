// std/path for the native backends (decision 0074): Go's path package
// (std/rt/path.go calls it), ported by its rules. Paths are bytes; `/` is
// the only separator.

/// Go's lazybuf: the output of clean, a prefix of the input until the
/// first byte that differs, then its own bytes.
struct Lazy {
  s: Bytes
  buf: List[Int] = []
  copied: Bool = false
  w: Int = 0
}

fn (l: Lazy) index(i: Int) -> Int { if l.copied { l.buf[i] } else { Int(l.s[i]) } }

fn (var l: Lazy) append(c: Int) {
  if !l.copied {
    if l.w < l.s.len() && Int(l.s[l.w]) == c {
      l.w += 1
      return
    }
    var buf: List[Int] = []
    for i in 0..l.w {
      buf.push(Int(l.s[i]))
    }
    l.buf = buf
    l.copied = true
  }
  if l.w < l.buf.len() {
    l.buf[l.w] = c
  } else {
    l.buf.push(c)
  }
  l.w += 1
}

fn (l: Lazy) text(p: Str) -> Str {
  if !l.copied {
    // the input's own prefix: no copy (it ends at a separator or the end)
    return if l.w == p.len() { p } else { p[0..l.w] }
  }
  var b = BytesBuilder.with_capacity(l.w)
  for i in 0..l.w {
    b.write_byte(UInt8(l.buf[i]))
  }
  b.freeze().to_str() ?? ""
}

/// Go's Clean: one scan, the input itself when nothing changes.
fn clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let path = p.bytes()
  let n = path.len()
  let rooted = path[0] == 47
  var out = Lazy{s: path}
  var r = 0
  var dotdot = 0
  if rooted {
    out.append(47)
    r = 1
    dotdot = 1
  }
  while r < n {
    let c = path[r]
    if c == 47 {
      r += 1
    } else if c == 46 && (r + 1 == n || path[r + 1] == 47) {
      r += 1
    } else if c == 46 && path[r + 1] == 46 && (r + 2 == n || path[r + 2] == 47) {
      r += 2
      if out.w > dotdot {
        out.w -= 1
        while out.w > dotdot && out.index(out.w) != 47 {
          out.w -= 1
        }
      } else if !rooted {
        if out.w > 0 {
          out.append(47)
        }
        out.append(46)
        out.append(46)
        dotdot = out.w
      }
    } else {
      if (rooted && out.w != 1) || (!rooted && out.w != 0) {
        out.append(47)
      }
      while r < n && path[r] != 47 {
        out.append(Int(path[r]))
        r += 1
      }
    }
  }
  if out.w == 0 {
    return "."
  }
  out.text(p)
}

/// Go's Join of two elements: the non-empty ones joined by "/", cleaned.
fn join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return clean(b)
  }
  if b == "" {
    return clean(a)
  }
  clean(a + "/" + b)
}

// last_slash is the byte index of the last `/` of p, or -1.
fn last_slash(p: Str) -> Int {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 {
    if b[i] == 47 {
      return i
    }
    i -= 1
  }
  -1
}

fn dir(p: Str) -> Str { clean(p[0..last_slash(p) + 1]) }

fn base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  var s = p
  while s.len() > 0 && s.ends_with("/") {
    s = s[0..s.len() - 1]
  }
  if s == "" {
    return "/"
  }
  s[last_slash(s) + 1..]
}

fn ext(p: Str) -> Str {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    if b[i] == 46 {
      return p[i..]
    }
    i -= 1
  }
  ""
}
