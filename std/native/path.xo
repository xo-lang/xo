// std/path for the native backends (decision 0074): Go's path package,
// ported by its rules. The Go backend compiles this file too
// (std/go_compiled.txt, decision 0312). Paths are bytes; `/` is the only
// separator.

use std/path

/// Go's lazybuf: the output of clean, a prefix of the input until the
/// first byte that differs, then its own bytes, a byte buffer made once
/// at the input's length and written by index, as Go's.
struct Lazy {
  s: Bytes
  buf: List[UInt8] = []
  copied: Bool = false
  w: Int = 0
}

fn (l: Lazy) index(i: Int) -> UInt8 { if l.copied { l.buf[i] } else { l.s[i] } }

fn (var l: Lazy) append(c: UInt8) {
  if !l.copied {
    if l.w < l.s.len() && l.s[l.w] == c {
      l.w += 1
      return
    }
    var buf = List[UInt8].with_capacity(l.s.len())
    for i in 0..l.w {
      buf.push(l.s[i])
    }
    l.buf = buf
    l.copied = true
  }
  if l.w < l.buf.len() {
    l.buf[l.w] = c
  } else {
    l.buf.push(c)
  }
  l.w += 1
}

fn (l: Lazy) text(p: Str) -> Str {
  if !l.copied {
    // the input's own prefix: no copy (it ends at a separator or the end)
    return if l.w == p.len() { p } else { p[0..l.w] }
  }
  var b = BytesBuilder.with_capacity(l.w)
  for i in 0..l.w {
    b.write_byte(l.buf[i])
  }
  b.freeze().to_str() ?? ""
}

/// Go's Clean: one scan, the input itself when nothing changes.
fn clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let path = p.bytes()
  let n = path.len()
  let rooted = path[0] == 47
  var out = Lazy{s: path}
  var r = 0
  var dotdot = 0
  if rooted {
    out.append(47)
    r = 1
    dotdot = 1
  }
  while r < n {
    let c = path[r]
    if c == 47 {
      r += 1
    } else if c == 46 && (r + 1 == n || path[r + 1] == 47) {
      r += 1
    } else if c == 46 && path[r + 1] == 46 && (r + 2 == n || path[r + 2] == 47) {
      r += 2
      if out.w > dotdot {
        out.w -= 1
        while out.w > dotdot && out.index(out.w) != 47 {
          out.w -= 1
        }
      } else if !rooted {
        if out.w > 0 {
          out.append(47)
        }
        out.append(46)
        out.append(46)
        dotdot = out.w
      }
    } else {
      if (rooted && out.w != 1) || (!rooted && out.w != 0) {
        out.append(47)
      }
      while r < n && path[r] != 47 {
        out.append(path[r])
        r += 1
      }
    }
  }
  if out.w == 0 {
    return "."
  }
  out.text(p)
}

/// Go's Join of two elements: the non-empty ones joined by "/", cleaned.
fn join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return clean(b)
  }
  if b == "" {
    return clean(a)
  }
  clean(a + "/" + b)
}

// last_slash is the byte index of the last `/` of p, or -1.
fn last_slash(p: Str) -> Int {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 {
    if b[i] == 47 {
      return i
    }
    i -= 1
  }
  -1
}

fn dir(p: Str) -> Str { clean(p[0..last_slash(p) + 1]) }

/// Go's Base: the last element, trailing slashes dropped; found by index
/// and cut once (the port cut a copy per trailing slash and per step).
fn base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let b = p.bytes()
  var e = b.len()
  while e > 0 && b[e - 1] == 47 {
    e -= 1
  }
  if e == 0 {
    return "/"
  }
  var i = e - 1
  while i >= 0 && b[i] != 47 {
    i -= 1
  }
  if i < 0 && e == b.len() {
    return p
  }
  p[i + 1..e]
}

fn ext(p: Str) -> Str {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    if b[i] == 46 {
      return p[i..]
    }
    i -= 1
  }
  ""
}

/// Go's Split: the directory of p, up to and including its last `/`, and
/// the file after it.
fn split(p: Str) -> (Str, Str) {
  let i = last_slash(p)
  (p[0..i + 1], p[i + 1..])
}

/// Go's IsAbs: p starts with `/`.
fn is_abs(p: Str) -> Bool { p.len() > 0 && p.bytes()[0] == 47 }

fn patherr_display(e: path.PathErr) -> Str { "invalid path pattern ${e.pattern.quote()}: syntax error in pattern" }

// Go's path/match.go, ported below: a pattern is chunks, each a run of `*`
// and a non-star string; a chunk is literals, `?` and byte classes. A
// malformed chunk is reported (`bad`) even when the match fails. Go walks
// the pattern and the name by reslicing; here they are offsets into the
// two Bytes, since a Bytes slice copies (2026-10-26: the slicing port ran
// match at 1.70x Go's time, gotchas/std-port-costly-go-idioms.md).

// get_esc is Go's getEsc on p[i..end]: a possibly escaped character of a
// byte class and the offset after it; bad when the class is malformed.
fn get_esc(p: Bytes, i0: Int, end: Int) -> (Int, Int, Bool) {
  var i = i0
  if i >= end || p[i] == 45 || p[i] == 93 {
    return (0, i, true)
  }
  if p[i] == 92 {
    i += 1
    if i >= end {
      return (0, i, true)
    }
  }
  let (r0, n) = p.decode_rune(i)
  let r = Int(r0)
  if r == 0xfffd && n == 1 {
    return (0, i, true)
  }
  if i + n >= end {
    return (0, i, true)
  }
  (r, i + n, false)
}

// match_chunk is Go's matchChunk: whether the chunk p[c0..ce] matches s
// from s0, with the offset in s after the match and whether the chunk is
// malformed.
fn match_chunk(p: Bytes, c0: Int, ce: Int, s: Bytes, s0: Int) -> (Int, Bool, Bool) {
  var c = c0
  var si = s0
  let sn = s.len()
  var failed = false
  while c < ce {
    if si >= sn {
      failed = true
    }
    let ch = p[c]
    if ch == 91 {
      // a byte class: `[`, `[^`, ranges and `]`, and one rune of s
      var r = 0
      if !failed {
        let (r0, n) = s.decode_rune(si)
        r = Int(r0)
        si += n
      }
      c += 1
      var negated = false
      if c < ce && p[c] == 94 {
        negated = true
        c += 1
      }
      var got = false
      var nrange = 0
      while true {
        if c < ce && p[c] == 93 && nrange > 0 {
          c += 1
          break
        }
        let (lo, next, bad) = get_esc(p, c, ce)
        if bad {
          return (0, false, true)
        }
        c = next
        var hi = lo
        if p[c] == 45 {
          let (h, next2, bad2) = get_esc(p, c + 1, ce)
          if bad2 {
            return (0, false, true)
          }
          hi = h
          c = next2
        }
        if lo <= r && r <= hi {
          got = true
        }
        nrange += 1
      }
      if got == negated {
        failed = true
      }
    } else if ch == 63 {
      if !failed {
        failed = s[si] == 47
        let (_, n) = s.decode_rune(si)
        si += n
      }
      c += 1
    } else if ch == 92 {
      c += 1
      if c >= ce {
        return (0, false, true)
      }
      if !failed {
        failed = p[c] != s[si]
        si += 1
      }
      c += 1
    } else {
      if !failed {
        failed = ch != s[si]
        si += 1
      }
      c += 1
    }
  }
  if failed {
    return (0, false, false)
  }
  (si, true, false)
}

// scan_chunk is Go's scanChunk from offset i0: whether a star precedes the
// next chunk, the chunk's start and end, and the offset of the rest.
fn scan_chunk(p: Bytes, i0: Int) -> (Bool, Int, Int, Int) {
  let n = p.len()
  var i = i0
  var star = false
  while i < n && p[i] == 42 {
    i += 1
    star = true
  }
  let start = i
  var inrange = false
  while i < n {
    let c = p[i]
    if c == 92 {
      if i + 1 < n {
        i += 1
      }
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 {
      if !inrange {
        return (star, start, i, i)
      }
    }
    i += 1
  }
  (star, start, n, n)
}

/// Go's Match: whether name matches the whole pattern.
fn is_match(pattern: Str, name0: Str) -> Bool ! path.PathErr {
  let pat = pattern.bytes()
  let name = name0.bytes()
  let pn = pat.len()
  let nn = name.len()
  var pi = 0
  var ni = 0
  while pi < pn {
    let (star, cs, ce, rest) = scan_chunk(pat, pi)
    pi = rest
    if star && cs == ce {
      // a trailing star matches the rest of the name unless it has a `/`
      var j = ni
      while j < nn {
        if name[j] == 47 {
          return false
        }
        j += 1
      }
      return true
    }
    let (t, ok, bad) = match_chunk(pat, cs, ce, name, ni)
    if bad {
      return Err(path.PathErr{pattern: pattern})
    }
    if ok && (t == nn || pi < pn) {
      ni = t
      continue
    }
    var advanced = false
    if star {
      // a star looks for the chunk's match after each byte it skips
      var i = ni
      while i < nn && name[i] != 47 {
        let (t2, ok2, bad2) = match_chunk(pat, cs, ce, name, i + 1)
        if ok2 {
          // a last chunk must exhaust the name
          if pi == pn && t2 < nn {
            i += 1
            continue
          }
          ni = t2
          advanced = true
          break
        }
        if bad2 {
          return Err(path.PathErr{pattern: pattern})
        }
        i += 1
      }
    }
    if advanced {
      continue
    }
    // no match: the rest of the pattern must still be well formed
    while pi < pn {
      let (_, cs2, ce2, rest2) = scan_chunk(pat, pi)
      pi = rest2
      let (_, _, bad3) = match_chunk(pat, cs2, ce2, b"", 0)
      if bad3 {
        return Err(path.PathErr{pattern: pattern})
      }
    }
    return false
  }
  ni == nn
}
