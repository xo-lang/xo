// std/path for the native backends (decision 0074): Go's path package,
// ported by its rules. The Go backend compiles this file too
// (std/go_compiled.txt, decision 0312). Paths are bytes; `/` is the only
// separator.

use std/path

/// Go's lazybuf: the output of clean, a prefix of the input until the
/// first byte that differs, then its own bytes, a byte buffer made once
/// at the input's length and written by index, as Go's.
struct Lazy {
  s: Bytes
  buf: List[UInt8] = []
  copied: Bool = false
  w: Int = 0
}

fn (l: Lazy) index(i: Int) -> UInt8 { if l.copied { l.buf[i] } else { l.s[i] } }

fn (var l: Lazy) append(c: UInt8) {
  if !l.copied {
    if l.w < l.s.len() && l.s[l.w] == c {
      l.w += 1
      return
    }
    var buf = List[UInt8].with_capacity(l.s.len())
    for i in 0..l.w {
      buf.push(l.s[i])
    }
    l.buf = buf
    l.copied = true
  }
  if l.w < l.buf.len() {
    l.buf[l.w] = c
  } else {
    l.buf.push(c)
  }
  l.w += 1
}

fn (l: Lazy) text(p: Str) -> Str {
  if !l.copied {
    // the input's own prefix: no copy (it ends at a separator or the end)
    return if l.w == p.len() { p } else { p[0..l.w] }
  }
  var b = BytesBuilder.with_capacity(l.w)
  for i in 0..l.w {
    b.write_byte(l.buf[i])
  }
  b.freeze().to_str() ?? ""
}

/// Go's Clean: one scan, the input itself when nothing changes.
fn clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let path = p.bytes()
  let n = path.len()
  let rooted = path[0] == 47
  var out = Lazy{s: path}
  var r = 0
  var dotdot = 0
  if rooted {
    out.append(47)
    r = 1
    dotdot = 1
  }
  while r < n {
    let c = path[r]
    if c == 47 {
      r += 1
    } else if c == 46 && (r + 1 == n || path[r + 1] == 47) {
      r += 1
    } else if c == 46 && path[r + 1] == 46 && (r + 2 == n || path[r + 2] == 47) {
      r += 2
      if out.w > dotdot {
        out.w -= 1
        while out.w > dotdot && out.index(out.w) != 47 {
          out.w -= 1
        }
      } else if !rooted {
        if out.w > 0 {
          out.append(47)
        }
        out.append(46)
        out.append(46)
        dotdot = out.w
      }
    } else {
      if (rooted && out.w != 1) || (!rooted && out.w != 0) {
        out.append(47)
      }
      while r < n && path[r] != 47 {
        out.append(path[r])
        r += 1
      }
    }
  }
  if out.w == 0 {
    return "."
  }
  out.text(p)
}

/// Go's Join of two elements: the non-empty ones joined by "/", cleaned.
fn join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return clean(b)
  }
  if b == "" {
    return clean(a)
  }
  clean(a + "/" + b)
}

// last_slash is the byte index of the last `/` of p, or -1.
fn last_slash(p: Str) -> Int {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 {
    if b[i] == 47 {
      return i
    }
    i -= 1
  }
  -1
}

fn dir(p: Str) -> Str { clean(p[0..last_slash(p) + 1]) }

fn base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  var s = p
  while s.len() > 0 && s.ends_with("/") {
    s = s[0..s.len() - 1]
  }
  if s == "" {
    return "/"
  }
  s[last_slash(s) + 1..]
}

fn ext(p: Str) -> Str {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    if b[i] == 46 {
      return p[i..]
    }
    i -= 1
  }
  ""
}

/// Go's Split: the directory of p, up to and including its last `/`, and
/// the file after it.
fn split(p: Str) -> (Str, Str) {
  let i = last_slash(p)
  (p[0..i + 1], p[i + 1..])
}

/// Go's IsAbs: p starts with `/`.
fn is_abs(p: Str) -> Bool { p.len() > 0 && p.bytes()[0] == 47 }

fn patherr_display(e: path.PathErr) -> Str { "invalid path pattern ${e.pattern.quote()}: syntax error in pattern" }

// Go's path/match.go, ported below: a pattern is chunks, each a run of `*`
// and a non-star string; a chunk is literals, `?` and byte classes. A
// malformed chunk is reported even when the match fails (`bad`).

// Go's path/match.go, ported below: a pattern is chunks, each a run of `*`
// and a non-star string; a chunk is literals, `?` and byte classes. Bytes
// are compared and sliced byte by byte, as Go's strings are, and a
// malformed chunk is reported (`bad`) even when the match fails.

// get_esc is Go's getEsc: a possibly escaped character of a byte class and
// the rest of the chunk; bad when the class is malformed.
fn get_esc(chunk0: Bytes) -> (Int, Bytes, Bool) {
  var chunk = chunk0
  if chunk.len() == 0 || chunk[0] == 45 || chunk[0] == 93 {
    return (0, b"", true)
  }
  if chunk[0] == 92 {
    chunk = chunk[1..]
    if chunk.len() == 0 {
      return (0, b"", true)
    }
  }
  let (r0, n) = chunk.decode_rune(0)
  let r = Int(r0)
  if r == 0xfffd && n == 1 {
    return (0, b"", true)
  }
  if n >= chunk.len() {
    return (0, b"", true)
  }
  (r, chunk[n..], false)
}

// match_chunk is Go's matchChunk: whether chunk matches the beginning of s,
// with the rest of s after the match and whether the chunk is malformed.
fn match_chunk(chunk0: Bytes, s0: Bytes) -> (Bytes, Bool, Bool) {
  var chunk = chunk0
  var s = s0
  var failed = false
  while chunk.len() > 0 {
    if s.len() == 0 {
      failed = true
    }
    let c = chunk[0]
    if c == 91 {
      // a byte class: `[`, `[^`, ranges and `]`, and one rune of s
      var r = 0
      if !failed {
        let (r0, n) = s.decode_rune(0)
        r = Int(r0)
        s = s[n..]
      }
      chunk = chunk[1..]
      var negated = false
      if chunk.len() > 0 && chunk[0] == 94 {
        negated = true
        chunk = chunk[1..]
      }
      var got = false
      var nrange = 0
      while true {
        if chunk.len() > 0 && chunk[0] == 93 && nrange > 0 {
          chunk = chunk[1..]
          break
        }
        let (lo, rest, bad) = get_esc(chunk)
        if bad {
          return (b"", false, true)
        }
        chunk = rest
        var hi = lo
        if chunk[0] == 45 {
          let (h, rest2, bad2) = get_esc(chunk[1..])
          if bad2 {
            return (b"", false, true)
          }
          hi = h
          chunk = rest2
        }
        if lo <= r && r <= hi {
          got = true
        }
        nrange += 1
      }
      if got == negated {
        failed = true
      }
    } else if c == 63 {
      if !failed {
        failed = s[0] == 47
        let (_, n) = s.decode_rune(0)
        s = s[n..]
      }
      chunk = chunk[1..]
    } else if c == 92 {
      chunk = chunk[1..]
      if chunk.len() == 0 {
        return (b"", false, true)
      }
      if !failed {
        failed = chunk[0] != s[0]
        s = s[1..]
      }
      chunk = chunk[1..]
    } else {
      if !failed {
        failed = c != s[0]
        s = s[1..]
      }
      chunk = chunk[1..]
    }
  }
  if failed {
    return (b"", false, false)
  }
  (s, true, false)
}

// scan_chunk is Go's scanChunk: the next chunk of a pattern, whether a star
// precedes it, and the rest of the pattern.
fn scan_chunk(pat0: Bytes) -> (Bool, Bytes, Bytes) {
  var pat = pat0
  var star = false
  while pat.len() > 0 && pat[0] == 42 {
    pat = pat[1..]
    star = true
  }
  var inrange = false
  var i = 0
  while i < pat.len() {
    let c = pat[i]
    if c == 92 {
      if i + 1 < pat.len() {
        i += 1
      }
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 {
      if !inrange {
        return (star, pat[0..i], pat[i..])
      }
    }
    i += 1
  }
  (star, pat, b"")
}

/// Go's Match: whether name matches the whole pattern.
fn is_match(pattern: Str, name0: Str) -> Bool ! path.PathErr {
  var pat = pattern.bytes()
  var name = name0.bytes()
  while pat.len() > 0 {
    let (star, chunk, rest) = scan_chunk(pat)
    pat = rest
    if star && chunk.len() == 0 {
      // a trailing star matches the rest of the name unless it has a `/`
      let slash = match name.find(b"/") {
        Some(_) => true
        None => false
      }
      return !slash
    }
    let (t, ok, bad) = match_chunk(chunk, name)
    if bad {
      return Err(path.PathErr{pattern: pattern})
    }
    if ok && (t.len() == 0 || pat.len() > 0) {
      name = t
      continue
    }
    var advanced = false
    if star {
      // a star looks for the chunk's match after each byte it skips
      var i = 0
      while i < name.len() && name[i] != 47 {
        let (t2, ok2, bad2) = match_chunk(chunk, name[i + 1..])
        if ok2 {
          // a last chunk must exhaust the name
          if pat.len() == 0 && t2.len() > 0 {
            i += 1
            continue
          }
          name = t2
          advanced = true
          break
        }
        if bad2 {
          return Err(path.PathErr{pattern: pattern})
        }
        i += 1
      }
    }
    if advanced {
      continue
    }
    // no match: the rest of the pattern must still be well formed
    while pat.len() > 0 {
      let (_, chunk2, rest2) = scan_chunk(pat)
      pat = rest2
      let (_, _, bad3) = match_chunk(chunk2, b"")
      if bad3 {
        return Err(path.PathErr{pattern: pattern})
      }
    }
    return false
  }
  name.len() == 0
}
