// Hand written cases for std/protowkt (decision 0546); the differential against protobuf-go's well known types is
// internal/stdtest/testdata/corpus/protowkt.
use std/protowkt

test "timestamp and duration write seconds then nanos" {
  expect(protowkt.encode_timestamp(protowkt.Timestamp{seconds: 1, nanos: 2})) == b"\x08\x01\x10\x02"
  expect(protowkt.encode_duration(protowkt.Duration{seconds: 1, nanos: 2})) == b"\x08\x01\x10\x02"
  expect(protowkt.encode_timestamp(protowkt.Timestamp{})) == b""
  let t = protowkt.decode_timestamp(b"\x08\x01\x10\x02").or_fault("decode")
  expect(t.seconds) == 1
  expect(t.nanos) == 2
}

test "a negative nanos is a ten byte varint and comes back" {
  let m = protowkt.Duration{seconds: -1, nanos: -5}
  let d = protowkt.decode_duration(protowkt.encode_duration(m)).or_fault("decode")
  expect(d == m) == true
}

test "empty, field mask and any" {
  expect(protowkt.encode_empty(protowkt.Empty{})) == b""
  expect(protowkt.encode_field_mask(protowkt.FieldMask{paths: ["a", "b"]})) == b"\x0a\x01a\x0a\x01b"
  let a = protowkt.Any{type_url: "t/x", value: b"\x01\x02"}
  expect(protowkt.encode_any(a)) == b"\x0a\x03t/x\x12\x02\x01\x02"
  expect(protowkt.decode_any(protowkt.encode_any(a)).or_fault("decode") == a) == true
}

test "wrappers write their value unless it is the zero" {
  expect(protowkt.encode_int32_value(protowkt.Int32Value{value: 5})) == b"\x08\x05"
  expect(protowkt.encode_int32_value(protowkt.Int32Value{})) == b""
  expect(protowkt.encode_bool_value(protowkt.BoolValue{value: true})) == b"\x08\x01"
  expect(protowkt.encode_string_value(protowkt.StringValue{value: "hi"})) == b"\x0a\x02hi"
  expect(protowkt.encode_bytes_value(protowkt.BytesValue{value: b"\x00"})) == b"\x0a\x01\x00"
}

test "a value writes the member that is set, also when it is the zero" {
  expect(protowkt.encode_value(protowkt.Value.Null)) == b"\x08\x00"
  expect(protowkt.encode_value(protowkt.Value.Text("x"))) == b"\x1a\x01x"
  expect(protowkt.encode_value(protowkt.Value.Flag(false))) == b"\x20\x00"
  expect(protowkt.encode_value(protowkt.Value.Unset)) == b""
}

test "a struct and a list round trip" {
  var f: Map[Str, protowkt.Value] = {}
  f.put("n", protowkt.Value.Number(2.5))
  f.put("l", protowkt.Value.Array(protowkt.ListValue{values: [protowkt.Value.Null, protowkt.Value.Text("z")]}))
  let v = protowkt.Value.Object(protowkt.Struct{fields: f})
  let back = protowkt.decode_value(protowkt.encode_value(v)).or_fault("decode")
  expect(protowkt.encode_value(back)) == protowkt.encode_value(v)
}

test "a truncated message is an error, never a panic" {
  let whole = protowkt.encode_any(protowkt.Any{type_url: "type.googleapis.com/x.Y", value: b"abcdef"})
  for cut in 1..whole.len() {
    let _ = protowkt.decode_any(whole[0..cut]).ignore_err("a truncated message may be refused; only a panic fails")
  }
}
