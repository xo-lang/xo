// std/protoparse on the native backends (decision 0530): the lexer of a `.proto` file.
use std/protoparse

fn parseerr_display(e: protoparse.ParseErr) -> Str { "${e.line}:${e.col}: ${e.msg}" }

fn is_letter(c: Int) -> Bool { (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 }
fn is_digit(c: Int) -> Bool { c >= 48 && c <= 57 }

fn tokens(src: Str) -> List[protoparse.Token] ! protoparse.ParseErr {
  let b = src.bytes()
  var out: List[protoparse.Token] = []
  var i = 0
  var line = 1
  var ls = 0
  while i < b.len() {
    let c = Int(b[i])
    let col = i - ls + 1
    if c == 10 {
      line += 1
      i += 1
      ls = i
    } else if c == 32 || c == 9 || c == 13 {
      i += 1
    } else if c == 47 && i + 1 < b.len() && Int(b[i + 1]) == 47 {
      while i < b.len() && Int(b[i]) != 10 { i += 1 }
    } else if c == 47 && i + 1 < b.len() && Int(b[i + 1]) == 42 {
      i += 2
      var closed = false
      while i < b.len() {
        if Int(b[i]) == 42 && i + 1 < b.len() && Int(b[i + 1]) == 47 {
          i += 2
          closed = true
          break
        }
        if Int(b[i]) == 10 {
          line += 1
          ls = i + 1
        }
        i += 1
      }
      if !closed { return Err(protoparse.ParseErr{line: line, col: col, msg: "unterminated comment"}) }
    } else if is_letter(c) {
      let s = i
      while i < b.len() && (is_letter(Int(b[i])) || is_digit(Int(b[i])) || Int(b[i]) == 46) { i += 1 }
      out.push(protoparse.Token{kind: protoparse.Kind.Ident, text: src[s..i], line: line, col: col})
    } else if is_digit(c) {
      let s = i
      var fl = false
      while i < b.len() {
        let d = Int(b[i])
        if is_digit(d) || is_letter(d) {
          i += 1
        } else if d == 46 {
          fl = true
          i += 1
        } else if (d == 43 || d == 45) && (Int(b[i - 1]) == 101 || Int(b[i - 1]) == 69) && !(i - s > 1 && Int(b[s + 1]) == 120) {
          fl = true
          i += 1
        } else {
          break
        }
      }
      let t = src[s..i]
      let isf = fl || ((t.contains("e") || t.contains("E")) && !t.starts_with("0x") && !t.starts_with("0X"))
      out.push(protoparse.Token{kind: if isf { protoparse.Kind.Float } else { protoparse.Kind.Int }, text: t, line: line, col: col})
    } else if c == 34 || c == 39 {
      i += 1
      var sb = BytesBuilder.new()
      var closed = false
      while i < b.len() {
        let d = Int(b[i])
        if d == c {
          i += 1
          closed = true
          break
        }
        if d == 10 { break }
        if d == 92 && i + 1 < b.len() {
          let e = Int(b[i + 1])
          i += 2
          if e == 110 { sb.write(b"\n") } else if e == 116 { sb.write(b"\t") } else if e == 114 { sb.write(b"\r") } else if e == 48 { sb.write(b"\x00") } else { sb.write(b[i - 1..i]) }
        } else {
          sb.write(b[i..i + 1])
          i += 1
        }
      }
      if !closed { return Err(protoparse.ParseErr{line: line, col: col, msg: "unterminated string"}) }
      out.push(protoparse.Token{kind: protoparse.Kind.Str, text: sb.freeze().to_str_lossy(), line: line, col: col})
    } else if c < 128 {
      out.push(protoparse.Token{kind: protoparse.Kind.Sym, text: src[i..i + 1], line: line, col: col})
      i += 1
    } else {
      return Err(protoparse.ParseErr{line: line, col: col, msg: "unexpected character"})
    }
  }
  Ok(out)
}

struct P {
  ts: List[protoparse.Token]
  at: Int
}

fn p_err(p: P, msg: Str) -> protoparse.ParseErr {
  if p.at < p.ts.len() {
    let t = p.ts[p.at]
    protoparse.ParseErr{line: t.line, col: t.col, msg: msg}
  } else if p.ts.len() > 0 {
    let t = p.ts[p.ts.len() - 1]
    protoparse.ParseErr{line: t.line, col: t.col + t.text.len(), msg: msg}
  } else {
    protoparse.ParseErr{line: 1, col: 1, msg: msg}
  }
}

fn p_peek(p: P) -> Str { if p.at < p.ts.len() { p.ts[p.at].text } else { "" } }
fn p_is(p: P, s: Str) -> Bool {
  p.at < p.ts.len() && p.ts[p.at].text == s && p.ts[p.at].kind != protoparse.Kind.Str
}

fn p_expect(var p: P, s: Str) ! protoparse.ParseErr {
  if !p_is(p, s) { return Err(p_err(p, "expected `${s}`, found `${p_peek(p)}`")) }
  p.at += 1
  Ok(())
}

fn p_ident(var p: P) -> Str ! protoparse.ParseErr {
  if p.at >= p.ts.len() || p.ts[p.at].kind != protoparse.Kind.Ident {
    return Err(p_err(p, "expected a name, found `${p_peek(p)}`"))
  }
  p.at += 1
  Ok(p.ts[p.at - 1].text)
}

/// A type name, possibly starting with a dot.
fn p_type(var p: P) -> Str ! protoparse.ParseErr {
  if p_is(p, ".") {
    p.at += 1
    let n = p_ident(p)?
    return Ok(".${n}")
  }
  p_ident(p)
}

fn p_int(var p: P) -> Int ! protoparse.ParseErr {
  var neg = false
  if p_is(p, "-") {
    neg = true
    p.at += 1
  }
  if p.at >= p.ts.len() || p.ts[p.at].kind != protoparse.Kind.Int {
    return Err(p_err(p, "expected an integer, found `${p_peek(p)}`"))
  }
  let t = p.ts[p.at].text
  let v = Int.parse_base(t, 0)
  match v {
    Some(n) => {
      p.at += 1
      Ok(if neg { -n } else { n })
    }
    None => Err(p_err(p, "bad integer `${t}`"))
  }
}

fn p_str(var p: P) -> Str ! protoparse.ParseErr {
  if p.at >= p.ts.len() || p.ts[p.at].kind != protoparse.Kind.Str {
    return Err(p_err(p, "expected a string, found `${p_peek(p)}`"))
  }
  p.at += 1
  var s = p.ts[p.at - 1].text
  // adjacent string literals concatenate
  while p.at < p.ts.len() && p.ts[p.at].kind == protoparse.Kind.Str {
    s = s + p.ts[p.at].text
    p.at += 1
  }
  Ok(s)
}

/// Skips tokens up to and including the next `;` outside brackets and braces.
fn p_skip_stmt(var p: P) ! protoparse.ParseErr {
  var depth = 0
  while p.at < p.ts.len() {
    let t = p.ts[p.at]
    p.at += 1
    if t.kind == protoparse.Kind.Sym {
      if t.text == "{" || t.text == "[" || t.text == "(" {
        depth += 1
      } else if t.text == "}" || t.text == "]" || t.text == ")" {
        depth -= 1
      } else if t.text == ";" && depth <= 0 {
        return Ok(())
      }
    }
  }
  Err(p_err(p, "unexpected end of file, expected `;`"))
}

/// Skips a `[ ... ]` field option list when present.
fn p_skip_opts(var p: P) ! protoparse.ParseErr {
  if !p_is(p, "[") { return Ok(()) }
  var depth = 0
  while p.at < p.ts.len() {
    let t = p.ts[p.at]
    p.at += 1
    if t.kind == protoparse.Kind.Sym {
      if t.text == "[" { depth += 1 }
      if t.text == "]" {
        depth -= 1
        if depth == 0 { return Ok(()) }
      }
    }
  }
  Err(p_err(p, "unterminated `[`"))
}

fn p_enum(var p: P) -> protoparse.Enum ! protoparse.ParseErr {
  let name = p_ident(p)?
  p_expect(p, "{")?
  var vals: List[protoparse.EnumValue] = []
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated enum `${name}`")) }
    if p_is(p, "option") || p_is(p, "reserved") {
      p_skip_stmt(p)?
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      let vn = p_ident(p)?
      p_expect(p, "=")?
      let n = p_int(p)?
      p_skip_opts(p)?
      p_expect(p, ";")?
      vals.push(protoparse.EnumValue{name: vn, num: n})
    }
  }
  p.at += 1
  Ok(protoparse.Enum{name: name, values: vals})
}

fn p_field(var p: P, oneof: Str, var m: protoparse.Message) -> protoparse.Message ! protoparse.ParseErr {
  var repeated = false
  var optional = false
  if oneof == "" {
    if p_is(p, "repeated") {
      repeated = true
      p.at += 1
    } else if p_is(p, "optional") {
      optional = true
      p.at += 1
    } else if p_is(p, "required") {
      return Err(p_err(p, "`required` is proto2 only"))
    }
  }
  var key = ""
  var typ = ""
  if p_is(p, "map") && p.at + 1 < p.ts.len() && p.ts[p.at + 1].text == "<" {
    p.at += 2
    key = p_ident(p)?
    p_expect(p, ",")?
    typ = p_type(p)?
    p_expect(p, ">")?
  } else {
    typ = p_type(p)?
  }
  let name = p_ident(p)?
  p_expect(p, "=")?
  let n = p_int(p)?
  p_skip_opts(p)?
  p_expect(p, ";")?
  m.fields.push(protoparse.Field{name: name, num: n, typ: typ, key: key, repeated: repeated, optional: optional, oneof: oneof})
  Ok(m)
}

fn p_message(var p: P) -> protoparse.Message ! protoparse.ParseErr {
  let name = p_ident(p)?
  p_expect(p, "{")?
  var m = protoparse.Message{name: name, fields: [], oneofs: [], nested: [], enums: []}
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated message `${name}`")) }
    if p_is(p, "message") {
      p.at += 1
      m.nested.push(p_message(p)?)
    } else if p_is(p, "enum") {
      p.at += 1
      m.enums.push(p_enum(p)?)
    } else if p_is(p, "option") || p_is(p, "reserved") || p_is(p, "extensions") {
      p_skip_stmt(p)?
    } else if p_is(p, "extend") || p_is(p, "group") {
      return Err(p_err(p, "`${p_peek(p)}` is not supported"))
    } else if p_is(p, "oneof") {
      p.at += 1
      let on = p_ident(p)?
      p_expect(p, "{")?
      m.oneofs.push(on)
      while !p_is(p, "}") {
        if p.at >= p.ts.len() { return Err(p_err(p, "unterminated oneof `${on}`")) }
        if p_is(p, "option") {
          p_skip_stmt(p)?
        } else {
          m = p_field(p, on, m)?
        }
      }
      p.at += 1
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      m = p_field(p, "", m)?
    }
  }
  p.at += 1
  Ok(m)
}

fn p_service(var p: P) -> protoparse.Service ! protoparse.ParseErr {
  let name = p_ident(p)?
  p_expect(p, "{")?
  var rpcs: List[protoparse.Rpc] = []
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated service `${name}`")) }
    if p_is(p, "option") {
      p_skip_stmt(p)?
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      p_expect(p, "rpc")?
      let rn = p_ident(p)?
      p_expect(p, "(")?
      var cs = false
      if p_is(p, "stream") {
        cs = true
        p.at += 1
      }
      let req = p_type(p)?
      p_expect(p, ")")?
      p_expect(p, "returns")?
      p_expect(p, "(")?
      var ss = false
      if p_is(p, "stream") {
        ss = true
        p.at += 1
      }
      let resp = p_type(p)?
      p_expect(p, ")")?
      if p_is(p, "{") {
        // rpc options block: skip to the matching brace
        var depth = 0
        while p.at < p.ts.len() {
          let t = p.ts[p.at]
          p.at += 1
          if t.kind == protoparse.Kind.Sym && t.text == "{" { depth += 1 }
          if t.kind == protoparse.Kind.Sym && t.text == "}" {
            depth -= 1
            if depth == 0 { break }
          }
        }
      } else {
        p_expect(p, ";")?
      }
      rpcs.push(protoparse.Rpc{name: rn, req: req, resp: resp, client_stream: cs, server_stream: ss})
    }
  }
  p.at += 1
  Ok(protoparse.Service{name: name, rpcs: rpcs})
}

fn parse(src: Str) -> protoparse.File ! protoparse.ParseErr {
  var p = P{ts: tokens(src)?, at: 0}
  var f = protoparse.File{syntax: "proto3", package: "", imports: [], messages: [], enums: [], services: []}
  while p.at < p.ts.len() {
    if p_is(p, "syntax") {
      p.at += 1
      p_expect(p, "=")?
      f.syntax = p_str(p)?
      p_expect(p, ";")?
    } else if p_is(p, "package") {
      p.at += 1
      f.package = p_ident(p)?
      p_expect(p, ";")?
    } else if p_is(p, "import") {
      p.at += 1
      if p_is(p, "public") || p_is(p, "weak") { p.at += 1 }
      f.imports.push(p_str(p)?)
      p_expect(p, ";")?
    } else if p_is(p, "option") {
      p_skip_stmt(p)?
    } else if p_is(p, "message") {
      p.at += 1
      f.messages.push(p_message(p)?)
    } else if p_is(p, "enum") {
      p.at += 1
      f.enums.push(p_enum(p)?)
    } else if p_is(p, "service") {
      p.at += 1
      f.services.push(p_service(p)?)
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      return Err(p_err(p, "unexpected `${p_peek(p)}`"))
    }
  }
  Ok(f)
}

fn g_camel(s: Str) -> Str {
  var sb = BytesBuilder.new()
  for part in s.split("_") {
    let pb = part.bytes()
    if pb.len() == 0 { continue }
    let c = Int(pb[0])
    if c >= 97 && c <= 122 { sb.write(Bytes.from_list([UInt8(c - 32)])) } else { sb.write(pb[0..1]) }
    sb.write(pb[1..])
  }
  sb.freeze().to_str_lossy()
}

/// The Xo type name of a scalar proto type, with the field option it needs.
fn g_scalar(t: Str) -> (Str, Str)? {
  match t {
    "int64" => Some(("Int", ""))
    "int32" => Some(("Int32", ""))
    "uint32" => Some(("UInt32", ""))
    "uint64" => Some(("UInt64", ""))
    "sint32" => Some(("Int32", ",zigzag"))
    "sint64" => Some(("Int", ",zigzag"))
    "fixed32" => Some(("UInt32", ",fixed"))
    "fixed64" => Some(("UInt64", ",fixed"))
    "sfixed32" => Some(("Int32", ",fixed"))
    "sfixed64" => Some(("Int", ",fixed"))
    "double" => Some(("Float", ""))
    "float" => Some(("Float32", ""))
    "bool" => Some(("Bool", ""))
    "string" => Some(("Str", ""))
    "bytes" => Some(("Bytes", ""))
    _ => None
  }
}

/// Every type name declared in the file as (full dotted name inside the package, generated name).
fn g_collect(prefix_dot: Str, prefix_gen: Str, m: protoparse.Message, out: List[(Str, Str)]) -> List[(Str, Str)] {
  var o = out
  let d = "${prefix_dot}${m.name}"
  let g = "${prefix_gen}${m.name}"
  o.push((d, g))
  for e in m.enums { o.push(("${d}.${e.name}", "${g}${e.name}")) }
  for n in m.nested { o = g_collect("${d}.", g, n, o) }
  o
}

/// Resolves a type name used in the scope `scope` (the dotted name of the enclosing message)
/// the way protoc does: the innermost scope that declares the first component wins.
fn g_resolve(typ: Str, scope: Str, names: List[(Str, Str)]) -> Str? {
  var t = typ
  if t.starts_with(".") { t = t[1..] }
  var sc = scope
  while true {
    let cand = if sc == "" { t } else { "${sc}.${t}" }
    for (d, g) in names { if d == cand { return Some(g) } }
    if sc == "" { break }
    let at = sc.last_index_of(".")
    sc = if at >= 0 { sc[0..at] } else { "" }
  }
  // a name qualified by the package: keep the last components that match
  for (d, g) in names { if t.ends_with(".${d}") { return Some(g) } }
  None
}

fn g_enum(e: protoparse.Enum, gname: Str, out: List[Str]) -> List[Str] {
  var o = out
  o.push("enum ${gname}: Int {")
  var seen: List[Int] = []
  for v in e.values {
    // an alias of an earlier number is dropped
    if seen.contains(v.num) { continue }
    seen.push(v.num)
    o.push("  ${g_camel(v.name.to_lower())} = ${v.num}")
  }
  o.push("  Other(v: Int)")
  o.push("}")
  o.push("")
  o
}

fn g_message(m: protoparse.Message, scope: Str, gprefix: Str, names: List[(Str, Str)], out: List[Str]) -> List[Str] ! protoparse.ParseErr {
  var o = out
  let d = "${scope}${m.name}"
  let g = "${gprefix}${m.name}"
  for n in m.nested { o = g_message(n, "${d}.", g, names, o)? }
  for e in m.enums { o = g_enum(e, "${g}${e.name}", o) }
  // oneof enums first
  for on in m.oneofs {
    o.push("enum ${g}${g_camel(on)} {")
    for fl in m.fields {
      if fl.oneof != on { continue }
      let ty = g_type(fl.typ, d, names)?
      o.push("  ${g_camel(fl.name)} as \"${fl.num}\"(v: ${ty.0})")
    }
    o.push("} derive Proto")
    o.push("")
  }
  o.push("struct ${g} {")
  var done: List[Str] = []
  for fl in m.fields {
    if fl.oneof != "" {
      if done.contains(fl.oneof) { continue }
      done.push(fl.oneof)
      o.push("  ${fl.oneof} proto \"oneof\": ${g}${g_camel(fl.oneof)}?")
      continue
    }
    let ty = g_type(fl.typ, d, names)?
    var tx = ty.0
    if fl.key != "" {
      let kt = g_type(fl.key, d, names)?
      tx = "Map[${kt.0}, ${ty.0}]"
    } else if fl.repeated {
      tx = "List[${tx}]"
    } else if fl.optional {
      tx = "${tx}?"
    }
    let opts = if fl.key != "" { "" } else { ty.1 }
    o.push("  ${fl.name} proto \"${fl.num}${opts}\": ${tx}")
  }
  o.push("} derive Proto")
  o.push("")
  Ok(o)
}

fn g_type(typ: Str, scope: Str, names: List[(Str, Str)]) -> (Str, Str) ! protoparse.ParseErr {
  if let Some(s) = g_scalar(typ) { return Ok(s) }
  match g_resolve(typ, scope, names) {
    Some(g) => Ok((g, ""))
    None => Err(protoparse.ParseErr{line: 0, col: 0, msg: "unknown type `${typ}`"})
  }
}

fn gen(f: protoparse.File) -> Str ! protoparse.ParseErr {
  var names: List[(Str, Str)] = []
  for m in f.messages { names = g_collect("", "", m, names) }
  for e in f.enums { names.push((e.name, e.name)) }
  var o: List[Str] = ["use std/protobuf", ""]
  for e in f.enums { o = g_enum(e, e.name, o) }
  for m in f.messages { o = g_message(m, "", "", names, o)? }
  Ok(o.join("\n"))
}
