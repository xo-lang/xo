// std/time on the native backends (decisions 0074 and 0094). std/rt's
// timezone.go, timecivil.go, and timefmt.go are the reference: the same
// rules, texts, and faults. Zone rules (TZif data and its POSIX TZ
// footer) are read and looked up as Go's time package does by
// std/native/llrt/tz.xo (decision 0193 step 5; its C path tz_c.xo over
// std/llrt/xo_time.c); civil time, layouts, formatting, and parsing are
// here.
use std/time
use native/llrt/cabi_time
use native/llrt/testworld
use native/llrt/tz
use native/llrt/tzrules
use native/rt

// ---------------------------------------------------------------------------
// Zones (std.md 13.1)

/// time.Zone: a named zone has the rules of tz.xo (whose id the C
/// runtime gives: 0 for UTC); a fixed zone has `fixed` set and its offset
/// in seconds. A name always gets the same id and the same rules, so `==`
/// compares what the Go backend compares: the name, whether the zone is
/// fixed, and the fixed offset.
struct Zone {
  label: Str
  fixed: Bool
  secs: Int
  rules: tzrules.Rules
}

fn (z: Zone) display() -> Str { z.label }

fn (z: Zone) name() -> Str { z.label }

/// The Debug text: `Zone(Europe/Berlin)` (std/rt's XoDebug).
fn zone_debug(z: Zone) -> Str { "Zone(${z.label})" }

fn (z: Zone) offset_at(t: Time) -> Duration { Duration.from_secs_int(offset_secs(z, unix_secs(t))) }

fn (z: Zone) abbreviation_at(t: Time) -> Str { abbr_at(z, unix_secs(t)) }

fn zoneerr_display(e: time.ZoneErr) -> Str {
  match e {
    time.ZoneErr.Unknown(name) => "unknown time zone ${name.quote()}"
    time.ZoneErr.NoLocal(msg) => "cannot determine the local time zone: ${msg}"
  }
}

fn utc() -> Zone { Zone{label: "UTC", fixed: false, secs: 0, rules: tz.none()} }

fn zone(name: Str) -> Zone ! time.ZoneErr {
  if name == "UTC" {
    return Ok(utc())
  }
  match tz.load(name, false) {
    Some(r) => Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
    None => Err(time.ZoneErr.Unknown(name: name))
  }
}

fn fixed(name: Str, offset: Duration, at: rt.Loc) -> Zone {
  if offset > 24h || offset < -24h {
    rt.fault_at("time.fixed: offset ${offset} is past 24h", at)
  }
  Zone{label: name, fixed: true, secs: offset.nanos() / 1000000000, rules: tz.none()}
}

/// The zone named name from the program's zone data, else from the
/// host's database.
fn load_either(name: Str) -> tzrules.Rules? {
  match tz.load(name, false) {
    Some(r) => Some(r)
    None => tz.load(name, true)
  }
}

fn local(env: Env) -> Zone ! time.ZoneErr uses env {
  match env.get("TZ") {
    Some(tz) => {
      let name = tz.trim_prefix(":")
      if name == "" || name == "UTC" {
        return Ok(utc())
      }
      // the machine's own zone is host dependent anyway: the host
      // database is the fallback
      match load_either(name) {
        Some(r) => Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
        None => Err(time.ZoneErr.Unknown(name: name))
      }
    }
    None => {
      if testworld.fake(16) {
        // a test's Env is a fake one: without TZ it gives UTC
        return Ok(utc())
      }
      let name = tz.local_name()
      if name != "Local" {
        match load_either(name) {
          Some(r) => return Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
          None => {}
        }
      }
      // Go's time.Local: /etc/localtime, else UTC
      let r = match tz.load("Local", true) {
        Some(r) => r
        None => tz.none()
      }
      Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
    }
  }
}

/// The nanoseconds of t since the epoch.
fn ns_of(t: Time) -> Int { (t - Time.UNIX_EPOCH).nanos() }

fn time_of(ns: Int) -> Time { Time.UNIX_EPOCH + Duration.from_nanos(ns) }

fn floor_div(a: Int, b: Int) -> Int {
  let q = a / b
  if a % b != 0 && ((a < 0) != (b < 0)) {
    return q - 1
  }
  q
}

/// The seconds of t since the epoch, rounded down (time.Unix(0, ns)).
fn unix_secs(t: Time) -> Int { floor_div(ns_of(t), 1000000000) }

fn offset_secs(z: Zone, sec: Int) -> Int {
  if z.fixed {
    return z.secs
  }
  tz.offset(z.rules, sec)
}

fn abbr_at(z: Zone, sec: Int) -> Str {
  if z.fixed {
    return z.label
  }
  tz.abbr(z.rules, sec)
}

// ---------------------------------------------------------------------------
// Civil time (std.md 13.2)

/// The days from 1970-01-01 to y-m-d (H. Hinnant's algorithm).
fn days_from_civil(year: Int, m: Int, d: Int) -> Int {
  var y = year
  if m <= 2 {
    y -= 1
  }
  let era = floor_div(y, 400)
  let yoe = y - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

fn date_of(days: Int) -> time.Date {
  let z = days + 719468
  let era = floor_div(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  var y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  var m = mp - 9
  if mp < 10 {
    m = mp + 3
  }
  if m <= 2 {
    y += 1
  }
  time.Date{year: y, month: m, day: d}
}

fn is_leap(y: Int) -> Bool { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

fn days_in(y: Int, m: Int) -> Int {
  if m == 2 {
    if is_leap(y) {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  31
}

/// (year, month) with the month normalized into 1 to 12.
fn norm_month(y: Int, m: Int) -> (Int, Int) {
  let t = y * 12 + (m - 1)
  (floor_div(t, 12), t - floor_div(t, 12) * 12 + 1)
}

/// The day number of d, with the month normalized and the day counted
/// from the first of the month (a struct literal may hold any fields).
fn date_days(d: time.Date) -> Int {
  let (y, m) = norm_month(d.year, d.month)
  days_from_civil(y, m, 1) + d.day - 1
}

/// n in decimal, at least w digits (fmt's %0*d).
fn pad(n: Int, w: Int) -> Str {
  if n < 0 {
    return "-" + pad(-n, w - 1)
  }
  var s = "${n}"
  while s.len() < w {
    s = "0" + s
  }
  s
}

fn valid_date(y: Int, m: Int, d: Int) -> Str {
  if y < 1 || y > 9999 {
    return "year ${y} out of range 1 to 9999"
  }
  if m < 1 || m > 12 {
    return "month ${m} out of range 1 to 12"
  }
  if d < 1 || d > days_in(y, m) {
    return "day ${d} out of range 1 to ${days_in(y, m)} for ${pad(y, 4)}-${pad(m, 2)}"
  }
  ""
}

fn valid_clock(c: time.ClockTime) -> Str {
  if c.hour < 0 || c.hour > 23 {
    return "hour ${c.hour} out of range 0 to 23"
  }
  if c.minute < 0 || c.minute > 59 {
    return "minute ${c.minute} out of range 0 to 59"
  }
  if c.second < 0 || c.second > 59 {
    return "second ${c.second} out of range 0 to 59"
  }
  if c.nanos < 0 || c.nanos > 999999999 {
    return "nanos ${c.nanos} out of range 0 to 999999999"
  }
  ""
}

fn date(year: Int, month: Int, day: Int) -> time.Date ! time.CivilErr {
  let msg = valid_date(year, month, day)
  if msg != "" {
    return Err(time.CivilErr.Invalid(msg: msg))
  }
  Ok(time.Date{year: year, month: month, day: day})
}

fn civil(t: Time, z: Zone) -> time.Civil {
  let ns = ns_of(t)
  let sec = floor_div(ns, 1000000000)
  var nanos = ns % 1000000000
  if nanos < 0 {
    nanos += 1000000000
  }
  let off = offset_secs(z, sec)
  let local = sec + off
  let days = floor_div(local, 86400)
  let rem = local - days * 86400
  time.Civil{
    date: date_of(days),
    time: time.ClockTime{hour: rem / 3600, minute: rem / 60 % 60, second: rem % 60, nanos: nanos},
    offset: Duration.from_secs_int(off),
    zone: z.label,
  }
}

/// Time ranges over Int nanoseconds: about 1677-09-21 to 2262-04-11.
const MIN_TIME_SECS: Int = -9223372035
const MAX_TIME_SECS: Int = 9223372035

fn clamp_secs(s: Int) -> Int {
  if s < MIN_TIME_SECS {
    return MIN_TIME_SECS
  }
  if s > MAX_TIME_SECS {
    return MAX_TIME_SECS
  }
  s
}

/// The instants of local seconds (the civil time read as if in UTC) in z:
/// (early, late, kind), kind 0 for one instant, 2 for a gap (none), 3 for
/// an overlap (two).
fn civil_instant(local: Int, z: Zone) -> (Int, Int, Int) {
  let span = 2 * 86400
  let before = offset_secs(z, clamp_secs(local - span))
  let after = offset_secs(z, clamp_secs(local + span))
  let tb = local - before
  let ta = local - after
  let ok_b = offset_secs(z, clamp_secs(tb)) == before
  let ok_a = offset_secs(z, clamp_secs(ta)) == after
  if before == after {
    if ok_b {
      return (tb, tb, 0)
    }
    // a transition and its reversal within the window: the offset at the
    // naive instant
    let off = offset_secs(z, clamp_secs(local))
    return (local - off, local - off, 0)
  }
  if ok_b && ok_a {
    if tb < ta {
      return (tb, ta, 3)
    }
    return (ta, tb, 3)
  }
  if ok_b {
    return (tb, tb, 0)
  }
  if ok_a {
    return (ta, ta, 0)
  }
  // a gap: Earlier uses the offset before the change, Later the one after
  (tb, ta, 2)
}

fn instant(d: time.Date, c: time.ClockTime, z: Zone, ambiguity: time.Ambiguity = time.Ambiguity.Reject) -> Time ! time.CivilErr {
  let bad_date = valid_date(d.year, d.month, d.day)
  if bad_date != "" {
    return Err(time.CivilErr.Invalid(msg: bad_date))
  }
  let bad_clock = valid_clock(c)
  if bad_clock != "" {
    return Err(time.CivilErr.Invalid(msg: bad_clock))
  }
  let local = days_from_civil(d.year, d.month, d.day) * 86400 + c.hour * 3600 + c.minute * 60 + c.second
  let (early, late, kind) = civil_instant(local, z)
  let at = "${pad(d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}T${pad(c.hour, 2)}:${pad(c.minute, 2)}:${pad(c.second, 2)} ${z.label}"
  var secs = early
  if kind != 0 {
    match ambiguity {
      time.Ambiguity.Reject => {
        if kind == 2 {
          return Err(time.CivilErr.Skipped(at: at))
        }
        return Err(time.CivilErr.Repeated(at: at))
      }
      time.Ambiguity.Later => {
        secs = late
      }
      time.Ambiguity.Earlier => {}
    }
  }
  if secs < MIN_TIME_SECS || secs > MAX_TIME_SECS {
    return Err(time.CivilErr.Invalid(msg: "${at} is outside the range of Time (1678 to 2262)"))
  }
  Ok(time_of(secs * 1000000000 + c.nanos))
}

fn civilerr_display(e: time.CivilErr) -> Str {
  match e {
    time.CivilErr.Invalid(msg) => "invalid civil time: ${msg}"
    time.CivilErr.Skipped(at) => "${at} does not exist (skipped by a daylight saving change)"
    time.CivilErr.Repeated(at) => "${at} happens twice (repeated by a daylight saving change)"
  }
}

/// Monday is 0.
fn weekday_index(days: Int) -> Int {
  let w = days + 3
  w - floor_div(w, 7) * 7
}

fn weekday_of(i: Int) -> time.Weekday {
  match i {
    0 => time.Weekday.Monday
    1 => time.Weekday.Tuesday
    2 => time.Weekday.Wednesday
    3 => time.Weekday.Thursday
    4 => time.Weekday.Friday
    5 => time.Weekday.Saturday
    _ => time.Weekday.Sunday
  }
}

fn date_weekday(d: time.Date) -> time.Weekday { weekday_of(weekday_index(date_days(d))) }

fn date_add_days(d: time.Date, n: Int) -> time.Date { date_of(date_days(d) + n) }

fn date_add_months(d: time.Date, n: Int) -> time.Date {
  let (y, m) = norm_month(d.year, d.month + n)
  var day = d.day
  if day < 1 {
    day = 1
  }
  if day > days_in(y, m) {
    day = days_in(y, m)
  }
  time.Date{year: y, month: m, day: day}
}

fn date_days_until(d: time.Date, o: time.Date) -> Int { date_days(o) - date_days(d) }

fn date_display(d: time.Date) -> Str {
  if d.year < 0 {
    return "-${pad(-d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}"
  }
  "${pad(d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}"
}

// ---------------------------------------------------------------------------
// Layouts (std.md 13.3): named fields, as std/rt's TimeLayoutParse

/// A piece of a layout: literal text (field "") or a field and its
/// argument.
struct Item {
  lit: Str
  field: Str
  arg: Str
  /// The field as a number (field_code), so format and parse switch on
  /// an integer instead of comparing names.
  code: Int = 0
}

/// The code of a field name (0 for an unknown one): the length and first
/// byte pick the candidate and one comparison confirms it.
fn field_code(name: Str) -> Int {
  let b = name.bytes()
  if b.is_empty() {
    return 0
  }
  let c = b[0]
  var code = 0
  var want = ""
  match b.len() {
    3 => {
      code = 3
      want = "day"
    }
    4 => {
      if c == 121 {
        code = 1
        want = "year"
      } else if c == 104 {
        code = 5
        want = "hour"
      } else if c == 97 {
        code = 7
        want = "ampm"
      } else if c == 102 {
        code = 10
        want = "frac"
      } else if c == 122 {
        code = 12
        want = "zone"
      }
    }
    5 => {
      code = 2
      want = "month"
    }
    6 => {
      if c == 104 {
        code = 6
        want = "hour12"
      } else if c == 109 {
        code = 8
        want = "minute"
      } else if c == 115 {
        code = 9
        want = "second"
      } else if c == 111 {
        code = 11
        want = "offset"
      } else if c == 108 {
        code = 13
        want = "lbrace"
      } else if c == 114 {
        code = 14
        want = "rbrace"
      }
    }
    7 => {
      code = 4
      want = "weekday"
    }
    _ => {}
  }
  if code != 0 && name == want { code } else { 0 }
}

/// The arguments field takes ("" is the field without one), or None for
/// an unknown field.
fn field_args(name: Str) -> List[Str]? {
  match name {
    "year" => Some([""])
    "month" => Some(["", "1", "short", "name"])
    "day" => Some(["", "1"])
    "weekday" => Some(["short", "name"])
    "hour" => Some([""])
    "hour12" => Some([""])
    "ampm" => Some([""])
    "minute" => Some([""])
    "second" => Some([""])
    "frac" => Some(["", "1", "2", "3", "4", "5", "6", "7", "8", "9"])
    "offset" => Some(["", "compact"])
    "zone" => Some([""])
    "lbrace" => Some([""])
    "rbrace" => Some([""])
    _ => None
  }
}

/// Whether `{name}` or `{name:arg}` is a field of a layout (field_args
/// without the list).
fn field_ok(code: Int, arg: Str, has_arg: Bool) -> Bool {
  if has_arg && arg == "" {
    return false
  }
  match code {
    2 => !has_arg || arg is "1" | "short" | "name"
    3 => !has_arg || arg == "1"
    4 => has_arg && arg is "short" | "name"
    10 => !has_arg || (arg.len() == 1 && arg >= "1" && arg <= "9")
    11 => !has_arg || arg == "compact"
    1 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 => !has_arg
    _ => false
  }
}

fn args_text(name: Str, args: List[Str]) -> Str {
  if name == "frac" {
    return "the forms are {frac}, {frac:1} to {frac:9}"
  }
  var forms: List[Str] = []
  for a in args {
    if a == "" {
      forms.push("{${name}}")
    } else {
      forms.push("{${name}:${a}}")
    }
  }
  "the forms are ${forms.join(", ")}"
}

/// The items of a layout, or the reason it is bad.
fn layout_items(layout: Str) -> List[Item] ! Str {
  let b = layout.bytes()
  let n = b.len()
  var items: List[Item] = []
  var lit = ""
  var start = 0
  var hour12 = false
  var ampm = false
  var i = 0
  while i < n {
    if b[i] == 125 {
      return Err("unmatched } (a literal brace is written {rbrace})")
    }
    if b[i] != 123 {
      i += 1
      continue
    }
    lit = lit + layout[start..i]
    var j = i + 1
    while j < n && b[j] != 123 && b[j] != 125 {
      j += 1
    }
    if j >= n || b[j] == 123 {
      return Err("unclosed { (a literal brace is written {lbrace})")
    }
    let body = layout[i + 1..j]
    var name = body
    var arg = ""
    var has_arg = false
    match body.find(":") {
      Some(k) => {
        name = body[0..k]
        arg = body[k + 1..]
        has_arg = true
      }
      None => {}
    }
    // a valid field is checked without building its argument list; the
    // list is built only for the error text
    let code = field_code(name)
    if !field_ok(code, arg, has_arg) {
      match field_args(name) {
        None => return Err("unknown field {${body}}")
        Some(args) => return Err("{${body}}: ${args_text(name, args)}")
      }
    }
    if code == 13 {
      lit = lit + "{"
    } else if code == 14 {
      lit = lit + "}"
    } else {
      if lit != "" {
        items.push(Item{lit: lit, field: "", arg: ""})
        lit = ""
      }
      items.push(Item{lit: "", field: name, arg: arg, code: code})
      if code == 6 {
        hour12 = true
      }
      if code == 7 {
        ampm = true
      }
    }
    i = j + 1
    start = i
  }
  lit = lit + layout[start..n]
  if lit != "" {
    items.push(Item{lit: lit, field: "", arg: ""})
  }
  if hour12 && !ampm {
    return Err("{hour12} needs {ampm} (or use {hour}, 00 to 23)")
  }
  Ok(items)
}

/// The items of a layout; a bad one faults (a bug, like a bad index).
fn layout_or_fault(fname: Str, layout: Str, at: rt.Loc) -> List[Item] {
  match layout_items(layout) {
    Ok(items) => items
    Err(msg) => rt.fault_at("time.${fname}: bad layout ${layout.quote()}: ${msg} (check layouts built at run time with time.check_layout)", at)
  }
}

fn check_layout(layout: Str) -> () ! time.LayoutErr {
  match layout_items(layout) {
    Ok(_) => Ok(())
    Err(msg) => Err(time.LayoutErr{layout: layout, msg: msg})
  }
}

fn layouterr_display(e: time.LayoutErr) -> Str { "bad layout ${e.layout.quote()}: ${e.msg}" }

fn parseerr_display(e: time.ParseErr) -> Str { "at byte ${e.at} of ${e.input.quote()}: ${e.msg}" }

fn month_short() -> List[Str] { ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] }

fn month_name() -> List[Str] { ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"] }

fn weekday_short() -> List[Str] { ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }

fn weekday_name() -> List[Str] { ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] }

fn format(t: Time, z: Zone, layout: Str, at: rt.Loc) -> Str {
  let items = layout_or_fault("format", layout, at)
  let ns = ns_of(t)
  let sec = floor_div(ns, 1000000000)
  var nanos = ns % 1000000000
  if nanos < 0 {
    nanos += 1000000000
  }
  let off = offset_secs(z, sec)
  let local = sec + off
  let days = floor_div(local, 86400)
  let rem = local - days * 86400
  let d = date_of(days)
  let hour = rem / 3600
  var out = ""
  for it in items {
    match it.code {
      0 => {
        out = out + it.lit
      }
      1 => {
        out = out + pad(d.year, 4)
      }
      2 => {
        if it.arg == "" {
          out = out + pad(d.month % 100, 2)
        } else if it.arg == "1" {
          out = out + "${d.month}"
        } else if it.arg == "short" {
          out = out + month_short()[d.month - 1]
        } else {
          out = out + month_name()[d.month - 1]
        }
      }
      3 => {
        if it.arg == "1" {
          out = out + "${d.day}"
        } else {
          out = out + pad(d.day % 100, 2)
        }
      }
      4 => {
        let w = weekday_index(days)
        if it.arg == "short" {
          out = out + weekday_short()[w]
        } else {
          out = out + weekday_name()[w]
        }
      }
      5 => {
        out = out + pad(hour, 2)
      }
      6 => {
        var h = hour % 12
        if h == 0 {
          h = 12
        }
        out = out + pad(h, 2)
      }
      7 => {
        if hour < 12 {
          out = out + "AM"
        } else {
          out = out + "PM"
        }
      }
      8 => {
        out = out + pad(rem / 60 % 60, 2)
      }
      9 => {
        out = out + pad(rem % 60, 2)
      }
      10 => {
        var digits = pad(nanos, 9)
        if it.arg == "" {
          while digits.ends_with("0") {
            digits = digits[0..digits.len() - 1]
          }
        } else {
          let k = Int.parse(it.arg) ?? 9
          digits = digits[0..k]
        }
        if digits != "" {
          out = out + "." + digits
        }
      }
      11 => {
        if off == 0 && it.arg == "" {
          out = out + "Z"
        } else {
          // Go's sign is the offset's in whole minutes: -59s is +00:00
          var o = off
          var sign = "+"
          if o / 60 < 0 {
            sign = "-"
          }
          if o < 0 {
            o = -o
          }
          out = out + sign + pad(o / 3600 % 100, 2)
          if it.arg == "" {
            out = out + ":"
          }
          out = out + pad(o / 60 % 60, 2)
        }
      }
      _ => {
        out = out + abbr_at(z, sec)
      }
    }
  }
  out
}

/// The digits of b at pos, at most hi: (value, count).
fn read_digits(b: Bytes, pos: Int, hi: Int) -> (Int, Int) {
  var n = 0
  var v = 0
  while n < hi && pos + n < b.len() && b[pos + n] >= 48 && b[pos + n] <= 57 {
    v = v * 10 + Int(b[pos + n]) - 48
    n += 1
  }
  (v, n)
}

/// The longest of names at pos of s: (index, length), or (-1, 0).
fn read_word(s: Str, pos: Int, names: List[Str]) -> (Int, Int) {
  let rest = s[pos..]
  var best = -1
  var len = 0
  for (i, nm) in names.indexed() {
    if rest.starts_with(nm) && (best < 0 || nm.len() > len) {
      best = i
      len = nm.len()
    }
  }
  (best, len)
}

fn digit_text(lo: Int, hi: Int) -> Str {
  if lo == hi {
    return "${lo} digit"
  }
  if hi == lo + 1 {
    return "${lo} or ${hi} digit"
  }
  "${lo} to ${hi} digit"
}

fn parse(s: Str, layout: Str, z: Zone, at: rt.Loc) -> Time ! time.ParseErr {
  let items = layout_or_fault("parse", layout, at)
  let b = s.bytes()
  let n = b.len()
  var pos = 0
  var year = 1970
  var month = 1
  var day = 1
  var hour = 0
  var minute = 0
  var second = 0
  var nanos = 0
  var hour12 = 0
  var off = 0
  var has_off = false
  var has12 = false
  var pm = false
  var weekday = -1
  var weekday_at = 0
  var abbr = ""
  var abbr_at_pos = -1
  var day_at = 0
  for it in items {
    let start = pos
    if it.code == 0 {
      if !s[pos..].starts_with(it.lit) {
        return perr(s, layout, start, "expected ${it.lit.quote()}")
      }
      pos += it.lit.len()
      continue
    }
    // a number field: what, digits lo to hi, range min to max
    var what = ""
    var lo = 2
    var hi = 2
    var min = 0
    var max = 0
    match it.code {
      1 => {
        what = "year"
        lo = 4
        hi = 4
        min = 1
        max = 9999
      }
      2 => {
        if it.arg == "" || it.arg == "1" {
          what = "month"
          if it.arg == "1" {
            lo = 1
          }
          min = 1
          max = 12
        } else {
          var names = month_short()
          if it.arg == "name" {
            names = month_name()
          }
          let (i, len) = read_word(s, pos, names)
          if i < 0 {
            return perr(s, layout, start, "expected a month name such as ${names[0].quote()}")
          }
          month = i + 1
          pos += len
        }
      }
      3 => {
        day_at = start
        what = "day"
        if it.arg == "1" {
          lo = 1
        }
        min = 1
        max = 31
      }
      4 => {
        var names = weekday_short()
        if it.arg == "name" {
          names = weekday_name()
        }
        let (i, len) = read_word(s, pos, names)
        if i < 0 {
          return perr(s, layout, start, "expected a weekday name such as ${names[0].quote()}")
        }
        weekday = i
        weekday_at = start
        pos += len
      }
      5 => {
        what = "hour"
        max = 23
      }
      6 => {
        what = "hour12"
        min = 1
        max = 12
      }
      7 => {
        let rest = s[pos..]
        if rest.starts_with("PM") {
          pm = true
        } else if !rest.starts_with("AM") {
          return perr(s, layout, start, "expected AM or PM")
        }
        pos += 2
      }
      8 => {
        what = "minute"
        max = 59
      }
      9 => {
        what = "second"
        max = 59
      }
      10 => {
        var k = 0
        if it.arg != "" {
          k = Int.parse(it.arg) ?? 0
        }
        if pos >= n || b[pos] != 46 {
          if k > 0 {
            return perr(s, layout, start, "expected \".\" and ${k} digit fraction")
          }
        } else {
          pos += 1
          let fstart = pos
          var flo = 1
          var fhi = 9
          if k > 0 {
            flo = k
            fhi = k
          }
          let (v, cnt) = read_digits(b, pos, fhi)
          if cnt < flo {
            return perr(s, layout, fstart, "expected ${digit_text(flo, fhi)} fraction")
          }
          pos += cnt
          var f = v
          var c = cnt
          while c < 9 {
            f = f * 10
            c += 1
          }
          nanos = f
        }
      }
      11 => {
        var bad = "expected an offset: +hhmm"
        if it.arg == "" {
          bad = "expected an offset: Z or +hh:mm"
        }
        if it.arg == "" && pos < n && b[pos] == 90 {
          pos += 1
          has_off = true
          off = 0
        } else {
          if pos >= n || (b[pos] != 43 && b[pos] != 45) {
            return perr(s, layout, start, bad)
          }
          let neg = b[pos] == 45
          pos += 1
          let (h, hn) = read_digits(b, pos, 2)
          if hn < 2 {
            return perr(s, layout, start, bad)
          }
          pos += 2
          if it.arg == "" {
            if pos >= n || b[pos] != 58 {
              return perr(s, layout, start, bad)
            }
            pos += 1
          }
          let (m, mn) = read_digits(b, pos, 2)
          if mn < 2 || h > 23 || m > 59 {
            return perr(s, layout, start, bad)
          }
          pos += 2
          off = h * 3600 + m * 60
          if neg {
            off = -off
          }
          has_off = true
        }
      }
      _ => {
        // zone
        var k = 0
        while pos + k < n && zone_char(b[pos + k]) {
          k += 1
        }
        if k == 0 {
          return perr(s, layout, start, "expected a zone abbreviation such as \"UTC\"")
        }
        abbr = s[pos..pos + k]
        abbr_at_pos = start
        pos += k
      }
    }
    if what != "" {
      let (v, cnt) = read_digits(b, pos, hi)
      var name = what
      if what == "hour12" {
        name = "hour"
      }
      if cnt < lo {
        return perr(s, layout, start, "expected ${digit_text(lo, hi)} ${name}")
      }
      if v < min || v > max {
        return perr(s, layout, start, "${name} ${v} out of range ${min} to ${max}")
      }
      pos += cnt
      match what {
        "year" => {
          year = v
        }
        "month" => {
          month = v
        }
        "day" => {
          day = v
        }
        "hour" => {
          hour = v
        }
        "hour12" => {
          hour12 = v
          has12 = true
        }
        "minute" => {
          minute = v
        }
        _ => {
          second = v
        }
      }
    }
  }
  if pos < n {
    return perr(s, layout, pos, "extra text after the layout: ${s[pos..].quote()}")
  }
  if day > days_in(year, month) {
    return perr(s, layout, day_at, "day ${day} out of range 1 to ${days_in(year, month)} for ${pad(year, 4)}-${pad(month, 2)}")
  }
  if has12 {
    hour = hour12 % 12
    if pm {
      hour += 12
    }
  }
  let days = days_from_civil(year, month, day)
  if weekday >= 0 {
    let want = weekday_index(days)
    if want != weekday {
      return perr(s, layout, weekday_at, "weekday ${weekday_name()[weekday]} does not match ${pad(year, 4)}-${pad(month, 2)}-${pad(day, 2)}, a ${weekday_name()[want]}")
    }
  }
  let local = days * 86400 + hour * 3600 + minute * 60 + second
  let when = "${pad(year, 4)}-${pad(month, 2)}-${pad(day, 2)}T${pad(hour, 2)}:${pad(minute, 2)}:${pad(second, 2)}"
  var secs = local
  if has_off {
    secs = local - off
  } else if abbr != "" {
    let (early, late, _) = civil_instant(local, z)
    var found = false
    for c in [early, late] {
      if !found && c > MIN_TIME_SECS && c < MAX_TIME_SECS && abbr_at(z, c) == abbr {
        secs = c
        found = true
      }
    }
    if !found {
      if abbr != "UTC" && abbr != "GMT" {
        return perr(s, layout, abbr_at_pos, "zone abbreviation ${abbr.quote()} is not used by ${z.label} at ${when}")
      }
      secs = local
    }
  } else {
    let (early, _, kind) = civil_instant(local, z)
    if kind == 2 {
      return perr(s, layout, 0, "${when} does not exist in ${z.label} (skipped by a daylight saving change); the layout needs {offset}")
    }
    if kind == 3 {
      return perr(s, layout, 0, "${when} happens twice in ${z.label} (repeated by a daylight saving change); the layout needs {offset} or {zone}")
    }
    secs = early
  }
  if secs <= MIN_TIME_SECS || secs >= MAX_TIME_SECS {
    return perr(s, layout, 0, "${when} is outside the range of Time (1678 to 2262)")
  }
  Ok(time_of(secs * 1000000000 + nanos))
}

fn perr(s: Str, layout: Str, at: Int, msg: Str) -> Time ! time.ParseErr { Err(time.ParseErr{input: s, layout: layout, at: at, msg: msg}) }

fn zone_char(c: UInt8) -> Bool { c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 43 || c == 45 }
