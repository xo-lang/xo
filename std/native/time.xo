// std/time on the native backends (decisions 0074 and 0094). std/rt's
// timezone.go, timecivil.go, and timefmt.go are the reference: the same
// rules, texts, and faults. Zone rules (TZif data and its POSIX TZ
// footer) are read and looked up as Go's time package does by
// std/native/llrt/tz.xo (decision 0193 step 5; its C path tz_c.xo over
// std/llrt/xo_time.c); civil time, layouts, formatting, and parsing are
// here.
use std/time
use native/llrt/cabi_time
use native/llrt/testworld
use native/llrt/tz
use native/llrt/tzrules
use native/rt

// ---------------------------------------------------------------------------
// Zones (std.md 13.1)

/// time.Zone: a named zone has the rules of tz.xo (whose id the C
/// runtime gives: 0 for UTC); a fixed zone has `fixed` set and its offset
/// in seconds. A name always gets the same id and the same rules, so `==`
/// compares what the Go backend compares: the name, whether the zone is
/// fixed, and the fixed offset.
struct Zone {
  label: Str
  fixed: Bool
  secs: Int
  rules: tzrules.Rules
}

fn (z: Zone) display() -> Str { z.label }

fn (z: Zone) name() -> Str { z.label }

/// The Debug text: `Zone(Europe/Berlin)` (std/rt's XoDebug).
fn zone_debug(z: Zone) -> Str { "Zone(${z.label})" }

fn (z: Zone) offset_at(t: Time) -> Duration { Duration.from_secs_int(offset_secs(z, unix_secs(t))) }

fn (z: Zone) abbreviation_at(t: Time) -> Str { abbr_at(z, unix_secs(t)) }

fn zoneerr_display(e: time.ZoneErr) -> Str {
  match e {
    time.ZoneErr.Unknown(name) => "unknown time zone ${name.quote()}"
    time.ZoneErr.NoLocal(msg) => "cannot determine the local time zone: ${msg}"
  }
}

fn utc() -> Zone { Zone{label: "UTC", fixed: false, secs: 0, rules: tz.none()} }

fn zone(name: Str) -> Zone ! time.ZoneErr {
  if name == "UTC" {
    return Ok(utc())
  }
  match tz.load(name, false) {
    Some(r) => Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
    None => Err(time.ZoneErr.Unknown(name: name))
  }
}

fn fixed(name: Str, offset: Duration, at: rt.Loc) -> Zone {
  if offset > 24h || offset < -24h {
    rt.fault_at("time.fixed: offset ${offset} is past 24h", at)
  }
  Zone{label: name, fixed: true, secs: offset.nanos() / 1000000000, rules: tz.none()}
}

/// The zone named name from the program's zone data, else from the
/// host's database.
fn load_either(name: Str) -> tzrules.Rules? {
  match tz.load(name, false) {
    Some(r) => Some(r)
    None => tz.load(name, true)
  }
}

fn local(env: Env) -> Zone ! time.ZoneErr uses env {
  match env.get("TZ") {
    Some(tz) => {
      let name = tz.trim_prefix(":")
      if name == "" || name == "UTC" {
        return Ok(utc())
      }
      // the machine's own zone is host dependent anyway: the host
      // database is the fallback
      match load_either(name) {
        Some(r) => Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
        None => Err(time.ZoneErr.Unknown(name: name))
      }
    }
    None => {
      if testworld.fake(16) {
        // a test's Env is a fake one: without TZ it gives UTC
        return Ok(utc())
      }
      let name = tz.local_name()
      if name != "Local" {
        match load_either(name) {
          Some(r) => return Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
          None => {}
        }
      }
      // Go's time.Local: /etc/localtime, else UTC
      let r = match tz.load("Local", true) {
        Some(r) => r
        None => tz.none()
      }
      Ok(Zone{label: name, fixed: false, secs: 0, rules: r})
    }
  }
}

/// The nanoseconds of t since the epoch.
fn ns_of(t: Time) -> Int { (t - Time.UNIX_EPOCH).nanos() }

fn time_of(ns: Int) -> Time { Time.UNIX_EPOCH + Duration.from_nanos(ns) }

fn floor_div(a: Int, b: Int) -> Int {
  let q = a / b
  if a % b != 0 && ((a < 0) != (b < 0)) {
    return q - 1
  }
  q
}

/// The seconds of t since the epoch, rounded down (time.Unix(0, ns)).
fn unix_secs(t: Time) -> Int { floor_div(ns_of(t), 1000000000) }

fn offset_secs(z: Zone, sec: Int) -> Int {
  if z.fixed {
    return z.secs
  }
  tz.offset(z.rules, sec)
}

fn abbr_at(z: Zone, sec: Int) -> Str {
  if z.fixed {
    return z.label
  }
  tz.abbr(z.rules, sec)
}

// ---------------------------------------------------------------------------
// Civil time (std.md 13.2)

/// The days from 1970-01-01 to y-m-d (H. Hinnant's algorithm).
fn days_from_civil(year: Int, m: Int, d: Int) -> Int {
  var y = year
  if m <= 2 {
    y -= 1
  }
  let era = floor_div(y, 400)
  let yoe = y - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

fn date_of(days: Int) -> time.Date {
  let z = days + 719468
  let era = floor_div(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  var y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  var m = mp - 9
  if mp < 10 {
    m = mp + 3
  }
  if m <= 2 {
    y += 1
  }
  time.Date{year: y, month: m, day: d}
}

fn is_leap(y: Int) -> Bool { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

fn days_in(y: Int, m: Int) -> Int {
  if m == 2 {
    if is_leap(y) {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  31
}

/// (year, month) with the month normalized into 1 to 12.
fn norm_month(y: Int, m: Int) -> (Int, Int) {
  let t = y * 12 + (m - 1)
  (floor_div(t, 12), t - floor_div(t, 12) * 12 + 1)
}

/// The day number of d, with the month normalized and the day counted
/// from the first of the month (a struct literal may hold any fields).
fn date_days(d: time.Date) -> Int {
  let (y, m) = norm_month(d.year, d.month)
  days_from_civil(y, m, 1) + d.day - 1
}

/// n in decimal, at least w digits (fmt's %0*d).
fn pad(n: Int, w: Int) -> Str {
  if n < 0 {
    return "-" + pad(-n, w - 1)
  }
  var s = "${n}"
  while s.len() < w {
    s = "0" + s
  }
  s
}

fn valid_date(y: Int, m: Int, d: Int) -> Str {
  if y < 1 || y > 9999 {
    return "year ${y} out of range 1 to 9999"
  }
  if m < 1 || m > 12 {
    return "month ${m} out of range 1 to 12"
  }
  if d < 1 || d > days_in(y, m) {
    return "day ${d} out of range 1 to ${days_in(y, m)} for ${pad(y, 4)}-${pad(m, 2)}"
  }
  ""
}

fn valid_clock(c: time.ClockTime) -> Str {
  if c.hour < 0 || c.hour > 23 {
    return "hour ${c.hour} out of range 0 to 23"
  }
  if c.minute < 0 || c.minute > 59 {
    return "minute ${c.minute} out of range 0 to 59"
  }
  if c.second < 0 || c.second > 59 {
    return "second ${c.second} out of range 0 to 59"
  }
  if c.nanos < 0 || c.nanos > 999999999 {
    return "nanos ${c.nanos} out of range 0 to 999999999"
  }
  ""
}

fn date(year: Int, month: Int, day: Int) -> time.Date ! time.CivilErr {
  let msg = valid_date(year, month, day)
  if msg != "" {
    return Err(time.CivilErr.Invalid(msg: msg))
  }
  Ok(time.Date{year: year, month: month, day: day})
}

fn civil(t: Time, z: Zone) -> time.Civil {
  let ns = ns_of(t)
  let sec = floor_div(ns, 1000000000)
  var nanos = ns % 1000000000
  if nanos < 0 {
    nanos += 1000000000
  }
  let off = offset_secs(z, sec)
  let local = sec + off
  let days = floor_div(local, 86400)
  let rem = local - days * 86400
  time.Civil{
    date: date_of(days),
    time: time.ClockTime{hour: rem / 3600, minute: rem / 60 % 60, second: rem % 60, nanos: nanos},
    offset: Duration.from_secs_int(off),
    zone: z.label,
  }
}

/// Time ranges over Int nanoseconds: about 1677-09-21 to 2262-04-11.
const MIN_TIME_SECS: Int = -9223372035
const MAX_TIME_SECS: Int = 9223372035

fn clamp_secs(s: Int) -> Int {
  if s < MIN_TIME_SECS {
    return MIN_TIME_SECS
  }
  if s > MAX_TIME_SECS {
    return MAX_TIME_SECS
  }
  s
}

/// The instants of local seconds (the civil time read as if in UTC) in z:
/// (early, late, kind), kind 0 for one instant, 2 for a gap (none), 3 for
/// an overlap (two).
fn civil_instant(local: Int, z: Zone) -> (Int, Int, Int) {
  let span = 2 * 86400
  let before = offset_secs(z, clamp_secs(local - span))
  let after = offset_secs(z, clamp_secs(local + span))
  let tb = local - before
  let ta = local - after
  let ok_b = offset_secs(z, clamp_secs(tb)) == before
  let ok_a = offset_secs(z, clamp_secs(ta)) == after
  if before == after {
    if ok_b {
      return (tb, tb, 0)
    }
    // a transition and its reversal within the window: the offset at the
    // naive instant
    let off = offset_secs(z, clamp_secs(local))
    return (local - off, local - off, 0)
  }
  if ok_b && ok_a {
    if tb < ta {
      return (tb, ta, 3)
    }
    return (ta, tb, 3)
  }
  if ok_b {
    return (tb, tb, 0)
  }
  if ok_a {
    return (ta, ta, 0)
  }
  // a gap: Earlier is the earlier instant (the offset after the change
  // applied, 01:30 EST for 02:30), Later the later one (the offset before,
  // 03:30 EDT), as Temporal's disambiguation and the overlap case
  if tb < ta {
    return (tb, ta, 2)
  }
  (ta, tb, 2)
}

fn instant(d: time.Date, c: time.ClockTime, z: Zone, ambiguity: time.Ambiguity = time.Ambiguity.Reject) -> Time ! time.CivilErr {
  let bad_date = valid_date(d.year, d.month, d.day)
  if bad_date != "" {
    return Err(time.CivilErr.Invalid(msg: bad_date))
  }
  let bad_clock = valid_clock(c)
  if bad_clock != "" {
    return Err(time.CivilErr.Invalid(msg: bad_clock))
  }
  let local = days_from_civil(d.year, d.month, d.day) * 86400 + c.hour * 3600 + c.minute * 60 + c.second
  let (early, late, kind) = civil_instant(local, z)
  let at = "${pad(d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}T${pad(c.hour, 2)}:${pad(c.minute, 2)}:${pad(c.second, 2)} ${z.label}"
  var secs = early
  if kind != 0 {
    match ambiguity {
      time.Ambiguity.Reject => {
        if kind == 2 {
          return Err(time.CivilErr.Skipped(at: at))
        }
        return Err(time.CivilErr.Repeated(at: at))
      }
      time.Ambiguity.Later => {
        secs = late
      }
      time.Ambiguity.Earlier => {}
    }
  }
  if secs < MIN_TIME_SECS || secs > MAX_TIME_SECS {
    return Err(time.CivilErr.Invalid(msg: "${at} is outside the range of Time (1678 to 2262)"))
  }
  Ok(time_of(secs * 1000000000 + c.nanos))
}

fn civilerr_display(e: time.CivilErr) -> Str {
  match e {
    time.CivilErr.Invalid(msg) => "invalid civil time: ${msg}"
    time.CivilErr.Skipped(at) => "${at} does not exist (skipped by a daylight saving change)"
    time.CivilErr.Repeated(at) => "${at} happens twice (repeated by a daylight saving change)"
  }
}

/// Monday is 0.
fn weekday_index(days: Int) -> Int {
  let w = days + 3
  w - floor_div(w, 7) * 7
}

fn weekday_of(i: Int) -> time.Weekday {
  match i {
    0 => time.Weekday.Monday
    1 => time.Weekday.Tuesday
    2 => time.Weekday.Wednesday
    3 => time.Weekday.Thursday
    4 => time.Weekday.Friday
    5 => time.Weekday.Saturday
    _ => time.Weekday.Sunday
  }
}

fn date_weekday(d: time.Date) -> time.Weekday { weekday_of(weekday_index(date_days(d))) }

// ---- decision 0414: Weekday numbers, truncate and round, Ticker ----

fn weekday_from(n: Int) -> time.Weekday? {
  if n < 1 || n > 7 {
    return None
  }
  Some(weekday_of(n - 1))
}

fn weekday_number(w: time.Weekday) -> Int {
  match w {
    time.Weekday.Monday => 1
    time.Weekday.Tuesday => 2
    time.Weekday.Wednesday => 3
    time.Weekday.Thursday => 4
    time.Weekday.Friday => 5
    time.Weekday.Saturday => 6
    time.Weekday.Sunday => 7
  }
}

/// The nanoseconds from January 1 of year 1 to the Unix epoch, modulo d
/// (Go's Truncate counts from the zero time): 62135596800 s.
fn zero_offset_mod(d: Int) -> Int { mulmod(62135596800 % d, 1000000000 % d, d) }

/// (a + b) mod d for 0 <= a, b < d, without overflow.
fn addmod(a: Int, b: Int, d: Int) -> Int { if a >= d - b { a - (d - b) } else { a + b } }

/// (a * b) mod d for 0 <= a, b < d, by doubling (no 128-bit product).
fn mulmod(a: Int, b0: Int, d: Int) -> Int {
  var r = 0
  var x = a
  var b = b0
  while b > 0 {
    if (b & 1) != 0 {
      r = addmod(r, x, d)
    }
    x = addmod(x, x, d)
    b = b >> 1
  }
  r
}

/// t's remainder modulo d since the zero time, in 0..d.
fn rem_since_zero(t: Time, d: Int) -> Int {
  let ns = ns_of(t)
  var r = ns % d
  if r < 0 {
    r += d
  }
  addmod(r, zero_offset_mod(d), d)
}

fn truncate(t: Time, d: Duration) -> Time {
  let dn = d.nanos()
  if dn <= 0 {
    return t
  }
  t - Duration.from_nanos(rem_since_zero(t, dn))
}

fn round(t: Time, d: Duration) -> Time {
  let dn = d.nanos()
  if dn <= 0 {
    return t
  }
  let r = rem_since_zero(t, dn)
  // Go's lessThanHalf: r + r < d, written so it cannot overflow
  if r < dn - r {
    return t - Duration.from_nanos(r)
  }
  t + Duration.from_nanos(dn - r)
}

fn ticker(clock: Clock, period: Duration) -> time.Ticker uses clock {
  if period.nanos() <= 0 {
    fault("time: non-positive interval for ticker")
  }
  time.Ticker{clock: clock, period: period, next_ns: Atomic[Int].new(ns_of(clock.now()) + period.nanos())}
}

fn ticker_wait(t: time.Ticker) -> Time uses clock {
  let p = t.period.nanos()
  // claim the pending tick and move the schedule past the ones a slow
  // caller missed (phase kept) before sleeping, so two waiters never get
  // the same tick, as each tick of Go's channel reaches one receiver
  var next = t.next_ns.get()
  var now = ns_of(t.clock.now())
  while true {
    var n = next + p
    if n <= now {
      n = n + ((now - n) / p + 1) * p
    }
    if t.next_ns.compare_and_swap(next, n) {
      break
    }
    next = t.next_ns.get()
    now = ns_of(t.clock.now())
  }
  if next > now {
    t.clock.sleep(Duration.from_nanos(next - now))
  }
  Time.UNIX_EPOCH + Duration.from_nanos(next)
}

fn ticker_reset(t: time.Ticker, period: Duration) -> time.Ticker uses clock {
  if period.nanos() <= 0 {
    fault("time: non-positive interval for ticker")
  }
  time.Ticker{clock: t.clock, period: period, next_ns: Atomic[Int].new(ns_of(t.clock.now()) + period.nanos())}
}

fn date_add_days(d: time.Date, n: Int) -> time.Date { date_of(date_days(d) + n) }

fn date_add_months(d: time.Date, n: Int) -> time.Date {
  let (y, m) = norm_month(d.year, d.month + n)
  var day = d.day
  if day < 1 {
    day = 1
  }
  if day > days_in(y, m) {
    day = days_in(y, m)
  }
  time.Date{year: y, month: m, day: day}
}

fn date_days_until(d: time.Date, o: time.Date) -> Int { date_days(o) - date_days(d) }

fn date_display(d: time.Date) -> Str {
  if d.year < 0 {
    return "-${pad(-d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}"
  }
  "${pad(d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}"
}

// ---------------------------------------------------------------------------
// Layouts (std.md 13.3): named fields, as std/rt's TimeLayoutParse

/// A piece of a layout: literal text (field "") or a field and its
/// argument.
struct Item {
  lit: Str
  field: Str
  arg: Str
  /// The field as a number (field_code), so format and parse switch on
  /// an integer instead of comparing names.
  code: Int = 0
  /// The argument as a number (item_mode), so format never compares it.
  mode: Int = 0
}

/// The argument of field code as a number for format: month 0 two digits,
/// 1 plain, 2 short name, 3 name; day 1 plain; weekday 1 short; frac -1
/// trimmed else the digit count; offset 1 without a colon.
fn item_mode(code: Int, arg: Str) -> Int {
  match code {
    2 => if arg == "" { 0 } else if arg == "1" { 1 } else if arg == "short" { 2 } else { 3 }
    3 => if arg == "1" { 1 } else { 0 }
    4 => if arg == "short" { 1 } else { 0 }
    10 => if arg == "" { -1 } else { Int.parse(arg) ?? 9 }
    11 => if arg == "" { 0 } else { 1 }
    _ => 0
  }
}

/// The code of a field name (0 for an unknown one): the length and first
/// byte pick the candidate and one comparison confirms it.
fn field_code(name: Str) -> Int {
  let b = name.bytes()
  if b.is_empty() {
    return 0
  }
  let c = b[0]
  var code = 0
  var want = ""
  match b.len() {
    3 => {
      code = 3
      want = "day"
    }
    4 => {
      if c == 121 {
        code = 1
        want = "year"
      } else if c == 104 {
        code = 5
        want = "hour"
      } else if c == 97 {
        code = 7
        want = "ampm"
      } else if c == 102 {
        code = 10
        want = "frac"
      } else if c == 122 {
        code = 12
        want = "zone"
      }
    }
    5 => {
      code = 2
      want = "month"
    }
    6 => {
      if c == 104 {
        code = 6
        want = "hour12"
      } else if c == 109 {
        code = 8
        want = "minute"
      } else if c == 115 {
        code = 9
        want = "second"
      } else if c == 111 {
        code = 11
        want = "offset"
      } else if c == 108 {
        code = 13
        want = "lbrace"
      } else if c == 114 {
        code = 14
        want = "rbrace"
      }
    }
    7 => {
      code = 4
      want = "weekday"
    }
    _ => {}
  }
  if code != 0 && name == want { code } else { 0 }
}

/// The arguments field takes ("" is the field without one), or None for
/// an unknown field.
fn field_args(name: Str) -> List[Str]? {
  match name {
    "year" => Some([""])
    "month" => Some(["", "1", "short", "name"])
    "day" => Some(["", "1"])
    "weekday" => Some(["short", "name"])
    "hour" => Some([""])
    "hour12" => Some([""])
    "ampm" => Some([""])
    "minute" => Some([""])
    "second" => Some([""])
    "frac" => Some(["", "1", "2", "3", "4", "5", "6", "7", "8", "9"])
    "offset" => Some(["", "compact"])
    "zone" => Some([""])
    "lbrace" => Some([""])
    "rbrace" => Some([""])
    _ => None
  }
}

/// Whether b[lo..hi] is the bytes want.
fn eq_range(b: Bytes, lo: Int, hi: Int, want: Bytes) -> Bool {
  if hi - lo != want.len() {
    return false
  }
  for k in 0..want.len() {
    if b[lo + k] != want[k] {
      return false
    }
  }
  true
}

/// field_code over b[lo..hi]: the length and first byte pick the candidate
/// and its bytes are compared in place (no Str for the name).
fn field_code_b(b: Bytes, lo: Int, hi: Int) -> Int {
  let n = hi - lo
  if n < 3 || n > 7 {
    return 0
  }
  let c = b[lo]
  if n == 3 {
    return if eq_range(b, lo, hi, b"day") { 3 } else { 0 }
  }
  if n == 5 {
    return if eq_range(b, lo, hi, b"month") { 2 } else { 0 }
  }
  if n == 7 {
    return if eq_range(b, lo, hi, b"weekday") { 4 } else { 0 }
  }
  if n == 4 {
    if c == 121 {
      return if eq_range(b, lo, hi, b"year") { 1 } else { 0 }
    }
    if c == 104 {
      return if eq_range(b, lo, hi, b"hour") { 5 } else { 0 }
    }
    if c == 97 {
      return if eq_range(b, lo, hi, b"ampm") { 7 } else { 0 }
    }
    if c == 102 {
      return if eq_range(b, lo, hi, b"frac") { 10 } else { 0 }
    }
    if c == 122 {
      return if eq_range(b, lo, hi, b"zone") { 12 } else { 0 }
    }
    return 0
  }
  // length 6
  if c == 104 {
    return if eq_range(b, lo, hi, b"hour12") { 6 } else { 0 }
  }
  if c == 109 {
    return if eq_range(b, lo, hi, b"minute") { 8 } else { 0 }
  }
  if c == 115 {
    return if eq_range(b, lo, hi, b"second") { 9 } else { 0 }
  }
  if c == 111 {
    return if eq_range(b, lo, hi, b"offset") { 11 } else { 0 }
  }
  if c == 108 {
    return if eq_range(b, lo, hi, b"lbrace") { 13 } else { 0 }
  }
  if c == 114 {
    return if eq_range(b, lo, hi, b"rbrace") { 14 } else { 0 }
  }
  0
}

/// The argument b[lo..hi] as a literal when it is one of the arguments some
/// field takes, else None.
fn arg_literal(b: Bytes, lo: Int, hi: Int) -> Str? {
  if hi == lo + 1 && b[lo] >= 49 && b[lo] <= 57 {
    return Some(match b[lo] {
      49 => "1"
      50 => "2"
      51 => "3"
      52 => "4"
      53 => "5"
      54 => "6"
      55 => "7"
      56 => "8"
      _ => "9"
    })
  }
  if eq_range(b, lo, hi, b"short") {
    return Some("short")
  }
  if eq_range(b, lo, hi, b"name") {
    return Some("name")
  }
  if eq_range(b, lo, hi, b"compact") {
    return Some("compact")
  }
  None
}

/// Whether `{name}` or `{name:arg}` is a field of a layout (field_args
/// without the list).
fn field_ok(code: Int, arg: Str, has_arg: Bool) -> Bool {
  if has_arg && arg == "" {
    return false
  }
  match code {
    2 => !has_arg || arg is "1" | "short" | "name"
    3 => !has_arg || arg == "1"
    4 => has_arg && arg is "short" | "name"
    10 => !has_arg || (arg.len() == 1 && arg >= "1" && arg <= "9")
    11 => !has_arg || arg == "compact"
    1 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 => !has_arg
    _ => false
  }
}

fn args_text(name: Str, args: List[Str]) -> Str {
  if name == "frac" {
    return "the forms are {frac}, {frac:1} to {frac:9}"
  }
  var forms: List[Str] = []
  for a in args {
    if a == "" {
      forms.push("{${name}}")
    } else {
      forms.push("{${name}:${a}}")
    }
  }
  "the forms are ${forms.join(", ")}"
}

/// The items of a layout, or the reason it is bad.
fn layout_items(layout: Str) -> List[Item] ! Str {
  let b = layout.bytes()
  let n = b.len()
  var items: List[Item] = []
  var lit = ""
  var start = 0
  var hour12 = false
  var ampm = false
  var i = 0
  while i < n {
    if b[i] == 125 {
      return Err("unmatched } (a literal brace is written {rbrace})")
    }
    if b[i] != 123 {
      i += 1
      continue
    }
    lit = lit + layout[start..i]
    var j = i + 1
    while j < n && b[j] != 123 && b[j] != 125 {
      j += 1
    }
    if j >= n || b[j] == 123 {
      return Err("unclosed { (a literal brace is written {lbrace})")
    }
    // the field is recognized in the layout's bytes, without slicing a
    // name or an argument; Strs are made only for an error
    var colon = -1
    var cj = i + 1
    while cj < j {
      if b[cj] == 58 {
        colon = cj
        break
      }
      cj += 1
    }
    let nend = if colon >= 0 { colon } else { j }
    let code = field_code_b(b, i + 1, nend)
    var arg = ""
    var arg_known = true
    if colon >= 0 {
      match arg_literal(b, colon + 1, j) {
        Some(a) => arg = a
        None => arg_known = false
      }
    }
    if !arg_known || !field_ok(code, arg, colon >= 0) {
      let body = layout[i + 1..j]
      var name = body
      if colon >= 0 {
        name = layout[i + 1..colon]
      }
      match field_args(name) {
        None => return Err("unknown field {${body}}")
        Some(args) => return Err("{${body}}: ${args_text(name, args)}")
      }
    }
    if code == 13 {
      lit = lit + "{"
    } else if code == 14 {
      lit = lit + "}"
    } else {
      if lit != "" {
        items.push(Item{lit: lit, field: "", arg: ""})
        lit = ""
      }
      items.push(Item{lit: "", field: "", arg: arg, code: code, mode: item_mode(code, arg)})
      if code == 6 {
        hour12 = true
      }
      if code == 7 {
        ampm = true
      }
    }
    i = j + 1
    start = i
  }
  lit = lit + layout[start..n]
  if lit != "" {
    items.push(Item{lit: lit, field: "", arg: ""})
  }
  if hour12 && !ampm {
    return Err("{hour12} needs {ampm} (or use {hour}, 00 to 23)")
  }
  Ok(items)
}

/// The items of a layout; a bad one faults (a bug, like a bad index).
fn layout_or_fault(fname: Str, layout: Str, at: rt.Loc) -> List[Item] {
  match layout_items(layout) {
    Ok(items) => items
    Err(msg) => rt.fault_at("time.${fname}: bad layout ${layout.quote()}: ${msg} (check layouts built at run time with time.check_layout)", at)
  }
}

fn check_layout(layout: Str) -> () ! time.LayoutErr {
  match layout_items(layout) {
    Ok(_) => Ok(())
    Err(msg) => Err(time.LayoutErr{layout: layout, msg: msg})
  }
}

/// time.Layout: a layout parsed once (decision 0332); `time.layout` in a
/// const runs once per process, and every format or parse of it skips the
/// layout walk.
struct Layout {
  text: Str
  items: List[Item]
}

fn layout(text: Str, at: rt.Loc) -> Layout { Layout{text: text, items: layout_or_fault("layout", text, at)} }

fn (l: Layout) display() -> Str { l.text }

fn layout_debug(l: Layout) -> Str { "Layout(${l.text.quote()})" }

fn (l: Layout) format(t: Time, z: Zone) -> Str { format_items(l.items, t, z) }

fn (l: Layout) parse(s: Str, z: Zone) -> Time ! time.ParseErr { parse_items(l.items, s, l.text, z) }

fn layouterr_display(e: time.LayoutErr) -> Str { "bad layout ${e.layout.quote()}: ${e.msg}" }

fn parseerr_display(e: time.ParseErr) -> Str { "at byte ${e.at} of ${e.input.quote()}: ${e.msg}" }

fn month_short() -> List[Str] { ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] }

fn month_name() -> List[Str] { ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"] }

fn weekday_short() -> List[Str] { ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }

fn weekday_name() -> List[Str] { ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] }

fn format(t: Time, z: Zone, layout: Str, at: rt.Loc) -> Str {
  format_items(layout_or_fault("format", layout, at), t, z)
}

fn format_items(items: List[Item], t: Time, z: Zone) -> Str {
  let ns = ns_of(t)
  let sec = floor_div(ns, 1000000000)
  var nanos = ns % 1000000000
  if nanos < 0 {
    nanos += 1000000000
  }
  var off = z.secs
  var name_pos = -1
  if !z.fixed {
    let (o, np) = tz.lookup(z.rules, sec)
    off = o
    name_pos = np
  }
  let local = sec + off
  let days = floor_div(local, 86400)
  let rem = local - days * 86400
  let d = date_of(days)
  let hour = rem / 3600
  var out = BytesBuilder.with_capacity(40)
  for it in items {
    match it.code {
      0 => out.write_str(it.lit)
      1 => put_num(out, d.year, 4)
      2 => {
        if it.mode == 0 {
          put_num(out, d.month % 100, 2)
        } else if it.mode == 1 {
          put_num(out, d.month, 1)
        } else if it.mode == 2 {
          put_name(out, MONTHS_SHORT, d.month - 1)
        } else {
          out.write_str(month_name()[d.month - 1])
        }
      }
      3 => put_num(out, d.day % 100, if it.mode == 1 { 1 } else { 2 })
      4 => {
        let w = weekday_index(days)
        if it.mode == 1 {
          put_name(out, WEEKDAYS_SHORT, w)
        } else {
          out.write_str(weekday_name()[w])
        }
      }
      5 => put_num(out, hour, 2)
      6 => {
        var h = hour % 12
        if h == 0 {
          h = 12
        }
        put_num(out, h, 2)
      }
      7 => {
        out.write_byte(if hour < 12 { 65 } else { 80 })
        out.write_byte(77)
      }
      8 => put_num(out, rem / 60 % 60, 2)
      9 => put_num(out, rem % 60, 2)
      10 => {
        // the digits of the nanoseconds, trailing zeros cut when mode is -1
        var w = it.mode
        var v = nanos
        if w < 0 {
          w = 9
          while w > 0 && v % 10 == 0 {
            v = v / 10
            w -= 1
          }
        } else {
          var k = 9
          while k > w {
            v = v / 10
            k -= 1
          }
        }
        if w > 0 {
          out.write_byte(46)
          put_num(out, v, w)
        }
      }
      11 => {
        if off == 0 && it.mode == 0 {
          out.write_byte(90)
        } else {
          // Go's sign is the offset's in whole minutes: -59s is +00:00
          var o = off
          let neg = o / 60 < 0
          if o < 0 {
            o = -o
          }
          out.write_byte(if neg { 45 } else { 43 })
          put_num(out, o / 3600 % 100, 2)
          if it.mode == 0 {
            out.write_byte(58)
          }
          put_num(out, o / 60 % 60, 2)
        }
      }
      _ => out.write_str(if z.fixed { z.label } else { tz.name(z.rules, name_pos) })
    }
  }
  rt.cast[Bytes, Str](out.freeze())
}

const MONTHS_SHORT: Str = "JanFebMarAprMayJunJulAugSepOctNovDec"

const WEEKDAYS_SHORT: Str = "MonTueWedThuFriSatSun"

/// The 3 byte name number i of names.
fn put_name(var out: BytesBuilder, names: Str, i: Int) {
  let nb = names.bytes()
  out.write_byte(nb[i * 3])
  out.write_byte(nb[i * 3 + 1])
  out.write_byte(nb[i * 3 + 2])
}

/// n in decimal, zero padded to w digits (a negative n is "-" and the
/// digits of -n padded to w - 1), as pad.
fn put_num(var out: BytesBuilder, n: Int, w: Int) {
  if w == 2 && n >= 0 && n < 100 {
    out.write_byte(UInt8(48 + n / 10))
    out.write_byte(UInt8(48 + n % 10))
    return
  }
  if w == 4 && n >= 0 && n < 10000 {
    let hi = n / 100
    let lo = n % 100
    out.write_byte(UInt8(48 + hi / 10))
    out.write_byte(UInt8(48 + hi % 10))
    out.write_byte(UInt8(48 + lo / 10))
    out.write_byte(UInt8(48 + lo % 10))
    return
  }
  if n < 0 {
    out.write_byte(45)
    put_num(out, -n, w - 1)
    return
  }
  var div = 1
  var digits = 1
  while div <= n / 10 {
    div = div * 10
    digits += 1
  }
  var z = w - digits
  while z > 0 {
    out.write_byte(48)
    z -= 1
  }
  var v = n
  while div > 0 {
    out.write_byte(UInt8(48 + v / div))
    v = v % div
    div = div / 10
  }
}

/// The digits of b at pos, at most hi: (value, count).
fn read_digits(b: Bytes, pos: Int, hi: Int) -> (Int, Int) {
  var n = 0
  var v = 0
  while n < hi && pos + n < b.len() && b[pos + n] >= 48 && b[pos + n] <= 57 {
    v = v * 10 + Int(b[pos + n]) - 48
    n += 1
  }
  (v, n)
}

/// The index of the width w name of packed (the names side by side) that
/// b has at pos, or -1.
fn read_fixed(b: Bytes, pos: Int, packed: Bytes, w: Int) -> Int {
  if pos + w > b.len() {
    return -1
  }
  var i = 0
  while i * w < packed.len() {
    var k = 0
    while k < w && b[pos + k] == packed[i * w + k] {
      k += 1
    }
    if k == w {
      return i
    }
    i += 1
  }
  -1
}

fn field_name(code: Int) -> Str {
  match code {
    1 => "year"
    2 => "month"
    3 => "day"
    5 => "hour"
    6 => "hour"
    8 => "minute"
    _ => "second"
  }
}

fn when_text(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Str {
  "${pad(year, 4)}-${pad(month, 2)}-${pad(day, 2)}T${pad(hour, 2)}:${pad(minute, 2)}:${pad(second, 2)}"
}

/// The longest of names at pos of s: (index, length), or (-1, 0).
fn read_word(s: Str, pos: Int, names: List[Str]) -> (Int, Int) {
  let rest = s[pos..]
  var best = -1
  var len = 0
  for (i, nm) in names.indexed() {
    if rest.starts_with(nm) && (best < 0 || nm.len() > len) {
      best = i
      len = nm.len()
    }
  }
  (best, len)
}

fn digit_text(lo: Int, hi: Int) -> Str {
  if lo == hi {
    return "${lo} digit"
  }
  if hi == lo + 1 {
    return "${lo} or ${hi} digit"
  }
  "${lo} to ${hi} digit"
}

fn parse(s: Str, layout: Str, z: Zone, at: rt.Loc) -> Time ! time.ParseErr {
  parse_items(layout_or_fault("parse", layout, at), s, layout, z)
}

fn parse_items(items: List[Item], s: Str, layout: Str, z: Zone) -> Time ! time.ParseErr {
  let b = s.bytes()
  let n = b.len()
  var pos = 0
  var year = 1970
  var month = 1
  var day = 1
  var hour = 0
  var minute = 0
  var second = 0
  var nanos = 0
  var hour12 = 0
  var off = 0
  var has_off = false
  var has12 = false
  var pm = false
  var weekday = -1
  var weekday_at = 0
  var abbr = ""
  var abbr_at_pos = -1
  var day_at = 0
  for it in items {
    let start = pos
    if it.code == 0 {
      let lb = it.lit.bytes()
      var k = 0
      if pos + lb.len() > n {
        k = -1
      }
      while k >= 0 && k < lb.len() && b[pos + k] == lb[k] {
        k += 1
      }
      if k != lb.len() {
        return perr(s, layout, start, "expected ${it.lit.quote()}")
      }
      pos += lb.len()
      continue
    }
    // a number field: what, digits lo to hi, range min to max
    var what = 0
    var lo = 2
    var hi = 2
    var min = 0
    var max = 0
    match it.code {
      1 => {
        what = 1
        lo = 4
        hi = 4
        min = 1
        max = 9999
      }
      2 => {
        if it.arg == "" || it.arg == "1" {
          what = 2
          if it.arg == "1" {
            lo = 1
          }
          min = 1
          max = 12
        } else {
          var i = -1
          var len = 3
          if it.arg == "name" {
            let (j, l) = read_word(s, pos, month_name())
            i = j
            len = l
          } else {
            i = read_fixed(b, pos, MONTHS_SHORT.bytes(), 3)
          }
          if i < 0 {
            var first = "Jan"
            if it.arg == "name" {
              first = "January"
            }
            return perr(s, layout, start, "expected a month name such as ${first.quote()}")
          }
          month = i + 1
          pos += len
        }
      }
      3 => {
        day_at = start
        what = 3
        if it.arg == "1" {
          lo = 1
        }
        min = 1
        max = 31
      }
      4 => {
        var i = -1
        var len = 3
        if it.arg == "name" {
          let (j, l) = read_word(s, pos, weekday_name())
          i = j
          len = l
        } else {
          i = read_fixed(b, pos, WEEKDAYS_SHORT.bytes(), 3)
        }
        if i < 0 {
          var first = "Mon"
          if it.arg == "name" {
            first = "Monday"
          }
          return perr(s, layout, start, "expected a weekday name such as ${first.quote()}")
        }
        weekday = i
        weekday_at = start
        pos += len
      }
      5 => {
        what = 5
        max = 23
      }
      6 => {
        what = 6
        min = 1
        max = 12
      }
      7 => {
        let rest = s[pos..]
        if rest.starts_with("PM") {
          pm = true
        } else if !rest.starts_with("AM") {
          return perr(s, layout, start, "expected AM or PM")
        }
        pos += 2
      }
      8 => {
        what = 8
        max = 59
      }
      9 => {
        what = 9
        max = 59
      }
      10 => {
        var k = 0
        if it.arg != "" {
          k = Int.parse(it.arg) ?? 0
        }
        if pos >= n || b[pos] != 46 {
          if k > 0 {
            return perr(s, layout, start, "expected \".\" and ${k} digit fraction")
          }
        } else {
          pos += 1
          let fstart = pos
          var flo = 1
          var fhi = 9
          if k > 0 {
            flo = k
            fhi = k
          }
          let (v, cnt) = read_digits(b, pos, fhi)
          if cnt < flo {
            return perr(s, layout, fstart, "expected ${digit_text(flo, fhi)} fraction")
          }
          pos += cnt
          var f = v
          var c = cnt
          while c < 9 {
            f = f * 10
            c += 1
          }
          nanos = f
        }
      }
      11 => {
        var bad = "expected an offset: +hhmm"
        if it.arg == "" {
          bad = "expected an offset: Z or +hh:mm"
        }
        if it.arg == "" && pos < n && b[pos] == 90 {
          pos += 1
          has_off = true
          off = 0
        } else {
          if pos >= n || (b[pos] != 43 && b[pos] != 45) {
            return perr(s, layout, start, bad)
          }
          let neg = b[pos] == 45
          pos += 1
          let (h, hn) = read_digits(b, pos, 2)
          if hn < 2 {
            return perr(s, layout, start, bad)
          }
          pos += 2
          if it.arg == "" {
            if pos >= n || b[pos] != 58 {
              return perr(s, layout, start, bad)
            }
            pos += 1
          }
          let (m, mn) = read_digits(b, pos, 2)
          if mn < 2 || h > 23 || m > 59 {
            return perr(s, layout, start, bad)
          }
          pos += 2
          off = h * 3600 + m * 60
          if neg {
            off = -off
          }
          has_off = true
        }
      }
      _ => {
        // zone
        var k = 0
        while pos + k < n && zone_char(b[pos + k]) {
          k += 1
        }
        if k == 0 {
          return perr(s, layout, start, "expected a zone abbreviation such as \"UTC\"")
        }
        abbr = s[pos..pos + k]
        abbr_at_pos = start
        pos += k
      }
    }
    if what != 0 {
      let (v, cnt) = read_digits(b, pos, hi)
      var name = field_name(what)
      if cnt < lo {
        return perr(s, layout, start, "expected ${digit_text(lo, hi)} ${name}")
      }
      if v < min || v > max {
        return perr(s, layout, start, "${name} ${v} out of range ${min} to ${max}")
      }
      pos += cnt
      match what {
        1 => {
          year = v
        }
        2 => {
          month = v
        }
        3 => {
          day = v
        }
        5 => {
          hour = v
        }
        6 => {
          hour12 = v
          has12 = true
        }
        8 => {
          minute = v
        }
        _ => {
          second = v
        }
      }
    }
  }
  if pos < n {
    return perr(s, layout, pos, "extra text after the layout: ${s[pos..].quote()}")
  }
  if day > days_in(year, month) {
    return perr(s, layout, day_at, "day ${day} out of range 1 to ${days_in(year, month)} for ${pad(year, 4)}-${pad(month, 2)}")
  }
  if has12 {
    hour = hour12 % 12
    if pm {
      hour += 12
    }
  }
  let days = days_from_civil(year, month, day)
  if weekday >= 0 {
    let want = weekday_index(days)
    if want != weekday {
      return perr(s, layout, weekday_at, "weekday ${weekday_name()[weekday]} does not match ${pad(year, 4)}-${pad(month, 2)}-${pad(day, 2)}, a ${weekday_name()[want]}")
    }
  }
  let local = days * 86400 + hour * 3600 + minute * 60 + second
  var secs = local
  if has_off {
    secs = local - off
  } else if abbr != "" {
    let (early, late, _) = civil_instant(local, z)
    var found = false
    for c in [early, late] {
      if !found && c > MIN_TIME_SECS && c < MAX_TIME_SECS && abbr_at(z, c) == abbr {
        secs = c
        found = true
      }
    }
    if !found {
      if abbr != "UTC" && abbr != "GMT" {
        return perr(s, layout, abbr_at_pos, "zone abbreviation ${abbr.quote()} is not used by ${z.label} at ${when_text(year, month, day, hour, minute, second)}")
      }
      secs = local
    }
  } else {
    let (early, _, kind) = civil_instant(local, z)
    if kind == 2 {
      return perr(s, layout, 0, "${when_text(year, month, day, hour, minute, second)} does not exist in ${z.label} (skipped by a daylight saving change); the layout needs {offset}")
    }
    if kind == 3 {
      return perr(s, layout, 0, "${when_text(year, month, day, hour, minute, second)} happens twice in ${z.label} (repeated by a daylight saving change); the layout needs {offset} or {zone}")
    }
    secs = early
  }
  if secs <= MIN_TIME_SECS || secs >= MAX_TIME_SECS {
    return perr(s, layout, 0, "${when_text(year, month, day, hour, minute, second)} is outside the range of Time (1678 to 2262)")
  }
  Ok(time_of(secs * 1000000000 + nanos))
}

fn perr(s: Str, layout: Str, at: Int, msg: Str) -> Time ! time.ParseErr { Err(time.ParseErr{input: s, layout: layout, at: at, msg: msg}) }

fn zone_char(c: UInt8) -> Bool { c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 43 || c == 45 }
