use std/time
use std/cron

struct Schedule {
  /// @every: the delay in seconds, else 0
  _every: Int
  _minute: Int
  _hour: Int
  _dom: Int
  _month: Int
  _dow: Int
  _dom_star: Bool
  _dow_star: Bool
  _loc: time.Zone
}

fn cronerr_display(e: cron.CronErr) -> Str { e.msg }

fn err_of(msg: Str) -> cron.CronErr { cron.CronErr{msg: msg} }

/// The bits min..max stepping by step (getBits).
fn bits(lo: Int, hi: Int, step: Int) -> Int {
  var b = 0
  var i = lo
  while i <= hi {
    b = b | (1 << i)
    i += step
  }
  b
}

/// strconv.Atoi's value or its error text, for mustParseInt.
fn atoi(s: Str) -> Int ! cron.CronErr {
  let raw = s
  var b = s.bytes()
  var neg = false
  var i = 0
  if b.len() > 0 && (b[0] == '+' || b[0] == '-') {
    neg = b[0] == '-'
    i = 1
  }
  let syntax = err_of("failed to parse int from ${raw}: strconv.Atoi: parsing ${raw.quote()}: invalid syntax")
  if i >= b.len() {
    return Err(syntax)
  }
  var v = 0
  while i < b.len() {
    let c = b[i]
    if c < '0' || c > '9' {
      return Err(syntax)
    }
    if v > 922337203685477579 {
      return Err(err_of("failed to parse int from ${raw}: strconv.Atoi: parsing ${raw.quote()}: value out of range"))
    }
    v = v * 10 + Int(c - '0')
    i += 1
  }
  if neg && v > 0 {
    return Err(err_of("negative number (-${v}) not allowed: ${raw}"))
  }
  Ok(v)
}

fn lower_names(expr: Str, names: List[(Str, Int)]) -> Int? {
  let l = expr.to_lower()
  for (n, v) in names {
    if n == l {
      return Some(v)
    }
  }
  None
}

fn int_or_name(expr: Str, names: List[(Str, Int)]) -> Int ! cron.CronErr {
  match lower_names(expr, names) {
    Some(v) => Ok(v)
    None => atoi(expr)
  }
}

const MONTHS: List[(Str, Int)] = [("jan", 1), ("feb", 2), ("mar", 3), ("apr", 4), ("may", 5), ("jun", 6), ("jul", 7), ("aug", 8), ("sep", 9), ("oct", 10), ("nov", 11), ("dec", 12)]
const DOWS: List[(Str, Int)] = [("sun", 0), ("mon", 1), ("tue", 2), ("wed", 3), ("thu", 4), ("fri", 5), ("sat", 6)]
const NONAMES: List[(Str, Int)] = []

/// getRange: the bits of one expression and whether it started with * or ?
/// (robfig's starBit).
fn get_range(expr: Str, lo: Int, hi: Int, names: List[(Str, Int)]) -> (Int, Bool) ! cron.CronErr {
  let range_and_step = expr.split("/")
  let low_and_high = range_and_step[0].split("-")
  let single = low_and_high.len() == 1
  var start = 0
  var end = 0
  var star = false
  if low_and_high[0] == "*" || low_and_high[0] == "?" {
    start = lo
    end = hi
    star = true
  } else {
    start = int_or_name(low_and_high[0], names)?
    if low_and_high.len() == 1 {
      end = start
    } else if low_and_high.len() == 2 {
      end = int_or_name(low_and_high[1], names)?
    } else {
      return Err(err_of("too many hyphens: ${expr}"))
    }
  }
  var step = 1
  if range_and_step.len() == 2 {
    step = atoi(range_and_step[1])?
    if single {
      end = hi
    }
    if step > 1 {
      star = false
    }
  } else if range_and_step.len() > 2 {
    return Err(err_of("too many slashes: ${expr}"))
  }
  if start < lo {
    return Err(err_of("beginning of range (${start}) below minimum (${lo}): ${expr}"))
  }
  if end > hi {
    return Err(err_of("end of range (${end}) above maximum (${hi}): ${expr}"))
  }
  if start > end {
    return Err(err_of("beginning of range (${start}) beyond end of range (${end}): ${expr}"))
  }
  if step == 0 {
    return Err(err_of("step of range should be a positive number: ${expr}"))
  }
  Ok((bits(start, end, step), star))
}

/// getField: the comma separated ranges, empty ones dropped (FieldsFunc).
fn get_field(field: Str, lo: Int, hi: Int, names: List[(Str, Int)]) -> (Int, Bool) ! cron.CronErr {
  var b = 0
  var star = false
  for expr in field.split(",") {
    if expr.len() == 0 {
      continue
    }
    let (rb, rs) = get_range(expr, lo, hi, names)?
    b = b | rb
    if rs {
      star = true
    }
  }
  Ok((b, star))
}

fn sched(minute: Int, hour: Int, dom: Int, month: Int, dow: Int, dom_star: Bool, dow_star: Bool, z: time.Zone) -> Schedule {
  Schedule{_every: 0, _minute: minute, _hour: hour, _dom: dom, _month: month, _dow: dow, _dom_star: dom_star, _dow_star: dow_star, _loc: z}
}

fn descriptor(d: Str, z: time.Zone) -> Schedule ! cron.CronErr {
  let all_hours = bits(0, 23, 1)
  let all_dom = bits(1, 31, 1)
  let all_months = bits(1, 12, 1)
  let all_dow = bits(0, 6, 1)
  match d {
    "@yearly" | "@annually" => Ok(sched(1, 1, 1 << 1, 1 << 1, all_dow, false, true, z))
    "@monthly" => Ok(sched(1, 1, 1 << 1, all_months, all_dow, false, true, z))
    "@weekly" => Ok(sched(1, 1, all_dom, all_months, 1, true, false, z))
    "@daily" | "@midnight" => Ok(sched(1, 1, all_dom, all_months, all_dow, true, true, z))
    "@hourly" => Ok(sched(1, all_hours, all_dom, all_months, all_dow, true, true, z))
    _ => {
      if d.starts_with("@every ") {
        let text = d[7..]
        let dur = match Duration.parse(text) {
          Ok(x) => x
          Err(e) => return Err(err_of("failed to parse duration ${d}: ${e.display()}"))
        }
        var secs = dur.nanos() / 1000000000
        if secs < 1 {
          secs = 1
        }
        let s = sched(0, 0, 0, 0, 0, false, false, z)
        return Ok(Schedule{_every: secs, _minute: s._minute, _hour: s._hour, _dom: s._dom, _month: s._month, _dow: s._dow, _dom_star: false, _dow_star: false, _loc: z})
      }
      Err(err_of("unrecognized descriptor: ${d}"))
    }
  }
}

fn parse(spec0: Str, zone: time.Zone = time.utc()) -> Schedule ! cron.CronErr {
  if spec0.len() == 0 {
    return Err(err_of("empty spec string"))
  }
  var spec = spec0
  var z = zone
  if spec.starts_with("TZ=") || spec.starts_with("CRON_TZ=") {
    let i = spec.find(" ") ?? -1
    let eq = spec.find("=") ?? 0
    if i < 0 {
      return Err(err_of("provided bad location ${spec[eq + 1..]}: missing space after the time zone"))
    }
    let name = spec[eq + 1..i]
    z = match time.zone(name) {
      Ok(x) => x
      Err(e) => return Err(err_of("provided bad location ${name}: ${e.display()}"))
    }
    spec = spec[i..].trim()
  }
  if spec.starts_with("@") {
    return descriptor(spec, z)
  }
  let fields = spec.fields()
  if fields.len() != 5 {
    return Err(err_of("expected exactly 5 fields, found ${fields.len()}: [${fields.join(" ")}]"))
  }
  let (minute, _) = get_field(fields[0], 0, 59, NONAMES)?
  let (hour, _) = get_field(fields[1], 0, 23, NONAMES)?
  let (dom, dom_star) = get_field(fields[2], 1, 31, NONAMES)?
  let (month, _) = get_field(fields[3], 1, 12, MONTHS)?
  let (dow, dow_star) = get_field(fields[4], 0, 6, DOWS)?
  Ok(sched(minute, hour, dom, month, dow, dom_star, dow_star, z))
}

fn (s: Schedule) zone() -> time.Zone { s._loc }

fn civ(t: Int, z: time.Zone) -> time.Civil { time.civil(Time.from_unix(t), z) }

/// Go's time.Date (time.go): the civil time read as if UTC, then the offset
/// of the zone at that instant, checked once at the result (a time in a gap
/// or an overlap thus takes whichever offset Go's lookup meets first).
fn date_go(z: time.Zone, y: Int, mo: Int, d: Int, h: Int, mi: Int, sec: Int) -> Int {
  var yy = y
  var mm = mo
  while mm > 12 {
    mm -= 12
    yy += 1
  }
  var dt = time.date(yy, mm, 1).ok() ?? fault("cron: date")
  dt = dt.add_days(d - 1)
  let ct = time.ClockTime{hour: h, minute: mi, second: sec, nanos: 0}
  let l = (time.instant(dt, ct, time.utc()).ok() ?? fault("cron: instant")).unix()
  let off_a = z.offset_at(Time.from_unix(l)).nanos() / 1000000000
  let utc_a = l - off_a
  let off_b = z.offset_at(Time.from_unix(utc_a)).nanos() / 1000000000
  if off_b == off_a {
    utc_a
  } else {
    l - off_b
  }
}

fn (s: Schedule) day_matches(c: time.Civil) -> Bool {
  let dom_match = ((s._dom >> c.date.day) & 1) == 1
  let dow_match = ((s._dow >> (c.date.weekday().number() % 7)) & 1) == 1
  if s._dom_star || s._dow_star {
    dom_match && dow_match
  } else {
    dom_match || dow_match
  }
}

fn (s: Schedule) next(after: Time) -> Time? {
  if s._every > 0 {
    return Some(Time.from_unix(after.unix() + s._every))
  }
  let z = s._loc
  var t = after.unix() + 1
  var c = civ(t, z)
  let year_limit = c.date.year + 5
  var added = false
  while true {
    c = civ(t, z)
    if c.date.year > year_limit {
      return None
    }
    var wrap = false
    while ((s._month >> c.date.month) & 1) == 0 {
      if !added {
        added = true
        t = date_go(z, c.date.year, c.date.month, 1, 0, 0, 0)
        c = civ(t, z)
      }
      t = date_go(z, c.date.year, c.date.month + 1, c.date.day, c.time.hour, c.time.minute, c.time.second)
      c = civ(t, z)
      if c.date.month == 1 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while !s.day_matches(c) {
      if !added {
        added = true
        t = date_go(z, c.date.year, c.date.month, c.date.day, 0, 0, 0)
        c = civ(t, z)
      }
      // date_go of the next day at the same clock, done in place: that
      // civil time read as UTC is this one's plus a day, and when the
      // zone's offset there is the one the lookup returns, the civil time
      // is that day and clock with no conversion back (the zone label is
      // not read here); another offset converts as date_go and civ do
      let l = t + c.offset.nanos() / 1000000000 + 86400
      let off_a = z.offset_at(Time.from_unix(l)).nanos() / 1000000000
      let utc_a = l - off_a
      let off_b = z.offset_at(Time.from_unix(utc_a)).nanos() / 1000000000
      if off_b == off_a {
        t = utc_a
        c = time.Civil{date: c.date.add_days(1), time: c.time, offset: Duration.from_nanos(off_a * 1000000000), zone: c.zone}
      } else {
        t = l - off_b
        c = civ(t, z)
      }
      if c.time.hour != 0 {
        if c.time.hour > 12 {
          t += (24 - c.time.hour) * 3600
        } else {
          t += -c.time.hour * 3600
        }
        c = civ(t, z)
      }
      if c.date.day == 1 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while ((s._hour >> c.time.hour) & 1) == 0 {
      if !added {
        added = true
        t = date_go(z, c.date.year, c.date.month, c.date.day, c.time.hour, 0, 0)
      }
      t += 3600
      c = civ(t, z)
      if c.time.hour == 0 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while ((s._minute >> c.time.minute) & 1) == 0 {
      if !added {
        added = true
        t = t - ((t % 60) + 60) % 60
      }
      t += 60
      c = civ(t, z)
      if c.time.minute == 0 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    if c.time.second != 0 {
      added = true
      t = t + (60 - c.time.second)
      continue
    }
    return Some(Time.from_unix(t))
  }
  None
}
