// The memory driver's indexes and in place writes (decision 0528): the
// same rows, order and errors as a full scan of a copied table.
use std/sql
use std/big
use std/json

fn ids(rows: List[sql.Row]) -> List[Int] {
  var out: List[Int] = []
  for r in rows {
    out.push(r.int("id").ok() ?? -1)
  }
  out
}

fn fill(db: sql.Db, n: Int) -> () ! sql.SqlErr uses net.dial {
  for i in 0..n {
    db.exec("INSERT INTO t (name, n) VALUES ($1, $2)", [sql.str("k${i}"), sql.int(i % 10)])?
  }
}

test "get, update and delete by id visit one row of 10,000, and the rows are the scan's" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 10000)?
  expect(db.query_one("SELECT name FROM t WHERE id = $1", [sql.int(5000)])?.str("name")?) == "k4999"
  expect(db.query("SELECT id FROM t WHERE id = $1 AND n = $2", [sql.int(5000), sql.int(3)])?.len()) == 0
  expect(db.query("SELECT id FROM t WHERE $1 = id AND n = $2", [sql.int(5000), sql.int(9)])?.len()) == 1
  expect(db.query("SELECT id FROM t WHERE id = $1", [sql.int(20000)])?.len()) == 0
  expect(db.query("SELECT id FROM t WHERE id = NULL")?.len()) == 0
  expect(db.query_one("SELECT id FROM t WHERE name = $1", [sql.str("k41")])?.int("id")?) == 42
  expect(db.exec("UPDATE t SET n = 77 WHERE id = $1", [sql.int(7)])?.rows_affected) == 1
  expect(db.query("SELECT id FROM t WHERE n = 77")?.len()) == 1
  expect(db.exec("DELETE FROM t WHERE id = $1", [sql.int(7)])?.rows_affected) == 1
  expect(db.exec("DELETE FROM t WHERE id = $1", [sql.int(7)])?.rows_affected) == 0
  expect(db.query("SELECT id FROM t")?.len()) == 9999
}

test "a UNIQUE violation on insert and update is reported and leaves the table as it was" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 3)?
  match db.exec("INSERT INTO t (name, n) VALUES ($1, 1)", [sql.str("k1")]) {
    Err(Constraint(msg, code, _)) => {
      expect(code) == "23505"
      expect(msg) == "UNIQUE constraint failed: t.name"
    }
    _ => expect(false) == true
  }
  match db.exec("UPDATE t SET name = $1 WHERE id = $2", [sql.str("k0"), sql.int(3)]) {
    Err(Constraint(_, code, _)) => expect(code) == "23505"
    _ => expect(false) == true
  }
  // a multi row INSERT whose second row clashes with its first adds neither
  match db.exec("INSERT INTO t (name) VALUES ('x'), ('x')") {
    Err(Constraint(_, code, _)) => expect(code) == "23505"
    _ => expect(false) == true
  }
  expect(db.query("SELECT id FROM t WHERE name = 'x'")?.len()) == 0
  expect(db.query_one("SELECT name FROM t WHERE id = 3")?.str("name")?) == "k2"
  // a swap through a third value: each step sees the rows the one before left
  db.exec("UPDATE t SET name = 'tmp' WHERE id = 1")?
  db.exec("UPDATE t SET name = 'k0' WHERE id = 2")?
  db.exec("UPDATE t SET name = 'k1' WHERE id = 1")?
  expect(db.query_one("SELECT id FROM t WHERE name = 'k1'")?.int("id")?) == 1
  expect(db.query_one("SELECT id FROM t WHERE name = 'k0'")?.int("id")?) == 2
  // one UPDATE of two rows to one value: the second clashes with the
  // first's new value, and neither changes
  match db.exec("UPDATE t SET name = 'same' WHERE id <= 2") {
    Err(Constraint(_, code, _)) => expect(code) == "23505"
    _ => expect(false) == true
  }
  expect(db.query("SELECT id FROM t WHERE name = 'same'")?.len()) == 0
  expect(db.query_one("SELECT id FROM t WHERE name = 'k1'")?.int("id")?) == 1
}

test "a failing statement changes nothing: a bad value, trailing text, and a query's write without RETURNING" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 2)?
  expect(db.exec("INSERT INTO t (name, n) VALUES ('a', 1), ('b', 'oops')").is_err()) == true
  expect(db.exec("DELETE FROM t WHERE id = 1 junk").is_err()) == true
  expect(db.query("DELETE FROM t WHERE id = 1").is_err()) == true
  expect(db.query("UPDATE t SET n = 5 WHERE id = 2").is_err()) == true
  expect(ids(db.query("SELECT id FROM t ORDER BY id")?)) == [1, 2]
  expect(db.query_one("SELECT n FROM t WHERE id = 2")?.int("n")?) == 1
  // the next id is not used up by the failed insert
  expect(db.exec("INSERT INTO t (name) VALUES ('c')")?.last_insert_id) == 3
}

test "rows keep insertion order across deletes, inserts and compaction" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 300)?
  // delete 2 of every 3 (past half the slots: the table compacts)
  db.exec("DELETE FROM t WHERE n = 0 OR n = 1 OR n = 2 OR n = 4 OR n = 5 OR n = 7 OR n = 8")?
  db.exec("INSERT INTO t (name, n) VALUES ('late', 3)")?
  let got = ids(db.query("SELECT id FROM t")?)
  var want: List[Int] = []
  for i in 0..300 {
    let n = i % 10
    if n == 3 || n == 6 || n == 9 {
      want.push(i + 1)
    }
  }
  want.push(301)
  expect(got) == want
  // the indexes still find each row after the compaction
  expect(db.query_one("SELECT id FROM t WHERE name = 'late'")?.int("id")?) == 301
  expect(db.query_one("SELECT name FROM t WHERE id = 4")?.str("name")?) == "k3"
  expect(db.query("SELECT id FROM t WHERE id = 1")?.len()) == 0
}

test "a WHERE the index cannot answer exactly scans and fails as a scan does" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 5)?
  // a Real compared with the INT id: no index, the scan's numeric compare
  expect(db.query("SELECT id FROM t WHERE id = 2.0")?.len()) == 1
  // a Text against the INT id fails on every row, also when no row would match
  expect(db.query("SELECT id FROM t WHERE id = 'x'").is_err()) == true
  expect(db.query("SELECT id FROM t WHERE id = 99 AND n = 'x'").is_err()) == true
  expect(db.query("SELECT id FROM t WHERE id = 3 OR id = 4")?.len()) == 2
}

test "a transaction's snapshot is not changed by writes outside it" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 3)?
  let tx = db.begin()?
  db.exec("DELETE FROM t WHERE id = 1")?
  db.exec("UPDATE t SET n = 50 WHERE id = 2")?
  expect(tx.query("SELECT id FROM t")?.len()) == 3
  expect(tx.query_one("SELECT n FROM t WHERE id = 2")?.int("n")?) == 1
  tx.rollback()?
  expect(db.query("SELECT id FROM t")?.len()) == 2
}

test "a CREATE or DROP with trailing text fails and changes nothing" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 2)?
  expect(db.exec("CREATE TABLE u (a INT) garbage").is_err()) == true
  expect(db.query("SELECT a FROM u").is_err()) == true
  expect(db.exec("DROP TABLE t garbage").is_err()) == true
  expect(db.query("SELECT id FROM t")?.len()) == 2
  // IF NOT EXISTS on a table that exists still checks the end
  expect(db.exec("CREATE TABLE IF NOT EXISTS t (a INT) garbage").is_err()) == true
  db.exec("CREATE TABLE IF NOT EXISTS t (a INT)")?
  db.exec("DROP TABLE t")?
  expect(db.query("SELECT id FROM t").is_err()) == true
}

test "an INSERT and a DELETE under the Db's lock stay fast as the table grows" {
  // 0528: a call through a function value (items.map, filter) reachable
  // from the write path made each Mutex.with body cancelable, so it kept
  // the tables it was given and every write copied the table: 20,000 rows
  // took about 2 s on the Mac; in place, about 0.03 s
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)")?
  fill(db, 20000)?
  for k in 0..2000 {
    db.exec("DELETE FROM t WHERE id = $1", [sql.int(k + 1)])?
  }
  expect(db.query("SELECT id FROM t WHERE n = 3")?.len()) == 1800
}

/// The ids of each n in 0..10 and of NULL, in the rows' order.
fn by_n(db: sql.Db) -> List[List[Int]] ! sql.SqlErr uses net.dial {
  var out: List[List[Int]] = []
  for v in 0..10 {
    out.push(ids(db.query("SELECT id FROM t WHERE n = $1", [sql.int(v)])?))
  }
  out.push(ids(db.query("SELECT id FROM t WHERE n = $1 AND id > 5", [sql.int(3)])?))
  out.push(ids(db.query("SELECT id FROM t WHERE n = NULL")?))
  out
}

test "a CREATE INDEX column finds the scan's rows in the scan's order through writes and compaction" {
  let schema = "CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT)"
  let plain = sql.memory(schema)?
  let db = sql.memory(schema)?
  fill(plain, 200)?
  fill(db, 100)?
  // an index on rows already there, then on rows added after it
  db.exec("CREATE INDEX t_n ON t (n)")?
  for i in 100..200 {
    db.exec("INSERT INTO t (name, n) VALUES ($1, $2)", [sql.str("k${i}"), sql.int(i % 10)])?
  }
  expect(by_n(db)?) == by_n(plain)?
  for d in [db, plain] {
    d.exec("UPDATE t SET n = 3 WHERE id <= 30")?
    d.exec("UPDATE t SET n = NULL WHERE id = 40")?
    d.exec("DELETE FROM t WHERE n = 4 OR n = 5 OR n = 6 OR n = 7 OR n = 8 OR n = 9")?
    d.exec("INSERT INTO t (name, n) VALUES ('late', 3)")?
  }
  expect(by_n(db)?) == by_n(plain)?
  expect(ids(db.query("SELECT id FROM t WHERE n = 3 ORDER BY id DESC LIMIT 2")?)) == [201, 194]
}

test "CREATE INDEX: IF NOT EXISTS, unnamed, DROP INDEX, and its errors change nothing" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT NOT NULL UNIQUE, n INT); CREATE INDEX t_n ON t (n)")?
  fill(db, 20)?
  expect(db.exec("CREATE INDEX t_n ON t (n)").is_err()) == true
  db.exec("CREATE INDEX IF NOT EXISTS t_n ON t (n)")?
  expect(db.exec("CREATE INDEX t_n2 ON t (n)").is_err()) == true
  expect(db.exec("CREATE INDEX t_x ON t (nope)").is_err()) == true
  expect(db.exec("CREATE INDEX t_x ON nope (n)").is_err()) == true
  expect(db.exec("CREATE INDEX t_x ON t (n, name)").is_err()) == true
  expect(db.exec("CREATE UNIQUE INDEX t_x ON t (n)").is_err()) == true
  expect(db.exec("CREATE INDEX t_x ON t (id) garbage").is_err()) == true
  expect(db.exec("DROP INDEX t_n garbage").is_err()) == true
  expect(ids(db.query("SELECT id FROM t WHERE n = 2")?)) == [3, 13]
  db.exec("DROP INDEX t_n")?
  expect(db.exec("DROP INDEX t_n").is_err()) == true
  db.exec("DROP INDEX IF EXISTS t_n")?
  expect(ids(db.query("SELECT id FROM t WHERE n = 2")?)) == [3, 13]
  // unnamed: table_column_idx
  db.exec("CREATE INDEX ON t (n)")?
  expect(db.exec("CREATE INDEX t_n_idx ON t (name)").is_err()) == true
  db.exec("UPDATE t SET n = 2 WHERE id = 1")?
  expect(ids(db.query("SELECT id FROM t WHERE n = 2")?)) == [1, 3, 13]
  db.exec("DROP INDEX t_n_idx")?
  // an index on a UNIQUE column keeps its one slot index
  db.exec("CREATE INDEX t_name ON t (name)")?
  expect(db.query_one("SELECT id FROM t WHERE name = 'k5'")?.int("id")?) == 6
  db.exec("DROP INDEX t_name")?
  expect(db.query_one("SELECT id FROM t WHERE name = 'k5'")?.int("id")?) == 6
}

test "names lex the same with ASCII and non ASCII letters, digits and underscores" {
  let db = sql.memory("CREATE TABLE café_2 (id SERIAL, Nom_é TEXT, n9 INT)")?
  db.exec("INSERT INTO CAFÉ_2 (nom_é, N9) VALUES ($1, 7)", [sql.str("x")])?
  expect(db.query_one("SELECT nom_é, n9 FROM café_2 WHERE N9 = 7")?.str("nom_é")?) == "x"
  match db.query("SELECT nom_x FROM café_2") {
    Err(e) => expect("${e}") == "syntax error: no such column nom_x"
    Ok(_) => expect(false) == true
  }
}

// sql.named: pgx v5.12.0 named_args_test.go (TestNamedArgsRewriteQuery,
// TestNamedArgsDollarQuotedStrings, TestStrictNamedArgsRewriteQuery),
// Copyright (c) 2013-2021 Jack Christensen, MIT License. pgx's invalid
// UTF-8 case has no Str to hold it.

fn rw(q: Str, args: Map[Str, sql.SqlValue], strict: Bool = false) -> Str {
  match sql.named(q, args, strict) {
    Ok(p) => {
      let (s, a) = p
      "${s} | ${a:?}"
    }
    Err(e) => "error: ${e}"
  }
}

test "named rewrites @name to $n in first use order, as pgx's NamedArgs" {
  let i42 = sql.int(42)
  expect(rw("select * from users where id = @id", {"id": i42})) == "select * from users where id = $1 | [Integer(n: 42)]"
  expect(rw("select * from t where foo < @abc and baz = @def and bar < @abc", {"abc": i42, "def": sql.int(1)})) == "select * from t where foo < $1 and baz = $2 and bar < $1 | [Integer(n: 42), Integer(n: 1)]"
  expect(rw("select @a::int, @b::text", {"a": i42, "b": sql.str("foo")})) == "select $1::int, $2::text | [Integer(n: 42), Text(s: \"foo\")]"
  expect(rw("select @Abc::int, @b_4::text, @_c::int", {"Abc": i42, "b_4": sql.str("foo"), "_c": sql.int(1)})) == "select $1::int, $2::text, $3::int | [Integer(n: 42), Text(s: \"foo\"), Integer(n: 1)]"
  expect(rw("at end @", {"a": i42})) == "at end @ | []"
  expect(rw("ignores without valid character after @ foo bar", {"a": i42})) == "ignores without valid character after @ foo bar | []"
  expect(rw("name cannot start with number @1 foo bar", {"a": i42})) == "name cannot start with number @1 foo bar | []"
  expect(rw(r#"select *, '@foo' as "@bar" from users where id = @id"#, {"id": i42})) == r#"select *, '@foo' as "@bar" from users where id = $1 | [Integer(n: 42)]"#
  expect(rw("select * -- @foo\n from users -- @single line comments\n where id = @id;", {"id": i42})) == "select * -- @foo\n from users -- @single line comments\n where id = $1; | [Integer(n: 42)]"
  expect(rw("select * -- C:\\path\\\nfrom users where id = @id", {"id": i42})) == "select * -- C:\\path\\\nfrom users where id = $1 | [Integer(n: 42)]"
  expect(rw("select * /* @multi line\n @comment\n */\n /* /* with @nesting */ */\n from users\n where id = @id;", {"id": i42})) == "select * /* @multi line\n @comment\n */\n /* /* with @nesting */ */\n from users\n where id = $1; | [Integer(n: 42)]"
  expect(rw("extra provided argument", {"extra": sql.int(1)})) == "extra provided argument | []"
  expect(rw("@missing argument", {})) == "$1 argument | [Null]"
  expect(rw("select * from t where note = 'a\u{FFFD}b' and id = @id", {"id": i42})) == "select * from t where note = 'a\u{FFFD}b' and id = $1 | [Integer(n: 42)]"
  expect(rw("select * from t where id = @id -- \u{FFFD}\nand deleted = false", {"id": i42})) == "select * from t where id = $1 -- \u{FFFD}\nand deleted = false | [Integer(n: 42)]"
  expect(rw("select * from t where id = @id /* \u{FFFD} */ and deleted = false", {"id": i42})) == "select * from t where id = $1 /* \u{FFFD} */ and deleted = false | [Integer(n: 42)]"
  expect(rw("select * from \"a\u{FFFD}b\" where id = @id", {"id": i42})) == "select * from \"a\u{FFFD}b\" where id = $1 | [Integer(n: 42)]"
  expect(rw("select * from t where note = e'a\u{FFFD}b' and id = @id", {"id": i42})) == "select * from t where note = e'a\u{FFFD}b' and id = $1 | [Integer(n: 42)]"
  expect(rw("select @id\u{FFFD}, @other", {"id": i42, "other": sql.int(7)})) == "select $1\u{FFFD}, $2 | [Integer(n: 42), Integer(n: 7)]"
  expect(rw(r#"select e'it\'s @no', @id"#, {"id": i42})) == r#"select e'it\'s @no', $1 | [Integer(n: 42)]"#
}

test "named leaves dollar quoted strings alone, as pgx's NamedArgs and StrictNamedArgs" {
  let cases = [
    (r#"select $$hello @id$$, @id"#, r#"select $$hello @id$$, $1"#),
    (r#"select $tag_1$@missing$tag_1$, @id"#, r#"select $tag_1$@missing$tag_1$, $1"#),
    (r#"select $世界$@missing$世界$, @id"#, r#"select $世界$@missing$世界$, $1"#),
    ("select $\u{FFFD}$@missing$\u{FFFD}$, @id", "select $\u{FFFD}$@missing$\u{FFFD}$, $1"),
    (r#"select $$it's " -- /* @missing \ $$, @id"#, r#"select $$it's " -- /* @missing \ $$, $1"#),
    (r#"select $outer$$inner$@missing$inner$ $$ @missing$outer$, @id"#, r#"select $outer$$inner$@missing$inner$ $$ @missing$outer$, $1"#),
    (r#"select $tag$@missing$TAG$@missing$tag$, @id"#, r#"select $tag$@missing$TAG$@missing$tag$, $1"#),
    (r#"select @id, $$@missing$$, $tag$@id$tag$, @id"#, r#"select $1, $$@missing$$, $tag$@id$tag$, $1"#),
    (r#"select @id, $tag$@missing"#, r#"select $1, $tag$@missing"#),
    (r#"select column$tag$, @id"#, r#"select column$tag$, $1"#),
    (r#"select column$$, @id"#, r#"select column$$, $1"#),
    (r#"select example$tag$, @id"#, r#"select example$tag$, $1"#),
    (r#"select 世界$tag$, @id"#, r#"select 世界$tag$, $1"#),
    (r#"select $1$ @id"#, r#"select $1$ $1"#),
    (r#"select $bad-tag$ @id"#, r#"select $bad-tag$ $1"#),
    (r#"select @id, $"#, r#"select $1, $"#),
    (r#"select '$$' , @id"#, r#"select '$$' , $1"#),
    (r#"select /* $$ */ @id -- $tag$"#, r#"select /* $$ */ $1 -- $tag$"#),
  ]
  for (q, want) in cases {
    expect(rw(q, {"id": sql.int(42)})) == "${want} | [Integer(n: 42)]"
    expect(rw(q, {"id": sql.int(42)}, strict: true)) == "${want} | [Integer(n: 42)]"
  }
  expect(rw(r#"select $$hello @world$$"#, {})) == r#"select $$hello @world$$ | []"#
  expect(rw(r#"select $$hello @world$$"#, {}, strict: true)) == r#"select $$hello @world$$ | []"#
  expect(rw(r#"select $$@id$$"#, {"id": sql.int(42)}, strict: true)) == "error: named argument id is not used by the query"
}

test "named with strict refuses a missing or an unused argument, as pgx's StrictNamedArgs" {
  expect(rw("no arguments", {}, strict: true)) == "no arguments | []"
  expect(rw("@all @matches", {"all": sql.int(1), "matches": sql.int(2)}, strict: true)) == "$1 $2 | [Integer(n: 1), Integer(n: 2)]"
  expect(rw("extra provided argument", {"extra": sql.int(1)}, strict: true)) == "error: named argument extra is not used by the query"
  expect(rw("@missing argument", {}, strict: true)) == "error: named argument @missing has no value"
}

test "named's query and arguments run on a database" {
  let db = sql.memory("CREATE TABLE t (id INT, name TEXT)")?
  let (q, a) = sql.named("INSERT INTO t (id, name) VALUES (@id, @name)", {"name": sql.str("ann"), "id": sql.int(3)})?
  db.exec(q, a)?
  let (q2, a2) = sql.named("SELECT name FROM t WHERE id = @id AND name <> '@id'", {"id": sql.int(3)}, strict: true)?
  expect(db.query_one(q2, a2)?.str("name")?) == "ann"
}

// sql.Numeric (decision 0681): pgx v5.12.0 pgtype/numeric_test.go
// (TestNumericScanScientificPreservesPrecision,
// TestNumericScanScientificErrors, TestNumericFloat64Valuer,
// TestNumericInt64Valuer, and TestNumericCodec's text values), Copyright
// (c) 2013-2021 Jack Christensen, MIT License.

/// A Numeric as coefficient and exponent, or its error.
fn nparts(s: Str) -> Str {
  match sql.parse_numeric(s) {
    Ok(Finite(c, e)) => "${c.text()}e${e}"
    Ok(n) => n.display()
    Err(e) => "error: ${e}"
  }
}

test "parse_numeric reads scientific text without losing digits, as pgx's ScanScientific" {
  expect(nparts("1234567890123456789e0")) == "1234567890123456789e0"
  expect(nparts("1.234567890123456789e5")) == "1234567890123456789e-13"
  expect(nparts("1e131071")) == "1e131071"
  expect(nparts("1.50")) == "150e-2"
  expect(nparts("100")) == "1e2"
  expect(nparts("-100")) == "-1e2"
  expect(nparts("0")) == "0e0"
  expect(nparts("-0")) == "0e0"
  expect(nparts("1e+3")) == "1e3"
  expect(nparts("NaN")) == "NaN"
  expect(nparts("-Infinity")) == "-Infinity"
}

test "parse_numeric's errors name the text, as pgx's ScanScientific" {
  for (s, want) in [
    ("1e", "1e is not a number"),
    ("1e+", "1e+ is not a number"),
    ("1e1.5", "1e1.5 is not a number"),
    ("1e5e5", "1e5e5 is not a number"),
    ("1.2.3e4", "1.2.3e4 is not a number"),
    ("e5", "e5 is not a number"),
    ("1.2.3", "1.2.3 is not a number"),
    ("1e99999999999999999999", "1e99999999999999999999 exponent out of range"),
    ("1000e2147483647", "1000e2147483647 exponent out of range"),
    ("1e131072", "1e131072 exponent out of range"),
    ("1e-32768", "1e-32768 exponent out of range"),
    ("", " is not a number"),
    ("infinity", "infinity is not a number"),
  ] {
    expect(nparts(s)) == "error: syntax error: ${want}"
  }
}

test "a Numeric's display is Postgres's text and round trips, as pgx's encodeText" {
  let huge = "4237234789234789289347892374324872138321894178943189043890124832108934.43219085471578891547854892438945012347981"
  let tiny = "0." + "0".repeat(180) + "123"
  let wide = "67" + "0".repeat(44535) + ".0"
  for s in ["1", "3.14159", "100010001", "100010001.0001", huge, tiny, wide, "-0.003", "1.50", "-100", "NaN", "Infinity", "-Infinity"] {
    expect(sql.parse_numeric(s)?.display()) == s
  }
  expect(sql.Numeric.Finite(coef: big.from_int(2437), exp: 3).display()) == "2437000"
  expect(sql.Numeric.Finite(coef: big.from_int(-5), exp: -3).display()) == "-0.005"
  expect(sql.numeric(sql.parse_numeric("1.50")?)) == sql.SqlValue.Text(s: "1.50")
}

test "a Numeric's to_float and to_int, as pgx's Float64Value and Int64Value" {
  expect(sql.parse_numeric("1")?.to_float()) == 1.0
  expect(sql.parse_numeric("0.0000000000000000001")?.to_float()) == 0.0000000000000000001
  expect(sql.parse_numeric("-99999999999")?.to_float()) == -99999999999.0
  expect(sql.Numeric.Infinity.to_float().is_inf()) == true
  expect(sql.Numeric.NegInfinity.to_float() < 0.0) == true
  expect(sql.Numeric.NaN.to_float().is_nan()) == true
  expect(sql.parse_numeric("1e400")?.to_float().is_inf()) == true
  expect(sql.parse_numeric("1")?.to_int()) == Some(1)
  expect(sql.parse_numeric("-99999999999")?.to_int()) == Some(-99999999999)
  expect(sql.parse_numeric("0")?.to_int()) == Some(0)
  expect(sql.parse_numeric("12.00")?.to_int()) == Some(12)
  expect(sql.parse_numeric("12.5")?.to_int()) == None
  expect(sql.parse_numeric("9223372036854775807")?.to_int()) == Some(9223372036854775807)
  expect(sql.parse_numeric("9223372036854775808")?.to_int()) == None
  expect(sql.Numeric.NaN.to_int()) == None
  expect(sql.Numeric.Infinity.to_int()) == None
}

test "a Numeric's to_rat is its exact value, and equality keeps the scale" {
  expect(sql.parse_numeric("1.50")?.to_rat()) == Some(big.rat(big.from_int(3), big.from_int(2)))
  expect(sql.parse_numeric("1.50")?.to_rat()) == sql.parse_numeric("1.5")?.to_rat()
  expect(sql.parse_numeric("1.50")? == sql.parse_numeric("1.5")?) == false
  expect(sql.parse_numeric("2e3")?.to_rat()) == Some(big.rat_from_int(2000))
  expect(sql.Numeric.NaN.to_rat()) == None
}

test "Numeric's JSON: a bare number keeping the scale (pgx's MarshalJSON); NaN and the infinities encode as null" {
  let n = sql.parse_numeric("-1234567890123456789012345678901234567890.50").or_fault("valid")
  expect(json.encode_str(n)) == "-1234567890123456789012345678901234567890.50"
  expect(json.decode_str[sql.Numeric]("-1234567890123456789012345678901234567890.50")) == Ok(n)
  expect(json.decode_str[sql.Numeric]("1e+21").map(fn(x) { x.display() })) == Ok("1000000000000000000000")
  expect(json.encode_str([sql.Numeric.NaN, sql.Numeric.Infinity, sql.Numeric.NegInfinity])) == "[null,null,null]"
  expect(json.decode_str[sql.Numeric?]("null")) == Ok(None)
  expect(json.decode_str[sql.Numeric]("\"NaN\"").is_err()) == true
}

test "count, sum, avg, min and max over the selected rows, as SQLite's (task #397)" {
  let db = sql.memory("CREATE TABLE t (id SERIAL, name TEXT, n INT, r REAL)")?
  db.exec("INSERT INTO t (name, n, r) VALUES ('b', 3, 1.5), ('a', NULL, NULL), ('c', 4, 2.0), ('d', 5, NULL)")?
  let a = db.query_one("SELECT count(n) AS c, sum(n) AS s, avg(n) AS v, min(n) AS lo, max(n) AS hi, count(*) AS k FROM t")?
  expect(a.int("c")?) == 3
  expect(a.int("s")?) == 12
  expect(a.float("v")?) == 4.0
  expect(a.int("lo")?) == 3
  expect(a.int("hi")?) == 5
  expect(a.int("k")?) == 4
  // a Real makes the sum Real; min and max of text; names without AS
  let b = db.query_one("SELECT sum(r), min(name), max(name) FROM t")?
  expect(b.columns()) == ["sum", "min", "max"]
  expect(b.float("sum")?) == 3.5
  expect(b.str("min")?) == "a"
  expect(b.str("max")?) == "d"
  // WHERE first; no rows: count 0, the others NULL
  expect(db.query_one("SELECT sum(n) AS s FROM t WHERE n > 3")?.int("s")?) == 9
  let e = db.query_one("SELECT count(n) AS c, sum(n) AS s, avg(n) AS v, max(n) AS m FROM t WHERE n > 9")?
  expect(e.int("c")?) == 0
  expect(e.int_opt("s")?) == None
  expect(e.float_opt("v")?) == None
  expect(e.int_opt("m")?) == None
  // LIMIT and OFFSET apply to the one result row, not the rows counted
  expect(db.query_one("SELECT count(*) AS k FROM t LIMIT 1")?.int("k")?) == 4
  expect(db.query_one("SELECT sum(n) AS s FROM t LIMIT 1")?.int("s")?) == 12
  expect(db.query("SELECT count(*) FROM t LIMIT 1 OFFSET 1")?.len()) == 0
  // errors: a mix with a plain column, sum of text, an aggregate in WHERE,
  // overflow
  expect(db.query("SELECT name, sum(n) FROM t").is_err()) == true
  expect(db.query("SELECT sum(name) FROM t").is_err()) == true
  expect(db.query("SELECT id FROM t WHERE sum(n) > 1").is_err()) == true
  db.exec("INSERT INTO t (name, n) VALUES ('big', 9223372036854775807)")?
  expect(db.query("SELECT sum(n) FROM t").is_err()) == true
  expect(db.query_one("SELECT max(n) AS m FROM t")?.int("m")?) == 9223372036854775807
}
