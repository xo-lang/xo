// std/sql on the native backends (decision 0083): the in memory driver of
// std/rt/sqlmem.go and the Db, Tx, and Row of std/rt/sql.go, ported to Xo
// with the same statements, results, and error texts. Tables are values:
// a statement works on a copy of the table map (shared until written, so
// a copy is cheap) and publishes it only when it succeeds; a transaction
// is its own copy, published by commit. The database is a Mutex; the
// single writer permit of transactions is a channel holding one token.
//
// Not ported: the pool bound of max_open (the in memory driver runs one
// statement at a time, so it never waits on it) and drivers registered
// from Go (`sql.open` reports an unknown driver, as std/rt does when none
// is registered).
use std/json as js
use std/sql
use std/time
use std/uuid
use std/netip
use std/big
use std/task
use native/rt
use native/rtsql
use native/llrt/raw
use native/llrt/sysio
use native/llrt/mysql
use native/llrt/pg

/// The Display of SqlErr (decision 0358); std/rt/sqltext.go prints the same.
fn sqlerr_display(e: sql.SqlErr) -> Str {
  match e {
    Syntax(msg) => "syntax error: ${msg}"
    Constraint(msg, _, _) => msg
    Param(msg) => msg
    NoTable(name) => "no such table: ${name}"
    NoRows => "no rows in result set"
    NoColumn(name) => "no such column: ${name}"
    Mismatch(column, msg) => "column ${column}: ${msg}"
    Conn(msg) => "connection: ${msg}"
    Driver(msg) => msg
    Server(code, msg) => "${msg} (SQLSTATE ${code})"
    TxDone => "transaction already committed or rolled back"
    Closed => "database is closed"
    Canceled => "canceled"
  }
}

// ---------------------------------------------------------------------------
// Handles

struct Db[fx: Effects] {
  st: Mutex[Store]
  /// One token: the permit of the single open transaction.
  writer: Chan[Bool]
  closed: Atomic[Bool]
  /// The connections of a driver (open_driver); None for the in memory one.
  pool: Pool[fx]? = None
  /// The last Stmt id given out (prepare).
  stmt_ids: Atomic[Int]
}

// ---------------------------------------------------------------------------
// The pool of a driver (decision 0278): max_open permits, idle connections

struct Pool[fx: Effects] {
  net: Net
  drv: sql.Driver[fx]
  dsn: Str
  /// max_open tokens: one per operation in flight and open transaction.
  permits: Chan[Bool]
  idle: Mutex[List[Idle[fx]]]
  max_idle: Int
  /// Nanoseconds; 0 for none.
  max_lifetime: Int
  /// open's on_notice: each new connection is a Noticed then.
  on_notice: (fn(sql.Notice) uses sync)? = None
  /// open's on_trace (decision 0648 item 16): each new connection is a
  /// Traced then, and take and give report Connect, Acquire and Release.
  on_trace: (fn(sql.TraceRecord) uses sync)? = None
  max_open: Int = 0
  n: Mutex[Counts]
}

/// The pool's counts (Db.stats, decision 0648 item 16), behind one
/// Mutex so Pool keeps few heap fields (XO0530 at every `if let` of it).
struct Counts {
  in_use: Int = 0
  open: Int = 0
  connecting: Int = 0
  acquires: Int = 0
  acquire_ns: Int = 0
  waits: Int = 0
  wait_ns: Int = 0
  canceled: Int = 0
  new_conns: Int = 0
  idle_closed: Int = 0
  life_closed: Int = 0
}

/// The time a traced operation started: wall clock for the record, the
/// pool's clock for its length.
struct Started {
  wall: Int
  at: Int
}

fn started() -> Started { Started{wall: sysio.real_ns(), at: pool_now()} }

/// The record of an operation that began at s, given to h.
fn emit(h: fn(sql.TraceRecord) uses sync, s: Started, op: sql.TraceOp, query: Str, args: List[sql.SqlValue], n: Int, err: sql.SqlErr?) {
  h(sql.TraceRecord{op: op, query: query, args: args, rows_affected: n, err: err, start_ns: s.wall, elapsed: Duration.from_nanos((pool_now() - s.at).max(0))})
}

fn (p: Pool) trace(s: Started, op: sql.TraceOp, err: sql.SqlErr?) {
  if let Some(h) = p.on_trace {
    emit(h, s, op, "", [], 0, err)
  }
}

/// The pool's clock for connection ages: the monotonic clock, except in
/// a WASI module (sysio.layer() 0), whose runtime keeps the monotonic
/// clock to itself (compiler/wasm rt3.xo $mono): there the wall clock
/// (sysio.real_ns, WASI clock_time_get), since mono_ns's Linux and macOS
/// calls do not exist in wasm.
fn pool_now() -> Int {
  if sysio.layer() == 0 {
    return sysio.real_ns()
  }
  sysio.mono_ns()
}

struct Idle[fx: Effects] {
  c: sql.DriverConn[fx]
  /// When it was connected (pool_now).
  born: Int
  stmts: Mutex[List[Cached[fx]]]
}

/// A connection taken from the pool, with when it was connected and the
/// statements prepared on it.
struct Taken[fx: Effects] {
  c: sql.DriverConn[fx]
  born: Int
  stmts: Mutex[List[Cached[fx]]]
}

/// A Stmt as prepared on one connection (decision 0648 item 6).
struct Cached[fx: Effects] {
  /// The Stmt's id.
  id: Int
  /// None: the driver has no server statements, so the text runs.
  ds: sql.DriverStmt[fx]?
  /// The Stmt's flag: once set, the entry is closed and dropped at the
  /// connection's next take or give.
  closed: Atomic[Bool]
  /// Made by a Tx's statement, closed when the transaction ends.
  in_tx: Bool = false
}

/// Gives a permit back. try_send, not send: send is a cancellation point,
/// so a task cancelled while it gives a connection back would unwind there
/// and the permit would be lost (every later take then waits forever).
/// The channel holds max_open permits, so there is always room.
fn give_permit(c: Chan[Bool]) {
  if !c.try_send(true) {
    fault("std/sql: a permit was given back to a full pool")
  }
}

fn (p: Pool) take() -> Taken ! sql.SqlErr uses net.dial {
  let s = started()
  // waiting for a permit is a cancellation point
  if p.permits.try_recv() is None {
    // counted as the wait starts, as Go's DB.Stats WaitCount
    p.n.with(fn(var c) { c.waits += 1 })
    if !p.wait_permit(s) {
      return Err(sql.SqlErr.Canceled)
    }
  }
  let now = pool_now()
  while {
    let got = p.idle.with(fn(var xs) { xs.pop() })
    match got {
      Some(x) => {
        if p.max_lifetime > 0 && now - x.born >= p.max_lifetime {
          x.c.close()
          p.n.with(fn(var c) { c.open += -1 })
          p.n.with(fn(var c) { c.life_closed += 1 })
          continue
        }
        if x.c.is_broken() {
          // closed by the server while idle (wait_timeout), as
          // database/sql's retry of a driver's ErrBadConn on a cached
          // connection
          x.c.close()
          p.n.with(fn(var c) { c.open += -1 })
          continue
        }
        let t = Taken{c: x.c, born: x.born, stmts: x.stmts}
        sweep(t.stmts)
        p.acquired(s, None)
        return t
      }
      None => break
    }
  }
  p.n.with(fn(var c) { c.connecting += 1 })
  let cs = started()
  let r = p.drv.connect(p.net, p.dsn)
  p.n.with(fn(var c) { c.connecting += -1 })
  match r {
    Ok(c) => {
      p.n.with(fn(var c) { c.new_conns += 1 })
      p.n.with(fn(var c) { c.open += 1 })
      p.trace(cs, sql.TraceOp.Connect, None)
      p.acquired(s, None)
      Taken{c: noticed(p, traced(p, c)), born: now, stmts: Mutex.new([])}
    }
    Err(e) => {
      p.trace(cs, sql.TraceOp.Connect, Some(e))
      p.acquired(s, Some(e))
      give_permit(p.permits)
      Err(e)
    }
  }
}

/// Counts an acquire that began at s and reports it; a failed one gives
/// no connection.
/// Waits for a permit: false when the channel closed. recv unwinds a
/// cancelled task, so the wait's time and a cancellation are counted in a
/// defer, which runs on the unwind too.
fn (p: Pool) wait_permit(s: Started) -> Bool {
  let got = Atomic.new(false)
  defer p.wait_ended(s, got)
  let ok = p.permits.recv() is Some(_)
  got.set(ok)
  ok
}

fn (p: Pool) wait_ended(s: Started, got: Atomic[Bool]) {
  p.n.with(fn(var c) { c.wait_ns += (pool_now() - s.at).max(0) })
  if !got.get() {
    p.n.with(fn(var c) { c.canceled += 1 })
    p.trace(s, sql.TraceOp.Acquire, Some(sql.SqlErr.Canceled))
  }
}

fn (p: Pool) acquired(s: Started, err: sql.SqlErr?) {
  p.n.with(fn(var c) { c.acquires += 1 })
  p.n.with(fn(var c) { c.acquire_ns += (pool_now() - s.at).max(0) })
  if err.is_none() {
    p.n.with(fn(var c) { c.in_use += 1 })
  }
  p.trace(s, sql.TraceOp.Acquire, err)
}

fn (p: Pool) stats() -> sql.PoolStats {
  let idle = p.idle.with_read(fn(xs) { xs.len() })
  let c = p.n.with_read(fn(c) { c })
  sql.PoolStats{max_open: p.max_open, open: c.open + c.connecting, in_use: c.in_use, idle: idle, connecting: c.connecting, acquire_count: c.acquires, acquire_time: Duration.from_nanos(c.acquire_ns), wait_count: c.waits, wait_time: Duration.from_nanos(c.wait_ns), canceled_acquire_count: c.canceled, new_conns: c.new_conns, max_idle_closed: c.idle_closed, max_lifetime_closed: c.life_closed}
}

/// Gives t back: kept idle while it works, has room, and is young enough,
/// else closed; then the permit.
fn give[fx: Effects](p: Pool[fx], t: Taken[fx]) uses (net.dial, fx) {
  let s = started()
  let young = p.max_lifetime == 0 || pool_now() - t.born < p.max_lifetime
  let keep = !t.c.is_broken() && young
  if keep {
    sweep(t.stmts)
  }
  let kept = keep && p.idle.with(fn(var xs) -> Bool {
    if xs.len() >= p.max_idle {
      return false
    }
    xs.push(Idle{c: t.c, born: t.born, stmts: t.stmts})
    true
  })
  if !kept {
    t.c.close()
    p.n.with(fn(var c) { c.open += -1 })
    if keep {
      p.n.with(fn(var c) { c.idle_closed += 1 })
    } else if !young {
      p.n.with(fn(var c) { c.life_closed += 1 })
    }
  }
  p.n.with(fn(var c) { c.in_use += -1 })
  // the permit first: on_trace may wait (a Mutex), and a cancelled task
  // unwinds at a wait
  give_permit(p.permits)
  p.trace(s, sql.TraceOp.Release, None)
}

fn (p: Pool) query(q: Str, args: List[sql.SqlValue]) -> List[Row] ! sql.SqlErr uses net.dial {
  let t = p.take()?
  let r = t.c.query(q, args)
  let all = match r {
    Ok(x) => drain_rows(x)
    Err(e) => Err(e)
  }
  give(p, t)
  let rows = all?
  to_rows(rows.columns, rows.column_types, rows.rows)
}

/// x with its cursor, if any, read to the end into rows (Db.query reads a
/// result whole; Db.rows reads it as asked).
fn drain_rows(x: sql.DriverRows) -> sql.DriverRows ! sql.SqlErr uses net.dial {
  match x.cursor {
    Some(c) => {
      let more = c.rest()?
      if x.rows.is_empty() {
        return sql.DriverRows{columns: x.columns, rows: more, column_types: x.column_types}
      }
      var all = x.rows
      for r in more {
        all.push(r)
      }
      sql.DriverRows{columns: x.columns, rows: all, column_types: x.column_types}
    }
    None => x
  }
}

fn (p: Pool) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  let t = p.take()?
  let r = t.c.exec(q, args)
  give(p, t)
  r
}

fn (p: Pool) ping() -> () ! sql.SqlErr uses net.dial {
  let t = p.take()?
  let r = t.c.ping()
  give(p, t)
  r
}

fn (p: Pool) close_idle() {
  let xs = p.idle.with(fn(var xs) {
    let all = xs
    xs = []
    all
  })
  for x in xs {
    x.c.close()
    p.n.with(fn(var c) { c.open += -1 })
  }
}

// ---------------------------------------------------------------------------
// Notices (decision 0648 item 14): open's on_notice after each call

/// c, or c as a Noticed when open was given on_notice.
fn noticed[fx: Effects](p: Pool[fx], c: sql.DriverConn[fx]) -> sql.DriverConn[fx] {
  if let Some(h) = p.on_notice {
    return Noticed{c: c, h: h}
  }
  c
}

/// A connection whose notices go to on_notice after each call, in order
/// (pgconn calls OnNotice as it reads each NoticeResponse).
struct Noticed[fx: Effects] {
  c: sql.DriverConn[fx]
  h: fn(sql.Notice) uses sync
}

fn (n: Noticed) drain() {
  let h = n.h
  for x in n.c.notices() {
    h(x)
  }
}

fn (n: Noticed) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows ! sql.SqlErr uses net.dial {
  let r = n.c.query(q, args)
  n.drain()
  r
}

fn (n: Noticed) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  let r = n.c.exec(q, args)
  n.drain()
  r
}

fn (n: Noticed) begin() -> () ! sql.SqlErr uses net.dial {
  let r = n.c.begin()
  n.drain()
  r
}

fn (n: Noticed) commit() -> () ! sql.SqlErr uses net.dial {
  let r = n.c.commit()
  n.drain()
  r
}

fn (n: Noticed) rollback() -> () ! sql.SqlErr uses net.dial {
  let r = n.c.rollback()
  n.drain()
  r
}

fn (n: Noticed) ping() -> () ! sql.SqlErr uses net.dial {
  let r = n.c.ping()
  n.drain()
  r
}

fn (n: Noticed) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  let r = n.c.copy_from(table, columns, rows)
  n.drain()
  r
}

fn (n: Noticed) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  let r = n.c.copy_to(q, out)
  n.drain()
  r
}

fn (n: Noticed) prepare(q: Str) -> sql.DriverStmt? ! sql.SqlErr uses net.dial {
  let r = n.c.prepare(q)
  n.drain()
  r
}

fn (n: Noticed) close() uses net.dial {
  n.c.close()
}

fn (n: Noticed) is_broken() -> Bool { n.c.is_broken() }

fn (n: Noticed) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial {
  let r = n.c.wait_notification()
  n.drain()
  r
}

/// Drained after each call already.
fn (n: Noticed) notices() -> List[sql.Notice] { n.c.notices() }

fn (n: Noticed) pipeline(batches: List[List[sql.BatchQuery]], in_tx: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr uses net.dial {
  let r = n.c.pipeline(batches, in_tx)
  n.drain()
  r
}

// ---------------------------------------------------------------------------
// Tracing (decision 0648 item 16): open's on_trace after each traced call

/// c, or c as a Traced when open was given on_trace.
fn traced[fx: Effects](p: Pool[fx], c: sql.DriverConn[fx]) -> sql.DriverConn[fx] {
  if let Some(h) = p.on_trace {
    return Traced{c: c, h: h}
  }
  c
}

/// A connection whose calls are reported to on_trace as they end (pgx's
/// QueryTracer, BatchTracer, CopyFromTracer and PrepareTracer).
struct Traced[fx: Effects] {
  c: sql.DriverConn[fx]
  h: fn(sql.TraceRecord) uses sync
}

fn (t: Traced[fx]) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows[fx] ! sql.SqlErr uses (net.dial, fx) {
  let s = started()
  match t.c.query(q, args) {
    Ok(x) => {
      if let Some(cur) = x.cursor {
        // reported at the cursor's end, as pgx's TraceQueryEnd at Rows.Close
        return x with {cursor: Some(TracedCursor{c: cur, h: t.h, s: s, q: q, args: args, n: Atomic.new(x.rows.len()), done: Atomic.new(false)})}
      }
      emit(t.h, s, sql.TraceOp.Query, q, args, x.rows.len(), None)
      Ok(x)
    }
    Err(e) => {
      emit(t.h, s, sql.TraceOp.Query, q, args, 0, Some(e))
      Err(e)
    }
  }
}

fn (t: Traced) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  let s = started()
  let r = t.c.exec(q, args)
  emit(t.h, s, sql.TraceOp.Exec, q, args, r.map(fn(x) { x.rows_affected }).ok() ?? 0, r.err())
  r
}

/// BEGIN, COMMIT or ROLLBACK as an Exec record, as pgx traces them.
fn (t: Traced) tx_op(what: Str, r: Result[(), sql.SqlErr], s: Started) -> () ! sql.SqlErr {
  emit(t.h, s, sql.TraceOp.Exec, what, [], 0, r.err())
  r
}

fn (t: Traced) begin() -> () ! sql.SqlErr uses net.dial {
  let s = started()
  t.tx_op("BEGIN", t.c.begin(), s)
}

fn (t: Traced) commit() -> () ! sql.SqlErr uses net.dial {
  let s = started()
  t.tx_op("COMMIT", t.c.commit(), s)
}

fn (t: Traced) rollback() -> () ! sql.SqlErr uses net.dial {
  let s = started()
  t.tx_op("ROLLBACK", t.c.rollback(), s)
}

fn (t: Traced) ping() -> () ! sql.SqlErr uses net.dial { t.c.ping() }

fn (t: Traced) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  let s = started()
  let r = t.c.copy_from(table, columns, rows)
  emit(t.h, s, sql.TraceOp.CopyFrom, table, [], r.ok() ?? 0, r.err())
  r
}

fn (t: Traced) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  let s = started()
  let r = t.c.copy_to(q, out)
  emit(t.h, s, sql.TraceOp.CopyTo, q, [], r.ok() ?? 0, r.err())
  r
}

fn (t: Traced[fx]) prepare(q: Str) -> sql.DriverStmt[fx]? ! sql.SqlErr uses (net.dial, fx) {
  let s = started()
  match t.c.prepare(q) {
    Ok(ds) => {
      emit(t.h, s, sql.TraceOp.Prepare, q, [], 0, None)
      match ds {
        Some(x) => Ok(Some(TracedStmt{s: x, h: t.h, q: q}))
        None => Ok(None)
      }
    }
    Err(e) => {
      emit(t.h, s, sql.TraceOp.Prepare, q, [], 0, Some(e))
      Err(e)
    }
  }
}

fn (t: Traced) close() uses net.dial {
  t.c.close()
}

fn (t: Traced) is_broken() -> Bool { t.c.is_broken() }

fn (t: Traced) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial { t.c.wait_notification() }

fn (t: Traced) notices() -> List[sql.Notice] { t.c.notices() }

/// A BatchQuery record for each query of each batch that succeeded (pgx's
/// TraceBatchQuery; the queries are pipelined, so each has the call's
/// start and length), then one Batch record with every count and the
/// first failed batch's error.
fn (t: Traced) pipeline(batches: List[List[sql.BatchQuery]], in_tx: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr uses net.dial {
  let s = started()
  let r = t.c.pipeline(batches, in_tx)
  var total = 0
  var first: sql.SqlErr? = r.err()
  if let Ok(outs) = r {
    for (i, o) in outs.indexed() {
      match o {
        Ok(sets) => {
          for (j, x) in sets.indexed() {
            let q = if i < batches.len() && j < batches[i].len() { batches[i][j] } else { sql.BatchQuery{query: ""} }
            emit(t.h, s, sql.TraceOp.BatchQuery, q.query, q.args, x.rows_affected, None)
            total += x.rows_affected
          }
        }
        Err(e) => {
          if first.is_none() {
            first = Some(e)
          }
        }
      }
    }
  }
  emit(t.h, s, sql.TraceOp.Batch, "", [], total, first)
  r
}

/// A prepared statement whose runs are Query and Exec records of its text.
struct TracedStmt[fx: Effects] {
  s: sql.DriverStmt[fx]
  h: fn(sql.TraceRecord) uses sync
  q: Str
}

fn (t: TracedStmt[fx]) query(args: List[sql.SqlValue]) -> sql.DriverRows[fx] ! sql.SqlErr uses (net.dial, fx) {
  let s = started()
  match t.s.query(args) {
    Ok(x) => {
      if let Some(cur) = x.cursor {
        return x with {cursor: Some(TracedCursor{c: cur, h: t.h, s: s, q: t.q, args: args, n: Atomic.new(x.rows.len()), done: Atomic.new(false)})}
      }
      emit(t.h, s, sql.TraceOp.Query, t.q, args, x.rows.len(), None)
      Ok(x)
    }
    Err(e) => {
      emit(t.h, s, sql.TraceOp.Query, t.q, args, 0, Some(e))
      Err(e)
    }
  }
}

fn (t: TracedStmt[fx]) exec(args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses (net.dial, fx) {
  let s = started()
  let r = t.s.exec(args)
  emit(t.h, s, sql.TraceOp.Exec, t.q, args, r.map(fn(x) { x.rows_affected }).ok() ?? 0, r.err())
  r
}

fn (t: TracedStmt[fx]) close() uses (net.dial, fx) {
  t.s.close()
}

/// A query's cursor: its Query record when the last row has been read,
/// on an error, or at close (pgx's TraceQueryEnd at Rows.Close), with
/// the rows read.
struct TracedCursor[fx: Effects] {
  c: sql.DriverCursor[fx]
  h: fn(sql.TraceRecord) uses sync
  s: Started
  q: Str
  args: List[sql.SqlValue]
  n: Atomic[Int]
  done: Atomic[Bool]
}

fn (t: TracedCursor[fx]) end(err: sql.SqlErr?) {
  if !t.done.swap(true) {
    emit(t.h, t.s, sql.TraceOp.Query, t.q, t.args, t.n.get(), err)
  }
}

fn (t: TracedCursor[fx]) next() -> List[sql.SqlValue]? ! sql.SqlErr uses (net.dial, fx) {
  match t.c.next() {
    Ok(Some(r)) => {
      t.n.add(1)
      Ok(Some(r))
    }
    Ok(None) => {
      t.end(None)
      Ok(None)
    }
    Err(e) => {
      t.end(Some(e))
      Err(e)
    }
  }
}

fn (t: TracedCursor[fx]) rest() -> List[List[sql.SqlValue]] ! sql.SqlErr uses (net.dial, fx) {
  let r = t.c.rest()
  if let Ok(xs) = r {
    t.n.add(xs.len())
  }
  t.end(r.err())
  r
}

fn (t: TracedCursor[fx]) close() uses (net.dial, fx) {
  t.c.close()
  t.end(None)
}

fn open_driver(net: Net, d: sql.Driver, dsn: Str, max_open: Int = 10, max_idle: Int = 2, max_lifetime: Duration = 30m, on_notice: (fn(sql.Notice) uses sync)? = None, on_trace: (fn(sql.TraceRecord) uses sync)? = None) -> Db ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if max_open < 1 {
    return Err(sql.SqlErr.Param(msg: "max_open must be at least 1"))
  }
  let permits: Chan[Bool] = Chan.new(cap: max_open)
  for _ in 0..max_open {
    permits.send(true)
  }
  let p = Pool{net: net, drv: d, dsn: dsn, permits: permits, idle: Mutex.new([]), max_idle: max_idle.max(0), max_lifetime: max_lifetime.nanos().max(0), on_notice: on_notice, on_trace: on_trace, max_open: max_open, n: Mutex.new(Counts{})}
  // connect once now, so a wrong password or host fails at open
  p.ping()?
  let db = new_db({})
  db with {pool: Some(p)}
}

struct Store {
  tables: Map[Str, Table]
}

struct Tx[fx: Effects] {
  st: Mutex[TxState]
  db: Db[fx]
  /// A transaction of a driver: its connection, held from begin to its end.
  conn: Taken[fx]? = None
  /// A savepoint's name (Tx.begin, decision 0648 item 14); "" for a
  /// transaction.
  savepoint: Str = ""
  /// Db.begin's: its end gives the connection back to the pool (a driver)
  /// or the writer permit (the in memory database). A Conn's transaction,
  /// a savepoint and a Conn's own session leave them to their owner.
  owns: Bool = true
  /// The transactions and Conn this one is inside, innermost last: once
  /// one ends, this one is done too (TxDone).
  outer: List[Mutex[TxState]] = []
  /// The last savepoint number of the outermost transaction (pgx's
  /// savepointNum), shared by every savepoint inside it.
  sp: Atomic[Int]
}

struct TxState {
  tables: Map[Str, Table]
  done: Bool
  read_only: Bool = false
  /// A Conn's session (Db.conn): done after close, with Closed.
  is_conn: Bool = false
}

/// Why t cannot run now: its own end (TxDone, Closed for a Conn's
/// session) or the end of a transaction or Conn it is inside (TxDone).
fn ended(t: Tx, ts: TxState) -> sql.SqlErr? {
  if ts.done {
    return Some(if ts.is_conn { sql.SqlErr.Closed } else { sql.SqlErr.TxDone })
  }
  if outer_ended(t) {
    return Some(sql.SqlErr.TxDone)
  }
  None
}

fn outer_ended(t: Tx) -> Bool {
  for o in t.outer {
    if o.with_read(fn(os) { os.done }) {
      return true
    }
  }
  false
}

struct Row {
  cols: List[Str]
  vals: List[sql.SqlValue]
  /// the result's column types (decision 0609; empty: the driver did not say)
  types: List[sql.ColumnType] = []
}

fn null() -> sql.SqlValue { sql.SqlValue.Null }

fn int(n: Int) -> sql.SqlValue { sql.SqlValue.Integer(n: n) }

fn str(s: Str) -> sql.SqlValue { sql.SqlValue.Text(s: s) }

fn float(f: Float) -> sql.SqlValue { sql.SqlValue.Real(f: f) }

fn bool(b: Bool) -> sql.SqlValue { sql.SqlValue.Flag(b: b) }

fn time(t: Time) -> sql.SqlValue { sql.SqlValue.At(t: t) }

// Parameters of the typed readers' types (decision 0679): their
// Postgres text.

fn pad(n: Int, w: Int) -> Str {
  var t = "${n}"
  while t.len() < w {
    t = "0" + t
  }
  t
}

fn uuid(u: uuid.Uuid) -> sql.SqlValue { sql.SqlValue.Text(s: u.display()) }

fn date_text(d: time.Date) -> Str {
  if d.year <= 0 {
    return "${pad(1 - d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)} BC"
  }
  "${pad(d.year, 4)}-${pad(d.month, 2)}-${pad(d.day, 2)}"
}

fn date(d: time.Date) -> sql.SqlValue { sql.SqlValue.Text(s: date_text(d)) }

fn time_of_day(t: time.ClockTime) -> sql.SqlValue {
  sql.SqlValue.Text(s: "${pad(t.hour, 2)}:${pad(t.minute, 2)}:${pad(t.second, 2)}.${pad(t.nanos / 1000, 6)}")
}

fn interval(i: sql.Interval) -> sql.SqlValue { sql.SqlValue.Text(s: "${i.months} mon ${i.days} day ${i.micros} microsecond") }

fn prefix(p: netip.Prefix) -> sql.SqlValue { sql.SqlValue.Text(s: p.display()) }

fn mac(b: Bytes) -> sql.SqlValue {
  var parts: List[Str] = []
  for i in 0..b.len() {
    parts.push(b[i..i + 1].to_hex())
  }
  sql.SqlValue.Text(s: parts.join(":"))
}

fn hs_quote(t: Str) -> Str { "\"" + t.replace("\\", "\\\\").replace("\"", "\\\"") + "\"" }

fn hstore(m: Map[Str, Str?]) -> sql.SqlValue {
  var parts: List[Str] = []
  for (k, v) in m {
    parts.push(hs_quote(k) + "=>" + (v.map(fn(x) { hs_quote(x) }) ?? "NULL"))
  }
  sql.SqlValue.Text(s: parts.join(", "))
}

fn date_bound(b: sql.Bound[time.Date]) -> sql.SqlValue {
  match b {
    Finite(d) => date(d)
    Infinity => sql.SqlValue.Text(s: "infinity")
    NegInfinity => sql.SqlValue.Text(s: "-infinity")
  }
}

fn time_bound(b: sql.Bound[Time]) -> sql.SqlValue {
  match b {
    Finite(t) => sql.SqlValue.At(t: t)
    Infinity => sql.SqlValue.Text(s: "infinity")
    NegInfinity => sql.SqlValue.Text(s: "-infinity")
  }
}

fn interval_duration(i: sql.Interval) -> Duration? {
  if i.months != 0 || i.days != 0 {
    return None
  }
  Some(Duration.from_nanos(i.micros * 1000))
}

fn bytes(b: Bytes) -> sql.SqlValue { sql.SqlValue.Blob(b: b) }

fn json[T: Json](v: T) -> sql.SqlValue { sql.SqlValue.JsonText(s: js.encode_str(v)) }

fn array(items: List[sql.SqlValue]) -> sql.SqlValue { sql.SqlValue.Array(items: items) }

fn new_db(tables: Map[Str, Table]) -> Db {
  let w: Chan[Bool] = Chan.new(cap: 1)
  w.send(true)
  Db{st: Mutex.new(Store{tables: tables}), writer: w, closed: Atomic.new(false), stmt_ids: Atomic.new(0)}
}

fn memory(schema: Str = "") -> Db ! sql.SqlErr {
  var tables: Map[Str, Table] = {}
  if !schema.trim().is_empty() {
    mem_exec(tables, schema, [])?
  }
  new_db(tables)
}

fn open(net: Net, driver: Str, dsn: Str, max_open: Int = 10, max_idle: Int = 2, max_lifetime: Duration = 30m, roots: Bytes = b"", loc: time.Zone = time.utc(), server_pub_key: Bytes = b"", on_notice: (fn(sql.Notice) uses sync)? = None, on_trace: (fn(sql.TraceRecord) uses sync)? = None) -> Db ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if driver != "mysql" && loc.name() != "UTC" {
    // pgx has no Loc: timestamptz is an instant, timestamp's wall clock
    // reads as UTC (decision 0648 item 8)
    return Err(sql.SqlErr.Param(msg: "loc: only the mysql driver reads times in a zone (driver ${driver.quote()}, loc ${loc.name()})"))
  }
  if driver != "mysql" && !server_pub_key.is_empty() {
    return Err(sql.SqlErr.Param(msg: "server_pub_key: only the mysql driver takes an RSA key (driver ${driver.quote()})"))
  }
  if driver is "postgres" | "postgresql" {
    // the driver is Xo and dials through net, so Net.only applies (decision 0278)
    return open_driver(net, pg.PgDriver{roots: roots}, dsn, max_open: max_open, max_idle: max_idle, max_lifetime: max_lifetime, on_notice: on_notice, on_trace: on_trace)
  }
  if driver == "mysql" {
    // the driver is Xo and dials through net, as Postgres's (decision 0648)
    return open_driver(net, mysql.MysqlDriver{roots: roots, zone: loc, pub_key: server_pub_key}, dsn, max_open: max_open, max_idle: max_idle, max_lifetime: max_lifetime, on_notice: on_notice, on_trace: on_trace)
  }
  if !rt.net_lists(net).is_empty() {
    // the driver dials by itself, so an allowlist cannot be enforced:
    // fail closed (decisions 0156 and 0175)
    return Err(sql.SqlErr.Conn(msg: "an attenuated Net (Net.only) cannot open a database: the driver dials by itself; pass an unattenuated Net"))
  }
  if max_open < 1 {
    return Err(sql.SqlErr.Param(msg: "max_open must be at least 1"))
  }
  Err(sql.SqlErr.Driver(msg: "unknown driver ${driver}"))
}

fn (d: Db) ready() -> () ! sql.SqlErr {
  if d.closed.get() {
    return Err(sql.SqlErr.Closed)
  }
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
}

fn to_rows(cols: List[Str], types: List[sql.ColumnType], rows: List[List[sql.SqlValue]]) -> List[Row] {
  var out: List[Row] = []
  for r in rows {
    out.push(Row{cols: cols, vals: r, types: types})
  }
  out
}

fn (d: Db) query(q: Str, args: List[sql.SqlValue] = []) -> List[Row] ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    return p.query(q, args)
  }
  // a failing statement leaves the tables as they were (decision 0528:
  // each statement checks everything before it changes anything)
  // (the outcome as the closure's success value: its writes are kept, and
  // a failed statement made none)
  let res = d.st.with(fn(var st) -> Result[MemRows, sql.SqlErr] { mem_run(st.tables, q, args) })?
  to_rows(res.cols, res.types, res.rows)
}

fn (d: Db) query_one(q: Str, args: List[sql.SqlValue] = []) -> Row ! sql.SqlErr uses net.dial {
  let rows = d.query(q, args)?
  if rows.is_empty() {
    return Err(sql.SqlErr.NoRows)
  }
  rows[0]
}

fn (d: Db) exec(q: Str, args: List[sql.SqlValue] = []) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    return p.exec(q, args)
  }
  d.st.with(fn(var st) -> Result[sql.ExecResult, sql.SqlErr] { mem_exec(st.tables, q, args) })?
}

fn (d: Db) query_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> List[T] ! sql.SqlErr uses net.dial {
  decode_all(d.query(q, args)?)
}

fn (d: Db) query_one_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> T ! sql.SqlErr uses net.dial {
  d.query_one(q, args)?.decode[T]()
}

fn decode_all[T: SqlRow](rows: List[Row]) -> List[T] ! sql.SqlErr {
  var out: List[T] = []
  for r in rows {
    out.push(r.decode[T]()?)
  }
  out
}

fn (d: Db) ping() -> () ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    return p.ping()
  }
}

fn (d: Db) stats() -> sql.PoolStats {
  match d.pool {
    Some(p) => p.stats()
    None => sql.PoolStats{max_open: 0, open: 0, in_use: 0, idle: 0, connecting: 0, acquire_count: 0, acquire_time: 0s, wait_count: 0, wait_time: 0s, canceled_acquire_count: 0, new_conns: 0, max_idle_closed: 0, max_lifetime_closed: 0}
  }
}

fn (d: Db) close() -> () ! sql.SqlErr {
  d.closed.set(true)
  if let Some(p) = d.pool {
    p.close_idle()
  }
}

fn (d: Db) begin(isolation: sql.Isolation = sql.Isolation.Default, read_only: Bool = false, deferrable: Bool = false) -> Tx ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    // the transaction holds its permit and connection until it ends
    let t = p.take()?
    if let Err(e) = begin_on(t, isolation, read_only, deferrable) {
      give(p, t)
      return Err(e)
    }
    return Tx{st: Mutex.new(TxState{tables: {}, done: false}), db: d, conn: Some(t), sp: Atomic.new(0)}
  }
  // the single writer permit; waiting is a cancellation point
  if d.writer.recv() is None {
    return Err(sql.SqlErr.Canceled)
  }
  let tables = d.st.with_read(fn(st) { st.tables })
  Tx{st: Mutex.new(TxState{tables: tables, done: false, read_only: read_only}), db: d, sp: Atomic.new(0)}
}

/// BEGIN on t, then the options' SET TRANSACTION; when that fails, the
/// transaction is rolled back and its error is the one returned.
fn begin_on[fx: Effects](t: Taken[fx], isolation: sql.Isolation, read_only: Bool, deferrable: Bool) -> () ! sql.SqlErr uses (net.dial, fx) {
  t.c.begin()?
  if let Some(mode) = tx_mode(isolation, read_only, deferrable) {
    if let Err(e) = t.c.exec(mode, []) {
      let _ = t.c.rollback().ignore_err("the SET TRANSACTION error is the one to report")
      return Err(e)
    }
  }
}

/// The statement that sets a driver transaction's options after BEGIN
/// (pgx's stdlib puts the same modes in its BEGIN, pgx's TxOptions
/// DeferrableMode the DEFERRABLE); None for the defaults.
fn tx_mode(isolation: sql.Isolation, read_only: Bool, deferrable: Bool) -> Str? {
  var modes: List[Str] = []
  match isolation {
    Default => {}
    ReadUncommitted => modes.push("ISOLATION LEVEL READ UNCOMMITTED")
    ReadCommitted => modes.push("ISOLATION LEVEL READ COMMITTED")
    RepeatableRead => modes.push("ISOLATION LEVEL REPEATABLE READ")
    Serializable => modes.push("ISOLATION LEVEL SERIALIZABLE")
  }
  if read_only {
    modes.push("READ ONLY")
  }
  if deferrable {
    modes.push("DEFERRABLE")
  }
  if modes.is_empty() {
    return None
  }
  Some("SET TRANSACTION ${modes.join(", ")}")
}

/// Postgres's refusal of a write in a read only transaction, for the in
/// memory database: every statement but a SELECT writes there.
fn read_only_refusal(q: Str) -> sql.SqlErr? {
  let t = q.trim()
  let word = t[0..(t.find(" ") ?? t.len())].to_upper()
  if word == "SELECT" {
    return None
  }
  Some(sql.SqlErr.Server(code: "25006", msg: "cannot execute ${word} in a read-only transaction"))
}

fn (t: Tx) query(q: Str, args: List[sql.SqlValue] = []) -> List[Row] ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    let rows = t.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      drain_rows(tc.c.query(q, args)?)
    })?
    return to_rows(rows.columns, rows.column_types, rows.rows)
  }
  let res = t.st.with(fn(var ts) -> MemRows ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    var work = ts.tables
    let r = mem_run(work, q, args)?
    ts.tables = work
    r
  })?
  to_rows(res.cols, res.types, res.rows)
}

fn (t: Tx) query_one(q: Str, args: List[sql.SqlValue] = []) -> Row ! sql.SqlErr uses net.dial {
  let rows = t.query(q, args)?
  if rows.is_empty() {
    return Err(sql.SqlErr.NoRows)
  }
  rows[0]
}

fn (t: Tx) exec(q: Str, args: List[sql.SqlValue] = []) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    return t.st.with(fn(var ts) -> sql.ExecResult ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      tc.c.exec(q, args)
    })
  }
  t.st.with(fn(var ts) -> sql.ExecResult ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    if ts.read_only {
      if let Some(e) = read_only_refusal(q) {
        return Err(e)
      }
    }
    // a failed statement leaves the transaction as it was
    var work = ts.tables
    let r = mem_exec(work, q, args)?
    ts.tables = work
    r
  })
}

fn (t: Tx) query_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> List[T] ! sql.SqlErr uses net.dial {
  decode_all(t.query(q, args)?)
}

fn (t: Tx) query_one_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> T ! sql.SqlErr uses net.dial {
  t.query_one(q, args)?.decode[T]()
}

/// Marks the transaction done and tells whether it already was. The driver's
/// commit or rollback runs after this, outside the mutex section: an Err
/// returned from a Mutex.with closure undoes the closure's writes (core
/// 5.4), which would un-mark `done` while the connection is back in the pool.
fn finish_once(t: Tx) -> Bool {
  t.st.with(fn(var ts) -> Bool {
    let was = ts.done
    ts.done = true
    was
  })
}

fn (t: Tx) commit() -> () ! sql.SqlErr uses net.dial {
  let db = t.db
  if let Some(tc) = t.conn {
    if finish_once(t) || outer_ended(t) {
      // an outer end already gave the connection back
      return Err(sql.SqlErr.TxDone)
    }
    if !t.savepoint.is_empty() {
      let _ = tc.c.exec("release savepoint ${t.savepoint}", [])?
      return Ok(())
    }
    let r = tc.c.commit()
    if t.owns {
      close_tx_stmts(tc)
      give(db.pool.or_fault("a driver's transaction has a pool"), tc)
    }
    return r
  }
  t.st.with(fn(var ts) -> () ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    ts.done = true
    let tables = ts.tables
    if t.owns {
      db.st.with(fn(var st) { st.tables = tables })
      db.writer.send(true)
    } else if let Some(up) = t.outer.last() {
      // a savepoint's tables become the outer transaction's
      up.with(fn(var us) { us.tables = tables })
    }
    Ok(())
  })
}

fn (t: Tx) rollback() -> () ! sql.SqlErr uses net.dial {
  let db = t.db
  if let Some(tc) = t.conn {
    if finish_once(t) || outer_ended(t) {
      return Ok(())
    }
    if !t.savepoint.is_empty() {
      let _ = tc.c.exec("rollback to savepoint ${t.savepoint}", [])?
      return Ok(())
    }
    let r = tc.c.rollback()
    if t.owns {
      close_tx_stmts(tc)
      give(db.pool.or_fault("a driver's transaction has a pool"), tc)
    }
    return r
  }
  t.st.with(fn(var ts) {
    if !ts.done {
      ts.done = true
      if t.owns {
        db.writer.send(true)
      }
    }
  })
}

/// A savepoint inside t (decision 0648 item 14, pgx's Tx.Begin).
fn (t: Tx) begin() -> Tx ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  var outer = t.outer
  outer.push(t.st)
  if let Some(tc) = t.conn {
    let name = t.st.with(fn(var ts) -> Str ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      let name = "sp_${t.sp.add(1)}"
      let _ = tc.c.exec("savepoint ${name}", [])?
      name
    })?
    return Tx{st: Mutex.new(TxState{tables: {}, done: false}), db: t.db, conn: t.conn, savepoint: name, owns: false, outer: outer, sp: t.sp}
  }
  let (tables, ro) = t.st.with(fn(var ts) -> (Map[Str, Table], Bool) ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    (ts.tables, ts.read_only)
  })?
  Tx{st: Mutex.new(TxState{tables: tables, done: false, read_only: ro}), db: t.db, savepoint: "sp_${t.sp.add(1)}", owns: false, outer: outer, sp: t.sp}
}

// ---------------------------------------------------------------------------
// Row

/// A result read as asked (decision 0479): the rows already in hand, the
/// driver's cursor for the rest, and the pool connection held until the end.
struct Rows[fx: Effects] {
  cols: List[Str]
  st: Mutex[RowsState[fx]]
  types: List[sql.ColumnType] = []
}

struct RowsState[fx: Effects] {
  buf: List[List[sql.SqlValue]]
  pos: Int
  cursor: sql.DriverCursor[fx]? = None
  /// The pool connection of a Db.rows, given back at the end.
  held: Taken[fx]? = None
  pool: Pool[fx]? = None
  done: Bool = false
}

fn new_rows(cols: List[Str], types: List[sql.ColumnType], s: RowsState) -> Rows {
  Rows{cols: cols, st: Mutex.new(s), types: types}
}

/// types, or `ColumnType{name}` per column when the driver gave none
/// (decision 0609).
fn column_types_of(cols: List[Str], types: List[sql.ColumnType]) -> List[sql.ColumnType] {
  if types.len() == cols.len() {
    return types
  }
  cols.map(fn(c) { sql.ColumnType{name: c} })
}

/// The end of a cursor: the connection goes back to the pool.
fn rows_finish(var s: RowsState) {
  s.done = true
  s.cursor = None
  s.buf = []
  if let Some(t) = s.held {
    if let Some(p) = s.pool {
      give(p, t)
    }
  }
  s.held = None
}

/// The Rows of x taken from the pool connection t: a result with no
/// cursor is whole, so the connection goes back at once.
fn pool_rows[fx: Effects](p: Pool[fx], t: Taken[fx], x: sql.DriverRows[fx]) -> Rows[fx] uses (net.dial, fx) {
  if x.cursor is None {
    give(p, t)
    return new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0})
  }
  new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0, cursor: x.cursor, held: Some(t), pool: Some(p)})
}

fn (d: Db) rows(q: Str, args: List[sql.SqlValue] = []) -> Rows ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    let t = p.take()?
    match t.c.query(q, args) {
      Ok(x) => return pool_rows(p, t, x)
      Err(e) => {
        give(p, t)
        return Err(e)
      }
    }
  }
  // a failing statement leaves the tables as they were (decision 0528:
  // each statement checks everything before it changes anything)
  // (the outcome as the closure's success value: its writes are kept, and
  // a failed statement made none)
  let res = d.st.with(fn(var st) -> Result[MemRows, sql.SqlErr] { mem_run(st.tables, q, args) })?
  new_rows(res.cols, res.types, RowsState{buf: res.rows, pos: 0})
}

fn (t: Tx) rows(q: Str, args: List[sql.SqlValue] = []) -> Rows ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    let x = t.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      tc.c.query(q, args)
    })?
    return new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0, cursor: x.cursor})
  }
  let res = t.st.with(fn(var ts) -> MemRows ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    var work = ts.tables
    let r = mem_run(work, q, args)?
    ts.tables = work
    r
  })?
  new_rows(res.cols, res.types, RowsState{buf: res.rows, pos: 0})
}

fn quote_ident(name: Str) -> Str { "\"" + name.replace("\"", "\"\"") + "\"" }

/// The INSERT of one COPY row on the in memory database.
fn copy_insert_sql(table: Str, columns: List[Str]) -> Str {
  var ph: List[Str] = []
  for i in 0..columns.len() {
    ph.push("$${i + 1}")
  }
  if columns.is_empty() {
    return "INSERT INTO ${table} VALUES"
  }
  "INSERT INTO ${table} (${columns.join(", ")}) VALUES (${ph.join(", ")})"
}

fn (d: Db) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    let t = p.take()?
    let r = t.c.copy_from(table, columns, rows)
    give(p, t)
    return r
  }
  mem_copy(fn(q, args) { d.exec(q, args) }, table, columns, rows)
}

fn (d: Db) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    let t = p.take()?
    let r = t.c.copy_to(q, out)
    give(p, t)
    return r
  }
  Err(sql.SqlErr.Driver(msg: "the in memory database has no COPY TO"))
}

fn (t: Tx) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    return t.st.with(fn(var ts) -> Int ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      tc.c.copy_to(q, out)
    })
  }
  Err(sql.SqlErr.Driver(msg: "the in memory database has no COPY TO"))
}

fn (t: Tx) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    return t.st.with(fn(var ts) -> Int ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      tc.c.copy_from(table, columns, rows)
    })
  }
  mem_copy(fn(q, args) { t.exec(q, args) }, table, columns, rows)
}

/// COPY on the in memory database: an INSERT per row. The rows copied
/// before an error from rows stay, as the in memory driver has no COPY to
/// roll back (use a transaction).
fn mem_copy[fx: Effects](ins: fn(Str, List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses fx, table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses fx {
  let q = copy_insert_sql(table, columns)
  var n = 0
  while {
    match rows()? {
      Some(r) => {
        ins(q, r)?
        n += 1
      }
      None => break
    }
  }
  n
}

fn (r: Rows) columns() -> List[Str] { r.cols }

fn (r: Rows) column_types() -> List[sql.ColumnType] { column_types_of(r.cols, r.types) }

fn (r: Rows) next() -> Row? ! sql.SqlErr uses net.dial {
  // the closure always returns Ok: an Err would undo rows_finish (a
  // Mutex.with closure's changes are kept only when it returns Ok)
  let (row, err) = r.st.with(fn(var s) -> (Row?, sql.SqlErr?) {
    if s.done {
      return (None, None)
    }
    if s.pos < s.buf.len() {
      let v = s.buf[s.pos]
      s.pos += 1
      return (Some(Row{cols: r.cols, vals: v, types: r.types}), None)
    }
    match s.cursor {
      Some(c) => {
        match c.next() {
          Ok(o) => {
            match o {
              Some(v) => (Some(Row{cols: r.cols, vals: v, types: r.types}), None)
              None => {
                rows_finish(s)
                (None, None)
              }
            }
          }
          Err(e) => {
            rows_finish(s)
            (None, Some(e))
          }
        }
      }
      None => {
        rows_finish(s)
        (None, None)
      }
    }
  })
  if let Some(e) = err {
    return Err(e)
  }
  row
}

fn (r: Rows) next_as[T: SqlRow]() -> T? ! sql.SqlErr uses net.dial {
  match r.next()? {
    Some(row) => Some(row.decode[T]()?)
    None => None
  }
}

fn (r: Rows) close() uses net.dial {
  r.st.with(fn(var s) {
    if s.done {
      return
    }
    if let Some(c) = s.cursor {
      c.close()
    }
    rows_finish(s)
  })
}

fn rows_each(rs: Rows, f: fn(Row) -> () ! sql.SqlErr uses sync) -> () ! sql.SqlErr uses net.dial {
  while true {
    match rs.next() {
      Ok(o) => {
        match o {
          Some(row) => {
            match f(row) {
              Ok(_) => {}
              Err(e) => {
                rs.close()
                return Err(e)
              }
            }
          }
          None => return
        }
      }
      Err(e) => {
        rs.close()
        return Err(e)
      }
    }
  }
}

fn (d: Db) each(q: Str, args: List[sql.SqlValue], f: fn(Row) -> () ! sql.SqlErr uses sync) -> () ! sql.SqlErr uses net.dial {
  rows_each(d.rows(q, args)?, f)
}

fn (t: Tx) each(q: Str, args: List[sql.SqlValue], f: fn(Row) -> () ! sql.SqlErr uses sync) -> () ! sql.SqlErr uses net.dial {
  rows_each(t.rows(q, args)?, f)
}

// ---------------------------------------------------------------------------
// Prepared statements and multi results (decision 0648 items 6 and 7)

struct Stmt[fx: Effects] {
  db: Db[fx]
  /// The transaction of a Tx.prepare.
  tx: Tx[fx]? = None
  q: Str
  id: Int
  closed: Atomic[Bool]
}

/// Closes and drops the entries of closed statements: at a connection's
/// take and give, and at a Stmt's close for the idle ones.
fn sweep[fx: Effects](stmts: Mutex[List[Cached[fx]]]) uses (net.dial, fx) {
  let gone = stmts.with(fn(var xs) -> List[Cached[fx]] {
    var keep: List[Cached[fx]] = []
    var out: List[Cached[fx]] = []
    for x in xs {
      if x.closed.get() {
        out.push(x)
      } else {
        keep.push(x)
      }
    }
    xs = keep
    out
  })
  for x in gone {
    if let Some(ds) = x.ds {
      ds.close()
    }
  }
}

/// s as prepared on t, preparing it there on its first use.
fn stmt_on[fx: Effects](t: Taken[fx], s: Stmt[fx]) -> sql.DriverStmt[fx]? ! sql.SqlErr uses (net.dial, fx) {
  let found = t.stmts.with_read(fn(xs) -> Cached[fx]? {
    for x in xs {
      if x.id == s.id {
        return Some(x)
      }
    }
    None
  })
  if let Some(x) = found {
    return x.ds
  }
  let ds = t.c.prepare(s.q)?
  add_stmt(t.stmts, Cached{id: s.id, ds: ds, closed: s.closed, in_tx: s.tx.is_some()})
  ds
}

/// Adds c to a taken connection's cache. Only the task holding the
/// connection reads or changes its cache, so the lookup before this
/// cannot go stale (a sweep of the idle list never sees a taken one).
fn add_stmt[fx: Effects](stmts: Mutex[List[Cached[fx]]], c: Cached[fx]) {
  stmts.with(fn(var xs) { xs.push(c) })
}

fn stmt_query[fx: Effects](t: Taken[fx], s: Stmt[fx], args: List[sql.SqlValue]) -> sql.DriverRows[fx] ! sql.SqlErr uses (net.dial, fx) {
  match stmt_on(t, s)? {
    Some(ds) => ds.query(args)
    None => t.c.query(s.q, args)
  }
}

fn stmt_exec[fx: Effects](t: Taken[fx], s: Stmt[fx], args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses (net.dial, fx) {
  match stmt_on(t, s)? {
    Some(ds) => ds.exec(args)
    None => t.c.exec(s.q, args)
  }
}

/// Marks the statements a transaction prepared on t closed, at its end:
/// the give that follows closes them.
fn close_tx_stmts[fx: Effects](t: Taken[fx]) {
  t.stmts.with_read(fn(xs) {
    for x in xs {
      if x.in_tx {
        x.closed.set(true)
      }
    }
  })
}

fn (d: Db) prepare(q: Str) -> Stmt ! sql.SqlErr uses net.dial {
  d.ready()?
  let s = Stmt{db: d, q: q, id: d.stmt_ids.add(1), closed: Atomic.new(false)}
  if let Some(p) = d.pool {
    let t = p.take()?
    let r = stmt_on(t, s)
    give(p, t)
    let _ = r?
  }
  s
}

fn (t: Tx) prepare(q: Str) -> Stmt ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  let s = Stmt{db: t.db, tx: Some(t), q: q, id: t.db.stmt_ids.add(1), closed: Atomic.new(false)}
  t.st.with(fn(var ts) -> () ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    if let Some(tc) = t.conn {
      let _ = stmt_on(tc, s)?
    }
  })?
  s
}

fn (s: Stmt) text() -> Str { s.q }

/// A Tx's statement: Canceled, TxDone after the transaction ended, then
/// Closed after close; a Db's: Closed after close, then Db.ready (std/rt
/// sqlstmt.go stmtRun).
fn (s: Stmt) ready() -> () ! sql.SqlErr {
  if let Some(tx) = s.tx {
    if task.is_canceled() {
      return Err(sql.SqlErr.Canceled)
    }
    if let Some(e) = tx.st.with_read(fn(ts) { ended(tx, ts) }) {
      return Err(e)
    }
    if s.closed.get() {
      return Err(sql.SqlErr.Closed)
    }
    return Ok(())
  }
  if s.closed.get() {
    return Err(sql.SqlErr.Closed)
  }
  s.db.ready()
}

fn (s: Stmt) query(args: List[sql.SqlValue] = []) -> List[Row] ! sql.SqlErr uses net.dial {
  s.ready()?
  if let Some(tx) = s.tx {
    if let Some(tc) = tx.conn {
      let rows = tx.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
        if let Some(e) = ended(tx, ts) {
          return Err(e)
        }
        drain_rows(stmt_query(tc, s, args)?)
      })?
      return to_rows(rows.columns, rows.column_types, rows.rows)
    }
    return tx.query(s.q, args)
  }
  if let Some(p) = s.db.pool {
    let t = p.take()?
    let r = match stmt_query(t, s, args) {
      Ok(x) => drain_rows(x)
      Err(e) => Err(e)
    }
    give(p, t)
    let rows = r?
    return to_rows(rows.columns, rows.column_types, rows.rows)
  }
  s.db.query(s.q, args)
}

fn (s: Stmt) query_one(args: List[sql.SqlValue] = []) -> Row ! sql.SqlErr uses net.dial {
  let rows = s.query(args)?
  if rows.is_empty() {
    return Err(sql.SqlErr.NoRows)
  }
  rows[0]
}

fn (s: Stmt) exec(args: List[sql.SqlValue] = []) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  s.ready()?
  if let Some(tx) = s.tx {
    if let Some(tc) = tx.conn {
      return tx.st.with(fn(var ts) -> sql.ExecResult ! sql.SqlErr {
        if let Some(e) = ended(tx, ts) {
          return Err(e)
        }
        stmt_exec(tc, s, args)
      })
    }
    return tx.exec(s.q, args)
  }
  if let Some(p) = s.db.pool {
    let t = p.take()?
    let r = stmt_exec(t, s, args)
    give(p, t)
    return r
  }
  s.db.exec(s.q, args)
}

fn (s: Stmt) rows(args: List[sql.SqlValue] = []) -> Rows ! sql.SqlErr uses net.dial {
  s.ready()?
  if let Some(tx) = s.tx {
    if let Some(tc) = tx.conn {
      let x = tx.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
        if let Some(e) = ended(tx, ts) {
          return Err(e)
        }
        stmt_query(tc, s, args)
      })?
      return new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0, cursor: x.cursor})
    }
    return tx.rows(s.q, args)
  }
  if let Some(p) = s.db.pool {
    let t = p.take()?
    match stmt_query(t, s, args) {
      Ok(x) => return pool_rows(p, t, x)
      Err(e) => {
        give(p, t)
        return Err(e)
      }
    }
  }
  s.db.rows(s.q, args)
}

fn (s: Stmt) query_as[T: SqlRow](args: List[sql.SqlValue] = []) -> List[T] ! sql.SqlErr uses net.dial {
  decode_all(s.query(args)?)
}

fn (s: Stmt) query_one_as[T: SqlRow](args: List[sql.SqlValue] = []) -> T ! sql.SqlErr uses net.dial {
  s.query_one(args)?.decode[T]()
}

fn (s: Stmt) close() uses net.dial {
  if s.closed.swap(true) {
    return
  }
  if s.tx.is_some() {
    // the transaction's connection closes it at the transaction's end
    return
  }
  if let Some(p) = s.db.pool {
    // the idle connections now; one in use at its give
    let xs = p.idle.with(fn(var xs) {
      let all = xs
      xs = []
      all
    })
    // they are this task's now, like a take; each goes back like a give
    for x in xs {
      sweep(x.stmts)
      if !put_idle(p, x) {
        x.c.close()
      }
    }
  }
}

/// Puts x back on the idle list if it has room.
fn put_idle[fx: Effects](p: Pool[fx], x: Idle[fx]) -> Bool {
  p.idle.with(fn(var ys) -> Bool {
    if ys.len() >= p.max_idle {
      return false
    }
    ys.push(x)
    true
  })
}

struct ResultSet {
  cols: List[Str]
  types: List[sql.ColumnType]
  rs: List[Row]
  /// A batch query's count (decision 0648 item 15); 0 from query_all.
  affected: Int = 0
}

fn (s: ResultSet) columns() -> List[Str] { s.cols }

fn (s: ResultSet) column_types() -> List[sql.ColumnType] { s.types }

fn (s: ResultSet) rows() -> List[Row] { s.rs }

fn (s: ResultSet) rows_affected() -> Int { s.affected }

/// The sets of a driver's result: the first, when it has columns, and
/// the later ones.
fn result_sets(x: sql.DriverRows) -> List[ResultSet] {
  var out: List[ResultSet] = []
  if !x.columns.is_empty() {
    out.push(ResultSet{cols: x.columns, types: column_types_of(x.columns, x.column_types), rs: to_rows(x.columns, x.column_types, x.rows)})
  }
  for m in x.more {
    out.push(ResultSet{cols: m.columns, types: column_types_of(m.columns, m.column_types), rs: to_rows(m.columns, m.column_types, m.rows)})
  }
  out
}

fn mem_sets(rs: List[MemRows]) -> List[ResultSet] {
  rs.map(fn(r) { ResultSet{cols: r.cols, types: column_types_of(r.cols, r.types), rs: to_rows(r.cols, r.types, r.rows)} })
}

fn (d: Db) query_all(q: Str, args: List[sql.SqlValue] = []) -> List[ResultSet] ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    let t = p.take()?
    let r = match t.c.query(q, args) {
      Ok(x) => drain_rows(x)
      Err(e) => Err(e)
    }
    give(p, t)
    return result_sets(r?)
  }
  let rs = d.st.with(fn(var st) -> Result[List[MemRows], sql.SqlErr] { mem_run_all(st.tables, q, args) })?
  mem_sets(rs)
}

fn (t: Tx) query_all(q: Str, args: List[sql.SqlValue] = []) -> List[ResultSet] ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    let x = t.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      drain_rows(tc.c.query(q, args)?)
    })?
    return result_sets(x)
  }
  let rs = t.st.with(fn(var ts) -> List[MemRows] ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    if ts.read_only {
      if let Some(e) = read_only_refusal(q) {
        return Err(e)
      }
    }
    var work = ts.tables
    let r = mem_run_all(work, q, args)?
    ts.tables = work
    r
  })?
  mem_sets(rs)
}

// ---------------------------------------------------------------------------
// Batches and pipelines (decision 0648 item 15, pgx's SendBatch and
// pgconn's Pipeline): DriverConn.pipeline on a driver's connection, each
// batch on a copy of the tables on the in memory database

/// The outcome of each batch of a pipeline.
type Outcomes = List[Result[List[ResultSet], sql.SqlErr]]

fn set_of(r: sql.DriverResult) -> ResultSet {
  ResultSet{cols: r.columns, types: column_types_of(r.columns, r.column_types), rs: to_rows(r.columns, r.column_types, r.rows), affected: r.rows_affected}
}

fn sets_of(rs: List[Result[List[sql.DriverResult], sql.SqlErr]]) -> Outcomes {
  var out: Outcomes = List.with_capacity(rs.len())
  for r in rs {
    out.push(match r {
      Ok(xs) => Ok(xs.map(set_of))
      Err(e) => Err(e)
    })
  }
  out
}

/// The one batch of a pipeline of one: its sets, or its error.
fn only_batch(rs: Outcomes) -> List[ResultSet] ! sql.SqlErr {
  if rs.len() != 1 {
    return Err(sql.SqlErr.Driver(msg: "pipeline: ${rs.len()} results for 1 batch"))
  }
  match rs[0] {
    Ok(xs) => Ok(xs)
    Err(e) => Err(e)
  }
}

/// One query of a batch on the in memory database: one statement, its
/// rows (a SELECT, or a write with RETURNING) and its count.
fn mem_batch_one(var tables: Map[Str, Table], q: Str, args: List[sql.SqlValue]) -> sql.DriverResult ! sql.SqlErr {
  let stmts = split_statements(lex(q)?)
  if stmts.len() != 1 {
    return Err(syntax("expected one statement"))
  }
  var p = Parser{toks: stmts[0]}
  if p.is_kw("select") {
    let r = mem_select(tables, p, args)?
    return sql.DriverResult{columns: r.cols, rows: r.rows, column_types: r.types, rows_affected: r.rows.len()}
  }
  let w = exec_one(tables, stmts[0], args)?
  sql.DriverResult{columns: w.cols, rows: w.rows, column_types: w.types, rows_affected: w.n}
}

/// A batch on the in memory database: on a copy of tables, published when
/// every query succeeds.
fn mem_batch(var tables: Map[Str, Table], qs: List[sql.BatchQuery], read_only: Bool) -> List[sql.DriverResult] ! sql.SqlErr {
  if qs.is_empty() {
    return []
  }
  var work = tables
  var out: List[sql.DriverResult] = List.with_capacity(qs.len())
  for x in qs {
    if read_only {
      if let Some(e) = read_only_refusal(x.query) {
        return Err(e)
      }
    }
    out.push(mem_batch_one(work, x.query, x.args)?)
  }
  tables = work
  out
}

fn mem_pipeline(var tables: Map[Str, Table], batches: List[List[sql.BatchQuery]], read_only: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] {
  var out: List[Result[List[sql.DriverResult], sql.SqlErr]] = List.with_capacity(batches.len())
  for b in batches {
    out.push(mem_batch(tables, b, read_only))
  }
  out
}

fn (d: Db) pipeline(batches: List[List[sql.BatchQuery]]) -> Outcomes ! sql.SqlErr uses net.dial {
  d.ready()?
  if batches.is_empty() {
    return []
  }
  if let Some(p) = d.pool {
    let t = p.take()?
    let r = t.c.pipeline(batches, false)
    give(p, t)
    return sets_of(r?)
  }
  let rs = d.st.with(fn(var st) { mem_pipeline(st.tables, batches, false) })
  sets_of(rs)
}

fn (d: Db) batch(queries: List[sql.BatchQuery]) -> List[ResultSet] ! sql.SqlErr uses net.dial {
  if queries.is_empty() {
    d.ready()?
    return []
  }
  only_batch(d.pipeline([queries])?)
}

/// The batches on t's connection (a Conn's session runs each in a
/// transaction of its own), or on its tables.
fn (t: Tx) pipeline_on(batches: List[List[sql.BatchQuery]]) -> Outcomes ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    let rs = t.st.with(fn(var ts) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr {
      if let Some(e) = ended(t, ts) {
        return Err(e)
      }
      if batches.is_empty() {
        return []
      }
      tc.c.pipeline(batches, !ts.is_conn)
    })?
    return sets_of(rs)
  }
  let rs = t.st.with(fn(var ts) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr {
    if let Some(e) = ended(t, ts) {
      return Err(e)
    }
    mem_pipeline(ts.tables, batches, ts.read_only)
  })?
  sets_of(rs)
}

fn (t: Tx) batch(queries: List[sql.BatchQuery]) -> List[ResultSet] ! sql.SqlErr uses net.dial {
  let rs = t.pipeline_on(if queries.is_empty() { [] } else { [queries] })?
  if rs.is_empty() {
    return []
  }
  only_batch(rs)
}

// ---------------------------------------------------------------------------
// Conn: one pool connection held across calls (decision 0648 item 14)

struct Conn[fx: Effects] {
  db: Db[fx]
  /// A driver's connection, as a transaction that never ran BEGIN: its
  /// state is the Conn's (done after close, with Closed), its conn the
  /// held one, and it does not own it (close gives it back). None on the
  /// in memory database, where a Conn runs on the Db.
  tx: Tx[fx]? = None
  closed: Atomic[Bool]
  listened: Atomic[Bool]
  /// The states of the transactions begun on the Conn: one still open at
  /// close is rolled back first.
  txs: Mutex[List[Mutex[TxState]]]
}

const NO_NOTIFY = "LISTEN/NOTIFY: the in memory database has no notifications"

fn (d: Db) conn() -> Conn ! sql.SqlErr uses net.dial {
  d.ready()?
  var tx: Tx? = None
  if let Some(p) = d.pool {
    let t = p.take()?
    tx = Some(Tx{st: Mutex.new(TxState{tables: {}, done: false, is_conn: true}), db: d, conn: Some(t), owns: false, sp: Atomic.new(0)})
  }
  Conn{db: d, tx: tx, closed: Atomic.new(false), listened: Atomic.new(false), txs: Mutex.new([])}
}

/// The Conn's session: a driver's, or None on the in memory database;
/// Closed after close.
fn (c: Conn) on() -> Tx? ! sql.SqlErr {
  if c.closed.get() {
    return Err(sql.SqlErr.Closed)
  }
  c.tx
}

fn (c: Conn) query(q: Str, args: List[sql.SqlValue] = []) -> List[Row] ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.query(q, args)
    None => c.db.query(q, args)
  }
}

fn (c: Conn) rows(q: Str, args: List[sql.SqlValue] = []) -> Rows ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.rows(q, args)
    None => c.db.rows(q, args)
  }
}

fn (c: Conn) each(q: Str, args: List[sql.SqlValue], f: fn(Row) -> () ! sql.SqlErr uses sync) -> () ! sql.SqlErr uses net.dial {
  rows_each(c.rows(q, args)?, f)
}

fn (c: Conn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.copy_from(table, columns, rows)
    None => c.db.copy_from(table, columns, rows)
  }
}

fn (c: Conn) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.copy_to(q, out)
    None => c.db.copy_to(q, out)
  }
}

fn (c: Conn) query_one(q: Str, args: List[sql.SqlValue] = []) -> Row ! sql.SqlErr uses net.dial {
  let rows = c.query(q, args)?
  if rows.is_empty() {
    return Err(sql.SqlErr.NoRows)
  }
  rows[0]
}

fn (c: Conn) exec(q: Str, args: List[sql.SqlValue] = []) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.exec(q, args)
    None => c.db.exec(q, args)
  }
}

fn (c: Conn) query_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> List[T] ! sql.SqlErr uses net.dial {
  decode_all(c.query(q, args)?)
}

fn (c: Conn) query_one_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> T ! sql.SqlErr uses net.dial {
  c.query_one(q, args)?.decode[T]()
}

fn (c: Conn) begin(isolation: sql.Isolation = sql.Isolation.Default, read_only: Bool = false, deferrable: Bool = false) -> Tx ! sql.SqlErr uses net.dial {
  let s = match c.on()? {
    Some(t) => t
    None => return c.db.begin(isolation, read_only, deferrable)
  }
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  let tc = s.conn.or_fault("a Conn's session holds a connection")
  s.st.with(fn(var ts) -> () ! sql.SqlErr {
    if let Some(e) = ended(s, ts) {
      return Err(e)
    }
    begin_on(tc, isolation, read_only, deferrable)
  })?
  let tx = Tx{st: Mutex.new(TxState{tables: {}, done: false}), db: c.db, conn: Some(tc), owns: false, outer: [s.st], sp: Atomic.new(0)}
  c.txs.with(fn(var xs) { xs.push(tx.st) })
  tx
}

fn (c: Conn) prepare(q: Str) -> Stmt ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.prepare(q)
    None => c.db.prepare(q)
  }
}

fn (c: Conn) query_all(q: Str, args: List[sql.SqlValue] = []) -> List[ResultSet] ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.query_all(q, args)
    None => c.db.query_all(q, args)
  }
}

fn (c: Conn) pipeline(batches: List[List[sql.BatchQuery]]) -> Outcomes ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.pipeline_on(batches)
    None => c.db.pipeline(batches)
  }
}

fn (c: Conn) batch(queries: List[sql.BatchQuery]) -> List[ResultSet] ! sql.SqlErr uses net.dial {
  match c.on()? {
    Some(t) => t.batch(queries)
    None => c.db.batch(queries)
  }
}

fn (c: Conn) ping() -> () ! sql.SqlErr uses net.dial {
  let s = match c.on()? {
    Some(t) => t
    None => return c.db.ping()
  }
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  let tc = s.conn.or_fault("a Conn's session holds a connection")
  s.st.with(fn(var ts) -> () ! sql.SqlErr {
    if let Some(e) = ended(s, ts) {
      return Err(e)
    }
    tc.c.ping()
  })
}

fn (c: Conn) listen(channel: Str) -> () ! sql.SqlErr uses net.dial {
  if c.on()? is None {
    return Err(sql.SqlErr.Driver(msg: NO_NOTIFY))
  }
  c.listened.set(true)
  let _ = c.exec("LISTEN ${quote_ident(channel)}")?
}

fn (c: Conn) unlisten(channel: Str) -> () ! sql.SqlErr uses net.dial {
  if c.on()? is None {
    return Err(sql.SqlErr.Driver(msg: NO_NOTIFY))
  }
  let _ = c.exec("UNLISTEN ${quote_ident(channel)}")?
}

fn (c: Conn) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial {
  let s = match c.on()? {
    Some(t) => t
    None => return Err(sql.SqlErr.Driver(msg: NO_NOTIFY))
  }
  let tc = s.conn.or_fault("a Conn's session holds a connection")
  // no cancellation check first: a notification already received is
  // returned to a cancelled task too, as pgx's
  s.st.with(fn(var ts) -> sql.Notification ! sql.SqlErr {
    if let Some(e) = ended(s, ts) {
      return Err(e)
    }
    tc.c.wait_notification()
  })
}

fn (c: Conn) close() uses net.dial {
  if c.closed.swap(true) {
    return
  }
  let s = match c.tx {
    Some(t) => t
    None => return
  }
  let tc = s.conn.or_fault("a Conn's session holds a connection")
  // a transaction begun on the Conn and still open ends here, so the
  // connection goes back to the pool idle (pgxpool destroys one that is not)
  let open = c.txs.with(fn(var xs) {
    let all = xs
    xs = []
    all
  })
  for st in open {
    let was = st.with(fn(var ts) -> Bool {
      let was = ts.done
      ts.done = true
      was
    })
    if !was {
      let _ = tc.c.rollback().ignore_err("give drops a broken connection")
    }
  }
  if finish_once(s) {
    return
  }
  if c.listened.get() {
    let _ = tc.c.exec("UNLISTEN *", []).ignore_err("give drops a broken connection")
  }
  close_tx_stmts(tc)
  give(c.db.pool.or_fault("a driver's Conn has a pool"), tc)
}

fn (r: Row) columns() -> List[Str] { r.cols }

fn (r: Row) values() -> List[sql.SqlValue] { r.vals }

fn (r: Row) column_types() -> List[sql.ColumnType] { column_types_of(r.cols, r.types) }

fn (r: Row) decode[T: SqlRow]() -> T ! sql.SqlErr { rtsql.sql_decode[T, Row](r) }

fn (r: Row) get(name: Str) -> sql.SqlValue ! sql.SqlErr {
  for (i, c) in r.cols.indexed() {
    if c == name {
      return r.vals[i]
    }
  }
  Err(sql.SqlErr.NoColumn(name: name))
}

/// The Debug text: `Row(a: 1, b: "x", c: null)`, each column and its
/// value as std/rt's XoDebug writes them.
fn row_debug(r: Row) -> Str {
  var b = StrBuilder.new()
  b.write("Row(")
  for (i, c) in r.cols.indexed() {
    if i > 0 {
      b.write(", ")
    }
    b.write("${c}: ${value_debug_text(r.vals[i])}")
  }
  b.write(")")
  b.freeze()
}

/// v's Debug text in a row: NULL is `null`, an array its items in brackets.
fn value_debug_text(v: sql.SqlValue) -> Str {
  match v {
    Null => "null"
    Integer(n) => n.debug()
    Text(s) => s.debug()
    Real(x) => x.debug()
    Flag(x) => x.debug()
    At(t) => t.debug()
    Blob(x) => x.debug()
    JsonText(s) => s.debug()
    Array(xs) => "[${xs.map(value_debug_text).join(", ")}]"
  }
}

fn type_name(v: sql.SqlValue) -> Str {
  match v {
    Integer(_) => "an integer"
    Text(_) => "text"
    Real(_) => "a float"
    Flag(_) => "a boolean"
    At(_) => "a time"
    Blob(_) => "bytes"
    JsonText(_) => "json"
    Array(_) => "an array"
    Null => "a value"
  }
}

fn mismatch(name: Str, want: Str, v: sql.SqlValue) -> sql.SqlErr {
  let got = if v is Null { "NULL" } else { type_name(v) }
  sql.SqlErr.Mismatch(column: name, msg: "expected ${want}, found ${got}")
}

fn (r: Row) value(name: Str) -> sql.SqlValue ! sql.SqlErr { r.get(name) }

fn (r: Row) is_null(name: Str) -> Bool ! sql.SqlErr { r.get(name)? is Null }

fn (r: Row) int(name: Str) -> Int ! sql.SqlErr {
  match r.get(name)? {
    Integer(n) => n
    v => Err(mismatch(name, "an integer", v))
  }
}

/// A date's text (2026-10-20, Postgres in ISO DateStyle) as its midnight in UTC.
/// A date or date and time in text, as mattn/go-sqlite3 reads a DATE,
/// DATETIME or TIMESTAMP column (its SQLiteTimestampFormats): `YYYY-MM-DD`,
/// then a space or `T`, `HH:MM`, optional `:SS` and fraction, and an
/// optional `+HH:MM`, `-HH:MM` or `Z`; no offset is UTC.
fn date_time(s: Str) -> Time? {
  var t = s.trim_suffix("Z")
  let b = t.bytes()
  if b.len() < 10 || b[4] != 45 || b[7] != 45 {
    return None
  }
  if b.len() == 10 {
    return Time.parse_rfc3339(t + "T00:00:00Z")
  }
  if b[10] != 32 && b[10] != 84 {
    return None
  }
  t = t[0..10] + "T" + t[11..t.len()]
  if t.len() == 16 {
    t = t + ":00"
  }
  if t.len() < 19 {
    return None
  }
  let rest = t[19..t.len()]
  if !rest.contains("+") && !rest.contains("-") {
    t = t + "Z"
  }
  Time.parse_rfc3339(t)
}

/// n as a time when name's declared type is DATE, DATETIME or TIMESTAMP:
/// Unix seconds, or milliseconds past 1e12 (mattn); None otherwise.
fn (r: Row) unix_time(name: Str, n: Int) -> Time? {
  for i in 0..r.cols.len() {
    if r.cols[i] == name && i < r.types.len() && (r.types[i].database_type is "DATE" | "DATETIME" | "TIMESTAMP") {
      return Some(if n > 1000000000000 || n < -1000000000000 { Time.from_unix_millis(n) } else { Time.from_unix(n) })
    }
  }
  None
}

fn (r: Row) str(name: Str) -> Str ! sql.SqlErr {
  match r.get(name)? {
    Text(s) => s
    JsonText(s) => s
    v => Err(mismatch(name, "text", v))
  }
}

fn (r: Row) float(name: Str) -> Float ! sql.SqlErr {
  match r.get(name)? {
    Real(f) => f
    Integer(n) => Float(n)
    Text(s) => match Float.parse(s) {
      Some(f) => f
      None => Err(mismatch(name, "a float", Text(s: s)))
    }
    v => Err(mismatch(name, "a float", v))
  }
}

fn (r: Row) bool(name: Str) -> Bool ! sql.SqlErr {
  match r.get(name)? {
    Flag(b) => b
    v => Err(mismatch(name, "a boolean", v))
  }
}

fn (r: Row) time(name: Str) -> Time ! sql.SqlErr {
  match r.get(name)? {
    At(t) => t
    Integer(n) => match r.unix_time(name, n) {
      Some(t) => t
      None => Err(mismatch(name, "a time", Integer(n: n)))
    }
    Text(s) => match date_time(s) {
      Some(t) => t
      None => Err(mismatch(name, "a time", Text(s: s)))
    }
    v => Err(mismatch(name, "a time", v))
  }
}

fn (r: Row) int_opt(name: Str) -> Int? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Integer(n) => Some(n)
    v => Err(mismatch(name, "an integer", v))
  }
}

fn (r: Row) str_opt(name: Str) -> Str? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Text(s) => Some(s)
    JsonText(s) => Some(s)
    v => Err(mismatch(name, "text", v))
  }
}

fn (r: Row) float_opt(name: Str) -> Float? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Real(f) => Some(f)
    Integer(n) => Some(Float(n))
    Text(s) => match Float.parse(s) {
      Some(f) => Some(f)
      None => Err(mismatch(name, "a float", Text(s: s)))
    }
    v => Err(mismatch(name, "a float", v))
  }
}

fn (r: Row) bool_opt(name: Str) -> Bool? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Flag(b) => Some(b)
    v => Err(mismatch(name, "a boolean", v))
  }
}

fn (r: Row) time_opt(name: Str) -> Time? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    At(t) => Some(t)
    Integer(n) => match r.unix_time(name, n) {
      Some(t) => Some(t)
      None => Err(mismatch(name, "a time", Integer(n: n)))
    }
    Text(s) => match date_time(s) {
      Some(t) => Some(t)
      None => Err(mismatch(name, "a time", Text(s: s)))
    }
    v => Err(mismatch(name, "a time", v))
  }
}

// The typed readers (decision 0679): a column's Postgres text parsed as
// pgx's pgtype parses it.

/// The text of a column a typed reader parses, None for NULL.
fn typed_text(r: Row, name: Str, want: Str) -> Str? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Text(s) => Some(s)
    v => Err(mismatch(name, want, v))
  }
}

fn bad_text(name: Str, want: Str, s: Str) -> sql.SqlErr { mismatch(name, want, sql.SqlValue.Text(s: s)) }

/// s when it is all ASCII digits (not empty), as an Int.
fn pg_digits(s: Str) -> Int? {
  if s.is_empty() {
    return None
  }
  for c in s.bytes() {
    if c < 48 || c > 57 {
      return None
    }
  }
  Int.parse(s)
}

/// strconv.ParseInt's syntax: an optional sign, then digits.
fn pg_int(s: Str) -> Int? {
  if s.starts_with("+") {
    return pg_digits(s[1..s.len()])
  }
  if s.starts_with("-") {
    return pg_digits(s[1..s.len()]).map(fn(n) { -n })
  }
  pg_digits(s)
}

/// A fraction's digits (at most 9) as nanoseconds.
fn pg_frac_nanos(f: Str) -> Int? {
  if f.len() > 9 {
    return None
  }
  var n = pg_digits(f)?
  var k = f.len()
  while k < 9 {
    n *= 10
    k += 1
  }
  Some(n)
}

/// A date column's text (pgx's Date.DecodeText): YYYY-MM-DD, ` BC` years
/// as 1 - n; infinity and -infinity are not dates.
fn pg_date(s: Str) -> time.Date? {
  var t = s
  var bc = false
  if t.ends_with(" BC") {
    bc = true
    t = t[0..t.len() - 3]
  }
  let ps = t.split("-")
  if ps.len() != 3 || ps[1].len() != 2 || ps[2].len() != 2 || ps[0].len() < 4 {
    return None
  }
  let y = pg_digits(ps[0])?
  let m = pg_digits(ps[1])?
  let d = pg_digits(ps[2])?
  if m < 1 || m > 12 || d < 1 || d > 31 {
    return None
  }
  Some(time.Date{year: if bc { 1 - y } else { y }, month: m, day: d})
}

/// A time column's text (pgx's Time.DecodeText): HH:MM:SS with an
/// optional fraction; 24:00:00 is the end of the day.
fn pg_time_of_day(s: Str) -> time.ClockTime? {
  if s.len() < 8 || s[2..3] != ":" || s[5..6] != ":" {
    return None
  }
  let h = pg_digits(s[0..2])?
  let m = pg_digits(s[3..5])?
  let sec = pg_digits(s[6..8])?
  var nanos = 0
  if s.len() > 8 {
    if s[8..9] != "." {
      return None
    }
    nanos = pg_frac_nanos(s[9..s.len()])?
  }
  if h > 24 || m > 59 || sec > 59 || (h == 24 && (m > 0 || sec > 0 || nanos > 0)) {
    return None
  }
  Some(time.ClockTime{hour: h, minute: m, second: sec, nanos: nanos})
}

/// An interval column's text in IntervalStyle postgres (pgx's
/// Interval.DecodeText): `N unit` pairs (year, mon, day, singular or
/// plural), then an optional `[-]H:MM:SS[.f]`.
fn pg_interval(s: Str) -> sql.Interval? {
  let ps = s.split(" ")
  var months = 0
  var days = 0
  var micros = 0
  var i = 0
  while i + 1 < ps.len() {
    let n = pg_int(ps[i])?
    match ps[i + 1] {
      "year" | "years" => months += n * 12
      "mon" | "mons" => months += n
      "day" | "days" => days += n
      _ => return None
    }
    i += 2
  }
  if ps.len() % 2 == 1 {
    let tp = ps[ps.len() - 1].split(":")
    if tp.len() != 3 {
      return None
    }
    var hs = tp[0]
    let neg = hs.starts_with("-")
    if neg || hs.starts_with("+") {
      hs = hs[1..hs.len()]
    }
    let h = pg_digits(hs)?
    let m = pg_digits(tp[1])?
    var secs = tp[2]
    var frac = 0
    if let Some(dot) = secs.find(".") {
      frac = pg_frac_nanos(secs[dot + 1..secs.len()])? / 1000
      secs = secs[0..dot]
    }
    let sec = pg_digits(secs)?
    let us = h * 3600000000 + m * 60000000 + sec * 1000000 + frac
    micros = if neg { -us } else { us }
  }
  Some(sql.Interval{months: months, days: days, micros: micros})
}

/// An inet or cidr column's text (pgx's InetCodec): a prefix, or an
/// address as its full length prefix.
fn pg_prefix(s: Str) -> netip.Prefix? {
  if s.contains("/") {
    return netip.parse_prefix(s).ok()
  }
  let a = netip.parse_addr(s).ok()?
  netip.prefix_from(a, a.bits)
}

fn (r: Row) uuid_opt(name: Str) -> uuid.Uuid? ! sql.SqlErr {
  match typed_text(r, name, "a uuid")? {
    None => None
    Some(s) => match uuid.parse(s) {
      Ok(u) => Some(u)
      Err(_) => Err(bad_text(name, "a uuid", s))
    }
  }
}

fn (r: Row) uuid(name: Str) -> uuid.Uuid ! sql.SqlErr {
  match r.uuid_opt(name)? {
    Some(u) => u
    None => Err(mismatch(name, "a uuid", sql.SqlValue.Null))
  }
}

fn (r: Row) date_opt(name: Str) -> time.Date? ! sql.SqlErr {
  match typed_text(r, name, "a date")? {
    None => None
    Some(s) => match pg_date(s) {
      Some(d) => Some(d)
      None => Err(bad_text(name, "a date", s))
    }
  }
}

fn (r: Row) date(name: Str) -> time.Date ! sql.SqlErr {
  match r.date_opt(name)? {
    Some(d) => d
    None => Err(mismatch(name, "a date", sql.SqlValue.Null))
  }
}

fn (r: Row) time_of_day_opt(name: Str) -> time.ClockTime? ! sql.SqlErr {
  match typed_text(r, name, "a time of day")? {
    None => None
    Some(s) => match pg_time_of_day(s) {
      Some(t) => Some(t)
      None => Err(bad_text(name, "a time of day", s))
    }
  }
}

fn (r: Row) time_of_day(name: Str) -> time.ClockTime ! sql.SqlErr {
  match r.time_of_day_opt(name)? {
    Some(t) => t
    None => Err(mismatch(name, "a time of day", sql.SqlValue.Null))
  }
}

fn (r: Row) interval_opt(name: Str) -> sql.Interval? ! sql.SqlErr {
  match typed_text(r, name, "an interval")? {
    None => None
    Some(s) => match pg_interval(s) {
      Some(i) => Some(i)
      None => Err(bad_text(name, "an interval", s))
    }
  }
}

fn (r: Row) interval(name: Str) -> sql.Interval ! sql.SqlErr {
  match r.interval_opt(name)? {
    Some(i) => i
    None => Err(mismatch(name, "an interval", sql.SqlValue.Null))
  }
}

fn (r: Row) prefix_opt(name: Str) -> netip.Prefix? ! sql.SqlErr {
  match typed_text(r, name, "an inet")? {
    None => None
    Some(s) => match pg_prefix(s) {
      Some(p) => Some(p)
      None => Err(bad_text(name, "an inet", s))
    }
  }
}

fn (r: Row) prefix(name: Str) -> netip.Prefix ! sql.SqlErr {
  match r.prefix_opt(name)? {
    Some(p) => p
    None => Err(mismatch(name, "an inet", sql.SqlValue.Null))
  }
}

/// A macaddr or macaddr8 column's text: 6 or 8 two digit hex groups
/// separated by colons.
fn pg_mac(s: Str) -> Bytes? {
  let ps = s.split(":")
  if ps.len() != 6 && ps.len() != 8 {
    return None
  }
  for p in ps {
    if p.len() != 2 {
      return None
    }
  }
  Bytes.from_hex(ps.join(""))
}

/// A quoted hstore key or value at byte i (`"..."`, `\` escaping the
/// next byte) and the index after its closing quote.
fn hs_quoted(s: Str, i: Int) -> (Str, Int)? {
  let b = s.bytes()
  if i >= b.len() || b[i] != 34 {
    return None
  }
  var out = ""
  var start = i + 1
  var j = i + 1
  while j < b.len() {
    if b[j] == 92 {
      if j + 1 >= b.len() {
        return None
      }
      out = out + s[start..j]
      start = j + 1
      j += 2
    } else if b[j] == 34 {
      return Some((out + s[start..j], j + 1))
    } else {
      j += 1
    }
  }
  None
}

fn hs_space(b: Bytes, i: Int) -> Int {
  var j = i
  while j < b.len() && b[j] == 32 {
    j += 1
  }
  j
}

/// An hstore column's text (pgx's Hstore): `"k"=>"v", "n"=>NULL`.
fn pg_hstore(s: Str) -> Map[Str, Str?]? {
  let b = s.bytes()
  var m: Map[Str, Str?] = {}
  var i = hs_space(b, 0)
  while i < b.len() {
    let (k, j) = hs_quoted(s, i)?
    i = hs_space(b, j)
    if i + 1 >= b.len() || b[i] != 61 || b[i + 1] != 62 {
      return None
    }
    i = hs_space(b, i + 2)
    if s[i..s.len()].starts_with("NULL") {
      m.put(k, None)
      i += 4
    } else {
      let (v, j2) = hs_quoted(s, i)?
      m.put(k, Some(v))
      i = j2
    }
    i = hs_space(b, i)
    if i < b.len() {
      if b[i] != 44 {
        return None
      }
      i = hs_space(b, i + 1)
      if i >= b.len() {
        return None
      }
    }
  }
  Some(m)
}

fn (r: Row) date_bound_opt(name: Str) -> sql.Bound[time.Date]? ! sql.SqlErr {
  match typed_text(r, name, "a date")? {
    None => None
    Some("infinity") => Some(sql.Bound.Infinity)
    Some("-infinity") => Some(sql.Bound.NegInfinity)
    Some(s) => match pg_date(s) {
      Some(d) => Some(sql.Bound.Finite(v: d))
      None => Err(bad_text(name, "a date", s))
    }
  }
}

fn (r: Row) date_bound(name: Str) -> sql.Bound[time.Date] ! sql.SqlErr {
  match r.date_bound_opt(name)? {
    Some(b) => b
    None => Err(mismatch(name, "a date", sql.SqlValue.Null))
  }
}

fn (r: Row) time_bound_opt(name: Str) -> sql.Bound[Time]? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    At(t) => Some(sql.Bound.Finite(v: t))
    Text("infinity") => Some(sql.Bound.Infinity)
    Text("-infinity") => Some(sql.Bound.NegInfinity)
    v => Err(mismatch(name, "a time", v))
  }
}

fn (r: Row) time_bound(name: Str) -> sql.Bound[Time] ! sql.SqlErr {
  match r.time_bound_opt(name)? {
    Some(b) => b
    None => Err(mismatch(name, "a time", sql.SqlValue.Null))
  }
}

fn (r: Row) mac_opt(name: Str) -> Bytes? ! sql.SqlErr {
  match typed_text(r, name, "a macaddr")? {
    None => None
    Some(s) => match pg_mac(s) {
      Some(b) => Some(b)
      None => Err(bad_text(name, "a macaddr", s))
    }
  }
}

fn (r: Row) mac(name: Str) -> Bytes ! sql.SqlErr {
  match r.mac_opt(name)? {
    Some(b) => b
    None => Err(mismatch(name, "a macaddr", sql.SqlValue.Null))
  }
}

fn (r: Row) hstore_opt(name: Str) -> Map[Str, Str?]? ! sql.SqlErr {
  match typed_text(r, name, "an hstore")? {
    None => None
    Some(s) => match pg_hstore(s) {
      Some(m) => Some(m)
      None => Err(bad_text(name, "an hstore", s))
    }
  }
}

fn (r: Row) hstore(name: Str) -> Map[Str, Str?] ! sql.SqlErr {
  match r.hstore_opt(name)? {
    Some(m) => m
    None => Err(mismatch(name, "an hstore", sql.SqlValue.Null))
  }
}

fn (r: Row) bytes(name: Str) -> Bytes ! sql.SqlErr {
  match r.get(name)? {
    Blob(b) => b
    v => Err(mismatch(name, "bytes", v))
  }
}

fn (r: Row) bytes_opt(name: Str) -> Bytes? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Blob(b) => Some(b)
    v => Err(mismatch(name, "bytes", v))
  }
}

fn (r: Row) json[T: Json](name: Str) -> T ! sql.SqlErr {
  let text = match r.get(name)? {
    JsonText(s) => s
    Text(s) => s
    v => return Err(mismatch(name, "json", v))
  }
  js.decode_str[T](text).map_err(fn(e) { sql.SqlErr.Mismatch(column: name, msg: "${e}") })
}

fn (r: Row) items(name: Str) -> List[sql.SqlValue] ! sql.SqlErr {
  match r.get(name)? {
    Array(xs) => xs
    v => Err(mismatch(name, "an array", v))
  }
}

fn (r: Row) ints(name: Str) -> List[Int] ! sql.SqlErr {
  r.items(name)?.map(fn(x) -> Int ! sql.SqlErr {
    match x {
      Integer(n) => n
      v => Err(mismatch(name, "an array of integers", v))
    }
  })
}

fn (r: Row) strs(name: Str) -> List[Str] ! sql.SqlErr {
  r.items(name)?.map(fn(x) -> Str ! sql.SqlErr {
    match x {
      Text(t) => t
      v => Err(mismatch(name, "an array of text", v))
    }
  })
}

// ---------------------------------------------------------------------------
// Tables

// Column kinds (std/rt's 'i', 't', 'r', 'b', 'T').
const KI = 1
const KT = 2
const KR = 3
const KB = 4
const KTIME = 5
const KBLOB = 6
const KJSON = 7
/// An array of elem (`INT[]`, `TEXT[]`, decision 0278).
const KARR = 8

struct Col {
  name: Str
  kind: Int
  not_null: Bool = false
  unique: Bool = false
  pk: Bool = false
  auto: Bool = false
  def: sql.SqlValue = sql.SqlValue.Null
  /// The elements' kind of a KARR column.
  elem: Int = 0
  /// The type as declared, upper case ("INTEGER", "VARCHAR", "TEXT[]"):
  /// ColumnType.database_type (decision 0609).
  decl: Str = ""
  /// Whether a CREATE INDEX is on the column (its name in the table's
  /// Made.names, so a copy of a Col retains no name).
  has_index: Bool = false
}

struct Table {
  name: Str
  cols: List[Col]
  /// The rows in insertion order; a deleted row's slot is an empty row
  /// until the table is compacted (decision 0528).
  rows: List[List[sql.SqlValue]]
  next_id: Int
  /// The deleted slots in rows.
  dead: Int = 0
  /// The index of each indexed column (by position): its stored values'
  /// slots.
  idx: Map[Int, ColIdx] = {}
  /// The CREATE INDEX columns' indexes and names, None until the first
  /// (one field, so a table without one copies as before).
  made: Made? = None
}

/// A table's CREATE INDEX state.
struct Made {
  /// The indexes, apart from idx so a UNIQUE column's update builds no
  /// slot list maps.
  midx: Map[Int, ManyIdx] = {}
  /// The names by column.
  names: Map[Int, Str] = {}
}

/// Moves t's CREATE INDEX state out (made_put puts it back), so changing
/// its maps copies none.
fn made_take(var t: Table) -> Made {
  let m = t.made ?? Made{}
  t.made = None
  m
}

fn made_put(var t: Table, m: Made) {
  t.made = if m.names.is_empty() { None } else { Some(m) }
}

/// An equality index of a column (decision 0528), Integer and Text values
/// apart (NULL is not indexed): a UNIQUE column's each stored value's
/// slot, a CREATE INDEX column's each value's slots in ascending order (a
/// scan's).
struct ColIdx {
  ints: Map[Int, Int] = {}
  strs: Map[Str, Int] = {}
}

/// A CREATE INDEX column's index: each value's slots in ascending order.
struct ManyIdx {
  ints: Map[Int, List[Int]] = {}
  strs: Map[Str, List[Int]] = {}
}

/// Whether a column has an index: UNIQUE (SERIAL columns are) or a CREATE
/// INDEX on it, and INT or TEXT, whose stored values are only Integer or
/// Text, or NULL (coerce).
fn indexed(c: Col) -> Bool { (c.unique || c.has_index) && (c.kind == KI || c.kind == KT) }

/// Whether column c's index holds several slots per value (not UNIQUE).
fn many(c: Col) -> Bool { !c.unique }

/// Inserts slot s into the ascending list l.
fn slot_add(var l: List[Int], s: Int) {
  var i = l.len()
  while i > 0 && l[i - 1] > s {
    i -= 1
  }
  if i == l.len() {
    l.push(s)
  } else {
    l.insert(i, s)
  }
}

/// Takes slot s out of the ascending list l.
fn slot_del(var l: List[Int], s: Int) {
  var i = l.len()
  while i > 0 {
    i -= 1
    if l[i] == s {
      let _ = l.remove_at(i)
      return
    }
    if l[i] < s {
      return
    }
  }
}

/// Adds the row in slot to the table's indexes.
fn idx_put(var t: Table, slot: Int) {
  let row = t.rows[slot]
  for (ci, c) in t.cols.indexed() {
    if !indexed(c) {
      continue
    }
    let v = row[ci]
    if many(c) {
      midx_put(t, ci, v, slot)
      continue
    }
    t.idx.update(ci, ColIdx{}, fn(var x) {
      match v {
        Integer(n) => x.ints.put(n, slot)
        Text(z) => x.strs.put(z, slot)
        _ => {}
      }
    })
  }
}

/// The CREATE INDEX part of idx_put, apart so idx_put's UNIQUE path is
/// the one it was before CREATE INDEX.
fn midx_put(var t: Table, ci: Int, v: sql.SqlValue, slot: Int) {
  var mx = made_take(t)
  mx.midx.update(ci, ManyIdx{}, fn(var x) {
    match v {
      Integer(n) => {
        var l = x.ints.remove(n) ?? []
        slot_add(l, slot)
        x.ints.put(n, l)
      }
      Text(z) => {
        var l = x.strs.remove(z) ?? []
        slot_add(l, slot)
        x.strs.put(z, l)
      }
      _ => {}
    }
  })
  made_put(t, mx)
}

/// Takes the row in slot out of the table's indexes. A slot list is
/// removed, changed and put back, so it moves out of the map instead of
/// being copied (gotchas/with-body-cancelable-through-closure-call.md).
fn idx_drop(var t: Table, slot: Int) {
  let row = t.rows[slot]
  for (ci, c) in t.cols.indexed() {
    if !indexed(c) {
      continue
    }
    let v = row[ci]
    if many(c) {
      midx_drop(t, ci, v, slot)
      continue
    }
    t.idx.update(ci, ColIdx{}, fn(var x) {
      match v {
        Integer(n) => {
          let _ = x.ints.remove(n)
        }
        Text(z) => {
          let _ = x.strs.remove(z)
        }
        _ => {}
      }
    })
  }
}

/// The CREATE INDEX part of idx_drop, apart so idx_drop's UNIQUE path is
/// the one it was before CREATE INDEX.
fn midx_drop(var t: Table, ci: Int, v: sql.SqlValue, slot: Int) {
  var mx = made_take(t)
  mx.midx.update(ci, ManyIdx{}, fn(var x) {
    match v {
      Integer(n) => {
        var l = x.ints.remove(n) ?? []
        slot_del(l, slot)
        if !l.is_empty() {
          x.ints.put(n, l)
        }
      }
      Text(z) => {
        var l = x.strs.remove(z) ?? []
        slot_del(l, slot)
        if !l.is_empty() {
          x.strs.put(z, l)
        }
      }
      _ => {}
    }
  })
  made_put(t, mx)
}

/// The slots whose column ci holds v by the column's CREATE INDEX, in
/// ascending order.
fn idx_find_many(t: Table, ci: Int, v: sql.SqlValue) -> List[Int] {
  let m = t.made ?? return []
  let x = m.midx.get(ci) ?? return []
  match v {
    Integer(n) => x.ints.get(n) ?? []
    Text(z) => x.strs.get(z) ?? []
    _ => []
  }
}

/// The slot whose column ci holds v by the column's index, -1 when none.
fn idx_find(t: Table, ci: Int, v: sql.SqlValue) -> Int {
  let x = t.idx.get(ci) ?? return -1
  match v {
    Integer(n) => x.ints.get(n) ?? -1
    Text(z) => x.strs.get(z) ?? -1
    _ => -1
  }
}

/// Drops the deleted slots and rebuilds the indexes.
fn compact(var t: Table) {
  // a loop, not filter with a closure (a point that can be canceled; see
  // coerce)
  var kept: List[List[sql.SqlValue]] = List.with_capacity(t.rows.len() - t.dead)
  for row in t.rows {
    if !row.is_empty() {
      kept.push(row)
    }
  }
  t.rows = kept
  t.dead = 0
  t.idx = {}
  var mx = made_take(t)
  mx.midx = {}
  made_put(t, mx)
  for slot in 0..t.rows.len() {
    idx_put(t, slot)
  }
}

/// Whether w is equalities between a column and a value, joined by AND,
/// that evaluate without error on every row: each column exists and each
/// value is NULL or of the column's own type (an INT column holds only
/// Integer or NULL, a TEXT column only Text or NULL). Appends each
/// equality's column and value to out.
fn eq_leaves(t: Table, n: Node, args: List[sql.SqlValue], var out: List[(Int, sql.SqlValue)]) -> Bool {
  match n {
    Bin(op, l, r) => {
      if op == "and" {
        return eq_leaves(t, l, args, out) && eq_leaves(t, r, args, out)
      }
      if op != "=" {
        return false
      }
      let (c, x) = match (l, r) {
        (Col(c), x) => (c, x)
        (x, Col(c)) => (c, x)
        _ => return false
      }
      let v = match x {
        Lit(lv) => lv
        Param(i) => {
          if i < 1 || i > args.len() {
            return false
          }
          args[i - 1]
        }
        Col(_) | Count | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => return false
      }
      let ci = t.index(c)
      if ci < 0 {
        return false
      }
      let kind = t.cols[ci].kind
      let ok = match v {
        Null => true
        Integer(_) => kind == KI
        Text(_) => kind == KT
        _ => false
      }
      if ok {
        out.push((ci, v))
      }
      ok
    }
    _ => false
  }
}

/// The slots a WHERE can only be true on, by an indexed column's equality
/// (decision 0528), or None to scan every slot. The caller still evaluates
/// the whole WHERE on each, so the rows are the scan's; eq_leaves makes
/// sure the scan could not have failed on a row this skips.
fn candidates(t: Table, w: Node?, args: List[sql.SqlValue]) -> List[Int]? {
  let n = w ?? return None
  var leaves: List[(Int, sql.SqlValue)] = []
  if !eq_leaves(t, n, args, leaves) {
    return None
  }
  // a UNIQUE column's one slot first, then a CREATE INDEX column's
  for (ci, v) in leaves {
    if indexed(t.cols[ci]) && !many(t.cols[ci]) {
      if v is Null {
        // `= NULL` is never true
        return Some([])
      }
      let s = idx_find(t, ci, v)
      return Some(if s >= 0 { [s] } else { [] })
    }
  }
  for (ci, v) in leaves {
    if indexed(t.cols[ci]) {
      if v is Null {
        return Some([])
      }
      let ss = idx_find_many(t, ci, v)
      // a value most rows hold: scanning in place costs less than
      // visiting through the slot list (stability/notes with one owner,
      // 2026-11-06: the index's sat64 was 0.82 of the scan's)
      if ss.len() * 4 > t.rows.len() - t.dead {
        return None
      }
      return Some(ss)
    }
  }
  None
}

/// The slot of the k-th row to visit: a candidate's, or k when scanning.
fn slot_at(cand: List[Int]?, k: Int) -> Int {
  match cand {
    Some(ss) => ss[k]
    None => k
  }
}

fn slots_len(t: Table, cand: List[Int]?) -> Int {
  match cand {
    Some(ss) => ss.len()
    None => t.rows.len()
  }
}

fn (t: Table) index(name: Str) -> Int {
  for (i, c) in t.cols.indexed() {
    if c.name == name {
      return i
    }
  }
  -1
}

/// The rows of a query.
struct MemRows {
  cols: List[Str]
  rows: List[List[sql.SqlValue]]
  /// each column's type: a table column's declared type and NOT NULL
  /// (decision 0609)
  types: List[sql.ColumnType] = []
}

// ---------------------------------------------------------------------------
// Lexer

const T_EOF = 0
const T_IDENT = 1
const T_INT = 2
const T_FLOAT = 3
const T_STR = 4
const T_PARAM = 5
const T_SYM = 6

struct Tok {
  k: Int
  s: Str = ""
  i: Int = 0
  f: Float = 0.0
}

fn syntax(msg: Str) -> sql.SqlErr { sql.SqlErr.Syntax(msg: msg) }

/// The rune at byte i of b and its size.
fn rune_at(b: Bytes, i: Int) -> (Rune, Int) {
  let p = raw.bytes_decode(b, i)
  (Rune(p >> 3), p & 7)
}

fn is_ident_rune(c: Rune) -> Bool { c.is_letter() || c.is_digit() || c == '_' }

fn lex(q: Str) -> List[Tok] ! sql.SqlErr {
  let b = q.bytes()
  let n = b.len()
  var out: List[Tok] = []
  var i = 0
  while i < n {
    let (c, size) = rune_at(b, i)
    if c.is_space() {
      i += size
    } else if c == '-' && i + 1 < n && b[i + 1] == 45 {
      while i < n && b[i] != 10 {
        i += 1
      }
    } else if c.is_letter() || c == '_' {
      var j = i
      while j < n {
        // ASCII without decoding: a statement's names and keywords are
        // (the decode and is_ident_rune call cost 2% of an INSERT when
        // the inliner left it out of lex, 2026-11-06)
        let x = b[j]
        if x < 128 {
          if !((x >= 97 && x <= 122) || (x >= 65 && x <= 90) || (x >= 48 && x <= 57) || x == 95) {
            break
          }
          j += 1
          continue
        }
        let (d, ds) = rune_at(b, j)
        if !is_ident_rune(d) {
          break
        }
        j += ds
      }
      out.push(Tok{k: T_IDENT, s: q[i..j].to_lower()})
      i = j
    } else if c.is_digit() {
      var j = i
      var is_f = false
      while j < n {
        let (d, ds) = rune_at(b, j)
        if !(d.is_digit() || (d == '.' && !is_f)) {
          break
        }
        if d == '.' {
          is_f = true
        }
        j += ds
      }
      let s = q[i..j]
      if is_f {
        match Float.parse(s) {
          Some(f) => out.push(Tok{k: T_FLOAT, f: f})
          None => return Err(syntax("bad number ${s.quote()}"))
        }
      } else {
        match Int.parse(s) {
          Some(v) => out.push(Tok{k: T_INT, i: v})
          None => return Err(syntax("bad number ${s.quote()}"))
        }
      }
      i = j
    } else if c == '\'' {
      var sb = ""
      var j = i + 1
      var closed = false
      var start = j
      while j < n {
        if b[j] == 39 {
          if j + 1 < n && b[j + 1] == 39 {
            sb = sb + q[start..j + 1]
            j += 2
            start = j
            continue
          }
          sb = sb + q[start..j]
          closed = true
          j += 1
          break
        }
        j += rune_at(b, j).1
      }
      if !closed {
        return Err(syntax("unterminated string"))
      }
      out.push(Tok{k: T_STR, s: sb})
      i = j
    } else if c == '$' {
      var j = i + 1
      while j < n {
        let (d, ds) = rune_at(b, j)
        if !d.is_digit() {
          break
        }
        j += ds
      }
      match Int.parse(q[i + 1..j]) {
        Some(v) => {
          if v < 1 {
            return Err(syntax("bad placeholder"))
          }
          out.push(Tok{k: T_PARAM, i: v})
        }
        None => return Err(syntax("bad placeholder"))
      }
      i = j
    } else {
      if i + 1 < n {
        let two = raw.str_slice(q, i, i + 2)
        if two == "<=" || two == ">=" || two == "<>" || two == "!=" {
          out.push(Tok{k: T_SYM, s: two})
          i += 2
          continue
        }
      }
      let one = q[i..i + size]
      if "(),*=<>;.+-/[]".contains(one) {
        out.push(Tok{k: T_SYM, s: one})
        i += size
        continue
      }
      return Err(syntax("unexpected character ${one.quote()}"))
    }
  }
  out.push(Tok{k: T_EOF})
  out
}

fn split_statements(toks: List[Tok]) -> List[List[Tok]] {
  var out: List[List[Tok]] = []
  var cur: List[Tok] = []
  for t in toks {
    if t.k == T_EOF {
      break
    }
    if t.k == T_SYM && t.s == ";" {
      if !cur.is_empty() {
        cur.push(Tok{k: T_EOF})
        out.push(cur)
      }
      cur = []
      continue
    }
    cur.push(t)
  }
  if !cur.is_empty() {
    cur.push(Tok{k: T_EOF})
    out.push(cur)
  }
  out
}

// ---------------------------------------------------------------------------
// Parser

enum Node {
  Lit(v: sql.SqlValue)
  Param(n: Int)
  Col(name: Str)
  Count
  Bin(op: Str, l: Node, r: Node)
  Not(x: Node)
  IsNull(x: Node, neg: Bool)
  InList(x: Node, items: List[Node])
  Like(l: Node, r: Node)
}

struct Parser {
  toks: List[Tok]
  i: Int = 0
  max_param: Int = 0
}

fn (p: Parser) peek() -> Tok { p.toks[p.i] }

fn (var p: Parser) next() -> Tok {
  let t = p.toks[p.i]
  if t.k != T_EOF {
    p.i += 1
  }
  t
}

fn (p: Parser) is_kw(kw: Str) -> Bool {
  let t = p.peek()
  t.k == T_IDENT && t.s == kw
}

fn (p: Parser) is_sym(s: Str) -> Bool {
  let t = p.peek()
  t.k == T_SYM && t.s == s
}

fn (var p: Parser) accept_kw(kw: Str) -> Bool {
  if p.is_kw(kw) {
    p.i += 1
    return true
  }
  false
}

fn (var p: Parser) accept_sym(s: Str) -> Bool {
  if p.is_sym(s) {
    p.i += 1
    return true
  }
  false
}

fn (p: Parser) fail(what: Str) -> sql.SqlErr {
  let t = p.peek()
  var got = "end of input"
  if t.k == T_IDENT || t.k == T_SYM {
    got = t.s.quote()
  } else if t.k == T_INT || t.k == T_FLOAT || t.k == T_STR || t.k == T_PARAM {
    got = "a literal"
  }
  syntax("expected ${what}, found ${got}")
}

fn (var p: Parser) expect_kw(kw: Str) -> () ! sql.SqlErr {
  if !p.accept_kw(kw) {
    return Err(p.fail(kw.to_upper()))
  }
}

fn (var p: Parser) expect_sym(s: Str) -> () ! sql.SqlErr {
  if !p.accept_sym(s) {
    return Err(p.fail(s.quote()))
  }
}

fn (var p: Parser) ident(what: Str) -> Str ! sql.SqlErr {
  let t = p.peek()
  if t.k != T_IDENT {
    return Err(p.fail(what))
  }
  p.i += 1
  t.s
}

fn (var p: Parser) expr() -> Node ! sql.SqlErr { p.or_expr() }

fn (var p: Parser) or_expr() -> Node ! sql.SqlErr {
  var l = p.and_expr()?
  while p.accept_kw("or") {
    let r = p.and_expr()?
    l = Node.Bin(op: "or", l: l, r: r)
  }
  l
}

fn (var p: Parser) and_expr() -> Node ! sql.SqlErr {
  var l = p.not_expr()?
  while p.accept_kw("and") {
    let r = p.not_expr()?
    l = Node.Bin(op: "and", l: l, r: r)
  }
  l
}

fn (var p: Parser) not_expr() -> Node ! sql.SqlErr {
  if p.accept_kw("not") {
    let x = p.not_expr()?
    return Node.Not(x: x)
  }
  p.cmp_expr()
}

fn (var p: Parser) cmp_expr() -> Node ! sql.SqlErr {
  let l = p.add_expr()?
  let t = p.peek()
  if t.k == T_SYM && (t.s == "=" || t.s == "!=" || t.s == "<>" || t.s == "<" || t.s == "<=" || t.s == ">" || t.s == ">=") {
    p.i += 1
    let r = p.add_expr()?
    let op = if t.s == "<>" { "!=" } else { t.s }
    return Node.Bin(op: op, l: l, r: r)
  }
  if p.accept_kw("is") {
    let neg = p.accept_kw("not")
    p.expect_kw("null")?
    return Node.IsNull(x: l, neg: neg)
  }
  var neg = false
  if p.is_kw("not") && p.i + 1 < p.toks.len() && p.toks[p.i + 1].k == T_IDENT && (p.toks[p.i + 1].s == "in" || p.toks[p.i + 1].s == "like") {
    p.i += 1
    neg = true
  }
  var n = l
  if p.accept_kw("in") {
    p.expect_sym("(")?
    var items: List[Node] = []
    while {
      let x = p.add_expr()?
      items.push(x)
      if !p.accept_sym(",") {
        break
      }
    }
    p.expect_sym(")")?
    n = Node.InList(x: l, items: items)
  } else if p.accept_kw("like") {
    let r = p.add_expr()?
    n = Node.Like(l: l, r: r)
  } else {
    return l
  }
  if neg {
    return Node.Not(x: n)
  }
  n
}

fn (var p: Parser) add_expr() -> Node ! sql.SqlErr {
  var l = p.mul_expr()?
  while p.is_sym("+") || p.is_sym("-") {
    let op = p.next().s
    let r = p.mul_expr()?
    l = Node.Bin(op: op, l: l, r: r)
  }
  l
}

fn (var p: Parser) mul_expr() -> Node ! sql.SqlErr {
  var l = p.primary()?
  while p.is_sym("*") || p.is_sym("/") {
    let op = p.next().s
    let r = p.primary()?
    l = Node.Bin(op: op, l: l, r: r)
  }
  l
}

fn (var p: Parser) primary() -> Node ! sql.SqlErr {
  let t = p.next()
  if t.k == T_INT {
    return Node.Lit(v: sql.SqlValue.Integer(n: t.i))
  }
  if t.k == T_FLOAT {
    return Node.Lit(v: sql.SqlValue.Real(f: t.f))
  }
  if t.k == T_STR {
    return Node.Lit(v: sql.SqlValue.Text(s: t.s))
  }
  if t.k == T_PARAM {
    if t.i > p.max_param {
      p.max_param = t.i
    }
    return Node.Param(n: t.i)
  }
  if t.k == T_SYM {
    if t.s == "(" {
      let x = p.expr()?
      p.expect_sym(")")?
      return x
    }
    if t.s == "-" {
      let x = p.primary()?
      return Node.Bin(op: "-", l: Node.Lit(v: sql.SqlValue.Integer(n: 0)), r: x)
    }
  }
  if t.k == T_IDENT {
    if t.s == "null" {
      return Node.Lit(v: sql.SqlValue.Null)
    }
    if t.s == "true" {
      return Node.Lit(v: sql.SqlValue.Flag(b: true))
    }
    if t.s == "false" {
      return Node.Lit(v: sql.SqlValue.Flag(b: false))
    }
    if p.is_sym("(") && t.s == "count" {
      p.i += 1
      p.expect_sym("*")?
      p.expect_sym(")")?
      return Node.Count
    }
    if p.accept_sym(".") {
      // table.column: the table is ignored
      let c = p.ident("a column name")?
      return Node.Col(name: c)
    }
    return Node.Col(name: t.s)
  }
  // back one token, also at the end of input (where next did not
  // advance): the error names the token before, as std/rt's parser does
  p.i -= 1
  Err(p.fail("an expression"))
}

// ---------------------------------------------------------------------------
// Evaluation

struct EvalEnv {
  t: Table?
  row: List[sql.SqlValue]
  args: List[sql.SqlValue]
}

/// Go's %T of a value of the Go driver (for error texts).
fn go_type(v: sql.SqlValue) -> Str {
  match v {
    Integer(_) => "int64"
    Text(_) => "string"
    Real(_) => "float64"
    Flag(_) => "bool"
    At(_) => "rt.Time"
    Blob(_) => "rt.Bytes"
    JsonText(_) => "rt.SqlJSON"
    Array(_) => "rt.Sql_SqlValue"
    Null => "<nil>"
  }
}

fn cmp_int(a: Int, b: Int) -> Int {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn cmp_float(x: Float, y: Float) -> Int {
  if x < y {
    -1
  } else if x > y {
    1
  } else {
    0
  }
}

/// The order of two values that are not NULL.
fn sql_cmp(a: sql.SqlValue, b: sql.SqlValue) -> Int ! sql.SqlErr {
  match (a, b) {
    (Integer(x), Integer(y)) => return cmp_int(x, y)
    (Integer(x), Real(y)) => return cmp_float(Float(x), y)
    (Real(x), Integer(y)) => return cmp_float(x, Float(y))
    (Real(x), Real(y)) => return cmp_float(x, y)
    (Text(x), Text(y)) => return cmp_str(x, y)
    (Flag(x), Flag(y)) => {
      if x == y {
        return 0
      }
      return if !x { -1 } else { 1 }
    }
    (At(x), At(y)) => return if x < y { -1 } else if x > y { 1 } else { 0 }
    // bytes in order compare as their hex text does
    (Blob(x), Blob(y)) => return cmp_str(x.to_hex(), y.to_hex())
    (JsonText(x), JsonText(y)) => return cmp_str(x, y)
    _ => {}
  }
  Err(sql.SqlErr.Driver(msg: "cannot compare ${go_type(a)} with ${go_type(b)}"))
}

/// strings.Compare.
fn cmp_str(x: Str, y: Str) -> Int {
  if x < y {
    -1
  } else if x > y {
    1
  } else {
    0
  }
}

fn like_at(s: List[Rune], p: List[Rune], i0: Int, j0: Int) -> Bool {
  var i = i0
  var j = j0
  while j < p.len() {
    let c = p[j]
    if c == '%' {
      var k = i
      while k <= s.len() {
        if like_at(s, p, k, j + 1) {
          return true
        }
        k += 1
      }
      return false
    }
    if c == '_' {
      if i >= s.len() {
        return false
      }
    } else if i >= s.len() || s[i].to_lower() != c.to_lower() {
      return false
    }
    i += 1
    j += 1
  }
  i == s.len()
}

fn sql_like(s: Str, pat: Str) -> Bool { like_at(s.runes(), pat.runes(), 0, 0) }

fn (e: EvalEnv) eval(n: Node) -> sql.SqlValue ! sql.SqlErr {
  match n {
    Lit(v) => return v
    Param(i) => return e.args[i - 1]
    Col(name) => {
      if let Some(t) = e.t {
        let i = t.index(name)
        if i >= 0 {
          return e.row[i]
        }
      }
      return Err(syntax("no such column ${name}"))
    }
    Count => return Err(syntax("COUNT(*) is only allowed in the select list"))
    Not(x) => {
      return match e.eval(x)? {
        Flag(b) => sql.SqlValue.Flag(b: !b)
        _ => sql.SqlValue.Null
      }
    }
    IsNull(x, neg) => {
      let v = e.eval(x)?
      return sql.SqlValue.Flag(b: (v is Null) != neg)
    }
    InList(x, items) => {
      let v = e.eval(x)?
      if v is Null {
        return sql.SqlValue.Null
      }
      for it in items {
        let w = e.eval(it)?
        if w is Null {
          continue
        }
        if sql_cmp(v, w)? == 0 {
          return sql.SqlValue.Flag(b: true)
        }
      }
      return sql.SqlValue.Flag(b: false)
    }
    Like(l, r) => {
      let v = e.eval(l)?
      let pv = e.eval(r)?
      if v is Null || pv is Null {
        return sql.SqlValue.Null
      }
      return match (v, pv) {
        (Text(s), Text(pat)) => sql.SqlValue.Flag(b: sql_like(s, pat))
        _ => Err(sql.SqlErr.Driver(msg: "LIKE needs text"))
      }
    }
    Bin(op, l, r) => return e.binary(op, l, r)
  }
}

fn (e: EvalEnv) binary(op: Str, ln: Node, rn: Node) -> sql.SqlValue ! sql.SqlErr {
  let l = e.eval(ln)?
  let r = e.eval(rn)?
  if op == "and" || op == "or" {
    let lb = match l {
      Flag(b) => Some(b)
      _ => None
    }
    let rb = match r {
      Flag(b) => Some(b)
      _ => None
    }
    if op == "and" {
      if lb == Some(false) || rb == Some(false) {
        return sql.SqlValue.Flag(b: false)
      }
      if lb.is_some() && rb.is_some() {
        return sql.SqlValue.Flag(b: true)
      }
      return sql.SqlValue.Null
    }
    if lb == Some(true) || rb == Some(true) {
      return sql.SqlValue.Flag(b: true)
    }
    if lb.is_some() && rb.is_some() {
      return sql.SqlValue.Flag(b: false)
    }
    return sql.SqlValue.Null
  }
  if l is Null || r is Null {
    return sql.SqlValue.Null
  }
  if op == "=" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
    let c = sql_cmp(l, r)?
    let b = match op {
      "=" => c == 0
      "!=" => c != 0
      "<" => c < 0
      "<=" => c <= 0
      ">" => c > 0
      _ => c >= 0
    }
    return sql.SqlValue.Flag(b: b)
  }
  // arithmetic: Int with Int wraps like Go's int64, else Float
  match (l, r) {
    (Integer(a), Integer(b)) => {
      return match op {
        "+" => sql.SqlValue.Integer(n: a.wrapping_add(b))
        "-" => sql.SqlValue.Integer(n: a.wrapping_sub(b))
        "*" => sql.SqlValue.Integer(n: a.wrapping_mul(b))
        _ => {
          if b == 0 {
            return Err(sql.SqlErr.Driver(msg: "division by zero"))
          }
          sql.SqlValue.Integer(n: a.checked_div(b) ?? a)
        }
      }
    }
    _ => {}
  }
  let x = match l {
    Integer(a) => Float(a)
    Real(f) => f
    _ => return Err(sql.SqlErr.Driver(msg: "arithmetic needs numbers"))
  }
  let y = match r {
    Integer(a) => Float(a)
    Real(f) => f
    _ => return Err(sql.SqlErr.Driver(msg: "arithmetic needs numbers"))
  }
  match op {
    "+" => sql.SqlValue.Real(f: x + y)
    "-" => sql.SqlValue.Real(f: x - y)
    "*" => sql.SqlValue.Real(f: x * y)
    _ => {
      if y == 0.0 {
        return Err(sql.SqlErr.Driver(msg: "division by zero"))
      }
      sql.SqlValue.Real(f: x / y)
    }
  }
}

fn (e: EvalEnv) where_ok(w: Node?) -> Bool ! sql.SqlErr {
  match w {
    None => true
    Some(n) => e.eval(n)? == sql.SqlValue.Flag(b: true)
  }
}

// ---------------------------------------------------------------------------
// Statements

fn check_params(p: Parser, args: List[sql.SqlValue]) -> () ! sql.SqlErr {
  if p.max_param != args.len() {
    return Err(sql.SqlErr.Param(msg: "statement has ${p.max_param} placeholders but ${args.len()} arguments were given"))
  }
}

/// The outcome of an INSERT, UPDATE, or DELETE.
struct Write {
  n: Int = 0
  id: Int = 0
  returning: Bool = false
  cols: List[Str] = []
  rows: List[List[sql.SqlValue]] = []
  types: List[sql.ColumnType] = []
}

const QUERY_NEEDS = "query needs a SELECT statement or a write with RETURNING (use exec for other statements)"

/// Runs a statement that returns rows: a SELECT, or a write with
/// RETURNING, on tables (a private copy).
fn mem_run(var tables: Map[Str, Table], q: Str, args: List[sql.SqlValue]) -> MemRows ! sql.SqlErr {
  let stmts = split_statements(lex(q)?)
  if stmts.len() != 1 {
    return Err(syntax("expected one statement"))
  }
  var p = Parser{toks: stmts[0]}
  var w = Write{}
  if p.is_kw("select") {
    return mem_select(tables, p, args)
  } else if p.is_kw("insert") {
    w = mem_insert(tables, p, args, true)?
  } else if p.is_kw("update") {
    w = mem_update(tables, p, args, true)?
  } else if p.is_kw("delete") {
    w = mem_delete(tables, p, args, true)?
  } else {
    return Err(syntax(QUERY_NEEDS))
  }
  if p.peek().k != T_EOF {
    return Err(p.fail("end of statement"))
  }
  if !w.returning {
    return Err(syntax(QUERY_NEEDS))
  }
  MemRows{cols: w.cols, rows: w.rows, types: w.types}
}

/// Runs write statements on tables, leaving them as they were on an error:
/// several statements run on a copy, one in place (decision 0528: each
/// write checks everything before it changes anything).
fn mem_exec(var tables: Map[Str, Table], q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr {
  let stmts = split_statements(lex(q)?)
  if stmts.is_empty() {
    return Err(syntax("empty statement"))
  }
  if stmts.len() > 1 && !args.is_empty() {
    return Err(sql.SqlErr.Param(msg: "several statements cannot take arguments"))
  }
  if stmts.len() == 1 {
    let w = exec_one(tables, stmts[0], args)?
    return sql.ExecResult{rows_affected: w.n, last_insert_id: w.id}
  }
  var work = tables
  var total = 0
  var last_id = 0
  for st in stmts {
    let w = exec_one(work, st, args)?
    total += w.n
    if w.id != 0 {
      last_id = w.id
    }
  }
  tables = work
  sql.ExecResult{rows_affected: total, last_insert_id: last_id}
}

/// query_all on the in memory database (decision 0648 item 7): each
/// statement of q in order on a copy of tables, published when all
/// succeed; a set for each SELECT and each write with RETURNING, none for
/// the other statements. std/rt/sqlmem.go memRunAll is the same.
fn mem_run_all(var tables: Map[Str, Table], q: Str, args: List[sql.SqlValue]) -> List[MemRows] ! sql.SqlErr {
  let stmts = split_statements(lex(q)?)
  if stmts.is_empty() {
    return Err(syntax("empty statement"))
  }
  if stmts.len() > 1 && !args.is_empty() {
    return Err(sql.SqlErr.Param(msg: "several statements cannot take arguments"))
  }
  var work = tables
  var out: List[MemRows] = []
  for st in stmts {
    var p = Parser{toks: st}
    if p.is_kw("select") {
      out.push(mem_select(work, p, args)?)
      continue
    }
    let w = exec_one(work, st, args)?
    if w.returning {
      out.push(MemRows{cols: w.cols, rows: w.rows, types: w.types})
    }
  }
  tables = work
  out
}

/// One write statement of mem_exec; it changes tables only when it
/// succeeds.
fn exec_one(var tables: Map[Str, Table], st: List[Tok], args: List[sql.SqlValue]) -> Write ! sql.SqlErr {
  var p = Parser{toks: st}
  if p.is_kw("create") || p.is_kw("drop") {
    // each checks that the statement ends before its one write, so tables
    // is not copied: a copy written to makes the Map a log one, whose
    // later writes copy a table's rows (decision 0528)
    if p.is_kw("create") {
      mem_create(tables, p)?
    } else {
      mem_drop(tables, p)?
    }
    stmt_end(p)?
    return Write{}
  }
  if p.is_kw("insert") {
    return mem_insert(tables, p, args, false)
  }
  if p.is_kw("update") {
    return mem_update(tables, p, args, false)
  }
  if p.is_kw("delete") {
    return mem_delete(tables, p, args, false)
  }
  if p.is_kw("select") {
    return Err(syntax("exec cannot run a SELECT (use query)"))
  }
  Err(p.fail("a statement"))
}

/// The default of a write's Map.update, never used: its plan read the table.
fn no_table(name: Str) -> Table { Table{name: name, cols: [], rows: [], next_id: 1} }

fn table_for(tables: Map[Str, Table], name: Str) -> Table ! sql.SqlErr {
  tables.get(name).or_err(sql.SqlErr.NoTable(name: name))
}

fn mem_create(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  p.i += 1
  if p.is_kw("index") || p.is_kw("unique") {
    return mem_create_index(tables, p)
  }
  p.expect_kw("table")?
  var if_not = false
  if p.accept_kw("if") {
    p.expect_kw("not")?
    p.expect_kw("exists")?
    if_not = true
  }
  let name = p.ident("a table name")?
  if tables.contains(name) {
    if !if_not {
      return Err(syntax("table ${name} already exists"))
    }
    // consume the definition
    var depth = 0
    while p.peek().k != T_EOF {
      if p.is_sym("(") {
        depth += 1
      } else if p.is_sym(")") {
        depth -= 1
      }
      p.i += 1
      if depth == 0 {
        break
      }
    }
    return Ok(())
  }
  p.expect_sym("(")?
  var t = Table{name: name, cols: [], rows: [], next_id: 1}
  var pk_cols: List[Str] = []
  while {
    if p.accept_kw("primary") {
      p.expect_kw("key")?
      p.expect_sym("(")?
      while {
        let c = p.ident("a column name")?
        pk_cols.push(c)
        if !p.accept_sym(",") {
          break
        }
      }
      p.expect_sym(")")?
    } else {
      let c = col_def(p)?
      if t.index(c.name) >= 0 {
        return Err(syntax("duplicate column ${c.name}"))
      }
      t.cols.push(c)
    }
    if !p.accept_sym(",") {
      break
    }
  }
  p.expect_sym(")")?
  for c in pk_cols {
    let i = t.index(c)
    if i < 0 {
      return Err(syntax("no such column ${c}"))
    }
    var col = t.cols[i]
    col.pk = true
    col.not_null = true
    if pk_cols.len() == 1 {
      col.unique = true
      col.auto = col.kind == KI
    }
    t.cols.set(i, col)
  }
  if t.cols.is_empty() {
    return Err(syntax("a table needs a column"))
  }
  stmt_end(p)?
  tables.put(name, t)
}

/// The table and column of the index named name, None when no table has
/// it.
fn index_at(tables: Map[Str, Table], name: Str) -> (Str, Int)? {
  for (tn, t) in tables {
    let m = t.made ?? continue
    for (ci, n) in m.names {
      if n == name {
        return Some((tn, ci))
      }
    }
  }
  None
}

/// `CREATE INDEX [IF NOT EXISTS] [name] ON table (column)`: an equality
/// index of one column that WHERE `column = value` uses, on an INT or TEXT
/// column (on another kind it is kept by name and not used); unnamed, it
/// is table_column_idx, as in PostgreSQL. A UNIQUE column has one already.
fn mem_create_index(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  if p.is_kw("unique") {
    return Err(syntax("CREATE UNIQUE INDEX is not supported (declare the column UNIQUE)"))
  }
  p.i += 1
  var if_not = false
  if p.accept_kw("if") {
    p.expect_kw("not")?
    p.expect_kw("exists")?
    if_not = true
  }
  var name = ""
  if !p.is_kw("on") {
    name = p.ident("an index name")?
  }
  p.expect_kw("on")?
  let tn = p.ident("a table name")?
  p.expect_sym("(")?
  let cn = p.ident("a column name")?
  if p.is_sym(",") {
    return Err(syntax("an index on several columns is not supported"))
  }
  p.expect_sym(")")?
  stmt_end(p)?
  if name == "" {
    name = "${tn}_${cn}_idx"
  }
  if index_at(tables, name) is Some(_) {
    if if_not {
      return Ok(())
    }
    return Err(syntax("index ${name} already exists"))
  }
  var t = table_for(tables, tn)?
  let ci = t.index(cn)
  if ci < 0 {
    return Err(syntax("no such column ${cn}"))
  }
  var col = t.cols[ci]
  var mx = made_take(t)
  if let Some(old) = mx.names.get(ci) {
    return Err(syntax("column ${cn} already has index ${old}"))
  }
  col.has_index = true
  t.cols.set(ci, col)
  mx.names.put(ci, name)
  made_put(t, mx)
  if !col.unique {
    for slot in 0..t.rows.len() {
      if !t.rows[slot].is_empty() {
        idx_put(t, slot)
      }
    }
  }
  tables.put(tn, t)
}

/// `DROP INDEX [IF EXISTS] name`.
fn mem_drop_index(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  p.i += 1
  var if_ex = false
  if p.accept_kw("if") {
    p.expect_kw("exists")?
    if_ex = true
  }
  let name = p.ident("an index name")?
  stmt_end(p)?
  let (tn, ci) = index_at(tables, name) ?? {
    if if_ex {
      return Ok(())
    }
    return Err(syntax("no such index ${name}"))
  }
  var t = table_for(tables, tn)?
  var col = t.cols[ci]
  col.has_index = false
  t.cols.set(ci, col)
  var mx = made_take(t)
  let _ = mx.names.remove(ci)
  let _ = mx.midx.remove(ci)
  made_put(t, mx)
  tables.put(tn, t)
}

fn col_def(var p: Parser) -> Col ! sql.SqlErr {
  let name = p.ident("a column name")?
  let ty = p.ident("a column type")?
  var c = Col{name: name, kind: 0, decl: ty.to_upper()}
  match ty {
    "int" | "integer" | "bigint" | "smallint" | "int64" => c.kind = KI
    "serial" | "bigserial" => {
      c.kind = KI
      c.auto = true
      c.pk = true
      c.unique = true
      c.not_null = true
    }
    "text" | "varchar" | "char" | "string" | "uuid" => c.kind = KT
    "real" | "float" | "double" | "numeric" | "decimal" => {
      c.kind = KR
      p.accept_kw("precision")
    }
    "bool" | "boolean" => c.kind = KB
    "timestamp" | "timestamptz" | "datetime" | "time" | "date" => c.kind = KTIME
    "blob" | "bytea" => c.kind = KBLOB
    "json" | "jsonb" => c.kind = KJSON
    _ => return Err(syntax("unknown column type ${ty}"))
  }
  if p.accept_sym("(") {
    while !p.is_sym(")") && p.peek().k != T_EOF {
      p.i += 1
    }
    p.expect_sym(")")?
  }
  if p.accept_sym("[") {
    p.expect_sym("]")?
    c.decl = c.decl + "[]"
    c.elem = c.kind
    c.kind = KARR
  }
  while {
    if p.accept_kw("primary") {
      p.expect_kw("key")?
      c.pk = true
      c.unique = true
      c.not_null = true
      c.auto = c.kind == KI
    } else if p.accept_kw("not") {
      p.expect_kw("null")?
      c.not_null = true
    } else if p.accept_kw("null") {
    } else if p.accept_kw("unique") {
      c.unique = true
    } else if p.accept_kw("autoincrement") {
      c.auto = true
    } else if p.accept_kw("default") {
      match p.primary()? {
        Lit(v) => c.def = v
        _ => return Err(syntax("DEFAULT must be a literal"))
      }
    } else {
      return c
    }
  }
  c
}

fn mem_drop(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  p.i += 1
  if p.is_kw("index") {
    return mem_drop_index(tables, p)
  }
  p.expect_kw("table")?
  var if_ex = false
  if p.accept_kw("if") {
    p.expect_kw("exists")?
    if_ex = true
  }
  let name = p.ident("a table name")?
  if !tables.contains(name) {
    if if_ex {
      return Ok(())
    }
    return Err(sql.SqlErr.NoTable(name: name))
  }
  stmt_end(p)?
  tables.remove(name)
}

fn kind_want(kind: Int) -> Str {
  match kind {
    1 => "an integer"
    2 => "text"
    3 => "a float"
    4 => "a boolean"
    6 => "bytes"
    7 => "json"
    8 => "an array"
    _ => "a time"
  }
}

/// v converted to the column's kind.
fn coerce(c: Col, v: sql.SqlValue) -> sql.SqlValue ! sql.SqlErr {
  if c.kind == KARR {
    if let Array(items) = v {
      // each element to the column's element kind (NULL allowed); a loop,
      // not items.map with a closure: a call through a function value is a
      // point that can be canceled, which made every Mutex.with body that
      // reaches coerce (each INSERT and UPDATE) keep the tables it was
      // given and copy the table it wrote (decision 0528)
      let ec = Col{name: c.name, kind: c.elem}
      var out: List[sql.SqlValue] = List.with_capacity(items.len())
      for x in items {
        out.push(coerce(ec, x)?)
      }
      return sql.SqlValue.Array(items: out)
    }
  }
  match v {
    Null => return v
    Integer(n) => {
      if c.kind == KI {
        return v
      }
      if c.kind == KR {
        return sql.SqlValue.Real(f: Float(n))
      }
    }
    Text(_) => {
      if c.kind == KT {
        return v
      }
    }
    Real(_) => {
      if c.kind == KR {
        return v
      }
    }
    Flag(_) => {
      if c.kind == KB {
        return v
      }
    }
    At(_) => {
      if c.kind == KTIME {
        return v
      }
    }
    Blob(_) => {
      if c.kind == KBLOB {
        return v
      }
    }
    JsonText(_) => {
      if c.kind == KJSON {
        return v
      }
    }
    Array(_) => {}
  }
  Err(sql.SqlErr.Constraint(msg: "column ${c.name} expects ${kind_want(c.kind)}, got ${go_type(v)}", code: "42804", name: ""))
}

/// Checks row's NOT NULL and UNIQUE constraints against t's rows (but slot
/// skip, the row it replaces), with the rows in repl standing for their
/// slots' and the rows of extra added (a statement's own earlier rows: the
/// table as it would be, decision 0528).
fn check_row(t: Table, row: List[sql.SqlValue], skip: Int, extra: List[List[sql.SqlValue]], repl: Map[Int, List[sql.SqlValue]]) -> () ! sql.SqlErr {
  for (i, c) in t.cols.indexed() {
    if row[i] is Null && c.not_null {
      return Err(sql.SqlErr.Constraint(msg: "NOT NULL constraint failed: ${t.name}.${c.name}", code: "23502", name: ""))
    }
    if c.unique && !(row[i] is Null) {
      let dup = sql.SqlErr.Constraint(msg: "UNIQUE constraint failed: ${t.name}.${c.name}", code: "23505", name: "")
      if indexed(c) {
        let s = idx_find(t, i, row[i])
        if s >= 0 && s != skip && !repl.contains(s) {
          return Err(dup)
        }
      } else {
        for (j, o) in t.rows.indexed() {
          if j == skip || o.is_empty() || repl.contains(j) || o[i] is Null {
            continue
          }
          if let Ok(0) = sql_cmp(o[i], row[i]) {
            return Err(dup)
          }
        }
      }
      for (j, o) in repl.entries() {
        if j == skip || o[i] is Null {
          continue
        }
        if let Ok(0) = sql_cmp(o[i], row[i]) {
          return Err(dup)
        }
      }
      for o in extra {
        if o[i] is Null {
          continue
        }
        if let Ok(0) = sql_cmp(o[i], row[i]) {
          return Err(dup)
        }
      }
    }
  }
}

/// What a write statement changes, made and checked by its plan function
/// before the table changes. The plan holds the table it read, so the
/// change runs after it returns, in a Map.update whose closure cannot
/// fail: the table is then changed in place, where a remove or get and a
/// put back copies its rows (the log Map keeps each value it held;
/// decision 0528).
struct Plan {
  name: Str
  res: Write
  slots: List[Int] = []
  rows: List[List[sql.SqlValue]] = []
  next_id: Int = 0
}

fn mem_insert(var tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Write ! sql.SqlErr {
  let pl = insert_plan(tables, p, args, want_ret)?
  tables.update(pl.name, no_table(pl.name), fn(var t) {
    for row in pl.rows {
      t.rows.push(row)
      idx_put(t, t.rows.len() - 1)
    }
    t.next_id = pl.next_id
  })
  pl.res
}

fn insert_plan(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Plan ! sql.SqlErr {
  p.i += 1
  p.expect_kw("into")?
  let name = p.ident("a table name")?
  let old = table_for(tables, name)?
  var cols: List[Int] = []
  if p.accept_sym("(") {
    while {
      let c = p.ident("a column name")?
      let i = old.index(c)
      if i < 0 {
        return Err(syntax("no such column ${c}"))
      }
      cols.push(i)
      if !p.accept_sym(",") {
        break
      }
    }
    p.expect_sym(")")?
  } else {
    for i in 0..old.cols.len() {
      cols.push(i)
    }
  }
  p.expect_kw("values")?
  var tuples: List[List[Node]] = []
  while {
    p.expect_sym("(")?
    var tup: List[Node] = []
    while {
      let x = p.expr()?
      tup.push(x)
      if !p.accept_sym(",") {
        break
      }
    }
    p.expect_sym(")")?
    if tup.len() != cols.len() {
      return Err(syntax("${cols.len()} columns but ${tup.len()} values"))
    }
    tuples.push(tup)
    if !p.accept_sym(",") {
      break
    }
  }
  let (ret, has_ret) = p.returning()?
  check_params(p, args)?
  // every row made and checked before the table changes (decision 0528)
  let env = EvalEnv{t: None, row: [], args: args}
  var next_id = old.next_id
  var last_id = 0
  var added: List[List[sql.SqlValue]] = []
  for tup in tuples {
    var row: List[sql.SqlValue] = []
    for c in old.cols {
      row.push(c.def)
    }
    for (k, ci) in cols.indexed() {
      let v = env.eval(tup[k])?
      row.set(ci, coerce(old.cols[ci], v)?)
    }
    for (i, c) in old.cols.indexed() {
      if !c.auto {
        continue
      }
      if row[i] is Null {
        row.set(i, sql.SqlValue.Integer(n: next_id))
      }
      if let Integer(id) = row[i] {
        if id >= next_id {
          next_id = id + 1
        }
        last_id = id
      }
    }
    check_row(old, row, -1, added, {})?
    added.push(row)
  }
  let res = written(old, tuples.len(), last_id, ret, has_ret, added, args)?
  write_end(p, has_ret, want_ret)?
  Plan{name: name, res: res, rows: added, next_id: next_id}
}

struct Asg {
  col: Int
  e: Node
}

fn mem_update(var tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Write ! sql.SqlErr {
  let pl = update_plan(tables, p, args, want_ret)?
  tables.update(pl.name, no_table(pl.name), fn(var t) {
    // out of the indexes first, so a row taking another's old value keeps it
    for ri in pl.slots {
      idx_drop(t, ri)
    }
    for (k, ri) in pl.slots.indexed() {
      t.rows.set(ri, pl.rows[k])
    }
    for ri in pl.slots {
      idx_put(t, ri)
    }
  })
  pl.res
}

fn update_plan(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Plan ! sql.SqlErr {
  p.i += 1
  let name = p.ident("a table name")?
  let old = table_for(tables, name)?
  p.expect_kw("set")?
  var asgs: List[Asg] = []
  while {
    let c = p.ident("a column name")?
    let i = old.index(c)
    if i < 0 {
      return Err(syntax("no such column ${c}"))
    }
    p.expect_sym("=")?
    let e = p.expr()?
    asgs.push(Asg{col: i, e: e})
    if !p.accept_sym(",") {
      break
    }
  }
  var w: Node? = None
  if p.accept_kw("where") {
    w = Some(p.expr()?)
  }
  let (ret, has_ret) = p.returning()?
  check_params(p, args)?
  // every new row made and checked, in slot order against the rows before
  // it already changed, before the table changes (decision 0528)
  var slots: List[Int] = []
  var changed: List[List[sql.SqlValue]] = []
  var repl: Map[Int, List[sql.SqlValue]] = {}
  let cand = candidates(old, w, args)
  // one environment for every row: wrapping the table per row cost a
  // retain and a release of it each
  var env = EvalEnv{t: Some(old), row: [], args: args}
  for k in 0..slots_len(old, cand) {
    let ri = slot_at(cand, k)
    let row = old.rows[ri]
    if row.is_empty() {
      continue
    }
    env.row = row
    if !env.where_ok(w)? {
      continue
    }
    var nr = row
    for a in asgs {
      let v = env.eval(a.e)?
      nr.set(a.col, coerce(old.cols[a.col], v)?)
    }
    check_row(old, nr, ri, [], repl)?
    repl.put(ri, nr)
    slots.push(ri)
    changed.push(nr)
  }
  let res = written(old, changed.len(), 0, ret, has_ret, changed, args)?
  write_end(p, has_ret, want_ret)?
  Plan{name: name, res: res, slots: slots, rows: changed}
}

fn mem_delete(var tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Write ! sql.SqlErr {
  let pl = delete_plan(tables, p, args, want_ret)?
  // the slots become empty rows (no rebuild of the list, decision 0528),
  // compacted once they are more than half of it
  tables.update(pl.name, no_table(pl.name), fn(var t) {
    for ri in pl.slots {
      idx_drop(t, ri)
      t.rows.set(ri, [])
    }
    t.dead += pl.slots.len()
    if t.dead > 64 && t.dead * 2 > t.rows.len() {
      compact(t)
    }
  })
  pl.res
}

fn delete_plan(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Plan ! sql.SqlErr {
  p.i += 1
  p.expect_kw("from")?
  let name = p.ident("a table name")?
  let old = table_for(tables, name)?
  var w: Node? = None
  if p.accept_kw("where") {
    w = Some(p.expr()?)
  }
  let (ret, has_ret) = p.returning()?
  check_params(p, args)?
  var slots: List[Int] = []
  var gone: List[List[sql.SqlValue]] = []
  let cand = candidates(old, w, args)
  var env = EvalEnv{t: Some(old), row: [], args: args}
  for k in 0..slots_len(old, cand) {
    let ri = slot_at(cand, k)
    let row = old.rows[ri]
    if row.is_empty() {
      continue
    }
    env.row = row
    if env.where_ok(w)? {
      gone.push(row)
      slots.push(ri)
    }
  }
  let res = written(old, gone.len(), 0, ret, has_ret, gone, args)?
  write_end(p, has_ret, want_ret)?
  Plan{name: name, res: res, slots: slots}
}

/// The end of a statement, checked before its write.
fn stmt_end(p: Parser) -> () ! sql.SqlErr {
  if p.peek().k != T_EOF {
    return Err(p.fail("end of statement"))
  }
}

/// The checks mem_exec and mem_run made after a write, made before it
/// changes anything (decision 0528): the statement ends, and a query's
/// write has RETURNING.
fn write_end(p: Parser, has_ret: Bool, want_ret: Bool) -> () ! sql.SqlErr {
  stmt_end(p)?
  if want_ret && !has_ret {
    return Err(syntax(QUERY_NEEDS))
  }
}

/// The outcome of a write that touched rows of t.
fn written(t: Table, n: Int, id: Int, ret: List[SelItem], has_ret: Bool, rows: List[List[sql.SqlValue]], args: List[sql.SqlValue]) -> Write ! sql.SqlErr {
  if !has_ret {
    return Write{n: n, id: id}
  }
  let out = project(t, ret, rows, args)?
  Write{n: n, id: id, returning: true, cols: out.cols, rows: out.rows, types: out.types}
}

/// One item of a SELECT or RETURNING list.
struct SelItem {
  star: Bool = false
  e: Node = Node.Count
  alias: Str = ""
}

fn (var p: Parser) returning() -> (List[SelItem], Bool) ! sql.SqlErr {
  if !p.accept_kw("returning") {
    return ([], false)
  }
  let items = p.sel_items()?
  for it in items {
    if !it.star && it.e is Count {
      return Err(syntax("RETURNING cannot use COUNT(*)"))
    }
  }
  (items, true)
}

fn (var p: Parser) sel_items() -> List[SelItem] ! sql.SqlErr {
  var items: List[SelItem] = []
  while {
    if p.accept_sym("*") {
      items.push(SelItem{star: true})
    } else {
      let e = p.expr()?
      var alias = ""
      if p.accept_kw("as") {
        alias = p.ident("an alias")?
      }
      items.push(SelItem{e: e, alias: alias})
    }
    if !p.accept_sym(",") {
      return items
    }
  }
  items
}

/// The result column names of items over t, and the count of COUNT(*)
/// items.
fn sel_cols(t: Table, items: List[SelItem]) -> (List[Str], Int) {
  var cols: List[Str] = []
  var counts = 0
  for it in items {
    if it.star {
      for c in t.cols {
        cols.push(c.name)
      }
    } else if it.alias != "" {
      cols.push(it.alias)
      if it.e is Count {
        counts += 1
      }
    } else {
      match it.e {
        Col(name) => cols.push(name)
        Count => {
          cols.push("count")
          counts += 1
        }
        Lit(_) | Param(_) | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => cols.push("?column?")
      }
    }
  }
  (cols, counts)
}

/// items (without COUNT(*)) evaluated on each row of t.
fn project(t: Table, items: List[SelItem], rows: List[List[sql.SqlValue]], args: List[sql.SqlValue]) -> MemRows ! sql.SqlErr {
  let (cols, _) = sel_cols(t, items)
  var out: List[List[sql.SqlValue]] = []
  var env = EvalEnv{t: Some(t), row: [], args: args}
  for row in rows {
    env.row = row
    var r: List[sql.SqlValue] = []
    for it in items {
      if it.star {
        for v in row {
          r.push(v)
        }
        continue
      }
      r.push(env.eval(it.e)?)
    }
    out.push(r)
  }
  MemRows{cols: cols, rows: out, types: sel_types(t, items)}
}

/// Each selected column's type (decision 0609): a table column's declared
/// type, NOT NULL and kind; COUNT(*) an Integer that is never null; an
/// expression unknown.
fn sel_types(t: Table, items: List[SelItem]) -> List[sql.ColumnType] {
  var out: List[sql.ColumnType] = []
  for it in items {
    if it.star {
      for c in t.cols {
        out.push(col_type(c, c.name))
      }
      continue
    }
    let name = if it.alias != "" { it.alias } else {
      match it.e {
        Col(n) => n
        Count => "count"
        Lit(_) | Param(_) | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => "?column?"
      }
    }
    match it.e {
      Col(n) => {
        var ct = sql.ColumnType{name: name}
        for c in t.cols {
          if c.name == n {
            ct = col_type(c, name)
            break
          }
        }
        out.push(ct)
      }
      Count => out.push(sql.ColumnType{name: name, nullable: Some(false), kind: "Integer"})
      Lit(_) | Param(_) | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => out.push(sql.ColumnType{name: name})
    }
  }
  out
}

fn col_type(c: Col, name: Str) -> sql.ColumnType {
  let kind = match c.kind {
    1 => "Integer"
    2 => "Text"
    3 => "Real"
    4 => "Flag"
    5 => "At"
    6 => "Blob"
    7 => "JsonText"
    8 => "Array"
    _ => ""
  }
  sql.ColumnType{name: name, database_type: c.decl, nullable: Some(!c.not_null), kind: kind}
}

struct OrderKey {
  e: Node
  desc: Bool
}

/// The order of two sort keys of one ORDER BY item (NULL first).
fn key_cmp(x: sql.SqlValue, y: sql.SqlValue) -> Int {
  if x is Null && y is Null {
    return 0
  }
  if x is Null {
    return -1
  }
  if y is Null {
    return 1
  }
  sql_cmp(x, y).ok() ?? 0
}

fn row_less(a: List[sql.SqlValue], b: List[sql.SqlValue], orders: List[OrderKey]) -> Bool {
  for (k, o) in orders.indexed() {
    let c = key_cmp(a[k], b[k])
    if c != 0 {
      return if o.desc { c > 0 } else { c < 0 }
    }
  }
  false
}

/// Whether the keys are already in order: no row sorts strictly before
/// the one ahead of it, so the stable sort would keep every row where it
/// is (an ORDER BY over the insertion order, the usual case).
fn keys_in_order(keys: List[List[sql.SqlValue]], orders: List[OrderKey]) -> Bool {
  for i in 1..keys.len() {
    if row_less(keys[i], keys[i - 1], orders) {
      return false
    }
  }
  true
}

/// A stable merge sort of the indexes 0..keys.len() by the keys:
/// bottom up, runs of 1, 2, 4, ... merged between two buffers, so it
/// allocates two lists where the recursive form sliced and built one per
/// call.
fn sort_idx(keys: List[List[sql.SqlValue]], orders: List[OrderKey]) -> List[Int] {
  let n = keys.len()
  var a = List[Int].with_capacity(n)
  var b = List[Int].with_capacity(n)
  for i in 0..n {
    a.push(i)
    b.push(i)
  }
  var w = 1
  while w < n {
    var lo = 0
    while lo < n {
      let mid = if lo + w < n { lo + w } else { n }
      let hi = if lo + 2 * w < n { lo + 2 * w } else { n }
      var i = lo
      var j = mid
      var o = lo
      while i < mid && j < hi {
        // take from the right only when it is strictly less (stable)
        if row_less(keys[a[j]], keys[a[i]], orders) {
          b[o] = a[j]
          j += 1
        } else {
          b[o] = a[i]
          i += 1
        }
        o += 1
      }
      while i < mid {
        b[o] = a[i]
        i += 1
        o += 1
      }
      while j < hi {
        b[o] = a[j]
        j += 1
        o += 1
      }
      lo = hi
    }
    let t = a
    a = b
    b = t
    w = w * 2
  }
  a
}

fn int_arg(n: Node, args: List[sql.SqlValue]) -> Int ! sql.SqlErr {
  let bad = syntax("LIMIT and OFFSET need a non negative integer")
  match (EvalEnv{t: None, row: [], args: args}).eval(n) {
    Ok(Integer(x)) => {
      if x < 0 {
        return Err(bad)
      }
      x
    }
    _ => Err(bad)
  }
}

fn mem_select(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue]) -> MemRows ! sql.SqlErr {
  p.i += 1
  let items = p.sel_items()?
  p.expect_kw("from")?
  let name = p.ident("a table name")?
  let t = table_for(tables, name)?
  var w: Node? = None
  if p.accept_kw("where") {
    w = Some(p.expr()?)
  }
  var orders: List[OrderKey] = []
  if p.accept_kw("order") {
    p.expect_kw("by")?
    while {
      let e = p.expr()?
      var desc = false
      if p.accept_kw("desc") {
        desc = true
      } else {
        p.accept_kw("asc")
      }
      orders.push(OrderKey{e: e, desc: desc})
      if !p.accept_sym(",") {
        break
      }
    }
  }
  var limit: Node? = None
  var offset: Node? = None
  if p.accept_kw("limit") {
    limit = Some(p.primary()?)
    if p.accept_kw("offset") {
      offset = Some(p.primary()?)
    }
  }
  if p.peek().k != T_EOF {
    return Err(p.fail("end of statement"))
  }
  check_params(p, args)?
  // filter
  var rows: List[List[sql.SqlValue]] = []
  let cand = candidates(t, w, args)
  // one environment for every row: wrapping the table per row cost a
  // retain and a release of it each
  var env = EvalEnv{t: Some(t), row: [], args: args}
  for k in 0..slots_len(t, cand) {
    let row = t.rows[slot_at(cand, k)]
    if row.is_empty() {
      continue
    }
    env.row = row
    if env.where_ok(w)? {
      rows.push(row)
    }
  }
  // order
  if !orders.is_empty() {
    var keys: List[List[sql.SqlValue]] = []
    for row in rows {
      env.row = row
      var k: List[sql.SqlValue] = []
      for o in orders {
        k.push(env.eval(o.e)?)
      }
      keys.push(k)
    }
    // values that cannot be compared are an error (std/rt reports the
    // first pair its sort compares; columns hold one type, so in practice
    // there is none)
    for (oi, _) in orders.indexed() {
      var first: sql.SqlValue? = None
      for k in keys {
        if k[oi] is Null {
          continue
        }
        match first {
          None => first = Some(k[oi])
          Some(f) => {
            sql_cmp(f, k[oi])?
          }
        }
      }
    }
    if !keys_in_order(keys, orders) {
      var sorted = List[List[sql.SqlValue]].with_capacity(rows.len())
      for i in sort_idx(keys, orders) {
        sorted.push(rows[i])
      }
      rows = sorted
    }
  }
  // offset, limit
  if let Some(o) = offset {
    var k = int_arg(o, args)?
    if k > rows.len() {
      k = rows.len()
    }
    rows = rows[k..rows.len()]
  }
  if let Some(l) = limit {
    let k = int_arg(l, args)?
    if k < rows.len() {
      rows = rows[0..k]
    }
  }
  // project
  let (cols, counts) = sel_cols(t, items)
  if counts > 0 {
    if counts != items.len() {
      return Err(syntax("COUNT(*) cannot be mixed with other columns"))
    }
    var out: List[sql.SqlValue] = []
    for _ in items {
      out.push(sql.SqlValue.Integer(n: rows.len()))
    }
    return MemRows{cols: cols, rows: [out], types: sel_types(t, items)}
  }
  project(t, items, rows, args)
}

// sql.named: pgx v5.12.0 named_args.go (NamedArgs and StrictNamedArgs
// RewriteQuery and its lexer), Copyright (c) 2013-2021 Jack Christensen,
// MIT License. Byte based: every delimiter is ASCII and a byte from 0x80
// up is an identifier byte, as pgx's rune checks are on valid UTF-8.

fn na_letter(c: UInt8) -> Bool { (c >= 97 && c <= 122) || (c >= 65 && c <= 90) }

fn na_ident(c: UInt8) -> Bool { na_letter(c) || c == 95 || c >= 128 }

fn na_digit(c: UInt8) -> Bool { c >= 48 && c <= 57 }

/// The index after a quoted string or identifier opened before i, with
/// q doubled to escape it; esc also lets a backslash escape the next byte
/// (an E'...' string).
fn na_quoted(b: Bytes, i: Int, q: UInt8, esc: Bool) -> Int {
  var j = i
  while j < b.len() {
    let c = b[j]
    j += 1
    if esc && c == 92 {
      j += 1
    } else if c == q {
      if j < b.len() && b[j] == q {
        j += 1
      } else {
        return j
      }
    }
  }
  b.len()
}

/// The length of a dollar quote's tag at b[i..] up to its closing `$`
/// (pgx's scanDollarQuoteTag), or None when b[i..] is not a tag.
fn na_tag(b: Bytes, i: Int) -> Int? {
  var j = i
  while j < b.len() {
    let c = b[j]
    if c == 36 {
      return Some(j - i)
    }
    if !(na_ident(c) || (j > i && na_digit(c))) {
      return None
    }
    j += 1
  }
  None
}

fn named_args[T: SqlRow](v: T) -> Map[Str, sql.SqlValue] {
  var m: Map[Str, sql.SqlValue] = {}
  for (k, x) in rtsql.sql_encode[T](v) {
    m[k] = x
  }
  m
}

fn named(q: Str, args: Map[Str, sql.SqlValue], strict: Bool = false) -> (Str, List[sql.SqlValue]) ! sql.SqlErr {
  let b = q.bytes()
  let n = b.len()
  var out: List[Str] = []
  var names: List[Str] = []
  var ord: Map[Str, Int] = {}
  var start = 0
  var i = 0
  while i < n {
    let c = b[i]
    i += 1
    if (c == 101 || c == 69) && i < n && b[i] == 39 {
      i = na_quoted(b, i + 1, 39, true)
      continue
    }
    if c == 39 || c == 34 {
      i = na_quoted(b, i, c, false)
    } else if c == 36 {
      if let Some(t) = na_tag(b, i) {
        let tag = q[i - 1..i + t + 1]
        i += t + 1
        match q[i..n].find(tag) {
          Some(k) => i += k + tag.len()
          None => i = n
        }
      }
    } else if c == 64 && i < n && (na_letter(b[i]) || b[i] == 95) {
      out.push(q[start..i - 1])
      var j = i
      while j < n && (na_letter(b[j]) || na_digit(b[j]) || b[j] == 95) {
        j += 1
      }
      let name = q[i..j]
      var k = names.len() + 1
      match ord.get(name) {
        Some(o) => k = o
        None => {
          names.push(name)
          ord.put(name, k)
        }
      }
      out.push("$${k}")
      start = j
      i = j
      continue
    } else if c == 45 && i < n && b[i] == 45 {
      while i < n && b[i] != 10 && b[i] != 13 {
        i += 1
      }
      i += 1
    } else if c == 47 && i < n && b[i] == 42 {
      i += 1
      var depth = 0
      while i < n {
        let d = b[i]
        i += 1
        if d == 47 && i < n && b[i] == 42 {
          i += 1
          depth += 1
        } else if d == 42 && i < n && b[i] == 47 {
          i += 1
          if depth == 0 {
            break
          }
          depth -= 1
        }
      }
    }
    if na_ident(c) {
      while i < n && (na_ident(b[i]) || na_digit(b[i]) || b[i] == 36) {
        i += 1
      }
    }
  }
  if start < n {
    out.push(q[start..n])
  }
  var vals: List[sql.SqlValue] = []
  for name in names {
    match args.get(name) {
      Some(v) => vals.push(v)
      None => {
        if strict {
          return Err(sql.SqlErr.Param(msg: "named argument @${name} has no value"))
        }
        vals.push(sql.SqlValue.Null)
      }
    }
  }
  if strict {
    for (name, _) in args {
      if !ord.contains(name) {
        return Err(sql.SqlErr.Param(msg: "named argument ${name} is not used by the query"))
      }
    }
  }
  (out.join(""), vals)
}

// Ranges and multiranges: pgx v5.12.0 pgtype/range.go
// (parseUntypedTextRange, rangeParseValue, rangeParseQuotedValue) and
// pgtype/multirange.go (parseUntypedTextMultirange, parseRange),
// Copyright (c) 2013-2021 Jack Christensen, MIT License.

/// A range's text split into its edges: kind 0 unbounded, 1 inclusive,
/// 2 exclusive, with each bound's unquoted text.
struct RawRange {
  empty: Bool
  lk: Int
  lo: Str
  uk: Int
  hi: Str
}

fn rg_space(b: Bytes, i: Int) -> Int {
  var j = i
  while j < b.len() && (b[j] == 32 || (b[j] >= 9 && b[j] <= 13)) {
    j += 1
  }
  j
}

/// A double quoted bound's text from after its opening quote at i: a
/// backslash escapes the next byte, a doubled quote is one quote.
fn rg_quoted(s: Str, i: Int) -> (Str, Int)? {
  let b = s.bytes()
  var out = ""
  var start = i
  var j = i
  while j < b.len() {
    let c = b[j]
    if c == 92 {
      if j + 1 >= b.len() {
        return None
      }
      out = out + s[start..j]
      start = j + 1
      j += 2
    } else if c == 34 {
      if j + 1 >= b.len() {
        return None
      }
      if b[j + 1] == 34 {
        out = out + s[start..j + 1]
        start = j + 2
        j += 2
      } else {
        return Some((out + s[start..j], j + 1))
      }
    } else {
      j += 1
    }
  }
  None
}

/// A bound's text at i, up to a `,`, bracket or parenthesis.
fn rg_value(s: Str, i: Int) -> (Str, Int)? {
  let b = s.bytes()
  if i >= b.len() {
    return None
  }
  if b[i] == 34 {
    return rg_quoted(s, i + 1)
  }
  var out = ""
  var start = i
  var j = i
  while j < b.len() {
    let c = b[j]
    if c == 92 {
      if j + 1 >= b.len() {
        return None
      }
      out = out + s[start..j]
      start = j + 1
      j += 2
    } else if c == 44 || c == 91 || c == 93 || c == 40 || c == 41 {
      return Some((out + s[start..j], j))
    } else {
      j += 1
    }
  }
  None
}

fn rg_parse(s: Str) -> RawRange? {
  if s == "empty" {
    return Some(RawRange{empty: true, lk: 0, lo: "", uk: 0, hi: ""})
  }
  let b = s.bytes()
  let n = b.len()
  var i = rg_space(b, 0)
  if i >= n {
    return None
  }
  var lk = 0
  if b[i] == 40 {
    lk = 2
  } else if b[i] == 91 {
    lk = 1
  } else {
    return None
  }
  i += 1
  if i >= n {
    return None
  }
  var lo = ""
  if b[i] == 44 {
    lk = 0
  } else {
    let (v, j) = rg_value(s, i)?
    lo = v
    i = j
  }
  if i >= n || b[i] != 44 {
    return None
  }
  i += 1
  if i >= n {
    return None
  }
  var uk = 0
  var hi = ""
  if b[i] == 41 || b[i] == 93 {
    i += 1
  } else {
    let (v, j) = rg_value(s, i)?
    hi = v
    i = j
    if i >= n {
      return None
    }
    if b[i] == 41 {
      uk = 2
    } else if b[i] == 93 {
      uk = 1
    } else {
      return None
    }
    i += 1
  }
  if rg_space(b, i) < n {
    return None
  }
  Some(RawRange{empty: false, lk: lk, lo: lo, uk: uk, hi: hi})
}

fn rg_edge[T](k: Int, v: Str, f: fn(Str) -> T?) -> sql.Edge[T]? {
  match k {
    0 => Some(sql.Edge.Unbounded)
    1 => Some(sql.Edge.Inclusive(v: f(v)?))
    _ => Some(sql.Edge.Exclusive(v: f(v)?))
  }
}

fn rg_typed[T](s: Str, f: fn(Str) -> T?) -> sql.Range[T]? {
  let r = rg_parse(s)?
  if r.empty {
    return Some(sql.Range.Empty)
  }
  Some(sql.Range.Span(lower: rg_edge(r.lk, r.lo, f)?, upper: rg_edge(r.uk, r.hi, f)?))
}

/// A multirange's text split into its ranges' texts (pgx's
/// parseUntypedTextMultirange and parseRange).
fn mr_split(s: Str) -> List[Str]? {
  let b = s.bytes()
  let n = b.len()
  var i = rg_space(b, 0)
  if i >= n || b[i] != 123 {
    return None
  }
  i += 1
  var out: List[Str] = []
  while true {
    if i >= n {
      return None
    }
    let c = b[i]
    if c == 44 {
      i += 1
    } else if c == 125 {
      i += 1
      break
    } else {
      var j = i
      var in_range = false
      var in_q = false
      var esc = false
      while true {
        if j >= n {
          return None
        }
        let d = b[j]
        if esc {
          esc = false
        } else if d == 92 {
          esc = true
        } else if d == 34 {
          in_q = !in_q
        } else if !in_q {
          if d == 91 || d == 40 {
            in_range = true
          } else if d == 93 || d == 41 {
            in_range = false
          } else if (d == 44 || d == 125) && !in_range {
            break
          }
        }
        j += 1
      }
      out.push(s[i..j])
      i = j
    }
  }
  if rg_space(b, i) < n {
    return None
  }
  Some(out)
}

fn mr_typed[T](s: Str, f: fn(Str) -> T?) -> List[sql.Range[T]]? {
  var out: List[sql.Range[T]] = []
  for e in mr_split(s)? {
    out.push(rg_typed(e, f)?)
  }
  Some(out)
}

fn pg_int_text(s: Str) -> Int? { Int.parse(s) }

/// A timestamp or timestamptz's ISO text (pg's iso_to_rfc3339): no
/// offset after the time reads as UTC.
fn pg_timestamp(s: Str) -> Time? {
  var t = s.replace(" ", "T")
  let b = t.bytes()
  var i = b.len() - 1
  while i > 10 && b[i] != 43 && b[i] != 45 {
    i -= 1
  }
  if i <= 10 {
    t = t + "Z"
  } else if b.len() - i == 3 {
    t = t + ":00"
  }
  Time.parse_rfc3339(t)
}

fn rg_text[T](r: sql.Range[T], f: fn(T) -> Str) -> Str {
  match r {
    Empty => "empty"
    Span(lo, hi) => {
      let l = match lo {
        Inclusive(v) => "[" + f(v)
        Exclusive(v) => "(" + f(v)
        Unbounded => "("
      }
      let u = match hi {
        Inclusive(v) => f(v) + "]"
        Exclusive(v) => f(v) + ")"
        Unbounded => ")"
      }
      l + "," + u
    }
  }
}

fn int_text(n: Int) -> Str { "${n}" }

fn time_text(t: Time) -> Str { "\"" + t.format_rfc3339() + "\"" }

fn range_int(r: sql.Range[Int]) -> sql.SqlValue { sql.SqlValue.Text(s: rg_text(r, int_text)) }

fn range_date(r: sql.Range[time.Date]) -> sql.SqlValue { sql.SqlValue.Text(s: rg_text(r, date_text)) }

fn range_time(r: sql.Range[Time]) -> sql.SqlValue { sql.SqlValue.Text(s: rg_text(r, time_text)) }

fn multirange_int(rs: List[sql.Range[Int]]) -> sql.SqlValue { sql.SqlValue.Text(s: "{" + rs.map(fn(r) { rg_text(r, int_text) }).join(",") + "}") }

fn multirange_date(rs: List[sql.Range[time.Date]]) -> sql.SqlValue { sql.SqlValue.Text(s: "{" + rs.map(fn(r) { rg_text(r, date_text) }).join(",") + "}") }

fn multirange_time(rs: List[sql.Range[Time]]) -> sql.SqlValue { sql.SqlValue.Text(s: "{" + rs.map(fn(r) { rg_text(r, time_text) }).join(",") + "}") }

fn rg_read[T](r: Row, name: Str, want: Str, f: fn(Str) -> T?) -> sql.Range[T]? ! sql.SqlErr {
  match typed_text(r, name, want)? {
    None => None
    Some(s) => match rg_typed(s, f) {
      Some(v) => Some(v)
      None => Err(bad_text(name, want, s))
    }
  }
}

fn mr_read[T](r: Row, name: Str, want: Str, f: fn(Str) -> T?) -> List[sql.Range[T]]? ! sql.SqlErr {
  match typed_text(r, name, want)? {
    None => None
    Some(s) => match mr_typed(s, f) {
      Some(v) => Some(v)
      None => Err(bad_text(name, want, s))
    }
  }
}

fn (r: Row) range_int_opt(name: Str) -> sql.Range[Int]? ! sql.SqlErr { rg_read(r, name, "an int range", pg_int_text) }

fn (r: Row) range_int(name: Str) -> sql.Range[Int] ! sql.SqlErr { r.range_int_opt(name)?.or_err(mismatch(name, "an int range", sql.SqlValue.Null)) }

fn (r: Row) range_date_opt(name: Str) -> sql.Range[time.Date]? ! sql.SqlErr { rg_read(r, name, "a date range", pg_date) }

fn (r: Row) range_date(name: Str) -> sql.Range[time.Date] ! sql.SqlErr { r.range_date_opt(name)?.or_err(mismatch(name, "a date range", sql.SqlValue.Null)) }

fn (r: Row) range_time_opt(name: Str) -> sql.Range[Time]? ! sql.SqlErr { rg_read(r, name, "a time range", pg_timestamp) }

fn (r: Row) range_time(name: Str) -> sql.Range[Time] ! sql.SqlErr { r.range_time_opt(name)?.or_err(mismatch(name, "a time range", sql.SqlValue.Null)) }

fn (r: Row) multirange_int_opt(name: Str) -> List[sql.Range[Int]]? ! sql.SqlErr { mr_read(r, name, "an int multirange", pg_int_text) }

fn (r: Row) multirange_int(name: Str) -> List[sql.Range[Int]] ! sql.SqlErr { r.multirange_int_opt(name)?.or_err(mismatch(name, "an int multirange", sql.SqlValue.Null)) }

fn (r: Row) multirange_date_opt(name: Str) -> List[sql.Range[time.Date]]? ! sql.SqlErr { mr_read(r, name, "a date multirange", pg_date) }

fn (r: Row) multirange_date(name: Str) -> List[sql.Range[time.Date]] ! sql.SqlErr { r.multirange_date_opt(name)?.or_err(mismatch(name, "a date multirange", sql.SqlValue.Null)) }

fn (r: Row) multirange_time_opt(name: Str) -> List[sql.Range[Time]]? ! sql.SqlErr { mr_read(r, name, "a time multirange", pg_timestamp) }

fn (r: Row) multirange_time(name: Str) -> List[sql.Range[Time]] ! sql.SqlErr { r.multirange_time_opt(name)?.or_err(mismatch(name, "a time multirange", sql.SqlValue.Null)) }

// Composites and records: pgx v5.12.0 pgtype/composite.go
// (CompositeTextScanner, CompositeTextBuilder, quoteCompositeFieldIfNeeded),
// Copyright (c) 2013-2021 Jack Christensen, MIT License.

/// A composite's text split into its fields (pgx's CompositeTextScanner
/// Next loop), or the reason it is not one.
fn comp_split(s: Str) -> List[Str?] ! Str {
  let b = s.bytes()
  let n = b.len()
  if n < 2 {
    return Err("record incomplete")
  }
  if b[0] != 40 {
    return Err("composite text format must start with '('")
  }
  if b[n - 1] != 41 {
    return Err("composite text format must end with ')'")
  }
  var out: List[Str?] = []
  var i = 1
  while i < n {
    let c = b[i]
    if c == 44 || c == 41 {
      out.push(None)
      i += 1
    } else if c == 34 {
      i += 1
      var f = ""
      var start = i
      while true {
        if i >= n {
          return Err("composite text format unterminated quoted field")
        }
        let d = b[i]
        if d == 34 {
          f = f + s[start..i]
          i += 1
          if i < n && b[i] == 34 {
            start = i
            i += 1
          } else {
            break
          }
        } else if d == 92 {
          f = f + s[start..i]
          i += 1
          if i >= n {
            return Err("composite text format unterminated quoted field")
          }
          start = i
          i += 1
        } else {
          i += 1
        }
      }
      out.push(Some(f))
      i += 1
    } else {
      let start = i
      while b[i] != 44 && b[i] != 41 {
        i += 1
      }
      out.push(Some(s[start..i]))
      i += 1
    }
  }
  out
}

fn parse_composite(s: Str) -> List[Str?] ! sql.SqlErr {
  match comp_split(s) {
    Ok(fs) => fs
    Err(m) => Err(sql.SqlErr.Syntax(msg: "${m}: ${s.debug()}"))
  }
}

fn comp_quote(f: Str) -> Str {
  let b = f.bytes()
  var need = f.len() == 0 || b[0] == 32 || b[b.len() - 1] == 32
  for c in b {
    if c == 40 || c == 41 || c == 44 || c == 34 || c == 92 {
      need = true
    }
  }
  if need {
    "\"" + f.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
  } else {
    f
  }
}

fn composite(fields: List[Str?]) -> sql.SqlValue {
  sql.SqlValue.Text(s: "(" + fields.map(fn(f) { f.map(fn(x) { comp_quote(x) }) ?? "" }).join(",") + ")")
}

fn (r: Row) fields_opt(name: Str) -> List[Str?]? ! sql.SqlErr {
  match typed_text(r, name, "a composite")? {
    None => None
    Some(s) => match comp_split(s) {
      Ok(fs) => Some(fs)
      Err(_) => Err(bad_text(name, "a composite", s))
    }
  }
}

fn (r: Row) fields(name: Str) -> List[Str?] ! sql.SqlErr { r.fields_opt(name)?.or_err(mismatch(name, "a composite", sql.SqlValue.Null)) }

// Numeric (decision 0681): pgx v5.12.0 pgtype/numeric.go
// (parseNumericString, parseScientificNumericString, numberTextBytes,
// encodeNumericText, toBigInt, Float64Value), Copyright (c) 2013-2021
// Jack Christensen, MIT License.

/// pgx's minNumericExponent and maxNumericExponent.
/// Whether t is an optional sign and then one or more ASCII digits.
fn num_digits(t: Str) -> Bool {
  let b = t.bytes()
  var i = 0
  if b.len() > 0 && (b[0] == 43 || b[0] == 45) {
    i = 1
  }
  if i >= b.len() {
    return false
  }
  while i < b.len() {
    if b[i] < 48 || b[i] > 57 {
      return false
    }
    i += 1
  }
  true
}

fn num_exp_ok(e: Int) -> Bool { e >= -32767 && e <= 32767 * 4 + 3 }

/// A plain numeric text (pgx's parseNumericString): an integer's
/// trailing zeros move into the exponent; a fraction's digits set it.
fn num_plain(s: Str) -> sql.Numeric? {
  var digits = s
  var exp = 0
  match s.find(".") {
    None => {
      while digits.len() > 1 && digits.ends_with("0") && !digits.ends_with("-0") {
        digits = digits[0..digits.len() - 1]
        exp += 1
      }
    }
    Some(i) => {
      exp = -(s.len() - i - 1)
      digits = s[0..i] + s[i + 1..s.len()]
    }
  }
  match big.parse(digits, 10) {
    Ok(c) => Some(sql.Numeric.Finite(coef: c, exp: exp))
    Err(_) => None
  }
}

/// A numeric's text as pgx's text scan and ScanScientific read it, or
/// the reason it is not one.
fn num_parse(s: Str) -> sql.Numeric ! Str {
  match s {
    "NaN" => return sql.Numeric.NaN
    "Infinity" => return sql.Numeric.Infinity
    "-Infinity" => return sql.Numeric.NegInfinity
    _ => {}
  }
  let b = s.bytes()
  var e = -1
  for i in 0..b.len() {
    if e < 0 && (b[i] == 101 || b[i] == 69) {
      e = i
    }
  }
  if e < 0 {
    return num_plain(s).or_err("${s} is not a number")
  }
  let es = s[e + 1..s.len()]
  let x = match Int.parse(es) {
    Some(x) => x
    // Go's ParseInt: digits past the range are ErrRange
    None => return Err(if num_digits(es) { "${s} exponent out of range" } else { "${s} is not a number" })
  }
  if x < -2147483648 || x > 2147483647 {
    return Err("${s} exponent out of range")
  }
  match num_plain(s[0..e]) {
    Some(Finite(c, m)) => {
      if !num_exp_ok(m + x) {
        return Err("${s} exponent out of range")
      }
      sql.Numeric.Finite(coef: c, exp: m + x)
    }
    _ => Err("${s} is not a number")
  }
}

fn parse_numeric(s: Str) -> sql.Numeric ! sql.SqlErr {
  match num_parse(s) {
    Ok(n) => n
    Err(m) => Err(sql.SqlErr.Syntax(msg: m))
  }
}

fn pg_numeric(s: Str) -> sql.Numeric? { num_parse(s).ok() }

fn pow10(e: Int) -> big.BigInt { big.from_int(10).exp(big.from_int(e)) }

fn numeric_display(n: sql.Numeric) -> Str {
  match n {
    NaN => "NaN"
    Infinity => "Infinity"
    NegInfinity => "-Infinity"
    Finite(c, exp) => {
      var digits = c.text()
      var sign = ""
      if digits.starts_with("-") {
        sign = "-"
        digits = digits[1..digits.len()]
      }
      if exp > 0 {
        sign + digits + "0".repeat(exp)
      } else if exp < 0 {
        if digits.len() <= -exp {
          sign + "0." + "0".repeat(-exp - digits.len()) + digits
        } else {
          let dp = digits.len() + exp
          sign + digits[0..dp] + "." + digits[dp..digits.len()]
        }
      } else {
        sign + digits
      }
    }
  }
}

fn numeric_to_rat(n: sql.Numeric) -> big.BigRat? {
  match n {
    Finite(c, exp) => {
      if exp >= 0 {
        Some(big.rat(c.mul(pow10(exp)), big.from_int(1)))
      } else {
        Some(big.rat(c, pow10(-exp)))
      }
    }
    _ => None
  }
}

fn numeric_to_float(n: sql.Numeric) -> Float {
  match n {
    NaN => Float.parse("NaN") ?? 0.0
    Infinity => Float.parse("+Inf") ?? 0.0
    NegInfinity => Float.parse("-Inf") ?? 0.0
    Finite(c, exp) => match Float.parse("${c.text()}e${exp}") {
      Some(f) => f
      // past Float's range (Go's ParseFloat gives the infinity with
      // ErrRange)
      None => if exp > 0 { Float.parse(if c.sign() < 0 { "-Inf" } else { "+Inf" }) ?? 0.0 } else { 0.0 }
    }
  }
}

fn numeric_to_int(n: sql.Numeric) -> Int? {
  match n {
    Finite(c, exp) => {
      if exp >= 0 {
        return c.mul(pow10(exp)).to_int()
      }
      let (q, r) = c.quo_rem(pow10(-exp))
      if r.sign() != 0 {
        return None
      }
      q.to_int()
    }
    _ => None
  }
}

fn numeric(n: sql.Numeric) -> sql.SqlValue { sql.SqlValue.Text(s: numeric_display(n)) }

fn range_num(r: sql.Range[sql.Numeric]) -> sql.SqlValue { sql.SqlValue.Text(s: rg_text(r, numeric_display)) }

fn multirange_num(rs: List[sql.Range[sql.Numeric]]) -> sql.SqlValue { sql.SqlValue.Text(s: "{" + rs.map(fn(r) { rg_text(r, numeric_display) }).join(",") + "}") }

fn (r: Row) numeric_opt(name: Str) -> sql.Numeric? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Integer(n) => Some(sql.Numeric.Finite(coef: big.from_int(n), exp: 0))
    Text(s) => match pg_numeric(s) {
      Some(v) => Some(v)
      None => Err(bad_text(name, "a numeric", s))
    }
    v => Err(mismatch(name, "a numeric", v))
  }
}

fn (r: Row) numeric(name: Str) -> sql.Numeric ! sql.SqlErr { r.numeric_opt(name)?.or_err(mismatch(name, "a numeric", sql.SqlValue.Null)) }

fn (r: Row) range_num_opt(name: Str) -> sql.Range[sql.Numeric]? ! sql.SqlErr { rg_read(r, name, "a numeric range", pg_numeric) }

fn (r: Row) range_num(name: Str) -> sql.Range[sql.Numeric] ! sql.SqlErr { r.range_num_opt(name)?.or_err(mismatch(name, "a numeric range", sql.SqlValue.Null)) }

fn (r: Row) multirange_num_opt(name: Str) -> List[sql.Range[sql.Numeric]]? ! sql.SqlErr { mr_read(r, name, "a numeric multirange", pg_numeric) }

fn (r: Row) multirange_num(name: Str) -> List[sql.Range[sql.Numeric]] ! sql.SqlErr { r.multirange_num_opt(name)?.or_err(mismatch(name, "a numeric multirange", sql.SqlValue.Null)) }

// Large objects: pgx v5.12.0 large_objects.go (LargeObjects.Create, Open,
// Unlink; LargeObject.Write, Read, Seek, Tell, Truncate, Close),
// Copyright (c) 2013-2021 Jack Christensen, MIT License.

/// pgx's maxLargeObjectMessageLength.
const LO_CHUNK: Int = 1024 * 1024 * 1024 - 1024

/// The one column of a `select lo_...(...)` row as an Int.
fn lo_int(t: Tx, q: Str, args: List[sql.SqlValue]) -> Int ! sql.SqlErr uses net.dial {
  let row = t.query_one(q, args)?
  row.int(row.columns()[0])
}

fn (t: Tx) lo_create(oid: Int = 0) -> Int ! sql.SqlErr uses net.dial { lo_int(t, "select lo_create($1)", [sql.SqlValue.Integer(n: oid)]) }

fn (t: Tx) lo_open(oid: Int, mode: sql.LoMode = sql.LoMode.ReadWrite) -> sql.LargeObject ! sql.SqlErr uses net.dial {
  let m = match mode {
    Read => 0x40000
    Write => 0x20000
    ReadWrite => 0x60000
  }
  sql.LargeObject{fd: lo_int(t, "select lo_open($1, $2)", [sql.SqlValue.Integer(n: oid), sql.SqlValue.Integer(n: m)])?}
}

fn (t: Tx) lo_unlink(oid: Int) -> () ! sql.SqlErr uses net.dial {
  if lo_int(t, "select lo_unlink($1)", [sql.SqlValue.Integer(n: oid)])? != 1 {
    return Err(sql.SqlErr.Driver(msg: "failed to remove large object"))
  }
}

fn (t: Tx) lo_write(o: sql.LargeObject, b: Bytes) -> Int ! sql.SqlErr uses net.dial {
  var total = 0
  while total < b.len() {
    let want = if b.len() - total < LO_CHUNK { b.len() - total } else { LO_CHUNK }
    let n = lo_int(t, "select lowrite($1, $2)", [sql.SqlValue.Integer(n: o.fd), sql.SqlValue.Blob(b: b[total..total + want])])?
    if n < 0 {
      return Err(sql.SqlErr.Driver(msg: "failed to write to large object"))
    }
    total += n
    if n < want {
      return Err(sql.SqlErr.Driver(msg: "short write to large object"))
    }
    if n > want {
      return Err(sql.SqlErr.Driver(msg: "invalid write to large object"))
    }
  }
  total
}

fn (t: Tx) lo_read(o: sql.LargeObject, n: Int) -> Bytes ! sql.SqlErr uses net.dial {
  var out = BytesBuilder.new()
  var total = 0
  while total < n {
    let want = if n - total < LO_CHUNK { n - total } else { LO_CHUNK }
    let row = t.query_one("select loread($1, $2)", [sql.SqlValue.Integer(n: o.fd), sql.SqlValue.Integer(n: want)])?
    let got = row.bytes(row.columns()[0])?
    out.write(got)
    total += got.len()
    if got.len() < want {
      break
    }
    if got.len() > want {
      return Err(sql.SqlErr.Driver(msg: "invalid read of large object"))
    }
  }
  out.freeze()
}

fn (t: Tx) lo_seek(o: sql.LargeObject, offset: Int, whence: Int = 0) -> Int ! sql.SqlErr uses net.dial {
  lo_int(t, "select lo_lseek64($1, $2, $3)", [sql.SqlValue.Integer(n: o.fd), sql.SqlValue.Integer(n: offset), sql.SqlValue.Integer(n: whence)])
}

fn (t: Tx) lo_tell(o: sql.LargeObject) -> Int ! sql.SqlErr uses net.dial { lo_int(t, "select lo_tell64($1)", [sql.SqlValue.Integer(n: o.fd)]) }

fn (t: Tx) lo_truncate(o: sql.LargeObject, size: Int) -> () ! sql.SqlErr uses net.dial {
  let _ = t.exec("select lo_truncate64($1, $2)", [sql.SqlValue.Integer(n: o.fd), sql.SqlValue.Integer(n: size)])?
}

fn (t: Tx) lo_close(o: sql.LargeObject) -> () ! sql.SqlErr uses net.dial {
  let _ = t.exec("select lo_close($1)", [sql.SqlValue.Integer(n: o.fd)])?
}

// Arrays' elements (decision 0679): pgx's array text format
// (pgtype/array.go parseUntypedTextArray) for one dimension, as
// std/native/llrt/pg.xo's parse_array reads it.

/// A one dimensional array literal's elements ({1,2,NULL}, {"a b",c}),
/// None (NULL) for an unquoted NULL; None for another shape.
fn arr_split(s: Str) -> List[Str?]? {
  let b = s.bytes()
  if b.len() < 2 || b[0] != 123 || b[b.len() - 1] != 125 {
    return None
  }
  var out: List[Str?] = []
  if b.len() == 2 {
    return Some(out)
  }
  var i = 1
  while i < b.len() - 1 {
    if b[i] == 123 {
      return None
    }
    var cur = BytesBuilder.new()
    var quoted = false
    if b[i] == 34 {
      quoted = true
      i += 1
      while i < b.len() - 1 && b[i] != 34 {
        if b[i] == 92 && i + 1 < b.len() {
          i += 1
        }
        cur.write_byte(b[i])
        i += 1
      }
      i += 1
    } else {
      while i < b.len() - 1 && b[i] != 44 {
        cur.write_byte(b[i])
        i += 1
      }
    }
    let t = cur.freeze().to_str() ?? ""
    out.push(if !quoted && t == "NULL" { None } else { Some(t) })
    if i < b.len() - 1 && b[i] == 44 {
      i += 1
    }
  }
  Some(out)
}

fn (r: Row) elements_opt(name: Str) -> List[Row]? ! sql.SqlErr {
  let xs = match r.get(name)? {
    Null => return None
    Array(xs) => xs
    Text(s) => match arr_split(s) {
      Some(ts) => ts.map(fn(t) { match t {
        Some(x) => sql.SqlValue.Text(s: x)
        None => sql.SqlValue.Null
      } })
      None => return Err(mismatch(name, "a one dimensional array", sql.SqlValue.Text(s: s)))
    }
    v => return Err(mismatch(name, "an array", v))
  }
  Some(xs.map(fn(x) { Row{cols: [name], vals: [x]} }))
}

fn (r: Row) elements(name: Str) -> List[Row] ! sql.SqlErr { r.elements_opt(name)?.or_err(mismatch(name, "an array", sql.SqlValue.Null)) }

// Numeric's JSON form (decision 0681, the lead 2026-11-16): pgx's
// MarshalJSON and UnmarshalJSON for finite values through json.Number.

fn numeric_json(n: sql.Numeric) -> js.Number { js.Number{text: n.display()} }

fn numeric_of_json(j: js.Number) -> sql.Numeric ! sql.SqlErr { sql.parse_numeric(j.text) }
