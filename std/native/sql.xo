// std/sql on the native backends (decision 0083): the in memory driver of
// std/rt/sqlmem.go and the Db, Tx, and Row of std/rt/sql.go, ported to Xo
// with the same statements, results, and error texts. Tables are values:
// a statement works on a copy of the table map (shared until written, so
// a copy is cheap) and publishes it only when it succeeds; a transaction
// is its own copy, published by commit. The database is a Mutex; the
// single writer permit of transactions is a channel holding one token.
//
// Not ported: the pool bound of max_open (the in memory driver runs one
// statement at a time, so it never waits on it) and drivers registered
// from Go (`sql.open` reports an unknown driver, as std/rt does when none
// is registered).
use std/json as js
use std/sql
use std/task
use native/rt
use native/rtsql
use native/llrt/raw
use native/llrt/sysio
use native/llrt/pg

/// The Display of SqlErr (decision 0358); std/rt/sqltext.go prints the same.
fn sqlerr_display(e: sql.SqlErr) -> Str {
  match e {
    Syntax(msg) => "syntax error: ${msg}"
    Constraint(msg, _, _) => msg
    Param(msg) => msg
    NoTable(name) => "no such table: ${name}"
    NoRows => "no rows in result set"
    NoColumn(name) => "no such column: ${name}"
    Mismatch(column, msg) => "column ${column}: ${msg}"
    Conn(msg) => "connection: ${msg}"
    Driver(msg) => msg
    Server(code, msg) => "${msg} (SQLSTATE ${code})"
    TxDone => "transaction already committed or rolled back"
    Closed => "database is closed"
    Canceled => "canceled"
  }
}

// ---------------------------------------------------------------------------
// Handles

struct Db[fx: Effects] {
  st: Mutex[Store]
  /// One token: the permit of the single open transaction.
  writer: Chan[Bool]
  closed: Atomic[Bool]
  /// The connections of a driver (open_driver); None for the in memory one.
  pool: Pool[fx]? = None
}

// ---------------------------------------------------------------------------
// The pool of a driver (decision 0278): max_open permits, idle connections

struct Pool[fx: Effects] {
  net: Net
  drv: sql.Driver[fx]
  dsn: Str
  /// max_open tokens: one per operation in flight and open transaction.
  permits: Chan[Bool]
  idle: Mutex[List[Idle[fx]]]
  max_idle: Int
  /// Nanoseconds; 0 for none.
  max_lifetime: Int
}

/// The pool's clock for connection ages: the monotonic clock, except in
/// a WASI module (sysio.layer() 0), whose runtime keeps the monotonic
/// clock to itself (compiler/wasm rt3.xo $mono): there the wall clock
/// (sysio.real_ns, WASI clock_time_get), since mono_ns's Linux and macOS
/// calls do not exist in wasm.
fn pool_now() -> Int {
  if sysio.layer() == 0 {
    return sysio.real_ns()
  }
  sysio.mono_ns()
}

struct Idle[fx: Effects] {
  c: sql.DriverConn[fx]
  /// When it was connected (pool_now).
  born: Int
}

/// A connection taken from the pool, with when it was connected.
struct Taken[fx: Effects] {
  c: sql.DriverConn[fx]
  born: Int
}

fn (p: Pool) take() -> Taken ! sql.SqlErr uses net.dial {
  // waiting for a permit is a cancellation point
  if p.permits.recv() is None {
    return Err(sql.SqlErr.Canceled)
  }
  let now = pool_now()
  while {
    let got = p.idle.with(fn(var xs) { xs.pop() })
    match got {
      Some(x) => {
        if p.max_lifetime > 0 && now - x.born >= p.max_lifetime {
          x.c.close()
          continue
        }
        return Taken{c: x.c, born: x.born}
      }
      None => break
    }
  }
  match p.drv.connect(p.net, p.dsn) {
    Ok(c) => Taken{c: c, born: now}
    Err(e) => {
      p.permits.send(true)
      Err(e)
    }
  }
}

/// Gives t back: kept idle while it works, has room, and is young enough,
/// else closed; then the permit.
fn give[fx: Effects](p: Pool[fx], t: Taken[fx]) uses (net.dial, fx) {
  let keep = !t.c.is_broken() && (p.max_lifetime == 0 || pool_now() - t.born < p.max_lifetime)
  let kept = keep && p.idle.with(fn(var xs) -> Bool {
    if xs.len() >= p.max_idle {
      return false
    }
    xs.push(Idle{c: t.c, born: t.born})
    true
  })
  if !kept {
    t.c.close()
  }
  p.permits.send(true)
}

fn (p: Pool) query(q: Str, args: List[sql.SqlValue]) -> List[Row] ! sql.SqlErr uses net.dial {
  let t = p.take()?
  let r = t.c.query(q, args)
  let all = match r {
    Ok(x) => drain_rows(x)
    Err(e) => Err(e)
  }
  give(p, t)
  let rows = all?
  to_rows(rows.columns, rows.column_types, rows.rows)
}

/// x with its cursor, if any, read to the end into rows (Db.query reads a
/// result whole; Db.rows reads it as asked).
fn drain_rows(x: sql.DriverRows) -> sql.DriverRows ! sql.SqlErr uses net.dial {
  match x.cursor {
    Some(c) => {
      let more = c.rest()?
      if x.rows.is_empty() {
        return sql.DriverRows{columns: x.columns, rows: more, column_types: x.column_types}
      }
      var all = x.rows
      for r in more {
        all.push(r)
      }
      sql.DriverRows{columns: x.columns, rows: all, column_types: x.column_types}
    }
    None => x
  }
}

fn (p: Pool) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  let t = p.take()?
  let r = t.c.exec(q, args)
  give(p, t)
  r
}

fn (p: Pool) ping() -> () ! sql.SqlErr uses net.dial {
  let t = p.take()?
  let r = t.c.ping()
  give(p, t)
  r
}

fn (p: Pool) close_idle() {
  let xs = p.idle.with(fn(var xs) {
    let all = xs
    xs = []
    all
  })
  for x in xs {
    x.c.close()
  }
}

fn open_driver(net: Net, d: sql.Driver, dsn: Str, max_open: Int = 10, max_idle: Int = 2, max_lifetime: Duration = 30m) -> Db ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if max_open < 1 {
    return Err(sql.SqlErr.Param(msg: "max_open must be at least 1"))
  }
  let permits: Chan[Bool] = Chan.new(cap: max_open)
  for _ in 0..max_open {
    permits.send(true)
  }
  let p = Pool{net: net, drv: d, dsn: dsn, permits: permits, idle: Mutex.new([]), max_idle: max_idle.max(0), max_lifetime: max_lifetime.nanos().max(0)}
  // connect once now, so a wrong password or host fails at open
  p.ping()?
  let db = new_db({})
  db with {pool: Some(p)}
}

struct Store {
  tables: Map[Str, Table]
}

struct Tx[fx: Effects] {
  st: Mutex[TxState]
  db: Db[fx]
  /// A transaction of a driver: its connection, held from begin to its end.
  conn: Taken[fx]? = None
}

struct TxState {
  tables: Map[Str, Table]
  done: Bool
  read_only: Bool = false
}

struct Row {
  cols: List[Str]
  vals: List[sql.SqlValue]
  /// the result's column types (decision 0609; empty: the driver did not say)
  types: List[sql.ColumnType] = []
}

fn null() -> sql.SqlValue { sql.SqlValue.Null }

fn int(n: Int) -> sql.SqlValue { sql.SqlValue.Integer(n: n) }

fn str(s: Str) -> sql.SqlValue { sql.SqlValue.Text(s: s) }

fn float(f: Float) -> sql.SqlValue { sql.SqlValue.Real(f: f) }

fn bool(b: Bool) -> sql.SqlValue { sql.SqlValue.Flag(b: b) }

fn time(t: Time) -> sql.SqlValue { sql.SqlValue.At(t: t) }

fn bytes(b: Bytes) -> sql.SqlValue { sql.SqlValue.Blob(b: b) }

fn json[T: Json](v: T) -> sql.SqlValue { sql.SqlValue.JsonText(s: js.encode_str(v)) }

fn array(items: List[sql.SqlValue]) -> sql.SqlValue { sql.SqlValue.Array(items: items) }

fn new_db(tables: Map[Str, Table]) -> Db {
  let w: Chan[Bool] = Chan.new(cap: 1)
  w.send(true)
  Db{st: Mutex.new(Store{tables: tables}), writer: w, closed: Atomic.new(false)}
}

fn memory(schema: Str = "") -> Db ! sql.SqlErr {
  var tables: Map[Str, Table] = {}
  if !schema.trim().is_empty() {
    mem_exec(tables, schema, [])?
  }
  new_db(tables)
}

fn open(net: Net, driver: Str, dsn: Str, max_open: Int = 10, max_idle: Int = 2, max_lifetime: Duration = 30m, roots: Bytes = b"") -> Db ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if driver is "postgres" | "postgresql" {
    // the driver is Xo and dials through net, so Net.only applies (decision 0278)
    return open_driver(net, pg.PgDriver{roots: roots}, dsn, max_open: max_open, max_idle: max_idle, max_lifetime: max_lifetime)
  }
  if !rt.net_lists(net).is_empty() {
    // the driver dials by itself, so an allowlist cannot be enforced:
    // fail closed (decisions 0156 and 0175)
    return Err(sql.SqlErr.Conn(msg: "an attenuated Net (Net.only) cannot open a database: the driver dials by itself; pass an unattenuated Net"))
  }
  if max_open < 1 {
    return Err(sql.SqlErr.Param(msg: "max_open must be at least 1"))
  }
  Err(sql.SqlErr.Driver(msg: "unknown driver ${driver}"))
}

fn (d: Db) ready() -> () ! sql.SqlErr {
  if d.closed.get() {
    return Err(sql.SqlErr.Closed)
  }
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
}

fn to_rows(cols: List[Str], types: List[sql.ColumnType], rows: List[List[sql.SqlValue]]) -> List[Row] {
  var out: List[Row] = []
  for r in rows {
    out.push(Row{cols: cols, vals: r, types: types})
  }
  out
}

fn (d: Db) query(q: Str, args: List[sql.SqlValue] = []) -> List[Row] ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    return p.query(q, args)
  }
  // a failing statement leaves the tables as they were (decision 0528:
  // each statement checks everything before it changes anything)
  // (the outcome as the closure's success value: its writes are kept, and
  // a failed statement made none)
  let res = d.st.with(fn(var st) -> Result[MemRows, sql.SqlErr] { mem_run(st.tables, q, args) })?
  to_rows(res.cols, res.types, res.rows)
}

fn (d: Db) query_one(q: Str, args: List[sql.SqlValue] = []) -> Row ! sql.SqlErr uses net.dial {
  let rows = d.query(q, args)?
  if rows.is_empty() {
    return Err(sql.SqlErr.NoRows)
  }
  rows[0]
}

fn (d: Db) exec(q: Str, args: List[sql.SqlValue] = []) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    return p.exec(q, args)
  }
  d.st.with(fn(var st) -> Result[sql.ExecResult, sql.SqlErr] { mem_exec(st.tables, q, args) })?
}

fn (d: Db) query_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> List[T] ! sql.SqlErr uses net.dial {
  decode_all(d.query(q, args)?)
}

fn (d: Db) query_one_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> T ! sql.SqlErr uses net.dial {
  d.query_one(q, args)?.decode[T]()
}

fn decode_all[T: SqlRow](rows: List[Row]) -> List[T] ! sql.SqlErr {
  var out: List[T] = []
  for r in rows {
    out.push(r.decode[T]()?)
  }
  out
}

fn (d: Db) ping() -> () ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    return p.ping()
  }
}

fn (d: Db) close() -> () ! sql.SqlErr {
  d.closed.set(true)
  if let Some(p) = d.pool {
    p.close_idle()
  }
}

fn (d: Db) begin(isolation: sql.Isolation = sql.Isolation.Default, read_only: Bool = false) -> Tx ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    // the transaction holds its permit and connection until it ends
    let t = p.take()?
    if let Err(e) = t.c.begin() {
      give(p, t)
      return Err(e)
    }
    if let Some(mode) = tx_mode(isolation, read_only) {
      if let Err(e) = t.c.exec(mode, []) {
        let _ = t.c.rollback().ignore_err("the SET TRANSACTION error is the one to report")
        give(p, t)
        return Err(e)
      }
    }
    return Tx{st: Mutex.new(TxState{tables: {}, done: false}), db: d, conn: Some(t)}
  }
  // the single writer permit; waiting is a cancellation point
  if d.writer.recv() is None {
    return Err(sql.SqlErr.Canceled)
  }
  let tables = d.st.with_read(fn(st) { st.tables })
  Tx{st: Mutex.new(TxState{tables: tables, done: false, read_only: read_only}), db: d}
}

/// The statement that sets a driver transaction's options after BEGIN
/// (pgx's stdlib puts the same modes in its BEGIN); None for the defaults.
fn tx_mode(isolation: sql.Isolation, read_only: Bool) -> Str? {
  var modes: List[Str] = []
  match isolation {
    Default => {}
    ReadUncommitted => modes.push("ISOLATION LEVEL READ UNCOMMITTED")
    ReadCommitted => modes.push("ISOLATION LEVEL READ COMMITTED")
    RepeatableRead => modes.push("ISOLATION LEVEL REPEATABLE READ")
    Serializable => modes.push("ISOLATION LEVEL SERIALIZABLE")
  }
  if read_only {
    modes.push("READ ONLY")
  }
  if modes.is_empty() {
    return None
  }
  Some("SET TRANSACTION ${modes.join(", ")}")
}

/// Postgres's refusal of a write in a read only transaction, for the in
/// memory database: every statement but a SELECT writes there.
fn read_only_refusal(q: Str) -> sql.SqlErr? {
  let t = q.trim()
  let word = t[0..(t.find(" ") ?? t.len())].to_upper()
  if word == "SELECT" {
    return None
  }
  Some(sql.SqlErr.Server(code: "25006", msg: "cannot execute ${word} in a read-only transaction"))
}

fn (t: Tx) query(q: Str, args: List[sql.SqlValue] = []) -> List[Row] ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    let rows = t.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
      if ts.done {
        return Err(sql.SqlErr.TxDone)
      }
      drain_rows(tc.c.query(q, args)?)
    })?
    return to_rows(rows.columns, rows.column_types, rows.rows)
  }
  let res = t.st.with(fn(var ts) -> MemRows ! sql.SqlErr {
    if ts.done {
      return Err(sql.SqlErr.TxDone)
    }
    var work = ts.tables
    let r = mem_run(work, q, args)?
    ts.tables = work
    r
  })?
  to_rows(res.cols, res.types, res.rows)
}

fn (t: Tx) query_one(q: Str, args: List[sql.SqlValue] = []) -> Row ! sql.SqlErr uses net.dial {
  let rows = t.query(q, args)?
  if rows.is_empty() {
    return Err(sql.SqlErr.NoRows)
  }
  rows[0]
}

fn (t: Tx) exec(q: Str, args: List[sql.SqlValue] = []) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    return t.st.with(fn(var ts) -> sql.ExecResult ! sql.SqlErr {
      if ts.done {
        return Err(sql.SqlErr.TxDone)
      }
      tc.c.exec(q, args)
    })
  }
  t.st.with(fn(var ts) -> sql.ExecResult ! sql.SqlErr {
    if ts.done {
      return Err(sql.SqlErr.TxDone)
    }
    if ts.read_only {
      if let Some(e) = read_only_refusal(q) {
        return Err(e)
      }
    }
    // a failed statement leaves the transaction as it was
    var work = ts.tables
    let r = mem_exec(work, q, args)?
    ts.tables = work
    r
  })
}

fn (t: Tx) query_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> List[T] ! sql.SqlErr uses net.dial {
  decode_all(t.query(q, args)?)
}

fn (t: Tx) query_one_as[T: SqlRow](q: Str, args: List[sql.SqlValue] = []) -> T ! sql.SqlErr uses net.dial {
  t.query_one(q, args)?.decode[T]()
}

/// Marks the transaction done and tells whether it already was. The driver's
/// commit or rollback runs after this, outside the mutex section: an Err
/// returned from a Mutex.with closure undoes the closure's writes (core
/// 5.4), which would un-mark `done` while the connection is back in the pool.
fn finish_once(t: Tx) -> Bool {
  t.st.with(fn(var ts) -> Bool {
    let was = ts.done
    ts.done = true
    was
  })
}

fn (t: Tx) commit() -> () ! sql.SqlErr uses net.dial {
  let db = t.db
  if let Some(tc) = t.conn {
    if finish_once(t) {
      return Err(sql.SqlErr.TxDone)
    }
    let r = tc.c.commit()
    give(db.pool.or_fault("a driver's transaction has a pool"), tc)
    return r
  }
  t.st.with(fn(var ts) -> () ! sql.SqlErr {
    if ts.done {
      return Err(sql.SqlErr.TxDone)
    }
    ts.done = true
    let tables = ts.tables
    db.st.with(fn(var st) { st.tables = tables })
    db.writer.send(true)
  })
}

fn (t: Tx) rollback() -> () ! sql.SqlErr uses net.dial {
  let db = t.db
  if let Some(tc) = t.conn {
    if finish_once(t) {
      return Ok(())
    }
    let r = tc.c.rollback()
    give(db.pool.or_fault("a driver's transaction has a pool"), tc)
    return r
  }
  t.st.with(fn(var ts) {
    if !ts.done {
      ts.done = true
      db.writer.send(true)
    }
  })
}

// ---------------------------------------------------------------------------
// Row

/// A result read as asked (decision 0479): the rows already in hand, the
/// driver's cursor for the rest, and the pool connection held until the end.
struct Rows[fx: Effects] {
  cols: List[Str]
  st: Mutex[RowsState[fx]]
  types: List[sql.ColumnType] = []
}

struct RowsState[fx: Effects] {
  buf: List[List[sql.SqlValue]]
  pos: Int
  cursor: sql.DriverCursor[fx]? = None
  /// The pool connection of a Db.rows, given back at the end.
  held: Taken[fx]? = None
  pool: Pool[fx]? = None
  done: Bool = false
}

fn new_rows(cols: List[Str], types: List[sql.ColumnType], s: RowsState) -> Rows {
  Rows{cols: cols, st: Mutex.new(s), types: types}
}

/// types, or `ColumnType{name}` per column when the driver gave none
/// (decision 0609).
fn column_types_of(cols: List[Str], types: List[sql.ColumnType]) -> List[sql.ColumnType] {
  if types.len() == cols.len() {
    return types
  }
  cols.map(fn(c) { sql.ColumnType{name: c} })
}

/// The end of a cursor: the connection goes back to the pool.
fn rows_finish(var s: RowsState) {
  s.done = true
  s.cursor = None
  s.buf = []
  if let Some(t) = s.held {
    if let Some(p) = s.pool {
      give(p, t)
    }
  }
  s.held = None
}

/// The Rows of x taken from the pool connection t: a result with no
/// cursor is whole, so the connection goes back at once.
fn pool_rows[fx: Effects](p: Pool[fx], t: Taken[fx], x: sql.DriverRows[fx]) -> Rows[fx] uses (net.dial, fx) {
  if x.cursor is None {
    give(p, t)
    return new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0})
  }
  new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0, cursor: x.cursor, held: Some(t), pool: Some(p)})
}

fn (d: Db) rows(q: Str, args: List[sql.SqlValue] = []) -> Rows ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    let t = p.take()?
    match t.c.query(q, args) {
      Ok(x) => return pool_rows(p, t, x)
      Err(e) => {
        give(p, t)
        return Err(e)
      }
    }
  }
  // a failing statement leaves the tables as they were (decision 0528:
  // each statement checks everything before it changes anything)
  // (the outcome as the closure's success value: its writes are kept, and
  // a failed statement made none)
  let res = d.st.with(fn(var st) -> Result[MemRows, sql.SqlErr] { mem_run(st.tables, q, args) })?
  new_rows(res.cols, res.types, RowsState{buf: res.rows, pos: 0})
}

fn (t: Tx) rows(q: Str, args: List[sql.SqlValue] = []) -> Rows ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    let x = t.st.with(fn(var ts) -> sql.DriverRows ! sql.SqlErr {
      if ts.done {
        return Err(sql.SqlErr.TxDone)
      }
      tc.c.query(q, args)
    })?
    return new_rows(x.columns, x.column_types, RowsState{buf: x.rows, pos: 0, cursor: x.cursor})
  }
  let res = t.st.with(fn(var ts) -> MemRows ! sql.SqlErr {
    if ts.done {
      return Err(sql.SqlErr.TxDone)
    }
    var work = ts.tables
    let r = mem_run(work, q, args)?
    ts.tables = work
    r
  })?
  new_rows(res.cols, res.types, RowsState{buf: res.rows, pos: 0})
}

fn quote_ident(name: Str) -> Str { "\"" + name.replace("\"", "\"\"") + "\"" }

/// The INSERT of one COPY row on the in memory database.
fn copy_insert_sql(table: Str, columns: List[Str]) -> Str {
  var ph: List[Str] = []
  for i in 0..columns.len() {
    ph.push("$${i + 1}")
  }
  if columns.is_empty() {
    return "INSERT INTO ${table} VALUES"
  }
  "INSERT INTO ${table} (${columns.join(", ")}) VALUES (${ph.join(", ")})"
}

fn (d: Db) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr) -> Int ! sql.SqlErr uses net.dial {
  d.ready()?
  if let Some(p) = d.pool {
    let t = p.take()?
    let r = t.c.copy_from(table, columns, rows)
    give(p, t)
    return r
  }
  mem_copy(fn(q, args) { d.exec(q, args) }, table, columns, rows)
}

fn (t: Tx) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr) -> Int ! sql.SqlErr uses net.dial {
  if task.is_canceled() {
    return Err(sql.SqlErr.Canceled)
  }
  if let Some(tc) = t.conn {
    return t.st.with(fn(var ts) -> Int ! sql.SqlErr {
      if ts.done {
        return Err(sql.SqlErr.TxDone)
      }
      tc.c.copy_from(table, columns, rows)
    })
  }
  mem_copy(fn(q, args) { t.exec(q, args) }, table, columns, rows)
}

/// COPY on the in memory database: an INSERT per row. The rows copied
/// before an error from rows stay, as the in memory driver has no COPY to
/// roll back (use a transaction).
fn mem_copy[fx: Effects](ins: fn(Str, List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses fx, table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr) -> Int ! sql.SqlErr uses fx {
  let q = copy_insert_sql(table, columns)
  var n = 0
  while {
    match rows()? {
      Some(r) => {
        ins(q, r)?
        n += 1
      }
      None => break
    }
  }
  n
}

fn (r: Rows) columns() -> List[Str] { r.cols }

fn (r: Rows) column_types() -> List[sql.ColumnType] { column_types_of(r.cols, r.types) }

fn (r: Rows) next() -> Row? ! sql.SqlErr uses net.dial {
  // the closure always returns Ok: an Err would undo rows_finish (a
  // Mutex.with closure's changes are kept only when it returns Ok)
  let (row, err) = r.st.with(fn(var s) -> (Row?, sql.SqlErr?) {
    if s.done {
      return (None, None)
    }
    if s.pos < s.buf.len() {
      let v = s.buf[s.pos]
      s.pos += 1
      return (Some(Row{cols: r.cols, vals: v, types: r.types}), None)
    }
    match s.cursor {
      Some(c) => {
        match c.next() {
          Ok(o) => {
            match o {
              Some(v) => (Some(Row{cols: r.cols, vals: v, types: r.types}), None)
              None => {
                rows_finish(s)
                (None, None)
              }
            }
          }
          Err(e) => {
            rows_finish(s)
            (None, Some(e))
          }
        }
      }
      None => {
        rows_finish(s)
        (None, None)
      }
    }
  })
  if let Some(e) = err {
    return Err(e)
  }
  row
}

fn (r: Rows) next_as[T: SqlRow]() -> T? ! sql.SqlErr uses net.dial {
  match r.next()? {
    Some(row) => Some(row.decode[T]()?)
    None => None
  }
}

fn (r: Rows) close() uses net.dial {
  r.st.with(fn(var s) {
    if s.done {
      return
    }
    if let Some(c) = s.cursor {
      c.close()
    }
    rows_finish(s)
  })
}

fn rows_each(rs: Rows, f: fn(Row) -> () ! sql.SqlErr) -> () ! sql.SqlErr uses net.dial {
  while true {
    match rs.next() {
      Ok(o) => {
        match o {
          Some(row) => {
            match f(row) {
              Ok(_) => {}
              Err(e) => {
                rs.close()
                return Err(e)
              }
            }
          }
          None => return
        }
      }
      Err(e) => {
        rs.close()
        return Err(e)
      }
    }
  }
}

fn (d: Db) each(q: Str, args: List[sql.SqlValue], f: fn(Row) -> () ! sql.SqlErr) -> () ! sql.SqlErr uses net.dial {
  rows_each(d.rows(q, args)?, f)
}

fn (t: Tx) each(q: Str, args: List[sql.SqlValue], f: fn(Row) -> () ! sql.SqlErr) -> () ! sql.SqlErr uses net.dial {
  rows_each(t.rows(q, args)?, f)
}

fn (r: Row) columns() -> List[Str] { r.cols }

fn (r: Row) column_types() -> List[sql.ColumnType] { column_types_of(r.cols, r.types) }

fn (r: Row) decode[T: SqlRow]() -> T ! sql.SqlErr { rtsql.sql_decode[T, Row](r) }

fn (r: Row) get(name: Str) -> sql.SqlValue ! sql.SqlErr {
  for (i, c) in r.cols.indexed() {
    if c == name {
      return r.vals[i]
    }
  }
  Err(sql.SqlErr.NoColumn(name: name))
}

/// The Debug text: `Row(a: 1, b: "x", c: null)`, each column and its
/// value as std/rt's XoDebug writes them.
fn row_debug(r: Row) -> Str {
  var b = StrBuilder.new()
  b.write("Row(")
  for (i, c) in r.cols.indexed() {
    if i > 0 {
      b.write(", ")
    }
    b.write("${c}: ${value_debug_text(r.vals[i])}")
  }
  b.write(")")
  b.freeze()
}

/// v's Debug text in a row: NULL is `null`, an array its items in brackets.
fn value_debug_text(v: sql.SqlValue) -> Str {
  match v {
    Null => "null"
    Integer(n) => n.debug()
    Text(s) => s.debug()
    Real(x) => x.debug()
    Flag(x) => x.debug()
    At(t) => t.debug()
    Blob(x) => x.debug()
    JsonText(s) => s.debug()
    Array(xs) => "[${xs.map(value_debug_text).join(", ")}]"
  }
}

fn type_name(v: sql.SqlValue) -> Str {
  match v {
    Integer(_) => "an integer"
    Text(_) => "text"
    Real(_) => "a float"
    Flag(_) => "a boolean"
    At(_) => "a time"
    Blob(_) => "bytes"
    JsonText(_) => "json"
    Array(_) => "an array"
    Null => "a value"
  }
}

fn mismatch(name: Str, want: Str, v: sql.SqlValue) -> sql.SqlErr {
  let got = if v is Null { "NULL" } else { type_name(v) }
  sql.SqlErr.Mismatch(column: name, msg: "expected ${want}, found ${got}")
}

fn (r: Row) value(name: Str) -> sql.SqlValue ! sql.SqlErr { r.get(name) }

fn (r: Row) is_null(name: Str) -> Bool ! sql.SqlErr { r.get(name)? is Null }

fn (r: Row) int(name: Str) -> Int ! sql.SqlErr {
  match r.get(name)? {
    Integer(n) => n
    v => Err(mismatch(name, "an integer", v))
  }
}

/// A date's text (2026-10-20, Postgres in ISO DateStyle) as its midnight in UTC.
fn date_time(s: Str) -> Time? {
  let b = s.bytes()
  if b.len() != 10 || b[4] != 45 || b[7] != 45 {
    return None
  }
  Time.parse_rfc3339(s + "T00:00:00Z")
}

fn (r: Row) str(name: Str) -> Str ! sql.SqlErr {
  match r.get(name)? {
    Text(s) => s
    JsonText(s) => s
    v => Err(mismatch(name, "text", v))
  }
}

fn (r: Row) float(name: Str) -> Float ! sql.SqlErr {
  match r.get(name)? {
    Real(f) => f
    Integer(n) => Float(n)
    Text(s) => match Float.parse(s) {
      Some(f) => f
      None => Err(mismatch(name, "a float", Text(s: s)))
    }
    v => Err(mismatch(name, "a float", v))
  }
}

fn (r: Row) bool(name: Str) -> Bool ! sql.SqlErr {
  match r.get(name)? {
    Flag(b) => b
    v => Err(mismatch(name, "a boolean", v))
  }
}

fn (r: Row) time(name: Str) -> Time ! sql.SqlErr {
  match r.get(name)? {
    At(t) => t
    Text(s) => match date_time(s) {
      Some(t) => t
      None => Err(mismatch(name, "a time", Text(s: s)))
    }
    v => Err(mismatch(name, "a time", v))
  }
}

fn (r: Row) int_opt(name: Str) -> Int? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Integer(n) => Some(n)
    v => Err(mismatch(name, "an integer", v))
  }
}

fn (r: Row) str_opt(name: Str) -> Str? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Text(s) => Some(s)
    JsonText(s) => Some(s)
    v => Err(mismatch(name, "text", v))
  }
}

fn (r: Row) float_opt(name: Str) -> Float? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Real(f) => Some(f)
    Integer(n) => Some(Float(n))
    Text(s) => match Float.parse(s) {
      Some(f) => Some(f)
      None => Err(mismatch(name, "a float", Text(s: s)))
    }
    v => Err(mismatch(name, "a float", v))
  }
}

fn (r: Row) bool_opt(name: Str) -> Bool? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Flag(b) => Some(b)
    v => Err(mismatch(name, "a boolean", v))
  }
}

fn (r: Row) time_opt(name: Str) -> Time? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    At(t) => Some(t)
    Text(s) => match date_time(s) {
      Some(t) => Some(t)
      None => Err(mismatch(name, "a time", Text(s: s)))
    }
    v => Err(mismatch(name, "a time", v))
  }
}

fn (r: Row) bytes(name: Str) -> Bytes ! sql.SqlErr {
  match r.get(name)? {
    Blob(b) => b
    v => Err(mismatch(name, "bytes", v))
  }
}

fn (r: Row) bytes_opt(name: Str) -> Bytes? ! sql.SqlErr {
  match r.get(name)? {
    Null => None
    Blob(b) => Some(b)
    v => Err(mismatch(name, "bytes", v))
  }
}

fn (r: Row) json[T: Json](name: Str) -> T ! sql.SqlErr {
  let text = match r.get(name)? {
    JsonText(s) => s
    Text(s) => s
    v => return Err(mismatch(name, "json", v))
  }
  js.decode_str[T](text).map_err(fn(e) { sql.SqlErr.Mismatch(column: name, msg: "${e}") })
}

fn (r: Row) items(name: Str) -> List[sql.SqlValue] ! sql.SqlErr {
  match r.get(name)? {
    Array(xs) => xs
    v => Err(mismatch(name, "an array", v))
  }
}

fn (r: Row) ints(name: Str) -> List[Int] ! sql.SqlErr {
  r.items(name)?.map(fn(x) -> Int ! sql.SqlErr {
    match x {
      Integer(n) => n
      v => Err(mismatch(name, "an array of integers", v))
    }
  })
}

fn (r: Row) strs(name: Str) -> List[Str] ! sql.SqlErr {
  r.items(name)?.map(fn(x) -> Str ! sql.SqlErr {
    match x {
      Text(t) => t
      v => Err(mismatch(name, "an array of text", v))
    }
  })
}

// ---------------------------------------------------------------------------
// Tables

// Column kinds (std/rt's 'i', 't', 'r', 'b', 'T').
const KI = 1
const KT = 2
const KR = 3
const KB = 4
const KTIME = 5
const KBLOB = 6
const KJSON = 7
/// An array of elem (`INT[]`, `TEXT[]`, decision 0278).
const KARR = 8

struct Col {
  name: Str
  kind: Int
  not_null: Bool = false
  unique: Bool = false
  pk: Bool = false
  auto: Bool = false
  def: sql.SqlValue = sql.SqlValue.Null
  /// The elements' kind of a KARR column.
  elem: Int = 0
  /// The type as declared, upper case ("INTEGER", "VARCHAR", "TEXT[]"):
  /// ColumnType.database_type (decision 0609).
  decl: Str = ""
  /// Whether a CREATE INDEX is on the column (its name in the table's
  /// Made.names, so a copy of a Col retains no name).
  has_index: Bool = false
}

struct Table {
  name: Str
  cols: List[Col]
  /// The rows in insertion order; a deleted row's slot is an empty row
  /// until the table is compacted (decision 0528).
  rows: List[List[sql.SqlValue]]
  next_id: Int
  /// The deleted slots in rows.
  dead: Int = 0
  /// The index of each indexed column (by position): its stored values'
  /// slots.
  idx: Map[Int, ColIdx] = {}
  /// The CREATE INDEX columns' indexes and names, None until the first
  /// (one field, so a table without one copies as before).
  made: Made? = None
}

/// A table's CREATE INDEX state.
struct Made {
  /// The indexes, apart from idx so a UNIQUE column's update builds no
  /// slot list maps.
  midx: Map[Int, ManyIdx] = {}
  /// The names by column.
  names: Map[Int, Str] = {}
}

/// Moves t's CREATE INDEX state out (made_put puts it back), so changing
/// its maps copies none.
fn made_take(var t: Table) -> Made {
  let m = t.made ?? Made{}
  t.made = None
  m
}

fn made_put(var t: Table, m: Made) {
  t.made = if m.names.is_empty() { None } else { Some(m) }
}

/// An equality index of a column (decision 0528), Integer and Text values
/// apart (NULL is not indexed): a UNIQUE column's each stored value's
/// slot, a CREATE INDEX column's each value's slots in ascending order (a
/// scan's).
struct ColIdx {
  ints: Map[Int, Int] = {}
  strs: Map[Str, Int] = {}
}

/// A CREATE INDEX column's index: each value's slots in ascending order.
struct ManyIdx {
  ints: Map[Int, List[Int]] = {}
  strs: Map[Str, List[Int]] = {}
}

/// Whether a column has an index: UNIQUE (SERIAL columns are) or a CREATE
/// INDEX on it, and INT or TEXT, whose stored values are only Integer or
/// Text, or NULL (coerce).
fn indexed(c: Col) -> Bool { (c.unique || c.has_index) && (c.kind == KI || c.kind == KT) }

/// Whether column c's index holds several slots per value (not UNIQUE).
fn many(c: Col) -> Bool { !c.unique }

/// Inserts slot s into the ascending list l.
fn slot_add(var l: List[Int], s: Int) {
  var i = l.len()
  while i > 0 && l[i - 1] > s {
    i -= 1
  }
  if i == l.len() {
    l.push(s)
  } else {
    l.insert(i, s)
  }
}

/// Takes slot s out of the ascending list l.
fn slot_del(var l: List[Int], s: Int) {
  var i = l.len()
  while i > 0 {
    i -= 1
    if l[i] == s {
      let _ = l.remove_at(i)
      return
    }
    if l[i] < s {
      return
    }
  }
}

/// Adds the row in slot to the table's indexes.
fn idx_put(var t: Table, slot: Int) {
  let row = t.rows[slot]
  for (ci, c) in t.cols.indexed() {
    if !indexed(c) {
      continue
    }
    let v = row[ci]
    if many(c) {
      midx_put(t, ci, v, slot)
      continue
    }
    t.idx.update(ci, ColIdx{}, fn(var x) {
      match v {
        Integer(n) => x.ints.put(n, slot)
        Text(z) => x.strs.put(z, slot)
        _ => {}
      }
    })
  }
}

/// The CREATE INDEX part of idx_put, apart so idx_put's UNIQUE path is
/// the one it was before CREATE INDEX.
fn midx_put(var t: Table, ci: Int, v: sql.SqlValue, slot: Int) {
  var mx = made_take(t)
  mx.midx.update(ci, ManyIdx{}, fn(var x) {
    match v {
      Integer(n) => {
        var l = x.ints.remove(n) ?? []
        slot_add(l, slot)
        x.ints.put(n, l)
      }
      Text(z) => {
        var l = x.strs.remove(z) ?? []
        slot_add(l, slot)
        x.strs.put(z, l)
      }
      _ => {}
    }
  })
  made_put(t, mx)
}

/// Takes the row in slot out of the table's indexes. A slot list is
/// removed, changed and put back, so it moves out of the map instead of
/// being copied (gotchas/with-body-cancelable-through-closure-call.md).
fn idx_drop(var t: Table, slot: Int) {
  let row = t.rows[slot]
  for (ci, c) in t.cols.indexed() {
    if !indexed(c) {
      continue
    }
    let v = row[ci]
    if many(c) {
      midx_drop(t, ci, v, slot)
      continue
    }
    t.idx.update(ci, ColIdx{}, fn(var x) {
      match v {
        Integer(n) => {
          let _ = x.ints.remove(n)
        }
        Text(z) => {
          let _ = x.strs.remove(z)
        }
        _ => {}
      }
    })
  }
}

/// The CREATE INDEX part of idx_drop, apart so idx_drop's UNIQUE path is
/// the one it was before CREATE INDEX.
fn midx_drop(var t: Table, ci: Int, v: sql.SqlValue, slot: Int) {
  var mx = made_take(t)
  mx.midx.update(ci, ManyIdx{}, fn(var x) {
    match v {
      Integer(n) => {
        var l = x.ints.remove(n) ?? []
        slot_del(l, slot)
        if !l.is_empty() {
          x.ints.put(n, l)
        }
      }
      Text(z) => {
        var l = x.strs.remove(z) ?? []
        slot_del(l, slot)
        if !l.is_empty() {
          x.strs.put(z, l)
        }
      }
      _ => {}
    }
  })
  made_put(t, mx)
}

/// The slots whose column ci holds v by the column's CREATE INDEX, in
/// ascending order.
fn idx_find_many(t: Table, ci: Int, v: sql.SqlValue) -> List[Int] {
  let m = t.made ?? return []
  let x = m.midx.get(ci) ?? return []
  match v {
    Integer(n) => x.ints.get(n) ?? []
    Text(z) => x.strs.get(z) ?? []
    _ => []
  }
}

/// The slot whose column ci holds v by the column's index, -1 when none.
fn idx_find(t: Table, ci: Int, v: sql.SqlValue) -> Int {
  let x = t.idx.get(ci) ?? return -1
  match v {
    Integer(n) => x.ints.get(n) ?? -1
    Text(z) => x.strs.get(z) ?? -1
    _ => -1
  }
}

/// Drops the deleted slots and rebuilds the indexes.
fn compact(var t: Table) {
  // a loop, not filter with a closure (a point that can be canceled; see
  // coerce)
  var kept: List[List[sql.SqlValue]] = List.with_capacity(t.rows.len() - t.dead)
  for row in t.rows {
    if !row.is_empty() {
      kept.push(row)
    }
  }
  t.rows = kept
  t.dead = 0
  t.idx = {}
  var mx = made_take(t)
  mx.midx = {}
  made_put(t, mx)
  for slot in 0..t.rows.len() {
    idx_put(t, slot)
  }
}

/// Whether w is equalities between a column and a value, joined by AND,
/// that evaluate without error on every row: each column exists and each
/// value is NULL or of the column's own type (an INT column holds only
/// Integer or NULL, a TEXT column only Text or NULL). Appends each
/// equality's column and value to out.
fn eq_leaves(t: Table, n: Node, args: List[sql.SqlValue], var out: List[(Int, sql.SqlValue)]) -> Bool {
  match n {
    Bin(op, l, r) => {
      if op == "and" {
        return eq_leaves(t, l, args, out) && eq_leaves(t, r, args, out)
      }
      if op != "=" {
        return false
      }
      let (c, x) = match (l, r) {
        (Col(c), x) => (c, x)
        (x, Col(c)) => (c, x)
        _ => return false
      }
      let v = match x {
        Lit(lv) => lv
        Param(i) => {
          if i < 1 || i > args.len() {
            return false
          }
          args[i - 1]
        }
        Col(_) | Count | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => return false
      }
      let ci = t.index(c)
      if ci < 0 {
        return false
      }
      let kind = t.cols[ci].kind
      let ok = match v {
        Null => true
        Integer(_) => kind == KI
        Text(_) => kind == KT
        _ => false
      }
      if ok {
        out.push((ci, v))
      }
      ok
    }
    _ => false
  }
}

/// The slots a WHERE can only be true on, by an indexed column's equality
/// (decision 0528), or None to scan every slot. The caller still evaluates
/// the whole WHERE on each, so the rows are the scan's; eq_leaves makes
/// sure the scan could not have failed on a row this skips.
fn candidates(t: Table, w: Node?, args: List[sql.SqlValue]) -> List[Int]? {
  let n = w ?? return None
  var leaves: List[(Int, sql.SqlValue)] = []
  if !eq_leaves(t, n, args, leaves) {
    return None
  }
  // a UNIQUE column's one slot first, then a CREATE INDEX column's
  for (ci, v) in leaves {
    if indexed(t.cols[ci]) && !many(t.cols[ci]) {
      if v is Null {
        // `= NULL` is never true
        return Some([])
      }
      let s = idx_find(t, ci, v)
      return Some(if s >= 0 { [s] } else { [] })
    }
  }
  for (ci, v) in leaves {
    if indexed(t.cols[ci]) {
      if v is Null {
        return Some([])
      }
      let ss = idx_find_many(t, ci, v)
      // a value most rows hold: scanning in place costs less than
      // visiting through the slot list (stability/notes with one owner,
      // 2026-11-06: the index's sat64 was 0.82 of the scan's)
      if ss.len() * 4 > t.rows.len() - t.dead {
        return None
      }
      return Some(ss)
    }
  }
  None
}

/// The slot of the k-th row to visit: a candidate's, or k when scanning.
fn slot_at(cand: List[Int]?, k: Int) -> Int {
  match cand {
    Some(ss) => ss[k]
    None => k
  }
}

fn slots_len(t: Table, cand: List[Int]?) -> Int {
  match cand {
    Some(ss) => ss.len()
    None => t.rows.len()
  }
}

fn (t: Table) index(name: Str) -> Int {
  for (i, c) in t.cols.indexed() {
    if c.name == name {
      return i
    }
  }
  -1
}

/// The rows of a query.
struct MemRows {
  cols: List[Str]
  rows: List[List[sql.SqlValue]]
  /// each column's type: a table column's declared type and NOT NULL
  /// (decision 0609)
  types: List[sql.ColumnType] = []
}

// ---------------------------------------------------------------------------
// Lexer

const T_EOF = 0
const T_IDENT = 1
const T_INT = 2
const T_FLOAT = 3
const T_STR = 4
const T_PARAM = 5
const T_SYM = 6

struct Tok {
  k: Int
  s: Str = ""
  i: Int = 0
  f: Float = 0.0
}

fn syntax(msg: Str) -> sql.SqlErr { sql.SqlErr.Syntax(msg: msg) }

/// The rune at byte i of b and its size.
fn rune_at(b: Bytes, i: Int) -> (Rune, Int) {
  let p = raw.bytes_decode(b, i)
  (Rune(p >> 3), p & 7)
}

fn is_ident_rune(c: Rune) -> Bool { c.is_letter() || c.is_digit() || c == '_' }

fn lex(q: Str) -> List[Tok] ! sql.SqlErr {
  let b = q.bytes()
  let n = b.len()
  var out: List[Tok] = []
  var i = 0
  while i < n {
    let (c, size) = rune_at(b, i)
    if c.is_space() {
      i += size
    } else if c == '-' && i + 1 < n && b[i + 1] == 45 {
      while i < n && b[i] != 10 {
        i += 1
      }
    } else if c.is_letter() || c == '_' {
      var j = i
      while j < n {
        // ASCII without decoding: a statement's names and keywords are
        // (the decode and is_ident_rune call cost 2% of an INSERT when
        // the inliner left it out of lex, 2026-11-06)
        let x = b[j]
        if x < 128 {
          if !((x >= 97 && x <= 122) || (x >= 65 && x <= 90) || (x >= 48 && x <= 57) || x == 95) {
            break
          }
          j += 1
          continue
        }
        let (d, ds) = rune_at(b, j)
        if !is_ident_rune(d) {
          break
        }
        j += ds
      }
      out.push(Tok{k: T_IDENT, s: q[i..j].to_lower()})
      i = j
    } else if c.is_digit() {
      var j = i
      var is_f = false
      while j < n {
        let (d, ds) = rune_at(b, j)
        if !(d.is_digit() || (d == '.' && !is_f)) {
          break
        }
        if d == '.' {
          is_f = true
        }
        j += ds
      }
      let s = q[i..j]
      if is_f {
        match Float.parse(s) {
          Some(f) => out.push(Tok{k: T_FLOAT, f: f})
          None => return Err(syntax("bad number ${s.quote()}"))
        }
      } else {
        match Int.parse(s) {
          Some(v) => out.push(Tok{k: T_INT, i: v})
          None => return Err(syntax("bad number ${s.quote()}"))
        }
      }
      i = j
    } else if c == '\'' {
      var sb = ""
      var j = i + 1
      var closed = false
      var start = j
      while j < n {
        if b[j] == 39 {
          if j + 1 < n && b[j + 1] == 39 {
            sb = sb + q[start..j + 1]
            j += 2
            start = j
            continue
          }
          sb = sb + q[start..j]
          closed = true
          j += 1
          break
        }
        j += rune_at(b, j).1
      }
      if !closed {
        return Err(syntax("unterminated string"))
      }
      out.push(Tok{k: T_STR, s: sb})
      i = j
    } else if c == '$' {
      var j = i + 1
      while j < n {
        let (d, ds) = rune_at(b, j)
        if !d.is_digit() {
          break
        }
        j += ds
      }
      match Int.parse(q[i + 1..j]) {
        Some(v) => {
          if v < 1 {
            return Err(syntax("bad placeholder"))
          }
          out.push(Tok{k: T_PARAM, i: v})
        }
        None => return Err(syntax("bad placeholder"))
      }
      i = j
    } else {
      if i + 1 < n {
        let two = raw.str_slice(q, i, i + 2)
        if two == "<=" || two == ">=" || two == "<>" || two == "!=" {
          out.push(Tok{k: T_SYM, s: two})
          i += 2
          continue
        }
      }
      let one = q[i..i + size]
      if "(),*=<>;.+-/[]".contains(one) {
        out.push(Tok{k: T_SYM, s: one})
        i += size
        continue
      }
      return Err(syntax("unexpected character ${one.quote()}"))
    }
  }
  out.push(Tok{k: T_EOF})
  out
}

fn split_statements(toks: List[Tok]) -> List[List[Tok]] {
  var out: List[List[Tok]] = []
  var cur: List[Tok] = []
  for t in toks {
    if t.k == T_EOF {
      break
    }
    if t.k == T_SYM && t.s == ";" {
      if !cur.is_empty() {
        cur.push(Tok{k: T_EOF})
        out.push(cur)
      }
      cur = []
      continue
    }
    cur.push(t)
  }
  if !cur.is_empty() {
    cur.push(Tok{k: T_EOF})
    out.push(cur)
  }
  out
}

// ---------------------------------------------------------------------------
// Parser

enum Node {
  Lit(v: sql.SqlValue)
  Param(n: Int)
  Col(name: Str)
  Count
  Bin(op: Str, l: Node, r: Node)
  Not(x: Node)
  IsNull(x: Node, neg: Bool)
  InList(x: Node, items: List[Node])
  Like(l: Node, r: Node)
}

struct Parser {
  toks: List[Tok]
  i: Int = 0
  max_param: Int = 0
}

fn (p: Parser) peek() -> Tok { p.toks[p.i] }

fn (var p: Parser) next() -> Tok {
  let t = p.toks[p.i]
  if t.k != T_EOF {
    p.i += 1
  }
  t
}

fn (p: Parser) is_kw(kw: Str) -> Bool {
  let t = p.peek()
  t.k == T_IDENT && t.s == kw
}

fn (p: Parser) is_sym(s: Str) -> Bool {
  let t = p.peek()
  t.k == T_SYM && t.s == s
}

fn (var p: Parser) accept_kw(kw: Str) -> Bool {
  if p.is_kw(kw) {
    p.i += 1
    return true
  }
  false
}

fn (var p: Parser) accept_sym(s: Str) -> Bool {
  if p.is_sym(s) {
    p.i += 1
    return true
  }
  false
}

fn (p: Parser) fail(what: Str) -> sql.SqlErr {
  let t = p.peek()
  var got = "end of input"
  if t.k == T_IDENT || t.k == T_SYM {
    got = t.s.quote()
  } else if t.k == T_INT || t.k == T_FLOAT || t.k == T_STR || t.k == T_PARAM {
    got = "a literal"
  }
  syntax("expected ${what}, found ${got}")
}

fn (var p: Parser) expect_kw(kw: Str) -> () ! sql.SqlErr {
  if !p.accept_kw(kw) {
    return Err(p.fail(kw.to_upper()))
  }
}

fn (var p: Parser) expect_sym(s: Str) -> () ! sql.SqlErr {
  if !p.accept_sym(s) {
    return Err(p.fail(s.quote()))
  }
}

fn (var p: Parser) ident(what: Str) -> Str ! sql.SqlErr {
  let t = p.peek()
  if t.k != T_IDENT {
    return Err(p.fail(what))
  }
  p.i += 1
  t.s
}

fn (var p: Parser) expr() -> Node ! sql.SqlErr { p.or_expr() }

fn (var p: Parser) or_expr() -> Node ! sql.SqlErr {
  var l = p.and_expr()?
  while p.accept_kw("or") {
    let r = p.and_expr()?
    l = Node.Bin(op: "or", l: l, r: r)
  }
  l
}

fn (var p: Parser) and_expr() -> Node ! sql.SqlErr {
  var l = p.not_expr()?
  while p.accept_kw("and") {
    let r = p.not_expr()?
    l = Node.Bin(op: "and", l: l, r: r)
  }
  l
}

fn (var p: Parser) not_expr() -> Node ! sql.SqlErr {
  if p.accept_kw("not") {
    let x = p.not_expr()?
    return Node.Not(x: x)
  }
  p.cmp_expr()
}

fn (var p: Parser) cmp_expr() -> Node ! sql.SqlErr {
  let l = p.add_expr()?
  let t = p.peek()
  if t.k == T_SYM && (t.s == "=" || t.s == "!=" || t.s == "<>" || t.s == "<" || t.s == "<=" || t.s == ">" || t.s == ">=") {
    p.i += 1
    let r = p.add_expr()?
    let op = if t.s == "<>" { "!=" } else { t.s }
    return Node.Bin(op: op, l: l, r: r)
  }
  if p.accept_kw("is") {
    let neg = p.accept_kw("not")
    p.expect_kw("null")?
    return Node.IsNull(x: l, neg: neg)
  }
  var neg = false
  if p.is_kw("not") && p.i + 1 < p.toks.len() && p.toks[p.i + 1].k == T_IDENT && (p.toks[p.i + 1].s == "in" || p.toks[p.i + 1].s == "like") {
    p.i += 1
    neg = true
  }
  var n = l
  if p.accept_kw("in") {
    p.expect_sym("(")?
    var items: List[Node] = []
    while {
      let x = p.add_expr()?
      items.push(x)
      if !p.accept_sym(",") {
        break
      }
    }
    p.expect_sym(")")?
    n = Node.InList(x: l, items: items)
  } else if p.accept_kw("like") {
    let r = p.add_expr()?
    n = Node.Like(l: l, r: r)
  } else {
    return l
  }
  if neg {
    return Node.Not(x: n)
  }
  n
}

fn (var p: Parser) add_expr() -> Node ! sql.SqlErr {
  var l = p.mul_expr()?
  while p.is_sym("+") || p.is_sym("-") {
    let op = p.next().s
    let r = p.mul_expr()?
    l = Node.Bin(op: op, l: l, r: r)
  }
  l
}

fn (var p: Parser) mul_expr() -> Node ! sql.SqlErr {
  var l = p.primary()?
  while p.is_sym("*") || p.is_sym("/") {
    let op = p.next().s
    let r = p.primary()?
    l = Node.Bin(op: op, l: l, r: r)
  }
  l
}

fn (var p: Parser) primary() -> Node ! sql.SqlErr {
  let t = p.next()
  if t.k == T_INT {
    return Node.Lit(v: sql.SqlValue.Integer(n: t.i))
  }
  if t.k == T_FLOAT {
    return Node.Lit(v: sql.SqlValue.Real(f: t.f))
  }
  if t.k == T_STR {
    return Node.Lit(v: sql.SqlValue.Text(s: t.s))
  }
  if t.k == T_PARAM {
    if t.i > p.max_param {
      p.max_param = t.i
    }
    return Node.Param(n: t.i)
  }
  if t.k == T_SYM {
    if t.s == "(" {
      let x = p.expr()?
      p.expect_sym(")")?
      return x
    }
    if t.s == "-" {
      let x = p.primary()?
      return Node.Bin(op: "-", l: Node.Lit(v: sql.SqlValue.Integer(n: 0)), r: x)
    }
  }
  if t.k == T_IDENT {
    if t.s == "null" {
      return Node.Lit(v: sql.SqlValue.Null)
    }
    if t.s == "true" {
      return Node.Lit(v: sql.SqlValue.Flag(b: true))
    }
    if t.s == "false" {
      return Node.Lit(v: sql.SqlValue.Flag(b: false))
    }
    if p.is_sym("(") && t.s == "count" {
      p.i += 1
      p.expect_sym("*")?
      p.expect_sym(")")?
      return Node.Count
    }
    if p.accept_sym(".") {
      // table.column: the table is ignored
      let c = p.ident("a column name")?
      return Node.Col(name: c)
    }
    return Node.Col(name: t.s)
  }
  // back one token, also at the end of input (where next did not
  // advance): the error names the token before, as std/rt's parser does
  p.i -= 1
  Err(p.fail("an expression"))
}

// ---------------------------------------------------------------------------
// Evaluation

struct EvalEnv {
  t: Table?
  row: List[sql.SqlValue]
  args: List[sql.SqlValue]
}

/// Go's %T of a value of the Go driver (for error texts).
fn go_type(v: sql.SqlValue) -> Str {
  match v {
    Integer(_) => "int64"
    Text(_) => "string"
    Real(_) => "float64"
    Flag(_) => "bool"
    At(_) => "rt.Time"
    Blob(_) => "rt.Bytes"
    JsonText(_) => "rt.SqlJSON"
    Array(_) => "rt.Sql_SqlValue"
    Null => "<nil>"
  }
}

fn cmp_int(a: Int, b: Int) -> Int {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn cmp_float(x: Float, y: Float) -> Int {
  if x < y {
    -1
  } else if x > y {
    1
  } else {
    0
  }
}

/// The order of two values that are not NULL.
fn sql_cmp(a: sql.SqlValue, b: sql.SqlValue) -> Int ! sql.SqlErr {
  match (a, b) {
    (Integer(x), Integer(y)) => return cmp_int(x, y)
    (Integer(x), Real(y)) => return cmp_float(Float(x), y)
    (Real(x), Integer(y)) => return cmp_float(x, Float(y))
    (Real(x), Real(y)) => return cmp_float(x, y)
    (Text(x), Text(y)) => return cmp_str(x, y)
    (Flag(x), Flag(y)) => {
      if x == y {
        return 0
      }
      return if !x { -1 } else { 1 }
    }
    (At(x), At(y)) => return if x < y { -1 } else if x > y { 1 } else { 0 }
    // bytes in order compare as their hex text does
    (Blob(x), Blob(y)) => return cmp_str(x.to_hex(), y.to_hex())
    (JsonText(x), JsonText(y)) => return cmp_str(x, y)
    _ => {}
  }
  Err(sql.SqlErr.Driver(msg: "cannot compare ${go_type(a)} with ${go_type(b)}"))
}

/// strings.Compare.
fn cmp_str(x: Str, y: Str) -> Int {
  if x < y {
    -1
  } else if x > y {
    1
  } else {
    0
  }
}

fn like_at(s: List[Rune], p: List[Rune], i0: Int, j0: Int) -> Bool {
  var i = i0
  var j = j0
  while j < p.len() {
    let c = p[j]
    if c == '%' {
      var k = i
      while k <= s.len() {
        if like_at(s, p, k, j + 1) {
          return true
        }
        k += 1
      }
      return false
    }
    if c == '_' {
      if i >= s.len() {
        return false
      }
    } else if i >= s.len() || s[i].to_lower() != c.to_lower() {
      return false
    }
    i += 1
    j += 1
  }
  i == s.len()
}

fn sql_like(s: Str, pat: Str) -> Bool { like_at(s.runes(), pat.runes(), 0, 0) }

fn (e: EvalEnv) eval(n: Node) -> sql.SqlValue ! sql.SqlErr {
  match n {
    Lit(v) => return v
    Param(i) => return e.args[i - 1]
    Col(name) => {
      if let Some(t) = e.t {
        let i = t.index(name)
        if i >= 0 {
          return e.row[i]
        }
      }
      return Err(syntax("no such column ${name}"))
    }
    Count => return Err(syntax("COUNT(*) is only allowed in the select list"))
    Not(x) => {
      return match e.eval(x)? {
        Flag(b) => sql.SqlValue.Flag(b: !b)
        _ => sql.SqlValue.Null
      }
    }
    IsNull(x, neg) => {
      let v = e.eval(x)?
      return sql.SqlValue.Flag(b: (v is Null) != neg)
    }
    InList(x, items) => {
      let v = e.eval(x)?
      if v is Null {
        return sql.SqlValue.Null
      }
      for it in items {
        let w = e.eval(it)?
        if w is Null {
          continue
        }
        if sql_cmp(v, w)? == 0 {
          return sql.SqlValue.Flag(b: true)
        }
      }
      return sql.SqlValue.Flag(b: false)
    }
    Like(l, r) => {
      let v = e.eval(l)?
      let pv = e.eval(r)?
      if v is Null || pv is Null {
        return sql.SqlValue.Null
      }
      return match (v, pv) {
        (Text(s), Text(pat)) => sql.SqlValue.Flag(b: sql_like(s, pat))
        _ => Err(sql.SqlErr.Driver(msg: "LIKE needs text"))
      }
    }
    Bin(op, l, r) => return e.binary(op, l, r)
  }
}

fn (e: EvalEnv) binary(op: Str, ln: Node, rn: Node) -> sql.SqlValue ! sql.SqlErr {
  let l = e.eval(ln)?
  let r = e.eval(rn)?
  if op == "and" || op == "or" {
    let lb = match l {
      Flag(b) => Some(b)
      _ => None
    }
    let rb = match r {
      Flag(b) => Some(b)
      _ => None
    }
    if op == "and" {
      if lb == Some(false) || rb == Some(false) {
        return sql.SqlValue.Flag(b: false)
      }
      if lb.is_some() && rb.is_some() {
        return sql.SqlValue.Flag(b: true)
      }
      return sql.SqlValue.Null
    }
    if lb == Some(true) || rb == Some(true) {
      return sql.SqlValue.Flag(b: true)
    }
    if lb.is_some() && rb.is_some() {
      return sql.SqlValue.Flag(b: false)
    }
    return sql.SqlValue.Null
  }
  if l is Null || r is Null {
    return sql.SqlValue.Null
  }
  if op == "=" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
    let c = sql_cmp(l, r)?
    let b = match op {
      "=" => c == 0
      "!=" => c != 0
      "<" => c < 0
      "<=" => c <= 0
      ">" => c > 0
      _ => c >= 0
    }
    return sql.SqlValue.Flag(b: b)
  }
  // arithmetic: Int with Int wraps like Go's int64, else Float
  match (l, r) {
    (Integer(a), Integer(b)) => {
      return match op {
        "+" => sql.SqlValue.Integer(n: a.wrapping_add(b))
        "-" => sql.SqlValue.Integer(n: a.wrapping_sub(b))
        "*" => sql.SqlValue.Integer(n: a.wrapping_mul(b))
        _ => {
          if b == 0 {
            return Err(sql.SqlErr.Driver(msg: "division by zero"))
          }
          sql.SqlValue.Integer(n: a.checked_div(b) ?? a)
        }
      }
    }
    _ => {}
  }
  let x = match l {
    Integer(a) => Float(a)
    Real(f) => f
    _ => return Err(sql.SqlErr.Driver(msg: "arithmetic needs numbers"))
  }
  let y = match r {
    Integer(a) => Float(a)
    Real(f) => f
    _ => return Err(sql.SqlErr.Driver(msg: "arithmetic needs numbers"))
  }
  match op {
    "+" => sql.SqlValue.Real(f: x + y)
    "-" => sql.SqlValue.Real(f: x - y)
    "*" => sql.SqlValue.Real(f: x * y)
    _ => {
      if y == 0.0 {
        return Err(sql.SqlErr.Driver(msg: "division by zero"))
      }
      sql.SqlValue.Real(f: x / y)
    }
  }
}

fn (e: EvalEnv) where_ok(w: Node?) -> Bool ! sql.SqlErr {
  match w {
    None => true
    Some(n) => e.eval(n)? == sql.SqlValue.Flag(b: true)
  }
}

// ---------------------------------------------------------------------------
// Statements

fn check_params(p: Parser, args: List[sql.SqlValue]) -> () ! sql.SqlErr {
  if p.max_param != args.len() {
    return Err(sql.SqlErr.Param(msg: "statement has ${p.max_param} placeholders but ${args.len()} arguments were given"))
  }
}

/// The outcome of an INSERT, UPDATE, or DELETE.
struct Write {
  n: Int = 0
  id: Int = 0
  returning: Bool = false
  cols: List[Str] = []
  rows: List[List[sql.SqlValue]] = []
  types: List[sql.ColumnType] = []
}

const QUERY_NEEDS = "query needs a SELECT statement or a write with RETURNING (use exec for other statements)"

/// Runs a statement that returns rows: a SELECT, or a write with
/// RETURNING, on tables (a private copy).
fn mem_run(var tables: Map[Str, Table], q: Str, args: List[sql.SqlValue]) -> MemRows ! sql.SqlErr {
  let stmts = split_statements(lex(q)?)
  if stmts.len() != 1 {
    return Err(syntax("expected one statement"))
  }
  var p = Parser{toks: stmts[0]}
  var w = Write{}
  if p.is_kw("select") {
    return mem_select(tables, p, args)
  } else if p.is_kw("insert") {
    w = mem_insert(tables, p, args, true)?
  } else if p.is_kw("update") {
    w = mem_update(tables, p, args, true)?
  } else if p.is_kw("delete") {
    w = mem_delete(tables, p, args, true)?
  } else {
    return Err(syntax(QUERY_NEEDS))
  }
  if p.peek().k != T_EOF {
    return Err(p.fail("end of statement"))
  }
  if !w.returning {
    return Err(syntax(QUERY_NEEDS))
  }
  MemRows{cols: w.cols, rows: w.rows, types: w.types}
}

/// Runs write statements on tables, leaving them as they were on an error:
/// several statements run on a copy, one in place (decision 0528: each
/// write checks everything before it changes anything).
fn mem_exec(var tables: Map[Str, Table], q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr {
  let stmts = split_statements(lex(q)?)
  if stmts.is_empty() {
    return Err(syntax("empty statement"))
  }
  if stmts.len() > 1 && !args.is_empty() {
    return Err(sql.SqlErr.Param(msg: "several statements cannot take arguments"))
  }
  if stmts.len() == 1 {
    let w = exec_one(tables, stmts[0], args)?
    return sql.ExecResult{rows_affected: w.n, last_insert_id: w.id}
  }
  var work = tables
  var total = 0
  var last_id = 0
  for st in stmts {
    let w = exec_one(work, st, args)?
    total += w.n
    if w.id != 0 {
      last_id = w.id
    }
  }
  tables = work
  sql.ExecResult{rows_affected: total, last_insert_id: last_id}
}

/// One write statement of mem_exec; it changes tables only when it
/// succeeds.
fn exec_one(var tables: Map[Str, Table], st: List[Tok], args: List[sql.SqlValue]) -> Write ! sql.SqlErr {
  var p = Parser{toks: st}
  if p.is_kw("create") || p.is_kw("drop") {
    // each checks that the statement ends before its one write, so tables
    // is not copied: a copy written to makes the Map a log one, whose
    // later writes copy a table's rows (decision 0528)
    if p.is_kw("create") {
      mem_create(tables, p)?
    } else {
      mem_drop(tables, p)?
    }
    stmt_end(p)?
    return Write{}
  }
  if p.is_kw("insert") {
    return mem_insert(tables, p, args, false)
  }
  if p.is_kw("update") {
    return mem_update(tables, p, args, false)
  }
  if p.is_kw("delete") {
    return mem_delete(tables, p, args, false)
  }
  if p.is_kw("select") {
    return Err(syntax("exec cannot run a SELECT (use query)"))
  }
  Err(p.fail("a statement"))
}

/// The default of a write's Map.update, never used: its plan read the table.
fn no_table(name: Str) -> Table { Table{name: name, cols: [], rows: [], next_id: 1} }

fn table_for(tables: Map[Str, Table], name: Str) -> Table ! sql.SqlErr {
  tables.get(name).or_err(sql.SqlErr.NoTable(name: name))
}

fn mem_create(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  p.i += 1
  if p.is_kw("index") || p.is_kw("unique") {
    return mem_create_index(tables, p)
  }
  p.expect_kw("table")?
  var if_not = false
  if p.accept_kw("if") {
    p.expect_kw("not")?
    p.expect_kw("exists")?
    if_not = true
  }
  let name = p.ident("a table name")?
  if tables.contains(name) {
    if !if_not {
      return Err(syntax("table ${name} already exists"))
    }
    // consume the definition
    var depth = 0
    while p.peek().k != T_EOF {
      if p.is_sym("(") {
        depth += 1
      } else if p.is_sym(")") {
        depth -= 1
      }
      p.i += 1
      if depth == 0 {
        break
      }
    }
    return Ok(())
  }
  p.expect_sym("(")?
  var t = Table{name: name, cols: [], rows: [], next_id: 1}
  var pk_cols: List[Str] = []
  while {
    if p.accept_kw("primary") {
      p.expect_kw("key")?
      p.expect_sym("(")?
      while {
        let c = p.ident("a column name")?
        pk_cols.push(c)
        if !p.accept_sym(",") {
          break
        }
      }
      p.expect_sym(")")?
    } else {
      let c = col_def(p)?
      if t.index(c.name) >= 0 {
        return Err(syntax("duplicate column ${c.name}"))
      }
      t.cols.push(c)
    }
    if !p.accept_sym(",") {
      break
    }
  }
  p.expect_sym(")")?
  for c in pk_cols {
    let i = t.index(c)
    if i < 0 {
      return Err(syntax("no such column ${c}"))
    }
    var col = t.cols[i]
    col.pk = true
    col.not_null = true
    if pk_cols.len() == 1 {
      col.unique = true
      col.auto = col.kind == KI
    }
    t.cols.set(i, col)
  }
  if t.cols.is_empty() {
    return Err(syntax("a table needs a column"))
  }
  stmt_end(p)?
  tables.put(name, t)
}

/// The table and column of the index named name, None when no table has
/// it.
fn index_at(tables: Map[Str, Table], name: Str) -> (Str, Int)? {
  for (tn, t) in tables {
    let m = t.made ?? continue
    for (ci, n) in m.names {
      if n == name {
        return Some((tn, ci))
      }
    }
  }
  None
}

/// `CREATE INDEX [IF NOT EXISTS] [name] ON table (column)`: an equality
/// index of one column that WHERE `column = value` uses, on an INT or TEXT
/// column (on another kind it is kept by name and not used); unnamed, it
/// is table_column_idx, as in PostgreSQL. A UNIQUE column has one already.
fn mem_create_index(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  if p.is_kw("unique") {
    return Err(syntax("CREATE UNIQUE INDEX is not supported (declare the column UNIQUE)"))
  }
  p.i += 1
  var if_not = false
  if p.accept_kw("if") {
    p.expect_kw("not")?
    p.expect_kw("exists")?
    if_not = true
  }
  var name = ""
  if !p.is_kw("on") {
    name = p.ident("an index name")?
  }
  p.expect_kw("on")?
  let tn = p.ident("a table name")?
  p.expect_sym("(")?
  let cn = p.ident("a column name")?
  if p.is_sym(",") {
    return Err(syntax("an index on several columns is not supported"))
  }
  p.expect_sym(")")?
  stmt_end(p)?
  if name == "" {
    name = "${tn}_${cn}_idx"
  }
  if index_at(tables, name) is Some(_) {
    if if_not {
      return Ok(())
    }
    return Err(syntax("index ${name} already exists"))
  }
  var t = table_for(tables, tn)?
  let ci = t.index(cn)
  if ci < 0 {
    return Err(syntax("no such column ${cn}"))
  }
  var col = t.cols[ci]
  var mx = made_take(t)
  if let Some(old) = mx.names.get(ci) {
    return Err(syntax("column ${cn} already has index ${old}"))
  }
  col.has_index = true
  t.cols.set(ci, col)
  mx.names.put(ci, name)
  made_put(t, mx)
  if !col.unique {
    for slot in 0..t.rows.len() {
      if !t.rows[slot].is_empty() {
        idx_put(t, slot)
      }
    }
  }
  tables.put(tn, t)
}

/// `DROP INDEX [IF EXISTS] name`.
fn mem_drop_index(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  p.i += 1
  var if_ex = false
  if p.accept_kw("if") {
    p.expect_kw("exists")?
    if_ex = true
  }
  let name = p.ident("an index name")?
  stmt_end(p)?
  let (tn, ci) = index_at(tables, name) ?? {
    if if_ex {
      return Ok(())
    }
    return Err(syntax("no such index ${name}"))
  }
  var t = table_for(tables, tn)?
  var col = t.cols[ci]
  col.has_index = false
  t.cols.set(ci, col)
  var mx = made_take(t)
  let _ = mx.names.remove(ci)
  let _ = mx.midx.remove(ci)
  made_put(t, mx)
  tables.put(tn, t)
}

fn col_def(var p: Parser) -> Col ! sql.SqlErr {
  let name = p.ident("a column name")?
  let ty = p.ident("a column type")?
  var c = Col{name: name, kind: 0, decl: ty.to_upper()}
  match ty {
    "int" | "integer" | "bigint" | "smallint" | "int64" => c.kind = KI
    "serial" | "bigserial" => {
      c.kind = KI
      c.auto = true
      c.pk = true
      c.unique = true
      c.not_null = true
    }
    "text" | "varchar" | "char" | "string" | "uuid" => c.kind = KT
    "real" | "float" | "double" | "numeric" | "decimal" => {
      c.kind = KR
      p.accept_kw("precision")
    }
    "bool" | "boolean" => c.kind = KB
    "timestamp" | "timestamptz" | "datetime" | "time" | "date" => c.kind = KTIME
    "blob" | "bytea" => c.kind = KBLOB
    "json" | "jsonb" => c.kind = KJSON
    _ => return Err(syntax("unknown column type ${ty}"))
  }
  if p.accept_sym("(") {
    while !p.is_sym(")") && p.peek().k != T_EOF {
      p.i += 1
    }
    p.expect_sym(")")?
  }
  if p.accept_sym("[") {
    p.expect_sym("]")?
    c.decl = c.decl + "[]"
    c.elem = c.kind
    c.kind = KARR
  }
  while {
    if p.accept_kw("primary") {
      p.expect_kw("key")?
      c.pk = true
      c.unique = true
      c.not_null = true
      c.auto = c.kind == KI
    } else if p.accept_kw("not") {
      p.expect_kw("null")?
      c.not_null = true
    } else if p.accept_kw("null") {
    } else if p.accept_kw("unique") {
      c.unique = true
    } else if p.accept_kw("autoincrement") {
      c.auto = true
    } else if p.accept_kw("default") {
      match p.primary()? {
        Lit(v) => c.def = v
        _ => return Err(syntax("DEFAULT must be a literal"))
      }
    } else {
      return c
    }
  }
  c
}

fn mem_drop(var tables: Map[Str, Table], var p: Parser) -> () ! sql.SqlErr {
  p.i += 1
  if p.is_kw("index") {
    return mem_drop_index(tables, p)
  }
  p.expect_kw("table")?
  var if_ex = false
  if p.accept_kw("if") {
    p.expect_kw("exists")?
    if_ex = true
  }
  let name = p.ident("a table name")?
  if !tables.contains(name) {
    if if_ex {
      return Ok(())
    }
    return Err(sql.SqlErr.NoTable(name: name))
  }
  stmt_end(p)?
  tables.remove(name)
}

fn kind_want(kind: Int) -> Str {
  match kind {
    1 => "an integer"
    2 => "text"
    3 => "a float"
    4 => "a boolean"
    6 => "bytes"
    7 => "json"
    8 => "an array"
    _ => "a time"
  }
}

/// v converted to the column's kind.
fn coerce(c: Col, v: sql.SqlValue) -> sql.SqlValue ! sql.SqlErr {
  if c.kind == KARR {
    if let Array(items) = v {
      // each element to the column's element kind (NULL allowed); a loop,
      // not items.map with a closure: a call through a function value is a
      // point that can be canceled, which made every Mutex.with body that
      // reaches coerce (each INSERT and UPDATE) keep the tables it was
      // given and copy the table it wrote (decision 0528)
      let ec = Col{name: c.name, kind: c.elem}
      var out: List[sql.SqlValue] = List.with_capacity(items.len())
      for x in items {
        out.push(coerce(ec, x)?)
      }
      return sql.SqlValue.Array(items: out)
    }
  }
  match v {
    Null => return v
    Integer(n) => {
      if c.kind == KI {
        return v
      }
      if c.kind == KR {
        return sql.SqlValue.Real(f: Float(n))
      }
    }
    Text(_) => {
      if c.kind == KT {
        return v
      }
    }
    Real(_) => {
      if c.kind == KR {
        return v
      }
    }
    Flag(_) => {
      if c.kind == KB {
        return v
      }
    }
    At(_) => {
      if c.kind == KTIME {
        return v
      }
    }
    Blob(_) => {
      if c.kind == KBLOB {
        return v
      }
    }
    JsonText(_) => {
      if c.kind == KJSON {
        return v
      }
    }
    Array(_) => {}
  }
  Err(sql.SqlErr.Constraint(msg: "column ${c.name} expects ${kind_want(c.kind)}, got ${go_type(v)}", code: "42804", name: ""))
}

/// Checks row's NOT NULL and UNIQUE constraints against t's rows (but slot
/// skip, the row it replaces), with the rows in repl standing for their
/// slots' and the rows of extra added (a statement's own earlier rows: the
/// table as it would be, decision 0528).
fn check_row(t: Table, row: List[sql.SqlValue], skip: Int, extra: List[List[sql.SqlValue]], repl: Map[Int, List[sql.SqlValue]]) -> () ! sql.SqlErr {
  for (i, c) in t.cols.indexed() {
    if row[i] is Null && c.not_null {
      return Err(sql.SqlErr.Constraint(msg: "NOT NULL constraint failed: ${t.name}.${c.name}", code: "23502", name: ""))
    }
    if c.unique && !(row[i] is Null) {
      let dup = sql.SqlErr.Constraint(msg: "UNIQUE constraint failed: ${t.name}.${c.name}", code: "23505", name: "")
      if indexed(c) {
        let s = idx_find(t, i, row[i])
        if s >= 0 && s != skip && !repl.contains(s) {
          return Err(dup)
        }
      } else {
        for (j, o) in t.rows.indexed() {
          if j == skip || o.is_empty() || repl.contains(j) || o[i] is Null {
            continue
          }
          if let Ok(0) = sql_cmp(o[i], row[i]) {
            return Err(dup)
          }
        }
      }
      for (j, o) in repl.entries() {
        if j == skip || o[i] is Null {
          continue
        }
        if let Ok(0) = sql_cmp(o[i], row[i]) {
          return Err(dup)
        }
      }
      for o in extra {
        if o[i] is Null {
          continue
        }
        if let Ok(0) = sql_cmp(o[i], row[i]) {
          return Err(dup)
        }
      }
    }
  }
}

/// What a write statement changes, made and checked by its plan function
/// before the table changes. The plan holds the table it read, so the
/// change runs after it returns, in a Map.update whose closure cannot
/// fail: the table is then changed in place, where a remove or get and a
/// put back copies its rows (the log Map keeps each value it held;
/// decision 0528).
struct Plan {
  name: Str
  res: Write
  slots: List[Int] = []
  rows: List[List[sql.SqlValue]] = []
  next_id: Int = 0
}

fn mem_insert(var tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Write ! sql.SqlErr {
  let pl = insert_plan(tables, p, args, want_ret)?
  tables.update(pl.name, no_table(pl.name), fn(var t) {
    for row in pl.rows {
      t.rows.push(row)
      idx_put(t, t.rows.len() - 1)
    }
    t.next_id = pl.next_id
  })
  pl.res
}

fn insert_plan(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Plan ! sql.SqlErr {
  p.i += 1
  p.expect_kw("into")?
  let name = p.ident("a table name")?
  let old = table_for(tables, name)?
  var cols: List[Int] = []
  if p.accept_sym("(") {
    while {
      let c = p.ident("a column name")?
      let i = old.index(c)
      if i < 0 {
        return Err(syntax("no such column ${c}"))
      }
      cols.push(i)
      if !p.accept_sym(",") {
        break
      }
    }
    p.expect_sym(")")?
  } else {
    for i in 0..old.cols.len() {
      cols.push(i)
    }
  }
  p.expect_kw("values")?
  var tuples: List[List[Node]] = []
  while {
    p.expect_sym("(")?
    var tup: List[Node] = []
    while {
      let x = p.expr()?
      tup.push(x)
      if !p.accept_sym(",") {
        break
      }
    }
    p.expect_sym(")")?
    if tup.len() != cols.len() {
      return Err(syntax("${cols.len()} columns but ${tup.len()} values"))
    }
    tuples.push(tup)
    if !p.accept_sym(",") {
      break
    }
  }
  let (ret, has_ret) = p.returning()?
  check_params(p, args)?
  // every row made and checked before the table changes (decision 0528)
  let env = EvalEnv{t: None, row: [], args: args}
  var next_id = old.next_id
  var last_id = 0
  var added: List[List[sql.SqlValue]] = []
  for tup in tuples {
    var row: List[sql.SqlValue] = []
    for c in old.cols {
      row.push(c.def)
    }
    for (k, ci) in cols.indexed() {
      let v = env.eval(tup[k])?
      row.set(ci, coerce(old.cols[ci], v)?)
    }
    for (i, c) in old.cols.indexed() {
      if !c.auto {
        continue
      }
      if row[i] is Null {
        row.set(i, sql.SqlValue.Integer(n: next_id))
      }
      if let Integer(id) = row[i] {
        if id >= next_id {
          next_id = id + 1
        }
        last_id = id
      }
    }
    check_row(old, row, -1, added, {})?
    added.push(row)
  }
  let res = written(old, tuples.len(), last_id, ret, has_ret, added, args)?
  write_end(p, has_ret, want_ret)?
  Plan{name: name, res: res, rows: added, next_id: next_id}
}

struct Asg {
  col: Int
  e: Node
}

fn mem_update(var tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Write ! sql.SqlErr {
  let pl = update_plan(tables, p, args, want_ret)?
  tables.update(pl.name, no_table(pl.name), fn(var t) {
    // out of the indexes first, so a row taking another's old value keeps it
    for ri in pl.slots {
      idx_drop(t, ri)
    }
    for (k, ri) in pl.slots.indexed() {
      t.rows.set(ri, pl.rows[k])
    }
    for ri in pl.slots {
      idx_put(t, ri)
    }
  })
  pl.res
}

fn update_plan(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Plan ! sql.SqlErr {
  p.i += 1
  let name = p.ident("a table name")?
  let old = table_for(tables, name)?
  p.expect_kw("set")?
  var asgs: List[Asg] = []
  while {
    let c = p.ident("a column name")?
    let i = old.index(c)
    if i < 0 {
      return Err(syntax("no such column ${c}"))
    }
    p.expect_sym("=")?
    let e = p.expr()?
    asgs.push(Asg{col: i, e: e})
    if !p.accept_sym(",") {
      break
    }
  }
  var w: Node? = None
  if p.accept_kw("where") {
    w = Some(p.expr()?)
  }
  let (ret, has_ret) = p.returning()?
  check_params(p, args)?
  // every new row made and checked, in slot order against the rows before
  // it already changed, before the table changes (decision 0528)
  var slots: List[Int] = []
  var changed: List[List[sql.SqlValue]] = []
  var repl: Map[Int, List[sql.SqlValue]] = {}
  let cand = candidates(old, w, args)
  // one environment for every row: wrapping the table per row cost a
  // retain and a release of it each
  var env = EvalEnv{t: Some(old), row: [], args: args}
  for k in 0..slots_len(old, cand) {
    let ri = slot_at(cand, k)
    let row = old.rows[ri]
    if row.is_empty() {
      continue
    }
    env.row = row
    if !env.where_ok(w)? {
      continue
    }
    var nr = row
    for a in asgs {
      let v = env.eval(a.e)?
      nr.set(a.col, coerce(old.cols[a.col], v)?)
    }
    check_row(old, nr, ri, [], repl)?
    repl.put(ri, nr)
    slots.push(ri)
    changed.push(nr)
  }
  let res = written(old, changed.len(), 0, ret, has_ret, changed, args)?
  write_end(p, has_ret, want_ret)?
  Plan{name: name, res: res, slots: slots, rows: changed}
}

fn mem_delete(var tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Write ! sql.SqlErr {
  let pl = delete_plan(tables, p, args, want_ret)?
  // the slots become empty rows (no rebuild of the list, decision 0528),
  // compacted once they are more than half of it
  tables.update(pl.name, no_table(pl.name), fn(var t) {
    for ri in pl.slots {
      idx_drop(t, ri)
      t.rows.set(ri, [])
    }
    t.dead += pl.slots.len()
    if t.dead > 64 && t.dead * 2 > t.rows.len() {
      compact(t)
    }
  })
  pl.res
}

fn delete_plan(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue], want_ret: Bool) -> Plan ! sql.SqlErr {
  p.i += 1
  p.expect_kw("from")?
  let name = p.ident("a table name")?
  let old = table_for(tables, name)?
  var w: Node? = None
  if p.accept_kw("where") {
    w = Some(p.expr()?)
  }
  let (ret, has_ret) = p.returning()?
  check_params(p, args)?
  var slots: List[Int] = []
  var gone: List[List[sql.SqlValue]] = []
  let cand = candidates(old, w, args)
  var env = EvalEnv{t: Some(old), row: [], args: args}
  for k in 0..slots_len(old, cand) {
    let ri = slot_at(cand, k)
    let row = old.rows[ri]
    if row.is_empty() {
      continue
    }
    env.row = row
    if env.where_ok(w)? {
      gone.push(row)
      slots.push(ri)
    }
  }
  let res = written(old, gone.len(), 0, ret, has_ret, gone, args)?
  write_end(p, has_ret, want_ret)?
  Plan{name: name, res: res, slots: slots}
}

/// The end of a statement, checked before its write.
fn stmt_end(p: Parser) -> () ! sql.SqlErr {
  if p.peek().k != T_EOF {
    return Err(p.fail("end of statement"))
  }
}

/// The checks mem_exec and mem_run made after a write, made before it
/// changes anything (decision 0528): the statement ends, and a query's
/// write has RETURNING.
fn write_end(p: Parser, has_ret: Bool, want_ret: Bool) -> () ! sql.SqlErr {
  stmt_end(p)?
  if want_ret && !has_ret {
    return Err(syntax(QUERY_NEEDS))
  }
}

/// The outcome of a write that touched rows of t.
fn written(t: Table, n: Int, id: Int, ret: List[SelItem], has_ret: Bool, rows: List[List[sql.SqlValue]], args: List[sql.SqlValue]) -> Write ! sql.SqlErr {
  if !has_ret {
    return Write{n: n, id: id}
  }
  let out = project(t, ret, rows, args)?
  Write{n: n, id: id, returning: true, cols: out.cols, rows: out.rows, types: out.types}
}

/// One item of a SELECT or RETURNING list.
struct SelItem {
  star: Bool = false
  e: Node = Node.Count
  alias: Str = ""
}

fn (var p: Parser) returning() -> (List[SelItem], Bool) ! sql.SqlErr {
  if !p.accept_kw("returning") {
    return ([], false)
  }
  let items = p.sel_items()?
  for it in items {
    if !it.star && it.e is Count {
      return Err(syntax("RETURNING cannot use COUNT(*)"))
    }
  }
  (items, true)
}

fn (var p: Parser) sel_items() -> List[SelItem] ! sql.SqlErr {
  var items: List[SelItem] = []
  while {
    if p.accept_sym("*") {
      items.push(SelItem{star: true})
    } else {
      let e = p.expr()?
      var alias = ""
      if p.accept_kw("as") {
        alias = p.ident("an alias")?
      }
      items.push(SelItem{e: e, alias: alias})
    }
    if !p.accept_sym(",") {
      return items
    }
  }
  items
}

/// The result column names of items over t, and the count of COUNT(*)
/// items.
fn sel_cols(t: Table, items: List[SelItem]) -> (List[Str], Int) {
  var cols: List[Str] = []
  var counts = 0
  for it in items {
    if it.star {
      for c in t.cols {
        cols.push(c.name)
      }
    } else if it.alias != "" {
      cols.push(it.alias)
      if it.e is Count {
        counts += 1
      }
    } else {
      match it.e {
        Col(name) => cols.push(name)
        Count => {
          cols.push("count")
          counts += 1
        }
        Lit(_) | Param(_) | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => cols.push("?column?")
      }
    }
  }
  (cols, counts)
}

/// items (without COUNT(*)) evaluated on each row of t.
fn project(t: Table, items: List[SelItem], rows: List[List[sql.SqlValue]], args: List[sql.SqlValue]) -> MemRows ! sql.SqlErr {
  let (cols, _) = sel_cols(t, items)
  var out: List[List[sql.SqlValue]] = []
  var env = EvalEnv{t: Some(t), row: [], args: args}
  for row in rows {
    env.row = row
    var r: List[sql.SqlValue] = []
    for it in items {
      if it.star {
        for v in row {
          r.push(v)
        }
        continue
      }
      r.push(env.eval(it.e)?)
    }
    out.push(r)
  }
  MemRows{cols: cols, rows: out, types: sel_types(t, items)}
}

/// Each selected column's type (decision 0609): a table column's declared
/// type, NOT NULL and kind; COUNT(*) an Integer that is never null; an
/// expression unknown.
fn sel_types(t: Table, items: List[SelItem]) -> List[sql.ColumnType] {
  var out: List[sql.ColumnType] = []
  for it in items {
    if it.star {
      for c in t.cols {
        out.push(col_type(c, c.name))
      }
      continue
    }
    let name = if it.alias != "" { it.alias } else {
      match it.e {
        Col(n) => n
        Count => "count"
        Lit(_) | Param(_) | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => "?column?"
      }
    }
    match it.e {
      Col(n) => {
        var ct = sql.ColumnType{name: name}
        for c in t.cols {
          if c.name == n {
            ct = col_type(c, name)
            break
          }
        }
        out.push(ct)
      }
      Count => out.push(sql.ColumnType{name: name, nullable: Some(false), kind: "Integer"})
      Lit(_) | Param(_) | Bin(_, _, _) | Not(_) | IsNull(_, _) | InList(_, _) | Like(_, _) => out.push(sql.ColumnType{name: name})
    }
  }
  out
}

fn col_type(c: Col, name: Str) -> sql.ColumnType {
  let kind = match c.kind {
    1 => "Integer"
    2 => "Text"
    3 => "Real"
    4 => "Flag"
    5 => "At"
    6 => "Blob"
    7 => "JsonText"
    8 => "Array"
    _ => ""
  }
  sql.ColumnType{name: name, database_type: c.decl, nullable: Some(!c.not_null), kind: kind}
}

struct OrderKey {
  e: Node
  desc: Bool
}

/// The order of two sort keys of one ORDER BY item (NULL first).
fn key_cmp(x: sql.SqlValue, y: sql.SqlValue) -> Int {
  if x is Null && y is Null {
    return 0
  }
  if x is Null {
    return -1
  }
  if y is Null {
    return 1
  }
  sql_cmp(x, y).ok() ?? 0
}

fn row_less(a: List[sql.SqlValue], b: List[sql.SqlValue], orders: List[OrderKey]) -> Bool {
  for (k, o) in orders.indexed() {
    let c = key_cmp(a[k], b[k])
    if c != 0 {
      return if o.desc { c > 0 } else { c < 0 }
    }
  }
  false
}

/// Whether the keys are already in order: no row sorts strictly before
/// the one ahead of it, so the stable sort would keep every row where it
/// is (an ORDER BY over the insertion order, the usual case).
fn keys_in_order(keys: List[List[sql.SqlValue]], orders: List[OrderKey]) -> Bool {
  for i in 1..keys.len() {
    if row_less(keys[i], keys[i - 1], orders) {
      return false
    }
  }
  true
}

/// A stable merge sort of the indexes 0..keys.len() by the keys:
/// bottom up, runs of 1, 2, 4, ... merged between two buffers, so it
/// allocates two lists where the recursive form sliced and built one per
/// call.
fn sort_idx(keys: List[List[sql.SqlValue]], orders: List[OrderKey]) -> List[Int] {
  let n = keys.len()
  var a = List[Int].with_capacity(n)
  var b = List[Int].with_capacity(n)
  for i in 0..n {
    a.push(i)
    b.push(i)
  }
  var w = 1
  while w < n {
    var lo = 0
    while lo < n {
      let mid = if lo + w < n { lo + w } else { n }
      let hi = if lo + 2 * w < n { lo + 2 * w } else { n }
      var i = lo
      var j = mid
      var o = lo
      while i < mid && j < hi {
        // take from the right only when it is strictly less (stable)
        if row_less(keys[a[j]], keys[a[i]], orders) {
          b[o] = a[j]
          j += 1
        } else {
          b[o] = a[i]
          i += 1
        }
        o += 1
      }
      while i < mid {
        b[o] = a[i]
        i += 1
        o += 1
      }
      while j < hi {
        b[o] = a[j]
        j += 1
        o += 1
      }
      lo = hi
    }
    let t = a
    a = b
    b = t
    w = w * 2
  }
  a
}

fn int_arg(n: Node, args: List[sql.SqlValue]) -> Int ! sql.SqlErr {
  let bad = syntax("LIMIT and OFFSET need a non negative integer")
  match (EvalEnv{t: None, row: [], args: args}).eval(n) {
    Ok(Integer(x)) => {
      if x < 0 {
        return Err(bad)
      }
      x
    }
    _ => Err(bad)
  }
}

fn mem_select(tables: Map[Str, Table], var p: Parser, args: List[sql.SqlValue]) -> MemRows ! sql.SqlErr {
  p.i += 1
  let items = p.sel_items()?
  p.expect_kw("from")?
  let name = p.ident("a table name")?
  let t = table_for(tables, name)?
  var w: Node? = None
  if p.accept_kw("where") {
    w = Some(p.expr()?)
  }
  var orders: List[OrderKey] = []
  if p.accept_kw("order") {
    p.expect_kw("by")?
    while {
      let e = p.expr()?
      var desc = false
      if p.accept_kw("desc") {
        desc = true
      } else {
        p.accept_kw("asc")
      }
      orders.push(OrderKey{e: e, desc: desc})
      if !p.accept_sym(",") {
        break
      }
    }
  }
  var limit: Node? = None
  var offset: Node? = None
  if p.accept_kw("limit") {
    limit = Some(p.primary()?)
    if p.accept_kw("offset") {
      offset = Some(p.primary()?)
    }
  }
  if p.peek().k != T_EOF {
    return Err(p.fail("end of statement"))
  }
  check_params(p, args)?
  // filter
  var rows: List[List[sql.SqlValue]] = []
  let cand = candidates(t, w, args)
  // one environment for every row: wrapping the table per row cost a
  // retain and a release of it each
  var env = EvalEnv{t: Some(t), row: [], args: args}
  for k in 0..slots_len(t, cand) {
    let row = t.rows[slot_at(cand, k)]
    if row.is_empty() {
      continue
    }
    env.row = row
    if env.where_ok(w)? {
      rows.push(row)
    }
  }
  // order
  if !orders.is_empty() {
    var keys: List[List[sql.SqlValue]] = []
    for row in rows {
      env.row = row
      var k: List[sql.SqlValue] = []
      for o in orders {
        k.push(env.eval(o.e)?)
      }
      keys.push(k)
    }
    // values that cannot be compared are an error (std/rt reports the
    // first pair its sort compares; columns hold one type, so in practice
    // there is none)
    for (oi, _) in orders.indexed() {
      var first: sql.SqlValue? = None
      for k in keys {
        if k[oi] is Null {
          continue
        }
        match first {
          None => first = Some(k[oi])
          Some(f) => {
            sql_cmp(f, k[oi])?
          }
        }
      }
    }
    if !keys_in_order(keys, orders) {
      var sorted = List[List[sql.SqlValue]].with_capacity(rows.len())
      for i in sort_idx(keys, orders) {
        sorted.push(rows[i])
      }
      rows = sorted
    }
  }
  // offset, limit
  if let Some(o) = offset {
    var k = int_arg(o, args)?
    if k > rows.len() {
      k = rows.len()
    }
    rows = rows[k..rows.len()]
  }
  if let Some(l) = limit {
    let k = int_arg(l, args)?
    if k < rows.len() {
      rows = rows[0..k]
    }
  }
  // project
  let (cols, counts) = sel_cols(t, items)
  if counts > 0 {
    if counts != items.len() {
      return Err(syntax("COUNT(*) cannot be mixed with other columns"))
    }
    var out: List[sql.SqlValue] = []
    for _ in items {
      out.push(sql.SqlValue.Integer(n: rows.len()))
    }
    return MemRows{cols: cols, rows: [out], types: sel_types(t, items)}
  }
  project(t, items, rows, args)
}
