// std/crc32 on the native backends: Go's hash/crc32 (crc32.go,
// crc32_generic.go of go1.26.1). IEEE is std/native/llrt/flate.xo's
// slicing-by-8 update, which gzip and zip use, with arm64's crc32x
// instruction where the CPU has it (decision 0231 addendum); Castagnoli
// is arm64's crc32cx where the CPU has it, else the same slicing-by-8
// over its own table (Go's slicing8Table of MakeTable(Castagnoli)).
use std/crc32
use native/llrt/cpu
use native/llrt/flate
use native/rt

fn checksum(data: Bytes, poly: crc32.Poly = crc32.Poly.Ieee) -> Int { update(0, data, poly) }

fn update(crc: Int, data: Bytes, poly: crc32.Poly = crc32.Poly.Ieee) -> Int {
  match poly {
    crc32.Poly.Ieee => flate.crc32(flate.crc_table(), crc & 0xffffffff, data)
    crc32.Poly.Castagnoli => castagnoli(crc & 0xffffffff, data)
  }
}

/// Go's slicingUpdate over CASTAGNOLI: eight bytes a step, read as one
/// word (the first lowest), then a byte at a time.
fn castagnoli(crc0: Int, b: Bytes) -> Int {
  let t = CASTAGNOLI
  var c = crc0 ^ 0xffffffff
  var i = 0
  let n = b.len()
  // arm64's crc32cx or x86-64's crc32q, a word a step (Go's
  // castagnoliUpdate on arm64, castagnoliSSE42 on amd64)
  if (cpu.hw() & (cpu.HW_CRC32 | cpu.HW_CRC32C)) != 0 {
    // Go's archUpdateCastagnoli on amd64: three streams of K bytes at
    // once hide the instruction's latency, and the shift tables join
    // them (CRC(I, AB) = shift(CRC(I, A)) ^ CRC(0, B)).
    while i + 3 * 1344 <= n {
      c = triple(c, b, i, 1344, SHIFT_K2)
      i += 3 * 1344
    }
    while i + 3 * 168 <= n {
      c = triple(c, b, i, 168, SHIFT_K1)
      i += 3 * 168
    }
    while i + 8 <= n {
      c = cpu.crc32cx(c, rt.bytes_word(b, i))
      i += 8
    }
  }
  while i + 8 <= n {
    let w = rt.bytes_word(b, i)
    c = c ^ (w & 0xffffffff)
    let hi = w.shr_logical(32)
    c = t[1792 + (c & 255)] ^ t[1536 + ((c >> 8) & 255)] ^ t[1280 + ((c >> 16) & 255)] ^ t[1024 + (c >> 24)] ^ t[768 + (hi & 255)] ^ t[512 + ((hi >> 8) & 255)] ^ t[256 + ((hi >> 16) & 255)] ^ t[hi >> 24]
    i += 8
  }
  while i < n {
    c = t[(c ^ Int(b[i])) & 255] ^ (c >> 8)
    i += 1
  }
  c ^ 0xffffffff
}

/// The CRC of state c over b[i..i + 3k]: b[i..i + k] from c and the next
/// two blocks from 0, each a crc32cx a word, joined by the shift table t
/// for k zero bytes (Go's castagnoliSSE42Triple and castagnoliShift).
fn triple(c: Int, b: Bytes, i: Int, k: Int, t: List[Int]) -> Int {
  var x = c
  var y = 0
  var z = 0
  var j = i
  let e = i + k
  while j < e {
    x = cpu.crc32cx(x, rt.bytes_word(b, j))
    y = cpu.crc32cx(y, rt.bytes_word(b, j + k))
    z = cpu.crc32cx(z, rt.bytes_word(b, j + 2 * k))
    j += 8
  }
  shift(t, shift(t, x) ^ y) ^ z
}

/// The state c carried over the zero bytes t was built for.
fn shift(t: List[Int], c: Int) -> Int {
  t[768 + (c >> 24)] ^ t[512 + ((c >> 16) & 255)] ^ t[256 + ((c >> 8) & 255)] ^ t[c & 255]
}

