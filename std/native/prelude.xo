// The test world of test binaries, part 1 (std/native/llrt/testworld.xo,
// the zero-C audit's B14; it was std/llrt/xo_testing.c): the test to
// run, a failure, the captured streams, FakeEnv, FakeProc.exit_code, the
// view of `xo test --real`, and the generators, as compiler/ssa
// testmode.xo calls them.

/// Starts the test world when the test binary runs one test (XO_TEST,
/// as `xo test` runs it): the first thing a test binary's main does
/// (compiler/ssa testmode.xo; was the C's weak xo_x_tw_start, which
/// entry.xo start called through the services record until decision
/// 0233 step 2).
fn llrt_tw_start() {
  if process.env_real_at("XO_TEST") != 0 {
    twrun.start()
  }
}

fn llrt_test_index() -> Int { testworld.test_index() }

/// The next test the test binary's main runs, -1 when none is left
/// (twrun.xo next: XO_TEST's test, or each run of XO_TEST_BATCH's
/// batch); between the runs of a batch the state of log.configure,
/// FakeStdio.set_tty, and FakeProc.kill starts over too.
/// Whether the run's property case skips its body: a serving binary's
/// case not smaller than the best (testworld.xo skip_case).
fn llrt_test_skip() -> Bool { testworld.skipped() }

fn llrt_test_next() -> Int {
  if twrun.ran() {
    logstate.reset()
    stdinrt.tw_reset()
    proc.tw_reset()
  }
  twrun.next()
}

fn llrt_test_fail(msg: Str) { testworld.fail(msg) }

fn llrt_test_output(which: Int) -> Str { testworld.output(which) }

fn llrt_test_eprint(s: Str) { testworld.write(true, s) }

fn llrt_test_env_set(name: Str, value: Str) { testworld.env_set(name, value) }

