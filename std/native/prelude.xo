// Word channels (decision 0353).
fn llrt_chan_send_w(c: Int, v: Int, at: rt.Loc) { chan.send_w(c, v, at) }

fn llrt_chan_recv_w(c: Int) -> (Int, Bool) { chan.recv_w(c) }

