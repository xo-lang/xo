/// rt.fs_canceled (the SSA builders call this in its place; a wasm
/// module's runtime serves rt.fs_canceled): whether an Fs operation
/// reports Canceled, the task canceled and not in deferred code (std/rt
/// Task.Canceled is shield aware too). xo_fs.c's xo_fs_canceled before.
fn llrt_fs_canceled() -> Bool { poll.canceled() }

/// os.proc.exit, and the end of a program whose main returned an error
/// (std/native/llrt/process.xo).
fn llrt_exit(code: Int) {
  if testworld.on() {
    // a test binary (twrun.xo exit): inside testing.run_main main
    // unwinds back to it; else the test ends here and passes
    if !twrun.exit(code) {
      process.os_exit(0)
    }
    return
  }
  process.exit(code)
}

/// `s[lo..hi]` on a Str (compiler/ssa expr.xo; was xo_bytes.c's): the
/// range must be one of s, its ends on UTF-8 boundaries.
fn llrt_str_slice_chk(s: Str, lo: Int, hi: Int, loc: Str) {
  let n = s.len()
  // 0 <= lo <= hi <= n as two unsigned compares, then neither end inside
  // a UTF-8 sequence; any other range goes to str_slice_bad, a call of
  // its own (ssa.cold_fn), so this check inlines at each `s[lo..hi]`
  // (2026-10-27: it was a call at each slice, 19% of path's parts row)
  if hi.le_unsigned(n) && lo.le_unsigned(hi) {
    let p = raw.data(s)
    if (lo == n || rt.mem_load(p, lo, 1) & 0xC0 != 0x80) && (hi == n || rt.mem_load(p, hi, 1) & 0xC0 != 0x80) {
      return
    }
  }
  str_slice_bad(s, lo, hi, loc)
}

/// llrt_str_slice_chk's fault: the range is not one of s, or an end splits
/// a UTF-8 sequence.
fn str_slice_bad(s: Str, lo: Int, hi: Int, loc: Str) {
  slice_check(lo, hi, s.len(), "Str", loc)
  fault.raise_str_at("slice ${lo}..${hi} of Str splits a UTF-8 sequence", raw.data(loc), loc.len())
}

/// The check of `b[lo..hi]` on Bytes (the compiler then builds the view).
fn llrt_bytes_slice_chk(b: Bytes, lo: Int, hi: Int, loc: Str) {
  slice_check(lo, hi, b.len(), "Bytes", loc)
}

fn llrt_str_slice_at(s: Str, lo: Int, hi: Int, loc: Str) -> Str {
  slice_check(lo, hi, s.len(), "Str", loc)
  let p = raw.data(s)
  let n = s.len()
  if (lo < n && rt.mem_load(p, lo, 1) & 0xC0 == 0x80) || (hi < n && rt.mem_load(p, hi, 1) & 0xC0 == 0x80) {
    fault.raise_str_at("slice ${lo}..${hi} of Str splits a UTF-8 sequence", raw.data(loc), loc.len())
  }
  raw.str_at(p + lo, hi - lo)
}

/// `b[lo..hi]` on Bytes.
/// A List[Int] of the little endian 8 byte words of b: a constant List
/// of Int literals kept as data (compiler/ssa show.xo int_list_data), read
/// once at the constant's first use.
fn llrt_list_of_le64(b: Bytes) -> List[Int] {
  let n = b.len() / 8
  var out = List[Int].with_capacity(n)
  let a = raw.bytes_addr(b)
  for i in 0..n {
    out.push(rt.mem_load(a, rt.int_wrap(3, i, 3), 8))
  }
  out
}

fn llrt_bytes_slice_at(b: Bytes, lo: Int, hi: Int, loc: Str) -> Bytes {
  slice_check(lo, hi, b.len(), "Bytes", loc)
  raw.str_at(raw.bytes_addr(b) + lo, hi - lo).bytes()
}

/// Faults unless lo..hi is a range of a value of length n (std/rt's
/// StrSlice, BytesSlice): the test, small enough to inline at every
/// slice; the fault's text is built in slice_fail, a call only a bad
/// range makes (2026-10-24: with the text inline, every successful
/// cut_prefix called slice_check).
fn slice_check(lo: Int, hi: Int, n: Int, what: Str, loc: Str) {
  if lo < 0 || hi > n || lo > hi {
    slice_fail(lo, hi, n, what, loc)
  }
}

/// slice_check's fault.
fn slice_fail(lo: Int, hi: Int, n: Int, what: Str, loc: Str) {
  fault.raise_str_at("slice ${lo}..${hi} out of range for ${what} of length ${n}", raw.data(loc), loc.len())
}

/// The clamped slice and the repeat of the SSA builders' show and
/// assertion texts (compiler/ssa show.xo; was xo_std.c's).
fn llrt_str_slice(s: Str, lo: Int, hi: Int) -> Str { raw.str_slice(s, lo, hi) }

fn llrt_str_repeat(s: Str, n: Int) -> Str { raw.str_repeat(s, n) }

/// BytesBuilder.write_rune (the SSA builders call it with a Rune value).
fn llrt_rs_push_rune(s: Str, r: Rune) -> Str { raw.push_rune(s, Int(r)) }

/// BytesBuilder.put_le and put_be (decision 0399; raw.xo put).
fn llrt_rs_put(s: Str, at: Int, v: Int, n: Int, be: Int, loc: Str) -> Str {
  let len = s.len()
  if (n != 1 && n != 2 && n != 4 && n != 8) || at < 0 || at > len - n {
    put_fail(loc)
  }
  raw.put(s, at, v, n, be)
}

/// llrt_rs_put's fault, out of line.
fn put_fail(loc: Str) {
  fault.raise_str_at("BytesBuilder.put: width must be 1, 2, 4 or 8 and at..at + width must lie within the builder", raw.data(loc), loc.len())
}

