// The prelude methods the native backends implement in Xo (decision
// 0074). internal/ssa lowers a prelude method `T.name` that it has no
// lowering of its own for to the function `T_name` here, whose first
// parameter is the receiver and whose type parameters are those of the
// declaration in std/prelude.xo, in order. Semantics are std/rt's.
use native/llrt/atomic
use native/llrt/cabi
use native/llrt/cabi_c
use native/llrt/cabi_libc
use native/llrt/cabi_wincrt
use native/llrt/cabi_nolibc
use native/llrt/cabi_poll
use native/llrt/cabi_race
use native/llrt/cabi_racefn
use native/llrt/cabi_tw
use native/llrt/fault
use native/llrt/fsops
use native/llrt/gomath
use native/llrt/fspath
use native/llrt/gen
use native/llrt/ints
use native/llrt/jsontext
use native/llrt/logstate
use native/llrt/num
use native/llrt/poll
use native/llrt/process
use native/llrt/proc
use native/llrt/procspec
use native/llrt/rand
use native/llrt/raw
use native/llrt/report
use native/llrt/scan
use native/llrt/show
use native/llrt/stdin as stdinrt
use native/llrt/stdio as stdiort
use native/llrt/strings
use native/llrt/sysio
use native/llrt/testworld
use native/llrt/twrun
use native/llrt/text
use native/llrt/unicode
use native/llrt/userfs
use native/rt

// ---------------------------------------------------------------------------
// Str (std.md 2.2)

fn str_rune_count(s: Str) -> Int { scan.rune_count(s) }

fn str_contains(s: Str, sub: Str) -> Bool { scan.contains(s, sub) }

fn str_starts_with(s: Str, p: Str) -> Bool { scan.starts_with(s, p) }

fn str_ends_with(s: Str, p: Str) -> Bool { scan.ends_with(s, p) }

fn str_find(s: Str, sub: Str) -> Int? {
  let i = scan.find(s, sub, 0)
  if i < 0 {
    return None
  }
  Some(i)
}

/// strings.LastIndex: the last sub's byte offset, s.len() for "".
fn str_rfind(s: Str, sub: Str) -> Int? {
  let n = s.len()
  let m = sub.len()
  if m > n {
    return None
  }
  let sb = s.bytes()
  let qb = sub.bytes()
  var i = n - m
  while i >= 0 {
    var j = 0
    while j < m && sb[i + j] == qb[j] {
      j += 1
    }
    if j == m {
      return Some(i)
    }
    i -= 1
  }
  None
}

fn str_split(s: Str, sep: Str) -> List[Str] { scan.split(s, sep) }

fn str_lines(s: Str) -> List[Str] { scan.lines(s) }

fn str_trim(s: Str) -> Str { strings.trim(s, 0) }

fn str_trim_start(s: Str) -> Str { strings.trim(s, 1) }

fn str_trim_end(s: Str) -> Str { strings.trim(s, 2) }

fn str_trim_prefix(s: Str, p: Str) -> Str {
  if scan.starts_with(s, p) {
    return raw.str_slice(s, p.len(), s.len())
  }
  s
}

fn str_trim_suffix(s: Str, p: Str) -> Str {
  if scan.ends_with(s, p) {
    return raw.str_slice(s, 0, s.len() - p.len())
  }
  s
}

fn str_to_lower(s: Str) -> Str { unicode.map_case(s, true) }

fn str_to_upper(s: Str) -> Str { unicode.map_case(s, false) }

/// `a.to_lower() == b.to_lower()` (internal/ssa lowers that comparison to
/// a call of this).
fn str_eq_lower(a: Str, b: Str) -> Bool { unicode.eq_lower(a, b) }

fn str_replace(s: Str, old: Str, new: Str) -> Str { strings.replace(s, old, new) }

fn str_repeat(s: Str, n: Int) -> Str { raw.str_repeat(s, n) }

/// A copy in a buffer of its own (decision 0330): s may be a view.
fn str_clone(s: Str) -> Str { raw.str_at(raw.data(s), s.len()) }

fn bytes_clone(b: Bytes) -> Bytes {
  let n = b.len()
  let c = raw.bytes_buf(n)
  rt.mem_copy(raw.bytes_addr(c), raw.bytes_addr(b), n)
  c
}

fn list_join(xs: List[Str], sep: Str) -> Str { raw.str_join(xs, sep) }

fn str_quote(s: Str) -> Str { unicode.quote(s.bytes()) }

// ---------------------------------------------------------------------------
// Rune and Bytes (std.md 2.2, decisions 0079 and 0081)

fn rune_is_letter(r: Rune) -> Bool { unicode.is_letter(Int(r)) }

fn rune_is_digit(r: Rune) -> Bool { unicode.is_digit(Int(r)) }

fn rune_is_space(r: Rune) -> Bool { unicode.is_space(Int(r)) }

fn rune_is_print(r: Rune) -> Bool { unicode.is_print(Int(r)) }

fn rune_to_lower(r: Rune) -> Rune { rune_case(r, true) }

fn rune_to_upper(r: Rune) -> Rune { rune_case(r, false) }

/// unicode.ToLower (lower) or unicode.ToUpper: an unchanged or ASCII
/// result needs no checked conversion.
fn rune_case(r: Rune, lower: Bool) -> Rune {
  let x = Int(r)
  let y = unicode.to_case(x, lower)
  if y == x {
    return r
  }
  if y < 0x80 {
    return Rune(unicode.byte(y))
  }
  Rune(y)
}

fn rune_quote(r: Rune) -> Str { unicode.quote_rune(Int(r)) }

fn rune_try(x: Int) -> Rune? {
  if x < 0 || x > 0x10ffff || (x >= 0xd800 && x <= 0xdfff) {
    return None
  }
  Some(Rune(x))
}

fn bytes_quote(b: Bytes) -> Str { unicode.quote(b) }

fn bytes_rune_count(b: Bytes) -> Int { scan.bytes_rune_count(b) }

fn bytes_to_hex(b: Bytes) -> Str { scan.to_hex(b) }

/// Whether sub is at b[i:] (i + sub.len() <= b.len()).
fn bytes_at(b: Bytes, sub: Bytes, i: Int) -> Bool {
  var j = 0
  while j < sub.len() {
    if b[i + j] != sub[j] {
      return false
    }
    j += 1
  }
  true
}

/// bytes.Index and bytes.LastIndex, on the bytes as they are (no Str cast:
/// the bytes need not be UTF-8, TestOutsideBytesValidated).
fn bytes_find(b: Bytes, sub: Bytes) -> Int? {
  var i = 0
  while i + sub.len() <= b.len() {
    if bytes_at(b, sub, i) {
      return Some(i)
    }
    i += 1
  }
  None
}

fn bytes_indexed(b: Bytes) -> List[(Int, UInt8)] {
  var out: List[(Int, UInt8)] = []
  for i in 0..b.len() {
    out.push((i, b[i]))
  }
  out
}

fn bytes_rfind(b: Bytes, sub: Bytes) -> Int? {
  var i = b.len() - sub.len()
  while i >= 0 {
    if bytes_at(b, sub, i) {
      return Some(i)
    }
    i -= 1
  }
  None
}

/// make([]byte, n): one allocation, cleared.
fn bytes_zeroed(n: Int) -> Bytes {
  if n < 0 {
    let q = ""
    fault.raise_str_at("negative length ${n} for Bytes.zeroed", raw.data(q), 0)
  }
  let b = raw.bytes_buf(n)
  rt.mem_set(raw.bytes_addr(b), 0, n)
  b
}

/// Whether b is UTF-8 (Bytes.to_str: internal/ssa calls this instead of
/// rt.utf8_valid, decision 0201).
fn llrt_utf8_valid(b: Bytes) -> Bool { scan.utf8_valid(b) }

fn bytes_from_hex(s: Str) -> Bytes? { num.from_hex(s) }

fn bytes_to_base64(b: Bytes) -> Str { num.to_base64(b) }

fn bytes_from_base64(s: Str) -> Bytes? { num.from_base64(s) }

/// []rune(s): an invalid byte is U+FFFD.
fn str_runes(s: Str) -> List[Rune] {
  let b = s.bytes()
  var out: List[Rune] = []
  var i = 0
  while i < b.len() {
    let p = raw.bytes_decode(b, i)
    out.push(Rune(p >> 3))
    i += p & 7
  }
  out
}

fn bytes_decode_rune(b: Bytes, i: Int, at: rt.Loc) -> (Rune, Int) {
  if i < 0 || i > b.len() {
    rt.fault_at("index ${i} out of range for decode_rune on Bytes of length ${b.len()}", at)
  }
  let p = raw.bytes_decode(b, i)
  (Rune(p >> 3), p & 7)
}

fn int_pow(n: Int, e: Int, at: rt.Loc) -> Int {
  if e < 0 {
    rt.fault_at("negative exponent ${e} in pow", at)
  }
  var r = 1
  var i = 0
  while i < e {
    if !ints.fits(2, r, n) {
      rt.fault_at("integer overflow: ${r} * ${n} does not fit Int", at)
    }
    r = r * n
    i += 1
  }
  r
}

fn int_wrapping_add(n: Int, m: Int) -> Int { rt.int_wrap(0, n, m) }

fn int_wrapping_sub(n: Int, m: Int) -> Int { rt.int_wrap(1, n, m) }

fn int_wrapping_mul(n: Int, m: Int) -> Int { rt.int_wrap(2, n, m) }

// Int's word methods (decision 0260): the SSA builders lower these calls
// inline as the same intrinsics (call.xo word_method); the bodies serve an
// xo that does not know them yet.

fn int_wrapping_shl(n: Int, k: Int) -> Int { rt.int_wrap(3, n, k) }

fn int_shr_logical(n: Int, k: Int) -> Int { rt.int_wrap(4, n, k) }

fn int_rotate_right(n: Int, k: Int) -> Int { rt.int_wrap(5, n, k) }

fn int_rotate_right32(n: Int, k: Int) -> Int { rt.int_wrap(6, n, k) }

fn int_swap_bytes(n: Int) -> Int { rt.int_wrap(7, n, 0) }

fn int_mul_hi_unsigned(n: Int, m: Int) -> Int { rt.u64_mul_hi(n, m) }

fn int_lt_unsigned(n: Int, m: Int) -> Bool { (n ^ (-9223372036854775807 - 1)) < (m ^ (-9223372036854775807 - 1)) }

fn int_le_unsigned(n: Int, m: Int) -> Bool { (n ^ (-9223372036854775807 - 1)) <= (m ^ (-9223372036854775807 - 1)) }

fn checked(op: Int, n: Int, m: Int) -> Int? {
  if !ints.fits(op, n, m) {
    return None
  }
  Some(ints.apply(op, n, m))
}

fn int_checked_add(n: Int, m: Int) -> Int? { checked(0, n, m) }

fn int_checked_sub(n: Int, m: Int) -> Int? { checked(1, n, m) }

fn int_checked_mul(n: Int, m: Int) -> Int? { checked(2, n, m) }

fn int_checked_div(n: Int, m: Int) -> Int? { checked(3, n, m) }

/// The bound an overflowing a op b saturates to.
fn saturated(op: Int, n: Int, m: Int) -> Int {
  let max = 9223372036854775807
  let min = -9223372036854775807 - 1
  if ints.fits(op, n, m) {
    return ints.apply(op, n, m)
  }
  if op == 0 {
    return if m > 0 { max } else { min }
  }
  if op == 1 {
    return if m > 0 { min } else { max }
  }
  if (n < 0) != (m < 0) { min } else { max }
}

fn int_saturating_add(n: Int, m: Int) -> Int { saturated(0, n, m) }

fn int_saturating_sub(n: Int, m: Int) -> Int { saturated(1, n, m) }

fn int_saturating_mul(n: Int, m: Int) -> Int { saturated(2, n, m) }

fn int_parse(s: Str) -> Int? { text.parse_int(s) }

fn float_parse(s: Str) -> Float? { num.parse_float(s) }

// ---------------------------------------------------------------------------
// Map[K, V] and Set[T] (std.md 2.4): std/rt map.go's order, the entries
// in insertion order

fn map_filter[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Map[K, V] ! E uses fx {
  var out: Map[K, V] = {}
  for (k, v) in m {
    if f(k, v)? {
      out[k] = v
    }
  }
  out
}

fn map_map[K, V, U, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> U ! E uses fx) -> Map[K, U] ! E uses fx {
  var out: Map[K, U] = {}
  for (k, v) in m {
    out[k] = f(k, v)?
  }
  out
}

fn map_any[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for (k, v) in m {
    if f(k, v)? {
      return true
    }
  }
  false
}

fn map_all[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for (k, v) in m {
    if !f(k, v)? {
      return false
    }
  }
  true
}

fn set_any[T, E, fx: Effects](s: Set[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in s {
    if f(x)? {
      return true
    }
  }
  false
}

fn set_all[T, E, fx: Effects](s: Set[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in s {
    if !f(x)? {
      return false
    }
  }
  true
}

fn set_filter[T, E, fx: Effects](s: Set[T], f: fn(T) -> Bool ! E uses fx) -> Set[T] ! E uses fx {
  var r: Set[T] = #{}
  for x in s {
    if f(x)? {
      r.add(x)
    }
  }
  r
}

/// The set of f's results, in the order of their first appearance.
fn set_map[T, U, E, fx: Effects](s: Set[T], f: fn(T) -> U ! E uses fx) -> Set[U] ! E uses fx {
  var r: Set[U] = #{}
  for x in s {
    r.add(f(x)?)
  }
  r
}

fn set_union[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r = s
  for x in o {
    r.add(x)
  }
  r
}

fn set_intersect[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r: Set[T] = #{}
  for x in s {
    if o.contains(x) {
      r.add(x)
    }
  }
  r
}

fn set_difference[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r: Set[T] = #{}
  for x in s {
    if !o.contains(x) {
      r.add(x)
    }
  }
  r
}

// ---------------------------------------------------------------------------
// List[T] (std.md 2.3)

fn list_insert[T](var xs: List[T], i: Int, x: T, at: rt.Loc) {
  let n = xs.len()
  if i < 0 || i > n {
    rt.fault_at("index ${i} out of range for insert into List of length ${n}", at)
  }
  xs.push(x)
  var j = n
  while j > i {
    xs[j] = xs[j - 1]
    j -= 1
  }
  xs[i] = x
}

fn list_remove_at[T](var xs: List[T], i: Int, at: rt.Loc) -> T {
  let n = xs.len()
  if i < 0 || i >= n {
    rt.fault_at("index ${i} out of range for List of length ${n}", at)
  }
  let x = xs[i]
  var j = i
  while j + 1 < n {
    xs[j] = xs[j + 1]
    j += 1
  }
  match xs.pop() {
    _ => {}
  }
  x
}

/// The Ints from lo up to hi, hi excluded (`Range.to_list`).
fn int_range_list(lo: Int, hi: Int) -> List[Int] {
  var out: List[Int] = []
  var i = lo
  while i < hi {
    out.push(i)
    i += 1
  }
  out
}

fn list_indexed[T](xs: List[T]) -> List[(Int, T)] {
  var out: List[(Int, T)] = []
  var i = 0
  for x in xs {
    out.push((i, x))
    i += 1
  }
  out
}

fn list_contains[T](xs: List[T], x: T) -> Bool {
  for y in xs {
    if y == x {
      return true
    }
  }
  false
}

fn list_index_of[T](xs: List[T], x: T) -> Int? {
  for (i, y) in xs.indexed() {
    if y == x {
      return Some(i)
    }
  }
  None
}

fn list_map[T, U, E, fx: Effects](xs: List[T], f: fn(T) -> U ! E uses fx) -> List[U] ! E uses fx {
  var out: List[U] = []
  for x in xs {
    out.push(f(x)?)
  }
  out
}

fn list_filter[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> List[T] ! E uses fx {
  var out: List[T] = []
  for x in xs {
    if f(x)? {
      out.push(x)
    }
  }
  out
}

fn list_fold[T, A, E, fx: Effects](xs: List[T], init: A, f: fn(A, T) -> A ! E uses fx) -> A ! E uses fx {
  var acc = init
  for x in xs {
    acc = f(acc, x)?
  }
  acc
}

fn list_find[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> T? ! E uses fx {
  for x in xs {
    if f(x)? {
      return Some(x)
    }
  }
  None
}

fn list_any[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in xs {
    if f(x)? {
      return true
    }
  }
  false
}

fn list_all[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in xs {
    if !f(x)? {
      return false
    }
  }
  true
}

fn list_reverse[T](xs: List[T]) -> List[T] {
  var out: List[T] = []
  var i = xs.len() - 1
  while i >= 0 {
    out.push(xs[i])
    i -= 1
  }
  out
}

/// A stable merge sort of xs by keys (std/rt sorts stably).
fn list_sort_by[T, K: Ord, E, fx: Effects](xs: List[T], key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx {
  var keys: List[K] = []
  for x in xs {
    keys.push(key(x)?)
  }
  var idx: List[Int] = []
  for i in 0..xs.len() {
    idx.push(i)
  }
  let sorted = merge_sort(idx, fn(a, b) { keys[a] < keys[b] })
  var out: List[T] = []
  for i in sorted {
    out.push(xs[i])
  }
  out
}

/// The elements grouped by key, the keys in first appearance order and each
/// group in input order.
fn list_group_by[T, K: Hash, E, fx: Effects](xs: List[T], key: fn(T) -> K ! E uses fx) -> List[(K, List[T])] ! E uses fx {
  var at: Map[K, Int] = {}
  var keys: List[K] = []
  var groups: List[List[T]] = []
  for x in xs {
    let k = key(x)?
    match at.get(k) {
      Some(i) => {
        var g = groups[i]
        groups[i] = []
        g.push(x)
        groups[i] = g
      }
      None => {
        at[k] = keys.len()
        keys.push(k)
        groups.push([x])
      }
    }
  }
  var out: List[(K, List[T])] = []
  for i in 0..keys.len() {
    out.push((keys[i], groups[i]))
  }
  out
}

fn list_sort[T: Ord](xs: List[T]) -> List[T] { merge_sort(xs, fn(a, b) { a < b }) }

/// A stable bottom up merge sort: less(a, b) when a sorts before b.
fn merge_sort[T](xs: List[T], less: fn(T, T) -> Bool) -> List[T] {
  let n = xs.len()
  if n < 2 {
    return xs
  }
  var src = xs
  var width = 1
  while width < n {
    var dst: List[T] = []
    var lo = 0
    while lo < n {
      var mid = lo + width
      if mid > n {
        mid = n
      }
      var hi = mid + width
      if hi > n {
        hi = n
      }
      var i = lo
      var j = mid
      while i < mid && j < hi {
        if less(src[j], src[i]) {
          dst.push(src[j])
          j += 1
        } else {
          dst.push(src[i])
          i += 1
        }
      }
      while i < mid {
        dst.push(src[i])
        i += 1
      }
      while j < hi {
        dst.push(src[j])
        j += 1
      }
      lo = hi
    }
    src = dst
    width *= 2
  }
  src
}

fn list_to_set[T](xs: List[T]) -> Set[T] {
  var s: Set[T] = #{}
  for x in xs {
    s.add(x)
  }
  s
}

// ---------------------------------------------------------------------------
// Option[T] and Result[T, E] (std.md 2.5)

fn option_or_err[T, E](o: T?, e: E) -> Result[T, E] {
  match o {
    Some(v) => Ok(v)
    None => Err(e)
  }
}

fn option_map[T, U, fx: Effects](o: T?, f: fn(T) -> U uses fx) -> U? uses fx {
  match o {
    Some(v) => Some(f(v))
    None => None
  }
}

fn option_and_then[T, U, fx: Effects](o: T?, f: fn(T) -> U? uses fx) -> U? uses fx {
  match o {
    Some(v) => f(v)
    None => None
  }
}

fn result_map[T, E, U, fx: Effects](r: Result[T, E], f: fn(T) -> U uses fx) -> Result[U, E] uses fx {
  match r {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}

fn result_map_err[T, E, F, fx: Effects](r: Result[T, E], f: fn(E) -> F uses fx) -> Result[T, F] uses fx {
  match r {
    Ok(v) => Ok(v)
    Err(e) => Err(f(e))
  }
}

fn result_ignore_err[T, E](r: Result[T, E], reason: Str) -> T? {
  match r {
    Ok(v) => Some(v)
    Err(_) => None
  }
}

// ---------------------------------------------------------------------------
// Duration (std.md 2.6)

fn duration_parse(s: Str) -> Duration ! DurationErr {
  match text.parse_duration(s) {
    Some(d) => Ok(Duration.from_nanos(d))
    None => Err(DurationErr{input: s})
  }
}

fn durationerr_display(e: DurationErr) -> Str {
  "invalid duration ${unicode.quote(e.input.bytes())}: expected numbers with units ns, us, ms, s, m, h, such as \"1.5s\" or \"1h30m\""
}

// ---------------------------------------------------------------------------
// Fs (std.md 3.1, decision 0102): std/rt caps.go's realFs, over the system
// calls of std/llrt/xo_fs.c. An Fs is its root and mode bits (1 a sub
// capability, 2 read only, 4 write only).

fn fs_err(st: Int, p: Str) -> FsErr {
  match st {
    1 => FsErr.NotFound(path: p)
    2 => FsErr.Exists(path: p)
    3 => FsErr.NotEmpty(path: p)
    4 => FsErr.NotDir(path: p)
    5 => FsErr.IsDir(path: p)
    6 => FsErr.Denied(path: p)
    7 => FsErr.Io(path: p, msg: sysio.msg()[1])
    _ => FsErr.Canceled
  }
}

// fs_windows is whether paths follow Windows' rules (std.md 3.1): the
// build's target, resolved at compile time.
fn fs_windows() -> Bool {
  match target.os {
    TargetOs.Windows => true
    TargetOs.Darwin | TargetOs.Linux | TargetOs.Wasi => false
  }
}

// fs_slash is p with \ as / on Windows (filepath.ToSlash), p elsewhere.
fn fs_slash(p: Str) -> Str {
  if fs_windows() {
    return p.replace("\\", "/")
  }
  p
}

// fs_volume is the volume of a slash separated Windows path
// (filepath.VolumeName): "C:" of "C:/x" or "C:x", "//host/share" of a
// UNC path; "" for others and on every other OS.
fn fs_volume(p: Str) -> Str {
  if !fs_windows() {
    return ""
  }
  let b = p.bytes()
  if b.len() >= 2 && b[1] == ':' && ((b[0] >= 'a' && b[0] <= 'z') || (b[0] >= 'A' && b[0] <= 'Z')) {
    return p[0..2]
  }
  if p.starts_with("//") && !p.starts_with("///") {
    let parts = p[2..].split("/")
    if parts.len() >= 2 && parts[0] != "" && parts[1] != "" {
      return "//${parts[0]}/${parts[1]}"
    }
  }
  ""
}

// fs_is_abs is filepath.IsAbs of a slash separated path: rooted at / on
// Unix; on Windows a drive with a root (C:/x) or a UNC path.
fn fs_is_abs(p: Str) -> Bool {
  if !fs_windows() {
    return p.starts_with("/")
  }
  let q = fs_slash(p)
  let v = fs_volume(q)
  if v == "" {
    return false
  }
  v.starts_with("//") || q[v.len()..].starts_with("/")
}

// fs_clean is Go's path.Clean; on Windows (filepath.Clean with /) \ is
// a separator too and a volume stays in front.
fn fs_clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  if fs_windows() {
    let q = fs_slash(p)
    let v = fs_volume(q)
    if v != "" {
      let rest = q[v.len()..]
      if rest == "" {
        return if v.starts_with("//") { v + "/" } else { v + "." }
      }
      let c = fs_clean_slash(rest)
      return v + c
    }
    return fs_clean_slash(q)
  }
  fs_clean_slash(p)
}

// fs_clean_slash is Go's path.Clean of a slash separated path.
fn fs_clean_slash(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let rooted = p.starts_with("/")
  var parts: List[Str] = []
  for seg in p.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    if seg == ".." {
      if parts.len() > 0 && parts[parts.len() - 1] != ".." {
        match parts.pop() {
          _ => {}
        }
      } else if !rooted {
        parts.push("..")
      }
      continue
    }
    parts.push(seg)
  }
  let body = parts.join("/")
  if rooted {
    return "/" + body
  }
  if body == "" {
    return "."
  }
  body
}

// fs_join is Go's path.Join (filepath.Join on Unix) of two elements.
fn fs_join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return fs_clean(b)
  }
  if b == "" {
    return fs_clean(a)
  }
  fs_clean(a + "/" + b)
}

// fs_base is Go's path.Base (of the slash form on Windows).
fn fs_base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  var s = fs_slash(p)
  while s.len() > 1 && s.ends_with("/") {
    s = s[0..s.len() - 1]
  }
  if s == "/" {
    return "/"
  }
  let parts = s.split("/")
  parts[parts.len() - 1]
}

// fs_abs is filepath.Abs (with / on Windows: a path rooted at / is on
// the working directory's drive).
fn fs_abs(p: Str) -> Str {
  if fs_is_abs(p) {
    return fs_clean(p)
  }
  if fs_windows() && fs_slash(p).starts_with("/") {
    return fs_clean(fs_volume(fspath.cwd()) + fs_slash(p))
  }
  fs_join(fspath.cwd(), p)
}

// fs_resolve maps an Xo path to an OS path: os.fs takes it as it is, a
// sub capability resolves it against its root and denies (None) a path
// that escapes it.
fn fs_resolve(f: Fs, p: Str) -> Str? {
  if (rt.fs_mode(f) & 1) == 0 {
    if p == "" {
      return Some(".")
    }
    return Some(p)
  }
  let clean = fs_clean("/" + p.replace("\\", "/"))
  if p.contains("..") {
    var depth = 0
    for seg in p.split("/") {
      if seg == ".." {
        depth -= 1
      } else if seg != "" && seg != "." {
        depth += 1
      }
      if depth < 0 {
        return None
      }
    }
  }
  Some(fs_join(rt.fs_root(f), clean))
}

// fs_rel is the path of the OS path op relative to the root (op itself
// for os.fs).
fn fs_rel(f: Fs, op: Str, given: Str) -> Str {
  if (rt.fs_mode(f) & 1) == 0 {
    return fs_slash(op)
  }
  let root = fs_clean(rt.fs_root(f))
  let c = fs_clean(op)
  if c == root {
    return ""
  }
  if root == "/" {
    return c[1..]
  }
  if root.ends_with("/") && c.starts_with(root) {
    return c[root.len()..] // a Windows drive's root, C:/
  }
  if c.starts_with(root + "/") {
    return c[root.len() + 1..]
  }
  given
}

fn fs_check(f: Fs, p: Str, write: Bool) -> Str ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let mode = rt.fs_mode(f)
  if (write && (mode & 2) != 0) || (!write && (mode & 4) != 0) {
    return Err(FsErr.Denied(path: p))
  }
  match fs_resolve(f, p) {
    Some(op) => op
    None => Err(FsErr.Denied(path: p))
  }
}

// fs_info_of is the FileInfo of the facts i of OS path op (sysio.fs_stat).
fn fs_info_of(f: Fs, op: Str, given: Str, i: sysio.Info) -> FileInfo {
  FileInfo{name: fs_base(op), path: fs_rel(f, op, given), is_dir: i.is_dir, size: i.size, modified: Time.UNIX_EPOCH + Duration.from_nanos(i.modified)}
}

fn fs_sub(f: Fs, dir: Str) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.sub(dir)
  }
  match fs_resolve(f, dir) {
    Some(op) => rt.fs_new(fs_abs(op), 1 | (rt.fs_mode(f) & 6))
    None => rt.fs_new(fs_join(rt.fs_root(f), "denied"), 7)
  }
}

// fs_cwd roots the capability at "." when the system gives no working
// directory (WASI preview1 has none): its paths stay relative, so they
// resolve against the working directory's preopen, not against `/`.
fn fs_cwd(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.cwd()
  }
  let w = fspath.cwd()
  rt.fs_new(if w.is_empty() { "." } else { w }, 1 | (rt.fs_mode(f) & 6))
}

// fs_cwd_path is the working directory as os.Getwd gives it (decision
// 0218): $PWD when it names the same directory as getcwd (its links
// kept, the path the shell shows), else getcwd itself (std/llrt/xo_fs.c:
// libc on Darwin, the system call on Linux, GetCurrentDirectoryW on
// Windows, where $PWD is not consulted). Io when getcwd fails.
fn fs_cwd_path(f: Fs) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.cwd_path()
  }
  // outside bytes (decision 0259)
  Ok(scan.text(fs_cwd_path_raw(f)?))
}

fn fs_cwd_path_raw(_f: Fs) -> Str ! FsErr {
  let wasi = match target.os {
    TargetOs.Wasi => true
    TargetOs.Darwin | TargetOs.Linux | TargetOs.Windows => false
  }
  if wasi {
    return Err(FsErr.Io(path: ".", msg: "no working directory under WASI"))
  }
  let w = fspath.cwd()
  if w.is_empty() || w == "." {
    return Err(FsErr.Io(path: ".", msg: "getcwd failed"))
  }
  if fs_windows() {
    return w
  }
  let pwd = rt.env_get("PWD").get(0) ?? ""
  if pwd.starts_with("/") && pwd != w && fs_real_path(pwd) == w {
    return pwd
  }
  w
}

// fs_real_path is the absolute path p with the links of every element
// followed (filepath.EvalSymlinks; what getcwd reports in that
// directory); p cleaned after more than 40 links.
fn fs_real_path(p: Str) -> Str {
  var parts = fs_clean(p).split("/")
  var out = ""
  var i = 0
  var hops = 0
  while i < parts.len() {
    let part = parts[i]
    i += 1
    if part.is_empty() {
      continue
    }
    let q = "${out}/${part}"
    match fsops.read_link(q, q).get(0) {
      Some(t) => {
        hops += 1
        if hops > 40 {
          return fs_clean(p)
        }
        let next = if t.starts_with("/") { t } else { "${if out.is_empty() { "/" } else { out }}/${t}" }
        parts = fs_clean(next).split("/") + parts[i..]
        out = ""
        i = 0
      }
      None => out = q
    }
  }
  if out.is_empty() { "/" } else { out }
}

fn fs_read_only(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_only()
  }
  rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 2)
}

fn fs_write_only(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.write_only()
  }
  rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 4)
}

fn fs_case_sensitive(f: Fs) -> Bool {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.case_sensitive()
  }
  fsops.case_sensitive()
}

fn fs_stat(f: Fs, p: Str) -> FileInfo? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.stat(p)
  }
  let op = fs_check(f, p, false)?
  let i = sysio.fs_stat(op, true, p)
  let st = i.st
  if st == 1 {
    return None
  }
  if st != 0 {
    return Err(fs_err(st, p))
  }
  Some(fs_info_of(f, op, p, i))
}

fn fs_exists(f: Fs, p: Str) -> Bool ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.exists(p)
  }
  let fi = fs_stat(f, p)?
  fi.is_some()
}

/// read_text_or and read_or (std.md 3.1): the file, or default when it
/// does not exist; through Fs's methods, so any Fs (MemFs, a sub or
/// attenuated one) answers as for read_text.
fn read_text_or(fs: Fs, path: Str, default: Str) -> Str ! FsErr uses fs.read {
  match fs.read_text(path) {
    Ok(s) => s
    Err(FsErr.NotFound(path: _)) => default
    Err(e) => Err(e)
  }
}

fn read_or(fs: Fs, path: Str, default: Bytes) -> Bytes ! FsErr uses fs.read {
  match fs.read(path) {
    Ok(b) => b
    Err(FsErr.NotFound(path: _)) => default
    Err(e) => Err(e)
  }
}

fn fs_read(f: Fs, p: Str) -> Bytes ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read(p)
  }
  let op = fs_check(f, p, false)?
  let l = sysio.fs_read(op)
  if l.len() == 0 {
    return Err(fs_err(sysio.status(), p))
  }
  l[0]
}

fn fs_read_text(f: Fs, p: Str) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_text(p)
  }
  let b = fs_read(f, p)?
  // outside bytes: U+FFFD for an invalid sequence (decision 0259)
  scan.text_of(b)
}

/// Each of xs (outside bytes) as scan.text (decision 0259).
fn texts(xs: List[Str]) -> List[Str] {
  var out = List[Str].with_capacity(xs.len())
  for x in xs {
    out.push(scan.text(x))
  }
  out
}

fn fs_read_dir(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_dir(dir)
  }
  let op = fs_check(f, dir, false)?
  let names = fsops.names(op, dir)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out: List[FileInfo] = []
  // in name order, as os.ReadDir: the first failing entry is Go's
  for n in names.sort() {
    let child = fs_join(op, n)
    // the name the program sees: outside bytes (decision 0259); the
    // system's path keeps the bytes
    let xc = fs_join(dir, scan.text(n))
    let i = sysio.fs_stat(child, false, xc)
    // os.File.Readdir: an entry removed since the listing is skipped,
    // any other lstat error is the result
    if i.st == 1 {
      continue
    }
    if i.st != 0 {
      return Err(fs_err(i.st, xc))
    }
    out.push(fs_info_of(f, child, xc, i))
  }
  out.sort_by(fn(fi) { fi.name })
}

fn fs_walk_dir(f: Fs, osdir: Str, xodir: Str, var out: List[FileInfo]) -> () ! FsErr {
  let names = fsops.names(osdir, xodir)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, xodir))
  }
  for n in names.sort() {
    let child = fs_join(osdir, n)
    let xc = fs_join(xodir, scan.text(n))
    let i = sysio.fs_stat(child, false, xc)
    // as fs_read_dir: only an entry removed since the listing is skipped
    if i.st == 1 {
      continue
    }
    if i.st != 0 {
      return Err(fs_err(i.st, xc))
    }
    let fi = fs_info_of(f, child, xc, i)
    out.push(fi)
    if fi.is_dir {
      fs_walk_dir(f, child, xc, out)?
    }
  }
}

fn fs_walk(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.walk(dir)
  }
  let op = fs_check(f, dir, false)?
  let st = sysio.fs_stat(op, true, dir).st
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out: List[FileInfo] = []
  fs_walk_dir(f, op, dir, out)?
  out
}

fn fs_write(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.write(p, data)
  }
  let op = fs_check(f, p, true)?
  let st = sysio.fs_write(op, data, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_create_temp(f: Fs, dir: Str, prefix: Str) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_temp(dir, prefix)
  }
  let op = fs_check(f, dir, true)?
  let name = fspath.create_temp(op, prefix, dir)
  if name == "" {
    return Err(fs_err(sysio.status(), dir))
  }
  // os.CreateTemp joins without cleaning
  var full = op + "/" + name
  if op.ends_with("/") {
    full = op + name
  }
  fs_rel(f, full, fs_join(dir, name))
}

fn fs_rename(f: Fs, from: Str, to: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.rename(from, to)
  }
  let a = fs_check(f, from, true)?
  let b = fs_check(f, to, true)?
  let st = fsops.rename(a, b, from)
  if st != 0 {
    return Err(fs_err(st, from))
  }
}

fn fs_remove(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.remove(p)
  }
  let op = fs_check(f, p, true)?
  let st = fsops.remove(op, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_remove_all(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.remove_all(p)
  }
  let op = fs_check(f, p, true)?
  let st = fspath.remove_all(op, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_create_dir_all(f: Fs, dir: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_dir_all(dir)
  }
  let op = fs_check(f, dir, true)?
  let st = fspath.mkdir_all(op, dir)
  if st != 0 {
    return Err(fs_err(st, dir))
  }
}

fn fs_set_modified(f: Fs, p: Str, t: Time) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.set_modified(p, t)
  }
  let op = fs_check(f, p, true)?
  let st = fsops.chtimes(op, (t - Time.UNIX_EPOCH).nanos(), p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

// ---------------------------------------------------------------------------
// Handles, append, copy, modes, links, globs, locks (std.md 3.1, decisions
// 0163 and 0172): std/rt fsfile.go over std/llrt/xo_fs.c.

struct File {
  h: rt.FsFile
  path: Str
  write: Bool
  /// A test's MemFs file (std/native/testing.xo memfile_*): its number in
  /// the MemFs state; 0 for a file of the real file system
  mem: Int = 0
}

struct FileLock {
  h: rt.FsLock
  /// A test's MemFs lock (std/native/testing.xo memlock_*); 0 for real
  mem: Int = 0
}

fn fs_open_mode(f: Fs, p: Str, mode: Int) -> File ! FsErr {
  let op = fs_check(f, p, mode != 0)?
  let h = fsops.open_file(op, mode, p)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  File{h: h, path: p, write: mode != 0}
}

fn fs_open(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 0)
  }
  fs_open_mode(f, p, 0)
}

// A test's MemFs handles (rt.mem_file and the others; std/native/
// testing.xo memfile_* and memlock_*): the parts only this module sees.

fn llrt_mem_file(id: Int, path: Str, write: Bool) -> File { File{h: fsops.no_file(), path: path, write: write, mem: id} }

fn llrt_mem_file_id(f: File) -> Int { f.mem }

fn llrt_mem_file_path(f: File) -> Str { f.path }

fn llrt_mem_file_writes(f: File) -> Bool { f.write }

fn llrt_mem_lock(id: Int) -> FileLock { FileLock{h: fsops.no_lock(), mem: id} }

fn llrt_mem_lock_id(l: FileLock) -> Int { l.mem }

fn fs_create(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 1)
  }
  fs_open_mode(f, p, 1)
}

fn fs_open_append(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 2)
  }
  fs_open_mode(f, p, 2)
}

fn fs_create_new(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 3)
  }
  fs_open_mode(f, p, 5)
}

/// The state errors of a handle (std/rt File.M_read): canceled, closed,
/// or open for the other direction.
fn file_state(f: File, write: Bool) -> () ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  if fsops.file_closed(f.h) {
    return Err(FsErr.Io(path: f.path, msg: "file already closed"))
  }
  if f.write && !write {
    return Err(FsErr.Io(path: f.path, msg: "file is open for writing"))
  }
  if !f.write && write {
    return Err(FsErr.Io(path: f.path, msg: "file is open for reading"))
  }
}

fn file_read(f: File, max: Int) -> Bytes? ! FsErr {
  file_state(f, false)?
  if max <= 0 {
    return Some(b"")
  }
  let l = fsops.file_read(f.h, max, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  l.get(0)
}

fn file_read_line(f: File) -> Str? ! FsErr {
  file_state(f, false)?
  let l = fsops.file_read_line(f.h, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  match l.get(0) {
    Some(x) => Some(scan.text(x))
    None => None
  }
}

fn file_write(f: File, data: Bytes) -> () ! FsErr {
  file_state(f, true)?
  let st = fsops.file_write(f.h, data, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn file_close(f: File) -> () ! FsErr {
  let st = fsops.file_close(f.h, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn fs_append(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.append(p, data)
  }
  let file = fs_open_mode(f, p, 2)?
  match file_write(file, data) {
    Ok(_) => ()
    Err(e) => {
      match file_close(file) {
        _ => ()
      }
      return Err(e)
    }
  }
  file_close(file)
}

fn fs_copy(f: Fs, from: Str, to: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.copy(from, to)
  }
  let src = fs_check(f, from, false)?
  let dst = fs_check(f, to, true)?
  let st = fsops.copy(src, dst, from, to)
  if st != 0 {
    return Err(fs_err(st, sysio.msg()[0]))
  }
}

fn fs_mode(f: Fs, p: Str) -> Int ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.mode(p)
  }
  let op = fs_check(f, p, false)?
  let m = fsops.perm(op, p)
  if m < 0 {
    return Err(fs_err(sysio.status(), p))
  }
  m
}

fn fs_set_mode(f: Fs, p: Str, mode: Int) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.set_mode(p, mode)
  }
  let op = fs_check(f, p, true)?
  let st = fsops.set_perm(op, mode, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

/// Go's path.Dir of a cleaned path.
fn fs_dir(p: Str) -> Str {
  var i = p.len() - 1
  while i >= 0 && raw.str_byte(p, i) != 47 {
    i -= 1
  }
  fs_clean(raw.str_slice(p, 0, i + 1))
}

/// strings.Trim(s, "/").
fn trim_slashes(s: Str) -> Str {
  var a = 0
  var b = s.len()
  while a < b && raw.str_byte(s, a) == 47 {
    a += 1
  }
  while b > a && raw.str_byte(s, b - 1) == 47 {
    b -= 1
  }
  raw.str_slice(s, a, b)
}

/// Whether a link at link (in a sub capability) to target points outside
/// the root: an absolute target, or more `..` than the link has parents
/// (std/rt linkEscapes).
fn link_escapes(link: Str, target: Str) -> Bool {
  let t = target.replace("\\", "/")
  if t.starts_with("/") || (t.len() >= 2 && raw.str_byte(t, 1) == 58) {
    return true
  }
  let dir = fs_dir(fs_clean("/" + link.replace("\\", "/")))
  var depth = 0
  for seg in (trim_slashes(dir) + "/" + t).split("/") {
    if seg == ".." {
      depth -= 1
    } else if seg != "" && seg != "." {
      depth += 1
    }
    if depth < 0 {
      return true
    }
  }
  false
}

fn fs_symlink(f: Fs, target: Str, link: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.symlink(target, link)
  }
  let op = fs_check(f, link, true)?
  if (rt.fs_mode(f) & 1) != 0 && link_escapes(link, target) {
    return Err(FsErr.Denied(path: link))
  }
  let st = fsops.symlink(target, op, link)
  if st != 0 {
    return Err(fs_err(st, link))
  }
}

fn fs_read_link(f: Fs, p: Str) -> Str? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_link(p)
  }
  let op = fs_check(f, p, false)?
  let l = fsops.read_link(op, p)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  // outside bytes (decision 0259)
  match l.get(0) {
    Some(x) => Some(scan.text(x))
    None => None
  }
}

fn fs_lock_wait(f: Fs, p: Str, wait: Bool) -> FileLock? ! FsErr {
  let op = fs_check(f, p, true)?
  let h = fsops.lock(op, wait, p, false)
  if fsops.lock_held(h) {
    return Some(FileLock{h: h})
  }
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  None
}

fn fs_lock(f: Fs, p: Str) -> FileLock ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.lock_as[FileLock](u, p)
  }
  match fs_lock_wait(f, p, true)? {
    Some(l) => l
    None => Err(FsErr.Canceled)
  }
}

fn fs_try_lock(f: Fs, p: Str) -> FileLock? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.try_lock_as[FileLock](u, p)
  }
  fs_lock_wait(f, p, false)
}

fn filelock_unlock(l: FileLock) { fsops.unlock(l.h) }

// Globs (std/rt fsGlob): Go's path.Match on each segment, `**` for any
// number of directories, through read_dir and exists.

/// Go's path.Match scanChunk: whether stars lead, the chunk, the rest.
fn glob_scan(p: Str) -> (Bool, Str, Str) {
  let n = p.len()
  var i = 0
  var star = false
  while i < n && raw.str_byte(p, i) == 42 {
    i += 1
    star = true
  }
  let start = i
  var inrange = false
  while i < n {
    let c = raw.str_byte(p, i)
    if c == 92 {
      if i + 1 < n {
        i += 1
      }
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 && !inrange {
      break
    }
    i += 1
  }
  (star, raw.str_slice(p, start, i), raw.str_slice(p, i, n))
}

/// Go's path.Match getEsc at chunk[c:]: the rune and the index after it,
/// or the index -1 for a malformed pattern.
fn glob_esc(chunk: Str, c0: Int) -> (Int, Int) {
  let n = chunk.len()
  var c = c0
  if c >= n || raw.str_byte(chunk, c) == 45 || raw.str_byte(chunk, c) == 93 {
    return (0, -1)
  }
  if raw.str_byte(chunk, c) == 92 {
    c += 1
    if c >= n {
      return (0, -1)
    }
  }
  let d = raw.bytes_decode(chunk.bytes(), c)
  let r = d >> 3
  let k = d & 7
  if r == 0xfffd && k == 1 {
    return (0, -1)
  }
  c += k
  if c >= n {
    return (0, -1)
  }
  (r, c)
}

/// Go's path.Match matchChunk of chunk against s[si:]: the index after
/// the match, -1 when it does not match, -2 for a malformed pattern.
fn glob_chunk(chunk: Str, s: Str, si0: Int) -> Int {
  let cn = chunk.len()
  let sn = s.len()
  var c = 0
  var si = si0
  var failed = false
  while c < cn {
    if !failed && si >= sn {
      failed = true
    }
    let ch = raw.str_byte(chunk, c)
    if ch == 91 {
      var r = 0
      if !failed {
        let d = raw.bytes_decode(s.bytes(), si)
        r = d >> 3
        si += d & 7
      }
      c += 1
      var negated = false
      if c < cn && raw.str_byte(chunk, c) == 94 {
        negated = true
        c += 1
      }
      var matched = false
      var nrange = 0
      while true {
        if c < cn && raw.str_byte(chunk, c) == 93 && nrange > 0 {
          c += 1
          break
        }
        let (lo, c1) = glob_esc(chunk, c)
        if c1 < 0 {
          return -2
        }
        c = c1
        var hi = lo
        if raw.str_byte(chunk, c) == 45 {
          let (h2, c2) = glob_esc(chunk, c + 1)
          if c2 < 0 {
            return -2
          }
          hi = h2
          c = c2
        }
        if lo <= r && r <= hi {
          matched = true
        }
        nrange += 1
      }
      if matched == negated {
        failed = true
      }
    } else if ch == 63 {
      if !failed {
        if raw.str_byte(s, si) == 47 {
          failed = true
        }
        si += raw.bytes_decode(s.bytes(), si) & 7
      }
      c += 1
    } else {
      if ch == 92 {
        c += 1
        if c >= cn {
          return -2
        }
      }
      if !failed {
        if raw.str_byte(chunk, c) != raw.str_byte(s, si) {
          failed = true
        }
        si += 1
      }
      c += 1
    }
  }
  if failed {
    return -1
  }
  si
}

/// Go's path.Match: 1 a match, 0 none, -1 a malformed pattern.
fn glob_match(pattern: Str, name: Str) -> Int {
  let nl = name.len()
  var p = pattern
  var ni = 0
  while p.len() > 0 {
    let (star, chunk, rest) = glob_scan(p)
    p = rest
    if star && chunk == "" {
      // a trailing * matches the rest of the name unless it has a /
      if scan.find(raw.str_slice(name, ni, nl), "/", 0) < 0 {
        return 1
      }
      return 0
    }
    let t = glob_chunk(chunk, name, ni)
    if t >= 0 && (t == nl || p.len() > 0) {
      ni = t
      continue
    }
    if t == -2 {
      return -1
    }
    var found = false
    if star {
      // a match after skipping i + 1 bytes, never a /
      var i = ni
      while !found && i < nl && raw.str_byte(name, i) != 47 {
        let t2 = glob_chunk(chunk, name, i + 1)
        if t2 >= 0 {
          if p.len() > 0 || t2 == nl {
            ni = t2
            found = true
          }
        } else if t2 == -2 {
          return -1
        }
        i += 1
      }
    }
    if found {
      continue
    }
    // the rest of the pattern must still be well formed
    while p.len() > 0 {
      let (_, c2, r2) = glob_scan(p)
      p = r2
      if glob_chunk(c2, "", 0) == -2 {
        return -1
      }
    }
    return 0
  }
  if ni == nl {
    return 1
  }
  0
}

fn glob_join(dir: Str, name: Str) -> Str {
  if dir == "" {
    return name
  }
  if dir.ends_with("/") {
    return dir + name
  }
  dir + "/" + name
}

fn glob_list(f: Fs, dir: Str) -> List[FileInfo] ! FsErr uses fs.read {
  var d = dir
  if d == "" {
    d = "."
  }
  match f.read_dir(d) {
    Ok(l) => l
    Err(e) => {
      match e {
        FsErr.NotFound(_) | FsErr.NotDir(_) => []
        _ => Err(e)
      }
    }
  }
}

fn glob_walk(f: Fs, segs: List[Str], dir: Str, i: Int, var out: List[Str], var seen: Set[Str]) -> () ! FsErr uses fs.read {
  if i == segs.len() {
    if !seen.contains(dir) {
      seen.add(dir)
      out.push(dir)
    }
    return
  }
  let s = segs[i]
  if s == "**" {
    glob_walk(f, segs, dir, i + 1, out, seen)?
    for x in glob_list(f, dir)? {
      if x.is_dir && !x.name.starts_with(".") {
        glob_walk(f, segs, glob_join(dir, x.name), i, out, seen)?
      }
    }
    return
  }
  if !(s.contains("*") || s.contains("?") || s.contains("[") || s.contains("\\")) {
    // a literal segment: no listing needed
    let p = glob_join(dir, s)
    if i == segs.len() - 1 {
      if f.exists(p)? && !seen.contains(p) {
        seen.add(p)
        out.push(p)
      }
      return
    }
    return glob_walk(f, segs, p, i + 1, out, seen)
  }
  for x in glob_list(f, dir)? {
    if x.name.starts_with(".") && !s.starts_with(".") {
      continue
    }
    if glob_match(s, x.name) != 1 {
      continue
    }
    if i < segs.len() - 1 && !x.is_dir {
      continue
    }
    glob_walk(f, segs, glob_join(dir, x.name), i + 1, out, seen)?
  }
}

fn fs_glob(f: Fs, pattern: Str) -> List[Str] ! FsErr uses fs.read {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.glob(pattern)
  }
  let pat = pattern.replace("\\", "/")
  let segs = trim_slashes(pat).split("/")
  for s in segs {
    if glob_match(s, "") < 0 {
      return Err(FsErr.Io(path: pat, msg: "bad pattern: syntax error in pattern"))
    }
  }
  var start = ""
  if pat.starts_with("/") {
    start = "/"
  }
  var out: List[Str] = []
  var seen: Set[Str] = #{}
  glob_walk(f, segs, start, 0, out, seen)?
  out.sort()
}

// ---------------------------------------------------------------------------
// Stdio (std.md 3.6, decisions 0088 and 0102): std/rt caps.go's realStdio

fn stdio_write(_s: Stdio, data: Bytes) -> () ! IoErr {
  if rt.fs_canceled() {
    return Err(IoErr.Canceled)
  }
  stdiort.out(raw.bytes_addr(data), data.len(), false)
}

fn stdin_err(st: Int, msg: Str) -> IoErr {
  if st == 2 {
    return IoErr.Io(msg: msg)
  }
  IoErr.Canceled
}

// ---------------------------------------------------------------------------
// Rand.shuffle (std.md 3.4): Fisher-Yates from the end, one `int` per
// step, as std/rt's Rand_shuffle (the same seeded order in tests)

fn rand_shuffle[T](r: Rand, xs: List[T]) -> List[T] {
  var out = xs
  var i = out.len() - 1
  while i > 0 {
    let j = r.int(0, i + 1)
    let a = out[i]
    out[i] = out[j]
    out[j] = a
    i -= 1
  }
  out
}

// ---------------------------------------------------------------------------
// Proc (std.md 3.7, decision 0107)

fn proc_run(p: Proc, cmd: Str, args: List[Str]) -> ProcOutput ! ProcErr {
  if !cap_admits(rt.proc_lists(p), cmd) {
    return Err(ProcErr.Denied(cmd))
  }
  var r: List[Str] = []
  if testworld.fake(testworld.REAL_PROC) {
    // FakeProc.on_run's outputs (std/native/llrt/testworld.xo)
    r = if rt.fs_canceled() { ["3", ""] } else { testworld.proc_run(cmd) }
  } else {
    // std/native/llrt/proc.xo (work item B25)
    r = proc.run(cmd, args)
  }
  let st = r.get(0) ?? "2"
  let detail = r.get(1) ?? ""
  if st == "1" {
    return Err(ProcErr.NotFound(cmd))
  }
  if st == "2" {
    return Err(ProcErr.Io(detail))
  }
  if st == "3" {
    return Err(ProcErr.Canceled)
  }
  ProcOutput{code: text.parse_int(detail) ?? 0, stdout: (r.get(2) ?? "").bytes(), stderr: (r.get(3) ?? "").bytes()}
}

// ---------------------------------------------------------------------------
// Attenuation (std.md 3.5 and 3.7, decisions 0156 and 0172): std/rt
// attenuate.go. A Proc, Env, or Net is the lists of its attenuations in one Str:
// each list is \u{1} and then its names, each followed by \u{0}; "" has
// none. Every list must admit a name.

fn cap_lists_add(lists: Str, names: List[Str]) -> Str {
  var b = lists + "\u{1}"
  for n in names {
    b = b + n + "\u{0}"
  }
  b
}

fn cap_admits(lists: Str, name: Str) -> Bool {
  if lists == "" {
    return true
  }
  let want = "\u{0}" + name + "\u{0}"
  var first = true
  for l in lists.split("\u{1}") {
    if first {
      first = false
      continue
    }
    if !("\u{0}" + l).contains(want) {
      return false
    }
  }
  true
}

/// Proc.kill (std.md 3.7, decision 0190): std/rt prockill.go. An
/// attenuated Proc must list "kill"; std/native/llrt/proc.xo sends the
/// signal, or records it for a test's FakeProc.
fn proc_kill(p: Proc, pid: Int, signal: Str = "TERM") -> () ! ProcErr uses proc {
  if !cap_admits(rt.proc_lists(p), "kill") {
    return Err(ProcErr.Denied("kill"))
  }
  let names = ["HUP", "INT", "QUIT", "KILL", "TERM", "USR1", "USR2", "CONT", "STOP"]
  var sig = -1
  for (i, n) in names.indexed() {
    if n == signal {
      sig = i
    }
  }
  if sig < 0 {
    return Err(ProcErr.Io("unknown signal ${signal.quote()}"))
  }
  if pid <= 0 {
    // 0 and negative pids name process groups: never sent
    return Err(ProcErr.Io("invalid process id ${pid}"))
  }
  match proc.kill(pid, sig).get(0) {
    Some(msg) => Err(ProcErr.Io(msg))
    None => Ok(())
  }
}

/// FakeProc.killed, as the SSA builder calls it (compiler/ssa testmode.xo):
/// the recorded signals, oldest first.
fn llrt_proc_killed() -> List[Str] { proc.killed() }

fn proc_only(p: Proc, cmds: List[Str]) -> Proc { rt.proc_new(cap_lists_add(rt.proc_lists(p), cmds)) }

/// Whether the lists of an Env admit variable name: on Windows without
/// ASCII case, as its environment (and Go's os) compares names, so
/// `only(["PATH"])` admits the `Path` Windows sets and `get("path")`.
fn env_admits(lists: Str, name: Str) -> Bool {
  match target.os {
    TargetOs.Windows => cap_admits(lists.to_lower(), name.to_lower())
    _ => cap_admits(lists, name)
  }
}

fn env_only(e: Env, names: List[Str]) -> Env { rt.env_new(cap_lists_add(rt.env_lists(e), names)) }

/// Net.only (decision 0175): the entries trimmed and lowered (std/rt's
/// normHosts); the C runtime checks dial and listen against the lists
/// (net_admits_addr), std/native/http.xo each request and http1.xo a
/// client's redirects.
fn net_only(n: Net, hosts: List[Str]) -> Net {
  var norm: List[Str] = []
  for h in hosts {
    let t = h.trim()
    if t.len() >= 5 && t[0..5].to_lower() == "unix:" {
      // a socket path keeps its case (decision 0190)
      norm.push("unix:" + t[5..])
    } else {
      norm.push(t.to_lower())
    }
  }
  rt.net_new(cap_lists_add(rt.net_lists(n), norm))
}

fn env_get(e: Env, name: Str) -> Str? uses env {
  if !env_admits(rt.env_lists(e), name) {
    return None
  }
  rt.env_get(name).get(0)
}

fn env_vars(e: Env) -> Map[Str, Str] uses env {
  let lists = rt.env_lists(e)
  var m: Map[Str, Str] = {}
  for kv in rt.env_vars() {
    var k = kv
    var v = ""
    match kv.find("=") {
      Some(i) => {
        k = kv[0..i]
        v = kv[i + 1..]
      }
      None => ()
    }
    if env_admits(lists, k) {
      m.put(k, v)
    }
  }
  m
}

/// os.UserHomeDir: $HOME (on Windows %USERPROFILE% with / separators,
/// read when the Env admits HOME), or Missing("HOME").
fn env_home(e: Env) -> Str ! EnvErr uses env {
  if fs_windows() {
    if !env_admits(rt.env_lists(e), "HOME") {
      return Err(EnvErr.Missing(name: "HOME"))
    }
    match rt.env_get("USERPROFILE").get(0) {
      Some(h) => {
        if h != "" {
          return fs_slash(h)
        }
      }
      None => ()
    }
    return Err(EnvErr.Missing(name: "HOME"))
  }
  match env_get(e, "HOME") {
    Some(h) => {
      if h != "" {
        return h
      }
    }
    None => ()
  }
  Err(EnvErr.Missing(name: "HOME"))
}

// ---------------------------------------------------------------------------
// Commands, children, and pipelines (std.md 3.8, decisions 0161 and 0172):
// std/rt proccmd.go. A Cmd is a value that remembers the attenuation of
// the Proc that made it; a Child is a handle of the C runtime
// (std/llrt/xo_proc.c).

struct Cmd {
  lists: Str
  name: Str
  args: List[Str]
  dir: Str
  env: List[Str]
  env_set: Bool
  extra: List[Str]
  input: Bytes
  has_input: Bool
  inherit: Bool
  merge: Bool
}

struct Child {
  h: rt.ProcChild
}

fn proc_cmd(p: Proc, name: Str, args: List[Str] = []) -> Cmd {
  Cmd{lists: rt.proc_lists(p), name: name, args: args, dir: "", env: [], env_set: false, extra: [], input: b"", has_input: false, inherit: false, merge: false}
}

fn cmd_dir(c: Cmd, path: Str) -> Cmd {
  var x = c
  x.dir = path
  x
}

/// The child's environment is exactly the variables e shows now.
fn cmd_env(c: Cmd, e: Env) -> Cmd uses env {
  var x = c
  var env: List[Str] = []
  for (k, v) in e.vars().entries() {
    env.push(k + "=" + v)
  }
  x.env = env
  x.env_set = true
  x
}

fn cmd_set_env(c: Cmd, name: Str, value: Str) -> Cmd {
  var x = c
  x.extra.push(name + "=" + value)
  x
}

fn cmd_stdin(c: Cmd, data: Bytes) -> Cmd {
  var x = c
  x.input = data
  x.has_input = true
  x
}

fn cmd_inherit(c: Cmd) -> Cmd {
  var x = c
  x.inherit = true
  x
}

fn cmd_merge_stderr(c: Cmd) -> Cmd {
  var x = c
  x.merge = true
  x
}

/// The spec of c for the runtime (std/native/rt.xo proc_exec), appended
/// to out.
fn cmd_spec(c: Cmd, var out: List[Str]) {
  var flags = 0
  if c.env_set {
    flags = flags | 1
  }
  if c.inherit {
    flags = flags | 2
  }
  if c.merge {
    flags = flags | 4
  }
  // the environment and the Windows command line (decision 0193 step 6)
  procspec.spec(c.name, c.dir, flags, c.args, c.env, c.extra, out)
}

/// The ProcErr of a failed outcome (status st, detail d).
fn proc_err(st: Str, d: Str) -> ProcErr {
  match st {
    "1" => ProcErr.NotFound(d)
    "2" => ProcErr.Io(d)
    _ => ProcErr.Canceled
  }
}

fn proc_outcome(r: List[Str]) -> ProcOutput ! ProcErr {
  let st = r.get(0) ?? "2"
  let d = r.get(1) ?? ""
  if st != "0" {
    return Err(proc_err(st, d))
  }
  ProcOutput{code: text.parse_int(d) ?? 0, stdout: (r.get(2) ?? "").bytes(), stderr: (r.get(3) ?? "").bytes()}
}

/// proc.xo exec of the specs, or in the test world the outputs
/// FakeProc.on_run registered (std/native/llrt/testworld.xo): canceled,
/// no command, or std/rt's fakeProc output, runTerm, and pipeline.
fn proc_exec(spec: List[Str], input: Bytes, has_input: Bool, mode: Int) -> List[Str] {
  if !testworld.fake(testworld.REAL_PROC) {
    // std/native/llrt/proc.xo (work item B25)
    return proc.exec(spec, input, has_input, mode)
  }
  if rt.fs_canceled() {
    return ["3", ""]
  }
  if spec.is_empty() {
    return ["0", "0", "", ""]
  }
  testworld.proc_exec(spec, mode)
}

/// Denied or Canceled before c runs (std/rt Cmd.M_output).
fn cmd_check(c: Cmd) -> () ! ProcErr {
  if !cap_admits(c.lists, c.name) {
    return Err(ProcErr.Denied(c.name))
  }
  if rt.fs_canceled() {
    return Err(ProcErr.Canceled)
  }
}

fn cmd_output(c: Cmd) -> ProcOutput ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  proc_outcome(proc_exec(spec, c.input, c.has_input, 0))
}

fn cmd_run(c: Cmd) -> Int ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  let out = proc_outcome(proc_exec(spec, c.input, c.has_input, 1))?
  out.code
}

fn cmd_spawn(c: Cmd) -> Child ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  // std/native/llrt/proc.xo's children (work item B25)
  let h = proc.spawn(spec, c.input, c.has_input)
  let r = proc.child_start(h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Child{h: h}
}

fn proc_pipeline(p: Proc, cmds: List[Cmd]) -> ProcOutput ! ProcErr uses proc {
  let lists = rt.proc_lists(p)
  for c in cmds {
    if !cap_admits(lists, c.name) {
      return Err(ProcErr.Denied(c.name))
    }
  }
  if cmds.is_empty() {
    return ProcOutput{code: 0, stdout: b"", stderr: b""}
  }
  var spec: List[Str] = []
  for c in cmds {
    if !cap_admits(c.lists, c.name) {
      return Err(ProcErr.Denied(c.name))
    }
    cmd_spec(c, spec)
  }
  if rt.fs_canceled() {
    return Err(ProcErr.Canceled)
  }
  proc_outcome(proc_exec(spec, cmds[0].input, cmds[0].has_input, 2))
}

fn child_pid(c: Child) -> Int { proc.child_pid(c.h) }

fn child_write(c: Child, data: Bytes) -> () ! ProcErr uses proc {
  let r = proc.child_write(c.h, data)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
}

fn child_close_stdin(c: Child) { proc.child_close_stdin(c.h) }

fn child_read_from(c: Child, err: Bool, max: Int) -> Bytes? ! ProcErr {
  let r = proc.child_read(c.h, err, max)
  let st = r.get(0) ?? "2"
  if st == "e" {
    return None
  }
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Some((r.get(1) ?? "").bytes())
}

fn child_read(c: Child, max: Int) -> Bytes? ! ProcErr uses proc { child_read_from(c, false, max) }

fn child_read_err(c: Child, max: Int) -> Bytes? ! ProcErr uses proc { child_read_from(c, true, max) }

fn child_read_line(c: Child) -> Str? ! ProcErr uses proc {
  let r = proc.child_read_line(c.h)
  let st = r.get(0) ?? "2"
  if st == "e" {
    return None
  }
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Some(scan.text(r.get(1) ?? ""))
}

fn child_wait(c: Child) -> Int ! ProcErr uses proc {
  let r = proc.child_wait(c.h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  text.parse_int(r.get(1) ?? "0") ?? 0
}

fn child_kill(c: Child) { proc.child_kill(c.h) }

fn stdio_read_line(_s: Stdio) -> Str? ! IoErr {
  let (line, st, msg) = stdinrt.read(false)
  if st == 0 {
    return Some(scan.text(line))
  }
  if st == 1 {
    return None
  }
  Err(stdin_err(st, msg))
}

fn stdio_read_all(_s: Stdio) -> Str ! IoErr {
  let (text, st, msg) = stdinrt.read(true)
  if st == 0 {
    return scan.text(text)
  }
  Err(stdin_err(st, msg))
}

fn stdio_lines(s: Stdio) -> List[Str] ! IoErr {
  let text = stdio_read_all(s)?
  text.lines()
}

// User directories (std.md 3.5, decision 0163): std/rt's userDir, read
// through the Env.

fn env_user_dir(e: Env, cache: Bool) -> Str ! EnvErr uses env {
  var xdg = "XDG_CONFIG_HOME"
  var mac = "/Library/Application Support"
  var unix = "/.config"
  if cache {
    xdg = "XDG_CACHE_HOME"
    mac = "/Library/Caches"
    unix = "/.cache"
  }
  match e.get(xdg) {
    Some(v) => {
      if v.starts_with("/") || (v.len() >= 3 && v[1..2] == ":") {
        return fs_slash(v)
      }
    }
    None => ()
  }
  if fs_windows() {
    // %AppData% and %LocalAppData% (std/rt userDir)
    let win = if cache { "LocalAppData" } else { "AppData" }
    let v = e.get(win) ?? ""
    if v == "" {
      return Err(EnvErr.Missing(name: win))
    }
    return v.replace("\\", "/")
  }
  let home = match e.get("HOME") {
    Some(h) => h
    None => ""
  }
  if home == "" {
    return Err(EnvErr.Missing(name: "HOME"))
  }
  let base = home.trim_suffix("/")
  match target.os {
    TargetOs.Darwin => base + mac
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => base + unix
  }
}

fn env_config_dir(e: Env) -> Str ! EnvErr uses env { env_user_dir(e, false) }

fn env_cache_dir(e: Env) -> Str ! EnvErr uses env { env_user_dir(e, true) }

// Terminals (std.md 3.6, decision 0162): std/rt's term.go.

fn stdio_stdin_is_tty(_s: Stdio) -> Bool { stdinrt.isatty(0) }

fn stdio_stdout_is_tty(_s: Stdio) -> Bool { stdinrt.isatty(1) }

fn stdio_stderr_is_tty(_s: Stdio) -> Bool { stdinrt.isatty(2) }

fn stdio_width(_s: Stdio) -> Int? {
  let w = stdinrt.term_width()
  if w > 0 {
    return Some(w)
  }
  None
}

/// The prompt on standard error, then a line read with the terminal's
/// echo off; the newline the user typed was not echoed, so one is written.
fn stdio_read_secret(s: Stdio, prompt: Str) -> Str? ! IoErr {
  s.eprint(prompt)
  let off = stdinrt.echo(false)
  defer {
    if off {
      stdinrt.echo(true)
      s.eprint("\n")
    }
  }
  stdio_read_line(s)
}

fn stdio_read_bytes(_s: Stdio, max: Int) -> Bytes? ! IoErr {
  if max <= 0 {
    return Some(b"")
  }
  let (data, st, msg) = stdinrt.read_bytes(max.min(1048576))
  if st == 0 {
    return Some(data)
  }
  if st == 1 {
    return None
  }
  Err(stdin_err(st, msg))
}

fn stdio_read_all_bytes(s: Stdio) -> Bytes ! IoErr {
  let text = stdio_read_all(s)?
  text.bytes()
}

/// math.Round(s * 1e9) nanoseconds (std/rt's Duration_from_secs).
fn duration_from_secs(s: Float) -> Duration { Duration.from_nanos(Int((s * 1000000000.0).round())) }

/// math.Round(d * f) nanoseconds.
fn duration_scale(d: Duration, f: Float) -> Duration { Duration.from_nanos(Int((Float(d.nanos()) * f).round())) }

fn duration_ceil_seconds(d: Duration) -> Int {
  let n = d.nanos()
  if n % 1000000000 > 0 {
    return n / 1000000000 + 1
  }
  n / 1000000000
}

// ---------------------------------------------------------------------------
// Time (std.md 2.6)

/// time.Parse(time.RFC3339Nano, s) as the Go backend calls it: the union
/// of Go's fast path (parseRFC3339) and its general parser for that
/// layout, which also takes a one digit hour, a comma before the
/// fraction, and offsets up to +24:60. Times outside the range of Time
/// wrap like Go's UnixNano.
fn time_parse_rfc3339(s: Str) -> Time? {
  let b = s.bytes()
  let n = b.len()
  if n < 4 || !rfc_digits(b, 0, 4) {
    return None
  }
  let year = rfc_num(b, 0, 4)
  if n < 10 || b[4] != 45 || !rfc_digits(b, 5, 2) || b[7] != 45 || !rfc_digits(b, 8, 2) {
    return None
  }
  let month = rfc_num(b, 5, 2)
  let day = rfc_num(b, 8, 2)
  if month < 1 || month > 12 || n < 12 || b[10] != 84 || !rfc_digits(b, 11, 1) {
    return None
  }
  // the hour has one or two digits
  var i = 12
  var hour = rfc_num(b, 11, 1)
  if rfc_digits(b, 12, 1) {
    hour = rfc_num(b, 11, 2)
    i = 13
  }
  if hour > 23 || i + 6 > n || b[i] != 58 || !rfc_digits(b, i + 1, 2) || b[i + 3] != 58 || !rfc_digits(b, i + 4, 2) {
    return None
  }
  let min = rfc_num(b, i + 1, 2)
  let sec = rfc_num(b, i + 4, 2)
  if min > 59 || sec > 59 {
    return None
  }
  i += 6
  var nsec = 0
  if i + 1 < n && (b[i] == 46 || b[i] == 44) && rfc_digits(b, i + 1, 1) {
    var j = i + 1
    while j < n && rfc_digits(b, j, 1) {
      j += 1
    }
    // at most 9 digits count (parseNanoseconds)
    var k = 0
    while k < 9 {
      nsec = nsec * 10
      if i + 1 + k < j {
        nsec += Int(b[i + 1 + k]) - 48
      }
      k += 1
    }
    i = j
  }
  var zone = 0
  if i < n && b[i] == 90 {
    i += 1
  } else {
    if i + 6 > n || b[i + 3] != 58 || !rfc_digits(b, i + 1, 2) || !rfc_digits(b, i + 4, 2) {
      return None
    }
    let hr = rfc_num(b, i + 1, 2)
    let mm = rfc_num(b, i + 4, 2)
    if hr > 24 || mm > 60 {
      return None
    }
    zone = (hr * 60 + mm) * 60
    if b[i] == 45 {
      zone = -zone
    } else if b[i] != 43 {
      return None
    }
    i += 6
  }
  if i != n || day < 1 || day > rfc_days_in(month, year) {
    return None
  }
  let secs = rfc_days(year, month, day) * 86400 + hour * 3600 + min * 60 + sec - zone
  Some(Time.UNIX_EPOCH + Duration.from_nanos(rt.int_wrap(0, rt.int_wrap(2, secs, 1000000000), nsec)))
}

fn rfc_digits(b: Bytes, at: Int, k: Int) -> Bool {
  if at + k > b.len() {
    return false
  }
  for i in at..at + k {
    if b[i] < 48 || b[i] > 57 {
      return false
    }
  }
  true
}

fn rfc_num(b: Bytes, at: Int, k: Int) -> Int {
  var v = 0
  for i in at..at + k {
    v = v * 10 + Int(b[i]) - 48
  }
  v
}

fn rfc_days_in(m: Int, y: Int) -> Int {
  if m == 2 {
    if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  31
}

/// RFC 3339 in UTC: the Display text of a Time.
fn time_format_rfc3339(t: Time) -> Str { "${t}" }

/// The days from 1970-01-01 to y-m-d (H. Hinnant's days_from_civil).
fn rfc_days(year: Int, m: Int, d: Int) -> Int {
  var y = year
  if m <= 2 {
    y -= 1
  }
  var era = y / 400
  if y < 0 && y % 400 != 0 {
    era -= 1
  }
  let yoe = y - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

// ---------------------------------------------------------------------------
// The runtime's text, as the SSA builder calls it (decision 0193):
// Display and Debug of Duration, Time, Str, and Bytes, and std/json's
// Duration and Time, in Xo (std/native/llrt/text.xo; decision 0227
// deleted the C path).

fn llrt_append_duration(s: Str, d: Int) -> Str { text.append_duration(s, d) }

fn llrt_append_time(s: Str, t: Int) -> Str { text.append_time(s, t) }

fn llrt_append_quote(s: Str, t: Str) -> Str { text.append_quote(s, t.bytes()) }

fn llrt_append_bytes_quote(s: Str, b: Bytes) -> Str { text.append_quote(s, b) }

fn llrt_duration_ok(s: Str) -> Bool {
  match text.parse_duration(s) {
    Some(_) => true
    None => false
  }
}

fn llrt_duration(s: Str) -> Int { text.parse_duration(s) ?? 0 }

fn llrt_time_ok(s: Str) -> Bool {
  match text.parse_time(s) {
    Some(_) => true
    None => false
  }
}

fn llrt_time(s: Str) -> Int { text.parse_time(s) ?? 0 }

// Clock.now and Clock.since, as the SSA builders call them (decision
// 0206): a system call from Xo on Linux (std/native/llrt/sysio.xo), the
// C runtime elsewhere.

fn llrt_clock_now() -> Int { sysio.clock_now() }

// The number text, as the SSA builder calls it for every interpolation
// and Display of an Int or Float (decision 0193 step 3): in Xo
// (std/native/llrt/num.xo). Decision 0198 deleted its C path
// (XO_LLRT_C=num, the C runtime's str.concat_int and friends).

fn llrt_concat_int(s: Str, v: Int) -> Str { num.append_int(s, v) }

fn llrt_concat_float(s: Str, f: Float) -> Str { num.append_float(s, f) }

// The leaf text of Display and Debug (decision 0193 step 5): a Rune's
// Display and Debug, a UInt64's text. In Xo (std/native/llrt/show.xo;
// decision 0198 deleted the C path).

fn llrt_append_rune(s: Str, r: Int) -> Str { show.append_rune(s, r) }

fn llrt_append_rune_quote(s: Str, r: Int) -> Str { show.append_rune_quote(s, r) }

fn llrt_append_u64(s: Str, v: Int) -> Str { show.append_u64(s, v) }

// Atomic's add and max (decision 0200): in Xo over the runtime's atomics
// (std/native/llrt/atomic.xo); the SSA builders lower get, set, swap, and
// compare_and_swap inline. Decision 0198 deleted the C path
// (`XO_LLRT_C=atomic`).

fn llrt_atomic_add(a: Atomic[Int], n: Int, at: rt.Loc) -> Int { atomic.add(a, n, at) }

fn llrt_atomic_max(a: Atomic[Int], n: Int) -> Int { atomic.max(a, n) }

// The report of a property test's case to the harness (decision 0193
// step 5): in Xo (std/native/llrt/report.xo; decision 0198 deleted the C
// path).

fn llrt_prop_report(g: Int, input: Str) { report.prop_report(g, input) }

// The dependency that writes the next log record (decision 0173), as
// the SSA builder sets it before a dependency's call of std/log: a
// thread local word in Xo (std/native/llrt/logstate.xo, work item B02).

fn llrt_log_from(s: Str) { logstate.set_from(s) }

// Stdio.print, println, eprint, and eprintln, and the SSA builder's own
// messages to standard error (an error main returned, a fault's trace):
// in Xo (std/native/llrt/stdio.xo, the zero-C audit's work item B03).

fn llrt_print(s: Str) { stdiort.print(s, false) }

fn llrt_println(s: Str) { stdiort.print(s, true) }

fn llrt_eprint(s: Str) { stdiort.eprint(s, false) }

fn llrt_eprintln(s: Str) { stdiort.eprint(s, true) }

/// rt.fs_canceled (the SSA builders call this in its place; a wasm
/// module's runtime serves rt.fs_canceled): whether an Fs operation
/// reports Canceled, the task canceled and not in deferred code (std/rt
/// Task.Canceled is shield aware too). xo_fs.c's xo_fs_canceled before.
fn llrt_fs_canceled() -> Bool { poll.canceled() }

/// os.proc.exit, and the end of a program whose main returned an error
/// (std/native/llrt/process.xo).
fn llrt_exit(code: Int) {
  if testworld.on() {
    // a test binary (twrun.xo exit): inside testing.run_main main
    // unwinds back to it; else the test ends here and passes
    if !twrun.exit(code) {
      process.os_exit(0)
    }
    return
  }
  process.exit(code)
}

/// `s[lo..hi]` on a Str (compiler/ssa expr.xo; was xo_bytes.c's): the
/// range must be one of s, its ends on UTF-8 boundaries.
fn llrt_str_slice_chk(s: Str, lo: Int, hi: Int, loc: Str) {
  slice_check(lo, hi, s.len(), "Str", loc)
  let p = raw.data(s)
  let n = s.len()
  if (lo < n && rt.mem_load(p, lo, 1) & 0xC0 == 0x80) || (hi < n && rt.mem_load(p, hi, 1) & 0xC0 == 0x80) {
    fault.raise_str_at("slice ${lo}..${hi} of Str splits a UTF-8 sequence", raw.data(loc), loc.len())
  }
}

/// The check of `b[lo..hi]` on Bytes (the compiler then builds the view).
fn llrt_bytes_slice_chk(b: Bytes, lo: Int, hi: Int, loc: Str) {
  slice_check(lo, hi, b.len(), "Bytes", loc)
}

fn llrt_str_slice_at(s: Str, lo: Int, hi: Int, loc: Str) -> Str {
  slice_check(lo, hi, s.len(), "Str", loc)
  let p = raw.data(s)
  let n = s.len()
  if (lo < n && rt.mem_load(p, lo, 1) & 0xC0 == 0x80) || (hi < n && rt.mem_load(p, hi, 1) & 0xC0 == 0x80) {
    fault.raise_str_at("slice ${lo}..${hi} of Str splits a UTF-8 sequence", raw.data(loc), loc.len())
  }
  raw.str_at(p + lo, hi - lo)
}

/// `b[lo..hi]` on Bytes.
/// A List[Int] of the little endian 8 byte words of b: a constant List
/// of Int literals kept as data (compiler/ssa show.xo int_list_data), read
/// once at the constant's first use.
fn llrt_list_of_le64(b: Bytes) -> List[Int] {
  let n = b.len() / 8
  var out = List[Int].with_capacity(n)
  let a = raw.bytes_addr(b)
  for i in 0..n {
    out.push(rt.mem_load(a, rt.int_wrap(3, i, 3), 8))
  }
  out
}

fn llrt_bytes_slice_at(b: Bytes, lo: Int, hi: Int, loc: Str) -> Bytes {
  slice_check(lo, hi, b.len(), "Bytes", loc)
  raw.str_at(raw.bytes_addr(b) + lo, hi - lo).bytes()
}

/// Faults unless lo..hi is a range of a value of length n (std/rt's
/// StrSlice, BytesSlice).
fn slice_check(lo: Int, hi: Int, n: Int, what: Str, loc: Str) {
  if lo < 0 || hi > n || lo > hi {
    fault.raise_str_at("slice ${lo}..${hi} out of range for ${what} of length ${n}", raw.data(loc), loc.len())
  }
}

/// The clamped slice and the repeat of the SSA builders' show and
/// assertion texts (compiler/ssa show.xo; was xo_std.c's).
fn llrt_str_slice(s: Str, lo: Int, hi: Int) -> Str { raw.str_slice(s, lo, hi) }

fn llrt_str_repeat(s: Str, n: Int) -> Str { raw.str_repeat(s, n) }

/// BytesBuilder.write_rune (the SSA builders call it with a Rune value).
fn llrt_rs_push_rune(s: Str, r: Rune) -> Str { raw.push_rune(s, Int(r)) }

/// `stdio.set_tty(width)` of a test binary (compiler/ssa testmode.xo).
fn llrt_tw_set_tty(width: Int) { stdinrt.set_tty(width) }

// The program's arguments and environment, for Env.args, Env.program,
// and the runtime calls rt.env_get and rt.env_vars (std/native/llrt/process.xo).

// the environment and arguments: outside bytes (decision 0259)
fn llrt_env_args() -> List[Str] { texts(process.args()) }

fn llrt_env_program() -> List[Str] { [scan.text(process.program())] }

fn llrt_env_get(name: Str) -> List[Str] { texts(process.env_get(name)) }

fn llrt_env_vars() -> List[Str] { texts(process.env_vars()) }

// std/json's tape readers and text, as the decoders and encoders the SSA
// builder generates per type call them (decision 0193 step 4): in Xo
// (std/native/llrt/jsontext.xo). Decision 0198 deleted its C path
// (XO_LLRT_C=jsontext, the C runtime's json_str and friends).

fn llrt_json_next(tape: List[Int], i: Int) -> Int { jsontext.next(tape, i) }

fn llrt_json_str(src: Bytes, tape: List[Int], i: Int) -> Str { jsontext.str_at(src, tape, i) }

fn llrt_json_find(src: Bytes, tape: List[Int], i: Int, key: Str) -> Int { jsontext.find(src, tape, i, key) }

fn llrt_json_members(src: Bytes, tape: List[Int], i: Int) -> List[Int] { jsontext.members(src, tape, i) }

fn llrt_json_int_ok(src: Bytes, tape: List[Int], i: Int) -> Bool { jsontext.int_ok(src, tape, i) }

fn llrt_json_int(src: Bytes, tape: List[Int], i: Int) -> Int { jsontext.int_at(src, tape, i) }

fn llrt_json_float_ok(src: Bytes, tape: List[Int], i: Int) -> Bool { jsontext.float_ok(src, tape, i) }

fn llrt_json_float(src: Bytes, tape: List[Int], i: Int) -> Float { jsontext.float_at(src, tape, i) }

fn llrt_rs_append_json_str(s: Str, t: Str) -> Str { jsontext.append_str(s, t) }

fn llrt_rs_append_json_body(s: Str, t: Str) -> Str { jsontext.append_body(s, t) }

fn llrt_rs_append_json_float(s: Str, f: Float) -> Str { jsontext.append_float(s, f) }

fn llrt_rs_append_b64_quoted(s: Str, b: Bytes) -> Str { jsontext.append_b64(s, b) }

fn llrt_b64_ok(s: Str) -> Bool { jsontext.b64_ok(s) }

fn llrt_b64_decode(s: Str) -> Bytes { jsontext.b64_decode(s) }

// The integer operations of generated code (the zero-C audit's portable
// group, decisions 0193 and 0195): in Xo (std/native/llrt/ints.xo). The
// SSA builders lower a sized integer operation inline and call the
// faults here when its check fails. Decision 0198 deleted the C path
// (`XO_LLRT_C=ints`).

