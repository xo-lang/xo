/// Float to a sized integer type out of range or NaN: Go's text, the
/// type the program named and the value it had (std/rt FloatToInt).
fn llrt_float_conv_fault(f: Float, bits: Int, uns: Int, at: Str) -> Never {
  let ty = ints.type_name(bits, uns)
  if f != f {
    rt.fault_raise("cannot convert NaN to ${ty}", at)
  }
  rt.fault_raise("${num.go_g_text(f)} is out of range for ${ty}", at)
}

