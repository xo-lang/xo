fn float_hypot(f: Float, y: Float) -> Float { gomath.hypot(f, y) }

fn float_mod(f: Float, y: Float) -> Float { gomath.mod(f, y) }

fn float_is_inf(f: Float) -> Bool { gomath.is_inf(f, 0) }

fn float_to_bits(f: Float) -> Int { rt.float_bits(f) }

fn float_from_bits(b: Int) -> Float { rt.float_from_bits(b) }

fn int_leading_zeros(n: Int) -> Int { rt.clz(n) }

fn int_trailing_zeros(n: Int) -> Int { rt.ctz(n) }

fn int_ones_count(n: Int) -> Int { rt.popcount(n) }
