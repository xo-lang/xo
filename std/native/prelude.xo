fn llrt_chan_try_recv_w(c: Int) -> (Int, Bool) { chan.try_recv_w(c) }

/// Uses the channel c after a word operation on its address (chan_word):
/// a handle is released right after its last use, which was the address
/// taken for the call, so the sender task's end could free the channel
/// under a receiver still inside recv_w (gotchas/obj-addr-handle-released-early.md).
fn llrt_chan_hold[T](c: Chan[T]) {
  if rt.obj_addr(c) == 0 {
    return
  }
}

