// ---------------------------------------------------------------------------
// strconv (decision 0287): Go's ParseInt, FormatInt, ParseBool, and Unquote
// (internal/strconv/atoi.go, strconv/quote.go of go1.26) with the same
// results; every Go error is None.

fn lower_byte(c: UInt8) -> UInt8 { c | 32 }

/// underscoreOK: the separators sit between digits (or after a prefix).
fn underscore_ok(s0: Str) -> Bool {
  var b = s0.bytes()
  if b.len() >= 1 && (b[0] == 45 || b[0] == 43) {
    b = b[1..]
  }
  var saw = 94
  var i = 0
  var hex = false
  if b.len() >= 2 && b[0] == 48 && (lower_byte(b[1]) == 98 || lower_byte(b[1]) == 111 || lower_byte(b[1]) == 120) {
    i = 2
    saw = 48
    hex = lower_byte(b[1]) == 120
  }
  while i < b.len() {
    let c = b[i]
    if (c >= 48 && c <= 57) || (hex && lower_byte(c) >= 97 && lower_byte(c) <= 102) {
      saw = 48
    } else if c == 95 {
      if saw != 48 {
        return false
      }
      saw = 95
    } else {
      if saw == 95 {
        return false
      }
      saw = 33
    }
    i += 1
  }
  saw != 95
}

fn int_parse_base(s: Str, base0: Int) -> Int? {
  if base0 != 0 && (base0 < 2 || base0 > 36) {
    let q = "?"
    fault.raise_str_at("Int.parse_base: base ${base0} is not 0 or 2 to 36", raw.data(q), 0)
  }
  var b = s.bytes()
  if b.is_empty() {
    return None
  }
  var neg = false
  if b[0] == 43 || b[0] == 45 {
    neg = b[0] == 45
    b = b[1..]
  }
  if b.is_empty() {
    return None
  }
  let digits_start = b
  var base = base0
  if base0 == 0 {
    base = 10
    if b[0] == 48 {
      if b.len() >= 3 && lower_byte(b[1]) == 98 {
        base = 2
        b = b[2..]
      } else if b.len() >= 3 && lower_byte(b[1]) == 111 {
        base = 8
        b = b[2..]
      } else if b.len() >= 3 && lower_byte(b[1]) == 120 {
        base = 16
        b = b[2..]
      } else {
        base = 8
        b = b[1..]
      }
    }
  }
  // a negative accumulator holds -2^63, the most negative Int
  var acc = 0
  var underscores = false
  for c in b {
    if c == 95 && base0 == 0 {
      underscores = true
      continue
    }
    var d = 99
    if c >= 48 && c <= 57 {
      d = Int(c) - 48
    } else if lower_byte(c) >= 97 && lower_byte(c) <= 122 {
      d = Int(lower_byte(c)) - 87
    }
    if d >= base {
      return None
    }
    acc = acc.checked_mul(base)?.checked_sub(d)?
  }
  if underscores && !underscore_ok(digits_start.to_str() ?? "") {
    return None
  }
  if neg {
    return Some(acc)
  }
  acc.checked_mul(-1)
}

/// The fill of pad_left, pad_right and center: one rune (decision 0410).
fn pad_fill_ok(fill: Str, what: Str) {
  if scan.rune_count(fill) != 1 {
    let q = "?"
    fault.raise_str_at("Str.${what}: the fill ${fill.quote()} is not one rune", raw.data(q), 0)
  }
}

fn str_pad_left(s: Str, width: Int, fill: Str) -> Str {
  pad_fill_ok(fill, "pad_left")
  let n = scan.rune_count(s)
  if n >= width {
    return s
  }
  fill.repeat(width - n) + s
}

fn str_pad_right(s: Str, width: Int, fill: Str) -> Str {
  pad_fill_ok(fill, "pad_right")
  let n = scan.rune_count(s)
  if n >= width {
    return s
  }
  s + fill.repeat(width - n)
}

fn str_center(s: Str, width: Int, fill: Str) -> Str {
  pad_fill_ok(fill, "center")
  let n = scan.rune_count(s)
  if n >= width {
    return s
  }
  let left = (width - n) / 2
  fill.repeat(left) + s + fill.repeat(width - n - left)
}

fn int_to_str_width(n: Int, width: Int, base: Int, zero: Bool, plus: Bool) -> Str {
  var body = int_to_str_base(n, base)
  var sign = if plus { "+" } else { "" }
  if body.starts_with("-") {
    sign = "-"
    body = body[1..]
  }
  let used = sign.len() + body.len()
  if width < 0 {
    // left justified: spaces on the right
    let w = 0 - width
    return if used >= w { sign + body } else { sign + body + " ".repeat(w - used) }
  }
  if used >= width {
    return sign + body
  }
  if zero {
    return sign + "0".repeat(width - used) + body
  }
  " ".repeat(width - used) + sign + body
}

/// text (a number's, with or without a sign) padded as Go's fmt pads a
/// float: width columns, zeros after the sign (not for NaN or Inf), spaces
/// on the right for a negative width, a + for a positive number with plus.
fn pad_number(text: Str, width: Int, zero: Bool, plus: Bool) -> Str {
  var sign = ""
  var body = text
  if text.starts_with("-") || text.starts_with("+") {
    sign = text[0..1]
    body = text[1..]
  } else if plus {
    sign = "+"
  }
  let used = sign.len() + body.len()
  if width < 0 {
    let w = 0 - width
    return if used >= w { sign + body } else { sign + body + " ".repeat(w - used) }
  }
  if used >= width {
    return sign + body
  }
  let inf = body == "Inf" || body == "NaN"
  if zero && !inf {
    return sign + "0".repeat(width - used) + body
  }
  " ".repeat(width - used) + sign + body
}

fn float_to_fixed(f: Float, prec: Int, width: Int, zero: Bool, plus: Bool) -> Str {
  pad_number(ftoa.format(f, 102, prec), width, zero, plus)
}

fn float_to_exp(f: Float, prec: Int, width: Int, zero: Bool, plus: Bool) -> Str {
  pad_number(ftoa.format(f, 101, prec), width, zero, plus)
}

fn float_to_general(f: Float, prec: Int, width: Int, zero: Bool, plus: Bool) -> Str {
  pad_number(ftoa.format(f, 103, prec), width, zero, plus)
}

fn int_to_str_base(n: Int, base: Int) -> Str {
  if base < 2 || base > 36 {
    let q = "?"
    fault.raise_str_at("Int.to_str_base: base ${base} is not 2 to 36", raw.data(q), 0)
  }
  if n == 0 {
    return "0"
  }
  let digits = "0123456789abcdefghijklmnopqrstuvwxyz".bytes()
  var out = BytesBuilder.with_capacity(65)
  // digits of the magnitude, from the negative side so -2^63 fits
  var x = if n < 0 { n } else { -n }
  var rev: List[UInt8] = []
  while x != 0 {
    let q = x / base
    let r = q * base - x
    rev.push(digits[r])
    x = q
  }
  if n < 0 {
    out.write_byte(45)
  }
  var i = rev.len() - 1
  while i >= 0 {
    out.write_byte(rev[i])
    i -= 1
  }
  out.freeze().to_str() ?? ""
}

fn bool_parse(s: Str) -> Bool? {
  match s {
    "1" | "t" | "T" | "TRUE" | "true" | "True" => Some(true)
    "0" | "f" | "F" | "FALSE" | "false" | "False" => Some(false)
    _ => None
  }
}

fn hex_digit(c: UInt8) -> Int {
  if c >= 48 && c <= 57 { return Int(c) - 48 }
  if c >= 97 && c <= 102 { return Int(c) - 87 }
  if c >= 65 && c <= 70 { return Int(c) - 55 }
  -1
}

fn str_unquote(s: Str) -> Str? {
  let b = s.bytes()
  if b.len() < 2 {
    return None
  }
  let q = b[0]
  if q == 96 {
    // a raw literal: no backquote inside, carriage returns dropped
    if b[b.len() - 1] != 96 {
      return None
    }
    var out = BytesBuilder.with_capacity(b.len())
    for i in 1..b.len() - 1 {
      if b[i] == 96 {
        return None
      }
      if b[i] != 13 {
        out.write_byte(b[i])
      }
    }
    return out.freeze().to_str()
  }
  if q != 34 && q != 39 {
    return None
  }
  var out = BytesBuilder.with_capacity(b.len())
  var i = 1
  var runes = 0
  var closed = false
  while i < b.len() {
    let c = b[i]
    if c == q {
      closed = true
      i += 1
      break
    }
    if c == 10 {
      return None
    }
    if q == 39 && runes == 1 {
      return None
    }
    if c >= 128 {
      let (r, n) = b.decode_rune(i)
      if r == '\u{FFFD}' && n == 1 {
        return None
      }
      out.write(b[i..i + n])
      i += n
    } else if c != 92 {
      out.write_byte(c)
      i += 1
    } else {
      if i + 1 >= b.len() {
        return None
      }
      let e = b[i + 1]
      i += 2
      let simple = match e {
        97 => 7
        98 => 8
        102 => 12
        110 => 10
        114 => 13
        116 => 9
        118 => 11
        92 => 92
        _ => -1
      }
      if simple >= 0 {
        out.write_byte(UInt8(simple))
      } else if e == 39 || e == 34 {
        if e != q {
          return None
        }
        out.write_byte(e)
      } else if e == 120 || e == 117 || e == 85 {
        let n = if e == 120 { 2 } else if e == 117 { 4 } else { 8 }
        if i + n > b.len() {
          return None
        }
        var v = 0
        for j in 0..n {
          let h = hex_digit(b[i + j])
          if h < 0 {
            return None
          }
          v = v * 16 + h
        }
        i += n
        if e == 120 {
          out.write_byte(UInt8(v))
        } else {
          match Rune.try(v) {
            Some(r) => out.write("${r}".bytes())
            None => return None
          }
        }
      } else if e >= 48 && e <= 55 {
        if i + 2 > b.len() {
          return None
        }
        var v = Int(e) - 48
        for j in 0..2 {
          let x = Int(b[i + j]) - 48
          if x < 0 || x > 7 {
            return None
          }
          v = v * 8 + x
        }
        i += 2
        if v > 255 {
          return None
        }
        out.write_byte(UInt8(v))
      } else {
        return None
      }
    }
    runes += 1
  }
  if !closed || i != b.len() || (q == 39 && runes > 1) {
    return None
  }
  out.freeze().to_str()
}

// ---------------------------------------------------------------------------
// math (decision 0287): std/native/llrt/gomath.xo, Go's portable algorithms

fn float_pow(f: Float, y: Float) -> Float { gomath.pow(f, y) }

fn float_exp(f: Float) -> Float { gomath.exp(f) }

fn float_exp2(f: Float) -> Float { gomath.exp2(f) }

fn float_expm1(f: Float) -> Float { gomath.expm1(f) }

fn float_log(f: Float) -> Float { gomath.log(f) }

fn float_log2(f: Float) -> Float { gomath.log2(f) }

fn float_log10(f: Float) -> Float { gomath.log10(f) }

fn float_log1p(f: Float) -> Float { gomath.log1p(f) }

fn float_sin(f: Float) -> Float { gomath.sin(f) }

fn float_cos(f: Float) -> Float { gomath.cos(f) }

fn float_tan(f: Float) -> Float { gomath.tan(f) }

fn float_asin(f: Float) -> Float { gomath.asin(f) }

fn float_acos(f: Float) -> Float { gomath.acos(f) }

fn float_atan(f: Float) -> Float { gomath.atan(f) }

fn float_sinh(f: Float) -> Float { gomath.sinh(f) }

fn float_cosh(f: Float) -> Float { gomath.cosh(f) }

fn float_tanh(f: Float) -> Float { gomath.tanh(f) }

fn float_cbrt(f: Float) -> Float { gomath.cbrt(f) }

fn float_atan2(f: Float, x: Float) -> Float { gomath.atan2(f, x) }

fn float_hypot(f: Float, y: Float) -> Float { gomath.hypot(f, y) }
fn float_copysign(f: Float, sign: Float) -> Float { gomath.copysign(f, sign) }
fn float_frexp(f: Float) -> (Float, Int) { gomath.frexp(f) }
fn float_ldexp(f: Float, exp: Int) -> Float { gomath.ldexp(f, exp) }

/// Float.fma off arm64 (where it is fmadd, compiler/ssa): x86-64's FMA3
/// when the CPU has it (decision 0385 stage 3), else Go's software body
fn float_fma(f: Float, y: Float, z: Float) -> Float {
  if (cpu.hw() & cpu.HW_FMA) != 0 {
    return cpu.fma_hw(f, y, z)
  }
  gomath.fma(f, y, z)
}

fn float_mod(f: Float, y: Float) -> Float { gomath.mod(f, y) }

fn float_is_inf(f: Float) -> Bool { gomath.is_inf(f, 0) }

fn float_to_bits(f: Float) -> Int { rt.float_bits(f) }

fn float_from_bits(b: Int) -> Float { rt.float_from_bits(b) }

/// The binary32 bits of f (Float32frombits' inverse) from its widened
/// double, which is exact: the exponent rebiased, the mantissa cut to 23
/// bits, a double below the binary32 normal range shifted into a
/// subnormal; infinities and NaNs keep their top payload bits.
fn float32_to_bits(f: Float32) -> UInt32 {
  let d = Float(f).to_bits()
  let sign = (d >> 63) & 1
  let e = (d >> 52) & 0x7FF
  let m = d & 0xFFFFFFFFFFFFF
  var bits = 0
  if e == 0x7FF {
    bits = 0x7F800000 | (m >> 29)
    if m != 0 {
      bits = bits | 0x400000
    }
  } else if e == 0 {
    bits = 0
  } else {
    let x = e - 1023
    if x >= -126 {
      bits = ((x + 127) << 23) | (m >> 29)
    } else {
      bits = (0x10000000000000 | m) >> (29 - 126 - x)
    }
  }
  UInt32(bits | (sign << 31))
}

/// Float32frombits: the double of the bits, rebiased (a binary32
/// subnormal is a normal double), then narrowed, which is exact.
fn float32_from_bits(b: UInt32) -> Float32 {
  let n = Int(b)
  let sign = (n >> 31) & 1
  let e = (n >> 23) & 0xFF
  let m = n & 0x7FFFFF
  var d = 0
  if e == 0xFF {
    d = 0x7FF0000000000000 | (m << 29)
  } else if e == 0 {
    if m != 0 {
      // m * 2^-149: the top set bit p of m is the exponent
      var p = 22
      while ((m >> p) & 1) == 0 {
        p -= 1
      }
      d = ((p - 149 + 1023) << 52) | (((m << (52 - p)) & 0xFFFFFFFFFFFFF))
    }
  } else {
    d = ((e - 127 + 1023) << 52) | (m << 29)
  }
  if sign == 1 {
    d = d | (1).wrapping_shl(63)
  }
  Float32(Float.from_bits(d))
}

fn int_leading_zeros(n: Int) -> Int { rt.clz(n) }

/// `n.bit_len()` (decision 0595): bits.Len64.
fn int_bit_len(n: Int) -> Int { 64 - rt.clz(n) }

/// `n.add_carry(m, carry)` (decision 0595): bits.Add64's formula.
fn int_add_carry(n: Int, m: Int, carry: Int) -> (Int, Int) {
  let sum = n.wrapping_add(m).wrapping_add(carry)
  (sum, ((n & m) | ((n | m) & ~sum)).shr_logical(63))
}

/// `n.sub_borrow(m, borrow)` (decision 0595): bits.Sub64's formula.
fn int_sub_borrow(n: Int, m: Int, borrow: Int) -> (Int, Int) {
  let diff = n.wrapping_sub(m).wrapping_sub(borrow)
  (diff, ((~n & m) | (~(n ^ m) & diff)).shr_logical(63))
}

fn int_trailing_zeros(n: Int) -> Int { rt.ctz(n) }

fn int_ones_count(n: Int) -> Int { rt.popcount(n) }

// ---------------------------------------------------------------------------
// Plain error messages (decision 0358): the Display of the prelude's
// error enums; std/rt/errtext.go prints the same texts on the Go backend.

/// path and what is wrong with it, or the text alone for an empty path.
fn fs_text(path: Str, text: Str) -> Str {
  if path.is_empty() {
    return text
  }
  "${path}: ${text}"
}

fn fserr_display(e: FsErr) -> Str {
  match e {
    NotFound(path) => fs_text(path, "no such file or directory")
    Exists(path) => fs_text(path, "file exists")
    NotEmpty(path) => fs_text(path, "directory not empty")
    NotDir(path) => fs_text(path, "not a directory")
    IsDir(path) => fs_text(path, "is a directory")
    Denied(path) => fs_text(path, "permission denied")
    Io(path, msg) => fs_text(path, msg)
    Canceled => "canceled"
  }
}

fn neterr_display(e: NetErr) -> Str {
  match e {
    InvalidAddr(msg) => "invalid address: ${msg}"
    Refused => "connection refused"
    Timeout => "i/o timeout"
    Io(msg) => msg
    Canceled => "canceled"
    Denied(addr) => "denied by Net.only: ${addr}"
  }
}

fn ioerr_display(e: IoErr) -> Str {
  match e {
    Closed => "closed"
    Io(msg) => msg
    Canceled => "canceled"
  }
}

fn enverr_display(e: EnvErr) -> Str {
  match e {
    Missing(name) => "${name} is not set"
  }
}

/// KeychainErr's twin (gotchas/new-prelude-struct-needs-native-twin.md).
struct KeychainErr {
  status: Int
  msg: Str
}

fn keychainerr_display(e: KeychainErr) -> Str { "keychain: ${e.msg} (${e.status})" }

/// DpapiErr's twin.
struct DpapiErr {
  code: Int
  msg: Str
}

fn dpapierr_display(e: DpapiErr) -> Str { "dpapi: ${e.msg} (${e.code})" }

fn keyerr_display(e: KeyErr) -> Str {
  match e {
    NotFound => "key not found"
    Expired => "key expired"
    Revoked => "key revoked"
    Denied => "permission denied"
    Io(m) => m
  }
}

fn procerr_display(e: ProcErr) -> Str {
  match e {
    NotFound(cmd) => "${cmd}: executable file not found"
    Io(msg) => msg
    Canceled => "canceled"
    Denied(cmd) => "denied by Proc.only: ${cmd}"
    Timeout => "i/o timeout"
  }
}

fn clockerr_display(e: ClockErr) -> Str {
  match e {
    Canceled => "canceled"
  }
}

// ---------------------------------------------------------------------------
// ByteBuffer (decision 0480; std/rt bytebuf.go on the Go backend)

struct ByteBuffer {
  /// what was written, in pieces: views of the callers' Bytes (a write
  /// copies nothing) or of small writes gathered in tail; the pieces
  /// before head are read (and emptied)
  segs: List[Bytes] = []
  head: Int = 0
  /// positions in the stream: of segs[head]'s first byte, of the first
  /// unread byte, and past the last byte written
  hstart: Int = 0
  pos: Int = 0
  end: Int = 0
  /// small writes not yet in segs (appended in place)
  tail: Str = ""
  /// read_until found no delim from pos to scan_to; scan_seg is the piece
  /// holding scan_to, starting at scan_start
  delim: Int = -1
  scan_to: Int = 0
  scan_seg: Int = 0
  scan_start: Int = 0
}

/// A write this short is copied into tail rather than kept as a view
const BB_SMALL = 64

fn bytebuffer_new() -> ByteBuffer { ByteBuffer{} }

/// n is not used: writes of 64 bytes or more are kept as views, and
/// sizing the first small-write tail to n measured slower (2026-11-05,
/// 4 MB of 32 byte writes: linux/arm64 1.86 times as long, darwin/arm64
/// no change; bench/results/capacity-hints-2026-11-05.md)
fn bytebuffer_with_capacity(n: Int) -> ByteBuffer { ByteBuffer{} }

fn bytebuffer_len(b: ByteBuffer) -> Int { b.end - b.pos }

/// Keeps data as a view (decision 0480: no copy at write time; a record
/// inside one piece is a view of it, one that spans pieces is joined once).
fn bytebuffer_write(var b: ByteBuffer, data: Bytes) {
  let n = data.len()
  if n == 0 {
    return
  }
  if n < BB_SMALL {
    let t = b.tail
    b.tail = ""
    b.tail = rt.rs_append_bytes(if t.is_empty() { rt.rs_with_cap(256) } else { t }, data, 0, n, 0)
    b.end += n
    return
  }
  bytebuffer_flush(b)
  b.segs.push(data)
  b.end += n
}

/// Moves tail's bytes into segs.
fn bytebuffer_flush(var b: ByteBuffer) {
  if !b.tail.is_empty() {
    let t = b.tail
    b.tail = ""
    b.segs.push(t.bytes())
  }
}

/// Consumes the unread bytes before stream position p (pos <= p <= end).
fn bytebuffer_take(var b: ByteBuffer, p: Int) {
  b.pos = p
  while b.head < b.segs.len() && b.hstart + b.segs[b.head].len() <= p {
    b.hstart += b.segs[b.head].len()
    b.segs[b.head] = b""
    b.head += 1
  }
  if b.head == b.segs.len() {
    b.segs = []
    b.head = 0
  } else if b.head >= 32 && 2 * b.head >= b.segs.len() {
    var kept: List[Bytes] = List.with_capacity(b.segs.len() - b.head)
    for k in b.head..b.segs.len() {
      kept.push(b.segs[k])
    }
    b.segs = kept
    b.scan_seg -= b.head
    b.head = 0
  }
  if b.scan_to <= p || b.scan_seg < b.head {
    b.scan_to = p
    b.scan_seg = b.head
    b.scan_start = b.hstart
  }
}

/// Piece k, tail's bytes after the last.
fn bytebuffer_seg(b: ByteBuffer, k: Int) -> Bytes { if k < b.segs.len() { b.segs[k] } else { b.tail.bytes() } }

/// The unread bytes from stream position a to c (pos <= a < c <= end):
/// a view when they lie in one piece, else joined.
fn bytebuffer_slice(b: ByteBuffer, a: Int, c: Int) -> Bytes {
  var k = b.head
  var ks = b.hstart
  while ks + bytebuffer_seg(b, k).len() <= a {
    ks += bytebuffer_seg(b, k).len()
    k += 1
  }
  let first = bytebuffer_seg(b, k)
  if c <= ks + first.len() {
    return first[a - ks..c - ks]
  }
  var j = BytesBuilder.with_capacity(c - a)
  var from = a - ks
  while ks < c {
    let s = bytebuffer_seg(b, k)
    let to = if c - ks < s.len() { c - ks } else { s.len() }
    j.write(s[from..to])
    ks += s.len()
    from = 0
    k += 1
  }
  j.freeze()
}

fn bytebuffer_clamp(b: ByteBuffer, n: Int) -> Int {
  let m = b.end - b.pos
  if n < 0 { 0 } else if n > m { m } else { n }
}

fn bytebuffer_peek(b: ByteBuffer, n: Int) -> Bytes {
  let k = bytebuffer_clamp(b, n)
  if k == 0 {
    return b""
  }
  bytebuffer_slice(b, b.pos, b.pos + k)
}

fn bytebuffer_next(var b: ByteBuffer, n: Int) -> Bytes {
  let k = bytebuffer_clamp(b, n)
  if k == 0 {
    return b""
  }
  bytebuffer_flush(b)
  let v = bytebuffer_slice(b, b.pos, b.pos + k)
  bytebuffer_take(b, b.pos + k)
  v
}

fn bytebuffer_discard(var b: ByteBuffer, n: Int) {
  let k = bytebuffer_clamp(b, n)
  if k > 0 {
    bytebuffer_flush(b)
    bytebuffer_take(b, b.pos + k)
  }
}

/// Searches from where the last search for the same delimiter stopped.
/// Small, to be inlined: the common case, the delimiter in the head
/// piece past the unread start with no search state further on, else
/// bytebuffer_read_slow.
fn bytebuffer_read_until(var b: ByteBuffer, delim: UInt8) -> Bytes? {
  let d = Int(delim)
  // no operation here can fault (wrapping arithmetic, get), so that the
  // inliner takes it (a function with landing pads stays a call)
  if b.tail.is_empty() && b.end > b.pos && (b.delim != d || b.scan_seg == b.head) {
    if let Some(s) = b.segs.get(b.head) {
      let lo = b.pos.wrapping_sub(b.hstart)
      let start = if b.delim == d && b.scan_to > b.pos { b.scan_to.wrapping_sub(b.hstart) } else { lo }
      let i = scan.find_byte(s, start, s.len(), d)
      let e = i.wrapping_add(1)
      if i >= 0 && e < s.len() {
        b.pos = b.hstart.wrapping_add(e)
        // written on both paths, not in an `if`: the join's ByteBuffer
        // would end the borrow of s (decision 0487) and cost a retain
        // and a release a record
        b.scan_to = if b.scan_to < b.pos { b.pos } else { b.scan_to }
        // s[lo..e] unchecked (lo <= e <= s.len() by the search): a
        // checked slice would add a landing pad
        return Some(rt.cast[Str, Bytes](rt.str_view(rt.cast[Bytes, Str](s), lo, e)))
      }
    }
  }
  bytebuffer_read_slow(b, d)
}

fn bytebuffer_read_slow(var b: ByteBuffer, d: Int) -> Bytes? {
  if b.end == b.pos {
    return None
  }
  bytebuffer_flush(b)
  var k = b.head
  var ks = b.hstart
  var from = b.pos
  if b.delim == d && b.scan_to > b.pos {
    k = b.scan_seg
    ks = b.scan_start
    from = b.scan_to
  }
  while k < b.segs.len() {
    let s = b.segs[k]
    let i = scan.find_byte(s, from - ks, s.len(), d)
    if i >= 0 {
      let e = ks + i + 1
      let v = if k == b.head { s[b.pos - ks..i + 1] } else { bytebuffer_slice(b, b.pos, e) }
      bytebuffer_take(b, e)
      return Some(v)
    }
    ks += s.len()
    from = ks
    k += 1
  }
  b.delim = d
  b.scan_to = b.end
  b.scan_seg = k
  b.scan_start = ks
  None
}

/// Searches a join of the unread bytes when they span pieces.
fn bytebuffer_find(b: ByteBuffer, sub: Bytes) -> Int? {
  if b.end == b.pos {
    return if sub.is_empty() { Some(0) } else { None }
  }
  bytebuffer_slice(b, b.pos, b.end).find(sub)
}

/// `t.unix_nanos()` (decision 0595): Time is nanoseconds since 1970.
fn time_unix_nanos(t: Time) -> Int { (t - Time.UNIX_EPOCH).nanos() }

/// `t.unix_micros()` (decision 0595): rounded down, as Go's.
fn time_unix_micros(t: Time) -> Int {
  let ns = time_unix_nanos(t)
  let q = ns / 1000
  if ns % 1000 < 0 { q - 1 } else { q }
}

/// `t.nanosecond()` (decision 0595).
fn time_nanosecond(t: Time) -> Int {
  let r = time_unix_nanos(t) % 1000000000
  if r < 0 { r + 1000000000 } else { r }
}

/// `Time.from_unix_nanos(ns)` (decision 0595).
fn time_from_unix_nanos(ns: Int) -> Time { Time.UNIX_EPOCH + Duration.from_nanos(ns) }

/// `Time.from_unix_micros(us)` (decision 0595): a fault past Time's range.
fn time_from_unix_micros(us: Int) -> Time { Time.UNIX_EPOCH + Duration.from_nanos(us * 1000) }
