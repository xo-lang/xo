// ---------------------------------------------------------------------------
// Str (std.md 2.2)

fn str_rune_count(s: Str) -> Int { scan.rune_count(s) }

fn str_contains(s: Str, sub: Str) -> Bool { scan.contains(s, sub) }

fn str_starts_with(s: Str, p: Str) -> Bool { scan.starts_with(s, p) }

fn str_ends_with(s: Str, p: Str) -> Bool { scan.ends_with(s, p) }

fn str_equal_fold(a: Str, b: Str) -> Bool { unicode.equal_fold(a, b) }

fn str_find(s: Str, sub: Str) -> Int? {
  let i = scan.find(s, sub, 0)
  if i < 0 {
    return None
  }
  Some(i)
}

/// strings.LastIndex: the last sub's byte offset, s.len() for "".
fn str_rfind(s: Str, sub: Str) -> Int? {
  let n = s.len()
  let m = sub.len()
  if m > n {
    return None
  }
  let sb = s.bytes()
  let qb = sub.bytes()
  var i = n - m
  while i >= 0 {
    var j = 0
    while j < m && sb[i + j] == qb[j] {
      j += 1
    }
    if j == m {
      return Some(i)
    }
    i -= 1
  }
  None
}

fn str_split(s: Str, sep: Str) -> List[Str] { scan.split(s, sep) }

fn str_split_n(s: Str, sep: Str, n: Int) -> List[Str] { scan.split_n(s, sep, n) }

fn str_split_after(s: Str, sep: Str) -> List[Str] { scan.split_after(s, sep) }

fn str_split_after_n(s: Str, sep: Str, n: Int) -> List[Str] { scan.split_after_n(s, sep, n) }

fn str_count(s: Str, sub: Str) -> Int { scan.count(s, sub) }

fn str_find_any(s: Str, chars: Str) -> Int? {
  let i = scan.index_any(s, chars)
  if i < 0 {
    return None
  }
  Some(i)
}

fn str_rfind_any(s: Str, chars: Str) -> Int? {
  let i = scan.last_index_any(s, chars)
  if i < 0 {
    return None
  }
  Some(i)
}

fn str_contains_any(s: Str, chars: Str) -> Bool { scan.index_any(s, chars) >= 0 }

fn str_contains_rune(s: Str, r: Rune) -> Bool { scan.index_rune(s, r) >= 0 }

// The predicate forms (Go's strings and bytes *Func family): the runes of the
// receiver are decoded one at a time (an ASCII byte needs no decoding), so an
// invalid byte is U+FFFD of size one, as Go's range over a string sees it, and
// f is called exactly once per rune. The walks run over Bytes and return
// offsets, so Str and Bytes share one core each and make the views of their
// own type.

/// IndexFunc: the byte offset of the first rune for which f is true, -1 when
/// there is none.
fn where_index[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Int ! E uses fx {
  let n = b.len()
  var i = 0
  while i < n {
    let c = b[i]
    if c < 0x80 {
      if f(Rune(Int(c)))? {
        return i
      }
      i += 1
      continue
    }
    let d = raw.decode(b, i)
    if f(Rune(d >> 3))? {
      return i
    }
    i += d & 7
  }
  -1
}

/// strings.IndexFunc: the byte offset of the first rune for which f is
/// true, None when there is none.
fn str_find_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx {
  let i = where_index(s.bytes(), f)?
  if i < 0 {
    return None
  }
  Some(i)
}

/// LastIndexFunc: the byte offset of the last rune for which f is true, -1
/// when there is none.
fn where_last_index[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Int ! E uses fx {
  var end = b.len()
  while end > 0 {
    var start = end - 1
    let c = b[start]
    if c < 0x80 {
      if f(Rune(Int(c)))? {
        return start
      }
      end = start
      continue
    }
    // back over at most three continuation bytes to the sequence's start
    var k = 0
    while start > 0 && k < 3 && b[start] >= 0x80 && b[start] <= 0xbf {
      start -= 1
      k += 1
    }
    let d = raw.decode(b, start)
    let w = d & 7
    if start + w == end {
      if f(Rune(d >> 3))? {
        return start
      }
      end = start
      continue
    }
    // Go's DecodeLastRuneInString: a malformed tail is U+FFFD of size one
    if f(Rune(0xfffd))? {
      return end - 1
    }
    end -= 1
  }
  -1
}

/// strings.LastIndexFunc: the byte offset of the last rune for which f is
/// true, None when there is none.
fn str_rfind_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx {
  let i = where_last_index(s.bytes(), f)?
  if i < 0 {
    return None
  }
  Some(i)
}

/// strings.ContainsFunc: whether s holds a rune for which f is true.
fn str_contains_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> Bool ! E uses fx {
  where_index(s.bytes(), f)? >= 0
}

/// TrimLeftFunc: the offset of the first rune for which f is false, b.len()
/// when every rune satisfies f.
fn where_trim_left[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Int ! E uses fx {
  let n = b.len()
  var i = 0
  while i < n {
    let c = b[i]
    var r = Rune(Int(c))
    var w = 1
    if c >= 0x80 {
      let d = raw.decode(b, i)
      r = Rune(d >> 3)
      w = d & 7
    }
    if !f(r)? {
      return i
    }
    i += w
  }
  n
}

/// TrimRightFunc: the end offset of b without its trailing runes for which f
/// is true, 0 when every rune satisfies f.
fn where_trim_right[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Int ! E uses fx {
  var end = b.len()
  while end > 0 {
    var start = end - 1
    var r = Rune(0)
    var w = 1
    if b[start] < 0x80 {
      r = Rune(Int(b[start]))
    } else {
      var k = 0
      while start > 0 && k < 3 && b[start] >= 0x80 && b[start] <= 0xbf {
        start -= 1
        k += 1
      }
      let d = raw.decode(b, start)
      if start + (d & 7) == end {
        r = Rune(d >> 3)
        w = d & 7
      } else {
        // a malformed tail is U+FFFD of size one (strings.TrimRightFunc)
        r = Rune(0xfffd)
      }
    }
    if !f(r)? {
      return end
    }
    end -= w
  }
  0
}

/// FieldsFunc: the (start, end) offsets of the runs of runes for which f is
/// false (Go's spans: one pass calling f once per rune).
fn where_spans[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> List[(Int, Int)] ! E uses fx {
  let n = b.len()
  var spans: List[(Int, Int)] = []
  var start = -1
  var i = 0
  while i < n {
    let c = b[i]
    var r = Rune(Int(c))
    var w = 1
    if c >= 0x80 {
      let d = raw.decode(b, i)
      r = Rune(d >> 3)
      w = d & 7
    }
    if f(r)? {
      if start >= 0 {
        spans.push((start, i))
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i += w
  }
  if start >= 0 {
    spans.push((start, n))
  }
  spans
}

fn str_cut(s: Str, sep: Str) -> (Str, Str)? { scan.cut(s, sep) }

fn str_cut_prefix(s: Str, prefix: Str) -> Str? { scan.cut_prefix(s, prefix) }

fn str_cut_suffix(s: Str, suffix: Str) -> Str? { scan.cut_suffix(s, suffix) }

fn str_fields(s: Str) -> List[Str] { strings.fields(s) }

/// strings.FieldsFunc: the runs of runes for which f is false, as views of
/// s (one pass calling f once per rune, the pieces then sliced from the
/// recorded offsets, which are in range by construction: raw.str_cut, no
/// clamp and no slice check; 2026-10-24: raw.str_slice's clamps and
/// llrt_str_slice_chk call per field made fieldsfunc 2.5 times LLVM's time
/// on native, where LLVM inlines them away).
fn str_split_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> List[Str] ! E uses fx {
  let spans = where_spans(s.bytes(), f)?
  var out = List[Str].with_capacity(spans.len())
  for (lo, hi) in spans {
    out.push(raw.str_cut(s, lo, hi))
  }
  out
}

fn str_lines(s: Str) -> List[Str] { scan.lines(s) }

fn str_trim(s: Str) -> Str { strings.trim(s, 0) }

fn str_trim_start(s: Str) -> Str { strings.trim(s, 1) }

fn str_trim_end(s: Str) -> Str { strings.trim(s, 2) }

fn str_trim_prefix(s: Str, p: Str) -> Str {
  if p.len() <= s.len() && scan.eq_text(s, 0, p) {
    return raw.str_from(s, p.len())
  }
  s
}

fn str_trim_chars(s: Str, chars: Str) -> Str { scan.trim_chars(s, chars) }

fn str_trim_start_chars(s: Str, chars: Str) -> Str { scan.trim_start_chars(s, chars) }

fn str_trim_end_chars(s: Str, chars: Str) -> Str { scan.trim_end_chars(s, chars) }

/// strings.TrimLeftFunc: s from its first rune for which f is false, a view
/// of s; "" when every rune satisfies f.
fn str_trim_start_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx {
  raw.str_from(s, where_trim_left(s.bytes(), f)?)
}

/// strings.TrimRightFunc: s up to its last rune for which f is false, a
/// view of s; "" when every rune satisfies f.
fn str_trim_end_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx {
  raw.str_upto(s, where_trim_right(s.bytes(), f)?)
}

/// strings.TrimFunc: TrimRightFunc of TrimLeftFunc, a view of s.
fn str_trim_where[E, fx: Effects](s: Str, f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx {
  let a = str_trim_start_where(s, f)?
  str_trim_end_where(a, f)?
}

fn str_trim_suffix(s: Str, p: Str) -> Str {
  if p.len() <= s.len() {
    // proved by the test above: no overflow, so no checked subtraction (its fault pads keep the function from inlining)
    let k = rt.int_wrap(1, s.len(), p.len())
    if scan.eq_text(s, k, p) {
      return raw.str_upto(s, k)
    }
  }
  s
}

fn str_to_lower(s: Str) -> Str { unicode.map_case(s, true) }

fn str_to_upper(s: Str) -> Str { unicode.map_case(s, false) }

/// `a.to_lower() == b.to_lower()` (internal/ssa lowers that comparison to
/// a call of this).
fn str_eq_lower(a: Str, b: Str) -> Bool { unicode.eq_lower(a, b) }

/// strings.Map: f applied to every rune of s, None dropping it. Like Go's,
/// no copy until the first rune that changes (a valid U+FFFD that maps to
/// itself does not count, a malformed byte does), then one buffer of s's
/// length or more; a rune that maps to itself keeps its own bytes, so a run
/// of them costs one append, and an ASCII result is pushed as a byte.
fn str_map_runes[E, fx: Effects](s: Str, f: fn(Rune) -> Rune? ! E uses fx) -> Str ! E uses fx {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  var w = 0
  var first = -2
  while i < n {
    let c = b[i]
    var r = Rune(Int(c))
    w = 1
    if c >= 0x80 {
      let d = raw.bytes_decode(b, i)
      r = Rune(d >> 3)
      w = d & 7
    }
    let m = f(r)?
    var stop = m.is_none()
    var mapped = -1
    if let Some(x) = m {
      mapped = Int(x)
      if mapped != Int(r) || (Int(r) == 0xfffd && w == 1) {
        stop = true
      }
    }
    if stop {
      first = mapped
      break
    }
    i += w
  }
  if i >= n {
    return s
  }
  var o = rt.rs_append_bytes(rt.rs_with_cap(n), b, 0, i, 0)
  if first >= 0 {
    o = raw.push_rune(o, first)
  }
  i += w
  // A rune that maps to itself keeps its own bytes: a run of them is one
  // append, not a push_rune a rune (Go writes byte by byte, but its
  // WriteByte is inlined while a push here is a call into the runtime).
  var cp = i
  while i < n {
    let c = b[i]
    var r = Rune(Int(c))
    w = 1
    if c >= 0x80 {
      let d = raw.bytes_decode(b, i)
      r = Rune(d >> 3)
      w = d & 7
    }
    let m = f(r)?
    var any = false
    var mapped = -1
    if let Some(x) = m {
      any = true
      mapped = Int(x)
    }
    let same = any && mapped == Int(r) && !(Int(r) == 0xfffd && w == 1)
    if same {
      i += w
      continue
    }
    if cp < i {
      o = rt.rs_append_bytes(o, b, cp, i, 0)
    }
    if any {
      if mapped >= 0 && mapped < 0x80 {
        o = rt.rs_push_byte(o, mapped)
      } else {
        o = raw.push_rune(o, mapped)
      }
    }
    i += w
    cp = i
  }
  if cp < i {
    o = rt.rs_append_bytes(o, b, cp, i, 0)
  }
  o
}

fn str_replace(s: Str, old: Str, new: Str) -> Str { strings.replace(s, old, new) }
fn str_replace_n(s: Str, old: Str, new: Str, n: Int) -> Str { strings.replace_n(s, old, new, n) }

/// Go's strings.Replacer (decision 0594), with its algorithms: kind 1 is
/// one pair whose old is longer than a byte (singleStringReplacer: one
/// pass), 2 single bytes to single bytes (byteReplacer: a table), 3
/// single bytes to strings (byteStringReplacer), 4 any other
/// (genericReplacer). Go's generic trie finds, at a position, the pair of
/// highest priority (the earliest) whose old starts there; kind 4 tries
/// the pairs of that first byte in order, which finds the same pair.
struct Replacer {
  kind: Int = 2
  olds: List[Str] = []
  news: List[Str] = []
  /// kind 2: what each byte becomes; kind 3: the pair replacing each byte
  /// or -1; kind 4: where each first byte's pairs start in order (257)
  table: List[Int] = []
  /// kind 4: pair indices grouped by first byte, each group in order
  order: List[Int] = []
  /// kind 4: the first pair with an empty old, or -1
  empty: Int = -1
  /// kinds 3 and 4: each new's bytes as one little-endian word when it
  /// has 1 to 8 (rt.rs_push_word, one store), else 0
  words: List[Int] = []
}

/// replacer_new's words: each string's bytes in a word when 1 to 8.
fn replacer_words(news: List[Str]) -> List[Int] {
  var out: List[Int] = List.with_capacity(news.len())
  for t in news {
    let b = t.bytes()
    var w = 0
    if b.len() >= 1 && b.len() <= 8 {
      for k in 0..b.len() {
        w = w | Int(b[k]).wrapping_shl(k * 8)
      }
    }
    out.push(w)
  }
  out
}

/// o + the pair p's new: a word store when its bytes fit one.
fn replacer_push(r: Replacer, o: Str, p: Int) -> Str {
  let t = r.news[p]
  let k = t.len()
  if k == 0 {
    return o
  }
  if k <= 8 {
    return rt.rs_push_word(o, r.words[p], k)
  }
  rt.rs_append(o, t)
}

fn replacer_new(pairs: List[(Str, Str)]) -> Replacer {
  var olds: List[Str] = []
  var news: List[Str] = []
  for (o, n) in pairs {
    olds.push(o)
    news.push(n)
  }
  if olds.len() == 1 && olds[0].len() > 1 {
    return Replacer{kind: 1, olds: olds, news: news}
  }
  var all_bytes = true
  var new_bytes = true
  for i in 0..olds.len() {
    if olds[i].len() != 1 {
      all_bytes = false
    }
    if news[i].len() != 1 {
      new_bytes = false
    }
  }
  if all_bytes && new_bytes {
    var t: List[Int] = List.with_capacity(256)
    for c in 0..256 {
      t.push(c)
    }
    // the first pair of an old takes precedence: fill from the last
    var i = olds.len() - 1
    while i >= 0 {
      t[Int(olds[i].bytes()[0])] = Int(news[i].bytes()[0])
      i -= 1
    }
    return Replacer{kind: 2, table: t}
  }
  if all_bytes {
    var t: List[Int] = List.with_capacity(256)
    for _ in 0..256 {
      t.push(-1)
    }
    var i = olds.len() - 1
    while i >= 0 {
      t[Int(olds[i].bytes()[0])] = i
      i -= 1
    }
    return Replacer{kind: 3, news: news, table: t, words: replacer_words(news)}
  }
  // by first byte, in argument order: a counting sort of the pair indices
  var count: List[Int] = List.with_capacity(257)
  for _ in 0..257 {
    count.push(0)
  }
  var empty = -1
  for i in 0..olds.len() {
    if olds[i].len() == 0 {
      if empty < 0 {
        empty = i
      }
    } else {
      count[Int(olds[i].bytes()[0]) + 1] += 1
    }
  }
  for c in 1..257 {
    count[c] += count[c - 1]
  }
  var order: List[Int] = List.with_capacity(count[256])
  for _ in 0..count[256] {
    order.push(0)
  }
  var fill = count
  for i in 0..olds.len() {
    if olds[i].len() > 0 {
      let c = Int(olds[i].bytes()[0])
      order[fill[c]] = i
      fill[c] += 1
    }
  }
  Replacer{kind: 4, olds: olds, news: news, table: count, order: order, empty: empty, words: replacer_words(news)}
}

fn replacer_replace(r: Replacer, s: Str) -> Str {
  match r.kind {
    1 => replacer_single(r, s)
    2 => replacer_bytes(r, s)
    3 => replacer_byte_strs(r, s)
    _ => replacer_generic(r, s)
  }
}

/// singleStringReplacer.Replace: one pass, each match found from the end
/// of the last (Go's finder; scan.find_bytes is the native Index), into a
/// buffer that grows, where Str.replace counts the matches first.
fn replacer_single(r: Replacer, s: Str) -> Str {
  let b = s.bytes()
  let old = r.olds[0].bytes()
  let m = old.len()
  let n = b.len()
  var j = scan.find_bytes(b, old, 0)
  if j < 0 {
    return s
  }
  let nb = r.news[0].bytes()
  var o = rt.rs_with_cap(n + n / 8 + nb.len())
  var last = 0
  while j >= 0 {
    if j > last {
      o = rt.rs_append_bytes(o, b, last, j, 0)
    }
    if nb.len() > 0 {
      o = rt.rs_append_bytes(o, nb, 0, nb.len(), 0)
    }
    last = j + m
    j = scan.find_bytes(b, old, last)
  }
  if last < n {
    o = rt.rs_append_bytes(o, b, last, n, 0)
  }
  o
}

/// byteReplacer.Replace: s itself until a byte changes.
fn replacer_bytes(r: Replacer, s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && r.table[Int(b[i])] == Int(b[i]) {
    i += 1
  }
  if i == n {
    return s
  }
  var o = rt.rs_with_cap(n)
  o = rt.rs_append_bytes(o, b, 0, i, 0)
  while i < n {
    o = rt.rs_push_byte(o, r.table[Int(b[i])])
    i += 1
  }
  o
}

/// byteStringReplacer.Replace: s itself when no byte is replaced.
fn replacer_byte_strs(r: Replacer, s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && r.table[Int(b[i])] < 0 {
    i += 1
  }
  if i == n {
    return s
  }
  var o = rt.rs_with_cap(n + n / 4)
  var last = 0
  while i < n {
    let p = r.table[Int(b[i])]
    if p >= 0 {
      if i > last {
        o = rt.rs_append_bytes(o, b, last, i, 0)
      }
      o = replacer_push(r, o, p)
      last = i + 1
    }
    i += 1
  }
  if last < n {
    o = rt.rs_append_bytes(o, b, last, n, 0)
  }
  o
}

/// genericReplacer.WriteString: at each position the earliest pair whose
/// old starts there; an empty match is not taken twice in a row at one
/// position (Go's prevMatchEmpty), so the scan moves on a byte.
fn replacer_generic(r: Replacer, s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var o = ""
  var started = false
  var last = 0
  var i = 0
  var prev_empty = false
  while i <= n {
    var best = -1
    let use_empty = r.empty >= 0 && !prev_empty
    if i < n {
      let c = Int(b[i])
      let k0 = r.table[c]
      let e = r.table[c + 1]
      if k0 == e && !use_empty {
        prev_empty = false
        i += 1
        continue
      }
      for k in k0..e {
        let p = r.order[k]
        if use_empty && p > r.empty {
          break
        }
        if scan.has_at(s, i, r.olds[p]) {
          best = p
          break
        }
      }
    }
    if best < 0 && use_empty {
      best = r.empty
    }
    if best >= 0 {
      if !started {
        o = rt.rs_with_cap(n + n / 4 + 8)
        started = true
      }
      if i > last {
        o = rt.rs_append_bytes(o, b, last, i, 0)
      }
      o = replacer_push(r, o, best)
      let kl = r.olds[best].len()
      prev_empty = kl == 0
      i += kl
      last = i
      continue
    }
    prev_empty = false
    i += 1
  }
  if !started {
    return s
  }
  if last < n {
    o = rt.rs_append_bytes(o, b, last, n, 0)
  }
  o
}

/// strings.Repeat: empty for 0, a fault below 0 and above 4 GiB, as the Go
/// backend faults and as Bytes.repeat does; the fault names the caller's
/// line (the Go backend's FaultHere does too).
fn str_repeat(s: Str, n: Int, at: rt.Loc) -> Str {
  if n < 0 {
    rt.fault_at("negative repeat count ${n}", at)
  }
  let k = s.len()
  if n == 0 || k == 0 {
    return ""
  }
  if k > Int.max / n {
    rt.fault_at("strings: Repeat output length overflow", at)
  }
  if k * n > 4294967295 {
    rt.fault_at("strings: Repeat output over 4 GiB", at)
  }
  raw.str_repeat(s, n)
}

/// A copy in a buffer of its own (decision 0330): s may be a view.
fn str_clone(s: Str) -> Str { raw.str_at(raw.data(s), s.len()) }

fn bytes_clone(b: Bytes) -> Bytes {
  let n = b.len()
  let c = raw.bytes_buf(n)
  rt.mem_copy(raw.bytes_addr(c), raw.bytes_addr(b), n)
  c
}

fn list_join(xs: List[Str], sep: Str) -> Str { raw.str_join(xs, sep) }

fn str_quote(s: Str) -> Str { unicode.quote(s.bytes()) }

// ---------------------------------------------------------------------------
// Rune and Bytes (std.md 2.2, decisions 0079 and 0081)

fn rune_is_letter(r: Rune) -> Bool { unicode.is_letter(Int(r)) }

fn rune_is_digit(r: Rune) -> Bool { unicode.is_digit(Int(r)) }

fn rune_is_space(r: Rune) -> Bool { unicode.is_space(Int(r)) }

fn rune_is_upper(r: Rune) -> Bool { unicode.is_upper(Int(r)) }

fn rune_is_lower(r: Rune) -> Bool { unicode.is_lower(Int(r)) }

fn rune_is_title(r: Rune) -> Bool { unicode.is_title(Int(r)) }

fn rune_is_punct(r: Rune) -> Bool { unicode.is_punct(Int(r)) }

fn rune_is_control(r: Rune) -> Bool { unicode.is_control(Int(r)) }

fn rune_is_graphic(r: Rune) -> Bool { unicode.is_graphic(Int(r)) }

fn rune_is_mark(r: Rune) -> Bool { unicode.is_mark(Int(r)) }

fn rune_is_symbol(r: Rune) -> Bool { unicode.is_symbol(Int(r)) }

fn rune_is_number(r: Rune) -> Bool { unicode.is_number(Int(r)) }

fn rune_is_print(r: Rune) -> Bool { unicode.is_print(Int(r)) }

fn rune_to_lower(r: Rune) -> Rune { rune_case(r, true) }

fn rune_to_upper(r: Rune) -> Rune { rune_case(r, false) }

/// `r.simple_fold()` (decision 0595): unicode.SimpleFold.
fn rune_simple_fold(r: Rune) -> Rune { Rune.try(unicode.simple_fold(Int(r))) ?? r }

fn rune_to_title(r: Rune) -> Rune {
  let x = Int(r)
  let y = unicode.to_title(x)
  if y == x {
    return r
  }
  if y < 0x80 {
    return Rune(unicode.byte(y))
  }
  Rune(y)
}

fn rune_utf8_len(r: Rune) -> Int { unicode.utf8_len(Int(r)) }

/// unicode.ToLower (lower) or unicode.ToUpper: an unchanged or ASCII
/// result needs no checked conversion.
fn rune_case(r: Rune, lower: Bool) -> Rune {
  let x = Int(r)
  let y = unicode.to_case(x, lower)
  if y == x {
    return r
  }
  if y < 0x80 {
    return Rune(unicode.byte(y))
  }
  Rune(y)
}

fn rune_quote(r: Rune) -> Str { unicode.quote_rune(Int(r)) }

fn rune_try(x: Int) -> Rune? {
  if x < 0 || x > 0x10ffff || (x >= 0xd800 && x <= 0xdfff) {
    return None
  }
  Some(Rune(x))
}

fn bytes_quote(b: Bytes) -> Str { unicode.quote(b) }

fn bytes_rune_count(b: Bytes) -> Int { scan.bytes_rune_count(b) }

fn bytes_to_hex(b: Bytes) -> Str { scan.to_hex(b) }

/// Each byte of an invalid UTF-8 sequence U+FFFD: the runtime's own
/// conversion of outside bytes (decision 0259).
fn bytes_to_str_lossy(b: Bytes) -> Str { scan.text_of(b) }

/// Go's bytes.ToValidUTF8.
fn bytes_to_valid_utf8(b: Bytes, replacement: Str) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  utf8_fix(b, replacement)
}

/// b with replacement for each run of invalid bytes (Go's ToValidUTF8);
/// the valid stretches are copied whole.
fn utf8_fix(b: Bytes, replacement: Str) -> Str {
  let rep = replacement.bytes()
  var out = BytesBuilder.with_capacity(b.len() + rep.len())
  var start = 0
  var i = 0
  var bad = false
  while i < b.len() {
    if b[i] < 0x80 {
      i += 1
      bad = false
      continue
    }
    let (_, size) = b.decode_rune(i)
    if size == 1 {
      out.write(b[start..i])
      if !bad {
        out.write(rep)
      }
      bad = true
      i += 1
      start = i
      continue
    }
    bad = false
    i += size
  }
  out.write(b[start..])
  // valid: the copied stretches are, and so is replacement
  out.freeze().to_str() ?? ""
}

/// Whether sub is at b[i:] (i + sub.len() <= b.len()).
fn bytes_at(b: Bytes, sub: Bytes, i: Int) -> Bool {
  var j = 0
  while j < sub.len() {
    if b[i + j] != sub[j] {
      return false
    }
    j += 1
  }
  true
}

/// bytes.Index and bytes.LastIndex, on the bytes as they are (no Str cast:
/// the bytes need not be UTF-8, TestOutsideBytesValidated).
fn bytes_find(b: Bytes, sub: Bytes) -> Int? {
  bytes_find_from(b, sub, 0)
}

/// The offset of the first sub at or after i0 (bytes.Index with a start),
/// or None: as Go's Index does, the first byte of sub is searched 16 bytes
/// at a time (scan.find_byte) and each candidate compared.
fn bytes_find_from(b: Bytes, sub: Bytes, i0: Int) -> Int? {
  let n = b.len()
  let m = sub.len()
  if m == 0 {
    if i0 <= n {
      return Some(i0)
    }
    return None
  }
  let first = Int(sub[0])
  var i = i0
  while i + m <= n {
    let j = scan.find_byte(b, i, n - m + 1, first)
    if j < 0 {
      return None
    }
    if bytes_at(b, sub, j) {
      return Some(j)
    }
    i = j + 1
  }
  None
}

/// The offset of the first sub at or after i0, or -1 (a loop's form).
fn bytes_find_int(b: Bytes, sub: Bytes, i0: Int) -> Int {
  match bytes_find_from(b, sub, i0) {
    Some(i) => i
    None => -1
  }
}

/// bytes.Contains: an empty sub is in b.
fn bytes_contains(b: Bytes, sub: Bytes) -> Bool {
  match bytes_find_from(b, sub, 0) {
    Some(_) => true
    None => false
  }
}

/// bytes.HasPrefix: an empty p is a prefix of b.
fn bytes_starts_with(b: Bytes, p: Bytes) -> Bool {
  p.len() <= b.len() && scan.eq_at(b, 0, p, 0, p.len())
}

/// bytes.HasSuffix: an empty p is a suffix of b.
fn bytes_ends_with(b: Bytes, p: Bytes) -> Bool {
  p.len() <= b.len() && scan.eq_at(b, b.len() - p.len(), p, 0, p.len())
}

/// bytes.Split: b cut at each sep, the pieces views of b; an empty sep
/// splits after each UTF-8 sequence (an invalid byte alone).
fn bytes_split(b: Bytes, sep: Bytes) -> List[Bytes] {
  bytes_split_n(b, sep, -1)
}

/// bytes.SplitN: b cut at each sep, at most n pieces with the unsplit rest
/// in the last (n below 0: every piece, n 0: an empty list).
fn bytes_split_n(b: Bytes, sep: Bytes, n: Int) -> List[Bytes] {
  if n == 0 {
    return List[Bytes].with_capacity(0)
  }
  let sl = b.len()
  let m = sep.len()
  if m == 0 {
    // an empty sep splits after each UTF-8 sequence, as Go's explode
    return scan.explode_bytes(b, n)
  }
  // no count first: the list's growth is cheaper than a second pass over
  // the bytes (measured, bench/results/strsplit-vs-go-2026-10-24.md)
  var out: List[Bytes] = []
  var start = 0
  var count = 0
  while n < 0 || count < n - 1 {
    let j = bytes_find_int(b, sep, start)
    if j < 0 {
      break
    }
    out.push(b[start..j])
    start = j + m
    count += 1
  }
  out.push(b[start..sl])
  out
}

/// bytes.Fields.
fn bytes_fields(b: Bytes) -> List[Bytes] { strings.fields_bytes(b) }

/// bytes.FieldsFunc: the runs of runes for which f is false, as views of b
/// (one pass calling f once per rune, the pieces then sliced from the
/// recorded offsets).
fn bytes_split_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> List[Bytes] ! E uses fx {
  let spans = where_spans(b, f)?
  var out = List[Bytes].with_capacity(spans.len())
  for (lo, hi) in spans {
    out.push(b[lo..hi])
  }
  out
}

/// bytes.TrimSpace.
fn bytes_trim(b: Bytes) -> Bytes { strings.trim_bytes(b, 0) }

/// `b.trim_start_chars(chars)` and `b.trim_end_chars(chars)`: Str's, over
/// the same bytes (bytes.TrimLeft and TrimRight read b as Str's do).
fn bytes_trim_start_chars(b: Bytes, chars: Str) -> Bytes { rt.cast(scan.trim_start_chars(rt.cast(b), chars)) }
fn bytes_trim_end_chars(b: Bytes, chars: Str) -> Bytes { rt.cast(scan.trim_end_chars(rt.cast(b), chars)) }

/// bytes.TrimPrefix: b itself when p is not a prefix.
fn bytes_trim_prefix(b: Bytes, p: Bytes) -> Bytes {
  if p.len() <= b.len() && scan.eq_bytes(b, 0, p) {
    return b[p.len()..b.len()]
  }
  b
}

/// bytes.TrimSuffix: b itself when p is not a suffix.
fn bytes_trim_suffix(b: Bytes, p: Bytes) -> Bytes {
  if p.len() <= b.len() {
    // proved by the test above: no overflow, so no checked subtraction (its
    // fault pads keep the function from inlining)
    let k = rt.int_wrap(1, b.len(), p.len())
    if scan.eq_bytes(b, k, p) {
      return b[0..k]
    }
  }
  b
}

/// bytes.TrimFunc: TrimRightFunc of TrimLeftFunc, a view of b.
fn bytes_trim_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx {
  let a = bytes_trim_start_where(b, f)?
  bytes_trim_end_where(a, f)?
}

/// bytes.TrimLeftFunc: b from its first rune for which f is false, a view
/// of b; empty when every rune satisfies f.
fn bytes_trim_start_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx {
  b[where_trim_left(b, f)?..b.len()]
}

/// bytes.TrimRightFunc: b up to its last rune for which f is false, a view
/// of b; empty when every rune satisfies f.
fn bytes_trim_end_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx {
  b[0..where_trim_right(b, f)?]
}

/// bytes.Count: the non-overlapping copies of sub in b, left to right; for
/// an empty sub the rune count plus one (utf8.RuneCount, an invalid byte
/// one rune), and one byte sub counts bytes 16 at a time.
fn bytes_count(b: Bytes, sub: Bytes) -> Int {
  let n = b.len()
  let m = sub.len()
  if m == 0 {
    return scan.bytes_rune_count(b) + 1
  }
  if m == 1 {
    return scan.count_byte(b, 0, n, Int(sub[0]))
  }
  var c = 0
  var i = 0
  while i + m <= n {
    let j = bytes_find_int(b, sub, i)
    if j < 0 {
      break
    }
    c += 1
    i = j + m
  }
  c
}

/// bytes.ReplaceAll: b itself when nothing changes (Xo values are
/// immutable, so no copy is needed), one buffer otherwise.
/// bytes.IndexAny: the first rune of chars in b; chars is a Str because a
/// set of runes is text, as Go's bytes.IndexAny takes a string.
fn bytes_find_any(b: Bytes, chars: Str) -> Int? {
  let i = scan.index_any_bytes(b, chars.bytes())
  if i < 0 {
    return None
  }
  Some(i)
}

fn bytes_rfind_any(b: Bytes, chars: Str) -> Int? {
  let i = scan.last_index_any_bytes(b, chars.bytes())
  if i < 0 {
    return None
  }
  Some(i)
}

fn bytes_contains_any(b: Bytes, chars: Str) -> Bool { scan.index_any_bytes(b, chars.bytes()) >= 0 }

fn bytes_contains_rune(b: Bytes, r: Rune) -> Bool { scan.index_rune_bytes(b, r) >= 0 }

/// bytes.IndexFunc: the byte offset of the first rune for which f is true,
/// None when there is none.
fn bytes_find_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx {
  let i = where_index(b, f)?
  if i < 0 {
    return None
  }
  Some(i)
}

/// bytes.LastIndexFunc: the byte offset of the last rune for which f is
/// true, None when there is none.
fn bytes_rfind_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx {
  let i = where_last_index(b, f)?
  if i < 0 {
    return None
  }
  Some(i)
}

/// bytes.ContainsFunc: whether b holds a rune for which f is true.
fn bytes_contains_where[E, fx: Effects](b: Bytes, f: fn(Rune) -> Bool ! E uses fx) -> Bool ! E uses fx {
  where_index(b, f)? >= 0
}

fn bytes_cut(b: Bytes, sep: Bytes) -> (Bytes, Bytes)? { scan.cut_bytes(b, sep) }

fn bytes_cut_prefix(b: Bytes, p: Bytes) -> Bytes? { scan.cut_prefix_bytes(b, p) }

fn bytes_cut_suffix(b: Bytes, p: Bytes) -> Bytes? { scan.cut_suffix_bytes(b, p) }

fn bytes_split_after(b: Bytes, sep: Bytes) -> List[Bytes] { scan.split_after_bytes(b, sep) }

fn bytes_split_after_n(b: Bytes, sep: Bytes, n: Int) -> List[Bytes] { scan.split_after_n_bytes(b, sep, n) }

fn bytes_replace(b: Bytes, old: Bytes, new: Bytes) -> Bytes { strings.replace_bytes(b, old, new) }

/// bytes.Replace with a count, b itself when nothing changes.
fn bytes_replace_n(b: Bytes, old: Bytes, new: Bytes, n: Int) -> Bytes { strings.replace_bytes_n(b, old, new, n) }

/// bytes.ToLower and bytes.ToUpper: the mapping of Str.to_lower, an
/// invalid byte as U+FFFD as Go's, b itself when already in the case.
fn bytes_to_lower(b: Bytes) -> Bytes { unicode.map_case_bytes(b, true) }

fn bytes_to_upper(b: Bytes) -> Bytes { unicode.map_case_bytes(b, false) }

/// bytes.Map: f applied to every rune of b, None dropping it. Like
/// str_map_runes and Go's: no copy until the first rune that changes (a valid
/// U+FFFD that maps to itself does not count, a malformed byte does), then
/// one buffer of b's length or more; a rune that maps to itself keeps its own
/// bytes, so a run of them costs one append, and an ASCII result is pushed as
/// a byte. The buffer is a runtime Str relabelled as Bytes, as
/// unicode.map_case_bytes builds one.
fn bytes_map_runes[E, fx: Effects](b: Bytes, f: fn(Rune) -> Rune? ! E uses fx) -> Bytes ! E uses fx {
  let n = b.len()
  var i = 0
  var w = 0
  var first = -2
  while i < n {
    let c = b[i]
    var r = Rune(Int(c))
    w = 1
    if c >= 0x80 {
      let d = raw.decode(b, i)
      r = Rune(d >> 3)
      w = d & 7
    }
    let m = f(r)?
    var stop = m.is_none()
    var mapped = -1
    if let Some(x) = m {
      mapped = Int(x)
      if mapped != Int(r) || (Int(r) == 0xfffd && w == 1) {
        stop = true
      }
    }
    if stop {
      first = mapped
      break
    }
    i += w
  }
  if i >= n {
    return b
  }
  var o = rt.rs_append_bytes(rt.rs_with_cap(n), b, 0, i, 0)
  if first >= 0 {
    o = raw.push_rune(o, first)
  }
  i += w
  var cp = i
  while i < n {
    let c = b[i]
    var r = Rune(Int(c))
    w = 1
    if c >= 0x80 {
      let d = raw.decode(b, i)
      r = Rune(d >> 3)
      w = d & 7
    }
    let m = f(r)?
    var any = false
    var mapped = -1
    if let Some(x) = m {
      any = true
      mapped = Int(x)
    }
    let same = any && mapped == Int(r) && !(Int(r) == 0xfffd && w == 1)
    if same {
      i += w
      continue
    }
    if cp < i {
      o = rt.rs_append_bytes(o, b, cp, i, 0)
    }
    if any {
      if mapped >= 0 && mapped < 0x80 {
        o = rt.rs_push_byte(o, mapped)
      } else {
        o = raw.push_rune(o, mapped)
      }
    }
    i += w
    cp = i
  }
  if cp < i {
    o = rt.rs_append_bytes(o, b, cp, i, 0)
  }
  o.bytes()
}

/// bytes.EqualFold: Str.equal_fold's comparison over two byte slices.
fn bytes_equal_fold(a: Bytes, b: Bytes) -> Bool { unicode.equal_fold_bytes(a, b) }

/// bytes.Repeat: none for n 0, a fault below 0 as Go's bytes.Repeat (and
/// as the Go backend, so the message and the caller's line agree), and the
/// same two length faults as Str.repeat (4 GiB is the most a Bytes holds).
fn bytes_repeat(b: Bytes, n: Int, at: rt.Loc) -> Bytes {
  if n < 0 {
    rt.fault_at("negative repeat count ${n}", at)
  }
  let k = b.len()
  if n == 0 || k == 0 {
    return b""
  }
  if k > Int.max / n {
    rt.fault_at("bytes: Repeat output length overflow", at)
  }
  if k * n > 4294967295 {
    rt.fault_at("bytes: Repeat output over 4 GiB", at)
  }
  raw.bytes_repeat(b, n)
}

fn bytes_indexed(b: Bytes) -> List[(Int, UInt8)] {
  var out: List[(Int, UInt8)] = if b.len() >= PRESIZE_MIN { List[(Int, UInt8)].with_capacity(b.len()) } else { [] }
  for i in 0..b.len() {
    out.push((i, b[i]))
  }
  out
}

fn bytes_rfind(b: Bytes, sub: Bytes) -> Int? {
  var i = b.len() - sub.len()
  while i >= 0 {
    if bytes_at(b, sub, i) {
      return Some(i)
    }
    i -= 1
  }
  None
}

/// make([]byte, n): one allocation, cleared.
fn bytes_zeroed(n: Int) -> Bytes {
  if n < 0 {
    let q = ""
    fault.raise_str_at("negative length ${n} for Bytes.zeroed", raw.data(q), 0)
  }
  let b = raw.bytes_buf(n)
  rt.mem_set(raw.bytes_addr(b), 0, n)
  b
}

/// Whether b is UTF-8 (Bytes.to_str: internal/ssa calls this instead of
/// rt.utf8_valid, decision 0201).
fn llrt_utf8_valid(b: Bytes) -> Bool { scan.utf8_valid(b) }

fn bytes_from_hex(s: Str) -> Bytes? { num.from_hex(s) }

fn bytes_to_base64(b: Bytes) -> Str { num.to_base64(b) }

fn bytes_from_base64(s: Str) -> Bytes? { num.from_base64(s) }

/// []rune(s): an invalid byte is U+FFFD.
fn str_runes(s: Str) -> List[Rune] {
  let b = s.bytes()
  var out: List[Rune] = []
  var i = 0
  while i < b.len() {
    let p = raw.bytes_decode(b, i)
    out.push(Rune(p >> 3))
    i += p & 7
  }
  out
}

fn bytes_decode_rune(b: Bytes, i: Int, at: rt.Loc) -> (Rune, Int) {
  if i < 0 || i > b.len() {
    rt.fault_at("index ${i} out of range for decode_rune on Bytes of length ${b.len()}", at)
  }
  let p = raw.bytes_decode(b, i)
  (Rune(p >> 3), p & 7)
}

fn int_pow(n: Int, e: Int, at: rt.Loc) -> Int {
  if e < 0 {
    rt.fault_at("negative exponent ${e} in pow", at)
  }
  var r = 1
  var i = 0
  while i < e {
    if !ints.fits(2, r, n) {
      rt.fault_at("integer overflow: ${r} * ${n} does not fit Int", at)
    }
    r = r * n
    i += 1
  }
  r
}

fn int_wrapping_add(n: Int, m: Int) -> Int { rt.int_wrap(0, n, m) }

fn int_wrapping_sub(n: Int, m: Int) -> Int { rt.int_wrap(1, n, m) }

fn int_wrapping_mul(n: Int, m: Int) -> Int { rt.int_wrap(2, n, m) }

// Int's word methods (decision 0260): the SSA builders lower these calls
// inline as the same intrinsics (call.xo word_method); the bodies serve an
// xo that does not know them yet.

fn int_wrapping_shl(n: Int, k: Int) -> Int { rt.int_wrap(3, n, k) }

fn int_shr_logical(n: Int, k: Int) -> Int { rt.int_wrap(4, n, k) }

fn int_rotate_right(n: Int, k: Int) -> Int { rt.int_wrap(5, n, k) }

fn int_rotate_right32(n: Int, k: Int) -> Int { rt.int_wrap(6, n, k) }

fn int_swap_bytes(n: Int) -> Int { rt.int_wrap(7, n, 0) }

fn int_mul_hi_unsigned(n: Int, m: Int) -> Int { rt.u64_mul_hi(n, m) }

fn int_lt_unsigned(n: Int, m: Int) -> Bool { (n ^ Int.min) < (m ^ Int.min) }

fn int_le_unsigned(n: Int, m: Int) -> Bool { (n ^ Int.min) <= (m ^ Int.min) }

fn checked(op: Int, n: Int, m: Int) -> Int? {
  if !ints.fits(op, n, m) {
    return None
  }
  Some(ints.apply(op, n, m))
}

fn int_checked_add(n: Int, m: Int) -> Int? { checked(0, n, m) }

fn int_checked_sub(n: Int, m: Int) -> Int? { checked(1, n, m) }

fn int_checked_mul(n: Int, m: Int) -> Int? { checked(2, n, m) }

fn int_checked_div(n: Int, m: Int) -> Int? { checked(3, n, m) }

/// The bound an overflowing a op b saturates to.
fn saturated(op: Int, n: Int, m: Int) -> Int {
  let max = Int.max
  let min = Int.min
  if ints.fits(op, n, m) {
    return ints.apply(op, n, m)
  }
  if op == 0 {
    return if m > 0 { max } else { min }
  }
  if op == 1 {
    return if m > 0 { min } else { max }
  }
  if (n < 0) != (m < 0) { min } else { max }
}

fn int_saturating_add(n: Int, m: Int) -> Int { saturated(0, n, m) }

fn int_saturating_sub(n: Int, m: Int) -> Int { saturated(1, n, m) }

fn int_saturating_mul(n: Int, m: Int) -> Int { saturated(2, n, m) }

fn int_parse(s: Str) -> Int? { text.parse_int(s) }

fn float_parse(s: Str) -> Float? { num.parse_float(s) }

// ---------------------------------------------------------------------------
// Map[K, V] and Set[T] (std.md 2.4): std/rt map.go's order, the entries
// in insertion order

fn map_filter[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Map[K, V] ! E uses fx {
  var out: Map[K, V] = {}
  for (k, v) in m {
    if f(k, v)? {
      out[k] = v
    }
  }
  out
}

fn map_map[K, V, U, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> U ! E uses fx) -> Map[K, U] ! E uses fx {
  var out: Map[K, U] = {}
  for (k, v) in m {
    out[k] = f(k, v)?
  }
  out
}

/// `m.extend(other)` (decision 0592): Go's maps.Copy.
fn map_extend[K, V](var m: Map[K, V], other: Map[K, V]) {
  for (k, v) in other {
    m[k] = v
  }
}

/// `m.clone()` (decision 0592): a table of its own, in m's order.
fn map_clone[K, V](m: Map[K, V]) -> Map[K, V] {
  var out: Map[K, V] = {}
  for (k, v) in m {
    out[k] = v
  }
  out
}

fn map_any[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for (k, v) in m {
    if f(k, v)? {
      return true
    }
  }
  false
}

fn map_all[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for (k, v) in m {
    if !f(k, v)? {
      return false
    }
  }
  true
}

fn set_any[T, E, fx: Effects](s: Set[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in s {
    if f(x)? {
      return true
    }
  }
  false
}

fn set_all[T, E, fx: Effects](s: Set[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in s {
    if !f(x)? {
      return false
    }
  }
  true
}

fn set_filter[T, E, fx: Effects](s: Set[T], f: fn(T) -> Bool ! E uses fx) -> Set[T] ! E uses fx {
  var r: Set[T] = #{}
  for x in s {
    if f(x)? {
      r.add(x)
    }
  }
  r
}

/// The set of f's results, in the order of their first appearance.
fn set_map[T, U, E, fx: Effects](s: Set[T], f: fn(T) -> U ! E uses fx) -> Set[U] ! E uses fx {
  var r: Set[U] = #{}
  for x in s {
    r.add(f(x)?)
  }
  r
}

fn set_union[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r = s
  for x in o {
    r.add(x)
  }
  r
}

fn set_intersect[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r: Set[T] = #{}
  for x in s {
    if o.contains(x) {
      r.add(x)
    }
  }
  r
}

fn set_is_subset[T](s: Set[T], o: Set[T]) -> Bool {
  if s.len() > o.len() {
    return false
  }
  for x in s {
    if !o.contains(x) {
      return false
    }
  }
  true
}

fn set_intersects[T](s: Set[T], o: Set[T]) -> Bool {
  // walk the smaller set
  if s.len() > o.len() {
    return set_intersects(o, s)
  }
  for x in s {
    if o.contains(x) {
      return true
    }
  }
  false
}

fn set_difference[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r: Set[T] = #{}
  for x in s {
    if !o.contains(x) {
      r.add(x)
    }
  }
  r
}

// ---------------------------------------------------------------------------
// List[T] (std.md 2.3)

fn list_insert[T](var xs: List[T], i: Int, x: T, at: rt.Loc) {
  let n = xs.len()
  if i < 0 || i > n {
    rt.fault_at("index ${i} out of range for insert into List of length ${n}", at)
  }
  // the push makes xs unique; x then moves down by swaps, which count
  // nothing (a counted move retained and released each element shifted)
  xs.push(x)
  var j = n
  while j > i {
    rt.list_swap(xs, j, j - 1)
    j -= 1
  }
}

fn list_remove_at[T](var xs: List[T], i: Int, at: rt.Loc) -> T {
  let n = xs.len()
  if i < 0 || i >= n {
    rt.fault_at("index ${i} out of range for List of length ${n}", at)
  }
  // one counted write makes xs unique for the swaps
  // (gotchas/list-swap-bypasses-copy-on-write.md); element i then moves
  // to the end by swaps, which count nothing, and the pop releases it
  let x = xs[i]
  xs[i] = x
  var j = i
  while j + 1 < n {
    rt.list_swap(xs, j, j + 1)
    j += 1
  }
  match xs.pop() {
    _ => {}
  }
  x
}

/// The Ints from lo up to hi, hi excluded (`Range.to_list`).
fn int_range_list(lo: Int, hi: Int) -> List[Int] {
  var out: List[Int] = []
  var i = lo
  while i < hi {
    out.push(i)
    i += 1
  }
  out
}

fn list_indexed[T](xs: List[T]) -> List[(Int, T)] {
  var out: List[(Int, T)] = if xs.len() >= PRESIZE_MIN { List[(Int, T)].with_capacity(xs.len()) } else { [] }
  var i = 0
  for x in xs {
    out.push((i, x))
    i += 1
  }
  out
}

fn list_contains[T](xs: List[T], x: T) -> Bool {
  for y in xs {
    if y == x {
      return true
    }
  }
  false
}

fn list_index_of[T](xs: List[T], x: T) -> Int? {
  for (i, y) in xs.indexed() {
    if y == x {
      return Some(i)
    }
  }
  None
}

/// A result of a known length is allocated at its size from this many
/// elements (list_map, list_indexed, bytes_indexed, group_by, sort_by);
/// shorter ones grow from [] as before: rl_new_n cost more than the
/// first push's growth for 2 to 4 elements (2026-11-05, linux/arm64
/// listmap small 1.04, sortby_small 1.039 sized at any length).
const PRESIZE_MIN = 16

/// list_map's in-place path starts at this length (decision 0508).
const MAP_IN_PLACE_MIN = 256

fn list_map[T, U, E, fx: Effects](xs: List[T], f: fn(T) -> U ! E uses fx) -> List[U] ! E uses fx {
  // xs's last use (decision 0508): when the caller let go of its list
  // too, a holds the only reference
  var a = xs
  // the type test costs two small allocations, more than a short list's
  // own build (linux/arm64 --ab: a 32 element list 1.07 of main's time,
  // four Ints 2.4 times with no threshold; bench/perf/listmap)
  if a.len() >= MAP_IN_PLACE_MIN {
    if let Some(g) = rt.any_get[fn(T) -> T ! E uses fx](rt.any_of[fn(T) -> U ! E uses fx](f)) {
      // U is T: each result is written over its element, so a list nothing
      // else holds is mapped in its own array; one another binding holds is
      // copied at the first write, as any var list write copies it. f is
      // seen as a fn(T) -> T once, so no element is converted, and the type
      // test takes no reference to a
      for i in 0..a.len() {
        a[i] = g(a[i])?
      }
      if let Some(r) = rt.any_get[List[U]](rt.any_of[List[T]](a)) {
        return r
      }
    }
  }
  if a.len() >= PRESIZE_MIN {
    return list_map_sized(a, f)
  }
  var out: List[U] = []
  for x in a {
    out.push(f(x)?)
  }
  out
}

/// list_map of PRESIZE_MIN or more elements into a result allocated once
/// (2026-11-05: growing from [] copied a million element result about 40
/// times). Out of line, so list_map's short path stays as small as before
/// (sized inline, listmap small read 1.034 on linux/arm64).
fn list_map_sized[T, U, E, fx: Effects](a: List[T], f: fn(T) -> U ! E uses fx) -> List[U] ! E uses fx {
  var out = List[U].with_capacity(a.len())
  for x in a {
    out.push(f(x)?)
  }
  out
}

fn list_filter[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> List[T] ! E uses fx {
  var out: List[T] = []
  for x in xs {
    if f(x)? {
      out.push(x)
    }
  }
  out
}

fn list_filter_map[T, U, E, fx: Effects](xs: List[T], f: fn(T) -> U? ! E uses fx) -> List[U] ! E uses fx {
  var out: List[U] = []
  for x in xs {
    if let Some(y) = f(x)? {
      out.push(y)
    }
  }
  out
}

fn list_fold[T, A, E, fx: Effects](xs: List[T], init: A, f: fn(A, T) -> A ! E uses fx) -> A ! E uses fx {
  var acc = init
  for x in xs {
    acc = f(acc, x)?
  }
  acc
}

fn list_find[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> T? ! E uses fx {
  for x in xs {
    if f(x)? {
      return Some(x)
    }
  }
  None
}

fn list_any[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in xs {
    if f(x)? {
      return true
    }
  }
  false
}

fn list_all[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in xs {
    if !f(x)? {
      return false
    }
  }
  true
}

/// The elements of Int lists in one new list: one allocation and a memory
/// copy each (Go's slices.Clone and Concat copy memory; an Int is a word
/// with nothing to count; rt.cast of a List[Float] is not native yet).
fn ints_concat(lists: List[List[Int]]) -> List[Int] {
  var n = 0
  for l in lists {
    n += l.len()
  }
  if n == 0 {
    return []
  }
  let out = List[Int].with_capacity(n)
  let a = rt.obj_addr(out).wrapping_add(rt.layout(2))
  var at = 0
  for l in lists {
    let k = l.len()
    if k > 0 {
      rt.mem_copy(a + at * 8, rt.obj_addr(l).wrapping_add(rt.layout(2)), k * 8)
      at += k
    }
  }
  if rt.layout(6) == 8 {
    rt.mem_store(rt.obj_addr(out), rt.layout(3), n, 8)
  } else {
    rt.mem_store(rt.obj_addr(out), rt.layout(3), n, 4)
  }
  out
}

/// The lists joined by ints_concat when T is Int and there are
/// at least 64 elements (below that the Any checks cost more than pushes).
fn words_concat[T](lists: List[List[T]], n: Int) -> List[T]? {
  if n < 64 {
    return None
  }
  if let Some(is) = rt.any_get[List[List[Int]]](rt.any_of[List[List[T]]](lists)) {
    return rt.any_get[List[T]](rt.any_of[List[Int]](ints_concat(is)))
  }
  None
}

/// `xs.clone()` (decision 0592): Go's slices.Clone.
fn list_clone[T](xs: List[T]) -> List[T] {
  // a copy written once in place: the runtime's copy on write copies the
  // shared storage as one block, counting each element up (rl_copy), for
  // every element type
  var out = xs
  if out.len() > 0 {
    out[0] = xs[0]
  }
  out
}

/// `List.concat(lists)` (decision 0592): Go's slices.Concat, sized once.
fn list_concat[T](lists: List[List[T]]) -> List[T] {
  var n = 0
  for l in lists {
    n += l.len()
  }
  if let Some(r) = words_concat(lists, n) {
    return r
  }
  var out: List[T] = List.with_capacity(n)
  for l in lists {
    for x in l {
      out.push(x)
    }
  }
  out
}

/// `xs.binary_search(x)` (decision 0592): Go's slices.BinarySearch.
fn list_binary_search[T: Ord](xs: List[T], x: T) -> (Int, Bool) {
  let n = xs.len()
  var lo = 0
  var hi = n
  while lo < hi {
    let h = lo + (hi - lo) / 2
    if xs[h] < x {
      lo = h + 1
    } else {
      hi = h
    }
  }
  (lo, lo < n && !(x < xs[lo]))
}

/// `xs.is_sorted()`: Go's slices.IsSorted, by Xo's Ord (as sort).
fn list_is_sorted[T: Ord](xs: List[T]) -> Bool {
  for i in 1..xs.len() {
    if xs[i] < xs[i - 1] {
      return false
    }
  }
  true
}

/// `xs.max()` (decision 0592): Go's slices.Max, None when empty; a NaN
/// (an element not equal to itself) is the result, as Go's max gives.
fn list_max[T: Ord](xs: List[T]) -> T? {
  let n = xs.len()
  if n == 0 {
    return None
  }
  var m = xs[0]
  if m != m {
    return Some(m)
  }
  for i in 1..n {
    let v = xs[i]
    if v != v {
      return Some(v)
    }
    if v > m {
      m = v
    }
  }
  Some(m)
}

/// `xs.min()` (decision 0592): Go's slices.Min.
fn list_min[T: Ord](xs: List[T]) -> T? {
  let n = xs.len()
  if n == 0 {
    return None
  }
  var m = xs[0]
  if m != m {
    return Some(m)
  }
  for i in 1..n {
    let v = xs[i]
    if v != v {
      return Some(v)
    }
    if v < m {
      m = v
    }
  }
  Some(m)
}

fn list_reverse[T](xs: List[T]) -> List[T] {
  // xs's last use (decision 0508): a list nothing else holds is reversed
  // in its own array; the counted write makes a unique first (a copy when
  // another binding holds the list), since the swaps write raw words
  // (gotchas/list-swap-bypasses-copy-on-write.md)
  var a = xs
  let n = a.len()
  if n < 2 {
    return a
  }
  let first = a[0]
  a[0] = first
  var i = 0
  var j = n - 1
  while i < j {
    rt.list_swap(a, i, j)
    i += 1
    j -= 1
  }
  a
}

/// A stable merge sort of xs by keys (std/rt sorts stably). The index
/// list is sorted in its own array (merge_sort_in_place) and each list
/// gets its length once: the merge sort's new list per pass was 10% of the
/// self-build's allocation, nearly all of it regalloc's merge_ranges
/// (2026-10-30, ADR 0448 stage 4).
fn list_sort_by[T, K: Ord, E, fx: Effects](xs: List[T], key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx {
  // xs's last use (decision 0508): when the caller let go of its list
  // too, a holds the only reference and is sorted in its own array;
  // one another binding holds is copied by sort_in_place_by's first
  // write, so that holder keeps its order
  var a = xs
  list_sort_in_place_by(a, key)?
  a
}

/// The elements grouped by key, the keys in first appearance order and each
/// group in input order.
fn list_group_by[T, K: Hash, E, fx: Effects](xs: List[T], key: fn(T) -> K ! E uses fx) -> List[(K, List[T])] ! E uses fx {
  var at: Map[K, Int] = {}
  var keys: List[K] = []
  var groups: List[List[T]] = []
  for x in xs {
    let k = key(x)?
    match at.get(k) {
      Some(i) => {
        var g = groups[i]
        groups[i] = []
        g.push(x)
        groups[i] = g
      }
      None => {
        at[k] = keys.len()
        keys.push(k)
        groups.push([x])
      }
    }
  }
  var out: List[(K, List[T])] = if keys.len() >= PRESIZE_MIN { List[(K, List[T])].with_capacity(keys.len()) } else { [] }
  for i in 0..keys.len() {
    out.push((keys[i], groups[i]))
  }
  out
}

/// A stable sort of xs: runs of 16 sorted by insertion, then bottom up
/// merges between two buffers (a pair of runs already in order is copied,
/// so sorted input costs one pass). Merge order is stable: an element of
/// the right run goes first only when it is strictly less. Every move is
/// a swap (rt.list_swap inside a run, rt.list_swap2 from one buffer into
/// the other, whose slot is dead for the rest of the pass), so no element
/// is counted or released after the two copies; a counted move retained
/// the element and released the one it replaced (netip's compare, a Str
/// in each Addr, 2026-11-04).
fn list_sort[T: Ord](xs: List[T]) -> List[T] {
  let n = xs.len()
  if n < 2 {
    return xs
  }
  if let Some(ss) = rt.any_get[List[Str]](rt.any_of[List[T]](xs)) {
    if let Some(r) = rt.any_get[List[T]](rt.any_of[List[Str]](list_sort_str(ss))) {
      return r
    }
  }
  // xs's last use: when the call was the caller's last use of its list
  // too, a holds the only reference and the sorts below write its array
  // instead of copying it (micro13 sort1M's xs.freeze().sort(), 2026-11-04)
  var a = xs
  if rt.any_get[List[Int]](rt.any_of[List[T]]([])).is_some() {
    // Ints: pdqsort in a's own array (list_sort_in_place). The type test
    // is on an empty list, so it takes no reference to a
    list_sort_in_place(a)
    return a
  }
  // a counted write each makes a and b unique for the swaps
  // (gotchas/list-swap-bypasses-copy-on-write.md): a copies the caller's
  // list when another binding holds it, b a's
  let a0 = a[0]
  a[0] = a0
  var lo = 0
  while lo < n {
    let hi = if lo + 16 < n { lo + 16 } else { n }
    var i = lo + 1
    while i < hi {
      let x = a[i]
      var j = i
      while j > lo && x < a[j - 1] {
        rt.list_swap(a, j, j - 1)
        j -= 1
      }
      i += 1
    }
    lo = hi
  }
  if n <= 16 {
    return a
  }
  var b = a
  let b0 = b[0]
  b[0] = b0
  var width = 16
  while width < n {
    var lo2 = 0
    while lo2 < n {
      var mid = lo2 + width
      if mid > n {
        mid = n
      }
      var hi = mid + width
      if hi > n {
        hi = n
      }
      var i = lo2
      var j = mid
      var k = lo2
      if mid < hi && a[mid] < a[mid - 1] {
        while i < mid && j < hi {
          if a[j] < a[i] {
            rt.list_swap2(b, k, a, j)
            j += 1
          } else {
            rt.list_swap2(b, k, a, i)
            i += 1
          }
          k += 1
        }
      }
      while i < mid {
        rt.list_swap2(b, k, a, i)
        i += 1
        k += 1
      }
      while j < hi {
        rt.list_swap2(b, k, a, j)
        j += 1
        k += 1
      }
      lo2 = hi
    }
    let t = a
    a = b
    b = t
    width *= 2
  }
  a
}

// ---------------------------------------------------------------------------
// Ints: pattern-defeating quicksort, ported from Go's slices
// zsortordered.go (pdqsortOrdered and its helpers; The Go Authors,
// BSD-style license), which slices.Sort runs. Equal Ints cannot be told
// apart, so an unstable sort gives the stable one's result; the merge's
// branch on two loaded values mispredicted on random input (sort1M 1.67x
// Go's on an i7, Intel tester 0.33.0). Pattern breaking draws from an LCG
// in Int range where Go's xorshift wraps; it only moves which elements
// are swapped, never the result.

/// d sorted ascending in its own array (slices.Sort).
fn pdq_sort_ints(var d: List[Int]) {
  let n = d.len()
  var limit = 0
  var m = n
  while m > 0 {
    limit += 1
    m = m / 2
  }
  pdq_int(d, 0, n, limit)
}

fn pdq_insertion(var d: List[Int], a: Int, b: Int) {
  var i = a + 1
  while i < b {
    var j = i
    while j > a && d[j] < d[j - 1] {
      let t1 = d[j]
      d[j] = d[j - 1]
      d[j - 1] = t1
      j -= 1
    }
    i += 1
  }
}

fn pdq_sift_down(var d: List[Int], lo: Int, hi: Int, first: Int) {
  var root = lo
  while true {
    var child = 2 * root + 1
    if child >= hi {
      return
    }
    if child + 1 < hi && d[first + child] < d[first + child + 1] {
      child += 1
    }
    if !(d[first + root] < d[first + child]) {
      return
    }
    let t2 = d[first + root]
    d[first + root] = d[first + child]
    d[first + child] = t2
    root = child
  }
}

fn pdq_heap(var d: List[Int], a: Int, b: Int) {
  let first = a
  let hi = b - a
  var i = (hi - 1) / 2
  while i >= 0 {
    pdq_sift_down(d, i, hi, first)
    i -= 1
  }
  i = hi - 1
  while i >= 0 {
    let t3 = d[first]
    d[first] = d[first + i]
    d[first + i] = t3
    pdq_sift_down(d, 0, i, first)
    i -= 1
  }
}

/// pdqsortOrdered: d[a..b] sorted; limit bad pivots before heapsort.
fn pdq_int(var d: List[Int], a0: Int, b0: Int, limit0: Int) {
  var a = a0
  var b = b0
  var limit = limit0
  var was_balanced = true
  var was_partitioned = true
  while true {
    let length = b - a
    if length <= 12 {
      pdq_insertion(d, a, b)
      return
    }
    if limit == 0 {
      pdq_heap(d, a, b)
      return
    }
    if !was_balanced {
      pdq_break_patterns(d, a, b)
      limit -= 1
    }
    let (pivot0, hint0) = pdq_choose_pivot(d, a, b)
    var pivot = pivot0
    var hint = hint0
    if hint == 2 {
      pdq_reverse(d, a, b)
      pivot = (b - 1) - (pivot - a)
      hint = 1
    }
    if was_balanced && was_partitioned && hint == 1 {
      if pdq_partial_insertion(d, a, b) {
        return
      }
    }
    if a > 0 && !(d[a - 1] < d[pivot]) {
      a = pdq_partition_equal(d, a, b, pivot)
      continue
    }
    let (mid, already) = pdq_partition(d, a, b, pivot)
    was_partitioned = already
    let left = mid - a
    let right = b - mid
    let threshold = length / 8
    if left < right {
      was_balanced = left >= threshold
      pdq_int(d, a, mid, limit)
      a = mid + 1
    } else {
      was_balanced = right >= threshold
      pdq_int(d, mid + 1, b, limit)
      b = mid
    }
  }
}

fn pdq_partition(var d: List[Int], a: Int, b: Int, pivot: Int) -> (Int, Bool) {
  let t4 = d[a]
  d[a] = d[pivot]
  d[pivot] = t4
  let p = d[a]
  var i = a + 1
  var j = b - 1
  while i <= j && d[i] < p {
    i += 1
  }
  while i <= j && !(d[j] < p) {
    j -= 1
  }
  if i > j {
    let t5 = d[j]
    d[j] = d[a]
    d[a] = t5
    return (j, true)
  }
  let t6 = d[i]
  d[i] = d[j]
  d[j] = t6
  i += 1
  j -= 1
  while true {
    while i <= j && d[i] < p {
      i += 1
    }
    while i <= j && !(d[j] < p) {
      j -= 1
    }
    if i > j {
      break
    }
    let t7 = d[i]
    d[i] = d[j]
    d[j] = t7
    i += 1
    j -= 1
  }
  let t8 = d[j]
  d[j] = d[a]
  d[a] = t8
  (j, false)
}

fn pdq_partition_equal(var d: List[Int], a: Int, b: Int, pivot: Int) -> Int {
  let t9 = d[a]
  d[a] = d[pivot]
  d[pivot] = t9
  let p = d[a]
  var i = a + 1
  var j = b - 1
  while true {
    while i <= j && !(p < d[i]) {
      i += 1
    }
    while i <= j && p < d[j] {
      j -= 1
    }
    if i > j {
      break
    }
    let t10 = d[i]
    d[i] = d[j]
    d[j] = t10
    i += 1
    j -= 1
  }
  i
}

fn pdq_partial_insertion(var d: List[Int], a: Int, b: Int) -> Bool {
  var i = a + 1
  for _ in 0..5 {
    while i < b && !(d[i] < d[i - 1]) {
      i += 1
    }
    if i == b {
      return true
    }
    if b - a < 50 {
      return false
    }
    let t11 = d[i]
    d[i] = d[i - 1]
    d[i - 1] = t11
    if i - a >= 2 {
      var j = i - 1
      while j >= 1 {
        if !(d[j] < d[j - 1]) {
          break
        }
        let t12 = d[j]
        d[j] = d[j - 1]
        d[j - 1] = t12
        j -= 1
      }
    }
    if b - i >= 2 {
      var j = i + 1
      while j < b {
        if !(d[j] < d[j - 1]) {
          break
        }
        let t13 = d[j]
        d[j] = d[j - 1]
        d[j - 1] = t13
        j += 1
      }
    }
  }
  false
}

fn pdq_break_patterns(var d: List[Int], a: Int, b: Int) {
  let length = b - a
  if length >= 8 {
    var r = length % 2147483648
    var modulus = 1
    while modulus <= length {
      modulus *= 2
    }
    var idx = a + (length / 4) * 2 - 1
    while idx <= a + (length / 4) * 2 + 1 {
      r = (r * 1103515245 + 12345) % 2147483648
      var other = r % modulus
      if other >= length {
        other -= length
      }
      let t14 = d[idx]
      d[idx] = d[a + other]
      d[a + other] = t14
      idx += 1
    }
  }
}

/// choosePivotOrdered: the pivot's index and a hint, 0 unknown, 1
/// increasing, 2 decreasing.
fn pdq_choose_pivot(d: List[Int], a: Int, b: Int) -> (Int, Int) {
  let l = b - a
  var swaps = 0
  var i = a + l / 4
  var j = a + l / 4 * 2
  var k = a + l / 4 * 3
  if l >= 8 {
    if l >= 50 {
      let (i2, s1) = pdq_median(d, i - 1, i, i + 1, swaps)
      let (j2, s2) = pdq_median(d, j - 1, j, j + 1, s1)
      let (k2, s3) = pdq_median(d, k - 1, k, k + 1, s2)
      i = i2
      j = j2
      k = k2
      swaps = s3
    }
    let (j3, s4) = pdq_median(d, i, j, k, swaps)
    j = j3
    swaps = s4
  }
  if swaps == 0 {
    return (j, 1)
  }
  if swaps == 12 {
    return (j, 2)
  }
  (j, 0)
}

/// medianOrdered: the index of the median of d[a], d[b], d[c] and the
/// swap count.
fn pdq_median(d: List[Int], a0: Int, b0: Int, c0: Int, swaps0: Int) -> (Int, Int) {
  var a = a0
  var b = b0
  var c = c0
  var swaps = swaps0
  if d[b] < d[a] {
    swaps += 1
    let t = a
    a = b
    b = t
  }
  if d[c] < d[b] {
    swaps += 1
    let t = b
    b = c
    c = t
  }
  if d[b] < d[a] {
    swaps += 1
    let t = a
    a = b
    b = t
  }
  (b, swaps)
}

fn pdq_reverse(var d: List[Int], a: Int, b: Int) {
  var i = a
  var j = b - 1
  while i < j {
    let t15 = d[i]
    d[i] = d[j]
    d[j] = t15
    i += 1
    j -= 1
  }
}

/// A stable sort of xs in its own array, by less (decision 0374 step 3b):
/// runs of 16 by insertion, then bottom up merges that swap the left run
/// into a placeholder scratch and swap every element of the merge back, so
/// no element is ever counted or released and the list keeps the array it
/// came with. Merge order is stable: the right run's element goes first
/// only when less, and a pair of runs already in order is left alone.
fn merge_sort_in_place[T](var xs: List[T], less: fn(T, T) -> Bool) {
  let n = xs.len()
  if n < 2 {
    return
  }
  // the swaps write the receiver's array as raw words and the element
  // store's copy-on-write is what a counted write goes through, so the
  // list is made unique first with one counted element write
  // (gotchas/list-swap-bypasses-copy-on-write.md)
  let first = xs[0]
  xs[0] = first
  var lo = 0
  while lo < n {
    let hi = if lo + 16 < n { lo + 16 } else { n }
    var i = lo + 1
    while i < hi {
      let x = xs[i]
      var j = i
      while j > lo && less(x, xs[j - 1]) {
        rt.list_swap(xs, j, j - 1)
        j -= 1
      }
      i += 1
    }
    lo = hi
  }
  // the widest left run a merge moves out is the last width below n; the
  // scratch gets that much room once, so filling it does not reallocate
  var wmax = 16
  while wmax * 2 < n {
    wmax *= 2
  }
  var scratch: List[T] = List.with_capacity(wmax)
  var width = 16
  while width < n {
    var lo2 = 0
    while lo2 < n {
      var mid = lo2 + width
      if mid > n {
        mid = n
      }
      var hi = mid + width
      if hi > n {
        hi = n
      }
      if mid < hi && less(xs[mid], xs[mid - 1]) {
        merge_runs_in_place(xs, scratch, lo2, mid, hi, less)
      }
      lo2 = hi
    }
    width *= 2
  }
}

/// The end a merge was given past the list's length: a caller of
/// merge_runs_in_place broke the clamp that says hi <= xs.len(). Kept out of
/// the generic function so one cold body and one message serve every
/// element type the sort is instantiated at. The message names the
/// function, since this module imports `fault` and calls rt.fault_raise
/// with no source position (the same shape Bytes.zeroed's fault has).
fn merge_end_past(hi: Int, n: Int) -> Never {
  rt.fault_raise("merge_runs_in_place: the merge's end ${hi} is past the list's length ${n}", "")
}

/// xs[lo..mid) and xs[mid..hi) merged inside xs's own array (decision 0374
/// step 3b): the left run is swapped into scratch, whose every slot holds a
/// copy of xs[0] until a swap replaces it, and the merge then swaps each
/// element into place, so every element move is one swap and nothing is
/// counted or released. Both cursors move forward, so a slot is only
/// written after its element has been consumed, and the copies the swaps
/// leave in the scratch are released when the scratch is dropped. The right
/// run's element goes first only when less, which keeps the order stable,
/// and whatever is left of the right run is already in place.
fn merge_runs_in_place[T](var xs: List[T], var scratch: List[T], lo: Int, mid: Int, hi: Int, less: fn(T, T) -> Bool) {
  // the caller clamps hi to the length, which this body cannot see: said
  // here once, it lets every j below go unchecked (2026-10-26). A caller
  // that broke the clamp faults here, as it would have on the first read
  // past the end, rather than leaving the tail unsorted. The guard calls a
  // non generic helper, so the message is built once, not once per element
  // type this generic function is instantiated at.
  if hi > xs.len() {
    merge_end_past(hi, xs.len())
  }
  let left = mid - lo
  // a placeholder an element is one counted retain, once a width, not once
  // a merge
  while scratch.len() < left {
    scratch.push(xs[0])
  }
  var k = 0
  while k < left {
    rt.list_swap2(xs, lo + k, scratch, k)
    k += 1
  }
  var i = 0
  var j = mid
  var w = lo
  // the two cursors as one test plus a break, not `i < left && j < hi`:
  // the proof reads a comparison branch, and the short circuit carries its
  // second half in a phi instead (the body's j is then bounded by the
  // fall through of the break's guard)
  while i < left {
    if j >= hi {
      break
    }
    if less(xs[j], scratch[i]) {
      rt.list_swap(xs, w, j)
      j += 1
    } else {
      rt.list_swap2(xs, w, scratch, i)
      i += 1
    }
    w += 1
  }
  while i < left {
    rt.list_swap2(xs, w, scratch, i)
    i += 1
    w += 1
  }
}

/// container/heap's up: the element at j moves toward the root while it
/// is less than its parent.
fn heap_up[T: Ord](var xs: List[T], j0: Int) {
  var j = j0
  while j > 0 {
    let i = (j - 1) / 2
    if !(xs[j] < xs[i]) {
      break
    }
    let a = xs[i]
    let b = xs[j]
    xs[i] = b
    xs[j] = a
    j = i
  }
}

/// container/heap's down: the element at i0 moves toward the leaves
/// within the first n; whether it moved.
fn heap_down[T: Ord](var xs: List[T], i0: Int, n: Int) -> Bool {
  var i = i0
  while true {
    let j1 = 2 * i + 1
    if j1 >= n {
      break
    }
    var j = j1
    let j2 = j1 + 1
    if j2 < n && xs[j2] < xs[j1] {
      j = j2
    }
    if !(xs[j] < xs[i]) {
      break
    }
    let a = xs[i]
    let b = xs[j]
    xs[i] = b
    xs[j] = a
    i = j
  }
  i > i0
}

/// the position text of the heap faults (none: raised from the std)
const HEAP_LOC: Str = "?"

fn list_heap_push[T: Ord](var xs: List[T], x: T) {
  xs.push(x)
  heap_up(xs, xs.len() - 1)
}

fn list_heap_pop[T: Ord](var xs: List[T]) -> T? {
  let n = xs.len() - 1
  if n < 0 {
    return None
  }
  let a = xs[0]
  let b = xs[n]
  xs[0] = b
  xs[n] = a
  let _m = heap_down(xs, 0, n)
  xs.pop()
}

fn list_heap_remove[T: Ord](var xs: List[T], i: Int) -> T {
  let n = xs.len() - 1
  if i < 0 || i > n {
    fault.raise_str_at("List.heap_remove: index ${i} out of range for List of length ${n + 1}", raw.data(HEAP_LOC), 0)
  }
  if n != i {
    let a = xs[i]
    let b = xs[n]
    xs[i] = b
    xs[n] = a
    if !heap_down(xs, i, n) {
      heap_up(xs, i)
    }
  }
  xs.remove_at(n)
}

fn list_heap_fix[T: Ord](var xs: List[T], i: Int) {
  let n = xs.len()
  if i < 0 || i >= n {
    fault.raise_str_at("List.heap_fix: index ${i} out of range for List of length ${n}", raw.data(HEAP_LOC), 0)
  }
  if !heap_down(xs, i, n) {
    heap_up(xs, i)
  }
}

fn list_heapify[T: Ord](var xs: List[T]) {
  let n = xs.len()
  var i = n / 2 - 1
  while i >= 0 {
    let _m = heap_down(xs, i, n)
    i -= 1
  }
}

/// list_sort's sort in place, for a var receiver: the compiler has already
/// copied the list when another binding shares it, so the receiver's array
/// is the only one the sort writes.
fn list_sort_in_place[T: Ord](var xs: List[T]) {
  if let Some(v) = rt.any_get[List[Int]](rt.any_of[List[T]](xs)) {
    // Ints: pdq_sort_ints (slices.Sort), in the receiver's own
    // array. The receiver lets go of its reference first, so the Int view
    // is the array's only holder and its swaps copy nothing; the sorted
    // view then goes back. Equal Ints cannot be told apart, so the
    // unstable sort's result is the stable one's (bench/perf/micro13
    // sort1M: the merge with a compare closure, and sort's second list,
    // 2026-11-04)
    var is = v
    xs = []
    pdq_sort_ints(is)
    if let Some(back) = rt.any_get[List[T]](rt.any_of[List[Int]](is)) {
      xs = back
    }
    return
  }
  merge_sort_in_place(xs, fn(a, b) { a < b })
}

/// list_sort_by's sort in place: the keys are computed once, the indices
/// are sorted by them, and the elements are then put where their indices
/// say one cycle at a time with swaps, so the elements move inside the
/// receiver instead of into a second array and no move counts or releases
/// (decision 0374 step 3b).
fn list_sort_in_place_by[T, K: Ord, E, fx: Effects](var xs: List[T], key: fn(T) -> K ! E uses fx) -> () ! E uses fx {
  let n = xs.len()
  if n < 2 {
    return
  }
  // the cycle swaps write the receiver's array as raw words, so make the
  // list unique first with one counted element write
  // (gotchas/list-swap-bypasses-copy-on-write.md)
  let first = xs[0]
  xs[0] = first
  var keys: List[K] = if n >= PRESIZE_MIN { List[K].with_capacity(n) } else { [] }
  for x in xs {
    keys.push(key(x)?)
  }
  var idx: List[Int] = if n >= PRESIZE_MIN { List[Int].with_capacity(n) } else { [] }
  for i in 0..n {
    idx.push(i)
  }
  merge_sort_in_place(idx, fn(a, b) { keys[a] < keys[b] })
  // idx[k] is the position the element at k comes from; a cycle of it is
  // rotated with one swap a step, and each visited index is set to itself
  // so it is never followed again
  var k = 0
  while k < n {
    var cur = k
    while idx[cur] != k {
      let nxt = idx[cur]
      rt.list_swap(xs, cur, nxt)
      idx[cur] = cur
      cur = nxt
    }
    idx[cur] = cur
    k += 1
  }
}

/// Less and Greater swapped (decision 0586).
fn ordering_reverse(o: Ordering) -> Ordering {
  match o {
    Less => Ordering.Greater
    Equal => Ordering.Equal
    Greater => Ordering.Less
  }
}

/// o, or next when o is Equal.
fn ordering_then(o: Ordering, next: Ordering) -> Ordering {
  match o {
    Equal => next
    _ => o
  }
}

/// xs sorted by cmp, stable (decision 0586).
fn list_sort_with[T, E, fx: Effects](xs: List[T], cmp: fn(T, T) -> Ordering ! E uses fx) -> List[T] ! E uses fx {
  var a = xs
  list_sort_in_place_with(a, cmp)?
  a
}

/// A stable bottom up merge sort of the positions by cmp, the comparator
/// called in the loop (a closure cannot keep its error), then xs permuted
/// by cycles as list_sort_in_place_by does. An error from cmp returns
/// before xs is touched.
fn list_sort_in_place_with[T, E, fx: Effects](var xs: List[T], cmp: fn(T, T) -> Ordering ! E uses fx) -> () ! E uses fx {
  let n = xs.len()
  if n < 2 {
    return
  }
  var a: List[Int] = List.with_capacity(n)
  var t: List[Int] = List.with_capacity(n)
  for i in 0..n {
    a.push(i)
    t.push(0)
  }
  var w = 1
  while w < n {
    var lo = 0
    while lo < n {
      let mid = (lo + w).min(n)
      let hi = (lo + 2 * w).min(n)
      var i = lo
      var j = mid
      var k = lo
      while i < mid && j < hi {
        // the right run's element goes first only when strictly less
        let right_first = match cmp(xs[a[j]], xs[a[i]])? {
          Less => true
          _ => false
        }
        if right_first {
          t[k] = a[j]
          j += 1
        } else {
          t[k] = a[i]
          i += 1
        }
        k += 1
      }
      while i < mid {
        t[k] = a[i]
        i += 1
        k += 1
      }
      while j < hi {
        t[k] = a[j]
        j += 1
        k += 1
      }
      lo = hi
    }
    let sw = a
    a = t
    t = sw
    w *= 2
  }
  // the cycle swaps write the receiver's array as raw words, so make the
  // list unique first with one counted element write
  // (gotchas/list-swap-bypasses-copy-on-write.md)
  let first = xs[0]
  xs[0] = first
  var k = 0
  while k < n {
    var cur = k
    while a[cur] != k {
      let nxt = a[cur]
      rt.list_swap(xs, cur, nxt)
      a[cur] = cur
      cur = nxt
    }
    a[cur] = cur
    k += 1
  }
}

/// xs sorted by key from greatest to least, stable (decision 0586).
fn list_sort_by_desc[T, K: Ord, E, fx: Effects](xs: List[T], key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx {
  var a = xs
  list_sort_in_place_by_desc(a, key)?
  a
}

/// list_sort_in_place_by with the keys compared the other way: the right
/// run's element goes first only when its key is strictly greater, so
/// equal keys keep their order.
fn list_sort_in_place_by_desc[T, K: Ord, E, fx: Effects](var xs: List[T], key: fn(T) -> K ! E uses fx) -> () ! E uses fx {
  let n = xs.len()
  if n < 2 {
    return
  }
  let first = xs[0]
  xs[0] = first
  var keys: List[K] = if n >= PRESIZE_MIN { List[K].with_capacity(n) } else { [] }
  for x in xs {
    keys.push(key(x)?)
  }
  var idx: List[Int] = if n >= PRESIZE_MIN { List[Int].with_capacity(n) } else { [] }
  for i in 0..n {
    idx.push(i)
  }
  merge_sort_in_place(idx, fn(a, b) { keys[b] < keys[a] })
  var k = 0
  while k < n {
    var cur = k
    while idx[cur] != k {
      let nxt = idx[cur]
      rt.list_swap(xs, cur, nxt)
      idx[cur] = cur
      cur = nxt
    }
    idx[cur] = cur
    k += 1
  }
}

/// The first seven bytes of s as a big endian number, short strings padded
/// with zeros: a < b when the prefix of a is less than b's, and equal
/// prefixes are decided by comparing the strings.
fn str_prefix7(s: Str) -> Int {
  let b = s.bytes()
  var p = 0
  var i = 0
  while i < 7 {
    p = p * 256 + (if i < b.len() { Int(b[i]) } else { 0 })
    i += 1
  }
  p
}

/// list_sort for Strs: a stable bottom up merge sort of the indices, ordered
/// by each string's seven byte prefix and then the strings, so the merges
/// move Ints and never count a string (each move of a Str counted the string
/// it copied and released the one it replaced); the Strs are gathered once.
fn list_sort_str(xs: List[Str]) -> List[Str] {
  let n = xs.len()
  var pre: List[Int] = List.with_capacity(n)
  var a: List[Int] = List.with_capacity(n)
  for i in 0..n {
    pre.push(str_prefix7(xs[i]))
    a.push(i)
  }
  var s = 0
  while s < n {
    let e = if s + 16 < n { s + 16 } else { n }
    var i = s + 1
    while i < e {
      let x = a[i]
      let px = pre[x]
      var j = i
      while j > s {
        let y = a[j - 1]
        let py = pre[y]
        if px < py || (px == py && xs[x] < xs[y]) {
          a[j] = y
          j -= 1
        } else {
          break
        }
      }
      a[j] = x
      i += 1
    }
    s = e
  }
  var b = a
  var width = 16
  while width < n {
    var lo = 0
    while lo < n {
      var mid = lo + width
      if mid > n {
        mid = n
      }
      var hi = mid + width
      if hi > n {
        hi = n
      }
      var i = lo
      var j = mid
      var k = lo
      while i < mid && j < hi {
        let x = a[j]
        let y = a[i]
        let px = pre[x]
        let py = pre[y]
        if px < py || (px == py && xs[x] < xs[y]) {
          b[k] = x
          j += 1
        } else {
          b[k] = y
          i += 1
        }
        k += 1
      }
      while i < mid {
        b[k] = a[i]
        i += 1
        k += 1
      }
      while j < hi {
        b[k] = a[j]
        j += 1
        k += 1
      }
      lo = hi
    }
    let t = a
    a = b
    b = t
    width *= 2
  }
  var out: List[Str] = List.with_capacity(n)
  for i in 0..n {
    out.push(xs[a[i]])
  }
  out
}

fn list_to_set[T](xs: List[T]) -> Set[T] {
  var s: Set[T] = #{}
  for x in xs {
    s.add(x)
  }
  s
}

// ---------------------------------------------------------------------------
// Option[T] and Result[T, E] (std.md 2.5)

fn option_or_err[T, E](o: T?, e: E) -> Result[T, E] {
  match o {
    Some(v) => Ok(v)
    None => Err(e)
  }
}

fn option_map[T, U, fx: Effects](o: T?, f: fn(T) -> U uses fx) -> U? uses fx {
  match o {
    Some(v) => Some(f(v))
    None => None
  }
}

fn option_and_then[T, U, fx: Effects](o: T?, f: fn(T) -> U? uses fx) -> U? uses fx {
  match o {
    Some(v) => f(v)
    None => None
  }
}

fn result_map[T, E, U, fx: Effects](r: Result[T, E], f: fn(T) -> U uses fx) -> Result[U, E] uses fx {
  match r {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}

fn result_map_err[T, E, F, fx: Effects](r: Result[T, E], f: fn(E) -> F uses fx) -> Result[T, F] uses fx {
  match r {
    Ok(v) => Ok(v)
    Err(e) => Err(f(e))
  }
}

fn result_ignore_err[T, E](r: Result[T, E], reason: Str) -> T? {
  match r {
    Ok(v) => Some(v)
    Err(_) => None
  }
}

// ---------------------------------------------------------------------------
// Duration (std.md 2.6)

fn duration_parse(s: Str) -> Duration ! DurationErr {
  match text.parse_duration(s) {
    Some(d) => Ok(Duration.from_nanos(d))
    None => Err(DurationErr{input: s})
  }
}

fn durationerr_display(e: DurationErr) -> Str {
  "invalid duration ${unicode.quote(e.input.bytes())}: expected numbers with units ns, us, ms, s, m, h, such as \"1.5s\" or \"1h30m\""
}

// ---------------------------------------------------------------------------
// Fs (std.md 3.1, decision 0102): std/rt caps.go's realFs, over the system
// calls of std/llrt/xo_fs.c. An Fs is its root and mode bits (1 a sub
// capability, 2 read only, 4 write only).

fn fs_err(st: Int, p: Str) -> FsErr {
  match st {
    1 => FsErr.NotFound(path: p)
    2 => FsErr.Exists(path: p)
    3 => FsErr.NotEmpty(path: p)
    4 => FsErr.NotDir(path: p)
    5 => FsErr.IsDir(path: p)
    6 => FsErr.Denied(path: p)
    7 => FsErr.Io(path: p, msg: sysio.msg()[1])
    _ => FsErr.Canceled
  }
}

// fs_windows is whether paths follow Windows' rules (std.md 3.1): the
// build's target, resolved at compile time.
fn fs_windows() -> Bool {
  match target.os {
    TargetOs.Windows => true
    TargetOs.Darwin | TargetOs.Linux | TargetOs.Wasi | TargetOs.FreeBSD => false
  }
}

// fs_slash is p with \ as / on Windows (filepath.ToSlash), p elsewhere.
fn fs_slash(p: Str) -> Str {
  if fs_windows() {
    return p.replace("\\", "/")
  }
  p
}

// fs_volume is the volume of a slash separated Windows path
// (filepath.VolumeName): "C:" of "C:/x" or "C:x", "//host/share" of a
// UNC path; "" for others and on every other OS.
fn fs_volume(p: Str) -> Str {
  if !fs_windows() {
    return ""
  }
  let b = p.bytes()
  if b.len() >= 2 && b[1] == ':' && ((b[0] >= 'a' && b[0] <= 'z') || (b[0] >= 'A' && b[0] <= 'Z')) {
    return p[0..2]
  }
  if p.starts_with("//") && !p.starts_with("///") {
    let parts = p[2..].split("/")
    if parts.len() >= 2 && parts[0] != "" && parts[1] != "" {
      return "//${parts[0]}/${parts[1]}"
    }
  }
  ""
}

// fs_is_abs is filepath.IsAbs of a slash separated path: rooted at / on
// Unix; on Windows a drive with a root (C:/x) or a UNC path.
fn fs_is_abs(p: Str) -> Bool {
  if !fs_windows() {
    return p.starts_with("/")
  }
  let q = fs_slash(p)
  let v = fs_volume(q)
  if v == "" {
    return false
  }
  v.starts_with("//") || q[v.len()..].starts_with("/")
}

// fs_clean is Go's path.Clean; on Windows (filepath.Clean with /) \ is
// a separator too and a volume stays in front.
fn fs_clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  if fs_windows() {
    let q = fs_slash(p)
    let v = fs_volume(q)
    if v != "" {
      let rest = q[v.len()..]
      if rest == "" {
        return if v.starts_with("//") { v + "/" } else { v + "." }
      }
      let c = fs_clean_slash(rest)
      return v + c
    }
    return fs_clean_slash(q)
  }
  fs_clean_slash(p)
}

// fs_clean_slash is Go's path.Clean of a slash separated path.
/// Whether p is already what fs_clean_slash returns: no empty, "." or ".."
/// segment and no trailing slash (Go's path.Clean returns such a path
/// without building a copy).
fn fs_is_clean(p: Str) -> Bool {
  let b = p.bytes()
  let n = b.len()
  if n == 0 {
    return false
  }
  if n == 1 {
    return true
  }
  if b[n - 1] == 47 {
    return false
  }
  var i = if b[0] == 47 { 1 } else { 0 }
  while i < n {
    var j = i
    while j < n && b[j] != 47 {
      j += 1
    }
    let l = j - i
    if l == 0 {
      return false
    }
    if b[i] == 46 && (l == 1 || (l == 2 && b[i + 1] == 46)) {
      return false
    }
    i = j + 1
  }
  true
}

fn fs_clean_slash(p: Str) -> Str {
  if p == "" {
    return "."
  }
  if fs_is_clean(p) {
    return p
  }
  let rooted = p.starts_with("/")
  var parts: List[Str] = []
  for seg in p.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    if seg == ".." {
      if parts.len() > 0 && parts[parts.len() - 1] != ".." {
        match parts.pop() {
          _ => {}
        }
      } else if !rooted {
        parts.push("..")
      }
      continue
    }
    parts.push(seg)
  }
  let body = parts.join("/")
  if rooted {
    return "/" + body
  }
  if body == "" {
    return "."
  }
  body
}

// fs_join is Go's path.Join (filepath.Join on Unix) of two elements.
fn fs_join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return fs_clean(b)
  }
  if b == "" {
    return fs_clean(a)
  }
  fs_clean(a + "/" + b)
}

// fs_base is Go's path.Base (of the slash form on Windows).
fn fs_base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  var s = fs_slash(p)
  while s.len() > 1 && s.ends_with("/") {
    s = s[0..s.len() - 1]
  }
  if s == "/" {
    return "/"
  }
  let parts = s.split("/")
  parts[parts.len() - 1]
}

// fs_abs is filepath.Abs (with / on Windows: a path rooted at / is on
// the working directory's drive).
fn fs_abs(p: Str) -> Str {
  if fs_is_abs(p) {
    return fs_clean(p)
  }
  if fs_windows() && fs_slash(p).starts_with("/") {
    return fs_clean(fs_volume(fspath.cwd()) + fs_slash(p))
  }
  fs_join(fspath.cwd(), p)
}

// fs_resolve maps an Xo path to an OS path: os.fs takes it as it is, a
// sub capability resolves it against its root and denies (None) a path
// that escapes it.
fn fs_resolve(f: Fs, p: Str) -> Str? {
  if (rt.fs_mode(f) & 1) == 0 {
    if p == "" {
      return Some(".")
    }
    return Some(p)
  }
  let clean = fs_clean("/" + p.replace("\\", "/"))
  if p.contains("..") {
    var depth = 0
    for seg in p.split("/") {
      if seg == ".." {
        depth -= 1
      } else if seg != "" && seg != "." {
        depth += 1
      }
      if depth < 0 {
        return None
      }
    }
  }
  Some(fs_join(rt.fs_root(f), clean))
}

// fs_rel is the path of the OS path op relative to the root (op itself
// for os.fs).
fn fs_rel(f: Fs, op: Str, given: Str) -> Str {
  if (rt.fs_mode(f) & 1) == 0 {
    return fs_slash(op)
  }
  let root = fs_clean(rt.fs_root(f))
  let c = fs_clean(op)
  if c == root {
    return ""
  }
  if root == "/" {
    return c[1..]
  }
  if root.ends_with("/") && c.starts_with(root) {
    return c[root.len()..] // a Windows drive's root, C:/
  }
  if c.starts_with(root + "/") {
    return c[root.len() + 1..]
  }
  given
}

fn fs_check(f: Fs, p: Str, write: Bool) -> Str ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let mode = rt.fs_mode(f)
  if (write && (mode & 2) != 0) || (!write && (mode & 4) != 0) {
    return Err(FsErr.Denied(path: p))
  }
  match fs_resolve(f, p) {
    Some(op) => op
    None => Err(FsErr.Denied(path: p))
  }
}

// fs_info_of is the FileInfo of the facts i of OS path op (sysio.fs_stat).
fn fs_info_of(f: Fs, op: Str, given: Str, i: sysio.Info) -> FileInfo {
  FileInfo{name: fs_base(op), path: fs_rel(f, op, given), is_dir: i.is_dir, size: i.size, modified: Time.UNIX_EPOCH + Duration.from_nanos(i.modified), is_symlink: i.is_link}
}

fn fs_sub(f: Fs, dir: Str) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.sub(dir)
  }
  match fs_resolve(f, dir) {
    Some(op) => rt.fs_new(fs_abs(op), 1 | (rt.fs_mode(f) & 6))
    None => rt.fs_new(fs_join(rt.fs_root(f), "denied"), 7)
  }
}

// fs_cwd roots the capability at "." when the system gives no working
// directory (WASI preview1 has none): its paths stay relative, so they
// resolve against the working directory's preopen, not against `/`.
fn fs_cwd(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.cwd()
  }
  let w = fspath.cwd()
  rt.fs_new(if w.is_empty() { "." } else { w }, 1 | (rt.fs_mode(f) & 6))
}

// fs_cwd_path is the working directory as os.Getwd gives it (decision
// 0218): $PWD when it names the same directory as getcwd (its links
// kept, the path the shell shows), else getcwd itself (std/llrt/xo_fs.c:
// libc on Darwin, the system call on Linux, GetCurrentDirectoryW on
// Windows, where $PWD is not consulted). Io when getcwd fails.
fn fs_cwd_path(f: Fs) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.cwd_path()
  }
  // outside bytes (decision 0259)
  Ok(scan.text(fs_cwd_path_raw(f)?))
}

fn fs_cwd_path_raw(_f: Fs) -> Str ! FsErr {
  let wasi = match target.os {
    TargetOs.Wasi => true
    TargetOs.Darwin | TargetOs.Linux | TargetOs.Windows | TargetOs.FreeBSD => false
  }
  if wasi {
    return Err(FsErr.Io(path: ".", msg: "no working directory under WASI"))
  }
  let w = fspath.cwd()
  if w.is_empty() || w == "." {
    return Err(FsErr.Io(path: ".", msg: "getcwd failed"))
  }
  if fs_windows() {
    return w
  }
  let pwd = rt.env_get("PWD").get(0) ?? ""
  if pwd.starts_with("/") && pwd != w && fs_real_path(pwd) == w {
    return pwd
  }
  w
}

// fs_real_path is the absolute path p with the links of every element
// followed (filepath.EvalSymlinks; what getcwd reports in that
// directory); p cleaned after more than 40 links.
fn fs_real_path(p: Str) -> Str {
  var parts = fs_clean(p).split("/")
  var out = ""
  var i = 0
  var hops = 0
  while i < parts.len() {
    let part = parts[i]
    i += 1
    if part.is_empty() {
      continue
    }
    let q = "${out}/${part}"
    match fsops.read_link(q, q).get(0) {
      Some(t) => {
        hops += 1
        if hops > 40 {
          return fs_clean(p)
        }
        let next = if t.starts_with("/") { t } else { "${if out.is_empty() { "/" } else { out }}/${t}" }
        parts = fs_clean(next).split("/") + parts[i..]
        out = ""
        i = 0
      }
      None => out = q
    }
  }
  if out.is_empty() { "/" } else { out }
}

fn fs_read_only(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_only()
  }
  rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 2)
}

fn fs_write_only(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.write_only()
  }
  rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 4)
}

fn fs_case_sensitive(f: Fs) -> Bool {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.case_sensitive()
  }
  fsops.case_sensitive()
}

fn fs_stat(f: Fs, p: Str) -> FileInfo? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.stat(p)
  }
  let op = fs_check(f, p, false)?
  let i = sysio.fs_stat(op, true, p)
  let st = i.st
  if st == 1 {
    return None
  }
  if st != 0 {
    return Err(fs_err(st, p))
  }
  Some(fs_info_of(f, op, p, i))
}

/// The native backends' layout of the prelude's DiskUsage (decision 0426): a
/// prelude struct is opaque to the native SSA builder unless this module
/// declares its implementation, so the seed builds it without knowing it
/// (gotchas/new-prelude-struct-needs-native-twin.md); the fields match
/// std/prelude.xo's.
struct DiskUsage {
  total: Int
  free: Int
  available: Int
  files: Int
  files_free: Int
}

/// Fs.disk_usage (decision 0426): statfs of the path inside the Fs.
fn fs_disk_usage(f: Fs, p: Str) -> DiskUsage ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    // the prelude's DiskUsage, copied into this module's twin
    let v = u.disk_usage(p)?
    return DiskUsage{total: v.total, free: v.free, available: v.available, files: v.files, files_free: v.files_free}
  }
  let op = fs_check(f, p, false)?
  let (v, st, msg) = sysio.disk_usage(op)
  if st != 0 {
    if st == 7 {
      return Err(FsErr.Io(path: p, msg: msg))
    }
    return Err(fs_err(st, p))
  }
  DiskUsage{total: v[0], free: v[1], available: v[2], files: v[3], files_free: v[4]}
}

fn fs_exists(f: Fs, p: Str) -> Bool ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.exists(p)
  }
  let fi = fs_stat(f, p)?
  fi.is_some()
}

/// walk_dir (std.md 3.1, Go's filepath.WalkDir): through Fs.read_dir, so
/// any Fs answers, a directory read only when visit went into it; a
/// symbolic link is an entry of its own (read_dir does not follow it).
fn walk_dir[fx: Effects](fs: Fs, dir: Str, visit: fn(FileInfo) -> WalkStep uses fx) -> List[FileInfo] ! FsErr uses (fs.read, fx) {
  var out: List[FileInfo] = []
  walk_dir_in(fs, dir, visit, out)?
  out
}

/// walk_dir of dir, each visited entry added to out: true when visit
/// stopped the walk.
fn walk_dir_in[fx: Effects](fs: Fs, dir: Str, visit: fn(FileInfo) -> WalkStep uses fx, var out: List[FileInfo]) -> Bool ! FsErr uses (fs.read, fx) {
  for fi in fs.read_dir(dir)? {
    out.push(fi)
    match visit(fi) {
      WalkStep.Stop => return true
      WalkStep.SkipDir => {
        if !fi.is_dir {
          // Go: SkipDir on a file skips the rest of its directory
          return false
        }
      }
      WalkStep.Continue => {
        if fi.is_dir && walk_dir_in(fs, fi.path, visit, out)? {
          return true
        }
      }
    }
  }
  false
}

/// The native backends' layout of the prelude's DirEntry (decision 0483),
/// as DiskUsage: the fields match std/prelude.xo's
/// (gotchas/new-prelude-struct-needs-native-twin.md).
struct DirEntry {
  name: Str
  path: Str
  is_dir: Bool
  is_symlink: Bool = false
}

/// The DirEntry of a FileInfo (any Fs that answers through its methods).
fn dir_entry_of(fi: FileInfo) -> DirEntry {
  DirEntry{name: fi.name, path: fi.path, is_dir: fi.is_dir, is_symlink: fi.is_symlink}
}

/// read_dir_entries (decision 0483): the type from the directory entry
/// (fsops.entries), a stat only for an entry whose type the file system
/// does not give; a user value, and every Fs in the test world, answers
/// through read_dir.
fn read_dir_entries(fs: Fs, dir: Str) -> List[DirEntry] ! FsErr uses fs.read {
  if userfs.user(fs) is Some(_) || testworld.on() {
    var out: List[DirEntry] = []
    for fi in fs.read_dir(dir)? {
      out.push(dir_entry_of(fi))
    }
    return out
  }
  let op = fs_check(fs, dir, false)?
  let ents = fsops.entries(op, dir)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out = List[DirEntry].with_capacity(ents.len())
  // in name order, as read_dir
  for e in ents.sort_by(fn(x) { x[1..] }) {
    let kind = e.bytes()[0]
    let n = e[1..]
    let child = fs_join(op, n)
    let name = scan.text(n)
    let xc = fs_join(dir, name)
    if kind == 63 {
      let i = sysio.fs_stat(child, false, xc)
      if i.st == 1 {
        continue
      }
      if i.st != 0 {
        return Err(fs_err(i.st, xc))
      }
      out.push(DirEntry{name: name, path: fs_rel(fs, child, xc), is_dir: i.is_dir, is_symlink: i.is_link})
    } else {
      out.push(DirEntry{name: name, path: fs_rel(fs, child, xc), is_dir: kind == 100, is_symlink: kind == 108})
    }
  }
  out
}

/// DirEntry.info: an lstat of the entry now.
fn direntry_info(e: DirEntry, fs: Fs) -> FileInfo ! FsErr uses fs.read {
  if userfs.user(fs) is Some(_) || testworld.on() {
    match fs.stat(e.path)? {
      Some(fi) => return fi
      None => return Err(FsErr.NotFound(path: e.path))
    }
  }
  let op = fs_check(fs, e.path, false)?
  let i = sysio.fs_stat(op, false, e.path)
  if i.st != 0 {
    return Err(fs_err(i.st, e.path))
  }
  fs_info_of(fs, op, e.path, i)
}

fn walk_entries(fs: Fs, dir: Str) -> List[DirEntry] ! FsErr uses fs.read {
  walk_dir_entries(fs, dir, fn(e) { WalkStep.Continue })
}

fn walk_dir_entries[fx: Effects](fs: Fs, dir: Str, visit: fn(DirEntry) -> WalkStep uses fx) -> List[DirEntry] ! FsErr uses (fs.read, fx) {
  var out: List[DirEntry] = []
  walk_dir_entries_in(fs, dir, visit, out)?
  out
}

fn walk_dir_entries_in[fx: Effects](fs: Fs, dir: Str, visit: fn(DirEntry) -> WalkStep uses fx, var out: List[DirEntry]) -> Bool ! FsErr uses (fs.read, fx) {
  for e in read_dir_entries(fs, dir)? {
    out.push(e)
    match visit(e) {
      WalkStep.Stop => return true
      WalkStep.SkipDir => {
        if !e.is_dir {
          return false
        }
      }
      WalkStep.Continue => {
        if e.is_dir && walk_dir_entries_in(fs, e.path, visit, out)? {
          return true
        }
      }
    }
  }
  false
}

/// read_text_or and read_or (std.md 3.1): the file, or default when it
/// does not exist; through Fs's methods, so any Fs (MemFs, a sub or
/// attenuated one) answers as for read_text.
fn read_text_or(fs: Fs, path: Str, default: Str) -> Str ! FsErr uses fs.read {
  match fs.read_text(path) {
    Ok(s) => s
    Err(FsErr.NotFound(path: _)) => default
    Err(e) => Err(e)
  }
}

/// create_dir_all_mode (std.md 3.1): the missing directories, deepest
/// first, then create_dir_all and set_mode on each, deepest first, so a
/// parent's new mode never blocks setting a child's; through Fs's
/// methods, so any Fs answers.
fn create_dir_all_mode(fs: Fs, dir: Str, mode: Int) -> () ! FsErr uses fs {
  var made: List[Str] = []
  var p = fs_clean(dir)
  while p != "." && !fs.exists(p)? {
    made.push(p)
    let up = fs_dir(p)
    if up == p {
      break
    }
    p = up
  }
  fs.create_dir_all(dir)?
  for d in made {
    fs.set_mode(d, mode)?
  }
}

fn read_or(fs: Fs, path: Str, default: Bytes) -> Bytes ! FsErr uses fs.read {
  match fs.read(path) {
    Ok(b) => b
    Err(FsErr.NotFound(path: _)) => default
    Err(e) => Err(e)
  }
}

/// read_mapped (std.md 3.1, decision 0402): the file mapped read only on
/// linux and darwin (sysio.fs_read_mapped), read where it cannot be; a
/// user value converted to Fs, and every Fs in the test world (a MemFs, a
/// recording), reads through Fs's methods, so it never maps.
fn read_mapped(fs: Fs, path: Str) -> Bytes ! FsErr uses fs.read {
  if userfs.user(fs) is Some(_) || testworld.on() {
    return fs.read(path)
  }
  let op = fs_check(fs, path, false)?
  let l = sysio.fs_read_mapped(op)
  if l.len() == 0 {
    return Err(fs_err(sysio.status(), path))
  }
  l[0]
}

/// look_path (std.md 3.1, Go's exec.LookPath, decision 0606): through
/// Fs's stat and mode only, so every Fs answers the same way.
fn look_path(env: Env, fs: Fs, name: Str) -> Str ! ProcErr uses (env, fs.read) {
  let win = fs_windows()
  let has_sep = name.contains("/") || (win && name.contains("\\"))
  if has_sep {
    return match lp_find(fs, name, win) {
      Some(p) => Ok(p)
      None => Err(ProcErr.NotFound(name))
    }
  }
  let path = env.get("PATH") ?? ""
  for d in path.split(if win { ";" } else { ":" }) {
    let dir = if d == "" { "." } else { d }
    if let Some(p) = lp_find(fs, fs_join(dir, name), win) {
      // Go's ErrDot: a result relative to the working directory
      if !(p.starts_with("/") || (win && lp_win_abs(p))) {
        return Err(ProcErr.NotFound(name))
      }
      return Ok(p)
    }
  }
  Err(ProcErr.NotFound(name))
}

/// The executable at p: a regular file with an execute bit (Go's
/// findExecutable's mode check); on Windows p itself when it has an
/// extension, then p with each PATHEXT extension.
fn lp_find(fs: Fs, p: Str, win: Bool) -> Str? uses fs.read {
  if !win {
    if !lp_file(fs, p) {
      return None
    }
    let m = match fs.mode(p) {
      Ok(m) => m
      Err(_) => 0
    }
    return if m & 0o111 != 0 { Some(p) } else { None }
  }
  if lp_has_ext(p) && lp_file(fs, p) {
    return Some(p)
  }
  for ext in [".com", ".exe", ".bat", ".cmd"] {
    if lp_file(fs, p + ext) {
      return Some(p + ext)
    }
  }
  None
}

/// A file, not a directory, at p.
fn lp_file(fs: Fs, p: Str) -> Bool uses fs.read {
  match fs.stat(p) {
    Ok(Some(st)) => !st.is_dir
    _ => false
  }
}

/// The last element of p has an extension (filepath.Ext is not empty).
fn lp_has_ext(p: Str) -> Bool {
  let b = p.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != '/' && b[i] != '\\' {
    if b[i] == '.' {
      return true
    }
    i -= 1
  }
  false
}

/// A Windows path with a drive or a leading separator.
fn lp_win_abs(p: Str) -> Bool { p.starts_with("\\") || p.starts_with("/") || (p.len() >= 3 && p.bytes()[1] == ':' && (p.bytes()[2] == '\\' || p.bytes()[2] == '/')) }

/// create_temp_dir (std.md 3.1, Go's os.MkdirTemp): one exclusive mkdir
/// (fspath.create_temp_dir) on the real file system; through Fs's methods
/// for a user value converted to Fs and every Fs in the test world.
fn create_temp_dir(fs: Fs, dir: Str, prefix: Str) -> Str ! FsErr uses fs {
  if userfs.user(fs) is Some(_) || testworld.on() {
    for _ in 0..10000 {
      let p = fs_join(dir, prefix + "${rand.next_u64() & 0xFFFFFFFF}")
      if fs.stat(p)? is None {
        fs.create_dir_all(p)?
        return p
      }
    }
    return Err(FsErr.Exists(path: dir))
  }
  let op = fs_check(fs, dir, true)?
  let name = fspath.create_temp_dir(op, prefix, dir)
  if name == "" {
    return Err(fs_err(sysio.status(), dir))
  }
  // os.MkdirTemp joins without cleaning
  var full = op + "/" + name
  if op.ends_with("/") {
    full = op + name
  }
  fs_rel(fs, full, fs_join(dir, name))
}

/// write_atomic (std.md 3.1): data written to a temporary file beside
/// path, synced, given path's permission bits (0o644 for a new file),
/// and renamed over path, then the directory synced; through Fs's
/// methods, so any Fs answers, and the temporary file removed on a
/// failure.
fn write_atomic(fs: Fs, path: Str, data: Bytes) -> () ! FsErr uses fs {
  let dir = fs_dir(path)
  let tmp = fs.create_temp(dir, ".${fs_base(path)}.")?
  match atomic_fill(fs, tmp, path, data) {
    Ok(_) => ()
    Err(e) => {
      match fs.remove(tmp) {
        _ => ()
      }
      return Err(e)
    }
  }
  fs_sync_path(fs, dir, true)
}

fn atomic_fill(fs: Fs, tmp: Str, path: Str, data: Bytes) -> () ! FsErr uses fs {
  let mode = match fs.mode(path) {
    Ok(m) => m
    Err(FsErr.NotFound(path: _)) => 0o644
    Err(e) => return Err(e)
  }
  fs.write(tmp, data)?
  fs_sync_path(fs, tmp, false)?
  fs.set_mode(tmp, mode)?
  fs.rename(tmp, path)
}

/// Syncs the file or directory p of the real file system (write_atomic's
/// temporary file before the rename, its directory after); nothing for
/// another Fs (a user's; a test's MemFs through compiler/ssa testmode.xo).
fn fs_sync_path(f: Fs, p: Str, dir: Bool) -> () ! FsErr {
  if let Some(_) = userfs.user(f) {
    return
  }
  let op = fs_check(f, p, true)?
  let st = fsops.sync_path(op, dir)
  // not found: p was just written through f, so f is not the OS's (a
  // test's MemFs, whose value has the real Fs's shape, and calls between
  // native prelude functions are not routed to testing's memfs_*): there
  // is nothing to sync; a file really gone fails the rename after
  if st != 0 && st != 1 {
    return Err(fs_err(st, p))
  }
}

fn fs_read(f: Fs, p: Str) -> Bytes ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read(p)
  }
  let op = fs_check(f, p, false)?
  let l = sysio.fs_read(op)
  if l.len() == 0 {
    return Err(fs_err(sysio.status(), p))
  }
  l[0]
}

fn fs_read_text(f: Fs, p: Str) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_text(p)
  }
  let b = fs_read(f, p)?
  // outside bytes: U+FFFD for an invalid sequence (decision 0259)
  scan.text_of(b)
}

/// Each of xs (outside bytes) as scan.text (decision 0259).
fn texts(xs: List[Str]) -> List[Str] {
  var out = List[Str].with_capacity(xs.len())
  for x in xs {
    out.push(scan.text(x))
  }
  out
}

fn fs_read_dir(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_dir(dir)
  }
  let op = fs_check(f, dir, false)?
  let names = fsops.names(op, dir)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out: List[FileInfo] = []
  // in name order, as os.ReadDir: the first failing entry is Go's
  for n in names.sort() {
    let child = fs_join(op, n)
    // the name the program sees: outside bytes (decision 0259); the
    // system's path keeps the bytes
    let xc = fs_join(dir, scan.text(n))
    let i = sysio.fs_stat(child, false, xc)
    // os.File.Readdir: an entry removed since the listing is skipped,
    // any other lstat error is the result
    if i.st == 1 {
      continue
    }
    if i.st != 0 {
      return Err(fs_err(i.st, xc))
    }
    out.push(fs_info_of(f, child, xc, i))
  }
  out.sort_by(fn(fi) { fi.name })
}

fn fs_walk_dir(f: Fs, osdir: Str, xodir: Str, var out: List[FileInfo]) -> () ! FsErr {
  let names = fsops.names(osdir, xodir)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, xodir))
  }
  for n in names.sort() {
    let child = fs_join(osdir, n)
    let xc = fs_join(xodir, scan.text(n))
    let i = sysio.fs_stat(child, false, xc)
    // as fs_read_dir: only an entry removed since the listing is skipped
    if i.st == 1 {
      continue
    }
    if i.st != 0 {
      return Err(fs_err(i.st, xc))
    }
    let fi = fs_info_of(f, child, xc, i)
    out.push(fi)
    if fi.is_dir {
      fs_walk_dir(f, child, xc, out)?
    }
  }
}

fn fs_walk(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.walk(dir)
  }
  let op = fs_check(f, dir, false)?
  let st = sysio.fs_stat(op, true, dir).st
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out: List[FileInfo] = []
  fs_walk_dir(f, op, dir, out)?
  out
}

fn fs_write(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.write(p, data)
  }
  let op = fs_check(f, p, true)?
  let st = sysio.fs_write(op, data, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_create_temp(f: Fs, dir: Str, prefix: Str) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_temp(dir, prefix)
  }
  let op = fs_check(f, dir, true)?
  let name = fspath.create_temp(op, prefix, dir)
  if name == "" {
    return Err(fs_err(sysio.status(), dir))
  }
  // os.CreateTemp joins without cleaning
  var full = op + "/" + name
  if op.ends_with("/") {
    full = op + name
  }
  fs_rel(f, full, fs_join(dir, name))
}

fn fs_rename(f: Fs, from: Str, to: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.rename(from, to)
  }
  let a = fs_check(f, from, true)?
  let b = fs_check(f, to, true)?
  let st = fsops.rename(a, b, from)
  if st != 0 {
    return Err(fs_err(st, from))
  }
}

fn fs_remove(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.remove(p)
  }
  let op = fs_check(f, p, true)?
  let st = fsops.remove(op, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_remove_all(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.remove_all(p)
  }
  let op = fs_check(f, p, true)?
  let st = fspath.remove_all(op, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_create_dir_all(f: Fs, dir: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_dir_all(dir)
  }
  let op = fs_check(f, dir, true)?
  let st = fspath.mkdir_all(op, dir)
  if st != 0 {
    return Err(fs_err(st, dir))
  }
}

fn fs_set_modified(f: Fs, p: Str, t: Time) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.set_modified(p, t)
  }
  let op = fs_check(f, p, true)?
  let st = fsops.chtimes(op, (t - Time.UNIX_EPOCH).nanos(), p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

// ---------------------------------------------------------------------------
// Handles, append, copy, modes, links, globs, locks (std.md 3.1, decisions
// 0163 and 0172): std/rt fsfile.go over std/llrt/xo_fs.c.

struct File {
  h: rt.FsFile
  path: Str
  write: Bool
  /// A test's MemFs file (std/native/testing.xo memfile_*): its number in
  /// the MemFs state; 0 for a file of the real file system
  mem: Int = 0
  /// opened by open_append: write_at is refused (Go's os.File.WriteAt)
  append: Bool = false
  /// opened by open_rw: reads and writes both allowed, reads not buffered
  rw: Bool = false
}

struct FileLock {
  h: rt.FsLock
  /// A test's MemFs lock (std/native/testing.xo memlock_*); 0 for real
  mem: Int = 0
}

fn fs_open_mode(f: Fs, p: Str, mode: Int) -> File ! FsErr {
  let op = fs_check(f, p, mode != 0)?
  let h = fsops.open_file(op, mode, p)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  File{h: h, path: p, write: mode != 0, mem: 0, append: mode == 2, rw: mode == 6}
}

fn fs_open(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 0)
  }
  fs_open_mode(f, p, 0)
}

// A test's MemFs handles (rt.mem_file and the others; std/native/
// testing.xo memfile_* and memlock_*): the parts only this module sees.

fn llrt_mem_file(id: Int, path: Str, write: Bool) -> File { File{h: fsops.no_file(), path: path, write: write, mem: id, append: false, rw: false} }

fn llrt_mem_file_id(f: File) -> Int { f.mem }

fn llrt_mem_file_path(f: File) -> Str { f.path }

fn llrt_mem_file_writes(f: File) -> Bool { f.write }

fn llrt_mem_lock(id: Int) -> FileLock { FileLock{h: fsops.no_lock(), mem: id} }

fn llrt_mem_lock_id(l: FileLock) -> Int { l.mem }

fn fs_create(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 1)
  }
  fs_open_mode(f, p, 1)
}

fn fs_open_append(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 2)
  }
  fs_open_mode(f, p, 2)
}

fn fs_open_rw(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 6)
  }
  fs_open_mode(f, p, 6)
}

fn fs_create_new(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.open_as[File](u, p, 3)
  }
  fs_open_mode(f, p, 5)
}

/// The state errors of a handle (std/rt File.M_read): canceled, closed,
/// or open for the other direction.
fn file_state(f: File, write: Bool) -> () ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  if fsops.file_closed(f.h) {
    return Err(FsErr.Io(path: f.path, msg: "file already closed"))
  }
  if f.rw {
    return Ok(())
  }
  if f.write && !write {
    return Err(FsErr.Io(path: f.path, msg: "file is open for writing"))
  }
  if !f.write && write {
    return Err(FsErr.Io(path: f.path, msg: "file is open for reading"))
  }
}

fn file_read(f: File, max: Int) -> Bytes? ! FsErr {
  file_state(f, false)?
  if max <= 0 {
    return Some(b"")
  }
  let l = fsops.file_read(f.h, max, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  l.get(0)
}

fn file_read_at(f: File, offset: Int, max: Int) -> Bytes? ! FsErr {
  file_state(f, false)?
  if offset < 0 {
    return Err(FsErr.Io(path: f.path, msg: "negative offset"))
  }
  if max <= 0 {
    return Some(b"")
  }
  let l = fsops.file_read_at(f.h, offset, max, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  l.get(0)
}

fn file_read_line(f: File) -> Str? ! FsErr {
  file_state(f, false)?
  let l = fsops.file_read_line(f.h, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  match l.get(0) {
    Some(x) => Some(scan.text(x))
    None => None
  }
}

fn file_write(f: File, data: Bytes) -> () ! FsErr {
  file_state(f, true)?
  let st = fsops.file_write(f.h, data, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn file_write_at(f: File, offset: Int, data: Bytes) -> () ! FsErr {
  file_state(f, true)?
  if offset < 0 {
    return Err(FsErr.Io(path: f.path, msg: "negative offset"))
  }
  if f.append {
    return Err(FsErr.Io(path: f.path, msg: "invalid use of write_at on a file opened with open_append"))
  }
  let st = fsops.file_write_at(f.h, offset, data, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn file_seek(f: File, offset: Int, whence: Whence) -> Int ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  if fsops.file_closed(f.h) {
    return Err(FsErr.Io(path: f.path, msg: "file already closed"))
  }
  let w = match whence {
    Whence.Start => 0
    Whence.Current => 1
    Whence.End => 2
  }
  let l = fsops.file_seek(f.h, offset, w, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  Ok(l[0])
}

fn file_truncate(f: File, size: Int) -> () ! FsErr {
  file_state(f, true)?
  if size < 0 {
    return Err(FsErr.Io(path: f.path, msg: "negative size"))
  }
  let st = fsops.file_truncate(f.h, size, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn file_stat(f: File) -> FileInfo ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  if fsops.file_closed(f.h) {
    return Err(FsErr.Io(path: f.path, msg: "file already closed"))
  }
  let l = fsops.file_stat(f.h, f.path)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  Ok(FileInfo{name: fs_base(f.path), path: f.path, is_dir: (l[0] & 61440) == 16384, size: l[1], modified: Time.UNIX_EPOCH + Duration.from_nanos(l[2]), is_symlink: false})
}

fn file_sync(f: File) -> () ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  if fsops.file_closed(f.h) {
    return Err(FsErr.Io(path: f.path, msg: "file already closed"))
  }
  let st = fsops.file_sync(f.h, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

/// `copy_stream(dst, src)` (decision 0593): Go's io.Copy, 32 KiB reads.
fn copy_stream(dst: Stream, src: Stream) -> Int ! CopyErr[NetErr, NetErr] uses net {
  var n = 0
  while true {
    match src.read(32768) {
      Ok(Some(b)) => {
        match dst.write(b) {
          Ok(_) => {}
          Err(e) => return Err(CopyErr.Write(err: e))
        }
        n += b.len()
      }
      Ok(None) => return n
      Err(e) => return Err(CopyErr.Read(err: e))
    }
  }
  n
}

/// `f.copy_to(dst)` (decision 0593).
fn file_copy_to(f: File, dst: Stream) -> Int ! CopyErr[FsErr, NetErr] uses net {
  var n = 0
  while true {
    match file_read(f, 32768) {
      Ok(Some(b)) => {
        match dst.write(b) {
          Ok(_) => {}
          Err(e) => return Err(CopyErr.Write(err: e))
        }
        n += b.len()
      }
      Ok(None) => return n
      Err(e) => return Err(CopyErr.Read(err: e))
    }
  }
  n
}

/// `f.copy_from(src)` (decision 0593).
fn file_copy_from(f: File, src: Stream) -> Int ! CopyErr[NetErr, FsErr] uses net {
  var n = 0
  while true {
    match src.read(32768) {
      Ok(Some(b)) => {
        match file_write(f, b) {
          Ok(_) => {}
          Err(e) => return Err(CopyErr.Write(err: e))
        }
        n += b.len()
      }
      Ok(None) => return n
      Err(e) => return Err(CopyErr.Read(err: e))
    }
  }
  n
}

fn file_close(f: File) -> () ! FsErr {
  let st = fsops.file_close(f.h, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn fs_append(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.append(p, data)
  }
  let file = fs_open_mode(f, p, 2)?
  match file_write(file, data) {
    Ok(_) => ()
    Err(e) => {
      match file_close(file) {
        _ => ()
      }
      return Err(e)
    }
  }
  file_close(file)
}

fn fs_copy(f: Fs, from: Str, to: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.copy(from, to)
  }
  let src = fs_check(f, from, false)?
  let dst = fs_check(f, to, true)?
  let st = fsops.copy(src, dst, from, to)
  if st != 0 {
    return Err(fs_err(st, sysio.msg()[0]))
  }
}

fn fs_mode(f: Fs, p: Str) -> Int ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.mode(p)
  }
  let op = fs_check(f, p, false)?
  let m = fsops.perm(op, p)
  if m < 0 {
    return Err(fs_err(sysio.status(), p))
  }
  m
}

fn fs_set_mode(f: Fs, p: Str, mode: Int) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.set_mode(p, mode)
  }
  let op = fs_check(f, p, true)?
  let st = fsops.set_perm(op, mode, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

/// Go's path.Dir of a cleaned path.
fn fs_dir(p: Str) -> Str {
  var i = p.len() - 1
  while i >= 0 && raw.str_byte(p, i) != 47 {
    i -= 1
  }
  fs_clean(raw.str_slice(p, 0, i + 1))
}

/// strings.Trim(s, "/").
fn trim_slashes(s: Str) -> Str {
  var a = 0
  var b = s.len()
  while a < b && raw.str_byte(s, a) == 47 {
    a += 1
  }
  while b > a && raw.str_byte(s, b - 1) == 47 {
    b -= 1
  }
  raw.str_slice(s, a, b)
}

/// Whether a link at link (in a sub capability) to target points outside
/// the root: an absolute target, or more `..` than the link has parents
/// (std/rt linkEscapes).
fn link_escapes(link: Str, target: Str) -> Bool {
  let t = target.replace("\\", "/")
  if t.starts_with("/") || (t.len() >= 2 && raw.str_byte(t, 1) == 58) {
    return true
  }
  let dir = fs_dir(fs_clean("/" + link.replace("\\", "/")))
  var depth = 0
  for seg in (trim_slashes(dir) + "/" + t).split("/") {
    if seg == ".." {
      depth -= 1
    } else if seg != "" && seg != "." {
      depth += 1
    }
    if depth < 0 {
      return true
    }
  }
  false
}

fn fs_symlink(f: Fs, target: Str, link: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.symlink(target, link)
  }
  let op = fs_check(f, link, true)?
  if (rt.fs_mode(f) & 1) != 0 && link_escapes(link, target) {
    return Err(FsErr.Denied(path: link))
  }
  let st = fsops.symlink(target, op, link)
  if st != 0 {
    return Err(fs_err(st, link))
  }
}

fn fs_read_link(f: Fs, p: Str) -> Str? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_link(p)
  }
  let op = fs_check(f, p, false)?
  let l = fsops.read_link(op, p)
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  // outside bytes (decision 0259)
  match l.get(0) {
    Some(x) => Some(scan.text(x))
    None => None
  }
}

fn fs_lock_wait(f: Fs, p: Str, wait: Bool) -> FileLock? ! FsErr {
  let op = fs_check(f, p, true)?
  let h = fsops.lock(op, wait, p, false)
  if fsops.lock_held(h) {
    return Some(FileLock{h: h})
  }
  let st = sysio.status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  None
}

fn fs_lock(f: Fs, p: Str) -> FileLock ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.lock_as[FileLock](u, p)
  }
  match fs_lock_wait(f, p, true)? {
    Some(l) => l
    None => Err(FsErr.Canceled)
  }
}

fn fs_try_lock(f: Fs, p: Str) -> FileLock? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return userfs.try_lock_as[FileLock](u, p)
  }
  fs_lock_wait(f, p, false)
}

fn filelock_unlock(l: FileLock) { fsops.unlock(l.h) }

// Globs (std/rt fsGlob): Go's path.Match on each segment, `**` for any
// number of directories, through read_dir and exists.

/// Go's path.Match scanChunk: whether stars lead, the chunk, the rest.
fn glob_scan(p: Str) -> (Bool, Str, Str) {
  let n = p.len()
  var i = 0
  var star = false
  while i < n && raw.str_byte(p, i) == 42 {
    i += 1
    star = true
  }
  let start = i
  var inrange = false
  while i < n {
    let c = raw.str_byte(p, i)
    if c == 92 {
      if i + 1 < n {
        i += 1
      }
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 && !inrange {
      break
    }
    i += 1
  }
  (star, raw.str_slice(p, start, i), raw.str_slice(p, i, n))
}

/// Go's path.Match getEsc at chunk[c:]: the rune and the index after it,
/// or the index -1 for a malformed pattern.
fn glob_esc(chunk: Str, c0: Int) -> (Int, Int) {
  let n = chunk.len()
  var c = c0
  if c >= n || raw.str_byte(chunk, c) == 45 || raw.str_byte(chunk, c) == 93 {
    return (0, -1)
  }
  if raw.str_byte(chunk, c) == 92 {
    c += 1
    if c >= n {
      return (0, -1)
    }
  }
  let d = raw.bytes_decode(chunk.bytes(), c)
  let r = d >> 3
  let k = d & 7
  if r == 0xfffd && k == 1 {
    return (0, -1)
  }
  c += k
  if c >= n {
    return (0, -1)
  }
  (r, c)
}

/// Go's path.Match matchChunk of chunk against s[si:]: the index after
/// the match, -1 when it does not match, -2 for a malformed pattern.
fn glob_chunk(chunk: Str, s: Str, si0: Int) -> Int {
  let cn = chunk.len()
  let sn = s.len()
  var c = 0
  var si = si0
  var failed = false
  while c < cn {
    if !failed && si >= sn {
      failed = true
    }
    let ch = raw.str_byte(chunk, c)
    if ch == 91 {
      var r = 0
      if !failed {
        let d = raw.bytes_decode(s.bytes(), si)
        r = d >> 3
        si += d & 7
      }
      c += 1
      var negated = false
      if c < cn && raw.str_byte(chunk, c) == 94 {
        negated = true
        c += 1
      }
      var matched = false
      var nrange = 0
      while true {
        if c < cn && raw.str_byte(chunk, c) == 93 && nrange > 0 {
          c += 1
          break
        }
        let (lo, c1) = glob_esc(chunk, c)
        if c1 < 0 {
          return -2
        }
        c = c1
        var hi = lo
        if raw.str_byte(chunk, c) == 45 {
          let (h2, c2) = glob_esc(chunk, c + 1)
          if c2 < 0 {
            return -2
          }
          hi = h2
          c = c2
        }
        if lo <= r && r <= hi {
          matched = true
        }
        nrange += 1
      }
      if matched == negated {
        failed = true
      }
    } else if ch == 63 {
      if !failed {
        if raw.str_byte(s, si) == 47 {
          failed = true
        }
        si += raw.bytes_decode(s.bytes(), si) & 7
      }
      c += 1
    } else {
      if ch == 92 {
        c += 1
        if c >= cn {
          return -2
        }
      }
      if !failed {
        if raw.str_byte(chunk, c) != raw.str_byte(s, si) {
          failed = true
        }
        si += 1
      }
      c += 1
    }
  }
  if failed {
    return -1
  }
  si
}

/// Go's path.Match: 1 a match, 0 none, -1 a malformed pattern.
fn glob_match(pattern: Str, name: Str) -> Int {
  let nl = name.len()
  var p = pattern
  var ni = 0
  while p.len() > 0 {
    let (star, chunk, rest) = glob_scan(p)
    p = rest
    if star && chunk == "" {
      // a trailing * matches the rest of the name unless it has a /
      if scan.find(raw.str_slice(name, ni, nl), "/", 0) < 0 {
        return 1
      }
      return 0
    }
    let t = glob_chunk(chunk, name, ni)
    if t >= 0 && (t == nl || p.len() > 0) {
      ni = t
      continue
    }
    if t == -2 {
      return -1
    }
    var found = false
    if star {
      // a match after skipping i + 1 bytes, never a /
      var i = ni
      while !found && i < nl && raw.str_byte(name, i) != 47 {
        let t2 = glob_chunk(chunk, name, i + 1)
        if t2 >= 0 {
          if p.len() > 0 || t2 == nl {
            ni = t2
            found = true
          }
        } else if t2 == -2 {
          return -1
        }
        i += 1
      }
    }
    if found {
      continue
    }
    // the rest of the pattern must still be well formed
    while p.len() > 0 {
      let (_, c2, r2) = glob_scan(p)
      p = r2
      if glob_chunk(c2, "", 0) == -2 {
        return -1
      }
    }
    return 0
  }
  if ni == nl {
    return 1
  }
  0
}

fn glob_join(dir: Str, name: Str) -> Str {
  if dir == "" {
    return name
  }
  if dir.ends_with("/") {
    return dir + name
  }
  dir + "/" + name
}

fn glob_list(f: Fs, dir: Str) -> List[FileInfo] ! FsErr uses fs.read {
  var d = dir
  if d == "" {
    d = "."
  }
  match f.read_dir(d) {
    Ok(l) => l
    Err(e) => {
      match e {
        FsErr.NotFound(_) | FsErr.NotDir(_) => []
        _ => Err(e)
      }
    }
  }
}

fn glob_walk(f: Fs, segs: List[Str], dir: Str, i: Int, var out: List[Str], var seen: Set[Str]) -> () ! FsErr uses fs.read {
  if i == segs.len() {
    if !seen.contains(dir) {
      seen.add(dir)
      out.push(dir)
    }
    return
  }
  let s = segs[i]
  if s == "**" {
    glob_walk(f, segs, dir, i + 1, out, seen)?
    for x in glob_list(f, dir)? {
      if x.is_dir && !x.name.starts_with(".") {
        glob_walk(f, segs, glob_join(dir, x.name), i, out, seen)?
      }
    }
    return
  }
  if !(s.contains("*") || s.contains("?") || s.contains("[") || s.contains("\\")) {
    // a literal segment: no listing needed
    let p = glob_join(dir, s)
    if i == segs.len() - 1 {
      if f.exists(p)? && !seen.contains(p) {
        seen.add(p)
        out.push(p)
      }
      return
    }
    return glob_walk(f, segs, p, i + 1, out, seen)
  }
  for x in glob_list(f, dir)? {
    if x.name.starts_with(".") && !s.starts_with(".") {
      continue
    }
    if glob_match(s, x.name) != 1 {
      continue
    }
    if i < segs.len() - 1 && !x.is_dir {
      continue
    }
    glob_walk(f, segs, glob_join(dir, x.name), i + 1, out, seen)?
  }
}

fn fs_glob(f: Fs, pattern: Str) -> List[Str] ! FsErr uses fs.read {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.glob(pattern)
  }
  let pat = pattern.replace("\\", "/")
  let segs = trim_slashes(pat).split("/")
  for s in segs {
    if glob_match(s, "") < 0 {
      return Err(FsErr.Io(path: pat, msg: "bad pattern: syntax error in pattern"))
    }
  }
  var start = ""
  if pat.starts_with("/") {
    start = "/"
  }
  var out: List[Str] = []
  var seen: Set[Str] = #{}
  glob_walk(f, segs, start, 0, out, seen)?
  out.sort()
}

// ---------------------------------------------------------------------------
// Stdio (std.md 3.6, decisions 0088 and 0102): std/rt caps.go's realStdio

fn stdio_write(_s: Stdio, data: Bytes) -> () ! IoErr {
  if rt.fs_canceled() {
    return Err(IoErr.Canceled)
  }
  stdiort.out(raw.bytes_addr(data), data.len(), false)
}

fn stdin_err(st: Int, msg: Str) -> IoErr {
  if st == 2 {
    return IoErr.Io(msg: msg)
  }
  IoErr.Canceled
}

// ---------------------------------------------------------------------------
// Rand.shuffle (std.md 3.4): Fisher-Yates from the end, one `int` per
// step, as std/rt's Rand_shuffle (the same seeded order in tests)

fn rand_shuffle[T](r: Rand, xs: List[T]) -> List[T] {
  var out = xs
  var i = out.len() - 1
  while i > 0 {
    let j = r.int(0, i + 1)
    let a = out[i]
    out[i] = out[j]
    out[j] = a
    i -= 1
  }
  out
}

// ---------------------------------------------------------------------------
// Proc (std.md 3.7, decision 0107)

fn proc_run(p: Proc, cmd: Str, args: List[Str]) -> ProcOutput ! ProcErr {
  if !cap_admits(rt.proc_lists(p), cmd) {
    return Err(ProcErr.Denied(cmd))
  }
  var r: List[Str] = []
  if testworld.fake(testworld.REAL_PROC) {
    // FakeProc.on_run's outputs (std/native/llrt/testworld.xo)
    if !rt.fs_canceled() {
      testworld.proc_note(cmd, args)
    }
    r = if rt.fs_canceled() { ["3", ""] } else { testworld.proc_run(cmd) }
  } else {
    // std/native/llrt/proc.xo (work item B25)
    r = proc.run(cmd, args)
  }
  let st = r.get(0) ?? "2"
  let detail = r.get(1) ?? ""
  if st == "1" {
    return Err(ProcErr.NotFound(cmd))
  }
  if st == "2" {
    return Err(ProcErr.Io(detail))
  }
  if st == "3" {
    return Err(ProcErr.Canceled)
  }
  ProcOutput{code: text.parse_int(detail) ?? 0, stdout: (r.get(2) ?? "").bytes(), stderr: (r.get(3) ?? "").bytes(), usage: child_usage(r, 4)}
}

/// The child's usage at r[i..i+3] (proc.xo: user and system CPU
/// nanoseconds, peak resident set in bytes); zeros when r has none (a
/// fake's outcome).
fn child_usage(r: List[Str], i: Int) -> ProcUsage {
  let n = fn(k: Int) -> Int { text.parse_int(r.get(i + k) ?? "0") ?? 0 }
  ProcUsage{user: Duration.from_nanos(n(0)), system: Duration.from_nanos(n(1)), max_rss: n(2)}
}

// ---------------------------------------------------------------------------
// Attenuation (std.md 3.5 and 3.7, decisions 0156 and 0172): std/rt
// attenuate.go. A Proc, Env, or Net is the lists of its attenuations in one Str:
// each list is \u{1} and then its names, each followed by \u{0}; "" has
// none. Every list must admit a name.

fn cap_lists_add(lists: Str, names: List[Str]) -> Str {
  var b = lists + "\u{1}"
  for n in names {
    b = b + n + "\u{0}"
  }
  b
}

fn cap_admits(lists: Str, name: Str) -> Bool {
  if lists == "" {
    return true
  }
  let want = "\u{0}" + name + "\u{0}"
  var first = true
  for l in lists.split("\u{1}") {
    if first {
      first = false
      continue
    }
    if !("\u{0}" + l).contains(want) {
      return false
    }
  }
  true
}

/// Proc.kill (std.md 3.7, decision 0190): std/rt prockill.go. An
/// attenuated Proc must list "kill"; std/native/llrt/proc.xo sends the
/// signal, or records it for a test's FakeProc.
/// Proc.notify (decision 0407): the channel, holding one of each listed
/// signal, subscribed in llrt/sigsub.xo; the signals' bits by the
/// prelude's order of Signal.
fn proc_notify(p: Proc, signals: List[Signal]) -> Chan[Signal] uses proc {
  var mask = 0
  for s in signals {
    mask = mask | (1 << signal_index(s))
  }
  let c = Chan[Signal].new(if signals.is_empty() { 1 } else { signals.len() })
  if mask != 0 {
    sigsub.subscribe(rt.obj_addr(c), mask)
  }
  c
}

fn signal_index(s: Signal) -> Int {
  match s {
    Signal.Hangup => 0
    Signal.Interrupt => 1
    Signal.Quit => 2
    Signal.Terminate => 3
    Signal.User1 => 4
    Signal.User2 => 5
    Signal.WindowChange => 6
  }
}

/// Proc.stop_notify (decision 0407): the subscription ended, c closed.
fn proc_stop_notify(p: Proc, c: Chan[Signal]) uses proc {
  if sigsub.unsubscribe(rt.obj_addr(c)) {
    c.close()
  }
}

/// Proc.pid (decision 0410).
fn proc_pid(p: Proc) -> Int uses proc { procid.pid() }

/// The native backends' layout of the prelude's ProcUsage (decision 0426): a
/// prelude struct is opaque to the native SSA builder unless this module
/// declares its implementation, so the seed builds it without knowing it
/// (gotchas/new-prelude-struct-needs-native-twin.md); the fields match
/// std/prelude.xo's.
struct ProcUsage {
  user: Duration
  system: Duration
  max_rss: Int
}

/// The native layout of the prelude's ProcOutput, for its usage field
/// (decision 0426's addendum): a ProcOutput literal here then takes the
/// ProcUsage twin above, which the prelude's declaration would not
/// (XO0401, gotchas/new-prelude-struct-needs-native-twin.md); the
/// fields and their order match std/prelude.xo's.
struct ProcOutput {
  code: Int
  stdout: Bytes
  stderr: Bytes
  usage: ProcUsage = ProcUsage{user: 0s, system: 0s, max_rss: 0}
}

/// Proc.usage (decision 0426).
fn proc_usage(p: Proc) -> ProcUsage uses proc {
  proc_usage_of(procid.usage(false))
}

/// Proc.children_usage (decision 0426).
fn proc_children_usage(p: Proc) -> ProcUsage uses proc {
  proc_usage_of(procid.usage(true))
}

fn proc_usage_of(v: List[Int]) -> ProcUsage {
  ProcUsage{user: Duration.from_nanos(v[0]), system: Duration.from_nanos(v[1]), max_rss: v[2]}
}

/// Proc.ppid (decision 0410).
fn proc_ppid(p: Proc) -> Int uses proc { procid.ppid() }

/// Proc.request_stop (decision 0407): core 7.5's phase 1 once.
fn proc_request_stop(p: Proc) uses proc {
  if target.arch == TargetArch.Wasm32 {
    // the wasm runtime's stop state (compiler/wasm rt3.xo)
    rt.wasi_stop_request()
    return
  }
  if !stop.requested() {
    stop.signal()
  }
}

fn proc_kill(p: Proc, pid: Int, signal: Str = "TERM") -> () ! ProcErr uses proc {
  if !cap_admits(rt.proc_lists(p), "kill") {
    return Err(ProcErr.Denied("kill"))
  }
  let names = ["HUP", "INT", "QUIT", "KILL", "TERM", "USR1", "USR2", "CONT", "STOP"]
  var sig = -1
  for (i, n) in names.indexed() {
    if n == signal {
      sig = i
    }
  }
  if sig < 0 {
    return Err(ProcErr.Io("unknown signal ${signal.quote()}"))
  }
  if pid <= 0 {
    // 0 and negative pids name process groups: never sent
    return Err(ProcErr.Io("invalid process id ${pid}"))
  }
  match proc.kill(pid, sig).get(0) {
    Some(msg) => Err(ProcErr.Io(msg))
    None => Ok(())
  }
}

/// FakeProc.killed, as the SSA builder calls it (compiler/ssa testmode.xo):
/// the recorded signals, oldest first.
fn llrt_proc_killed() -> List[Str] { proc.killed() }

/// FakeProc.runs, as the SSA builder calls it.
fn llrt_proc_runs() -> List[Str] { testworld.proc_runs() }

fn proc_only(p: Proc, cmds: List[Str]) -> Proc { rt.proc_new(cap_lists_add(rt.proc_lists(p), cmds)) }

/// Whether the lists of an Env admit variable name: on Windows without
/// ASCII case, as its environment (and Go's os) compares names, so
/// `only(["PATH"])` admits the `Path` Windows sets and `get("path")`.
fn env_admits(lists: Str, name: Str) -> Bool {
  match target.os {
    TargetOs.Windows => cap_admits(lists.to_lower(), name.to_lower())
    _ => cap_admits(lists, name)
  }
}

fn env_only(e: Env, names: List[Str]) -> Env { rt.env_new(cap_lists_add(rt.env_lists(e), names)) }

/// The NetErr of the calling context's failed network operation
/// (netconn's tags, as generated code builds it for Net.dial).
fn net_err_now() -> NetErr {
  match netconn.status() {
    1 => NetErr.InvalidAddr(msg: netconn.last_msg())
    2 => NetErr.Refused
    3 => NetErr.Timeout
    5 => NetErr.Canceled
    6 => NetErr.Denied(addr: netconn.last_msg())
    _ => NetErr.Io(msg: netconn.last_msg())
  }
}

/// Net.dial_timeout (decision 0406): Net.dial with the caller's limit
/// over the lookup and the connect, Timeout when it passes.
fn net_dial_timeout(n: Net, addr: Str, d: Duration) -> Conn ! NetErr uses net.dial {
  if target.arch == TargetArch.Wasm32 {
    // a wasip2 command's wasi:sockets (decision 0447)
    let c = netwasi.dial_timeout(rt.net_lists(n), addr, d.nanos())
    if let Some(e) = netwasi.err_now() {
      return Err(e)
    }
    return Ok(c)
  }
  let p = netconn.dial_limit(rt.net_lists(n), addr, d.nanos())
  if p == 0 {
    return Err(net_err_now())
  }
  // dial's handle holds one reference, which the Conn takes over
  let c = rt.obj_at[Conn](p)
  tasks.h_release(p)
  Ok(c)
}

/// Conn.set_deadline and ServerConn's (decision 0430): t on clock, made
/// a wait from now on the runtime's timers.
fn conn_set_deadline(c: Conn, clock: Clock, t: Time?) uses clock { conn_deadline(rt.obj_addr(c), 3, clock, t) }
fn conn_set_read_deadline(c: Conn, clock: Clock, t: Time?) uses clock { conn_deadline(rt.obj_addr(c), 1, clock, t) }
fn conn_set_write_deadline(c: Conn, clock: Clock, t: Time?) uses clock { conn_deadline(rt.obj_addr(c), 2, clock, t) }
fn server_conn_set_deadline(c: ServerConn, clock: Clock, t: Time?) uses clock { conn_deadline(rt.obj_addr(c), 3, clock, t) }
fn server_conn_set_read_deadline(c: ServerConn, clock: Clock, t: Time?) uses clock { conn_deadline(rt.obj_addr(c), 1, clock, t) }
fn server_conn_set_write_deadline(c: ServerConn, clock: Clock, t: Time?) uses clock { conn_deadline(rt.obj_addr(c), 2, clock, t) }

fn conn_deadline(cn: Int, which: Int, clock: Clock, t: Time?) uses clock {
  if target.arch == TargetArch.Wasm32 {
    // a wasip2 command's wasi:sockets (decision 0447): cn is the handle's
    // address, held by the caller's value
    let c = rt.obj_at[Conn](cn)
    match t {
      Some(at) => netwasi.set_deadline(c, which, true, (at - clock.now()).nanos())
      None => netwasi.set_deadline(c, which, false, 0)
    }
    return
  }
  match t {
    Some(at) => netconn.set_deadline(cn, which, true, (at - clock.now()).nanos())
    None => netconn.set_deadline(cn, which, false, 0)
  }
}

/// Net.lookup_host (decision 0406): the addresses dial would try for
/// host, as text.
fn net_lookup_host(n: Net, host: Str) -> List[Str] ! NetErr uses net.dial {
  if target.arch == TargetArch.Wasm32 {
    let xs = netwasi.lookup_host(rt.net_lists(n), host)
    if let Some(e) = netwasi.err_now() {
      return Err(e)
    }
    return Ok(xs)
  }
  let addrs = netconn.lookup_host(rt.net_lists(n), host)
  if netconn.status() != 0 {
    return Err(net_err_now())
  }
  Ok(addrs)
}

/// The network's runtime calls in a wasm module (decision 0447): the SSA
/// builder calls these in place of rt.net_listen, rt.net_dial,
/// rt.listener_* and rt.conn_* (ssa/conc.xo sock_rt), on the same
/// arguments; std/native/llrt/netwasi.xo over wasi:sockets.
fn llrt_wasi_net_listen(lists: Str, addr: Str) -> Listener { netwasi.listen(lists, addr) }
fn llrt_wasi_net_dial(lists: Str, addr: Str) -> Conn { netwasi.dial(lists, addr) }
fn llrt_wasi_listener_addr(l: Listener) -> List[Str] { netwasi.listener_addr(l) }
fn llrt_wasi_listener_accept(l: Listener) -> ServerConn { netwasi.listener_accept(l) }
fn llrt_wasi_listener_close(l: Listener) { netwasi.listener_close(l) }
fn llrt_wasi_conn_read(c: Conn, max: Int) -> List[Str] { netwasi.conn_read(c, max) }
fn llrt_wasi_conn_write(c: Conn, data: Str) { netwasi.conn_write(c, data) }
fn llrt_wasi_conn_close(c: Conn) { netwasi.conn_close(c) }

/// The native backends' layout of the prelude's NetInterface and InterfaceFlags (decision 0426): a
/// prelude struct is opaque to the native SSA builder unless this module
/// declares its implementation, so the seed builds it without knowing it
/// (gotchas/new-prelude-struct-needs-native-twin.md); the fields match
/// std/prelude.xo's.
struct NetInterface {
  index: Int
  name: Str
  mtu: Int
  hardware_addr: Str
  flags: InterfaceFlags
  addrs: List[Str]
}

struct InterfaceFlags {
  up: Bool
  broadcast: Bool
  loopback: Bool
  point_to_point: Bool
  multicast: Bool
  running: Bool
}

/// Net.interfaces (decision 0426): an attenuated Net answers too (it names
/// no remote host); a test's FakeNet has one loopback interface.
fn net_interfaces(n: Net) -> List[NetInterface] ! NetErr uses net.listen {
  if twflags.fake(4) {
    return Ok([fake_loopback()])
  }
  let (xs, err) = ifaces.interfaces()
  if !err.is_empty() {
    return Err(NetErr.Io(msg: err))
  }
  // the prelude's NetInterface, copied into this module's twin
  var out: List[NetInterface] = []
  for x in xs {
    let f = x.flags
    out.push(NetInterface{index: x.index, name: x.name, mtu: x.mtu, hardware_addr: x.hardware_addr, flags: InterfaceFlags{up: f.up, broadcast: f.broadcast, loopback: f.loopback, point_to_point: f.point_to_point, multicast: f.multicast, running: f.running}, addrs: x.addrs})
  }
  Ok(out)
}

/// The loopback interface of a test's FakeNet (and the Go backend's).
fn fake_loopback() -> NetInterface {
  NetInterface{index: 1, name: "lo", mtu: 65536, hardware_addr: "", flags: InterfaceFlags{up: true, broadcast: false, loopback: true, point_to_point: false, multicast: true, running: true}, addrs: ["127.0.0.1/8", "::1/128"]}
}

/// Net.only (decision 0175): the entries trimmed and lowered (std/rt's
/// normHosts); the C runtime checks dial and listen against the lists
/// (net_admits_addr), std/native/http.xo each request and http1.xo a
/// client's redirects.
fn net_only(n: Net, hosts: List[Str]) -> Net {
  var norm: List[Str] = []
  for h in hosts {
    let t = h.trim()
    if t.len() >= 5 && t[0..5].to_lower() == "unix:" {
      // a socket path keeps its case (decision 0190)
      norm.push("unix:" + t[5..])
    } else {
      norm.push(t.to_lower())
    }
  }
  rt.net_new(cap_lists_add(rt.net_lists(n), norm))
}

fn env_get(e: Env, name: Str) -> Str? uses env {
  if !env_admits(rt.env_lists(e), name) {
    return None
  }
  rt.env_get(name).get(0)
}

fn env_vars(e: Env) -> Map[Str, Str] uses env {
  let lists = rt.env_lists(e)
  var m: Map[Str, Str] = {}
  for kv in rt.env_vars() {
    var k = kv
    var v = ""
    match kv.find("=") {
      Some(i) => {
        k = kv[0..i]
        v = kv[i + 1..]
      }
      None => ()
    }
    if env_admits(lists, k) {
      m.put(k, v)
    }
  }
  m
}

/// os.UserHomeDir: $HOME (on Windows %USERPROFILE% with / separators,
/// read when the Env admits HOME), or Missing("HOME").
fn env_home(e: Env) -> Str ! EnvErr uses env {
  if fs_windows() {
    if !env_admits(rt.env_lists(e), "HOME") {
      return Err(EnvErr.Missing(name: "HOME"))
    }
    match rt.env_get("USERPROFILE").get(0) {
      Some(h) => {
        if h != "" {
          return fs_slash(h)
        }
      }
      None => ()
    }
    return Err(EnvErr.Missing(name: "HOME"))
  }
  match env_get(e, "HOME") {
    Some(h) => {
      if h != "" {
        return h
      }
    }
    None => ()
  }
  Err(EnvErr.Missing(name: "HOME"))
}

// ---------------------------------------------------------------------------
// Commands, children, and pipelines (std.md 3.8, decisions 0161 and 0172):
// std/rt proccmd.go. A Cmd is a value that remembers the attenuation of
// the Proc that made it; a Child is a handle of the C runtime
// (std/llrt/xo_proc.c).

struct Cmd {
  lists: Str
  name: Str
  args: List[Str]
  dir: Str
  env: List[Str]
  env_set: Bool
  extra: List[Str]
  input: Bytes
  has_input: Bool
  inherit: Bool
  merge: Bool
}

struct Child {
  h: rt.ProcChild
}

fn proc_cmd(p: Proc, name: Str, args: List[Str] = []) -> Cmd {
  Cmd{lists: rt.proc_lists(p), name: name, args: args, dir: "", env: [], env_set: false, extra: [], input: b"", has_input: false, inherit: false, merge: false}
}

fn cmd_dir(c: Cmd, path: Str) -> Cmd {
  var x = c
  x.dir = path
  x
}

/// The child's environment is exactly the variables e shows now.
fn cmd_env(c: Cmd, e: Env) -> Cmd uses env {
  var x = c
  var env: List[Str] = []
  for (k, v) in e.vars().entries() {
    env.push(k + "=" + v)
  }
  x.env = env
  x.env_set = true
  x
}

fn cmd_set_env(c: Cmd, name: Str, value: Str) -> Cmd {
  var x = c
  x.extra.push(name + "=" + value)
  x
}

fn cmd_stdin(c: Cmd, data: Bytes) -> Cmd {
  var x = c
  x.input = data
  x.has_input = true
  x
}

fn cmd_inherit(c: Cmd) -> Cmd {
  var x = c
  x.inherit = true
  x
}

fn cmd_merge_stderr(c: Cmd) -> Cmd {
  var x = c
  x.merge = true
  x
}

/// The spec of c for the runtime (std/native/rt.xo proc_exec), appended
/// to out.
fn cmd_spec(c: Cmd, var out: List[Str]) {
  var flags = 0
  if c.env_set {
    flags = flags | 1
  }
  if c.inherit {
    flags = flags | 2
  }
  if c.merge {
    flags = flags | 4
  }
  // the environment and the Windows command line (decision 0193 step 6)
  procspec.spec(c.name, c.dir, flags, c.args, c.env, c.extra, out)
}

/// The ProcErr of a failed outcome (status st, detail d).
fn proc_err(st: Str, d: Str) -> ProcErr {
  match st {
    "1" => ProcErr.NotFound(d)
    "2" => ProcErr.Io(d)
    "4" => ProcErr.Timeout
    _ => ProcErr.Canceled
  }
}

fn proc_outcome(r: List[Str]) -> ProcOutput ! ProcErr {
  let st = r.get(0) ?? "2"
  let d = r.get(1) ?? ""
  if st != "0" {
    return Err(proc_err(st, d))
  }
  ProcOutput{code: text.parse_int(d) ?? 0, stdout: (r.get(2) ?? "").bytes(), stderr: (r.get(3) ?? "").bytes(), usage: child_usage(r, 4)}
}

/// proc.xo exec of the specs, or in the test world the outputs
/// FakeProc.on_run registered (std/native/llrt/testworld.xo): canceled,
/// no command, or std/rt's fakeProc output, runTerm, and pipeline.
fn proc_exec(spec: List[Str], input: Bytes, has_input: Bool, mode: Int) -> List[Str] {
  if !testworld.fake(testworld.REAL_PROC) {
    // std/native/llrt/proc.xo (work item B25)
    return proc.exec(spec, input, has_input, mode)
  }
  if rt.fs_canceled() {
    return ["3", ""]
  }
  if spec.is_empty() {
    return ["0", "0", "", ""]
  }
  testworld.proc_exec(spec, mode)
}

/// Denied or Canceled before c runs (std/rt Cmd.M_output).
fn cmd_check(c: Cmd) -> () ! ProcErr {
  if !cap_admits(c.lists, c.name) {
    return Err(ProcErr.Denied(c.name))
  }
  if rt.fs_canceled() {
    return Err(ProcErr.Canceled)
  }
}

fn cmd_output(c: Cmd) -> ProcOutput ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  proc_outcome(proc_exec(spec, c.input, c.has_input, 0))
}

fn cmd_run(c: Cmd) -> Int ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  let out = proc_outcome(proc_exec(spec, c.input, c.has_input, 1))?
  out.code
}

fn cmd_spawn(c: Cmd) -> Child ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  // std/native/llrt/proc.xo's children (work item B25)
  let h = proc.spawn(spec, c.input, c.has_input)
  let r = proc.child_start(h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Child{h: h}
}

fn proc_pipeline(p: Proc, cmds: List[Cmd]) -> ProcOutput ! ProcErr uses proc {
  let lists = rt.proc_lists(p)
  for c in cmds {
    if !cap_admits(lists, c.name) {
      return Err(ProcErr.Denied(c.name))
    }
  }
  if cmds.is_empty() {
    return ProcOutput{code: 0, stdout: b"", stderr: b""}
  }
  var spec: List[Str] = []
  for c in cmds {
    if !cap_admits(c.lists, c.name) {
      return Err(ProcErr.Denied(c.name))
    }
    cmd_spec(c, spec)
  }
  if rt.fs_canceled() {
    return Err(ProcErr.Canceled)
  }
  proc_outcome(proc_exec(spec, cmds[0].input, cmds[0].has_input, 2))
}

fn child_pid(c: Child) -> Int { proc.child_pid(c.h) }

fn child_write(c: Child, data: Bytes) -> () ! ProcErr uses proc {
  let r = proc.child_write(c.h, data)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
}

fn child_close_stdin(c: Child) { proc.child_close_stdin(c.h) }

fn child_read_from(c: Child, err: Bool, max: Int) -> Bytes? ! ProcErr {
  let r = proc.child_read(c.h, err, max)
  let st = r.get(0) ?? "2"
  if st == "e" {
    return None
  }
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Some((r.get(1) ?? "").bytes())
}

fn child_read(c: Child, max: Int) -> Bytes? ! ProcErr uses proc { child_read_from(c, false, max) }

fn child_read_err(c: Child, max: Int) -> Bytes? ! ProcErr uses proc { child_read_from(c, true, max) }

fn child_read_line(c: Child) -> Str? ! ProcErr uses proc {
  let r = proc.child_read_line(c.h)
  let st = r.get(0) ?? "2"
  if st == "e" {
    return None
  }
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Some(scan.text(r.get(1) ?? ""))
}

fn child_set_read_deadline(c: Child, clock: Clock, t: Time?) uses clock {
  match t {
    Some(at) => proc.child_set_read_deadline(c.h, true, (at - clock.now()).nanos())
    None => proc.child_set_read_deadline(c.h, false, 0)
  }
}

fn child_wait(c: Child) -> Int ! ProcErr uses proc {
  let r = proc.child_wait(c.h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  text.parse_int(r.get(1) ?? "0") ?? 0
}

fn child_wait_usage(c: Child) -> (Int, ProcUsage) ! ProcErr uses proc {
  let r = proc.child_wait(c.h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  (text.parse_int(r.get(1) ?? "0") ?? 0, child_usage(r, 2))
}

fn child_kill(c: Child) { proc.child_kill(c.h) }

fn stdio_read_line(_s: Stdio) -> Str? ! IoErr {
  let (line, st, msg) = stdinrt.read(false)
  if st == 0 {
    return Some(scan.text(line))
  }
  if st == 1 {
    return None
  }
  Err(stdin_err(st, msg))
}

fn stdio_read_all(_s: Stdio) -> Str ! IoErr {
  let (text, st, msg) = stdinrt.read(true)
  if st == 0 {
    return scan.text(text)
  }
  Err(stdin_err(st, msg))
}

fn stdio_lines(s: Stdio) -> List[Str] ! IoErr {
  let text = stdio_read_all(s)?
  text.lines()
}

// User directories (std.md 3.5, decision 0163): std/rt's userDir, read
// through the Env.

fn env_user_dir(e: Env, cache: Bool) -> Str ! EnvErr uses env {
  var xdg = "XDG_CONFIG_HOME"
  var mac = "/Library/Application Support"
  var unix = "/.config"
  if cache {
    xdg = "XDG_CACHE_HOME"
    mac = "/Library/Caches"
    unix = "/.cache"
  }
  match e.get(xdg) {
    Some(v) => {
      if v.starts_with("/") || (v.len() >= 3 && v[1..2] == ":") {
        return fs_slash(v)
      }
    }
    None => ()
  }
  if fs_windows() {
    // %AppData% and %LocalAppData% (std/rt userDir)
    let win = if cache { "LocalAppData" } else { "AppData" }
    let v = e.get(win) ?? ""
    if v == "" {
      return Err(EnvErr.Missing(name: win))
    }
    return v.replace("\\", "/")
  }
  let home = match e.get("HOME") {
    Some(h) => h
    None => ""
  }
  if home == "" {
    return Err(EnvErr.Missing(name: "HOME"))
  }
  let base = home.trim_suffix("/")
  match target.os {
    TargetOs.Darwin => base + mac
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi | TargetOs.FreeBSD => base + unix
  }
}

fn env_config_dir(e: Env) -> Str ! EnvErr uses env { env_user_dir(e, false) }

/// Env.hostname (decision 0410): std/native/llrt/host.xo.
fn env_hostname(e: Env) -> Str uses env { host.hostname() }

fn env_cache_dir(e: Env) -> Str ! EnvErr uses env { env_user_dir(e, true) }

/// Env.local_app_data (decision 0584): SHGetKnownFolderPath on Windows
/// (std/native/llrt/host.xo), a test's FakeEnv LOCALAPPDATA; not narrowed
/// by only.
fn env_local_app_data(_e: Env) -> Str ! EnvErr uses env {
  let v = if process.env_faked() { process.env_get("LOCALAPPDATA").get(0) ?? "" } else { host.local_app_data() }
  if v == "" {
    return Err(EnvErr.Missing(name: "LocalAppData"))
  }
  v.replace("\\", "/")
}

// Terminals (std.md 3.6, decision 0162): std/rt's term.go.

fn stdio_stdin_is_tty(_s: Stdio) -> Bool { stdinrt.isatty(0) }

/// Raw input on standard input's terminal (on true) or its settings back
/// (decision 0581).
fn stdio_raw_input(_s: Stdio, on: Bool) -> Bool { stdinrt.raw(!on) }

fn stdio_stdout_is_tty(_s: Stdio) -> Bool { stdinrt.isatty(1) }

fn stdio_stderr_is_tty(_s: Stdio) -> Bool { stdinrt.isatty(2) }

fn stdio_width(_s: Stdio) -> Int? {
  let w = stdinrt.term_width()
  if w > 0 {
    return Some(w)
  }
  None
}

/// The prompt on standard error, then a line read with the terminal's
/// echo off; the newline the user typed was not echoed, so one is written.
fn stdio_read_secret(s: Stdio, prompt: Str) -> Str? ! IoErr {
  s.eprint(prompt)
  let off = stdinrt.echo(false)
  defer {
    if off {
      stdinrt.echo(true)
      s.eprint("\n")
    }
  }
  stdio_read_line(s)
}

fn stdio_read_bytes(_s: Stdio, max: Int) -> Bytes? ! IoErr {
  if max <= 0 {
    return Some(b"")
  }
  let (data, st, msg) = stdinrt.read_bytes(max.min(1048576))
  if st == 0 {
    return Some(data)
  }
  if st == 1 {
    return None
  }
  Err(stdin_err(st, msg))
}

fn stdio_read_all_bytes(s: Stdio) -> Bytes ! IoErr {
  let text = stdio_read_all(s)?
  text.bytes()
}

/// math.Round(s * 1e9) nanoseconds (std/rt's Duration_from_secs).
fn duration_from_secs(s: Float) -> Duration { Duration.from_nanos(Int((s * 1000000000.0).round())) }

/// math.Round(d * f) nanoseconds.
fn duration_scale(d: Duration, f: Float) -> Duration { Duration.from_nanos(Int((Float(d.nanos()) * f).round())) }

/// Go's Duration.Round (time.go): halfway away from zero, saturating at
/// the ends of Duration's range.
fn duration_round(d: Duration, m: Duration) -> Duration {
  let n = d.nanos()
  let mn = m.nanos()
  if mn <= 0 {
    return d
  }
  // r is in [0, mn): r < mn - r is Go's lessThanHalf without its
  // unsigned overflow
  if n < 0 {
    let r = -(n % mn)
    if r < mn - r {
      return Duration.from_nanos(n + r)
    }
    if n >= Int.min + (mn - r) {
      return Duration.from_nanos(n - (mn - r))
    }
    return Duration.from_nanos(Int.min)
  }
  let r = n % mn
  if r < mn - r {
    return Duration.from_nanos(n - r)
  }
  if n <= Int.max - (mn - r) {
    return Duration.from_nanos(n + (mn - r))
  }
  Duration.from_nanos(Int.max)
}

/// Go's Duration.Truncate.
fn duration_truncate(d: Duration, m: Duration) -> Duration {
  let mn = m.nanos()
  if mn <= 0 {
    return d
  }
  let n = d.nanos()
  Duration.from_nanos(n - n % mn)
}

fn duration_ceil_seconds(d: Duration) -> Int {
  let n = d.nanos()
  if n % 1000000000 > 0 {
    return n / 1000000000 + 1
  }
  n / 1000000000
}

// ---------------------------------------------------------------------------
// Time (std.md 2.6)

/// RFC 3339 as the JSON decoder reads it (text.xo parse_time): two and four
/// digit fields, T and Z upper case, a '.' fraction of one or more digits,
/// a Z or +-HH:MM offset (hours to 23, minutes to 59). The Go backend checks
/// the same shape before time.Parse (std/rt time.go parseRFC3339); Go's
/// parser alone also takes a one digit hour, a comma fraction and offsets
/// to +24:60. None for a time outside the range of Time (decision 0364).
fn time_parse_rfc3339(s: Str) -> Time? {
  match text.parse_time(s) {
    Some(ns) => Some(Time.UNIX_EPOCH + Duration.from_nanos(ns))
    None => None
  }
}

/// The offset of the RFC 3339 text s (parse_time accepted it), as a Duration.
fn time_rfc3339_offset(s: Str) -> Duration? {
  match text.parse_time(s) {
    None => return None
    Some(_) => {}
  }
  let b = s.bytes()
  let n = b.len()
  if b[n - 1] == 90 {
    return Some(Duration.from_nanos(0))
  }
  let hh = Int(b[n - 5] - 48) * 10 + Int(b[n - 4] - 48)
  let mm = Int(b[n - 2] - 48) * 10 + Int(b[n - 1] - 48)
  let secs = hh * 3600 + mm * 60
  Some(Duration.from_nanos((if b[n - 6] == 45 { 0 - secs } else { secs }) * 1000000000))
}

/// RFC 3339 in UTC: the Display text of a Time.
fn time_format_rfc3339(t: Time) -> Str { "${t}" }

// ---------------------------------------------------------------------------
// The runtime's text, as the SSA builder calls it (decision 0193):
// Display and Debug of Duration, Time, Str, and Bytes, and std/json's
// Duration and Time, in Xo (std/native/llrt/text.xo; decision 0227
// deleted the C path).

fn llrt_append_duration(s: Str, d: Int) -> Str { text.append_duration(s, d) }

fn llrt_append_time(s: Str, t: Int) -> Str { text.append_time(s, t) }

fn llrt_json_reserve_list(s: Str, start: Int, n: Int) -> Str { jsontext.reserve_list(s, start, n) }

fn llrt_append_quote(s: Str, t: Str) -> Str { text.append_quote(s, t.bytes()) }

fn llrt_append_bytes_quote(s: Str, b: Bytes) -> Str { text.append_quote(s, b) }

/// A Duration's text parsed once, for the JSON decoder (compiler/ssa
/// json.xo dec_opt).
fn llrt_duration_opt(s: Str) -> Int? { text.parse_duration(s) }

// Clock.now and Clock.since, as the SSA builders call them (decision
// 0206): a system call from Xo on Linux (std/native/llrt/sysio.xo), the
// C runtime elsewhere.

fn llrt_clock_now() -> Int { sysio.clock_now() }

// The number text, as the SSA builder calls it for every interpolation
// and Display of an Int or Float (decision 0193 step 3): in Xo
// (std/native/llrt/num.xo). Decision 0198 deleted its C path
// (XO_LLRT_C=num, the C runtime's str.concat_int and friends).

fn llrt_concat_int(s: Str, v: Int) -> Str { num.append_int(s, v) }

fn llrt_concat_float(s: Str, f: Float) -> Str { num.append_float(s, f) }

// The leaf text of Display and Debug (decision 0193 step 5): a Rune's
// Display and Debug, a UInt64's text. In Xo (std/native/llrt/show.xo;
// decision 0198 deleted the C path).

