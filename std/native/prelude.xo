// The prelude methods the native backends implement in Xo (decision
// 0074). internal/ssa lowers a prelude method `T.name` that it has no
// lowering of its own for to the function `T_name` here, whose first
// parameter is the receiver and whose type parameters are those of the
// declaration in std/prelude.xo, in order. Semantics are std/rt's.
use native/llrt/atomic
use native/llrt/cabi
use native/llrt/fspath
use native/llrt/gen
use native/llrt/ints
use native/llrt/jsontext
use native/llrt/procspec
use native/llrt/num
use native/llrt/report
use native/llrt/scan
use native/llrt/show
use native/llrt/strings
use native/llrt/text
use native/llrt/unicode
use native/rt

// ---------------------------------------------------------------------------
// Str (std.md 2.2)

fn str_rune_count(s: Str) -> Int { scan.rune_count(s) }

fn str_contains(s: Str, sub: Str) -> Bool { scan.contains(s, sub) }

fn str_starts_with(s: Str, p: Str) -> Bool { scan.starts_with(s, p) }

fn str_ends_with(s: Str, p: Str) -> Bool { scan.ends_with(s, p) }

fn str_find(s: Str, sub: Str) -> Int? {
  let i = scan.find(s, sub, 0)
  if i < 0 {
    return None
  }
  Some(i)
}

fn str_split(s: Str, sep: Str) -> List[Str] { scan.split(s, sep) }

fn str_lines(s: Str) -> List[Str] { scan.lines(s) }

fn str_trim(s: Str) -> Str { strings.trim(s, 0) }

fn str_trim_start(s: Str) -> Str { strings.trim(s, 1) }

fn str_trim_end(s: Str) -> Str { strings.trim(s, 2) }

fn str_trim_prefix(s: Str, p: Str) -> Str {
  if scan.starts_with(s, p) {
    return rt.str_slice(s, p.len(), s.len())
  }
  s
}

fn str_trim_suffix(s: Str, p: Str) -> Str {
  if scan.ends_with(s, p) {
    return rt.str_slice(s, 0, s.len() - p.len())
  }
  s
}

fn str_to_lower(s: Str) -> Str { unicode.map_case(s, true) }

fn str_to_upper(s: Str) -> Str { unicode.map_case(s, false) }

/// `a.to_lower() == b.to_lower()` (internal/ssa lowers that comparison to
/// a call of this).
fn str_eq_lower(a: Str, b: Str) -> Bool { unicode.eq_lower(a, b) }

fn str_replace(s: Str, old: Str, new: Str) -> Str { strings.replace(s, old, new) }

fn str_repeat(s: Str, n: Int) -> Str { rt.str_repeat(s, n) }

fn list_join(xs: List[Str], sep: Str) -> Str { rt.str_join(xs, sep) }

fn str_quote(s: Str) -> Str { unicode.quote(s.bytes()) }

// ---------------------------------------------------------------------------
// Rune and Bytes (std.md 2.2, decisions 0079 and 0081)

fn rune_is_letter(r: Rune) -> Bool { unicode.is_letter(Int(r)) }

fn rune_is_digit(r: Rune) -> Bool { unicode.is_digit(Int(r)) }

fn rune_is_space(r: Rune) -> Bool { unicode.is_space(Int(r)) }

fn rune_is_print(r: Rune) -> Bool { unicode.is_print(Int(r)) }

fn rune_to_lower(r: Rune) -> Rune { rune_case(r, true) }

fn rune_to_upper(r: Rune) -> Rune { rune_case(r, false) }

/// unicode.ToLower (lower) or unicode.ToUpper: an unchanged or ASCII
/// result needs no checked conversion.
fn rune_case(r: Rune, lower: Bool) -> Rune {
  let x = Int(r)
  let y = unicode.to_case(x, lower)
  if y == x {
    return r
  }
  if y < 0x80 {
    return Rune(unicode.byte(y))
  }
  Rune(y)
}

fn rune_quote(r: Rune) -> Str { unicode.quote_rune(Int(r)) }

fn rune_try(x: Int) -> Rune? {
  if x < 0 || x > 0x10ffff || (x >= 0xd800 && x <= 0xdfff) {
    return None
  }
  Some(Rune(x))
}

fn bytes_quote(b: Bytes) -> Str { unicode.quote(b) }

fn bytes_rune_count(b: Bytes) -> Int { scan.bytes_rune_count(b) }

fn bytes_to_hex(b: Bytes) -> Str { scan.to_hex(b) }

/// Whether b is UTF-8 (Bytes.to_str: internal/ssa calls this instead of
/// rt.utf8_valid, decision 0201).
fn llrt_utf8_valid(b: Bytes) -> Bool { scan.utf8_valid(b) }

fn bytes_from_hex(s: Str) -> Bytes? { num.from_hex(s) }

fn bytes_to_base64(b: Bytes) -> Str { num.to_base64(b) }

fn bytes_from_base64(s: Str) -> Bytes? { num.from_base64(s) }

/// []rune(s): an invalid byte is U+FFFD.
fn str_runes(s: Str) -> List[Rune] {
  let b = s.bytes()
  var out: List[Rune] = []
  var i = 0
  while i < b.len() {
    let p = rt.bytes_decode(b, i)
    out.push(Rune(p >> 3))
    i += p & 7
  }
  out
}

fn bytes_decode_rune(b: Bytes, i: Int, at: rt.Loc) -> (Rune, Int) {
  if i < 0 || i > b.len() {
    rt.fault_at("index ${i} out of range for decode_rune on Bytes of length ${b.len()}", at)
  }
  let p = rt.bytes_decode(b, i)
  (Rune(p >> 3), p & 7)
}

fn int_pow(n: Int, e: Int, at: rt.Loc) -> Int {
  if e < 0 {
    rt.fault_at("negative exponent ${e} in pow", at)
  }
  var r = 1
  var i = 0
  while i < e {
    if !ints.fits(2, r, n) {
      rt.fault_at("integer overflow: ${r} * ${n} does not fit Int", at)
    }
    r = r * n
    i += 1
  }
  r
}

fn int_wrapping_add(n: Int, m: Int) -> Int { rt.int_wrap(0, n, m) }

fn int_wrapping_sub(n: Int, m: Int) -> Int { rt.int_wrap(1, n, m) }

fn int_wrapping_mul(n: Int, m: Int) -> Int { rt.int_wrap(2, n, m) }

fn checked(op: Int, n: Int, m: Int) -> Int? {
  if !ints.fits(op, n, m) {
    return None
  }
  Some(ints.apply(op, n, m))
}

fn int_checked_add(n: Int, m: Int) -> Int? { checked(0, n, m) }

fn int_checked_sub(n: Int, m: Int) -> Int? { checked(1, n, m) }

fn int_checked_mul(n: Int, m: Int) -> Int? { checked(2, n, m) }

fn int_checked_div(n: Int, m: Int) -> Int? { checked(3, n, m) }

/// The bound an overflowing a op b saturates to.
fn saturated(op: Int, n: Int, m: Int) -> Int {
  let max = 9223372036854775807
  let min = -9223372036854775807 - 1
  if ints.fits(op, n, m) {
    return ints.apply(op, n, m)
  }
  if op == 0 {
    return if m > 0 { max } else { min }
  }
  if op == 1 {
    return if m > 0 { min } else { max }
  }
  if (n < 0) != (m < 0) { min } else { max }
}

fn int_saturating_add(n: Int, m: Int) -> Int { saturated(0, n, m) }

fn int_saturating_sub(n: Int, m: Int) -> Int { saturated(1, n, m) }

fn int_saturating_mul(n: Int, m: Int) -> Int { saturated(2, n, m) }

fn int_parse(s: Str) -> Int? { text.parse_int(s) }

fn float_parse(s: Str) -> Float? { num.parse_float(s) }

// ---------------------------------------------------------------------------
// Map[K, V] and Set[T] (std.md 2.4): std/rt map.go's order, the entries
// in insertion order

fn map_filter[K, V, E, fx: Effects](m: Map[K, V], f: fn(K, V) -> Bool ! E uses fx) -> Map[K, V] ! E uses fx {
  var out: Map[K, V] = {}
  for (k, v) in m {
    if f(k, v)? {
      out[k] = v
    }
  }
  out
}

fn set_union[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r = s
  for x in o {
    r.add(x)
  }
  r
}

fn set_intersect[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r: Set[T] = #{}
  for x in s {
    if o.contains(x) {
      r.add(x)
    }
  }
  r
}

fn set_difference[T](s: Set[T], o: Set[T]) -> Set[T] {
  var r: Set[T] = #{}
  for x in s {
    if !o.contains(x) {
      r.add(x)
    }
  }
  r
}

// ---------------------------------------------------------------------------
// List[T] (std.md 2.3)

fn list_insert[T](var xs: List[T], i: Int, x: T, at: rt.Loc) {
  let n = xs.len()
  if i < 0 || i > n {
    rt.fault_at("index ${i} out of range for insert into List of length ${n}", at)
  }
  xs.push(x)
  var j = n
  while j > i {
    xs[j] = xs[j - 1]
    j -= 1
  }
  xs[i] = x
}

fn list_remove_at[T](var xs: List[T], i: Int, at: rt.Loc) -> T {
  let n = xs.len()
  if i < 0 || i >= n {
    rt.fault_at("index ${i} out of range for List of length ${n}", at)
  }
  let x = xs[i]
  var j = i
  while j + 1 < n {
    xs[j] = xs[j + 1]
    j += 1
  }
  match xs.pop() {
    _ => {}
  }
  x
}

/// The Ints from lo up to hi, hi excluded (`Range.to_list`).
fn int_range_list(lo: Int, hi: Int) -> List[Int] {
  var out: List[Int] = []
  var i = lo
  while i < hi {
    out.push(i)
    i += 1
  }
  out
}

fn list_indexed[T](xs: List[T]) -> List[(Int, T)] {
  var out: List[(Int, T)] = []
  var i = 0
  for x in xs {
    out.push((i, x))
    i += 1
  }
  out
}

fn list_contains[T](xs: List[T], x: T) -> Bool {
  for y in xs {
    if y == x {
      return true
    }
  }
  false
}

fn list_index_of[T](xs: List[T], x: T) -> Int? {
  for (i, y) in xs.indexed() {
    if y == x {
      return Some(i)
    }
  }
  None
}

fn list_map[T, U, E, fx: Effects](xs: List[T], f: fn(T) -> U ! E uses fx) -> List[U] ! E uses fx {
  var out: List[U] = []
  for x in xs {
    out.push(f(x)?)
  }
  out
}

fn list_filter[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> List[T] ! E uses fx {
  var out: List[T] = []
  for x in xs {
    if f(x)? {
      out.push(x)
    }
  }
  out
}

fn list_fold[T, A, E, fx: Effects](xs: List[T], init: A, f: fn(A, T) -> A ! E uses fx) -> A ! E uses fx {
  var acc = init
  for x in xs {
    acc = f(acc, x)?
  }
  acc
}

fn list_find[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> T? ! E uses fx {
  for x in xs {
    if f(x)? {
      return Some(x)
    }
  }
  None
}

fn list_any[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in xs {
    if f(x)? {
      return true
    }
  }
  false
}

fn list_all[T, E, fx: Effects](xs: List[T], f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx {
  for x in xs {
    if !f(x)? {
      return false
    }
  }
  true
}

fn list_reverse[T](xs: List[T]) -> List[T] {
  var out: List[T] = []
  var i = xs.len() - 1
  while i >= 0 {
    out.push(xs[i])
    i -= 1
  }
  out
}

/// A stable merge sort of xs by keys (std/rt sorts stably).
fn list_sort_by[T, K: Ord, E, fx: Effects](xs: List[T], key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx {
  var keys: List[K] = []
  for x in xs {
    keys.push(key(x)?)
  }
  var idx: List[Int] = []
  for i in 0..xs.len() {
    idx.push(i)
  }
  let sorted = merge_sort(idx, fn(a, b) { keys[a] < keys[b] })
  var out: List[T] = []
  for i in sorted {
    out.push(xs[i])
  }
  out
}

fn list_sort[T: Ord](xs: List[T]) -> List[T] { merge_sort(xs, fn(a, b) { a < b }) }

/// A stable bottom up merge sort: less(a, b) when a sorts before b.
fn merge_sort[T](xs: List[T], less: fn(T, T) -> Bool) -> List[T] {
  let n = xs.len()
  if n < 2 {
    return xs
  }
  var src = xs
  var width = 1
  while width < n {
    var dst: List[T] = []
    var lo = 0
    while lo < n {
      var mid = lo + width
      if mid > n {
        mid = n
      }
      var hi = mid + width
      if hi > n {
        hi = n
      }
      var i = lo
      var j = mid
      while i < mid && j < hi {
        if less(src[j], src[i]) {
          dst.push(src[j])
          j += 1
        } else {
          dst.push(src[i])
          i += 1
        }
      }
      while i < mid {
        dst.push(src[i])
        i += 1
      }
      while j < hi {
        dst.push(src[j])
        j += 1
      }
      lo = hi
    }
    src = dst
    width *= 2
  }
  src
}

fn list_to_set[T](xs: List[T]) -> Set[T] {
  var s: Set[T] = #{}
  for x in xs {
    s.add(x)
  }
  s
}

// ---------------------------------------------------------------------------
// Option[T] and Result[T, E] (std.md 2.5)

fn option_or_err[T, E](o: T?, e: E) -> Result[T, E] {
  match o {
    Some(v) => Ok(v)
    None => Err(e)
  }
}

fn option_map[T, U, fx: Effects](o: T?, f: fn(T) -> U uses fx) -> U? uses fx {
  match o {
    Some(v) => Some(f(v))
    None => None
  }
}

fn option_and_then[T, U, fx: Effects](o: T?, f: fn(T) -> U? uses fx) -> U? uses fx {
  match o {
    Some(v) => f(v)
    None => None
  }
}

fn result_map[T, E, U, fx: Effects](r: Result[T, E], f: fn(T) -> U uses fx) -> Result[U, E] uses fx {
  match r {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}

fn result_map_err[T, E, F, fx: Effects](r: Result[T, E], f: fn(E) -> F uses fx) -> Result[T, F] uses fx {
  match r {
    Ok(v) => Ok(v)
    Err(e) => Err(f(e))
  }
}

fn result_ignore_err[T, E](r: Result[T, E], reason: Str) -> T? {
  match r {
    Ok(v) => Some(v)
    Err(_) => None
  }
}

// ---------------------------------------------------------------------------
// Duration (std.md 2.6)

fn duration_parse(s: Str) -> Duration ! DurationErr {
  match text.parse_duration(s) {
    Some(d) => Ok(Duration.from_nanos(d))
    None => Err(DurationErr{input: s})
  }
}

fn durationerr_display(e: DurationErr) -> Str {
  "invalid duration ${unicode.quote(e.input.bytes())}: expected numbers with units ns, us, ms, s, m, h, such as \"1.5s\" or \"1h30m\""
}

// ---------------------------------------------------------------------------
// Fs (std.md 3.1, decision 0102): std/rt caps.go's realFs, over the system
// calls of std/llrt/xo_fs.c. An Fs is its root and mode bits (1 a sub
// capability, 2 read only, 4 write only).

fn fs_err(st: Int, p: Str) -> FsErr {
  match st {
    1 => FsErr.NotFound(path: p)
    2 => FsErr.Exists(path: p)
    3 => FsErr.NotEmpty(path: p)
    4 => FsErr.NotDir(path: p)
    5 => FsErr.IsDir(path: p)
    6 => FsErr.Denied(path: p)
    7 => FsErr.Io(path: p, msg: rt.fs_msg()[1])
    _ => FsErr.Canceled
  }
}

// fs_windows is whether paths follow Windows' rules (std.md 3.1): the
// build's target, resolved at compile time.
fn fs_windows() -> Bool {
  match target.os {
    TargetOs.Windows => true
    TargetOs.Darwin | TargetOs.Linux | TargetOs.Wasi => false
  }
}

// fs_slash is p with \ as / on Windows (filepath.ToSlash), p elsewhere.
fn fs_slash(p: Str) -> Str {
  if fs_windows() {
    return p.replace("\\", "/")
  }
  p
}

// fs_volume is the volume of a slash separated Windows path
// (filepath.VolumeName): "C:" of "C:/x" or "C:x", "//host/share" of a
// UNC path; "" for others and on every other OS.
fn fs_volume(p: Str) -> Str {
  if !fs_windows() {
    return ""
  }
  let b = p.bytes()
  if b.len() >= 2 && b[1] == ':' && ((b[0] >= 'a' && b[0] <= 'z') || (b[0] >= 'A' && b[0] <= 'Z')) {
    return p[0..2]
  }
  if p.starts_with("//") && !p.starts_with("///") {
    let parts = p[2..].split("/")
    if parts.len() >= 2 && parts[0] != "" && parts[1] != "" {
      return "//${parts[0]}/${parts[1]}"
    }
  }
  ""
}

// fs_is_abs is filepath.IsAbs of a slash separated path: rooted at / on
// Unix; on Windows a drive with a root (C:/x) or a UNC path.
fn fs_is_abs(p: Str) -> Bool {
  if !fs_windows() {
    return p.starts_with("/")
  }
  let q = fs_slash(p)
  let v = fs_volume(q)
  if v == "" {
    return false
  }
  v.starts_with("//") || q[v.len()..].starts_with("/")
}

// fs_clean is Go's path.Clean; on Windows (filepath.Clean with /) \ is
// a separator too and a volume stays in front.
fn fs_clean(p: Str) -> Str {
  if p == "" {
    return "."
  }
  if fs_windows() {
    let q = fs_slash(p)
    let v = fs_volume(q)
    if v != "" {
      let rest = q[v.len()..]
      if rest == "" {
        return if v.starts_with("//") { v + "/" } else { v + "." }
      }
      let c = fs_clean_slash(rest)
      return v + c
    }
    return fs_clean_slash(q)
  }
  fs_clean_slash(p)
}

// fs_clean_slash is Go's path.Clean of a slash separated path.
fn fs_clean_slash(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let rooted = p.starts_with("/")
  var parts: List[Str] = []
  for seg in p.split("/") {
    if seg == "" || seg == "." {
      continue
    }
    if seg == ".." {
      if parts.len() > 0 && parts[parts.len() - 1] != ".." {
        match parts.pop() {
          _ => {}
        }
      } else if !rooted {
        parts.push("..")
      }
      continue
    }
    parts.push(seg)
  }
  let body = parts.join("/")
  if rooted {
    return "/" + body
  }
  if body == "" {
    return "."
  }
  body
}

// fs_join is Go's path.Join (filepath.Join on Unix) of two elements.
fn fs_join(a: Str, b: Str) -> Str {
  if a == "" && b == "" {
    return ""
  }
  if a == "" {
    return fs_clean(b)
  }
  if b == "" {
    return fs_clean(a)
  }
  fs_clean(a + "/" + b)
}

// fs_base is Go's path.Base (of the slash form on Windows).
fn fs_base(p: Str) -> Str {
  if p == "" {
    return "."
  }
  var s = fs_slash(p)
  while s.len() > 1 && s.ends_with("/") {
    s = s[0..s.len() - 1]
  }
  if s == "/" {
    return "/"
  }
  let parts = s.split("/")
  parts[parts.len() - 1]
}

// fs_abs is filepath.Abs (with / on Windows: a path rooted at / is on
// the working directory's drive).
fn fs_abs(p: Str) -> Str {
  if fs_is_abs(p) {
    return fs_clean(p)
  }
  if fs_windows() && fs_slash(p).starts_with("/") {
    return fs_clean(fs_volume(fspath.cwd()) + fs_slash(p))
  }
  fs_join(fspath.cwd(), p)
}

// fs_resolve maps an Xo path to an OS path: os.fs takes it as it is, a
// sub capability resolves it against its root and denies (None) a path
// that escapes it.
fn fs_resolve(f: Fs, p: Str) -> Str? {
  if (rt.fs_mode(f) & 1) == 0 {
    if p == "" {
      return Some(".")
    }
    return Some(p)
  }
  let clean = fs_clean("/" + p.replace("\\", "/"))
  if p.contains("..") {
    var depth = 0
    for seg in p.split("/") {
      if seg == ".." {
        depth -= 1
      } else if seg != "" && seg != "." {
        depth += 1
      }
      if depth < 0 {
        return None
      }
    }
  }
  Some(fs_join(rt.fs_root(f), clean))
}

// fs_rel is the path of the OS path op relative to the root (op itself
// for os.fs).
fn fs_rel(f: Fs, op: Str, given: Str) -> Str {
  if (rt.fs_mode(f) & 1) == 0 {
    return fs_slash(op)
  }
  let root = fs_clean(rt.fs_root(f))
  let c = fs_clean(op)
  if c == root {
    return ""
  }
  if root == "/" {
    return c[1..]
  }
  if root.ends_with("/") && c.starts_with(root) {
    return c[root.len()..] // a Windows drive's root, C:/
  }
  if c.starts_with(root + "/") {
    return c[root.len() + 1..]
  }
  given
}

fn fs_check(f: Fs, p: Str, write: Bool) -> Str ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let mode = rt.fs_mode(f)
  if (write && (mode & 2) != 0) || (!write && (mode & 4) != 0) {
    return Err(FsErr.Denied(path: p))
  }
  match fs_resolve(f, p) {
    Some(op) => op
    None => Err(FsErr.Denied(path: p))
  }
}

// fs_info_of is the FileInfo of the last fs_stat, of OS path op.
fn fs_info_of(f: Fs, op: Str, given: Str) -> FileInfo {
  FileInfo{name: fs_base(op), path: fs_rel(f, op, given), is_dir: rt.fs_info(0) == 1, size: rt.fs_info(1), modified: rt.time_of(rt.fs_info(2))}
}

fn fs_sub(f: Fs, dir: Str) -> Fs {
  match fs_resolve(f, dir) {
    Some(op) => rt.fs_new(fs_abs(op), 1 | (rt.fs_mode(f) & 6))
    None => rt.fs_new(fs_join(rt.fs_root(f), "denied"), 7)
  }
}

fn fs_cwd(f: Fs) -> Fs { rt.fs_new(fspath.cwd(), 1 | (rt.fs_mode(f) & 6)) }

fn fs_read_only(f: Fs) -> Fs { rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 2) }

fn fs_write_only(f: Fs) -> Fs { rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 4) }

fn fs_case_sensitive(_f: Fs) -> Bool { rt.fs_case_sensitive() }

fn fs_stat(f: Fs, p: Str) -> FileInfo? ! FsErr {
  let op = fs_check(f, p, false)?
  let st = rt.fs_stat(op, true, p)
  if st == 1 {
    return None
  }
  if st != 0 {
    return Err(fs_err(st, p))
  }
  Some(fs_info_of(f, op, p))
}

fn fs_exists(f: Fs, p: Str) -> Bool ! FsErr {
  let fi = fs_stat(f, p)?
  fi.is_some()
}

fn fs_read(f: Fs, p: Str) -> Bytes ! FsErr {
  let op = fs_check(f, p, false)?
  let l = rt.fs_read(op)
  if l.len() == 0 {
    return Err(fs_err(rt.fs_status(), p))
  }
  l[0]
}

fn fs_read_text(f: Fs, p: Str) -> Str ! FsErr {
  let b = fs_read(f, p)?
  rt.cast[Bytes, Str](b)
}

fn fs_read_dir(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  let op = fs_check(f, dir, false)?
  let names = rt.fs_names(op, dir)
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out: List[FileInfo] = []
  for n in names {
    let child = fs_join(op, n)
    if rt.fs_stat(child, false, n) == 0 {
      out.push(fs_info_of(f, child, fs_join(dir, n)))
    }
  }
  out.sort_by(fn(fi) { fi.name })
}

fn fs_walk_dir(f: Fs, osdir: Str, xodir: Str, var out: List[FileInfo]) -> () ! FsErr {
  let names = rt.fs_names(osdir, xodir)
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, xodir))
  }
  for n in names.sort() {
    let child = fs_join(osdir, n)
    let xc = fs_join(xodir, n)
    if rt.fs_stat(child, false, xc) == 0 {
      let fi = fs_info_of(f, child, xc)
      out.push(fi)
      if fi.is_dir {
        fs_walk_dir(f, child, xc, out)?
      }
    }
  }
}

fn fs_walk(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  let op = fs_check(f, dir, false)?
  let st = rt.fs_stat(op, true, dir)
  if st != 0 {
    return Err(fs_err(st, dir))
  }
  var out: List[FileInfo] = []
  fs_walk_dir(f, op, dir, out)?
  out
}

fn fs_write(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  let op = fs_check(f, p, true)?
  let st = rt.fs_write(op, data, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_create_temp(f: Fs, dir: Str, prefix: Str) -> Str ! FsErr {
  let op = fs_check(f, dir, true)?
  let name = fspath.create_temp(op, prefix, dir)
  if name == "" {
    return Err(fs_err(rt.fs_status(), dir))
  }
  // os.CreateTemp joins without cleaning
  var full = op + "/" + name
  if op.ends_with("/") {
    full = op + name
  }
  fs_rel(f, full, fs_join(dir, name))
}

fn fs_rename(f: Fs, from: Str, to: Str) -> () ! FsErr {
  let a = fs_check(f, from, true)?
  let b = fs_check(f, to, true)?
  let st = rt.fs_rename(a, b, from)
  if st != 0 {
    return Err(fs_err(st, from))
  }
}

fn fs_remove(f: Fs, p: Str) -> () ! FsErr {
  let op = fs_check(f, p, true)?
  let st = rt.fs_remove(op, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_remove_all(f: Fs, p: Str) -> () ! FsErr {
  let op = fs_check(f, p, true)?
  let st = fspath.remove_all(op, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

fn fs_create_dir_all(f: Fs, dir: Str) -> () ! FsErr {
  let op = fs_check(f, dir, true)?
  let st = fspath.mkdir_all(op, dir)
  if st != 0 {
    return Err(fs_err(st, dir))
  }
}

fn fs_set_modified(f: Fs, p: Str, t: Time) -> () ! FsErr {
  let op = fs_check(f, p, true)?
  let st = rt.fs_chtimes(op, rt.time_ns(t), p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

// ---------------------------------------------------------------------------
// Handles, append, copy, modes, links, globs, locks (std.md 3.1, decisions
// 0163 and 0172): std/rt fsfile.go over std/llrt/xo_fs.c.

struct File {
  h: rt.FsFile
  path: Str
  write: Bool
}

struct FileLock {
  h: rt.FsLock
}

fn fs_open_mode(f: Fs, p: Str, mode: Int) -> File ! FsErr {
  let op = fs_check(f, p, mode != 0)?
  let h = rt.fs_open(op, mode, p)
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  File{h: h, path: p, write: mode != 0}
}

fn fs_open(f: Fs, p: Str) -> File ! FsErr { fs_open_mode(f, p, 0) }

fn fs_create(f: Fs, p: Str) -> File ! FsErr { fs_open_mode(f, p, 1) }

fn fs_open_append(f: Fs, p: Str) -> File ! FsErr { fs_open_mode(f, p, 2) }

/// The state errors of a handle (std/rt File.M_read): canceled, closed,
/// or open for the other direction.
fn file_state(f: File, write: Bool) -> () ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  if rt.fs_file_closed(f.h) {
    return Err(FsErr.Io(path: f.path, msg: "file already closed"))
  }
  if f.write && !write {
    return Err(FsErr.Io(path: f.path, msg: "file is open for writing"))
  }
  if !f.write && write {
    return Err(FsErr.Io(path: f.path, msg: "file is open for reading"))
  }
}

fn file_read(f: File, max: Int) -> Bytes? ! FsErr {
  file_state(f, false)?
  if max <= 0 {
    return Some(b"")
  }
  let l = rt.fs_file_read(f.h, max, f.path)
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  l.get(0)
}

fn file_read_line(f: File) -> Str? ! FsErr {
  file_state(f, false)?
  let l = rt.fs_file_read_line(f.h, f.path)
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
  l.get(0)
}

fn file_write(f: File, data: Bytes) -> () ! FsErr {
  file_state(f, true)?
  let st = rt.fs_file_write(f.h, data, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn file_close(f: File) -> () ! FsErr {
  let st = rt.fs_file_close(f.h, f.path)
  if st != 0 {
    return Err(fs_err(st, f.path))
  }
}

fn fs_append(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  let file = fs_open_mode(f, p, 2)?
  match file_write(file, data) {
    Ok(_) => ()
    Err(e) => {
      match file_close(file) {
        _ => ()
      }
      return Err(e)
    }
  }
  file_close(file)
}

fn fs_copy(f: Fs, from: Str, to: Str) -> () ! FsErr {
  let src = fs_check(f, from, false)?
  let dst = fs_check(f, to, true)?
  let st = rt.fs_copy(src, dst, from, to)
  if st != 0 {
    return Err(fs_err(st, rt.fs_msg()[0]))
  }
}

fn fs_mode(f: Fs, p: Str) -> Int ! FsErr {
  let op = fs_check(f, p, false)?
  let m = rt.fs_perm(op, p)
  if m < 0 {
    return Err(fs_err(rt.fs_status(), p))
  }
  m
}

fn fs_set_mode(f: Fs, p: Str, mode: Int) -> () ! FsErr {
  let op = fs_check(f, p, true)?
  let st = rt.fs_chmod(op, mode, p)
  if st != 0 {
    return Err(fs_err(st, p))
  }
}

/// Go's path.Dir of a cleaned path.
fn fs_dir(p: Str) -> Str {
  var i = p.len() - 1
  while i >= 0 && rt.str_byte(p, i) != 47 {
    i -= 1
  }
  fs_clean(rt.str_slice(p, 0, i + 1))
}

/// strings.Trim(s, "/").
fn trim_slashes(s: Str) -> Str {
  var a = 0
  var b = s.len()
  while a < b && rt.str_byte(s, a) == 47 {
    a += 1
  }
  while b > a && rt.str_byte(s, b - 1) == 47 {
    b -= 1
  }
  rt.str_slice(s, a, b)
}

/// Whether a link at link (in a sub capability) to target points outside
/// the root: an absolute target, or more `..` than the link has parents
/// (std/rt linkEscapes).
fn link_escapes(link: Str, target: Str) -> Bool {
  let t = target.replace("\\", "/")
  if t.starts_with("/") || (t.len() >= 2 && rt.str_byte(t, 1) == 58) {
    return true
  }
  let dir = fs_dir(fs_clean("/" + link.replace("\\", "/")))
  var depth = 0
  for seg in (trim_slashes(dir) + "/" + t).split("/") {
    if seg == ".." {
      depth -= 1
    } else if seg != "" && seg != "." {
      depth += 1
    }
    if depth < 0 {
      return true
    }
  }
  false
}

fn fs_symlink(f: Fs, target: Str, link: Str) -> () ! FsErr {
  let op = fs_check(f, link, true)?
  if (rt.fs_mode(f) & 1) != 0 && link_escapes(link, target) {
    return Err(FsErr.Denied(path: link))
  }
  let st = rt.fs_symlink(target, op, link)
  if st != 0 {
    return Err(fs_err(st, link))
  }
}

fn fs_read_link(f: Fs, p: Str) -> Str? ! FsErr {
  let op = fs_check(f, p, false)?
  let l = rt.fs_read_link(op, p)
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  l.get(0)
}

fn fs_lock_wait(f: Fs, p: Str, wait: Bool) -> FileLock? ! FsErr {
  let op = fs_check(f, p, true)?
  let h = rt.fs_lock(op, wait, p)
  if rt.fs_lock_held(h) {
    return Some(FileLock{h: h})
  }
  let st = rt.fs_status()
  if st != 0 {
    return Err(fs_err(st, p))
  }
  None
}

fn fs_lock(f: Fs, p: Str) -> FileLock ! FsErr {
  match fs_lock_wait(f, p, true)? {
    Some(l) => l
    None => Err(FsErr.Canceled)
  }
}

fn fs_try_lock(f: Fs, p: Str) -> FileLock? ! FsErr { fs_lock_wait(f, p, false) }

fn filelock_unlock(l: FileLock) { rt.fs_unlock(l.h) }

// Globs (std/rt fsGlob): Go's path.Match on each segment, `**` for any
// number of directories, through read_dir and exists.

/// Go's path.Match scanChunk: whether stars lead, the chunk, the rest.
fn glob_scan(p: Str) -> (Bool, Str, Str) {
  let n = p.len()
  var i = 0
  var star = false
  while i < n && rt.str_byte(p, i) == 42 {
    i += 1
    star = true
  }
  let start = i
  var inrange = false
  while i < n {
    let c = rt.str_byte(p, i)
    if c == 92 {
      if i + 1 < n {
        i += 1
      }
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 && !inrange {
      break
    }
    i += 1
  }
  (star, rt.str_slice(p, start, i), rt.str_slice(p, i, n))
}

/// Go's path.Match getEsc at chunk[c:]: the rune and the index after it,
/// or the index -1 for a malformed pattern.
fn glob_esc(chunk: Str, c0: Int) -> (Int, Int) {
  let n = chunk.len()
  var c = c0
  if c >= n || rt.str_byte(chunk, c) == 45 || rt.str_byte(chunk, c) == 93 {
    return (0, -1)
  }
  if rt.str_byte(chunk, c) == 92 {
    c += 1
    if c >= n {
      return (0, -1)
    }
  }
  let d = rt.bytes_decode(chunk.bytes(), c)
  let r = d >> 3
  let k = d & 7
  if r == 0xfffd && k == 1 {
    return (0, -1)
  }
  c += k
  if c >= n {
    return (0, -1)
  }
  (r, c)
}

/// Go's path.Match matchChunk of chunk against s[si:]: the index after
/// the match, -1 when it does not match, -2 for a malformed pattern.
fn glob_chunk(chunk: Str, s: Str, si0: Int) -> Int {
  let cn = chunk.len()
  let sn = s.len()
  var c = 0
  var si = si0
  var failed = false
  while c < cn {
    if !failed && si >= sn {
      failed = true
    }
    let ch = rt.str_byte(chunk, c)
    if ch == 91 {
      var r = 0
      if !failed {
        let d = rt.bytes_decode(s.bytes(), si)
        r = d >> 3
        si += d & 7
      }
      c += 1
      var negated = false
      if c < cn && rt.str_byte(chunk, c) == 94 {
        negated = true
        c += 1
      }
      var matched = false
      var nrange = 0
      while true {
        if c < cn && rt.str_byte(chunk, c) == 93 && nrange > 0 {
          c += 1
          break
        }
        let (lo, c1) = glob_esc(chunk, c)
        if c1 < 0 {
          return -2
        }
        c = c1
        var hi = lo
        if rt.str_byte(chunk, c) == 45 {
          let (h2, c2) = glob_esc(chunk, c + 1)
          if c2 < 0 {
            return -2
          }
          hi = h2
          c = c2
        }
        if lo <= r && r <= hi {
          matched = true
        }
        nrange += 1
      }
      if matched == negated {
        failed = true
      }
    } else if ch == 63 {
      if !failed {
        if rt.str_byte(s, si) == 47 {
          failed = true
        }
        si += rt.bytes_decode(s.bytes(), si) & 7
      }
      c += 1
    } else {
      if ch == 92 {
        c += 1
        if c >= cn {
          return -2
        }
      }
      if !failed {
        if rt.str_byte(chunk, c) != rt.str_byte(s, si) {
          failed = true
        }
        si += 1
      }
      c += 1
    }
  }
  if failed {
    return -1
  }
  si
}

/// Go's path.Match: 1 a match, 0 none, -1 a malformed pattern.
fn glob_match(pattern: Str, name: Str) -> Int {
  let nl = name.len()
  var p = pattern
  var ni = 0
  while p.len() > 0 {
    let (star, chunk, rest) = glob_scan(p)
    p = rest
    if star && chunk == "" {
      // a trailing * matches the rest of the name unless it has a /
      if scan.find(rt.str_slice(name, ni, nl), "/", 0) < 0 {
        return 1
      }
      return 0
    }
    let t = glob_chunk(chunk, name, ni)
    if t >= 0 && (t == nl || p.len() > 0) {
      ni = t
      continue
    }
    if t == -2 {
      return -1
    }
    var found = false
    if star {
      // a match after skipping i + 1 bytes, never a /
      var i = ni
      while !found && i < nl && rt.str_byte(name, i) != 47 {
        let t2 = glob_chunk(chunk, name, i + 1)
        if t2 >= 0 {
          if p.len() > 0 || t2 == nl {
            ni = t2
            found = true
          }
        } else if t2 == -2 {
          return -1
        }
        i += 1
      }
    }
    if found {
      continue
    }
    // the rest of the pattern must still be well formed
    while p.len() > 0 {
      let (_, c2, r2) = glob_scan(p)
      p = r2
      if glob_chunk(c2, "", 0) == -2 {
        return -1
      }
    }
    return 0
  }
  if ni == nl {
    return 1
  }
  0
}

fn glob_join(dir: Str, name: Str) -> Str {
  if dir == "" {
    return name
  }
  if dir.ends_with("/") {
    return dir + name
  }
  dir + "/" + name
}

fn glob_list(f: Fs, dir: Str) -> List[FileInfo] ! FsErr uses fs.read {
  var d = dir
  if d == "" {
    d = "."
  }
  match f.read_dir(d) {
    Ok(l) => l
    Err(e) => {
      match e {
        FsErr.NotFound(_) | FsErr.NotDir(_) => []
        _ => Err(e)
      }
    }
  }
}

fn glob_walk(f: Fs, segs: List[Str], dir: Str, i: Int, var out: List[Str], var seen: Set[Str]) -> () ! FsErr uses fs.read {
  if i == segs.len() {
    if !seen.contains(dir) {
      seen.add(dir)
      out.push(dir)
    }
    return
  }
  let s = segs[i]
  if s == "**" {
    glob_walk(f, segs, dir, i + 1, out, seen)?
    for x in glob_list(f, dir)? {
      if x.is_dir && !x.name.starts_with(".") {
        glob_walk(f, segs, glob_join(dir, x.name), i, out, seen)?
      }
    }
    return
  }
  if !(s.contains("*") || s.contains("?") || s.contains("[") || s.contains("\\")) {
    // a literal segment: no listing needed
    let p = glob_join(dir, s)
    if i == segs.len() - 1 {
      if f.exists(p)? && !seen.contains(p) {
        seen.add(p)
        out.push(p)
      }
      return
    }
    return glob_walk(f, segs, p, i + 1, out, seen)
  }
  for x in glob_list(f, dir)? {
    if x.name.starts_with(".") && !s.starts_with(".") {
      continue
    }
    if glob_match(s, x.name) != 1 {
      continue
    }
    if i < segs.len() - 1 && !x.is_dir {
      continue
    }
    glob_walk(f, segs, glob_join(dir, x.name), i + 1, out, seen)?
  }
}

fn fs_glob(f: Fs, pattern: Str) -> List[Str] ! FsErr uses fs.read {
  let pat = pattern.replace("\\", "/")
  let segs = trim_slashes(pat).split("/")
  for s in segs {
    if glob_match(s, "") < 0 {
      return Err(FsErr.Io(path: pat, msg: "bad pattern: syntax error in pattern"))
    }
  }
  var start = ""
  if pat.starts_with("/") {
    start = "/"
  }
  var out: List[Str] = []
  var seen: Set[Str] = #{}
  glob_walk(f, segs, start, 0, out, seen)?
  out.sort()
}

// ---------------------------------------------------------------------------
// Stdio (std.md 3.6, decisions 0088 and 0102): std/rt caps.go's realStdio

fn stdio_write(_s: Stdio, data: Bytes) -> () ! IoErr {
  if rt.fs_canceled() {
    return Err(IoErr.Canceled)
  }
  rt.print(data)
}

fn stdin_err(st: Int) -> IoErr {
  if st == 2 {
    return IoErr.Io(msg: rt.stdin_msg())
  }
  IoErr.Canceled
}

// ---------------------------------------------------------------------------
// Rand.shuffle (std.md 3.4): Fisher-Yates from the end, one `int` per
// step, as std/rt's Rand_shuffle (the same seeded order in tests)

fn rand_shuffle[T](r: Rand, xs: List[T]) -> List[T] {
  var out = xs
  var i = out.len() - 1
  while i > 0 {
    let j = r.int(0, i + 1)
    let a = out[i]
    out[i] = out[j]
    out[j] = a
    i -= 1
  }
  out
}

// ---------------------------------------------------------------------------
// Proc (std.md 3.7, decision 0107)

fn proc_run(p: Proc, cmd: Str, args: List[Str]) -> ProcOutput ! ProcErr {
  if !cap_admits(rt.proc_lists(p), cmd) {
    return Err(ProcErr.Denied(cmd))
  }
  let r = rt.proc_run(cmd, args)
  let st = r.get(0) ?? "2"
  let detail = r.get(1) ?? ""
  if st == "1" {
    return Err(ProcErr.NotFound(cmd))
  }
  if st == "2" {
    return Err(ProcErr.Io(detail))
  }
  if st == "3" {
    return Err(ProcErr.Canceled)
  }
  ProcOutput { code: text.parse_int(detail) ?? 0, stdout: (r.get(2) ?? "").bytes(), stderr: (r.get(3) ?? "").bytes() }
}

// ---------------------------------------------------------------------------
// Attenuation (std.md 3.5 and 3.7, decisions 0156 and 0172): std/rt
// attenuate.go. A Proc, Env, or Net is the lists of its attenuations in one Str:
// each list is \u{1} and then its names, each followed by \u{0}; "" has
// none. Every list must admit a name.

fn cap_lists_add(lists: Str, names: List[Str]) -> Str {
  var b = lists + "\u{1}"
  for n in names {
    b = b + n + "\u{0}"
  }
  b
}

fn cap_admits(lists: Str, name: Str) -> Bool {
  if lists == "" {
    return true
  }
  let want = "\u{0}" + name + "\u{0}"
  var first = true
  for l in lists.split("\u{1}") {
    if first {
      first = false
      continue
    }
    if !("\u{0}" + l).contains(want) {
      return false
    }
  }
  true
}

/// Proc.kill (std.md 3.7, decision 0190): std/rt prockill.go. An
/// attenuated Proc must list "kill"; the C runtime sends the signal, or
/// records it for a test's FakeProc.
fn proc_kill(p: Proc, pid: Int, signal: Str = "TERM") -> () ! ProcErr uses proc {
  if !cap_admits(rt.proc_lists(p), "kill") {
    return Err(ProcErr.Denied("kill"))
  }
  let names = ["HUP", "INT", "QUIT", "KILL", "TERM", "USR1", "USR2", "CONT", "STOP"]
  var sig = -1
  for (i, n) in names.indexed() {
    if n == signal {
      sig = i
    }
  }
  if sig < 0 {
    return Err(ProcErr.Io("unknown signal ${signal.quote()}"))
  }
  if pid <= 0 {
    // 0 and negative pids name process groups: never sent
    return Err(ProcErr.Io("invalid process id ${pid}"))
  }
  match rt.proc_kill(pid, sig).get(0) {
    Some(msg) => Err(ProcErr.Io(msg))
    None => Ok(())
  }
}

fn proc_only(p: Proc, cmds: List[Str]) -> Proc { rt.proc_new(cap_lists_add(rt.proc_lists(p), cmds)) }

fn env_only(e: Env, names: List[Str]) -> Env { rt.env_new(cap_lists_add(rt.env_lists(e), names)) }

/// Net.only (decision 0175): the entries trimmed and lowered (std/rt's
/// normHosts); the C runtime checks dial, listen, and a client's
/// redirects against the lists (net_admits), std/native/http.xo each
/// request.
fn net_only(n: Net, hosts: List[Str]) -> Net {
  var norm: List[Str] = []
  for h in hosts {
    let t = h.trim()
    if t.len() >= 5 && t[0..5].to_lower() == "unix:" {
      // a socket path keeps its case (decision 0190)
      norm.push("unix:" + t[5..])
    } else {
      norm.push(t.to_lower())
    }
  }
  rt.net_new(cap_lists_add(rt.net_lists(n), norm))
}

fn env_get(e: Env, name: Str) -> Str? uses env {
  if !cap_admits(rt.env_lists(e), name) {
    return None
  }
  rt.env_get(name).get(0)
}

fn env_vars(e: Env) -> Map[Str, Str] uses env {
  let lists = rt.env_lists(e)
  var m: Map[Str, Str] = {}
  for kv in rt.env_vars() {
    var k = kv
    var v = ""
    match kv.find("=") {
      Some(i) => {
        k = kv[0..i]
        v = kv[i + 1..]
      }
      None => ()
    }
    if cap_admits(lists, k) {
      m.put(k, v)
    }
  }
  m
}

/// os.UserHomeDir: $HOME (on Windows %USERPROFILE% with / separators,
/// read when the Env admits HOME), or Missing("HOME").
fn env_home(e: Env) -> Str ! EnvErr uses env {
  if fs_windows() {
    if !cap_admits(rt.env_lists(e), "HOME") {
      return Err(EnvErr.Missing(name: "HOME"))
    }
    match rt.env_get("USERPROFILE").get(0) {
      Some(h) => {
        if h != "" {
          return fs_slash(h)
        }
      }
      None => ()
    }
    return Err(EnvErr.Missing(name: "HOME"))
  }
  match env_get(e, "HOME") {
    Some(h) => {
      if h != "" {
        return h
      }
    }
    None => ()
  }
  Err(EnvErr.Missing(name: "HOME"))
}

// ---------------------------------------------------------------------------
// Commands, children, and pipelines (std.md 3.8, decisions 0161 and 0172):
// std/rt proccmd.go. A Cmd is a value that remembers the attenuation of
// the Proc that made it; a Child is a handle of the C runtime
// (std/llrt/xo_proc.c).

struct Cmd {
  lists: Str
  name: Str
  args: List[Str]
  dir: Str
  env: List[Str]
  env_set: Bool
  extra: List[Str]
  input: Bytes
  has_input: Bool
  inherit: Bool
  merge: Bool
}

struct Child {
  h: rt.ProcChild
}

fn proc_cmd(p: Proc, name: Str, args: List[Str] = []) -> Cmd {
  Cmd{lists: rt.proc_lists(p), name: name, args: args, dir: "", env: [], env_set: false, extra: [], input: b"", has_input: false, inherit: false, merge: false}
}

fn cmd_dir(c: Cmd, path: Str) -> Cmd {
  var x = c
  x.dir = path
  x
}

/// The child's environment is exactly the variables e shows now.
fn cmd_env(c: Cmd, e: Env) -> Cmd uses env {
  var x = c
  var env: List[Str] = []
  for (k, v) in e.vars().entries() {
    env.push(k + "=" + v)
  }
  x.env = env
  x.env_set = true
  x
}

fn cmd_set_env(c: Cmd, name: Str, value: Str) -> Cmd {
  var x = c
  x.extra.push(name + "=" + value)
  x
}

fn cmd_stdin(c: Cmd, data: Bytes) -> Cmd {
  var x = c
  x.input = data
  x.has_input = true
  x
}

fn cmd_inherit(c: Cmd) -> Cmd {
  var x = c
  x.inherit = true
  x
}

fn cmd_merge_stderr(c: Cmd) -> Cmd {
  var x = c
  x.merge = true
  x
}

/// The spec of c for the runtime (std/native/rt.xo proc_exec), appended
/// to out.
fn cmd_spec(c: Cmd, var out: List[Str]) {
  var flags = 0
  if c.env_set {
    flags = flags | 1
  }
  if c.inherit {
    flags = flags | 2
  }
  if c.merge {
    flags = flags | 4
  }
  // the environment and the Windows command line (decision 0193 step 6)
  procspec.spec(c.name, c.dir, flags, c.args, c.env, c.extra, out)
}

/// The ProcErr of a failed outcome (status st, detail d).
fn proc_err(st: Str, d: Str) -> ProcErr {
  match st {
    "1" => ProcErr.NotFound(d)
    "2" => ProcErr.Io(d)
    _ => ProcErr.Canceled
  }
}

fn proc_outcome(r: List[Str]) -> ProcOutput ! ProcErr {
  let st = r.get(0) ?? "2"
  let d = r.get(1) ?? ""
  if st != "0" {
    return Err(proc_err(st, d))
  }
  ProcOutput{code: text.parse_int(d) ?? 0, stdout: (r.get(2) ?? "").bytes(), stderr: (r.get(3) ?? "").bytes()}
}

/// Denied or Canceled before c runs (std/rt Cmd.M_output).
fn cmd_check(c: Cmd) -> () ! ProcErr {
  if !cap_admits(c.lists, c.name) {
    return Err(ProcErr.Denied(c.name))
  }
  if rt.fs_canceled() {
    return Err(ProcErr.Canceled)
  }
}

fn cmd_output(c: Cmd) -> ProcOutput ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  proc_outcome(rt.proc_exec(spec, c.input, c.has_input, 0))
}

fn cmd_run(c: Cmd) -> Int ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  let out = proc_outcome(rt.proc_exec(spec, c.input, c.has_input, 1))?
  out.code
}

fn cmd_spawn(c: Cmd) -> Child ! ProcErr uses proc {
  cmd_check(c)?
  var spec: List[Str] = []
  cmd_spec(c, spec)
  let h = rt.proc_spawn(spec, c.input, c.has_input)
  let r = rt.proc_child_start(h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Child{h: h}
}

fn proc_pipeline(p: Proc, cmds: List[Cmd]) -> ProcOutput ! ProcErr uses proc {
  let lists = rt.proc_lists(p)
  for c in cmds {
    if !cap_admits(lists, c.name) {
      return Err(ProcErr.Denied(c.name))
    }
  }
  if cmds.is_empty() {
    return ProcOutput{code: 0, stdout: b"", stderr: b""}
  }
  var spec: List[Str] = []
  for c in cmds {
    if !cap_admits(c.lists, c.name) {
      return Err(ProcErr.Denied(c.name))
    }
    cmd_spec(c, spec)
  }
  if rt.fs_canceled() {
    return Err(ProcErr.Canceled)
  }
  proc_outcome(rt.proc_exec(spec, cmds[0].input, cmds[0].has_input, 2))
}

fn child_pid(c: Child) -> Int { rt.proc_child_pid(c.h) }

fn child_write(c: Child, data: Bytes) -> () ! ProcErr uses proc {
  let r = rt.proc_child_write(c.h, data)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
}

fn child_close_stdin(c: Child) { rt.proc_child_close_stdin(c.h) }

fn child_read_from(c: Child, err: Bool, max: Int) -> Bytes? ! ProcErr {
  let r = rt.proc_child_read(c.h, err, max)
  let st = r.get(0) ?? "2"
  if st == "e" {
    return None
  }
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Some((r.get(1) ?? "").bytes())
}

fn child_read(c: Child, max: Int) -> Bytes? ! ProcErr uses proc { child_read_from(c, false, max) }

fn child_read_err(c: Child, max: Int) -> Bytes? ! ProcErr uses proc { child_read_from(c, true, max) }

fn child_read_line(c: Child) -> Str? ! ProcErr uses proc {
  let r = rt.proc_child_read_line(c.h)
  let st = r.get(0) ?? "2"
  if st == "e" {
    return None
  }
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  Some(r.get(1) ?? "")
}

fn child_wait(c: Child) -> Int ! ProcErr uses proc {
  let r = rt.proc_child_wait(c.h)
  let st = r.get(0) ?? "2"
  if st != "0" {
    return Err(proc_err(st, r.get(1) ?? ""))
  }
  text.parse_int(r.get(1) ?? "0") ?? 0
}

fn child_kill(c: Child) { rt.proc_child_kill(c.h) }

fn stdio_read_line(_s: Stdio) -> Str? ! IoErr {
  let line = rt.stdin_read(false)
  let st = rt.stdin_status()
  if st == 0 {
    return Some(line)
  }
  if st == 1 {
    return None
  }
  Err(stdin_err(st))
}

fn stdio_read_all(_s: Stdio) -> Str ! IoErr {
  let text = rt.stdin_read(true)
  let st = rt.stdin_status()
  if st == 0 {
    return text
  }
  Err(stdin_err(st))
}

fn stdio_lines(s: Stdio) -> List[Str] ! IoErr {
  let text = stdio_read_all(s)?
  text.lines()
}

// User directories (std.md 3.5, decision 0163): std/rt's userDir, read
// through the Env.

fn env_user_dir(e: Env, cache: Bool) -> Str ! EnvErr uses env {
  var xdg = "XDG_CONFIG_HOME"
  var mac = "/Library/Application Support"
  var unix = "/.config"
  if cache {
    xdg = "XDG_CACHE_HOME"
    mac = "/Library/Caches"
    unix = "/.cache"
  }
  match e.get(xdg) {
    Some(v) => {
      if v.starts_with("/") || (v.len() >= 3 && v[1..2] == ":") {
        return fs_slash(v)
      }
    }
    None => ()
  }
  if fs_windows() {
    // %AppData% and %LocalAppData% (std/rt userDir)
    let win = if cache { "LocalAppData" } else { "AppData" }
    let v = e.get(win) ?? ""
    if v == "" {
      return Err(EnvErr.Missing(name: win))
    }
    return v.replace("\\", "/")
  }
  let home = match e.get("HOME") {
    Some(h) => h
    None => ""
  }
  if home == "" {
    return Err(EnvErr.Missing(name: "HOME"))
  }
  let base = home.trim_suffix("/")
  match target.os {
    TargetOs.Darwin => base + mac
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => base + unix
  }
}

fn env_config_dir(e: Env) -> Str ! EnvErr uses env { env_user_dir(e, false) }

fn env_cache_dir(e: Env) -> Str ! EnvErr uses env { env_user_dir(e, true) }

// Terminals (std.md 3.6, decision 0162): std/rt's term.go.

fn stdio_stdin_is_tty(_s: Stdio) -> Bool { rt.isatty(0) }

fn stdio_stdout_is_tty(_s: Stdio) -> Bool { rt.isatty(1) }

fn stdio_stderr_is_tty(_s: Stdio) -> Bool { rt.isatty(2) }

fn stdio_width(_s: Stdio) -> Int? {
  let w = rt.term_width()
  if w > 0 {
    return Some(w)
  }
  None
}

/// The prompt on standard error, then a line read with the terminal's
/// echo off; the newline the user typed was not echoed, so one is written.
fn stdio_read_secret(s: Stdio, prompt: Str) -> Str? ! IoErr {
  s.eprint(prompt)
  let off = rt.stdin_echo(false)
  defer {
    if off {
      rt.stdin_echo(true)
      s.eprint("\n")
    }
  }
  stdio_read_line(s)
}

fn stdio_read_bytes(_s: Stdio, max: Int) -> Bytes? ! IoErr {
  if max <= 0 {
    return Some(b"")
  }
  let data = rt.stdin_read_bytes(max.min(1048576))
  let st = rt.stdin_status()
  if st == 0 {
    return Some(data)
  }
  if st == 1 {
    return None
  }
  Err(stdin_err(st))
}

fn stdio_read_all_bytes(s: Stdio) -> Bytes ! IoErr {
  let text = stdio_read_all(s)?
  text.bytes()
}

/// math.Round(s * 1e9) nanoseconds (std/rt's Duration_from_secs).
fn duration_from_secs(s: Float) -> Duration { Duration.from_nanos(Int((s * 1000000000.0).round())) }

/// math.Round(d * f) nanoseconds.
fn duration_scale(d: Duration, f: Float) -> Duration { Duration.from_nanos(Int((Float(d.nanos()) * f).round())) }

fn duration_ceil_seconds(d: Duration) -> Int {
  let n = d.nanos()
  if n % 1000000000 > 0 {
    return n / 1000000000 + 1
  }
  n / 1000000000
}

// ---------------------------------------------------------------------------
// Time (std.md 2.6)

/// time.Parse(time.RFC3339Nano, s) as the Go backend calls it: the union
/// of Go's fast path (parseRFC3339) and its general parser for that
/// layout, which also takes a one digit hour, a comma before the
/// fraction, and offsets up to +24:60. Times outside the range of Time
/// wrap like Go's UnixNano.
fn time_parse_rfc3339(s: Str) -> Time? {
  let b = s.bytes()
  let n = b.len()
  if n < 4 || !rfc_digits(b, 0, 4) {
    return None
  }
  let year = rfc_num(b, 0, 4)
  if n < 10 || b[4] != 45 || !rfc_digits(b, 5, 2) || b[7] != 45 || !rfc_digits(b, 8, 2) {
    return None
  }
  let month = rfc_num(b, 5, 2)
  let day = rfc_num(b, 8, 2)
  if month < 1 || month > 12 || n < 12 || b[10] != 84 || !rfc_digits(b, 11, 1) {
    return None
  }
  // the hour has one or two digits
  var i = 12
  var hour = rfc_num(b, 11, 1)
  if rfc_digits(b, 12, 1) {
    hour = rfc_num(b, 11, 2)
    i = 13
  }
  if hour > 23 || i + 6 > n || b[i] != 58 || !rfc_digits(b, i + 1, 2) || b[i + 3] != 58 || !rfc_digits(b, i + 4, 2) {
    return None
  }
  let min = rfc_num(b, i + 1, 2)
  let sec = rfc_num(b, i + 4, 2)
  if min > 59 || sec > 59 {
    return None
  }
  i += 6
  var nsec = 0
  if i + 1 < n && (b[i] == 46 || b[i] == 44) && rfc_digits(b, i + 1, 1) {
    var j = i + 1
    while j < n && rfc_digits(b, j, 1) {
      j += 1
    }
    // at most 9 digits count (parseNanoseconds)
    var k = 0
    while k < 9 {
      nsec = nsec * 10
      if i + 1 + k < j {
        nsec += Int(b[i + 1 + k]) - 48
      }
      k += 1
    }
    i = j
  }
  var zone = 0
  if i < n && b[i] == 90 {
    i += 1
  } else {
    if i + 6 > n || b[i + 3] != 58 || !rfc_digits(b, i + 1, 2) || !rfc_digits(b, i + 4, 2) {
      return None
    }
    let hr = rfc_num(b, i + 1, 2)
    let mm = rfc_num(b, i + 4, 2)
    if hr > 24 || mm > 60 {
      return None
    }
    zone = (hr * 60 + mm) * 60
    if b[i] == 45 {
      zone = -zone
    } else if b[i] != 43 {
      return None
    }
    i += 6
  }
  if i != n || day < 1 || day > rfc_days_in(month, year) {
    return None
  }
  let secs = rfc_days(year, month, day) * 86400 + hour * 3600 + min * 60 + sec - zone
  Some(Time.UNIX_EPOCH + Duration.from_nanos(rt.int_wrap(0, rt.int_wrap(2, secs, 1000000000), nsec)))
}

fn rfc_digits(b: Bytes, at: Int, k: Int) -> Bool {
  if at + k > b.len() {
    return false
  }
  for i in at..at + k {
    if b[i] < 48 || b[i] > 57 {
      return false
    }
  }
  true
}

fn rfc_num(b: Bytes, at: Int, k: Int) -> Int {
  var v = 0
  for i in at..at + k {
    v = v * 10 + Int(b[i]) - 48
  }
  v
}

fn rfc_days_in(m: Int, y: Int) -> Int {
  if m == 2 {
    if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  31
}

/// RFC 3339 in UTC: the Display text of a Time.
fn time_format_rfc3339(t: Time) -> Str { "${t}" }

/// The days from 1970-01-01 to y-m-d (H. Hinnant's days_from_civil).
fn rfc_days(year: Int, m: Int, d: Int) -> Int {
  var y = year
  if m <= 2 {
    y -= 1
  }
  var era = y / 400
  if y < 0 && y % 400 != 0 {
    era -= 1
  }
  let yoe = y - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

// ---------------------------------------------------------------------------
// The runtime's text, as the SSA builder calls it (decision 0193):
// Display and Debug of Duration, Time, Str, and Bytes, and std/json's
// Duration and Time. In Xo (std/native/llrt/text.xo), or the C with
// XO_LLRT_C=text.

fn llrt_append_duration(s: Str, d: Int) -> Str { text.append_duration(s, d) }

fn llrt_append_time(s: Str, t: Int) -> Str { text.append_time(s, t) }

fn llrt_append_quote(s: Str, t: Str) -> Str { text.append_quote(s, t.bytes()) }

fn llrt_append_bytes_quote(s: Str, b: Bytes) -> Str { text.append_quote(s, b) }

fn llrt_duration_ok(s: Str) -> Bool {
  match text.parse_duration(s) {
    Some(_) => true
    None => false
  }
}

fn llrt_duration(s: Str) -> Int { text.parse_duration(s) ?? 0 }

fn llrt_time_ok(s: Str) -> Bool {
  match text.parse_time(s) {
    Some(_) => true
    None => false
  }
}

fn llrt_time(s: Str) -> Int { text.parse_time(s) ?? 0 }

// The number text, as the SSA builder calls it for every interpolation
// and Display of an Int or Float (decision 0193 step 3): in Xo
// (std/native/llrt/num.xo). Decision 0198 deleted its C path
// (XO_LLRT_C=num, the C runtime's str.concat_int and friends).

fn llrt_concat_int(s: Str, v: Int) -> Str { num.append_int(s, v) }

fn llrt_concat_float(s: Str, f: Float) -> Str { num.append_float(s, f) }

// The leaf text of Display and Debug (decision 0193 step 5): a Rune's
// Display and Debug, a UInt64's text. In Xo (std/native/llrt/show.xo);
// with XO_LLRT_C=show the Go SSA builder calls the C runtime instead.

fn llrt_append_rune(s: Str, r: Int) -> Str { show.append_rune(s, r) }

fn llrt_append_rune_quote(s: Str, r: Int) -> Str { show.append_rune_quote(s, r) }

fn llrt_append_u64(s: Str, v: Int) -> Str { show.append_u64(s, v) }

// Atomic's add and max (decision 0200): in Xo over the runtime's atomics
// (std/native/llrt/atomic.xo); the SSA builders lower get, set, swap, and
// compare_and_swap inline. With XO_LLRT_C=atomic the Go SSA builder calls
// the C runtime for every Atomic operation instead.

fn llrt_atomic_add(a: Atomic[Int], n: Int, at: rt.Loc) -> Int { atomic.add(a, n, at) }

fn llrt_atomic_max(a: Atomic[Int], n: Int) -> Int { atomic.max(a, n) }

// The report of a property test's case to the harness (decision 0193
// step 5): in Xo (std/native/llrt/report.xo); with XO_LLRT_C=report the
// Go SSA builder calls the C runtime's xo_prop_report instead.

fn llrt_prop_report(g: Int, input: Str) { report.prop_report(g, input) }

// std/json's tape readers and text, as the decoders and encoders the SSA
// builder generates per type call them (decision 0193 step 4): in Xo
// (std/native/llrt/jsontext.xo). Decision 0198 deleted its C path
// (XO_LLRT_C=jsontext, the C runtime's json_str and friends).

fn llrt_json_next(tape: List[Int], i: Int) -> Int { jsontext.next(tape, i) }

fn llrt_json_str(src: Bytes, tape: List[Int], i: Int) -> Str { jsontext.str_at(src, tape, i) }

fn llrt_json_find(src: Bytes, tape: List[Int], i: Int, key: Str) -> Int { jsontext.find(src, tape, i, key) }

fn llrt_json_members(src: Bytes, tape: List[Int], i: Int) -> List[Int] { jsontext.members(src, tape, i) }

fn llrt_json_int_ok(src: Bytes, tape: List[Int], i: Int) -> Bool { jsontext.int_ok(src, tape, i) }

fn llrt_json_int(src: Bytes, tape: List[Int], i: Int) -> Int { jsontext.int_at(src, tape, i) }

fn llrt_json_float_ok(src: Bytes, tape: List[Int], i: Int) -> Bool { jsontext.float_ok(src, tape, i) }

fn llrt_json_float(src: Bytes, tape: List[Int], i: Int) -> Float { jsontext.float_at(src, tape, i) }

fn llrt_rs_append_json_str(s: Str, t: Str) -> Str { jsontext.append_str(s, t) }

fn llrt_rs_append_json_float(s: Str, f: Float) -> Str { jsontext.append_float(s, f) }

fn llrt_rs_append_b64_quoted(s: Str, b: Bytes) -> Str { jsontext.append_b64(s, b) }

fn llrt_b64_ok(s: Str) -> Bool { jsontext.b64_ok(s) }

fn llrt_b64_decode(s: Str) -> Bytes { jsontext.b64_decode(s) }

// The integer operations of generated code (the zero-C audit's portable
// group, decisions 0193 and 0195): in Xo (std/native/llrt/ints.xo). The
// SSA builders lower a sized integer operation inline and call the
// faults here when its check fails; with XO_LLRT_C=ints the Go SSA
// builder calls the C runtime (rt.int_op and friends) instead.

fn llrt_int_op_fault(op: Int, a: Int, b: Int, bits: Int, uns: Int, at: Str) -> Never { ints.op_fault(op, a, b, bits, uns, at) }

fn llrt_int_conv_fault(v: Int, fbits: Int, funs: Int, tbits: Int, tuns: Int, at: Str) -> Never { ints.conv_fault(v, fbits, funs, tbits, tuns, at) }

fn llrt_u64_div(a: Int, b: Int) -> Int { ints.u64_div(a, b) }

fn llrt_u64_rem(a: Int, b: Int) -> Int { ints.u64_rem(a, b) }

fn llrt_floor_div(a: Int, b: Int) -> Int { ints.floor_div(a, b) }

fn llrt_str_hash(s: Str) -> Int { ints.str_hash(s) }

// The scalar values of property tests and testing.gen (decision 0195):
// in Xo (std/native/llrt/gen.xo) over the C generator's draws; with
// XO_LLRT_C=gen the Go SSA builder calls the C runtime instead.

fn llrt_gen_size(g: Int) -> Int { gen.size(g) }

fn llrt_gen_any_int(g: Int) -> Int { gen.any_int(g) }

fn llrt_gen_sized(g: Int, kind: Int) -> Int { gen.sized(g, kind) }

fn llrt_gen_float(g: Int) -> Float { gen.float(g) }

fn llrt_gen_rune(g: Int) -> Int { gen.rune(g) }

fn llrt_gen_str(g: Int) -> Str { gen.str(g) }

fn llrt_gen_duration(g: Int) -> Int { gen.duration(g) }

fn llrt_gen_time(g: Int) -> Int { gen.time(g) }
