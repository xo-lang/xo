// std/testing on the native backends (decision 0083). The fakes of a test
// are the capabilities themselves, run in the runtime's test world
// (std/native/llrt/testworld.xo and twrun.xo); internal/ssa lowers their
// control methods (build_testmode.go) and testing.run_main. What needs Xo values is here:
// the captured log records, FakeNet's handlers, failures, and requests,
// and MemFs.
use std/http
use std/log
use std/path
use std/sql
use std/testing
use native/llrt/ctx
use native/llrt/glob
use native/llrt/pool
use native/llrt/tasks
use native/llrt/testworld
use native/llrt/userfs
use native/rt
use native/llrt/raw

/// The records logged so far in this test, oldest first (std.md 8.6).
fn logs() -> List[log.Record] {
  var out: List[log.Record] = []
  for i in 0..testworld.log_count() {
    var fields: Map[Str, Str] = {}
    for j in 0..testworld.log_nfields(i) {
      fields.put(testworld.log_key(i, j), testworld.log_val(i, j))
    }
    let level = match testworld.log_level(i) {
      1 => log.Level.Debug
      2 => log.Level.Info
      3 => log.Level.Warn
      _ => log.Level.Error
    }
    out.push(log.Record{level: level, msg: testworld.log_msg(i), fields: fields, module: testworld.log_module(i)})
  }
  out
}

/// An in memory database (std.md 10.6), as sql.memory.
fn fake_db(schema: Str) -> sql.Db ! sql.SqlErr { sql.memory(schema) }

/// "[METHOD ]scheme://host[:port]/path" split into the method (upper
/// case, "" for any), the prefix ("" for any), and the path pattern
/// (std/rt's parseFakePattern).
fn split_fake(pattern: Str) -> (Str, Str, Str) {
  var method = ""
  var p = pattern
  if let Some(i) = pattern.find(" ") {
    let head = raw.str_slice(pattern, 0, i)
    if i > 0 && !head.contains("/") {
      method = head.to_upper()
      p = raw.str_slice(pattern, i + 1, pattern.len()).trim()
    }
  }
  var prefix = ""
  var rest = p
  if let Some(i) = p.find("://") {
    let after = raw.str_slice(p, i + 3, p.len())
    match after.find("/") {
      Some(j) => {
        prefix = raw.str_slice(p, 0, i + 3 + j)
        rest = raw.str_slice(p, i + 3 + j, p.len())
      }
      None => {
        prefix = p
        rest = "/"
      }
    }
  }
  (method, prefix, rest)
}

fn fakenet_handle(n: testing.FakeNet, pattern: Str, h: fn(http.Request) -> http.Response) {
  let (method, prefix, path) = split_fake(pattern)
  testworld.fake_handle(method, prefix, path, rt.any_of(h))
}

fn fakenet_fail(n: testing.FakeNet, pattern: Str, err: http.ClientErr) {
  let (method, prefix, path) = split_fake(pattern)
  testworld.fake_fail(method, prefix, path, rt.any_of(err), false)
}

fn fakenet_fail_next(n: testing.FakeNet, pattern: Str, err: http.ClientErr) {
  let (method, prefix, path) = split_fake(pattern)
  testworld.fake_fail(method, prefix, path, rt.any_of(err), true)
}

fn fakenet_clear_failures(n: testing.FakeNet) { testworld.fake_clear() }

fn fakenet_requests(n: testing.FakeNet) -> List[http.Request] {
  var out: List[http.Request] = []
  for i in 0..testworld.req_count() {
    if let Some(r) = rt.any_get[http.Request](testworld.req_get(i)) {
      out.push(r)
    }
  }
  out
}

// ---------------------------------------------------------------------------
// MemFs (std.md 8.3, decision 0108): std/rt's memFs and memView, ported.
// The state is an Xo value the test world keeps between operations
// (test_memfs_take locks it, memfs_store gives it back), so an operation
// is atomic. A view is the Fs value itself: its root relative to the file
// system's root ("" for os.fs) and its mode bits (1 a sub capability, 2
// read only, 4 write only), as for the real Fs (decision 0102).

struct MemNode {
  dir: Bool
  data: Bytes
  modified: Time
  name: Str
  /// The permission bits set_mode or copy gave; -1 for the default
  mode: Int = -1
  /// A symbolic link, its target in data (absolute targets relative to
  /// the file system's root). A flag, not a Str field: every operation
  /// boxes the state, and each reference counted field more in a node
  /// cost about 9M instructions in 20,000 writes and reads (callgrind,
  /// 2026-10-16)
  is_link: Bool = false
}

/// The target of the link n, "" when n is not a link.
fn memfs_link_of(n: MemNode) -> Str {
  if n.is_link { rt.cast[Bytes, Str](n.data) } else { "" }
}

/// An open MemFs file (std/rt memFileH): the node it reads or writes (its
/// links followed), a read handle's contents at open and offset.
struct MemFile {
  full: Str
  data: Bytes
  off: Int
  closed: Bool
}

/// A held MemFs lock: the lock record (memlock_new) and whether it was
/// unlocked.
struct MemLockH {
  rec: Int
  done: Bool
}

struct MemFail {
  op: Int
  pattern: Str
  err: FsErr
}

struct MemState {
  nodes: Map[Str, MemNode]
  case_sensitive: Bool
  fails: List[MemFail]
  temp_seq: Int
  /// The handles: one field, so an operation's load and store of the
  /// state copies one more word, not four (the memfs workload of
  /// bench/perf/testworld, 2026-10-16)
  hs: List[MemHandles] = []
}

/// st's handles (none yet: empty ones).
fn memfs_hs(st: MemState) -> MemHandles { st.hs.get(0) ?? MemHandles{} }

/// Records the open file id's state mf.
fn memfs_set_file(var st: MemState, id: Int, mf: MemFile) {
  var h = memfs_hs(st)
  h.files.put(id, mf)
  st.hs = [h]
}

/// Open files and held locks by number (File.mem, FileLock.mem), the
/// last number given, and each path's lock record (by memfs_key).
struct MemHandles {
  files: Map[Int, MemFile] = {}
  locks: Map[Str, Int] = {}
  lock_hs: Map[Int, MemLockH] = {}
  seq: Int = 0
}

fn memfs_load() -> MemState {
  let l = testworld.memfs_take()
  if let Some(a) = l.get(0) {
    if let Some(st) = rt.any_get[MemState](a) {
      return st
    }
  }
  var nodes: Map[Str, MemNode] = {}
  nodes.put("", MemNode{dir: true, data: b"", modified: Time.UNIX_EPOCH, name: ""})
  MemState{nodes: nodes, case_sensitive: true, fails: [], temp_seq: 0}
}

fn memfs_store(st: MemState) { testworld.memfs_put(rt.any_of(st)) }

fn memfs_key(st: MemState, p: Str) -> Str {
  if st.case_sensitive {
    return p
  }
  p.to_lower()
}

// memfs_trim is strings.Trim(s, "/").
fn memfs_trim(s: Str) -> Str {
  var t = s
  while t.starts_with("/") {
    t = t[1..]
  }
  while t.ends_with("/") {
    t = t[0..t.len() - 1]
  }
  t
}

// memfs_resolve maps a path given to the view to a path relative to the
// file system's root; None when a sub view's path escapes it.
fn memfs_resolve(f: Fs, given: Str) -> Str? {
  let p = given.replace("\\", "/")
  if (rt.fs_mode(f) & 1) != 0 {
    var depth = 0
    for seg in p.split("/") {
      if seg == ".." {
        depth -= 1
      } else if seg != "" && seg != "." {
        depth += 1
      }
      if depth < 0 {
        return None
      }
    }
  }
  let clean = path.clean("/" + p).trim_prefix("/")
  let full = memfs_trim(path.join(rt.fs_root(f), clean))
  if full == "." {
    return Some("")
  }
  Some(full)
}

// memfs_rel shows a path relative to the file system's root relative to
// the view's root.
fn memfs_rel(f: Fs, full: Str) -> Str {
  let root = rt.fs_root(f)
  if root == "" {
    return full
  }
  full.trim_prefix(root).trim_prefix("/")
}

fn memfs_err(tag: Int, p: Str) -> FsErr {
  match tag {
    1 => FsErr.NotFound(path: p)
    2 => FsErr.Exists(path: p)
    3 => FsErr.NotEmpty(path: p)
    4 => FsErr.NotDir(path: p)
    5 => FsErr.IsDir(path: p)
    _ => FsErr.Denied(path: p)
  }
}

// memfs_begin checks cancellation and access and resolves p.
fn memfs_begin(f: Fs, p: Str, write: Bool) -> Str ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let mode = rt.fs_mode(f)
  if (write && (mode & 2) != 0) || (!write && (mode & 4) != 0) {
    return Err(memfs_err(6, p))
  }
  match memfs_resolve(f, p) {
    Some(full) => full
    None => Err(memfs_err(6, p))
  }
}

// memfs_failed consumes a matching fail_next: the error to give.
fn memfs_failed(var st: MemState, op: Int, paths: List[Str]) -> FsErr? {
  var i = 0
  while i < st.fails.len() {
    let fl = st.fails[i]
    if fl.op == op {
      for p in paths {
        if glob.matches(memfs_key(st, fl.pattern), memfs_key(st, p)) {
          let _gone = st.fails.remove_at(i)
          return Some(fl.err)
        }
      }
    }
    i += 1
  }
  None
}

fn memfs_get(st: MemState, full: Str) -> MemNode? { st.nodes.get(memfs_key(st, full)) }

fn memfs_put(var st: MemState, full: Str, n: MemNode) {
  st.nodes.put(memfs_key(st, full), n with {name: full})
}

fn memfs_dir_node(now: Time) -> MemNode { MemNode{dir: true, data: b"", modified: now, name: ""} }

// memfs_mkdirs creates the directories on the way to full (full too when
// self); the first prefix that is a file, if any.
fn memfs_mkdirs(var st: MemState, full: Str, self_too: Bool) -> Str? {
  if full == "" {
    return None
  }
  let segs = full.split("/")
  var end = segs.len() - 1
  if self_too {
    end = segs.len()
  }
  for i in 1..end + 1 {
    let p = segs[0..i].join("/")
    match memfs_get(st, p) {
      None => memfs_put(st, p, memfs_dir_node(Time.UNIX_EPOCH + Duration.from_nanos(rt.clock_now())))
      Some(n) => {
        if !n.dir {
          return Some(p)
        }
      }
    }
  }
  None
}

// memfs_children are the direct children of a directory, by name.
fn memfs_children(st: MemState, full: Str) -> List[MemNode] {
  var prefix = memfs_key(st, full)
  if prefix != "" {
    prefix = prefix + "/"
  }
  var out: List[MemNode] = []
  for (k, n) in st.nodes {
    if k == "" || !k.starts_with(prefix) {
      continue
    }
    if k[prefix.len()..].contains("/") {
      continue
    }
    out.push(n)
  }
  out.sort_by(fn(n) { path.base(n.name) })
}

// memfs_follow resolves the symbolic links at full (relative to the file
// system's root); None when a chain is longer than 40 links.
fn memfs_follow(st: MemState, full: Str) -> Str? {
  var cur = full
  for _ in 0..40 {
    match memfs_get(st, cur) {
      None => return Some(cur)
      Some(n) => {
        if memfs_link_of(n).is_empty() {
          return Some(cur)
        }
        if memfs_link_of(n).starts_with("/") {
          cur = memfs_trim(path.clean(memfs_link_of(n)))
        } else {
          cur = memfs_trim(path.join(path.dir("/" + cur), memfs_link_of(n)))
        }
      }
    }
  }
  None
}

// memfs_link_escapes is std/rt's linkEscapes: a link in a sub view whose
// target leaves the view.
fn memfs_link_escapes(link: Str, target: Str) -> Bool {
  let t = target.replace("\\", "/")
  if t.starts_with("/") || (t.len() >= 2 && t[1..2] == ":") {
    return true
  }
  let dir = path.dir(path.clean("/" + link.replace("\\", "/")))
  var depth = 0
  for seg in "${memfs_trim(dir)}/${t}".split("/") {
    if seg == ".." {
      depth -= 1
    } else if seg != "" && seg != "." {
      depth += 1
    }
    if depth < 0 {
      return true
    }
  }
  false
}

fn memfs_info(f: Fs, n: MemNode) -> FileInfo {
  FileInfo{name: path.base(n.name), path: memfs_rel(f, n.name), is_dir: n.dir, size: if n.is_link { 0 } else { n.data.len() }, modified: n.modified, is_symlink: n.is_link}
}

fn memfs_op_tag(op: testing.FsOp) -> Int {
  match op {
    Read => 1
    Write => 2
    Rename => 3
    Remove => 4
    CreateDir => 5
    ReadDir => 6
  }
}

fn memfs_sub(f: Fs, dir: Str) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.sub(dir)
  }
  match memfs_resolve(f, dir) {
    Some(full) => rt.fs_new(full, 1 | (rt.fs_mode(f) & 6))
    None => rt.fs_new("\u{0}denied", 7)
  }
}

fn memfs_cwd(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.cwd()
  }
  f
}

// A MemFs's working directory is its root (memfs_cwd).
fn memfs_cwd_path(f: Fs) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.cwd_path()
  }
  "/"
}

fn memfs_read_only(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_only()
  }
  rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 2)
}

fn memfs_write_only(f: Fs) -> Fs {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.write_only()
  }
  rt.fs_new(rt.fs_root(f), rt.fs_mode(f) | 4)
}

fn memfs_case_sensitive(f: Fs) -> Bool {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.case_sensitive()
  }
  let st = memfs_load()
  let on = st.case_sensitive
  memfs_store(st)
  on
}

fn memfs_stat_in(var st: MemState, f: Fs, full: Str) -> FileInfo? ! FsErr {
  if let Some(e) = memfs_failed(st, 1, [full]) {
    return Err(e)
  }
  match memfs_get(st, full) {
    None => None
    Some(n) => {
      if memfs_link_of(n).is_empty() {
        return Some(memfs_info(f, n))
      }
      // a symbolic link: the target's information under the link's name
      let t = match memfs_follow(st, full) {
        Some(t) => t
        None => return Ok(None)
      }
      match memfs_get(st, t) {
        None => None
        Some(tn) => Some(memfs_info(f, tn) with {name: path.base(n.name), path: memfs_rel(f, n.name), is_symlink: false})
      }
    }
  }
}

fn memfs_stat(f: Fs, p: Str) -> FileInfo? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.stat(p)
  }
  let full = memfs_begin(f, p, false)?
  var st = memfs_load()
  let r = memfs_stat_in(st, f, full)
  memfs_store(st)
  r?
}

fn memfs_exists(f: Fs, p: Str) -> Bool ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.exists(p)
  }
  let fi = memfs_stat(f, p)?
  fi.is_some()
}

fn memfs_read_in(var st: MemState, full: Str, p: Str) -> Bytes ! FsErr {
  if let Some(e) = memfs_failed(st, 1, [full]) {
    return Err(e)
  }
  // one lookup; a link's target only for a link
  var node = memfs_get(st, full)
  if let Some(n) = node {
    if !memfs_link_of(n).is_empty() {
      node = memfs_get(st, memfs_follow(st, full) ?? full)
    }
  }
  match node {
    None => Err(memfs_err(1, p))
    Some(n) => {
      if n.dir {
        return Err(memfs_err(5, p))
      }
      if n.is_link { b"" } else { n.data }
    }
  }
}

fn memfs_read(f: Fs, p: Str) -> Bytes ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read(p)
  }
  let full = memfs_begin(f, p, false)?
  var st = memfs_load()
  let r = memfs_read_in(st, full, p)
  memfs_store(st)
  r?
}

fn memfs_read_text(f: Fs, p: Str) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_text(p)
  }
  let b = memfs_read(f, p)?
  rt.cast[Bytes, Str](b)
}

fn memfs_list_in(var st: MemState, f: Fs, full: Str, dir: Str, all: Bool) -> List[FileInfo] ! FsErr {
  if let Some(e) = memfs_failed(st, 6, [full]) {
    return Err(e)
  }
  match memfs_get(st, full) {
    None => return Err(memfs_err(1, dir))
    Some(n) => {
      if !n.dir {
        return Err(memfs_err(4, dir))
      }
    }
  }
  var out: List[FileInfo] = []
  memfs_walk_into(st, f, full, all, out)
  out
}

fn memfs_walk_into(st: MemState, f: Fs, full: Str, all: Bool, var out: List[FileInfo]) {
  for c in memfs_children(st, full) {
    out.push(memfs_info(f, c))
    if all && c.dir {
      memfs_walk_into(st, f, c.name, all, out)
    }
  }
}

fn memfs_read_dir(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_dir(dir)
  }
  let full = memfs_begin(f, dir, false)?
  var st = memfs_load()
  let r = memfs_list_in(st, f, full, dir, false)
  memfs_store(st)
  r?
}

fn memfs_walk(f: Fs, dir: Str) -> List[FileInfo] ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.walk(dir)
  }
  let full = memfs_begin(f, dir, false)?
  var st = memfs_load()
  let r = memfs_list_in(st, f, full, dir, true)
  memfs_store(st)
  r?
}

fn memfs_write_in(var st: MemState, f: Fs, full: Str, p: Str, data: Bytes) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 2, [full]) {
    return Err(e)
  }
  if full == "" {
    return Err(memfs_err(5, p))
  }
  if let Some(bad) = memfs_mkdirs(st, full, false) {
    return Err(memfs_err(4, memfs_rel(f, bad)))
  }
  if let Some(n) = memfs_get(st, full) {
    if n.dir {
      return Err(memfs_err(5, p))
    }
  }
  memfs_put(st, full, MemNode{dir: false, data: data, modified: Time.UNIX_EPOCH + Duration.from_nanos(rt.clock_now()), name: ""})
}

fn memfs_write(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.write(p, data)
  }
  let full = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_write_in(st, f, full, p, data)
  memfs_store(st)
  r?
}

fn memfs_symlink_in(var st: MemState, f: Fs, full: Str, target: Str, link: Str) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 2, [full]) {
    return Err(e)
  }
  if (rt.fs_mode(f) & 1) != 0 && memfs_link_escapes(link, target) {
    return Err(memfs_err(6, link))
  }
  if full == "" || memfs_get(st, full).is_some() {
    return Err(memfs_err(2, link))
  }
  if let Some(bad) = memfs_mkdirs(st, full, false) {
    return Err(memfs_err(4, memfs_rel(f, bad)))
  }
  var t = target.replace("\\", "/")
  let root = rt.fs_root(f)
  if t.starts_with("/") && root != "" {
    // an absolute target inside the view names a path of the view
    t = "/" + memfs_trim(path.join(root, t))
  }
  memfs_put(st, full, MemNode{dir: false, data: t.bytes(), modified: Time.UNIX_EPOCH + Duration.from_nanos(rt.clock_now()), name: "", is_link: true})
}

fn memfs_symlink(f: Fs, target: Str, link: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.symlink(target, link)
  }
  let full = memfs_begin(f, link, true)?
  var st = memfs_load()
  let r = memfs_symlink_in(st, f, full, target, link)
  memfs_store(st)
  r?
}

fn memfs_read_link(f: Fs, p: Str) -> Str? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.read_link(p)
  }
  let full = memfs_begin(f, p, false)?
  let st = memfs_load()
  let n = memfs_get(st, full)
  memfs_store(st)
  match n {
    None => Err(memfs_err(1, p))
    Some(n) => {
      if memfs_link_of(n).is_empty() {
        return None
      }
      let root = rt.fs_root(f)
      if memfs_link_of(n).starts_with("/") && root != "" {
        return Some("/" + memfs_trim(memfs_link_of(n)).trim_prefix(root).trim_prefix("/"))
      }
      Some(memfs_link_of(n))
    }
  }
}

// Handles, append, copy, modes, globs, and locks (std/rt fsfile_mem.go,
// decision 0163).

fn memfs_now() -> Time { Time.UNIX_EPOCH + Duration.from_nanos(rt.clock_now()) }

fn memfs_loop_err(p: Str) -> FsErr { FsErr.Io(path: p, msg: "too many levels of symbolic links") }

// memfs_open_file is std/rt's openFile: a read handle holds the contents
// at open; a write handle writes through (created, truncated when
// truncate).
fn memfs_open_file(f: Fs, p: Str, write: Bool, truncate: Bool, excl: Bool = false) -> File ! FsErr {
  let given = memfs_begin(f, p, write)?
  var st = memfs_load()
  let r = memfs_open_in(st, f, given, p, write, truncate, excl)
  memfs_store(st)
  r?
}

fn memfs_open_in(var st: MemState, f: Fs, given: Str, p: Str, write: Bool, truncate: Bool, excl: Bool = false) -> File ! FsErr {
  if let Some(e) = memfs_failed(st, if write { 2 } else { 1 }, [given]) {
    return Err(e)
  }
  // create_new: anything at the path itself, a symbolic link too (dangling
  // or not), as O_EXCL
  if excl && memfs_get(st, given) != None {
    return Err(memfs_err(2, p))
  }
  let full = match memfs_follow(st, given) {
    Some(t) => t
    None => return Err(memfs_loop_err(p))
  }
  let n = memfs_get(st, full)
  var h = memfs_hs(st)
  h.seq += 1
  let id = h.seq
  st.hs = [h]
  if !write {
    match n {
      None => return Err(memfs_err(1, p))
      Some(node) => {
        if node.dir {
          return Err(memfs_err(5, p))
        }
        h.files.put(id, MemFile{full: full, data: node.data, off: 0, closed: false})
        st.hs = [h]
        return rt.mem_file(id, p, false)
      }
    }
  }
  if full == "" {
    return Err(memfs_err(5, p))
  }
  if let Some(node) = n {
    if node.dir {
      return Err(memfs_err(5, p))
    }
  }
  if let Some(bad) = memfs_mkdirs(st, full, false) {
    return Err(memfs_err(4, memfs_rel(f, bad)))
  }
  match n {
    None => memfs_put(st, full, MemNode{dir: false, data: b"", modified: memfs_now(), name: ""})
    Some(node) => {
      if truncate {
        memfs_put(st, full, node with {data: b"", modified: memfs_now()})
      }
    }
  }
  h.files.put(id, MemFile{full: full, data: b"", off: 0, closed: false})
  st.hs = [h]
  rt.mem_file(id, p, true)
}

fn memfs_open(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.open(p)
  }
  memfs_open_file(f, p, false, false)
}

fn memfs_create(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create(p)
  }
  memfs_open_file(f, p, true, true)
}

fn memfs_open_append(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.open_append(p)
  }
  memfs_open_file(f, p, true, false)
}

fn memfs_create_new(f: Fs, p: Str) -> File ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_new(p)
  }
  memfs_open_file(f, p, true, true, true)
}

// memfile_state is std/rt File's checks: canceled, closed, or open for
// the other direction; the open file.
fn memfile_state(st: MemState, f: File, write: Bool) -> MemFile ! FsErr {
  if rt.fs_canceled() {
    return Err(FsErr.Canceled)
  }
  let mf = memfs_hs(st).files.get(rt.mem_file_id(f)) ?? MemFile{full: "", data: b"", off: 0, closed: true}
  if mf.closed {
    return Err(FsErr.Io(path: rt.mem_file_path(f), msg: "file already closed"))
  }
  if rt.mem_file_writes(f) && !write {
    return Err(FsErr.Io(path: rt.mem_file_path(f), msg: "file is open for writing"))
  }
  if !rt.mem_file_writes(f) && write {
    return Err(FsErr.Io(path: rt.mem_file_path(f), msg: "file is open for reading"))
  }
  mf
}

fn memfile_read(f: File, max: Int) -> Bytes? ! FsErr {
  var st = memfs_load()
  let r = memfile_read_in(st, f, max)
  memfs_store(st)
  r?
}

fn memfile_read_in(var st: MemState, f: File, max: Int) -> Bytes? ! FsErr {
  var mf = memfile_state(st, f, false)?
  if max <= 0 {
    return Some(b"")
  }
  if mf.off >= mf.data.len() {
    return None
  }
  var n = mf.data.len() - mf.off
  if max < n {
    n = max
  }
  if n > 1048576 {
    n = 1048576
  }
  let b = mf.data[mf.off..mf.off + n]
  mf.off += n
  memfs_set_file(st, rt.mem_file_id(f), mf)
  Some(b)
}

fn memfile_read_line(f: File) -> Str? ! FsErr {
  var st = memfs_load()
  let r = memfile_read_line_in(st, f)
  memfs_store(st)
  r?
}

fn memfile_read_line_in(var st: MemState, f: File) -> Str? ! FsErr {
  var mf = memfile_state(st, f, false)?
  if mf.off >= mf.data.len() {
    return None
  }
  var end = mf.off
  while end < mf.data.len() && mf.data[end] != 10 {
    end += 1
  }
  if end < mf.data.len() {
    end += 1
  }
  var line = rt.cast[Bytes, Str](mf.data[mf.off..end])
  mf.off = end
  memfs_set_file(st, rt.mem_file_id(f), mf)
  line = line.trim_suffix("\n").trim_suffix("\r")
  Some(line)
}

fn memfile_write(f: File, data: Bytes) -> () ! FsErr {
  var st = memfs_load()
  let r = memfile_write_in(st, f, data)
  memfs_store(st)
  r?
}

fn memfile_write_in(var st: MemState, f: File, data: Bytes) -> () ! FsErr {
  let mf = memfile_state(st, f, true)?
  // removed since it was opened: written again (std/rt memFileH.write)
  var n = memfs_get(st, mf.full) ?? MemNode{dir: false, data: b"", modified: memfs_now(), name: ""}
  if n.dir {
    n = MemNode{dir: false, data: b"", modified: memfs_now(), name: ""}
  }
  memfs_put(st, mf.full, n with {data: n.data + data, modified: memfs_now()})
}

fn memfile_close(f: File) -> () ! FsErr {
  var st = memfs_load()
  if let Some(mf) = memfs_hs(st).files.get(rt.mem_file_id(f)) {
    memfs_set_file(st, rt.mem_file_id(f), mf with {closed: true})
  }
  memfs_store(st)
}

fn memfs_append(f: Fs, p: Str, data: Bytes) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.append(p, data)
  }
  let file = memfs_open_append(f, p)?
  // std/rt's MemFs append: the write's result is not checked
  match memfile_write(file, data) {
    _ => ()
  }
  memfile_close(file)
}

fn memfs_copy(f: Fs, from: Str, to: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.copy(from, to)
  }
  let src = memfs_begin(f, from, false)?
  var st = memfs_load()
  let r = memfs_copy_src(st, src, from)
  memfs_store(st)
  let n = r?
  memfs_write(f, to, n.data)?
  let dst = memfs_resolve(f, to) ?? ""
  var st2 = memfs_load()
  if let Some(d) = memfs_get(st2, dst) {
    memfs_put(st2, dst, d with {mode: n.mode})
  }
  memfs_store(st2)
}

fn memfs_copy_src(var st: MemState, src: Str, from: Str) -> MemNode ! FsErr {
  if let Some(e) = memfs_failed(st, 1, [src]) {
    return Err(e)
  }
  let full = match memfs_follow(st, src) {
    Some(t) => t
    None => return Err(memfs_loop_err(from))
  }
  match memfs_get(st, full) {
    None => Err(memfs_err(1, from))
    Some(n) => {
      if n.dir {
        return Err(memfs_err(5, from))
      }
      n
    }
  }
}

// memfs_perm is std/rt memMode: as set, else 0o755 for a directory and
// 0o644 for a file.
fn memfs_perm(n: MemNode) -> Int {
  if n.mode >= 0 {
    return n.mode
  }
  if n.dir { 0o755 } else { 0o644 }
}

fn memfs_mode(f: Fs, p: Str) -> Int ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.mode(p)
  }
  let given = memfs_begin(f, p, false)?
  let st = memfs_load()
  let n = memfs_get(st, memfs_follow(st, given) ?? given)
  memfs_store(st)
  match n {
    None => Err(memfs_err(1, p))
    Some(node) => memfs_perm(node)
  }
}

fn memfs_set_mode(f: Fs, p: Str, mode: Int) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.set_mode(p, mode)
  }
  let given = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_set_mode_in(st, given, p, mode)
  memfs_store(st)
  r?
}

fn memfs_set_mode_in(var st: MemState, given: Str, p: Str, mode: Int) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 2, [given]) {
    return Err(e)
  }
  let full = memfs_follow(st, given) ?? given
  match memfs_get(st, full) {
    None => Err(memfs_err(1, p))
    Some(n) => memfs_put(st, full, n with {mode: mode & 0o777})
  }
}

// A MemFs lock's record (std/rt lock with one permit): the record's lock
// word, held, and the wait list (first, last; tasks.xo wl_*). Records
// live for the test binary.
const ML_HELD = 8
const ML_WAIT = 16

fn memlock_new() -> Int {
  let a = rt.heap_large(32)
  for o in [0, 8, 16, 24] {
    rt.mem_store(a, o, 0, 8)
  }
  a
}

// memlock_take takes the record a: free only when nothing holds it and no
// one waits (try), else waiting in line (a cancellation point: false when
// the task was canceled).
fn memlock_take(a: Int, wait: Bool) -> Bool {
  pool.lock(a)
  if !wait {
    let free = rt.mem_load(a, ML_HELD, 8) == 0 && rt.mem_load(a, ML_WAIT, 8) == 0
    if free {
      rt.mem_store(a, ML_HELD, 1, 8)
    }
    pool.unlock(a)
    return free
  }
  let c = ctx.cur()
  while rt.mem_load(a, ML_HELD, 8) != 0 {
    if !tasks.wl_wait_as(c, a, a + ML_WAIT, true, 1) {
      pool.unlock(a)
      return false
    }
  }
  rt.mem_store(a, ML_HELD, 1, 8)
  pool.unlock(a)
  true
}

fn memlock_give(a: Int) {
  pool.lock(a)
  rt.mem_store(a, ML_HELD, 0, 8)
  let e = rt.mem_load(a, ML_WAIT, 8)
  if e != 0 {
    // the oldest waiter (its park is the entry's first word)
    tasks.park_signal(rt.mem_load(e, 0, 8))
  }
  pool.unlock(a)
}

// memfs_lock_file is std/rt's lockFile: the file is created if missing.
fn memfs_lock_file(f: Fs, p: Str, wait: Bool) -> FileLock? ! FsErr {
  let full = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_lock_rec(st, f, full, p)
  memfs_store(st)
  let a = r?
  if !memlock_take(a, wait) {
    if wait {
      return Err(FsErr.Canceled)
    }
    return None
  }
  var st2 = memfs_load()
  var h = memfs_hs(st2)
  h.seq += 1
  let id = h.seq
  h.lock_hs.put(id, MemLockH{rec: a, done: false})
  st2.hs = [h]
  memfs_store(st2)
  Some(rt.mem_lock(id))
}

fn memfs_lock_rec(var st: MemState, f: Fs, full: Str, p: Str) -> Int ! FsErr {
  if let Some(e) = memfs_failed(st, 2, [full]) {
    return Err(e)
  }
  match memfs_get(st, full) {
    None => {
      if let Some(bad) = memfs_mkdirs(st, full, false) {
        return Err(memfs_err(4, memfs_rel(f, bad)))
      }
      memfs_put(st, full, MemNode{dir: false, data: b"", modified: memfs_now(), name: ""})
    }
    Some(n) => {
      if n.dir {
        return Err(memfs_err(5, p))
      }
    }
  }
  let k = memfs_key(st, full)
  var h = memfs_hs(st)
  match h.locks.get(k) {
    Some(a) => a
    None => {
      let a = memlock_new()
      h.locks.put(k, a)
      st.hs = [h]
      a
    }
  }
}

fn memfs_lock(f: Fs, p: Str) -> FileLock ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.lock(p)
  }
  match memfs_lock_file(f, p, true)? {
    Some(l) => l
    None => Err(FsErr.Canceled)
  }
}

fn memfs_try_lock(f: Fs, p: Str) -> FileLock? ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.try_lock(p)
  }
  memfs_lock_file(f, p, false)
}

fn memlock_unlock(l: FileLock) {
  var st = memfs_load()
  var hs = memfs_hs(st)
  let h = hs.lock_hs.get(rt.mem_lock_id(l))
  if let Some(lh) = h {
    if !lh.done {
      hs.lock_hs.put(rt.mem_lock_id(l), lh with {done: true})
      st.hs = [hs]
    }
  }
  memfs_store(st)
  if let Some(lh) = h {
    if !lh.done {
      memlock_give(lh.rec)
    }
  }
}

// memfs_seq is fmt.Sprintf("%06d", n).
fn memfs_seq(n: Int) -> Str {
  var s = "${n}"
  while s.len() < 6 {
    s = "0" + s
  }
  s
}

fn memfs_create_temp_in(var st: MemState, f: Fs, full: Str, dir: Str, prefix: Str) -> Str ! FsErr {
  st.temp_seq += 1
  let file = memfs_trim(path.join(full, prefix + memfs_seq(st.temp_seq)))
  if let Some(e) = memfs_failed(st, 2, [full, file]) {
    return Err(e)
  }
  match memfs_get(st, full) {
    None => return Err(memfs_err(1, dir))
    Some(n) => {
      if !n.dir {
        return Err(memfs_err(4, dir))
      }
    }
  }
  memfs_put(st, file, MemNode{dir: false, data: b"", modified: Time.UNIX_EPOCH + Duration.from_nanos(rt.clock_now()), name: ""})
  memfs_rel(f, file)
}

fn memfs_create_temp(f: Fs, dir: Str, prefix: Str) -> Str ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_temp(dir, prefix)
  }
  let full = memfs_begin(f, dir, true)?
  var st = memfs_load()
  let r = memfs_create_temp_in(st, f, full, dir, prefix)
  memfs_store(st)
  r?
}

fn memfs_rename_in(var st: MemState, src: Str, dst: Str, from: Str, to: Str) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 3, [src, dst]) {
    return Err(e)
  }
  let n = match memfs_get(st, src) {
    None => return Err(memfs_err(1, from))
    Some(n) => n
  }
  let parent = path.dir(dst)
  if parent != "." {
    let ok = match memfs_get(st, parent) {
      None => false
      Some(pn) => pn.dir
    }
    if !ok {
      return Err(memfs_err(1, to))
    }
  }
  if let Some(d) = memfs_get(st, dst) {
    if d.dir && !n.dir {
      return Err(memfs_err(5, to))
    }
  }
  if !n.dir {
    let _old = st.nodes.remove(memfs_key(st, src))
    memfs_put(st, dst, n)
    return
  }
  let prefix = memfs_key(st, src)
  var moved: List[MemNode] = []
  for (k, c) in st.nodes {
    if k == prefix || k.starts_with(prefix + "/") {
      moved.push(c)
    }
  }
  for c in moved {
    let _old = st.nodes.remove(memfs_key(st, c.name))
  }
  for c in moved {
    memfs_put(st, dst + c.name.trim_prefix(src), c)
  }
}

fn memfs_rename(f: Fs, from: Str, to: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.rename(from, to)
  }
  let src = memfs_begin(f, from, true)?
  let dst = match memfs_resolve(f, to) {
    Some(d) => d
    None => return Err(memfs_err(6, to))
  }
  var st = memfs_load()
  let r = memfs_rename_in(st, src, dst, from, to)
  memfs_store(st)
  r?
}

fn memfs_remove_in(var st: MemState, full: Str, p: Str) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 4, [full]) {
    return Err(e)
  }
  let n = match memfs_get(st, full) {
    None => return Err(memfs_err(1, p))
    Some(n) => n
  }
  if full == "" {
    return Err(memfs_err(1, p))
  }
  if n.dir && memfs_children(st, full).len() > 0 {
    return Err(memfs_err(3, p))
  }
  let _old = st.nodes.remove(memfs_key(st, full))
}

fn memfs_remove(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.remove(p)
  }
  let full = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_remove_in(st, full, p)
  memfs_store(st)
  r?
}

fn memfs_remove_all_in(var st: MemState, full: Str) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 4, [full]) {
    return Err(e)
  }
  let prefix = memfs_key(st, full)
  var gone: List[Str] = []
  for (k, _n) in st.nodes {
    if k == "" {
      continue
    }
    if prefix == "" || k == prefix || k.starts_with(prefix + "/") {
      gone.push(k)
    }
  }
  for k in gone {
    let _old = st.nodes.remove(k)
  }
}

fn memfs_remove_all(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.remove_all(p)
  }
  let full = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_remove_all_in(st, full)
  memfs_store(st)
  r?
}

fn memfs_create_dir_all_in(var st: MemState, f: Fs, full: Str) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 5, [full]) {
    return Err(e)
  }
  if let Some(bad) = memfs_mkdirs(st, full, true) {
    return Err(memfs_err(4, memfs_rel(f, bad)))
  }
}

fn memfs_create_dir_all(f: Fs, p: Str) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.create_dir_all(p)
  }
  let full = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_create_dir_all_in(st, f, full)
  memfs_store(st)
  r?
}

fn memfs_set_modified_in(var st: MemState, full: Str, p: Str, t: Time) -> () ! FsErr {
  if let Some(e) = memfs_failed(st, 2, [full]) {
    return Err(e)
  }
  let n = match memfs_get(st, full) {
    None => return Err(memfs_err(1, p))
    Some(n) => n
  }
  st.nodes.put(memfs_key(st, full), n with {modified: t})
}

fn memfs_set_modified(f: Fs, p: Str, t: Time) -> () ! FsErr {
  // a user value converted to Fs (decision 0307)
  if let Some(u) = userfs.user(f) {
    return u.set_modified(p, t)
  }
  let full = memfs_begin(f, p, true)?
  var st = memfs_load()
  let r = memfs_set_modified_in(st, full, p, t)
  memfs_store(st)
  r?
}

fn memfs_fail_next(f: Fs, op: testing.FsOp, p: Str, err: FsErr) {
  var full = memfs_resolve(f, p) ?? ""
  if p.contains("*") {
    full = memfs_trim(path.join(rt.fs_root(f), p.trim_prefix("/")))
  }
  var st = memfs_load()
  st.fails.push(MemFail{op: memfs_op_tag(op), pattern: full, err: err})
  memfs_store(st)
}

fn memfs_set_case_sensitive(_f: Fs, on: Bool) {
  var st = memfs_load()
  if st.case_sensitive != on {
    let old = st.nodes
    st.case_sensitive = on
    st.nodes = {}
    for (_k, n) in old {
      st.nodes.put(memfs_key(st, n.name), n)
    }
  }
  memfs_store(st)
}

fn memfs_files(f: Fs) -> Map[Str, Bytes] {
  let st = memfs_load()
  var names: List[Str] = []
  var by_name: Map[Str, Bytes] = {}
  for (_k, n) in st.nodes {
    if !n.dir {
      names.push(n.name)
      by_name.put(n.name, if n.is_link { b"" } else { n.data })
    }
  }
  memfs_store(st)
  let root = rt.fs_root(f)
  var out: Map[Str, Bytes] = {}
  for name in names.sort() {
    if root == "" || name.starts_with(root + "/") {
      out.put(memfs_rel(f, name), by_name.get(name) ?? b"")
    }
  }
  out
}
