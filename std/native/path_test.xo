test "Go's path on its test strings and random paths" {
  var bad: List[(Str, Str, Str, Str, Str)] = []
  for (op, a, b, want) in GO_CASES {
    let got = match op {
      "clean" => clean(a)
      "dir" => dir(a)
      "base" => base(a)
      "ext" => ext(a)
      _ => join(a, b)
    }
    if got != want {
      bad.push((op, a, b, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}
