// Samples of std/path on the native backends. The full differential, on
// Go's results for every input of Go's path tests and seeded random
// paths, is internal/stdtest/testdata/corpus/path (every backend).

test "path samples" {
  expect(clean("a//b/../c/") == "a/c")
  expect(clean("") == ".")
  expect(join("a/", "/b") == "a/b")
  expect(join("", "") == "")
  expect(dir("a/b/c.txt") == "a/b")
  expect(dir("") == ".")
  expect(base("/a/b/") == "b")
  expect(base("") == ".")
  expect(ext("a/b.tar.gz") == ".gz")
  expect(ext("a/b") == "")
  let (d, f) = split("a/b/c.txt")
  expect(d == "a/b/")
  expect(f == "c.txt")
  let (rd, rf) = split("a")
  expect(rd == "" && rf == "a")
  expect(is_abs("/a") && is_abs("/"))
  expect(!is_abs("a") && !is_abs(""))
  expect(is_match("a*c", "abc")?)
  expect(is_match("[a-c]?", "b1")?)
  expect(!is_match("a*c", "a/c")?)
  expect(!is_match("?", "/")?)
  let bad = match is_match("[", "a") {
    Ok(_) => false
    Err(_) => true
  }
  expect(bad)
}
