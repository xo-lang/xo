// std/crypto on the native backends (decision 0083). std/rt/crypto.go is
// the reference; the hashes are Xo (std/native/llrt/digest.xo, decision
// 0195), crypto.equal and Ed25519 constant time Xo
// (std/native/llrt/ct.xo and ed25519.xo, decision 0222), and random
// bytes come from the Rand capability (the operating system's
// generator).
use std/base64
use std/crypto
use std/json
use native/llrt/aesgcm
use native/llrt/asn1
use native/llrt/bigmod
use native/llrt/blake2b
use native/llrt/chacha
use native/llrt/ct
use native/llrt/digest as dg
use native/llrt/ed25519
use native/llrt/hkdf as hk
use native/llrt/md5
use native/llrt/mlkem
use native/llrt/nistec
use native/llrt/rsa
use native/llrt/rsagen
use native/llrt/sha1
use native/llrt/sha256
use native/llrt/sha3
use native/llrt/x25519
use native/rt

fn sha256(data: Bytes) -> Bytes { dg.sha256(data) }

fn hmac_sha256(key: Bytes, msg: Bytes) -> Bytes { dg.hmac_sha256(key, msg) }

fn equal(a: Bytes, b: Bytes) -> Bool { ct.bytes_equal(a, b) }

fn with_data_independent_timing[T, fx: Effects](f: fn() -> T uses fx) -> T uses fx {
  // decision 0656: 0619's section around a user's f; the checker (XO0704)
  // keeps f from parking or yielding
  let old = ct.dit_on()
  let v = f()
  ct.dit_off(old)
  v
}

fn ct_byte_eq(x: Int, y: Int) -> Int { ct.mask_eq(x & 0xff, y & 0xff) & 1 }

fn ct_eq(x: Int, y: Int) -> Int { ct.mask_eq(x, y) & 1 }

fn ct_select(v: Int, x: Int, y: Int) -> Int { ct.pick(ct.mask_bit(v), x, y) }

fn ct_copy(v: Int, x: Bytes, y: Bytes, at: rt.Loc) -> Bytes {
  if x.len() != y.len() {
    rt.fault_at("crypto.ct_copy: x is ${x.len()} bytes and y ${y.len()}", at)
  }
  let m = ct.mask_bit(v)
  var w = BytesBuilder.with_capacity(x.len())
  for i in 0..x.len() {
    w.write_byte(UInt8(ct.pick(m, Int(y[i]), Int(x[i]))))
  }
  w.freeze()
}

fn ct_less_or_eq(x: Int, y: Int) -> Int { (~ct.mask_lt(y, x)) & 1 }

/// `crypto.xor(a, b)`: a word at a time, as Go's xorBytes, then bytes.
fn xor(a: Bytes, b: Bytes) -> Bytes {
  let n = a.len().min(b.len())
  var s = rt.rs_with_cap(n)
  var i = 0
  while i + 32 <= n {
    s = rt.rs_push_words(s, rt.bytes_word(a, i) ^ rt.bytes_word(b, i), rt.bytes_word(a, i + 8) ^ rt.bytes_word(b, i + 8), rt.bytes_word(a, i + 16) ^ rt.bytes_word(b, i + 16), rt.bytes_word(a, i + 24) ^ rt.bytes_word(b, i + 24), 0x8888)
    i += 32
  }
  while i + 8 <= n {
    s = rt.rs_push_word(s, rt.bytes_word(a, i) ^ rt.bytes_word(b, i), 8)
    i += 8
  }
  while i < n {
    s = rt.rs_push_byte(s, Int(a[i] ^ b[i]))
    i += 1
  }
  s.bytes()
}

fn random_bytes(r: Rand, n: Int, at: rt.Loc) -> Bytes uses rand {
  if n < 0 {
    rt.fault_at("crypto.random_bytes: negative length ${n}", at)
  }
  r.bytes(n)
}

fn token(r: Rand, n: Int = 32, at: rt.Loc) -> Str uses rand { dg.b64(random_bytes(r, n, at), true) }

fn random_text(r: Rand) -> Str uses rand {
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567".bytes()
  let src = r.bytes(26)
  var w = BytesBuilder.with_capacity(26)
  for i in 0..26 {
    w.write_byte(alphabet[Int(src[i]) % 32])
  }
  w.freeze().to_str_lossy()
}

fn hash_password_argon2id(r: Rand, password: Str, memory_kib: Int = 19456, iterations: Int = 2, parallelism: Int = 1, at: rt.Loc) -> Str uses rand {
  let ok = parallelism >= 1 && parallelism <= 255 && memory_kib >= 8 * parallelism && memory_kib <= 4194304 && iterations >= 1 && iterations <= 1000
  if !ok {
    rt.fault_at("crypto.hash_password_argon2id: need parallelism in 1..=255, memory_kib in 8 * parallelism..=4194304, iterations in 1..=1000; got memory_kib ${memory_kib}, iterations ${iterations}, parallelism ${parallelism}", at)
  }
  let salt = random_bytes(r, 16, at)
  let key = dg.argon2id(password.bytes(), salt, iterations, memory_kib, parallelism, 32)
  "$argon2id$v=19$m=${memory_kib},t=${iterations},p=${parallelism}$" + dg.b64(salt, false) + "$" + dg.b64(key, false)
}

fn hash_password(r: Rand, password: Str, iterations: Int = 600000, at: rt.Loc) -> Str uses rand {
  if iterations < 1 || iterations > 100000000 {
    rt.fault_at("crypto.hash_password: iterations must be in 1..=100000000, got ${iterations}", at)
  }
  let salt = random_bytes(r, 16, at)
  let key = dg.pbkdf2(password.bytes(), salt, iterations, 32)
  "pbkdf2-sha256$" + "${iterations}$" + dg.b64(salt, false) + "$" + dg.b64(key, false)
}

fn verify_password(password: Str, hash: Str) -> Bool { dg.verify_password(password, hash) }

fn ed25519_public_key(seed: Bytes, at: rt.Loc) -> Bytes {
  if seed.len() != 32 {
    rt.fault_at("crypto.ed25519_public_key: the seed is ${seed.len()} bytes, want 32", at)
  }
  ed25519.public_key(seed)
}

fn ed25519_sign(seed: Bytes, msg: Bytes, at: rt.Loc) -> Bytes {
  if seed.len() != 32 && seed.len() != 64 {
    rt.fault_at("crypto.ed25519_sign: the key is ${seed.len()} bytes, want 32 or 64", at)
  }
  ed25519.sign(seed, msg)
}

fn ed25519_verify(public_key: Bytes, msg: Bytes, sig: Bytes) -> Bool { ed25519.verify(public_key, msg, sig) }

/// The dom2 prefix of ed25519_sign_with's options, empty for pure
/// Ed25519, or Go's error.
fn ed25519_dom(prehashed: Bool, msg: Bytes, context: Bytes) -> Bytes ! crypto.KeyErr {
  if prehashed {
    if msg.len() != 64 {
      return Err(key_err("ed25519: bad Ed25519ph message hash length: ${msg.len()}"))
    }
    if context.len() > 255 {
      return Err(key_err("ed25519: bad Ed25519ph context length: ${context.len()}"))
    }
    return Ok(ed25519.dom2(true, context))
  }
  if context.len() == 0 {
    return Ok(b"")
  }
  if context.len() > 255 {
    return Err(key_err("ed25519: bad Ed25519ctx context length: ${context.len()}"))
  }
  Ok(ed25519.dom2(false, context))
}

fn ed25519_sign_with(seed: Bytes, msg: Bytes, prehashed: Bool, context: Bytes, at: rt.Loc) -> Bytes ! crypto.KeyErr {
  if seed.len() != 32 && seed.len() != 64 {
    rt.fault_at("crypto.ed25519_sign_with: the key is ${seed.len()} bytes, want 32 or 64", at)
  }
  let dom = ed25519_dom(prehashed, msg, context)?
  Ok(ed25519.sign_dom(seed, msg, dom))
}

fn ed25519_verify_with(public_key: Bytes, msg: Bytes, sig: Bytes, prehashed: Bool, context: Bytes) -> Bool ! crypto.KeyErr {
  let dom = ed25519_dom(prehashed, msg, context)?
  Ok(ed25519.verify_dom(public_key, msg, sig, dom))
}

// ---------------------------------------------------------------------------
// Hash, digest, hmac, and Hasher (decision 0279): the runtime's hashes
// (md5.xo, sha1.xo, sha256.xo for SHA-224 to SHA-512, sha3.xo for SHA-3
// and legacy Keccak, blake2b.xo for BLAKE2b), HMAC as
// Go's crypto/hmac builds it over each (RFC 2104: the key hashed when
// longer than the block, then the inner and outer pads).

fn hash_size(h: crypto.Hash) -> Int {
  match h {
    Md5 => 16
    Sha1 => 20
    Sha224 => 28
    Sha256 => 32
    Sha384 => 48
    Sha512 => 64
    Sha3_256 => 32
    Sha3_512 => 64
    Sha3_224 => 28
    Sha3_384 => 48
    Sha512_224 => 28
    Sha512_256 => 32
    Blake2b_256 => 32
    Blake2b_384 => 48
    Blake2b_512 => 64
    Keccak256 => 32
    Keccak512 => 64
  }
}

/// HMAC's block size: Go's h.BlockSize() (the rate for SHA-3).
fn block_of(h: crypto.Hash) -> Int {
  match h {
    Sha384 => 128
    Sha512 => 128
    Sha3_256 => 136
    Sha3_512 => 72
    Sha3_224 => 144
    Sha3_384 => 104
    Sha512_224 => 128
    Sha512_256 => 128
    Blake2b_256 => 128
    Blake2b_384 => 128
    Blake2b_512 => 128
    Keccak256 => 136
    Keccak512 => 72
    _ => 64
  }
}

enum State {
  M5(h: md5.Hasher)
  S1(h: sha1.Hasher)
  S2(h: sha256.Hasher)
  S3(s: sha3.Sponge)
  B2(b: blake2b.State)
}

struct Hasher {
  hash: crypto.Hash
  st: State
  /// The outer padded key of an HMAC; empty for a plain hash.
  opad: Bytes
  total: Int
  /// The state hasher or hmac_hasher made, for reset.
  start: State
}

fn fresh(h: crypto.Hash) -> State {
  match h {
    Md5 => State.M5(h: md5.new())
    Sha1 => State.S1(h: sha1.new())
    Sha224 => State.S2(h: sha256.new(sha256.HASH_SHA224))
    Sha256 => State.S2(h: sha256.new(sha256.HASH_SHA256))
    Sha384 => State.S2(h: sha256.new(sha256.HASH_SHA384))
    Sha512 => State.S2(h: sha256.new(sha256.HASH_SHA512))
    Sha3_256 => State.S3(s: sha3.new_sha3_256())
    Sha3_512 => State.S3(s: sha3.new_sha3_512())
    Sha3_224 => State.S3(s: sha3.new_sha3_224())
    Sha3_384 => State.S3(s: sha3.new_sha3_384())
    Sha512_224 => State.S2(h: sha256.new(sha256.HASH_SHA512_224))
    Sha512_256 => State.S2(h: sha256.new(sha256.HASH_SHA512_256))
    Blake2b_256 => State.B2(b: blake2b.new(32, b""))
    Blake2b_384 => State.B2(b: blake2b.new(48, b""))
    Blake2b_512 => State.B2(b: blake2b.new(64, b""))
    Keccak256 => State.S3(s: sha3.new_keccak256())
    Keccak512 => State.S3(s: sha3.new_keccak512())
  }
}

fn absorb(st: State, data: Bytes) -> State {
  match st {
    M5(h) => {
      var x = h
      x.write(data)
      State.M5(h: x)
    }
    S1(h) => {
      var x = h
      x.write(data)
      State.S1(h: x)
    }
    S2(h) => {
      var x = h
      x.write(data)
      State.S2(h: x)
    }
    S3(s) => {
      var x = s
      sha3.write(x, data)
      State.S3(s: x)
    }
    B2(b) => {
      var x = b
      x.write(data)
      State.B2(b: x)
    }
  }
}

fn finish(st: State) -> Bytes {
  match st {
    M5(h) => h.sum()
    S1(h) => h.sum()
    S2(h) => h.sum()
    S3(s) => {
      // sha3.sum squeezes: a copy keeps st able to absorb more
      var x = s
      sha3.sum(x)
    }
    B2(b) => b.sum()
  }
}

fn digest(h: crypto.Hash, data: Bytes) -> Bytes {
  match h {
    // one shot, no State (blake2b.sum)
    Blake2b_256 => blake2b.sum(data, 32)
    Blake2b_384 => blake2b.sum(data, 48)
    Blake2b_512 => blake2b.sum(data, 64)
    _ => finish(absorb(fresh(h), data))
  }
}

/// The key as HMAC pads it: hashed when longer than the block, then
/// XORed with the pad byte over the block.
fn padded_key(h: crypto.Hash, key: Bytes, x: Int) -> Bytes {
  let bs = block_of(h)
  let k = if key.len() > bs { digest(h, key) } else { key }
  // the pad bytes first, then the key XORed in a word at a time (a byte
  // at a time cost more than the hash's compressions in std/otp)
  let pad = if x == 0x36 { IPAD } else { OPAD }
  var out = BytesBuilder.with_capacity(bs)
  out.write(pad[0..bs])
  let word = x * 0x0101010101010101
  var i = 0
  while i + 8 <= k.len() {
    out.put_le(i, rt.bytes_word(k, i) ^ word, 8)
    i += 8
  }
  while i < k.len() {
    out.put_le(i, Int(k[i]) ^ x, 1)
    i += 1
  }
  out.freeze()
}

/// HMAC's inner and outer pad bytes over the largest block (SHA3-224's 144;
/// BLAKE2b's is 128, legacy Keccak's 136 and 72).
const IPAD: Bytes = b"\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36\x36"
const OPAD: Bytes = b"\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c\x5c"

fn hasher(h: crypto.Hash) -> Hasher {
  let st = fresh(h)
  Hasher{hash: h, st: st, opad: b"", total: 0, start: st}
}

fn hmac_hasher(h: crypto.Hash, key: Bytes) -> Hasher {
  let st = absorb(fresh(h), padded_key(h, key, 0x36))
  Hasher{hash: h, st: st, opad: padded_key(h, key, 0x5c), total: 0, start: st}
}

fn (var x: Hasher) write(data: Bytes) {
  x.st = absorb(x.st, data)
  x.total += data.len()
}

fn (x: Hasher) sum() -> Bytes {
  let inner = finish(x.st)
  if x.opad.is_empty() {
    return inner
  }
  finish(absorb(absorb(fresh(x.hash), x.opad), inner))
}

fn (x: Hasher) written() -> Int { x.total }

fn (x: Hasher) block_size() -> Int { block_of(x.hash) }

fn (x: Hasher) size() -> Int {
  match x.st {
    B2(b) => b.size()
    M5(_) | S1(_) | S2(_) | S3(_) => hash_size(x.hash)
  }
}

/// Go's blake2b.New(size, key): a keyed BLAKE2b of `size` bytes; its Hash
/// is the BLAKE2b of that size, or Blake2b_512 for another size.
fn blake2b_hasher(size: Int, key: Bytes = b"") -> Hasher ! crypto.KeyErr {
  if size < 1 || size > blake2b.SIZE {
    return Err(key_err("blake2b: invalid hash size"))
  }
  if key.len() > blake2b.SIZE {
    return Err(key_err("blake2b: invalid key size"))
  }
  let h = if size == 32 { crypto.Hash.Blake2b_256 } else if size == 48 { crypto.Hash.Blake2b_384 } else { crypto.Hash.Blake2b_512 }
  let st = State.B2(b: blake2b.new(size, key))
  Ok(Hasher{hash: h, st: st, opad: b"", total: 0, start: st})
}

fn (var x: Hasher) reset() {
  x.st = x.start
  x.total = 0
}

fn hasherr_display(e: crypto.HashErr) -> Str { e.msg }

fn hash_err(msg: Str) -> crypto.HashErr { crypto.HashErr{msg: msg} }

/// Go's magic of a Merkle-Damgard hash's state, and its package for the
/// errors.
fn md_magic(h: crypto.Hash) -> (Bytes, Str) {
  match h {
    Md5 => (b"md5\x01", "crypto/md5")
    Sha1 => (b"sha\x01", "crypto/sha1")
    Sha224 => (b"sha\x02", "crypto/sha256")
    Sha256 => (b"sha\x03", "crypto/sha256")
    Sha384 => (b"sha\x04", "crypto/sha512")
    Sha512_224 => (b"sha\x05", "crypto/sha512")
    Sha512_256 => (b"sha\x06", "crypto/sha512")
    _ => (b"sha\x07", "crypto/sha512")
  }
}

/// Go's state of words, held bytes and length: the magic, the words big
/// endian (4 bytes each, 8 for SHA-512's), the held bytes zero padded to
/// the block, the length as 8 bytes big endian.
fn md_bin(h: crypto.Hash, st: List[Int], held: Bytes, total: Int) -> Bytes {
  let bs = block_of(h)
  let wb = if bs == 128 { 8 } else { 4 }
  let (magic, _) = md_magic(h)
  var b = BytesBuilder.with_capacity(4 + wb * st.len() + bs + 8)
  b.write(magic)
  for w in st {
    b.write_be(w, wb)
  }
  b.write(held)
  for _ in held.len()..bs {
    b.write_byte(0)
  }
  b.write_be(total, 8)
  b.freeze()
}

fn be_at(b: Bytes, i: Int, n: Int) -> Int {
  var v = 0
  for j in 0..n {
    v = v.wrapping_shl(8) | Int(b[i + j])
  }
  v
}

/// Go's UnmarshalBinary of a Merkle-Damgard state of `words` words: the
/// words, the held bytes and the length, or Go's error.
fn md_parts(h: crypto.Hash, words: Int, b: Bytes) -> (List[Int], Bytes, Int) ! Str {
  let bs = block_of(h)
  let wb = if bs == 128 { 8 } else { 4 }
  let (magic, pkg) = md_magic(h)
  if b.len() < 4 || b[0..4] != magic {
    return Err("${pkg}: invalid hash state identifier")
  }
  if b.len() != 4 + wb * words + bs + 8 {
    return Err("${pkg}: invalid hash state size")
  }
  var st: List[Int] = []
  for i in 0..words {
    st.push(be_at(b, 4 + wb * i, wb))
  }
  let at = 4 + wb * words
  let total = be_at(b, at + bs, 8)
  Ok((st, b[at..at + (total & (bs - 1))], total))
}

fn state_bin(h: crypto.Hash, st: State) -> Bytes {
  match st {
    M5(x) => {
      let (w, held, total) = x.parts()
      md_bin(h, w, held, total)
    }
    S1(x) => {
      let (w, held, total) = x.parts()
      md_bin(h, w, held, total)
    }
    S2(x) => {
      let (w, held, total) = x.parts()
      md_bin(h, w, held, total)
    }
    S3(s) => sha3.marshal(s)
    B2(d) => blake2b.marshal(d)
  }
}

/// The state of Go's binary state b for h, restored into tmpl (h's fresh
/// state, or a keyed BLAKE2b's), and its length (0 for SHA-3 and Keccak,
/// whose state keeps none; BLAKE2b's counter and held bytes).
fn state_of(h: crypto.Hash, tmpl: State, b: Bytes) -> (State, Int) ! Str {
  match tmpl {
    M5(_) => {
      let (w, held, total) = md_parts(h, 4, b)?
      Ok((State.M5(h: md5.from_parts(w, held, total)), total))
    }
    S1(_) => {
      let (w, held, total) = md_parts(h, 5, b)?
      Ok((State.S1(h: sha1.from_parts(w, held, total)), total))
    }
    S2(x) => {
      let (w, held, total) = md_parts(h, 8, b)?
      Ok((State.S2(h: sha256.from_parts(x.hash, w, held, total)), total))
    }
    S3(s) => Ok((State.S3(s: sha3.unmarshal(s, b)?), 0))
    B2(d) => {
      let x = blake2b.unmarshal(d, b)?
      Ok((State.B2(b: x), x.written()))
    }
  }
}

/// Whether st is a keyed BLAKE2b (Go's MarshalBinary refuses a MAC).
fn keyed_b2(st: State) -> Bool {
  match st {
    B2(b) => b.keyed()
    M5(_) | S1(_) | S2(_) | S3(_) => false
  }
}

fn (x: Hasher) marshal_binary() -> Bytes ! crypto.HashErr {
  if !x.opad.is_empty() {
    return Err(hash_err("crypto: an HMAC Hasher has no binary state"))
  }
  if keyed_b2(x.st) {
    return Err(hash_err("crypto/blake2b: cannot marshal MACs"))
  }
  Ok(state_bin(x.hash, x.st))
}

fn (x: Hasher) unmarshal_binary(state: Bytes) -> Hasher ! crypto.HashErr {
  if !x.opad.is_empty() {
    return Err(hash_err("crypto: an HMAC Hasher has no binary state"))
  }
  match state_of(x.hash, x.start, state) {
    Ok((st, total)) => Ok(Hasher{hash: x.hash, st: st, opad: b"", total: total, start: x.start})
    Err(m) => Err(hash_err(m))
  }
}

/// SHAKE and cSHAKE: the sponge, and the sponge as made (after cSHAKE's
/// init block) for reset.
struct Shake {
  s: sha3.Sponge
  start: sha3.Sponge
  /// cSHAKE's init block, empty for SHAKE (Go's initBlock).
  init: Bytes
}

fn shake_of(sp: sha3.Sponge) -> Shake { Shake{s: sp, start: sp, init: b""} }

fn cshake_of(rate: Int, n: Bytes, s: Bytes) -> Shake {
  let sp = sha3.new_cshake(rate, n, s)
  Shake{s: sp, start: sp, init: sha3.cshake_init(n, s)}
}
fn shake128() -> Shake { shake_of(sha3.new_shake128()) }
fn shake256() -> Shake { shake_of(sha3.new_shake256()) }
fn cshake128(n: Bytes, s: Bytes) -> Shake { cshake_of(168, n, s) }
fn cshake256(n: Bytes, s: Bytes) -> Shake { cshake_of(136, n, s) }

fn (var x: Shake) write(data: Bytes) {
  if sha3.squeezing(x.s) {
    fault("sha3: Write after Read")
  }
  sha3.write(x.s, data)
}

fn (var x: Shake) read(n: Int) -> Bytes {
  if n < 0 {
    fault("sha3: a read of ${n} bytes")
  }
  sha3.read(x.s, n)
}

fn (var x: Shake) reset() { x.s = x.start }
fn (x: Shake) block_size() -> Int { sha3.rate(x.s) }

fn (x: Shake) marshal_binary() -> Bytes { sha3.marshal(x.s) + x.init }

fn (x: Shake) unmarshal_binary(state: Bytes) -> Shake ! crypto.HashErr {
  if state.len() < 207 {
    return Err(hash_err("sha3: invalid hash state"))
  }
  match sha3.unmarshal(x.s, state[0..207]) {
    Ok(s) => {
      let init = state[207..state.len()]
      Ok(Shake{s: s, start: sha3.restart(x.s, init), init: init})
    }
    Err(m) => Err(hash_err(m))
  }
}
fn sum_shake128(data: Bytes, n: Int) -> Bytes { sha3.shake128(data, n) }
fn sum_shake256(data: Bytes, n: Int) -> Bytes { sha3.shake256(data, n) }

/// BLAKE2Xb (Go's blake2b XOF): llrt blake2b.xo's Xof.
struct Blake2bXof {
  x: blake2b.Xof
}

/// Go's NewXOF: the key's check, then the length's (Go's
/// OutputLengthUnknown, 0, an unknown length; Go's uint32 magic for it,
/// and anything outside uint32, too large).
fn blake2b_xof(size: Int, key: Bytes = b"") -> Blake2bXof ! crypto.KeyErr {
  if key.len() > blake2b.SIZE {
    return Err(key_err("blake2b: invalid key size"))
  }
  if size < 0 || size >= blake2b.XOF_UNKNOWN {
    return Err(key_err("blake2b: XOF length too large"))
  }
  Ok(Blake2bXof{x: blake2b.new_xof(if size == 0 { blake2b.XOF_UNKNOWN } else { size }, key)})
}

fn (var x: Blake2bXof) write(data: Bytes) {
  if x.x.reading() {
    fault("blake2b: write to XOF after read")
  }
  var v = x.x
  v.write(data)
  x.x = v
}

fn (var x: Blake2bXof) read(n: Int) -> Bytes ! crypto.KeyErr {
  if n < 0 {
    fault("blake2b: a read of ${n} bytes")
  }
  var v = x.x
  let got = v.read(n)
  x.x = v
  match got {
    Some(b) => Ok(b)
    None => Err(key_err("EOF"))
  }
}

fn (var x: Blake2bXof) reset() {
  var v = x.x
  v.reset()
  x.x = v
}

fn hmac(h: crypto.Hash, key: Bytes, msg: Bytes) -> Bytes {
  if h == crypto.Hash.Sha256 {
    // digest.xo's one shot: no Hasher, no padded key copies, the two
    // pad blocks hashed straight into word states (otp's HMAC of an
    // 8 byte counter was setup, 11 percent compress)
    return dg.hmac_sha256(key, msg)
  }
  var x = hmac_hasher(h, key)
  x.write(msg)
  x.sum()
}

// ---------------------------------------------------------------------------
// AEAD and HKDF (std.md 11): the TLS stack's AES-GCM (aesgcm.xo's Gcm, its
// key schedule and GHASH table made once a key) and ChaCha20-Poly1305
// (chacha.xo), and HKDF over this file's HMAC for every Hash.

/// Go's cipher error text, the same for every check that fails.
const AEAD_FAIL = "cipher: message authentication failed"

fn aead_nonce_size(a: crypto.Aead) -> Int {
  match a {
    Aes128CbcHmacSha256 => 16
    XChaCha20Poly1305 => 24
    _ => 12
  }
}
fn aead_overhead(a: crypto.Aead) -> Int { if a == crypto.Aead.Aes128CbcHmacSha256 { 32 } else { 16 } }
fn aeaderr_display(e: crypto.AeadErr) -> Str { e.msg }

/// The key: AES-GCM's ready Gcm, or (X)ChaCha20-Poly1305's 32 bytes. Never
/// displayed or encoded (no Display; the declaration has none).
struct AeadKey {
  which: crypto.Aead
  /// An AES-GCM key's nonce and tag sizes (12 and 16 but for the
  /// aes_gcm_key_with_* keys)
  ns: Int = 12
  ts: Int = 16
  gcm: aesgcm.Gcm?
  key: Bytes
  /// Aes128CbcHmacSha256: the AES-128 key schedule (key is the MAC key)
  cbc: aesgcm.Cipher?
}

fn aead_key(alg: crypto.Aead, key: Bytes) -> AeadKey ! crypto.AeadErr {
  match alg {
    AesGcm => {
      if !(key.len() is 16 | 24 | 32) {
        return Err(crypto.AeadErr{msg: "crypto/aes: invalid key size ${key.len()}"})
      }
      Ok(AeadKey{which: alg, gcm: Some(aesgcm.new_gcm(key)), key: b"", cbc: None})
    }
    ChaCha20Poly1305 | XChaCha20Poly1305 => {
      if key.len() != 32 {
        return Err(crypto.AeadErr{msg: "chacha20poly1305: bad key length"})
      }
      Ok(AeadKey{which: alg, gcm: None, key: key, cbc: None})
    }
    Aes128CbcHmacSha256 => {
      if key.len() != 32 {
        return Err(crypto.AeadErr{msg: "crypto: AES-128-CBC-HMAC-SHA-256 wants a 32 byte key, got ${key.len()}"})
      }
      Ok(AeadKey{which: alg, gcm: None, key: key[0..16], cbc: Some(aesgcm.new(key[16..32]))})
    }
  }
}

/// HMAC-SHA-256(aad || iv || ct || AL)[0..16], AL the aad's bit length as
/// a big endian 64 bit integer (RFC 7518 5.2.2.1).
fn cbc_tag(mac_key: Bytes, iv: Bytes, ct: Bytes, aad: Bytes) -> Bytes {
  var m = BytesBuilder.with_capacity(aad.len() + 16 + ct.len() + 8)
  m.write(aad)
  m.write(iv)
  m.write(ct)
  let bits = aad.len() * 8
  var s = 56
  while s >= 0 {
    m.write_byte(UInt8((bits >> s) & 255))
    s -= 8
  }
  hmac(crypto.Hash.Sha256, mac_key, m.freeze())[0..16]
}

fn cbc_seal(c: aesgcm.Cipher, mac_key: Bytes, iv: Bytes, pt: Bytes, aad: Bytes) -> Bytes {
  let pad = 16 - pt.len() % 16
  var b = BytesBuilder.with_capacity(pt.len() + pad + 16)
  b.write(pt)
  for _ in 0..pad {
    b.write_byte(UInt8(pad))
  }
  let ct = c.cbc_encrypt(iv, b.freeze())
  var out = BytesBuilder.with_capacity(ct.len() + 16)
  out.write(ct)
  out.write(cbc_tag(mac_key, iv, ct, aad))
  out.freeze()
}

fn cbc_open(c: aesgcm.Cipher, mac_key: Bytes, iv: Bytes, sealed: Bytes, aad: Bytes) -> Bytes? {
  let n = sealed.len() - 16
  if n < 16 || n % 16 != 0 {
    return None
  }
  let ct = sealed[0..n]
  if !equal(cbc_tag(mac_key, iv, ct, aad), sealed[n..sealed.len()]) {
    return None
  }
  let pt = c.cbc_decrypt(iv, ct)
  let pad = Int(pt[n - 1])
  if pad < 1 || pad > 16 {
    return None
  }
  for j in n - pad..n {
    if Int(pt[j]) != pad {
      return None
    }
  }
  Some(pt[0..n - pad])
}

fn (k: AeadKey) alg() -> crypto.Aead { k.which }

fn (k: AeadKey) nonce_size() -> Int { if k.which == crypto.Aead.AesGcm { k.ns } else { aead_nonce_size(k.which) } }
fn (k: AeadKey) overhead() -> Int { if k.which == crypto.Aead.AesGcm { k.ts } else { aead_overhead(k.which) } }

/// Go's cipher.newGCM checks (the tag size, then the nonce's), after the
/// key's.
fn aes_gcm_sized(key: Bytes, ns: Int, ts: Int) -> AeadKey ! crypto.AeadErr {
  if !(key.len() is 16 | 24 | 32) {
    return Err(crypto.AeadErr{msg: "crypto/aes: invalid key size ${key.len()}"})
  }
  if ts < 12 || ts > 16 {
    return Err(crypto.AeadErr{msg: "cipher: incorrect tag size given to GCM"})
  }
  if ns <= 0 {
    return Err(crypto.AeadErr{msg: "cipher: the nonce can't have zero length"})
  }
  Ok(AeadKey{which: crypto.Aead.AesGcm, ns: ns, ts: ts, gcm: Some(aesgcm.new_gcm(key)), key: b"", cbc: None})
}

fn aes_gcm_key_with_nonce_size(key: Bytes, size: Int) -> AeadKey ! crypto.AeadErr { aes_gcm_sized(key, size, 16) }
fn aes_gcm_key_with_tag_size(key: Bytes, size: Int) -> AeadKey ! crypto.AeadErr { aes_gcm_sized(key, 12, size) }

/// The shortest sealed message open reads: the tag.
fn min_sealed(k: AeadKey) -> Int { if k.which == crypto.Aead.AesGcm { k.ts } else { 16 } }

/// The ChaCha20-Poly1305 key and 12 byte nonce of a message under k:
/// XChaCha20-Poly1305's HChaCha20 subkey of the nonce's first 16 bytes,
/// and 4 zero bytes then its last 8 (x/crypto's xchacha20poly1305), else
/// k's key and the nonce.
fn chacha_key_nonce(k: AeadKey, nonce: Bytes) -> (Bytes, Bytes) {
  if k.which != crypto.Aead.XChaCha20Poly1305 {
    return (k.key, nonce)
  }
  var n = BytesBuilder.with_capacity(12)
  n.write(b"\x00\x00\x00\x00")
  n.write(nonce[16..24])
  (chacha.hchacha20(k.key, nonce[0..16]), n.freeze())
}

/// Whether the key's sizes are the ones the fast GCM path takes.
fn plain_sizes(k: AeadKey) -> Bool { k.ns == 12 && k.ts == 16 }

fn (k: AeadKey) seal(nonce: Bytes, plaintext: Bytes, aad: Bytes = b"") -> Bytes {
  let want = k.nonce_size()
  if nonce.len() != want {
    fault("crypto: AEAD nonce of ${nonce.len()} bytes, want ${want}")
  }
  match k.cbc {
    Some(c) => return cbc_seal(c, k.key, nonce, plaintext, aad)
    None => {}
  }
  match k.gcm {
    Some(g) => if plain_sizes(k) { g.seal(nonce, plaintext, aad) } else { g.seal_any(nonce, plaintext, aad, k.ts) }
    None => {
      let (key, n) = chacha_key_nonce(k, nonce)
      chacha.seal(key, n, plaintext, aad)
    }
  }
}

fn (k: AeadKey) open(nonce: Bytes, sealed: Bytes, aad: Bytes = b"") -> Bytes ! crypto.AeadErr {
  let want = k.nonce_size()
  if nonce.len() != want {
    fault("crypto: AEAD nonce of ${nonce.len()} bytes, want ${want}")
  }
  // the tag at least (a CBC message is checked whole by cbc_open)
  if sealed.len() < min_sealed(k) {
    return Err(crypto.AeadErr{msg: AEAD_FAIL})
  }
  match k.cbc {
    Some(c) => {
      return match cbc_open(c, k.key, nonce, sealed, aad) {
        Some(pt) => Ok(pt)
        None => Err(crypto.AeadErr{msg: AEAD_FAIL})
      }
    }
    None => {}
  }
  let got = match k.gcm {
    Some(g) => if plain_sizes(k) { g.open(nonce, sealed, aad) } else { g.open_any(nonce, sealed, aad, k.ts) }
    None => {
      let (key, n) = chacha_key_nonce(k, nonce)
      chacha.open(key, n, sealed, aad)
    }
  }
  match got {
    Some(pt) => Ok(pt)
    None => Err(crypto.AeadErr{msg: AEAD_FAIL})
  }
}

fn (k: AeadKey) seal_random(r: Rand, plaintext: Bytes, aad: Bytes = b"") -> Bytes uses rand {
  let nn = k.nonce_size()
  let nonce = r.bytes(nn)
  var b = BytesBuilder.with_capacity(nn + plaintext.len() + 32)
  b.write(nonce)
  b.write(k.seal(nonce, plaintext, aad))
  b.freeze()
}

fn (k: AeadKey) open_random(sealed: Bytes, aad: Bytes = b"") -> Bytes ! crypto.AeadErr {
  let nn = k.nonce_size()
  if sealed.len() < nn + min_sealed(k) {
    return Err(crypto.AeadErr{msg: AEAD_FAIL})
  }
  k.open(sealed[0..nn], sealed[nn..sealed.len()], aad)
}

/// The TLS stack's hash number for SHA-2 (its HKDF's fast path), else -1.
fn sha2_of(h: crypto.Hash) -> Int {
  match h {
    Sha224 => sha256.HASH_SHA224
    Sha256 => sha256.HASH_SHA256
    Sha384 => sha256.HASH_SHA384
    Sha512 => sha256.HASH_SHA512
    _ => -1
  }
}

fn pbkdf2(h: crypto.Hash, password: Bytes, salt: Bytes, iterations: Int, key_len: Int) -> Bytes ! crypto.KeyErr {
  if key_len <= 0 {
    return Err(key_err("pkbdf2: keyLength must be larger than 0"))
  }
  let hl = hash_size(h)
  if key_len.wrapping_add(hl) < key_len || (key_len + hl - 1) / hl > 4294967295 {
    return Err(key_err("pbkdf2: keyLength too long"))
  }
  if h == crypto.Hash.Sha256 {
    // the hash_password path: HMAC-SHA-256 on word states
    return Ok(dg.pbkdf2(password, salt, iterations, key_len))
  }
  // the keyed state made once, copied for each block and round
  let base = hmac_hasher(h, password)
  var out = BytesBuilder.with_capacity(key_len + hl)
  var block = 1
  while out.len() < key_len {
    var x = base
    x.write(salt)
    var be = BytesBuilder.with_capacity(4)
    be.write_be(block, 4)
    x.write(be.freeze())
    var u = x.sum()
    var t = u
    var i = 1
    while i < iterations {
      var y = base
      y.write(u)
      u = y.sum()
      t = crypto.xor(t, u)
      i += 1
    }
    out.write(t)
    block += 1
  }
  Ok(out.freeze()[0..key_len])
}

fn hkdf_extract(h: crypto.Hash, secret: Bytes, salt: Bytes = b"") -> Bytes {
  let s2 = sha2_of(h)
  if s2 >= 0 {
    // the TLS key schedule's HKDF (llrt hkdf.xo)
    return hk.extract(s2, salt, secret)
  }
  if salt.len() > 0 {
    return hmac(h, salt, secret)
  }
  var z = BytesBuilder.with_capacity(hash_size(h))
  for _ in 0..hash_size(h) {
    z.write_byte(0)
  }
  hmac(h, z.freeze(), secret)
}

fn hkdf_expand(h: crypto.Hash, prk: Bytes, info: Bytes, n: Int) -> Bytes {
  let size = hash_size(h)
  if n < 0 || n > 255 * size {
    fault("crypto: hkdf_expand of ${n} bytes, at most ${255 * size} for this hash")
  }
  let s2 = sha2_of(h)
  if s2 >= 0 {
    return hk.expand(s2, prk, info, n)
  }
  // the keyed HMAC state made once, copied for each block (a Hasher is a value)
  let keyed = hmac_hasher(h, prk)
  var out = BytesBuilder.with_capacity(n)
  var t = b""
  var i = 1
  while out.len() < n {
    var x = keyed
    x.write(t)
    x.write(info)
    var c = BytesBuilder.with_capacity(1)
    c.write_byte(UInt8(i))
    x.write(c.freeze())
    t = x.sum()
    let k = if n - out.len() < t.len() { n - out.len() } else { t.len() }
    out.write(t[0..k])
    i += 1
  }
  out.freeze()
}

fn hkdf(h: crypto.Hash, secret: Bytes, salt: Bytes, info: Bytes, n: Int) -> Bytes {
  hkdf_expand(h, hkdf_extract(h, secret, salt), info, n)
}

// ---------------------------------------------------------------------------
// PEM (encoding/pem of go1.26, ported with the same results; decision 0285)

fn keyerr_display(e: crypto.KeyErr) -> Str { e.msg }

/// getLine: the line without its `\n` (and a `\r` before it), right
/// trimmed of spaces and tabs; the rest; the bytes consumed.
fn pem_line(b: Bytes, at: Int) -> (Bytes, Int, Int) {
  var i = at
  while i < b.len() && b[i] != 10 {
    i += 1
  }
  var j = i
  if i < b.len() {
    j = i + 1
    if i > at && b[i - 1] == 13 {
      i -= 1
    }
  }
  while i > at && (b[i - 1] == 32 || b[i - 1] == 9) {
    i -= 1
  }
  (b[at..i], j, j - at)
}

fn pem_index(b: Bytes, from: Int, to: Int, p: Bytes) -> Int {
  var i = from
  while i + p.len() <= to {
    var ok = true
    for k in 0..p.len() {
      if b[i + k] != p[k] {
        ok = false
        break
      }
    }
    if ok {
      return i
    }
    i += 1
  }
  -1
}

fn pem_last_index(b: Bytes, from: Int, to: Int, p: Bytes) -> Int {
  var i = to - p.len()
  while i >= from {
    var ok = true
    for k in 0..p.len() {
      if b[i + k] != p[k] {
        ok = false
        break
      }
    }
    if ok {
      return i
    }
    i -= 1
  }
  -1
}

fn trim_space_bytes(b: Bytes) -> Bytes {
  var s = 0
  var e = b.len()
  while s < e && (b[s] == 32 || b[s] == 9 || b[s] == 10 || b[s] == 13 || b[s] == 11 || b[s] == 12) {
    s += 1
  }
  while e > s && (b[e - 1] == 32 || b[e - 1] == 9 || b[e - 1] == 10 || b[e - 1] == 13 || b[e - 1] == 11 || b[e - 1] == 12) {
    e -= 1
  }
  b[s..e]
}

fn lossy_text(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = StrBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write("${r}")
    i += n
  }
  out.freeze()
}

/// pem.Decode from offset `at` of data: the block and the offset of the
/// rest, or None (no more blocks).
fn pem_decode_one(data: Bytes, at: Int) -> (crypto.PemBlock, Int)? {
  let start = "\n-----BEGIN ".bytes()
  let end = "\n-----END ".bytes()
  let eol = "-----".bytes()
  var rest = at
  var end_trailer = 0
  while {
    if end_trailer < 0 || end_trailer > data.len() - rest {
      return None
    }
    rest += end_trailer
    let ei = pem_index(data, rest, data.len(), end)
    if ei < 0 {
      return None
    }
    var end_index = ei - rest
    end_trailer = end_index + end.len()
    let bi0 = pem_last_index(data, rest, rest + end_index, start[1..])
    if bi0 < 0 || (bi0 > rest && data[bi0 - 1] != 10) {
      continue
    }
    let begin_index = bi0 - rest
    rest += begin_index + start.len() - 1
    end_index -= begin_index + start.len() - 1
    end_trailer -= begin_index + start.len() - 1
    let (type_line0, next, consumed) = pem_line(data, rest)
    rest = next
    end_index -= consumed
    end_trailer -= consumed
    if !type_line0.ends_with(eol) {
      continue
    }
    let type_line = type_line0[0..type_line0.len() - eol.len()]
    var headers: Map[Str, Str] = {}
    var eof = false
    while {
      if rest >= data.len() {
        eof = true
        break
      }
      let (line, nx, c) = pem_line(data, rest)
      let colon = pem_index(line, 0, line.len(), b":")
      if colon < 0 {
        break
      }
      headers.put(lossy_text(trim_space_bytes(line[0..colon])), lossy_text(trim_space_bytes(line[colon + 1..])))
      rest = nx
      end_index -= c
      end_trailer -= c
    }
    if eof {
      return None
    }
    if !headers.is_empty() && end_index < 0 {
      continue
    }
    if end_trailer < 0 || rest + end_trailer > data.len() {
      continue
    }
    let et = rest + end_trailer
    let et_len = type_line.len() + eol.len()
    if data.len() - et < et_len {
      continue
    }
    let trailer = data[et..et + et_len]
    if !trailer.starts_with(type_line) || !trailer.ends_with(eol) {
      continue
    }
    let (after, _, _) = pem_line(data, et + et_len)
    if !after.is_empty() {
      continue
    }
    var bytes = b""
    if end_index > 0 {
      var b64 = BytesBuilder.with_capacity(end_index)
      for c in data[rest..rest + end_index] {
        if c != 32 && c != 9 {
          b64.write_byte(c)
        }
      }
      // the base64 text is ASCII when it decodes; other bytes fail
      match base64.decode(lossy_text(b64.freeze())) {
        Ok(b) => bytes = b
        Err(_) => continue
      }
    }
    let (_, after_end, _) = pem_line(data, rest + end_index + end.len() - 1)
    return Some((crypto.PemBlock{kind: lossy_text(type_line), headers: headers, bytes: bytes}, after_end))
  }
  None
}

fn pem_decode(text: Str) -> List[crypto.PemBlock] {
  let data = text.bytes()
  var out: List[crypto.PemBlock] = []
  var at = 0
  while let Some((b, next)) = pem_decode_one(data, at) {
    out.push(b)
    at = next
  }
  out
}

fn pem_encode(b: crypto.PemBlock) -> Str ! crypto.KeyErr {
  for k in b.headers.keys() {
    if k.contains(":") {
      return Err(crypto.KeyErr{msg: "pem: cannot encode a header key that contains a colon"})
    }
  }
  var out = StrBuilder.new()
  out.write("-----BEGIN ${b.kind}-----\n")
  if !b.headers.is_empty() {
    if let Some(v) = b.headers.get("Proc-Type") {
      out.write("Proc-Type: ${v}\n")
    }
    for k in b.headers.keys().sort() {
      if k != "Proc-Type" {
        out.write("${k}: ${b.headers.get(k) ?? ""}\n")
      }
    }
    out.write("\n")
  }
  let enc = base64.encode(b.bytes)
  var i = 0
  while i < enc.len() {
    let j = if i + 64 < enc.len() { i + 64 } else { enc.len() }
    out.write(enc[i..j])
    out.write("\n")
    i = j
  }
  out.write("-----END ${b.kind}-----\n")
  out.freeze()
}

// ---------------------------------------------------------------------------
// Public keys (crypto/x509 ParsePKIXPublicKey, ParsePKCS1PublicKey, and
// MarshalPKIXPublicKey of go1.26; decision 0285)

const OID_RSA: Str = "1.2.840.113549.1.1.1"
const OID_EC: Str = "1.2.840.10045.2.1"
const OID_ED25519: Str = "1.3.101.112"

/// A public key: RSA's modulus and exponent, or an elliptic curve point
/// (uncompressed) or an Ed25519 key in `key`.
struct PublicKey {
  kind: crypto.KeyAlg
  n: Bytes
  e: Int
  key: Bytes
}

fn (k: PublicKey) alg() -> crypto.KeyAlg { k.kind }

fn key_err(msg: Str) -> crypto.KeyErr { crypto.KeyErr{msg: msg} }

/// An INTEGER's sign and magnitude as cryptobyte's ReadASN1Integer reads
/// it: None unless t is a minimal INTEGER; (sign, magnitude) with sign -1,
/// 0, or 1.
fn big_int(b: Bytes, t: asn1.Tlv) -> (Int, Bytes)? {
  if t.tag != asn1.INTEGER || t.hi == t.lo {
    return None
  }
  if t.hi - t.lo > 1 {
    let a = Int(b[t.lo])
    let c = Int(b[t.lo + 1])
    if (a == 0 && c < 128) || (a == 255 && c >= 128) {
      return None
    }
  }
  if Int(b[t.lo]) >= 128 {
    return Some((-1, b""))
  }
  var lo = t.lo
  while lo < t.hi - 1 && b[lo] == 0 {
    lo += 1
  }
  if lo == t.hi - 1 && b[lo] == 0 {
    return Some((0, b""))
  }
  Some((1, b[lo..t.hi]))
}

/// The curve of a named curve OID.
fn curve_of(oid: Str) -> crypto.KeyAlg? {
  match oid {
    "1.3.132.0.33" => Some(crypto.KeyAlg.EcdsaP224)
    "1.2.840.10045.3.1.7" => Some(crypto.KeyAlg.EcdsaP256)
    "1.3.132.0.34" => Some(crypto.KeyAlg.EcdsaP384)
    "1.3.132.0.35" => Some(crypto.KeyAlg.EcdsaP521)
    _ => None
  }
}

fn nist_curve(a: crypto.KeyAlg) -> Int {
  match a {
    EcdsaP224 => nistec.P224
    EcdsaP384 => nistec.P384
    EcdsaP521 => nistec.P521
    _ => nistec.P256
  }
}

fn curve_oid(a: crypto.KeyAlg) -> Str {
  match a {
    EcdsaP224 => "1.3.132.0.33"
    EcdsaP384 => "1.3.132.0.34"
    EcdsaP521 => "1.3.132.0.35"
    _ => "1.2.840.10045.3.1.7"
  }
}

/// nistec's text for a coordinate at or above p: P-256's assembly field
/// on amd64 and arm64 (p256_asm.go, every Xo target) says `invalid P256
/// element encoding`; the other curves' fiat fields `invalid P384Element
/// encoding`.
fn element_err(name: Str) -> Str {
  if name == "P256" {
    return "invalid P256 element encoding"
  }
  "invalid ${name}Element encoding"
}

fn curve_name(a: crypto.KeyAlg) -> Str {
  match a {
    EcdsaP224 => "P224"
    EcdsaP384 => "P384"
    EcdsaP521 => "P521"
    _ => "P256"
  }
}

/// A SubjectPublicKeyInfo's parts as encoding/asn1 unmarshals them (the
/// fields in order; bytes after the last field of a SEQUENCE ignored):
/// the algorithm OID, the parameters' full bytes, the key bits, and
/// whether the element is all of der; None when der is not one.
fn spki_parts(der: Bytes) -> (Str, Bytes, Bytes, Bool)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let a = asn1.read(der, t.lo, t.hi)
  if a.tag != asn1.SEQUENCE {
    return None
  }
  let bs = asn1.read(der, a.next, t.hi)
  if bs.tag != asn1.BIT_STRING {
    return None
  }
  let o = asn1.read(der, a.lo, a.hi)
  if o.tag != asn1.OID {
    return None
  }
  let oid = asn1.oid_text(der, o)
  if oid.is_empty() {
    return None
  }
  var pfull = b""
  if o.next < a.hi {
    let pv = asn1.read(der, o.next, a.hi)
    if pv.tag < 0 {
      return None
    }
    pfull = der[o.next..pv.next]
  }
  // BIT STRING: the count of unused bits, which must be zero in its last byte
  if bs.hi == bs.lo {
    return None
  }
  let pad = Int(der[bs.lo])
  if pad > 7 || (bs.hi - bs.lo == 1 && pad > 0) || (pad > 0 && (Int(der[bs.hi - 1]) & ((1 << pad) - 1)) != 0) {
    return None
  }
  var bits = der[bs.lo + 1..bs.hi]
  if pad > 0 {
    // RightAlign: shift the bits right by the padding
    var out = BytesBuilder.with_capacity(bits.len())
    var carry = 0
    for c in bits {
      let v = Int(c)
      out.write_byte(UInt8(((carry << (8 - pad)) | (v >> pad)) & 255))
      carry = v & ((1 << pad) - 1)
    }
    bits = out.freeze()
  }
  Some((oid, pfull, bits, t.next == der.len()))
}

/// A PKCS #1 RSAPublicKey as encoding/asn1 unmarshals it: (N, E) or None.
fn pkcs1_parts(der: Bytes) -> ((Int, Bytes), Int?, Bool)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let nt = asn1.read(der, t.lo, t.hi)
  let n = big_int(der, nt)?
  let et = asn1.read(der, nt.next, t.hi)
  if et.tag != asn1.INTEGER {
    return None
  }
  Some((n, asn1.small_int(der, et), t.next == der.len()))
}

fn parse_pkcs1_public(der: Bytes) -> PublicKey ! crypto.KeyErr {
  let (n, e, whole) = match pkcs1_parts(der) {
    Some(p) => p
    None => return Err(key_err("x509: malformed public key"))
  }
  let ev = match e {
    Some(v) => v
    None => return Err(key_err("x509: malformed public key"))
  }
  if !whole {
    return Err(key_err("x509: malformed public key"))
  }
  if n.0 <= 0 || ev <= 0 {
    return Err(key_err("x509: public key contains zero or negative value"))
  }
  if ev > Int(Int32.max) {
    return Err(key_err("x509: public key contains large public exponent"))
  }
  PublicKey{kind: crypto.KeyAlg.Rsa, n: n.1, e: ev, key: b""}
}

fn parse_public_key(der: Bytes) -> PublicKey ! crypto.KeyErr {
  let (oid, params, data, whole) = match spki_parts(der) {
    Some(p) => p
    None => return parse_pkcs1_public(der)
  }
  if !whole {
    return Err(key_err("x509: trailing data after ASN.1 of public-key"))
  }
  if oid == OID_RSA {
    if params != b"\x05\x00" {
      return Err(key_err("x509: RSA key missing NULL parameters"))
    }
    let t = asn1.read(data, 0, data.len())
    if t.tag != asn1.SEQUENCE {
      return Err(key_err("x509: invalid RSA public key"))
    }
    let nt = asn1.read(data, t.lo, t.hi)
    let nv = match big_int(data, nt) {
      Some(v) => v
      None => return Err(key_err("x509: invalid RSA modulus"))
    }
    let et = asn1.read(data, nt.next, t.hi)
    let e = asn1.small_int(data, et)
    let ev = match e {
      Some(v) => v
      None => return Err(key_err("x509: invalid RSA public exponent"))
    }
    if nv.0 <= 0 {
      return Err(key_err("x509: RSA modulus is not a positive number"))
    }
    if ev <= 0 {
      return Err(key_err("x509: RSA public exponent is not a positive number"))
    }
    return PublicKey{kind: crypto.KeyAlg.Rsa, n: nv.1, e: ev, key: b""}
  }
  if oid == OID_EC {
    let p = asn1.read(params, 0, params.len())
    let coid = if p.tag == asn1.OID { asn1.oid_text(params, p) } else { "" }
    if coid.is_empty() {
      return Err(key_err("x509: invalid ECDSA parameters"))
    }
    let alg = match curve_of(coid) {
      Some(a) => a
      None => return Err(key_err("x509: unsupported elliptic curve"))
    }
    if data.is_empty() || data[0] != 4 {
      return Err(key_err("ecdsa: invalid uncompressed public key"))
    }
    match nistec.point_check(nist_curve(alg), data) {
      0 => ()
      1 => return Err(key_err("invalid ${curve_name(alg)} point encoding"))
      2 => return Err(key_err(element_err(curve_name(alg))))
      _ => return Err(key_err("${curve_name(alg)} point not on curve"))
    }
    return PublicKey{kind: alg, n: b"", e: 0, key: data}
  }
  if oid == OID_ED25519 {
    if !params.is_empty() {
      return Err(key_err("x509: Ed25519 key encoded with illegal parameters"))
    }
    if data.len() != 32 {
      return Err(key_err("x509: wrong Ed25519 public key size"))
    }
    return PublicKey{kind: crypto.KeyAlg.Ed25519, n: b"", e: 0, key: data}
  }
  Err(key_err("x509: unknown public key algorithm"))
}

fn oid_der(oid: Str) -> Bytes {
  let parts = oid.split(".").map(fn(x) { Int.parse(x) ?? 0 })
  var out = BytesBuilder.new()
  var vals = [parts[0] * 40 + parts[1]]
  for i in 2..parts.len() {
    vals.push(parts[i])
  }
  for v in vals {
    var groups: List[Int] = [v & 127]
    var x = v >> 7
    while x > 0 {
      groups.push((x & 127) | 128)
      x = x >> 7
    }
    var i = groups.len() - 1
    while i >= 0 {
      out.write_byte(UInt8(groups[i]))
      i -= 1
    }
  }
  asn1.enc(asn1.OID, out.freeze())
}

fn marshal_public_key(k: PublicKey) -> Bytes {
  match k.kind {
    Rsa => {
      var e = BytesBuilder.new()
      var started = false
      for sh in [56, 48, 40, 32, 24, 16, 8, 0] {
        let byte = (k.e >> sh) & 255
        if byte != 0 || started || sh == 0 {
          e.write_byte(UInt8(byte))
          started = true
        }
      }
      let body = asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc_uint(k.n), asn1.enc_uint(e.freeze())]))
      asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc(asn1.SEQUENCE, asn1.cat([oid_der(OID_RSA), b"\x05\x00"])), asn1.enc(asn1.BIT_STRING, b"\x00" + body)]))
    }
    Ed25519 => asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc(asn1.SEQUENCE, oid_der(OID_ED25519)), asn1.enc(asn1.BIT_STRING, b"\x00" + k.key)]))
    _ => asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc(asn1.SEQUENCE, asn1.cat([oid_der(OID_EC), oid_der(curve_oid(k.kind))])), asn1.enc(asn1.BIT_STRING, b"\x00" + k.key)]))
  }
}

// ---------------------------------------------------------------------------
// Private keys (crypto/x509 ParsePKCS8PrivateKey, ParsePKCS1PrivateKey,
// ParseECPrivateKey, and crypto/rsa's key checks of go1.26; decision 0285)

/// A private key: RSA's values (big endian, minimal), or an ECDSA scalar
/// (the curve's size) or an Ed25519 seed in `d`; its public key.
struct PrivateKey {
  kind: crypto.KeyAlg
  rsa: rsa.PrivateKey
  d: Bytes
  public: PublicKey
}

fn (k: PrivateKey) alg() -> crypto.KeyAlg { k.kind }

fn (k: PrivateKey) public_key() -> PublicKey { k.public }

fn no_rsa() -> rsa.PrivateKey { rsa.PrivateKey{n: b"", e: 0, d: b"", p: b"", q: b"", dp: b"", dq: b"", qinv: b""} }

/// encoding/asn1's reading of a SEQUENCE's fields: the elements in order
/// from its start, stopping at the first that does not parse (Go reads
/// only the fields its struct has and ignores the rest).
fn fields(b: Bytes, t: asn1.Tlv) -> List[asn1.Tlv] {
  var out: List[asn1.Tlv] = []
  var pos = t.lo
  while pos < t.hi {
    let e = asn1.read(b, pos, t.hi)
    out.push(e)
    if e.tag < 0 {
      break
    }
    pos = e.next
  }
  out
}

/// A minimal INTEGER that fits Go's int.
fn go_int(b: Bytes, t: asn1.Tlv) -> Int? {
  if t.tag != asn1.INTEGER {
    return None
  }
  asn1.small_int(b, t)
}

/// The fields of a PKCS #8 PrivateKeyInfo (version, algorithm OID, its
/// parameters' full bytes, the key octets), as Go unmarshals it.
fn pkcs8_parts(der: Bytes) -> (Str, Bytes, Bytes)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let xs = fields(der, t)
  if xs.len() < 3 || go_int(der, xs[0]) == None || xs[1].tag != asn1.SEQUENCE || xs[2].tag != asn1.OCTET_STRING {
    return None
  }
  let o = asn1.read(der, xs[1].lo, xs[1].hi)
  if o.tag != asn1.OID {
    return None
  }
  let oid = asn1.oid_text(der, o)
  if oid.is_empty() {
    return None
  }
  var pfull = b""
  if o.next < xs[1].hi {
    let pv = asn1.read(der, o.next, xs[1].hi)
    if pv.tag < 0 {
      return None
    }
    pfull = der[o.next..pv.next]
  }
  Some((oid, pfull, asn1.contents(der, xs[2])))
}

/// The fields of a SEC 1 ECPrivateKey: version, the key octets, and the
/// named curve OID ("" when absent), as Go unmarshals it.
fn ec_parts(der: Bytes) -> (Int, Bytes, Str)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let xs = fields(der, t)
  if xs.len() < 2 || xs[1].tag != asn1.OCTET_STRING {
    return None
  }
  let v = go_int(der, xs[0])?
  var oid = ""
  var i = 2
  // the optional explicit [0] curve and [1] public key: an inner element
  // of another type is skipped, as encoding/asn1 skips an optional field
  if i < xs.len() && xs[i].tag == 0xa0 {
    let o = asn1.read(der, xs[i].lo, xs[i].hi)
    if o.tag < 0 {
      return None
    }
    if o.tag == asn1.OID {
      oid = asn1.oid_text(der, o)
      if oid.is_empty() {
        return None
      }
    }
    i += 1
  } else if i < xs.len() && xs[i].tag < 0 {
    return None
  }
  if i < xs.len() && xs[i].tag == 0xa1 {
    let bs = asn1.read(der, xs[i].lo, xs[i].hi)
    // encoding/asn1's parseBitString: padding bits at most 7, none in a
    // BIT STRING of no bytes, and zero in the last byte
    if bs.tag < 0 || (bs.tag == asn1.BIT_STRING && (bs.hi == bs.lo || Int(der[bs.lo]) > 7 || (bs.hi - bs.lo == 1 && der[bs.lo] > 0) || (Int(der[bs.hi - 1]) & ((1 << Int(der[bs.lo])) - 1)) != 0)) {
      return None
    }
  } else if i < xs.len() && xs[i].tag < 0 {
    return None
  }
  Some((v, asn1.contents(der, xs[1]), oid))
}

/// A signed big integer field: (sign, minimal magnitude).
struct Big {
  sign: Int
  mag: Bytes
}

/// The fields of a PKCS #1 RSAPrivateKey (version, n, e, d, p, q, then dp,
/// dq, qinv when present; whether more primes follow), with the bytes
/// after the element.
fn pkcs1_priv_parts(der: Bytes) -> (Int, List[Big], Int, Bool, Bool)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let xs = fields(der, t)
  if xs.len() < 6 {
    return None
  }
  let v = go_int(der, xs[0])?
  let e = go_int(der, xs[2])?
  var bigs: List[Big] = []
  for k in [1, 3, 4, 5] {
    let (s, m) = big_int(der, xs[k])?
    bigs.push(Big{sign: s, mag: m})
  }
  var i = 6
  var crt = 0
  while crt < 3 && i < xs.len() && xs[i].tag == asn1.INTEGER {
    let (s, m) = big_int(der, xs[i])?
    bigs.push(Big{sign: s, mag: m})
    crt += 1
    i += 1
  }
  if i < xs.len() && xs[i].tag < 0 {
    return None
  }
  let more = i < xs.len() && xs[i].tag == asn1.SEQUENCE
  Some((v, bigs, e, more, t.next == der.len()))
}

/// The Go text of a failed parse: encoding/asn1's own texts (which name
/// its internal types) become one.
const MALFORMED_PRIVATE: Str = "x509: malformed private key"

fn limbs(b: Bytes) -> List[Int] { bigmod.from_bytes(b, (b.len() + 7) / 8) ?? [] }

fn limbs_n(b: Bytes, n: Int) -> List[Int]? { bigmod.from_bytes(b, n) }

/// bigmod's SetBytes of b for the modulus m: "" or Go's error.
fn set_bytes_err(b: Bytes, m: List[Int]) -> Str {
  match limbs_n(b, m.len()) {
    None => "input overflows the modulus size"
    Some(x) => if bigmod.less(x, m) { "" } else { "input overflows the modulus" }
  }
}

fn bits_of(b: Bytes) -> Int { bigmod.bit_len(limbs(b)) }

/// rsa.NewPrivateKeyWithPrecomputation's and checkPrivateKey's checks
/// (crypto/internal/fips140/rsa): "" or Go's error.
fn rsa_check(n: Bytes, e: Int, d: Bytes, p: Bytes, q: Bytes, dp: Bytes, dq: Bytes, qinv: Bytes) -> Str {
  for x in [n, p, q] {
    let l = limbs(x)
    if l.is_empty() || bigmod.bit_len(l) <= 1 {
      return "modulus must be > 1"
    }
  }
  let nl = limbs(n)
  let pl = limbs(p)
  let ql = limbs(q)
  let de = set_bytes_err(d, nl)
  if !de.is_empty() {
    return de
  }
  let qe = set_bytes_err(qinv, pl)
  if !qe.is_empty() {
    return qe
  }
  // checkPublicKey
  if (nl[0] & 1) == 0 {
    return "crypto/rsa: public modulus is even"
  }
  if e < 2 {
    return "crypto/rsa: public exponent too small or negative"
  }
  if (e & 1) == 0 {
    return "crypto/rsa: public exponent is even"
  }
  if e > Int(Int32.max) {
    return "crypto/rsa: public exponent too large"
  }
  // p and q below n; p q = n
  if !set_bytes_err(p, nl).is_empty() || !set_bytes_err(q, nl).is_empty() {
    return "crypto/rsa: invalid prime"
  }
  if !bigmod.is_zero_any(bigmod.mul_mod_any(limbs_n(p, nl.len()) ?? [], limbs_n(q, nl.len()) ?? [], nl)) {
    return "crypto/rsa: p * q != n"
  }
  let el = limbs(rsa_e_bytes(e))
  for (prime, dx) in [(pl, dp), (ql, dq)] {
    let pm1 = bigmod.trim(bigmod.sub_one(prime))
    if bigmod.bit_len(pm1) <= 1 {
      return "crypto/rsa: invalid prime"
    }
    if !set_bytes_err(dx, pm1).is_empty() {
      return "crypto/rsa: invalid CRT exponent"
    }
    if !bigmod.is_one(bigmod.mul_mod_any(el, limbs(dx), pm1)) {
      return "crypto/rsa: invalid CRT exponent"
    }
  }
  // q mod p, times qinv, is 1 mod p
  let qp = bigmod.mod_any(ql, pl)
  if !bigmod.is_one(bigmod.mul_mod_any(qp, limbs(qinv), pl)) {
    return "crypto/rsa: invalid CRT coefficient"
  }
  let dl = limbs(d)
  if !bigmod.equal(bigmod.mod_any(dl, bigmod.trim(bigmod.sub_one(pl))), limbs(dp)) {
    return "crypto/rsa: d does not match dP"
  }
  if !bigmod.equal(bigmod.mod_any(dl, bigmod.trim(bigmod.sub_one(ql))), limbs(dq)) {
    return "crypto/rsa: d does not match dQ"
  }
  // |p - q| above 2^(bits(n)/2 - 100)
  let pq = if bigmod.less(ql, pl) { bigmod.sub_plain(pl, ql) } else if bigmod.less(pl, ql) { bigmod.sub_plain(ql, pl) } else { [] }
  if pq.is_empty() {
    return "crypto/rsa: p == q"
  }
  if bigmod.bit_len(pq) <= bigmod.bit_len(nl) / 2 - 100 {
    return "crypto/rsa: |p - q| too small"
  }
  if bigmod.bit_len(dl) <= bigmod.bit_len(nl) / 2 {
    return "crypto/rsa: d too small"
  }
  ""
}

/// b without leading zero bytes (at least one byte).
fn minimal(b: Bytes) -> Bytes {
  var i = 0
  while i < b.len() - 1 && b[i] == 0 {
    i += 1
  }
  b[i..]
}

fn rsa_e_bytes(e: Int) -> Bytes {
  var b = BytesBuilder.new()
  var started = false
  for sh in [56, 48, 40, 32, 24, 16, 8, 0] {
    let x = (e >> sh) & 255
    if x != 0 || started || sh == 0 {
      b.write_byte(UInt8(x))
      started = true
    }
  }
  b.freeze()
}

/// ParsePKCS1PrivateKey after the hint: the key or Go's error.
fn parse_pkcs1_private(der: Bytes) -> PrivateKey ! Str {
  let (v, bigs, e, more, whole) = match pkcs1_priv_parts(der) {
    Some(x) => x
    None => return Err(MALFORMED_PRIVATE)
  }
  if !whole {
    return Err(MALFORMED_PRIVATE)
  }
  if v > 1 {
    return Err("x509: unsupported private key version")
  }
  for b in bigs {
    if b.sign <= 0 {
      return Err("x509: private key contains zero or negative value")
    }
  }
  if more {
    return Err("crypto/rsa: multi-prime keys are not supported")
  }
  let n = bigs[0].mag
  let d = bigs[1].mag
  let p = bigs[2].mag
  let q = bigs[3].mag
  var dp = b""
  var dq = b""
  var qinv = b""
  if bigs.len() < 7 {
    // NewPrivateKey: the CRT values from d, p, and q (the given ones are
    // dropped, as Go's precompute does when one is missing)
    let (a, b, c) = rsa_crt(n, d, p, q)?
    dp = a
    dq = b
    qinv = c
  } else {
    dp = bigs[4].mag
    dq = bigs[5].mag
    qinv = bigs[6].mag
  }
  let err = rsa_check(n, e, d, p, q, dp, dq, qinv)
  if !err.is_empty() {
    return Err(err)
  }
  let k = rsa.PrivateKey{n: n, e: e, d: d, p: p, q: q, dp: dp, dq: dq, qinv: qinv}
  PrivateKey{kind: crypto.KeyAlg.Rsa, rsa: k, d: b"", public: PublicKey{kind: crypto.KeyAlg.Rsa, n: n, e: e, key: b""}}
}

/// rsa.NewPrivateKey's CRT values dp, dq and qinv from d, p and q, or
/// Go's error.
fn rsa_crt(n: Bytes, d: Bytes, p: Bytes, q: Bytes) -> (Bytes, Bytes, Bytes) ! Str {
  for x in [n, p, q] {
    let l = limbs(x)
    if l.is_empty() || bigmod.bit_len(l) <= 1 {
      return Err("modulus must be > 1")
    }
  }
  let de = set_bytes_err(d, limbs(n))
  if !de.is_empty() {
    return Err(de)
  }
  let pl = limbs(p)
  let ql = limbs(q)
  let pm1 = bigmod.trim(bigmod.sub_one(pl))
  let qm1 = bigmod.trim(bigmod.sub_one(ql))
  if bigmod.bit_len(pm1) <= 1 || bigmod.bit_len(qm1) <= 1 {
    return Err("modulus must be > 1")
  }
  let dp = minimal(bigmod.to_bytes(bigmod.mod_any(limbs(d), pm1), 8 * pm1.len()))
  let dq = minimal(bigmod.to_bytes(bigmod.mod_any(limbs(d), qm1), 8 * qm1.len()))
  if (pl[0] & 1) == 0 {
    return Err("crypto/rsa: p is even")
  }
  // qinv = q^(p - 2) mod p
  let pm = bigmod.modulus(pl)
  let pm2 = bigmod.sub_one(pm1)
  Ok((dp, dq, minimal(bigmod.to_bytes(bigmod.from_mont(pm, bigmod.exp(pm, bigmod.reduce(pm, ql), pm2)), 8 * pl.len()))))
}

fn is_zero_bytes(b: Bytes) -> Bool {
  for x in b {
    if x != 0 {
      return false
    }
  }
  true
}

fn rsa_public_key(n: Bytes, e: Int) -> PublicKey ! crypto.KeyErr {
  if is_zero_bytes(n) {
    return Err(key_err("crypto/rsa: missing public modulus"))
  }
  if e < 1 {
    return Err(key_err("crypto/rsa: public exponent too small or negative"))
  }
  Ok(PublicKey{kind: crypto.KeyAlg.Rsa, n: minimal(n), e: e, key: b""})
}

/// Go's PrivateKey{...}.Validate() then Precompute(): its precompute's
/// checks, then NewPrivateKey's.
fn rsa_private_key(n: Bytes, e: Int, d: Bytes, primes: List[Bytes]) -> PrivateKey ! crypto.KeyErr {
  if primes.len() < 2 {
    return Err(key_err("crypto/rsa: missing primes"))
  }
  if primes.len() > 2 {
    return Err(key_err("crypto/rsa: multi-prime keys are not supported"))
  }
  let nn = minimal(n)
  let dd = minimal(d)
  let p = minimal(primes[0])
  let q = minimal(primes[1])
  let (dp, dq, qinv) = match rsa_crt(nn, dd, p, q) {
    Ok(x) => x
    Err(m) => return Err(key_err(m))
  }
  let err = rsa_check(nn, e, dd, p, q, dp, dq, qinv)
  if !err.is_empty() {
    return Err(key_err(err))
  }
  let k = rsa.PrivateKey{n: nn, e: e, d: dd, p: p, q: q, dp: dp, dq: dq, qinv: qinv}
  Ok(PrivateKey{kind: crypto.KeyAlg.Rsa, rsa: k, d: b"", public: PublicKey{kind: crypto.KeyAlg.Rsa, n: nn, e: e, key: b""}})
}

fn (k: PublicKey) rsa_parts() -> crypto.RsaParts ! crypto.KeyErr {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: rsa_parts needs an RSA key"))
  }
  let n = minimal(k.n)
  Ok(crypto.RsaParts{n: n, e: k.e, size: (bits_of(n) + 7) / 8, d: b"", primes: [], dp: b"", dq: b"", qinv: b""})
}

fn (k: PrivateKey) rsa_parts() -> crypto.RsaParts ! crypto.KeyErr {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: rsa_parts needs an RSA key"))
  }
  let r = k.rsa
  let n = minimal(r.n)
  Ok(crypto.RsaParts{n: n, e: r.e, size: (bits_of(n) + 7) / 8, d: minimal(r.d), primes: [minimal(r.p), minimal(r.q)], dp: minimal(r.dp), dq: minimal(r.dq), qinv: minimal(r.qinv)})
}

/// parseECPrivateKey (the curve from PKCS #8's parameters when given).
fn parse_ec_private(curve_oid: Str?, der: Bytes) -> PrivateKey ! Str {
  let (v, raw, oid) = match ec_parts(der) {
    Some(x) => x
    None => return Err("x509: failed to parse EC private key: malformed DER")
  }
  if v != 1 {
    return Err("x509: unknown EC private key version ${v}")
  }
  let alg = match curve_of(curve_oid ?? oid) {
    Some(a) => a
    None => return Err("x509: unknown elliptic curve")
  }
  let size = nistec.size(nist_curve(alg))
  var key = raw
  while key.len() > size {
    if key[0] != 0 {
      return Err("x509: invalid private key length")
    }
    key = key[1..]
  }
  var pad = BytesBuilder.with_capacity(size)
  for _ in 0..size - key.len() {
    pad.write_byte(0)
  }
  pad.write(key)
  let scalar = pad.freeze()
  let public = nistec.public_key(nist_curve(alg), scalar)
  if public.is_empty() {
    return Err("crypto/ecdsa: invalid private key")
  }
  PrivateKey{kind: alg, rsa: no_rsa(), d: scalar, public: PublicKey{kind: alg, n: b"", e: 0, key: public}}
}

/// ParsePKCS8PrivateKey, following its hints to ParsePKCS1PrivateKey and
/// ParseECPrivateKey.
fn parse_private(der: Bytes) -> PrivateKey ! Str {
  let (oid, params, key) = match pkcs8_parts(der) {
    Some(x) => x
    None => {
      if ec_parts(der) != None {
        return parse_ec_private(None, der)
      }
      if pkcs1_priv_parts(der) != None {
        return parse_pkcs1_private(der)
      }
      return Err(MALFORMED_PRIVATE)
    }
  }
  if oid == OID_RSA {
    return match parse_pkcs1_private(key) {
      Ok(k) => Ok(k)
      Err(e) => Err("x509: failed to parse RSA private key embedded in PKCS#8: ${if e == MALFORMED_PRIVATE { "malformed DER" } else { e }}")
    }
  }
  if oid == OID_EC {
    let p = asn1.read(params, 0, params.len())
    let coid = if p.tag == asn1.OID && p.next == params.len() { Some(asn1.oid_text(params, p)) } else { None }
    return match parse_ec_private(coid, key) {
      Ok(k) => Ok(k)
      Err(e) => Err("x509: failed to parse EC private key embedded in PKCS#8: ${e}")
    }
  }
  if oid == OID_ED25519 {
    if !params.is_empty() {
      return Err("x509: invalid Ed25519 private key parameters")
    }
    let t = asn1.read(key, 0, key.len())
    if t.tag != asn1.OCTET_STRING {
      return Err("x509: invalid Ed25519 private key: malformed DER")
    }
    let seed = asn1.contents(key, t)
    if seed.len() != 32 {
      return Err("x509: invalid Ed25519 private key length: ${seed.len()}")
    }
    return PrivateKey{kind: crypto.KeyAlg.Ed25519, rsa: no_rsa(), d: seed, public: PublicKey{kind: crypto.KeyAlg.Ed25519, n: b"", e: 0, key: ed25519.public_key(seed)}}
  }
  if oid == "1.3.101.110" {
    // X25519: Go's checks, then refused (a key agreement key, not a signer)
    if !params.is_empty() {
      return Err("x509: invalid X25519 private key parameters")
    }
    let t = asn1.read(key, 0, key.len())
    if t.tag != asn1.OCTET_STRING {
      return Err("x509: invalid X25519 private key: malformed DER")
    }
    if t.hi - t.lo != 32 {
      return Err("crypto/ecdh: invalid private key size")
    }
  }
  Err("x509: PKCS#8 wrapping contained private key with unknown algorithm: ${oid}")
}

/// Go's MarshalPKCS8PrivateKey: PKCS #8 around PKCS #1 (RSA), an
/// ECPrivateKey without its curve (it is in the algorithm) and with its
/// public key (ECDSA), or the seed (Ed25519).
fn marshal_private_key(k: PrivateKey) -> Bytes {
  let (alg, inner) = match k.kind {
    Rsa => {
      let r = k.rsa
      let pkcs1 = asn1.enc_seq([asn1.enc_int(0), asn1.enc_uint(r.n), asn1.enc_int(r.e), asn1.enc_uint(r.d), asn1.enc_uint(r.p), asn1.enc_uint(r.q), asn1.enc_uint(r.dp), asn1.enc_uint(r.dq), asn1.enc_uint(r.qinv)])
      (asn1.enc_seq([oid_der(OID_RSA), asn1.enc_null()]), pkcs1)
    }
    Ed25519 => (asn1.enc_seq([oid_der(OID_ED25519)]), asn1.enc_octets(k.d))
    _ => {
      let ec = asn1.enc_seq([asn1.enc_int(1), asn1.enc_octets(k.d), asn1.enc_explicit(1, asn1.enc_bits(k.public.key))])
      (asn1.enc_seq([oid_der(OID_EC), oid_der(curve_oid(k.kind))]), ec)
    }
  }
  asn1.enc_seq([asn1.enc_int(0), alg, asn1.enc_octets(inner)])
}

fn parse_private_key(der: Bytes) -> PrivateKey ! crypto.KeyErr { parse_private(der).map_err(fn(m) { key_err(m) }) }

// ---------------------------------------------------------------------------
// Signatures (crypto/rsa, crypto/ecdsa, crypto/ed25519 of go1.26; decision
// 0285)

/// Whether RSA PKCS #1 v1.5 signs and verifies with h: not with BLAKE2b
/// or legacy Keccak, which have no DigestInfo prefix in Go's hashPrefixes
/// (Go's SignPKCS1v15 refuses them).
fn rsa_pkcs1_hash(h: crypto.Hash) -> Bool { !(h is Blake2b_256 | Blake2b_384 | Blake2b_512 | Keccak256 | Keccak512) }

/// Whether RSA PSS takes h: every hash but legacy Keccak, which has no
/// crypto.Hash for Go's SignPSS and VerifyPSS (BLAKE2b has, once x/crypto
/// registers it).
fn rsa_pss_hash(h: crypto.Hash) -> Bool { !(h is Keccak256 | Keccak512) }

/// Whether RSA-OAEP takes h with the MGF1 hash mh: every hash, as Go's
/// EncryptOAEP and DecryptOAEP take any hash.Hash, but legacy Keccak only
/// as both (OAEPOptions names its MGF1 hash by crypto.Hash, which Keccak
/// has none of).
fn rsa_oaep_hash(h: crypto.Hash, mh: crypto.Hash) -> Bool { h == mh || (rsa_pss_hash(h) && rsa_pss_hash(mh)) }

/// Go's error for a hash RSA does not take.
fn rsa_hash_err() -> crypto.KeyErr { key_err("crypto/rsa: unsupported hash function") }

/// The DigestInfo prefix of a hash (crypto/internal/fips140/rsa
/// hashPrefixes; empty for the hashes rsa_hash refuses).
fn digest_info(h: crypto.Hash) -> Bytes {
  let hex = match h {
    Md5 => "3020300c06082a864886f70d020505000410"
    Sha1 => "3021300906052b0e03021a05000414"
    Sha224 => "302d300d06096086480165030402040500041c"
    Sha256 => "3031300d060960864801650304020105000420"
    Sha384 => "3041300d060960864801650304020205000430"
    Sha512 => "3051300d060960864801650304020305000440"
    Sha3_256 => "3031300d060960864801650304020805000420"
    Sha3_512 => "3051300d060960864801650304020a05000440"
    Sha3_224 => "302d300d06096086480165030402070500041c"
    Sha3_384 => "3041300d060960864801650304020905000430"
    Sha512_224 => "302d300d06096086480165030402050500041c"
    Sha512_256 => "3031300d060960864801650304020605000420"
    _ => ""
  }
  Bytes.from_hex(hex) ?? b""
}

/// Go's public key checks before an RSA operation (checkPublicKeySize,
/// then fips140/rsa checkPublicKey): "" or the error.
fn rsa_public_err(n: Bytes, e: Int) -> Str {
  let bits = bits_of(n)
  if bits < 1024 {
    return "crypto/rsa: ${bits}-bit keys are insecure (see https://go.dev/pkg/crypto/rsa#hdr-Minimum_key_size)"
  }
  if (Int(n[n.len() - 1]) & 1) == 0 {
    return "crypto/rsa: public modulus is even"
  }
  if e < 2 {
    return "crypto/rsa: public exponent too small or negative"
  }
  if (e & 1) == 0 {
    return "crypto/rsa: public exponent is even"
  }
  if e > Int(Int32.max) {
    return "crypto/rsa: public exponent too large"
  }
  ""
}

fn rsa_pub(k: PublicKey) -> rsa.PublicKey { rsa.PublicKey{n: k.n, e: k.e} }

fn is_ecdsa(a: crypto.KeyAlg) -> Bool { a is EcdsaP224 | EcdsaP256 | EcdsaP384 | EcdsaP521 }

fn verify(k: PublicKey, h: crypto.Hash, msg: Bytes, sig: Bytes) -> Bool {
  match k.kind {
    Rsa => rsa_pkcs1_hash(h) && rsa_public_err(k.n, k.e).is_empty() && rsa.verify_pkcs1_prefix(rsa_pub(k), digest_info(h), digest(h, msg), sig)
    Ed25519 => ed25519.verify(k.key, msg, sig)
    _ => nistec.verify(nist_curve(k.kind), k.key, digest(h, msg), sig)
  }
}

fn verify_pss(k: PublicKey, h: crypto.Hash, msg: Bytes, sig: Bytes) -> Bool {
  if k.kind != crypto.KeyAlg.Rsa || !rsa_pss_hash(h) || !rsa_public_err(k.n, k.e).is_empty() {
    return false
  }
  rsa.verify_pss_fn(rsa_pub(k), h.size(), fn(b) { digest(h, b) }, digest(h, msg), sig, -1)
}

/// r || s (each the curve's size) as DER.
fn raw_to_der(sig: Bytes, size: Int) -> Bytes? {
  if sig.len() != 2 * size {
    return None
  }
  Some(asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc_uint(sig[0..size]), asn1.enc_uint(sig[size..])])))
}

fn verify_raw_ecdsa(k: PublicKey, h: crypto.Hash, msg: Bytes, sig: Bytes) -> Bool {
  if !is_ecdsa(k.kind) {
    return false
  }
  match raw_to_der(sig, nistec.size(nist_curve(k.kind))) {
    Some(der) => nistec.verify(nist_curve(k.kind), k.key, digest(h, msg), der)
    None => false
  }
}

fn sign(r: Rand, k: PrivateKey, h: crypto.Hash, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  let z = if is_ecdsa(k.kind) { r.bytes(nistec.size(nist_curve(k.kind))) } else { b"" }
  sign_z(k, h, msg, z)
}

/// sign with the ECDSA nonce's entropy z (size(curve) bytes).
fn sign_z(k: PrivateKey, h: crypto.Hash, msg: Bytes, z: Bytes) -> Bytes ! crypto.KeyErr {
  match k.kind {
    Rsa => {
      if !rsa_pkcs1_hash(h) {
        return Err(rsa_hash_err())
      }
      let e = rsa_public_err(k.rsa.n, k.rsa.e)
      if !e.is_empty() {
        return Err(key_err(e))
      }
      let s = rsa.sign_pkcs1_prefix(k.rsa, digest_info(h), digest(h, msg))
      if s.is_empty() {
        return Err(key_err("crypto/rsa: message too long for RSA key size"))
      }
      s
    }
    Ed25519 => ed25519.sign(k.d, msg)
    _ => {
      nistec.sign_hedged(nist_curve(k.kind), k.d, digest(h, msg), z)
    }
  }
}

fn sign_pss(r: Rand, k: PrivateKey, h: crypto.Hash, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  if k.kind == crypto.KeyAlg.Rsa && !rsa_pss_hash(h) {
    return Err(rsa_hash_err())
  }
  sign_pss_with(k, h, msg, r.bytes(h.size()))
}

fn encrypt_oaep(r: Rand, k: PublicKey, h: crypto.Hash, msg: Bytes, label: Bytes, mgf_hash: crypto.Hash?) -> Bytes ! crypto.KeyErr uses rand {
  if k.kind == crypto.KeyAlg.Rsa && !rsa_oaep_hash(h, mgf_hash ?? h) {
    return Err(rsa_hash_err())
  }
  encrypt_oaep_with(k, h, msg, label, r.bytes(h.size()), mgf_hash)
}

/// encrypt_oaep with the seed.
fn encrypt_oaep_with(k: PublicKey, h: crypto.Hash, msg: Bytes, label: Bytes, seed: Bytes, mgf_hash: crypto.Hash? = None) -> Bytes ! crypto.KeyErr {
  let mh = mgf_hash ?? h
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: encrypt_oaep needs an RSA key"))
  }
  let e = rsa_public_err(k.n, k.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  match rsa.encrypt_oaep_mgf(rsa_pub(k), h.size(), fn(b) { digest(h, b) }, fn(b) { digest(mh, b) }, msg, label, seed) {
    Some(c) => c
    None => Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
}

fn decryption_error() -> crypto.KeyErr { key_err("crypto/rsa: decryption error") }

fn decrypt_oaep(k: PrivateKey, h: crypto.Hash, ciphertext: Bytes, label: Bytes, mgf_hash: crypto.Hash? = None) -> Bytes ! crypto.KeyErr {
  let mh = mgf_hash ?? h
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: decrypt_oaep needs an RSA key"))
  }
  if !rsa_oaep_hash(h, mh) {
    return Err(rsa_hash_err())
  }
  let e = rsa_public_err(k.rsa.n, k.rsa.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  match rsa.decrypt_oaep_mgf(k.rsa, h.size(), fn(b) { digest(h, b) }, fn(b) { digest(mh, b) }, ciphertext, label) {
    Some(m) => m
    None => Err(decryption_error())
  }
}

fn encrypt_pkcs1v15(r: Rand, k: PublicKey, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: encrypt_pkcs1v15 needs an RSA key"))
  }
  // the key before the message's length, as Go's EncryptPKCS1v15
  // (checkPublicKeySize first; the 0616 RSA review's F11)
  let e = rsa_public_err(k.n, k.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  let n = rsa.size(k.n) - msg.len() - 3
  if n < 8 {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  // nonzero padding bytes: a zero is drawn again
  var ps = rt.rs_with_cap(n)
  while ps.len() < n {
    for b in r.bytes(n - ps.len()) {
      if b != 0 {
        ps = rt.rs_push_byte(ps, Int(b))
      }
    }
  }
  encrypt_pkcs1v15_with(k, msg, ps.bytes())
}

/// encrypt_pkcs1v15 with the padding.
fn encrypt_pkcs1v15_with(k: PublicKey, msg: Bytes, ps: Bytes) -> Bytes ! crypto.KeyErr {
  let e = rsa_public_err(k.n, k.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  match rsa.encrypt_pkcs1v15(rsa_pub(k), msg, ps) {
    Some(c) => c
    None => Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
}

fn decrypt_pkcs1v15(k: PrivateKey, ciphertext: Bytes) -> Bytes ! crypto.KeyErr {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: decrypt_pkcs1v15 needs an RSA key"))
  }
  let e = rsa_public_err(k.rsa.n, k.rsa.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  match rsa.decrypt_pkcs1v15(k.rsa, ciphertext) {
    Some(m) => m
    None => Err(decryption_error())
  }
}

/// sign_pss with the salt.
fn sign_pss_with(k: PrivateKey, h: crypto.Hash, msg: Bytes, salt: Bytes) -> Bytes ! crypto.KeyErr {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: sign_pss needs an RSA key"))
  }
  let e = rsa_public_err(k.rsa.n, k.rsa.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  let s = rsa.sign_pss_fn(k.rsa, h.size(), fn(b) { digest(h, b) }, digest(h, msg), salt)
  if s.is_empty() {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  s
}

/// The fixed size r || s of a DER ECDSA signature.
fn der_to_raw(der: Bytes, size: Int) -> Bytes {
  let t = asn1.read(der, 0, der.len())
  let rt0 = asn1.read(der, t.lo, t.hi)
  let st = asn1.read(der, rt0.next, t.hi)
  let rb = asn1.uint_bytes(der, rt0) ?? b""
  let sb = asn1.uint_bytes(der, st) ?? b""
  var out = BytesBuilder.with_capacity(2 * size)
  for part in [rb, sb] {
    let m = if part.len() > 1 && part[0] == 0 { part[1..] } else { part }
    for _ in 0..size - m.len() {
      out.write_byte(0)
    }
    out.write(m)
  }
  out.freeze()
}

fn sign_raw_ecdsa(r: Rand, k: PrivateKey, h: crypto.Hash, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  if !is_ecdsa(k.kind) {
    return Err(key_err("crypto: sign_raw_ecdsa needs an ECDSA key"))
  }
  let der = sign(r, k, h, msg)?
  der_to_raw(der, nistec.size(nist_curve(k.kind)))
}

fn generate_key(r: Rand, alg: crypto.KeyAlg, bits: Int = 2048) -> PrivateKey ! crypto.KeyErr uses rand {
  match alg {
    Rsa => generate_rsa(r, bits)
    Ed25519 => {
      let seed = r.bytes(32)
      PrivateKey{kind: alg, rsa: no_rsa(), d: seed, public: PublicKey{kind: alg, n: b"", e: 0, key: ed25519.public_key(seed)}}
    }
    _ => {
      // Go's randomPoint: size(curve) bytes until a scalar in [1, n),
      // P-521's shifted right by 7 bits
      let c = nist_curve(alg)
      while {
        let b0 = r.bytes(nistec.size(c))
        let b = if c == nistec.P521 { nist_shift7(b0) } else { b0 }
        let p = nistec.public_key(c, b)
        if !p.is_empty() {
          return PrivateKey{kind: alg, rsa: no_rsa(), d: b, public: PublicKey{kind: alg, n: b"", e: 0, key: p}}
        }
      }
      Err(key_err("unreachable"))
    }
  }
}

/// Go's ecdsa.ParseRawPrivateKey: d is exactly the curve's size, and a
/// nonzero scalar below the order (its public point must exist).
fn ecdsa_private_key(alg: crypto.KeyAlg, d: Bytes) -> PrivateKey ! crypto.KeyErr {
  match alg {
    EcdsaP224 | EcdsaP256 | EcdsaP384 | EcdsaP521 => {}
    _ => return Err(key_err("ecdsa: curve not supported by ParseRawPrivateKey"))
  }
  let c = nist_curve(alg)
  if d.len() != nistec.size(c) {
    return Err(key_err("invalid scalar length"))
  }
  let p = nistec.public_key(c, d)
  if p.is_empty() {
    return Err(key_err("ecdsa: invalid public key encoding"))
  }
  Ok(PrivateKey{kind: alg, rsa: no_rsa(), d: d, public: PublicKey{kind: alg, n: b"", e: 0, key: p}})
}

/// Go's ecdsa.ParseUncompressedPublicKey: the 0x04 form first, then the
/// curve, then nistec's SetBytes texts.
fn ecdsa_public_key(alg: crypto.KeyAlg, point: Bytes) -> PublicKey ! crypto.KeyErr {
  if point.is_empty() || point[0] != 4 {
    return Err(key_err("ecdsa: invalid uncompressed public key"))
  }
  if !is_ecdsa(alg) {
    return Err(key_err("ecdsa: curve not supported by ParseUncompressedPublicKey"))
  }
  let name = curve_name(alg)
  match nistec.point_check(nist_curve(alg), point) {
    0 => Ok(PublicKey{kind: alg, n: b"", e: 0, key: point})
    1 => Err(key_err("invalid ${name} point encoding"))
    2 => Err(key_err(element_err(name)))
    _ => Err(key_err("${name} point not on curve"))
  }
}

fn (k: PublicKey) bytes() -> Bytes ! crypto.KeyErr {
  if k.kind == crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: an RSA key has no raw encoding"))
  }
  Ok(k.key)
}

fn (k: PrivateKey) bytes() -> Bytes ! crypto.KeyErr {
  if k.kind == crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: an RSA key has no raw encoding"))
  }
  Ok(k.d)
}

/// The ECDH curve of an ECDSA key's, as Go's curveToECDH.
fn ecdh_of(a: crypto.KeyAlg) -> crypto.EcdhCurve? {
  match a {
    EcdsaP256 => Some(crypto.EcdhCurve.P256)
    EcdsaP384 => Some(crypto.EcdhCurve.P384)
    EcdsaP521 => Some(crypto.EcdhCurve.P521)
    _ => None
  }
}

fn (k: PublicKey) ecdh() -> EcdhPublicKey ! crypto.KeyErr {
  match ecdh_of(k.kind) {
    Some(c) => Ok(EcdhPublicKey{crv: c, key: k.key})
    None => Err(key_err("ecdsa: unsupported curve by crypto/ecdh"))
  }
}

fn (k: PrivateKey) ecdh() -> EcdhPrivateKey ! crypto.KeyErr {
  match ecdh_of(k.kind) {
    Some(c) => Ok(EcdhPrivateKey{crv: c, d: k.d, public: EcdhPublicKey{crv: c, key: k.public.key}})
    None => Err(key_err("ecdsa: unsupported curve by crypto/ecdh"))
  }
}

/// Go's SignPSS's salt length switch, then rsa.SignPSS's checks.
fn sign_pss_digest(r: Rand, k: PrivateKey, h: crypto.Hash, dg: Bytes, salt_len: Int) -> Bytes ! crypto.KeyErr uses rand {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: sign_pss_digest needs an RSA key"))
  }
  if !rsa_pss_hash(h) {
    return Err(rsa_hash_err())
  }
  let e = rsa_public_err(k.rsa.n, k.rsa.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  let hl = h.size()
  let em_len = (bits_of(k.rsa.n) - 1 + 7) / 8
  let s = if salt_len == 0 { em_len - 2 - hl } else if salt_len == -1 { hl } else { salt_len }
  if salt_len < -1 {
    return Err(key_err("crypto/rsa: invalid PSS salt length"))
  }
  if s < 0 {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  if dg.len() != hl {
    return Err(key_err("crypto/rsa: input must be hashed with given hash"))
  }
  if em_len < hl + s + 2 {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  let sig = rsa.sign_pss_fn(k.rsa, hl, fn(b) { digest(h, b) }, dg, r.bytes(s))
  if sig.is_empty() {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  Ok(sig)
}

fn verify_pss_digest(k: PublicKey, h: crypto.Hash, dg: Bytes, sig: Bytes, salt_len: Int) -> Bool {
  if k.kind != crypto.KeyAlg.Rsa || !rsa_pss_hash(h) || salt_len < -1 || !rsa_public_err(k.n, k.e).is_empty() {
    return false
  }
  let s = if salt_len == 0 { -1 } else if salt_len == -1 { h.size() } else { salt_len }
  rsa.verify_pss_fn(rsa_pub(k), h.size(), fn(b) { digest(h, b) }, dg, sig, s)
}

fn sign_pkcs1v15_digest(k: PrivateKey, h: crypto.Hash?, dg: Bytes) -> Bytes ! crypto.KeyErr {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: sign_pkcs1v15_digest needs an RSA key"))
  }
  let prefix = match h {
    Some(x) => {
      if !rsa_pkcs1_hash(x) {
        return Err(rsa_hash_err())
      }
      if dg.len() != x.size() {
        return Err(key_err("crypto/rsa: input must be hashed message"))
      }
      digest_info(x)
    }
    None => b""
  }
  let e = rsa_public_err(k.rsa.n, k.rsa.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  let s = rsa.sign_pkcs1_prefix(k.rsa, prefix, dg)
  if s.is_empty() {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  Ok(s)
}

fn verify_pkcs1v15_digest(k: PublicKey, h: crypto.Hash?, dg: Bytes, sig: Bytes) -> Bool {
  if k.kind != crypto.KeyAlg.Rsa || !rsa_public_err(k.n, k.e).is_empty() {
    return false
  }
  match h {
    Some(x) => rsa_pkcs1_hash(x) && dg.len() == x.size() && rsa.verify_pkcs1_prefix(rsa_pub(k), digest_info(x), dg, sig)
    None => rsa.verify_pkcs1_prefix(rsa_pub(k), b"", dg, sig)
  }
}

fn ecdsa_sign_digest(r: Rand, k: PrivateKey, digest: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  if !is_ecdsa(k.kind) {
    return Err(key_err("crypto: ecdsa_sign_digest needs an ECDSA key"))
  }
  let c = nist_curve(k.kind)
  Ok(nistec.sign_hedged(c, k.d, digest, r.bytes(nistec.size(c))))
}

fn ecdsa_verify_digest(k: PublicKey, digest: Bytes, sig: Bytes) -> Bool {
  is_ecdsa(k.kind) && nistec.verify(nist_curve(k.kind), k.key, digest, sig)
}

/// An RSA key of `bits` (Go's rsa.GenerateKey, with go1.26's size floor,
/// and 8192, the largest key std signs with), its checks run as for a
/// parsed key.
fn generate_rsa(r: Rand, bits: Int) -> PrivateKey ! crypto.KeyErr uses rand {
  if bits < 1024 {
    return Err(key_err("crypto/rsa: ${bits}-bit keys are insecure (see https://go.dev/pkg/crypto/rsa#hdr-Minimum_key_size)"))
  }
  if bits > 8192 {
    return Err(key_err("crypto/rsa: ${bits}-bit keys are too large"))
  }
  let k = match rsagen.generate(bits, fn(n: Int) -> Bytes uses rand { r.bytes(n) }) {
    Some(k) => k
    None => return Err(key_err("crypto/rsa: key generation failed"))
  }
  let err = rsa_check(k.n, k.e, k.d, k.p, k.q, k.dp, k.dq, k.qinv)
  if !err.is_empty() {
    return Err(key_err(err))
  }
  PrivateKey{kind: crypto.KeyAlg.Rsa, rsa: k, d: b"", public: PublicKey{kind: crypto.KeyAlg.Rsa, n: k.n, e: k.e, key: b""}}
}

fn nist_shift7(b: Bytes) -> Bytes {
  var out = BytesBuilder.with_capacity(b.len())
  for i in 0..b.len() {
    let hi = if i > 0 { (Int(b[i - 1]) << 1) & 255 } else { 0 }
    out.write_byte(UInt8((Int(b[i]) >> 7) | hi))
  }
  out.freeze()
}

// ---------------------------------------------------------------------------
// JWK public keys (RFC 7517, 7518 6.2 and 6.3, RFC 8037; decision 0285)

struct Jwk {
  kty: Str
  crv: Str?
  n: Str?
  e: Str?
  x: Str?
  y: Str?
} derive Json

/// A JWK member: unpadded base64url (RFC 7515 2).
fn jwk_bytes(name: Str, v: Str?) -> Bytes ! crypto.KeyErr {
  let s = match v {
    Some(s) => s
    None => return Err(key_err("jwk: missing member \"${name}\""))
  }
  match base64.decode(s, base64.Base64.RawUrl) {
    Ok(b) => b
    Err(_) => Err(key_err("jwk: member \"${name}\" is not unpadded base64url"))
  }
}

fn jwk_public_key(jwk: Str) -> PublicKey ! crypto.KeyErr {
  let j = match json.decode_str[Jwk](jwk) {
    Ok(j) => j
    Err(_) => return Err(key_err("jwk: malformed JSON"))
  }
  match j.kty {
    "RSA" => {
      let n = minimal(jwk_bytes("n", j.n)?)
      let e = minimal(jwk_bytes("e", j.e)?)
      if e.len() > 4 || n.is_empty() || (n.len() == 1 && n[0] == 0) {
        return Err(key_err("jwk: invalid RSA key"))
      }
      var ev = 0
      for b in e {
        ev = ev * 256 + Int(b)
      }
      if ev <= 0 {
        return Err(key_err("jwk: invalid RSA key"))
      }
      PublicKey{kind: crypto.KeyAlg.Rsa, n: n, e: ev, key: b""}
    }
    "EC" => {
      let alg = match j.crv ?? "" {
        "P-256" => crypto.KeyAlg.EcdsaP256
        "P-384" => crypto.KeyAlg.EcdsaP384
        "P-521" => crypto.KeyAlg.EcdsaP521
        other => return Err(key_err("jwk: unsupported curve ${other.quote()}"))
      }
      let size = nistec.size(nist_curve(alg))
      let x = jwk_bytes("x", j.x)?
      let y = jwk_bytes("y", j.y)?
      if x.len() != size || y.len() != size {
        return Err(key_err("jwk: coordinates of the wrong size for ${j.crv ?? ""}"))
      }
      let point = b"\x04" + x + y
      if nistec.point_check(nist_curve(alg), point) != 0 {
        return Err(key_err("jwk: point not on the curve"))
      }
      PublicKey{kind: alg, n: b"", e: 0, key: point}
    }
    "OKP" => {
      if j.crv != Some("Ed25519") {
        return Err(key_err("jwk: unsupported curve ${(j.crv ?? "").quote()}"))
      }
      let x = jwk_bytes("x", j.x)?
      if x.len() != 32 {
        return Err(key_err("jwk: Ed25519 key of the wrong size"))
      }
      PublicKey{kind: crypto.KeyAlg.Ed25519, n: b"", e: 0, key: x}
    }
    other => Err(key_err("jwk: unsupported key type ${other.quote()}"))
  }
}

// ---------------------------------------------------------------------------
// ECDH (crypto/ecdh of go1.26, decision 0599): llrt's X25519 and nistec

struct EcdhPrivateKey {
  crv: crypto.EcdhCurve
  d: Bytes
  public: EcdhPublicKey
}

struct EcdhPublicKey {
  crv: crypto.EcdhCurve
  key: Bytes
}

fn ecdh_nist(c: crypto.EcdhCurve) -> Int {
  match c {
    crypto.EcdhCurve.P384 => nistec.P384
    crypto.EcdhCurve.P521 => nistec.P521
    _ => nistec.P256
  }
}

fn ecdh_generate_key(r: Rand, c: crypto.EcdhCurve) -> EcdhPrivateKey uses rand {
  if c == crypto.EcdhCurve.X25519 {
    let d = r.bytes(32)
    return EcdhPrivateKey{crv: c, d: d, public: EcdhPublicKey{crv: c, key: x25519.base(d)}}
  }
  let n = ecdh_nist(c)
  // Go's randomPoint, as generate_key's ECDSA path: size(curve) bytes
  // until a scalar in [1, n), P-521's candidates shifted right by 7 bits
  while true {
    let b0 = r.bytes(nistec.size(n))
    let b = if n == nistec.P521 { nist_shift7(b0) } else { b0 }
    let p = nistec.public_key(n, b)
    if !p.is_empty() {
      return EcdhPrivateKey{crv: c, d: b, public: EcdhPublicKey{crv: c, key: p}}
    }
  }
  EcdhPrivateKey{crv: c, d: b"", public: EcdhPublicKey{crv: c, key: b""}}
}

fn ecdh_private_key(c: crypto.EcdhCurve, key: Bytes) -> EcdhPrivateKey ! crypto.KeyErr {
  if c == crypto.EcdhCurve.X25519 {
    if key.len() != 32 {
      return Err(key_err("crypto/ecdh: invalid private key size"))
    }
    return Ok(EcdhPrivateKey{crv: c, d: key, public: EcdhPublicKey{crv: c, key: x25519.base(key)}})
  }
  let p = nistec.public_key(ecdh_nist(c), key)
  if p.is_empty() {
    return Err(key_err("crypto/ecdh: invalid private key"))
  }
  Ok(EcdhPrivateKey{crv: c, d: key, public: EcdhPublicKey{crv: c, key: p}})
}

fn ecdh_public_key(c: crypto.EcdhCurve, key: Bytes) -> EcdhPublicKey ! crypto.KeyErr {
  if c == crypto.EcdhCurve.X25519 {
    if key.len() != 32 {
      return Err(key_err("crypto/ecdh: invalid public key"))
    }
    return Ok(EcdhPublicKey{crv: c, key: key})
  }
  // the identity and compressed points first, then nistec's SetBytes
  // texts, as Go returns them
  if key.is_empty() || key[0] != 4 {
    return Err(key_err("crypto/ecdh: invalid public key"))
  }
  let name = c.debug()
  match nistec.point_check(ecdh_nist(c), key) {
    0 => Ok(EcdhPublicKey{crv: c, key: key})
    1 => Err(key_err("invalid ${name} point encoding"))
    2 => Err(key_err(element_err(name)))
    _ => Err(key_err("${name} point not on curve"))
  }
}

fn (k: EcdhPrivateKey) curve() -> crypto.EcdhCurve { k.crv }

fn (k: EcdhPrivateKey) bytes() -> Bytes { k.d }

fn (k: EcdhPrivateKey) public_key() -> EcdhPublicKey { k.public }

fn (k: EcdhPrivateKey) ecdh(peer: EcdhPublicKey) -> Bytes ! crypto.KeyErr {
  if k.crv != peer.crv {
    return Err(key_err("crypto/ecdh: private key and public key curves do not match"))
  }
  if k.crv == crypto.EcdhCurve.X25519 {
    let s = x25519.scalar_mult(k.d, peer.key)
    var acc = 0
    for x in s {
      acc = acc | Int(x)
    }
    if acc == 0 {
      return Err(key_err("crypto/ecdh: bad X25519 remote ECDH input: low order point"))
    }
    return Ok(s)
  }
  match nistec.ecdh(ecdh_nist(k.crv), k.d, peer.key) {
    Some(s) => Ok(s)
    // unreachable: both keys were checked when made (Go's comment)
    None => Err(key_err("crypto/ecdh: invalid public key"))
  }
}

fn (k: EcdhPublicKey) curve() -> crypto.EcdhCurve { k.crv }

fn (k: EcdhPublicKey) bytes() -> Bytes { k.key }

// ---------------------------------------------------------------------------
// ML-KEM (crypto/mlkem of go1.26, decision 0604): llrt's FIPS 203 code,
// which TLS's hybrids already use

struct MlkemDecapsulationKey {
  p: crypto.MlkemParams
  seed: Bytes
  key: mlkem.Key
  enc: MlkemEncapsulationKey
}

struct MlkemEncapsulationKey {
  p: crypto.MlkemParams
  e: mlkem.EncKey
}

fn mlkem_k(p: crypto.MlkemParams) -> Int { mlkem.k_of(p == crypto.MlkemParams.Mlkem1024) }

fn mlkemparams_encapsulation_key_size(p: crypto.MlkemParams) -> Int { mlkem.ek_len(mlkem_k(p)) }

fn mlkemparams_ciphertext_size(p: crypto.MlkemParams) -> Int { mlkem.ct_len(mlkem_k(p)) }

fn mlkem_dk(p: crypto.MlkemParams, seed: Bytes) -> MlkemDecapsulationKey {
  let k = mlkem_k(p)
  let key = mlkem.expand_seed(seed, k)
  MlkemDecapsulationKey{p: p, seed: seed, key: key, enc: MlkemEncapsulationKey{p: p, e: mlkem.key_enc(key, k)}}
}

fn mlkem_generate_key(r: Rand, p: crypto.MlkemParams) -> MlkemDecapsulationKey uses rand { mlkem_dk(p, r.bytes(64)) }

fn mlkem_decapsulation_key(p: crypto.MlkemParams, seed: Bytes) -> MlkemDecapsulationKey ! crypto.KeyErr {
  if seed.len() != 64 {
    return Err(key_err("mlkem: invalid seed length"))
  }
  Ok(mlkem_dk(p, seed))
}

fn mlkem_encapsulation_key(p: crypto.MlkemParams, key: Bytes) -> MlkemEncapsulationKey ! crypto.KeyErr {
  let k = mlkem_k(p)
  if key.len() != mlkem.ek_len(k) {
    return Err(key_err("mlkem: invalid encapsulation key length"))
  }
  match mlkem.parse_ek(key, k) {
    Some(e) => Ok(MlkemEncapsulationKey{p: p, e: e})
    None => Err(key_err("mlkem: invalid polynomial encoding"))
  }
}

fn (k: MlkemDecapsulationKey) params() -> crypto.MlkemParams { k.p }

fn (k: MlkemDecapsulationKey) bytes() -> Bytes { k.seed }

fn (k: MlkemDecapsulationKey) encapsulation_key() -> MlkemEncapsulationKey { k.enc }

fn (k: MlkemDecapsulationKey) decapsulate(ciphertext: Bytes) -> Bytes ! crypto.KeyErr {
  let kk = mlkem_k(k.p)
  if ciphertext.len() != mlkem.ct_len(kk) {
    return Err(key_err("mlkem: invalid ciphertext length"))
  }
  Ok(mlkem.decaps_with(k.key, ciphertext, kk))
}

fn (k: MlkemEncapsulationKey) params() -> crypto.MlkemParams { k.p }

fn (k: MlkemEncapsulationKey) bytes() -> Bytes { mlkem.enc_bytes(k.e) }

fn (k: MlkemEncapsulationKey) encapsulate(r: Rand) -> (Bytes, Bytes) uses rand { mlkem.encaps_with(k.e, r.bytes(32)) }
// AES block, CBC and CTR (crypto/aes and crypto/cipher of go1.26,
// decision 0605): llrt's AES, which TLS and AES-GCM use

struct AesBlock {
  c: aesgcm.Cipher
}

struct Ctr {
  c: aesgcm.Cipher
  /// the counter of the next keystream block (big endian halves)
  hi: Int
  lo: Int
  /// the unused rest of the last keystream block
  ks: Bytes
}

fn aes_block(key: Bytes) -> AesBlock ! crypto.KeyErr {
  if !(key.len() == 16 || key.len() == 24 || key.len() == 32) {
    return Err(key_err("crypto/aes: invalid key size ${key.len()}"))
  }
  Ok(AesBlock{c: aesgcm.new(key)})
}

fn (b: AesBlock) encrypt_block(src: Bytes) -> Bytes {
  if src.len() != 16 {
    fault("crypto/aes: input not full block")
  }
  b.c.encrypt_block(src)
}

fn (b: AesBlock) decrypt_block(src: Bytes) -> Bytes {
  if src.len() != 16 {
    fault("crypto/aes: input not full block")
  }
  b.c.decrypt_block(src)
}

fn (b: AesBlock) block_size() -> Int { 16 }

struct CbcMode {
  b: crypto.Block
  /// the last ciphertext block, which the next block chains on
  iv: Bytes
  decrypt: Bool
}

struct BlockCtr {
  b: crypto.Block
  /// the counter of the next keystream block
  ctr: Bytes
  /// the unused rest of the last keystream block
  ks: Bytes
}

fn cbc_encrypter(b: crypto.Block, iv: Bytes) -> CbcMode {
  if iv.len() != b.block_size() {
    fault("cipher.NewCBCEncrypter: IV length must equal block size")
  }
  CbcMode{b: b, iv: iv, decrypt: false}
}

fn cbc_decrypter(b: crypto.Block, iv: Bytes) -> CbcMode {
  if iv.len() != b.block_size() {
    fault("cipher.NewCBCDecrypter: IV length must equal block size")
  }
  CbcMode{b: b, iv: iv, decrypt: true}
}

fn (m: CbcMode) block_size() -> Int { m.b.block_size() }

/// A caller's Block's output, which must be one block.
fn one_block(out: Bytes, bs: Int, what: Str) -> Bytes {
  if out.len() != bs {
    fault("crypto: the Block's ${what} gave ${out.len()} bytes for a ${bs} byte block")
  }
  out
}

fn (var m: CbcMode) crypt_blocks(src: Bytes) -> Bytes {
  let bs = m.b.block_size()
  if src.len() % bs != 0 {
    fault("crypto/cipher: input not full blocks")
  }
  var w = BytesBuilder.with_capacity(src.len())
  var prev = m.iv
  for i in 0..src.len() / bs {
    let blk = src[i * bs..(i + 1) * bs]
    if m.decrypt {
      w.write(xor(one_block(m.b.decrypt_block(blk), bs, "decrypt_block"), prev))
      prev = blk
    } else {
      prev = one_block(m.b.encrypt_block(xor(blk, prev)), bs, "encrypt_block")
      w.write(prev)
    }
  }
  m.iv = prev
  w.freeze()
}

fn block_ctr(b: crypto.Block, iv: Bytes) -> BlockCtr {
  if iv.len() != b.block_size() {
    fault("cipher.NewCTR: IV length must equal block size")
  }
  BlockCtr{b: b, ctr: iv, ks: b""}
}

/// n + 1 as a big endian number of n.len() bytes, wrapping.
fn ctr_inc(n: Bytes) -> Bytes {
  var w = BytesBuilder.with_capacity(n.len())
  w.write(n)
  var i = n.len() - 1
  while i >= 0 {
    let v = (Int(n[i]) + 1) & 0xff
    w.put_le(i, v, 1)
    if v != 0 {
      break
    }
    i -= 1
  }
  w.freeze()
}

fn (var c: BlockCtr) xor(data: Bytes) -> Bytes {
  let bs = c.b.block_size()
  var w = BytesBuilder.with_capacity(data.len())
  var at = 0
  while at < data.len() {
    if c.ks.is_empty() {
      c.ks = one_block(c.b.encrypt_block(c.ctr), bs, "encrypt_block")
      c.ctr = ctr_inc(c.ctr)
    }
    let n = c.ks.len().min(data.len() - at)
    w.write(xor(data[at..at + n], c.ks[0..n]))
    c.ks = c.ks[n..c.ks.len()]
    at += n
  }
  w.freeze()
}

fn cbc_encrypt(b: AesBlock, iv: Bytes, plaintext: Bytes) -> Bytes {
  if iv.len() != 16 {
    fault("cipher.NewCBCEncrypter: IV length must equal block size")
  }
  if plaintext.len() % 16 != 0 {
    fault("crypto/cipher: input not full blocks")
  }
  b.c.cbc_encrypt(iv, plaintext)
}

fn cbc_decrypt(b: AesBlock, iv: Bytes, ciphertext: Bytes) -> Bytes {
  if iv.len() != 16 {
    fault("cipher.NewCBCDecrypter: IV length must equal block size")
  }
  if ciphertext.len() % 16 != 0 {
    fault("crypto/cipher: input not full blocks")
  }
  b.c.cbc_decrypt(iv, ciphertext)
}

fn ctr(b: AesBlock, iv: Bytes) -> Ctr {
  if iv.len() != 16 {
    fault("cipher.NewCTR: IV length must equal block size")
  }
  Ctr{c: b.c, hi: rt.bytes_word(iv, 0).swap_bytes(), lo: rt.bytes_word(iv, 8).swap_bytes(), ks: b""}
}

fn (var c: Ctr) xor(data: Bytes) -> Bytes {
  let used = c.ks.len().min(data.len())
  let head = xor(data[0..used], c.ks[0..used])
  let rest = data[used..data.len()]
  if rest.is_empty() {
    c.ks = c.ks[used..c.ks.len()]
    return head
  }
  // whole blocks XORed as the key stream is made, then the last partial
  // block's key stream, its rest kept for the next call
  let full = rest.len() / 16
  let tail = rest.len() - 16 * full
  var body = c.c.ctr_xor(c.hi, c.lo, data, used, full)
  let (h1, l1) = ctr_add(c.hi, c.lo, full)
  c.hi = h1
  c.lo = l1
  if tail > 0 {
    let ks = c.c.ctr_keystream(c.hi, c.lo, 1)
    let (h2, l2) = ctr_add(c.hi, c.lo, 1)
    c.hi = h2
    c.lo = l2
    c.ks = ks[tail..16]
    body = asn1.cat([body, xor(rest[16 * full..rest.len()], ks[0..tail])])
  } else {
    c.ks = b""
  }
  if used == 0 {
    return body
  }
  asn1.cat([head, body])
}

/// The counter (hi, lo) n blocks on (a 128-bit add).
fn ctr_add(hi: Int, lo: Int, n: Int) -> (Int, Int) {
  let l = lo.wrapping_add(n)
  (if l.lt_unsigned(lo) { hi.wrapping_add(1) } else { hi }, l)
}
