// std/crypto on the native backends (decision 0083). std/rt/crypto.go is
// the reference; the hashes are Xo (std/native/llrt/digest.xo, decision
// 0195), crypto.equal and Ed25519 C (std/llrt/xo_crypto.c, constant
// time), and random bytes come from the Rand capability (the operating
// system's generator).
use native/llrt/cabi_crypto
use native/llrt/digest
use native/rt
use native/rtcrypto

fn sha256(data: Bytes) -> Bytes { digest.sha256(data) }

fn hmac_sha256(key: Bytes, msg: Bytes) -> Bytes { digest.hmac_sha256(key, msg) }

fn equal(a: Bytes, b: Bytes) -> Bool { rtcrypto.crypto_equal(a, b) }

fn random_bytes(r: Rand, n: Int, at: rt.Loc) -> Bytes uses rand {
  if n < 0 {
    rt.fault_at("crypto.random_bytes: negative length ${n}", at)
  }
  r.bytes(n)
}

fn token(r: Rand, n: Int = 32, at: rt.Loc) -> Str uses rand { digest.b64(random_bytes(r, n, at), true) }

fn hash_password_argon2id(r: Rand, password: Str, memory_kib: Int = 19456, iterations: Int = 2, parallelism: Int = 1, at: rt.Loc) -> Str uses rand {
  let ok = parallelism >= 1 && parallelism <= 255 && memory_kib >= 8 * parallelism && memory_kib <= 4194304 && iterations >= 1 && iterations <= 1000
  if !ok {
    rt.fault_at("crypto.hash_password_argon2id: need parallelism in 1..=255, memory_kib in 8 * parallelism..=4194304, iterations in 1..=1000; got memory_kib ${memory_kib}, iterations ${iterations}, parallelism ${parallelism}", at)
  }
  let salt = random_bytes(r, 16, at)
  let key = digest.argon2id(password.bytes(), salt, iterations, memory_kib, parallelism, 32)
  "$argon2id$v=19$m=${memory_kib},t=${iterations},p=${parallelism}$" + digest.b64(salt, false) + "$" + digest.b64(key, false)
}

fn hash_password(r: Rand, password: Str, iterations: Int = 600000, at: rt.Loc) -> Str uses rand {
  if iterations < 1 || iterations > 100000000 {
    rt.fault_at("crypto.hash_password: iterations must be in 1..=100000000, got ${iterations}", at)
  }
  let salt = random_bytes(r, 16, at)
  let key = digest.pbkdf2(password.bytes(), salt, iterations, 32)
  "pbkdf2-sha256$" + "${iterations}$" + digest.b64(salt, false) + "$" + digest.b64(key, false)
}

fn verify_password(password: Str, hash: Str) -> Bool { digest.verify_password(password, hash) }

fn ed25519_public_key(seed: Bytes, at: rt.Loc) -> Bytes {
  if seed.len() != 32 {
    rt.fault_at("crypto.ed25519_public_key: the seed is ${seed.len()} bytes, want 32", at)
  }
  rtcrypto.crypto_ed25519_public_key(seed)
}

fn ed25519_sign(seed: Bytes, msg: Bytes, at: rt.Loc) -> Bytes {
  if seed.len() != 32 {
    rt.fault_at("crypto.ed25519_sign: the seed is ${seed.len()} bytes, want 32", at)
  }
  rtcrypto.crypto_ed25519_sign(seed, msg)
}

fn ed25519_verify(public_key: Bytes, msg: Bytes, sig: Bytes) -> Bool { rtcrypto.crypto_ed25519_verify(public_key, msg, sig) }
