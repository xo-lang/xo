// std/crypto on the native backends (decision 0083). std/rt/crypto.go is
// the reference; the hashes are Xo (std/native/llrt/digest.xo, decision
// 0195), crypto.equal and Ed25519 constant time Xo
// (std/native/llrt/ct.xo and ed25519.xo, decision 0222), and random
// bytes come from the Rand capability (the operating system's
// generator).
use std/base64
use std/crypto
use std/json
use native/llrt/aesgcm
use native/llrt/asn1
use native/llrt/bigmod
use native/llrt/chacha
use native/llrt/ct
use native/llrt/digest as dg
use native/llrt/ed25519
use native/llrt/hkdf as hk
use native/llrt/md5
use native/llrt/nistec
use native/llrt/rsa
use native/llrt/sha1
use native/llrt/sha256
use native/llrt/sha3
use native/rt

fn sha256(data: Bytes) -> Bytes { dg.sha256(data) }

fn hmac_sha256(key: Bytes, msg: Bytes) -> Bytes { dg.hmac_sha256(key, msg) }

fn equal(a: Bytes, b: Bytes) -> Bool { ct.bytes_equal(a, b) }

fn random_bytes(r: Rand, n: Int, at: rt.Loc) -> Bytes uses rand {
  if n < 0 {
    rt.fault_at("crypto.random_bytes: negative length ${n}", at)
  }
  r.bytes(n)
}

fn token(r: Rand, n: Int = 32, at: rt.Loc) -> Str uses rand { dg.b64(random_bytes(r, n, at), true) }

fn hash_password_argon2id(r: Rand, password: Str, memory_kib: Int = 19456, iterations: Int = 2, parallelism: Int = 1, at: rt.Loc) -> Str uses rand {
  let ok = parallelism >= 1 && parallelism <= 255 && memory_kib >= 8 * parallelism && memory_kib <= 4194304 && iterations >= 1 && iterations <= 1000
  if !ok {
    rt.fault_at("crypto.hash_password_argon2id: need parallelism in 1..=255, memory_kib in 8 * parallelism..=4194304, iterations in 1..=1000; got memory_kib ${memory_kib}, iterations ${iterations}, parallelism ${parallelism}", at)
  }
  let salt = random_bytes(r, 16, at)
  let key = dg.argon2id(password.bytes(), salt, iterations, memory_kib, parallelism, 32)
  "$argon2id$v=19$m=${memory_kib},t=${iterations},p=${parallelism}$" + dg.b64(salt, false) + "$" + dg.b64(key, false)
}

fn hash_password(r: Rand, password: Str, iterations: Int = 600000, at: rt.Loc) -> Str uses rand {
  if iterations < 1 || iterations > 100000000 {
    rt.fault_at("crypto.hash_password: iterations must be in 1..=100000000, got ${iterations}", at)
  }
  let salt = random_bytes(r, 16, at)
  let key = dg.pbkdf2(password.bytes(), salt, iterations, 32)
  "pbkdf2-sha256$" + "${iterations}$" + dg.b64(salt, false) + "$" + dg.b64(key, false)
}

fn verify_password(password: Str, hash: Str) -> Bool { dg.verify_password(password, hash) }

fn ed25519_public_key(seed: Bytes, at: rt.Loc) -> Bytes {
  if seed.len() != 32 {
    rt.fault_at("crypto.ed25519_public_key: the seed is ${seed.len()} bytes, want 32", at)
  }
  ed25519.public_key(seed)
}

fn ed25519_sign(seed: Bytes, msg: Bytes, at: rt.Loc) -> Bytes {
  if seed.len() != 32 && seed.len() != 64 {
    rt.fault_at("crypto.ed25519_sign: the key is ${seed.len()} bytes, want 32 or 64", at)
  }
  ed25519.sign(seed, msg)
}

fn ed25519_verify(public_key: Bytes, msg: Bytes, sig: Bytes) -> Bool { ed25519.verify(public_key, msg, sig) }

// ---------------------------------------------------------------------------
// Hash, digest, hmac, and Hasher (decision 0279): the runtime's hashes
// (md5.xo, sha1.xo, sha256.xo for SHA-224 to SHA-512, sha3.xo), HMAC as
// Go's crypto/hmac builds it over each (RFC 2104: the key hashed when
// longer than the block, then the inner and outer pads).

fn hash_size(h: crypto.Hash) -> Int {
  match h {
    Md5 => 16
    Sha1 => 20
    Sha224 => 28
    Sha256 => 32
    Sha384 => 48
    Sha512 => 64
    Sha3_256 => 32
    Sha3_512 => 64
  }
}

/// HMAC's block size: Go's h.BlockSize() (the rate for SHA-3).
fn block_of(h: crypto.Hash) -> Int {
  match h {
    Sha384 => 128
    Sha512 => 128
    Sha3_256 => 136
    Sha3_512 => 72
    _ => 64
  }
}

enum State {
  M5(h: md5.Hasher)
  S1(h: sha1.Hasher)
  S2(h: sha256.Hasher)
  S3(s: sha3.Sponge)
}

struct Hasher {
  hash: crypto.Hash
  st: State
  /// The outer padded key of an HMAC; empty for a plain hash.
  opad: Bytes
  total: Int
}

fn fresh(h: crypto.Hash) -> State {
  match h {
    Md5 => State.M5(h: md5.new())
    Sha1 => State.S1(h: sha1.new())
    Sha224 => State.S2(h: sha256.new(sha256.HASH_SHA224))
    Sha256 => State.S2(h: sha256.new(sha256.HASH_SHA256))
    Sha384 => State.S2(h: sha256.new(sha256.HASH_SHA384))
    Sha512 => State.S2(h: sha256.new(sha256.HASH_SHA512))
    Sha3_256 => State.S3(s: sha3.new_sha3_256())
    Sha3_512 => State.S3(s: sha3.new_sha3_512())
  }
}

fn absorb(st: State, data: Bytes) -> State {
  match st {
    M5(h) => {
      var x = h
      x.write(data)
      State.M5(h: x)
    }
    S1(h) => {
      var x = h
      x.write(data)
      State.S1(h: x)
    }
    S2(h) => {
      var x = h
      x.write(data)
      State.S2(h: x)
    }
    S3(s) => {
      var x = s
      sha3.write(x, data)
      State.S3(s: x)
    }
  }
}

fn finish(st: State) -> Bytes {
  match st {
    M5(h) => h.sum()
    S1(h) => h.sum()
    S2(h) => h.sum()
    S3(s) => {
      // sha3.sum squeezes: a copy keeps st able to absorb more
      var x = s
      sha3.sum(x)
    }
  }
}

fn digest(h: crypto.Hash, data: Bytes) -> Bytes { finish(absorb(fresh(h), data)) }

/// The key as HMAC pads it: hashed when longer than the block, then
/// XORed with the pad byte over the block.
fn padded_key(h: crypto.Hash, key: Bytes, x: Int) -> Bytes {
  let bs = block_of(h)
  let k = if key.len() > bs { digest(h, key) } else { key }
  var out = BytesBuilder.with_capacity(bs)
  for i in 0..bs {
    let v = if i < k.len() { Int(k[i]) } else { 0 }
    out.write_byte(UInt8(v ^ x))
  }
  out.freeze()
}

fn hasher(h: crypto.Hash) -> Hasher { Hasher{hash: h, st: fresh(h), opad: b"", total: 0} }

fn hmac_hasher(h: crypto.Hash, key: Bytes) -> Hasher {
  Hasher{hash: h, st: absorb(fresh(h), padded_key(h, key, 0x36)), opad: padded_key(h, key, 0x5c), total: 0}
}

fn (var x: Hasher) write(data: Bytes) {
  x.st = absorb(x.st, data)
  x.total += data.len()
}

fn (x: Hasher) sum() -> Bytes {
  let inner = finish(x.st)
  if x.opad.is_empty() {
    return inner
  }
  finish(absorb(absorb(fresh(x.hash), x.opad), inner))
}

fn (x: Hasher) written() -> Int { x.total }

fn hmac(h: crypto.Hash, key: Bytes, msg: Bytes) -> Bytes {
  var x = hmac_hasher(h, key)
  x.write(msg)
  x.sum()
}

// ---------------------------------------------------------------------------
// AEAD and HKDF (std.md 11): the TLS stack's AES-GCM (aesgcm.xo's Gcm, its
// key schedule and GHASH table made once a key) and ChaCha20-Poly1305
// (chacha.xo), and HKDF over this file's HMAC for every Hash.

/// Go's cipher error text, the same for every check that fails.
const AEAD_FAIL = "cipher: message authentication failed"

fn aead_nonce_size(a: crypto.Aead) -> Int { 12 }
fn aead_overhead(a: crypto.Aead) -> Int { 16 }
fn aeaderr_display(e: crypto.AeadErr) -> Str { e.msg }

/// The key: AES-GCM's ready Gcm, or ChaCha20-Poly1305's 32 bytes. Never
/// displayed or encoded (no Display; the declaration has none).
struct AeadKey {
  which: crypto.Aead
  gcm: aesgcm.Gcm?
  key: Bytes
}

fn aead_key(alg: crypto.Aead, key: Bytes) -> AeadKey ! crypto.AeadErr {
  match alg {
    AesGcm => {
      if !(key.len() is 16 | 24 | 32) {
        return Err(crypto.AeadErr{msg: "crypto/aes: invalid key size ${key.len()}"})
      }
      Ok(AeadKey{which: alg, gcm: Some(aesgcm.new_gcm(key)), key: b""})
    }
    ChaCha20Poly1305 => {
      if key.len() != 32 {
        return Err(crypto.AeadErr{msg: "chacha20poly1305: bad key length"})
      }
      Ok(AeadKey{which: alg, gcm: None, key: key})
    }
  }
}

fn (k: AeadKey) alg() -> crypto.Aead { k.which }

fn (k: AeadKey) seal(nonce: Bytes, plaintext: Bytes, aad: Bytes = b"") -> Bytes {
  if nonce.len() != 12 {
    fault("crypto: AEAD nonce of ${nonce.len()} bytes, want 12")
  }
  match k.gcm {
    Some(g) => g.seal(nonce, plaintext, aad)
    None => chacha.seal(k.key, nonce, plaintext, aad)
  }
}

fn (k: AeadKey) open(nonce: Bytes, sealed: Bytes, aad: Bytes = b"") -> Bytes ! crypto.AeadErr {
  if nonce.len() != 12 {
    fault("crypto: AEAD nonce of ${nonce.len()} bytes, want 12")
  }
  if sealed.len() < 16 {
    return Err(crypto.AeadErr{msg: AEAD_FAIL})
  }
  let got = match k.gcm {
    Some(g) => g.open(nonce, sealed, aad)
    None => chacha.open(k.key, nonce, sealed, aad)
  }
  match got {
    Some(pt) => Ok(pt)
    None => Err(crypto.AeadErr{msg: AEAD_FAIL})
  }
}

fn (k: AeadKey) seal_random(r: Rand, plaintext: Bytes, aad: Bytes = b"") -> Bytes uses rand {
  let nonce = r.bytes(12)
  var b = BytesBuilder.with_capacity(12 + plaintext.len() + 16)
  b.write(nonce)
  b.write(k.seal(nonce, plaintext, aad))
  b.freeze()
}

fn (k: AeadKey) open_random(sealed: Bytes, aad: Bytes = b"") -> Bytes ! crypto.AeadErr {
  if sealed.len() < 12 + 16 {
    return Err(crypto.AeadErr{msg: AEAD_FAIL})
  }
  k.open(sealed[0..12], sealed[12..sealed.len()], aad)
}

/// The TLS stack's hash number for SHA-2 (its HKDF's fast path), else -1.
fn sha2_of(h: crypto.Hash) -> Int {
  match h {
    Sha224 => sha256.HASH_SHA224
    Sha256 => sha256.HASH_SHA256
    Sha384 => sha256.HASH_SHA384
    Sha512 => sha256.HASH_SHA512
    _ => -1
  }
}

fn hkdf_extract(h: crypto.Hash, secret: Bytes, salt: Bytes = b"") -> Bytes {
  let s2 = sha2_of(h)
  if s2 >= 0 {
    // the TLS key schedule's HKDF (llrt hkdf.xo)
    return hk.extract(s2, salt, secret)
  }
  if salt.len() > 0 {
    return hmac(h, salt, secret)
  }
  var z = BytesBuilder.with_capacity(hash_size(h))
  for _ in 0..hash_size(h) {
    z.write_byte(0)
  }
  hmac(h, z.freeze(), secret)
}

fn hkdf_expand(h: crypto.Hash, prk: Bytes, info: Bytes, n: Int) -> Bytes {
  let size = hash_size(h)
  if n < 0 || n > 255 * size {
    fault("crypto: hkdf_expand of ${n} bytes, at most ${255 * size} for this hash")
  }
  let s2 = sha2_of(h)
  if s2 >= 0 {
    return hk.expand(s2, prk, info, n)
  }
  // the keyed HMAC state made once, copied for each block (a Hasher is a value)
  let keyed = hmac_hasher(h, prk)
  var out = BytesBuilder.with_capacity(n)
  var t = b""
  var i = 1
  while out.len() < n {
    var x = keyed
    x.write(t)
    x.write(info)
    var c = BytesBuilder.with_capacity(1)
    c.write_byte(UInt8(i))
    x.write(c.freeze())
    t = x.sum()
    let k = if n - out.len() < t.len() { n - out.len() } else { t.len() }
    out.write(t[0..k])
    i += 1
  }
  out.freeze()
}

fn hkdf(h: crypto.Hash, secret: Bytes, salt: Bytes, info: Bytes, n: Int) -> Bytes {
  hkdf_expand(h, hkdf_extract(h, secret, salt), info, n)
}

// ---------------------------------------------------------------------------
// PEM (encoding/pem of go1.26, ported with the same results; decision 0285)

fn keyerr_display(e: crypto.KeyErr) -> Str { e.msg }

/// getLine: the line without its `\n` (and a `\r` before it), right
/// trimmed of spaces and tabs; the rest; the bytes consumed.
fn pem_line(b: Bytes, at: Int) -> (Bytes, Int, Int) {
  var i = at
  while i < b.len() && b[i] != 10 {
    i += 1
  }
  var j = i
  if i < b.len() {
    j = i + 1
    if i > at && b[i - 1] == 13 {
      i -= 1
    }
  }
  while i > at && (b[i - 1] == 32 || b[i - 1] == 9) {
    i -= 1
  }
  (b[at..i], j, j - at)
}

fn pem_index(b: Bytes, from: Int, to: Int, p: Bytes) -> Int {
  var i = from
  while i + p.len() <= to {
    var ok = true
    for k in 0..p.len() {
      if b[i + k] != p[k] {
        ok = false
        break
      }
    }
    if ok {
      return i
    }
    i += 1
  }
  -1
}

fn pem_last_index(b: Bytes, from: Int, to: Int, p: Bytes) -> Int {
  var i = to - p.len()
  while i >= from {
    var ok = true
    for k in 0..p.len() {
      if b[i + k] != p[k] {
        ok = false
        break
      }
    }
    if ok {
      return i
    }
    i -= 1
  }
  -1
}

fn trim_space_bytes(b: Bytes) -> Bytes {
  var s = 0
  var e = b.len()
  while s < e && (b[s] == 32 || b[s] == 9 || b[s] == 10 || b[s] == 13 || b[s] == 11 || b[s] == 12) {
    s += 1
  }
  while e > s && (b[e - 1] == 32 || b[e - 1] == 9 || b[e - 1] == 10 || b[e - 1] == 13 || b[e - 1] == 11 || b[e - 1] == 12) {
    e -= 1
  }
  b[s..e]
}

fn lossy_text(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = StrBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write("${r}")
    i += n
  }
  out.freeze()
}

/// pem.Decode from offset `at` of data: the block and the offset of the
/// rest, or None (no more blocks).
fn pem_decode_one(data: Bytes, at: Int) -> (crypto.PemBlock, Int)? {
  let start = "\n-----BEGIN ".bytes()
  let end = "\n-----END ".bytes()
  let eol = "-----".bytes()
  var rest = at
  var end_trailer = 0
  while {
    if end_trailer < 0 || end_trailer > data.len() - rest {
      return None
    }
    rest += end_trailer
    let ei = pem_index(data, rest, data.len(), end)
    if ei < 0 {
      return None
    }
    var end_index = ei - rest
    end_trailer = end_index + end.len()
    let bi0 = pem_last_index(data, rest, rest + end_index, start[1..])
    if bi0 < 0 || (bi0 > rest && data[bi0 - 1] != 10) {
      continue
    }
    let begin_index = bi0 - rest
    rest += begin_index + start.len() - 1
    end_index -= begin_index + start.len() - 1
    end_trailer -= begin_index + start.len() - 1
    let (type_line0, next, consumed) = pem_line(data, rest)
    rest = next
    end_index -= consumed
    end_trailer -= consumed
    if type_line0.len() < eol.len() || type_line0[type_line0.len() - eol.len()..] != eol {
      continue
    }
    let type_line = type_line0[0..type_line0.len() - eol.len()]
    var headers: Map[Str, Str] = {}
    var eof = false
    while {
      if rest >= data.len() {
        eof = true
        break
      }
      let (line, nx, c) = pem_line(data, rest)
      let colon = pem_index(line, 0, line.len(), b":")
      if colon < 0 {
        break
      }
      headers.put(lossy_text(trim_space_bytes(line[0..colon])), lossy_text(trim_space_bytes(line[colon + 1..])))
      rest = nx
      end_index -= c
      end_trailer -= c
    }
    if eof {
      return None
    }
    if !headers.is_empty() && end_index < 0 {
      continue
    }
    if end_trailer < 0 || rest + end_trailer > data.len() {
      continue
    }
    let et = rest + end_trailer
    let et_len = type_line.len() + eol.len()
    if data.len() - et < et_len {
      continue
    }
    let trailer = data[et..et + et_len]
    if trailer[0..type_line.len()] != type_line || trailer[type_line.len()..] != eol {
      continue
    }
    let (after, _, _) = pem_line(data, et + et_len)
    if !after.is_empty() {
      continue
    }
    var bytes = b""
    if end_index > 0 {
      var b64 = BytesBuilder.with_capacity(end_index)
      for c in data[rest..rest + end_index] {
        if c != 32 && c != 9 {
          b64.write_byte(c)
        }
      }
      // the base64 text is ASCII when it decodes; other bytes fail
      match base64.decode(lossy_text(b64.freeze())) {
        Ok(b) => bytes = b
        Err(_) => continue
      }
    }
    let (_, after_end, _) = pem_line(data, rest + end_index + end.len() - 1)
    return Some((crypto.PemBlock{kind: lossy_text(type_line), headers: headers, bytes: bytes}, after_end))
  }
  None
}

fn pem_decode(text: Str) -> List[crypto.PemBlock] {
  let data = text.bytes()
  var out: List[crypto.PemBlock] = []
  var at = 0
  while let Some((b, next)) = pem_decode_one(data, at) {
    out.push(b)
    at = next
  }
  out
}

fn pem_encode(b: crypto.PemBlock) -> Str ! crypto.KeyErr {
  for k in b.headers.keys() {
    if k.contains(":") {
      return Err(crypto.KeyErr{msg: "pem: cannot encode a header key that contains a colon"})
    }
  }
  var out = StrBuilder.new()
  out.write("-----BEGIN ${b.kind}-----\n")
  if !b.headers.is_empty() {
    if let Some(v) = b.headers.get("Proc-Type") {
      out.write("Proc-Type: ${v}\n")
    }
    for k in b.headers.keys().sort() {
      if k != "Proc-Type" {
        out.write("${k}: ${b.headers.get(k) ?? ""}\n")
      }
    }
    out.write("\n")
  }
  let enc = base64.encode(b.bytes)
  var i = 0
  while i < enc.len() {
    let j = if i + 64 < enc.len() { i + 64 } else { enc.len() }
    out.write(enc[i..j])
    out.write("\n")
    i = j
  }
  out.write("-----END ${b.kind}-----\n")
  out.freeze()
}

// ---------------------------------------------------------------------------
// Public keys (crypto/x509 ParsePKIXPublicKey, ParsePKCS1PublicKey, and
// MarshalPKIXPublicKey of go1.26; decision 0285)

const OID_RSA: Str = "1.2.840.113549.1.1.1"
const OID_EC: Str = "1.2.840.10045.2.1"
const OID_ED25519: Str = "1.3.101.112"

/// A public key: RSA's modulus and exponent, or an elliptic curve point
/// (uncompressed) or an Ed25519 key in `key`.
struct PublicKey {
  kind: crypto.KeyAlg
  n: Bytes
  e: Int
  key: Bytes
}

fn (k: PublicKey) alg() -> crypto.KeyAlg { k.kind }

fn key_err(msg: Str) -> crypto.KeyErr { crypto.KeyErr{msg: msg} }

/// An INTEGER's sign and magnitude as cryptobyte's ReadASN1Integer reads
/// it: None unless t is a minimal INTEGER; (sign, magnitude) with sign -1,
/// 0, or 1.
fn big_int(b: Bytes, t: asn1.Tlv) -> (Int, Bytes)? {
  if t.tag != asn1.INTEGER || t.hi == t.lo {
    return None
  }
  if t.hi - t.lo > 1 {
    let a = Int(b[t.lo])
    let c = Int(b[t.lo + 1])
    if (a == 0 && c < 128) || (a == 255 && c >= 128) {
      return None
    }
  }
  if Int(b[t.lo]) >= 128 {
    return Some((-1, b""))
  }
  var lo = t.lo
  while lo < t.hi - 1 && b[lo] == 0 {
    lo += 1
  }
  if lo == t.hi - 1 && b[lo] == 0 {
    return Some((0, b""))
  }
  Some((1, b[lo..t.hi]))
}

/// The curve of a named curve OID.
fn curve_of(oid: Str) -> crypto.KeyAlg? {
  match oid {
    "1.3.132.0.33" => Some(crypto.KeyAlg.EcdsaP224)
    "1.2.840.10045.3.1.7" => Some(crypto.KeyAlg.EcdsaP256)
    "1.3.132.0.34" => Some(crypto.KeyAlg.EcdsaP384)
    "1.3.132.0.35" => Some(crypto.KeyAlg.EcdsaP521)
    _ => None
  }
}

fn nist_curve(a: crypto.KeyAlg) -> Int {
  match a {
    EcdsaP224 => nistec.P224
    EcdsaP384 => nistec.P384
    EcdsaP521 => nistec.P521
    _ => nistec.P256
  }
}

fn curve_oid(a: crypto.KeyAlg) -> Str {
  match a {
    EcdsaP224 => "1.3.132.0.33"
    EcdsaP384 => "1.3.132.0.34"
    EcdsaP521 => "1.3.132.0.35"
    _ => "1.2.840.10045.3.1.7"
  }
}

fn curve_name(a: crypto.KeyAlg) -> Str {
  match a {
    EcdsaP224 => "P224"
    EcdsaP384 => "P384"
    EcdsaP521 => "P521"
    _ => "P256"
  }
}

/// A SubjectPublicKeyInfo's parts as encoding/asn1 unmarshals them (the
/// fields in order; bytes after the last field of a SEQUENCE ignored):
/// the algorithm OID, the parameters' full bytes, the key bits, and
/// whether the element is all of der; None when der is not one.
fn spki_parts(der: Bytes) -> (Str, Bytes, Bytes, Bool)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let a = asn1.read(der, t.lo, t.hi)
  if a.tag != asn1.SEQUENCE {
    return None
  }
  let bs = asn1.read(der, a.next, t.hi)
  if bs.tag != asn1.BIT_STRING {
    return None
  }
  let o = asn1.read(der, a.lo, a.hi)
  if o.tag != asn1.OID {
    return None
  }
  let oid = asn1.oid(der, o)
  if oid.is_empty() {
    return None
  }
  var pfull = b""
  if o.next < a.hi {
    let pv = asn1.read(der, o.next, a.hi)
    if pv.tag < 0 {
      return None
    }
    pfull = der[o.next..pv.next]
  }
  // BIT STRING: the count of unused bits, which must be zero in its last byte
  if bs.hi == bs.lo {
    return None
  }
  let pad = Int(der[bs.lo])
  if pad > 7 || (bs.hi - bs.lo == 1 && pad > 0) || (pad > 0 && (Int(der[bs.hi - 1]) & ((1 << pad) - 1)) != 0) {
    return None
  }
  var bits = der[bs.lo + 1..bs.hi]
  if pad > 0 {
    // RightAlign: shift the bits right by the padding
    var out = BytesBuilder.with_capacity(bits.len())
    var carry = 0
    for c in bits {
      let v = Int(c)
      out.write_byte(UInt8(((carry << (8 - pad)) | (v >> pad)) & 255))
      carry = v & ((1 << pad) - 1)
    }
    bits = out.freeze()
  }
  Some((oid, pfull, bits, t.next == der.len()))
}

/// A PKCS #1 RSAPublicKey as encoding/asn1 unmarshals it: (N, E) or None.
fn pkcs1_parts(der: Bytes) -> ((Int, Bytes), Int?, Bool)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let nt = asn1.read(der, t.lo, t.hi)
  let n = big_int(der, nt)?
  let et = asn1.read(der, nt.next, t.hi)
  if et.tag != asn1.INTEGER {
    return None
  }
  Some((n, asn1.small_int(der, et), t.next == der.len()))
}

fn parse_pkcs1_public(der: Bytes) -> PublicKey ! crypto.KeyErr {
  let (n, e, whole) = match pkcs1_parts(der) {
    Some(p) => p
    None => return Err(key_err("x509: malformed public key"))
  }
  let ev = match e {
    Some(v) => v
    None => return Err(key_err("x509: malformed public key"))
  }
  if !whole {
    return Err(key_err("x509: malformed public key"))
  }
  if n.0 <= 0 || ev <= 0 {
    return Err(key_err("x509: public key contains zero or negative value"))
  }
  if ev > 2147483647 {
    return Err(key_err("x509: public key contains large public exponent"))
  }
  PublicKey{kind: crypto.KeyAlg.Rsa, n: n.1, e: ev, key: b""}
}

fn parse_public_key(der: Bytes) -> PublicKey ! crypto.KeyErr {
  let (oid, params, data, whole) = match spki_parts(der) {
    Some(p) => p
    None => return parse_pkcs1_public(der)
  }
  if !whole {
    return Err(key_err("x509: trailing data after ASN.1 of public-key"))
  }
  if oid == OID_RSA {
    if params != b"\x05\x00" {
      return Err(key_err("x509: RSA key missing NULL parameters"))
    }
    let t = asn1.read(data, 0, data.len())
    if t.tag != asn1.SEQUENCE {
      return Err(key_err("x509: invalid RSA public key"))
    }
    let nt = asn1.read(data, t.lo, t.hi)
    let nv = match big_int(data, nt) {
      Some(v) => v
      None => return Err(key_err("x509: invalid RSA modulus"))
    }
    let et = asn1.read(data, nt.next, t.hi)
    let e = asn1.small_int(data, et)
    let ev = match e {
      Some(v) => v
      None => return Err(key_err("x509: invalid RSA public exponent"))
    }
    if nv.0 <= 0 {
      return Err(key_err("x509: RSA modulus is not a positive number"))
    }
    if ev <= 0 {
      return Err(key_err("x509: RSA public exponent is not a positive number"))
    }
    return PublicKey{kind: crypto.KeyAlg.Rsa, n: nv.1, e: ev, key: b""}
  }
  if oid == OID_EC {
    let p = asn1.read(params, 0, params.len())
    let coid = if p.tag == asn1.OID { asn1.oid(params, p) } else { "" }
    if coid.is_empty() {
      return Err(key_err("x509: invalid ECDSA parameters"))
    }
    let alg = match curve_of(coid) {
      Some(a) => a
      None => return Err(key_err("x509: unsupported elliptic curve"))
    }
    if data.is_empty() || data[0] != 4 {
      return Err(key_err("ecdsa: invalid uncompressed public key"))
    }
    match nistec.point_check(nist_curve(alg), data) {
      0 => ()
      1 => return Err(key_err("invalid ${curve_name(alg)} point encoding"))
      2 => return Err(key_err("invalid ${curve_name(alg)}Element encoding"))
      _ => return Err(key_err("${curve_name(alg)} point not on curve"))
    }
    return PublicKey{kind: alg, n: b"", e: 0, key: data}
  }
  if oid == OID_ED25519 {
    if !params.is_empty() {
      return Err(key_err("x509: Ed25519 key encoded with illegal parameters"))
    }
    if data.len() != 32 {
      return Err(key_err("x509: wrong Ed25519 public key size"))
    }
    return PublicKey{kind: crypto.KeyAlg.Ed25519, n: b"", e: 0, key: data}
  }
  Err(key_err("x509: unknown public key algorithm"))
}

fn oid_der(oid: Str) -> Bytes {
  let parts = oid.split(".").map(fn(x) { Int.parse(x) ?? 0 })
  var out = BytesBuilder.new()
  var vals = [parts[0] * 40 + parts[1]]
  for i in 2..parts.len() {
    vals.push(parts[i])
  }
  for v in vals {
    var groups: List[Int] = [v & 127]
    var x = v >> 7
    while x > 0 {
      groups.push((x & 127) | 128)
      x = x >> 7
    }
    var i = groups.len() - 1
    while i >= 0 {
      out.write_byte(UInt8(groups[i]))
      i -= 1
    }
  }
  asn1.enc(asn1.OID, out.freeze())
}

fn marshal_public_key(k: PublicKey) -> Bytes {
  match k.kind {
    Rsa => {
      var e = BytesBuilder.new()
      var started = false
      for sh in [56, 48, 40, 32, 24, 16, 8, 0] {
        let byte = (k.e >> sh) & 255
        if byte != 0 || started || sh == 0 {
          e.write_byte(UInt8(byte))
          started = true
        }
      }
      let body = asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc_uint(k.n), asn1.enc_uint(e.freeze())]))
      asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc(asn1.SEQUENCE, asn1.cat([oid_der(OID_RSA), b"\x05\x00"])), asn1.enc(asn1.BIT_STRING, b"\x00" + body)]))
    }
    Ed25519 => asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc(asn1.SEQUENCE, oid_der(OID_ED25519)), asn1.enc(asn1.BIT_STRING, b"\x00" + k.key)]))
    _ => asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc(asn1.SEQUENCE, asn1.cat([oid_der(OID_EC), oid_der(curve_oid(k.kind))])), asn1.enc(asn1.BIT_STRING, b"\x00" + k.key)]))
  }
}

// ---------------------------------------------------------------------------
// Private keys (crypto/x509 ParsePKCS8PrivateKey, ParsePKCS1PrivateKey,
// ParseECPrivateKey, and crypto/rsa's key checks of go1.26; decision 0285)

/// A private key: RSA's values (big endian, minimal), or an ECDSA scalar
/// (the curve's size) or an Ed25519 seed in `d`; its public key.
struct PrivateKey {
  kind: crypto.KeyAlg
  rsa: rsa.PrivateKey
  d: Bytes
  public: PublicKey
}

fn (k: PrivateKey) alg() -> crypto.KeyAlg { k.kind }

fn (k: PrivateKey) public_key() -> PublicKey { k.public }

fn no_rsa() -> rsa.PrivateKey { rsa.PrivateKey{n: b"", e: 0, d: b"", p: b"", q: b"", dp: b"", dq: b"", qinv: b""} }

/// encoding/asn1's reading of a SEQUENCE's fields: the elements in order
/// from its start, stopping at the first that does not parse (Go reads
/// only the fields its struct has and ignores the rest).
fn fields(b: Bytes, t: asn1.Tlv) -> List[asn1.Tlv] {
  var out: List[asn1.Tlv] = []
  var pos = t.lo
  while pos < t.hi {
    let e = asn1.read(b, pos, t.hi)
    out.push(e)
    if e.tag < 0 {
      break
    }
    pos = e.next
  }
  out
}

/// A minimal INTEGER that fits Go's int.
fn go_int(b: Bytes, t: asn1.Tlv) -> Int? {
  if t.tag != asn1.INTEGER {
    return None
  }
  asn1.small_int(b, t)
}

/// The fields of a PKCS #8 PrivateKeyInfo (version, algorithm OID, its
/// parameters' full bytes, the key octets), as Go unmarshals it.
fn pkcs8_parts(der: Bytes) -> (Str, Bytes, Bytes)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let xs = fields(der, t)
  if xs.len() < 3 || go_int(der, xs[0]) == None || xs[1].tag != asn1.SEQUENCE || xs[2].tag != asn1.OCTET_STRING {
    return None
  }
  let o = asn1.read(der, xs[1].lo, xs[1].hi)
  if o.tag != asn1.OID {
    return None
  }
  let oid = asn1.oid(der, o)
  if oid.is_empty() {
    return None
  }
  var pfull = b""
  if o.next < xs[1].hi {
    let pv = asn1.read(der, o.next, xs[1].hi)
    if pv.tag < 0 {
      return None
    }
    pfull = der[o.next..pv.next]
  }
  Some((oid, pfull, asn1.contents(der, xs[2])))
}

/// The fields of a SEC 1 ECPrivateKey: version, the key octets, and the
/// named curve OID ("" when absent), as Go unmarshals it.
fn ec_parts(der: Bytes) -> (Int, Bytes, Str)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let xs = fields(der, t)
  if xs.len() < 2 || xs[1].tag != asn1.OCTET_STRING {
    return None
  }
  let v = go_int(der, xs[0])?
  var oid = ""
  var i = 2
  // the optional explicit [0] curve and [1] public key: an inner element
  // of another type is skipped, as encoding/asn1 skips an optional field
  if i < xs.len() && xs[i].tag == 0xa0 {
    let o = asn1.read(der, xs[i].lo, xs[i].hi)
    if o.tag < 0 {
      return None
    }
    if o.tag == asn1.OID {
      oid = asn1.oid(der, o)
      if oid.is_empty() {
        return None
      }
    }
    i += 1
  } else if i < xs.len() && xs[i].tag < 0 {
    return None
  }
  if i < xs.len() && xs[i].tag == 0xa1 {
    let bs = asn1.read(der, xs[i].lo, xs[i].hi)
    if bs.tag < 0 || (bs.tag == asn1.BIT_STRING && (bs.hi == bs.lo || Int(der[bs.lo]) > 7)) {
      return None
    }
  } else if i < xs.len() && xs[i].tag < 0 {
    return None
  }
  Some((v, asn1.contents(der, xs[1]), oid))
}

/// A signed big integer field: (sign, minimal magnitude).
struct Big {
  sign: Int
  mag: Bytes
}

/// The fields of a PKCS #1 RSAPrivateKey (version, n, e, d, p, q, then dp,
/// dq, qinv when present; whether more primes follow), with the bytes
/// after the element.
fn pkcs1_priv_parts(der: Bytes) -> (Int, List[Big], Int, Bool, Bool)? {
  let t = asn1.read(der, 0, der.len())
  if t.tag != asn1.SEQUENCE {
    return None
  }
  let xs = fields(der, t)
  if xs.len() < 6 {
    return None
  }
  let v = go_int(der, xs[0])?
  let e = go_int(der, xs[2])?
  var bigs: List[Big] = []
  for k in [1, 3, 4, 5] {
    let (s, m) = big_int(der, xs[k])?
    bigs.push(Big{sign: s, mag: m})
  }
  var i = 6
  var crt = 0
  while crt < 3 && i < xs.len() && xs[i].tag == asn1.INTEGER {
    let (s, m) = big_int(der, xs[i])?
    bigs.push(Big{sign: s, mag: m})
    crt += 1
    i += 1
  }
  if i < xs.len() && xs[i].tag < 0 {
    return None
  }
  let more = i < xs.len() && xs[i].tag == asn1.SEQUENCE
  Some((v, bigs, e, more, t.next == der.len()))
}

/// The Go text of a failed parse: encoding/asn1's own texts (which name
/// its internal types) become one.
const MALFORMED_PRIVATE: Str = "x509: malformed private key"

fn limbs(b: Bytes) -> List[Int] { bigmod.from_bytes(b, (b.len() + 7) / 8) ?? [] }

fn limbs_n(b: Bytes, n: Int) -> List[Int]? { bigmod.from_bytes(b, n) }

/// bigmod's SetBytes of b for the modulus m: "" or Go's error.
fn set_bytes_err(b: Bytes, m: List[Int]) -> Str {
  match limbs_n(b, m.len()) {
    None => "input overflows the modulus size"
    Some(x) => if bigmod.less(x, m) { "" } else { "input overflows the modulus" }
  }
}

fn bits_of(b: Bytes) -> Int { bigmod.bit_len(limbs(b)) }

/// rsa.NewPrivateKeyWithPrecomputation's and checkPrivateKey's checks
/// (crypto/internal/fips140/rsa): "" or Go's error.
fn rsa_check(n: Bytes, e: Int, d: Bytes, p: Bytes, q: Bytes, dp: Bytes, dq: Bytes, qinv: Bytes) -> Str {
  for x in [n, p, q] {
    let l = limbs(x)
    if l.is_empty() || bigmod.bit_len(l) <= 1 {
      return "modulus must be > 1"
    }
  }
  let nl = limbs(n)
  let pl = limbs(p)
  let ql = limbs(q)
  let de = set_bytes_err(d, nl)
  if !de.is_empty() {
    return de
  }
  let qe = set_bytes_err(qinv, pl)
  if !qe.is_empty() {
    return qe
  }
  // checkPublicKey
  if (nl[0] & 1) == 0 {
    return "crypto/rsa: public modulus is even"
  }
  if e < 2 {
    return "crypto/rsa: public exponent too small or negative"
  }
  if (e & 1) == 0 {
    return "crypto/rsa: public exponent is even"
  }
  if e > 2147483647 {
    return "crypto/rsa: public exponent too large"
  }
  // p and q below n; p q = n
  if !set_bytes_err(p, nl).is_empty() || !set_bytes_err(q, nl).is_empty() {
    return "crypto/rsa: invalid prime"
  }
  if !bigmod.is_zero_any(bigmod.mul_mod_any(limbs_n(p, nl.len()) ?? [], limbs_n(q, nl.len()) ?? [], nl)) {
    return "crypto/rsa: p * q != n"
  }
  let el = limbs(rsa_e_bytes(e))
  for (prime, dx) in [(pl, dp), (ql, dq)] {
    let pm1 = bigmod.trim(bigmod.sub_one(prime))
    if bigmod.bit_len(pm1) <= 1 {
      return "crypto/rsa: invalid prime"
    }
    if !set_bytes_err(dx, pm1).is_empty() {
      return "crypto/rsa: invalid CRT exponent"
    }
    if !bigmod.is_one(bigmod.mul_mod_any(el, limbs(dx), pm1)) {
      return "crypto/rsa: invalid CRT exponent"
    }
  }
  // q mod p, times qinv, is 1 mod p
  let qp = bigmod.mod_any(ql, pl)
  if !bigmod.is_one(bigmod.mul_mod_any(qp, limbs(qinv), pl)) {
    return "crypto/rsa: invalid CRT coefficient"
  }
  let dl = limbs(d)
  if !bigmod.equal(bigmod.mod_any(dl, bigmod.trim(bigmod.sub_one(pl))), limbs(dp)) {
    return "crypto/rsa: d does not match dP"
  }
  if !bigmod.equal(bigmod.mod_any(dl, bigmod.trim(bigmod.sub_one(ql))), limbs(dq)) {
    return "crypto/rsa: d does not match dQ"
  }
  // |p - q| above 2^(bits(n)/2 - 100)
  let pq = if bigmod.less(ql, pl) { bigmod.sub_plain(pl, ql) } else if bigmod.less(pl, ql) { bigmod.sub_plain(ql, pl) } else { [] }
  if pq.is_empty() {
    return "crypto/rsa: p == q"
  }
  if bigmod.bit_len(pq) <= bigmod.bit_len(nl) / 2 - 100 {
    return "crypto/rsa: |p - q| too small"
  }
  if bigmod.bit_len(dl) <= bigmod.bit_len(nl) / 2 {
    return "crypto/rsa: d too small"
  }
  ""
}

/// b without leading zero bytes (at least one byte).
fn minimal(b: Bytes) -> Bytes {
  var i = 0
  while i < b.len() - 1 && b[i] == 0 {
    i += 1
  }
  b[i..]
}

fn rsa_e_bytes(e: Int) -> Bytes {
  var b = BytesBuilder.new()
  var started = false
  for sh in [56, 48, 40, 32, 24, 16, 8, 0] {
    let x = (e >> sh) & 255
    if x != 0 || started || sh == 0 {
      b.write_byte(UInt8(x))
      started = true
    }
  }
  b.freeze()
}

/// ParsePKCS1PrivateKey after the hint: the key or Go's error.
fn parse_pkcs1_private(der: Bytes) -> PrivateKey ! Str {
  let (v, bigs, e, more, whole) = match pkcs1_priv_parts(der) {
    Some(x) => x
    None => return Err(MALFORMED_PRIVATE)
  }
  if !whole {
    return Err(MALFORMED_PRIVATE)
  }
  if v > 1 {
    return Err("x509: unsupported private key version")
  }
  for b in bigs {
    if b.sign <= 0 {
      return Err("x509: private key contains zero or negative value")
    }
  }
  if more {
    return Err("crypto/rsa: multi-prime keys are not supported")
  }
  let n = bigs[0].mag
  let d = bigs[1].mag
  let p = bigs[2].mag
  let q = bigs[3].mag
  var dp = b""
  var dq = b""
  var qinv = b""
  if bigs.len() < 7 {
    // NewPrivateKey: the CRT values from d, p, and q (the given ones are
    // dropped, as Go's precompute does when one is missing)
    for x in [n, p, q] {
      let l = limbs(x)
      if l.is_empty() || bigmod.bit_len(l) <= 1 {
        return Err("modulus must be > 1")
      }
    }
    let de = set_bytes_err(d, limbs(n))
    if !de.is_empty() {
      return Err(de)
    }
    let pl = limbs(p)
    let ql = limbs(q)
    let pm1 = bigmod.trim(bigmod.sub_one(pl))
    let qm1 = bigmod.trim(bigmod.sub_one(ql))
    if bigmod.bit_len(pm1) <= 1 || bigmod.bit_len(qm1) <= 1 {
      return Err("modulus must be > 1")
    }
    dp = minimal(bigmod.to_bytes(bigmod.mod_any(limbs(d), pm1), 8 * pm1.len()))
    dq = minimal(bigmod.to_bytes(bigmod.mod_any(limbs(d), qm1), 8 * qm1.len()))
    if (pl[0] & 1) == 0 {
      return Err("crypto/rsa: p is even")
    }
    // qinv = q^(p - 2) mod p
    let pm = bigmod.modulus(pl)
    let pm2 = bigmod.sub_one(pm1)
    qinv = minimal(bigmod.to_bytes(bigmod.from_mont(pm, bigmod.exp(pm, bigmod.reduce(pm, ql), pm2)), 8 * pl.len()))
  } else {
    dp = bigs[4].mag
    dq = bigs[5].mag
    qinv = bigs[6].mag
  }
  let err = rsa_check(n, e, d, p, q, dp, dq, qinv)
  if !err.is_empty() {
    return Err(err)
  }
  let k = rsa.PrivateKey{n: n, e: e, d: d, p: p, q: q, dp: dp, dq: dq, qinv: qinv}
  PrivateKey{kind: crypto.KeyAlg.Rsa, rsa: k, d: b"", public: PublicKey{kind: crypto.KeyAlg.Rsa, n: n, e: e, key: b""}}
}

/// parseECPrivateKey (the curve from PKCS #8's parameters when given).
fn parse_ec_private(curve_oid: Str?, der: Bytes) -> PrivateKey ! Str {
  let (v, raw, oid) = match ec_parts(der) {
    Some(x) => x
    None => return Err("x509: failed to parse EC private key: malformed DER")
  }
  if v != 1 {
    return Err("x509: unknown EC private key version ${v}")
  }
  let alg = match curve_of(curve_oid ?? oid) {
    Some(a) => a
    None => return Err("x509: unknown elliptic curve")
  }
  let size = nistec.size(nist_curve(alg))
  var key = raw
  while key.len() > size {
    if key[0] != 0 {
      return Err("x509: invalid private key length")
    }
    key = key[1..]
  }
  var pad = BytesBuilder.with_capacity(size)
  for _ in 0..size - key.len() {
    pad.write_byte(0)
  }
  pad.write(key)
  let scalar = pad.freeze()
  let public = nistec.public_key(nist_curve(alg), scalar)
  if public.is_empty() {
    return Err("crypto/ecdsa: invalid private key")
  }
  PrivateKey{kind: alg, rsa: no_rsa(), d: scalar, public: PublicKey{kind: alg, n: b"", e: 0, key: public}}
}

/// ParsePKCS8PrivateKey, following its hints to ParsePKCS1PrivateKey and
/// ParseECPrivateKey.
fn parse_private(der: Bytes) -> PrivateKey ! Str {
  let (oid, params, key) = match pkcs8_parts(der) {
    Some(x) => x
    None => {
      if ec_parts(der) != None {
        return parse_ec_private(None, der)
      }
      if pkcs1_priv_parts(der) != None {
        return parse_pkcs1_private(der)
      }
      return Err(MALFORMED_PRIVATE)
    }
  }
  if oid == OID_RSA {
    return match parse_pkcs1_private(key) {
      Ok(k) => Ok(k)
      Err(e) => Err("x509: failed to parse RSA private key embedded in PKCS#8: ${if e == MALFORMED_PRIVATE { "malformed DER" } else { e }}")
    }
  }
  if oid == OID_EC {
    let p = asn1.read(params, 0, params.len())
    let coid = if p.tag == asn1.OID && p.next == params.len() { Some(asn1.oid(params, p)) } else { None }
    return match parse_ec_private(coid, key) {
      Ok(k) => Ok(k)
      Err(e) => Err("x509: failed to parse EC private key embedded in PKCS#8: ${e}")
    }
  }
  if oid == OID_ED25519 {
    if !params.is_empty() {
      return Err("x509: invalid Ed25519 private key parameters")
    }
    let t = asn1.read(key, 0, key.len())
    if t.tag != asn1.OCTET_STRING {
      return Err("x509: invalid Ed25519 private key: malformed DER")
    }
    let seed = asn1.contents(key, t)
    if seed.len() != 32 {
      return Err("x509: invalid Ed25519 private key length: ${seed.len()}")
    }
    return PrivateKey{kind: crypto.KeyAlg.Ed25519, rsa: no_rsa(), d: seed, public: PublicKey{kind: crypto.KeyAlg.Ed25519, n: b"", e: 0, key: ed25519.public_key(seed)}}
  }
  if oid == "1.3.101.110" {
    // X25519: Go's checks, then refused (a key agreement key, not a signer)
    if !params.is_empty() {
      return Err("x509: invalid X25519 private key parameters")
    }
    let t = asn1.read(key, 0, key.len())
    if t.tag != asn1.OCTET_STRING {
      return Err("x509: invalid X25519 private key: malformed DER")
    }
    if t.hi - t.lo != 32 {
      return Err("crypto/ecdh: invalid private key size")
    }
  }
  Err("x509: PKCS#8 wrapping contained private key with unknown algorithm: ${oid}")
}

/// Go's MarshalPKCS8PrivateKey: PKCS #8 around PKCS #1 (RSA), an
/// ECPrivateKey without its curve (it is in the algorithm) and with its
/// public key (ECDSA), or the seed (Ed25519).
fn marshal_private_key(k: PrivateKey) -> Bytes {
  let (alg, inner) = match k.kind {
    Rsa => {
      let r = k.rsa
      let pkcs1 = asn1.enc_seq([asn1.enc_int(0), asn1.enc_uint(r.n), asn1.enc_int(r.e), asn1.enc_uint(r.d), asn1.enc_uint(r.p), asn1.enc_uint(r.q), asn1.enc_uint(r.dp), asn1.enc_uint(r.dq), asn1.enc_uint(r.qinv)])
      (asn1.enc_seq([oid_der(OID_RSA), asn1.enc_null()]), pkcs1)
    }
    Ed25519 => (asn1.enc_seq([oid_der(OID_ED25519)]), asn1.enc_octets(k.d))
    _ => {
      let ec = asn1.enc_seq([asn1.enc_int(1), asn1.enc_octets(k.d), asn1.enc_explicit(1, asn1.enc_bits(k.public.key))])
      (asn1.enc_seq([oid_der(OID_EC), oid_der(curve_oid(k.kind))]), ec)
    }
  }
  asn1.enc_seq([asn1.enc_int(0), alg, asn1.enc_octets(inner)])
}

fn parse_private_key(der: Bytes) -> PrivateKey ! crypto.KeyErr { parse_private(der).map_err(fn(m) { key_err(m) }) }

// ---------------------------------------------------------------------------
// Signatures (crypto/rsa, crypto/ecdsa, crypto/ed25519 of go1.26; decision
// 0285)

/// The DigestInfo prefix of a hash (crypto/internal/fips140/rsa
/// hashPrefixes).
fn digest_info(h: crypto.Hash) -> Bytes {
  let hex = match h {
    Md5 => "3020300c06082a864886f70d020505000410"
    Sha1 => "3021300906052b0e03021a05000414"
    Sha224 => "302d300d06096086480165030402040500041c"
    Sha256 => "3031300d060960864801650304020105000420"
    Sha384 => "3041300d060960864801650304020205000430"
    Sha512 => "3051300d060960864801650304020305000440"
    Sha3_256 => "3031300d060960864801650304020805000420"
    Sha3_512 => "3051300d060960864801650304020a05000440"
  }
  Bytes.from_hex(hex) ?? b""
}

/// Go's public key checks before an RSA operation (checkPublicKeySize,
/// then fips140/rsa checkPublicKey): "" or the error.
fn rsa_public_err(n: Bytes, e: Int) -> Str {
  let bits = bits_of(n)
  if bits < 1024 {
    return "crypto/rsa: ${bits}-bit keys are insecure (see https://go.dev/pkg/crypto/rsa#hdr-Minimum_key_size)"
  }
  if (Int(n[n.len() - 1]) & 1) == 0 {
    return "crypto/rsa: public modulus is even"
  }
  if e < 2 {
    return "crypto/rsa: public exponent too small or negative"
  }
  if (e & 1) == 0 {
    return "crypto/rsa: public exponent is even"
  }
  if e > 2147483647 {
    return "crypto/rsa: public exponent too large"
  }
  ""
}

fn rsa_pub(k: PublicKey) -> rsa.PublicKey { rsa.PublicKey{n: k.n, e: k.e} }

fn is_ecdsa(a: crypto.KeyAlg) -> Bool { a is EcdsaP224 | EcdsaP256 | EcdsaP384 | EcdsaP521 }

fn verify(k: PublicKey, h: crypto.Hash, msg: Bytes, sig: Bytes) -> Bool {
  match k.kind {
    Rsa => rsa_public_err(k.n, k.e).is_empty() && rsa.verify_pkcs1_prefix(rsa_pub(k), digest_info(h), digest(h, msg), sig)
    Ed25519 => ed25519.verify(k.key, msg, sig)
    _ => nistec.verify(nist_curve(k.kind), k.key, digest(h, msg), sig)
  }
}

fn verify_pss(k: PublicKey, h: crypto.Hash, msg: Bytes, sig: Bytes) -> Bool {
  if k.kind != crypto.KeyAlg.Rsa || !rsa_public_err(k.n, k.e).is_empty() {
    return false
  }
  rsa.verify_pss_fn(rsa_pub(k), h.size(), fn(b) { digest(h, b) }, digest(h, msg), sig, -1)
}

/// r || s (each the curve's size) as DER.
fn raw_to_der(sig: Bytes, size: Int) -> Bytes? {
  if sig.len() != 2 * size {
    return None
  }
  Some(asn1.enc(asn1.SEQUENCE, asn1.cat([asn1.enc_uint(sig[0..size]), asn1.enc_uint(sig[size..])])))
}

fn verify_raw_ecdsa(k: PublicKey, h: crypto.Hash, msg: Bytes, sig: Bytes) -> Bool {
  if !is_ecdsa(k.kind) {
    return false
  }
  match raw_to_der(sig, nistec.size(nist_curve(k.kind))) {
    Some(der) => nistec.verify(nist_curve(k.kind), k.key, digest(h, msg), der)
    None => false
  }
}

fn sign(r: Rand, k: PrivateKey, h: crypto.Hash, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  let z = if is_ecdsa(k.kind) { r.bytes(nistec.size(nist_curve(k.kind))) } else { b"" }
  sign_z(k, h, msg, z)
}

/// sign with the ECDSA nonce's entropy z (size(curve) bytes).
fn sign_z(k: PrivateKey, h: crypto.Hash, msg: Bytes, z: Bytes) -> Bytes ! crypto.KeyErr {
  match k.kind {
    Rsa => {
      let e = rsa_public_err(k.rsa.n, k.rsa.e)
      if !e.is_empty() {
        return Err(key_err(e))
      }
      let s = rsa.sign_pkcs1_prefix(k.rsa, digest_info(h), digest(h, msg))
      if s.is_empty() {
        return Err(key_err("crypto/rsa: message too long for RSA key size"))
      }
      s
    }
    Ed25519 => ed25519.sign(k.d, msg)
    _ => {
      nistec.sign_hedged(nist_curve(k.kind), k.d, digest(h, msg), z)
    }
  }
}

fn sign_pss(r: Rand, k: PrivateKey, h: crypto.Hash, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand { sign_pss_with(k, h, msg, r.bytes(h.size())) }

/// sign_pss with the salt.
fn sign_pss_with(k: PrivateKey, h: crypto.Hash, msg: Bytes, salt: Bytes) -> Bytes ! crypto.KeyErr {
  if k.kind != crypto.KeyAlg.Rsa {
    return Err(key_err("crypto: sign_pss needs an RSA key"))
  }
  let e = rsa_public_err(k.rsa.n, k.rsa.e)
  if !e.is_empty() {
    return Err(key_err(e))
  }
  let s = rsa.sign_pss_fn(k.rsa, h.size(), fn(b) { digest(h, b) }, digest(h, msg), salt)
  if s.is_empty() {
    return Err(key_err("crypto/rsa: message too long for RSA key size"))
  }
  s
}

/// The fixed size r || s of a DER ECDSA signature.
fn der_to_raw(der: Bytes, size: Int) -> Bytes {
  let t = asn1.read(der, 0, der.len())
  let rt0 = asn1.read(der, t.lo, t.hi)
  let st = asn1.read(der, rt0.next, t.hi)
  let rb = asn1.uint_bytes(der, rt0) ?? b""
  let sb = asn1.uint_bytes(der, st) ?? b""
  var out = BytesBuilder.with_capacity(2 * size)
  for part in [rb, sb] {
    let m = if part.len() > 1 && part[0] == 0 { part[1..] } else { part }
    for _ in 0..size - m.len() {
      out.write_byte(0)
    }
    out.write(m)
  }
  out.freeze()
}

fn sign_raw_ecdsa(r: Rand, k: PrivateKey, h: crypto.Hash, msg: Bytes) -> Bytes ! crypto.KeyErr uses rand {
  if !is_ecdsa(k.kind) {
    return Err(key_err("crypto: sign_raw_ecdsa needs an ECDSA key"))
  }
  let der = sign(r, k, h, msg)?
  der_to_raw(der, nistec.size(nist_curve(k.kind)))
}

fn generate_key(r: Rand, alg: crypto.KeyAlg) -> PrivateKey ! crypto.KeyErr uses rand {
  match alg {
    Rsa => Err(key_err("crypto: RSA key generation is not available yet (decision 0285)"))
    Ed25519 => {
      let seed = r.bytes(32)
      PrivateKey{kind: alg, rsa: no_rsa(), d: seed, public: PublicKey{kind: alg, n: b"", e: 0, key: ed25519.public_key(seed)}}
    }
    _ => {
      // Go's randomPoint: size(curve) bytes until a scalar in [1, n),
      // P-521's shifted right by 7 bits
      let c = nist_curve(alg)
      while {
        let b0 = r.bytes(nistec.size(c))
        let b = if c == nistec.P521 { nist_shift7(b0) } else { b0 }
        let p = nistec.public_key(c, b)
        if !p.is_empty() {
          return PrivateKey{kind: alg, rsa: no_rsa(), d: b, public: PublicKey{kind: alg, n: b"", e: 0, key: p}}
        }
      }
      Err(key_err("unreachable"))
    }
  }
}

fn nist_shift7(b: Bytes) -> Bytes {
  var out = BytesBuilder.with_capacity(b.len())
  for i in 0..b.len() {
    let hi = if i > 0 { (Int(b[i - 1]) << 1) & 255 } else { 0 }
    out.write_byte(UInt8((Int(b[i]) >> 7) | hi))
  }
  out.freeze()
}

// ---------------------------------------------------------------------------
// JWK public keys (RFC 7517, 7518 6.2 and 6.3, RFC 8037; decision 0285)

struct Jwk {
  kty: Str
  crv: Str?
  n: Str?
  e: Str?
  x: Str?
  y: Str?
} derive Json

/// A JWK member: unpadded base64url (RFC 7515 2).
fn jwk_bytes(name: Str, v: Str?) -> Bytes ! crypto.KeyErr {
  let s = match v {
    Some(s) => s
    None => return Err(key_err("jwk: missing member \"${name}\""))
  }
  match base64.decode(s, base64.Base64.RawUrl) {
    Ok(b) => b
    Err(_) => Err(key_err("jwk: member \"${name}\" is not unpadded base64url"))
  }
}

fn jwk_public_key(jwk: Str) -> PublicKey ! crypto.KeyErr {
  let j = match json.decode_str[Jwk](jwk) {
    Ok(j) => j
    Err(_) => return Err(key_err("jwk: malformed JSON"))
  }
  match j.kty {
    "RSA" => {
      let n = minimal(jwk_bytes("n", j.n)?)
      let e = minimal(jwk_bytes("e", j.e)?)
      if e.len() > 4 || n.is_empty() || (n.len() == 1 && n[0] == 0) {
        return Err(key_err("jwk: invalid RSA key"))
      }
      var ev = 0
      for b in e {
        ev = ev * 256 + Int(b)
      }
      if ev <= 0 {
        return Err(key_err("jwk: invalid RSA key"))
      }
      PublicKey{kind: crypto.KeyAlg.Rsa, n: n, e: ev, key: b""}
    }
    "EC" => {
      let alg = match j.crv ?? "" {
        "P-256" => crypto.KeyAlg.EcdsaP256
        "P-384" => crypto.KeyAlg.EcdsaP384
        "P-521" => crypto.KeyAlg.EcdsaP521
        other => return Err(key_err("jwk: unsupported curve ${other.quote()}"))
      }
      let size = nistec.size(nist_curve(alg))
      let x = jwk_bytes("x", j.x)?
      let y = jwk_bytes("y", j.y)?
      if x.len() != size || y.len() != size {
        return Err(key_err("jwk: coordinates of the wrong size for ${j.crv ?? ""}"))
      }
      let point = b"\x04" + x + y
      if nistec.point_check(nist_curve(alg), point) != 0 {
        return Err(key_err("jwk: point not on the curve"))
      }
      PublicKey{kind: alg, n: b"", e: 0, key: point}
    }
    "OKP" => {
      if j.crv != Some("Ed25519") {
        return Err(key_err("jwk: unsupported curve ${(j.crv ?? "").quote()}"))
      }
      let x = jwk_bytes("x", j.x)?
      if x.len() != 32 {
        return Err(key_err("jwk: Ed25519 key of the wrong size"))
      }
      PublicKey{kind: crypto.KeyAlg.Ed25519, n: b"", e: 0, key: x}
    }
    other => Err(key_err("jwk: unsupported key type ${other.quote()}"))
  }
}
