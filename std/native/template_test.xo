test "html mode: Go's TestEscape cases over DATA (W trusted html)" {
  var data = json.parse_value(HTML_DATA).ok() ?? json.Value.Null
  data = match data {
    Object(fields) => json.Value.Object(fields: fields + [("W", template.html(HTML_W))])
    _ => data
  }
  var bad: List[(Str, Str, Str)] = []
  for (name, src, want) in HTML_CASES {
    let got = match template.parse_html("t", src) {
      Ok(t) => match t.render(data) {
        Ok(s) => s
        Err(e) => "err ${e.msg}"
      }
      Err(e) => "err ${e.msg}"
    }
    if got != want {
      bad.push((name, got, want))
    }
  }
  expect(bad) == []
}

/// escape_test.go TestErrors: (source, a substring of the error, or "")
const ERROR_CASES: List[(Str, Str)] = [
  ("{{if .Cond}}<a>{{else}}<b>{{end}}", ""),
  ("{{if .Cond}}<a>{{end}}", ""),
  ("{{if .Cond}}{{else}}<b>{{end}}", ""),
  ("{{with .Cond}}<div>{{end}}", ""),
  ("{{range .Items}}<a>{{end}}", ""),
  ("<a href='/foo?{{range .Items}}&{{.K}}={{.V}}{{end}}'>", ""),
  ("{{range .Items}}<a{{if .X}}{{end}}>{{end}}", ""),
  ("{{range .Items}}<a{{if .X}}{{end}}>{{continue}}{{end}}", ""),
  ("{{range .Items}}<a{{if .X}}{{end}}>{{break}}{{end}}", ""),
  ("{{range .Items}}<a{{if .X}}{{end}}>{{if .X}}{{break}}{{end}}{{end}}", ""),
  ("<script>var a = `\${a+b}`</script>`", ""),
  ("<script>var tmpl = `asd`;</script>", ""),
  ("<script>var tmpl = `\${1}`;</script>", ""),
  ("<script>var tmpl = `\${return ``}`;</script>", ""),
  ("<script>var tmpl = `\${return {{.}} }`;</script>", ""),
  ("<script>var tmpl = `\${ let a = {1:1} {{.}} }`;</script>", ""),
  ("<script>var tmpl = `asd \${return \"{\"}`;</script>", ""),
  ("{{if eq \"\" \"\"}}<meta>{{end}}", ""),
  ("{{if eq \"\" \"\"}}<meta content=\"url={{\"asd\"}}\">{{end}}", ""),
  ("{{if .Cond}}<a{{end}}", "z:1:5: {{if}} branches"),
  ("{{if .Cond}}\n{{else}}\n<a{{end}}", "z:1:5: {{if}} branches"),
  ("{{if .Cond}}<a href=\"foo\">{{else}}<a href=\"bar>{{end}}", "z:1:5: {{if}} branches"),
  ("<a {{if .Cond}}href='{{else}}title='{{end}}{{.X}}'>", "z:1:8: {{if}} branches"),
  ("\n{{with .X}}<a{{end}}", "z:2:7: {{with}} branches"),
  ("\n{{with .X}}<a>{{else}}<a{{end}}", "z:2:7: {{with}} branches"),
  ("{{range .Items}}<a{{end}}", "z:1: on range loop re-entry: \"<\" in attribute name: \"<a\""),
  ("\n{{range .Items}} x='<a{{end}}", "z:2:8: on range loop re-entry: {{range}} branches"),
  ("{{range .Items}}<a{{if .X}}{{break}}{{end}}>{{end}}", "z:1:29: at range loop break: {{range}} branches end in different contexts"),
  ("{{range .Items}}<a{{if .X}}{{continue}}{{end}}>{{end}}", "z:1:29: at range loop continue: {{range}} branches end in different contexts"),
  ("{{range .Items}}{{if .X}}{{break}}{{end}}<a{{if .Y}}{{continue}}{{end}}>{{if .Z}}{{continue}}{{end}}{{end}}", "z:1:54: at range loop continue: {{range}} branches end in different contexts"),
  ("<a b=1 c={{.H}}", "z: ends in a non-text context: {stateAttr delimSpaceOrTagEnd"),
  ("<script>foo();", "z: ends in a non-text context: {stateJS"),
  ("<a href=\"{{if .F}}/foo?a={{else}}/bar/{{end}}{{.H}}\">", "z:1:47: {{.H}} appears in an ambiguous context within a URL"),
  ("<a onclick=\"alert('Hello \\", "unfinished escape sequence in JS string: \"Hello \\\\\""),
  ("<a onclick='alert(\"Hello\\, World\\", "unfinished escape sequence in JS string: \"Hello\\\\, World\\\\\""),
  ("<a onclick='alert(/x+\\", "unfinished escape sequence in JS string: \"x+\\\\\""),
  ("<a onclick=\"/foo[\\]/", "unfinished JS regexp charset: \"foo[\\\\]/\""),
  ("<script>{{if false}}var x = 1{{end}}/-{{\"1.5\"}}/i.test(x)</script>", "'/' could start a division or regexp: \"/-\""),
  ("{{template \"foo\"}}", "z:1:11: no such template \"foo\""),
  ("<div{{template \"y\"}}>{{define \"y\"}} foo<b{{end}}", "\"<\" in attribute name: \" foo<b\""),
  ("<script>reverseList = [{{template \"t\"}}]</script>{{define \"t\"}}{{if .Tail}}{{template \"t\" .Tail}}{{end}}{{.Head}}\",{{end}}", ": cannot compute output context for template t\$htmltemplate_stateJS_elementScript"),
  ("<input type=button value=onclick=>", "html/template:z: \"=\" in unquoted attr: \"onclick=\""),
  ("<input type=button value= onclick=>", "html/template:z: \"=\" in unquoted attr: \"onclick=\""),
  ("<input type=button value= 1+1=2>", "html/template:z: \"=\" in unquoted attr: \"1+1=2\""),
  ("<a class=`foo>", "html/template:z: \"`\" in unquoted attr: \"`foo\""),
  ("<a style=font:'Arial'>", "html/template:z: \"'\" in unquoted attr: \"font:'Arial'\""),
  ("<a=foo>", ": expected space, attr name, or end of tag, but got \"=foo>\""),
  ("Hello, {{. | urlquery | print}}!", "predefined escaper \"urlquery\" disallowed in template"),
  ("Hello, {{. | html | print}}!", "predefined escaper \"html\" disallowed in template"),
  ("Hello, {{html . | print}}!", "predefined escaper \"html\" disallowed in template"),
  ("<div class={{. | html}}>Hello<div>", "predefined escaper \"html\" disallowed in template"),
  ("Hello, {{. | urlquery | html}}!", "predefined escaper \"urlquery\" disallowed in template"),
]

test "html mode: Go's TestErrors (the error text contains Go's)" {
  // Go executes these over nil data
  let data = json.Value.Null
  var bad: List[(Str, Str)] = []
  for (src, want) in ERROR_CASES {
    let got = match template.parse_html("z", src) {
      Ok(t) => match t.render(data) {
        Ok(_) => ""
        Err(e) => e.msg
      }
      Err(e) => e.msg
    }
    let ok = if want.is_empty() { got.is_empty() } else { got.contains(want) }
    if !ok {
      bad.push((src, got))
    }
  }
  expect(bad) == []
}

test "html mode: sets (escape_test.go TestEscapeSet)" {
  let data = json.parse_value("{\"Children\":[{\"X\":\"foo\"},{\"X\":\"<bar>\"},{\"Children\":[{\"X\":\"baz\"}]}]}").ok() ?? json.Value.Null
  let cases: List[(List[(Str, Str)], Str)] = [
    ([("main", "")], ""),
    ([("main", "Hello, {{template \"helper\"}}!"), ("helper", "{{\"<World>\"}}")], "Hello, &lt;World&gt;!"),
    ([("main", "<a onclick='a = {{template \"helper\"}};'>"), ("helper", "{{\"<a>\"}}<b")], "<a onclick='a = &#34;\\u003ca\\u003e&#34;<b;'>"),
    ([("main", "{{range .Children}}{{template \"main\" .}}{{else}}{{.X}} {{end}}")], "foo &lt;bar&gt; baz "),
    ([("main", "{{template \"helper\" .}}"), ("helper", "{{if .Children}}<ul>{{range .Children}}<li>{{template \"main\" .}}</li>{{end}}</ul>{{else}}{{.X}}{{end}}")], "<ul><li>foo</li><li>&lt;bar&gt;</li><li><ul><li>baz</li></ul></li></ul>"),
    ([("main", "<blockquote>{{range .Children}}{{template \"helper\" .}}{{end}}</blockquote>"), ("helper", "{{if .Children}}{{template \"main\" .}}{{else}}{{.X}}<br>{{end}}")], "<blockquote>foo<br>&lt;bar&gt;<br><blockquote>baz<br></blockquote></blockquote>"),
    ([("main", "<button onclick=\"title='{{template \"helper\"}}'; ...\">{{template \"helper\"}}</button>"), ("helper", "{{11}} of {{\"<100>\"}}")], "<button onclick=\"title='11 of \\u003c100\\u003e'; ...\">11 of &lt;100&gt;</button>"),
    ([("main", "<script>var x={{template \"helper\"}}/{{\"42\"}};</script>"), ("helper", "{{126}}")], "<script>var x= 126 /\"42\";</script>"),
  ]
  var bad: List[(Str, Str)] = []
  for (srcs, want) in cases {
    var t: template.Template? = None
    var err = ""
    for (name, src) in srcs {
      t = match t {
        None => match template.parse_html(name, src) {
          Ok(x) => Some(x)
          Err(e) => {
            err = e.msg
            None
          }
        }
        Some(x) => match x.add(name, src) {
          Ok(y) => Some(y)
          Err(e) => {
            err = e.msg
            None
          }
        }
      }
    }
    let got = match t {
      Some(x) => match x.render_named("main", data) {
        Ok(s) => s
        Err(e) => "err ${e.msg}"
      }
      None => "err ${err}"
    }
    if got != want {
      bad.push((got, want))
    }
  }
  expect(bad) == []
}

test "html mode: trusted content passes through in its context and is escaped elsewhere" {
  let data = json.Value.Object(fields: [
    ("h", template.html("<b>bold</b>")),
    ("u", template.url("javascript:alert(1)")),
    ("j", template.js("1 + 2")),
    ("s", json.Value.Str(s: "<b>&</b>")),
  ])
  let cases: List[(Str, Str)] = [
    ("{{.h}}", "<b>bold</b>"),
    ("{{.s}}", "&lt;b&gt;&amp;&lt;/b&gt;"),
    ("<a href=\"{{.u}}\">", "<a href=\"javascript:alert%281%29\">"),
    ("<a href=\"{{.s}}\">", "<a href=\"%3cb%3e&amp;%3c/b%3e\">"),
    ("<script>var x = {{.j}};</script>", "<script>var x = 1 + 2;</script>"),
    ("<script>var x = {{.s}};</script>", "<script>var x = \"\\u003cb\\u003e\\u0026\\u003c/b\\u003e\";</script>"),
    ("<a title=\"{{.h}}\">", "<a title=\"bold\">"),
  ]
  var bad: List[(Str, Str, Str)] = []
  for (src, want) in cases {
    let got = match template.parse_html("t", src) {
      Ok(t) => t.render(data).ok() ?? "err"
      Err(e) => "err ${e.msg}"
    }
    if got != want {
      bad.push((src, got, want))
    }
  }
  expect(bad) == []
  // decoded input cannot forge trusted content
  let forged = json.parse_value("{\"h\":{\"$html\":\"<script>\"},\"k\":\"<i>\"}").ok() ?? json.Value.Null
  let got = match template.parse_html("t", "{{.h}} {{.k}}") {
    Ok(t) => t.render(forged).ok() ?? "err"
    Err(e) => "err ${e.msg}"
  }
  expect(got) == "map[$html:&lt;script&gt;] &lt;i&gt;"
}

// ---------------------------------------------------------------------------
// The escapers and the context machine: Go's js_test.go, css_test.go,
// url_test.go, html_test.go and transition_test.go cases.

test "nextJSCtx (js_test.go TestNextJsCtx)" {
  let cases: List[(Int, Str)] = [
    (JS_CTX_REGEXP, ";"), (JS_CTX_REGEXP, "}"), (JS_CTX_DIV_OP, ")"), (JS_CTX_DIV_OP, "]"),
    (JS_CTX_REGEXP, "("), (JS_CTX_REGEXP, "["), (JS_CTX_REGEXP, "{"), (JS_CTX_REGEXP, "="),
    (JS_CTX_REGEXP, "+="), (JS_CTX_REGEXP, "*="), (JS_CTX_REGEXP, "*"), (JS_CTX_REGEXP, "!"),
    (JS_CTX_REGEXP, "+"), (JS_CTX_REGEXP, "-"), (JS_CTX_DIV_OP, "--"), (JS_CTX_DIV_OP, "++"),
    (JS_CTX_DIV_OP, "x--"), (JS_CTX_REGEXP, "x---"), (JS_CTX_REGEXP, "return"), (JS_CTX_REGEXP, "return "),
    (JS_CTX_REGEXP, "return\t"), (JS_CTX_REGEXP, "return\n"), (JS_CTX_REGEXP, "return\u{2028}"),
    (JS_CTX_DIV_OP, "x"), (JS_CTX_DIV_OP, "x "), (JS_CTX_DIV_OP, "x\t"), (JS_CTX_DIV_OP, "x\n"),
    (JS_CTX_DIV_OP, "x\u{2028}"), (JS_CTX_DIV_OP, "preturn"), (JS_CTX_DIV_OP, "0"), (JS_CTX_DIV_OP, "0."),
    (JS_CTX_REGEXP, "=\u{A0}"),
  ]
  var bad: List[Str] = []
  for (want, s) in cases {
    if next_js_ctx(s.bytes(), JS_CTX_REGEXP) != want {
      bad.push(s)
    }
    if next_js_ctx(s.bytes(), JS_CTX_DIV_OP) != want {
      bad.push(s + " (after div)")
    }
  }
  expect(bad) == []
  expect(next_js_ctx(b"", JS_CTX_REGEXP)) == JS_CTX_REGEXP
  expect(next_js_ctx(b"  ", JS_CTX_DIV_OP)) == JS_CTX_DIV_OP
}

test "jsStrEscaper and jsRegexpEscaper (js_test.go)" {
  let str_cases: List[(Str, Str)] = [
    ("", ""), ("foo", "foo"), ("\u{0}", "\\u0000"), ("\t", "\\t"), ("\n", "\\n"), ("\r", "\\r"),
    ("\u{2028}", "\\u2028"), ("\u{2029}", "\\u2029"), ("\\", "\\\\"), ("\\n", "\\\\n"),
    ("foo\r\nbar", "foo\\r\\nbar"), ("\"", "\\u0022"), ("'", "\\u0027"), ("&amp;", "\\u0026amp;"),
    ("</script>", "\\u003c\\/script\\u003e"), ("<![CDATA[", "\\u003c![CDATA["), ("]]>", "]]\\u003e"),
    ("<!--", "\\u003c!--"), ("-->", "--\\u003e"),
    ("+ADw-script+AD4-alert(1)+ADw-/script+AD4-", "\\u002bADw-script\\u002bAD4-alert(1)\\u002bADw-\\/script\\u002bAD4-"),
  ]
  var bad: List[(Str, Str)] = []
  for (x, want) in str_cases {
    let got = js_str_escaper(x, CONTENT_TYPE_PLAIN)
    if got != want {
      bad.push((x, got))
    }
  }
  expect(bad) == []
  let re_cases: List[(Str, Str)] = [
    ("", "(?:)"), ("foo", "foo"), ("\u{0}", "\\u0000"), ("\t", "\\t"), ("\n", "\\n"), ("\r", "\\r"),
    ("\u{2028}", "\\u2028"), ("\u{2029}", "\\u2029"), ("\\", "\\\\"), ("\\n", "\\\\n"),
    ("foo\r\nbar", "foo\\r\\nbar"), ("\"", "\\u0022"), ("'", "\\u0027"), ("&amp;", "\\u0026amp;"),
    ("</script>", "\\u003c\\/script\\u003e"), ("<![CDATA[", "\\u003c!\\[CDATA\\["), ("]]>", "\\]\\]\\u003e"),
    ("<!--", "\\u003c!\\-\\-"), ("-->", "\\-\\-\\u003e"), ("*", "\\*"), ("+", "\\u002b"), ("?", "\\?"),
    ("[](){}", "\\[\\]\\(\\)\\{\\}"), ("\$foo|x.y", "\\\$foo\\|x\\.y"), ("x^y", "x\\^y"),
  ]
  for (x, want) in re_cases {
    let got = js_regexp_escaper(x, CONTENT_TYPE_PLAIN)
    if got != want {
      bad.push((x, got))
    }
  }
  expect(bad) == []
}

test "jsValEscaper over JSON texts (js_test.go TestJSValEscaper)" {
  expect(js_val_escaper_json("42")) == " 42 "
  expect(js_val_escaper_json("-42")) == " -42 "
  expect(js_val_escaper_json("0.5")) == " 0.5 "
  expect(js_val_escaper_json("\"\"")) == "\"\""
  expect(js_val_escaper_json("\"foo\"")) == "\"foo\""
  expect(js_val_escaper_json("[42,\"foo\",null]")) == "[42,\"foo\",null]"
  expect(js_val_escaper_json("null")) == " null "
  expect(js_val_escaper_json("")) == " null "
  expect(js_val_escaper_json("\"\u{2028}\"")) == "\"\\u2028\""
  expect(js_val_escaper_json("{\"X\":1}")) == "{\"X\":1}"
}

test "cssEscaper and decodeCSS (css_test.go TestCSSEscaper)" {
  let input = "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\t\n\u{B}\u{C}\r\u{E}\u{F}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1A}\u{1B}\u{1C}\u{1D}\u{1E}\u{1F} !\"#\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u{7F}\u{A0}\u{100}\u{2028}\u{2029}\u{FEFF}\u{1D11E}"
  let want = "\\0\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\\9 \\a\u{B}\\c \\d\u{E}\u{F}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1A}\u{1B}\u{1C}\u{1D}\u{1E}\u{1F} !\\22#\$%\\26\\27\\28\\29*\\2b,-.\\2f 0123456789\\3a\\3b\\3c=\\3e?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz\\7b|\\7d~\u{7F}\u{A0}\u{100}\u{2028}\u{2029}\u{FEFF}\u{1D11E}"
  let got = css_escaper(input, CONTENT_TYPE_PLAIN)
  expect(got) == want
  expect(decode_css(got.bytes()).to_str()) == Some(input)
}

