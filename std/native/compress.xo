// std/compress on the native backends (decision 0305): Go's compress/gzip,
// compress/flate, and compress/zlib over std/native/llrt/flate.xo (the
// port of compress/flate that std/archive uses too), with the bytes Go's
// writers write at each level and Go's error texts.
use std/compress
use native/llrt/flate

fn compresserr_display(e: compress.CompressErr) -> Str { e.msg }

/// Go's level number: a fault outside -2 to 9 (flate.NewWriter's error).
fn level_of(l: compress.Level) -> Int {
  match l {
    NoCompression => 0
    BestSpeed => 1
    Default => -1
    BestCompression => 9
    HuffmanOnly => -2
    Of(n) => {
      if n < -2 || n > 9 {
        fault("compress: invalid compression level ${n}: want value in range [-2, 9]")
      }
      n
    }
  }
}

fn bytes_of(l: List[Int]) -> Bytes {
  var b = BytesBuilder.with_capacity(l.len())
  for x in l {
    b.write_byte(UInt8(x))
  }
  b.freeze()
}

fn put_u32le(var b: BytesBuilder, v: Int) {
  b.write_byte(UInt8(v & 255))
  b.write_byte(UInt8((v >> 8) & 255))
  b.write_byte(UInt8((v >> 16) & 255))
  b.write_byte(UInt8((v >> 24) & 255))
}

fn put_u32be(var b: BytesBuilder, v: Int) {
  b.write_byte(UInt8((v >> 24) & 255))
  b.write_byte(UInt8((v >> 16) & 255))
  b.write_byte(UInt8((v >> 8) & 255))
  b.write_byte(UInt8(v & 255))
}

/// The error of a decoder: Go's text, or the max_size text for LIMIT.
fn fail(format: Str, e: Str, max_size: Int) -> compress.CompressErr {
  if e == flate.LIMIT {
    return compress.CompressErr{msg: "${format}: output exceeds max_size (${max_size} bytes)"}
  }
  compress.CompressErr{msg: e}
}

/// The decoder's limit: max_size + 1 bytes, as Go's io.LimitReader(r,
/// max + 1) reads them, so an error found within them (a bad checksum at
/// the end of exactly max + 1 bytes) is Go's result, and only more than
/// max_size bytes without one is the max_size error.
fn limit_of(max_size: Int) -> Int { if max_size < 0 { 1 } else { max_size + 1 } }

fn over(n: Int, max_size: Int) -> Bool { n > (if max_size < 0 { 0 } else { max_size }) }

fn gzip(data: Bytes, level: compress.Level) -> Bytes {
  let lv = level_of(level)
  // gzip.Writer's header: no name, no time; XFL 2 for level 9, 4 for 1
  let xfl = if lv == 9 { 2 } else if lv == 1 { 4 } else { 0 }
  var b = BytesBuilder.new()
  b.write(b"\x1f\x8b\x08\x00\x00\x00\x00\x00")
  b.write_byte(UInt8(xfl))
  b.write_byte(UInt8(255))
  b.write(flate.deflate_level(data, lv))
  put_u32le(b, flate.crc32(flate.crc_table(), 0, data))
  put_u32le(b, data.len() & 0xffffffff)
  b.freeze()
}

fn gunzip(data: Bytes, max_size: Int) -> Bytes ! compress.CompressErr {
  match flate.gunzip_members(data, limit_of(max_size)) {
    Ok(out) => {
      if over(out.len(), max_size) {
        return Err(fail("gzip", flate.LIMIT, max_size))
      }
      out
    }
    Err(e) => Err(fail("gzip", e, max_size))
  }
}

fn deflate(data: Bytes, level: compress.Level) -> Bytes { flate.deflate_level(data, level_of(level)) }

fn inflate(data: Bytes, max_size: Int) -> Bytes ! compress.CompressErr {
  var f = flate.Inflater{data: data, pos: 0, start: 0, end: data.len(), b: 0, nb: 0, out: [], out_start: 0, limit: limit_of(max_size)}
  match f.inflate(flate.fixed_decoder()) {
    Ok(_) => {
      if over(f.out.len(), max_size) {
        return Err(fail("flate", flate.LIMIT, max_size))
      }
      flate.list_bytes(f.out)
    }
    Err(e) => Err(fail("flate", e, max_size))
  }
}

/// hash/adler32's Checksum.
fn adler32(data: Bytes) -> Int {
  var a = 1
  var b = 0
  var i = 0
  let n = data.len()
  while i < n {
    // hash/adler32's nmax: the most bytes a 32 bit sum holds before the modulus
    var end = i + 5552
    if end > n {
      end = n
    }
    for c in data[i..end] {
      a += Int(c)
      b += a
    }
    a = a % 65521
    b = b % 65521
    i = end
  }
  (b << 16) | a
}

fn zlib(data: Bytes, level: compress.Level) -> Bytes {
  let lv = level_of(level)
  // zlib.Writer's header: CMF 0x78, FLEVEL from the level, FCHECK
  let flevel = if lv == -2 || lv == 0 || lv == 1 { 0 } else if lv >= 2 && lv <= 5 { 1 } else if lv == 6 || lv == -1 { 2 } else { 3 }
  var flg = flevel << 6
  flg += 31 - ((0x78 * 256 + flg) % 31)
  var b = BytesBuilder.new()
  b.write_byte(UInt8(0x78))
  b.write_byte(UInt8(flg))
  b.write(flate.deflate_level(data, lv))
  put_u32be(b, adler32(data))
  b.freeze()
}

fn unzlib(data: Bytes, max_size: Int) -> Bytes ! compress.CompressErr {
  // zlib.NewReader: the header (EOF on none, unexpected EOF on a short
  // one), a preset dictionary is invalid (none can be given here)
  let n = data.len()
  if n < 2 {
    // io.ReadFull's EOF is unexpected EOF here (zlib.Reader.Reset)
    return Err(compress.CompressErr{msg: "unexpected EOF"})
  }
  let c0 = Int(data[0])
  let c1 = Int(data[1])
  if (c0 & 15) != 8 || (c0 >> 4) > 7 || ((c0 << 8) | c1) % 31 != 0 {
    return Err(compress.CompressErr{msg: "zlib: invalid header"})
  }
  var at = 2
  if (c1 & 0x20) != 0 {
    if n < 6 {
      return Err(compress.CompressErr{msg: "unexpected EOF"})
    }
    // the dictionary's Adler-32 against the (empty) dictionary given: 1
    let id = (Int(data[2]) << 24) | (Int(data[3]) << 16) | (Int(data[4]) << 8) | Int(data[5])
    if id != 1 {
      return Err(compress.CompressErr{msg: "zlib: invalid dictionary"})
    }
    at = 6
  }
  var f = flate.Inflater{data: data, pos: at, start: at, end: n, b: 0, nb: 0, out: [], out_start: 0, limit: limit_of(max_size)}
  match f.inflate(flate.fixed_decoder()) {
    Ok(_) => {}
    Err(e) => return Err(fail("zlib", e, max_size))
  }
  let out = flate.list_bytes(f.out)
  if n - f.pos < 4 {
    return Err(compress.CompressErr{msg: "unexpected EOF"})
  }
  let sum = (Int(data[f.pos]) << 24) | (Int(data[f.pos + 1]) << 16) | (Int(data[f.pos + 2]) << 8) | Int(data[f.pos + 3])
  if sum != adler32(out) {
    return Err(compress.CompressErr{msg: "zlib: invalid checksum"})
  }
  if over(f.out.len(), max_size) {
    return Err(fail("zlib", flate.LIMIT, max_size))
  }
  out
}

// ---------------------------------------------------------------------------
// Streaming (decision 0305): Go's gzip, flate, and zlib Writers over
// flate.Stream; a decoder over flate.InStream

struct Compressor {
  format: compress.Format
  level: Int
  s: flate.Stream
  /// the gzip or zlib header written
  head: Bool
  /// gzip's CRC-32 and size, zlib's Adler-32
  sum: Int
  size: Int
}

fn compressor(format: compress.Format, level: compress.Level) -> Compressor {
  let lv = level_of(level)
  Compressor{format: format, level: lv, s: flate.new_stream(lv), head: false, sum: if format == compress.Format.Zlib { 1 } else { 0 }, size: 0}
}

/// The format's header, the first time (gzip.Writer and zlib.Writer write
/// it on their first Write, Flush, or Close).
fn (var c: Compressor) header() -> Bytes {
  if c.head {
    return b""
  }
  c.head = true
  match c.format {
    Gzip => {
      let xfl = if c.level == 9 { 2 } else if c.level == 1 { 4 } else { 0 }
      var b = BytesBuilder.new()
      b.write(b"\x1f\x8b\x08\x00\x00\x00\x00\x00")
      b.write_byte(UInt8(xfl))
      b.write_byte(UInt8(255))
      b.freeze()
    }
    Deflate => b""
    Zlib => {
      let lv = c.level
      let flevel = if lv == -2 || lv == 0 || lv == 1 { 0 } else if lv >= 2 && lv <= 5 { 1 } else if lv == 6 || lv == -1 { 2 } else { 3 }
      var flg = flevel << 6
      flg += 31 - ((0x78 * 256 + flg) % 31)
      var b = BytesBuilder.new()
      b.write_byte(UInt8(0x78))
      b.write_byte(UInt8(flg))
      b.freeze()
    }
  }
}

fn adler_update(sum: Int, data: Bytes) -> Int {
  var a = sum & 0xffff
  var b = sum >> 16
  for c in data {
    a = (a + Int(c)) % 65521
    b = (b + a) % 65521
  }
  (b << 16) | a
}

fn (var c: Compressor) write(data: Bytes) -> Bytes {
  let h = c.header()
  match c.format {
    Gzip => {
      c.sum = flate.crc32(flate.crc_table(), c.sum, data)
      c.size += data.len()
    }
    Zlib => c.sum = adler_update(c.sum, data)
    Deflate => {}
  }
  c.s.write(data)
  h + c.s.take()
}

fn (var c: Compressor) flush() -> Bytes {
  let h = c.header()
  c.s.flush()
  h + c.s.take()
}

fn (var c: Compressor) finish() -> Bytes {
  let h = c.header()
  c.s.close()
  var b = BytesBuilder.new()
  b.write(h)
  b.write(c.s.take())
  match c.format {
    Gzip => {
      put_u32le(b, c.sum)
      put_u32le(b, c.size & 0xffffffff)
    }
    Zlib => put_u32be(b, c.sum)
    Deflate => {}
  }
  b.freeze()
}

struct Decompressor {
  format: compress.Format
  st: flate.InStream
  max: Int
}

fn decompressor(format: compress.Format, max_size: Int) -> Decompressor {
  let f = match format {
    Deflate => 0
    Gzip => 1
    Zlib => 2
  }
  Decompressor{format: format, st: flate.new_instream(f, if max_size < 0 { 0 } else { max_size }), max: max_size}
}

fn (d: Decompressor) name() -> Str {
  match d.format {
    Gzip => "gzip"
    Deflate => "flate"
    Zlib => "zlib"
  }
}

fn (var d: Decompressor) write(data: Bytes) -> Bytes ! compress.CompressErr {
  match d.st.push(data, false) {
    Ok(out) => bytes_of(out)
    Err(e) => Err(fail(d.name(), e, d.max))
  }
}

fn (var d: Decompressor) finish() -> Bytes ! compress.CompressErr {
  match d.st.push(b"", true) {
    Ok(out) => bytes_of(out)
    Err(e) => Err(fail(d.name(), e, d.max))
  }
}

// LZW (decision 0578 step 4): Go's compress/lzw writer.go and reader.go over
// whole buffers.

/// An LZW encoder's state (Go's lzw.Writer without its io plumbing).
struct LzwEnc {
  out: BytesBuilder
  lsb: Bool
  lit: Int
  bits: Int
  nbits: Int
  width: Int
  hi: Int
  overflow: Int
  table: List[Int]
}

fn (var e: LzwEnc) put(c: Int) {
  if e.lsb {
    e.bits = e.bits | (c << e.nbits)
    e.nbits += e.width
    while e.nbits >= 8 {
      e.out.write_le(e.bits & 255, 1)
      e.bits = e.bits >> 8
      e.nbits -= 8
    }
  } else {
    e.bits = e.bits | ((c << (32 - e.width - e.nbits)) & 4294967295)
    e.nbits += e.width
    while e.nbits >= 8 {
      e.out.write_le((e.bits >> 24) & 255, 1)
      e.bits = (e.bits << 8) & 4294967295
      e.nbits -= 8
    }
  }
}

/// Go's incHi: true when the codes ran out and the table was reset.
fn (var e: LzwEnc) inc_hi() -> Bool {
  e.hi += 1
  if e.hi == e.overflow {
    e.width += 1
    e.overflow = e.overflow << 1
  }
  if e.hi == 4095 {
    let clear = 1 << e.lit
    e.put(clear)
    e.width = e.lit + 1
    e.hi = clear + 1
    e.overflow = clear << 1
    for i in 0..e.table.len() {
      e.table[i] = 0
    }
    return true
  }
  false
}

fn lzw_range_err(lit_width: Int) -> compress.CompressErr {
  compress.CompressErr{msg: "lzw: litWidth ${lit_width} out of range"}
}

/// The LSB encoder std/gif writes with.
pub fn lzw_lsb(data: Bytes, lit_width: Int) -> Bytes ! compress.CompressErr {
  lzw_encode(data, compress.LzwOrder.LSB, lit_width)
}

fn lzw_encode(data: Bytes, order: compress.LzwOrder, lit_width: Int) -> Bytes ! compress.CompressErr {
  if lit_width < 2 || lit_width > 8 {
    return Err(lzw_range_err(lit_width))
  }
  let lsb = order == compress.LzwOrder.LSB
  let clear = 1 << lit_width
  var e = LzwEnc{out: BytesBuilder.with_capacity(data.len() / 2 + 16), lsb: lsb, lit: lit_width, bits: 0, nbits: 0, width: lit_width + 1, hi: clear + 1, overflow: clear << 1, table: []}
  for _ in 0..16384 {
    e.table.push(0)
  }
  if data.len() == 0 {
    e.put(clear)
  } else {
    if lit_width != 8 {
      let max_lit = (1 << lit_width) - 1
      for x in data {
        if Int(x) > max_lit {
          return Err(compress.CompressErr{msg: "lzw: input byte too large for the litWidth"})
        }
      }
    }
    e.put(clear)
    var code = Int(data[0])
    for i in 1..data.len() {
      let literal = Int(data[i])
      let key = (code << 8) | literal
      var hash = ((key >> 12) ^ key) & 16383
      var found = false
      var h = hash
      var t = e.table[h]
      while t != 0 {
        if key == (t >> 12) {
          code = t & 4095
          found = true
          break
        }
        h = (h + 1) & 16383
        t = e.table[h]
      }
      if found {
        continue
      }
      e.put(code)
      code = literal
      if e.inc_hi() {
        continue
      }
      while e.table[hash] != 0 {
        hash = (hash + 1) & 16383
      }
      e.table[hash] = (key << 12) | e.hi
    }
    e.put(code)
    let _ = e.inc_hi()
  }
  e.put((1 << lit_width) + 1)
  if e.nbits > 0 {
    var bits = e.bits
    if !lsb {
      bits = bits >> 24
    }
    e.out.write_le(bits & 255, 1)
  }
  e.out.freeze()
}

// Go's lzw.Reader error states.
pub const LZW_OK: Int = 0
pub const LZW_EOF: Int = 1
pub const LZW_UNEXPECTED: Int = 2
pub const LZW_INVALID: Int = 3

/// The bytes an lzw Reader reads (Go's io.ByteReader): flat, or the data
/// sub-blocks of a GIF image (a length byte, that many bytes, ending with
/// a zero length), as image/gif's blockReader reads them. data[pos..] is
/// not yet read; a block's unread bytes are data[bi..bj].
pub struct LzwSrc {
  pub data: Bytes
  pub pos: Int
  pub blocks: Bool
  bi: Int
  bj: Int
  err: Int
}

pub fn new_lzw_src(data: Bytes, pos: Int, blocks: Bool) -> LzwSrc {
  LzwSrc{data: data, pos: pos, blocks: blocks, bi: 0, bj: 0, err: 0}
}

/// Go's blockReader.fill.
fn (var s: LzwSrc) fill() {
  if s.err != 0 {
    return
  }
  if s.pos >= s.data.len() {
    s.err = LZW_UNEXPECTED
    return
  }
  let j = Int(s.data[s.pos])
  s.pos += 1
  if j == 0 {
    s.err = LZW_EOF
    return
  }
  if s.pos + j > s.data.len() {
    s.pos = s.data.len()
    s.err = LZW_UNEXPECTED
    return
  }
  s.bi = s.pos
  s.bj = s.pos + j
  s.pos += j
}

/// The next byte, or -1 at the end of the data or on an error.
fn (var s: LzwSrc) next() -> Int {
  if !s.blocks {
    if s.pos >= s.data.len() {
      return -1
    }
    let c = Int(s.data[s.pos])
    s.pos += 1
    return c
  }
  if s.bi == s.bj {
    s.fill()
    if s.err != 0 {
      return -1
    }
  }
  let c = Int(s.data[s.bi])
  s.bi += 1
  c
}

/// Go's blockReader.close: 0 when the image data ended cleanly, 1 for
/// "too much image data", 2 for a read error (unexpected EOF).
pub fn (var s: LzwSrc) close() -> Int {
  if s.err == LZW_EOF {
    return 0
  }
  if s.err != 0 {
    return 2
  }
  if s.bi == s.bj {
    s.fill()
    if s.err == LZW_EOF {
      return 0
    }
    if s.err != 0 {
      return 2
    }
    if s.bj - s.bi > 1 {
      return 1
    }
  }
  s.fill()
  if s.err == LZW_EOF {
    return 0
  }
  if s.err != 0 {
    return 2
  }
  1
}

/// Go's lzw.Reader (reader.go) without its io plumbing: batch decodes codes
/// until 4096 bytes of output are ready or an error stops it.
pub struct LzwDec {
  lsb: Bool
  lit: Int
  clear: Int
  eof: Int
  width: Int
  hi: Int
  overflow: Int
  last: Int
  bits: Int
  nbits: Int
  suffix: List[Int]
  prefix: List[Int]
  ob: List[UInt8]
  pub err: Int
  pub pend: Bytes
  pub rp: Int
}

pub fn new_lzw_dec(lsb: Bool, lit: Int) -> LzwDec {
  var d = LzwDec{lsb: lsb, lit: lit, clear: 1 << lit, eof: (1 << lit) + 1, width: lit + 1, hi: (1 << lit) + 1, overflow: 1 << (lit + 1), last: 65535, bits: 0, nbits: 0, suffix: [], prefix: [], ob: [], err: 0, pend: b"", rp: 0}
  for _ in 0..4096 {
    d.suffix.push(0)
    d.prefix.push(0)
  }
  for _ in 0..8192 {
    d.ob.push(UInt8(0))
  }
  d
}

/// Go's Reader.decode: fills pend with the next batch (or the output before
/// an error, which is then in err). Like Go's, each code's bytes are written
/// from the end of their span backwards through the suffix and prefix tables
/// (the length of a span is counted along the chain first), and the state sits in
/// locals while the batch runs.
pub fn (var d: LzwDec) batch(var s: LzwSrc) {
  var o = 0
  var bits = d.bits
  var nbits = d.nbits
  var width = d.width
  var hi = d.hi
  var last = d.last
  var overflow = d.overflow
  let lsb = d.lsb
  let clear = d.clear
  let eof = d.eof
  var err = 0
  while true {
    while nbits < width {
      let x = s.next()
      if x < 0 {
        err = LZW_UNEXPECTED
        break
      }
      if lsb {
        bits = bits | (x << nbits)
      } else {
        bits = bits | (x << (24 - nbits))
      }
      nbits += 8
    }
    if err != 0 {
      break
    }
    var code = 0
    if lsb {
      code = bits & ((1 << width) - 1)
      bits = bits >> width
    } else {
      code = (bits >> (32 - width)) & 65535
      bits = (bits << width) & 4294967295
    }
    nbits -= width
    if code < clear {
      d.ob[o] = UInt8(code)
      o += 1
      if last != 65535 {
        d.suffix[hi] = code
        d.prefix[hi] = last
      }
    } else if code == clear {
      width = 1 + d.lit
      hi = eof
      overflow = 1 << width
      last = 65535
      continue
    } else if code == eof {
      err = LZW_EOF
      break
    } else if code <= hi {
      var c = code
      var i = 0
      var n = 1
      if code == hi && last != 65535 {
        c = last
        n = 2
        while c >= clear {
          c = d.prefix[c]
          n += 1
        }
        i = o + n - 1
        d.ob[i] = UInt8(c)
        i -= 1
        c = last
        o += n
      } else {
        while c >= clear {
          c = d.prefix[c]
          n += 1
        }
        i = o + n - 1
        o += n
        c = code
      }
      while c >= clear {
        d.ob[i] = UInt8(d.suffix[c])
        i -= 1
        c = d.prefix[c]
      }
      d.ob[i] = UInt8(c)
      if last != 65535 {
        d.suffix[hi] = c
        d.prefix[hi] = last
      }
    } else {
      err = LZW_INVALID
      break
    }
    last = code
    hi += 1
    if hi >= overflow {
      if width == 12 {
        last = 65535
        hi -= 1
      } else {
        width += 1
        overflow = 1 << width
      }
    }
    if o >= 4096 {
      break
    }
  }
  d.bits = bits
  d.nbits = nbits
  d.width = width
  d.hi = hi
  d.last = last
  d.overflow = overflow
  if err != 0 {
    d.err = err
  }
  d.pend = flate.list_bytes(d.ob)[0..o]
  d.rp = 0
}

/// Go's lzw.Reader.Read into a buffer of up to n bytes: the bytes, and
/// whether it stopped short on an error (d.err).
pub fn (var d: LzwDec) read(var s: LzwSrc, n: Int) -> Bytes {
  var out = BytesBuilder.with_capacity(n)
  while out.len() < n {
    if d.rp < d.pend.len() {
      let take = imin(n - out.len(), d.pend.len() - d.rp)
      out.write(d.pend[d.rp..d.rp + take])
      d.rp += take
      continue
    }
    if d.err != 0 {
      break
    }
    d.batch(s)
  }
  out.freeze()
}

fn imin(a: Int, b: Int) -> Int { if a < b { a } else { b } }

/// The decoded bytes of Go's lzw.Reader and its error text ("" for none; the
/// bytes before an error are still Go's output), at most max_size bytes (an
/// error "lzw: output exceeds max_size" past it, as the other decoders).
fn lzw_run(data: Bytes, order: compress.LzwOrder, lit_width: Int, max_size: Int) -> (Bytes, Str) {
  if lit_width < 2 || lit_width > 8 {
    return (b"", lzw_range_err(lit_width).msg)
  }
  var s = new_lzw_src(data, 0, false)
  var d = new_lzw_dec(order == compress.LzwOrder.LSB, lit_width)
  var out = BytesBuilder.with_capacity(data.len() * 2)
  let limit = if max_size < 0 { 0 } else { max_size }
  while true {
    out.write(d.pend[d.rp..d.pend.len()])
    d.rp = d.pend.len()
    if out.len() > limit {
      return (b"", "lzw: output exceeds max_size (${max_size} bytes)")
    }
    if d.err == LZW_EOF {
      return (out.freeze(), "")
    }
    if d.err == LZW_UNEXPECTED {
      return (out.freeze(), "unexpected EOF")
    }
    if d.err == LZW_INVALID {
      return (out.freeze(), "lzw: invalid code")
    }
    d.batch(s)
  }
  (b"", "")
}

fn lzw_decode(data: Bytes, order: compress.LzwOrder, lit_width: Int, max_size: Int) -> Bytes ! compress.CompressErr {
  let (out, err) = lzw_run(data, order, lit_width, max_size)
  if err != "" {
    return Err(compress.CompressErr{msg: err})
  }
  out
}

