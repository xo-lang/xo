fn hx(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

fn header_text(h: Map[Str, Str]) -> Str { h.keys().sort().map(fn(k) { "${k}: ${h.get(k) ?? ""}" }).join("\n") }

test "go parse" {
  for (boundary, body, want, e) in PARSE {
    match parse(hx(body), boundary) {
      Ok(ps) => {
        expect((body, e)) == (body, "")
        expect((body, ps.map(fn(p) { (p.name, p.filename ?? "", header_text(p.headers), p.data.to_hex()) }))) == (body, want)
      }
      Err(got) => expect((body, got.msg)) == (body, e)
    }
  }
}

test "go parse_form" {
  for (boundary, body, values, files, e) in FORM {
    match parse_form(hx(body), boundary) {
      Ok(f) => {
        expect((body, e)) == (body, "")
        expect((body, f.values.keys().sort().map(fn(k) { (k, f.values.all(k)) }))) == (body, values)
        var got: List[(Str, Str, Str)] = []
        for k in f.files.keys().sort() {
          for p in f.files.get(k) ?? [] {
            got.push((k, p.filename ?? "", p.data.to_hex()))
          }
        }
        expect((body, got)) == (body, files)
      }
      Err(got) => expect((body, got.msg)) == (body, e)
    }
  }
}

test "write and parse" {
  let parts = [
    multipart.Part{name: "a", filename: None, headers: {}, data: b"one"},
    multipart.Part{name: "f\"q", filename: Some("x.bin"), headers: {}, data: b"\r\n--zz\r\n"},
  ]
  let body = write(parts, "zz")
  expect(body.to_str() ?? "") == "--zz\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\none\r\n--zz\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x.bin\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--zz\r\n\r\n--zz--\r\n"
  expect(form_data_content_type("a b")) == "multipart/form-data; boundary=\"a b\""
  expect(form_data_content_type("ab")) == "multipart/form-data; boundary=ab"
}

test "parse_form skips a nameless quoted-printable part as Go's Close drains it" {
  // the decoder stops at the bad line, after the partReader read that
  // held it (up to the non-boundary --MyBoundaryx), so NextPart reads "x"
  let body = b"--MyBoundary\r\nContent-Disposition: form-data; name*=UTF-8''\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n\x00\xff\r\n--MyBoundaryx\r\ncontent-type: text/plain\r\n\r\nline\r\n--MyBoundary--\r\n"
  match parse_form(body, "MyBoundary") {
    Ok(_) => expect("ok") == "an error"
    Err(e) => expect(e.msg) == "multipart: unexpected line in Next(): \"x\\r\\n\""
  }
}
