test "go net/netip: ParseAddr and ParsePrefix" {
  var bad: List[Str] = []
  for (s, want) in ADDRS {
    let got = parse_addr(s).map(fn(a) {
      (a.bits, a.ip.to_hex(), a.zone, addr_display(a), addr_is_4in6(a), addr_is_loopback(a), addr_is_private(a), addr_is_unspecified(a), addr_is_link_local_unicast(a), addr_is_multicast(a), addr_is_4(addr_unmap(a)), addr_bytes(a).to_hex())
    }).map_err(fn(e) { e.msg })
    if got != want && bad.len() < 10 {
      bad.push("${s.quote()}: got ${got.debug()} want ${want.debug()}")
    }
  }
  let probes = PROBES.map(fn(p) { parse_addr(p).or_fault("probe") })
  for (s, want) in PREFIXES {
    let got = parse_prefix(s).map(fn(p) { (prefix_display(p), prefix_display(prefix_masked(p)), probes.map(fn(a) { "${prefix_contains(p, a)}" }).join(" ")) }).map_err(fn(e) { e.msg })
    if got != want && bad.len() < 20 {
      bad.push("prefix ${s.quote()}: got ${got.debug()} want ${want.debug()}")
    }
  }
  expect(bad) == []
}

test "addresses order as Go's Compare" {
  let xs = ["10.0.0.2", "::1", "10.0.0.10", "fe80::1%b", "fe80::1%a", "1.2.3.4", "::ffff:1.2.3.4"].map(fn(s) { parse_addr(s).or_fault("addr") })
  expect(xs.sort().map(fn(a) { addr_display(a) })) == ["1.2.3.4", "10.0.0.2", "10.0.0.10", "::1", "::ffff:1.2.3.4", "fe80::1%a", "fe80::1%b"]
}
