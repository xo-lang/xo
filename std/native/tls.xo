// std/tls on the native backends (decision 0281): the client of
// std/native/llrt/tlsio.xo (the http client's) on a connection the
// program dialed. std/rt/tls.go is the Go backend's.
use std/crypto
use std/tls
use std/x509
use native/rt
use native/rthttp
use native/llrt/cabi_tlsclient
use native/llrt/netwasi
use native/llrt/netconn
use native/llrt/poll
use native/llrt/raw
use native/llrt/tls12
use native/llrt/tls13
use native/llrt/tlsio
use native/llrt/tlsneg
use native/llrt/tlsserve
use native/llrt/tls13srv
use native/llrt/tlssrv
use native/llrt/twflags
use native/llrt/x509cert as x509c

struct Roots {
  r: rthttp.Roots
}

/// The connection (counted: the TLS state uses its descriptor), its TLS
/// state (none on FakeNet: the bytes pass through), and whether close ran.
/// tls.TlsCert, http.TlsCert too (decision 0433): the chain's DER
/// certificates and the private key (std/native/http.xo's with_tls reads it through cert_data).
struct TlsCert {
  c: tlssrv.Cert
}

struct TlsConn {
  c: Conn
  h: rthttp.TlsH?
}

/// The text of a read or write after close (Go's net.ErrClosed).
const CLOSED_TEXT = "use of closed network connection"

/// The text of a write after close_write (Go's errShutdown).
const SHUTDOWN_TEXT = "tls: protocol is shutdown"

/// The test world's real network (netconn.xo TW_REAL_NET).
const TW_REAL_NET = 4

fn roots(pem: Bytes) -> Roots ! tls.TlsErr {
  let r = tlsio.roots_pem(pem)
  let e = tlsio.roots_err(r)
  if !e.is_empty() {
    return Err(tls.TlsErr{msg: e})
  }
  Roots{r: r}
}

/// The chain and key of a tls.TlsCert, for std/native/http.xo's with_tls
/// (std-internal: http sees the std type, decision 0433).
pub fn cert_data(t: tls.TlsCert) -> tlssrv.Cert { rt.cast[tls.TlsCert, TlsCert](t).c }

/// The roots record of r (std/native/http.xo cannot read another module's fields).
pub fn roots_data(r: tls.Roots) -> rthttp.Roots { rt.cast[tls.Roots, Roots](r).r }

fn cert(cert_pem: Bytes, key_pem: Bytes) -> TlsCert ! tls.TlsErr {
  let (c, e) = tlssrv.cert(cert_pem, key_pem)
  if !e.is_empty() {
    return Err(tls.TlsErr{msg: e})
  }
  TlsCert{c: c}
}

/// f as the tlsio hook: the DERs parsed (those that parse), Err's text or "".
pub fn vconn_wrap(f: fn(List[x509.Certificate]) -> () ! Str) -> fn(List[Bytes]) -> Str {
  fn(ders: List[Bytes]) -> Str {
    var certs: List[x509.Certificate] = []
    for d in ders {
      if let Ok(x) = x509.parse(d) {
        certs.push(x)
      }
    }
    match f(certs) {
      Ok(_) => ""
      Err(e) => if e.is_empty() { "tls: verify_conn failed" } else { e }
    }
  }
}

/// Go's pin check over the leaf's DER: pin is hex (colons and spaces dropped), of the digest h's size.
fn pin_check(h: crypto.Hash, pin: Str) -> (fn(List[x509.Certificate]) -> () ! Str) ! Str {
  var hex = pin.replace(":", "").replace(" ", "")
  let want = Bytes.from_hex(hex) ?? return Err("tls: pin is not hexadecimal")
  if want.len() != h.size() {
    return Err("tls: pin is ${want.len()} bytes, want ${h.size()}")
  }
  fn(certs: List[x509.Certificate]) -> () ! Str {
    if certs.is_empty() {
      return Err("tls: server presented no certificate")
    }
    if !crypto.equal(crypto.digest(h, certs[0].raw), want) {
      return Err("tls: certificate does not match the pin")
    }
    Ok(())
  }
}

fn pin_sha1(pin: Str) -> (fn(List[x509.Certificate]) -> () ! Str) ! Str { pin_check(crypto.Hash.Sha1, pin) }

fn pin_sha256(pin: Str) -> (fn(List[x509.Certificate]) -> () ! Str) ! Str { pin_check(crypto.Hash.Sha256, pin) }

/// cert is passed to the client's CertificateRequest path when it lands
/// (Lang 3's tls13/tls12 hooks, decision 0433); until then the client
/// answers a request with no certificate.
fn client(c: Conn, host: Str, roots: Roots? = None, verify: tls.Verify = tls.Verify.Full, alpn: List[Str] = [], cert: TlsCert? = None, verify_conn: (fn(List[x509.Certificate]) -> () ! Str)? = None, min_version: Int = 0, max_version: Int = 0, cipher_suites: List[Int] = [], curve_preferences: List[Int] = []) -> TlsConn ! NetErr uses net.dial {
  client_full(c, host, roots, verify, alpn, cert, verify_conn, min_version, max_version, cipher_suites, curve_preferences, None, None)
}

/// client with ClientConfig's hooks (decision 0644 T6).
fn client_full(c: Conn, host: Str, roots: Roots?, verify: tls.Verify, alpn: List[Str], cert: TlsCert?, verify_conn: (fn(List[x509.Certificate]) -> () ! Str)?, min_version: Int, max_version: Int, cipher_suites: List[Int], curve_preferences: List[Int], vhook: (fn(tlsneg.Negotiated) -> Str)?, get_cert: (fn(List[Bytes], List[Int], Int) -> (List[Bytes], Bytes, Str))?) -> TlsConn ! NetErr uses net.dial {
  if host.is_empty() && verify == tls.Verify.Full {
    // Go's Client without ServerName: the name could not be verified
    return Err(NetErr.Io(msg: "tls: either ServerName or InsecureSkipVerify must be specified in the tls.Config"))
  }
  let cn = rt.obj_addr(c)
  if target.arch == TargetArch.Wasm32 {
    // a wasip2 command's connection (netwasi.xo, decision 0447 R2e):
    // tlsio reads and writes it, and its own deadlines apply to them
    return client_wasm(c, host, roots, verify, alpn, cert, min_version, max_version, cipher_suites, curve_preferences, vhook, get_cert)
  }
  if netconn.conn_upgraded(cn) {
    return Err(NetErr.Io(msg: "use of a connection upgraded to TLS"))
  }
  netconn.conn_upgrade(cn)
  if twflags.fake(TW_REAL_NET) {
    // FakeNet: no TLS, the connection's bytes pass through
    return TlsConn{c: c, h: None}
  }
  var r = match roots {
    Some(x) => x.r
    None => tlsio.roots_system_at(rt.fn_addr("tls_roots_free"), true)
  }
  if let Some(f) = verify_conn {
    r = tlsio.roots_with_tls(r, "", Some(vconn_wrap(f)))
  }
  let v = match verify {
    Full => tlsio.VERIFY_FULL
    ChainOnly => tlsio.VERIFY_CHAIN
    None => tlsio.VERIFY_NONE
  }
  // the connection's deadlines apply to the handshake (Go's Handshake)
  let rd = netconn.user_deadline(cn, false)
  let wd = netconn.user_deadline(cn, true)
  let dl = if rd == 0 { wd } else if wd != 0 && wd < rd { wd } else { rd }
  var ccerts: List[Bytes] = []
  var ckey = b""
  if let Some(tc) = cert {
    let cd = tc.c
    ccerts = cd.certs
    ckey = cd.key
  }
  let started = tlsio.client_with(netconn.conn_pd(cn), host, rt.obj_addr(r), dl, alpn, v, ccerts, ckey, min_version, max_version, cipher_suites, curve_preferences, vhook: vhook, get_cert: get_cert)
  if started.status == tlsio.CC_TIMEOUT {
    return Err(NetErr.Timeout)
  }
  if started.status == tlsio.CC_CANCELED {
    return Err(NetErr.Canceled)
  }
  if started.status != tlsio.CC_OK {
    // the http client's text for a plain HTTP server is net/http's;
    // crypto/tls's own is this
    let msg = if started.msg == "http: server gave HTTP response to HTTPS client" { "tls: first record does not look like a TLS handshake" } else { started.msg }
    return Err(NetErr.Io(msg: msg))
  }
  tlsio.set_conn(started.conn, cn)
  TlsConn{c: c, h: Some(tlsio.handle_new(started.conn))}
}

/// client on wasm: no upgrade mark, no system roots (none on wasm).
fn client_wasm(c: Conn, host: Str, roots: Roots?, verify: tls.Verify, alpn: List[Str], cert: TlsCert?, min_version: Int, max_version: Int, cipher_suites: List[Int], curve_preferences: List[Int], vhook: (fn(tlsneg.Negotiated) -> Str)? = None, get_cert: (fn(List[Bytes], List[Int], Int) -> (List[Bytes], Bytes, Str))? = None) -> TlsConn ! NetErr uses net.dial {
  let cn = rt.obj_addr(c)
  if netwasi.upgraded(cn) {
    return Err(NetErr.Io(msg: "use of a connection upgraded to TLS"))
  }
  netwasi.upgrade(cn)
  let r = match roots {
    Some(x) => rt.obj_addr(x.r)
    None => 0
  }
  let v = match verify {
    Full => tlsio.VERIFY_FULL
    ChainOnly => tlsio.VERIFY_CHAIN
    None => tlsio.VERIFY_NONE
  }
  var ccerts: List[Bytes] = []
  var ckey = b""
  if let Some(tc) = cert {
    ccerts = tc.c.certs
    ckey = tc.c.key
  }
  let started = tlsio.client_with(cn, host, r, netwasi.user_deadline(cn), alpn, v, ccerts, ckey, min_version, max_version, cipher_suites, curve_preferences, vhook: vhook, get_cert: get_cert)
  if started.status == tlsio.CC_TIMEOUT {
    return Err(NetErr.Timeout)
  }
  if started.status == tlsio.CC_CANCELED {
    return Err(NetErr.Canceled)
  }
  if started.status != tlsio.CC_OK {
    let msg = if started.msg == "http: server gave HTTP response to HTTPS client" { "tls: first record does not look like a TLS handshake" } else { started.msg }
    return Err(NetErr.Io(msg: msg))
  }
  // the handshake's deadline ends; the connection's own apply after
  tlsio.set_conn(started.conn, cn)
  TlsConn{c: c, h: Some(tlsio.handle_new(started.conn))}
}

fn (t: TlsConn) read(max: Int) -> Bytes? ! NetErr uses net.dial {
  let h = match t.h {
    Some(x) => {
      if tlsio.handle_closed(x) {
        return Err(NetErr.Io(msg: CLOSED_TEXT))
      }
      tlsio.handle_conn(x)
    }
    None => return passthrough_read(t.c, max)
  }
  if max <= 0 {
    return Some(b"")
  }
  if target.arch != TargetArch.Wasm32 && netconn.deadline_passed(rt.obj_addr(t.c), false) {
    return Err(NetErr.Timeout)
  }
  let n = if max > 1048576 { 1048576 } else { max }
  let buf = raw.bytes_buf(n)
  let k = tlsio.read(h, raw.bytes_addr(buf), n)
  if k > 0 {
    return Some(raw.bytes_len(buf, k))
  }
  if k == 0 {
    return None
  }
  Err(cc_err(-k, "read", tlsio.alert(h)))
}

fn (t: TlsConn) write(data: Bytes) -> () ! NetErr uses net.dial {
  let h = match t.h {
    Some(x) => {
      if tlsio.handle_closed(x) {
        return Err(NetErr.Io(msg: CLOSED_TEXT))
      }
      if tlsio.handle_write_shut(x) {
        return Err(NetErr.Io(msg: SHUTDOWN_TEXT))
      }
      tlsio.handle_conn(x)
    }
    None => return passthrough_write(t.c, data)
  }
  if target.arch != TargetArch.Wasm32 && netconn.deadline_passed(rt.obj_addr(t.c), true) {
    // as Go's: the failed write breaks the TLS stream for good
    tlsio.fail_writes(h, tlsio.CC_TIMEOUT)
    return Err(NetErr.Timeout)
  }
  let s = tlsio.write(h, raw.bytes_addr(data), data.len())
  raw.alive(data)
  if s != tlsio.CC_OK {
    return Err(cc_err(s, "write", tlsio.alert(h)))
  }
}

fn (t: TlsConn) close() {
  if let Some(x) = t.h {
    if tlsio.handle_closed(x) {
      return
    }
    let sent = tlsio.handle_write_shut(x)
    tlsio.handle_close(x)
    if !sent {
      tlsio.close_notify(tlsio.handle_conn(x))
    }
  }
  if target.arch == TargetArch.Wasm32 {
    t.c.close()
    return
  }
  netconn.conn_close(rt.obj_addr(t.c))
}

// Deadlines (decision 0430): the connection's, which the TLS waits read
// at each wait.
fn (t: TlsConn) set_deadline(clock: Clock, at: Time?) uses clock { t.c.set_deadline(clock, at) }
fn (t: TlsConn) set_read_deadline(clock: Clock, at: Time?) uses clock { t.c.set_read_deadline(clock, at) }
fn (t: TlsConn) set_write_deadline(clock: Clock, at: Time?) uses clock { t.c.set_write_deadline(clock, at) }

fn (t: TlsConn) alpn() -> Str {
  match t.h {
    Some(x) => tlsio.alpn_of(tlsio.handle_conn(x))
    None => ""
  }
}

fn roots_of(certs: List[x509.Certificate]) -> Roots ! tls.TlsErr {
  if certs.is_empty() {
    return Err(tls.TlsErr{msg: "tls: no certificates"})
  }
  var ders: List[Bytes] = []
  for c in certs {
    ders.push(c.raw)
  }
  Roots{r: tlsio.roots_ders(ders)}
}

fn (t: TlsConn) peer_certificates() -> List[x509.Certificate] {
  let h = match t.h {
    Some(x) => x
    None => return []
  }
  var out: List[x509.Certificate] = []
  for der in tlsio.peer_ders(tlsio.handle_conn(h)) {
    if let Ok(c) = x509.parse(der) {
      out.push(c)
    }
  }
  out
}

fn (t: TlsConn) state() -> tls.ConnState {
  let h = match t.h {
    Some(x) => x
    None => return tls.ConnState{version: 0x0304, handshake_complete: true, did_resume: false, cipher_suite: 0, curve_id: 0, negotiated_protocol: "", server_name: "", peer_certificates: [], verified_chains: []}
  }
  let n = tlsio.negotiated_of(tlsio.handle_conn(h))
  state_of(n, n.vers != 0)
}

/// The ConnState of what n negotiated; during the handshake (complete
/// false: VerifyConnection's) without tls_unique.
fn state_of(n: tlsneg.Negotiated, complete: Bool) -> tls.ConnState {
  tls.ConnState{version: n.vers, handshake_complete: complete, did_resume: n.resumed, cipher_suite: n.suite, curve_id: n.group, negotiated_protocol: n.alpn, server_name: n.server_name, peer_certificates: parse_ders(n.peer), verified_chains: n.verified.map(parse_ders), tls_unique: if complete { unique_of(n) } else { b"" }}
}

/// Go's ConnectionState.TLSUnique: TLS 1.2's first Finished, unless a
/// resumption without Extended Master Secret.
fn unique_of(n: tlsneg.Negotiated) -> Bytes { if n.vers == 0x0303 && (!n.resumed || n.ems) { n.unique } else { b"" } }

/// Go's ConnectionState.ExportKeyingMaterial over what n negotiated.
fn ekm_of(n: tlsneg.Negotiated, label: Str, context: Bytes?, length: Int) -> Bytes ! tls.TlsErr {
  if n.vers == 0x0304 {
    return tls13.exporter(n.suite, n.exp, label, context ?? b"", length)
  }
  if n.vers != 0x0303 {
    return Err(tls.TlsErr{msg: "tls: ExportKeyingMaterial before the handshake completed"})
  }
  if !n.ems {
    return Err(tls.TlsErr{msg: "crypto/tls: ExportKeyingMaterial is unavailable when neither TLS 1.3 nor Extended Master Secret are negotiated; override with GODEBUG=tlsunsafeekm=1"})
  }
  let (b, e) = tls12.ekm(n.suite, n.master, n.cr, n.sr, label, context, length)
  if !e.is_empty() {
    return Err(tls.TlsErr{msg: e})
  }
  b
}

fn (t: TlsConn) export_keying_material(label: Str, context: Bytes?, length: Int) -> Bytes ! tls.TlsErr {
  let h = t.h ?? return Err(tls.TlsErr{msg: "tls: ExportKeyingMaterial on a connection without TLS"})
  ekm_of(tlsio.negotiated_of(tlsio.handle_conn(h)), label, context, length)
}

/// The certificates of ders that parse (each was verified or sent as is).
fn parse_ders(ders: List[Bytes]) -> List[x509.Certificate] {
  var out: List[x509.Certificate] = []
  for der in ders {
    if let Ok(c) = x509.parse(der) {
      out.push(c)
    }
  }
  out
}

fn cipher_suite_name(id: Int) -> Str { tlsneg.suite_name(id) }

fn cipher_suites() -> List[tls.CipherSuite] {
  let v13 = [tls.VERSION_TLS13]
  let up12 = [tls.VERSION_TLS10, tls.VERSION_TLS11, tls.VERSION_TLS12]
  let v12 = [tls.VERSION_TLS12]
  var out: List[tls.CipherSuite] = []
  for (id, vs) in [(0x1301, v13), (0x1302, v13), (0x1303, v13), (0xc009, up12), (0xc00a, up12), (0xc013, up12), (0xc014, up12), (0xc02b, v12), (0xc02c, v12), (0xc02f, v12), (0xc030, v12), (0xcca8, v12), (0xcca9, v12)] {
    out.push(tls.CipherSuite{id: id, name: tlsneg.suite_name(id), supported_versions: vs, insecure: false})
  }
  out
}

fn insecure_cipher_suites() -> List[tls.CipherSuite] { [] }

fn version_name(version: Int) -> Str { tlsneg.version_name(version) }

fn curve_name(id: Int) -> Str { tlsneg.group_name(id) }

fn (t: TlsConn) version() -> Str {
  match t.h {
    Some(x) => tlsio.version_of(tlsio.handle_conn(x))
    None => "TLS 1.3"
  }
}

/// The NetErr of a failed read or write (tlsio CC_*): a server's alert's
/// text, else Go's text of a closed or broken connection.
fn cc_err(status: Int, op: Str, alert: Str) -> NetErr {
  if status == tlsio.CC_TIMEOUT {
    return NetErr.Timeout
  }
  if status == tlsio.CC_CANCELED {
    return NetErr.Canceled
  }
  if !alert.is_empty() {
    return NetErr.Io(msg: alert)
  }
  NetErr.Io(msg: "${op} tcp: use of closed network connection")
}

/// FakeNet's TlsConn reads the connection itself. The connection is
/// marked upgraded, so its own read refuses: lift the mark around it.
fn passthrough_read(c: Conn, max: Int) -> Bytes? ! NetErr uses net.dial {
  let cn = rt.obj_addr(c)
  netconn.conn_unupgrade(cn)
  let r = c.read(max)
  netconn.conn_upgrade(cn)
  r
}

fn passthrough_write(c: Conn, data: Bytes) -> () ! NetErr uses net.dial {
  let cn = rt.obj_addr(c)
  netconn.conn_unupgrade(cn)
  let r = c.write(data)
  netconn.conn_upgrade(cn)
  r
}

/// The message (decision 0358).
fn tlserr_display(e: tls.TlsErr) -> Str { e.msg }

/// The host part of addr (Go's Dial: up to the last colon), brackets kept
/// (client drops them).
fn dial_host(addr: Str) -> Str {
  match addr.rfind(":") {
    Some(i) => addr[..i]
    None => addr
  }
}

fn dial(net: Net, addr: Str, server_name: Str = "", roots: Roots? = None, verify: tls.Verify = tls.Verify.Full, alpn: List[Str] = [], cert: TlsCert? = None, verify_conn: (fn(List[x509.Certificate]) -> () ! Str)? = None, timeout: Duration? = None, min_version: Int = 0, max_version: Int = 0, cipher_suites: List[Int] = [], curve_preferences: List[Int] = []) -> TlsConn ! NetErr uses net.dial {
  let name = if server_name.is_empty() { dial_host(addr) } else { server_name }
  let c = dial_open(net, addr, timeout)?
  dial_done(c, timeout, client(c, name, roots: roots, verify: verify, alpn: alpn, cert: cert, verify_conn: verify_conn, min_version: min_version, max_version: max_version, cipher_suites: cipher_suites, curve_preferences: curve_preferences))
}

/// The connection dial runs the client on: with a timeout, dialed under
/// it and given a deadline of what is left for the handshake (Go's
/// Dialer).
fn dial_open(net: Net, addr: Str, timeout: Duration?) -> Conn ! NetErr uses net.dial {
  let d = match timeout {
    Some(t) => t
    None => return net.dial(addr)
  }
  let wasm = target.arch == TargetArch.Wasm32
  // wasm has no monotonic reading here: its handshake gets the whole d
  let start = if wasm { 0 } else { poll.now() }
  let c = net.dial_timeout(addr, d)?
  let left = if wasm { d.nanos() } else { d.nanos() - (poll.now() - start) }
  if left <= 0 {
    c.close()
    return Err(NetErr.Timeout)
  }
  if wasm {
    netwasi.set_deadline(c, 3, true, left)
  } else {
    netconn.set_deadline(rt.obj_addr(c), 3, true, left)
  }
  c
}

/// After dial's handshake: the deadline dial_open set cleared, and the
/// connection closed when the handshake failed.
fn dial_done(c: Conn, timeout: Duration?, r: Result[TlsConn, NetErr]) -> TlsConn ! NetErr {
  if timeout.is_none() {
    return r
  }
  if target.arch == TargetArch.Wasm32 {
    netwasi.set_deadline(c, 3, false, 0)
  } else {
    netconn.set_deadline(rt.obj_addr(c), 3, false, 0)
  }
  if r is Err(..) {
    c.close()
  }
  r
}

fn client_config(c: Conn, config: tls.ClientConfig) -> TlsConn ! NetErr uses net.dial {
  let one = if config.certificates.len() == 1 { Some(rt.cast[tls.TlsCert, TlsCert](config.certificates[0])) } else { None }
  let roots = match config.roots {
    Some(r) => Some(rt.cast[tls.Roots, Roots](r))
    None => None
  }
  client_full(c, config.server_name, roots, config.verify, config.next_protos, one, None, config.min_version, config.max_version, config.cipher_suites, config.curve_preferences, client_vhook(config), client_get_cert(config))
}

fn dial_config(net: Net, addr: Str, config: tls.ClientConfig, timeout: Duration? = None) -> TlsConn ! NetErr uses net.dial {
  let cfg = if config.server_name.is_empty() { config with {server_name: dial_host(addr)} } else { config }
  let c = dial_open(net, addr, timeout)?
  dial_done(c, timeout, client_config(c, cfg))
}

/// ClientConfig's verify_peer_certificate then verify_connection as the
/// handshake's hook (decision 0644 T6).
fn client_vhook(cfg: tls.ClientConfig) -> (fn(tlsneg.Negotiated) -> Str)? {
  if cfg.verify_peer_certificate.is_none() && cfg.verify_connection.is_none() {
    return None
  }
  let vp = cfg.verify_peer_certificate
  let vc = cfg.verify_connection
  Some(fn(n: tlsneg.Negotiated) -> Str { verify_hooks(vp, vc, n) })
}

/// verify_peer_certificate and verify_connection over n, on either end:
/// the text of the first Err (a default for an empty one), "" when both
/// pass.
fn verify_hooks(vp: (fn(List[Bytes], List[List[x509.Certificate]]) -> () ! Str)?, vc: (fn(tls.ConnState) -> () ! Str)?, n: tlsneg.Negotiated) -> Str {
  if let Some(f) = vp {
    if let Err(e) = f(n.peer, n.verified.map(parse_ders)) {
      return if e.is_empty() { "tls: verify_peer_certificate failed" } else { e }
    }
  }
  if let Some(f) = vc {
    if let Err(e) = f(state_of(n, false)) {
      return if e.is_empty() { "tls: verify_connection failed" } else { e }
    }
  }
  ""
}

/// ClientConfig's get_client_certificate, or with more than one of
/// certificates the first the request supports (Go's
/// getClientCertificate), as the handshake's hook; None with at most one
/// (client's cert path).
fn client_get_cert(cfg: tls.ClientConfig) -> (fn(List[Bytes], List[Int], Int) -> (List[Bytes], Bytes, Str))? {
  if let Some(g) = cfg.get_client_certificate {
    return Some(fn(cas: List[Bytes], schemes: List[Int], v: Int) -> (List[Bytes], Bytes, Str) {
      match g(tls.CertificateRequestInfo{acceptable_cas: cas, signature_schemes: schemes, version: v}) {
        Ok(Some(tc)) => (cert_data(tc).certs, cert_data(tc).key, "")
        Ok(None) => ([], b"", "")
        Err(e) => ([], b"", if e.is_empty() { "tls: get_client_certificate failed" } else { e })
      }
    })
  }
  if cfg.certificates.len() <= 1 {
    return None
  }
  let certs = cfg.certificates
  Some(fn(cas: List[Bytes], schemes: List[Int], v: Int) -> (List[Bytes], Bytes, Str) {
    for tc in certs {
      let d = cert_data(tc)
      if tls13.supports(d.certs, d.key, cas, schemes).is_empty() {
        return (d.certs, d.key, "")
      }
    }
    ([], b"", "")
  })
}

/// ServerConfig's verify_peer_certificate as the handshake's hook.
fn server_vpeer(cfg: tls.ServerConfig) -> (fn(List[Bytes], List[List[Bytes]]) -> Str)? {
  let f = cfg.verify_peer_certificate ?? return None
  Some(fn(peer: List[Bytes], chains: List[List[Bytes]]) -> Str {
    match f(peer, chains.map(parse_ders)) {
      Ok(_) => ""
      Err(e) => if e.is_empty() { "tls: verify_peer_certificate failed" } else { e }
    }
  })
}

/// ServerConfig's verify_connection as the handshake's hook.
fn server_vconn(cfg: tls.ServerConfig) -> (fn(tlsneg.Negotiated) -> Str)? {
  if cfg.verify_connection.is_none() {
    return None
  }
  let vc = cfg.verify_connection
  Some(fn(n: tlsneg.Negotiated) -> Str { verify_hooks(None, vc, n) })
}

/// config's certificates and client roots as the engine takes them.
fn engine_parts(config: tls.ServerConfig) -> (List[tlssrv.Cert], List[x509c.Cert]) {
  var certs: List[tlssrv.Cert] = []
  for tc in config.certificates {
    certs.push(cert_data(tc))
  }
  let roots = match config.client_cas {
    Some(r) => tlsio.roots_certs(roots_data(r))
    None => []
  }
  (certs, roots)
}

/// The ClientHelloInfo of h on connection c.
fn chi_of(h: tlsneg.HelloInfo, c: ServerConn) -> tls.ClientHelloInfo {
  tls.ClientHelloInfo{cipher_suites: h.suites, server_name: h.server_name, supported_curves: h.curves, supported_points: h.points, signature_schemes: h.schemes, supported_protos: h.protos, supported_versions: h.versions, extensions: h.exts, local_addr: c.local_addr(), remote_addr: c.remote_addr()}
}

/// ServerConfig's get_certificate as the engine's hook (decision 0644 T5).
fn server_get_cert(cfg: tls.ServerConfig, c: ServerConn) -> (fn(tlsneg.HelloInfo) -> (List[Bytes], Bytes, Str))? {
  let g = cfg.get_certificate ?? return None
  Some(fn(h: tlsneg.HelloInfo) -> (List[Bytes], Bytes, Str) {
    match g(chi_of(h, c)) {
      Ok(Some(tc)) => (cert_data(tc).certs, cert_data(tc).key, "")
      Ok(None) => ([], b"", "")
      Err(e) => ([], b"", if e.is_empty() { "tls: get_certificate failed" } else { e })
    }
  })
}

/// ServerConfig's get_config_for_client as the engine's hook: the
/// configuration it gives as the engine's, with its own get_certificate
/// (its get_config_for_client is not called, as Go's).
fn server_for_client(cfg: tls.ServerConfig, c: ServerConn) -> (fn(tlsneg.HelloInfo) -> (tls13srv.Conf?, Str))? {
  let f = cfg.get_config_for_client ?? return None
  Some(fn(h: tlsneg.HelloInfo) -> (tls13srv.Conf?, Str) {
    match f(chi_of(h, c)) {
      Ok(Some(nc)) => {
        let (certs, roots) = engine_parts(nc)
        (Some(tlssrv.conf_of(certs, nc.next_protos, server_auth_mode(nc.client_auth), roots, nc.min_version, nc.max_version, nc.cipher_suites, nc.curve_preferences, server_vpeer(nc), server_vconn(nc), server_get_cert(nc, c))), "")
      }
      Ok(None) => (None, "")
      Err(e) => (None, if e.is_empty() { "tls: get_config_for_client failed" } else { e })
    }
  })
}

fn clienthelloinfo_supports_certificate(i: tls.ClientHelloInfo, cert: TlsCert) -> () ! tls.TlsErr {
  let h = tlsneg.HelloInfo{suites: i.cipher_suites, server_name: i.server_name, curves: i.supported_curves, points: i.supported_points, schemes: i.signature_schemes, protos: i.supported_protos, versions: i.supported_versions, exts: i.extensions}
  let e = tlssrv.chi_supports(h, cert.c.certs, cert.c.key)
  if e.is_empty() {
    return Ok(())
  }
  Err(tls.TlsErr{msg: e})
}

fn certificaterequestinfo_supports_certificate(i: tls.CertificateRequestInfo, cert: TlsCert) -> () ! tls.TlsErr {
  let e = tls13.supports(cert.c.certs, cert.c.key, i.acceptable_cas, i.signature_schemes)
  if e.is_empty() {
    return Ok(())
  }
  Err(tls.TlsErr{msg: e})
}

fn load_cert(fs: Fs, cert_file: Str, key_file: Str) -> TlsCert ! tls.TlsErr uses fs.read {
  let cp = match fs.read(cert_file) {
    Ok(b) => b
    Err(e) => return Err(tls.TlsErr{msg: "${e}"})
  }
  let kp = match fs.read(key_file) {
    Ok(b) => b
    Err(e) => return Err(tls.TlsErr{msg: "${e}"})
  }
  cert(cp, kp)
}

fn (t: TlsConn) net_conn() -> Conn { t.c }

fn (t: TlsConn) verify_hostname(host: Str) -> () ! tls.TlsErr {
  let st = t.state()
  if st.verified_chains.is_empty() || st.peer_certificates.is_empty() {
    return Err(tls.TlsErr{msg: "tls: handshake did not verify certificate chain"})
  }
  match st.peer_certificates[0].verify_hostname(host) {
    Ok(_) => Ok(())
    Err(e) => Err(tls.TlsErr{msg: "${e}"})
  }
}

fn (t: TlsConn) local_addr() -> Str { t.c.local_addr() }

fn (t: TlsConn) remote_addr() -> Str { t.c.remote_addr() }

/// Go's Conn.CloseWrite: close_notify, then the connection's close_write.
fn (t: TlsConn) close_write() -> () ! NetErr uses net.dial {
  if let Some(x) = t.h {
    if tlsio.handle_closed(x) {
      return Err(NetErr.Io(msg: CLOSED_TEXT))
    }
    if !tlsio.handle_write_shut(x) {
      tlsio.handle_shut_write(x)
      tlsio.close_notify(tlsio.handle_conn(x))
    }
  }
  t.c.close_write()
}

// ---------------------------------------------------------------------------
// The server (decision 0644 T1): tlssrv's engine, as std/http's TLS uses
// it, on a connection of the program's own.

/// h holds the tlssrv connection (None: no certificate, every operation
/// fails with Go's text); fake: FakeNet's connection, whose bytes pass
/// through.
struct TlsServerConn {
  c: ServerConn
  h: rthttp.TlsH?
  fake: Bool
}

/// Go's Server Handshake with an empty Certificates.
const NO_CERTS_TEXT = "tls: no certificates configured"

/// tls.Listen's text for a Config with no certificate.
const LISTEN_NO_CERTS_TEXT = "tls: neither Certificates, GetCertificate, nor GetConfigForClient set in Config"

fn server_auth_mode(m: tls.ClientAuth) -> Int {
  match m {
    tls.ClientAuth.None => 0
    tls.ClientAuth.Request => 1
    tls.ClientAuth.RequireAny => 2
    tls.ClientAuth.VerifyIfGiven => 3
    tls.ClientAuth.RequireAndVerify => 4
  }
}

fn server(c: ServerConn, config: tls.ServerConfig) -> TlsServerConn {
  let cn = rt.obj_addr(c)
  let wasm = target.arch == TargetArch.Wasm32
  if wasm {
    netwasi.upgrade(cn)
  } else {
    netconn.conn_upgrade(cn)
    if twflags.fake(TW_REAL_NET) {
      return TlsServerConn{c: c, h: None, fake: true}
    }
  }
  let (certs, roots) = engine_parts(config)
  let pd = if wasm { cn } else { netconn.conn_pd(cn) }
  let t = tlssrv.conn_cfg(certs, config.next_protos, server_auth_mode(config.client_auth), roots, pd, config.min_version, config.max_version, config.cipher_suites, config.curve_preferences, server_vpeer(config), server_vconn(config), server_for_client(config, c), server_get_cert(config, c))
  if t == 0 {
    return TlsServerConn{c: c, h: None, fake: false}
  }
  TlsServerConn{c: c, h: Some(tlsserve.handle_new(t)), fake: false}
}

/// The connection's deadline for reads (write false) or writes, on the
/// timers' clock (0 none), which tlssrv waits until.
fn srv_deadline(c: ServerConn, write: Bool) -> Int {
  let cn = rt.obj_addr(c)
  if target.arch == TargetArch.Wasm32 { netwasi.user_deadline(cn) } else { netconn.user_deadline(cn, write) }
}

/// The earlier of two deadlines (0 none).
fn earlier(a: Int, b: Int) -> Int { if a == 0 { b } else if b != 0 && b < a { b } else { a } }

/// Why tlssrv block t's last operation failed, as a NetErr.
fn srv_err(t: Int, what: Str) -> NetErr {
  if tlssrv.timed_out(t) {
    return NetErr.Timeout
  }
  let e = tlssrv.err_text(t)
  NetErr.Io(msg: if e.is_empty() { what } else { e })
}

fn (t: TlsServerConn) handshake() -> () ! NetErr uses net.listen {
  if t.fake {
    return Ok(())
  }
  let h = t.h ?? return Err(NetErr.Io(msg: NO_CERTS_TEXT))
  if tlsserve.state(h) == 1 {
    return Err(NetErr.Io(msg: CLOSED_TEXT))
  }
  let b = tlsserve.block(h)
  tlssrv.set_deadline(b, earlier(srv_deadline(t.c, false), srv_deadline(t.c, true)))
  if !tlssrv.handshake(b) {
    return Err(srv_err(b, "tls: handshake failed"))
  }
  Ok(())
}

fn (t: TlsServerConn) read(max: Int) -> Bytes? ! NetErr uses net.listen {
  if t.fake {
    let cn = rt.obj_addr(t.c)
    netconn.conn_unupgrade(cn)
    let r = t.c.read(max)
    netconn.conn_upgrade(cn)
    return r
  }
  t.handshake()?
  let b = tlsserve.block(t.h ?? return Err(NetErr.Io(msg: NO_CERTS_TEXT)))
  if max <= 0 {
    return Some(b"")
  }
  tlssrv.set_deadline(b, srv_deadline(t.c, false))
  let n = if max > 1048576 { 1048576 } else { max }
  let buf = raw.bytes_buf(n)
  let k = tlssrv.hc_read(b, raw.bytes_addr(buf), n)
  if k > 0 {
    return Some(raw.bytes_len(buf, k))
  }
  if k == 0 {
    return None
  }
  Err(srv_err(b, CLOSED_TEXT))
}

fn (t: TlsServerConn) write(data: Bytes) -> () ! NetErr uses net.listen {
  if t.fake {
    let cn = rt.obj_addr(t.c)
    netconn.conn_unupgrade(cn)
    let r = t.c.write(data)
    netconn.conn_upgrade(cn)
    return r
  }
  t.handshake()?
  let h = t.h ?? return Err(NetErr.Io(msg: NO_CERTS_TEXT))
  if tlsserve.state(h) == 2 {
    return Err(NetErr.Io(msg: SHUTDOWN_TEXT))
  }
  let b = tlsserve.block(h)
  tlssrv.set_deadline(b, srv_deadline(t.c, true))
  let s = tlssrv.write(b, raw.bytes_addr(data), data.len())
  raw.alive(data)
  match s {
    0 => Ok(())
    2 => Err(NetErr.Timeout)
    3 => Err(NetErr.Canceled)
    _ => Err(srv_err(b, "write: connection reset by peer"))
  }
}

fn (t: TlsServerConn) close() {
  if let Some(h) = t.h {
    let st = tlsserve.state(h)
    if st == 1 {
      return
    }
    tlsserve.set_state(h, 1)
    if st == 0 {
      // after a handshake only (tlssrv.close_notify checks), at most 5 s
      tlssrv.close_notify(tlsserve.block(h))
    }
  }
  if target.arch == TargetArch.Wasm32 {
    t.c.close()
    return
  }
  netconn.conn_close(rt.obj_addr(t.c))
}

fn (t: TlsServerConn) close_write() -> () ! NetErr uses net.listen {
  if !t.fake {
    let h = t.h ?? return Err(NetErr.Io(msg: NO_CERTS_TEXT))
    if tlssrv.neg_any(tlsserve.block(h)) == 0 {
      // Go's errEarlyCloseWrite
      return Err(NetErr.Io(msg: "tls: CloseWrite called before handshake complete"))
    }
    if tlsserve.state(h) == 0 {
      tlsserve.set_state(h, 2)
      tlssrv.close_notify(tlsserve.block(h))
    }
  }
  t.c.close_write()
}

fn (t: TlsServerConn) set_deadline(clock: Clock, at: Time?) uses clock { t.c.set_deadline(clock, at) }
fn (t: TlsServerConn) set_read_deadline(clock: Clock, at: Time?) uses clock { t.c.set_read_deadline(clock, at) }
fn (t: TlsServerConn) set_write_deadline(clock: Clock, at: Time?) uses clock { t.c.set_write_deadline(clock, at) }

fn (t: TlsServerConn) state() -> tls.ConnState {
  let none = tls.ConnState{version: 0, handshake_complete: false, did_resume: false, cipher_suite: 0, curve_id: 0, negotiated_protocol: "", server_name: "", peer_certificates: [], verified_chains: []}
  if t.fake {
    return none with {version: 0x0304, handshake_complete: true}
  }
  let h = t.h ?? return none
  let w = tlssrv.neg_any(tlsserve.block(h))
  if w == 0 {
    return none
  }
  match rt.any_get[tlsneg.Negotiated](rt.obj_at[rt.Any](w)) {
    Some(n) => tls.ConnState{version: n.vers, handshake_complete: true, did_resume: n.resumed, cipher_suite: n.suite, curve_id: n.group, negotiated_protocol: n.alpn, server_name: n.server_name, peer_certificates: parse_ders(n.peer), verified_chains: n.verified.map(parse_ders), tls_unique: unique_of(n)}
    None => none
  }
}

fn (t: TlsServerConn) export_keying_material(label: Str, context: Bytes?, length: Int) -> Bytes ! tls.TlsErr {
  let none = Err(tls.TlsErr{msg: "tls: ExportKeyingMaterial before the handshake completed"})
  if t.fake {
    return Err(tls.TlsErr{msg: "tls: ExportKeyingMaterial on a connection without TLS"})
  }
  let h = t.h ?? return none
  let w = tlssrv.neg_any(tlsserve.block(h))
  if w == 0 {
    return none
  }
  match rt.any_get[tlsneg.Negotiated](rt.obj_at[rt.Any](w)) {
    Some(n) => ekm_of(n, label, context, length)
    None => none
  }
}

fn (t: TlsServerConn) local_addr() -> Str { t.c.local_addr() }

fn (t: TlsServerConn) remote_addr() -> Str { t.c.remote_addr() }

fn (t: TlsServerConn) net_conn() -> ServerConn { t.c }

struct TlsListener {
  l: Listener
  config: tls.ServerConfig
}

fn listen(net: Net, addr: Str, config: tls.ServerConfig) -> TlsListener ! NetErr uses net.listen {
  if config.certificates.is_empty() && config.get_certificate.is_none() && config.get_config_for_client.is_none() {
    return Err(NetErr.Io(msg: LISTEN_NO_CERTS_TEXT))
  }
  TlsListener{l: net.listen(addr)?, config: config}
}

fn new_listener(l: Listener, config: tls.ServerConfig) -> TlsListener { TlsListener{l: l, config: config} }

fn (l: TlsListener) accept() -> TlsServerConn ! NetErr uses net.listen { server(l.l.accept()?, l.config) }

fn (l: TlsListener) addr() -> Str { l.l.addr() }

fn (l: TlsListener) close() { l.l.close() }
