test "go parse_media_type" {
  for (input, kind, params, e) in PARSE {
    let got = parse_media_type(h(input)).map(fn(t) { (t.kind, t.params.entries().sort()) })
    if e.is_empty() {
      expect(got) == Ok((kind, params.map(fn(p) { (h(p.0), h(p.1)) })))
    } else {
      expect(got) == Err(mime.MimeErr{msg: e})
    }
  }
}

test "go format_media_type" {
  for (kind, params, want) in FORMAT {
    var m: Map[Str, Str] = {}
    for (k, v) in params {
      m.put(h(k), h(v))
    }
    expect(format_media_type(h(kind), m)) == h(want)
  }
}

test "extensions" {
  expect(type_by_extension(".png")) == Some("image/png")
  expect(type_by_extension(".PNG")) == Some("image/png")
  expect(type_by_extension(".html")) == Some("text/html; charset=utf-8")
  expect(type_by_extension(".nope")) == None
  expect(extensions_by_type("image/jpeg")) == Ok([".jfif", ".jpeg", ".jpg", ".pjp", ".pjpeg"])
  expect(extensions_by_type("text/html; charset=utf-8")) == Ok([".ehtml", ".htm", ".html", ".shtml"])
  expect(extensions_by_type("")) == Err(mime.MimeErr{msg: "mime: no media type"})
}

