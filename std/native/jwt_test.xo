use std/jwt

struct Claims {
  sub: Str
  exp: Int
  role: Str?
} derive Json

fn opts(now: Int) -> jwt.Options {
  jwt.Options{algs: [jwt.Alg.HS256], now: Time.UNIX_EPOCH + Duration.from_secs_int(now)}
}

test "HS256 round trip and the checks" {
  let key = jwt.Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = jwt.sign(os.rand, jwt.Alg.HS256, key, Claims{sub: "ann", exp: 2000, role: Some("admin")}, Some("k1"))?
  let got = jwt.verify_with[Claims](tok, key, opts(1000))?
  expect(got.sub) == "ann"
  expect(got.role) == Some("admin")
  expect(jwt.peek_header(tok)?.kid) == Some("k1")
  // expired and wrong key
  match jwt.verify_with[Claims](tok, key, opts(2000)) {
    Err(jwt.JwtErr.Expired(_)) => ()
    _ => fault("expected Expired")
  }
  let other = jwt.Key.Hmac(secret: Secret.new(b"another secret"))
  match jwt.verify_with[Claims](tok, other, opts(1000)) {
    Err(jwt.JwtErr.Signature) => ()
    _ => fault("expected Signature")
  }
  // not in algs
  var o = opts(1000)
  o.algs = [jwt.Alg.HS512]
  match jwt.verify_with[Claims](tok, key, o) {
    Err(jwt.JwtErr.Alg(_)) => ()
    _ => fault("expected Alg")
  }
  // a none token
  let none = "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhbm4iLCJleHAiOjIwMDB9."
  match jwt.verify_with[Claims](none, key, opts(1000)) {
    Err(jwt.JwtErr.Alg(_)) => ()
    _ => fault("expected Alg for none")
  }
}

struct Dates {
  exp: Int
  nbf: Int
  iat: Int
} derive Json

test "dates past 2262 do not overflow (b25)" {
  let key = jwt.Key.Hmac(secret: Secret.new(b"a secret of some length"))
  // year 3000: golang-jwt accepts it as not expired, not early
  let tok = jwt.sign(os.rand, jwt.Alg.HS256, key, Dates{exp: 32503680000, nbf: 0, iat: 0}, None)?
  var o = opts(1000)
  o.leeway = Duration.from_secs_int(60)
  o.check_iat = true
  o.max_age = Some(Duration.from_secs_int(3000))
  let _ = jwt.verify_with[Dates](tok, key, o)?
  // nbf and iat in the far future are not yet valid
  let early = jwt.sign(os.rand, jwt.Alg.HS256, key, Dates{exp: 32503680000, nbf: 32503680000, iat: 0}, None)?
  match jwt.verify_with[Dates](early, key, opts(1000)) {
    Err(jwt.JwtErr.NotYetValid(_)) => ()
    _ => fault("expected NotYetValid")
  }
  // an exp far in the past is expired, with a leeway that would overflow the sum
  let old = jwt.sign(os.rand, jwt.Alg.HS256, key, Dates{exp: -32503680000, nbf: 0, iat: 0}, None)?
  var big = opts(1000)
  big.leeway = Duration.from_secs_int(3000000000)
  match jwt.verify_with[Dates](old, key, big) {
    Err(jwt.JwtErr.Expired(_)) => ()
    _ => fault("expected Expired")
  }
  // the largest allowed date with a large leeway
  let edge = jwt.sign(os.rand, jwt.Alg.HS256, key, Dates{exp: 100000000000, nbf: 0, iat: 0}, None)?
  big.leeway = Duration.from_secs_int(9000000000)
  let _ = jwt.verify_with[Dates](edge, key, big)?
}
