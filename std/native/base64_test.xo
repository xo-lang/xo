test "go base64 Url encode" {
  check_encode(base64.Base64.Url, [
    ("6d75ca47dc507321b1", "bXXKR9xQcyGx"),
    ("c6c587d306", "xsWH0wY="),
    ("692e82df", "aS6C3w=="),
    ("6883c5eff48623c25148", "aIPF7_SGI8JRSA=="),
    ("ca5fc7bf196d70", "yl_HvxltcA=="),
    ("770d5970", "dw1ZcA=="),
    ("1a49", "Gkk="),
    ("fe9650d2a609b67064", "_pZQ0qYJtnBk"),
    ("b4", "tA=="),
    ("bb03512aeeb23e", "uwNRKu6yPg=="),
    ("97591c3a69", "l1kcOmk="),
