test "base64 round trip" for data: Bytes {
  expect(decode(encode(data, base64.Base64.Std), base64.Base64.Std)) == Ok(data)
  expect(decode(encode(data, base64.Base64.Url), base64.Base64.Url)) == Ok(data)
  expect(decode(encode(data, base64.Base64.RawStd), base64.Base64.RawStd)) == Ok(data)
  expect(decode(encode(data, base64.Base64.RawUrl), base64.Base64.RawUrl)) == Ok(data)
}
