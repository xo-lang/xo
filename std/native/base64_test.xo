use std/base64

// Differential cases from Go's encoding/base64 (go1.26.1): random bytes,
// random strings over the alphabet, padding, newlines, and noise, and
// valid encodings with a symbol inserted; each with Go's output or
// CorruptInputError offset (-1: no error). Generated by a Go program
// (decision 0279); hex so every byte survives.

fn unhex(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

fn check_encode(enc: base64.Base64, cases: List[(Str, Str)]) {
  for (input, want) in cases {
    expect(encode(unhex(input), enc)) == want
  }
}

fn check_decode(enc: base64.Base64, cases: List[(Str, Str, Int)]) {
  for (input, want, at) in cases {
    let got = decode(unhex(input).to_str() ?? "", enc)
    if at >= 0 {
      expect(got) == Err(base64.DecodeErr{at: at})
    } else {
      expect(got) == Ok(unhex(want))
    }
  }
}

test "go base64 Std encode" {
  check_encode(base64.Base64.Std, [
    ("bd786caadea42983", "vXhsqt6kKYM="),
    ("97d3d0c7957e", "l9PQx5V+"),
    ("", ""),
    ("226bc88096e651", "ImvIgJbmUQ=="),
    ("3b6d7feefde2705bc6ec", "O21/7v3icFvG7A=="),
    ("57e42d", "V+Qt"),
