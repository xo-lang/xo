test "email and malformed name constraints as Go 1.27.4 (GO-2026-4599, GO-2026-4600)" {
  // several email constraints of one kind each count (4599); malformed
  // names fail the check without a fault (4600); a URI with an empty host
  // is named as Go's url.URL.String writes it ("http://" is "http:")
  let r = x509.parse_pem(EM_ROOT.bytes()).ok() ?? []
  var bad: List[Str] = []
  for (name, inter, leaf, want) in EM_CASES {
    let i = x509.parse_pem(inter.bytes()).ok() ?? []
    let got = match x509.parse_pem(leaf.bytes()) {
      Err(e) => "parse error: ${e.display()}"
      Ok(l) => match l[0].verify(x509.VerifyOptions{roots: r, intermediates: i, at: Time.from_unix(1780272000)}) {
        Ok(_) => "ok"
        Err(e) => "error: ${e.display()}"
      }
    }
    if got != want {
      bad.push("${name}: got ${got}")
    }
  }
  expect(bad) == []
}

