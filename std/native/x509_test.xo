test "chains verify as Go 1.27.4: name constraint case and the signature check limit" {
  var bad: List[Str] = []
  for (name, root, inter, leaf, want) in CASES {
    let r = x509.parse_pem(root.bytes()).ok() ?? []
    let i = x509.parse_pem(inter.bytes()).ok() ?? []
    let l = x509.parse_pem(leaf.bytes()).ok() ?? []
    expect(l.len()) == 1
    let got = match l[0].verify(x509.VerifyOptions{roots: r, intermediates: i, at: Time.from_unix(1780272000), key_usages: [x509.ExtKeyUsage.Any]}) {
      Ok(_) => "ok"
      Err(e) => "error: ${e.display()}"
    }
    if got != want {
      bad.push("${name}: got ${got}")
    }
  }
  expect(bad) == []
}

// Certificate.verify_hostname as Go 1.27.4's VerifyHostname, found by the
// decision 0616 x509 review: the host is split once (GO-2026-5037), and a
// certificate with 100 or more names is not listed in the error
// (GO-2025-4155). Certificates and texts from Go 1.27.4.

test "verify_hostname matches and names the certificate as Go 1.27.4" {
  var bad: List[Str] = []
  for (name, pem, host, want) in HOST_CASES {
    let cs = x509.parse_pem(pem.bytes()).ok() ?? []
    expect(cs.len()) == 1
    let got = match cs[0].verify_hostname(host) {
      Ok(_) => "ok"
      Err(e) => "error: ${e.display()}"
    }
    if got != want {
      bad.push("${name} ${host}: got ${got}")
    }
  }
  expect(bad) == []
}

