test "chains verify as Go 1.27.4: name constraint case and the signature check limit" {
  var bad: List[Str] = []
  for (name, root, inter, leaf, want) in CASES {
    let r = x509.parse_pem(root.bytes()).ok() ?? []
    let i = x509.parse_pem(inter.bytes()).ok() ?? []
    let l = x509.parse_pem(leaf.bytes()).ok() ?? []
    expect(l.len()) == 1
    let got = match l[0].verify(x509.VerifyOptions{roots: r, intermediates: i, at: Time.from_unix(1780272000), key_usages: [x509.ExtKeyUsage.Any]}) {
      Ok(_) => "ok"
      Err(e) => "error: ${e.display()}"
    }
    if got != want {
      bad.push("${name}: got ${got}")
    }
  }
  expect(bad) == []
}
