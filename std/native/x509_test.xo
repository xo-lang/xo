test "IP name constraints with host bits are masked, as Go 1.27.4" {
  // hand-made constraint DER (Go's CreateCertificate masks, so its own
  // certificates never carry host bits): unmasked, an excluded
  // 10.0.0.255/24 sorted after 10.0.0.1/32 and 10.0.0.5 was not excluded
  // (H1, H7; go1.26.1 too); the error names the masked network (H2, H3)
  let r = x509.parse_pem(HB_ROOT.bytes()).ok() ?? []
  var bad: List[Str] = []
  for (name, inter, leaf, want) in HB_CASES {
    let i = x509.parse_pem(inter.bytes()).ok() ?? []
    let got = match x509.parse_pem(leaf.bytes()) {
      Err(e) => "parse error: ${e.display()}"
      Ok(l) => match l[0].verify(x509.VerifyOptions{roots: r, intermediates: i, at: Time.from_unix(1780272000)}) {
        Ok(_) => "ok"
        Err(e) => "error: ${e.display()}"
      }
    }
    if got != want {
      bad.push("${name}: got ${got}")
    }
  }
  expect(bad) == []
}

const HB_ROOT: Str = "-----BEGIN CERTIFICATE-----\nMIIBCDCBu6ADAgECAgEBMAUGAytlcDAMMQowCAYDVQQDEwFSMB4XDTIzMTExNDIy\nMTMyMFoXDTMwMDMxNzE3NDY0MFowDDEKMAgGA1UEAxMBUjAqMAUGAytlcAMhAM7M\nFQfcHd1ylZUcKQiI8JWtuQRNG3PWlubfBl1oO9T8o0IwQDAOBgNVHQ8BAf8EBAMC\nAgQwDwYDVR0TAQH/BAUwAwEB/zAdBgNVHQ4EFgQU+k2Gw7VRqmzXw3WdBAwDfvLG\nN58wBQYDK2VwA0EAZdHshbmj1NsoF+up+p07/rRfFA9nGTzpiRmOXpxFu3dAng63\no1uX5SpfMZ6nR3wti/oNw6ibumaYC43mFSUwDg==\n-----END CERTIFICATE-----\n"

