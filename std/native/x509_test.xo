test "pathological intermediate pools stop at the signature check limit (Go's TestPathologicalChains)" {
  // 100 intermediates, each signed by the one before, with the same or
  // different subjects and keys, and no root: every case is Go 1.27.4's
  // errSignatureLimit, quickly (all the same subject and key is the worst
  // case: each appears to have signed every other)
  let now = os.clock.now()
  let shared = crypto.generate_key(os.rand, crypto.KeyAlg.Ed25519).or_fault("key")
  for (same_subject, same_key) in [(false, false), (true, false), (false, true), (true, true)] {
    var inters: List[x509.Certificate] = []
    var parent: x509.Certificate? = None
    var signer = shared
    for i in 0..100 {
      let k = if same_key { shared } else { crypto.generate_key(os.rand, crypto.KeyAlg.Ed25519).or_fault("key") }
      let cn = if same_subject { "Intermediate CA" } else { "Intermediate CA #${i}" }
      let t = x509.Template{subject: x509.Name{common_name: cn}, not_before: now - 1h, not_after: now + 8760h, is_ca: true, key_usage: [x509.KeyUsage.CertSign]}
      let c = match parent {
        Some(p) => x509.create_certificate(os.rand, t, k.public_key(), Some(p), signer).or_fault("inter")
        None => x509.create_certificate(os.rand, t, k.public_key(), None, k).or_fault("inter")
      }
      inters.push(c)
      parent = Some(c)
      signer = k
    }
    let lk = crypto.generate_key(os.rand, crypto.KeyAlg.Ed25519).or_fault("key")
    let lt = x509.Template{subject: x509.Name{common_name: "Leaf"}, not_before: now - 1h, not_after: now + 8760h, ext_key_usage: [x509.ExtKeyUsage.ServerAuth]}
    let leaf = x509.create_certificate(os.rand, lt, lk.public_key(), parent, signer).or_fault("leaf")
    let t0 = os.clock.now()
    let got = match leaf.verify(x509.VerifyOptions{roots: [], intermediates: inters, at: now}) {
      Ok(_) => "ok"
      Err(e) => e.display()
    }
    let ms = (os.clock.now() - t0).millis()
    expect((same_subject, same_key, got)) == (same_subject, same_key, "x509: signature check attempts limit reached while verifying certificate chain")
    expect(ms < 5000) == true
  }
}

test "IP name constraints: host bits masked, IPv4-mapped SANs refused, as Go 1.27.4" {
  // E3 and E4: a SAN of ::ffff:10.0.0.5 matched the host 10.0.0.5 but was
  // checked against the IPv6 constraints, so an excluded 10.0.0.0/8 missed
  // it (Go 1.26.1 too); Go 1.27.4 refuses the address when parsing
  var bad: List[Str] = []
  for (name, root, inter, leaf, host, want) in IP_CASES {
    let r = x509.parse_pem(root.bytes()).ok() ?? []
    let i = x509.parse_pem(inter.bytes()).ok() ?? []
    let got = match x509.parse_pem(leaf.bytes()) {
      Err(e) => "parse error: ${e.display()}"
      Ok(l) => match l[0].verify(x509.VerifyOptions{roots: r, intermediates: i, dns_name: host, at: Time.from_unix(1780272000)}) {
        Ok(_) => "ok"
        Err(e) => "error: ${e.display()}"
      }
    }
    if got != want {
      bad.push("${name}: got ${got}")
    }
  }
  expect(bad) == []
}

