// END GENERATED

const S_BASE: Int = 0xAC00
const L_BASE: Int = 0x1100
const V_BASE: Int = 0x1161
const T_BASE: Int = 0x11A7
const L_COUNT: Int = 19
const V_COUNT: Int = 21
const T_COUNT: Int = 28
const N_COUNT: Int = 588
const S_COUNT: Int = 11172

fn unicode_version() -> Str { UNICODE_VERSION }

/// The index of k in the ascending keys, or -1.
fn find(keys: List[Int], k: Int) -> Int {
  var lo = 0
  var hi = keys.len() - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let v = keys[mid]
    if v == k {
      return mid
    }
    if v < k {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

/// The canonical combining class of r.
fn ccc(r: Int) -> Int {
  if r < 0x300 {
    return 0
  }
  var lo = 0
  var hi = CCC.len() / 3 - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    if r < CCC[3 * mid] {
      hi = mid - 1
    } else if r > CCC[3 * mid + 1] {
      lo = mid + 1
    } else {
      return CCC[3 * mid + 2]
    }
  }
  0
}

/// Appends the (full) decomposition of r to out: NFD, or NFKD when compat.
fn decompose_rune(var out: List[Int], r: Int, compat: Bool) {
  if r < 0xA0 || (!compat && r < 0xC0) {
    out.push(r)
    return
  }
  if r >= S_BASE && r < S_BASE + S_COUNT {
    let si = r - S_BASE
    out.push(L_BASE + si / N_COUNT)
    out.push(V_BASE + (si % N_COUNT) / T_COUNT)
    let t = si % T_COUNT
    if t != 0 {
      out.push(T_BASE + t)
    }
    return
  }
  if compat {
    let i = find(COMPAT_KEYS, r)
    if i >= 0 {
      for k in COMPAT_OFFS[i]..COMPAT_OFFS[i + 1] {
        out.push(COMPAT_RUNES[k])
      }
      return
    }
  }
  let i = find(CANON_KEYS, r)
  if i < 0 {
    out.push(r)
    return
  }
  for k in CANON_OFFS[i]..CANON_OFFS[i + 1] {
    out.push(CANON_RUNES[k])
  }
}

/// Puts the runs of non starters in canonical order (stable by class).
fn reorder(var rs: List[Int]) {
  var i = 0
  let n = rs.len()
  while i < n {
    if ccc(rs[i]) == 0 {
      i += 1
      continue
    }
    var j = i
    while j < n && ccc(rs[j]) != 0 {
      j += 1
    }
    var a = i + 1
    while a < j {
      let x = rs[a]
      let cx = ccc(x)
      var b = a
      while b > i && ccc(rs[b - 1]) > cx {
        rs[b] = rs[b - 1]
        b -= 1
      }
      rs[b] = x
      a += 1
    }
    i = j
  }
}

/// The primary composite of the pair, or -1.
fn compose_pair(a: Int, b: Int) -> Int {
  if a >= L_BASE && a < L_BASE + L_COUNT && b >= V_BASE && b < V_BASE + V_COUNT {
    return S_BASE + ((a - L_BASE) * V_COUNT + (b - V_BASE)) * T_COUNT
  }
  if a >= S_BASE && a < S_BASE + S_COUNT && (a - S_BASE) % T_COUNT == 0 && b > T_BASE && b < T_BASE + T_COUNT {
    return a + (b - T_BASE)
  }
  let i = find(COMP_KEYS, a * 2097152 + b)
  if i < 0 {
    return -1
  }
  COMP_VALS[i]
}

fn compose(rs: List[Int]) -> List[Int] {
  var out: List[Int] = []
  var starter = -1
  var last = -1
  for r in rs {
    if r < 0x300 {
      // a starter that no pair has as its second rune
      starter = out.len()
      last = -1
      out.push(r)
      continue
    }
    let c = ccc(r)
    if starter >= 0 && (last == -1 || last < c) {
      let p = compose_pair(out[starter], r)
      if p >= 0 {
        out[starter] = p
        continue
      }
    }
    if c == 0 {
      starter = out.len()
      last = -1
    } else {
      last = c
    }
    out.push(r)
  }
  out
}

fn is_ascii(s: Str) -> Bool {
  for c in s.bytes() {
    if c >= 0x80 {
      return false
    }
  }
  true
}

/// The normalization of one run of text that starts at a starter.
fn normalize_run(s: Str, compat: Bool, composing: Bool) -> List[Int] {
  var rs: List[Int] = []
  for r in s.runes() {
    decompose_rune(rs, Int(r), compat)
  }
  reorder(rs)
  if composing {
    rs = compose(rs)
  }
  rs
}

/// The runes below lim (0xC0, or 0xA0 for the compatibility forms) are their
/// own normalization and never combine with a rune before them, so text is
/// copied as it is except for each run of runes from lim up, together with
/// the one rune before it (the starter a mark or a jamo may combine with).
fn normalize(s: Str, f: norm.Form) -> Str {
  if is_ascii(s) {
    return s
  }
  let compat = match f {
    Nfkc | Nfkd => true
    _ => false
  }
  let composing = match f {
    Nfc | Nfkc => true
    _ => false
  }
  let lim = if compat { 0xA0 } else { 0xC0 }
  var out = BytesBuilder.with_capacity(s.len() + 16)
  var pos = 0
  var at = 0
  var prev = -1
  var run = -1
  for r in s.runes() {
    let ri = Int(r)
    let w = if ri < 0x80 { 1 } else if ri < 0x800 { 2 } else if ri < 0x10000 { 3 } else { 4 }
    if ri >= lim {
      if run < 0 {
        run = if prev >= pos { prev } else { at }
      }
    } else {
      if run >= 0 {
        out.write_str(s[pos..run])
        for x in normalize_run(s[run..at], compat, composing) {
          out.write_rune(Rune(x))
        }
        pos = at
        run = -1
      }
      prev = at
    }
    at += w
  }
  if run >= 0 {
    out.write_str(s[pos..run])
    for x in normalize_run(s[run..at], compat, composing) {
      out.write_rune(Rune(x))
    }
    pos = at
  }
  out.write_str(s[pos..at])
  out.freeze().to_str() ?? s
}

fn is_normalized(s: Str, f: norm.Form) -> Bool {
  normalize(s, f) == s
}
