// std/xmlcodec on every backend (decisions 0315, 0312): the helpers of
// the code `derive Xml` generates, following Go's encoding/xml marshal.go
// (printer parent stack, marshalSimple) and read.go (unmarshal's
// character data, copyValue; go1.26.1).
use std/xml
use std/xmlcodec

fn fail(msg: Str) -> xml.XmlErr { xml.XmlErr{line: 0, msg: msg} }

fn nm(local: Str) -> xml.Name { xml.Name{space: "", local: local} }

fn open_path(parents: List[Str]) -> xmlcodec.Piece { xmlcodec.Piece{parents: parents, kind: 0} }

fn leaf(parents: List[Str], name: Str, text: Str) -> xmlcodec.Piece {
  xmlcodec.Piece{parents: parents, kind: 1, name: name, text: xml.escape(text)}
}

fn child(parents: List[Str], name: Str, el: xml.Element) -> xmlcodec.Piece {
  xmlcodec.Piece{parents: parents, kind: 2, name: name, el: Some(el)}
}

fn chardata(text: Str) -> xmlcodec.Piece { xmlcodec.Piece{parents: [], kind: 3, text: xml.escape(text)} }

fn comment(text: Str) -> xmlcodec.Piece { xmlcodec.Piece{parents: [], kind: 4, text: text} }

fn attr(name: Str, value: Str) -> xml.Attr { xml.Attr{name: nm(name), value: value} }

/// Closes the innermost open parent into the frame below it.
fn close_top(var names: List[Str], var kids: List[List[xml.Node]]) {
  let top = kids.pop() ?? []
  let n = names.pop() ?? ""
  let e = xml.Element{name: nm(n), attrs: [], children: top}
  let last = kids.len() - 1
  kids[last].push(xml.Node.Elem(e))
}

fn build(name: Str, attrs: List[xml.Attr], pieces: List[xmlcodec.Piece]) -> xml.Element {
  var names: List[Str] = []
  var kids: List[List[xml.Node]] = [[]]
  for p in pieces {
    if p.kind == 3 {
      let last = kids.len() - 1
      kids[last].push(xml.Node.Raw(p.text))
      continue
    }
    if p.kind == 4 {
      let last = kids.len() - 1
      kids[last].push(xml.Node.Comment(p.text))
      continue
    }
    var keep = 0
    while keep < p.parents.len() && keep < names.len() && p.parents[keep] == names[keep] {
      keep += 1
    }
    while names.len() > keep {
      close_top(names, kids)
    }
    for i in keep..p.parents.len() {
      names.push(p.parents[i])
      kids.push([])
    }
    let last = kids.len() - 1
    if p.kind == 1 {
      kids[last].push(xml.Node.Elem(xml.Element{name: nm(p.name), attrs: [], children: [xml.Node.Raw(p.text)]}))
    } else if p.kind == 2 {
      if let Some(e) = p.el {
        kids[last].push(xml.Node.Elem(xml.Element{name: nm(p.name), attrs: e.attrs, children: e.children}))
      }
    }
  }
  while names.len() > 0 {
    close_top(names, kids)
  }
  xml.Element{name: nm(name), attrs: attrs, children: kids[0]}
}

fn parse_root(text: Str) -> xml.Element ! xml.XmlErr {
  match xml.parse(text) {
    Ok(e) => e
    Err(x) => if x.msg == "xml: no root element" { Err(fail("EOF")) } else { Err(x) }
  }
}

fn attr_of(e: xml.Element, name: Str) -> Str? {
  for a in e.attrs {
    if a.name.local == name {
      return Some(a.value)
    }
  }
  None
}

fn events(e: xml.Element, paths: List[List[Str]]) -> List[xmlcodec.Event] {
  var out: List[xmlcodec.Event] = []
  walk(e, [], paths, out)
  out
}

/// The elements below el, in document order, whose path from the struct's
/// element is one of paths (Go reads the document once, in order).
fn walk(el: xml.Element, prefix: List[Str], paths: List[List[Str]], var out: List[xmlcodec.Event]) {
  for n in el.children {
    match n {
      Elem(c) => {
        let here = prefix + [c.name.local]
        var deeper = false
        for (i, p) in paths.indexed() {
          if p == here {
            out.push(xmlcodec.Event{field: i, el: c})
          } else if p.len() > here.len() && p[0..here.len()] == here {
            deeper = true
          }
        }
        if deeper {
          walk(c, here, paths, out)
        }
      }
      Text(..) | Raw(..) | Comment(..) | ProcInst(..) | Directive(..) => {}
    }
  }
}

fn direct_text(e: xml.Element) -> Str {
  var b = StrBuilder.new()
  for n in e.children {
    match n {
      Text(s) => b.write(s)
      Elem(..) | Raw(..) | Comment(..) | ProcInst(..) | Directive(..) => {}
    }
  }
  b.freeze()
}

fn float_text(f: Float) -> Str {
  let s = "${f}"
  if s.ends_with(".0") { s[0..s.len() - 2] } else { s }
}

fn digits_only(s: Str) -> Bool {
  var body = s
  if body.starts_with("-") || body.starts_with("+") {
    body = body[1..]
  }
  if body.is_empty() {
    return false
  }
  for r in body.runes() {
    if r < '0' || r > '9' {
      return false
    }
  }
  true
}

fn int_of(s0: Str) -> Int ! xml.XmlErr {
  let s = s0.trim()
  if s.is_empty() {
    return 0
  }
  match Int.parse(s) {
    Some(n) => n
    None => {
      let why = if digits_only(s) { "value out of range" } else { "invalid syntax" }
      Err(fail("strconv.ParseInt: parsing ${s.quote()}: ${why}"))
    }
  }
}

/// The byte of b at i as an Int, -1 past the end.
fn code_at(b: Bytes, i: Int) -> Int {
  if i < b.len() {
    Int(b[i])
  } else {
    -1
  }
}

/// code_at lowercased when it is an ASCII letter (Go's lower).
fn lower_code_at(b: Bytes, i: Int) -> Int {
  let c = code_at(b, i)
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

/// Whether the bytes of b from i are exactly the letters of w, case
/// ignored, with nothing after them.
fn word_at_end(b: Bytes, i: Int, w: Bytes) -> Bool {
  if i + w.len() != b.len() {
    return false
  }
  var k = 0
  while k < w.len() {
    if lower_code_at(b, i + k) != Int(w[k]) {
      return false
    }
    k += 1
  }
  true
}

/// strconv.underscoreOK on the first n bytes of b: every underscore
/// between digits, and a 0x prefix counts as a digit.
fn underscore_ok(b: Bytes, n: Int) -> Bool {
  var i = 0
  // saw: 0 the start, 1 a digit or base prefix, 2 an underscore, 3 other
  var saw = 0
  if n >= 1 && (Int(b[0]) == 45 || Int(b[0]) == 43) {
    i = 1
  }
  var hex = false
  if n - i >= 2 && Int(b[i]) == 48 && lower_code_at(b, i + 1) == 120 {
    i += 2
    saw = 1
    hex = true
  }
  while i < n {
    let c = lower_code_at(b, i)
    if (c >= 48 && c <= 57) || (hex && c >= 97 && c <= 102) {
      saw = 1
    } else if c == 95 {
      if saw != 1 {
        return false
      }
      saw = 2
    } else {
      if saw == 2 {
        return false
      }
      saw = 3
    }
    i += 1
  }
  saw != 2
}

/// Whether s is a Float text Go's strconv.ParseFloat accepts on its way to
/// a value: atof.go's special words, its decimal and hexadecimal forms,
/// and its underscore rule. The value is not computed, so a text that
/// overflows (which Float.parse answers None for, as it does a syntax
/// error) is told from one that is malformed.
fn float_syntax(s: Str) -> Bool {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  var signed = false
  if code_at(b, 0) == 43 || code_at(b, 0) == 45 {
    signed = true
    i = 1
  }
  // inf and infinity take a sign; nan does not (special)
  let c = lower_code_at(b, i)
  if c == 105 {
    return word_at_end(b, i, b"inf") || word_at_end(b, i, b"infinity")
  }
  if c == 110 && !signed {
    return word_at_end(b, i, b"nan")
  }
  var hex = false
  if code_at(b, i) == 48 && lower_code_at(b, i + 1) == 120 {
    hex = true
    i += 2
  }
  // the mantissa: digits, one point, underscores between digits
  var digits = false
  var dot = false
  var underscores = false
  while i < n {
    let d = lower_code_at(b, i)
    if (d >= 48 && d <= 57) || (hex && d >= 97 && d <= 102) {
      digits = true
    } else if d == 46 {
      if dot {
        break
      }
      dot = true
    } else if d == 95 {
      underscores = true
    } else {
      break
    }
    i += 1
  }
  if !digits {
    return false
  }
  // the exponent: p for a hex float (required), e for a decimal one
  var exp = false
  if hex {
    if lower_code_at(b, i) != 112 {
      return false
    }
    exp = true
    i += 1
  } else if lower_code_at(b, i) == 101 {
    exp = true
    i += 1
  }
  if exp {
    if code_at(b, i) == 43 || code_at(b, i) == 45 {
      i += 1
    }
    var exp_digits = false
    while i < n {
      let d = lower_code_at(b, i)
      if d >= 48 && d <= 57 {
        exp_digits = true
      } else if d == 95 {
        underscores = true
      } else {
        return false
      }
      i += 1
    }
    if !exp_digits {
      return false
    }
  }
  i == n && (!underscores || underscore_ok(b, i))
}

fn float_of(s0: Str) -> Float ! xml.XmlErr {
  let s = s0.trim()
  if s.is_empty() {
    return 0.0
  }
  match Float.parse(s) {
    Some(f) => f
    None => {
      let why = if float_syntax(s) { "value out of range" } else { "invalid syntax" }
      Err(fail("strconv.ParseFloat: parsing ${s.quote()}: ${why}"))
    }
  }
}

fn bool_of(s0: Str) -> Bool ! xml.XmlErr {
  let s = s0.trim()
  if s.is_empty() {
    return false
  }
  match s {
    "1" | "t" | "T" | "TRUE" | "true" | "True" => true
    "0" | "f" | "F" | "FALSE" | "false" | "False" => false
    _ => Err(fail("strconv.ParseBool: parsing ${s.quote()}: invalid syntax"))
  }
}
