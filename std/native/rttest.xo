// Intrinsics of the test world of native test binaries (decision 0083),
// implemented in std/llrt/xo_testing.c; imported by std/native/testing.xo,
// log.xo, http.xo, and llrt/report.xo as `use native/rttest`.
use native/rt

// The report of a property test's case (std/native/llrt/report.xo,
// decision 0193 step 5).

/// The choices the generator g made so far (UInt64s), in order.
fn gen_choices(g: Int) -> List[Int]
/// Writes s on the real standard output (the harness reads it; the
/// program's own output is captured).
fn test_write(s: Str)
/// $XO_PROP_BEST (the best choices so far while shrinking) in a list of
/// one, or the empty list.
fn prop_best() -> List[Str]
/// Ends the test binary with the status code at once.
fn test_quit(code: Int)
/// report.xo's prop_report as the runtime call the SSA builder makes
/// without the native prelude (decision 0198 deleted the C, so no native
/// runtime has it).
fn prop_report(g: Int, input: Str)

// The generator's draws (std/native/llrt/gen.xo, decision 0195): the
// state, the record, and the replay are C.

/// A choice in 0..n (any UInt64 when n is 0), recorded (gen_draw).
fn gen_draw(g: Int, n: Int) -> Int
/// A choice in 0..n, none when n <= 1 (GenRand.Intn).
fn gen_intn(g: Int, n: Int) -> Int
/// The nesting depth of the value being generated.
fn gen_depth(g: Int) -> Int
/// gen.xo's values as the runtime calls the SSA builder makes without the
/// native prelude (decision 0198 deleted the C, so no native runtime has
/// them).
fn gen_size(g: Int) -> Int
fn gen_any_int(g: Int) -> Int
fn gen_sized(g: Int, kind: Int) -> Int
fn gen_float(g: Int) -> Float
fn gen_rune(g: Int) -> Int
fn gen_str(g: Int) -> Str
fn gen_duration(g: Int) -> Int
fn gen_time(g: Int) -> Int

/// The program runs in the test world (a test binary).
fn test_on() -> Bool

/// The effect `real` (xo_testing.c's TW_REAL_*: 4 net, 16 env) is a fake
/// in this test: not declared with `uses` and run with `xo test --real`
/// (decision 0120).
fn test_fake(real: Int) -> Bool

/// Keeps a log record for testing.logs() and echoes its text line (not
/// when line is empty).
fn test_log(level: Int, msg: Str, module: Str, keys: List[Str], vals: List[Str], line: Str)
fn test_log_count() -> Int
fn test_log_level(i: Int) -> Int
fn test_log_msg(i: Int) -> Str
/// The dependency that wrote record i (decision 0173), "" for the main
/// module.
fn test_log_module(i: Int) -> Str
fn test_log_nfields(i: Int) -> Int
fn test_log_key(i: Int, j: Int) -> Str
fn test_log_val(i: Int, j: Int) -> Str

/// l is an in memory listener (FakeNet.listen).
fn test_mem_listener(l: Listener) -> Bool
/// Serves l with the router r (an Any of http.Router).
fn test_mem_serve(l: Listener, r: rt.Any)
fn test_mem_unserve(l: Listener)
/// Waits until no request runs on l.
fn test_mem_drain(l: Listener)
/// Starts a request to host:port: the router serving it, or none.
fn test_mem_begin(hostport: Str) -> List[rt.Any]
fn test_mem_end(hostport: Str)

/// FakeNet.handle: method ("" any), URL prefix ("" any), path pattern,
/// handler (an Any of fn(http.Request) -> http.Response).
fn test_fake_handle(method: Str, prefix: Str, path: Str, h: rt.Any)
/// FakeNet.fail and fail_next (once) with the error (an Any of
/// http.ClientErr).
fn test_fake_fail(method: Str, prefix: Str, path: Str, err: rt.Any, once: Bool)
fn test_fake_clear()
/// The number of handlers (kind 0) or failures (1).
fn test_fake_count(kind: Int) -> Int
/// The method (what 0), prefix (1), or path pattern (2) of entry i.
fn test_fake_text(kind: Int, i: Int, what: Int) -> Str
/// The handler or the error of entry i.
fn test_fake_value(kind: Int, i: Int) -> rt.Any
/// Failure i matched (one of fail_next goes).
fn test_fake_used(i: Int)
/// Keeps a request (an Any of http.Request) for FakeNet.requests().
fn test_record(req: rt.Any)
fn test_req_count() -> Int
fn test_req_get(i: Int) -> rt.Any

/// MemFs (decision 0108): the file system's state, an Any of
/// testing.MemState, in a list of one (empty before the first write).
/// The store stays locked until test_memfs_put gives the state back.
fn test_memfs_take() -> List[rt.Any]
fn test_memfs_put(st: rt.Any)
/// The test world's virtual now.
fn test_now() -> Time
