// std/base32 on the native backends (decision 0279): Go's
// encoding/base32 ported from base32.go of go1.26 (Encode, and
// DecodeString: newlines stripped, then decode), with the same output
// and error offsets. Go returns the bytes decoded before an error; Xo
// returns the error alone.
use std/base32

const STD: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
const HEX: Str = "0123456789ABCDEFGHIJKLMNOPQRSTUV"

fn decodeerr_display(e: base32.DecodeErr) -> Str { "illegal base32 data at input byte ${e.at}" }

fn alphabet(enc: base32.Base32) -> Bytes {
  match enc {
    Std => STD.bytes()
    RawStd => STD.bytes()
    Hex => HEX.bytes()
    RawHex => HEX.bytes()
  }
}

fn padded(enc: base32.Base32) -> Bool { enc is Std | Hex }

/// The value of each byte in the alphabet, or 255 (also for `=`).
const DEC_STD: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x1a\x1b\x1c\x1d\x1e\x1f\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"
const DEC_HEX: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\xff\xff\xff\xff\xff\xff\xff\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

fn encode(data: Bytes, enc: base32.Base32 = base32.Base32.Std) -> Str {
  let a = alphabet(enc)
  var out = BytesBuilder.with_capacity((data.len() + 4) / 5 * 8)
  // whole five byte blocks: one 40 bit word, eight symbols, no per byte
  // test (Go's Encode loop; 2026-10-26: the block loop below ran encode at
  // 2.1x Go's time)
  let n = data.len()
  let full = n - n % 5
  var si = 0
  while si < full {
    let v = (Int(data[si]) << 32) | (Int(data[si + 1]) << 24) | (Int(data[si + 2]) << 16) | (Int(data[si + 3]) << 8) | Int(data[si + 4])
    out.write_byte(a[(v >> 35) & 31])
    out.write_byte(a[(v >> 30) & 31])
    out.write_byte(a[(v >> 25) & 31])
    out.write_byte(a[(v >> 20) & 31])
    out.write_byte(a[(v >> 15) & 31])
    out.write_byte(a[(v >> 10) & 31])
    out.write_byte(a[(v >> 5) & 31])
    out.write_byte(a[v & 31])
    si += 5
  }
  // the last, partial block
  while si < data.len() {
    let remain = (data.len() - si).min(5)
    // the block's 40 bits, zero filled past the data
    var v = 0
    for k in 0..5 {
      v = (v << 8) | (if k < remain { Int(data[si + k]) } else { 0 })
    }
    // symbols carrying data: 2, 4, 5, 7, 8 for 1 to 5 bytes
    let syms = (remain * 8 + 4) / 5
    for k in 0..syms {
      out.write_byte(a[(v >> (35 - 5 * k)) & 31])
    }
    if padded(enc) {
      for _ in syms..8 { out.write_byte(61) }
    }
    si += 5
  }
  out.freeze().to_str() ?? ""
}

fn decode(s: Str, enc: base32.Base32 = base32.Base32.Std) -> Bytes ! base32.DecodeErr {
  var stripped = BytesBuilder.with_capacity(s.len())
  for c in s.bytes() {
    if c != 10 && c != 13 { stripped.write_byte(c) }
  }
  let src = stripped.freeze()
  let tbl = if enc is Hex | RawHex { DEC_HEX } else { DEC_STD }
  let pad = padded(enc)
  let olen = src.len()
  var out = BytesBuilder.with_capacity(olen / 8 * 5 + 5)
  var at = 0
  var end = false
  while at < olen && !end {
    // eight plain symbols, the usual case
    if at + 8 <= olen {
      var acc = 0
      var bad = 0
      for k in 0..8 {
        let v = Int(tbl[Int(src[at + k])])
        bad = bad | v
        acc = (acc << 5) | (v & 31)
      }
      if bad < 32 {
        out.write_byte(UInt8(acc >> 32))
        out.write_byte(UInt8((acc >> 24) & 255))
        out.write_byte(UInt8((acc >> 16) & 255))
        out.write_byte(UInt8((acc >> 8) & 255))
        out.write_byte(UInt8(acc & 255))
        at += 8
        continue
      }
    }
    // the j symbols read, 5 bits each, in acc
    var acc = 0
    var dlen = 8
    var j = 0
    while j < 8 {
      if at == olen {
        if pad {
          return Err(base32.DecodeErr{at: olen - (olen - at) - j})
        }
        dlen = j
        end = true
        break
      }
      let c = src[at]
      at += 1
      let rest = olen - at
      if pad && c == 61 && j >= 2 && rest < 8 {
        if rest + j < 7 {
          return Err(base32.DecodeErr{at: olen})
        }
        for k in 0..7 - j {
          if rest > k && src[at + k] != 61 {
            return Err(base32.DecodeErr{at: olen - rest + k - 1})
          }
        }
        dlen = j
        end = true
        if dlen == 1 || dlen == 3 || dlen == 6 {
          return Err(base32.DecodeErr{at: olen - rest - 1})
        }
        break
      }
      let v = Int(tbl[Int(c)])
      if v == 255 {
        return Err(base32.DecodeErr{at: olen - rest - 1})
      }
      acc = (acc << 5) | v
      j += 1
    }
    // Go's switch on dlen: 8, 7, 5, 4, 2 symbols give 5, 4, 3, 2, 1
    // bytes; 1, 3, and 6 (only at the end of a Raw input) give none; the
    // missing symbols are zero bits
    let count = match dlen {
      8 => 5
      7 => 4
      5 => 3
      4 => 2
      2 => 1
      _ => 0
    }
    let val = acc << (5 * (8 - j))
    for k in 0..count {
      out.write_byte(UInt8((val >> (32 - 8 * k)) & 255))
    }
  }
  out.freeze()
}
