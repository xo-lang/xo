test "Go's regexp on re2-search.txt: compile errors, match index, captures" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (pat, text, want) in GO_CASES {
    let got = match regexp.compile(pat) {
      Err(e) => "err ${e.msg}"
      Ok(re) => match re.find_index(text) {
        None => "none"
        Some((a, b)) => {
          var parts = ["${a}-${b}"]
          let caps = re.captures(text) ?? []
          for (k, c) in caps.indexed() {
            if k > 0 {
              parts.push(match c {
                Some(x) => x.quote()
                None => "nil"
              })
            }
          }
          parts.join(" ")
        }
      }
    }
    // a Unicode class native builds do not have yet (decision 0172) is
    // a known gap, counted apart
    if got != want && !got.contains("not supported by native builds yet") {
      bad.push((pat, text, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}
