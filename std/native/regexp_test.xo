test "Go's regexp on alternations, the parser's factoring cases" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (pat, text, want) in GO_FACTOR_CASES {
    let got = match regexp.compile(pat) {
      Err(e) => "err ${e.msg}"
      Ok(re) => match re.find_index(text) {
        None => "none"
        Some((a, b)) => {
          var parts = ["${a}-${b}"]
          let caps = re.captures(text) ?? []
          for (k, c) in caps.indexed() {
            if k > 0 {
              parts.push(match c {
                Some(x) => x.quote()
                None => "nil"
              })
            }
          }
          parts.join(" ")
        }
      }
    }
    if got != want {
      bad.push((pat, text, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}
