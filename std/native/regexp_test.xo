  ("^(?:[a-z]+\\.)*[a-z]+\$", "ſ", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "ß", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "STRASSE", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "straße", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "héllo", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "éééx", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "éx", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "ex", "0-2"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "αβγ", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "αβγa", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "🙂", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "𐀀􏿿", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "foo bar", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "foo", "0-3"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "foobar", "0-6"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "12.5", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "12.", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", ".5", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "z", "0-1"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "xy", "0-2"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "xyz", "0-3"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "x", "0-1"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "a.b.c", "0-5"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "a..b", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "a.", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "ab\nc", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "\n", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "abÿ", "none"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "abcabc", "0-6"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "aaaa", "0-4"),
  ("^(?:[a-z]+\\.)*[a-z]+\$", "abab", "0-4"),
]

test "Go's regexp on anchored patterns, the one-pass matcher's cases" {
  var bad: List[(Str, Str, Str, Str)] = []
  for (pat, text, want) in GO_ONEPASS_CASES {
    let got = match regexp.compile(pat) {
      Err(e) => "err ${e.msg}"
      Ok(re) => match re.find_index(text) {
        None => "none"
        Some((a, b)) => {
          var parts = ["${a}-${b}"]
          let caps = re.captures(text) ?? []
          for (k, c) in caps.indexed() {
            if k > 0 {
              parts.push(match c {
                Some(x) => x.quote()
                None => "nil"
              })
            }
          }
          parts.join(" ")
        }
      }
    }
    if got != want {
      bad.push((pat, text, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 25 { bad.len() } else { 25 })]) == []
}
