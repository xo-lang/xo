use std/amqp

fn hb(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

fn dec(s: Str) -> amqp.Value { amqp.decode(hb(s)).or_fault("decode").0 }

test "constructors go-amqp's encoder never writes decode" {
  // list8, map8, array8 of ubyte, the zero value forms, small signed forms
  expect(dec("c003015207")) == amqp.Value.List(items: [amqp.Value.UInt(v: UInt32(7))])
  expect(dec("c1030243" + "44")) == amqp.Value.Map(pairs: [(amqp.Value.UInt(v: UInt32(0)), amqp.Value.ULong(v: UInt64(0)))])
  expect(dec("e004" + "02" + "50" + "0102")) == amqp.Value.Array(items: [amqp.Value.UByte(v: UInt8(1)), amqp.Value.UByte(v: UInt8(2))])
  expect(dec("45")) == amqp.Value.List(items: [])
  expect(dec("5401")) == amqp.Value.Int(v: Int32(1))
  expect(dec("55ff")) == amqp.Value.Long(v: Int64(-1))
  expect(dec("7000000100")) == amqp.Value.UInt(v: UInt32(256))
  expect(dec("a000")) == amqp.Value.Binary(v: b"")
}

test "decimals, chars and described values (which go-amqp's ReadAny refuses)" {
  expect(dec("7400000001")) == amqp.Value.Decimal32(bits: UInt32(1))
  expect(dec("840000000000000002")) == amqp.Value.Decimal64(bits: UInt64(2))
  expect(dec("94000102030405060708090a0b0c0d0e0f")) == amqp.Value.Decimal128(bits: hb("000102030405060708090a0b0c0d0e0f"))
  expect(dec("73000000e9")) == amqp.Value.Char(v: 'é')
  expect(dec("005377a10161")) == amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64(119)), value: amqp.Value.Str(v: "a"))
  let d = amqp.Value.Described(descriptor: amqp.Value.Symbol(v: "x"), value: amqp.Value.List(items: [amqp.Value.Bool(v: true)]))
  expect(amqp.decode(amqp.encode(d).or_fault("enc")).or_fault("dec").0) == d
}

test "bad input is an error, never a fault" {
  for s in [
    "",
    "ff",                      // unknown constructor
    "a105",                    // string longer than the data
    "a1c3",                    // not UTF-8 (and short)
    "a102c328",                // invalid UTF-8
    "c101" + "0143",           // odd map count
    "c002" + "05" + "52",      // count above the data
    "c0020352",                // size past the data
    "d000000001" + "00000000", // list32 size below its count field
    "e0020150",                // array with no element for its count
    "5600",                    // ok boolean: control (decoded below)
    "5602",                    // invalid boolean
  ] {
    let r = amqp.decode(hb(s))
    if s == "5600" {
      expect(r.is_err()) == false
    } else {
      expect(r.is_err()) == true
    }
  }
}

test "nesting is bounded" {
  var s = ""
  for _ in 0..100 {
    s += "c00101"
  }
  expect(amqp.decode(hb(s + "40")).is_err()) == true
}

test "values that cannot be encoded" {
  expect(amqp.encode(amqp.Value.Array(items: [])).is_err()) == true
  expect(amqp.encode(amqp.Value.Array(items: [amqp.Value.UByte(v: UInt8(1)), amqp.Value.UShort(v: UInt16(1))])).is_err()) == true
  expect(amqp.encode(amqp.Value.Array(items: [amqp.Value.Null])).is_err()) == true
  expect(amqp.encode(amqp.Value.Uuid(bytes: b"short")).is_err()) == true
  expect(amqp.encode(amqp.Value.Decimal128(bits: b"short")).is_err()) == true
}

test "a ubyte array and the decimals round trip" {
  for v in [
    amqp.Value.Array(items: [amqp.Value.UByte(v: UInt8(1)), amqp.Value.UByte(v: UInt8(255))]),
    amqp.Value.Decimal32(bits: UInt32(7)),
    amqp.Value.Decimal64(bits: UInt64(7)),
    amqp.Value.Char(v: '世'),
    amqp.Value.Array(items: [amqp.Value.Char(v: 'a'), amqp.Value.Char(v: 'b')]),
    amqp.Value.Array(items: [amqp.Value.Decimal32(bits: UInt32(1))]),
  ] {
    let (back, n) = amqp.decode(amqp.encode(v).or_fault("enc")).or_fault("dec")
    expect(back) == v
    expect(n) == amqp.encode(v).or_fault("enc").len()
  }
}

fn rt(f: amqp.Frame) -> amqp.Frame {
  let b = amqp.encode_frame(f).or_fault("encode")
  let (g, n) = amqp.decode_frame(b).or_fault("decode")
  expect(n) == b.len()
  expect(amqp.encode_frame(g).or_fault("again")) == b
  g
}

test "frame headers and the smallest performatives" {
  expect(amqp.encode_frame(amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Empty}).or_fault("e")) == hb("0000000802000000")
  expect(amqp.encode_frame(amqp.Frame{channel: UInt16(3), body: amqp.FrameBody.Close(v: amqp.Close{error: None})}).or_fault("e")) == hb("0000000c02000003005318" + "45")
  expect(amqp.encode_frame(amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Open(v: amqp.Open{container_id: "c"})}).or_fault("e")) == hb("0000001702000000005310d00000000700000001a10163")
}

test "every performative round trips" {
  let st = amqp.DeliveryState.Rejected(error: Some(amqp.WireError{condition: "amqp:decode-error", description: "bad", info: [("k", amqp.Value.Bool(v: true))]}))
  let bodies: List[amqp.FrameBody] = [
    amqp.FrameBody.Open(v: amqp.Open{container_id: "id", hostname: "h", max_frame_size: 65536, channel_max: 255, idle_timeout_ms: 30000, outgoing_locales: ["en", "fr"], offered_capabilities: ["x"], properties: [("p", amqp.Value.Str(v: "v"))]}),
    amqp.FrameBody.Begin(v: amqp.Begin{remote_channel: Some(UInt16(2)), next_outgoing_id: UInt32(1), incoming_window: UInt32(2048), outgoing_window: UInt32(2048), handle_max: 10}),
    amqp.FrameBody.Attach(v: amqp.Attach{name: "l", handle: UInt32(0), role: amqp.Role.Sender, sender_settle_mode: Some(amqp.SenderSettleMode.Mixed), receiver_settle_mode: Some(amqp.ReceiverSettleMode.Second), source: Some(amqp.Source{address: "a", durable: 2, filter: [("f", amqp.Value.Str(v: "x"))], outcomes: ["amqp:accepted:list", "amqp:rejected:list"]}), target: Some(amqp.Target{address: "t", dynamic: true}), unsettled: [(b"t1", Some(amqp.DeliveryState.Accepted)), (b"t2", None)], initial_delivery_count: 5, max_message_size: 1000}),
    amqp.FrameBody.Attach(v: amqp.Attach{name: "r", handle: UInt32(1), role: amqp.Role.Receiver, sender_settle_mode: None, receiver_settle_mode: None, source: None, target: None}),
    amqp.FrameBody.Flow(v: amqp.Flow{next_incoming_id: Some(UInt32(1)), incoming_window: UInt32(100), next_outgoing_id: UInt32(7), outgoing_window: UInt32(100), handle: Some(UInt32(0)), delivery_count: Some(UInt32(3)), link_credit: Some(UInt32(50)), available: None, drain: true, echo: true}),
    amqp.FrameBody.Transfer(v: amqp.Transfer{handle: UInt32(0), delivery_id: Some(UInt32(4)), delivery_tag: b"tag", message_format: Some(UInt32(0)), settled: false, more: true, receiver_settle_mode: Some(amqp.ReceiverSettleMode.First), state: Some(amqp.DeliveryState.Received(section_number: UInt32(1), section_offset: UInt64(9))), payload: hb("0053777b")}),
    amqp.FrameBody.Disposition(v: amqp.Disposition{role: amqp.Role.Receiver, first: UInt32(1), last: Some(UInt32(3)), settled: true, state: Some(amqp.DeliveryState.Modified(delivery_failed: true, undeliverable_here: false, annotations: [(amqp.Value.Symbol(v: "a"), amqp.Value.Bool(v: true))]))}),
    amqp.FrameBody.Disposition(v: amqp.Disposition{role: amqp.Role.Sender, first: UInt32(0), last: None, settled: false, state: Some(st)}),
    amqp.FrameBody.Detach(v: amqp.Detach{handle: UInt32(1), closed: true, error: Some(amqp.WireError{condition: "amqp:link:detach-forced"})}),
    amqp.FrameBody.End(v: amqp.End{error: None}),
    amqp.FrameBody.Close(v: amqp.Close{error: Some(amqp.WireError{condition: "amqp:internal-error", description: "x"})}),
    amqp.FrameBody.SaslMechanisms(v: amqp.SaslMechanisms{mechanisms: ["PLAIN", "ANONYMOUS"]}),
    amqp.FrameBody.SaslInit(v: amqp.SaslInit{mechanism: "PLAIN", initial_response: hb("00757000"), hostname: "h"}),
    amqp.FrameBody.SaslChallenge(v: amqp.SaslChallenge{challenge: b"c"}),
    amqp.FrameBody.SaslResponse(v: amqp.SaslResponse{response: b"r"}),
    amqp.FrameBody.SaslOutcome(v: amqp.SaslOutcome{code: UInt8(0), additional_data: b"ok"}),
    amqp.FrameBody.Empty,
  ]
  for body in bodies {
    let f = amqp.Frame{channel: UInt16(1), body: body}
    expect(rt(f)) == f
  }
}

test "a bad frame is refused" {
  expect(amqp.decode_frame(hb("00000008")).is_err()) == true
  expect(amqp.decode_frame(hb("0000000802010000")).is_err()) == true
  expect(amqp.decode_frame(hb("0000000802020000")).is_err()) == true
  expect(amqp.decode_frame(hb("0000000402000000")).is_err()) == true
  expect(amqp.decode_frame(hb("0000000c02000000005318"), 8).is_err()) == true
  expect(amqp.decode_frame(hb("0000001002000000005310" + "45" + "0000")).is_err()) == true
}

test "an Int field outside its wire range is refused on encode" {
  let f = amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Open(v: amqp.Open{container_id: "c", channel_max: 70000})}
  expect(amqp.encode_frame(f).is_err()) == true
  let g = amqp.Frame{channel: UInt16(0), body: amqp.FrameBody.Begin(v: amqp.Begin{remote_channel: None, next_outgoing_id: UInt32(0), incoming_window: UInt32(0), outgoing_window: UInt32(0), handle_max: -1})}
  expect(amqp.encode_frame(g).is_err()) == true
}
