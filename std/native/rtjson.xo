// JSON intrinsics of the native backends (decision 0074), like
// native/rt.xo: imported only by the implementation modules as
// `use native/rtjson`. json_enc and json_dec are lowered by internal/ssa
// to codecs it generates per type (build_json.go). The parser, the tape
// readers, and the string and Float text are written in Xo
// (std/native/llrt/jsontext.xo, decision 0193 step 4); decision 0198
// deleted their C path (std/llrt/xo_json.c, XO_LLRT_C=jsontext).
use std/json

/// acc + the JSON text of v.
fn json_enc[T](acc: Str, v: T) -> Str
/// The value of the tape node at i; the error's path is relative to it.
fn json_dec[T](src: Bytes, tape: List[Int], i: Int) -> T ! json.DecodeErr
