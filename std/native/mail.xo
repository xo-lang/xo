// std/mail on the native backends (decision 0282): Go's net/mail address
// parser (message.go of go1.26: addrParser, Address.String), with mime's
// RFC 2047 encoded words (encodedword.go: WordDecoder for utf-8,
// iso-8859-1, and us-ascii; the B and Q WordEncoders) and net/netip's
// address syntax for domain literals, ported with the same results and
// error texts.
use std/crypto
use std/mail

fn mailerr_display(e: mail.MailErr) -> Str { e.msg }

fn fail(msg: Str) -> mail.MailErr { mail.MailErr{msg: msg} }

const UPPER_HEX: Str = "0123456789ABCDEF"

// ---------------------------------------------------------------------------
// Character classes (message.go isAtext, isQtext, isVchar, isWSP, isDtext)

fn is_vchar(r: Rune) -> Bool { (r >= '!' && r <= '~') || Int(r) >= 128 }

fn is_wsp(r: Rune) -> Bool { r == ' ' || r == '\t' }

fn is_atext(r: Rune, dot: Bool) -> Bool {
  if r == '.' {
    return dot
  }
  if r == '(' || r == ')' || r == '<' || r == '>' || r == '[' || r == ']' || r == ':' || r == ';' || r == '@' || r == '\\' || r == ',' || r == '"' {
    return false
  }
  is_vchar(r)
}

fn is_qtext(r: Rune) -> Bool { r != '\\' && r != '"' && is_vchar(r) }

fn is_dtext(r: Rune) -> Bool { r != '[' && r != ']' && r != '\\' && is_vchar(r) }

// ---------------------------------------------------------------------------
// RFC 2047 encoded words (mime/encodedword.go)

fn hex_of(c: UInt8) -> Int {
  if c >= 48 && c <= 57 { return Int(c) - 48 }
  if c >= 65 && c <= 70 { return Int(c) - 55 }
  if c >= 97 && c <= 102 { return Int(c) - 87 }
  -1
}

/// Go's %#02x of a byte: 0x and lower case hex, no padding.
fn hex_byte(c: UInt8) -> Str {
  let h = "0123456789abcdef"
  let v = Int(c)
  if v < 16 {
    return "0x" + h[v..v + 1]
  }
  "0x" + h[v >> 4..(v >> 4) + 1] + h[v & 15..(v & 15) + 1]
}

fn q_decode(s: Str) -> Bytes ! Str {
  let b = s.bytes()
  var out = BytesBuilder.with_capacity(b.len())
  var i = 0
  var bad = ""
  while i < b.len() {
    let c = b[i]
    if c == 95 {
      out.write_byte(32)
    } else if c == 61 {
      if i + 2 >= b.len() {
        bad = "mime: invalid RFC 2047 encoded-word"
        break
      }
      if hex_of(b[i + 1]) < 0 {
        bad = "mime: invalid hex byte ${hex_byte(b[i + 1])}"
        break
      }
      if hex_of(b[i + 2]) < 0 {
        bad = "mime: invalid hex byte ${hex_byte(b[i + 2])}"
        break
      }
      out.write_byte(UInt8(hex_of(b[i + 1]) * 16 + hex_of(b[i + 2])))
      i += 2
    } else if (c <= 126 && c >= 32) || c == 10 || c == 13 || c == 9 {
      out.write_byte(c)
    } else {
      bad = "mime: invalid RFC 2047 encoded-word"
      break
    }
    i += 1
  }
  if !bad.is_empty() {
    return Err(bad)
  }
  out.freeze()
}

/// The result of decoding a word: its text, or an error, and whether the
/// word was an encoded word whose charset is not supported (message.go's
/// charsetReaderError).
enum Decoded {
  Text(s: Str)
  NotEncoded
  Charset(msg: Str)
}

/// WordDecoder.Decode with net/mail's CharsetReader (every other charset
/// is `charset not supported: "x"`).
fn decode_word(word: Str) -> Decoded {
  if word.len() < 8 || !word.starts_with("=?") || !word.ends_with("?=") || word.split("?").len() != 5 {
    return Decoded.NotEncoded
  }
  let inner = word[2..word.len() - 2]
  let parts = inner.split("?")
  let charset = parts[0]
  let enc = parts[1]
  let text = parts[2]
  if charset.is_empty() || enc.len() != 1 {
    return Decoded.NotEncoded
  }
  let content = match enc {
    "B" | "b" => match Bytes.from_base64(text) {
      Some(b) => b
      None => return Decoded.NotEncoded
    }
    "Q" | "q" => match q_decode(text) {
      Ok(b) => b
      Err(_) => return Decoded.NotEncoded
    }
    _ => return Decoded.NotEncoded
  }
  let lower = charset.to_lower()
  if lower == "utf-8" {
    // bytes that are not UTF-8 become U+FFFD each (decision 0259)
    return Decoded.Text(s: lossy(content))
  }
  if lower == "iso-8859-1" {
    var out = StrBuilder.new()
    for c in content {
      out.write("${Rune(Int(c))}")
    }
    return Decoded.Text(s: out.freeze())
  }
  if lower == "us-ascii" {
    var out = StrBuilder.new()
    for c in content {
      out.write(if c >= 128 { "\u{FFFD}" } else { "${Rune(Int(c))}" })
    }
    return Decoded.Text(s: out.freeze())
  }
  Decoded.Charset(msg: "charset not supported: ${lower.quote()}")
}

fn lossy(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = StrBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write("${r}")
    i += n
  }
  out.freeze()
}

const MAX_CONTENT: Int = 63

fn write_q(var out: StrBuilder, s: Bytes) {
  let hex = UPPER_HEX
  for c in s {
    let v = Int(c)
    if c == 32 {
      out.write("_")
    } else if c >= 33 && c <= 126 && c != 61 && c != 63 && c != 95 {
      out.write("${Rune(v)}")
    } else {
      out.write("=" + hex[v >> 4..(v >> 4) + 1] + hex[v & 15..(v & 15) + 1])
    }
  }
}

/// WordEncoder.Encode with charset utf-8: the text when it needs no
/// encoding, else encoded words of at most 75 bytes, split between runes.
fn encode_word(q: Bool, s: Str) -> Str {
  var needs = false
  for r in s.runes() {
    if (r < ' ' || r > '~') && r != '\t' {
      needs = true
    }
  }
  if !needs {
    return s
  }
  let open = if q { "=?utf-8?q?" } else { "=?utf-8?b?" }
  var words: List[Str] = []
  let b = s.bytes()
  if q {
    var cur = StrBuilder.new()
    var len = 0
    var i = 0
    while i < b.len() {
      let c = b[i]
      var n = 1
      var enc = 1
      if !(c >= 32 && c <= 126 && c != 61 && c != 63 && c != 95) {
        n = b.decode_rune(i).1
        enc = 3 * n
      }
      if len + enc > MAX_CONTENT {
        words.push(cur.freeze())
        cur = StrBuilder.new()
        len = 0
      }
      write_q(cur, b[i..i + n])
      len += enc
      i += n
    }
    words.push(cur.freeze())
  } else {
    // base64: whole when it fits, else pieces of at most 47 bytes of text
    if (b.len() + 2) / 3 * 4 <= MAX_CONTENT {
      words.push(b.to_base64())
    } else {
      var last = 0
      var len = 0
      var i = 0
      while i < b.len() {
        let n = b.decode_rune(i).1
        if len + n <= 47 {
          len += n
        } else {
          words.push(b[last..i].to_base64())
          last = i
          len = n
        }
        i += n
      }
      words.push(b[last..].to_base64())
    }
  }
  words.map(fn(w) { open + w + "?=" }).join(" ")
}

// ---------------------------------------------------------------------------
// IP addresses of domain literals (net.ParseIP over netip.ParseAddr)

fn ipv4_ok(s: Str) -> Bool {
  let b = s.bytes()
  var val = 0
  var digits = 0
  var dots = 0
  for i in 0..b.len() {
    let c = b[i]
    if c >= 48 && c <= 57 {
      if digits == 1 && val == 0 {
        return false
      }
      val = val * 10 + Int(c) - 48
      digits += 1
      if val > 255 {
        return false
      }
    } else if c == 46 {
      if i == 0 || i == b.len() - 1 || b[i - 1] == 46 || dots == 3 {
        return false
      }
      dots += 1
      val = 0
      digits = 0
    } else {
      return false
    }
  }
  dots == 3
}

fn ipv6_ok(s0: Str) -> Bool {
  if s0.contains("%") {
    // a zone: net.ParseIP has none
    return false
  }
  var s = s0.bytes()
  var ellipsis = -1
  if s.len() >= 2 && s[0] == 58 && s[1] == 58 {
    ellipsis = 0
    s = s[2..]
    if s.is_empty() {
      return true
    }
  }
  var i = 0
  while i < 16 {
    var off = 0
    var acc = 0
    while off < s.len() && hex_of(s[off]) >= 0 {
      acc = acc * 16 + hex_of(s[off])
      if off > 3 || acc > 65535 {
        return false
      }
      off += 1
    }
    if off == 0 {
      return false
    }
    if off < s.len() && s[off] == 46 {
      if ellipsis < 0 && i != 12 {
        return false
      }
      if i + 4 > 16 {
        return false
      }
      if !ipv4_ok(s.to_str() ?? "") {
        return false
      }
      s = b""
      i += 4
      break
    }
    i += 2
    s = s[off..]
    if s.is_empty() {
      break
    }
    if s[0] != 58 || s.len() == 1 {
      return false
    }
    s = s[1..]
    if s[0] == 58 {
      if ellipsis >= 0 {
        return false
      }
      ellipsis = i
      s = s[1..]
      if s.is_empty() {
        break
      }
    }
  }
  if !s.is_empty() {
    return false
  }
  if i < 16 {
    return ellipsis >= 0
  }
  ellipsis < 0
}

fn ip_ok(s: Str) -> Bool {
  for c in s.bytes() {
    if c == 46 {
      return ipv4_ok(s)
    }
    if c == 58 {
      return ipv6_ok(s)
    }
    if c == 37 {
      return false
    }
  }
  false
}

// ---------------------------------------------------------------------------
// The parser (message.go addrParser)

struct P {
  s: Str
}

fn (p: P) empty() -> Bool { p.s.is_empty() }

fn (p: P) peek() -> UInt8 { p.s.bytes()[0] }

fn (var p: P) consume(c: UInt8) -> Bool {
  if p.empty() || p.peek() != c {
    return false
  }
  p.s = p.s[1..]
  true
}

fn (var p: P) skip_space() {
  let b = p.s.bytes()
  var i = 0
  while i < b.len() && (b[i] == 32 || b[i] == 9) {
    i += 1
  }
  p.s = p.s[i..]
}

fn (var p: P) consume_comment() -> (Str, Bool) {
  var depth = 1
  var comment = StrBuilder.new()
  while !p.empty() && depth != 0 {
    if p.peek() == 92 && p.s.len() > 1 {
      p.s = p.s[1..]
    } else if p.peek() == 40 {
      depth += 1
    } else if p.peek() == 41 {
      depth -= 1
    }
    if depth > 0 {
      // one byte: a character of the comment, as Go's p.s[:1]
      let (r, n) = p.s.bytes().decode_rune(0)
      comment.write(p.s[0..n])
      p.s = p.s[n..]
      let _ = r
      continue
    }
    p.s = p.s[1..]
  }
  (comment.freeze(), depth == 0)
}

fn (var p: P) skip_cfws() -> Bool {
  p.skip_space()
  while p.consume(40) {
    let (_, ok) = p.consume_comment()
    if !ok {
      return false
    }
    p.skip_space()
  }
  true
}

fn (var p: P) consume_quoted_string() -> Str ! mail.MailErr {
  let b = p.s.bytes()
  var i = 1
  var out = StrBuilder.new()
  var escaped = false
  var closed = false
  var bad = ""
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if escaped {
      if !is_vchar(r) && !is_wsp(r) {
        bad = "mail: bad character in quoted-string: ${r.quote()}"
        break
      }
      out.write("${r}")
      escaped = false
    } else if is_qtext(r) || is_wsp(r) {
      out.write("${r}")
    } else if r == '"' {
      closed = true
      break
    } else if r == '\\' {
      escaped = true
    } else {
      bad = "mail: bad character in quoted-string: ${r.quote()}"
      break
    }
    i += n
  }
  if !bad.is_empty() {
    return Err(fail(bad))
  }
  if !closed {
    return Err(fail("mail: unclosed quoted-string"))
  }
  p.s = p.s[i + 1..]
  out.freeze()
}

fn (var p: P) consume_atom(dot: Bool, permissive: Bool) -> Str ! mail.MailErr {
  let b = p.s.bytes()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if !is_atext(r, dot) {
      break
    }
    i += n
  }
  if i == 0 {
    return Err(fail("mail: invalid string"))
  }
  let atom = p.s[0..i]
  p.s = p.s[i..]
  if !permissive {
    if atom.starts_with(".") {
      return Err(fail("mail: leading dot in atom"))
    }
    if atom.contains("..") {
      return Err(fail("mail: double dot in atom"))
    }
    if atom.ends_with(".") {
      return Err(fail("mail: trailing dot in atom"))
    }
  }
  atom
}

fn (var p: P) consume_domain_literal() -> Str ! mail.MailErr {
  if !p.consume(91) {
    return Err(fail("mail: missing \"[\" in domain-literal"))
  }
  let start = p.s
  var n = 0
  while {
    if p.empty() {
      return Err(fail("mail: unclosed domain-literal"))
    }
    if p.peek() == 93 {
      break
    }
    let (r, size) = p.s.bytes().decode_rune(0)
    if !is_dtext(r) {
      return Err(fail("mail: bad character in domain-literal: ${r.quote()}"))
    }
    n += size
    p.s = p.s[size..]
  }
  let dtext = start[0..n]
  if !p.consume(93) {
    return Err(fail("mail: unclosed domain-literal"))
  }
  if !ip_ok(dtext) {
    return Err(fail("mail: invalid IP address in domain-literal: ${dtext.quote()}"))
  }
  "[" + dtext + "]"
}

/// consumeAddrSpec; the parser is unchanged when it fails.
fn (var p: P) consume_addr_spec() -> Str ! mail.MailErr {
  let orig = p.s
  match p.addr_spec() {
    Ok(s) => s
    Err(e) => {
      p.s = orig
      Err(e)
    }
  }
}

fn (var p: P) addr_spec() -> Str ! mail.MailErr {
  p.skip_space()
  if p.empty() {
    return Err(fail("mail: no addr-spec"))
  }
  var local = ""
  if p.peek() == 34 {
    local = p.consume_quoted_string()?
    if local.is_empty() {
      return Err(fail("mail: empty quoted string in addr-spec"))
    }
  } else {
    local = p.consume_atom(true, false)?
  }
  if !p.consume(64) {
    return Err(fail("mail: missing @ in addr-spec"))
  }
  p.skip_space()
  if p.empty() {
    return Err(fail("mail: no domain in addr-spec"))
  }
  let domain = if p.peek() == 91 { p.consume_domain_literal()? } else { p.consume_atom(true, false)? }
  local + "@" + domain
}

fn (var p: P) consume_phrase() -> Str ! mail.MailErr {
  var words: List[Str] = []
  var prev_encoded = false
  var failed = ""
  while {
    if !words.is_empty() {
      if !p.skip_cfws() {
        return Err(fail("mail: misformatted parenthetical comment"))
      }
    }
    p.skip_space()
    if p.empty() {
      break
    }
    var word = ""
    var encoded = false
    if p.peek() == 34 {
      match p.consume_quoted_string() {
        Ok(w) => word = w
        Err(e) => {
          failed = e.msg
          break
        }
      }
    } else {
      match p.consume_atom(true, true) {
        Ok(w) => {
          match decode_word(w) {
            Text(t) => {
              word = t
              encoded = true
            }
            NotEncoded => word = w
            Charset(msg) => {
              failed = msg
              break
            }
          }
        }
        Err(e) => {
          failed = e.msg
          break
        }
      }
    }
    if prev_encoded && encoded {
      let last = words.pop() ?? ""
      words.push(last + word)
    } else {
      words.push(word)
    }
    prev_encoded = encoded
  }
  if !failed.is_empty() && words.is_empty() {
    return Err(fail("mail: missing word in phrase: ${failed}"))
  }
  words.join(" ")
}

fn (var p: P) consume_display_name_comment() -> Str ! mail.MailErr {
  if !p.consume(40) {
    return Err(fail("mail: comment does not start with ("))
  }
  let (comment, ok) = p.consume_comment()
  if !ok {
    return Err(fail("mail: misformatted parenthetical comment"))
  }
  var words: List[Str] = []
  for w in comment.replace("\t", " ").split(" ") {
    if w.is_empty() {
      continue
    }
    match decode_word(w) {
      Text(t) => words.push(t)
      NotEncoded => words.push(w)
      Charset(msg) => return Err(fail(msg))
    }
  }
  words.join(" ")
}

fn (var p: P) parse_address(handle_group: Bool) -> List[mail.Address] ! mail.MailErr {
  p.skip_space()
  if p.empty() {
    return Err(fail("mail: no address"))
  }
  if let Ok(spec) = p.consume_addr_spec() {
    var name = ""
    p.skip_space()
    if !p.empty() && p.peek() == 40 {
      name = p.consume_display_name_comment()?
    }
    return [mail.Address{name: name, address: spec}]
  }
  var name = ""
  if p.peek() != 60 {
    name = p.consume_phrase()?
  }
  p.skip_space()
  if handle_group && p.consume(58) {
    return p.consume_group_list()
  }
  if !p.consume(60) {
    if name.runes().all(fn(r) { is_atext(r, true) }) {
      return Err(fail("mail: missing '@' or angle-addr"))
    }
    return Err(fail("mail: no angle-addr"))
  }
  let spec = p.consume_addr_spec()?
  if !p.consume(62) {
    return Err(fail("mail: unclosed angle-addr"))
  }
  [mail.Address{name: name, address: spec}]
}

fn (var p: P) consume_group_list() -> List[mail.Address] ! mail.MailErr {
  var group: List[mail.Address] = []
  p.skip_space()
  if p.consume(59) {
    if !p.skip_cfws() {
      return Err(fail("mail: misformatted parenthetical comment"))
    }
    return group
  }
  while {
    p.skip_space()
    group = group + p.parse_address(false)?
    if !p.skip_cfws() {
      return Err(fail("mail: misformatted parenthetical comment"))
    }
    if p.consume(59) {
      if !p.skip_cfws() {
        return Err(fail("mail: misformatted parenthetical comment"))
      }
      break
    }
    if !p.consume(44) {
      return Err(fail("mail: expected comma"))
    }
  }
  group
}

fn parse_address(s: Str) -> mail.Address ! mail.MailErr {
  var p = P{s: s}
  let addrs = p.parse_address(true)?
  if !p.skip_cfws() {
    return Err(fail("mail: misformatted parenthetical comment"))
  }
  if !p.empty() {
    return Err(fail("mail: expected single address, got ${p.s.quote()}"))
  }
  if addrs.is_empty() {
    return Err(fail("mail: empty group"))
  }
  if addrs.len() > 1 {
    return Err(fail("mail: group with multiple addresses"))
  }
  addrs[0]
}

fn parse_address_list(s: Str) -> List[mail.Address] ! mail.MailErr {
  var p = P{s: s}
  var list: List[mail.Address] = []
  while {
    p.skip_space()
    if p.consume(44) {
      continue
    }
    list = list + p.parse_address(true)?
    if !p.skip_cfws() {
      return Err(fail("mail: misformatted parenthetical comment"))
    }
    if p.empty() {
      break
    }
    if p.peek() != 44 {
      return Err(fail("mail: expected comma"))
    }
    while p.consume(44) {
      p.skip_space()
    }
    if p.empty() {
      break
    }
  }
  list
}

// ---------------------------------------------------------------------------
// Address.String

fn quote_string(s: Str) -> Str {
  var out = StrBuilder.new()
  out.write("\"")
  for r in s.runes() {
    if is_qtext(r) || is_wsp(r) {
      out.write("${r}")
    } else if is_vchar(r) {
      out.write("\\")
      out.write("${r}")
    }
  }
  out.write("\"")
  out.freeze()
}

fn address_display(a: mail.Address) -> Str {
  var local = a.address
  var domain = ""
  // the last @
  let b = a.address.bytes()
  var at = -1
  for i in 0..b.len() {
    if b[i] == 64 {
      at = i
    }
  }
  if at >= 0 {
    local = a.address[0..at]
    domain = a.address[at + 1..]
  }
  var quote_local = false
  let lb = local.bytes()
  var i = 0
  while i < lb.len() {
    let (r, n) = lb.decode_rune(i)
    if !is_atext(r, false) {
      let ok_dot = r == '.' && i > 0 && lb[i - 1] != 46 && i < lb.len() - 1
      if !ok_dot {
        quote_local = true
        break
      }
    }
    i += n
  }
  if quote_local {
    local = quote_string(local)
  }
  let s = "<" + local + "@" + domain + ">"
  if a.name.is_empty() {
    return s
  }
  if a.name.runes().all(fn(r) { (is_vchar(r) || is_wsp(r)) && Int(r) < 128 }) {
    return quote_string(a.name) + " " + s
  }
  for c in "\"#$%&'(),.:;<>@[]^`{|}~".runes() {
    if a.name.runes().contains(c) {
      return encode_word(false, a.name) + " " + s
    }
  }
  encode_word(true, a.name) + " " + s
}

// ---------------------------------------------------------------------------
// Messages (message.go ReadMessage and readHeader, over net/textproto's
// ReadContinuedLine; decision 0290)

fn mime_field_byte(c: UInt8) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c is '!' | '#' | '$' | '%' | '&' | '\'' | '*' | '+' | '-' | '.' | '^' | '_' | '`' | '|' | '~'
}

/// textproto.CanonicalMIMEHeaderKey: k unchanged when a byte of it cannot
/// be in a field name, else each word capitalized.
fn canonical_key(k: Bytes) -> Str {
  for c in k {
    if !mime_field_byte(c) {
      return bytes_text(k)
    }
  }
  var out = BytesBuilder.with_capacity(k.len())
  var upper = true
  for c in k {
    var x = c
    if upper && x >= 'a' && x <= 'z' {
      x = x - 32
    } else if !upper && x >= 'A' && x <= 'Z' {
      x = x + 32
    }
    out.write_byte(x)
    upper = x == '-'
  }
  bytes_text(out.freeze())
}

fn bytes_text(b: Bytes) -> Str { b.to_str() ?? lossy(b) }

/// textproto's trim: spaces and tabs off both ends.
fn trim_wsp(b: Bytes) -> Bytes {
  var s = 0
  while s < b.len() && (b[s] == ' ' || b[s] == '\t') {
    s += 1
  }
  var e = b.len()
  while e > s && (b[e - 1] == ' ' || b[e - 1] == '\t') {
    e -= 1
  }
  b[s..e]
}

/// A line reader (bufio.Reader.ReadLine): the line without "\n" or
/// "\r\n", or None at the end.
struct LineR {
  b: Bytes
  at: Int = 0
}

fn (var r: LineR) line() -> Bytes? {
  if r.at >= r.b.len() {
    return None
  }
  var j = r.at
  while j < r.b.len() && r.b[j] != '\n' {
    j += 1
  }
  var l = r.b[r.at..j]
  if j < r.b.len() {
    if l.len() > 0 && l[l.len() - 1] == '\r' {
      l = l[0..l.len() - 1]
    }
    r.at = j + 1
  } else {
    r.at = j
  }
  Some(l)
}

/// textproto.Reader.skipSpace: the spaces and tabs skipped.
fn (var r: LineR) skip_space() -> Int {
  var n = 0
  while r.at < r.b.len() && (r.b[r.at] == ' ' || r.b[r.at] == '\t') {
    r.at += 1
    n += 1
  }
  n
}

/// textproto.Reader.ReadContinuedLine: a field and its continuation
/// lines, each trimmed, joined by one space; None at the end.
fn (var r: LineR) continued() -> Bytes? {
  let first = r.line()?
  if first.is_empty() {
    return Some(first)
  }
  var buf = trim_wsp(first)
  while r.skip_space() > 0 {
    buf = buf + b" "
    match r.line() {
      Some(l) => buf = buf + trim_wsp(l)
      None => break
    }
  }
  Some(buf)
}

fn read_message(msg: Bytes) -> mail.Message ! mail.MailErr {
  var r = LineR{b: msg}
  var headers: List[(Str, Str)] = []
  if msg.len() > 0 && (msg[0] == ' ' || msg[0] == '\t') {
    let l = r.line() ?? b""
    return Err(fail("malformed initial line: ${bytes_text(l)}"))
  }
  while true {
    let kv = match r.continued() {
      Some(x) => x
      None => {
        // the end before a blank line: a message when it has a field
        if headers.is_empty() {
          return Err(fail("EOF"))
        }
        break
      }
    }
    if kv.is_empty() {
      break
    }
    var colon = 0
    while colon < kv.len() && kv[colon] != ':' {
      colon += 1
    }
    if colon == kv.len() {
      colon = -1
    }
    if colon < 0 {
      return Err(fail("malformed header line: ${bytes_text(kv)}"))
    }
    let key = canonical_key(kv[0..colon])
    if key.is_empty() {
      continue
    }
    var v = kv[colon + 1..]
    var s = 0
    while s < v.len() && (v[s] == ' ' || v[s] == '\t') {
      s += 1
    }
    headers.push((key, bytes_text(v[s..])))
  }
  Ok(mail.Message{headers: headers, body: msg[r.at..]})
}

fn message_header(m: mail.Message, name: Str) -> Str? {
  let want = canonical_key(name.bytes())
  for (k, v) in m.headers {
    if k == want {
      return Some(v)
    }
  }
  None
}

// ---------------------------------------------------------------------------
// Dates (message.go ParseDate over time.Parse's layouts; a zone name keeps
// the wall clock as UTC's, as time.ParseInLocation in UTC does: only a
// numeric offset moves the instant)

const MONTHS: List[Str] = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
const DAYS: List[Str] = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]

/// The digits at the start of s: at most max, at least one (fixed: exactly
/// max), as the number and their count; (0, 0) when there are none.
fn digits(s: Bytes, at: Int, min: Int, max: Int) -> (Int, Int) {
  var n = 0
  var k = 0
  while k < max && at + k < s.len() && s[at + k] >= '0' && s[at + k] <= '9' {
    n = n * 10 + Int(s[at + k] - '0')
    k += 1
  }
  if k < min {
    return (0, 0)
  }
  (n, k)
}

fn lower3(s: Bytes, at: Int) -> Str {
  if at + 3 > s.len() {
    return ""
  }
  var b = BytesBuilder.with_capacity(3)
  for k in 0..3 {
    let c = s[at + k]
    b.write_byte(if c >= 'A' && c <= 'Z' { c + 32 } else { c })
  }
  b.freeze().to_str() ?? ""
}

fn is_leap(y: Int) -> Bool { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

fn month_days(y: Int, m: Int) -> Int {
  if m == 2 {
    return if is_leap(y) { 29 } else { 28 }
  }
  if m is 4 | 6 | 9 | 11 { 30 } else { 31 }
}

fn days_from_civil(year: Int, m: Int, d: Int) -> Int {
  var y = year
  if m <= 2 {
    y -= 1
  }
  let era = if y >= 0 { y / 400 } else { (y - 399) / 400 }
  let yoe = y - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

/// time.parseTimeZone: the length of a zone name at s[at..], 0 for none.
fn zone_name_len(s: Bytes, at: Int) -> Int {
  let rest = s.len() - at
  if rest < 3 {
    return 0
  }
  // time.Parse's stdTZ takes UTC first
  if s[at..at + 3] == b"UTC" {
    return 3
  }
  if rest >= 4 && (s[at..at + 4] == b"ChST" || s[at..at + 4] == b"MeST") {
    return 4
  }
  if s[at..at + 3] == b"GMT" {
    // time.parseGMT: GMT, then a signed hour offset of at most 23
    var k = 3
    if at + k < s.len() && (s[at + k] == '+' || s[at + k] == '-') {
      let (x, n) = digits(s, at + k + 1, 1, 20)
      if n > 0 && x <= 23 {
        k += 1 + n
      }
    }
    return k
  }
  if s[at] == '+' || s[at] == '-' {
    return 0
  }
  var upper = 0
  while upper < 6 && at + upper < s.len() && s[at + upper] >= 'A' && s[at + upper] <= 'Z' {
    upper += 1
  }
  if upper == 3 {
    return 3
  }
  if upper == 4 && (s[at + 3] == 'T' || s[at..at + 4] == b"WITA") {
    return 4
  }
  if upper == 5 && s[at + 4] == 'T' {
    return 5
  }
  0
}

/// time.Parse's skip for a layout space: one or more spaces at s[at..],
/// the offset after them, or -1.
fn spaces(s: Bytes, at: Int) -> Int {
  if at >= s.len() || s[at] != ' ' {
    return -1
  }
  var k = at
  while k < s.len() && s[k] == ' ' {
    k += 1
  }
  k
}

/// One layout of dateLayouts: weekday, two digit day, four digit year,
/// seconds, and the zone kind (0 numeric, 1 name, 2 "UT"); the instant
/// in seconds, or None when the layout does not match.
fn try_layout(s: Bytes, dow: Bool, day2: Bool, year4: Bool, secs: Bool, zone: Int) -> Int? {
  var at = 0
  if dow {
    if !DAYS.contains(lower3(s, at)) || at + 4 > s.len() || s[at + 3] != ',' {
      return None
    }
    at = spaces(s, at + 4)
    if at < 0 {
      return None
    }
  }
  let (day, dn) = if day2 { digits(s, at, 2, 2) } else { digits(s, at, 1, 2) }
  if dn == 0 {
    return None
  }
  at += dn
  at = spaces(s, at)
  if at < 0 {
    return None
  }
  let mon = MONTHS.index_of(lower3(s, at)) ?? -1
  if mon < 0 {
    return None
  }
  at += 3
  at = spaces(s, at)
  if at < 0 {
    return None
  }
  let (yv, yn) = if year4 { digits(s, at, 4, 4) } else { digits(s, at, 2, 2) }
  if yn == 0 {
    return None
  }
  at += yn
  let year = if year4 { yv } else if yv >= 69 { 1900 + yv } else { 2000 + yv }
  at = spaces(s, at)
  if at < 0 {
    return None
  }
  let (hour, hn) = digits(s, at, 1, 2)
  if hn == 0 {
    return None
  }
  at += hn
  if at >= s.len() || s[at] != ':' {
    return None
  }
  at += 1
  let (min, mn) = digits(s, at, 2, 2)
  if mn == 0 {
    return None
  }
  at += mn
  var sec = 0
  if secs {
    if at >= s.len() || s[at] != ':' {
      return None
    }
    let (sv, sn) = digits(s, at + 1, 2, 2)
    if sn == 0 {
      return None
    }
    sec = sv
    at += 1 + sn
  }
  at = spaces(s, at)
  if at < 0 {
    return None
  }
  var offset = 0
  if zone == 0 {
    if at + 5 > s.len() || !(s[at] == '+' || s[at] == '-') {
      return None
    }
    let (hh, hhn) = digits(s, at + 1, 2, 2)
    let (mm, mmn) = digits(s, at + 3, 2, 2)
    if hhn == 0 || mmn == 0 || hh > 24 || mm > 60 {
      return None
    }
    offset = (hh * 60 + mm) * 60
    if s[at] == '-' {
      offset = -offset
    }
    at += 5
  } else if zone == 1 {
    let n = zone_name_len(s, at)
    if n == 0 {
      return None
    }
    // time.Parse keeps the wall clock as UTC's for a zone name, GMT+h
    // included (only its location's offset changes, not the instant)
    at += n
  } else {
    if at + 2 > s.len() || s[at..at + 2] != b"UT" {
      return None
    }
    at += 2
  }
  if at != s.len() {
    return None
  }
  // time.Date's ranges (time.Parse: "out of range")
  if hour >= 24 || min >= 60 || sec >= 60 || day < 1 || day > month_days(year, mon + 1) {
    return None
  }
  Some(days_from_civil(year, mon + 1, day) * 86400 + hour * 3600 + min * 60 + sec - offset)
}

fn parse_date(s: Str) -> Time ! mail.MailErr {
  let date0 = s.replace("\r\n", "")
  if date0.contains("\r") {
    return Err(fail("mail: header has a CR without LF"))
  }
  var p = P{s: date0}
  p.skip_space()
  var date = date0
  let b = p.s.bytes()
  var ind = 0
  while ind < b.len() && b[ind] != '+' && b[ind] != '-' {
    ind += 1
  }
  if ind == b.len() {
    ind = -1
  }
  if ind != -1 && b.len() >= ind + 5 {
    date = p.s[0..ind + 5]
    p.s = p.s[ind + 5..]
  } else {
    var t = p.s.find("T") ?? -1
    if t == 0 {
      t = match p.s[1..].find("T") {
        Some(x) => x + 1
        None => -1
      }
    }
    if t != -1 && b.len() >= t + 5 {
      date = p.s[0..t + 1]
      p.s = p.s[t + 1..]
    }
  }
  if !p.skip_cfws() {
    return Err(fail("mail: misformatted parenthetical comment"))
  }
  let db = date.bytes()
  for dow in [false, true] {
    for day2 in [false, true] {
      for year4 in [true, false] {
        for secs in [true, false] {
          for zone in [0, 1, 2] {
            match try_layout(db, dow, day2, year4, secs, zone) {
              Some(t) => {
                if t < -9223372036 || t > 9223372036 {
                  return Err(fail("mail: date out of range"))
                }
                return Ok(Time.UNIX_EPOCH + Duration.from_nanos(t * 1000000000))
              }
              None => {}
            }
          }
        }
      }
    }
  }
  Err(fail("mail: header could not be parsed"))
}

// ---------------------------------------------------------------------------
// Composing (decision 0290; mime/quotedprintable's Writer, mime's
// QEncoding, mime/multipart's Writer with a boundary from the id)

/// mime/quotedprintable.Writer (Binary false) over data, closed: lines of
/// at most 76 bytes, CRLF line endings, trailing spaces encoded.
fn qp_encode(data: Bytes) -> Bytes {
  var out = BytesBuilder.with_capacity(data.len() + data.len() / 8 + 8)
  var line: List[UInt8] = []
  var cr = false
  let hex = UPPER_HEX.bytes()
  for b in data {
    let plain = (b >= '!' && b <= '~' && b != '=') || b == ' ' || b == '\t' || b == '\n' || b == '\r'
    if plain {
      if b == '\n' || b == '\r' {
        if cr && b == '\n' {
          cr = false
          continue
        }
        if b == '\r' {
          cr = true
        }
        // checkLastByte: a trailing space or tab is encoded
        if !line.is_empty() && (line[line.len() - 1] == ' ' || line[line.len() - 1] == '\t') {
          let w = line.pop() ?? 32
          if 76 - 1 - line.len() < 3 {
            for x in line {
              out.write_byte(x)
            }
            out.write(b"=\r\n")
            line = []
          }
          line.push('=')
          line.push(hex[Int(w) >> 4])
          line.push(hex[Int(w) & 15])
        }
        for x in line {
          out.write_byte(x)
        }
        out.write(b"\r\n")
        line = []
        continue
      }
      if line.len() == 76 - 1 {
        for x in line {
          out.write_byte(x)
        }
        out.write(b"=\r\n")
        line = []
      }
      line.push(b)
      cr = false
      continue
    }
    if 76 - 1 - line.len() < 3 {
      for x in line {
        out.write_byte(x)
      }
      out.write(b"=\r\n")
      line = []
    }
    line.push('=')
    line.push(hex[Int(b) >> 4])
    line.push(hex[Int(b) & 15])
  }
  // Close: checkLastByte, then flush
  if !line.is_empty() && (line[line.len() - 1] == ' ' || line[line.len() - 1] == '\t') {
    let w = line.pop() ?? 32
    if 76 - 1 - line.len() < 3 {
      for x in line {
        out.write_byte(x)
      }
      out.write(b"=\r\n")
      line = []
    }
    line.push('=')
    line.push(hex[Int(w) >> 4])
    line.push(hex[Int(w) & 15])
  }
  for x in line {
    out.write_byte(x)
  }
  out.freeze()
}

fn two(n: Int) -> Str { if n < 10 { "0${n}" } else { "${n}" } }

/// t in UTC as time.RFC1123Z: `Mon, 02 Jan 2006 15:04:05 +0000`.
fn rfc1123z(t: Time) -> Str {
  let secs = t.unix()
  let days = if secs >= 0 { secs / 86400 } else { (secs - 86399) / 86400 }
  let rem = secs - days * 86400
  // civil from days (Howard Hinnant's algorithm)
  let z = days + 719468
  let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 }
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  let wd = ((days % 7) + 7 + 4) % 7
  let names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let ys = if y < 10 { "000${y}" } else if y < 100 { "00${y}" } else if y < 1000 { "0${y}" } else { "${y}" }
  "${names[wd]}, ${two(d)} ${months[m - 1]} ${ys} ${two(rem / 3600)}:${two(rem % 3600 / 60)}:${two(rem % 60)} +0000"
}

fn compose(from: mail.Address, to: List[mail.Address], subject: Str, text: Str, html: Str? = None, date: Time, id: Str) -> Bytes {
  var b = BytesBuilder.new()
  b.write("From: ${address_display(from)}\r\n".bytes())
  b.write("To: ${to.map(address_display).join(", ")}\r\n".bytes())
  b.write("Subject: ${encode_word(true, subject)}\r\n".bytes())
  b.write("Date: ${rfc1123z(date)}\r\n".bytes())
  b.write("Message-ID: <${id}>\r\n".bytes())
  b.write(b"MIME-Version: 1.0\r\n")
  match html {
    None => {
      b.write(b"Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n")
      b.write(qp_encode(text.bytes()))
    }
    Some(h) => {
      let boundary = "xo" + crypto.sha256(id.bytes()).to_hex()[0..28]
      b.write("Content-Type: multipart/alternative; boundary=\"${boundary}\"\r\n\r\n".bytes())
      b.write("--${boundary}\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n".bytes())
      b.write(qp_encode(text.bytes()))
      b.write("\r\n--${boundary}\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Type: text/html; charset=utf-8\r\n\r\n".bytes())
      b.write(qp_encode(h.bytes()))
      b.write("\r\n--${boundary}--\r\n".bytes())
    }
  }
  b.freeze()
}
