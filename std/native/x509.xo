// std/x509 (spec/std.md 41) natively: the TLS stack's certificate parser
// and verifier (std/native/llrt x509cert.xo and x509verify.xo, Go's
// crypto/x509 ported), their Cert converted to the public Certificate.
use std/crypto
use std/netip
use std/x509
use native/llrt/asn1
use native/llrt/cbyte
use native/llrt/pkcs12
use native/llrt/tlscert
use native/llrt/x509cert as lx
use native/llrt/x509verify as xv
use native/rt

fn certerr_display(e: x509.CertErr) -> Str { e.msg }

fn err(msg: Str) -> x509.CertErr { x509.CertErr{msg: msg} }

/// The Time of Unix seconds, clamped to the times a Time holds (1677 to
/// 2262): a certificate valid until 9999 is valid until the last Time.
fn time_of(secs: Int) -> Time {
  let s = if secs > 9223372035 { 9223372035 } else if secs < -9223372035 { -9223372035 } else { secs }
  Time.from_unix(s)
}

// ---------------------------------------------------------------------------
// Names (Go's pkix.Name, FillFromRDNSequence and String)

/// The Name of the DER der: its attributes, the common ones in their
/// fields (Go's FillFromRDNSequence: the last common name and serial
/// number, every value of the others in order).
fn name_of(der: Bytes) -> x509.Name {
  var n = x509.Name{country: [], organization: [], organizational_unit: [], locality: [], province: [], street_address: [], postal_code: [], serial_number: "", common_name: "", raw: der}
  for a in lx.name_atvs(der) ?? [] {
    if !a.text {
      continue
    }
    match a.oid {
      "2.5.4.3" => n.common_name = a.value
      "2.5.4.5" => n.serial_number = a.value
      "2.5.4.6" => n.country.push(a.value)
      "2.5.4.7" => n.locality.push(a.value)
      "2.5.4.8" => n.province.push(a.value)
      "2.5.4.9" => n.street_address.push(a.value)
      "2.5.4.10" => n.organization.push(a.value)
      "2.5.4.11" => n.organizational_unit.push(a.value)
      "2.5.4.17" => n.postal_code.push(a.value)
      _ => ()
    }
  }
  n
}

fn name_attributes(n: x509.Name) -> List[(Str, Str)] {
  var out: List[(Str, Str)] = []
  for a in lx.name_atvs(n.raw) ?? [] {
    out.push((a.oid, if a.text { a.value } else { "#${a.raw.to_hex()}" }))
  }
  out
}

/// pkix's attributeTypeNames.
fn type_name(oid: Str) -> Str? {
  match oid {
    "2.5.4.6" => Some("C")
    "2.5.4.10" => Some("O")
    "2.5.4.11" => Some("OU")
    "2.5.4.3" => Some("CN")
    "2.5.4.5" => Some("SERIALNUMBER")
    "2.5.4.7" => Some("L")
    "2.5.4.8" => Some("ST")
    "2.5.4.9" => Some("STREET")
    "2.5.4.17" => Some("POSTALCODE")
    _ => None
  }
}

/// encoding/asn1's isPrintable as Marshal picks a tag (no asterisk, no
/// ampersand): PrintableString when every rune is one, else UTF8String.
fn printable_rune(r: Int) -> Bool {
  (r >= 97 && r <= 122) || (r >= 65 && r <= 90) || (r >= 48 && r <= 57) || (r >= 39 && r <= 41) || (r >= 43 && r <= 47) || r == 32 || r == 58 || r == 61 || r == 63
}

/// asn1.Marshal of a Go string: its tag, length and bytes, in hex.
fn marshal_hex(v: Str) -> Str {
  var all = true
  for x in v.bytes() {
    if !printable_rune(Int(x)) {
      all = false
    }
  }
  let body = v.bytes()
  var b = BytesBuilder.with_capacity(body.len() + 6)
  b.write_byte(if all { 0x13 } else { 0x0c })
  let n = body.len()
  if n < 128 {
    b.write_byte(UInt8(n))
  } else {
    var k = 0
    var m = n
    while m > 0 {
      k += 1
      m = m >> 8
    }
    b.write_byte(UInt8(0x80 | k))
    var i = k - 1
    while i >= 0 {
      b.write_byte(UInt8((n >> (8 * i)) & 255))
      i -= 1
    }
  }
  b.write(body)
  b.freeze().to_hex()
}

/// One attribute as RDNSequence.String writes it.
fn atv_text(oid: Str, value: Str) -> Str {
  // a value that is not a string: its element as it is (marked by a NUL)
  if value.starts_with("\x00#") {
    return "${oid}=${value[1..value.len()]}"
  }
  let tn = match type_name(oid) {
    Some(t) => t
    None => return "${oid}=#${marshal_hex(value)}"
  }
  // the escapes are all ASCII, so bytes stand for runes
  let vb = value.bytes()
  var b = BytesBuilder.with_capacity(tn.len() + vb.len() + 8)
  b.write(tn.bytes())
  b.write_byte(61)
  let last = vb.len() - 1
  for (k, x) in vb.indexed() {
    let c = Int(x)
    let esc = c == 44 || c == 43 || c == 34 || c == 92 || c == 60 || c == 62 || c == 59 || (c == 32 && (k == 0 || k == last)) || (c == 35 && k == 0)
    if esc {
      b.write_byte(92)
    }
    b.write_byte(x)
  }
  b.freeze().to_str() ?? ""
}

fn name_display(n: x509.Name) -> Str {
  // Go's Name.String: the attributes outside the parsed fields first (they
  // print last), then ToRDNSequence's order; then RDNSequence.String,
  // which writes the RDNs in reverse
  var rdns: List[List[(Str, Str)]] = []
  for a in lx.name_atvs(n.raw) ?? [] {
    if type_name(a.oid).is_some() {
      continue
    }
    rdns.push([(a.oid, if a.text { a.value } else { "\x00#${a.raw.to_hex()}" })])
  }
  for (vs, oid) in [(n.country, "2.5.4.6"), (n.province, "2.5.4.8"), (n.locality, "2.5.4.7"), (n.street_address, "2.5.4.9"), (n.postal_code, "2.5.4.17"), (n.organization, "2.5.4.10"), (n.organizational_unit, "2.5.4.11")] {
    if !vs.is_empty() {
      var rdn: List[(Str, Str)] = []
      for v in vs {
        rdn.push((oid, v))
      }
      rdns.push(rdn)
    }
  }
  if !n.common_name.is_empty() {
    rdns.push([("2.5.4.3", n.common_name)])
  }
  if !n.serial_number.is_empty() {
    rdns.push([("2.5.4.5", n.serial_number)])
  }
  var b = StrBuilder.new()
  var i = rdns.len() - 1
  while i >= 0 {
    if i < rdns.len() - 1 {
      b.write(",")
    }
    for (j, (oid, v)) in rdns[i].indexed() {
      if j > 0 {
        b.write("+")
      }
      b.write(atv_text(oid, v))
    }
    i -= 1
  }
  b.freeze()
}

// ---------------------------------------------------------------------------
// Certificates

/// Go's SignatureAlgorithm.String() of the certificate's algorithm.
fn sig_name(c: lx.Cert) -> Str { sig_name_of(c.sig_alg, c.sig_oid) }

fn sig_name_of(alg: Int, oid: Str) -> Str {
  if alg == lx.SIG_RSA_SHA256 { return "SHA256-RSA" }
  if alg == lx.SIG_RSA_SHA384 { return "SHA384-RSA" }
  if alg == lx.SIG_RSA_SHA512 { return "SHA512-RSA" }
  if alg == lx.SIG_ECDSA_SHA256 { return "ECDSA-SHA256" }
  if alg == lx.SIG_ECDSA_SHA384 { return "ECDSA-SHA384" }
  if alg == lx.SIG_ECDSA_SHA512 { return "ECDSA-SHA512" }
  if alg == lx.SIG_ED25519 { return "Ed25519" }
  if alg == lx.SIG_PSS_SHA256 { return "SHA256-RSAPSS" }
  if alg == lx.SIG_PSS_SHA384 { return "SHA384-RSAPSS" }
  if alg == lx.SIG_PSS_SHA512 { return "SHA512-RSAPSS" }
  match oid {
    "1.2.840.113549.1.1.2" => "MD2-RSA"
    "1.2.840.113549.1.1.4" => "MD5-RSA"
    "1.2.840.113549.1.1.5" | "1.3.14.3.2.29" => "SHA1-RSA"
    "1.2.840.10040.4.3" => "DSA-SHA1"
    "2.16.840.1.101.3.4.3.2" => "DSA-SHA256"
    "1.2.840.10045.4.1" => "ECDSA-SHA1"
    _ => "0"
  }
}

const KEY_USAGES: List[x509.KeyUsage] = [x509.KeyUsage.DigitalSignature, x509.KeyUsage.ContentCommitment, x509.KeyUsage.KeyEncipherment, x509.KeyUsage.DataEncipherment, x509.KeyUsage.KeyAgreement, x509.KeyUsage.CertSign, x509.KeyUsage.CrlSign, x509.KeyUsage.EncipherOnly, x509.KeyUsage.DecipherOnly]

fn eku_of(oid: Str) -> x509.ExtKeyUsage {
  match oid {
    "2.5.29.37.0" => x509.ExtKeyUsage.Any
    "1.3.6.1.5.5.7.3.1" => x509.ExtKeyUsage.ServerAuth
    "1.3.6.1.5.5.7.3.2" => x509.ExtKeyUsage.ClientAuth
    "1.3.6.1.5.5.7.3.3" => x509.ExtKeyUsage.CodeSigning
    "1.3.6.1.5.5.7.3.4" => x509.ExtKeyUsage.EmailProtection
    "1.3.6.1.5.5.7.3.8" => x509.ExtKeyUsage.TimeStamping
    "1.3.6.1.5.5.7.3.9" => x509.ExtKeyUsage.OcspSigning
    _ => x509.ExtKeyUsage.Other(oid: oid)
  }
}

fn eku_oid(u: x509.ExtKeyUsage) -> Str {
  match u {
    Any => "2.5.29.37.0"
    ServerAuth => "1.3.6.1.5.5.7.3.1"
    ClientAuth => "1.3.6.1.5.5.7.3.2"
    CodeSigning => "1.3.6.1.5.5.7.3.3"
    EmailProtection => "1.3.6.1.5.5.7.3.4"
    TimeStamping => "1.3.6.1.5.5.7.3.8"
    OcspSigning => "1.3.6.1.5.5.7.3.9"
    Other(oid) => oid
  }
}

fn cert_of(c: lx.Cert) -> x509.Certificate {
  var ips: List[netip.Addr] = []
  for b in c.ips {
    if let Some(a) = netip.addr_from_bytes(b) {
      ips.push(a)
    }
  }
  var ku: List[x509.KeyUsage] = []
  if c.key_usage > 0 {
    for (i, u) in KEY_USAGES.indexed() {
      if (c.key_usage & (1 << i)) != 0 {
        ku.push(u)
      }
    }
  }
  var eku: List[x509.ExtKeyUsage] = []
  for o in c.ext_usage_der {
    eku.push(eku_of(o))
  }
  var exts: List[x509.Extension] = []
  for e in c.extensions {
    exts.push(x509.Extension{oid: e.oid, critical: e.critical, value: e.value})
  }
  x509.Certificate{
    raw: c.raw,
    version: c.version,
    serial: c.serial,
    signature_algorithm: sig_name(c),
    issuer: name_of(c.issuer),
    subject: name_of(c.subject),
    not_before: time_of(c.not_before),
    not_after: time_of(c.not_after),
    public_key: crypto.parse_public_key(c.spki).ok(),
    dns_names: c.dns,
    ip_addresses: ips,
    email_addresses: c.emails,
    uris: c.uris,
    is_ca: c.is_ca,
    max_path_len: if c.has_bc && c.max_path >= 0 { Some(c.max_path) } else { None },
    key_usage: ku,
    ext_key_usage: eku,
    subject_key_id: c.ski,
    authority_key_id: c.aki,
    extensions: exts,
    raw_tbs_certificate: c.tbs,
    raw_subject_public_key_info: c.spki,
    signature: c.signature,
    public_key_algorithm: spki_alg_name(c.spki),
    basic_constraints_valid: c.has_bc,
    ocsp_servers: c.ocsp,
    issuing_certificate_urls: c.issuing,
    crl_distribution_points: c.crl_dps,
    permitted_dns_domains_critical: c.nc_critical,
    permitted_dns_domains: c.permitted_dns,
    excluded_dns_domains: c.excluded_dns,
    permitted_ip_ranges: ranges_of(c.permitted_ips),
    excluded_ip_ranges: ranges_of(c.excluded_ips),
    permitted_email_addresses: c.permitted_emails,
    excluded_email_addresses: c.excluded_emails,
    permitted_uri_domains: c.permitted_uris,
    excluded_uri_domains: c.excluded_uris,
    policies: c.policies.map(fn(o) { oid_text_any(o) }),
    policy_mappings: mappings_of(c.policy_maps),
    inhibit_any_policy: if c.has_inhibit_any { Some(c.inhibit_any) } else { None },
    inhibit_policy_mapping: if c.has_inhibit_mapping { Some(c.inhibit_mapping) } else { None },
    require_explicit_policy: if c.has_req_explicit { Some(c.req_explicit) } else { None },
    unhandled_critical_extensions: c.unhandled_oids,
  }
}

/// Go's PublicKeyAlgorithm.String() of a SubjectPublicKeyInfo's algorithm.
fn spki_alg_name(spki: Bytes) -> Str {
  let t = asn1.whole(spki, asn1.SEQUENCE)
  let kids = asn1.children(spki, t)
  if kids.len() != 2 || asn1.any_bad(kids) {
    return "0"
  }
  let alg = asn1.children(spki, kids[0])
  if alg.is_empty() || asn1.any_bad(alg) {
    return "0"
  }
  match asn1.oid_text(spki, alg[0]) {
    "1.2.840.113549.1.1.1" => "RSA"
    "1.2.840.10040.4.1" => "DSA"
    "1.2.840.10045.2.1" => "ECDSA"
    "1.3.101.112" => "Ed25519"
    _ => "0"
  }
}

/// An OID's contents as dotted text (Go's OID.String).
fn oid_dotted(contents: Bytes) -> Str { cbyte.oid_text(cbyte.of(contents)) ?? "" }

/// Name constraint IP subtrees (address then mask) as prefixes.
fn ranges_of(xs: List[Bytes]) -> List[netip.Prefix] {
  var out: List[netip.Prefix] = []
  for b in xs {
    let n = b.len() / 2
    var bits = 0
    for i in 0..n {
      var m = Int(b[n + i])
      while m > 0 {
        bits += m & 1
        m = m >> 1
      }
    }
    if let Some(a) = netip.addr_from_bytes(b[0..n]) {
      if let Some(p) = netip.prefix_from(a, bits) {
        out.push(p)
      }
    }
  }
  out
}

/// The policy mappings, stored as issuer and subject OID contents in turn.
fn mappings_of(xs: List[Bytes]) -> List[x509.PolicyMapping] {
  var out: List[x509.PolicyMapping] = []
  var i = 0
  while i + 1 < xs.len() {
    out.push(x509.PolicyMapping{issuer_domain_policy: oid_text_any(xs[i]), subject_domain_policy: oid_text_any(xs[i + 1])})
    i += 2
  }
  out
}

/// The llrt certificate of a public one (parsed again from its DER, which
/// parse made it from).
fn lcert(c: x509.Certificate) -> lx.Cert ! x509.CertErr {
  let p = lx.parse(c.raw)
  if p.err != "" {
    return Err(err(p.err))
  }
  Ok(p.cert)
}

fn parse(der: Bytes) -> x509.Certificate ! x509.CertErr {
  let p = lx.parse(der)
  if p.err != "" {
    return Err(err(p.err))
  }
  Ok(cert_of(p.cert))
}

fn parse_pem(pem: Bytes) -> List[x509.Certificate] ! x509.CertErr {
  var out: List[x509.Certificate] = []
  for der in tlscert.pem_certs(pem) {
    out.push(parse(der)?)
  }
  Ok(out)
}

/// The parsed certificates and the public ones they came from, each DER
/// once.
struct CertPool {
  parsed: List[lx.Cert]
  certs: List[x509.Certificate]
  seen: Map[Bytes, Bool]
}

fn cert_pool(certs: List[x509.Certificate]) -> CertPool ! x509.CertErr {
  var p = CertPool{parsed: [], certs: [], seen: {}}
  for c in certs {
    p.add(c)?
  }
  Ok(p)
}

fn (var p: CertPool) add(c: x509.Certificate) -> () ! x509.CertErr {
  if p.seen.contains(c.raw) {
    return Ok(())
  }
  p.parsed.push(lcert(c)?)
  p.certs.push(c)
  p.seen.put(c.raw, true)
  Ok(())
}

fn (p: CertPool) certificates() -> List[x509.Certificate] { p.certs }

fn (p: CertPool) len() -> Int { p.certs.len() }

/// A pool's parsed certificates, then those of a list parsed now.
fn parsed_of(pool: CertPool?, list: List[x509.Certificate]) -> List[lx.Cert] ! x509.CertErr {
  var out: List[lx.Cert] = match pool {
    Some(p) => p.parsed
    None => []
  }
  for x in list {
    out.push(lcert(x)?)
  }
  Ok(out)
}

/// The roots verify may use: a pool's, then those of the list whose
/// subject is the issuer of the leaf or of an intermediate, parsed now
/// (Go's lazyCert: a pool finds parents by their raw subject and parses
/// only those). A root ends a chain, so no other root's subject is ever
/// looked up; with 150 roots, verify parsed all 150 per call. A root
/// without its raw subject (a Certificate built by hand) is parsed.
fn roots_of(pool: CertPool?, list: List[x509.Certificate], leaf: lx.Cert, inters: List[lx.Cert]) -> List[lx.Cert] ! x509.CertErr {
  if list.is_empty() {
    return parsed_of(pool, list)
  }
  var wanted: Map[Bytes, Bool] = {}
  wanted[leaf.issuer] = true
  for i in inters {
    wanted[i.issuer] = true
  }
  var out: List[lx.Cert] = match pool {
    Some(p) => p.parsed
    None => []
  }
  for x in list {
    if x.subject.raw.is_empty() || wanted.contains(x.subject.raw) {
      out.push(lcert(x)?)
    }
  }
  Ok(out)
}

fn certificate_verify(c: x509.Certificate, opts: x509.VerifyOptions) -> List[List[x509.Certificate]] ! x509.CertErr {
  let leaf = lcert(c)?
  let inters = parsed_of(rt.cast[x509.CertPool?, CertPool?](opts.intermediate_pool), opts.intermediates)?
  let roots = roots_of(rt.cast[x509.CertPool?, CertPool?](opts.root_pool), opts.roots, leaf, inters)?
  var usages: List[Str] = []
  for u in opts.key_usages {
    usages.push(eku_oid(u))
  }
  if usages.is_empty() {
    usages.push(eku_oid(x509.ExtKeyUsage.ServerAuth))
  }
  let now = opts.at.unix()
  let (r, chains) = xv.verify_all(leaf, inters, roots, opts.dns_name, now, usages)
  if chains.is_empty() {
    let text = xv.full_text(r, leaf, opts.dns_name, now)
    return Err(x509.CertErr{msg: text, kind: verify_kind(r, text, opts.dns_name)})
  }
  var out: List[List[x509.Certificate]] = []
  for ch in chains {
    var one: List[x509.Certificate] = []
    for x in ch {
      one.push(cert_of(x))
    }
    out.push(one)
  }
  Ok(out)
}

fn certificate_verify_hostname(c: x509.Certificate, host: Str) -> () ! x509.CertErr {
  let leaf = lcert(c)?
  if xv.host_ok(leaf, host) {
    return Ok(())
  }
  Err(x509.CertErr{msg: xv.full_text(xv.Outcome{code: 7, chain: [], bad: leaf, hint: ""}, leaf, host, 0), kind: x509.CertErrKind.Hostname(host: hostname_err_host(host))})
}

fn certificate_check_signature_from(c: x509.Certificate, parent: x509.Certificate) -> () ! x509.CertErr {
  let child = lcert(c)?
  let p = lcert(parent)?
  let e = lx.check_from(child, p)
  if e != "" {
    return Err(x509.CertErr{msg: e, kind: signature_kind(e)})
  }
  Ok(())
}

/// Go's error type of a verification's outcome (decision 0643).
fn verify_kind(r: xv.Outcome, text: Str, host: Str) -> x509.CertErrKind {
  let invalid = fn(reason: x509.InvalidReason, detail: Str) -> x509.CertErrKind { x509.CertErrKind.CertificateInvalid(reason: reason, detail: detail) }
  match r.code {
    1 => x509.CertErrKind.UnknownAuthority
    2 => invalid(x509.InvalidReason.Expired, text.cut_prefix("x509: certificate has expired or is not yet valid: ") ?? "")
    3 => invalid(x509.InvalidReason.NotAuthorizedToSign, "")
    4 => invalid(x509.InvalidReason.TooManyIntermediates, "")
    5 => invalid(x509.InvalidReason.CaNotAuthorizedForThisName, r.hint)
    6 => invalid(x509.InvalidReason.IncompatibleUsage, "")
    7 => x509.CertErrKind.Hostname(host: hostname_err_host(host))
    8 => x509.CertErrKind.UnhandledCriticalExtension
    10 => invalid(x509.InvalidReason.NoValidChains, r.hint)
    _ => x509.CertErrKind.Other
  }
}

/// HostnameError.Host: an IP address in brackets without them, else the
/// host as asked (Go's VerifyHostname).
fn hostname_err_host(h: Str) -> Str {
  if h.len() >= 3 && h.starts_with("[") && h.ends_with("]") {
    let inner = h[1..(h.len() - 1)]
    if !inner.contains("%") && netip.parse_addr(inner).is_ok() {
      return inner
    }
  }
  h
}

/// Go's error type of a signature check's text: ConstraintViolationError
/// and InsecureAlgorithmError have fixed texts.
fn signature_kind(e: Str) -> x509.CertErrKind {
  if e == "x509: invalid signature: parent certificate cannot sign this kind of certificate" {
    return x509.CertErrKind.ConstraintViolation
  }
  match e.cut_prefix("x509: cannot verify signature: insecure algorithm ") {
    Some(a) => x509.CertErrKind.InsecureAlgorithm(algorithm: a)
    None => x509.CertErrKind.Other
  }
}

fn system_roots(fs: Fs) -> List[x509.Certificate] ! x509.CertErr uses fs {
  var out: List[x509.Certificate] = []
  for der in tlscert.root_ders() {
    let p = lx.parse(der)
    if p.err == "" {
      out.push(cert_of(p.cert))
    }
  }
  Ok(out)
}

// ---------------------------------------------------------------------------
// Creating certificates (Go's CreateCertificate, buildCertExtensions)

/// The DER of a Name to build: raw when set (Go's RawSubject), else
/// ToRDNSequence's order, one RDN per attribute with every value
/// (encoding/asn1's PrintableString or UTF8String choice).
fn name_der(n: x509.Name) -> Bytes {
  if !n.raw.is_empty() {
    return n.raw
  }
  var rdns: List[Bytes] = []
  for (vs, oid) in [(n.country, "2.5.4.6"), (n.province, "2.5.4.8"), (n.locality, "2.5.4.7"), (n.street_address, "2.5.4.9"), (n.postal_code, "2.5.4.17"), (n.organization, "2.5.4.10"), (n.organizational_unit, "2.5.4.11"), (if n.common_name.is_empty() { [] } else { [n.common_name] }, "2.5.4.3"), (if n.serial_number.is_empty() { [] } else { [n.serial_number] }, "2.5.4.5")] {
    if vs.is_empty() {
      continue
    }
    let o = asn1.enc_oid(oid) ?? b""
    rdns.push(asn1.enc_set_of(vs.map(fn(v) { asn1.enc_seq([o, asn1.enc_string(v)]) })))
  }
  asn1.enc_seq(rdns)
}

fn ext_der(oid: Str, critical: Bool, value: Bytes) -> Bytes ! x509.CertErr {
  let o = match asn1.enc_oid(oid) {
    Some(x) => x
    None => return Err(err("x509: invalid extension OID ${oid.quote()}"))
  }
  Ok(asn1.enc_seq(if critical { [o, asn1.enc_bool(true), asn1.enc_octets(value)] } else { [o, asn1.enc_octets(value)] }))
}

/// Go's isIA5String.
fn ia5_check(s: Str) -> () ! x509.CertErr {
  for x in s.bytes() {
    if Int(x) > 127 {
      return Err(err("x509: ${s.quote()} cannot be encoded as an IA5String"))
    }
  }
  Ok(())
}

/// The algorithm Go signs with for key: (its AlgorithmIdentifier, hash).
fn id(o: Str) -> Bytes { asn1.enc_oid(o) ?? b"" }

fn signing(key: crypto.PrivateKey) -> (Bytes, crypto.Hash) ! x509.CertErr {
  match key.alg() {
    Rsa => Ok((asn1.enc_seq([id("1.2.840.113549.1.1.11"), asn1.enc_null()]), crypto.Hash.Sha256))
    EcdsaP256 => Ok((asn1.enc_seq([id("1.2.840.10045.4.3.2")]), crypto.Hash.Sha256))
    EcdsaP384 => Ok((asn1.enc_seq([id("1.2.840.10045.4.3.3")]), crypto.Hash.Sha384))
    EcdsaP521 => Ok((asn1.enc_seq([id("1.2.840.10045.4.3.4")]), crypto.Hash.Sha512))
    Ed25519 => Ok((asn1.enc_seq([id("1.3.101.112")]), crypto.Hash.Sha512))
    EcdsaP224 => Err(err("x509: unknown elliptic curve"))
  }
}

/// The key bytes inside a SubjectPublicKeyInfo (the BIT STRING's).
fn spki_key(spki: Bytes) -> Bytes {
  let t = asn1.whole(spki, asn1.SEQUENCE)
  let kids = asn1.children(spki, t)
  if kids.len() != 2 || asn1.any_bad(kids) {
    return b""
  }
  asn1.bits(spki, kids[1]) ?? b""
}

fn create_certificate(r: Rand, t: x509.Template, public_key: crypto.PublicKey, parent: x509.Certificate?, key: crypto.PrivateKey) -> x509.Certificate ! x509.CertErr uses rand {
  let serial = if t.serial.is_empty() {
    let b = crypto.random_bytes(r, 20)
    var s = BytesBuilder.with_capacity(20)
    s.write_byte(UInt8(Int(b[0]) & 127))
    s.write(b[1..20])
    s.freeze()
  } else {
    t.serial
  }
  match t.max_path_len {
    Some(n) => {
      if n < -1 {
        return Err(err("x509: invalid MaxPathLen, must be greater or equal to -1"))
      }
      if !t.is_ca && n != -1 {
        return Err(err("x509: only CAs are allowed to specify MaxPathLen"))
      }
    }
    None => ()
  }
  let (alg_id, hash, is_pss) = signing_named(key, t.signature_algorithm)?
  let spki = crypto.marshal_public_key(public_key)
  let key_bytes = spki_key(spki)
  let subject = name_der(t.subject)
  let issuer = match parent {
    Some(p) => p.subject.raw
    None => subject
  }
  var aki = b""
  match parent {
    Some(p) => {
      if issuer != subject && !p.subject_key_id.is_empty() {
        aki = p.subject_key_id
      }
      match p.public_key {
        Some(k) => if k != key.public_key() { return Err(err("x509: provided PrivateKey doesn't match parent's PublicKey")) }
        None => ()
      }
    }
    None => ()
  }
  let ski = if t.subject_key_id.is_empty() && t.is_ca { crypto.sha256(key_bytes)[0..20] } else { t.subject_key_id }
  // buildCertExtensions: each made one unless an extra one has its OID
  let extra = t.extra_extensions.map(fn(e) { e.oid })
  var exts: List[Bytes] = []
  if !t.key_usage.is_empty() && !extra.contains("2.5.29.15") {
    var flags = 0
    for u in t.key_usage {
      flags = flags | (1 << ku_bit(u))
    }
    exts.push(ext_der("2.5.29.15", true, asn1.enc_flag_bits(flags))?)
  }
  if !t.ext_key_usage.is_empty() && !extra.contains("2.5.29.37") {
    var oids: List[Bytes] = []
    for u in t.ext_key_usage {
      match asn1.enc_oid(eku_oid(u)) {
        Some(o) => oids.push(o)
        None => return Err(err("x509: unknown extended key usage"))
      }
    }
    exts.push(ext_der("2.5.29.37", false, asn1.enc_seq(oids))?)
  }
  if (t.is_ca || t.max_path_len.is_some() || t.basic_constraints_valid) && !extra.contains("2.5.29.19") {
    var parts: List[Bytes] = []
    if t.is_ca {
      parts.push(asn1.enc_bool(true))
    }
    match t.max_path_len {
      Some(n) => if n >= 0 { parts.push(asn1.enc_int(n)) }
      None => ()
    }
    exts.push(ext_der("2.5.29.19", true, asn1.enc_seq(parts))?)
  }
  if !ski.is_empty() && !extra.contains("2.5.29.14") {
    exts.push(ext_der("2.5.29.14", false, asn1.enc_octets(ski))?)
  }
  if !aki.is_empty() && !extra.contains("2.5.29.35") {
    exts.push(ext_der("2.5.29.35", false, asn1.enc_seq([asn1.enc_implicit(0, aki)]))?)
  }
  if (!t.ocsp_servers.is_empty() || !t.issuing_certificate_urls.is_empty()) && !extra.contains("1.3.6.1.5.5.7.1.1") {
    var ads: List[Bytes] = []
    for u in t.ocsp_servers {
      ads.push(asn1.enc_seq([id("1.3.6.1.5.5.7.48.1"), asn1.enc_implicit(6, u.bytes())]))
    }
    for u in t.issuing_certificate_urls {
      ads.push(asn1.enc_seq([id("1.3.6.1.5.5.7.48.2"), asn1.enc_implicit(6, u.bytes())]))
    }
    exts.push(ext_der("1.3.6.1.5.5.7.1.1", false, asn1.enc_seq(ads))?)
  }
  let has_san = !t.dns_names.is_empty() || !t.email_addresses.is_empty() || !t.ip_addresses.is_empty() || !t.uris.is_empty()
  if has_san && !extra.contains("2.5.29.17") {
    var names: List[Bytes] = []
    for d in t.dns_names {
      ia5_check(d)?
      names.push(asn1.enc_implicit(2, d.bytes()))
    }
    for e in t.email_addresses {
      ia5_check(e)?
      names.push(asn1.enc_implicit(1, e.bytes()))
    }
    for a in t.ip_addresses {
      names.push(asn1.enc_implicit(7, a.bytes()))
    }
    for u in t.uris {
      ia5_check(u)?
      names.push(asn1.enc_implicit(6, u.bytes()))
    }
    exts.push(ext_der("2.5.29.17", subject == b"\x30\x00", asn1.enc_seq(names))?)
  }
  if !t.policies.is_empty() && !extra.contains("2.5.29.32") {
    var ps: List[Bytes] = []
    for o in t.policies {
      match oid_contents_any(o) {
        Some(d) => ps.push(asn1.enc_seq([asn1.enc(6, d)]))
        None => return Err(err("invalid policy object identifier"))
      }
    }
    exts.push(ext_der("2.5.29.32", false, asn1.enc_seq(ps))?)
  }
  let has_nc = !t.permitted_dns_domains.is_empty() || !t.excluded_dns_domains.is_empty() || !t.permitted_ip_ranges.is_empty() || !t.excluded_ip_ranges.is_empty() || !t.permitted_email_addresses.is_empty() || !t.excluded_email_addresses.is_empty() || !t.permitted_uri_domains.is_empty() || !t.excluded_uri_domains.is_empty()
  if has_nc && !extra.contains("2.5.29.30") {
    let permitted = subtrees(t.permitted_dns_domains, t.permitted_ip_ranges, t.permitted_email_addresses, t.permitted_uri_domains)?
    let excluded = subtrees(t.excluded_dns_domains, t.excluded_ip_ranges, t.excluded_email_addresses, t.excluded_uri_domains)?
    var parts: List[Bytes] = []
    if !permitted.is_empty() {
      parts.push(asn1.enc_implicit_seq(0, permitted))
    }
    if !excluded.is_empty() {
      parts.push(asn1.enc_implicit_seq(1, excluded))
    }
    exts.push(ext_der("2.5.29.30", t.permitted_dns_domains_critical, asn1.enc_seq(parts))?)
  }
  if !t.crl_distribution_points.is_empty() && !extra.contains("2.5.29.31") {
    var dps: List[Bytes] = []
    for u in t.crl_distribution_points {
      dps.push(asn1.enc_seq([asn1.enc_explicit(0, asn1.enc_explicit(0, asn1.enc_implicit(6, u.bytes())))]))
    }
    exts.push(ext_der("2.5.29.31", false, asn1.enc_seq(dps))?)
  }
  for e in t.extra_extensions {
    exts.push(ext_der(e.oid, e.critical, e.value)?)
  }
  var tbs_parts = [asn1.enc_explicit(0, asn1.enc_int(2)), asn1.enc_uint(serial), alg_id, issuer, asn1.enc_seq([asn1.enc_time(t.not_before.unix()), asn1.enc_time(t.not_after.unix())]), subject, spki]
  if !exts.is_empty() {
    tbs_parts.push(asn1.enc_explicit(3, asn1.enc_seq(exts)))
  }
  let tbs = asn1.enc_seq(tbs_parts)
  let signed = if is_pss { crypto.sign_pss(r, key, hash, tbs) } else { crypto.sign(r, key, hash, tbs) }
  let sig = match signed {
    Ok(s) => s
    Err(e) => return Err(err(e.display()))
  }
  let der = asn1.enc_seq([tbs, alg_id, asn1.enc_bits(sig)])
  let c = parse(der)?
  // Go's signTBS checks the signature it made
  let signer = match parent {
    Some(p) => p.public_key
    None => Some(key.public_key())
  }
  match signer {
    Some(k) => if !(if is_pss { crypto.verify_pss(k, hash, tbs, sig) } else { crypto.verify(k, hash, tbs, sig) }) { return Err(err("x509: signature over certificate returned by signer is invalid")) }
    None => ()
  }
  Ok(c)
}

/// Go's serialiseConstraints: each name a GeneralSubtree (a SEQUENCE of
/// one GeneralName), DNS names, then IP ranges (the masked address and
/// the mask), emails, then URI domains.
fn subtrees(dns: List[Str], ips: List[netip.Prefix], emails: List[Str], uris: List[Str]) -> List[Bytes] ! x509.CertErr {
  var out: List[Bytes] = []
  for d in dns {
    ia5_check(d)?
    out.push(asn1.enc_seq([asn1.enc_implicit(2, d.bytes())]))
  }
  for p in ips {
    let a = p.masked().addr.bytes()
    var m = BytesBuilder.with_capacity(a.len())
    for i in 0..a.len() {
      let left = p.len - i * 8
      m.write_byte(UInt8(if left >= 8 { 255 } else if left <= 0 { 0 } else { (255 << (8 - left)) & 255 }))
    }
    out.push(asn1.enc_seq([asn1.enc_implicit(7, a + m.freeze())]))
  }
  for e in emails {
    ia5_check(e)?
    out.push(asn1.enc_seq([asn1.enc_implicit(1, e.bytes())]))
  }
  for u in uris {
    ia5_check(u)?
    out.push(asn1.enc_seq([asn1.enc_implicit(6, u.bytes())]))
  }
  Ok(out)
}

fn ku_bit(u: x509.KeyUsage) -> Int {
  match u {
    DigitalSignature => 0
    ContentCommitment => 1
    KeyEncipherment => 2
    DataEncipherment => 3
    KeyAgreement => 4
    CertSign => 5
    CrlSign => 6
    EncipherOnly => 7
    DecipherOnly => 8
  }
}

fn pem_of(kind: Str, der: Bytes) -> Bytes {
  let headers: Map[Str, Str] = {}
  (crypto.pem_encode(crypto.PemBlock{kind: kind, headers: headers, bytes: der}).ok() ?? "").bytes()
}

fn certificate_pem(c: x509.Certificate) -> Bytes { pem_of("CERTIFICATE", c.raw) }

fn self_signed(r: Rand, hosts: List[Str], now: Time, days: Int = 30) -> (Bytes, Bytes) ! x509.CertErr uses rand {
  let key = match crypto.generate_key(r, crypto.KeyAlg.EcdsaP256) {
    Ok(k) => k
    Err(e) => return Err(err(e.display()))
  }
  var dns: List[Str] = []
  var ips: List[netip.Addr] = []
  for h in hosts {
    match netip.parse_addr(h) {
      Ok(a) => ips.push(a)
      Err(_) => dns.push(h)
    }
  }
  let t = x509.Template{
    subject: x509.Name{organization: ["Xo Development"]},
    not_before: now,
    not_after: Time.from_unix(now.unix() + days * 86400),
    dns_names: dns,
    ip_addresses: ips,
    key_usage: [x509.KeyUsage.DigitalSignature],
    ext_key_usage: [x509.ExtKeyUsage.ServerAuth],
  }
  let c = create_certificate(r, t, key.public_key(), None, key)?
  Ok((certificate_pem(c), pem_of("PRIVATE KEY", crypto.marshal_private_key(key))))
}

// ---------------------------------------------------------------------------
// Revocation lists

fn ext_of(e: lx.Ext) -> x509.Extension { x509.Extension{oid: e.oid, critical: e.critical, value: e.value} }

fn parse_revocation_list(der: Bytes) -> x509.RevocationList ! x509.CertErr {
  let l = lx.parse_crl(der)
  if l.err != "" {
    return Err(err(l.err))
  }
  var revoked: List[x509.RevokedCertificate] = []
  for e in l.entries {
    revoked.push(x509.RevokedCertificate{serial: e.serial, revoked_at: time_of(e.revoked_at), reason: e.reason, extensions: e.extensions.map(fn(x) { ext_of(x) })})
  }
  Ok(x509.RevocationList{
    raw: l.raw,
    signature_algorithm: sig_name_of(l.sig_alg, l.sig_oid),
    issuer: name_of(l.issuer),
    number: l.number,
    this_update: time_of(l.this_update),
    next_update: if l.has_next { Some(time_of(l.next_update)) } else { None },
    revoked: revoked,
    authority_key_id: l.aki,
    extensions: l.extensions.map(fn(x) { ext_of(x) }),
  })
}

/// The signature algorithm named (Go's SignatureAlgorithm.String()) for
/// key, "" for the key's default: its AlgorithmIdentifier, hash and
/// whether it is RSA PSS, or Go's signingParamsForKey error.
fn signing_named(key: crypto.PrivateKey, name: Str) -> (Bytes, crypto.Hash, Bool) ! x509.CertErr {
  if name.is_empty() {
    let (a, h) = signing(key)?
    return Ok((a, h, false))
  }
  let kind = match key.alg() {
    Rsa => "RSA"
    Ed25519 => "Ed25519"
    EcdsaP224 => return Err(err("x509: unknown elliptic curve"))
    _ => "ECDSA"
  }
  let rsa_alg = fn(oid: Str) -> Bytes { asn1.enc_seq([id(oid), asn1.enc_null()]) }
  let pss = fn(hash_oid: Str, salt: Int) -> Bytes {
    let h = asn1.enc_seq([id(hash_oid), asn1.enc_null()])
    asn1.enc_seq([id("1.2.840.113549.1.1.10"), asn1.enc_seq([asn1.enc_explicit(0, h), asn1.enc_explicit(1, asn1.enc_seq([id("1.2.840.113549.1.1.8"), h])), asn1.enc_explicit(2, asn1.enc_int(salt))])])
  }
  // Go's signatureAlgorithmDetails: (key type, identifier, hash, PSS)
  let (want, alg_id, hash, is_pss) = match name {
    "MD2-RSA" => ("RSA", rsa_alg("1.2.840.113549.1.1.2"), crypto.Hash.Md5, false)
    "MD5-RSA" => ("RSA", rsa_alg("1.2.840.113549.1.1.4"), crypto.Hash.Md5, false)
    "SHA1-RSA" => ("RSA", rsa_alg("1.2.840.113549.1.1.5"), crypto.Hash.Sha1, false)
    "SHA256-RSA" => ("RSA", rsa_alg("1.2.840.113549.1.1.11"), crypto.Hash.Sha256, false)
    "SHA384-RSA" => ("RSA", rsa_alg("1.2.840.113549.1.1.12"), crypto.Hash.Sha384, false)
    "SHA512-RSA" => ("RSA", rsa_alg("1.2.840.113549.1.1.13"), crypto.Hash.Sha512, false)
    "SHA256-RSAPSS" => ("RSA", pss("2.16.840.1.101.3.4.2.1", 32), crypto.Hash.Sha256, true)
    "SHA384-RSAPSS" => ("RSA", pss("2.16.840.1.101.3.4.2.2", 48), crypto.Hash.Sha384, true)
    "SHA512-RSAPSS" => ("RSA", pss("2.16.840.1.101.3.4.2.3", 64), crypto.Hash.Sha512, true)
    "DSA-SHA1" => ("DSA", b"", crypto.Hash.Sha1, false)
    "DSA-SHA256" => ("DSA", b"", crypto.Hash.Sha256, false)
    "ECDSA-SHA1" => ("ECDSA", asn1.enc_seq([id("1.2.840.10045.4.1")]), crypto.Hash.Sha1, false)
    "ECDSA-SHA256" => ("ECDSA", asn1.enc_seq([id("1.2.840.10045.4.3.2")]), crypto.Hash.Sha256, false)
    "ECDSA-SHA384" => ("ECDSA", asn1.enc_seq([id("1.2.840.10045.4.3.3")]), crypto.Hash.Sha384, false)
    "ECDSA-SHA512" => ("ECDSA", asn1.enc_seq([id("1.2.840.10045.4.3.4")]), crypto.Hash.Sha512, false)
    "Ed25519" => ("Ed25519", asn1.enc_seq([id("1.3.101.112")]), crypto.Hash.Sha512, false)
    _ => return Err(err("x509: unknown SignatureAlgorithm"))
  }
  if want != kind {
    return Err(err("x509: requested SignatureAlgorithm does not match private key type"))
  }
  if name == "MD5-RSA" {
    return Err(err("x509: signing with MD5 is not supported"))
  }
  if name == "MD2-RSA" {
    return Err(err("crypto: requested hash function #0 is unavailable"))
  }
  Ok((alg_id, hash, is_pss))
}

fn create_revocation_list(r: Rand, t: x509.RevocationListTemplate, issuer: x509.Certificate, key: crypto.PrivateKey) -> x509.RevocationList ! x509.CertErr uses rand {
  if !issuer.key_usage.contains(x509.KeyUsage.CrlSign) {
    return Err(err("x509: issuer must have the crlSign key usage bit set"))
  }
  if issuer.subject_key_id.is_empty() {
    return Err(err("x509: issuer certificate doesn't contain a subject key identifier"))
  }
  if t.next_update.unix_nanos() < t.this_update.unix_nanos() {
    return Err(err("x509: template.ThisUpdate is after template.NextUpdate"))
  }
  let (alg_id, hash, is_pss) = signing_named(key, t.signature_algorithm)?
  var entries: List[Bytes] = []
  for e in t.revoked {
    var exts: List[Bytes] = []
    for x in e.extensions {
      if x.oid == "2.5.29.21" {
        return Err(err("x509: template contains entry with ReasonCode ExtraExtension; use ReasonCode field instead"))
      }
      exts.push(ext_der(x.oid, x.critical, x.value)?)
    }
    if e.reason != 0 {
      exts.push(ext_der("2.5.29.21", false, enum_der(e.reason))?)
    }
    var parts = [asn1.enc_uint(e.serial), asn1.enc_time(e.revoked_at.unix())]
    if !exts.is_empty() {
      parts.push(asn1.enc_seq(exts))
    }
    entries.push(asn1.enc_seq(parts))
  }
  // Go's Number.Bytes(): the magnitude without leading zeros
  var a = 0
  while a < t.number.len() && t.number[a] == 0 {
    a += 1
  }
  let num = t.number[a..t.number.len()]
  if num.len() > 20 || (num.len() == 20 && Int(num[0]) >= 128) {
    return Err(err("x509: CRL number exceeds 20 octets"))
  }
  let issuer_name = if issuer.subject.raw.is_empty() { name_der(issuer.subject) } else { issuer.subject.raw }
  var exts = [ext_der("2.5.29.35", false, asn1.enc_seq([asn1.enc_implicit(0, issuer.subject_key_id)]))?, ext_der("2.5.29.20", false, asn1.enc_uint(num))?]
  for e in t.extra_extensions {
    exts.push(ext_der(e.oid, e.critical, e.value)?)
  }
  var tbs_parts = [asn1.enc_int(1), alg_id, issuer_name, asn1.enc_time(t.this_update.unix()), asn1.enc_time(t.next_update.unix())]
  if !entries.is_empty() {
    tbs_parts.push(asn1.enc_seq(entries))
  }
  tbs_parts.push(asn1.enc_explicit(0, asn1.enc_seq(exts)))
  let tbs = asn1.enc_seq(tbs_parts)
  let signed = if is_pss { crypto.sign_pss(r, key, hash, tbs) } else { crypto.sign(r, key, hash, tbs) }
  let sig = match signed {
    Ok(x) => x
    Err(e) => return Err(err(e.display()))
  }
  let ok = if is_pss { crypto.verify_pss(key.public_key(), hash, tbs, sig) } else { crypto.verify(key.public_key(), hash, tbs, sig) }
  if !ok {
    return Err(err("x509: signature returned by signer is invalid"))
  }
  parse_revocation_list(asn1.enc_seq([tbs, alg_id, asn1.enc_bits(sig)]))
}

/// An ASN.1 ENUMERATED of n (Go's asn1.Enumerated; a reasonCode).
fn enum_der(n: Int) -> Bytes {
  let i = asn1.enc_int(n)
  // INTEGER and ENUMERATED share their content octets
  b"\x0a" + i[1..i.len()]
}

fn revocationlist_check_signature_from(l: x509.RevocationList, issuer: x509.Certificate) -> () ! x509.CertErr {
  let p = lcert(issuer)?
  let e = lx.crl_check_from(lx.parse_crl(l.raw), p)
  if e != "" {
    return Err(x509.CertErr{msg: e, kind: signature_kind(e)})
  }
  Ok(())
}

// ---------------------------------------------------------------------------
// Certificate requests

fn request_of(c: lx.Cert) -> x509.CertificateRequest {
  var ips: List[netip.Addr] = []
  for b in c.ips {
    if let Some(a) = netip.addr_from_bytes(b) {
      ips.push(a)
    }
  }
  x509.CertificateRequest{
    raw: c.raw,
    version: c.version,
    signature_algorithm: sig_name(c),
    subject: name_of(c.subject),
    public_key: crypto.parse_public_key(c.spki).ok(),
    dns_names: c.dns,
    ip_addresses: ips,
    email_addresses: c.emails,
    uris: c.uris,
    extensions: c.extensions.map(fn(x) { ext_of(x) }),
  }
}

fn parse_request(der: Bytes) -> x509.CertificateRequest ! x509.CertErr {
  let q = lx.parse_csr(der)
  if q.err != "" {
    return Err(err(q.err))
  }
  Ok(request_of(q.cert))
}

fn certificaterequest_check_signature(q: x509.CertificateRequest) -> () ! x509.CertErr {
  let p = lx.parse_csr(q.raw)
  if p.err != "" {
    return Err(err(p.err))
  }
  let e = lx.csr_check(p.cert)
  if e != "" {
    return Err(err(e))
  }
  Ok(())
}

fn certificaterequest_pem(q: x509.CertificateRequest) -> Bytes { pem_of("CERTIFICATE REQUEST", q.raw) }

/// The SAN extension's value of the names (Go's marshalSANs).
fn sans(dns: List[Str], emails: List[Str], ips: List[netip.Addr], uris: List[Str]) -> Bytes ! x509.CertErr {
  var names: List[Bytes] = []
  for d in dns {
    ia5_check(d)?
    names.push(asn1.enc_implicit(2, d.bytes()))
  }
  for e in emails {
    ia5_check(e)?
    names.push(asn1.enc_implicit(1, e.bytes()))
  }
  for a in ips {
    names.push(asn1.enc_implicit(7, a.bytes()))
  }
  for u in uris {
    ia5_check(u)?
    names.push(asn1.enc_implicit(6, u.bytes()))
  }
  Ok(asn1.enc_seq(names))
}

fn create_request(r: Rand, t: x509.RequestTemplate, key: crypto.PrivateKey) -> x509.CertificateRequest ! x509.CertErr uses rand {
  let (alg_id, hash) = signing(key)?
  var exts: List[Bytes] = []
  let has_san = !t.dns_names.is_empty() || !t.email_addresses.is_empty() || !t.ip_addresses.is_empty() || !t.uris.is_empty()
  if has_san && !t.extra_extensions.any(fn(e) { e.oid == "2.5.29.17" }) {
    exts.push(ext_der("2.5.29.17", false, sans(t.dns_names, t.email_addresses, t.ip_addresses, t.uris)?)?)
  }
  for e in t.extra_extensions {
    exts.push(ext_der(e.oid, e.critical, e.value)?)
  }
  // the attributes: the extension request when there are extensions
  let attrs = if exts.is_empty() { b"" } else { asn1.enc_seq([asn1.enc_oid("1.2.840.113549.1.9.14") ?? b"", asn1.enc_set_of([asn1.enc_seq(exts)])]) }
  let tbs = asn1.enc_seq([asn1.enc_int(0), name_der(t.subject), crypto.marshal_public_key(key.public_key()), asn1.enc(0xa0, attrs)])
  let sig = match crypto.sign(r, key, hash, tbs) {
    Ok(s) => s
    Err(e) => return Err(err(e.display()))
  }
  if !crypto.verify(key.public_key(), hash, tbs, sig) {
    return Err(err("x509: signature over certificate returned by signer is invalid"))
  }
  parse_request(asn1.enc_seq([tbs, alg_id, asn1.enc_bits(sig)]))
}

fn parse_pkcs12(data: Bytes, password: Str) -> x509.Pkcs12 ! x509.CertErr {
  let p = pkcs12.parse(data, password)
  if p.err != "" {
    return Err(x509.CertErr{msg: p.err})
  }
  let key = match crypto.parse_private_key(p.key) {
    Ok(k) => k
    Err(e) => return Err(x509.CertErr{msg: "pkcs12: error parsing PKCS#8 private key: ${e.msg}"})
  }
  var certs: List[x509.Certificate] = []
  var leaf = 0
  for (i, der) in p.certs.indexed() {
    certs.push(parse(der)?)
    if p.key_id.len() > 0 && p.cert_ids[i] == p.key_id && leaf == 0 {
      leaf = i
    }
  }
  var ca: List[x509.Certificate] = []
  for (i, c) in certs.indexed() {
    if i != leaf {
      ca.push(c)
    }
  }
  Ok(x509.Pkcs12{key: key, certificate: certs[leaf], ca: ca})
}

// ---------------------------------------------------------------------------
// OIDs with arcs of any size (Go's OID type, which Policies and
// PolicyMappings use; asn1.ObjectIdentifier's arcs are ints)

/// A decimal number's digits, least significant first, without leading
/// zeros ([] is zero).
fn dec_of(s: Str) -> List[Int]? {
  if s.is_empty() {
    return None
  }
  var d: List[Int] = []
  let b = s.bytes()
  var i = b.len() - 1
  while i >= 0 {
    let v = Int(b[i]) - 48
    if v < 0 || v > 9 {
      return None
    }
    d.push(v)
    i -= 1
  }
  Some(dec_trim(d))
}

fn dec_trim(d: List[Int]) -> List[Int] {
  var n = d.len()
  while n > 0 && d[n - 1] == 0 {
    n -= 1
  }
  d[0..n]
}

/// d * m + a, for small m and a.
fn dec_mul_add(d: List[Int], m: Int, a: Int) -> List[Int] {
  var out: List[Int] = []
  var carry = a
  for x in d {
    let v = x * m + carry
    out.push(v % 10)
    carry = v / 10
  }
  while carry > 0 {
    out.push(carry % 10)
    carry = carry / 10
  }
  dec_trim(out)
}

/// d / m and d % m, for small m.
fn dec_divmod(d: List[Int], m: Int) -> (List[Int], Int) {
  var q: List[Int] = d.map(fn(_) { 0 })
  var r = 0
  var i = d.len() - 1
  while i >= 0 {
    let v = r * 10 + d[i]
    q[i] = v / m
    r = v % m
    i -= 1
  }
  (dec_trim(q), r)
}

/// d's value when it is under limit, else None.
fn dec_small(d: List[Int], limit: Int) -> Int? {
  if d.len() > 18 {
    return None
  }
  var v = 0
  var i = d.len() - 1
  while i >= 0 {
    v = v * 10 + d[i]
    i -= 1
  }
  if v < limit { Some(v) } else { None }
}

fn dec_text(d: List[Int]) -> Str {
  if d.is_empty() {
    return "0"
  }
  var b = BytesBuilder.with_capacity(d.len())
  var i = d.len() - 1
  while i >= 0 {
    b.write_byte(UInt8(48 + d[i]))
    i -= 1
  }
  b.freeze().to_str() ?? "0"
}

/// Go's appendBase128BigInt.
fn dec_base128(var out: BytesBuilder, d: List[Int]) {
  var groups: List[Int] = []
  var x = d
  while !x.is_empty() {
    let (q, r) = dec_divmod(x, 128)
    groups.push(r)
    x = q
  }
  if groups.is_empty() {
    groups.push(0)
  }
  var i = groups.len() - 1
  while i >= 0 {
    out.write_byte(UInt8(if i > 0 { groups[i] | 128 } else { groups[i] }))
    i -= 1
  }
}

/// Go's ParseOID: the OBJECT IDENTIFIER contents of dotted, arcs of any
/// size; None where Go's errInvalidOID is.
fn oid_contents_any(dotted: Str) -> Bytes? {
  let ps = dotted.split(".")
  if ps.len() < 2 {
    return None
  }
  var arcs: List[List[Int]] = []
  for p in ps {
    arcs.push(dec_of(p)?)
  }
  let first = dec_small(arcs[0], 3)?
  if first < 2 {
    dec_small(arcs[1], 40)?
  }
  var b = BytesBuilder.with_capacity(ps.len() * 2)
  dec_base128(b, dec_mul_add(arcs[1], 1, first * 40))
  for a in arcs[2..arcs.len()] {
    dec_base128(b, a)
  }
  Some(b.freeze())
}

/// Go's OID.String of OBJECT IDENTIFIER contents, arcs of any size; ""
/// for contents that are not one (a parse has checked them).
fn oid_text_any(c: Bytes) -> Str {
  var parts: List[Str] = []
  var d: List[Int] = []
  var first = true
  var open = false
  for x in c {
    if !open && Int(x) == 128 {
      return ""
    }
    d = dec_mul_add(d, 128, Int(x) & 127)
    open = Int(x) >= 128
    if !open {
      if first {
        match dec_small(d, 80) {
          Some(v) => {
            parts.push("${v / 40}")
            parts.push("${v % 40}")
          }
          None => {
            // 2 and the rest: d - 80
            var rest = d
            var borrow = 80
            var k = 0
            while borrow > 0 {
              let v = rest[k] - (borrow % 10)
              borrow = borrow / 10
              if v < 0 {
                rest[k] = v + 10
                borrow += 1
              } else {
                rest[k] = v
              }
              k += 1
            }
            parts.push("2")
            parts.push(dec_text(dec_trim(rest)))
          }
        }
        first = false
      } else {
        parts.push(dec_text(d))
      }
      d = []
    }
  }
  if open || parts.is_empty() {
    return ""
  }
  parts.join(".")
}

// ---------------------------------------------------------------------------
// The Oid type (Go's x509.OID)

fn oid_err() -> x509.CertErr { err("invalid oid") }

/// newOIDFromDER's check: not empty, no arc starting with 0x80, the last
/// byte ending an arc. The empty Oid (Go's zero OID) is let through by
/// the methods.
fn oid_der_ok(der: Bytes) -> Bool {
  if der.is_empty() || Int(der[der.len() - 1]) >= 128 {
    return false
  }
  var start = true
  for b in der {
    if start && Int(b) == 128 {
      return false
    }
    start = Int(b) < 128
  }
  true
}

fn parse_oid(s: Str) -> x509.Oid ! x509.CertErr {
  match oid_contents_any(s) {
    Some(d) => Ok(x509.Oid{der: d})
    None => Err(oid_err())
  }
}

fn oid_from_ints(arcs: List[UInt64]) -> x509.Oid ! x509.CertErr {
  if arcs.len() < 2 {
    return Err(oid_err())
  }
  // Go computes the first value, 40 times the first arc plus the second,
  // in a uint64: a second arc within 80 of 2^64 wraps it to under 80,
  // which reads back as other first two arcs
  let edge = UInt64.from_bits(-80)
  if arcs[0] == UInt64(2) && arcs[1] >= edge {
    let v = Int(arcs[1] - edge)
    var rest = ["${v / 40}", "${v % 40}"]
    for a in arcs[2..arcs.len()] {
      rest.push("${a}")
    }
    return parse_oid(rest.join("."))
  }
  parse_oid(arcs.map(fn(a) { "${a}" }).join("."))
}

fn oid_from_asn1_oid(arcs: List[Int]) -> x509.Oid ! x509.CertErr {
  for a in arcs {
    if a < 0 {
      return Err(err("x509: OID components must be non-negative"))
    }
  }
  if arcs.len() < 2 {
    return Err(oid_err())
  }
  parse_oid(arcs.map(fn(a) { "${a}" }).join("."))
}

fn oid_from_binary(der: Bytes) -> x509.Oid ! x509.CertErr {
  if !oid_der_ok(der) {
    return Err(oid_err())
  }
  Ok(x509.Oid{der: der})
}

fn oid_display(o: x509.Oid) -> Str {
  if !oid_der_ok(o.der) {
    return ""
  }
  oid_text_any(o.der)
}

/// Go's parseBase128Int: a value of at most 31 bits, minimally encoded.
fn oid_base128(der: Bytes, i0: Int) -> (Int, Int)? {
  var v = 0
  var i = i0
  var shifted = 0
  while i < der.len() {
    if shifted == 5 {
      return None
    }
    let b = Int(der[i])
    if shifted == 0 && b == 128 {
      return None
    }
    v = (v << 7) | (b & 127)
    i += 1
    if b < 128 {
      if v > 2147483647 {
        return None
      }
      return Some((v, i))
    }
    shifted += 1
  }
  None
}

fn oid_equal_asn1_oid(o: x509.Oid, arcs: List[Int]) -> Bool {
  if arcs.len() < 2 || !oid_der_ok(o.der) {
    return false
  }
  let (v, off) = match oid_base128(o.der, 0) {
    Some(x) => x
    None => return false
  }
  let (a, b) = if v < 80 { (v / 40, v % 40) } else { (2, v - 80) }
  if arcs[0] != a || arcs[1] != b {
    return false
  }
  var i = 2
  var at = off
  while at < o.der.len() {
    let (w, nx) = match oid_base128(o.der, at) {
      Some(x) => x
      None => return false
    }
    if i >= arcs.len() || w != arcs[i] {
      return false
    }
    at = nx
    i += 1
  }
  i == arcs.len()
}

/// Go's toASN1OID, line for line.
fn oid_to_asn1_oid(o: x509.Oid) -> List[Int]? {
  if !o.der.is_empty() && !oid_der_ok(o.der) {
    return None
  }
  var out: List[Int] = []
  var val = 0
  for b in o.der {
    if val > 16777215 {
      return None
    }
    val = (val << 7) | (Int(b) & 127)
    if Int(b) < 128 {
      if out.is_empty() {
        if val < 80 {
          out.push(val / 40)
          out.push(val % 40)
        } else {
          out.push(2)
          out.push(val - 80)
        }
      } else {
        out.push(val)
      }
      val = 0
    }
  }
  Some(out)
}
