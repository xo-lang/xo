// std/cbor on the native backends and, through std/go_compiled.txt, on the
// Go backend (decision 0312): one source for RFC 8949 CBOR. The decoder
// reads a whole buffer into a Value tree (definite and indefinite lengths,
// limits checked before anything is allocated from a length), the encoder
// writes the preferred serialization (shortest heads, shortest float) with
// an optional deterministic map order, and the diagnostic notation and
// the JSON bridge follow sections 8 and 6.
use std/base32
use std/base64
use std/big
use std/binary
use std/cbor
use std/json

// ---------------------------------------------------------------------------
// Errors

fn cborerr_display(e: cbor.CborErr) -> Str {
  match e {
    cbor.CborErr.Truncated => "cbor: unexpected EOF"
    cbor.CborErr.Syntax(m) => "cbor: " + m
    cbor.CborErr.Invalid(m) => "cbor: " + m
    cbor.CborErr.Limit(m) => "cbor: " + m
    cbor.CborErr.Type(m) => "cbor: " + m
  }
}

fn syntax(msg: Str) -> cbor.CborErr { cbor.CborErr.Syntax(msg: msg) }

fn invalid(msg: Str) -> cbor.CborErr { cbor.CborErr.Invalid(msg: msg) }

fn limit(msg: Str) -> cbor.CborErr { cbor.CborErr.Limit(msg: msg) }

// ---------------------------------------------------------------------------
// Helpers on the model

fn from_int(n: Int) -> cbor.Value {
  if n >= 0 {
    cbor.Value.Uint(n: UInt64.from_bits(n))
  } else {
    // -1 - n, as the bit pattern of the unsigned magnitude
    cbor.Value.Nint(n: UInt64.from_bits(-1 - n))
  }
}

fn value_to_int(v: cbor.Value) -> Int? {
  match v {
    cbor.Value.Uint(n) => {
      let b = n.to_bits()
      if b < 0 { None } else { Some(b) }
    }
    cbor.Value.Nint(n) => {
      let b = n.to_bits()
      if b < 0 { None } else { Some(-1 - b) }
    }
    _ => None
  }
}

fn from_big(n: big.BigInt, convert: cbor.BigConvert) -> cbor.Value ! cbor.CborErr {
  if convert is cbor.BigConvert.Reject {
    return Err(cbor.CborErr.Type(msg: "unsupported type: big.Int"))
  }
  // a negative n is written as -1 - m, m = -n - 1 (RFC 8949 3.1)
  let neg = n.sign() < 0
  let m = if neg { n.neg().sub(big.from_int(1)) } else { n }
  if convert is cbor.BigConvert.Shortest && m.bit_len() <= 64 {
    // the magnitude as 8 big endian bytes, read as the head's 64 bits
    var pad = BytesBuilder.new()
    let b = m.bytes()
    for _ in 0..8 - b.len() {
      pad.write_byte(UInt8(0))
    }
    pad.write(b)
    let x = binary.get_u64_be(pad.freeze(), 0)
    return Ok(if neg { cbor.Value.Nint(n: UInt64.from_bits(x)) } else { cbor.Value.Uint(n: UInt64.from_bits(x)) })
  }
  Ok(cbor.Value.Tag(num: UInt64.from_bits(if neg { 3 } else { 2 }), v: cbor.Value.ByteString(b: m.bytes())))
}

fn value_to_big(v: cbor.Value) -> big.BigInt? {
  match v {
    cbor.Value.Uint(n) => Some(big.from_bytes(be8(n)))
    cbor.Value.Nint(n) => Some(big.from_int(-1).sub(big.from_bytes(be8(n))))
    cbor.Value.Tag(t, inner) => {
      match inner {
        cbor.Value.ByteString(b) => {
          if t.to_bits() == 2 {
            Some(big.from_bytes(b))
          } else if t.to_bits() == 3 {
            Some(big.from_int(-1).sub(big.from_bytes(b)))
          } else {
            None
          }
        }
        _ => None
      }
    }
    _ => None
  }
}

fn from_time_as(t: Time, format: cbor.TimeFormat, tag: Bool) -> cbor.Value {
  let v = match format {
    cbor.TimeFormat.Unix => from_int(t.unix())
    cbor.TimeFormat.UnixMicro => cbor.Value.Float(f: Float(t.unix_micros()) / 1000000.0)
    cbor.TimeFormat.UnixDynamic => if t.nanosecond() == 0 { from_int(t.unix()) } else { cbor.Value.Float(f: Float(t.unix_nanos()) / 1000000000.0) }
    cbor.TimeFormat.Rfc3339 => cbor.Value.TextString(s: Time.from_unix(t.unix()).format_rfc3339())
    cbor.TimeFormat.Rfc3339Nano => cbor.Value.TextString(s: t.format_rfc3339())
  }
  if !tag {
    return v
  }
  cbor.Value.Tag(num: UInt64.from_bits(if v is cbor.Value.TextString(_) { 0 } else { 1 }), v: v)
}

fn time_type_err(what: Str) -> cbor.CborErr {
  cbor.CborErr.Type(msg: "cannot unmarshal ${what} into Go value of type time.Time")
}

fn value_to_time(v0: cbor.Value, rule: cbor.TagRule, bytes: Bool) -> Time ! cbor.CborErr {
  var v = v0
  match v0 {
    cbor.Value.Tag(t, inner) => {
      if rule is cbor.TagRule.Ignored {
        v = strip_tags(v0)
      } else {
        if t.to_bits() != 0 && t.to_bits() != 1 {
          return Err(cbor.CborErr.Type(msg: "wrong tag number for time.Time, got ${t.to_bits()}, expect 0 or 1"))
        }
        v = inner
      }
    }
    _ => if rule is cbor.TagRule.Required {
      return Err(cbor.CborErr.Type(msg: "cannot unmarshal ${kind_name(v0)} into Go value of type time.Time (expect CBOR tag value)"))
    }
  }
  match v {
    cbor.Value.Null | cbor.Value.Undefined => Ok(Time.UNIX_EPOCH)
    cbor.Value.TextString(s) => match Time.parse_rfc3339(s) {
      Some(t) => Ok(t)
      None => Err(cbor.CborErr.Type(msg: "cannot set ${s} for time.Time"))
    }
    cbor.Value.ByteString(b) => {
      if !bytes {
        return Err(time_type_err("byte string"))
      }
      let s = b.to_str_lossy()
      match Time.parse_rfc3339(s) {
        Some(t) => Ok(t)
        None => Err(cbor.CborErr.Type(msg: "cannot set ${s.quote()} for time.Time"))
      }
    }
    cbor.Value.Float(f) => {
      if f.is_nan() || f.is_inf() {
        return Ok(Time.UNIX_EPOCH)
      }
      if f > -9.0e9 && f < 9.0e9 {
        let s = f.floor()
        return Ok(Time.from_unix_nanos(Int(s) * 1000000000 + Int(((f - s) * 1.0e9).round())))
      }
      Err(time_type_err("float"))
    }
    _ => match value_to_int(v) {
      Some(n) => if n > -9000000000 && n < 9000000000 { Ok(Time.from_unix(n)) } else { Err(time_type_err("integer")) }
      None => Err(time_type_err(kind_name(v)))
    }
  }
}

fn value_get(v: cbor.Value, key: Str) -> cbor.Value? {
  match v {
    cbor.Value.Map(pairs) => {
      var found: cbor.Value? = None
      for p in pairs {
        match p.0 {
          cbor.Value.TextString(s) => {
            if s == key {
              found = Some(p.1)
            }
          }
          _ => {}
        }
      }
      found
    }
    _ => None
  }
}

// ---------------------------------------------------------------------------
// Encoder

fn put_be(var out: BytesBuilder, v: Int, n: Int) {
  var i = n - 1
  while i >= 0 {
    out.write_byte(UInt8((v >> (8 * i)) & 255))
    i -= 1
  }
}

/// A head: the major type and its argument n (a 64 bit pattern).
fn put_head(var out: BytesBuilder, major: Int, n: Int) {
  let m = major << 5
  if n < 0 {
    out.write_byte(UInt8(m | 27))
    put_be(out, n, 8)
  } else if n < 24 {
    out.write_byte(UInt8(m | n))
  } else if n < 256 {
    out.write_byte(UInt8(m | 24))
    out.write_byte(UInt8(n))
  } else if n < 65536 {
    out.write_byte(UInt8(m | 25))
    put_be(out, n, 2)
  } else if n < 4294967296 {
    out.write_byte(UInt8(m | 26))
    put_be(out, n, 4)
  } else {
    out.write_byte(UInt8(m | 27))
    put_be(out, n, 8)
  }
}

/// The shortest float (half, single, double) that holds f, as
/// (bytes in the argument, bits).
fn float_shortest(f: Float) -> (Int, Int) {
  let bits = f.to_bits()
  let sign = (bits >> 63) & 1
  let exp = (bits >> 52) & 2047
  let mant = bits & 4503599627370495
  if exp == 2047 {
    if mant != 0 {
      return (2, 32256)
    }
    return (2, (sign << 15) | 31744)
  }
  if exp == 0 && mant == 0 {
    return (2, sign << 15)
  }
  let e = exp - 1023
  if exp != 0 {
    if e >= -14 && e <= 15 && (mant & 4398046511103) == 0 {
      return (2, (sign << 15) | ((e + 15) << 10) | (mant >> 42))
    }
    if e >= -24 && e < -14 {
      let full = 4503599627370496 | mant
      let shift = 28 - e
      if (full & ((1 << shift) - 1)) == 0 {
        return (2, (sign << 15) | (full >> shift))
      }
    }
    if e >= -126 && e <= 127 && (mant & 536870911) == 0 {
      return (4, (sign << 31) | ((e + 127) << 23) | (mant >> 29))
    }
    if e >= -149 && e < -126 {
      let full = 4503599627370496 | mant
      let shift = -97 - e
      if (full & ((1 << shift) - 1)) == 0 {
        return (4, (sign << 31) | (full >> shift))
      }
    }
  }
  (8, bits)
}

fn put_float(var out: BytesBuilder, f: Float) {
  let (n, bits) = float_shortest(f)
  if n == 2 {
    out.write_byte(UInt8(249))
  } else if n == 4 {
    out.write_byte(UInt8(250))
  } else {
    out.write_byte(UInt8(251))
  }
  put_be(out, bits, n)
}

fn enc_item(v: cbor.Value, ord: Int, depth: Int, var out: BytesBuilder) -> () ! cbor.CborErr {
  let det = ord != 0
  if depth > 1000 {
    return Err(limit("value nested deeper than 1000 levels"))
  }
  match v {
    cbor.Value.Uint(n) => put_head(out, 0, n.to_bits())
    cbor.Value.Nint(n) => put_head(out, 1, n.to_bits())
    cbor.Value.ByteString(b) => {
      put_head(out, 2, b.len())
      out.write(b)
    }
    cbor.Value.TextString(s) => {
      put_head(out, 3, s.len())
      out.write_str(s)
    }
    cbor.Value.Array(items) => {
      put_head(out, 4, items.len())
      for it in items {
        enc_item(it, ord, depth + 1, out)?
      }
    }
    cbor.Value.Map(pairs) => {
      put_head(out, 5, pairs.len())
      let direct = ord == 1 && pairs.len() > 1 && direct_keys(pairs)
      let sorted = direct && keys_sorted(pairs)
      if sorted || (direct && pairs.len() <= 16) {
        // text and unsigned keys order without encoding them (key_less);
        // a derived struct's map is a handful of them
        if sorted {
          for p in pairs {
            enc_item(p.0, ord, depth + 1, out)?
            enc_item(p.1, ord, depth + 1, out)?
          }
        } else {
          for i in key_order(pairs) {
            enc_item(pairs[i].0, ord, depth + 1, out)?
            enc_item(pairs[i].1, ord, depth + 1, out)?
          }
        }
      } else if det {
        var keys: List[Bytes] = []
        var hexes: List[Str] = []
        for p in pairs {
          var kb = BytesBuilder.new()
          enc_item(p.0, ord, depth + 1, kb)?
          let b = kb.freeze()
          keys.push(b)
          hexes.push(b.to_hex())
        }
        var idx: List[Int] = []
        for i in 0..pairs.len() {
          idx.push(i)
        }
        // LengthFirst (ord 2): the encoded length first, as RFC 7049 3.9
        let order = if ord == 2 { idx.sort_by(fn(i) { "${keys[i].len()}".pad_left(20, "0") + hexes[i] }) } else { idx.sort_by(fn(i) { hexes[i] }) }
        for i in order {
          out.write(keys[i])
          enc_item(pairs[i].1, ord, depth + 1, out)?
        }
      } else {
        for p in pairs {
          enc_item(p.0, ord, depth + 1, out)?
          enc_item(p.1, ord, depth + 1, out)?
        }
      }
    }
    cbor.Value.Tag(num, inner) => {
      put_head(out, 6, num.to_bits())
      enc_item(inner, ord, depth + 1, out)?
    }
    cbor.Value.Simple(n) => {
      if n >= 0 && n < 20 {
        out.write_byte(UInt8(224 | n))
      } else if n >= 32 && n < 256 {
        out.write_byte(UInt8(248))
        out.write_byte(UInt8(n))
      } else {
        return Err(invalid("simple value ${n} cannot be encoded"))
      }
    }
    cbor.Value.Bool(b) => out.write_byte(UInt8(if b { 245 } else { 244 }))
    cbor.Value.Null => out.write_byte(UInt8(246))
    cbor.Value.Undefined => out.write_byte(UInt8(247))
    cbor.Value.Float(f) => put_float(out, f)
  }
}

/// Whether every key of pairs is a text string or an unsigned integer,
/// which key_less orders as their encodings; any other map takes the
/// encoding sort.
fn direct_keys(pairs: List[(cbor.Value, cbor.Value)]) -> Bool {
  for p in pairs {
    if !(p.0 is cbor.Value.TextString(_) | cbor.Value.Uint(_)) {
      return false
    }
  }
  true
}

/// Whether key a's encoding sorts before b's (RFC 8949 4.2.1, bytewise):
/// an unsigned integer (major 0) before any text (major 3), integers by
/// value and text by length, then by bytes, since a longer argument
/// encodes a greater head.
fn key_less(a: cbor.Value, b: cbor.Value) -> Bool {
  match a {
    cbor.Value.Uint(x) => {
      if let cbor.Value.Uint(y) = b { x < y } else { true }
    }
    cbor.Value.TextString(s) => {
      if let cbor.Value.TextString(t) = b {
        s.len() < t.len() || (s.len() == t.len() && s < t)
      } else {
        false
      }
    }
    _ => false
  }
}

fn keys_sorted(pairs: List[(cbor.Value, cbor.Value)]) -> Bool {
  for i in 1..pairs.len() {
    if !key_less(pairs[i - 1].0, pairs[i].0) {
      return false
    }
  }
  true
}

/// The indexes of pairs (16 or fewer) in key order, by insertion, which
/// keeps equal keys in their order as the encoding sort does.
fn key_order(pairs: List[(cbor.Value, cbor.Value)]) -> List[Int] {
  var idx = List[Int].with_capacity(pairs.len())
  for i in 0..pairs.len() {
    idx.push(i)
  }
  for i in 1..idx.len() {
    let x = idx[i]
    var j = i
    while j > 0 && key_less(pairs[x].0, pairs[idx[j - 1]].0) {
      idx[j] = idx[j - 1]
      j -= 1
    }
    idx[j] = x
  }
  idx
}

fn encode(v: cbor.Value, deterministic: Bool) -> Bytes ! cbor.CborErr {
  var out = BytesBuilder.new()
  enc_item(v, if deterministic { 1 } else { 0 }, 0, out)?
  out.freeze()
}

fn order_code(o: cbor.KeyOrder) -> Int {
  match o {
    cbor.KeyOrder.Unsorted => 0
    cbor.KeyOrder.Bytewise => 1
    cbor.KeyOrder.LengthFirst => 2
  }
}

fn encode_sorted(v: cbor.Value, order: cbor.KeyOrder) -> Bytes ! cbor.CborErr {
  var out = BytesBuilder.new()
  enc_item(v, order_code(order), 0, out)?
  out.freeze()
}

fn encoder(order: cbor.KeyOrder) -> cbor.Encoder {
  cbor.Encoder{out: BytesBuilder.new(), open: [], order: order}
}

fn encoder_encode(var e: cbor.Encoder, v: cbor.Value) -> () ! cbor.CborErr {
  if let Some(k) = e.open.last() {
    match k {
      cbor.Indefinite.TextString => if !(v is cbor.Value.TextString(_)) {
        return Err(cbor.CborErr.Type(msg: "cannot encode item type ${kind_name(v)} for indefinite-length text string"))
      }
      cbor.Indefinite.ByteString => if !(v is cbor.Value.ByteString(_)) {
        return Err(cbor.CborErr.Type(msg: "cannot encode item type ${kind_name(v)} for indefinite-length byte string"))
      }
      _ => {}
    }
  }
  enc_item(v, order_code(e.order), 0, e.out)
}

fn encoder_start_indefinite(var e: cbor.Encoder, kind: cbor.Indefinite) {
  let head = match kind {
    cbor.Indefinite.ByteString => 95
    cbor.Indefinite.TextString => 127
    cbor.Indefinite.Array => 159
    cbor.Indefinite.Map => 191
  }
  e.out.write_byte(UInt8(head))
  e.open.push(kind)
}

fn encoder_end_indefinite(var e: cbor.Encoder) -> () ! cbor.CborErr {
  if e.open.is_empty() {
    return Err(invalid("cannot encode \"break\" code outside indefinite length values"))
  }
  e.out.write_byte(UInt8(255))
  e.open.pop()
  Ok(())
}

fn encoder_bytes(e: cbor.Encoder) -> Bytes { e.out.freeze() }

// ---------------------------------------------------------------------------
// Decoder

struct Dec {
  data: Bytes
  pos: Int = 0
  max_depth: Int
  dup: Bool
  utf8: Bool = true
  /// DecodeOptions: 0 is no count limit; rej[n] refuses simple value n
  max_arr: Int = 0
  max_pairs: Int = 0
  no_indef: Bool = false
  no_tags: Bool = false
  no_bignum: Bool = false
  no_nan: Bool = false
  no_inf: Bool = false
  rej: List[Bool] = []
}

fn refused(what: Str) -> cbor.CborErr { invalid("data item of cbor type primitives is not accepted by protocol: ${what}") }

fn indef_refused(major: Int) -> cbor.CborErr {
  let t = if major == 2 { "byte string" } else if major == 3 { "UTF-8 text string" } else if major == 4 { "array" } else { "map" }
  invalid("indefinite-length ${t} isn't allowed")
}

fn float_of_half(h: Int) -> Float {
  let sign = (h >> 15) & 1
  let e = (h >> 10) & 31
  let m = h & 1023
  let s = sign.wrapping_shl(63)
  if e == 31 {
    return Float.from_bits(s | (2047 << 52) | (m << 42))
  }
  if e == 0 {
    return half_sub(s, m)
  }
  Float.from_bits(s | ((e - 15 + 1023) << 52) | (m << 42))
}

fn half_sub(s: Int, m: Int) -> Float {
  let f = Float(m) * Float.from_bits((1023 - 24) << 52)
  if s != 0 { -f } else { f }
}

fn float_of_single(w: Int) -> Float {
  let sign = (w >> 31) & 1
  let e = (w >> 23) & 255
  let m = w & 8388607
  let s = sign.wrapping_shl(63)
  if e == 255 {
    return Float.from_bits(s | (2047 << 52) | (m << 29))
  }
  if e == 0 {
    let f = Float(m) * Float.from_bits((1023 - 149) << 52)
    return if s != 0 { -f } else { f }
  }
  Float.from_bits(s | ((e - 127 + 1023) << 52) | (m << 29))
}

fn need(d: Dec, n: Int) -> () ! cbor.CborErr {
  if n < 0 || d.data.len() - d.pos < n {
    return Err(cbor.CborErr.Truncated)
  }
}

/// The item's head: (major type, additional information, argument bits).
/// The additional information is 31 for an indefinite length or a break.
fn read_head(var d: Dec) -> (Int, Int, Int) ! cbor.CborErr {
  need(d, 1)?
  let ib = Int(d.data[d.pos])
  d.pos += 1
  let major = ib >> 5
  let ai = ib & 31
  if ai < 24 {
    return (major, ai, ai)
  }
  if ai == 24 {
    need(d, 1)?
    let v = Int(d.data[d.pos])
    d.pos += 1
    if major == 7 && v < 32 {
      return Err(syntax("invalid simple value ${v}"))
    }
    return (major, ai, v)
  }
  if ai == 25 {
    need(d, 2)?
    let v = (Int(d.data[d.pos]) << 8) | Int(d.data[d.pos + 1])
    d.pos += 2
    return (major, ai, v)
  }
  if ai == 26 {
    need(d, 4)?
    var v = 0
    for i in 0..4 {
      v = (v << 8) | Int(d.data[d.pos + i])
    }
    d.pos += 4
    return (major, ai, v)
  }
  if ai == 27 {
    need(d, 8)?
    let v = binary.get_u64_be(d.data, d.pos)
    d.pos += 8
    return (major, ai, v)
  }
  if ai == 31 {
    if major == 0 || major == 1 || major == 6 {
      return Err(syntax("invalid additional information 31 for type ${major_name(major)}"))
    }
    return (major, ai, 0)
  }
  Err(syntax("invalid additional information ${ai} for type ${major_name(major)}"))
}

/// fxamacker's cborType.String() of a major type.
fn major_name(major: Int) -> Str {
  match major {
    0 => "positive integer"
    1 => "negative integer"
    2 => "byte string"
    3 => "UTF-8 text string"
    4 => "array"
    5 => "map"
    6 => "tag"
    _ => "primitives"
  }
}

/// The chunks of an indefinite length string, joined.
fn read_chunks(var d: Dec, major: Int) -> Bytes ! cbor.CborErr {
  var out = BytesBuilder.new()
  while true {
    need(d, 1)?
    if d.data[d.pos] == UInt8(255) {
      d.pos += 1
      break
    }
    let (m, ai, n) = read_head(d)?
    if m != major {
      return Err(syntax("wrong chunk type ${m} in an indefinite length string of type ${major}"))
    }
    if ai == 31 {
      return Err(syntax("indefinite length chunk in an indefinite length string"))
    }
    need(d, n)?
    let chunk = d.data[d.pos..(d.pos + n)]
    if major == 3 && d.utf8 {
      if chunk.to_str() == None {
        return Err(invalid("invalid UTF-8 in text string"))
      }
    }
    out.write(chunk)
    d.pos += n
  }
  out.freeze()
}

fn read_text(var d: Dec, ai: Int, n: Int) -> Str ! cbor.CborErr {
  if ai == 31 {
    let b = read_chunks(d, 3)?
    return b.to_str() ?? ""
  }
  need(d, n)?
  let chunk = d.data[d.pos..(d.pos + n)]
  d.pos += n
  match chunk.to_str() {
    Some(s) => s
    None => {
      if d.utf8 {
        return Err(invalid("invalid UTF-8 in text string"))
      }
      ""
    }
  }
}

/// Whether a map key is a NaN, bare or under tags.
fn nan_key(v: cbor.Value) -> Bool {
  match v {
    cbor.Value.Float(f) => f.is_nan()
    cbor.Value.Tag(_, inner) => nan_key(inner)
    _ => false
  }
}

fn check_dups(pairs: List[(cbor.Value, cbor.Value)]) -> () ! cbor.CborErr {
  var seen: Set[Str] = #{}
  for p in pairs {
    // a NaN key, bare or under tags, is never equal to another key (Go's
    // map semantics: fxamacker's duplicate check keys a Go map)
    if nan_key(p.0) {
      continue
    }
    let kb = encode(p.0, true)?
    let h = kb.to_hex()
    if seen.contains(h) {
      return Err(invalid("duplicate map key"))
    }
    seen.add(h)
  }
}

fn read_item(var d: Dec, depth: Int) -> cbor.Value ! cbor.CborErr {
  let (major, ai, n) = read_head(d)?
  if major == 0 {
    return cbor.Value.Uint(n: UInt64.from_bits(n))
  }
  if major == 1 {
    return cbor.Value.Nint(n: UInt64.from_bits(n))
  }
  if ai == 31 && d.no_indef && major >= 2 && major <= 5 {
    if major >= 4 && depth + 1 > d.max_depth {
      return Err(limit("exceeded max nested level ${d.max_depth}"))
    }
    return Err(indef_refused(major))
  }
  if major == 2 {
    if ai == 31 {
      return cbor.Value.ByteString(b: read_chunks(d, 2)?)
    }
    need(d, n)?
    let b = d.data[d.pos..(d.pos + n)]
    d.pos += n
    return cbor.Value.ByteString(b: b)
  }
  if major == 3 {
    return cbor.Value.TextString(s: read_text(d, ai, n)?)
  }
  if major == 4 || major == 5 {
    if depth + 1 > d.max_depth {
      return Err(limit("exceeded max nested level ${d.max_depth}"))
    }
    let per = if major == 4 { 1 } else { 2 }
    var items: List[cbor.Value] = []
    if ai != 31 {
      if major == 4 && d.max_arr > 0 && n > d.max_arr {
        return Err(limit("exceeded max number of elements ${d.max_arr} for CBOR array"))
      }
      if major == 5 && d.max_pairs > 0 && n > d.max_pairs {
        return Err(limit("exceeded max number of key-value pairs ${d.max_pairs} for CBOR map"))
      }
      // every item takes a byte at least
      if n < 0 || n > (d.data.len() - d.pos) / per {
        return Err(cbor.CborErr.Truncated)
      }
      for _ in 0..(n * per) {
        items.push(read_item(d, depth + 1)?)
      }
    } else {
      while true {
        need(d, 1)?
        if d.data[d.pos] == UInt8(255) {
          d.pos += 1
          break
        }
        items.push(read_item(d, depth + 1)?)
        if major == 4 && d.max_arr > 0 && items.len() > d.max_arr {
          return Err(limit("exceeded max number of elements ${d.max_arr} for CBOR array"))
        }
        if major == 5 && d.max_pairs > 0 && items.len() % 2 == 0 && items.len() / 2 > d.max_pairs {
          return Err(limit("exceeded max number of key-value pairs ${d.max_pairs} for CBOR map"))
        }
      }
      if major == 5 && items.len() % 2 == 1 {
        return Err(syntax("unexpected break in a map"))
      }
    }
    if major == 4 {
      return cbor.Value.Array(items: items)
    }
    var pairs: List[(cbor.Value, cbor.Value)] = []
    var i = 0
    while i < items.len() {
      pairs.push((items[i], items[i + 1]))
      i += 2
    }
    if d.dup {
      check_dups(pairs)?
    }
    return cbor.Value.Map(pairs: pairs)
  }
  if major == 6 {
    if d.no_tags {
      return Err(invalid("CBOR tag isn't allowed"))
    }
    need(d, 1)?
    var child = depth
    if (Int(d.data[d.pos]) >> 5) == 6 {
      child = depth + 1
      if child > d.max_depth {
        return Err(limit("exceeded max nested level ${d.max_depth}"))
      }
    }
    if d.no_bignum && (n == 2 || n == 3) {
      return Err(invalid("data item of cbor type tag is not accepted by protocol: bignum"))
    }
    let inner = read_item(d, child)?
    return cbor.Value.Tag(num: UInt64.from_bits(n), v: inner)
  }
  // major 7
  if ai <= 24 && !d.rej.is_empty() && d.rej[n] {
    return Err(refused("simple value ${n} is not recognized"))
  }
  if ai >= 25 && ai <= 27 && (d.no_nan || d.no_inf) {
    let f = if ai == 25 { float_of_half(n) } else if ai == 26 { float_of_single(n) } else { Float.from_bits(n) }
    if d.no_nan && f.is_nan() {
      return Err(refused("floating-point NaN"))
    }
    if d.no_inf && f.is_inf() {
      return Err(refused("floating-point infinity"))
    }
  }
  if ai == 20 { return cbor.Value.Bool(b: false) }
  if ai == 21 { return cbor.Value.Bool(b: true) }
  if ai == 22 { return cbor.Value.Null }
  if ai == 23 { return cbor.Value.Undefined }
  if ai == 25 { return cbor.Value.Float(f: float_of_half(n)) }
  if ai == 26 { return cbor.Value.Float(f: float_of_single(n)) }
  if ai == 27 { return cbor.Value.Float(f: Float.from_bits(n)) }
  if ai == 31 {
    return Err(syntax("unexpected break"))
  }
  cbor.Value.Simple(n: n)
}

fn decode_prefix(data: Bytes, max_depth: Int, reject_dup_keys: Bool) -> (cbor.Value, Int) ! cbor.CborErr {
  var d = Dec{data: data, max_depth: max_depth, dup: reject_dup_keys}
  let v = read_item(d, 0)?
  (v, d.pos)
}

fn dec_of(data: Bytes, o: cbor.DecodeOptions) -> Dec ! cbor.CborErr {
  var rej: List[Bool] = []
  if !o.rejected_simple.is_empty() {
    rej = List.with_capacity(256)
    for _ in 0..256 {
      rej.push(false)
    }
    for sv in o.rejected_simple {
      if sv >= 24 && sv <= 31 {
        return Err(invalid("cannot set analog for reserved simple value ${sv}"))
      }
      if sv < 0 || sv > 255 {
        return Err(invalid("rejected_simple: ${sv} is not a simple value (0 to 255)"))
      }
      rej[sv] = true
    }
  }
  Dec{data: data, max_depth: o.max_depth, dup: o.reject_dup_keys, max_arr: o.max_array_elements, max_pairs: o.max_map_pairs, no_indef: o.reject_indefinite, no_tags: o.reject_tags, no_bignum: o.reject_bignum, no_nan: o.reject_nan, no_inf: o.reject_inf, rej: rej}
}

fn decode_prefix_with(data: Bytes, opts: cbor.DecodeOptions) -> (cbor.Value, Int) ! cbor.CborErr {
  var d = dec_of(data, opts)?
  let v = read_item(d, 0)?
  (v, d.pos)
}

fn decode_with(data: Bytes, opts: cbor.DecodeOptions) -> cbor.Value ! cbor.CborErr {
  let (v, used) = decode_prefix_with(data, opts)?
  if used != data.len() {
    return Err(invalid("${data.len() - used} bytes of extraneous data starting at index ${used}"))
  }
  v
}

fn decode(data: Bytes, max_depth: Int, reject_dup_keys: Bool) -> cbor.Value ! cbor.CborErr {
  let (v, used) = decode_prefix(data, max_depth, reject_dup_keys)?
  if used != data.len() {
    return Err(invalid("${data.len() - used} bytes of extraneous data starting at index ${used}"))
  }
  v
}

fn well_formed(data: Bytes, max_depth: Int) -> Bool {
  var d = Dec{data: data, max_depth: max_depth, dup: false, utf8: false}
  match read_item(d, 0) {
    Ok(_) => d.pos == data.len()
    Err(_) => false
  }
}

// ---------------------------------------------------------------------------
// Diagnostic notation (RFC 8949 Section 8)

fn hex4(n: Int) -> Str {
  let digits = "0123456789abcdef"
  var out = BytesBuilder.new()
  for i in 0..4 {
    let nib = (n >> (4 * (3 - i))) & 15
    out.write_byte(UInt8(Int(digits.bytes()[nib])))
  }
  (out.freeze().to_str()) ?? ""
}

fn diag_text(s: Str) -> Str {
  var out = BytesBuilder.new()
  out.write_byte(UInt8(34))
  for r in s.runes() {
    let c = Int(r)
    if c == 9 {
      out.write_str("\\t")
    } else if c == 10 {
      out.write_str("\\n")
    } else if c == 13 {
      out.write_str("\\r")
    } else if c == 92 {
      out.write_str("\\\\")
    } else if c == 34 {
      out.write_str("\\\"")
    } else if c >= 32 && c <= 126 {
      out.write_byte(UInt8(c))
    } else if c < 65536 {
      out.write_str("\\u" + hex4(c))
    } else {
      let v = c - 65536
      out.write_str("\\u" + hex4(55296 + (v >> 10)))
      out.write_str("\\u" + hex4(56320 + (v & 1023)))
    }
  }
  out.write_byte(UInt8(34))
  (out.freeze().to_str()) ?? ""
}

/// The shortest decimal digits of a finite, nonzero, positive f and the
/// exponent of its first digit (f = 0.d1d2... * 10^k is not used: the value
/// is d1.d2d3... * 10^exp10).
fn float_digits(f: Float) -> (Str, Int) {
  // the shortest text Float displays as: digits, optional fraction, optional exponent
  let t = "${f}"
  var mant = t
  var e = 0
  match t.find("e") {
    Some(i) => {
      mant = t[0..i]
      e = Int.parse(t[(i + 1)..t.len()].trim_prefix("+")) ?? 0
    }
    None => {}
  }
  var ip = mant
  var fp = ""
  match mant.find(".") {
    Some(i) => {
      ip = mant[0..i]
      fp = mant[(i + 1)..mant.len()]
    }
    None => {}
  }
  let digits = ip + fp
  var exp10 = ip.len() - 1 + e
  // strip leading and trailing zeros, comparing bytes (a Str slice per step allocates)
  let db = digits.bytes()
  var lead = 0
  while lead < db.len() - 1 && db[lead] == 48 {
    lead += 1
  }
  exp10 -= lead
  var end = db.len()
  while end > lead + 1 && db[end - 1] == 48 {
    end -= 1
  }
  (digits[lead..end], exp10)
}

fn diag_float(f: Float) -> Str {
  if f.is_nan() {
    return "NaN"
  }
  if f.is_inf() {
    return if f > 0.0 { "Infinity" } else { "-Infinity" }
  }
  let neg = f.to_bits() < 0
  let a = f.abs()
  if a == 0.0 {
    return if neg { "-0.0" } else { "0.0" }
  }
  let (digits, e) = float_digits(a)
  var body = ""
  if a < 0.000001 || a >= 1e21 {
    // d.ddde+XX, Go's 'e' form with a one digit exponent below e-9 cleaned
    var m = digits[0..1]
    if digits.len() > 1 {
      m = m + "." + digits[1..digits.len()]
    } else {
      m = m + ".0"
    }
    var es = "${if e < 0 { -e } else { e }}"
    if es.len() < 2 {
      es = "0" + es
    }
    if e < 0 && es.starts_with("0") {
      es = es[1..es.len()]
    }
    body = m + "e" + (if e < 0 { "-" } else { "+" }) + es
  } else if e >= 0 {
    if digits.len() <= e + 1 {
      body = digits + "0".repeat(e + 1 - digits.len()) + ".0"
    } else {
      body = digits[0..(e + 1)] + "." + digits[(e + 1)..digits.len()]
    }
  } else {
    body = "0." + "0".repeat(-e - 1) + digits
  }
  if neg { "-" + body } else { body }
}

fn u64_text(n: UInt64) -> Str {
  "${n}"
}

/// The decimal text of the big endian number b (plus one when plus_one is
/// set), in limbs of nine digits.
fn big_decimal(b: Bytes, plus_one: Bool) -> Str {
  var limbs: List[Int] = [0]
  for i in 0..b.len() {
    var carry = Int(b[i])
    for j in 0..limbs.len() {
      let v = limbs[j] * 256 + carry
      limbs.set(j, v % 1000000000)
      carry = v / 1000000000
    }
    while carry > 0 {
      limbs.push(carry % 1000000000)
      carry = carry / 1000000000
    }
  }
  if plus_one {
    var j = 0
    var carry = 1
    while carry > 0 {
      if j == limbs.len() {
        limbs.push(0)
      }
      let v = limbs[j] + carry
      limbs.set(j, v % 1000000000)
      carry = v / 1000000000
      j += 1
    }
  }
  var out = "${limbs[limbs.len() - 1]}"
  var k = limbs.len() - 2
  while k >= 0 {
    let t = "${limbs[k]}"
    out = out + "0".repeat(9 - t.len()) + t
    k -= 1
  }
  out
}

fn be8(n: UInt64) -> Bytes {
  let v = n.to_bits()
  var out = BytesBuilder.new()
  put_be(out, v, 8)
  out.freeze()
}

fn diag_item(v: cbor.Value, var out: List[Str], bm: cbor.DiagBytes = cbor.DiagBytes.Base16) {
  match v {
    cbor.Value.Uint(n) => out.push(u64_text(n))
    cbor.Value.Nint(n) => out.push("-" + big_decimal(be8(n), true))
    cbor.Value.ByteString(b) => out.push(diag_bytes(b, bm))
    cbor.Value.TextString(s) => out.push(diag_text(s))
    cbor.Value.Array(items) => {
      out.push("[")
      var first = true
      for it in items {
        if !first {
          out.push(", ")
        }
        first = false
        diag_item(it, out, bm)
      }
      out.push("]")
    }
    cbor.Value.Map(pairs) => {
      out.push("{")
      var first = true
      for p in pairs {
        if !first {
          out.push(", ")
        }
        first = false
        diag_item(p.0, out, bm)
        out.push(": ")
        diag_item(p.1, out, bm)
      }
      out.push("}")
    }
    cbor.Value.Tag(num, inner) => {
      // a bignum (tag 2 or 3 on a byte string) is written as its number
      var done = false
      if num.to_bits() == 2 || num.to_bits() == 3 {
        match inner {
          cbor.Value.ByteString(b) => {
            out.push(if num.to_bits() == 2 { big_decimal(b, false) } else { "-" + big_decimal(b, true) })
            done = true
          }
          _ => {}
        }
      }
      if !done {
        out.push(u64_text(num) + "(")
        diag_item(inner, out, bm)
        out.push(")")
      }
    }
    cbor.Value.Simple(n) => out.push("simple(${n})")
    cbor.Value.Bool(b) => out.push(if b { "true" } else { "false" })
    cbor.Value.Null => out.push("null")
    cbor.Value.Undefined => out.push("undefined")
    cbor.Value.Float(f) => out.push(diag_float(f))
  }
}

fn diag_bytes(b: Bytes, bm: cbor.DiagBytes) -> Str {
  match bm {
    cbor.DiagBytes.Base16 => "h'" + b.to_hex() + "'"
    cbor.DiagBytes.Base32 => "b32'" + base32.encode(b, base32.Base32.RawStd) + "'"
    cbor.DiagBytes.Base32Hex => "h32'" + base32.encode(b, base32.Base32.RawHex) + "'"
    cbor.DiagBytes.Base64 => "b64'" + base64.encode(b, base64.Base64.RawUrl) + "'"
  }
}

fn value_diagnostic_with(v: cbor.Value, bytes: cbor.DiagBytes) -> Str {
  var parts: List[Str] = []
  diag_item(v, parts, bytes)
  parts.join("")
}

fn value_diagnostic(v: cbor.Value) -> Str {
  var parts: List[Str] = []
  diag_item(v, parts)
  parts.join("")
}

/// fxamacker's Diagnose: the notation of the item at d.pos, read from its
/// bytes, so indefinite lengths keep their `_` marks (`[_ 1]`, `(_ h'01',
/// h'02')`, `''_` for no chunks). The data was decoded first, so it is well
/// formed; a bignum tag over anything but a byte string is the error
/// fxamacker's Diagnose gives.
fn diag_raw(var d: Dec, var out: List[Str]) -> () ! cbor.CborErr {
  let (major, ai, n) = read_head(d)?
  if ai == 31 && (major == 2 || major == 3) {
    if d.data[d.pos] == UInt8(255) {
      d.pos += 1
      out.push(if major == 2 { "''_" } else { "\"\"_" })
      return
    }
    out.push("(_ ")
    var first = true
    while d.data[d.pos] != UInt8(255) {
      if !first {
        out.push(", ")
      }
      first = false
      diag_raw(d, out)?
    }
    d.pos += 1
    out.push(")")
    return
  }
  if major == 0 {
    out.push(u64_text(UInt64.from_bits(n)))
    return
  }
  if major == 1 {
    out.push("-" + big_decimal(be8(UInt64.from_bits(n)), true))
    return
  }
  if major == 2 {
    out.push(diag_bytes(d.data[d.pos..(d.pos + n)], cbor.DiagBytes.Base16))
    d.pos += n
    return
  }
  if major == 3 {
    out.push(diag_text(read_text(d, ai, n)?))
    return
  }
  if major == 4 || major == 5 {
    out.push(if major == 4 { "[" } else { "{" })
    if ai == 31 {
      out.push("_ ")
    }
    var i = 0
    while true {
      if ai == 31 && d.data[d.pos] == UInt8(255) {
        break
      }
      if ai != 31 && i >= n {
        break
      }
      if i > 0 {
        out.push(", ")
      }
      diag_raw(d, out)?
      if major == 5 {
        out.push(": ")
        diag_raw(d, out)?
      }
      i += 1
    }
    if ai == 31 {
      d.pos += 1
    }
    out.push(if major == 4 { "]" } else { "}" })
    return
  }
  if major == 6 {
    if n == 2 || n == 3 {
      let cm = Int(d.data[d.pos]) >> 5
      if cm != 2 {
        return Err(cbor.CborErr.Type(msg: "tag number ${n} must be followed by byte string, got ${major_name(cm)}"))
      }
      let (_, bai, bn) = read_head(d)?
      let b = if bai == 31 { read_chunks(d, 2)? } else {
        let c = d.data[d.pos..(d.pos + bn)]
        d.pos += bn
        c
      }
      out.push(if n == 2 { big_decimal(b, false) } else { "-" + big_decimal(b, true) })
      return
    }
    out.push(u64_text(UInt64.from_bits(n)) + "(")
    diag_raw(d, out)?
    out.push(")")
    return
  }
  out.push(match ai {
    20 => "false"
    21 => "true"
    22 => "null"
    23 => "undefined"
    25 => diag_float(float_of_half(n))
    26 => diag_float(float_of_single(n))
    27 => diag_float(Float.from_bits(n))
    _ => "simple(${n})"
  })
}

fn diagnose(data: Bytes) -> Str ! cbor.CborErr {
  decode(data, 128, false)?
  var d = Dec{data: data, max_depth: 128, dup: false}
  var parts: List[Str] = []
  diag_raw(d, parts)?
  parts.join("")
}

// ---------------------------------------------------------------------------
// The JSON bridge (RFC 8949 Section 6)

fn json_key(k: cbor.Value) -> Str ! cbor.CborErr {
  match k {
    cbor.Value.TextString(s) => s
    cbor.Value.Uint(_) => value_diagnostic(k)
    cbor.Value.Nint(_) => value_diagnostic(k)
    cbor.Value.Float(_) => value_diagnostic(k)
    cbor.Value.Bool(b) => if b { "true" } else { "false" }
    cbor.Value.Null => "null"
    _ => Err(invalid("a map key of this kind has no JSON form"))
  }
}

fn value_to_json(v: cbor.Value) -> json.Value ! cbor.CborErr {
  match v {
    cbor.Value.Uint(n) => {
      match value_to_int(v) {
        Some(i) => json.Value.Int(n: i)
        None => json.Value.Num(n: Float.parse(u64_text(n)) ?? 0.0)
      }
    }
    cbor.Value.Nint(n) => {
      match value_to_int(v) {
        Some(i) => json.Value.Int(n: i)
        None => json.Value.Num(n: Float.parse(diag_nint(n)) ?? 0.0)
      }
    }
    cbor.Value.ByteString(b) => json.Value.Str(s: base64.encode(b, base64.Base64.RawUrl))
    cbor.Value.TextString(s) => json.Value.Str(s: s)
    cbor.Value.Array(items) => {
      var out: List[json.Value] = []
      for it in items {
        out.push(value_to_json(it)?)
      }
      json.Value.List(items: out)
    }
    cbor.Value.Map(pairs) => {
      var out: List[(Str, json.Value)] = []
      for p in pairs {
        out.push((json_key(p.0)?, value_to_json(p.1)?))
      }
      json.Value.Object(fields: out)
    }
    cbor.Value.Tag(_, inner) => value_to_json(inner)?
    cbor.Value.Simple(n) => json.Value.Str(s: "simple(${n})")
    cbor.Value.Bool(b) => json.Value.Bool(b: b)
    cbor.Value.Null => json.Value.Null
    cbor.Value.Undefined => json.Value.Null
    cbor.Value.Float(f) => {
      if f.is_nan() || f.is_inf() {
        return Err(invalid("NaN and infinity have no JSON form"))
      }
      json.Value.Num(n: f)
    }
  }
}

fn diag_nint(n: UInt64) -> Str {
  let one: cbor.Value = cbor.Value.Nint(n: n)
  value_diagnostic(one)
}

fn from_json(j: json.Value) -> cbor.Value {
  match j {
    json.Value.Null => cbor.Value.Null
    json.Value.Bool(b) => cbor.Value.Bool(b: b)
    json.Value.Int(n) => from_int(n)
    json.Value.Num(n) => cbor.Value.Float(f: n)
    json.Value.Str(s) => cbor.Value.TextString(s: s)
    json.Value.List(items) => {
      var out: List[cbor.Value] = []
      for it in items {
        out.push(from_json(it))
      }
      cbor.Value.Array(items: out)
    }
    json.Value.Object(fields) => {
      var out: List[(cbor.Value, cbor.Value)] = []
      for f in fields {
        out.push((cbor.Value.TextString(s: f.0), from_json(f.1)))
      }
      cbor.Value.Map(pairs: out)
    }
    json.Value.Trusted(_, s) => cbor.Value.TextString(s: s)
  }
}

// ---------------------------------------------------------------------------
// derive Cbor (decision 0527): the helpers of the generated code

fn unm_new(strict: Bool) -> cbor.Unm { cbor.Unm{strict: strict, err: None} }

fn dec_error(st: cbor.Unm) -> cbor.CborErr? { st.err }

fn kind_name(v: cbor.Value) -> Str {
  match v {
    cbor.Value.Uint(_) | cbor.Value.Nint(_) => "integer"
    cbor.Value.ByteString(_) => "byte string"
    cbor.Value.TextString(_) => "UTF-8 text string"
    cbor.Value.Array(_) => "array"
    cbor.Value.Map(_) => "map"
    cbor.Value.Tag(..) => "tag"
    cbor.Value.Simple(_) => "simple value"
    cbor.Value.Bool(_) => "primitives"
    cbor.Value.Null | cbor.Value.Undefined => "primitives"
    cbor.Value.Float(_) => "float"
  }
}

fn mismatch(var st: cbor.Unm, want: Str, v: cbor.Value) {
  if st.err == None {
    st.err = Some(cbor.CborErr.Type(msg: "cannot unmarshal ${kind_name(v)} into Go value of type ${want}"))
  }
}

fn is_null(v: cbor.Value) -> Bool {
  match v {
    cbor.Value.Null | cbor.Value.Undefined => true
    _ => false
  }
}

/// A tag is transparent on decode (decision 0527), after the check fxamacker
/// makes of the built in ones: tag 0 wraps a text string, tag 1 an integer or a
/// float, tags 2 and 3 a byte string; the self described tag 55799 is dropped
/// first. A refused tag records the type error and gives `(false, v)`.
fn untag(v0: cbor.Value, var st: cbor.Unm) -> (Bool, cbor.Value) {
  var v = v0
  while true {
    match v {
      cbor.Value.Tag(num, inner) => {
        if num.to_bits() != 55799 {
          break
        }
        v = inner
      }
      _ => break
    }
  }
  var cur = v
  while true {
    match cur {
      cbor.Value.Tag(num, inner) => {
        let good = match num.to_bits() {
          0 => match inner {
            cbor.Value.TextString(_) => true
            _ => false
          }
          1 => match inner {
            cbor.Value.Uint(_) | cbor.Value.Nint(_) | cbor.Value.Float(_) => true
            _ => false
          }
          2 | 3 => match inner {
            cbor.Value.ByteString(_) => true
            _ => false
          }
          _ => true
        }
        if !good {
          if st.err == None {
            st.err = Some(inadmissible(num.to_bits(), inner))
          }
          return (false, v)
        }
        cur = inner
      }
      _ => break
    }
  }
  (true, strip_tags(v))
}

/// Whether built in tag t (0 to 3) may hold v, as untag checks.
fn builtin_tag_ok(t: Int, v: cbor.Value) -> Bool {
  match t {
    0 => v is cbor.Value.TextString(_)
    1 => match v {
      cbor.Value.Uint(_) | cbor.Value.Nint(_) | cbor.Value.Float(_) => true
      _ => false
    }
    _ => v is cbor.Value.ByteString(_)
  }
}

/// fxamacker's InadmissibleTagContentTypeError for built in tag n over v.
fn inadmissible(n: Int, v: cbor.Value) -> cbor.CborErr {
  let got = go_type_name(v)
  let msg = if n == 0 {
    "tag number 0 must be followed by text string, got ${got}"
  } else if n == 1 {
    "tag number 1 must be followed by integer or floating-point number, got ${got}"
  } else {
    "tag number 2 or 3 must be followed by byte string, got ${got}"
  }
  cbor.CborErr.Type(msg: msg)
}

/// fxamacker's cborType.String() of v's major type.
fn go_type_name(v: cbor.Value) -> Str {
  match v {
    cbor.Value.Uint(_) => "positive integer"
    cbor.Value.Nint(_) => "negative integer"
    cbor.Value.ByteString(_) => "byte string"
    cbor.Value.TextString(_) => "UTF-8 text string"
    cbor.Value.Array(_) => "array"
    cbor.Value.Map(_) => "map"
    cbor.Value.Tag(..) => "tag"
    _ => "primitives"
  }
}

fn strip_tags(v: cbor.Value) -> cbor.Value {
  match v {
    cbor.Value.Tag(_, inner) => strip_tags(inner)
    _ => v
  }
}

// The readers below answer the variant they want before untag: a value with
// no tag (nearly every one) is read in place, where untag's copy of it was a
// retain and a release of the value per field (task #87, 2026-11-16:
// bench/perf/cbor udecode, dup and drop of cbor.Value 30%).
fn to_str(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Str) {
  if let cbor.Value.TextString(s) = v0 { return (true, s) }
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, "") }
  match v {
    cbor.Value.TextString(s) => (true, s)
    _ => {
      mismatch(st, "string", v)
      (false, "")
    }
  }
}

/// The last tag over v is 2 or 3 and wraps a byte string: its big integer,
/// as `(1, n)` when it fits an Int, `(2, 0)` when it does not, `(0, 0)` when v
/// is not one.
fn bignum_int(v: cbor.Value) -> (Int, Int) {
  var cur = v
  var num = -1
  while true {
    match cur {
      cbor.Value.Tag(t, inner) => {
        num = t.to_bits()
        cur = inner
      }
      _ => break
    }
  }
  if num != 2 && num != 3 {
    return (0, 0)
  }
  match cur {
    cbor.Value.ByteString(b) => {
      var mag = 0
      var started = false
      var n = 0
      for x in b {
        if !started && x == 0 {
          continue
        }
        started = true
        n += 1
        if n > 8 {
          return (2, 0)
        }
        if n == 8 && x >= 128 {
          return (2, 0)
        }
        mag = (mag << 8) | Int(x)
      }
      if num == 2 { (1, mag) } else { (1, -1 - mag) }
    }
    _ => (0, 0)
  }
}

fn to_int(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Int) {
  match v0 {
    cbor.Value.Uint(n) => {
      let b = n.to_bits()
      if b >= 0 { return (true, b) }
    }
    cbor.Value.Nint(n) => {
      let b = n.to_bits()
      if b >= 0 { return (true, -1 - b) }
    }
    _ => {}
  }
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, 0) }
  let (bk, bn) = bignum_int(v0)
  if bk == 1 {
    return (true, bn)
  }
  if bk == 2 {
    mismatch(st, "int", v)
    return (false, 0)
  }
  if let Some(n) = value_to_int(v) {
    return (true, n)
  }
  mismatch(st, "int", v)
  (false, 0)
}

fn to_float(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Float) {
  if let cbor.Value.Float(f) = v0 { return (true, f) }
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, 0.0) }
  match v {
    cbor.Value.Float(f) => (true, f)
    _ => {
      if let Some(n) = value_to_int(v) {
        return (true, Float(n))
      }
      mismatch(st, "float64", v)
      (false, 0.0)
    }
  }
}

fn to_bool(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Bool) {
  if let cbor.Value.Bool(b) = v0 { return (true, b) }
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, false) }
  match v {
    cbor.Value.Bool(b) => (true, b)
    _ => {
      mismatch(st, "bool", v)
      (false, false)
    }
  }
}

fn to_bytes(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Bytes) {
  if let cbor.Value.ByteString(b) = v0 { return (true, b) }
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, b"") }
  match v {
    cbor.Value.ByteString(b) => (true, b)
    cbor.Value.Array(xs) => {
      // an array of small integers is a []byte too, as fxamacker reads it
      var out = BytesBuilder.new()
      var good = true
      for x in xs {
        let (okx, n) = to_int(x, st)
        if okx && n >= 0 && n <= 255 {
          out.write_byte(UInt8(n))
        } else {
          if okx {
            mismatch(st, "uint8", x)
          }
          good = false
        }
      }
      (good, out.freeze())
    }
    _ => {
      mismatch(st, "[]uint8", v)
      (false, b"")
    }
  }
}

fn items(v0: cbor.Value, want: Str, var st: cbor.Unm) -> (Bool, List[cbor.Value]) {
  if let cbor.Value.Array(xs) = v0 { return (true, xs) }
  let (okt, v) = untag(v0, st)
  if !okt { return (false, []) }
  match v {
    cbor.Value.Array(xs) => (true, xs)
    _ => {
      mismatch(st, want, v)
      (false, [])
    }
  }
}

fn pairs(v0: cbor.Value, want: Str, var st: cbor.Unm) -> (Bool, List[(cbor.Value, cbor.Value)]) {
  if let cbor.Value.Map(ps) = v0 { return (true, ps) }
  let (okt, v) = untag(v0, st)
  if !okt { return (false, []) }
  match v {
    cbor.Value.Map(ps) => (true, ps)
    _ => {
      mismatch(st, want, v)
      (false, [])
    }
  }
}

fn key_text(k: cbor.Value) -> Str? {
  match k {
    cbor.Value.TextString(s) => Some(s)
    _ => None
  }
}

fn key_int(k: cbor.Value) -> Int? { value_to_int(k) }

fn unknown_key(var st: cbor.Unm, want: Str, k: cbor.Value) {
  if st.strict && st.err == None {
    st.err = Some(cbor.CborErr.Type(msg: "unknown field in ${want}: ${value_diagnostic(k)}"))
  }
}

fn sorted_keys(keys: List[Str]) -> List[Str] {
  var out: List[Str] = []
  for k in keys {
    var at = out.len()
    while at > 0 && k < out[at - 1] {
      at -= 1
    }
    out.insert(at, k)
  }
  out
}

fn to_value(v: cbor.Value, var st: cbor.Unm) -> (Bool, cbor.Value) { (true, v) }

fn to_raw(v: cbor.Value, var st: cbor.Unm) -> (Bool, cbor.Raw) {
  match encode(v, false) {
    Ok(b) => (true, cbor.Raw{bytes: b})
    Err(e) => {
      if st.err == None {
        st.err = Some(e)
      }
      (false, cbor.Raw{bytes: b""})
    }
  }
}

fn from_raw(r: cbor.Raw) -> cbor.Value {
  if r.bytes.is_empty() {
    return cbor.Value.Null
  }
  decode(r.bytes, 128, false) ?? _ => cbor.Value.Null
}

/// RawMessage.MarshalCBOR: the bytes as they are, null when empty; bytes
/// that are not one well formed item, or hold a built in tag over the
/// wrong content, are Go's `error calling MarshalCBOR for type
/// cbor.RawMessage: ...`.
fn put_raw(var out: BytesBuilder, r: cbor.Raw) -> () ! cbor.CborErr {
  if r.bytes.is_empty() {
    out.write_byte(UInt8(246))
    return Ok(())
  }
  let why = match decode(r.bytes, 128, false) {
    Ok(v) => match builtin_tag_err(v) {
      Some(e) => Some(e)
      None => None
    }
    Err(e) => Some(e)
  }
  if let Some(e) = why {
    let inner = if e is cbor.CborErr.Truncated { "unexpected EOF" } else { cborerr_display(e) }
    return Err(cbor.CborErr.Invalid(msg: "error calling MarshalCBOR for type cbor.RawMessage: " + inner))
  }
  out.write(r.bytes)
  Ok(())
}

/// The first built in tag (0 to 3) in v over content fxamacker refuses.
fn builtin_tag_err(v: cbor.Value) -> cbor.CborErr? {
  match v {
    cbor.Value.Tag(num, inner) => {
      let n = num.to_bits()
      let bad = if n == 0 { !(inner is cbor.Value.TextString(_)) } else if n == 1 { !(inner is cbor.Value.Uint(_) | cbor.Value.Nint(_) | cbor.Value.Float(_)) } else if n == 2 || n == 3 { !(inner is cbor.Value.ByteString(_)) } else { false }
      if bad {
        return Some(inadmissible(n, inner))
      }
      builtin_tag_err(inner)
    }
    cbor.Value.Array(items) => {
      for it in items {
        if let Some(e) = builtin_tag_err(it) {
          return Some(e)
        }
      }
      None
    }
    cbor.Value.Map(pairs) => {
      for p in pairs {
        if let Some(e) = builtin_tag_err(p.0) {
          return Some(e)
        }
        if let Some(e) = builtin_tag_err(p.1) {
          return Some(e)
        }
      }
      None
    }
    _ => None
  }
}

fn raw_value(r: cbor.Raw) -> cbor.Value ! cbor.CborErr { decode(r.bytes, 128, false) }

fn from_value(v: cbor.Value) -> cbor.Value { v }

/// A Time as fxamacker's TimeUnixDynamic: whole seconds as an integer, else seconds as a float.
fn from_time(t: Time) -> cbor.Value {
  let ms = t.unix_millis()
  if ms % 1000 == 0 {
    return from_int(ms / 1000)
  }
  cbor.Value.Float(f: Float(ms) / 1000.0)
}

fn from_duration(d: Duration) -> cbor.Value { from_int(d.nanos()) }

fn put_int(var out: BytesBuilder, n: Int) {
  if n >= 0 {
    put_head(out, 0, n)
  } else {
    put_head(out, 1, -1 - n)
  }
}

fn put_text(var out: BytesBuilder, s: Str) {
  put_head(out, 3, s.len())
  out.write_str(s)
}

fn put_bytes(var out: BytesBuilder, b: Bytes) {
  put_head(out, 2, b.len())
  out.write(b)
}

fn put_value(var out: BytesBuilder, v: cbor.Value, deterministic: Bool) -> () ! cbor.CborErr {
  enc_item(v, if deterministic { 1 } else { 0 }, 0, out)
}

/// Text keys in the deterministic order (RFC 8949 4.2.1 on their encodings:
/// shorter first, then by bytes), as enc_item's key_less orders them.
fn det_keys(keys: List[Str]) -> List[Str] {
  var out: List[Str] = []
  for k in keys {
    var at = out.len()
    while at > 0 && (k.len() < out[at - 1].len() || (k.len() == out[at - 1].len() && k < out[at - 1])) {
      at -= 1
    }
    out.insert(at, k)
  }
  out
}

/// A Time from integer or float seconds since the epoch, or an RFC 3339 text.
fn to_time(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Time) {
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, Time.UNIX_EPOCH) }
  match v {
    cbor.Value.TextString(s) => {
      if let Some(t) = Time.parse_rfc3339(s) {
        return (true, t)
      }
      mismatch(st, "time.Time", v)
      return (false, Time.UNIX_EPOCH)
    }
    cbor.Value.Float(f) => {
      if f > -9.0e9 && f < 9.0e9 {
        return (true, Time.from_unix_millis(Int(f * 1000.0)))
      }
      mismatch(st, "time.Time", v)
      return (false, Time.UNIX_EPOCH)
    }
    _ => {}
  }
  if let Some(n) = value_to_int(v) {
    // seconds beyond what a millisecond count holds are refused
    if n > -9000000000 && n < 9000000000 {
      return (true, Time.from_unix(n))
    }
    mismatch(st, "time.Time", v)
    return (false, Time.UNIX_EPOCH)
  }
  mismatch(st, "time.Time", v)
  (false, Time.UNIX_EPOCH)
}

/// A Duration from integer nanoseconds.
fn to_duration(v0: cbor.Value, var st: cbor.Unm) -> (Bool, Duration) {
  let (okt, v) = untag(v0, st)
  if !okt || is_null(v) { return (false, Duration.from_nanos(0)) }
  if let Some(n) = value_to_int(v) {
    return (true, Duration.from_nanos(n))
  }
  mismatch(st, "time.Duration", v)
  (false, Duration.from_nanos(0))
}

fn bad_variant(var st: cbor.Unm, want: Str, got: Str) {
  if st.err == None {
    st.err = Some(cbor.CborErr.Type(msg: "cannot decode CBOR to enum ${want}: ${got}"))
  }
}

/// The tag of a type with `derive Cbor(tag: n, tag_rule: rule)` (decision
/// 0665; fxamacker's registered tag check): the tags around v must be
/// exactly n (WrongTagError's text otherwise), or none unless the rule is
/// required (UnmarshalTypeError's "expect CBOR tag value"); `ignored` takes
/// v as it is. Gives the value inside the tag.
fn want_tag(v0: cbor.Value, n: Int, rule: Str, want: Str, var st: cbor.Unm) -> (Bool, cbor.Value) {
  if rule == "ignored" {
    return (true, v0)
  }
  // as fxamacker's parseToValue: self-described tags (55799) dropped,
  // then the built in tags' contents checked, then the registered tag
  var v = v0
  while true {
    match v {
      cbor.Value.Tag(num, inner) => {
        if num.to_bits() != 55799 {
          break
        }
        v = inner
      }
      _ => break
    }
  }
  var nums: List[Str] = []
  var cur = v
  var one = false
  while true {
    match cur {
      cbor.Value.Tag(num, inner) => {
        let t = num.to_bits()
        if t >= 0 && t <= 3 && !builtin_tag_ok(t, inner) {
          if st.err == None {
            st.err = Some(inadmissible(t, inner))
          }
          return (false, v)
        }
        nums.push("${num}")
        one = nums.len() == 1 && t == n
        cur = inner
      }
      _ => break
    }
  }
  if nums.is_empty() {
    if rule != "required" {
      return (true, v)
    }
    if st.err == None {
      st.err = Some(cbor.CborErr.Type(msg: "cannot unmarshal ${kind_name(v)} into Go value of type ${want} (expect CBOR tag value)"))
    }
    return (false, v)
  }
  if !one {
    if st.err == None {
      st.err = Some(cbor.CborErr.Type(msg: "wrong tag number for ${want}, got [${nums.join(" ")}], expected [${UInt64.from_bits(n)}]"))
    }
    return (false, v)
  }
  (true, cur)
}

fn bad_arity(var st: cbor.Unm, want: Str, got: Int, need: Int) {
  if st.err == None {
    st.err = Some(cbor.CborErr.Type(msg: "cannot decode CBOR array to struct ${want} with different number of elements (${got}, want ${need})"))
  }
}
