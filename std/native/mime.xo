// std/mime on the native backends (decision 0282): Go's mime ported from
// mediatype.go, grammar.go, and type.go of go1.26 (ParseMediaType,
// FormatMediaType, TypeByExtension and ExtensionsByType over the builtin
// table only), with the same results and error texts; and net/http's
// sniff.go (DetectContentType) in mime_sniff.xo. Go's ParseMediaType
// also returns the media type with ErrInvalidMediaParameter; Xo returns
// the error alone.
use std/mime

fn mimeerr_display(e: mime.MimeErr) -> Str { e.msg }

fn err(msg: Str) -> mime.MimeErr { mime.MimeErr{msg: msg} }

const UPPER_HEX: Str = "0123456789ABCDEF"

/// grammar.go isTSpecial: ( ) < > @ , ; : \ " / [ ] ? =
fn is_tspecial(c: UInt8) -> Bool {
  c == 40 || c == 41 || c == 60 || c == 62 || c == 64 || c == 44 || c == 59 || c == 58 || c == 92 || c == 34 ||
    c == 47 || c == 91 || c == 93 || c == 63 || c == 61
}

/// grammar.go isTokenChar: a US-ASCII character but space, controls, and tspecials.
/// One for each token character (the table of is_token_char).
const TOKEN_CHARS: Bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x01\x01\x01\x01\x00\x00\x01\x01\x00\x01\x01\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

fn is_token_char(c: UInt8) -> Bool {
  let i = Int(c)
  TOKEN_CHARS[i] == 1
}

fn is_token(s: Str) -> Bool {
  if s.is_empty() {
    return false
  }
  for c in s.bytes() {
    if !is_token_char(c) {
      return false
    }
  }
  true
}

/// mediatype.go needsEncoding: a value with a control or non ASCII byte.
fn needs_encoding(s: Str) -> Bool {
  for c in s.bytes() {
    if (c < 32 || c > 126) && c != 9 {
      return true
    }
  }
  false
}

fn format_media_type(kind: Str, params: Map[Str, Str]) -> Str {
  var b = StrBuilder.new()
  match kind.find("/") {
    None => {
      if !is_token(kind) {
        return ""
      }
      b.write(kind.to_lower())
    }
    Some(i) => {
      let major = kind[0..i]
      let sub = kind[i + 1..]
      if !is_token(major) || !is_token(sub) {
        return ""
      }
      b.write(major.to_lower())
      b.write("/")
      b.write(sub.to_lower())
    }
  }
  let hex = UPPER_HEX.bytes()
  for attr in params.keys().sort() {
    let value = params.get(attr) ?? ""
    b.write("; ")
    if !is_token(attr) {
      return ""
    }
    b.write(attr.to_lower())
    if needs_encoding(value) {
      b.write("*=utf-8''")
      var out = BytesBuilder.new()
      for ch in value.bytes() {
        if ch <= 32 || ch >= 127 || ch == 42 || ch == 39 || ch == 37 || is_tspecial(ch) {
          out.write_byte(37)
          out.write_byte(hex[Int(ch) >> 4])
          out.write_byte(hex[Int(ch) & 15])
        } else {
          out.write_byte(ch)
        }
      }
      b.write(out.freeze().to_str() ?? "")
      continue
    }
    b.write("=")
    if is_token(value) {
      b.write(value)
      continue
    }
    b.write("\"")
    b.write(value.replace("\\", "\\\\").replace("\"", "\\\""))
    b.write("\"")
  }
  b.freeze()
}

/// The token at the start of v and the rest (consumeToken).
fn consume_token(v: Str) -> (Str, Str) {
  let b = v.bytes()
  var i = 0
  while i < b.len() && is_token_char(b[i]) {
    i += 1
  }
  (v[0..i], v[i..])
}

fn check_media_type_disposition(s: Str) -> () ! mime.MimeErr {
  let (typ, rest0) = consume_token(s)
  if typ.is_empty() {
    return Err(err("mime: no media type"))
  }
  if rest0.is_empty() {
    return Ok(())
  }
  if !rest0.starts_with("/") {
    return Err(err("mime: expected slash after first token"))
  }
  let (sub, rest) = consume_token(rest0[1..])
  if sub.is_empty() {
    return Err(err("mime: expected token after slash"))
  }
  if !rest.is_empty() {
    return Err(err("mime: unexpected content after media subtype"))
  }
}

/// consumeValue: a token or a quoted string; ("", v) when malformed.
fn consume_value(v: Str) -> (Str, Str) {
  if v.is_empty() {
    return ("", "")
  }
  if !v.starts_with("\"") {
    return consume_token(v)
  }
  let b = v.bytes()
  var out = BytesBuilder.new()
  var i = 1
  var end = -1
  while i < b.len() {
    let r = b[i]
    if r == 34 {
      end = i
      break
    }
    if r == 92 && i + 1 < b.len() && is_tspecial(b[i + 1]) {
      out.write_byte(b[i + 1])
      i += 2
      continue
    }
    if r == 13 || r == 10 {
      break
    }
    out.write_byte(r)
    i += 1
  }
  if end < 0 {
    return ("", v)
  }
  (out.freeze().to_str() ?? "", v[end + 1..])
}

/// consumeMediaParam: (name, value, rest), or ("", "", v) when v does not
/// start with a parameter.
fn consume_media_param(v: Str) -> (Str, Str, Str) {
  var rest = v.trim_start()
  if !rest.starts_with(";") {
    return ("", "", v)
  }
  rest = rest[1..].trim_start()
  let (p0, r1) = consume_token(rest)
  let param = p0.to_lower()
  if param.is_empty() {
    return ("", "", v)
  }
  rest = r1.trim_start()
  if !rest.starts_with("=") {
    return ("", "", v)
  }
  rest = rest[1..].trim_start()
  let (value, rest2) = consume_value(rest)
  if value.is_empty() && rest2 == rest {
    return ("", "", v)
  }
  (param, value, rest2)
}

fn is_hex(c: UInt8) -> Bool { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn unhex(c: UInt8) -> Int {
  let v = Int(c)
  if v <= 57 { v - 48 } else if v <= 70 { v - 55 } else { v - 87 }
}

/// percentHexUnescape; None for a bad escape.
fn percent_hex_unescape(s: Str) -> Str? {
  let b = s.bytes()
  if !s.contains("%") {
    return Some(s)
  }
  var out = BytesBuilder.with_capacity(b.len())
  var i = 0
  while i < b.len() {
    if b[i] != 37 {
      out.write_byte(b[i])
      i += 1
      continue
    }
    if i + 2 >= b.len() || !is_hex(b[i + 1]) || !is_hex(b[i + 2]) {
      return None
    }
    out.write_byte(UInt8(unhex(b[i + 1]) * 16 + unhex(b[i + 2])))
    i += 3
  }
  // bytes that are not UTF-8 cannot be a Str: such a value is dropped as
  // an undecodable one
  out.freeze().to_str()
}

/// decode2231Enc: charset'language'value with utf-8 or us-ascii.
fn decode_2231(v: Str) -> Str? {
  let q1 = v.find("'")?
  let charset = v[0..q1].to_lower()
  let rest = v[q1 + 1..]
  let q2 = rest.find("'")?
  if !(charset is "us-ascii" | "utf-8") {
    return None
  }
  percent_hex_unescape(rest[q2 + 1..])
}

/// A media type longer than this has its tokens copied (Str.clone). The rule
/// depends on the value being a small object of its own: the server's header
/// values are copies (http1 text_of, text_at), never slices of the read buffer.
const OWN_MIN = 4096

fn own(s: Str, big: Bool) -> Str { if big { s.clone() } else { s } }

fn parse_media_type(v0: Str) -> mime.MediaType ! mime.MimeErr {
  let base = match v0.find(";") {
    Some(i) => v0[0..i]
    None => v0
  }
  // kind and the parameters are stored in the result: copies for a long v0,
  // so a long-lived token does not keep it alive (decision 0330, Str.clone;
  // a copy per token is +14% on a 40 byte media type)
  let big = v0.len() > OWN_MIN
  let kind = own(base.to_lower().trim(), big)
  check_media_type_disposition(kind)?
  var params: Map[Str, Str] = {}
  // the RFC 2231 pieces of each name: name*, name*0, name*0*, ...
  var cont: Map[Str, Map[Str, Str]] = {}
  var v = v0[base.len()..]
  while !v.is_empty() {
    v = v.trim_start()
    if v.is_empty() {
      break
    }
    let (key, value, rest) = consume_media_param(v)
    if key.is_empty() {
      if rest.trim() == ";" {
        // a trailing semicolon
        break
      }
      return Err(err("mime: invalid media parameter"))
    }
    match key.find("*") {
      Some(i) => {
        let name = key[0..i]
        var pieces = cont.get(name) ?? {}
        if let Some(old) = pieces.get(key) {
          if old != value {
            return Err(err("mime: duplicate parameter name"))
          }
        }
        pieces.put(key, value)
        cont.put(name, pieces)
      }
      None => {
        if let Some(old) = params.get(key) {
          if old != value {
            return Err(err("mime: duplicate parameter name"))
          }
        }
        params.put(own(key, big), own(value, big))
      }
    }
    v = rest
  }
  for (key, pieces) in cont.entries() {
    if let Some(single) = pieces.get(key + "*") {
      if let Some(d) = decode_2231(single) {
        params.put(own(key, big), own(d, big))
      }
      continue
    }
    var buf = StrBuilder.new()
    var valid = false
    var n = 0
    while {
      let simple = "${key}*${n}"
      if let Some(p) = pieces.get(simple) {
        valid = true
        buf.write(p)
        n += 1
        continue
      }
      match pieces.get(simple + "*") {
        None => break
        Some(p) => {
          valid = true
          if n == 0 {
            if let Some(d) = decode_2231(p) {
              buf.write(d)
            }
          } else {
            buf.write(percent_hex_unescape(p) ?? "")
          }
        }
      }
      n += 1
    }
    if valid {
      params.put(own(key, big), buf.freeze())
    }
  }
  mime.MediaType{kind: kind, params: params}
}

