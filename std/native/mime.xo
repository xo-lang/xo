/// BUILTIN's type of ext as it is (a match: walking the list of tuples ran
/// type_by_extension at 5.5x Go's map lookup, 2026-10-26; generated from
/// BUILTIN, which extensions_by_type still walks).
fn builtin_type(ext: Str) -> Str? {
  match ext {
    ".ai" => Some("application/postscript")
    ".apk" => Some("application/vnd.android.package-archive")
    ".apng" => Some("image/apng")
    ".avif" => Some("image/avif")
    ".bin" => Some("application/octet-stream")
    ".bmp" => Some("image/bmp")
    ".com" => Some("application/octet-stream")
    ".css" => Some("text/css; charset=utf-8")
    ".csv" => Some("text/csv; charset=utf-8")
    ".doc" => Some("application/msword")
    ".docx" => Some("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
    ".ehtml" => Some("text/html; charset=utf-8")
    ".eml" => Some("message/rfc822")
    ".eps" => Some("application/postscript")
    ".exe" => Some("application/octet-stream")
    ".flac" => Some("audio/flac")
    ".gif" => Some("image/gif")
    ".gz" => Some("application/gzip")
    ".htm" => Some("text/html; charset=utf-8")
    ".html" => Some("text/html; charset=utf-8")
    ".ico" => Some("image/vnd.microsoft.icon")
    ".ics" => Some("text/calendar; charset=utf-8")
    ".jfif" => Some("image/jpeg")
    ".jpeg" => Some("image/jpeg")
    ".jpg" => Some("image/jpeg")
    ".js" => Some("text/javascript; charset=utf-8")
    ".json" => Some("application/json")
    ".m4a" => Some("audio/mp4")
    ".mjs" => Some("text/javascript; charset=utf-8")
    ".mp3" => Some("audio/mpeg")
    ".mp4" => Some("video/mp4")
    ".oga" => Some("audio/ogg")
    ".ogg" => Some("audio/ogg")
    ".ogv" => Some("video/ogg")
    ".opus" => Some("audio/ogg")
    ".pdf" => Some("application/pdf")
    ".pjp" => Some("image/jpeg")
    ".pjpeg" => Some("image/jpeg")
    ".png" => Some("image/png")
    ".ppt" => Some("application/vnd.ms-powerpoint")
    ".pptx" => Some("application/vnd.openxmlformats-officedocument.presentationml.presentation")
    ".ps" => Some("application/postscript")
    ".rdf" => Some("application/rdf+xml")
    ".rtf" => Some("application/rtf")
    ".shtml" => Some("text/html; charset=utf-8")
    ".svg" => Some("image/svg+xml")
    ".text" => Some("text/plain; charset=utf-8")
    ".tif" => Some("image/tiff")
    ".tiff" => Some("image/tiff")
    ".txt" => Some("text/plain; charset=utf-8")
    ".vtt" => Some("text/vtt; charset=utf-8")
    ".wasm" => Some("application/wasm")
    ".wav" => Some("audio/wav")
    ".webm" => Some("audio/webm")
    ".webp" => Some("image/webp")
    ".xbl" => Some("text/xml; charset=utf-8")
    ".xbm" => Some("image/x-xbitmap")
    ".xht" => Some("application/xhtml+xml")
    ".xhtml" => Some("application/xhtml+xml")
    ".xls" => Some("application/vnd.ms-excel")
    ".xlsx" => Some("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
    ".xml" => Some("text/xml; charset=utf-8")
    ".xsl" => Some("text/xml; charset=utf-8")
    ".zip" => Some("application/zip")
    _ => None
  }
}

fn type_by_extension(ext: Str) -> Str? {
  if let Some(t) = builtin_type(ext) {
    return Some(t)
  }
  // Go lowers ASCII letters, or the whole text when it is not ASCII; an
  // extension with neither (most misses) cannot match lowered
  var upper = false
  for c in ext.bytes() {
    if c >= 65 && c <= 90 || c >= 128 {
      upper = true
      break
    }
  }
  if !upper {
    return None
  }
  builtin_type(ext.to_lower())
}

fn extensions_by_type(kind: Str) -> List[Str] ! mime.MimeErr {
  let t = parse_media_type(kind)?.kind
  var out: List[Str] = []
  for (k, v) in BUILTIN {
    if (parse_media_type(v).ok() ?? mime.MediaType{kind: "", params: {}}).kind == t {
      out.push(k)
    }
  }
  out.sort()
}

// ---------------------------------------------------------------------------
// Content sniffing (net/http sniff.go of go1.26: DetectContentType)

enum Sig {
  Html(p: Bytes)
  Masked(mask: Bytes, pat: Bytes, skip_ws: Bool, ct: Str)
  Exact(sig: Bytes, ct: Str)
  Mp4
  Text
}

/// sniff.go's sniffSignatures in order, made once (sigs() built the list,
/// and each HTML pattern's Bytes, on every call: 2026-10-26, with the
/// slices below, detect_content_type ran at 8.3x Go's time).
const SIGS: List[Sig] = [
  Sig.Html(p: b"<!DOCTYPE HTML"),
  Sig.Html(p: b"<HTML"),
  Sig.Html(p: b"<HEAD"),
  Sig.Html(p: b"<SCRIPT"),
  Sig.Html(p: b"<IFRAME"),
  Sig.Html(p: b"<H1"),
  Sig.Html(p: b"<DIV"),
  Sig.Html(p: b"<FONT"),
  Sig.Html(p: b"<TABLE"),
  Sig.Html(p: b"<A"),
  Sig.Html(p: b"<STYLE"),
  Sig.Html(p: b"<TITLE"),
  Sig.Html(p: b"<B"),
  Sig.Html(p: b"<BODY"),
  Sig.Html(p: b"<BR"),
  Sig.Html(p: b"<P"),
  Sig.Html(p: b"<!--"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\xFF", pat: b"<?xml", skip_ws: true, ct: "text/xml; charset=utf-8"),
    Sig.Exact(sig: b"%PDF-", ct: "application/pdf"),
    Sig.Exact(sig: b"%!PS-Adobe-", ct: "application/postscript"),
    Sig.Masked(mask: b"\xFF\xFF\x00\x00", pat: b"\xFE\xFF\x00\x00", skip_ws: false, ct: "text/plain; charset=utf-16be"),
    Sig.Masked(mask: b"\xFF\xFF\x00\x00", pat: b"\xFF\xFE\x00\x00", skip_ws: false, ct: "text/plain; charset=utf-16le"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\x00", pat: b"\xEF\xBB\xBF\x00", skip_ws: false, ct: "text/plain; charset=utf-8"),
    Sig.Exact(sig: b"\x00\x00\x01\x00", ct: "image/x-icon"),
    Sig.Exact(sig: b"\x00\x00\x02\x00", ct: "image/x-icon"),
    Sig.Exact(sig: b"BM", ct: "image/bmp"),
    Sig.Exact(sig: b"GIF87a", ct: "image/gif"),
    Sig.Exact(sig: b"GIF89a", ct: "image/gif"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF\xFF\xFF", pat: b"RIFF\x00\x00\x00\x00WEBPVP", skip_ws: false, ct: "image/webp"),
    Sig.Exact(sig: b"\x89PNG\x0D\x0A\x1A\x0A", ct: "image/png"),
    Sig.Exact(sig: b"\xFF\xD8\xFF", ct: "image/jpeg"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", pat: b"FORM\x00\x00\x00\x00AIFF", skip_ws: false, ct: "audio/aiff"),
    Sig.Masked(mask: b"\xFF\xFF\xFF", pat: b"ID3", skip_ws: false, ct: "audio/mpeg"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\xFF", pat: b"OggS\x00", skip_ws: false, ct: "application/ogg"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF", pat: b"MThd\x00\x00\x00\x06", skip_ws: false, ct: "audio/midi"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", pat: b"RIFF\x00\x00\x00\x00AVI ", skip_ws: false, ct: "video/avi"),
    Sig.Masked(mask: b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", pat: b"RIFF\x00\x00\x00\x00WAVE", skip_ws: false, ct: "audio/wave"),
    Sig.Mp4,
    Sig.Exact(sig: b"\x1A\x45\xDF\xA3", ct: "video/webm"),
    Sig.Masked(mask: b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xFF\xFF", pat: b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00LP", skip_ws: false, ct: "application/vnd.ms-fontobject"),
    Sig.Exact(sig: b"\x00\x01\x00\x00", ct: "font/ttf"),
    Sig.Exact(sig: b"OTTO", ct: "font/otf"),
    Sig.Exact(sig: b"ttcf", ct: "font/collection"),
    Sig.Exact(sig: b"wOFF", ct: "font/woff"),
    Sig.Exact(sig: b"wOF2", ct: "font/woff2"),
    Sig.Exact(sig: b"\x1F\x8B\x08", ct: "application/x-gzip"),
    Sig.Exact(sig: b"PK\x03\x04", ct: "application/zip"),
    Sig.Exact(sig: b"Rar!\x1A\x07\x00", ct: "application/x-rar-compressed"),
    Sig.Exact(sig: b"Rar!\x1A\x07\x01\x00", ct: "application/x-rar-compressed"),
    Sig.Exact(sig: b"\x00\x61\x73\x6D", ct: "application/wasm"),
    Sig.Text,
]

fn is_ws(b: UInt8) -> Bool { b == 9 || b == 10 || b == 12 || b == 13 || b == 32 }

/// Whether data starts with p, compared in place (a slice copies).
fn has_prefix(data: Bytes, p: Bytes) -> Bool {
  if data.len() < p.len() {
    return false
  }
  for i in 0..p.len() {
    if data[i] != p[i] {
      return false
    }
  }
  true
}

fn sig_match(s: Sig, data: Bytes, first: Int) -> Str {
  match s {
    Html(h) => {
      // data from first, by offset (a slice copied the data per pattern)
      if data.len() - first < h.len() + 1 {
        return ""
      }
      for i in 0..h.len() {
        var db = data[first + i]
        if h[i] >= 65 && h[i] <= 90 {
          db = db & 0xDF
        }
        if h[i] != db {
          return ""
        }
      }
      let t = data[first + h.len()]
      if t == 32 || t == 62 { "text/html; charset=utf-8" } else { "" }
    }
    Masked(mask, pat, skip_ws, ct) => {
      let o = if skip_ws { first } else { 0 }
      if pat.len() != mask.len() || data.len() - o < pat.len() {
        return ""
      }
      for i in 0..pat.len() {
        if (data[o + i] & mask[i]) != pat[i] {
          return ""
        }
      }
      ct
    }
    Exact(sig, ct) => if has_prefix(data, sig) { ct } else { "" }
    Mp4 => {
      if data.len() < 12 {
        return ""
      }
      let box = (Int(data[0]) << 24) | (Int(data[1]) << 16) | (Int(data[2]) << 8) | Int(data[3])
      if data.len() < box || box % 4 != 0 {
        return ""
      }
      if data[4] != 102 || data[5] != 116 || data[6] != 121 || data[7] != 112 {
        return ""
      }
      var st = 8
      while st < box {
        if st != 12 && data[st] == 109 && data[st + 1] == 112 && data[st + 2] == 52 {
          return "video/mp4"
        }
        st += 4
      }
      ""
    }
    Text => {
      var i = first
      while i < data.len() {
        let b = data[i]
        if b <= 8 || b == 11 || (b >= 14 && b <= 26) || (b >= 28 && b <= 31) {
          return ""
        }
        i += 1
      }
      "text/plain; charset=utf-8"
    }
  }
}

fn detect_content_type(data0: Bytes) -> Str {
  let data = if data0.len() > 512 { data0[0..512] } else { data0 }
  var first = 0
  while first < data.len() && is_ws(data[first]) {
    first += 1
  }
  for s in SIGS {
    let ct = sig_match(s, data, first)
    if !ct.is_empty() {
      return ct
    }
  }
  "application/octet-stream"
}
