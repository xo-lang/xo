// The C library and sanitizer runtime functions the native runtime calls
// from Xo on every native OS (decision 0232): a declaration file like
// sys_darwin.xo, imported only by runtime modules (decision 0074). Each
// bodiless function is a C ABI call of the symbol of its name (an Int
// argument one word, Bytes the address of its data, an Int32 result a C
// int, sign extended); a call in a wasm module is a fault. A name that
// starts with `weak_` is a weak reference to the symbol after the prefix:
// it links when nothing defines it (the address is then 0, which
// rt.sym_present("name") tells), so the sanitizers' functions can be
// called from a build that may or may not link their runtime. Every
// declaration says why the runtime needs it rather than a system call.

/// ThreadSanitizer's fiber API and its happens-before edges (the
/// sanitizer hooks of fiber switches, std/native/llrt/sanhook.xo): Xo
/// code is not instrumented, so it tells the sanitizer what it does.
fn weak___tsan_get_current_fiber() -> Int
fn weak___tsan_create_fiber(flags: Int) -> Int
fn weak___tsan_destroy_fiber(fiber: Int)
fn weak___tsan_switch_to_fiber(fiber: Int, flags: Int)
fn weak___tsan_acquire(addr: Int)
fn weak___tsan_release(addr: Int)

/// The C library's allocator, for a --race build's heap (decision 0273
/// mode 2, heapos.xo large_room: its interceptors reset a block's shadow
/// memory)
fn weak_malloc(n: Int) -> Int
fn weak_free(p: Int)
/// Defined (int xo_tsan_runtime) by the runtime's own race tests' builds
/// (decision 0273 mode 1, sanhook.xo user_mode)
fn weak_xo_tsan_runtime() -> Int

/// AddressSanitizer's fiber API: which stack runs.
fn weak___sanitizer_start_switch_fiber(fake_stack_save: Int, bottom: Int, size: Int)
fn weak___sanitizer_finish_switch_fiber(fake_stack_save: Int, bottom_old: Int, size_old: Int)

/// qsort(3), for std/internal rt_probe's "qsort_fault" only (decision
/// 0241: a fault raised in a callback of the C library, so its frames sit
/// between the fault and the frame that catches it); a program that does
/// not call that probe does not reference it.
fn qsort(base: Int, n: Int, size: Int, cmp: Int)

/// getpid(2), for the check of this module itself (internal.crypto_op's
/// "sysc." op, the sys_c golden): a strong reference every C library has.
fn getpid() -> Int32

/// The runtime's threads on Linux (std/native/llrt/sanhook.xo
/// thread_start): glibc's pthread_create sets up the thread's state
/// (thread locals, errno, cancellation) that a raw clone would not; an
/// XO_NOLIBC build resolves these to cabi_libc.xo's exports.
fn pthread_attr_init(attr: Int) -> Int32
fn pthread_attr_setstacksize(attr: Int, size: Int) -> Int32
fn pthread_attr_setdetachstate(attr: Int, state: Int) -> Int32
fn pthread_attr_destroy(attr: Int) -> Int32
fn pthread_create(thread: Int, attr: Int, f: Int, arg: Int) -> Int32
fn pthread_join(thread: Int, ret: Int) -> Int32

/// Fiber stacks under ThreadSanitizer on Linux (sanhook.xo stack_map):
/// its mmap interceptor keeps the mapping in its application ranges,
/// which a system call bypasses.
fn mmap(addr: Int, size: Int, prot: Int, flags: Int, fd: Int, off: Int) -> Int
fn mprotect(addr: Int, size: Int, prot: Int) -> Int32
fn munmap(addr: Int, size: Int) -> Int32
/// errno's address (glibc's and musl's name; weak: the arm64 emitter
/// keeps the Linux arm in a macOS build, whose C library calls it
/// __error).
fn weak___errno_location() -> Int
