fn idnaerr_display(e: idna.IdnaErr) -> Str { e.msg }

fn unicode_version() -> Str { UNICODE_VERSION }

/// label as Go's %q writes it: a printable rune (strconv.IsPrint) as it is,
/// any other with a \x, \u or \U escape.
fn quote_label(label: Str) -> Str {
  var b = StrBuilder.new()
  b.write("\"")
  for rr in label.runes() {
    let r = Int(rr)
    if r == 34 {
      b.write("\\\"")
    } else if r == 92 {
      b.write("\\\\")
    } else if r == 10 {
      b.write("\\n")
    } else if r == 13 {
      b.write("\\r")
    } else if r == 9 {
      b.write("\\t")
    } else if r >= 32 && r < 127 {
      b.write("${rr}")
    } else if r < 32 || r == 127 {
      b.write("\\x${hex(r, 2)}")
    } else if r >= 128 && rr.is_print() {
      b.write("${rr}")
    } else if r < 0x10000 {
      b.write("\\u${hex(r, 4)}")
    } else {
      b.write("\\U${hex(r, 8)}")
    }
  }
  b.write("\"")
  b.freeze()
}

fn hex(r: Int, w: Int) -> Str {
  var h = r.to_str_base(16)
  while h.len() < w {
    h = "0${h}"
  }
  h
}

fn hex_upper(r: Int) -> Str {
  let digits = "0123456789ABCDEF"
  var h = ""
  var x = r
  while x > 0 || h.len() < 4 {
    h = "${digits[x % 16..x % 16 + 1]}${h}"
    x = x / 16
  }
  h
}

fn ascii_lower(s: Str) -> Str {
  var b = BytesBuilder.with_capacity(s.len())
  for c in s.bytes() {
    b.write_byte(if c >= 65 && c <= 90 { c + 32 } else { c })
  }
  b.freeze().to_str() ?? s
}

fn label_err(label: Str, code: Str) -> idna.IdnaErr {
  idna.IdnaErr{code: code, msg: "idna: invalid label ${quote_label(label)}"}
}

fn rune_err(r: Int, code: Str) -> idna.IdnaErr {
  var h = hex_upper(r)
  idna.IdnaErr{code: code, msg: "idna: disallowed rune U+${h}"}
}

/// The varint of MAPS at p: (value, position after it).
fn vint(p0: Int) -> (Int, Int) {
  var p = p0
  var v = 0
  var s = 0
  while true {
    let c = Int(MAPS[p])
    p += 1
    v = v | ((c & 0x7f) << s)
    if c < 0x80 {
      break
    }
    s += 7
  }
  (v, p)
}

const REC: Int = 7

/// The data of rune r: category, flags (join type | attributes << 3 | may
/// need norm << 5 | bidi << 6), Bidi class, the kind of mapping (0 none, 1 one
/// rune by a delta, 2 a string in MAPS) and the mapping's data, packed as
/// category | flags << 8 | class << 16 | kind << 24 | data << 32; found by
/// binary search of RANGES for the last range starting at or before r.
fn lookup(r: Int) -> Int {
  var lo = 0
  var hi = RANGES.len() / REC - 1
  if r < 0x80 {
    lo = Int(ASCII_RANGE[r])
    hi = lo
  } else if r < 0x3400 {
    let b = (r >> 6) * 2
    lo = Int(BLOCKS[b]) | (Int(BLOCKS[b + 1]) << 8)
    hi = Int(BLOCKS[b + 2]) | (Int(BLOCKS[b + 3]) << 8)
  }
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    let q = mid * REC
    let start = Int(RANGES[q]) | (Int(RANGES[q + 1]) << 8) | (Int(RANGES[q + 2]) << 16)
    if start <= r {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  let q = lo * REC
  let data = Int(RANGES[q + 4]) | (Int(RANGES[q + 5]) << 8) | (Int(RANGES[q + 6]) << 16)
  let n = Int(RANGES[q + 3]) * 4
  Int(INFOS[n]) | (Int(INFOS[n + 1]) << 8) | (Int(INFOS[n + 2]) << 16) | (Int(INFOS[n + 3]) << 24) | (data << 32)
}

fn cat_of(v: Int) -> Int { v & 0xFF }
fn flags_of(v: Int) -> Int { (v >> 8) & 0xFF }
fn class_of(v: Int) -> Int { (v >> 16) & 0xFF }
fn is_mapped(v: Int) -> Bool {
  let c = v & 0xFF
  c == MAPPED || c == STD3_MAPPED || c == DEVIATION
}
fn join_type(v: Int) -> Int { if is_mapped(v) { 0 } else { flags_of(v) & 7 } }
fn attr_of(v: Int) -> Int { (flags_of(v) >> 3) & 3 }
fn may_need_norm(v: Int) -> Bool { (flags_of(v) >> 5) & 1 == 1 }
fn kind_of(v: Int) -> Int { (v >> 24) & 0xFF }
fn is_bidi(v: Int) -> Bool { (flags_of(v) >> 6) & 1 == 1 }
/// A modifier or a virama (not a mapped rune).
fn is_modifier(v: Int) -> Bool { !is_mapped(v) && attr_of(v) >= 2 }
fn is_virama(v: Int) -> Bool { !is_mapped(v) && attr_of(v) == 3 }

/// The mapping of rune r whose lookup value is v.
fn mapping_runes(v: Int, r: Int) -> List[Int] {
  var out: List[Int] = []
  let data = v >> 32
  if kind_of(v) == 1 {
    let d = if data & 1 == 1 { 0 - (data + 1) / 2 } else { data / 2 }
    out.push(r + d)
  } else {
    let (m, p) = vint(data - 1)
    var q = p
    for _ in 0..m {
      let (x, q2) = vint(q)
      out.push(x)
      q = q2
    }
  }
  out
}

struct Opts {
  transitional: Bool
  std3: Bool
  hyphens: Bool
  joiners: Bool
  dns_len: Bool
  leading_dots: Bool
  /// 0 none, 1 validateAndMap, 2 validateRegistration
  mapping: Int
  from_puny: Bool
  bidirule: Bool
}

fn opts_of(p: idna.Profile) -> Opts {
  match p {
    Lookup | Display => Opts{transitional: false, std3: true, hyphens: true, joiners: true, dns_len: false, leading_dots: false, mapping: 1, from_puny: true, bidirule: true}
    Registration => Opts{transitional: false, std3: true, hyphens: true, joiners: true, dns_len: true, leading_dots: false, mapping: 2, from_puny: true, bidirule: true}
    Punycode => Opts{transitional: false, std3: false, hyphens: false, joiners: false, dns_len: false, leading_dots: false, mapping: 0, from_puny: false, bidirule: false}
  }
}

/// simplify: the category with the STD3 and transitional rules applied.
fn simplify(o: Opts, cat: Int) -> Int {
  if cat == STD3_MAPPED {
    return if o.std3 { DISALLOWED } else { MAPPED }
  }
  if cat == STD3_VALID {
    return if o.std3 { DISALLOWED } else { VALID }
  }
  if cat == DEVIATION {
    return if o.transitional { DEVIATION } else { VALID }
  }
  if cat == VALID_NV8 || cat == VALID_XV8 {
    return VALID
  }
  cat
}

fn allowed_std3(r: Int) -> Bool {
  r >= 0x80 || (r >= 97 && r <= 122) || (r >= 48 && r <= 57) || r == 45 || r == 46
}

/// Whether the Bidi class c is in the set of masks (a uint16 mask, as bidirule's).
fn in_mask(c: Int, mask: Int) -> Bool {
  c < 16 && (mask >> c) & 1 == 1
}

/// bidirule.DirectionString: whether s has a right to left rune (R, AL or AN).
fn direction_rtl(s: Str) -> Bool {
  for r in s.runes() {
    let c = class_of(lookup(Int(r)))
    if c == B_R || c == B_AL || c == B_AN {
      return true
    }
  }
  false
}

/// bidirule.ValidString.
fn bidi_valid(s: Str) -> Bool {
  // states: 0 initial, 1 LTR, 2 LTR final, 3 RTL, 4 RTL final, 5 invalid
  var state = 0
  var seen = 0
  let ltr_first = 1 << B_L
  let rtl_first = (1 << B_R) | (1 << B_AL)
  let rtl_end = (1 << B_R) | (1 << B_AL) | (1 << B_EN) | (1 << B_AN)
  let mid = (1 << B_ES) | (1 << B_CS) | (1 << B_ET) | (1 << B_ON) | (1 << B_BN)
  for r in s.runes() {
    let cl = class_of(lookup(Int(r)))
    let c = if cl < 16 { 1 << cl } else { 0 }
    seen = seen | c
    let en_an = (1 << B_EN) | (1 << B_AN)
    if seen & en_an == en_an {
      return false
    }
    var next = 5
    var m0 = 0
    var n0 = 5
    var m1 = 0
    var n1 = 5
    if state == 0 {
      m0 = ltr_first
      n0 = 2
      m1 = rtl_first
      n1 = 4
    } else if state == 3 {
      m0 = rtl_end
      n0 = 4
      m1 = mid | (1 << B_NSM)
      n1 = 3
    } else if state == 4 {
      m0 = rtl_end | (1 << B_NSM)
      n0 = 4
      m1 = mid
      n1 = 3
    } else if state == 1 {
      m0 = (1 << B_L) | (1 << B_EN)
      n0 = 2
      m1 = mid | (1 << B_NSM)
      n1 = 1
    } else if state == 2 {
      m0 = (1 << B_L) | (1 << B_EN) | (1 << B_NSM)
      n0 = 2
      m1 = mid
      n1 = 1
    }
    if m0 & c != 0 {
      next = n0
    } else if m1 & c != 0 {
      next = n1
    } else {
      next = 5
      if seen & ((1 << B_R) | (1 << B_AL) | (1 << B_AN)) != 0 {
        return false
      }
    }
    state = next
  }
  state == 2 || state == 4 || state == 0
}

// punycode (RFC 3492), punycode.go

const BASE: Int = 36
const DAMP: Int = 700
const INITIAL_BIAS: Int = 72
const INITIAL_N: Int = 128
const SKEW: Int = 38
const TMAX: Int = 26
const TMIN: Int = 1
const MAX_I32: Int = Int(Int32.max)

fn puny_err(s: Str) -> idna.IdnaErr { label_err(s, "A3") }

/// madd: a + b*c, or None when it passes the int32 range.
fn madd(a: Int, b: Int, c: Int) -> Int? {
  let p = b * c
  if p > MAX_I32 - a {
    return None
  }
  Some(a + p)
}

fn decode_digit(x: Int) -> Int {
  if x >= 48 && x <= 57 {
    return x - 22
  }
  if x >= 65 && x <= 90 {
    return x - 65
  }
  if x >= 97 && x <= 122 {
    return x - 97
  }
  -1
}

fn encode_digit(d: Int) -> Int { if d < 26 { d + 97 } else { d + 22 } }

fn adapt(delta0: Int, num_points: Int, first: Bool) -> Int {
  var delta = if first { delta0 / DAMP } else { delta0 / 2 }
  delta += delta / num_points
  var k = 0
  while delta > ((BASE - TMIN) * TMAX) / 2 {
    delta /= BASE - TMIN
    k += BASE
  }
  k + (BASE - TMIN + 1) * delta / (delta + SKEW)
}

fn decode(encoded: Str) -> Str ! idna.IdnaErr {
  if encoded.is_empty() {
    return ""
  }
  let pos0 = 1 + (encoded.rfind("-") ?? -1)
  if pos0 == 1 {
    return Err(puny_err(encoded))
  }
  if pos0 == encoded.len() {
    return encoded[0..encoded.len() - 1]
  }
  var output: List[Int] = []
  if pos0 != 0 {
    for r in encoded[0..pos0 - 1].runes() {
      output.push(Int(r))
    }
  }
  let bytes = encoded.bytes()
  var pos = pos0
  var i = 0
  var n = INITIAL_N
  var bias = INITIAL_BIAS
  while pos < encoded.len() {
    let old_i = i
    var w = 1
    var k = BASE
    while true {
      if pos == encoded.len() {
        return Err(puny_err(encoded))
      }
      let digit = decode_digit(Int(bytes[pos]))
      if digit < 0 {
        return Err(puny_err(encoded))
      }
      pos += 1
      match madd(i, digit, w) {
        Some(v) => i = v
        None => return Err(puny_err(encoded))
      }
      var t = k - bias
      if k <= bias {
        t = TMIN
      } else if k >= bias + TMAX {
        t = TMAX
      }
      if digit < t {
        break
      }
      match madd(0, w, BASE - t) {
        Some(v) => w = v
        None => return Err(puny_err(encoded))
      }
      k += BASE
    }
    if output.len() >= 1024 {
      return Err(puny_err(encoded))
    }
    let x = output.len() + 1
    bias = adapt(i - old_i, x, old_i == 0)
    n += i / x
    i = i % x
    if n < 0 || n > 0x10FFFF {
      return Err(puny_err(encoded))
    }
    output.insert(i, n)
    i += 1
  }
  var sb = BytesBuilder.with_capacity(output.len() * 3)
  for r in output {
    // a surrogate is a valid code point to the 0..0x10FFFF check but not a
    // Rune: Go's string(rune) makes it U+FFFD, which the profiles then
    // refuse or the Punycode profile passes (b27, 2026-11-04)
    sb.write_rune(Rune(if r >= 0xD800 && r <= 0xDFFF { 0xFFFD } else { r }))
  }
  sb.freeze().to_str() ?? ""
}

fn encode(prefix: Str, s: Str) -> Str ! idna.IdnaErr {
  var out = BytesBuilder.with_capacity(prefix.len() + s.len() + 8)
  out.write_str(prefix)
  var delta = 0
  var n = INITIAL_N
  var bias = INITIAL_BIAS
  var b = 0
  var remaining = 0
  let rs = s.runes()
  for r in rs {
    if Int(r) < 0x80 {
      b += 1
      out.write_rune(r)
    } else {
      remaining += 1
    }
  }
  var h = b
  if b > 0 {
    out.write_byte(45)
  }
  while remaining != 0 {
    var m = MAX_I32
    for r in rs {
      let x = Int(r)
      if m > x && x >= n {
        m = x
      }
    }
    match madd(delta, m - n, h + 1) {
      Some(v) => delta = v
      None => return Err(puny_err(s))
    }
    n = m
    for r in rs {
      let x = Int(r)
      if x < n {
        delta += 1
        if delta > MAX_I32 {
          return Err(puny_err(s))
        }
        continue
      }
      if x > n {
        continue
      }
      var q = delta
      var k = BASE
      while true {
        var t = k - bias
        if k <= bias {
          t = TMIN
        } else if k >= bias + TMAX {
          t = TMAX
        }
        if q < t {
          break
        }
        out.write_byte(UInt8(encode_digit(t + (q - t) % (BASE - t))))
        q = (q - t) / (BASE - t)
        k += BASE
      }
      out.write_byte(UInt8(encode_digit(q)))
      bias = adapt(delta, h + 1, h == b)
      delta = 0
      h += 1
      remaining -= 1
    }
    delta += 1
    n += 1
  }
  rt.cast[Bytes, Str](out.freeze())
}

// idna.go

struct Mapped {
  s: Str
  bidi: Bool
  err: idna.IdnaErr?
}

/// validateAndMap.
fn validate_and_map(o: Opts, s: Str) -> Mapped {
  // plain ASCII names (letters, digits, hyphen, dot): valid, or an upper case
  // letter mapped to its lower case, as the tables say
  var plain = true
  var upper = false
  for c in s.bytes() {
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 {
      continue
    }
    if c >= 65 && c <= 90 {
      upper = true
      continue
    }
    plain = false
    break
  }
  if plain {
    return Mapped{s: if upper { ascii_lower(s) } else { s }, bidi: false, err: None}
  }
  var b = BytesBuilder.new()
  var k = 0
  var at = 0
  var err: idna.IdnaErr? = None
  var bits = 0
  var bidi = false
  let sb = s.bytes()
  let n = sb.len()
  var pos = 0
  while pos < n {
    let ru = rune_at(sb, pos)
    let r = ru & 0xFFFFFFFF
    let sz = ru >> 32
    pos += sz
    if (r >= 97 && r <= 122) || (r >= 48 && r <= 57) || r == 45 || r == 46 {
      // plain ASCII: valid, never mapped, no flags, as in the plain name shortcut
      at += 1
      continue
    }
    let v = lookup(r)
    bits = bits | flags_of(v) << 8 | cat_of(v)
    if may_need_norm(v) {
      bits = bits | 0x10000
    }
    bidi = bidi || (is_bidi(v))
    let start = at
    at += sz
    let c = simplify(o, cat_of(v))
    if c == VALID {
      continue
    }
    if c == DISALLOWED {
      if err.is_none() {
        err = Some(rune_err(r, "P1"))
      }
      continue
    }
    if c == DEVIATION || c == MAPPED {
      b.write_str(s[k..start])
      for m in mapping_runes(v, r) {
        b.write_rune(Rune(m))
      }
    } else if c == IGNORED {
      b.write_str(s[k..start])
    } else {
      // unknown
      b.write_str(s[k..start])
      b.write_rune(Rune(0xFFFD))
    }
    k = at
  }
  var out = s
  if k == 0 {
    if bits & 0x10000 != 0 {
      out = norm.normalize(s, norm.Form.Nfc)
    }
  } else {
    b.write_str(s[k..s.len()])
    out = norm.normalize(b.freeze().to_str() ?? s, norm.Form.Nfc)
  }
  Mapped{s: out, bidi: bidi, err: err}
}

/// validateRegistration.
fn validate_registration(o: Opts, s: Str) -> Mapped {
  if !norm.is_normalized(s, norm.Form.Nfc) {
    return Mapped{s: s, bidi: false, err: Some(label_err(s, "V1"))}
  }
  var bidi = false
  for rr in s.runes() {
    let r = Int(rr)
    let v = lookup(r)
    bidi = bidi || is_bidi(v)
    let c = simplify(o, cat_of(v))
    if c == VALID || c == DEVIATION {
      if r < 0x80 && o.std3 && !allowed_std3(r) {
        return Mapped{s: s, bidi: bidi, err: Some(rune_err(r, "P1"))}
      }
    } else {
      return Mapped{s: s, bidi: bidi, err: Some(rune_err(r, "P1"))}
    }
  }
  Mapped{s: s, bidi: bidi, err: None}
}

/// validateFromPunycode.
fn validate_from_puny(o: Opts, s: Str) -> idna.IdnaErr? {
  if !norm.is_normalized(s, norm.Form.Nfc) {
    return Some(label_err(s, "V1"))
  }
  for rr in s.runes() {
    let c = simplify(o, cat_of(lookup(Int(rr))))
    if c != VALID && c != DEVIATION {
      return Some(label_err(s, "V6"))
    }
  }
  None
}

/// validateLabel.
fn validate_label(o: Opts, s: Str, label_code: Str) -> idna.IdnaErr? {
  if s.is_empty() {
    if o.dns_len {
      return Some(label_err(s, label_code))
    }
    return None
  }
  if o.hyphens {
    let b = s.bytes()
    if s.len() > 4 && b[2] == 45 && b[3] == 45 {
      return Some(label_err(s, "V2"))
    }
    if b[0] == 45 || b[s.len() - 1] == 45 {
      return Some(label_err(s, "V3"))
    }
  }
  if !o.joiners || is_ascii_str(s) {
    return None
  }
  var first = true
  var st = 0
  var any_join = false
  let sb = s.bytes()
  let n = sb.len()
  var pos = 0
  while pos < n {
    let ru = rune_at(sb, pos)
    let r = ru & 0xFFFFFFFF
    pos += ru >> 32
    let v = lookup(r)
    if first {
      first = false
      if is_modifier(v) {
        return Some(label_err(s, "V5"))
      }
      if !has_joiner(s) {
        return None
      }
      any_join = true
    }
    var jt = join_type(v)
    if r == 0x200d {
      jt = JOIN_ZWJ
    } else if r == 0x200c {
      jt = JOIN_ZWNJ
    }
    st = Int(JOIN_STATES[st * 8 + jt])
    if is_virama(v) {
      st = Int(JOIN_STATES[st * 8 + JOIN_VIRAMA])
    }
  }
  if any_join && (st == ST_FAIL || st == ST_AFTER) {
    return Some(label_err(s, "C"))
  }
  None
}

/// The rune at byte offset p of valid UTF-8 and its width, packed as rune | width << 32.
fn rune_at(b: Bytes, p: Int) -> Int {
  let c = Int(b[p])
  if c < 0x80 {
    return c | (1 << 32)
  }
  if c >= 0xF0 {
    return (((c & 7) << 18) | ((Int(b[p + 1]) & 63) << 12) | ((Int(b[p + 2]) & 63) << 6) | (Int(b[p + 3]) & 63)) | (4 << 32)
  }
  if c >= 0xE0 {
    return (((c & 15) << 12) | ((Int(b[p + 1]) & 63) << 6) | (Int(b[p + 2]) & 63)) | (3 << 32)
  }
  (((c & 31) << 6) | (Int(b[p + 1]) & 63)) | (2 << 32)
}

/// Whether s holds U+200C or U+200D (E2 80 8C or E2 80 8D), in one pass.
fn has_joiner(s: Str) -> Bool {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i + 2 < n {
    if b[i] == 0xE2 && b[i + 1] == 0x80 && (b[i + 2] == 0x8C || b[i + 2] == 0x8D) {
      return true
    }
    i += 1
  }
  false
}

fn is_ascii_str(s: Str) -> Bool {
  for c in s.bytes() {
    if c >= 0x80 {
      return false
    }
  }
  true
}

/// labelIter: the labels of orig, or of slice once one is set (Go's quirks
/// about a trailing dot included).
struct LabelIter {
  orig: Str
  slice: List[Str]
  sliced: Bool
  cur_start: Int
  cur_end: Int
  i: Int
}

fn li_new(orig: Str) -> LabelIter {
  LabelIter{orig: orig, slice: [], sliced: false, cur_start: 0, cur_end: 0, i: 0}
}

fn li_reset(var l: LabelIter) {
  l.cur_start = 0
  l.cur_end = 0
  l.i = 0
}

fn li_done(l: LabelIter) -> Bool { l.cur_start >= l.orig.len() }

fn li_result(l: LabelIter) -> Str {
  if l.sliced {
    return l.slice.join(".")
  }
  l.orig
}

fn li_label(var l: LabelIter) -> Str {
  if l.sliced {
    return l.slice[l.i]
  }
  let b = l.orig.bytes()
  let n = b.len()
  var e = l.cur_start
  while e < n && b[e] != 46 {
    e += 1
  }
  l.cur_end = e
  l.orig[l.cur_start..e]
}

fn li_next(var l: LabelIter) {
  l.i += 1
  if l.sliced {
    if l.i >= l.slice.len() || (l.i == l.slice.len() - 1 && l.slice[l.i].is_empty()) {
      l.cur_start = l.orig.len()
    }
  } else {
    l.cur_start = l.cur_end + 1
    if l.cur_start == l.orig.len() - 1 && l.orig[l.cur_start..l.cur_start + 1] == "." {
      l.cur_start = l.orig.len()
    }
  }
}

fn li_set(var l: LabelIter, s: Str) {
  if !l.sliced {
    l.slice = l.orig.split(".")
    l.sliced = true
  }
  l.slice[l.i] = s
}

/// Profile.process.
fn process(o: Opts, s0: Str, to_ascii: Bool) -> (Str, idna.IdnaErr?) {
  var s = s0
  var err: idna.IdnaErr? = None
  var is_bidi_s = false
  if o.mapping == 1 {
    let m = validate_and_map(o, s)
    s = m.s
    is_bidi_s = m.bidi
    err = m.err
  } else if o.mapping == 2 {
    let m = validate_registration(o, s)
    s = m.s
    is_bidi_s = m.bidi
    err = m.err
  }
  if o.leading_dots {
    while s.starts_with(".") {
      s = s[1..s.len()]
    }
  }
  let label_code = "A4"
  if err.is_none() && o.dns_len && s.is_empty() {
    err = Some(label_err(s, label_code))
  }
  var labels = li_new(s)
  while !li_done(labels) {
    let label = li_label(labels)
    if label.is_empty() {
      if err.is_none() && o.dns_len {
        err = Some(label_err(s, label_code))
      }
      li_next(labels)
      continue
    }
    if label.starts_with("xn--") {
      let enc = label[4..label.len()]
      match decode(enc) {
        Err(e) => {
          if err.is_none() {
            err = Some(e)
          }
          li_next(labels)
          continue
        }
        Ok(u) => {
          if err.is_none() && !u.is_empty() && is_ascii_str(u) {
            err = Some(puny_err(enc))
          }
          is_bidi_s = is_bidi_s || direction_rtl(u)
          li_set(labels, u)
          if err.is_none() && o.from_puny {
            err = validate_from_puny(o, u)
          }
          if err.is_none() {
            err = validate_label(o, u, label_code)
          }
        }
      }
    } else if err.is_none() {
      err = validate_label(o, label, label_code)
    }
    li_next(labels)
  }
  if is_bidi_s && o.bidirule && err.is_none() {
    li_reset(labels)
    while !li_done(labels) {
      if !bidi_valid(li_label(labels)) {
        err = Some(label_err(s, "B"))
        break
      }
      li_next(labels)
    }
  }
  if to_ascii {
    li_reset(labels)
    while !li_done(labels) {
      var label = li_label(labels)
      if !is_ascii_str(label) {
        match encode("xn--", label) {
          Ok(a) => {
            label = a
            li_set(labels, a)
          }
          Err(e) => {
            if err.is_none() {
              err = Some(e)
            }
            label = ""
            li_set(labels, "")
          }
        }
      }
      let n = label.len()
      if o.dns_len && err.is_none() && (n == 0 || n > 63) {
        err = Some(label_err(label, label_code))
      }
      li_next(labels)
    }
  }
  s = li_result(labels)
  if to_ascii && o.dns_len && err.is_none() {
    var n = s.len()
    if n > 0 && s[n - 1..n] == "." {
      n -= 1
    }
    if s.len() < 1 || n > 253 {
      err = Some(label_err(s, label_code))
    }
  }
  (s, err)
}

fn to_ascii(domain: Str, p: idna.Profile = idna.Profile.Lookup) -> Str ! idna.IdnaErr {
  let (s, err) = process(opts_of(p), domain, true)
  match err {
    Some(e) => Err(e)
    None => Ok(s)
  }
}

fn to_unicode(domain: Str, p: idna.Profile = idna.Profile.Lookup) -> Str ! idna.IdnaErr {
  let (s, err) = process(opts_of(p), domain, false)
  match err {
    Some(e) => Err(e)
    None => Ok(s)
  }
}
