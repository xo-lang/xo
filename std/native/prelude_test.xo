// Map against an insertion-ordered list of pairs (decision 0262; they
// replace the map_model golden). spec/std.md: put on an existing key
// keeps its position. Sequences of puts and removes over small key
// spaces, so maps cross the tableless small map's size (compiler/ssa
// map.xo SMALL_MAP, 5) both ways: after every step the length, the keys
// in order, every value, a missing key, and equality with a map built
// fresh from the model. Int and Str keys (the Str keys share lengths and
// prefixes: the small map compares lengths first).

use native/rt
use native/llrt/heapos

// rt.list_swap2 (decision 0374 step 3a) is here for the same reason. Its
// counting row reads one string's own count (its object's first word,
// as llrt/obj.xo's count does) and not the free-list total: a string
// allocated and freed inside the measured window moves heapos.nfree on
// its own, so a two-list helper changed the total with no swap at all.

// rt.list_swap (decision 0374 step 1) lives in native/rt. Its tests are
// here rather than in a test file beside that module: a test module takes
// the name of a source module beside it, and native/rt's source is
// declarations only, so `xo test --std-module=native/rt` reports no tests
// at all, and the heapos import below would close a cycle through obj
// (obj -> darwin/linux/sysio/windows -> obj). This module is above all of
// them. An element is swapped as words, so a Bool's byte, a two word Str
// and a multi word struct all keep their layout, and no element is
// counted or released: a permutation leaves each one referenced exactly
// as often, which the reference count row below reads after the list is
// dropped.

/// Every class's free list count (heapos.nfree, which entry.xo's heapstats
/// sums the same way): a swap that counted or released an element would
/// show here once the list dies, since a value counted twice is never
/// freed and one released early is freed before its time.
fn swap_free_total() -> Int {
  var n = 0
  for c in 1..73 {
    n += heapos.nfree(c)
  }
  n
}

/// Two unique heap strings (a literal is immortal, so its count never
/// moves), swapped and then dropped with the list.
fn swap_heap_strs() -> Bool {
  var xs: List[Str] = ["alpha" + "!", "beta" + "!"]
  rt.list_swap(xs, 0, 1)
  xs == ["beta!", "alpha!"]
}

struct SwapPair {
  a: Str
  b: Int
}

test "list_swap: two Int elements trade places" {
  var xs = [3, 1, 4, 1, 5, 9]
  rt.list_swap(xs, 0, 5)
  expect(xs == [9, 1, 4, 1, 5, 3])
  rt.list_swap(xs, 2, 3)
  expect(xs == [9, 1, 1, 4, 5, 3])
}

test "list_swap: an element swapped with itself is unchanged" {
  var xs = [7, 8, 9]
  rt.list_swap(xs, 1, 1)
  expect(xs == [7, 8, 9])
}

test "list_swap: the last element swaps with the first" {
  var xs = [1, 2, 3, 4]
  rt.list_swap(xs, 3, 0)
  expect(xs == [4, 2, 3, 1])
}

test "list_swap: Bool elements swap as bytes" {
  var xs = [true, false, true]
  rt.list_swap(xs, 0, 1)
  expect(xs == [false, true, true])
}

test "list_swap: Str elements keep their text and their count" {
  var xs = ["alpha", "beta", "gamma"]
  // one more reference to the first, held outside the list across the
  // swap: the swap must not release what the list still holds
  let held = xs[0]
  rt.list_swap(xs, 0, 2)
  expect(xs == ["gamma", "beta", "alpha"])
  expect(held == "alpha")
  rt.list_swap(xs, 0, 1)
  expect(xs == ["beta", "gamma", "alpha"])
}

test "list_swap: struct elements swap whole" {
  var xs = [SwapPair{a: "one", b: 1}, SwapPair{a: "two", b: 2}]
  rt.list_swap(xs, 0, 1)
  expect(xs[0].a == "two")
  expect(xs[0].b == 2)
  expect(xs[1].a == "one")
  expect(xs[1].b == 1)
}

// Packed elements (decision 0369, on by default): the element is one, two
// or four bytes of the list's own array, so the swap's width has to be the
// element's and not a word's. wasm keeps eight byte elements, so these rows
// check its other path; the Go backend packs through its own types.

test "list_swap: packed UInt8 elements swap as single bytes" {
  var xs: List[UInt8] = [0, 1, 2, 250, 255]
  rt.list_swap(xs, 0, 4)
  var want: List[UInt8] = [255, 1, 2, 250, 0]
  expect(xs == want)
  rt.list_swap(xs, 1, 3)
  var want2: List[UInt8] = [255, 250, 2, 1, 0]
  expect(xs == want2)
}

test "list_swap: packed Int16 elements keep their sign" {
  // -32768 is the type's minimum: a swap that went through a wider or an
  // unsigned load would come back 32768 or something else
  var xs: List[Int16] = [-32768, 32767, 0, -1]
  rt.list_swap(xs, 0, 1)
  var want: List[Int16] = [32767, -32768, 0, -1]
  expect(xs == want)
  rt.list_swap(xs, 2, 3)
  var want2: List[Int16] = [32767, -32768, -1, 0]
  expect(xs == want2)
}

test "list_swap: packed UInt32 elements keep their high bit" {
  var xs: List[UInt32] = [4294967295, 0, 2147483648, 7]
  rt.list_swap(xs, 0, 2)
  var want: List[UInt32] = [2147483648, 0, 4294967295, 7]
  expect(xs == want)
  rt.list_swap(xs, 1, 3)
  var want2: List[UInt32] = [2147483648, 7, 4294967295, 0]
  expect(xs == want2)
}

test "list_swap: packed Float32 elements keep their values" {
  var xs: List[Float32] = [1.5, -2.25, 0.75]
  rt.list_swap(xs, 0, 1)
  var want: List[Float32] = [-2.25, 1.5, 0.75]
  expect(xs == want)
  rt.list_swap(xs, 1, 2)
  var want2: List[Float32] = [-2.25, 0.75, 1.5]
  expect(xs == want2)
}

test "list_swap: a two word tuple swaps both words" {
  var xs: List[(Int, Int)] = [(1, 2), (3, 4), (5, 6)]
  rt.list_swap(xs, 0, 2)
  var want: List[(Int, Int)] = [(5, 6), (3, 4), (1, 2)]
  expect(xs == want)
  rt.list_swap(xs, 0, 1)
  var want2: List[(Int, Int)] = [(3, 4), (5, 6), (1, 2)]
  expect(xs == want2)
}

test "list_swap: a Str swap changes no reference count" {
  let before = swap_free_total()
  expect(swap_heap_strs())
  let after = swap_free_total()
  expect(after == before)
}

test "list_swap: a swap inside a longer list disturbs nothing else" {
  var xs = [1, 2, 3, 4, 5, 6, 7, 8, 9]
  rt.list_swap(xs, 2, 6)
  expect(xs == [1, 2, 7, 4, 5, 6, 3, 8, 9])
}

// rt.list_swap2 (decision 0374 step 3): one element of each list trade
// places, so the two lists permute their elements between them and no
// element is counted or released either. a == b is the list_swap case,
// which the rows below check both ways.
test "list_swap2: two Int lists trade elements" {
  var xs = [3, 1, 4]
  var ys = [1, 5, 9]
  rt.list_swap2(xs, 0, ys, 2)
  expect(xs == [9, 1, 4])
  expect(ys == [1, 5, 3])
  rt.list_swap2(xs, 2, ys, 0)
  expect(xs == [9, 1, 1])
  expect(ys == [4, 5, 3])
}

test "list_swap2: the lists may differ in length" {
  var xs = [1, 2]
  var ys = [8, 9, 10, 11]
  rt.list_swap2(xs, 1, ys, 3)
  expect(xs == [1, 11])
  expect(ys == [8, 9, 10, 2])
}

test "list_swap2: the same list twice is list_swap" {
  var xs = [7, 8, 9]
  rt.list_swap2(xs, 0, xs, 2)
  expect(xs == [9, 8, 7])
  rt.list_swap2(xs, 1, xs, 1)
  expect(xs == [9, 8, 7])
}

test "list_swap2: Str elements keep their text and their count" {
  var xs = ["alpha", "beta", "gamma"]
  var ys = ["delta", "epsilon"]
  // one more reference to a moved element, held outside the lists across
  // the swap: the swap must not release what a list still holds
  let held = xs[0]
  rt.list_swap2(xs, 0, ys, 1)
  expect(xs == ["epsilon", "beta", "gamma"])
  expect(ys == ["delta", "alpha"])
  expect(held == "alpha")
  rt.list_swap2(xs, 2, ys, 0)
  expect(xs == ["epsilon", "beta", "delta"])
  expect(ys == ["gamma", "alpha"])
}

test "list_swap2: a cross-list Str swap changes no element's count" {
  // the count of a specific object, read from its first word (llrt/obj.xo
  // count does the same), before and after it crosses lists: the swap
  // must not retain or release either side, and each object must still be
  // the one the other slot held
  var xs: List[Str] = ["alpha" + "!", "beta" + "!"]
  var ys: List[Str] = ["gamma" + "!", "delta" + "!"]
  let px = rt.obj_addr(xs[0])
  let py = rt.obj_addr(ys[1])
  let cx = rt.slot_load(px, 0, 0)
  let cy = rt.slot_load(py, 0, 0)
  expect(cx == 1)
  expect(cy == 1)
  rt.list_swap2(xs, 0, ys, 1)
  // the counts are read before the identity checks: each obj_addr of an
  // element holds a temporary reference to the string, so a count read
  // after one sees 2 and not the swap's 1
  let c2x = rt.slot_load(px, 0, 0)
  let c2y = rt.slot_load(py, 0, 0)
  expect(c2x == cx)
  expect(c2y == cy)
  expect(rt.obj_addr(ys[1]) == px)
  expect(rt.obj_addr(xs[0]) == py)
}

test "list_swap2: packed UInt8 elements swap as single bytes" {
  var xs: List[UInt8] = [0, 1, 2]
  var ys: List[UInt8] = [250, 255, 7]
  rt.list_swap2(xs, 0, ys, 1)
  var w1: List[UInt8] = [255, 1, 2]
  var w2: List[UInt8] = [250, 0, 7]
  expect(xs == w1)
  expect(ys == w2)
  rt.list_swap2(xs, 2, ys, 0)
  var w3: List[UInt8] = [255, 1, 250]
  var w4: List[UInt8] = [2, 0, 7]
  expect(xs == w3)
  expect(ys == w4)
}

test "list_swap2: packed Int16 elements keep their sign" {
  // -32768 is the type's minimum: a swap that went through a wider or an
  // unsigned load would come back 32768 or something else
  var xs: List[Int16] = [-32768, 5]
  var ys: List[Int16] = [7, -2]
  rt.list_swap2(xs, 0, ys, 1)
  var w1: List[Int16] = [-2, 5]
  var w2: List[Int16] = [7, -32768]
  expect(xs == w1)
  expect(ys == w2)
}

test "list_swap2: a two word tuple swaps both words across lists" {
  var xs: List[(Int, Int)] = [(1, 2), (3, 4)]
  var ys: List[(Int, Int)] = [(5, 6)]
  rt.list_swap2(xs, 1, ys, 0)
  var w1: List[(Int, Int)] = [(1, 2), (5, 6)]
  var w2: List[(Int, Int)] = [(3, 4)]
  expect(xs == w1)
  expect(ys == w2)
}

test "list_swap2: a cross-list swap disturbs nothing else" {
  var xs = [1, 2, 3, 4, 5]
  var ys = [6, 7, 8, 9]
  rt.list_swap2(xs, 2, ys, 1)
  expect(xs == [1, 2, 7, 4, 5])
  expect(ys == [6, 3, 8, 9])
}

fn mm_next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

fn mm_find(ks: List[Int], k: Int) -> Int {
  for i in 0..ks.len() {
    if ks[i] == k {
      return i
    }
  }
  -1
}

fn mm_key(k: Int) -> Str {
  match k % 3 {
    0 => "key-${k + 10}"
    1 => "kex-${k + 10}"
    _ => "k-${k}"
  }
}

/// Applies ops (a step each: its key `op % space`, a remove when op % 3
/// is 2, else a put) to an Int map and the model; "" when they agree
/// after every step, else the first step that differs.
fn mm_int(ops: List[Int], space: Int) -> Str {
  var m: Map[Int, Int] = {}
  var ks: List[Int] = []
  var vs: List[Int] = []
  for (i, op0) in ops.indexed() {
    let op = op0 & 2147483647
    let k = op % space
    let at = mm_find(ks, k)
    if op % 3 == 2 {
      let _r = m.remove(k)
      if at >= 0 {
        let _a = ks.remove_at(at)
        let _b = vs.remove_at(at)
      }
    } else {
      m.put(k, i)
      if at >= 0 {
        vs[at] = i
      } else {
        ks.push(k)
        vs.push(i)
      }
    }
    var fresh: Map[Int, Int] = {}
    for j in 0..ks.len() {
      fresh.put(ks[j], vs[j])
    }
    if m.len() != ks.len() || m.keys() != ks || m.values() != vs || m.get(space + 1) != None || m != fresh {
      return "int step ${i}: map length ${m.len()}, model ${ks.len()}"
    }
  }
  ""
}

/// mm_int with Str keys (a remove when op % 4 is 3).
fn mm_str(ops: List[Int], space: Int) -> Str {
  var m: Map[Str, Int] = {}
  var ks: List[Int] = []
  var vs: List[Int] = []
  for (i, op0) in ops.indexed() {
    let op = op0 & 2147483647
    let k = op % space
    let at = mm_find(ks, k)
    if op % 4 == 3 {
      let _r = m.remove(mm_key(k))
      if at >= 0 {
        let _a = ks.remove_at(at)
        let _b = vs.remove_at(at)
      }
    } else {
      m.put(mm_key(k), i)
      if at >= 0 {
        vs[at] = i
      } else {
        ks.push(k)
        vs.push(i)
      }
    }
    var names: List[Str] = []
    var ok = m.len() == ks.len()
    for j in 0..ks.len() {
      names.push(mm_key(ks[j]))
      ok = ok && m.get(mm_key(ks[j])) == Some(vs[j])
    }
    if !ok || m.keys() != names || m.contains("k-999") {
      return "str step ${i}: map length ${m.len()}, model ${names.len()}"
    }
  }
  ""
}

/// The golden's sequences: n steps of the generator from seed.
fn mm_ops(seed: Int, n: Int, div: Int) -> List[Int] {
  var out: List[Int] = []
  var x = seed
  for _ in 0..n {
    x = mm_next(x)
    // the remove test (op % 3 or op % 4) is x's, as in the golden; the
    // key mixes x / div into it
    out.push(x / div * 12 + x % 12)
  }
  out
}

test "Map[Int, Int] against the model, 600 steps a key space" {
  for space in [3, 5, 6, 9, 16] {
    expect(mm_int(mm_ops(7 + space, 600, 7), space) == "")
  }
}

test "Map[Str, Int] against the model, 600 steps a key space" {
  for space in [4, 6, 11] {
    expect(mm_str(mm_ops(13 + space, 600, 11), space) == "")
  }
}

test "Map[Int, Int] against the model" for ops: List[Int], space: Int {
  expect(mm_int(ops, 1 + (space & 15)) == "")
}

test "Map[Str, Int] against the model" for ops: List[Int], space: Int {
  expect(mm_str(ops, 1 + (space & 15)) == "")
}

