test "go strconv: ParseInt, FormatInt, ParseBool, Unquote" {
  var bad: List[Str] = []
  for (s, base, want) in PARSE_INT {
    if Int.parse_base(s, base) != want {
      bad.push("parse ${s.quote()} base ${base}: got ${Int.parse_base(s, base).debug()} want ${want.debug()}")
    }
  }
  for (n, base, want) in FORMAT_INT {
    if n.to_str_base(base) != want {
      bad.push("format ${n} base ${base}: got ${n.to_str_base(base)} want ${want}")
    }
  }
  for (s, want) in PARSE_BOOL {
    if Bool.parse(s) != want {
      bad.push("bool ${s.quote()}")
    }
  }
  for (s, want) in UNQUOTE {
    if s.unquote() != want {
      bad.push("unquote ${s.quote()}: got ${s.unquote().debug()} want ${want.debug()}")
    }
  }
  expect(bad) == []
}

// Str.starts_with and Str.ends_with against a byte loop (scan.eq_at's
// 4 to 7 and 8 to 16 byte paths without a loop): every length 0 to 40,
// the whole affix matching and one byte off at each position.
fn affix_naive(s: Str, i: Int, p: Str) -> Bool {
  let a = s.bytes()
  let b = p.bytes()
  for k in 0..b.len() {
    if a[i + k] != b[k] {
      return false
    }
  }
  true
}

test "starts_with and ends_with at every length and mismatch position" {
  let letters = "abcdefghijklmnopqrstuvwxyz"
  var bad = 0
  for n in 0..41 {
    var p = ""
    for j in 0..n {
      let c = (j * 7 + 3) % 26
      p = p + letters[c..c + 1]
    }
    let s = "xx" + p + "yy"
    let head = s[2..s.len()]
    let tail = s[0..s.len() - 2]
    if !head.starts_with(p) || !tail.ends_with(p) {
      bad += 1
    }
    for d in 0..n {
      let q = p[0..d] + "#" + p[d + 1..n]
      if head.starts_with(q) != affix_naive(head, 0, q) || tail.ends_with(q) != affix_naive(tail, tail.len() - n, q) {
        bad += 1
      }
      if head.starts_with(q) || tail.ends_with(q) {
        bad += 1
      }
    }
  }
  expect(bad == 0)
}

// List.sort_in_place and List.sort_in_place_by (decision 0374 step 2): the
// receiver itself is sorted, stable exactly like sort and sort_by, a list
// another binding shares is copied before the sort writes, and the sizes
// around the 16 element insertion runs hold. They live here, not in a
// std/prelude_test.xo beside the declarations, because a --std-module=prelude
// test that uses a var list method is reported as XO1201 "support is planned"
// for every expression in it (the same for an old method: a test whose body
// is `var xs = [3, 1]`, `xs.push(4)`), which is not this change's.

struct SortRec {
  key: Int
  tag: Str
}

/// A key that fails on a negative one, for the error path.
struct SortKeyErr {
  msg: Str
}

fn (e: SortKeyErr) display() -> Str { e.msg }

fn sort_key_or_fail(r: SortRec) -> Int ! SortKeyErr {
  if r.key < 0 {
    return Err(SortKeyErr{msg: "negative key"})
  }
  r.key
}

test "list_sort_in_place: an empty list and one element are unchanged" {
  var empty: List[Int] = []
  empty.sort_in_place()
  expect(empty == [])
  var one = [7]
  one.sort_in_place()
  expect(one == [7])
}

test "list_sort_in_place: an unordered list sorts in the receiver" {
  var xs = [5, 3, 9, 1, 3, 7]
  xs.sort_in_place()
  expect(xs == [1, 3, 3, 5, 7, 9])
}

test "list_sort_in_place: sorted, reverse sorted and duplicate heavy lists" {
  var sorted = [1, 2, 3, 4]
  sorted.sort_in_place()
  expect(sorted == [1, 2, 3, 4])
  var rev = [4, 3, 2, 1]
  rev.sort_in_place()
  expect(rev == [1, 2, 3, 4])
  var dup = [2, 1, 2, 1, 2, 1]
  dup.sort_in_place()
  expect(dup == [1, 1, 1, 2, 2, 2])
}

test "list_sort_in_place: the sizes around the 16 element runs" {
  // each is its own range reversed, so the insertion runs and the merges
  // above them both do work, and the last merge's left run is half the
  // list (the scratch's widest)
  for n in [15, 16, 17, 33, 100] {
    var xs: List[Int] = []
    var i = n
    while i > 0 {
      xs.push(i)
      i -= 1
    }
    xs.sort_in_place()
    expect(xs == (1..(n + 1)).to_list())
  }
}

test "list_sort_in_place: a list another binding shares is copied first" {
  var a = [3, 1, 2]
  let b = a
  a.sort_in_place()
  expect(a == [1, 2, 3])
  expect(b == [3, 1, 2])
}

test "list_sort_in_place: strings sort by their text" {
  var xs = ["pear", "apple", "fig", "Apple"]
  xs.sort_in_place()
  expect(xs == ["Apple", "apple", "fig", "pear"])
}

test "list_sort_in_place_by: a list another binding shares is copied first" {
  var a = [3, 1, 2]
  let b = a
  a.sort_in_place_by(fn(x) { x })
  expect(a == [1, 2, 3])
  expect(b == [3, 1, 2])
}

test "list_sort_in_place_by: cycles of every length permute the elements" {
  var xs = [5, 4, 3, 2, 1, 0]
  xs.sort_in_place_by(fn(x) { -x })
  expect(xs == [5, 4, 3, 2, 1, 0])
  var ys = [1, 2, 3, 4, 5, 6, 7]
  ys.sort_in_place_by(fn(x) { x % 3 })
  expect(ys == [3, 6, 1, 4, 7, 2, 5])
  var zs = [1, 2, 3, 4, 5]
  zs.sort_in_place_by(fn(x) { x % 5 })
  expect(zs == [5, 1, 2, 3, 4])
}

test "list_sort_in_place: agrees with sort on a longer list" {
  var xs: List[Int] = []
  for i in 0..200 {
    xs.push((i * 37) % 101)
  }
  let want = xs.sort()
  xs.sort_in_place()
  expect(xs == want)
}

test "list_sort_in_place_by: equal keys keep their input order" {
  var xs = [
    SortRec{key: 2, tag: "a"},
    SortRec{key: 1, tag: "b"},
    SortRec{key: 2, tag: "c"},
    SortRec{key: 1, tag: "d"},
    SortRec{key: 2, tag: "e"},
  ]
  xs.sort_in_place_by(fn(r) { r.key })
  let tags = [xs[0].tag, xs[1].tag, xs[2].tag, xs[3].tag, xs[4].tag]
  expect(tags == ["b", "d", "a", "c", "e"])
}

test "list_sort_in_place_by: an empty list and one element are unchanged" {
  var empty: List[SortRec] = []
  empty.sort_in_place_by(fn(r) { r.key })
  expect(empty == [])
  var one = [SortRec{key: 5, tag: "x"}]
  one.sort_in_place_by(fn(r) { r.key })
  expect(one[0].tag == "x")
}

test "list_sort_in_place_by: agrees with sort_by on a longer list" {
  var xs: List[SortRec] = []
  for i in 0..60 {
    xs.push(SortRec{key: (i * 7) % 13, tag: "${i}"})
  }
  let want = xs.sort_by(fn(r) { r.key })
  xs.sort_in_place_by(fn(r) { r.key })
  var same = xs.len() == want.len()
  if same {
    for i in 0..xs.len() {
      if xs[i].tag != want[i].tag {
        same = false
      }
    }
  }
  expect(same)
}

test "list_sort_in_place_by: a failing key propagates and leaves the list alone" {
  var xs = [SortRec{key: 2, tag: "a"}, SortRec{key: -1, tag: "b"}]
  match xs.sort_in_place_by(fn(r) { sort_key_or_fail(r)? }) {
    Ok(_) => expect(false)
    Err(e) => expect(e.msg == "negative key")
  }
  expect(xs[0].tag == "a")
  expect(xs[1].tag == "b")
}


// list_sort's Int path: Go's pdqsort (list_sort_int), checked against
// the stable in-place merge on the inputs its branches handle (insertion
// below 13, ninther pivots from 50, a sorted run's partial insertion, a
// decreasing one reversed, many duplicates partitioned by equality,
// pattern breaking on bad pivots).
fn pdq_case(xs: List[Int]) -> Bool {
  var want = xs
  want.sort_in_place()
  xs.sort() == want
}

test "sort of Ints agrees with the stable merge on random lists of every branch's size" {
  var r = 7
  for n in [0, 1, 2, 3, 11, 12, 13, 49, 50, 51, 127, 1000, 20000] {
    var xs: List[Int] = []
    for _ in 0..n {
      r = (r * 1103515245 + 12345) % 2147483648
      xs.push(r % 1000003 - 500000)
    }
    expect(pdq_case(xs)) == true
  }
}

test "sort of Ints: sorted, reversed, equal, few distinct, sawtooth and organ pipe" {
  for n in [13, 50, 51, 1000, 5000] {
    var up: List[Int] = []
    var down: List[Int] = []
    var same: List[Int] = []
    var few: List[Int] = []
    var saw: List[Int] = []
    var pipe: List[Int] = []
    for i in 0..n {
      up.push(i)
      down.push(n - i)
      same.push(42)
      few.push((i * 7919) % 3)
      saw.push(i % 17)
      pipe.push(if i < n / 2 { i } else { n - i })
    }
    for xs in [up, down, same, few, saw, pipe] {
      expect(pdq_case(xs)) == true
    }
  }
}

test "sort of Ints: extreme values and a sorted list with a few swaps" {
  expect([9223372036854775807, -9223372036854775807 - 1, 0, -1, 1].sort()) == [-9223372036854775807 - 1, -1, 0, 1, 9223372036854775807]
  var xs: List[Int] = []
  for i in 0..300 {
    xs.push(i)
  }
  xs[10] = 290
  xs[290] = 10
  xs[150] = 0
  expect(pdq_case(xs)) == true
}

test "sort of Ints leaves the receiver as it was" {
  let xs = [3, 1, 2]
  let s = xs.sort()
  expect(xs) == [3, 1, 2]
  expect(s) == [1, 2, 3]
}
