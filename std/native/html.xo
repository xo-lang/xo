// std/html on the native backends (decision 0408): Go's html package,
// ported from escape.go of go1.26.1 (EscapeString's replacer,
// UnescapeString's unescapeEntity with the entity tables of entity.go,
// generated at the end of this file). The same results on every input.
use native/llrt/raw
use native/rt
use std/htmlent as ent


// Go's EscapeString is a byteStringReplacer: one pass sizes the result,
// the builder is made once at that size, and a second pass copies the
// runs between the five characters by index (a find_any call per run was
// 52% of the profile: its set is built on every call, and the runs here
// are a few bytes; a byte at a time into a builder ran at 3.8 times Go's,
// 2026-10-29)
const ESC_EXTRA: Bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x04\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// Words of eight equal bytes.
const ONES: Int = 72340172838076673
const HIGHS: Int = -9187201950435737472
const LOW7S: Int = 9187201950435737471

/// The high bit of each byte of w that is the byte of r (eight copies of
/// one byte), exactly (std/native/llrt/scan.xo's eq8).
fn eq8(w: Int, r: Int) -> Int {
  let y = w ^ r
  ((((y & LOW7S).wrapping_add(LOW7S)) | y) ^ -1) & HIGHS
}

/// The high bit of each of the 8 bytes of w that escapes to 5 bytes
/// (& ' ").
fn esc5(w: Int) -> Int { eq8(w, 38 * ONES) | eq8(w, 39 * ONES) | eq8(w, 34 * ONES) }

/// The high bit of each of the 8 bytes of w that escapes to 4 bytes
/// (< >).
fn esc4(w: Int) -> Int { eq8(w, 60 * ONES) | eq8(w, 62 * ONES) }

fn escape_string(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var extra = 0
  var i = 0
  // 32 bytes a step, each character counted by one lane compare, then a
  // word a step: each special's extra length counted by mask, so a text
  // dense in specials costs no more than a clean one
  while n - i >= 32 {
    let e5 = rt.bytes_count_eq32(b, i, 38) + rt.bytes_count_eq32(b, i, 39) + rt.bytes_count_eq32(b, i, 34)
    extra += 4 * e5 + 3 * (rt.bytes_count_eq32(b, i, 60) + rt.bytes_count_eq32(b, i, 62))
    i += 32
  }
  while n - i >= 8 {
    let w = rt.bytes_word(b, i)
    extra += 4 * rt.popcount(esc5(w)) + 3 * rt.popcount(esc4(w))
    i += 8
  }
  while i < n {
    let c = Int(b[i])
    extra += Int(ESC_EXTRA[c])
    i += 1
  }
  if extra == 0 {
    return s
  }
  // the output is written through its address: a run is one mem_copy and a
  // replacement one 4 byte store (and a ';' for the 5 byte ones), where a
  // builder call a byte was the cost against Go (host 1, 2026-11-04)
  let ob = raw.bytes_buf(n + extra)
  let op = raw.bytes_addr(ob)
  let sp = raw.bytes_addr(b)
  var o = 0
  var start = 0
  i = 0
  while i < n {
    if n - i >= 8 {
      // a clean word is skipped whole; else straight to its first special
      let w = rt.bytes_word(b, i)
      let m = esc5(w) | esc4(w)
      if m == 0 {
        i += 8
        continue
      }
      i += rt.ctz(m).shr_logical(3)
    }
    let c = b[i]
    if c == 38 || c == 60 || c == 62 || c == 39 || c == 34 {
      let run = i - start
      if run > 0 {
        rt.mem_copy(op.wrapping_add(o), sp.wrapping_add(start), run)
        o += run
      }
      if c == 38 {
        // "&amp;"
        rt.mem_store(op, o, 0x706d6126, 4)
        rt.mem_store(op, o + 4, 59, 1)
        o += 5
      } else if c == 60 {
        // "&lt;"
        rt.mem_store(op, o, 0x3b746c26, 4)
        o += 4
      } else if c == 62 {
        // "&gt;"
        rt.mem_store(op, o, 0x3b746726, 4)
        o += 4
      } else {
        // "&#39;" and "&#34;"
        rt.mem_store(op, o, if c == 39 { 0x39332326 } else { 0x34332326 }, 4)
        rt.mem_store(op, o + 4, 59, 1)
        o += 5
      }
      start = i + 1
    }
    i += 1
  }
  if start < n {
    rt.mem_copy(op.wrapping_add(o), sp.wrapping_add(start), n - start)
  }
  raw.alive(b)
  // the replacements are ASCII and the runs between them are cut at ASCII
  // bytes of a valid text: valid, as Go's string result is
  rt.cast[Bytes, Str](ob)
}


fn unescape_string(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && b[i] != 38 {
    i += 1
  }
  if i == n {
    return s
  }
  // the result is never longer than the input (Go unescapes in place)
  var out = BytesBuilder.with_capacity(n)
  out.write(b[0..i])
  while i < n {
    // the run up to the next `&` as it is (Go's UnescapeString copies
    // between entities too), by index: a find call and a slice per run
    // cost more than the runs are long
    var run_end = i
    while run_end < n && b[run_end] != 38 {
      run_end += 1
    }
    if run_end > i {
      out.write(b[i..run_end])
      i = run_end
    }
    if i >= n {
      break
    }
    // the five references EscapeString writes, and &quot;, by their
    // bytes: what the tables give, without the name's Str and the
    // binary search (the search's compares were 30% of the profile and
    // the names' drops 8%, 2026-10-29)
    let rest = n - i
    if rest >= 4 && b[i + 1] == 108 && b[i + 2] == 116 && b[i + 3] == 59 {
      out.write_byte(60)
      i += 4
      continue
    }
    if rest >= 4 && b[i + 1] == 103 && b[i + 2] == 116 && b[i + 3] == 59 {
      out.write_byte(62)
      i += 4
      continue
    }
    if rest >= 5 && b[i + 1] == 97 && b[i + 2] == 109 && b[i + 3] == 112 && b[i + 4] == 59 {
      out.write_byte(38)
      i += 5
      continue
    }
    if rest >= 5 && b[i + 1] == 35 && b[i + 2] == 51 && b[i + 3] == 52 && b[i + 4] == 59 {
      out.write_byte(34)
      i += 5
      continue
    }
    if rest >= 5 && b[i + 1] == 35 && b[i + 2] == 51 && b[i + 3] == 57 && b[i + 4] == 59 {
      out.write_byte(39)
      i += 5
      continue
    }
    if rest >= 6 && b[i + 1] == 113 && b[i + 2] == 117 && b[i + 3] == 111 && b[i + 4] == 116 && b[i + 5] == 59 {
      out.write_byte(34)
      i += 6
      continue
    }
    let c = b[i]
    // unescapeEntity at i
    if n - i <= 1 {
      out.write_byte(c)
      i += 1
      continue
    }
    var j = i + 1
    if b[j] == 35 {
      // a numeric reference: at least "&#."
      if n - i <= 3 {
        out.write_byte(c)
        i += 1
        continue
      }
      j += 1
      var hex = false
      if b[j] == 120 || b[j] == 88 {
        hex = true
        j += 1
      }
      var x = 0
      var digits = false
      while j < n {
        let d = b[j]
        j += 1
        if hex {
          if d >= 48 && d <= 57 {
            x = 16 * x + (Int(d) - 48)
            digits = true
            continue
          } else if d >= 97 && d <= 102 {
            x = 16 * x + (Int(d) - 97) + 10
            digits = true
            continue
          } else if d >= 65 && d <= 70 {
            x = 16 * x + (Int(d) - 65) + 10
            digits = true
            continue
          }
        } else if d >= 48 && d <= 57 {
          x = 10 * x + (Int(d) - 48)
          digits = true
          continue
        }
        if d != 59 {
          j -= 1
        }
        break
      }
      if !digits {
        out.write_byte(c)
        i += 1
        continue
      }
      var r = x
      if r >= 0x80 && r <= 0x9F {
        out.write(ent.REPLACEMENT[r - 0x80].bytes())
      } else {
        if r == 0 || (r >= 0xD800 && r <= 0xDFFF) || r > 0x10FFFF {
          r = 0xFFFD
        }
        out.write_rune(Rune.try(r) ?? Rune.try(0xFFFD).or_fault("rune"))
      }
      i = j
      continue
    }
    // a named reference: the letters and digits after the &
    while j < n {
      let d = b[j]
      if (d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) {
        j += 1
        continue
      }
      break
    }
    var name_end = j
    if j < n && b[j] == 59 {
      name_end = j + 1
    }
    let name = b[i + 1..name_end].to_str() ?? ""
    if name.is_empty() {
      out.write_byte(c)
      i += 1
      continue
    }
    let one = ent.entity_of(name)
    if !one.is_empty() {
      out.write(one.bytes())
      i = name_end
      continue
    }
    let two = ent.entity2_of(name)
    if !two.is_empty() {
      out.write(two.bytes())
      i = name_end
      continue
    }
    // a legacy name without its semicolon as a prefix: the longest
    // match, at least two characters
    var max_len = name.len() - 1
    if max_len > ent.LONGEST_ENTITY_WITHOUT_SEMICOLON {
      max_len = ent.LONGEST_ENTITY_WITHOUT_SEMICOLON
    }
    var k = max_len
    var matched = false
    while k > 1 {
      let pre = ent.entity_of(name[0..k])
      if !pre.is_empty() {
        out.write(pre.bytes())
        i = i + 1 + k
        matched = true
        break
      }
      k -= 1
    }
    if matched {
      continue
    }
    out.write(b[i..name_end])
    i = name_end
  }
  out.freeze().to_str() ?? s
}
