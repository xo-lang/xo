// std/html on the native backends (decision 0408): Go's html package,
// ported from escape.go of go1.26.1 (EscapeString's replacer,
// UnescapeString's unescapeEntity with the entity tables of entity.go,
// generated at the end of this file). The same results on every input.

/// 0x80 to 0x9F in a numeric reference, as Go's replacementTable
/// (what browsers substitute for the C1 controls).
const REPLACEMENT: List[Str] = ["\u{20AC}", "\u{0081}", "\u{201A}", "\u{0192}", "\u{201E}", "\u{2026}", "\u{2020}", "\u{2021}", "\u{02C6}", "\u{2030}", "\u{0160}", "\u{2039}", "\u{0152}", "\u{008D}", "\u{017D}", "\u{008F}", "\u{0090}", "\u{2018}", "\u{2019}", "\u{201C}", "\u{201D}", "\u{2022}", "\u{2013}", "\u{2014}", "\u{02DC}", "\u{2122}", "\u{0161}", "\u{203A}", "\u{0153}", "\u{009D}", "\u{017E}", "\u{0178}"]

fn escape_string(s: Str) -> Str {
  let b = s.bytes()
  var n = 0
  for c in b {
    if c == 38 || c == 39 || c == 60 || c == 62 || c == 34 {
      n += 1
    }
  }
  if n == 0 {
    return s
  }
  var out = BytesBuilder.new()
  var start = 0
  for (i, c) in b.indexed() {
    let rep = match c {
      38 => "&amp;"
      39 => "&#39;"
      60 => "&lt;"
      62 => "&gt;"
      34 => "&#34;"
      _ => ""
    }
    if !rep.is_empty() {
      out.write(b[start..i])
      out.write_str(rep)
      start = i + 1
    }
  }
  out.write(b[start..])
  out.freeze().to_str() ?? s
}

/// The character of entity name, "" for none (a binary search of the
/// generated table).
fn entity_of(name: Str) -> Str {
  var lo = 0
  var hi = ENTITY.len()
  while lo < hi {
    let mid = (lo + hi) / 2
    let (n, ch) = ENTITY[mid]
    if n == name {
      return ch
    }
    if n < name {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  ""
}

fn entity2_of(name: Str) -> Str {
  for (n, ch) in ENTITY2 {
    if n == name {
      return ch
    }
  }
  ""
}

fn unescape_string(s: Str) -> Str {
  let b = s.bytes()
  if !b.contains(b"&") {
    return s
  }
  var out = BytesBuilder.new()
  var i = 0
  let n = b.len()
  while i < n {
    let c = b[i]
    if c != 38 {
      out.write_byte(c)
      i += 1
      continue
    }
    // unescapeEntity at i
    if n - i <= 1 {
      out.write_byte(c)
      i += 1
      continue
    }
    var j = i + 1
    if b[j] == 35 {
      // a numeric reference: at least "&#."
      if n - i <= 3 {
        out.write_byte(c)
        i += 1
        continue
      }
      j += 1
      var hex = false
      if b[j] == 120 || b[j] == 88 {
        hex = true
        j += 1
      }
      var x = 0
      var digits = false
      while j < n {
        let d = b[j]
        j += 1
        if hex {
          if d >= 48 && d <= 57 {
            x = 16 * x + (Int(d) - 48)
            digits = true
            continue
          } else if d >= 97 && d <= 102 {
            x = 16 * x + (Int(d) - 97) + 10
            digits = true
            continue
          } else if d >= 65 && d <= 70 {
            x = 16 * x + (Int(d) - 65) + 10
            digits = true
            continue
          }
        } else if d >= 48 && d <= 57 {
          x = 10 * x + (Int(d) - 48)
          digits = true
          continue
        }
        if d != 59 {
          j -= 1
        }
        break
      }
      if !digits {
        out.write_byte(c)
        i += 1
        continue
      }
      var r = x
      if r >= 0x80 && r <= 0x9F {
        out.write(REPLACEMENT[r - 0x80].bytes())
      } else {
        if r == 0 || (r >= 0xD800 && r <= 0xDFFF) || r > 0x10FFFF {
          r = 0xFFFD
        }
        out.write_rune(Rune.try(r) ?? Rune.try(0xFFFD).or_fault("rune"))
      }
      i = j
      continue
    }
    // a named reference: the letters and digits after the &
    while j < n {
      let d = b[j]
      if (d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) {
        j += 1
        continue
      }
      break
    }
    var name_end = j
    if j < n && b[j] == 59 {
      name_end = j + 1
    }
    let name = b[i + 1..name_end].to_str() ?? ""
    if name.is_empty() {
      out.write_byte(c)
      i += 1
      continue
    }
    let one = entity_of(name)
    if !one.is_empty() {
      out.write(one.bytes())
      i = name_end
      continue
    }
    let two = entity2_of(name)
    if !two.is_empty() {
      out.write(two.bytes())
      i = name_end
      continue
    }
    // a legacy name without its semicolon as a prefix: the longest
    // match, at least two characters
    var max_len = name.len() - 1
    if max_len > LONGEST_ENTITY_WITHOUT_SEMICOLON {
      max_len = LONGEST_ENTITY_WITHOUT_SEMICOLON
    }
    var k = max_len
    var matched = false
    while k > 1 {
      let pre = entity_of(name[0..k])
      if !pre.is_empty() {
        out.write(pre.bytes())
        i = i + 1 + k
        matched = true
        break
      }
      k -= 1
    }
    if matched {
      continue
    }
    out.write(b[i..name_end])
    i = name_end
  }
  out.freeze().to_str() ?? s
}

