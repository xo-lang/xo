// std/grpc: the pure layer (decision 0535), after grpc-go's rpc_util.go (frame, timeout) and status (message encoding).
use std/base64
use std/grpc
use std/http
use std/task

fn code_number(c: grpc.Code) -> Int {
  match c {
    Ok => 0
    Canceled => 1
    Unknown => 2
    InvalidArgument => 3
    DeadlineExceeded => 4
    NotFound => 5
    AlreadyExists => 6
    PermissionDenied => 7
    ResourceExhausted => 8
    FailedPrecondition => 9
    Aborted => 10
    OutOfRange => 11
    Unimplemented => 12
    Internal => 13
    Unavailable => 14
    DataLoss => 15
    Unauthenticated => 16
  }
}

fn code_from(n: Int) -> grpc.Code? {
  let all = [grpc.Code.Ok, grpc.Code.Canceled, grpc.Code.Unknown, grpc.Code.InvalidArgument, grpc.Code.DeadlineExceeded,
    grpc.Code.NotFound, grpc.Code.AlreadyExists, grpc.Code.PermissionDenied, grpc.Code.ResourceExhausted,
    grpc.Code.FailedPrecondition, grpc.Code.Aborted, grpc.Code.OutOfRange, grpc.Code.Unimplemented, grpc.Code.Internal,
    grpc.Code.Unavailable, grpc.Code.DataLoss, grpc.Code.Unauthenticated]
  if n < 0 || n > 16 { None } else { Some(all[n]) }
}

fn frame(payload: Bytes, compressed: Bool = false) -> Bytes {
  var b = BytesBuilder.with_capacity(5 + payload.len())
  b.write_byte(UInt8.wrapping_from(if compressed { 1 } else { 0 }))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 24) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 16) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 8) & 255))
  b.write_byte(UInt8.wrapping_from(payload.len() & 255))
  b.write(payload)
  b.freeze()
}

fn unframe(data: Bytes, at: Int, max_len: Int = 4194304) -> (Bool, Bytes, Int) ! grpc.FrameErr {
  if at + 5 > data.len() {
    return Err(grpc.FrameErr.Truncated)
  }
  let flag = Int(data[at])
  if flag > 1 {
    return Err(grpc.FrameErr.BadFlag(flag: flag))
  }
  let n = (Int(data[at + 1]) << 24) | (Int(data[at + 2]) << 16) | (Int(data[at + 3]) << 8) | Int(data[at + 4])
  if n > max_len {
    return Err(grpc.FrameErr.TooLarge(len: n))
  }
  if at + 5 + n > data.len() {
    return Err(grpc.FrameErr.Truncated)
  }
  (flag == 1, data[at + 5..at + 5 + n], at + 5 + n)
}

// grpc-go encodeTimeout: the smallest unit whose value (rounded to nearest) fits 8 digits; hours otherwise
fn encode_timeout(ns: Int) -> Str {
  if ns <= 0 {
    return "0n"
  }
  let units = [(1, "n"), (1000, "u"), (1000000, "m"), (1000000000, "S"), (60000000000, "M"), (3600000000000, "H")]
  var best = "0n"
  for (div, letter) in units {
    let v = (ns + div / 2) / div
    if v <= 99999999 {
      return "${v}${letter}"
    }
    best = "${v}${letter}"
  }
  best
}

fn decode_timeout(s: Str) -> Int? {
  let b = s.bytes()
  if b.len() < 2 || b.len() > 9 {
    return None
  }
  var v = 0
  var i = 0
  while i < b.len() - 1 {
    let c = Int(b[i])
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + c - 48
    i += 1
  }
  match Int(b[b.len() - 1]) {
    110 => Some(v)
    117 => Some(v * 1000)
    109 => Some(v * 1000000)
    83 => Some(v * 1000000000)
    77 => Some(v * 60000000000)
    72 => Some(v * 3600000000000)
    _ => None
  }
}

fn encode_message(s: Str) -> Str {
  encode_message_bytes(s.bytes())
}

fn encode_message_bytes(bs: Bytes) -> Str {
  var out = BytesBuilder.with_capacity(bs.len())
  let hex = "0123456789ABCDEF".bytes()
  var i = 0
  while i < bs.len() {
    let c = Int(bs[i])
    if c >= 32 && c <= 126 && c != 37 {
      out.write_byte(UInt8.wrapping_from(c))
    } else {
      out.write_byte(UInt8(37))
      out.write_byte(hex[c >> 4])
      out.write_byte(hex[c & 15])
    }
    i += 1
  }
  out.freeze().to_str_lossy()
}

fn hex_val(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn decode_message(s: Str) -> Str {
  decode_message_bytes(s).to_str_lossy()
}

fn decode_message_bytes(s: Str) -> Bytes {
  let bs = s.bytes()
  var out = BytesBuilder.with_capacity(bs.len())
  var i = 0
  while i < bs.len() {
    if bs[i] == UInt8(37) && i + 2 < bs.len() {
      let hi = hex_val(Int(bs[i + 1]))
      let lo = hex_val(Int(bs[i + 2]))
      if hi >= 0 && lo >= 0 {
        out.write_byte(UInt8.wrapping_from(hi * 16 + lo))
        i += 3
        continue
      }
    }
    out.write_byte(bs[i])
    i += 1
  }
  out.freeze()
}

// ---- the server and the client over std/http (decision 0535) ----

fn status_new(code: grpc.Code, message: Str) -> grpc.Status {
  grpc.Status{code: code, message: message, details: b""}
}

fn status_display(s: grpc.Status) -> Str {
  "rpc error: code = ${s.code} desc = ${s.message}"
}

fn reserved(name: Str) -> Bool {
  name.starts_with("grpc-") || name == "content-type" || name == "te"
}

fn finish(w: http.BodyWriter, st: grpc.Status) {
  w.set_trailer("grpc-status", "${st.code.number()}")
  if st.message != "" {
    w.set_trailer("grpc-message", encode_message(st.message))
  }
}

fn send_send(s: grpc.Send, msg: Bytes) -> () ! grpc.Status {
  match s.w.write(frame(msg)) {
    Ok(_) => ()
    Err(e) => return Err(status_new(grpc.Code.Unavailable, "${e}"))
  }
  match s.w.flush() {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(grpc.Code.Unavailable, "${e}"))
  }
}

fn send_set_trailer(s: grpc.Send, name: Str, value: Str) {
  s.w.set_trailer(name, value)
}

/// The next message of the stream whose buffered state is `st`, reading more with `more` (None at its end).
fn pull[fx: Effects](st: grpc.RecvState, max: Int, more: fn() -> Bytes? ! grpc.Status uses fx) -> (Bytes?, grpc.RecvState) ! grpc.Status uses fx {
  var s = st
  while true {
    match unframe(s.buf, s.at, max) {
      Ok((compressed, msg, next)) => {
        if compressed {
          return Err(status_new(grpc.Code.Unimplemented, "grpc: compressed message received but no compression was negotiated"))
        }
        s.at = next
        return Ok((Some(msg), s))
      }
      Err(grpc.FrameErr.TooLarge(len)) => {
        return Err(status_new(grpc.Code.ResourceExhausted, "grpc: received message larger than max (${len} vs. ${max})"))
      }
      Err(grpc.FrameErr.BadFlag(flag)) => {
        return Err(status_new(grpc.Code.Internal, "grpc: received message with invalid compression flag ${flag}"))
      }
      Err(grpc.FrameErr.Truncated) => {
        if s.done {
          if s.at == s.buf.len() {
            return Ok((None, s))
          }
          return Err(status_new(grpc.Code.Internal, "unexpected EOF"))
        }
        match more()? {
          Some(d) => {
            var b = BytesBuilder.with_capacity(s.buf.len() - s.at + d.len())
            b.write(s.buf[s.at..])
            b.write(d)
            s.buf = b.freeze()
            s.at = 0
          }
          None => {
            s.done = true
          }
        }
      }
    }
  }
  Ok((None, s))
}

fn recv_next(r: grpc.Recv) -> Bytes? ! grpc.Status {
  let out = r.st.with(fn(var s) -> Result[Bytes?, grpc.Status] {
    match pull(s, r.max, fn() -> Bytes? ! grpc.Status {
      match r.body.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(status_new(grpc.Code.Canceled, "${e}"))
      }
    }) {
      Ok((msg, ns)) => {
        s = ns
        Ok(msg)
      }
      Err(e) => Err(e)
    }
  })
  out
}

fn server(clock: Clock) -> grpc.Server {
  grpc.Server{routes: http.router(), max_recv: 4194304, methods: [], clock: clock}
}

fn server_with_max_recv(s: grpc.Server, n: Int) -> grpc.Server {
  grpc.Server{routes: s.routes, max_recv: n, methods: s.methods, clock: s.clock}
}

/// The routes, with a call to a method nobody registered answered the way grpc-go does: status Unimplemented in
/// the trailers of a 200 response.
fn server_router(s: grpc.Server) -> http.Router {
  var r = s.routes
  let methods = s.methods
  r.not_found(fn(req) -> http.Response {
    let ct = req.header("content-type") ?? ""
    if !ct.starts_with("application/grpc") {
      return http.not_found()
    }
    let parts = req.path.split("/")
    let svc = if parts.len() > 1 { parts[1] } else { "" }
    var known = false
    for m in methods {
      if m.starts_with("/${svc}/") {
        known = true
      }
    }
    let name = if parts.len() > 2 { parts[2] } else { "" }
    trailers_only(status_new(grpc.Code.Unimplemented, if known { "unknown method ${name} for service ${svc}" } else { "unknown service ${svc}" }))
  })
  r
}

fn trailers_only(st: grpc.Status) -> http.Response {
  http.stream(200, fn(w) -> () ! IoErr {
    finish(w, st)
  }).with_header("content-type", "application/grpc")
}

fn serve_call[fx: Effects](f: fn(grpc.Call, grpc.Recv, grpc.Send) -> () ! grpc.Status uses fx, clock: Clock, max: Int, method: Str, req: http.Request, body: http.BodyReader) -> http.Response uses (fx, clock) {
  let ct = req.header("content-type") ?? ""
  if !ct.starts_with("application/grpc") {
    return http.empty(415)
  }
  var timeout: Duration? = None
  if let Some(t) = req.header("grpc-timeout") {
    match decode_timeout(t) {
      Some(ns) => {
        timeout = Some(Duration.from_nanos(ns))
      }
      None => return trailers_only(status_new(grpc.Code.Internal, "malformed grpc-timeout"))
    }
  }
  var md: Map[Str, Str] = {}
  for (k, v) in req.headers {
    let lk = k.to_lower()
    if !reserved(lk) {
      md[lk] = v
    }
  }
  let call = grpc.Call{method: method, metadata: md, timeout: timeout}
  let recv = grpc.Recv{body: body, st: Mutex[grpc.RecvState].new(grpc.RecvState{buf: b"", at: 0, done: false}), max: max}
  http.stream(200, fn(w) -> () ! IoErr {
    let send = grpc.Send{w: w}
    let st = match timeout {
      Some(d) => match task.with_timeout(clock, d, fn() -> () ! grpc.Status { f(call, recv, send) }) {
        Ok(_) => grpc.Status{code: grpc.Code.Ok, message: "", details: b""}
        Err(task.Timed.TimedOut) => status_new(grpc.Code.DeadlineExceeded, "context deadline exceeded")
        Err(task.Timed.Failed(e)) => e
      }
      None => match f(call, recv, send) {
        Ok(_) => grpc.Status{code: grpc.Code.Ok, message: "", details: b""}
        Err(e) => e
      }
    }
    finish(w, st)
  }).with_header("content-type", "application/grpc").with_full_duplex()
}

fn server_stream[fx: Effects](var s: grpc.Server, method: Str, f: fn(grpc.Call, grpc.Recv, grpc.Send) -> () ! grpc.Status uses fx) uses (fx, clock) {
  let max = s.max_recv
  let clock = s.clock
  s.methods.push(method)
  s.routes.handle_stream("POST ${method}", fn(req, body) -> http.Response {
    serve_call(f, clock, max, method, req, body)
  })
}

fn server_unary[fx: Effects](var s: grpc.Server, method: Str, f: fn(grpc.Call, Bytes) -> Bytes ! grpc.Status uses fx) uses (fx, clock) {
  server_stream(s, method, fn(call, recv, send) -> () ! grpc.Status {
    let req = match recv.next()? {
      Some(m) => m
      None => return Err(status_new(grpc.Code.Internal, "grpc: client sent no request message"))
    }
    let resp = f(call, req)?
    send.send(resp)?
  })
}

// ---- client ----

fn client(c: http.Client, base: Str) -> grpc.Client {
  let h = if base.starts_with("http://") { c.with_protocols(#{http.Protocol.UnencryptedHttp2}) } else { c }
  grpc.Client{http: h, base: base}
}

fn from_client_err(e: http.ClientErr) -> grpc.Status {
  match e {
    Timeout => status_new(grpc.Code.DeadlineExceeded, "context deadline exceeded")
    Canceled => status_new(grpc.Code.Canceled, "context canceled")
    Connect(msg) => status_new(grpc.Code.Unavailable, "connection error: ${msg}")
    Protocol(msg) => status_new(grpc.Code.Internal, msg)
    InvalidUrl(msg) => status_new(grpc.Code.Internal, "invalid URL: ${msg}")
  }
}

fn call_headers(metadata: Map[Str, Str], timeout: Duration?) -> Map[Str, Str] {
  var h: Map[Str, Str] = {}
  for (k, v) in metadata {
    h[k.to_lower()] = v
  }
  h["content-type"] = "application/grpc"
  h["te"] = "trailers"
  h["user-agent"] = "grpc-xo/0.1"
  if let Some(d) = timeout {
    h["grpc-timeout"] = encode_timeout(d.nanos())
  }
  h
}

fn http_to_code(status: Int) -> grpc.Code {
  if status == 400 {
    grpc.Code.Internal
  } else if status == 401 {
    grpc.Code.Unauthenticated
  } else if status == 403 {
    grpc.Code.PermissionDenied
  } else if status == 404 {
    grpc.Code.Unimplemented
  } else if status == 429 || status == 502 || status == 503 || status == 504 {
    grpc.Code.Unavailable
  } else {
    grpc.Code.Unknown
  }
}

/// The call's status from a finished stream: its trailers, or the head of a trailers only response.
fn final_status(st: http.ClientStream) -> grpc.Status {
  let head = st.head()
  if head.status != 200 {
    return status_new(http_to_code(head.status), "unexpected HTTP status code received from server: ${head.status}")
  }
  let tr = st.trailers()
  let gs = tr.get("Grpc-Status") ?? (head.headers.get("Grpc-Status") ?? "")
  if gs == "" {
    return status_new(grpc.Code.Internal, "server closed the stream without sending trailers")
  }
  let n = Int.parse(gs) ?? -1
  let code = code_from(n) ?? grpc.Code.Unknown
  let msg = tr.get("Grpc-Message") ?? (head.headers.get("Grpc-Message") ?? "")
  grpc.Status{code: code, message: decode_message(msg), details: b""}
}

fn client_unary(c: grpc.Client, method: Str, req: Bytes, metadata: Map[Str, Str], timeout: Duration?) -> Bytes ! grpc.Status {
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout), frame(req))
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let st = match c.http.open(r) {
    Ok(s) => s
    Err(e) => return Err(from_client_err(e))
  }
  let data = match st.read_all() {
    Ok(b) => b
    Err(e) => {
      st.close()
      return Err(from_client_err(e))
    }
  }
  let fin = final_status(st)
  st.close()
  if fin.code != grpc.Code.Ok {
    return Err(fin)
  }
  match unframe(data, 0) {
    Ok((compressed, msg, _)) => {
      if compressed {
        return Err(status_new(grpc.Code.Unimplemented, "grpc: compressed message received but no compression was negotiated"))
      }
      Ok(msg)
    }
    Err(_) => Err(status_new(grpc.Code.Internal, "grpc: no response message"))
  }
}

fn client_call[R, fx: Effects](c: grpc.Client, method: Str, metadata: Map[Str, Str], timeout: Duration?, f: fn(grpc.ClientCall) -> R ! grpc.Status uses fx) -> R ! grpc.Status uses (fx, net.dial) {
  let (pw, pr) = http.pipe()
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout)).with_body_reader(pr)
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let head = Chan[(http.ClientStream?, grpc.Status?)].new(1)
  let cc = grpc.ClientCall{w: pw, head: head, st: Mutex[grpc.CallState].new(grpc.CallState{stream: None, failed: None, recv: grpc.RecvState{buf: b"", at: 0, done: false}, final: None}), max: 4194304}
  var result: R? = None
  var failure: grpc.Status? = None
  scope s {
    s.spawn(fn() {
      match c.http.open(r) {
        Ok(st) => head.send((Some(st), None))
        Err(e) => head.send((None, Some(from_client_err(e))))
      }
    })
    match f(cc) {
      Ok(v) => {
        result = Some(v)
      }
      Err(e) => {
        failure = Some(e)
      }
    }
    pw.close()
    // release the stream, also when f never read the call to its end
    var open_stream = cc.st.with(fn(var s) { s.stream })
    let consumed = cc.st.with(fn(var s) { s.failed.is_some() })
    if open_stream.is_none() && !consumed {
      match head.recv() {
        Some((Some(x), _)) => {
          open_stream = Some(x)
        }
        _ => {}
      }
    }
    if let Some(x) = open_stream {
      x.close()
    }
  }
  if let Some(e) = failure {
    return Err(e)
  }
  Ok(result ?? fault("grpc call produced no result"))
}

fn clientcall_send(cc: grpc.ClientCall, msg: Bytes) -> () ! grpc.Status {
  match cc.w.write(frame(msg)) {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(grpc.Code.Unavailable, "${e}"))
  }
}

fn clientcall_close_send(cc: grpc.ClientCall) {
  cc.w.close()
}

fn clientcall_recv(cc: grpc.ClientCall) -> Bytes? ! grpc.Status uses net.dial {
  let out = cc.st.with(fn(var s) -> Result[Bytes?, grpc.Status] uses net.dial {
    if let Some(e) = s.failed {
      return Err(e)
    }
    if let Some(fin) = s.final {
      return if fin.code == grpc.Code.Ok { Ok(None) } else { Err(fin) }
    }
    if s.stream.is_none() {
      match cc.head.recv() {
        Some((Some(st), _)) => {
          s.stream = Some(st)
        }
        Some((None, Some(e))) => {
          s.failed = Some(e)
          return Err(e)
        }
        _ => return Err(status_new(grpc.Code.Internal, "grpc: no response"))
      }
    }
    let stream = s.stream ?? fault("stream")
    let res = pull(s.recv, cc.max, fn() -> Bytes? ! grpc.Status uses net.dial {
      match stream.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(from_client_err(e))
      }
    })
    match res {
      Ok((msg, ns)) => {
        s.recv = ns
        if msg.is_none() {
          let fin = final_status(stream)
          stream.close()
          s.final = Some(fin)
          return if fin.code == grpc.Code.Ok { Ok(None) } else { Err(fin) }
        }
        Ok(msg)
      }
      Err(e) => {
        s.failed = Some(e)
        Err(e)
      }
    }
  })
  out
}

fn bin_encode(data: Bytes) -> Str { base64.encode(data, base64.Base64.RawStd) }

fn bin_decode(value: Str) -> Bytes? {
  var v = value
  while v.ends_with("=") {
    v = v[0..v.len() - 1]
  }
  match base64.decode(v, base64.Base64.RawStd) {
    Ok(b) => Some(b)
    Err(_) => None
  }
}
