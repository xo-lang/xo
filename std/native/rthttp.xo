// HTTP intrinsics of the native backends (decision 0074), like
// native/rt.xo: imported only by the implementation modules as
// `use native/rthttp`. The server, its connections, sinks, the client's
// records (std/native/llrt/hconn.xo, hserve.xo, hclient.xo; the zero-C
// audit's B28 part 3) and TLS (tlsio.xo, tlssrv.xo; decision 0202) are
// Xo's.
use native/rt

/// A server's connections and the scope of their tasks (hconn.xo SR_*).
struct Srv {}
/// One server connection (hconn.xo HC_*).
struct HConn {}
/// A client response or error (hclient.xo R_*).
struct CResp {}
/// Streamed bodies (http.stream, decision 0083): a sink takes a stream's
/// writes, into a buffer or to a connection as net/http sends them
/// (hserve.xo SK_*).
struct Sink {}

/// The roots a client trusts (std/native/llrt/tlsio.xo's record: the
/// certificates parsed by x509.xo, or the system's).
struct Roots {}
