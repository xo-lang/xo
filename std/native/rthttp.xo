// HTTP intrinsics of the native backends (decision 0074), like
// native/rt.xo: imported only by the implementation modules as
// `use native/rthttp`. std/llrt/xo_http.c implements them.
use std/task
use native/rt

/// A server's connections and the scope of their tasks (xo_srv).
struct Srv {}
/// One server connection (xo_hconn).
struct HConn {}
/// A client response or error (xo_cresp).
struct CResp {}

fn srv_new() -> Srv
fn srv_group(s: Srv) -> task.Group
fn srv_stop(s: Srv)
fn srv_wait(s: Srv)
fn srv_close(s: Srv)

fn hc_new(s: Srv, c: Conn) -> HConn
/// The next request is read (its body too): 1, or 0 to close the
/// connection; with the parsing in Xo also 3, a request head to
/// parse at hc_input (the result to hc_head), and 4, a chunked body to
/// decode there (the result to hc_chunked) (std/native/llrt/http1.xo,
/// decision 0193 step 6).
fn hc_read(h: HConn) -> Int
/// The unread input (mode 2), up to the end of its first head (mode 0),
/// or at most 4 KiB of it (mode 1); its length; whether no more will
/// come.
fn hc_input(h: HConn, mode: Int) -> Str
fn hc_avail(h: HConn) -> Int
fn hc_eof(h: HConn) -> Bool
/// The parse of a head (http1.Parse): its result and length; for the C,
/// the method, the version and flags (http1.Reader.read), the
/// Content-Length, and a status error's code and text.
fn hc_head(h: HConn, res: Int, used: Int, method: Str, flags: Int, clen: Int, status: Int, reason: Str)
/// The decoding of a chunked body (http1.Chunked).
fn hc_chunked(h: HConn, res: Int, used: Int, body: Str)
fn hc_method(h: HConn) -> Str
fn hc_path(h: HConn) -> Str
fn hc_scheme(h: HConn) -> Str
fn hc_host(h: HConn) -> Str
/// The port of an absolute request target, or -1.
fn hc_port(h: HConn) -> Int
fn hc_nheaders(h: HConn) -> Int
fn hc_hname(h: HConn, i: Int) -> Str
fn hc_hval(h: HConn, i: Int) -> Str
fn hc_nquery(h: HConn) -> Int
fn hc_qkey(h: HConn, i: Int) -> Str
fn hc_qval(h: HConn, i: Int) -> Str
fn hc_body(h: HConn) -> Bytes
fn hc_remote_ip(h: HConn) -> Str
/// Sets a field of the response header.
fn hc_header(h: HConn, name: Str, value: Str)
/// Writes the response; false: close the connection.
fn hc_respond(h: HConn, status: Int, body: Bytes) -> Bool
fn hc_close(h: HConn)

/// HTTP/2 (decision 0121, std/llrt/xo_h2.c): finishes the TLS handshake
/// of a server connection; true when ALPN chose h2, so its requests come
/// from h2_next instead of hc_read.
fn hc_h2(h: HConn) -> Bool
/// Runs the HTTP/2 connection until a request is ready for a handler
/// (1) or the connection is done (0); with HPACK in Xo also 2,
/// a header block fragment to decode, and 3, response heads to encode
/// (std/native/llrt/hpack.xo, decision 0193 step 6).
fn h2_next(h: HConn) -> Int
/// The fragment to decode (after 2) and whether its block's first
/// representation is still to come.
fn h2_block(h: HConn) -> Str
fn h2_block_first(h: HConn) -> Bool
/// Goes on with the decoded fields (hpack.Fields) and the parse of their
/// first :path (http1.h2_target); true when a 100 Continue is to be
/// encoded now (h2_enc_job, h2_encoded).
fn h2_fields(h: HConn, ok: Int, used: Int, data: Str, lens: List[Int], first: Bool, target: List[Str]) -> Bool
/// The table size settings and heads to encode (after 3, or h2_fields
/// true), and the blocks encoded for them.
fn h2_enc_job(h: HConn) -> Str
fn h2_encoded(h: HConn, blocks: Str)
/// The request h2_next found: a stream, answered as a connection is
/// (hc_header, hc_respond, sink_conn).
fn h2_take(h: HConn) -> HConn
/// The stream's handler is done; a response it did not finish resets
/// the stream.
fn h2_end(h: HConn)

/// Client (std/native/llrt/http1.xo client_do drives it, redirects
/// included): the deadline of a timeout in ns (> 0).
fn cl_deadline(timeout: Int) -> Int
/// One request: method to addr (host:port; https: TLS with the server
/// name tls_host, verified against roots), the request target (the
/// escaped path and query), the Host, a header of canonical names and
/// values, the body, the deadline (0: none), and the start of its
/// errors (the method and the quoted URL). Over HTTP/2 (ALPN h2) the
/// response is in the CResp (cr_status, ...); over HTTP/1.1 cl_reading
/// is true and Xo reads it (cl_input, cl_fill, cl_take), then calls
/// cl_end. A failure sets cr_err.
fn cl_start(method: Str, https: Bool, addr: Str, tls_host: Str, target: Str, host: Str, names: List[Str], values: List[Str], body: Bytes, when: Int, roots: Roots, prefix: Str) -> CResp
fn cl_reading(r: CResp) -> Bool
/// The unread response up to the end of its first head (mode 0), or all
/// of it (mode 2).
fn cl_input(r: CResp, mode: Int) -> Str
fn cl_avail(r: CResp) -> Int
fn cl_eof(r: CResp) -> Bool
/// Reads more: 0 (CC_OK), 1 none came (CC_EOF), else the failure
/// (2 timeout, 3 canceled, 4 an error).
fn cl_fill(r: CResp) -> Int
/// Takes n bytes of the input, or skips them.
fn cl_take(r: CResp, n: Int) -> Bytes
fn cl_skip(r: CResp, n: Int)
/// Ends the exchange with result s (cl_fill's) and the failure's text:
/// the connection closes and a failure sets cr_err.
fn cl_end(r: CResp, s: Int, why: Str)
/// 0 a response, else the ClientErr tag (1 InvalidUrl, 2 Connect,
/// 3 Timeout, 4 Protocol, 5 Canceled).
fn cr_err(r: CResp) -> Int
fn cr_msg(r: CResp) -> Str
/// An HTTP/2 response.
fn cr_status(r: CResp) -> Int
fn cr_nheaders(r: CResp) -> Int
fn cr_hname(r: CResp, i: Int) -> Str
fn cr_hval(r: CResp, i: Int) -> Str
fn cr_body(r: CResp) -> Bytes

/// Streamed bodies (http.stream, decision 0083): a sink takes a stream's
/// writes, into a buffer or to a connection as net/http sends them.
struct Sink {}
fn sink_buf() -> Sink
fn sink_conn(h: HConn, status: Int) -> Sink
/// false: the connection failed.
fn sink_write(s: Sink, data: Bytes) -> Bool
fn sink_flush(s: Sink) -> Bool
/// Ends the stream on its connection: whether it stays open.
fn sink_end(s: Sink) -> Bool
/// The body a buffer sink collected.
fn sink_take(s: Sink) -> Bytes
/// Keeps a stream's function (an Any): its number (a Response's stream).
fn stream_put(f: rt.Any) -> Int
/// The function of stream id, or none; take removes it.
fn stream_get(id: Int, take: Bool) -> List[rt.Any]

/// TLS (decision 0105, std/llrt/xo_tls.c): a certificate chain with its
/// private key (xo_tcert) and the roots a client trusts (xo_troots).
struct TCert {}
struct Roots {}
/// tls.X509KeyPair; tls_cert_err is its error, "" when it succeeded.
fn tls_cert(cert_pem: Bytes, key_pem: Bytes) -> TCert
fn tls_cert_err(c: TCert) -> Str
/// The certificates of pem; tls_roots_err is "" when there is one.
fn tls_roots(pem: Bytes) -> Roots
fn tls_roots_err(r: Roots) -> Str
/// The system's roots (loaded at the first https request).
fn tls_roots_system() -> Roots
/// Adds a certificate to the server; the first turns TLS on.
fn srv_tls(s: Srv, c: TCert)
