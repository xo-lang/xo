// std/crc64 on the native backends: Go's hash/crc64 (crc64.go of
// go1.26.1), slicing-by-8: eight bytes a step, read as one word (the
// first lowest), then a byte at a time. The tables are Go's
// slicingMakeTable of the reversed polynomials, as little endian words of
// Go's uint64 bits (read with rt.bytes_word, which is unchecked); the
// corpus checks them against the bit loop.
use std/crc64
use native/rt

fn checksum(data: Bytes, poly: crc64.Poly = crc64.Poly.Iso) -> Int { update(0, data, poly) }

fn update(crc: Int, data: Bytes, poly: crc64.Poly = crc64.Poly.Iso) -> Int {
  match poly {
    crc64.Poly.Iso => slicing_iso(crc, data)
    crc64.Poly.Ecma => slicing_ecma(crc, data)
  }
}

/// slicing-by-8: byte k of the word picks table 7 - k (word i of table j is
/// the CRC of byte i followed by j zero bytes), and the index comes out of
/// one shift and one mask already times 8, so each byte is a shift, a mask,
/// a load and an xor. One function a polynomial, so each table is a static
/// address.
fn slicing_iso(crc: Int, b: Bytes) -> Int {
  var c = ~crc
  var i = 0
  let n = b.len()
  if n >= 8 {
    let last = n - 8
    while i <= last {
      c = c ^ rt.bytes_word(b, i)
      c = rt.bytes_word(ISO_7, c.wrapping_shl(3) & 2040) ^ rt.bytes_word(ISO_6, (c >> 5) & 2040) ^ rt.bytes_word(ISO_5, (c >> 13) & 2040) ^ rt.bytes_word(ISO_4, (c >> 21) & 2040) ^ rt.bytes_word(ISO_3, (c >> 29) & 2040) ^ rt.bytes_word(ISO_2, (c >> 37) & 2040) ^ rt.bytes_word(ISO_1, (c >> 45) & 2040) ^ rt.bytes_word(ISO_0, (c.shr_logical(53)) & 2040)
      i += 8
    }
  }
  while i < n {
    c = rt.bytes_word(ISO_0, ((c ^ Int(b[i])) & 255) << 3) ^ c.shr_logical(8)
    i += 1
  }
  ~c
}

fn slicing_ecma(crc: Int, b: Bytes) -> Int {
  var c = ~crc
  var i = 0
  let n = b.len()
  if n >= 8 {
    let last = n - 8
    while i <= last {
      c = c ^ rt.bytes_word(b, i)
      c = rt.bytes_word(ECMA_7, c.wrapping_shl(3) & 2040) ^ rt.bytes_word(ECMA_6, (c >> 5) & 2040) ^ rt.bytes_word(ECMA_5, (c >> 13) & 2040) ^ rt.bytes_word(ECMA_4, (c >> 21) & 2040) ^ rt.bytes_word(ECMA_3, (c >> 29) & 2040) ^ rt.bytes_word(ECMA_2, (c >> 37) & 2040) ^ rt.bytes_word(ECMA_1, (c >> 45) & 2040) ^ rt.bytes_word(ECMA_0, (c.shr_logical(53)) & 2040)
      i += 8
    }
  }
  while i < n {
    c = rt.bytes_word(ECMA_0, ((c ^ Int(b[i])) & 255) << 3) ^ c.shr_logical(8)
    i += 1
  }
  ~c
}

