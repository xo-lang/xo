// std/crc64 on the native backends: Go's hash/crc64 (crc64.go of
// go1.26.1), slicing-by-8: eight bytes a step, read as one word (the
// first lowest), then a byte at a time. The tables are Go's
// slicingMakeTable of the reversed polynomials, as Ints holding Go's
// uint64 bits; the corpus checks them against the bit loop.
use std/crc64
use native/rt

fn checksum(data: Bytes, poly: crc64.Poly = crc64.Poly.Iso) -> Int { update(0, data, poly) }

fn update(crc: Int, data: Bytes, poly: crc64.Poly = crc64.Poly.Iso) -> Int {
  match poly {
    crc64.Poly.Iso => slicing(ISO, crc, data)
    crc64.Poly.Ecma => slicing(ECMA, crc, data)
  }
}

fn slicing(t: List[Int], crc: Int, b: Bytes) -> Int {
  var c = ~crc
  var i = 0
  let n = b.len()
  while i + 8 <= n {
    c = c ^ rt.bytes_word(b, i)
    c = t[1792 + (c & 255)] ^ t[1536 + ((c >> 8) & 255)] ^ t[1280 + ((c >> 16) & 255)] ^ t[1024 + ((c >> 24) & 255)] ^ t[768 + ((c >> 32) & 255)] ^ t[512 + ((c >> 40) & 255)] ^ t[256 + ((c >> 48) & 255)] ^ t[(c >> 56) & 255]
    i += 8
  }
  while i < n {
    c = t[(c ^ Int(b[i])) & 255] ^ c.shr_logical(8)
    i += 1
  }
  ~c
}

