// std/otlp (decision 0539): the OTLP trace and metrics messages as derive Proto structs (decision 0549),
// marshaled by std/protobuf.
use std/backoff
use std/crypto
use std/http
use std/metrics
use std/otlp
use std/protobuf
use std/time
use std/trace

fn hex_val(c: UInt8) -> Int {
  if c >= 48 && c <= 57 {
    return Int(c) - 48
  }
  if c >= 97 && c <= 102 {
    return Int(c) - 87
  }
  if c >= 65 && c <= 70 {
    return Int(c) - 55
  }
  -1
}

/// The 16 bytes of a trace id: the id itself when it is 32 hex digits, else the first 16 bytes of the
/// SHA-256 of the text.
fn trace_id(id: Str) -> Bytes {
  let b = id.bytes()
  if b.len() == 32 {
    var out = BytesBuilder.new()
    var ok = true
    var i = 0
    while i < 32 {
      let h = hex_val(b[i])
      let l = hex_val(b[i + 1])
      if h < 0 || l < 0 {
        ok = false
      } else {
        out.write_byte(UInt8.wrapping_from(h * 16 + l))
      }
      i += 2
    }
    if ok {
      return out.freeze()
    }
  }
  crypto.sha256(b)[0..16]
}

/// The 8 bytes of a span id from the text that names it.
fn span_id(seed: Str) -> Bytes {
  crypto.sha256(seed.bytes())[0..8]
}

fn root_id(id: Str) -> Bytes { span_id("${id}/request") }

/// The bytes of a hex text (lower or upper case), or None when it is not whole hex pairs.
fn unhex_text(t: Str) -> Bytes? {
  let b = t.bytes()
  if b.len() % 2 != 0 {
    return None
  }
  var out = BytesBuilder.new()
  var i = 0
  while i < b.len() {
    let h = hex_val(b[i])
    let l = hex_val(b[i + 1])
    if h < 0 || l < 0 {
      return None
    }
    out.write_byte(UInt8.wrapping_from(h * 16 + l))
    i += 2
  }
  Some(out.freeze())
}

fn kind_num(k: trace.SpanKind) -> Int {
  match k {
    trace.SpanKind.Unspecified => 0
    trace.SpanKind.Internal => 1
    trace.SpanKind.Server => 2
    trace.SpanKind.Client => 3
    trace.SpanKind.Producer => 4
    trace.SpanKind.Consumer => 5
  }
}

fn status_num(c: trace.StatusCode) -> Int {
  match c {
    trace.StatusCode.Unset => 0
    trace.StatusCode.Ok => 1
    trace.StatusCode.Error => 2
  }
}

// The trace messages (opentelemetry-proto trace.proto, common.proto,
// resource.proto, collector/trace/v1) as derive Proto structs (decision
// 0549 item 3): a message protobuf-go writes even when empty is an Option.

enum AnyKind {
  S as "1"(v: Str)
  B as "2"(v: Bool)
  I as "3"(v: Int)
  D as "4"(v: Float)
} derive Proto

struct AnyValueMsg { value proto "oneof": AnyKind? = None } derive Proto

struct KeyValueMsg {
  key proto "1": Str = ""
  value proto "2": AnyValueMsg? = None
} derive Proto

struct EventMsg {
  time_unix_nano proto "1,fixed": UInt64 = 0
  name proto "2": Str = ""
  attributes proto "3": List[KeyValueMsg] = []
} derive Proto

struct StatusMsg {
  message proto "2": Str = ""
  code proto "3": Int = 0
} derive Proto

struct SpanMsg {
  trace_id proto "1": Bytes = b""
  span_id proto "2": Bytes = b""
  parent_span_id proto "4": Bytes = b""
  name proto "5": Str = ""
  kind proto "6": Int = 0
  start_time_unix_nano proto "7,fixed": UInt64 = 0
  end_time_unix_nano proto "8,fixed": UInt64 = 0
  attributes proto "9": List[KeyValueMsg] = []
  events proto "11": List[EventMsg] = []
  status proto "15": StatusMsg? = None
  flags proto "16,fixed": UInt32 = 0
} derive Proto

struct ScopeMsg {
  name proto "1": Str = ""
  version proto "2": Str = ""
} derive Proto

struct ScopeSpansMsg {
  scope proto "1": ScopeMsg? = None
  spans proto "2": List[SpanMsg] = []
  schema_url proto "3": Str = ""
} derive Proto

struct ResourceMsg { attributes proto "1": List[KeyValueMsg] = [] } derive Proto

struct ResourceSpansMsg {
  resource proto "1": ResourceMsg? = None
  scope_spans proto "2": List[ScopeSpansMsg] = []
} derive Proto

struct TracesRequestMsg { resource_spans proto "1": List[ResourceSpansMsg] = [] } derive Proto

fn kv_msg(a: trace.Attr) -> KeyValueMsg {
  let v = match a.value {
    trace.AttrValue.Str(x) => AnyKind.S(x)
    trace.AttrValue.Bool(x) => AnyKind.B(x)
    trace.AttrValue.Int(x) => AnyKind.I(x)
    trace.AttrValue.Float(x) => AnyKind.D(x)
  }
  KeyValueMsg{key: a.key, value: Some(AnyValueMsg{value: Some(v)})}
}

/// A resource attribute: an empty value leaves AnyValue empty, as the hand writer and protobuf-go's corpus did.
fn kv_str_msg(key: Str, value: Str) -> KeyValueMsg {
  KeyValueMsg{key: key, value: Some(AnyValueMsg{value: if value.is_empty() { None } else { Some(AnyKind.S(value)) }})}
}

fn span_msg(s: trace.Span) -> SpanMsg {
  let root = s.name == "request" && s.parent_id.is_empty()
  let tid = if s.trace_id.is_empty() { trace_id(s.id) } else { unhex_text(s.trace_id) ?? trace_id(s.id) }
  let own = if s.span_id.is_empty() { None } else { unhex_text(s.span_id) }
  let sid = own ?? (if root { root_id(s.id) } else { span_id("${s.id}/${s.name}/${s.start_ms}/${s.micros}") })
  let parent = if s.parent_id == "root" { b"" } else if s.parent_id.is_empty() { if root { b"" } else { root_id(s.id) } } else { unhex_text(s.parent_id) ?? root_id(s.id) }
  // OpenTelemetry Go exports an unspecified kind as internal
  let kind = match s.kind {
    Some(k) => if k == trace.SpanKind.Unspecified { 1 } else { kind_num(k) }
    None => if root { 2 } else { 1 }
  }
  let start = if s.start_ns > 0 { s.start_ns } else { s.start_ms * 1000000 }
  let end = if s.end_ns > 0 { s.end_ns } else { start + s.micros * 1000 }
  let http_status = s.status > 0 && s.name == "request" && s.parent_id.is_empty()
  var attrs: List[KeyValueMsg] = []
  if http_status {
    attrs.push(KeyValueMsg{key: "http.response.status_code", value: Some(AnyValueMsg{value: Some(AnyKind.I(s.status))})})
  }
  for a in s.attributes {
    attrs.push(kv_msg(a))
  }
  var events: List[EventMsg] = []
  for e in s.events {
    var ea: List[KeyValueMsg] = []
    for a in e.attributes {
      ea.push(kv_msg(a))
    }
    events.push(EventMsg{time_unix_nano: UInt64.wrapping_from(e.time_ns), name: e.name, attributes: ea})
  }
  var st: StatusMsg? = None
  match s.status_code {
    Some(c) => {
      st = Some(StatusMsg{message: if c == trace.StatusCode.Error { s.status_message } else { "" }, code: status_num(c)})
    }
    None => {
      if http_status {
        st = Some(StatusMsg{code: if s.status >= 500 { 2 } else { 1 }})
      }
    }
  }
  // A span made by a Recorder (it has its own span id) is written as OpenTelemetry Go's SDK does: its status is
  // always present, even empty, and its flags say the parent is known not to be remote (0x100) and sampled (0x01).
  let otel = !s.span_id.is_empty()
  if otel && st == None {
    st = Some(StatusMsg{})
  }
  SpanMsg{trace_id: tid, span_id: sid, parent_span_id: parent, name: s.name, kind: kind,
    start_time_unix_nano: UInt64.wrapping_from(start), end_time_unix_nano: UInt64.wrapping_from(end),
    attributes: attrs, events: events, status: st, flags: if otel { 257 } else { 0 }}
}

fn encode_traces(res: otlp.Resource, spans: List[trace.Span]) -> Bytes {
  var rattrs = [kv_str_msg("service.name", res.service)]
  for (k, v) in res.attributes {
    rattrs.push(kv_str_msg(k, v))
  }
  // ScopeSpans groups, in order of first appearance; a span with no scope joins the Resource's.
  var groups: List[ScopeSpansMsg] = []
  if spans.is_empty() {
    groups.push(ScopeSpansMsg{scope: Some(ScopeMsg{name: res.scope, version: res.version})})
  }
  for s in spans {
    let n = if s.scope.is_empty() { res.scope } else { s.scope }
    let v = if s.scope.is_empty() { res.version } else { s.scope_version }
    var at = -1
    for (i, g) in groups.indexed() {
      if at < 0 {
        if let Some(sc) = g.scope {
          if sc.name == n && sc.version == v && g.schema_url == s.schema_url {
            at = i
          }
        }
      }
    }
    if at < 0 {
      groups.push(ScopeSpansMsg{scope: Some(ScopeMsg{name: n, version: v}), schema_url: s.schema_url})
      at = groups.len() - 1
    }
    groups[at].spans.push(span_msg(s))
  }
  protobuf.marshal(TracesRequestMsg{resource_spans: [ResourceSpansMsg{resource: Some(ResourceMsg{attributes: rattrs}), scope_spans: groups}]})
}

// The metrics messages (opentelemetry-proto metrics.proto) as derive Proto
// structs: a Metric's data and a NumberDataPoint's value are oneofs.

enum NumberValue {
  AsDouble as "4"(v: Float)
} derive Proto

struct NumberPointMsg {
  start_time_unix_nano proto "2,fixed": UInt64 = 0
  time_unix_nano proto "3,fixed": UInt64 = 0
  value proto "oneof": NumberValue? = None
  attributes proto "7": List[KeyValueMsg] = []
} derive Proto

struct HistogramPointMsg {
  start_time_unix_nano proto "2,fixed": UInt64 = 0
  time_unix_nano proto "3,fixed": UInt64 = 0
  count proto "4,fixed": UInt64 = 0
  sum proto "5": Float? = None
  bucket_counts proto "6,fixed": List[UInt64] = []
  explicit_bounds proto "7": List[Float] = []
  attributes proto "9": List[KeyValueMsg] = []
} derive Proto

struct SummaryPointMsg {
  start_time_unix_nano proto "2,fixed": UInt64 = 0
  time_unix_nano proto "3,fixed": UInt64 = 0
  count proto "4,fixed": UInt64 = 0
  sum proto "5": Float = 0.0
  attributes proto "7": List[KeyValueMsg] = []
} derive Proto

struct GaugeMsg { data_points proto "1": List[NumberPointMsg] = [] } derive Proto

struct SumMsg {
  data_points proto "1": List[NumberPointMsg] = []
  aggregation_temporality proto "2": Int = 0
  is_monotonic proto "3": Bool = false
} derive Proto

struct HistogramMsg {
  data_points proto "1": List[HistogramPointMsg] = []
  aggregation_temporality proto "2": Int = 0
} derive Proto

struct SummaryMsg { data_points proto "1": List[SummaryPointMsg] = [] } derive Proto

enum MetricData {
  Gauge as "5"(v: GaugeMsg)
  Sum as "7"(v: SumMsg)
  Histogram as "9"(v: HistogramMsg)
  Summary as "11"(v: SummaryMsg)
} derive Proto

struct MetricMsg {
  name proto "1": Str = ""
  description proto "2": Str = ""
  data proto "oneof": MetricData? = None
} derive Proto

struct ScopeMetricsMsg {
  scope proto "1": ScopeMsg? = None
  metrics proto "2": List[MetricMsg] = []
} derive Proto

struct ResourceMetricsMsg {
  resource proto "1": ResourceMsg? = None
  scope_metrics proto "2": List[ScopeMetricsMsg] = []
} derive Proto

struct MetricsRequestMsg { resource_metrics proto "1": List[ResourceMetricsMsg] = [] } derive Proto

fn labels_msg(labels: List[Str], values: List[Str]) -> List[KeyValueMsg] {
  var out: List[KeyValueMsg] = []
  for (i, l) in labels.indexed() {
    out.push(kv_str_msg(l, values[i]))
  }
  out
}

fn ns(ms: Int) -> UInt64 { UInt64.wrapping_from(ms * 1000000) }

fn number_point(f: metrics.Family, values: List[Str], v: Float, start_ms: Int, now_ms: Int, with_start: Bool) -> NumberPointMsg {
  NumberPointMsg{start_time_unix_nano: if with_start { ns(start_ms) } else { 0 }, time_unix_nano: ns(now_ms), value: Some(NumberValue.AsDouble(v)), attributes: labels_msg(f.labels, values)}
}

fn load_cell(a: Atomic[Int]) -> Float {
  Float.from_bits(a.get())
}

fn family_msg(f: metrics.Family, start_ms: Int, now_ms: Int) -> MetricMsg {
  var nums: List[NumberPointMsg] = []
  var hists: List[HistogramPointMsg] = []
  var sums: List[SummaryPointMsg] = []
  if let Some(read) = f.reads.get(0) {
    let ss = read().sort_by(fn(x: metrics.Sample) -> Str { x.values.join("\x1f") })
    for x in ss {
      nums.push(number_point(f, x.values, x.value, start_ms, now_ms, f.kind == 0))
    }
  } else {
    let sm = f.series.with_read(fn(m: Map[Str, metrics.Series]) -> Map[Str, metrics.Series] { m })
    for k in sm.keys().sort() {
      let s = sm.get(k) ?? continue
      if f.kind < 2 {
        // a counter's whole increments are in cell 1 (std/metrics counter_cells_add)
        let v = if f.kind == 0 { load_cell(s.cells[0]) + Float(s.cells[1].get()) } else { load_cell(s.cells[0]) }
        nums.push(number_point(f, s.values, v, start_ms, now_ms, f.kind == 0))
      } else if f.kind == 3 {
        sums.push(SummaryPointMsg{start_time_unix_nano: ns(start_ms), time_unix_nano: ns(now_ms), count: UInt64.wrapping_from(s.cells[1].get()), sum: load_cell(s.cells[2]), attributes: labels_msg(f.labels, s.values)})
      } else {
        var counts: List[UInt64] = []
        var upto = 0
        for (i, _) in f.bounds.indexed() {
          let c = s.cells[3 + i].get()
          upto += c
          counts.push(UInt64.wrapping_from(c))
        }
        let n = s.cells[1].get()
        counts.push(UInt64.wrapping_from(n - upto))
        hists.push(HistogramPointMsg{start_time_unix_nano: ns(start_ms), time_unix_nano: ns(now_ms), count: UInt64.wrapping_from(n), sum: Some(load_cell(s.cells[2])), bucket_counts: counts, explicit_bounds: f.bounds, attributes: labels_msg(f.labels, s.values)})
      }
    }
  }
  let data = if f.kind == 0 {
    MetricData.Sum(SumMsg{data_points: nums, aggregation_temporality: 2, is_monotonic: true})
  } else if f.kind == 1 {
    MetricData.Gauge(GaugeMsg{data_points: nums})
  } else if f.kind == 3 {
    MetricData.Summary(SummaryMsg{data_points: sums})
  } else {
    MetricData.Histogram(HistogramMsg{data_points: hists, aggregation_temporality: 2})
  }
  MetricMsg{name: f.name, description: f.help, data: Some(data)}
}

fn encode_metrics(res: otlp.Resource, reg: metrics.Registry, start_ms: Int, now_ms: Int) -> Bytes {
  var rattrs = [kv_str_msg("service.name", res.service)]
  for (k, v) in res.attributes {
    rattrs.push(kv_str_msg(k, v))
  }
  let fs = reg.families.with_read(fn(l: List[metrics.Family]) -> List[metrics.Family] { l })
  var ms: List[MetricMsg] = []
  for f in fs {
    ms.push(family_msg(f, start_ms, now_ms))
  }
  let sc = ScopeMetricsMsg{scope: Some(ScopeMsg{name: res.scope, version: res.version}), metrics: ms}
  protobuf.marshal(MetricsRequestMsg{resource_metrics: [ResourceMetricsMsg{resource: Some(ResourceMsg{attributes: rattrs}), scope_metrics: [sc]}]})
}

fn exporterr_display(e: otlp.ExportErr) -> Str {
  match e {
    Transport(msg) => "export: ${msg}"
    Rejected(status, body) => "export rejected: ${status} ${body}"
    GaveUp(status, tries) => "export gave up after ${tries} tries: ${status}"
  }
}

fn exporter(client: http.Client, endpoint: Str, res: otlp.Resource, clock: Clock, rand: Rand) -> otlp.Exporter {
  otlp.Exporter{client: client, endpoint: endpoint.trim_suffix("/"), resource: res, headers: {}, backoff: backoff.Backoff{initial: 500ms, multiplier: 1.5, randomization: 0.5, max_interval: 60s, max_elapsed: 15m, max_tries: 5}, clock: clock, rand: rand}
}

fn exporter_with_headers(e: otlp.Exporter, h: Map[Str, Str]) -> otlp.Exporter { e with {headers: h} }

fn exporter_with_backoff(e: otlp.Exporter, b: backoff.Backoff) -> otlp.Exporter { e with {backoff: b} }

fn retryable(status: Int) -> Bool { status == 429 || status == 502 || status == 503 || status == 504 }

/// The seconds a Retry-After value asks for: a number of seconds, or an HTTP date (RFC 9110) counted from
/// `now`; 0 when absent, in the past or not understood.
fn retry_after(resp: http.Response, now: Time) -> Int {
  let v = (resp.header("Retry-After") ?? return 0).trim()
  match Int.parse(v) {
    Some(n) => if n > 0 { n } else { 0 }
    None => match time.RFC1123_LAYOUT.parse(v, time.utc()) {
      Ok(t) => {
        let d = t.unix() - now.unix()
        if d > 0 { d } else { 0 }
      }
      Err(_) => 0
    }
  }
}

fn post(e: otlp.Exporter, path: Str, body: Bytes) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  var headers = e.headers
  headers["Content-Type"] = "application/x-protobuf"
  var tries = 0
  while true {
    tries += 1
    let req = http.new_request("POST", "${e.endpoint}${path}", headers, body)
    let resp = match e.client.send(req) {
      Ok(r) => r
      Err(err) => {
        // no answer: retried as a 503 would be
        if e.backoff.max_tries != 0 && tries >= e.backoff.max_tries {
          return Err(otlp.ExportErr.Transport(msg: "${err}"))
        }
        e.clock.sleep(e.backoff.delay(tries - 1, e.rand))
        continue
      }
    }
    if resp.status >= 200 && resp.status < 300 {
      return Ok(())
    }
    if !retryable(resp.status) {
      return Err(otlp.ExportErr.Rejected(status: resp.status, body: resp.body.to_str() ?? ""))
    }
    if e.backoff.max_tries != 0 && tries >= e.backoff.max_tries {
      return Err(otlp.ExportErr.GaveUp(status: resp.status, tries: tries))
    }
    let wait = e.backoff.delay(tries - 1, e.rand)
    let asked = Duration.from_secs_int(retry_after(resp, e.clock.now()))
    e.clock.sleep(if asked > wait { asked } else { wait })
  }
  Ok(())
}

fn exporter_send_traces(e: otlp.Exporter, spans: List[trace.Span]) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  if spans.is_empty() {
    return Ok(())
  }
  post(e, "/v1/traces", encode_traces(e.resource, spans))
}

fn exporter_send_metrics(e: otlp.Exporter, reg: metrics.Registry, start_ms: Int) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  post(e, "/v1/metrics", encode_metrics(e.resource, reg, start_ms, e.clock.now().unix_millis()))
}
