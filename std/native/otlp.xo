// std/otlp (decision 0539): the OTLP trace and metrics messages as derive Proto structs (decision 0549),
// marshaled by std/protobuf.
use std/backoff
use std/compress
use std/crypto
use std/grpc
use std/http
use std/json
use std/log
use std/metrics
use std/otlp
use std/protobuf
use std/time
use std/trace

fn hex_val(c: UInt8) -> Int {
  if c >= 48 && c <= 57 {
    return Int(c) - 48
  }
  if c >= 97 && c <= 102 {
    return Int(c) - 87
  }
  if c >= 65 && c <= 70 {
    return Int(c) - 55
  }
  -1
}

/// The 16 bytes of a trace id: the id itself when it is 32 hex digits, else the first 16 bytes of the
/// SHA-256 of the text.
fn trace_id(id: Str) -> Bytes {
  let b = id.bytes()
  if b.len() == 32 {
    var out = BytesBuilder.new()
    var ok = true
    var i = 0
    while i < 32 {
      let h = hex_val(b[i])
      let l = hex_val(b[i + 1])
      if h < 0 || l < 0 {
        ok = false
      } else {
        out.write_byte(UInt8.wrapping_from(h * 16 + l))
      }
      i += 2
    }
    if ok {
      return out.freeze()
    }
  }
  crypto.sha256(b)[0..16]
}

/// The 8 bytes of a span id from the text that names it.
fn span_id(seed: Str) -> Bytes {
  crypto.sha256(seed.bytes())[0..8]
}

fn root_id(id: Str) -> Bytes { span_id("${id}/request") }

/// The bytes of a hex text (lower or upper case), or None when it is not whole hex pairs.
fn unhex_text(t: Str) -> Bytes? {
  let b = t.bytes()
  if b.len() % 2 != 0 {
    return None
  }
  var out = BytesBuilder.new()
  var i = 0
  while i < b.len() {
    let h = hex_val(b[i])
    let l = hex_val(b[i + 1])
    if h < 0 || l < 0 {
      return None
    }
    out.write_byte(UInt8.wrapping_from(h * 16 + l))
    i += 2
  }
  Some(out.freeze())
}

fn kind_num(k: trace.SpanKind) -> Int {
  match k {
    trace.SpanKind.Unspecified => 0
    trace.SpanKind.Internal => 1
    trace.SpanKind.Server => 2
    trace.SpanKind.Client => 3
    trace.SpanKind.Producer => 4
    trace.SpanKind.Consumer => 5
  }
}

fn status_num(c: trace.StatusCode) -> Int {
  match c {
    trace.StatusCode.Unset => 0
    trace.StatusCode.Ok => 1
    trace.StatusCode.Error => 2
  }
}

// The trace messages (opentelemetry-proto trace.proto, common.proto,
// resource.proto, collector/trace/v1) as derive Proto structs (decision
// 0549 item 3): a message protobuf-go writes even when empty is an Option.

enum AnyKind {
  S as "1"(v: Str)
  B as "2"(v: Bool)
  I as "3"(v: Int)
  D as "4"(v: Float)
} derive Proto

struct AnyValueMsg { value proto "oneof": AnyKind? = None } derive Proto

struct KeyValueMsg {
  key proto "1": Str = ""
  value proto "2": AnyValueMsg? = None
} derive Proto

struct EventMsg {
  time_unix_nano proto "1,fixed": UInt64 = 0
  name proto "2": Str = ""
  attributes proto "3": List[KeyValueMsg] = []
} derive Proto

struct StatusMsg {
  message proto "2": Str = ""
  code proto "3": Int = 0
} derive Proto

struct SpanMsg {
  trace_id proto "1": Bytes = b""
  span_id proto "2": Bytes = b""
  parent_span_id proto "4": Bytes = b""
  name proto "5": Str = ""
  kind proto "6": Int = 0
  start_time_unix_nano proto "7,fixed": UInt64 = 0
  end_time_unix_nano proto "8,fixed": UInt64 = 0
  attributes proto "9": List[KeyValueMsg] = []
  events proto "11": List[EventMsg] = []
  status proto "15": StatusMsg? = None
  flags proto "16,fixed": UInt32 = 0
} derive Proto

struct ScopeMsg {
  name proto "1": Str = ""
  version proto "2": Str = ""
} derive Proto

struct ScopeSpansMsg {
  scope proto "1": ScopeMsg? = None
  spans proto "2": List[SpanMsg] = []
  schema_url proto "3": Str = ""
} derive Proto

struct ResourceMsg { attributes proto "1": List[KeyValueMsg] = [] } derive Proto

struct ResourceSpansMsg {
  resource proto "1": ResourceMsg? = None
  scope_spans proto "2": List[ScopeSpansMsg] = []
} derive Proto

struct TracesRequestMsg { resource_spans proto "1": List[ResourceSpansMsg] = [] } derive Proto

fn kv_msg(a: trace.Attr) -> KeyValueMsg {
  let v = match a.value {
    trace.AttrValue.Str(x) => AnyKind.S(x)
    trace.AttrValue.Bool(x) => AnyKind.B(x)
    trace.AttrValue.Int(x) => AnyKind.I(x)
    trace.AttrValue.Float(x) => AnyKind.D(x)
  }
  KeyValueMsg{key: a.key, value: Some(AnyValueMsg{value: Some(v)})}
}

/// A resource attribute: an empty value leaves AnyValue empty, as the hand writer and protobuf-go's corpus did.
fn kv_str_msg(key: Str, value: Str) -> KeyValueMsg {
  KeyValueMsg{key: key, value: Some(AnyValueMsg{value: if value.is_empty() { None } else { Some(AnyKind.S(value)) }})}
}

fn span_msg(s: trace.Span) -> SpanMsg {
  let root = s.name == "request" && s.parent_id.is_empty()
  let tid = if s.trace_id.is_empty() { trace_id(s.id) } else { unhex_text(s.trace_id) ?? trace_id(s.id) }
  let own = if s.span_id.is_empty() { None } else { unhex_text(s.span_id) }
  let sid = own ?? (if root { root_id(s.id) } else { span_id("${s.id}/${s.name}/${s.start_ms}/${s.micros}") })
  let parent = if s.parent_id == "root" { b"" } else if s.parent_id.is_empty() { if root { b"" } else { root_id(s.id) } } else { unhex_text(s.parent_id) ?? root_id(s.id) }
  // OpenTelemetry Go exports an unspecified kind as internal
  let kind = match s.kind {
    Some(k) => if k == trace.SpanKind.Unspecified { 1 } else { kind_num(k) }
    None => if root { 2 } else { 1 }
  }
  let start = if s.start_ns > 0 { s.start_ns } else { s.start_ms * 1000000 }
  let end = if s.end_ns > 0 { s.end_ns } else { start + s.micros * 1000 }
  let http_status = s.status > 0 && s.name == "request" && s.parent_id.is_empty()
  var attrs: List[KeyValueMsg] = []
  if http_status {
    attrs.push(KeyValueMsg{key: "http.response.status_code", value: Some(AnyValueMsg{value: Some(AnyKind.I(s.status))})})
  }
  for a in s.attributes {
    attrs.push(kv_msg(a))
  }
  var events: List[EventMsg] = []
  for e in s.events {
    var ea: List[KeyValueMsg] = []
    for a in e.attributes {
      ea.push(kv_msg(a))
    }
    events.push(EventMsg{time_unix_nano: UInt64.wrapping_from(e.time_ns), name: e.name, attributes: ea})
  }
  var st: StatusMsg? = None
  match s.status_code {
    Some(c) => {
      st = Some(StatusMsg{message: if c == trace.StatusCode.Error { s.status_message } else { "" }, code: status_num(c)})
    }
    None => {
      if http_status {
        st = Some(StatusMsg{code: if s.status >= 500 { 2 } else { 1 }})
      }
    }
  }
  // A span made by a Recorder (it has its own span id) is written as OpenTelemetry Go's SDK does: its status is
  // always present, even empty, and its flags say the parent is known not to be remote (0x100) and sampled (0x01).
  let otel = !s.span_id.is_empty()
  if otel && st == None {
    st = Some(StatusMsg{})
  }
  SpanMsg{trace_id: tid, span_id: sid, parent_span_id: parent, name: s.name, kind: kind,
    start_time_unix_nano: UInt64.wrapping_from(start), end_time_unix_nano: UInt64.wrapping_from(end),
    attributes: attrs, events: events, status: st, flags: if otel { 257 } else { 0 }}
}

fn traces_msg(res: otlp.Resource, spans: List[trace.Span]) -> TracesRequestMsg {
  var rattrs = [kv_str_msg("service.name", res.service)]
  for (k, v) in res.attributes {
    rattrs.push(kv_str_msg(k, v))
  }
  // ScopeSpans groups, in order of first appearance; a span with no scope joins the Resource's.
  var groups: List[ScopeSpansMsg] = []
  if spans.is_empty() {
    groups.push(ScopeSpansMsg{scope: Some(ScopeMsg{name: res.scope, version: res.version})})
  }
  for s in spans {
    let n = if s.scope.is_empty() { res.scope } else { s.scope }
    let v = if s.scope.is_empty() { res.version } else { s.scope_version }
    var at = -1
    for (i, g) in groups.indexed() {
      if at < 0 {
        if let Some(sc) = g.scope {
          if sc.name == n && sc.version == v && g.schema_url == s.schema_url {
            at = i
          }
        }
      }
    }
    if at < 0 {
      groups.push(ScopeSpansMsg{scope: Some(ScopeMsg{name: n, version: v}), schema_url: s.schema_url})
      at = groups.len() - 1
    }
    groups[at].spans.push(span_msg(s))
  }
  TracesRequestMsg{resource_spans: [ResourceSpansMsg{resource: Some(ResourceMsg{attributes: rattrs}), scope_spans: groups}]}
}

fn encode_traces(res: otlp.Resource, spans: List[trace.Span]) -> Bytes {
  protobuf.marshal(traces_msg(res, spans))
}

// OTLP's JSON mapping, written field by field in the order OpenTelemetry Go's
// otlptracehttp/internal/otlpjson writes them (encoding/json over the proto
// field order): empty fields left out, ids as hex, 64 bit integers quoted.

fn jstr(s: Str) -> Str { json.html_escape(json.encode_str(s)) }

fn jfloat(f: Float) -> Str {
  if f.is_nan() {
    return "\"NaN\""
  }
  if f.is_inf() {
    return if f > 0.0 { "\"Infinity\"" } else { "\"-Infinity\"" }
  }
  f.to_general(-1)
}

fn jvalue(v: AnyValueMsg?) -> Str {
  match v {
    None => "{}"
    Some(a) => match a.value {
      None => "{}"
      Some(AnyKind.S(x)) => "{\"stringValue\":${jstr(x)}}"
      Some(AnyKind.B(x)) => "{\"boolValue\":${x}}"
      Some(AnyKind.I(x)) => "{\"intValue\":\"${x}\"}"
      Some(AnyKind.D(x)) => "{\"doubleValue\":${jfloat(x)}}"
    }
  }
}

fn jattrs(var out: StrBuilder, kvs: List[KeyValueMsg]) {
  if kvs.is_empty() {
    return
  }
  out.write(",\"attributes\":[")
  for (i, kv) in kvs.indexed() {
    if i > 0 {
      out.write(",")
    }
    out.write("{\"key\":${jstr(kv.key)},\"value\":${jvalue(kv.value)}}")
  }
  out.write("]")
}

/// An object's fields written by `jattrs` and friends start with a comma: the object's text without it.
fn jobject(body: Str) -> Str {
  if body.is_empty() { "{}" } else { "{${body[1..]}}" }
}

fn all_zero(b: Bytes) -> Bool {
  for c in b {
    if c != 0 {
      return false
    }
  }
  true
}

/// An id as Go's otlpjson writes it: upper case hex of exactly n bytes (cut, or padded with zeros).
fn jid(b: Bytes, n: Int) -> Str {
  var h = b.to_hex().to_upper()
  while h.len() < 2 * n {
    h = h + "0"
  }
  h[0..2 * n]
}

fn jspan(var out: StrBuilder, s: SpanMsg) {
  var b = StrBuilder.new()
  b.write(",\"traceId\":\"${jid(s.trace_id, 16)}\"")
  b.write(",\"spanId\":\"${jid(s.span_id, 8)}\"")
  if !s.parent_span_id.is_empty() && !all_zero(s.parent_span_id) {
    b.write(",\"parentSpanId\":\"${jid(s.parent_span_id, 8)}\"")
  }
  if s.flags != 0 {
    b.write(",\"flags\":${s.flags}")
  }
  if !s.name.is_empty() {
    b.write(",\"name\":${jstr(s.name)}")
  }
  if s.kind != 0 {
    b.write(",\"kind\":${s.kind}")
  }
  if s.start_time_unix_nano != 0 {
    b.write(",\"startTimeUnixNano\":\"${s.start_time_unix_nano}\"")
  }
  if s.end_time_unix_nano != 0 {
    b.write(",\"endTimeUnixNano\":\"${s.end_time_unix_nano}\"")
  }
  jattrs(b, s.attributes)
  if !s.events.is_empty() {
    b.write(",\"events\":[")
    for (i, e) in s.events.indexed() {
      if i > 0 {
        b.write(",")
      }
      var eb = StrBuilder.new()
      if e.time_unix_nano != 0 {
        eb.write(",\"timeUnixNano\":\"${e.time_unix_nano}\"")
      }
      if !e.name.is_empty() {
        eb.write(",\"name\":${jstr(e.name)}")
      }
      jattrs(eb, e.attributes)
      b.write(jobject(eb.freeze()))
    }
    b.write("]")
  }
  if let Some(st) = s.status {
    var sb = StrBuilder.new()
    if !st.message.is_empty() {
      sb.write(",\"message\":${jstr(st.message)}")
    }
    if st.code != 0 {
      sb.write(",\"code\":${st.code}")
    }
    b.write(",\"status\":${jobject(sb.freeze())}")
  }
  out.write(jobject(b.freeze()))
}

fn encode_traces_json(res: otlp.Resource, spans: List[trace.Span]) -> Bytes {
  let m = traces_msg(res, spans)
  var out = StrBuilder.new()
  out.write("{\"resourceSpans\":[")
  for (i, rs) in m.resource_spans.indexed() {
    if i > 0 {
      out.write(",")
    }
    var rb = StrBuilder.new()
    if let Some(r) = rs.resource {
      var ab = StrBuilder.new()
      jattrs(ab, r.attributes)
      rb.write(",\"resource\":${jobject(ab.freeze())}")
    }
    if !rs.scope_spans.is_empty() {
      rb.write(",\"scopeSpans\":[")
      for (j, ss) in rs.scope_spans.indexed() {
        if j > 0 {
          rb.write(",")
        }
        var sb = StrBuilder.new()
        if let Some(sc) = ss.scope {
          var cb = StrBuilder.new()
          if !sc.name.is_empty() {
            cb.write(",\"name\":${jstr(sc.name)}")
          }
          if !sc.version.is_empty() {
            cb.write(",\"version\":${jstr(sc.version)}")
          }
          sb.write(",\"scope\":${jobject(cb.freeze())}")
        }
        if !ss.spans.is_empty() {
          sb.write(",\"spans\":[")
          for (k, sp) in ss.spans.indexed() {
            if k > 0 {
              sb.write(",")
            }
            jspan(sb, sp)
          }
          sb.write("]")
        }
        if !ss.schema_url.is_empty() {
          sb.write(",\"schemaUrl\":${jstr(ss.schema_url)}")
        }
        rb.write(jobject(sb.freeze()))
      }
      rb.write("]")
    }
    out.write(jobject(rb.freeze()))
  }
  out.write("]}")
  out.freeze().bytes()
}

// The metrics messages (opentelemetry-proto metrics.proto) as derive Proto
// structs: a Metric's data and a NumberDataPoint's value are oneofs.

enum NumberValue {
  AsDouble as "4"(v: Float)
} derive Proto

struct NumberPointMsg {
  start_time_unix_nano proto "2,fixed": UInt64 = 0
  time_unix_nano proto "3,fixed": UInt64 = 0
  value proto "oneof": NumberValue? = None
  attributes proto "7": List[KeyValueMsg] = []
} derive Proto

struct HistogramPointMsg {
  start_time_unix_nano proto "2,fixed": UInt64 = 0
  time_unix_nano proto "3,fixed": UInt64 = 0
  count proto "4,fixed": UInt64 = 0
  sum proto "5": Float? = None
  bucket_counts proto "6,fixed": List[UInt64] = []
  explicit_bounds proto "7": List[Float] = []
  attributes proto "9": List[KeyValueMsg] = []
} derive Proto

struct SummaryPointMsg {
  start_time_unix_nano proto "2,fixed": UInt64 = 0
  time_unix_nano proto "3,fixed": UInt64 = 0
  count proto "4,fixed": UInt64 = 0
  sum proto "5": Float = 0.0
  quantile_values proto "6": List[QuantileMsg] = []
  attributes proto "7": List[KeyValueMsg] = []
} derive Proto

struct QuantileMsg {
  quantile proto "1": Float = 0.0
  value proto "2": Float = 0.0
} derive Proto

struct GaugeMsg { data_points proto "1": List[NumberPointMsg] = [] } derive Proto

struct SumMsg {
  data_points proto "1": List[NumberPointMsg] = []
  aggregation_temporality proto "2": Int = 0
  is_monotonic proto "3": Bool = false
} derive Proto

struct HistogramMsg {
  data_points proto "1": List[HistogramPointMsg] = []
  aggregation_temporality proto "2": Int = 0
} derive Proto

struct SummaryMsg { data_points proto "1": List[SummaryPointMsg] = [] } derive Proto

enum MetricData {
  Gauge as "5"(v: GaugeMsg)
  Sum as "7"(v: SumMsg)
  Histogram as "9"(v: HistogramMsg)
  Summary as "11"(v: SummaryMsg)
} derive Proto

struct MetricMsg {
  name proto "1": Str = ""
  description proto "2": Str = ""
  data proto "oneof": MetricData? = None
} derive Proto

struct ScopeMetricsMsg {
  scope proto "1": ScopeMsg? = None
  metrics proto "2": List[MetricMsg] = []
} derive Proto

struct ResourceMetricsMsg {
  resource proto "1": ResourceMsg? = None
  scope_metrics proto "2": List[ScopeMetricsMsg] = []
} derive Proto

struct MetricsRequestMsg { resource_metrics proto "1": List[ResourceMetricsMsg] = [] } derive Proto

fn labels_msg(consts: List[(Str, Str)], labels: List[Str], values: List[Str]) -> List[KeyValueMsg] {
  var out: List[KeyValueMsg] = []
  // a wrapped registry's constant labels (metrics.Registry.wrap)
  for (k, v) in consts {
    out.push(kv_str_msg(k, v))
  }
  for (i, l) in labels.indexed() {
    out.push(kv_str_msg(l, values[i]))
  }
  out
}

fn ns(ms: Int) -> UInt64 { UInt64.wrapping_from(ms * 1000000) }

fn number_point(f: metrics.Family, values: List[Str], v: Float, start_ms: Int, now_ms: Int, with_start: Bool) -> NumberPointMsg {
  NumberPointMsg{start_time_unix_nano: if with_start { ns(start_ms) } else { 0 }, time_unix_nano: ns(now_ms), value: Some(NumberValue.AsDouble(v)), attributes: labels_msg(f.consts, f.labels, values)}
}

fn load_cell(a: Atomic[Int]) -> Float {
  Float.from_bits(a.get())
}

fn family_msg(f: metrics.Family, start_ms: Int, now_ms: Int) -> MetricMsg {
  var nums: List[NumberPointMsg] = []
  var hists: List[HistogramPointMsg] = []
  var sums: List[SummaryPointMsg] = []
  if let Some(read) = f.reads.get(0) {
    let ss = read().sort_by(fn(x: metrics.Sample) -> Str { x.values.join("\x1f") })
    for x in ss {
      // a sample's own times: created is the start, timestamp the time
      let st = match x.created {
        Some(t) => t.unix_millis()
        None => start_ms
      }
      let at = match x.timestamp {
        Some(t) => t.unix_millis()
        None => now_ms
      }
      let attrs = labels_msg(f.consts, f.labels, x.values)
      if f.kind == 2 {
        var bounds: List[Float] = []
        var counts: List[UInt64] = []
        var below = 0
        for (b, n) in x.buckets.sort_by(fn(p: (Float, Int)) -> Float { p.0 }) {
          if b != Float.inf {
            bounds.push(b)
            counts.push(UInt64.wrapping_from(n - below))
            below = n
          }
        }
        counts.push(UInt64.wrapping_from(x.count - below))
        hists.push(HistogramPointMsg{start_time_unix_nano: ns(st), time_unix_nano: ns(at), count: UInt64.wrapping_from(x.count), sum: Some(x.sum), bucket_counts: counts, explicit_bounds: bounds, attributes: attrs})
      } else if f.kind == 3 {
        let qs = x.quantiles.sort_by(fn(p: (Float, Float)) -> Float { p.0 }).map(fn(p: (Float, Float)) -> QuantileMsg { QuantileMsg{quantile: p.0, value: p.1} })
        sums.push(SummaryPointMsg{start_time_unix_nano: ns(st), time_unix_nano: ns(at), count: UInt64.wrapping_from(x.count), sum: x.sum, quantile_values: qs, attributes: attrs})
      } else {
        nums.push(number_point(f, x.values, x.value, st, at, f.kind == 0))
      }
    }
  } else {
    let sm = metrics.series_snapshot(f)
    for k in sm.keys().sort() {
      let s = sm.get(k) ?? continue
      if f.kind < 2 {
        // a counter's whole increments are in cell 1 (std/metrics counter_cells_add)
        let v = if f.kind == 0 { load_cell(s.cells[0]) + Float(s.cells[1].get()) } else { load_cell(s.cells[0]) }
        nums.push(number_point(f, s.values, v, start_ms, now_ms, f.kind == 0))
      } else if f.kind == 3 {
        sums.push(SummaryPointMsg{start_time_unix_nano: ns(start_ms), time_unix_nano: ns(now_ms), count: UInt64.wrapping_from(s.cells[1].get()), sum: load_cell(s.cells[2]), attributes: labels_msg(f.consts, f.labels, s.values)})
      } else {
        var counts: List[UInt64] = []
        var upto = 0
        for (i, _) in f.bounds.indexed() {
          let c = s.cells[3 + i].get()
          upto += c
          counts.push(UInt64.wrapping_from(c))
        }
        let n = s.cells[1].get()
        counts.push(UInt64.wrapping_from(n - upto))
        hists.push(HistogramPointMsg{start_time_unix_nano: ns(start_ms), time_unix_nano: ns(now_ms), count: UInt64.wrapping_from(n), sum: Some(load_cell(s.cells[2])), bucket_counts: counts, explicit_bounds: f.bounds, attributes: labels_msg(f.consts, f.labels, s.values)})
      }
    }
  }
  let data = if f.kind == 0 {
    MetricData.Sum(SumMsg{data_points: nums, aggregation_temporality: 2, is_monotonic: true})
  } else if f.kind == 1 || f.kind == 4 {
    // an untyped series (metrics.Registry.untyped_func) is a gauge, as
    // the collector's Prometheus receiver maps unknown types
    MetricData.Gauge(GaugeMsg{data_points: nums})
  } else if f.kind == 3 {
    MetricData.Summary(SummaryMsg{data_points: sums})
  } else {
    MetricData.Histogram(HistogramMsg{data_points: hists, aggregation_temporality: 2})
  }
  MetricMsg{name: f.name, description: f.help, data: Some(data)}
}

fn encode_metrics(res: otlp.Resource, reg: metrics.Registry, start_ms: Int, now_ms: Int) -> Bytes {
  var rattrs = [kv_str_msg("service.name", res.service)]
  for (k, v) in res.attributes {
    rattrs.push(kv_str_msg(k, v))
  }
  let fs = reg.families.with_read(fn(l: List[metrics.Family]) -> List[metrics.Family] { l })
  var ms: List[MetricMsg] = []
  for f in fs {
    ms.push(family_msg(f, start_ms, now_ms))
  }
  let sc = ScopeMetricsMsg{scope: Some(ScopeMsg{name: res.scope, version: res.version}), metrics: ms}
  protobuf.marshal(MetricsRequestMsg{resource_metrics: [ResourceMetricsMsg{resource: Some(ResourceMsg{attributes: rattrs}), scope_metrics: [sc]}]})
}

fn exporterr_display(e: otlp.ExportErr) -> Str {
  match e {
    Transport(msg) => "export: ${msg}"
    Rejected(status, body) => "export rejected: ${status} ${body}"
    GaveUp(status, tries) => "export gave up after ${tries} tries: ${status}"
    RequestTooLarge(limit) => "request body too large: exceeded ${limit} bytes"
    ResponseTooLarge(limit) => "response body too large: exceeded ${limit} bytes"
    Partial(rejected, msg, kind) => "OTLP partial success: ${if msg.is_empty() { "empty message" } else { msg }} (${rejected} ${kind} rejected)"
    Grpc(code, message, tries) => {
      let status = "rpc error: code = ${grpc.code_from(code).map(fn(c) { "${c}" }) ?? "Code(${code})"} desc = ${message}"
      if tries > 1 { "export gave up after ${tries} tries: ${status}" } else { status }
    }
  }
}

fn exporter(client: http.Client, endpoint: Str, res: otlp.Resource, clock: Clock[clock], rand: Rand[rand]) -> otlp.Exporter {
  otlp.Exporter{client: client, endpoint: endpoint.trim_suffix("/"), resource: res, headers: {}, backoff: backoff.Backoff{initial: 500ms, multiplier: 1.5, randomization: 0.5, max_interval: 60s, max_elapsed: 15m, max_tries: 5}, clock: clock, rand: rand}
}

fn grpc_exporter(client: http.Client, endpoint: Str, res: otlp.Resource, clock: Clock[clock], rand: Rand[rand]) -> otlp.Exporter {
  exporter(client, endpoint, res, clock, rand) with {protocol: otlp.Protocol.Grpc}
}

fn exporter_with_headers(e: otlp.Exporter, h: Map[Str, Str]) -> otlp.Exporter { e with {headers: h} }

fn exporter_with_backoff(e: otlp.Exporter, b: backoff.Backoff) -> otlp.Exporter { e with {backoff: b} }

fn exporter_with_encoding(e: otlp.Exporter, enc: otlp.Encoding) -> otlp.Exporter { e with {encoding: enc} }

fn exporter_with_compression(e: otlp.Exporter, c: otlp.Compression) -> otlp.Exporter { e with {compression: c} }

fn exporter_with_max_request_size(e: otlp.Exporter, n: Int) -> otlp.Exporter { e with {max_request: n} }

fn exporter_with_max_response_size(e: otlp.Exporter, n: Int) -> otlp.Exporter {
  if n <= 0 { e } else { e with {max_response: n} }
}

// The partial success of an ExportTraceServiceResponse or ExportMetricsServiceResponse (collector/*/v1): field 1
// of each is the partial success, whose field 1 is the rejected spans or data points and field 2 the message.
struct PartialMsg {
  rejected proto "1": Int = 0
  error_message proto "2": Str = ""
} derive Proto

struct ExportResponseMsg { partial_success proto "1": PartialMsg? = None } derive Proto

/// The headers and body of a request carrying `body` in `content_type`: over a positive `max_request` is
/// RequestTooLarge (the size before compression, as Go checks it), then gzipped when the exporter compresses.
fn request_body(e: otlp.Exporter, content_type: Str, body: Bytes) -> (Map[Str, Str], Bytes) ! otlp.ExportErr {
  if e.max_request > 0 && body.len() > e.max_request {
    return Err(otlp.ExportErr.RequestTooLarge(limit: e.max_request))
  }
  var headers = e.headers
  headers["Content-Type"] = content_type
  if e.compression == otlp.Compression.Gzip {
    headers["Content-Encoding"] = "gzip"
    return Ok((headers, compress.gzip(body)))
  }
  Ok((headers, body))
}

fn json_count(v: json.Value?) -> Int ! Str {
  match v {
    None => Ok(0)
    Some(json.Value.Null) => Ok(0)
    Some(json.Value.Int(n)) => Ok(n)
    Some(json.Value.Str(t)) => Int.parse(t).or_err("rejected count ${jstr(t)} is not an integer")
    Some(other) => Err("rejected count ${other.encode()} is not an integer")
  }
}

/// The partial success a 2xx answer carries, read as Go's otlptracehttp reads it: the body is decoded by its
/// exact Content-Type (protobuf or JSON), any other type is ignored; `rejected_key` is the JSON name of the
/// rejected count. A body that does not decode is Transport.
fn partial_success(resp: http.Response, rejected_key: Str, kind: Str) -> () ! otlp.ExportErr {
  if resp.body.is_empty() {
    return Ok(())
  }
  let ct = resp.header("Content-Type") ?? ""
  var rejected = 0
  var msg = ""
  if ct == "application/x-protobuf" {
    match protobuf.unmarshal[ExportResponseMsg](resp.body) {
      Ok(m) => {
        if let Some(p) = m.partial_success {
          rejected = p.rejected
          msg = p.error_message
        }
      }
      Err(err) => return Err(otlp.ExportErr.Transport(msg: "${err}"))
    }
  } else if ct == "application/json" {
    let v = match json.parse_value(resp.body.to_str() ?? "") {
      Ok(x) => x
      Err(err) => return Err(otlp.ExportErr.Transport(msg: "${err}"))
    }
    let p = v.get("partialSuccess") ?? v.get("partial_success") ?? json.Value.Null
    let n = json_count(p.get(rejected_key) ?? p.get(rejected_key.replace("Spans", "_spans").replace("DataPoints", "_data_points").replace("LogRecords", "_log_records")))
    match n {
      Ok(x) => rejected = x
      Err(m) => return Err(otlp.ExportErr.Transport(msg: m))
    }
    match p.get("errorMessage") ?? p.get("error_message") {
      Some(json.Value.Str(t)) => msg = t
      _ => {}
    }
  } else {
    return Ok(())
  }
  if rejected != 0 || !msg.is_empty() {
    return Err(otlp.ExportErr.Partial(rejected: rejected, msg: msg, kind: kind))
  }
  Ok(())
}

fn retryable(status: Int) -> Bool { status == 429 || status == 502 || status == 503 || status == 504 }

/// The seconds a Retry-After value asks for: a number of seconds, or an HTTP date (RFC 9110) counted from
/// `now`; 0 when absent, in the past or not understood.
fn retry_after(resp: http.Response, now: Time) -> Int {
  let v = (resp.header("Retry-After") ?? return 0).trim()
  match Int.parse(v) {
    Some(n) => if n > 0 { n } else { 0 }
    None => match time.RFC1123_LAYOUT.parse(v, time.utc()) {
      Ok(t) => {
        let d = t.unix() - now.unix()
        if d > 0 { d } else { 0 }
      }
      Err(_) => 0
    }
  }
}

fn post(e: otlp.Exporter, path: Str, content_type: Str, raw: Bytes, rejected_key: Str, kind: Str) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  let (headers, body) = request_body(e, content_type, raw)?
  var tries = 0
  while true {
    tries += 1
    let req = http.new_request("POST", "${e.endpoint}${path}", headers, body)
    let resp = match e.client.send(req) {
      Ok(r) => r
      Err(err) => {
        // no answer: retried as a 503 would be
        if e.backoff.max_tries != 0 && tries >= e.backoff.max_tries {
          return Err(otlp.ExportErr.Transport(msg: "${err}"))
        }
        e.clock.sleep(e.backoff.delay(tries - 1, e.rand))
        continue
      }
    }
    if e.max_response > 0 && resp.body.len() > e.max_response {
      return Err(otlp.ExportErr.ResponseTooLarge(limit: e.max_response))
    }
    if resp.status >= 200 && resp.status < 300 {
      return partial_success(resp, rejected_key, kind)
    }
    if !retryable(resp.status) {
      return Err(otlp.ExportErr.Rejected(status: resp.status, body: resp.body.to_str() ?? ""))
    }
    if e.backoff.max_tries != 0 && tries >= e.backoff.max_tries {
      return Err(otlp.ExportErr.GaveUp(status: resp.status, tries: tries))
    }
    let wait = e.backoff.delay(tries - 1, e.rand)
    let asked = Duration.from_secs_int(retry_after(resp, e.clock.now()))
    e.clock.sleep(if asked > wait { asked } else { wait })
  }
  Ok(())
}

// google.rpc.Status (the grpc-status-details-bin payload), its Any details and google.rpc.RetryInfo.
struct DurationMsg {
  seconds proto "1": Int = 0
  nanos proto "2": Int = 0
} derive Proto

struct RetryInfoMsg { retry_delay proto "1": DurationMsg? = None } derive Proto

struct AnyMsg {
  type_url proto "1": Str = ""
  value proto "2": Bytes = b""
} derive Proto

struct RpcStatusMsg {
  code proto "1": Int = 0
  message proto "2": Str = ""
  details proto "3": List[AnyMsg] = []
} derive Proto

/// The delay a status's google.rpc.RetryInfo detail asks for, None when it has none (otlptracegrpc's
/// throttleDelay); a RetryInfo with no delay is 0s.
fn throttle_delay(s: grpc.Status) -> Duration? {
  if s.details.is_empty() {
    return None
  }
  let st = match protobuf.unmarshal[RpcStatusMsg](s.details) {
    Ok(m) => m
    Err(_) => return None
  }
  for a in st.details {
    if a.type_url.ends_with("/google.rpc.RetryInfo") {
      let ri = match protobuf.unmarshal[RetryInfoMsg](a.value) {
        Ok(m) => m
        Err(_) => continue
      }
      let d = ri.retry_delay ?? DurationMsg{}
      return Some(Duration.from_secs_int(d.seconds) + Duration.from_nanos(d.nanos))
    }
  }
  None
}

/// Whether a status is retried and the delay it asks for at least (otlptracegrpc's retryableGRPCStatus).
fn grpc_retryable(s: grpc.Status) -> (Bool, Duration) {
  match s.code {
    grpc.Code.Canceled | grpc.Code.DeadlineExceeded | grpc.Code.Aborted | grpc.Code.OutOfRange | grpc.Code.Unavailable | grpc.Code.DataLoss => (true, throttle_delay(s) ?? 0s)
    grpc.Code.ResourceExhausted => match throttle_delay(s) {
      Some(d) => (true, d)
      None => (false, 0s)
    }
    _ => (false, 0s)
  }
}

/// The partial success of a gRPC Export response message.
fn grpc_partial(msg: Bytes, kind: Str) -> () ! otlp.ExportErr {
  match protobuf.unmarshal[ExportResponseMsg](msg) {
    Ok(m) => {
      if let Some(p) = m.partial_success {
        if p.rejected != 0 || !p.error_message.is_empty() {
          return Err(otlp.ExportErr.Partial(rejected: p.rejected, msg: p.error_message, kind: kind))
        }
      }
      Ok(())
    }
    Err(err) => Err(otlp.ExportErr.Transport(msg: "${err}"))
  }
}

fn grpc_call(e: otlp.Exporter, method: Str, raw: Bytes, kind: Str) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  if e.max_request > 0 && raw.len() > e.max_request {
    return Err(otlp.ExportErr.RequestTooLarge(limit: e.max_request))
  }
  var c = grpc.client(e.client, e.endpoint)
  if e.compression == otlp.Compression.Gzip {
    c = c.with_gzip()
  }
  var tries = 0
  while true {
    tries += 1
    match c.unary(method, raw, e.headers) {
      Ok(msg) => {
        if e.max_response > 0 && msg.len() > e.max_response {
          return Err(otlp.ExportErr.ResponseTooLarge(limit: e.max_response))
        }
        return grpc_partial(msg, kind)
      }
      Err(st) => {
        let (retry, asked) = grpc_retryable(st)
        if !retry || (e.backoff.max_tries != 0 && tries >= e.backoff.max_tries) {
          return Err(otlp.ExportErr.Grpc(code: st.code.number(), message: st.message, tries: tries))
        }
        let wait = e.backoff.delay(tries - 1, e.rand)
        e.clock.sleep(if asked > wait { asked } else { wait })
      }
    }
  }
  Ok(())
}

fn exporter_send_traces(e: otlp.Exporter, spans: List[trace.Span]) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  if spans.is_empty() {
    return Ok(())
  }
  if e.protocol == otlp.Protocol.Grpc {
    return grpc_call(e, "/opentelemetry.proto.collector.trace.v1.TraceService/Export", encode_traces(e.resource, spans), "spans")
  }
  if e.encoding == otlp.Encoding.Json {
    return post(e, "/v1/traces", "application/json", encode_traces_json(e.resource, spans), "rejectedSpans", "spans")
  }
  post(e, "/v1/traces", "application/x-protobuf", encode_traces(e.resource, spans), "rejectedSpans", "spans")
}

fn exporter_send_metrics(e: otlp.Exporter, reg: metrics.Registry, start_ms: Int) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  if e.protocol == otlp.Protocol.Grpc {
    return grpc_call(e, "/opentelemetry.proto.collector.metrics.v1.MetricsService/Export", encode_metrics(e.resource, reg, start_ms, e.clock.now().unix_millis()), "metric data points")
  }
  post(e, "/v1/metrics", "application/x-protobuf", encode_metrics(e.resource, reg, start_ms, e.clock.now().unix_millis()), "rejectedDataPoints", "metric data points")
}

// Logs (logs.proto, collector/logs/v1), as OpenTelemetry Go's otelslog bridge
// and otlploghttp write a log/slog record (task #184).

enum LogAnyKind {
  S as "1"(v: Str)
  B as "2"(v: Bool)
  I as "3"(v: Int)
  D as "4"(v: Float)
  Kv as "6"(v: LogKvListMsg)
} derive Proto

struct LogAnyValueMsg { value proto "oneof": LogAnyKind? = None } derive Proto

struct LogKeyValueMsg {
  key proto "1": Str = ""
  value proto "2": LogAnyValueMsg? = None
} derive Proto

struct LogKvListMsg { values proto "1": List[LogKeyValueMsg] = [] } derive Proto

struct LogRecordMsg {
  time_unix_nano proto "1,fixed": UInt64 = UInt64.from_bits(0)
  severity_number proto "2": Int = 0
  severity_text proto "3": Str = ""
  body proto "5": LogAnyValueMsg? = None
  attributes proto "6": List[LogKeyValueMsg] = []
  observed_time_unix_nano proto "11,fixed": UInt64 = UInt64.from_bits(0)
} derive Proto

struct ScopeLogsMsg {
  scope proto "1": ScopeMsg? = None
  log_records proto "2": List[LogRecordMsg] = []
  schema_url proto "3": Str = ""
} derive Proto

struct ResourceLogsMsg {
  resource proto "1": ResourceMsg? = None
  scope_logs proto "2": List[ScopeLogsMsg] = []
} derive Proto

struct LogsRequestMsg { resource_logs proto "1": List[ResourceLogsMsg] = [] } derive Proto

/// A log value as otelslog converts a log/slog value: a UInt past Int's
/// range becomes a double, a duration its nanoseconds, a time its Unix
/// nanoseconds, a group a key-value list.
fn log_any(v: log.Value) -> LogAnyValueMsg {
  let k = match v {
    log.Value.Str(s) => LogAnyKind.S(s)
    log.Value.Int(n) => LogAnyKind.I(n)
    log.Value.UInt(n) => {
      let b = n.to_bits()
      if b >= 0 { LogAnyKind.I(b) } else { LogAnyKind.D(Float(n)) }
    }
    log.Value.Float(f) => LogAnyKind.D(f)
    log.Value.Bool(x) => LogAnyKind.B(x)
    log.Value.Time(t) => LogAnyKind.I(t.unix_nanos())
    log.Value.Dur(d) => LogAnyKind.I(d.nanos())
    log.Value.Any(text) => LogAnyKind.S(text)
    log.Value.Group(fields) => LogAnyKind.Kv(LogKvListMsg{values: log_kvs(fields)})
  }
  LogAnyValueMsg{value: Some(k)}
}

/// The attributes of fields in their order; a group with an empty key is
/// inlined, as otelslog does.
fn log_kvs(fields: Map[Str, log.Value]) -> List[LogKeyValueMsg] {
  var out: List[LogKeyValueMsg] = []
  for (k, v) in fields {
    match v {
      log.Value.Group(g) if k.is_empty() => {
        for kv in log_kvs(g) {
          out.push(kv)
        }
      }
      _ => out.push(LogKeyValueMsg{key: k, value: Some(log_any(v))})
    }
  }
  out
}

fn log_severity(l: log.Level) -> (Int, Str) {
  match l {
    log.Level.Debug => (5, "DEBUG")
    log.Level.Info => (9, "INFO")
    log.Level.Warn => (13, "WARN")
    log.Level.Error => (17, "ERROR")
  }
}

fn log_record_msg(r: log.Record) -> LogRecordMsg {
  var attrs: List[LogKeyValueMsg] = []
  if r.values.is_empty() {
    for (k, v) in r.fields {
      attrs.push(LogKeyValueMsg{key: k, value: Some(LogAnyValueMsg{value: Some(LogAnyKind.S(v))})})
    }
  } else {
    attrs = log_kvs(r.values)
  }
  let (sev, text) = log_severity(r.level)
  let ts = UInt64.wrapping_from(r.time.unix_nanos())
  LogRecordMsg{time_unix_nano: ts, severity_number: sev, severity_text: text,
    body: Some(LogAnyValueMsg{value: Some(LogAnyKind.S(r.msg))}), attributes: attrs, observed_time_unix_nano: ts}
}

fn logs_msg(res: otlp.Resource, records: List[log.Record]) -> LogsRequestMsg {
  var rattrs = [kv_str_msg("service.name", res.service)]
  for (k, v) in res.attributes {
    rattrs.push(kv_str_msg(k, v))
  }
  // ScopeLogs groups in order of first appearance: the main module's
  // records under the Resource's scope, another module's under its path
  // and version.
  var groups: List[ScopeLogsMsg] = []
  for r in records {
    var n = res.scope
    var v = res.version
    if !r.module.is_empty() {
      match r.module.find("@") {
        Some(i) => {
          n = r.module[0..i]
          v = r.module[i + 1..r.module.len()]
        }
        None => {
          n = r.module
          v = ""
        }
      }
    }
    var at = -1
    for (i, g) in groups.indexed() {
      if at < 0 {
        let (gn, gv) = match g.scope {
          Some(sc) => (sc.name, sc.version)
          None => ("", "")
        }
        if gn == n && gv == v {
          at = i
        }
      }
    }
    if at < 0 {
      groups.push(ScopeLogsMsg{scope: if n.is_empty() && v.is_empty() { None } else { Some(ScopeMsg{name: n, version: v}) }})
      at = groups.len() - 1
    }
    groups[at].log_records.push(log_record_msg(r))
  }
  LogsRequestMsg{resource_logs: [ResourceLogsMsg{resource: Some(ResourceMsg{attributes: rattrs}), scope_logs: groups}]}
}

fn encode_logs(res: otlp.Resource, records: List[log.Record]) -> Bytes {
  protobuf.marshal(logs_msg(res, records))
}

fn exporter_send_logs(e: otlp.Exporter, records: List[log.Record]) -> () ! otlp.ExportErr uses net.dial, clock, rand {
  if records.is_empty() {
    return Ok(())
  }
  if e.protocol == otlp.Protocol.Grpc {
    return grpc_call(e, "/opentelemetry.proto.collector.logs.v1.LogsService/Export", encode_logs(e.resource, records), "logs")
  }
  post(e, "/v1/logs", "application/x-protobuf", encode_logs(e.resource, records), "rejectedLogRecords", "logs")
}
