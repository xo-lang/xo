use std/sql
use std/sqlite

test "config reads mattn's keys" {
  let c = sqlite.config("file:app.db?_busy_timeout=250&_journal_mode=wal&_fk=1&cache=shared")?
  expect(c.path) == "app.db"
  expect(c.uri) == true
  expect(c.keys) == ["cache=shared"]
  expect(c.busy_ms) == 250
  expect(c.pragmas) == ["PRAGMA journal_mode = WAL", "PRAGMA foreign_keys = ON"]
}

test "config reads mattn's other pragma keys and _txlock" {
  let c = sqlite.config("file:a.db?_txlock=immediate&_vacuum=incremental&_cache_size=-2000&_cslike=1&_defer_fk=yes&_ignore_check_constraints=0&_locking=exclusive&_query_only=on&_rt=1&_secure_delete=fast&_writable_schema=false")?
  expect(c.begin) == "BEGIN IMMEDIATE"
  expect(c.pragmas) == ["PRAGMA auto_vacuum = 2", "PRAGMA cache_size = -2000", "PRAGMA case_sensitive_like = ON", "PRAGMA defer_foreign_keys = ON", "PRAGMA ignore_check_constraints = OFF", "PRAGMA locking_mode = EXCLUSIVE", "PRAGMA query_only = ON", "PRAGMA recursive_triggers = ON", "PRAGMA secure_delete = FAST", "PRAGMA writable_schema = OFF"]
  expect(sqlite.config(":memory:")?.begin) == "BEGIN"
  expect(sqlite.config("file:a.db?_loc=auto")?.pragmas) == []
  match sqlite.config("file:a.db?_txlock=later") {
    Err(Param(msg)) => expect(msg) == "sqlite: _txlock: \"later\" is not deferred, immediate or exclusive"
    _ => expect(false) == true
  }
}

test "_txlock=exclusive begins transactions with BEGIN EXCLUSIVE, and the pragma keys take effect" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), "file:x?mode=memory&_txlock=exclusive&_rt=1&_cslike=1", max_open: 1)?
  let rows = db.query("PRAGMA recursive_triggers", [])?
  expect(rows[0].int("recursive_triggers")?) == 1
  let like = db.query("SELECT 'a' LIKE 'A' AS m", [])?
  expect(like[0].int("m")?) == 0
  db.exec("CREATE TABLE t (n INTEGER)", [])?
  let tx = db.begin()?
  tx.exec("INSERT INTO t (n) VALUES (1)", [])?
  tx.commit()?
  expect(db.query("SELECT n FROM t", [])?.len()) == 1
}

test "Row.time reads SQLite's date and time text and a DATETIME column's Unix integer, as mattn does" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), ":memory:", max_open: 1)?
  db.exec("CREATE TABLE t (a TEXT, b DATETIME, c INTEGER)", [])?
  db.exec("INSERT INTO t VALUES ('2026-11-16 12:34:56', 1763296496, 1763296496)", [])?
  db.exec("INSERT INTO t VALUES ('2026-11-16T12:34:56.5+02:00', 1763296496000, 0)", [])?
  db.exec("INSERT INTO t VALUES ('2026-11-16 12:34', NULL, 0)", [])?
  let rows = db.query("SELECT a, b, c FROM t ORDER BY rowid", [])?
  expect(rows[0].time("a")?.format_rfc3339()) == "2026-11-16T12:34:56Z"
  expect(rows[0].time("b")?.format_rfc3339()) == "2025-11-16T12:34:56Z"
  expect(rows[1].time("a")?.format_rfc3339()) == "2026-11-16T10:34:56.5Z"
  expect(rows[1].time("b")?.format_rfc3339()) == "2025-11-16T12:34:56Z"
  expect(rows[2].time("a")?.format_rfc3339()) == "2026-11-16T12:34:00Z"
  expect(rows[2].time_opt("b")?) == None
  // an INTEGER column is not a time: mattn reads it as int64
  expect(rows[0].time("c").is_err()) == true
  let now = db.query("SELECT datetime('now') AS n", [])?
  expect(now[0].time("n").is_ok()) == true
}

test "config refuses an unknown driver key" {
  match sqlite.config("file:a.db?_bogus=1") {
    Err(Param(msg)) => expect(msg) == "sqlite: unknown key \"_bogus\""
    _ => expect(false) == true
  }
}

test "a memory database runs statements, binds and maps errors" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), ":memory:", max_open: 1)?
  db.exec("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, score REAL, data BLOB)", [])?
  let r = db.exec("INSERT INTO t (name, score, data) VALUES ($1, $2, $3)", [sql.str("ada"), sql.float(1.5), sql.bytes(b"\x00\x01\xff")])?
  expect(r.rows_affected) == 1
  expect(r.last_insert_id) == 1
  db.exec("INSERT INTO t (name) VALUES (?)", [sql.str("bob")])?
  let rows = db.query("SELECT id, name, score, data FROM t WHERE id >= $1 ORDER BY id", [sql.int(1)])?
  expect(rows.len()) == 2
  expect(rows[0].str("name")?) == "ada"
  expect(rows[0].float("score")?) == 1.5
  expect(rows[0].bytes("data")?) == b"\x00\x01\xff"
  expect(rows[1].float_opt("score")?) == None
  match db.exec("INSERT INTO t (name) VALUES ($1)", [sql.str("ada")]) {
    Err(Constraint(_, code, _)) => expect(code) == "23505"
    _ => expect(false) == true
  }
  match db.query("SELECT * FROM missing", []) {
    Err(NoTable(name)) => expect(name) == "missing"
    _ => expect(false) == true
  }
}

test "Server errors name the extended result code as sqlite3.h does" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), ":memory:", max_open: 1)?
  db.exec("CREATE TABLE t (n INTEGER)", [])?
  db.exec("CREATE TRIGGER no_neg BEFORE INSERT ON t WHEN NEW.n < 0 BEGIN SELECT RAISE(ABORT, 'negative'); END", [])?
  match db.exec("INSERT INTO t (n) VALUES ($1)", [sql.int(-1)]) {
    Err(Server(code, msg)) => {
      expect(code) == "SQLITE_CONSTRAINT_TRIGGER"
      expect(msg) == "negative"
    }
    _ => expect(false) == true
  }
}

test "a transaction commits and rolls back" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), ":memory:", max_open: 1)?
  db.exec("CREATE TABLE t (n INTEGER)", [])?
  let tx = db.begin()?
  tx.exec("INSERT INTO t VALUES (1)", [])?
  tx.rollback()?
  let tx2 = db.begin()?
  tx2.exec("INSERT INTO t VALUES (2)", [])?
  tx2.commit()?
  let rows = db.query("SELECT n FROM t", [])?
  expect(rows.len()) == 1
  expect(rows[0].int("n")?) == 2
}

test "column_types are the declared types upper cased, as mattn's ColumnTypeDatabaseTypeName (decision 0609)" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), ":memory:", max_open: 1)?
  db.exec("CREATE TABLE t (id integer PRIMARY KEY, name varchar(10), x)", [])?
  let rows = db.rows("SELECT id, name, x, id + 1 AS y FROM t", [])?
  expect(rows.column_types().map(fn(t) { "${t.name}:${t.database_type}" })) == ["id:INTEGER", "name:VARCHAR(10)", "x:", "y:"]
  rows.close()
}
test "batch and pipeline (decision 0648 item 15): each batch in BEGIN and COMMIT, rolled back at its first error, and inside a transaction without one" {
  let db = sql.open_driver(os.net, sqlite.driver(os.fs), ":memory:", max_open: 1)?
  db.exec("CREATE TABLE t (n INTEGER NOT NULL UNIQUE)", [])?
  let sets = db.batch([
    sql.BatchQuery{query: "INSERT INTO t (n) VALUES ($1)", args: [sql.int(1)]},
    sql.BatchQuery{query: "INSERT INTO t (n) VALUES (2), (3)"},
    sql.BatchQuery{query: "SELECT n FROM t ORDER BY n"},
    sql.BatchQuery{query: "UPDATE t SET n = n + 10 WHERE n > 1"},
  ])?
  expect(sets.map(fn(s) { s.rows_affected() })) == [1, 2, 3, 2]
  expect(sets[2].rows().map(fn(r) { r.int("n").or_fault("n") })) == [1, 2, 3]
  let outs = db.pipeline([
    [sql.BatchQuery{query: "INSERT INTO t (n) VALUES (4)"}, sql.BatchQuery{query: "INSERT INTO t (n) VALUES (1)"}],
    [sql.BatchQuery{query: "INSERT INTO t (n) VALUES (5)"}],
  ])?
  match outs[0] {
    Err(Constraint(_, code, _)) => expect(code) == "23505"
    _ => expect(false) == true
  }
  expect(outs[1].is_ok()) == true
  expect(db.query("SELECT n FROM t ORDER BY n", [])?.map(fn(r) { r.int("n").or_fault("n") })) == [1, 5, 12, 13]
  let tx = db.begin()?
  tx.batch([sql.BatchQuery{query: "DELETE FROM t WHERE n = 5"}])?
  tx.rollback()?
  expect(db.query("SELECT n FROM t", [])?.len()) == 4
}
