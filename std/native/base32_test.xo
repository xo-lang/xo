test "base32 round trip" for data: Bytes {
  expect(decode(encode(data, base32.Base32.Std), base32.Base32.Std)) == Ok(data)
  expect(decode(encode(data, base32.Base32.Hex), base32.Base32.Hex)) == Ok(data)
  expect(decode(encode(data, base32.Base32.RawStd), base32.Base32.RawStd)) == Ok(data)
  expect(decode(encode(data, base32.Base32.RawHex), base32.Base32.RawHex)) == Ok(data)
}
