// std/protojson on the native backends (decision 0546): protobuf-go's
// encoding/protojson over descriptors. A message is read off its wire bytes
// with std/native/protodesc's field walker and written as JSON text.
use std/protojson
use std/protodesc
use std/protobuf
use std/protowkt
use std/base64
use std/json
use native/protodesc as pd

struct MsgInfo {
  d: protodesc.MessageDesc
  full: Str
  proto3: Bool
  is_map: Bool
}

struct Registry {
  msgs: Map[Str, MsgInfo]
  enums: Map[Str, protodesc.EnumDesc]
}

fn jerr(text: Str) -> protojson.JsonErr { protojson.JsonErr{text: text} }

fn jsonerr_display(e: protojson.JsonErr) -> Str { e.text }

fn registry(files: List[protodesc.FileDesc]) -> Registry {
  var r = Registry{msgs: {}, enums: {}}
  for f in files {
    let p3 = f.syntax == "proto3"
    let pre = if f.package.is_empty() { "" } else { f.package + "." }
    for e in f.enum_type {
      r.enums.put(pre + e.name, e)
    }
    for m in f.message_type {
      add_msg(r, m, pre, p3)
    }
  }
  r
}

fn add_msg(var r: Registry, m: protodesc.MessageDesc, pre: Str, p3: Bool) {
  let full = pre + m.name
  var is_map = false
  if !m.options.is_empty() {
    for f in pd.walk(m.options) ?? [] {
      if f.num == 7 && f.wire == 0 && f.v != 0 {
        is_map = true
      }
    }
  }
  r.msgs.put(full, MsgInfo{d: m, full: full, proto3: p3, is_map: is_map})
  for e in m.enum_type {
    r.enums.put(full + "." + e.name, e)
  }
  for n in m.nested_type {
    add_msg(r, n, full + ".", p3)
  }
}

fn registry_from_set(set: Bytes) -> Registry ! protobuf.ProtoErr {
  var files: List[protodesc.FileDesc] = []
  for f in pd.walk(set)? {
    if f.num == 1 && f.wire == 2 {
      files.push(protodesc.decode(f.data)?)
    }
  }
  Ok(registry(files))
}

fn walk_(b: Bytes) -> List[pd.Fld] ! protojson.JsonErr {
  match pd.walk(b) {
    Ok(l) => Ok(l)
    Err(e) => Err(jerr("proto: ${e.display()}"))
  }
}

// ---- text helpers ---------------------------------------------------------

/// protojson's string: `"`, `\` and controls below 0x20 escaped (the short forms for \b \f \n \r \t, \u00XX
/// otherwise); everything else as is. The text is valid UTF-8 by construction.
fn jstr(s: Str) -> Str {
  var o = BytesBuilder.with_capacity(s.len() + 2)
  o.write_byte(34)
  let hex = "0123456789abcdef".bytes()
  for c in s.bytes() {
    if c == 34 || c == 92 {
      o.write_byte(92)
      o.write_byte(c)
    } else if c == 8 {
      o.write_str("\\b")
    } else if c == 12 {
      o.write_str("\\f")
    } else if c == 10 {
      o.write_str("\\n")
    } else if c == 13 {
      o.write_str("\\r")
    } else if c == 9 {
      o.write_str("\\t")
    } else if c < 32 {
      o.write_str("\\u00")
      o.write_byte(hex[Int(c) / 16])
      o.write_byte(hex[Int(c) % 16])
    } else {
      o.write_byte(c)
    }
  }
  o.write_byte(34)
  o.freeze().to_str_lossy()
}

fn ustr(v: Int) -> Str {
  if v >= 0 { "${v}" } else { "${UInt64.from_bits(v)}" }
}

fn i32(v: Int) -> Int {
  let x = v & 0xFFFFFFFF
  if x >= 0x80000000 { x - 0x100000000 } else { x }
}

fn dbl_text(x: Float) -> Str {
  if x != x {
    "\"NaN\""
  } else if x > 1.7976931348623157e308 {
    "\"Infinity\""
  } else if x < -1.7976931348623157e308 {
    "\"-Infinity\""
  } else {
    json.encode_str(x)
  }
}

fn flt_text(x: Float32) -> Str {
  let d = Float(x)
  if d != d {
    "\"NaN\""
  } else if d > 1.7976931348623157e308 {
    "\"Infinity\""
  } else if d < -1.7976931348623157e308 {
    "\"-Infinity\""
  } else {
    json.encode_str(x)
  }
}

fn json_name(fd: protodesc.FieldDesc) -> Str {
  if !fd.json_name.is_empty() {
    return fd.json_name
  }
  camel(fd.name)
}

/// strs.JSONCamelCase.
fn camel(s: Str) -> Str {
  var o = BytesBuilder.with_capacity(s.len())
  var was = false
  for c in s.bytes() {
    if c != 95 {
      if was && c >= 97 && c <= 122 {
        o.write_byte(c - 32)
      } else {
        o.write_byte(c)
      }
    }
    was = c == 95
  }
  o.freeze().to_str_lossy()
}

/// strs.JSONSnakeCase.
fn snake(s: Str) -> Str {
  var o = BytesBuilder.with_capacity(s.len() + 4)
  for c in s.bytes() {
    if c >= 65 && c <= 90 {
      o.write_byte(95)
      o.write_byte(c + 32)
    } else {
      o.write_byte(c)
    }
  }
  o.freeze().to_str_lossy()
}

/// protoreflect.FullName.IsValid: identifiers separated by dots.
fn valid_full_name(s: Str) -> Bool {
  if s.is_empty() {
    return false
  }
  var start = true
  for c in s.bytes() {
    if c == 46 {
      if start {
        return false
      }
      start = true
    } else {
      let letter = c == 95 || (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
      if start {
        if !letter {
          return false
        }
      } else if !(letter || (c >= 48 && c <= 57)) {
        return false
      }
      start = false
    }
  }
  !start
}

// ---- marshal --------------------------------------------------------------

fn marshal(r: Registry, name: Str, wire: Bytes, o: protojson.Opts) -> Str ! protojson.JsonErr {
  match r.msgs.get(name) {
    Some(info) => msg_json(r, info, wire, o, "")
    None => Err(jerr("unknown message ${name}"))
  }
}

fn lookup(r: Registry, type_name: Str) -> MsgInfo ! protojson.JsonErr {
  let n = if type_name.starts_with(".") { type_name[1..type_name.len()] } else { type_name }
  match r.msgs.get(n) {
    Some(i) => Ok(i)
    None => Err(jerr("unknown message ${n}"))
  }
}

/// The JSON of a message; `first` is a member written before the fields (Any's @type).
fn msg_json(r: Registry, info: MsgInfo, wire: Bytes, o: protojson.Opts, first: Str) -> Str ! protojson.JsonErr {
  if first.is_empty() {
    match wkt_json(r, info, wire, o)? {
      Some(t) => return Ok(t)
      None => {}
    }
  }
  let fl = walk_(wire)?
  // the member of each oneof that was set last on the wire wins
  var win: Map[Int, Int] = {}
  for f in fl {
    for fd in info.d.field {
      if fd.number == f.num {
        match fd.oneof_index {
          Some(k) => {
            if !fd.proto3_optional {
              win.put(k, f.num)
            }
          }
          None => {}
        }
      }
    }
  }
  var parts: List[Str] = []
  if !first.is_empty() {
    parts.push(first)
  }
  for fd in info.d.field {
    var real_oneof = false
    match fd.oneof_index {
      Some(k) => {
        if !fd.proto3_optional {
          real_oneof = true
          if (win.get(k) ?? -1) != fd.number {
            continue
          }
        }
      }
      None => {}
    }
    match field_text(r, info, fd, fl, o, real_oneof)? {
      Some(t) => {
        let nm = if o.proto_names { fd.name } else { json_name(fd) }
        parts.push(jstr(nm) + ":" + t)
      }
      None => {}
    }
  }
  Ok("{" + parts.join(",") + "}")
}

fn is_numeric_kind(k: Int) -> Bool { k != 9 && k != 10 && k != 11 && k != 12 }

/// The wire type a field of kind k is written with (not packed).
fn wire_of(k: Int) -> Int {
  if k == 1 || k == 6 || k == 16 {
    1
  } else if k == 2 || k == 7 || k == 15 {
    5
  } else if k == 9 || k == 11 || k == 12 || k == 10 {
    2
  } else {
    0
  }
}

fn field_text(r: Registry, info: MsgInfo, fd: protodesc.FieldDesc, fl: List[pd.Fld], o: protojson.Opts, real_oneof: Bool) -> Str? ! protojson.JsonErr {
  var occ: List[pd.Fld] = []
  for f in fl {
    if f.num == fd.number {
      occ.push(f)
    }
  }
  if fd.label == protodesc.LABEL_REPEATED {
    var is_map = false
    var entry = info
    if fd.kind == protodesc.TYPE_MESSAGE {
      entry = lookup(r, fd.type_name)?
      is_map = entry.is_map
    }
    if is_map {
      if occ.is_empty() {
        return Ok(if o.emit_defaults { Some("{}") } else { None })
      }
      return Ok(Some(map_text(r, entry, occ, o)?))
    }
    var items: List[Str] = []
    for f in occ {
      if f.wire == 2 && is_numeric_kind(fd.kind) {
        // a packed run
        var at = 0
        let b = f.data
        while at < b.len() {
          let k = fd.kind
          let w = wire_of(k)
          var v = 0
          if w == 0 {
            let (x, n2) = pd_varint(b, at)?
            v = x
            at = n2
          } else if w == 1 {
            let (x, n2) = pd_fixed64(b, at)?
            v = x
            at = n2
          } else {
            let (x, n2) = pd_fixed32(b, at)?
            v = x
            at = n2
          }
          items.push(scalar_text(r, fd, pd.Fld{num: f.num, wire: w, v: v, data: b"", raw: b""}, o)?)
        }
      } else if f.wire == wire_of(fd.kind) {
        items.push(single_text(r, fd, f.data, f, o)?)
      }
    }
    if items.is_empty() {
      return Ok(if o.emit_defaults { Some("[]") } else { None })
    }
    return Ok(Some("[" + items.join(",") + "]"))
  }
  // a singular field: the last value (messages merge)
  var last: List[pd.Fld] = []
  for f in occ {
    if f.wire == wire_of(fd.kind) {
      last.push(f)
    }
  }
  let implicit = info.proto3 && fd.kind != protodesc.TYPE_MESSAGE && fd.kind != protodesc.TYPE_GROUP && !real_oneof && !fd.proto3_optional
  if last.is_empty() {
    if o.emit_defaults && implicit {
      return Ok(Some(default_text(r, fd, o)))
    }
    return Ok(None)
  }
  var data = b""
  var pick = last[last.len() - 1]
  if fd.kind == protodesc.TYPE_MESSAGE {
    for f in last {
      data = pd.cat(data, f.data)
    }
  }
  if implicit && is_zero(fd, pick) {
    if o.emit_defaults {
      return Ok(Some(default_text(r, fd, o)))
    }
    return Ok(None)
  }
  Ok(Some(single_text(r, fd, data, pick, o)?))
}

fn pd_varint(b: Bytes, at: Int) -> (Int, Int) ! protojson.JsonErr {
  match protobuf.read_varint(b, at) {
    Ok((v, n)) => Ok((v.to_bits(), n))
    Err(e) => Err(jerr("proto: ${e.display()}"))
  }
}

fn pd_fixed64(b: Bytes, at: Int) -> (Int, Int) ! protojson.JsonErr {
  match protobuf.read_fixed64(b, at) {
    Ok((v, n)) => Ok((v.to_bits(), n))
    Err(e) => Err(jerr("proto: ${e.display()}"))
  }
}

fn pd_fixed32(b: Bytes, at: Int) -> (Int, Int) ! protojson.JsonErr {
  match protobuf.read_fixed32(b, at) {
    Ok((v, n)) => Ok((Int(v), n))
    Err(e) => Err(jerr("proto: ${e.display()}"))
  }
}

/// Whether the value of a field with implicit presence is its zero value (and so not populated).
fn is_zero(fd: protodesc.FieldDesc, f: pd.Fld) -> Bool {
  let k = fd.kind
  if k == protodesc.TYPE_STRING || k == protodesc.TYPE_BYTES {
    f.data.is_empty()
  } else if k == protodesc.TYPE_INT32 || k == protodesc.TYPE_UINT32 || k == protodesc.TYPE_SINT32 || k == protodesc.TYPE_ENUM {
    (f.v & 0xFFFFFFFF) == 0
  } else {
    f.v == 0
  }
}

fn default_text(r: Registry, fd: protodesc.FieldDesc, o: protojson.Opts) -> Str {
  let k = fd.kind
  if k == protodesc.TYPE_STRING || k == protodesc.TYPE_BYTES {
    "\"\""
  } else if k == protodesc.TYPE_BOOL {
    "false"
  } else if k == protodesc.TYPE_INT64 || k == protodesc.TYPE_UINT64 || k == protodesc.TYPE_FIXED64 || k == protodesc.TYPE_SFIXED64 || k == protodesc.TYPE_SINT64 {
    "\"0\""
  } else if k == protodesc.TYPE_ENUM {
    enum_text(r, fd, 0, o)
  } else {
    "0"
  }
}

fn single_text(r: Registry, fd: protodesc.FieldDesc, data: Bytes, f: pd.Fld, o: protojson.Opts) -> Str ! protojson.JsonErr {
  if fd.kind == protodesc.TYPE_MESSAGE {
    let info = lookup(r, fd.type_name)?
    return msg_json(r, info, data, o, "")
  }
  scalar_text(r, fd, f, o)
}

fn scalar_text(r: Registry, fd: protodesc.FieldDesc, f: pd.Fld, o: protojson.Opts) -> Str ! protojson.JsonErr {
  let k = fd.kind
  if k == protodesc.TYPE_DOUBLE {
    Ok(dbl_text(Float.from_bits(f.v)))
  } else if k == protodesc.TYPE_FLOAT {
    Ok(flt_text(Float32.from_bits(UInt32.wrapping_from(f.v))))
  } else if k == protodesc.TYPE_INT64 || k == protodesc.TYPE_SFIXED64 {
    Ok("\"${f.v}\"")
  } else if k == protodesc.TYPE_UINT64 || k == protodesc.TYPE_FIXED64 {
    Ok("\"${ustr(f.v)}\"")
  } else if k == protodesc.TYPE_INT32 || k == protodesc.TYPE_SFIXED32 {
    Ok("${i32(f.v)}")
  } else if k == protodesc.TYPE_UINT32 || k == protodesc.TYPE_FIXED32 {
    Ok("${f.v & 0xFFFFFFFF}")
  } else if k == protodesc.TYPE_SINT32 {
    let u = f.v & 0xFFFFFFFF
    Ok("${i32(u.shr_logical(1) ^ (0 - (u & 1)))}")
  } else if k == protodesc.TYPE_SINT64 {
    Ok("\"${f.v.shr_logical(1) ^ (0 - (f.v & 1))}\"")
  } else if k == protodesc.TYPE_BOOL {
    Ok(if f.v != 0 { "true" } else { "false" })
  } else if k == protodesc.TYPE_STRING {
    match f.data.to_str() {
      Some(s) => Ok(jstr(s))
      None => Err(jerr("field ${fd.name}: contains invalid UTF-8"))
    }
  } else if k == protodesc.TYPE_BYTES {
    Ok("\"" + base64.encode(f.data) + "\"")
  } else if k == protodesc.TYPE_ENUM {
    Ok(enum_text(r, fd, i32(f.v), o))
  } else {
    Err(jerr("field ${fd.name}: unsupported kind ${k}"))
  }
}

fn enum_text(r: Registry, fd: protodesc.FieldDesc, n: Int, o: protojson.Opts) -> Str {
  let tn = if fd.type_name.starts_with(".") { fd.type_name[1..fd.type_name.len()] } else { fd.type_name }
  if tn == "google.protobuf.NullValue" {
    return "null"
  }
  if o.enum_numbers {
    return "${n}"
  }
  match r.enums.get(tn) {
    Some(e) => {
      for v in e.value {
        if v.number == n {
          return jstr(v.name)
        }
      }
    }
    None => {}
  }
  "${n}"
}

/// A map field: the entries of its occurrences, the last of a key winning, in key order.
fn map_text(r: Registry, entry: MsgInfo, occ: List[pd.Fld], o: protojson.Opts) -> Str ! protojson.JsonErr {
  var kfd = entry.d.field[0]
  var vfd = entry.d.field[1]
  for f in entry.d.field {
    if f.number == 1 {
      kfd = f
    } else if f.number == 2 {
      vfd = f
    }
  }
  // (sort key: a string for string keys, a fixed width text for numbers; the JSON name; the JSON value)
  var rows: Map[Str, (Str, Str)] = {}
  for e in occ {
    if e.wire != 2 {
      continue
    }
    var kf = pd.Fld{num: 1, wire: wire_of(kfd.kind), v: 0, data: b"", raw: b""}
    var vf = pd.Fld{num: 2, wire: wire_of(vfd.kind), v: 0, data: b"", raw: b""}
    var vdata = b""
    for g in walk_(e.data)? {
      if g.num == 1 && g.wire == wire_of(kfd.kind) {
        kf = g
      } else if g.num == 2 && g.wire == wire_of(vfd.kind) {
        vf = g
        if vfd.kind == protodesc.TYPE_MESSAGE {
          vdata = pd.cat(vdata, g.data)
        }
      }
    }
    let kt = key_text(kfd, kf)
    let vt = if vfd.kind == protodesc.TYPE_MESSAGE { single_text(r, vfd, vdata, vf, o)? } else { scalar_text(r, vfd, vf, o)? }
    rows.put(kt.0, (kt.1, vt))
  }
  let keys = rows.keys().sort_by(fn(k: Str) -> Str { k })
  var parts: List[Str] = []
  for k in keys {
    let (name, val) = rows.get(k) ?? ("", "")
    parts.push(jstr(name) + ":" + val)
  }
  Ok("{" + parts.join(",") + "}")
}

/// A map key's sort key and its JSON name: integers sort numerically (16 hex digits of the value, a signed
/// one with its sign bit flipped), bool false before true, strings bytewise.
fn key_text(kfd: protodesc.FieldDesc, f: pd.Fld) -> (Str, Str) {
  let k = kfd.kind
  if k == protodesc.TYPE_STRING {
    let s = f.data.to_str_lossy()
    return (s, s)
  }
  if k == protodesc.TYPE_BOOL {
    let s = if f.v != 0 { "true" } else { "false" }
    return (if f.v != 0 { "1" } else { "0" }, s)
  }
  let sb = -9223372036854775807 - 1
  if k == protodesc.TYPE_INT32 || k == protodesc.TYPE_SINT32 || k == protodesc.TYPE_SFIXED32 {
    var n = i32(f.v)
    if k == protodesc.TYPE_SINT32 {
      let u = f.v & 0xFFFFFFFF
      n = i32(u.shr_logical(1) ^ (0 - (u & 1)))
    }
    return (hex16(n ^ sb), "${n}")
  }
  if k == protodesc.TYPE_INT64 || k == protodesc.TYPE_SFIXED64 {
    return (hex16(f.v ^ sb), "${f.v}")
  }
  if k == protodesc.TYPE_SINT64 {
    let n = f.v.shr_logical(1) ^ (0 - (f.v & 1))
    return (hex16(n ^ sb), "${n}")
  }
  if k == protodesc.TYPE_UINT32 || k == protodesc.TYPE_FIXED32 {
    let n = f.v & 0xFFFFFFFF
    return (hex16(n), "${n}")
  }
  // uint64 and fixed64: the unsigned order is the order of the bits
  (hex16(f.v), ustr(f.v))
}

fn hex16(x: Int) -> Str {
  let digits = "0123456789abcdef".bytes()
  var o = BytesBuilder.with_capacity(16)
  var i = 15
  while i >= 0 {
    o.write_byte(digits[(x.shr_logical(4 * i)) & 15])
    i -= 1
  }
  o.freeze().to_str_lossy()
}

// ---- the well known types ---------------------------------------------------

fn pick_field(info: MsgInfo, num: Int) -> protodesc.FieldDesc {
  for f in info.d.field {
    if f.number == num {
      return f
    }
  }
  info.d.field[0]
}

fn last_of(fl: List[pd.Fld], num: Int, wire: Int) -> pd.Fld? {
  var out: pd.Fld? = None
  for f in fl {
    if f.num == num && f.wire == wire {
      out = Some(f)
    }
  }
  out
}

fn civil(secs: Int) -> (Int, Int, Int, Int, Int, Int) {
  // days since 1970-01-01 and the second of the day (floor division)
  var days = secs / 86400
  var rem = secs % 86400
  if rem < 0 {
    rem += 86400
    days -= 1
  }
  // Howard Hinnant's civil_from_days
  let z = days + 719468
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  var y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  if m <= 2 {
    y += 1
  }
  (y, m, d, rem / 3600, (rem % 3600) / 60, rem % 60)
}

fn pad(n: Int, w: Int) -> Str {
  var s = "${n}"
  while s.len() < w {
    s = "0" + s
  }
  s
}

/// "0.5", "1.5": the fraction of nanos with trailing groups of three zeros trimmed, "" for none.
fn frac(nanos: Int) -> Str {
  var s = pad(nanos, 9)
  if s.ends_with("000000") {
    s = s[0..3]
  } else if s.ends_with("000") {
    s = s[0..6]
  }
  if nanos == 0 { "" } else { "." + s }
}

fn timestamp_text(wire: Bytes) -> Str ! protojson.JsonErr {
  let t = match protowkt.decode_timestamp(wire) {
    Ok(t) => t
    Err(e) => return Err(jerr("proto: ${e.display()}"))
  }
  if t.seconds < -62135596800 || t.seconds > 253402300799 {
    return Err(jerr("google.protobuf.Timestamp: seconds out of range ${t.seconds}"))
  }
  if t.nanos < 0 || t.nanos > 999999999 {
    return Err(jerr("google.protobuf.Timestamp: nanos out of range ${t.nanos}"))
  }
  let (y, mo, d, h, mi, s) = civil(t.seconds)
  Ok("\"${pad(y, 4)}-${pad(mo, 2)}-${pad(d, 2)}T${pad(h, 2)}:${pad(mi, 2)}:${pad(s, 2)}${frac(t.nanos)}Z\"")
}

fn duration_text(wire: Bytes) -> Str ! protojson.JsonErr {
  let t = match protowkt.decode_duration(wire) {
    Ok(t) => t
    Err(e) => return Err(jerr("proto: ${e.display()}"))
  }
  var secs = t.seconds
  var nanos = t.nanos
  if secs < -315576000000 || secs > 315576000000 {
    return Err(jerr("google.protobuf.Duration: seconds out of range ${secs}"))
  }
  if nanos < -999999999 || nanos > 999999999 {
    return Err(jerr("google.protobuf.Duration: nanos out of range ${nanos}"))
  }
  if (secs > 0 && nanos < 0) || (secs < 0 && nanos > 0) {
    return Err(jerr("google.protobuf.Duration: signs of seconds and nanos do not match"))
  }
  var sign = ""
  if secs < 0 || nanos < 0 {
    sign = "-"
    secs = 0 - secs
    nanos = 0 - nanos
  }
  Ok("\"${sign}${secs}${frac(nanos)}s\"")
}

fn wkt_json(r: Registry, info: MsgInfo, wire: Bytes, o: protojson.Opts) -> Str? ! protojson.JsonErr {
  let n = info.full
  if !n.starts_with("google.protobuf.") {
    return Ok(None)
  }
  let short = n[16..n.len()]
  if short == "Timestamp" {
    return Ok(Some(timestamp_text(wire)?))
  }
  if short == "Duration" {
    return Ok(Some(duration_text(wire)?))
  }
  if short == "BoolValue" || short == "Int32Value" || short == "Int64Value" || short == "UInt32Value" || short == "UInt64Value" || short == "FloatValue" || short == "DoubleValue" || short == "StringValue" || short == "BytesValue" {
    let fl = walk_(wire)?
    let fd = pick_field(info, 1)
    match last_of(fl, 1, wire_of(fd.kind)) {
      Some(f) => return Ok(Some(scalar_text(r, fd, f, o)?))
      None => return Ok(Some(default_text(r, fd, o)))
    }
  }
  if short == "Struct" {
    let fl = walk_(wire)?
    var occ: List[pd.Fld] = []
    for f in fl {
      if f.num == 1 && f.wire == 2 {
        occ.push(f)
      }
    }
    let fd = pick_field(info, 1)
    return Ok(Some(map_text(r, lookup(r, fd.type_name)?, occ, o)?))
  }
  if short == "ListValue" {
    let fl = walk_(wire)?
    let fd = pick_field(info, 1)
    let vi = lookup(r, fd.type_name)?
    var items: List[Str] = []
    for f in fl {
      if f.num == 1 && f.wire == 2 {
        items.push(msg_json(r, vi, f.data, o, "")?)
      }
    }
    return Ok(Some("[" + items.join(",") + "]"))
  }
  if short == "Value" {
    let fl = walk_(wire)?
    var which = -1
    var pick = pd.Fld{num: 0, wire: 0, v: 0, data: b"", raw: b""}
    for f in fl {
      if (f.num == 1 && f.wire == 0) || (f.num == 2 && f.wire == 1) || (f.num == 3 && f.wire == 2) || (f.num == 4 && f.wire == 0) || (f.num == 5 && f.wire == 2) || (f.num == 6 && f.wire == 2) {
        which = f.num
        pick = f
      }
    }
    if which < 0 {
      return Err(jerr("google.protobuf.Value: none of the oneof fields is set"))
    }
    if which == 1 {
      return Ok(Some("null"))
    }
    if which == 2 {
      let x = Float.from_bits(pick.v)
      if x != x || x > 1.7976931348623157e308 || x < -1.7976931348623157e308 {
        return Err(jerr("google.protobuf.Value.number_value: invalid value"))
      }
      return Ok(Some(dbl_text(x)))
    }
    if which == 3 {
      match pick.data.to_str() {
        Some(s) => return Ok(Some(jstr(s)))
        None => return Err(jerr("google.protobuf.Value.string_value: contains invalid UTF-8"))
      }
    }
    if which == 4 {
      return Ok(Some(if pick.v != 0 { "true" } else { "false" }))
    }
    let fd = pick_field(info, which)
    return Ok(Some(msg_json(r, lookup(r, fd.type_name)?, pick.data, o, "")?))
  }
  if short == "FieldMask" {
    let fl = walk_(wire)?
    var paths: List[Str] = []
    for f in fl {
      if f.num == 1 && f.wire == 2 {
        let s = match f.data.to_str() {
          Some(s) => s
          None => return Err(jerr("google.protobuf.FieldMask.paths: contains invalid UTF-8"))
        }
        if !valid_full_name(s) {
          return Err(jerr("google.protobuf.FieldMask.paths contains invalid path: ${jstr(s)}"))
        }
        let cc = camel(s)
        if s != snake(cc) {
          return Err(jerr("google.protobuf.FieldMask.paths contains irreversible value ${jstr(s)}"))
        }
        paths.push(cc)
      }
    }
    return Ok(Some(jstr(paths.join(","))))
  }
  if short == "Any" {
    let fl = walk_(wire)?
    var url = ""
    var has_url = false
    var value = b""
    var has_value = false
    for f in fl {
      if f.num == 1 && f.wire == 2 {
        url = f.data.to_str_lossy()
        has_url = true
      } else if f.num == 2 && f.wire == 2 {
        value = f.data
        has_value = true
      }
    }
    if url.is_empty() {
      if value.is_empty() {
        return Ok(Some("{}"))
      }
      return Err(jerr("google.protobuf.Any: type_url is not set"))
    }
    var tn = url
    match url.rfind("/") {
      Some(i) => tn = url[i + 1..url.len()]
      None => {}
    }
    let em = match r.msgs.get(tn) {
      Some(m) => m
      None => return Err(jerr("google.protobuf.Any: unable to resolve ${jstr(url)}: not found"))
    }
    let tj = jstr("@type") + ":" + jstr(url)
    let en = em.full
    if en.starts_with("google.protobuf.") && en != "google.protobuf.Empty" {
      match wkt_json(r, em, value, o)? {
        Some(t) => return Ok(Some("{" + tj + "," + jstr("value") + ":" + t + "}"))
        None => {}
      }
    }
    return Ok(Some(msg_json(r, em, value, o, tj)?))
  }
  Ok(None)
}

// ---- reading JSON -----------------------------------------------------------

/// A JSON value as protobuf-go's decoder accepts it: numbers keep their text.
enum Jv {
  Null
  Bool(b: Bool)
  Num(raw: Str)
  Text(s: Str)
  Arr(items: List[Jv])
  Obj(members: List[(Str, Jv)])
}

struct P {
  b: Bytes
  at: Int
}

fn syntax(msg: Str) -> protojson.JsonErr { jerr("syntax error: ${msg}") }

fn p_ws(var p: P) {
  while p.at < p.b.len() {
    let c = p.b[p.at]
    if c == 32 || c == 10 || c == 13 || c == 9 {
      p.at += 1
    } else {
      return
    }
  }
}

/// isNotDelim: the bytes that cannot follow a literal or a number.
fn not_delim(c: Int) -> Bool {
  c == 45 || c == 43 || c == 46 || c == 95 || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
}

fn p_lit(var p: P, word: Str) -> Bool {
  let w = word.bytes()
  if p.at + w.len() > p.b.len() {
    return false
  }
  var i = 0
  while i < w.len() {
    if p.b[p.at + i] != w[i] {
      return false
    }
    i += 1
  }
  let n = p.at + w.len()
  if n < p.b.len() && not_delim(Int(p.b[n])) {
    return false
  }
  p.at = n
  true
}

fn is_digit(c: Int) -> Bool { c >= 48 && c <= 57 }

/// decode_number.go's parseNumber: the text of the number at p, an error when it is not one.
fn p_number(var p: P) -> Str ! protojson.JsonErr {
  let b = p.b
  let start = p.at
  var i = start
  let n = b.len()
  if i < n && b[i] == 45 {
    i += 1
    if i >= n {
      return Err(syntax("invalid value -"))
    }
  }
  if i < n && b[i] == 48 {
    i += 1
  } else if i < n && Int(b[i]) >= 49 && Int(b[i]) <= 57 {
    i += 1
    while i < n && is_digit(Int(b[i])) {
      i += 1
    }
  } else {
    return Err(syntax("invalid value"))
  }
  if i + 1 < n && b[i] == 46 && is_digit(Int(b[i + 1])) {
    i += 2
    while i < n && is_digit(Int(b[i])) {
      i += 1
    }
  }
  if i + 1 < n && (b[i] == 101 || b[i] == 69) {
    i += 1
    if b[i] == 43 || b[i] == 45 {
      i += 1
      if i >= n {
        return Err(syntax("invalid value"))
      }
    }
    while i < n && is_digit(Int(b[i])) {
      i += 1
    }
  }
  if i < n && not_delim(Int(b[i])) {
    return Err(syntax("invalid value"))
  }
  p.at = i
  Ok(b[start..i].to_str_lossy())
}

fn hexval(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

fn p_u4(p: P, at: Int) -> Int {
  if at + 4 > p.b.len() {
    return -1
  }
  var v = 0
  for i in 0..4 {
    let h = hexval(Int(p.b[at + i]))
    if h < 0 {
      return -1
    }
    v = v * 16 + h
  }
  v
}

fn p_string(var p: P) -> Str ! protojson.JsonErr {
  // p.b[p.at] is the opening quote
  p.at += 1
  var o = BytesBuilder.new()
  while p.at < p.b.len() {
    let c = Int(p.b[p.at])
    if c == 34 {
      p.at += 1
      return Ok(o.freeze().to_str_lossy())
    }
    if c < 32 {
      return Err(syntax("invalid character in string"))
    }
    if c == 92 {
      if p.at + 1 >= p.b.len() {
        return Err(syntax("unexpected EOF"))
      }
      let e = Int(p.b[p.at + 1])
      if e == 34 || e == 92 || e == 47 {
        o.write_byte(UInt8.wrapping_from(e))
        p.at += 2
      } else if e == 98 {
        o.write_byte(8)
        p.at += 2
      } else if e == 102 {
        o.write_byte(12)
        p.at += 2
      } else if e == 110 {
        o.write_byte(10)
        p.at += 2
      } else if e == 114 {
        o.write_byte(13)
        p.at += 2
      } else if e == 116 {
        o.write_byte(9)
        p.at += 2
      } else if e == 117 {
        var v = p_u4(p, p.at + 2)
        if v < 0 {
          return Err(syntax("invalid escape code"))
        }
        p.at += 6
        if v >= 0xD800 && v <= 0xDFFF {
          // a surrogate must be followed by an escape of its pair
          if p.at + 6 > p.b.len() || p.b[p.at] != 92 || p.b[p.at + 1] != 117 {
            return Err(syntax("invalid escape code"))
          }
          let w = p_u4(p, p.at + 2)
          if w < 0xDC00 || w > 0xDFFF || v > 0xDBFF {
            return Err(syntax("invalid escape code"))
          }
          v = 0x10000 + ((v - 0xD800) << 10) + (w - 0xDC00)
          p.at += 6
        }
        o.write_rune(Rune.try(v) ?? Rune.try(0xFFFD).or_fault("rune"))
      } else {
        return Err(syntax("invalid escape code"))
      }
    } else {
      o.write_byte(UInt8.wrapping_from(c))
      p.at += 1
    }
  }
  Err(syntax("unexpected EOF"))
}

fn p_value(var p: P, depth: Int) -> Jv ! protojson.JsonErr {
  if depth > 10000 {
    return Err(jerr("exceeded max recursion depth"))
  }
  p_ws(p)
  if p.at >= p.b.len() {
    return Err(syntax("unexpected EOF"))
  }
  let c = Int(p.b[p.at])
  if c == 110 {
    if p_lit(p, "null") {
      return Ok(Jv.Null)
    }
  } else if c == 116 {
    if p_lit(p, "true") {
      return Ok(Jv.Bool(true))
    }
  } else if c == 102 {
    if p_lit(p, "false") {
      return Ok(Jv.Bool(false))
    }
  } else if c == 45 || is_digit(c) {
    return Ok(Jv.Num(p_number(p)?))
  } else if c == 34 {
    return Ok(Jv.Text(p_string(p)?))
  } else if c == 123 {
    p.at += 1
    var members: List[(Str, Jv)] = []
    p_ws(p)
    if p.at < p.b.len() && p.b[p.at] == 125 {
      p.at += 1
      return Ok(Jv.Obj(members))
    }
    while true {
      p_ws(p)
      if p.at >= p.b.len() {
        return Err(syntax("unexpected EOF"))
      }
      if p.b[p.at] != 34 {
        return Err(syntax("unexpected token"))
      }
      let k = p_string(p)?
      p_ws(p)
      if p.at >= p.b.len() || p.b[p.at] != 58 {
        return Err(syntax("missing \":\" after field name"))
      }
      p.at += 1
      let v = p_value(p, depth + 1)?
      members.push((k, v))
      p_ws(p)
      if p.at >= p.b.len() {
        return Err(syntax("unexpected EOF"))
      }
      if p.b[p.at] == 44 {
        p.at += 1
      } else if p.b[p.at] == 125 {
        p.at += 1
        return Ok(Jv.Obj(members))
      } else {
        return Err(syntax("unexpected token"))
      }
    }
  } else if c == 91 {
    p.at += 1
    var items: List[Jv] = []
    p_ws(p)
    if p.at < p.b.len() && p.b[p.at] == 93 {
      p.at += 1
      return Ok(Jv.Arr(items))
    }
    while true {
      let v = p_value(p, depth + 1)?
      items.push(v)
      p_ws(p)
      if p.at >= p.b.len() {
        return Err(syntax("unexpected EOF"))
      }
      if p.b[p.at] == 44 {
        p.at += 1
      } else if p.b[p.at] == 93 {
        p.at += 1
        return Ok(Jv.Arr(items))
      } else {
        return Err(syntax("unexpected token"))
      }
    }
  }
  Err(syntax("invalid value"))
}

fn parse_json(s: Str) -> Jv ! protojson.JsonErr {
  var p = P{b: s.bytes(), at: 0}
  let v = p_value(p, 0)?
  p_ws(p)
  if p.at < p.b.len() {
    return Err(syntax("unexpected token"))
  }
  Ok(v)
}

// ---- numbers from JSON ------------------------------------------------------

/// normalizeToIntString: the integer an integer valued number text names (`1e2`, `1.0`, `-0`), as digits with an
/// optional sign; None when it is not integer valued.
fn int_digits(raw: Str) -> Str? {
  let b = raw.bytes()
  var i = 0
  var neg = false
  if i < b.len() && b[i] == 45 {
    neg = true
    i += 1
  }
  var intp = ""
  if i < b.len() && b[i] == 48 {
    i += 1
  } else {
    let s = i
    while i < b.len() && is_digit(Int(b[i])) {
      i += 1
    }
    intp = raw[s..i]
  }
  var frac = ""
  if i + 1 < b.len() && b[i] == 46 && is_digit(Int(b[i + 1])) {
    let s = i + 1
    i += 1
    while i < b.len() && is_digit(Int(b[i])) {
      i += 1
    }
    frac = raw[s..i]
  }
  // trailing zeros of the fraction mean nothing
  var fe = frac.len()
  while fe > 0 && frac.bytes()[fe - 1] == 48 {
    fe -= 1
  }
  frac = frac[0..fe]
  var exp = 0
  var has_exp = false
  if i + 1 < b.len() && (b[i] == 101 || b[i] == 69) {
    i += 1
    var eneg = false
    if b[i] == 43 || b[i] == 45 {
      eneg = b[i] == 45
      i += 1
    }
    let s = i
    while i < b.len() && is_digit(Int(b[i])) {
      i += 1
    }
    let es = raw[s..i]
    if es.len() > 10 {
      return None
    }
    exp = Int.parse(es) ?? 0
    if exp > 2147483647 {
      return None
    }
    if eneg {
      exp = 0 - exp
    }
    has_exp = true
  }
  if intp.is_empty() && frac.is_empty() {
    return Some("0")
  }
  var num = ""
  if exp >= 0 {
    if frac.len() > exp {
      return None
    }
    if intp.len() + exp > 20 {
      return None
    }
    num = intp + frac + "0".repeat(exp - frac.len())
  } else {
    if !frac.is_empty() {
      return None
    }
    let index = intp.len() + exp
    if index < 0 {
      return None
    }
    var k = index
    while k < intp.len() {
      if intp.bytes()[k] != 48 {
        return None
      }
      k += 1
    }
    num = intp[0..index]
  }
  let _ = has_exp
  Some(if neg { "-" + num } else { num })
}

fn parse_i64(raw: Str, bits: Int) -> Int? {
  let d = int_digits(raw) ?? return None
  let v = Int.parse(d) ?? return None
  if bits == 32 && (v < -2147483648 || v > 2147483647) {
    return None
  }
  Some(v)
}

/// The bits of an unsigned integer of `bits` width (a 64 bit one as its two's complement bits).
fn parse_u64(raw: Str, bits: Int) -> Int? {
  let d = int_digits(raw) ?? return None
  if d.starts_with("-") {
    return None
  }
  if d.len() > 20 {
    return None
  }
  if d.len() == 20 && d > "18446744073709551615" {
    return None
  }
  var v = UInt64.wrapping_from(0)
  let ten = UInt64.wrapping_from(10)
  for c in d.bytes() {
    v = v * ten + UInt64.wrapping_from(Int(c) - 48)
  }
  let x = v.to_bits()
  if bits == 32 && (x < 0 || x > 4294967295) {
    return None
  }
  Some(x)
}

/// The number a JSON string holds when it is exactly one number token (no spaces).
fn str_number(s: Str) -> Str? {
  var p = P{b: s.bytes(), at: 0}
  if p.b.is_empty() {
    return None
  }
  let c = Int(p.b[0])
  if !(c == 45 || is_digit(c)) {
    return None
  }
  match p_number(p) {
    Ok(t) => if p.at == p.b.len() { Some(t) } else { None }
    Err(_) => None
  }
}

fn num_text(v: Jv) -> Str? {
  match v {
    Num(raw) => Some(raw)
    Text(s) => str_number(s)
    _ => None
  }
}

/// A float from a JSON number or string; None when invalid or out of range for `bits`.
fn parse_float(v: Jv, bits: Int) -> Float? {
  match v {
    Text(s) => {
      if s == "NaN" {
        return Some(0.0 / 0.0)
      }
      if s == "Infinity" {
        return Some(1.0 / 0.0)
      }
      if s == "-Infinity" {
        return Some(-1.0 / 0.0)
      }
    }
    _ => {}
  }
  let raw = num_text(v) ?? return None
  let f = Float.parse(raw) ?? return None
  if f != f {
    return None
  }
  if bits == 32 {
    if f > 3.4028234663852886e38 || f < -3.4028234663852886e38 {
      // beyond float32's range after rounding is an error; the rounding boundary is Go's
      if f > 3.4028235677973366e38 || f < -3.4028235677973366e38 {
        return None
      }
    }
    return Some(f)
  }
  if f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {
    return None
  }
  Some(f)
}

// ---- JSON to wire -----------------------------------------------------------

/// One scalar or message value ready to write: `v` holds varint and fixed bits, `data` a length delimited payload.
struct Sv {
  v: Int
  data: Bytes
}

fn bad(fd: protodesc.FieldDesc) -> protojson.JsonErr { jerr("invalid value for field ${fd.name}") }

fn trim_dot(s: Str) -> Str { if s.starts_with(".") { s[1..s.len()] } else { s } }

fn enum_of(r: Registry, fd: protodesc.FieldDesc) -> protodesc.EnumDesc? { r.enums.get(trim_dot(fd.type_name)) }

fn zz32(n: Int) -> Int { ((n << 1) ^ (n >> 31)) & 0xFFFFFFFF }

fn zz64(n: Int) -> Int { (n << 1) ^ (n >> 63) }

/// A scalar field's value; None when it is skipped (an unknown enum name with discard_unknown).
fn enc_scalar(r: Registry, fd: protodesc.FieldDesc, jv: Jv, o: protojson.Opts) -> Sv? ! protojson.JsonErr {
  let k = fd.kind
  if k == protodesc.TYPE_DOUBLE {
    let f = parse_float(jv, 64) ?? return Err(bad(fd))
    return Ok(Some(Sv{v: f.to_bits(), data: b""}))
  }
  if k == protodesc.TYPE_FLOAT {
    let f = parse_float(jv, 32) ?? return Err(bad(fd))
    return Ok(Some(Sv{v: Int(Float32(f).to_bits()), data: b""}))
  }
  if k == protodesc.TYPE_INT64 || k == protodesc.TYPE_SFIXED64 || k == protodesc.TYPE_SINT64 || k == protodesc.TYPE_INT32 || k == protodesc.TYPE_SFIXED32 || k == protodesc.TYPE_SINT32 {
    let t = num_text(jv) ?? return Err(bad(fd))
    let w32 = k == protodesc.TYPE_INT32 || k == protodesc.TYPE_SFIXED32 || k == protodesc.TYPE_SINT32
    let n = parse_i64(t, if w32 { 32 } else { 64 }) ?? return Err(bad(fd))
    if k == protodesc.TYPE_SINT32 {
      return Ok(Some(Sv{v: zz32(n), data: b""}))
    }
    if k == protodesc.TYPE_SINT64 {
      return Ok(Some(Sv{v: zz64(n), data: b""}))
    }
    return Ok(Some(Sv{v: n, data: b""}))
  }
  if k == protodesc.TYPE_UINT64 || k == protodesc.TYPE_FIXED64 || k == protodesc.TYPE_UINT32 || k == protodesc.TYPE_FIXED32 {
    let t = num_text(jv) ?? return Err(bad(fd))
    let w32 = k == protodesc.TYPE_UINT32 || k == protodesc.TYPE_FIXED32
    let n = parse_u64(t, if w32 { 32 } else { 64 }) ?? return Err(bad(fd))
    return Ok(Some(Sv{v: n, data: b""}))
  }
  if k == protodesc.TYPE_BOOL {
    match jv {
      Bool(b) => return Ok(Some(Sv{v: if b { 1 } else { 0 }, data: b""}))
      _ => return Err(bad(fd))
    }
  }
  if k == protodesc.TYPE_STRING {
    match jv {
      Text(s) => return Ok(Some(Sv{v: 0, data: s.bytes()}))
      _ => return Err(bad(fd))
    }
  }
  if k == protodesc.TYPE_BYTES {
    match jv {
      Text(s) => {
        let enc = if s.contains("-") || s.contains("_") {
          if s.len() % 4 != 0 { base64.RawUrl } else { base64.Url }
        } else if s.len() % 4 != 0 {
          base64.RawStd
        } else {
          base64.Std
        }
        match base64.decode(s, enc) {
          Ok(b) => return Ok(Some(Sv{v: 0, data: b}))
          Err(_) => return Err(bad(fd))
        }
      }
      _ => return Err(bad(fd))
    }
  }
  if k == protodesc.TYPE_ENUM {
    match jv {
      Text(s) => {
        match enum_of(r, fd) {
          Some(e) => {
            for v in e.value {
              if v.name == s {
                return Ok(Some(Sv{v: v.number, data: b""}))
              }
            }
          }
          None => {}
        }
        if o.discard_unknown {
          return Ok(None)
        }
        return Err(bad(fd))
      }
      Num(raw) => {
        let n = parse_i64(raw, 32) ?? return Err(bad(fd))
        return Ok(Some(Sv{v: n, data: b""}))
      }
      Null => {
        if trim_dot(fd.type_name) == "google.protobuf.NullValue" {
          return Ok(Some(Sv{v: 0, data: b""}))
        }
        return Err(bad(fd))
      }
      _ => return Err(bad(fd))
    }
  }
  Err(jerr("field ${fd.name}: unsupported kind ${k}"))
}

/// A field's single value, a message converted through its descriptor.
fn enc_single(r: Registry, fd: protodesc.FieldDesc, jv: Jv, o: protojson.Opts) -> Sv? ! protojson.JsonErr {
  if fd.kind == protodesc.TYPE_MESSAGE {
    let mi = lookup(r, fd.type_name)?
    return Ok(Some(Sv{v: 0, data: msg_wire(r, mi, jv, o)?}))
  }
  if fd.kind == protodesc.TYPE_GROUP {
    return Err(jerr("field ${fd.name}: groups are not supported"))
  }
  enc_scalar(r, fd, jv, o)
}

fn w_fixed(var out: BytesBuilder, v: Int, n: Int) {
  var i = 0
  while i < n {
    out.write_byte(UInt8.wrapping_from((v >> (8 * i)) & 255))
    i += 1
  }
}

/// Writes `sv` for a field of kind `k`, with its tag when `tagged`.
fn emit(var out: BytesBuilder, num: Int, k: Int, sv: Sv, tagged: Bool) {
  let w = wire_of(k)
  if tagged {
    pd.wtag(out, num, w)
  }
  if w == 0 {
    pd.wv(out, sv.v)
  } else if w == 1 {
    w_fixed(out, sv.v, 8)
  } else if w == 5 {
    w_fixed(out, sv.v, 4)
  } else {
    pd.wv(out, sv.data.len())
    out.write(sv.data)
  }
}

fn is_packed(info: MsgInfo, fd: protodesc.FieldDesc) -> Bool {
  if !is_numeric_kind(fd.kind) {
    return false
  }
  var packed = info.proto3
  if !fd.options.is_empty() {
    for f in pd.walk(fd.options) ?? [] {
      if f.num == 2 && f.wire == 0 {
        packed = f.v != 0
      }
    }
  }
  packed
}

fn is_null(jv: Jv) -> Bool {
  match jv {
    Null => true
    _ => false
  }
}

fn is_value_field(fd: protodesc.FieldDesc) -> Bool {
  fd.kind == protodesc.TYPE_MESSAGE && trim_dot(fd.type_name) == "google.protobuf.Value"
}

fn is_nullvalue_field(fd: protodesc.FieldDesc) -> Bool {
  fd.kind == protodesc.TYPE_ENUM && trim_dot(fd.type_name) == "google.protobuf.NullValue"
}

fn key_sv(kfd: protodesc.FieldDesc, ks: Str) -> (Sv, Str) ! protojson.JsonErr {
  let k = kfd.kind
  if k == protodesc.TYPE_STRING {
    return Ok((Sv{v: 0, data: ks.bytes()}, ks))
  }
  if k == protodesc.TYPE_BOOL {
    if ks == "true" {
      return Ok((Sv{v: 1, data: b""}, "1"))
    }
    if ks == "false" {
      return Ok((Sv{v: 0, data: b""}, "0"))
    }
    return Err(bad(kfd))
  }
  let sv = enc_scalar(Registry{msgs: {}, enums: {}}, kfd, Jv.Text(ks), protojson.Opts{})?
  let x = match sv {
    Some(x) => x
    None => return Err(bad(kfd))
  }
  let sb = -9223372036854775807 - 1
  var sk = ""
  if k == protodesc.TYPE_UINT32 || k == protodesc.TYPE_FIXED32 || k == protodesc.TYPE_UINT64 || k == protodesc.TYPE_FIXED64 {
    sk = hex16(x.v)
  } else if k == protodesc.TYPE_SINT32 {
    let u = x.v & 0xFFFFFFFF
    sk = hex16(i32(u.shr_logical(1) ^ (0 - (u & 1))) ^ sb)
  } else if k == protodesc.TYPE_SINT64 {
    sk = hex16(x.v.shr_logical(1) ^ (0 - (x.v & 1)) ^ sb)
  } else {
    sk = hex16(x.v ^ sb)
  }
  Ok((x, sk))
}

fn map_entry_fields(entry: MsgInfo) -> (protodesc.FieldDesc, protodesc.FieldDesc) {
  var kfd = entry.d.field[0]
  var vfd = entry.d.field[1]
  for f in entry.d.field {
    if f.number == 1 {
      kfd = f
    } else if f.number == 2 {
      vfd = f
    }
  }
  (kfd, vfd)
}

/// The records of a map field: entries in key order, key and value both written.
fn enc_map(r: Registry, fd: protodesc.FieldDesc, entry: MsgInfo, members: List[(Str, Jv)], o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  let (kfd, vfd) = map_entry_fields(entry)
  var seen: Map[Str, Bool] = {}
  var recs: List[(Str, Bytes)] = []
  for m in members {
    let (ks, jv) = m
    let (ksv, sk) = key_sv(kfd, ks)?
    if seen.contains(sk) {
      return Err(jerr("duplicate map key ${jstr(ks)}"))
    }
    seen.put(sk, true)
    var vsv = Sv{v: 0, data: b""}
    if is_null(jv) && !is_value_field(vfd) && !is_nullvalue_field(vfd) {
      return Err(bad(fd))
    }
    match enc_single(r, vfd, jv, o)? {
      Some(x) => vsv = x
      None => continue
    }
    var rec = BytesBuilder.new()
    emit(rec, 1, kfd.kind, ksv, true)
    emit(rec, 2, vfd.kind, vsv, true)
    recs.push((sk, rec.freeze()))
  }
  let sorted = recs.sort_by(fn(e: (Str, Bytes)) -> Str { e.0 })
  var out = BytesBuilder.new()
  for e in sorted {
    pd.wtag(out, fd.number, 2)
    pd.wv(out, e.1.len())
    out.write(e.1)
  }
  Ok(out.freeze())
}

/// The wire bytes of one field from its JSON value.
fn enc_field(r: Registry, info: MsgInfo, fd: protodesc.FieldDesc, jv: Jv, o: protojson.Opts, real_oneof: Bool) -> Bytes ! protojson.JsonErr {
  var out = BytesBuilder.new()
  if fd.label == protodesc.LABEL_REPEATED {
    if fd.kind == protodesc.TYPE_MESSAGE {
      let mi = lookup(r, fd.type_name)?
      if mi.is_map {
        match jv {
          Obj(members) => return enc_map(r, fd, mi, members, o)
          _ => return Err(bad(fd))
        }
      }
    }
    let items = match jv {
      Arr(items) => items
      _ => return Err(bad(fd))
    }
    var svs: List[Sv] = []
    for it in items {
      if is_null(it) && !is_value_field(fd) && !is_nullvalue_field(fd) {
        return Err(bad(fd))
      }
      match enc_single(r, fd, it, o)? {
        Some(x) => svs.push(x)
        None => {}
      }
    }
    if svs.is_empty() {
      return Ok(b"")
    }
    if is_packed(info, fd) {
      var body = BytesBuilder.new()
      for x in svs {
        emit(body, fd.number, fd.kind, x, false)
      }
      let bb = body.freeze()
      pd.wtag(out, fd.number, 2)
      pd.wv(out, bb.len())
      out.write(bb)
    } else {
      for x in svs {
        emit(out, fd.number, fd.kind, x, true)
      }
    }
    return Ok(out.freeze())
  }
  let sv = match enc_single(r, fd, jv, o)? {
    Some(x) => x
    None => return Ok(b"")
  }
  let implicit = info.proto3 && fd.kind != protodesc.TYPE_MESSAGE && fd.kind != protodesc.TYPE_GROUP && !real_oneof && !fd.proto3_optional
  if implicit {
    let zero = if wire_of(fd.kind) == 2 { sv.data.is_empty() } else { sv.v == 0 }
    if zero {
      return Ok(b"")
    }
  }
  emit(out, fd.number, fd.kind, sv, true)
  Ok(out.freeze())
}

fn unmarshal(r: Registry, name: Str, json: Str, o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  let jv = parse_json(json)?
  match r.msgs.get(name) {
    Some(info) => msg_wire(r, info, jv, o)
    None => Err(jerr("unknown message ${name}"))
  }
}

fn field_for(info: MsgInfo, key: Str) -> protodesc.FieldDesc? {
  for fd in info.d.field {
    if json_name(fd) == key {
      return Some(fd)
    }
  }
  for fd in info.d.field {
    if fd.name == key {
      return Some(fd)
    }
  }
  None
}

/// The wire bytes of the message `info` from its JSON value.
fn msg_wire(r: Registry, info: MsgInfo, jv: Jv, o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  match wkt_wire(r, info, jv, o)? {
    Some(b) => return Ok(b)
    None => {}
  }
  msg_wire_obj(r, info, jv, o, false)
}

fn msg_wire_obj(r: Registry, info: MsgInfo, jv: Jv, o: protojson.Opts, in_any: Bool) -> Bytes ! protojson.JsonErr {
  let members = match jv {
    Obj(m) => m
    _ => return Err(jerr("unexpected token"))
  }
  var seen: Map[Int, Bool] = {}
  var oneofs: Map[Int, Bool] = {}
  var recs: List[(Int, Bytes)] = []
  for m in members {
    let (key, v) = m
    if in_any && key == "@type" {
      continue
    }
    let fd = match field_for(info, key) {
      Some(f) => f
      None => {
        if o.discard_unknown || (key.starts_with("[") && key.ends_with("]") && o.discard_unknown) {
          continue
        }
        return Err(jerr("unknown field ${jstr(key)}"))
      }
    }
    if seen.contains(fd.number) {
      return Err(jerr("duplicate field ${jstr(key)}"))
    }
    seen.put(fd.number, true)
    if is_null(v) && !is_value_field(fd) && !is_nullvalue_field(fd) {
      continue
    }
    var order = fd.number
    var real_oneof = false
    match fd.oneof_index {
      Some(k) => {
        if !fd.proto3_optional {
          real_oneof = true
          if fd.label != protodesc.LABEL_REPEATED {
            if oneofs.contains(k) {
              return Err(jerr("oneof is already set for field ${jstr(key)}"))
            }
            oneofs.put(k, true)
          }
          order = (k + 1) * 1000000000000 + fd.number
        }
      }
      None => {}
    }
    let b = enc_field(r, info, fd, v, o, real_oneof)?
    if !b.is_empty() {
      recs.push((order, b))
    }
  }
  let sorted = recs.sort_by(fn(e: (Int, Bytes)) -> Int { e.0 })
  var out = BytesBuilder.new()
  for e in sorted {
    out.write(e.1)
  }
  Ok(out.freeze())
}

// ---- well known types from JSON ----------------------------------------------

fn digits_at(b: Bytes, at: Int, n: Int) -> Int {
  if at + n > b.len() {
    return -1
  }
  var v = 0
  for i in 0..n {
    let c = Int(b[at + i])
    if !is_digit(c) {
      return -1
    }
    v = v * 10 + (c - 48)
  }
  v
}

fn leap(y: Int) -> Bool { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

fn days_in(y: Int, m: Int) -> Int {
  if m == 2 {
    if leap(y) { 29 } else { 28 }
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else {
    31
  }
}

/// Days from 1970-01-01 of a civil date (proleptic Gregorian).
fn days_from_civil(y0: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { y0 - 1 } else { y0 }
  let era = (if y >= 0 { y } else { y - 399 }) / 400
  let yoe = y - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

fn ts_wire(secs: Int, nanos: Int) -> Bytes {
  var o = BytesBuilder.new()
  pd.wi(o, 1, secs)
  pd.wi(o, 2, nanos)
  o.freeze()
}

fn parse_timestamp(s: Str) -> Bytes ! protojson.JsonErr {
  let e = jerr("invalid google.protobuf.Timestamp value ${jstr(s)}")
  let b = s.bytes()
  if b.len() < 20 {
    return Err(e)
  }
  let y = digits_at(b, 0, 4)
  let mo = digits_at(b, 5, 2)
  let d = digits_at(b, 8, 2)
  let h = digits_at(b, 11, 2)
  let mi = digits_at(b, 14, 2)
  let sec = digits_at(b, 17, 2)
  if y < 0 || mo < 0 || d < 0 || h < 0 || mi < 0 || sec < 0 {
    return Err(e)
  }
  if b[4] != 45 || b[7] != 45 || b[10] != 84 || b[13] != 58 || b[16] != 58 {
    return Err(e)
  }
  if y < 1 || mo < 1 || mo > 12 || d < 1 || d > days_in(y, mo) || h > 23 || mi > 59 || sec > 59 {
    return Err(e)
  }
  var i = 19
  var nanos = 0
  if b[i] == 46 {
    let s0 = i + 1
    i += 1
    while i < b.len() && is_digit(Int(b[i])) {
      i += 1
    }
    let nd = i - s0
    if nd == 0 || nd > 9 {
      return Err(e)
    }
    var v = 0
    for k in 0..9 {
      v = v * 10 + (if k < nd { Int(b[s0 + k]) - 48 } else { 0 })
    }
    nanos = v
  }
  if i >= b.len() {
    return Err(e)
  }
  var off = 0
  if b[i] == 90 {
    i += 1
  } else if b[i] == 43 || b[i] == 45 {
    let oh = digits_at(b, i + 1, 2)
    let om = digits_at(b, i + 4, 2)
    if oh < 0 || om < 0 || i + 3 >= b.len() || b[i + 3] != 58 || oh > 24 || om > 60 {
      return Err(e)
    }
    off = (oh * 3600 + om * 60) * (if b[i] == 45 { -1 } else { 1 })
    i += 6
  } else {
    return Err(e)
  }
  if i != b.len() {
    return Err(e)
  }
  let secs = days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + sec - off
  if secs < -62135596800 || secs > 253402300799 {
    return Err(jerr("google.protobuf.Timestamp value is out of range: ${jstr(s)}"))
  }
  Ok(ts_wire(secs, nanos))
}

fn parse_duration(s: Str) -> Bytes ! protojson.JsonErr {
  let e = jerr("invalid google.protobuf.Duration value ${jstr(s)}")
  let b = s.bytes()
  if b.len() < 2 || b[b.len() - 1] != 115 {
    return Err(e)
  }
  var i = 0
  let end = b.len() - 1
  var neg = false
  if b[0] == 43 {
    i = 1
  } else if b[0] == 45 {
    neg = true
    i = 1
  }
  if i >= end {
    return Err(e)
  }
  var secs = 0
  if b[i] == 48 {
    i += 1
  } else if Int(b[i]) >= 49 && Int(b[i]) <= 57 {
    let s0 = i
    while i < end && is_digit(Int(b[i])) {
      i += 1
    }
    if i - s0 > 18 {
      return Err(e)
    }
    secs = Int.parse(s[s0..i]) ?? return Err(e)
  } else {
    return Err(e)
  }
  var nanos = 0
  if i < end {
    if b[i] != 46 {
      return Err(e)
    }
    let s0 = i + 1
    let nd = end - s0
    if nd == 0 || nd > 9 {
      return Err(e)
    }
    var v = 0
    for k in 0..9 {
      if k < nd {
        let c = Int(b[s0 + k])
        if !is_digit(c) {
          return Err(e)
        }
        v = v * 10 + (c - 48)
      } else {
        v = v * 10
      }
    }
    nanos = v
  }
  if secs > 315576000000 {
    return Err(e)
  }
  if neg {
    secs = 0 - secs
    nanos = 0 - nanos
  }
  Ok(ts_wire(secs, nanos))
}

fn text_of(jv: Jv, what: Str) -> Str ! protojson.JsonErr {
  match jv {
    Text(s) => Ok(s)
    _ => Err(jerr("invalid ${what} value"))
  }
}

fn value_wire(jv: Jv, o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  var out = BytesBuilder.new()
  match jv {
    Null => pd.wia(out, 1, 0)
    Num(raw) => {
      let f = parse_float(jv, 64) ?? return Err(jerr("invalid google.protobuf.Value number ${raw}"))
      pd.wtag(out, 2, 1)
      w_fixed(out, f.to_bits(), 8)
    }
    Text(s) => pd.wsa(out, 3, s)
    Bool(b) => pd.wia(out, 4, if b { 1 } else { 0 })
    Obj(m) => pd.wm(out, 5, struct_wire(m, o)?)
    Arr(items) => pd.wm(out, 6, list_wire(items, o)?)
  }
  Ok(out.freeze())
}

fn struct_wire(members: List[(Str, Jv)], o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  var seen: Map[Str, Bool] = {}
  var recs: List[(Str, Bytes)] = []
  for m in members {
    if seen.contains(m.0) {
      return Err(jerr("duplicate map key ${jstr(m.0)}"))
    }
    seen.put(m.0, true)
    var rec = BytesBuilder.new()
    pd.wsa(rec, 1, m.0)
    pd.wm(rec, 2, value_wire(m.1, o)?)
    recs.push((m.0, rec.freeze()))
  }
  let sorted = recs.sort_by(fn(e: (Str, Bytes)) -> Str { e.0 })
  var out = BytesBuilder.new()
  for e in sorted {
    pd.wm(out, 1, e.1)
  }
  Ok(out.freeze())
}

fn list_wire(items: List[Jv], o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  var out = BytesBuilder.new()
  for it in items {
    pd.wm(out, 1, value_wire(it, o)?)
  }
  Ok(out.freeze())
}

fn fieldmask_wire(s0: Str) -> Bytes ! protojson.JsonErr {
  let str = s0.trim()
  var out = BytesBuilder.new()
  if str.is_empty() {
    return Ok(out.freeze())
  }
  for p in str.split(",") {
    let sn = snake(p)
    if p.contains("_") || !valid_full_name(sn) {
      return Err(jerr("google.protobuf.FieldMask.paths contains invalid path: ${jstr(p)}"))
    }
    pd.wsa(out, 1, sn)
  }
  Ok(out.freeze())
}

fn wkt_wire(r: Registry, info: MsgInfo, jv: Jv, o: protojson.Opts) -> Bytes? ! protojson.JsonErr {
  let n = info.full
  if !n.starts_with("google.protobuf.") {
    return Ok(None)
  }
  let short = n[16..n.len()]
  if short == "Timestamp" {
    return Ok(Some(parse_timestamp(text_of(jv, "google.protobuf.Timestamp")?)?))
  }
  if short == "Duration" {
    return Ok(Some(parse_duration(text_of(jv, "google.protobuf.Duration")?)?))
  }
  if short == "BoolValue" || short == "Int32Value" || short == "Int64Value" || short == "UInt32Value" || short == "UInt64Value" || short == "FloatValue" || short == "DoubleValue" || short == "StringValue" || short == "BytesValue" {
    let fd = pick_field(info, 1)
    match enc_scalar(r, fd, jv, o)? {
      Some(sv) => {
        let zero = if wire_of(fd.kind) == 2 { sv.data.is_empty() } else { sv.v == 0 }
        var out = BytesBuilder.new()
        if !zero {
          emit(out, 1, fd.kind, sv, true)
        }
        return Ok(Some(out.freeze()))
      }
      None => return Ok(Some(b""))
    }
  }
  if short == "Struct" {
    match jv {
      Obj(m) => return Ok(Some(struct_wire(m, o)?))
      _ => return Err(jerr("unexpected token"))
    }
  }
  if short == "ListValue" {
    match jv {
      Arr(items) => return Ok(Some(list_wire(items, o)?))
      _ => return Err(jerr("unexpected token"))
    }
  }
  if short == "Value" {
    return Ok(Some(value_wire(jv, o)?))
  }
  if short == "FieldMask" {
    return Ok(Some(fieldmask_wire(text_of(jv, "google.protobuf.FieldMask")?)?))
  }
  if short == "Empty" {
    match jv {
      Obj(m) => {
        if !m.is_empty() && !o.discard_unknown {
          return Err(jerr("unknown field ${jstr(m[0].0)}"))
        }
        return Ok(Some(b""))
      }
      _ => return Err(jerr("unexpected token"))
    }
  }
  if short == "Any" {
    return Ok(Some(any_wire(r, info, jv, o)?))
  }
  Ok(None)
}

fn any_wire(r: Registry, info: MsgInfo, jv: Jv, o: protojson.Opts) -> Bytes ! protojson.JsonErr {
  let members = match jv {
    Obj(m) => m
    _ => return Err(jerr("unexpected token"))
  }
  if members.is_empty() {
    return Ok(b"")
  }
  var url = ""
  for m in members {
    if m.0 == "@type" {
      if !url.is_empty() {
        return Err(jerr("duplicate \"@type\" field"))
      }
      match m.1 {
        Text(s) => {
          if s.is_empty() {
            return Err(jerr("@type field contains empty value"))
          }
          url = s
        }
        _ => return Err(jerr("@type field value is not a string"))
      }
    }
  }
  if url.is_empty() {
    if o.discard_unknown {
      return Ok(b"")
    }
    return Err(jerr("missing \"@type\" field"))
  }
  var tn = url
  match url.rfind("/") {
    Some(i) => tn = url[i + 1..url.len()]
    None => {}
  }
  let em = match r.msgs.get(tn) {
    Some(m) => m
    None => return Err(jerr("unable to resolve ${jstr(url)}: not found"))
  }
  var value = b""
  let en = em.full
  if en.starts_with("google.protobuf.") && en != "google.protobuf.Empty" && wkt_name(en) {
    var found = false
    for m in members {
      if m.0 == "@type" {
        continue
      }
      if m.0 == "value" {
        if found {
          return Err(jerr("duplicate \"value\" field"))
        }
        value = msg_wire(r, em, m.1, o)?
        found = true
      } else if !o.discard_unknown {
        return Err(jerr("unknown field ${jstr(m.0)}"))
      }
    }
    if !found {
      return Err(jerr("missing \"value\" field"))
    }
  } else if en == "google.protobuf.Empty" {
    for m in members {
      if m.0 == "@type" {
        continue
      }
      if m.0 == "value" {
        value = msg_wire(r, em, m.1, o)?
      } else if !o.discard_unknown {
        return Err(jerr("unknown field ${jstr(m.0)}"))
      }
    }
  } else {
    value = msg_wire_obj(r, em, jv, o, true)?
  }
  var out = BytesBuilder.new()
  pd.ws(out, 1, url)
  if !value.is_empty() {
    pd.wtag(out, 2, 2)
    pd.wv(out, value.len())
    out.write(value)
  }
  Ok(out.freeze())
}

/// The well known types with a special JSON form.
fn wkt_name(n: Str) -> Bool {
  let s = n[16..n.len()]
  s == "Timestamp" || s == "Duration" || s == "BoolValue" || s == "Int32Value" || s == "Int64Value" || s == "UInt32Value" || s == "UInt64Value" || s == "FloatValue" || s == "DoubleValue" || s == "StringValue" || s == "BytesValue" || s == "Struct" || s == "ListValue" || s == "Value" || s == "FieldMask" || s == "Any"
}
