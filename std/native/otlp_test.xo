  var spans: List[trace.Span] = []
  var s0 = trace.Span{id: "101112131415161718191a1b1c1d1e01", name: "unset-never-set", start_ms: 1700000000000, micros: 1, status: 0, trace_id: "101112131415161718191a1b1c1d1e01", span_id: "a000000000000001", parent_id: "root", kind: Some(trace.SpanKind.Internal), start_ns: 1700000000000000000, end_ns: 1700000000000001000, scope: "oracle", scope_version: "", schema_url: ""}
