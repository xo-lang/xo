// std/url's fast path on the native backends (decision 0597 part 2):
// escape writes its output through the buffer's address, a run of kept
// bytes one mem_copy and an escape three byte stores. Written with
// BytesBuilder it was 1.075 (1.053 to 1.107) of this on
// bench/perf/url escape, and 1.041 (1.023 to 1.068) with one write_be
// per escape (linux/arm64 host 1, 2026-11-10), so it stays here, behind
// the bodyless declaration in std/url.xo.
use native/llrt/raw
use native/rt

const UPPER_HEX: Str = "0123456789ABCDEF"

/// One byte a character: 0 kept as it is, 1 escaped as `%XX`, and in the
/// query table 2 for a space (written as `+`).
const QUERY_CLASS: Bytes = b"\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x02\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01"

/// The path segment table: also keeps `$ & + : = @`.
const PATH_CLASS: Bytes = b"\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x01\x00\x01\x01\x01\x01\x00\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01"

fn escape(s: Str, path: Bool) -> Str {
  let b = s.bytes()
  let tab = if path { PATH_CLASS } else { QUERY_CLASS }
  let nb = b.len()
  var n = 0
  var plus = 0
  for c in b {
    let t = Int(tab[Int(c)])
    n += t & 1
    plus += t >> 1
  }
  if n == 0 && plus == 0 {
    return s
  }
  // the output is written through its address: a run of kept bytes is one
  // mem_copy, an escape three byte stores (a byte at a time into a builder
  // with the character tests was 1.55 of Go's wall, 2026-11-04)
  let hex = UPPER_HEX.bytes()
  let ob = raw.bytes_buf(nb + 2 * n)
  let op = raw.bytes_addr(ob)
  let sp = raw.bytes_addr(b)
  var o = 0
  var start = 0
  var i = 0
  while i < nb {
    let c = Int(b[i])
    let t = Int(tab[c])
    if t != 0 {
      let run = i - start
      if run > 0 {
        rt.mem_copy(op.wrapping_add(o), sp.wrapping_add(start), run)
        o += run
      }
      if t == 2 {
        rt.mem_store(op, o, 43, 1)
        o += 1
      } else {
        rt.mem_store(op, o, 37, 1)
        rt.mem_store(op, o + 1, Int(hex[c >> 4]), 1)
        rt.mem_store(op, o + 2, Int(hex[c & 15]), 1)
        o += 3
      }
      start = i + 1
    }
    i += 1
  }
  if start < nb {
    rt.mem_copy(op.wrapping_add(o), sp.wrapping_add(start), nb - start)
  }
  raw.alive(b)
  // kept bytes are ASCII and every non-ASCII byte is escaped: the result is ASCII
  rt.cast[Bytes, Str](ob)
}
