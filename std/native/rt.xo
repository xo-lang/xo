// Intrinsics of the native backends (decision 0074). A declaration file
// like std/*.xo, imported only by the implementation modules in this
// directory as `use native/rt`. internal/ssa lowers a call of a function
// declared here to a call of the C runtime function xo_<name> (std/llrt):
// Int and Bool are one word, Float a double, Str its bytes and length (a
// function named rs_* gets the string object instead and consumes its
// first Str), List and handles a pointer; a Str result is the string
// object with its length through a pointer. The generic intrinsics at
// the end are lowered by internal/ssa itself (build_native.go).

// ---------------------------------------------------------------------------
// Strings

fn str_contains(s: Str, sub: Str) -> Bool
fn str_starts_with(s: Str, p: Str) -> Bool
fn str_ends_with(s: Str, p: Str) -> Bool
/// The byte index of the first sub at or after from, or -1.
fn str_find(s: Str, sub: Str, from: Int) -> Int
/// The bytes from lo to hi (clamped to the string).
fn str_slice(s: Str, lo: Int, hi: Int) -> Str
/// The byte at i (0 to 255), or -1 out of range.
fn str_byte(s: Str, i: Int) -> Int
fn str_rune_count(s: Str) -> Int
fn str_split(s: Str, sep: Str) -> List[Str]
fn str_lines(s: Str) -> List[Str]
fn str_repeat(s: Str, n: Int) -> Str
fn str_join(xs: List[Str], sep: Str) -> Str
/// The string of one byte (0 to 255).
fn str_of_byte(b: Int) -> Str
/// Whether s parses as an Int (strconv.ParseInt(s, 10, 64)).
fn int_parse_ok(s: Str) -> Bool
fn int_parse(s: Str) -> Int
/// s + t, appended in place when s is unique.
fn rs_append(s: Str, t: Str) -> Str
/// s + the text of a Duration of d nanoseconds (Go's time.Duration.String).
fn rs_append_duration(s: Str, d: Int) -> Str
/// s + the bytes lo..hi of b (a range of b), their ASCII letters lowered
/// (mode 1) or raised (mode 2); mode 0 copies (std/native/llrt/unicode.xo,
/// decision 0180).
fn rs_append_bytes(s: Str, b: Bytes, lo: Int, hi: Int, mode: Int) -> Str
/// The end of the run of bytes of b from i in the class cls: 0 ASCII, 1
/// printable ASCII other than `"` and `\` (std/native/llrt/unicode.xo).
fn bytes_span(b: Bytes, i: Int, cls: Int) -> Int
/// s + the byte x (0 to 255; BytesBuilder.write_byte).
fn rs_push_byte(s: Str, x: Int) -> Str
/// s + the n (0 to 8) low bytes of w, the lowest first: short text
/// assembled in Xo appended with one call (std/native/llrt/text.xo,
/// decision 0193).
fn rs_push_word(s: Str, w: Int, n: Int) -> Str
/// s + four such words, their lengths (0 to 8) in the nibbles of lens,
/// w0's the lowest (decision 0193).
fn rs_push_words(s: Str, w0: Int, w1: Int, w2: Int, w3: Int, lens: Int) -> Str
/// s + the character r, U+FFFD when r is not a scalar value (the C path
/// of std/native/llrt/show.xo, XO_LLRT_C=show; also the SSA's).
fn rs_append_rune(s: Str, r: Int) -> Str
/// s + the Debug text of the Rune r (the C path of show.xo).
fn rs_append_rune_quote(s: Str, r: Int) -> Str
/// s + the decimal text of v as a UInt64 (the C path of show.xo).
fn rs_append_u64(s: Str, v: Int) -> Str
/// s + the UTF-8 of r, U+FFFD when r is not a scalar value
/// (BytesBuilder.write_rune).
fn rs_push_rune(s: Str, r: Int) -> Str
/// An empty string with room for n bytes (BytesBuilder.with_capacity).
fn rs_with_cap(n: Int) -> Str

// The C path of the number and time text (decision 0193): compiled only
// with -DXO_TEXT_C, called only by std/native/llrt/text_c.xo
// (XO_LLRT_C=text). int_parse and duration_parse above are the others.

fn rs_append_time(s: Str, t: Int) -> Str
fn time_parse_ok(s: Str) -> Bool
fn time_parse(s: Str) -> Int
fn rs_append_quote(s: Str, b: Bytes) -> Str
/// Writes s and a newline to standard error.
fn eprintln(s: Str)

// ---------------------------------------------------------------------------
// Runes and Bytes (decisions 0079, 0081; std/llrt/xo_bytes.c)

fn rune_is_space(r: Rune) -> Bool
/// Whether the text is a duration (std/rt's parseDuration).
fn duration_parse_ok(s: Str) -> Bool
/// The duration of the text in nanoseconds (0 when it is not one).
fn duration_parse(s: Str) -> Int
/// utf8.DecodeRune of b from i: the rune times 8 plus its size.
fn bytes_decode(b: Bytes, i: Int) -> Int
/// utf8.ValidString (std/native/llrt/jsontext.xo).
fn utf8_valid(s: Str) -> Bool
/// utf8.RuneCount.
fn bytes_rune_count(b: Bytes) -> Int
/// The lowercase hex of b.
fn bytes_hex(b: Bytes) -> Str
/// a op b wrapping like Go's int64 (op 0 +, 1 -, 2 *), or a shifted by
/// b mod 64 (op 3 left, 4 right logical, as a UInt64): the native
/// backends lower a constant op inline (decision 0193 step 3). Decision
/// 0195: op 5 a rotated right by b mod 64, op 6 the low 32 bits of a
/// rotated right by b mod 32 (zero extended), op 7 the bytes of a
/// reversed (b unused): ror and rev on arm64, fshr and bswap on LLVM.
fn int_wrap(op: Int, a: Int, b: Int) -> Int
/// The high word of the 128 bit product of a and b as UInt64s (umulh;
/// lowered inline).
fn u64_mul_hi(a: Int, b: Int) -> Int
/// The IEEE 754 bits of f (lowered inline).
fn float_bits(f: Float) -> Int
/// The Float of the IEEE 754 bits b (lowered inline).
fn float_from_bits(b: Int) -> Float
/// The 8 bytes of b from i as a word, the first lowest (lowered inline
/// to one load). Unchecked: the caller makes sure 0 <= i and i + 8 <=
/// b.len().
fn bytes_word(b: Bytes, i: Int) -> Int
/// Checked arithmetic on a sized integer type (std/llrt/xo_bytes.c, the
/// C path of std/native/llrt/ints.xo, XO_LLRT_C=ints): op 0 +, 1 -, 2 *,
/// 3 /, 4 %, 5 <<, 6 >>, 7 unary minus of a; faults at at.
fn int_op(op: Int, a: Int, b: Int, bits: Int, uns: Int, at: Str) -> Int
/// v of the type of fbits and funs converted to the type of tbits and
/// tuns, faulting at at out of range (the C path of ints.xo).
fn int_conv(v: Int, fbits: Int, funs: Int, tbits: Int, tuns: Int, at: Str) -> Int
/// `Rune(v)`, faulting at at (the C path of ints.xo).
fn rune_of(v: Int, bits: Int, uns: Int, at: Str) -> Int
/// a / b rounded down, b > 0 (the C path of ints.xo).
fn floor_div(a: Int, b: Int) -> Int
/// The hash of a Str Map key (the C path of ints.xo).
fn str_hash(s: Str) -> Int
/// Whether a op b fits an Int (op 0 +, 1 -, 2 *, 3 /).
fn int_fits(op: Int, a: Int, b: Int) -> Bool

// ---------------------------------------------------------------------------
// Raw memory (decision 0207): an address is an Int. Unchecked and
// internal: only the runtime modules (std/native/llrt) use them, for
// memory the C runtime hands over and for objects whose layout the
// table of `layout` gives. Every native emitter lowers them inline
// (memcpy, memmove, memset, memcmp are platform library calls); none
// has a C version. The width w of mem_load and mem_store must be a
// constant 1, 2, 4, or 8 (the SSA builders check it, as int_wrap's op).
// The atomics of decision 0200 get address forms (atomic_*_at) here when
// they land.

/// The w bytes at address a + off, little endian, zero extended.
fn mem_load(a: Int, off: Int, w: Int) -> Int
/// Stores the w low bytes of v at address a + off.
fn mem_store(a: Int, off: Int, v: Int, w: Int)
/// Copies n bytes from src to dst (the ranges do not overlap).
fn mem_copy(dst: Int, src: Int, n: Int)
/// Copies n bytes from src to dst (the ranges may overlap).
fn mem_move(dst: Int, src: Int, n: Int)
/// Sets the n bytes at dst to the low byte of b.
fn mem_set(dst: Int, b: Int, n: Int)
/// Compares n bytes at a and b as unsigned bytes: below zero, zero, or
/// above zero (memcmp).
fn mem_cmp(a: Int, b: Int, n: Int) -> Int
/// A layout constant of the target's runtime objects, k a constant (the
/// SSA builders fold it from their one table, ssa layout): 0 the data
/// offset of a string object, 1 the capacity offset of a string object,
/// 2 the element offset of a list object, 3 its length offset, 4 its
/// capacity offset, 5 the count's offset in any object, 6 the bytes of
/// an address, 7 the bytes of a count.
fn layout(k: Int) -> Int
/// s with its length set to n, the same object (consumed; unchecked: n
/// is at most its capacity, and the bytes up to n were written).
fn rs_set_len(s: Str, n: Int) -> Str

// ---------------------------------------------------------------------------
// Generic intrinsics (lowered by internal/ssa, build_native.go)

/// A value of any type, which remembers its type (a request value).
struct Any {}
fn any_of[T](v: T) -> Any
/// The value if it has type T.
fn any_get[T](a: Any) -> T?

/// The address of the object x refers to (decision 0207): a Str's string
/// object, a List's list object, a handle's record; no count changes.
fn obj_addr[T](x: T) -> Int
/// The List or handle of type T whose object is at address a, counted
/// once more (the reference counting of the result releases it, so the
/// object's count is unchanged once the value is dead; decision 0207).
fn obj_at[T](a: Int) -> T

/// a as a B: a std type and its implementation type (http.Response and
/// the implementation's Response), which lower to one type (decision
/// 0083); any other pair is not available.
fn cast[A, B](a: A) -> B

/// e.status() when E has a `status` method (implements http.StatusError).
fn status_of[E](e: E) -> Int?

/// f, its effects counted here: what a registered handler or middleware
/// does is accounted where it is registered (std.md 4.1).
fn launder1[A, R, fx: Effects](f: fn(A) -> R uses fx) -> (fn(A) -> R) uses fx
fn launder2[A, B, R, fx: Effects](f: fn(A, B) -> R uses fx) -> (fn(A, B) -> R) uses fx

/// The `file:line` of the call of the std function that is being
/// implemented (a parameter of this type gets it, for faults).
struct Loc {}
/// Faults with msg at loc.
fn fault_at(msg: Str, at: Loc) -> Never
/// Faults with msg at loc, a `file:line` text (a stored fault raised
/// again, as std/rt re-panics a stored FaultErr).
fn fault_raise(msg: Str, loc: Str) -> Never

/// Whether a log field value is a number or a Bool (written bare in a
/// JSON record).
fn dyn_raw(v: Debug) -> Bool
/// The text of a log field value (its Display text, else its Debug text).
fn dyn_text(v: Debug) -> Str

// ---------------------------------------------------------------------------
// Fs (decision 0102): an Fs value is its root and mode bits (1 a sub
// capability, 2 read only, 4 write only); the operations take OS paths
// prelude.xo resolved, and an Xo path for the error. internal/ssa lowers
// fs_root, fs_mode, and fs_new itself.

/// The root of f ("" for os.fs).
fn fs_root(f: Fs) -> Str
/// The mode bits of f.
fn fs_mode(f: Fs) -> Int
/// The Fs value with root and mode.
fn fs_new(root: Str, mode: Int) -> Fs
/// The contents of the file in a list of one, or empty with the status set.
fn fs_read(path: Str) -> List[Bytes]
/// 0, or FsErr's tag plus one of the last operation's error.
fn fs_status() -> Int
/// The path and the message of the last error.
fn fs_msg() -> List[Str]
/// Stats p (following a symbolic link when follow) for fs_info.
fn fs_stat(p: Str, follow: Bool, x: Str) -> Int
/// 0 is_dir (0 or 1), 1 size, 2 modified (Unix nanoseconds).
fn fs_info(which: Int) -> Int
/// The entries of directory p, in no order.
fn fs_names(p: Str, x: Str) -> List[Str]
fn fs_write(p: Str, data: Bytes, x: Str) -> Int
fn fs_rename(a: Str, b: Str, x: Str) -> Int
fn fs_remove(p: Str, x: Str) -> Int
fn fs_remove_all(p: Str, x: Str) -> Int
fn fs_mkdir_all(p: Str, x: Str) -> Int
fn fs_chtimes(p: Str, t: Int, x: Str) -> Int
/// The base name of a new empty file in dir, "" with the status set.
fn fs_create_temp(dir: Str, prefix: Str, x: Str) -> Str
fn fs_cwd() -> Str
/// The system calls under std/native/llrt/fspath.xo (decision 0193 step
/// 6): 0 or the errno; fs_remove_all, fs_mkdir_all, fs_create_temp, and
/// fs_cwd above are its C path (XO_LLRT_C=fspath).
fn fs_raw_mkdir(p: Str) -> Int
fn fs_raw_rmdir(p: Str) -> Int
fn fs_raw_unlink(p: Str) -> Int
/// 1 a directory, 0 another file, minus the errno.
fn fs_raw_kind(p: Str, follow: Bool) -> Int
/// The entries of directory p; fs_raw_errno tells whether it was read.
fn fs_raw_names(p: Str) -> List[Str]
fn fs_raw_errno() -> Int
/// Creates the file p (O_EXCL, 0600).
fn fs_raw_create(p: Str) -> Int
/// A random number below 2^32.
fn fs_raw_rand() -> Int
/// The working directory as the system gives it.
fn fs_raw_getcwd() -> Str
/// Records err (0: success) for the Xo path x: the operation's status.
fn fs_raw_fail(err: Int, x: Str) -> Int
fn fs_case_sensitive() -> Bool
/// Whether an Fs operation reports Canceled (not in deferred code).
fn fs_canceled() -> Bool
/// File handles, copies, modes, links, and locks (decisions 0163, 0172):
/// a handle of the C runtime; the status as for the other operations.
struct FsFile {}
/// Opens p: mode 0 for reading, 1 created or truncated, 2 appended to.
fn fs_open(p: Str, mode: Int, x: Str) -> FsFile
fn fs_file_closed(f: FsFile) -> Bool
/// At most max bytes in a list of one, or the empty list at the end.
fn fs_file_read(f: FsFile, max: Int, x: Str) -> List[Bytes]
/// A line without \n or \r\n in a list of one, or the empty list.
fn fs_file_read_line(f: FsFile, x: Str) -> List[Str]
fn fs_file_write(f: FsFile, data: Bytes, x: Str) -> Int
fn fs_file_close(f: FsFile, x: Str) -> Int
/// a into b with a's permission bits; errors name xa or xb (fs_msg).
fn fs_copy(a: Str, b: Str, xa: Str, xb: Str) -> Int
/// The permission bits of p, or -1.
fn fs_perm(p: Str, x: Str) -> Int
fn fs_chmod(p: Str, mode: Int, x: Str) -> Int
fn fs_symlink(target: Str, p: Str, x: Str) -> Int
/// The target of the link p in a list of one; empty when p is not a link.
fn fs_read_link(p: Str, x: Str) -> List[Str]
/// A held flock(2) lock of p (created if missing), waiting when wait (a
/// cancellation point: status 8); fs_lock_held tells whether it holds.
struct FsLock {}
fn fs_lock(p: Str, wait: Bool, x: Str) -> FsLock
fn fs_lock_held(l: FsLock) -> Bool
fn fs_unlock(l: FsLock)
/// A Time of Unix nanoseconds, and back (both lowered as Int).
fn time_of(ns: Int) -> Time
fn time_ns(t: Time) -> Int

// ---------------------------------------------------------------------------
// Processes (decision 0107)

/// Runs cmd with args: the status ("0" ran, "1" not found, "2" an error,
/// "3" canceled), the exit code in decimal or the error's message, and
/// when it ran standard output and error.
fn proc_run(cmd: Str, args: List[Str]) -> List[Str]
/// FakeProc.on_run: a later run of cmd in the test gives these outputs.
fn proc_on_run(cmd: Str, code: Int, stdout: Bytes, stderr: Bytes)
/// Proc.kill (decision 0190): sends signal number sig of the list HUP,
/// INT, QUIT, KILL, TERM, USR1, USR2, CONT, STOP to pid; the empty list,
/// or the error's message. A test's FakeProc records it instead.
fn proc_kill(pid: Int, sig: Int) -> List[Str]
/// FakeProc.killed: the signals proc_kill recorded, as "NAME PID".
fn proc_killed() -> List[Str]

// Commands, children, and pipelines (decisions 0161 and 0172). A command
// is a spec (std/native/prelude.xo cmd_spec): name, dir, flags (1 env set,
// 2 inherit, 4 merge_stderr), the count of args and the args, the count
// of env entries and the entries, the count of set_env entries and the
// entries. An outcome is a list whose first element is the status: "0"
// done (then the values), "e" the end of a stream, "1" not found (the
// command), "2" an error (the message), "3" canceled.

/// A started command (Child): a handle of the C runtime.
struct ProcChild {}
/// Runs the specs (mode 0 output, 1 on the terminal, 2 a pipeline of all
/// of them) with input as the first one's standard input when has_input:
/// "0", the status, standard output, standard error.
fn proc_exec(specs: List[Str], input: Bytes, has_input: Bool, mode: Int) -> List[Str]
/// The program's environment as exec passes it on, and the working
/// directory (std/native/llrt/procspec.xo, decision 0193 step 6).
fn proc_environ() -> List[Str]
fn proc_getcwd() -> Str
/// Starts the command; proc_child_start tells how that went.
fn proc_spawn(spec: List[Str], input: Bytes, has_input: Bool) -> ProcChild
fn proc_child_start(c: ProcChild) -> List[Str]
fn proc_child_pid(c: ProcChild) -> Int
fn proc_child_write(c: ProcChild, data: Bytes) -> List[Str]
fn proc_child_close_stdin(c: ProcChild)
/// At most max bytes of the output (or the error stream): "0" and the
/// bytes, or "e" at the end.
fn proc_child_read(c: ProcChild, err: Bool, max: Int) -> List[Str]
fn proc_child_read_line(c: ProcChild) -> List[Str]
/// "0" and the exit status.
fn proc_child_wait(c: ProcChild) -> List[Str]
fn proc_child_kill(c: ProcChild)

// ---------------------------------------------------------------------------
// The environment (decision 0172)

/// The attenuation lists of a Proc or Env, and the Proc or Env of lists
/// (lowered by internal/ssa).
fn proc_lists(p: Proc) -> Str
fn proc_new(lists: Str) -> Proc
/// The attenuation lists of a Net, and the Net of lists (decision 0175).
fn net_lists(n: Net) -> Str
fn net_new(lists: Str) -> Net
/// Whether the attenuation lists of a Net admit host and port (std/rt
/// attenuate.go onlyNet.admits; the C runtime's net_admits).
fn net_admits(lists: Str, host: Str, port: Str) -> Bool
fn env_lists(e: Env) -> Str
fn env_new(lists: Str) -> Env
/// The value of the variable in a list of one, or the empty list.
fn env_get(name: Str) -> List[Str]
/// The NAME=VALUE entries of the environment: os.Environ() sorted, or a
/// test's FakeEnv in the order of its variables.
fn env_vars() -> List[Str]

// ---------------------------------------------------------------------------
// Standard streams (decision 0102)

/// Writes b to standard output (buffered with print and println).
fn print(b: Bytes)
/// A line (all false) or the rest of standard input; stdin_status tells
/// 0 the text, 1 the end of input, 2 an error (stdin_msg), 3 canceled.
fn stdin_read(all: Bool) -> Str
fn stdin_status() -> Int
/// At most max bytes of standard input (decision 0162); stdin_status
/// tells as for stdin_read.
fn stdin_read_bytes(max: Int) -> Bytes
/// Whether descriptor fd is a terminal (never in a test binary).
fn isatty(fd: Int) -> Bool
/// The columns of the terminal on standard output, error, or input, or 0.
fn term_width() -> Int
/// Turns standard input's echo off (false; true when it was a terminal)
/// or restores it (true).
fn stdin_echo(on: Bool) -> Bool
fn stdin_msg() -> Str
