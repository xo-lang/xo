// std/trace on the native backends and, through std/go_compiled.txt, the
// Go backend (decisions 0312 and 0325): one source.
use std/http
use std/trace

fn ring(cap: Int = 1000) -> trace.Ring {
  trace.Ring{buf: Mutex[List[trace.Span]].new([]), cap: if cap < 1 { 1 } else { cap }}
}

fn key() -> http.Key[Str] {
  http.key("xo.request_id")
}

fn id(req: http.Request) -> Str {
  req.value(key()) ?? ""
}

/// 1 to 64 printable ASCII characters, no spaces.
fn valid_id(s: Str) -> Bool {
  if s.is_empty() || s.len() > 64 {
    return false
  }
  for c in s.bytes() {
    if Int(c) <= 32 || Int(c) >= 127 {
      return false
    }
  }
  true
}

fn ring_record(r: trace.Ring, id: Str, name: Str, start: Time, d: Duration) {
  push(r, trace.Span{id: id, name: name, start_ms: start.unix_millis(), micros: d.nanos() / 1000, status: 0})
}

// The list grows to twice the cap before it drops its oldest half, so a
// push copies cap spans once per cap pushes instead of on every push past
// the cap; ring_spans reads only the newest cap. The trim comes before the
// push: a write followed by a fault point inside a with keeps the old list
// alive for the rollback, so the push would copy the list.
fn push(r: trace.Ring, s: trace.Span) {
  let cap = r.cap
  r.buf.with(fn(var l: List[trace.Span]) {
    if l.len() >= 2 * cap {
      l = l[l.len() - cap + 1..]
    }
    l.push(s)
  })
}

fn ring_middleware(r: trace.Ring, rand: Rand, clock: Clock) -> fn(http.Request, http.Next) -> http.Response uses (rand, clock) {
  fn(req, next) -> http.Response {
    let given = req.header("X-Request-Id") ?? ""
    let rid = if valid_id(given) { given } else { rand.bytes(8).to_hex() }
    let t0 = clock.now()
    var resp = next(req.with_value(key(), rid))
    let d = clock.since(t0)
    push(r, trace.Span{id: rid, name: "request", start_ms: t0.unix_millis(), micros: d.nanos() / 1000, status: resp.status})
    resp.headers.put("X-Request-Id", rid)
    resp
  }
}

fn ring_spans(r: trace.Ring, min: Duration, n: Int) -> List[trace.Span] {
  let all = r.buf.with_read(fn(l: List[trace.Span]) -> List[trace.Span] { l })
  var out: List[trace.Span] = []
  var i = all.len()
  let first = if all.len() > r.cap { all.len() - r.cap } else { 0 }
  while i > first {
    i -= 1
    let s = all[i]
    if s.micros * 1000 >= min.nanos() {
      out.push(s)
      if n > 0 && out.len() >= n {
        break
      }
    }
  }
  out
}

fn ring_handler(r: trace.Ring, auth: fn(http.Request) -> Bool) -> fn(http.Request) -> http.Response {
  fn(req) -> http.Response {
    if !auth(req) {
      return http.text(403, "forbidden\n")
    }
    let slow = Int.parse(req.query("slow") ?? "") ?? 0
    let n = Int.parse(req.query("n") ?? "") ?? 100
    http.json(200, ring_spans(r, Duration.from_millis(slow), n))
  }
}

// ---------------------------------------------------------------------------
// Recorder and Active (decision 0580)

/// Unix nanoseconds of an instant.
fn unix_nanos(t: Time) -> Int {
  let s = t.unix()
  s * 1000000000 + (t - Time.from_unix(s)).nanos()
}

fn recorder(ring: trace.Ring, clock: Clock, rand: Rand) -> trace.Recorder {
  trace.Recorder{ring: ring, clock: clock, rand: rand}
}

/// n random bytes as hex, never all zero.
fn rand_hex(rand: Rand, n: Int) -> Str {
  var b = rand.bytes(n)
  var zero = true
  for c in b {
    if c != 0 {
      zero = false
    }
  }
  if zero {
    b = rand.bytes(n)
    if b[0] == 0 && b[n - 1] == 0 {
      return "0".repeat(2 * n - 1) + "1"
    }
  }
  b.to_hex()
}

fn recorder_start(r: trace.Recorder, name: Str, parent: (Str, Str)?, kind: trace.SpanKind, attributes: List[trace.Attr], scope: Str, scope_version: Str, schema_url: Str) -> trace.Active uses (clock, rand) {
  let t = r.clock.now()
  let ns = unix_nanos(t)
  var tid = ""
  var pid = "root"
  match parent {
    Some((pt, ps)) => {
      tid = pt
      pid = ps
    }
    None => {
      tid = rand_hex(r.rand, 16)
    }
  }
  let s = trace.Span{
    id: tid, name: name, start_ms: ns / 1000000, micros: 0, status: 0,
    trace_id: tid, span_id: rand_hex(r.rand, 8), parent_id: pid, kind: Some(kind),
    attributes: merge_attrs([], attributes), start_ns: ns, end_ns: ns, scope: scope, scope_version: scope_version, schema_url: schema_url,
  }
  trace.Active{ring: r.ring, clock: r.clock, span: Mutex[trace.Span].new(s), done: Mutex[Bool].new(false)}
}

fn active_ids(a: trace.Active) -> (Str, Str) {
  a.span.with_read(fn(s: trace.Span) -> (Str, Str) { (s.trace_id, s.span_id) })
}

/// attrs merged into base: a key already there takes the new value in place.
fn merge_attrs(base: List[trace.Attr], attrs: List[trace.Attr]) -> List[trace.Attr] {
  var out = base
  for a in attrs {
    var at = -1
    for (i, o) in out.indexed() {
      if o.key == a.key {
        at = i
      }
    }
    if at >= 0 {
      out[at] = a
    } else {
      out.push(a)
    }
  }
  out
}

fn active_set_attributes(a: trace.Active, attrs: List[trace.Attr]) {
  a.span.with(fn(var s: trace.Span) {
    s = s with {attributes: merge_attrs(s.attributes, attrs)}
  })
}

fn active_add_event(a: trace.Active, name: Str, attributes: List[trace.Attr]) uses clock {
  let ns = unix_nanos(a.clock.now())
  a.span.with(fn(var s: trace.Span) {
    var ev = s.events
    ev.push(trace.Event{name: name, time_ns: ns, attributes: attributes})
    s = s with {events: ev}
  })
}

/// OpenTelemetry Go's SetStatus: Unset changes nothing, Ok is final and drops its description, Error keeps the last message
/// (until an Ok).
fn span_set_status(s: trace.Span, code: trace.StatusCode, message: Str) -> trace.Span {
  if s.status_code == Some(trace.StatusCode.Ok) {
    return s
  }
  match code {
    trace.StatusCode.Unset => s
    trace.StatusCode.Ok => s with {status_code: Some(code), status_message: ""}
    trace.StatusCode.Error => s with {status_code: Some(code), status_message: message}
  }
}

fn active_set_status(a: trace.Active, code: trace.StatusCode, message: Str) {
  a.span.with(fn(var s: trace.Span) {
    s = span_set_status(s, code, message)
  })
}

fn active_end(a: trace.Active) uses clock {
  let first = a.done.with(fn(var d: Bool) -> Bool {
    if d {
      return false
    }
    d = true
    true
  })
  if !first {
    return
  }
  let ns = unix_nanos(a.clock.now())
  let s = a.span.with(fn(var s: trace.Span) -> trace.Span {
    let end = if ns < s.start_ns { s.start_ns } else { ns }
    s = s with {end_ns: end, micros: (end - s.start_ns) / 1000}
    s
  })
  push(a.ring, s)
}
