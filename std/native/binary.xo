// std/binary on the native backends (decision 0279): Go's
// encoding/binary byte orders (ByteOrder's Put and Uint methods) and
// varints (varint.go of go1.26: AppendUvarint, AppendVarint, Uvarint,
// Varint), ported.
use native/llrt/raw
use native/rt

// The fixed size forms store and load the word in place (little endian
// machines and wasm: raw memory is little endian), one allocation of the
// right size and no per byte checks; a big endian value is byte swapped
// first.

fn check_at(b: Bytes, at: Int, size: Int) {
  if at < 0 || at + size > b.len() {
    fault("binary: ${size} bytes at ${at} out of range for Bytes of length ${b.len()}")
  }
}

fn swap16(n: Int) -> Int { ((n & 255) << 8) | ((n >> 8) & 255) }

fn swap32(n: Int) -> Int { (swap16(n) << 16) | swap16(n >> 16) }

fn swap64(n: Int) -> Int { swap32(n).wrapping_shl(32) | swap32(n.shr_logical(32)) }

fn u16_le(n: Int) -> Bytes {
  let b = raw.bytes_buf(2)
  rt.mem_store(raw.bytes_addr(b), 0, n, 2)
  b
}

fn u32_le(n: Int) -> Bytes {
  let b = raw.bytes_buf(4)
  rt.mem_store(raw.bytes_addr(b), 0, n, 4)
  b
}

fn u64_le(n: Int) -> Bytes {
  let b = raw.bytes_buf(8)
  rt.mem_store(raw.bytes_addr(b), 0, n, 8)
  b
}

fn u16_be(n: Int) -> Bytes { u16_le(swap16(n)) }
fn u32_be(n: Int) -> Bytes { u32_le(swap32(n)) }
fn u64_be(n: Int) -> Bytes { u64_le(swap64(n)) }

fn get_u16_le(b: Bytes, at: Int) -> Int {
  check_at(b, at, 2)
  rt.mem_load(raw.bytes_addr(b), at, 2)
}

fn get_u32_le(b: Bytes, at: Int) -> Int {
  check_at(b, at, 4)
  rt.mem_load(raw.bytes_addr(b), at, 4)
}

fn get_u64_le(b: Bytes, at: Int) -> Int {
  check_at(b, at, 8)
  rt.mem_load(raw.bytes_addr(b), at, 8)
}

fn get_u16_be(b: Bytes, at: Int) -> Int { swap16(get_u16_le(b, at)) }
fn get_u32_be(b: Bytes, at: Int) -> Int { swap32(get_u32_le(b, at)) }
fn get_u64_be(b: Bytes, at: Int) -> Int { swap64(get_u64_le(b, at)) }

fn signed(v: Int, bits: Int) -> Int {
  let top = 1 << (bits - 1)
  if v >= top { v - (top << 1) } else { v }
}


fn get_i16_be(b: Bytes, at: Int) -> Int { signed(get_u16_be(b, at), 16) }
fn get_i32_be(b: Bytes, at: Int) -> Int { signed(get_u32_be(b, at), 32) }
fn get_i16_le(b: Bytes, at: Int) -> Int { signed(get_u16_le(b, at), 16) }
fn get_i32_le(b: Bytes, at: Int) -> Int { signed(get_u32_le(b, at), 32) }

fn uvarint(n: Int) -> Bytes {
  var out = BytesBuilder.with_capacity(10)
  var x = n
  // x as an unsigned word: shr_logical brings in zeros
  while !x.lt_unsigned(128) {
    out.write_byte(UInt8((x & 127) | 128))
    x = x.shr_logical(7)
  }
  out.write_byte(UInt8(x))
  out.freeze()
}

fn varint(n: Int) -> Bytes {
  // zig-zag: (n << 1) ^ (n >> 63)
  uvarint(n.wrapping_shl(1) ^ (n >> 63))
}

/// varint.go Uvarint: at most 10 bytes; the tenth may only be 0 or 1.
fn get_uvarint(b: Bytes, at: Int) -> (Int, Int)? {
  if at < 0 {
    return None
  }
  var x = 0
  var s = 0
  var i = 0
  while at + i < b.len() {
    if i == 10 {
      return None
    }
    let c = Int(b[at + i])
    if c < 128 {
      if i == 9 && c > 1 {
        return None
      }
      return Some((x | c.wrapping_shl(s), i + 1))
    }
    x = x | (c & 127).wrapping_shl(s)
    s += 7
    i += 1
  }
  None
}

fn get_varint(b: Bytes, at: Int) -> (Int, Int)? {
  let (ux, n) = get_uvarint(b, at)?
  var x = ux.shr_logical(1)
  if ux & 1 != 0 {
    x = x ^ -1
  }
  Some((x, n))
}
