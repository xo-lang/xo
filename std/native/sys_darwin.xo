// The macOS platform library functions the native runtime calls from Xo
// (decision 0213, decision 0195 prerequisite 3). A declaration file like
// rt.xo, imported only by runtime modules (`use native/sys_darwin`,
// decision 0074): each bodiless function is a call of the libSystem
// symbol of its name with the C ABI. An Int argument is one word (a C
// int, size_t, or pointer: an address made with raw.bytes_addr), a Bytes
// argument the address of its data (kept alive across the call), a
// Float a double; an Int32 result is a C int, sign extended. Parameters
// from the first one named `va_*` on are the variadic arguments of a C
// function, which Apple arm64 passes on the stack. The SSA builders make
// a call for another target OS a fault, so only the macOS arms of
// std/native/llrt/sysio.xo reach these.

/// open(2): the descriptor, or -1 with errno set.
fn open(path: Bytes, flags: Int, va_mode: Int) -> Int32
/// read(2) of at most n bytes to the address buf.
fn read(fd: Int, buf: Int, n: Int) -> Int
/// write(2) of n bytes from the address buf.
fn write(fd: Int, buf: Int, n: Int) -> Int
fn close(fd: Int) -> Int32
/// fsync(2).
fn fsync(fd: Int) -> Int32
/// stat(2) into the struct stat at the address buf (144 bytes): the 64
/// bit inode structure under a plain name on arm64 and x86_64 alike (on
/// x86_64 `stat` is the old structure and the headers call
/// `stat$INODE64`, gotchas/darwin-amd64-stat-inode64.md).
fn stat64(path: Bytes, buf: Int) -> Int32
fn lstat64(path: Bytes, buf: Int) -> Int32
fn fstat64(fd: Int, buf: Int) -> Int32
/// poll(2) of the n struct pollfd at fds, waiting timeout ms
/// (std/native/llrt/stdin.xo).
fn poll(fds: Int, n: Int, timeout: Int) -> Int32
/// isatty(3), ioctl(2) (TIOCGWINSZ into the struct winsize at the
/// address va_arg), tcgetattr(3) and tcsetattr(3) of the struct termios at
/// the address t: standard input's terminal (std/native/llrt/stdin.xo).
fn isatty(fd: Int) -> Int32
fn ioctl(fd: Int, req: Int, va_arg: Int) -> Int32
fn tcgetattr(fd: Int, t: Int) -> Int32
fn tcsetattr(fd: Int, act: Int, t: Int) -> Int32
/// clock_gettime(3) into the struct timespec at the address ts.
fn clock_gettime(clock: Int, ts: Int) -> Int32
/// getentropy(2): n (at most 256) random bytes to the address buf.
fn getentropy(buf: Int, n: Int) -> Int32
/// exit(3): ends the process with status code (atexit handlers run).
fn exit(code: Int)
/// The address of the calling thread's errno (a C int).
fn __error() -> Int
/// sysctlbyname(3): the value of the zero terminated name into the
/// buffer at oldp (its length at oldlenp, a size_t); 0, or -1 with errno.
fn sysctlbyname(name: Bytes, oldp: Int, oldlenp: Int, newp: Int, newlen: Int) -> Int32
/// clock_gettime_nsec_np(3): the clock's time in nanoseconds (a uint64_t),
/// 0 with errno set on failure.
fn clock_gettime_nsec_np(clock: Int) -> Int

// The Fs operations of std/native/llrt/fsops.xo (work item B16): paths
// are zero terminated Bytes; a result of -1 (or a NULL pointer) sets
// errno. On x86_64 the stat and dirent functions are the `$INODE64`
// symbols (gotchas/darwin-amd64-stat-inode64.md): darwin/amd64 does not
// call these.

/// clonefile(2): a copy-on-write copy of from at to (APFS, one volume), which
/// must not exist.
fn clonefile(from: Bytes, to: Bytes, flags: Int) -> Int32
fn rename(from: Bytes, to: Bytes) -> Int32
fn unlink(path: Bytes) -> Int32
fn rmdir(path: Bytes) -> Int32
fn mkdir(path: Bytes, mode: Int) -> Int32
fn chmod(path: Bytes, mode: Int) -> Int32
fn symlink(target: Bytes, path: Bytes) -> Int32
/// readlink(2) of at most n bytes to the address buf: the count.
fn readlink(path: Bytes, buf: Int, n: Int) -> Int
/// utimensat(2) with the two struct timespec at the address ts.
fn utimensat(fd: Int, path: Bytes, ts: Int, flags: Int) -> Int32
/// getcwd(3) into n bytes at the address buf: buf, or 0.
fn getcwd(buf: Int, n: Int) -> Int
/// kill(2): 0, or -1 with errno set (std/native/llrt/proc.xo).
fn kill(pid: Int, sig: Int) -> Int32
/// access(2): 0, or -1 with errno set.
fn access(path: Int, mode: Int) -> Int32
/// pipe(2) into the two C ints at the address fds.
fn pipe(fds: Int) -> Int32
/// waitpid(2) with the status as a C int at the address st.
fn waitpid(pid: Int, st: Int, options: Int) -> Int32
// posix_spawn(2) and its file actions and attributes (std/native/llrt/
// proc.xo): posix_spawn_file_actions_t and posix_spawnattr_t are one
// pointer each, a sigset_t 4 bytes; each returns 0 or an errno.
fn posix_spawn(pid: Int, path: Int, fa: Int, at: Int, argv: Int, envp: Int) -> Int32
fn posix_spawn_file_actions_init(fa: Int) -> Int32
fn posix_spawn_file_actions_destroy(fa: Int) -> Int32
fn posix_spawn_file_actions_addopen(fa: Int, fd: Int, path: Int, oflag: Int, mode: Int) -> Int32
fn posix_spawn_file_actions_adddup2(fa: Int, fd: Int, newfd: Int) -> Int32
fn posix_spawn_file_actions_addinherit_np(fa: Int, fd: Int) -> Int32
fn posix_spawn_file_actions_addchdir_np(fa: Int, path: Int) -> Int32
fn posix_spawnattr_init(at: Int) -> Int32
fn posix_spawnattr_destroy(at: Int) -> Int32
fn posix_spawnattr_setflags(at: Int, flags: Int) -> Int32
fn posix_spawnattr_setsigmask(at: Int, set: Int) -> Int32
fn posix_spawnattr_setsigdefault(at: Int, set: Int) -> Int32
fn flock(fd: Int, op: Int) -> Int32
/// __getdirentries64 (what readdir(3) calls): the next entries of the
/// directory fd as struct dirent (64 bit inodes) records into n bytes at
/// the address buf, 0 at the end, or -1; the position goes to the int64
/// at base. readdir and opendir are `$INODE64` symbols on x86_64.
fn __getdirentries64(fd: Int, buf: Int, n: Int, base: Int) -> Int

// The scheduler's platform calls (decision 0212 stage 2,
// std/native/llrt/pool.xo): fiber stacks, the futex style waits of the
// runtime's locks, and worker threads.

/// mmap(2): the address, or MAP_FAILED (-1) with errno set.
fn mmap(addr: Int, len: Int, prot: Int, flags: Int, fd: Int, off: Int) -> Int
fn mprotect(addr: Int, len: Int, prot: Int) -> Int32
/// madvise(2): MADV_FREE (5) lets the kernel take the pages of an anonymous
/// mapping back when it needs them.
fn madvise(addr: Int, len: Int, advice: Int) -> Int32
/// kqueue(2): a new kernel event queue, or -1.
fn kqueue() -> Int32
/// kevent(2): apply nchanges changes and collect at most nevents events
/// (struct kevent, 32 bytes) into events, waiting at most the struct
/// timespec at timeout (0: no limit): the events, or -1.
fn kevent(kq: Int, changes: Int, nchanges: Int, events: Int, nevents: Int, timeout: Int) -> Int32
fn munmap(addr: Int, len: Int) -> Int32
/// __ulock_wait (libSystem's futex, what libc++'s std::atomic::wait
/// calls): sleeps while the 32 bit word at addr holds value.
fn __ulock_wait(op: Int, addr: Int, value: Int, timeout_us: Int) -> Int32
/// __ulock_wake: wakes a thread sleeping on the word at addr.
fn __ulock_wake(op: Int, addr: Int, wake_value: Int) -> Int32
/// The POSIX threads calls of a worker thread's start: the attributes
/// object (64 bytes) and the thread id at addresses.
fn pthread_attr_init(attr: Int) -> Int32
fn pthread_attr_setstacksize(attr: Int, n: Int) -> Int32
fn pthread_attr_setdetachstate(attr: Int, state: Int) -> Int32
fn pthread_attr_destroy(attr: Int) -> Int32
/// pthread_create: the thread runs the C function at f with arg.
fn pthread_create(tid: Int, attr: Int, f: Int, arg: Int) -> Int32
/// pthread_self, pthread_kill, and pthread_sigmask (how: SIG_BLOCK 1,
/// SIG_UNBLOCK 2, SIG_SETMASK 3; a 4 byte set): asynchronous preemption's
/// signal (std/native/llrt/pool.xo, decision 0318).
fn pthread_self() -> Int
fn pthread_kill(t: Int, sig: Int) -> Int32
fn pthread_sigmask(how: Int, set: Int, old: Int) -> Int32
/// pthread_join: waits for the thread tid to end (ret: 0, its result not
/// kept).
fn pthread_join(tid: Int, ret: Int) -> Int32

// The image lookups of std/native/llrt/unwind.xo's compact unwind
// walker (decision 0221 stage 3, macOS).

/// The Mach-O header of loaded image i (0: the program), or 0.
fn _dyld_get_image_header(i: Int) -> Int
/// dladdr(3): fills the Dl_info at info (dli_fbase, the header of the
/// image holding addr, at 8); 0 when no image holds it.
fn dladdr(addr: Int, info: Int) -> Int32

// The network (the zero-C audit's B23, std/native/llrt/sock.xo's darwin
// arms): addresses are Ints (struct sockaddr and the C's buffers); a
// result of -1 sets errno.

fn socket(domain: Int, ty: Int, proto: Int) -> Int32
fn bind(fd: Int, sa: Int, n: Int) -> Int32
fn listen(fd: Int, backlog: Int) -> Int32
fn accept(fd: Int, sa: Int, lenp: Int) -> Int32
fn connect(fd: Int, sa: Int, n: Int) -> Int32
fn getsockname(fd: Int, sa: Int, lenp: Int) -> Int32
fn getpeername(fd: Int, sa: Int, lenp: Int) -> Int32
fn send(fd: Int, buf: Int, n: Int, flags: Int) -> Int
fn recv(fd: Int, buf: Int, n: Int, flags: Int) -> Int
/// sendto(2) and recvfrom(2) with an address (std/udp, decision 0406).
fn sendto(fd: Int, buf: Int, n: Int, flags: Int, to: Int, tolen: Int) -> Int
fn recvfrom(fd: Int, buf: Int, n: Int, flags: Int, from: Int, fromlenp: Int) -> Int
fn setsockopt(fd: Int, level: Int, opt: Int, v: Int, n: Int) -> Int32
fn getsockopt(fd: Int, level: Int, opt: Int, v: Int, lenp: Int) -> Int32
fn shutdown(fd: Int, how: Int) -> Int32
/// fcntl(2) with an int argument (variadic: on the stack on Apple arm64).
fn fcntl(fd: Int, cmd: Int, va_arg: Int) -> Int32
/// getaddrinfo(3) of the zero terminated host (0: none) and service with
/// the struct addrinfo hints: 0 with the list at the word at res, or an
/// EAI code.
fn getaddrinfo(host: Int, serv: Int, hints: Int, res: Int) -> Int32
fn freeaddrinfo(ai: Int)
/// gai_strerror(3): a zero terminated text.
fn gai_strerror(code: Int) -> Int
/// getpid(2) (std/native/llrt/prof.xo).
fn getpid() -> Int32
/// getppid(2) (std/native/llrt/procid.xo).
fn getppid() -> Int32

/// gethostname(3) into n bytes at the address buf: 0, or -1 (std/native/llrt/host.xo).
fn gethostname(buf: Int, n: Int) -> Int32

/// setitimer(2): which (ITIMER_PROF 2), the struct itimerval at new and
/// old (or 0): 0, or -1 with errno set (std/native/llrt/prof.xo).
fn setitimer(which: Int, new: Int, old: Int) -> Int32

// The Mach calls of the CPU profile's sampler thread
// (std/native/llrt/prof.xo, mac_sampler): ports are 32 bit names in an
// Int; a result is a kern_return_t, 0 on success.

/// task_self_trap: this task's port (mach_task_self()'s value).
fn task_self_trap() -> Int32
/// mach_thread_self: the calling thread's port (a new reference).
fn mach_thread_self() -> Int32
/// task_threads: the task's threads, an array of ports the kernel maps
/// (its address at the word at list, its count at the 32 bit word at n).
fn task_threads(task: Int, list: Int, n: Int) -> Int32
/// thread_info of the flavor into the words at info (in: their count at
/// the 32 bit word at n).
fn thread_info(t: Int, flavor: Int, info: Int, n: Int) -> Int32
fn thread_suspend(t: Int) -> Int32
fn thread_resume(t: Int) -> Int32
/// thread_get_state of the flavor into the words at state (in: their
/// count at the 32 bit word at n).
fn thread_get_state(t: Int, flavor: Int, state: Int, n: Int) -> Int32
/// Drops a reference to the port name.
fn mach_port_deallocate(task: Int, name: Int) -> Int32
/// Unmaps n bytes at addr from the task (task_threads' array).
fn vm_deallocate(task: Int, addr: Int, n: Int) -> Int32

/// sigaltstack(2) with the stack_t at ss (ss_sp, ss_size, ss_flags) and
/// old (or 0): 0, or -1 with errno set (std/native/llrt/crash.xo).
fn sigaltstack(ss: Int, old: Int) -> Int32
/// usleep(3) for us microseconds.
fn usleep(us: Int) -> Int32

/// sigaction(2) with the struct sigaction at the address act (the
/// handler, the mask's 4 bytes, the flags' 4) and old (or 0): 0, or -1
/// with errno set (std/native/llrt/entry.xo).
fn sigaction(sig: Int, act: Int, old: Int) -> Int32

/// dlsym(3): the address of a symbol (RTLD_DEFAULT, -2: any image
/// loaded), 0 when none has it (std/native/llrt/tlscert.xo: CoreFoundation's
/// kCFTypeArrayCallBacks, a data symbol).
fn dlsym(handle: Int, name: Bytes) -> Int
/// dlopen(3): the handle of the image at the NUL terminated path (mode
/// RTLD_LAZY 1 | RTLD_GLOBAL 8), 0 when it cannot be loaded.
fn dlopen(path: Bytes, mode: Int) -> Int
