test "values keep first appearance order and replace with set" {
  var v = values()
  v.add("b", "1")
  v.add("a", "2")
  v.add("b", "3")
  expect(v.keys()) == ["b", "a"]
  expect(v.all("b")) == ["1", "3"]
  expect(v.get("b")) == Some("1")
  expect(v.get("c")) == None
  v.set("b", "x")
  expect(v.all("b")) == ["x"]
  v.remove("b")
  expect(v.has("b")) == false
  expect(v.encode()) == "a=2"
}

test "values are values" {
  var a = values()
  a.add("k", "1")
  var b = a
  b.add("k", "2")
  expect(a.all("k")) == ["1"]
  expect(b.all("k")) == ["1", "2"]
}

test "invalid UTF-8 stays escaped" {
  expect(query_unescape("a%82b")) == Ok("a%82b")
  expect(query_unescape("%E2%82%AC+x")) == Ok("\u{20AC} x")
  expect(path_unescape("%C3%A9%2F")) == Ok("\u{E9}/")
}

test "the parameter limit" {
  expect(parse_query("a=1&".repeat(10000)).is_ok()) == false
  expect(parse_query("a=1&".repeat(9999) + "a=1").map(fn(v) { v.all("a").len() })) == Ok(10000)
}

test "encode round trips" for pairs: List[(Str, Str)] {
  var v = values()
  for (k, x) in pairs {
    v.add(k, x)
  }
  let back = parse_query(v.encode()).or_fault("encode output parses")
  for k in v.keys() {
    if !k.is_empty() || !v.all(k).is_empty() {
      expect(back.all(k)) == v.all(k)
    }
  }
}
