test "encode 39" {
  var v = values()
  expect(v.encode()) == h("")
}

test "encode 40" {
  var v = values()
  expect(v.encode()) == h("")
}

test "encode 41" {
  var v = values()
  v.add(h("6f65"), h("75746638"))
  v.add(h("71"), h("70757070696573"))
  expect(v.encode()) == h("6f653d7574663826713d70757070696573")
}

test "encode 42" {
  var v = values()
  v.add(h("71"), h("646f6773"))
  v.add(h("71"), h("26"))
  v.add(h("71"), h("37"))
  expect(v.encode()) == h("713d646f677326713d25323626713d37")
}

test "encode 43" {
  var v = values()
  v.add(h("61"), h("6131"))
  v.add(h("61"), h("6132"))
  v.add(h("61"), h("6133"))
  v.add(h("62"), h("6231"))
  v.add(h("62"), h("6232"))
  v.add(h("62"), h("6233"))
  v.add(h("63"), h("6331"))
  v.add(h("63"), h("6332"))
  v.add(h("63"), h("6333"))
  expect(v.encode()) == h("613d613126613d613226613d613326623d623126623d623226623d623326633d633126633d633226633d6333")
}

test "encode 44" {
  var v = values()
  v.add(h("61"), h("61"))
  v.add(h("62"), h("62"))
  v.add(h("63"), h("63"))
  v.add(h("64"), h("64"))
  v.add(h("65"), h("65"))
  v.add(h("66"), h("66"))
  v.add(h("67"), h("67"))
  v.add(h("68"), h("68"))
  v.add(h("69"), h("69"))
  expect(v.encode()) == h("613d6126623d6226633d6326643d6426653d6526663d6626673d6726683d6826693d69")
}

test "parse 45" {
  expect(parse_query(h("613d31")).map(sorted)) == Ok([(h("61"), [h("31")])])
}

test "parse 46" {
  expect(parse_query(h("613d3126623d32")).map(sorted)) == Ok([(h("61"), [h("31")]), (h("62"), [h("32")])])
}

test "parse 47" {
  expect(parse_query(h("613d3126613d3226613d62616e616e61")).map(sorted)) == Ok([(h("61"), [h("31"), h("32"), h("62616e616e61")])])
}

test "parse 48" {
