use std/url

// The escape, query, and Values tables of Go's net/url url_test.go
// (go1.26: unescapeTests, queryEscapeTests, pathEscapeTests,
// encodeQueryTests, parseTests), expected results from Go itself
// (decision 0279). Strings are hex so every byte survives.

fn h(x: Str) -> Str { (Bytes.from_hex(x) ?? b"").to_str() ?? "" }

fn sorted(v: Values) -> List[(Str, List[Str])] { v.keys().sort().map(fn(k) { (k, v.all(k)) }) }

test "query_unescape 1" {
  expect(query_unescape(h(""))) == Ok(h(""))
}

test "path_unescape 2" {
  expect(path_unescape(h(""))) == Ok(h(""))
}

