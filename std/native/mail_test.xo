test "go parse_address" {
  for (input, name, address, text, e) in ONE {
    match parse_address(input) {
      Ok(a) => {
        expect(e) == ""
        expect((a.name, a.address, address_display(a))) == (name, address, text)
      }
      Err(got) => expect(got.msg) == e
    }
  }
}

test "go parse_address_list" {
  for (input, want, e) in LIST {
    match parse_address_list(input) {
      Ok(xs) => {
        expect(e) == ""
        expect(xs.map(fn(a) { (a.name, a.address) })) == want
      }
      Err(got) => expect(got.msg) == e
    }
  }
}

