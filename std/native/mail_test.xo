  ("Tue, 29  Aug 1900  7:45 +1300  ", "-2188271700"),
  ("Tue, 7 Jun 42 20:08 -1159 (MDT)\r\n", "2285827620"),
  ("Xyz, 11 Jul 123 00:60:60 GMT", "err: mail: header could not be parsed"),
  ("Mon 7 jan 1900 17:5 +1300  ", "err: mail: header could not be parsed"),
  ("Tue, 32 Mar 123 0:25:60 MeST", "err: mail: header could not be parsed"),
  ("Mon 29  Feb 123  01:60:53 EST (open", "err: mail: misformatted parenthetical comment"),
  ("Fri,  08 Foo 14 00:60:60 GMT+30 (comment)", "err: mail: header could not be parsed"),
  ("  Mon, 7  Feb 123  24:44:20 Z\r\n", "err: mail: header could not be parsed"),
  ("Fri,  30 Aug 2000 24:5:5 -1159\r\n", "err: mail: header could not be parsed"),
  ("Sun,7 Jun 2023 24:60:29 GMT", "err: mail: header could not be parsed"),
  ("Tue, 30 Jul 2245 24:51:60 ChST (open", "err: mail: misformatted parenthetical comment"),
  ("Tue, 31 NOV 2023 24:5:00 GMT+30 (comment)", "err: mail: header could not be parsed"),
  ("Mon 30 NOV 1784 3:60 -0700", "err: mail: header could not be parsed"),
  ("Sun,17 jan 2023 24:33:29 GMT+30", "err: mail: header could not be parsed"),
  ("Fri,  0 May 123 24:02 +0960 (nested (c))", "err: mail: header could not be parsed"),
  ("  Sun,29 Dec 38 6:45:5 ChST", "err: mail: header could not be parsed"),
]

/// (message, headers sorted by key with values in order, then the body; or the error)
const MSG_CASES: List[(Bytes, Str)] = [
  (b"From: John Doe <jdoe@machine.example>\x0d\x0aTo: Mary Smith <mary@example.net>\x0d\x0aSubject: Saying Hello\x0d\x0aDate: Fri, 21 Nov 1997 09:55:06 -0600\x0d\x0aMessage-ID: <1234@local.machine.example>\x0d\x0a\x0d\x0aThis is a message just to say hello.\x0d\x0aSo, \"Hello\".\x0d\x0a", "Date=Fri, 21 Nov 1997 09:55:06 -0600;From=John Doe <jdoe@machine.example>;Message-Id=<1234@local.machine.example>;Subject=Saying Hello;To=Mary Smith <mary@example.net>;body=This is a message just to say hello.\r\nSo, \"Hello\".\r\n"),
  (b"From: =?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>\x0aSubject: hi\x0a\x0abody\x0a", "From==?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>;Subject=hi;body=body\n"),
  (b"Subject: a\x0d\x0a folded\x0d\x0a\x09line\x0d\x0aX-Empty:\x0d\x0ax-lower: v\x0d\x0aX-Dup: 1\x0d\x0aX-Dup: 2\x0d\x0a\x0d\x0a", "Subject=a folded line;X-Dup=1|2;X-Empty=;X-Lower=v;body="),
  (b"Subject: trailing spaces   \x0d\x0a\x0d\x0ab", "Subject=trailing spaces;body=b"),
  (b" Subject: starts with space\x0d\x0a\x0d\x0a", "err: malformed initial line:  Subject: starts with space"),
  (b"NoColon\x0d\x0a\x0d\x0a", "err: malformed header line: NoColon"),
  (b"Bad Key: v\x0d\x0a\x0d\x0a", "Bad Key=v;body="),
  (b"Key\x01: v\x0d\x0a\x0d\x0a", "Key\x01=v;body="),
  (b"Key: v\x01\x0d\x0a\x0d\x0a", "Key=v\x01;body="),
  (b"Key: v\x7f\x0d\x0a\x0d\x0a", "Key=v\x7f;body="),
  (b"Key: v\x0d\x0a", "Key=v;body="),
  (b"", "err: EOF"),
  (b"\x0d\x0a", "body="),
  (b"\x0d\x0abody only", "body=body only"),
  (b"Key: v\x0aOther: w\x0a\x0a\x0abody\x0a\x0a", "Key=v;Other=w;body=\nbody\n\n"),
  (b"Key: \xc3\xa9 non-ascii\x0d\x0a\x0d\x0a", "Key=é non-ascii;body="),
  (b"Key: v\x0d\x0a  \x0d\x0a\x0d\x0a", "Key=v ;body="),
  (b"Content-type: text/plain\x0d\x0aCONTENT-LENGTH: 3\x0d\x0a\x0d\x0aabc", "Content-Length=3;Content-Type=text/plain;body=abc"),
  (b"Key:v\x0d\x0a\x0d\x0a", "Key=v;body="),
  (b"Key :v\x0d\x0a\x0d\x0a", "Key =v;body="),
  (b"Key: a\x0d\x0a\x09b\x0d\x0a c\x0d\x0a\x0d\x0a", "Key=a b c;body="),
]

fn shape(m: mail.Message) -> Str {
  var keys: List[Str] = []
  for (k, _) in m.headers {
    if !keys.contains(k) {
      keys.push(k)
    }
  }
  var w = StrBuilder.new()
  for k in keys.sort() {
    let vs = m.headers.filter(fn(h) { h.0 == k }).map(fn(h) { h.1 })
    w.write("${k}=${vs.join("|")};")
  }
  w.write("body=${m.body.to_str() ?? "?"}")
  w.freeze()
}

test "parse_date: Go's results on its test inputs and random dates" {
  for (s, want) in DATE_CASES {
    let got = match parse_date(s) {
      Ok(t) => "${t.unix()}"
      Err(e) => "err: ${e.msg}"
    }
    expect((s, got)) == (s, want)
  }
}

test "read_message: Go's headers, body, and errors" {
  for (m, want) in MSG_CASES {
    let got = match read_message(m) {
      Ok(x) => shape(x)
      Err(e) => "err: ${e.msg}"
    }
    expect((m, got)) == (m, want)
  }
}
