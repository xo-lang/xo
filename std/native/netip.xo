// std/netip on the native backends (decision 0287): Go's net/netip
// (netip.go of go1.26: ParseAddr, parseIPv4Fields, parseIPv6, String,
// ParsePrefix, Prefix.Contains and Masked, the Is predicates), ported
// with the same results and error texts.
use std/netip
use native/rt

fn parseerr_display(e: netip.ParseErr) -> Str { e.msg }

fn addr_err(input: Str, msg: Str, at: Str) -> netip.ParseErr {
  if at.is_empty() {
    return netip.ParseErr{msg: "ParseAddr(${input.quote()}): ${msg}"}
  }
  netip.ParseErr{msg: "ParseAddr(${input.quote()}): ${msg} (at ${at.quote()})"}
}

/// The top bit of a word: flipped in an Addr's stored words so that the
/// derived order of the signed words is the order of the address bytes
/// (the same trick as std/uuid).
const SIGN: Int = -9223372036854775807 - 1

/// The Addr of the words hi and lo (the 16 bytes, the first highest).
fn mk(bits: Int, hi: Int, lo: Int, zone: Str) -> netip.Addr {
  netip.Addr{bits: bits, hi: hi ^ SIGN, lo: lo ^ SIGN, zone: zone}
}

fn hi_of(a: netip.Addr) -> Int { a.hi ^ SIGN }

fn lo_of(a: netip.Addr) -> Int { a.lo ^ SIGN }

/// The IPv4 value (the last 4 bytes) of an address.
fn v4_of(a: netip.Addr) -> Int { (a.lo ^ SIGN) & 4294967295 }

/// x shifted right by n bits, zeros coming in (0 <= n).
fn lsr(x: Int, n: Int) -> Int {
  if n <= 0 {
    return x
  }
  if n >= 64 {
    return 0
  }
  (x >> n) & ((1 << (64 - n)) - 1)
}

/// x shifted left by n bits (0 <= n).
fn shl(x: Int, n: Int) -> Int {
  if n <= 0 {
    return x
  }
  if n >= 64 {
    return 0
  }
  x.wrapping_shl(n)
}

/// The word with its first k bits set (0 <= k <= 64 is clamped).
fn bits_mask(k: Int) -> Int {
  if k <= 0 {
    return 0
  }
  if k >= 64 {
    return -1
  }
  (-1).wrapping_shl(64 - k)
}

/// The 16 bytes of the words hi and lo.
fn words_bytes(hi: Int, lo: Int) -> Bytes {
  var out = BytesBuilder.with_capacity(16)
  for k in 0..8 {
    out.write_byte(UInt8((hi >> (56 - 8 * k)) & 255))
  }
  for k in 0..8 {
    out.write_byte(UInt8((lo >> (56 - 8 * k)) & 255))
  }
  out.freeze()
}

fn word_at(b: Bytes, i: Int) -> Int {
  var w = 0
  for k in 0..8 {
    w = w.wrapping_shl(8) | Int(b[i + k])
  }
  w
}

/// The IPv4 address v (the four octets as an Int), as Go keeps it:
/// ::ffff:a.b.c.d.
fn from4(v: Int) -> netip.Addr { mk(32, 0, 281470681743360 | v, "") }

fn addr_from_bytes(b: Bytes) -> netip.Addr? {
  if b.len() == 4 {
    return Some(from4((Int(b[0]) << 24) | (Int(b[1]) << 16) | (Int(b[2]) << 8) | Int(b[3])))
  }
  if b.len() == 16 {
    return Some(mk(128, word_at(b, 0), word_at(b, 8), ""))
  }
  None
}

/// parseIPv4Fields over input[off..end]: the four octets as an Int (the
/// first highest) or the error.
fn ipv4_fields(input: Str, off: Int, end: Int) -> Int ! netip.ParseErr {
  let s = input.bytes()[off..end]
  var fields = 0
  var val = 0
  var pos = 0
  var dig = 0
  var i = 0
  while i < s.len() {
    let c = s[i]
    if c >= 48 && c <= 57 {
      if dig == 1 && val == 0 {
        return Err(addr_err(input, "IPv4 field has octet with leading zero", ""))
      }
      val = val * 10 + Int(c) - 48
      dig += 1
      if val > 255 {
        return Err(addr_err(input, "IPv4 field has value >255", ""))
      }
    } else if c == 46 {
      if i == 0 || i == s.len() - 1 || s[i - 1] == 46 {
        return Err(addr_err(input, "IPv4 field must have at least one digit", s[i..].to_str() ?? ""))
      }
      if pos == 3 {
        return Err(addr_err(input, "IPv4 address too long", ""))
      }
      fields = (fields << 8) | val
      pos += 1
      val = 0
      dig = 0
    } else {
      return Err(addr_err(input, "unexpected character", s[i..].to_str() ?? ""))
    }
    i += 1
  }
  if pos < 3 {
    return Err(addr_err(input, "IPv4 address too short", ""))
  }
  (fields << 8) | val
}

fn hexval(c: UInt8) -> Int {
  if c >= 48 && c <= 57 { return Int(c) - 48 }
  if c >= 97 && c <= 102 { return Int(c) - 87 }
  if c >= 65 && c <= 70 { return Int(c) - 55 }
  -1
}

/// The text of b from p (an error's `at`).
fn rest_text(b: Bytes, p: Int) -> Str { b[p..].to_str() ?? "" }

fn parse_ipv6(input: Str) -> netip.Addr ! netip.ParseErr {
  var s = input
  var zone = ""
  let ib = input.bytes()
  var pz = 0
  while pz < ib.len() && ib[pz] != 37 {
    pz += 1
  }
  if pz < ib.len() {
    s = input[0..pz]
    zone = input[pz + 1..]
    if zone.is_empty() {
      return Err(addr_err(input, "zone must be a non-empty string", ""))
    }
  }
  // the groups read so far, as the words of the 16 bytes (group g at
  // bits 48 - 16 * (g % 4) of the word g / 4)
  var th = 0
  var tl = 0
  var ellipsis = -1
  let b = s.bytes()
  let n = b.len()
  var p = 0
  if n >= 2 && b[0] == 58 && b[1] == 58 {
    ellipsis = 0
    p = 2
    if p == n {
      return mk(128, 0, 0, zone)
    }
  }
  var i = 0
  while i < 16 {
    var off = 0
    var acc = 0
    while p + off < n {
      let hv = hexval(b[p + off])
      if hv < 0 {
        break
      }
      acc = acc * 16 + hv
      if off > 3 {
        return Err(addr_err(input, "each group must have 4 or less digits", rest_text(b, p)))
      }
      if acc > 65535 {
        return Err(addr_err(input, "IPv6 field has value >=2^16", rest_text(b, p)))
      }
      off += 1
    }
    if off == 0 {
      return Err(addr_err(input, "each colon-separated field must have at least one digit", rest_text(b, p)))
    }
    if p + off < n && b[p + off] == 46 {
      if ellipsis < 0 && i != 12 {
        return Err(addr_err(input, "embedded IPv4 address must replace the final 2 fields of the address", rest_text(b, p)))
      }
      if i + 4 > 16 {
        return Err(addr_err(input, "too many hex fields to fit an embedded IPv4 at the end of the address", rest_text(b, p)))
      }
      var end = input.len()
      if zone.len() > 0 {
        end -= zone.len() + 1
      }
      let f = ipv4_fields(input, end - (n - p), end)?
      let g = i / 2
      if g < 4 {
        th = th | (shl(f >> 16, 48 - 16 * g))
      } else {
        tl = tl | (shl(f >> 16, 48 - 16 * (g - 4)))
      }
      if g + 1 < 4 {
        th = th | (shl(f & 65535, 48 - 16 * (g + 1)))
      } else {
        tl = tl | (shl(f & 65535, 48 - 16 * (g + 1 - 4)))
      }
      p = n
      i += 4
      break
    }
    let g = i / 2
    if g < 4 {
      th = th | shl(acc, 48 - 16 * g)
    } else {
      tl = tl | shl(acc, 48 - 16 * (g - 4))
    }
    i += 2
    p += off
    if p == n {
      break
    }
    if b[p] != 58 {
      return Err(addr_err(input, "unexpected character, want colon", rest_text(b, p)))
    }
    if n - p == 1 {
      return Err(addr_err(input, "colon must be followed by more characters", rest_text(b, p)))
    }
    p += 1
    if b[p] == 58 {
      if ellipsis >= 0 {
        return Err(addr_err(input, "multiple :: in address", rest_text(b, p)))
      }
      ellipsis = i
      p += 1
      if p == n {
        break
      }
    }
  }
  if p < n {
    return Err(addr_err(input, "trailing garbage after address", rest_text(b, p)))
  }
  if i < 16 {
    if ellipsis < 0 {
      return Err(addr_err(input, "address string too short", ""))
    }
    // the groups from the :: on move right by the missing zeros
    let mh = bits_mask(8 * ellipsis)
    let ml = bits_mask(8 * (ellipsis - 8))
    let sh = 8 * (16 - i)
    let th2 = th & (mh ^ -1)
    let tl2 = tl & (ml ^ -1)
    var nh = 0
    var nl = 0
    if sh >= 64 {
      nl = lsr(th2, sh - 64)
    } else {
      nh = lsr(th2, sh)
      nl = lsr(tl2, sh) | shl(th2, 64 - sh)
    }
    return mk(128, (th & mh) | nh, (tl & ml) | nl, zone)
  }
  if ellipsis >= 0 {
    return Err(addr_err(input, "the :: must expand to at least one field of zeros", ""))
  }
  mk(128, th, tl, zone)
}

fn lookup(n: Net, host: Str) -> List[netip.Addr] ! NetErr uses net.dial {
  var out: List[netip.Addr] = []
  for t in n.lookup_host(host)? {
    match parse_addr(t) {
      Ok(a) => out.push(a)
      Err(e) => return Err(NetErr.Io(msg: "lookup ${host}: ${e.msg}"))
    }
  }
  Ok(out)
}

fn parse_addr(s: Str) -> netip.Addr ! netip.ParseErr {
  for c in s.bytes() {
    if c == 46 {
      return Ok(from4(ipv4_fields(s, 0, s.len())?))
    }
    if c == 58 {
      return parse_ipv6(s)
    }
    if c == 37 {
      return Err(addr_err(s, "missing IPv6 address", ""))
    }
  }
  Err(addr_err(s, "unable to parse IP", ""))
}

fn addr_is_4(a: netip.Addr) -> Bool { a.bits == 32 }

fn addr_is_6(a: netip.Addr) -> Bool { a.bits == 128 }

fn addr_is_4in6(a: netip.Addr) -> Bool {
  a.bits == 128 && hi_of(a) == 0 && ((lo_of(a) >> 32) & 4294967295) == 65535
}

fn addr_unmap(a: netip.Addr) -> netip.Addr {
  if addr_is_4in6(a) {
    return netip.Addr{bits: 32, hi: a.hi, lo: a.lo, zone: ""}
  }
  a
}

fn addr_is_loopback(a0: netip.Addr) -> Bool {
  let a = addr_unmap(a0)
  if a.bits == 32 {
    return (v4_of(a) >> 24) == 127
  }
  if a.bits == 128 {
    return hi_of(a) == 0 && lo_of(a) == 1
  }
  false
}

fn addr_is_private(a0: netip.Addr) -> Bool {
  let a = addr_unmap(a0)
  if a.bits == 32 {
    let v = v4_of(a)
    let b0 = v >> 24
    let b1 = (v >> 16) & 255
    return b0 == 10 || (b0 == 172 && (b1 & 240) == 16) || (b0 == 192 && b1 == 168)
  }
  if a.bits == 128 {
    return ((hi_of(a) >> 56) & 254) == 252
  }
  false
}

fn addr_is_unspecified(a: netip.Addr) -> Bool {
  if !a.zone.is_empty() {
    return false
  }
  if a.bits == 32 {
    return v4_of(a) == 0
  }
  if a.bits == 128 {
    return hi_of(a) == 0 && lo_of(a) == 0
  }
  false
}

fn addr_is_link_local_unicast(a0: netip.Addr) -> Bool {
  let a = addr_unmap(a0)
  if a.bits == 32 {
    let v = v4_of(a)
    return (v >> 24) == 169 && ((v >> 16) & 255) == 254
  }
  if a.bits == 128 {
    return ((hi_of(a) >> 54) & 1023) == 1018
  }
  false
}

fn addr_is_multicast(a0: netip.Addr) -> Bool {
  let a = addr_unmap(a0)
  if a.bits == 32 {
    return ((v4_of(a) >> 24) & 240) == 224
  }
  if a.bits == 128 {
    return ((hi_of(a) >> 56) & 255) == 255
  }
  false
}

fn addr_bytes(a: netip.Addr) -> Bytes {
  if a.bits == 32 {
    let v = v4_of(a)
    var out = BytesBuilder.with_capacity(4)
    out.write_byte(UInt8(v >> 24))
    out.write_byte(UInt8((v >> 16) & 255))
    out.write_byte(UInt8((v >> 8) & 255))
    out.write_byte(UInt8(v & 255))
    return out.freeze()
  }
  if a.bits == 128 {
    return words_bytes(hi_of(a), lo_of(a))
  }
  b""
}

/// The octet v (0 to 255) in decimal.
fn write_octet(var out: BytesBuilder, v: Int) {
  if v >= 100 {
    out.write_byte(UInt8(48 + v / 100))
  }
  if v >= 10 {
    out.write_byte(UInt8(48 + v / 10 % 10))
  }
  out.write_byte(UInt8(48 + v % 10))
}

fn string4(v: Int) -> Str {
  var out = BytesBuilder.with_capacity(15)
  write_octet(out, v >> 24)
  out.write_byte(46)
  write_octet(out, (v >> 16) & 255)
  out.write_byte(46)
  write_octet(out, (v >> 8) & 255)
  out.write_byte(46)
  write_octet(out, v & 255)
  // digits, dots, colons, hex and the zone text (a Str): valid
  rt.cast[Bytes, Str](out.freeze())
}

/// Group i (0 to 7) of the words hi and lo.
fn group(hi: Int, lo: Int, i: Int) -> Int {
  if i < 4 {
    return (hi >> (48 - 16 * i)) & 65535
  }
  (lo >> (48 - 16 * (i - 4))) & 65535
}

const HEXD: Bytes = b"0123456789abcdef"

/// v (a group of 16 bits) in lower case hex without leading zeros.
fn write_hex16(var out: BytesBuilder, v: Int) {
  if v >= 4096 {
    out.write_byte(HEXD[v >> 12])
  }
  if v >= 256 {
    out.write_byte(HEXD[(v >> 8) & 15])
  }
  if v >= 16 {
    out.write_byte(HEXD[(v >> 4) & 15])
  }
  out.write_byte(HEXD[v & 15])
}


fn string6(a: netip.Addr) -> Str {
  let hi = hi_of(a)
  let lo = lo_of(a)
  var zs = 255
  var ze = 255
  var i = 0
  while i < 8 {
    var j = i
    while j < 8 && group(hi, lo, j) == 0 {
      j += 1
    }
    let l = j - i
    if l >= 2 && l > ze - zs {
      zs = i
      ze = j
      i = j
    }
    i += 1
  }
  var out = BytesBuilder.with_capacity(40)
  i = 0
  while i < 8 {
    if i == zs {
      out.write_byte(58)
      out.write_byte(58)
      i = ze
      if i >= 8 {
        break
      }
    } else if i > 0 {
      out.write_byte(58)
    }
    write_hex16(out, group(hi, lo, i))
    i += 1
  }
  if !a.zone.is_empty() {
    out.write_byte(37)
    out.write_str(a.zone)
  }
  // digits, dots, colons, hex and the zone text (a Str): valid
  rt.cast[Bytes, Str](out.freeze())
}

fn addr_display(a: netip.Addr) -> Str {
  if a.bits == 0 {
    return "invalid IP"
  }
  if a.bits == 32 {
    return string4(v4_of(a))
  }
  if addr_is_4in6(a) {
    let z = if a.zone.is_empty() { "" } else { "%${a.zone}" }
    return "::ffff:${string4(v4_of(a))}${z}"
  }
  string6(a)
}

fn prefix_err(input: Str, msg: Str) -> netip.ParseErr { netip.ParseErr{msg: "netip.ParsePrefix(${input.quote()}): ${msg}"} }

fn parse_prefix(s: Str) -> netip.Prefix ! netip.ParseErr {
  let b = s.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    i -= 1
  }
  if i < 0 {
    return Err(prefix_err(s, "no '/'"))
  }
  let ip = match parse_addr(s[0..i]) {
    Ok(a) => a
    Err(e) => return Err(prefix_err(s, e.msg))
  }
  if ip.bits == 128 && !ip.zone.is_empty() {
    return Err(prefix_err(s, "IPv6 zones cannot be present in a prefix"))
  }
  let bits_str = s[i + 1..]
  let bb = bits_str.bytes()
  if bb.len() > 1 && (bb[0] < 49 || bb[0] > 57) {
    return Err(prefix_err(s, "bad bits after slash: ${bits_str.quote()}"))
  }
  let n = match Int.parse(bits_str) {
    Some(n) => n
    None => return Err(prefix_err(s, "bad bits after slash: ${bits_str.quote()}"))
  }
  let max = if ip.bits == 128 { 128 } else { 32 }
  if n < 0 || n > max {
    return Err(prefix_err(s, "prefix length out of range"))
  }
  netip.Prefix{addr: ip, len: n}
}


fn prefix_contains(p: netip.Prefix, a: netip.Addr) -> Bool {
  if p.addr.bits == 0 || !a.zone.is_empty() || a.bits == 0 || p.addr.bits != a.bits {
    return false
  }
  let k = if a.bits == 32 { p.len + 96 } else { p.len }
  let m1 = bits_mask(k)
  let m2 = bits_mask(k - 64)
  (hi_of(a) & m1) == (hi_of(p.addr) & m1) && (lo_of(a) & m2) == (lo_of(p.addr) & m2)
}

fn prefix_masked(p: netip.Prefix) -> netip.Prefix {
  if p.addr.bits == 0 {
    return p
  }
  let k = if p.addr.bits == 32 { p.len + 96 } else { p.len }
  netip.Prefix{addr: mk(p.addr.bits, hi_of(p.addr) & bits_mask(k), lo_of(p.addr) & bits_mask(k - 64), ""), len: p.len}
}

fn prefix_display(p: netip.Prefix) -> Str {
  if p.addr.bits == 0 {
    return "invalid Prefix"
  }
  "${addr_display(p.addr)}/${p.len}"
}
