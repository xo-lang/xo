// std/http on the native backends (decision 0074). std/rt/http.go is the
// reference; std/llrt/xo_http.c reads requests and writes responses as
// net/http does.
use std/http
use std/json as js
use std/log
use std/task
use native/llrt/hconn
use native/llrt/hserve
use native/rt
use native/llrt/h2srv
use native/llrt/http1
use native/llrt/srvtls
use native/llrt/tlssrv
use native/llrt/tlsio
use native/llrt/cabi_http
use native/llrt/cabi_net
use native/llrt/netpolicy
use native/llrt/testworld
use native/llrt/twrun
use native/rthttp
use native/llrt/raw

// ---------------------------------------------------------------------------
// Types: the implementations of the std types of the same names

/// http.Request with its route parameters and typed values (hidden from
/// Xo code, as std/rt's XParams and XValues).
struct Request {
  method: Str
  path: Str
  url: http.Url
  headers: Map[Str, Str]
  body: Bytes
  remote_ip: Str
  params: Map[Str, Str] = {}
  values: List[ReqValue] = []
}

struct ReqValue {
  name: Str
  v: rt.Any
}

struct Key[T] {
  key_name: Str
}

struct Route {
  method: Str
  segs: List[Seg]
  h: fn(Request) -> http.Response
}

struct Seg {
  lit: Str
  param: Str
  is_int: Bool
  rest: Bool
}

struct Router {
  routes: List[Route]
  mws: List[fn(Request, fn(Request) -> http.Response) -> http.Response]
}

struct Server {
  l: Listener
  r: Router
  /// with_tls (std.md 4.6): HTTPS with these certificates
  tls: List[TlsCert] = []
  tls_on: Bool = false
  /// What serve does with TLS and HTTP/2 (decision 0244): no_tls and
  /// no_h2 (server), or setup_tls and serve_h2 (with_tls). Only with_tls
  /// names the TLS server's and HTTP/2's code, so a plain server links
  /// none of it.
  tls_setup: fn(rthttp.Srv, List[TlsCert]) -> ()
  h2: fn(rthttp.HConn, Int, Router) -> ()
}

struct Client {
  timeout: Duration
  /// the roots https verifies against (std.md 4.6)
  roots: rthttp.Roots
  /// the attenuation lists of the Net it was made from (Net.only,
  /// decision 0175): "" for none
  lists: Str = ""
}

/// http.TlsCert (std.md 4.6).
struct TlsCert {
  c: tlssrv.Cert
}

/// http.Response with the number of its streamed body's function (0:
/// none; decision 0083, std/rt's XStream), hidden from Xo code.
struct Response {
  status: Int
  headers: Map[Str, Str]
  body: Bytes
  stream: Int = 0
}

/// The writer of a streamed body: a sink into a buffer or a connection.
struct BodyWriter {
  s: rthttp.Sink
}

// ---------------------------------------------------------------------------
// Routing (std.md 4.1)

fn router() -> Router { Router{routes: [], mws: []} }

fn split_path(p: Str) -> List[Str] {
  // the slashes at both ends dropped by index: one slice, where trimming
  // one slash at a time made a string each (a request's path every time)
  let b = p.bytes()
  var lo = 0
  var hi = b.len()
  while lo < hi && b[lo] == 47 {
    lo += 1
  }
  while hi > lo && b[hi - 1] == 47 {
    hi -= 1
  }
  if lo == hi {
    return []
  }
  // each segment sliced from p: no copy of the trimmed path to split
  var out: List[Str] = List.with_capacity(4)
  var st = lo
  var i = lo
  while i < hi {
    if b[i] == 47 {
      out.push(raw.str_slice(p, st, i))
      st = i + 1
    }
    i += 1
  }
  out.push(raw.str_slice(p, st, hi))
  out
}

fn parse_pattern(pattern: Str) -> (Str, List[Seg]) {
  var method = ""
  var p = pattern
  match pattern.find(" ") {
    Some(i) => {
      if i > 0 {
        method = raw.str_slice(pattern, 0, i).to_upper()
        p = raw.str_slice(pattern, i + 1, pattern.len()).trim()
      }
    }
    None => ()
  }
  var segs: List[Seg] = []
  for s in split_path(p) {
    if s.starts_with("{") && s.ends_with("}") {
      let inner = raw.str_slice(s, 1, s.len() - 1)
      if inner.ends_with("...") {
        segs.push(Seg{lit: "", param: inner.trim_suffix("..."), is_int: false, rest: true})
      } else if inner.ends_with(":Int") {
        segs.push(Seg{lit: "", param: inner.trim_suffix(":Int"), is_int: true, rest: false})
      } else {
        segs.push(Seg{lit: "", param: inner, is_int: false, rest: false})
      }
      continue
    }
    segs.push(Seg{lit: s, param: "", is_int: false, rest: false})
  }
  (method, segs)
}

fn (var r: Router) handle[E: Error, fx: Effects](pattern: Str, h: fn(Request) -> http.Response ! E uses fx) uses fx {
  let (method, segs) = parse_pattern(pattern)
  let g = fn(req: Request) -> http.Response {
    match h(req) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.routes.push(Route{method: method, segs: segs, h: rt.launder1(g)})
}

fn (var r: Router) wrap[E: Error, fx: Effects](m: fn(Request, fn(Request) -> http.Response) -> http.Response ! E uses fx) uses fx {
  let g = fn(req: Request, next: fn(Request) -> http.Response) -> http.Response {
    match m(req, next) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.mws.push(rt.launder2(g))
}

fn (var r: Router) mount(prefix: Str, sub: Router) {
  let (_, pre) = parse_pattern(prefix)
  for sr in sub.routes {
    var segs = pre
    for s in sr.segs {
      segs.push(s)
    }
    var h = sr.h
    if !sub.mws.is_empty() {
      h = chain(sub.mws, sr.h)
    }
    r.routes.push(Route{method: sr.method, segs: segs, h: h})
  }
}

/// inner behind the middleware mws, outermost first.
fn chain(mws: List[fn(Request, fn(Request) -> http.Response) -> http.Response], inner: fn(Request) -> http.Response) -> fn(Request) -> http.Response {
  var next = inner
  var i = mws.len() - 1
  while i >= 0 {
    let mw = mws[i]
    let inn = next
    next = fn(q: Request) -> http.Response { mw(q, inn) }
    i -= 1
  }
  next
}

/// In process dispatch: a streamed body is collected (std/rt's M_call).
fn (r: Router) call(req: Request) -> http.Response { collect(call_raw(r, req)) }

/// call without collecting a streamed body (serve sends it as it is
/// made).
fn call_raw(r: Router, req: Request) -> http.Response {
  if r.mws.is_empty() {
    return dispatch(r, req)
  }
  let h = chain(r.mws, fn(q: Request) -> http.Response { dispatch(r, q) })
  // a fault in the middleware is isolated as a handler's (std.md 4.2):
  // it used to reach the connection's task, which stopped the server
  isolated(fn() -> http.Response { h(req) })
}

/// f's response, or 500 when it faults (logged; std/rt's
/// isolateHandler, decision 0085).
fn isolated(f: fn() -> http.Response) -> http.Response {
  match task.isolate(fn() -> http.Response ! () { f() }) {
    Ok(resp) => resp
    Err(task.Isolated.Faulted(info)) => {
      log.error("handler fault", {"fault": "${info.msg} at ${info.location}"})
      json_error(500, "internal error")
    }
    Err(_) => json_error(500, "internal error")
  }
}

fn literals(rt: Route) -> Int {
  var n = 0
  for s in rt.segs {
    if s.param.is_empty() {
      n += 1
    }
  }
  n
}

/// Whether the route matches the path parts (unescaped, uparts), and its
/// first Int segment that does not parse ("" when none).
fn match_parts(route: Route, uparts: List[Str]) -> (Bool, Str) {
  var bad = ""
  for (i, s) in route.segs.indexed() {
    if s.rest {
      return (true, bad)
    }
    if i >= uparts.len() {
      return (false, "")
    }
    let part = uparts[i]
    if s.param.is_empty() {
      if part != s.lit {
        return (false, "")
      }
      continue
    }
    if s.is_int && Int.parse(part) is None && bad.is_empty() {
      bad = s.param
    }
  }
  if uparts.len() != route.segs.len() {
    return (false, "")
  }
  (true, bad)
}

/// The route's parameters: from the unescaped parts, a rest parameter
/// from the raw parts joined.
fn bind_params(route: Route, parts: List[Str], uparts: List[Str]) -> Map[Str, Str] {
  var params: Map[Str, Str] = {}
  for (i, s) in route.segs.indexed() {
    if s.rest {
      var rest = ""
      if i < parts.len() {
        var tail: List[Str] = []
        var j = i
        while j < parts.len() {
          tail.push(parts[j])
          j += 1
        }
        rest = tail.join("/")
      }
      params.put(s.param, rest)
      return params
    }
    if !s.param.is_empty() && i < uparts.len() {
      params.put(s.param, uparts[i])
    }
  }
  params
}

fn dispatch(r: Router, req: Request) -> http.Response {
  let parts = split_path(req.path)
  // unescaped once for every route (was per route and segment)
  var uparts: List[Str] = List.with_capacity(parts.len())
  for p in parts {
    uparts.push(http1.path_unescape(p))
  }
  let method = req.method.to_upper()
  var best = -1
  var best_lits = 0
  var best_bad = ""
  var mismatch = false
  for (i, route) in r.routes.indexed() {
    let (ok, bad) = match_parts(route, uparts)
    if !ok {
      continue
    }
    if !route.method.is_empty() && route.method != method {
      mismatch = true
      continue
    }
    let lits = literals(route)
    if best < 0 || lits > best_lits {
      best = i
      best_lits = lits
      best_bad = bad
    }
  }
  if best < 0 {
    if mismatch {
      return json_error(405, "method not allowed")
    }
    return json_error(404, "not found")
  }
  if !best_bad.is_empty() {
    return json_error(400, "path segment `${best_bad}` must be an Int")
  }
  let route = r.routes[best]
  let h = route.h
  let q = req with {params: bind_params(route, parts, uparts)}
  // a fault in the handler is isolated: 500 (std/rt's isolateHandler,
  // decision 0085)
  isolated(fn() -> http.Response { h(q) })
}

/// A handler's or middleware's error as a response (std.md 4.2).
fn error_response[E: Error](e: E) -> http.Response {
  match rt.status_of(e) {
    Some(status) => json_error(status, e.display())
    None => {
      log.error("handler failed", {"error": e.display()})
      json_error(500, "internal error")
    }
  }
}

fn json_error(status: Int, msg: Str) -> http.Response { json(status, {"error": msg}) }

// ---------------------------------------------------------------------------
// Requests and responses (std.md 4.3)

fn request_param(r: Request, name: Str, at: rt.Loc) -> Str {
  match r.params.get(name) {
    Some(v) => v
    None => rt.fault_at("request has no path parameter `${name}`", at)
  }
}

fn request_param_int(r: Request, name: Str, at: rt.Loc) -> Int {
  let s = request_param(r, name, at)
  match Int.parse(s) {
    Some(n) => n
    None => rt.fault_at("path parameter `${name}` is not an Int: ${http1.go_quote(s)} (declare it as {${name}:Int})", at)
  }
}

fn request_query(r: Request, name: Str) -> Str? { r.url.query.get(name) }

fn header_get(h: Map[Str, Str], name: Str) -> Str? {
  match h.get(http1.canonical_key(name)) {
    Some(v) => return Some(v)
    None => ()
  }
  for (k, v) in h {
    if http1.equal_fold(k, name) {
      return Some(v)
    }
  }
  None
}

fn request_header(r: Request, name: Str) -> Str? { header_get(r.headers, name) }

fn request_json[T: Json](r: Request) -> T ! js.DecodeErr { js.decode(r.body) }

fn request_with_header(r: Request, name: Str, value: Str) -> Request {
  var h = r.headers
  h.put(http1.canonical_key(name), value)
  r with {headers: h}
}

fn request_with_value[T](r: Request, k: Key[T], v: T) -> Request {
  var vs = r.values
  vs.push(ReqValue{name: k.key_name, v: rt.any_of(v)})
  r with {values: vs}
}

fn request_value[T](r: Request, k: Key[T]) -> T? {
  var i = r.values.len() - 1
  while i >= 0 {
    let rv = r.values[i]
    if rv.name == k.key_name {
      match rt.any_get[T](rv.v) {
        Some(v) => return Some(v)
        None => ()
      }
    }
    i -= 1
  }
  None
}

fn key[T](name: Str) -> Key[T] { Key{key_name: name} }

fn (k: Key[T]) name() -> Str { k.key_name }

/// url.Parse of an absolute or path only URL; a URL that does not parse
/// is its text as the path (std/rt's parseURLLoose).
fn parse_url_loose(raw: Str) -> http.Url {
  let parts = http1.url_parts(raw, false)
  if parts.is_empty() {
    return http.Url{scheme: "", host: "", port: None, path: raw, query: {}}
  }
  let path = if parts[3].is_empty() { "/" } else { parts[3] }
  var port: Int? = None
  if !parts[2].is_empty() {
    port = Int.parse(parts[2])
  }
  var query: Map[Str, Str] = {}
  if !parts[4].is_empty() {
    let q = http1.query_parts(parts[4])
    var i = 0
    while i + 1 < q.len() {
      query.put(q[i], q[i + 1])
      i += 2
    }
  }
  http.Url{scheme: parts[0], host: parts[1], port: port, path: path, query: query}
}

fn new_request(method: Str, url: Str, headers: Map[Str, Str] = {}, body: Bytes = "".bytes()) -> Request {
  let u = parse_url_loose(url)
  var h: Map[Str, Str] = {}
  for (k, v) in headers {
    h.put(http1.canonical_key(k), v)
  }
  let parts = http1.url_parts(url, false)
  let path = if parts.is_empty() { url } else { parts[3] }
  Request{method: method.to_upper(), path: path, url: u, headers: h, body: body, remote_ip: "127.0.0.1"}
}

fn parse_url(s: Str) -> http.Url ! http.UrlErr {
  let parts = http1.url_parts(s, false)
  if parts.is_empty() {
    return Err(http.UrlErr{msg: http1.url_error(s)})
  }
  if parts[0] != "http" && parts[0] != "https" {
    return Err(http.UrlErr{msg: "scheme must be http or https: ${s}"})
  }
  if parts[5].is_empty() {
    return Err(http.UrlErr{msg: "missing host: ${s}"})
  }
  parse_url_loose(s)
}

fn json[T: Json](status: Int, v: T) -> http.Response {
  http.Response{status: status, headers: {"Content-Type": "application/json"}, body: js.encode(v)}
}

fn text(status: Int, s: Str) -> http.Response {
  http.Response{status: status, headers: {"Content-Type": "text/plain; charset=utf-8"}, body: s.bytes()}
}

fn empty(status: Int) -> http.Response { http.Response{status: status, headers: {}, body: "".bytes()} }

fn response_with_header(r: http.Response, name: Str, value: Str) -> http.Response {
  var h = r.headers
  h.put(http1.canonical_key(name), value)
  r with {headers: h}
}

fn response_header(r: http.Response, name: Str) -> Str? { header_get(r.headers, name) }

fn response_text(r: http.Response) -> Str? { collect(r).body.to_str() }

fn response_decode_json[T: Json](r: http.Response) -> T ! js.DecodeErr { js.decode(collect(r).body) }

/// The body is produced by f while the response is sent; dispatched in
/// process it is collected (std.md 4.3, decision 0083).
fn stream[fx: Effects](status: Int, f: fn(BodyWriter) -> () ! IoErr uses fx) -> http.Response uses fx {
  let r = Response{status: status, headers: {}, body: "".bytes(), stream: hserve.stream_put(rt.any_of(f))}
  rt.cast[Response, http.Response](r)
}

/// r with a streamed body run into it (std/rt's collect); a copy may be
/// collected again.
fn collect(r0: http.Response) -> http.Response {
  let r = rt.cast[http.Response, Response](r0)
  if r.stream == 0 {
    return r0
  }
  var body = "".bytes()
  let fs = hserve.stream_get(r.stream, false)
  if !fs.is_empty() {
    if let Some(f) = rt.any_get[fn(BodyWriter) -> () ! IoErr](fs[0]) {
      let s = hserve.sink_buf()
      f(BodyWriter{s: s}).ignore_err("a stream that fails ends its body there, as std/rt's collect")
      body = hserve.sink_take(s)
    }
  }
  rt.cast[Response, http.Response](r with {body: body, stream: 0})
}

fn (w: BodyWriter) write(data: Bytes) -> () ! IoErr {
  if task.is_canceled() {
    return Err(IoErr.Canceled)
  }
  if !hserve.sink_write(w.s, data) {
    return Err(IoErr.Io(msg: "write: connection closed"))
  }
}

fn (w: BodyWriter) flush() -> () ! IoErr {
  if task.is_canceled() {
    return Err(IoErr.Canceled)
  }
  if !hserve.sink_flush(w.s) {
    return Err(IoErr.Io(msg: "flush: connection closed"))
  }
}

// ---------------------------------------------------------------------------
// Server (std.md 4.4)

fn server(l: Listener, r: Router) -> Server { Server{l: l, r: r, tls_setup: no_tls, h2: no_h2} }

fn (s: Server) addr() -> Str { s.l.addr() }

fn (s: Server) with_tls(certs: List[TlsCert]) -> Server {
  // the table of the TLS server and HTTP/2 (srvtls.xo), made once
  srvtls.install()
  Server{l: s.l, r: s.r, tls: certs, tls_on: true, tls_setup: setup_tls, h2: serve_h2}
}

/// A plain server's TLS setup and HTTP/2: none (serve_h2 is never
/// reached without TLS: hserve.hc_h2 is 0).
fn no_tls(_srv: rthttp.Srv, _certs: List[TlsCert]) {}

fn no_h2(_hc: rthttp.HConn, _h2: Int, _r: Router) {}

/// The certificates of a server with TLS (with_tls).
fn setup_tls(srv: rthttp.Srv, certs: List[TlsCert]) {
  for c in certs {
    hserve.srv_tls(srv, c.c)
  }
}

fn tls_cert(cert_pem: Bytes, key_pem: Bytes) -> TlsCert ! http.TlsErr {
  let (c, e) = tlssrv.cert(cert_pem, key_pem)
  if !e.is_empty() {
    return Err(http.TlsErr{msg: e})
  }
  TlsCert{c: c}
}

fn (s: Server) serve() -> () ! http.HttpErr uses net.listen {
  // only the test world makes in memory listeners (folded elsewhere,
  // decision 0246)
  if testworld.on() && twrun.mem_listener(s.l) {
    serve_mem(s.l, s.r)
    return Ok(())
  }
  if s.tls_on && s.tls.is_empty() {
    return Err(http.HttpErr.Io(msg: "http: with_tls needs a certificate"))
  }
  let srv = hserve.srv_new()
  defer hserve.srv_close(srv)
  let setup = s.tls_setup
  setup(srv, s.tls)
  let conns = hserve.srv_group(srv)
  let l = s.l
  let r = s.r
  let h2 = s.h2
  var failed = ""
  scope sc {
    sc.spawn_background(fn() {
      // a stop request (core 7.5): stop accepting, close idle
      // connections
      let _ = task.stopping().recv()
      hserve.srv_stop(srv)
      l.close()
    })
    while {
      match l.accept() {
        Ok(c) => {
          let hc = hserve.hc_new(srv, c)
          conns.spawn_background(fn() { serve_conn_isolated(hc, r, h2) })
        }
        Err(NetErr.Io(msg)) => {
          if !task.stop_requested() && !task.is_canceled() {
            failed = msg
          }
          break
        }
        Err(_) => break
      }
    }
  }
  hserve.srv_stop(srv)
  hserve.srv_wait(srv)
  if !failed.is_empty() {
    return Err(http.HttpErr.Io(msg: failed))
  }
}

/// Serves an in memory listener of a test (decision 0083, std/rt's
/// memListener.serve): requests reach r in process until a stop is
/// requested (then the requests in flight finish) or the task is
/// canceled.
fn serve_mem(l: Listener, r: Router) {
  twrun.mem_serve(l, rt.any_of(r))
  defer twrun.mem_unserve(l)
  if task.stopping().recv() is None {
    twrun.mem_unserve(l)
    twrun.mem_drain(l)
  }
}

/// serve_conn with a fault in the connection's own code (not a
/// handler's, which is isolated in dispatch) ending that connection only,
/// as net/http recovers per connection ("http: panic serving"): logged,
/// the connection closed (serve_conn's defer), the server serving on. It
/// once stopped the server (gotchas/native-server-unisolated-fault-wedges.md).
fn serve_conn_isolated(hc: rthttp.HConn, r: Router, h2: fn(rthttp.HConn, Int, Router) -> ()) {
  match task.isolate(fn() -> () ! () { serve_conn(hc, r, h2) }) {
    // the message alone: the location is the runtime's, not the program's
    Err(task.Isolated.Faulted(info)) => log.error("http: panic serving", {"fault": info.msg})
    _ => ()
  }
}

/// Serves the requests of one connection until it closes.
fn serve_conn(hc: rthttp.HConn, r: Router, serve_h2: fn(rthttp.HConn, Int, Router) -> ()) {
  defer hserve.hc_close(hc)
  let h2 = hserve.hc_h2(hc)
  if h2 != 0 {
    serve_h2(hc, h2, r)
    return
  }
  var rd = http1.reader(hc)
  while true {
    match rd.read() {
      Some(q) => {
        let (open, resp) = respond(hc, head_request(rd, q), r)
        let keep = match resp {
          Some(x) => http1.respond(hc, x.status, x.body)
          None => open
        }
        if !keep {
          break
        }
      }
      None => break
    }
  }
}

/// HTTP/2 (decision 0121, std/native/llrt/h2srv.xo): each request is a
/// task of its own, as net/http runs a handler per stream; the scope ends
/// when the connection does. Reached only through Server.h2, which only
/// with_tls sets (decision 0244).
fn serve_h2(hc: rthttp.HConn, h2: Int, r: Router) {
  var hp = h2srv.conn(hc, h2)
  scope s {
    while true {
      match hp.next() {
        Some(q) => {
          s.spawn(fn() { serve_stream(q, r) })
        }
        None => break
      }
    }
  }
}

/// Serves one HTTP/2 stream. A fault in a streamed body resets the
/// stream (h2srv.end), as net/http resets it after a handler's panic;
/// the connection's other streams go on.
fn serve_stream(q: h2srv.H2Req, r: Router) {
  let st = q.conn
  defer h2srv.end(st)
  task.isolate(fn() -> Bool ! () {
    let (open, resp) = respond(st, stream_request(q), r)
    match resp {
      Some(x) => h2srv.respond(st, x.status, x.body)
      None => open
    }
  }).ignore_err("a fault resets the stream (h2srv.end)")
}

/// Answers req, read on hc (an HTTP/1.1 connection or an HTTP/2
/// stream): a streamed body goes out here, with whether the connection
/// stays open; any other response is returned for the caller to send
/// (http1.respond, or h2srv.respond in serve_stream, so the HTTP/1.1 path
/// names no HTTP/2 code, decision 0244).
fn respond(hc: rthttp.HConn, req: Request, r: Router) -> (Bool, Response?) {
  let resp = rt.cast[http.Response, Response](call_raw(r, req))
  for (k, v) in resp.headers {
    http1.header_set(hc, k, v)
  }
  if resp.stream != 0 {
    // a streamed body goes out as f makes it (std/rt's serve)
    let s = hserve.sink_conn(hc, resp.status)
    let fs = hserve.stream_get(resp.stream, true)
    if !fs.is_empty() {
      if let Some(f) = rt.any_get[fn(BodyWriter) -> () ! IoErr](fs[0]) {
        f(BodyWriter{s: s}).ignore_err("a stream that fails ends its body there, as net/http")
      }
    }
    return (hserve.sink_end(s), None)
  }
  (true, Some(resp))
}

/// The request of an HTTP/1.1 head read by rd (std/rt's serve).
fn head_request(rd: http1.Reader, q: http1.Req) -> Request {
  var headers: Map[Str, Str] = {}
  var i = 0
  while i + 1 < q.headers.len() {
    headers.put(q.headers[i], q.headers[i + 1])
    i += 2
  }
  var query: Map[Str, Str] = {}
  i = 0
  while i + 1 < q.query.len() {
    query.put(q.query[i], q.query[i + 1])
    i += 2
  }
  var upath = q.path
  if upath.is_empty() {
    upath = "/"
  }
  var port: Int? = None
  if q.port >= 0 {
    port = Some(q.port)
  }
  let url = http.Url{scheme: q.scheme, host: q.host, port: port, path: upath, query: query}
  Request{method: q.method, path: q.path, url: url, headers: headers, body: rd.body(), remote_ip: hconn.remote_ip(rd.conn())}
}

/// The request of an HTTP/2 stream (std/rt's serve).
fn stream_request(q: h2srv.H2Req) -> Request {
  http1.fault_probe(q.path, "stream")
  var headers: Map[Str, Str] = {}
  var i = 0
  while i + 1 < q.headers.len() {
    headers.put(q.headers[i], q.headers[i + 1])
    i += 2
  }
  var query: Map[Str, Str] = {}
  i = 0
  while i + 1 < q.query.len() {
    query.put(q.query[i], q.query[i + 1])
    i += 2
  }
  var upath = q.path
  if upath.is_empty() {
    upath = "/"
  }
  var port: Int? = None
  let p = http1.host_port(q.urlhost)
  if p >= 0 {
    port = Some(p)
  }
  let url = http.Url{scheme: q.scheme, host: http1.host_name(q.host), port: port, path: upath, query: query}
  Request{method: q.method, path: q.path, url: url, headers: headers, body: q.body, remote_ip: hconn.remote_ip(q.conn)}
}

// ---------------------------------------------------------------------------
// Client (std.md 4.5)

fn client(net: Net, timeout: Duration = 30s) -> Client { Client{timeout: timeout, roots: tlsio.roots_system(), lists: rt.net_lists(net)} }

fn (c: Client) with_roots(pem: Bytes) -> Client ! http.TlsErr {
  let r = tlsio.roots_pem(pem)
  let e = tlsio.roots_err(r)
  if !e.is_empty() {
    return Err(http.TlsErr{msg: e})
  }
  Client{timeout: c.timeout, roots: r, lists: c.lists}
}

fn (c: Client) get(url: Str) -> http.Response ! http.ClientErr uses net.dial { c.send(new_request("GET", url)) }

fn (c: Client) post_json[T: Json](url: Str, v: T) -> http.Response ! http.ClientErr uses net.dial {
  c.send(new_request("POST", url, {"Content-Type": "application/json"}, js.encode(v)))
}

/// The text of a URL (std/rt's urlString).
fn url_string(u: http.Url) -> Str {
  var s = ""
  if !u.scheme.is_empty() {
    s = u.scheme + "://"
  }
  s = s + u.host
  match u.port {
    Some(p) => s = s + ":${p}"
    None => ()
  }
  s = s + u.path
  var first = true
  for (k, v) in u.query {
    if first {
      s = s + "?"
      first = false
    } else {
      s = s + "&"
    }
    s = s + http1.query_escape(k) + "=" + http1.query_escape(v)
  }
  s
}

fn (c: Client) send(req: Request) -> http.Response ! http.ClientErr uses net.dial {
  if task.is_canceled() {
    return Err(http.ClientErr.Canceled)
  }
  let raw = url_string(req.url)
  if req.url.scheme.is_empty() || req.url.host.is_empty() {
    return Err(http.ClientErr.InvalidUrl(msg: "absolute URL required: ${raw}"))
  }
  if !c.lists.is_empty() {
    // an attenuated Net (Net.only, decision 0175): std/rt's httpDenied
    let port = match req.url.port {
      Some(p) => "${p}"
      None => if req.url.scheme.to_lower() == "https" { "443" } else { "80" }
    }
    if !netpolicy.admits(c.lists, req.url.host, port) {
      let hp = if req.url.host.contains(":") { "[${req.url.host}]:${port}" } else { "${req.url.host}:${port}" }
      return Err(http.ClientErr.Connect(msg: "denied by Net.only: ${hp}"))
    }
  }
  if testworld.fake(4) {
    // FakeNet (a test without `uses net` and `xo test --real`)
    return send_mem(req, raw)
  }
  var names: List[Str] = []
  var values: List[Str] = []
  for (k, v) in req.headers {
    names.push(k)
    values.push(v)
  }
  let r = http1.client_do(req.method, raw, names, values, req.body, c.timeout.nanos(), c.roots, c.lists)
  match r.err {
    0 => ()
    1 => return Err(http.ClientErr.InvalidUrl(msg: r.msg))
    2 => return Err(http.ClientErr.Connect(msg: r.msg))
    3 => return Err(http.ClientErr.Timeout)
    5 => return Err(http.ClientErr.Canceled)
    _ => return Err(http.ClientErr.Protocol(msg: r.msg))
  }
  var h: Map[Str, Str] = {}
  var i = 0
  while i + 1 < r.headers.len() {
    h.put(r.headers[i], r.headers[i + 1])
    i += 2
  }
  http.Response{status: r.status, headers: h, body: r.body}
}

// ---------------------------------------------------------------------------
// The fake network of tests (decision 0083, std/rt's fakeNet.dispatch)

/// A client request in a test: the failures of FakeNet.fail and fail_next
/// first, then the FakeNet.handle handler whose route has the most
/// literal segments, then the router serving the in memory listener of
/// the URL's host and port.
fn send_mem(req: Request, raw: Str) -> http.Response ! http.ClientErr {
  testworld.record(rt.any_of(req))
  for i in 0..testworld.fake_count(1) {
    if fake_match(1, i, req, raw) is Some(_) {
      let e = rt.any_get[http.ClientErr](testworld.fake_value(1, i))
      testworld.fake_used(i)
      if let Some(err) = e {
        return Err(err)
      }
    }
  }
  var best = -1
  var best_lits = -1
  var best_params: Map[Str, Str] = {}
  for i in 0..testworld.fake_count(0) {
    if let Some((lits, params)) = fake_match(0, i, req, raw) {
      if best < 0 || lits > best_lits {
        best = i
        best_lits = lits
        best_params = params
      }
    }
  }
  if best >= 0 {
    if let Some(h) = rt.any_get[fn(Request) -> http.Response](testworld.fake_value(0, best)) {
      return h(req with {params: best_params})
    }
  }
  var hp = req.url.host
  if let Some(p) = req.url.port {
    hp = hp + ":${p}"
  }
  let found = twrun.mem_begin(hp)
  if found.is_empty() {
    return Err(http.ClientErr.Connect(msg: "no fake handler for ${req.method} ${raw}"))
  }
  defer twrun.mem_end(hp)
  match rt.any_get[Router](found[0]) {
    Some(r) => r.call(req)
    None => Err(http.ClientErr.Connect(msg: "no fake handler for ${req.method} ${raw}"))
  }
}

/// Whether handler (kind 0) or failure (1) i matches the request: the
/// number of literal segments of its route and the route's parameters.
fn fake_match(kind: Int, i: Int, req: Request, raw: Str) -> (Int, Map[Str, Str])? {
  let method = testworld.fake_text(kind, i, 0)
  if !method.is_empty() && method != req.method.to_upper() {
    return None
  }
  let prefix = testworld.fake_text(kind, i, 1)
  if !prefix.is_empty() && !raw.starts_with(prefix) {
    return None
  }
  let (_, segs) = parse_pattern(testworld.fake_text(kind, i, 2))
  let route = Route{method: "", segs: segs, h: fn(_q: Request) -> http.Response { empty(404) }}
  let parts = split_path(req.path)
  var uparts: List[Str] = List.with_capacity(parts.len())
  for p in parts {
    uparts.push(http1.path_unescape(p))
  }
  let (ok, _) = match_parts(route, uparts)
  if !ok {
    return None
  }
  Some((literals(route), bind_params(route, parts, uparts)))
}
