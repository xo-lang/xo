// std/http on the native backends (decision 0074). std/rt/http.go is the
// reference; std/llrt/xo_http.c reads requests and writes responses as
// net/http does.
use std/http
use std/compress
use std/json as js
use std/mime
use std/netip
use std/multipart
use std/time
use std/url
use std/log
use std/task
use native/llrt/hconn
use native/llrt/hserve
use native/rt
use native/llrt/h2srv
use native/llrt/http1
use native/llrt/http1w
use native/llrt/hclient
use native/llrt/rand as llrand
use native/llrt/srvtls
use native/llrt/tlsneg
use native/llrt/tlssrv
use native/llrt/tlsio
use native/llrt/cabi_http
use native/llrt/cabi_net
use native/llrt/netpolicy
use native/llrt/testworld
use native/llrt/twrun
use native/rthttp
use native/llrt/raw
use native/multipart as nmp

// ---------------------------------------------------------------------------
// Types: the implementations of the std types of the same names

/// http.Request with its route parameters and typed values (hidden from
/// Xo code, as std/rt's XParams and XValues).
struct Request {
  method: Str
  path: Str
  url: http.Url
  headers: Map[Str, Str]
  body: Bytes
  remote_ip: Str
  params: Map[Str, Str] = {}
  values: List[ReqValue] = []
  /// The URL's raw query, for query_all (decision 0279); "" for a
  /// request built as a struct literal (query_all then reads url.query).
  raw_query: Str = ""
  /// The header's fields when a name has several (decision 0288): [name,
  /// value, ...], canonical names in order; [] when every name has one
  /// value (headers is then all of it). Hidden from Xo code.
  fields: List[Str] = []
  /// The request target's path as sent (escaped_path) and the Host header
  /// as sent (host); "" for a request built as a struct literal. Hidden
  /// from Xo code (std/rt's XRawPath, XHost).
  raw_path: Str = ""
  raw_host: Str = ""
  /// Whether the request came over TLS (std/rt's XTLS). Hidden.
  over_tls: Bool = false
  /// What the TLS handshake negotiated, for tls_state (std/rt's
  /// XTLSState): one entry when over_tls, none otherwise. Hidden.
  tls_neg: List[tlsneg.Negotiated] = []
  /// with_timeout's limit in nanoseconds, 0 for the client's (decision
  /// 0404). Hidden from Xo code.
  timeout_ns: Int = 0
  /// with_idle_timeout's limit in nanoseconds for each read of a stream,
  /// 0 for the client's timeout (decision 0404). Hidden from Xo code.
  idle_ns: Int = 0
  /// with_body_reader's source of the body sent as it is read (decision
  /// 0404 stage C), its pieces as the server's BodyPart (data the raw
  /// bytes, never shown as text). Hidden from Xo code.
  src: List[fn(Int) -> http1.BodyPart] = []
  /// with_trailers' f (decision 0433), asked once the body is sent; one
  /// entry or none. Hidden from Xo code.
  trailer_fn: List[fn() -> Map[Str, Str]] = []
  /// with_trailers' names, canonical, declared in the head. Hidden.
  trailer_names: List[Str] = []
}

struct ReqValue {
  name: Str
  v: rt.Any
}

struct Key[T] {
  key_name: Str
}

struct Route {
  method: Str
  segs: List[Seg]
  h: fn(Request) -> http.Response
  /// a handle_stream route (decision 0310)
  stream: Bool = false
}

struct Seg {
  lit: Str
  param: Str
  is_int: Bool
  rest: Bool
}

struct Router {
  routes: List[Route]
  mws: List[fn(Request, fn(Request) -> http.Response) -> http.Response]
  /// whether a route is a handle_stream route
  streamed: Bool = false
  /// the not_found and method_not_allowed hooks (std.md 4.1), one entry
  /// each when set; a miss answers with the default JSON otherwise
  miss_h: List[fn(Request) -> http.Response] = []
  allow_h: List[fn(Request) -> http.Response] = []
}

struct Server {
  l: Listener
  r: Router
  /// with_tls (std.md 4.6): HTTPS with these certificates
  tls: List[TlsCert] = []
  tls_on: Bool = false
  /// What serve does with TLS and HTTP/2 (decision 0244): no_tls and
  /// no_h2 (server), or setup_tls and serve_h2 (with_tls). Only with_tls
  /// names the TLS server's and HTTP/2's code, so a plain server links
  /// none of it.
  tls_setup: fn(rthttp.Srv, List[TlsCert]) -> ()
  h2: fn(rthttp.HConn, Int, Router) -> ()
  /// with_read_timeout, with_read_header_timeout, with_idle_timeout (ns,
  /// 0 none), with_max_header_bytes and with_max_body (bytes, 0 the
  /// defaults): http1.Limits of each connection's reader.
  read_ns: Int = 0
  head_ns: Int = 0
  idle_ns: Int = 0
  max_head: Int = 0
  max_body: Int = 0
}

struct Client {
  timeout: Duration
  /// the roots https verifies against (std.md 4.6)
  roots: rthttp.Roots
  /// the attenuation lists of the Net it was made from (Net.only,
  /// decision 0175): "" for none
  lists: Str = ""
  /// the redirects followed at most (with_redirects, decision 0404); 0
  /// returns the 3xx itself
  redirects: Int = 10
}

/// http.TlsCert (std.md 4.6).
struct TlsCert {
  c: tlssrv.Cert
}

/// http.Response with the number of its streamed body's function (0:
/// none; decision 0083, std/rt's XStream), hidden from Xo code.
struct Response {
  status: Int
  headers: Map[Str, Str]
  body: Bytes
  stream: Int = 0
  /// as Request.fields (decision 0288)
  fields: List[Str] = []
}

/// The 101 response that hands its connection to f (respond runs it):
/// std/websocket's upgrade (decision 0313). `pub` in a native module is
/// std-internal (decision 0319): std/native modules reach it through
/// `use native/http`; programs cannot import native/ modules, and
/// std/http's declaration file does not list it.
pub fn handoff_response(f: fn(rthttp.HConn) -> ()) -> http.Response {
  rt.cast[Response, http.Response](Response{status: 101, headers: {}, body: b"", stream: hserve.stream_put(rt.any_of(f))})
}

/// The body of a request to a handle_stream route (decision 0310).
struct BodyReader {
  st: Mutex[BodyState]
}

/// What a BodyReader read: from the connection (next: http1.body_next
/// on an HTTP/1.1 connection, h2srv.body_next on an HTTP/2 stream; as
/// functions, so a plain server links no HTTP/2 code, decision 0244),
/// else from data at pos (Router.call, a request made in Xo); what to do
/// after the handler (finish: HTTP/1.1's discard; none: HTTP/2's reset
/// is h2srv's); a read's error, which sticks; the end seen.
struct BodyState {
  next: List[fn(Int) -> http1.BodyPart]
  finish: List[fn() -> ()]
  data: Bytes
  pos: Int
  err: Str
  end: Bool
  /// the request's trailers (decision 0433), set by the connection's
  /// reader when the body ends
  trailers: Map[Str, Str] = {}
}

/// A request's body read from its connection by next, finish run after
/// its handler.
fn conn_body(next: fn(Int) -> http1.BodyPart, finish: List[fn() -> ()]) -> BodyReader {
  BodyReader{st: Mutex[BodyState].new(BodyState{next: [next], finish: finish, data: b"", pos: 0, err: "", end: false})}
}

/// The request value that carries a server's unread body to its
/// handle_stream route.
const STREAM_BODY = "xo:stream-body"

/// The most one read of a streamed body asks of the connection.
const READ_MAX = 1048576

/// The writer of a streamed body: a sink into a buffer or a connection.
struct BodyWriter {
  s: rthttp.Sink
  /// gzip_responses: the compressor between the handler's writes and s
  gz: Mutex[compress.Compressor]? = None
}

// ---------------------------------------------------------------------------
// Routing (std.md 4.1)

fn router() -> Router { Router{routes: [], mws: []} }

/// The bounds of path b without the slashes at its ends.
fn path_bounds(b: Bytes) -> (Int, Int) {
  var lo = 0
  var hi = b.len()
  while lo < hi && b[lo] == 47 {
    lo += 1
  }
  while hi > lo && b[hi - 1] == 47 {
    hi -= 1
  }
  (lo, hi)
}

fn split_path(p: Str) -> List[Str] {
  // the slashes at both ends dropped by index: one slice, where trimming
  // one slash at a time made a string each (a request's path every time)
  let b = p.bytes()
  let (lo, hi) = path_bounds(b)
  if lo == hi {
    return []
  }
  // each segment sliced from p: no copy of the trimmed path to split
  var out: List[Str] = List.with_capacity(4)
  var st = lo
  var i = lo
  while i < hi {
    if b[i] == 47 {
      out.push(raw.str_slice(p, st, i))
      st = i + 1
    }
    i += 1
  }
  out.push(raw.str_slice(p, st, hi))
  out
}

fn parse_pattern(pattern: Str) -> (Str, List[Seg]) {
  var method = ""
  var p = pattern
  match pattern.find(" ") {
    Some(i) => {
      if i > 0 {
        method = raw.str_slice(pattern, 0, i).to_upper()
        p = raw.str_slice(pattern, i + 1, pattern.len()).trim()
      }
    }
    None => ()
  }
  var segs: List[Seg] = []
  for s in split_path(p) {
    if s.starts_with("{") && s.ends_with("}") {
      let inner = raw.str_slice(s, 1, s.len() - 1)
      if inner.ends_with("...") {
        segs.push(Seg{lit: "", param: inner.trim_suffix("..."), is_int: false, rest: true})
      } else if inner.ends_with(":Int") {
        segs.push(Seg{lit: "", param: inner.trim_suffix(":Int"), is_int: true, rest: false})
      } else {
        segs.push(Seg{lit: "", param: inner, is_int: false, rest: false})
      }
      continue
    }
    segs.push(Seg{lit: s, param: "", is_int: false, rest: false})
  }
  (method, segs)
}

fn (var r: Router) handle[E: Error, fx: Effects](pattern: Str, h: fn(Request) -> http.Response ! E uses fx) uses fx {
  let (method, segs) = parse_pattern(pattern)
  let g = fn(req: Request) -> http.Response {
    match h(req) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.routes.push(Route{method: method, segs: segs, h: rt.launder1(g)})
}

fn (var r: Router) handle_stream[E: Error, fx: Effects](pattern: Str, h: fn(Request, BodyReader) -> http.Response ! E uses fx) uses fx {
  let (method, segs) = parse_pattern(pattern)
  let g = fn(req: Request) -> http.Response {
    match h(req, body_reader_of(req)) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.routes.push(Route{method: method, segs: segs, h: rt.launder1(g), stream: true})
  r.streamed = true
}

/// The reader of req's body: the server's unread body, else req.body.
fn body_reader_of(req: Request) -> BodyReader {
  for rv in req.values {
    if rv.name == STREAM_BODY {
      if let Some(b) = rt.any_get[BodyReader](rv.v) {
        return b
      }
    }
  }
  BodyReader{st: Mutex[BodyState].new(BodyState{next: [], finish: [], data: req.body, pos: 0, err: "", end: false})}
}

/// Runs what req's streamed body asks for after its handler (finish), if
/// it has one.
fn stream_finish(req: Request) {
  for rv in req.values {
    if rv.name == STREAM_BODY {
      if let Some(b) = rt.any_get[BodyReader](rv.v) {
        let fs = b.st.with_read(fn(s) { s.finish })
        if !fs.is_empty() {
          fs[0]()
        }
      }
    }
  }
}

fn (b: BodyReader) read(max: Int = 32768) -> Bytes? ! IoErr {
  if max < 1 {
    fault("BodyReader.read: max must be at least 1, got ${max}")
  }
  if task.is_canceled() {
    return Err(IoErr.Canceled)
  }
  // the outcome as the closure's value: an Err from with's closure would
  // undo the read's state (the error that sticks; spec 5.4)
  let outcome = b.st.with(fn(var s: BodyState) -> Result[Bytes?, IoErr] { body_read(s, max) })
  outcome?
}

fn (b: BodyReader) read_all() -> Bytes ! IoErr {
  var out = BytesBuilder.new()
  while true {
    match b.read(READ_MAX)? {
      Some(d) => out.write(d)
      None => break
    }
  }
  out.freeze()
}

/// A multipart body read part by part (decision 0310 phase 3).
struct PartReader {
  st: Mutex[nmp.Stream]
}

/// A part of a PartReader; fields: every header field as [name, value,
/// ...] (hidden from Xo code, as Request.fields).
struct StreamPart {
  name: Str
  filename: Str?
  headers: Map[Str, Str]
  fields: List[Str] = []
}

/// The request's trailers (decision 0433): empty until read returned None.
fn (b: BodyReader) trailers() -> Map[Str, Str] {
  b.st.with_read(fn(s) { if s.end { s.trailers } else { {} } })
}

/// Go's Request.MultipartReader: the checks of multipart_form, then a
/// reader over b.
fn (b: BodyReader) multipart(req: Request) -> PartReader ! multipart.MultipartErr {
  let not_multipart = multipart.MultipartErr{msg: "request Content-Type isn't multipart/form-data"}
  let ct = header_get(req.headers, "Content-Type") ?? ""
  if ct.is_empty() {
    return Err(not_multipart)
  }
  let m = match mime.parse_media_type(ct) {
    Ok(m) => m
    Err(_) => return Err(not_multipart)
  }
  if m.kind != "multipart/form-data" {
    return Err(not_multipart)
  }
  let boundary = match m.params.get("boundary") {
    Some(b) => b
    None => return Err(multipart.MultipartErr{msg: "no multipart boundary param in Content-Type"})
  }
  let src = fn() -> nmp.Feed {
    match b.read(READ_MAX) {
      Ok(Some(d)) => nmp.Feed{data: d, end: false, err: ""}
      Ok(None) => nmp.Feed{data: b"", end: true, err: ""}
      Err(e) => nmp.Feed{data: b"", end: false, err: io_err_text(e)}
    }
  }
  Ok(PartReader{st: Mutex[nmp.Stream].new(nmp.new_stream(src, boundary))})
}

/// The text of a body read's error, as Go's error from the body.
fn io_err_text(e: IoErr) -> Str {
  match e {
    IoErr.Io(msg: m) => m
    IoErr.Closed => "http: invalid Read on closed Body"
    IoErr.Canceled => "context canceled"
  }
}

fn (p: PartReader) next() -> StreamPart? ! multipart.MultipartErr {
  // the outcome as the closure's value, as BodyReader.read's
  let h = p.st.with(fn(var s: nmp.Stream) -> Result[nmp.Head?, Str] { s.next() })
  match h {
    Ok(Some(h)) => Ok(Some(StreamPart{name: h.name, filename: h.filename, headers: h.headers, fields: h.fields}))
    Ok(None) => Ok(None)
    Err(m) => Err(multipart.MultipartErr{msg: m})
  }
}

fn (p: PartReader) read(max: Int = 32768) -> Bytes? ! multipart.MultipartErr {
  if max < 1 {
    fault("PartReader.read: max must be at least 1, got ${max}")
  }
  match p.st.with(fn(var s: nmp.Stream) -> Result[Bytes?, Str] { s.read(max) }) {
    Ok(d) => Ok(d)
    Err(m) => Err(multipart.MultipartErr{msg: m})
  }
}

fn (p: StreamPart) header_values(name: Str) -> List[Str] {
  let k = http1.canonical_key(name)
  var vs: List[Str] = []
  var i = 0
  while i + 1 < p.fields.len() {
    if p.fields[i] == k {
      vs.push(p.fields[i + 1])
    }
    i += 2
  }
  vs
}

/// The next bytes of s, at most max.
fn body_read(var s: BodyState, max: Int) -> Bytes? ! IoErr {
  if !s.err.is_empty() {
    return Err(IoErr.Io(msg: s.err))
  }
  if s.end {
    return None
  }
  if s.next.is_empty() {
    let n = s.data.len() - s.pos
    if n == 0 {
      s.end = true
      return None
    }
    let k = if n < max { n } else { max }
    let out = s.data[s.pos..s.pos + k]
    s.pos += k
    return Some(out)
  }
  let p = s.next[0](if max > READ_MAX { READ_MAX } else { max })
  if !p.err.is_empty() {
    s.err = p.err
    return Err(IoErr.Io(msg: p.err))
  }
  if p.end {
    s.end = true
    return None
  }
  Some(p.data.bytes())
}

/// Whether the route dispatch picks for method and path is a
/// handle_stream route: the server then leaves the body to it.
fn route_streams(r: Router, method: Str, path: Str) -> Bool {
  let (lo, hi) = path_bounds(path.bytes())
  let esc = path.contains("%")
  let sb = if esc { [] } else { seg_bounds(path, lo, hi) }
  var uparts: List[Str] = []
  if esc {
    for p in split_path(path) {
      uparts.push(http1.path_unescape(p))
    }
  }
  let m = method.to_upper()
  var best = -1
  var best_lits = 0
  var best_bad = ""
  for (i, route) in r.routes.indexed() {
    let (ok, bad) = if esc { match_parts(route, uparts) } else { match_in(route, path, sb) }
    if !ok || (!route.method.is_empty() && route.method != m) {
      continue
    }
    let lits = literals(route)
    if best < 0 || lits > best_lits {
      best = i
      best_lits = lits
      best_bad = bad
    }
  }
  best >= 0 && best_bad.is_empty() && r.routes[best].stream
}

/// The response of a request no route matches, in place of the 404
/// (std.md 4.1; chi's NotFound).
fn (var r: Router) not_found[E: Error, fx: Effects](h: fn(Request) -> http.Response ! E uses fx) uses fx {
  let g = fn(req: Request) -> http.Response {
    match h(req) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.miss_h = [rt.launder1(g)]
}

/// The response of a request whose path a route matches with another
/// method, in place of the 405 (std.md 4.1; chi's MethodNotAllowed); the
/// response gets the Allow header when it lacks one.
fn (var r: Router) method_not_allowed[E: Error, fx: Effects](h: fn(Request) -> http.Response ! E uses fx) uses fx {
  let g = fn(req: Request) -> http.Response {
    match h(req) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.allow_h = [rt.launder1(g)]
}

/// resp with the Allow header when it has none (a 405's).
fn with_allow(resp: http.Response, allow: Str) -> http.Response {
  match resp.headers.get("Allow") {
    Some(_) => resp
    None => {
      var h = resp.headers
      h.put("Allow", allow)
      resp with {headers: h}
    }
  }
}

fn (var r: Router) wrap[E: Error, fx: Effects](m: fn(Request, fn(Request) -> http.Response) -> http.Response ! E uses fx) uses fx {
  let g = fn(req: Request, next: fn(Request) -> http.Response) -> http.Response {
    match m(req, next) {
      Ok(resp) => resp
      Err(e) => error_response(e)
    }
  }
  r.mws.push(rt.launder2(g))
}

fn (var r: Router) mount(prefix: Str, sub: Router) {
  let (_, pre) = parse_pattern(prefix)
  for sr in sub.routes {
    var segs = pre
    for s in sr.segs {
      segs.push(s)
    }
    var h = sr.h
    if !sub.mws.is_empty() {
      h = chain(sub.mws, sr.h)
    }
    r.routes.push(Route{method: sr.method, segs: segs, h: h, stream: sr.stream})
  }
  if sub.streamed {
    r.streamed = true
  }
}

/// inner behind the middleware mws, outermost first.
fn chain(mws: List[fn(Request, fn(Request) -> http.Response) -> http.Response], inner: fn(Request) -> http.Response) -> fn(Request) -> http.Response {
  var next = inner
  var i = mws.len() - 1
  while i >= 0 {
    let mw = mws[i]
    let inn = next
    next = fn(q: Request) -> http.Response { mw(q, inn) }
    i -= 1
  }
  next
}

/// In process dispatch: a streamed body is collected (std/rt's M_call).
fn (r: Router) call(req: Request) -> http.Response { collect(call_raw(r, req)) }

/// call without collecting a streamed body (serve sends it as it is
/// made).
fn call_raw(r: Router, req: Request) -> http.Response {
  if r.mws.is_empty() {
    return dispatch(r, req)
  }
  let h = chain(r.mws, fn(q: Request) -> http.Response { dispatch(r, q) })
  // a fault in the middleware is isolated as a handler's (std.md 4.2):
  // it used to reach the connection's task, which stopped the server
  isolated(fn() -> http.Response { h(req) })
}

/// f's response, or 500 when it faults (logged; std/rt's
/// isolateHandler, decision 0085).
fn isolated(f: fn() -> http.Response) -> http.Response {
  match task.isolate(fn() -> http.Response ! () { f() }) {
    Ok(resp) => resp
    Err(task.Isolated.Faulted(info)) => handler_fault(info.msg, info.location)
    Err(_) => json_error(500, "internal error")
  }
}

/// A handler's fault: logged, and 500.
fn handler_fault(msg: Str, location: Str) -> http.Response {
  log.error("handler fault", {"fault": "${msg} at ${location}"})
  json_error(500, "internal error")
}

fn literals(rt: Route) -> Int {
  var n = 0
  for s in rt.segs {
    if s.param.is_empty() {
      n += 1
    }
  }
  n
}

/// Whether the route matches the path parts (unescaped, uparts), and its
/// first Int segment that does not parse ("" when none).
fn match_parts(route: Route, uparts: List[Str]) -> (Bool, Str) {
  var bad = ""
  for (i, s) in route.segs.indexed() {
    if s.rest {
      return (true, bad)
    }
    if i >= uparts.len() {
      return (false, "")
    }
    let part = uparts[i]
    if s.param.is_empty() {
      if part != s.lit {
        return (false, "")
      }
      continue
    }
    if s.is_int && Int.parse(part) is None && bad.is_empty() {
      bad = s.param
    }
  }
  if uparts.len() != route.segs.len() {
    return (false, "")
  }
  (true, bad)
}

/// The segments of path p between lo and hi (path_bounds) as their start
/// and end offsets, two Ints a segment: split_path's parts without a
/// string each.
fn seg_bounds(p: Str, lo: Int, hi: Int) -> List[Int] {
  if lo == hi {
    return []
  }
  let b = p.bytes()
  var out: List[Int] = List.with_capacity(8)
  var st = lo
  var i = lo
  while i < hi {
    if b[i] == 47 {
      out.push(st)
      out.push(i)
      st = i + 1
    }
    i += 1
  }
  out.push(st)
  out.push(hi)
  out
}

/// match_parts on the path p itself, its segments at sb (seg_bounds),
/// when it has no escapes: compared where they are.
fn match_in(route: Route, p: Str, sb: List[Int]) -> (Bool, Str) {
  let n = sb.len() / 2
  var bad = ""
  var k = 0
  for s in route.segs {
    if s.rest {
      return (true, bad)
    }
    if k >= n {
      return (false, "")
    }
    let a = sb[2 * k]
    let e = sb[2 * k + 1]
    if s.param.is_empty() {
      if e - a != s.lit.len() || !raw.mem_eq(raw.data(p) + a, raw.data(s.lit), e - a) {
        return (false, "")
      }
    } else if s.is_int && bad.is_empty() && Int.parse(raw.str_slice(p, a, e)) is None {
      bad = s.param
    }
    k += 1
  }
  if k != n {
    return (false, "")
  }
  (true, bad)
}

/// bind_params on the path p itself (match_in's): a parameter is its
/// segment, a rest parameter the path from its segment on.
fn bind_in(route: Route, p: Str, sb: List[Int]) -> Map[Str, Str] {
  var params: Map[Str, Str] = {}
  let n = sb.len() / 2
  var k = 0
  for s in route.segs {
    if s.rest {
      params.put(s.param, if k >= n { "" } else { raw.str_cut(p, sb[2 * k], sb[sb.len() - 1]) })
      return params
    }
    if k >= n {
      break
    }
    if !s.param.is_empty() {
      params.put(s.param, raw.str_cut(p, sb[2 * k], sb[2 * k + 1]))
    }
    k += 1
  }
  params
}

/// The route's parameters: from the unescaped parts, a rest parameter
/// from the raw parts joined.
fn bind_params(route: Route, parts: List[Str], uparts: List[Str]) -> Map[Str, Str] {
  var params: Map[Str, Str] = {}
  for (i, s) in route.segs.indexed() {
    if s.rest {
      var rest = ""
      if i < parts.len() {
        var tail: List[Str] = []
        var j = i
        while j < parts.len() {
          tail.push(parts[j])
          j += 1
        }
        rest = tail.join("/")
      }
      params.put(s.param, rest)
      return params
    }
    if !s.param.is_empty() && i < uparts.len() {
      params.put(s.param, uparts[i])
    }
  }
  params
}

fn dispatch(r: Router, req: Request) -> http.Response {
  // a path without escapes is matched where it is (match_in, bind_in);
  // one with them as its unescaped parts, unescaped once for every route
  let path = req.path
  let (lo, hi) = path_bounds(path.bytes())
  let esc = path.contains("%")
  let sb = if esc { [] } else { seg_bounds(path, lo, hi) }
  let parts = if esc { split_path(path) } else { [] }
  var uparts: List[Str] = []
  if esc {
    for p in parts {
      uparts.push(http1.path_unescape(p))
    }
  }
  let method = req.method.to_upper()
  var best = -1
  var best_lits = 0
  var best_bad = ""
  var mismatch = false
  // the methods of the routes that match the path, for a 405's Allow
  // (Go 1.22's ServeMux), in registration order without repeats
  var allow: List[Str] = []
  for (i, route) in r.routes.indexed() {
    let (ok, bad) = if esc { match_parts(route, uparts) } else { match_in(route, path, sb) }
    if !ok {
      continue
    }
    if !route.method.is_empty() && route.method != method {
      mismatch = true
      if !allow.contains(route.method) {
        allow.push(route.method)
      }
      continue
    }
    let lits = literals(route)
    if best < 0 || lits > best_lits {
      best = i
      best_lits = lits
      best_bad = bad
    }
  }
  if best < 0 {
    if mismatch {
      let resp = if r.allow_h.is_empty() { json_error(405, "method not allowed") } else { let h = r.allow_h[0]; isolated(fn() -> http.Response { h(req) }) }
      return with_allow(resp, allow.join(", "))
    }
    if r.miss_h.is_empty() {
      return json_error(404, "not found")
    }
    let h = r.miss_h[0]
    return isolated(fn() -> http.Response { h(req) })
  }
  if !best_bad.is_empty() {
    return json_error(400, "path segment `${best_bad}` must be an Int")
  }
  let route = r.routes[best]
  let h = route.h
  let q = req with {params: if esc { bind_params(route, parts, uparts) } else { bind_in(route, path, sb) }}
  // a fault in the handler is isolated: 500 (std/rt's isolateHandler,
  // decision 0085). task.isolate's own argument, h(q) on local names: the
  // native backends call h with q moved in, no closure holding q (which
  // shared q's heap fields at the call and released them with itself)
  match task.isolate(fn() -> http.Response { h(q) }) {
    Ok(resp) => resp
    Err(task.Isolated.Faulted(info)) => handler_fault(info.msg, info.location)
    Err(_) => json_error(500, "internal error")
  }
}

/// A handler's or middleware's error as a response (std.md 4.2).
fn error_response[E: Error](e: E) -> http.Response {
  match rt.status_of(e) {
    Some(status) => json_error(status, e.display())
    None => {
      log.error("handler failed", {"error": e.display()})
      json_error(500, "internal error")
    }
  }
}

fn json_error(status: Int, msg: Str) -> http.Response { json(status, {"error": msg}) }

// ---------------------------------------------------------------------------
// Requests and responses (std.md 4.3)

fn request_param(r: Request, name: Str, at: rt.Loc) -> Str {
  match r.params.get(name) {
    Some(v) => v
    None => rt.fault_at("request has no path parameter `${name}`", at)
  }
}

fn request_param_int(r: Request, name: Str, at: rt.Loc) -> Int {
  let s = request_param(r, name, at)
  match Int.parse(s) {
    Some(n) => n
    None => rt.fault_at("path parameter `${name}` is not an Int: ${http1.go_quote(s)} (declare it as {${name}:Int})", at)
  }
}

fn request_query(r: Request, name: Str) -> Str? { r.url.query.get(name) }

/// Every value of name in the query, in order (Go's URL.Query()[name]:
/// pairs that do not parse are skipped, as Query ignores ParseQuery's
/// error). A request built as a struct literal has no raw query: its
/// url.query value, if any.
fn request_query_all(r: Request, name: Str) -> List[Str] {
  if r.raw_query.is_empty() {
    return match r.url.query.get(name) {
      Some(v) => [v]
      None => []
    }
  }
  var out: List[Str] = []
  for pair in r.raw_query.split("&") {
    if pair.is_empty() || pair.contains(";") {
      continue
    }
    let (k0, v0) = match pair.find("=") {
      Some(i) => (pair[0..i], pair[i + 1..])
      None => (pair, "")
    }
    if let Ok(k) = url.query_unescape(k0) {
      if k == name {
        if let Ok(v) = url.query_unescape(v0) {
          out.push(v)
        }
      }
    }
  }
  out
}

/// The body of an `application/x-www-form-urlencoded` POST, PUT, or PATCH
/// (Go's Request.ParseForm into PostForm): its media type is the
/// Content-Type before any `;`, without case; any other request is empty
/// Values. The body is already capped by the server (XO_HTTP_MAX_BODY),
/// so there is no second limit (Go's 10 MB). Invalid UTF-8 in the body
/// stays as `%XX` escapes (decision 0259).
fn request_form(r: Request) -> url.Values ! url.EscapeErr {
  if !(r.method is "POST" | "PUT" | "PATCH") {
    return url.values()
  }
  // Go's parsePostForm: no Content-Type is application/octet-stream; a
  // media type that does not parse is mime's error, whatever the type
  var ct = header_get(r.headers, "Content-Type") ?? ""
  if ct.is_empty() {
    ct = "application/octet-stream"
  }
  let m = match mime.parse_media_type(ct) {
    Ok(m) => m
    Err(e) => return Err(url.EscapeErr{msg: e.msg})
  }
  if m.kind != "application/x-www-form-urlencoded" {
    return url.values()
  }
  url.parse_query(form_text(r.body))
}

/// net/http multipartReader then ReadForm (decision 0282): the
/// Content-Type must be multipart/form-data with a boundary.
fn request_multipart_form(r: Request) -> multipart.Form ! multipart.MultipartErr {
  let not_multipart = multipart.MultipartErr{msg: "request Content-Type isn't multipart/form-data"}
  let ct = header_get(r.headers, "Content-Type") ?? ""
  if ct.is_empty() {
    return Err(not_multipart)
  }
  let m = match mime.parse_media_type(ct) {
    Ok(m) => m
    Err(_) => return Err(not_multipart)
  }
  if m.kind != "multipart/form-data" {
    return Err(not_multipart)
  }
  let boundary = match m.params.get("boundary") {
    Some(b) => b
    None => return Err(multipart.MultipartErr{msg: "no multipart boundary param in Content-Type"})
  }
  multipart.parse_form(r.body, boundary)
}

/// The body as Str, each byte of an invalid UTF-8 sequence as `%XX`.
fn form_text(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  let hex = "0123456789ABCDEF".bytes()
  var out = BytesBuilder.with_capacity(b.len() + 8)
  var i = 0
  while i < b.len() {
    let (c, n) = b.decode_rune(i)
    if c == '\u{FFFD}' && n == 1 {
      out.write_byte(37)
      out.write_byte(hex[Int(b[i]) >> 4])
      out.write_byte(hex[Int(b[i]) & 15])
    } else {
      out.write(b[i..i + n])
    }
    i += n
  }
  out.freeze().to_str() ?? ""
}

/// The value of field name: the Map's value under Go's canonical name, then,
/// when the lookup name is a token, a case-insensitive scan of the stored
/// names, which is the documented behavior for header names (std.md 4.3) and
/// what a struct literal's headers get whatever case they were written in. A
/// name with a byte outside a token ("a b", a tab, a control byte) matches
/// only exactly: httpguts.ValidHeaderFieldName's set is the line, since such
/// a name is canonicalized to itself and Go's Header.Get reads that key
/// alone (seeded corpus, 2026-10-26).
fn header_get(h: Map[Str, Str], name: Str) -> Str? {
  let k = http1.canonical_key(name)
  match h.get(k) {
    Some(v) => return Some(v)
    None => ()
  }
  if !cookie_token(name) {
    return None
  }
  for (f, v) in h {
    if http1.equal_fold(f, name) {
      return Some(v)
    }
  }
  None
}

fn request_header(r: Request, name: Str) -> Str? { header_get(r.headers, name) }

fn request_json[T: Json](r: Request) -> T ! js.DecodeErr { js.decode(r.body) }

fn request_with_header(r: Request, name: Str, value: Str) -> Request {
  let k = http1.canonical_key(name)
  var h = r.headers
  h.put(k, value)
  r with {headers: h, fields: without_field(r.fields, k)}
}

/// The path of a request target as sent: the target up to its query (an
/// absolute target's path after its authority).
fn target_path(target: Str) -> Str {
  var t = target
  if let Some(i) = t.find("?") {
    t = t[0..i]
  }
  if t.starts_with("http://") || t.starts_with("https://") {
    let rest = t[t.find("//").or_fault("scheme") + 2..]
    return match rest.find("/") {
      Some(j) => rest[j..]
      None => "/"
    }
  }
  t
}

fn request_host(r: Request) -> Str { r.raw_host }
fn request_tls(r: Request) -> Bool { r.over_tls }

/// The handshake's outcome of TLS connection th, none for 0 (plain),
/// read through the TLS table (decision 0244: a plain server links no
/// tlssrv, so this names only tlsneg; a direct tlssrv.negotiated call
/// here linked it, gotchas/tls-table-direct-call-links-tlssrv.md).
fn tls_neg_of(th: Int) -> List[tlsneg.Negotiated] {
  if th == 0 {
    return []
  }
  let w = rt.call_c2(hconn.tls_op(hconn.TO_NEG), th, 0)
  if w == 0 {
    return []
  }
  match rt.any_get[tlsneg.Negotiated](rt.obj_at[rt.Any](w)) {
    Some(n) => [n]
    None => []
  }
}

/// Go's r.TLS: None for a plain connection or a struct literal. The
/// server asks the client for no certificate, so peer_certificates is
/// empty.
fn request_tls_state(r: Request) -> http.TlsState? {
  if r.tls_neg.is_empty() {
    return None
  }
  let n = r.tls_neg[0]
  Some(http.TlsState{version: n.version, cipher_suite: n.cipher, server_name: n.server_name, resumed: n.resumed, peer_certificates: []})
}
fn request_raw_query(r: Request) -> Str { r.raw_query }

/// Go's URL.EscapedPath: the raw path when it unescapes to the path and
/// is a valid escaping, else the path escaped.
fn request_escaped_path(r: Request) -> Str {
  if !r.raw_path.is_empty() {
    match url.path_unescape(r.raw_path) {
      Ok(p) => {
        if p == r.path && valid_encoded_path(r.raw_path) {
          return r.raw_path
        }
      }
      Err(_) => {}
    }
  }
  escape_path_keep(r.path)
}

/// url.escape(s, encodePath): Go's EscapedPath form of a path: the
/// unreserved characters and `$&+,/:;=@` kept, everything else %XX
/// (upper case hex); std/url's path_escape is PathEscape, which escapes
/// `/` as a segment's.
fn escape_path_keep(s: Str) -> Str {
  var b = BytesBuilder.new()
  let hex = b"0123456789ABCDEF"
  var any = false
  for c in s.bytes() {
    if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 || c == 46 || c == 126 || c == 36 || c == 38 || c == 43 || c == 44 || c == 47 || c == 58 || c == 59 || c == 61 || c == 64 {
      b.write_byte(c)
    } else {
      any = true
      b.write_byte(37)
      b.write_byte(hex[Int(c) / 16])
      b.write_byte(hex[Int(c) % 16])
    }
  }
  if !any {
    return s
  }
  b.freeze().to_str() ?? s
}

/// url.go validEncoded for a path: unreserved, sub delimiters, `:@/`
/// and `%` (the escapes were checked by path_unescape).
fn valid_encoded_path(s: Str) -> Bool {
  for c in s.bytes() {
    if c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 64 || c == 91 || c == 93 || c == 37 || c == 47 {
      continue
    }
    if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 || c == 46 || c == 126 {
      continue
    }
    return false
  }
  true
}

/// Go's Redirect (server.go): the Location, resolved for a relative url.
fn redirect(req: http.Request, url0: Str, status: Int) -> http.Response {
  var u = url0
  // a url with no scheme and no host is relative to the request's path
  let has_scheme = match u.find(":") {
    Some(i) => !u[0..i].contains("/") && i > 0
    None => false
  }
  // url.Parse: `//host/x` has a host, `///x` an empty one (resolved)
  if !has_scheme && !(u.starts_with("//") && !u.starts_with("///")) {
    var oldpath = request_escaped_path(rt.cast[http.Request, Request](req))
    if oldpath.is_empty() {
      oldpath = "/"
    }
    if u.is_empty() || !u.starts_with("/") {
      // path.Split: the directory with its slash
      let olddir = match oldpath.rfind("/") {
        Some(i) => oldpath[0..i + 1]
        None => ""
      }
      u = olddir + u
    }
    var query = ""
    if let Some(i) = u.find("?") {
      query = u[i..]
      u = u[0..i]
    }
    let trailing = u.ends_with("/")
    u = path_clean(u)
    if trailing && !u.ends_with("/") {
      u = u + "/"
    }
    u = u + query
  }
  var resp = http.Response{status: status, headers: {}, body: "".bytes()}
  resp = resp.with_header("Location", hex_escape_non_ascii(u))
  if req.method == "GET" || req.method == "HEAD" {
    resp = resp.with_header("Content-Type", "text/html; charset=utf-8")
  }
  if req.method == "GET" {
    let text = http1w.status_text(status)
    resp = resp with {body: ("<a href=\"" + html_escape(u) + "\">" + text + "</a>.\n").bytes()}
  }
  resp
}

/// path.Clean (Go's path package: `.` and `..` resolved, a rooted path
/// stays rooted, "" is ".").
fn path_clean(p: Str) -> Str {
  if p.is_empty() {
    return "."
  }
  let rooted = p.starts_with("/")
  var out: List[Str] = []
  for s in p.split("/") {
    if s.is_empty() || s == "." {
      continue
    }
    if s == ".." {
      if !out.is_empty() && out[out.len() - 1] != ".." {
        out.pop()
        continue
      }
      if rooted {
        continue
      }
    }
    out.push(s)
  }
  let body = out.join("/")
  if rooted {
    return "/" + body
  }
  if body.is_empty() {
    return "."
  }
  body
}

/// net/http's hexEscapeNonASCII: every byte from 0x80 as %XX (lower case).
fn hex_escape_non_ascii(s: Str) -> Str {
  let b = s.bytes()
  var any = false
  for c in b {
    if c >= 128 {
      any = true
      break
    }
  }
  if !any {
    return s
  }
  var out = BytesBuilder.new()
  let hex = b"0123456789abcdef"
  for c in b {
    if c >= 128 {
      out.write_byte(37)
      out.write_byte(hex[Int(c) / 16])
      out.write_byte(hex[Int(c) % 16])
    } else {
      out.write_byte(c)
    }
  }
  out.freeze().to_str() ?? s
}

/// net/http's htmlEscape (the five characters).
fn html_escape(s: Str) -> Str { s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&#34;").replace("'", "&#39;") }

/// Go's Error.
fn error_page(status: Int, msg: Str) -> http.Response {
  http.Response{status: status, headers: {"Content-Type": "text/plain; charset=utf-8", "X-Content-Type-Options": "nosniff"}, body: (msg + "\n").bytes()}
}

fn not_found() -> http.Response { error_page(404, "404 page not found") }

/// An HTML error page (std.md 4.3): text/html, nosniff; the title in
/// <title> and <h1>, the detail in <p>, both escaped.
fn error_html(status: Int, title: Str, detail: Str) -> http.Response {
  let t = html_escape(title)
  let body = "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>${t}</title></head><body><h1>${t}</h1><p>${html_escape(detail)}</p></body></html>\n"
  http.Response{status: status, headers: {"Content-Type": "text/html; charset=utf-8", "X-Content-Type-Options": "nosniff"}, body: body.bytes()}
}

fn request_header_values(r: Request, name: Str) -> List[Str] { values_of(r.headers, r.fields, name) }

fn request_add_header(r: Request, name: Str, value: Str) -> Request {
  let k = http1.canonical_key(name)
  let (h, fs) = with_values(r.headers, r.fields, k, values_of(r.headers, r.fields, k) + [value])
  r with {headers: h, fields: fs}
}

fn request_with_value[T](r: Request, k: Key[T], v: T) -> Request {
  var vs = r.values
  vs.push(ReqValue{name: k.key_name, v: rt.any_of(v)})
  r with {values: vs}
}

fn request_value[T](r: Request, k: Key[T]) -> T? {
  var i = r.values.len() - 1
  while i >= 0 {
    let rv = r.values[i]
    if rv.name == k.key_name {
      match rt.any_get[T](rv.v) {
        Some(v) => return Some(v)
        None => ()
      }
    }
    i -= 1
  }
  None
}

fn key[T](name: Str) -> Key[T] { Key{key_name: name} }

fn (k: Key[T]) name() -> Str { k.key_name }

/// url.Parse of an absolute or path only URL; a URL that does not parse
/// is its text as the path (std/rt's parseURLLoose).
fn parse_url_loose(raw: Str) -> http.Url {
  url_from_parts(raw, http1.url_parts(raw, false))
}

/// parse_url_loose of raw whose url_parts are already in hand.
fn url_from_parts(raw: Str, parts: List[Str]) -> http.Url {
  if parts.is_empty() {
    return http.Url{scheme: "", host: "", port: None, path: raw, query: {}}
  }
  let path = if parts[3].is_empty() { "/" } else { parts[3] }
  var port: Int? = None
  if !parts[2].is_empty() {
    port = Int.parse(parts[2])
  }
  var query: Map[Str, Str] = {}
  if !parts[4].is_empty() {
    let q = http1.query_parts(parts[4])
    var i = 0
    while i + 1 < q.len() {
      query.put(q[i], q[i + 1])
      i += 2
    }
  }
  http.Url{scheme: parts[0], host: parts[1], port: port, path: path, query: query}
}

fn new_request(method: Str, url: Str, headers: Map[Str, Str] = {}, body: Bytes = "".bytes()) -> Request {
  let parts = http1.url_parts(url, false)
  let u = url_from_parts(url, parts)
  var h: Map[Str, Str] = {}
  for (k, v) in headers {
    h.put(http1.canonical_key(k), v)
  }
  let path = if parts.is_empty() { url } else { parts[3] }
  let raw = if parts.is_empty() { "" } else { parts[4] }
  Request{method: method.to_upper(), path: path, url: u, headers: h, body: body, remote_ip: "127.0.0.1", raw_query: raw}
}

fn parse_url(s: Str) -> http.Url ! http.UrlErr {
  let parts = http1.url_parts(s, false)
  if parts.is_empty() {
    return Err(http.UrlErr{msg: http1.url_error(s)})
  }
  if parts[0] != "http" && parts[0] != "https" {
    return Err(http.UrlErr{msg: "scheme must be http or https: ${s}"})
  }
  if parts[5].is_empty() {
    return Err(http.UrlErr{msg: "missing host: ${s}"})
  }
  url_from_parts(s, parts)
}

fn json[T: Json](status: Int, v: T) -> http.Response {
  http.Response{status: status, headers: {"Content-Type": "application/json"}, body: js.encode(v)}
}

fn text(status: Int, s: Str) -> http.Response {
  http.Response{status: status, headers: {"Content-Type": "text/plain; charset=utf-8"}, body: s.bytes()}
}

fn empty(status: Int) -> http.Response { http.Response{status: status, headers: {}, body: "".bytes()} }

// ---------------------------------------------------------------------------
// serve_content (decision 0306): net/http fs.go's serveContent,
// checkPreconditions, the ETag scanners, and parseRange, ported

/// The response Go's ServeContent writes for req from content, with
/// preset the fields set on its ResponseWriter first.
fn serve_content(req: http.Request, name: Str, modtime: Time?, content: Bytes, preset: Map[Str, Str] = {}) -> http.Response {
  var h: Map[Str, Str] = {}
  for (k, v) in preset {
    h.put(http1.canonical_key(k), v)
  }
  let mt = match modtime {
    Some(t) => if t.unix() == 0 && t.unix_millis() == 0 { None } else { Some(t) }
    None => None
  }
  // setLastModified
  if let Some(t) = mt {
    h.put("Last-Modified", http_time_text(t))
  }
  // checkPreconditions (RFC 7232 section 6)
  var ch = sc_if_match(req, h)
  if ch == 0 {
    ch = sc_if_unmodified_since(req, mt)
  }
  if ch == 2 {
    return sc_status(412, h)
  }
  let inm = sc_if_none_match(req, h)
  if inm == 2 {
    if req.method == "GET" || req.method == "HEAD" {
      return sc_not_modified(h)
    }
    return sc_status(412, h)
  }
  if inm == 0 && sc_if_modified_since(req, mt) == 2 {
    return sc_not_modified(h)
  }
  var range_req = req.headers.get("Range") ?? ""
  if !range_req.is_empty() && sc_if_range(req, h, mt) == 2 {
    range_req = ""
  }
  // the type: the preset field, the name's extension, or the content
  var ctype = h.get("Content-Type") ?? ""
  if !h.contains("Content-Type") {
    ctype = mime.type_by_extension(sc_ext(name)) ?? ""
    if ctype.is_empty() {
      ctype = mime.detect_content_type(if content.len() > 512 { content[0..512] } else { content })
    }
    h.put("Content-Type", ctype)
  }
  let size = content.len()
  var send = content
  var code = 200
  var ranges: List[(Int, Int)] = []
  match sc_parse_range(range_req, size) {
    Ok(rs) => ranges = rs
    Err(e) => {
      if e == "invalid range: failed to overlap" {
        if size != 0 {
          h.put("Content-Range", "bytes */${size}")
          return sc_error(h, e, 416)
        }
      } else {
        return sc_error(h, e, 416)
      }
    }
  }
  var total = 0
  for r in ranges {
    total += r.1
  }
  if total > size {
    // a dumb client or an attack: the ranges ignored
    ranges = []
  }
  if ranges.len() == 1 {
    let (st, n) = ranges[0]
    send = content[st..st + n]
    code = 206
    h.put("Content-Range", "bytes ${st}-${st + n - 1}/${size}")
  } else if ranges.len() > 1 {
    let boundary = sc_boundary()
    // multipart.Writer's CreatePart for each range (its fields sorted),
    // then Close
    var out = BytesBuilder.new()
    var first = true
    for (st, n) in ranges {
      out.write(if first { "--${boundary}\r\n" } else { "\r\n--${boundary}\r\n" }.bytes())
      first = false
      out.write("Content-Range: bytes ${st}-${st + n - 1}/${size}\r\nContent-Type: ${ctype}\r\n\r\n".bytes())
      out.write(content[st..st + n])
    }
    out.write("\r\n--${boundary}--\r\n".bytes())
    send = out.freeze()
    code = 206
    h.put("Content-Type", "multipart/byteranges; boundary=" + boundary)
  }
  h.put("Accept-Ranges", "bytes")
  if ranges.len() > 0 || (h.get("Content-Encoding") ?? "").is_empty() {
    h.put("Content-Length", "${send.len()}")
  }
  http.Response{status: code, headers: h, body: if req.method == "HEAD" { b"" } else { send }}
}

/// A response of status code with the fields h and no body.
fn sc_status(code: Int, h: Map[Str, Str]) -> http.Response { http.Response{status: code, headers: h, body: b""} }

/// writeNotModified: 304 without the representation's metadata.
fn sc_not_modified(h0: Map[Str, Str]) -> http.Response {
  var h = h0
  let _a = h.remove("Content-Type")
  let _b = h.remove("Content-Length")
  let _c = h.remove("Content-Encoding")
  if !(h.get("Etag") ?? "").is_empty() {
    let _d = h.remove("Last-Modified")
  }
  sc_status(304, h)
}

/// serveError: Error's text answer, without the fields meant for the
/// content (Go's default, httpservecontentkeepheaders unset).
fn sc_error(h0: Map[Str, Str], text: Str, code: Int) -> http.Response {
  var h = h0
  for k in ["Cache-Control", "Content-Encoding", "Etag", "Last-Modified"] {
    let _x = h.remove(k)
  }
  // Error: its own type and length, no ETag's precondition fields
  let _y = h.remove("Content-Length")
  h.put("Content-Type", "text/plain; charset=utf-8")
  h.put("X-Content-Type-Options", "nosniff")
  http.Response{status: code, headers: h, body: (text + "\n").bytes()}
}

/// filepath.Ext of a slash separated name.
fn sc_ext(name: Str) -> Str {
  let b = name.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    if b[i] == 46 {
      return name[i..]
    }
    i -= 1
  }
  ""
}

/// multipart.Writer's boundary: 30 random bytes in hex.
fn sc_boundary() -> Str {
  let r = llrand.next_bytes(30)
  let d = "0123456789abcdef".bytes()
  var out = b""
  for c in r {
    let x = Int(c)
    out = out + d[x >> 4..(x >> 4) + 1] + d[x & 15..(x & 15) + 1]
  }
  out.to_str() ?? ""
}

/// textproto.TrimString: ASCII spaces and tabs off both ends.
fn sc_trim(s: Str) -> Str {
  let b = s.bytes()
  var i = 0
  var j = b.len()
  while i < j && (b[i] == 32 || b[i] == 9) {
    i += 1
  }
  while j > i && (b[j - 1] == 32 || b[j - 1] == 9) {
    j -= 1
  }
  s[i..j]
}

/// scanETag: a valid ETag at the start of s (W/"x" or "x") and the rest,
/// or ("", "").
fn sc_scan_etag(s0: Str) -> (Str, Str) {
  let s = sc_trim(s0)
  let b = s.bytes()
  let start = if s.starts_with("W/") { 2 } else { 0 }
  if b.len() - start < 2 || b[start] != 34 {
    return ("", "")
  }
  var i = start + 1
  while i < b.len() {
    let c = Int(b[i])
    if c == 34 {
      return (s[0..i + 1], s[i + 1..])
    }
    if !(c == 0x21 || (c >= 0x23 && c <= 0x7E) || c >= 0x80) {
      return ("", "")
    }
    i += 1
  }
  ("", "")
}

fn sc_strong_match(a: Str, b: Str) -> Bool { a == b && !a.is_empty() && a.starts_with("\"") }

fn sc_weak_match(a: Str, b: Str) -> Bool { a.trim_prefix("W/") == b.trim_prefix("W/") }

/// checkIfMatch: 0 none, 1 true, 2 false.
fn sc_if_match(req: http.Request, h: Map[Str, Str]) -> Int {
  var im = req.headers.get("If-Match") ?? ""
  if im.is_empty() {
    return 0
  }
  let etag = h.get("Etag") ?? ""
  while true {
    im = sc_trim(im)
    if im.is_empty() {
      break
    }
    if im.starts_with(",") {
      im = im[1..]
      continue
    }
    if im.starts_with("*") {
      return 1
    }
    let (e, rest) = sc_scan_etag(im)
    if e.is_empty() {
      break
    }
    if sc_strong_match(e, etag) {
      return 1
    }
    im = rest
  }
  2
}

/// checkIfNoneMatch: 0 none, 1 true, 2 false.
fn sc_if_none_match(req: http.Request, h: Map[Str, Str]) -> Int {
  var buf = req.headers.get("If-None-Match") ?? ""
  if buf.is_empty() {
    return 0
  }
  let etag = h.get("Etag") ?? ""
  while true {
    buf = sc_trim(buf)
    if buf.is_empty() {
      break
    }
    if buf.starts_with(",") {
      buf = buf[1..]
      continue
    }
    if buf.starts_with("*") {
      return 2
    }
    let (e, rest) = sc_scan_etag(buf)
    if e.is_empty() {
      break
    }
    if sc_weak_match(e, etag) {
      return 2
    }
    buf = rest
  }
  1
}

/// checkIfUnmodifiedSince: 0 none, 1 true, 2 false (seconds compared).
fn sc_if_unmodified_since(req: http.Request, mt: Time?) -> Int {
  let v = req.headers.get("If-Unmodified-Since") ?? ""
  let m = match mt {
    Some(x_) => x_
    None => return 0
  }
  if v.is_empty() {
    return 0
  }
  let t = match http_time(v) {
    Some(x_) => x_
    None => return 0
  }
  if m.unix() <= t.unix() { 1 } else { 2 }
}

/// checkIfModifiedSince: 0 none, 1 true, 2 false.
fn sc_if_modified_since(req: http.Request, mt: Time?) -> Int {
  if req.method != "GET" && req.method != "HEAD" {
    return 0
  }
  let v = req.headers.get("If-Modified-Since") ?? ""
  let m = match mt {
    Some(x_) => x_
    None => return 0
  }
  if v.is_empty() {
    return 0
  }
  let t = match http_time(v) {
    Some(x_) => x_
    None => return 0
  }
  if m.unix() <= t.unix() { 2 } else { 1 }
}

/// checkIfRange: 0 none, 1 true, 2 false.
fn sc_if_range(req: http.Request, h: Map[Str, Str], mt: Time?) -> Int {
  if req.method != "GET" && req.method != "HEAD" {
    return 0
  }
  let ir = req.headers.get("If-Range") ?? ""
  if ir.is_empty() {
    return 0
  }
  let (e, _rest) = sc_scan_etag(ir)
  if !e.is_empty() {
    return if sc_strong_match(e, h.get("Etag") ?? "") { 1 } else { 2 }
  }
  let m = match mt {
    Some(x_) => x_
    None => return 2
  }
  let t = match http_time(ir) {
    Some(x_) => x_
    None => return 2
  }
  if t.unix() == m.unix() { 1 } else { 2 }
}

/// parseRange: the (start, length) ranges of s for a content of size,
/// or the error's text.
fn sc_parse_range(s: Str, size: Int) -> List[(Int, Int)] ! Str {
  if s.is_empty() {
    return Ok([])
  }
  if !s.starts_with("bytes=") {
    return Err("invalid range")
  }
  var out: List[(Int, Int)] = []
  var no_overlap = false
  for ra0 in s[6..].split(",") {
    let ra = sc_trim(ra0)
    if ra.is_empty() {
      continue
    }
    let dash = match ra.find("-") {
      Some(x_) => x_
      None => return Err("invalid range")
    }
    let start = sc_trim(ra[0..dash])
    let end = sc_trim(ra[dash + 1..])
    if start.is_empty() {
      if end.is_empty() || end.starts_with("-") {
        return Err("invalid range")
      }
      var i = match sc_int(end) {
        Some(x_) => x_
        None => return Err("invalid range")
      }
      if i < 0 {
        return Err("invalid range")
      }
      if i > size {
        i = size
      }
      out.push((size - i, i))
    } else {
      let i = match sc_int(start) {
        Some(x_) => x_
        None => return Err("invalid range")
      }
      if i < 0 {
        return Err("invalid range")
      }
      if i >= size {
        no_overlap = true
        continue
      }
      if end.is_empty() {
        out.push((i, size - i))
      } else {
        var j = match sc_int(end) {
          Some(x_) => x_
          None => return Err("invalid range")
        }
        if i > j {
          return Err("invalid range")
        }
        if j >= size {
          j = size - 1
        }
        out.push((i, j - i + 1))
      }
    }
  }
  if no_overlap && out.is_empty() {
    return Err("invalid range: failed to overlap")
  }
  Ok(out)
}

/// strconv.ParseInt(s, 10, 64): an optional sign then digits, in range.
fn sc_int(s: Str) -> Int? {
  let b = s.bytes()
  if b.is_empty() {
    return None
  }
  var i = 0
  var neg = false
  if b[0] == 43 || b[0] == 45 {
    neg = b[0] == 45
    i = 1
    if b.len() == 1 {
      return None
    }
  }
  var v = 0
  while i < b.len() {
    let d = Int(b[i]) - 48
    if d < 0 || d > 9 || v > (9223372036854775807 - d) / 10 {
      return None
    }
    v = v * 10 + d
    i += 1
  }
  Some(if neg { -v } else { v })
}

/// TimeFormat: "Mon, 02 Jan 2006 15:04:05 GMT" of t in UTC.
/// TimeFormat, parsed once (a lazy const, decision 0332: bench/results/time-format-cache-variants-2026-10-22.md).
const HTTP_DATE_LAYOUT: time.Layout = time.layout("{weekday:short}, {day} {month:short} {year} {hour}:{minute}:{second} GMT")

fn http_time_text(t: Time) -> Str { HTTP_DATE_LAYOUT.format(t, time.utc()) }

/// http.ParseTime: TimeFormat, RFC 850 ("Monday, 02-Jan-06 15:04:05
/// GMT"), or ANSIC ("Mon Jan _2 15:04:05 2006"), in UTC.
fn http_time(v: Str) -> Time? {
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let f = v.split(" ").filter(fn(x) { !x.is_empty() })
  var day = -1
  var mon = -1
  var year = -1
  var clock = ""
  if f.len() == 6 && f[0].ends_with(",") && f[5] == "GMT" {
    // TimeFormat
    if f[1].len() != 2 {
      return None
    }
    day = Int.parse(f[1]) ?? -1
    mon = months.index_of(f[2]) ?? -1
    year = if f[3].len() == 4 { Int.parse(f[3]) ?? -1 } else { -1 }
    clock = f[4]
  } else if f.len() == 4 && f[0].ends_with(",") && f[3] == "GMT" {
    // RFC 850
    let dmy = f[1].split("-")
    if dmy.len() != 3 || dmy[0].len() != 2 || dmy[2].len() != 2 {
      return None
    }
    day = Int.parse(dmy[0]) ?? -1
    mon = months.index_of(dmy[1]) ?? -1
    let yy = Int.parse(dmy[2]) ?? -1
    year = if yy < 0 { -1 } else if yy >= 69 { 1900 + yy } else { 2000 + yy }
    clock = f[2]
  } else if f.len() == 5 && !f[0].ends_with(",") {
    // ANSIC (a one digit day padded with a space)
    mon = months.index_of(f[1]) ?? -1
    day = Int.parse(f[2]) ?? -1
    year = if f[4].len() == 4 { Int.parse(f[4]) ?? -1 } else { -1 }
    clock = f[3]
  } else {
    return None
  }
  let hms = clock.split(":")
  if mon < 0 || day < 1 || year < 0 || hms.len() != 3 || hms.any(fn(x) { x.len() != 2 }) {
    return None
  }
  let hh = Int.parse(hms[0]) ?? -1
  let mm = Int.parse(hms[1]) ?? -1
  let ss = Int.parse(hms[2]) ?? -1
  if hh < 0 || hh > 23 || mm < 0 || mm > 59 || ss < 0 || ss > 59 {
    return None
  }
  let d = match time.date(year, mon + 1, day) {
    Ok(x) => x
    Err(_) => return None
  }
  time.instant(d, time.ClockTime{hour: hh, minute: mm, second: ss, nanos: 0}, time.utc()).ok()
}

fn response_with_header(r: http.Response, name: Str, value: Str) -> http.Response {
  let k = http1.canonical_key(name)
  let n = rt.cast[http.Response, Response](r)
  var h = n.headers
  h.put(k, value)
  rt.cast[Response, http.Response](n with {headers: h, fields: without_field(n.fields, k)})
}

/// The `Trailer` header naming names (decision 0433), forbidden ones
/// left out.
fn response_with_trailer_names(r: http.Response, names: List[Str]) -> http.Response {
  var ks: List[Str] = []
  for n in names {
    if let Some(k) = http1.trailer_key(n) {
      if !ks.contains(k) {
        ks.push(k)
      }
    }
  }
  if ks.is_empty() { r } else { response_with_header(r, "Trailer", ks.join(", ")) }
}

fn response_header_values(r: http.Response, name: Str) -> List[Str] {
  let n = rt.cast[http.Response, Response](r)
  values_of(n.headers, n.fields, name)
}

fn response_add_header(r: http.Response, name: Str, value: Str) -> http.Response {
  let k = http1.canonical_key(name)
  let n = rt.cast[http.Response, Response](r)
  let (h, fs) = with_values(n.headers, n.fields, k, values_of(n.headers, n.fields, k) + [value])
  rt.cast[Response, http.Response](n with {headers: h, fields: fs})
}

/// Go's SetCookie: one more Set-Cookie field, none for a cookie whose
/// display is "" (an invalid name).
fn response_with_cookie(r: http.Response, c: http.Cookie) -> http.Response {
  let v = cookie_display(c)
  if v.is_empty() { r } else { response_add_header(r, "Set-Cookie", v) }
}

/// Go's Response.Cookies (readSetCookies): every Set-Cookie field that
/// parses.
fn response_cookies(r: http.Response) -> List[http.Cookie] {
  let vs = response_header_values(r, "Set-Cookie")
  if vs.len() > COOKIE_MAX {
    return []
  }
  var out: List[http.Cookie] = []
  for v in vs {
    if let Ok(c) = parse_set_cookie(v) {
      out.push(c)
    }
  }
  out
}

// ---------------------------------------------------------------------------
// Fields with repeated names (decision 0288)

/// The Map view of a name's values: joined with ", ", but Set-Cookie's
/// first value (cookies are never joined).
fn field_view(k: Str, vs: List[Str]) -> Str { if k == "Set-Cookie" { vs[0] } else { vs.join(", ") } }

/// The values of field name: its fields when the Map still shows them
/// (headers[name] is their view), else the Map's one value (a literal or
/// a direct change of headers wins), else none.
fn values_of(h: Map[Str, Str], fs: List[Str], name: Str) -> List[Str] {
  let k = http1.canonical_key(name)
  let mv = match header_get(h, k) {
    Some(v) => v
    None => return []
  }
  var vs: List[Str] = []
  var i = 0
  while i + 1 < fs.len() {
    if fs[i] == k {
      vs.push(fs[i + 1])
    }
    i += 2
  }
  if !vs.is_empty() && field_view(k, vs) == mv { vs } else { [mv] }
}

/// fs without the fields of k.
fn without_field(fs: List[Str], k: Str) -> List[Str] {
  if fs.is_empty() {
    return fs
  }
  var out: List[Str] = []
  var i = 0
  while i + 1 < fs.len() {
    if fs[i] != k {
      out.push(fs[i])
      out.push(fs[i + 1])
    }
    i += 2
  }
  out
}

/// The header and fields with k's values set to vs (at least one).
fn with_values(h0: Map[Str, Str], fs0: List[Str], k: Str, vs: List[Str]) -> (Map[Str, Str], List[Str]) {
  var h = h0
  h.put(k, field_view(k, vs))
  var fs = without_field(fs0, k)
  if vs.len() > 1 {
    for v in vs {
      fs.push(k)
      fs.push(v)
    }
  }
  (h, fs)
}

/// The header and fields of a received field list [name, value, ...]
/// (canonical names; a name may repeat): the Map view of each name and,
/// when any name repeats, the list itself.
fn fields_in(list: List[Str]) -> (Map[Str, Str], List[Str]) {
  var h: Map[Str, Str] = {}
  var counts: Map[Str, Int] = {}
  var repeated = false
  var i = 0
  while i + 1 < list.len() {
    let k = list[i]
    let n = counts.get(k) ?? 0
    if n > 0 {
      repeated = true
      if k != "Set-Cookie" {
        h.put(k, (h.get(k) ?? "") + ", " + list[i + 1])
      }
    } else {
      h.put(k, list[i + 1])
    }
    counts.put(k, n + 1)
    i += 2
  }
  (h, if repeated { list } else { [] })
}

fn response_header(r: http.Response, name: Str) -> Str? { header_get(r.headers, name) }

fn response_text(r: http.Response) -> Str? { collect(r).body.to_str() }

fn response_decode_json[T: Json](r: http.Response) -> T ! js.DecodeErr { js.decode(collect(r).body) }

/// The body is produced by f while the response is sent; dispatched in
/// process it is collected (std.md 4.3, decision 0083).
fn stream[fx: Effects](status: Int, f: fn(BodyWriter) -> () ! IoErr uses fx) -> http.Response uses fx {
  let r = Response{status: status, headers: {}, body: "".bytes(), stream: hserve.stream_put(rt.any_of(f))}
  rt.cast[Response, http.Response](r)
}

/// r with a streamed body run into it (std/rt's collect); a copy may be
/// collected again.
fn collect(r0: http.Response) -> http.Response {
  let r = rt.cast[http.Response, Response](r0)
  if r.stream == 0 {
    return r0
  }
  var body = "".bytes()
  let fs = hserve.stream_get(r.stream, false)
  if !fs.is_empty() {
    if let Some(f) = rt.any_get[fn(BodyWriter) -> () ! IoErr](fs[0]) {
      let s = hserve.sink_buf()
      f(BodyWriter{s: s}).ignore_err("a stream that fails ends its body there, as std/rt's collect")
      body = hserve.sink_take(s)
    }
  }
  rt.cast[Response, http.Response](r with {body: body, stream: 0})
}

/// A trailer after the body (decision 0433): the name canonical, Go's
/// forbidden names dropped. The sink sends it (Xo Lang 3's
/// rthttp.sink_set_trailer, with HTTP/1.1's chunked trailer section and
/// HTTP/2's trailing HEADERS); until then it is dropped.
fn (w: BodyWriter) set_trailer(name: Str, value: Str) {
  if let Some(k) = http1.trailer_key(name) {
    let _ = (w, k, value)
  }
}

fn (w: BodyWriter) write(data: Bytes) -> () ! IoErr {
  if task.is_canceled() {
    return Err(IoErr.Canceled)
  }
  var out = data
  if let Some(m) = w.gz {
    out = m.with(fn(var c) { c.write(data) })
  }
  if !hserve.sink_write(w.s, out) {
    return Err(IoErr.Io(msg: "write: connection closed"))
  }
}

fn (w: BodyWriter) flush() -> () ! IoErr {
  if task.is_canceled() {
    return Err(IoErr.Canceled)
  }
  if let Some(m) = w.gz {
    // Go's Writer.Flush: everything written so far, then the sink's flush
    let out = m.with(fn(var c) { c.flush() })
    if !hserve.sink_write(w.s, out) {
      return Err(IoErr.Io(msg: "flush: connection closed"))
    }
  }
  if !hserve.sink_flush(w.s) {
    return Err(IoErr.Io(msg: "flush: connection closed"))
  }
}

// ---------------------------------------------------------------------------
// gzip_responses (std.md 4.7, decision 0305): gzhttp's rules

/// Whether Accept-Encoding allows gzip: a `gzip` or `*` element whose q is
/// not 0.
fn accepts_gzip(v: Str) -> Bool {
  for el in v.split(",") {
    let parts = el.split(";")
    let token = parts[0].trim().to_lower()
    if token != "gzip" && token != "*" {
      continue
    }
    var q = 1.0
    var i = 1
    while i < parts.len() {
      let p = parts[i].trim().to_lower()
      if p.starts_with("q=") {
        q = Float.parse(p[2..].trim()) ?? 0.0
      }
      i += 1
    }
    if q > 0.0 {
      return true
    }
  }
  false
}

/// A Content-Type whose data is compressed already.
fn compressed_type(ct: Str) -> Bool {
  let t = ct.split(";")[0].trim().to_lower()
  t.starts_with("image/") || t.starts_with("video/") || t == "application/zip" || t == "application/gzip" || t == "font/woff2"
}

fn response_without(r: http.Response, name: Str) -> http.Response {
  let k = http1.canonical_key(name)
  let n = rt.cast[http.Response, Response](r)
  var h = n.headers
  let _old = h.remove(k)
  rt.cast[Response, http.Response](n with {headers: h, fields: without_field(n.fields, k)})
}

/// The stream f with its writes compressed into the writer it gets.
fn gzip_stream(f: fn(BodyWriter) -> () ! IoErr, level: compress.Level) -> fn(BodyWriter) -> () ! IoErr {
  fn(w: BodyWriter) -> () ! IoErr {
    let m = Mutex[compress.Compressor].new(compress.compressor(compress.Format.Gzip, level: level))
    let r = f(BodyWriter{s: w.s, gz: Some(m)})
    let rest = m.with(fn(var c) { c.finish() })
    if !hserve.sink_write(w.s, rest) {
      return Err(IoErr.Io(msg: "write: connection closed"))
    }
    r
  }
}

fn gzip_response(req: Request, resp0: http.Response, min_size: Int, level: compress.Level) -> http.Response {
  let n = rt.cast[http.Response, Response](resp0)
  let status = n.status
  if status < 200 || status == 204 || status == 304 || status == 206 {
    return resp0
  }
  if response_header(resp0, "Content-Encoding") is Some(_) || response_header(resp0, "Content-Range") is Some(_) {
    return resp0
  }
  let streamed = n.stream != 0
  var ct = response_header(resp0, "Content-Type") ?? ""
  if ct.is_empty() && !streamed && !n.body.is_empty() {
    ct = mime.detect_content_type(n.body)
  }
  if compressed_type(ct) {
    return resp0
  }
  // the response depends on Accept-Encoding from here on
  var resp = resp0
  if !response_header_values(resp, "Vary").any(fn(v) { v.to_lower().contains("accept-encoding") }) {
    resp = response_add_header(resp, "Vary", "Accept-Encoding")
  }
  if !accepts_gzip(request_header(req, "Accept-Encoding") ?? "") {
    return resp
  }
  if streamed && ct.is_empty() {
    // a stream's type is not sniffed: it stays uncompressed
    return resp
  }
  if !streamed && n.body.len() < min_size {
    return resp
  }
  resp = response_with_header(resp, "Content-Encoding", "gzip")
  resp = response_without(resp, "Content-Length")
  if !ct.is_empty() {
    resp = response_with_header(resp, "Content-Type", ct)
  }
  if let Some(et) = response_header(resp, "ETag") {
    if !et.starts_with("W/") {
      resp = response_with_header(resp, "ETag", "W/" + et)
    }
  }
  let m = rt.cast[http.Response, Response](resp)
  if !streamed {
    return rt.cast[Response, http.Response](m with {body: compress.gzip(m.body, level: level)})
  }
  let fs = hserve.stream_get(m.stream, false)
  if fs.is_empty() {
    return resp
  }
  if let Some(f) = rt.any_get[fn(BodyWriter) -> () ! IoErr](fs[0]) {
    let id = hserve.stream_put(rt.any_of(gzip_stream(f, level)))
    return rt.cast[Response, http.Response](m with {stream: id})
  }
  resp
}

fn gzip_responses(min_size: Int, level: compress.Level) -> fn(http.Request, http.Next) -> http.Response {
  fn(req: http.Request, next: http.Next) -> http.Response { gzip_response(rt.cast[http.Request, Request](req), next(req), min_size, level) }
}

// ---------------------------------------------------------------------------
// Server (std.md 4.4)

fn server(l: Listener, r: Router) -> Server { Server{l: l, r: r, tls_setup: no_tls, h2: no_h2} }

fn (s: Server) addr() -> Str { s.l.addr() }

fn (s: Server) with_read_timeout(d: Duration) -> Server { s with {read_ns: if d.nanos() > 0 { d.nanos() } else { 0 }} }
fn (s: Server) with_read_header_timeout(d: Duration) -> Server { s with {head_ns: if d.nanos() > 0 { d.nanos() } else { 0 }} }
fn (s: Server) with_idle_timeout(d: Duration) -> Server { s with {idle_ns: if d.nanos() > 0 { d.nanos() } else { 0 }} }
fn (s: Server) with_max_header_bytes(n: Int) -> Server { s with {max_head: if n > 0 { n } else { 0 }} }
fn (s: Server) with_max_body(n: Int) -> Server { s with {max_body: if n > 0 { n } else { 0 }} }

/// Go's MaxBytesReader as a middleware: a body over n is 413 with Go's
/// text; a streamed body's reader is capped at n.
fn max_body(n: Int) -> fn(http.Request, http.Next) -> http.Response {
  fn(req: http.Request, next: http.Next) -> http.Response {
    if req.body.len() > n {
      return http.Response{status: 413, headers: {"Content-Type": "text/plain; charset=utf-8", "X-Content-Type-Options": "nosniff"}, body: "http: request body too large\n".bytes()}
    }
    next(req)
  }
}

fn (s: Server) with_tls(certs: List[TlsCert]) -> Server {
  // the table of the TLS server and HTTP/2 (srvtls.xo), made once
  srvtls.install()
  Server{l: s.l, r: s.r, tls: certs, tls_on: true, tls_setup: setup_tls, h2: serve_h2}
}

/// A plain server's TLS setup and HTTP/2: none (serve_h2 is never
/// reached without TLS: hserve.hc_h2 is 0).
fn no_tls(_srv: rthttp.Srv, _certs: List[TlsCert]) {}

fn no_h2(_hc: rthttp.HConn, _h2: Int, _r: Router) {}

/// The certificates of a server with TLS (with_tls).
fn setup_tls(srv: rthttp.Srv, certs: List[TlsCert]) {
  for c in certs {
    hserve.srv_tls(srv, c.c)
  }
}

fn tls_cert(cert_pem: Bytes, key_pem: Bytes) -> TlsCert ! http.TlsErr {
  let (c, e) = tlssrv.cert(cert_pem, key_pem)
  if !e.is_empty() {
    return Err(http.TlsErr{msg: e})
  }
  TlsCert{c: c}
}

fn (s: Server) serve() -> () ! http.HttpErr uses net.listen {
  // only the test world makes in memory listeners (folded elsewhere,
  // decision 0246)
  if testworld.on() && twrun.mem_listener(s.l) {
    serve_mem(s.l, s.r)
    return Ok(())
  }
  if s.tls_on && s.tls.is_empty() {
    return Err(http.HttpErr.Io(msg: "http: with_tls needs a certificate"))
  }
  let srv = hserve.srv_new()
  defer hserve.srv_close(srv)
  let setup = s.tls_setup
  setup(srv, s.tls)
  let conns = hserve.srv_group(srv)
  let l = s.l
  let r = s.r
  let h2 = s.h2
  let lim = http1.Limits{read_ns: s.read_ns, head_ns: s.head_ns, idle_ns: s.idle_ns, max_head: s.max_head, max_body: s.max_body}
  var failed = ""
  scope sc {
    sc.spawn_background(fn() {
      // a stop request (core 7.5): stop accepting, close idle
      // connections
      let _ = task.stopping().recv()
      hserve.srv_stop(srv)
      l.close()
    })
    while {
      match l.accept() {
        Ok(c) => {
          let hc = hserve.hc_new(srv, c)
          conns.spawn_background(fn() { serve_conn_isolated(hc, r, h2, lim) })
        }
        Err(NetErr.Io(msg)) => {
          if !task.stop_requested() && !task.is_canceled() {
            failed = msg
          }
          break
        }
        Err(_) => break
      }
    }
  }
  hserve.srv_stop(srv)
  hserve.srv_wait(srv)
  if !failed.is_empty() {
    return Err(http.HttpErr.Io(msg: failed))
  }
}

/// Serves an in memory listener of a test (decision 0083, std/rt's
/// memListener.serve): requests reach r in process until a stop is
/// requested (then the requests in flight finish) or the task is
/// canceled.
fn serve_mem(l: Listener, r: Router) {
  twrun.mem_serve(l, rt.any_of(r))
  defer twrun.mem_unserve(l)
  if task.stopping().recv() is None {
    twrun.mem_unserve(l)
    twrun.mem_drain(l)
  }
}

/// serve_conn with a fault in the connection's own code (not a
/// handler's, which is isolated in dispatch) ending that connection only,
/// as net/http recovers per connection ("http: panic serving"): logged,
/// the connection closed (serve_conn's defer), the server serving on. It
/// once stopped the server (gotchas/native-server-unisolated-fault-wedges.md).
fn serve_conn_isolated(hc: rthttp.HConn, r: Router, h2: fn(rthttp.HConn, Int, Router) -> (), lim: http1.Limits) {
  match task.isolate(fn() -> () ! () { serve_conn(hc, r, h2, lim) }) {
    // the message alone: the location is the runtime's, not the program's
    Err(task.Isolated.Faulted(info)) => log.error("http: panic serving", {"fault": info.msg})
    _ => ()
  }
}

/// When a TLS handshake must end (net/http's tlsHandshakeTimeout: the
/// smaller positive of the read and head timeouts), 0 for no limit.
fn handshake_deadline(lim: http1.Limits) -> Int {
  var d = lim.read_ns
  if lim.head_ns > 0 && (d == 0 || lim.head_ns < d) {
    d = lim.head_ns
  }
  if d > 0 { hconn.deadline(d) } else { 0 }
}

/// Serves the requests of one connection until it closes.
fn serve_conn(hc: rthttp.HConn, r: Router, serve_h2: fn(rthttp.HConn, Int, Router) -> (), lim: http1.Limits) {
  defer hserve.hc_close(hc)
  let h2 = hserve.hc_h2(hc, handshake_deadline(lim))
  if h2 != 0 {
    serve_h2(hc, h2, r)
    return
  }
  // a handle_stream route reads its body itself (decision 0310)
  var rd = if r.streamed { http1.reader_streaming(hc, fn(m: Str, p: Str) -> Bool { route_streams(r, m, p) }) } else { http1.reader(hc) }
  http1.set_limits(hc, lim)
  while true {
    match rd.read() {
      Some(q) => {
        var req = head_request(rd, q)
        let sq = rd.streamed()
        if sq != 0 {
          let b = conn_body(fn(max: Int) -> http1.BodyPart { http1.body_next(hc, sq, max) }, [fn() { http1.body_finish(hc, sq) }])
          req = req with {values: [ReqValue{name: STREAM_BODY, v: rt.any_of(b)}]}
        }
        let (open, resp) = respond(hc, req, r)
        let keep = match resp {
          Some(x) => http1.respond(hc, x.status, x.body)
          None => open
        }
        if !keep {
          break
        }
      }
      None => break
    }
  }
}

/// HTTP/2 (decision 0121, std/native/llrt/h2srv.xo): each request is a
/// task of its own, as net/http runs a handler per stream; the scope ends
/// when the connection does. Reached only through Server.h2, which only
/// with_tls sets (decision 0244).
fn serve_h2(hc: rthttp.HConn, h2: Int, r: Router) {
  // a handle_stream route's request comes at its HEADERS (decision 0310)
  var hp = if r.streamed { h2srv.conn_streaming(hc, h2, fn(m: Str, p: Str) -> Bool { route_streams(r, m, p) }) } else { h2srv.conn(hc, h2) }
  scope s {
    while true {
      match hp.next() {
        Some(q) => {
          s.spawn(fn() { serve_stream(q, r) })
        }
        None => break
      }
    }
  }
}

/// Serves one HTTP/2 stream. A fault in a streamed body resets the
/// stream (h2srv.end), as net/http resets it after a handler's panic;
/// the connection's other streams go on.
fn serve_stream(q: h2srv.H2Req, r: Router) {
  let st = q.conn
  defer h2srv.end(st)
  task.isolate(fn() -> Bool ! () {
    let (open, resp) = respond(st, stream_request(q), r)
    match resp {
      Some(x) => h2srv.respond(st, x.status, x.body)
      None => open
    }
  }).ignore_err("a fault resets the stream (h2srv.end)")
}

/// Answers req, read on hc (an HTTP/1.1 connection or an HTTP/2
/// stream): a streamed body goes out here, with whether the connection
/// stays open; any other response is returned for the caller to send
/// (http1.respond, or h2srv.respond in serve_stream, so the HTTP/1.1 path
/// names no HTTP/2 code, decision 0244).
fn respond(hc: rthttp.HConn, req: Request, r: Router) -> (Bool, Response?) {
  let resp = rt.cast[http.Response, Response](call_raw(r, req))
  if resp.status == 101 && resp.stream != 0 {
    // a connection hand-off (decision 0313, handoff_response: std/websocket's
    // upgrade): its function owns the connection, which closes when it
    // returns
    let fs = hserve.stream_get(resp.stream, true)
    if !fs.is_empty() {
      if let Some(f) = rt.any_get[fn(rthttp.HConn) -> ()](fs[0]) {
        f(hc)
        return (false, None)
      }
    }
  }
  if !req.values.is_empty() {
    // what the handler of a streamed body left: discarded or closing
    // (net/http's writeHeader)
    stream_finish(req)
  }
  if resp.fields.is_empty() {
    for (k, v) in resp.headers {
      http1.header_set(hc, k, v)
    }
  } else {
    // a name with several fields (decision 0288) sends each
    for (k, _) in resp.headers {
      let vs = values_of(resp.headers, resp.fields, k)
      http1.header_set(hc, k, vs[0])
      for x in vs[1..] {
        http1.header_add(hc, k, x)
      }
    }
  }
  if resp.stream != 0 {
    // a streamed body goes out as f makes it (std/rt's serve)
    let s = hserve.sink_conn(hc, resp.status)
    let fs = hserve.stream_get(resp.stream, true)
    if !fs.is_empty() {
      if let Some(f) = rt.any_get[fn(BodyWriter) -> () ! IoErr](fs[0]) {
        f(BodyWriter{s: s}).ignore_err("a stream that fails ends its body there, as net/http")
      }
    }
    return (hserve.sink_end(s), None)
  }
  (true, Some(resp))
}

/// The request of an HTTP/1.1 head read by rd (std/rt's serve).
fn head_request(rd: http1.Reader, q: http1.Req) -> Request {
  var headers: Map[Str, Str] = {}
  var i = 0
  while i + 1 < q.headers.len() {
    headers.put(q.headers[i], q.headers[i + 1])
    i += 2
  }
  var query: Map[Str, Str] = {}
  i = 0
  while i + 1 < q.query.len() {
    query.put(q.query[i], q.query[i + 1])
    i += 2
  }
  var upath = q.path
  if upath.is_empty() {
    upath = "/"
  }
  var port: Int? = None
  if q.port >= 0 {
    port = Some(q.port)
  }
  // the connection's TLS gives the scheme (Go's r.TLS; a proxy's
  // X-Forwarded-Proto reads it)
  let th = hconn.tls_of(rd.conn())
  let tls = th != 0
  let scheme = if q.scheme.is_empty() && tls { "https" } else { q.scheme }
  let url = http.Url{scheme: scheme, host: q.host, port: port, path: upath, query: query}
  Request{method: q.method, path: q.path, url: url, headers: headers, body: rd.body(), remote_ip: hconn.remote_ip(rd.conn()), raw_query: q.rawquery, fields: q.fields, raw_path: target_path(q.target), raw_host: q.rawhost, over_tls: tls, tls_neg: tls_neg_of(th)}
}

/// The request of an HTTP/2 stream (std/rt's serve).
fn stream_request(q: h2srv.H2Req) -> Request {
  http1.fault_probe(q.path, "stream")
  var headers: Map[Str, Str] = {}
  var i = 0
  while i + 1 < q.headers.len() {
    headers.put(q.headers[i], q.headers[i + 1])
    i += 2
  }
  var query: Map[Str, Str] = {}
  i = 0
  while i + 1 < q.query.len() {
    query.put(q.query[i], q.query[i + 1])
    i += 2
  }
  var upath = q.path
  if upath.is_empty() {
    upath = "/"
  }
  var port: Int? = None
  let p = http1.host_port(q.urlhost)
  if p >= 0 {
    port = Some(p)
  }
  // HTTP/2 is reached through with_tls only (decision 0244): the scheme
  // is https when the :scheme pseudo header did not say (Go's server
  // fills URL.Scheme from it; TestH2Diff on windows/amd64 printed an
  // empty one, 2026-10-29)
  let scheme = if q.scheme.is_empty() { "https" } else { q.scheme }
  let url = http.Url{scheme: scheme, host: http1.host_name(q.host), port: port, path: upath, query: query}
  let req = Request{over_tls: true, tls_neg: tls_neg_of(hconn.tls_of(q.conn)), raw_host: q.urlhost, method: q.method, path: q.path, url: url, headers: headers, body: q.body, remote_ip: hconn.remote_ip(q.conn), raw_query: q.rawquery, fields: q.fields}
  if !q.streamed {
    return req
  }
  // the body as DATA frames bring it (decision 0310 phase 2); an unread
  // rest resets the stream when the handler ends (h2srv handler_done)
  let st = q.conn
  let b = conn_body(fn(max: Int) -> http1.BodyPart { h2srv.body_next(st, max) }, [])
  req with {values: [ReqValue{name: STREAM_BODY, v: rt.any_of(b)}]}
}

// ---------------------------------------------------------------------------
// Client (std.md 4.5)

fn client(net: Net, timeout: Duration = 30s) -> Client { Client{timeout: timeout, roots: tlsio.roots_system(), lists: rt.net_lists(net)} }

fn (c: Client) with_roots(pem: Bytes) -> Client ! http.TlsErr {
  let r = tlsio.roots_pem(pem)
  let e = tlsio.roots_err(r)
  if !e.is_empty() {
    return Err(http.TlsErr{msg: e})
  }
  Client{timeout: c.timeout, roots: r, lists: c.lists, redirects: c.redirects}
}

/// The client following at most max redirects (decision 0404): 0 returns
/// a 3xx response as it came, its Location as the server sent it.
fn (c: Client) with_redirects(max: Int) -> Client { c with {redirects: if max < 0 { 0 } else { max }} }

/// The request with its own time limit in place of the client's (decision
/// 0404): the whole exchange, the body included, as Go's Client.Timeout.
fn (r: Request) with_timeout(d: Duration) -> Request { r with {timeout_ns: if d.nanos() > 0 { d.nanos() } else { 0 }} }

/// The request's limit for each read of an opened stream's body (decision
/// 0404), the client's timeout when unset.
fn (r: Request) with_idle_timeout(d: Duration) -> Request { r with {idle_ns: if d.nanos() > 0 { d.nanos() } else { 0 }} }

/// req with its streamed body read whole (FakeNet's in memory exchange).
fn src_whole(req: Request) -> Request ! http.ClientErr {
  let f = match req.src.get(0) {
    Some(g) => g
    None => return Ok(req)
  }
  var out = BytesBuilder.new()
  while true {
    let p = f(32768)
    if !p.err.is_empty() {
      return Err(http.ClientErr.Protocol(msg: p.err))
    }
    if p.end {
      break
    }
    out.write(p.data.bytes())
  }
  Ok(req with {body: out.freeze(), src: []})
}

/// The request with a body read from b as it is sent (decision 0404 stage
/// C): chunked unless the request's header gives Content-Length; never
/// sent twice (a 307 or 308 returns the 3xx, no retry on a dead pooled
/// connection).
/// The request with trailers after its body (decision 0433): hclient
/// asks trailer_fn once the body is sent (Xo Lang 3's wire part; until
/// it lands the request goes without).
fn (r: Request) with_trailers(names: List[Str], f: fn() -> Map[Str, Str]) -> Request {
  var ks: List[Str] = []
  for n in names {
    if let Some(k) = http1.trailer_key(n) {
      if !ks.contains(k) {
        ks.push(k)
      }
    }
  }
  r with {trailer_fn: [f], trailer_names: ks}
}

fn (r: Request) with_body_reader(b: http.BodyReader) -> Request {
  let f = fn(max: Int) -> http1.BodyPart {
    match b.read(max) {
      Ok(Some(d)) => {
        let t = raw.str_at(raw.bytes_addr(d), d.len())
        raw.alive(d)
        http1.BodyPart{data: t, end: false, err: ""}
      }
      Ok(None) => http1.BodyPart{data: "", end: true, err: ""}
      Err(e) => http1.BodyPart{data: "", end: false, err: "${e}"}
    }
  }
  r with {body: b"", src: [f]}
}

// ---------------------------------------------------------------------------
// A streamed response (decision 0404 stage B1)

/// http.ClientStream: the head and the body's state behind a Mutex its
/// copies share. The state holds the connection (a counted handle): when
/// the last copy goes, its free hook closes the connection unless the body
/// ended and it went to the pool.
struct ClientStream {
  hd: http.ResponseHead
  st: Mutex[StreamState]
}

struct StreamState {
  conn: rthttp.CResp?
  read: http1.BodyRead
  https: Bool
  addr: Str
  name: Str
  roots: rthttp.Roots
  /// an HTTP/2 stream's open exchange (decision 0404 stage B2)
  h2: http1.H2X?
  /// bytes received and not yet returned (an HTTP/2 DATA payload, a
  /// response read whole), and how much of them was returned
  buffered: Bytes
  off: Int
  gz: compress.Decompressor?
  /// the decoded bytes read returns next
  pending: Bytes
  done: Bool
  idle_ns: Int
  /// the response's trailers (decision 0433), set when its body ends
  trailers: Map[Str, Str] = {}
}

fn (c: Client) open(req: Request) -> http.ClientStream ! http.ClientErr uses net.dial {
  if task.is_canceled() {
    return Err(http.ClientErr.Canceled)
  }
  let raw = request_url_string(req)
  if req.url.scheme.is_empty() || req.url.host.is_empty() {
    return Err(http.ClientErr.InvalidUrl(msg: "absolute URL required: ${raw}"))
  }
  if let Some(e) = denied(c, req) {
    return Err(e)
  }
  if testworld.fake(4) {
    // FakeNet: the whole response, read as a stream
    let resp = send_mem(src_whole(req)?, raw)?
    let st = StreamState{conn: None, h2: None, read: http1.BodyRead{mode: 0, done: true}, https: false, addr: "", name: "", roots: c.roots, buffered: resp.body, off: 0, gz: None, pending: b"", done: false, idle_ns: 0}
    return Ok(rt.cast[ClientStream, http.ClientStream](ClientStream{hd: http.ResponseHead{status: resp.status, headers: resp.headers}, st: Mutex[StreamState].new(st)}))
  }
  let (names, values) = header_lists(req)
  let timeout = if req.timeout_ns > 0 { req.timeout_ns } else { c.timeout.nanos() }
  let r = http1.client_do(req.method, raw, names, values, req.body, timeout, c.roots, c.lists, c.redirects, true, req.src)
  match r.err {
    0 => ()
    1 => return Err(http.ClientErr.InvalidUrl(msg: r.msg))
    2 => return Err(http.ClientErr.Connect(msg: r.msg))
    3 => return Err(http.ClientErr.Timeout)
    5 => return Err(http.ClientErr.Canceled)
    _ => return Err(http.ClientErr.Protocol(msg: r.msg))
  }
  let (h, _) = fields_in(r.headers)
  let gz = if r.gz { Some(compress.decompressor(compress.Format.Gzip)) } else { None }
  let idle = if req.idle_ns > 0 { req.idle_ns } else { c.timeout.nanos() }
  let st = StreamState{conn: if r.open { r.conn } else { None }, h2: r.h2, read: r.read, https: r.https, addr: r.addr, name: r.name, roots: c.roots, buffered: r.body, off: 0, gz: gz, pending: b"", done: false, idle_ns: idle}
  Ok(rt.cast[ClientStream, http.ClientStream](ClientStream{hd: http.ResponseHead{status: r.status, headers: h}, st: Mutex[StreamState].new(st)}))
}

fn (s: ClientStream) head() -> http.ResponseHead { s.hd }

/// The next raw (undecoded) bytes of the body, None at its end.
fn raw_next(var s: StreamState, max: Int) -> Result[Bytes?, http.ClientErr] {
  if s.off < s.buffered.len() {
    let end = if s.buffered.len() - s.off < max { s.buffered.len() } else { s.off + max }
    let b = s.buffered[s.off..end]
    s.off = end
    return Ok(Some(b))
  }
  if let Some(x0) = s.h2 {
    var x = x0
    let r = s.conn ?? fault("http: an HTTP/2 stream without its connection")
    hclient.set_deadline(r, s.idle_ns)
    http1.h2_pump(r, x, http1.H2_TO_DATA)
    if hclient.h2_body_n(r) > 0 {
      s.h2 = Some(x)
      s.buffered = hclient.h2_take_body(r)
      s.off = 0
      return raw_next(s, max)
    }
    // the end, or a failure: the connection back to the pool
    s.h2 = None
    s.conn = None
    http1.h2_done(r, x)
    let e = hclient.err(r)
    if e == 0 {
      return Ok(None)
    }
    if e == 3 {
      return Err(http.ClientErr.Timeout)
    }
    if e == 5 {
      return Err(http.ClientErr.Canceled)
    }
    let m = hclient.msg(r)
    return Err(http.ClientErr.Protocol(msg: if m.is_empty() { "unexpected EOF" } else { m }))
  }
  match s.conn {
    None => {
      if s.off >= s.buffered.len() {
        return Ok(None)
      }
      let end = if s.buffered.len() - s.off < max { s.buffered.len() } else { s.off + max }
      let b = s.buffered[s.off..end]
      s.off = end
      Ok(Some(b))
    }
    Some(r) => {
      if s.read.done {
        return Ok(None)
      }
      hclient.set_deadline(r, s.idle_ns)
      let st = http1.cbody_next(r, s.read, max)
      if st.s != hclient.CC_OK {
        hclient.end_keep(r, false, s.https, s.addr, s.name, s.roots, st.s, "")
        s.conn = None
        s.buffered = b""
        s.read = http1.BodyRead{mode: 0, done: true}
        if st.s == hclient.CC_TIMEOUT {
          return Err(http.ClientErr.Timeout)
        }
        if st.s == hclient.CC_CANCELED {
          return Err(http.ClientErr.Canceled)
        }
        return Err(http.ClientErr.Protocol(msg: if st.why.is_empty() { "unexpected EOF" } else { st.why }))
      }
      if s.read.done {
        // the body's end: the connection to the pool if it may serve
        // another request
        hclient.end_keep(r, s.read.keep, s.https, s.addr, s.name, s.roots, hclient.CC_OK, "")
        s.conn = None
        s.buffered = b""
        if st.data.is_empty() {
          return Ok(None)
        }
      }
      Ok(Some(st.data))
    }
  }
}

/// Feeds b to the stream's gzip decoder (its output to pending), or
/// finishes it when last; the decoder moves out of s and back (move only,
/// so outside read's loop).
fn gz_step(var s: StreamState, b: Bytes, last: Bool) -> Result[(), http.ClientErr] {
  let d = s.gz
  s.gz = None
  match d {
    None => Ok(())
    Some(dec0) => {
      var dec = dec0
      if last {
        return match dec.finish() {
          Ok(rest) => {
            s.pending = rest
            Ok(())
          }
          Err(e) => Err(http.ClientErr.Protocol(msg: e.msg))
        }
      }
      match dec.write(b) {
        Ok(out) => {
          s.pending = out
          s.gz = Some(dec)
          Ok(())
        }
        Err(e) => Err(http.ClientErr.Protocol(msg: e.msg))
      }
    }
  }
}

fn (s: ClientStream) read(max: Int = 32768) -> Bytes? ! http.ClientErr uses net.dial {
  let lim = if max > 0 { max } else { 32768 }
  let r = s.st.with(fn(var x: StreamState) -> Result[Bytes?, http.ClientErr] {
    while true {
      if x.pending.len() > 0 {
        let n = if x.pending.len() < lim { x.pending.len() } else { lim }
        let out = x.pending[0..n]
        x.pending = x.pending[n..x.pending.len()]
        return Ok(Some(out))
      }
      if x.done {
        return Ok(None)
      }
      match raw_next(x, lim) {
        Err(e) => {
          x.done = true
          return Err(e)
        }
        Ok(None) => {
          x.done = true
          if x.gz is Some(_) {
            if let Err(e) = gz_step(x, b"", true) {
              return Err(e)
            }
            continue
          }
          return Ok(None)
        }
        Ok(Some(b)) => {
          if x.gz is Some(_) {
            if let Err(e) = gz_step(x, b, false) {
              x.done = true
              return Err(e)
            }
            continue
          }
          return Ok(Some(b))
        }
      }
    }
    Ok(None)
  })
  r
}

fn (s: ClientStream) read_all(max_size: Int = 1073741824) -> Bytes ! http.ClientErr uses net.dial {
  var out = BytesBuilder.new()
  while let Some(b) = s.read(65536)? {
    out.write(b)
    if out.len() > max_size {
      s.close()
      return Err(http.ClientErr.Protocol(msg: "http: response body exceeds max_size (${max_size} bytes)"))
    }
  }
  out.freeze()
}

/// The response's trailers (decision 0433): empty until read returned None.
fn (s: ClientStream) trailers() -> Map[Str, Str] {
  s.st.with(fn(var x: StreamState) { if x.done { x.trailers } else { {} } })
}

fn (s: ClientStream) close() {
  s.st.with(fn(var x: StreamState) {
    if let Some(e0) = x.h2 {
      // RST_STREAM CANCEL unless it ended; the connection stays pooled
      var e = e0
      if let Some(r) = x.conn {
        http1.h2_cancel(r, e)
        http1.h2_done(r, e)
      }
      x.h2 = None
      x.conn = None
    }
    match x.conn {
      Some(r) => {
        if x.read.done {
          hclient.end_keep(r, x.read.keep, x.https, x.addr, x.name, x.roots, hclient.CC_OK, "")
        } else {
          hclient.end_keep(r, false, x.https, x.addr, x.name, x.roots, hclient.CC_OK, "")
        }
      }
      None => ()
    }
    x.conn = None
    x.buffered = b""
    x.pending = b""
    x.gz = None
    x.done = true
  })
}

fn (c: Client) get(url: Str) -> http.Response ! http.ClientErr uses net.dial { c.send(new_request("GET", url)) }

fn (c: Client) post_json[T: Json](url: Str, v: T) -> http.Response ! http.ClientErr uses net.dial {
  c.send(new_request("POST", url, {"Content-Type": "application/json"}, js.encode(v)))
}

/// A request's header as the client sends it: each field's name and
/// value, a name with several fields once for each (decision 0288).
fn header_lists(req: Request) -> (List[Str], List[Str]) {
  var names: List[Str] = []
  var values: List[Str] = []
  for (k, v) in req.headers {
    for x in if req.fields.is_empty() { [v] } else { values_of(req.headers, req.fields, k) } {
      names.push(k)
      values.push(x)
    }
  }
  (names, values)
}

/// The query map raw parses to: each key's first value (parse_url_loose's).
fn query_map(raw: Str) -> Map[Str, Str] {
  var m: Map[Str, Str] = {}
  let q = http1.query_parts(raw)
  var i = 0
  while i + 1 < q.len() {
    m.put(q[i], q[i + 1])
    i += 2
  }
  m
}

/// The text of a request's URL: its raw query as given (Go's Client sends
/// URL.RawQuery verbatim, so repeated keys and their order survive) while
/// url.query still says what it does, else the query built from url.query.
fn request_url_string(req: Request) -> Str {
  if req.raw_query.is_empty() || query_map(req.raw_query) != req.url.query {
    return url_string(req.url)
  }
  url_string(req.url with {query: {}}) + "?" + req.raw_query
}

/// The text of a URL (std/rt's urlString).
fn url_string(u: http.Url) -> Str {
  var s = ""
  if !u.scheme.is_empty() {
    s = u.scheme + "://"
  }
  s = s + u.host
  match u.port {
    Some(p) => s = s + ":${p}"
    None => ()
  }
  s = s + u.path
  var first = true
  for (k, v) in u.query {
    if first {
      s = s + "?"
      first = false
    } else {
      s = s + "&"
    }
    s = s + http1.query_escape(k) + "=" + http1.query_escape(v)
  }
  s
}

/// An attenuated Net's refusal of req (Net.only, decision 0175): std/rt's
/// httpDenied.
fn denied(c: Client, req: Request) -> http.ClientErr? {
  if c.lists.is_empty() {
    return None
  }
  let port = match req.url.port {
    Some(p) => "${p}"
    None => if req.url.scheme.to_lower() == "https" { "443" } else { "80" }
  }
  if netpolicy.admits(c.lists, req.url.host, port) {
    return None
  }
  let hp = if req.url.host.contains(":") { "[${req.url.host}]:${port}" } else { "${req.url.host}:${port}" }
  Some(http.ClientErr.Connect(msg: "denied by Net.only: ${hp}"))
}

fn (c: Client) send(req: Request) -> http.Response ! http.ClientErr uses net.dial {
  if task.is_canceled() {
    return Err(http.ClientErr.Canceled)
  }
  let raw = request_url_string(req)
  if req.url.scheme.is_empty() || req.url.host.is_empty() {
    return Err(http.ClientErr.InvalidUrl(msg: "absolute URL required: ${raw}"))
  }
  if let Some(e) = denied(c, req) {
    return Err(e)
  }
  if testworld.fake(4) {
    // FakeNet (a test without `uses net` and `xo test --real`)
    return send_mem(src_whole(req)?, raw)
  }
  let (names, values) = header_lists(req)
  let timeout = if req.timeout_ns > 0 { req.timeout_ns } else { c.timeout.nanos() }
  let r = http1.client_do(req.method, raw, names, values, req.body, timeout, c.roots, c.lists, c.redirects, false, req.src)
  match r.err {
    0 => ()
    1 => return Err(http.ClientErr.InvalidUrl(msg: r.msg))
    2 => return Err(http.ClientErr.Connect(msg: r.msg))
    3 => return Err(http.ClientErr.Timeout)
    5 => return Err(http.ClientErr.Canceled)
    _ => return Err(http.ClientErr.Protocol(msg: r.msg))
  }
  // each received field; the Map joins a repeated name, Set-Cookie
  // excepted (decision 0288)
  let (h, fs) = fields_in(r.headers)
  rt.cast[Response, http.Response](Response{status: r.status, headers: h, body: r.body, fields: fs})
}

// ---------------------------------------------------------------------------
// The fake network of tests (decision 0083, std/rt's fakeNet.dispatch)

/// A client request in a test: the failures of FakeNet.fail and fail_next
/// first, then the FakeNet.handle handler whose route has the most
/// literal segments, then the router serving the in memory listener of
/// the URL's host and port.
fn send_mem(req: Request, raw: Str) -> http.Response ! http.ClientErr {
  testworld.record(rt.any_of(req))
  for i in 0..testworld.fake_count(1) {
    if fake_match(1, i, req, raw) is Some(_) {
      let e = rt.any_get[http.ClientErr](testworld.fake_value(1, i))
      testworld.fake_used(i)
      if let Some(err) = e {
        return Err(err)
      }
    }
  }
  var best = -1
  var best_lits = -1
  var best_params: Map[Str, Str] = {}
  for i in 0..testworld.fake_count(0) {
    if let Some((lits, params)) = fake_match(0, i, req, raw) {
      if best < 0 || lits > best_lits {
        best = i
        best_lits = lits
        best_params = params
      }
    }
  }
  if best >= 0 {
    if let Some(h) = rt.any_get[fn(Request) -> http.Response](testworld.fake_value(0, best)) {
      return h(req with {params: best_params})
    }
  }
  var hp = req.url.host
  if let Some(p) = req.url.port {
    hp = hp + ":${p}"
  }
  let found = twrun.mem_begin(hp)
  if found.is_empty() {
    return Err(http.ClientErr.Connect(msg: "no fake handler for ${req.method} ${raw}"))
  }
  defer twrun.mem_end(hp)
  match rt.any_get[Router](found[0]) {
    Some(r) => r.call(req)
    None => Err(http.ClientErr.Connect(msg: "no fake handler for ${req.method} ${raw}"))
  }
}

/// Whether handler (kind 0) or failure (1) i matches the request: the
/// number of literal segments of its route and the route's parameters.
fn fake_match(kind: Int, i: Int, req: Request, raw: Str) -> (Int, Map[Str, Str])? {
  let method = testworld.fake_text(kind, i, 0)
  if !method.is_empty() && method != req.method.to_upper() {
    return None
  }
  let prefix = testworld.fake_text(kind, i, 1)
  if !prefix.is_empty() && !raw.starts_with(prefix) {
    return None
  }
  let (_, segs) = parse_pattern(testworld.fake_text(kind, i, 2))
  let route = Route{method: "", segs: segs, h: fn(_q: Request) -> http.Response { empty(404) }}
  let parts = split_path(req.path)
  var uparts: List[Str] = List.with_capacity(parts.len())
  for p in parts {
    uparts.push(http1.path_unescape(p))
  }
  let (ok, _) = match_parts(route, uparts)
  if !ok {
    return None
  }
  Some((literals(route), bind_params(route, parts, uparts)))
}

// ---------------------------------------------------------------------------
// Cookies (std.md 4.3, decision 0288): net/http's cookie.go (go1.26.1)
// ported; a byte Go drops with a log line is dropped silently.

/// Go's Cookie.String.
fn cookie_display(c: http.Cookie) -> Str {
  if !cookie_token(c.name) {
    return ""
  }
  var b = StrBuilder.new()
  b.write(c.name)
  b.write("=")
  b.write(sanitize_cookie_value(c.value, c.quoted))
  if !c.path.is_empty() {
    b.write("; Path=")
    b.write(sanitize_bytes(c.path, false))
  }
  if !c.domain.is_empty() && valid_cookie_domain(c.domain) {
    // an invalid domain is dropped, which makes a host-only cookie; a
    // leading dot is allowed but not sent
    b.write("; Domain=")
    b.write(if c.domain.starts_with(".") { c.domain[1..] } else { c.domain })
  }
  if let Some(t) = c.expires {
    if time.civil(t, time.utc()).date.year >= 1601 {
      b.write("; Expires=")
      b.write(http_time_text(t))
    }
  }
  if c.max_age > 0 {
    b.write("; Max-Age=${c.max_age}")
  } else if c.max_age < 0 {
    b.write("; Max-Age=0")
  }
  if c.http_only {
    b.write("; HttpOnly")
  }
  if c.secure {
    b.write("; Secure")
  }
  match c.same_site {
    http.SameSite.Default => {}
    http.SameSite.None => b.write("; SameSite=None")
    http.SameSite.Lax => b.write("; SameSite=Lax")
    http.SameSite.Strict => b.write("; SameSite=Strict")
  }
  if c.partitioned {
    b.write("; Partitioned")
  }
  b.freeze()
}

/// Go's ParseCookie.
fn parse_cookie(line: Str) -> List[http.Cookie] ! http.CookieErr {
  if line.split(";").len() > COOKIE_MAX {
    return Err(http.CookieErr{msg: "http: number of cookies exceeded limit"})
  }
  let parts = cookie_trim(line).split(";")
  if parts.len() == 1 && parts[0].is_empty() {
    return Err(http.CookieErr{msg: "http: blank cookie"})
  }
  var out: List[http.Cookie] = []
  for p in parts {
    let s = cookie_trim(p)
    let (name, value) = match s.find("=") {
      Some(i) => (s[0..i], s[i + 1..])
      None => return Err(http.CookieErr{msg: "http: '=' not found in cookie"})
    }
    if !cookie_token(name) {
      return Err(http.CookieErr{msg: "http: invalid cookie name"})
    }
    let (v, quoted, ok) = parse_cookie_value(value, true)
    if !ok {
      return Err(http.CookieErr{msg: "http: invalid cookie value"})
    }
    out.push(http.Cookie{name: name, value: v, quoted: quoted})
  }
  out
}

/// Go's ParseSetCookie (without Raw, RawExpires, and Unparsed).
fn parse_set_cookie(line: Str) -> http.Cookie ! http.CookieErr {
  let parts = cookie_trim(line).split(";")
  if parts.len() == 1 && parts[0].is_empty() {
    return Err(http.CookieErr{msg: "http: blank cookie"})
  }
  let first = cookie_trim(parts[0])
  let (name0, value) = match first.find("=") {
    Some(i) => (first[0..i], first[i + 1..])
    None => return Err(http.CookieErr{msg: "http: '=' not found in cookie"})
  }
  let name = cookie_trim(name0)
  if !cookie_token(name) {
    return Err(http.CookieErr{msg: "http: invalid cookie name"})
  }
  let (v, quoted, ok) = parse_cookie_value(value, true)
  if !ok {
    return Err(http.CookieErr{msg: "http: invalid cookie value"})
  }
  var c = http.Cookie{name: name, value: v, quoted: quoted}
  for i in 1..parts.len() {
    let part = cookie_trim(parts[i])
    if part.is_empty() {
      continue
    }
    let (attr, val0) = match part.find("=") {
      Some(k) => (part[0..k], part[k + 1..])
      None => (part, "")
    }
    if !ascii_only(attr) {
      continue
    }
    let (val, _, vok) = parse_cookie_value(val0, false)
    if !vok {
      continue
    }
    let la = attr.to_lower()
    if la == "samesite" {
      c.same_site = if !ascii_only(val) { http.SameSite.Default } else {
        match val.to_lower() {
          "lax" => http.SameSite.Lax
          "strict" => http.SameSite.Strict
          "none" => http.SameSite.None
          _ => http.SameSite.Default
        }
      }
    } else if la == "secure" {
      c.secure = true
    } else if la == "httponly" {
      c.http_only = true
    } else if la == "domain" {
      c.domain = val
    } else if la == "max-age" {
      if let Some(secs) = Int.parse(val) {
        if !(secs != 0 && val.starts_with("0")) {
          c.max_age = if secs <= 0 { -1 } else { secs }
        }
      }
    } else if la == "expires" {
      c.expires = cookie_date(val)
    } else if la == "path" {
      c.path = val
    } else if la == "partitioned" {
      c.partitioned = true
    }
  }
  c
}

fn request_cookie(r: Request, name: Str) -> http.Cookie? {
  for c in read_cookies(r.headers, name) {
    return Some(c)
  }
  None
}

fn request_cookies(r: Request) -> List[http.Cookie] { read_cookies(r.headers, "") }

/// Go's AddCookie: name=value (sanitized) appended to the Cookie field.
fn request_with_cookie(r: Request, c: http.Cookie) -> Request {
  let s = "${sanitize_cookie_name(c.name)}=${sanitize_cookie_value(c.value, c.quoted)}"
  let cur = header_get(r.headers, "Cookie") ?? ""
  request_with_header(r, "Cookie", if cur.is_empty() { s } else { "${cur}; ${s}" })
}

/// Go's defaultCookieMaxNum.
const COOKIE_MAX = 3000

/// Go's readCookies over the Cookie field (several received fields are
/// joined in the Map with ", ", which is not a cookie separator: split
/// on it only between pairs).
fn read_cookies(h: Map[Str, Str], filter: Str) -> List[http.Cookie] {
  let line0 = header_get(h, "Cookie") ?? ""
  if line0.is_empty() || line0.split(";").len() > COOKIE_MAX {
    return []
  }
  var out: List[http.Cookie] = []
  for part0 in cookie_trim(line0).split(";") {
    let part = cookie_trim(part0)
    if part.is_empty() {
      continue
    }
    let (name0, val0) = match part.find("=") {
      Some(i) => (part[0..i], part[i + 1..])
      None => (part, "")
    }
    let name = cookie_trim(name0)
    if !cookie_token(name) || (!filter.is_empty() && filter != name) {
      continue
    }
    let (v, quoted, ok) = parse_cookie_value(val0, true)
    if ok {
      out.push(http.Cookie{name: name, value: v, quoted: quoted})
    }
  }
  out
}

/// Whether every byte of s is ASCII.
fn ascii_only(s: Str) -> Bool {
  for b in s.bytes() {
    if b >= 128 {
      return false
    }
  }
  true
}

/// textproto.TrimString: ASCII space and tab, CR, LF.
fn cookie_trim(s: Str) -> Str {
  let b = s.bytes()
  var i = 0
  var j = b.len()
  while i < j && (b[i] == 32 || b[i] == 9 || b[i] == 10 || b[i] == 13) {
    i += 1
  }
  while j > i && (b[j - 1] == 32 || b[j - 1] == 9 || b[j - 1] == 10 || b[j - 1] == 13) {
    j -= 1
  }
  s[i..j]
}

/// httpguts.ValidHeaderFieldName: one or more token bytes.
fn cookie_token(s: Str) -> Bool {
  if s.is_empty() {
    return false
  }
  for b in s.bytes() {
    let ok = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 33 || (b >= 35 && b <= 39) || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126
    if !ok {
      return false
    }
  }
  true
}

fn valid_cookie_value_byte(b: UInt8) -> Bool { b >= 32 && b < 127 && b != 34 && b != 59 && b != 92 }

fn valid_cookie_path_byte(b: UInt8) -> Bool { b >= 32 && b < 127 && b != 59 }

/// Go's sanitizeOrWarn: s without the bytes that are not valid (value or
/// path bytes), silently.
fn sanitize_bytes(s: Str, value: Bool) -> Str {
  var ok = true
  for b in s.bytes() {
    if !(if value { valid_cookie_value_byte(b) } else { valid_cookie_path_byte(b) }) {
      ok = false
      break
    }
  }
  if ok {
    return s
  }
  var out = BytesBuilder.with_capacity(s.len())
  for b in s.bytes() {
    if if value { valid_cookie_value_byte(b) } else { valid_cookie_path_byte(b) } {
      out.write_byte(b)
    }
  }
  out.freeze().to_str() ?? ""
}

/// Go's sanitizeCookieValue: quoted when it holds a space or a comma, or
/// came quoted.
fn sanitize_cookie_value(v: Str, quoted: Bool) -> Str {
  let s = sanitize_bytes(v, true)
  if s.contains(" ") || s.contains(",") || quoted { "\"${s}\"" } else { s }
}

/// Go's sanitizeCookieName: CR and LF as '-'.
fn sanitize_cookie_name(n: Str) -> Str { n.replace("\n", "-").replace("\r", "-") }

/// Go's parseCookieValue: the value without its quotes (when allowed),
/// whether it was quoted, and whether every byte is a cookie-octet.
fn parse_cookie_value(raw0: Str, allow_quote: Bool) -> (Str, Bool, Bool) {
  var raw = raw0
  var quoted = false
  if allow_quote && raw.len() > 1 && raw.starts_with("\"") && raw.ends_with("\"") {
    raw = raw[1..raw.len() - 1]
    quoted = true
  }
  for b in raw.bytes() {
    if !valid_cookie_value_byte(b) {
      return ("", quoted, false)
    }
  }
  (raw, quoted, true)
}

/// Go's validCookieDomain: a domain name (isCookieDomainName) or an IPv4
/// address.
fn valid_cookie_domain(v: Str) -> Bool { cookie_domain_name(v) || (!v.contains(":") && is_ipv4(v)) }

fn is_ipv4(v: Str) -> Bool {
  let parts = v.split(".")
  if parts.len() != 4 {
    return false
  }
  for p in parts {
    if p.is_empty() || p.len() > 3 || (p.len() > 1 && p.starts_with("0")) {
      return false
    }
    match Int.parse(p) {
      Some(n) => if n > 255 { return false }
      None => return false
    }
  }
  true
}

/// Go's isCookieDomainName.
fn cookie_domain_name(s0: Str) -> Bool {
  if s0.is_empty() || s0.len() > 255 {
    return false
  }
  let s = if s0.starts_with(".") { s0[1..] } else { s0 }
  var last: UInt8 = 46
  var ok = false
  var partlen = 0
  for c in s.bytes() {
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
      ok = true
      partlen += 1
    } else if c >= 48 && c <= 57 {
      partlen += 1
    } else if c == 45 {
      if last == 46 {
        return false
      }
      partlen += 1
    } else if c == 46 {
      if last == 46 || last == 45 || partlen > 63 || partlen == 0 {
        return false
      }
      partlen = 0
    } else {
      return false
    }
    last = c
  }
  if last == 45 || partlen > 63 {
    return false
  }
  ok
}

/// The weekday a cookie date names: one of the seven three letter names, in
/// any case. Go reads "wed" and "WED" and refuses "Xyz", "Wedn" and "W"
/// (measured 2026-10-26).
fn cookie_weekday_ok(w: Str) -> Bool {
  ["mon", "tue", "wed", "thu", "fri", "sat", "sun"].contains(w.to_lower())
}

/// The zone a cookie date names: whether Go's time.Parse reads all of z as
/// the zone of the cookie TimeFormat, which ends in the zone, so a partial
/// read leaves text and the date does not parse.
fn cookie_zone_ok(z: Str) -> Bool {
  let b = z.bytes()
  let used = cookie_zone_len(b)
  used > 0 && used == b.len()
}

/// cookie_zone_len: how many leading bytes Go reads as a zone, 0 when it
/// reads none. A port of parseTimeZone, parseGMT and parseSignedOffset from
/// the Go standard library (go1.26.1 src/time/format.go), over bytes:
/// "ChST" and "MeST" are the only zones with a lower case letter; "GMT" may
/// carry a sign and an hour of 23 or less; a leading sign is an hour of 23
/// or less with nothing after it; otherwise three to five capitals, where a
/// fourth of five must end in T, and a fourth may also be "WITA".
fn cookie_zone_len(b: Bytes) -> Int {
  let n = b.len()
  if n < 3 {
    return 0
  }
  // Parse's stdTZ case reads "UTC" before anything else: exactly three
  // bytes, so "UTCT" leaves "T" and the date does not parse
  if cookie_at(b, 0, "UTC") {
    return 3
  }
  if n >= 4 && (cookie_at(b, 0, "ChST") || cookie_at(b, 0, "MeST")) {
    return 4
  }
  if cookie_at(b, 0, "GMT") {
    return cookie_gmt_len(b)
  }
  if b[0] == 43 || b[0] == 45 {
    return cookie_offset_len(b)
  }
  var caps = 0
  while caps < 6 && caps < n && b[caps] >= 65 && b[caps] <= 90 {
    caps += 1
  }
  if caps == 3 {
    return 3
  }
  if caps == 4 && (b[3] == 84 || cookie_at(b, 0, "WITA")) {
    return 4
  }
  if caps == 5 && b[4] == 84 {
    return 5
  }
  0
}

/// cookie_gmt_len: parseGMT, "GMT" alone or with a signed hour of 23 or less
/// and nothing else.
fn cookie_gmt_len(b: Bytes) -> Int {
  if b.len() == 3 {
    return 3
  }
  if b[3] != 43 && b[3] != 45 {
    return 0
  }
  let (digits, hour) = cookie_leading_int(b[4..])
  if digits == 0 || hour > 23 || b.len() != 3 + 1 + digits {
    return 0
  }
  b.len()
}

/// cookie_offset_len: parseSignedOffset, a sign and an hour of 23 or less
/// with nothing after it ("+05", "-7", "+0023" read; "+0100" is 100 hours).
fn cookie_offset_len(b: Bytes) -> Int {
  let (digits, hour) = cookie_leading_int(b[1..])
  if digits == 0 || hour >= 24 || b.len() != 1 + digits {
    return 0
  }
  b.len()
}

/// cookie_leading_int: the leading ASCII digits of b, as a count and a
/// value, saturating far above every bound the callers check.
fn cookie_leading_int(b: Bytes) -> (Int, Int) {
  var i = 0
  var v = 0
  while i < b.len() && b[i] >= 48 && b[i] <= 57 {
    if v < 1000000 {
      v = v * 10 + Int(b[i]) - 48
    }
    i += 1
  }
  (i, v)
}

/// cookie_at: whether b holds lit at byte offset off.
fn cookie_at(b: Bytes, off: Int, lit: Str) -> Bool {
  let l = lit.bytes()
  if off + l.len() > b.len() {
    return false
  }
  b[off..off + l.len()] == l
}

/// An Expires value as Go's ParseSetCookie reads it with the cookie
/// TimeFormat: the date spaced ("Mon, 02 Jan 2006 15:04:05 GMT") or
/// hyphenated with a four digit year ("Mon, 02-Jan-2006 15:04:05 GMT"),
/// which Go's time.Parse accepts too. The weekday and the month must be their
/// three letter names in any case (Go's lookup folds ASCII case and reads no
/// longer name), and the zone must be one Go's parser
/// reads in full (cookie_zone_ok), so "wed" and "UTC" read where "Xyz" and
/// "gmt" do not; the time is taken as UTC, which is Go's reading of a zone
/// it does not name (measured 2026-10-26). A two digit year (RFC 850), a
/// date with no zone, and the ANSIC form come back as no Expires at all
/// rather than an error, which is what Go does. Else None.
fn cookie_date(v: Str) -> Time? {
  let (wd, rest) = match v.find(", ") {
    Some(i) => (v[0..i], v[i + 2..])
    None => return None
  }
  if !cookie_weekday_ok(wd) {
    return None
  }
  let f = rest.split(" ")
  // five fields after the weekday, or three: Go's own parser is lenient
  // about the separators, so "09-Jun-2021" reads the same as "09 Jun 2021",
  // but the zone is the fifth field and a date without one is not a date
  if f.len() != 5 && f.len() != 3 {
    return None
  }
  if !cookie_zone_ok(f[f.len() - 1]) {
    return None
  }
  let dmy = if f.len() == 5 { [f[0], f[1], f[2]] } else { f[0].split("-") }
  let clock = if f.len() == 5 { f[3] } else { f[1] }
  if dmy.len() != 3 || dmy[0].len() != 2 {
    return None
  }
  // Go's month lookup folds ASCII case ("JUN", "jun" and "juN" read) and
  // takes the three letter names only: "June" matches "Jun" and leaves "e",
  // which the layout's next space does not read, so the date does not parse
  let months = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
  var month = 0
  for (i, m) in months.indexed() {
    if m == dmy[1].to_lower() {
      month = i + 1
    }
  }
  let hms = clock.split(":")
  if month == 0 || hms.len() != 3 || dmy[2].len() != 4 {
    return None
  }
  let day = Int.parse(dmy[0]) ?? -1
  let year = Int.parse(dmy[2]) ?? -1
  let h = Int.parse(hms[0]) ?? -1
  let m = Int.parse(hms[1]) ?? -1
  let s = Int.parse(hms[2]) ?? -1
  if day < 0 || year < 0 || h < 0 || h > 23 || m < 0 || m > 59 || s < 0 || s > 59 {
    return None
  }
  let d = match time.date(year, month, day) {
    Ok(x) => x
    Err(_) => return None
  }
  time.instant(d, time.ClockTime{hour: h, minute: m, second: s, nanos: 0}, time.utc()).ok()
}

// ---------------------------------------------------------------------------
// The client's address behind trusted proxies (std.md 4.3)

/// An address as a peer or a hop gives it: bare, `[v6]`, `[v6%zone]:port`,
/// or `v4:port`; unmapped (an IPv4-mapped IPv6 address is its IPv4 one).
fn hop_addr(s0: Str) -> netip.Addr? {
  var s = s0.trim()
  if s.starts_with("[") {
    let end = s.find("]")?
    s = s[1..end]
  } else if s.split(":").len() == 2 {
    // v4:port (a bare IPv6 address has more colons)
    s = s.split(":")[0]
  }
  match netip.parse_addr(s) {
    Ok(a) => Some(a.unmap())
    Err(_) => None
  }
}

fn trusted_addr(a: netip.Addr, trusted: List[netip.Prefix]) -> Bool { trusted.any(fn(p) { p.contains(a) }) }

/// s split on sep outside quoted strings (quotes and escapes kept).
fn split_quoted(s: Str, sep: Rune) -> List[Str] {
  var out: List[Str] = []
  var cur = ""
  var quoted = false
  var esc = false
  for c in s.runes() {
    if esc {
      esc = false
    } else if quoted && c == '\\' {
      esc = true
    } else if c == '"' {
      quoted = !quoted
    } else if c == sep && !quoted {
      out.push(cur)
      cur = ""
      continue
    }
    cur = cur + "${c}"
  }
  out.push(cur)
  out
}

/// A quoted-string's content (escapes removed), or s itself.
fn unquote_param(s0: Str) -> Str {
  let s = s0.trim()
  if s.len() < 2 || !s.starts_with("\"") || !s.ends_with("\"") {
    return s
  }
  var out = ""
  var esc = false
  for c in s[1..s.len() - 1].runes() {
    if !esc && c == '\\' {
      esc = true
      continue
    }
    esc = false
    out = out + "${c}"
  }
  out
}

/// The `for=` values of Forwarded fields (RFC 7239), in order: elements
/// on commas and parameters on semicolons outside quoted strings, the
/// value unquoted; "" for an element without one.
fn forwarded_fors(fields: List[Str]) -> List[Str] {
  var out: List[Str] = []
  for f in fields {
    for e in split_quoted(f, ',') {
      var v = ""
      for p in split_quoted(e, ';') {
        match p.find("=") {
          Some(i) => {
            if p[0..i].trim().to_lower() == "for" {
              v = unquote_param(p[i + 1..])
            }
          }
          None => {}
        }
      }
      out.push(v)
    }
  }
  out
}

fn request_client_ip(r: Request, trusted: List[netip.Prefix] = [], header: http.ProxyHeader = http.ProxyHeader.XForwardedFor) -> netip.Addr? {
  let peer = hop_addr(r.remote_ip)?
  if trusted.is_empty() || !trusted_addr(peer, trusted) {
    return Some(peer)
  }
  let hops = match header {
    XForwardedFor => {
      var hs: List[Str] = []
      for f in request_header_values(r, "X-Forwarded-For") {
        for h in f.split(",") {
          hs.push(h.trim())
        }
      }
      hs
    }
    Forwarded => forwarded_fors(request_header_values(r, "Forwarded"))
  }
  // from the right: the first hop that is not a trusted address ends the
  // walk: the client when it parses, else None (a hidden, unknown, or
  // missing hop means the client is unknown, and the hops on its left
  // came from that client; garbage would let a client shift the walk)
  var leftmost: netip.Addr? = None
  var i = hops.len() - 1
  while i >= 0 {
    let h = hops[i]
    i -= 1
    let a = hop_addr(h)?
    if !trusted_addr(a, trusted) {
      return Some(a)
    }
    leftmost = Some(a)
  }
  // every hop trusted: the leftmost (a trusted proxy appended it); no
  // hops: the peer
  leftmost ?? Some(peer)
}

// Plain error messages (decision 0358); std/rt/errtext_http.go prints the same.
fn httperr_display(e: http.HttpErr) -> Str {
  match e {
    http.HttpErr.Io(msg) => msg
    http.HttpErr.Canceled => "canceled"
  }
}

fn clienterr_display(e: http.ClientErr) -> Str {
  match e {
    http.ClientErr.InvalidUrl(msg) => "invalid URL: ${msg}"
    http.ClientErr.Connect(msg) => msg
    http.ClientErr.Timeout => "request timed out"
    http.ClientErr.Protocol(msg) => "protocol error: ${msg}"
    http.ClientErr.Canceled => "canceled"
  }
}

fn urlerr_display(e: http.UrlErr) -> Str { e.msg }

fn cookieerr_display(e: http.CookieErr) -> Str { e.msg }

fn tlserr_display(e: http.TlsErr) -> Str { e.msg }
// ---------------------------------------------------------------------------
// A reverse proxy (decision 0404 stage D; net/http/httputil ReverseProxy
// with Rewrite, SetURL and SetXForwarded)

/// The header fields that belong to one connection (httputil's
/// hopHeaders), removed both ways.
const HOP_HEADERS: List[Str] = ["Connection", "Proxy-Connection", "Keep-Alive", "Proxy-Authenticate", "Proxy-Authorization", "Te", "Trailer", "Transfer-Encoding", "Upgrade"]

/// h without the hop-by-hop fields and the names its Connection field
/// lists (httputil's removeHopByHopHeaders).
fn without_hop(h: Map[Str, Str]) -> Map[Str, Str] {
  var out = h
  if let Some(c) = h.get("Connection") {
    for f in c.split(",") {
      let n = http1.canonical_key(f.trim())
      if !n.is_empty() {
        let _ = out.remove(n)
      }
    }
  }
  for n in HOP_HEADERS {
    let _ = out.remove(n)
  }
  out
}

/// The protocol h asks to switch to: its Upgrade field when its
/// Connection field lists upgrade (httputil's upgradeType), else "".
fn upgrade_type(h: Map[Str, Str]) -> Str {
  let c = h.get("Connection") ?? ""
  for t in c.split(",") {
    if t.trim().to_lower() == "upgrade" {
      return h.get("Upgrade") ?? ""
    }
  }
  ""
}

/// Whether s is printable ASCII (httputil's ascii.IsPrint).
fn printable_ascii(s: Str) -> Bool {
  for b in s.bytes() {
    if Int(b) < 32 || Int(b) > 126 {
      return false
    }
  }
  true
}

fn go_quote_s(s: Str) -> Str { "\"" + s + "\"" }

/// A 101 from the target (httputil's handleUpgradeResponse): the
/// protocol must be the one asked for (else 502); the client's
/// connection is handed over (decision 0319's hand-off), the 101 written
/// with the target's header as it came, then bytes are copied both ways
/// until either side ends.
fn tunnel(st: http.ClientStream, head: http.ResponseHead, req_up: Str) -> http.Response uses net.dial {
  let res_up = upgrade_type(head.headers)
  if !printable_ascii(res_up) {
    log.error("http: proxy error", {"error": "backend tried to switch to invalid protocol ${go_quote_s(res_up)}"})
    st.close()
    return http.empty(502)
  }
  if res_up.to_lower() != req_up.to_lower() {
    log.error("http: proxy error", {"error": "backend tried to switch protocol ${go_quote_s(res_up)} when ${go_quote_s(req_up)} was requested"})
    st.close()
    return http.empty(502)
  }
  let cs = rt.cast[http.ClientStream, ClientStream](st)
  let up_conn = cs.st.with(fn(var x: StreamState) -> rthttp.CResp? { x.conn })
  // the hand-off runs with the request's effects (websocket.xo's rule)
  handoff_response(rt.launder1(fn(h: rthttp.HConn) -> () uses net.dial {
    var text = "HTTP/1.1 101 Switching Protocols\r\n"
    for (k, v) in head.headers {
      text = text + k + ": " + v + "\r\n"
    }
    text = text + "\r\n"
    if !hconn.send_at(h, raw.data(text), text.len()) {
      st.close()
      return
    }
    raw.alive_str(text)
    let r = match up_conn {
      Some(c) => c
      None => {
        hconn.shut_wr(h)
        st.close()
        return
      }
    }
    // what the server read past the request's head goes first
    let rest = http1.take_rest(h)
    if rest.len() > 0 && hclient.send_chunk(r, rest, false, false) != hclient.CC_OK {
      st.close()
      return
    }
    scope s {
      // the client to the target
      s.spawn(fn() {
        let b = raw.bytes_buf(32768)
        while true {
          // not idle: a stop waits for the pass-through (decision 0429)
          let n = hconn.recv(h, raw.bytes_addr(b), 32768, false)
          if n <= 0 {
            break
          }
          if hclient.send_chunk(r, raw.bytes_len(b, n), false, false) != hclient.CC_OK {
            break
          }
        }
        raw.alive(b)
        hclient.shut_wr(r)
      })
      // the target to the client
      loop: while true {
        match st.read(65536) {
          Ok(Some(d)) => {
            let ok = hconn.send_at(h, raw.bytes_addr(d), d.len())
            raw.alive(d)
            if !ok {
              break loop
            }
          }
          _ => break loop
        }
      }
      hconn.shut_wr(h)
    }
    st.close()
  }))
}

/// a and b joined with one slash (httputil's singleJoiningSlash).
fn joining_slash(a: Str, b: Str) -> Str {
  let aslash = a.ends_with("/")
  let bslash = b.starts_with("/")
  if aslash && bslash {
    return a + b[1..b.len()]
  }
  if !aslash && !bslash {
    return a + "/" + b
  }
  a + b
}

/// http.ReverseProxy: the client (redirects off), the target, and the
/// rewrite hooks (none or one).
struct ReverseProxy {
  c: Client
  target: http.Url
  rewrite: List[fn(http.Request, http.Request) -> http.Request]
}

pub fn reverse_proxy(client: http.Client, target: http.Url) -> http.ReverseProxy {
  rt.cast[ReverseProxy, http.ReverseProxy](ReverseProxy{c: rt.cast[http.Client, Client](client).with_redirects(0), target: target, rewrite: []})
}

fn (p: ReverseProxy) with_rewrite(f: fn(http.Request, http.Request) -> http.Request) -> http.ReverseProxy {
  rt.cast[ReverseProxy, http.ReverseProxy](p with {rewrite: [f]})
}

fn (p: ReverseProxy) serve(req0: http.Request, body: http.BodyReader) -> http.Response uses net.dial {
  let target = p.target
  let c = p.c
  let req = rt.cast[http.Request, Request](req0)
  // SetURL: the target's scheme and host, its path joined before the
  // request's, the queries merged; Host is the target's
  var u = target
  u.path = joining_slash(target.path, req.url.path)
  var q = target.query
  for (k, v) in req.url.query {
    q.put(k, v)
  }
  u.query = q
  // a protocol switch the client asks for (Upgrade with Connection:
  // upgrade) survives the hop-by-hop removal (decision 0404 stage E)
  let up = upgrade_type(req.headers)
  if !up.is_empty() && !printable_ascii(up) {
    return http.text(400, "client tried to switch to invalid protocol ${go_quote_s(up)}")
  }
  var h = without_hop(req.headers)
  if !up.is_empty() {
    h.put("Connection", "Upgrade")
    h.put("Upgrade", up)
  }
  // SetXForwarded after the incoming X-Forwarded-* are dropped (Rewrite's
  // rule: a client cannot forge the chain; a rewrite hook that trusts it
  // copies it from in)
  let _ = h.remove("X-Forwarded-For")
  let _ = h.remove("X-Forwarded-Host")
  let _ = h.remove("X-Forwarded-Proto")
  h.put("X-Forwarded-For", req.remote_ip)
  if let Some(host) = req.headers.get("Host") {
    h.put("X-Forwarded-Host", host)
  }
  h.put("X-Forwarded-Proto", if req.url.scheme.is_empty() { "http" } else { req.url.scheme })
  let _ = h.remove("Host")
  var out = rt.cast[Request, http.Request](req with {url: u, headers: h, fields: [], body: b""})
  if let Some(f) = p.rewrite.get(0) {
    out = f(req0, out)
  }
  let sent = rt.cast[http.Request, Request](out).with_body_reader(body)
  match c.open(sent) {
    Err(e) => {
      log.error("http: proxy error", {"error": e.display()})
      return http.empty(if e is http.ClientErr.Timeout { 504 } else { 502 })
    }
    Ok(st) => {
      let head = st.head()
      if head.status == 101 {
        return tunnel(st, head, up)
      }
      let rh = without_hop(head.headers)
      // a body without a length or an event stream is flushed as it
      // arrives (FlushInterval -1)
      let flush = !rh.contains("Content-Length") || (rh.get("Content-Type") ?? "").starts_with("text/event-stream")
      var resp = http.stream(head.status, fn(w: http.BodyWriter) -> () ! IoErr uses net.dial {
        loop: while true {
          match st.read(65536) {
            Ok(Some(b)) => {
              w.write(b)?
              if flush {
                w.flush()?
              }
            }
            Ok(None) => break loop
            Err(e) => {
              st.close()
              return Err(IoErr.Io(msg: "${e}"))
            }
          }
        }
        st.close()
        Ok(())
      })
      resp with {headers: rh}
    }
  }
}
