// AES (FIPS 197) and AES-GCM (NIST SP 800-38D) for TLS (work item B31,
// decision 0202), as Go's crypto/aes and crypto/cipher's GCM with a 12
// byte nonce and a 16 byte tag (Seal appends the tag). Constant time
// (decision 0222, ct.xo): AES is BearSSL's bitsliced aes_ct64 (four
// blocks at a time in eight words, the S-box as Boyar and Peralta's
// circuit, no table indexed by a secret) and GHASH is BearSSL's
// ghash_ctmul64 (carryless products from integer multiplications with
// holes; arm64's and x86-64's 64 bit multiplies take a fixed time).
// Branches and indexes depend on lengths only; open compares the tag's
// two words before it decrypts (their differences or'd, one test, as
// ct.xo's bytes_equal). With the CPU's AES rounds and
// carry-less multiply (decision 0231, cpu.xo; cpu.hw() says whether this
// CPU has them) encryption and GHASH take them instead.
use native/llrt/cpu
use native/llrt/raw
use native/rt

/// An expanded AES key: the rounds, the bitsliced round keys (eight
/// words per round), the round keys in FIPS 197's byte order (two words
/// per round) for the CPU's rounds, and cpu.hw().
pub struct Cipher {
  nr: Int
  sk: List[Int]
  rk: List[Int]
  hw: Int
}

/// An AES-GCM key: the cipher and GHASH's key H (h1 its first 8 bytes
/// big endian, h0 the last; the r forms bit reversed, the 2 forms their
/// xor).
pub struct Gcm {
  c: Cipher
  hw: Int
  h0: Int
  h1: Int
  h2: Int
  h0r: Int
  h1r: Int
  h2r: Int
  // with the CPU's multiply: H^4, H^3, H^2, and H, each as (h0, h1,
  // h0 ^ h1), so ghash_hw folds four blocks into one reduction
  hk: List[Int]
}

fn shl(x: Int, s: Int) -> Int { x.wrapping_shl(s) }

fn shr(x: Int, s: Int) -> Int { x.shr_logical(s) }

/// The 4 bytes of b at i, little endian.
fn le32(b: Bytes, i: Int) -> Int { Int(b[i]) | shl(Int(b[i + 1]), 8) | shl(Int(b[i + 2]), 16) | shl(Int(b[i + 3]), 24) }

/// The 8 bytes of b at i, big endian.
fn be64(b: Bytes, i: Int) -> Int { rt.bytes_word(b, i).swap_bytes() }

// ---------------------------------------------------------------------------
// The bitsliced AES core (BearSSL aes_ct64.c and aes_ct64_enc.c)

/// The S-box on the eight bit planes of q (Boyar and Peralta, "A new
/// combinational logic minimization technique with applications to
/// cryptology"; x0 is the high bit).
fn sbox(var q: List[Int]) {
  let x0 = q[7]
  let x1 = q[6]
  let x2 = q[5]
  let x3 = q[4]
  let x4 = q[3]
  let x5 = q[2]
  let x6 = q[1]
  let x7 = q[0]
  // top linear transformation
  let y14 = x3 ^ x5
  let y13 = x0 ^ x6
  let y9 = x0 ^ x3
  let y8 = x0 ^ x5
  let t0 = x1 ^ x2
  let y1 = t0 ^ x7
  let y4 = y1 ^ x3
  let y12 = y13 ^ y14
  let y2 = y1 ^ x0
  let y5 = y1 ^ x6
  let y3 = y5 ^ y8
  let t1 = x4 ^ y12
  let y15 = t1 ^ x5
  let y20 = t1 ^ x1
  let y6 = y15 ^ x7
  let y10 = y15 ^ t0
  let y11 = y20 ^ y9
  let y7 = x7 ^ y11
  let y17 = y10 ^ y11
  let y19 = y10 ^ y8
  let y16 = t0 ^ y11
  let y21 = y13 ^ y16
  let y18 = x0 ^ y16
  // non-linear section
  let t2 = y12 & y15
  let t3 = y3 & y6
  let t4 = t3 ^ t2
  let t5 = y4 & x7
  let t6 = t5 ^ t2
  let t7 = y13 & y16
  let t8 = y5 & y1
  let t9 = t8 ^ t7
  let t10 = y2 & y7
  let t11 = t10 ^ t7
  let t12 = y9 & y11
  let t13 = y14 & y17
  let t14 = t13 ^ t12
  let t15 = y8 & y10
  let t16 = t15 ^ t12
  let t17 = t4 ^ t14
  let t18 = t6 ^ t16
  let t19 = t9 ^ t14
  let t20 = t11 ^ t16
  let t21 = t17 ^ y20
  let t22 = t18 ^ y19
  let t23 = t19 ^ y21
  let t24 = t20 ^ y18
  let t25 = t21 ^ t22
  let t26 = t21 & t23
  let t27 = t24 ^ t26
  let t28 = t25 & t27
  let t29 = t28 ^ t22
  let t30 = t23 ^ t24
  let t31 = t22 ^ t26
  let t32 = t31 & t30
  let t33 = t32 ^ t24
  let t34 = t23 ^ t33
  let t35 = t27 ^ t33
  let t36 = t24 & t35
  let t37 = t36 ^ t34
  let t38 = t27 ^ t36
  let t39 = t29 & t38
  let t40 = t25 ^ t39
  let t41 = t40 ^ t37
  let t42 = t29 ^ t33
  let t43 = t29 ^ t40
  let t44 = t33 ^ t37
  let t45 = t42 ^ t41
  let z0 = t44 & y15
  let z1 = t37 & y6
  let z2 = t33 & x7
  let z3 = t43 & y16
  let z4 = t40 & y1
  let z5 = t29 & y7
  let z6 = t42 & y11
  let z7 = t45 & y17
  let z8 = t41 & y10
  let z9 = t44 & y12
  let z10 = t37 & y3
  let z11 = t33 & y4
  let z12 = t43 & y13
  let z13 = t40 & y5
  let z14 = t29 & y2
  let z15 = t42 & y9
  let z16 = t45 & y14
  let z17 = t41 & y8
  // bottom linear transformation
  let t46 = z15 ^ z16
  let t47 = z10 ^ z11
  let t48 = z5 ^ z13
  let t49 = z9 ^ z10
  let t50 = z2 ^ z12
  let t51 = z2 ^ z5
  let t52 = z7 ^ z8
  let t53 = z0 ^ z3
  let t54 = z6 ^ z7
  let t55 = z16 ^ z17
  let t56 = z12 ^ t48
  let t57 = t50 ^ t53
  let t58 = z4 ^ t46
  let t59 = z3 ^ t54
  let t60 = t46 ^ t57
  let t61 = z14 ^ t57
  let t62 = t52 ^ t58
  let t63 = t49 ^ t58
  let t64 = z4 ^ t59
  let t65 = t61 ^ t62
  let t66 = z1 ^ t63
  let s0 = t59 ^ t63
  let s6 = t56 ^ ~t62
  let s7 = t48 ^ ~t60
  let t67 = t64 ^ t65
  let s3 = t53 ^ t66
  let s4 = t51 ^ t66
  let s5 = t47 ^ t65
  let s1 = t64 ^ ~s3
  let s2 = t55 ^ ~t67
  q[7] = s0
  q[6] = s1
  q[5] = s2
  q[4] = s3
  q[3] = s4
  q[2] = s5
  q[1] = s6
  q[0] = s7
}

/// Swaps the bits of q[i] and q[j] that cl and its complement select, s
/// apart.
fn swapn(var q: List[Int], i: Int, j: Int, cl: Int, s: Int) {
  let a = q[i]
  let b = q[j]
  q[i] = (a & cl) | shl(b & cl, s)
  q[j] = shr(a & ~cl, s) | (b & ~cl)
}

/// Transposes q between bytes and bit planes (its own inverse).
fn ortho(var q: List[Int]) {
  swapn(q, 0, 1, 0x5555555555555555, 1)
  swapn(q, 2, 3, 0x5555555555555555, 1)
  swapn(q, 4, 5, 0x5555555555555555, 1)
  swapn(q, 6, 7, 0x5555555555555555, 1)
  swapn(q, 0, 2, 0x3333333333333333, 2)
  swapn(q, 1, 3, 0x3333333333333333, 2)
  swapn(q, 4, 6, 0x3333333333333333, 2)
  swapn(q, 5, 7, 0x3333333333333333, 2)
  swapn(q, 0, 4, 0x0F0F0F0F0F0F0F0F, 4)
  swapn(q, 1, 5, 0x0F0F0F0F0F0F0F0F, 4)
  swapn(q, 2, 6, 0x0F0F0F0F0F0F0F0F, 4)
  swapn(q, 3, 7, 0x0F0F0F0F0F0F0F0F, 4)
}

/// The 4 bytes of the 32 bit x, one per 16 bit lane (interleave_in).
fn spread(x0: Int) -> Int {
  let x = (x0 | shl(x0, 16)) & 0x0000FFFF0000FFFF
  (x | shl(x, 8)) & 0x00FF00FF00FF00FF
}

/// spread's inverse on the bytes x keeps (interleave_out).
fn gather(x0: Int) -> Int {
  let x = (x0 | shr(x0, 8)) & 0x0000FFFF0000FFFF
  (x | shr(x, 16)) & 0xFFFFFFFF
}

/// The S-box on each byte of the 32 bit x (the key schedule's SubWord).
fn sub_word(x: Int) -> Int {
  var q = [x, 0, 0, 0, 0, 0, 0, 0]
  ortho(q)
  sbox(q)
  ortho(q)
  q[0] & 0xFFFFFFFF
}

/// The bitsliced round keys of the 32 bit words c holds in its lanes.
fn expand(var sk: List[Int], c: Int) {
  let x0 = c & 0x1111111111111111
  let x1 = shr(c & 0x2222222222222222, 1)
  let x2 = shr(c & 0x4444444444444444, 2)
  let x3 = shr(c & ~0x7777777777777777, 3)
  sk.push(shl(x0, 4).wrapping_sub(x0))
  sk.push(shl(x1, 4).wrapping_sub(x1))
  sk.push(shl(x2, 4).wrapping_sub(x2))
  sk.push(shl(x3, 4).wrapping_sub(x3))
}

/// The AES key schedule of a 16, 24, or 32 byte key (the caller checks
/// the length).
pub fn new(key: Bytes) -> Cipher { schedule(key, true) }

/// new, the bitsliced round keys (sk: the encryption without AES
/// instructions, and every decryption) only when bitsliced is true or
/// the CPU has no AES instructions: AES-GCM only encrypts, and with
/// them its keys need only rk (the bitsliced schedule was about 55,000
/// instructions of a TLS handshake on arm64; 2026-10-18).
fn schedule(key: Bytes, bitsliced: Bool) -> Cipher {
  let nk = key.len() / 4
  let nr = nk + 6
  let nkf = 4 * (nr + 1)
  var w: List[Int] = []
  for i in 0..nk {
    w.push(le32(key, 4 * i))
  }
  let rcon = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36]
  var tmp = w[nk - 1]
  var j = 0
  var k = 0
  for i in nk..nkf {
    if j == 0 {
      tmp = (shl(tmp, 24) | shr(tmp, 8)) & 0xFFFFFFFF
      tmp = sub_word(tmp) ^ rcon[k]
    } else if nk > 6 && j == 4 {
      tmp = sub_word(tmp)
    }
    tmp = tmp ^ w[i - nk]
    w.push(tmp)
    j += 1
    if j == nk {
      j = 0
      k += 1
    }
  }
  var rk = raw.zero_ints(2 * (nr + 1))
  for r in 0..nr + 1 {
    rk[2 * r] = w[4 * r] | shl(w[4 * r + 1], 32)
    rk[2 * r + 1] = w[4 * r + 2] | shl(w[4 * r + 3], 32)
  }
  var sk: List[Int] = []
  let hw = cpu.hw()
  var q = [0, 0, 0, 0, 0, 0, 0, 0]
  var i = if bitsliced || (hw & cpu.HW_AES) == 0 { 0 } else { nkf }
  while i < nkf {
    q[0] = spread(w[i]) | shl(spread(w[i + 2]), 8)
    q[4] = spread(w[i + 1]) | shl(spread(w[i + 3]), 8)
    q[1] = q[0]
    q[2] = q[0]
    q[3] = q[0]
    q[5] = q[4]
    q[6] = q[4]
    q[7] = q[4]
    ortho(q)
    expand(sk, (q[0] & 0x1111111111111111) | (q[1] & 0x2222222222222222) | (q[2] & 0x4444444444444444) | (q[3] & ~0x7777777777777777))
    expand(sk, (q[4] & 0x1111111111111111) | (q[5] & 0x2222222222222222) | (q[6] & 0x4444444444444444) | (q[7] & ~0x7777777777777777))
    i += 4
  }
  Cipher{nr: nr, sk: sk, rk: rk, hw: hw}
}

fn add_round_key(var q: List[Int], sk: List[Int], o: Int) {
  for i in 0..8 {
    q[i] = q[i] ^ sk[o + i]
  }
}

fn shift_rows(var q: List[Int]) {
  for i in 0..8 {
    let x = q[i]
    q[i] = (x & 0xFFFF) | shr(x & 0x00000000FFF00000, 4) | shl(x & 0x00000000000F0000, 12) | shr(x & 0x0000FF0000000000, 8) | shl(x & 0x000000FF00000000, 8) | shr(x & ~0x0FFFFFFFFFFFFFFF, 12) | shl(x & 0x0FFF000000000000, 4)
  }
}

fn mix_columns(var q: List[Int]) {
  let q0 = q[0]
  let q1 = q[1]
  let q2 = q[2]
  let q3 = q[3]
  let q4 = q[4]
  let q5 = q[5]
  let q6 = q[6]
  let q7 = q[7]
  let r0 = q0.rotate_right(16)
  let r1 = q1.rotate_right(16)
  let r2 = q2.rotate_right(16)
  let r3 = q3.rotate_right(16)
  let r4 = q4.rotate_right(16)
  let r5 = q5.rotate_right(16)
  let r6 = q6.rotate_right(16)
  let r7 = q7.rotate_right(16)
  q[0] = q7 ^ r7 ^ r0 ^ (q0 ^ r0).rotate_right(32)
  q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ (q1 ^ r1).rotate_right(32)
  q[2] = q1 ^ r1 ^ r2 ^ (q2 ^ r2).rotate_right(32)
  q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ (q3 ^ r3).rotate_right(32)
  q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ (q4 ^ r4).rotate_right(32)
  q[5] = q4 ^ r4 ^ r5 ^ (q5 ^ r5).rotate_right(32)
  q[6] = q5 ^ r5 ^ r6 ^ (q6 ^ r6).rotate_right(32)
  q[7] = q6 ^ r6 ^ r7 ^ (q7 ^ r7).rotate_right(32)
}

/// Encrypts the four blocks of io in place, block b's bytes as the
/// little endian words io[2b] (bytes 0 to 7) and io[2b + 1] (8 to 15).
/// encrypt4 when only the first blocks (1 to 4) of io are wanted: the
/// CPU's rounds encrypt just those (a tag's one counter block, a
/// record's last chunk), the bitsliced code all four.
fn encrypt_n(c: Cipher, var io: List[Int], blocks: Int) {
  if (c.hw & cpu.HW_AES) != 0 {
    return hw_n(c, io, blocks)
  }
  encrypt4(c, io)
}

fn encrypt4(c: Cipher, var io: List[Int]) {
  if (c.hw & cpu.HW_AES) != 0 {
    return hw4(c, io)
  }
  var q = [0, 0, 0, 0, 0, 0, 0, 0]
  for b in 0..4 {
    let lo = io[2 * b]
    let hi = io[2 * b + 1]
    q[b] = spread(lo & 0xFFFFFFFF) | shl(spread(hi & 0xFFFFFFFF), 8)
    q[b + 4] = spread(shr(lo, 32)) | shl(spread(shr(hi, 32)), 8)
  }
  ortho(q)
  add_round_key(q, c.sk, 0)
  for u in 1..c.nr {
    sbox(q)
    shift_rows(q)
    mix_columns(q)
    add_round_key(q, c.sk, 8 * u)
  }
  sbox(q)
  shift_rows(q)
  add_round_key(q, c.sk, 8 * c.nr)
  ortho(q)
  for b in 0..4 {
    let w0 = gather(q[b] & 0x00FF00FF00FF00FF)
    let w1 = gather(q[b + 4] & 0x00FF00FF00FF00FF)
    let w2 = gather(shr(q[b], 8) & 0x00FF00FF00FF00FF)
    let w3 = gather(shr(q[b + 4], 8) & 0x00FF00FF00FF00FF)
    io[2 * b] = w0 | shl(w1, 32)
    io[2 * b + 1] = w2 | shl(w3, 32)
  }
}

/// The address of the first word of xs (valid while xs is alive and not
/// resized).
fn addr(xs: List[Int]) -> Int { rt.obj_addr(xs).wrapping_add(rt.layout(2)) }

/// A use of xs after its last raw access.
fn keep(xs: List[Int]) {
  if xs.len() < 0 {
    return
  }
}

/// encrypt4 with the CPU's rounds (cpu.aes_round and aes_last), each
/// block in place in io's words (a list its callers made, so not
/// shared), the round keys walked by address with wrapping arithmetic
/// (no checks in the loop).
fn hw4(c: Cipher, var io: List[Int]) { hw_n(c, io, 4) }

/// hw4 of the first blocks (1 to 4) of io only.
fn hw_n(c: Cipher, var io: List[Int], blocks: Int) {
  let kp = addr(c.rk)
  var st = addr(io)
  let end = st.wrapping_add(16 * blocks)
  let nr = c.nr
  while st != end {
    // the whole block in one unrolled intrinsic: the state stays in a
    // register
    match nr {
      10 => cpu.aes_enc10(st, kp)
      12 => cpu.aes_enc12(st, kp)
      _ => cpu.aes_enc14(st, kp)
    }
    st = st.wrapping_add(16)
  }
  keep(io)
  keep(c.rk)
}

/// The encryption of the 16 byte block b (crypto/aes's Encrypt).
pub fn (c: Cipher) encrypt_block(b: Bytes) -> Bytes {
  var io = [rt.bytes_word(b, 0), rt.bytes_word(b, 8), 0, 0, 0, 0, 0, 0]
  encrypt_n(c, io, 1)
  rt.rs_push_word(rt.rs_push_word(rt.rs_with_cap(16), io[0], 8), io[1], 8).bytes()
}

// ---------------------------------------------------------------------------
// Decryption (BearSSL aes_ct64_dec.c), for the TLS 1.2 CBC suites

/// The inverse S-box on the bit planes: the S-box between the inverse of
/// its affine map, B(S(B(x))) (the 0x63 constants cancel; BearSSL's
/// br_aes_ct64_bitslice_invSbox).
fn inv_sbox(var q: List[Int]) {
  inv_affine(q)
  sbox(q)
  inv_affine(q)
}

fn inv_affine(var q: List[Int]) {
  let q0 = ~q[0]
  let q1 = ~q[1]
  let q2 = q[2]
  let q3 = q[3]
  let q4 = q[4]
  let q5 = ~q[5]
  let q6 = ~q[6]
  let q7 = q[7]
  q[7] = q1 ^ q4 ^ q6
  q[6] = q0 ^ q3 ^ q5
  q[5] = q7 ^ q2 ^ q4
  q[4] = q6 ^ q1 ^ q3
  q[3] = q5 ^ q0 ^ q2
  q[2] = q4 ^ q7 ^ q1
  q[1] = q3 ^ q6 ^ q0
  q[0] = q2 ^ q5 ^ q7
}

fn inv_shift_rows(var q: List[Int]) {
  for i in 0..8 {
    let x = q[i]
    q[i] = (x & 0xFFFF) | shl(x & 0x000000000FFF0000, 4) | shr(x & 0x00000000F0000000, 12) | shl(x & 0x000000FF00000000, 8) | shr(x & 0x0000FF0000000000, 8) | shl(x & 0x000F000000000000, 12) | shr(x & ~0x000FFFFFFFFFFFFF, 4)
  }
}

/// x with its 32 bit halves swapped.
fn rotr32(x: Int) -> Int { x.rotate_right(32) }

fn inv_mix_columns(var q: List[Int]) {
  let q0 = q[0]
  let q1 = q[1]
  let q2 = q[2]
  let q3 = q[3]
  let q4 = q[4]
  let q5 = q[5]
  let q6 = q[6]
  let q7 = q[7]
  let r0 = q0.rotate_right(16)
  let r1 = q1.rotate_right(16)
  let r2 = q2.rotate_right(16)
  let r3 = q3.rotate_right(16)
  let r4 = q4.rotate_right(16)
  let r5 = q5.rotate_right(16)
  let r6 = q6.rotate_right(16)
  let r7 = q7.rotate_right(16)
  q[0] = q5 ^ q6 ^ q7 ^ r0 ^ r5 ^ r7 ^ rotr32(q0 ^ q5 ^ q6 ^ r0 ^ r5)
  q[1] = q0 ^ q5 ^ r0 ^ r1 ^ r5 ^ r6 ^ r7 ^ rotr32(q1 ^ q5 ^ q7 ^ r1 ^ r5 ^ r6)
  q[2] = q0 ^ q1 ^ q6 ^ r1 ^ r2 ^ r6 ^ r7 ^ rotr32(q0 ^ q2 ^ q6 ^ r2 ^ r6 ^ r7)
  q[3] = q0 ^ q1 ^ q2 ^ q5 ^ q6 ^ r0 ^ r2 ^ r3 ^ r5 ^ rotr32(q0 ^ q1 ^ q3 ^ q5 ^ q6 ^ q7 ^ r0 ^ r3 ^ r5 ^ r7)
  q[4] = q1 ^ q2 ^ q3 ^ q5 ^ r1 ^ r3 ^ r4 ^ r5 ^ r6 ^ r7 ^ rotr32(q1 ^ q2 ^ q4 ^ q5 ^ q7 ^ r1 ^ r4 ^ r5 ^ r6)
  q[5] = q2 ^ q3 ^ q4 ^ q6 ^ r2 ^ r4 ^ r5 ^ r6 ^ r7 ^ rotr32(q2 ^ q3 ^ q5 ^ q6 ^ r2 ^ r5 ^ r6 ^ r7)
  q[6] = q3 ^ q4 ^ q5 ^ q7 ^ r3 ^ r5 ^ r6 ^ r7 ^ rotr32(q3 ^ q4 ^ q6 ^ q7 ^ r3 ^ r6 ^ r7)
  q[7] = q4 ^ q5 ^ q6 ^ r4 ^ r6 ^ r7 ^ rotr32(q4 ^ q5 ^ q7 ^ r4 ^ r7)
}

/// Decrypts the four blocks of io in place (encrypt4's layout).
fn decrypt4(c: Cipher, var io: List[Int]) {
  var q = [0, 0, 0, 0, 0, 0, 0, 0]
  for b in 0..4 {
    let lo = io[2 * b]
    let hi = io[2 * b + 1]
    q[b] = spread(lo & 0xFFFFFFFF) | shl(spread(hi & 0xFFFFFFFF), 8)
    q[b + 4] = spread(shr(lo, 32)) | shl(spread(shr(hi, 32)), 8)
  }
  ortho(q)
  add_round_key(q, c.sk, 8 * c.nr)
  var u = c.nr - 1
  while u > 0 {
    inv_shift_rows(q)
    inv_sbox(q)
    add_round_key(q, c.sk, 8 * u)
    inv_mix_columns(q)
    u -= 1
  }
  inv_shift_rows(q)
  inv_sbox(q)
  add_round_key(q, c.sk, 0)
  ortho(q)
  for b in 0..4 {
    let w0 = gather(q[b] & 0x00FF00FF00FF00FF)
    let w1 = gather(q[b + 4] & 0x00FF00FF00FF00FF)
    let w2 = gather(shr(q[b], 8) & 0x00FF00FF00FF00FF)
    let w3 = gather(shr(q[b + 4], 8) & 0x00FF00FF00FF00FF)
    io[2 * b] = w0 | shl(w1, 32)
    io[2 * b + 1] = w2 | shl(w3, 32)
  }
}

/// The decryption of the 16 byte block b (crypto/aes's Decrypt).
pub fn (c: Cipher) decrypt_block(b: Bytes) -> Bytes {
  var io = [rt.bytes_word(b, 0), rt.bytes_word(b, 8), 0, 0, 0, 0, 0, 0]
  decrypt4(c, io)
  rt.rs_push_word(rt.rs_push_word(rt.rs_with_cap(16), io[0], 8), io[1], 8).bytes()
}

/// CBC encryption of data (a multiple of 16 bytes) under iv (16 bytes):
/// one block a pass, each chained to the last.
pub fn (c: Cipher) cbc_encrypt(iv: Bytes, data: Bytes) -> Bytes {
  var out = rt.rs_with_cap(data.len())
  var p0 = rt.bytes_word(iv, 0)
  var p1 = rt.bytes_word(iv, 8)
  var i = 0
  while i < data.len() {
    var io = [rt.bytes_word(data, i) ^ p0, rt.bytes_word(data, i + 8) ^ p1, 0, 0, 0, 0, 0, 0]
    encrypt4(c, io)
    p0 = io[0]
    p1 = io[1]
    out = rt.rs_push_word(rt.rs_push_word(out, p0, 8), p1, 8)
    i += 16
  }
  out.bytes()
}

/// CBC decryption of data (a multiple of 16 bytes) under iv (16 bytes):
/// four blocks a pass.
pub fn (c: Cipher) cbc_decrypt(iv: Bytes, data: Bytes) -> Bytes {
  var out = rt.rs_with_cap(data.len())
  var p0 = rt.bytes_word(iv, 0)
  var p1 = rt.bytes_word(iv, 8)
  let n = data.len() / 16
  var b = 0
  while b < n {
    let k = if n - b < 4 { n - b } else { 4 }
    var io = [0, 0, 0, 0, 0, 0, 0, 0]
    for j in 0..k {
      io[2 * j] = rt.bytes_word(data, 16 * (b + j))
      io[2 * j + 1] = rt.bytes_word(data, 16 * (b + j) + 8)
    }
    decrypt4(c, io)
    for j in 0..k {
      out = rt.rs_push_word(rt.rs_push_word(out, io[2 * j] ^ p0, 8), io[2 * j + 1] ^ p1, 8)
      p0 = rt.bytes_word(data, 16 * (b + j))
      p1 = rt.bytes_word(data, 16 * (b + j) + 8)
    }
    b += k
  }
  out.bytes()
}

// ---------------------------------------------------------------------------
// GHASH (BearSSL ghash_ctmul64.c)

/// The carryless product of x and y, its low 64 bits: four strided
/// integer products, each keeping one bit in four.
fn bmul(x: Int, y: Int) -> Int {
  let x0 = x & 0x1111111111111111
  let x1 = x & 0x2222222222222222
  let x2 = x & 0x4444444444444444
  let x3 = x & ~0x7777777777777777
  let y0 = y & 0x1111111111111111
  let y1 = y & 0x2222222222222222
  let y2 = y & 0x4444444444444444
  let y3 = y & ~0x7777777777777777
  let z0 = x0.wrapping_mul(y0) ^ x1.wrapping_mul(y3) ^ x2.wrapping_mul(y2) ^ x3.wrapping_mul(y1)
  let z1 = x0.wrapping_mul(y1) ^ x1.wrapping_mul(y0) ^ x2.wrapping_mul(y3) ^ x3.wrapping_mul(y2)
  let z2 = x0.wrapping_mul(y2) ^ x1.wrapping_mul(y1) ^ x2.wrapping_mul(y0) ^ x3.wrapping_mul(y3)
  let z3 = x0.wrapping_mul(y3) ^ x1.wrapping_mul(y2) ^ x2.wrapping_mul(y1) ^ x3.wrapping_mul(y0)
  (z0 & 0x1111111111111111) | (z1 & 0x2222222222222222) | (z2 & 0x4444444444444444) | (z3 & ~0x7777777777777777)
}

/// The bits of x reversed.
fn rev64(x0: Int) -> Int {
  var x = x0
  x = shl(x & 0x5555555555555555, 1) | (shr(x, 1) & 0x5555555555555555)
  x = shl(x & 0x3333333333333333, 2) | (shr(x, 2) & 0x3333333333333333)
  x = shl(x & 0x0F0F0F0F0F0F0F0F, 4) | (shr(x, 4) & 0x0F0F0F0F0F0F0F0F)
  x = shl(x & 0x00FF00FF00FF00FF, 8) | (shr(x, 8) & 0x00FF00FF00FF00FF)
  x = shl(x & 0x0000FFFF0000FFFF, 16) | (shr(x, 16) & 0x0000FFFF0000FFFF)
  x.rotate_right(32)
}

/// (y1, y0) times H with the CPU's carry-less multiply: the three
/// Karatsuba products whole (the halves BearSSL's code gets from bit
/// reversed products), then the same reduction.
fn (g: Gcm) mul_hw(y1: Int, y0: Int) -> (Int, Int) {
  let y2 = y0 ^ y1
  let a0 = cpu.clmul_lo(y0, g.h0)
  let b0 = cpu.clmul_hi(y0, g.h0)
  let a1 = cpu.clmul_lo(y1, g.h1)
  let b1 = cpu.clmul_hi(y1, g.h1)
  let z2l = cpu.clmul_lo(y2, g.h2) ^ a0 ^ a1
  let z2h = cpu.clmul_hi(y2, g.h2) ^ b0 ^ b1
  reduce(a0, b0 ^ z2l, a1 ^ z2h, b1)
}

/// (y1, y0) xor the block (w1, w0), times H.
fn (g: Gcm) mul(y1a: Int, y0a: Int) -> (Int, Int) {
  if (g.hw & cpu.HW_CLMUL) != 0 {
    return g.mul_hw(y1a, y0a)
  }
  let y0 = y0a
  let y1 = y1a
  let y0r = rev64(y0)
  let y1r = rev64(y1)
  let y2 = y0 ^ y1
  let y2r = y0r ^ y1r
  let z0 = bmul(y0, g.h0)
  let z1 = bmul(y1, g.h1)
  let z2 = bmul(y2, g.h2) ^ z0 ^ z1
  let z0h = bmul(y0r, g.h0r)
  let z1h = bmul(y1r, g.h1r)
  let z2h = bmul(y2r, g.h2r) ^ z0h ^ z1h
  let v0a = z0
  let v1a = shr(rev64(z0h), 1) ^ z2
  let v2a = z1 ^ shr(rev64(z2h), 1)
  let v3a = shr(rev64(z1h), 1)
  reduce(v0a, v1a, v2a, v3a)
}

/// The 256 bit product (v3a, v2a, v1a, v0a, bit reflected) shifted by
/// one and reduced modulo GHASH's polynomial.
fn reduce(v0a: Int, v1a: Int, v2a: Int, v3a: Int) -> (Int, Int) {
  let v3 = shl(v3a, 1) | shr(v2a, 63)
  var v2 = shl(v2a, 1) | shr(v1a, 63)
  var v1 = shl(v1a, 1) | shr(v0a, 63)
  let v0 = shl(v0a, 1)
  v2 = v2 ^ v0 ^ shr(v0, 1) ^ shr(v0, 2) ^ shr(v0, 7)
  v1 = v1 ^ shl(v0, 63) ^ shl(v0, 62) ^ shl(v0, 57)
  let v3b = v3 ^ v1 ^ shr(v1, 1) ^ shr(v1, 2) ^ shr(v1, 7)
  v2 = v2 ^ shl(v1, 63) ^ shl(v1, 62) ^ shl(v1, 57)
  (v3b, v2)
}

/// ghash with the CPU's carry-less multiply: a free function over H's
/// words (no Gcm passed per block), the products and the reduction in
/// the loop, wrapping indexes.
fn ghash_hw(g: Gcm, y1a: Int, y0a: Int, b: Bytes, n: Int) -> (Int, Int) {
  var y1 = y1a
  var y0 = y0a
  var i = 0
  // four blocks a reduction: (y ^ b1) H^4 ^ b2 H^3 ^ b3 H^2 ^ b4 H, the
  // 256 bit products summed before reducing (it is linear); the powers
  // and the data read by address, one block's products at a time (few
  // values live)
  let hp = addr(g.hk)
  let bp = raw.bytes_addr(b)
  while i.wrapping_add(64) <= n {
    let d = bp.wrapping_add(i)
    let x1_0 = y1 ^ rt.mem_load(d, 0, 8).swap_bytes()
    let x0_0 = y0 ^ rt.mem_load(d, 8, 8).swap_bytes()
    let p0_0 = rt.mem_load(hp, 0, 8)
    let p1_0 = rt.mem_load(hp, 8, 8)
    let p2_0 = rt.mem_load(hp, 16, 8)
    let a0_0 = cpu.clmul_lo(x0_0, p0_0)
    let b0_0 = cpu.clmul_hi(x0_0, p0_0)
    let a1_0 = cpu.clmul_lo(x1_0, p1_0)
    let b1_0 = cpu.clmul_hi(x1_0, p1_0)
    let x2_0 = x0_0 ^ x1_0
    let c0_0 = cpu.clmul_lo(x2_0, p2_0)
    let c1_0 = cpu.clmul_hi(x2_0, p2_0)
    let x1_1 = rt.mem_load(d, 16, 8).swap_bytes()
    let x0_1 = rt.mem_load(d, 24, 8).swap_bytes()
    let p0_1 = rt.mem_load(hp, 24, 8)
    let p1_1 = rt.mem_load(hp, 32, 8)
    let p2_1 = rt.mem_load(hp, 40, 8)
    let a0_1 = a0_0 ^ cpu.clmul_lo(x0_1, p0_1)
    let b0_1 = b0_0 ^ cpu.clmul_hi(x0_1, p0_1)
    let a1_1 = a1_0 ^ cpu.clmul_lo(x1_1, p1_1)
    let b1_1 = b1_0 ^ cpu.clmul_hi(x1_1, p1_1)
    let x2_1 = x0_1 ^ x1_1
    let c0_1 = c0_0 ^ cpu.clmul_lo(x2_1, p2_1)
    let c1_1 = c1_0 ^ cpu.clmul_hi(x2_1, p2_1)
    let x1_2 = rt.mem_load(d, 32, 8).swap_bytes()
    let x0_2 = rt.mem_load(d, 40, 8).swap_bytes()
    let p0_2 = rt.mem_load(hp, 48, 8)
    let p1_2 = rt.mem_load(hp, 56, 8)
    let p2_2 = rt.mem_load(hp, 64, 8)
    let a0_2 = a0_1 ^ cpu.clmul_lo(x0_2, p0_2)
    let b0_2 = b0_1 ^ cpu.clmul_hi(x0_2, p0_2)
    let a1_2 = a1_1 ^ cpu.clmul_lo(x1_2, p1_2)
    let b1_2 = b1_1 ^ cpu.clmul_hi(x1_2, p1_2)
    let x2_2 = x0_2 ^ x1_2
    let c0_2 = c0_1 ^ cpu.clmul_lo(x2_2, p2_2)
    let c1_2 = c1_1 ^ cpu.clmul_hi(x2_2, p2_2)
    let x1_3 = rt.mem_load(d, 48, 8).swap_bytes()
    let x0_3 = rt.mem_load(d, 56, 8).swap_bytes()
    let p0_3 = rt.mem_load(hp, 72, 8)
    let p1_3 = rt.mem_load(hp, 80, 8)
    let p2_3 = rt.mem_load(hp, 88, 8)
    let a0_3 = a0_2 ^ cpu.clmul_lo(x0_3, p0_3)
    let b0_3 = b0_2 ^ cpu.clmul_hi(x0_3, p0_3)
    let a1_3 = a1_2 ^ cpu.clmul_lo(x1_3, p1_3)
    let b1_3 = b1_2 ^ cpu.clmul_hi(x1_3, p1_3)
    let x2_3 = x0_3 ^ x1_3
    let c0_3 = c0_2 ^ cpu.clmul_lo(x2_3, p2_3)
    let c1_3 = c1_2 ^ cpu.clmul_hi(x2_3, p2_3)
    let a0 = a0_3
    let b0 = b0_3
    let a1 = a1_3
    let b1 = b1_3
    let c0 = c0_3
    let c1 = c1_3
    let z2l = c0 ^ a0 ^ a1
    let z2h = c1 ^ b0 ^ b1
    // reduce, inline
    let v1a = b0 ^ z2l
    let v2a = a1 ^ z2h
    let s3 = shl(b1, 1) | shr(v2a, 63)
    var s2 = shl(v2a, 1) | shr(v1a, 63)
    var s1 = shl(v1a, 1) | shr(a0, 63)
    let s0 = shl(a0, 1)
    s2 = s2 ^ s0 ^ shr(s0, 1) ^ shr(s0, 2) ^ shr(s0, 7)
    s1 = s1 ^ shl(s0, 63) ^ shl(s0, 62) ^ shl(s0, 57)
    y1 = s3 ^ s1 ^ shr(s1, 1) ^ shr(s1, 2) ^ shr(s1, 7)
    y0 = s2 ^ shl(s1, 63) ^ shl(s1, 62) ^ shl(s1, 57)
    i = i.wrapping_add(64)
  }
  keep(g.hk)
  let h0 = g.h0
  let h1 = g.h1
  let h2 = g.h2
  while i < n {
    var w1 = 0
    var w0 = 0
    if i.wrapping_add(16) <= n {
      w1 = be64(b, i)
      w0 = be64(b, i.wrapping_add(8))
    } else {
      // the last block, zero padded
      let j = i.wrapping_add(8)
      w1 = if j <= n { be64(b, i) } else { tail_word(b, i, n).swap_bytes() }
      w0 = if j < n { tail_word(b, j, n).swap_bytes() } else { 0 }
    }
    let x1 = y1 ^ w1
    let x0 = y0 ^ w0
    let x2 = x0 ^ x1
    let a0 = cpu.clmul_lo(x0, h0)
    let b0 = cpu.clmul_hi(x0, h0)
    let a1 = cpu.clmul_lo(x1, h1)
    let b1 = cpu.clmul_hi(x1, h1)
    let z2l = cpu.clmul_lo(x2, h2) ^ a0 ^ a1
    let z2h = cpu.clmul_hi(x2, h2) ^ b0 ^ b1
    // reduce, inline
    let v1a = b0 ^ z2l
    let v2a = a1 ^ z2h
    let v3 = shl(b1, 1) | shr(v2a, 63)
    var v2 = shl(v2a, 1) | shr(v1a, 63)
    var v1 = shl(v1a, 1) | shr(a0, 63)
    let v0 = shl(a0, 1)
    v2 = v2 ^ v0 ^ shr(v0, 1) ^ shr(v0, 2) ^ shr(v0, 7)
    v1 = v1 ^ shl(v0, 63) ^ shl(v0, 62) ^ shl(v0, 57)
    y1 = v3 ^ v1 ^ shr(v1, 1) ^ shr(v1, 2) ^ shr(v1, 7)
    y0 = v2 ^ shl(v1, 63) ^ shl(v1, 62) ^ shl(v1, 57)
    i = i.wrapping_add(16)
  }
  (y1, y0)
}

/// GHASH of the first n bytes of b (zero padded to a block) after the
/// state (y1, y0).
fn (g: Gcm) ghash(y1a: Int, y0a: Int, b: Bytes, n: Int) -> (Int, Int) {
  if (g.hw & cpu.HW_CLMUL) != 0 {
    return ghash_hw(g, y1a, y0a, b, n)
  }
  var y1 = y1a
  var y0 = y0a
  var i = 0
  while n - i >= 16 {
    let (a1, a0) = g.mul(y1 ^ be64(b, i), y0 ^ be64(b, i + 8))
    y1 = a1
    y0 = a0
    i += 16
  }
  if i < n {
    var t = rt.rs_append_bytes(rt.rs_with_cap(16), b, i, n, 0)
    for _ in 0..16 - (n - i) {
      t = rt.rs_push_byte(t, 0)
    }
    let tb = t.bytes()
    let (a1, a0) = g.mul(y1 ^ be64(tb, 0), y0 ^ be64(tb, 8))
    y1 = a1
    y0 = a0
  }
  (y1, y0)
}

// ---------------------------------------------------------------------------
// GCM

/// The AES-GCM key of a 16, 24, or 32 byte AES key.
pub fn new_gcm(key: Bytes) -> Gcm {
  let c = schedule(key, false)
  var io = [0, 0, 0, 0, 0, 0, 0, 0]
  encrypt4(c, io)
  let h1 = io[0].swap_bytes()
  let h0 = io[1].swap_bytes()
  let h0r = rev64(h0)
  let h1r = rev64(h1)
  let g = Gcm{c: c, hw: c.hw, h0: h0, h1: h1, h2: h0 ^ h1, h0r: h0r, h1r: h1r, h2r: h0r ^ h1r, hk: []}
  if (c.hw & cpu.HW_CLMUL) == 0 {
    return g
  }
  let (q1, q0) = g.mul(h1, h0)
  let (r1, r0) = g.mul(q1, q0)
  let (t1, t0) = g.mul(r1, r0)
  Gcm{c: c, hw: c.hw, h0: h0, h1: h1, h2: h0 ^ h1, h0r: h0r, h1r: h1r, h2r: h0r ^ h1r, hk: [t0, t1, t0 ^ t1, r0, r1, r0 ^ r1, q0, q1, q0 ^ q1, h0, h1, h0 ^ h1]}
}

/// The first n bytes of src xor the key stream from counter ctr (32
/// bits, big endian after the 12 byte nonce), written in place into s0,
/// a new empty string with room for n + 8 bytes (a word at a time, the
/// last one past n; the length is set to n).
fn (g: Gcm) ctr(s0: Str, nonce: Bytes, ctr0: Int, src: Bytes, n: Int) -> Str { g.ctr_w(s0, rt.bytes_word(nonce, 0), le32(nonce, 8), ctr0, src, n) }

/// ctr with the nonce as its two little endian words: bytes 0 to 7, and
/// 8 to 11 in the low half.
fn (g: Gcm) ctr_w(s0: Str, nlo: Int, nhi: Int, ctr0: Int, src: Bytes, n: Int) -> Str {
  var s = s0
  var io = [0, 0, 0, 0, 0, 0, 0, 0]
  var ctr = ctr0
  var i = 0
  if (g.c.hw & cpu.HW_AES) != 0 {
    // whole 64 byte chunks: the counter blocks and the key stream in io's
    // words by address (io is this call's own: hw4 encrypts in place)
    io[0] = 0
    let p = addr(io)
    while i.wrapping_add(64) <= n {
      rt.mem_store(p, 0, nlo, 8)
      rt.mem_store(p, 8, nhi | shl((ctr & 0xFFFFFFFF).swap_bytes() & ~0xFFFFFFFF, 0), 8)
      rt.mem_store(p, 16, nlo, 8)
      rt.mem_store(p, 24, nhi | shl((ctr.wrapping_add(1) & 0xFFFFFFFF).swap_bytes() & ~0xFFFFFFFF, 0), 8)
      rt.mem_store(p, 32, nlo, 8)
      rt.mem_store(p, 40, nhi | shl((ctr.wrapping_add(2) & 0xFFFFFFFF).swap_bytes() & ~0xFFFFFFFF, 0), 8)
      rt.mem_store(p, 48, nlo, 8)
      rt.mem_store(p, 56, nhi | shl((ctr.wrapping_add(3) & 0xFFFFFFFF).swap_bytes() & ~0xFFFFFFFF, 0), 8)
      hw4(g.c, io)
      s = rt.rs_put_word(s, i, rt.bytes_word(src, i) ^ rt.mem_load(p, 0, 8))
      s = rt.rs_put_word(s, i.wrapping_add(8), rt.bytes_word(src, i.wrapping_add(8)) ^ rt.mem_load(p, 8, 8))
      s = rt.rs_put_word(s, i.wrapping_add(16), rt.bytes_word(src, i.wrapping_add(16)) ^ rt.mem_load(p, 16, 8))
      s = rt.rs_put_word(s, i.wrapping_add(24), rt.bytes_word(src, i.wrapping_add(24)) ^ rt.mem_load(p, 24, 8))
      s = rt.rs_put_word(s, i.wrapping_add(32), rt.bytes_word(src, i.wrapping_add(32)) ^ rt.mem_load(p, 32, 8))
      s = rt.rs_put_word(s, i.wrapping_add(40), rt.bytes_word(src, i.wrapping_add(40)) ^ rt.mem_load(p, 40, 8))
      s = rt.rs_put_word(s, i.wrapping_add(48), rt.bytes_word(src, i.wrapping_add(48)) ^ rt.mem_load(p, 48, 8))
      s = rt.rs_put_word(s, i.wrapping_add(56), rt.bytes_word(src, i.wrapping_add(56)) ^ rt.mem_load(p, 56, 8))
      ctr = ctr.wrapping_add(4)
      i = i.wrapping_add(64)
    }
    keep(io)
  }
  while i < n {
    for b in 0..4 {
      io[2 * b] = nlo
      io[2 * b + 1] = nhi | shl((ctr.wrapping_add(b) & 0xFFFFFFFF).swap_bytes() & ~0xFFFFFFFF, 0)
    }
    // the blocks the bytes left need (a record's last chunk is often 1
    // to 3)
    let left = n.wrapping_sub(i)
    encrypt_n(g.c, io, if left >= 64 { 4 } else { left.wrapping_add(15).shr_logical(4) })
    var k = 0
    while k < 8 {
      let off = i.wrapping_add(k.wrapping_shl(3))
      if off >= n {
        break
      }
      let w = if off.wrapping_add(8) <= n { rt.bytes_word(src, off) } else { tail_word(src, off, n) }
      s = rt.rs_put_word(s, off, w ^ io[k])
      k = k.wrapping_add(1)
    }
    ctr = ctr.wrapping_add(4)
    i = i.wrapping_add(64)
  }
  rt.rs_set_len(s, n)
}

/// The bytes of src from off to n (fewer than 8), little endian, zeros
/// above.
fn tail_word(src: Bytes, off: Int, n: Int) -> Int {
  if n >= 8 {
    // the top n - off bytes of the word that ends at n
    return rt.bytes_word(src, n - 8).shr_logical(8 * (off + 8 - n))
  }
  var w = 0
  var k = 0
  while off + k < n {
    w = w | shl(Int(src[off + k]), 8 * k)
    k += 1
  }
  w
}

/// The tag of the first n bytes of ciphertext data and additional data
/// aad.
fn (g: Gcm) tag(nonce: Bytes, data: Bytes, n: Int, aad: Bytes) -> Bytes {
  let (t0, t1) = g.tag_w(rt.bytes_word(nonce, 0), le32(nonce, 8), data, n, aad)
  rt.rs_push_word(rt.rs_push_word(rt.rs_with_cap(16), t0, 8), t1, 8).bytes()
}

/// tag's two little endian words, the nonce as ctr_w's: no string for
/// the nonce or the tag (a TLS record's seal and open).
fn (g: Gcm) tag_w(nlo: Int, nhi: Int, data: Bytes, n: Int, aad: Bytes) -> (Int, Int) {
  let (a1, a0) = g.ghash(0, 0, aad, aad.len())
  let (b1, b0) = g.ghash(a1, a0, data, n)
  let (y1, y0) = g.mul(b1 ^ (8 * aad.len()), b0 ^ (8 * n))
  var io = [nlo, nhi | shl(0x01000000, 32), 0, 0, 0, 0, 0, 0]
  encrypt_n(g.c, io, 1)
  (y1.swap_bytes() ^ io[0], y0.swap_bytes() ^ io[1])
}

/// The ciphertext of plaintext pt with its 16 byte tag after it (the
/// nonce is 12 bytes; cipher.AEAD's Seal).
pub fn (g: Gcm) seal(nonce: Bytes, pt: Bytes, aad: Bytes) -> Bytes { g.seal_w(rt.bytes_word(nonce, 0), le32(nonce, 8), pt, aad) }

/// seal with the nonce as two words (ctr_w): the ciphertext and its tag
/// are the one string allocated.
pub fn (g: Gcm) seal_w(nlo: Int, nhi: Int, pt: Bytes, aad: Bytes) -> Bytes {
  let n = pt.len()
  let ct = g.ctr_w(rt.rs_with_cap(n + 16), nlo, nhi, 2, pt, n)
  let (t0, t1) = g.tag_w(nlo, nhi, ct.bytes(), n, aad)
  rt.rs_push_word(rt.rs_push_word(ct, t0, 8), t1, 8).bytes()
}

/// The plaintext of ciphertext and tag sealed, or None when the tag does
/// not match (cipher.AEAD's Open). The body is read in place.
pub fn (g: Gcm) open(nonce: Bytes, sealed: Bytes, aad: Bytes) -> Bytes? { g.open_w(rt.bytes_word(nonce, 0), le32(nonce, 8), sealed, aad) }

/// open with the nonce as two words (ctr_w): the tag is compared in
/// place, in constant time (one test of the two words' differences), and
/// the plaintext is the one string allocated.
pub fn (g: Gcm) open_w(nlo: Int, nhi: Int, sealed: Bytes, aad: Bytes) -> Bytes? {
  let n = sealed.len() - 16
  if n < 0 {
    return None
  }
  let (t0, t1) = g.tag_w(nlo, nhi, sealed, n, aad)
  if ((t0 ^ rt.bytes_word(sealed, n)) | (t1 ^ rt.bytes_word(sealed, n + 8))) != 0 {
    return None
  }
  g.ctr_w(rt.rs_with_cap(n + 8), nlo, nhi, 2, sealed, n).bytes()
}

/// AES-GCM's seal under key.
pub fn seal(key: Bytes, nonce: Bytes, pt: Bytes, aad: Bytes) -> Bytes { new_gcm(key).seal(nonce, pt, aad) }

/// AES-GCM's open under key.
pub fn open(key: Bytes, nonce: Bytes, sealed: Bytes, aad: Bytes) -> Bytes? { new_gcm(key).open(nonce, sealed, aad) }

/// internal.crypto_op's "aes." ops (std/internal.xo): block (key a, the
/// 16 byte block b), seal (key a, nonce b, plaintext c, additional data
/// d), open (key a, nonce b, ciphertext and tag c, additional data d; a
/// 1 byte then the plaintext, or a 0 byte when the tag does not match),
/// decrypt (key a, the 16 byte block b), cbc_encrypt and cbc_decrypt
/// (key a, IV b, data c, a multiple of 16 bytes). None if unknown.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  match what {
    "block" => new(a).encrypt_block(b)
    "decrypt" => new(a).decrypt_block(b)
    "cbc_encrypt" => new(a).cbc_encrypt(b, c)
    "cbc_decrypt" => new(a).cbc_decrypt(b, c)
    "seal" => seal(a, b, c, d)
    "open" => {
      match open(a, b, c, d) {
        Some(p) => rt.rs_append_bytes(rt.rs_push_byte(rt.rs_with_cap(p.len() + 1), 1), p, 0, p.len(), 0).bytes()
        None => rt.rs_push_byte(rt.rs_with_cap(1), 0).bytes()
      }
    }
    _ => None
  }
}
