/// "Local" on Windows as TZif data for tz.xo: no transitions, one zone
/// (the standard offset and abbreviation), and the system's POSIX TZ rule
/// as the footer, which the lookups extend to every year; empty when the
/// system has no setting.
fn windows_local() -> List[Bytes] {
  // DYNAMIC_TIME_ZONE_INFORMATION (432 bytes): Bias at 0, StandardName
  // at 4, StandardDate at 68, StandardBias at 84, DaylightName at 88,
  // DaylightDate at 152, DaylightBias at 168, TimeZoneKeyName at 172
  let zb = raw.bytes_buf(432)
  let za = raw.bytes_addr(zb)
  if !windows.zone_info(za) {
    return []
  }
  let bias = i32(rt.mem_load(za, 0, 4))
  let std_bias = i32(rt.mem_load(za, 84, 4))
  let dst_bias = i32(rt.mem_load(za, 168, 4))
  var sa = caps(za + 4)
  var da = caps(za + 88)
  let key = ascii(za + 172, 128)
  let sn = ascii(za + 4, 32)
  for line in WIN_ABBRS.lines() {
    let f = line.split("|")
    if f.len() == 3 && ((!key.is_empty() && f[0] == key) || (!sn.is_empty() && f[0] == sn)) {
      sa = f[1]
      da = f[2]
      break
    }
  }
  var rule = "<${sa}>" + offset(bias + std_bias)
  let dd = za + 152
  let sd = za + 68
  if rt.mem_load(dd, 2, 2) != 0 && rt.mem_load(sd, 2, 2) != 0 && rt.mem_load(dd, 0, 2) == 0 && rt.mem_load(sd, 0, 2) == 0 {
    rule = rule + "<${da}>" + offset(bias + dst_bias) + date(dd) + date(sd)
  }
  let off = -(bias + std_bias) * 60
  let r = [tzif(sa, rule, off)]
  // zb's bytes were read through its address: alive until here
  let _k = zb.len()
  r
}

/// The low 32 bits of v as a signed C LONG.
fn i32(v: Int) -> Int { if v >= 2147483648 { v - 4294967296 } else { v } }

/// The capitals of the UTF-16 zone name at a (32 units at most: "Pacific
/// Standard Time": "PST"), the abbreviation Go's time.Local makes of it
/// when its table has none; "LT" when there are none.
fn caps(a: Int) -> Str {
  var b = BytesBuilder.new()
  for i in 0..32 {
    let c = rt.mem_load(a, 2 * i, 2)
    if c == 0 {
      break
    }
    if c >= 65 && c <= 90 {
      b.write_byte(UInt8(c))
    }
  }
  let s = b.freeze().to_str() ?? ""
  if s.is_empty() { "LT" } else { s }
}

/// The UTF-16 text at a (n units at most, to its zero) as ASCII; empty
/// when a unit is not ASCII (no key name in the table has one).
fn ascii(a: Int, n: Int) -> Str {
  var b = BytesBuilder.new()
  for i in 0..n {
    let c = rt.mem_load(a, 2 * i, 2)
    if c == 0 {
      break
    }
    if c >= 128 {
      return ""
    }
    b.write_byte(UInt8(c))
  }
  b.freeze().to_str() ?? ""
}

/// A POSIX TZ offset of bias minutes (west positive, as Windows' Bias).
fn offset(bias: Int) -> Str {
  let a = if bias < 0 { -bias } else { bias }
  let sign = if bias < 0 { "-" } else { "" }
  "${sign}${a / 60}:${pad2(a % 60)}"
}

/// A POSIX TZ rule date (`,Mm.w.d/h:mm:ss`) of the SYSTEMTIME at t in
/// Windows' recurring form (wYear 0: wDay is the week, 5 the last).
fn date(t: Int) -> Str {
  let mi = rt.mem_load(t, 10, 2)
  let se = rt.mem_load(t, 12, 2)
  ",M${rt.mem_load(t, 2, 2)}.${rt.mem_load(t, 6, 2)}.${rt.mem_load(t, 4, 2)}/${rt.mem_load(t, 8, 2)}:${pad2(mi)}:${pad2(se)}"
}

fn pad2(v: Int) -> Str { if v < 10 { "0${v}" } else { "${v}" } }

/// TZif data of one zone (offset off seconds east, abbreviation sa) with
/// rule as the footer: a version 2 header and an empty version 1 block,
/// the version 2 header (no transitions, one zone, sa's length plus one
/// characters), the zone, the abbreviation, then the footer.
fn tzif(sa: Str, rule: Str, off: Int) -> Bytes {
  var b = BytesBuilder.new()
  header(b, 0, 0)
  header(b, 1, sa.len() + 1)
  let u = off & 4294967295
  b.write_byte(UInt8((u >> 24) & 255))
  b.write_byte(UInt8((u >> 16) & 255))
  b.write_byte(UInt8((u >> 8) & 255))
  b.write_byte(UInt8(u & 255))
  b.write_byte(UInt8(0))
  b.write_byte(UInt8(0))
  b.write_str(sa)
  b.write_byte(UInt8(0))
  b.write_byte(UInt8(10))
  b.write_str(rule)
  b.write_byte(UInt8(10))
  b.freeze()
}

/// A 44 byte TZif header of version 2 with typecnt and charcnt (each one
/// byte, the low one of its big endian word) and every other count 0.
fn header(var b: BytesBuilder, typecnt: Int, charcnt: Int) {
  b.write_str("TZif2")
  for i in 5..44 {
    let v = if i == 39 { typecnt } else if i == 43 { charcnt } else { 0 }
    b.write_byte(UInt8(v))
  }
}
