// The host side of std/time's zones on the native backends, written in
// Xo (work item B27 of bench/results/zero-c-audit-refresh-2026-10-13.md;
// it was std/llrt/xo_time.c): the TZif data that may hold a zone name
// (the program's zone data, which the build writes beside the program
// and rttime.tz_table addresses, or the host's database), the table of
// the zones std/native/llrt/tz.xo parsed so far (a name always gets the
// same id and is parsed once), and the machine's zone name. On Windows
// "Local" is the system's setting (GetDynamicTimeZoneInformation) made
// into TZif data, as Go's time.Local makes it.
use native/llrt/darwin
use native/llrt/linux
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/rc
use native/llrt/sysio
use native/llrt/windows
use native/rt
use native/rttime

// The table of kept zones in the program's static words (rt.xo
// static_word): its lock, then a vector (the address of its entries
// from rt.heap_large, its length, its capacity) of entries of two words,
// the name (a block: its length, then its bytes) and the zone (the
// address of its List[Int], shared, holding one reference).
const W_LOCK = 18
const W_VEC = 19
const W_LEN = 20
const W_CAP = 21

/// The most zones the table keeps (xo_time.c's TZ_MAX).
const TZ_MAX = 4096

const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 3

// ---------------------------------------------------------------------------
// Zone data

/// The TZif data that may hold the zone named name, in the order to try
/// them: from the program's zone data (the data of its constant name,
/// the whole embedded zoneinfo.zip, or with --tzdata=system the
/// host's), or with host set from the host's database. tz.xo checks the
/// name first and parses each until one is TZif.
pub fn data(name: Str, host: Bool) -> List[Bytes] {
  let t = rttime.tz_table()
  let mode = rt.mem_load(t, 0, 8)
  if host || mode == 2 {
    return host_data(name)
  }
  if mode == 1 {
    return zip_entry(rt.mem_load(t, 8, 8), rt.mem_load(t, 16, 8), name)
  }
  let p = raw.data(name)
  let n = name.len()
  var b = rt.mem_load(t, 24, 8)
  while true {
    let np = rt.mem_load(b, 0, 8)
    if np == 0 {
      break
    }
    if cstr_is(np, p, n) {
      return [raw.str_at(rt.mem_load(b, 8, 8), rt.mem_load(b, 16, 8)).bytes()]
    }
    b += 24
  }
  []
}

/// Whether the C string at c is the n bytes at p.
fn cstr_is(c: Int, p: Int, n: Int) -> Bool { rt.mem_load(c, n, 1) == 0 && raw.mem_eq(c, p, n) && no_zero(c, n) }

/// Whether the n bytes at c hold no zero byte (so the C string is n long).
fn no_zero(c: Int, n: Int) -> Bool {
  for i in 0..n {
    if rt.mem_load(c, i, 1) == 0 {
      return false
    }
  }
  true
}

/// The stored entry named name of the zip archive of zn bytes at z, in a
/// list of one, or the empty list.
fn zip_entry(z: Int, zn: Int, name: Str) -> List[Bytes] {
  let (start, size) = zip_find(z, zn, raw.data(name), name.len())
  if start < 0 {
    return []
  }
  [raw.str_at(z + start, size).bytes()]
}

/// The offset and size of the stored entry of the zip archive of zn
/// bytes at z named by the nn bytes at name (std/rt's zipEntry), or -1
/// and 0.
fn zip_find(z: Int, zn: Int, name: Int, nn: Int) -> (Int, Int) {
  if zn < 22 {
    return (-1, 0)
  }
  let end = zn - 22
  if rt.mem_load(z, end, 4) != 0x06054b50 {
    return (-1, 0)
  }
  let n = rt.mem_load(z, end + 10, 2)
  var off = rt.mem_load(z, end + 16, 4)
  for _ in 0..n {
    if off + 46 > zn || rt.mem_load(z, off, 4) != 0x02014b50 {
      return (-1, 0)
    }
    let method = rt.mem_load(z, off + 10, 2)
    let size = rt.mem_load(z, off + 24, 4)
    let namelen = rt.mem_load(z, off + 28, 2)
    let extralen = rt.mem_load(z, off + 30, 2)
    let commentlen = rt.mem_load(z, off + 32, 2)
    let local = rt.mem_load(z, off + 42, 4)
    if off + 46 + namelen > zn {
      return (-1, 0)
    }
    let entry = off + 46
    off += 46 + namelen + extralen + commentlen
    if namelen != nn || !raw.mem_eq(z + entry, name, nn) {
      continue
    }
    if method != 0 || local + 30 > zn || rt.mem_load(z, local, 4) != 0x04034b50 {
      return (-1, 0)
    }
    let start = local + 30 + rt.mem_load(z, local + 26, 2) + rt.mem_load(z, local + 28, 2)
    if start + size > zn {
      return (-1, 0)
    }
    return (start, size)
  }
  (-1, 0)
}

/// The whole file at path, in a list of one, or the empty list.
fn read(path: Str) -> List[Bytes] {
  let (b, e) = sysio.read_whole(path)
  if e != 0 {
    return []
  }
  [b]
}

/// The TZif data that may hold the zone name in the host's database, in
/// the order time.LoadLocation tries them: $ZONEINFO (a directory or a
/// zip), then the system directories; "Local" is /etc/localtime (on
/// Windows the system's setting).
fn host_data(name: Str) -> List[Bytes] {
  if name == "Local" {
    if sysio.layer() == 3 {
      return windows_local()
    }
    return read("/etc/localtime")
  }
  var out: List[Bytes] = []
  let zi = process.env_get("ZONEINFO")
  let dirs = [if zi.is_empty() { "" } else { zi[0] }, "/usr/share/zoneinfo/", "/usr/share/lib/zoneinfo/", "/usr/lib/locale/TZ/", "/etc/zoneinfo/"]
  for (i, d) in dirs.indexed() {
    if d.is_empty() {
      continue
    }
    let path = if d.ends_with("/") { d + name } else { d + "/" + name }
    let got = read(path)
    if got.is_empty() && i == 0 {
      // $ZONEINFO may be a zip
      for zip in read(d) {
        for e in zip_entry(raw.bytes_addr(zip), zip.len(), name) {
          out.push(e)
        }
      }
      continue
    }
    for b in got {
      out.push(b)
    }
  }
  out
}

// ---------------------------------------------------------------------------
// The kept zones

fn lock() {
  let l = rt.static_word(W_LOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
}

fn unlock() {
  let l = rt.static_word(W_LOCK)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

/// The address of the zone kept under name, or 0; the lock is held.
fn get(name: Str) -> Int {
  let v = rt.mem_load(rt.static_word(W_VEC), 0, 8)
  let p = raw.data(name)
  let n = name.len()
  for i in 0..rt.mem_load(rt.static_word(W_LEN), 0, 8) {
    let b = rt.mem_load(v, 16 * i, 8)
    if rt.mem_load(b, 0, 8) == n && raw.mem_eq(b + 8, p, n) {
      return rt.mem_load(v, 16 * i + 8, 8)
    }
  }
  0
}

/// The zone named name kept so far, or the empty list.
pub fn find(name: Str) -> List[Int] {
  lock()
  let a = get(name)
  if a == 0 {
    unlock()
    return []
  }
  // counted once more before the lock goes: the table's reference keeps
  // it alive until then
  let z = rt.obj_at[List[Int]](a)
  unlock()
  z
}

/// Keeps the zone z (at least one word) that tz.xo parsed under name,
/// its id written to its first word, and returns it; a zone kept under
/// the name first is returned instead. The empty list when the table is
/// full. The table holds z shared between threads until exit (free).
pub fn keep(name: Str, z: List[Int]) -> List[Int] {
  lock()
  let a = get(name)
  if a != 0 {
    let k = rt.obj_at[List[Int]](a)
    unlock()
    return k
  }
  let n = rt.mem_load(rt.static_word(W_LEN), 0, 8)
  if n >= TZ_MAX || z.is_empty() {
    unlock()
    return []
  }
  var w = z
  w[0] = n + 1
  let wa = rt.obj_addr(w)
  // a List[Int] holds no references: marking its count is all of it
  let _m = rc.mark(wa + rt.layout(5))
  rc.inc(wa + rt.layout(5))
  if n == rt.mem_load(rt.static_word(W_CAP), 0, 8) {
    let c = if n == 0 { 16 } else { 2 * n }
    let old = rt.mem_load(rt.static_word(W_VEC), 0, 8)
    let v = if old == 0 { rt.heap_large(16 * c) } else { rt.heap_large_resize(old - 8, 16 * c) }
    rt.mem_store(rt.static_word(W_VEC), 0, v, 8)
    rt.mem_store(rt.static_word(W_CAP), 0, c, 8)
  }
  let v = rt.mem_load(rt.static_word(W_VEC), 0, 8)
  let b = rt.heap_large(name.len() + 8)
  rt.mem_store(b, 0, name.len(), 8)
  rt.mem_copy(b + 8, raw.data(name), name.len())
  rt.mem_store(v, 16 * n, b, 8)
  rt.mem_store(v, 16 * n + 8, wa, 8)
  rt.mem_store(rt.static_word(W_LEN), 0, n + 1, 8)
  unlock()
  w
}

/// Releases the kept zones at exit, so the leak check sees them freed
/// (xo_rt.c calls it through cabi_time.xo's tz_free).
pub fn free() {
  lock()
  let v = rt.mem_load(rt.static_word(W_VEC), 0, 8)
  for i in 0..rt.mem_load(rt.static_word(W_LEN), 0, 8) {
    let a = rt.mem_load(v, 16 * i + 8, 8)
    // a value of the zone (one more reference), the table's reference
    // dropped, then the value's at the end of the iteration
    let z = rt.obj_at[List[Int]](a)
    let _d = rc.dec_shared(a + rt.layout(5))
    rt.heap_release(rt.mem_load(v, 16 * i, 8) - 8)
    let _k = z.len()
  }
  if v != 0 {
    rt.heap_release(v - 8)
  }
  rt.mem_store(rt.static_word(W_VEC), 0, 0, 8)
  rt.mem_store(rt.static_word(W_LEN), 0, 0, 8)
  rt.mem_store(rt.static_word(W_CAP), 0, 0, 8)
  unlock()
}

/// The wall clock in seconds (the time of a load: Go fills its cache
/// with the zone in effect then).
pub fn now() -> Int { sysio.real_ns() / 1000000000 }

/// The machine's zone name from the /etc/localtime link, or "Local"
/// (always "Local" on Windows, where no link names it).
pub fn local_name() -> Str {
  let (t, e) = match sysio.layer() {
    1 => linux.readlink("/etc/localtime")
    2 => darwin.readlink("/etc/localtime")
    _ => ("", 1)
  }
  if e == 0 {
    match t.find("zoneinfo/") {
      Some(k) => return rt.str_slice(t, k + 9, t.len())
      None => {}
    }
  }
  "Local"
}

