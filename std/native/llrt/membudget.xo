// The memory budget (decision 0349): the bytes the heap uses (heapos.xo:
// its chunks and records as mapped, its large blocks as handed out), the
// budget past which the process stops, and the label its report prints.
// A leaf of heapos.xo: nothing here maps or allocates (stdio.err only
// without a newline, which allocates), so the stop can run while the
// heap is full; heapos.xo maps the label's buffer and
// hands it over.
use native/llrt/process
use native/llrt/stdio
use native/rt

/// rt.static_word: the bytes mapped, the budget (0: none), the label's
/// buffer (0: none; a mapping whose first byte is the label's length),
/// and a byte for the stop's digits.
const W_MAPPED = 84
const W_BUDGET = 85
const W_LABEL = 86
const W_DIGIT = 87
/// The most the count has been (the high-water mark).
const W_PEAK = 88

const RELAXED = 0
const ACQUIRE = 1
const ACQ_REL = 3

/// Adds d bytes to the count (negative for a mapping given back) and
/// stops the process when a mapping takes it past the budget.
pub fn add(d: Int) {
  if d <= 0 {
    // a mapping given back: the peak is raised to the count before the
    // count falls, so peak (the larger of the two) is never below a count
    // read before it (std/debug's mem_peak under a mem_mapped read just
    // before, the debug stress program 2026-11-18: an add's own raise
    // had not landed yet when the count fell)
    while true {
      let cur = rt.slot_load(rt.static_word(W_MAPPED), 0, ACQUIRE)
      raise_peak(cur)
      if rt.slot_cas(rt.static_word(W_MAPPED), 0, cur, cur.wrapping_add(d), ACQ_REL) {
        return
      }
    }
  }
  let total = rt.slot_add(rt.static_word(W_MAPPED), 0, d, ACQ_REL).wrapping_add(d)
  if d > 0 {
    raise_peak(total)
    let b = rt.slot_load(rt.static_word(W_BUDGET), 0, RELAXED)
    // the first mapping past the budget takes the budget (sets it to 0)
    // and stops the process: a mapping the stop itself makes, or one on
    // another thread meanwhile, sees no budget and goes on, so the stop
    // runs once (it re-entered itself, 2026-11-14: TestMemBudget's xo
    // build printed "18 MB ... 22 ... 26 ..." to a stack overflow)
    if b > 0 && total > b && rt.slot_cas(rt.static_word(W_BUDGET), 0, b, 0, ACQ_REL) {
      over_budget(total, b)
    }
  }
}

/// The bytes in use as the budget counts them.
pub fn mapped() -> Int { rt.slot_load(rt.static_word(W_MAPPED), 0, RELAXED) }

/// The most they have been: the high-water mark, or the count when an
/// add's raise has not landed yet.
pub fn peak() -> Int {
  let p = rt.slot_load(rt.static_word(W_PEAK), 0, ACQUIRE)
  let m = rt.slot_load(rt.static_word(W_MAPPED), 0, ACQUIRE)
  if m > p { m } else { p }
}

/// Raises the high-water mark to v (a compare and swap: a plain store lost
/// a racing larger one, and the peak read below the count).
fn raise_peak(v: Int) {
  while true {
    let p = rt.slot_load(rt.static_word(W_PEAK), 0, ACQUIRE)
    if v <= p || rt.slot_cas(rt.static_word(W_PEAK), 0, p, v, ACQ_REL) {
      return
    }
  }
}

/// Sets the budget in bytes (0 or less: none).
pub fn set_budget(b: Int) { rt.slot_store(rt.static_word(W_BUDGET), 0, if b > 0 { b } else { 0 }, RELAXED) }

/// The label's buffer, 0 before the first label.
pub fn label_buf() -> Int { rt.slot_load(rt.static_word(W_LABEL), 0, ACQUIRE) }

/// Takes m (a fresh mapping of at least 256 bytes) as the label's
/// buffer: false when another thread's came first (the caller unmaps m).
pub fn adopt_label_buf(m: Int) -> Bool { rt.slot_cas(rt.static_word(W_LABEL), 0, 0, m, ACQ_REL) }

/// Copies at most 255 of the n bytes at p into the label (0 clears it).
pub fn write_label(p: Int, n0: Int) {
  let buf = label_buf()
  if buf == 0 {
    return
  }
  let n = if n0 > 255 { 255 } else if n0 < 0 { 0 } else { n0 }
  var i = 0
  while i < n {
    rt.mem_store(buf, 1 + i, rt.mem_load(p, i, 1), 1)
    i += 1
  }
  rt.mem_store(buf, 0, n, 1)
}

/// "fatal error: memory budget exceeded: ..." and the label, then the
/// end of the process (status 70, as heapos.xo oom).
fn over_budget(total: Int, b: Int) {
  let head = "fatal error: memory budget exceeded: "
  stdio.err(raw_data(head), head.len(), false)
  write_mb(total)
  let mid = " MB mapped, more than XO_MAX_MEM ("
  stdio.err(raw_data(mid), mid.len(), false)
  write_mb(b)
  // nl stays false: stdio.err with a newline copies the line into a
  // buffer it allocates, and the heap may map for it
  let tail = " MB)\n"
  stdio.err(raw_data(tail), tail.len(), false)
  let buf = label_buf()
  if buf != 0 && rt.mem_load(buf, 0, 1) > 0 {
    let w = "  while: "
    stdio.err(raw_data(w), w.len(), false)
    stdio.err(buf + 1, rt.mem_load(buf, 0, 1), false)
    let nl = "\n"
    stdio.err(raw_data(nl), nl.len(), false)
  }
  process.os_exit(70)
}

/// The address of a constant Str's bytes (raw.xo data).
fn raw_data(s: Str) -> Int { rt.obj_addr(s) + rt.layout(0) }

/// Writes n bytes as whole MiB in decimal to standard error, a digit at a
/// time through a static word.
fn write_mb(n: Int) {
  let v = n / 1048576
  var div = 1
  while div.wrapping_mul(10) <= v && div < 1000000000000000000 {
    div = div.wrapping_mul(10)
  }
  let d = rt.static_word(W_DIGIT)
  while div > 0 {
    rt.mem_store(d, 0, 48 + (v / div) % 10, 1)
    stdio.err(d, 1, false)
    div = div / 10
  }
}
