test "md5 password: pgconn's md5 auth" {
  // python: "md5" + md5(md5(b"secret" + b"bob").hexdigest().encode() + bytes([1,2,3,4])).hexdigest()
  expect(md5_password("bob", "secret", Bytes.from_hex("01020304") ?? b"")) == "md5f21dfe33ff3a9e03dbc3e008251fe5cc"
}
