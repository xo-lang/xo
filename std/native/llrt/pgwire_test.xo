// std/native/pgwire.xo's tests: the messages pgx v5.11.0 pgproto3 encodes
// (vectors from a Go program), the SCRAM exchange of RFC 7677, and pgx's
// connection string corpora with pgx's own results (decision 0278).

fn s(x: Str) -> Str { (Bytes.from_hex(x) ?? b"").to_str() ?? "" }

// Vectors from pgx v5.11.0 pgproto3 Encode (gopg/main.go in the scratchpad).

test "encode startup" {
  expect(startup([("user", "app")]).to_hex()) == "000000120003000075736572006170700000"
}

test "encode ssl" {
  expect(ssl_request().to_hex()) == "0000000804d2162f"
}

test "encode query" {
  expect(query("select 1").to_hex()) == "510000000d73656c656374203100"
}

test "encode password" {
  expect(password("md5abc").to_hex()) == "700000000b6d643561626300"
}

test "encode sasl_initial" {
  expect(sasl_initial("SCRAM-SHA-256", b"n,,n=,r=abc").to_hex()) == "7000000021534352414d2d5348412d323536000000000b6e2c2c6e3d2c723d616263"
}

test "encode sasl_response" {
  expect(sasl_response(b"c=biws,r=x,p=y").to_hex()) == "7000000012633d626977732c723d782c703d79"
}

test "encode parse" {
  expect(parse("", "select $1", [0]).to_hex()) == "50000000150073656c65637420243100000100000000"
}

test "encode bind" {
  expect(bind("", "", [Param{format: 0, data: Some(b"42")}, Param{format: 1, data: None}], [0]).to_hex()) == "420000001c00000002000000010002000000023432ffffffff00010000"
}

test "encode describe" {
  expect(describe("P", "").to_hex()) == "44000000065000"
}

test "encode execute" {
  expect(execute("", 0).to_hex()) == "45000000090000000000"
}

test "encode sync" {
  expect(sync().to_hex()) == "5300000004"
}

test "encode terminate" {
  expect(terminate().to_hex()) == "5800000004"
}

test "encode cancel" {
  expect(cancel_request(1234, Bytes.from_hex("0000162e") ?? b"").to_hex()) == "0000001004d2162e000004d20000162e"
}

test "decode b_auth_md5" {
  let m = Bytes.from_hex("520000000c0000000501020304") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.AuthMd5(salt: Bytes.from_hex("01020304") ?? b""))
}

test "decode b_auth_sasl" {
  let m = Bytes.from_hex("520000002a0000000a534352414d2d5348412d32353600534352414d2d5348412d3235362d504c55530000") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.AuthSasl(mechanisms: ["SCRAM-SHA-256", "SCRAM-SHA-256-PLUS"]))
}

test "decode b_key" {
  let m = Bytes.from_hex("4b0000000c0000004d09080706") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.KeyData(pid: 77, secret: Bytes.from_hex("09080706") ?? b""))
}

test "decode b_rowdesc" {
  let m = Bytes.from_hex("540000001b0001696400000040000001000000170004ffffffff0000") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.RowDesc(fields: [Field{name: "id", table_oid: 16384, column: 1, type_oid: 23, size: 4, modifier: -1, format: 0}]))
}

test "decode b_datarow" {
  let m = Bytes.from_hex("440000001300030000000137ffffffff00000000") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.DataRow(values: [Some(b"7"), None, Some(b"")]))
}

test "decode b_complete" {
  let m = Bytes.from_hex("430000000f494e534552542030203300") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.CommandComplete(tag: "INSERT 0 3"))
}

test "decode b_error" {
  let m = Bytes.from_hex("4500000033534552524f5200433233353035004d6475706c6963617465206b6579006e75736572735f656d61696c5f6b65790000") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.Error(fields: {"S": "ERROR", "C": "23505", "M": "duplicate key", "n": "users_email_key"}))
}

test "decode b_ready" {
  let m = Bytes.from_hex("5a0000000549") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.Ready(status: "I"))
}

test "decode b_notify" {
  let m = Bytes.from_hex("410000000f000000056a6f6273003100") ?? b""
  expect(frame_len(m)) == Ok(Some(m.len()))
  expect(decode(m)) == Ok(Backend.Notification(pid: 5, channel: "jobs", payload: "1"))
}

test "a cut short frame waits" {
  expect(frame_len(Bytes.from_hex("5a000000") ?? b"")) == Ok(None)
  expect(frame_len(Bytes.from_hex("5a0000000549") ?? b"")) == Ok(Some(6))
}

test "rows affected" {
  expect(rows_affected("INSERT 0 3")) == 3
  expect(rows_affected("UPDATE 2")) == 2
  expect(rows_affected("CREATE TABLE")) == 0
}

// RFC 7677 section 3's example exchange.
test "scram-sha-256 RFC 7677 example" {
  let (s0, first) = start("user", "pencil", "rOprNGfwEbeRWgbNEkqO")
  expect(first) == "n,,n=user,r=rOprNGfwEbeRWgbNEkqO"
  var s = s0
  let fin = s.answer("r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096")
  expect(fin) == Ok("c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=")
  expect(s.finish("v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=")) == Ok(())
  expect(s.finish("v=AAAATRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=")) == Err(ScramErr.ServerSignature)
}

test "scram rejects a nonce the client did not start" {
  let (s0, _) = start("", "pw", "abc")
  var s = s0
  expect(s.answer("r=xyz123,s=AAAA,i=4096").is_err()) == true
  expect(s.answer("r=abc,s=AAAA,i=4096").is_err()) == true
}

// pgx v5.11.0 parseKeywordValueSettingsCorpus; expected results from Go
// (gokv in the scratchpad). Strings are hex so every byte survives.


test "keyword value 0" {
  let got = parse_keyword_value(s("")).map(fn(m) { m.entries().sort() })
  let want: Result[List[(Str, Str)], Str] = Ok([])
  expect(got) == want
}

test "keyword value 1" {
  let got = parse_keyword_value(s("686f73743d6c6f63616c686f7374")).map(fn(m) { m.entries().sort() })
  let want: Result[List[(Str, Str)], Str] = Ok([(s("686f7374"), s("6c6f63616c686f7374"))])
  expect(got) == want
}

