// The C path of the hashes of std/crypto (decisions 0193 and 0195): the
// API of digest.xo over the C runtime's functions (std/llrt/xo_crypto.c,
// compiled with -DXO_DIGEST_C). Loaded in place of digest.xo when
// XO_LLRT_C names `digest`. The self hosted compiler always uses
// digest.xo.
use native/rtcrypto

pub fn sha256(data: Bytes) -> Bytes { rtcrypto.crypto_sha256(data) }

pub fn hmac_sha256(key: Bytes, msg: Bytes) -> Bytes { rtcrypto.crypto_hmac_sha256(key, msg) }

pub fn pbkdf2(password: Bytes, salt: Bytes, iterations: Int, key_len: Int) -> Bytes { rtcrypto.crypto_pbkdf2(password, salt, iterations, key_len) }

pub fn b64(data: Bytes, url: Bool) -> Str { rtcrypto.crypto_b64(data, url) }

pub fn verify_password(password: Str, hash: Str) -> Bool { rtcrypto.crypto_verify_password(password, hash) }
