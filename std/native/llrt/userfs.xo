// A user value converted to Fs, Net, Proc, or Env on the native targets
// (decision 0307). For Fs:
// the native Fs (xo.Fs: root, mode, user) holds it in its user field as a
// UserFs, and the native prelude's fs_ functions and std/testing's memfs_
// functions call it first.

use native/rt

/// The Fs methods of a user value converted to Fs: the same methods as
/// the prelude's Fs.
pub interface UserFs {
  fn sub(self, dir: Str) -> Fs
  fn cwd(self) -> Fs
  /// The working directory as an absolute path with / separators, from
  /// the OS (getcwd), not $PWD (std.md 3.1, decision 0218).
  fn cwd_path(self) -> Str ! FsErr
  fn read_only(self) -> Fs
  fn write_only(self) -> Fs
  fn case_sensitive(self) -> Bool
  fn stat(self, path: Str) -> FileInfo? ! FsErr uses fs.read
  fn exists(self, path: Str) -> Bool ! FsErr uses fs.read
  fn read(self, path: Str) -> Bytes ! FsErr uses fs.read
  fn read_text(self, path: Str) -> Str ! FsErr uses fs.read
  fn read_dir(self, dir: Str) -> List[FileInfo] ! FsErr uses fs.read
  fn walk(self, dir: Str) -> List[FileInfo] ! FsErr uses fs.read
  fn write(self, path: Str, data: Bytes) -> () ! FsErr uses fs.write
  fn create_temp(self, dir: Str, prefix: Str) -> Str ! FsErr uses fs.write
  fn rename(self, from: Str, to: Str) -> () ! FsErr uses fs.write
  fn remove(self, path: Str) -> () ! FsErr uses fs.write
  fn remove_all(self, path: Str) -> () ! FsErr uses fs.write
  fn create_dir_all(self, dir: Str) -> () ! FsErr uses fs.write
  fn set_modified(self, path: Str, t: Time) -> () ! FsErr uses fs.write
  /// A handle that reads the file as a stream (std.md 3.1, decision 0163).
  fn open(self, path: Str) -> File ! FsErr uses fs.read
  /// A handle that writes the file, created or truncated.
  fn create(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that writes at the end of the file, created if missing.
  fn open_append(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that writes a new file: Exists(path) when something is
  /// already at path (O_EXCL; a symbolic link counts, dangling or not).
  fn create_new(self, path: Str) -> File ! FsErr uses fs.write
  /// Adds data at the end of the file, created if missing.
  fn append(self, path: Str, data: Bytes) -> () ! FsErr uses fs.write
  /// Copies the contents and permission bits of a file.
  fn copy(self, from: Str, to: Str) -> () ! FsErr uses fs
  /// The permission bits, 0o644 style.
  fn mode(self, path: Str) -> Int ! FsErr uses fs.read
  fn set_mode(self, path: Str, mode: Int) -> () ! FsErr uses fs.write
  /// Creates a symbolic link at `link` that points to `target`.
  fn symlink(self, target: Str, link: Str) -> () ! FsErr uses fs.write
  /// The target of a symbolic link; None when path is not one.
  fn read_link(self, path: Str) -> Str? ! FsErr uses fs.read
  /// The paths that match pattern (`*`, `?`, `[a-z]`, `**`), sorted.
  fn glob(self, pattern: Str) -> List[Str] ! FsErr uses fs.read
  /// An advisory lock on the file (created if missing); waits for it.
  fn lock(self, path: Str) -> FileLock ! FsErr uses fs.write
  /// The lock if no one holds it, else None at once.
  fn try_lock(self, path: Str) -> FileLock? ! FsErr uses fs.write
}

/// The Net methods of a user value converted to Net (decision 0307):
/// the same methods as the prelude's Net. The compiler calls them at
/// each Net method call on a native Net that holds one.
pub interface UserNet {
  fn listen(self, addr: Str) -> Listener ! NetErr uses net.listen
  fn dial(self, addr: Str) -> Conn ! NetErr uses net.dial
  /// A Net that dials and listens only on the listed hosts: `host`,
  /// `*.domain`, or `host:port`, and `unix:PATH` for a Unix domain
  /// socket (std.md 3.2, decisions 0156 and 0190).
  fn only(self, hosts: List[Str]) -> Net
}

/// The Proc methods of a user value converted to Proc (decision 0307):
/// the same methods as the prelude's Proc. The compiler calls them at
/// each Proc method call on a native Proc that holds one.
pub interface UserProc {
  fn exit(self, code: Int) -> Never uses proc
  /// Time between a stop request and the cancellation of main's root scope
  /// (core 7.5, default 30s; 0s cancels at the first signal).
  fn set_grace(self, d: Duration) uses proc
  fn run(self, cmd: Str, args: List[Str]) -> ProcOutput ! ProcErr uses proc
  /// A Proc that runs only the listed commands (std.md 3.7, decision
  /// 0156).
  fn only(self, cmds: List[Str]) -> Proc
  /// A command to run, not started (std.md 3.8, decision 0161).
  fn cmd(self, name: Str, args: List[Str] = []) -> Cmd
  /// Runs the commands with each one's output piped into the next one's
  /// input: the last one's output, every error stream, and the status of
  /// the rightmost failing command (std.md 3.8).
  fn pipeline(self, cmds: List[Cmd]) -> ProcOutput ! ProcErr uses proc
  /// Sends the signal named (HUP, INT, QUIT, KILL, TERM, USR1, USR2,
  /// CONT, STOP) to the process pid; an attenuated Proc must list "kill"
  /// (std.md 3.7, decision 0190).
  fn kill(self, pid: Int, signal: Str = "TERM") -> () ! ProcErr uses proc
}

/// The Env methods of a user value converted to Env (decision 0307):
/// the same methods as the prelude's Env. The compiler calls them at
/// each Env method call on a native Env that holds one.
pub interface UserEnv {
  fn get(self, name: Str) -> Str? uses env
  fn vars(self) -> Map[Str, Str] uses env
  fn args(self) -> List[Str] uses env
  fn program(self) -> Str uses env
  fn home(self) -> Str ! EnvErr uses env
  /// An Env that reads only the listed variables (std.md 3.5, decision
  /// 0156).
  fn only(self, names: List[Str]) -> Env
  /// Where a program keeps its configuration: XDG_CONFIG_HOME, else
  /// ~/.config, ~/Library/Application Support, or %AppData% (std.md 3.5,
  /// decision 0163).
  fn config_dir(self) -> Str ! EnvErr uses env
  /// Where a program keeps its cache: XDG_CACHE_HOME, else ~/.cache,
  /// ~/Library/Caches, or %LocalAppData%.
  fn cache_dir(self) -> Str ! EnvErr uses env
}

/// The user value f holds; None for the runtime's own Fs. The compiler
/// replaces a call of it with a read of the native Fs's user field; this
/// body is what a compiler older than decision 0307 builds (a seed
/// building this std), whose Fs has no such field.
pub fn user(f: Fs) -> UserFs? {
  let _ = f
  None
}

// The File and FileLock results of a UserFs as the native prelude's own
// File and FileLock (F, L), which the prelude's types lower to (decision
// 0083) and which the native prelude cannot name otherwise.

pub fn open_as[F](u: UserFs, p: Str, mode: Int) -> F ! FsErr uses fs.read, fs.write {
  let h = match mode {
    0 => u.open(p)?
    1 => u.create(p)?
    2 => u.open_append(p)?
    _ => u.create_new(p)?
  }
  Ok(rt.cast[File, F](h))
}

pub fn lock_as[L](u: UserFs, p: Str) -> L ! FsErr uses fs.write { Ok(rt.cast[FileLock, L](u.lock(p)?)) }

pub fn try_lock_as[L](u: UserFs, p: Str) -> L? ! FsErr uses fs.write {
  match u.try_lock(p)? {
    Some(l) => Ok(Some(rt.cast[FileLock, L](l)))
    None => Ok(None)
  }
}
