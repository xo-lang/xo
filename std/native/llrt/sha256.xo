// SHA-224, SHA-256, SHA-384, and SHA-512 (FIPS 180-4) for TLS (work item
// B31, decision 0202) and std/crypto's Hash (decision 0279; SHA-224 is
// SHA-256 with its own initial state, cut to 28 bytes): one shot (sum) and incremental (Hasher: write, a sum that does
// not consume it, clone), as Go's crypto/sha256 and crypto/sha512. The
// compressions are digest_tables.xo's (sha256_block, and sha512_block,
// which SHA-384 shares with SHA-512's Ed25519 use in digest.xo). Nothing
// branches on the data, only on lengths.
use native/llrt/cpu
use native/llrt/digest_tables
use native/llrt/raw
use native/rt

/// The hash ids of sha256.xo, hmac.xo, and hkdf.xo.
pub const HASH_SHA256 = 0
pub const HASH_SHA384 = 1
pub const HASH_SHA512 = 2
pub const HASH_SHA224 = 3

/// SHA-224 and SHA-256 share the 32 bit compression and 64 byte blocks.
fn is256(hash: Int) -> Bool { hash == HASH_SHA256 || hash == HASH_SHA224 }

/// An incremental hash: the state words, the bytes of a partial block
/// held, and the bytes written.
pub struct Hasher {
  pub hash: Int
  st: List[Int]
  held: Bytes
  total: Int
}

/// The digest's size in bytes.
pub fn size(hash: Int) -> Int { if hash == HASH_SHA256 { 32 } else if hash == HASH_SHA224 { 28 } else if hash == HASH_SHA384 { 48 } else { 64 } }

/// The block size in bytes (HMAC's padded key).
pub fn block_size(hash: Int) -> Int { if is256(hash) { 64 } else { 128 } }

/// A new hash of hash (HASH_SHA224, HASH_SHA256, HASH_SHA384, or HASH_SHA512).
pub fn new(hash: Int) -> Hasher {
  let st = if hash == HASH_SHA256 {
    // FIPS 180-4 5.3.3
    [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  } else if hash == HASH_SHA224 {
    // FIPS 180-4 5.3.2
    [0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4]
  } else if hash == HASH_SHA512 {
    // FIPS 180-4 5.3.5
    [7640891576956012808, -4942790177534073029, 4354685564936845355, -6534734903238641935, 5840696475078001361, -7276294671716946913, 2270897969802886507, 6620516959819538809]
  } else {
    // FIPS 180-4 5.3.4
    [-3766243637369397544, 7105036623409894663, -7973340178411365097, 1526699215303891257, 7436329637833083697, -8163818279084223215, -2662702644619276377, 5167115440072839076]
  }
  Hasher{hash: hash, st: st, held: b"", total: 0}
}

/// The digest of data.
pub fn sum(hash: Int, data: Bytes) -> Bytes {
  var h = new(hash)
  h.write(data)
  h.sum()
}

/// SHA-256's round constants (FIPS 180-4 4.2.2) as 4 byte little endian
/// words, for cpu.sha256_block.
const K256: Bytes = b"\x98\x2f\x8a\x42\x91\x44\x37\x71\xcf\xfb\xc0\xb5\xa5\xdb\xb5\xe9\x5b\xc2\x56\x39\xf1\x11\xf1\x59\xa4\x82\x3f\x92\xd5\x5e\x1c\xab\x98\xaa\x07\xd8\x01\x5b\x83\x12\xbe\x85\x31\x24\xc3\x7d\x0c\x55\x74\x5d\xbe\x72\xfe\xb1\xde\x80\xa7\x06\xdc\x9b\x74\xf1\x9b\xc1\xc1\x69\x9b\xe4\x86\x47\xbe\xef\xc6\x9d\xc1\x0f\xcc\xa1\x0c\x24\x6f\x2c\xe9\x2d\xaa\x84\x74\x4a\xdc\xa9\xb0\x5c\xda\x88\xf9\x76\x52\x51\x3e\x98\x6d\xc6\x31\xa8\xc8\x27\x03\xb0\xc7\x7f\x59\xbf\xf3\x0b\xe0\xc6\x47\x91\xa7\xd5\x51\x63\xca\x06\x67\x29\x29\x14\x85\x0a\xb7\x27\x38\x21\x1b\x2e\xfc\x6d\x2c\x4d\x13\x0d\x38\x53\x54\x73\x0a\x65\xbb\x0a\x6a\x76\x2e\xc9\xc2\x81\x85\x2c\x72\x92\xa1\xe8\xbf\xa2\x4b\x66\x1a\xa8\x70\x8b\x4b\xc2\xa3\x51\x6c\xc7\x19\xe8\x92\xd1\x24\x06\x99\xd6\x85\x35\x0e\xf4\x70\xa0\x6a\x10\x16\xc1\xa4\x19\x08\x6c\x37\x1e\x4c\x77\x48\x27\xb5\xbc\xb0\x34\xb3\x0c\x1c\x39\x4a\xaa\xd8\x4e\x4f\xca\x9c\x5b\xf3\x6f\x2e\x68\xee\x82\x8f\x74\x6f\x63\xa5\x78\x14\x78\xc8\x84\x08\x02\xc7\x8c\xfa\xff\xbe\x90\xeb\x6c\x50\xa4\xf7\xa3\xf9\xbe\xf2\x78\x71\xc6"

/// SHA-512's round constants (FIPS 180-4 4.2.3) as 8 byte little endian
/// words, for cpu.sha512_block.
const K512: Bytes = b"\x22\xae\x28\xd7\x98\x2f\x8a\x42\xcd\x65\xef\x23\x91\x44\x37\x71\x2f\x3b\x4d\xec\xcf\xfb\xc0\xb5\xbc\xdb\x89\x81\xa5\xdb\xb5\xe9\x38\xb5\x48\xf3\x5b\xc2\x56\x39\x19\xd0\x05\xb6\xf1\x11\xf1\x59\x9b\x4f\x19\xaf\xa4\x82\x3f\x92\x18\x81\x6d\xda\xd5\x5e\x1c\xab\x42\x02\x03\xa3\x98\xaa\x07\xd8\xbe\x6f\x70\x45\x01\x5b\x83\x12\x8c\xb2\xe4\x4e\xbe\x85\x31\x24\xe2\xb4\xff\xd5\xc3\x7d\x0c\x55\x6f\x89\x7b\xf2\x74\x5d\xbe\x72\xb1\x96\x16\x3b\xfe\xb1\xde\x80\x35\x12\xc7\x25\xa7\x06\xdc\x9b\x94\x26\x69\xcf\x74\xf1\x9b\xc1\xd2\x4a\xf1\x9e\xc1\x69\x9b\xe4\xe3\x25\x4f\x38\x86\x47\xbe\xef\xb5\xd5\x8c\x8b\xc6\x9d\xc1\x0f\x65\x9c\xac\x77\xcc\xa1\x0c\x24\x75\x02\x2b\x59\x6f\x2c\xe9\x2d\x83\xe4\xa6\x6e\xaa\x84\x74\x4a\xd4\xfb\x41\xbd\xdc\xa9\xb0\x5c\xb5\x53\x11\x83\xda\x88\xf9\x76\xab\xdf\x66\xee\x52\x51\x3e\x98\x10\x32\xb4\x2d\x6d\xc6\x31\xa8\x3f\x21\xfb\x98\xc8\x27\x03\xb0\xe4\x0e\xef\xbe\xc7\x7f\x59\xbf\xc2\x8f\xa8\x3d\xf3\x0b\xe0\xc6\x25\xa7\x0a\x93\x47\x91\xa7\xd5\x6f\x82\x03\xe0\x51\x63\xca\x06\x70\x6e\x0e\x0a\x67\x29\x29\x14\xfc\x2f\xd2\x46\x85\x0a\xb7\x27\x26\xc9\x26\x5c\x38\x21\x1b\x2e\xed\x2a\xc4\x5a\xfc\x6d\x2c\x4d\xdf\xb3\x95\x9d\x13\x0d\x38\x53\xde\x63\xaf\x8b\x54\x73\x0a\x65\xa8\xb2\x77\x3c\xbb\x0a\x6a\x76\xe6\xae\xed\x47\x2e\xc9\xc2\x81\x3b\x35\x82\x14\x85\x2c\x72\x92\x64\x03\xf1\x4c\xa1\xe8\xbf\xa2\x01\x30\x42\xbc\x4b\x66\x1a\xa8\x91\x97\xf8\xd0\x70\x8b\x4b\xc2\x30\xbe\x54\x06\xa3\x51\x6c\xc7\x18\x52\xef\xd6\x19\xe8\x92\xd1\x10\xa9\x65\x55\x24\x06\x99\xd6\x2a\x20\x71\x57\x85\x35\x0e\xf4\xb8\xd1\xbb\x32\x70\xa0\x6a\x10\xc8\xd0\xd2\xb8\x16\xc1\xa4\x19\x53\xab\x41\x51\x08\x6c\x37\x1e\x99\xeb\x8e\xdf\x4c\x77\x48\x27\xa8\x48\x9b\xe1\xb5\xbc\xb0\x34\x63\x5a\xc9\xc5\xb3\x0c\x1c\x39\xcb\x8a\x41\xe3\x4a\xaa\xd8\x4e\x73\xe3\x63\x77\x4f\xca\x9c\x5b\xa3\xb8\xb2\xd6\xf3\x6f\x2e\x68\xfc\xb2\xef\x5d\xee\x82\x8f\x74\x60\x2f\x17\x43\x6f\x63\xa5\x78\x72\xab\xf0\xa1\x14\x78\xc8\x84\xec\x39\x64\x1a\x08\x02\xc7\x8c\x28\x1e\x63\x23\xfa\xff\xbe\x90\xe9\xbd\x82\xde\xeb\x6c\x50\xa4\x15\x79\xc6\xb2\xf7\xa3\xf9\xbe\x2b\x53\x72\xe3\xf2\x78\x71\xc6\x9c\x61\x26\xea\xce\x3e\x27\xca\x07\xc2\xc0\x21\xc7\xb8\x86\xd1\x1e\xeb\xe0\xcd\xd6\x7d\xda\xea\x78\xd1\x6e\xee\x7f\x4f\x7d\xf5\xba\x6f\x17\x72\xaa\x67\xf0\x06\xa6\x98\xc8\xa2\xc5\x7d\x63\x0a\xae\x0d\xf9\xbe\x04\x98\x3f\x11\x1b\x47\x1c\x13\x35\x0b\x71\x1b\x84\x7d\x04\x23\xf5\x77\xdb\x28\x93\x24\xc7\x40\x7b\xab\xca\x32\xbc\xbe\xc9\x15\x0a\xbe\x9e\x3c\x4c\x0d\x10\x9c\xc4\x67\x1d\x43\xb6\x42\x3e\xcb\xbe\xd4\xc5\x4c\x2a\x7e\x65\xfc\x9c\x29\x7f\x59\xec\xfa\xd6\x3a\xab\x6f\xcb\x5f\x17\x58\x47\x4a\x8c\x19\x44\x6c"

/// SHA-256's compression of the 64 bytes of b at i into st (8 words):
/// cpu.sha256_block's instructions when the CPU has them (decision 0231,
/// owner 2026-10-16), else digest_tables.sha256_block.
pub fn block256(var st: List[Int], b: Bytes, i: Int) {
  if target.arch == TargetArch.Wasm32 {
    // 16 rounds in a loop of 4: digest_tables' unrolled 64 are 34 KB of
    // a wasm module, which its engine compiles at every start
    st[0] = st[0]
    cpu.sha256_block_r16(rt.obj_addr(st).wrapping_add(rt.layout(2)), raw.bytes_addr(b).wrapping_add(i), raw.bytes_addr(K256))
    keep(b)
    keep_ints(st)
    return
  }
  if (cpu.hw() & cpu.HW_SHA256) != 0 {
    // an index store first: it copies st if another value shares its
    // words (a Hasher's sum and clone do), which the raw writes below
    // would otherwise change too
    st[0] = st[0]
    cpu.sha256_block(rt.obj_addr(st).wrapping_add(rt.layout(2)), raw.bytes_addr(b).wrapping_add(i), raw.bytes_addr(K256))
    keep(b)
    keep_ints(st)
    return
  }
  digest_tables.sha256_block(st, b, i)
}

/// SHA-256's compression of the block of the 16 words m (UInt32s, as
/// digest_tables.sha256_words takes them) into st: with the CPU's
/// instructions, the words packed big endian first.
pub fn words256(var st: List[Int], m: List[Int]) {
  if target.arch == TargetArch.Wasm32 || (cpu.hw() & cpu.HW_SHA256) != 0 {
    var b = rt.rs_with_cap(64)
    for j in 0..8 {
      // two words a 64 bit big endian store: m[2j] first
      b = rt.rs_push_word(b, (m[2 * j].wrapping_shl(32) | (m[2 * j + 1] & 0xFFFFFFFF)).swap_bytes(), 8)
    }
    block256(st, b.bytes(), 0)
    return
  }
  digest_tables.sha256_words(st, m)
}

/// SHA-512's compression of the 128 bytes at address p into st with
/// cpu.sha512_block_r16, for digest.xo's Ed25519 hash on wasm (as compress).
pub fn block512_at(var st: List[Int], p: Int) {
  st[0] = st[0]
  cpu.sha512_block_r16(rt.obj_addr(st).wrapping_add(rt.layout(2)), p, raw.bytes_addr(K512))
  keep_ints(st)
}

/// st is known alive up to here (keep).
fn keep_ints(st: List[Int]) {
  if st.len() < 0 {
    return
  }
}

/// One block of b from i into st.
fn compress(hash: Int, var st: List[Int], b: Bytes, i: Int) {
  if is256(hash) {
    block256(st, b, i)
    return
  }
  if target.arch == TargetArch.Wasm32 {
    // as block256: 16 rounds in a loop of 5 on wasm (digest_tables' 80
    // unrolled are 38 KB)
    st[0] = st[0]
    cpu.sha512_block_r16(rt.obj_addr(st).wrapping_add(rt.layout(2)), raw.bytes_addr(b).wrapping_add(i), raw.bytes_addr(K512))
    keep(b)
    keep_ints(st)
    return
  }
  if (cpu.hw() & cpu.HW_SHA512) != 0 {
    // as block256: an index store first copies st when it is shared
    st[0] = st[0]
    cpu.sha512_block(rt.obj_addr(st).wrapping_add(rt.layout(2)), raw.bytes_addr(b).wrapping_add(i), raw.bytes_addr(K512))
    keep(b)
    keep_ints(st)
    return
  }
  digest_tables.sha512_block(st, raw.bytes_addr(b).wrapping_add(i))
  keep(b)
}

/// b is known alive up to here (darwin.xo's keep): reference counting
/// releases a value after its last use, and sha512_block reads its memory.
fn keep(b: Bytes) {
  if b.len() < 0 {
    return
  }
}

/// The bytes lo..hi of b after a.
fn cat(a: Bytes, b: Bytes, lo: Int, hi: Int) -> Bytes { rt.rs_append_bytes(rt.rs_append_bytes(rt.rs_with_cap(a.len() + hi - lo), a, 0, a.len(), 0), b, lo, hi, 0).bytes() }

/// Hashes data after what was written.
pub fn (var h: Hasher) write(data: Bytes) {
  let bs = block_size(h.hash)
  let n = data.len()
  h.total = h.total + n
  var st = h.st
  var i = 0
  if h.held.len() > 0 {
    let m = if bs - h.held.len() < n { bs - h.held.len() } else { n }
    let held = cat(h.held, data, 0, m)
    i = m
    if held.len() < bs {
      h.held = held
      return
    }
    compress(h.hash, st, held, 0)
    h.held = b""
  }
  while n - i >= bs {
    compress(h.hash, st, data, i)
    i += bs
  }
  if i < n {
    h.held = cat(b"", data, i, n)
  }
  h.st = st
}

/// The digest of what was written; h is unchanged and can be written to
/// further.
pub fn (h: Hasher) sum() -> Bytes {
  let bs = block_size(h.hash)
  var st = h.st
  // the held bytes, 0x80, zeros, and the length in bits big endian (8
  // bytes for SHA-256, 16 for SHA-384): one block or two
  let r = h.held.len()
  let lenb = if bs == 64 { 8 } else { 16 }
  // the zeros in one append from a constant (the length's high 8 bytes
  // of SHA-384 and SHA-512 among them), in a buffer of the padded size
  let end = if r + 1 + lenb <= bs { bs } else { 2 * bs }
  var t = rt.rs_push_byte(rt.rs_append_bytes(rt.rs_with_cap(end), h.held, 0, r, 0), 0x80)
  t = rt.rs_push_word(rt.rs_append_bytes(t, ZEROS, 0, end - 9 - r, 0), h.total.wrapping_shl(3).swap_bytes(), 8)
  let tb = t.bytes()
  var i = 0
  while i < tb.len() {
    compress(h.hash, st, tb, i)
    i += bs
  }
  // the words big endian, four 8 byte words a call (the lengths in the
  // nibbles of the last argument)
  let out = rt.rs_with_cap(size(h.hash))
  if is256(h.hash) {
    // SHA-224 keeps the first 7 of the 8 words
    let last = if h.hash == HASH_SHA256 { 0x8888 } else { 0x4888 }
    return rt.rs_push_words(out, be_pair(st[0], st[1]), be_pair(st[2], st[3]), be_pair(st[4], st[5]), be_pair(st[6], st[7]), last).bytes()
  }
  let o = rt.rs_push_words(out, st[0].swap_bytes(), st[1].swap_bytes(), st[2].swap_bytes(), st[3].swap_bytes(), 0x8888)
  // SHA-384 keeps the first 6 of the 8 words
  let last = if h.hash == HASH_SHA512 { 0x8888 } else { 0x0088 }
  rt.rs_push_words(o, st[4].swap_bytes(), st[5].swap_bytes(), st[6].swap_bytes(), st[7].swap_bytes(), last).bytes()
}

/// The low 32 bits of a and then of b, each big endian, as the 8 bytes
/// of a word (the first lowest).
fn be_pair(a: Int, b: Int) -> Int { a.wrapping_shl(32).swap_bytes() | b.wrapping_shl(32).swap_bytes().wrapping_shl(32) }

/// The zero bytes of the padding (at most a block and 7 bytes of SHA-512's).
const ZEROS: Bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// An independent copy of h.
pub fn (h: Hasher) clone() -> Hasher { Hasher{hash: h.hash, st: h.st, held: h.held, total: h.total} }

/// The hash an internal.crypto_op name ends in ("...256", "...384", or
/// "...512").
pub fn hash_of(what: Str) -> Int {
  if what.ends_with("384") {
    return HASH_SHA384
  }
  if what.ends_with("512") { HASH_SHA512 } else { HASH_SHA256 }
}

/// internal.crypto_op's "hash." ops (std/internal.xo): sha256, sha384,
/// and sha512 of a; split256, split384, and split512, a then b written separately, the sum
/// after a, after b, and of a clone taken after a. None if unknown.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  let h = hash_of(what)
  match what.trim_suffix("256").trim_suffix("384").trim_suffix("512") {
    "sha" => sum(h, a)
    "split" => {
      var x = new(h)
      x.write(a)
      let s1 = x.sum()
      let y = x.clone()
      x.write(b)
      s1 + x.sum() + y.sum()
    }
    _ => None
  }
}
