// The program's DWARF line tables (decision 0239), read back for the
// profiler (prof.xo) and fault reports: Linux, the .debug_line of the
// program's file (/proc/self/exe); macOS, the __DWARF of PROG.dSYM next
// to the executable when its LC_UUID is the running image's; Windows,
// the .debug_ sections of the program's file (pelink.xo keeps them,
// named through the COFF string table). Version 4
// and 5 line programs (the arm64 emitter's and LLVM's), every opcode,
// rows sorted by address, placed by the load bias. Read when asked, not
// at start and never in a signal handler; files are read by plain
// system calls, not sysio (a test binary's sysio is the test world's,
// which a fault's report cannot wait on: the traceback hung).
use native/llrt/linux
use native/llrt/raw
use native/llrt/windows
use native/rt
use native/sys_darwin
use native/sys_windows

/// The rows: address, file (an index of files, -1 at a sequence's end),
/// and line, sorted by address.
pub struct Lines {
  pub addrs: List[Int] = []
  pub files: List[Int] = []
  pub lines: List[Int] = []
  pub names: List[Str] = []
  /// the inlined calls (.debug_info's DW_TAG_inlined_subroutine): a
  /// range each (an entry with several ranges has several), its nesting
  /// depth (1: in the function itself), the callee's name, and the call's
  /// file (an index of names) and line
  pub inl_lo: List[Int] = []
  pub inl_hi: List[Int] = []
  pub inl_depth: List[Int] = []
  pub inl_name: List[Str] = []
  pub inl_file: List[Int] = []
  pub inl_line: List[Int] = []
  /// each line program's files (by its offset in .debug_line): names
  /// indexes by the program's file numbers
  uf_ix: IntIdx = IntIdx{}
  uf: List[List[Int]] = []
}

/// The sections a line program reads: .debug_line, and the string
/// sections v5 file names refer to (address and size; 0 for none).
struct Sects {
  /// the file the addresses point into, held while they are read: a
  /// Bytes is released after its last use, and the readers' own
  /// allocations reused its memory (gotchas/raw-address-outlives-bytes.md)
  data: Bytes = b""
  line: Int = 0
  line_n: Int = 0
  lstr: Int = 0
  lstr_n: Int = 0
  str: Int = 0
  str_n: Int = 0
  /// the inlined calls' sections (.debug_info and what it refers to)
  info: Int = 0
  info_n: Int = 0
  abbrev: Int = 0
  abbrev_n: Int = 0
  stroff: Int = 0
  stroff_n: Int = 0
  addr: Int = 0
  addr_n: Int = 0
  rng: Int = 0
  rng_n: Int = 0
  /// the variables' location lists (decision 0268: .debug_loclists)
  loc: Int = 0
  loc_n: Int = 0
}

/// Notes debug section name (without its .debug_ or __debug_ prefix; a
/// Mach-O name is cut at 16 bytes) at address a, n bytes.
fn (var s: Sects) set(name: Str, a: Int, n: Int) {
  match name {
    "line" => {
      s.line = a
      s.line_n = n
    }
    "line_str" => {
      s.lstr = a
      s.lstr_n = n
    }
    "str" => {
      s.str = a
      s.str_n = n
    }
    "info" => {
      s.info = a
      s.info_n = n
    }
    "abbrev" => {
      s.abbrev = a
      s.abbrev_n = n
    }
    "str_offsets" | "str_offs" => {
      s.stroff = a
      s.stroff_n = n
    }
    "addr" => {
      s.addr = a
      s.addr_n = n
    }
    "rnglists" => {
      s.rng = a
      s.rng_n = n
    }
    "loclists" => {
      s.loc = a
      s.loc_n = n
    }
    _ => {}
  }
}

fn ld(p: Int, o: Int) -> Int { rt.mem_load(p, o, 8) }

fn u8(p: Int) -> Int { rt.mem_load(p, 0, 1) }

fn u16(p: Int) -> Int { rt.mem_load(p, 0, 2) }

fn u32(p: Int) -> Int { rt.mem_load(p, 0, 4) }

/// Whether the program has DWARF to read (the compiler folds a call of
/// this to the build's debug info: a `--release` build without
/// `--debug-info`, or `-s`, has none, so the readers are neither built nor
/// linked, decision 0354's addendum). True where the compiler does not.
pub fn built() -> Bool { true }

/// The program's line table within [lo, hi) (its text), or none.
pub fn load(lo: Int, hi: Int) -> Lines {
  var out = Lines{}
  if !built() {
    return out
  }
  match target.os {
    TargetOs.Linux => load_elf(lo, hi, out)
    TargetOs.Darwin => load_dsym(lo, hi, out)
    TargetOs.Windows => load_pe(lo, hi, out)
    TargetOs.Wasi => {}
  }
  out
}

/// The file and line of pc ("" and 0 when no row holds it).
pub fn find(t: Lines, pc: Int) -> (Str, Int) {
  var a = 0
  var b = t.addrs.len()
  while a < b {
    let m = (a + b) / 2
    if t.addrs[m] <= pc {
      a = m + 1
    } else {
      b = m
    }
  }
  let i = a - 1
  if i < 0 || t.files[i] < 0 || t.lines[i] <= 0 {
    return ("", 0)
  }
  (t.names[t.files[i]], t.lines[i])
}

fn base(p: Str) -> Str {
  let parts = p.split("/")
  parts[parts.len() - 1]
}

// ---------------------------------------------------------------------------
// Loading

/// Linux: the sections of /proc/self/exe by name, placed by the load
/// bias (AT_PHDR against PT_PHDR).
fn load_elf(lo: Int, hi: Int, var out: Lines) {
  let (s, bias, ok) = elf_sects()
  if ok && s.line_n > 0 {
    parse(s, bias, lo, hi, out)
    parse_info(s, bias, out)
  }
}

/// Linux: the debug sections of /proc/self/exe and the load bias (ok
/// false when the file or its section headers cannot be read); a split
/// program's (decision 0355) from the file its .gnu_debuglink names in
/// the executable's directory, when its GNU build id is the program's.
fn elf_sects() -> (Sects, Int, Bool) {
  let data = read_raw("/proc/self/exe")
  if data.len() < 64 {
    return (Sects{}, 0, false)
  }
  let ph = linux.auxval(linux.AT_PHDR)
  let phn = linux.auxval(linux.AT_PHNUM)
  var bias = 0
  for i in 0..phn {
    let p = ph + 56 * i
    if rt.mem_load(p, 0, 4) == 6 {
      bias = ph - ld(p, 16)
    }
  }
  let (s, link, id, ok) = elf_debug(data)
  if !ok {
    return (Sects{}, 0, false)
  }
  if s.line_n == 0 && !link.is_empty() && !id.is_empty() {
    let (exe, err) = linux.readlink("/proc/self/exe")
    if err == 0 {
      let parts = exe.split("/")
      let dir = exe[0..exe.len() - parts[parts.len() - 1].len()]
      let (ds, _, did, dok) = elf_debug(read_raw("${dir}${link}"))
      if dok && did == id {
        return (ds, bias, true)
      }
    }
  }
  (s, bias, true)
}

/// The .debug_ sections of the ELF file data, its .gnu_debuglink's file
/// name and its GNU build id note ("" without them), and whether its
/// section headers could be read.
fn elf_debug(data: Bytes) -> (Sects, Str, Bytes, Bool) {
  if data.len() < 64 {
    return (Sects{}, "", b"", false)
  }
  let f = raw.bytes_addr(data)
  // Elf64_Ehdr: e_shoff 40, e_shnum 60, e_shstrndx 62
  let shoff = ld(f, 40)
  let shn = rt.mem_load(f, 60, 2)
  let shx = rt.mem_load(f, 62, 2)
  if shoff <= 0 || shoff + 64 * shn > data.len() || shx >= shn {
    return (Sects{}, "", b"", false)
  }
  let strs = ld(f + shoff + 64 * shx, 24)
  var s = Sects{data: data}
  var link = ""
  var id = b""
  for i in 0..shn {
    // Elf64_Shdr: sh_name 0, sh_type 4, sh_offset 24, sh_size 32
    let sh = f + shoff + 64 * i
    let off = ld(sh, 24)
    let size = ld(sh, 32)
    if off + size > data.len() || rt.mem_load(sh, 4, 4) == 8 {
      continue
    }
    let name = cstr(f + strs + u32(sh), 64)
    if name.starts_with(".debug_") {
      s.set(name[7..name.len()], f + off, size)
    } else if name == ".gnu_debuglink" && size > 4 {
      link = cstr(f + off, size - 4)
    } else if name == ".note.gnu.build-id" {
      id = data[off..off + size]
    }
  }
  (s, link, id, true)
}

/// macOS: PROG.dSYM/Contents/Resources/DWARF/PROG beside the executable
/// (dladdr of the image's header names it), when its LC_UUID is the
/// image's; addresses moved by the image's slide.
fn load_dsym(lo: Int, hi: Int, var out: Lines) {
  let (s, slide, ok) = dsym_sects()
  if ok && s.line_n > 0 {
    parse(s, slide, lo, hi, out)
    parse_info(s, slide, out)
  }
}

/// macOS: the debug sections of the program and the image's slide (ok
/// false without any): the executable's own __DWARF segment (decision
/// 0346), else PROG.dSYM's whose LC_UUID is the running image's.
fn dsym_sects() -> (Sects, Int, Bool) {
  let mh = sys_darwin._dyld_get_image_header(0)
  if mh == 0 || u32(mh) != 4277009103 {
    return (Sects{}, 0, false)
  }
  let (uuid, slide) = image_uuid(mh)
  if uuid.is_empty() {
    return (Sects{}, 0, false)
  }
  // Dl_info: dli_fname 0
  let info = rt.heap_large(32)
  rt.mem_set(info, 0, 32)
  var exe = ""
  if Int(sys_darwin.dladdr(mh, info)) != 0 && ld(info, 0) != 0 {
    exe = cstr(ld(info, 0), 4096)
  }
  rt.heap_release(info - 8)
  if exe.is_empty() {
    return (Sects{}, 0, false)
  }
  let (own, ok) = macho_dwarf(exe, uuid)
  if ok && own.line_n > 0 {
    return (own, slide, true)
  }
  let (s, same) = macho_dwarf("${exe}.dSYM/Contents/Resources/DWARF/${base(exe)}", uuid)
  (s, slide, same)
}

/// The __DWARF (or __XODW) sections of the Mach-O file at path, and whether its
/// LC_UUID is uuid (the running image's).
fn macho_dwarf(path: Str, uuid: Str) -> (Sects, Bool) {
  let data = read_raw(path)
  if data.len() < 32 {
    return (Sects{}, false)
  }
  let f = raw.bytes_addr(data)
  if u32(f) != 4277009103 {
    return (Sects{}, false)
  }
  let ncmds = u32(f + 16)
  var lc = f + 32
  var same = false
  var s = Sects{data: data}
  for _ in 0..ncmds {
    if lc + 8 > f + data.len() {
      return (Sects{}, false)
    }
    let cmd = u32(lc)
    if cmd == 27 {
      // LC_UUID
      same = hex16(lc + 8) == uuid
    } else if cmd == 25 {
      // LC_SEGMENT_64: nsects at 64, section_64 entries (80 bytes) at 72
      let nsects = u32(lc + 64)
      for k in 0..nsects {
        let sc = lc + 72 + 80 * k
        let seg = cstr(sc + 16, 16)
        // __XODW (decision 0401): the same tables as __DWARF's, for a binary
        // whose DWARF is left in the objects for lldb's debug map; its
        // __xo_ sections are named like the __debug_ ones after the prefix
        if seg != "__DWARF" && seg != "__XODW" {
          continue
        }
        let name = cstr(sc, 16)
        let size = ld(sc, 40)
        let off = u32(sc + 48)
        if off + size > data.len() {
          continue
        }
        if name.starts_with("__debug_") {
          s.set(name[8..name.len()], f + off, size)
        } else if name.starts_with("__xo_") {
          s.set(name[5..name.len()], f + off, size)
        }
      }
    }
    lc += u32(lc + 4)
  }
  (s, same)
}

/// Windows: the sections of the program's file by name, placed by the
/// image's distance from the ImageBase it was linked at.
fn load_pe(lo: Int, hi: Int, var out: Lines) {
  let (s, bias, ok) = pe_sects()
  if ok && s.line_n > 0 {
    parse(s, bias, lo, hi, out)
    parse_info(s, bias, out)
  }
}

/// Windows: the .debug_ sections of the program's file (a name past 8
/// bytes is "/" and its offset in the string table after the symbol
/// table) and the load bias (ok false when the file cannot be read).
fn pe_sects() -> (Sects, Int, Bool) {
  let data = read_self()
  let n = data.len()
  if n < 64 {
    return (Sects{}, 0, false)
  }
  let f = raw.bytes_addr(data)
  let pe = u32(f + 60)
  if pe + 24 + 112 > n {
    return (Sects{}, 0, false)
  }
  // the COFF header: sections 2, symbol table 8, symbols 12, optional
  // header's size 16; PE32+'s ImageBase at 24 of the optional header
  let coff = f + pe + 4
  let nsec = u16(coff + 2)
  let strs = u32(coff + 8) + 18 * u32(coff + 12)
  let sec = coff + 20 + u16(coff + 16)
  let bias = sys_windows.GetModuleHandleW(0) - ld(coff + 20, 24)
  if sec + 40 * nsec > f + n {
    return (Sects{}, 0, false)
  }
  var s = Sects{data: data}
  for i in 0..nsec {
    // IMAGE_SECTION_HEADER: VirtualSize 8, PointerToRawData 20
    let sh = sec + 40 * i
    var name = cstr(sh, 8)
    if name.starts_with("/") {
      let k = Int.parse(name[1..name.len()]) ?? -1
      if k < 4 || u32(coff + 8) == 0 || strs + k >= n {
        continue
      }
      name = cstr(f + strs + k, 64)
    }
    let size = u32(sh + 8)
    let off = u32(sh + 20)
    if off + size > n {
      continue
    }
    if name.starts_with(".debug_") {
      s.set(name[7..name.len()], f + off, size)
    }
  }
  (s, bias, true)
}

/// Windows: the bytes of the program's file (empty when it cannot be
/// read). The profiler's symbols (prof.xo coff_symbols) read it too.
pub fn read_self() -> Bytes {
  // 32,767 UTF-16 units and the NUL, written in place
  var z = BytesBuilder.with_capacity(65536)
  for _ in 0..65536 {
    z.write_byte(UInt8(0))
  }
  let path = z.freeze()
  let n = Int(sys_windows.GetModuleFileNameW(0, raw.bytes_addr(path), 32767))
  if n == 0 || n >= 32767 {
    return b""
  }
  // GENERIC_READ, shared for reading, writing and deleting, OPEN_EXISTING
  let h = sys_windows.CreateFileW(path, 2147483648, 7, 0, 3, 128, 0)
  if h == -1 {
    return b""
  }
  let size = windows.file_size(h)
  if size <= 0 {
    let _c = windows.close(h)
    return b""
  }
  var b = BytesBuilder.with_capacity(size)
  var zb = BytesBuilder.with_capacity(65536)
  for _ in 0..65536 {
    zb.write_byte(UInt8(0))
  }
  let buf = zb.freeze()
  while true {
    let r = windows.read(h, buf, 0, 65536)
    if r <= 0 {
      break
    }
    b.write(buf[0..r])
  }
  let _c = windows.close(h)
  b.freeze()
}

fn read_raw(path: Str) -> Bytes {
  let buf = rt.heap_large(65536)
  var b = BytesBuilder.new()
  var fd = -1
  match target.os {
    TargetOs.Darwin => fd = Int(sys_darwin.open("${path}\x00".bytes(), 0, 0))
    TargetOs.Linux => fd = linux.open(path, 524288, 0)
    TargetOs.Windows | TargetOs.Wasi => {}
  }
  if fd >= 0 {
    while true {
      var r = 0
      match target.os {
        TargetOs.Darwin => r = sys_darwin.read(fd, buf, 65536)
        TargetOs.Linux => {
          r = linux.read_at(fd, buf, 65536)
          if r == -4 {
            continue
          }
        }
        TargetOs.Windows | TargetOs.Wasi => {}
      }
      if r <= 0 {
        break
      }
      for i in 0..r {
        b.write_byte(UInt8(rt.mem_load(buf, i, 1)))
      }
    }
    match target.os {
      TargetOs.Darwin => {
        let _c = sys_darwin.close(fd)
      }
      TargetOs.Linux => {
        let _c = linux.close(fd)
      }
      TargetOs.Windows | TargetOs.Wasi => {}
    }
  }
  rt.heap_release(buf - 8)
  b.freeze()
}

/// The image's LC_UUID (hex) and its slide (its address against its
/// __TEXT's vmaddr).
fn image_uuid(mh: Int) -> (Str, Int) {
  let ncmds = u32(mh + 16)
  var lc = mh + 32
  var uuid = ""
  var slide = 0
  for _ in 0..ncmds {
    let cmd = u32(lc)
    if cmd == 27 {
      uuid = hex16(lc + 8)
    } else if cmd == 25 && cstr(lc + 8, 16) == "__TEXT" {
      slide = mh - ld(lc, 24)
    }
    lc += u32(lc + 4)
  }
  (uuid, slide)
}

fn hex16(p: Int) -> Str {
  var b = StrBuilder.new()
  for i in 0..16 {
    let v = rt.mem_load(p, i, 1)
    b.write("0123456789abcdef"[v / 16..v / 16 + 1])
    b.write("0123456789abcdef"[v % 16..v % 16 + 1])
  }
  b.freeze()
}

/// The NUL terminated string at p, at most n bytes.
fn cstr(p: Int, n: Int) -> Str {
  var k = 0
  while k < n && rt.mem_load(p, k, 1) != 0 {
    k += 1
  }
  var b = BytesBuilder.with_capacity(k)
  for i in 0..k {
    b.write_byte(UInt8(rt.mem_load(p, i, 1)))
  }
  b.freeze().to_str() ?? ""
}

// ---------------------------------------------------------------------------
// Line programs

/// A reader over [p, end).
struct Rd {
  p: Int
  end: Int
}

fn (var r: Rd) byte() -> Int {
  if r.p >= r.end {
    return 0
  }
  let v = u8(r.p)
  r.p += 1
  v
}

fn (var r: Rd) uleb() -> Int {
  var v = 0
  var shift = 0
  while r.p < r.end {
    let b = u8(r.p)
    r.p += 1
    if shift < 63 {
      v = v | ((b & 127) << shift)
    }
    shift += 7
    if b < 128 {
      break
    }
  }
  v
}

fn (var r: Rd) sleb() -> Int {
  var v = 0
  var shift = 0
  var b = 0
  while r.p < r.end {
    b = u8(r.p)
    r.p += 1
    if shift < 63 {
      v = v | ((b & 127) << shift)
    }
    shift += 7
    if b < 128 {
      break
    }
  }
  if shift < 64 && (b & 64) != 0 {
    v = v | (-1 << shift)
  }
  v
}

fn (var r: Rd) cstr() -> Str {
  var k = 0
  while r.p + k < r.end && u8(r.p + k) != 0 {
    k += 1
  }
  let s = cstr(r.p, k)
  r.p += k + 1
  s
}

/// A v5 entry's field of form fm: a string (for DW_LNCT_path) or a
/// number (the directory index); unknown forms end the parse (ok false).
fn (var r: Rd) form(fm: Int, s: Sects) -> (Str, Int, Bool) {
  match fm {
    0x08 => (r.cstr(), 0, true)
    0x1f => {
      let o = u32(r.p)
      r.p += 4
      (if o < s.lstr_n { cstr(s.lstr + o, s.lstr_n - o) } else { "" }, 0, true)
    }
    0x0e => {
      let o = u32(r.p)
      r.p += 4
      (if o < s.str_n { cstr(s.str + o, s.str_n - o) } else { "" }, 0, true)
    }
    0x0f => ("", r.uleb(), true)
    0x0b => ("", r.byte(), true)
    0x05 => {
      let v = u16(r.p)
      r.p += 2
      ("", v, true)
    }
    0x06 => {
      let v = u32(r.p)
      r.p += 4
      ("", v, true)
    }
    0x07 => {
      let v = ld(r.p, 0)
      r.p += 8
      ("", v, true)
    }
    0x1e => {
      r.p += 16
      ("", 0, true)
    }
    0x09 => {
      let n = r.uleb()
      r.p += n
      ("", 0, true)
    }
    _ => ("", 0, false)
  }
}

/// p joined to dir (p when absolute or dir is empty).
fn join(dir: Str, p: Str) -> Str {
  if p.starts_with("/") || dir.is_empty() {
    return p
  }
  "${dir}/${p}"
}

/// Every unit's line program into out (rows with addresses in [lo, hi)
/// after bias), then the rows sorted.
fn parse(s: Sects, bias: Int, lo: Int, hi: Int, var out: Lines) {
  var at: List[Int] = []
  var ra: List[Int] = []
  var rf: List[Int] = []
  var rl: List[Int] = []
  var u = s.line
  let end = s.line + s.line_n
  while u + 12 <= end {
    let len = u32(u)
    if len == 0xffffffff || len == 0 {
      break // 64 bit DWARF is not made by Xo's backends
    }
    let next = u + 4 + len
    if next > end {
      break
    }
    var r = Rd{p: u + 4, end: next}
    let ver = u16(r.p)
    r.p += 2
    if ver < 2 || ver > 5 {
      u = next
      continue
    }
    if ver >= 5 {
      r.p += 2 // address_size, segment_selector_size
    }
    let hlen = u32(r.p)
    r.p += 4
    let prog = r.p + hlen
    let min_inst = r.byte()
    if ver >= 4 {
      let _m = r.byte()
    }
    let _stmt = r.byte()
    var line_base = r.byte()
    if line_base >= 128 {
      line_base -= 256
    }
    let line_range = r.byte()
    let op_base = r.byte()
    var lens: List[Int] = [0]
    for _ in 1..op_base {
      lens.push(r.byte())
    }
    // the files of this unit: global indexes, by the program's numbering
    var dirs: List[Str] = []
    var fmap: List[Int] = []
    var ok = true
    if ver >= 5 {
      let dfc = r.byte()
      var dfmt: List[(Int, Int)] = []
      for _ in 0..dfc {
        let c = r.uleb()
        dfmt.push((c, r.uleb()))
      }
      let nd = r.uleb()
      for _ in 0..nd {
        var path = ""
        for (c, fm) in dfmt {
          let (sv, _, fok) = r.form(fm, s)
          ok = ok && fok
          if c == 1 {
            path = sv
          }
        }
        dirs.push(path)
      }
      let ffc = r.byte()
      var ffmt: List[(Int, Int)] = []
      for _ in 0..ffc {
        let c = r.uleb()
        ffmt.push((c, r.uleb()))
      }
      let nf = r.uleb()
      for _ in 0..nf {
        var path = ""
        var di = 0
        for (c, fm) in ffmt {
          let (sv, nv, fok) = r.form(fm, s)
          ok = ok && fok
          if c == 1 {
            path = sv
          } else if c == 2 {
            di = nv
          }
        }
        let full = join(if di < dirs.len() { dirs[di] } else { "" }, path)
        fmap.push(intern(full, at, out))
      }
    } else {
      dirs.push("")
      while r.p < prog {
        let d = r.cstr()
        if d.is_empty() {
          break
        }
        dirs.push(d)
      }
      // v2 to v4 number files from 1
      fmap.push(-1)
      while r.p < prog {
        let name = r.cstr()
        if name.is_empty() {
          break
        }
        let di = r.uleb()
        let _t = r.uleb()
        let _l = r.uleb()
        fmap.push(intern(join(if di < dirs.len() { dirs[di] } else { "" }, name), at, out))
      }
    }
    out.uf_ix.put(u - s.line, out.uf.len())
    out.uf.push(fmap)
    if !ok || line_range == 0 {
      u = next
      continue
    }
    // the program
    r.p = prog
    var addr = 0
    var file = 1
    var line = 1
    while r.p < next {
      let op = r.byte()
      var emit = false
      if op >= op_base {
        let adj = op - op_base
        addr += (adj / line_range) * min_inst
        line += line_base + adj % line_range
        emit = true
      } else if op == 0 {
        let n = r.uleb()
        let at0 = r.p
        let sub = r.byte()
        if sub == 1 {
          // end_sequence: a row that ends the table there
          let a = addr + bias
          if a >= lo && a <= hi {
            ra.push(a)
            rf.push(-1)
            rl.push(0)
          }
          addr = 0
          file = 1
          line = 1
        } else if sub == 2 {
          addr = ld(r.p, 0)
        }
        r.p = at0 + n
      } else if op == 1 {
        emit = true
      } else if op == 2 {
        addr += r.uleb() * min_inst
      } else if op == 3 {
        line += r.sleb()
      } else if op == 4 {
        file = r.uleb()
      } else if op == 5 {
        let _c = r.uleb()
      } else if op == 8 {
        addr += ((255 - op_base) / line_range) * min_inst
      } else if op == 9 {
        addr += u16(r.p)
        r.p += 2
      } else if op == 12 {
        let _i = r.uleb()
      } else if op == 6 || op == 7 || op == 10 || op == 11 {
        // negate_stmt, basic_block, prologue_end, epilogue_begin
      } else {
        // an opcode of a later version: skip its operands
        for _ in 0..(if op < lens.len() { lens[op] } else { 0 }) {
          let _x = r.uleb()
        }
      }
      if emit {
        let a = addr + bias
        if a >= lo && a < hi && file >= 0 && file < fmap.len() && fmap[file] >= 0 {
          ra.push(a)
          rf.push(fmap[file])
          rl.push(line + 0)
        }
      }
    }
    u = next
  }
  // sorted by address; at one address, a sequence's end before a row
  // (key: offset << 21 | row bit << 20 | index)
  var keys: List[Int] = []
  for i in 0..ra.len() {
    if i < 1048576 {
      let rowbit = if rf[i] < 0 { 0 } else { 1 }
      keys.push((ra[i] - lo).wrapping_shl(21) | (rowbit << 20) | i)
    }
  }
  keys = keys.sort()
  for k in keys {
    let i = k & 1048575
    out.addrs.push(ra[i])
    out.files.push(rf[i])
    out.lines.push(rl[i])
  }
}

/// The index of file name in out.names, added once.
fn intern(name: Str, var at: List[Int], var out: Lines) -> Int {
  // at: the indexes of out.names this parse added, ordered by name (a
  // sorted List searched by halves, not a Map: decision 0371)
  var lo = 0
  var hi = at.len()
  while lo < hi {
    let m = (lo + hi) / 2
    let x = out.names[at[m]]
    if x == name {
      return at[m]
    }
    if x < name {
      lo = m + 1
    } else {
      hi = m
    }
  }
  out.names.push(name)
  let k = out.names.len() - 1
  at.insert(lo, k)
  k
}

/// An Int to Int table that is two Lists, searched by halves, for the
/// DWARF readers (decision 0371): the generic Map costs 9 to 20 KB of
/// code per key and value type, and dwline used eight of them. Keys
/// arrive in increasing order (a .debug_info offset, a line program's
/// offset, an abbreviation code), so a put appends; a key that is not
/// above the last is looked for, replaced when present, else appended and
/// the table searched linearly from then on (a producer we do not
/// control may number its codes or order its entries any way). A value
/// is an Int: a typed side List holds the rest, this table maps to its
/// index.
struct IntIdx {
  keys: List[Int] = []
  vals: List[Int] = []
  sorted: Bool = true
}

/// The position of key k, or -1.
fn (t: IntIdx) find(k: Int) -> Int {
  if !t.sorted {
    for i in 0..t.keys.len() {
      if t.keys[i] == k {
        return i
      }
    }
    return -1
  }
  var lo = 0
  var hi = t.keys.len()
  while lo < hi {
    let m = (lo + hi) / 2
    let x = t.keys[m]
    if x == k {
      return m
    }
    if x < k {
      lo = m + 1
    } else {
      hi = m
    }
  }
  -1
}

/// The value of key k, or -1 when it is absent.
fn (t: IntIdx) get(k: Int) -> Int {
  let i = t.find(k)
  if i < 0 {
    return -1
  }
  t.vals[i]
}

fn (var t: IntIdx) put(k: Int, v: Int) {
  let n = t.keys.len()
  if n == 0 || k > t.keys[n - 1] {
    t.keys.push(k)
    t.vals.push(v)
    return
  }
  let i = t.find(k)
  if i >= 0 {
    t.vals[i] = v
    return
  }
  t.sorted = false
  t.keys.push(k)
  t.vals.push(v)
}

// ---------------------------------------------------------------------------
// Inlined calls (.debug_info)

/// One attribute of an abbreviation: its name, form, and an implicit
/// constant (DW_FORM_implicit_const).
struct AbAttr {
  at: Int
  form: Int
  imp: Int = 0
}

/// An abbreviation: tag, whether its entries have children, attributes.
struct Abbrev {
  tag: Int
  kids: Bool
  attrs: List[AbAttr]
}

/// An abbreviation table: the codes, searched by halves (IntIdx; a table
/// whose codes skip numbers or come in any order is found by the
/// fallback), and the abbreviations.
struct AbTab {
  ix: IntIdx = IntIdx{}
  ab: List[Abbrev] = []
}

fn (t: AbTab) get(code: Int) -> Abbrev? {
  let i = t.ix.get(code)
  if i < 0 {
    return None
  }
  Some(t.ab[i])
}

fn (var t: AbTab) put(code: Int, a: Abbrev) {
  let i = t.ix.get(code)
  if i >= 0 {
    t.ab[i] = a
    return
  }
  t.ix.put(code, t.ab.len())
  t.ab.push(a)
}

/// The abbreviation table at offset off of .debug_abbrev, by code.
fn abbrevs(s: Sects, off: Int) -> AbTab {
  var out = AbTab{}
  if off >= s.abbrev_n {
    return out
  }
  var r = Rd{p: s.abbrev + off, end: s.abbrev + s.abbrev_n}
  while r.p < r.end {
    let code = r.uleb()
    if code == 0 {
      break
    }
    let tag = r.uleb()
    let kids = r.byte() != 0
    var attrs: List[AbAttr] = []
    while r.p < r.end {
      let at = r.uleb()
      let form = r.uleb()
      if at == 0 && form == 0 {
        break
      }
      var imp = 0
      if form == 0x21 {
        imp = r.sleb()
      }
      attrs.push(AbAttr{at: at, form: form, imp: imp})
    }
    out.put(code, Abbrev{tag: tag, kids: kids, attrs: attrs})
  }
  out
}

/// A unit's bases (DWARF 5: str_offsets_base, addr_base,
/// rnglists_base), address size, and the low_pc rnglists are based on.
struct Unit {
  start: Int
  ver: Int
  asize: Int = 8
  str_base: Int = 8
  addr_base: Int = 8
  rng_base: Int = 12
  loc_base: Int = 12
  low: Int = 0
}

/// A field's value: a number (or address, offset, index), or a string
/// (str_ok), or neither (a block, an expression).
struct FVal {
  n: Int = 0
  str: Str = ""
  str_ok: Bool = false
  /// the form named an index (strx, addrx, rnglistx) to resolve against
  /// the unit's bases
  idx: Bool = false
  /// a block form's bytes (exprloc, blockN): their address and count
  blk: Int = 0
  blk_n: Int = 0
}

/// Reads a field of form fm (ok false for a form not known: the unit is
/// left).
fn read_form(var r: Rd, fm: Int, s: Sects, u: Unit, imp: Int) -> (FVal, Bool) {
  match fm {
    0x01 => {
      let v = if u.asize == 4 { u32(r.p) } else { ld(r.p, 0) }
      r.p += u.asize
      (FVal{n: v}, true)
    }
    0x0b | 0x11 => (FVal{n: r.byte()}, true)
    0x05 | 0x12 => {
      let v = u16(r.p)
      r.p += 2
      (FVal{n: v}, true)
    }
    0x06 | 0x13 | 0x17 | 0x10 => {
      let v = u32(r.p)
      r.p += 4
      (FVal{n: v}, true)
    }
    0x07 | 0x14 | 0x20 => {
      let v = ld(r.p, 0)
      r.p += 8
      (FVal{n: v}, true)
    }
    0x0f | 0x15 => (FVal{n: r.uleb()}, true)
    0x0d => (FVal{n: r.sleb()}, true)
    0x08 => (FVal{str: r.cstr(), str_ok: true}, true)
    0x0e => {
      let o = u32(r.p)
      r.p += 4
      (FVal{str: if o < s.str_n { cstr(s.str + o, s.str_n - o) } else { "" }, str_ok: true}, true)
    }
    0x1f => {
      let o = u32(r.p)
      r.p += 4
      (FVal{str: if o < s.lstr_n { cstr(s.lstr + o, s.lstr_n - o) } else { "" }, str_ok: true}, true)
    }
    0x1a => (str_x(s, u, r.uleb()), true)
    0x25 => (str_x(s, u, r.byte()), true)
    0x26 => {
      let v = u16(r.p)
      r.p += 2
      (str_x(s, u, v), true)
    }
    0x27 => {
      let v = u16(r.p) | (u8(r.p + 2) << 16)
      r.p += 3
      (str_x(s, u, v), true)
    }
    0x28 => {
      let v = u32(r.p)
      r.p += 4
      (str_x(s, u, v), true)
    }
    0x1b | 0x22 | 0x23 => (FVal{n: r.uleb(), idx: true}, true)
    0x29 => (FVal{n: r.byte(), idx: true}, true)
    0x2a => {
      let v = u16(r.p)
      r.p += 2
      (FVal{n: v, idx: true}, true)
    }
    0x2b => {
      let v = u16(r.p) | (u8(r.p + 2) << 16)
      r.p += 3
      (FVal{n: v, idx: true}, true)
    }
    0x2c => {
      let v = u32(r.p)
      r.p += 4
      (FVal{n: v, idx: true}, true)
    }
    0x0c => (FVal{n: r.byte()}, true)
    0x19 => (FVal{n: 1}, true)
    0x21 => (FVal{n: imp}, true)
    0x1e => {
      r.p += 16
      (FVal{}, true)
    }
    0x0a => {
      let n = r.byte()
      let b = r.p
      r.p += n
      (FVal{blk: b, blk_n: n}, true)
    }
    0x03 => {
      let n = u16(r.p)
      let b = r.p + 2
      r.p += 2 + n
      (FVal{blk: b, blk_n: n}, true)
    }
    0x04 => {
      let n = u32(r.p)
      let b = r.p + 4
      r.p += 4 + n
      (FVal{blk: b, blk_n: n}, true)
    }
    0x09 | 0x18 => {
      let n = r.uleb()
      let b = r.p
      r.p += n
      (FVal{blk: b, blk_n: n}, true)
    }
    _ => (FVal{}, false)
  }
}

/// String k of the unit's string offsets.
fn str_x(s: Sects, u: Unit, k: Int) -> FVal {
  let o = u.str_base + 4 * k
  if o + 4 > s.stroff_n {
    return FVal{str_ok: true}
  }
  let so = u32(s.stroff + o)
  FVal{str: if so < s.str_n { cstr(s.str + so, s.str_n - so) } else { "" }, str_ok: true}
}

/// Address k of the unit's address table.
fn addr_x(s: Sects, u: Unit, k: Int) -> Int {
  let o = u.addr_base + 8 * k
  if o + 8 > s.addr_n {
    return 0
  }
  ld(s.addr + o, 0)
}

/// The ranges of a rnglist at offset off of .debug_rnglists.
fn rnglist(s: Sects, u: Unit, off: Int) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  if off >= s.rng_n {
    return out
  }
  var r = Rd{p: s.rng + off, end: s.rng + s.rng_n}
  var base = u.low
  while r.p < r.end {
    let k = r.byte()
    match k {
      0 => break
      1 => base = addr_x(s, u, r.uleb())
      2 => {
        let a = addr_x(s, u, r.uleb())
        out.push((a, addr_x(s, u, r.uleb())))
      }
      3 => {
        let a = addr_x(s, u, r.uleb())
        out.push((a, a + r.uleb()))
      }
      4 => {
        let a = r.uleb()
        out.push((base + a, base + r.uleb()))
      }
      5 => {
        base = ld(r.p, 0)
        r.p += 8
      }
      6 => {
        let a = ld(r.p, 0)
        out.push((a, ld(r.p, 8)))
        r.p += 16
      }
      7 => {
        let a = ld(r.p, 0)
        r.p += 8
        out.push((a, a + r.uleb()))
      }
      _ => break
    }
  }
  out
}

/// A DW_TAG_inlined_subroutine read, before its origin's name is known.
struct InlRec {
  ranges: List[(Int, Int)]
  depth: Int
  origin: Int
  file: Int
  line: Int
}

/// Every unit's inlined calls into out (addresses moved by bias), with
/// their callees' names (abstract_origin, one level of specification or
/// origin followed).
fn parse_info(s: Sects, bias: Int, var out: Lines) {
  if s.info_n == 0 || s.abbrev_n == 0 {
    return
  }
  // the entries' names and origins by offset in .debug_info
  var names = IntIdx{}
  var name_v: List[Str] = []
  var origins = IntIdx{}
  var recs: List[InlRec] = []
  var p = s.info
  let end = s.info + s.info_n
  while p + 11 <= end {
    let len = u32(p)
    if len == 0 || len == 0xffffffff {
      break
    }
    let next = p + 4 + len
    if next > end {
      break
    }
    var u = Unit{start: p - s.info, ver: u16(p + 4)}
    var r = Rd{p: p + 6, end: next}
    var aoff = 0
    if u.ver >= 5 {
      let _ut = r.byte()
      u.asize = r.byte()
      aoff = u32(r.p)
      r.p += 4
    } else {
      aoff = u32(r.p)
      r.p += 4
      u.asize = r.byte()
    }
    let tab = abbrevs(s, aoff)
    // the unit's line program's files (DW_AT_stmt_list)
    var files: List[Int] = []
    var depth = 0
    // the inlined depth at each level of the tree (entries' children)
    var inl_at: List[Int] = [0]
    var ok = true
    while ok && r.p < next {
      let die = r.p - s.info
      let code = r.uleb()
      if code == 0 {
        if depth > 0 {
          depth -= 1
          let _x = inl_at.pop()
        }
        continue
      }
      let ab = match tab.get(code) {
        Some(a) => a
        None => {
          ok = false
          Abbrev{tag: 0, kids: false, attrs: []}
        }
      }
      if !ok {
        break
      }
      var name = ""
      var origin = -1
      var low = 0
      var low_x = false
      var high = 0
      var high_x = false
      var high_off = false
      var rng = -1
      var rng_x = false
      var cfile = 0
      var cline = 0
      for a in ab.attrs {
        let (v, fok) = read_form(r, a.form, s, u, a.imp)
        if !fok {
          ok = false
          break
        }
        match a.at {
          0x03 => if v.str_ok { name = v.str }
          0x31 | 0x47 => {
            // abstract_origin, specification: a unit relative reference
            // (ref_addr: from the section's start)
            origin = if a.form == 0x10 { v.n } else { u.start + v.n }
          }
          0x11 => {
            low = v.n
            low_x = v.idx
          }
          0x12 => {
            high = v.n
            high_x = v.idx
            // a constant class high_pc is an offset from low_pc
            high_off = !(a.form == 0x01 || a.form == 0x1b || (a.form >= 0x29 && a.form <= 0x2c))
          }
          0x55 => {
            rng = v.n
            rng_x = v.idx
          }
          0x58 => cfile = v.n
          0x59 => cline = v.n
          0x10 => {
            // stmt_list: this unit's line program
            let ui = out.uf_ix.get(v.n)
            files = if ui >= 0 { out.uf[ui] } else { [] }
          }
          0x72 => u.str_base = v.n
          0x73 => u.addr_base = v.n
          0x74 => u.rng_base = v.n
          _ => {}
        }
      }
      if !ok {
        break
      }
      if low_x {
        low = addr_x(s, u, low)
      }
      if high_x {
        high = addr_x(s, u, high)
      }
      if high_off {
        high = low + high
      }
      if ab.tag == 0x11 {
        u.low = low
      }
      if !name.is_empty() {
        names.put(die, name_v.len())
        name_v.push(name)
      }
      if origin >= 0 {
        origins.put(die, origin)
      }
      var here = inl_at[inl_at.len() - 1]
      if ab.tag == 0x1d {
        here += 1
        var ranges: List[(Int, Int)] = []
        if rng >= 0 {
          var off = rng
          if rng_x {
            let o = u.rng_base + 4 * rng
            off = if o + 4 <= s.rng_n { u.rng_base + u32(s.rng + o) } else { s.rng_n }
          }
          ranges = rnglist(s, u, off)
        } else if high > low {
          ranges = [(low, high)]
        }
        let fi = if cfile < files.len() { files[cfile] } else { -1 }
        recs.push(InlRec{ranges: ranges, depth: here, origin: origin, file: fi, line: cline})
      }
      if ab.kids {
        depth += 1
        inl_at.push(here)
      }
    }
    p = next
  }
  for rec in recs {
    // the callee's name: the origin's, or its own origin's
    var name = ""
    var o = rec.origin
    var guard = 0
    while o >= 0 && guard < 4 {
      let ni = names.get(o)
      if ni >= 0 {
        name = name_v[ni]
        break
      }
      o = origins.get(o)
      guard += 1
    }
    if name.is_empty() {
      name = "?"
    }
    for (a, b) in rec.ranges {
      out.inl_lo.push(a + bias)
      out.inl_hi.push(b + bias)
      out.inl_depth.push(rec.depth)
      out.inl_name.push(name)
      out.inl_file.push(rec.file)
      out.inl_line.push(rec.line)
    }
  }
}

/// A frame of the code at an address: function, file, and line.
pub struct Frame {
  pub name: Str
  pub file: Str
  pub line: Int
}

/// The inlined frames at pc, innermost first (each callee at its line:
/// the line table's for the innermost, the call's below it), and the
/// file and line of the function holding them all (the outermost call's,
/// or pc's own when nothing is inlined there).
///
/// fname is the function's symbol: LLVM inlines the program's main into
/// xo_entry, which the printers show as main, so there the outermost
/// inlined frame main is the function itself (not listed twice).
pub fn inline_chain(t: Lines, pc: Int, fname: Str) -> (List[Frame], Str, Int) {
  // the entries holding pc, by depth
  var by: List[Int] = []
  for i in 0..t.inl_lo.len() {
    if t.inl_lo[i] <= pc && pc < t.inl_hi[i] {
      by.push(i)
    }
  }
  let (f0, l0) = find(t, pc)
  if by.is_empty() {
    return ([], f0, l0)
  }
  // deepest first
  var keys: List[Int] = []
  for i in by {
    keys.push(t.inl_depth[i].wrapping_shl(32) | i)
  }
  keys = keys.sort()
  var order: List[Int] = []
  var k = keys.len() - 1
  while k >= 0 {
    order.push(keys[k] & 4294967295)
    k -= 1
  }
  var frames: List[Frame] = []
  var file = f0
  var line = l0
  for i in order {
    frames.push(Frame{name: t.inl_name[i], file: file, line: line})
    file = if t.inl_file[i] >= 0 && t.inl_file[i] < t.names.len() { t.names[t.inl_file[i]] } else { "" }
    line = t.inl_line[i]
  }
  if fname == "xo_entry" && frames.len() > 0 && frames[frames.len() - 1].name == "main" {
    let m = frames[frames.len() - 1]
    let _x = frames.pop()
    return (frames, m.file, m.line)
  }
  (frames, file, line)
}

// ---------------------------------------------------------------------------
// Variables (decision 0268): the frames' locals for a fault report under
// XO_TRACEBACK=locals, from the same DWARF (decision 0252's variables:
// DW_TAG_variable and formal_parameter with a type and a location list or
// expression), read as above.

/// A type entry by its .debug_info offset: tag (base 0x24, structure
/// 0x13, union 0x17, typedef 0x16, pointer 0x0f, enumeration 0x04), name,
/// byte size, base encoding, the referenced type (typedef, pointer,
/// enumeration's base), members (structure, union), enumerators.
struct VTy {
  tag: Int = 0
  name: Str = ""
  size: Int = 0
  enc: Int = 0
  target: Int = -1
  m_names: List[Str] = []
  m_types: List[Int] = []
  m_offs: List[Int] = []
  e_names: List[Str] = []
  e_vals: List[Int] = []
}

/// A variable: name, type (offset), whether a parameter, and its
/// location: an expression (address and count) or a list (offset in
/// .debug_loclists, -1 for none), read with its unit (index of units).
struct VVar {
  name: Str
  ty: Int
  param: Bool
  /// an inlined copy's abstract variable (its name and type), -1
  origin: Int = -1
  /// the ranges of the innermost inlined call or lexical block holding
  /// it (unplaced; none: the whole function)
  within: List[(Int, Int)] = []
  /// the function of the innermost inlined call holding it ("" for the
  /// function's own) and how many inlined calls hold it, so the report
  /// prints it under that call's frame
  inl: Str = ""
  depth: Int = 0
  /// that call's abstract origin, for inl when the call has no name
  inl_origin: Int = -1
  expr: Int = 0
  expr_n: Int = 0
  list: Int = -1
  /// its declaration's line (DW_AT_decl_line), 0 when not given: a
  /// variable declared after the fault's line has no value yet
  decl: Int = 0
  unit: Int = 0
}

/// A function: its code's range (placed), name, frame base expression,
/// and variables.
struct VFn {
  lo: Int
  hi: Int
  name: Str
  fb: Int = 0
  fb_n: Int = 0
  vars: List[VVar] = []
}

/// The types by their .debug_info offset (an IntIdx and the VTys).
struct TyTab {
  ix: IntIdx = IntIdx{}
  ts: List[VTy] = []
}

fn (t: TyTab) get(k: Int) -> VTy? {
  let i = t.ix.get(k)
  if i < 0 {
    return None
  }
  Some(t.ts[i])
}

fn (var t: TyTab) put(k: Int, ty: VTy) {
  let i = t.ix.get(k)
  if i >= 0 {
    t.ts[i] = ty
    return
  }
  t.ix.put(k, t.ts.len())
  t.ts.push(ty)
}

/// The program's variables: functions sorted by lo, types by offset.
pub struct Vars {
  fns: List[VFn] = []
  types: TyTab = TyTab{}
  units: List[Unit] = []
  s: Sects = Sects{}
  bias: Int = 0
  /// why there are none ("" when read)
  pub why: Str = ""
}

/// The program's variables (none, with why, when its DWARF cannot be
/// read).
pub fn vars_load() -> Vars {
  if !built() {
    return Vars{why: "no DWARF (a release or stripped build)"}
  }
  var ok = false
  var s = Sects{}
  var bias = 0
  match target.os {
    TargetOs.Linux => {
      let (a, b, c) = elf_sects()
      s = a
      bias = b
      ok = c
    }
    TargetOs.Darwin => {
      let (a, b, c) = dsym_sects()
      s = a
      bias = b
      ok = c
    }
    TargetOs.Windows => {
      // the exe's own .debug_ sections, as load_pe's lines (its PDB is
      // the debuggers')
      let (a, b, c) = pe_sects()
      s = a
      bias = b
      ok = c
    }
    TargetOs.Wasi => {}
  }
  if !ok || s.info_n == 0 || s.abbrev_n == 0 {
    return Vars{why: "no DWARF (a release or stripped build)"}
  }
  var v = Vars{s: s, bias: bias}
  parse_vars(v)
  v
}

/// Every unit's functions, variables, and types into v.
fn parse_vars(var v: Vars) {
  let s = v.s
  // the named variables by offset, for the inlined copies that name
  // theirs through DW_AT_abstract_origin (LLVM's)
  var named = IntIdx{}
  var named_n: List[Str] = []
  var named_t: List[Int] = []
  var decls = IntIdx{}
  // the functions' names by offset, for the inlined calls' origins
  var fnames = IntIdx{}
  var fname_v: List[Str] = []
  var p = s.info
  let end = s.info + s.info_n
  while p + 11 <= end {
    let len = u32(p)
    if len == 0 || len == 0xffffffff {
      break
    }
    let next = p + 4 + len
    if next > end {
      break
    }
    var u = Unit{start: p - s.info, ver: u16(p + 4)}
    var r = Rd{p: p + 6, end: next}
    var aoff = 0
    if u.ver >= 5 {
      let _ut = r.byte()
      u.asize = r.byte()
      aoff = u32(r.p)
      r.p += 4
    } else {
      aoff = u32(r.p)
      r.p += 4
      u.asize = r.byte()
    }
    let tab = abbrevs(s, aoff)
    let ui = v.units.len()
    v.units.push(u)
    // the entries open at each depth: the function (an index of v.fns,
    // -1) and the type (an offset, -1) whose children follow
    var fn_at: List[Int] = [-1]
    var ty_at: List[Int] = [-1]
    var scope_at: List[List[(Int, Int)]] = [[]]
    // the innermost inlined call open at each depth: its function's
    // name, its abstract origin, how many inlined calls hold it
    var inl_at: List[(Str, Int, Int)] = [("", -1, 0)]
    var ok = true
    while ok && r.p < next {
      let die = r.p - s.info
      let code = r.uleb()
      if code == 0 {
        if fn_at.len() > 1 {
          let _a = fn_at.pop()
          let _b = ty_at.pop()
          let _c = scope_at.pop()
          let _d = inl_at.pop()
        }
        continue
      }
      let ab = match tab.get(code) {
        Some(a) => a
        None => {
          ok = false
          Abbrev{tag: 0, kids: false, attrs: []}
        }
      }
      if !ok {
        break
      }
      var name = ""
      var low = 0
      var low_x = false
      var high = 0
      var high_x = false
      var high_off = false
      var ty = -1
      var size = 0
      var enc = 0
      var mloc = 0
      var cval = 0
      var loc = FVal{}
      var loc_list = false
      var fb = FVal{}
      var origin = -1
      var rng = -1
      var rng_x = false
      var dline = 0
      for a in ab.attrs {
        let (fv, fok) = read_form(r, a.form, s, u, a.imp)
        if !fok {
          ok = false
          break
        }
        match a.at {
          0x03 => if fv.str_ok { name = fv.str }
          0x11 => {
            low = fv.n
            low_x = fv.idx
          }
          0x12 => {
            high = fv.n
            high_x = fv.idx
            high_off = !(a.form == 0x01 || a.form == 0x1b || (a.form >= 0x29 && a.form <= 0x2c))
          }
          0x49 => ty = if a.form == 0x10 { fv.n } else { u.start + fv.n }
          0x0b => size = fv.n
          0x3e => enc = fv.n
          0x38 => mloc = fv.n
          0x1c => cval = fv.n
          0x02 => {
            loc = fv
            // a location list: loclistx (an index), sec_offset
            loc_list = a.form == 0x22 || a.form == 0x17 || a.form == 0x06
          }
          0x40 => fb = fv
          0x31 => origin = if a.form == 0x10 { fv.n } else { u.start + fv.n }
          0x3b => dline = fv.n
          0x55 => {
            rng = fv.n
            rng_x = fv.idx
          }
          0x72 => u.str_base = fv.n
          0x73 => u.addr_base = fv.n
          0x74 => u.rng_base = fv.n
          0x8c => u.loc_base = fv.n
          _ => {}
        }
      }
      if !ok {
        break
      }
      if low_x {
        low = addr_x(s, u, low)
      }
      if high_x {
        high = addr_x(s, u, high)
      }
      if high_off {
        high = low + high
      }
      if ab.tag == 0x11 {
        u.low = low
      }
      // the unit's bases as read so far (its own entry comes first)
      v.units[ui] = u
      let cur_fn = fn_at[fn_at.len() - 1]
      let cur_ty = ty_at[ty_at.len() - 1]
      let cur_scope = scope_at[scope_at.len() - 1]
      var kid_fn = cur_fn
      var kid_ty = -1
      var kid_scope = cur_scope
      let cur_inl = inl_at[inl_at.len() - 1]
      var kid_inl = cur_inl
      if ab.tag == 0x1d {
        kid_inl = (name, origin, cur_inl.2 + 1)
      }
      if ab.tag == 0x2e && !name.is_empty() {
        fnames.put(die, fname_v.len())
        fname_v.push(name)
      }
      if ab.tag == 0x1d || ab.tag == 0x0b {
        // an inlined call or a lexical block: its variables' scope
        if rng >= 0 {
          var off = rng
          if rng_x {
            let o = u.rng_base + 4 * rng
            off = if o + 4 <= s.rng_n { u.rng_base + u32(s.rng + o) } else { s.rng_n }
          }
          kid_scope = rnglist(s, u, off)
        } else if high > low {
          kid_scope = [(low, high)]
        }
      }
      match ab.tag {
        0x2e => {
          if high > low {
            kid_fn = v.fns.len()
            v.fns.push(VFn{lo: low + v.bias, hi: high + v.bias, name: name, fb: fb.blk, fb_n: fb.blk_n})
          } else {
            kid_fn = -1
          }
        }
        0x34 | 0x05 => {
          if !name.is_empty() {
            named.put(die, named_n.len())
            named_n.push(name)
            named_t.push(ty)
            decls.put(die, dline)
          }
          if cur_fn >= 0 && (!name.is_empty() || origin >= 0) && (loc.blk_n > 0 || loc_list) {
            var vv = VVar{name: name, ty: ty, param: ab.tag == 0x05, unit: ui, origin: origin, within: cur_scope, inl: cur_inl.0, inl_origin: cur_inl.1, depth: cur_inl.2, decl: dline}
            if loc_list {
              var off = loc.n
              if loc.idx {
                // loclistx: an offset after the unit's loclists base
                let o = u.loc_base + 4 * loc.n
                off = if o + 4 <= s.loc_n { u.loc_base + u32(s.loc + o) } else { -1 }
              }
              vv.list = off
            } else {
              vv.expr = loc.blk
              vv.expr_n = loc.blk_n
            }
            v.fns[cur_fn].vars.push(vv)
          }
        }
        0x24 | 0x13 | 0x17 | 0x16 | 0x0f | 0x04 | 0x01 => {
          // an array type (0x01): its element type as target (a List's
          // object's items, show)
          v.types.put(die, VTy{tag: ab.tag, name: name, size: size, enc: enc, target: ty})
          kid_ty = die
        }
        0x0d => {
          if cur_ty >= 0 {
            if let Some(t0) = v.types.get(cur_ty) {
              var t = t0
              t.m_names.push(name)
              t.m_types.push(ty)
              t.m_offs.push(mloc)
              v.types.put(cur_ty, t)
            }
          }
        }
        0x28 => {
          if cur_ty >= 0 {
            if let Some(t0) = v.types.get(cur_ty) {
              var t = t0
              t.e_names.push(name)
              t.e_vals.push(cval)
              v.types.put(cur_ty, t)
            }
          }
        }
        _ => {}
      }
      if ab.kids {
        fn_at.push(kid_fn)
        ty_at.push(kid_ty)
        scope_at.push(kid_scope)
        inl_at.push(kid_inl)
      }
    }
    p = next
  }
  for (fi, f) in v.fns.indexed() {
    var vs = f.vars
    var changed = false
    for (k, vv) in vs.indexed() {
      if vv.name.is_empty() && vv.origin >= 0 {
        let ni = named.get(vv.origin)
        if ni >= 0 {
          vs[k].name = named_n[ni]
          vs[k].ty = named_t[ni]
          vs[k].decl = if decls.find(vv.origin) >= 0 { decls.get(vv.origin) } else { 0 }
          changed = true
        }
      }
      if vv.inl.is_empty() && vv.inl_origin >= 0 {
        let fi2 = fnames.get(vv.inl_origin)
        if fi2 >= 0 {
          vs[k].inl = fname_v[fi2]
          changed = true
        }
      }
    }
    if changed {
      v.fns[fi].vars = vs
    }
  }
}

/// The function holding pc (-1 for none).
fn fn_at_pc(v: Vars, pc: Int) -> Int {
  for (i, f) in v.fns.indexed() {
    if pc >= f.lo && pc < f.hi {
      return i
    }
  }
  -1
}

/// A frame's registers for the variables' locations: by DWARF number,
/// the 96 words of the unwinder's state at the frame (unwind.xo
/// trace_frames), which of them the frame really has, and its CFA.
pub struct Regs {
  pub at: Int
  pub have: List[Bool]
  pub cfa: Int
}

/// The registers every frame has, of the 96 the unwinder keeps: the
/// callee saved ones, the frame pointer, and sp (x19 to x29, sp, and d8
/// to d15 at 72 to 79 on arm64; rbx, rbp, rsp, r12 to r15 on x86_64,
/// Windows too: Xo's own calls are System V's there, so rsi and rdi are
/// not saved).
pub fn callee_saved() -> List[Bool] {
  var h: List[Bool] = []
  for i in 0..96 {
    let yes = match target.arch {
      TargetArch.Amd64 => i == 3 || i == 6 || i == 7 || (i >= 12 && i <= 15)
      TargetArch.Arm64 | TargetArch.Wasm32 => (i >= 19 && i <= 29) || i == 31 || (i >= 72 && i <= 79)
    }
    h.push(yes)
  }
  h
}

/// The frame's variables at pc, as `name = value` lines (none when no
/// function holds pc).
pub fn frame_locals(v: Vars, pc: Int, rg: Regs) -> List[Str] {
  var out: List[Str] = []
  for (_, _, l, _) in frame_vars(v, pc, rg) {
    out.push(l)
  }
  out
}

/// frame_locals with each line's inlined call: its function's name ("" for
/// the frame's own variables) and how many inlined calls hold it. A line
/// the same as one before it in the same call is left out (LLVM can
/// describe a variable twice, as a parameter and as its inlined copy).
/// The fourth: a local with no value here, its declaration's line (the
/// traceback leaves it out when that is at or after its frame's line:
/// not set yet), else 0.
pub fn frame_vars(v: Vars, pc: Int, rg: Regs) -> List[(Str, Int, Str, Int)] {
  var out: List[(Str, Int, Str, Int)] = []
  if !built() {
    return out
  }
  var seen: List[Str] = []
  let fi = fn_at_pc(v, pc)
  if fi < 0 {
    return out
  }
  let f = v.fns[fi]
  for vv in f.vars {
    if vv.name.is_empty() {
      continue
    }
    var ex = vv.expr
    var exn = vv.expr_n
    if vv.list >= 0 {
      let (a, n) = list_expr(v, vv, pc - v.bias)
      ex = a
      exn = n
    }
    if !in_scope(vv.within, pc - v.bias) {
      // outside its inlined call's range: shown only where its list
      // places it (the arm64 backend's fault stubs, out of line past the
      // body, carry the inlined callee's variables live at the fault,
      // 2026-10-20)
      if vv.list < 0 || exn == 0 {
        continue
      }
    }
    if exn == 0 {
      // an inlined copy without a location here is out of its scope (an
      // LLVM function lists every inlined call's variables)
      if vv.origin < 0 {
        // the Os capability holds no value of the program's (its fields
        // live apart, with no location): named by its type
        let os_cap = (v.types.get(vv.ty) ?? VTy{}).name == "xo.Os"
        add_var(out, seen, vv, "${vv.name} = ${if os_cap { "Os" } else { "<unavailable>" }}", if os_cap { 0 } else { late(vv) })
      }
      continue
    }
    let ws = eval_loc(v, f, vv.unit, ex, exn, rg)
    let shown = show(v, vv.ty, ws, 0)
    add_var(out, seen, vv, "${vv.name} = ${shown}", if shown == "<unavailable>" { late(vv) } else { 0 })
  }
  out
}

fn add_var(var out: List[(Str, Int, Str, Int)], var seen: List[Str], vv: VVar, line: Str, decl: Int) {
  let k = "${vv.inl}\n${vv.depth}\n${line}"
  if !seen.contains(k) {
    seen.push(k)
    out.push((vv.inl, vv.depth, line, decl))
  }
}

/// A local's declaration line, for frame_vars' fourth (0 for a
/// parameter: it has its value from the call).
fn late(vv: VVar) -> Int { if vv.param { 0 } else { vv.decl } }

/// Whether pc (unplaced) is in the ranges (none: everywhere).
fn in_scope(rs: List[(Int, Int)], pc: Int) -> Bool {
  if rs.is_empty() {
    return true
  }
  for (a, b) in rs {
    if pc >= a && pc < b {
      return true
    }
  }
  false
}

/// The expression of the location list entry of variable vv that holds
/// pc (unplaced): its address and count (0 for none).
fn list_expr(v: Vars, vv: VVar, pc: Int) -> (Int, Int) {
  let s = v.s
  let u = v.units[vv.unit]
  if vv.list < 0 || vv.list >= s.loc_n {
    return (0, 0)
  }
  var r = Rd{p: s.loc + vv.list, end: s.loc + s.loc_n}
  var base = u.low
  while r.p < r.end {
    let k = r.byte()
    var lo = 0
    var hi = 0
    match k {
      0 => break
      1 => {
        base = addr_x(s, u, r.uleb())
        continue
      }
      2 => {
        lo = addr_x(s, u, r.uleb())
        hi = addr_x(s, u, r.uleb())
      }
      3 => {
        lo = addr_x(s, u, r.uleb())
        hi = lo + r.uleb()
      }
      4 => {
        lo = base + r.uleb()
        hi = base + r.uleb()
      }
      5 => {
        lo = 0
        hi = 9223372036854775807
      }
      6 => {
        base = ld(r.p, 0)
        r.p += 8
        continue
      }
      7 => {
        lo = ld(r.p, 0)
        hi = ld(r.p, 8)
        r.p += 16
      }
      8 => {
        lo = ld(r.p, 0)
        r.p += 8
        hi = lo + r.uleb()
      }
      _ => break
    }
    let n = r.uleb()
    let a = r.p
    r.p += n
    if pc >= lo && pc < hi {
      return (a, n)
    }
  }
  (0, 0)
}

/// A word of a value: whether known, and its bits.
struct W {
  ok: Bool
  v: Int
}

/// The words of a location expression: each piece's (a register's
/// value, or the word at a computed address, or a stack value); an
/// expression without pieces is one value's words read from its address.
fn eval_loc(v: Vars, f: VFn, ui: Int, a: Int, n: Int, rg: Regs) -> List[W] {
  var out: List[W] = []
  var r = Rd{p: a, end: a + n}
  var stack: List[Int] = []
  var reg = -1
  var bad = false
  var value = false
  while r.p < r.end {
    let op = r.byte()
    if op >= 0x50 && op <= 0x6f {
      reg = op - 0x50
    } else if op == 0x90 {
      reg = r.uleb()
    } else if op >= 0x70 && op <= 0x8f {
      let k = op - 0x70
      let off = r.sleb()
      if k < 96 && rg.have[k] {
        stack.push(rt.mem_load(rg.at, 8 * k, 8) + off)
      } else {
        bad = true
      }
    } else if op == 0x92 {
      let k = r.uleb()
      let off = r.sleb()
      if k < 96 && rg.have[k] {
        stack.push(rt.mem_load(rg.at, 8 * k, 8) + off)
      } else {
        bad = true
      }
    } else if op == 0x91 {
      let off = r.sleb()
      let fbv = frame_base(v, f, ui, rg)
      if fbv.ok {
        stack.push(fbv.v + off)
      } else {
        bad = true
      }
    } else if op == 0x03 {
      stack.push(ld(r.p, 0) + v.bias)
      r.p += 8
    } else if op == 0xa1 {
      stack.push(addr_x(v.s, v.units[ui], r.uleb()) + v.bias)
    } else if op == 0x9c {
      stack.push(rg.cfa)
    } else if op >= 0x30 && op <= 0x4f {
      stack.push(op - 0x30)
    } else if op == 0x10 {
      stack.push(r.uleb())
    } else if op == 0x11 {
      stack.push(r.sleb())
    } else if op == 0x23 {
      let k = r.uleb()
      if !stack.is_empty() {
        let t = stack.pop() ?? 0
        stack.push(t + k)
      }
    } else if op == 0x22 {
      if stack.len() >= 2 {
        let b = stack.pop() ?? 0
        let c = stack.pop() ?? 0
        stack.push(b + c)
      }
    } else if op == 0x9f {
      value = true
    } else if op == 0x93 {
      let size = r.uleb()
      out.push(piece(rg, reg, stack, bad, value))
      // a piece of more than a word: the words after it unknown
      var extra = (size + 7) / 8 - 1
      while extra > 0 {
        out.push(W{ok: false, v: 0})
        extra -= 1
      }
      reg = -1
      stack = []
      bad = false
      value = false
    } else {
      // an operation this reader does not know: the rest unknown
      return out + [W{ok: false, v: 0}]
    }
  }
  if out.is_empty() {
    if reg >= 0 || value || bad {
      out.push(piece(rg, reg, stack, bad, value))
    } else if !stack.is_empty() {
      // the value at an address: its words are read where it is shown
      out.push(W{ok: true, v: stack[stack.len() - 1]})
      return [W{ok: false, v: -1}] + out
    }
  }
  out
}

/// One piece's word: a register's value, a stack value, or the word at
/// the address on the stack.
fn piece(rg: Regs, reg: Int, stack: List[Int], bad: Bool, value: Bool) -> W {
  if bad {
    return W{ok: false, v: 0}
  }
  if reg >= 0 {
    if reg < 96 && rg.have[reg] {
      return W{ok: true, v: rt.mem_load(rg.at, 8 * reg, 8)}
    }
    return W{ok: false, v: 0}
  }
  if stack.is_empty() {
    return W{ok: false, v: 0}
  }
  let top = stack[stack.len() - 1]
  if value {
    return W{ok: true, v: top}
  }
  read_word(top)
}

/// The function's frame base: its DW_AT_frame_base, else the frame
/// pointer (x29, rbp).
fn frame_base(v: Vars, f: VFn, ui: Int, rg: Regs) -> W {
  if f.fb_n > 0 {
    let ws = eval_loc(v, f, ui, f.fb, f.fb_n, rg)
    if ws.len() == 1 {
      return ws[0]
    }
    if ws.len() == 2 && !ws[0].ok && ws[0].v == -1 {
      return ws[1]
    }
    return W{ok: false, v: 0}
  }
  let k = match target.arch {
    TargetArch.Amd64 => 6
    TargetArch.Arm64 | TargetArch.Wasm32 => 29
  }
  W{ok: rg.have[k], v: rt.mem_load(rg.at, 8 * k, 8)}
}

/// The word at address a, when it can be read (a bad address does not
/// fault: probe).
fn read_word(a: Int) -> W {
  if !probe(a, 8) {
    return W{ok: false, v: 0}
  }
  W{ok: true, v: rt.mem_load(a, 0, 8)}
}

/// The words of a value of n words at address a (unknown where they
/// cannot be read).
fn read_words(a: Int, n: Int) -> List[W] {
  var out: List[W] = []
  for i in 0..n {
    out.push(read_word(a + 8 * i))
  }
  out
}

/// Whether the n bytes at a can be read: written to a pipe, which the
/// kernel refuses with EFAULT for a bad address instead of faulting
/// (then read back out of the pipe); on Windows, VirtualQuery's regions.
fn probe(a: Int, n: Int) -> Bool {
  if a <= 4096 || a < 0 {
    return false
  }
  if target.os == TargetOs.Windows {
    return win_readable(a, n)
  }
  let fds = rt.heap_large(16)
  var ok = false
  match target.os {
    TargetOs.Linux => {
      // pipe2(fds, O_CLOEXEC)
      let nr = match target.arch {
        TargetArch.Amd64 => 293
        TargetArch.Arm64 | TargetArch.Wasm32 => 59
      }
      if rt.sys6(nr, fds, 524288, 0, 0, 0, 0) == 0 {
        let rd = rt.mem_load(fds, 0, 4)
        let wr = rt.mem_load(fds, 4, 4)
        ok = linux.write_at(wr, a, n) == n
        if ok {
          let _r = linux.read_at(rd, fds + 8, 8)
        }
        let _c1 = linux.close(rd)
        let _c2 = linux.close(wr)
      }
    }
    TargetOs.Darwin => {
      if Int(sys_darwin.pipe(fds)) == 0 {
        let rd = rt.mem_load(fds, 0, 4)
        let wr = rt.mem_load(fds, 4, 4)
        ok = sys_darwin.write(wr, a, n) == n
        if ok {
          let _r = sys_darwin.read(rd, fds + 8, 8)
        }
        let _c1 = sys_darwin.close(rd)
        let _c2 = sys_darwin.close(wr)
      }
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
  rt.heap_release(fds - 8)
  ok
}

/// Whether the n bytes at a lie in committed, readable regions
/// (VirtualQuery's MEMORY_BASIC_INFORMATION: base 0, size 24, state 32,
/// protect 36): MEM_COMMIT, a readable protection (PAGE_READONLY,
/// READWRITE, WRITECOPY and their EXECUTE_ forms), not PAGE_GUARD.
fn win_readable(a: Int, n: Int) -> Bool {
  let mbi = rt.heap_large(48)
  var at = a
  var ok = true
  while ok && at < a + n {
    if sys_windows.VirtualQuery(at, mbi, 48) == 0 {
      ok = false
    } else {
      let state = rt.mem_load(mbi, 32, 4)
      let prot = rt.mem_load(mbi, 36, 4)
      // MEM_COMMIT 0x1000; readable 0xEE; PAGE_GUARD 0x100
      ok = state == 4096 && (prot & 238) != 0 && (prot & 256) == 0
      at = rt.mem_load(mbi, 0, 8) + rt.mem_load(mbi, 24, 8)
    }
  }
  rt.heap_release(mbi - 8)
  ok
}

/// The text of a value of type ty (an offset) from its words ws (a value
/// at an address: [unknown -1, its address]).
fn show(v: Vars, ty0: Int, ws0: List[W], depth: Int) -> Str {
  var ty = ty0
  var ws = ws0
  let t0 = v.types.get(ty) ?? VTy{}
  // typedefs: the name read is the typedef's (List[Int]), the shape its target's
  var shown = t0.name
  var t = t0
  var guard = 0
  while t.tag == 0x16 && guard < 8 {
    ty = t.target
    t = v.types.get(ty) ?? VTy{}
    guard += 1
  }
  let words = if t.size > 0 { (t.size + 7) / 8 } else { 1 }
  if ws.len() == 2 && !ws[0].ok && ws[0].v == -1 {
    // the value at an address
    ws = if ws[1].ok { read_words(ws[1].v, words.min(32)) } else { [W{ok: false, v: 0}] }
  }
  if ws.is_empty() || !ws[0].ok {
    return "<unavailable>"
  }
  let w0 = ws[0].v
  match t.tag {
    0x24 => {
      match t.enc {
        0x02 => if w0 & 255 != 0 { "true" } else { "false" }
        0x04 => "${rt.float_from_bits(w0)}"
        _ => "${w0}"
      }
    }
    0x0f => {
      // a list or box: its object's length (layout 3) for a list
      if shown.starts_with("List[") {
        let n = read_word(w0 + rt.layout(3))
        if !n.ok {
          return "${shown} <bad address>"
        }
        // a list of words: its first elements
        let el = shown[5..shown.len() - 1]
        if (el == "Int" || el == "Float" || el == "Bool") && n.v >= 0 {
          let k = n.v.min(8)
          let items = read_words(w0 + rt.layout(2), k)
          var parts: List[Str] = []
          for it in items {
            parts.push(if !it.ok { "?" } else if el == "Float" { "${rt.float_from_bits(it.v)}" } else if el == "Bool" { "${it.v != 0}" } else { "${it.v}" })
          }
          let more = if n.v > k { ", ... (${n.v} items)" } else { "" }
          return "[${parts.join(", ")}${more}]"
        }
        // any other element of whole words (Str, a struct, a List): its
        // type from the object's items array, the first few shown as
        // the spec promises (Intel field report, round 2, on 0.26.0:
        // List[Str] showed only its length)
        let obj = v.types.get(t.target) ?? VTy{}
        let ii = obj.m_names.index_of("items") ?? -1
        if ii >= 0 && n.v >= 0 && depth < 2 {
          let arr = v.types.get(obj.m_types[ii]) ?? VTy{}
          let et = v.types.get(arr.target) ?? VTy{}
          if arr.tag == 0x01 && et.size > 0 && et.size % 8 == 0 {
            let ew = et.size / 8
            let k = n.v.min(if ew > 1 { 4 } else { 8 })
            let items = read_words(w0 + rt.layout(2), k * ew)
            var parts: List[Str] = []
            for i in 0..k {
              var sub: List[W] = []
              for j in i * ew..(i + 1) * ew {
                sub.push(if j < items.len() { items[j] } else { W{ok: false, v: 0} })
              }
              parts.push(show(v, arr.target, sub, depth + 1))
            }
            let more = if n.v > k { ", ... (${n.v} items)" } else { "" }
            return "[${parts.join(", ")}${more}]"
          }
        }
        "${shown} (len ${n.v})"
      } else {
        "${if shown.is_empty() { "pointer" } else { shown }} 0x${hex(w0)}"
      }
    }
    0x04 => {
      for (i, e) in t.e_vals.indexed() {
        if e == w0 {
          return t.e_names[i]
        }
      }
      "${w0}"
    }
    0x13 => {
      if t.name == "Str" {
        // its text needs its length too
        return if ws.len() >= 2 && ws[1].ok { str_text(w0, ws[1].v) } else { "<unavailable>" }
      }
      // an enum: its tag's enumerator, the variant's fields when shown
      if t.m_names.len() >= 1 && t.m_names[0] == "tag" {
        let tag = show(v, t.m_types[0], [ws[0]], depth + 1)
        // the variant's fields: the payload union's member of its name
        if t.m_names.len() >= 2 && depth < 2 {
          let u = v.types.get(t.m_types[1]) ?? VTy{}
          for (i, vn) in u.m_names.indexed() {
            if vn == tag {
              var rest: List[W] = []
              for k in 1..ws.len() {
                rest.push(ws[k])
              }
              let body = show(v, u.m_types[i], rest, depth + 1)
              // "Mode.Slow { level: 7 }" as "Mode.Slow(level: 7)"
              let open = body.find(" { ") ?? -1
              if open >= 0 && body.ends_with(" }") {
                return "${shown}.${tag}(${body[open + 3..body.len() - 2]})"
              }
            }
          }
        }
        return "${shown}.${tag}"
      }
      if depth >= 2 {
        return "${shown} {...}"
      }
      var parts: List[Str] = []
      for (i, mn) in t.m_names.indexed() {
        let at = t.m_offs[i] / 8
        if at >= ws.len() {
          parts.push("${mn}: <unavailable>")
          continue
        }
        let mt = v.types.get(t.m_types[i]) ?? VTy{}
        let mw = if mt.size > 8 { (mt.size + 7) / 8 } else { 1 }
        var sub: List[W] = []
        for k in at..(at + mw).min(ws.len()) {
          sub.push(ws[k])
        }
        parts.push("${mn}: ${show(v, t.m_types[i], sub, depth + 1)}")
      }
      "${shown} { ${parts.join(", ")} }"
    }
    _ => "${shown} 0x${hex(w0)}"
  }
}

/// A Str's text from its object and length: quoted, at most 80 bytes,
/// non-printing bytes escaped.
fn str_text(obj: Int, n: Int) -> Str {
  if n == 0 {
    return "\"\""
  }
  if n < 0 || obj == 0 {
    return "<bad Str>"
  }
  let k = n.min(80)
  let d = obj + rt.layout(0)
  if !probe(d, k) {
    return "<bad address>"
  }
  var b = StrBuilder.new()
  b.write("\"")
  for i in 0..k {
    let c = rt.mem_load(d, i, 1)
    if c == 34 || c == 92 {
      b.write("\\${Rune(c)}")
    } else if c >= 32 && c < 127 {
      b.write("${Rune(c)}")
    } else {
      let h = hex(c)
      b.write("\\x${h[14..16]}")
    }
  }
  b.write("\"")
  if n > k {
    b.write("... (${n} bytes)")
  }
  b.freeze()
}

/// x in hexadecimal (16 digits).
fn hex(x: Int) -> Str {
  var b = StrBuilder.new()
  for i in 0..16 {
    let d = x.shr_logical(60 - 4 * i) & 15
    b.write("${Rune(if d < 10 { 48 + d } else { 87 + d })}")
  }
  b.freeze()
}
