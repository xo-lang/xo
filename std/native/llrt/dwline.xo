// The program's DWARF line tables (decision 0239), read back for the
// profiler (prof.xo) and fault reports: Linux, the .debug_line of the
// program's file (/proc/self/exe); macOS, the __DWARF of PROG.dSYM next
// to the executable when its LC_UUID is the running image's. Version 4
// and 5 line programs (the arm64 emitter's and LLVM's), every opcode,
// rows sorted by address, placed by the load bias. Read when asked, not
// at start and never in a signal handler; files are read by plain
// system calls, not sysio (a test binary's sysio is the test world's,
// which a fault's report cannot wait on: the traceback hung).
use native/llrt/linux
use native/llrt/raw
use native/rt
use native/sys_darwin

/// The rows: address, file (an index of files, -1 at a sequence's end),
/// and line, sorted by address.
pub struct Lines {
  pub addrs: List[Int] = []
  pub files: List[Int] = []
  pub lines: List[Int] = []
  pub names: List[Str] = []
  /// the inlined calls (.debug_info's DW_TAG_inlined_subroutine): a
  /// range each (an entry with several ranges has several), its nesting
  /// depth (1: in the function itself), the callee's name, and the call's
  /// file (an index of names) and line
  pub inl_lo: List[Int] = []
  pub inl_hi: List[Int] = []
  pub inl_depth: List[Int] = []
  pub inl_name: List[Str] = []
  pub inl_file: List[Int] = []
  pub inl_line: List[Int] = []
  /// each line program's files (by its offset in .debug_line): names
  /// indexes by the program's file numbers
  ufiles: Map[Int, List[Int]] = {}
}

/// The sections a line program reads: .debug_line, and the string
/// sections v5 file names refer to (address and size; 0 for none).
struct Sects {
  /// the file the addresses point into, held while they are read: a
  /// Bytes is released after its last use, and the readers' own
  /// allocations reused its memory (gotchas/raw-address-outlives-bytes.md)
  data: Bytes = b""
  line: Int = 0
  line_n: Int = 0
  lstr: Int = 0
  lstr_n: Int = 0
  str: Int = 0
  str_n: Int = 0
  /// the inlined calls' sections (.debug_info and what it refers to)
  info: Int = 0
  info_n: Int = 0
  abbrev: Int = 0
  abbrev_n: Int = 0
  stroff: Int = 0
  stroff_n: Int = 0
  addr: Int = 0
  addr_n: Int = 0
  rng: Int = 0
  rng_n: Int = 0
}

/// Notes debug section name (without its .debug_ or __debug_ prefix; a
/// Mach-O name is cut at 16 bytes) at address a, n bytes.
fn (var s: Sects) set(name: Str, a: Int, n: Int) {
  match name {
    "line" => {
      s.line = a
      s.line_n = n
    }
    "line_str" => {
      s.lstr = a
      s.lstr_n = n
    }
    "str" => {
      s.str = a
      s.str_n = n
    }
    "info" => {
      s.info = a
      s.info_n = n
    }
    "abbrev" => {
      s.abbrev = a
      s.abbrev_n = n
    }
    "str_offsets" | "str_offs" => {
      s.stroff = a
      s.stroff_n = n
    }
    "addr" => {
      s.addr = a
      s.addr_n = n
    }
    "rnglists" => {
      s.rng = a
      s.rng_n = n
    }
    _ => {}
  }
}

fn ld(p: Int, o: Int) -> Int { rt.mem_load(p, o, 8) }

fn u8(p: Int) -> Int { rt.mem_load(p, 0, 1) }

fn u16(p: Int) -> Int { rt.mem_load(p, 0, 2) }

fn u32(p: Int) -> Int { rt.mem_load(p, 0, 4) }

/// The program's line table within [lo, hi) (its text), or none.
pub fn load(lo: Int, hi: Int) -> Lines {
  var out = Lines{}
  match target.os {
    TargetOs.Linux => load_elf(lo, hi, out)
    TargetOs.Darwin => load_dsym(lo, hi, out)
    TargetOs.Windows | TargetOs.Wasi => {}
  }
  out
}

/// The file and line of pc ("" and 0 when no row holds it).
pub fn find(t: Lines, pc: Int) -> (Str, Int) {
  var a = 0
  var b = t.addrs.len()
  while a < b {
    let m = (a + b) / 2
    if t.addrs[m] <= pc {
      a = m + 1
    } else {
      b = m
    }
  }
  let i = a - 1
  if i < 0 || t.files[i] < 0 || t.lines[i] <= 0 {
    return ("", 0)
  }
  (t.names[t.files[i]], t.lines[i])
}

fn base(p: Str) -> Str {
  let parts = p.split("/")
  parts[parts.len() - 1]
}

// ---------------------------------------------------------------------------
// Loading

/// Linux: the sections of /proc/self/exe by name, placed by the load
/// bias (AT_PHDR against PT_PHDR).
fn load_elf(lo: Int, hi: Int, var out: Lines) {
  let data = read_raw("/proc/self/exe")
  if data.len() < 64 {
    return
  }
  let f = raw.bytes_addr(data)
  let ph = linux.auxval(linux.AT_PHDR)
  let phn = linux.auxval(linux.AT_PHNUM)
  var bias = 0
  for i in 0..phn {
    let p = ph + 56 * i
    if rt.mem_load(p, 0, 4) == 6 {
      bias = ph - ld(p, 16)
    }
  }
  // Elf64_Ehdr: e_shoff 40, e_shnum 60, e_shstrndx 62
  let shoff = ld(f, 40)
  let shn = rt.mem_load(f, 60, 2)
  let shx = rt.mem_load(f, 62, 2)
  if shoff <= 0 || shoff + 64 * shn > data.len() || shx >= shn {
    return
  }
  let strs = ld(f + shoff + 64 * shx, 24)
  var s = Sects{data: data}
  for i in 0..shn {
    // Elf64_Shdr: sh_name 0, sh_offset 24, sh_size 32
    let sh = f + shoff + 64 * i
    let off = ld(sh, 24)
    let size = ld(sh, 32)
    if off + size > data.len() {
      continue
    }
    let name = cstr(f + strs + u32(sh), 64)
    if name.starts_with(".debug_") {
      s.set(name[7..name.len()], f + off, size)
    }
  }
  if s.line_n > 0 {
    parse(s, bias, lo, hi, out)
    parse_info(s, bias, out)
  }
}

/// macOS: PROG.dSYM/Contents/Resources/DWARF/PROG beside the executable
/// (dladdr of the image's header names it), when its LC_UUID is the
/// image's; addresses moved by the image's slide.
fn load_dsym(lo: Int, hi: Int, var out: Lines) {
  let mh = sys_darwin._dyld_get_image_header(0)
  if mh == 0 || u32(mh) != 4277009103 {
    return
  }
  let (uuid, slide) = image_uuid(mh)
  if uuid.is_empty() {
    return
  }
  // Dl_info: dli_fname 0
  let info = rt.heap_large(32)
  rt.mem_set(info, 0, 32)
  var exe = ""
  if Int(sys_darwin.dladdr(mh, info)) != 0 && ld(info, 0) != 0 {
    exe = cstr(ld(info, 0), 4096)
  }
  rt.heap_release(info - 8)
  if exe.is_empty() {
    return
  }
  let data = read_raw("${exe}.dSYM/Contents/Resources/DWARF/${base(exe)}")
  if data.len() < 32 {
    return
  }
  let f = raw.bytes_addr(data)
  if u32(f) != 4277009103 {
    return
  }
  let ncmds = u32(f + 16)
  var lc = f + 32
  var same = false
  var s = Sects{data: data}
  for _ in 0..ncmds {
    if lc + 8 > f + data.len() {
      return
    }
    let cmd = u32(lc)
    if cmd == 27 {
      // LC_UUID
      same = hex16(lc + 8) == uuid
    } else if cmd == 25 {
      // LC_SEGMENT_64: nsects at 64, section_64 entries (80 bytes) at 72
      let nsects = u32(lc + 64)
      for k in 0..nsects {
        let sc = lc + 72 + 80 * k
        let seg = cstr(sc + 16, 16)
        if seg != "__DWARF" {
          continue
        }
        let name = cstr(sc, 16)
        let size = ld(sc, 40)
        let off = u32(sc + 48)
        if off + size > data.len() {
          continue
        }
        if name.starts_with("__debug_") {
          s.set(name[8..name.len()], f + off, size)
        }
      }
    }
    lc += u32(lc + 4)
  }
  if same && s.line_n > 0 {
    parse(s, slide, lo, hi, out)
    parse_info(s, slide, out)
  }
}

/// The bytes of the file at path by plain system calls (empty when it
/// cannot be read).
fn read_raw(path: Str) -> Bytes {
  let buf = rt.heap_large(65536)
  var b = BytesBuilder.new()
  var fd = -1
  match target.os {
    TargetOs.Darwin => fd = Int(sys_darwin.open("${path}\x00".bytes(), 0, 0))
    TargetOs.Linux => fd = linux.open(path, 524288, 0)
    TargetOs.Windows | TargetOs.Wasi => {}
  }
  if fd >= 0 {
    while true {
      var r = 0
      match target.os {
        TargetOs.Darwin => r = sys_darwin.read(fd, buf, 65536)
        TargetOs.Linux => {
          r = linux.read_at(fd, buf, 65536)
          if r == -4 {
            continue
          }
        }
        TargetOs.Windows | TargetOs.Wasi => {}
      }
      if r <= 0 {
        break
      }
      for i in 0..r {
        b.write_byte(UInt8(rt.mem_load(buf, i, 1)))
      }
    }
    match target.os {
      TargetOs.Darwin => {
        let _c = sys_darwin.close(fd)
      }
      TargetOs.Linux => {
        let _c = linux.close(fd)
      }
      TargetOs.Windows | TargetOs.Wasi => {}
    }
  }
  rt.heap_release(buf - 8)
  b.freeze()
}

/// The image's LC_UUID (hex) and its slide (its address against its
/// __TEXT's vmaddr).
fn image_uuid(mh: Int) -> (Str, Int) {
  let ncmds = u32(mh + 16)
  var lc = mh + 32
  var uuid = ""
  var slide = 0
  for _ in 0..ncmds {
    let cmd = u32(lc)
    if cmd == 27 {
      uuid = hex16(lc + 8)
    } else if cmd == 25 && cstr(lc + 8, 16) == "__TEXT" {
      slide = mh - ld(lc, 24)
    }
    lc += u32(lc + 4)
  }
  (uuid, slide)
}

fn hex16(p: Int) -> Str {
  var b = StrBuilder.new()
  for i in 0..16 {
    let v = rt.mem_load(p, i, 1)
    b.write("0123456789abcdef"[v / 16..v / 16 + 1])
    b.write("0123456789abcdef"[v % 16..v % 16 + 1])
  }
  b.freeze()
}

/// The NUL terminated string at p, at most n bytes.
fn cstr(p: Int, n: Int) -> Str {
  var k = 0
  while k < n && rt.mem_load(p, k, 1) != 0 {
    k += 1
  }
  var b = BytesBuilder.with_capacity(k)
  for i in 0..k {
    b.write_byte(UInt8(rt.mem_load(p, i, 1)))
  }
  b.freeze().to_str() ?? ""
}

// ---------------------------------------------------------------------------
// Line programs

/// A reader over [p, end).
struct Rd {
  p: Int
  end: Int
}

fn (var r: Rd) byte() -> Int {
  if r.p >= r.end {
    return 0
  }
  let v = u8(r.p)
  r.p += 1
  v
}

fn (var r: Rd) uleb() -> Int {
  var v = 0
  var shift = 0
  while r.p < r.end {
    let b = u8(r.p)
    r.p += 1
    if shift < 63 {
      v = v | ((b & 127) << shift)
    }
    shift += 7
    if b < 128 {
      break
    }
  }
  v
}

fn (var r: Rd) sleb() -> Int {
  var v = 0
  var shift = 0
  var b = 0
  while r.p < r.end {
    b = u8(r.p)
    r.p += 1
    if shift < 63 {
      v = v | ((b & 127) << shift)
    }
    shift += 7
    if b < 128 {
      break
    }
  }
  if shift < 64 && (b & 64) != 0 {
    v = v | (-1 << shift)
  }
  v
}

fn (var r: Rd) cstr() -> Str {
  var k = 0
  while r.p + k < r.end && u8(r.p + k) != 0 {
    k += 1
  }
  let s = cstr(r.p, k)
  r.p += k + 1
  s
}

/// A v5 entry's field of form fm: a string (for DW_LNCT_path) or a
/// number (the directory index); unknown forms end the parse (ok false).
fn (var r: Rd) form(fm: Int, s: Sects) -> (Str, Int, Bool) {
  match fm {
    0x08 => (r.cstr(), 0, true)
    0x1f => {
      let o = u32(r.p)
      r.p += 4
      (if o < s.lstr_n { cstr(s.lstr + o, s.lstr_n - o) } else { "" }, 0, true)
    }
    0x0e => {
      let o = u32(r.p)
      r.p += 4
      (if o < s.str_n { cstr(s.str + o, s.str_n - o) } else { "" }, 0, true)
    }
    0x0f => ("", r.uleb(), true)
    0x0b => ("", r.byte(), true)
    0x05 => {
      let v = u16(r.p)
      r.p += 2
      ("", v, true)
    }
    0x06 => {
      let v = u32(r.p)
      r.p += 4
      ("", v, true)
    }
    0x07 => {
      let v = ld(r.p, 0)
      r.p += 8
      ("", v, true)
    }
    0x1e => {
      r.p += 16
      ("", 0, true)
    }
    0x09 => {
      let n = r.uleb()
      r.p += n
      ("", 0, true)
    }
    _ => ("", 0, false)
  }
}

/// p joined to dir (p when absolute or dir is empty).
fn join(dir: Str, p: Str) -> Str {
  if p.starts_with("/") || dir.is_empty() {
    return p
  }
  "${dir}/${p}"
}

/// Every unit's line program into out (rows with addresses in [lo, hi)
/// after bias), then the rows sorted.
fn parse(s: Sects, bias: Int, lo: Int, hi: Int, var out: Lines) {
  var at: Map[Str, Int] = {}
  var ra: List[Int] = []
  var rf: List[Int] = []
  var rl: List[Int] = []
  var u = s.line
  let end = s.line + s.line_n
  while u + 12 <= end {
    let len = u32(u)
    if len == 0xffffffff || len == 0 {
      break // 64 bit DWARF is not made by Xo's backends
    }
    let next = u + 4 + len
    if next > end {
      break
    }
    var r = Rd{p: u + 4, end: next}
    let ver = u16(r.p)
    r.p += 2
    if ver < 2 || ver > 5 {
      u = next
      continue
    }
    if ver >= 5 {
      r.p += 2 // address_size, segment_selector_size
    }
    let hlen = u32(r.p)
    r.p += 4
    let prog = r.p + hlen
    let min_inst = r.byte()
    if ver >= 4 {
      let _m = r.byte()
    }
    let _stmt = r.byte()
    var line_base = r.byte()
    if line_base >= 128 {
      line_base -= 256
    }
    let line_range = r.byte()
    let op_base = r.byte()
    var lens: List[Int] = [0]
    for _ in 1..op_base {
      lens.push(r.byte())
    }
    // the files of this unit: global indexes, by the program's numbering
    var dirs: List[Str] = []
    var fmap: List[Int] = []
    var ok = true
    if ver >= 5 {
      let dfc = r.byte()
      var dfmt: List[(Int, Int)] = []
      for _ in 0..dfc {
        let c = r.uleb()
        dfmt.push((c, r.uleb()))
      }
      let nd = r.uleb()
      for _ in 0..nd {
        var path = ""
        for (c, fm) in dfmt {
          let (sv, _, fok) = r.form(fm, s)
          ok = ok && fok
          if c == 1 {
            path = sv
          }
        }
        dirs.push(path)
      }
      let ffc = r.byte()
      var ffmt: List[(Int, Int)] = []
      for _ in 0..ffc {
        let c = r.uleb()
        ffmt.push((c, r.uleb()))
      }
      let nf = r.uleb()
      for _ in 0..nf {
        var path = ""
        var di = 0
        for (c, fm) in ffmt {
          let (sv, nv, fok) = r.form(fm, s)
          ok = ok && fok
          if c == 1 {
            path = sv
          } else if c == 2 {
            di = nv
          }
        }
        let full = join(if di < dirs.len() { dirs[di] } else { "" }, path)
        fmap.push(intern(full, at, out))
      }
    } else {
      dirs.push("")
      while r.p < prog {
        let d = r.cstr()
        if d.is_empty() {
          break
        }
        dirs.push(d)
      }
      // v2 to v4 number files from 1
      fmap.push(-1)
      while r.p < prog {
        let name = r.cstr()
        if name.is_empty() {
          break
        }
        let di = r.uleb()
        let _t = r.uleb()
        let _l = r.uleb()
        fmap.push(intern(join(if di < dirs.len() { dirs[di] } else { "" }, name), at, out))
      }
    }
    out.ufiles[u - s.line] = fmap
    if !ok || line_range == 0 {
      u = next
      continue
    }
    // the program
    r.p = prog
    var addr = 0
    var file = 1
    var line = 1
    while r.p < next {
      let op = r.byte()
      var emit = false
      if op >= op_base {
        let adj = op - op_base
        addr += (adj / line_range) * min_inst
        line += line_base + adj % line_range
        emit = true
      } else if op == 0 {
        let n = r.uleb()
        let at0 = r.p
        let sub = r.byte()
        if sub == 1 {
          // end_sequence: a row that ends the table there
          let a = addr + bias
          if a >= lo && a <= hi {
            ra.push(a)
            rf.push(-1)
            rl.push(0)
          }
          addr = 0
          file = 1
          line = 1
        } else if sub == 2 {
          addr = ld(r.p, 0)
        }
        r.p = at0 + n
      } else if op == 1 {
        emit = true
      } else if op == 2 {
        addr += r.uleb() * min_inst
      } else if op == 3 {
        line += r.sleb()
      } else if op == 4 {
        file = r.uleb()
      } else if op == 5 {
        let _c = r.uleb()
      } else if op == 8 {
        addr += ((255 - op_base) / line_range) * min_inst
      } else if op == 9 {
        addr += u16(r.p)
        r.p += 2
      } else if op == 12 {
        let _i = r.uleb()
      } else if op == 6 || op == 7 || op == 10 || op == 11 {
        // negate_stmt, basic_block, prologue_end, epilogue_begin
      } else {
        // an opcode of a later version: skip its operands
        for _ in 0..(if op < lens.len() { lens[op] } else { 0 }) {
          let _x = r.uleb()
        }
      }
      if emit {
        let a = addr + bias
        if a >= lo && a < hi && file >= 0 && file < fmap.len() && fmap[file] >= 0 {
          ra.push(a)
          rf.push(fmap[file])
          rl.push(line + 0)
        }
      }
    }
    u = next
  }
  // sorted by address; at one address, a sequence's end before a row
  // (key: offset << 21 | row bit << 20 | index)
  var keys: List[Int] = []
  for i in 0..ra.len() {
    if i < 1048576 {
      let rowbit = if rf[i] < 0 { 0 } else { 1 }
      keys.push(rt.int_wrap(3, ra[i] - lo, 21) | (rowbit << 20) | i)
    }
  }
  keys = keys.sort()
  for k in keys {
    let i = k & 1048575
    out.addrs.push(ra[i])
    out.files.push(rf[i])
    out.lines.push(rl[i])
  }
}

/// The index of file name in out.names, added once.
fn intern(name: Str, var at: Map[Str, Int], var out: Lines) -> Int {
  if let Some(k) = at.get(name) {
    return k
  }
  out.names.push(name)
  at[name] = out.names.len() - 1
  out.names.len() - 1
}

// ---------------------------------------------------------------------------
// Inlined calls (.debug_info)

/// One attribute of an abbreviation: its name, form, and an implicit
/// constant (DW_FORM_implicit_const).
struct AbAttr {
  at: Int
  form: Int
  imp: Int = 0
}

/// An abbreviation: tag, whether its entries have children, attributes.
struct Abbrev {
  tag: Int
  kids: Bool
  attrs: List[AbAttr]
}

/// The abbreviation table at offset off of .debug_abbrev, by code.
fn abbrevs(s: Sects, off: Int) -> Map[Int, Abbrev] {
  var out: Map[Int, Abbrev] = {}
  if off >= s.abbrev_n {
    return out
  }
  var r = Rd{p: s.abbrev + off, end: s.abbrev + s.abbrev_n}
  while r.p < r.end {
    let code = r.uleb()
    if code == 0 {
      break
    }
    let tag = r.uleb()
    let kids = r.byte() != 0
    var attrs: List[AbAttr] = []
    while r.p < r.end {
      let at = r.uleb()
      let form = r.uleb()
      if at == 0 && form == 0 {
        break
      }
      var imp = 0
      if form == 0x21 {
        imp = r.sleb()
      }
      attrs.push(AbAttr{at: at, form: form, imp: imp})
    }
    out[code] = Abbrev{tag: tag, kids: kids, attrs: attrs}
  }
  out
}

/// A unit's bases (DWARF 5: str_offsets_base, addr_base,
/// rnglists_base), address size, and the low_pc rnglists are based on.
struct Unit {
  start: Int
  ver: Int
  asize: Int = 8
  str_base: Int = 8
  addr_base: Int = 8
  rng_base: Int = 12
  low: Int = 0
}

/// A field's value: a number (or address, offset, index), or a string
/// (str_ok), or neither (a block, an expression).
struct FVal {
  n: Int = 0
  str: Str = ""
  str_ok: Bool = false
  /// the form named an index (strx, addrx, rnglistx) to resolve against
  /// the unit's bases
  idx: Bool = false
}

/// Reads a field of form fm (ok false for a form not known: the unit is
/// left).
fn read_form(var r: Rd, fm: Int, s: Sects, u: Unit, imp: Int) -> (FVal, Bool) {
  match fm {
    0x01 => {
      let v = if u.asize == 4 { u32(r.p) } else { ld(r.p, 0) }
      r.p += u.asize
      (FVal{n: v}, true)
    }
    0x0b | 0x11 => (FVal{n: r.byte()}, true)
    0x05 | 0x12 => {
      let v = u16(r.p)
      r.p += 2
      (FVal{n: v}, true)
    }
    0x06 | 0x13 | 0x17 | 0x10 => {
      let v = u32(r.p)
      r.p += 4
      (FVal{n: v}, true)
    }
    0x07 | 0x14 | 0x20 => {
      let v = ld(r.p, 0)
      r.p += 8
      (FVal{n: v}, true)
    }
    0x0f | 0x15 => (FVal{n: r.uleb()}, true)
    0x0d => (FVal{n: r.sleb()}, true)
    0x08 => (FVal{str: r.cstr(), str_ok: true}, true)
    0x0e => {
      let o = u32(r.p)
      r.p += 4
      (FVal{str: if o < s.str_n { cstr(s.str + o, s.str_n - o) } else { "" }, str_ok: true}, true)
    }
    0x1f => {
      let o = u32(r.p)
      r.p += 4
      (FVal{str: if o < s.lstr_n { cstr(s.lstr + o, s.lstr_n - o) } else { "" }, str_ok: true}, true)
    }
    0x1a => (str_x(s, u, r.uleb()), true)
    0x25 => (str_x(s, u, r.byte()), true)
    0x26 => {
      let v = u16(r.p)
      r.p += 2
      (str_x(s, u, v), true)
    }
    0x27 => {
      let v = u16(r.p) | (u8(r.p + 2) << 16)
      r.p += 3
      (str_x(s, u, v), true)
    }
    0x28 => {
      let v = u32(r.p)
      r.p += 4
      (str_x(s, u, v), true)
    }
    0x1b | 0x22 | 0x23 => (FVal{n: r.uleb(), idx: true}, true)
    0x29 => (FVal{n: r.byte(), idx: true}, true)
    0x2a => {
      let v = u16(r.p)
      r.p += 2
      (FVal{n: v, idx: true}, true)
    }
    0x2b => {
      let v = u16(r.p) | (u8(r.p + 2) << 16)
      r.p += 3
      (FVal{n: v, idx: true}, true)
    }
    0x2c => {
      let v = u32(r.p)
      r.p += 4
      (FVal{n: v, idx: true}, true)
    }
    0x0c => (FVal{n: r.byte()}, true)
    0x19 => (FVal{n: 1}, true)
    0x21 => (FVal{n: imp}, true)
    0x1e => {
      r.p += 16
      (FVal{}, true)
    }
    0x0a => {
      let n = r.byte()
      r.p += n
      (FVal{}, true)
    }
    0x03 => {
      let n = u16(r.p)
      r.p += 2 + n
      (FVal{}, true)
    }
    0x04 => {
      let n = u32(r.p)
      r.p += 4 + n
      (FVal{}, true)
    }
    0x09 | 0x18 => {
      let n = r.uleb()
      r.p += n
      (FVal{}, true)
    }
    _ => (FVal{}, false)
  }
}

/// String k of the unit's string offsets.
fn str_x(s: Sects, u: Unit, k: Int) -> FVal {
  let o = u.str_base + 4 * k
  if o + 4 > s.stroff_n {
    return FVal{str_ok: true}
  }
  let so = u32(s.stroff + o)
  FVal{str: if so < s.str_n { cstr(s.str + so, s.str_n - so) } else { "" }, str_ok: true}
}

/// Address k of the unit's address table.
fn addr_x(s: Sects, u: Unit, k: Int) -> Int {
  let o = u.addr_base + 8 * k
  if o + 8 > s.addr_n {
    return 0
  }
  ld(s.addr + o, 0)
}

/// The ranges of a rnglist at offset off of .debug_rnglists.
fn rnglist(s: Sects, u: Unit, off: Int) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  if off >= s.rng_n {
    return out
  }
  var r = Rd{p: s.rng + off, end: s.rng + s.rng_n}
  var base = u.low
  while r.p < r.end {
    let k = r.byte()
    match k {
      0 => break
      1 => base = addr_x(s, u, r.uleb())
      2 => {
        let a = addr_x(s, u, r.uleb())
        out.push((a, addr_x(s, u, r.uleb())))
      }
      3 => {
        let a = addr_x(s, u, r.uleb())
        out.push((a, a + r.uleb()))
      }
      4 => {
        let a = r.uleb()
        out.push((base + a, base + r.uleb()))
      }
      5 => {
        base = ld(r.p, 0)
        r.p += 8
      }
      6 => {
        let a = ld(r.p, 0)
        out.push((a, ld(r.p, 8)))
        r.p += 16
      }
      7 => {
        let a = ld(r.p, 0)
        r.p += 8
        out.push((a, a + r.uleb()))
      }
      _ => break
    }
  }
  out
}

/// A DW_TAG_inlined_subroutine read, before its origin's name is known.
struct InlRec {
  ranges: List[(Int, Int)]
  depth: Int
  origin: Int
  file: Int
  line: Int
}

/// Every unit's inlined calls into out (addresses moved by bias), with
/// their callees' names (abstract_origin, one level of specification or
/// origin followed).
fn parse_info(s: Sects, bias: Int, var out: Lines) {
  if s.info_n == 0 || s.abbrev_n == 0 {
    return
  }
  // the entries' names and origins by offset in .debug_info
  var names: Map[Int, Str] = {}
  var origins: Map[Int, Int] = {}
  var recs: List[InlRec] = []
  var p = s.info
  let end = s.info + s.info_n
  while p + 11 <= end {
    let len = u32(p)
    if len == 0 || len == 0xffffffff {
      break
    }
    let next = p + 4 + len
    if next > end {
      break
    }
    var u = Unit{start: p - s.info, ver: u16(p + 4)}
    var r = Rd{p: p + 6, end: next}
    var aoff = 0
    if u.ver >= 5 {
      let _ut = r.byte()
      u.asize = r.byte()
      aoff = u32(r.p)
      r.p += 4
    } else {
      aoff = u32(r.p)
      r.p += 4
      u.asize = r.byte()
    }
    let tab = abbrevs(s, aoff)
    // the unit's line program's files (DW_AT_stmt_list)
    var files: List[Int] = []
    var depth = 0
    // the inlined depth at each level of the tree (entries' children)
    var inl_at: List[Int] = [0]
    var ok = true
    while ok && r.p < next {
      let die = r.p - s.info
      let code = r.uleb()
      if code == 0 {
        if depth > 0 {
          depth -= 1
          let _x = inl_at.pop()
        }
        continue
      }
      let ab = match tab.get(code) {
        Some(a) => a
        None => {
          ok = false
          Abbrev{tag: 0, kids: false, attrs: []}
        }
      }
      if !ok {
        break
      }
      var name = ""
      var origin = -1
      var low = 0
      var low_x = false
      var high = 0
      var high_x = false
      var high_off = false
      var rng = -1
      var rng_x = false
      var cfile = 0
      var cline = 0
      for a in ab.attrs {
        let (v, fok) = read_form(r, a.form, s, u, a.imp)
        if !fok {
          ok = false
          break
        }
        match a.at {
          0x03 => if v.str_ok { name = v.str }
          0x31 | 0x47 => {
            // abstract_origin, specification: a unit relative reference
            // (ref_addr: from the section's start)
            origin = if a.form == 0x10 { v.n } else { u.start + v.n }
          }
          0x11 => {
            low = v.n
            low_x = v.idx
          }
          0x12 => {
            high = v.n
            high_x = v.idx
            // a constant class high_pc is an offset from low_pc
            high_off = !(a.form == 0x01 || a.form == 0x1b || (a.form >= 0x29 && a.form <= 0x2c))
          }
          0x55 => {
            rng = v.n
            rng_x = v.idx
          }
          0x58 => cfile = v.n
          0x59 => cline = v.n
          0x10 => {
            // stmt_list: this unit's line program
            files = out.ufiles.get(v.n) ?? []
          }
          0x72 => u.str_base = v.n
          0x73 => u.addr_base = v.n
          0x74 => u.rng_base = v.n
          _ => {}
        }
      }
      if !ok {
        break
      }
      if low_x {
        low = addr_x(s, u, low)
      }
      if high_x {
        high = addr_x(s, u, high)
      }
      if high_off {
        high = low + high
      }
      if ab.tag == 0x11 {
        u.low = low
      }
      if !name.is_empty() {
        names[die] = name
      }
      if origin >= 0 {
        origins[die] = origin
      }
      var here = inl_at[inl_at.len() - 1]
      if ab.tag == 0x1d {
        here += 1
        var ranges: List[(Int, Int)] = []
        if rng >= 0 {
          var off = rng
          if rng_x {
            let o = u.rng_base + 4 * rng
            off = if o + 4 <= s.rng_n { u.rng_base + u32(s.rng + o) } else { s.rng_n }
          }
          ranges = rnglist(s, u, off)
        } else if high > low {
          ranges = [(low, high)]
        }
        let fi = if cfile < files.len() { files[cfile] } else { -1 }
        recs.push(InlRec{ranges: ranges, depth: here, origin: origin, file: fi, line: cline})
      }
      if ab.kids {
        depth += 1
        inl_at.push(here)
      }
    }
    p = next
  }
  for rec in recs {
    // the callee's name: the origin's, or its own origin's
    var name = ""
    var o = rec.origin
    var guard = 0
    while o >= 0 && guard < 4 {
      if let Some(nm) = names.get(o) {
        name = nm
        break
      }
      o = origins.get(o) ?? -1
      guard += 1
    }
    if name.is_empty() {
      name = "?"
    }
    for (a, b) in rec.ranges {
      out.inl_lo.push(a + bias)
      out.inl_hi.push(b + bias)
      out.inl_depth.push(rec.depth)
      out.inl_name.push(name)
      out.inl_file.push(rec.file)
      out.inl_line.push(rec.line)
    }
  }
}

/// A frame of the code at an address: function, file, and line.
pub struct Frame {
  pub name: Str
  pub file: Str
  pub line: Int
}

/// The inlined frames at pc, innermost first (each callee at its line:
/// the line table's for the innermost, the call's below it), and the
/// file and line of the function holding them all (the outermost call's,
/// or pc's own when nothing is inlined there).
///
/// fname is the function's symbol: LLVM inlines the program's main into
/// xo_entry, which the printers show as main, so there the outermost
/// inlined frame main is the function itself (not listed twice).
pub fn inline_chain(t: Lines, pc: Int, fname: Str) -> (List[Frame], Str, Int) {
  // the entries holding pc, by depth
  var by: List[Int] = []
  for i in 0..t.inl_lo.len() {
    if t.inl_lo[i] <= pc && pc < t.inl_hi[i] {
      by.push(i)
    }
  }
  let (f0, l0) = find(t, pc)
  if by.is_empty() {
    return ([], f0, l0)
  }
  // deepest first
  var keys: List[Int] = []
  for i in by {
    keys.push(rt.int_wrap(3, t.inl_depth[i], 32) | i)
  }
  keys = keys.sort()
  var order: List[Int] = []
  var k = keys.len() - 1
  while k >= 0 {
    order.push(keys[k] & 4294967295)
    k -= 1
  }
  var frames: List[Frame] = []
  var file = f0
  var line = l0
  for i in order {
    frames.push(Frame{name: t.inl_name[i], file: file, line: line})
    file = if t.inl_file[i] >= 0 && t.inl_file[i] < t.names.len() { t.names[t.inl_file[i]] } else { "" }
    line = t.inl_line[i]
  }
  if fname == "xo_entry" && frames.len() > 0 && frames[frames.len() - 1].name == "main" {
    let m = frames[frames.len() - 1]
    let _x = frames.pop()
    return (frames, m.file, m.line)
  }
  (frames, file, line)
}
