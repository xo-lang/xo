// The test world of native test binaries (decision 0083), part 2, in Xo
// (the zero-C audit's B15; it was std/llrt/xo_testing.c): FakeClock's
// sleeps, advance, and set; FakeNet.listen's in memory listeners, which
// http.server serves by registering its router and the test's http
// client reaches in process (std/native/http.xo); testing.run_main
// (main below a node of its own, the stop state reset for it); and
// FakeProc.signal_after; the virtual clock's move when every context
// waits (kick), and the test world's end (end).
//
// The test world's record (twflags.xo TW_*: on, the virtual now,
// in_main, the effects made real, whether the clock is virtual) is read
// through its address, which start keeps. The
// state of this module is a record from rt.heap_large whose address is
// the first of testworld.xo's run_words, guarded by the second (a lock
// word): the 64 static words are all taken.
//
// Generated code reaches it through the native prelude's llrt_test_*
// (compiler/ssa testmode.xo), http.xo directly, and the C runtime
// through cabi_tw.xo's exports (xo_x_tw_*).
use native/llrt/layout
use native/llrt/atexit
use native/llrt/ctx
use native/llrt/det
use native/llrt/poll
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/rc
use native/llrt/stop
use native/llrt/stdio
use native/llrt/sysio
use native/llrt/tasks
use native/llrt/testworld
use native/llrt/tracerec
use native/llrt/twflags
use native/rt

/// The state record (byte offsets): the C's tw record, FakeClock.sleeps'
/// vector and signal_after's (before run_main) vector (the address of
/// the words, the length, the capacity), the in memory listeners (a
/// list of ML records), the last port given, the node run_main restores
/// and main's node, and whether os.proc.exit unwinds main (atomic).
const R_TW = 0
const R_SLEEPS = 8
const R_SIGNALS = 32
const R_MLS = 56
const R_PORT = 64
const R_OUTER = 72
const R_MAIN = 80
const R_EXITING = 88
/// The runs started (next).
const R_RAN = 96
const R_SIZE = 104

/// The test world's record's fields (twflags.xo), the clock's bit of
/// the effects made real (testworld.xo REAL_CLOCK), and the virtual
/// clock's start, 2026-01-01T00:00:00Z.
const TW_ON = twflags.TW_ON
const TW_VNOW = twflags.TW_VNOW
const TW_VPENDING = twflags.TW_VPENDING
const TW_VEPOCH = twflags.TW_VEPOCH
const TW_REAL = twflags.TW_REAL
const TW_IN_MAIN = twflags.TW_IN_MAIN
const TW_VIRT = twflags.TW_VIRT
const TW_REAL_CLOCK = 8
const TW_EPOCH = 1767225600000000000

/// An in memory listener: its listener (netconn.xo's listener record,
/// not counted: the listener frees its record), its address
/// and its alias (localhost:<port> for 127.0.0.1; blocks: the length,
/// then the bytes, or 0), the router serving it (an rt.Any's object,
/// counted, or 0), whether it is closed, whether serve started once,
/// the requests running, the clients waiting in begin (they hold no
/// reference), whether the listener is gone (the last waiting client
/// frees this), its wait list (accept, clients waiting for serve,
/// drain: two words), the next record, and its backlog of raw
/// connections dialed to it (decision 0292: the first and last ME
/// records, linked by ME_QNEXT).
const ML_L = 0
const ML_ADDR = 8
const ML_ALIAS = 16
const ML_ROUTER = 24
const ML_CLOSED = 32
const ML_SERVED = 40
const ML_INFLIGHT = 48
const ML_NBEGIN = 56
const ML_FREED = 64
const ML_WAITERS = 72
const ML_NEXT = 88
const ML_QHEAD = 96
const ML_QTAIL = 104
const ML_SIZE = 112

/// One direction of a raw in memory connection (decision 0292, std/rt's
/// memPipe): a ring of PIPE_CAP bytes (a heap block), the offset of its
/// first byte and the bytes held, whether the writer closed (reads end
/// after the bytes held) and whether the reader closed (writes fail),
/// its wait list (two words), and the ends that still hold it.
const P_BUF = 0
const P_START = 8
const P_LEN = 16
const P_WCLOSED = 24
const P_RCLOSED = 32
const P_WAITERS = 40
const P_REFS = 56
const P_SIZE = 64 // own: the in-memory pipe record's size, not the pool record's
const PIPE_CAP = 65536

/// One end of a raw in memory connection: the pipe it reads, the pipe it
/// writes, and the next end in a listener's backlog.
const ME_IN = 0
const ME_OUT = 8
const ME_QNEXT = 16
const ME_SIZE = 24

/// A listener's mem (netconn.xo L_MEM, asserted in xo_rt.c): the ML record.
const L_MEM = 32

/// A context's node, and its unwinding flag (an int; ctx.xo).
const C_NODE = layout.C_NODE
const C_UNWINDING = layout.C_UNWINDING
/// A node's canceled word (byte offset), and the bytes this module
/// allocates for one (layout.xo N_SIZE is 56; 64 was xo_rt.c's at most).
const N_CANCELED = layout.N_CANCELED
const N_ALLOC = 64

const ACQUIRE = 1
const RELEASE = 2
const ACQ_REL = 3
const SEQ_CST = 4

/// A timer's words (poll.xo T_*: its deadline, its place in
/// the heap, its park, its function; 64 bytes, as poll.xo's).
const T_WHEN = 0
const T_IDX = 8
const T_PARK = 16
const T_FN = 24
const T_SIZE = 64

fn ld(p: Int, k: Int) -> Int { rt.mem_load(p, k, 8) }

fn st(p: Int, k: Int, v: Int) { rt.mem_store(p, k, v, 8) }

/// The state record, made on first use.
fn state() -> Int {
  let w = testworld.run_words()
  let a = rt.slot_load[Int](w, 0, ACQUIRE)
  if a != 0 {
    return a
  }
  let n = rt.heap_large(R_SIZE)
  rt.mem_set(n, 0, R_SIZE)
  if rt.slot_cas[Int](w, 0, 0, n, ACQ_REL) {
    return n
  }
  rt.heap_release(n - 8)
  rt.slot_load[Int](w, 0, ACQUIRE)
}

/// The lock word.
fn lock_word() -> Int { testworld.run_words() + 8 }

fn lock() { pool.lock(lock_word()) }

fn unlock() { pool.unlock(lock_word()) }

/// Starts the test world (a test binary's start, one thread; entry.xo
/// through the C's services record): testworld.xo's variables (its V_*)
/// and effects made real, then the test world's record (twflags.xo): the
/// effects, whether the clock is virtual (`xo test --real` with
/// `clock`, `net`, or `proc` makes it real: a socket or child process
/// wait is not a virtual wait, and its deadlines are real time), the
/// virtual now at 2026-01-01T00:00:00Z, and on.
pub fn start() {
  // the test world's values are released at exit (entry.xo, decision
  // 0233)
  atexit.set_tw_end(rt.fn_addr("tw_end"))
  let vars = ["XO_TEST_REAL", "XO_TEST_SEED", "XO_TEST", "XO_PROP_REPLAY", "XO_PROP_SEED", "XO_PROP_BEST"]
  for k in 0..vars.len() {
    let a = process.env_real_at(vars[k])
    testworld.setenv(k, a, if a == 0 { -1 } else { raw.cstr_len(a) })
  }
  // testworld.init makes the record (twflags.set)
  let real = testworld.init()
  let w = twflags.rec()
  st(state(), R_TW, w)
  // the virtual clock's move after a deadlock check (pool.xo kick)
  rt.mem_store(w, twflags.TW_KICK, rt.fn_addr("tw_kick"), 8)
  rt.mem_store(w, TW_REAL, real, 4)
  rt.mem_store(w, TW_VIRT, if (real & TW_REAL_CLOCK) == 0 { 1 } else { 0 }, 4)
  st(w, TW_VNOW, TW_EPOCH)
  rt.mem_store(w, TW_ON, 1, 4)
  testworld.set_batch(process.env_real_at("XO_TEST_BATCH"))
  testworld.set_serve(process.env_real_at("XO_TEST_SERVE"))
}

fn tw() -> Int { ld(state(), R_TW) }

fn virt() -> Bool { rt.mem_load(tw(), TW_VIRT, 4) != 0 }

fn in_main() -> Bool {
  let v = rt.mem_load(tw(), TW_IN_MAIN, 4)
  rt.fence(ACQUIRE)
  v != 0
}

fn set_in_main(on: Bool) {
  rt.fence(RELEASE)
  rt.mem_store(tw(), TW_IN_MAIN, if on { 1 } else { 0 }, 4)
}

/// The timers' deadline d from now (xo_rt.c deadline: the virtual clock
/// in the test world, else the monotonic one; at most the largest Int;
/// std/native/llrt/stdin.xo's waits in a test binary).
pub fn deadline(d: Int) -> Int {
  let now = if virt() { rt.slot_load[Int](tw(), 1, ACQUIRE) } else { sysio.mono_ns() }
  let w = now.wrapping_add(d)
  if d > 0 && w < now { 9223372036854775807 } else { w }
}

// ---------------------------------------------------------------------------
// Vectors of words (the address of the words from rt.heap_large, the
// length, the capacity)

fn vec_push(v: Int, x: Int) {
  let n = ld(v, 8)
  if n == ld(v, 16) {
    let c = if n == 0 { 8 } else { 2 * n }
    let old = ld(v, 0)
    let p = if old == 0 { rt.heap_large(8 * c) } else { rt.heap_large_resize(old - 8, 8 * c) }
    st(v, 0, p)
    st(v, 16, c)
  }
  st(ld(v, 0), 8 * n, x)
  st(v, 8, n + 1)
}

/// The words of v, and v emptied.
fn vec_take(v: Int) -> List[Int] {
  var out: List[Int] = []
  for i in 0..ld(v, 8) {
    out.push(ld(ld(v, 0), 8 * i))
  }
  st(v, 8, 0)
  out
}

// ---------------------------------------------------------------------------
// The virtual clock (FakeClock)

/// Records a sleep of d for FakeClock.sleeps (xo_rt.c clock_wait).
pub fn sleep_record(d: Int) {
  lock()
  vec_push(state() + R_SLEEPS, d)
  unlock()
}

/// FakeClock.sleeps(): every sleep asked for, in order.
pub fn sleeps() -> List[Int] {
  lock()
  let v = state() + R_SLEEPS
  var out: List[Int] = []
  for i in 0..ld(v, 8) {
    out.push(ld(ld(v, 0), 8 * i))
  }
  unlock()
  out
}

/// FakeClock.set(t).
pub fn clock_set(t: Int) { rt.slot_store[Int](tw(), 1, t, RELEASE) }

/// Waits, counted as blocked for the deadlock check (so the virtual
/// clock moves) and not a cancellation point, until a timer at deadline
/// d from now fires.
fn wait_counted(d: Int) {
  let c = ctx.cur()
  let park = poll.park_of(c)
  pool.park_reset(park)
  let t = poll.timer_park(deadline(d), park)
  while !poll.timer_fired(t) {
    if tracerec.built() {
      rt.mem_store(c, ctx.C_WHY, tracerec.WHY_TEST, 8)
    }
    tasks.park_wait_n(c, false, true)
  }
  poll.timer_end(t)
}

/// FakeClock.advance(d): the timers due within d fire in order, the
/// woken contexts running (until every one waits again) after each
/// instant; then the clock reads now + d. It waits like a sleep that is
/// not a cancellation point and is not listed by sleeps().
pub fn advance(d: Int) {
  wait_counted(if d < 0 { 0 } else { d })
  // the contexts woken at the last instant (with this one) run until
  // every one waits again before advance returns, as std/rt's
  // World.Advance: a timer due now fires at the next move of the clock,
  // which comes only when every context waits
  wait_counted(0)
}

// ---------------------------------------------------------------------------
// testing.run_main and FakeProc.signal_after (core 7.5)

/// FakeProc.signal_after(d): inside run_main a signal d from now, before
/// it d from run_main's start.
pub fn signal_after(d: Int) {
  if in_main() {
    signal_arm(d)
    return
  }
  lock()
  vec_push(state() + R_SIGNALS, d)
  unlock()
}

/// Arms FakeProc.signal_after's signal d from now: a timer of the event
/// loop whose firing runs the stop state's signal and frees it (poll.xo
/// fire, FN_SIGNAL).
fn signal_arm(d: Int) {
  let t = rt.heap_large(T_SIZE)
  rt.mem_set(t, 0, T_SIZE)
  st(t, T_WHEN, deadline(if d < 0 { 0 } else { d }))
  st(t, T_IDX, -1)
  st(t, T_FN, poll.FN_SIGNAL)
  poll.timer_add(t)
}

fn node_canceled(n: Int) -> Bool { rt.slot_load[Int](n + N_CANCELED, 0, ACQUIRE) != 0 }

/// Starts testing.run_main: main's root is a new node below the test's,
/// the stop state is fresh, and the queued signals are armed.
pub fn main_begin(args: List[Str]) {
  testworld.set_args(args)
  let c = ctx.cur()
  let n = rt.heap_large(N_ALLOC)
  rt.mem_set(n, 0, N_ALLOC)
  pool.node_link(n, ld(c, C_NODE))
  let s = state()
  st(s, R_OUTER, ld(c, C_NODE))
  st(s, R_MAIN, n)
  st(c, C_NODE, n)
  stop.reset(n)
  set_in_main(true)
  lock()
  let sigs = vec_take(s + R_SIGNALS)
  unlock()
  for d in sigs {
    signal_arm(d)
  }
}

/// Ends testing.run_main with main's status code: the test's node is
/// current again; when os.proc.exit unwound main, its code is the
/// status; when main unwound because the stop state canceled its root
/// (and not because the test is canceled), the unwinding ends here and
/// the status is 0; after a third signal the status is 130 however main
/// ended, and FakeProc.exit_code is Some(130) (std/rt's
/// Testing_run_main).
pub fn main_end(code: Int) -> Int {
  let c = ctx.cur()
  let s = state()
  set_in_main(false)
  let n = ld(s, R_MAIN)
  st(c, C_NODE, ld(s, R_OUTER))
  let exited = stop.unroot(n)
  if n != 0 {
    pool.node_unlink(n)
    rt.heap_release(n - 8)
    st(s, R_MAIN, 0)
  }
  var r = code
  let node = ld(c, C_NODE)
  if rt.slot_swap[Int](s, R_EXITING / 8, 0, ACQ_REL) != 0 && !node_canceled(node) {
    // os.proc.exit unwound main (exit): its code is the status
    rt.mem_store(c, C_UNWINDING, 0, 4)
    r = testworld.exit_value()
  } else if rt.mem_load(c, C_UNWINDING, 4) != 0 && stop.canceled() && !node_canceled(node) {
    rt.mem_store(c, C_UNWINDING, 0, 4)
    r = 0
  }
  if exited != 0 {
    testworld.set_exit(130)
    r = 130
  }
  r
}

/// os.proc.exit in a test (std.md 8.4): the code is recorded
/// (FakeProc.exit_code). Inside testing.run_main main unwinds back to it
/// (decision 0108): its root is canceled and this context unwinds
/// (generated code checks after the call), and main_end gives the code
/// as main's status: true. Outside it, false: the test ends and passes
/// (the C exits), as on the Go backend.
pub fn exit(code: Int) -> Bool {
  testworld.set_exit(code)
  let s = state()
  if in_main() && ld(s, R_MAIN) != 0 {
    rt.slot_store[Int](s, R_EXITING / 8, 1, RELEASE)
    pool.node_cancel(ctx.pool(), ld(s, R_MAIN))
    rt.mem_store(ctx.cur(), C_UNWINDING, 1, 4)
    return true
  }
  false
}

// ---------------------------------------------------------------------------
// In memory listeners (std/rt's memListener)

/// A block of s: its length, then the bytes.
fn blk(s: Str) -> Int {
  let b = rt.heap_large(s.len() + 8)
  st(b, 0, s.len())
  rt.mem_copy(b + 8, raw.data(s), s.len())
  b
}

fn blk_free(b: Int) {
  if b != 0 {
    rt.heap_release(b - 8)
  }
}

fn blk_str(b: Int) -> Str { raw.str_at(b + 8, ld(b, 0)) }

/// Whether block b (0: none) holds the n bytes at p.
fn blk_eq(b: Int, p: Int, n: Int) -> Bool { b != 0 && ld(b, 0) == n && raw.mem_eq(b + 8, p, n) }

/// Wakes every waiter of listener ml (xo_rt.c wl_wake).
fn wake(ml: Int) { wake_list(ml + ML_WAITERS) }

/// Wakes every waiter of the wait list at l.
fn wake_list(l: Int) {
  var e = ld(l, 0)
  while e != 0 {
    tasks.park_signal(ld(e, 0))
    e = ld(e, 16)
  }
}

/// Waits on ml's wait list, the lock held (and held again): false when
/// the task was canceled.
fn wait(ml: Int) -> Bool { tasks.wl_wait_as(ctx.cur(), lock_word(), ml + ML_WAITERS, true, 0) }

/// The offset of the last ':' of s, or -1.
fn last_colon(s: Str) -> Int {
  let b = s.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 58 {
    i -= 1
  }
  i
}

/// FakeNet.listen(addr) (netconn.xo listen in the test world): the ML
/// record of a new in memory listener for the listener l (a
/// netconn.xo record); ":0" (and port 0) picks the next port from 49152; a
/// "unix:" address is an in memory Unix domain socket (decision 0190).
pub fn listen(addr: Str, l: Int) -> Int {
  let ml = rt.heap_large(ML_SIZE)
  rt.mem_set(ml, 0, ML_SIZE)
  st(ml, ML_L, l)
  lock()
  if addr.starts_with("unix:") {
    st(ml, ML_ADDR, blk(addr))
  } else {
    var host = "127.0.0.1"
    var port = addr
    let i = last_colon(addr)
    if i >= 0 {
      if i > 0 {
        host = raw.str_slice(addr, 0, i)
      }
      port = raw.str_slice(addr, i + 1, addr.len())
    }
    if port.is_empty() || port == "0" {
      let p = ld(state(), R_PORT) + 1
      st(state(), R_PORT, p)
      port = "${49151 + p}"
    }
    st(ml, ML_ADDR, blk("${host}:${port}"))
    if host == "127.0.0.1" {
      st(ml, ML_ALIAS, blk("localhost:${port}"))
    }
  }
  st(ml, ML_NEXT, ld(state(), R_MLS))
  st(state(), R_MLS, ml)
  unlock()
  ml
}

/// The address of ml as a malloc'd C string for the listener (its
/// addr, which listener_free frees).
pub fn ml_caddr(ml: Int) -> Int {
  let b = ld(ml, ML_ADDR)
  let n = ld(b, 0)
  let a = rt.heap_large(n + 1) - 8
  rt.mem_copy(a, b + 8, n)
  rt.mem_store(a, n, 0, 1)
  a
}

fn ml_release(ml: Int) {
  blk_free(ld(ml, ML_ADDR))
  blk_free(ld(ml, ML_ALIAS))
  rt.heap_release(ml - 8)
}

/// The listener of ml is freed (netconn.xo listener_free): ml leaves the
/// list and closes; a client still waiting for a serve that never came
/// wakes and fails, and frees ml when it leaves
/// (gotchas/mem-listener-backlog-after-serve.md).
pub fn ml_free(ml: Int) {
  lock()
  let s = state()
  var prev = 0
  var m = ld(s, R_MLS)
  while m != 0 {
    if m == ml {
      if prev == 0 {
        st(s, R_MLS, ld(ml, ML_NEXT))
      } else {
        st(prev, ML_NEXT, ld(ml, ML_NEXT))
      }
      break
    }
    prev = m
    m = ld(m, ML_NEXT)
  }
  let r = ld(ml, ML_ROUTER)
  st(ml, ML_ROUTER, 0)
  st(ml, ML_CLOSED, 1)
  st(ml, ML_L, 0)
  backlog_reset(ml)
  wake(ml)
  let keep = ld(ml, ML_NBEGIN) > 0
  st(ml, ML_FREED, if keep { 1 } else { 0 })
  unlock()
  if r != 0 {
    tasks.h_release(r)
  }
  if !keep {
    ml_release(ml)
  }
}

/// The listener of ml closes: a waiting accept fails, and the raw
/// connections in its backlog are reset.
pub fn ml_close(ml: Int) {
  lock()
  st(ml, ML_CLOSED, 1)
  backlog_reset(ml)
  wake(ml)
  unlock()
}

/// accept on ml: the next raw connection dialed to it (an ME record,
/// decision 0292), 0 when the listener closes, -1 when the task is
/// canceled; HTTP requests reach a served router in process, never as
/// connections.
pub fn ml_accept(ml: Int) -> Int {
  lock()
  while true {
    let q = ld(ml, ML_QHEAD)
    if q != 0 {
      st(ml, ML_QHEAD, ld(q, ME_QNEXT))
      if ld(ml, ML_QHEAD) == 0 {
        st(ml, ML_QTAIL, 0)
      }
      st(q, ME_QNEXT, 0)
      unlock()
      return q
    }
    if ld(ml, ML_CLOSED) != 0 {
      unlock()
      return 0
    }
    if !wait(ml) {
      unlock()
      return -1
    }
  }
  0
}

// ---------------------------------------------------------------------------
// Raw in memory connections (decision 0292, std/rt memconn.go)

fn pipe_new() -> Int {
  let p = rt.heap_large(P_SIZE)
  rt.mem_set(p, 0, P_SIZE)
  st(p, P_BUF, rt.heap_large(PIPE_CAP))
  st(p, P_REFS, 2)
  p
}

/// Drops an end's hold on pipe p, freeing it with the last; the lock
/// held.
fn pipe_drop(p: Int) {
  st(p, P_REFS, ld(p, P_REFS) - 1)
  if ld(p, P_REFS) == 0 {
    rt.heap_release(ld(p, P_BUF) - 8)
    rt.heap_release(p - 8)
  }
}

/// Closes end me, the lock held: its peer's reads end after the bytes
/// held and its peer's writes fail.
fn me_close_locked(me: Int) {
  let out = ld(me, ME_OUT)
  st(out, P_WCLOSED, 1)
  wake_list(out + P_WAITERS)
  let inp = ld(me, ME_IN)
  st(inp, P_RCLOSED, 1)
  st(inp, P_LEN, 0)
  wake_list(inp + P_WAITERS)
}

/// Closes and frees end me, the lock held.
fn me_release(me: Int) {
  me_close_locked(me)
  pipe_drop(ld(me, ME_IN))
  pipe_drop(ld(me, ME_OUT))
  rt.heap_release(me - 8)
}

/// Resets the raw connections in ml's backlog (closed, freed), the lock
/// held.
fn backlog_reset(ml: Int) {
  var q = ld(ml, ML_QHEAD)
  while q != 0 {
    let next = ld(q, ME_QNEXT)
    me_release(q)
    q = next
  }
  st(ml, ML_QHEAD, 0)
  st(ml, ML_QTAIL, 0)
}

/// FakeNet.dial(addr) (netconn.xo dial in the test world): the dialer's
/// end of a new raw connection, its other end queued in the backlog of
/// the open listener at addr; 0 when there is none (Refused).
pub fn dial(addr: Str) -> Int {
  lock()
  let ml = find(addr, false)
  if ml == 0 || ld(ml, ML_CLOSED) != 0 {
    unlock()
    return 0
  }
  let a = pipe_new()
  let b = pipe_new()
  let client = rt.heap_large(ME_SIZE)
  let server = rt.heap_large(ME_SIZE)
  st(client, ME_IN, a)
  st(client, ME_OUT, b)
  st(client, ME_QNEXT, 0)
  st(server, ME_IN, b)
  st(server, ME_OUT, a)
  st(server, ME_QNEXT, 0)
  let tail = ld(ml, ML_QTAIL)
  if tail == 0 {
    st(ml, ML_QHEAD, server)
  } else {
    st(tail, ME_QNEXT, server)
  }
  st(ml, ML_QTAIL, server)
  wake(ml)
  unlock()
  client
}

/// Whether an open listener has the address addr (host:port; a host
/// left out is 127.0.0.1), for FakeNet.listen's "address already in
/// use"; port 0 picks a free one.
pub fn in_use(addr: Str) -> Bool {
  if addr.starts_with("unix:") {
    lock()
    let m = find(addr, false)
    let busy = m != 0 && ld(m, ML_CLOSED) == 0
    unlock()
    return busy
  }
  let i = last_colon(addr)
  if i < 0 || i == addr.len() - 1 || raw.str_slice(addr, i + 1, addr.len()) == "0" {
    return false
  }
  let hp = if i == 0 { "127.0.0.1${addr}" } else { addr }
  lock()
  let m = find(hp, false)
  let busy = m != 0 && ld(m, ML_CLOSED) == 0
  unlock()
  busy
}

/// Reads at most max bytes from end me into a: the count, 0 at the end
/// of the stream, -1 canceled, -2 when me is closed.
pub fn me_read(me: Int, a: Int, max: Int) -> Int {
  lock()
  let p = ld(me, ME_IN)
  while true {
    if ld(p, P_RCLOSED) != 0 {
      unlock()
      return -2
    }
    let held = ld(p, P_LEN)
    if held > 0 {
      let n = if held < max { held } else { max }
      let start = ld(p, P_START)
      let first = if start + n <= PIPE_CAP { n } else { PIPE_CAP - start }
      rt.mem_copy(a, ld(p, P_BUF) + start, first)
      if first < n {
        rt.mem_copy(a + first, ld(p, P_BUF), n - first)
      }
      st(p, P_START, (start + n) % PIPE_CAP)
      st(p, P_LEN, held - n)
      wake_list(p + P_WAITERS)
      unlock()
      return n
    }
    if ld(p, P_WCLOSED) != 0 {
      unlock()
      return 0
    }
    if !tasks.wl_wait_as(ctx.cur(), lock_word(), p + P_WAITERS, true, 0) {
      unlock()
      return -1
    }
  }
  0
}

/// Writes the n bytes at a to end me, waiting while its pipe is full: 0,
/// or -1 canceled, -2 when me is closed, -3 when the peer closed.
pub fn me_write(me: Int, a: Int, n: Int) -> Int {
  lock()
  let p = ld(me, ME_OUT)
  var off = 0
  while true {
    if ld(p, P_WCLOSED) != 0 {
      unlock()
      return -2
    }
    if ld(p, P_RCLOSED) != 0 {
      unlock()
      return -3
    }
    let held = ld(p, P_LEN)
    let room = PIPE_CAP - held
    if room > 0 && off < n {
      let k = if room < n - off { room } else { n - off }
      let at = (ld(p, P_START) + held) % PIPE_CAP
      let first = if at + k <= PIPE_CAP { k } else { PIPE_CAP - at }
      rt.mem_copy(ld(p, P_BUF) + at, a + off, first)
      if first < k {
        rt.mem_copy(ld(p, P_BUF), a + off + first, k - first)
      }
      st(p, P_LEN, held + k)
      off += k
      wake_list(p + P_WAITERS)
    }
    if off == n {
      unlock()
      return 0
    }
    if !tasks.wl_wait_as(ctx.cur(), lock_word(), p + P_WAITERS, true, 0) {
      unlock()
      return -1
    }
  }
  0
}

/// `c.close()` of end me.
pub fn me_close(me: Int) {
  lock()
  me_close_locked(me)
  unlock()
}

/// The connection of end me is freed.
pub fn me_free(me: Int) {
  lock()
  me_release(me)
  unlock()
}

/// The ML record of listener l, or 0 when it is a real one.
fn ml_of(l: Listener) -> Int { ld(rt.obj_addr(l), L_MEM) }

/// Whether l is in memory.
pub fn mem_listener(l: Listener) -> Bool { ml_of(l) != 0 }

/// Serves l with router r (an Any holding the http.Router): clients
/// waiting for it go on.
pub fn mem_serve(l: Listener, r: rt.Any) {
  let ml = ml_of(l)
  let a = rt.obj_addr(r)
  rc.inc(a)
  lock()
  let old = ld(ml, ML_ROUTER)
  st(ml, ML_ROUTER, a)
  st(ml, ML_SERVED, 1)
  wake(ml)
  unlock()
  if old != 0 {
    tasks.h_release(old)
  }
}

/// Stops serving l.
pub fn mem_unserve(l: Listener) {
  let ml = ml_of(l)
  lock()
  let old = ld(ml, ML_ROUTER)
  st(ml, ML_ROUTER, 0)
  wake(ml)
  unlock()
  if old != 0 {
    tasks.h_release(old)
  }
}

/// Waits until no request runs on l (after a stop request; canceled: it
/// returns).
pub fn mem_drain(l: Listener) {
  let ml = ml_of(l)
  lock()
  while ld(ml, ML_INFLIGHT) > 0 {
    if !wait(ml) {
      break
    }
  }
  unlock()
}

/// The listener at host:port hp (its address or alias), skipping closed
/// ones that serve nothing unless all; the lock held.
fn find(hp: Str, all: Bool) -> Int {
  var m = ld(state(), R_MLS)
  while m != 0 {
    if all || ld(m, ML_CLOSED) == 0 || ld(m, ML_ROUTER) != 0 {
      if blk_eq(ld(m, ML_ADDR), raw.data(hp), hp.len()) || blk_eq(ld(m, ML_ALIAS), raw.data(hp), hp.len()) {
        return m
      }
    }
    m = ld(m, ML_NEXT)
  }
  0
}

/// Starts a client request to host:port hp: the router serving it (an
/// Any) in a list of one, or the empty list when nothing serves it. A
/// listener that exists but was never served keeps the request waiting,
/// as a real backlog does, until it is served or closed (canceled: the
/// empty list). Once serve started, a request while it is not served
/// (stopped, draining, returned) fails at once, as std/rt's memListener:
/// a waiter there would be woken by nothing
/// (gotchas/mem-listener-backlog-after-serve.md).
pub fn mem_begin(hp: Str) -> List[rt.Any] {
  lock()
  var ml = find(hp, false)
  while ml != 0 && ld(ml, ML_ROUTER) == 0 && ld(ml, ML_SERVED) == 0 && ld(ml, ML_CLOSED) == 0 {
    st(ml, ML_NBEGIN, ld(ml, ML_NBEGIN) + 1)
    let ok = wait(ml)
    st(ml, ML_NBEGIN, ld(ml, ML_NBEGIN) - 1)
    if ld(ml, ML_FREED) != 0 {
      if ld(ml, ML_NBEGIN) == 0 {
        ml_release(ml)
      }
      ml = 0
      break
    }
    if !ok {
      ml = 0
    }
  }
  if ml != 0 && ld(ml, ML_ROUTER) != 0 {
    st(ml, ML_INFLIGHT, ld(ml, ML_INFLIGHT) + 1)
    let r = ld(ml, ML_ROUTER)
    // counted once more for the list (rt.obj_at)
    let out = [rt.obj_at[rt.Any](r)]
    unlock()
    return out
  }
  unlock()
  []
}

/// Ends a request mem_begin started.
pub fn mem_end(hp: Str) {
  lock()
  var ml = find(hp, false)
  if ml == 0 {
    ml = find(hp, true)
  }
  if ml != 0 && ld(ml, ML_INFLIGHT) > 0 {
    st(ml, ML_INFLIGHT, ld(ml, ML_INFLIGHT) - 1)
    if ld(ml, ML_INFLIGHT) == 0 {
      wake(ml)
    }
  }
  unlock()
}

/// Releases the values the test world keeps when the test ends, for the
/// leak check (on the C main thread, after main's thread ended):
/// testworld.xo's, handed over as a block of the count and the objects,
/// then the routers served.
pub fn end() {
  let kept = testworld.cleanup()
  for i in 1..ld(kept, 0) + 1 {
    tasks.h_release(ld(kept, 8 * i))
  }
  rt.heap_release(kept - 8)
  cleanup()
}

/// Releases the routers served when the test ends.
fn cleanup() {
  var routers: List[Int] = []
  lock()
  var m = ld(state(), R_MLS)
  while m != 0 {
    if ld(m, ML_ROUTER) != 0 {
      routers.push(ld(m, ML_ROUTER))
      st(m, ML_ROUTER, 0)
    }
    m = ld(m, ML_NEXT)
  }
  unlock()
  for r in routers {
    tasks.h_release(r)
  }
}

// ---------------------------------------------------------------------------
// Batches (XO_TEST_BATCH): `xo test` runs many tests in one process

/// The index of the next test to run, -1 when none is left (the test
/// binary's main loops until then; compiler/ssa testmode.xo). Without a
/// batch, XO_TEST's test once. In a batch, each run is bracketed by
/// XO-TEST-BEGIN and XO-TEST-END lines on the real standard output, and
/// the test world is reset between runs (between); a run the process
/// does not survive (a failure, a fault, a deadlock) has no
/// XO-TEST-END, and the harness runs it again alone. When the world
/// cannot be reset (a listener, a timer, or a cancellation outlives the
/// test) the batch ends early and the harness starts a new process for
/// the rest. The callers (the native prelude's llrt_test_next) reset
/// the modules above this one first.
pub fn next() -> Int {
  let s = state()
  let ran = ld(s, R_RAN)
  st(s, R_RAN, ran + 1)
  if !testworld.batched() {
    if ran > 0 {
      return -1
    }
    // no test (XO_TEST unset or negative) is a test no index names: the
    // main fails it, as it did before the loop
    let i = testworld.test_index()
    return if i < 0 { 9223372036854775807 } else { i }
  }
  if ran > 0 {
    let clean = between()
    testworld.write_real("XO-TEST-END\n")
    if !clean {
      return -1
    }
  }
  if testworld.serving() {
    // a run read from standard input (XO_TEST_SERVE): the harness's
    // shrinking writes one line per replay
    let i = testworld.serve_next()
    if i >= 0 {
      testworld.write_real("XO-TEST-BEGIN\n")
    }
    return i
  }
  let r = testworld.plan_next()
  if r.is_empty() {
    return -1
  }
  testworld.reset_test(r[1], r[2] != 0, r[3])
  if det.built() {
    // the run's seed drives the deterministic scheduler (decision 0350)
    det.reseed(r[1])
  }
  testworld.write_real("XO-TEST-BEGIN\n")
  r[0]
}

/// Whether a run of a batch ended (the native prelude's llrt_test_next
/// resets the modules above this one then).
pub fn ran() -> Bool { ld(state(), R_RAN) > 0 && testworld.batched() }

/// Resets the test world after a run of a batch, as a new process
/// starts it: the values kept released (end), no sleeps, queued signals,
/// ports given, or run_main state, the stop state fresh (stop.xo
/// reset_test), and the virtual clock at its start. Whether the world is
/// clean: no in memory listener, timer, or cancellation outlived the
/// test.
fn between() -> Bool {
  end()
  let s = state()
  lock()
  st(s, R_SLEEPS + 8, 0)
  st(s, R_SIGNALS + 8, 0)
  st(s, R_PORT, 0)
  let mls = ld(s, R_MLS)
  let main = ld(s, R_MAIN)
  st(s, R_EXITING, 0)
  unlock()
  stop.reset_test()
  let w = tw()
  set_in_main(false)
  rt.slot_store[Int](w + TW_VPENDING, 0, 0, SEQ_CST)
  rt.slot_store[Int](w, 1, TW_EPOCH, RELEASE)
  let mu = poll.ev_mu()
  pool.lock(mu)
  let timer = poll.timer_first()
  pool.unlock(mu)
  let c = ctx.cur()
  mls == 0 && main == 0 && timer == 0 && !node_canceled(ld(c, C_NODE)) && rt.mem_load(c, C_UNWINDING, 4) == 0
}

// ---------------------------------------------------------------------------
// The virtual clock's move (the scheduler calls kick after a deadlock
// check, through twflags.xo kick; it was xo_testing.c's)

/// Runs after a deadlock check found every context blocked: the clock
/// moves to the earliest timer and every timer due then fires; with none
/// the program is deadlocked. When the timers that fired woke no context
/// (a FakeProc.signal_after signal whose stop wakes nobody), every
/// context still waits and none would check again: the check runs again
/// here, and the clock moves on.
pub fn kick() {
  while kick_once() {
    let p = ctx.pool()
    pool.lock(p)
    pool.dl_check(p)
    pool.unlock(p)
  }
}

/// One move of the clock: true when only callback timers fired (no park
/// was signaled by the clock itself).
fn kick_once() -> Bool {
  let w = tw()
  if rt.mem_load(w, TW_VIRT, 4) == 0 {
    return false
  }
  let verdict = rt.slot_swap[Int](w + TW_VPENDING, 0, 0, SEQ_CST)
  if verdict == 0 {
    return false
  }
  let mu = poll.ev_mu()
  pool.lock(mu)
  let v = verdict - 1
  if v % 2 != 0 || v != rt.slot_load[Int](w + TW_VEPOCH, 0, SEQ_CST) {
    // stale: two threads can each find every context blocked at the
    // same instant and both take the verdict (one from the other's
    // store); the clock moved since (or was moving), and what it woke
    // may not have run yet (gotchas/virtual-clock-double-kick.md)
    pool.unlock(mu)
    return false
  }
  // odd while the clock moves: a check that reads the epoch now is stale
  // too (a signal's callback runs with the lock released)
  let _b = rt.slot_add[Int](w + TW_VEPOCH, 0, 1, SEQ_CST)
  var t = poll.timer_first()
  if t == 0 {
    pool.unlock(mu)
    // std/rt's test world names the timers too; straight to the
    // descriptor, as the C did (not the test world's fake)
    let m = "fault: XO-F001: deadlock: every task is blocked and no timer is pending\n"
    stdio.write_all(2, raw.data(m), m.len())
    process.os_exit(70)
  }
  let at = ld(t, T_WHEN)
  if at > rt.slot_load[Int](w, 1, ACQUIRE) {
    rt.slot_store[Int](w, 1, at, RELEASE)
  }
  var parks = 0
  while t != 0 && ld(t, T_WHEN) <= at {
    poll.timer_remove(t)
    if ld(t, T_PARK) != 0 {
      parks += 1
    }
    poll.fire(t, mu)
    t = poll.timer_first()
  }
  // what the timers woke is visible (queued, or a root counted awake):
  // checks that read the epoch from here on see it
  let _e = rt.slot_add[Int](w + TW_VEPOCH, 0, 1, SEQ_CST)
  pool.unlock(mu)
  parks == 0
}
