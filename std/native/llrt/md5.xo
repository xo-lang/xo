// MD5 (RFC 1321) for std/crypto's Hash (decision 0279; Postgres MD5
// authentication, Content-MD5), following Go's crypto/md5 (md5.go and
// md5block.go of go1.26): the same state, padding, and rounds, written
// as table driven loops over Go's constants instead of unrolled. MD5 is
// broken for collision resistance; it is here for the protocols that
// require it.

const M32: Int = 4294967295

/// Go's md5block.go round constants (floor(abs(sin(i + 1)) * 2^32)).
const K: List[Int] = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]

/// Go's per round rotate amounts.
const S: List[Int] = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]

pub struct Hasher {
  st: List[Int]
  held: Bytes
  total: Int
}

pub fn new() -> Hasher { Hasher{st: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476], held: b"", total: 0} }

fn le32(b: Bytes, i: Int) -> Int { Int(b[i]) | (Int(b[i + 1]) << 8) | (Int(b[i + 2]) << 16) | (Int(b[i + 3]) << 24) }

fn rotl(x: Int, s: Int) -> Int { ((x << s) | (x >> (32 - s))) & M32 }

fn block(var st: List[Int], p: Bytes, at: Int) {
  var x: List[Int] = List.with_capacity(16)
  for j in 0..16 { x.push(le32(p, at + 4 * j)) }
  let a0 = st[0]
  let b0 = st[1]
  let c0 = st[2]
  let d0 = st[3]
  var a = a0
  var b = b0
  var c = c0
  var d = d0
  for i in 0..64 {
    var f = 0
    var g = 0
    if i < 16 {
      f = ((c ^ d) & b) ^ d
      g = i
    } else if i < 32 {
      f = ((b ^ c) & d) ^ c
      g = (5 * i + 1) % 16
    } else if i < 48 {
      f = b ^ c ^ d
      g = (3 * i + 5) % 16
    } else {
      f = c ^ (b | (d ^ M32))
      g = (7 * i) % 16
    }
    let t = d
    d = c
    c = b
    b = (b + rotl((f + a + x[g] + K[i]) & M32, S[i])) & M32
    a = t
  }
  st.set(0, (a0 + a) & M32)
  st.set(1, (b0 + b) & M32)
  st.set(2, (c0 + c) & M32)
  st.set(3, (d0 + d) & M32)
}

pub fn (var h: Hasher) write(data: Bytes) {
  h.total += data.len()
  let buf = h.held + data
  var i = 0
  while i + 64 <= buf.len() {
    block(h.st, buf, i)
    i += 64
  }
  h.held = buf[i..]
}

/// The digest of what was written; h is unchanged and can be written to
/// further.
pub fn (h: Hasher) sum() -> Bytes {
  var c = h
  let n = h.total
  // padding: 0x80, zeros to 56 mod 64, then the bit length little endian
  var pad = BytesBuilder.new()
  pad.write_byte(0x80)
  let zeros = (55 - n % 64 + 64) % 64
  for _ in 0..zeros { pad.write_byte(0) }
  let bits = n * 8
  for j in 0..8 { pad.write_byte(UInt8((bits >> (8 * j)) & 255)) }
  c.write(pad.freeze())
  var out = BytesBuilder.with_capacity(16)
  for w in c.st {
    for j in 0..4 { out.write_byte(UInt8((w >> (8 * j)) & 255)) }
  }
  out.freeze()
}

pub fn sum(data: Bytes) -> Bytes {
  var h = new()
  h.write(data)
  h.sum()
}
