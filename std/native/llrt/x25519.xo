// X25519 (RFC 7748) for TLS's key exchange (work item B31, decision
// 0202), as Go's crypto/ecdh X25519: the scalar is clamped, the u
// coordinate's top bit ignored and a value of p or more taken modulo p.
// Constant time (decision 0222, ct.xo): RFC 7748's Montgomery ladder
// over every one of the 255 bits with masked swaps (ct.pick), on a
// field of four 64 bit limbs kept below 2^256 and reduced modulo 2^256 -
// 38 (generated by scripts/x25519fe64.py; sums on cpu.adc chains,
// decision 0231's addendum; no branch or index on a secret), and the
// inversion as a fixed power. A
// low order point gives all zeros; Go's ECDH reports that as an error,
// and the TLS layer must reject it.
use native/llrt/cpu
use native/llrt/ct
use native/llrt/ed25519
use native/rt

// byte offsets of the ladder's elements past ed25519.SPARE
const X1: Int = 0
const X2: Int = 40
const Z2: Int = 80
const X3: Int = 120
const Z3: Int = 160
const TA: Int = 200
const TB: Int = 240
const AA: Int = 280
const BB: Int = 320
const E: Int = 360
const TC: Int = 400
const TD: Int = 440
const S0: Int = 480
const S1: Int = 520
const S2: Int = 560
const S3: Int = 600
const S4: Int = 640
// the elements' words
const EXTRA: Int = 85

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// Swaps elements f and g when mask is all ones, keeps them when 0.
fn cswap(f: Int, g: Int, mask: Int) {
  for i in 0..4 {
    let a = ld(f, 8 * i)
    let b = ld(g, 8 * i)
    st(f, 8 * i, ct.pick(mask, b, a))
    st(g, 8 * i, ct.pick(mask, a, b))
  }
}

/// The u coordinate of [scalar]point: scalar and point are 32 bytes each
/// (RFC 7748 5, X25519).
pub fn scalar_mult(scalar: Bytes, point: Bytes) -> Bytes {
  let w = ed25519.field_workspace(EXTRA)
  let m = ed25519.base(w)
  let e = rt.int_wrap(0, m, ed25519.SPARE)
  let x1 = rt.int_wrap(0, e, X1)
  let x2 = rt.int_wrap(0, e, X2)
  let z2 = rt.int_wrap(0, e, Z2)
  let x3 = rt.int_wrap(0, e, X3)
  let z3 = rt.int_wrap(0, e, Z3)
  let a = rt.int_wrap(0, e, TA)
  let b = rt.int_wrap(0, e, TB)
  let aa = rt.int_wrap(0, e, AA)
  let bb = rt.int_wrap(0, e, BB)
  let ee = rt.int_wrap(0, e, E)
  let c = rt.int_wrap(0, e, TC)
  let d = rt.int_wrap(0, e, TD)
  // clamped: the low three bits cleared, bit 255 cleared, bit 254 set
  let top = rt.int_wrap(3, 1, 63)
  let k = [rt.bytes_word(scalar, 0) & ~7, rt.bytes_word(scalar, 8), rt.bytes_word(scalar, 16), (rt.bytes_word(scalar, 24) & ~top) | rt.int_wrap(3, 1, 62)]
  // u's top bit ignored; a value of p or more works as it is (below
  // 2^255, reduced on the way)
  st(x1, 0, rt.bytes_word(point, 0))
  st(x1, 8, rt.bytes_word(point, 8))
  st(x1, 16, rt.bytes_word(point, 16))
  st(x1, 24, rt.bytes_word(point, 24) & ~top)
  fe64_set(x2, 1)
  fe64_set(z2, 0)
  rt.mem_copy(x3, x1, 32)
  fe64_set(z3, 1)
  var swap = 0
  var t = 254
  while t >= 0 {
    let bit = rt.int_wrap(4, k[t / 64], t % 64) & 1
    let mask = ct.mask_bit(swap ^ bit)
    cswap(x2, x3, mask)
    cswap(z2, z3, mask)
    swap = bit
    fe64_add(a, x2, z2)
    fe64_sq(aa, a)
    fe64_sub(b, x2, z2)
    fe64_sq(bb, b)
    fe64_sub(ee, aa, bb)
    fe64_add(c, x3, z3)
    fe64_sub(d, x3, z3)
    fe64_mul(d, d, a) // DA
    fe64_mul(c, c, b) // CB
    fe64_add(x3, d, c)
    fe64_sq(x3, x3)
    fe64_sub(z3, d, c)
    fe64_sq(z3, z3)
    fe64_mul(z3, z3, x1)
    fe64_mul(x2, aa, bb)
    fe64_mul121665(z2, ee)
    fe64_add(z2, z2, aa)
    fe64_mul(z2, z2, ee)
    t -= 1
  }
  let mask = ct.mask_bit(swap)
  cswap(x2, x3, mask)
  cswap(z2, z3, mask)
  fe64_inv(z2, z2, rt.int_wrap(0, e, S0), rt.int_wrap(0, e, S1), rt.int_wrap(0, e, S2), rt.int_wrap(0, e, S3), rt.int_wrap(0, e, S4))
  fe64_mul(x2, x2, z2)
  fe64_freeze(x2, x2)
  var s = rt.rs_with_cap(32)
  for i in 0..4 {
    s = rt.rs_push_word(s, ld(x2, 8 * i), 8)
  }
  keep(w)
  s.bytes()
}

/// h = the small value v.
fn fe64_set(h: Int, v: Int) {
  st(h, 0, v)
  st(h, 8, 0)
  st(h, 16, 0)
  st(h, 24, 0)
}

/// h = f^(2^k), k at least 1 (h may be f).
fn fe64_sqn(h: Int, f: Int, k: Int) {
  fe64_sq(h, f)
  var i = 1
  while i < k {
    fe64_sq(h, h)
    i += 1
  }
}

/// h = z^(p - 2) = z^(2^255 - 21) = 1/z (0 for 0), the fixed chain of
/// 254 squarings and 11 products (ref10's), in the scratch elements
/// s0 to s4; h may be z.
fn fe64_inv(h: Int, z: Int, s0: Int, s1: Int, s2: Int, s3: Int, s4: Int) {
  fe64_sq(s0, z) // z^2
  fe64_sqn(s3, s0, 2) // z^8
  fe64_mul(s1, s3, z) // z^9
  fe64_mul(s2, s1, s0) // z^11
  fe64_sq(s3, s2) // z^22
  fe64_mul(s1, s3, s1) // z^(2^5 - 1)
  fe64_sqn(s3, s1, 5)
  fe64_mul(s1, s3, s1) // z^(2^10 - 1)
  fe64_sqn(s3, s1, 10)
  fe64_mul(s4, s3, s1) // z^(2^20 - 1)
  fe64_sqn(s3, s4, 20)
  fe64_mul(s3, s3, s4) // z^(2^40 - 1)
  fe64_sqn(s3, s3, 10)
  fe64_mul(s1, s3, s1) // z^(2^50 - 1)
  fe64_sqn(s3, s1, 50)
  fe64_mul(s4, s3, s1) // z^(2^100 - 1)
  fe64_sqn(s3, s4, 100)
  fe64_mul(s3, s3, s4) // z^(2^200 - 1)
  fe64_sqn(s3, s3, 50)
  fe64_mul(s3, s3, s1) // z^(2^250 - 1)
  fe64_sqn(s3, s3, 5) // z^(2^255 - 2^5)
  fe64_mul(h, s3, s2) // z^(2^255 - 21)
}

/// The public key of scalar: [scalar]9 (RFC 7748 6.1).
pub fn base(scalar: Bytes) -> Bytes {
  var nine = rt.rs_push_byte(rt.rs_with_cap(32), 9)
  for _ in 0..31 {
    nine = rt.rs_push_byte(nine, 0)
  }
  scalar_mult(scalar, nine.bytes())
}

/// The workspace is alive up to here (ed25519.xo's keep).
fn keep(w: List[Int]) {
  if w.len() < 0 {
    return
  }
}

/// internal.crypto_op's "x25519." ops (std/internal.xo): mult (scalar
/// a, point b; all zeros for a low order point) and base (scalar a).
/// None if unknown.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  match what {
    "mult" => scalar_mult(a, b)
    "base" => base(a)
    _ => None
  }
}

// ---------------------------------------------------------------------------
// The field on 64 bit limbs, generated by scripts/x25519fe64.py: do not edit

/// h = f g modulo 2^256 - 38 (f, g below 2^256): the 512 bit product's
/// high half times 38 added to its low half.
fn fe64_mul(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let lo1 = rt.int_wrap(2, f0, g0)
  let hi2 = rt.u64_mul_hi(f0, g0)
  let lo3 = rt.int_wrap(2, f1, g0)
  let hi4 = rt.u64_mul_hi(f1, g0)
  let lo5 = rt.int_wrap(2, f2, g0)
  let hi6 = rt.u64_mul_hi(f2, g0)
  let lo7 = rt.int_wrap(2, f3, g0)
  let hi8 = rt.u64_mul_hi(f3, g0)
  let s9 = cpu.adc(0, lo1, 0)
  let k10 = cpu.adc_carry(0, lo1, 0)
  let s11 = cpu.adc(0, lo3, k10)
  let k12 = cpu.adc_carry(0, lo3, k10)
  let s13 = cpu.adc(0, lo5, k12)
  let k14 = cpu.adc_carry(0, lo5, k12)
  let s15 = cpu.adc(0, lo7, k14)
  let k16 = cpu.adc_carry(0, lo7, k14)
  let s17 = cpu.adc(0, 0, k16)
  let k18 = cpu.adc_carry(0, 0, k16)
  let s19 = cpu.adc(s11, hi2, 0)
  let k20 = cpu.adc_carry(s11, hi2, 0)
  let s21 = cpu.adc(s13, hi4, k20)
  let k22 = cpu.adc_carry(s13, hi4, k20)
  let s23 = cpu.adc(s15, hi6, k22)
  let k24 = cpu.adc_carry(s15, hi6, k22)
  let s25 = cpu.adc(s17, hi8, k24)
  let k26 = cpu.adc_carry(s17, hi8, k24)
  let s27 = cpu.adc(k18, 0, k26)
  let k28 = cpu.adc_carry(k18, 0, k26)
  let lo29 = rt.int_wrap(2, f0, g1)
  let hi30 = rt.u64_mul_hi(f0, g1)
  let lo31 = rt.int_wrap(2, f1, g1)
  let hi32 = rt.u64_mul_hi(f1, g1)
  let lo33 = rt.int_wrap(2, f2, g1)
  let hi34 = rt.u64_mul_hi(f2, g1)
  let lo35 = rt.int_wrap(2, f3, g1)
  let hi36 = rt.u64_mul_hi(f3, g1)
  let s37 = cpu.adc(s19, lo29, 0)
  let k38 = cpu.adc_carry(s19, lo29, 0)
  let s39 = cpu.adc(s21, lo31, k38)
  let k40 = cpu.adc_carry(s21, lo31, k38)
  let s41 = cpu.adc(s23, lo33, k40)
  let k42 = cpu.adc_carry(s23, lo33, k40)
  let s43 = cpu.adc(s25, lo35, k42)
  let k44 = cpu.adc_carry(s25, lo35, k42)
  let s45 = cpu.adc(s27, 0, k44)
  let k46 = cpu.adc_carry(s27, 0, k44)
  let w47 = rt.int_wrap(0, k28, k46)
  let s48 = cpu.adc(s39, hi30, 0)
  let k49 = cpu.adc_carry(s39, hi30, 0)
  let s50 = cpu.adc(s41, hi32, k49)
  let k51 = cpu.adc_carry(s41, hi32, k49)
  let s52 = cpu.adc(s43, hi34, k51)
  let k53 = cpu.adc_carry(s43, hi34, k51)
  let s54 = cpu.adc(s45, hi36, k53)
  let k55 = cpu.adc_carry(s45, hi36, k53)
  let s56 = cpu.adc(w47, 0, k55)
  let k57 = cpu.adc_carry(w47, 0, k55)
  let lo58 = rt.int_wrap(2, f0, g2)
  let hi59 = rt.u64_mul_hi(f0, g2)
  let lo60 = rt.int_wrap(2, f1, g2)
  let hi61 = rt.u64_mul_hi(f1, g2)
  let lo62 = rt.int_wrap(2, f2, g2)
  let hi63 = rt.u64_mul_hi(f2, g2)
  let lo64 = rt.int_wrap(2, f3, g2)
  let hi65 = rt.u64_mul_hi(f3, g2)
  let s66 = cpu.adc(s48, lo58, 0)
  let k67 = cpu.adc_carry(s48, lo58, 0)
  let s68 = cpu.adc(s50, lo60, k67)
  let k69 = cpu.adc_carry(s50, lo60, k67)
  let s70 = cpu.adc(s52, lo62, k69)
  let k71 = cpu.adc_carry(s52, lo62, k69)
  let s72 = cpu.adc(s54, lo64, k71)
  let k73 = cpu.adc_carry(s54, lo64, k71)
  let s74 = cpu.adc(s56, 0, k73)
  let k75 = cpu.adc_carry(s56, 0, k73)
  let w76 = rt.int_wrap(0, k57, k75)
  let s77 = cpu.adc(s68, hi59, 0)
  let k78 = cpu.adc_carry(s68, hi59, 0)
  let s79 = cpu.adc(s70, hi61, k78)
  let k80 = cpu.adc_carry(s70, hi61, k78)
  let s81 = cpu.adc(s72, hi63, k80)
  let k82 = cpu.adc_carry(s72, hi63, k80)
  let s83 = cpu.adc(s74, hi65, k82)
  let k84 = cpu.adc_carry(s74, hi65, k82)
  let s85 = cpu.adc(w76, 0, k84)
  let k86 = cpu.adc_carry(w76, 0, k84)
  let lo87 = rt.int_wrap(2, f0, g3)
  let hi88 = rt.u64_mul_hi(f0, g3)
  let lo89 = rt.int_wrap(2, f1, g3)
  let hi90 = rt.u64_mul_hi(f1, g3)
  let lo91 = rt.int_wrap(2, f2, g3)
  let hi92 = rt.u64_mul_hi(f2, g3)
  let lo93 = rt.int_wrap(2, f3, g3)
  let hi94 = rt.u64_mul_hi(f3, g3)
  let s95 = cpu.adc(s77, lo87, 0)
  let k96 = cpu.adc_carry(s77, lo87, 0)
  let s97 = cpu.adc(s79, lo89, k96)
  let k98 = cpu.adc_carry(s79, lo89, k96)
  let s99 = cpu.adc(s81, lo91, k98)
  let k100 = cpu.adc_carry(s81, lo91, k98)
  let s101 = cpu.adc(s83, lo93, k100)
  let k102 = cpu.adc_carry(s83, lo93, k100)
  let s103 = cpu.adc(s85, 0, k102)
  let k104 = cpu.adc_carry(s85, 0, k102)
  let w105 = rt.int_wrap(0, k86, k104)
  let s106 = cpu.adc(s97, hi88, 0)
  let k107 = cpu.adc_carry(s97, hi88, 0)
  let s108 = cpu.adc(s99, hi90, k107)
  let k109 = cpu.adc_carry(s99, hi90, k107)
  let s110 = cpu.adc(s101, hi92, k109)
  let k111 = cpu.adc_carry(s101, hi92, k109)
  let s112 = cpu.adc(s103, hi94, k111)
  let k113 = cpu.adc_carry(s103, hi94, k111)
  let _s114 = cpu.adc(w105, 0, k113)
  let _k115 = cpu.adc_carry(w105, 0, k113)
  let lo116 = rt.int_wrap(2, s106, 38)
  let hi117 = rt.u64_mul_hi(s106, 38)
  let lo118 = rt.int_wrap(2, s108, 38)
  let hi119 = rt.u64_mul_hi(s108, 38)
  let lo120 = rt.int_wrap(2, s110, 38)
  let hi121 = rt.u64_mul_hi(s110, 38)
  let lo122 = rt.int_wrap(2, s112, 38)
  let hi123 = rt.u64_mul_hi(s112, 38)
  let s124 = cpu.adc(s9, lo116, 0)
  let k125 = cpu.adc_carry(s9, lo116, 0)
  let s126 = cpu.adc(s37, lo118, k125)
  let k127 = cpu.adc_carry(s37, lo118, k125)
  let s128 = cpu.adc(s66, lo120, k127)
  let k129 = cpu.adc_carry(s66, lo120, k127)
  let s130 = cpu.adc(s95, lo122, k129)
  let k131 = cpu.adc_carry(s95, lo122, k129)
  let s132 = cpu.adc(s126, hi117, 0)
  let k133 = cpu.adc_carry(s126, hi117, 0)
  let s134 = cpu.adc(s128, hi119, k133)
  let k135 = cpu.adc_carry(s128, hi119, k133)
  let s136 = cpu.adc(s130, hi121, k135)
  let k137 = cpu.adc_carry(s130, hi121, k135)
  let w138 = rt.int_wrap(0, hi123, k131)
  let w139 = rt.int_wrap(0, w138, k137)
  let t140 = rt.int_wrap(2, w139, 38)
  let s141 = cpu.adc(s124, t140, 0)
  let k142 = cpu.adc_carry(s124, t140, 0)
  let s143 = cpu.adc(s132, 0, k142)
  let k144 = cpu.adc_carry(s132, 0, k142)
  let s145 = cpu.adc(s134, 0, k144)
  let k146 = cpu.adc_carry(s134, 0, k144)
  let s147 = cpu.adc(s136, 0, k146)
  let k148 = cpu.adc_carry(s136, 0, k146)
  let w149 = rt.int_wrap(0, s141, rt.int_wrap(2, k148, 38))
