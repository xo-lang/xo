// X25519 (RFC 7748) for TLS's key exchange (work item B31, decision
// 0202), as Go's crypto/ecdh X25519: the scalar is clamped, the u
// coordinate's top bit ignored and a value of p or more taken modulo p.
// Constant time (decision 0222, ct.xo): RFC 7748's Montgomery ladder
// over every one of the 255 bits with masked swaps (ct.pick), on a
// field of four 64 bit limbs kept below 2^256 and reduced modulo 2^256 -
// 38 (generated by scripts/x25519fe64.py; sums on cpu.adc chains,
// decision 0231's addendum; no branch or index on a secret), and the
// inversion as a fixed power. A
// low order point gives all zeros; Go's ECDH reports that as an error,
// and the TLS layer must reject it.
use native/llrt/cpu
use native/llrt/ct
use native/llrt/ed25519
use native/rt

// byte offsets of the ladder's elements past ed25519.SPARE
const X1: Int = 0
const X2: Int = 40
const Z2: Int = 80
const X3: Int = 120
const Z3: Int = 160
const TA: Int = 200
const TB: Int = 240
const AA: Int = 280
const BB: Int = 320
const E: Int = 360
const TC: Int = 400
const TD: Int = 440
const S0: Int = 480
const S1: Int = 520
const S2: Int = 560
const S3: Int = 600
const S4: Int = 640
// the elements' words
const EXTRA: Int = 85

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// Swaps elements f and g when mask is all ones, keeps them when 0.
fn cswap(f: Int, g: Int, mask: Int) {
  for i in 0..4 {
    let a = ld(f, 8 * i)
    let b = ld(g, 8 * i)
    st(f, 8 * i, ct.pick(mask, b, a))
    st(g, 8 * i, ct.pick(mask, a, b))
  }
}

/// The u coordinate of [scalar]point: scalar and point are 32 bytes each
/// (RFC 7748 5, X25519).
pub fn scalar_mult(scalar: Bytes, point: Bytes) -> Bytes {
  let w = ed25519.field_workspace(EXTRA)
  let m = ed25519.base(w)
  let e = rt.int_wrap(0, m, ed25519.SPARE)
  let x1 = rt.int_wrap(0, e, X1)
  let x2 = rt.int_wrap(0, e, X2)
  let z2 = rt.int_wrap(0, e, Z2)
  let x3 = rt.int_wrap(0, e, X3)
  let z3 = rt.int_wrap(0, e, Z3)
  let a = rt.int_wrap(0, e, TA)
  let b = rt.int_wrap(0, e, TB)
  let aa = rt.int_wrap(0, e, AA)
  let bb = rt.int_wrap(0, e, BB)
  let ee = rt.int_wrap(0, e, E)
  let c = rt.int_wrap(0, e, TC)
  let d = rt.int_wrap(0, e, TD)
  // clamped: the low three bits cleared, bit 255 cleared, bit 254 set
  let top = rt.int_wrap(3, 1, 63)
  let k = [rt.bytes_word(scalar, 0) & ~7, rt.bytes_word(scalar, 8), rt.bytes_word(scalar, 16), (rt.bytes_word(scalar, 24) & ~top) | rt.int_wrap(3, 1, 62)]
  // u's top bit ignored; a value of p or more works as it is (below
  // 2^255, reduced on the way)
  st(x1, 0, rt.bytes_word(point, 0))
  st(x1, 8, rt.bytes_word(point, 8))
  st(x1, 16, rt.bytes_word(point, 16))
  st(x1, 24, rt.bytes_word(point, 24) & ~top)
  fe64_set(x2, 1)
  fe64_set(z2, 0)
  rt.mem_copy(x3, x1, 32)
  fe64_set(z3, 1)
  var swap = 0
  var t = 254
  while t >= 0 {
    let bit = rt.int_wrap(4, k[t / 64], t % 64) & 1
    let mask = ct.mask_bit(swap ^ bit)
    cswap(x2, x3, mask)
    cswap(z2, z3, mask)
    swap = bit
    fe64_add(a, x2, z2)
    fe64_sq(aa, a)
    fe64_sub(b, x2, z2)
    fe64_sq(bb, b)
    fe64_sub(ee, aa, bb)
    fe64_add(c, x3, z3)
    fe64_sub(d, x3, z3)
    fe64_mul(d, d, a) // DA
    fe64_mul(c, c, b) // CB
    fe64_add(x3, d, c)
    fe64_sq(x3, x3)
    fe64_sub(z3, d, c)
    fe64_sq(z3, z3)
    fe64_mul(z3, z3, x1)
    fe64_mul(x2, aa, bb)
    fe64_mul121665(z2, ee)
    fe64_add(z2, z2, aa)
    fe64_mul(z2, z2, ee)
    t -= 1
  }
  let mask = ct.mask_bit(swap)
  cswap(x2, x3, mask)
  cswap(z2, z3, mask)
  fe64_inv(z2, z2, rt.int_wrap(0, e, S0), rt.int_wrap(0, e, S1), rt.int_wrap(0, e, S2), rt.int_wrap(0, e, S3), rt.int_wrap(0, e, S4))
  fe64_mul(x2, x2, z2)
  fe64_freeze(x2, x2)
  var s = rt.rs_with_cap(32)
  for i in 0..4 {
    s = rt.rs_push_word(s, ld(x2, 8 * i), 8)
  }
  keep(w)
  s.bytes()
}

/// h = the small value v.
fn fe64_set(h: Int, v: Int) {
  st(h, 0, v)
  st(h, 8, 0)
  st(h, 16, 0)
  st(h, 24, 0)
}

/// h = f^(2^k), k at least 1 (h may be f).
fn fe64_sqn(h: Int, f: Int, k: Int) {
  fe64_sq(h, f)
  var i = 1
  while i < k {
    fe64_sq(h, h)
    i += 1
  }
}

/// h = z^(p - 2) = z^(2^255 - 21) = 1/z (0 for 0), the fixed chain of
/// 254 squarings and 11 products (ref10's), in the scratch elements
/// s0 to s4; h may be z.
fn fe64_inv(h: Int, z: Int, s0: Int, s1: Int, s2: Int, s3: Int, s4: Int) {
  fe64_sq(s0, z) // z^2
  fe64_sqn(s3, s0, 2) // z^8
  fe64_mul(s1, s3, z) // z^9
  fe64_mul(s2, s1, s0) // z^11
  fe64_sq(s3, s2) // z^22
  fe64_mul(s1, s3, s1) // z^(2^5 - 1)
  fe64_sqn(s3, s1, 5)
  fe64_mul(s1, s3, s1) // z^(2^10 - 1)
  fe64_sqn(s3, s1, 10)
  fe64_mul(s4, s3, s1) // z^(2^20 - 1)
  fe64_sqn(s3, s4, 20)
  fe64_mul(s3, s3, s4) // z^(2^40 - 1)
  fe64_sqn(s3, s3, 10)
  fe64_mul(s1, s3, s1) // z^(2^50 - 1)
  fe64_sqn(s3, s1, 50)
  fe64_mul(s4, s3, s1) // z^(2^100 - 1)
  fe64_sqn(s3, s4, 100)
  fe64_mul(s3, s3, s4) // z^(2^200 - 1)
  fe64_sqn(s3, s3, 50)
  fe64_mul(s3, s3, s1) // z^(2^250 - 1)
  fe64_sqn(s3, s3, 5) // z^(2^255 - 2^5)
  fe64_mul(h, s3, s2) // z^(2^255 - 21)
}

/// The public key of scalar: [scalar]9 (RFC 7748 6.1).
pub fn base(scalar: Bytes) -> Bytes {
  var nine = rt.rs_push_byte(rt.rs_with_cap(32), 9)
  for _ in 0..31 {
    nine = rt.rs_push_byte(nine, 0)
  }
  scalar_mult(scalar, nine.bytes())
}

/// The workspace is alive up to here (ed25519.xo's keep).
fn keep(w: List[Int]) {
  if w.len() < 0 {
    return
  }
}

/// internal.crypto_op's "x25519." ops (std/internal.xo): mult (scalar
/// a, point b; all zeros for a low order point) and base (scalar a).
/// None if unknown.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  match what {
    "mult" => scalar_mult(a, b)
    "base" => base(a)
    _ => None
  }
}

// ---------------------------------------------------------------------------
// The field on 64 bit limbs, generated by scripts/x25519fe64.py: do not edit

/// h = f g modulo 2^256 - 38 (f, g below 2^256): the 512 bit product's
/// high half times 38 added to its low half.
fn fe64_mul(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let lo1 = rt.int_wrap(2, f0, g0)
  let hi2 = rt.u64_mul_hi(f0, g0)
  let lo3 = rt.int_wrap(2, f1, g0)
  let hi4 = rt.u64_mul_hi(f1, g0)
  let lo5 = rt.int_wrap(2, f2, g0)
  let hi6 = rt.u64_mul_hi(f2, g0)
  let lo7 = rt.int_wrap(2, f3, g0)
  let hi8 = rt.u64_mul_hi(f3, g0)
  let s9 = cpu.adc(lo3, hi2, 0)
  let k10 = cpu.adc_carry(lo3, hi2, 0)
  let s11 = cpu.adc(lo5, hi4, k10)
  let k12 = cpu.adc_carry(lo5, hi4, k10)
  let s13 = cpu.adc(lo7, hi6, k12)
  let k14 = cpu.adc_carry(lo7, hi6, k12)
  let s15 = cpu.adc(0, hi8, k14)
  let k16 = cpu.adc_carry(0, hi8, k14)
  let s17 = cpu.adc(0, 0, k16)
  let k18 = cpu.adc_carry(0, 0, k16)
  let lo19 = rt.int_wrap(2, f0, g1)
  let hi20 = rt.u64_mul_hi(f0, g1)
  let lo21 = rt.int_wrap(2, f1, g1)
  let hi22 = rt.u64_mul_hi(f1, g1)
  let lo23 = rt.int_wrap(2, f2, g1)
  let hi24 = rt.u64_mul_hi(f2, g1)
  let lo25 = rt.int_wrap(2, f3, g1)
  let hi26 = rt.u64_mul_hi(f3, g1)
  let s27 = cpu.adc(s9, lo19, 0)
  let k28 = cpu.adc_carry(s9, lo19, 0)
  let s29 = cpu.adc(s11, lo21, k28)
  let k30 = cpu.adc_carry(s11, lo21, k28)
  let s31 = cpu.adc(s13, lo23, k30)
  let k32 = cpu.adc_carry(s13, lo23, k30)
  let s33 = cpu.adc(s15, lo25, k32)
  let k34 = cpu.adc_carry(s15, lo25, k32)
  let s35 = cpu.adc(s17, 0, k34)
  let k36 = cpu.adc_carry(s17, 0, k34)
  let w37 = rt.int_wrap(0, k18, k36)
  let s38 = cpu.adc(s29, hi20, 0)
  let k39 = cpu.adc_carry(s29, hi20, 0)
  let s40 = cpu.adc(s31, hi22, k39)
  let k41 = cpu.adc_carry(s31, hi22, k39)
  let s42 = cpu.adc(s33, hi24, k41)
  let k43 = cpu.adc_carry(s33, hi24, k41)
  let s44 = cpu.adc(s35, hi26, k43)
  let k45 = cpu.adc_carry(s35, hi26, k43)
  let s46 = cpu.adc(w37, 0, k45)
  let k47 = cpu.adc_carry(w37, 0, k45)
  let lo48 = rt.int_wrap(2, f0, g2)
  let hi49 = rt.u64_mul_hi(f0, g2)
  let lo50 = rt.int_wrap(2, f1, g2)
  let hi51 = rt.u64_mul_hi(f1, g2)
  let lo52 = rt.int_wrap(2, f2, g2)
  let hi53 = rt.u64_mul_hi(f2, g2)
  let lo54 = rt.int_wrap(2, f3, g2)
  let hi55 = rt.u64_mul_hi(f3, g2)
  let s56 = cpu.adc(s38, lo48, 0)
  let k57 = cpu.adc_carry(s38, lo48, 0)
  let s58 = cpu.adc(s40, lo50, k57)
  let k59 = cpu.adc_carry(s40, lo50, k57)
  let s60 = cpu.adc(s42, lo52, k59)
  let k61 = cpu.adc_carry(s42, lo52, k59)
  let s62 = cpu.adc(s44, lo54, k61)
  let k63 = cpu.adc_carry(s44, lo54, k61)
  let s64 = cpu.adc(s46, 0, k63)
  let k65 = cpu.adc_carry(s46, 0, k63)
  let w66 = rt.int_wrap(0, k47, k65)
  let s67 = cpu.adc(s58, hi49, 0)
  let k68 = cpu.adc_carry(s58, hi49, 0)
  let s69 = cpu.adc(s60, hi51, k68)
  let k70 = cpu.adc_carry(s60, hi51, k68)
  let s71 = cpu.adc(s62, hi53, k70)
  let k72 = cpu.adc_carry(s62, hi53, k70)
  let s73 = cpu.adc(s64, hi55, k72)
  let k74 = cpu.adc_carry(s64, hi55, k72)
  let s75 = cpu.adc(w66, 0, k74)
  let k76 = cpu.adc_carry(w66, 0, k74)
  let lo77 = rt.int_wrap(2, f0, g3)
  let hi78 = rt.u64_mul_hi(f0, g3)
  let lo79 = rt.int_wrap(2, f1, g3)
  let hi80 = rt.u64_mul_hi(f1, g3)
  let lo81 = rt.int_wrap(2, f2, g3)
  let hi82 = rt.u64_mul_hi(f2, g3)
  let lo83 = rt.int_wrap(2, f3, g3)
  let hi84 = rt.u64_mul_hi(f3, g3)
  let s85 = cpu.adc(s67, lo77, 0)
  let k86 = cpu.adc_carry(s67, lo77, 0)
  let s87 = cpu.adc(s69, lo79, k86)
  let k88 = cpu.adc_carry(s69, lo79, k86)
  let s89 = cpu.adc(s71, lo81, k88)
  let k90 = cpu.adc_carry(s71, lo81, k88)
  let s91 = cpu.adc(s73, lo83, k90)
  let k92 = cpu.adc_carry(s73, lo83, k90)
  let s93 = cpu.adc(s75, 0, k92)
  let k94 = cpu.adc_carry(s75, 0, k92)
  let w95 = rt.int_wrap(0, k76, k94)
  let s96 = cpu.adc(s87, hi78, 0)
  let k97 = cpu.adc_carry(s87, hi78, 0)
  let s98 = cpu.adc(s89, hi80, k97)
  let k99 = cpu.adc_carry(s89, hi80, k97)
  let s100 = cpu.adc(s91, hi82, k99)
  let k101 = cpu.adc_carry(s91, hi82, k99)
  let s102 = cpu.adc(s93, hi84, k101)
  let k103 = cpu.adc_carry(s93, hi84, k101)
  let _s104 = cpu.adc(w95, 0, k103)
  let _k105 = cpu.adc_carry(w95, 0, k103)
  let lo106 = rt.int_wrap(2, s96, 38)
  let hi107 = rt.u64_mul_hi(s96, 38)
  let lo108 = rt.int_wrap(2, s98, 38)
  let hi109 = rt.u64_mul_hi(s98, 38)
  let lo110 = rt.int_wrap(2, s100, 38)
  let hi111 = rt.u64_mul_hi(s100, 38)
  let lo112 = rt.int_wrap(2, s102, 38)
  let hi113 = rt.u64_mul_hi(s102, 38)
  let s114 = cpu.adc(lo1, lo106, 0)
  let k115 = cpu.adc_carry(lo1, lo106, 0)
  let s116 = cpu.adc(s27, lo108, k115)
  let k117 = cpu.adc_carry(s27, lo108, k115)
  let s118 = cpu.adc(s56, lo110, k117)
  let k119 = cpu.adc_carry(s56, lo110, k117)
  let s120 = cpu.adc(s85, lo112, k119)
  let k121 = cpu.adc_carry(s85, lo112, k119)
  let s122 = cpu.adc(s116, hi107, 0)
  let k123 = cpu.adc_carry(s116, hi107, 0)
  let s124 = cpu.adc(s118, hi109, k123)
  let k125 = cpu.adc_carry(s118, hi109, k123)
  let s126 = cpu.adc(s120, hi111, k125)
  let k127 = cpu.adc_carry(s120, hi111, k125)
  let w128 = rt.int_wrap(0, hi113, k121)
  let w129 = rt.int_wrap(0, w128, k127)
  let t130 = rt.int_wrap(2, w129, 38)
  let s131 = cpu.adc(s114, t130, 0)
  let k132 = cpu.adc_carry(s114, t130, 0)
  let s133 = cpu.adc(s122, 0, k132)
  let k134 = cpu.adc_carry(s122, 0, k132)
  let s135 = cpu.adc(s124, 0, k134)
  let k136 = cpu.adc_carry(s124, 0, k134)
  let s137 = cpu.adc(s126, 0, k136)
  let k138 = cpu.adc_carry(s126, 0, k136)
  let w139 = rt.int_wrap(0, s131, rt.int_wrap(2, k138, 38))
  st(h, 0, w139)
  st(h, 8, s133)
  st(h, 16, s135)
  st(h, 24, s137)
}

/// h = f f modulo 2^256 - 38: 6 cross products once, doubled, plus the
/// 4 squares (10 products where fe64_mul makes 16).
fn fe64_sq(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let lo1 = rt.int_wrap(2, f0, f1)
  let hi2 = rt.u64_mul_hi(f0, f1)
  let lo3 = rt.int_wrap(2, f0, f2)
  let hi4 = rt.u64_mul_hi(f0, f2)
  let lo5 = rt.int_wrap(2, f0, f3)
  let hi6 = rt.u64_mul_hi(f0, f3)
  let lo7 = rt.int_wrap(2, f1, f2)
  let hi8 = rt.u64_mul_hi(f1, f2)
  let lo9 = rt.int_wrap(2, f1, f3)
  let hi10 = rt.u64_mul_hi(f1, f3)
  let lo11 = rt.int_wrap(2, f2, f3)
  let hi12 = rt.u64_mul_hi(f2, f3)
  let s13 = cpu.adc(lo3, hi2, 0)
  let k14 = cpu.adc_carry(lo3, hi2, 0)
  let s15 = cpu.adc(lo5, hi4, k14)
  let k16 = cpu.adc_carry(lo5, hi4, k14)
  let w17 = rt.int_wrap(0, hi6, k16)
  let s18 = cpu.adc(lo9, hi8, 0)
  let k19 = cpu.adc_carry(lo9, hi8, 0)
  let w20 = rt.int_wrap(0, hi10, k19)
  let s21 = cpu.adc(s15, lo7, 0)
  let k22 = cpu.adc_carry(s15, lo7, 0)
  let s23 = cpu.adc(w17, s18, k22)
  let k24 = cpu.adc_carry(w17, s18, k22)
  let s25 = cpu.adc(0, w20, k24)
  let k26 = cpu.adc_carry(0, w20, k24)
  let s27 = cpu.adc(s25, lo11, 0)
  let k28 = cpu.adc_carry(s25, lo11, 0)
  let s29 = cpu.adc(k26, hi12, k28)
  let k30 = cpu.adc_carry(k26, hi12, k28)
  let s31 = cpu.adc(lo1, lo1, 0)
  let k32 = cpu.adc_carry(lo1, lo1, 0)
  let s33 = cpu.adc(s13, s13, k32)
  let k34 = cpu.adc_carry(s13, s13, k32)
  let s35 = cpu.adc(s21, s21, k34)
  let k36 = cpu.adc_carry(s21, s21, k34)
  let s37 = cpu.adc(s23, s23, k36)
  let k38 = cpu.adc_carry(s23, s23, k36)
  let s39 = cpu.adc(s27, s27, k38)
  let k40 = cpu.adc_carry(s27, s27, k38)
  let s41 = cpu.adc(s29, s29, k40)
  let k42 = cpu.adc_carry(s29, s29, k40)
  let s43 = cpu.adc(k30, k30, k42)
  let lo44 = rt.int_wrap(2, f0, f0)
  let hi45 = rt.u64_mul_hi(f0, f0)
  let lo46 = rt.int_wrap(2, f1, f1)
  let hi47 = rt.u64_mul_hi(f1, f1)
  let lo48 = rt.int_wrap(2, f2, f2)
  let hi49 = rt.u64_mul_hi(f2, f2)
  let lo50 = rt.int_wrap(2, f3, f3)
  let hi51 = rt.u64_mul_hi(f3, f3)
  let s52 = cpu.adc(s31, hi45, 0)
  let k53 = cpu.adc_carry(s31, hi45, 0)
  let s54 = cpu.adc(s33, lo46, k53)
  let k55 = cpu.adc_carry(s33, lo46, k53)
  let s56 = cpu.adc(s35, hi47, k55)
  let k57 = cpu.adc_carry(s35, hi47, k55)
  let s58 = cpu.adc(s37, lo48, k57)
  let k59 = cpu.adc_carry(s37, lo48, k57)
  let s60 = cpu.adc(s39, hi49, k59)
  let k61 = cpu.adc_carry(s39, hi49, k59)
  let s62 = cpu.adc(s41, lo50, k61)
  let k63 = cpu.adc_carry(s41, lo50, k61)
  let s64 = cpu.adc(s43, hi51, k63)
  let lo65 = rt.int_wrap(2, s58, 38)
  let hi66 = rt.u64_mul_hi(s58, 38)
  let lo67 = rt.int_wrap(2, s60, 38)
  let hi68 = rt.u64_mul_hi(s60, 38)
  let lo69 = rt.int_wrap(2, s62, 38)
  let hi70 = rt.u64_mul_hi(s62, 38)
  let lo71 = rt.int_wrap(2, s64, 38)
  let hi72 = rt.u64_mul_hi(s64, 38)
  let s73 = cpu.adc(lo44, lo65, 0)
  let k74 = cpu.adc_carry(lo44, lo65, 0)
  let s75 = cpu.adc(s52, lo67, k74)
  let k76 = cpu.adc_carry(s52, lo67, k74)
  let s77 = cpu.adc(s54, lo69, k76)
  let k78 = cpu.adc_carry(s54, lo69, k76)
  let s79 = cpu.adc(s56, lo71, k78)
  let k80 = cpu.adc_carry(s56, lo71, k78)
  let s81 = cpu.adc(s75, hi66, 0)
  let k82 = cpu.adc_carry(s75, hi66, 0)
  let s83 = cpu.adc(s77, hi68, k82)
  let k84 = cpu.adc_carry(s77, hi68, k82)
  let s85 = cpu.adc(s79, hi70, k84)
  let k86 = cpu.adc_carry(s79, hi70, k84)
  let w87 = rt.int_wrap(0, hi72, k80)
  let w88 = rt.int_wrap(0, w87, k86)
  let t89 = rt.int_wrap(2, w88, 38)
  let s90 = cpu.adc(s73, t89, 0)
  let k91 = cpu.adc_carry(s73, t89, 0)
  let s92 = cpu.adc(s81, 0, k91)
  let k93 = cpu.adc_carry(s81, 0, k91)
  let s94 = cpu.adc(s83, 0, k93)
  let k95 = cpu.adc_carry(s83, 0, k93)
  let s96 = cpu.adc(s85, 0, k95)
  let k97 = cpu.adc_carry(s85, 0, k95)
  let w98 = rt.int_wrap(0, s90, rt.int_wrap(2, k97, 38))
  st(h, 0, w98)
  st(h, 8, s92)
  st(h, 16, s94)
  st(h, 24, s96)
}

/// h = f + g modulo 2^256 - 38.
fn fe64_add(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let s1 = cpu.adc(f0, g0, 0)
  let k2 = cpu.adc_carry(f0, g0, 0)
  let s3 = cpu.adc(f1, g1, k2)
  let k4 = cpu.adc_carry(f1, g1, k2)
  let s5 = cpu.adc(f2, g2, k4)
  let k6 = cpu.adc_carry(f2, g2, k4)
  let s7 = cpu.adc(f3, g3, k6)
  let k8 = cpu.adc_carry(f3, g3, k6)
  let t9 = rt.int_wrap(2, k8, 38)
  let s10 = cpu.adc(s1, t9, 0)
  let k11 = cpu.adc_carry(s1, t9, 0)
  let s12 = cpu.adc(s3, 0, k11)
  let k13 = cpu.adc_carry(s3, 0, k11)
  let s14 = cpu.adc(s5, 0, k13)
  let k15 = cpu.adc_carry(s5, 0, k13)
  let s16 = cpu.adc(s7, 0, k15)
  let k17 = cpu.adc_carry(s7, 0, k15)
  let w18 = rt.int_wrap(0, s10, rt.int_wrap(2, k17, 38))
  st(h, 0, w18)
  st(h, 8, s12)
  st(h, 16, s14)
  st(h, 24, s16)
}

/// h = f - g modulo 2^256 - 38.
fn fe64_sub(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let e1 = rt.int_wrap(1, f0, g0)
  let b2 = cpu.borrow(f0, g0)
  let e3 = rt.int_wrap(1, f1, g1)
  let d4 = rt.int_wrap(1, e3, b2)
  let b5 = cpu.borrow(f1, g1) | cpu.borrow(e3, b2)
  let e6 = rt.int_wrap(1, f2, g2)
  let d7 = rt.int_wrap(1, e6, b5)
  let b8 = cpu.borrow(f2, g2) | cpu.borrow(e6, b5)
  let e9 = rt.int_wrap(1, f3, g3)
  let d10 = rt.int_wrap(1, e9, b8)
  let b11 = cpu.borrow(f3, g3) | cpu.borrow(e9, b8)
  let t12 = rt.int_wrap(2, b11, 38)
  let e13 = rt.int_wrap(1, e1, t12)
  let b14 = cpu.borrow(e1, t12)
  let e15 = rt.int_wrap(1, d4, 0)
  let d16 = rt.int_wrap(1, e15, b14)
  let b17 = cpu.borrow(d4, 0) | cpu.borrow(e15, b14)
  let e18 = rt.int_wrap(1, d7, 0)
  let d19 = rt.int_wrap(1, e18, b17)
  let b20 = cpu.borrow(d7, 0) | cpu.borrow(e18, b17)
  let e21 = rt.int_wrap(1, d10, 0)
  let d22 = rt.int_wrap(1, e21, b20)
  let b23 = cpu.borrow(d10, 0) | cpu.borrow(e21, b20)
  let w24 = rt.int_wrap(1, e13, rt.int_wrap(2, b23, 38))
  st(h, 0, w24)
  st(h, 8, d16)
  st(h, 16, d19)
  st(h, 24, d22)
}

/// h = 121665 f modulo 2^256 - 38 (RFC 7748's a24).
fn fe64_mul121665(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let lo1 = rt.int_wrap(2, f0, 121665)
  let hi2 = rt.u64_mul_hi(f0, 121665)
  let lo3 = rt.int_wrap(2, f1, 121665)
  let hi4 = rt.u64_mul_hi(f1, 121665)
  let lo5 = rt.int_wrap(2, f2, 121665)
  let hi6 = rt.u64_mul_hi(f2, 121665)
  let lo7 = rt.int_wrap(2, f3, 121665)
  let hi8 = rt.u64_mul_hi(f3, 121665)
  let s9 = cpu.adc(lo3, hi2, 0)
  let k10 = cpu.adc_carry(lo3, hi2, 0)
  let s11 = cpu.adc(lo5, hi4, k10)
  let k12 = cpu.adc_carry(lo5, hi4, k10)
  let s13 = cpu.adc(lo7, hi6, k12)
  let k14 = cpu.adc_carry(lo7, hi6, k12)
  let w15 = rt.int_wrap(0, hi8, k14)
  let t16 = rt.int_wrap(2, w15, 38)
  let s17 = cpu.adc(lo1, t16, 0)
  let k18 = cpu.adc_carry(lo1, t16, 0)
  let s19 = cpu.adc(s9, 0, k18)
  let k20 = cpu.adc_carry(s9, 0, k18)
  let s21 = cpu.adc(s11, 0, k20)
  let k22 = cpu.adc_carry(s11, 0, k20)
  let s23 = cpu.adc(s13, 0, k22)
  let k24 = cpu.adc_carry(s13, 0, k22)
  let w25 = rt.int_wrap(0, s17, rt.int_wrap(2, k24, 38))
  st(h, 0, w25)
  st(h, 8, s19)
  st(h, 16, s21)
  st(h, 24, s23)
}

/// h = f reduced below p (the canonical value).
fn fe64_freeze(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let c1 = rt.int_wrap(4, f3, 63)
  let m2 = f3 & 9223372036854775807
  let t3 = rt.int_wrap(2, c1, 19)
  let s4 = cpu.adc(f0, t3, 0)
  let k5 = cpu.adc_carry(f0, t3, 0)
  let s6 = cpu.adc(f1, 0, k5)
  let k7 = cpu.adc_carry(f1, 0, k5)
  let s8 = cpu.adc(f2, 0, k7)
  let k9 = cpu.adc_carry(f2, 0, k7)
  let s10 = cpu.adc(m2, 0, k9)
  let s11 = cpu.adc(s4, 19, 0)
  let k12 = cpu.adc_carry(s4, 19, 0)
  let s13 = cpu.adc(s6, 0, k12)
  let k14 = cpu.adc_carry(s6, 0, k12)
  let s15 = cpu.adc(s8, 0, k14)
  let k16 = cpu.adc_carry(s8, 0, k14)
  let s17 = cpu.adc(s10, 0, k16)
  let mk18 = ct.mask_bit(rt.int_wrap(4, s17, 63))
  let x19 = ct.pick(mk18, s11, s4)
  let x20 = ct.pick(mk18, s13, s6)
  let x21 = ct.pick(mk18, s15, s8)
  let x22 = ct.pick(mk18, (s17 & 9223372036854775807), s10)
  st(h, 0, x19)
  st(h, 8, x20)
  st(h, 16, x21)
  st(h, 24, x22)
}
