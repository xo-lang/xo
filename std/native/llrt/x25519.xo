// X25519 (RFC 7748) for TLS's key exchange (work item B31, decision
// 0202), as Go's crypto/ecdh X25519: the scalar is clamped, the u
// coordinate's top bit ignored and a value of p or more taken modulo p.
// Constant time (decision 0222, ct.xo): RFC 7748's Montgomery ladder
// over every one of the 255 bits with masked swaps (ct.pick), on a
// field of four 64 bit limbs kept below 2^256 and reduced modulo 2^256 -
// 38 (generated by scripts/x25519fe64.py; sums on cpu.adc chains,
// decision 0231's addendum; no branch or index on a secret), and the
// inversion as a fixed power. A
// low order point gives all zeros; Go's ECDH reports that as an error,
// and the TLS layer must reject it. A public key ([scalar]9, base) is
// computed on the twisted Edwards curve instead, from a table of fixed
// multiples (x25519_btab.xo), about a third of the ladder's work.
use native/llrt/cpu
use native/llrt/ct
use native/llrt/ed25519
use native/llrt/x25519_btab
use native/rt

// byte offsets of the ladder's elements past ed25519.SPARE
const X1: Int = 0
const X2: Int = 40
const Z2: Int = 80
const X3: Int = 120
const Z3: Int = 160
const TA: Int = 200
const TB: Int = 240
const AA: Int = 280
const BB: Int = 320
const E: Int = 360
const TC: Int = 400
const TD: Int = 440
const S0: Int = 480
const S1: Int = 520
const S2: Int = 560
const S3: Int = 600
const S4: Int = 640
// the elements' words
const EXTRA: Int = 85
// base's elements past ed25519.SPARE (the ladder's S0 to S4 for the
// inversion): the selected entry (y + x, y - x, 2 d x y), the point
// (X : Y : Z : T), a completed point (ref10's p1p1), and temporaries
const PX: Int = 680
const MX: Int = 720
const XY: Int = 760
const NEG: Int = 800
const ZERO: Int = 840
const VX: Int = 880
const VY: Int = 920
const VZ: Int = 960
const VT: Int = 1000
const RX: Int = 1040
const RY: Int = 1080
const RZ: Int = 1120
const RT: Int = 1160
const T0: Int = 1200
// the clamped scalar's 4 words and its 64 signed digits, as raw words
// (no list: its length checks gave LLVM selects; TestConstantTimeLLVM)
const KW: Int = 1240
const DG: Int = 1272
const BEXTRA: Int = 230

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// Swaps elements f and g when mask is all ones, keeps them when 0.
fn cswap(f: Int, g: Int, mask: Int) {
  for i in 0..4 {
    let a = ld(f, 8 * i)
    let b = ld(g, 8 * i)
    st(f, 8 * i, ct.pick(mask, b, a))
    st(g, 8 * i, ct.pick(mask, a, b))
  }
}

/// The u coordinate of [scalar]point: scalar and point are 32 bytes each
/// (RFC 7748 5, X25519).
pub fn scalar_mult(scalar: Bytes, point: Bytes) -> Bytes {
  let w = ed25519.field_workspace(EXTRA)
  let m = ed25519.base(w)
  let e = m.wrapping_add(ed25519.SPARE)
  let x1 = e.wrapping_add(X1)
  let x2 = e.wrapping_add(X2)
  let z2 = e.wrapping_add(Z2)
  let x3 = e.wrapping_add(X3)
  let z3 = e.wrapping_add(Z3)
  let a = e.wrapping_add(TA)
  let b = e.wrapping_add(TB)
  let aa = e.wrapping_add(AA)
  let bb = e.wrapping_add(BB)
  let ee = e.wrapping_add(E)
  let c = e.wrapping_add(TC)
  let d = e.wrapping_add(TD)
  // clamped: the low three bits cleared, bit 255 cleared, bit 254 set
  let top = (1).wrapping_shl(63)
  let k = [rt.bytes_word(scalar, 0) & ~7, rt.bytes_word(scalar, 8), rt.bytes_word(scalar, 16), (rt.bytes_word(scalar, 24) & ~top) | (1).wrapping_shl(62)]
  // u's top bit ignored; a value of p or more works as it is (below
  // 2^255, reduced on the way)
  st(x1, 0, rt.bytes_word(point, 0))
  st(x1, 8, rt.bytes_word(point, 8))
  st(x1, 16, rt.bytes_word(point, 16))
  st(x1, 24, rt.bytes_word(point, 24) & ~top)
  fe64_set(x2, 1)
  fe64_set(z2, 0)
  rt.mem_copy(x3, x1, 32)
  fe64_set(z3, 1)
  var swap = 0
  var t = 254
  while t >= 0 {
    let bit = k[t / 64].shr_logical(t % 64) & 1
    let mask = ct.mask_bit(swap ^ bit)
    cswap(x2, x3, mask)
    cswap(z2, z3, mask)
    swap = bit
    fe64_add(a, x2, z2)
    fe64_sq(aa, a)
    fe64_sub(b, x2, z2)
    fe64_sq(bb, b)
    fe64_sub(ee, aa, bb)
    fe64_add(c, x3, z3)
    fe64_sub(d, x3, z3)
    fe64_mul(d, d, a) // DA
    fe64_mul(c, c, b) // CB
    fe64_add(x3, d, c)
    fe64_sq(x3, x3)
    fe64_sub(z3, d, c)
    fe64_sq(z3, z3)
    fe64_mul(z3, z3, x1)
    fe64_mul(x2, aa, bb)
    fe64_mul121665(z2, ee)
    fe64_add(z2, z2, aa)
    fe64_mul(z2, z2, ee)
    t -= 1
  }
  let mask = ct.mask_bit(swap)
  cswap(x2, x3, mask)
  cswap(z2, z3, mask)
  fe64_inv(z2, z2, e.wrapping_add(S0), e.wrapping_add(S1), e.wrapping_add(S2), e.wrapping_add(S3), e.wrapping_add(S4))
  fe64_mul(x2, x2, z2)
  fe64_freeze(x2, x2)
  var s = rt.rs_with_cap(32)
  for i in 0..4 {
    s = rt.rs_push_word(s, ld(x2, 8 * i), 8)
  }
  keep(w)
  s.bytes()
}

/// h = the small value v.
fn fe64_set(h: Int, v: Int) {
  st(h, 0, v)
  st(h, 8, 0)
  st(h, 16, 0)
  st(h, 24, 0)
}

/// h = f^(2^k), k at least 1 (h may be f).
fn fe64_sqn(h: Int, f: Int, k: Int) {
  fe64_sq(h, f)
  var i = 1
  while i < k {
    fe64_sq(h, h)
    i += 1
  }
}

/// h = z^(p - 2) = z^(2^255 - 21) = 1/z (0 for 0), the fixed chain of
/// 254 squarings and 11 products (ref10's), in the scratch elements
/// s0 to s4; h may be z.
fn fe64_inv(h: Int, z: Int, s0: Int, s1: Int, s2: Int, s3: Int, s4: Int) {
  fe64_sq(s0, z) // z^2
  fe64_sqn(s3, s0, 2) // z^8
  fe64_mul(s1, s3, z) // z^9
  fe64_mul(s2, s1, s0) // z^11
  fe64_sq(s3, s2) // z^22
  fe64_mul(s1, s3, s1) // z^(2^5 - 1)
  fe64_sqn(s3, s1, 5)
  fe64_mul(s1, s3, s1) // z^(2^10 - 1)
  fe64_sqn(s3, s1, 10)
  fe64_mul(s4, s3, s1) // z^(2^20 - 1)
  fe64_sqn(s3, s4, 20)
  fe64_mul(s3, s3, s4) // z^(2^40 - 1)
  fe64_sqn(s3, s3, 10)
  fe64_mul(s1, s3, s1) // z^(2^50 - 1)
  fe64_sqn(s3, s1, 50)
  fe64_mul(s4, s3, s1) // z^(2^100 - 1)
  fe64_sqn(s3, s4, 100)
  fe64_mul(s3, s3, s4) // z^(2^200 - 1)
  fe64_sqn(s3, s3, 50)
  fe64_mul(s3, s3, s1) // z^(2^250 - 1)
  fe64_sqn(s3, s3, 5) // z^(2^255 - 2^5)
  fe64_mul(h, s3, s2) // z^(2^255 - 21)
}

/// The public key of scalar: [scalar]9 (RFC 7748 6.1), as Go's
/// edwards25519 ScalarBaseMult then the map to Montgomery u: the clamped
/// scalar's 64 signed radix 16 digits d (in -8 to 7, the last up to 8),
/// each digit's multiple of 16^i B taken from x25519_btab.xo's 8 entries
/// of 256^(i/2) B under masks (negated by a masked swap and a masked
/// negation), the odd digits added first, then 4 doublings, then the
/// even ones: 64 mixed additions and 4 doublings, then u = (Z + Y) / (Z -
/// Y). Constant time in the scalar as scalar_mult; about 120,000
/// instructions where the ladder took 390,000 (2026-10-18).
pub fn base(scalar: Bytes) -> Bytes {
  let w = ed25519.field_workspace(BEXTRA)
  let m = ed25519.base(w)
  let e = m.wrapping_add(ed25519.SPARE)
  let tb = rt.obj_addr(x25519_btab.BTAB).wrapping_add(rt.layout(2))
  // clamped as scalar_mult
  let top = (1).wrapping_shl(63)
  let kw = at(e, KW)
  st(kw, 0, rt.bytes_word(scalar, 0) & ~7)
  st(kw, 8, rt.bytes_word(scalar, 8))
  st(kw, 16, rt.bytes_word(scalar, 16))
  st(kw, 24, (rt.bytes_word(scalar, 24) & ~top) | (1).wrapping_shl(62))
  // the signed radix 16 digits; secret values by wrapping arithmetic
  // only (decision 0222: a checked + or - is a branch on its operands),
  // offsets too (public, but a checked product's fault path is code
  // with selects)
  let dg = at(e, DG)
  var i = 0
  while i < 64 {
    let wv = ld(kw, i.shr_logical(4).wrapping_shl(3))
    st(dg, i.wrapping_shl(3), wv.shr_logical((i & 15).wrapping_shl(2)) & 15)
    i = i.wrapping_add(1)
  }
  i = 0
  while i < 63 {
    let at_i = i.wrapping_shl(3)
    let x = ld(dg, at_i)
    let carry = x.wrapping_add(8).shr_logical(4)
    st(dg, at_i, x.wrapping_sub(carry.wrapping_shl(4)))
    st(dg, at_i.wrapping_add(8), ld(dg, at_i.wrapping_add(8)).wrapping_add(carry))
    i = i.wrapping_add(1)
  }
  fe64_set(at(e, ZERO), 0)
  // the identity (0 : 1 : 1 : 0)
  fe64_set(at(e, VX), 0)
  fe64_set(at(e, VY), 1)
  fe64_set(at(e, VZ), 1)
  fe64_set(at(e, VT), 0)
  i = 1
  while i < 64 {
    madd_digit(e, tb, i.shr_logical(1), ld(dg, i.wrapping_shl(3)))
    i = i.wrapping_add(2)
  }
  dbl(e)
  dbl(e)
  dbl(e)
  dbl(e)
  i = 0
  while i < 64 {
    madd_digit(e, tb, i.shr_logical(1), ld(dg, i.wrapping_shl(3)))
    i = i.wrapping_add(2)
  }
  let u = at(e, RX)
  let z = at(e, RY)
  fe64_add(u, at(e, VZ), at(e, VY))
  fe64_sub(z, at(e, VZ), at(e, VY))
  fe64_inv(z, z, at(e, S0), at(e, S1), at(e, S2), at(e, S3), at(e, S4))
  fe64_mul(u, u, z)
  fe64_freeze(u, u)
  var s = rt.rs_with_cap(32)
  s = rt.rs_push_word(s, ld(u, 0), 8)
  s = rt.rs_push_word(s, ld(u, 8), 8)
  s = rt.rs_push_word(s, ld(u, 16), 8)
  s = rt.rs_push_word(s, ld(u, 24), 8)
  keep(w)
  s.bytes()
}

fn at(e: Int, off: Int) -> Int { e.wrapping_add(off) }

/// Adds to base's point the multiple d 256^row B (d in -8 to 8), chosen
/// from the table tb under masks: the identity entry (1, 1, 0) for 0, a
/// negative digit's entry with y + x and y - x swapped and 2 d x y
/// negated. ref10's ge_madd, then the completed point to (X : Y : Z : T).
fn madd_digit(e: Int, tb: Int, row: Int, d: Int) {
  let sg = ct.mask_bit(d.shr_logical(63))
  let a = (d ^ sg).wrapping_sub(sg)
  var p0 = 0
  var p1 = 0
  var p2 = 0
  var p3 = 0
  var m0 = 0
  var m1 = 0
  var m2 = 0
  var m3 = 0
  var t0 = 0
  var t1 = 0
  var t2 = 0
  var t3 = 0
  var j = 1
  while j < 9 {
    let msk = ct.mask_eq(j, a)
    // the entry's offset by wrapping arithmetic too (public, below 2^15:
    // no overflow check, whose fault path LLVM gave a select)
    let en = tb.wrapping_add(row.wrapping_mul(8).wrapping_add(j.wrapping_sub(1)).wrapping_mul(96))
    p0 = p0 | (ld(en, 0) & msk)
    p1 = p1 | (ld(en, 8) & msk)
    p2 = p2 | (ld(en, 16) & msk)
    p3 = p3 | (ld(en, 24) & msk)
    m0 = m0 | (ld(en, 32) & msk)
    m1 = m1 | (ld(en, 40) & msk)
    m2 = m2 | (ld(en, 48) & msk)
    m3 = m3 | (ld(en, 56) & msk)
    t0 = t0 | (ld(en, 64) & msk)
    t1 = t1 | (ld(en, 72) & msk)
    t2 = t2 | (ld(en, 80) & msk)
    t3 = t3 | (ld(en, 88) & msk)
    j += 1
  }
  let zm = ct.mask_eq(0, a)
  p0 = p0 | (1 & zm)
  m0 = m0 | (1 & zm)
  let px = at(e, PX)
  let mx = at(e, MX)
  let xy = at(e, XY)
  st(px, 0, ct.pick(sg, m0, p0))
  st(px, 8, ct.pick(sg, m1, p1))
  st(px, 16, ct.pick(sg, m2, p2))
  st(px, 24, ct.pick(sg, m3, p3))
  st(mx, 0, ct.pick(sg, p0, m0))
  st(mx, 8, ct.pick(sg, p1, m1))
  st(mx, 16, ct.pick(sg, p2, m2))
  st(mx, 24, ct.pick(sg, p3, m3))
  st(xy, 0, t0)
  st(xy, 8, t1)
  st(xy, 16, t2)
  st(xy, 24, t3)
  let ng = at(e, NEG)
  fe64_sub(ng, at(e, ZERO), xy)
  for b in 0..4 {
    st(xy, 8 * b, ct.pick(sg, ld(ng, 8 * b), ld(xy, 8 * b)))
  }
  let rx = at(e, RX)
  let ry = at(e, RY)
  let rz = at(e, RZ)
  let rtt = at(e, RT)
  let tz = at(e, T0)
  fe64_add(rx, at(e, VY), at(e, VX))
  fe64_sub(ry, at(e, VY), at(e, VX))
  fe64_mul(rz, rx, px)
  fe64_mul(ry, ry, mx)
  fe64_mul(rtt, xy, at(e, VT))
  fe64_add(tz, at(e, VZ), at(e, VZ))
  fe64_sub(rx, rz, ry)
  fe64_add(ry, rz, ry)
  fe64_add(rz, tz, rtt)
  fe64_sub(rtt, tz, rtt)
  p1p1_to_p3(e)
}

/// Doubles base's point: ref10's ge_p2_dbl, then the completed point to
/// (X : Y : Z : T).
fn dbl(e: Int) {
  let rx = at(e, RX)
  let ry = at(e, RY)
  let rz = at(e, RZ)
  let rtt = at(e, RT)
  let tz = at(e, T0)
  fe64_sq(rx, at(e, VX))
  fe64_sq(rz, at(e, VY))
  fe64_sq(rtt, at(e, VZ))
  fe64_add(rtt, rtt, rtt)
  fe64_add(ry, at(e, VX), at(e, VY))
  fe64_sq(tz, ry)
  fe64_add(ry, rz, rx)
  fe64_sub(rz, rz, rx)
  fe64_sub(rx, tz, ry)
  fe64_sub(rtt, rtt, rz)
  p1p1_to_p3(e)
}

/// base's completed point (RX : RY : RZ : RT, ref10's p1p1) to its
/// point: X = RX RT, Y = RY RZ, Z = RZ RT, T = RX RY.
fn p1p1_to_p3(e: Int) {
  let rx = at(e, RX)
  let ry = at(e, RY)
  let rz = at(e, RZ)
  let rtt = at(e, RT)
  fe64_mul(at(e, VX), rx, rtt)
  fe64_mul(at(e, VY), ry, rz)
  fe64_mul(at(e, VZ), rz, rtt)
  fe64_mul(at(e, VT), rx, ry)
}

/// The workspace is alive up to here (ed25519.xo's keep).
fn keep(w: List[Int]) {
  if w.len() < 0 {
    return
  }
}

/// internal.crypto_op's "x25519." ops (std/internal.xo): mult (scalar
/// a, point b; all zeros for a low order point) and base (scalar a).
/// None if unknown.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  match what {
    "mult" => scalar_mult(a, b)
    "base" => base(a)
    _ => None
  }
}

// ---------------------------------------------------------------------------
// The field on 64 bit limbs, generated by scripts/x25519fe64.py: do not edit

/// h = f g modulo 2^256 - 38 (f, g below 2^256): the 512 bit product's
/// high half times 38 added to its low half.
fn fe64_mul(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let lo1 = f0.wrapping_mul(g0)
  let lo2 = f1.wrapping_mul(g0)
  let hi3 = f0.mul_hi_unsigned(g0)
  let s4 = cpu.adc(lo2, hi3, 0)
  let k5 = cpu.adc_carry(lo2, hi3, 0)
  let lo6 = f2.wrapping_mul(g0)
  let hi7 = f1.mul_hi_unsigned(g0)
  let s8 = cpu.adc(lo6, hi7, k5)
  let k9 = cpu.adc_carry(lo6, hi7, k5)
  let lo10 = f3.wrapping_mul(g0)
  let hi11 = f2.mul_hi_unsigned(g0)
  let s12 = cpu.adc(lo10, hi11, k9)
  let k13 = cpu.adc_carry(lo10, hi11, k9)
  let hi14 = f3.mul_hi_unsigned(g0)
  let s15 = cpu.adc(0, hi14, k13)
  let lo16 = f0.wrapping_mul(g1)
  let s17 = cpu.adc(s4, lo16, 0)
  let k18 = cpu.adc_carry(s4, lo16, 0)
  let lo19 = f1.wrapping_mul(g1)
  let s20 = cpu.adc(s8, lo19, k18)
  let k21 = cpu.adc_carry(s8, lo19, k18)
  let lo22 = f2.wrapping_mul(g1)
  let s23 = cpu.adc(s12, lo22, k21)
  let k24 = cpu.adc_carry(s12, lo22, k21)
  let lo25 = f3.wrapping_mul(g1)
  let s26 = cpu.adc(s15, lo25, k24)
  let k27 = cpu.adc_carry(s15, lo25, k24)
  let hi28 = f0.mul_hi_unsigned(g1)
  let s29 = cpu.adc(s20, hi28, 0)
  let k30 = cpu.adc_carry(s20, hi28, 0)
  let hi31 = f1.mul_hi_unsigned(g1)
  let s32 = cpu.adc(s23, hi31, k30)
  let k33 = cpu.adc_carry(s23, hi31, k30)
  let hi34 = f2.mul_hi_unsigned(g1)
  let s35 = cpu.adc(s26, hi34, k33)
  let k36 = cpu.adc_carry(s26, hi34, k33)
  let hi37 = f3.mul_hi_unsigned(g1)
  let s38 = cpu.adc(k27, hi37, k36)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let lo39 = f0.wrapping_mul(g2)
  let s40 = cpu.adc(s29, lo39, 0)
  let k41 = cpu.adc_carry(s29, lo39, 0)
  let lo42 = f1.wrapping_mul(g2)
  let s43 = cpu.adc(s32, lo42, k41)
  let k44 = cpu.adc_carry(s32, lo42, k41)
  let lo45 = f2.wrapping_mul(g2)
  let s46 = cpu.adc(s35, lo45, k44)
  let k47 = cpu.adc_carry(s35, lo45, k44)
  let lo48 = f3.wrapping_mul(g2)
  let s49 = cpu.adc(s38, lo48, k47)
  let k50 = cpu.adc_carry(s38, lo48, k47)
  let hi51 = f0.mul_hi_unsigned(g2)
  let s52 = cpu.adc(s43, hi51, 0)
  let k53 = cpu.adc_carry(s43, hi51, 0)
  let hi54 = f1.mul_hi_unsigned(g2)
  let s55 = cpu.adc(s46, hi54, k53)
  let k56 = cpu.adc_carry(s46, hi54, k53)
  let hi57 = f2.mul_hi_unsigned(g2)
  let s58 = cpu.adc(s49, hi57, k56)
  let k59 = cpu.adc_carry(s49, hi57, k56)
  let hi60 = f3.mul_hi_unsigned(g2)
  let s61 = cpu.adc(k50, hi60, k59)
  let lo62 = f0.wrapping_mul(g3)
  let s63 = cpu.adc(s52, lo62, 0)
  let k64 = cpu.adc_carry(s52, lo62, 0)
  let lo65 = f1.wrapping_mul(g3)
  let s66 = cpu.adc(s55, lo65, k64)
  let k67 = cpu.adc_carry(s55, lo65, k64)
  let lo68 = f2.wrapping_mul(g3)
  let s69 = cpu.adc(s58, lo68, k67)
  let k70 = cpu.adc_carry(s58, lo68, k67)
  let lo71 = f3.wrapping_mul(g3)
  let s72 = cpu.adc(s61, lo71, k70)
  let k73 = cpu.adc_carry(s61, lo71, k70)
  let hi74 = f0.mul_hi_unsigned(g3)
  let s75 = cpu.adc(s66, hi74, 0)
  let k76 = cpu.adc_carry(s66, hi74, 0)
  let hi77 = f1.mul_hi_unsigned(g3)
  let s78 = cpu.adc(s69, hi77, k76)
  let k79 = cpu.adc_carry(s69, hi77, k76)
  let hi80 = f2.mul_hi_unsigned(g3)
  let s81 = cpu.adc(s72, hi80, k79)
  let k82 = cpu.adc_carry(s72, hi80, k79)
  let hi83 = f3.mul_hi_unsigned(g3)
  let s84 = cpu.adc(k73, hi83, k82)
  let lo85 = s75.wrapping_mul(38)
  let s86 = cpu.adc(lo1, lo85, 0)
  let k87 = cpu.adc_carry(lo1, lo85, 0)
  let lo88 = s78.wrapping_mul(38)
  let s89 = cpu.adc(s17, lo88, k87)
  let k90 = cpu.adc_carry(s17, lo88, k87)
  let lo91 = s81.wrapping_mul(38)
  let s92 = cpu.adc(s40, lo91, k90)
  let k93 = cpu.adc_carry(s40, lo91, k90)
  let lo94 = s84.wrapping_mul(38)
  let s95 = cpu.adc(s63, lo94, k93)
  let k96 = cpu.adc_carry(s63, lo94, k93)
  let hi97 = s84.mul_hi_unsigned(38)
  let hi98 = s75.mul_hi_unsigned(38)
  let s99 = cpu.adc(s89, hi98, 0)
  let k100 = cpu.adc_carry(s89, hi98, 0)
  let hi101 = s78.mul_hi_unsigned(38)
  let s102 = cpu.adc(s92, hi101, k100)
  let k103 = cpu.adc_carry(s92, hi101, k100)
  let hi104 = s81.mul_hi_unsigned(38)
  let s105 = cpu.adc(s95, hi104, k103)
  let k106 = cpu.adc_carry(s95, hi104, k103)
  let s107 = cpu.adc(hi97, k96, k106)
  let t108 = rt.ct_barrier(s107).wrapping_mul(38)
  let s109 = cpu.adc(s86, t108, 0)
  let k110 = cpu.adc_carry(s86, t108, 0)
  let s111 = cpu.adc(s99, 0, k110)
  let k112 = cpu.adc_carry(s99, 0, k110)
  let s113 = cpu.adc(s102, 0, k112)
  let k114 = cpu.adc_carry(s102, 0, k112)
  let s115 = cpu.adc(s105, 0, k114)
  let k116 = cpu.adc_carry(s105, 0, k114)
  let w117 = s109.wrapping_add(rt.ct_barrier(k116).wrapping_mul(38))
  st(h, 0, w117)
  st(h, 8, s111)
  st(h, 16, s113)
  st(h, 24, s115)
}

/// h = f f modulo 2^256 - 38: 6 cross products once, doubled, plus the
/// 4 squares (10 products where fe64_mul makes 16).
fn fe64_sq(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let lo1 = f0.wrapping_mul(f1)
  let lo2 = f0.wrapping_mul(f2)
  let hi3 = f0.mul_hi_unsigned(f1)
  let s4 = cpu.adc(lo2, hi3, 0)
  let k5 = cpu.adc_carry(lo2, hi3, 0)
  let lo6 = f0.wrapping_mul(f3)
  let hi7 = f0.mul_hi_unsigned(f2)
  let s8 = cpu.adc(lo6, hi7, k5)
  let k9 = cpu.adc_carry(lo6, hi7, k5)
  let hi10 = f0.mul_hi_unsigned(f3)
  let s11 = cpu.adc(0, hi10, k9)
  let lo12 = f1.wrapping_mul(f2)
  let lo13 = f1.wrapping_mul(f3)
  let hi14 = f1.mul_hi_unsigned(f2)
  let s15 = cpu.adc(lo13, hi14, 0)
  let k16 = cpu.adc_carry(lo13, hi14, 0)
  let hi17 = f1.mul_hi_unsigned(f3)
  let lo18 = f2.wrapping_mul(f3)
  let s19 = cpu.adc(hi17, lo18, k16)
  let k20 = cpu.adc_carry(hi17, lo18, k16)
  let hi21 = f2.mul_hi_unsigned(f3)
  let s22 = cpu.adc(0, hi21, k20)
  let s23 = cpu.adc(s8, lo12, 0)
  let k24 = cpu.adc_carry(s8, lo12, 0)
  let s25 = cpu.adc(s11, s15, k24)
  let k26 = cpu.adc_carry(s11, s15, k24)
  let s27 = cpu.adc(0, s19, k26)
  let k28 = cpu.adc_carry(0, s19, k26)
  let s29 = cpu.adc(0, s22, k28)
  let s30 = cpu.adc(lo1, lo1, 0)
  let k31 = cpu.adc_carry(lo1, lo1, 0)
  let s32 = cpu.adc(s4, s4, k31)
  let k33 = cpu.adc_carry(s4, s4, k31)
  let s34 = cpu.adc(s23, s23, k33)
  let k35 = cpu.adc_carry(s23, s23, k33)
  let s36 = cpu.adc(s25, s25, k35)
  let k37 = cpu.adc_carry(s25, s25, k35)
  let s38 = cpu.adc(s27, s27, k37)
  let k39 = cpu.adc_carry(s27, s27, k37)
  let s40 = cpu.adc(s29, s29, k39)
  let k41 = cpu.adc_carry(s29, s29, k39)
  let lo42 = f0.wrapping_mul(f0)
  let hi43 = f0.mul_hi_unsigned(f0)
  let s44 = cpu.adc(s30, hi43, 0)
  let k45 = cpu.adc_carry(s30, hi43, 0)
  let lo46 = f1.wrapping_mul(f1)
  let s47 = cpu.adc(s32, lo46, k45)
  let k48 = cpu.adc_carry(s32, lo46, k45)
  let hi49 = f1.mul_hi_unsigned(f1)
  let s50 = cpu.adc(s34, hi49, k48)
  let k51 = cpu.adc_carry(s34, hi49, k48)
  let lo52 = f2.wrapping_mul(f2)
  let s53 = cpu.adc(s36, lo52, k51)
  let k54 = cpu.adc_carry(s36, lo52, k51)
  let hi55 = f2.mul_hi_unsigned(f2)
  let s56 = cpu.adc(s38, hi55, k54)
  let k57 = cpu.adc_carry(s38, hi55, k54)
  let lo58 = f3.wrapping_mul(f3)
  let s59 = cpu.adc(s40, lo58, k57)
  let k60 = cpu.adc_carry(s40, lo58, k57)
  let hi61 = f3.mul_hi_unsigned(f3)
  let s62 = cpu.adc(k41, hi61, k60)
  let lo63 = s53.wrapping_mul(38)
  let s64 = cpu.adc(lo42, lo63, 0)
  let k65 = cpu.adc_carry(lo42, lo63, 0)
  let lo66 = s56.wrapping_mul(38)
  let s67 = cpu.adc(s44, lo66, k65)
  let k68 = cpu.adc_carry(s44, lo66, k65)
  let lo69 = s59.wrapping_mul(38)
  let s70 = cpu.adc(s47, lo69, k68)
  let k71 = cpu.adc_carry(s47, lo69, k68)
  let lo72 = s62.wrapping_mul(38)
  let s73 = cpu.adc(s50, lo72, k71)
  let k74 = cpu.adc_carry(s50, lo72, k71)
  let hi75 = s62.mul_hi_unsigned(38)
  let hi76 = s53.mul_hi_unsigned(38)
  let s77 = cpu.adc(s67, hi76, 0)
  let k78 = cpu.adc_carry(s67, hi76, 0)
  let hi79 = s56.mul_hi_unsigned(38)
  let s80 = cpu.adc(s70, hi79, k78)
  let k81 = cpu.adc_carry(s70, hi79, k78)
  let hi82 = s59.mul_hi_unsigned(38)
  let s83 = cpu.adc(s73, hi82, k81)
  let k84 = cpu.adc_carry(s73, hi82, k81)
  let s85 = cpu.adc(hi75, k74, k84)
  let t86 = rt.ct_barrier(s85).wrapping_mul(38)
  let s87 = cpu.adc(s64, t86, 0)
  let k88 = cpu.adc_carry(s64, t86, 0)
  let s89 = cpu.adc(s77, 0, k88)
  let k90 = cpu.adc_carry(s77, 0, k88)
  let s91 = cpu.adc(s80, 0, k90)
  let k92 = cpu.adc_carry(s80, 0, k90)
  let s93 = cpu.adc(s83, 0, k92)
  let k94 = cpu.adc_carry(s83, 0, k92)
  let w95 = s87.wrapping_add(rt.ct_barrier(k94).wrapping_mul(38))
  st(h, 0, w95)
  st(h, 8, s89)
  st(h, 16, s91)
  st(h, 24, s93)
}

/// h = f + g modulo 2^256 - 38.
fn fe64_add(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let s1 = cpu.adc(f0, g0, 0)
  let k2 = cpu.adc_carry(f0, g0, 0)
  let s3 = cpu.adc(f1, g1, k2)
  let k4 = cpu.adc_carry(f1, g1, k2)
  let s5 = cpu.adc(f2, g2, k4)
  let k6 = cpu.adc_carry(f2, g2, k4)
  let s7 = cpu.adc(f3, g3, k6)
  let k8 = cpu.adc_carry(f3, g3, k6)
  let t9 = rt.ct_barrier(k8).wrapping_mul(38)
  let s10 = cpu.adc(s1, t9, 0)
  let k11 = cpu.adc_carry(s1, t9, 0)
  let s12 = cpu.adc(s3, 0, k11)
  let k13 = cpu.adc_carry(s3, 0, k11)
  let s14 = cpu.adc(s5, 0, k13)
  let k15 = cpu.adc_carry(s5, 0, k13)
  let s16 = cpu.adc(s7, 0, k15)
  let k17 = cpu.adc_carry(s7, 0, k15)
  let w18 = s10.wrapping_add(rt.ct_barrier(k17).wrapping_mul(38))
  st(h, 0, w18)
  st(h, 8, s12)
  st(h, 16, s14)
  st(h, 24, s16)
}

/// h = f - g modulo 2^256 - 38.
fn fe64_sub(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let e1 = f0.wrapping_sub(g0)
  let b2 = cpu.borrow(f0, g0)
  let e3 = f1.wrapping_sub(g1)
  let d4 = e3.wrapping_sub(b2)
  let b5 = cpu.borrow(f1, g1) | cpu.borrow(e3, b2)
  let e6 = f2.wrapping_sub(g2)
  let d7 = e6.wrapping_sub(b5)
  let b8 = cpu.borrow(f2, g2) | cpu.borrow(e6, b5)
  let e9 = f3.wrapping_sub(g3)
  let d10 = e9.wrapping_sub(b8)
  let b11 = cpu.borrow(f3, g3) | cpu.borrow(e9, b8)
  let t12 = rt.ct_barrier(b11).wrapping_mul(38)
  let e13 = e1.wrapping_sub(t12)
  let b14 = cpu.borrow(e1, t12)
  let e15 = d4.wrapping_sub(0)
  let d16 = e15.wrapping_sub(b14)
  let b17 = cpu.borrow(d4, 0) | cpu.borrow(e15, b14)
  let e18 = d7.wrapping_sub(0)
  let d19 = e18.wrapping_sub(b17)
  let b20 = cpu.borrow(d7, 0) | cpu.borrow(e18, b17)
  let e21 = d10.wrapping_sub(0)
  let d22 = e21.wrapping_sub(b20)
  let b23 = cpu.borrow(d10, 0) | cpu.borrow(e21, b20)
  let w24 = e13.wrapping_sub(rt.ct_barrier(b23).wrapping_mul(38))
  st(h, 0, w24)
  st(h, 8, d16)
  st(h, 16, d19)
  st(h, 24, d22)
}

/// h = 121665 f modulo 2^256 - 38 (RFC 7748's a24).
fn fe64_mul121665(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let lo1 = f0.wrapping_mul(121665)
  let hi2 = f0.mul_hi_unsigned(121665)
  let lo3 = f1.wrapping_mul(121665)
  let hi4 = f1.mul_hi_unsigned(121665)
  let lo5 = f2.wrapping_mul(121665)
  let hi6 = f2.mul_hi_unsigned(121665)
  let lo7 = f3.wrapping_mul(121665)
  let hi8 = f3.mul_hi_unsigned(121665)
  let s9 = cpu.adc(lo3, hi2, 0)
  let k10 = cpu.adc_carry(lo3, hi2, 0)
  let s11 = cpu.adc(lo5, hi4, k10)
  let k12 = cpu.adc_carry(lo5, hi4, k10)
  let s13 = cpu.adc(lo7, hi6, k12)
  let k14 = cpu.adc_carry(lo7, hi6, k12)
  let w15 = hi8.wrapping_add(k14)
  let t16 = rt.ct_barrier(w15).wrapping_mul(38)
  let s17 = cpu.adc(lo1, t16, 0)
  let k18 = cpu.adc_carry(lo1, t16, 0)
  let s19 = cpu.adc(s9, 0, k18)
  let k20 = cpu.adc_carry(s9, 0, k18)
  let s21 = cpu.adc(s11, 0, k20)
  let k22 = cpu.adc_carry(s11, 0, k20)
  let s23 = cpu.adc(s13, 0, k22)
  let k24 = cpu.adc_carry(s13, 0, k22)
  let w25 = s17.wrapping_add(rt.ct_barrier(k24).wrapping_mul(38))
  st(h, 0, w25)
  st(h, 8, s19)
  st(h, 16, s21)
  st(h, 24, s23)
}

/// h = f reduced below p (the canonical value).
fn fe64_freeze(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let c1 = f3.shr_logical(63)
  let m2 = f3 & 9223372036854775807
  let t3 = c1.wrapping_mul(19)
  let s4 = cpu.adc(f0, t3, 0)
  let k5 = cpu.adc_carry(f0, t3, 0)
  let s6 = cpu.adc(f1, 0, k5)
  let k7 = cpu.adc_carry(f1, 0, k5)
  let s8 = cpu.adc(f2, 0, k7)
  let k9 = cpu.adc_carry(f2, 0, k7)
  let s10 = cpu.adc(m2, 0, k9)
  let s11 = cpu.adc(s4, 19, 0)
  let k12 = cpu.adc_carry(s4, 19, 0)
  let s13 = cpu.adc(s6, 0, k12)
  let k14 = cpu.adc_carry(s6, 0, k12)
  let s15 = cpu.adc(s8, 0, k14)
  let k16 = cpu.adc_carry(s8, 0, k14)
  let s17 = cpu.adc(s10, 0, k16)
  let mk18 = ct.mask_bit(s17.shr_logical(63))
  let x19 = ct.pick(mk18, s11, s4)
  let x20 = ct.pick(mk18, s13, s6)
  let x21 = ct.pick(mk18, s15, s8)
  let x22 = ct.pick(mk18, (s17 & 9223372036854775807), s10)
  st(h, 0, x19)
  st(h, 8, x20)
  st(h, 16, x21)
  st(h, 24, x22)
}
