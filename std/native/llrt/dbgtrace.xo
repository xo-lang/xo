// The tracer thread of `xo debug` on Linux (decision 0253 stage 6): ptrace
// takes a request only from the thread that attached (the tracer), and a
// fiber may run on another worker after any park, so every ptrace and
// wait4 call of a debuggee is made by one OS thread of its own, started
// with the debuggee (pool.thread_start of cabi_dbg.xo's dbg_tracer). The
// caller and that thread meet in a mailbox (heap_large, MB_SIZE bytes):
//   0 state (a futex word: 0 idle, 1 a request, 2 its result, 3 stop,
//   4 stopped), 8 the system call's number, 16 to 56 its six arguments,
//   64 its result.
// One session makes one call at a time, so one mailbox needs no lock.
//
// Windows has the same rule for its debugging functions (the thread that
// started or attached to the debuggee waits for and continues its
// events), so dbgwin.xo uses this thread too, with an operation's number
// (the OP_ constants) in place of the system call's.
use native/llrt/pool
use native/llrt/windows
use native/rt
use native/sys_windows

const ST = 0
const NR = 8
const ARGS = 16
const RES = 64
pub const MB_SIZE = 72

const SEQ_CST = 4

/// Windows' operations (dbgwin.xo): windows.create_at of the arguments
/// at a (0 or the Win32 error); WaitForDebugEventEx(a, b),
/// ContinueDebugEvent(a, b, c) and DebugActiveProcessStop(a), each
/// nonzero on success; DebugActiveProcess(a): 1, or minus the Win32
/// error.
pub const OP_CREATE = 1
pub const OP_WAIT_EVENT = 2
pub const OP_CONTINUE = 3
pub const OP_ATTACH = 4
pub const OP_DETACH = 5

fn op(nr: Int, a: Int, b: Int, c: Int) -> Int {
  if nr == OP_CREATE {
    return windows.create_at(a)
  }
  if nr == OP_WAIT_EVENT {
    return Int(sys_windows.WaitForDebugEventEx(a, b))
  }
  if nr == OP_CONTINUE {
    return Int(sys_windows.ContinueDebugEvent(a, b, c))
  }
  if nr == OP_ATTACH {
    // minus the Win32 error when it fails
    if Int(sys_windows.DebugActiveProcess(a)) != 0 {
      return 1
    }
    return -Int(sys_windows.GetLastError())
  }
  if nr == OP_DETACH {
    return Int(sys_windows.DebugActiveProcessStop(a))
  }
  0
}

/// The tracer thread's loop (cabi_dbg.xo dbg_tracer): each request's
/// system call made here, until a stop.
pub fn serve(m: Int) {
  while true {
    let s = rt.slot_load(m, ST / 8, SEQ_CST)
    if s == 1 {
      let r = if target.os == TargetOs.Windows {
        op(rt.mem_load(m, NR, 8), rt.mem_load(m, ARGS, 8), rt.mem_load(m, ARGS + 8, 8), rt.mem_load(m, ARGS + 16, 8))
      } else {
        rt.sys6(rt.mem_load(m, NR, 8), rt.mem_load(m, ARGS, 8), rt.mem_load(m, ARGS + 8, 8), rt.mem_load(m, ARGS + 16, 8), rt.mem_load(m, ARGS + 24, 8), rt.mem_load(m, ARGS + 32, 8), rt.mem_load(m, ARGS + 40, 8))
      }
      rt.mem_store(m, RES, r, 8)
      rt.slot_store(m, ST / 8, 2, SEQ_CST)
      pool.futex_wake(m)
    } else if s == 3 {
      // the mailbox is the caller's again once it reads 4
      rt.slot_store(m, ST / 8, 4, SEQ_CST)
      pool.futex_wake(m)
      return
    } else {
      pool.futex_wait(m, s)
    }
  }
}

/// System call nr with a to f on m's tracer thread: its result.
pub fn call(m: Int, nr: Int, a: Int, b: Int, c: Int, d: Int, e: Int, f: Int) -> Int {
  rt.mem_store(m, NR, nr, 8)
  rt.mem_store(m, ARGS, a, 8)
  rt.mem_store(m, ARGS + 8, b, 8)
  rt.mem_store(m, ARGS + 16, c, 8)
  rt.mem_store(m, ARGS + 24, d, 8)
  rt.mem_store(m, ARGS + 32, e, 8)
  rt.mem_store(m, ARGS + 40, f, 8)
  rt.slot_store(m, ST / 8, 1, SEQ_CST)
  pool.futex_wake(m)
  while rt.slot_load(m, ST / 8, SEQ_CST) == 1 {
    pool.futex_wait(m, 1)
  }
  let r = rt.mem_load(m, RES, 8)
  rt.slot_store(m, ST / 8, 0, SEQ_CST)
  r
}

/// Ends m's tracer thread and waits until it has left the mailbox.
pub fn stop(m: Int) {
  rt.slot_store(m, ST / 8, 3, SEQ_CST)
  pool.futex_wake(m)
  while rt.slot_load(m, ST / 8, SEQ_CST) != 4 {
    pool.futex_wait(m, 3)
  }
}
