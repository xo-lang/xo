// The Rand capability on the native backends (decision 0083), written in
// Xo (the zero-C audit's B08; it was std/llrt/xo_crypto.c): the
// operating system's generator, as Go's crypto/rand (getrandom on Linux,
// getentropy on macOS, BCryptGenRandom on Windows, through linux.xo,
// darwin.xo, windows.xo), or in a test binary the test world's seeded
// generator (std/rt's seededRand: testworld.xo's PCG, the zero-C
// audit's B14). The SSA builders call these as the
// native prelude's llrt_rand_*; a WASI module keeps the wasm runtime's
// rand (compiler/wasm/rt2.xo).
use native/llrt/cpu
use native/llrt/darwin
use native/llrt/ints
use native/llrt/freebsd
use native/llrt/layout
use native/llrt/linux
use native/llrt/raw
use native/llrt/testworld
use native/llrt/windows
use native/rt
use native/sys_darwin

/// The generator of the target: 1 Linux getrandom, 2 macOS getentropy,
/// 3 Windows BCryptGenRandom, 4 FreeBSD getrandom, 0 none (wasm32: a WASI module's Rand is
/// the wasm runtime's, gotchas/wasm-target-os-is-the-host.md).
fn source() -> Int {
  match target.arch {
    TargetArch.Wasm32 => 0
    TargetArch.Arm64 | TargetArch.Amd64 | TargetArch.Riscv64 => {
      match target.os {
        TargetOs.Linux => 1
        TargetOs.Darwin => 2
        TargetOs.Windows => 3
        TargetOs.FreeBSD => 4
        TargetOs.Wasi => 0
      }
    }
  }
}

/// n bytes of the system's generator; faults when it fails or there is
/// none (as the C runtime's cr_entropy did).
fn entropy(n: Int) -> Bytes {
  let (b, e) = match source() {
    1 => linux.random(n)
    2 => darwin.random(n)
    3 => windows.random(n)
    4 => freebsd.random(n)
    _ => (b"", -1)
  }
  if e != 0 {
    rt.fault_raise("the system random number generator failed", "")
  }
  b
}

/// 8 bytes of the system's generator, the first lowest, even in a test
/// binary (the Str hash's seed, entry.xo start).
pub fn system_u64() -> Int { rt.bytes_word(entropy(8), 0) }

/// 8 bytes of the system's generator written at addr, with no allocation
/// (the Str hash's seed at the process's start, entry.xo; system_u64's
/// Bytes there cost a small program 1.2 MB of resident memory): Linux's
/// AT_RANDOM bytes, else getrandom; darwin's getentropy. False when the
/// system gave none (the word is left as it was).
pub fn system_seed_at(addr: Int) -> Bool {
  match source() {
    1 => linux.random_at(addr)
    2 => darwin.random_at(addr)
    4 => freebsd.random_at(addr)
    3 => {
      rt.mem_store(addr, 0, system_u64(), 8)
      true
    }
    _ => false
  }
}

/// A random word: the test world's seeded generator in a test binary,
/// else 8 bytes of the system's, the first lowest.
pub fn next_u64() -> Int {
  if testworld.seeded() {
    return testworld.rand_u64()
  }
  // the worker's buffer while it has words; an unseeded state (new, or
  // wiped by a fork) hands out none (its ST_N is 0), so the seeding is the
  // slow path's
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    let st = rt.mem_load(w, layout.W_RAND, 8)
    if st > 0 {
      let i = rt.mem_load(st, ST_I, 8)
      if i < rt.mem_load(st, ST_N, 8) {
        rt.mem_store(st, ST_I, i + 1, 8)
        return rt.mem_load(st, ST_BUF + 8 * (i & 31), 8)
      }
    }
  }
  next_u64_slow()
}

/// next_u64 past the buffer: a refill, the state made or seeded, or the
/// system's generator.
fn next_u64_slow() -> Int {
  let st = state()
  if st == 0 {
    return rt.bytes_word(entropy(8), 0)
  }
  draw(st)
}

// ---------------------------------------------------------------------------
// The words of Rand.int, float and bool (decision 0669): a ChaCha8
// keystream per worker thread, Go's internal/chacha8rand (the runtime
// generator behind math/rand/v2's top-level functions), seeded from the
// system's generator. One system call a draw (plus an 8 byte Bytes) was 60
// to 354 times Go's draws (bench/perf/random, 2026-11-15). Rand.bytes,
// which std/crypto's keys and nonces read, stays the system's generator
// (next_bytes).
//
// Go's design: each refill computes four ChaCha8 blocks (counters c to c +
// 3) into 32 words; after four refills the last four words of the buffer,
// never handed out, become the next key (fast key erasure: a later state
// does not give the earlier words). The state lives in the worker's record
// (layout.W_RAND), so no two threads share one, and a new thread seeds its
// own on its first draw. A forked child must not repeat the parent's words:
// on Linux the state's page is MADV_WIPEONFORK and on FreeBSD
// INHERIT_ZERO (the child sees zeros: unseeded), on macOS a pthread_atfork
// child handler zeroes the forking thread's state (cabi.xo
// on_fork_child). Runtime code is never preempted (decision 0318), so a
// draw or a refill is not interleaved with another fiber's on its worker.

/// The state's bytes: seeded (1, 0 after a fork wiped it), the next word,
/// the words this buffer hands out, the block counter, the key (4 words),
/// the buffer (32 words), the block's input.
const ST_SEEDED = 0
const ST_I = 8
const ST_N = 16
const ST_C = 24
const ST_KEY = 32
const ST_BUF = 64
/// cpu.chacha8_rand4's input (80 bytes).
const ST_IN = 320
const ST_BYTES = 400
/// sched.xo TLS_W: the thread's worker record (0 on a thread that is not
/// a worker: the system's generator then).
const TLS_W = 2
/// rt.static_word 108: whether macOS's atfork handler is registered.
const STATIC_ATFORK = 108

/// The calling worker's seeded state, or 0 when the thread has none (not
/// a worker, or no wipe on fork on this system).
fn state() -> Int {
  let w = rt.tlocal_get(TLS_W)
  if w == 0 {
    return 0
  }
  var st = rt.mem_load(w, layout.W_RAND, 8)
  if st == 0 {
    st = state_new()
    rt.mem_store(w, layout.W_RAND, st, 8)
  }
  if st == -1 {
    return 0
  }
  if rt.mem_load(st, ST_SEEDED, 8) == 0 {
    let k = entropy(32)
    seed(st, rt.bytes_word(k, 0), rt.bytes_word(k, 8), rt.bytes_word(k, 16), rt.bytes_word(k, 24))
  }
  st
}

/// A state's memory that a forked child does not inherit (-1 when this
/// system gives none).
fn state_new() -> Int {
  match source() {
    1 | 4 => {
      // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
      let a = linux.mmap(0, 4096, 3, 0x22, -1, 0)
      if a < 0 {
        return -1
      }
      // Linux MADV_WIPEONFORK (18, since 4.14); FreeBSD minherit (250)
      // INHERIT_ZERO (3)
      let r = if source() == 4 { rt.sys6(250, a, 4096, 3, 0, 0, 0) } else { linux.madvise(a, 4096, 18) }
      if r != 0 {
        let _u = linux.munmap(a, 4096)
        return -1
      }
      a
    }
    2 => {
      // MAP_PRIVATE | MAP_ANON
      let a = sys_darwin.mmap(0, 4096, 3, 0x1002, -1, 0)
      if a == -1 {
        return -1
      }
      if rt.slot_cas[Int](rt.static_word(STATIC_ATFORK), 0, 0, 1, 4) {
        if Int(sys_darwin.pthread_atfork(0, 0, rt.fn_addr("on_fork_child"))) != 0 {
          rt.mem_store(rt.static_word(STATIC_ATFORK), 0, 0, 8)
          return -1
        }
      }
      a
    }
    3 => {
      // no fork on Windows
      let a = rt.heap_large(ST_BYTES)
      rt.mem_set(a, 0, ST_BYTES)
      a
    }
    _ => -1
  }
}

/// macOS's pthread_atfork child handler (cabi.xo on_fork_child): the
/// forking thread's state, the one the child runs on, made unseeded.
pub fn fork_child() {
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    let st = rt.mem_load(w, layout.W_RAND, 8)
    if st != 0 && st != -1 {
      rt.mem_set(st, 0, ST_BYTES)
    }
  }
}

/// Go's State.Init64: the key, the first buffer.
fn seed(st: Int, k0: Int, k1: Int, k2: Int, k3: Int) {
  rt.mem_store(st, ST_KEY, k0, 8)
  rt.mem_store(st, ST_KEY + 8, k1, 8)
  rt.mem_store(st, ST_KEY + 16, k2, 8)
  rt.mem_store(st, ST_KEY + 24, k3, 8)
  block(st, 0)
  rt.mem_store(st, ST_C, 0, 8)
  rt.mem_store(st, ST_I, 0, 8)
  rt.mem_store(st, ST_N, 32, 8)
  rt.mem_store(st, ST_SEEDED, 1, 8)
}

/// Go's Next and Refill: the next word of the buffer, refilled when
/// spent.
fn draw(st: Int) -> Int {
  var i = rt.mem_load(st, ST_I, 8)
  if i >= rt.mem_load(st, ST_N, 8) {
    refill(st)
    i = 0
  }
  rt.mem_store(st, ST_I, i + 1, 8)
  rt.mem_load(st, ST_BUF + 8 * (i & 31), 8)
}

fn refill(st: Int) {
  var c = rt.mem_load(st, ST_C, 8) + 4
  if c == 16 {
    // the next key: the last four words, which were not handed out
    for k in 0..4 {
      rt.mem_store(st, ST_KEY + 8 * k, rt.mem_load(st, ST_BUF + 8 * (28 + k), 8), 8)
    }
    c = 0
  }
  rt.mem_store(st, ST_C, c, 8)
  block(st, c)
  rt.mem_store(st, ST_I, 0, 8)
  rt.mem_store(st, ST_N, if c == 12 { 28 } else { 32 }, 8)
}

/// Go's block: four ChaCha8 blocks into the buffer (cpu.chacha8_rand4, a
/// vector kernel on arm64), from the 80 byte input after it: the
/// constants, the key, the counters ctr to ctr + 3 (word 12 unused) and a
/// zero nonce.
fn block(st: Int, ctr: Int) {
  let p = st + ST_IN
  rt.mem_store(p, 0, 0x3320646e61707865, 8)
  rt.mem_store(p, 8, 0x6b20657479622d32, 8)
  for k in 0..4 {
    rt.mem_store(p, 16 + 8 * k, rt.mem_load(st, ST_KEY + 8 * k, 8), 8)
  }
  rt.mem_store(p, 48, 0, 8)
  rt.mem_store(p, 56, 0, 8)
  rt.mem_store(p, 64, (ctr & M32) | (((ctr + 1) & M32) << 32), 8)
  rt.mem_store(p, 72, ((ctr + 2) & M32) | (((ctr + 3) & M32) << 32), 8)
  cpu.chacha8_rand4(st + ST_BUF, p)
}

const M32 = 0xFFFFFFFF

/// Word k (from 0) of the generator seeded with the 32 bytes of key, for
/// the known answer test (std/internal rt_probe "rand_kat": Go's
/// chacha8rand TestOutput vector). A state of its own, not a worker's.
pub fn kat_word(key: Str, k: Int) -> Int {
  let sb = raw.bytes_buf(ST_BYTES)
  let st = raw.bytes_addr(sb)
  rt.mem_set(st, 0, ST_BYTES)
  let d = raw.data(key)
  seed(st, rt.mem_load(d, 0, 8), rt.mem_load(d, 8, 8), rt.mem_load(d, 16, 8), rt.mem_load(d, 24, 8))
  raw.alive_str(key)
  var w = 0
  for _ in 0..k + 1 {
    w = draw(st)
  }
  raw.alive(sb)
  w
}

/// Whether a forked child's next word differs from its parent's
/// (std/internal rt_probe "rand_fork"): the child draws one word and
/// writes it to a pipe, the parent draws its next one and compares. 1
/// differ, 0 the same (a child repeating its parent's stream), 2 when
/// this system or thread has no state (nothing to repeat), -1 when a
/// system call failed.
pub fn fork_differs() -> Int {
  if testworld.seeded() || source() == 3 || source() == 0 {
    return 2
  }
  let st = state()
  if st == 0 {
    return 2
  }
  // spend most of a buffer so the child's word comes from the same one
  let _w = draw(st)
  let fb = raw.bytes_buf(16)
  let bb = raw.bytes_buf(8)
  let fds = raw.bytes_addr(fb)
  let buf = raw.bytes_addr(bb)
  var r = -1
  if source() == 2 {
    if Int(sys_darwin.pipe(fds)) == 0 {
      let rd = rt.mem_load(fds, 0, 4)
      let wr = rt.mem_load(fds, 4, 4)
      let pid = Int(sys_darwin.fork())
      if pid == 0 {
        rt.mem_store(buf, 0, next_u64(), 8)
        let _n = sys_darwin.write(wr, buf, 8)
        sys_darwin.exit(0)
      }
      let mine = next_u64()
      if pid > 0 && sys_darwin.read(rd, buf, 8) == 8 {
        r = if rt.mem_load(buf, 0, 8) == mine { 0 } else { 1 }
        let _s = sys_darwin.waitpid(pid, 0, 0)
      }
      let _a = sys_darwin.close(rd)
      let _b = sys_darwin.close(wr)
    }
  } else if linux.pipe2(fds, 0) == 0 {
    let rd = rt.mem_load(fds, 0, 4)
    let wr = rt.mem_load(fds, 4, 4)
    let pid = linux.fork()
    if pid == 0 {
      rt.mem_store(buf, 0, next_u64(), 8)
      let _n = linux.write_at(wr, buf, 8)
      let _e = linux.exit_group(0)
    }
    let mine = next_u64()
    if pid > 0 && linux.read_at(rd, buf, 8) == 8 {
      r = if rt.mem_load(buf, 0, 8) == mine { 0 } else { 1 }
      let _s = linux.wait4(pid, 0)
    }
    let _a = linux.close(rd)
    let _b = linux.close(wr)
  }
  raw.alive(fb)
  raw.alive(bb)
  r
}

/// `rand.bytes(n)`: n random bytes (none when n <= 0); seeded, one draw
/// per byte (its low byte), as std/rt's seededRand.M_bytes.
pub fn next_bytes(n0: Int) -> Bytes {
  let n = if n0 < 0 { 0 } else { n0 }
  if !testworld.seeded() {
    return entropy(n)
  }
  var s = rt.rs_with_cap(n)
  for _ in 0..n {
    s = rt.rs_push_byte(s, testworld.rand_u64() & 0xFF)
  }
  s.bytes()
}

/// `rand.int(lo, hi)`: uniform in [lo, hi) by rejection (std/rt's
/// randRange); faults on an empty range at the position at.
pub fn next_int(lo: Int, hi: Int, at: Str) -> Int {
  if hi <= lo {
    rt.fault_raise("rand.int(${lo}, ${hi}): the range is empty", at)
  }
  // as UInt64s: span = hi - lo, limit = MAX - MAX % span; draws at or
  // above limit are rejected. The limit is at least 2^64 - span, so a draw
  // below that is kept without computing it (its division was 36% of
  // random.normal's time); the same draws are kept as before.
  let span = hi.wrapping_sub(lo)
  let m = span.wrapping_sub(1)
  let pow2 = (span & m) == 0
  let flip = Int.min
  let sure = (0).wrapping_sub(span) ^ flip
  while true {
    let v = next_u64()
    if (v ^ flip) < sure || (v ^ flip) < ((-1).wrapping_sub(max_rem(span)) ^ flip) {
      let r = if pow2 { v & m } else if v >= 0 && span > 0 { v % span } else { ints.u64_rem(v, span) }
      return lo.wrapping_add(r)
    }
  }
  0
}

/// 2^64 - 1 mod span as UInt64s. For 0 < span <= 2^62 (every range
/// that fits in an Int's half) without the unsigned division:
/// 2^64 - 1 = 2 (2^63 - 1) + 1, so it is 2 m + 1, less span when that
/// reaches it, where m = (2^63 - 1) mod span.
fn max_rem(span: Int) -> Int {
  if span > 0 && span <= 4611686018427387904 {
    let r = ((Int.max % span).wrapping_mul(2)).wrapping_add(1)
    return if r >= span { r - span } else { r }
  }
  ints.u64_rem(-1, span)
}

/// `rand.float()`: uniform in [0, 1) with 53 bits.
pub fn next_float() -> Float { Float(next_u64().shr_logical(11)) / 9007199254740992.0 }

/// `rand.bool()`.
pub fn next_bool() -> Bool { (next_u64() & 1) == 1 }
