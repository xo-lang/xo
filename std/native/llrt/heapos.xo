// The heap's platform calls in Xo (the zero-C audit's work item B21):
// the memory of std/native/llrt/alloc.xo's 4 MiB chunks and of its
// big blocks (above mid_max; rt.heap_large stays the C library's malloc
// for the runtime's records, some of which the C frees), mapped from the system (mmap on Linux
// and macOS, VirtualAlloc on Windows) in place of the C library's malloc,
// realloc, and free, and the lock of the central lists (a lock word, as
// pool.xo's) in place of a pthread mutex. alloc.xo calls them as rt.heap_*
// (its no allocation rule allows only those calls); the C runtime's
// xo_heap_* entry points forward to cabi.xo's exports of these.
//
// A large block is a mapping of a word with the mapping's size, its 8
// byte prefix (minus its size n), and at least n bytes; the address
// handed out is after the prefix. A large block given back goes to a
// cache of mappings (at most CACHE_N of them, CACHE_MAX bytes) that later
// large blocks reuse, as malloc keeps its large frees: a program that
// makes and drops big lists or strings again and again would otherwise
// map, fault in, and unmap their pages every time (json parse took 1.1
// times the instructions); a resize within the mapping stays in place.
// A sanitizer build
// maps through the C library (sanhook.xo heap_map): ThreadSanitizer keeps a program's mappings in its application
// ranges through its mmap interceptor, which a system call bypasses
// (as pool.xo's fiber stacks).
//
// Nothing here allocates Xo values or faults: out of memory ends the
// process as the C's xo_oom did (status 70).
use native/llrt/alloc
use native/llrt/linux
use native/llrt/membudget
use native/llrt/obj
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/sanhook
use native/llrt/stdio
use native/rt
use native/sys_c
use native/sys_darwin
use native/sys_windows

/// rt.static_word: the central lists' lock word, the chunks mapped (the
/// C runtime's heap statistics and its tests read it through cabi.xo),
/// the mappings made through the C library (a sanitizer build; the
/// sysc.heap_libc op reads it), the large block cache's lock word, and
/// the cache's table (0 until the first large block is given back).
const W_LOCK = 22
const W_CHUNKS = 23
const W_LIBC_MAPS = 26
const W_CLOCK = 24
const W_CACHE = 25

/// The cache's table (a mapping of GRAIN bytes): its own size (word 0),
/// the bytes of the mappings it holds (word 1), their number (word 2),
/// then their addresses.
const CACHE_N = 16
const CACHE_MAX = 67108864
/// The byte of the table's advise switch (advise_on), past the entries.
const CACHE_SWITCH = 24 + 8 * CACHE_N
/// The table's ring of the last WANT_N sizes a large block asked the
/// cache for (take, hit or miss), and its next slot: on amd64 a freed
/// mapping one of them could have used may pass the quarter bound (keep;
/// decision 0492: json 1.75x there under the bound alone; arm64 gained
/// nothing from it and kept 0448's RSS)
const WANT_N = 16
const CACHE_WANT = CACHE_SWITCH + 8
const CACHE_WANT_AT = CACHE_WANT + 8 * WANT_N

/// A large mapping's size is a multiple of this (16 KiB pages on Apple
/// silicon, 64 KiB the Windows allocation granularity).
const GRAIN = 65536

/// The bytes of a chunk (xo_rt.c XO_CHUNK).
const CHUNK = 4194304

// slot atomics' orders (rt.xo: 0 relaxed, 1 acquire, 2 release, 3
// acq_rel, 4 seq_cst: an order off by one left the central lists' lock
// without acquire, bench/results/heap-platform-2026-10-14.md)
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2

/// The mappings made through the C library so far.
pub fn libc_maps() -> Int { rt.slot_load(rt.static_word(W_LIBC_MAPS), 0, RELAXED) }

/// size bytes of zeroed memory, readable and writable, from the system:
/// its address. Out of memory ends the process. A sanitizer build maps
/// through the C library (sanhook.xo heap_map): ThreadSanitizer and
/// AddressSanitizer see a mapping through their mmap interceptors, which
/// a system call bypasses. Only the Linux and macOS arms test for it: a
/// Windows build must not reference the C library's mmap, which it lacks
/// (its link fails), and target.os folds there.
pub fn map(size: Int) -> Int {
  let m = map_os(size)
  mapped(size)
  m
}

/// map without the memory budget's count: a large block's mapping, which
/// the budget counts by the bytes handed out instead (decision 0349's
/// 2026-10-22 hotfix: a growing block maps twice its size, pages that are
/// reserved, not used, so mapping sizes ran far past the resident set).
fn map_os(size: Int) -> Int {
  var m = 0
  match target.os {
    TargetOs.Linux => {
      if sanhook.sanitized() {
        return libc_map(size)
      }
      // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
      m = linux.mmap(0, size, 3, 34, -1, 0)
      if m < 0 && m > -4096 {
        m = 0
      } else if thp_mode() == 1 {
        let _h = linux.madvise(m, size, 15)
      }
    }
    TargetOs.Darwin => {
      if sanhook.sanitized() {
        return libc_map(size)
      }
      // MAP_PRIVATE | MAP_ANON
      m = sys_darwin.mmap(0, size, 3, 4098, -1, 0)
      if m == -1 {
        m = 0
      }
    }
    TargetOs.Windows => {
      if sanhook.gorace() {
        // ThreadSanitizer's arena (windows --race)
        m = sanhook.race_arena(size, true)
      } else {
        // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE
        m = sys_windows.VirtualAlloc(0, size, 12288, 4)
      }
    }
    TargetOs.Wasi => {}
  }
  if m == 0 {
    oom()
  }
  m
}

/// map through the C library (a sanitizer build on Linux or macOS),
/// counted.
fn libc_map(size: Int) -> Int {
  let m = sanhook.heap_map(size)
  if m == 0 {
    oom()
  }
  let _n = rt.slot_add(rt.static_word(W_LIBC_MAPS), 0, 1, RELAXED)
  m
}

/// Counts size bytes mapped for the memory budget (decision 0349,
/// membudget.xo), which stops the process past it.
fn mapped(size: Int) { membudget.add(size) }

/// The bytes the heap uses as the budget counts them (decision 0349).
pub fn mapped_bytes() -> Int { membudget.mapped() }

/// The most they have been.
pub fn peak_bytes() -> Int { membudget.peak() }

/// Sets the budget in bytes (0: none).
pub fn set_budget(b: Int) { membudget.set_budget(b) }

/// Records the label the budget's stop prints (at most 255 bytes of the
/// n at p; n 0 clears it). Its buffer is mapped here once, counted.
pub fn set_label(p: Int, n: Int) {
  if membudget.label_buf() == 0 {
    if n == 0 {
      return
    }
    let m = map(GRAIN)
    if !membudget.adopt_label_buf(m) {
      unmap(m, GRAIN)
    }
  }
  membudget.write_label(p, n)
}

/// The machine's physical memory in bytes, 0 when unknown (decision 0349:
/// xo's default budget is half of it).
pub fn phys_mem() -> Int {
  match target.os {
    TargetOs.Darwin => {
      let b = map(GRAIN)
      rt.mem_store(b, 8, 8, 8)
      let name = b"hw.memsize\x00"
      let ok = Int(sys_darwin.sysctlbyname(name, b, b + 8, 0, 0)) == 0
      let n = if ok { rt.mem_load(b, 0, 8) } else { 0 }
      unmap(b, GRAIN)
      n
    }
    TargetOs.Linux => {
      let b = map(GRAIN)
      let r = linux.sysinfo(b)
      let unit = rt.mem_load(b, 104, 4)
      let n = if r == 0 { rt.mem_load(b, 32, 8).wrapping_mul(if unit > 0 { unit } else { 1 }) } else { 0 }
      unmap(b, GRAIN)
      n
    }
    TargetOs.Windows => {
      // MEMORYSTATUSEX: dwLength at 0, ullTotalPhys at 8
      let b = map(GRAIN)
      rt.mem_store(b, 0, 64, 4)
      let ok = Int(sys_windows.GlobalMemoryStatusEx(b)) != 0
      let n = if ok { rt.mem_load(b, 8, 8) } else { 0 }
      unmap(b, GRAIN)
      n
    }
    TargetOs.Wasi => 0
  }
}


/// Gives back the mapping of size bytes at m.
pub fn unmap(m: Int, size: Int) {
  membudget.add(0 - size)
  unmap_os(m, size)
}

/// unmap without the budget's count (a large block's mapping).
fn unmap_os(m: Int, size: Int) {
  match target.os {
    TargetOs.Linux => {
      if sanhook.sanitized() {
        sanhook.heap_unmap(m, size)
        return
      }
      let _r = linux.munmap(m, size)
    }
    TargetOs.Darwin => {
      if sanhook.sanitized() {
        sanhook.heap_unmap(m, size)
        return
      }
      let _r = sys_darwin.munmap(m, size)
    }
    TargetOs.Windows => {
      // MEM_RELEASE; the arena's are kept (windows --race)
      if !sanhook.gorace() {
        let _r = sys_windows.VirtualFree(m, 0, 32768)
      }
    }
    TargetOs.Wasi => {}
  }
}

/// "fault: out of memory" and the end of the process (status 70).
pub fn oom() {
  let m = "fault: out of memory"
  stdio.err(raw.data(m), m.len(), true)
  process.os_exit(70)
}

/// The end of the process (status 70) for rt.heap_release of b, which is
/// no block's prefix (libcmem.xo heap_release): the address rt.heap_large
/// returned (after the prefix) instead of 8 bytes before it. Freed, it
/// put a block 8 bytes off on a class's free list (a --race build's
/// malloc then returned misaligned blocks: TSan's CHECK in
/// sanitizer_allocator_combined.h, the 2026-11-05 race stress).
pub fn bad_release(b: Int) {
  let m = "xo: internal: rt.heap_release(${b}): not a block's prefix (rt.heap_large's result minus 8)"
  stdio.err(raw.data(m), m.len(), true)
  raw.alive_str(m)
  process.os_exit(70)
}

/// A large block of n bytes: the address after its prefix (minus n).
pub fn large(n: Int) -> Int { large_room(n, n) }

/// A large block of n bytes in a mapping with room for at least room
/// (at least n) bytes.
fn large_room(n: Int, room: Int) -> Int {
  if sanhook.gorace() {
    // windows --race: the race heap's block (sanhook.xo race_block, its
    // shadow reset as malloc's interceptor does on Linux), the same
    // layout, its size word the block's
    let m = sanhook.race_block(n.wrapping_add(16))
    if m == 0 {
      oom()
    }
    rt.mem_store(m, 8, (0).wrapping_sub(n), 8)
    return m.wrapping_add(16)
  }
  if sanhook.user_mode() {
    // a --race build's heap (decision 0273 mode 2): every block from
    // the C library's malloc, whose interceptor resets its shadow memory,
    // so a block another task freed is not a race with its new owner (Xo's
    // thread caches hand blocks between the fibers of one thread with no
    // ordering it can see; Go's race detector resets a block's shadow at
    // allocation too). The same layout: its size word, the prefix, the
    // bytes.
    // the block's shadow is reset, not written as this thread's: the fiber
    // or worker record in it is first used by another thread, with no
    // order TSan can see (a fiber switch orders nothing)
    sanhook.ignore_writes(true)
    let m = sys_c.weak_malloc(n.wrapping_add(16))
    sanhook.ignore_writes(false)
    if m == 0 {
      oom()
    }
    rt.mem_store(m, 0, n.wrapping_add(16), 8)
    rt.mem_store(m, 8, (0).wrapping_sub(n), 8)
    return m.wrapping_add(16)
  }
  // the size word, the prefix, the bytes, rounded up to GRAIN
  let need = n.wrapping_add(16)
  var m = take(need)
  if m == 0 {
    let size = room.wrapping_add(16).wrapping_add(GRAIN - 1) & (0 - GRAIN)
    m = map_os(size)
    rt.mem_store(m, 0, size, 8)
  }
  rt.mem_store(m, 8, (0).wrapping_sub(n), 8)
  // the budget counts the bytes handed out (decision 0349)
  membudget.add(n)
  m.wrapping_add(16)
}

/// The large block whose prefix is at b, made n bytes: in place when its
/// mapping has the room, else a new block with its first bytes (the
/// smaller size's), the old one given back.
pub fn large_resize(b: Int, n: Int) -> Int {
  let m = b.wrapping_sub(8)
  if n.wrapping_add(16) <= rt.mem_load(m, 0, 8) {
    membudget.add(n.wrapping_add(rt.mem_load(b, 0, 8)))
    rt.mem_store(b, 0, (0).wrapping_sub(n), 8)
    return b.wrapping_add(8)
  }
  let old = (0).wrapping_sub(rt.mem_load(b, 0, 8))
  // a growing block (a list's or a string's growth) gets room for four
  // times n, so its next growths stay in place: the pages past what is
  // written are reserved, not used (realloc grows a large block in place
  // or remaps its pages). Four, not two: a list past 256 elements grows
  // by about 1.25x (decision 0452), so twice n copied it every 2.4x of
  // growth, each copy faulting in fresh pages (darwin's coll push 1.124
  // of the doubling curve, max RSS 1.10)
  let p = large_room(n, if n > old { n.wrapping_shl(2) } else { n })
  rt.mem_copy(p, b.wrapping_add(8), if old < n { old } else { n })
  release(b)
  p
}

// Mapped files (decision 0402, Fs.read_mapped; sysio.xo map_file, which
// keeps these two words in step): a region of MAP_LEAD
// bytes plus the file's size rounded up to MAP_LEAD, mapped anonymous,
// then the file mapped read only over it at R + MAP_LEAD (MAP_FIXED). A
// Str object's header ends 8 bytes below the file (the value is a view at
// offset 8, so no writer touches it in place); below the header the words
// a big block has, with sentinels: the prefix MAPPED_PREFIX (negative, so
// alloc.free hands it to rt.heap_big_release, and below -128, so that
// never takes it for a sampled block), then MAPPED_MAGIC where a big
// block keeps its size, then the region's address and size.

/// The prefix of a mapped file's object.
const MAPPED_PREFIX: Int = -9223372036854775807 - 1

/// The word below it ("XoMapped").
const MAPPED_MAGIC = 6372397078646121828

/// Gives back the large block whose prefix is at b: to the cache, or to
/// the system when the cache is full; a mapped file's object (map_file)
/// to the system, never the cache.
pub fn release(b: Int) {
  let m = b.wrapping_sub(8)
  if rt.mem_load(b, 0, 8) == MAPPED_PREFIX && rt.mem_load(m, 0, 8) == MAPPED_MAGIC {
    unmap_os(rt.mem_load(m - 8, 0, 8), rt.mem_load(m - 16, 0, 8))
    return
  }
  if sanhook.gorace() {
    sanhook.race_free(m)
    return
  }
  if sanhook.user_mode() {
    sys_c.weak_free(m)
    return
  }
  let size = rt.mem_load(m, 0, 8)
  membudget.add(rt.mem_load(b, 0, 8))
  if !keep(m, size) {
    unmap_os(m, size)
  }
}

/// Puts the mapping m of size bytes in the cache: whether it went there.
fn keep(m: Int, size: Int) -> Bool {
  let w = rt.static_word(W_CACHE)
  clock_take()
  var t = rt.mem_load(w, 0, 8)
  if t == 0 {
    // the table: a mapping of its own, kept for good
    t = map(GRAIN)
    rt.mem_store(t, 0, GRAIN, 8)
    // released: take reads the word before it takes the lock
    rt.slot_store(w, 0, t, RELEASE)
  }
  let bytes = rt.mem_load(t, 8, 8)
  let k = rt.mem_load(t, 16, 8)
  // and at most a quarter of the bytes the program has in use (decision
  // 0448, the bounded cache): a kept mapping's touched pages stay resident (darwin's
  // reusable pages count in max RSS too), which a small program pays for
  // (coll putget max RSS 8.3 MB with the cache, 5.2 without), while xo's
  // builds, with far more in use, keep the cache's reuse (without any
  // cache their linux/arm64 edit builds ran 1.04 to 1.07x)
  if k >= CACHE_N || bytes.wrapping_add(size) > CACHE_MAX || (bytes.wrapping_add(size) > (membudget.mapped() >> 2) && !(target.arch == TargetArch.Amd64 && wanted(t, size))) {
    clock_give()
    return false
  }
  rt.mem_store(t, (24).wrapping_add(k.wrapping_shl(3)), m, 8)
  rt.mem_store(t, 16, k.wrapping_add(1), 8)
  rt.mem_store(t, 8, bytes.wrapping_add(size), 8)
  // the block's contents are dead: its pages past the first (the size
  // word) go back to the system while the mapping waits in the cache
  // (decision 0448 stage 1: a kept mapping stayed resident, so a build's
  // transient tables held their RSS to exit), under the lock, so no taker
  // writes a page the advice then drops
  // a size the program asked for recently (decision 0492's ring) is
  // likely taken again soon: advising its pages away made each reuse
  // fault them back in (darwin/amd64 json10kx20 105 to 122 ms), so only
  // a mapping no recent request fits gives its pages back
  if !wanted(t, size) {
    cache_advise(m, size, false)
  }
  clock_give()
  true
}

/// Whether a mapping of size bytes could serve one of the sizes the
/// cache was last asked for (take's fit: need <= size <= 4 need): a
/// program that frees and asks again for blocks of one size (json's
/// buffers each round) keeps them past the quarter bound, while a list
/// that grows (each request larger than any block it frees) does not.
/// Sixteen sizes: json's growing buffers ask for more than four a round
/// (four left darwin/amd64 json at 136 ms, sixteen 124, 0492).
fn wanted(t: Int, size: Int) -> Bool {
  for i in 0..WANT_N {
    let n = rt.mem_load(t, CACHE_WANT + 8 * i, 8)
    if n > 0 && size >= n && size <= n.wrapping_shl(2) {
      return true
    }
  }
  false
}

/// The large block cache's mappings and the bytes they hold (diagnostics).
pub fn cache_count() -> Int {
  let t = rt.mem_load(rt.static_word(W_CACHE), 0, 8)
  if t == 0 { 0 } else { rt.mem_load(t, 16, 8) }
}
pub fn cache_bytes() -> Int {
  let t = rt.mem_load(rt.static_word(W_CACHE), 0, 8)
  if t == 0 { 0 } else { rt.mem_load(t, 8, 8) }
}

/// Tells the system the pages of the cached mapping m (size bytes) past
/// its first SCAV_PAGE are free (reuse false: Darwin MADV_FREE_REUSABLE,
/// lazy: the kernel takes the pages when memory is short and a reuse
/// before that costs nothing), or in use again (reuse true, Darwin
/// MADV_FREE_REUSE, so the footprint counts them). Darwin only: on Linux
/// stage 1's advice (this, trim_list, the 16 KiB scavenge) cost the warm
/// coll build 3 to 4.7% of its wall on arm64 and amd64 (MADV_DONTNEED
/// pages fault back in on reuse; MADV_FREE here alone left 1.039) and
/// without it the build is within noise (ab-host stage1-v2, 2026-10-31),
/// so Linux keeps decision 0383's behavior until a lazy variant is
/// measured. XO_HEAP_CACHE_ADVISE=0 turns it off (the baseline).
fn cache_advise(m: Int, size: Int, reuse: Bool) {
  if size <= SCAV_PAGE || sanhook.sanitized() || sanhook.gorace() || !advise_on() {
    return
  }
  match target.os {
    TargetOs.Darwin => {
      let _a = sys_darwin.madvise(m + SCAV_PAGE, size - SCAV_PAGE, if reuse { 8 } else { 7 })
    }
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// Whether kept mappings are advised: the table's word past its entries
/// (CACHE_SWITCH: 0 unread, 1 on, 2 off), read under the cache's lock
/// with no allocation (the value's first byte, so a release under the
/// lock never allocates).
fn advise_on() -> Bool {
  let t = rt.mem_load(rt.static_word(W_CACHE), 0, 8)
  var v = rt.mem_load(t, CACHE_SWITCH, 8)
  if v == 0 {
    let e = process.env_real_at("XO_HEAP_CACHE_ADVISE")
    v = if e != 0 && rt.mem_load(e, 0, 1) == 48 && rt.mem_load(e, 1, 1) == 0 { 2 } else { 1 }
    rt.mem_store(t, CACHE_SWITCH, v, 8)
  }
  v == 1
}

/// A cached mapping of at least need bytes and at most four times that
/// (so a small block does not hold a huge mapping), the latest given
/// back first; 0 when there is none.
fn take(need: Int) -> Int {
  let w = rt.static_word(W_CACHE)
  // no table yet: nothing to take, without the lock (an atomic load, as
  // keep's store; a plain read raced it under --race, http_h2c 2026-10-30)
  if rt.slot_load(w, 0, ACQUIRE) == 0 {
    return 0
  }
  clock_take()
  let t = rt.mem_load(w, 0, 8)
  let wi = rt.mem_load(t, CACHE_WANT_AT, 8)
  rt.mem_store(t, CACHE_WANT + 8 * wi, need, 8)
  rt.mem_store(t, CACHE_WANT_AT, (wi + 1) % WANT_N, 8)
  var k = rt.mem_load(t, 16, 8)
  // the largest mapping that fits: four times need rounded up to GRAIN,
  // since large_resize maps a growing block with four times its room,
  // rounded so: an unrounded bound refused the very mapping a request's
  // growth had made (n of 1,048,512 bytes maps 4,194,304; four times need
  // is 4,194,048), so each json10kx20 round mapped a new 4 MiB and the old
  // one stayed (on amd64 past the quarter bound, decision 0492) until the
  // cache held CACHE_N of them (16 mappings, 39 MB)
  let most = need.wrapping_shl(2).wrapping_add(GRAIN - 1) & (0 - GRAIN)
  while k > 0 {
    k = k.wrapping_sub(1)
    let at = (24).wrapping_add(k.wrapping_shl(3))
    let m = rt.mem_load(t, at, 8)
    let size = rt.mem_load(m, 0, 8)
    if size >= need && size <= most {
      // the last entry fills the gap
      let n = rt.mem_load(t, 16, 8).wrapping_sub(1)
      rt.mem_store(t, at, rt.mem_load(t, (24).wrapping_add(n.wrapping_shl(3)), 8), 8)
      rt.mem_store(t, 16, n, 8)
      rt.mem_store(t, 8, rt.mem_load(t, 8, 8).wrapping_sub(size), 8)
      cache_advise(m, size, true)
      clock_give()
      return m
    }
  }
  clock_give()
  0
}

/// Unmaps the large block cache's mappings of min bytes and over
/// (debug.mem_trim: CACHE_DROP_MIN): the advice above leaves them in the
/// RSS on Darwin and Linux has none (decision 0448 case (c)). Smaller ones
/// stay: what comes next reuses them, and on Linux their pages would fault
/// back in (conc-spawn's build, wall 1.03 with every mapping dropped).
/// 1 MiB since decision 0505: freed 1 MiB blocks stayed resident through
/// the trim on both systems (17 to 19 MB of 160 MB; Go's FreeOSMemory
/// returns them).
pub fn cache_drop(min: Int) {
  let w = rt.static_word(W_CACHE)
  if rt.slot_load(w, 0, ACQUIRE) == 0 {
    return
  }
  clock_take()
  let t = rt.mem_load(w, 0, 8)
  let n = rt.mem_load(t, 16, 8)
  var bytes = rt.mem_load(t, 8, 8)
  var kept = 0
  var k = 0
  while k < n {
    let m = rt.mem_load(t, (24).wrapping_add(k.wrapping_shl(3)), 8)
    let size = rt.mem_load(m, 0, 8)
    if size >= min {
      bytes = bytes.wrapping_sub(size)
      unmap_os(m, size)
    } else {
      rt.mem_store(t, (24).wrapping_add(kept.wrapping_shl(3)), m, 8)
      kept = kept.wrapping_add(1)
    }
    k = k.wrapping_add(1)
  }
  rt.mem_store(t, 16, kept, 8)
  rt.mem_store(t, 8, bytes, 8)
  clock_give()
}
pub const CACHE_DROP_MIN = 1048576

/// Gives the system the pages of the calling thread's free page blocks
/// (classes PAGE_CLASS and up on its heap record's free lists and spare
/// magazines; decision 0448 stage 1: a build's phase end, debug.mem_trim),
/// each block once (alloc.xo PADVISED, cleared when it is freed again):
/// the record is the thread's own, so no lock; the central lists'
/// magazines are scavenged as they arrive (alloc.xo free_mt). On Linux
/// only an explicit trim (debug.mem_trim, decision 0505) advises: freed
/// class blocks kept their pages for the life of the process there (324
/// to 332 MB of 160 MB of freed 16 and 64 KiB blocks, Go 4 to 8), while
/// the idle worker's trim stays darwin only (MADV_DONTNEED pages fault
/// back in on reuse, and an idle server's next burst would pay it).
pub fn trim_thread(explicit: Bool) {
  if !pages_on() {
    return
  }
  // the record the allocator uses on this thread (obj.xo heap_word): the
  // single threaded heap while no other thread runs, which the thread's
  // own TLS_HEAP never names (thread_heap made a new, empty record there,
  // so a program's trim before its first spawn gave back nothing, decision
  // 0505's addendum), else the thread's record, if it has one
  var h = obj.solo_heap()
  if h == 0 {
    h = rt.tlocal_get(TLS_HEAP)
  }
  if h == 0 {
    return
  }
  // Linux's page size: madvise rounds its length up to whole pages, so a
  // block it does not cover exactly (a 16 KiB block under 64 KiB pages)
  // is skipped, never rounded over a live neighbor
  let pg = match target.os {
    TargetOs.Linux => if explicit { linux.auxval(linux.AT_PAGESZ) } else { 0 }
    _ => 0
  }
  for c in PAGE_CLASS..NCLASS1 {
    let fl = h.wrapping_add(c.wrapping_shl(3))
    trim_list(rt.mem_load(fl, H_FREE_LISTS, 8), c, pg)
    trim_list(rt.mem_load(fl, H_MAG, 8), c, pg)
  }
}

/// debug.mem_trim's walk of the central lists' magazines of page blocks
/// (decision 0505's addendum): a class's full magazines wait there owned by
/// no thread, under the class's lock, so the caller advises them. The 16
/// KiB class's are not scavenged as they arrive on Linux (alloc.xo
/// scavenge_pages), nor the first SCAVENGE_KEEP of the larger classes', so
/// a threaded program's freed 16 KiB blocks stayed resident through the
/// trim. scavenge advises each block once (PADVISED).
pub fn trim_central() {
  if !pages_on() || sanhook.sanitized() || sanhook.gorace() {
    return
  }
  // the central lists are every record's (thread_heap copies H_CENTRAL)
  let h = heaps_head()
  if h == 0 || rt.mem_load(h, H_CENTRAL, 8) == 0 {
    return
  }
  for c in PAGE_CLASS..NCLASS1 {
    alloc.central_lock(h, c)
    var m = alloc.central_first(h, c)
    while m != 0 {
      scavenge(m, c)
      m = alloc.cnext(true, m)
    }
    alloc.central_unlock(h, c)
  }
}

/// trim_thread's walk of one list of page blocks of class c, linked
/// through their chunk's table (alloc.xo PT_LINK, so a block's own pages
/// hold nothing the list needs and all of them can go).
/// pg: Linux's page size for an explicit trim, else 0 (no advice there).
fn trim_list(p0: Int, c: Int, pg: Int) {
  let size = alloc.class_size(c).wrapping_add(8)
  var p = p0
  while p != 0 {
    let cw = pword(p, PT_CLASS)
    let v = rt.mem_load(cw, 0, 8)
    if v & alloc.PADVISED == 0 {
      // darwin's MADV_FREE_REUSABLE costs nothing until memory is short;
      // Linux's MADV_DONTNEED refaults cost the warm build's wall at
      // every phase (ab-host stage1-v1/v2, 2026-10-31), so there only an
      // explicit trim gives the pages (MADV_DONTNEED 4), and a block not
      // advised stays unmarked for the next one
      let _a = advise(p, cw, v, size, pg)
    }
    p = rt.mem_load(pword(p, PT_LINK), 0, 8)
  }
}

/// Gives the system the pages of free page block p of size bytes (its
/// class word cw holding v) and marks it PADVISED: darwin
/// MADV_FREE_REUSABLE (7); Linux MADV_DONTNEED (4) when pg, the page size,
/// is not 0 and covers the block exactly (madvise rounds its length up, so
/// a 16 KiB block under 64 KiB pages is skipped, never rounded over a live
/// neighbor), else the block stays as it is.
fn advise(p: Int, cw: Int, v: Int, size: Int, pg: Int) -> Bool {
  match target.os {
    TargetOs.Darwin => {
      rt.mem_store(cw, 0, v | alloc.PADVISED, 8)
      let _a = sys_darwin.madvise(p, size, 7)
      true
    }
    TargetOs.Linux => {
      if pg > 0 && p % pg == 0 && size % pg == 0 {
        rt.mem_store(cw, 0, v | alloc.PADVISED, 8)
        let _a = linux.madvise(p, size, 4)
        return true
      }
      false
    }
    TargetOs.Windows | TargetOs.Wasi => false
  }
}

/// An age pass (decision 0533, pool.xo age_check): over the calling
/// thread's free page blocks and, when central, over the central lists'
/// magazines of page blocks, under each class's lock. A block found free
/// and not marked is marked PSEEN; one already PSEEN (free since the
/// previous pass, at least SCAV_EVERY ago, since its free clears the bit)
/// gives its pages back (advise, Linux too). So pages go back only from
/// blocks a whole period untouched, as Go's scavenger returns only what
/// stayed unused, and a build's churn between phases never reaches the
/// second mark (the refaults decision 0448 measured). The blocks it
/// marked (which the next pass gives back if they stay free) in the low
/// 32 bits, and the 16 KiB units it gave back above them (pool.xo
/// age_check counts them for /debug/sched).
pub fn age(central: Bool) -> Int {
  if !pages_on() || sanhook.sanitized() || sanhook.gorace() {
    return 0
  }
  let pg = match target.os {
    TargetOs.Linux => linux.auxval(linux.AT_PAGESZ)
    _ => 0
  }
  var h = obj.solo_heap()
  if h == 0 {
    h = rt.tlocal_get(TLS_HEAP)
  }
  var k = 0
  var gave = 0
  if h != 0 {
    for c in PAGE_CLASS..NCLASS1 {
      let fl = h.wrapping_add(c.wrapping_shl(3))
      k += age_list(rt.mem_load(fl, H_FREE_LISTS, 8), c, pg, gave)
      k += age_list(rt.mem_load(fl, H_MAG, 8), c, pg, gave)
    }
  }
  if central {
    let hc = heaps_head()
    if hc != 0 && rt.mem_load(hc, H_CENTRAL, 8) != 0 {
      for c in PAGE_CLASS..NCLASS1 {
        alloc.central_lock(hc, c)
        var m = alloc.central_first(hc, c)
        while m != 0 {
          k += age_list(m, c, pg, gave)
          m = alloc.cnext(true, m)
        }
        alloc.central_unlock(hc, c)
      }
    }
  }
  (k & 4294967295) | gave.shr_logical(14).wrapping_shl(32)
}

/// age's walk of one list of page blocks of class c (trim_list's links):
/// the blocks it marked; gave adds the bytes it gave back.
fn age_list(p0: Int, c: Int, pg: Int, var gave: Int) -> Int {
  let size = alloc.class_size(c).wrapping_add(8)
  var k = 0
  var p = p0
  while p != 0 {
    let cw = pword(p, PT_CLASS)
    let v = rt.mem_load(cw, 0, 8)
    if v & alloc.PADVISED == 0 {
      if v & alloc.PSEEN != 0 {
        if age_sparse(p) && advise(p, cw, v, size, pg) {
          gave += size
        }
      } else {
        rt.mem_store(cw, 0, v | alloc.PSEEN, 8)
        k += 1
      }
    }
    p = rt.mem_load(pword(p, PT_LINK), 0, 8)
  }
  k
}

/// Whether an age pass may give back page block p's pages: always, except
/// on Linux with huge pages possible (THP=always and the heap not XO_THP=
/// off), where only a block whose 2 MiB range is at least half free (its
/// blocks seen free by an age pass or given back) is. Under THP=always
/// khugepaged refills a hole in a mostly live 2 MiB range with a whole
/// huge page (max_ptes_none 511), so giving back a block there raised the
/// footprint (decision 0533: sat8 idle RSS +10 MB); Go's scavenger skips
/// dense chunks the same way (mgcscavenge.go, about 96% used). A block
/// left keeps PSEEN, so a later pass gives it back once its range empties.
fn age_sparse(p: Int) -> Bool {
  match target.os {
    TargetOs.Linux => {}
    _ => return true
  }
  if thp_off() {
    return true
  }
  let huge = 2097152
  let r = p & (0).wrapping_sub(huge)
  let base = p & (0).wrapping_sub(CHUNK)
  var free = 0
  var q = r
  while q < r.wrapping_add(huge) {
    let v = if q == base { 0 } else { rt.mem_load(pword(q, PT_CLASS), 0, 8) }
    let c = v & 127
    if v > 0 && c >= PAGE_CLASS && v & (alloc.PSEEN | alloc.PADVISED) != 0 {
      // a free block: its pages, from its start (a block never crosses its
      // chunk, and a 2 MiB range is half a chunk)
      free += alloc.class_size(c).wrapping_add(8)
    }
    q = q.wrapping_add(PAGE)
  }
  free.wrapping_shl(1) >= huge
}

/// Takes and releases the cache's lock.
fn clock_take() {
  let l = rt.static_word(W_CLOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
  pool.held(1)
}

fn clock_give() {
  let l = rt.static_word(W_CLOCK)
  pool.held(-1)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

/// Gives heap record h a new chunk to carve blocks from (its bump words
/// at 24 and 32, alloc.xo BUMP_CUR and BUMP_END).
pub fn chunk(h: Int) {
  if extend(h, 32, H_BLIM) {
    return
  }
  // aligned to its size, so a page aligned prefixed block's chunk word is
  // found from the block (alloc.xo is_page; decision 0425)
  let prev = rt.mem_load(h, 32, 8)
  let c = map_aligned(CHUNK)
  thp_filled(prev, c)
  let _n = rt.slot_add(rt.static_word(W_CHUNKS), 0, 1, RELAXED)
  rt.mem_store(h, 24, c, 8)
  rt.mem_store(h, 32, c.wrapping_add(reserve(h, c, H_BLIM)), 8)
}

/// Whether a chunk starts small, the rest of its 4 MiB reserved (no access:
/// no other mapping can land in it, as is_page needs, and no huge page is
/// faulted in): darwin only (decision 0455). Linux keeps whole chunks: small
/// first chunks cost its conc-spawn edit 2 to 3% wall with no RSS gain.
fn small_chunks() -> Bool {
  if sanhook.sanitized() || sanhook.gorace() {
    return false
  }
  match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
}

fn set_prot(a: Int, n: Int, prot: Int) {
  match target.os {
    TargetOs.Linux => {
      let _r = linux.mprotect(a, n, prot)
    }
    TargetOs.Darwin => {
      let _r = sys_darwin.mprotect(a, n, prot)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// The new chunk c's usable bytes for heap record h, its limit recorded at
/// lim (0: nothing to extend to).
fn reserve(h: Int, c: Int, lim: Int) -> Int {
  if rt.mem_load(h, lim, 8) == 0 && dense_halves() {
    // XO_THP=dense: the first chunk's first half only, still accessible
    // (mapped NOHUGEPAGE), the main thread's record's too (decision 0469: its
    // whole first chunk advised HUGEPAGE cost a small program 2 MB for no
    // measured build speed); extend opens the second half advised HUGEPAGE
    rt.mem_store(h, lim, c.wrapping_add(CHUNK), 8)
    return HALF
  }
  if !small_chunks() || rt.mem_load(h, lim, 8) != 0 {
    rt.mem_store(h, lim, 1, 8)
    return CHUNK
  }
  set_prot(c.wrapping_add(FIRST_CHUNK), CHUNK - FIRST_CHUNK, 0)
  mapped(FIRST_CHUNK - CHUNK)
  rt.mem_store(h, lim, c.wrapping_add(CHUNK), 8)
  FIRST_CHUNK
}

/// Grows the chunk ending at h's word at `end` to four times its size, up to
/// its limit: whether it did.
fn extend(h: Int, end: Int, lim: Int) -> Bool {
  let e = rt.mem_load(h, end, 8)
  let l = rt.mem_load(h, lim, 8)
  if l == 0 || e >= l {
    return false
  }
  if dense_halves() {
    // XO_THP=dense: the first half is used up, so this record allocates
    // densely: the second half may take huge pages before it faults
    thp_advise(e, l.wrapping_sub(e))
    rt.mem_store(h, end, l, 8)
    return true
  }
  let used = e.wrapping_sub(l.wrapping_sub(CHUNK))
  let more = used.wrapping_mul(3)
  let g = if more < l.wrapping_sub(e) { more } else { l.wrapping_sub(e) }
  set_prot(e, g, 3)
  mapped(g)
  rt.mem_store(h, end, e.wrapping_add(g), 8)
  true
}

/// Whether heap record h's chunks can grow in place (no cut needed first).
pub fn can_extend(h: Int) -> Bool {
  rt.mem_load(h, 32, 8) < rt.mem_load(h, H_BLIM, 8)
}

/// The page blocks' table (alloc.xo PT_CLASS, PT_LINK, PT_CLINK) and the
/// heap record's page bump words (alloc.xo PCUR, PEND).
const PAGE = 16384
const PT_CLASS = 0
const PT_LINK = 2048
const PT_CLINK = 4096
const PAGE_CLASS = 77
const H_PCUR = 10952
const H_PEND = 10960
const H_PAGES = 10968
/// The ends of the bump chunk's and the page chunk's reservations.
const H_BLIM = 10976
const H_PLIM = 10984
/// XO_FREE_CHECK (decision 0484): the record's quarantine ring (0 off),
/// its next slot, and the block free_mt hands free_hold (alloc.xo FQ, FQP).
const H_FQ = 10992
const H_FQI = 11000
const H_FQP = 11008
/// The ring's slots (a power of two): a freed block stays poisoned and
/// unused until FQ_N more frees of its thread.
const FQ_N = 65536
/// A freed block's every word: as an address it is outside every user
/// space (a load through it faults), as a count or length it is huge.
const POISON = -2401053088876216593
/// A chunk's bytes at first (a thread that allocates little touches little
/// of its two chunks: a dozen of them were most of a small build's mapped
/// heap, decision 0448).
const FIRST_CHUNK = 262144
/// A page chunk's first word (alloc.xo PAGE_MAGIC).
const PAGE_MAGIC = 5784094464206446155

/// Whether the heap uses page blocks: not in a sanitizer or --race build,
/// whose big blocks come from the C library's malloc (large_room, map_os)
/// and so may be page aligned themselves, which a page block's address
/// test (alloc.xo is_page) could not tell from a page block; and not with
/// every block big (user_mode, gorace: H_MID_MAX 0).
pub fn pages_on() -> Bool { !sanhook.sanitized() && !sanhook.gorace() && !sanhook.user_mode() }

/// Gives heap record h a new page chunk (decision 0425): CHUNK bytes
/// aligned to CHUNK, its first page the table of its blocks' classes and
/// links, the pages after it carved as page blocks (alloc.xo alloc);
/// counted with the chunks.
pub fn pchunk(h: Int) {
  if extend(h, H_PEND, H_PLIM) {
    return
  }
  let prev = rt.mem_load(h, H_PEND, 8)
  let c = map_aligned(CHUNK)
  thp_filled(prev, c)
  rt.mem_store(c, 0, PAGE_MAGIC, 8)
  let _n = rt.slot_add(rt.static_word(W_CHUNKS), 0, 1, RELAXED)
  rt.mem_store(h, H_PCUR, c.wrapping_add(PAGE), 8)
  rt.mem_store(h, H_PEND, c.wrapping_add(reserve(h, c, H_PLIM)), 8)
}

/// A mapping of size bytes (a power of two) aligned to size: twice the
/// size mapped and the slack before and after the aligned part given
/// back (Linux, Darwin); Windows reserves twice the size and commits the
/// aligned part; a sanitizer build (the C library's mapping) keeps the
/// slack.
fn map_aligned(size: Int) -> Int {
  let mask = (0).wrapping_sub(size)
  var m = 0
  match target.os {
    TargetOs.Linux => {
      if sanhook.sanitized() {
        m = libc_map(size.wrapping_shl(1))
      } else {
        m = linux.mmap(0, size.wrapping_shl(1), 3, 34, -1, 0)
        if m < 0 && m > -4096 {
          m = 0
        } else if thp_off() {
          // MADV_NOHUGEPAGE
          let _h = linux.madvise(m, size.wrapping_shl(1), 15)
        }
      }
    }
    TargetOs.Darwin => {
      if sanhook.sanitized() {
        m = libc_map(size.wrapping_shl(1))
      } else {
        m = sys_darwin.mmap(0, size.wrapping_shl(1), 3, 4098, -1, 0)
        if m == -1 {
          m = 0
        }
      }
    }
    TargetOs.Windows => {
      if sanhook.gorace() {
        m = sanhook.race_arena(size.wrapping_shl(1), true)
      } else {
        // MEM_RESERVE twice the size, then MEM_COMMIT the aligned part
        let r = sys_windows.VirtualAlloc(0, size.wrapping_shl(1), 8192, 4)
        if r != 0 {
          let a = r.wrapping_add(size).wrapping_sub(1) & mask
          m = sys_windows.VirtualAlloc(a, size, 4096, 4)
          if m != 0 {
            mapped(size)
            return m
          }
        }
        m = 0
      }
    }
    TargetOs.Wasi => {}
  }
  if m == 0 {
    oom()
  }
  let a = m.wrapping_add(size).wrapping_sub(1) & mask
  if !sanhook.sanitized() && !sanhook.gorace() {
    if a > m {
      unmap_os(m, a.wrapping_sub(m))
    }
    let end = m.wrapping_add(size.wrapping_shl(1))
    if end > a.wrapping_add(size) {
      unmap_os(a.wrapping_add(size), end.wrapping_sub(a.wrapping_add(size)))
    }
  }
  mapped(size)
  a
}

/// The table word of page block p (alloc.xo pword).
fn pword(p: Int, t: Int) -> Int {
  let base = p & (0).wrapping_sub(CHUNK)
  base.wrapping_add(t).wrapping_add(p.wrapping_sub(base).shr_logical(14).wrapping_shl(3))
}


/// The chunks mapped so far.
pub fn chunks() -> Int { rt.slot_load(rt.static_word(W_CHUNKS), 0, RELAXED) }

/// The heap record's per class words this module reads for a cut (alloc.xo
/// NFREE, MAG_CAP; FREE_LISTS and MAG are H_FREE_LISTS and H_MAG above).
const H_NFREE = 11696

/// The classes whose central magazines a growing thread may cut into a
/// smaller class's blocks: the classes below the 16 KiB page class (decision
/// 0506: four a doubling from 1 KiB, so cut_for cuts a class above 1 KiB
/// only from the classes 4, 8, ... after it, whose blocks are an exact
/// number of its own), the resident ones (a class of 32 KiB or more is
/// given back by scavenge, so cutting it saves no footprint); and the
/// bytes of magazines a growth cuts at most.
const CUT_MAX_CLASS = 76
const CUT_BYTES = 1048576

/// The word of the central table that turns the cut off (XO_CUT=0): the
/// table is a page, its classes' words the first 85.
const CUT_OFF = 1056

/// XO_CUT=0: no growth cuts a magazine (decision 0383, (a)).
pub fn set_cut_kb(kb: Int) {
  let cen = rt.mem_load(heaps_head(), H_CENTRAL, 8)
  rt.mem_store(cen, CUT_OFF + 8, kb, 8)
}

pub fn set_cut_off() {
  let cen = rt.mem_load(heaps_head(), H_CENTRAL, 8)
  rt.mem_store(cen, CUT_OFF, 1, 8)
}

/// The word of the central table that turns huge pages off for the heap's
/// mappings (XO_THP=off, decision 0454): MADV_NOHUGEPAGE on every Linux
/// mapping the heap makes, so a sparse heap is not backed by 2 MiB pages
/// under THP=always.
const THP_OFF = 1080

pub fn set_thp_off() {
  let h = heaps_head()
  let cen = rt.mem_load(h, H_CENTRAL, 8)
  rt.mem_store(cen, THP_OFF, 1, 8)
  // the main thread's chunks made before this call (the startup's own
  // allocations) are advised now
  match target.os {
    TargetOs.Linux => {
      let e = rt.mem_load(h, 32, 8)
      if e != 0 {
        let _a = linux.madvise(e.wrapping_sub(CHUNK), CHUNK, 15)
      }
      let pe = rt.mem_load(h, H_PEND, 8)
      if pe != 0 {
        let _b = linux.madvise(pe.wrapping_sub(CHUNK), CHUNK, 15)
      }
    }
    _ => {}
  }
}

/// XO_THP=off for a Linux mapping outside the heap (a thread's stack): advises
/// MADV_NOHUGEPAGE on [m, m + size) once the heaps exist and the knob is set.
pub fn advise_nohuge(m: Int, size: Int) {
  if thp_off() {
    let _h = linux.madvise(m, size, 15)
  }
}

/// Whether huge pages are off; false before the heaps exist (their own
/// records are mapped first).
fn thp_off() -> Bool { thp_mode() != 0 }

/// XO_THP=dense, Linux's default (decision 0456, v4; bench/results/
/// thp-dense-2026-11-02.md: Go's density rule): chunks are mapped
/// MADV_NOHUGEPAGE as with off; a heap record's first chunk opens its first
/// 2 MiB half only, and when the bump uses it up the second half is advised
/// MADV_HUGEPAGE and opened, the main thread's record's as every other's
/// (decision 0469 dropped 0456's exception); once a record has used a chunk up, the used chunk (for
/// khugepaged) and its next chunk (before its pages fault) are advised
/// MADV_HUGEPAGE. A thread that fills 2 MiB allocates densely; one that never
/// does stays on small pages. Large blocks keep the kernel's policy.
pub fn set_thp_dense() {
  let cen = rt.mem_load(heaps_head(), H_CENTRAL, 8)
  rt.mem_store(cen, THP_OFF, 2, 8)
}

/// The huge page mode: 0 the default, 1 off, 2 dense; 0 before the heaps
/// exist (their own records are mapped first).
fn thp_mode() -> Int {
  let h = heaps_head()
  if h == 0 {
    return 0
  }
  let cen = rt.mem_load(h, H_CENTRAL, 8)
  if cen == 0 { 0 } else { rt.mem_load(cen, THP_OFF, 8) }
}

/// Half a chunk: dense's first step.
const HALF = 2097152

/// Whether a first chunk opens by halves (XO_THP=dense on Linux).
fn dense_halves() -> Bool {
  match target.os {
    TargetOs.Linux => thp_mode() == 2
    TargetOs.Darwin | TargetOs.Windows | TargetOs.Wasi => false
  }
}

fn thp_advise(a: Int, n: Int) {
  match target.os {
    TargetOs.Linux => {
      let _h = linux.madvise(a, n, 14)
    }
    TargetOs.Darwin | TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// XO_THP=dense: when the record's previous chunk ended at end (0: this
/// is its first chunk), that used up chunk and the new chunk c may take
/// huge pages.
fn thp_filled(end: Int, c: Int) {
  if end != 0 && dense_halves() {
    thp_advise(end.wrapping_sub(CHUNK), CHUNK)
    thp_advise(c, CHUNK)
  }
}

/// A thread's chunk is used up for a request of n bytes (cabi.xo heap_grow):
/// when a class above n's has magazines on the central lists, the smallest
/// such class's are cut into blocks of n's class (each block's bytes are an
/// exact number of the smaller class's blocks for the power of two classes,
/// and the tail of one of the others is left), up to CUT_BYTES, rather than
/// map a new chunk (decision 0383, (a): the free memory of the classes that
/// stopped being asked for is reused by the one that is). The cut blocks
/// go to the central list in whole magazines and the rest becomes the
/// thread's free list. True when alloc will find a block now, false when a
/// chunk must be mapped. Blocks only get smaller: a cut block never joins
/// into a larger one.
pub fn cut_for(h: Int, n: Int) -> Bool {
  let cen = rt.mem_load(h, H_CENTRAL, 8)
  if cen == 0 || rt.mem_load(cen, CUT_OFF, 8) != 0 {
    return false
  }
  let c = alloc.class_of_any(n)
  let size = alloc.class_size(c)
  let fl = h.wrapping_add(c.wrapping_shl(3))
  // a block is there already (a list, the spare, or the central list got one)
  if rt.mem_load(fl, H_FREE_LISTS, 8) != 0 || rt.mem_load(fl, H_MAG, 8) != 0 || rt.slot_load(cen, c, RELAXED) != 0 {
    return true
  }
  if c >= CUT_MAX_CLASS {
    return false
  }
  let stride = size.wrapping_add(8)
  let cap = rt.mem_load(fl, H_MAG_CAP, 8)
  // the magazines of the smallest larger class that has some, up to
  // CUT_BYTES of them, detached from its list in one hold of that class's
  // lock (a class is looked at without it, then again with it)
  var want = rt.mem_load(cen, CUT_OFF + 8, 8).wrapping_shl(10)
  if want == 0 {
    want = CUT_BYTES
  }
  // above 1 KiB only the classes 4, 8, ... after c (decision 0506): their
  // blocks are exactly 2, 4, ... of c's, so a cut leaves no tail (the
  // other classes' cuts left 282 MB of the self build in tails)
  let step = if c > 64 { 4 } else { 1 }
  var d = c.wrapping_add(step)
  var first = 0
  var last = 0
  var dsize = 0
  var dstride = 0
  while d <= CUT_MAX_CLASS && first == 0 {
    if rt.slot_load(cen, d, RELAXED) != 0 {
      clock(cen, d)
      first = rt.slot_load(cen, d, RELAXED)
      if first != 0 {
        dsize = alloc.class_size(d)
        dstride = dsize.wrapping_add(8)
        // a magazine is cap blocks of the donor class
        var dcap = rt.mem_load(h.wrapping_add(d.wrapping_shl(3)), H_MAG_CAP, 8)
        if dcap == 0 {
          dcap = 8
        }
        var got = dcap.wrapping_mul(dstride)
        last = first
        while got < want && rt.mem_load(last, 8, 8) != 0 {
          last = rt.mem_load(last, 8, 8)
          got = got.wrapping_add(dcap.wrapping_mul(dstride))
        }
        rt.slot_store(cen, d, rt.mem_load(last, 8, 8), RELAXED)
      }
      cunlock(cen, d)
    }
    if first == 0 {
      d = d.wrapping_add(step)
    }
  }
  if first == 0 {
    return false
  }
  rt.mem_store(last, 8, 0, 8)
  // cut them; whole magazines of class c are chained by their link word
  var head = 0
  var have = 0
  var outhead = 0
  var outtail = 0
  var m = first
  while m != 0 {
    let nextm = rt.mem_load(m, 8, 8)
    var r = m
    while r != 0 {
      let next = rt.mem_load(r, 0, 8)
      let b = r.wrapping_sub(8)
      var off = 0
      while off.wrapping_add(stride) <= dstride {
        let nb = b.wrapping_add(off)
        rt.mem_store(nb, 0, c, 8)
        let p = nb.wrapping_add(8)
        rt.mem_store(p, 0, head, 8)
        head = p
        have = have.wrapping_add(1)
        if have == cap {
          rt.mem_store(head, 8, outhead, 8)
          if outhead == 0 {
            outtail = head
          }
          outhead = head
          head = 0
          have = 0
        }
        off = off.wrapping_add(stride)
      }
      r = next
    }
    m = nextm
  }
  if outhead != 0 {
    // the whole magazines to the central list in one hold
    clock(cen, c)
    rt.mem_store(outtail, 8, rt.slot_load(cen, c, RELAXED), 8)
    rt.slot_store(cen, c, outhead, RELAXED)
    cunlock(cen, c)
  }
  if have != 0 {
    rt.mem_store(fl, H_FREE_LISTS, head, 8)
    rt.mem_store(fl, H_NFREE, have, 8)
    return true
  }
  rt.slot_load(cen, c, RELAXED) != 0
}

/// The central table page holds a lock word for each size class from CLOCK,
/// 64 bytes apart (alloc.xo CLOCK, clock, cunlock).
const CLOCK = 2048

fn clock_word(cen: Int, c: Int) -> Int { cen.wrapping_add(CLOCK).wrapping_add(c.wrapping_shl(6)) }

/// The contended path of alloc.xo's clock for class c: spins and sleeps on the
/// word (pool.lock_slow).
pub fn clock_slow(h: Int, c: Int) {
  pool.lock_slow(clock_word(rt.mem_load(h, H_CENTRAL, 8), c))
}

/// Wakes a thread asleep on class c's lock word.
pub fn clock_wake(h: Int, c: Int) {
  pool.futex_wake(clock_word(rt.mem_load(h, H_CENTRAL, 8), c))
}

/// Takes class c's central lock for this module's own use (cut_for).
fn clock(cen: Int, c: Int) {
  let l = clock_word(cen, c)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
  pool.held(1)
}

fn cunlock(cen: Int, c: Int) {
  pool.held(-1)
  if rt.slot_swap(clock_word(cen, c), 0, 0, RELEASE) == 2 {
    pool.futex_wake(clock_word(cen, c))
  }
}

/// Takes the central lists' lock.
pub fn lock() {
  let l = rt.static_word(W_LOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
  pool.held(1)
}

/// Releases it.
pub fn unlock() {
  let l = rt.static_word(W_LOCK)
  pool.held(-1)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

// ---------------------------------------------------------------------------
// The heap records of threads (xo_rt.c heap_slow, work item B21 part 2):
// a thread's first allocation after the program went threaded gets a
// record of its own, mapped (zeroed) and linked into the list of every
// record, which the leak check and the heap statistics sum. Records are
// never freed (the threads that use them are the pool's, which live as
// long as the program).

/// The heap record's words this module reads and writes (xo_rt.c struct
/// xo_heap, its offsets asserted there): the largest block the classes
/// serve, the central lists' address, the counts of blocks allocated and
/// freed (alloc.xo ALLOCS, FREES), the per class free list lengths
/// (alloc.xo FREE_LISTS, MAG), and the link of the list of every record.
const H_ALLOCS = 0
const H_FREES = 8
const H_MID_MAX = 56
const H_CENTRAL = 64
const H_FREE_LISTS = 11016
const H_MAG = 12376
const H_NEXT = 2136
/// Whether the record counts (alloc.xo COUNT).
const H_COUNT = 1864
/// The heap profile (heapprof.xo, alloc.xo SAMPLE_AT): whether it runs
/// (a thread's new record copies it), and the bytes allocated at which
/// the record's next sample is taken (the largest Int: none).
const H_PROF = 1872
const H_SAMPLE_AT = 10344
const NEVER = 9223372036854775807

/// The thread local word of the calling thread's heap record (sched.xo
/// TLS_HEAP).
const TLS_HEAP = 3

/// rt.static_word: the list of every heap record (its first record, the
/// main one at start), its lock word, and a record's size.
const W_HEAPS = 27

/// The heap record list's head, the newest record (thread_heap pushes
/// each new one there; the main thread's is the last, H_NEXT 0), read
/// with acquire: a pool thread may push while any thread reads, so a
/// plain load races and on arm64 may see the record before its fields
/// (gotchas/heap-list-head-is-newest-record.md: three races, 2026-11-02
/// and 2026-11-03). Every reader of W_HEAPS goes through it; repotest
/// TestHeapListHeadAccessors fails on another read.
/// 0 before the static words exist (thp_mode runs while the heaps' own
/// records are mapped).
fn heaps_head() -> Int {
  let w = rt.static_word(W_HEAPS)
  if w == 0 { 0 } else { rt.slot_load(w, 0, ACQUIRE) }
}

/// Publishes record h as the list's head (release: its fields first),
/// the one writer of W_HEAPS besides heaps_head's reads.
fn heaps_set(h: Int) { rt.slot_store(rt.static_word(W_HEAPS), 0, h, RELEASE) }
const W_HLOCK = 28
const W_HSIZE = 29

/// A heap record's size (alloc.xo's and obj.xo's fields, then the
/// real-time section's queue of 256 entries of 32 bytes: xo_rt.c's
/// xo_heap until decision 0233 step 2; then the heap profile's next
/// sample, its thread state, and its sampled block: alloc.xo SAMPLE_AT,
/// heapprof.xo H_PSTATE, alloc.xo PSAMPLE), the size classes' limit
/// (XO_HEAP_MID_MAX lowers it), and the central lists' words (a list
/// per size class, 1 to 84); then each class's magazine size (alloc.xo
/// MAG_CAP, written by mag_caps); then the page chunk's bump words and the
/// page blocks flag (alloc.xo PCUR, PEND, PAGES; decision 0425), the
/// chunks' reservation ends (H_BLIM, H_PLIM), and XO_FREE_CHECK's ring,
/// its next slot and the block being freed (alloc.xo FQ, FQP; decision
/// 0484); then (decision 0506, 85 classes) each class's free list, its
/// length, its spare magazine and its magazine size (alloc.xo FREE_LISTS,
/// NFREE, MAG, MAG_CAP; the 73 class arrays before them are unused).
const H_SIZE = 2152 + 32 * 256 + 24 + 8 * 73 + 24 + 16 + 24 + 4 * 8 * 85
/// The first word of the per class magazine sizes (alloc.xo MAG_CAP).
const H_MAG_CAP = 13056
/// The bytes of blocks in a magazine (alloc.xo MAG_BYTES).
const MAG_BYTES = 65536
const MID_MAX = alloc.MID_MAX_LIMIT
/// The size classes' limit at start: blocks above it are mapped from the
/// system and returned to it by munmap when freed, while a freed class
/// block stays on its free list. 64 KiB on darwin (owner, 2026-11-04,
/// decision 0448 addendum: 16 KiB, chosen 2026-10-30 when the self build's
/// 32 KiB to 256 KiB page block classes held 4.4 GB on their free lists
/// at exit, made map1M 141 to 154 ms on darwin/amd64; with the large
/// block cache of 0492 its footprint gain was gone, and 64 KiB gives the
/// speed back for +6 to 15% of the self build's max RSS; 8 KiB had cost
/// 15% wall), MID_MAX elsewhere (linux/arm64, the same build: wall 1.115
/// worse and no RSS change at 16 KiB: Linux gives the freed class
/// blocks' pages back by itself). XO_HEAP_MID_MAX sets it, up to MID_MAX.
const MID_DARWIN = 65536
fn mid_default() -> Int {
  match target.os {
    TargetOs.Darwin => MID_DARWIN
    _ => MID_MAX
  }
}
const NCLASS1 = 82

/// Makes the main heap record and the central lists (C main, before
/// anything allocates) and starts the list of every record with it: its
/// address.
pub fn main_record() -> Int {
  let h = map(H_SIZE)
  mag_caps(h)
  // a --race build (decision 0273 mode 2): every block a big one (alloc.xo's classes,
  // free lists, chunks and magazines unused), from the C library's
  // malloc (large_room)
  rt.mem_store(h, H_MID_MAX, if sanhook.user_mode() || sanhook.gorace() { 0 } else { mid_default() }, 8)
  rt.mem_store(h, H_PAGES, if pages_on() { 1 } else { 0 }, 8)
  rt.mem_store(h, H_COUNT, 1, 8)
  rt.mem_store(h, H_SAMPLE_AT, NEVER, 8)
  rt.mem_store(h, H_CENTRAL, map(8192), 8)
  heaps_set(h)
  rt.mem_store(rt.static_word(W_HSIZE), 0, H_SIZE, 8)
  h
}

/// Writes record h's magazine size of each class 1 to 84 (alloc.xo
/// MAG_CAP): the blocks of MAG_BYTES, at least 8, which alloc.free_mt
/// computed with a multiply on every free of a long list (2026-10-19).
fn mag_caps(h: Int) {
  var c = 1
  while c < NCLASS1 {
    let size = alloc.class_size(c)
    // MAG_BYTES / size by long division (no `/`: this module's rule)
    var q = 0
    var rem = MAG_BYTES
    var k = 12
    while k >= 0 {
      let d = size.wrapping_shl(k)
      if d <= rem {
        rem = rem.wrapping_sub(d)
        q = q | (1).wrapping_shl(k)
      }
      k = k.wrapping_sub(1)
    }
    if q < 8 {
      q = 8
    }
    rt.mem_store(h, H_MAG_CAP.wrapping_add(c.wrapping_shl(3)), q, 8)
    c = c.wrapping_add(1)
  }
}

/// XO_FREE_CHECK (decision 0484), at the program's start, while one
/// thread runs: counting stays on and the main record gets a quarantine
/// ring (check_record); the caller then moves the program to per thread
/// heaps (entry.xo start), so every free takes alloc.free_mt and so
/// free_hold.
pub fn free_check_on() {
  let h = heaps_head()
  rt.mem_store(h, H_COUNT, 1, 8)
  check_record(h)
}

/// Record h's quarantine ring, and its magazine sizes far below any
/// list's length, so alloc.free_push declines every free (to free_mt;
/// not 0: alloc's pops take a list's length below 0 when free_push did not
/// count the block).
fn check_record(h: Int) {
  rt.mem_store(h, H_FQ, map(FQ_N.wrapping_shl(3)), 8)
  rt.mem_store(h, H_FQI, 0, 8)
  var c = 1
  while c < NCLASS1 {
    rt.mem_store(h, H_MAG_CAP.wrapping_add(c.wrapping_shl(3)), -4611686018427387904, 8)
    c = c.wrapping_add(1)
  }
}

/// The bytes after the prefix of a block of class c (alloc.xo's classes).
fn class_bytes(c: Int) -> Int { alloc.class_size(c) }

/// XO_FREE_CHECK's free (cabi.xo heap_grow, from alloc.xo free_mt) of
/// the block in record h's H_FQP word: a block of a class is filled with
/// POISON and takes the ring's next slot, and the block it replaces,
/// freed FQ_N frees ago, is checked still poisoned (else written after
/// its free: reported, status 70) and given back (alloc.free_held); a
/// page block or a big one is given back at once.
pub fn free_hold(h: Int) {
  let p = rt.mem_load(h, H_FQP, 8)
  if (p & 16383) == 0 {
    alloc.free_held(h, p)
    return
  }
  let c = rt.mem_load(p.wrapping_sub(8), 0, 8)
  if c <= 0 || c >= PAGE_CLASS {
    alloc.free_held(h, p)
    return
  }
  let n = class_bytes(c)
  var k = 0
  while k < n {
    rt.mem_store(p, k, POISON, 8)
    k = k.wrapping_add(8)
  }
  let ring = rt.mem_load(h, H_FQ, 8)
  let i = rt.mem_load(h, H_FQI, 8)
  let slot = ring.wrapping_add(i.wrapping_shl(3))
  let q = rt.mem_load(slot, 0, 8)
  rt.mem_store(slot, 0, p, 8)
  rt.mem_store(h, H_FQI, i.wrapping_add(1) & FQ_N.wrapping_sub(1), 8)
  if q == 0 {
    return
  }
  if held_written(q) {
    written_after_free()
  }
  alloc.free_held(h, q)
}

/// Clears the n bytes (a multiple of 8) at p of a record whose part was
/// closed or freed while the record lives on (hclient.xo close_at's
/// connection fields): zeros, or POISON under XO_FREE_CHECK, so a use
/// after the close faults where it happens instead of reading a zero
/// that looks valid (descriptor 0 is standard input; on wasm address 0
/// is memory). Decision 0484.
pub fn retire(p: Int, n: Int) {
  // the head with acquire, as thp_mode: other threads may push records
  // (thread_heap's release store; gotchas/heap-list-head-is-newest-record.md)
  let r = heaps_head()
  if r == 0 || rt.mem_load(r, H_FQ, 8) == 0 {
    rt.mem_set(p, 0, n)
    return
  }
  var k = 0
  while k < n {
    rt.mem_store(p, k, POISON, 8)
    k = k.wrapping_add(8)
  }
}

/// Whether held block q (free_hold) is no longer all POISON: written
/// after its free.
fn held_written(q: Int) -> Bool {
  let n = class_bytes(rt.mem_load(q.wrapping_sub(8), 0, 8))
  var k = 0
  while k < n {
    if rt.mem_load(q, k, 8) != POISON {
      return true
    }
    k = k.wrapping_add(8)
  }
  false
}

/// "fault: XO_FREE_CHECK: ..." and the end of the process (status 70).
fn written_after_free() {
  let m = "fault: XO_FREE_CHECK: a freed block was written after its free (a use after free: a store, or a reference count changed, through a pointer to it)"
  stdio.err(raw.data(m), m.len(), true)
  process.os_exit(70)
}

/// XO_FREE_CHECK at the program's end (entry.xo finish): every record's
/// held blocks checked as an eviction checks one (free_hold).
pub fn free_check_end() {
  // with acquire: a pool thread still starting may push its record now
  // (TSan, conc_unwind on linux/arm64, 2026-11-03)
  var r = heaps_head()
  while r != 0 {
    let ring = rt.mem_load(r, H_FQ, 8)
    if ring != 0 {
      var i = 0
      while i < FQ_N {
        let q = rt.mem_load(ring, i.wrapping_shl(3), 8)
        if q != 0 && held_written(q) {
          written_after_free()
        }
        i = i.wrapping_add(1)
      }
    }
    r = rt.mem_load(r, H_NEXT, 8)
  }
}

/// Stops the counting of allocations and frees (alloc.xo COUNT) on the
/// main record, which the threads' records copy (the program's start,
/// before a second thread: no report reads the counts).
pub fn counting_off() { rt.mem_store(heaps_head(), H_COUNT, 0, 8) }

/// Counts on every record from now on (a budget's stretch, which reads
/// its record's allocated bytes): nothing when record h, the caller's,
/// already counts; else each record under the list's lock, the first
/// (which new records copy) among them.
pub fn counting_on(h: Int) {
  if rt.mem_load(h, H_COUNT, 8) != 0 {
    return
  }
  hlock_take()
  var r = heaps_head()
  while r != 0 {
    rt.mem_store(r, H_COUNT, 1, 8)
    r = rt.mem_load(r, H_NEXT, 8)
  }
  hlock_give()
}

/// Sets the size classes' limit to m (XO_HEAP_MID_MAX, at start: the
/// main record, which the others copy; mid_default() otherwise).
pub fn set_mid_max(m: Int) { rt.mem_store(heaps_head(), H_MID_MAX, m, 8) }

/// Makes record h the calling thread's (the main thread, when a second
/// thread is about to run Xo code).
pub fn set_thread_heap(h: Int) { rt.tlocal_set(TLS_HEAP, h) }

/// The calling thread's heap record, made on its first use: the size
/// classes' limit and the central lists are the other records'.
pub fn thread_heap() -> Int {
  let t = rt.tlocal_get(TLS_HEAP)
  if t != 0 {
    return t
  }
  let h = map(rt.mem_load(rt.static_word(W_HSIZE), 0, 8))
  mag_caps(h)
  hlock_take()
  let first = heaps_head()
  rt.mem_store(h, H_MID_MAX, rt.mem_load(first, H_MID_MAX, 8), 8)
  rt.mem_store(h, H_PAGES, rt.mem_load(first, H_PAGES, 8), 8)
  rt.mem_store(h, H_CENTRAL, rt.mem_load(first, H_CENTRAL, 8), 8)
  rt.mem_store(h, H_COUNT, rt.mem_load(first, H_COUNT, 8), 8)
  if rt.mem_load(first, H_FQ, 8) != 0 {
    check_record(h)
  }
  let prof = rt.mem_load(first, H_PROF, 8)
  rt.mem_store(h, H_PROF, prof, 8)
  // profiling: the first allocation's hook draws this record's first gap
  rt.mem_store(h, H_SAMPLE_AT, if prof != 0 { 0 } else { NEVER }, 8)
  rt.mem_store(h, H_NEXT, first, 8)
  // the list's head is also read without the lock (thp_mode): published with release
  heaps_set(h)
  hlock_give()
  rt.tlocal_set(TLS_HEAP, h)
  h
}

/// Starts the heap profile on every record (prof.xo start_heap): counting
/// on (alloc.xo COUNT, where the sample check is), and each record's
/// next sample at once (the hook draws its first gap).
pub fn profile_on() {
  hlock_take()
  var r = heaps_head()
  while r != 0 {
    rt.mem_store(r, H_COUNT, 1, 8)
    rt.mem_store(r, H_PROF, 1, 8)
    rt.mem_store(r, H_SAMPLE_AT, 0, 8)
    r = rt.mem_load(r, H_NEXT, 8)
  }
  hlock_give()
}

/// The blocks allocated and not freed, and the blocks allocated, over
/// every record, stored at lp and tp (the leak check).
pub fn live(lp: Int, tp: Int) {
  var l = 0
  var t = 0
  hlock_take()
  var h = heaps_head()
  while h != 0 {
    let a = rt.mem_load(h, H_ALLOCS, 8)
    l = l.wrapping_add(a.wrapping_sub(rt.mem_load(h, H_FREES, 8)))
    t = t.wrapping_add(a)
    h = rt.mem_load(h, H_NEXT, 8)
  }
  hlock_give()
  rt.mem_store(lp, 0, l, 8)
  rt.mem_store(tp, 0, t, 8)
}

/// The blocks allocated and not yet freed now, over every record (live's
/// first figure), for a running program's /debug/sched (heap_live,
/// decision 0520); -1 when the heap does not count. Exact when it has
/// counted since the start (XO_LEAKCHECK, XO_HEAPSTATS or XO_RTSTATS set
/// then); counting a budget turned on later misses the frees of blocks
/// made before it.
pub fn live_now() -> Int {
  if rt.mem_load(heaps_head(), H_COUNT, 8) == 0 {
    return -1
  }
  var l = 0
  hlock_take()
  var h = heaps_head()
  while h != 0 {
    l = l.wrapping_add(rt.mem_load(h, H_ALLOCS, 8).wrapping_sub(rt.mem_load(h, H_FREES, 8)))
    h = rt.mem_load(h, H_NEXT, 8)
  }
  hlock_give()
  l
}

/// The blocks on class c's free lists over every record (the heap
/// statistics): each record's list, its spare magazine, and the central
/// list's magazines, counted by walking them. The records' NFREE words
/// are not read: a single threaded heap's alloc and free leave them
/// alone (alloc.xo recount sets them when threads start), so they go
/// negative and summed to a wrapped figure (2026-10-24: XO_HEAPSTATS
/// printed 17592186044415 MB on free lists).
pub fn nfree(c: Int) -> Int {
  var n = 0
  hlock_take()
  var h = heaps_head()
  while h != 0 {
    let fl = h.wrapping_add(c.wrapping_shl(3))
    n = n.wrapping_add(list_len_c(c, rt.mem_load(fl, H_FREE_LISTS, 8)))
    n = n.wrapping_add(list_len_c(c, rt.mem_load(fl, H_MAG, 8)))
    h = rt.mem_load(h, H_NEXT, 8)
  }
  // the central list's magazines, linked by their first block's second word
  let h0 = heaps_head()
  if h0 != 0 {
    let cen = rt.mem_load(h0, H_CENTRAL, 8)
    if cen != 0 {
      var m = rt.slot_load(cen, c, RELAXED)
      while m != 0 {
        n = n.wrapping_add(list_len_c(c, m))
        m = alloc.cnext(c >= PAGE_CLASS && pages_on(), m)
      }
    }
  }
  hlock_give()
  n
}

/// The length of the list of blocks linked by their first word from p.
fn list_len(p: Int) -> Int {
  var n = 0
  var q = p
  while q != 0 {
    n = n.wrapping_add(1)
    q = rt.mem_load(q, 0, 8)
  }
  n
}

/// list_len for a list of class c: a page block's link is in its chunk's
/// table (alloc.xo lnext).
fn list_len_c(c: Int, p: Int) -> Int {
  if c < PAGE_CLASS || !pages_on() {
    return list_len(p)
  }
  var n = 0
  var q = p
  while q != 0 {
    n = n.wrapping_add(1)
    q = rt.mem_load(pword(q, PT_LINK), 0, 8)
  }
  n
}

fn hlock_take() {
  let l = rt.static_word(W_HLOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
  pool.held(1)
}

fn hlock_give() {
  let l = rt.static_word(W_HLOCK)
  pool.held(-1)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

/// The granule the scavenger works in: 16 KiB, the page of Apple silicon and
/// a multiple of Linux's 4 KiB.
const SCAV_PAGE = 16384

/// Gives back to the system (decision 0383) the whole pages inside each
/// block of the magazine at m (class c, 32 KiB to 256 KiB, linked by their
/// first word), except those holding the block's two link words (the
/// block's first word is the list link, its second the central list's):
/// the kernel returns zero pages on the next use, which a free block's
/// contents allow. Linux MADV_DONTNEED (4) frees at once; Darwin
/// MADV_FREE_REUSABLE (7) takes the pages out of the process's footprint.
pub fn scavenge(m: Int, c: Int) {
  if sanhook.sanitized() || sanhook.gorace() {
    return
  }
  let size = alloc.class_size(c)
  // the system's page, at least SCAV_PAGE: madvise rounds its length up
  // to whole pages, so a range is advised only from a page boundary and
  // in whole pages, never rounded over a live neighbor (a 32 KiB block
  // under Linux's 64 KiB pages; gotchas/madvise-rounds-over-neighbor.md)
  let gran = match target.os {
    TargetOs.Linux => {
      let ps = linux.auxval(linux.AT_PAGESZ)
      if ps > SCAV_PAGE { ps } else { SCAV_PAGE }
    }
    _ => SCAV_PAGE
  }
  var r = m
  while r != 0 {
    // a page block (class PAGE_CLASS and up, decision 0425) holds no link
    // and no prefix: every page of it goes back, and its successor is in
    // its chunk's table
    var lo = (r + 16 + gran - 1) / gran * gran
    var hi = (r + size) / gran * gran
    let pg = c >= PAGE_CLASS && pages_on()
    if pg {
      lo = r
      hi = r + size + 8
      // once per free (alloc.xo PADVISED, cleared when it is freed again),
      // and only a block the system's pages cover exactly
      let cw = pword(r, PT_CLASS)
      let v = rt.mem_load(cw, 0, 8)
      if v & alloc.PADVISED != 0 || r % gran != 0 || (size + 8) % gran != 0 {
        hi = lo
      } else {
        rt.mem_store(cw, 0, v | alloc.PADVISED, 8)
      }
    }
    if hi > lo {
      match target.os {
        TargetOs.Linux => {
          let _a = linux.madvise(lo, hi - lo, 4)
        }
        TargetOs.Darwin => {
          let _a = sys_darwin.madvise(lo, hi - lo, 7)
        }
        TargetOs.Windows | TargetOs.Wasi => {}
      }
    }
    r = if pg { rt.mem_load(pword(r, PT_LINK), 0, 8) } else { rt.mem_load(r, 0, 8) }
  }
}
