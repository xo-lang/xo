// The heap's platform calls in Xo (the zero-C audit's work item B21):
// the memory of std/native/llrt/alloc.xo's 4 MiB chunks and of its
// big blocks (above mid_max; rt.heap_large stays the C library's malloc
// for the runtime's records, some of which the C frees), mapped from the system (mmap on Linux
// and macOS, VirtualAlloc on Windows) in place of the C library's malloc,
// realloc, and free, and the lock of the central lists (a lock word, as
// pool.xo's) in place of a pthread mutex. alloc.xo calls them as rt.heap_*
// (its no allocation rule allows only those calls); the C runtime's
// xo_heap_* entry points forward to cabi.xo's exports of these.
//
// A large block is a mapping of a word with the mapping's size, its 8
// byte prefix (minus its size n), and at least n bytes; the address
// handed out is after the prefix. A large block given back goes to a
// cache of mappings (at most CACHE_N of them, CACHE_MAX bytes) that later
// large blocks reuse, as malloc keeps its large frees: a program that
// makes and drops big lists or strings again and again would otherwise
// map, fault in, and unmap their pages every time (json parse took 1.1
// times the instructions); a resize within the mapping stays in place.
// A sanitizer build
// maps through the C library (sanhook.xo heap_map): ThreadSanitizer keeps a program's mappings in its application
// ranges through its mmap interceptor, which a system call bypasses
// (as pool.xo's fiber stacks).
//
// Nothing here allocates Xo values or faults: out of memory ends the
// process as the C's xo_oom did (status 70).
use native/llrt/linux
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/sanhook
use native/llrt/stdio
use native/rt
use native/sys_darwin
use native/sys_windows

/// rt.static_word: the central lists' lock word, the chunks mapped (the
/// C runtime's heap statistics and its tests read it through cabi.xo),
/// the mappings made through the C library (a sanitizer build; the
/// sysc.heap_libc op reads it), the large block cache's lock word, and
/// the cache's table (0 until the first large block is given back).
const W_LOCK = 22
const W_CHUNKS = 23
const W_LIBC_MAPS = 26
const W_CLOCK = 24
const W_CACHE = 25

/// The cache's table (a mapping of GRAIN bytes): its own size (word 0),
/// the bytes of the mappings it holds (word 1), their number (word 2),
/// then their addresses.
const CACHE_N = 16
const CACHE_MAX = 67108864

/// A large mapping's size is a multiple of this (16 KiB pages on Apple
/// silicon, 64 KiB the Windows allocation granularity).
const GRAIN = 65536

/// The bytes of a chunk (xo_rt.c XO_CHUNK).
const CHUNK = 4194304

// slot atomics' orders (rt.xo: 0 relaxed, 1 acquire, 2 release, 3
// acq_rel, 4 seq_cst: an order off by one left the central lists' lock
// without acquire, bench/results/heap-platform-2026-10-14.md)
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2

/// The mappings made through the C library so far.
pub fn libc_maps() -> Int { rt.slot_load(rt.static_word(W_LIBC_MAPS), 0, RELAXED) }

/// size bytes of zeroed memory, readable and writable, from the system:
/// its address. Out of memory ends the process. A sanitizer build maps
/// through the C library (sanhook.xo heap_map): ThreadSanitizer and
/// AddressSanitizer see a mapping through their mmap interceptors, which
/// a system call bypasses. Only the Linux and macOS arms test for it: a
/// Windows build must not reference the C library's mmap, which it lacks
/// (its link fails), and target.os folds there.
pub fn map(size: Int) -> Int {
  var m = 0
  match target.os {
    TargetOs.Linux => {
      if sanhook.sanitized() {
        return libc_map(size)
      }
      // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
      m = linux.mmap(0, size, 3, 34, -1, 0)
      if m < 0 && m > -4096 {
        m = 0
      }
    }
    TargetOs.Darwin => {
      if sanhook.sanitized() {
        return libc_map(size)
      }
      // MAP_PRIVATE | MAP_ANON
      m = sys_darwin.mmap(0, size, 3, 4098, -1, 0)
      if m == -1 {
        m = 0
      }
    }
    TargetOs.Windows => {
      // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE
      m = sys_windows.VirtualAlloc(0, size, 12288, 4)
    }
    TargetOs.Wasi => {}
  }
  if m == 0 {
    oom()
  }
  m
}

/// map through the C library (a sanitizer build on Linux or macOS),
/// counted.
fn libc_map(size: Int) -> Int {
  let m = sanhook.heap_map(size)
  if m == 0 {
    oom()
  }
  let _n = rt.slot_add(rt.static_word(W_LIBC_MAPS), 0, 1, RELAXED)
  m
}

/// Gives back the mapping of size bytes at m.
pub fn unmap(m: Int, size: Int) {
  match target.os {
    TargetOs.Linux => {
      if sanhook.sanitized() {
        sanhook.heap_unmap(m, size)
        return
      }
      let _r = linux.munmap(m, size)
    }
    TargetOs.Darwin => {
      if sanhook.sanitized() {
        sanhook.heap_unmap(m, size)
        return
      }
      let _r = sys_darwin.munmap(m, size)
    }
    TargetOs.Windows => {
      // MEM_RELEASE
      let _r = sys_windows.VirtualFree(m, 0, 32768)
    }
    TargetOs.Wasi => {}
  }
}

/// "fault: out of memory" and the end of the process (status 70).
pub fn oom() {
  let m = "fault: out of memory"
  stdio.err(raw.data(m), m.len(), true)
  process.os_exit(70)
}

/// A large block of n bytes: the address after its prefix (minus n).
pub fn large(n: Int) -> Int { large_room(n, n) }

/// A large block of n bytes in a mapping with room for at least room
/// (at least n) bytes.
fn large_room(n: Int, room: Int) -> Int {
  // the size word, the prefix, the bytes, rounded up to GRAIN
  let need = rt.int_wrap(0, n, 16)
  var m = take(need)
  if m == 0 {
    let size = rt.int_wrap(0, rt.int_wrap(0, room, 16), GRAIN - 1) & (0 - GRAIN)
    m = map(size)
    rt.mem_store(m, 0, size, 8)
  }
  rt.mem_store(m, 8, rt.int_wrap(1, 0, n), 8)
  rt.int_wrap(0, m, 16)
}

/// The large block whose prefix is at b, made n bytes: in place when its
/// mapping has the room, else a new block with its first bytes (the
/// smaller size's), the old one given back.
pub fn large_resize(b: Int, n: Int) -> Int {
  let m = rt.int_wrap(1, b, 8)
  if rt.int_wrap(0, n, 16) <= rt.mem_load(m, 0, 8) {
    rt.mem_store(b, 0, rt.int_wrap(1, 0, n), 8)
    return rt.int_wrap(0, b, 8)
  }
  let old = rt.int_wrap(1, 0, rt.mem_load(b, 0, 8))
  // a growing block (a list's or a string's doubling) gets room for
  // twice n, so its next growth stays in place: the pages past what is
  // written are reserved, not used (realloc grows a large block in place
  // or remaps its pages)
  let p = large_room(n, if n > old { rt.int_wrap(3, n, 1) } else { n })
  rt.mem_copy(p, rt.int_wrap(0, b, 8), if old < n { old } else { n })
  release(b)
  p
}

/// Gives back the large block whose prefix is at b: to the cache, or to
/// the system when the cache is full.
pub fn release(b: Int) {
  let m = rt.int_wrap(1, b, 8)
  let size = rt.mem_load(m, 0, 8)
  if !keep(m, size) {
    unmap(m, size)
  }
}

/// Puts the mapping m of size bytes in the cache: whether it went there.
fn keep(m: Int, size: Int) -> Bool {
  let w = rt.static_word(W_CACHE)
  clock_take()
  var t = rt.mem_load(w, 0, 8)
  if t == 0 {
    // the table: a mapping of its own, kept for good
    t = map(GRAIN)
    rt.mem_store(t, 0, GRAIN, 8)
    rt.mem_store(w, 0, t, 8)
  }
  let bytes = rt.mem_load(t, 8, 8)
  let k = rt.mem_load(t, 16, 8)
  if k >= CACHE_N || rt.int_wrap(0, bytes, size) > CACHE_MAX {
    clock_give()
    return false
  }
  rt.mem_store(t, rt.int_wrap(0, 24, rt.int_wrap(3, k, 3)), m, 8)
  rt.mem_store(t, 16, rt.int_wrap(0, k, 1), 8)
  rt.mem_store(t, 8, rt.int_wrap(0, bytes, size), 8)
  clock_give()
  true
}

/// A cached mapping of at least need bytes and at most four times that
/// (so a small block does not hold a huge mapping), the latest given
/// back first; 0 when there is none.
fn take(need: Int) -> Int {
  let w = rt.static_word(W_CACHE)
  if rt.mem_load(w, 0, 8) == 0 {
    return 0
  }
  clock_take()
  let t = rt.mem_load(w, 0, 8)
  var k = rt.mem_load(t, 16, 8)
  let most = rt.int_wrap(3, need, 2)
  while k > 0 {
    k = rt.int_wrap(1, k, 1)
    let at = rt.int_wrap(0, 24, rt.int_wrap(3, k, 3))
    let m = rt.mem_load(t, at, 8)
    let size = rt.mem_load(m, 0, 8)
    if size >= need && size <= most {
      // the last entry fills the gap
      let n = rt.int_wrap(1, rt.mem_load(t, 16, 8), 1)
      rt.mem_store(t, at, rt.mem_load(t, rt.int_wrap(0, 24, rt.int_wrap(3, n, 3)), 8), 8)
      rt.mem_store(t, 16, n, 8)
      rt.mem_store(t, 8, rt.int_wrap(1, rt.mem_load(t, 8, 8), size), 8)
      clock_give()
      return m
    }
  }
  clock_give()
  0
}

/// Takes and releases the cache's lock.
fn clock_take() {
  let l = rt.static_word(W_CLOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
}

fn clock_give() {
  let l = rt.static_word(W_CLOCK)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

/// Gives heap record h a new chunk to carve blocks from (its bump words
/// at 24 and 32, alloc.xo BUMP_CUR and BUMP_END).
pub fn chunk(h: Int) {
  let c = map(CHUNK)
  let _n = rt.slot_add(rt.static_word(W_CHUNKS), 0, 1, RELAXED)
  rt.mem_store(h, 24, c, 8)
  rt.mem_store(h, 32, rt.int_wrap(0, c, CHUNK), 8)
}

/// The chunks mapped so far.
pub fn chunks() -> Int { rt.slot_load(rt.static_word(W_CHUNKS), 0, RELAXED) }

/// Takes the central lists' lock.
pub fn lock() {
  let l = rt.static_word(W_LOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
}

/// Releases it.
pub fn unlock() {
  let l = rt.static_word(W_LOCK)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

// ---------------------------------------------------------------------------
// The heap records of threads (xo_rt.c heap_slow, work item B21 part 2):
// a thread's first allocation after the program went threaded gets a
// record of its own, mapped (zeroed) and linked into the list of every
// record, which the leak check and the heap statistics sum. Records are
// never freed (the threads that use them are the pool's, which live as
// long as the program).

/// The heap record's words this module reads and writes (xo_rt.c struct
/// xo_heap, its offsets asserted there): the largest block the classes
/// serve, the central lists' address, the counts of blocks allocated and
/// freed (alloc.xo ALLOCS, FREES), the per class free list lengths
/// (alloc.xo NFREE), and the link of the list of every record.
const H_ALLOCS = 0
const H_FREES = 8
const H_MID_MAX = 56
const H_CENTRAL = 64
const H_NFREE = 664
const H_NEXT = 2136
/// Whether the record counts (alloc.xo COUNT).
const H_COUNT = 1864
/// The heap profile (heapprof.xo, alloc.xo SAMPLE_AT): whether it runs
/// (a thread's new record copies it), and the bytes allocated at which
/// the record's next sample is taken (the largest Int: none).
const H_PROF = 1872
const H_SAMPLE_AT = 10344
const NEVER = 9223372036854775807

/// The thread local word of the calling thread's heap record (sched.xo
/// TLS_HEAP).
const TLS_HEAP = 3

/// rt.static_word: the list of every heap record (its first record, the
/// main one at start), its lock word, and a record's size.
const W_HEAPS = 27
const W_HLOCK = 28
const W_HSIZE = 29

/// A heap record's size (alloc.xo's and obj.xo's fields, then the
/// real-time section's queue of 256 entries of 32 bytes: xo_rt.c's
/// xo_heap until decision 0233 step 2; then the heap profile's next
/// sample, its thread state, and its sampled block: alloc.xo SAMPLE_AT,
/// heapprof.xo H_PSTATE, alloc.xo PSAMPLE), the size classes' limit
/// (XO_HEAP_MID_MAX lowers it), and the central lists' words (a list
/// per size class, 1 to 72).
const H_SIZE = 2152 + 32 * 256 + 24
const MID_MAX = 262144
const NCLASS1 = 73

/// Makes the main heap record and the central lists (C main, before
/// anything allocates) and starts the list of every record with it: its
/// address.
pub fn main_record() -> Int {
  let h = map(H_SIZE)
  rt.mem_store(h, H_MID_MAX, MID_MAX, 8)
  rt.mem_store(h, H_COUNT, 1, 8)
  rt.mem_store(h, H_SAMPLE_AT, NEVER, 8)
  rt.mem_store(h, H_CENTRAL, map(8 * NCLASS1), 8)
  rt.mem_store(rt.static_word(W_HEAPS), 0, h, 8)
  rt.mem_store(rt.static_word(W_HSIZE), 0, H_SIZE, 8)
  h
}

/// Stops the counting of allocations and frees (alloc.xo COUNT) on the
/// main record, which the threads' records copy (the program's start,
/// before a second thread: no report reads the counts).
pub fn counting_off() { rt.mem_store(rt.mem_load(rt.static_word(W_HEAPS), 0, 8), H_COUNT, 0, 8) }

/// Counts on every record from now on (a budget's stretch, which reads
/// its record's allocated bytes): nothing when record h, the caller's,
/// already counts; else each record under the list's lock, the first
/// (which new records copy) among them.
pub fn counting_on(h: Int) {
  if rt.mem_load(h, H_COUNT, 8) != 0 {
    return
  }
  hlock_take()
  var r = rt.mem_load(rt.static_word(W_HEAPS), 0, 8)
  while r != 0 {
    rt.mem_store(r, H_COUNT, 1, 8)
    r = rt.mem_load(r, H_NEXT, 8)
  }
  hlock_give()
}

/// Lowers the size classes' limit to m (XO_HEAP_MID_MAX, at start: the
/// main record, which the others copy).
pub fn set_mid_max(m: Int) { rt.mem_store(rt.mem_load(rt.static_word(W_HEAPS), 0, 8), H_MID_MAX, m, 8) }

/// Makes record h the calling thread's (the main thread, when a second
/// thread is about to run Xo code).
pub fn set_thread_heap(h: Int) { rt.tlocal_set(TLS_HEAP, h) }

/// The calling thread's heap record, made on its first use: the size
/// classes' limit and the central lists are the other records'.
pub fn thread_heap() -> Int {
  let t = rt.tlocal_get(TLS_HEAP)
  if t != 0 {
    return t
  }
  let h = map(rt.mem_load(rt.static_word(W_HSIZE), 0, 8))
  let w = rt.static_word(W_HEAPS)
  hlock_take()
  let first = rt.mem_load(w, 0, 8)
  rt.mem_store(h, H_MID_MAX, rt.mem_load(first, H_MID_MAX, 8), 8)
  rt.mem_store(h, H_CENTRAL, rt.mem_load(first, H_CENTRAL, 8), 8)
  rt.mem_store(h, H_COUNT, rt.mem_load(first, H_COUNT, 8), 8)
  let prof = rt.mem_load(first, H_PROF, 8)
  rt.mem_store(h, H_PROF, prof, 8)
  // profiling: the first allocation's hook draws this record's first gap
  rt.mem_store(h, H_SAMPLE_AT, if prof != 0 { 0 } else { NEVER }, 8)
  rt.mem_store(h, H_NEXT, first, 8)
  rt.mem_store(w, 0, h, 8)
  hlock_give()
  rt.tlocal_set(TLS_HEAP, h)
  h
}

/// Starts the heap profile on every record (prof.xo start_heap): counting
/// on (alloc.xo COUNT, where the sample check is), and each record's
/// next sample at once (the hook draws its first gap).
pub fn profile_on() {
  hlock_take()
  var r = rt.mem_load(rt.static_word(W_HEAPS), 0, 8)
  while r != 0 {
    rt.mem_store(r, H_COUNT, 1, 8)
    rt.mem_store(r, H_PROF, 1, 8)
    rt.mem_store(r, H_SAMPLE_AT, 0, 8)
    r = rt.mem_load(r, H_NEXT, 8)
  }
  hlock_give()
}

/// The blocks allocated and not freed, and the blocks allocated, over
/// every record, stored at lp and tp (the leak check).
pub fn live(lp: Int, tp: Int) {
  var l = 0
  var t = 0
  hlock_take()
  var h = rt.mem_load(rt.static_word(W_HEAPS), 0, 8)
  while h != 0 {
    let a = rt.mem_load(h, H_ALLOCS, 8)
    l = rt.int_wrap(0, l, rt.int_wrap(1, a, rt.mem_load(h, H_FREES, 8)))
    t = rt.int_wrap(0, t, a)
    h = rt.mem_load(h, H_NEXT, 8)
  }
  hlock_give()
  rt.mem_store(lp, 0, l, 8)
  rt.mem_store(tp, 0, t, 8)
}

/// The blocks on class c's free lists over every record (the heap
/// statistics).
pub fn nfree(c: Int) -> Int {
  var n = 0
  hlock_take()
  var h = rt.mem_load(rt.static_word(W_HEAPS), 0, 8)
  while h != 0 {
    n = rt.int_wrap(0, n, rt.mem_load(h, rt.int_wrap(0, H_NFREE, rt.int_wrap(3, c, 3)), 8))
    h = rt.mem_load(h, H_NEXT, 8)
  }
  hlock_give()
  n
}

fn hlock_take() {
  let l = rt.static_word(W_HLOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
}

fn hlock_give() {
  let l = rt.static_word(W_HLOCK)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}
