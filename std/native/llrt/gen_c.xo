// The C path of the scalar values of property tests (decisions 0193 and
// 0195): the API of gen.xo over the C runtime's functions
// (std/llrt/xo_testing.c, compiled with -DXO_GEN_C). Loaded in place of
// gen.xo when XO_LLRT_C names `gen`; the Go SSA builder then calls the C
// runtime directly. The self hosted compiler always uses gen.xo.
use native/rttest

pub fn size(g: Int) -> Int { rttest.gen_size(g) }

pub fn any_int(g: Int) -> Int { rttest.gen_any_int(g) }

pub fn sized(g: Int, kind: Int) -> Int { rttest.gen_sized(g, kind) }

pub fn float(g: Int) -> Float { rttest.gen_float(g) }

pub fn rune(g: Int) -> Int { rttest.gen_rune(g) }

pub fn str(g: Int) -> Str { rttest.gen_str(g) }

pub fn duration(g: Int) -> Int { rttest.gen_duration(g) }

pub fn time(g: Int) -> Int { rttest.gen_time(g) }
