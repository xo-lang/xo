// DES and Triple DES (FIPS 46-3), for PKCS #12's pbeWithSHAAnd3-KeyTripleDES-CBC.
// A port of Go's crypto/des (BSD, Copyright 2010 The Go Authors): the tables are
// its const.go, the block function its cryptBlock and feistel, written bit by
// bit through permute_block instead of Go's unrolled initial and final
// permutations. Broken for security: here only to open old files.

const INITIAL: List[Int] = [6, 14, 22, 30, 38, 46, 54, 62, 4, 12, 20, 28, 36, 44, 52, 60, 2, 10, 18, 26, 34, 42, 50, 58, 0, 8, 16, 24, 32, 40, 48, 56, 7, 15, 23, 31, 39, 47, 55, 63, 5, 13, 21, 29, 37, 45, 53, 61, 3, 11, 19, 27, 35, 43, 51, 59, 1, 9, 17, 25, 33, 41, 49, 57]
const FINAL: List[Int] = [24, 56, 16, 48, 8, 40, 0, 32, 25, 57, 17, 49, 9, 41, 1, 33, 26, 58, 18, 50, 10, 42, 2, 34, 27, 59, 19, 51, 11, 43, 3, 35, 28, 60, 20, 52, 12, 44, 4, 36, 29, 61, 21, 53, 13, 45, 5, 37, 30, 62, 22, 54, 14, 46, 6, 38, 31, 63, 23, 55, 15, 47, 7, 39]
const PC1: List[Int] = [7, 15, 23, 31, 39, 47, 55, 63, 6, 14, 22, 30, 38, 46, 54, 62, 5, 13, 21, 29, 37, 45, 53, 61, 4, 12, 20, 28, 1, 9, 17, 25, 33, 41, 49, 57, 2, 10, 18, 26, 34, 42, 50, 58, 3, 11, 19, 27, 35, 43, 51, 59, 36, 44, 52, 60]
const PC2: List[Int] = [42, 39, 45, 32, 55, 51, 53, 28, 41, 50, 35, 46, 33, 37, 44, 52, 30, 48, 40, 49, 29, 36, 43, 54, 15, 4, 25, 19, 9, 1, 26, 16, 5, 11, 23, 8, 12, 7, 17, 0, 22, 3, 10, 14, 6, 20, 27, 24]
const PERM: List[Int] = [16, 25, 12, 11, 3, 20, 4, 15, 31, 17, 9, 6, 27, 14, 1, 22, 30, 24, 8, 18, 0, 5, 29, 23, 13, 19, 2, 26, 10, 21, 28, 7]
const ROT: List[Int] = [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1]
const SBOX: List[Int] = [14, 4, 13, 1, 2, 15, 11, 8, 3, 10, 6, 12, 5, 9, 0, 7, 0, 15, 7, 4, 14, 2, 13, 1, 10, 6, 12, 11, 9, 5, 3, 8, 4, 1, 14, 8, 13, 6, 2, 11, 15, 12, 9, 7, 3, 10, 5, 0, 15, 12, 8, 2, 4, 9, 1, 7, 5, 11, 3, 14, 10, 0, 6, 13, 15, 1, 8, 14, 6, 11, 3, 4, 9, 7, 2, 13, 12, 0, 5, 10, 3, 13, 4, 7, 15, 2, 8, 14, 12, 0, 1, 10, 6, 9, 11, 5, 0, 14, 7, 11, 10, 4, 13, 1, 5, 8, 12, 6, 9, 3, 2, 15, 13, 8, 10, 1, 3, 15, 4, 2, 11, 6, 7, 12, 0, 5, 14, 9, 10, 0, 9, 14, 6, 3, 15, 5, 1, 13, 12, 7, 11, 4, 2, 8, 13, 7, 0, 9, 3, 4, 6, 10, 2, 8, 5, 14, 12, 11, 15, 1, 13, 6, 4, 9, 8, 15, 3, 0, 11, 1, 2, 12, 5, 10, 14, 7, 1, 10, 13, 0, 6, 9, 8, 7, 4, 15, 14, 3, 11, 5, 2, 12, 7, 13, 14, 3, 0, 6, 9, 10, 1, 2, 8, 5, 11, 12, 4, 15, 13, 8, 11, 5, 6, 15, 0, 3, 4, 7, 2, 12, 1, 10, 14, 9, 10, 6, 9, 0, 12, 11, 7, 13, 15, 1, 3, 14, 5, 2, 8, 4, 3, 15, 0, 6, 10, 1, 13, 8, 9, 4, 5, 11, 12, 7, 2, 14, 2, 12, 4, 1, 7, 10, 11, 6, 8, 5, 3, 15, 13, 0, 14, 9, 14, 11, 2, 12, 4, 7, 13, 1, 5, 0, 15, 10, 3, 9, 8, 6, 4, 2, 1, 11, 10, 13, 7, 8, 15, 9, 12, 5, 6, 3, 0, 14, 11, 8, 12, 7, 1, 14, 2, 13, 6, 15, 0, 9, 10, 4, 5, 3, 12, 1, 10, 15, 9, 2, 6, 8, 0, 13, 3, 4, 14, 7, 5, 11, 10, 15, 4, 2, 7, 12, 9, 5, 6, 1, 13, 14, 0, 11, 3, 8, 9, 14, 15, 5, 2, 8, 12, 3, 7, 0, 4, 10, 1, 13, 11, 6, 4, 3, 2, 12, 9, 5, 15, 10, 11, 14, 1, 7, 6, 0, 8, 13, 4, 11, 2, 14, 15, 0, 8, 13, 3, 12, 9, 7, 5, 10, 6, 1, 13, 0, 11, 7, 4, 9, 1, 10, 14, 3, 5, 12, 2, 15, 8, 6, 1, 4, 11, 13, 12, 3, 7, 14, 10, 15, 6, 8, 0, 5, 9, 2, 6, 11, 13, 8, 1, 4, 10, 7, 9, 5, 0, 15, 14, 2, 3, 12, 13, 2, 8, 4, 6, 15, 11, 1, 10, 9, 3, 14, 5, 0, 12, 7, 1, 15, 13, 8, 10, 3, 7, 4, 12, 5, 6, 11, 0, 14, 9, 2, 7, 11, 4, 1, 9, 12, 14, 2, 0, 6, 10, 13, 15, 3, 5, 8, 2, 1, 14, 7, 4, 10, 8, 13, 15, 12, 9, 0, 3, 5, 6, 11]

const M32: Int = 0xFFFFFFFF

/// Go's permuteBlock: bit n of src (counting from the least significant bit) goes to
/// position len-1-i of the result for the i'th table entry.
fn permute_block(src: UInt64, table: List[Int]) -> UInt64 {
  var block: UInt64 = 0
  let n = table.len()
  for i in 0..n {
    let bit = (src >> UInt64(table[i])) & 1
    block = block | (bit << UInt64(n - 1 - i))
  }
  block
}

/// feistelBox[s][t]: Go's initFeistelBox.
fn feistel_box() -> List[Int] {
  var box: List[Int] = []
  for _ in 0..512 {
    box.push(0)
  }
  for s in 0..8 {
    for i in 0..4 {
      for j in 0..16 {
        var f = SBOX[s * 64 + i * 16 + j] << (4 * (7 - s))
        f = Int(permute_block(UInt64(f), PERM))
        let row = ((i & 2) << 4) | (i & 1)
        let col = j << 1
        let t = row | col
        f = ((f << 1) | (f >> 31)) & M32
        box[s * 64 + t] = f
      }
    }
  }
  box
}

pub struct Des {
  subkeys: List[Int]
  box: List[Int]
}

fn ks_rotate(inp: Int) -> List[Int] {
  var out: List[Int] = []
  var last = inp
  for i in 0..16 {
    let left = ((last << (4 + ROT[i])) & M32) >> 4
    let right = ((last << 4) & M32) >> (32 - ROT[i])
    last = left | right
    out.push(last)
  }
  out
}

/// Go's unpack: 48 bits spread to 64, each 6-bit block in its own byte, as the high and low 32 bits.
fn unpack_hi(x: Int) -> Int {
  (((x >> 0) & 0xff) << 0) | (((x >> 12) & 0xff) << 8) | (((x >> 24) & 0xff) << 16) | (((x >> 36) & 0xff) << 24)
}

fn unpack_lo(x: Int) -> Int {
  (((x >> 6) & 0xff) << 0) | (((x >> 18) & 0xff) << 8) | (((x >> 30) & 0xff) << 16) | (((x >> 42) & 0xff) << 24)
}

fn be64(b: Bytes, at: Int) -> UInt64 {
  var v: UInt64 = 0
  for i in 0..8 {
    v = (v << 8) | UInt64(b[at + i])
  }
  v
}

/// The cipher of an 8 byte key.
pub fn new_des(key: Bytes) -> Des {
  let pk = Int(permute_block(be64(key, 0), PC1))
  let lr = ks_rotate((pk >> 28) & M32)
  let rr = ks_rotate(((pk << 4) & M32) >> 4)
  var subkeys: List[Int] = []
  for i in 0..16 {
    let pc2 = (lr[i] << 28) | rr[i]
    let k = Int(permute_block(UInt64(pc2), PC2))
    subkeys.push(unpack_hi(k))
    subkeys.push(unpack_lo(k))
  }
  Des{subkeys: subkeys, box: feistel_box()}
}

fn sbox_a(box: List[Int], t: Int) -> Int {
  box[7 * 64 + (t & 0x3f)] ^ box[5 * 64 + ((t >> 8) & 0x3f)] ^ box[3 * 64 + ((t >> 16) & 0x3f)] ^ box[1 * 64 + ((t >> 24) & 0x3f)]
}

fn sbox_b(box: List[Int], t: Int) -> Int {
  box[6 * 64 + (t & 0x3f)] ^ box[4 * 64 + ((t >> 8) & 0x3f)] ^ box[2 * 64 + ((t >> 16) & 0x3f)] ^ box[0 * 64 + ((t >> 24) & 0x3f)]
}

/// One block (the 8 bytes at `at`), encrypted or decrypted.
pub fn crypt_block(c: Des, src: Bytes, at: Int, decrypt: Bool) -> Bytes {
  let b = permute_block(be64(src, at), INITIAL)
  var l = Int(b >> 32)
  var r = Int(b & 0xFFFFFFFF)
  l = ((l << 1) | (l >> 31)) & M32
  r = ((r << 1) | (r >> 31)) & M32
  for i in 0..8 {
    let a = if decrypt { 15 - 2 * i } else { 2 * i }
    let b = if decrypt { 15 - (2 * i + 1) } else { 2 * i + 1 }
    let k0h = c.subkeys[2 * a]
    let k0l = c.subkeys[2 * a + 1]
    let k1h = c.subkeys[2 * b]
    let k1l = c.subkeys[2 * b + 1]
    var t = (r ^ k0h) & M32
    l = l ^ sbox_a(c.box, t)
    t = ((((r << 28) & M32) | (r >> 4)) ^ k0l) & M32
    l = l ^ sbox_b(c.box, t)
    t = (l ^ k1h) & M32
    r = r ^ sbox_a(c.box, t)
    t = ((((l << 28) & M32) | (l >> 4)) ^ k1l) & M32
    r = r ^ sbox_b(c.box, t)
  }
  l = (((l << 31) & M32) | (l >> 1)) & M32
  r = (((r << 31) & M32) | (r >> 1)) & M32
  let o = permute_block((UInt64(r) << 32) | UInt64(l), FINAL)
  var out = BytesBuilder.new()
  for i in 0..8 {
    out.write_byte(UInt8((o >> UInt64(56 - 8 * i)) & 0xff))
  }
  out.freeze()
}

/// Triple DES (EDE) with a key of 24 bytes.
pub struct Des3 {
  a: Des
  b: Des
  c: Des
}

pub fn new_des3(key: Bytes) -> Des3 {
  Des3{a: new_des(key[0..8]), b: new_des(key[8..16]), c: new_des(key[16..24])}
}

pub fn crypt3(c: Des3, src: Bytes, at: Int, decrypt: Bool) -> Bytes {
  if decrypt {
    let x = crypt_block(c.c, src, at, true)
    let y = crypt_block(c.b, x, 0, false)
    return crypt_block(c.a, y, 0, true)
  }
  let x = crypt_block(c.a, src, at, false)
  let y = crypt_block(c.b, x, 0, true)
  crypt_block(c.c, y, 0, false)
}

/// CBC decryption of data (a multiple of 8 bytes) with the 8 byte iv.
pub fn cbc_decrypt3(c: Des3, iv: Bytes, data: Bytes) -> Bytes {
  var out = BytesBuilder.new()
  var prev = iv
  var at = 0
  while at + 8 <= data.len() {
    let p = crypt3(c, data, at, true)
    for i in 0..8 {
      out.write_byte(p[i] ^ prev[i])
    }
    prev = data[at..at + 8]
    at += 8
  }
  out.freeze()
}
