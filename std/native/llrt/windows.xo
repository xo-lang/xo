// The Windows layer of the native runtime, written in Xo (decision 0213,
// decision 0195 prerequisite 3): kernel32 and bcrypt called with the C
// ABI through std/native/sys_windows.xo, in place of the C runtime's
// POSIX shim (std/llrt/xo_win.c) over the Microsoft C runtime. Its API is
// linux.xo's and darwin.xo's: a call returns its result (>= 0: a count,
// or a HANDLE, which is a positive address), or a negative errno: the
// errno the C path reports for the same failure (the C runtime's
// _dosmaperr of GetLastError for opens, reads, writes, and closes, as
// _wopen, _read, _write, and _close set it; xo_win.c's own map for
// stat), refined as xo_w_fix refines it (ENOTDIR when a parent of the
// path is a file, EISDIR when an open of a directory was refused), so
// the messages are the C runtime's strerror texts byte for byte.
//
// Only the Windows arms of std/native/llrt/sysio.xo call this module; the
// SSA builders make its platform calls faults on another OS.
use native/llrt/obj
use native/llrt/raw
use native/rt
use native/sys_windows

// errno values of the Microsoft C runtime (errno.h)
pub const EPERM: Int = 1
pub const ENOENT: Int = 2
pub const EINTR: Int = 4
pub const EIO: Int = 5
pub const EBADF: Int = 9
pub const ENOMEM: Int = 12
pub const EACCES: Int = 13
pub const EEXIST: Int = 17
pub const ENOTDIR: Int = 20
pub const EISDIR: Int = 21
pub const EINVAL: Int = 22
pub const ENOSPC: Int = 28
pub const ENOTEMPTY: Int = 41

// CreateFileW's arguments (winnt.h, fileapi.h)
const GENERIC_READ: Int = 2147483648
const GENERIC_WRITE: Int = 1073741824
const FILE_READ_ATTRIBUTES: Int = 128
const FILE_SHARE_READ: Int = 1
const FILE_SHARE_WRITE: Int = 2
const FILE_SHARE_DELETE: Int = 4
const CREATE_ALWAYS: Int = 2
const OPEN_EXISTING: Int = 3
const FILE_ATTRIBUTE_NORMAL: Int = 128
const FILE_FLAG_BACKUP_SEMANTICS: Int = 33554432
const FILE_FLAG_OPEN_REPARSE_POINT: Int = 2097152
const FILE_ATTRIBUTE_DIRECTORY: Int = 16
const FILE_ATTRIBUTE_REPARSE_POINT: Int = 1024
const INVALID_FILE_ATTRIBUTES: Int = 4294967295
const FILE_TYPE_UNKNOWN: Int = 0
const ERROR_ACCESS_DENIED: Int = 5
const ERROR_BROKEN_PIPE: Int = 109
const ERROR_CANT_ACCESS_FILE: Int = 1920
const BCRYPT_USE_SYSTEM_PREFERRED_RNG: Int = 2
// GetStdHandle's arguments, (DWORD)-11 and (DWORD)-12 (processenv.h)
const STD_OUTPUT_HANDLE: Int = 4294967285
const STD_ERROR_HANDLE: Int = 4294967284

/// The handle of op opened for reading, as the C runtime's
/// _wopen(_O_RDONLY | _O_BINARY | _O_NOINHERIT) opens it, or the negative
/// errno.
pub fn open_read(path: Str) -> Int { open(path, GENERIC_READ, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL) }

/// The handle of op created or truncated for writing (_wopen with
/// _O_WRONLY | _O_CREAT | _O_TRUNC, mode 0644: not read-only), or the
/// negative errno.
pub fn open_write(path: Str) -> Int { open(path, GENERIC_WRITE, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL) }

/// CreateFileW as _wopen calls it (shared for reading and writing, not
/// inherited, the attributes attr of a new file), the error refined as
/// xo_w_open does.
fn open(path: Str, access: Int, disposition: Int, attr: Int) -> Int {
  let p = cpath(path)
  let w = wide(p)
  // a new file only (Fs.create_new, O_EXCL): a symbolic link at the path
  // is there even when it dangles, so it is not followed (its target is
  // not created); GetFileAttributesW reads the link itself too (Wine
  // follows links in both, so a dangling one is still created there:
  // fs_create_new stays a Wine gap)
  if disposition == CREATE_NEW && attrs(p) != INVALID_FILE_ATTRIBUTES {
    return -EEXIST
  }
  let flags = if disposition == CREATE_NEW { attr | FILE_FLAG_OPEN_REPARSE_POINT } else { attr }
  let h = sys_windows.CreateFileW(w, access, FILE_SHARE_READ | FILE_SHARE_WRITE, 0, disposition, flags, 0)
  // the last error read while w is alive: a release between the call
  // and GetLastError would run the allocator
  let le = keep(w, if h == -1 { Int(sys_windows.GetLastError()) } else { 0 })
  if h == -1 {
    let e = dos_errno(le)
    // CreateFileW refuses a new file over a directory as access denied;
    // O_EXCL reports that anything is there
    if disposition == CREATE_NEW && e == EACCES && attrs(p) != INVALID_FILE_ATTRIBUTES {
      return -EEXIST
    }
    return -fix(p, e, true)
  }
  if Int(sys_windows.GetFileType(h)) == FILE_TYPE_UNKNOWN {
    // _wopen refuses a handle of an unknown type
    let e = Int(sys_windows.GetLastError())
    sys_windows.CloseHandle(h)
    return -dos_errno(e)
  }
  h
}

/// ReadFile of at most n bytes into buf from off on: the count (0 at the
/// end, or after a broken pipe, as _read), or the negative errno.
pub fn read(h: Int, buf: Bytes, off: Int, n: Int) -> Int {
  let done = obj.scratch()
  let k = if n > 2147483647 { 2147483647 } else { n }
  let ok = sys_windows.ReadFile(h, raw.bytes_addr(buf) + off, k, done, 0)
  if Int(ok) == 0 {
    let e = Int(sys_windows.GetLastError())
    if e == ERROR_BROKEN_PIPE {
      return keep(buf, 0)
    }
    if e == ERROR_ACCESS_DENIED {
      return keep(buf, -EBADF)
    }
    return keep(buf, -dos_errno(e))
  }
  keep(buf, rt.mem_load(done, 0, 8) & 4294967295)
}

/// Writes all of b (WriteFile until it is written, as _write): 0, or the
/// errno.
pub fn write_all(h: Int, b: Bytes) -> Int {
  let done = obj.scratch()
  var off = 0
  let n = b.len()
  while off < n {
    let k = if n - off > 2147483647 { 2147483647 } else { n - off }
    let ok = sys_windows.WriteFile(h, raw.bytes_addr(b) + off, k, done, 0)
    if Int(ok) == 0 {
      let e = Int(sys_windows.GetLastError())
      return keep(b, if e == ERROR_ACCESS_DENIED { EBADF } else { dos_errno(e) })
    }
    let w = rt.mem_load(done, 0, 8) & 4294967295
    if w == 0 {
      // nothing written and no error: _write's ENOSPC
      return keep(b, ENOSPC)
    }
    off += w
  }
  keep(b, 0)
}

/// WriteFile of the n bytes at the address a (at most 2 GiB of them) to
/// standard output (fd 1) or standard error (2): the bytes written, or
/// the negative errno (std/native/llrt/stdio.xo).
pub fn std_write_at(fd: Int, a: Int, n: Int) -> Int {
  let h = sys_windows.GetStdHandle(if fd == 2 { STD_ERROR_HANDLE } else { STD_OUTPUT_HANDLE })
  let done = obj.scratch()
  let k = if n > 2147483647 { 2147483647 } else { n }
  if Int(sys_windows.WriteFile(h, a, k, done, 0)) == 0 {
    return -dos_errno(Int(sys_windows.GetLastError()))
  }
  rt.mem_load(done, 0, 8) & 4294967295
}

/// GetDynamicTimeZoneInformation into the 432 bytes at z: whether the
/// system has a time zone setting (std/native/llrt/tzhost.xo).
pub fn zone_info(z: Int) -> Bool { Int(sys_windows.GetDynamicTimeZoneInformation(z)) != -1 }

/// Proc.kill's KILL on Windows (std/rt's sendSignal): TerminateProcess of
/// pid with exit code 137; "" or the error's text, prefixed by the call
/// that failed. UNTESTED on Windows (the zero-C push, 2026-10-14).
pub fn terminate(pid: Int) -> Str {
  // PROCESS_TERMINATE 1; ERROR_INVALID_PARAMETER 87
  if pid > 4294967295 {
    return "OpenProcess: " + strerror(dos_errno(87))
  }
  let h = sys_windows.OpenProcess(1, 0, pid)
  if h == 0 {
    return "OpenProcess: " + strerror(dos_errno(Int(sys_windows.GetLastError())))
  }
  var msg = ""
  if Int(sys_windows.TerminateProcess(h, 137)) == 0 {
    msg = "TerminateProcess: " + strerror(dos_errno(Int(sys_windows.GetLastError())))
  }
  let _c = sys_windows.CloseHandle(h)
  msg
}

/// CloseHandle: 0, or the negative errno.
pub fn close(h: Int) -> Int {
  if Int(sys_windows.CloseHandle(h)) == 0 {
    return -dos_errno(Int(sys_windows.GetLastError()))
  }
  0
}

/// The facts of a file: whether it is a directory, its size, and its
/// modification time in Unix nanoseconds.
pub struct Stat {
  pub is_dir: Bool
  pub size: Int
  pub mtime: Int
  /// st_mode as xo_w_fill_stat gives it
  pub mode: Int
}

/// Whether st is a symbolic link (a reparse point stat did not follow).
pub fn is_link(st: Stat) -> Bool { st.mode == S_IFLNK_ALL }

/// The size of the open file h, or -1.
pub fn file_size(h: Int) -> Int {
  let (s, e) = info(h, false)
  if e == 0 { s.size } else { -1 }
}

/// stat of path (of a final symbolic link itself unless follow), as
/// xo_win.c's xo_w_stat_path: the facts and 0, or the errno.
pub fn stat(path: Str, follow: Bool) -> (Stat, Int) {
  let p = cpath(path)
  let w = wide(p)
  let share = FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
  let link = if follow { 0 } else { FILE_FLAG_OPEN_REPARSE_POINT }
  var h = sys_windows.CreateFileW(w, FILE_READ_ATTRIBUTES, share, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | link, 0)
  var e = Int(sys_windows.GetLastError())
  if h == -1 && follow && e == ERROR_CANT_ACCESS_FILE {
    // a reparse point the system cannot follow (an AF_UNIX socket
    // file): the point itself, as Go's os.Stat
    h = sys_windows.CreateFileW(w, FILE_READ_ATTRIBUTES, share, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, 0)
    e = Int(sys_windows.GetLastError())
  }
  // w alive until the last error is read (as in open)
  e = keep(w, e)
  if h == -1 {
    return (Stat{is_dir: false, size: 0, mtime: 0, mode: 0}, fix(p, shim_errno(e), false))
  }
  let r = info(h, !follow)
  sys_windows.CloseHandle(h)
  r
}

/// GetFileInformationByHandle of h (xo_w_fill_stat; link: a reparse
/// point is a link, not a directory).
fn info(h: Int, link: Bool) -> (Stat, Int) {
  let buf = obj.scratch()
  if Int(sys_windows.GetFileInformationByHandle(h, buf)) == 0 {
    return (Stat{is_dir: false, size: 0, mtime: 0, mode: 0}, shim_errno(Int(sys_windows.GetLastError())))
  }
  // BY_HANDLE_FILE_INFORMATION: dwFileAttributes at 0, ftLastWriteTime
  // at 20, nFileSizeHigh at 32 and nFileSizeLow at 36
  let attrs = rt.mem_load(buf, 0, 8) & 4294967295
  let ft = rt.mem_load(buf, 20, 8)
  let size = ((rt.mem_load(buf, 32, 8) & 4294967295) << 32) | (rt.mem_load(buf, 36, 8) & 4294967295)
  var dir = (attrs & FILE_ATTRIBUTE_DIRECTORY) != 0
  var mode = if dir { S_IFDIR_ALL } else if (attrs & FILE_ATTRIBUTE_READONLY) != 0 { S_IFREG | 292 } else { S_IFREG | 438 }
  if link && (attrs & FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
    dir = false
    mode = S_IFLNK_ALL
  }
  (Stat{is_dir: dir, size: size, mtime: (ft - 116444736000000000) * 100, mode: mode}, 0)
}

/// GetSystemTimePreciseAsFileTime: Unix nanoseconds (as xo_win.c's
/// clock_gettime of CLOCK_REALTIME did), the FILETIME through the 8
/// bytes of scratch at a.
pub fn clock_ns(a: Int) -> Int {
  sys_windows.GetSystemTimePreciseAsFileTime(a)
  // 100 ns intervals since 1601-01-01
  rt.mem_load(a, 0, 8).wrapping_sub(116444736000000000).wrapping_mul(100)
}

/// QueryPerformanceCounter in nanoseconds (as xo_win.c's clock_gettime
/// of CLOCK_MONOTONIC did), the counter through the 8 bytes of scratch at
/// a (16 bytes). The frequency is read once and kept in word 2 of
/// rt.sys_words.
pub fn mono_ns(a: Int) -> Int {
  let w = rt.sys_words()
  var q = rt.slot_load[Int](w, 2, 0)
  if q <= 0 {
    let _f = sys_windows.QueryPerformanceFrequency(a)
    q = rt.mem_load(a, 0, 8)
    if q <= 0 {
      q = 1
    }
    rt.slot_store[Int](w, 2, q, 0)
  }
  let _c = sys_windows.QueryPerformanceCounter(a)
  let c = rt.mem_load(a, 0, 8)
  // whole seconds and the rest, as the C did: no overflow for a
  // frequency below 9.2e9
  ((c / q).wrapping_mul(1000000000)).wrapping_add((c % q).wrapping_mul(1000000000) / q)
}

/// BCryptGenRandom of n bytes, 256 at a time (as the C runtime's
/// cr_entropy did): the bytes and 0, or EIO.
pub fn random(n: Int) -> (Bytes, Int) {
  let buf = raw.bytes_buf(n)
  var off = 0
  while off < n {
    let k = if n - off > 256 { 256 } else { n - off }
    if Int(sys_windows.BCryptGenRandom(0, raw.bytes_addr(buf) + off, k, BCRYPT_USE_SYSTEM_PREFERRED_RNG)) != 0 {
      return (b"", EIO)
    }
    off += k
  }
  (buf, 0)
}

/// path and a NUL byte ("." for ""): the UTF-8 the C path converts.
fn cpath(path: Str) -> Bytes {
  let p = if path.is_empty() { "." } else { path }
  var s = BytesBuilder.with_capacity(p.len() + 1)
  s.write(p.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// The UTF-16 (little endian) of the UTF-8 bytes of p up to its first NUL,
/// with a NUL: MultiByteToWideChar(CP_UTF8, 0, p, -1) of a valid string.
fn wide(p: Bytes) -> Bytes {
  var s = BytesBuilder.with_capacity(2 * p.len() + 2)
  var i = 0
  while i < p.len() && p[i] != 0 {
    let (r, n) = p.decode_rune(i)
    let c = Int(r)
    if c >= 65536 {
      let u = c - 65536
      unit(s, 55296 + (u >> 10))
      unit(s, 56320 + (u & 1023))
    } else {
      unit(s, c)
    }
    i += n
  }
  unit(s, 0)
  s.freeze()
}

fn unit(var s: BytesBuilder, u: Int) {
  s.write_byte(UInt8(u & 255))
  s.write_byte(UInt8(u >> 8))
}

/// r, after b (whose address a call used) is known alive up to here.
fn keep(b: Bytes, r: Int) -> Int {
  if b.len() < 0 {
    return -1
  }
  r
}

/// The attributes of the UTF-8 path p (NUL terminated), or
/// INVALID_FILE_ATTRIBUTES.
fn attrs(p: Bytes) -> Int { Int(sys_windows.GetFileAttributesW(wide(p))) }

/// xo_win.c's xo_w_fix: the errno e of a call on path p as POSIX reports
/// it: EISDIR for an open of a directory refused with EACCES (open), and
/// ENOTDIR for ENOENT when a parent of p is a file.
fn fix(p: Bytes, e: Int, open: Bool) -> Int {
  if e == EACCES && open {
    let a = attrs(p)
    if a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY) != 0 {
      return EISDIR
    }
    return e
  }
  if e != ENOENT {
    return e
  }
  // n: the length without the NUL
  let n = p.len() - 1
  var i = 1
  while i < n {
    let c = p[i]
    if (c == 47 || c == 92) && !(i == 2 && p[1] == 58) {
      var q = BytesBuilder.with_capacity(i + 1)
      q.write(p[0..i])
      q.write_byte(UInt8(0))
      let a = attrs(q.freeze())
      if a == INVALID_FILE_ATTRIBUTES {
        return e
      }
      if (a & FILE_ATTRIBUTE_DIRECTORY) == 0 {
        return ENOTDIR
      }
    }
    i += 1
  }
  e
}

/// xo_win.c's xo_w_errno: the errno of a Win32 error (stat's map).
fn shim_errno(e: Int) -> Int {
  match e {
    2 | 3 | 123 | 53 => ENOENT
    5 | 32 | 33 | 1314 => EACCES
    183 | 80 => EEXIST
    145 => ENOTEMPTY
    267 => ENOTDIR
    8 | 14 => ENOMEM
    4390 => EINVAL
    _ => EIO
  }
}

/// The Microsoft C runtime's errno of a Win32 error (_dosmaperr, as
/// _wopen, _read, _write, and _close set it).
pub fn dos_errno(e: Int) -> Int {
  match e {
    1 => 22
    2 | 3 => 2
    4 => 24
    5 => 13
    6 => 9
    7 | 8 | 9 => 12
    10 => 7
    11 => 8
    12 | 13 => 22
    15 => 2
    16 => 13
    17 => 18
    18 => 2
    33 => 13
    53 => 2
    65 => 13
    67 => 2
    80 => 17
    82 | 83 => 13
    87 => 22
    89 => 11
    108 => 13
    109 => 32
    112 => 28
    114 => 9
    124 => 22
    128 | 129 => 10
    130 => 9
    131 => 22
    132 => 13
    145 => 41
    158 => 13
    161 => 2
    164 => 11
    167 => 13
    183 => 17
    206 => 2
    215 => 11
    1816 => 12
    _ => {
      if e >= 19 && e <= 36 {
        return 13
      }
      if e >= 188 && e <= 202 {
        return 8
      }
      22
    }
  }
}

/// The Microsoft C runtime's strerror text of errno e (the C path's
/// messages on Windows), "Unknown error" outside its tables.
pub fn strerror(e: Int) -> Str {
  match e {
    0 => "No error"
    1 => "Operation not permitted"
    2 => "No such file or directory"
    3 => "No such process"
    4 => "Interrupted function call"
    5 => "Input/output error"
    6 => "No such device or address"
    7 => "Arg list too long"
    8 => "Exec format error"
    9 => "Bad file descriptor"
    10 => "No child processes"
    11 => "Resource temporarily unavailable"
    12 => "Not enough space"
    13 => "Permission denied"
    14 => "Bad address"
    16 => "Resource device"
    17 => "File exists"
    18 => "Improper link"
    19 => "No such device"
    20 => "Not a directory"
    21 => "Is a directory"
    22 => "Invalid argument"
    23 => "Too many open files in system"
    24 => "Too many open files"
    25 => "Inappropriate I/O control operation"
    27 => "File too large"
    28 => "No space left on device"
    29 => "Invalid seek"
    30 => "Read-only file system"
    31 => "Too many links"
    32 => "Broken pipe"
    33 => "Domain error"
    34 => "Result too large"
    36 => "Resource deadlock avoided"
    38 => "Filename too long"
    39 => "No locks available"
    40 => "Function not implemented"
    41 => "Directory not empty"
    42 => "Illegal byte sequence"
    100 => "address in use"
    101 => "address not available"
    102 => "address family not supported"
    103 => "connection already in progress"
    104 => "bad message"
    105 => "operation canceled"
    106 => "connection aborted"
    107 => "connection refused"
    108 => "connection reset"
    109 => "destination address required"
    110 => "host unreachable"
    111 => "identifier removed"
    112 => "operation in progress"
    113 => "already connected"
    114 => "too many symbolic link levels"
    115 => "message size"
    116 => "network down"
    117 => "network reset"
    118 => "network unreachable"
    119 => "no buffer space"
    120 => "no message available"
    121 => "no link"
    122 => "no message"
    123 => "no protocol option"
    124 => "no stream resources"
    125 => "not a stream"
    126 => "not connected"
    127 => "state not recoverable"
    128 => "not a socket"
    129 => "not supported"
    130 => "operation not supported"
    132 => "value too large"
    133 => "owner dead"
    134 => "protocol error"
    135 => "protocol not supported"
    136 => "wrong protocol type"
    137 => "stream timeout"
    138 => "timed out"
    139 => "text file busy"
    140 => "operation would block"
    _ => "Unknown error"
  }
}

/// The message of errno e as the C runtime records a file error: the
/// strerror text with its first letter lowered.
pub fn err_msg(e: Int) -> Str {
  let s = strerror(e)
  let b = s.bytes()
  if b.len() > 0 && b[0] >= 65 && b[0] <= 90 {
    return raw.byte_str(Int(b[0]) + 32) + raw.str_slice(s, 1, s.len())
  }
  s
}

/// The FsErr tag plus one of errno e (std/rt's mapFsErr): 1 NotFound, 2
/// Exists, 3 NotEmpty, 4 NotDir, 5 IsDir, 6 Permission, 7 Io.
pub fn fs_status(e: Int) -> Int {
  match e {
    2 => 1
    17 => 2
    41 => 3
    20 => 4
    21 => 5
    13 | 1 => 6
    _ => 7
  }
}

// ---------------------------------------------------------------------------
// The Fs operations of std/native/llrt/fsops.xo (work item B16, part 2):
// xo_win.c's POSIX shims over kernel32 (unlink, rmdir, mkdir, rename,
// chmod, utimensat, getcwd, symlink, readlink, flock, opendir and
// readdir, and _wopen's flags), each returning >= 0 or the negative
// errno the C path set. A handle is the HANDLE itself (the C path's was
// a C runtime descriptor over it).

/// The C runtime's EWOULDBLOCK: a lock another handle holds.
pub const EWOULDBLOCK: Int = 140

const FILE_APPEND_DATA: Int = 4
const FILE_WRITE_ATTRIBUTES: Int = 256
const OPEN_ALWAYS: Int = 4
const CREATE_NEW: Int = 1
const FILE_ATTRIBUTE_READONLY: Int = 1
const FILE_TYPE_DISK: Int = 1
const MOVEFILE_REPLACE_EXISTING: Int = 1
const SYMBOLIC_LINK_FLAG_DIRECTORY: Int = 1
const SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE: Int = 2
const FSCTL_GET_REPARSE_POINT: Int = 589992
const IO_REPARSE_TAG_SYMLINK: Int = 2684354572
const MAXIMUM_REPARSE_DATA_BUFFER_SIZE: Int = 16384
const LOCKFILE_FAIL_IMMEDIATELY: Int = 1
const LOCKFILE_EXCLUSIVE_LOCK: Int = 2
const MAXDWORD: Int = 4294967295
const ERROR_DIRECTORY: Int = 267
/// FindNextFileW at the end of a listing.
const ERROR_NO_MORE_FILES: Int = 18
const ERROR_LOCK_VIOLATION: Int = 33
const ERROR_IO_PENDING: Int = 997
// st_mode values xo_w_fill_stat and xo_w_fstat give
const S_IFCHR: Int = 8192
const S_IFDIR_ALL: Int = 16895
const S_IFLNK_ALL: Int = 41471
const S_IFREG: Int = 32768

/// The handle of p opened as fsops.xo's kind k (0 read, 1 created or
/// truncated for writing, 2 appended to, 3 read and write, 4 a new file
/// for read and write), as _wopen opens it: a new file is read-only when
/// mode lacks the owner's write bit. The handle or the negative errno.
pub fn open_kind(path: Str, k: Int, mode: Int) -> Int {
  let attr = if (mode & 128) == 0 && k != 0 { FILE_ATTRIBUTE_READONLY } else { FILE_ATTRIBUTE_NORMAL }
  match k {
    0 => open(path, GENERIC_READ, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL)
    1 => open(path, GENERIC_WRITE, CREATE_ALWAYS, attr)
    2 => open(path, FILE_APPEND_DATA, OPEN_ALWAYS, attr)
    3 => open(path, GENERIC_READ | GENERIC_WRITE, OPEN_ALWAYS, attr)
    // Fs.create_new: a new file only
    5 => open(path, GENERIC_WRITE, CREATE_NEW, attr)
    _ => open(path, GENERIC_READ | GENERIC_WRITE, CREATE_NEW, attr)
  }
}

/// ReadFile of at most n bytes to the address a, as read but without a
/// Bytes.
pub fn read_at(h: Int, a: Int, n: Int) -> Int {
  let done = obj.scratch()
  let k = if n > 2147483647 { 2147483647 } else { n }
  if Int(sys_windows.ReadFile(h, a, k, done, 0)) == 0 {
    let e = Int(sys_windows.GetLastError())
    if e == ERROR_BROKEN_PIPE {
      return 0
    }
    return if e == ERROR_ACCESS_DENIED { -EBADF } else { -dos_errno(e) }
  }
  rt.mem_load(done, 0, 8) & 4294967295
}

/// Writes the n bytes at the address a: 0, or the errno.
pub fn write_at(h: Int, a: Int, n: Int) -> Int {
  let done = obj.scratch()
  var off = 0
  while off < n {
    let k = if n - off > 2147483647 { 2147483647 } else { n - off }
    if Int(sys_windows.WriteFile(h, a + off, k, done, 0)) == 0 {
      let e = Int(sys_windows.GetLastError())
      return if e == ERROR_ACCESS_DENIED { EBADF } else { dos_errno(e) }
    }
    off += rt.mem_load(done, 0, 8) & 4294967295
  }
  0
}

/// The st_mode of path (of a final link itself unless follow), as
/// xo_w_stat_path gives it, and 0, or the errno.
pub fn stat_mode(path: Str, follow: Bool) -> (Int, Int) {
  let (s, e) = stat(path, follow)
  (s.mode, e)
}

/// fstat of the handle h: a console or a pipe is S_IFCHR.
pub fn fstat_mode(h: Int) -> (Int, Int) {
  if Int(sys_windows.GetFileType(h)) != FILE_TYPE_DISK {
    return (S_IFCHR, 0)
  }
  let (s, e) = info(h, false)
  (s.mode, e)
}

/// DeleteFileW, or RemoveDirectoryW when dir: 0, or the negative errno.
pub fn unlink(path: Str, dir: Bool) -> Int {
  let p = cpath(path)
  let w = wide(p)
  let ok = if dir { sys_windows.RemoveDirectoryW(w) } else { sys_windows.DeleteFileW(w) }
  path_result(p, w, Int(ok))
}

/// CreateDirectoryW: 0, or the negative errno.
pub fn mkdir(path: Str) -> Int {
  let p = cpath(path)
  let w = wide(p)
  path_result(p, w, Int(sys_windows.CreateDirectoryW(w, 0)))
}

/// The result of a path call that returned the BOOL ok on w (of p): its
/// last error read while w is alive, refined by fix.
fn path_result(p: Bytes, w: Bytes, ok: Int) -> Int {
  let e = keep(w, if ok == 0 { Int(sys_windows.GetLastError()) } else { 0 })
  if ok == 0 {
    return -fix(p, shim_errno(e), false)
  }
  0
}

/// MoveFileExW(a, b, MOVEFILE_REPLACE_EXISTING): 0, or the negative
/// errno (refined on a).
pub fn rename(a: Str, b: Str) -> Int {
  let pa = cpath(a)
  let wa = wide(pa)
  let wb = wide(cpath(b))
  let ok = Int(sys_windows.MoveFileExW(wa, wb, MOVEFILE_REPLACE_EXISTING))
  let e = keep(wa, keep(wb, if ok == 0 { Int(sys_windows.GetLastError()) } else { 0 }))
  if ok == 0 {
    return -fix(pa, shim_errno(e), false)
  }
  0
}

/// xo_w_chmod: Windows keeps only the read-only attribute (the owner's
/// write bit), as Go's os.Chmod. 0, or the negative errno.
pub fn chmod(path: Str, mode: Int) -> Int {
  let w = wide(cpath(path))
  var a = Int(sys_windows.GetFileAttributesW(w))
  var ok = a != INVALID_FILE_ATTRIBUTES
  if ok {
    a = if (mode & 128) != 0 { a & (MAXDWORD - FILE_ATTRIBUTE_READONLY) } else { a | FILE_ATTRIBUTE_READONLY }
    ok = Int(sys_windows.SetFileAttributesW(w, a)) != 0
  }
  let e = keep(w, if ok { 0 } else { Int(sys_windows.GetLastError()) })
  if ok { 0 } else { -shim_errno(e) }
}

/// utimensat of path to the access and modification time s seconds and
/// ns nanoseconds after the epoch (SetFileTime): 0, or the negative
/// errno.
pub fn utimens(path: Str, s: Int, ns: Int) -> Int {
  let h = open_meta(path, FILE_WRITE_ATTRIBUTES, true)
  if h < 0 {
    return h
  }
  let a = obj.scratch()
  let t = (s * 1000000000 + ns) / 100 + 116444736000000000
  rt.mem_store(a, 0, t, 8)
  let ok = Int(sys_windows.SetFileTime(h, 0, a, a))
  let e = if ok == 0 { Int(sys_windows.GetLastError()) } else { 0 }
  sys_windows.CloseHandle(h)
  if ok == 0 { -shim_errno(e) } else { 0 }
}

/// xo_w_open_meta: path opened for its attributes (a directory too),
/// following a final link when follow (a reparse point the system cannot
/// follow is opened itself, as stat): the handle, or the negative errno.
fn open_meta(path: Str, access: Int, follow: Bool) -> Int {
  let p = cpath(path)
  let w = wide(p)
  let share = FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
  let link = if follow { 0 } else { FILE_FLAG_OPEN_REPARSE_POINT }
  var h = sys_windows.CreateFileW(w, access, share, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | link, 0)
  var e = Int(sys_windows.GetLastError())
  if h == -1 && follow && e == ERROR_CANT_ACCESS_FILE {
    h = sys_windows.CreateFileW(w, access, share, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, 0)
    e = Int(sys_windows.GetLastError())
  }
  e = keep(w, e)
  if h == -1 {
    return -fix(p, shim_errno(e), false)
  }
  h
}

/// GetCurrentDirectoryW in UTF-8, "." when it does not fit 4096 units
/// (xo_fs.c's fallback).
pub fn getcwd() -> Str {
  let buf = raw.bytes_buf(8192)
  let k = Int(sys_windows.GetCurrentDirectoryW(4096, raw.bytes_addr(buf)))
  if k == 0 || k >= 4096 {
    return "."
  }
  narrow(buf, 0, k)
}

/// CreateSymbolicLinkW of path to target (unprivileged where developer
/// mode allows it; a directory link when target names a directory,
/// relative to the working directory as the C path checks it; / made \):
/// 0, or the negative errno.
pub fn symlink(target: Str, path: Str) -> Int {
  let wt = wide(cpath(target))
  let wp = wide(cpath(path))
  var flags = SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE
  let a = Int(sys_windows.GetFileAttributesW(wt))
  if a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY) != 0 {
    flags = flags | SYMBOLIC_LINK_FLAG_DIRECTORY
  }
  let wt2 = backslashes(wt)
  let ok = Int(sys_windows.CreateSymbolicLinkW(wp, wt2, flags)) & 255
  let e = keep(wp, keep(wt2, if ok == 0 { Int(sys_windows.GetLastError()) } else { 0 }))
  if ok == 0 { -shim_errno(e) } else { 0 }
}

/// The UTF-16 w with each / unit made \.
fn backslashes(w: Bytes) -> Bytes {
  var s = BytesBuilder.with_capacity(w.len())
  var i = 0
  while i + 1 < w.len() {
    if w[i] == 47 && w[i + 1] == 0 {
      unit(s, 92)
    } else {
      s.write_byte(w[i])
      s.write_byte(w[i + 1])
    }
    i += 2
  }
  s.freeze()
}

/// The target of the symbolic link path (its print name with / for \,
/// as Fs.read_link gives it, std.md 3.1) and 0, or the errno.
pub fn readlink(path: Str) -> (Str, Int) {
  let h = open_meta(path, 0, false)
  if h < 0 {
    return ("", -h)
  }
  let buf = raw.bytes_buf(MAXIMUM_REPARSE_DATA_BUFFER_SIZE)
  let got = obj.scratch()
  let ok = Int(sys_windows.DeviceIoControl(h, FSCTL_GET_REPARSE_POINT, 0, 0, raw.bytes_addr(buf), MAXIMUM_REPARSE_DATA_BUFFER_SIZE, got, 0))
  let e = keep(buf, if ok == 0 { Int(sys_windows.GetLastError()) } else { 0 })
  sys_windows.CloseHandle(h)
  if ok == 0 {
    return ("", shim_errno(e))
  }
  // REPARSE_DATA_BUFFER: the tag at 0, the print name's offset and
  // length (bytes) at 12 and 14, the path buffer at 20
  let ra = raw.bytes_addr(buf)
  if rt.mem_load(ra, 0, 4) != IO_REPARSE_TAG_SYMLINK {
    return ("", EINVAL)
  }
  let off = rt.mem_load(ra, 12, 2) + 20
  let n = rt.mem_load(ra, 14, 2) / 2
  (narrow_slash(buf, off, n), 0)
}

/// flock of the handle h with op (LOCK_SH 1, LOCK_EX 2, LOCK_NB 4,
/// LOCK_UN 8) over the whole file: LockFileEx or UnlockFileEx. 0, or the
/// negative errno (EWOULDBLOCK when another handle holds it).
pub fn flock(h: Int, op: Int) -> Int {
  // a zeroed OVERLAPPED (32 bytes: the offset 0 and no event; bytes_buf
  // is not zeroed, and a stale hEvent fails the call)
  let o = raw.bytes_buf(32)
  let a = raw.bytes_addr(o)
  rt.mem_store(a, 0, 0, 8)
  rt.mem_store(a, 8, 0, 8)
  rt.mem_store(a, 16, 0, 8)
  rt.mem_store(a, 24, 0, 8)
  let ok = if (op & 8) != 0 {
    Int(sys_windows.UnlockFileEx(h, 0, MAXDWORD, MAXDWORD, a))
  } else {
    let f = (if (op & 2) != 0 { LOCKFILE_EXCLUSIVE_LOCK } else { 0 }) | (if (op & 4) != 0 { LOCKFILE_FAIL_IMMEDIATELY } else { 0 })
    Int(sys_windows.LockFileEx(h, f, 0, MAXDWORD, MAXDWORD, a))
  }
  let e = keep(o, if ok == 0 { Int(sys_windows.GetLastError()) } else { 0 })
  if ok != 0 {
    return 0
  }
  if e == ERROR_LOCK_VIOLATION || e == ERROR_IO_PENDING { -EWOULDBLOCK } else { -shim_errno(e) }
}

/// The entries of directory path (not `.` and `..`, in no order) and 0,
/// or the errno: FindFirstFileExW of path\*, as xo_win.c's opendir and
/// readdir.
pub fn names(path: Str) -> (List[Str], Int) {
  let p = cpath(path)
  var s = BytesBuilder.with_capacity(p.len() + 2)
  s.write(p[0..p.len() - 1])
  s.write_byte(UInt8(92))
  s.write_byte(UInt8(42))
  s.write_byte(UInt8(0))
  let w = wide(s.freeze())
  // WIN32_FIND_DATAW (592 bytes): cFileName at 44
  let fd = raw.bytes_buf(592)
  let fa = raw.bytes_addr(fd)
  let h = sys_windows.FindFirstFileExW(w, 1, fa, 0, 0, 0)
  let e = keep(w, if h == -1 { Int(sys_windows.GetLastError()) } else { 0 })
  if h == -1 {
    // FindFirstFile on a file reports a missing path
    let (m, se) = stat_mode(path, true)
    if e == ERROR_DIRECTORY || (se == 0 && (m & 61440) != 16384) {
      return ([], ENOTDIR)
    }
    return ([], fix(p, shim_errno(e), false))
  }
  var out: List[Str] = []
  while true {
    var n = 0
    while n < 260 && rt.mem_load(fa, 44 + 2 * n, 2) != 0 {
      n += 1
    }
    let c0 = rt.mem_load(fa, 44, 2)
    let c1 = rt.mem_load(fa, 46, 2)
    if !(n == 1 && c0 == 46) && !(n == 2 && c0 == 46 && c1 == 46) {
      out.push(narrow(fd, 44, n))
    }
    if Int(sys_windows.FindNextFileW(h, fa)) == 0 {
      // the end is ERROR_NO_MORE_FILES; another error is reported, not
      // a list cut short (os.File.ReadDir)
      let le = Int(sys_windows.GetLastError())
      if le != ERROR_NO_MORE_FILES {
        sys_windows.FindClose(h)
        return ([], keep(fd, shim_errno(le)))
      }
      break
    }
  }
  sys_windows.FindClose(h)
  (out, keep(fd, 0))
}

/// The UTF-8 of the n UTF-16 units at offset off of b
/// (WideCharToMultiByte: an unpaired surrogate is U+FFFD).
fn narrow(b: Bytes, off: Int, n: Int) -> Str { utf8_of(b, off, n, false) }

/// narrow with each \ made /.
fn narrow_slash(b: Bytes, off: Int, n: Int) -> Str { utf8_of(b, off, n, true) }

fn utf8_of(b: Bytes, off: Int, n: Int, slash: Bool) -> Str {
  let a = raw.bytes_addr(b) + off
  var s = BytesBuilder.with_capacity(3 * n)
  var i = 0
  while i < n {
    var c = rt.mem_load(a, 2 * i, 2)
    i += 1
    if c >= 55296 && c < 56320 && i < n {
      let d = rt.mem_load(a, 2 * i, 2)
      if d >= 56320 && d < 57344 {
        c = 65536 + ((c - 55296) << 10) + (d - 56320)
        i += 1
      }
    }
    if c >= 55296 && c < 57344 {
      c = 65533
    }
    if slash && c == 92 {
      c = 47
    }
    if c < 128 {
      s.write_byte(UInt8(c))
    } else if c < 2048 {
      s.write_byte(UInt8(192 | (c >> 6)))
      s.write_byte(UInt8(128 | (c & 63)))
    } else if c < 65536 {
      s.write_byte(UInt8(224 | (c >> 12)))
      s.write_byte(UInt8(128 | ((c >> 6) & 63)))
      s.write_byte(UInt8(128 | (c & 63)))
    } else {
      s.write_byte(UInt8(240 | (c >> 18)))
      s.write_byte(UInt8(128 | ((c >> 12) & 63)))
      s.write_byte(UInt8(128 | ((c >> 6) & 63)))
      s.write_byte(UInt8(128 | (c & 63)))
    }
  }
  keep(b, 0)
  let u = s.freeze()
  let r = raw.str_at(raw.bytes_addr(u), u.len())
  keep(u, 0)
  r
}

// ---------------------------------------------------------------------------
// Processes (std/native/llrt/proc.xo's Windows arms, the zero-C audit's
// B25; xo_proc.c's Windows code): UNTESTED on windows.

/// s quoted as Go's syscall.EscapeArg (the rules CommandLineToArgvW and
/// the C runtime parse a command line by), and also when s holds a line
/// end or another space character.
pub fn cmd_quote(s: Str) -> Str {
  let b = s.bytes()
  var n = 0
  while n < b.len() && b[n] != 0 {
    n += 1
  }
  if n == 0 {
    return "\"\""
  }
  var bs = false
  var sp = false
  var i = 0
  while i < n {
    let c = Int(b[i])
    bs = bs || c == 34 || c == 92
    sp = sp || c == 32 || (c >= 9 && c <= 13)
    i += 1
  }
  let t = if n == b.len() { s } else { raw.str_slice(s, 0, n) }
  if !bs && !sp {
    return t
  }
  if !bs {
    return "\"" + t + "\""
  }
  var out = if sp { "\"" } else { "" }
  var slashes = 0
  i = 0
  while i < n {
    let c = Int(b[i])
    if c == 92 {
      slashes += 1
    } else if c == 34 {
      while slashes > 0 {
        out = rt.rs_push_byte(out, 92)
        slashes -= 1
      }
      out = rt.rs_push_byte(out, 92)
    } else {
      slashes = 0
    }
    out = rt.rs_push_byte(out, c)
    i += 1
  }
  if sp {
    while slashes > 0 {
      out = rt.rs_push_byte(out, 92)
      slashes -= 1
    }
    out = rt.rs_push_byte(out, 34)
  }
  out
}

/// errno EAGAIN of the Microsoft C runtime: what pipe_read and
/// pipe_write return (negated) when a PIPE_NOWAIT pipe has nothing now.
pub const EAGAIN: Int = 11

const PIPE_NOWAIT: Int = 1
const ERROR_FILE_NOT_FOUND: Int = 2
const ERROR_PATH_NOT_FOUND: Int = 3
const ERROR_NO_DATA: Int = 232
const STD_INPUT_HANDLE: Int = 4294967286
const INFINITE: Int = 4294967295
const DUPLICATE_SAME_ACCESS: Int = 2
const STARTF_USESTDHANDLES: Int = 256
const PROC_THREAD_ATTRIBUTE_HANDLE_LIST: Int = 131074
const CREATE_UNICODE_ENVIRONMENT: Int = 1024
const EXTENDED_STARTUPINFO_PRESENT: Int = 524288
/// The status a killed process gets: 128 plus SIGKILL's number, as on
/// Unix (std.md 3.7).
const KILLED: Int = 137

/// A pipe no child inherits (CreateProcessW's handle list names what a
/// child gets), its end nb (0 the read end, 1 the write end; -1 neither)
/// in PIPE_NOWAIT mode, so the program's reads and writes return at once
/// (xo_proc.c pumped such an end through a socket for the poller; Xo
/// polls it in steps instead): the read and write handles and 0, or -1,
/// -1, and the errno.
pub fn pipe(nb: Int) -> (Int, Int, Int) {
  let b = raw.bytes_buf(16)
  let a = raw.bytes_addr(b)
  if Int(sys_windows.CreatePipe(a, a + 8, 0, 65536)) == 0 {
    return (-1, -1, dos_errno(Int(sys_windows.GetLastError())))
  }
  let r = rt.mem_load(a, 0, 8)
  let w = rt.mem_load(a, 8, 8)
  if nb >= 0 {
    rt.mem_store(a, 0, PIPE_NOWAIT, 4)
    let _s = keep(b, Int(sys_windows.SetNamedPipeHandleState(if nb == 0 { r } else { w }, a, 0, 0)))
  }
  (r, w, 0)
}

/// Reads at most n bytes of the pipe h to the address a: the count, 0 at
/// its end (the writer closed it), -EAGAIN when it has nothing now, or
/// the negative errno.
pub fn pipe_read(h: Int, a: Int, n: Int) -> Int {
  let b = raw.bytes_buf(8)
  let done = raw.bytes_addr(b)
  rt.mem_store(done, 0, 0, 8)
  let k = if n > 2147483647 { 2147483647 } else { n }
  if Int(sys_windows.ReadFile(h, a, k, done, 0)) == 0 {
    let e = Int(sys_windows.GetLastError())
    if e == ERROR_BROKEN_PIPE {
      return 0
    }
    if e == ERROR_NO_DATA {
      return -EAGAIN
    }
    return -dos_errno(e)
  }
  let got = keep(b, rt.mem_load(done, 0, 8) & 4294967295)
  if got == 0 { -EAGAIN } else { got }
}

/// Writes at most n bytes at the address a to the pipe h: the count,
/// -EAGAIN when it takes none now, or the negative errno (the reader
/// closed it: ERROR_NO_DATA).
pub fn pipe_write(h: Int, a: Int, n: Int) -> Int {
  let b = raw.bytes_buf(8)
  let done = raw.bytes_addr(b)
  rt.mem_store(done, 0, 0, 8)
  // a PIPE_NOWAIT write larger than the pipe's free space writes nothing
  // (never a part), so a 200000 byte stdin into a 64 KiB pipe could never
  // start: at most a page at a time (2026-10-21, proc_cmd's `wc -c` hung
  // on windows/amd64)
  let k = if n > 4096 { 4096 } else { n }
  if Int(sys_windows.WriteFile(h, a, k, done, 0)) == 0 {
    return -dos_errno(Int(sys_windows.GetLastError()))
  }
  let put = keep(b, rt.mem_load(done, 0, 8) & 4294967295)
  if put == 0 { -EAGAIN } else { put }
}

/// Whether process h exited (waiting for it when block): true and its
/// exit code, the handle closed; else false.
pub fn reap(h: Int, block: Bool) -> (Bool, Int) {
  if Int(sys_windows.WaitForSingleObject(h, if block { INFINITE } else { 0 })) != 0 {
    return (false, 0)
  }
  let b = raw.bytes_buf(8)
  let a = raw.bytes_addr(b)
  rt.mem_store(a, 0, 0, 8)
  let _g = sys_windows.GetExitCodeProcess(h, a)
  let code = keep(b, rt.mem_load(a, 0, 4))
  let _c = sys_windows.CloseHandle(h)
  (true, code)
}

/// Ends the started process h (Child.kill, cancellation) with status 137.
pub fn kill_proc(h: Int) {
  let _t = sys_windows.TerminateProcess(h, KILLED)
}

/// The process id of the process handle h.
pub fn pid_of(h: Int) -> Int { Int(sys_windows.GetProcessId(h)) }

/// The system's message for Win32 error e (Go's syscall.Errno.Error on
/// Windows: FormatMessage in US English without the line end).
pub fn win_text(e: Int) -> Str {
  let b = raw.bytes_buf(1024)
  let a = raw.bytes_addr(b)
  // FORMAT_MESSAGE_FROM_SYSTEM | IGNORE_INSERTS | MAX_WIDTH_MASK; English
  // (United States)
  var k = Int(sys_windows.FormatMessageW(4096 | 512 | 255, 0, e, 1033, a, 512, 0))
  while k > 0 {
    let c = rt.mem_load(a, 2 * (k - 1), 2)
    if c != 10 && c != 13 && c != 32 {
      break
    }
    k -= 1
  }
  if k == 0 {
    return "winapi error #${e}"
  }
  narrow(b, 0, k)
}

/// Whether path names an existing file that is not a directory.
fn is_file(path: Str) -> Bool {
  let a = attrs(cpath(path))
  a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY) == 0
}

fn lower_ascii(s: Str) -> Str {
  var out = ""
  for c in s.bytes() {
    out = rt.rs_push_byte(out, if c >= 65 && c <= 90 { Int(c) + 32 } else { Int(c) })
  }
  out
}

/// exec's findExecutable on Windows: path itself when it has an
/// extension and exists, else path with each extension of pathext (";"
/// separated, PATHEXT) in turn, or "".
fn find_exe(path: Str, pathext: Str) -> Str {
  let pe = if pathext.is_empty() { ".com;.exe;.bat;.cmd" } else { pathext }
  let b = path.bytes()
  var dot = -1
  var sep = -1
  for i in 0..b.len() {
    if b[i] == 46 {
      dot = i
    }
    if b[i] == 47 || b[i] == 92 {
      sep = i
    }
  }
  if dot >= 0 && sep < dot && is_file(path) {
    return path
  }
  for ext in pe.split(";") {
    if !ext.is_empty() {
      let full = path + lower_ascii(ext)
      if is_file(full) {
        return full
      }
    }
  }
  ""
}

/// exec.LookPath on Windows: a command naming a path (any of \ / :) is
/// found with PATHEXT's extensions; a name is looked up in each directory
/// of path (";" separated, quotes taken off). The file, or "".
pub fn look_path(cmd: Str, path: Str, pathext: Str) -> Str {
  if cmd.contains("/") || cmd.contains("\\") || cmd.contains(":") {
    return find_exe(cmd, pathext)
  }
  for d0 in path.split(";") {
    var d = d0
    if d.len() >= 2 && d.starts_with("\"") && d.ends_with("\"") {
      d = raw.str_slice(d, 1, d.len() - 1)
    }
    if !d.is_empty() {
      let f = find_exe(d + "\\" + cmd, pathext)
      if !f.is_empty() {
        return f
      }
    }
  }
  ""
}

/// An inheritable copy of handle h (0 when h is not a handle).
fn inheritable(h: Int) -> Int {
  if h == 0 || h == -1 {
    return 0
  }
  let b = raw.bytes_buf(8)
  let a = raw.bytes_addr(b)
  rt.mem_store(a, 0, 0, 8)
  // the current process's pseudo handle is -1
  if Int(sys_windows.DuplicateHandle(-1, h, -1, a, 0, 1, DUPLICATE_SAME_ACCESS)) == 0 {
    return 0
  }
  keep(b, rt.mem_load(a, 0, 8))
}

/// NUL opened for a child's standard stream k, inheritable (0 on
/// failure).
fn null_for(k: Int) -> Int {
  // SECURITY_ATTRIBUTES: its size, no descriptor, inheritable
  let b = raw.bytes_buf(24)
  let sa = raw.bytes_addr(b)
  rt.mem_set(sa, 0, 24)
  rt.mem_store(sa, 0, 24, 4)
  rt.mem_store(sa, 16, 1, 4)
  let h = sys_windows.CreateFileW(wide(cpath("NUL")), if k == 0 { GENERIC_READ } else { GENERIC_WRITE }, FILE_SHARE_READ | FILE_SHARE_WRITE, sa, OPEN_EXISTING, 0, 0)
  keep(b, if h == -1 { 0 } else { h })
}

/// The absolute UTF-16 form (with its NUL) of directory dir, or empty.
fn full_dir(dir: Str) -> Bytes {
  let w = wide(cpath(dir))
  let n = Int(sys_windows.GetFullPathNameW(w, 0, 0, 0))
  if n == 0 {
    return b""
  }
  let out = raw.bytes_buf(2 * n + 2)
  let k = Int(sys_windows.GetFullPathNameW(w, n, raw.bytes_addr(out), 0))
  if k == 0 || k >= n {
    return b""
  }
  out
}

/// The UTF-16 environment block of env ("NAME=VALUE" each, with its NUL,
/// then a NUL; an empty block is two NULs).
fn env_block(env: List[Str]) -> Bytes {
  var s = BytesBuilder.with_capacity(256)
  var any = false
  for e in env {
    if !e.is_empty() {
      s.write(wide(cpath(e)))
      any = true
    }
  }
  unit(s, 0)
  if !any {
    unit(s, 0)
  }
  s.freeze()
}

/// Starts file with the command line cmdline (procspec.xo's quoting),
/// the directory dir ("" the program's), the environment env when
/// has_env (else the program's), and the standard streams fds (a pipe's
/// handle, or proc.xo's FD_NULL -1, FD_INHERIT -2, FD_DUP_OUT -3):
/// CreateProcessW with exactly those three handles inherited (an explicit
/// handle list, STARTUPINFOEXW). The process handle and 0, or 0 and the
/// Win32 error. UNTESTED on windows.
pub fn spawn(file: Str, cmdline: Str, dir: Str, env: List[Str], has_env: Bool, fds: List[Int]) -> (Int, Int) {
  var hs = [0, 0, 0]
  for k in 0..3 {
    let fd = fds[k]
    if fd == -3 {
      hs[k] = inheritable(hs[1])
    } else if fd == -2 {
      hs[k] = inheritable(sys_windows.GetStdHandle(STD_INPUT_HANDLE - k))
    } else if fd >= 0 {
      hs[k] = inheritable(fd)
    }
    if hs[k] == 0 {
      hs[k] = null_for(k)
    }
  }
  // the handle list: each handle once
  let lb = raw.bytes_buf(24)
  let la = raw.bytes_addr(lb)
  var nl = 0
  for k in 0..3 {
    var dup = false
    for j in 0..nl {
      dup = dup || rt.mem_load(la, 8 * j, 8) == hs[k]
    }
    if hs[k] != 0 && !dup {
      rt.mem_store(la, 8 * nl, hs[k], 8)
      nl += 1
    }
  }
  let szb = raw.bytes_buf(8)
  let sz = raw.bytes_addr(szb)
  rt.mem_store(sz, 0, 0, 8)
  let _q = sys_windows.InitializeProcThreadAttributeList(0, 1, 0, sz)
  let alb = raw.bytes_buf(rt.mem_load(sz, 0, 8) + 16)
  let al = raw.bytes_addr(alb)
  var ok = Int(sys_windows.InitializeProcThreadAttributeList(al, 1, 0, sz)) != 0
  var e = 0
  var started = false
  if !ok {
    e = Int(sys_windows.GetLastError())
  } else if nl > 0 && Int(sys_windows.UpdateProcThreadAttribute(al, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, la, 8 * nl, 0, 0)) == 0 {
    e = Int(sys_windows.GetLastError())
    ok = false
  }
  // STARTUPINFOEXW (112 bytes): cb, dwFlags at 60, the standard handles
  // at 80, 88, 96, the attribute list at 104; PROCESS_INFORMATION after it
  let sib = raw.bytes_buf(144)
  let si = raw.bytes_addr(sib)
  rt.mem_set(si, 0, 144)
  rt.mem_store(si, 0, 112, 4)
  rt.mem_store(si, 60, STARTF_USESTDHANDLES, 4)
  rt.mem_store(si, 80, hs[0], 8)
  rt.mem_store(si, 88, hs[1], 8)
  rt.mem_store(si, 96, hs[2], 8)
  rt.mem_store(si, 104, al, 8)
  let pi = si + 112
  let wfile = wide(cpath(file))
  // CreateProcessW may write to the command line: a copy of its own
  let wcl = wide(cpath(cmdline))
  let wdir = if dir.is_empty() { b"" } else { full_dir(dir) }
  let wenv = if has_env { env_block(env) } else { b"" }
  if ok {
    let r = sys_windows.CreateProcessW(raw.bytes_addr(wfile), raw.bytes_addr(wcl), 0, 0, if nl > 0 { 1 } else { 0 }, CREATE_UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO_PRESENT, if has_env { raw.bytes_addr(wenv) } else { 0 }, if wdir.is_empty() { 0 } else { raw.bytes_addr(wdir) }, si, pi)
    if Int(r) == 0 {
      e = Int(sys_windows.GetLastError())
    } else {
      started = true
    }
  }
  if ok {
    sys_windows.DeleteProcThreadAttributeList(al)
  }
  for k in 0..3 {
    if hs[k] != 0 {
      let _c = sys_windows.CloseHandle(hs[k])
    }
  }
  let proc = rt.mem_load(pi, 0, 8)
  let thread = rt.mem_load(pi, 8, 8)
  let _k = keep(lb, keep(szb, keep(alb, keep(wfile, keep(wcl, keep(wdir, keep(wenv, 0)))))))
  let _s = keep(sib, 0)
  if !started {
    // ERROR_INVALID_PARAMETER when the call gave no error
    return (0, if e == 0 { 87 } else { e })
  }
  let _t = sys_windows.CloseHandle(thread)
  (proc, 0)
}

/// Whether Win32 error e means the file was not found.
pub fn not_found(e: Int) -> Bool { e == ERROR_FILE_NOT_FOUND || e == ERROR_PATH_NOT_FOUND }
