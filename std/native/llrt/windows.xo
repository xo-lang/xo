// The Windows layer of the native runtime, written in Xo (decision 0213,
// decision 0195 prerequisite 3): kernel32 and bcrypt called with the C
// ABI through std/native/sys_windows.xo, in place of the C runtime's
// POSIX shim (std/llrt/xo_win.c) over the Microsoft C runtime. Its API is
// linux.xo's and darwin.xo's: a call returns its result (>= 0: a count,
// or a HANDLE, which is a positive address), or a negative errno: the
// errno the C path reports for the same failure (the C runtime's
// _dosmaperr of GetLastError for opens, reads, writes, and closes, as
// _wopen, _read, _write, and _close set it; xo_win.c's own map for
// stat), refined as xo_w_fix refines it (ENOTDIR when a parent of the
// path is a file, EISDIR when an open of a directory was refused), so
// the messages are the C runtime's strerror texts byte for byte.
//
// Only the Windows arms of std/native/llrt/sysio.xo call this module; the
// SSA builders make its platform calls faults on another OS.
use native/rt
use native/sys_windows

// errno values of the Microsoft C runtime (errno.h)
pub const EPERM: Int = 1
pub const ENOENT: Int = 2
pub const EINTR: Int = 4
pub const EIO: Int = 5
pub const EBADF: Int = 9
pub const ENOMEM: Int = 12
pub const EACCES: Int = 13
pub const EEXIST: Int = 17
pub const ENOTDIR: Int = 20
pub const EISDIR: Int = 21
pub const EINVAL: Int = 22
pub const ENOSPC: Int = 28
pub const ENOTEMPTY: Int = 41

// CreateFileW's arguments (winnt.h, fileapi.h)
const GENERIC_READ: Int = 2147483648
const GENERIC_WRITE: Int = 1073741824
const FILE_READ_ATTRIBUTES: Int = 128
const FILE_SHARE_READ: Int = 1
const FILE_SHARE_WRITE: Int = 2
const FILE_SHARE_DELETE: Int = 4
const CREATE_ALWAYS: Int = 2
const OPEN_EXISTING: Int = 3
const FILE_ATTRIBUTE_NORMAL: Int = 128
const FILE_FLAG_BACKUP_SEMANTICS: Int = 33554432
const FILE_FLAG_OPEN_REPARSE_POINT: Int = 2097152
const FILE_ATTRIBUTE_DIRECTORY: Int = 16
const FILE_ATTRIBUTE_REPARSE_POINT: Int = 1024
const INVALID_FILE_ATTRIBUTES: Int = 4294967295
const FILE_TYPE_UNKNOWN: Int = 0
const ERROR_ACCESS_DENIED: Int = 5
const ERROR_BROKEN_PIPE: Int = 109
const ERROR_CANT_ACCESS_FILE: Int = 1920
const BCRYPT_USE_SYSTEM_PREFERRED_RNG: Int = 2

/// The handle of op opened for reading, as the C runtime's
/// _wopen(_O_RDONLY | _O_BINARY | _O_NOINHERIT) opens it, or the negative
/// errno.
pub fn open_read(path: Str) -> Int { open(path, GENERIC_READ, OPEN_EXISTING) }

/// The handle of op created or truncated for writing (_wopen with
/// _O_WRONLY | _O_CREAT | _O_TRUNC, mode 0644: not read-only), or the
/// negative errno.
pub fn open_write(path: Str) -> Int { open(path, GENERIC_WRITE, CREATE_ALWAYS) }

/// CreateFileW as _wopen calls it (shared for reading and writing, not
/// inherited, normal attributes), the error refined as xo_w_open does.
fn open(path: Str, access: Int, disposition: Int) -> Int {
  let p = cpath(path)
  let w = wide(p)
  let h = sys_windows.CreateFileW(w, access, FILE_SHARE_READ | FILE_SHARE_WRITE, 0, disposition, FILE_ATTRIBUTE_NORMAL, 0)
  // the last error read while w is alive: a release between the call
  // and GetLastError would run the allocator
  let le = keep(w, if h == -1 { Int(sys_windows.GetLastError()) } else { 0 })
  if h == -1 {
    return -fix(p, dos_errno(le), true)
  }
  if Int(sys_windows.GetFileType(h)) == FILE_TYPE_UNKNOWN {
    // _wopen refuses a handle of an unknown type
    let e = Int(sys_windows.GetLastError())
    sys_windows.CloseHandle(h)
    return -dos_errno(e)
  }
  h
}

/// ReadFile of at most n bytes into buf from off on: the count (0 at the
/// end, or after a broken pipe, as _read), or the negative errno.
pub fn read(h: Int, buf: Bytes, off: Int, n: Int) -> Int {
  let done = rt.sys_buf()
  let k = if n > 2147483647 { 2147483647 } else { n }
  let ok = sys_windows.ReadFile(h, rt.bytes_addr(buf) + off, k, rt.bytes_addr(done), 0)
  if Int(ok) == 0 {
    let e = Int(sys_windows.GetLastError())
    if e == ERROR_BROKEN_PIPE {
      return keep(buf, 0)
    }
    if e == ERROR_ACCESS_DENIED {
      return keep(buf, -EBADF)
    }
    return keep(buf, -dos_errno(e))
  }
  keep(buf, rt.bytes_word(done, 0) & 4294967295)
}

/// Writes all of b (WriteFile until it is written, as _write): 0, or the
/// errno.
pub fn write_all(h: Int, b: Bytes) -> Int {
  let done = rt.sys_buf()
  var off = 0
  let n = b.len()
  while off < n {
    let k = if n - off > 2147483647 { 2147483647 } else { n - off }
    let ok = sys_windows.WriteFile(h, rt.bytes_addr(b) + off, k, rt.bytes_addr(done), 0)
    if Int(ok) == 0 {
      let e = Int(sys_windows.GetLastError())
      return keep(b, if e == ERROR_ACCESS_DENIED { EBADF } else { dos_errno(e) })
    }
    let w = rt.bytes_word(done, 0) & 4294967295
    if w == 0 {
      // nothing written and no error: _write's ENOSPC
      return keep(b, ENOSPC)
    }
    off += w
  }
  keep(b, 0)
}

/// CloseHandle: 0, or the negative errno.
pub fn close(h: Int) -> Int {
  if Int(sys_windows.CloseHandle(h)) == 0 {
    return -dos_errno(Int(sys_windows.GetLastError()))
  }
  0
}

/// The facts of a file: whether it is a directory, its size, and its
/// modification time in Unix nanoseconds.
pub struct Stat {
  pub is_dir: Bool
  pub size: Int
  pub mtime: Int
}

/// The size of the open file h, or -1.
pub fn file_size(h: Int) -> Int {
  let (s, e) = info(h, false)
  if e == 0 { s.size } else { -1 }
}

/// stat of path (of a final symbolic link itself unless follow), as
/// xo_win.c's xo_w_stat_path: the facts and 0, or the errno.
pub fn stat(path: Str, follow: Bool) -> (Stat, Int) {
  let p = cpath(path)
  let w = wide(p)
  let share = FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
  let link = if follow { 0 } else { FILE_FLAG_OPEN_REPARSE_POINT }
  var h = sys_windows.CreateFileW(w, FILE_READ_ATTRIBUTES, share, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | link, 0)
  var e = Int(sys_windows.GetLastError())
  if h == -1 && follow && e == ERROR_CANT_ACCESS_FILE {
    // a reparse point the system cannot follow (an AF_UNIX socket
    // file): the point itself, as Go's os.Stat
    h = sys_windows.CreateFileW(w, FILE_READ_ATTRIBUTES, share, 0, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, 0)
    e = Int(sys_windows.GetLastError())
  }
  // w alive until the last error is read (as in open)
  e = keep(w, e)
  if h == -1 {
    return (Stat{is_dir: false, size: 0, mtime: 0}, fix(p, shim_errno(e), false))
  }
  let r = info(h, !follow)
  sys_windows.CloseHandle(h)
  r
}

/// GetFileInformationByHandle of h (xo_w_fill_stat; link: a reparse
/// point is a link, not a directory).
fn info(h: Int, link: Bool) -> (Stat, Int) {
  let buf = rt.sys_buf()
  if Int(sys_windows.GetFileInformationByHandle(h, rt.bytes_addr(buf))) == 0 {
    return (Stat{is_dir: false, size: 0, mtime: 0}, shim_errno(Int(sys_windows.GetLastError())))
  }
  // BY_HANDLE_FILE_INFORMATION: dwFileAttributes at 0, ftLastWriteTime
  // at 20, nFileSizeHigh at 32 and nFileSizeLow at 36
  let attrs = rt.bytes_word(buf, 0) & 4294967295
  let ft = rt.bytes_word(buf, 20)
  let size = ((rt.bytes_word(buf, 32) & 4294967295) << 32) | (rt.bytes_word(buf, 36) & 4294967295)
  var dir = (attrs & FILE_ATTRIBUTE_DIRECTORY) != 0
  if link && (attrs & FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
    dir = false
  }
  (Stat{is_dir: dir, size: size, mtime: (ft - 116444736000000000) * 100}, 0)
}

/// GetSystemTimePreciseAsFileTime: Unix nanoseconds (as xo_win.c's
/// clock_gettime of CLOCK_REALTIME).
pub fn clock_ns() -> Int {
  let buf = rt.sys_buf()
  sys_windows.GetSystemTimePreciseAsFileTime(rt.bytes_addr(buf))
  (rt.bytes_word(buf, 0) - 116444736000000000) * 100
}

/// BCryptGenRandom of n bytes, 256 at a time (as the C runtime's
/// cr_entropy): the bytes and 0, or EIO.
pub fn random(n: Int) -> (Bytes, Int) {
  let buf = rt.bytes_buf(n)
  var off = 0
  while off < n {
    let k = if n - off > 256 { 256 } else { n - off }
    if Int(sys_windows.BCryptGenRandom(0, rt.bytes_addr(buf) + off, k, BCRYPT_USE_SYSTEM_PREFERRED_RNG)) != 0 {
      return (b"", EIO)
    }
    off += k
  }
  (buf, 0)
}

/// path and a NUL byte ("." for ""): the UTF-8 the C path converts.
fn cpath(path: Str) -> Bytes {
  let p = if path.is_empty() { "." } else { path }
  var s = BytesBuilder.with_capacity(p.len() + 1)
  s.write(p.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// The UTF-16 (little endian) of the UTF-8 bytes of p up to its first NUL,
/// with a NUL: MultiByteToWideChar(CP_UTF8, 0, p, -1) of a valid string.
fn wide(p: Bytes) -> Bytes {
  var s = BytesBuilder.with_capacity(2 * p.len() + 2)
  var i = 0
  while i < p.len() && p[i] != 0 {
    let (r, n) = p.decode_rune(i)
    let c = Int(r)
    if c >= 65536 {
      let u = c - 65536
      unit(s, 55296 + (u >> 10))
      unit(s, 56320 + (u & 1023))
    } else {
      unit(s, c)
    }
    i += n
  }
  unit(s, 0)
  s.freeze()
}

fn unit(var s: BytesBuilder, u: Int) {
  s.write_byte(UInt8(u & 255))
  s.write_byte(UInt8(u >> 8))
}

/// r, after b (whose address a call used) is known alive up to here.
fn keep(b: Bytes, r: Int) -> Int {
  if b.len() < 0 {
    return -1
  }
  r
}

/// The attributes of the UTF-8 path p (NUL terminated), or
/// INVALID_FILE_ATTRIBUTES.
fn attrs(p: Bytes) -> Int { Int(sys_windows.GetFileAttributesW(wide(p))) }

/// xo_win.c's xo_w_fix: the errno e of a call on path p as POSIX reports
/// it: EISDIR for an open of a directory refused with EACCES (open), and
/// ENOTDIR for ENOENT when a parent of p is a file.
fn fix(p: Bytes, e: Int, open: Bool) -> Int {
  if e == EACCES && open {
    let a = attrs(p)
    if a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY) != 0 {
      return EISDIR
    }
    return e
  }
  if e != ENOENT {
    return e
  }
  // n: the length without the NUL
  let n = p.len() - 1
  var i = 1
  while i < n {
    let c = p[i]
    if (c == 47 || c == 92) && !(i == 2 && p[1] == 58) {
      var q = BytesBuilder.with_capacity(i + 1)
      q.write(p[0..i])
      q.write_byte(UInt8(0))
      let a = attrs(q.freeze())
      if a == INVALID_FILE_ATTRIBUTES {
        return e
      }
      if (a & FILE_ATTRIBUTE_DIRECTORY) == 0 {
        return ENOTDIR
      }
    }
    i += 1
  }
  e
}

/// xo_win.c's xo_w_errno: the errno of a Win32 error (stat's map).
fn shim_errno(e: Int) -> Int {
  match e {
    2 | 3 | 123 | 53 => ENOENT
    5 | 32 | 33 | 1314 => EACCES
    183 | 80 => EEXIST
    145 => ENOTEMPTY
    267 => ENOTDIR
    8 | 14 => ENOMEM
    4390 => EINVAL
    _ => EIO
  }
}

/// The Microsoft C runtime's errno of a Win32 error (_dosmaperr, as
/// _wopen, _read, _write, and _close set it).
pub fn dos_errno(e: Int) -> Int {
  match e {
    1 => 22
    2 | 3 => 2
    4 => 24
    5 => 13
    6 => 9
    7 | 8 | 9 => 12
    10 => 7
    11 => 8
    12 | 13 => 22
    15 => 2
    16 => 13
    17 => 18
    18 => 2
    33 => 13
    53 => 2
    65 => 13
    67 => 2
    80 => 17
    82 | 83 => 13
    87 => 22
    89 => 11
    108 => 13
    109 => 32
    112 => 28
    114 => 9
    124 => 22
    128 | 129 => 10
    130 => 9
    131 => 22
    132 => 13
    145 => 41
    158 => 13
    161 => 2
    164 => 11
    167 => 13
    183 => 17
    206 => 2
    215 => 11
    1816 => 12
    _ => {
      if e >= 19 && e <= 36 {
        return 13
      }
      if e >= 188 && e <= 202 {
        return 8
      }
      22
    }
  }
}

/// The Microsoft C runtime's strerror text of errno e (the C path's
/// messages on Windows), "Unknown error" outside its tables.
pub fn strerror(e: Int) -> Str {
  match e {
    0 => "No error"
    1 => "Operation not permitted"
    2 => "No such file or directory"
    3 => "No such process"
    4 => "Interrupted function call"
    5 => "Input/output error"
    6 => "No such device or address"
    7 => "Arg list too long"
    8 => "Exec format error"
    9 => "Bad file descriptor"
    10 => "No child processes"
    11 => "Resource temporarily unavailable"
    12 => "Not enough space"
    13 => "Permission denied"
    14 => "Bad address"
    16 => "Resource device"
    17 => "File exists"
    18 => "Improper link"
    19 => "No such device"
    20 => "Not a directory"
    21 => "Is a directory"
    22 => "Invalid argument"
    23 => "Too many open files in system"
    24 => "Too many open files"
    25 => "Inappropriate I/O control operation"
    27 => "File too large"
    28 => "No space left on device"
    29 => "Invalid seek"
    30 => "Read-only file system"
    31 => "Too many links"
    32 => "Broken pipe"
    33 => "Domain error"
    34 => "Result too large"
    36 => "Resource deadlock avoided"
    38 => "Filename too long"
    39 => "No locks available"
    40 => "Function not implemented"
    41 => "Directory not empty"
    42 => "Illegal byte sequence"
    100 => "address in use"
    101 => "address not available"
    102 => "address family not supported"
    103 => "connection already in progress"
    104 => "bad message"
    105 => "operation canceled"
    106 => "connection aborted"
    107 => "connection refused"
    108 => "connection reset"
    109 => "destination address required"
    110 => "host unreachable"
    111 => "identifier removed"
    112 => "operation in progress"
    113 => "already connected"
    114 => "too many symbolic link levels"
    115 => "message size"
    116 => "network down"
    117 => "network reset"
    118 => "network unreachable"
    119 => "no buffer space"
    120 => "no message available"
    121 => "no link"
    122 => "no message"
    123 => "no protocol option"
    124 => "no stream resources"
    125 => "not a stream"
    126 => "not connected"
    127 => "state not recoverable"
    128 => "not a socket"
    129 => "not supported"
    130 => "operation not supported"
    132 => "value too large"
    133 => "owner dead"
    134 => "protocol error"
    135 => "protocol not supported"
    136 => "wrong protocol type"
    137 => "stream timeout"
    138 => "timed out"
    139 => "text file busy"
    140 => "operation would block"
    _ => "Unknown error"
  }
}

/// The message of errno e as the C runtime records a file error: the
/// strerror text with its first letter lowered.
pub fn err_msg(e: Int) -> Str {
  let s = strerror(e)
  let b = s.bytes()
  if b.len() > 0 && b[0] >= 65 && b[0] <= 90 {
    return rt.str_of_byte(Int(b[0]) + 32) + rt.str_slice(s, 1, s.len())
  }
  s
}

/// The FsErr tag plus one of errno e (std/rt's mapFsErr): 1 NotFound, 2
/// Exists, 3 NotEmpty, 4 NotDir, 5 IsDir, 6 Permission, 7 Io.
pub fn fs_status(e: Int) -> Int {
  match e {
    2 => 1
    17 => 2
    41 => 3
    20 => 4
    21 => 5
    13 | 1 => 6
    _ => 7
  }
}
