// Tests of netconn.xo's resolver error texts (decision 0302, owner
// 2026-10-30): `xo test --std-module=native/llrt/netconn`, run by
// internal/stdtest.

use native/llrt/dns
use native/llrt/ctx
use native/llrt/poll
use native/llrt/sock

test "a resolver error's text is Go's where Go has one" {
  expect(gai_text(dns.EAI_NONAME)) == "no such host"
  expect(gai_text(dns.EAI_NODATA)) == "no such host"
  expect(gai_text(dns.EAI_AGAIN)) == "server misbehaving"
  expect(gai_text(dns.EAI_FAIL)) == "server misbehaving"
  expect(gai_text(dns.EAI_SERVICE)) == "unknown port"
  expect(gai_text(dns.EAI_SYSTEM)) == "system error"
  expect(gai_text(-42)) == "resolver error 42"
}

test "EAI_SYSTEM with an errno names the errno" {
  // ECONNREFUSED (61 on macOS, 111 on Linux): err_text's Go text
  expect(gai_text(dns.EAI_ERRNO - econnrefused())) == "connection refused"
}

test "libSystem's EAI codes map to dns.xo's" {
  expect(darwin_eai(2, 0)) == dns.EAI_AGAIN
  expect(darwin_eai(4, 0)) == dns.EAI_FAIL
  expect(darwin_eai(7, 0)) == dns.EAI_NODATA
  expect(darwin_eai(8, 0)) == dns.EAI_NONAME
  expect(darwin_eai(9, 0)) == dns.EAI_SERVICE
  expect(darwin_eai(11, 0)) == dns.EAI_SYSTEM
  expect(darwin_eai(11, 24)) == dns.EAI_ERRNO - 24
  // macOS's EAI_AGAIN is 2, and minus 2 is EAI_NONAME's number: before
  // the mapping a temporary failure read as `no such host`
  expect(darwin_eai(2, 0) == dns.EAI_NONAME) == false
}

// A socket registered with the poller before its connect is reported
// writable (epoll: a socket that is not connecting yet; kqueue likewise):
// that wake is not a connection. connect_wait took it for one when
// SO_ERROR was 0, and a dial to an unroutable address reported a
// connection under load (net_lookup_dial_timeout, 2026-11-02). Here the
// socket never connects, so the only end is the deadline.
test "a writable wake before the connect finished is not a connection" {
  if sock.windows() {
    return
  }
  let fd = sock.socket(2, sock.SOCK_STREAM | cloexec(), 6)
  expect(fd >= 0) == true
  let _b = sock.nonblock(fd)
  let pd = poll.pd_open(fd, true)
  expect(pd > 0) == true
  // the registration's edge, as the poller hands it to pd when it sees
  // the event before the connect starts
  poll.pd_ready(pd, 2)
  let _g = poll.pd_begin(pd)
  expect(connect_wait(ctx.cur(), pd, fd, poll.deadline(50000000))) == 2
  poll.pd_end(pd)
  poll.pd_free(pd)
}

// A deadline already passed fails the next read or write at once, even
// when the clock has not moved since it was set (decision 0430; the test
// world's clock stands still between sleeps). It was stored as
// now | 1, one ns ahead of an even reading, so a write in the same clock
// tick went through (tls_deadline under load on linux/arm64, 2026-11-02)
test "a deadline in the past fails at once on a clock that has not moved" {
  let l = os.net.listen("past.test:1")?
  let c = os.net.dial("past.test:1")?
  let _sc = l.accept()?
  for k in 0..2 {
    // two readings of the standing clock: one of now and now + 1 ns is even
    if k == 1 {
      os.clock.sleep(1ns)
    }
    c.set_write_deadline(os.clock, Some(os.clock.now() - 1s))
    expect(c.write("x".bytes()) == Err(NetErr.Timeout)) == true
    c.set_read_deadline(os.clock, Some(os.clock.now() - 1s))
    expect(c.read(8) == Err(NetErr.Timeout)) == true
    c.set_deadline(os.clock, None)
  }
}

// A read that waits on a FakeNet connection is woken by its deadline: the
// virtual clock moves to it (it deadlocked with "no timer is pending"), and
// the connection reads on after a later deadline (decision 0430).
test "a waiting read on a fake connection times out at its deadline" {
  let l = os.net.listen("wait.test:1")?
  let c = os.net.dial("wait.test:1")?
  let sc = l.accept()?
  sc.set_read_deadline(os.clock, Some(os.clock.now() + 50ms))
  expect(sc.read(8) == Err(NetErr.Timeout)) == true
  sc.set_read_deadline(os.clock, None)
  c.write("hi".bytes())?
  expect(sc.read(8)?) == Some("hi".bytes())
}
