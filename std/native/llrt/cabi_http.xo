// The C ABI exports of the HTTP runtime (decisions 0204, 0207): like
// cabi.xo, every top level function here is called by the C runtime as
// xo_x_<name>; xo_http.c and xo_h2.c call them, so std/native/http.xo
// imports this module and only programs that use std/http carry them
// (the C has weak definitions that fault, for the programs without).
// The response writer itself is http1w.xo (the zero-C audit's B12), the
// HTTP/2 frame writer h2w.xo (B28).
use native/llrt/h2w
use native/llrt/http1w
use native/llrt/raw
use native/rt

/// Writes at d the response of status with the handler's header (hn
/// pairs at ha) and the bn bytes of body at body for a request of flags
/// (http1w.F_*); stores http1w.R_* at res; the bytes written. The caller
/// reserved hw_room's bytes at d.
fn hw_response(d: Int, ha: Int, hn: Int, status: Int, body: Int, bn: Int, flags: Int, res: Int) -> Int { http1w.response(d, ha, hn, status, body, bn, flags, res) }

/// Writes at d the hn fields at ha sorted, but the names of excl
/// (http1w.X_*), as Header.writeSubset; the bytes written (at most the
/// fields' names and values and 4 bytes each).
fn hw_fields(d: Int, ha: Int, hn: Int, excl: Int) -> Int { http1w.fields(d, 0, ha, hn, excl) }

/// Writes at d (256 bytes of room) the answer to a request that could
/// not be read: kind of http1.xo's parse results, code and the rn bytes
/// of the reason at rp for a status answer; its length.
fn hw_error(d: Int, kind: Int, code: Int, rp: Int, rn: Int) -> Int { http1w.error_answer(d, kind, code, raw.str_at(rp, rn)) }

/// Writes DetectContentType of the n bytes at p and a zero byte at buf
/// (64 bytes of room); its length.
fn hw_sniff(buf: Int, p: Int, n: Int) -> Int { raw.put_cstr(buf, http1w.sniff(p, n)) }

/// Writes the Date header value of now and a zero byte at buf (32 bytes
/// of room); its length (29).
fn hw_date(buf: Int) -> Int {
  let n = http1w.put_date(buf, 0)
  rt.mem_store(buf, n, 0, 1)
  n
}

// ---------------------------------------------------------------------------
// HTTP/2 frames and response heads (h2w.xo, the zero-C audit's B28):
// each writes at d, into the room the C reserved, and returns the bytes
// written.

/// A frame's 9 byte header.
fn h2_fh(d: Int, len: Int, ty: Int, flags: Int, sid: Int) -> Int { h2w.frame_head(d, len, ty, flags, sid) }

/// RST_STREAM (13 bytes).
fn h2_rst(d: Int, sid: Int, code: Int) -> Int { h2w.rst(d, sid, code) }

/// WINDOW_UPDATE (13 bytes).
fn h2_winup(d: Int, sid: Int, inc: Int) -> Int { h2w.winup(d, sid, inc) }

/// GOAWAY with the dn bytes of debug data at dp (17 + dn bytes).
fn h2_goaway(d: Int, last: Int, code: Int, dp: Int, dn: Int) -> Int { h2w.goaway(d, last, code, dp, dn) }

/// One setting of a SETTINGS payload (6 bytes).
fn h2_setting(d: Int, id: Int, v: Int) -> Int { h2w.setting(d, id, v) }

/// The header block of bn bytes at bp as HEADERS and CONTINUATION frames
/// of at most max bytes (bn + 9 * (bn / max + 1) bytes of room).
fn h2_block(d: Int, sid: Int, bp: Int, bn: Int, end_stream: Int, max: Int) -> Int { h2w.block(d, sid, bp, bn, end_stream != 0, max) }

/// The room h2_head needs for the hn fields at ha.
fn h2_head_room(ha: Int, hn: Int) -> Int { h2w.head_room(ha, hn) }

/// A response head in the encoder job's form (h2w.head); 1 at res when
/// the handler asked for Connection: close.
fn h2_head(d: Int, ha: Int, hn: Int, status: Int, head_req: Int, p: Int, pn: Int, done: Int, res: Int) -> Int { h2w.head(d, ha, hn, status, head_req != 0, p, pn, done != 0, res) }

/// Checks a frame (h2w.frame_check: the 9 byte header at h, the payload
/// at p; hb_on 1 while a header block on stream hb_sid is open): one of
/// h2w.FC_*, with three words at res.
fn h2_frame_check(h: Int, p: Int, hb_on: Int, hb_sid: Int, res: Int) -> Int { h2w.frame_check(h, p, hb_on != 0, hb_sid, res) }

/// 1 when a received header field is kept (h2w.field_keep: the name's nn
/// bytes at np, the value's vn at vp, the block's four words at st).
fn h2_field_keep(np: Int, nn: Int, vp: Int, vn: Int, st: Int) -> Int { if h2w.field_keep(np, nn, vp, vn, st) { 1 } else { 0 } }

/// 1 when the pseudo fields of the hn fields at ha are valid
/// (h2w.pseudos_ok); 1 at resp when :status was one.
fn h2_pseudos_ok(ha: Int, hn: Int, resp: Int) -> Int { if h2w.pseudos_ok(ha, hn, resp) { 1 } else { 0 } }

/// What a request of the hn checked fields at ha is (h2w.request_check:
/// one of h2w.K_*, the 400's text at msg).
fn h2_request_check(ha: Int, hn: Int, truncated: Int, msg: Int) -> Int { h2w.request_check(ha, hn, truncated != 0, msg) }

/// The stateless checks of a SETTINGS payload (h2w.settings_check: the
/// failing setting's index times 16 plus its code, else the count times
/// 16).
fn h2_settings_check(p: Int, n: Int) -> Int { h2w.settings_check(p, n) }
