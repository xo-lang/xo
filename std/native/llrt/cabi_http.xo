// The C ABI exports of the HTTP runtime (decisions 0204, 0207): like
// cabi.xo, every top level function here is called by the C runtime as
// xo_x_<name>; std/native/http.xo imports this module and only programs
// that use std/http carry them (the C has weak definitions for the
// programs without). Since the zero-C audit's B28 part 3 (2026-10-14)
// the C only frees std/http's handles through these (the services
// record's free functions, xo_h_free) and empties the table of streamed
// responses at exit.
use native/llrt/hclient
use native/llrt/hserve
use native/llrt/tlsio

/// The free functions of a server, a connection, a sink, and a client
/// response (the handles' free functions, hserve.xo and hclient.xo rt.fn_addr): the record at p, whose
/// last reference went.
fn srv_free(p: Int) { hserve.srv_free(p) }

fn hc_free(p: Int) { hserve.hc_free(p) }

fn sink_free(p: Int) { hserve.sink_free(p) }

fn cresp_free(p: Int) { hclient.cresp_free(p) }

/// At exit: the streamed responses' functions and the client's idle
/// HTTP/2 connections (the leak check).
fn streams_free() {
  hserve.streams_free()
  // the system's roots the Xo client parsed (tlsio.xo)
  tlsio.roots_free()
}
