// Tests of heapos.xo's large block cache (`xo test
// --std-module=native/llrt/heapos`, run by internal/stdtest).

use native/llrt/alloc
use native/llrt/linux
use native/llrt/obj
use native/llrt/raw
use native/llrt/sanhook
use native/llrt/sysio
use native/llrt/twflags
use native/rt

test "a block grown past 1 MiB reuses the mapping its last growth made" {
  // n = 1,048,496 bytes asks for need 1,048,512 and large_resize maps
  // room for four times n, rounded up to GRAIN: 4,194,304, past four
  // times need. take's bound refused it, so every round mapped another
  // 4 MiB (json10kx20, 2026-11-06)
  // a large block held (mapped, never touched) lets the cache keep past
  // its quarter bound on every target, as amd64's wanted sizes did
  let held = large(100000000)
  var after_first = -1
  for round in 0..6 {
    let p = large(200000)
    let q = large_resize(p - 8, 1048496)
    release(q - 8)
    if round == 0 {
      after_first = cache_count()
    }
  }
  expect(after_first >= 1)
  expect(cache_count() <= after_first)
  release(held - 8)
}

test "a freed block over 64 MiB of a wanted size stays in the cache up to the peak" {
  // Str.repeat to 160 MB ten times (bench/perf/repeat on linux/amd64):
  // each dropped result was unmapped, the next one mapped and faulted in
  let mb = 1048576
  expect(keeps(0, 0, 160 * mb, 160 * mb, 320 * mb, true))
  expect(keeps(1, 160 * mb, 160 * mb, 0, 320 * mb, true))
  // past the peak, or a size nobody asked for: unmapped as before
  expect(!keeps(2, 320 * mb, 160 * mb, 0, 320 * mb, true))
  expect(!keeps(0, 0, 160 * mb, 160 * mb, 320 * mb, false))
  // under CACHE_MAX the rules are 0448's and 0492's
  expect(keeps(0, 0, mb, 8 * mb, 8 * mb, false))
  expect(!keeps(0, 0, 4 * mb, 8 * mb, 8 * mb, false))
  expect(keeps(0, 0, 4 * mb, 8 * mb, 8 * mb, true))
  expect(!keeps(16, 0, mb, 8 * mb, 8 * mb, true))
}

test "an age pass marks a free page block and the next gives its pages back" {
  // decision 0533: the first pass that finds a block free marks it PSEEN,
  // the next one advises it (PADVISED), and its free clears both
  if !pages_on() {
    return
  }
  var h = obj.solo_heap()
  if h == 0 {
    h = rt.tlocal_get(TLS_HEAP)
  }
  let p = alloc.alloc(h, 60000)
  let q = alloc.alloc(h, 60000)
  alloc.free(h, p)
  let cw = pword(p, PT_CLASS)
  expect(rt.mem_load(cw, 0, 8) & (alloc.PSEEN | alloc.PADVISED)) == 0
  expect(age(false) >= 1)
  expect(rt.mem_load(cw, 0, 8) & alloc.PSEEN) == alloc.PSEEN
  expect(rt.mem_load(cw, 0, 8) & alloc.PADVISED) == 0
  let _k = age(false)
  let pg = match target.os {
    TargetOs.Linux => linux.auxval(linux.AT_PAGESZ)
    _ => 16384
  }
  if target.os != TargetOs.Windows && p % pg == 0 {
    expect(rt.mem_load(cw, 0, 8) & alloc.PADVISED) == alloc.PADVISED
  }
  // taken again and freed: both marks clear, the block is young again
  let r = alloc.alloc(h, 60000)
  expect(r) == p
  alloc.free(h, r)
  expect(rt.mem_load(cw, 0, 8) & (alloc.PSEEN | alloc.PADVISED)) == 0
  alloc.free(h, q)
}

test "a write after free ends the program under the free check" {
  // decision 0638's planted bug for `--check=free` (decision 0484): a
  // block of a class written after its free; without the check the
  // block is not freed into a ring and nothing is planted
  if rt.mem_load(heaps_head(), H_FQ, 8) != 0 {
    let p = obj.alloc_obj(32)
    obj.free_obj(p)
    rt.mem_store(p, 8, 1, 8)
  }
}

test "an age pass gives a class's spare magazine and free list to the central list" {
  // decision 0714 (superseding 0704's second look): every pass moves the
  // spare and the free list to central, where the sweep and other
  // records' refills see their blocks
  if !pages_on() {
    return
  }
  var h = obj.solo_heap()
  if h == 0 {
    h = rt.tlocal_get(TLS_HEAP)
  }
  if h == 0 || rt.mem_load(h, H_CENTRAL, 8) == 0 || rt.mem_load(h, H_RFLAG, 8) != 0 {
    return
  }
  // a class nothing else here uses: enough frees to fill its list twice,
  // so a full magazine becomes the spare
  let n = 3000
  let c = alloc.class_of(n)
  var ps: List[Int] = []
  for _ in 0..3 * (65536 / n) + 8 {
    ps.push(alloc.alloc(h, n))
  }
  // the threaded free (free_mt) makes the spare; alloc.free has none
  for p in ps {
    alloc.free_mt(h, p)
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  let m = rt.mem_load(fl, H_MAG, 8)
  expect(m != 0)
  expect(rt.mem_load(fl, H_FREE_LISTS, 8) != 0)
  let _a = age(false)
  expect(rt.mem_load(fl, H_MAG, 8)) == 0
  expect(rt.mem_load(fl, H_FREE_LISTS, 8)) == 0
  // both on the class's central list: the free list's magazine first
  // (pushed last), the spare after it
  var seen = false
  var q = alloc.central_first(h, c)
  while q != 0 {
    if q == m {
      seen = true
    }
    q = alloc.cnext(false, q)
  }
  expect(seen)
}

test "mapped_obj tells a mapped file's object from unique heap objects whose capacity is their length" {
  // decision 0722 (task #414): into_builder takes over a unique object
  // but must copy a read_mapped one; capacity == length marks neither
  let n = 4096
  var bb = BytesBuilder.with_capacity(n)
  for i in 0..n {
    bb.write_byte(UInt8(i % 251))
  }
  let frozen = bb.freeze()
  expect(!mapped_obj(obj_of(frozen)))
  let small = raw.bytes_buf(16)
  expect(!mapped_obj(obj_of(small)))
  let big = raw.bytes_buf(1048576)
  expect(!mapped_obj(obj_of(big)))
  // each value used after its check: the llvm backend drops a value at
  // its last use, and a big block freed there is unmapped before
  // mapped_obj reads its prefix (SIGSEGV, 2026-11-19)
  expect(frozen.len() == n && small.len() == 16 && big.len() == 1048576)
  let l = sysio.layer()
  if (l == 1 || l == 2) && !twflags.fake(1) && !sanhook.sanitized() && !sanhook.user_mode() {
    let m = sysio.fs_read_mapped("/etc/hosts")
    expect(m.len() == 1 && m[0].len() > 0)
    expect(mapped_obj(obj_of(m[0])))
    expect(m[0].len() > 0)
  }
}

/// The string object holding b (raw.bytes_addr less the header).
fn obj_of(b: Bytes) -> Int { raw.bytes_addr(b) - rt.layout(0) }

/// The thread's heap record, as trim_thread finds it.
fn test_record() -> Int {
  let h = obj.solo_heap()
  if h != 0 { h } else { rt.tlocal_get(TLS_HEAP) }
}

/// Gives the central pool one run of len units at a (decision 0630).
fn test_pool_give(a: Int, len: Int) {
  let cen = rt.mem_load(heaps_head(), H_CENTRAL, 8)
  expect(pool_room(cen, CPOOL, 1))
  clock(cen, CPOOL_C)
  let k = rt.mem_load(cen, CPOOL + 8, 8)
  rt.mem_store(rt.mem_load(cen, CPOOL, 8), k * 8, a | len, 8)
  rt.mem_store(cen, CPOOL + 8, k + 1, 8)
  cunlock(cen, CPOOL_C)
}

/// The value of hex digits s (no prefix).
fn test_hex(s: Str) -> Int {
  var v = 0
  for b in s.bytes() {
    let d = if b >= 97 { Int(b) - 87 } else { Int(b) - 48 }
    v = v * 16 + d
  }
  v
}

/// Whether /proc/self/smaps marks any of [lo, hi) MADV_HUGEPAGE (hg).
fn test_hg(lo: Int, hi: Int) -> Bool {
  let fd = linux.open("/proc/self/smaps", 0, 0)
  expect(fd >= 0)
  let n = 65536
  let b = rt.heap_large(n)
  var s = ""
  while true {
    let k = linux.read_at(fd, b, n)
    if k <= 0 {
      break
    }
    s = s + raw.str_at(b, k)
  }
  let _c = linux.close(fd)
  rt.heap_release(b - 8)
  var inside = false
  var hg = false
  for line in s.lines() {
    let f = line.fields()
    if f.len() == 0 {
      continue
    }
    let r = f[0].split("-")
    if r.len() == 2 {
      // a mapping's header line: start-end perms offset dev inode path
      inside = test_hex(r[0]) < hi && test_hex(r[1]) > lo
    } else if inside && f[0] == "VmFlags:" && f.contains("hg") {
      hg = true
    }
  }
  hg
}

test "a record with its second half reserved opens it before a pooled run" {
  // XO_THP=dense: pool_take ran first, set H_BLIM 1 and dropped the
  // record's reserved half, so the record mapped another chunk sooner
  // (grpcreflect's 60 minute stress, chunks 16 to 22, 2026-11-19)
  if !dense_halves() || !pages_on() {
    return
  }
  let h = test_record()
  let s24 = rt.mem_load(h, 24, 8)
  let s32 = rt.mem_load(h, 32, 8)
  let slim = rt.mem_load(h, H_BLIM, 8)
  let c = map_aligned(CHUNK)
  let u = map_aligned(CHUNK)
  test_pool_give(u, 16)
  // the first half used up, the second reserved (reserve, extend)
  rt.mem_store(h, 24, c + HALF, 8)
  rt.mem_store(h, 32, c + HALF, 8)
  rt.mem_store(h, H_BLIM, c + CHUNK, 8)
  let took = pool_take(h, 64)
  let at = rt.mem_load(h, 24, 8)
  rt.mem_store(h, 24, s24, 8)
  rt.mem_store(h, 32, s32, 8)
  rt.mem_store(h, H_BLIM, slim, 8)
  // the run back out of the pool, whichever way it went
  let cen = rt.mem_load(heaps_head(), H_CENTRAL, 8)
  if !took {
    clock(cen, CPOOL_C)
    let _e = pool_pick(rt.mem_load(cen, CPOOL, 8), cen + CPOOL + 8, 16)
    cunlock(cen, CPOOL_C)
  }
  expect(took) == false
  expect(at) == c + HALF
}

test "a chunk after a pooled run advises no huge pages before the run's end" {
  // XO_THP=dense: chunk's thp_filled took the run's end for a filled
  // chunk's and advised the 4 MB before it MADV_HUGEPAGE, units the sweep
  // gave back among them (grpcreflect's 60 minute stress grew 7 to 10%)
  if !dense_halves() || !pages_on() {
    return
  }
  let h = test_record()
  // three chunks, none advised: the run at the third's start, so the 4
  // MB before its end lies in the first two
  let r = map_os(3 * CHUNK)
  let a = r + 2 * CHUNK
  test_pool_give(a, 16)
  rt.mem_store(h, H_BLIM, 1, 8)
  expect(pool_take(h, 64))
  expect(rt.mem_load(h, 32, 8)) == a + 16 * PUNIT
  chunk(h)
  expect(test_hg(a + 16 * PUNIT - CHUNK, a)) == false
}
