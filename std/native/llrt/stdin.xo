// Standard input (std.md 3.6, decisions 0088, 0102, 0162) in Xo (the
// zero-C audit's work item B24): read_line, read_all, lines, and
// read_bytes over a buffer of what was read and not delivered yet. A read
// waits on the event loop's poller (the C runtime's xo_stdin_wait: a
// cancellation point, in steps of 50 ms to see a stop request), so input
// read before a reader gave up stays buffered for the next read. Readers
// take turns (a word swapped). A test binary's fake input is
// testworld.xo's. The C keeps only the platform's part: opening the
// descriptor for the poller (on Windows a pump thread into a loopback
// socket), a raw read, and the wait.
use native/llrt/raw
use native/llrt/sysio
use native/llrt/testworld
use native/rt

/// rt.static_word: the turn (a word), whether the descriptor was opened,
/// the poller's registration (0: read directly), the buffer (heap_large),
/// its length and capacity, the end of input seen, and the read error
/// (errno) that follows the buffer.
const W_BUSY = 52
const W_INIT = 53
const W_PD = 54
const W_BUF = 55
const W_LEN = 56
const W_CAP = 57
const W_EOF = 58
const W_ERR = 59

/// rt.stdin_sysread's result when nothing is available yet (wait).
const WAIT = -1000000

/// The capability bit of stdio in the test world (rt.tw_fake).
const TW_REAL_STDIO = 32

// slot atomics' orders (rt.xo)
const ACQUIRE = 1
const RELEASE = 2

// a word's address is rt.static_word of a constant (the backends' rule)
fn w(a: Int) -> Int { rt.mem_load(a, 0, 8) }

fn ws(a: Int, v: Int) { rt.mem_store(a, 0, v, 8) }

/// Appends the n bytes at p to the buffer.
fn put(p: Int, n: Int) {
  let len = w(rt.static_word(W_LEN))
  var cap = w(rt.static_word(W_CAP))
  if len + n > cap {
    var c = if cap == 0 { 4096 } else { cap * 2 }
    while c < len + n {
      c = c * 2
    }
    let old = w(rt.static_word(W_BUF))
    let nb = if old == 0 { rt.heap_large(c) } else { rt.heap_large_resize(old - 8, c) }
    ws(rt.static_word(W_BUF), nb)
    ws(rt.static_word(W_CAP), c)
    cap = c
  }
  rt.mem_copy(w(rt.static_word(W_BUF)) + len, p, n)
  ws(rt.static_word(W_LEN), len + n)
}

/// The first n buffered bytes as a string; n + skip bytes leave the
/// buffer.
fn take(n: Int, skip: Int) -> Str {
  let b = w(rt.static_word(W_BUF))
  let s = if n == 0 { "" } else { raw.str_at(b, n) }
  let len = w(rt.static_word(W_LEN))
  rt.mem_move(b, b + n + skip, len - n - skip)
  ws(rt.static_word(W_LEN), len - n - skip)
  s
}

/// Reads what is available into the buffer, waiting on the poller when
/// nothing is: true when the reader was canceled or a stop was requested.
fn fill() -> Bool {
  if w(rt.static_word(W_INIT)) == 0 {
    ws(rt.static_word(W_INIT), 1)
    ws(rt.static_word(W_PD), rt.stdin_open())
  }
  let t = rt.heap_large(65536)
  var stopped = false
  while true {
    if rt.stdin_stopped() {
      stopped = true
      break
    }
    let n = rt.stdin_sysread(t, 65536, w(rt.static_word(W_PD)))
    if n == WAIT {
      if rt.stdin_wait(w(rt.static_word(W_PD))) {
        stopped = true
        break
      }
      continue
    }
    if n < 0 {
      ws(rt.static_word(W_ERR), 0 - n)
      break
    }
    if n == 0 {
      ws(rt.static_word(W_EOF), 1)
      break
    }
    put(t, n)
    break
  }
  rt.heap_release(t - 8)
  stopped
}

/// Takes the readers' turn: false when the reader was canceled or a stop
/// was requested while it waited.
fn turn() -> Bool {
  while rt.slot_swap(rt.static_word(W_BUSY), 0, 1, ACQUIRE) != 0 {
    if rt.stdin_turn_wait() {
      return false
    }
  }
  true
}

fn give() {
  let _r = rt.slot_swap(rt.static_word(W_BUSY), 0, 0, RELEASE)
}

/// The offset of the first newline in the buffer, or -1.
fn newline() -> Int {
  let b = w(rt.static_word(W_BUF))
  let n = w(rt.static_word(W_LEN))
  var i = 0
  while i < n {
    if rt.mem_load(b, i, 1) == 10 {
      return i
    }
    i += 1
  }
  -1
}

/// A line (without its newline and a `\r` before it) or, when all, the
/// rest of the input, and the status: 0 the text, 1 the end of input (no
/// line), 2 a read error (msg), 3 canceled or stopped.
pub fn read(all: Bool) -> (Str, Int, Str) {
  if rt.stdin_stopped() {
    return ("", 3, "")
  }
  if rt.tw_fake(TW_REAL_STDIO) {
    let (s, st) = testworld.stdin_read(if all { 1 } else { 0 }, 0)
    return (s, st, "")
  }
  if !turn() {
    return ("", 3, "")
  }
  var out = ("", 3, "")
  while true {
    if !all {
      let nl = newline()
      if nl >= 0 {
        let k = if nl > 0 && rt.mem_load(w(rt.static_word(W_BUF)), nl - 1, 1) == 13 { nl - 1 } else { nl }
        out = (take(k, nl - k + 1), 0, "")
        break
      }
    }
    if w(rt.static_word(W_EOF)) != 0 || w(rt.static_word(W_ERR)) != 0 {
      let n = w(rt.static_word(W_LEN))
      if n == 0 && w(rt.static_word(W_ERR)) != 0 {
        let e = w(rt.static_word(W_ERR))
        ws(rt.static_word(W_ERR), 0)
        out = ("", 2, sysio.err_msg(sysio.layer(), e))
        break
      }
      let k = if !all && n > 0 && rt.mem_load(w(rt.static_word(W_BUF)), n - 1, 1) == 13 { n - 1 } else { n }
      out = (take(k, n - k), if all || n > 0 { 0 } else { 1 }, "")
      break
    }
    if fill() {
      break
    }
  }
  give()
  out
}

/// At most max bytes (decision 0162), and the status as for read.
pub fn read_bytes(max: Int) -> (Bytes, Int, Str) {
  if rt.stdin_stopped() {
    return (b"", 3, "")
  }
  if rt.tw_fake(TW_REAL_STDIO) {
    let (s, st) = testworld.stdin_read(2, max)
    return (s.bytes(), st, "")
  }
  if !turn() {
    return (b"", 3, "")
  }
  var out = (b"", 3, "")
  while true {
    let n = w(rt.static_word(W_LEN))
    if n > 0 {
      let k = if n < max { n } else { max }
      out = (take(k, 0).bytes(), 0, "")
      break
    }
    if w(rt.static_word(W_ERR)) != 0 {
      let e = w(rt.static_word(W_ERR))
      ws(rt.static_word(W_ERR), 0)
      out = (b"", 2, sysio.err_msg(sysio.layer(), e))
      break
    }
    if w(rt.static_word(W_EOF)) != 0 {
      out = (b"", 1, "")
      break
    }
    if fill() {
      break
    }
  }
  give()
  out
}
