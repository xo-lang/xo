// The C path of tlssrv.xo (XO_LLRT_C=tlssrv, decision 0193): the HTTP
// server's TLS on Mbed TLS (std/llrt/xo_tls.c), the same calls forwarded
// through rthttp.
use native/llrt/raw
use native/rthttp

/// A certificate: xo_tls.c's xo_tcert.
pub struct Cert {
  pub c: rthttp.TCert
}

/// tls.X509KeyPair (xo_tls.c's xo_tls_cert and tlscert.xo's checks).
pub fn cert(cert_pem: Bytes, key_pem: Bytes) -> (Cert, Str) {
  let c = rthttp.tls_cert(cert_pem, key_pem)
  (Cert{c: c}, rthttp.tls_cert_err(c))
}

/// Adds c to server s (xo_srv_tls sets its SR_TLS word).
pub fn srv_add(s: rthttp.Srv, a: Int, sr_tls: Int, c: Cert) { rthttp.srv_tls(s, c.c) }

pub fn srv_free(h: Int) { rthttp.tls_c_srv_free(h) }

pub fn conn(h: Int, pd: Int) -> Int { rthttp.tls_c_server(h, pd) }

pub fn handshake(t: Int) -> Bool { rthttp.tls_c_handshake(t) != 0 }

pub fn hc_read(t: Int, p: Int, n: Int) -> Int { rthttp.tls_c_hc_read(t, p, n) }

pub fn nb_read(t: Int, p: Int, n: Int) -> Int { rthttp.tls_c_nb_read(t, p, n) }

pub fn write(t: Int, p: Int, n: Int) -> Int { rthttp.cl_tls_write(t, p, n) }

pub fn close_notify(t: Int) { rthttp.tls_c_close_notify(t) }

pub fn alpn_h2(t: Int) -> Bool { rthttp.tls_c_alpn_h2(t) != 0 }

/// net/http's GOAWAY text for a suite HTTP/2 prohibits, "" for none.
pub fn bad_cipher(t: Int) -> Str {
  let wb = raw.bytes_buf(80)
  let wa = raw.bytes_addr(wb)
  if rthttp.tls_c_bad_cipher(t, wa, 80) != 0 { raw.str_at(wa, raw.cstr_len(wa)) } else { "" }
}

pub fn free(t: Int) { rthttp.cl_tls_free(t) }
