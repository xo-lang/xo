// Tests of cpu.xo's timer reads (`xo test --std-module=native/llrt/cpu`,
// run by internal/stdtest): the generic timer on arm64, mono_ns
// elsewhere.

use native/llrt/sysio
use native/rt

test "ticks advance and ticks_ns converts a difference" {
  let hz = ticks_hz()
  expect(hz >= 1000000)
  let a = ticks()
  let t0 = sysio.mono_ns()
  while sysio.mono_ns() - t0 < 2000000 {
  }
  let d = ticks() - a
  expect(d > 0)
  let ns = ticks_ns(d)
  // 2 ms spun: between 1 ms and 1 s of ticks
  expect(ns >= 1000000 && ns < 1000000000)
  expect(ticks_ns(hz) == 1000000000)
  expect(ticks_ns(hz * 3 + hz / 2) == 3500000000)
  expect(ticks_ns(0) == 0)
}

test "crc32x is its body (the instruction where the CPU has it)" {
  // a seeded walk over crc and word values, the high bits of crc ignored
  var x = 88172645463325252
  for _ in 0..2000 {
    x = x ^ x.wrapping_shl(13)
    x = x ^ x.shr_logical(7)
    x = x ^ x.wrapping_shl(17)
    let crc = x.shr_logical(29)
    let w = x.wrapping_mul(2685821657736338717)
    let want = crc32x_soft(crc & 0xffffffff, w)
    if (hw() & HW_CRC32) != 0 {
      expect(crc32x(crc & 0xffffffff, w)) == want
    }
    expect(want & 0xffffffff) == want
  }
  // "12345678" from the IEEE initial value, then inverted: zlib's crc32
  expect(crc32x_soft(0xffffffff, 0x3837363534333231) ^ 0xffffffff) == 2598427311
}

test "crc32cx is its body (the instruction where the CPU has it)" {
  var x = 88172645463325252
  for _ in 0..2000 {
    x = x ^ x.wrapping_shl(13)
    x = x ^ x.shr_logical(7)
    x = x ^ x.wrapping_shl(17)
    let crc = x.shr_logical(29)
    let w = x.wrapping_mul(2685821657736338717)
    let want = crc32cx_soft(crc & 0xffffffff, w)
    if (hw() & HW_CRC32) != 0 {
      expect(crc32cx(crc & 0xffffffff, w)) == want
    }
    expect(want & 0xffffffff) == want
  }
  // "12345678" from the initial value, then inverted: CRC-32C (iSCSI)
  expect(crc32cx_soft(0xffffffff, 0x3837363534333231) ^ 0xffffffff) == 1619493018
}

/// The round constants for keccak_f1600 (sha3.xo RCS).
const TEST_RCS: List[Int] = [1, 32898, -9223372036854742902, -9223372034707259392, 32907, 2147483649, -9223372034707259263, -9223372036854743031, 138, 136, 2147516425, 2147483658, 2147516555, -9223372036854775669, -9223372036854742903, -9223372036854743037, -9223372036854743038, -9223372036854775680, 32778, -9223372034707292150, -9223372034707259263, -9223372036854742912, 2147483649, -9223372034707259384]

fn lanes_addr(l: List[Int]) -> Int { rt.obj_addr(l).wrapping_add(rt.layout(2)) }

test "keccak_f1600 is its body (the SHA3 extension where the CPU has it)" {
  // the zero state: FIPS 202's Keccak-f[1600] lanes 0 and 1 (XKCP's
  // KeccakF-1600-IntermediateValues)
  var z = List[Int].with_capacity(25)
  for _ in 0..25 {
    z.push(0)
  }
  keccak_f1600_soft(lanes_addr(z), lanes_addr(TEST_RCS))
  expect(z[0]) == -1070291585488265753
  expect(z[1]) == -8874962119976532086
  // a seeded walk of states, each permuted by the body and the kernel
  var x = 88172645463325252
  for _ in 0..200 {
    var a = List[Int].with_capacity(25)
    for _ in 0..25 {
      x = x ^ x.wrapping_shl(13)
      x = x ^ x.shr_logical(7)
      x = x ^ x.wrapping_shl(17)
      a.push(x)
    }
    var b = List[Int].with_capacity(25)
    for v in a {
      b.push(v)
    }
    keccak_f1600_soft(lanes_addr(a), lanes_addr(TEST_RCS))
    if (hw() & HW_KECCAK) != 0 {
      keccak_f1600(lanes_addr(b), lanes_addr(TEST_RCS))
      for i in 0..25 {
        expect(b[i]) == a[i]
      }
    }
  }
}

test "mac_row_adx is its body (MULX, ADCX and ADOX where the CPU has them)" {
  // a seeded walk of rows of every length from 0 to 40 (the kernel's
  // one word steps and its four word steps), all ones words among them
  var x = 88172645463325252
  for n in 0..41 {
    for r in 0..8 {
      var d = List[Int].with_capacity(n)
      var s = List[Int].with_capacity(n)
      for _ in 0..n {
        x = x ^ x.wrapping_shl(13)
        x = x ^ x.shr_logical(7)
        x = x ^ x.wrapping_shl(17)
        d.push(if r == 0 { -1 } else { x })
        s.push(if r == 0 { -1 } else { x.wrapping_mul(31) })
      }
      let k = if r == 0 { -1 } else { x ^ 77 }
      var e = List[Int].with_capacity(n)
      for v in d {
        e.push(v)
      }
      let want = mac_row_soft(lanes_addr(e), lanes_addr(s), k, n)
      if r == 0 && n == 1 {
        // (2^64 - 1) + (2^64 - 1)^2 = 2^128 - 2^64: word 0, carry -1
        expect(e[0]) == 0
        expect(want) == -1
      }
      if (hw() & HW_ADX) != 0 {
        let got = mac_row_adx(lanes_addr(d), lanes_addr(s), k, n)
        expect(got) == want
        for i in 0..n {
          expect(d[i]) == e[i]
        }
      }
    }
  }
}

test "dit_set sets Arm's DIT bit and returns the old one, where the CPU has it (decision 0619)" {
  if (hw() & HW_DIT) == 0 {
    if target.arch == TargetArch.Arm64 {
      // the instruction itself, which a CPU without FEAT_DIT does not
      // have; the detection found none (windows/arm64 reads no feature
      // registers yet), so it is not run
      return
    }
    // the body: nothing set, 0 back
    expect(dit_set(1)) == 0
    expect(dit_set(0)) == 0
    return
  }
  let start = dit_set(0)
  expect(dit_set(1)) == 0
  expect(dit_set(1)) == 1
  expect(dit_set(0)) == 1
  expect(dit_set(0)) == 0
  let _ = dit_set(start)
  expect(target.os != TargetOs.Darwin || target.arch != TargetArch.Arm64 || (hw() & HW_DIT) != 0) == true
}

/// A seeded xorshift walk of n words.
fn test_words(seed: Int, n: Int) -> List[Int] {
  var x = seed
  var l = List[Int].with_capacity(n)
  for _ in 0..n {
    x = x ^ x.wrapping_shl(13)
    x = x ^ x.shr_logical(7)
    x = x ^ x.wrapping_shl(17)
    l.push(x)
  }
  l
}

test "chacha_poly_seal8 and open8 are their bodies (AVX2, 512 byte groups and a 256 byte tail, where the CPU has it)" {
  if target.arch != TargetArch.Amd64 || (hw() & HW_AVX2) != 0 {
    for blocks in 0..9 {
      let n = 256 * blocks
      for open in [false, true] {
        // the state (16 words) and the four counters (the last near the
        // 32 bit wrap), in 448 bytes (chacha.xo's scratch)
        var st0 = test_words(5 + n, 56)
        for b in 0..4 {
          let w = st0[8 + b / 2]
          let c = (4294967290 + b) & 4294967295
          st0[8 + b / 2] = if b % 2 == 0 { (w & -4294967296) | c } else { (w & 4294967295) | c.wrapping_shl(32) }
        }
        // Poly1305: h0, h1, h2 (below 4), r0 and r1 clamped
        var p0 = test_words(9 + n, 5)
        p0[2] = p0[2] & 3
        p0[3] = p0[3] & 1152921487695413247
        p0[4] = p0[4] & 1152921487695413244
        let src = test_words(13 + n, n / 8 + 1)
        var sts: List[List[Int]] = []
        var pss: List[List[Int]] = []
        var dsts: List[List[Int]] = []
        for k in 0..2 {
          var st = List[Int].with_capacity(56)
          for w in st0 {
            st.push(w)
          }
          var ps = List[Int].with_capacity(5)
          for w in p0 {
            ps.push(w)
          }
          // opening in place: dst is src's copy
          var d = List[Int].with_capacity(n / 8 + 1)
          for w in src {
            d.push(if open { w } else { 0 })
          }
          let s = if open { lanes_addr(d) } else { lanes_addr(src) }
          if k == 0 {
            if open {
              chacha_poly_open4_soft(lanes_addr(d), s, lanes_addr(st), n, lanes_addr(ps))
            } else {
              chacha_poly_seal4_soft(lanes_addr(d), s, lanes_addr(st), n, lanes_addr(ps))
            }
          } else if open {
            chacha_poly_open8(lanes_addr(d), s, lanes_addr(st), n, lanes_addr(ps))
          } else {
            chacha_poly_seal8(lanes_addr(d), s, lanes_addr(st), n, lanes_addr(ps))
          }
          sts.push(st)
          pss.push(ps)
          dsts.push(d)
        }
        for i in 0..n / 8 + 1 {
          expect(dsts[1][i]) == dsts[0][i]
        }
        for i in 0..3 {
          expect(pss[1][i]) == pss[0][i]
        }
        // the counters advanced alike
        for i in 0..10 {
          expect(sts[1][i]) == sts[0][i]
        }
      }
    }
  }
}

test "chacha_blocks2 is chacha_blocks4's first two blocks (SSSE3 on amd64), in place and not" {
  for seed in 0..6 {
    // the state and four counters (80 bytes), the second counter at the
    // 32 bit wrap on odd seeds
    var st = test_words(21 + seed, 10)
    if seed % 2 == 1 {
      st[8] = (st[8] & 4294967295) | 4294967295.wrapping_shl(32)
    }
    let src = test_words(31 + seed, 32)
    for inplace in [false, true] {
      var want = List[Int].with_capacity(32)
      var got = List[Int].with_capacity(32)
      for w in src {
        want.push(if inplace { w } else { 0 })
        got.push(if inplace { w } else { 0 })
      }
      let s = if inplace { lanes_addr(got) } else { lanes_addr(src) }
      let sw = if inplace { lanes_addr(want) } else { lanes_addr(src) }
      chacha_blocks4_soft(lanes_addr(want), sw, lanes_addr(st))
      chacha_blocks2(lanes_addr(got), s, lanes_addr(st))
      // 128 bytes written, the rest untouched
      for i in 0..16 {
        expect(got[i]) == want[i]
      }
      for i in 16..32 {
        expect(got[i]) == (if inplace { src[i] } else { 0 })
      }
    }
  }
}

test "chacha_stream8 is chacha_stream4's body (AVX2, 512 byte groups and a 256 byte tail, where the CPU has it)" {
  if target.arch != TargetArch.Amd64 || (hw() & HW_AVX2) != 0 {
    for blocks in 0..9 {
      let n = 256 * blocks
      for inplace in [false, true] {
        // the state and four counters (the last near the 32 bit wrap) in
        // 448 bytes (the AVX2 scratch after them)
        var st0 = test_words(41 + n, 56)
        for b in 0..4 {
          let w = st0[8 + b / 2]
          let c = (4294967290 + b) & 4294967295
          st0[8 + b / 2] = if b % 2 == 0 { (w & -4294967296) | c } else { (w & 4294967295) | c.wrapping_shl(32) }
        }
        let src = test_words(43 + n, n / 8 + 1)
        var sts: List[List[Int]] = []
        var dsts: List[List[Int]] = []
        for k in 0..2 {
          var st = List[Int].with_capacity(56)
          for w in st0 {
            st.push(w)
          }
          var d = List[Int].with_capacity(n / 8 + 1)
          for w in src {
            d.push(if inplace { w } else { 0 })
          }
          let s = if inplace { lanes_addr(d) } else { lanes_addr(src) }
          if k == 0 {
            chacha_stream4_soft(lanes_addr(d), s, lanes_addr(st), n)
          } else {
            chacha_stream8(lanes_addr(d), s, lanes_addr(st), n)
          }
          sts.push(st)
          dsts.push(d)
        }
        for i in 0..n / 8 + 1 {
          expect(dsts[1][i]) == dsts[0][i]
        }
        // the counters advanced alike
        for i in 0..10 {
          expect(sts[1][i]) == sts[0][i]
        }
      }
    }
  }
}
