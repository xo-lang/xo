// Tests of cpu.xo's timer reads (`xo test --std-module=native/llrt/cpu`,
// run by internal/stdtest): the generic timer on arm64, mono_ns
// elsewhere.

use native/llrt/sysio
use native/rt

test "ticks advance and ticks_ns converts a difference" {
  let hz = ticks_hz()
  expect(hz >= 1000000)
  let a = ticks()
  let t0 = sysio.mono_ns()
  while sysio.mono_ns() - t0 < 2000000 {
  }
  let d = ticks() - a
  expect(d > 0)
  let ns = ticks_ns(d)
  // 2 ms spun: between 1 ms and 1 s of ticks
  expect(ns >= 1000000 && ns < 1000000000)
  expect(ticks_ns(hz) == 1000000000)
  expect(ticks_ns(hz * 3 + hz / 2) == 3500000000)
  expect(ticks_ns(0) == 0)
}

test "crc32x is its body (the instruction where the CPU has it)" {
  // a seeded walk over crc and word values, the high bits of crc ignored
  var x = 88172645463325252
  for _ in 0..2000 {
    x = x ^ x.wrapping_shl(13)
    x = x ^ x.shr_logical(7)
    x = x ^ x.wrapping_shl(17)
    let crc = x.shr_logical(29)
    let w = x.wrapping_mul(2685821657736338717)
    let want = crc32x_soft(crc & 0xffffffff, w)
    if (hw() & HW_CRC32) != 0 {
      expect(crc32x(crc & 0xffffffff, w)) == want
    }
    expect(want & 0xffffffff) == want
  }
  // "12345678" from the IEEE initial value, then inverted: zlib's crc32
  expect(crc32x_soft(0xffffffff, 0x3837363534333231) ^ 0xffffffff) == 2598427311
}

test "crc32cx is its body (the instruction where the CPU has it)" {
  var x = 88172645463325252
  for _ in 0..2000 {
    x = x ^ x.wrapping_shl(13)
    x = x ^ x.shr_logical(7)
    x = x ^ x.wrapping_shl(17)
    let crc = x.shr_logical(29)
    let w = x.wrapping_mul(2685821657736338717)
    let want = crc32cx_soft(crc & 0xffffffff, w)
    if (hw() & HW_CRC32) != 0 {
      expect(crc32cx(crc & 0xffffffff, w)) == want
    }
    expect(want & 0xffffffff) == want
  }
  // "12345678" from the initial value, then inverted: CRC-32C (iSCSI)
  expect(crc32cx_soft(0xffffffff, 0x3837363534333231) ^ 0xffffffff) == 1619493018
}

/// The round constants for keccak_f1600 (sha3.xo RCS).
const TEST_RCS: List[Int] = [1, 32898, -9223372036854742902, -9223372034707259392, 32907, 2147483649, -9223372034707259263, -9223372036854743031, 138, 136, 2147516425, 2147483658, 2147516555, -9223372036854775669, -9223372036854742903, -9223372036854743037, -9223372036854743038, -9223372036854775680, 32778, -9223372034707292150, -9223372034707259263, -9223372036854742912, 2147483649, -9223372034707259384]

fn lanes_addr(l: List[Int]) -> Int { rt.obj_addr(l).wrapping_add(rt.layout(2)) }

test "keccak_f1600 is its body (the SHA3 extension where the CPU has it)" {
  // the zero state: FIPS 202's Keccak-f[1600] lanes 0 and 1 (XKCP's
  // KeccakF-1600-IntermediateValues)
  var z = List[Int].with_capacity(25)
  for _ in 0..25 {
    z.push(0)
  }
  keccak_f1600_soft(lanes_addr(z), lanes_addr(TEST_RCS))
  expect(z[0]) == -1070291585488265753
  expect(z[1]) == -8874962119976532086
  // a seeded walk of states, each permuted by the body and the kernel
  var x = 88172645463325252
  for _ in 0..200 {
    var a = List[Int].with_capacity(25)
    for _ in 0..25 {
      x = x ^ x.wrapping_shl(13)
      x = x ^ x.shr_logical(7)
      x = x ^ x.wrapping_shl(17)
      a.push(x)
    }
    var b = List[Int].with_capacity(25)
    for v in a {
      b.push(v)
    }
    keccak_f1600_soft(lanes_addr(a), lanes_addr(TEST_RCS))
    if (hw() & HW_SHA3) != 0 {
      keccak_f1600(lanes_addr(b), lanes_addr(TEST_RCS))
      for i in 0..25 {
        expect(b[i]) == a[i]
      }
    }
  }
}
