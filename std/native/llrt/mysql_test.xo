// std/sql's MySQL driver (decision 0648): DSNs, values, literals and
// interpolation, error mapping, and conversations with fake servers on
// FakeNet; the conformance run checks a real one.
use std/sql
use std/time
use native/llrt/mysqlauth as auth
use native/llrt/mysqlwire as w
use native/llrt/asn1
use native/llrt/rsa
use native/llrt/rsagen
use native/llrt/sha1

test "DSNs: go-sql-driver's documented format" {
  let c = config("app:p@ss:w@rd@tcp(db.internal:3307)/shop?parseTime=true&charset=utf8mb4&sql_mode=%27ANSI%27") ?? e => fault("${e}")
  expect((c.user, c.password, c.net, c.addr, c.database, c.tls, c.parse_time, c.collation)) == ("app", "p@ss:w@rd", "tcp", "db.internal:3307", "shop", "true", true, 45)
  expect(c.vars) == [("sql_mode", "'ANSI'")]
  let d = config("/") ?? e => fault("${e}")
  expect((d.user, d.net, d.addr, d.database)) == ("", "tcp", "127.0.0.1:3306", "")
  let u = config("root@unix(/var/run/mysqld/mysqld.sock)/x?tls=preferred") ?? e => fault("${e}")
  expect((u.net, u.addr, u.tls)) == ("unix", "/var/run/mysqld/mysqld.sock", "false")
  let h = config("u@tcp(db)/x") ?? e => fault("${e}")
  expect(h.addr) == "db:3306"
  let v6 = config("u@tcp([::1])/x") ?? e => fault("${e}")
  expect(v6.addr) == "[::1]:3306"
  let v6p = config("u@tcp([::1]:3307)/x") ?? e => fault("${e}")
  expect(v6p.addr) == "[::1]:3307"
  let a = config("u@/x?connectionAttributes=app:shop,env:prod&tls=skip-verify&clientFoundRows=true") ?? e => fault("${e}")
  expect((a.attrs, a.tls, a.client_found_rows)) == ([("app", "shop"), ("env", "prod")], "skip-verify", true)
}

test "DSNs: what is refused" {
  expect(config("u@tcp(x)").is_err()) == true
  expect(config("u@tcp(x/db").is_err()) == true
  expect(config("u@udp(x)/db").err()) == Some(sql.SqlErr.Param(msg: "unknown network udp"))
  expect(config("u@/db?tls=maybe").is_err()) == true
  expect(config("u@/db?parseTime=yes").err()) == Some(sql.SqlErr.Param(msg: "parseTime: invalid bool \"yes\""))
  expect(config("u@/db?loc=Local").is_err()) == true
  // loc's name is kept; its zone is the driver's (checked at connect)
  let ny = config("u@/db?loc=America%2FNew_York") ?? e => fault("${e}")
  expect((ny.loc, ny.zone.name())) == ("America/New_York", "UTC")
  expect(config("u@/db?allowOldPasswords=true").is_err()) == true
  expect(config("u@/db?collation=klingon").is_err()) == true
  expect(config("u@/db?x=%zz").is_err()) == true
}

fn col(kind: Int, charset: Int, flags: Int) -> w.Column {
  w.Column{schema: "", table: "t", org_table: "t", name: "c", org_name: "c", charset: charset, length: 20, kind: kind, flags: flags, decimals: 0}
}

test "values by column type" {
  expect(decode_text(col(8, 63, 0), Some(b"-42"), false)) == sql.SqlValue.Integer(n: -42)
  expect(decode_text(col(8, 63, 32), Some(b"18446744073709551615"), false)) == sql.SqlValue.Text(s: "18446744073709551615")
  expect(decode_text(col(246, 63, 0), Some(b"1.50"), false)) == sql.SqlValue.Text(s: "1.50")
  expect(decode_text(col(5, 63, 0), Some(b"2.5"), false)) == sql.SqlValue.Real(f: 2.5)
  expect(decode_text(col(253, 45, 0), Some(b"hi"), false)) == sql.SqlValue.Text(s: "hi")
  expect(decode_text(col(252, 63, 128), Some(b"\x00\xff"), false)) == sql.SqlValue.Blob(b: b"\x00\xff")
  expect(decode_text(col(245, 63, 0), Some(b"{\"a\": 1}"), false)) == sql.SqlValue.JsonText(s: "{\"a\": 1}")
  expect(decode_text(col(12, 63, 0), Some(b"2026-11-15 03:04:05.123456"), false)) == sql.SqlValue.Text(s: "2026-11-15 03:04:05.123456")
  expect(decode_text(col(12, 63, 0), Some(b"2026-11-15 03:04:05.123456"), true)) == sql.SqlValue.At(t: Time.parse_rfc3339("2026-11-15T03:04:05.123456Z") ?? Time.UNIX_EPOCH)
  expect(decode_text(col(10, 63, 0), Some(b"2026-11-15"), true)) == sql.SqlValue.At(t: Time.parse_rfc3339("2026-11-15T00:00:00Z") ?? Time.UNIX_EPOCH)
  expect(decode_text(col(11, 63, 0), Some(b"-838:59:59"), true)) == sql.SqlValue.Text(s: "-838:59:59")
  // a zero date and a year outside Time's range keep the server's text
  // (found by scripts/mysql-diff.sh: the zero date was 1970-01-01)
  expect(decode_text(col(12, 63, 0), Some(b"0000-00-00 00:00:00"), true)) == sql.SqlValue.Text(s: "0000-00-00 00:00:00")
  expect(decode_text(col(10, 63, 0), Some(b"0000-00-00"), true)) == sql.SqlValue.Text(s: "0000-00-00")
  expect(decode_text(col(12, 63, 0), Some(b"1000-01-01 00:00:00"), true)) == sql.SqlValue.Text(s: "1000-01-01 00:00:00")
  expect(decode_text(col(7, 63, 0), Some(b"2038-01-19 03:14:07"), true)) == sql.SqlValue.At(t: Time.from_unix(2147483647))
  expect(decode_text(col(3, 63, 0), None, true)) == sql.SqlValue.Null
}

// found by internal/stdtest TestMysqlFuzz against go-sql-driver v1.10.1's
// textRows.readRow: a value that does not convert is the query's error,
// a FLOAT is a float32, and a DATETIME is parseDateTime's
test "text values convert as go-sql-driver's" {
  expect(text_value(col(3, 63, 0), Some(b"12x"), false)) == Err("strconv.ParseInt: parsing \"12x\": invalid syntax")
  expect(text_value(col(8, 63, 0), Some(b"9223372036854775808"), false)) == Err("strconv.ParseInt: parsing \"9223372036854775808\": value out of range")
  expect(text_value(col(8, 63, 32), Some(b"-1"), false)) == Err("strconv.ParseUint: parsing \"-1\": invalid syntax")
  expect(text_value(col(8, 63, 32), Some(b"18446744073709551616"), false)) == Err("strconv.ParseUint: parsing \"18446744073709551616\": value out of range")
  expect(text_value(col(8, 63, 32), Some(b"018446744073709551615"), false)) == Ok(sql.SqlValue.Text(s: "18446744073709551615"))
  expect(text_value(col(4, 63, 0), Some(b"0.1"), false)) == Ok(sql.SqlValue.Real(f: 0.1))
  expect(text_value(col(4, 63, 0), Some(b"0.123456789"), false)) == Ok(sql.SqlValue.Real(f: 0.12345679))
  expect(text_value(col(4, 63, 0), Some(b"1e39"), false)) == Err("strconv.ParseFloat: parsing \"1e39\": value out of range")
  expect(text_value(col(5, 63, 0), Some(b"1e999"), false)) == Err("strconv.ParseFloat: parsing \"1e999\": value out of range")
  expect(text_value(col(5, 63, 0), Some(b"abc"), false)) == Err("strconv.ParseFloat: parsing \"abc\": invalid syntax")
  expect(text_value(col(12, 63, 0), Some(b"2024-02-30 25:00:00"), true)) == Ok(sql.SqlValue.At(t: Time.parse_rfc3339("2024-03-02T01:00:00Z") ?? Time.UNIX_EPOCH))
  expect(text_value(col(12, 63, 0), Some(b"2024-02-29 s3:59:59"), true)) == Err("not [0-9]")
  expect(text_value(col(12, 63, 0), Some(b"2024-02-29T23:59:59"), true)) == Err("bad value for field: `T`")
  expect(text_value(col(12, 63, 0), Some(b"2024-02-29 23:59"), true)) == Err("invalid time bytes: 2024-02-29 23:59")
  expect(text_value(col(12, 63, 0), Some(b"0000-00-00 00:00:00.000"), true)) == Ok(sql.SqlValue.Text(s: "0000-00-00 00:00:00.000"))
  // a row's bytes after its last value are refused, as go-sql-driver
  // master's readRow (96884ae, #1816)
  expect(w.parse_text_row(b"\x01a\x99", 1).is_err()) == true
}

test "literals and interpolation" {
  expect(quote_bytes(b"a'b\"c\\d\x00\n\r\x1a", false)) == "'a\\'b\\\"c\\\\d\\0\\n\\r\\Z'"
  expect(quote_bytes(b"it's", true)) == "'it''s'"
  expect(interpolate("SELECT ?, ?, ?, ?", [sql.int(1), sql.str("x"), sql.null(), sql.bool(true)], false)) == Ok("SELECT 1, 'x', NULL, 1")
  expect(interpolate("SELECT '?', \"?\", `?`, ? -- ?\n, /* ? */ ?", [sql.int(1), sql.int(2)], false)) == Ok("SELECT '?', \"?\", `?`, 1 -- ?\n, /* ? */ 2")
  expect(interpolate("SELECT 'it\\'s ?', ?", [sql.int(7)], false)) == Ok("SELECT 'it\\'s ?', 7")
  expect(interpolate("SELECT ?", [], false).is_err()) == true
  expect(interpolate("SELECT 1", [sql.int(1)], false).is_err()) == true
  expect(interpolate("SELECT ?", [sql.bytes(b"\x00\x01")], false)) == Ok("SELECT _binary'\\0\x01'")
  let t = Time.parse_rfc3339("2026-11-15T03:04:05.5Z") ?? Time.UNIX_EPOCH
  expect(datetime_text(t)) == "2026-11-15 03:04:05.5"
  expect(datetime_text(Time.parse_rfc3339("2026-11-15T03:04:05Z") ?? Time.UNIX_EPOCH)) == "2026-11-15 03:04:05"
}

test "server errors by number" {
  expect(server_err(w.ErrPacket{code: 1062, state: "23000", msg: "Duplicate entry '1' for key 'users.PRIMARY'"})) == sql.SqlErr.Constraint(msg: "Error 1062 (23000): Duplicate entry '1' for key 'users.PRIMARY'", code: "23000", name: "users.PRIMARY")
  expect(server_err(w.ErrPacket{code: 1452, state: "23000", msg: "Cannot add or update a child row: a foreign key constraint fails (`shop`.`o`, CONSTRAINT `o_ibfk_1` FOREIGN KEY (`u`) REFERENCES `u` (`id`))"}) is Constraint(..)) == true
  expect(server_err(w.ErrPacket{code: 1146, state: "42S02", msg: "Table 'shop.nope' doesn't exist"})) == sql.SqlErr.NoTable(name: "shop.nope")
  expect(server_err(w.ErrPacket{code: 1064, state: "42000", msg: "You have an error"})) == sql.SqlErr.Syntax(msg: "Error 1064 (42000): You have an error")
  expect(server_err(w.ErrPacket{code: 1213, state: "40001", msg: "Deadlock found"})) == sql.SqlErr.Server(code: "40001", msg: "Error 1213 (40001): Deadlock found")
  expect(fk_name("a foreign key constraint fails (`shop`.`o`, CONSTRAINT `o_ibfk_1` FOREIGN KEY")) == "o_ibfk_1"
}

// ---- fake servers on FakeNet (decision 0292), speaking the documented
// packets: they check what the driver sends and answer as MySQL 8 does

const FK_NONCE: Bytes = b"0123456789abcdefghij"

/// The server's caps: protocol 4.1 with plugins, and DEPRECATE_EOF when eof is false.
fn fk_caps(deprecate_eof: Bool) -> Int {
  let c = w.CLIENT_PROTOCOL_41 | w.CLIENT_SECURE_CONNECTION | w.CLIENT_PLUGIN_AUTH | w.CLIENT_PLUGIN_AUTH_LENENC_CLIENT_DATA | w.CLIENT_CONNECT_WITH_DB | w.CLIENT_TRANSACTIONS | w.CLIENT_MULTI_RESULTS | w.CLIENT_LONG_PASSWORD | w.CLIENT_CONNECT_ATTRS
  if deprecate_eof { c | w.CLIENT_DEPRECATE_EOF } else { c }
}

fn fk_handshake(caps: Int, plugin: Str) -> Bytes {
  var b = BytesBuilder.new()
  b.write_byte(10)
  b.write(b"8.4.3\x00")
  b.write_le(7, 4)
  b.write(FK_NONCE[0..8])
  b.write_byte(0)
  b.write_le(caps & 65535, 2)
  b.write_byte(255)
  b.write_le(2, 2)
  b.write_le(caps >> 16, 2)
  b.write_byte(21)
  b.write(b"\x00".repeat(10))
  b.write(FK_NONCE[8..20] + b"\x00")
  b.write(plugin.bytes() + b"\x00")
  b.freeze()
}

fn fk_ok(affected: Int, id: Int, status: Int) -> Bytes { b"\x00" + w.lenenc_int(affected) + w.lenenc_int(id) + w.le_bytes(status, 2) + b"\x00\x00" }

fn fk_err(code: Int, state: Str, msg: Str) -> Bytes { b"\xff" + w.le_bytes(code, 2) + "#${state}${msg}".bytes() }

fn fk_col(name: Str, kind: Int, charset: Int, flags: Int) -> Bytes {
  var b = BytesBuilder.new()
  for s in ["def", "app", "t", "t", name, name] {
    b.write(w.lenenc_str(s.bytes()))
  }
  b.write(b"\x0c")
  b.write_le(charset, 2)
  b.write_le(20, 4)
  b.write_byte(UInt8(kind))
  b.write_le(flags, 2)
  b.write(b"\x00\x00\x00")
  b.freeze()
}

/// Reads one packet of c: (payload, seq, the bytes after it).
fn fk_read(c: ServerConn, buf: Bytes) -> (Bytes, Int, Bytes)? ! NetErr {
  var have = buf
  while true {
    if let Some((p, seq, took)) = w.packet(have) {
      return Some((p, seq, have[took..have.len()]))
    }
    match c.read(65536)? {
      Some(more) => have = have + more
      None => return None
    }
  }
  None
}

/// A server: the handshake, the auth exchange login gives, then answer
/// per command packet (each answer a list of payloads, sent from seq 1).
fn fk_serve(l: Listener, caps: Int, plugin: Str, login: fn(Bytes, ServerConn, Int) -> Int ! NetErr uses net.listen, answer: fn(Bytes) -> List[Bytes] uses sync) -> () ! NetErr {
  while let Ok(c) = l.accept() {
    c.write(w.frame(0, fk_handshake(caps, plugin)).0)?
    let (resp, _, rest) = fk_read(c, b"")? ?? (b"", 0, b"")
    var buf = rest
    let _ = login(resp, c, 2)?
    while true {
      match fk_read(c, buf)? {
        Some((cmd, _, rest2)) => {
          buf = rest2
          if cmd.is_empty() || Int(cmd[0]) == w.COM_QUIT {
            break
          }
          var seq = 1
          for out in answer(cmd) {
            c.write(w.frame(seq, out).0)?
            seq += 1
          }
        }
        None => break
      }
    }
    c.close()
  }
}

/// The auth response's field after the user (lenenc auth data).
fn fk_auth_of(resp: Bytes) -> Bytes {
  var r = w.reader(resp[32..resp.len()])
  let _ = r.nul().ok() ?? b""
  (r.lenenc_bytes().ok() ?? None) ?? b""
}

/// caching_sha2_password's fast path: the scramble checked, then 0x03 and OK.
fn fk_sha2_fast(resp: Bytes, c: ServerConn, seq: Int) -> Int ! NetErr {
  if fk_auth_of(resp) != auth.sha2_scramble(b"pw", FK_NONCE) {
    c.write(w.frame(seq, fk_err(1045, "28000", "Access denied for user 'app'")).0)?
    return Ok(seq + 1)
  }
  c.write(w.frame(seq, b"\x01\x03").0)?
  c.write(w.frame(seq + 1, fk_ok(0, 0, 2)).0)?
  Ok(seq + 2)
}

/// COM_STMT_PREPARE_OK for statement id with its definitions (each a
/// VAR_STRING), and an EOF after each group on an old server.
fn fk_prepared(id: Int, params: Int, cols: List[Bytes], eof: Bool) -> List[Bytes] {
  var out = [b"\x00" + w.le_bytes(id, 4) + w.le_bytes(cols.len(), 2) + w.le_bytes(params, 2) + b"\x00\x00\x00"]
  for _ in 0..params {
    out.push(fk_col("?", w.TYPE_VAR_STRING, 63, 0))
  }
  if eof && params > 0 {
    out.push(b"\xfe\x00\x00\x02\x00")
  }
  for c in cols {
    out.push(c)
  }
  if eof && !cols.is_empty() {
    out.push(b"\xfe\x00\x00\x02\x00")
  }
  out
}

fn fk_rows_server(eof: Bool) -> fn(Bytes) -> List[Bytes] uses sync {
  fn(cmd) {
    let q = cmd[1..cmd.len()].to_str_lossy()
    if Int(cmd[0]) == w.COM_PING {
      return [fk_ok(0, 0, 2)]
    }
    // prepared statements: 1 an INSERT, 3 a SELECT with binary rows
    if Int(cmd[0]) == w.COM_STMT_CLOSE {
      return []
    }
    if Int(cmd[0]) == w.COM_STMT_PREPARE {
      if q.starts_with("INSERT") {
        return fk_prepared(1, 2, [], eof)
      }
      if q.starts_with("SELECT name, n FROM t WHERE id = ?") {
        return fk_prepared(3, 1, [fk_col("name", w.TYPE_VAR_STRING, 45, 0), fk_col("n", w.TYPE_LONGLONG, 63, w.FLAG_UNSIGNED)], eof)
      }
      if q.starts_with("SELECT * FROM missing") {
        return [fk_err(1146, "42S02", "Table 'app.missing' doesn't exist")]
      }
      return [fk_err(1064, "42000", "You have an error in your SQL syntax")]
    }
    if Int(cmd[0]) == w.COM_STMT_EXECUTE {
      let id = w.le(cmd, 1, 4)
      if id == 1 {
        let want = w.stmt_execute(1, [w.BinParam{kind: w.TYPE_LONGLONG, unsigned: false, null: false, value: w.le_bytes(1, 8)}, w.BinParam{kind: w.TYPE_STRING, unsigned: false, null: false, value: w.lenenc_str(b"x")}])
        return if cmd == want { [fk_ok(2, 41, 2)] } else { [fk_err(1210, "HY000", "Incorrect arguments to mysqld_stmt_execute")] }
      }
      if id == 3 {
        var out = [w.lenenc_int(2), fk_col("name", w.TYPE_VAR_STRING, 45, 0), fk_col("n", w.TYPE_LONGLONG, 63, w.FLAG_UNSIGNED)]
        if eof {
          out.push(b"\xfe\x00\x00\x02\x00")
        }
        // a row ("a", 2^64 - 1), then a row with name NULL (bit 2)
        out.push(b"\x00\x00" + w.lenenc_str(b"a") + b"\xff\xff\xff\xff\xff\xff\xff\xff")
        out.push(b"\x00\x04" + w.le_bytes(7, 8))
        out.push(if eof { b"\xfe\x00\x00\x02\x00" } else { b"\xfe\x00\x00\x02\x00\x00\x00" })
        return out
      }
      return [fk_err(1243, "HY000", "Unknown prepared statement handler")]
    }
    if q.starts_with("SELECT id") {
      var out = [w.lenenc_int(3), fk_col("id", w.TYPE_LONGLONG, 63, w.FLAG_NOT_NULL), fk_col("name", w.TYPE_VAR_STRING, 45, 0), fk_col("at", w.TYPE_DATETIME, 63, 0)]
      if eof {
        out.push(b"\xfe\x00\x00\x02\x00")
      }
      out.push(w.lenenc_str(b"1") + w.lenenc_str(b"a") + w.lenenc_str(b"2026-11-15 03:04:05"))
      out.push(w.lenenc_str(b"2") + b"\xfb" + b"\xfb")
      out.push(if eof { b"\xfe\x00\x00\x02\x00" } else { b"\xfe\x00\x00\x02\x00\x00\x00" })
      return out
    }
    if q.starts_with("INSERT") {
      return [fk_ok(2, 41, 2)]
    }
    if q.starts_with("BAD") {
      return [fk_err(1064, "42000", "You have an error in your SQL syntax")]
    }
    if q == "SELECT * FROM missing WHERE a = 'x\\'y' AND b = 7" {
      return [fk_err(1146, "42S02", "Table 'app.missing' doesn't exist")]
    }
    [fk_ok(0, 0, 2)]
  }
}

test "a fake server: caching_sha2_password's fast path, rows with DEPRECATE_EOF, an exec's counts" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_fast, fk_rows_server(false)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&parseTime=true")?
    let rows = db.query("SELECT id, name, at FROM t")?
    expect(rows.len()) == 2
    expect(rows[0].int("id")) == Ok(1)
    expect(rows[0].str("name")) == Ok("a")
    expect(rows[0].time("at").map(fn(t) { t.format_rfc3339() })) == Ok("2026-11-15T03:04:05Z")
    expect(rows[1].str_opt("name")) == Ok(None)
    let r = db.exec("INSERT INTO t VALUES (?, ?)", [sql.int(1), sql.str("x")])?
    expect((r.rows_affected, r.last_insert_id)) == (2, 41)
    expect(db.exec("BAD").err()) == Some(sql.SqlErr.Syntax(msg: "Error 1064 (42000): You have an error in your SQL syntax"))
    // prepared: an error at prepare; binary rows; a count mismatch
    expect(db.query("SELECT * FROM missing WHERE a = ? AND b = ?", [sql.str("x'y"), sql.int(7)]).err()) == Some(sql.SqlErr.NoTable(name: "app.missing"))
    let bin = db.query("SELECT name, n FROM t WHERE id = ?", [sql.int(1)])?
    expect(bin.len()) == 2
    expect(bin[0].value("name")) == Ok(sql.SqlValue.Text(s: "a"))
    expect(bin[0].value("n")) == Ok(sql.SqlValue.Text(s: "18446744073709551615"))
    expect(bin[1].value("name")) == Ok(sql.SqlValue.Null)
    expect(bin[1].int("n")) == Ok(7)
    expect(db.query("SELECT name, n FROM t WHERE id = ?", [sql.int(1), sql.int(2)]).err()) == Some(sql.SqlErr.Param(msg: "the statement has 1 placeholders and 2 arguments"))
    // the connection is still in step after each of those
    expect(db.ping().is_ok()) == true
    // interpolateParams=true: the arguments in the text, escaped
    let text = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&interpolateParams=true")?
    expect(text.query("SELECT * FROM missing WHERE a = ? AND b = ?", [sql.str("x'y"), sql.int(7)]).err()) == Some(sql.SqlErr.NoTable(name: "app.missing"))
    expect(text.exec("BAD ?", [sql.int(1)]).err()) == Some(sql.SqlErr.Syntax(msg: "Error 1064 (42000): You have an error in your SQL syntax"))
    s.cancel()
  }
}

test "a fake server: an old server's EOF packets" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(false), "caching_sha2_password", fk_sha2_fast, fk_rows_server(true)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false")?
    let rows = db.query("SELECT id, name, at FROM t")?
    expect(rows.len()) == 2
    expect(rows[0].str("at")) == Ok("2026-11-15 03:04:05")
    s.cancel()
  }
}

test "a fake server: a wrong password is the server's error" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_fast, fk_rows_server(false)).ignore_err("the server stops when the test ends") })
    let r = sql.open(os.net, "mysql", "app:wrong@tcp(db.test:3306)/app?tls=false")
    expect(r.err()) == Some(sql.SqlErr.Server(code: "28000", msg: "Error 1045 (28000): Access denied for user 'app'"))
    s.cancel()
  }
}

/// A switch to mysql_native_password with a new nonce.
fn fk_switch_native(resp: Bytes, c: ServerConn, seq: Int) -> Int ! NetErr {
  let fresh = b"ABCDEFGHIJKLMNOPQRST"
  c.write(w.frame(seq, b"\xfemysql_native_password\x00" + fresh + b"\x00").0)?
  let (back, _, _) = fk_read(c, b"")? ?? (b"", 0, b"")
  if back != auth.native_scramble(b"pw", fresh) {
    c.write(w.frame(seq + 2, fk_err(1045, "28000", "Access denied")).0)?
    return Ok(seq + 3)
  }
  c.write(w.frame(seq + 2, fk_ok(0, 0, 2)).0)?
  Ok(seq + 3)
}

test "a fake server: an AuthSwitchRequest to mysql_native_password, and allowNativePasswords=false" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_switch_native, fk_rows_server(false)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false")?
    expect(db.query("SELECT id, name, at FROM t").map(fn(r) { r.len() })) == Ok(2)
    let refused = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&allowNativePasswords=false")
    expect(refused.err()) == Some(sql.SqlErr.Conn(msg: "mysql_native_password is not allowed (allowNativePasswords=false)"))
    s.cancel()
  }
}

/// caching_sha2_password's full authentication: 0x04, then the password
/// over a link the driver must call secure.
fn fk_sha2_full(resp: Bytes, c: ServerConn, seq: Int) -> Int ! NetErr {
  c.write(w.frame(seq, b"\x01\x04").0)?
  c.write(w.frame(seq + 2, fk_ok(0, 0, 2)).0)?
  Ok(seq + 3)
}

test "a fake server: full authentication over plain TCP is refused, TLS is required by default" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_full, fk_rows_server(false)).ignore_err("the server stops when the test ends") })
    let r = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false")
    expect(r.err().map(fn(e) { "${e}".contains("needs TLS, server_pub_key: (PEM) on sql.open, or allowPublicKeyRetrieval=true") })) == Some(true)
    // the default is tls=true, and this server has no TLS
    let d = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app")
    expect(d.err()) == Some(sql.SqlErr.Conn(msg: "the server does not support TLS (tls=true; tls=false to connect in plain text)"))
    s.cancel()
  }
}

fn utc(s: Str) -> Time { Time.parse_rfc3339(s) ?? fault("not a time: ${s}") }

test "loc: wall times in a zone, Go's time.Date rule in gaps and overlaps" {
  let ny = time.zone("America/New_York") ?? e => fault("${e}")
  let be = time.zone("Europe/Berlin") ?? e => fault("${e}")
  // the vectors are Go 1.26's time.Date(...).UTC()
  for (z, wall, want) in [(ny, "2026-03-08T02:30:00Z", "2026-03-08T06:30:00Z"), (ny, "2026-11-01T01:30:00Z", "2026-11-01T05:30:00Z"), (ny, "2026-07-01T12:00:00Z", "2026-07-01T16:00:00Z"), (be, "2026-03-29T02:30:00Z", "2026-03-29T01:30:00Z"), (be, "2026-10-25T02:30:00Z", "2026-10-25T01:30:00Z")] {
    expect(wall_in(utc(wall), z).format_rfc3339()) == want
  }
  expect(decode_text(col(12, 63, 0), Some(b"2026-07-01 12:00:00"), true, ny)) == sql.SqlValue.At(t: utc("2026-07-01T16:00:00Z"))
  expect(decode_text(col(10, 63, 0), Some(b"2026-01-15"), true, be)) == sql.SqlValue.At(t: utc("2026-01-14T23:00:00Z"))
  // binds: the wall clock in loc, in the text and in the binary protocol
  expect(datetime_text(utc("2026-07-01T16:00:00.25Z"), ny)) == "2026-07-01 12:00:00.25"
  expect(literal(sql.time(utc("2026-01-14T23:00:00Z")), false, be)) == Ok("'2026-01-15 00:00:00'")
  expect(bin_param(sql.time(utc("2026-07-01T16:00:00Z")), ny).map(fn(p) { p.value })) == Ok(w.lenenc_str(b"2026-07-01 12:00:00"))
}

test "a fake server: loc's zone comes from the driver, and a DSN naming another is refused" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_fast, fk_rows_server(false)).ignore_err("the server stops when the test ends") })
    let ny = time.zone("America/New_York") ?? e => fault("${e}")
    let db = sql.open_driver(os.net, MysqlDriver{roots: b"", zone: ny}, "app:pw@tcp(db.test:3306)/app?tls=false&parseTime=true&loc=America%2FNew_York")?
    let rows = db.query("SELECT id, name, at FROM t")?
    // 2026-11-15 03:04:05 in New York (EST) is 08:04:05 UTC
    expect(rows[0].time("at").map(fn(t) { t.format_rfc3339() })) == Ok("2026-11-15T08:04:05Z")
    let refused = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&loc=America%2FNew_York")
    expect(refused.err().map(fn(e) { "${e}".contains("the driver's zone is UTC") })) == Some(true)
    s.cancel()
  }
}

/// k's public half (e is rsagen's 65537) as MySQL sends it: a PEM
/// PUBLIC KEY (SubjectPublicKeyInfo).
fn fk_pem(k: rsa.PrivateKey) -> Bytes {
  let pkcs1 = asn1.enc_seq([asn1.enc_uint(k.n), asn1.enc_uint(b"\x01\x00\x01")])
  let alg = asn1.enc_seq([asn1.enc(asn1.OID, Bytes.from_hex("2a864886f70d010101") ?? b""), asn1.enc(asn1.NULL, b"")])
  let spki = asn1.enc_seq([alg, asn1.enc(asn1.BIT_STRING, b"\x00" + pkcs1)])
  "-----BEGIN PUBLIC KEY-----\n${spki.to_base64()}\n-----END PUBLIC KEY-----\n".bytes()
}

/// caching_sha2_password's full authentication over plain TCP: 0x04, the
/// key on a request (0x02), then the password under RSA, decrypted here.
fn fk_sha2_rsa(k: rsa.PrivateKey) -> fn(Bytes, ServerConn, Int) -> Int ! NetErr uses net.listen {
  fn(resp, c, seq) {
    c.write(w.frame(seq, b"\x01\x04").0)?
    var (got, _, _) = fk_read(c, b"")? ?? (b"", 0, b"")
    var next = seq + 2
    if got == b"\x02" {
      c.write(w.frame(next, b"\x01" + fk_pem(k)).0)?
      got = (fk_read(c, b"")? ?? (b"", 0, b"")).0
      next += 2
    }
    let plain = rsa.decrypt_oaep_fn(k, 20, fn(b) { sha1.sum(b) }, got, b"")
    if plain != Some(auth.rsa_plain(b"pw", FK_NONCE)) {
      c.write(w.frame(next, fk_err(1045, "28000", "Access denied")).0)?
      return Ok(next + 1)
    }
    c.write(w.frame(next, fk_ok(0, 0, 2)).0)?
    Ok(next + 1)
  }
}

test "a fake server: RSA full authentication with the server's key or open's" {
  let k = rsagen.generate(1024, fn(n: Int) -> Bytes uses rand { os.rand.bytes(n) }) ?? fault("rsa key")
  let l = os.net.listen("db.test:3306")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_rsa(k), fk_rows_server(false)).ignore_err("the server stops when the test ends") })
    // the key fetched from the server, only when allowed
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&allowPublicKeyRetrieval=true")?
    expect(db.ping().is_ok()) == true
    // open's key: no request
    let pinned = sql.open_driver(os.net, MysqlDriver{roots: b"", pub_key: fk_pem(k)}, "app:pw@tcp(db.test:3306)/app?tls=false&serverPubKey=srv")?
    expect(pinned.ping().is_ok()) == true
    // a wrong key: the server cannot decrypt the password
    let other = rsagen.generate(1024, fn(n: Int) -> Bytes uses rand { os.rand.bytes(n) }) ?? fault("rsa key")
    let wrong = sql.open_driver(os.net, MysqlDriver{roots: b"", pub_key: fk_pem(other)}, "app:pw@tcp(db.test:3306)/app?tls=false")
    expect(wrong.err()) == Some(sql.SqlErr.Server(code: "28000", msg: "Error 1045 (28000): Access denied"))
    // serverPubKey without open's key, and a key that is not one
    expect(sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&serverPubKey=srv").err()) == Some(sql.SqlErr.Param(msg: "serverPubKey=srv needs server_pub_key: (PEM) on sql.open"))
    expect(sql.open_driver(os.net, MysqlDriver{roots: b"", pub_key: b"junk"}, "app:pw@tcp(db.test:3306)/app?tls=false").is_err()) == true
    s.cancel()
  }
}

/// A server that logs each command (decision 0648 stage D): statement 3
/// as fk_rows_server's, and "MULTI" as two result sets with an OK
/// between them (SERVER_MORE_RESULTS_EXISTS).
fn fk_stmt_server(log: Mutex[List[Str]]) -> fn(Bytes) -> List[Bytes] uses sync {
  let rows = fk_rows_server(false)
  fn(cmd) {
    let kind = Int(cmd[0])
    let q = cmd[1..cmd.len()].to_str_lossy()
    if kind == w.COM_STMT_PREPARE {
      log.with(fn(var xs) { xs.push("prepare ${q}") })
    } else if kind == w.COM_STMT_EXECUTE {
      log.with(fn(var xs) { xs.push("execute ${w.le(cmd, 1, 4)}") })
    } else if kind == w.COM_STMT_CLOSE {
      log.with(fn(var xs) { xs.push("close ${w.le(cmd, 1, 4)}") })
    } else if kind == w.COM_QUERY {
      log.with(fn(var xs) { xs.push("query ${q}") })
    }
    if kind == w.COM_QUERY && q == "MULTI" {
      // SELECT 1 AS a; UPDATE ...; SELECT 'x' AS b
      return [w.lenenc_int(1), fk_col("a", w.TYPE_LONGLONG, 63, 0), w.lenenc_str(b"1"), b"\xfe\x00\x00\x0a\x00\x00\x00", fk_ok(3, 0, 10), w.lenenc_int(1), fk_col("b", w.TYPE_VAR_STRING, 45, 0), w.lenenc_str(b"x"), w.lenenc_str(b"y"), b"\xfe\x00\x00\x02\x00\x00\x00"]
    }
    rows(cmd)
  }
}

test "a fake server: a Stmt prepares once per connection, runs, and closes; query_all reads every result set" {
  let l = os.net.listen("db.test:3306")?
  let log: Mutex[List[Str]] = Mutex.new([])
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_fast, fk_stmt_server(log)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&multiStatements=true", max_open: 1)?
    let st = db.prepare("SELECT name, n FROM t WHERE id = ?")?
    expect(st.query([sql.int(1)])?.len()) == 2
    expect(st.query_one([sql.int(1)])?.str("name")) == Ok("a")
    // a count mismatch is refused before COM_STMT_EXECUTE
    expect(st.query([]).err()) == Some(sql.SqlErr.Param(msg: "the statement has 1 placeholders and 0 arguments"))
    st.close()
    expect(st.query([sql.int(1)]).err()) == Some(sql.SqlErr.Closed)
    // a prepare error is the call's
    expect(db.prepare("SELECT * FROM missing").err()) == Some(sql.SqlErr.NoTable(name: "app.missing"))
    let sets = db.query_all("MULTI")?
    expect(sets.len()) == 2
    expect(sets[0].columns()) == ["a"]
    expect(sets[0].rows()[0].int("a")) == Ok(1)
    expect(sets[1].columns()) == ["b"]
    expect(sets[1].rows().map(fn(r) { r.str("b").or_fault("b") })) == ["x", "y"]
    // query keeps the first set
    expect(db.query("MULTI")?.len()) == 1
    // in step after all of that (COM_STMT_CLOSE has no response)
    expect(db.ping().is_ok()) == true
    expect(log.with_read(fn(xs) { xs })) == ["prepare SELECT name, n FROM t WHERE id = ?", "execute 3", "execute 3", "close 3", "prepare SELECT * FROM missing", "query MULTI", "query MULTI"]
    s.cancel()
  }
}

test "DSNs: timeout, readTimeout and writeTimeout in Go's duration syntax" {
  let c = config("u@tcp(db)/x?timeout=1m30s&readTimeout=500ms&writeTimeout=2s") ?? e => fault("${e}")
  expect((c.dial_timeout.millis(), c.read_timeout.millis(), c.write_timeout.millis())) == (90000, 500, 2000)
  let d = config("u@tcp(db)/x") ?? e => fault("${e}")
  expect((d.dial_timeout.nanos(), d.read_timeout.nanos(), d.write_timeout.nanos())) == (0, 0, 0)
  expect(config("u@tcp(db)/x?readTimeout=5").err()) == Some(sql.SqlErr.Param(msg: "readTimeout: invalid duration \"5\""))
}

/// One connection of fk_kill_serve: each COM_QUERY's text goes to seen; a
/// SLEEP gets no answer (the server is busy until the client goes), the
/// rest an OK.
fn fk_kill_conn(c: ServerConn, seen: Chan[Str]) -> () ! NetErr {
  c.write(w.frame(0, fk_handshake(fk_caps(true), "caching_sha2_password")).0)?
  let (resp, _, rest) = fk_read(c, b"")? ?? (b"", 0, b"")
  var buf = rest
  let _ = fk_sha2_fast(resp, c, 2)?
  while let Some((cmd, _, rest2)) = fk_read(c, buf)? {
    buf = rest2
    if cmd.is_empty() || Int(cmd[0]) == w.COM_QUIT {
      break
    }
    if Int(cmd[0]) == w.COM_QUERY {
      let q = cmd[1..cmd.len()].to_str_lossy()
      seen.send(q)
      if q.starts_with("SELECT SLEEP") {
        continue
      }
    }
    c.write(w.frame(1, fk_ok(0, 0, 2)).0)?
  }
  c.close()
  Ok(())
}

fn fk_kill_serve(l: Listener, seen: Chan[Str]) -> () ! NetErr {
  scope s {
    while let Ok(c) = l.accept() {
      s.spawn_background(fn() { fk_kill_conn(c, seen).ignore_err("a connection ends with the test") })
    }
  }
  Ok(())
}

test "a cancelled query: KILL QUERY with the connection's id on a second connection" {
  let l = os.net.listen("db.test:3306")?
  let seen = Chan[Str].new(8)
  scope s {
    s.spawn_background(fn() { fk_kill_serve(l, seen).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false")?
    scope q {
      q.spawn(fn() { db.exec("SELECT SLEEP(60)") })
      expect(seen.recv()) == Some("SELECT SLEEP(60)")
      q.cancel()
    }
    expect(seen.recv()) == Some("KILL QUERY 7")
    s.cancel()
  }
}

test "readTimeout: a server that does not answer is an i/o timeout, and the connection is dropped" {
  let l = os.net.listen("db.test:3306")?
  let seen = Chan[Str].new(8)
  scope s {
    s.spawn_background(fn() { fk_kill_serve(l, seen).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false&readTimeout=50ms&timeout=1s")?
    let e = db.exec("SELECT SLEEP(60)").err()
    expect(seen.recv()) == Some("SELECT SLEEP(60)")
    expect(e) == Some(sql.SqlErr.Conn(msg: "i/o timeout"))
    // a new connection for the next
    expect(db.exec("DO 1").is_ok()) == true
    expect(seen.recv()) == Some("DO 1")
    s.cancel()
  }
}

/// fk_rows_server with each COM_QUERY's text logged.
fn fk_log_server(log: Mutex[List[Str]]) -> fn(Bytes) -> List[Bytes] uses sync {
  let rows = fk_rows_server(false)
  fn(cmd) {
    if Int(cmd[0]) == w.COM_QUERY {
      let q = cmd[1..cmd.len()].to_str_lossy()
      log.with(fn(var xs) { xs.push(q) })
    }
    rows(cmd)
  }
}

test "a fake server: batch and pipeline (decision 0648 item 15) run each batch in START TRANSACTION and COMMIT, ROLLBACK at its first error, nothing more inside a transaction" {
  let l = os.net.listen("db.test:3306")?
  let log: Mutex[List[Str]] = Mutex.new([])
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_caps(true), "caching_sha2_password", fk_sha2_fast, fk_log_server(log)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false", max_open: 1)?
    let sets = db.batch([sql.BatchQuery{query: "INSERT INTO t VALUES (1, 'x')"}, sql.BatchQuery{query: "SELECT id, name, at FROM t"}])?
    expect(sets.map(fn(x) { x.rows_affected() })) == [2, 2]
    expect(sets[1].columns()) == ["id", "name", "at"]
    expect(sets[1].rows()[0].int("id")) == Ok(1)
    let outs = db.pipeline([[sql.BatchQuery{query: "INSERT a"}, sql.BatchQuery{query: "BAD"}, sql.BatchQuery{query: "INSERT b"}], [sql.BatchQuery{query: "INSERT c"}]])?
    expect(outs[0].err()) == Some(sql.SqlErr.Syntax(msg: "Error 1064 (42000): You have an error in your SQL syntax"))
    expect(outs[1].map(fn(xs) { xs.len() })) == Ok(1)
    let tx = db.begin()?
    expect(tx.batch([sql.BatchQuery{query: "INSERT d"}, sql.BatchQuery{query: "BAD"}]).is_err()) == true
    tx.rollback()?
    expect(log.with_read(fn(xs) { xs })) == ["START TRANSACTION", "INSERT INTO t VALUES (1, 'x')", "SELECT id, name, at FROM t", "COMMIT", "START TRANSACTION", "INSERT a", "BAD", "ROLLBACK", "START TRANSACTION", "INSERT c", "COMMIT", "START TRANSACTION", "INSERT d", "BAD", "ROLLBACK"]
    s.cancel()
  }
}

/// fk_serve, but each connection closes after its first statement's
/// answer, as a server whose wait_timeout passed while it sat idle.
fn fk_serve_once(l: Listener, answer: fn(Bytes) -> List[Bytes] uses sync, closed: Chan[Int]) -> () ! NetErr {
  while let Ok(c) = l.accept() {
    c.write(w.frame(0, fk_handshake(fk_caps(true), "caching_sha2_password")).0)?
    let (resp, _, rest) = fk_read(c, b"")? ?? (b"", 0, b"")
    let _ = fk_sha2_fast(resp, c, 2)?
    if let Some((cmd, _, _)) = fk_read(c, rest)? {
      var seq = 1
      for out in answer(cmd) {
        c.write(w.frame(seq, out).0)?
        seq += 1
      }
    }
    c.close()
    closed.send(1)
  }
}

// found by internal/stdtest TestMysqlFuzz: a pooled connection the
// server closed while idle failed the next statement, where
// go-sql-driver's connCheck has database/sql take another
test "a fake server: an idle connection the server closed is not reused" {
  let l = os.net.listen("db.test:3306")?
  scope s {
    let closed: Chan[Int] = Chan.new(4)
    s.spawn_background(fn() { fk_serve_once(l, fk_rows_server(false), closed).ignore_err("the server stops when the test ends") })
    // open's ping is the first connection's one statement
    let db = sql.open(os.net, "mysql", "app:pw@tcp(db.test:3306)/app?tls=false")?
    for _ in 0..3 {
      // the idle connection's server has closed it
      expect(closed.recv()) == Some(1)
      expect(db.query("SELECT id, name, at FROM t").map(fn(rows) { rows.len() })) == Ok(2)
    }
    expect(db.stats().idle) <= 1
    s.cancel()
  }
}
