// The C path of the number text (decision 0193 step 3): the API of
// num.xo over the C runtime's functions. Loaded in place of num.xo when
// XO_LLRT_C names `num`, to compare the two and to fall back while the
// Xo path misses decision 0180's bar; the SSA builder then calls the C
// runtime's str.concat_int and friends directly, as before the port. The
// self hosted compiler always uses num.xo.
use native/rt

pub fn append_int(out: Str, v: Int) -> Str { rt.rs_concat_int(out, v) }

pub fn int_text(v: Int) -> Str { rt.rs_concat_int("", v) }

pub fn append_float(out: Str, f: Float) -> Str { rt.rs_concat_float(out, f) }

pub fn float_text(f: Float) -> Str { rt.rs_concat_float("", f) }

pub fn parse_float(s: Str) -> Float? {
  if rt.float_parse_ok(s) {
    return Some(rt.float_parse(s))
  }
  None
}
