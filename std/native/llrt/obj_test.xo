// Tests of obj.xo (decision 0262): `xo test --std-module=native/llrt/obj`,
// run by internal/stdtest.

use native/llrt/alloc
use native/rt

test "Str == of 1 to 20 bytes: a difference at each place, and equal copies" {
  let s = "abcdefghijklmnopqrst"
  for n in 1..21 {
    let a = s[0..n]
    // a copy in another object (not the same address: str_eq's short path)
    let c = a[0..n - 1] + a[n - 1..n]
    expect(a == c) == true
    for i in 0..n {
      let b = a[0..i] + "#" + a[i + 1..n]
      expect(a == b) == false
    }
  }
}

/// alloc_obj's blocks of the page classes (decision 0425): a 16 KiB class
/// block is page aligned (no prefix), keeps its words, is reused after
/// its free, stays in place when resized within its class and moves with
/// its words when it outgrows it; the classes below keep their prefix.
test "page class blocks are page aligned, kept, reused and resized" {
  // the classes above 16 KiB are big blocks under darwin's limit at
  // start (heapos.xo mid_default, 16 KiB since 2026-10-30: a 20000 byte
  // block came back 16 past a page), so the test raises this thread's
  // limit to MID_MAX (alloc.MID_MAX_LIMIT) for its blocks and puts it
  // back at its end
  let h = heap_word()
  let mid0 = alloc.mid_max_of(h)
  alloc.set_mid_max_of(h, alloc.MID_MAX_LIMIT)
  let p = alloc_obj(16000)
  expect(p & 16383) == 0
  let q = alloc_obj(8000)
  // 8 aligned (its prefix is the 8 bytes before it); which of the 8 and 0
  // mod 16 it is depends on how many blocks of the class came before it
  // from the chunk (stride size + 8), so not asserted (arm64 linux, 0 mod 16)
  expect(q & 7) == 0
  var i = 0
  while i < 2000 {
    rt.mem_store(p, i * 8, i + 7, 8)
    i += 1
  }
  // a second block of the class is the next page block, not p
  let p2 = alloc_obj(16376)
  expect(p2 & 16383) == 0
  expect(p2 == p) == false
  // in place within the class
  let r = resize_obj(p, 16000, 16376)
  expect(r) == p
  // a move to the 32 KiB class keeps the words
  let s = resize_obj(r, 16376, 20000)
  expect(s & 16383) == 0
  expect(s == p) == false
  var bad = 0
  i = 0
  while i < 2000 {
    if rt.mem_load(s, i * 8, 8) != i + 7 {
      bad += 1
    }
    i += 1
  }
  expect(bad) == 0
  // p is on its free list: the next 16 KiB block is p again
  let t = alloc_obj(15000)
  expect(t) == p
  // a prefixed block that grows into a page class moves to a page block
  let u = resize_obj(q, 8000, 15000)
  expect(u & 16383) == 0
  free_obj(u)
  free_obj(t)
  free_obj(s)
  free_obj(p2)
  alloc.set_mid_max_of(h, mid0)
}

test "many page class blocks across chunks are distinct and freed" {
  // the 32 KiB class is a page class only above darwin's limit at start
  // (the test above): raised for this thread while the blocks live
  let h = heap_word()
  let mid0 = alloc.mid_max_of(h)
  alloc.set_mid_max_of(h, alloc.MID_MAX_LIMIT)
  // 600 blocks of 32 KiB: more than one 4 MiB page chunk (127 blocks each)
  var bs: List[Int] = []
  for k in 0..600 {
    let b = alloc_obj(30000)
    expect(b & 16383) == 0
    rt.mem_store(b, 0, k, 8)
    rt.mem_store(b, 29992, k, 8)
    bs.push(b)
  }
  var bad = 0
  for k in 0..600 {
    if rt.mem_load(bs[k], 0, 8) != k || rt.mem_load(bs[k], 29992, 8) != k {
      bad += 1
    }
  }
  expect(bad) == 0
  // every block's page table word is its class (78) with no sample bit
  // read back through free and a new allocation: the freed blocks come
  // back in reverse order
  for k in 0..600 {
    free_obj(bs[k])
  }
  let again = alloc_obj(30000)
  expect(again) == bs[599]
  free_obj(again)
  alloc.set_mid_max_of(h, mid0)
}

/// A growing List takes what its block holds (Go's roundupsize): the block
/// sizes follow alloc.alloc's classes, and a list's capacity leaves no room
/// for one more element in its block.
test "a growing List's capacity fills its block" {
  let h = heap_word()
  expect(block_size(h, 100)) == 112
  expect(block_size(h, 1024)) == 1024
  expect(block_size(h, 1025)) == 1272
  expect(block_size(h, 1273)) == 1528
  expect(block_size(h, 2041)) == 2552
  expect(block_size(h, 8185)) == 16376
  expect(block_size(h, 16376)) == 16376
  expect(block_size(h, 16377)) == 32760
  let over = alloc.mid_max_of(h & -2) + 1
  expect(block_size(h, over)) == over
  var xs: List[Int] = []
  for i in 0..200 {
    xs.push(i)
  }
  let cap = rt.mem_load(rt.obj_addr(xs), 16, 8)
  expect(cap >= 200)
  expect(block_size(h, L_HDR + 8 * cap) < L_HDR + 8 * (cap + 1))
}

test "every size above 1 KiB gets the smallest class that holds it (decision 0506)" {
  // the class sizes: 12 blocks of 1280 to 8192 bytes, four a doubling,
  // then 16 KiB to 256 KiB (the page classes)
  var sizes: List[Int] = []
  for c in 65..82 {
    sizes.push(alloc.class_size(c) + 8)
  }
  expect(sizes) == [1280, 1536, 1792, 2048, 2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192, 16384, 32768, 65536, 131072, 262144]
  var bad = 0
  for n in 1025..alloc.MID_MAX_LIMIT + 1 {
    let c = alloc.class_of(n)
    if alloc.class_size(c) < n || (c > 65 && alloc.class_size(c - 1) >= n) {
      bad += 1
    }
  }
  expect(bad) == 0
  expect(alloc.class_of(1025)) == 65
  expect(alloc.class_of(8184)) == 76
  expect(alloc.class_of(8185)) == 77
  expect(alloc.class_of(16376)) == 77
  expect(alloc.class_of(16377)) == 78
  expect(alloc.class_of(alloc.MID_MAX_LIMIT)) == 81
  expect(alloc.page_size(8184)) == false
  expect(alloc.page_size(8185)) == true
}

test "cut_for's donors are an exact number of the class's blocks (decision 0506)" {
  // heapos.xo cut_for cuts a class above 1 KiB only from the classes 4, 8,
  // ... after it, below the page class (77): each such block (with its 8
  // byte prefix) must be a whole number of the smaller's, or the rest is
  // lost (gotchas/size-class-cut-tail-leak.md)
  var bad = 0
  for c in 65..77 {
    var d = c + 4
    while d < 77 {
      if (alloc.class_size(d) + 8) % (alloc.class_size(c) + 8) != 0 {
        bad += 1
      }
      d += 4
    }
  }
  expect(bad) == 0
}
