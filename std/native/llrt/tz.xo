// std/time's zones on the native backends (decision 0193 step 5): the
// rules are tzrules.xo's; this file adds the program's own zone data
// (tztable.xo, which std/time programs link) to the host's database.
use native/llrt/sysio
use native/llrt/tzhost
use native/llrt/tzrules
use native/llrt/tztable

/// No zone (UTC).
pub fn none() -> tzrules.Rules { tzrules.none() }

/// The zone named name: from the program's zone data, or with host set
/// from the host's database ("Local": the machine's zone); none when it
/// is not a zone name or has no data that parses.
pub fn load(name: Str, host: Bool) -> tzrules.Rules? {
  if host {
    return tzrules.load_host(name)
  }
  if sysio.layer() == 0 {
    // WebAssembly: the program's zone data, no kept table (tzhost.xo's
    // is shared between threads, its lock and exit hook native)
    if !tzrules.valid(name) || name == "Local" {
      return None
    }
    let w = tzrules.parse_unkept(name, tztable.data(name, false))
    if w.is_empty() {
      return None
    }
    return Some(tzrules.of(w))
  }
  // the table holds only names that passed the check below, and "Local"
  // from the host's database
  var w = tzhost.find(name)
  if w.len() != 0 && name.len() == 5 && name == "Local" {
    return None
  }
  if w.len() == 0 {
    if !tzrules.valid(name) {
      return None
    }
    w = tzrules.parse_kept(name, tztable.data(name, false))
    if w.len() == 0 {
      return None
    }
  }
  Some(tzrules.of(w))
}

/// The machine's zone name from the /etc/localtime link, or "Local".
pub fn local_name() -> Str { tzrules.local_name() }

pub fn offset(r: tzrules.Rules, sec: Int) -> Int { tzrules.offset(r, sec) }

pub fn abbr(r: tzrules.Rules, sec: Int) -> Str { tzrules.abbr(r, sec) }
