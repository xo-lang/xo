// The Linux system call layer of the native runtime, written in Xo
// (decision 0206, stage 1 of decision 0203): raw system calls through
// rt.sys6, which the emitters lower inline (`svc #0` on arm64, `syscall`
// on x86_64), with no C library between the program and the kernel. A
// call returns what the kernel returns: a result >= 0, or a negative
// errno. The structures the kernel reads or writes are Bytes buffers
// (raw.bytes_buf, the scratch of obj.scratch) read by word (rt.bytes_word, rt.mem_load); memory
// intrinsics replace them later (decision 0195 prerequisite 2).
//
// Only the Linux arms of std/native/llrt/sysio.xo call this module, so it
// is code generated only for Linux targets (core 12.2).
use native/llrt/obj
use native/llrt/raw
use native/rt

// The errno values the callers test (asm-generic, the same on arm64 and
// x86_64).
pub const EINTR: Int = 4
pub const EAGAIN: Int = 11
pub const ENOENT: Int = 2
pub const EEXIST: Int = 17
pub const ENOTDIR: Int = 20
pub const EISDIR: Int = 21
pub const EACCES: Int = 13
pub const EPERM: Int = 1
pub const ENOTEMPTY: Int = 39

/// openat's directory for paths relative to the working directory.
pub const AT_FDCWD: Int = -100

// open flags: the same on arm64 and x86_64 (O_DIRECTORY and O_NOFOLLOW
// differ, and are not used here)
pub const O_RDONLY: Int = 0
pub const O_WRONLY: Int = 1
pub const O_RDWR: Int = 2
pub const O_CREAT: Int = 64
pub const O_EXCL: Int = 128
pub const O_TRUNC: Int = 512
pub const O_APPEND: Int = 1024
pub const O_CLOEXEC: Int = 524288

pub const CLOCK_REALTIME: Int = 0
pub const CLOCK_MONOTONIC: Int = 1

const AT_SYMLINK_NOFOLLOW: Int = 256
const AT_EMPTY_PATH: Int = 4096
const STATX_BASIC_STATS: Int = 2047

/// The system call number of the target's architecture: arm64 (the
/// asm-generic table) or x86_64.
fn nr(arm64: Int, amd64: Int) -> Int {
  match target.arch {
    TargetArch.Arm64 => arm64
    TargetArch.Amd64 => amd64
    TargetArch.Wasm32 => -1
  }
}

/// read(2) into the bytes of buf from off on (at most n of them).
pub fn read(fd: Int, buf: Bytes, off: Int, n: Int) -> Int {
  let r = rt.sys6(nr(63, 0), fd, raw.bytes_addr(buf) + off, raw.io_len(n), 0, 0, 0)
  keep(buf, r)
}

/// write(2) of the bytes lo..hi of b.
pub fn write(fd: Int, b: Bytes, lo: Int, hi: Int) -> Int {
  let r = rt.sys6(nr(64, 1), fd, raw.bytes_addr(b) + lo, raw.io_len(hi - lo), 0, 0, 0)
  keep(b, r)
}

/// write(2) of the n bytes at the address a (std/native/llrt/stdio.xo).
pub fn write_at(fd: Int, a: Int, n: Int) -> Int { rt.sys6(nr(64, 1), fd, a, raw.io_len(n), 0, 0, 0) }

/// Writes all of b (retrying after EINTR and short writes): 0, or the
/// errno.
pub fn write_all(fd: Int, b: Bytes) -> Int {
  var off = 0
  let n = b.len()
  while off < n {
    let w = write(fd, b, off, n)
    if w < 0 {
      if -w == EINTR {
        continue
      }
      return -w
    }
    off += w
  }
  0
}

/// openat(2) of path (relative to the working directory unless absolute):
/// the descriptor, or the negative errno. An empty path is ".", as the C
/// runtime opens it.
pub fn open(path: Str, flags: Int, mode: Int) -> Int {
  let z = cpath(path)
  let r = rt.sys6(nr(56, 257), AT_FDCWD, raw.bytes_addr(z), flags, mode, 0, 0)
  keep(z, r)
}

/// close(2).
pub fn close(fd: Int) -> Int { rt.sys6(nr(57, 3), fd, 0, 0, 0, 0, 0) }

/// The facts of a statx(2): the kind and permission bits (st_mode), the
/// size, and the modification time in Unix nanoseconds.
pub struct Stat {
  pub mode: Int
  pub size: Int
  pub mtime: Int
}

/// Whether st is a directory (S_IFDIR).
pub fn is_dir(st: Stat) -> Bool { (st.mode & 61440) == 16384 }

/// statx(2) of path (following a final symbolic link when follow): the
/// facts and 0, or the errno.
pub fn stat(path: Str, follow: Bool) -> (Stat, Int) {
  let z = cpath(path)
  let flags = if follow { 0 } else { AT_SYMLINK_NOFOLLOW }
  let r = statx(AT_FDCWD, raw.bytes_addr(z), flags)
  keep(z, 0)
  r
}

/// statx(2) of the open descriptor fd.
pub fn fstat(fd: Int) -> (Stat, Int) {
  let empty = b"\0"
  let r = statx(fd, raw.bytes_addr(empty), AT_EMPTY_PATH)
  keep(empty, 0)
  r
}

/// statx into the thread's scratch buffer (struct statx: stx_mode at
/// 28, stx_size at 40, stx_mtime at 112).
fn statx(dirfd: Int, path_addr: Int, flags: Int) -> (Stat, Int) {
  let buf = obj.scratch()
  let r = rt.sys6(nr(291, 332), dirfd, path_addr, flags, STATX_BASIC_STATS, buf, 0)
  if r < 0 {
    return (Stat{mode: 0, size: 0, mtime: 0}, -r)
  }
  let mode = (rt.mem_load(buf, 24, 8) >> 32) & 65535
  let size = rt.mem_load(buf, 40, 8)
  let sec = rt.mem_load(buf, 112, 8)
  let nsec = rt.mem_load(buf, 120, 8) & 4294967295
  (Stat{mode: mode, size: size, mtime: sec * 1000000000 + nsec}, 0)
}

/// clock_gettime(2) of clock id: nanoseconds (Unix time for
/// CLOCK_REALTIME), or the negative errno. Through the vDSO (decision
/// 0206 stage 2), the system call when the process has none.
/// a is the address of 16 bytes of scratch for the timespec.
pub fn clock_ns(id: Int, a: Int) -> Int {
  let r = clock_gettime(id, a)
  if r < 0 {
    return r
  }
  // a timespec of the clock never overflows: wrapping arithmetic, as C's
  rt.mem_load(a, 0, 8).wrapping_mul(1000000000).wrapping_add(rt.mem_load(a, 8, 8))
}

/// clock_gettime(2) of clock id into the timespec at ts: 0, or the
/// negative errno; the vDSO's function when there is one.
pub fn clock_gettime(id: Int, ts: Int) -> Int {
  let f = rt.slot_load[Int](rt.sys_words(), 0, 0)
  if f > 0 {
    return rt.call_c2(f, id, ts)
  }
  if f == 0 && vdso_clock() > 0 {
    return rt.call_c2(vdso_clock(), id, ts)
  }
  rt.sys6(nr(113, 228), id, ts, 0, 0, 0, 0)
}

// ---------------------------------------------------------------------------
// The vDSO (decision 0206 stage 2): the kernel maps a small shared object
// into every process (the auxiliary vector's AT_SYSINFO_EHDR) whose
// clock_gettime reads the clock without entering the kernel.

pub const AT_PHDR: Int = 3
pub const AT_PHNUM: Int = 5
pub const AT_PAGESZ: Int = 6
const AT_SYSINFO_EHDR: Int = 33

/// The address of the vDSO's clock_gettime, or -1 when the process has
/// none: looked up once and kept in word 0 of rt.sys_words (a lookup
/// racing another stores the same address).
pub fn vdso_clock() -> Int {
  let w = rt.sys_words()
  let f = rt.slot_load[Int](w, 0, 0)
  if f != 0 {
    return f
  }
  let name = match target.arch {
    TargetArch.Arm64 => "__kernel_clock_gettime"
    TargetArch.Amd64 | TargetArch.Wasm32 => "__vdso_clock_gettime"
  }
  var g = elf_dynsym(auxval(AT_SYSINFO_EHDR), name)
  if g == 0 {
    g = -1
  }
  rt.slot_store[Int](w, 0, g, 0)
  g
}

/// The address of the defined function named name in the dynamic symbol
/// table of the ELF image mapped at base (the vDSO), or 0: the first
/// PT_LOAD gives the load bias, PT_DYNAMIC the symbol and string tables;
/// the symbol count is DT_HASH's, else (arm64's vDSO has only
/// DT_GNU_HASH) the symbols up to the string table.
fn elf_dynsym(base: Int, name: Str) -> Int {
  if base == 0 {
    return 0
  }
  // Elf64_Ehdr: e_phoff at 32, e_phentsize at 54, e_phnum at 56
  let phoff = rt.mem_load(base, 32, 8)
  let phent = rt.mem_load(base, 54, 2)
  let phnum = rt.mem_load(base, 56, 2)
  var bias = 0
  var loaded = false
  var dyn = 0
  for i in 0..phnum {
    // Elf64_Phdr: p_type at 0, p_offset at 8, p_vaddr at 16
    let ph = base + phoff + i * phent
    let ty = rt.mem_load(ph, 0, 4)
    if ty == 1 && !loaded {
      bias = base + rt.mem_load(ph, 8, 8) - rt.mem_load(ph, 16, 8)
      loaded = true
    } else if ty == 2 {
      dyn = base + rt.mem_load(ph, 8, 8)
    }
  }
  if dyn == 0 || !loaded {
    return 0
  }
  var sym = 0
  var str = 0
  var hash = 0
  var d = dyn
  while true {
    // Elf64_Dyn: d_tag, d_val; DT_HASH 4, DT_STRTAB 5, DT_SYMTAB 6
    let tag = rt.mem_load(d, 0, 8)
    if tag == 0 {
      break
    }
    let val = rt.mem_load(d, 8, 8)
    if tag == 4 {
      hash = bias + val
    } else if tag == 5 {
      str = bias + val
    } else if tag == 6 {
      sym = bias + val
    }
    d += 16
  }
  if sym == 0 || str == 0 {
    return 0
  }
  var n = 0
  if hash != 0 {
    n = rt.mem_load(hash, 4, 4)
  } else if str > sym {
    n = (str - sym) / 24
  }
  let want = raw.data(name)
  let wn = name.len()
  for i in 0..n {
    // Elf64_Sym: st_name at 0, st_info at 4, st_shndx at 6, st_value at
    // 8; 24 bytes; a function (STT_FUNC 2) that is defined
    let s = sym + 24 * i
    let sn = rt.mem_load(s, 0, 4)
    if sn != 0 && rt.mem_load(s, 6, 2) != 0 && (rt.mem_load(s, 4, 1) & 15) == 2 {
      let at = str + sn
      if raw.mem_eq(at, want, wn) && rt.mem_load(at, wn, 1) == 0 {
        return bias + rt.mem_load(s, 8, 8)
      }
    }
  }
  0
}

/// mmap(2): the address, or the negative errno.
pub fn mmap(addr: Int, len: Int, prot: Int, flags: Int, fd: Int, off: Int) -> Int {
  rt.sys6(nr(222, 9), addr, len, prot, flags, fd, off)
}

/// munmap(2).
pub fn munmap(addr: Int, len: Int) -> Int { rt.sys6(nr(215, 11), addr, len, 0, 0, 0, 0) }

/// madvise(2): the advice (MADV_DONTNEED 4 frees the pages of an anonymous
/// mapping; they read as zeros after), 0 or the negative errno.
pub fn madvise(addr: Int, len: Int, advice: Int) -> Int { rt.sys6(nr(233, 28), addr, len, advice, 0, 0, 0) }

/// mprotect(2).
pub fn mprotect(addr: Int, len: Int, prot: Int) -> Int { rt.sys6(nr(226, 10), addr, len, prot, 0, 0, 0) }

/// rt_sigaction(2) with the kernel's structures at the addresses act
/// (0 for none) and old (0 for none): 0, or the negative errno.
pub fn rt_sigaction(sig: Int, act: Int, old: Int) -> Int { rt.sys6(nr(134, 13), sig, act, old, 8, 0, 0) }

/// rt_sigprocmask(2) of the calling thread's 64 bit signal mask.
pub fn rt_sigprocmask(how: Int, set: Int, old: Int) -> Int { rt.sys6(nr(135, 14), how, set, old, 8, 0, 0) }

/// futex(2) on the 32 bit word at addr: op (FUTEX_WAIT 0, FUTEX_WAKE 1,
/// plus FUTEX_PRIVATE_FLAG 128), val, and the address of a timespec or
/// 0.
pub fn futex(addr: Int, op: Int, val: Int, timeout: Int) -> Int {
  rt.sys6(nr(98, 202), addr, op, val, timeout, 0, 0)
}

/// exit_group(2): ends the process with status code.
pub fn exit_group(code: Int) -> Int { rt.sys6(nr(94, 231), code, 0, 0, 0, 0, 0) }

/// getrandom(2) of n bytes (blocking until the pool is ready, as the C
/// runtime's getentropy and getrandom): the bytes and 0, or the errno.
pub fn random(n: Int) -> (Bytes, Int) {
  let buf = raw.bytes_buf(n)
  var off = 0
  while off < n {
    let r = rt.sys6(nr(278, 318), raw.bytes_addr(buf) + off, n - off, 0, 0, 0, 0)
    if r < 0 {
      if -r == EINTR {
        continue
      }
      return (b"", -r)
    }
    off += r
  }
  (buf, 0)
}

/// rt_sigaction(2) of signal sig with handler (an address, 0 SIG_DFL, 1
/// SIG_IGN), flags (SA_RESTORER is added), and the runtime's
/// rt_sigreturn trampoline (rt.sys_restorer): the previous handler, or
/// the negative errno. Stage 1 sets dispositions only; handlers written
/// in Xo need a C ABI entry (decision 0206, stage 2).
pub fn sigaction(sig: Int, handler: Int, flags: Int) -> Int {
  // struct sigaction of the kernel: handler, flags, restorer, mask
  // (SA_RESTORER is 0x04000000)
  let act = words([handler, flags | 67108864, rt.sys_restorer(), 0])
  let old = raw.bytes_buf(32)
  let r = rt.sys6(nr(134, 13), sig, raw.bytes_addr(act), raw.bytes_addr(old), 8, 0, 0)
  keep(act, r)
  if r < 0 {
    return r
  }
  rt.bytes_word(old, 0)
}

/// The bytes of the words ws, the lowest byte first.
fn words(ws: List[Int]) -> Bytes {
  var s = BytesBuilder.with_capacity(8 * ws.len())
  for w in ws {
    var i = 0
    while i < 8 {
      s.write_byte(UInt8((w >> (8 * i)) & 255))
      i += 1
    }
  }
  s.freeze()
}

/// path and a NUL byte, as the kernel takes a path ("." for "").
fn cpath(path: Str) -> Bytes {
  let p = if path.is_empty() { "." } else { path }
  var s = BytesBuilder.with_capacity(p.len() + 1)
  s.write(p.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// r, after b (whose address a system call used) is known alive up to
/// here: reference counting releases a value after its last use.
fn keep(b: Bytes, r: Int) -> Int {
  if b.len() < 0 {
    return -1
  }
  r
}

/// glibc's strerror text of errno e (glibc 2.34; the C runtime's
/// messages on Linux), "Unknown error N" past the table.
pub fn strerror(e: Int) -> Str {
  match e {
    0 => "Success"
    1 => "Operation not permitted"
    2 => "No such file or directory"
    3 => "No such process"
    4 => "Interrupted system call"
    5 => "Input/output error"
    6 => "No such device or address"
    7 => "Argument list too long"
    8 => "Exec format error"
    9 => "Bad file descriptor"
    10 => "No child processes"
    11 => "Resource temporarily unavailable"
    12 => "Cannot allocate memory"
    13 => "Permission denied"
    14 => "Bad address"
    15 => "Block device required"
    16 => "Device or resource busy"
    17 => "File exists"
    18 => "Invalid cross-device link"
    19 => "No such device"
    20 => "Not a directory"
    21 => "Is a directory"
    22 => "Invalid argument"
    23 => "Too many open files in system"
    24 => "Too many open files"
    25 => "Inappropriate ioctl for device"
    26 => "Text file busy"
    27 => "File too large"
    28 => "No space left on device"
    29 => "Illegal seek"
    30 => "Read-only file system"
    31 => "Too many links"
    32 => "Broken pipe"
    33 => "Numerical argument out of domain"
    34 => "Numerical result out of range"
    35 => "Resource deadlock avoided"
    36 => "File name too long"
    37 => "No locks available"
    38 => "Function not implemented"
    39 => "Directory not empty"
    40 => "Too many levels of symbolic links"
    41 => "Unknown error 41"
    42 => "No message of desired type"
    43 => "Identifier removed"
    44 => "Channel number out of range"
    45 => "Level 2 not synchronized"
    46 => "Level 3 halted"
    47 => "Level 3 reset"
    48 => "Link number out of range"
    49 => "Protocol driver not attached"
    50 => "No CSI structure available"
    51 => "Level 2 halted"
    52 => "Invalid exchange"
    53 => "Invalid request descriptor"
    54 => "Exchange full"
    55 => "No anode"
    56 => "Invalid request code"
    57 => "Invalid slot"
    58 => "Unknown error 58"
    59 => "Bad font file format"
    60 => "Device not a stream"
    61 => "No data available"
    62 => "Timer expired"
    63 => "Out of streams resources"
    64 => "Machine is not on the network"
    65 => "Package not installed"
    66 => "Object is remote"
    67 => "Link has been severed"
    68 => "Advertise error"
    69 => "Srmount error"
    70 => "Communication error on send"
    71 => "Protocol error"
    72 => "Multihop attempted"
    73 => "RFS specific error"
    74 => "Bad message"
    75 => "Value too large for defined data type"
    76 => "Name not unique on network"
    77 => "File descriptor in bad state"
    78 => "Remote address changed"
    79 => "Can not access a needed shared library"
    80 => "Accessing a corrupted shared library"
    81 => ".lib section in a.out corrupted"
    82 => "Attempting to link in too many shared libraries"
    83 => "Cannot exec a shared library directly"
    84 => "Invalid or incomplete multibyte or wide character"
    85 => "Interrupted system call should be restarted"
    86 => "Streams pipe error"
    87 => "Too many users"
    88 => "Socket operation on non-socket"
    89 => "Destination address required"
    90 => "Message too long"
    91 => "Protocol wrong type for socket"
    92 => "Protocol not available"
    93 => "Protocol not supported"
    94 => "Socket type not supported"
    95 => "Operation not supported"
    96 => "Protocol family not supported"
    97 => "Address family not supported by protocol"
    98 => "Address already in use"
    99 => "Cannot assign requested address"
    100 => "Network is down"
    101 => "Network is unreachable"
    102 => "Network dropped connection on reset"
    103 => "Software caused connection abort"
    104 => "Connection reset by peer"
    105 => "No buffer space available"
    106 => "Transport endpoint is already connected"
    107 => "Transport endpoint is not connected"
    108 => "Cannot send after transport endpoint shutdown"
    109 => "Too many references: cannot splice"
    110 => "Connection timed out"
    111 => "Connection refused"
    112 => "Host is down"
    113 => "No route to host"
    114 => "Operation already in progress"
    115 => "Operation now in progress"
    116 => "Stale file handle"
    117 => "Structure needs cleaning"
    118 => "Not a XENIX named type file"
    119 => "No XENIX semaphores available"
    120 => "Is a named type file"
    121 => "Remote I/O error"
    122 => "Disk quota exceeded"
    123 => "No medium found"
    124 => "Wrong medium type"
    125 => "Operation canceled"
    126 => "Required key not available"
    127 => "Key has expired"
    128 => "Key has been revoked"
    129 => "Key was rejected by service"
    130 => "Owner died"
    131 => "State not recoverable"
    132 => "Operation not possible due to RF-kill"
    133 => "Memory page has hardware error"
    _ => "Unknown error ${e}"
  }
}

/// The message of errno e as the C runtime records a file error: the
/// strerror text with its first letter lowered.
pub fn err_msg(e: Int) -> Str {
  let s = strerror(e)
  let b = s.bytes()
  if b.len() > 0 && b[0] >= 65 && b[0] <= 90 {
    return raw.byte_str(Int(b[0]) + 32) + raw.str_slice(s, 1, s.len())
  }
  s
}

/// The FsErr tag plus one of errno e (std/rt's mapFsErr): 1 NotFound, 2
/// Exists, 3 NotEmpty, 4 NotDir, 5 IsDir, 6 Permission, 7 Io.
pub fn fs_status(e: Int) -> Int {
  match e {
    2 => 1
    17 => 2
    39 => 3
    20 => 4
    21 => 5
    13 | 1 => 6
    _ => 7
  }
}

// ---------------------------------------------------------------------------
// The calls of std/native/llrt/fsops.xo (work item B16 of
// bench/results/zero-c-audit-refresh-2026-10-13.md): the system calls of
// the C runtime's xo_fs.c, each the *at form relative to the working
// directory. Each returns the kernel's result: >= 0, or a negative errno.

/// flock(2) operations (the same on macOS).
pub const LOCK_SH: Int = 1
pub const LOCK_EX: Int = 2
pub const LOCK_NB: Int = 4
pub const LOCK_UN: Int = 8

/// unlinkat's flag for a directory.
const AT_REMOVEDIR: Int = 512

/// O_DIRECTORY, which differs between arm64 and x86_64.
fn o_directory() -> Int {
  match target.arch {
    TargetArch.Arm64 => 16384
    TargetArch.Amd64 | TargetArch.Wasm32 => 65536
  }
}

/// read(2) of at most n bytes to the address a.
pub fn read_at(fd: Int, a: Int, n: Int) -> Int { rt.sys6(nr(63, 0), fd, a, raw.io_len(n), 0, 0, 0) }

/// sched_getaffinity(2) of the calling thread into the n bytes at a: the
/// mask's bytes written, or -errno.
pub fn sched_getaffinity(a: Int, n: Int) -> Int { rt.sys6(nr(123, 204), 0, n, a, 0, 0, 0) }

/// renameat(2) of a to b (as written: "" is no file, as for the C
/// runtime's rename).
pub fn rename(a: Str, b: Str) -> Int {
  let za = zpath(a)
  let zb = zpath(b)
  let r = rt.sys6(nr(38, 264), AT_FDCWD, raw.bytes_addr(za), AT_FDCWD, raw.bytes_addr(zb), 0, 0)
  keep(za, keep(zb, r))
}

/// unlinkat(2) of path, a directory when dir (rmdir).
pub fn unlink(path: Str, dir: Bool) -> Int {
  let z = cpath(path)
  let r = rt.sys6(nr(35, 263), AT_FDCWD, raw.bytes_addr(z), if dir { AT_REMOVEDIR } else { 0 }, 0, 0, 0)
  keep(z, r)
}

/// mkdirat(2) of path with mode.
pub fn mkdir(path: Str, mode: Int) -> Int {
  let z = cpath(path)
  let r = rt.sys6(nr(34, 258), AT_FDCWD, raw.bytes_addr(z), mode, 0, 0, 0)
  keep(z, r)
}

/// utimensat(2) of path: both times set to sec and nsec.
pub fn utimens(path: Str, sec: Int, nsec: Int) -> Int {
  let z = cpath(path)
  let ts = words([sec, nsec, sec, nsec])
  let r = rt.sys6(nr(88, 280), AT_FDCWD, raw.bytes_addr(z), raw.bytes_addr(ts), 0, 0, 0)
  keep(ts, keep(z, r))
}

/// fchmodat(2) of path (following links) to mode.
pub fn chmod(path: Str, mode: Int) -> Int {
  let z = cpath(path)
  let r = rt.sys6(nr(53, 268), AT_FDCWD, raw.bytes_addr(z), mode, 0, 0, 0)
  keep(z, r)
}

/// symlinkat(2): a link at path to target (both as written).
pub fn symlink(target: Str, path: Str) -> Int {
  let zt = zpath(target)
  let zp = zpath(path)
  let r = rt.sys6(nr(36, 266), raw.bytes_addr(zt), AT_FDCWD, raw.bytes_addr(zp), 0, 0, 0)
  keep(zt, keep(zp, r))
}

/// readlinkat(2) of path (as written), at most 4096 bytes: the target
/// and 0, or the errno.
pub fn readlink(path: Str) -> (Str, Int) {
  let z = zpath(path)
  let buf = raw.bytes_buf(4096)
  let r = rt.sys6(nr(78, 267), AT_FDCWD, raw.bytes_addr(z), raw.bytes_addr(buf), 4096, 0, 0)
  if keep(z, r) < 0 {
    return ("", -r)
  }
  let t = raw.str_at(raw.bytes_addr(buf), r)
  keep(buf, 0)
  (t, 0)
}

/// getcwd(2): the working directory, "." when the system has none to
/// give (as the C runtime's).
// The calls of a process start (std/native/llrt/proc.xo, work item B25):
// the child between fork and execve makes only these, over addresses
// prepared before the fork, so it neither allocates nor locks. UNTESTED
// on Linux (the zero-C push, 2026-10-14).

/// clone(2) as fork (SIGCHLD only): the child's pid in the parent, 0 in
/// the child, or the negative errno.
pub fn fork() -> Int { rt.sys6(nr(220, 56), 17, 0, 0, 0, 0, 0) }

/// nanosleep(2) for the timespec at ts (a child between fork and execve
/// may call it: no allocation): 0, or the negative errno.
pub fn nanosleep_at(ts: Int) -> Int { rt.sys6(nr(101, 35), ts, 0, 0, 0, 0, 0) }

/// pipe2(2) into the two 4 byte words at a: 0, or the negative errno.
pub fn pipe2(a: Int, flags: Int) -> Int { rt.sys6(nr(59, 293), a, flags, 0, 0, 0, 0) }

/// dup3(2): newfd, or the negative errno.
pub fn dup3(fd: Int, newfd: Int, flags: Int) -> Int { rt.sys6(nr(24, 292), fd, newfd, flags, 0, 0, 0) }

/// fcntl(2) F_SETFD of fd: 0, or the negative errno.
pub fn set_fd_flags(fd: Int, flags: Int) -> Int { rt.sys6(nr(25, 72), fd, 2, flags, 0, 0, 0) }

/// chdir(2) of the zero terminated path at a: 0, or the negative errno.
pub fn chdir_at(a: Int) -> Int { rt.sys6(nr(49, 80), a, 0, 0, 0, 0, 0) }

/// openat(2) of the zero terminated path at a: the descriptor, or the
/// negative errno.
pub fn open_at(a: Int, flags: Int) -> Int { rt.sys6(nr(56, 257), AT_FDCWD, a, flags, 0, 0, 0) }

/// faccessat(2) of the zero terminated path at a: 0, or the negative
/// errno.
pub fn access_at(a: Int, mode: Int) -> Int { rt.sys6(nr(48, 269), AT_FDCWD, a, mode, 0, 0, 0) }

/// wait4(2) of pid, blocking (options 0) or WNOHANG (1), the status
/// word not kept: the pid, 0, or the negative errno.
pub fn wait4(pid: Int, options: Int) -> Int { rt.sys6(nr(260, 61), pid, 0, options, 0, 0, 0) }

/// wait4(2) of pid with its status in the 4 byte word at st, blocking
/// (options 0) or WNOHANG (1): the pid, 0, or the negative errno.
pub fn wait4_at(pid: Int, st: Int, options: Int) -> Int { rt.sys6(nr(260, 61), pid, st, options, 0, 0, 0) }

/// execve(2): returns only on failure, the negative errno.
pub fn execve(file: Int, argv: Int, envp: Int) -> Int { rt.sys6(nr(221, 59), file, argv, envp, 0, 0, 0) }

/// kill(2) of signal sig to pid: 0, or the negative errno.
pub fn kill(pid: Int, sig: Int) -> Int { rt.sys6(nr(129, 62), pid, sig, 0, 0, 0, 0) }

/// getpid(2) (std/native/llrt/crash.xo).
pub fn getpid() -> Int { rt.sys6(nr(172, 39), 0, 0, 0, 0, 0, 0) }

/// sigaltstack(2) with the stack_t at ss (and old, or 0): 0, or the
/// negative errno (std/native/llrt/crash.xo, decision 0343).
pub fn sigaltstack(ss: Int, old: Int) -> Int { rt.sys6(nr(132, 131), ss, old, 0, 0, 0, 0) }

/// setitimer(2): which (ITIMER_REAL 0), the struct itimerval at new and
/// old (or 0): 0, or the negative errno.
pub fn setitimer(which: Int, new: Int, old: Int) -> Int { rt.sys6(nr(103, 38), which, new, old, 0, 0, 0) }

pub fn getcwd() -> Str {
  let buf = raw.bytes_buf(4096)
  let a = raw.bytes_addr(buf)
  let r = rt.sys6(nr(17, 79), a, 4096, 0, 0, 0, 0)
  if r <= 1 || rt.mem_load(a, 0, 1) != 47 {
    keep(buf, 0)
    return "."
  }
  // the length counts the zero byte
  let w = raw.str_at(a, r - 1)
  keep(buf, 0)
  w
}

/// flock(2) of fd with op.
pub fn flock(fd: Int, op: Int) -> Int { rt.sys6(nr(32, 73), fd, op, 0, 0, 0, 0) }

/// The entries of the directory path (not `.` and `..`, in the order
/// getdents64(2) gives) and 0, or the errno of its open or of a failed
/// read (os.File.ReadDir: EINTR retried, any other error reported, not
/// a list cut short).
pub fn names(path: Str) -> (List[Str], Int) {
  var fd = open(path, O_RDONLY | O_CLOEXEC | o_directory(), 0)
  while fd == -EINTR {
    fd = open(path, O_RDONLY | O_CLOEXEC | o_directory(), 0)
  }
  if fd < 0 {
    return ([], -fd)
  }
  var out: List[Str] = []
  let buf = raw.bytes_buf(16384)
  let a = raw.bytes_addr(buf)
  while true {
    let n = rt.sys6(nr(61, 217), fd, a, 16384, 0, 0, 0)
    if n == -EINTR {
      continue
    }
    if n < 0 {
      keep(buf, 0)
      close(fd)
      return ([], -n)
    }
    if n == 0 {
      break
    }
    // struct linux_dirent64: d_reclen at 16, d_name (zero terminated)
    // at 19
    var off = 0
    while off < n {
      let name = a + off + 19
      let k = raw.cstr_len(name)
      if !dots(name, k) {
        out.push(raw.str_at(name, k))
      }
      off += rt.mem_load(a + off, 16, 2)
    }
  }
  keep(buf, 0)
  close(fd)
  (out, 0)
}

/// Whether the k bytes at the address name are `.` or `..`.
pub fn dots(name: Int, k: Int) -> Bool {
  if k == 1 {
    return rt.mem_load(name, 0, 1) == 46
  }
  k == 2 && rt.mem_load(name, 0, 2) == 11822
}

/// path and a NUL byte as written ("" stays empty).
fn zpath(path: Str) -> Bytes {
  var s = BytesBuilder.with_capacity(path.len() + 1)
  s.write(path.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// rt.static_word: the auxiliary vector's address (auxv_init), or 0.
const W_AUXV = 12

/// Keeps the address of the auxiliary vector, which follows the
/// environment's NULL ended array on the process's initial stack (envp:
/// the array the C start or _start gave main). auxval reads it there:
/// /proc may be missing (a chroot, a sandbox), and under valgrind its
/// /proc/self/auxv came back from an offset another open had left, so
/// the unwinder found no AT_PHDR and a fault escaped its isolate
/// (gotchas/linux-auxv-proc.md).
pub fn auxv_init(envp: Int) {
  if target.os != TargetOs.Linux || envp == 0 {
    return
  }
  var p = envp
  while rt.mem_load(p, 0, 8) != 0 {
    p = p.wrapping_add(8)
  }
  rt.mem_store(rt.static_word(W_AUXV), 0, p.wrapping_add(8), 8)
}

/// getauxval(k): the value of entry k of the auxiliary vector, or 0 (off
/// Linux too): read where auxv_init found it, else from /proc/self/auxv
/// (no C library call: the C library's getauxval is not reachable from
/// Xo, and with XO_NOLIBC there is none). Was xo_sys.c xo_auxval.
pub fn auxval(k: Int) -> Int {
  if target.os != TargetOs.Linux {
    return 0
  }
  var a = rt.mem_load(rt.static_word(W_AUXV), 0, 8)
  if a != 0 {
    while true {
      let t = rt.mem_load(a, 0, 8)
      if t == 0 || t == k {
        return if t == k { rt.mem_load(a, 8, 8) } else { 0 }
      }
      a = a.wrapping_add(16)
    }
  }
  auxval_proc(k)
}

/// Whether auxv_init kept the auxiliary vector's address.
pub fn auxv_kept() -> Bool { rt.mem_load(rt.static_word(W_AUXV), 0, 8) != 0 }

/// auxval's fallback: entry k read from /proc/self/auxv, or 0.
pub fn auxval_proc(k: Int) -> Int {
  if target.os != TargetOs.Linux {
    return 0
  }
  let path = b"/proc/self/auxv\0"
  // openat(AT_FDCWD, path, O_RDONLY | O_CLOEXEC)
  let fd = rt.sys6(nr(56, 257), -100, raw.bytes_addr(path), 524288, 0, 0, 0)
  keep(path, 0)
  if fd < 0 {
    return 0
  }
  // the entries, 16 bytes each, read 256 bytes at a time into the
  // thread's scratch
  let b = obj.scratch()
  var v = 0
  var done = false
  while !done {
    let r = rt.sys6(nr(63, 0), fd, b, 256, 0, 0, 0)
    if r == -4 {
      continue
    }
    if r < 16 {
      break
    }
    var i = 0
    while i + 16 <= r {
      let t = rt.mem_load(b, i, 8)
      if t == 0 || t == k {
        if t == k {
          v = rt.mem_load(b, i + 8, 8)
        }
        done = true
        break
      }
      i += 16
    }
  }
  let _c = rt.sys6(nr(57, 3), fd, 0, 0, 0, 0, 0)
  v
}
