// The program's start and end, in Xo (the zero-C audit's work item B26,
// part 2; this was xo_rt.c's main, fault_init, win_init,
// xo_signals_init, xo_rt_stats, and on_overflow): main is cabi_c.xo's,
// the C symbol main (decision 0234), which calls init and then main
// here; Windows' stack overflow handler is on_overflow below. The signal
// and console handlers are poll.xo's (on_signal, on_console), installed
// through rt.fn_addr (decision 0233).
//
// The entry's one C function, Windows' on_overflow, is a word of
// stop.xo's services record (rt.static_word 61); the rest are cabi.xo
// exports through rt.fn_addr (decision 0233 step 2). Nothing here allocates
// from the program's heap (the leak check counts every block): scratch
// memory is rt.heap_large's, from malloc.
use native/llrt/atexit
use native/llrt/ctx
use native/llrt/fault
use native/llrt/heapos
use native/llrt/linux
use native/llrt/obj
use native/llrt/poll
use native/llrt/pool
use native/llrt/poolsetup
use native/llrt/process
use native/llrt/prof
use native/llrt/raw
use native/llrt/stdio
use native/llrt/stop
use native/llrt/trace
use native/llrt/tracerec
use native/rt
use native/sys_darwin
use native/sys_windows

/// Windows' EXCEPTION_STACK_OVERFLOW (0xC00000FD), the code on_overflow
/// reports.
const EXC_STACK_OVERFLOW = 3221225725

/// GetStdHandle's STD_ERROR_HANDLE (-12), and GetCurrentProcess's
/// pseudo handle (-1).
const STD_ERROR = -12
const THIS_PROCESS = -1

/// rt.static_word: on_overflow's WriteFile count (a word no other code
/// reads; obj.scratch could take the heap's lock on a blown stack).
const W_OVERFLOW_COUNT = 61

/// xo_rt.c XO_MID_MAX: the largest block the size classes serve.
const MID_MAX = 262144

/// XO_NCLASS (64 + 8 classes) and XO_CHUNK (4 MiB).
const NCLASS = 72
const CHUNK_MB = 4

/// Signals: SIGINT, SIGTERM, SIGPIPE; SIG_IGN; SA_RESTART on Linux and
/// macOS.
const SIGINT = 2
const SIGTERM = 15
/// `xo dump` (decision 0251)
const SIGQUIT = 3
const SIGPIPE = 13
const SIG_IGN = 1
const SA_RESTART_LINUX = 268435456
const SA_RESTART_DARWIN = 2

/// Windows: CP_UTF8, and the stack a thread keeps for its overflow
/// handler (SetThreadStackGuarantee): on_overflow's own frames take 208
/// bytes (measured on arm64 2026-10-16: 160 with flush_try inlined, then
/// stdio.write_all's 48), the rest is WriteFile's and the system's
/// exception dispatch, as for the C handler it replaces; 64 KiB keeps the
/// C handler's margin.
const CP_UTF8 = 65001
const W_GUARANTEE = 65536

const ACQUIRE = 1


/// The runtime's setup before any other Xo runs (cabi_c.xo main; was
/// xo_rt.c's main and fault_init): the main thread's heap record, fault.xo and ctx.xo (the
/// personality routine's address), the event loop's record before any
/// descriptor, and stop.xo's state.
pub fn init() {
  obj.heap_init(heapos.main_record(), rt.fn_addr("heap_thread"))
  fault.init(rt.fn_addr("fault_raise_msg"))
  ctx.init()
  let _p = poll.poll_svc()
  stop.init()
}

/// The program after init (rank 9 of the zero-C inventory, decisions
/// 0233 and 0234): the process's start, main's thread (n copies when n
/// is above 1, 1 GiB stacks, pool.xo thread_run; main itself on this
/// thread if no thread starts), then the end: standard output flushed,
/// the stop record's end, the statistics, and the leak check's frees and
/// reports. entry is xo_entry's address (the program's main). The
/// status.
pub fn main(argc: Int, argv: Int, envp: Int, entry: Int, n: Int) -> Int {
  start(argc, argv, envp)
  let f = rt.fn_addr("run_main")
  if n > 1 {
    // N copies of the program at once: every thread has its own heap,
    // literals are shared (and never written)
    let _b = rt.call_c2(rt.fn_addr("heap_threads"), 0, 0)
    if !pool.thread_run(f, entry, MAIN_STACK, n) {
      stdio.eprint("pthread_create failed", true)
      return 1
    }
  } else {
    // main's body on a fiber (decision 0286 step 1), its stack reserved
    // here, where main's thread's was: the thread runs the root's loop
    var ms = 0
    if main_fiber_on() {
      let page = poolsetup.page_size()
      ms = pool.map_main_stack(MAIN_STACK, page)
      if ms != 0 {
        let rec = rt.heap_large(24)
        rt.mem_store(rec, 0, entry, 8)
        rt.mem_store(rec, 8, ms, 8)
        rt.mem_store(rec, 16, MAIN_STACK.wrapping_add(page), 8)
        if !pool.thread_run(rt.fn_addr("run_main_fiber"), rec, MAIN_THREAD_STACK, 1) {
          run_main_fiber(rec)
        }
      }
    }
    if ms == 0 && !pool.thread_run(f, entry, MAIN_STACK, 1) {
      run_main(entry)
    }
  }
  stdio.flush()
  stop.end()
  rt_stats()
  // std/http's streamed responses and client state, and the values the
  // test world keeps, if the program has them (atexit.xo)
  atexit.run_streams()
  atexit.run_tw_end()
  if prof.supported() {
    prof.finish()
  }
  // XO_TRACE's file (decision 0240)
  if tracerec.built() {
    trace.finish()
  }
  // XO_LEAKCHECK's and XO_HEAPSTATS' reports
  finish()
  0
}

/// The size of main's stack.
const MAIN_STACK = 1073741824

/// main's thread's own stack when main runs on a fiber of MAIN_STACK
/// (decision 0286 step 1): only the root's loop and the scheduler run on
/// it, so 8 MiB; 64 MiB beside main's 1 GiB fiber took a program near
/// its address space limit (ulimit -v) over it.
const MAIN_THREAD_STACK = 8388608

/// Whether main's body runs on a fiber (decision 0286 step 1): not with
/// several copies of main (each has its own root, entry.xo main) nor with
/// XO_MAIN_FIBER=0, the kill switch kept for one seed cycle (the lead,
/// 2026-10-20: removed after 0.24.0, two scheduler paths double the test
/// surface).
fn main_fiber_on() -> Bool {
  let e = process.env_real_at("XO_MAIN_FIBER")
  !(e != 0 && raw.byte_at(e, 0) == 48)
}


/// The program's main on its own thread (cabi.xo run_main, the thread's
/// C function; was xo_rt.c run_main): on Windows the stack the thread
/// keeps for its stack overflow handler, main's root context for the
/// second shutdown signal, and this frame as the unwinding's boundary (a
/// fault that unwinds main is reported here with status 70, decision
/// 0085), then xo_entry at entry.
pub fn run_main(entry: Int) {
  match target.os {
    TargetOs.Windows => {
      // past the guard page (ULONG, the size in its first 4 bytes)
      let g = rt.heap_large(8)
      rt.mem_store(g, 0, W_GUARANTEE, 4)
      let _r = sys_windows.SetThreadStackGuarantee(g)
      rt.heap_release(g - 8)
    }
    _ => {}
  }
  let c = ctx.cur()
  stop.set_root(rt.mem_load(c, ctx.C_NODE, 8))
  rt.mem_store(c, ctx.C_BOUNDARY, rt.frame_addr(), 8)
  let _r = rt.call_c2(entry, 0, 0)
}

/// run_main with main's body on a fiber (decision 0286 step 1; cabi.xo
/// run_main_fiber): rec holds the entry, the stack entry.xo main reserved,
/// and its size. The thread runs the root's loop (pool.xo root_main),
/// which runs main and other work; a parked main can move to an idle
/// worker.
pub fn run_main_fiber(rec: Int) {
  match target.os {
    TargetOs.Windows => {
      let g = rt.heap_large(8)
      rt.mem_store(g, 0, W_GUARANTEE, 4)
      let _r = sys_windows.SetThreadStackGuarantee(g)
      rt.heap_release(g - 8)
    }
    _ => {}
  }
  let c = ctx.cur()
  stop.set_root(rt.mem_load(c, ctx.C_NODE, 8))
  let p = ctx.pool()
  poolsetup.ready(p)
  let w = poolsetup.root_worker(p)
  let mf = pool.main_fiber(p, w, rt.mem_load(rec, 0, 8), c, rt.mem_load(rec, 8, 8), rt.mem_load(rec, 16, 8))
  pool.root_main(p, w, mf)
}

/// Main's body on its fiber f (cabi.xo fiber_run_task; decision 0286 step
/// 1): the fault boundary is this frame, on main's stack, then the entry.
pub fn main_on_fiber(f: Int) {
  let c = ctx.cur()
  rt.mem_store(c, ctx.C_BOUNDARY, rt.frame_addr(), 8)
  let _r = rt.call_c2(rt.mem_load(f, pool.F_ENTRY, 8), 0, 0)
}

/// Starts the process (C main, after the heap and the faults' setup,
/// before the program's thread): the arguments (as UTF-8 from the UTF-16
/// command line on Windows, whose argv is in the ANSI code page) and
/// the environment for process.xo, XO_HEAP_MID_MAX, then the test world
/// (XO_TEST: a test binary runs one test) or the signal handlers.
pub fn start(argc: Int, argv: Int, envp: Int) {
  match target.os {
    TargetOs.Windows => win_start(argc, argv, envp)
    _ => process.start(argc, argv, envp)
  }
  // no report reads the allocation counts: the heaps stop keeping them
  // (alloc.xo COUNT; a budget turns them on again)
  if process.env_real_at("XO_LEAKCHECK") == 0 && process.env_real_at("XO_HEAPSTATS") == 0 && process.env_real_at("XO_RTSTATS") == 0 {
    heapos.counting_off()
  }
  let mid = process.env_real_at("XO_HEAP_MID_MAX")
  if mid != 0 {
    let m = atoll(mid)
    if m >= 1024 && m < MID_MAX {
      heapos.set_mid_max(m)
    }
  }
  // XO_PROF (decision 0238): nothing when unset; a release build without
  // --profile-support has no profiler, and says so when XO_PROF is set
  if prof.supported() {
    prof.start()
  } else {
    prof.unsupported_note()
  }
  // XO_TRACE (decision 0240): nothing when unset
  if tracerec.built() {
    trace.start()
  }
  fault.init_traceback(rt.fn_addr("fault_traceback"))
  if process.env_real_at("XO_TEST") != 0 {
    // a test binary's main starts the test world itself (the native
    // prelude's llrt_tw_start)
    ignore_sigpipe()
  } else {
    signals()
  }
}

/// C's atoll: optional blanks and sign, then decimal digits (wrapping,
/// as the C's did not check).
fn atoll(a: Int) -> Int {
  var i = 0
  while true {
    let c = rt.mem_load(a, i, 1)
    if c != 32 && (c < 9 || c > 13) {
      break
    }
    i += 1
  }
  var neg = false
  let s = rt.mem_load(a, i, 1)
  if s == 45 || s == 43 {
    neg = s == 45
    i += 1
  }
  var v = 0
  while true {
    let c = rt.mem_load(a, i, 1)
    if c < 48 || c > 57 {
      break
    }
    v = v.wrapping_mul(10).wrapping_add(c - 48)
    i += 1
  }
  if neg { (0).wrapping_sub(v) } else { v }
}

/// Installs the handlers (not in a test binary): SIGINT and SIGTERM
/// count a signal and wake the poller, which the C's ev_start starts
/// first; SIGQUIT likewise, and the poller writes the task tree (`xo
/// dump`, decision 0251); SIGPIPE is ignored (a write to a closed socket returns EPIPE).
/// On Windows Ctrl-C, Ctrl-Break, and closing the console are SIGINT
/// and SIGTERM, and a stack overflow ends the program with "fatal error:
/// stack overflow" and status 2 (decision 0197, stage 5).
fn signals() {
  let _e = rt.call_c2(rt.fn_addr("poll_ev_start"), 0, 0)
  // SIGINT and SIGTERM's handler (poll.xo on_signal); Windows' console
  // handler (poll.xo on_console)
  let h = match target.os {
    TargetOs.Windows => rt.fn_addr("on_console")
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi => rt.fn_addr("on_signal")
  }
  match target.os {
    TargetOs.Linux => {
      let _i = linux.sigaction(SIGINT, h, SA_RESTART_LINUX)
      let _t = linux.sigaction(SIGTERM, h, SA_RESTART_LINUX)
      let _q = linux.sigaction(SIGQUIT, rt.fn_addr("on_quit"), SA_RESTART_LINUX)
      let _p = linux.sigaction(SIGPIPE, SIG_IGN, 0)
    }
    TargetOs.Darwin => {
      // struct sigaction: the handler, the mask (4 bytes), the flags
      let sa = rt.heap_large(16)
      darwin_sig(sa, SIGINT, h, SA_RESTART_DARWIN)
      darwin_sig(sa, SIGTERM, h, SA_RESTART_DARWIN)
      darwin_sig(sa, SIGQUIT, rt.fn_addr("on_quit"), SA_RESTART_DARWIN)
      darwin_sig(sa, SIGPIPE, SIG_IGN, 0)
      release(sa)
    }
    TargetOs.Windows => {
      // UNTESTED on windows
      let _c = sys_windows.SetConsoleCtrlHandler(h, 1)
      let _v = sys_windows.AddVectoredExceptionHandler(1, rt.fn_addr("on_overflow"))
      let g = rt.heap_large(8)
      rt.mem_store(g, 0, W_GUARANTEE, 4)
      let _g = sys_windows.SetThreadStackGuarantee(g)
      release(g)
    }
    TargetOs.Wasi => {}
  }
}

/// Ignores SIGPIPE in a test binary, whose other signals are the test
/// world's (FakeProc.signal_after).
fn ignore_sigpipe() {
  match target.os {
    TargetOs.Linux => {
      let _p = linux.sigaction(SIGPIPE, SIG_IGN, 0)
    }
    TargetOs.Darwin => {
      let sa = rt.heap_large(16)
      darwin_sig(sa, SIGPIPE, SIG_IGN, 0)
      release(sa)
    }
    _ => {}
  }
}

fn darwin_sig(sa: Int, sig: Int, h: Int, flags: Int) {
  rt.mem_store(sa, 0, h, 8)
  rt.mem_store(sa, 8, 0, 4)
  rt.mem_store(sa, 12, flags, 4)
  let _r = sys_darwin.sigaction(sig, sa, 0)
}

/// Windows' start: UTF-8 console output and the arguments as UTF-8 from
/// CommandLineToArgvW, in malloc'd strings kept for the program's life
/// (main's argv when that fails). UNTESTED on windows.
fn win_start(argc: Int, argv: Int, envp: Int) {
  let _cp = sys_windows.SetConsoleOutputCP(CP_UTF8)
  let np = rt.heap_large(8)
  rt.mem_store(np, 0, 0, 8)
  let w = sys_windows.CommandLineToArgvW(sys_windows.GetCommandLineW(), np)
  if w == 0 {
    release(np)
    process.start(argc, argv, envp)
    return
  }
  let n = rt.mem_load(np, 0, 4)
  release(np)
  let v = rt.heap_large(8 * (n + 1))
  rt.mem_store(v, 8 * n, 0, 8)
  for i in 0..n {
    let wi = rt.mem_load(w, 8 * i, 8)
    let k = Int(sys_windows.WideCharToMultiByte(CP_UTF8, 0, wi, -1, 0, 0, 0, 0))
    let s = rt.heap_large(if k > 0 { k } else { 1 })
    rt.mem_store(s, 0, 0, 1)
    if k > 0 {
      let _k = sys_windows.WideCharToMultiByte(CP_UTF8, 0, wi, -1, s, k, 0, 0)
    }
    rt.mem_store(v, 8 * i, s, 8)
  }
  let _f = sys_windows.LocalFree(w)
  process.start(n, v, envp)
}

/// Ends the process's report (C main, after the program's thread
/// joined, standard output flushed, the streams and the test world
/// freed): XO_LEAKCHECK's count of the blocks left (after the
/// collection constants and the zones are freed) and XO_HEAPSTATS' free
/// lists and chunks, on standard error.
pub fn finish() {
  if process.env_real_at("XO_LEAKCHECK") != 0 {
    let _c = rt.call_c2(rt.fn_addr("consts_free"), 0, 0)
    // std/time's kept zones, if the program has them (atexit.xo)
    atexit.run_tz()
    let b = rt.heap_large(256)
    heapos.live(b, b + 8)
    let live = rt.mem_load(b, 0, 8)
    let total = rt.mem_load(b, 8, 8)
    var at = put(b, 0, "xo leakcheck: ")
    at = put_int(b, at, live)
    at = put(b, at, " live of ")
    at = put_int(b, at, total)
    at = put(b, at, " allocations\n")
    emit(b, at)
    release(b)
  }
  if process.env_real_at("XO_HEAPSTATS") != 0 {
    heapstats()
  }
}

/// Where the heap's memory went: the blocks on each class's free list at
/// exit (every block ever carved, when nothing is live) and the chunks
/// carved (diagnostics, bench/results/xo1-speed).
fn heapstats() {
  let b = rt.heap_large(256)
  var sum = 0
  for c in 1..NCLASS + 1 {
    let n = heapos.nfree(c)
    let size = if c <= 64 { c * 16 } else { (2048).wrapping_shl(c - 65) }
    if n > 0 {
      var at = put(b, 0, "xo heapstats: class ")
      at = put_int(b, at, c)
      at = put(b, at, " size ")
      at = put_int(b, at, size)
      at = put(b, at, " free blocks ")
      at = put_int(b, at, n)
      at = put(b, at, " bytes ")
      at = put_int(b, at, n * (size + 8))
      at = put(b, at, "\n")
      emit(b, at)
    }
    sum += n * (size + 8)
  }
  let ch = heapos.chunks()
  var at = put(b, 0, "xo heapstats: chunks ")
  at = put_int(b, at, ch)
  at = put(b, at, " (")
  at = put_int(b, at, ch * CHUNK_MB)
  at = put(b, at, " MB), on free lists ")
  at = put_int(b, at, sum.shr_logical(20))
  at = put(b, at, " MB\n")
  emit(b, at)
  release(b)
}

/// The names of the runtime statistics' counters, in the order of
/// xo_rt.c's st, each followed by a blank.
const STAT_NAMES = "spawn steal inject wake idle_sleep spin_round fiber_park fiber_new thread_wait thread_wake lock_slow spin_yield net_read net_write net_again poll_return poll_event poll_wake rt_section rt_defer rt_overflow fiber_live fiber_peak mon_tick mon_wake defer futex_wait futex_wake lock_inject lock_pd lock_pool lock_park lock_http lock_chan lock_mutex lock_task "

/// XO_RTSTATS=1's counts of the scheduler's events (decision 0077), one
/// line on standard error (at exit, and on demand).
pub fn rt_stats() {
  // the C int is -1 (not read yet), 0, or 1
  if rt.slot_load(rt.call_c2(rt.fn_addr("rtstats_switch"), 0, 0), 0, 0) != 1 {
    return
  }
  let st = rt.call_c2(rt.fn_addr("rtstats_counts"), 0, 0)
  let b = rt.heap_large(64)
  let p = raw.data(STAT_NAMES)
  let n = STAT_NAMES.len()
  var at = put(b, 0, "xo rtstats:")
  emit(b, at)
  at = 0
  var k = 0
  for i in 0..n {
    let c = rt.mem_load(p, i, 1)
    if c != 32 {
      if at == 0 {
        rt.mem_store(b, 0, 32, 1)
        at = 1
      }
      rt.mem_store(b, at, c, 1)
      at += 1
      continue
    }
    at = put(b, at, "=")
    at = put_int(b, at, rt.slot_load(st, k, 0))
    emit(b, at)
    at = 0
    k += 1
  }
  at = put(b, 0, "\n")
  emit(b, at)
  release(b)
}

/// Copies s to b at at: the offset after it.
fn put(b: Int, at: Int, s: Str) -> Int {
  let n = s.len()
  let p = raw.data(s)
  for i in 0..n {
    rt.mem_store(b, at + i, rt.mem_load(p, i, 1), 1)
  }
  at + n
}

/// Writes v in decimal to b at at: the offset after it.
fn put_int(b: Int, at: Int, v: Int) -> Int {
  var o = at
  if v < 0 {
    rt.mem_store(b, o, 45, 1)
    o += 1
  }
  // the digits backwards from the value made negative (the most negative
  // Int has no positive), then reversed
  var u = if v > 0 { 0 - v } else { v }
  let s = o
  while true {
    rt.mem_store(b, o, 48 - u % 10, 1)
    o += 1
    u = u / 10
    if u == 0 {
      break
    }
  }
  var l = s
  var r = o - 1
  while l < r {
    let t = rt.mem_load(b, l, 1)
    rt.mem_store(b, l, rt.mem_load(b, r, 1), 1)
    rt.mem_store(b, r, t, 1)
    l += 1
    r -= 1
  }
  o
}

/// Frees the rt.heap_large block b (heap_release takes its prefix's
/// address).
fn release(b: Int) { rt.heap_release(b - 8) }

/// Writes the first n bytes of b to standard error.
fn emit(b: Int, n: Int) { stdio.write_all(2, b, n) }

/// Windows' stack overflow handler (cabi.xo on_overflow, a vectored
/// exception handler registered by signals_init; was xo_rt.c's, decision
/// 0234): a stack overflow is not a fault (decision 0085), so nothing
/// unwinds; the program ends as the Go backend's does, with "fatal
/// error: stack overflow" and status 2, where Windows would end it
/// silently (0xC00000FD). It runs on what is left of the overflowed
/// stack (W_GUARANTEE, which SetThreadStackGuarantee keeps for every
/// thread that runs Xo), so it only flushes standard output (unless a
/// writer holds it), writes, and exits: no allocation and no lock but
/// flush_try's try. e is the EXCEPTION_POINTERS;
/// EXCEPTION_CONTINUE_SEARCH (0) for any other exception.
pub fn on_overflow(e: Int) -> Int {
  // the ExceptionRecord's ExceptionCode, a DWORD at 0
  if rt.mem_load(rt.mem_load(e, 0, 8), 0, 4) != EXC_STACK_OVERFLOW {
    return 0
  }
  stdio.flush_try()
  let m = "fatal error: stack overflow\n"
  let _w = sys_windows.WriteFile(sys_windows.GetStdHandle(STD_ERROR), raw.data(m), m.len(), rt.static_word(W_OVERFLOW_COUNT), 0)
  let _t = sys_windows.TerminateProcess(THIS_PROCESS, 2)
  0
}
