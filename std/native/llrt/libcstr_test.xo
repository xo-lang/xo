// Tests of libcstr.xo's memory functions (decision 0262): `xo test
// --std-module=native/llrt/libcstr`, run by internal/stdtest.

use native/llrt/raw
use native/rt

/// A buffer of n bytes 0, 1, 2, ... (mod 251) and its address.
fn buf(n: Int) -> (Bytes, Int) {
  let b = raw.bytes_buf(n)
  let a = raw.bytes_addr(b)
  for i in 0..n {
    rt.mem_store(a, i, i % 251, 1)
  }
  (b, a)
}

/// The n bytes at a.
fn read(a: Int, n: Int) -> List[Int] {
  var out: List[Int] = []
  for i in 0..n {
    out.push(rt.mem_load(a, i, 1))
  }
  out
}

test "memmove of 0 to 80 bytes, the destination 24 below to 24 above the source" {
  for n in 0..81 {
    for k in -24..25 {
      let (b, a) = buf(200)
      let s = 60
      let d = s + k
      // the expected bytes: s's n bytes, read before any is written
      var want = read(a, 200)
      let src = read(a + s, n)
      for i in 0..n {
        want[d + i] = src[i]
      }
      let r = memmove(a + d, a + s, n)
      expect(r == a + d) == true
      expect(read(a, 200) == want) == true
      raw.alive(b)
    }
  }
}

test "memcpy of 0 to 40 bytes" {
  for n in 0..41 {
    let (b, a) = buf(100)
    var want = read(a, 100)
    for i in 0..n {
      want[50 + i] = i % 251
    }
    let _r = memcpy(a + 50, a, n)
    expect(read(a, 100) == want) == true
    raw.alive(b)
  }
}

test "memcmp of 0 to 200 bytes differing at each byte" {
  // past two 64 byte steps, the 32 byte step and the last 32 bytes
  for n in 0..201 {
    let (b, a) = buf(n + 1)
    let (c, d) = buf(n + 1)
    expect(memcmp(a, d, n)) == 0
    for p in 0..n {
      let x = rt.mem_load(a, p, 1)
      rt.mem_store(d, p, x + 1, 1)
      expect(memcmp(a, d, n)) == -1
      expect(memcmp(d, a, n)) == 1
      // a later difference does not change the order
      if p + 1 < n {
        rt.mem_store(a, p + 1, 255, 1)
        expect(memcmp(a, d, n)) == -1
        rt.mem_store(a, p + 1, (p + 1) % 251, 1)
      }
      rt.mem_store(d, p, x, 1)
    }
    raw.alive(b)
    raw.alive(c)
  }
}

test "mem_ne32 sees a difference at each of the 32 bytes" {
  let (b, a) = buf(64)
  let (c, d) = buf(64)
  expect(rt.mem_ne32(a, d)) == 0
  expect(rt.mem_ne32(a + 3, d + 3)) == 0
  for p in 0..32 {
    let x = rt.mem_load(d, p, 1)
    rt.mem_store(d, p, x ^ 128, 1)
    expect(rt.mem_ne32(a, d) != 0) == true
    expect(rt.mem_ne32(d, a) != 0) == true
    // a range that starts after p is equal
    if p >= 1 {
      expect(rt.mem_ne32(a + p + 1, d + p + 1)) == 0
    }
    rt.mem_store(d, p, x, 1)
  }
  raw.alive(b)
  raw.alive(c)
}
