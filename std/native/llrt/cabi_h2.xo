// The C ABI exports of the HTTP/2 server (decision 0244, decision 0434):
// the entries hconn.xo and hserve.xo call through the table for a
// connection with HTTP/2 (HC_H2), made over TLS (cabi_tls.xo srvtls_h2)
// or over plain TCP with prior knowledge (h2c: srvh2c below). This
// module imports h2srv and not tlssrv, so a program that serves h2c
// only links no TLS server: srvh2c.xo installs these entries, and
// srvtls.xo installs them with the TLS ones. Every top level function
// here is an export, xo_x_<name>; the arguments and results are Ints
// (rt.call_c2 and call_c4).
use native/llrt/h2srv
use native/llrt/hconn
use native/rt

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

fn srvtls_h2_stop(c: Int) { h2srv.conn_stop(c) }

fn srvtls_h2_free(c: Int) { h2srv.conn_free(c) }

fn srvtls_h2_stream_release(s: Int) { h2srv.stream_release(s) }

/// h2srv.emit, the status and whether the response started packed into
/// one argument (status * 2 + started: call_c4 takes four).
fn srvtls_h2_emit(hc: Int, status2: Int, p: Int, n: Int) -> Int { h2srv.emit(hconn.handle(hc), status2 / 2, (status2 & 1) != 0, p, n) }

fn srvtls_h2_respond_at(hc: Int, status: Int, p: Int, n: Int) { h2srv.respond_at(hconn.handle(hc), status, p, n) }

fn srvtls_h2_finish(hc: Int, p: Int, n: Int) -> Int { if h2srv.finish(hconn.handle(hc), p, n) { 1 } else { 0 } }

/// Stores HTTP/2 record c in server connection hc (HC_H2), stopping it
/// when the server is already stopping (under the server's lock, as the
/// server's stop walks the connections).
pub fn h2_attach(hc: Int, c: Int) {
  let s = ld(hc, hconn.HC_SRV)
  if s != 0 {
    hconn.lock(s)
    st(hc, hconn.HC_H2, c)
    if hconn.stopping_at(s) {
      h2srv.conn_stop(c)
    }
    hconn.unlock(s)
  } else {
    st(hc, hconn.HC_H2, c)
  }
}

/// The HTTP/2 setup of plain connection hc whose client sent the
/// HTTP/2 preface (h2c, prior knowledge): the connection's HTTP/2 record.
/// The preface is still unread, h2srv reads it.
fn srvh2c(hc: Int, _u: Int) -> Int {
  hconn.set_idle(hc, false)
  let c = h2srv.conn_open("", hconn.h2cfg_at(hc))
  h2_attach(hc, c)
  c
}
