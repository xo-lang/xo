// Hardware fault reports (decision 0343): a native program on Linux or
// macOS reports SIGSEGV, SIGBUS, SIGILL, SIGFPE and SIGTRAP on standard
// error, then lets the system's default action end it (the same signal,
// status 128+signal, a core file where enabled). install (entry.xo
// start) maps the process's one crash record and sets the handlers
// (SA_SIGINFO, SA_ONSTACK, SA_RESETHAND, SA_NODEFER); thread_init gives
// each runtime thread an alternate signal stack, so a fault on a guard
// page is reported too.
//
// The handler (cabi.xo on_crash) writes in two phases. Phase 1 is async
// signal safe (no allocation, no lock, no C library call but write and
// macOS's system call wrappers): the signal, its code and address, the
// pc, the registers, and the frames' pcs (unwind.xo prof_walk, the
// sampling profiler's walk) from a fixed buffer in the record. Phase 2
// names the frames (prof.xo trace_text: the symbol table and the DWARF
// line tables), which allocates and reads files; a watchdog (ITIMER_REAL,
// XO_CRASH_TIMEOUT seconds, 5 by default) ends a phase 2 that hangs on a
// lock the faulting thread held, and a fault inside it ends the process
// (its signal's handler is the default by then). Either way phase 1's
// lines are already written.
//
// Off with XO_CRASH_REPORT=0, and in sanitizer builds (their runtimes
// report faults themselves). Windows (stage 2) and wasi have none yet.
use native/llrt/linux
use native/llrt/process
use native/llrt/prof
use native/llrt/raw
use native/llrt/sanhook
use native/llrt/stdio
use native/llrt/unwind
use native/rt
use native/sys_darwin

/// rt.static_word: the crash record, 0 when no handler is installed.
const W_CRASH = 83

/// The crash record (mapped once by install): the claim (the reporting
/// thread's tlocal address, 0 when none reports), the program's text
/// [lo, hi), the image's base, the signal reported, the buffer's fill,
/// the frames' count, a struct sigaction and a struct itimerval for the
/// handler's own calls, the frames' pcs, the registers (unwind.xo's
/// layout: DWARF numbers, the pc at unwind.PC_AT), the text buffer, and the
/// unwinder's record.
const R_CLAIM = 0
const R_LO = 8
const R_HI = 16
const R_BASE = 24
const R_SIG = 32
const R_POS = 40
const R_N = 48
const R_TIMEOUT = 56
const R_SA = 64
const R_TV = 128
/// a timespec of 0.1 s (written once by install)
const R_TS = 160
const R_PCS = 192
const DEPTH = 64
const R_REGS = R_PCS + 8 * DEPTH
const R_BUF = R_REGS + 1024
const BUF = 4096
const R_UNW = 8192
const R_SIZE = R_UNW + unwind.PROF_RECORD

/// An alternate signal stack and its guard page below it.
const ALT = 65536
const GUARD = 16384

/// The signals: SIGBUS is 7 on Linux, 10 on macOS.
const SIGILL = 4
const SIGTRAP = 5
const SIGFPE = 8
const SIGSEGV = 11
const SIGALRM = 14
const SIGBUS_LINUX = 7
const SIGBUS_DARWIN = 10

const ACQUIRE = 1
const ACQ_REL = 3

fn ld(p: Int, o: Int) -> Int { rt.mem_load(p, o, 8) }

fn st(p: Int, o: Int, v: Int) { rt.mem_store(p, o, v, 8) }

fn darwin() -> Bool {
  match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
}

fn sigbus() -> Int { if darwin() { SIGBUS_DARWIN } else { SIGBUS_LINUX } }

/// The crash record, or 0.
fn record() -> Int { ld(rt.static_word(W_CRASH), 0) }

/// Anonymous memory of n bytes (zeroed), or 0.
fn map(n: Int) -> Int {
  let m = match target.os {
    TargetOs.Darwin => sys_darwin.mmap(0, n, 3, 2 | 4096, -1, 0)
    TargetOs.Linux => linux.mmap(0, n, 3, 2 | 32, -1, 0)
    TargetOs.Windows | TargetOs.Wasi => 0
  }
  if m == 0 || (m < 0 && m > -4096) {
    return 0
  }
  m
}

/// Sets sig's handler h (0 the default) with flags, through the struct
/// sigaction at the record's R_SA (no allocation: the handler calls it).
fn set(r: Int, sig: Int, h: Int, flags: Int) {
  let sa = r + R_SA
  if darwin() {
    // the handler, the mask (4 bytes), the flags (4)
    st(sa, 0, h)
    rt.mem_store(sa, 8, 0, 4)
    rt.mem_store(sa, 12, flags, 4)
    let _r = sys_darwin.sigaction(sig, sa, 0)
    return
  }
  // the kernel's: the handler, the flags (SA_RESTORER 0x04000000), the
  // restorer, the mask
  st(sa, 0, h)
  st(sa, 8, flags | 67108864)
  st(sa, 16, rt.sys_restorer())
  st(sa, 24, 0)
  let _r = linux.rt_sigaction(sig, sa, 0)
}

/// The handlers' flags: SA_SIGINFO, SA_ONSTACK, SA_RESETHAND and
/// SA_NODEFER (a fault inside the report, or the watchdog's signal, is
/// not held back while the handler runs).
fn flags() -> Int {
  if darwin() {
    64 | 1 | 4 | 16
  } else {
    4 | 134217728 | 2147483648 | 1073741824
  }
}

/// Installs the handlers (entry.xo start, every program and test binary
/// on Linux and macOS), unless XO_CRASH_REPORT=0 or a sanitizer runs.
pub fn install() {
  match target.os {
    TargetOs.Linux | TargetOs.Darwin => {}
    TargetOs.Windows | TargetOs.Wasi => return
  }
  let v = process.env_real_at("XO_CRASH_REPORT")
  if v != 0 && rt.mem_load(v, 0, 1) == 48 && rt.mem_load(v, 1, 1) == 0 {
    return
  }
  if sanhook.sanitized() {
    return
  }
  let r = map(R_SIZE)
  if r == 0 {
    return
  }
  if unwind.prof_init(r + R_UNW) {
    let (lo, hi) = unwind.prof_text(r + R_UNW)
    st(r, R_LO, lo)
    st(r, R_HI, hi)
  }
  st(r, R_BASE, image_base())
  var t = 5
  let tv = process.env_real_at("XO_CRASH_TIMEOUT")
  if tv != 0 {
    let n = atoi(tv)
    if n >= 1 && n <= 3600 {
      t = n
    }
  }
  st(r, R_TIMEOUT, t)
  st(r, R_TS + 8, 100000000)
  st(rt.static_word(W_CRASH), 0, r)
  thread_init()
  let h = rt.fn_addr("on_crash")
  for sig in [SIGSEGV, sigbus(), SIGILL, SIGFPE, SIGTRAP] {
    set(r, sig, h, flags())
  }
}

/// Gives this thread an alternate signal stack (entry.xo, and each
/// runtime thread's start in cabi.xo), when the handlers are installed.
/// The stack stays mapped after the thread ends.
pub fn thread_init() {
  if record() == 0 {
    return
  }
  let m = map(GUARD + ALT)
  if m == 0 {
    return
  }
  // the stack_t, in the guard page before it is closed: Linux ss_sp,
  // ss_flags (4 bytes and 4 of padding), ss_size; macOS ss_sp, ss_size,
  // ss_flags
  st(m, 0, m + GUARD)
  if darwin() {
    st(m, 8, ALT)
    st(m, 16, 0)
    let _s = sys_darwin.sigaltstack(m, 0)
    let _p = sys_darwin.mprotect(m, GUARD, 0)
  } else {
    st(m, 8, 0)
    st(m, 16, ALT)
    let _s = linux.sigaltstack(m, 0)
    let _p = linux.mprotect(m, GUARD, 0)
  }
}

/// The address the image was loaded at (macOS: its Mach-O header; Linux:
/// the executable's load bias), for resolving the report's pcs offline.
fn image_base() -> Int {
  if darwin() {
    return sys_darwin._dyld_get_image_header(0)
  }
  let ph = linux.auxval(linux.AT_PHDR)
  let n = linux.auxval(linux.AT_PHNUM)
  var bias = 0
  for i in 0..n {
    // PT_PHDR (6): the headers' own p_vaddr at 16
    let p = ph + 56 * i
    if rt.mem_load(p, 0, 4) == 6 {
      bias = ph - rt.mem_load(p, 16, 8)
    }
  }
  bias
}

/// The handler (cabi.xo on_crash): sig, its siginfo, the faulting
/// thread's ucontext.
pub fn on_crash(sig: Int, info: Int, uc: Int) {
  let r = record()
  if r == 0 {
    return
  }
  let me = rt.tlocal_addr()
  let prev = if rt.slot_cas[Int](r, R_CLAIM / 8, 0, me, ACQ_REL) { 0 } else { rt.slot_load[Int](r, R_CLAIM / 8, ACQUIRE) }
  if prev == me {
    // a fault inside this thread's report: its handler is the default
    // now, so returning runs the instruction again and ends the process
    rt.mem_store(r, R_POS, 0, 8)
    w_str(r, "(the crash report faulted: ")
    w_str(r, sig_name(sig))
    w_str(r, ")\n")
    flush(r)
    set(r, sig, 0, 0)
    return
  }
  if prev != 0 {
    // another thread reports: it ends the process
    while true {
      sleep(r)
    }
  }
  st(r, R_SIG, sig)
  st(r, R_POS, 0)
  stdio.flush_try()
  phase1(r, sig, info, uc)
  phase2(r)
  // the default action from here (macOS ignores SA_RESETHAND for
  // SIGILL and SIGTRAP: their handler stays)
  set(r, sig, 0, 0)
  // a signal another process sent (si_code SI_USER, SI_QUEUE, SI_TKILL)
  // does not come again on return: send it (its action is the default)
  if user_sent(info) {
    if darwin() {
      let _k = sys_darwin.kill(Int(sys_darwin.getpid()), sig)
    } else {
      let _k = linux.kill(linux.getpid(), sig)
    }
  }
}

/// The watchdog's handler (cabi.xo on_crash_alarm): phase 2 took too
/// long; the reported signal (its action the default) ends the process.
pub fn on_alarm(sig: Int) {
  let r = record()
  if r == 0 {
    return
  }
  let s = "(the traceback timed out)\n"
  stdio.write_all(2, raw.data(s), s.len())
  let c = ld(r, R_SIG)
  if darwin() {
    let _k = sys_darwin.kill(Int(sys_darwin.getpid()), c)
  } else {
    let _k = linux.kill(linux.getpid(), c)
  }
}

/// The first line, the pc, the registers, the frames' pcs.
fn phase1(r: Int, sig: Int, info: Int, uc: Int) {
  let code = s32(rt.mem_load(info, 8, 4))
  w_str(r, "fatal error: ")
  w_str(r, sig_name(sig))
  w_str(r, ": ")
  w_str(r, sig_text(sig))
  w_str(r, " (code ")
  w_dec(r, code)
  w_str(r, ")")
  if sig == SIGSEGV || sig == sigbus() {
    w_str(r, " at address ")
    w_hex(r, ld(info, if darwin() { 24 } else { 16 }))
  }
  w_str(r, "\n")
  let regs = r + R_REGS
  rt.mem_set(regs, 0, unwind.PC_AT + 8)
  if !unwind.crash_regs(uc, regs) {
    flush(r)
    return
  }
  w_str(r, "pc ")
  w_hex(r, ld(regs, unwind.PC_AT))
  w_str(r, " (image base ")
  w_hex(r, ld(r, R_BASE))
  w_str(r, ")\n\nregisters:\n")
  let x64 = match target.arch {
    TargetArch.Amd64 => true
    TargetArch.Arm64 | TargetArch.Wasm32 => false
  }
  let nreg = if x64 { 16 } else { 32 }
  for i in 0..nreg {
    if i % 4 == 0 {
      w_str(r, " ")
    }
    w_str(r, " ")
    let n = if x64 { x64_name(i) } else { arm64_name(i) }
    w_str(r, n)
    for _ in n.len()..4 {
      w_str(r, " ")
    }
    w_hex16(r, ld(regs, 8 * i))
    if i % 4 == 3 || i == nreg - 1 {
      w_str(r, "\n")
    }
  }
  flush(r)
  // the frames (prof_walk starts from the registers again)
  var n = 0
  let lo = ld(r, R_LO)
  if lo != 0 {
    n = unwind.prof_walk(r + R_UNW, uc, r + R_PCS, DEPTH, lo, ld(r, R_HI))
  } else {
    st(r, R_PCS, ld(regs, unwind.PC_AT))
    n = 1
  }
  st(r, R_N, n)
  // the frames' pcs, a run of one pc (a recursion) as `pc (xN)`
  w_str(r, "\nframes:")
  var i = 0
  while i < n {
    let pc = ld(r, R_PCS + 8 * i)
    var k = i + 1
    while k < n && ld(r, R_PCS + 8 * k) == pc {
      k += 1
    }
    w_str(r, " ")
    w_hex(r, pc)
    if k - i > 1 {
      w_str(r, " (x")
      w_dec(r, k - i)
      w_str(r, ")")
    }
    i = k
  }
  w_str(r, "\n\n")
  flush(r)
}

/// The frames named, under the watchdog.
fn phase2(r: Int) {
  let n = ld(r, R_N)
  if n == 0 || ld(r, R_LO) == 0 {
    return
  }
  set(r, SIGALRM, rt.fn_addr("on_crash_alarm"), 0)
  alarm(r, ld(r, R_TIMEOUT))
  var pcs: List[Int] = []
  for i in 0..n {
    // trace_text looks a return address's call up at pc - 1; the
    // faulting pc is the instruction's own
    let pc = ld(r, R_PCS + 8 * i)
    pcs.push(if i == 0 { pc + 1 } else { pc })
  }
  let s = prof.trace_text(pcs)
  stdio.write_all(2, raw.data(s), s.len())
  alarm(r, 0)
}

/// ITIMER_REAL in s seconds (0: off).
fn alarm(r: Int, s: Int) {
  // struct itimerval: it_interval, it_value (each tv_sec, tv_usec; on
  // macOS tv_usec is 4 bytes and 4 of padding)
  let t = r + R_TV
  rt.mem_set(t, 0, 32)
  st(t, 16, s)
  if darwin() {
    let _r = sys_darwin.setitimer(0, t, 0)
  } else {
    let _r = linux.setitimer(0, t, 0)
  }
}

/// A while, for a thread that faulted while another reports.
fn sleep(r: Int) {
  if darwin() {
    let _u = sys_darwin.usleep(100000)
  } else {
    let _n = linux.nanosleep_at(r + R_TS)
  }
}

/// Whether another process sent the signal: si_code SI_USER (0 on Linux,
/// 0x10001 on macOS), SI_QUEUE, or Linux's SI_TKILL (negative codes).
fn user_sent(info: Int) -> Bool {
  let code = s32(rt.mem_load(info, 8, 4))
  if darwin() {
    code == 65537 || code == 65538
  } else {
    code <= 0
  }
}

/// A 32 bit word as a signed number.
fn s32(v: Int) -> Int { if v >= 2147483648 { v - 4294967296 } else { v } }

fn sig_name(sig: Int) -> Str {
  if sig == sigbus() {
    return "SIGBUS"
  }
  match sig {
    4 => "SIGILL"
    5 => "SIGTRAP"
    8 => "SIGFPE"
    11 => "SIGSEGV"
    _ => "signal"
  }
}

fn sig_text(sig: Int) -> Str {
  if sig == sigbus() {
    return "bus error"
  }
  match sig {
    4 => "illegal instruction"
    5 => "trace trap"
    8 => "floating point exception"
    11 => "segmentation violation"
    _ => "fault"
  }
}

/// Register i's name: arm64 x0 to x28, fp, lr, sp.
fn arm64_name(i: Int) -> Str {
  match i {
    0 => "x0"
    1 => "x1"
    2 => "x2"
    3 => "x3"
    4 => "x4"
    5 => "x5"
    6 => "x6"
    7 => "x7"
    8 => "x8"
    9 => "x9"
    10 => "x10"
    11 => "x11"
    12 => "x12"
    13 => "x13"
    14 => "x14"
    15 => "x15"
    16 => "x16"
    17 => "x17"
    18 => "x18"
    19 => "x19"
    20 => "x20"
    21 => "x21"
    22 => "x22"
    23 => "x23"
    24 => "x24"
    25 => "x25"
    26 => "x26"
    27 => "x27"
    28 => "x28"
    29 => "fp"
    30 => "lr"
    _ => "sp"
  }
}

/// x86_64 register i's name, in DWARF order.
fn x64_name(i: Int) -> Str {
  match i {
    0 => "rax"
    1 => "rdx"
    2 => "rcx"
    3 => "rbx"
    4 => "rsi"
    5 => "rdi"
    6 => "rbp"
    7 => "rsp"
    8 => "r8"
    9 => "r9"
    10 => "r10"
    11 => "r11"
    12 => "r12"
    13 => "r13"
    14 => "r14"
    _ => "r15"
  }
}

// The text buffer (the record's R_BUF, BUF bytes): no allocation.

fn flush(r: Int) {
  stdio.write_all(2, r + R_BUF, ld(r, R_POS))
  st(r, R_POS, 0)
}

fn w_byte(r: Int, c: Int) {
  var p = ld(r, R_POS)
  if p >= BUF {
    flush(r)
    p = 0
  }
  rt.mem_store(r + R_BUF, p, c, 1)
  st(r, R_POS, p + 1)
}

fn w_str(r: Int, s: Str) {
  let a = raw.data(s)
  for i in 0..s.len() {
    w_byte(r, rt.mem_load(a, i, 1))
  }
}

fn w_dec(r: Int, v: Int) {
  if v < 0 {
    w_byte(r, 45)
    w_dec(r, 0 - v)
    return
  }
  if v >= 10 {
    w_dec(r, v / 10)
  }
  w_byte(r, 48 + v % 10)
}

fn hex_digit(d: Int) -> Int { if d < 10 { 48 + d } else { 87 + d } }

/// 0x and the digits, no leading zeros.
fn w_hex(r: Int, v: Int) {
  w_str(r, "0x")
  var started = false
  var k = 60
  while k >= 0 {
    let d = (v >> k) & 15
    if d != 0 || started || k == 0 {
      w_byte(r, hex_digit(d))
      started = true
    }
    k -= 4
  }
}

/// 0x and 16 digits.
fn w_hex16(r: Int, v: Int) {
  w_str(r, "0x")
  var k = 60
  while k >= 0 {
    w_byte(r, hex_digit((v >> k) & 15))
    k -= 4
  }
}

/// Decimal digits at the zero terminated text at a (0 for none).
fn atoi(a: Int) -> Int {
  var v = 0
  var i = 0
  while i < 10 {
    let c = rt.mem_load(a, i, 1)
    if c < 48 || c > 57 {
      return v
    }
    v = v * 10 + (c - 48)
    i += 1
  }
  v
}
