// The context record (decision 0229; the zero-C audit's B17, decision
// 0212 stage 3): a running context, the program's main or a task, is the
// C runtime's xo_ctx (std/llrt/xo_rt.c), whose fields both the C and Xo
// read and write at the offsets below. xo_rt.c asserts every one
// (`ctx.xo C_*`); a module that reads a field takes its offset from here
// (fault.xo, pool.xo, and sched.xo still keep copies of theirs, asserted
// the same way). The current context is thread local word 0
// (sched.xo TLS_CUR).
//
// Here: the shields of deferred code (core 3.5, decision 0022) and the
// unwinding flag, which generated code reaches through cabi.xo's exports
// (the arm64 and LLVM emitters call them directly; older xo's code
// through the C xo_shield_* and xo_unwinding forwarders). The budgets
// are budget.xo's, the Mutexes a context holds (C_HELD, XO-F004)
// mutex.xo's. Making a root context for a bare thread stays C (ctx_root:
// the deadlock counter and the park's setup are the scheduler's, B18 to
// B20).
//
// Nothing here allocates on the common path.
use native/llrt/fault
use native/llrt/rtstats
use native/llrt/sanhook
use native/llrt/sysio
use native/llrt/text
use native/rt

/// xo_ctx (320 bytes, 16 aligned; the owner of each field in decision 0229):
/// the innermost cancellation node (a scope body or the task's node).
pub const C_NODE = 0
/// unwinding: the context unwinds (cancellation or a fault; a C int).
pub const C_UNWINDING = 8
/// shield: the depth of deferred code running (a C int).
pub const C_SHIELD = 12
/// park: the context's parking record (pool.xo PK_*, 32 bytes).
pub const C_PARK = 16
/// held, nheld, capheld: the Mutexes the context holds (24 byte entries:
/// the mutex, the location and its length; C ints for the counts).
pub const C_HELD = 48
pub const C_NHELD = 56
pub const C_CAPHELD = 60
/// net_status, net_msg: the outcome of the last network operation.
pub const C_NET_STATUS = 64
pub const C_NET_MSG = 72
/// faulting and the fault record (fault.xo C_*).
pub const C_FAULTING = 80
pub const C_FAULT_MSG = 88
pub const C_FAULT_LOC = 96
pub const C_FAULT_DETAIL = 104
/// boundary: the stack address the unwinding never passes.
pub const C_BOUNDARY = 112
/// fault_exc: the area holding the exception object (32 bytes) at its
/// first 16 byte aligned address (xo_rt.c ctx_exc): 40 bytes, since a
/// context from the Xo heap is 8 aligned.
pub const C_FAULT_EXC = 120
/// The budget (decision 0175): its record (a reference) or 0, the polls
/// left and the quantum, the charged stretch's start, allocation mark,
/// and heap, and the pause depth (a C int).
pub const C_BUD = 160
pub const C_BUD_LEFT = 168
pub const C_BUD_Q = 176
pub const C_BUD_RUN = 184
pub const C_BUD_AMARK = 192
pub const C_BUD_HEAP = 200
pub const C_BUD_PAUSED = 208
/// went: the context's wait list entry (xo_went, 32 bytes: tasks.xo E_*;
/// a context waits on one list at a time, decision 0212 stage 3).
pub const C_WENT = 216
/// cent and fired: the context's channel queue entry (xo_cent, 64 bytes,
/// chan.xo E_*) and the word its waker claims (a context waits on one
/// channel at a time; a select's arms are the select's).
pub const C_CENT = 248
pub const C_FIRED = 312
pub const C_SIZE = 320

/// rt.static_word: the address of the services record (SV_*), made by
/// init.
const SVC = 16
/// rt.static_word: the program's task group (`os.tasks`, a reference to
/// a scope, or 0), tasks.xo's.
const PROG = 17

/// The services record (made by init; was xo_rt.c's svc, decision 0233
/// step 2): the worker pool record (pool.xo's pl) and whether
/// ThreadSanitizer is on (a word); the statistics are rtstats.xo's. The
/// handles' free functions
/// are no longer here: each constructor names its export (rt.fn_addr),
/// so a program without a feature never names that feature's exports.
pub const SV_POOL = 0
pub const SV_TSAN = 24
/// The lock word of the pool's setup (poolsetup.xo ready).
pub const SV_ONCE = 40
/// The fiber cache's record (pool.xo FS_*, made by init; was xo_rt.c
/// fibers), and where a fiber and a worker thread start (the exports xo_x_fiber_main, xo_x_worker_main):
/// poolsetup.xo's setup.
pub const SV_FIBERS = 80
pub const SV_FIBER_MAIN = 88
pub const SV_WORKER_MAIN = 96
/// The HTTP client's idle HTTP/2 connections (hclient.xo PL_*: a lock
/// word, the first, the count).
pub const SV_H2_POOL = 104
/// obj.xo's table of the collection constants (consts.xo; 0 until the
/// first).
pub const SV_CONSTS = 144
/// The table of streamed responses (hserve.xo ST_*: a lock word, the
/// array, the count).
pub const SV_STREAMS = 192
/// The resolver's state (dns.xo lookup, two words).
pub const SV_DNS = 232
/// The address of cabi.xo's stdin_pump_main, standard input's pump
/// thread on Windows (stdin.xo win_open).
pub const SV_STDIN_PUMP = 248
/// The end functions optional features register (atexit.xo, decision
/// 0233): cabi_time.xo's tz_free, cabi_http.xo's streams_free,
/// cabi_tw.xo's tw_end; 0 until registered.
pub const SV_AT_TZ = 264
pub const SV_AT_STREAMS = 272
pub const SV_AT_TW_END = 280
/// The second personality routine fault_raise_msg hands the unwinder
/// (cabi.xo): the C language handler xo_personality on Windows, else
/// xo_x_personality again (xo_rt.c fault_init gives it).
pub const SV_PERS_OLD = 288
const SV_SIZE = 296
/// The fiber cache's record's size (pool.xo FS_*: its lock, list, count,
/// stack size, page size, where a fiber starts).
const FS_SIZE = 48

/// Makes the services record at start (xo_rt.c fault_init, through
/// cabi.xo rt_start), with the second personality routine pers_old and
/// whether ThreadSanitizer is on, and the statistics' record.
pub fn init(pers_old: Int) {
  rtstats.init()
  let svc = rt.heap_large(SV_SIZE)
  rt.mem_set(svc, 0, SV_SIZE)
  rt.mem_store(svc, SV_TSAN, if sanhook.tsan() { 1 } else { 0 }, 8)
  rt.mem_store(svc, SV_PERS_OLD, pers_old, 8)
  let fs = rt.heap_large(FS_SIZE)
  rt.mem_set(fs, 0, FS_SIZE)
  rt.mem_store(svc, SV_FIBERS, fs, 8)
  rt.mem_store(svc, SV_FIBER_MAIN, rt.fn_addr("fiber_main"), 8)
  rt.mem_store(svc, SV_WORKER_MAIN, rt.fn_addr("worker_main"), 8)
  rt.mem_store(svc, SV_STDIN_PUMP, rt.fn_addr("stdin_pump_main"), 8)
  // the worker pool's record (a root waits before the pool starts)
  let p = rt.heap_large(P_SIZE)
  rt.mem_set(p, 0, P_SIZE)
  let d = rt.heap_large(DLK_SIZE)
  rt.mem_set(d, 0, DLK_SIZE)
  rt.mem_store(p, P_DLK, d, 8)
  rt.mem_store(svc, SV_POOL, p, 8)
  rt.mem_store(rt.static_word(SVC), 0, svc, 8)
}

/// The services record.
pub fn svc() -> Int { rt.mem_load(rt.static_word(SVC), 0, 8) }

/// The worker pool's record (pool.xo's pl, made by init).
pub fn pool() -> Int { rt.mem_load(svc(), SV_POOL, 8) }

/// The address of the word holding the program's task group.
pub fn prog_group_word() -> Int { rt.static_word(PROG) }

/// The current context: thread local word 0, or a root context made for
/// a thread that has none yet.
pub fn cur() -> Int {
  let c = rt.tlocal_get(0)
  if c != 0 {
    return c
  }
  root_out(0)
}

/// root, kept out of line: it calls itself on a path never taken, so the
/// inliner (selfhost/arm64/inline.xo: a function on a call cycle is not
/// inlinable) counts it as one instruction in cur, which then stays small
/// enough to inline at every budget tick and lock (the zero-C perf sweep
/// of 2026-10-15: a real call to cur was 17% of ctx budget's samples).
fn root_out(k: Int) -> Int {
  if k < 0 {
    return root_out(0) // not taken: the inliner's cycle
  }
  root()
}

/// The bytes of a cancellation node (xo_rt.c xo_node, asserted there),
/// the pool record's word of the deadlock counts (pool.xo P_DLK), and
/// the counts' word of the roots made.
const N_BYTES = 56
const P_DLK = 120
const DLK_ROOTS = 0

/// The pool record's size (pool.xo P_*: 16 words, then the 4096 worker
/// records' addresses) and its deadlock counts' (three words), made by
/// init from the runtime's malloc and never freed (were xo_rt.c's
/// statics `pool` and `dlk`).
const P_SIZE = 32896
const DLK_SIZE = 24

/// A root context for a thread that runs Xo code outside any task (the
/// program's main thread; was xo_rt.c ctx): a zeroed context and
/// cancellation node from the runtime's malloc (never freed, as the C's
/// calloc), current on this thread from now on, and counted as a root by
/// the deadlock check.
pub fn root() -> Int {
  let c = rt.heap_large(C_SIZE)
  rt.mem_set(c, 0, C_SIZE)
  let n = rt.heap_large(N_BYTES)
  rt.mem_set(n, 0, N_BYTES)
  rt.mem_store(c, C_NODE, n, 8)
  rt.tlocal_set(0, c)
  let _r = rt.slot_add[Int](rt.mem_load(pool(), P_DLK, 8), DLK_ROOTS, 1, 4)
  c
}

/// Starts deferred code (xo_shield_begin): it is shielded from
/// cancellation, and on the unwind path the unwinding flag is clear while
/// it runs. The token shield_end takes: the start time and the flag.
pub fn shield_begin() -> Int {
  let c = cur()
  let tok = rt.int_wrap(3, sysio.mono_ns(), 1) | (rt.mem_load(c, C_UNWINDING, 4) & 1)
  rt.mem_store(c, C_UNWINDING, 0, 4)
  rt.mem_store(c, C_SHIELD, rt.mem_load(c, C_SHIELD, 4) + 1, 4)
  tok
}

/// Ends deferred code started with token tok (xo_shield_end): the flag
/// is set again, and deferred code that ran longer than 5 seconds faults
/// (XO-F005, as the Go backend checks it when the code returns) at the ln
/// bytes at lp.
pub fn shield_end(tok: Int, lp: Int, ln: Int) {
  let c = cur()
  rt.mem_store(c, C_SHIELD, rt.mem_load(c, C_SHIELD, 4) - 1, 4)
  rt.mem_store(c, C_UNWINDING, tok & 1, 4)
  let el = sysio.mono_ns() - tok / 2
  if el > 5000000000 {
    let m = text.append_duration("XO-F005: a shielded defer ran for ", el) + ", longer than 5s"
    fault.raise_str_at(m, lp, ln)
  }
}

/// Ends deferred code started with token tok that faulted
/// (xo_shield_abort, decision 0085): as shield_end, without its time
/// check.
pub fn shield_abort(tok: Int) {
  let c = cur()
  rt.mem_store(c, C_SHIELD, rt.mem_load(c, C_SHIELD, 4) - 1, 4)
  rt.mem_store(c, C_UNWINDING, tok & 1, 4)
}

/// Whether the current context unwinds (xo_unwinding: generated code
/// asks after a cancellation point); 0 on a thread with no context.
pub fn unwinding() -> Int {
  let c = rt.tlocal_get(0)
  if c == 0 {
    return 0
  }
  rt.mem_load(c, C_UNWINDING, 4)
}
