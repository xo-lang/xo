// The TLS and HTTP/2 server's table (decision 0244): http.Server.with_tls
// calls install, which stores in static word 68 a record of the
// addresses of cabi_tls.xo's exports, in hconn.xo's TO_* order. hconn.xo
// and hserve.xo call TLS and HTTP/2 only through it, and only for a
// connection that has TLS (HC_TLS) or HTTP/2 (HC_H2), so a program that
// never calls with_tls builds and links none of that code: this module
// is the only importer of cabi_tls.xo, and nothing reaches it but
// with_tls. The HTTP/2 entries are srvh2c.xo's, which an h2c only
// program installs alone (decision 0434).
use native/llrt/cabi_tls
use native/llrt/hconn
use native/llrt/srvh2c
use native/rt

/// Makes the table, once (two servers racing to make it publish one),
/// and stores the TLS entries and HTTP/2's (the same addresses a later
/// call stores again).
pub fn install() {
  let t = srvh2c.table()
  if !srvh2c.begin_fill(t, hconn.TO_ONCE_TLS) {
    srvh2c.fill(t)
    return
  }
  if target.arch == TargetArch.Wasm32 {
    // the table indexes of the exports (call_indirect, decision 0447
    // R2d), HTTP/2's with them (R2f)
    rt.mem_store(t, 8 * hconn.TO_SRV_FREE, rt.wasi_hook("srvtls_srv_free"), 8)
    rt.mem_store(t, 8 * hconn.TO_CONN, rt.wasi_hook("srvtls_conn"), 8)
    rt.mem_store(t, 8 * hconn.TO_CLOSE_NOTIFY, rt.wasi_hook("srvtls_close_notify"), 8)
    rt.mem_store(t, 8 * hconn.TO_FREE, rt.wasi_hook("srvtls_free"), 8)
    rt.mem_store(t, 8 * hconn.TO_READ, rt.wasi_hook("srvtls_read"), 8)
    rt.mem_store(t, 8 * hconn.TO_WRITE, rt.wasi_hook("srvtls_write"), 8)
    rt.mem_store(t, 8 * hconn.TO_SET_DEADLINE, rt.wasi_hook("srvtls_set_deadline"), 8)
    rt.mem_store(t, 8 * hconn.TO_TIMED_OUT, rt.wasi_hook("srvtls_timed_out"), 8)
    rt.mem_store(t, 8 * hconn.TO_IDLE_EMPTY, rt.wasi_hook("srvtls_idle_empty"), 8)
    rt.mem_store(t, 8 * hconn.TO_NEG, rt.wasi_hook("srvtls_neg"), 8)
    rt.mem_store(t, 8 * hconn.TO_H2, rt.wasi_hook("srvtls_h2"), 8)
    rt.mem_store(t, 8 * hconn.TO_NB_READ, rt.wasi_hook("srvtls_nb_read"), 8)
    srvh2c.fill(t)
    srvh2c.end_fill(t, hconn.TO_ONCE_TLS)
    return
  }
  rt.mem_store(t, 8 * hconn.TO_SRV_FREE, rt.fn_addr("srvtls_srv_free"), 8)
  rt.mem_store(t, 8 * hconn.TO_CONN, rt.fn_addr("srvtls_conn"), 8)
  rt.mem_store(t, 8 * hconn.TO_CLOSE_NOTIFY, rt.fn_addr("srvtls_close_notify"), 8)
  rt.mem_store(t, 8 * hconn.TO_FREE, rt.fn_addr("srvtls_free"), 8)
  rt.mem_store(t, 8 * hconn.TO_READ, rt.fn_addr("srvtls_read"), 8)
  rt.mem_store(t, 8 * hconn.TO_WRITE, rt.fn_addr("srvtls_write"), 8)
  rt.mem_store(t, 8 * hconn.TO_H2, rt.fn_addr("srvtls_h2"), 8)
  rt.mem_store(t, 8 * hconn.TO_SET_DEADLINE, rt.fn_addr("srvtls_set_deadline"), 8)
  rt.mem_store(t, 8 * hconn.TO_TIMED_OUT, rt.fn_addr("srvtls_timed_out"), 8)
  rt.mem_store(t, 8 * hconn.TO_NB_READ, rt.fn_addr("srvtls_nb_read"), 8)
  rt.mem_store(t, 8 * hconn.TO_IDLE_EMPTY, rt.fn_addr("srvtls_idle_empty"), 8)
  rt.mem_store(t, 8 * hconn.TO_NEG, rt.fn_addr("srvtls_neg"), 8)
  srvh2c.fill(t)
  srvh2c.end_fill(t, hconn.TO_ONCE_TLS)
}
