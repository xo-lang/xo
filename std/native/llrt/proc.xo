// The processes of the native runtime, written in Xo (work item B25 of
// bench/results/zero-c-audit-refresh-2026-10-13.md; they were
// std/llrt/xo_proc.c): Proc.kill and the signals a test's FakeProc.kill
// records. Process creation, pipes, and waiting follow in later stages.
use native/llrt/darwin
use native/llrt/linux
use native/llrt/poll
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/sock
use native/llrt/stdio
use native/llrt/sysio
use native/llrt/testworld
use native/llrt/windows
use native/rt
use native/sys_darwin

// FakeProc.kill's record in the program's static words (rt.xo's table):
// its lock, then a vector (the address of its entries from
// rt.heap_large, its length, its capacity) of blocks ("NAME PID": the
// length, then the bytes).
const W_LOCK = 48
const W_VEC = 49
const W_LEN = 50
const W_CAP = 51

const ACQUIRE = 1
const RELEASE = 2

/// The signals of Proc.kill by index (std/native/prelude.xo proc_kill).
const NAMES: List[Str] = ["HUP", "INT", "QUIT", "KILL", "TERM", "USR1", "USR2", "CONT", "STOP"]

/// The signal number of index i on the target (Linux and macOS differ
/// for USR1, USR2, CONT, and STOP).
fn signo(i: Int) -> Int {
  let linux_nums = [1, 2, 3, 9, 15, 10, 12, 18, 19]
  let darwin_nums = [1, 2, 3, 9, 15, 30, 31, 19, 17]
  match target.os {
    TargetOs.Darwin => darwin_nums[i]
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => linux_nums[i]
  }
}

/// Proc.kill: sends signal index sig to pid (proc_kill checked both): the
/// empty list, or the error's message (Go's errno text) in a list of
/// one. A test's FakeProc records "NAME PID" instead.
pub fn kill(pid: Int, sig: Int) -> List[Str] {
  if sig < 0 || sig >= NAMES.len() || pid <= 0 {
    return ["invalid signal or process id"]
  }
  if testworld.fake(testworld.REAL_PROC) {
    record("${NAMES[sig]} ${pid}")
    return []
  }
  let l = sysio.layer()
  if l == 3 {
    // no signals: KILL terminates the process (std/rt's sendSignal)
    if sig != 3 {
      return ["signal ${NAMES[sig]} is not supported on this system"]
    }
    let m = windows.terminate(pid)
    return if m.is_empty() { [] } else { [m] }
  }
  let r = if l == 2 { darwin.kill(pid, signo(sig)) } else { linux.kill(pid, signo(sig)) }
  if r == 0 {
    return []
  }
  [sysio.err_msg(l, -r)]
}

fn lock() {
  let w = rt.static_word(W_LOCK)
  if !rt.slot_cas(w, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(w)
  }
}

fn unlock() {
  let w = rt.static_word(W_LOCK)
  if rt.slot_swap(w, 0, 0, RELEASE) == 2 {
    pool.futex_wake(w)
  }
}

/// Appends s to FakeProc.kill's record.
fn record(s: Str) {
  lock()
  let n = rt.mem_load(rt.static_word(W_LEN), 0, 8)
  if n == rt.mem_load(rt.static_word(W_CAP), 0, 8) {
    let c = if n == 0 { 8 } else { 2 * n }
    let old = rt.mem_load(rt.static_word(W_VEC), 0, 8)
    let v = if old == 0 { rt.heap_large(8 * c) } else { rt.heap_large_resize(old - 8, 8 * c) }
    rt.mem_store(rt.static_word(W_VEC), 0, v, 8)
    rt.mem_store(rt.static_word(W_CAP), 0, c, 8)
  }
  let b = rt.heap_large(s.len() + 8)
  rt.mem_store(b, 0, s.len(), 8)
  rt.mem_copy(b + 8, raw.data(s), s.len())
  rt.mem_store(rt.mem_load(rt.static_word(W_VEC), 0, 8), 8 * n, b, 8)
  rt.mem_store(rt.static_word(W_LEN), 0, n + 1, 8)
  unlock()
}

/// FakeProc.killed: the recorded signals, oldest first.
pub fn killed() -> List[Str] {
  lock()
  let v = rt.mem_load(rt.static_word(W_VEC), 0, 8)
  var out: List[Str] = []
  for i in 0..rt.mem_load(rt.static_word(W_LEN), 0, 8) {
    let b = rt.mem_load(v, 8 * i, 8)
    out.push(raw.str_at(b + 8, rt.mem_load(b, 0, 8)))
  }
  unlock()
  out
}

// ---------------------------------------------------------------------------
// Starting a command (xo_proc.c's pr_start on macOS and Linux; Windows
// keeps the C's CreateProcessW until its stage)

/// The standard stream descriptors of start: the null device, the
/// program's own, and (standard error) a copy of standard output.
const FD_NULL = -1
const FD_INHERIT = -2
const FD_DUP_OUT = -3

/// The zero terminated string at address a.
fn cstr(a: Int) -> Str { raw.str_at(a, raw.cstr_len(a)) }

/// A malloc'd zero terminated copy of s for the C runtime to free (the
/// block rt.heap_large returns starts 8 bytes after malloc's address).
fn c_owned(s: Str) -> Int {
  let a = rt.heap_large(s.len() + 1) - 8
  rt.mem_copy(a, raw.data(s), s.len())
  rt.mem_store(a, s.len(), 0, 1)
  a
}

/// s with its first letter in lower case (Go's errno texts).
fn lower_first(s: Str) -> Str {
  let b = s.bytes()
  if b.len() > 0 && b[0] >= 65 && b[0] <= 90 {
    return rt.str_of_byte(Int(b[0]) + 32) + rt.str_slice(s, 1, s.len())
  }
  s
}

/// stat of path (following links) on layer l: the mode and 0, or the
/// errno.
fn mode_of(l: Int, path: Str) -> (Int, Int) {
  if l == 2 {
    let (st, e) = darwin.stat(path, true)
    return (st.mode, e)
  }
  let (st, e) = linux.stat(path, true)
  (st.mode, e)
}

/// Whether path is executable by this process (access X_OK).
fn executable(l: Int, path: Str) -> Bool {
  let z = path + "\u{0}"
  let r = if l == 2 { Int(sys_darwin.access(raw.data(z), 1)) } else { linux.access_at(raw.data(z), 1) }
  r == 0
}

/// exec.LookPath of a name without a slash: the first executable regular
/// file of that name in PATH, or "".
fn look_path(l: Int, cmd: Str) -> Str {
  let path = process.real_env_get("PATH")
  if path.is_empty() {
    return ""
  }
  for d0 in path[0].split(":") {
    let d = if d0.is_empty() { "." } else { d0 }
    let full = d + "/" + cmd
    let (mode, e) = mode_of(l, full)
    if e == 0 && (mode & 61440) == 32768 && (mode & 73) != 0 && executable(l, full) {
      return full
    }
  }
  ""
}

/// Starts the command named by the C string name (argv and envp the C's
/// NULL ended arrays, envp 0 for the program's environment; dir 0 for
/// the program's) with standard streams inf, outf, errf (descriptors or
/// FD_*): '0' started, '1' not found, '2' failed; the pid and the
/// message (a malloc'd C string, or 0) in the two words at res. A port of
/// xo_proc.c's pr_start for macOS (posix_spawn) and Linux (fork and
/// execve, UNTESTED on Linux).
pub fn start(name: Int, dir: Int, argv: Int, envp0: Int, inf: Int, outf: Int, errf: Int, res: Int) -> Int {
  let l = sysio.layer()
  let nm = cstr(name)
  rt.mem_store(res, 0, 0, 8)
  rt.mem_store(res, 8, 0, 8)
  var file = nm
  if !nm.contains("/") {
    file = look_path(l, nm)
    if file.is_empty() {
      rt.mem_store(res, 8, c_owned(nm), 8)
      return 49
    }
  }
  if dir != 0 {
    // os.StartProcess checks the directory first
    let d = cstr(dir)
    let (_m, e) = mode_of(l, d)
    if e != 0 {
      let enoent = if l == 2 { 2 } else { linux.ENOENT }
      if e == enoent {
        rt.mem_store(res, 8, c_owned(nm), 8)
        return 49
      }
      rt.mem_store(res, 8, c_owned("chdir ${d}: " + lower_first(sysio.err_msg(l, e))), 8)
      return 50
    }
  }
  if outf == FD_INHERIT || errf == FD_INHERIT || errf == FD_DUP_OUT {
    // the program's output so far comes first
    stdio.flush()
  }
  let envp = if envp0 == 0 { process.environ_addr() } else { envp0 }
  let zfile = file + "\u{0}"
  let (pid, e) = if l == 2 { spawn_darwin(raw.data(zfile), dir, argv, envp, inf, outf, errf) } else { spawn_linux(raw.data(zfile), dir, argv, envp, inf, outf, errf) }
  let _k = zfile.len()
  if e == 2 {
    rt.mem_store(res, 8, c_owned(nm), 8)
    return 49
  }
  if e != 0 {
    rt.mem_store(res, 8, c_owned("fork/exec ${file}: " + lower_first(sysio.err_msg(l, e))), 8)
    return 50
  }
  rt.mem_store(res, 0, pid, 8)
  48
}

/// posix_spawn of the zero terminated path at file: the pid and 0, or 0
/// and the errno.
fn spawn_darwin(file: Int, dir: Int, argv: Int, envp: Int, inf: Int, outf: Int, errf: Int) -> (Int, Int) {
  // fa and at (a pointer each), the pid (4 bytes), the two sigsets
  let buf = raw.bytes_buf(64)
  let b = raw.bytes_addr(buf)
  rt.mem_set(b, 0, 64)
  let fa = b
  let at = b + 8
  let pidw = b + 16
  let none = b + 24
  let def = b + 32
  let devnull = "/dev/null\u{0}"
  let _i = sys_darwin.posix_spawn_file_actions_init(fa)
  let fds = [inf, outf, errf]
  for k in 0..3 {
    let fd = fds[k]
    if fd == FD_NULL {
      let _a = sys_darwin.posix_spawn_file_actions_addopen(fa, k, raw.data(devnull), if k == 0 { 0 } else { 1 }, 0)
    } else if fd == FD_INHERIT {
      let _a = sys_darwin.posix_spawn_file_actions_addinherit_np(fa, k)
    } else if fd == FD_DUP_OUT {
      let _a = sys_darwin.posix_spawn_file_actions_adddup2(fa, 1, 2)
    } else {
      let _a = sys_darwin.posix_spawn_file_actions_adddup2(fa, fd, k)
    }
  }
  if dir != 0 {
    let _a = sys_darwin.posix_spawn_file_actions_addchdir_np(fa, dir)
  }
  let _j = sys_darwin.posix_spawnattr_init(at)
  // SIGPIPE 13, SIGINT 2, SIGTERM 15 back to their defaults; no mask
  rt.mem_store(def, 0, (1 << 12) | (1 << 1) | (1 << 14), 4)
  // POSIX_SPAWN_SETSIGDEF 4, SETSIGMASK 8, CLOEXEC_DEFAULT 0x4000
  let _f = sys_darwin.posix_spawnattr_setflags(at, 4 | 8 | 16384)
  let _s = sys_darwin.posix_spawnattr_setsigmask(at, none)
  let _d = sys_darwin.posix_spawnattr_setsigdefault(at, def)
  let e = Int(sys_darwin.posix_spawn(pidw, file, fa, at, argv, envp))
  let _x = sys_darwin.posix_spawn_file_actions_destroy(fa)
  let _y = sys_darwin.posix_spawnattr_destroy(at)
  let pid = rt.mem_load(pidw, 0, 4)
  let _k = buf.len() + devnull.len()
  if e != 0 { (0, e) } else { (pid, 0) }
}

/// fork and execve of the zero terminated path at file, as Go's
/// forkAndExecInChild: the child makes only system calls over addresses
/// prepared here, and reports a failed exec's errno through a close on
/// exec pipe. The pid and 0, or 0 and the errno. UNTESTED on Linux.
fn spawn_linux(file: Int, dir: Int, argv: Int, envp: Int, inf: Int, outf: Int, errf: Int) -> (Int, Int) {
  // the error pipe (two 4 byte words), the zeroed sigaction and sigset
  // (32 bytes at 8), the errno word (at 48), "/dev/null" (at 56)
  let buf = raw.bytes_buf(80)
  let b = raw.bytes_addr(buf)
  rt.mem_set(b, 0, 80)
  let dn = "/dev/null"
  rt.mem_copy(b + 56, raw.data(dn), dn.len())
  if linux.pipe2(b, linux.O_CLOEXEC) < 0 {
    return (0, 24)
  }
  let rd = rt.mem_load(b, 0, 4)
  let wr = rt.mem_load(b, 4, 4)
  let pid = linux.fork()
  if pid == 0 {
    child(file, dir, argv, envp, inf, outf, errf, b, wr)
  }
  let _c = linux.close(wr)
  if pid < 0 {
    let _r = linux.close(rd)
    return (0, -pid)
  }
  // 4 bytes of errno when the exec failed; none (the pipe closed by the
  // exec) when it succeeded
  var got = linux.read_at(rd, b + 48, 4)
  while got == -linux.EINTR {
    got = linux.read_at(rd, b + 48, 4)
  }
  let _r = linux.close(rd)
  let _k = buf.len()
  if got == 4 {
    let e = rt.mem_load(b, 48, 4)
    // reap the child that failed to exec
    let _w = wait_any(pid)
    return (0, e)
  }
  (pid, 0)
}

/// The child of spawn_linux: system calls only, then execve; on failure
/// writes the errno to wr and exits 127. Never returns.
fn child(file: Int, dir: Int, argv: Int, envp: Int, inf: Int, outf: Int, errf: Int, b: Int, wr: Int) {
  // default signal handlers for SIGPIPE, SIGINT, SIGTERM; an empty mask
  let _p = linux.rt_sigaction(13, b + 8, 0)
  let _i = linux.rt_sigaction(2, b + 8, 0)
  let _t = linux.rt_sigaction(15, b + 8, 0)
  let _m = linux.rt_sigprocmask(2, b + 40, 0)
  var e = child_fd(inf, 0, b)
  if e == 0 {
    e = child_fd(outf, 1, b)
  }
  if e == 0 {
    e = child_fd(errf, 2, b)
  }
  if e == 0 && dir != 0 {
    let r = linux.chdir_at(dir)
    if r < 0 {
      e = -r
    }
  }
  if e == 0 {
    e = -linux.execve(file, argv, envp)
  }
  rt.mem_store(b, 48, e, 4)
  let _w = linux.write_at(wr, b + 48, 4)
  let _x = linux.exit_group(127)
}

/// Standard stream k of the child from fd (or FD_*): 0, or the errno.
fn child_fd(fd: Int, k: Int, b: Int) -> Int {
  if fd == FD_INHERIT {
    return 0
  }
  var src = fd
  if fd == FD_NULL {
    src = linux.open_at(b + 56, if k == 0 { linux.O_RDONLY } else { linux.O_WRONLY })
    if src < 0 {
      return -src
    }
  } else if fd == FD_DUP_OUT {
    src = 1
  }
  if src == k {
    // dup3 refuses one descriptor twice: clear its close on exec flag
    let r = linux.set_fd_flags(k, 0)
    return if r < 0 { -r } else { 0 }
  }
  let r = linux.dup3(src, k, 0)
  return if r < 0 { -r } else { 0 }
}

/// waitpid(pid) of a child that failed to exec (wait4, blocking).
fn wait_any(pid: Int) -> Int { linux.wait4(pid, 0) }

// ---------------------------------------------------------------------------
// Proc.run, Cmd.output and run, and pipelines (xo_proc.c's xo_proc_run
// and xo_proc_exec, stage 4 of B25) on macOS and Linux: the commands
// start through start, their output and error streams are read through
// pipes that wait on the event loop's poller, the standard input data is
// written to its pipe in the same loop (nonblocking; the C wrote it from
// a thread of its own), and the exit is polled with waitpid in steps
// that a cancellation ends (killing the command). UNTESTED on Linux.

/// A command of a spec (std/native/llrt/procspec.xo's words, xo_proc.c's
/// pr_parse): its name, its directory ("" the program's), its flags (1 an
/// environment set, 2 inherit, 4 merge_stderr), its arguments (the name
/// first), and its environment.
struct Spec {
  name: Str
  dir: Str
  flags: Int
  argv: List[Str]
  env: List[Str]
}

/// Word i of l, "" past its end.
fn word(l: List[Str], i: Int) -> Str { if i < l.len() { l[i] } else { "" } }

/// The count in word i of l (decimal digits; anything else ends it, as
/// strtoll; a negative count is 0).
fn count(l: List[Str], i: Int) -> Int {
  var v = 0
  for c in word(l, i).bytes() {
    if c < 48 || c > 57 {
      break
    }
    v = v * 10 + Int(c) - 48
  }
  v
}

/// The commands of spec: name, directory, flags, the arguments' count
/// and the arguments, the environment's count and the variables, the
/// count of variables added (procspec.xo merged them) and those, and the
/// Windows command line.
fn parse(spec: List[Str]) -> List[Spec] {
  var out: List[Spec] = []
  var i = 0
  while i < spec.len() {
    let name = word(spec, i)
    let dir = word(spec, i + 1)
    let flags = count(spec, i + 2)
    let na = count(spec, i + 3)
    i += 4
    var argv = [name]
    for k in 0..na {
      argv.push(word(spec, i + k))
    }
    i += na
    let ne = count(spec, i)
    i += 1
    var env: List[Str] = []
    for k in 0..ne {
      env.push(word(spec, i + k))
    }
    i += ne
    i += count(spec, i) + 1
    i += 1
    out.push(Spec{name: name, dir: dir, flags: flags, argv: argv, env: env})
  }
  out
}

/// A malloc'd block (release it with rt.heap_release) holding the NULL
/// ended array of C strings of ss, then their zero terminated bytes.
fn c_strs(ss: List[Str]) -> Int {
  let head = 8 * (ss.len() + 1)
  var size = head
  for s in ss {
    size += s.len() + 1
  }
  let m = rt.heap_large(size) - 8
  var p = m + head
  for k in 0..ss.len() {
    let s = ss[k]
    rt.mem_store(m, 8 * k, p, 8)
    rt.mem_copy(p, raw.data(s), s.len())
    rt.mem_store(p, s.len(), 0, 1)
    p += s.len() + 1
  }
  rt.mem_store(m, 8 * ss.len(), 0, 8)
  m
}

/// Starts command c with standard streams inf, outf, errf (descriptors
/// or FD_*): the status ("0" started, "1" not found, "2" failed), the
/// pid, and the failure's message.
fn launch(c: Spec, inf: Int, outf: Int, errf: Int) -> (Str, Int, Str) {
  let nd = c_strs([c.name, c.dir])
  let argv = c_strs(c.argv)
  let envp = if (c.flags & 1) != 0 { c_strs(c.env) } else { 0 }
  let res = rt.heap_large(16)
  let dir = if c.dir.is_empty() { 0 } else { rt.mem_load(nd, 8, 8) }
  let st = start(rt.mem_load(nd, 0, 8), dir, argv, envp, inf, outf, errf, res)
  let pid = rt.mem_load(res, 0, 8)
  let m = rt.mem_load(res, 8, 8)
  var msg = ""
  if m != 0 {
    msg = cstr(m)
    rt.heap_release(m)
  }
  rt.heap_release(res - 8)
  rt.heap_release(nd)
  rt.heap_release(argv)
  if envp != 0 {
    rt.heap_release(envp)
  }
  (rt.str_of_byte(st), pid, msg)
}

/// EAGAIN on layer l.
fn eagain(l: Int) -> Int { if l == 2 { 35 } else { 11 } }

const EINTR = 4

fn close_fd(l: Int, fd: Int) {
  if fd >= 0 {
    let _r = if l == 2 { darwin.close(fd) } else { linux.close(fd) }
  }
}

fn read_fd(l: Int, fd: Int, a: Int, n: Int) -> Int { if l == 2 { darwin.read_at(fd, a, n) } else { linux.read_at(fd, a, n) } }

fn write_fd(l: Int, fd: Int, a: Int, n: Int) -> Int { if l == 2 { darwin.write_at(fd, a, n) } else { linux.write_at(fd, a, n) } }

fn kill9(l: Int, pid: Int) {
  let _r = if l == 2 { darwin.kill(pid, 9) } else { linux.kill(pid, 9) }
}

/// A pipe whose ends close on exec, its end nb (0 or 1; -1 neither)
/// nonblocking: the read end, the write end, and 0, or the errno.
fn pipe(l: Int, nb: Int) -> (Int, Int, Int) {
  let a = rt.heap_large(8)
  let r = if l == 2 { darwin.pipe_at(a) } else { linux.pipe2(a, linux.O_CLOEXEC) }
  let fds = [rt.mem_load(a, 0, 4), rt.mem_load(a, 4, 4)]
  rt.heap_release(a - 8)
  if r < 0 {
    return (-1, -1, -r)
  }
  if l == 2 {
    // F_SETFD FD_CLOEXEC
    let _a = sock.fcntl(fds[0], 2, 1)
    let _b = sock.fcntl(fds[1], 2, 1)
  }
  if nb >= 0 {
    // F_GETFL, F_SETFL with O_NONBLOCK
    let fl = sock.fcntl(fds[nb], 3, 0)
    let _c = sock.fcntl(fds[nb], 4, fl | (if l == 2 { 4 } else { 2048 }))
  }
  (fds[0], fds[1], 0)
}

/// Reads the descriptors fds (nonblocking read ends) until each ends,
/// writing data to feed (a nonblocking write end, closed when written;
/// -1 none) meanwhile: what each gave, and whether the task was canceled
/// first (xo_proc.c pr_collect and pr_feed). Every descriptor is closed.
fn collect(l: Int, fds: List[Int], feed: Int, data: Bytes) -> (List[Str], Bool) {
  let n = fds.len()
  var pds: List[Int] = []
  var open: List[Bool] = []
  for fd in fds {
    pds.push(poll.pd_new(fd, false))
    open.push(true)
  }
  // the bytes read, in pieces, and the stream of each piece
  var pieces: List[Str] = []
  var owner: List[Int] = []
  var left = n
  var fin = feed
  var off = 0
  let b = rt.heap_large(65536)
  var canceled = false
  while left > 0 || fin >= 0 {
    if poll.canceled() {
      canceled = true
      break
    }
    var got = false
    if fin >= 0 {
      if off < data.len() {
        let w = write_fd(l, fin, raw.bytes_addr(data) + off, data.len() - off)
        if w > 0 {
          off += w
          got = true
        } else if w != -EINTR && w != -eagain(l) {
          // the command does not read it (EPIPE): os/exec stops too
          off = data.len()
        }
      }
      if off >= data.len() {
        close_fd(l, fin)
        fin = -1
        got = true
      }
    }
    for i in 0..n {
      if open[i] {
        while true {
          let r = read_fd(l, fds[i], b, 65536)
          if r > 0 {
            pieces.push(raw.str_at(b, r))
            owner.push(i)
            got = true
            continue
          }
          if r == -EINTR {
            continue
          }
          if r != -eagain(l) {
            // the end of the output (or an error)
            open[i] = false
            left -= 1
            got = true
          }
          break
        }
      }
    }
    if got || (left == 0 && fin < 0) {
      continue
    }
    stdio.flush()
    // wait on one, in short steps while another is open too (or input
    // is left to write)
    var w = 0
    while w < n && !open[w] {
      w += 1
    }
    let step = if fin >= 0 { 1000000 } else if left > 1 { 10000000 } else { 0 }
    if w < n && pds[w] != 0 {
      let dl = if step == 0 { 0 } else { sysio.mono_ns() + step }
      if poll.pd_wait(pds[w], false, dl) == poll.CANCELED {
        canceled = true
        break
      }
    } else if poll.sleep_until(sysio.mono_ns() + 1000000) == poll.CANCELED {
      canceled = true
      break
    }
  }
  rt.heap_release(b - 8)
  close_fd(l, fin)
  for i in 0..n {
    if pds[i] != 0 {
      poll.pd_free(pds[i])
    } else {
      close_fd(l, fds[i])
    }
  }
  var outs: List[Str] = []
  for i in 0..n {
    var parts: List[Str] = []
    for k in 0..pieces.len() {
      if owner[k] == i {
        parts.push(pieces[k])
      }
    }
    outs.push(parts.join(""))
  }
  (outs, canceled)
}

/// The exit status of wait status ws: its exit code, or 128 plus the
/// signal that ended it (xo_proc.c pr_code).
fn exit_code(ws: Int) -> Int {
  let sig = ws & 127
  if sig == 0 {
    return (ws >> 8) & 255
  }
  if sig != 127 {
    return 128 + sig
  }
  -1
}

/// Waits for pid, killing it when the task is canceled (or was, killed
/// already): its exit status, and whether the task was canceled
/// (xo_proc.c pr_wait).
fn wait_exit(l: Int, pid: Int, canceled0: Bool) -> (Int, Bool) {
  var canceled = canceled0
  let st = rt.heap_large(8)
  rt.mem_store(st, 0, 0, 8)
  var step = 1000000
  var code = 0
  while true {
    // once canceled (the command killed), a blocking wait
    let opt = if canceled { 0 } else { 1 }
    let r = if l == 2 { darwin.waitpid_at(pid, st, opt) } else { linux.wait4_at(pid, st, opt) }
    if r == pid {
      code = exit_code(rt.mem_load(st, 0, 4))
      break
    }
    if r == -EINTR {
      continue
    }
    if r < 0 {
      break
    }
    if poll.canceled() {
      canceled = true
      kill9(l, pid)
      continue
    }
    stdio.flush()
    if poll.sleep_until(sysio.mono_ns() + step) == poll.CANCELED {
      canceled = true
      kill9(l, pid)
    }
    if step < 50000000 {
      step *= 2
    }
  }
  rt.heap_release(st - 8)
  (code, canceled)
}

/// Proc.run (xo_proc.c xo_proc_run): cmd with args, its standard input
/// the null device, its output and error collected: "0", the status,
/// standard output, standard error; or the failure ("1" not found, with
/// no name: the prelude adds it; "2" and the message; "3" canceled).
pub fn run(cmd: Str, args: List[Str]) -> List[Str] {
  if poll.canceled() {
    return ["3", ""]
  }
  let l = sysio.layer()
  var argv = [cmd]
  for a in args {
    argv.push(a)
  }
  let c = Spec{name: cmd, dir: "", flags: 0, argv: argv, env: []}
  let (o0, o1, eo) = pipe(l, 0)
  if eo != 0 {
    return ["2", sysio.err_msg(l, eo)]
  }
  let (e0, e1, ee) = pipe(l, 0)
  if ee != 0 {
    close_fd(l, o0)
    close_fd(l, o1)
    return ["2", sysio.err_msg(l, ee)]
  }
  let (st, pid, msg) = launch(c, FD_NULL, o1, e1)
  close_fd(l, o1)
  close_fd(l, e1)
  if st != "0" {
    close_fd(l, o0)
    close_fd(l, e0)
    return [st, if st == "1" { "" } else { msg }]
  }
  let (outs, c1) = collect(l, [o0, e0], -1, b"")
  if c1 {
    kill9(l, pid)
  }
  let (code, c2) = wait_exit(l, pid, c1)
  if c2 {
    return ["3", ""]
  }
  ["0", "${code}", outs[0], outs[1]]
}

/// Cmd.output (mode 0: one command, its output collected), Cmd.run (1:
/// one command on the terminal), and Proc.pipeline (2: whose last output
/// and every error stream are collected) of the commands of spec, input
/// the first one's standard input when has_input (xo_proc.c
/// xo_proc_exec): "0", the status (pipefail: the rightmost failure),
/// standard output, standard error; or the failure.
pub fn exec(spec: List[Str], input: Bytes, has_input: Bool, mode: Int) -> List[Str] {
  if poll.canceled() {
    return ["3", ""]
  }
  let cs = parse(spec)
  if cs.is_empty() {
    return ["0", "0", "", ""]
  }
  let l = sysio.layer()
  let n = if mode == 2 { cs.len() } else { 1 }
  var pids: List[Int] = []
  // the read ends to collect, and whose each is (-1 the last output, i
  // the error stream of command i)
  var rd: List[Int] = []
  var rd_of: List[Int] = []
  var feed = -1
  var prev = FD_NULL
  if has_input {
    let (r, w, e) = pipe(l, 1)
    if e == 0 {
      prev = r
      feed = w
    }
  } else if mode == 1 || (mode == 0 && (cs[0].flags & 2) != 0) {
    prev = FD_INHERIT
  }
  var st = "0"
  var msg = ""
  for i in 0..n {
    let merge = (cs[i].flags & 4) != 0
    var o0 = -1
    var o1 = -1
    var e0 = -1
    var e1 = -1
    var ofd = FD_INHERIT
    var efd = if merge { FD_DUP_OUT } else { FD_INHERIT }
    if mode != 1 {
      let (r, w, e) = pipe(l, if i == n - 1 { 0 } else { -1 })
      if e != 0 {
        st = "2"
        msg = sysio.err_msg(l, e)
        close_fd(l, prev)
        prev = FD_NULL
        break
      }
      o0 = r
      o1 = w
      ofd = w
      efd = w
      if !merge {
        let (r2, w2, e2) = pipe(l, 0)
        if e2 == 0 {
          e0 = r2
          e1 = w2
          efd = w2
        }
      }
    }
    let (s, pid, m) = launch(cs[i], prev, ofd, efd)
    st = s
    msg = m
    close_fd(l, prev)
    prev = FD_NULL
    close_fd(l, o1)
    close_fd(l, e1)
    if st != "0" {
      close_fd(l, o0)
      close_fd(l, e0)
      break
    }
    pids.push(pid)
    if e0 >= 0 {
      rd.push(e0)
      rd_of.push(i)
    }
    if o0 >= 0 {
      if i == n - 1 {
        rd.push(o0)
        rd_of.push(-1)
      } else {
        prev = o0
      }
    }
  }
  close_fd(l, prev)
  var fin = -1
  if feed >= 0 {
    if pids.is_empty() {
      close_fd(l, feed)
    } else {
      fin = feed
    }
  }
  if st != "0" {
    // a command did not start: the ones before it are killed
    for p in pids {
      kill9(l, p)
    }
  }
  var canceled = false
  var outs: List[Str] = []
  if !rd.is_empty() || fin >= 0 {
    let (o, c) = collect(l, rd, fin, input)
    outs = o
    canceled = c
  }
  var code = 0
  for p in pids {
    if canceled {
      kill9(l, p)
    }
    let (c, cc) = wait_exit(l, p, canceled)
    canceled = cc
    if c != 0 {
      code = c
    }
  }
  if st != "0" {
    return [st, msg]
  }
  if canceled {
    return ["3", ""]
  }
  var out = ""
  var errs: List[Str] = []
  for i in 0..n {
    for k in 0..rd.len() {
      if rd_of[k] == i {
        errs.push(outs[k])
      }
    }
  }
  for k in 0..rd.len() {
    if rd_of[k] == -1 {
      out = outs[k]
    }
  }
  ["0", "${code}", out, errs.join("")]
}
