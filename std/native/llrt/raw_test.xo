// Tests of raw.xo's address helpers on a Str view (decision 0330): `xo
// test --std-module=native/llrt/raw`, run by internal/stdtest. A view's
// object pointer is the view's first byte, so data and str_byte read the
// view (2026-10-25, from the first duration digit loop work).

use native/rt

test "a view is its own bytes" {
  let v = str_slice("hello world", 6, 11)
  expect(v == "world")
  expect(v.bytes().len() == 5)
  expect(Int(v.bytes()[0]) == 119)
  expect(v.to_upper() == "WORLD")
}

test "data of a view is the view's first byte" {
  let v = str_slice("abcdefghij", 7, 10)
  expect(v == "hij")
  expect(byte_at(data(v), 0) == 104)
  expect(byte_at(data(v), 2) == 106)
}

test "str_byte of a view is the view's byte" {
  let v = str_slice("abcdefghij", 7, 10)
  expect(str_byte(v, 0) == 104)
  expect(str_byte(v, 2) == 106)
  expect(str_byte(v, 3) == -1)
}

test "a view of a view" {
  let v = str_slice("abcdefghij", 7, 10)
  let w = str_slice(v, 1, 3)
  expect(w == "ij")
  expect(byte_at(data(w), 0) == 105)
  expect(str_byte(w, 1) == 106)
}

fn copy_back_bytewise(xs: List[UInt8], dist: Int, length: Int) -> List[UInt8] {
  var out = xs
  let from = out.len() - dist
  var k = 0
  while k < length {
    out.push(out[from + k])
    k += 1
  }
  out
}

test "u8s_copy_back is a byte at a time copy, overlapping or not" {
  for n in 1..12 {
    for dist in 1..n + 1 {
      for length in 0..40 {
        var base: List[UInt8] = []
        for i in 0..n {
          base.push(UInt8(i * 7 + 1))
        }
        let want = copy_back_bytewise(base, dist, length)
        var got = base
        u8s_copy_back(got, dist, length)
        expect(got) == want
        // got was shared with base: base is unchanged
        expect(base.len()) == n
      }
    }
  }
}

test "u8s_copy_back in place and past the capacity" {
  var out = List[UInt8].with_capacity(64)
  out.push(1)
  out.push(2)
  out.push(3)
  u8s_copy_back(out, 3, 10)
  expect(out) == [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1]
  var want = out
  for _ in 0..200 {
    want = copy_back_bytewise(want, 5, 37)
    u8s_copy_back(out, 5, 37)
  }
  expect(out) == want
  expect(out.len()) == 13 + 200 * 37
}

test "str_at makes the Str of an object and a length word" {
  // decision 0402: an owned string, a second reference taken by hand, and
  // the view at offset 2 of 3 bytes made from the object and the word
  let t = str_copy(data("abcdefgh"), 8)
  let a = rt.obj_addr(t)
  rt.mem_store(a, 0, rt.mem_load(a, 0, 8) + 1, 8)
  let v = rt.str_at(a, 3 | (2 << 32))
  expect(v == "cde")
  expect(v.len() == 3)
  expect(t == "abcdefgh")
  // a view: appending copies, the object is unchanged
  let w = v + "!"
  expect(w == "cde!")
  expect(t == "abcdefgh")
}
