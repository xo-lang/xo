// X.509 chain verification (RFC 5280 6, as Go's crypto/x509 Verify: the
// zero-C audit's B31, decision 0202, replacing Mbed TLS's
// x509_crt_verify): chains from the leaf through the intermediates to a
// root, each link a signature check (the parent a CA, KeyUsage allowing
// certificate signing when present), every certificate valid at the
// time, intermediates CAs within their path lengths, DNS name
// constraints over the leaf's names, extended key usages nested through
// the chain, and the leaf's host name. Every input is public.
use native/llrt/tlsname
use native/llrt/x509

// the outcomes (Go's errors: UnknownAuthorityError, CertificateInvalidError's
// reasons, HostnameError, UnhandledCriticalExtension)
pub const OK: Int = 0
pub const UNKNOWN_AUTHORITY: Int = 1
pub const EXPIRED: Int = 2
pub const NOT_AUTHORIZED_TO_SIGN: Int = 3
pub const TOO_MANY_INTERMEDIATES: Int = 4
pub const NAME_CONSTRAINTS: Int = 5
pub const INCOMPATIBLE_USAGE: Int = 6
pub const HOSTNAME: Int = 7
pub const UNHANDLED_CRITICAL: Int = 8
pub const CHECK_LIMIT: Int = 9

// Go's limit on signature checks in one verification
const MAX_CHECKS: Int = 100

// the kinds of certificate in a chain (Go's certType)
const LEAF: Int = 0
const INTERMEDIATE: Int = 1
const ROOT: Int = 2

/// The outcome of a verification: the code, a chain (leaf first) when OK,
/// for EXPIRED the certificate that is not valid, and for
/// UNKNOWN_AUTHORITY Go's hint (" (possibly because of ...)" or "").
pub struct Outcome {
  pub code: Int
  pub chain: List[x509.Cert]
  pub bad: x509.Cert
  pub hint: Str
}

/// Go's text of an outcome's error for the certificate checks that
/// x509verify.xo makes (the host name's and the expiry's are the
/// caller's: they need the host and the zone).
pub fn error_text(r: Outcome) -> Str {
  match r.code {
    1 => "x509: certificate signed by unknown authority${r.hint}"
    3 => "x509: certificate is not authorized to sign other certificates"
    4 => "x509: too many intermediates for path length constraint"
    5 => "x509: a root or intermediate certificate is not authorized for this name"
    6 => "x509: certificate specifies an incompatible key usage"
    8 => "x509: unhandled critical extension"
    9 => "x509: signature check attempts limit reached while verifying certificate chain"
    _ => "x509: verification failed"
  }
}

/// The search's state: chains found, signature checks made.
struct Search {
  chains: List[List[x509.Cert]]
  checks: Int
}

/// A level's error (Go's err of buildChains): the code (-1 none), the
/// certificate it is about, the unknown authority's hint.
struct LevelErr {
  code: Int
  bad: x509.Cert
  hint: Str
}

/// Go's Verify (Go 1.26) of leaf with the intermediates and roots at the
/// time now (Unix seconds): host the name to check ("" none), usage the
/// extended key usage OID wanted (x509.EKU_SERVER, ...; EKU_ANY accepts
/// any).
pub fn verify(leaf: x509.Cert, inters: List[x509.Cert], roots: List[x509.Cert], host: Str, now: Int, usage: Str) -> Outcome {
  if leaf.unhandled > 0 {
    return Outcome{code: UNHANDLED_CRITICAL, chain: [], bad: leaf, hint: ""}
  }
  if now < leaf.not_before || now > leaf.not_after {
    return Outcome{code: EXPIRED, chain: [], bad: leaf, hint: ""}
  }
  if host != "" && !host_ok(leaf, host) {
    return Outcome{code: HOSTNAME, chain: [], bad: leaf, hint: ""}
  }
  var s = Search{chains: [], checks: 0}
  var in_roots = false
  for r in roots {
    if r.raw == leaf.raw {
      in_roots = true
    }
  }
  if in_roots {
    s.chains.push([leaf])
  } else {
    let err = build(s, [leaf], dedup(inters), dedup(roots), now)
    if err.code != OK {
      return Outcome{code: err.code, chain: [], bad: err.bad, hint: err.hint}
    }
  }
  // Go drops the chains with incompatible usages, then the ones breaking
  // a name constraint; a constraint error wins over the usage one
  var names_bad = false
  for ch in s.chains {
    if !usage_ok(ch, usage) {
      continue
    }
    if !constraints_ok(ch) {
      names_bad = true
    } else {
      return Outcome{code: OK, chain: ch, bad: leaf, hint: ""}
    }
  }
  let code = if names_bad { NAME_CONSTRAINTS } else { INCOMPATIBLE_USAGE }
  Outcome{code: code, chain: [], bad: leaf, hint: ""}
}

/// A pool's certificates once each (CertPool.AddCert skips one it has).
fn dedup(xs: List[x509.Cert]) -> List[x509.Cert] {
  var out: List[x509.Cert] = []
  for x in xs {
    var have = false
    for y in out {
      if y.raw == x.raw {
        have = true
      }
    }
    if !have {
      out.push(x)
    }
  }
  out
}

/// CertPool.findPotentialParents: the pool's certificates whose subject
/// is c's issuer, the key identifiers matching first (both empty
/// included), then those where one is missing, then the rest.
fn parents(c: x509.Cert, pool: List[x509.Cert]) -> List[x509.Cert] {
  var a: List[x509.Cert] = []
  var b: List[x509.Cert] = []
  var d: List[x509.Cert] = []
  for p in pool {
    if p.subject != c.issuer {
      continue
    }
    if p.ski == c.aki {
      a.push(p)
    } else if (p.ski.is_empty() && !c.aki.is_empty()) || (!p.ski.is_empty() && c.aki.is_empty()) {
      b.push(p)
    } else {
      d.push(p)
    }
  }
  for x in b {
    a.push(x)
  }
  for x in d {
    a.push(x)
  }
  a
}

/// Go's alreadyInChain: a certificate of the chain with the candidate's
/// subject, key and subject alternative names.
fn in_chain(c: x509.Cert, chain: List[x509.Cert]) -> Bool {
  for x in chain {
    if x.subject == c.subject && x.spki == c.spki && x.has_san == c.has_san && (!c.has_san || x.san_raw == c.san_raw) {
      return true
    }
  }
  false
}

/// The name Go's hint gives a certificate: its common name, else its
/// first organization, else "serial:" and the serial number.
fn hint_name(c: x509.Cert) -> Str {
  if c.cn != "" {
    return c.cn
  }
  if c.org != "" {
    return c.org
  }
  "serial:${decimal(c.serial)}"
}

/// The decimal text of a big endian magnitude.
fn decimal(b: Bytes) -> Str {
  var ds: List[Int] = []
  for x in b {
    var carry = Int(x)
    for i in 0..ds.len() {
      let v = ds[i] * 256 + carry
      ds[i] = v % 10
      carry = v / 10
    }
    while carry > 0 {
      ds.push(carry % 10)
      carry = carry / 10
    }
  }
  if ds.is_empty() {
    return "0"
  }
  var s = ""
  var i = ds.len() - 1
  while i >= 0 {
    s = "${s}${ds[i]}"
    i -= 1
  }
  s
}

/// x509.Certificate.VerifyHostname for the leaf.
pub fn host_ok(c: x509.Cert, host: Str) -> Bool { tlsname.host_ok(names(c), host) }

/// The leaf's names as tlsname.xo takes them (IPs as 16 bytes, IPv4
/// mapped).
pub fn names(c: x509.Cert) -> tlsname.Names {
  var ips: List[List[Int]] = []
  for ip in c.ips {
    var a: List[Int] = []
    if ip.len() == 4 {
      for _ in 0..10 {
        a.push(0)
      }
      a.push(255)
      a.push(255)
    }
    for x in ip {
      a.push(Int(x))
    }
    ips.push(a)
  }
  tlsname.Names{dns: c.dns, ips: ips}
}

/// Go's buildChains: every chain from chain's last certificate up through
/// the candidates, roots first, into s.chains. The error is Go's: none
/// when a chain was found, else the last one a candidate gave (its
/// isValid's, its own search's, the check limit), else an unknown
/// authority with the hint of the first candidate whose signature check
/// failed.
fn build(var s: Search, chain: List[x509.Cert], inters: List[x509.Cert], roots: List[x509.Cert], now: Int) -> LevelErr {
  let cur = chain[chain.len() - 1]
  let before = s.chains.len()
  var err = LevelErr{code: -1, bad: cur, hint: ""}
  var hint = ""
  for kind in [ROOT, INTERMEDIATE] {
    for c in parents(cur, if kind == ROOT { roots } else { inters }) {
      if !c.has_key || in_chain(c, chain) {
        continue
      }
      s.checks += 1
      if s.checks > MAX_CHECKS {
        err = LevelErr{code: CHECK_LIMIT, bad: cur, hint: ""}
        continue
      }
      let why = x509.check_from(cur, c)
      if why != "" {
        if hint == "" {
          hint = " (possibly because of ${why.quote()} while trying to verify candidate authority certificate ${hint_name(c).quote()})"
        }
        continue
      }
      let code = valid(c, kind, chain, now)
      if code != OK {
        err = LevelErr{code: code, bad: c, hint: ""}
        continue
      }
      var next = chain
      next.push(c)
      if kind == ROOT {
        s.chains.push(next)
      } else {
        err = build(s, next, inters, roots, now)
      }
    }
  }
  if s.chains.len() > before {
    return LevelErr{code: OK, bad: cur, hint: ""}
  }
  if err.code < 0 {
    return LevelErr{code: UNKNOWN_AUTHORITY, bad: cur, hint: hint}
  }
  err
}

/// Go's isValid for an intermediate or root c above chain.
fn valid(c: x509.Cert, kind: Int, chain: List[x509.Cert], now: Int) -> Int {
  if c.unhandled > 0 {
    return UNHANDLED_CRITICAL
  }
  if now < c.not_before || now > c.not_after {
    return EXPIRED
  }
  if kind == INTERMEDIATE && (!c.has_bc || !c.is_ca) {
    return NOT_AUTHORIZED_TO_SIGN
  }
  if c.has_bc && c.max_path >= 0 && chain.len() - 1 > c.max_path {
    return TOO_MANY_INTERMEDIATES
  }
  OK
}

/// Go's checkChainConstraints for DNS names: the names of every
/// certificate with a SAN extension within the constraints of every
/// certificate above it; IP, e-mail and URI constraints refuse a chain
/// whose lower certificates have such names (stricter than Go when the
/// names would pass).
fn constraints_ok(chain: List[x509.Cert]) -> Bool {
  for i in 0..chain.len() {
    if chain[i].has_san {
      for j in i + 1..chain.len() {
        let c = chain[j]
        // IP, e-mail and URI constraints are not checked here (Go checks
        // them): over a certificate with such names they refuse the chain
        if c.other_constraints > 0 && (!chain[i].ips.is_empty() || chain[i].san_other > 0) {
          return false
        }
        if !c.permitted_dns.is_empty() || !c.excluded_dns.is_empty() {
          for name in chain[i].dns {
            if !name_permitted(name, c) {
              return false
            }
          }
        }
      }
    }
  }
  true
}

/// Whether the DNS name is outside c's excluded subtrees (a wildcard name
/// also when its parent is one's) and, when c has permitted ones, inside
/// one of them.
fn name_permitted(name: Str, c: x509.Cert) -> Bool {
  for e in c.excluded_dns {
    if e.is_empty() || has_suffix(e, name) {
      return false
    }
    if name.starts_with("*") && trim_first_label(e) != "" && trim_first_label(e) == trim_first_label(name) {
      return false
    }
  }
  if c.permitted_dns.is_empty() {
    return true
  }
  for p in c.permitted_dns {
    if p.is_empty() || has_suffix(p, name) {
      return true
    }
  }
  false
}

/// The name after its first label ("" without a dot).
fn trim_first_label(n: Str) -> Str {
  match n.find(".") {
    Some(i) => n.bytes()[i + 1..n.len()].to_str() ?? ""
    None => ""
  }
}

/// Go's dnsHasSuffix: whether name ends with the constraint, ASCII case
/// folded, at a label boundary (or the constraint starts with a dot).
fn has_suffix(constraint: Str, name: Str) -> Bool {
  let a = constraint.to_lower()
  let b = name.to_lower()
  if a.len() > b.len() || !b.ends_with(a) {
    return false
  }
  if !a.starts_with(".") && b.len() > a.len() && b.bytes()[b.len() - a.len() - 1] != 46 {
    return false
  }
  true
}

/// Go's checkChainForKeyUsage for one wanted usage: every certificate
/// that lists extended key usages lists it, or any (Netscape's and
/// Microsoft's server gated crypto count as server authentication).
fn usage_ok(chain: List[x509.Cert], usage: Str) -> Bool {
  if usage == x509.EKU_ANY || usage == "" {
    return true
  }
  for c in chain {
    if !c.ext_usage.is_empty() {
      var ok = false
      for u in c.ext_usage {
        if u == usage || u == x509.EKU_ANY {
          ok = true
        }
        if usage == x509.EKU_SERVER && (u == "2.16.840.1.113730.4.1" || u == "1.3.6.1.4.1.311.10.3.3") {
          ok = true
        }
      }
      if !ok {
        return false
      }
    }
  }
  true
}

/// internal.crypto_op's chain ops (std/internal.xo): `verify` with a
/// the leaf's DER, b the intermediates' and c the roots' (each a 2 byte
/// big endian length then the DER), d "time host usage" (host "-" for
/// none): the outcome code as decimal text, then the common names of the
/// chain found; none for another what.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  if what != "verify" {
    return None
  }
  let p = x509.parse(a)
  if p.err != "" {
    return Some(b"parse")
  }
  let args = (d.to_str() ?? "").split(" ")
  if args.len() != 3 {
    return Some(b"args")
  }
  let now = Int.parse(args[0]) ?? 0
  let r = verify(p.cert, certs(b), certs(c), if args[1] == "-" { "" } else { args[1] }, now, args[2])
  if r.code == CHECK_LIMIT {
    return Some("error ${error_text(r)}".bytes())
  }
  var s = "${r.code}"
  for x in r.chain {
    s = "${s} ${x.cn}"
  }
  Some(s.bytes())
}

/// The certificates of a list of 2 byte lengths and DERs.
fn certs(b: Bytes) -> List[x509.Cert] {
  var out: List[x509.Cert] = []
  var i = 0
  while i + 2 <= b.len() {
    let n = Int(b[i]) * 256 + Int(b[i + 1])
    let p = x509.parse(b[i + 2..i + 2 + n])
    if p.err == "" {
      out.push(p.cert)
    }
    i += 2 + n
  }
  out
}
