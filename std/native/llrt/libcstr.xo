// The string and memory functions of the C library of an XO_NOLIBC
// build (memcpy, strlen, strtol, qsort, strerror, ...; the zero-C
// audit's B04 stage (b), decision 0230): std/native/llrt/cabi_libc.xo
// exports them under the C names. None may fault or allocate Xo values
// (rt.int_wrap for the arithmetic), and none calls rt.mem_copy,
// rt.mem_set, rt.mem_move, or rt.mem_cmp, which the emitters may lower
// to calls of these very functions. A C `int` argument's register may
// carry anything above its low 32 bits (s32 and the byte masks take
// them off).
//
// Written on macOS: the module is checked by the linux/arm64 XO_NOLIBC
// build's code generation only, UNTESTED on linux.
use native/rt

// strerror's table of C strings (134 words from malloc, an entry made
// by the first strerror of its errno) hangs off libcmem.xo's state
// record (libcmem.S_ERRS, static word 63).

/// The errno values strerror has texts for (0 to NERR - 1).
const NERR = 134

fn addw(a: Int, b: Int) -> Int { a.wrapping_add(b) }

fn subw(a: Int, b: Int) -> Int { a.wrapping_sub(b) }

fn mulw(a: Int, b: Int) -> Int { a.wrapping_mul(b) }

/// a < b as unsigned words (addresses).
fn ult(a: Int, b: Int) -> Bool {
  let m = (1).wrapping_shl(63)
  (a ^ m) < (b ^ m)
}

fn byte(a: Int, i: Int) -> Int { rt.mem_load(a, i, 1) }

/// The C int in the low 32 bits of v, sign extended.
pub fn s32(v: Int) -> Int {
  let w = v & 4294967295
  if w >= 2147483648 {
    return subw(w, 4294967296)
  }
  w
}

// ---------------------------------------------------------------------------
// Memory

// The copies move 32 bytes an iteration, then words: counted loops (k
// blocks down to 0) through pointers at constant offsets, each word
// stored as it is loaded. That is safe for memmove too: copying forward
// with d below s (backward with d above s), a store reaches only bytes
// of s already read. An 8 byte loop tested on `i + 8 <= n` cost about
// four times LLVM's vectorized copy on both native backends, and four
// words held across their stores cost x86-64 a callee saved register
// on every call (bench/results/amd64-vs-llvm-2026-10-17.md).

/// The 8 byte words of n bytes from s to d, forward: the multiple of 32
/// as rt.mem_copy_block (arm64 q registers 64 bytes an iteration, x86_64
/// movups, LLVM the index loop of two words loaded then stored at a time
/// that it vectorizes; each loads 32 bytes before storing them, so
/// memmove forward stays safe), then the rest's words; the bytes copied.
/// The offsets are rt.int_wrap itself, not addw: a helper is inlined
/// after instruction selection, so x86's i + c displacement (calls.xo
/// x86_disp) would not see the add.
fn copy_words(d: Int, s: Int, n: Int) -> Int {
  let n32 = n & -32
  // the vector loop of each emitter (rt.mem_copy_block)
  rt.mem_copy_block(d, s, n32)
  var i = n32
  let n8 = n & -8
  while i < n8 {
    rt.mem_store(d, i, rt.mem_load(s, i, 8), 8)
    i = i.wrapping_add(8)
  }
  n8
}

/// n bytes from s to d for n from 1 to 16, every load before any store
/// (so they may overlap): two words, two halves, or two quarters that
/// overlap in the middle, else a byte (2026-10-19: the byte loops of a
/// short copy were most of json/enc_small's memmove, three times
/// LLVM's on amd64).
pub fn move_small(d: Int, s: Int, n: Int) {
  if n >= 8 {
    let t = subw(n, 8)
    let a = rt.mem_load(s, 0, 8)
    let b = rt.mem_load(s, t, 8)
    rt.mem_store(d, 0, a, 8)
    rt.mem_store(d, t, b, 8)
    return
  }
  if n >= 4 {
    let t = subw(n, 4)
    let a = rt.mem_load(s, 0, 4)
    let b = rt.mem_load(s, t, 4)
    rt.mem_store(d, 0, a, 4)
    rt.mem_store(d, t, b, 4)
    return
  }
  if n >= 2 {
    let t = subw(n, 2)
    let a = rt.mem_load(s, 0, 2)
    let b = rt.mem_load(s, t, 2)
    rt.mem_store(d, 0, a, 2)
    rt.mem_store(d, t, b, 2)
    return
  }
  rt.mem_store(d, 0, byte(s, 0), 1)
}

/// memcpy: n bytes from s to d (not overlapping); d. From 8 bytes on,
/// the tail is one word ending at n (overlapping bytes already copied:
/// s and d do not overlap), so a short copy has no byte loop.
pub fn memcpy(d: Int, s: Int, n: Int) -> Int {
  if n < 8 {
    if n > 0 {
      move_small(d, s, n)
    }
    return d
  }
  let _w = copy_words(d, s, n)
  let t = subw(n, 8)
  rt.mem_store(d, t, rt.mem_load(s, t, 8), 8)
  d
}

/// memmove: n bytes from s to d (they may overlap); d.
pub fn memmove(d: Int, s: Int, n: Int) -> Int {
  if d == s || n <= 0 {
    return d
  }
  if n <= 16 {
    move_small(d, s, n)
    return d
  }
  // forward when d is below s or past its end (unsigned: addresses)
  if ult(d, s) || !ult(subw(d, s), n) {
    var i = copy_words(d, s, n)
    if i < n && !ult(subw(s, d), 8) {
      // the tail as one word ending at n: with s at least 8 bytes past
      // d (or d past s's end) no store so far reached those bytes of s
      let t = subw(n, 8)
      rt.mem_store(d, t, rt.mem_load(s, t, 8), 8)
      return d
    }
    while i < n {
      rt.mem_store(d, i, byte(s, i), 1)
      i = addw(i, 1)
    }
    return d
  }
  // backward: the bytes past the last whole word, then words from the end
  var k = n
  while (k & 7) != 0 {
    k = subw(k, 1)
    rt.mem_store(d, k, byte(s, k), 1)
  }
  var sp = addw(s, k)
  var dp = addw(d, k)
  var b = k.shr_logical(5)
  while b > 0 {
    sp = subw(sp, 32)
    dp = subw(dp, 32)
    rt.mem_store(dp, 24, rt.mem_load(sp, 24, 8), 8)
    rt.mem_store(dp, 16, rt.mem_load(sp, 16, 8), 8)
    rt.mem_store(dp, 8, rt.mem_load(sp, 8, 8), 8)
    rt.mem_store(dp, 0, rt.mem_load(sp, 0, 8), 8)
    b = subw(b, 1)
  }
  var w = (k & 31).shr_logical(3)
  while w > 0 {
    sp = subw(sp, 8)
    dp = subw(dp, 8)
    rt.mem_store(dp, 0, rt.mem_load(sp, 0, 8), 8)
    w = subw(w, 1)
  }
  d
}

/// memset: the n bytes at d set to the low byte of c; d.
pub fn memset(d: Int, c: Int, n: Int) -> Int {
  let b = c & 255
  if n < 8 {
    var j = 0
    while j < n {
      rt.mem_store(d, j, b, 1)
      j = addw(j, 1)
    }
    return d
  }
  let w = mulw(b, 72340172838076673)
  var dp = d
  var k = n.shr_logical(5)
  while k > 0 {
    rt.mem_store(dp, 0, w, 8)
    rt.mem_store(dp, 8, w, 8)
    rt.mem_store(dp, 16, w, 8)
    rt.mem_store(dp, 24, w, 8)
    dp = addw(dp, 32)
    k = subw(k, 1)
  }
  var r = (n & 31).shr_logical(3)
  while r > 0 {
    rt.mem_store(dp, 0, w, 8)
    dp = addw(dp, 8)
    r = subw(r, 1)
  }
  // the tail: one word ending at n
  rt.mem_store(d, subw(n, 8), w, 8)
  d
}

/// memcmp: <0, 0, or >0 as the first differing byte of a is below or
/// above b's.
pub fn memcmp(a: Int, b: Int, n: Int) -> Int {
  var i = 0
  // 64 bytes a step (two 32 byte tests, one branch), then 32, while they
  // are equal; the word steps below find the first that differs
  while addw(i, 64) <= n && (rt.mem_ne32(addw(a, i), addw(b, i)) | rt.mem_ne32(addw(a, addw(i, 32)), addw(b, addw(i, 32)))) == 0 {
    i = addw(i, 64)
  }
  if addw(i, 32) <= n && rt.mem_ne32(addw(a, i), addw(b, i)) == 0 {
    i = addw(i, 32)
  }
  // fewer than 32 left of 32 or more: the 32 bytes ending at n, whose
  // bytes before i are equal, settle an equal pair with one test (with
  // 32 or more left, the 32 byte step above found a difference)
  if i < n && n >= 32 && subw(n, i) < 32 && rt.mem_ne32(addw(a, subw(n, 32)), addw(b, subw(n, 32))) == 0 {
    return 0
  }
  while addw(i, 8) <= n {
    let r = word_cmp(rt.mem_load(a, i, 8), rt.mem_load(b, i, 8))
    if r != 0 {
      return r
    }
    i = addw(i, 8)
  }
  if i < n && n >= 8 {
    // the word ending at n: its bytes before i are equal
    let k = subw(n, 8)
    return word_cmp(rt.mem_load(a, k, 8), rt.mem_load(b, k, 8))
  }
  while i < n {
    let x = byte(a, i)
    let y = byte(b, i)
    if x != y {
      return if x < y { -1 } else { 1 }
    }
    i = addw(i, 1)
  }
  0
}

/// memcmp of two little endian words: the first differing byte is the
/// lowest, at the lowest set bit of x ^ y.
fn word_cmp(x: Int, y: Int) -> Int {
  if x == y {
    return 0
  }
  let k = rt.ctz(x ^ y) & 56
  if (x.shr_logical(k) & 255) < (y.shr_logical(k) & 255) { -1 } else { 1 }
}

// ---------------------------------------------------------------------------
// Strings (zero terminated)

/// strlen.
pub fn strlen(s: Int) -> Int {
  var n = 0
  while byte(s, n) != 0 {
    n = addw(n, 1)
  }
  n
}

/// strchr: the address of the first c (low byte) in s, its terminator
/// when c is 0, or 0.
pub fn strchr(s: Int, c: Int) -> Int {
  let b = c & 255
  var i = 0
  while true {
    let x = byte(s, i)
    if x == b {
      return addw(s, i)
    }
    if x == 0 {
      return 0
    }
    i = addw(i, 1)
  }
  0
}

/// strncmp.
pub fn strncmp(a: Int, b: Int, n: Int) -> Int {
  var i = 0
  while i < n {
    let x = byte(a, i)
    let y = byte(b, i)
    if x != y || x == 0 {
      return subw(x, y)
    }
    i = addw(i, 1)
  }
  0
}

/// strcmp.
pub fn strcmp(a: Int, b: Int) -> Int {
  var i = 0
  while true {
    let x = byte(a, i)
    let y = byte(b, i)
    if x != y || x == 0 {
      return subw(x, y)
    }
    i = addw(i, 1)
  }
  0
}

/// memchr: the address of the first c (low byte) in the n bytes at s,
/// or 0.
pub fn memchr(s: Int, c: Int, n: Int) -> Int {
  let b = c & 255
  var i = 0
  while ult(i, n) {
    if byte(s, i) == b {
      return addw(s, i)
    }
    i = addw(i, 1)
  }
  0
}

/// strrchr: the address of the last c (low byte) in s, its terminator
/// when c is 0, or 0.
pub fn strrchr(s: Int, c: Int) -> Int {
  let b = c & 255
  var last = 0
  var i = 0
  while true {
    let x = byte(s, i)
    if x == b {
      last = addw(s, i)
    }
    if x == 0 {
      return last
    }
    i = addw(i, 1)
  }
  0
}

/// Whether byte x is in the zero terminated set at set.
fn in_set(set: Int, x: Int) -> Bool {
  var j = 0
  while true {
    let y = byte(set, j)
    if y == 0 {
      return false
    }
    if y == x {
      return true
    }
    j = addw(j, 1)
  }
  false
}

/// strspn: the length of s's first run of bytes in set.
pub fn strspn(s: Int, set: Int) -> Int {
  var i = 0
  while true {
    let x = byte(s, i)
    if x == 0 || !in_set(set, x) {
      return i
    }
    i = addw(i, 1)
  }
  0
}

/// strcspn: the length of s's first run of bytes not in set.
pub fn strcspn(s: Int, set: Int) -> Int {
  var i = 0
  while true {
    let x = byte(s, i)
    if x == 0 || in_set(set, x) {
      return i
    }
    i = addw(i, 1)
  }
  0
}

// ---------------------------------------------------------------------------
// strerror: linux.xo strerror's texts (Go's table, first letter
// capitalized), as zero terminated C strings from malloc, made once per
// errno and kept.

// ---------------------------------------------------------------------------
// Integers from text

// ---------------------------------------------------------------------------
// qsort: a shell sort (the runtime sorts header and channel lists), cmp
// a C function of two element addresses returning a C int.

/// C's strtol: optional white space and sign, then digits in base (0:
/// a 0x prefix is 16, a leading 0 is 8, else 10; 2 to 36), saturating at
/// the Int range (errno is not set); *end, when end is not 0, is where
/// the digits stopped (s when there were none).
pub fn strtol(s: Int, end: Int, base0: Int) -> Int {
  var i = 0
  while c_space(rt.mem_load(s, i, 1)) {
    i += 1
  }
  var neg = false
  let sg = rt.mem_load(s, i, 1)
  if sg == 45 || sg == 43 {
    neg = sg == 45
    i += 1
  }
  // base is a C int: its register's low 32 bits (the upper ones are
  // undefined in both ABIs)
  let bw = base0 & 0xFFFFFFFF
  var base = if bw >= 0x80000000 { bw - 0x100000000 } else { bw }
  if (base == 0 || base == 16) && rt.mem_load(s, i, 1) == 48 && (rt.mem_load(s, i + 1, 1) | 32) == 120 && c_digit(rt.mem_load(s, i + 2, 1)) < 16 {
    base = 16
    i += 2
  } else if base == 0 && rt.mem_load(s, i, 1) == 48 {
    base = 8
  } else if base == 0 {
    base = 10
  }
  if base < 2 || base > 36 {
    if end != 0 {
      rt.mem_store(end, 0, s, 8)
    }
    return 0
  }
  let start = i
  var v = 0
  var over = false
  while true {
    let d = c_digit(rt.mem_load(s, i, 1))
    if d >= base {
      break
    }
    // accumulate as a negative number, which holds the Int minimum
    if !over {
      if v < (-9223372036854775807 - 1 + d) / base {
        over = true
      } else {
        v = v * base - d
      }
    }
    i += 1
  }
  if end != 0 {
    rt.mem_store(end, 0, if i == start { s } else { s + i }, 8)
  }
  if over {
    return if neg { -9223372036854775807 - 1 } else { 9223372036854775807 }
  }
  if neg {
    return v
  }
  if v == -9223372036854775807 - 1 {
    return 9223372036854775807
  }
  -v
}

/// C's atoi: strtol in base 10, truncated to a C int.
pub fn atoi(s: Int) -> Int {
  let v = strtol(s, 0, 10)
  let w = v & 0xFFFFFFFF
  if w >= 0x80000000 { w - 0x100000000 } else { w }
}

/// C's isspace in the C locale.
fn c_space(c: Int) -> Bool {
  c == 32 || (c >= 9 && c <= 13)
}

/// The value of digit byte c in any base up to 36, else 99.
fn c_digit(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    return c - 48
  }
  let l = c | 32
  if l >= 97 && l <= 122 {
    return l - 87
  }
  99
}
