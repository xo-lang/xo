// The Str operations of the native runtime that decide something per
// rune or per match, written in Xo (decision 0193, step 2): Str.replace,
// its counted form, and the trims (Unicode white space). They were C (std/llrt/xo_std.c);
// the semantics are still Go's (strings), so the native backends print
// what the Go backend prints. Its C path (`XO_LLRT_C=strings`,
// strings_c.xo) went once bench/perf/text met decision 0180's bar on both
// native backends (decision 0198).
//
// The searches are scan.xo (decision 0201: find, split, lines,
// rune_count); the copies are raw.xo's and obj.xo's (raw.str_slice,
// rt.rs_append_bytes, Str.repeat, List[Str].join).
use native/llrt/scan
use native/llrt/unicode
use native/rt
use native/llrt/raw

/// The size of the UTF-8 sequence of b at i (an invalid byte is 1).
fn seq_size(b: Bytes, i: Int) -> Int {
  if b[i] < 0x80 {
    return 1
  }
  unicode.decode(b, i) & 7
}

/// The buffer of replace, replace_n, replace_bytes and replace_bytes_n: b
/// with the first n copies of old replaced by new (n below 0: every one),
/// built in a Str of room `cap`. An empty old inserts new before every
/// UTF-8 sequence and at the end (an invalid byte is one sequence), as Go
/// does.
fn replace_build(b: Bytes, old: Bytes, new: Bytes, n: Int, cap: Int) -> Str {
  let sl = b.len()
  let m = old.len()
  if m == 0 {
    var o = rt.rs_with_cap(cap)
    var start = 0
    var done = 0
    while (n < 0 || done < n) && start <= sl {
      o = rt.rs_append_bytes(o, new, 0, new.len(), 0)
      done += 1
      if start >= sl {
        break
      }
      let k = seq_size(b, start)
      o = rt.rs_append_bytes(o, b, start, start + k, 0)
      start += k
    }
    if start < sl {
      o = rt.rs_append_bytes(o, b, start, sl, 0)
    }
    return o
  }
  var o = rt.rs_with_cap(cap)
  var start = 0
  var done = 0
  while n < 0 || done < n {
    let j = scan.find_bytes(b, old, start)
    if j < 0 {
      break
    }
    o = rt.rs_append_bytes(rt.rs_append_bytes(o, b, start, j, 0), new, 0, new.len(), 0)
    start = j + m
    done += 1
  }
  rt.rs_append_bytes(o, b, start, sl, 0)
}

/// The room replace and replace_bytes ask for: the result's exact size for
/// an empty old (sl + the boundaries' new), else b's own.
fn replace_cap(sl: Int, m: Int, new: Bytes) -> Int {
  if m == 0 {
    return sl + (sl + 1) * new.len()
  }
  sl
}

/// strings.ReplaceAll: an empty old inserts new before every UTF-8
/// sequence and at the end. A copy when nothing matches, as Go makes.
pub fn replace(s: Str, old: Str, new: Str) -> Str {
  let n = s.len()
  let m = old.len()
  if m > 0 && scan.find_bytes(s.bytes(), old.bytes(), 0) < 0 {
    return raw.str_slice(s, 0, n)
  }
  replace_build(s.bytes(), old.bytes(), new.bytes(), -1, replace_cap(n, m, new.bytes()))
}

/// strings.Replace with a count: the first n matches of old are replaced
/// (n below 0: every one; 0: none). Go's paths: the same text, not a copy,
/// when old is new, n is 0 or there is no match; one allocation sized from
/// the count otherwise.
pub fn replace_n(s: Str, old: Str, new: Str, n: Int) -> Str {
  if old == new || n == 0 {
    return s
  }
  let sl = s.len()
  let m = old.len()
  let cnt = scan.count(s, old)
  if cnt <= 0 {
    return s
  }
  if n < 0 || cnt < n {
    // every match: ReplaceAll's path
    return replace(s, old, new)
  }
  let cap = if m == 0 { sl + n * new.len() } else { sl + n * (new.len() - m) }
  replace_build(s.bytes(), old.bytes(), new.bytes(), n, cap)
}

/// bytes.ReplaceAll: replace's mapping over Bytes, b itself (not a copy)
/// when nothing changes, since Xo values are immutable.
pub fn replace_bytes(b: Bytes, old: Bytes, new: Bytes) -> Bytes {
  let sl = b.len()
  let m = old.len()
  if m > 0 && scan.find_bytes(b, old, 0) < 0 {
    return b
  }
  rt.cast[Str, Bytes](replace_build(b, old, new, -1, replace_cap(sl, m, new)))
}

/// bytes.Replace with a count: replace_n's, b itself when nothing changes.
pub fn replace_bytes_n(b: Bytes, old: Bytes, new: Bytes, n: Int) -> Bytes {
  if old == new || n == 0 {
    return b
  }
  let sl = b.len()
  let m = old.len()
  let cnt = scan.count_bytes(b, old)
  if cnt <= 0 {
    return b
  }
  if n < 0 || cnt < n {
    return replace_bytes(b, old, new)
  }
  let cap = if m == 0 { sl + n * new.len() } else { sl + n * (new.len() - m) }
  rt.cast[Str, Bytes](replace_build(b, old, new, n, cap))
}

/// Whether the rune r is white space (unicode.IsSpace).
fn is_space(r: Int) -> Bool {
  if r < 0x80 {
    return r == 32 || (r >= 9 && r <= 13)
  }
  unicode.is_space(r)
}

/// Whether c, a byte, is ASCII white space (unicode.IsSpace's ASCII set).
fn ascii_space(c: Int) -> Bool { c == 32 || (c >= 9 && c <= 13) }

/// The field of b from i on: its start and end offsets, or (-1, -1) when
/// only white space is left. ASCII takes the byte path of Go's fast path;
/// only a non-ASCII byte decodes a rune.
fn field_from(b: Bytes, i: Int) -> (Int, Int) {
  let n = b.len()
  var at = i
  // skip a run of white space
  while at < n {
    let c = Int(b[at])
    if c < 0x80 {
      if !ascii_space(c) {
        break
      }
      at += 1
      continue
    }
    let p = unicode.decode(b, at)
    if (p & 7) == 1 || !is_space(p >> 3) {
      break
    }
    at += p & 7
  }
  if at >= n {
    return (-1, -1)
  }
  let start = at
  // the field runs to the next white space
  while at < n {
    let c = Int(b[at])
    if c < 0x80 {
      if ascii_space(c) {
        break
      }
      at += 1
      continue
    }
    let p = unicode.decode(b, at)
    if (p & 7) != 1 && is_space(p >> 3) {
      break
    }
    at += p & 7
  }
  (start, at)
}

/// bytes.Fields: the runs of non-white-space bytes, split around runs of
/// white space (unicode.IsSpace), as views of b.
pub fn fields_bytes(b: Bytes) -> List[Bytes] {
  var out: List[Bytes] = []
  var i = 0
  while i < b.len() {
    let (start, end) = field_from(b, i)
    if start < 0 {
      break
    }
    out.push(b[start..end])
    i = end
  }
  out
}

/// strings.Fields: the same fields of the text, each one a view of s (a
/// field boundary is a rune boundary of the valid text).
pub fn fields(s: Str) -> List[Str] {
  var out: List[Str] = []
  let b = s.bytes()
  var i = 0
  while i < b.len() {
    let (start, end) = field_from(b, i)
    if start < 0 {
      break
    }
    out.push(raw.str_cut(s, start, end))
    i = end
  }
  out
}

/// The start of the bytes of b from lo to hi after their leading white
/// space (an invalid byte is not space).
pub fn space_end(b: Bytes, lo: Int, hi: Int) -> Int {
  var i = lo
  while i < hi {
    let c = Int(b[i])
    if c < 0x80 {
      if c == 32 || (c >= 9 && c <= 13) {
        i += 1
        continue
      }
      return i
    }
    let p = unicode.decode(b, i)
    if (p & 7) == 1 || !is_space(p >> 3) {
      return i
    }
    i += p & 7
  }
  i
}

/// The end of the bytes of b from lo to hi before their trailing white
/// space.
pub fn space_start(b: Bytes, lo: Int, hi: Int) -> Int {
  var n = hi
  while n > lo {
    let c = Int(b[n - 1])
    if c < 0x80 {
      if c == 32 || (c >= 9 && c <= 13) {
        n -= 1
        continue
      }
      return n
    }
    // the start of the last rune: back over up to 3 continuation bytes
    var st = n - 1
    while st > lo && n - st < 4 && (Int(b[st]) & 0xC0) == 0x80 {
      st -= 1
    }
    let p = unicode.decode(b, st)
    let size = p & 7
    if st + size != n || size == 1 || !is_space(p >> 3) {
      return n
    }
    n = st
  }
  n
}

/// bytes.TrimSpace (mode 0), TrimLeftFunc (1) or TrimRightFunc (2) with
/// unicode.IsSpace, on the bytes. b itself when nothing is trimmed.
pub fn trim_bytes(b: Bytes, mode: Int) -> Bytes {
  let n = b.len()
  var lo = 0
  var hi = n
  if mode != 2 {
    lo = space_end(b, 0, n)
  }
  if mode != 1 {
    hi = space_start(b, lo, n)
  }
  if lo == 0 && hi == n {
    return b
  }
  b[lo..hi]
}

/// strings.TrimSpace (mode 0), TrimLeftFunc (1) or TrimRightFunc (2) with
/// unicode.IsSpace. s itself when nothing is trimmed; otherwise the same
/// offsets trim_bytes finds, cut from s itself (no cast of outside bytes,
/// decision 0259).
pub fn trim(s: Str, mode: Int) -> Str {
  let b = s.bytes()
  let n = b.len()
  var lo = 0
  var hi = n
  if mode != 2 {
    lo = space_end(b, 0, n)
  }
  if mode != 1 {
    hi = space_start(b, lo, n)
  }
  if lo == 0 && hi == n {
    return s
  }
  raw.str_cut(s, lo, hi)
}
