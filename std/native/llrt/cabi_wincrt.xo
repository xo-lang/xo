// The C runtime of a windows/amd64 program linked with no C runtime
// (decision 0254 stage 6b, step 4: Xo's PE linker, the default with no
// `use c`; XO_WIN_NOCRT=0 for the C runtime): the
// C library functions generated code calls (memcpy, memmove, memset,
// memcmp, fmod, strlen, getpid; Xo's, as an XO_NOLIBC Linux program's, libcstr.xo and
// libcmath.xo) under their bare C names, and the process's entry. Only
// such a build has them (compiler/ssa declare_exports). Nothing here may
// fault or allocate Xo values.
use native/llrt/entry
use native/llrt/libcmath
use native/llrt/libcmem
use native/llrt/libcstr
use native/llrt/sanhook
use native/llrt/windows
use native/rt
use native/sys_windows

fn memcpy(d: Int, s: Int, n: Int) -> Int { libcstr.memcpy(d, s, n) }

fn memmove(d: Int, s: Int, n: Int) -> Int { libcstr.memmove(d, s, n) }

fn memset(d: Int, c: Int, n: Int) -> Int { libcstr.memset(d, c, n) }

fn memcmp(a: Int, b: Int, n: Int) -> Int { libcstr.memcmp(a, b, n) }

fn fmod(x: Float, y: Float) -> Float { libcmath.fmod(x, y) }

/// (rt.sym_addr("strlen"), std/native/internal.xo's test hook)
fn strlen(s: Int) -> Int { libcstr.strlen(s) }

// SQLite's prebuilt object for windows/amd64 (decision 0534 stage 2,
// built with SQLITE_WIN32_MALLOC and no C runtime) calls these too

fn memchr(s: Int, c: Int, n: Int) -> Int { libcstr.memchr(s, c, n) }

fn strchr(s: Int, c: Int) -> Int { libcstr.strchr(s, c) }

fn strrchr(s: Int, c: Int) -> Int { libcstr.strrchr(s, c) }

fn strcmp(a: Int, b: Int) -> Int { libcstr.strcmp(a, b) }

fn strncmp(a: Int, b: Int, n: Int) -> Int { libcstr.strncmp(a, b, n) }

fn strspn(s: Int, set: Int) -> Int { libcstr.strspn(s, set) }

fn strcspn(s: Int, set: Int) -> Int { libcstr.strcspn(s, set) }

/// malloc and free of the `use c` adapter compiled into SQLite's object
/// (its Str arguments' C copies): libcmem's, as an XO_NOLIBC Linux
/// program's (no new import: the PE linker of an older xo, which builds
/// xo on Windows, knows only its own import table).
fn malloc(n: Int) -> Int { libcmem.malloc(n) }

fn free(p: Int) { libcmem.free(p) }

/// abort (SQLite's, on a broken invariant): the process ends with
/// status 3, as MSVC's abort ends it.
fn abort() {
  sys_windows.ExitProcess(3)
}

/// _localtime64_s (SQLite's localtime modifier): the time *t in the
/// system's zone as the struct tm at tm (windows.localtime_tm); 0, or
/// EINVAL (22).
fn _localtime64_s(tm: Int, t: Int) -> Int {
  if tm == 0 {
    return 22
  }
  windows.localtime_tm(tm, if t == 0 { -1 } else { rt.mem_load(t, 0, 8) })
}

/// The C runtime's getpid (std/native/sys_c.xo's strong reference):
/// GetCurrentProcessId.
fn getpid() -> Int32 {
  match target.os {
    TargetOs.Windows => Int32(Int(sys_windows.GetCurrentProcessId()))
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi | TargetOs.FreeBSD => Int32(0)
  }
}

/// The process's entry (the PE's AddressOfEntryPoint): what cabi_c.main
/// does when the C runtime's start calls it (Windows reads its own
/// command line and environment, entry.xo), then the process ends with
/// its status (returning would end only this thread).
fn xo_win_start() -> Int {
  match target.arch {
    TargetArch.Arm64 => {
      // ARMv8.1's LSE atomics (PF_ARM_V81_ATOMIC_INSTRUCTIONS_AVAILABLE)
      // for the outline atomics' dispatch (compiler/xo link.xo
      // win_arm64_atomics defines xo_lse), as Linux's AT_HWCAP test
      // (cabi_nolibc.xo nl_start)
      if Int(sys_windows.IsProcessorFeaturePresent(34)) != 0 {
        rt.mem_store(rt.sym_addr("xo_lse"), 0, 1, 1)
      }
    }
    TargetArch.Amd64 | TargetArch.Wasm32 | TargetArch.Riscv64 => {}
  }
  entry.init()
  let code = entry.main(0, 0, 0, rt.sym_addr("xo_entry"), 1)
  match target.os {
    TargetOs.Windows => {
      // windows --race: ThreadSanitizer's end and status
      sanhook.race_exit(code)
      sys_windows.ExitProcess(code)
    }
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi | TargetOs.FreeBSD => {}
  }
  code
}
