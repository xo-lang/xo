// The HTTP client's TLS connections in Xo (the zero-C audit's B31,
// decision 0202): the TLS 1.3 client of tls13.xo over the connection's
// socket, with the waits of xo_tls.c's bio_send and bio_recv (the poll
// descriptor, the deadline, cancellation) and its texts of a failed
// handshake. hclient.xo calls this file; its C path, tlsio_c.xo
// (XO_LLRT_C=tlsio, decision 0193), forwards the same calls to xo_tls.c
// on Mbed TLS. Known gaps until they land: a server that only speaks TLS
// 1.2 is refused (xo-fa's tls12.xo), and macOS's system roots are
// checked by x509verify.xo, not the Security framework (Go asks the
// framework). The server's TLS stays Mbed's (tls13srv.xo, xo-2b).
// Windows and Linux are UNTESTED.
use native/llrt/hconn
use native/llrt/poll
use native/llrt/raw
use native/llrt/rc
use native/llrt/sock
use native/llrt/sysio
use native/llrt/tasks
use native/llrt/tls13
use native/llrt/x509
use native/rt
use native/rthttp

// the results of reads and writes (hclient.xo CC_*)
const CC_OK: Int = 0
const CC_TIMEOUT: Int = 2
const CC_CANCELED: Int = 3
const CC_ERR: Int = 4

/// MSG_NOSIGNAL of Linux's send (sock.send ignores it elsewhere).
const NOSIGNAL = 16384

/// http.DefaultTransport's TLSHandshakeTimeout (10 s).
const HANDSHAKE_NS = 10000000000

/// The mbedtls_x509_crt chain's fields (tlscert.xo): the DER's length
/// and address, the next certificate.
const CRT_RAW_LEN = 16
const CRT_RAW_P = 24
const CRT_NEXT = 1288

/// A connection: the client, its poll descriptor and deadline (monotonic
/// ns, 0 none), why the last socket operation failed (CC_*, 0 none), the
/// first bytes received (for the texts of a server that is not TLS), and
/// whether the server's input ended.
struct Conn {
  cl: tls13.Client
  pd: Int
  when: Int
  status: Int
  first: Bytes
  eof: Bool
}

/// A connection's handle: a block whose word holds the record of an Any
/// with the Conn (the value is replaced after each call).
fn load(h: Int) -> Conn? {
  let a = rt.obj_at[rt.Any](rt.mem_load(h, 0, 8))
  rt.any_get[Conn](a)
}

fn save(h: Int, c: Conn) {
  let old = rt.mem_load(h, 0, 8)
  rt.mem_store(h, 0, keep(rt.any_of(c)), 8)
  if old != 0 {
    tasks.h_release(old)
  }
}

/// The record of Any a with a reference more. a is a parameter: the
/// caller holds it through the call, where a local's last use (obj_addr)
/// would release it before rc.inc.
fn keep(a: rt.Any) -> Int {
  let s = rt.obj_addr(a)
  rc.inc(s)
  s
}

/// The outcome of a handshake: CC_*, the connection (0 on a failure),
/// the ClientErr tag of a failure (2 Connect for a server's alert, else
/// 4 Protocol) and its text.
pub struct Start {
  pub status: Int
  pub conn: Int
  pub kind: Int
  pub msg: Str
}

fn failed(status: Int, kind: Int, msg: Str) -> Start { Start{status: status, conn: 0, kind: kind, msg: msg} }

/// The client's handshake on poll descriptor pd for host (the URL's
/// host, IPv6 in brackets) with roots (a rthttp.Roots record) by the
/// deadline dl (0 none; and the 10 s TLSHandshakeTimeout), as
/// xo_tls.c's tls_client_start.
pub fn client(pd: Int, host: Str, roots: Int, dl: Int) -> Start {
  let crt = rthttp.tls_c_roots_crt(roots)
  if crt == 0 {
    return failed(CC_ERR, 4, "tls: failed to verify certificate: x509: failed to load system roots and no roots provided")
  }
  var name = host
  if name.len() >= 2 && name.starts_with("[") && name.ends_with("]") {
    name = raw.str_slice(name, 1, name.len() - 1)
  }
  let cf = tls13.conf(name, chain(crt), sysio.real_ns() / 1000000000)
  let hs = hconn.deadline(HANDSHAKE_NS)
  let limit = if dl != 0 && dl < hs { dl } else { hs }
  var c = Conn{cl: tls13.client(cf), pd: pd, when: limit, status: 0, first: b"", eof: false}
  while c.cl.state != tls13.DONE && c.cl.state != tls13.FAILED {
    if !flush(c) || !fill(c) {
      break
    }
  }
  if c.cl.state == tls13.DONE {
    c.when = dl
    let h = rt.heap_large(8)
    rt.mem_store(h, 0, 0, 8)
    save(h, c)
    return Start{status: CC_OK, conn: h, kind: 4, msg: ""}
  }
  // the alert of a failure goes out when it can
  let _sent = flush(c)
  if c.status == CC_TIMEOUT || c.status == CC_CANCELED {
    return failed(c.status, 4, "")
  }
  if c.first.len() >= 5 && c.first[0..5] == b"HTTP/" {
    return failed(CC_ERR, 4, "http: server gave HTTP response to HTTPS client")
  }
  let err = c.cl.err
  if err.starts_with("remote error: ") {
    return failed(CC_ERR, 2, err)
  }
  if !err.is_empty() {
    return failed(CC_ERR, 4, err)
  }
  if c.first.len() >= 1 && c.first[0] != 21 && c.first[0] != 22 {
    return failed(CC_ERR, 4, "tls: first record does not look like a TLS handshake")
  }
  failed(CC_ERR, 4, "EOF")
}

/// The certificates of an mbedtls_x509_crt chain that parse.
fn chain(crt: Int) -> List[x509.Cert] {
  var out: List[x509.Cert] = []
  var p = crt
  while p != 0 {
    let n = rt.mem_load(p, CRT_RAW_LEN, 8)
    if n > 0 {
      let parsed = x509.parse(raw.str_at(rt.mem_load(p, CRT_RAW_P, 8), n).bytes())
      if parsed.err == "" {
        out.push(parsed.cert)
      }
    }
    p = rt.mem_load(p, CRT_NEXT, 8)
  }
  out
}

/// Sends what the client has to send: whether it all went.
fn flush(var c: Conn) -> Bool {
  let b = tls13.take(c.cl)
  let n = b.len()
  if n == 0 {
    return true
  }
  let fd = rt.mem_load(c.pd, 8, 4)
  let p = raw.bytes_addr(b)
  var off = 0
  while off < n {
    let w = sock.send(fd, p + off, n - off, NOSIGNAL)
    if w >= 0 {
      off += w
      continue
    }
    if w == -sock.EINTR {
      continue
    }
    if !would_block(w) {
      c.status = CC_ERR
      return false
    }
    let r = poll.pd_wait(c.pd, true, c.when)
    if r != poll.READY {
      c.status = wait_res(r)
      return false
    }
  }
  true
}

/// Reads what the server sent into the client: false when the input
/// ended or a wait failed.
fn fill(var c: Conn) -> Bool {
  let fd = rt.mem_load(c.pd, 8, 4)
  let buf = raw.bytes_buf(16384)
  while true {
    if poll.canceled() {
      c.status = CC_CANCELED
      return false
    }
    let r = sock.read(fd, raw.bytes_addr(buf), 16384)
    if r > 0 {
      let got = raw.bytes_len(buf, r)
      if c.first.len() < 5 {
        let k = if 5 - c.first.len() < r { 5 - c.first.len() } else { r }
        c.first = rt.rs_append_bytes(rt.rs_append_bytes(rt.rs_with_cap(5), c.first, 0, c.first.len(), 0), got, 0, k, 0).bytes()
      }
      tls13.feed(c.cl, got)
      return true
    }
    if r == 0 {
      c.eof = true
      return false
    }
    if r == -sock.EINTR {
      continue
    }
    if !would_block(r) {
      c.status = CC_ERR
      return false
    }
    let w = poll.pd_wait(c.pd, false, c.when)
    if w != poll.READY {
      c.status = wait_res(w)
      return false
    }
  }
  false
}

/// Reads decrypted bytes into the n bytes at p: the count, 0 at the end
/// of the stream (close_notify or the socket's end), or -CC_* (xo_tls.c
/// tls_read).
pub fn read(h: Int, p: Int, n: Int) -> Int {
  var c = match load(h) {
    Some(x) => x
    None => return -CC_ERR
  }
  var out = 0
  while true {
    // what does not fit stays for the next read
    let app = tls13.recv_some(c.cl, n)
    if app.len() > 0 {
      rt.mem_copy(p, raw.bytes_addr(app), app.len())
      out = app.len()
      break
    }
    if c.cl.closed || c.eof {
      break
    }
    if c.cl.state == tls13.FAILED {
      c.status = CC_ERR
      out = -CC_ERR
      break
    }
    // a KeyUpdate's answer, an alert
    if !flush(c) || !fill(c) {
      if !c.eof {
        out = -(if c.status == 0 { CC_ERR } else { c.status })
        break
      }
    }
  }
  let _sent = flush(c)
  save(h, c)
  out
}

/// Writes the n bytes at p: CC_OK or why it failed.
pub fn write(h: Int, p: Int, n: Int) -> Int {
  var c = match load(h) {
    Some(x) => x
    None => return CC_ERR
  }
  if c.cl.state != tls13.DONE {
    return CC_ERR
  }
  tls13.send(c.cl, raw.str_at(p, n).bytes())
  let ok = flush(c)
  save(h, c)
  if ok { CC_OK } else if c.status == 0 { CC_ERR } else { c.status }
}

/// The text of a fatal alert the server sent after the handshake, "" for
/// none.
pub fn alert(h: Int) -> Str {
  match load(h) {
    Some(c) => if c.cl.err.starts_with("remote error: ") { c.cl.err } else { "" }
    None => ""
  }
}

/// Sets the deadline of the connection's socket waits.
pub fn set_when(h: Int, dl: Int) {
  if let Some(x) = load(h) {
    var c = x
    c.when = dl
    c.status = 0
    save(h, c)
  }
}

/// Whether ALPN chose HTTP/2.
pub fn alpn_h2(h: Int) -> Bool {
  match load(h) {
    Some(c) => c.cl.alpn == "h2"
    None => false
  }
}

/// Frees a connection (0: none).
pub fn free(h: Int) {
  if h == 0 {
    return
  }
  let s = rt.mem_load(h, 0, 8)
  if s != 0 {
    tasks.h_release(s)
  }
  rt.heap_release(h - 8)
}

fn would_block(e: Int) -> Bool {
  match target.os {
    TargetOs.Darwin => e == -35
    TargetOs.Windows => e == -140 || e == -11
    TargetOs.Linux | TargetOs.Wasi => e == -11
  }
}

fn wait_res(w: Int) -> Int {
  if w == poll.TIMEOUT {
    return CC_TIMEOUT
  }
  if w == poll.CANCELED {
    return CC_CANCELED
  }
  CC_ERR
}
