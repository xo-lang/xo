// Go's crypto/tls ech_test.go (go1.26.11), ported (decision 0644 T13).
use std/hpke
use native/llrt/asn1

fn unhex(s: Str) -> Bytes { Bytes.from_hex(s) ?? b"" }

test "TestDecodeECHConfigLists" {
  let one = unhex("0045fe0d0041590020002092a01233db2218518ccbbbbc24df20686af417b37388de6460e94011974777090004000100010012636c6f7564666c6172652d6563682e636f6d0000")
  let (a, ea) = parse_list(one)
  expect(ea) == ""
  expect(a.len()) == 1
  expect(a[0].public_name.to_str() ?? "") == "cloudflare-ech.com"
  let three = unhex("")
  let (b, eb) = parse_list(three)
  expect(eb) == ""
  expect(b.len()) == 3
  expect(pick(a).is_some()) == true
}

test "TestSkipBadConfigs" {
  let l = unhex("")
  let (cs, e) = parse_list(l)
  expect(e) == ""
  expect(pick(cs).is_none()) == true
}

test "malformed lists" {
  expect(parse_list(b"").1) == "tls: malformed ECHConfigList"
  expect(parse_list(b"\x00\x03\xfe\x0d\x00").1) == "tls: malformed ECHConfig"
  expect(parse_list(b"\x00\x04\xfe\x0d\x00\x05").1) == "tls: malformed ECHConfig, invalid length field"
}

test "validDNSName" {
  expect(valid_dns_name("public.example")) == true
  expect(valid_dns_name("example")) == false
  expect(valid_dns_name("a..b")) == false
  expect(valid_dns_name("-a.b")) == false
  expect(valid_dns_name("a_b.c")) == false
}

test "padding as Go pads" {
  // Go's encodeInnerClientHello as it is: its second assignment to
  // paddingLen replaces the name's padding, so the length is
  // len(h) + 31 - ((len(h) + name padding - 1) % 32)
  expect(pad_inner(zeros(100), "a.b", 32).len()) == 131
  expect(pad_inner(zeros(100), "", 0).len()) == 119
}

test "outer extension round trip" {
  let d = outer_ext(123, 1, 1, b"KEY", b"PAYLOAD")
  let e = parse_ext(d)
  expect(e.err) == ""
  expect(e.outer) == true
  expect(e.id) == 123
  expect(e.enc) == b"KEY"
  expect(e.payload) == b"PAYLOAD"
  expect(parse_ext(b"\x01").outer) == false
  expect(parse_ext(b"\x01\x00").err) == "malformed"
  expect(parse_ext(b"\x02").err) == "invalid"
}

// The client's sender (here, on the handshake's primitives) against
// std/hpke's Recipient, for each KEM and suite it takes.
test "sender seals what std/hpke opens" {
  for (kem_id, kdf, aead) in [(0x0020, 1, 1), (0x0020, 1, 3), (0x0010, 1, 1), (0x0011, 2, 2), (0x0012, 3, 1)] {
    let kem = hpke.new_kem(kem_id) ?? e => fault(e.msg)
    let sk = kem.derive_key_pair(b"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") ?? e => fault(e.msg)
    let pkb = sk.public_key().bytes()
    let raw = asn1.cat([b"\xfe\x0d\x00\x00", b"\x07"])
    let cfg = Config{raw: raw, id: 7, kem: kem_id, public_key: pkb, suites: [(kdf, aead)], max_name: 0, public_name: "a.example".bytes(), exts: []}
    let p = Picked{config: cfg, pk: sk.public_key(), kdf: hpke.new_kdf(kdf) ?? e => fault(e.msg), aead: hpke.new_aead(aead) ?? e => fault(e.msg)}
    let (so, e) = sender(p)
    expect(e) == ""
    var s = so ?? fault("no sender")
    let c1 = seal(s, b"aad1", b"hello")
    let c2 = seal(s, b"aad2", b"again")
    var r = hpke.new_recipient(s.enc, sk, p.kdf, p.aead, info(raw)) ?? e => fault(e.msg)
    expect(r.open(b"aad1", c1) ?? e => "FAIL ${e.msg}".bytes()) == b"hello"
    expect(r.open(b"aad2", c2) ?? _e => "FAIL".bytes()) == b"again"
  }
}

/// An outer ClientHello message (with its header) of these extensions.
fn outer_hello(exts: List[Bytes]) -> Bytes {
  var r = b""
  for _ in 0..32 {
    r = asn1.cat([r, b"\x07"])
  }
  let body = asn1.cat([b"\x03\x03", r, vec8(b""), vec16(b"\x13\x01"), vec8(b"\x00"), vec16(asn1.cat(exts))])
  asn1.cat([u8(1), u8(body.len() >> 16), u16(body.len()), body])
}

/// An EncodedClientHelloInner of these extensions.
fn inner_enc(exts: List[Bytes]) -> Bytes {
  var r = b""
  for _ in 0..32 {
    r = asn1.cat([r, b"\x09"])
  }
  asn1.cat([b"\x03\x03", r, vec8(b""), vec16(b"\x13\x01"), vec8(b"\x00"), vec16(asn1.cat(exts))])
}

/// An ech_outer_extensions naming these types.
fn outer_refs(ts: List[Int]) -> Bytes {
  var b = b""
  for t in ts {
    b = asn1.cat([b, u16(t)])
  }
  ext(EXT_OUTER, vec8(b))
}

test "outer_extensions: one reference list, in the outer's order, never rewinding or naming ECH (GO-2026-6607: repeated references amplified memory)" {
  let outer = outer_hello([ext(0x000a, b"\x00\x02\x00\x1d"), ext(0x000d, b"\x00\x02\x08\x07"), ext(0x0010, b"\x00\x03\x02h2")])
  let (ok, e) = decode_inner(outer, b"", inner_enc([outer_refs([0x000a, 0x0010])]))
  expect(e) == ""
  expect(ok.len() > 4) == true
  // two outer_extensions extensions
  expect(decode_inner(outer, b"", inner_enc([outer_refs([0x000a]), outer_refs([0x0010])])).1) == "tls: invalid outer extensions"
  // the same extension twice, or out of the outer's order
  expect(decode_inner(outer, b"", inner_enc([outer_refs([0x000a, 0x000a])])).1) == "tls: invalid outer extensions"
  expect(decode_inner(outer, b"", inner_enc([outer_refs([0x0010, 0x000a])])).1) == "tls: invalid outer extensions"
  // encrypted_client_hello or outer_extensions itself, or one the outer lacks
  expect(decode_inner(outer, b"", inner_enc([outer_refs([EXT_ECH])])).1) == "tls: invalid outer extensions"
  expect(decode_inner(outer, b"", inner_enc([outer_refs([EXT_OUTER])])).1) == "tls: invalid outer extensions"
  expect(decode_inner(outer, b"", inner_enc([outer_refs([0x0029])])).1) == "tls: invalid outer extensions"
  // 32768 references to one extension of the outer: refused, not 32768 copies
  var many: List[Int] = []
  for _ in 0..127 {
    many.push(0x000d)
  }
  expect(decode_inner(outer, b"", inner_enc([outer_refs(many)])).1) == "tls: invalid outer extensions"
}
