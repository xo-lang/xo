// The native sampling profiler (decision 0238): XO_PROF=cpu samples
// XO_PROF_HZ times a second of CPU time (100 by default). On Linux it
// arms ITIMER_PROF; on macOS, whose SIGPROF arrives far less often than
// the rate, a sampler thread suspends and walks each thread that used a
// period of CPU (mac_sampler). Each SIGPROF records the interrupted
// thread's frames (unwind.xo
// prof_walk: the fault unwinder's tables, in a record of the profiler's
// own per thread) into a ring of fixed slots claimed with one atomic add:
// no allocation, no lock, no C library call in the handler; a sample the
// full ring cannot take is counted. At the end of main (entry.xo) or at
// os.proc.exit (process.xo, through cabi.xo prof_finish) the timer stops
// and the samples' locations are named from the program's own symbol
// table (macOS: LC_SYMTAB in __LINKEDIT, in memory; Linux: .symtab of
// /proc/self/exe) and its DWARF (dwline.xo, decision 0239: each
// location's function, file and line, the callees inlined there first):
// the fault traceback's symbolizer, which every binary keeps. The samples
// and the named locations go to a raw file (decision 0245: decision
// 0240's XORAW1 container, kind 2) at XO_PROF_OUT (xo-prof.xoraw by
// default, %p the process id), and `xo prof FILE` (compiler/xo prof.xo)
// writes from it what the program wrote itself before: pprof's protobuf,
// gzip with stored blocks (`go tool pprof`, speedscope, flame graph tools
// read it), and a text summary beside it (the top 30 by flat and by
// cumulative samples with each function's hottest line). The writers
// moved out of every binary: hello 633,314 to 565,106 bytes on
// darwin/arm64 (2026-10-17). Off (no XO_PROF) it costs one
// environment lookup at start. On Windows (amd64) there is no SIGPROF: a
// sampler thread wakes every 1/XO_PROF_HZ s on a high resolution
// waitable timer, and each of the process's other threads whose CPU
// cycles moved since the last tick is suspended, its context read, its
// frames walked (the image's .pdata and RtlVirtualUnwind) into the same
// ring, and resumed (win_sampler; symbols from the PE's COFF symbol
// table, which Windows links keep with /debug:symtab).
//
// XO_PROF=heap (decision 0238 item 4; with cpu: XO_PROF=cpu,heap) samples
// allocations, an exponential gap of mean XO_PROF_HEAP_RATE bytes (512
// KiB; 1 is every allocation), through heapprof.xo, into the same raw
// file: each sample's frames, its size, whether it was freed. `xo prof`
// writes Go's four heap values (alloc_objects, alloc_space,
// inuse_objects, inuse_space, each scaled by the sample's inverse
// probability, as Go does) as xo-heap.pprof and its text summary, the
// allocator's own frames (obj.xo, alloc.xo, cabi.xo's exports, the
// sampler) left off each stack, so a stack's leaf is the code that
// allocated.
use native/llrt/dwline
use native/llrt/heapos
use native/llrt/heapprof
use native/llrt/linux
use native/llrt/process
use native/llrt/raw
use native/llrt/stdio
use native/llrt/sysio
use native/llrt/unwind
use native/llrt/windows
use native/rt
use native/sys_darwin
use native/sys_windows

/// rt.static_word: the profiler's record (0: off).
const W_PROF = 13
/// The thread local word of this thread's profiler record (sched.xo's
/// table: 15).
const TL_PROF = 15

// The record (byte offsets): the ring's address and slot count, the
// next slot (atomic), the samples lost to a full ring or to the pool's
// end (atomic), the pool of per thread unwind records, its size and next
// free record (atomic), the program's text, the rate, the start time.
const R_RING = 0
const R_CAP = 8
const R_NEXT = 16
const R_LOST = 24
const R_POOL = 32
const R_POOL_N = 40
const R_POOL_NEXT = 48
const R_TLO = 56
const R_THI = 64
const R_HZ = 72
const R_T0 = 80
const R_NOREC = 88
/// Whether a CPU profile is running (1) or stopped with its record kept
/// for the next one (0; decision 0325): the handler checks it first.
const R_ON = 120
/// The profile's duration, set when it stops.
const R_DUR = 112
/// Windows: the sampler's record (WB_*) and its thread's handle.
const R_WIN = 96
const R_WTHREAD = 104
/// Set by profile_begin: the profile is served by std/debug, not written
/// to a file at exit.
const R_LIVE = 128
/// Signal handlers inside a sample now (profile_stop waits for 0).
const R_INFLIGHT = 136
/// macOS: the sampler's record (DB_*), and the run its thread samples
/// for (each start or profile_begin takes the next: a sampler of an
/// earlier run that wakes later returns).
const R_MAC = 144
const R_RUN = 152
/// Linux: each thread's CPU time at its last sample and the time it used
/// past whole periods (WT bytes per pool record), so a sample counts the
/// periods its thread used since the last one (weight).
const R_WTS = 160
const R_SIZE = 168
const WT = 32

/// The deepest stack a sample keeps, and a slot's bytes: the frame count,
/// then the pcs.
const DEPTH = 64
const SLOT = 520
/// The ring's slots: 32,768 samples (5.5 minutes of one busy thread at
/// 100 Hz) in 17 MB, mapped only when profiling.
const CAP = 32768
/// The threads that can be sampled (each claims an unwind record of
/// unwind.PROF_RECORD bytes on its first sample).
const POOL_N = 64

const SIGPROF = 27
const ITIMER_PROF = 2

const RELAXED = 0
const ACQ_REL = 3

fn ld(p: Int, o: Int) -> Int { rt.mem_load(p, o, 8) }

fn st(p: Int, o: Int, v: Int) { rt.mem_store(p, o, v, 8) }

fn darwin() -> Bool {
  match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
}

/// Anonymous memory of n bytes (zeroed), or 0.
fn map(n: Int) -> Int {
  let m = match target.os {
    TargetOs.Darwin => sys_darwin.mmap(0, n, 3, 2 | 4096, -1, 0)
    TargetOs.Linux => linux.mmap(0, n, 3, 2 | 32, -1, 0)
    // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE
    TargetOs.Windows => sys_windows.VirtualAlloc(0, n, 12288, 4)
    TargetOs.Wasi => 0
  }
  if m == 0 || (m < 0 && m > -4096) {
    return 0
  }
  m
}

/// Whether this build has the profiler: true here, and the SSA builders
/// fold a call of it to the build's answer (compiler/ssa expr.xo
/// prof_call): false in `xo build --release` without --profile-support,
/// so what it guards is neither built nor linked (decision 0238).
pub fn supported() -> Bool { true }

/// A build without the profiler (supported false): one line when XO_PROF
/// asks for a profile.
pub fn unsupported_note() {
  if process.env_real_at("XO_PROF") != 0 {
    stdio.eprint("xo profile: this program was built without the profiler (xo build --release; add --profile-support)", true)
  }
}

/// Arms the profiler when XO_PROF names cpu, heap, or both (entry.xo
/// start, after the environment is kept). Nothing else is touched when it
/// names neither.
pub fn start() {
  let v = process.env_real_at("XO_PROF")
  if v == 0 {
    return
  }
  // this process's profile only: the processes it starts do not inherit
  // the switch unless XO_PROF_CHILDREN=1 (its value stays readable here)
  if process.env_real_at("XO_PROF_CHILDREN") == 0 {
    process.env_drop("XO_PROF")
  }
  if names(v, "heap") {
    start_heap()
  }
  if !names(v, "cpu") {
    return
  }
  let win = match target.os {
    TargetOs.Darwin | TargetOs.Linux => false
    TargetOs.Windows => match target.arch {
      TargetArch.Amd64 => true
      TargetArch.Arm64 | TargetArch.Wasm32 => {
        stdio.eprint("xo profile: XO_PROF=cpu is not supported on windows/arm64 yet", true)
        return
      }
    }
    TargetOs.Wasi => {
      stdio.eprint("xo profile: XO_PROF=cpu is not supported on this target yet", true)
      return
    }
  }
  var hz = 100
  let h = process.env_real_at("XO_PROF_HZ")
  if h != 0 {
    let n = atoi(h)
    if n >= 1 && n <= 10000 {
      hz = n
    }
  }
  let r = make_record(hz)
  if r == -1 {
    stdio.eprint("xo profile: no memory for the profile", true)
    return
  }
  if r == -2 {
    stdio.eprint("xo profile: the program's unwind tables were not found", true)
    return
  }
  next_run(r)
  st(r, R_ON, 1)
  if win {
    // the pool's first record is the sampler's (no thread of the
    // program claims one: no signal handler runs on Windows)
    win_start(r, ld(r, R_POOL), hz)
    return
  }
  rt.slot_store[Int](rt.static_word(W_PROF), 0, r, 2)
  arm(r, hz)
}

/// A new run of the record r, before its switch goes on: a macOS sampler
/// of an earlier run that wakes after it sees another run and returns.
fn next_run(r: Int) {
  rt.slot_store[Int](r, R_RUN / 8, ld(r, R_RUN) + 1, 4)
}

/// Starts sampling for the record r at hz: macOS's sampler thread, else
/// SIGPROF's handler and ITIMER_PROF.
fn arm(r: Int, hz: Int) {
  if darwin() {
    mac_start(r, hz)
    return
  }
  match target.os {
    TargetOs.Linux => {
      // the vDSO's clock found now: weight's clock_gettime runs in the
      // handler, which must not look it up
      let _v = linux.vdso_clock()
    }
    TargetOs.Darwin | TargetOs.Windows | TargetOs.Wasi => {}
  }
  handler(rt.fn_addr("on_prof"))
  timer(1000000 / hz)
}

/// Stops what arm started: the timer and the handler; macOS's sampler
/// sees the switch off at its next tick and returns.
fn disarm() {
  if darwin() {
    return
  }
  timer(0)
  handler(1)
}

/// A new profiler record at rate hz: the record, the sample ring and the
/// pool of unwind records mapped, the program's text found; -1 without
/// memory, -2 without the unwind tables.
fn make_record(hz: Int) -> Int {
  let r = map(R_SIZE)
  let ring = map(CAP * SLOT)
  let pool = map(POOL_N * unwind.PROF_RECORD)
  let wts = map(POOL_N * WT)
  if r == 0 || ring == 0 || pool == 0 || wts == 0 {
    return -1
  }
  for i in 0..POOL_N {
    if !unwind.prof_init(pool + i * unwind.PROF_RECORD) {
      return -2
    }
  }
  let (lo, hi) = unwind.prof_text(pool)
  st(r, R_RING, ring)
  st(r, R_CAP, CAP)
  st(r, R_POOL, pool)
  st(r, R_WTS, wts)
  st(r, R_POOL_N, POOL_N)
  st(r, R_TLO, lo)
  st(r, R_THI, hi)
  st(r, R_HZ, hz)
  st(r, R_T0, sysio.mono_ns())
  r
}

/// Whether profiles can be started and read while the program runs
/// (decision 0325): CPU profiles on linux and darwin.
pub fn live_supported() -> Bool {
  match target.os {
    TargetOs.Darwin | TargetOs.Linux => true
    TargetOs.Windows | TargetOs.Wasi => false
  }
}

/// Starts a CPU profile at hz (1 to 10000) while the program runs: 0
/// started, 1 one is running already, 2 not available here (windows, a
/// target without the profiler), 3 no memory or unwind tables. Callers
/// serialize their begins (std/debug holds a Mutex); the first call maps
/// the record, the ring and the unwind pool, which stay mapped for the
/// life of the process (a handler on another thread may still read them
/// after the timer stops), and later calls reset them: the counts of the
/// slots the last run used back to 0, the sample position, the loss
/// counts. Threads keep their unwind records (TL_PROF) between runs.
pub fn profile_begin(hz: Int) -> Int {
  if !live_supported() || hz < 1 || hz > 10000 {
    return 2
  }
  var r = rt.slot_load[Int](rt.static_word(W_PROF), 0, 1)
  if r == 0 {
    r = make_record(hz)
    if r < 0 {
      return 3
    }
  } else {
    if rt.slot_load[Int](r, R_ON / 8, 1) != 0 || rt.slot_load[Int](r, R_INFLIGHT / 8, 4) != 0 {
      // running, or a handler of the last run is still inside a sample
      return 1
    }
    let used = if ld(r, R_NEXT) < ld(r, R_CAP) { ld(r, R_NEXT) } else { ld(r, R_CAP) }
    let ring = ld(r, R_RING)
    for k in 0..used {
      st(ring + k * SLOT, 0, 0)
    }
    st(r, R_NEXT, 0)
    rt.mem_set(ld(r, R_WTS), 0, POOL_N * WT)
    st(r, R_LOST, 0)
    st(r, R_NOREC, 0)
    st(r, R_DUR, 0)
    st(r, R_HZ, hz)
    st(r, R_T0, sysio.mono_ns())
  }
  st(r, R_LIVE, 1)
  next_run(r)
  rt.slot_store[Int](r, R_ON / 8, 1, 2)
  rt.slot_store[Int](rt.static_word(W_PROF), 0, r, 2)
  arm(r, hz)
  0
}

/// Stops the running CPU profile's timer and sampling (false: none was
/// running). The caller waits for profile_inflight() to read 0 (a handler
/// that counted itself in before the switch went off is finishing its
/// sample), then reads the profile with profile_collect.
pub fn profile_stop() -> Bool {
  let r = rt.slot_load[Int](rt.static_word(W_PROF), 0, 1)
  if r == 0 || rt.slot_swap[Int](r, R_ON / 8, 0, 4) == 0 {
    return false
  }
  disarm()
  st(r, R_DUR, sysio.mono_ns() - ld(r, R_T0))
  true
}

/// Signal handlers that are inside a sample now: profile_stop's caller
/// waits (a fiber sleep of 1 ms a round) until this reads 0, then reads
/// the profile.
pub fn profile_inflight() -> Int {
  let r = rt.slot_load[Int](rt.static_word(W_PROF), 0, 1)
  if r == 0 {
    return 0
  }
  rt.slot_load[Int](r, R_INFLIGHT / 8, 4)
}

/// The stopped CPU profile as decision 0240's container (what `xo prof`
/// reads), or empty when none has run.
pub fn profile_collect() -> Bytes {
  let r = rt.slot_load[Int](rt.static_word(W_PROF), 0, 1)
  if r == 0 || ld(r, R_DUR) == 0 || rt.slot_load[Int](r, R_ON / 8, 1) != 0 || rt.slot_load[Int](r, R_INFLIGHT / 8, 4) != 0 {
    // none, running, or a handler is still writing a slot (the caller's
    // wait for profile_inflight() is a cap, not an assumption)
    return b""
  }
  let out = build_raw(r, 0).data
  // the profile is read once: give the ring's used pages back (they stay
  // mapped for a later run; begin clears the slot counts it reuses)
  release_ring(r)
  out
}

/// Returns the pages the last run's samples used to the system and marks
/// the profile as read (profile_collect then returns empty until the next
/// run).
fn release_ring(r: Int) {
  let used = if ld(r, R_NEXT) < ld(r, R_CAP) { ld(r, R_NEXT) } else { ld(r, R_CAP) }
  let n = (used * SLOT + 16383) / 16384 * 16384
  if n > 0 {
    match target.os {
      TargetOs.Linux => {
        let _a = linux.madvise(ld(r, R_RING), n, 4)
      }
      TargetOs.Darwin => {
        let _a = sys_darwin.madvise(ld(r, R_RING), n, 5)
      }
      TargetOs.Windows | TargetOs.Wasi => {}
    }
  }
  st(r, R_DUR, 0)
}

/// XO_PROF_HEAP_AT (decision 0352 step D): when the text of a
/// debug.mem_label ends with its value, the heap profile's samples in use
/// at that moment are written to XO_PROF_HEAP_OUT (xo-heap-at.xoraw by
/// default; %p is the pid), once (a profile never overwrites a file). A
/// program that labels its phases (compiler/xo: "building, past phase
/// NAME") gets what each phase leaves alive, which a profile written at
/// exit cannot show. The sampler must run (XO_PROF=heap).
pub fn heap_at_label(text: Str) {
  let at = process.env_real("XO_PROF_HEAP_AT")
  if at.is_empty() || at[0].is_empty() || !text.ends_with(at[0]) {
    return
  }
  let data = heap_snapshot()
  if data.is_empty() {
    stdio.eprint("xo profile: XO_PROF_HEAP_AT needs the heap sampler (XO_PROF=heap)", true)
    return
  }
  let o0 = process.env_real("XO_PROF_HEAP_OUT")
  let out = expand_pid(if o0.is_empty() || o0[0].is_empty() { "xo-heap-at.xoraw" } else { o0[0] })
  if !write_file(out, data) {
    stdio.eprint("xo profile: could not write ${out} (it must not exist: a profile never overwrites a file)", true)
  } else if process.env_real_at("XO_PROF_QUIET") == 0 {
    stdio.eprint("xo profile: the heap in use at \"${text}\" in ${out} (`xo prof ${out}`)", true)
  }
}

/// The heap profile's snapshot while it samples (started by XO_PROF=heap
/// or heap_live_start), as the container; empty when it is off.
pub fn heap_snapshot() -> Bytes {
  let rh = heapprof.record()
  if rh == 0 {
    return b""
  }
  build_raw(0, rh).data
}

/// Starts the heap sampler while the program runs (rate 0: the default);
/// false when it cannot start (an unsupported target) or runs already.
pub fn heap_live_start(rate: Int) -> Bool {
  if !live_supported() || heapprof.record() != 0 {
    return false
  }
  heapprof.start(if rate >= 1 { rate } else { HEAP_RATE })
}

/// Whether the C string at v lists w (comma separated).
fn names(v: Int, w: Str) -> Bool {
  let wb = w.bytes()
  var i = 0
  var at = 0
  while true {
    let c = rt.mem_load(v, i, 1)
    if c == 0 || c == 44 {
      if i - at == wb.len() {
        var same = true
        for j in 0..wb.len() {
          if rt.mem_load(v, at + j, 1) != Int(wb[j]) {
            same = false
          }
        }
        if same {
          return true
        }
      }
      if c == 0 {
        return false
      }
      at = i + 1
    }
    i += 1
  }
  false
}

/// The heap profile's default rate: Go's runtime.MemProfileRate.
const HEAP_RATE = 524288

/// Starts the heap profile: heapprof.xo's tables, then every heap record
/// counts and samples (heapos.xo profile_on; a thread's new record
/// copies it). The heap keeps its paths: one thread keeps its single
/// threaded record and fast paths.
fn start_heap() {
  let ok = match target.os {
    TargetOs.Darwin | TargetOs.Linux => true
    TargetOs.Windows => match target.arch {
      TargetArch.Amd64 => true
      TargetArch.Arm64 | TargetArch.Wasm32 => false
    }
    TargetOs.Wasi => false
  }
  if !ok {
    stdio.eprint("xo profile: XO_PROF=heap is not supported on this target yet", true)
    return
  }
  var rate = HEAP_RATE
  let rv = process.env_real_at("XO_PROF_HEAP_RATE")
  if rv != 0 {
    let n = atoi(rv)
    if n >= 1 {
      rate = n
    }
  }
  if !heapprof.start(rate) {
    stdio.eprint("xo profile: no memory or unwind tables for the heap profile", true)
    return
  }
  heapos.profile_on()
}

/// The decimal digits of the C string at a (0 when none).
fn atoi(a: Int) -> Int {
  var v = 0
  var i = 0
  while true {
    let c = rt.mem_load(a, i, 1)
    if c < 48 || c > 57 || i > 9 {
      break
    }
    v = v * 10 + (c - 48)
    i += 1
  }
  v
}

/// Installs h as SIGPROF's handler (SA_SIGINFO for the ucontext,
/// SA_RESTART so an interrupted system call goes on), or SIG_IGN (1).
fn handler(h: Int) {
  match target.os {
    TargetOs.Linux => {
      let flags = if h == 1 { 0 } else { 4 | 268435456 }
      let _r = linux.sigaction(SIGPROF, h, flags)
    }
    TargetOs.Darwin => {
      // struct sigaction: the handler, the mask (4 bytes), the flags
      let sa = rt.heap_large(16)
      st(sa, 0, h)
      rt.mem_store(sa, 8, 0, 4)
      rt.mem_store(sa, 12, if h == 1 { 0 } else { 64 | 2 }, 4)
      let _r = sys_darwin.sigaction(SIGPROF, sa, 0)
      rt.heap_release(sa - 8)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// setitimer(ITIMER_PROF) every us microseconds of the process's CPU
/// time (0: stop).
fn timer(us: Int) {
  // struct itimerval: it_interval, it_value (each tv_sec, tv_usec)
  let t = rt.heap_large(32)
  st(t, 0, us / 1000000)
  st(t, 8, us % 1000000)
  st(t, 16, us / 1000000)
  st(t, 24, us % 1000000)
  match target.os {
    TargetOs.Linux => {
      let nr = match target.arch {
        TargetArch.Amd64 => 38
        TargetArch.Arm64 | TargetArch.Wasm32 => 103
      }
      let _r = rt.sys6(nr, ITIMER_PROF, t, 0, 0, 0, 0)
    }
    TargetOs.Darwin => {
      // macOS's struct timeval: tv_sec 8 bytes, tv_usec 4 (then 4 of
      // padding)
      rt.mem_store(t, 12, 0, 4)
      rt.mem_store(t, 28, 0, 4)
      let _r = sys_darwin.setitimer(ITIMER_PROF, t, 0)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
  rt.heap_release(t - 8)
}

/// SIGPROF's handler (cabi.xo on_prof): one sample of the interrupted
/// thread into the next free slot. Async signal safe.
pub fn on_signal(uc: Int) {
  let r = rt.slot_load[Int](rt.static_word(W_PROF), 0, 1)
  if r == 0 || uc == 0 {
    return
  }
  // counted in before the switch is read (both sequentially consistent),
  // so profile_stop, which clears the switch and then waits for the count
  // to reach 0, never lets a sample start after it returns (decision 0325)
  let _in = rt.slot_add[Int](r, R_INFLIGHT / 8, 1, 4)
  if rt.slot_load[Int](r, R_ON / 8, 4) != 0 {
    sample(r, uc)
  }
  let _out = rt.slot_add[Int](r, R_INFLIGHT / 8, -1, 4)
}

/// One sample of the interrupted thread into the next free slot.
fn sample(r: Int, uc: Int) {
  var s = rt.tlocal_get(TL_PROF)
  if s == 0 {
    let i = rt.slot_add[Int](r, R_POOL_NEXT / 8, 1, ACQ_REL)
    if i >= ld(r, R_POOL_N) {
      let _l = rt.slot_add[Int](r, R_NOREC / 8, 1, RELAXED)
      return
    }
    s = ld(r, R_POOL) + i * unwind.PROF_RECORD
    rt.tlocal_set(TL_PROF, s)
  }
  let k = weight(r, s)
  if k == 0 {
    return
  }
  let k0 = claim(r, k)
  if k0 < 0 {
    return
  }
  let p = ld(r, R_RING) + k0 * SLOT
  fill(r, k0, k, unwind.prof_walk(s, uc, p + 8, DEPTH, ld(r, R_TLO), ld(r, R_THI)))
}

/// The periods of CPU the thread with profiler record s used since its
/// last sample (Linux; 1 elsewhere), the rest carried to its next one:
/// ITIMER_PROF's signal reaches a busy thread less often than its rate
/// when several threads run (0.69 at 1 kHz with four on linux/arm64;
/// about 1,000 a second at most, gotchas/xo-prof-macos-undercounts-
/// samples.md), so each sample stands for the time its thread used. A
/// thread's first sample counts one period.
fn weight(r: Int, s: Int) -> Int {
  match target.os {
    TargetOs.Linux => {}
    TargetOs.Darwin | TargetOs.Windows | TargetOs.Wasi => return 1
  }
  let e = ld(r, R_WTS) + (s - ld(r, R_POOL)) / unwind.PROF_RECORD * WT
  // CLOCK_THREAD_CPUTIME_ID
  if linux.clock_gettime(3, e + 16) != 0 {
    return 1
  }
  let now = ld(e, 16) * 1000000000 + ld(e, 24)
  let last = ld(e, 0)
  st(e, 0, now)
  if last == 0 {
    return 1
  }
  let per = 1000000000 / ld(r, R_HZ)
  let acc = ld(e, 8) + now - last
  var k = acc / per
  st(e, 8, acc - k * per)
  if k > MAX_K {
    k = MAX_K
  }
  k
}

/// Claims k slots of the ring: the first one's index, or -1 when the
/// ring is full (the k counted lost).
fn claim(r: Int, k: Int) -> Int {
  let k0 = rt.slot_add[Int](r, R_NEXT / 8, k, ACQ_REL)
  if k0 >= ld(r, R_CAP) {
    let _l = rt.slot_add[Int](r, R_LOST / 8, k, RELAXED)
    return -1
  }
  k0
}

/// Completes k claimed slots from k0 whose first holds a walk of n
/// frames: the stack copied into the others (those past the ring's end
/// counted lost), each count last, since a slot read with 0 is skipped.
fn fill(r: Int, k0: Int, k: Int, n: Int) {
  let cap = ld(r, R_CAP)
  let p = ld(r, R_RING) + k0 * SLOT
  var j = 1
  while j < k && k0 + j < cap {
    let q = p + j * SLOT
    rt.mem_copy(q + 8, p + 8, 8 * n)
    rt.slot_store[Int](q, 0, n, 2)
    j += 1
  }
  rt.slot_store[Int](p, 0, n, 2)
  if k0 + k > cap {
    let _l = rt.slot_add[Int](r, R_LOST / 8, k0 + k - cap, RELAXED)
  }
}

/// Stops the profilers and writes their raw profile (entry.xo at main's
/// end, cabi.xo prof_finish from os.proc.exit). Once. The file is
/// decision 0240's container (the XORAW1 header, kind 2), its sections
/// the CPU and the heap profile with their locations already named
/// (functions, files, lines: this binary's symbols and DWARF, which the
/// fault traceback keeps anyway); `xo prof FILE` writes the pprof files
/// and the text summaries from it (decision 0245). XO_PROF_OUT names it
/// (default xo-prof.xoraw, %p the process id); XO_PROF_QUIET=1 (xo run
/// and xo test, which convert it themselves) drops the line it prints.
pub fn finish() {
  let rc = stop_cpu()
  let rh = heapprof.stop()
  if rc == 0 && rh == 0 {
    return
  }
  // the CPU samples the full buffer dropped, read before build_raw
  let dropped = if rc != 0 { ld(rc, R_LOST) } else { 0 }
  let cap = if rc != 0 { ld(rc, R_CAP) } else { 0 }
  let raw = build_raw(rc, rh)
  let nh = raw.nh
  let nc = raw.nc
  let out0 = process.env_real("XO_PROF_OUT")
  let out = expand_pid(if out0.is_empty() || out0[0].is_empty() { "xo-prof.xoraw" } else { out0[0] })
  let ok = write_file(out, raw.data)
  let quiet = process.env_real_at("XO_PROF_QUIET") != 0
  if !ok {
    stdio.eprint("xo profile: could not write ${out} (it must not exist: a profile never overwrites a file)", true)
  } else if !quiet {
    var what = ""
    if rc != 0 {
      what = "${nc} samples"
      if dropped > 0 {
        // a full profile is a prefix of the run, never silently short
        what = "${what} (${dropped} more dropped: the profile holds ${cap}; lower XO_PROF_HZ for a run this long)"
      }
    }
    if rh != 0 {
      what = if what.is_empty() { "${nh} heap samples" } else { "${what} and ${nh} heap samples" }
    }
    stdio.eprint("xo profile: ${what} in ${out} (`xo prof ${out}` writes the pprof files and summaries)", true)
  }
}

/// A raw profile (build_raw): the container and its sample counts.
struct Raw {
  data: Bytes
  nc: Int
  nh: Int
}

/// The container of the CPU profile record rc and the heap profile rh
/// (0: none), as finish writes it and std/debug serves it.
fn build_raw(rc: Int, rh: Int) -> Raw {
  var b = BytesBuilder.new()
  b.write("XORAW1".bytes())
  b.write_byte(UInt8(0))
  b.write_byte(UInt8(0))
  put(b, 2 | (1).wrapping_shl(32))
  put(b, if rc != 0 { ld(rc, R_T0) } else { 0 })
  put(b, 0)
  put(b, if rc != 0 { ld(rc, R_LOST) + ld(rc, R_NOREC) } else { 0 })
  put(b, if rc != 0 { ld(rc, R_HZ) } else { 0 })
  let os_id = match target.os {
    TargetOs.Linux => 1
    TargetOs.Darwin => 2
    TargetOs.Windows => 3
    TargetOs.Wasi => 4
  }
  let arch_id = match target.arch {
    TargetArch.Arm64 => 1
    TargetArch.Amd64 => 2
    TargetArch.Wasm32 => 3
  }
  put(b, os_id | arch_id.wrapping_shl(8))
  put(b, 0)
  var nh = 0
  var nc = 0
  if rh != 0 {
    nh = heap_section(b, rh)
  }
  if rc != 0 {
    nc = cpu_section(b, rc)
  }
  Raw{data: b.freeze(), nc: nc, nh: nh}
}

/// Stops the CPU profile: its record, or 0 when it was off.
fn stop_cpu() -> Int {
  let w = rt.static_word(W_PROF)
  let r = rt.slot_swap[Int](w, 0, 0, 4)
  if r == 0 {
    return 0
  }
  if ld(r, R_LIVE) != 0 {
    // a live profile (std/debug serves it): running at exit, it ends
    // there with no file; stopped already, its profile was served
    if rt.slot_swap[Int](r, R_ON / 8, 0, 4) != 0 {
      disarm()
    }
    return 0
  }
  if ld(r, R_WIN) != 0 {
    // the sampler sees the switch off at its next tick and returns
    let th = ld(r, R_WTHREAD)
    let _w = sys_windows.WaitForSingleObject(th, 4294967295)
    let _c = sys_windows.CloseHandle(th)
    win_close(ld(r, R_WIN))
  } else if ld(r, R_MAC) != 0 {
    // the sampler is between ticks or finishing one: the switch off, it
    // takes no sample after its count of samples in flight reads 0
    let _o = rt.slot_swap[Int](r, R_ON / 8, 0, 4)
    while rt.slot_load[Int](r, R_INFLIGHT / 8, 4) != 0 {
      let _u = sys_darwin.usleep(50)
    }
  } else {
    disarm()
  }
  st(r, R_DUR, sysio.mono_ns() - ld(r, R_T0))
  r
}

// The raw profile's words and texts (xo prof's prof.xo reads them):
// little endian 64 bit words; a text is its length, then its bytes.

fn put(var b: BytesBuilder, v: Int) {
  for i in 0..8 {
    b.write_byte(UInt8(v.shr_logical(8 * i) & 255))
  }
}

fn put_text(var b: BytesBuilder, s: Str) {
  put(b, s.len())
  b.write(s.bytes())
}

/// A section: its type, its length, then its payload.
fn put_section(var b: BytesBuilder, typ: Int, payload: Bytes) {
  put(b, typ)
  put(b, payload.len())
  b.write(payload)
}

/// The locations of a profile, named (resolve).
struct Table {
  /// the pcs, sorted
  locs: List[Int]
  /// each location's frames, innermost first (the callees inlined there,
  /// then the function holding it): a function's index in names, its
  /// file, its line
  cf: List[List[Int]]
  cfile: List[List[Str]]
  cline: List[List[Int]]
  names: List[Str]
}

/// The frames of each location in locs (sorted; fr its functions'
/// indexes in names, which inlined callees are added to): the callees
/// inlined at its call (dwline inline_chain, .debug_info), then its
/// function. xo_entry (LLVM
/// inlines the program's main into it) is main.
fn resolve(lines: dwline.Lines, locs: List[Int], fr: List[Int], var names: List[Str]) -> Table {
  var cf: List[List[Int]] = []
  var cfile: List[List[Str]] = []
  var cline: List[List[Int]] = []
  for (li, pc) in locs.indexed() {
    let (fs, pf, pl) = dwline.inline_chain(lines, pc - 1, names[fr[li]])
    var fi: List[Int] = []
    var ff: List[Str] = []
    var ll: List[Int] = []
    for fm in fs {
      fi.push(name_index(fm.name, names))
      ff.push(fm.file)
      ll.push(fm.line)
    }
    fi.push(fr[li])
    ff.push(pf)
    ll.push(pl)
    cf.push(fi)
    cfile.push(ff)
    cline.push(ll)
  }
  for i in 0..names.len() {
    if names[i] == "xo_entry" {
      names[i] = "main"
    }
  }
  Table{locs: locs, cf: cf, cfile: cfile, cline: cline, names: names}
}

/// A Table: its locations (each pc, then its frames: a function's index,
/// its line, its file), then the names.
fn put_table(var b: BytesBuilder, t: Table) {
  put(b, t.locs.len())
  for (i, pc) in t.locs.indexed() {
    put(b, pc)
    put(b, t.cf[i].len())
    for (q, f) in t.cf[i].indexed() {
      put(b, f)
      put(b, t.cline[i][q])
      put_text(b, t.cfile[i][q])
    }
  }
  put(b, t.names.len())
  for n in t.names {
    put_text(b, n)
  }
}

/// Section types (keep in step with compiler/xo prof.xo).
const PS_CPU = 16
const PS_HEAP = 17

/// path with each %p as the process id (a profile per process of xo
/// test --profile).
pub fn expand_pid(path: Str) -> Str {
  if !path.contains("%p") {
    return path
  }
  let pid = match target.os {
    TargetOs.Darwin => Int(sys_darwin.getpid())
    TargetOs.Linux => {
      let nr = match target.arch {
        TargetArch.Amd64 => 39
        TargetArch.Arm64 | TargetArch.Wasm32 => 172
      }
      rt.sys6(nr, 0, 0, 0, 0, 0, 0)
    }
    TargetOs.Windows | TargetOs.Wasi => 0
  }
  path.replace("%p", "${pid}")
}

// ---------------------------------------------------------------------------
// Symbols

/// The program's functions, sorted by address: their starts, ends (the
/// next start, or the text's end), and names (demangled).
struct Syms {
  starts: List[Int]
  ends: List[Int]
  names: List[Str]
}

/// The starts (sorted) and demangled names of the program's functions
/// within [lo, hi), for windows --race's reports (racesym.xo).
pub fn func_symbols(lo: Int, hi: Int) -> (List[Int], List[Str]) {
  let s = symbols(lo, hi)
  (s.starts, s.names)
}

/// The program's function symbols within [lo, hi).
fn symbols(lo: Int, hi: Int) -> Syms {
  var addrs: List[Int] = []
  var names: List[Str] = []
  match target.os {
    TargetOs.Darwin => macho_symbols(lo, hi, addrs, names)
    TargetOs.Windows => coff_symbols(lo, hi, addrs, names)
    TargetOs.Linux | TargetOs.Wasi => elf_symbols(lo, hi, addrs, names)
  }
  // sort by address: (offset from the lowest symbol << 24) | index. Not
  // from lo: trace_text passes 1, and the offset of a Linux PIE's address
  // (about 2^47) shifted by 24 wraps; the order held only while every
  // symbol had the same bits above bit 39
  var low = 0
  for (i, a) in addrs.indexed() {
    if i == 0 || a < low {
      low = a
    }
  }
  var keys: List[Int] = []
  for i in 0..addrs.len() {
    if i < 16777216 {
      keys.push((addrs[i] - low).wrapping_shl(24) | i)
    }
  }
  keys = keys.sort()
  var starts: List[Int] = []
  var sn: List[Str] = []
  var last = -1
  for k in keys {
    let i = k & 16777215
    if addrs[i] == last {
      continue
    }
    last = addrs[i]
    starts.push(addrs[i])
    sn.push(demangle(names[i]))
  }
  var ends: List[Int] = []
  for i in 0..starts.len() {
    ends.push(if i + 1 < starts.len() { starts[i + 1] } else { hi })
  }
  Syms{starts: starts, ends: ends, names: sn}
}

/// The index of the function holding pc, or -1.
fn sym_of(s: Syms, pc: Int) -> Int {
  var a = 0
  var b = s.starts.len()
  while a < b {
    let m = (a + b) / 2
    if s.starts[m] <= pc {
      a = m + 1
    } else {
      b = m
    }
  }
  let i = a - 1
  if i < 0 || pc >= s.ends[i] {
    return -1
  }
  i
}

/// The C string at p.
fn cstr(p: Int) -> Str {
  var n = 0
  while rt.mem_load(p, n, 1) != 0 && n < 4096 {
    n += 1
  }
  var b = BytesBuilder.with_capacity(n)
  for i in 0..n {
    b.write_byte(UInt8(rt.mem_load(p, i, 1)))
  }
  b.freeze().to_str() ?? ""
}

/// macOS: the N_SECT symbols of the program's image (its LC_SYMTAB, read
/// through __LINKEDIT, which is mapped) whose address is in the text.
fn macho_symbols(lo: Int, hi: Int, var addrs: List[Int], var names: List[Str]) {
  let mh = sys_darwin._dyld_get_image_header(0)
  if mh == 0 || rt.mem_load(mh, 0, 4) != 4277009103 {
    return
  }
  let ncmds = rt.mem_load(mh, 16, 4)
  var lc = mh + 32
  var slide = 0
  var le_vm = 0
  var le_off = 0
  var symoff = 0
  var nsyms = 0
  var stroff = 0
  for _ in 0..ncmds {
    let cmd = rt.mem_load(lc, 0, 4)
    if cmd == 25 {
      // LC_SEGMENT_64: segname at 8 (16 bytes), vmaddr 24, fileoff 40
      let a = ld(lc, 8)
      let b = ld(lc, 16)
      if a == 92738097012575 && b == 0 {
        // "__TEXT"
        slide = mh - ld(lc, 24)
      } else if a == 4919420967581409119 && b == 21577 {
        // "__LINKEDIT"
        le_vm = ld(lc, 24)
        le_off = ld(lc, 40)
      }
    } else if cmd == 2 {
      // LC_SYMTAB: symoff 8, nsyms 12, stroff 16, strsize 20
      symoff = rt.mem_load(lc, 8, 4)
      nsyms = rt.mem_load(lc, 12, 4)
      stroff = rt.mem_load(lc, 16, 4)
    }
    lc += rt.mem_load(lc, 4, 4)
  }
  if le_vm == 0 || nsyms == 0 {
    return
  }
  let base = le_vm + slide - le_off
  let tab = base + symoff
  let strs = base + stroff
  for i in 0..nsyms {
    // nlist_64: n_strx 0 (4), n_type 4, n_sect 5, n_desc 6, n_value 8
    let e = tab + 16 * i
    let ty = rt.mem_load(e, 4, 1)
    if (ty & 224) != 0 || (ty & 14) != 14 {
      continue
    }
    let a = ld(e, 8) + slide
    if a < lo || a >= hi {
      continue
    }
    var name = cstr(strs + rt.mem_load(e, 0, 4))
    if name.len() > 0 && name.bytes()[0] == 95 {
      name = name[1..name.len()]
    }
    // the image's header symbol sits at the start of __text: with the
    // function symbols gone (-s, or a strip after the link) it is the
    // nearest symbol for every pc, and a traceback printed it as every
    // frame (2026-10-25)
    if name == "_mh_execute_header" {
      continue
    }
    addrs.push(a)
    names.push(name)
  }
}

/// Linux: the STT_FUNC symbols of .symtab (else .dynsym) of the program's
/// file (/proc/self/exe), placed by the load bias (AT_PHDR against
/// PT_PHDR).
fn elf_symbols(lo: Int, hi: Int, var addrs: List[Int], var names: List[Str]) {
  let data = read_file("/proc/self/exe")
  if data.len() < 64 {
    return
  }
  let f = raw.bytes_addr(data)
  let ph = linux.auxval(linux.AT_PHDR)
  let phn = linux.auxval(linux.AT_PHNUM)
  var bias = 0
  for i in 0..phn {
    let p = ph + 56 * i
    if rt.mem_load(p, 0, 4) == 6 {
      bias = ph - ld(p, 16)
    }
  }
  // Elf64_Ehdr: e_shoff 40, e_shentsize 58, e_shnum 60
  let shoff = ld(f, 40)
  let shn = rt.mem_load(f, 60, 2)
  if shoff <= 0 || shoff + 64 * shn > data.len() {
    return
  }
  for want in [2, 11] {
    for i in 0..shn {
      // Elf64_Shdr: sh_type 4, sh_offset 24, sh_size 32, sh_link 40
      let sh = f + shoff + 64 * i
      if rt.mem_load(sh, 4, 4) != want {
        continue
      }
      let off = ld(sh, 24)
      let size = ld(sh, 32)
      let link = rt.mem_load(sh, 40, 4)
      if link >= shn || off + size > data.len() {
        continue
      }
      let strsh = f + shoff + 64 * link
      let stro = ld(strsh, 24)
      for j in 0..size / 24 {
        // Elf64_Sym: st_name 0 (4), st_info 4, st_value 8
        let e = f + off + 24 * j
        if (rt.mem_load(e, 4, 1) & 15) != 2 {
          continue
        }
        let a = ld(e, 8) + bias
        if a < lo || a >= hi {
          continue
        }
        addrs.push(a)
        names.push(cstr(f + stro + rt.mem_load(e, 0, 4)))
      }
    }
    if addrs.len() > 0 {
      return
    }
  }
}

/// The bytes of the file at path (empty when it cannot be read).
fn read_file(path: Str) -> Bytes {
  let fd = linux.open(path, 524288, 0)
  if fd < 0 {
    return b""
  }
  let (stat, e) = linux.fstat(fd)
  if e != 0 || stat.size <= 0 {
    let _c = linux.close(fd)
    return b""
  }
  var b = BytesBuilder.with_capacity(stat.size)
  let buf = rt.heap_large(65536)
  while true {
    let r = linux.read_at(fd, buf, 65536)
    if r == -4 {
      continue
    }
    if r <= 0 {
      break
    }
    for i in 0..r {
      b.write_byte(UInt8(rt.mem_load(buf, i, 1)))
    }
  }
  rt.heap_release(buf - 8)
  let _c = linux.close(fd)
  b.freeze()
}

/// An Xo function's symbol as its name: the arm64 backend's (gen.xo
/// fname: `xo_f_`, `_` doubled, any other byte not a letter or digit `_`
/// and two hex digits), the LLVM backend's (`x.` and the name), and a C
/// ABI export's (`xo_x_` and the name); another symbol as it is.
fn demangle(s: Str) -> Str {
  let b = s.bytes()
  if b.len() > 2 && s[0..2] == "x." {
    return s[2..s.len()]
  }
  if b.len() > 5 && s[0..5] == "xo_x_" {
    return s[5..s.len()]
  }
  if b.len() < 6 || s[0..5] != "xo_f_" {
    return s
  }
  var o = BytesBuilder.with_capacity(b.len())
  var i = 5
  while i < b.len() {
    let c = Int(b[i])
    if c == 95 && i + 1 < b.len() && Int(b[i + 1]) == 95 {
      o.write_byte(UInt8(95))
      i += 2
    } else if c == 95 && i + 2 < b.len() && hexv(Int(b[i + 1])) >= 0 && hexv(Int(b[i + 2])) >= 0 {
      o.write_byte(UInt8(16 * hexv(Int(b[i + 1])) + hexv(Int(b[i + 2]))))
      i += 3
    } else {
      o.write_byte(UInt8(c))
      i += 1
    }
  }
  o.freeze().to_str() ?? s
}

fn hexv(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return c - 87
  }
  -1
}

// ---------------------------------------------------------------------------
// The profile

/// The CPU profile's section into b (finish): its rate, period, duration
/// and lost samples, each sample's locations (pcs, innermost first), and
/// the locations named; the number of samples.
fn cpu_section(var b: BytesBuilder, r: Int) -> Int {
  let ring = ld(r, R_RING)
  let hz = ld(r, R_HZ)
  var n = ld(r, R_NEXT)
  if n > ld(r, R_CAP) {
    n = ld(r, R_CAP)
  }
  var samples: List[List[Int]] = []
  for k in 0..n {
    let p = ring + k * SLOT
    let d = ld(p, 0)
    if d <= 0 {
      continue
    }
    var st: List[Int] = []
    for j in 0..d {
      st.push(frame_pc(p, j))
    }
    samples.push(st)
  }
  var o = BytesBuilder.new()
  put(o, hz)
  put(o, 1000000000 / hz)
  put(o, ld(r, R_DUR))
  put(o, ld(r, R_LOST) + ld(r, R_NOREC))
  put(o, samples.len())
  for st in samples {
    put_stack(o, st)
  }
  put_table(o, table_of(samples, ld(r, R_TLO), ld(r, R_THI)))
  put_section(b, PS_CPU, o.freeze())
  samples.len()
}

/// The index of function name in names, added once (an inlined
/// callee's: the same as its own symbol's when it also has one).
fn name_index(name: Str, var names: List[Str]) -> Int {
  for (i, n) in names.indexed() {
    if n == name {
      return i
    }
  }
  names.push(name)
  names.len() - 1
}

/// The function of pc: the program's symbol holding it, else the name of
/// what holds it outside the program (added to names once).
fn func_of(syms: Syms, pc: Int, var names: List[Str]) -> Int {
  let f = sym_of(syms, pc)
  if f >= 0 {
    return f
  }
  let name = outside_name(pc)
  var i = syms.names.len()
  while i < names.len() {
    if names[i] == name {
      return i
    }
    i += 1
  }
  names.push(name)
  names.len() - 1
}

/// The name of a pc outside the program: macOS, dladdr's symbol (else
/// its image's file name); Linux, the file name of the shared object
/// holding it ([vdso] for the kernel's); "?" when nothing holds it.
fn outside_name(pc: Int) -> Str {
  match target.os {
    TargetOs.Darwin => {
      // Dl_info: dli_fname 0, dli_fbase 8, dli_sname 16, dli_saddr 24
      let info = rt.heap_large(32)
      rt.mem_set(info, 0, 32)
      var name = "?"
      if Int(sys_darwin.dladdr(pc, info)) != 0 {
        if ld(info, 16) != 0 {
          name = cstr(ld(info, 16))
          if name.len() > 0 && name.bytes()[0] == 95 {
            name = name[1..name.len()]
          }
        } else if ld(info, 0) != 0 {
          name = "[${base_name(cstr(ld(info, 0)))}]"
        }
      }
      rt.heap_release(info - 8)
      name
    }
    TargetOs.Linux => linux_object_name(pc)
    TargetOs.Windows | TargetOs.Wasi => "?"
  }
}

/// The last element of a path.
fn base_name(p: Str) -> Str {
  let b = p.bytes()
  var i = b.len()
  while i > 0 && Int(b[i - 1]) != 47 {
    i -= 1
  }
  p[i..p.len()]
}

/// Linux: "[name]" of the shared object whose PT_LOAD holds pc (the
/// dynamic loader's link_map, through the program's DT_DEBUG), else "?".
fn linux_object_name(pc: Int) -> Str {
  let ph = linux.auxval(linux.AT_PHDR)
  let n = linux.auxval(linux.AT_PHNUM)
  if ph == 0 {
    return "?"
  }
  var bias = 0
  var dynv = 0
  for i in 0..n {
    let p = ph + 56 * i
    let t = rt.mem_load(p, 0, 4)
    if t == 6 {
      bias = ph - ld(p, 16)
    } else if t == 2 {
      dynv = ld(p, 16)
    }
  }
  if dynv == 0 {
    return "?"
  }
  var d = dynv + bias
  var dbg = 0
  while ld(d, 0) != 0 {
    if ld(d, 0) == 21 {
      dbg = ld(d, 8)
    }
    d += 16
  }
  if dbg == 0 {
    return "?"
  }
  // struct r_debug: r_version, r_map; struct link_map: l_addr, l_name,
  // l_ld, l_next
  var lm = ld(dbg, 8)
  var left = 4096
  while lm != 0 && left > 0 {
    left -= 1
    let base = ld(lm, 0)
    if base != 0 && rt.mem_load(base, 0, 4) == 1179403647 {
      // Elf64_Ehdr: e_phoff 32, e_phnum 56
      let oph = base + ld(base, 32)
      let on = rt.mem_load(base, 56, 2)
      for i in 0..on {
        let p = oph + 56 * i
        if rt.mem_load(p, 0, 4) == 1 {
          let a = base + ld(p, 16)
          if pc >= a && pc < a + ld(p, 40) {
            let nm = if ld(lm, 8) != 0 { cstr(ld(lm, 8)) } else { "" }
            return if nm.is_empty() { "[vdso]" } else { "[${base_name(nm)}]" }
          }
        }
      }
    }
    lm = ld(lm, 24)
  }
  "?"
}

/// Frame j of the sample at p as a location: a return address, or for
/// the leaf (j 0) the interrupted pc plus 1.
fn frame_pc(p: Int, j: Int) -> Int {
  ld(p, 8 + 8 * j) + (if j == 0 { 1 } else { 0 })
}

/// The index of location pc in the sorted locs (its id is that plus 1).
fn loc_index(locs: List[Int], pc: Int) -> Int {
  var a = 0
  var b = locs.len()
  while a < b {
    let m = (a + b) / 2
    if locs[m] < pc {
      a = m + 1
    } else {
      b = m
    }
  }
  a
}

/// Writes data to a new file at path (mode 0600): false when anything
/// is there already, a symbolic link too (decision 0238's gating: a
/// profile never writes through a file it did not create).
pub fn write_file(path: Str, data: Bytes) -> Bool {
  match target.os {
    TargetOs.Linux => {
      // O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, mode 0600: a
      // file or a symbolic link already there is not written through
      // (O_NOFOLLOW is 0100000 on arm64, 0400000 on x86_64)
      let nofollow = match target.arch {
        TargetArch.Amd64 => 131072
        TargetArch.Arm64 | TargetArch.Wasm32 => 32768
      }
      let fd = linux.open(path, 1 | 64 | 128 | nofollow | 524288, 384)
      if fd < 0 {
        return false
      }
      let w = linux.write_all(fd, data)
      let _c = linux.close(fd)
      w == 0
    }
    TargetOs.Darwin => {
      var z = BytesBuilder.with_capacity(path.len() + 1)
      z.write(path.bytes())
      z.write_byte(UInt8(0))
      // O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, mode 0600
      let fd = Int(sys_darwin.open(z.freeze(), 1 | 512 | 2048 | 256 | 16777216, 384))
      if fd < 0 {
        return false
      }
      var off = 0
      let a = raw.bytes_addr(data)
      var ok = true
      while off < data.len() {
        let w = sys_darwin.write(fd, a + off, raw.io_len(data.len() - off))
        if w <= 0 {
          ok = false
          break
        }
        off += w
      }
      let _c = sys_darwin.close(fd)
      ok
    }
    TargetOs.Windows => {
      // kind 4: CREATE_NEW (an existing file or link is not written
      // through), read and write; mode 0600 keeps it writable
      let h = windows.open_kind(path, 4, 384)
      if h < 0 {
        return false
      }
      let w = windows.write_all(h, data)
      let _c = windows.close(h)
      w == 0
    }
    TargetOs.Wasi => false
  }
}

// ---------------------------------------------------------------------------
// Tracebacks (fault.xo, XO_TRACEBACK)

/// The traceback of a fault from the return addresses of its frames,
/// innermost first: "traceback:" and a line per frame, `  NAME
/// (FILE:LINE)` (the line from the DWARF line tables when the program
/// has them), from the first frame past the runtime's own (fault.,
/// cabi.fault, unwind.) to the program's main (or xo_entry, which LLVM
/// inlines main into). A build with no function symbols (`-s`, or a strip
/// after the link) prints `traceback: (no function symbols: built with -s,
/// or stripped)` instead: nothing could name its frames.
pub fn trace_text(pcs: List[Int]) -> Str { trace_text_at(pcs, []) }

/// trace_text with each frame's variables under it (decision 0268,
/// XO_TRACEBACK=locals): regs[i] the address of frame i's registers
/// (fault.xo trace_regs); none, or a program without DWARF, prints the
/// frames alone (with the reason).
pub fn trace_text_at(pcs: List[Int], regs: List[Int]) -> Str {
  let syms = symbols(1, 9223372036854775807)
  let lines = dwline.load(1, 9223372036854775807)
  var names = syms.names
  // the symbol table's own entries: func_of appends a name at and past
  // this index for a pc no symbol covers
  let nsyms = names.len()
  var b = StrBuilder.new()
  b.write("traceback:\n")
  var vars = dwline.Vars{}
  if !regs.is_empty() {
    vars = dwline.vars_load()
    if !vars.why.is_empty() {
      b.write("  (locals unavailable: ${vars.why})\n")
    }
  }
  let have = dwline.callee_saved()
  let sp_reg = match target.arch {
    TargetArch.Amd64 => 7
    TargetArch.Arm64 | TargetArch.Wasm32 => 31
  }
  var started = false
  for (fi, pc) in pcs.indexed() {
    // a return address: its call is at pc - 1
    let f = func_of(syms, pc - 1, names)
    let name = names[f]
    // a build with no function symbols (-s, or a strip after the link):
    // the first frame past the runtime's own has no symbol at all, so no
    // frame can be named (2026-10-25)
    if !started && f >= nsyms {
      return "traceback: (no function symbols: built with -s, or stripped)\n"
    }
    // (windows: the Win64 thunks the trace and the fault went through,
    // xo_w64_RtlCaptureContext and xo_w64_xo_callc2)
    if !started && (name.starts_with("fault.") || name.starts_with("fault_") || name.starts_with("cabi.fault") || name.starts_with("unwind.") || name.starts_with("xo_fault") || name.starts_with("xo_w64_")) {
      continue
    }
    started = true
    // the callees inlined at the call, innermost first, then the
    // function itself at the outermost call's line
    let (fs, pf, pl) = dwline.inline_chain(lines, pc - 1, name)
    let shown = if name == "xo_entry" { "main" } else { name }
    // the variables, each under its inlined call's frame (fs[i]), or
    // the function's (fs.len())
    var under: List[List[Str]] = []
    for _ in 0..fs.len() + 1 {
      under.push([])
    }
    if fi < regs.len() && vars.why.is_empty() {
      // the frame's CFA: the next frame's sp
      let cfa = if fi + 1 < regs.len() { rt.mem_load(regs[fi + 1], 8 * sp_reg, 8) } else { 0 }
      for (inl, depth, l, decl) in dwline.frame_vars(vars, pc - 1, dwline.Regs{at: regs[fi], have: have, cfa: cfa}) {
        let at = inlined_frame(fs, shown, inl, depth)
        // a local declared at or after its frame's line has no value
        // yet (`let r = deep(k)` faulting in deep): left out, not
        // <unavailable> (Intel field report, round 2, on 0.26.0)
        let fline = if at >= 0 && at < fs.len() { fs[at].line } else { pl }
        if at >= 0 && !(decl > 0 && fline > 0 && decl >= fline) {
          under[at].push(l)
        }
      }
    }
    for (i, fm) in fs.indexed() {
      if fm.file.is_empty() {
        b.write("  ${fm.name} [inlined]\n")
      } else {
        b.write("  ${fm.name} (${base_name(fm.file)}:${fm.line}) [inlined]\n")
      }
      for l in under[i] {
        b.write("      ${l}\n")
      }
    }
    if pf.is_empty() {
      b.write("  ${shown}\n")
    } else {
      b.write("  ${shown} (${base_name(pf)}:${pl})\n")
    }
    for l in under[fs.len()] {
      b.write("      ${l}\n")
    }
    // the program's main (LLVM inlines it into xo_entry)
    if name == "main" || name == "xo_entry" {
      break
    }
  }
  b.freeze()
}

/// The frame a variable of the inlined call of function inl, depth
/// inlined calls deep, prints under: the index in fs (innermost first)
/// of that call, fs.len() for the function itself (inl "": its own
/// variables; LLVM inlines main into xo_entry, shown as main), -1 for
/// an inlined call not on the chain (one that ended before the fault,
/// whose variable a register still holds).
fn inlined_frame(fs: List[dwline.Frame], shown: Str, inl: Str, depth: Int) -> Int {
  if inl.is_empty() || depth == 0 {
    return fs.len()
  }
  // by depth first: the outermost inlined call (depth 1) is fs's last
  let j = fs.len() - depth
  if j >= 0 && j < fs.len() && same_fn(fs[j].name, inl) {
    return j
  }
  for (i, fm) in fs.indexed() {
    if same_fn(fm.name, inl) {
      return i
    }
  }
  if same_fn(shown, inl) {
    return fs.len()
  }
  -1
}

/// Whether two names of a function are the same, one maybe qualified by
/// its module (`main.pick`, `pick`).
fn same_fn(a: Str, b: Str) -> Bool {
  a == b || a.ends_with(".${b}") || b.ends_with(".${a}")
}

// ---------------------------------------------------------------------------
// The heap profile's writer

/// The heap profile's section into b (finish; r stopped): its rate, lost
/// and untracked samples, each sample's locations (the allocator's own
/// frames too: xo prof leaves them off) with its size and whether it was
/// freed, and the locations named; the number of samples.
fn heap_section(var b: BytesBuilder, r: Int) -> Int {
  let n = heapprof.count(r)
  let slots = heapprof.slots(r)
  var samples: List[List[Int]] = []
  var o = BytesBuilder.new()
  put(o, heapprof.rate(r))
  put(o, heapprof.lost(r))
  put(o, heapprof.unset(r))
  var body = BytesBuilder.new()
  for k in 0..n {
    let p = slots + k * heapprof.SLOT
    let d = ld(p, 0)
    if d == 0 {
      continue
    }
    var st: List[Int] = []
    for j in 0..d {
      st.push(ld(p, 8 + 8 * j))
    }
    put_stack(body, st)
    put(body, ld(p, heapprof.S_SIZE))
    put(body, ld(p, heapprof.S_FREED))
    samples.push(st)
  }
  put(o, samples.len())
  o.write(body.freeze())
  let (lo, hi) = heapprof.text(r)
  put_table(o, table_of(samples, lo, hi))
  put_section(b, PS_HEAP, o.freeze())
  samples.len()
}

fn put_stack(var b: BytesBuilder, st: List[Int]) {
  put(b, st.len())
  for pc in st {
    put(b, pc)
  }
}

/// The locations of samples' pcs, named from the program's symbols in
/// [lo, hi) and its DWARF (each read as a return address, whose call is
/// at pc - 1: a leaf's interrupted pc is kept plus 1, frame_pc, as Go's
/// profiles do; a pc outside the program is named by what holds it, a C
/// library function or the dynamic loader).
fn table_of(samples: List[List[Int]], lo: Int, hi: Int) -> Table {
  let syms = symbols(lo, hi)
  let lines = dwline.load(lo, hi)
  var all: List[Int] = []
  for st in samples {
    for pc in st {
      all.push(pc)
    }
  }
  all = all.sort()
  var locs: List[Int] = []
  for pc in all {
    if locs.len() == 0 || locs[locs.len() - 1] != pc {
      locs.push(pc)
    }
  }
  var names = syms.names
  var fr: List[Int] = []
  for pc in locs {
    fr.push(func_of(syms, pc - 1, names))
  }
  resolve(lines, locs, fr, names)
}

// ---------------------------------------------------------------------------
// macOS: the sampler thread. ITIMER_PROF's SIGPROF reaches a process on
// macOS far less often than its rate (a C program with an empty handler
// got 16% of its ticks at 1 kHz, 5% at 10 kHz;
// gotchas/xo-prof-macos-undercounts-samples.md), so a thread of the
// profiler's own wakes every 1/hz s, reads each other thread's CPU time
// (thread_info), and walks a thread that used at least one period of
// CPU since its last sample, suspended (thread_suspend, its registers by
// thread_get_state): one sample for each whole period it used, the rest
// carried to its next tick, so the samples add up to the program's CPU
// time at any rate.

/// The sampler's record (byte offsets; mapped): the task's port, the
/// sampler's own thread port, the period in microseconds, the unwind
/// record it walks with, task_threads' array and count, a count word for
/// thread_info and thread_get_state, THREAD_BASIC_INFO (40 bytes), a
/// ucontext whose uc_mcontext points 16 bytes before the thread state
/// (prof_walk reads a signal's ucontext; the thread state is the same
/// words), the thread state (272 bytes), the run this thread samples
/// for, the tick count, and the table of threads seen: DT_N entries of
/// (port, last CPU microseconds, carried microseconds, last tick seen).
const DB_TASK = 0
const DB_ME = 8
const DB_TICK = 16
const DB_UNW = 24
const DB_LIST = 32
const DB_CNT = 40
const DB_ICNT = 44
const DB_INFO = 48
const DB_UC = 96
const DB_STATE = 160
const DB_RUN = 440
const DB_GEN = 448
const DB_TAB = 512
const DT_N = 256
const DB_SIZE = 8704
/// thread_info's THREAD_BASIC_INFO and its count of 32 bit words.
const THREAD_BASIC_INFO = 3
const BASIC_INFO_COUNT = 10
/// The most samples one tick gives a thread (a sampler that slept long).
const MAX_K = 1000

/// Starts the sampler thread for the record r at hz (its ring and text
/// set up; it walks with the pool's first unwind record, which no
/// thread of the program claims: no handler runs on macOS). The first
/// start maps the sampler's record; a later run reuses it.
fn mac_start(r: Int, hz: Int) {
  var d = ld(r, R_MAC)
  if d == 0 {
    d = map(DB_SIZE)
    if d == 0 {
      stdio.eprint("xo profile: no memory for the profile", true)
      return
    }
    st(d, DB_TASK, Int(sys_darwin.task_self_trap()) & 4294967295)
    st(d, DB_UNW, ld(r, R_POOL))
    st(r, R_MAC, d)
  }
  rt.mem_set(d + DB_TAB, 0, DB_SIZE - DB_TAB)
  st(d, DB_TICK, 1000000 / hz)
  st(d, DB_RUN, ld(r, R_RUN))
  // pthread_attr_t (64 bytes) and the pthread_t
  let a = rt.heap_large(80)
  var ok = Int(sys_darwin.pthread_attr_init(a)) == 0
  if ok {
    // PTHREAD_CREATE_DETACHED
    let _d = sys_darwin.pthread_attr_setdetachstate(a, 2)
    ok = Int(sys_darwin.pthread_create(a + 64, a, rt.fn_addr("prof_sampler"), r)) == 0
    let _x = sys_darwin.pthread_attr_destroy(a)
  }
  rt.heap_release(a - 8)
  if !ok {
    stdio.eprint("xo profile: the sampler thread did not start", true)
  }
}

/// The sampler thread (cabi.xo prof_sampler): Windows' or macOS's.
pub fn sampler(r: Int) -> Int {
  if darwin() {
    return mac_sampler(r)
  }
  win_sampler(r)
}

/// macOS's sampler thread: a tick every 1/hz s while its run is the
/// profile's and the switch is on. Each tick counts itself in flight
/// before it reads the switch, as a signal handler does, so a stop that
/// waits for the count to read 0 sees no sample after. It never
/// allocates and takes no lock: a thread it suspends may hold either.
fn mac_sampler(r: Int) -> Int {
  let d = ld(r, R_MAC)
  let run = ld(d, DB_RUN)
  let me = Int(sys_darwin.mach_thread_self()) & 4294967295
  let sw = rt.static_word(W_PROF)
  var gen = 0
  while true {
    let _u = sys_darwin.usleep(ld(d, DB_TICK))
    let _in = rt.slot_add[Int](r, R_INFLIGHT / 8, 1, 4)
    let on = rt.slot_load[Int](sw, 0, 4) == r && rt.slot_load[Int](r, R_ON / 8, 4) != 0 && rt.slot_load[Int](r, R_RUN / 8, 4) == run
    if on {
      gen += 1
      mac_tick(r, d, me, gen)
    }
    let _out = rt.slot_add[Int](r, R_INFLIGHT / 8, -1, 4)
    if !on {
      break
    }
  }
  let _p = sys_darwin.mach_port_deallocate(ld(d, DB_TASK), me)
  0
}

/// One tick: every thread of the task but the sampler.
fn mac_tick(r: Int, d: Int, me: Int, gen: Int) {
  let task = ld(d, DB_TASK)
  st(d, DB_LIST, 0)
  rt.mem_store(d, DB_CNT, 0, 4)
  if Int(sys_darwin.task_threads(task, d + DB_LIST, d + DB_CNT)) != 0 {
    return
  }
  let list = ld(d, DB_LIST)
  let n = rt.mem_load(d, DB_CNT, 4)
  for i in 0..n {
    let t = rt.mem_load(list, 4 * i, 4)
    if t != me {
      mac_sample(r, d, t, gen)
    }
    let _p = sys_darwin.mach_port_deallocate(task, t)
  }
  if list != 0 {
    let _v = sys_darwin.vm_deallocate(task, list, 4 * n)
  }
}

/// The table entry of thread port t, taken on first sight (its last CPU
/// time -1) from a free entry or one no tick has seen for two ticks (its
/// thread ended); 0 when the table is full.
fn mac_entry(d: Int, t: Int, gen: Int) -> Int {
  var free = 0
  for i in 0..DT_N {
    let e = d + DB_TAB + 32 * i
    let id = ld(e, 0)
    if id == t && ld(e, 24) != 0 {
      return e
    }
    if free == 0 && (ld(e, 24) == 0 || ld(e, 24) < gen - 1) {
      free = e
    }
  }
  if free != 0 {
    st(free, 0, t)
    st(free, 8, -1)
    st(free, 16, 0)
    st(free, 24, gen)
  }
  free
}

/// Samples thread t for each whole period of CPU it used since its last
/// tick: one walk while it is suspended, the stack written that many
/// times.
fn mac_sample(r: Int, d: Int, t: Int, gen: Int) {
  rt.mem_store(d, DB_ICNT, BASIC_INFO_COUNT, 4)
  if Int(sys_darwin.thread_info(t, THREAD_BASIC_INFO, d + DB_INFO, d + DB_ICNT)) != 0 {
    return
  }
  // user_time and system_time: (seconds, microseconds), 32 bits each
  let i = d + DB_INFO
  let cpu = (rt.mem_load(i, 0, 4) + rt.mem_load(i, 8, 4)) * 1000000 + rt.mem_load(i, 4, 4) + rt.mem_load(i, 12, 4)
  let e = mac_entry(d, t, gen)
  if e == 0 {
    let _l = rt.slot_add[Int](r, R_NOREC / 8, 1, RELAXED)
    return
  }
  let last = ld(e, 8)
  st(e, 8, cpu)
  st(e, 24, gen)
  if last == -1 {
    return
  }
  // a smaller time: the port's thread ended and the name went to a new one
  let acc = ld(e, 16) + (if cpu >= last { cpu - last } else { cpu })
  let tick = ld(d, DB_TICK)
  var k = acc / tick
  st(e, 16, acc - k * tick)
  if k == 0 {
    return
  }
  if k > MAX_K {
    k = MAX_K
  }
  if Int(sys_darwin.thread_suspend(t)) != 0 {
    return
  }
  let x64 = match target.arch {
    TargetArch.Amd64 => true
    TargetArch.Arm64 | TargetArch.Wasm32 => false
  }
  // ARM_THREAD_STATE64 (6) of 68 words, x86_THREAD_STATE64 (4) of 42
  rt.mem_store(d, DB_ICNT, if x64 { 42 } else { 68 }, 4)
  if Int(sys_darwin.thread_get_state(t, if x64 { 4 } else { 6 }, d + DB_STATE, d + DB_ICNT)) == 0 {
    st(d, DB_UC + 48, d + DB_STATE - 16)
    let k0 = claim(r, k)
    if k0 >= 0 {
      let p = ld(r, R_RING) + k0 * SLOT
      fill(r, k0, k, unwind.prof_walk(ld(d, DB_UNW), d + DB_UC, p + 8, DEPTH, ld(r, R_TLO), ld(r, R_THI)))
    }
  }
  let _r = sys_darwin.thread_resume(t)
}

// ---------------------------------------------------------------------------
// Windows: the sampler thread (decision 0238, as Go's profileloop)

/// The sampler's record (byte offsets; VirtualAlloc'd, page aligned): the
/// timer, the unwind record it walks with (unwind.xo prof_init, its
/// CONTEXT there), the sampler's own thread and process ids, the tick in
/// 100 ns, a due time, the four FILETIMEs of GetThreadTimes, a cycle
/// count, a THREADENTRY32 (28 bytes), and the table of threads seen: WT_N
/// entries of (thread id, handle, last cycles).
const WB_TIMER = 0
const WB_UNW = 8
const WB_ME = 32
const WB_PID = 40
const WB_TICK = 48
const WB_DUE = 56
const WB_FT = 64
const WB_CYC = 96
const WB_TE = 104
const WB_TAB = 1408
const WT_N = 256
const WB_SIZE = 7552
/// OpenThread's access: THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT |
/// THREAD_QUERY_INFORMATION.
const THREAD_SAMPLE = 74
const INFINITE = 4294967295

/// Starts the sampler thread for the profile record r (its ring, rate,
/// and text set up by start; it walks with the unwind record u): the
/// switch on first, then the thread, which ticks until finish turns it
/// off.
fn win_start(r: Int, u: Int, hz: Int) {
  let w = map(WB_SIZE)
  if w == 0 {
    stdio.eprint("xo profile: no memory for the profile", true)
    return
  }
  st(w, WB_UNW, u)
  // TIMER_ALL_ACCESS; a high resolution timer where the system has one
  // (Windows 10 1803), else an ordinary one (about 1 ms with the default
  // timer resolution raised, 15.6 ms without)
  var t = sys_windows.CreateWaitableTimerExW(0, 0, 2, 2031619)
  if t == 0 {
    t = sys_windows.CreateWaitableTimerExW(0, 0, 0, 2031619)
  }
  if t == 0 {
    stdio.eprint("xo profile: no timer for the sampler", true)
    return
  }
  st(w, WB_TIMER, t)
  st(w, WB_PID, Int(sys_windows.GetCurrentProcessId()))
  st(w, WB_TICK, 10000000 / hz)
  st(r, R_WIN, w)
  rt.slot_store[Int](rt.static_word(W_PROF), 0, r, 2)
  let th = sys_windows.CreateThread(0, 65536, rt.fn_addr("prof_sampler"), r, 65536, 0)
  if th == 0 {
    rt.slot_store[Int](rt.static_word(W_PROF), 0, 0, 2)
    stdio.eprint("xo profile: the sampler thread did not start", true)
    return
  }
  st(r, R_WTHREAD, th)
}

/// The sampler thread's body (cabi.xo prof_sampler, a CreateThread
/// entry): a tick every 1/hz s until the profile's switch is off. It
/// never allocates and takes no lock: a thread it suspends may hold
/// either.
pub fn win_sampler(r: Int) -> Int {
  let w = ld(r, R_WIN)
  st(w, WB_ME, Int(sys_windows.GetCurrentThreadId()))
  let sw = rt.static_word(W_PROF)
  while rt.slot_load[Int](sw, 0, 1) == r {
    // a relative due time, in 100 ns
    st(w, WB_DUE, 0 - ld(w, WB_TICK))
    if Int(sys_windows.SetWaitableTimer(ld(w, WB_TIMER), w + WB_DUE, 0, 0, 0, 0)) == 0 {
      break
    }
    let _w = sys_windows.WaitForSingleObject(ld(w, WB_TIMER), INFINITE)
    if rt.slot_load[Int](sw, 0, 1) != r {
      break
    }
    win_tick(r, w)
  }
  0
}

/// One tick: every other thread of the process, from a snapshot.
fn win_tick(r: Int, w: Int) {
  let snap = sys_windows.CreateToolhelp32Snapshot(4, 0)
  if snap == -1 {
    return
  }
  let te = w + WB_TE
  rt.mem_store(te, 0, 28, 4)
  var more = Int(sys_windows.Thread32First(snap, te)) != 0
  while more {
    // th32ThreadID, th32OwnerProcessID
    let tid = rt.mem_load(te, 8, 4)
    if rt.mem_load(te, 12, 4) == ld(w, WB_PID) && tid != ld(w, WB_ME) {
      win_sample(r, w, tid)
    }
    rt.mem_store(te, 0, 28, 4)
    more = Int(sys_windows.Thread32Next(snap, te)) != 0
  }
  let _c = sys_windows.CloseHandle(snap)
}

/// The table entry of thread tid, opened on first sight (its last
/// cycles -1); 0 when the table is full or the thread cannot be opened.
fn win_entry(w: Int, tid: Int) -> Int {
  var free = 0
  for i in 0..WT_N {
    let e = w + WB_TAB + 24 * i
    let id = ld(e, 0)
    if id == tid {
      return e
    }
    if id == 0 && free == 0 {
      free = e
    }
  }
  if free == 0 {
    return 0
  }
  let h = sys_windows.OpenThread(THREAD_SAMPLE, 0, tid)
  if h == 0 {
    return 0
  }
  st(free, 0, tid)
  st(free, 8, h)
  st(free, 16, -1)
  free
}

/// Samples thread tid when its CPU cycles moved since the last tick: the
/// thread is suspended for its context and its walk, then resumed.
fn win_sample(r: Int, w: Int, tid: Int) {
  var e = win_entry(w, tid)
  if e == 0 {
    let _l = rt.slot_add[Int](r, R_NOREC / 8, 1, RELAXED)
    return
  }
  var h = ld(e, 8)
  let ft = w + WB_FT
  let timed = Int(sys_windows.GetThreadTimes(h, ft, ft + 8, ft + 16, ft + 24)) != 0
  if timed && ld(ft, 8) != 0 {
    // the entry's thread exited and its id was reused: a fresh handle
    let _c = sys_windows.CloseHandle(h)
    st(e, 0, 0)
    e = win_entry(w, tid)
    if e == 0 {
      return
    }
    h = ld(e, 8)
    if Int(sys_windows.GetThreadTimes(h, ft, ft + 8, ft + 16, ft + 24)) == 0 {
      return
    }
  }
  // its CPU cycles, else (Wine has no QueryThreadCycleTime) its kernel
  // and user time, which moves in clock ticks (10 to 15.6 ms)
  var cyc = 0
  if Int(sys_windows.QueryThreadCycleTime(h, w + WB_CYC)) != 0 {
    cyc = ld(w, WB_CYC)
  } else if timed {
    cyc = ld(ft, 16) + ld(ft, 24)
  } else {
    return
  }
  let last = ld(e, 16)
  st(e, 16, cyc)
  if last == -1 || cyc == last {
    return
  }
  if Int(sys_windows.SuspendThread(h)) == -1 {
    return
  }
  let u = ld(w, WB_UNW)
  if Int(sys_windows.GetThreadContext(h, unwind.win_context(u))) != 0 {
    let k = rt.slot_add[Int](r, R_NEXT / 8, 1, ACQ_REL)
    if k < ld(r, R_CAP) {
      let p = ld(r, R_RING) + k * SLOT
      let n = unwind.win_walk(u, p + 8, DEPTH, true)
      rt.slot_store[Int](p, 0, n, 2)
    } else {
      let _l = rt.slot_add[Int](r, R_LOST / 8, 1, RELAXED)
    }
  }
  let _r = sys_windows.ResumeThread(h)
}

/// Closes the sampler's handles once its thread has ended.
fn win_close(w: Int) {
  let _t = sys_windows.CloseHandle(ld(w, WB_TIMER))
  for i in 0..WT_N {
    let e = w + WB_TAB + 24 * i
    if ld(e, 0) != 0 {
      let _c = sys_windows.CloseHandle(ld(e, 8))
    }
  }
}

/// Windows: the functions of the program's COFF symbol table (the PE
/// file's PointerToSymbolTable, which lld-link writes with /debug:symtab;
/// it is not mapped, so the file is read) whose address is in [lo, hi):
/// a symbol of type 0x20 (a function), or an external or static one in a
/// code section, without auxiliary records, its name not a section's.
fn coff_symbols(lo: Int, hi: Int, var addrs: List[Int], var names: List[Str]) {
  let f = dwline.read_self()
  if f.len() < 64 {
    return
  }
  let base = sys_windows.GetModuleHandleW(0)
  let pe = u32(f, 60)
  if pe + 24 > f.len() {
    return
  }
  let coff = pe + 4
  let nsec = u16(f, coff + 2)
  let sym = u32(f, coff + 8)
  let nsym = u32(f, coff + 12)
  let sec = coff + 20 + u16(f, coff + 16)
  let strs = sym + 18 * nsym
  if sym == 0 || strs > f.len() || sec + 40 * nsec > f.len() {
    return
  }
  var i = 0
  while i < nsym {
    let p = sym + 18 * i
    let aux = Int(f[p + 17])
    let sn = u16(f, p + 12)
    let typ = u16(f, p + 14)
    let cls = Int(f[p + 16])
    i += 1 + aux
    if aux != 0 || sn < 1 || sn > nsec {
      continue
    }
    let s = sec + 40 * (sn - 1)
    // IMAGE_SCN_CNT_CODE
    let code = (u32(f, s + 36) & 32) != 0
    if typ != 32 && !(code && (cls == 2 || cls == 3)) {
      continue
    }
    let a = base + u32(f, s + 12) + u32(f, p + 8)
    if a < lo || a >= hi {
      continue
    }
    let name = if u32(f, p) == 0 { zstr(f, strs + u32(f, p + 4)) } else { zstr_n(f, p, 8) }
    // (xo_utext_: a part's first text label, at its first function: the
    // function's own name is the frame's)
    if name.is_empty() || name.starts_with(".") || name.starts_with("$") || name.starts_with("xo_utext_") {
      continue
    }
    addrs.push(a)
    names.push(name)
  }
}

fn u16(b: Bytes, o: Int) -> Int { Int(b[o]) | (Int(b[o + 1]) << 8) }

fn u32(b: Bytes, o: Int) -> Int { u16(b, o) | (u16(b, o + 2) << 16) }

/// The zero terminated string at o of b.
fn zstr(b: Bytes, o: Int) -> Str {
  if o >= b.len() {
    return ""
  }
  var e = o
  while e < b.len() && b[e] != 0 {
    e += 1
  }
  b[o..e].to_str() ?? ""
}

/// The at most n bytes at o of b, up to a zero.
fn zstr_n(b: Bytes, o: Int, n: Int) -> Str {
  var e = o
  while e < o + n && b[e] != 0 {
    e += 1
  }
  b[o..e].to_str() ?? ""
}

