// The native sampling profiler (decision 0238): XO_PROF=cpu arms
// ITIMER_PROF (XO_PROF_HZ times a second of CPU time, 100 by default);
// each SIGPROF records the interrupted thread's frames (unwind.xo
// prof_walk: the fault unwinder's tables, in a record of the profiler's
// own per thread) into a ring of fixed slots claimed with one atomic add:
// no allocation, no lock, no C library call in the handler; a sample the
// full ring cannot take is counted. At the end of main (entry.xo) or at
// os.proc.exit (process.xo, through cabi.xo prof_finish) the timer stops
// and the samples are symbolized from the program's own symbol table
// (macOS: LC_SYMTAB in __LINKEDIT, in memory; Linux: .symtab of
// /proc/self/exe) and written as pprof's protobuf, gzip with stored
// blocks (`go tool pprof`, speedscope, flame graph tools read it), to
// XO_PROF_OUT (xo-cpu.pprof by default), with a text summary beside it
// (the top 30 by flat and by cumulative samples, as `go tool pprof -top`
// prints, in the same path with .txt for .pprof), with each location's
// file and line from the program's DWARF line tables when it has them
// (dwline.xo, decision 0239: Linux's .debug_line, macOS's PROG.dSYM):
// pprof's Line.line and Function.filename, and the text summary's
// hottest line of each function. Off (no XO_PROF) it costs one
// environment lookup at start. Windows (a sampling thread) is not here
// yet.
//
// XO_PROF=heap (decision 0238 item 4; with cpu: XO_PROF=cpu,heap) samples
// allocations, an exponential gap of mean XO_PROF_HEAP_RATE bytes (512
// KiB; 1 is every allocation), through heapprof.xo, and writes Go's four
// heap values (alloc_objects, alloc_space, inuse_objects, inuse_space,
// each scaled by the sample's inverse probability, as Go does) to
// XO_PROF_HEAP_OUT (else XO_PROF_OUT when cpu is not profiled, else
// xo-heap.pprof), with the same text summary beside it (the top 30 by
// inuse_space and by alloc_space). The allocator's own frames (obj.xo,
// alloc.xo, cabi.xo's exports, the sampler) are left off each stack, so
// a stack's leaf is the code that allocated.
use native/llrt/dwline
use native/llrt/heapos
use native/llrt/heapprof
use native/llrt/linux
use native/llrt/process
use native/llrt/raw
use native/llrt/stdio
use native/llrt/sysio
use native/llrt/unwind
use native/rt
use native/sys_darwin

/// rt.static_word: the profiler's record (0: off).
const W_PROF = 13
/// The thread local word of this thread's profiler record (sched.xo's
/// table: 15).
const TL_PROF = 15

// The record (byte offsets): the ring's address and slot count, the
// next slot (atomic), the samples lost to a full ring or to the pool's
// end (atomic), the pool of per thread unwind records, its size and next
// free record (atomic), the program's text, the rate, the start time.
const R_RING = 0
const R_CAP = 8
const R_NEXT = 16
const R_LOST = 24
const R_POOL = 32
const R_POOL_N = 40
const R_POOL_NEXT = 48
const R_TLO = 56
const R_THI = 64
const R_HZ = 72
const R_T0 = 80
const R_NOREC = 88
const R_SIZE = 128

/// The deepest stack a sample keeps, and a slot's bytes: the frame count,
/// then the pcs.
const DEPTH = 64
const SLOT = 520
/// The ring's slots: 32,768 samples (5.5 minutes of one busy thread at
/// 100 Hz) in 17 MB, mapped only when profiling.
const CAP = 32768
/// The threads that can be sampled (each claims an unwind record of
/// unwind.PROF_RECORD bytes on its first sample).
const POOL_N = 64

const SIGPROF = 27
const ITIMER_PROF = 2

const RELAXED = 0
const ACQ_REL = 3

fn ld(p: Int, o: Int) -> Int { rt.mem_load(p, o, 8) }

fn st(p: Int, o: Int, v: Int) { rt.mem_store(p, o, v, 8) }

fn darwin() -> Bool {
  match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
}

/// Anonymous memory of n bytes (zeroed), or 0.
fn map(n: Int) -> Int {
  let m = match target.os {
    TargetOs.Darwin => sys_darwin.mmap(0, n, 3, 2 | 4096, -1, 0)
    TargetOs.Linux => linux.mmap(0, n, 3, 2 | 32, -1, 0)
    TargetOs.Windows | TargetOs.Wasi => 0
  }
  if m == 0 || (m < 0 && m > -4096) {
    return 0
  }
  m
}

/// Arms the profiler when XO_PROF names cpu, heap, or both (entry.xo
/// start, after the environment is kept). Nothing else is touched when it
/// names neither.
pub fn start() {
  let v = process.env_real_at("XO_PROF")
  if v == 0 {
    return
  }
  if names(v, "heap") {
    start_heap()
  }
  if !names(v, "cpu") {
    return
  }
  match target.os {
    TargetOs.Darwin | TargetOs.Linux => {}
    TargetOs.Windows | TargetOs.Wasi => {
      stdio.eprint("xo profile: XO_PROF=cpu is not supported on this target yet", true)
      return
    }
  }
  var hz = 100
  let h = process.env_real_at("XO_PROF_HZ")
  if h != 0 {
    let n = atoi(h)
    if n >= 1 && n <= 10000 {
      hz = n
    }
  }
  let r = map(R_SIZE)
  let ring = map(CAP * SLOT)
  let pool = map(POOL_N * unwind.PROF_RECORD)
  if r == 0 || ring == 0 || pool == 0 {
    stdio.eprint("xo profile: no memory for the profile", true)
    return
  }
  for i in 0..POOL_N {
    if !unwind.prof_init(pool + i * unwind.PROF_RECORD) {
      stdio.eprint("xo profile: the program's unwind tables were not found", true)
      return
    }
  }
  let (lo, hi) = unwind.prof_text(pool)
  st(r, R_RING, ring)
  st(r, R_CAP, CAP)
  st(r, R_POOL, pool)
  st(r, R_POOL_N, POOL_N)
  st(r, R_TLO, lo)
  st(r, R_THI, hi)
  st(r, R_HZ, hz)
  st(r, R_T0, sysio.mono_ns())
  rt.slot_store[Int](rt.static_word(W_PROF), 0, r, 2)
  handler(rt.fn_addr("on_prof"))
  timer(1000000 / hz)
}

/// Whether the C string at v lists w (comma separated).
fn names(v: Int, w: Str) -> Bool {
  let wb = w.bytes()
  var i = 0
  var at = 0
  while true {
    let c = rt.mem_load(v, i, 1)
    if c == 0 || c == 44 {
      if i - at == wb.len() {
        var same = true
        for j in 0..wb.len() {
          if rt.mem_load(v, at + j, 1) != Int(wb[j]) {
            same = false
          }
        }
        if same {
          return true
        }
      }
      if c == 0 {
        return false
      }
      at = i + 1
    }
    i += 1
  }
  false
}

/// The heap profile's default rate: Go's runtime.MemProfileRate.
const HEAP_RATE = 524288

/// Starts the heap profile: heapprof.xo's tables, then every heap record
/// counts and samples (heapos.xo profile_on; a thread's new record
/// copies it). The heap keeps its paths: one thread keeps its single
/// threaded record and fast paths.
fn start_heap() {
  match target.os {
    TargetOs.Darwin | TargetOs.Linux => {}
    TargetOs.Windows | TargetOs.Wasi => {
      stdio.eprint("xo profile: XO_PROF=heap is not supported on this target yet", true)
      return
    }
  }
  var rate = HEAP_RATE
  let rv = process.env_real_at("XO_PROF_HEAP_RATE")
  if rv != 0 {
    let n = atoi(rv)
    if n >= 1 {
      rate = n
    }
  }
  if !heapprof.start(rate) {
    stdio.eprint("xo profile: no memory or unwind tables for the heap profile", true)
    return
  }
  heapos.profile_on()
}

/// The decimal digits of the C string at a (0 when none).
fn atoi(a: Int) -> Int {
  var v = 0
  var i = 0
  while true {
    let c = rt.mem_load(a, i, 1)
    if c < 48 || c > 57 || i > 9 {
      break
    }
    v = v * 10 + (c - 48)
    i += 1
  }
  v
}

/// Installs h as SIGPROF's handler (SA_SIGINFO for the ucontext,
/// SA_RESTART so an interrupted system call goes on), or SIG_IGN (1).
fn handler(h: Int) {
  match target.os {
    TargetOs.Linux => {
      let flags = if h == 1 { 0 } else { 4 | 268435456 }
      let _r = linux.sigaction(SIGPROF, h, flags)
    }
    TargetOs.Darwin => {
      // struct sigaction: the handler, the mask (4 bytes), the flags
      let sa = rt.heap_large(16)
      st(sa, 0, h)
      rt.mem_store(sa, 8, 0, 4)
      rt.mem_store(sa, 12, if h == 1 { 0 } else { 64 | 2 }, 4)
      let _r = sys_darwin.sigaction(SIGPROF, sa, 0)
      rt.heap_release(sa - 8)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// setitimer(ITIMER_PROF) every us microseconds of the process's CPU
/// time (0: stop).
fn timer(us: Int) {
  // struct itimerval: it_interval, it_value (each tv_sec, tv_usec)
  let t = rt.heap_large(32)
  st(t, 0, us / 1000000)
  st(t, 8, us % 1000000)
  st(t, 16, us / 1000000)
  st(t, 24, us % 1000000)
  match target.os {
    TargetOs.Linux => {
      let nr = match target.arch {
        TargetArch.Amd64 => 38
        TargetArch.Arm64 | TargetArch.Wasm32 => 103
      }
      let _r = rt.sys6(nr, ITIMER_PROF, t, 0, 0, 0, 0)
    }
    TargetOs.Darwin => {
      // macOS's struct timeval: tv_sec 8 bytes, tv_usec 4 (then 4 of
      // padding)
      rt.mem_store(t, 12, 0, 4)
      rt.mem_store(t, 28, 0, 4)
      let _r = sys_darwin.setitimer(ITIMER_PROF, t, 0)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
  rt.heap_release(t - 8)
}

/// SIGPROF's handler (cabi.xo on_prof): one sample of the interrupted
/// thread into the next free slot. Async signal safe.
pub fn on_signal(uc: Int) {
  let r = rt.slot_load[Int](rt.static_word(W_PROF), 0, 1)
  if r == 0 || uc == 0 {
    return
  }
  var s = rt.tlocal_get(TL_PROF)
  if s == 0 {
    let i = rt.slot_add[Int](r, R_POOL_NEXT / 8, 1, ACQ_REL)
    if i >= ld(r, R_POOL_N) {
      let _l = rt.slot_add[Int](r, R_NOREC / 8, 1, RELAXED)
      return
    }
    s = ld(r, R_POOL) + i * unwind.PROF_RECORD
    rt.tlocal_set(TL_PROF, s)
  }
  let k = rt.slot_add[Int](r, R_NEXT / 8, 1, ACQ_REL)
  if k >= ld(r, R_CAP) {
    let _l = rt.slot_add[Int](r, R_LOST / 8, 1, RELAXED)
    return
  }
  let p = ld(r, R_RING) + k * SLOT
  let n = unwind.prof_walk(s, uc, p + 8, DEPTH, ld(r, R_TLO), ld(r, R_THI))
  // the count last: a slot read with 0 is skipped
  rt.slot_store[Int](p, 0, n, 2)
}

/// Stops the profilers and writes their profiles (entry.xo at main's end,
/// cabi.xo prof_finish from os.proc.exit). Once.
pub fn finish() {
  finish_heap()
  finish_cpu()
}

fn finish_cpu() {
  let w = rt.static_word(W_PROF)
  let r = rt.slot_swap[Int](w, 0, 0, 4)
  if r == 0 {
    return
  }
  timer(0)
  handler(1)
  let dur = sysio.mono_ns() - ld(r, R_T0)
  var n = ld(r, R_NEXT)
  if n > ld(r, R_CAP) {
    n = ld(r, R_CAP)
  }
  let lost = ld(r, R_LOST) + ld(r, R_NOREC)
  let out0 = process.env_real("XO_PROF_OUT")
  let out = expand_pid(if out0.is_empty() || out0[0].is_empty() { "xo-cpu.pprof" } else { out0[0] })
  let syms = symbols(ld(r, R_TLO), ld(r, R_THI))
  let lines = dwline.load(ld(r, R_TLO), ld(r, R_THI))
  write_profile(r, n, lost, dur, syms, lines, out)
}

/// path with each %p as the process id (a profile per process of xo
/// test --profile).
fn expand_pid(path: Str) -> Str {
  if !path.contains("%p") {
    return path
  }
  let pid = match target.os {
    TargetOs.Darwin => Int(sys_darwin.getpid())
    TargetOs.Linux => {
      let nr = match target.arch {
        TargetArch.Amd64 => 39
        TargetArch.Arm64 | TargetArch.Wasm32 => 172
      }
      rt.sys6(nr, 0, 0, 0, 0, 0, 0)
    }
    TargetOs.Windows | TargetOs.Wasi => 0
  }
  path.replace("%p", "${pid}")
}

// ---------------------------------------------------------------------------
// Symbols

/// The program's functions, sorted by address: their starts, ends (the
/// next start, or the text's end), and names (demangled).
struct Syms {
  starts: List[Int]
  ends: List[Int]
  names: List[Str]
}

/// The program's function symbols within [lo, hi).
fn symbols(lo: Int, hi: Int) -> Syms {
  var addrs: List[Int] = []
  var names: List[Str] = []
  if target.os == TargetOs.Darwin {
    macho_symbols(lo, hi, addrs, names)
  } else {
    elf_symbols(lo, hi, addrs, names)
  }
  // sort by address: (offset in the text << 24) | index
  var keys: List[Int] = []
  for i in 0..addrs.len() {
    if i < 16777216 {
      keys.push(rt.int_wrap(3, addrs[i] - lo, 24) | i)
    }
  }
  keys = keys.sort()
  var starts: List[Int] = []
  var sn: List[Str] = []
  var last = -1
  for k in keys {
    let i = k & 16777215
    if addrs[i] == last {
      continue
    }
    last = addrs[i]
    starts.push(addrs[i])
    sn.push(demangle(names[i]))
  }
  var ends: List[Int] = []
  for i in 0..starts.len() {
    ends.push(if i + 1 < starts.len() { starts[i + 1] } else { hi })
  }
  Syms{starts: starts, ends: ends, names: sn}
}

/// The index of the function holding pc, or -1.
fn sym_of(s: Syms, pc: Int) -> Int {
  var a = 0
  var b = s.starts.len()
  while a < b {
    let m = (a + b) / 2
    if s.starts[m] <= pc {
      a = m + 1
    } else {
      b = m
    }
  }
  let i = a - 1
  if i < 0 || pc >= s.ends[i] {
    return -1
  }
  i
}

/// The C string at p.
fn cstr(p: Int) -> Str {
  var n = 0
  while rt.mem_load(p, n, 1) != 0 && n < 4096 {
    n += 1
  }
  var b = BytesBuilder.with_capacity(n)
  for i in 0..n {
    b.write_byte(UInt8(rt.mem_load(p, i, 1)))
  }
  b.freeze().to_str() ?? ""
}

/// macOS: the N_SECT symbols of the program's image (its LC_SYMTAB, read
/// through __LINKEDIT, which is mapped) whose address is in the text.
fn macho_symbols(lo: Int, hi: Int, var addrs: List[Int], var names: List[Str]) {
  let mh = sys_darwin._dyld_get_image_header(0)
  if mh == 0 || rt.mem_load(mh, 0, 4) != 4277009103 {
    return
  }
  let ncmds = rt.mem_load(mh, 16, 4)
  var lc = mh + 32
  var slide = 0
  var le_vm = 0
  var le_off = 0
  var symoff = 0
  var nsyms = 0
  var stroff = 0
  for _ in 0..ncmds {
    let cmd = rt.mem_load(lc, 0, 4)
    if cmd == 25 {
      // LC_SEGMENT_64: segname at 8 (16 bytes), vmaddr 24, fileoff 40
      let a = ld(lc, 8)
      let b = ld(lc, 16)
      if a == 92738097012575 && b == 0 {
        // "__TEXT"
        slide = mh - ld(lc, 24)
      } else if a == 4919420967581409119 && b == 21577 {
        // "__LINKEDIT"
        le_vm = ld(lc, 24)
        le_off = ld(lc, 40)
      }
    } else if cmd == 2 {
      // LC_SYMTAB: symoff 8, nsyms 12, stroff 16, strsize 20
      symoff = rt.mem_load(lc, 8, 4)
      nsyms = rt.mem_load(lc, 12, 4)
      stroff = rt.mem_load(lc, 16, 4)
    }
    lc += rt.mem_load(lc, 4, 4)
  }
  if le_vm == 0 || nsyms == 0 {
    return
  }
  let base = le_vm + slide - le_off
  let tab = base + symoff
  let strs = base + stroff
  for i in 0..nsyms {
    // nlist_64: n_strx 0 (4), n_type 4, n_sect 5, n_desc 6, n_value 8
    let e = tab + 16 * i
    let ty = rt.mem_load(e, 4, 1)
    if (ty & 224) != 0 || (ty & 14) != 14 {
      continue
    }
    let a = ld(e, 8) + slide
    if a < lo || a >= hi {
      continue
    }
    var name = cstr(strs + rt.mem_load(e, 0, 4))
    if name.len() > 0 && name.bytes()[0] == 95 {
      name = name[1..name.len()]
    }
    addrs.push(a)
    names.push(name)
  }
}

/// Linux: the STT_FUNC symbols of .symtab (else .dynsym) of the program's
/// file (/proc/self/exe), placed by the load bias (AT_PHDR against
/// PT_PHDR).
fn elf_symbols(lo: Int, hi: Int, var addrs: List[Int], var names: List[Str]) {
  let data = read_file("/proc/self/exe")
  if data.len() < 64 {
    return
  }
  let f = raw.bytes_addr(data)
  let ph = linux.auxval(linux.AT_PHDR)
  let phn = linux.auxval(linux.AT_PHNUM)
  var bias = 0
  for i in 0..phn {
    let p = ph + 56 * i
    if rt.mem_load(p, 0, 4) == 6 {
      bias = ph - ld(p, 16)
    }
  }
  // Elf64_Ehdr: e_shoff 40, e_shentsize 58, e_shnum 60
  let shoff = ld(f, 40)
  let shn = rt.mem_load(f, 60, 2)
  if shoff <= 0 || shoff + 64 * shn > data.len() {
    return
  }
  for want in [2, 11] {
    for i in 0..shn {
      // Elf64_Shdr: sh_type 4, sh_offset 24, sh_size 32, sh_link 40
      let sh = f + shoff + 64 * i
      if rt.mem_load(sh, 4, 4) != want {
        continue
      }
      let off = ld(sh, 24)
      let size = ld(sh, 32)
      let link = rt.mem_load(sh, 40, 4)
      if link >= shn || off + size > data.len() {
        continue
      }
      let strsh = f + shoff + 64 * link
      let stro = ld(strsh, 24)
      for j in 0..size / 24 {
        // Elf64_Sym: st_name 0 (4), st_info 4, st_value 8
        let e = f + off + 24 * j
        if (rt.mem_load(e, 4, 1) & 15) != 2 {
          continue
        }
        let a = ld(e, 8) + bias
        if a < lo || a >= hi {
          continue
        }
        addrs.push(a)
        names.push(cstr(f + stro + rt.mem_load(e, 0, 4)))
      }
    }
    if addrs.len() > 0 {
      return
    }
  }
}

/// The bytes of the file at path (empty when it cannot be read).
fn read_file(path: Str) -> Bytes {
  let fd = linux.open(path, 524288, 0)
  if fd < 0 {
    return b""
  }
  let (stat, e) = linux.fstat(fd)
  if e != 0 || stat.size <= 0 {
    let _c = linux.close(fd)
    return b""
  }
  var b = BytesBuilder.with_capacity(stat.size)
  let buf = rt.heap_large(65536)
  while true {
    let r = linux.read_at(fd, buf, 65536)
    if r == -4 {
      continue
    }
    if r <= 0 {
      break
    }
    for i in 0..r {
      b.write_byte(UInt8(rt.mem_load(buf, i, 1)))
    }
  }
  rt.heap_release(buf - 8)
  let _c = linux.close(fd)
  b.freeze()
}

/// An Xo function's symbol as its name: the arm64 backend's (gen.xo
/// fname: `xo_f_`, `_` doubled, any other byte not a letter or digit `_`
/// and two hex digits), the LLVM backend's (`x.` and the name), and a C
/// ABI export's (`xo_x_` and the name); another symbol as it is.
fn demangle(s: Str) -> Str {
  let b = s.bytes()
  if b.len() > 2 && s[0..2] == "x." {
    return s[2..s.len()]
  }
  if b.len() > 5 && s[0..5] == "xo_x_" {
    return s[5..s.len()]
  }
  if b.len() < 6 || s[0..5] != "xo_f_" {
    return s
  }
  var o = BytesBuilder.with_capacity(b.len())
  var i = 5
  while i < b.len() {
    let c = Int(b[i])
    if c == 95 && i + 1 < b.len() && Int(b[i + 1]) == 95 {
      o.write_byte(UInt8(95))
      i += 2
    } else if c == 95 && i + 2 < b.len() && hexv(Int(b[i + 1])) >= 0 && hexv(Int(b[i + 2])) >= 0 {
      o.write_byte(UInt8(16 * hexv(Int(b[i + 1])) + hexv(Int(b[i + 2]))))
      i += 3
    } else {
      o.write_byte(UInt8(c))
      i += 1
    }
  }
  o.freeze().to_str() ?? s
}

fn hexv(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return c - 87
  }
  -1
}

// ---------------------------------------------------------------------------
// The profile

/// Writes the pprof file at out and the text summary beside it.
fn write_profile(r: Int, n: Int, lost: Int, dur: Int, syms: Syms, lines: dwline.Lines, out: Str) {
  let ring = ld(r, R_RING)
  let hz = ld(r, R_HZ)
  let period = 1000000000 / hz
  // the distinct pcs (locations), by sorting
  var pcs: List[Int] = []
  var total = 0
  for k in 0..n {
    let p = ring + k * SLOT
    let d = ld(p, 0)
    if d <= 0 {
      continue
    }
    total += 1
    for j in 0..d {
      pcs.push(frame_pc(p, j))
    }
  }
  pcs = pcs.sort()
  var locs: List[Int] = []
  for pc in pcs {
    if locs.len() == 0 || locs[locs.len() - 1] != pc {
      locs.push(pc)
    }
  }
  // the functions: the program's symbols, then the names of the pcs
  // outside it (a C library function, the dynamic loader); each
  // location read as a return address, whose call is at pc - 1 (fr; a
  // leaf's interrupted pc is kept plus 1, frame_pc, as Go's profiles
  // do, so pc - 1 is the instruction itself)
  var names = syms.names
  var fr: List[Int] = []
  for pc in locs {
    fr.push(func_of(syms, pc - 1, names))
  }
  // each location's frames, innermost first: the callees inlined there
  // (dwline inline_chain, .debug_info), then the function holding it;
  // their functions (indexes of names, inlined callees added) and lines
  var cf: List[List[Int]] = []
  var cfile: List[List[Str]] = []
  var cline: List[List[Int]] = []
  for (li, pc) in locs.indexed() {
    let (fs, pf, pl) = dwline.inline_chain(lines, pc - 1, names[fr[li]])
    var fi: List[Int] = []
    var ff: List[Str] = []
    var ll: List[Int] = []
    for fm in fs {
      fi.push(name_index(fm.name, names))
      ff.push(fm.file)
      ll.push(fm.line)
    }
    fi.push(fr[li])
    ff.push(pf)
    ll.push(pl)
    cf.push(fi)
    cfile.push(ff)
    cline.push(ll)
  }
  // xo_entry (LLVM inlines the program's main into it) is main
  for i in 0..names.len() {
    if names[i] == "xo_entry" {
      names[i] = "main"
    }
  }
  var flat: List[Int] = []
  var cum: List[Int] = []
  var seen: List[Int] = []
  for _ in 0..names.len() {
    flat.push(0)
    cum.push(0)
    seen.push(-1)
  }
  var stacks: List[Int] = []
  // per location: samples it is the leaf of, and stacks it is in
  var lleaf: List[Int] = []
  var lany: List[Int] = []
  for _ in 0..locs.len() {
    lleaf.push(0)
    lany.push(0)
  }
  for k in 0..n {
    let p = ring + k * SLOT
    let d = ld(p, 0)
    if d <= 0 {
      continue
    }
    for j in 0..d {
      let li = loc_index(locs, frame_pc(p, j))
      lany[li] = lany[li] + 1
      if j == 0 {
        // the innermost frame's function: an inlined callee's when the
        // pc is in one
        let f0 = cf[li][0]
        flat[f0] = flat[f0] + 1
        lleaf[li] = lleaf[li] + 1
      }
      for f in cf[li] {
        if seen[f] != k {
          seen[f] = k
          cum[f] = cum[f] + 1
        }
      }
    }
    stacks.push(k)
  }
  // each function's hottest line: its most frequent leaf frame, else its
  // most frequent frame anywhere
  var hot: List[Str] = []
  var hot_n: List[Int] = []
  for _ in 0..names.len() {
    hot.push("")
    hot_n.push(0)
  }
  for li in 0..locs.len() {
    let f = cf[li][0]
    if lleaf[li] > 0 && lleaf[li] > hot_n[f] && !cfile[li][0].is_empty() {
      hot[f] = "${base_name(cfile[li][0])}:${cline[li][0]}"
      hot_n[f] = lleaf[li]
    }
  }
  for li in 0..locs.len() {
    for (q, f) in cf[li].indexed() {
      if flat[f] == 0 && lany[li] > hot_n[f] && !cfile[li][q].is_empty() {
        hot[f] = "${base_name(cfile[li][q])}:${cline[li][q]}"
        hot_n[f] = lany[li]
      }
    }
  }
  let pb = pprof(ring, stacks, locs, cf, names, cfile, cline, period, dur)
  let ok = write_file(out, gzip(pb))
  let txt = text_path(out)
  let summary = top_text(flat, cum, names, hot, total, lost, dur, hz, period)
  let ok2 = write_file(txt, summary.bytes())
  if ok && ok2 {
    stdio.eprint("xo profile: ${total} samples in ${out} and ${txt}", true)
  } else {
    stdio.eprint("xo profile: could not write ${out}", true)
  }
}

/// The index of function name in names, added once (an inlined
/// callee's: the same as its own symbol's when it also has one).
fn name_index(name: Str, var names: List[Str]) -> Int {
  for (i, n) in names.indexed() {
    if n == name {
      return i
    }
  }
  names.push(name)
  names.len() - 1
}

/// The function of pc: the program's symbol holding it, else the name of
/// what holds it outside the program (added to names once).
fn func_of(syms: Syms, pc: Int, var names: List[Str]) -> Int {
  let f = sym_of(syms, pc)
  if f >= 0 {
    return f
  }
  let name = outside_name(pc)
  var i = syms.names.len()
  while i < names.len() {
    if names[i] == name {
      return i
    }
    i += 1
  }
  names.push(name)
  names.len() - 1
}

/// The name of a pc outside the program: macOS, dladdr's symbol (else
/// its image's file name); Linux, the file name of the shared object
/// holding it ([vdso] for the kernel's); "?" when nothing holds it.
fn outside_name(pc: Int) -> Str {
  match target.os {
    TargetOs.Darwin => {
      // Dl_info: dli_fname 0, dli_fbase 8, dli_sname 16, dli_saddr 24
      let info = rt.heap_large(32)
      rt.mem_set(info, 0, 32)
      var name = "?"
      if Int(sys_darwin.dladdr(pc, info)) != 0 {
        if ld(info, 16) != 0 {
          name = cstr(ld(info, 16))
          if name.len() > 0 && name.bytes()[0] == 95 {
            name = name[1..name.len()]
          }
        } else if ld(info, 0) != 0 {
          name = "[${base_name(cstr(ld(info, 0)))}]"
        }
      }
      rt.heap_release(info - 8)
      name
    }
    TargetOs.Linux => linux_object_name(pc)
    TargetOs.Windows | TargetOs.Wasi => "?"
  }
}

/// The last element of a path.
fn base_name(p: Str) -> Str {
  let b = p.bytes()
  var i = b.len()
  while i > 0 && Int(b[i - 1]) != 47 {
    i -= 1
  }
  p[i..p.len()]
}

/// Linux: "[name]" of the shared object whose PT_LOAD holds pc (the
/// dynamic loader's link_map, through the program's DT_DEBUG), else "?".
fn linux_object_name(pc: Int) -> Str {
  let ph = linux.auxval(linux.AT_PHDR)
  let n = linux.auxval(linux.AT_PHNUM)
  if ph == 0 {
    return "?"
  }
  var bias = 0
  var dynv = 0
  for i in 0..n {
    let p = ph + 56 * i
    let t = rt.mem_load(p, 0, 4)
    if t == 6 {
      bias = ph - ld(p, 16)
    } else if t == 2 {
      dynv = ld(p, 16)
    }
  }
  if dynv == 0 {
    return "?"
  }
  var d = dynv + bias
  var dbg = 0
  while ld(d, 0) != 0 {
    if ld(d, 0) == 21 {
      dbg = ld(d, 8)
    }
    d += 16
  }
  if dbg == 0 {
    return "?"
  }
  // struct r_debug: r_version, r_map; struct link_map: l_addr, l_name,
  // l_ld, l_next
  var lm = ld(dbg, 8)
  var left = 4096
  while lm != 0 && left > 0 {
    left -= 1
    let base = ld(lm, 0)
    if base != 0 && rt.mem_load(base, 0, 4) == 1179403647 {
      // Elf64_Ehdr: e_phoff 32, e_phnum 56
      let oph = base + ld(base, 32)
      let on = rt.mem_load(base, 56, 2)
      for i in 0..on {
        let p = oph + 56 * i
        if rt.mem_load(p, 0, 4) == 1 {
          let a = base + ld(p, 16)
          if pc >= a && pc < a + ld(p, 40) {
            let nm = if ld(lm, 8) != 0 { cstr(ld(lm, 8)) } else { "" }
            return if nm.is_empty() { "[vdso]" } else { "[${base_name(nm)}]" }
          }
        }
      }
    }
    lm = ld(lm, 24)
  }
  "?"
}

/// out with .txt for a .pprof ending (else .txt added).
fn text_path(out: Str) -> Str {
  if out.len() > 6 && out[out.len() - 6..out.len()] == ".pprof" {
    return out[0..out.len() - 6] + ".txt"
  }
  out + ".txt"
}

/// ms of n samples at period ns, as `go tool pprof -top` prints (ms, or s
/// with two decimals from 10 s).
fn dur_text(ns: Int) -> Str {
  let ms = ns / 1000000
  if ms >= 10000 {
    return "${ms / 1000}.${pad2((ms % 1000) / 10)}s"
  }
  "${ms}ms"
}

fn pad2(v: Int) -> Str { if v < 10 { "0${v}" } else { "${v}" } }

/// x of total as a percent with two decimals.
fn pct(x: Int, total: Int) -> Str {
  if total <= 0 {
    return "0.00%"
  }
  let h = (x * 10000 + total / 2) / total
  "${h / 100}.${pad2(h % 100)}%"
}

fn rpad(s: Str, w: Int) -> Str {
  if s.len() >= w {
    return s
  }
  s + " ".repeat(w - s.len())
}

fn lpad(s: Str, w: Int) -> Str {
  var t = s
  while t.len() < w {
    t = " " + t
  }
  t
}

/// The summary: the totals, then the top 30 by flat and by cumulative.
fn top_text(flat: List[Int], cum: List[Int], names: List[Str], hot: List[Str], total: Int, lost: Int, dur: Int, hz: Int, period: Int) -> Str {
  var b = StrBuilder.new()
  b.write("xo cpu profile: ${total} samples (${dur_text(total * period)}) in ${dur_text(dur)} of wall time at ${hz} Hz")
  if lost > 0 {
    b.write(", ${lost} lost")
  }
  b.write("\n")
  for by_cum in [false, true] {
    b.write(if by_cum { "\ntop 30 by cumulative\n" } else { "\ntop 30 by flat\n" })
    b.write("      flat  flat%   sum%        cum   cum%  line (the hottest)  function\n")
    // the order: count << 24 | function, descending
    var keys: List[Int] = []
    for f in 0..flat.len() {
      let v = if by_cum { cum[f] } else { flat[f] }
      if v > 0 {
        keys.push(rt.int_wrap(3, v, 24) | f)
      }
    }
    keys = keys.sort()
    var sum = 0
    var shown = 0
    var i = keys.len() - 1
    while i >= 0 && shown < 30 {
      let f = keys[i] & 16777215
      sum += flat[f]
      let name = names[f]
      // the function name stays last (TestProfCPU reads it there)
      let at = if hot[f].is_empty() { "-" } else { hot[f] }
      b.write("${lpad(dur_text(flat[f] * period), 10)} ${lpad(pct(flat[f], total), 6)} ${lpad(pct(sum, total), 6)} ${lpad(dur_text(cum[f] * period), 10)} ${lpad(pct(cum[f], total), 6)}  ${rpad(at, 18)}  ${name}\n")
      shown += 1
      i -= 1
    }
  }
  b.freeze()
}

// ---------------------------------------------------------------------------
// pprof's protobuf (github.com/google/pprof proto/profile.proto)

fn varint(var b: BytesBuilder, v0: Int) {
  var v = v0
  while true {
    let low = v & 127
    v = rt.int_wrap(4, v, 7)
    if v == 0 {
      b.write_byte(UInt8(low))
      return
    }
    b.write_byte(UInt8(low | 128))
  }
}

/// A varint field.
fn fint(var b: BytesBuilder, field: Int, v: Int) {
  varint(b, field * 8)
  varint(b, v)
}

/// A length delimited field.
fn fbytes(var b: BytesBuilder, field: Int, data: Bytes) {
  varint(b, field * 8 + 2)
  varint(b, data.len())
  b.write(data)
}

/// A ValueType message of two string indexes.
fn value_type(t: Int, u: Int) -> Bytes {
  var b = BytesBuilder.new()
  fint(b, 1, t)
  fint(b, 2, u)
  b.freeze()
}

/// Frame j of the sample at p as a location: a return address, or for
/// the leaf (j 0) the interrupted pc plus 1.
fn frame_pc(p: Int, j: Int) -> Int {
  ld(p, 8 + 8 * j) + (if j == 0 { 1 } else { 0 })
}

/// The index of location pc in the sorted locs (its id is that plus 1).
fn loc_index(locs: List[Int], pc: Int) -> Int {
  var a = 0
  var b = locs.len()
  while a < b {
    let m = (a + b) / 2
    if locs[m] < pc {
      a = m + 1
    } else {
      b = m
    }
  }
  a
}

/// The Profile message: every sample its own (pprof sums equal stacks);
/// a location per distinct pc with one line naming its function; a
/// function per symbol used.
fn pprof(ring: Int, stacks: List[Int], locs: List[Int], cf: List[List[Int]], names: List[Str], cfile: List[List[Str]], cline: List[List[Int]], period: Int, dur: Int) -> Bytes {
  var strs: List[Str] = ["", "samples", "count", "cpu", "nanoseconds"]
  var b = BytesBuilder.new()
  fbytes(b, 1, value_type(1, 2))
  fbytes(b, 1, value_type(3, 4))
  for k in stacks {
    let p = ring + k * SLOT
    let d = ld(p, 0)
    var ids = BytesBuilder.new()
    for j in 0..d {
      varint(ids, loc_index(locs, frame_pc(p, j)) + 1)
    }
    var vals = BytesBuilder.new()
    varint(vals, 1)
    varint(vals, period)
    var smp = BytesBuilder.new()
    fbytes(smp, 1, ids.freeze())
    fbytes(smp, 2, vals.freeze())
    fbytes(b, 2, smp.freeze())
  }
  pprof_tail(b, strs, locs, cf, names, cfile, cline)
  fint(b, 10, dur)
  fbytes(b, 11, value_type(3, 4))
  fint(b, 12, period)
  b.freeze()
}

/// The Profile's locations, functions, and string table (after its
/// samples): a location per distinct pc, a line per frame of its call
/// (cf, cfile, cline: innermost first, inlined callees before the
/// function); a function (id: its index + 1) per name used; strs, with
/// the names and files added, last.
fn pprof_tail(var b: BytesBuilder, var strs: List[Str], locs: List[Int], cf: List[List[Int]], names: List[Str], cfile: List[List[Str]], cline: List[List[Int]]) {
  var used: List[Bool] = []
  var ffile: List[Str] = []
  for _ in 0..names.len() {
    used.push(false)
    ffile.push("")
  }
  for i in 0..locs.len() {
    var loc = BytesBuilder.new()
    fint(loc, 1, i + 1)
    fint(loc, 3, locs[i])
    // a line per frame, innermost first (pprof: the last is the
    // function the code is in, the others inlined into it)
    for (q, f) in cf[i].indexed() {
      used[f] = true
      if ffile[f].is_empty() {
        ffile[f] = cfile[i][q]
      }
      var line = BytesBuilder.new()
      fint(line, 1, f + 1)
      if cline[i][q] > 0 {
        fint(line, 2, cline[i][q])
      }
      fbytes(loc, 4, line.freeze())
    }
    fbytes(b, 4, loc.freeze())
  }
  for f in 0..names.len() {
    if !used[f] {
      continue
    }
    strs.push(names[f])
    var fn_ = BytesBuilder.new()
    fint(fn_, 1, f + 1)
    fint(fn_, 2, strs.len() - 1)
    fint(fn_, 3, strs.len() - 1)
    if !ffile[f].is_empty() {
      strs.push(ffile[f])
      fint(fn_, 4, strs.len() - 1)
    }
    fbytes(b, 5, fn_.freeze())
  }
  for s in strs {
    fbytes(b, 6, s.bytes())
  }
}

/// data as a gzip member with stored deflate blocks.
fn gzip(data: Bytes) -> Bytes {
  var b = BytesBuilder.with_capacity(data.len() + data.len() / 65535 * 5 + 32)
  for x in [31, 139, 8, 0, 0, 0, 0, 0, 0, 255] {
    b.write_byte(UInt8(x))
  }
  var off = 0
  while true {
    let left = data.len() - off
    let n = if left > 65535 { 65535 } else { left }
    b.write_byte(UInt8(if n == left { 1 } else { 0 }))
    b.write_byte(UInt8(n & 255))
    b.write_byte(UInt8(n / 256))
    b.write_byte(UInt8((65535 - n) & 255))
    b.write_byte(UInt8((65535 - n) / 256))
    b.write(data[off..off + n])
    off += n
    if off >= data.len() {
      break
    }
  }
  let c = crc32(data)
  for i in 0..4 {
    b.write_byte(UInt8(rt.int_wrap(4, c, 8 * i) & 255))
  }
  for i in 0..4 {
    b.write_byte(UInt8(rt.int_wrap(4, data.len(), 8 * i) & 255))
  }
  b.freeze()
}

/// CRC-32 (IEEE, reflected) of data, bit at a time (a profile is small).
fn crc32(data: Bytes) -> Int {
  var c = 4294967295
  for x in data {
    c = c ^ Int(x)
    for _ in 0..8 {
      c = if (c & 1) != 0 { rt.int_wrap(4, c, 1) ^ 3988292384 } else { rt.int_wrap(4, c, 1) }
    }
  }
  c ^ 4294967295
}

/// Writes data to the file at path (created or truncated, mode 0644).
fn write_file(path: Str, data: Bytes) -> Bool {
  match target.os {
    TargetOs.Linux => {
      // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
      let fd = linux.open(path, 1 | 64 | 512 | 524288, 420)
      if fd < 0 {
        return false
      }
      let w = linux.write_all(fd, data)
      let _c = linux.close(fd)
      w == 0
    }
    TargetOs.Darwin => {
      var z = BytesBuilder.with_capacity(path.len() + 1)
      z.write(path.bytes())
      z.write_byte(UInt8(0))
      // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
      let fd = Int(sys_darwin.open(z.freeze(), 1 | 512 | 1024 | 16777216, 420))
      if fd < 0 {
        return false
      }
      var off = 0
      let a = raw.bytes_addr(data)
      var ok = true
      while off < data.len() {
        let w = sys_darwin.write(fd, a + off, data.len() - off)
        if w <= 0 {
          ok = false
          break
        }
        off += w
      }
      let _c = sys_darwin.close(fd)
      ok
    }
    TargetOs.Windows | TargetOs.Wasi => false
  }
}

// ---------------------------------------------------------------------------
// Tracebacks (fault.xo, XO_TRACEBACK)

/// The traceback of a fault from the return addresses of its frames,
/// innermost first: "traceback:" and a line per frame, `  NAME
/// (FILE:LINE)` (the line from the DWARF line tables when the program
/// has them), from the first frame past the runtime's own (fault.,
/// cabi.fault, unwind.) to the program's main (or xo_entry, which LLVM
/// inlines main into).
pub fn trace_text(pcs: List[Int]) -> Str {
  let syms = symbols(1, 9223372036854775807)
  let lines = dwline.load(1, 9223372036854775807)
  var names = syms.names
  var b = StrBuilder.new()
  b.write("traceback:\n")
  var started = false
  for pc in pcs {
    // a return address: its call is at pc - 1
    let f = func_of(syms, pc - 1, names)
    let name = names[f]
    if !started && (name.starts_with("fault.") || name.starts_with("fault_") || name.starts_with("cabi.fault") || name.starts_with("unwind.") || name.starts_with("xo_fault")) {
      continue
    }
    started = true
    // the callees inlined at the call, innermost first, then the
    // function itself at the outermost call's line
    let (fs, pf, pl) = dwline.inline_chain(lines, pc - 1, name)
    for fm in fs {
      if fm.file.is_empty() {
        b.write("  ${fm.name} [inlined]\n")
      } else {
        b.write("  ${fm.name} (${base_name(fm.file)}:${fm.line}) [inlined]\n")
      }
    }
    let shown = if name == "xo_entry" { "main" } else { name }
    if pf.is_empty() {
      b.write("  ${shown}\n")
    } else {
      b.write("  ${shown} (${base_name(pf)}:${pl})\n")
    }
    // the program's main (LLVM inlines it into xo_entry)
    if name == "main" || name == "xo_entry" {
      break
    }
  }
  b.freeze()
}

// ---------------------------------------------------------------------------
// The heap profile's writer

/// The prefixes of the allocator's own functions, left off the top of a
/// heap sample's stack (the sampler, the heap, the exports generated code
/// calls to allocate).
const RUNTIME_PREFIXES: List[Str] = ["unwind.", "heapprof.", "obj.", "alloc.", "heapos.", "cabi.", "libcmem."]

fn runtime_fn(name: Str) -> Bool {
  // C ABI exports are named bare (xo_x_heap_grow and the other heap_*,
  // where the LLVM build inlined the sampler; xo_x_obj_*, generated
  // code's allocations)
  if name.starts_with("heap_") || name.starts_with("obj_") {
    return true
  }
  for p in RUNTIME_PREFIXES {
    if name.starts_with(p) {
      return true
    }
  }
  false
}

/// e^x for x >= 0: x = k ln 2 + f, e^f by its series.
fn exp_pos(x: Float) -> Float {
  let k = Int(x / 0.6931471805599453)
  let f = x - Float(k) * 0.6931471805599453
  var term = 1.0
  var sum = 1.0
  for i in 1..16 {
    term = term * f / Float(i)
    sum = sum + term
  }
  var r = sum
  for _ in 0..k {
    r = r * 2.0
  }
  r
}

/// A sample of size bytes at rate stands for this many allocations (Go's
/// scaleHeapSample: 1 / (1 - e^(-size/rate))).
fn heap_scale(size: Int, rate: Int) -> Float {
  if rate <= 1 || size <= 0 {
    return 1.0
  }
  let x = Float(size) / Float(rate)
  if x > 40.0 {
    return 1.0
  }
  1.0 / (1.0 - 1.0 / exp_pos(x))
}

/// Stops the heap profile and writes it (finish). Nothing when it is off.
fn finish_heap() {
  let r = heapprof.stop()
  if r == 0 {
    return
  }
  let n = heapprof.count(r)
  let rate = heapprof.rate(r)
  let slots = heapprof.slots(r)
  let v = process.env_real_at("XO_PROF")
  let ho = process.env_real("XO_PROF_HEAP_OUT")
  let po = process.env_real("XO_PROF_OUT")
  var out0 = "xo-heap.pprof"
  if !ho.is_empty() && !ho[0].is_empty() {
    out0 = ho[0]
  } else if !(v != 0 && names(v, "cpu")) && !po.is_empty() && !po[0].is_empty() {
    out0 = po[0]
  }
  let out = expand_pid(out0)
  let (lo, hi) = heapprof.text(r)
  let syms = symbols(lo, hi)
  let lines = dwline.load(lo, hi)
  var names = syms.names
  // the distinct pcs of every sample (locations), each symbolized once
  var all: List[Int] = []
  for k in 0..n {
    let p = slots + k * heapprof.SLOT
    let d = ld(p, 0)
    for j in 0..d {
      all.push(ld(p, 8 + 8 * j))
    }
  }
  all = all.sort()
  var pcs0: List[Int] = []
  for pc in all {
    if pcs0.len() == 0 || pcs0[pcs0.len() - 1] != pc {
      pcs0.push(pc)
    }
  }
  var fr0: List[Int] = []
  var rtf: List[Bool] = []
  for pc in pcs0 {
    let f = func_of(syms, pc - 1, names)
    fr0.push(f)
    rtf.push(runtime_fn(names[f]))
  }
  // each sample: its frames (return addresses) below the allocator's,
  // and its four values
  var stacks: List[List[Int]] = []
  var vals: List[List[Int]] = []
  var used: List[Bool] = []
  for _ in 0..pcs0.len() {
    used.push(false)
  }
  for k in 0..n {
    let p = slots + k * heapprof.SLOT
    let d = ld(p, 0)
    if d == 0 {
      continue
    }
    var pcs: List[Int] = []
    if d > 0 {
      var j = 0
      while j < d - 1 && rtf[loc_index(pcs0, ld(p, 8 + 8 * j))] {
        j += 1
      }
      while j < d {
        let pc = ld(p, 8 + 8 * j)
        used[loc_index(pcs0, pc)] = true
        pcs.push(pc)
        j += 1
      }
    }
    let size = ld(p, heapprof.S_SIZE)
    let sc = heap_scale(size, rate)
    let objs = Int(sc + 0.5)
    let bytes = Int(Float(size) * sc + 0.5)
    let live = ld(p, heapprof.S_FREED) == 0
    stacks.push(pcs)
    vals.push([objs, bytes, if live { objs } else { 0 }, if live { bytes } else { 0 }])
  }
  // the locations: the pcs a kept frame has, their functions, files,
  // and lines
  var locs: List[Int] = []
  var cf: List[List[Int]] = []
  var cfile: List[List[Str]] = []
  var cline: List[List[Int]] = []
  for (i, pc) in pcs0.indexed() {
    if !used[i] {
      continue
    }
    locs.push(pc)
    // the callees inlined at the call, then the function (as the cpu
    // profile's frames)
    let (fs, pf, pl) = dwline.inline_chain(lines, pc - 1, names[fr0[i]])
    var fi: List[Int] = []
    var ff: List[Str] = []
    var ll: List[Int] = []
    for fm in fs {
      fi.push(name_index(fm.name, names))
      ff.push(fm.file)
      ll.push(fm.line)
    }
    fi.push(fr0[i])
    ff.push(pf)
    ll.push(pl)
    // the allocator's own callees inlined at the sample's pc (the heap's
    // fast path inlined into the code that allocates: obj.rs_with_cap
    // into raw.str_repeat) are left off, as its own functions are
    var drop = 0
    while drop < fi.len() - 1 && runtime_fn(names[fi[drop]]) {
      drop += 1
    }
    cf.push(fi[drop..fi.len()])
    cfile.push(ff[drop..ff.len()])
    cline.push(ll[drop..ll.len()])
  }
  // xo_entry (LLVM inlines the program's main into it) is main
  for k in 0..names.len() {
    if names[k] == "xo_entry" {
      names[k] = "main"
    }
  }
  // pprof: Go's four sample types, the period the rate in bytes
  var strs: List[Str] = ["", "alloc_objects", "count", "alloc_space", "bytes", "inuse_objects", "inuse_space", "space"]
  var b = BytesBuilder.new()
  fbytes(b, 1, value_type(1, 2))
  fbytes(b, 1, value_type(3, 4))
  fbytes(b, 1, value_type(5, 2))
  fbytes(b, 1, value_type(6, 4))
  for (i, s) in stacks.indexed() {
    var ids = BytesBuilder.new()
    for pc in s {
      varint(ids, loc_index(locs, pc) + 1)
    }
    var vb = BytesBuilder.new()
    for x in vals[i] {
      varint(vb, x)
    }
    var smp = BytesBuilder.new()
    fbytes(smp, 1, ids.freeze())
    fbytes(smp, 2, vb.freeze())
    fbytes(b, 2, smp.freeze())
  }
  pprof_tail(b, strs, locs, cf, names, cfile, cline)
  fbytes(b, 11, value_type(7, 4))
  fint(b, 12, rate)
  let ok = write_file(out, gzip(b.freeze()))
  let txt = text_path(out)
  let summary = heap_text(stacks, vals, locs, cf, names, cfile, cline, rate, heapprof.lost(r), heapprof.unset(r))
  let ok2 = write_file(txt, summary.bytes())
  if ok && ok2 {
    stdio.eprint("xo profile: ${stacks.len()} heap samples in ${out} and ${txt}", true)
  } else {
    stdio.eprint("xo profile: could not write ${out}", true)
  }
}

/// n bytes as `go tool pprof` prints them (B, kB, MB, GB by 1024s, two
/// decimals).
fn bytes_text(n: Int) -> Str {
  if n < 1024 {
    return "${n}B"
  }
  var unit = "kB"
  var d = 1024
  if n >= 1073741824 {
    unit = "GB"
    d = 1073741824
  } else if n >= 1048576 {
    unit = "MB"
    d = 1048576
  }
  let h = (n * 100 + d / 2) / d
  "${h / 100}.${pad2(h % 100)}${unit}"
}

/// The heap summary: the totals (estimated, as the profile's values),
/// then the top 30 functions by inuse_space and by alloc_space, flat (the
/// stack's leaf, the allocating code) and cumulative.
fn heap_text(stacks: List[List[Int]], vals: List[List[Int]], locs: List[Int], cf: List[List[Int]], names: List[Str], cfile: List[List[Str]], cline: List[List[Int]], rate: Int, lost: Int, unset: Int) -> Str {
  var tot = [0, 0, 0, 0]
  for v in vals {
    for i in 0..4 {
      tot[i] = tot[i] + v[i]
    }
  }
  var b = StrBuilder.new()
  b.write("xo heap profile: ${stacks.len()} samples at one per ${bytes_text(rate)} allocated (estimated totals)\n")
  b.write("in use: ${bytes_text(tot[3])} in ${tot[2]} objects; allocated: ${bytes_text(tot[1])} in ${tot[0]} objects")
  if lost > 0 {
    b.write(", ${lost} samples lost")
  }
  if unset > 0 {
    b.write(", ${unset} not tracked for frees")
  }
  b.write("\n")
  for (vi, title) in [(3, "inuse_space"), (1, "alloc_space")] {
    var flat: List[Int] = []
    var cum: List[Int] = []
    var seen: List[Int] = []
    var hot: List[Str] = []
    var hot_v: List[Int] = []
    for _ in 0..names.len() {
      flat.push(0)
      cum.push(0)
      seen.push(-1)
      hot.push("")
      hot_v.push(0)
    }
    for (k, s) in stacks.indexed() {
      let x = vals[k][vi]
      if x == 0 {
        continue
      }
      for (j, pc) in s.indexed() {
        // the location's frames: an inlined callee's first (flat goes to
        // the innermost)
        let li = loc_index(locs, pc)
        if j == 0 {
          let f = cf[li][0]
          flat[f] = flat[f] + x
          if x > hot_v[f] && !cfile[li][0].is_empty() {
            hot[f] = "${base_name(cfile[li][0])}:${cline[li][0]}"
            hot_v[f] = x
          }
        }
        for f in cf[li] {
          if seen[f] != k {
            seen[f] = k
            cum[f] = cum[f] + x
          }
        }
      }
    }
    let total = tot[vi]
    b.write("\ntop 30 by ${title}\n")
    b.write("      flat  flat%   sum%        cum   cum%  line (the largest)  function\n")
    // the order: flat, then cumulative, descending (sort_by is stable)
    var order: List[Int] = []
    for f in 0..names.len() {
      if flat[f] > 0 || cum[f] > 0 {
        order.push(f)
      }
    }
    order = order.sort_by(fn(f: Int) -> Int { -cum[f] }).sort_by(fn(f: Int) -> Int { -flat[f] })
    var sum = 0
    for (i, f) in order.indexed() {
      if i >= 30 {
        break
      }
      sum += flat[f]
      let at = if hot[f].is_empty() { "-" } else { hot[f] }
      b.write("${lpad(bytes_text(flat[f]), 10)} ${lpad(pct(flat[f], total), 6)} ${lpad(pct(sum, total), 6)} ${lpad(bytes_text(cum[f]), 10)} ${lpad(pct(cum[f], total), 6)}  ${rpad(at, 18)}  ${names[f]}\n")
    }
  }
  b.freeze()
}
