// Tests of tlscert.xo's macOS trust settings (GO-2022-0171): Go 1.16's
// sslTrustSettingsResult over trust settings files Apple's own `security
// add-trusted-cert -k THROWAWAY.keychain -o FILE` wrote for a test CA
// ("Xo Trust Test CA", P-256, SHA-1 1BD7113D...1E90; 2026-11-13, with the
// keychain deleted after and no trust domain changed), read through
// CoreFoundation into the evaluator system_roots uses for the user and
// admin domains. Results: 1 TrustRoot, 3 Deny, 4 Unspecified.

const CA_SHA1: Str = "1BD7113DA3649E26406FD495D0A1C115574E1E90"

/// (what the file says, the plist as hex, Go's result)
const CASES: List[(Str, Str, Int)] = [
  ("Deny, every policy", "", 3),
  ("Deny for SSL", "", 3),
  ("Deny for SSL limited to a host name: skipped", "", 4),
  ("Deny for S/MIME only: skipped", "", 4),
  ("TrustRoot (no trustSettings: an empty array)", "", 1),
  ("Unspecified", "", 4),
]

test "trust settings files give Go's SSL result" {
  if target.os == TargetOs.Darwin {
    for (why, hex, want) in CASES {
      let plist = Bytes.from_hex(hex) ?? fault("hex")
      expect((why, plist_results(plist))) == (why, ["${CA_SHA1} ${want}"])
    }
  }
}

test "system roots on macOS still hold the anchors when no settings deny them" {
  if target.os == TargetOs.Darwin {
    expect(root_ders().len() > 100) == true
  }
}
