// The Fs operations past read, write, and stat (std.md 3.1, decisions
// 0102, 0163, 0172, 0193, 0214) over the system layer of each OS, written
// in Xo (work item B16 of bench/results/zero-c-audit-refresh-2026-10-13.md):
// directory names, rename, remove, set_modified, the system calls under
// fspath.xo, file handles, copy, modes, links, and advisory locks, with
// the semantics and messages of the C runtime's xo_fs.c they replaced
// (Go's os package). Linux (linux.xo, raw system calls), macOS on arm64
// and x86_64 (darwin.xo, libSystem), and Windows (windows.xo, kernel32)
// make their calls from Xo; a wasm module (layer 0) names the runtime's
// rt.fs_* functions, which its own runtime serves or faults (on the
// native targets the SSA builders lower them to a fault,
// gotchas/dead-target-arm-still-links.md).
//
// A handle is a record of this module's behind the runtime's object
// header (raw_file, raw_lock: tasks.xo new_handle, its free function
// file_free or lock_free, named by rt.fn_addr at the handle's creation), so a handle
// dropped without close still closes its descriptor (and releases its
// lock); its words are read and written through rt.obj_addr. The status and message of the last operation stay
// sysio.xo's thread locals (set_err, status, msg).
use native/llrt/darwin
use native/llrt/linux
use native/llrt/raw
use native/llrt/obj
use native/llrt/sysio
use native/llrt/tasks
use native/llrt/windows
use native/rt

/// The read buffer of a file handle (Go's bufio.Reader size).
const FS_BUF = 65536
/// The most bytes one `read` returns.
const READ_MAX = 1048576

// The words of a file handle's record (after the 16 byte header): the
// descriptor (-1 once closed), the read buffer's address, and the
// buffered bytes buf[r:w].
const F_FD = 16
const F_BUF = 24
const F_R = 32
const F_W = 40

const F_SIZE = 48

// The words of a lock handle's record: the descriptor and whether it
// holds the lock.
const L_FD = 16
const L_HELD = 24
const L_SIZE = 32

/// The handle of the descriptor fd this module opened (-1: none), with
/// the 64 KiB read buffer when buffered: freeing it closes fd (was
/// xo_fs.c xo_fs_raw_file).
fn raw_file(fd: Int, buffered: Bool) -> rt.FsFile {
  let f = tasks.new_handle(F_SIZE, rt.fn_addr("fs_file_free"))
  rt.mem_store(f, F_FD, fd, 8)
  if buffered {
    rt.mem_store(f, F_BUF, rt.heap_large(FS_BUF), 8)
  }
  let h = rt.obj_at[rt.FsFile](f)
  // obj_at counted it once more: the value holds the one reference
  tasks.h_release(f)
  h
}

/// The lock handle of the descriptor fd (-1: none), held or not: freeing
/// it closes fd, which releases the lock (was xo_fs.c xo_fs_raw_lock).
fn raw_lock(fd: Int, held: Bool) -> rt.FsLock {
  let k = tasks.new_handle(L_SIZE, rt.fn_addr("fs_lock_free"))
  rt.mem_store(k, L_FD, fd, 8)
  rt.mem_store(k, L_HELD, if held { 1 } else { 0 }, 8)
  let h = rt.obj_at[rt.FsLock](k)
  tasks.h_release(k)
  h
}

/// The free function of a file handle's record at p (cabi.xo's export,
/// in the services record): closes its descriptor, frees its buffer.
pub fn file_free(p: Int) {
  let fd = rt.mem_load(p, F_FD, 8)
  if fd >= 0 {
    let _c = close(sysio.layer(), fd)
  }
  let b = rt.mem_load(p, F_BUF, 8)
  if b != 0 {
    rt.heap_release(b - 8)
  }
  obj.free_obj(p)
}

/// The free function of a lock handle's record at p: closing the
/// descriptor releases the lock.
pub fn lock_free(p: Int) {
  let fd = rt.mem_load(p, L_FD, 8)
  if fd >= 0 {
    let _c = close(sysio.layer(), fd)
  }
  obj.free_obj(p)
}

// errno values the same on Linux and macOS
const EINTR = 4
const ENOTDIR = 20
const EISDIR = 21

// Words of eight equal bytes (scan.xo's).
const LOW7S: Int = 9187201950435737471
const HIGHS: Int = -9187201950435737472
const NEWLINES: Int = 723401728380766730

/// The layer this module calls: 1 Linux, 2 macOS, 3 Windows, 0 a wasm
/// module.
fn layer() -> Int { sysio.layer() }

/// Records errno e of layer l for the Xo path x: the status.
fn fail(l: Int, e: Int, x: Str) -> Int {
  let st = sysio.fs_status(l, e)
  sysio.set_err(st, x, sysio.err_msg(l, e))
  st
}

/// Records success: 0.
fn ok() -> Int {
  sysio.set_err(0, "", "")
  0
}

/// The status of a call's result r (>= 0, or a negative errno), recorded
/// for the Xo path x.
fn done(l: Int, r: Int, x: Str) -> Int {
  if r < 0 {
    return fail(l, -r, x)
  }
  ok()
}

// ---------------------------------------------------------------------------
// The calls of the two layers

/// open(2) of p with the flags of kind k (0 read, 1 created or truncated
/// for writing, 2 appended to and created if missing, 3 read and write
/// and created if missing, 4 a new file for read and write), close on
/// exec, and mode: the descriptor or the negative errno (EINTR retried).
fn open(l: Int, p: Str, k: Int, mode: Int) -> Int {
  var r = open_once(l, p, k, mode)
  while r == -EINTR {
    r = open_once(l, p, k, mode)
  }
  r
}

fn open_once(l: Int, p: Str, k: Int, mode: Int) -> Int {
  if l == 3 {
    return windows.open_kind(p, k, mode)
  }
  if l == 2 {
    let f = match k {
      0 => darwin.O_RDONLY
      1 => darwin.O_WRONLY | darwin.O_CREAT | darwin.O_TRUNC
      2 => darwin.O_WRONLY | darwin.O_CREAT | darwin.O_APPEND
      3 => darwin.O_RDWR | darwin.O_CREAT
      // Fs.create_new: a new file only
      5 => darwin.O_WRONLY | darwin.O_CREAT | darwin.O_EXCL
      _ => darwin.O_RDWR | darwin.O_CREAT | darwin.O_EXCL
    }
    return darwin.open(p, f | darwin.O_CLOEXEC, mode)
  }
  let f = match k {
    0 => linux.O_RDONLY
    1 => linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC
    2 => linux.O_WRONLY | linux.O_CREAT | linux.O_APPEND
    3 => linux.O_RDWR | linux.O_CREAT
    5 => linux.O_WRONLY | linux.O_CREAT | linux.O_EXCL
    _ => linux.O_RDWR | linux.O_CREAT | linux.O_EXCL
  }
  linux.open(p, f | linux.O_CLOEXEC, mode)
}

fn close(l: Int, fd: Int) -> Int {
  if l == 3 {
    return windows.close(fd)
  }
  if l == 2 {
    return darwin.close(fd)
  }
  linux.close(fd)
}

/// read(2) of at most n bytes to the address a (EINTR retried).
fn read_at(l: Int, fd: Int, a: Int, n: Int) -> Int {
  if l == 3 {
    return windows.read_at(fd, a, n)
  }
  while true {
    let r = if l == 2 { darwin.read_at(fd, a, n) } else { linux.read_at(fd, a, n) }
    if r != -EINTR {
      return r
    }
  }
  0
}

/// Writes the n bytes at the address a (EINTR and short writes retried):
/// 0, or the errno.
fn write_at(l: Int, fd: Int, a: Int, n: Int) -> Int {
  if l == 3 {
    return windows.write_at(fd, a, n)
  }
  var off = 0
  while off < n {
    let w = if l == 2 { darwin.write_at(fd, a + off, n - off) } else { linux.write_at(fd, a + off, n - off) }
    if w < 0 {
      if w == -EINTR {
        continue
      }
      return -w
    }
    off += w
  }
  0
}

/// stat(2) of p (lstat(2) unless follow): st_mode and 0, or the errno.
fn stat_mode(l: Int, p: Str, follow: Bool) -> (Int, Int) {
  if l == 3 {
    return windows.stat_mode(p, follow)
  }
  if l == 2 {
    let (s, e) = darwin.stat(p, follow)
    return (s.mode, e)
  }
  let (s, e) = linux.stat(p, follow)
  (s.mode, e)
}

/// fstat(2) of fd: st_mode and 0, or the errno.
fn fstat_mode(l: Int, fd: Int) -> (Int, Int) {
  if l == 3 {
    return windows.fstat_mode(fd)
  }
  if l == 2 {
    let (s, e) = darwin.fstat(fd)
    return (s.mode, e)
  }
  let (s, e) = linux.fstat(fd)
  (s.mode, e)
}

/// Whether the st_mode m is a directory (S_IFDIR).
fn mode_dir(m: Int) -> Bool { (m & 61440) == 16384 }

fn unlink(l: Int, p: Str, dir: Bool) -> Int {
  if l == 3 {
    return windows.unlink(p, dir)
  }
  if l == 2 {
    return darwin.unlink(p, dir)
  }
  linux.unlink(p, dir)
}

fn chmod(l: Int, p: Str, mode: Int) -> Int {
  if l == 3 {
    return windows.chmod(p, mode)
  }
  if l == 2 {
    return darwin.chmod(p, mode)
  }
  linux.chmod(p, mode)
}

fn flock(l: Int, fd: Int, op: Int) -> Int {
  if l == 3 {
    return windows.flock(fd, op)
  }
  if l == 2 {
    return darwin.flock(fd, op)
  }
  linux.flock(fd, op)
}

fn dir_names(l: Int, p: Str) -> (List[Str], Int) {
  if l == 3 {
    return windows.names(p)
  }
  if l == 2 {
    return darwin.names(p)
  }
  linux.names(p)
}

/// The errno or 0 of a call's result r.
fn errno_of(r: Int) -> Int {
  if r < 0 {
    return -r
  }
  0
}

// ---------------------------------------------------------------------------
// Paths

/// The entries of directory p (not `.` and `..`, in no order); the status
/// is set (the error names x).
pub fn names(p: Str, x: Str) -> List[Str] {
  let l = layer()
  if l == 0 {
    return rt.fs_names(p, x)
  }
  let (ns, e) = dir_names(l, p)
  if e != 0 {
    fail(l, e, x)
    return []
  }
  ok()
  ns
}

/// os.Rename(a, b): the status, an error naming x.
pub fn rename(a: Str, b: Str, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_rename(a, b, x)
  }
  done(l, if l == 3 { windows.rename(a, b) } else if l == 2 { darwin.rename(a, b) } else { linux.rename(a, b) }, x)
}

/// os.Remove(p): unlink, then rmdir; the rmdir's error unless it is
/// ENOTDIR. The status, an error naming x.
pub fn remove(p: Str, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_remove(p, x)
  }
  let u = unlink(l, p, false)
  if u >= 0 {
    return ok()
  }
  let r = unlink(l, p, true)
  if r >= 0 {
    return ok()
  }
  fail(l, if r != -ENOTDIR { -r } else { -u }, x)
}

/// os.Chtimes(p, t, t), t in Unix nanoseconds: the status, an error
/// naming x.
pub fn chtimes(p: Str, t: Int, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_chtimes(p, t, x)
  }
  var s = t / 1000000000
  var ns = t % 1000000000
  if ns < 0 {
    ns += 1000000000
    s -= 1
  }
  done(l, if l == 3 { windows.utimens(p, s, ns) } else if l == 2 { darwin.utimens(p, s, ns) } else { linux.utimens(p, s, ns) }, x)
}

/// Whether paths are case sensitive: not on macOS and Windows (std/rt).
pub fn case_sensitive() -> Bool {
  if layer() == 0 {
    return rt.fs_case_sensitive()
  }
  match target.os {
    TargetOs.Darwin | TargetOs.Windows => false
    TargetOs.Linux | TargetOs.Wasi => true
  }
}

// The system calls under fspath.xo (decision 0193 step 6): each takes the
// OS path and returns 0 or the errno.

pub fn raw_mkdir(p: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_mkdir(p)
  }
  errno_of(if l == 3 { windows.mkdir(p) } else if l == 2 { darwin.mkdir(p, 493) } else { linux.mkdir(p, 493) })
}

pub fn raw_rmdir(p: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_rmdir(p)
  }
  errno_of(unlink(l, p, true))
}

pub fn raw_unlink(p: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_unlink(p)
  }
  errno_of(unlink(l, p, false))
}

/// 1 a directory, 0 another file, minus the errno (lstat unless follow).
pub fn raw_kind(p: Str, follow: Bool) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_kind(p, follow)
  }
  let (m, e) = stat_mode(l, p, follow)
  if e != 0 {
    return -e
  }
  if mode_dir(m) { 1 } else { 0 }
}

/// The entries of directory p and 0, or the errno.
pub fn raw_names(p: Str) -> (List[Str], Int) {
  let l = layer()
  if l == 0 {
    let ns = rt.fs_raw_names(p)
    return (ns, rt.fs_raw_errno())
  }
  dir_names(l, p)
}

/// Creates the file p for os.CreateTemp (O_EXCL, 0600).
pub fn raw_create(p: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_create(p)
  }
  let fd = open(l, p, 4, 384)
  if fd < 0 {
    return -fd
  }
  close(l, fd)
  0
}

/// The working directory as the system gives it.
pub fn raw_getcwd() -> Str {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_getcwd()
  }
  if l == 3 { windows.getcwd() } else if l == 2 { darwin.getcwd() } else { linux.getcwd() }
}

/// Records err (0: success) for the Xo path x: the operation's status.
pub fn raw_fail(err: Int, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_raw_fail(err, x)
  }
  if err == 0 {
    return ok()
  }
  fail(l, err, x)
}

// ---------------------------------------------------------------------------
/// A handle with no descriptor (closed): the h of a test's MemFs File
/// (std/native/testing.xo).
pub fn no_file() -> rt.FsFile { raw_file(-1, false) }

/// A lock handle that holds nothing: the h of a test's MemFs FileLock.
pub fn no_lock() -> rt.FsLock { raw_lock(-1, false) }

// File handles (decision 0163, std/rt fsfile.go): a read handle is
// buffered like Go's bufio.Reader of 64 KiB (a read larger than the
// buffer goes to the file when nothing is buffered).

/// Opens p: mode 0 for reading (a directory is EISDIR), 1 created or
/// truncated, 2 appended to (created if missing); mode 0666. The handle
/// is closed when the status is set.
pub fn open_file(p: Str, mode: Int, x: Str) -> rt.FsFile {
  let l = layer()
  if l == 0 {
    return rt.fs_open(p, mode, x)
  }
  var e = 0
  if mode == 0 {
    let (m, se) = stat_mode(l, p, true)
    if se == 0 && mode_dir(m) {
      e = EISDIR
    }
  }
  if e == 0 {
    let fd = open(l, p, mode, 438)
    if fd >= 0 {
      ok()
      return raw_file(fd, mode == 0)
    }
    e = -fd
  }
  fail(l, e, x)
  raw_file(-1, false)
}

pub fn file_closed(f: rt.FsFile) -> Bool {
  if layer() == 0 {
    return rt.fs_file_closed(f)
  }
  rt.mem_load(rt.obj_addr(f), F_FD, 8) == -1
}

/// One read into the empty buffer of the handle at a: the count, 0 at the
/// end, or the negative errno (the buffer then holds nothing).
fn fill(l: Int, a: Int) -> Int {
  rt.mem_store(a, F_R, 0, 8)
  rt.mem_store(a, F_W, 0, 8)
  let k = read_at(l, rt.mem_load(a, F_FD, 8), rt.mem_load(a, F_BUF, 8), FS_BUF)
  if k > 0 {
    rt.mem_store(a, F_W, k, 8)
  }
  k
}

/// The n bytes at the address a.
fn bytes_at(a: Int, n: Int) -> Bytes {
  let b = raw.bytes_buf(n)
  rt.mem_copy(raw.bytes_addr(b), a, n)
  b
}

/// `f.read(max)` (max > 0, at most 1 MiB): the bytes in a list of one, or
/// the empty list at the end (status 0) or on an error.
pub fn file_read(f: rt.FsFile, max: Int, x: Str) -> List[Bytes] {
  let l = layer()
  if l == 0 {
    return rt.fs_file_read(f, max, x)
  }
  let a = rt.obj_addr(f)
  let m = if max > READ_MAX { READ_MAX } else { max }
  var r = rt.mem_load(a, F_R, 8)
  var w = rt.mem_load(a, F_W, 8)
  if r == w {
    if m >= FS_BUF {
      let b = raw.bytes_buf(m)
      let k = read_at(l, rt.mem_load(a, F_FD, 8), raw.bytes_addr(b), m)
      if k < 0 {
        fail(l, -k, x)
        return []
      }
      ok()
      if k == 0 {
        return []
      }
      return [raw.bytes_len(b, k)]
    }
    let k = fill(l, a)
    if k < 0 {
      fail(l, -k, x)
      return []
    }
    ok()
    if k == 0 {
      return []
    }
    r = 0
    w = k
  }
  let k = if w - r < m { w - r } else { m }
  let out = bytes_at(rt.mem_load(a, F_BUF, 8) + r, k)
  rt.mem_store(a, F_R, r + k, 8)
  ok()
  [out]
}

/// The index of the first \n in the bytes at the address a from lo to hi,
/// or -1: eight bytes a step (scan.xo's exact test of equal bytes), the
/// rest one at a time.
fn find_newline(a: Int, lo: Int, hi: Int) -> Int {
  var i = lo
  while hi - i >= 8 {
    let y = rt.mem_load(a, i, 8) ^ NEWLINES
    let m = ((rt.int_wrap(0, y & LOW7S, LOW7S) | y) ^ -1) & HIGHS
    if m != 0 {
      return i + (rt.ctz(m) >> 3)
    }
    i += 8
  }
  while i < hi {
    if rt.mem_load(a, i, 1) == 10 {
      return i
    }
    i += 1
  }
  -1
}

/// `f.read_line()`: the line without \n or \r\n in a list of one, or the
/// empty list at the end (status 0) or on an error. A line cut by an
/// error is returned, the error on the next call (bufio's).
pub fn file_read_line(f: rt.FsFile, x: Str) -> List[Str] {
  let l = layer()
  if l == 0 {
    return rt.fs_file_read_line(f, x)
  }
  let a = rt.obj_addr(f)
  let buf = rt.mem_load(a, F_BUF, 8)
  var line = ""
  while true {
    var r = rt.mem_load(a, F_R, 8)
    var w = rt.mem_load(a, F_W, 8)
    if r == w {
      let k = fill(l, a)
      if k < 0 {
        if line.len() > 0 {
          break
        }
        fail(l, -k, x)
        return []
      }
      if k == 0 {
        if line.len() == 0 {
          ok()
          return []
        }
        break
      }
      r = 0
      w = k
    }
    let i = find_newline(buf, r, w)
    if i >= 0 {
      line = append_at(line, buf + r, i - r)
      rt.mem_store(a, F_R, i + 1, 8)
      break
    }
    line = append_at(line, buf + r, w - r)
    rt.mem_store(a, F_R, w, 8)
  }
  let n = line.len()
  if n > 0 && raw.str_byte(line, n - 1) == 13 {
    line = raw.str_slice(line, 0, n - 1)
  }
  ok()
  [line]
}

/// s and the n bytes at the address a.
fn append_at(s: Str, a: Int, n: Int) -> Str {
  if s.is_empty() {
    return raw.str_at(a, n)
  }
  s + raw.str_at(a, n)
}

/// `f.write(data)`: every byte (unbuffered), or an error's status.
pub fn file_write(f: rt.FsFile, data: Bytes, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_file_write(f, data, x)
  }
  let fd = rt.mem_load(rt.obj_addr(f), F_FD, 8)
  let e = if l == 3 { windows.write_all(fd, data) } else if l == 2 { darwin.write_all(fd, data) } else { linux.write_all(fd, data) }
  if e != 0 {
    return fail(l, e, x)
  }
  ok()
}

/// `f.close()`: a second close does nothing; EINTR is no error.
pub fn file_close(f: rt.FsFile, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_file_close(f, x)
  }
  let a = rt.obj_addr(f)
  let fd = rt.mem_load(a, F_FD, 8)
  if fd == -1 {
    return ok()
  }
  rt.mem_store(a, F_FD, -1, 8)
  let r = close(l, fd)
  if r < 0 && r != -EINTR {
    return fail(l, -r, x)
  }
  ok()
}

// ---------------------------------------------------------------------------
// Copies, modes, links

/// std/rt's realFs.copy: the contents of a into b (created or truncated)
/// with a's permission bits, also set on an existing b. An error names
/// xa, or xb once b's open was tried (as the C runtime, a read error of
/// a too).
pub fn copy(a: Str, b: Str, xa: Str, xb: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_copy(a, b, xa, xb)
  }
  var err = 0
  var to = false
  let fin = open(l, a, 0, 0)
  if fin < 0 {
    err = -fin
  } else {
    let (m, se) = fstat_mode(l, fin)
    if se != 0 {
      err = se
    } else if mode_dir(m) {
      err = EISDIR
    } else {
      let perm = m & 511
      let fout = open(l, b, 1, perm)
      to = true
      if fout < 0 {
        err = -fout
      } else {
        let buf = raw.bytes_buf(FS_BUF)
        let p = raw.bytes_addr(buf)
        while true {
          let k = read_at(l, fin, p, FS_BUF)
          if k < 0 {
            err = -k
            break
          }
          if k == 0 {
            break
          }
          err = write_at(l, fout, p, k)
          if err != 0 {
            break
          }
        }
        if buf.len() < 0 {
          // keeps buf alive through the copy loop
          err = -1
        }
        let c = close(l, fout)
        if c < 0 && err == 0 {
          err = -c
        }
        if err == 0 {
          // also over an existing file
          chmod(l, b, perm)
        }
      }
    }
    close(l, fin)
  }
  if err == 0 {
    return ok()
  }
  fail(l, err, if to { xb } else { xa })
}

/// The permission bits of p (following links), or -1 with the status
/// set.
pub fn perm(p: Str, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_perm(p, x)
  }
  let (m, e) = stat_mode(l, p, true)
  if e != 0 {
    fail(l, e, x)
    return -1
  }
  ok()
  m & 511
}

/// chmod(2) of p to mode & 0777: the status, an error naming x.
pub fn set_perm(p: Str, mode: Int, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_chmod(p, mode, x)
  }
  done(l, chmod(l, p, mode & 511), x)
}

/// A symbolic link at p to target: the status, an error naming x.
pub fn symlink(target: Str, p: Str, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_symlink(target, p, x)
  }
  done(l, if l == 3 { windows.symlink(target, p) } else if l == 2 { darwin.symlink(target, p) } else { linux.symlink(target, p) }, x)
}

/// The target of the link p in a list of one, the empty list when p is
/// not a link (status 0) or on an error.
pub fn read_link(p: Str, x: Str) -> List[Str] {
  let l = layer()
  if l == 0 {
    return rt.fs_read_link(p, x)
  }
  let (m, e) = stat_mode(l, p, false)
  if e != 0 {
    fail(l, e, x)
    return []
  }
  if (m & 61440) != 40960 {
    ok()
    return []
  }
  let (t, re) = if l == 3 { windows.readlink(p) } else if l == 2 { darwin.readlink(p) } else { linux.readlink(p) }
  if re != 0 {
    fail(l, re, x)
    return []
  }
  ok()
  [t]
}

// ---------------------------------------------------------------------------
// Advisory locks: flock(2) of a descriptor of the file (created if
// missing), which the lock handle holds.

/// Takes the lock of p, shared (LOCK_SH, decision 0214) or exclusive;
/// wait tells to wait, polling every 10 ms (a cancellation point: status
/// 8). The handle holds the lock when lock_held says so; else the status
/// tells an error or 0 (a try found it held).
pub fn lock(p: Str, wait: Bool, x: Str, shared: Bool) -> rt.FsLock {
  let l = layer()
  if l == 0 {
    if shared {
      return rt.fs_lock_shared(p, wait, x)
    }
    return rt.fs_lock(p, wait, x)
  }
  let fd = open(l, p, 3, 438)
  if fd < 0 {
    fail(l, -fd, x)
    return raw_lock(-1, false)
  }
  let op = if shared { linux.LOCK_SH } else { linux.LOCK_EX }
  let busy = if l == 3 { windows.EWOULDBLOCK } else if l == 2 { darwin.EAGAIN } else { linux.EAGAIN }
  while true {
    let r = flock(l, fd, op | linux.LOCK_NB)
    if r >= 0 {
      ok()
      return raw_lock(fd, true)
    }
    if r == -EINTR {
      continue
    }
    if r != -busy {
      close(l, fd)
      fail(l, -r, x)
      return raw_lock(-1, false)
    }
    if !wait {
      close(l, fd)
      ok()
      return raw_lock(-1, false)
    }
    // what the program printed shows before it waits
    rt.flush()
    if rt.clock_sleep_or_cancel(10000000) != 0 || rt.fs_canceled() {
      close(l, fd)
      sysio.set_err(8, "", "")
      return raw_lock(-1, false)
    }
  }
  raw_lock(-1, false)
}

pub fn lock_held(h: rt.FsLock) -> Bool {
  if layer() == 0 {
    return rt.fs_lock_held(h)
  }
  rt.mem_load(rt.obj_addr(h), L_HELD, 8) != 0
}

/// `l.unlock()`; a second unlock does nothing.
pub fn unlock(h: rt.FsLock) {
  let l = layer()
  if l == 0 {
    rt.fs_unlock(h)
    return
  }
  let a = rt.obj_addr(h)
  if rt.mem_load(a, L_HELD, 8) == 0 {
    return
  }
  let fd = rt.mem_load(a, L_FD, 8)
  rt.mem_store(a, L_HELD, 0, 8)
  rt.mem_store(a, L_FD, -1, 8)
  flock(l, fd, linux.LOCK_UN)
  close(l, fd)
}
