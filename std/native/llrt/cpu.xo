// Instructions of the CPU that Xo cannot name, as functions with a
// portable body (decision 0231): the native emitters (arm64 and LLVM)
// lower a call of each to its instruction (compiler/ssa cpu_call); a wasm
// module, and an xo older than the decision (a seed building xo), run the
// body. Each is constant time either way: no branch on data, no table, no
// comparison in the body (loops and indexes are over public counts).
//
// carry and borrow are in every arm64 and x86-64 CPU. The carry-less
// multiply, the AES rounds, and SHA-256's compression are not (an ARMv8 CPU without the crypto
// extension, an x86-64 one without PCLMULQDQ or AES-NI): a caller uses
// them only when hw() has the bit, and keeps a software path for the
// rest; a call of one lowered for a CPU without it faults on an illegal
// instruction.
use native/llrt/linux
use native/llrt/sysio
use native/rt

/// hw()'s bits: the AES rounds (aes_round, aes_last), the carry-less
/// multiply (clmul_lo, clmul_hi), SHA-256's compression (sha256_block).
pub const HW_AES: Int = 1
pub const HW_CLMUL: Int = 2
pub const HW_SHA256: Int = 8
/// fma_hw (decision 0385 stage 3): x86-64's FMA3, which needs the CPU's
/// FMA and AVX bits and the OS saving the AVX state (XGETBV); arm64's
/// fmadd is always there and lowered directly (Float.fma).
pub const HW_FMA: Int = 16
/// x86-64's SSSE3 and SSE4.1 (CPUID.1 ECX bits 9 and 19), which the SSE
/// ChaCha20 kernels use (pshufb, pinsrd; ssa x86chacha.xo): x86-64's
/// baseline is SSE2 only, as Go's GOAMD64=v1 (2026-10-27).
pub const HW_SSSE3: Int = 32
/// x86-64's AVX2 with the OS saving the ymm state (CPUID.7 EBX bit 5,
/// CPUID.1's OSXSAVE and AVX, XCR0's SSE and AVX states): the AVX2
/// ChaCha20-Poly1305 kernel (ssa x86chachapoly8.xo, 2026-10-27).
pub const HW_AVX2: Int = 64
/// arm64's CRC32 instructions (crc32x: the IEEE polynomial, as gzip, zip
/// and PNG use; decision 0231 addendum, 2026-10-28): every Apple arm64
/// CPU, and Linux's AT_HWCAP CRC32 bit. Not set on x86-64, whose SSE4.2
/// crc32 is the Castagnoli polynomial only.
pub const HW_CRC32: Int = 128
/// arm64's SHA3 extension (eor3, rax1, xar, bcax; keccak_f1600's kernel,
/// ssa a64keccak.xo, 2026-10-28): every Apple arm64 CPU. Not set on
/// Linux, as Go's crypto/sha3 does not use it there (it measured the
/// instructions slower than the scalar rounds on other arm64 cores).
pub const HW_SHA3: Int = 256
/// The bit hw() keeps in its word once it has looked.
const HW_KNOWN = 4
/// rt.static_word: hw()'s word (0 until the first call).
const W_HW = 30
/// The auxiliary vector's AT_HWCAP and its AES and PMULL bits (Linux
/// arm64).
const AT_HWCAP = 16
const HWCAP_AES = 8
const HWCAP_PMULL = 16
const HWCAP_SHA2 = 64
const HWCAP_CRC32 = 128

/// 1 when the emitter lowers this module's calls to instructions, else 0
/// (the body: a wasm module, or code an xo older than decision 0231
/// compiled, where the instructions are not there to use).
fn lowered() -> Int { 0 }

/// The ECX word of x86-64's CPUID leaf 1 (bit 1 PCLMULQDQ, bit 25
/// AES-NI); 0 off x86-64 and in the body.
fn cpuid1_ecx() -> Int { 0 }

/// The EBX word of x86-64's CPUID leaf 7, subleaf 0 (bit 29 SHA-NI); 0
/// off x86-64 and in the body (decision 0254, owner 2026-10-17).
fn cpuid7_ebx() -> Int { 0 }

/// The low word of x86-64's XCR0 (XGETBV with ECX 0: bit 1 SSE state, bit
/// 2 AVX state saved by the OS); 0 off x86-64 and in the body (decision
/// 0385 stage 3).
fn xgetbv0() -> Int { 0 }

/// x * y + z rounded once by the CPU's fused multiply-add (vfmadd231sd on
/// x86-64, decision 0385 stage 3). Call it only when hw() has HW_FMA: the
/// body (a wasm module, an older xo) never runs then, since hw() is 0
/// there; it rounds twice and is not a fused multiply-add.
pub fn fma_hw(x: Float, y: Float, z: Float) -> Float { x * y + z }

/// The instructions of this CPU that the callers can use: HW_AES,
/// HW_CLMUL, and HW_SHA256, looked up once a process (macOS on arm64:
/// always; Linux on arm64: AT_HWCAP; x86-64: CPUID leaf 1 for AES and
/// CLMUL, leaf 7 for SHA-256 (SHA-NI; checked on linux/amd64 in Docker
/// and under qemu -cpu max, 2026-10-17); otherwise none; UNTESTED on
/// Linux arm64 and on Windows).
pub fn hw() -> Int {
  let p = rt.static_word(W_HW)
  let k = rt.slot_load[Int](p, 0, 0)
  if k != 0 {
    return k & (HW_AES | HW_CLMUL | HW_SHA256 | HW_FMA | HW_SSSE3 | HW_AVX2 | HW_CRC32 | HW_SHA3)
  }
  let f = if lowered() != 0 { detect() } else { 0 }
  rt.slot_store[Int](p, 0, f | HW_KNOWN, 0)
  f
}

fn detect() -> Int {
  match target.arch {
    TargetArch.Arm64 => match target.os {
      TargetOs.Darwin => HW_AES | HW_CLMUL | HW_SHA256 | HW_CRC32 | HW_SHA3
      TargetOs.Linux => {
        let h = linux.auxval(AT_HWCAP)
        (if (h & HWCAP_AES) != 0 { HW_AES } else { 0 }) | (if (h & HWCAP_PMULL) != 0 { HW_CLMUL } else { 0 }) | (if (h & HWCAP_SHA2) != 0 { HW_SHA256 } else { 0 }) | (if (h & HWCAP_CRC32) != 0 { HW_CRC32 } else { 0 })
      }
      _ => 0
    }
    TargetArch.Amd64 => {
      let c = cpuid1_ecx()
      let b = cpuid7_ebx()
      // FMA3: CPUID.1 ECX bit 12 (FMA), 27 (OSXSAVE), 28 (AVX), and XCR0
      // with the SSE and AVX states (bits 1 and 2), as Go's x86HasFMA
      let fma_bits = (1 << 12) | (1 << 27) | (1 << 28)
      let fma = (c & fma_bits) == fma_bits && (xgetbv0() & 6) == 6
      let sse_bits = (1 << 9) | (1 << 19)
      let avx_bits = (1 << 27) | (1 << 28)
      let avx2 = (c & avx_bits) == avx_bits && (xgetbv0() & 6) == 6 && (b.shr_logical(5) & 1) != 0
      (if (c.shr_logical(25) & 1) != 0 { HW_AES } else { 0 }) | (if (c.shr_logical(1) & 1) != 0 { HW_CLMUL } else { 0 }) | (if (b.shr_logical(29) & 1) != 0 { HW_SHA256 } else { 0 }) | (if fma { HW_FMA } else { 0 }) | (if (c & sse_bits) == sse_bits { HW_SSSE3 } else { 0 }) | (if avx2 { HW_AVX2 } else { 0 })
    }
    _ => 0
  }
}

/// Keccak-f[1600]'s 24 rounds on the 25 lanes at st (lane i at st + 8 i),
/// with the round constants at rc (24 words): arm64's SHA3 extension
/// (ssa a64keccak.xo). Call it only when hw() has HW_SHA3; the body is
/// the reference.
pub fn keccak_f1600(st: Int, rc: Int) { keccak_f1600_soft(st, rc) }

/// keccak_f1600 a step at a time (FIPS 202 3.3): theta, rho and pi, chi,
/// iota on lanes loaded from st and stored back.
pub fn keccak_f1600_soft(st: Int, rc: Int) {
  var a: List[Int] = List.with_capacity(25)
  for i in 0..25 {
    a.push(rt.mem_load(st, 8 * i, 8))
  }
  var b = List[Int].with_capacity(25)
  for _ in 0..25 {
    b.push(0)
  }
  var c = [0, 0, 0, 0, 0]
  for r in 0..24 {
    for x in 0..5 {
      c[x] = a[x] ^ a[x + 5] ^ a[x + 10] ^ a[x + 15] ^ a[x + 20]
    }
    for x in 0..5 {
      let d = c[(x + 4) % 5] ^ rotl64(c[(x + 1) % 5], 1)
      for y in 0..5 {
        a[x + 5 * y] = a[x + 5 * y] ^ d
      }
    }
    // rho and pi: lane (x, y) rotated into (y, 2x + 3y)
    for x in 0..5 {
      for y in 0..5 {
        b[y + 5 * ((2 * x + 3 * y) % 5)] = rotl64(a[x + 5 * y], KECCAK_RHO[x + 5 * y])
      }
    }
    for y in 0..5 {
      for x in 0..5 {
        a[x + 5 * y] = b[x + 5 * y] ^ ((b[(x + 1) % 5 + 5 * y] ^ (0 - 1)) & b[(x + 2) % 5 + 5 * y])
      }
    }
    a[0] = a[0] ^ rt.mem_load(rc, 8 * r, 8)
  }
  for i in 0..25 {
    rt.mem_store(st, 8 * i, a[i], 8)
  }
}

/// rho's rotations by lane index x + 5 y (FIPS 202 Table 2).
const KECCAK_RHO: List[Int] = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14]

fn rotl64(x: Int, n: Int) -> Int {
  if n == 0 { x } else { x.wrapping_shl(n) | x.shr_logical(64 - n) }
}

/// The CRC-32 (IEEE, reflected; hash/crc32's IEEETable) of crc's low 32
/// bits carried over the eight bytes of w, the lowest first, with no
/// inversion before or after (arm64's crc32x; decision 0231 addendum).
/// Call it only when hw() has HW_CRC32; the body is the reference.
pub fn crc32x(crc: Int, w: Int) -> Int { crc32x_soft(crc, w) }

/// crc32x a bit at a time, with no branch on the data: each step shifts
/// one bit out and adds the polynomial under a mask of that bit.
pub fn crc32x_soft(crc: Int, w: Int) -> Int { crc_word_soft(crc, w, 0xEDB88320) }

/// crc32x for the Castagnoli polynomial (hash/crc32's Castagnoli table,
/// std/crc32 Poly.Castagnoli): arm64's crc32cx, under the same HW_CRC32
/// bit (the CRC32 extension has both). Call it only when hw() has
/// HW_CRC32; the body is the reference.
pub fn crc32cx(crc: Int, w: Int) -> Int { crc32cx_soft(crc, w) }

/// crc32cx a bit at a time.
pub fn crc32cx_soft(crc: Int, w: Int) -> Int { crc_word_soft(crc, w, 0x82F63B78) }

/// The reflected CRC-32 with polynomial poly of crc's low 32 bits over
/// the eight bytes of w, the lowest first, a bit a step.
fn crc_word_soft(crc: Int, w: Int, poly: Int) -> Int {
  var c = (crc ^ w) & 0xffffffff
  for _ in 0..32 {
    c = c.shr_logical(1) ^ (poly & (0 - (c & 1)))
  }
  c = c ^ (w.shr_logical(32) & 0xffffffff)
  for _ in 0..32 {
    c = c.shr_logical(1) ^ (poly & (0 - (c & 1)))
  }
  c
}

/// The carry out of x + y as UInt64s, 0 or 1 (bits.Add64's): the carry
/// flag of adds on arm64, llvm.uadd.with.overflow on LLVM.
pub fn carry(x: Int, y: Int) -> Int { carry_soft(x, y) }

/// carry's body (cpu_prims checks it on every backend).
pub fn carry_soft(x: Int, y: Int) -> Int {
  let s = x.wrapping_add(y)
  ((x & y) | ((x | y) & ~s)).shr_logical(63)
}

/// The borrow out of x - y as UInt64s, 0 or 1 (bits.Sub64's): the
/// carry flag of subs, inverted, on arm64; llvm.usub.with.overflow on
/// LLVM.
pub fn borrow(x: Int, y: Int) -> Int { borrow_soft(x, y) }

/// borrow's body.
pub fn borrow_soft(x: Int, y: Int) -> Int {
  let d = x.wrapping_sub(y)
  ((~x & y) | (~(x ^ y) & d)).shr_logical(63)
}

/// x + y + cin as UInt64s, wrapping (cin 0 or 1; bits.Add64's sum):
/// with adc_carry of the same operands one adcs on arm64 (the carry in
/// set by `cmp cin, #1`), a llvm.uadd.with.overflow chain on LLVM
/// (decision 0231's addendum, 2026-10-16).
pub fn adc(x: Int, y: Int, cin: Int) -> Int { adc_soft(x, y, cin) }

/// adc's body.
pub fn adc_soft(x: Int, y: Int, cin: Int) -> Int { x.wrapping_add(y).wrapping_add(cin) }

/// The carry out of x + y + cin as UInt64s, 0 or 1 (cin 0 or 1;
/// bits.Add64's carry): the flag of adc's adcs.
pub fn adc_carry(x: Int, y: Int, cin: Int) -> Int { adc_carry_soft(x, y, cin) }

/// adc_carry's body: bits.Add64's formula.
pub fn adc_carry_soft(x: Int, y: Int, cin: Int) -> Int {
  let s = x.wrapping_add(y).wrapping_add(cin)
  ((x & y) | ((x | y) & ~s)).shr_logical(63)
}

/// The high word of the 128 bit product of x and y as signed words
/// (bits.Mul64 corrected for the signs; Go's math/bits has no signed
/// form): one smulh on arm64, the high half of a one operand imulq on
/// x86-64, a sign extended i128 multiply on LLVM (2026-10-21, for
/// ints.fits, checked_mul's overflow test; the owner's approval). An
/// older xo and wasm run the body.
pub fn mul_hi_signed(x: Int, y: Int) -> Int { mul_hi_signed_soft(x, y) }

/// mul_hi_signed's body: the unsigned high word, less y when x is
/// negative and x when y is.
pub fn mul_hi_signed_soft(x: Int, y: Int) -> Int {
  var hi = x.mul_hi_unsigned(y)
  if x < 0 {
    hi = hi.wrapping_sub(y)
  }
  if y < 0 {
    hi = hi.wrapping_sub(x)
  }
  hi
}

// ---------------------------------------------------------------------------
// Carry-less multiply (PMULL on arm64, PCLMULQDQ on x86-64)

/// The low 64 bits of the carry-less product of x and y (BearSSL's
/// bmul: four strided integer products, each keeping one bit in four).
pub fn clmul_lo(x: Int, y: Int) -> Int { clmul_lo_soft(x, y) }

/// clmul_lo's body.
pub fn clmul_lo_soft(x: Int, y: Int) -> Int {
  let x0 = x & 0x1111111111111111
  let x1 = x & 0x2222222222222222
  let x2 = x & 0x4444444444444444
  let x3 = x & ~0x7777777777777777
  let y0 = y & 0x1111111111111111
  let y1 = y & 0x2222222222222222
  let y2 = y & 0x4444444444444444
  let y3 = y & ~0x7777777777777777
  let z0 = x0.wrapping_mul(y0) ^ x1.wrapping_mul(y3) ^ x2.wrapping_mul(y2) ^ x3.wrapping_mul(y1)
  let z1 = x0.wrapping_mul(y1) ^ x1.wrapping_mul(y0) ^ x2.wrapping_mul(y3) ^ x3.wrapping_mul(y2)
  let z2 = x0.wrapping_mul(y2) ^ x1.wrapping_mul(y1) ^ x2.wrapping_mul(y0) ^ x3.wrapping_mul(y3)
  let z3 = x0.wrapping_mul(y3) ^ x1.wrapping_mul(y2) ^ x2.wrapping_mul(y1) ^ x3.wrapping_mul(y0)
  (z0 & 0x1111111111111111) | (z1 & 0x2222222222222222) | (z2 & 0x4444444444444444) | (z3 & ~0x7777777777777777)
}

/// The high 64 bits of the carry-less product of x and y (bit 127 is
/// always 0): the low half of the product of the bit reversals, reversed
/// and shifted.
pub fn clmul_hi(x: Int, y: Int) -> Int { clmul_hi_soft(x, y) }

/// clmul_hi's body.
pub fn clmul_hi_soft(x: Int, y: Int) -> Int { rev64(clmul_lo_soft(rev64(x), rev64(y))).shr_logical(1) }

/// The bits of x reversed.
fn rev64(x0: Int) -> Int {
  var x = x0
  x = (x & 0x5555555555555555).wrapping_shl(1) | (x.shr_logical(1) & 0x5555555555555555)
  x = (x & 0x3333333333333333).wrapping_shl(2) | (x.shr_logical(2) & 0x3333333333333333)
  x = (x & 0x0F0F0F0F0F0F0F0F).wrapping_shl(4) | (x.shr_logical(4) & 0x0F0F0F0F0F0F0F0F)
  x.swap_bytes()
}

// ---------------------------------------------------------------------------
// AES rounds (AESE and AESMC on arm64, AESENC on x86-64)

/// One AES encryption round as arm64's AESE then AESMC: the 16 bytes at
/// st (the state, in FIPS 197's byte order) become
/// MixColumns(ShiftRows(SubBytes(st xor the 16 bytes at rk))).
pub fn aes_round(st: Int, rk: Int) { aes_round_soft(st, rk) }

/// aes_round's body.
pub fn aes_round_soft(st: Int, rk: Int) {
  let (a, b) = sub_shift(rt.mem_load(st, 0, 8) ^ rt.mem_load(rk, 0, 8), rt.mem_load(st, 8, 8) ^ rt.mem_load(rk, 8, 8))
  rt.mem_store(st, 0, mix(a), 8)
  rt.mem_store(st, 8, mix(b), 8)
}

/// The last AES encryption round: the 16 bytes at st become
/// ShiftRows(SubBytes(st xor the 16 bytes at rk)) xor the 16 bytes at
/// rk2.
pub fn aes_last(st: Int, rk: Int, rk2: Int) { aes_last_soft(st, rk, rk2) }

/// aes_last's body.
pub fn aes_last_soft(st: Int, rk: Int, rk2: Int) {
  let (a, b) = sub_shift(rt.mem_load(st, 0, 8) ^ rt.mem_load(rk, 0, 8), rt.mem_load(st, 8, 8) ^ rt.mem_load(rk, 8, 8))
  rt.mem_store(st, 0, a ^ rt.mem_load(rk2, 0, 8), 8)
  rt.mem_store(st, 8, b ^ rt.mem_load(rk2, 8, 8), 8)
}

/// The encryption of the 16 byte block at st in place with the nr + 1
/// round keys at rk (FIPS 197's byte order, 16 bytes each): AES-128 (nr
/// 10), AES-192 (12), AES-256 (14). The native emitters unroll the
/// rounds with the state in a register (arm64: one load of each round
/// key; AESENC and AESENCLAST on x86-64).
pub fn aes_enc10(st: Int, rk: Int) { aes_enc_soft(st, rk, 10) }

pub fn aes_enc12(st: Int, rk: Int) { aes_enc_soft(st, rk, 12) }

pub fn aes_enc14(st: Int, rk: Int) { aes_enc_soft(st, rk, 14) }

/// Four 16 byte blocks, the 64 bytes at st, encrypted in place with the
/// same nr + 1 round keys at rk. The arm64 emitter and LLVM there run
/// the four states side by side (one AESE and AESMC chain each, the
/// round key loaded once): a block's rounds are a chain of dependent
/// instructions, so four independent ones fill the pipeline that one
/// leaves idle. Elsewhere four aes_enc calls (AESENC on x86-64).
pub fn aes_enc10x4(st: Int, rk: Int) { aes_enc_x4(st, rk, 10) }

pub fn aes_enc12x4(st: Int, rk: Int) { aes_enc_x4(st, rk, 12) }

pub fn aes_enc14x4(st: Int, rk: Int) { aes_enc_x4(st, rk, 14) }

/// aes_enc10x4's, aes_enc12x4's, and aes_enc14x4's body: the blocks one
/// at a time through the one block intrinsics.
fn aes_enc_x4(st: Int, rk: Int, nr: Int) {
  for b in 0..4 {
    let p = st.wrapping_add(16 * b)
    match nr {
      10 => aes_enc10(p, rk)
      12 => aes_enc12(p, rk)
      _ => aes_enc14(p, rk)
    }
  }
}

/// dst = src xor AES-CTR's key stream for the n bytes (a multiple of 64)
/// at src, with the nr + 1 round keys at rk and the first counter block
/// at iv (16 bytes: a 12 byte nonce, then the counter, big endian), each
/// next block's counter one more mod 2^32 (GCM's inc32); dst and src may
/// be the same. arm64 and LLVM there run one loop with the round keys,
/// the counter and the four states in vector registers (ssa a64aesctr.xo);
/// elsewhere the counter blocks made here and aes_encNNx4 a 64 bytes.
pub fn aes_ctr10(dst: Int, src: Int, rk: Int, iv: Int, n: Int) { aes_ctr_by4(dst, src, rk, iv, n, 10) }

pub fn aes_ctr12(dst: Int, src: Int, rk: Int, iv: Int, n: Int) { aes_ctr_by4(dst, src, rk, iv, n, 12) }

pub fn aes_ctr14(dst: Int, src: Int, rk: Int, iv: Int, n: Int) { aes_ctr_by4(dst, src, rk, iv, n, 14) }

/// The counter words of block k after the one at iv: the nonce's two
/// words, the second with the counter (its top 32 bits, big endian) plus
/// k.
fn ctr_words(iv: Int, k: Int) -> (Int, Int) {
  let hi = rt.mem_load(iv, 8, 8)
  let ctr = (hi.shr_logical(32) & 0xFFFFFFFF).swap_bytes().shr_logical(32).wrapping_add(k) & 0xFFFFFFFF
  (rt.mem_load(iv, 0, 8), (hi & 0xFFFFFFFF) | ctr.swap_bytes() & ~0xFFFFFFFF)
}

/// The aes_ctr functions' body where they are not lowered: the counter
/// blocks in a list, aes_encNNx4, the xor.
fn aes_ctr_by4(dst: Int, src: Int, rk: Int, iv: Int, n: Int, nr: Int) {
  var blk = [0, 0, 0, 0, 0, 0, 0, 0]
  var i = 0
  while i + 64 <= n {
    for b in 0..4 {
      let (lo, hi) = ctr_words(iv, i / 16 + b)
      blk[2 * b] = lo
      blk[2 * b + 1] = hi
    }
    let a = addr(blk)
    match nr {
      10 => aes_enc10x4(a, rk)
      12 => aes_enc12x4(a, rk)
      _ => aes_enc14x4(a, rk)
    }
    for k in 0..8 {
      rt.mem_store(dst, i + 8 * k, rt.mem_load(src, i + 8 * k, 8) ^ rt.mem_load(a, 8 * k, 8), 8)
    }
    i += 64
  }
  keep(blk)
}

/// AES-GCM's bulk: dst = src xor AES-CTR's key stream (aes_ctr's) for
/// the n bytes (a multiple of 64), and the GHASH of the ciphertext into
/// the state at y with the H powers at hp (ghash_blocks'): sealing (enc)
/// hashes dst, opening (dec) src. arm64 and LLVM there run one loop with
/// the AES rounds and the GHASH products interleaved (ssa a64aesgcm.xo);
/// elsewhere aes_ctr and ghash_blocks.
pub fn aes_gcm_enc10(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm_by(dst, src, rk, iv, n, y, hp, 10, true) }

pub fn aes_gcm_enc12(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm_by(dst, src, rk, iv, n, y, hp, 12, true) }

pub fn aes_gcm_enc14(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm_by(dst, src, rk, iv, n, y, hp, 14, true) }

pub fn aes_gcm_dec10(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm_by(dst, src, rk, iv, n, y, hp, 10, false) }

pub fn aes_gcm_dec12(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm_by(dst, src, rk, iv, n, y, hp, 12, false) }

pub fn aes_gcm_dec14(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm_by(dst, src, rk, iv, n, y, hp, 14, false) }

/// AES-GCM's bulk eight blocks at a time: aes_gcm_enc and aes_gcm_dec
/// for n a multiple of 128 with eight H powers at hp (H^8 first, 24 bytes
/// each as ghash_blocks' four: p0, p1, p0 ^ p1). arm64 and LLVM there run
/// ssa a64aesgcm8.xo's loop (the round keys in registers, Karatsuba's
/// products, one reduction per 128 bytes, as Go's gcmAesEnc); elsewhere
/// aes_gcm8_soft. Each 128 bytes C0 to C7 take the state S to (S ^ C0)
/// P0 ^ C1 P1 ^ ... ^ C7 P7 with the table's eight entries P0 to P7,
/// which is GHASH when they are H^8 to H.
pub fn aes_gcm8_enc10(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm8_soft(dst, src, rk, iv, n, y, hp, 10, true) }

pub fn aes_gcm8_enc12(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm8_soft(dst, src, rk, iv, n, y, hp, 12, true) }

pub fn aes_gcm8_enc14(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm8_soft(dst, src, rk, iv, n, y, hp, 14, true) }

pub fn aes_gcm8_dec10(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm8_soft(dst, src, rk, iv, n, y, hp, 10, false) }

pub fn aes_gcm8_dec12(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm8_soft(dst, src, rk, iv, n, y, hp, 12, false) }

pub fn aes_gcm8_dec14(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int) { aes_gcm8_soft(dst, src, rk, iv, n, y, hp, 14, false) }

/// The aes_gcm functions' body where they are not lowered.
fn aes_gcm_by(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int, nr: Int, seal: Bool) {
  if !seal {
    ghash_blocks(y, hp, src, n)
  }
  match nr {
    10 => aes_ctr10(dst, src, rk, iv, n)
    12 => aes_ctr12(dst, src, rk, iv, n)
    _ => aes_ctr14(dst, src, rk, iv, n)
  }
  if seal {
    ghash_blocks(y, hp, dst, n)
  }
}

/// The aes_gcm8 functions' portable body (the cpu_prims golden's
/// reference): aes_ctr's key stream and ghash8_soft per 128 bytes.
pub fn aes_gcm8_soft(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int, nr: Int, seal: Bool) {
  var i = 0
  if !seal {
    while i + 128 <= n {
      ghash8_soft(y, hp, src.wrapping_add(i))
      i += 128
    }
  }
  match nr {
    10 => aes_ctr10(dst, src, rk, iv, n)
    12 => aes_ctr12(dst, src, rk, iv, n)
    _ => aes_ctr14(dst, src, rk, iv, n)
  }
  if seal {
    while i + 128 <= n {
      ghash8_soft(y, hp, dst.wrapping_add(i))
      i += 128
    }
  }
}

/// The aes_gcm functions' portable body (the cpu_prims golden's
/// reference).
pub fn aes_gcm_soft(dst: Int, src: Int, rk: Int, iv: Int, n: Int, y: Int, hp: Int, nr: Int, seal: Bool) {
  if !seal {
    ghash_blocks_soft(y, hp, src, n)
  }
  aes_ctr_soft(dst, src, rk, iv, n, nr)
  if seal {
    ghash_blocks_soft(y, hp, dst, n)
  }
}

/// The aes_ctr functions' portable body (the cpu_prims golden's
/// reference): a block at a time through aes_enc_soft.
pub fn aes_ctr_soft(dst: Int, src: Int, rk: Int, iv: Int, n: Int, nr: Int) {
  var blk = [0, 0]
  var i = 0
  while i + 16 <= n {
    let (lo, hi) = ctr_words(iv, i / 16)
    blk[0] = lo
    blk[1] = hi
    aes_enc_soft(addr(blk), rk, nr)
    for k in 0..2 {
      rt.mem_store(dst, i + 8 * k, rt.mem_load(src, i + 8 * k, 8) ^ rt.mem_load(addr(blk), 8 * k, 8), 8)
    }
    i += 16
  }
  keep(blk)
}

/// The four block functions' portable body (the cpu_prims golden's
/// reference).
pub fn aes_enc_x4_soft(st: Int, rk: Int, nr: Int) {
  for b in 0..4 {
    aes_enc_soft(st.wrapping_add(16 * b), rk, nr)
  }
}

/// aes_enc10's, aes_enc12's, and aes_enc14's body.
pub fn aes_enc_soft(st: Int, rk: Int, nr: Int) {
  for r in 0..nr - 1 {
    aes_round_soft(st, rk.wrapping_add(r.wrapping_shl(4)))
  }
  let last = rk.wrapping_add((nr - 1).wrapping_shl(4))
  aes_last_soft(st, last, last.wrapping_add(16))
}

const B01 = 0x0101010101010101
const B7F = 0x7F7F7F7F7F7F7F7F

/// Each byte of x times 2 in AES's field (eight at once).
fn xt(x: Int) -> Int { (x & B7F).wrapping_shl(1) ^ (x.shr_logical(7) & B01).wrapping_mul(0x1B) }

/// Each byte of a times the same byte of b in AES's field.
fn gmul(a0: Int, b: Int) -> Int {
  var a = a0
  var r = 0
  for i in 0..8 {
    r = r ^ (a & (b.shr_logical(i) & B01).wrapping_mul(0xFF))
    a = xt(a)
  }
  r
}

/// Each byte of x rotated left by k (1 to 7) bits.
fn rotb(x: Int, k: Int) -> Int {
  let lo = B01.wrapping_mul((1).wrapping_shl(k) - 1)
  (x.wrapping_shl(k) & ~lo) | (x.shr_logical(8 - k) & lo)
}

/// The S-box on each byte of x: the inverse x^254, then the affine map.
fn sub8(x: Int) -> Int {
  let x2 = gmul(x, x)
  let x3 = gmul(x2, x)
  let x6 = gmul(x3, x3)
  let x12 = gmul(x6, x6)
  let x15 = gmul(x12, x3)
  var t = x15
  for _ in 0..4 {
    t = gmul(t, t)
  }
  let inv = gmul(gmul(t, x12), x2)
  inv ^ rotb(inv, 1) ^ rotb(inv, 2) ^ rotb(inv, 3) ^ rotb(inv, 4) ^ 0x6363636363636363
}

/// SubBytes then ShiftRows of the state in two words (bytes 0 to 7 and
/// 8 to 15, byte r + 4c the row r and column c).
fn sub_shift(a0: Int, b0: Int) -> (Int, Int) {
  let a = sub8(a0)
  let b = sub8(b0)
  var lo = 0
  var hi = 0
  for i in 0..16 {
    let r = i & 3
    let j = r + 4 * ((i / 4 + r) & 3)
    let w = if j < 8 { a } else { b }
    let v = (w.shr_logical(8 * (j & 7)) & 0xFF).wrapping_shl(8 * (i & 7))
    if i < 8 {
      lo = lo | v
    } else {
      hi = hi | v
    }
  }
  (lo, hi)
}

/// MixColumns of the two columns in x (one per 32 bit half, row r in
/// byte r).
fn mix(x: Int) -> Int {
  let r1 = rotc(x)
  let r2 = rotc(r1)
  let r3 = rotc(r2)
  xt(x ^ r1) ^ r1 ^ r2 ^ r3
}

/// Each 32 bit half of x rotated down by a byte (byte r gets byte r + 1).
fn rotc(x: Int) -> Int { (x.shr_logical(8) & 0x00FFFFFF00FFFFFF) | (x.wrapping_shl(24) & ~0x00FFFFFF00FFFFFF) }

// ---------------------------------------------------------------------------
// SHA-256's compression (SHA256H, SHA256H2, SHA256SU0, SHA256SU1 on arm64)

/// FIPS 180-4's SHA-256 compression of one block: the 8 state words at st
/// (a to h, one UInt32 in each 8 byte word, as digest_tables.xo keeps
/// them) take in the 64 bytes at p, with the 64 round constants at k (4
/// byte little endian words, 256 bytes). arm64: the state in two vector
/// registers and the four rounds of each SHA256H and SHA256H2 (owner,
/// 2026-10-16, decision 0231).
pub fn sha256_block(st: Int, p: Int, k: Int) { sha256_block_soft(st, p, k) }

/// The big endian 32 bit word at a + o.
fn be32(a: Int, o: Int) -> Int { rt.mem_load(a, o, 4).swap_bytes().shr_logical(32) }

/// x + y as UInt32s.
fn add32(x: Int, y: Int) -> Int { x.wrapping_add(y) & 0xFFFFFFFF }

/// sha256_block's body: FIPS 180-4 6.2.2 on the words in memory.
pub fn sha256_block_soft(st: Int, p: Int, k: Int) {
  var w: List[Int] = []
  for i in 0..16 {
    w.push(be32(p, 4 * i))
  }
  for i in 16..64 {
    let x = w[i - 15]
    let y = w[i - 2]
    let s0 = x.rotate_right32(7) ^ x.rotate_right32(18) ^ x.shr_logical(3)
    let s1 = y.rotate_right32(17) ^ y.rotate_right32(19) ^ y.shr_logical(10)
    w.push(add32(add32(w[i - 16], s0), add32(w[i - 7], s1)))
  }
  var a = rt.mem_load(st, 0, 8)
  var b = rt.mem_load(st, 8, 8)
  var c = rt.mem_load(st, 16, 8)
  var d = rt.mem_load(st, 24, 8)
  var e = rt.mem_load(st, 32, 8)
  var f = rt.mem_load(st, 40, 8)
  var g = rt.mem_load(st, 48, 8)
  var h = rt.mem_load(st, 56, 8)
  for i in 0..64 {
    let s1 = e.rotate_right32(6) ^ e.rotate_right32(11) ^ e.rotate_right32(25)
    let ch = g ^ (e & (f ^ g))
    let t1 = add32(add32(add32(h, s1), add32(ch, rt.mem_load(k, 4 * i, 4))), w[i])
    let s0 = a.rotate_right32(2) ^ a.rotate_right32(13) ^ a.rotate_right32(22)
    let maj = (a & b) | (c & (a | b))
    let t2 = add32(s0, maj)
    h = g
    g = f
    f = e
    e = add32(d, t1)
    d = c
    c = b
    b = a
    a = add32(t1, t2)
  }
  rt.mem_store(st, 0, add32(rt.mem_load(st, 0, 8), a), 8)
  rt.mem_store(st, 8, add32(rt.mem_load(st, 8, 8), b), 8)
  rt.mem_store(st, 16, add32(rt.mem_load(st, 16, 8), c), 8)
  rt.mem_store(st, 24, add32(rt.mem_load(st, 24, 8), d), 8)
  rt.mem_store(st, 32, add32(rt.mem_load(st, 32, 8), e), 8)
  rt.mem_store(st, 40, add32(rt.mem_load(st, 40, 8), f), 8)
  rt.mem_store(st, 48, add32(rt.mem_load(st, 48, 8), g), 8)
  rt.mem_store(st, 56, add32(rt.mem_load(st, 56, 8), h), 8)
}

// ---------------------------------------------------------------------------
// Checks

/// The address of the first word of xs.
fn addr(xs: List[Int]) -> Int { rt.obj_addr(xs).wrapping_add(rt.layout(2)) }

/// A use of xs after its last raw access.
fn keep(xs: List[Int]) {
  if xs.len() < 0 {
    return
  }
}

/// The 16 bytes of the words lo and hi, little endian.
fn words16(lo: Int, hi: Int) -> Bytes { rt.rs_push_word(rt.rs_push_word(rt.rs_with_cap(16), lo, 8), hi, 8).bytes() }

/// The 16 bytes of b in a new list of two words.
fn block(b: Bytes) -> List[Int] { [rt.bytes_word(b, 0), rt.bytes_word(b, 8)] }

/// internal.crypto_op's "cpu." ops (std/internal.xo): carry (the 8
/// byte little endian words a and b; the carry and the borrow, a byte
/// each), clmul (the product's low then high word), aes_round (the 16
/// byte state a, round key b), aes_last (state a, round keys b and c),
/// sha256_block (the state a as 8 four byte little endian words, the 64
/// byte block b, the round constants c as sha256_block takes them; the
/// new state as a was), mul_hi_signed (the words a and b; the high word);
/// with `_soft` after the name, the body, on every backend (without it,
/// the instructions on arm64 and LLVM, on a CPU that has them). None if
/// unknown.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  if what == "hw" {
    // hw()'s bits in decimal (the goldens call a lowered intrinsic only
    // when the CPU has it)
    return Some("${hw()}".bytes())
  }
  let soft = what.ends_with("_soft")
  match what.trim_suffix("_soft") {
    "carry" => {
      let x = rt.bytes_word(a, 0)
      let y = rt.bytes_word(b, 0)
      let k = if soft { carry_soft(x, y) } else { carry(x, y) }
      let w = if soft { borrow_soft(x, y) } else { borrow(x, y) }
      Some(rt.rs_push_byte(rt.rs_push_byte(rt.rs_with_cap(2), k), w).bytes())
    }
    "adc" => {
      // the sum and the carry of a + b + cin for cin 0 and 1: 18 bytes
      let x = rt.bytes_word(a, 0)
      let y = rt.bytes_word(b, 0)
      var o = rt.rs_with_cap(18)
      for cin in [0, 1] {
        let s = if soft { adc_soft(x, y, cin) } else { adc(x, y, cin) }
        let k = if soft { adc_carry_soft(x, y, cin) } else { adc_carry(x, y, cin) }
        for i in 0..8 {
          o = rt.rs_push_byte(o, s.shr_logical(8 * i) & 255)
        }
        o = rt.rs_push_byte(o, k)
      }
      Some(o.bytes())
    }
    "mul_hi_signed" => {
      // the signed high word of a times b (8 byte little endian words)
      let x = rt.bytes_word(a, 0)
      let y = rt.bytes_word(b, 0)
      let h = if soft { mul_hi_signed_soft(x, y) } else { mul_hi_signed(x, y) }
      Some(rt.rs_push_word(rt.rs_with_cap(8), h, 8).bytes())
    }
    "clmul" => {
      let x = rt.bytes_word(a, 0)
      let y = rt.bytes_word(b, 0)
      Some(if soft { words16(clmul_lo_soft(x, y), clmul_hi_soft(x, y)) } else { words16(clmul_lo(x, y), clmul_hi(x, y)) })
    }
    "aes_enc" => {
      // a 16 byte key (AES-128's ten rounds) expanded by the caller: b
      // is the 176 bytes of round keys
      let st = block(a)
      var k: List[Int] = []
      for i in 0..22 {
        k.push(rt.bytes_word(b, 8 * i))
      }
      if soft {
        aes_enc_soft(addr(st), addr(k), 10)
      } else {
        aes_enc10(addr(st), addr(k))
      }
      let r = words16(rt.mem_load(addr(st), 0, 8), rt.mem_load(addr(st), 8, 8))
      keep(st)
      keep(k)
      Some(r)
    }
    "aes_gcm8_enc" | "aes_gcm8_dec" | "aes_gcm8_enc_ip" | "aes_gcm8_dec_ip" => {
      // as aes_gcm_enc's, a a multiple of 128 bytes and d the state then
      // eight entries (128 bytes)
      let seal = what.starts_with("aes_gcm8_enc")
      let ip = what.trim_suffix("_soft").ends_with("_ip")
      var src: List[Int] = []
      for i in 0..a.len() / 8 {
        src.push(rt.bytes_word(a, 8 * i))
      }
      var dst: List[Int] = []
      for _ in 0..a.len() / 8 {
        dst.push(0)
      }
      let nr = b.len() / 16 - 1
      var k: List[Int] = []
      for i in 0..b.len() / 8 {
        k.push(rt.bytes_word(b, 8 * i))
      }
      let iv = block(c)
      let st = [rt.bytes_word(d, 0), rt.bytes_word(d, 8)]
      var hk: List[Int] = []
      for i in 0..8 {
        let p0 = rt.bytes_word(d, 16 + 16 * i)
        let p1 = rt.bytes_word(d, 16 + 16 * i + 8)
        hk = hk + [p0, p1, p0 ^ p1]
      }
      let ps = addr(src)
      let pd = if ip { ps } else { addr(dst) }
      let (pk, pi, py, ph) = (addr(k), addr(iv), addr(st), addr(hk))
      if soft {
        aes_gcm8_soft(pd, ps, pk, pi, a.len(), py, ph, nr, seal)
      } else if seal {
        match nr {
          10 => aes_gcm8_enc10(pd, ps, pk, pi, a.len(), py, ph)
          12 => aes_gcm8_enc12(pd, ps, pk, pi, a.len(), py, ph)
          _ => aes_gcm8_enc14(pd, ps, pk, pi, a.len(), py, ph)
        }
      } else {
        match nr {
          10 => aes_gcm8_dec10(pd, ps, pk, pi, a.len(), py, ph)
          12 => aes_gcm8_dec12(pd, ps, pk, pi, a.len(), py, ph)
          _ => aes_gcm8_dec14(pd, ps, pk, pi, a.len(), py, ph)
        }
      }
      var o = rt.rs_with_cap(a.len() + 16)
      for i in 0..a.len() / 8 {
        o = rt.rs_push_word(o, rt.mem_load(pd, 8 * i, 8), 8)
      }
      o = rt.rs_push_word(o, rt.mem_load(py, 0, 8), 8)
      o = rt.rs_push_word(o, rt.mem_load(py, 8, 8), 8)
      keep(src)
      keep(dst)
      keep(k)
      keep(iv)
      keep(st)
      keep(hk)
      Some(o.bytes())
    }
    "aes_gcm_enc" | "aes_gcm_dec" | "aes_gcm_enc_ip" | "aes_gcm_dec_ip" => {
      // the data a (a multiple of 64 bytes), the round keys b, the
      // counter block c, and d: the GHASH state (16 bytes) then the H
      // powers (64, as ghash4); the output and then the new state. _ip:
      // in place (dst is src)
      let seal = what.starts_with("aes_gcm_enc")
      let ip = what.trim_suffix("_soft").ends_with("_ip")
      var src: List[Int] = []
      for i in 0..a.len() / 8 {
        src.push(rt.bytes_word(a, 8 * i))
      }
      var dst: List[Int] = []
      for _ in 0..a.len() / 8 {
        dst.push(0)
      }
      let nr = b.len() / 16 - 1
      var k: List[Int] = []
      for i in 0..b.len() / 8 {
        k.push(rt.bytes_word(b, 8 * i))
      }
      let iv = block(c)
      let st = [rt.bytes_word(d, 0), rt.bytes_word(d, 8)]
      var hk: List[Int] = []
      for i in 0..4 {
        let p0 = rt.bytes_word(d, 16 + 16 * i)
        let p1 = rt.bytes_word(d, 16 + 16 * i + 8)
        hk = hk + [p0, p1, p0 ^ p1]
      }
      let ps = addr(src)
      let pd = if ip { ps } else { addr(dst) }
      let (pk, pi, py, ph) = (addr(k), addr(iv), addr(st), addr(hk))
      if soft {
        aes_gcm_soft(pd, ps, pk, pi, a.len(), py, ph, nr, seal)
      } else if seal {
        match nr {
          10 => aes_gcm_enc10(pd, ps, pk, pi, a.len(), py, ph)
          12 => aes_gcm_enc12(pd, ps, pk, pi, a.len(), py, ph)
          _ => aes_gcm_enc14(pd, ps, pk, pi, a.len(), py, ph)
        }
      } else {
        match nr {
          10 => aes_gcm_dec10(pd, ps, pk, pi, a.len(), py, ph)
          12 => aes_gcm_dec12(pd, ps, pk, pi, a.len(), py, ph)
          _ => aes_gcm_dec14(pd, ps, pk, pi, a.len(), py, ph)
        }
      }
      var o = rt.rs_with_cap(a.len() + 16)
      for i in 0..a.len() / 8 {
        o = rt.rs_push_word(o, rt.mem_load(pd, 8 * i, 8), 8)
      }
      o = rt.rs_push_word(o, rt.mem_load(py, 0, 8), 8)
      o = rt.rs_push_word(o, rt.mem_load(py, 8, 8), 8)
      keep(src)
      keep(dst)
      keep(k)
      keep(iv)
      keep(st)
      keep(hk)
      Some(o.bytes())
    }
    "aes_ctr" => {
      // the data a (a multiple of 64 bytes) under the round keys b (176,
      // 208 or 240 bytes) from the counter block c (16 bytes)
      var src: List[Int] = []
      for i in 0..a.len() / 8 {
        src.push(rt.bytes_word(a, 8 * i))
      }
      var dst: List[Int] = []
      for _ in 0..a.len() / 8 {
        dst.push(0)
      }
      let nr = b.len() / 16 - 1
      var k: List[Int] = []
      for i in 0..b.len() / 8 {
        k.push(rt.bytes_word(b, 8 * i))
      }
      let iv = block(c)
      if soft {
        aes_ctr_soft(addr(dst), addr(src), addr(k), addr(iv), a.len(), nr)
      } else if nr == 10 {
        aes_ctr10(addr(dst), addr(src), addr(k), addr(iv), a.len())
      } else if nr == 12 {
        aes_ctr12(addr(dst), addr(src), addr(k), addr(iv), a.len())
      } else {
        aes_ctr14(addr(dst), addr(src), addr(k), addr(iv), a.len())
      }
      var o = rt.rs_with_cap(a.len())
      for i in 0..dst.len() {
        o = rt.rs_push_word(o, rt.mem_load(addr(dst), 8 * i, 8), 8)
      }
      keep(src)
      keep(dst)
      keep(k)
      keep(iv)
      Some(o.bytes())
    }
    "aes_enc4" => {
      // four 16 byte blocks a (64 bytes) under the round keys b: 176
      // bytes (AES-128), 208 (AES-192) or 240 (AES-256)
      var st: List[Int] = []
      for i in 0..8 {
        st.push(rt.bytes_word(a, 8 * i))
      }
      let nr = b.len() / 16 - 1
      var k: List[Int] = []
      for i in 0..b.len() / 8 {
        k.push(rt.bytes_word(b, 8 * i))
      }
      if soft {
        aes_enc_x4_soft(addr(st), addr(k), nr)
      } else if nr == 10 {
        aes_enc10x4(addr(st), addr(k))
      } else if nr == 12 {
        aes_enc12x4(addr(st), addr(k))
      } else {
        aes_enc14x4(addr(st), addr(k))
      }
      var o = rt.rs_with_cap(64)
      for i in 0..8 {
        o = rt.rs_push_word(o, rt.mem_load(addr(st), 8 * i, 8), 8)
      }
      keep(st)
      keep(k)
      Some(o.bytes())
    }
    "aes_round" | "aes_last" => {
      let st = block(a)
      let k = block(b)
      let k2 = block(if what.starts_with("aes_last") { c } else { b })
      if what == "aes_round" {
        aes_round(addr(st), addr(k))
      } else if what == "aes_round_soft" {
        aes_round_soft(addr(st), addr(k))
      } else if what == "aes_last" {
        aes_last(addr(st), addr(k), addr(k2))
      } else {
        aes_last_soft(addr(st), addr(k), addr(k2))
      }
      let r = words16(rt.mem_load(addr(st), 0, 8), rt.mem_load(addr(st), 8, 8))
      keep(st)
      keep(k)
      keep(k2)
      Some(r)
    }
    "ghash4" => {
      // the state a (16 bytes: y1, y0), the H powers b (64 bytes: p0, p1
      // a block; p2 = p0 ^ p1 here), the 64 bytes c; the new state
      let st = block(a)
      var k: List[Int] = []
      for i in 0..4 {
        let p0 = rt.bytes_word(b, 16 * i)
        let p1 = rt.bytes_word(b, 16 * i + 8)
        k = k + [p0, p1, p0 ^ p1]
      }
      var blk: List[Int] = []
      for i in 0..8 {
        blk.push(rt.bytes_word(c, 8 * i))
      }
      if soft {
        ghash4_soft(addr(st), addr(k), addr(blk))
      } else {
        ghash4(addr(st), addr(k), addr(blk))
      }
      let r = words16(rt.mem_load(addr(st), 0, 8), rt.mem_load(addr(st), 8, 8))
      keep(st)
      keep(k)
      keep(blk)
      Some(r)
    }
    "ghash_blocks" => {
      // the state a (16 bytes), the H powers b (64 bytes, as ghash4),
      // the data c (a multiple of 64 bytes); the new state
      let st = block(a)
      var k: List[Int] = []
      for i in 0..4 {
        let p0 = rt.bytes_word(b, 16 * i)
        let p1 = rt.bytes_word(b, 16 * i + 8)
        k = k + [p0, p1, p0 ^ p1]
      }
      var blk: List[Int] = []
      for i in 0..c.len() / 8 {
        blk.push(rt.bytes_word(c, 8 * i))
      }
      if soft {
        ghash_blocks_soft(addr(st), addr(k), addr(blk), c.len())
      } else {
        ghash_blocks(addr(st), addr(k), addr(blk), c.len())
      }
      let r = words16(rt.mem_load(addr(st), 0, 8), rt.mem_load(addr(st), 8, 8))
      keep(st)
      keep(k)
      keep(blk)
      Some(r)
    }
    "sha256_block" => {
      var st: List[Int] = []
      for i in 0..8 {
        st.push(rt.bytes_word(a, 4 * (i & 6)).wrapping_shl(32 * (1 - (i & 1))).shr_logical(32))
      }
      let blk = [rt.bytes_word(b, 0), rt.bytes_word(b, 8), rt.bytes_word(b, 16), rt.bytes_word(b, 24), rt.bytes_word(b, 32), rt.bytes_word(b, 40), rt.bytes_word(b, 48), rt.bytes_word(b, 56)]
      var k: List[Int] = []
      for i in 0..32 {
        k.push(rt.bytes_word(c, 8 * i))
      }
      if soft {
        sha256_block_soft(addr(st), addr(blk), addr(k))
      } else {
        sha256_block(addr(st), addr(blk), addr(k))
      }
      var o = rt.rs_with_cap(32)
      for i in 0..8 {
        o = rt.rs_push_word(o, rt.mem_load(addr(st), 8 * i, 8), 4)
      }
      keep(st)
      keep(blk)
      keep(k)
      Some(o.bytes())
    }
    _ => None
  }
}

// ---------------------------------------------------------------------------
// GHASH four blocks at a time (decision 0339)

/// GHASH (NIST SP 800-38D) of the 64 bytes at d into the state at y (two
/// words: y1, the high 64 bits, then y0, each as std/native/llrt
/// aesgcm.xo keeps them): y = ((((y ^ b0) H^4) ^ (b1 H^3)) ^ (b2 H^2)) ^
/// (b3 H) with one reduction, the blocks' 8 byte halves byte swapped.
/// hp: the H powers, three words a block j (0 to 3, H^(4 - j)): p0 for
/// the block's low half x0, p1 for its high half x1, p2 = p0 ^ p1 for
/// (x0 ^ x1) (Karatsuba; the NEON lowering does not read p2, so it must
/// be p0 ^ p1). Only on a CPU with HW_CLMUL. The arm64 emitter
/// and LLVM on arm64 use pmull and pmull2 (ssa a64ghash.xo); this is the
/// portable body (aesgcm.xo ghash64's).
pub fn ghash4(y: Int, hp: Int, d: Int) { ghash4_soft(y, hp, d) }

fn ghash_shl(x: Int, s: Int) -> Int { x.wrapping_shl(s) }

fn ghash_shr(x: Int, s: Int) -> Int { x.shr_logical(s) }

/// The GHASH of the n bytes at d (a multiple of 64) into the state at y,
/// 64 bytes at a time as ghash4, with the same H powers at hp. arm64 and
/// LLVM there run one loop with the state and the powers in vector
/// registers (ssa a64ghash.xo ghash_loop_lines); elsewhere a ghash4 per
/// 64 bytes.
pub fn ghash_blocks(y: Int, hp: Int, d: Int, n: Int) { ghash_blocks_by4(y, hp, d, n) }

/// ghash_blocks' body on the targets that do not lower it.
fn ghash_blocks_by4(y: Int, hp: Int, d: Int, n: Int) {
  var i = 0
  while i + 64 <= n {
    ghash4(y, hp, d.wrapping_add(i))
    i += 64
  }
}

/// ghash_blocks' portable body (the cpu_prims golden's reference).
pub fn ghash_blocks_soft(y: Int, hp: Int, d: Int, n: Int) {
  var i = 0
  while i + 64 <= n {
    ghash4_soft(y, hp, d.wrapping_add(i))
    i += 64
  }
}

/// ghash4's body.
pub fn ghash4_soft(y: Int, hp: Int, d: Int) {
  let x1_0 = rt.mem_load(y, 0, 8) ^ rt.mem_load(d, 0, 8).swap_bytes()
  let x0_0 = rt.mem_load(y, 8, 8) ^ rt.mem_load(d, 8, 8).swap_bytes()
  let p0_0 = rt.mem_load(hp, 0, 8)
  let p1_0 = rt.mem_load(hp, 8, 8)
  let p2_0 = rt.mem_load(hp, 16, 8)
  let a0_0 = clmul_lo(x0_0, p0_0)
  let b0_0 = clmul_hi(x0_0, p0_0)
  let a1_0 = clmul_lo(x1_0, p1_0)
  let b1_0 = clmul_hi(x1_0, p1_0)
  let x2_0 = x0_0 ^ x1_0
  let c0_0 = clmul_lo(x2_0, p2_0)
  let c1_0 = clmul_hi(x2_0, p2_0)
  let x1_1 = rt.mem_load(d, 16, 8).swap_bytes()
  let x0_1 = rt.mem_load(d, 24, 8).swap_bytes()
  let p0_1 = rt.mem_load(hp, 24, 8)
  let p1_1 = rt.mem_load(hp, 32, 8)
  let p2_1 = rt.mem_load(hp, 40, 8)
  let a0_1 = a0_0 ^ clmul_lo(x0_1, p0_1)
  let b0_1 = b0_0 ^ clmul_hi(x0_1, p0_1)
  let a1_1 = a1_0 ^ clmul_lo(x1_1, p1_1)
  let b1_1 = b1_0 ^ clmul_hi(x1_1, p1_1)
  let x2_1 = x0_1 ^ x1_1
  let c0_1 = c0_0 ^ clmul_lo(x2_1, p2_1)
  let c1_1 = c1_0 ^ clmul_hi(x2_1, p2_1)
  let x1_2 = rt.mem_load(d, 32, 8).swap_bytes()
  let x0_2 = rt.mem_load(d, 40, 8).swap_bytes()
  let p0_2 = rt.mem_load(hp, 48, 8)
  let p1_2 = rt.mem_load(hp, 56, 8)
  let p2_2 = rt.mem_load(hp, 64, 8)
  let a0_2 = a0_1 ^ clmul_lo(x0_2, p0_2)
  let b0_2 = b0_1 ^ clmul_hi(x0_2, p0_2)
  let a1_2 = a1_1 ^ clmul_lo(x1_2, p1_2)
  let b1_2 = b1_1 ^ clmul_hi(x1_2, p1_2)
  let x2_2 = x0_2 ^ x1_2
  let c0_2 = c0_1 ^ clmul_lo(x2_2, p2_2)
  let c1_2 = c1_1 ^ clmul_hi(x2_2, p2_2)
  let x1_3 = rt.mem_load(d, 48, 8).swap_bytes()
  let x0_3 = rt.mem_load(d, 56, 8).swap_bytes()
  let p0_3 = rt.mem_load(hp, 72, 8)
  let p1_3 = rt.mem_load(hp, 80, 8)
  let p2_3 = rt.mem_load(hp, 88, 8)
  let a0_3 = a0_2 ^ clmul_lo(x0_3, p0_3)
  let b0_3 = b0_2 ^ clmul_hi(x0_3, p0_3)
  let a1_3 = a1_2 ^ clmul_lo(x1_3, p1_3)
  let b1_3 = b1_2 ^ clmul_hi(x1_3, p1_3)
  let x2_3 = x0_3 ^ x1_3
  let c0_3 = c0_2 ^ clmul_lo(x2_3, p2_3)
  let c1_3 = c1_2 ^ clmul_hi(x2_3, p2_3)
  let a0 = a0_3
  let b0 = b0_3
  let a1 = a1_3
  let b1 = b1_3
  let c0 = c0_3
  let c1 = c1_3
  let z2l = c0 ^ a0 ^ a1
  let z2h = c1 ^ b0 ^ b1
  // reduce, inline
  let v1a = b0 ^ z2l
  let v2a = a1 ^ z2h
  let s3 = ghash_shl(b1, 1) | ghash_shr(v2a, 63)
  var s2 = ghash_shl(v2a, 1) | ghash_shr(v1a, 63)
  var s1 = ghash_shl(v1a, 1) | ghash_shr(a0, 63)
  let s0 = ghash_shl(a0, 1)
  s2 = s2 ^ s0 ^ ghash_shr(s0, 1) ^ ghash_shr(s0, 2) ^ ghash_shr(s0, 7)
  s1 = s1 ^ ghash_shl(s0, 63) ^ ghash_shl(s0, 62) ^ ghash_shl(s0, 57)
  let y1 = s3 ^ s1 ^ ghash_shr(s1, 1) ^ ghash_shr(s1, 2) ^ ghash_shr(s1, 7)
  let y0 = s2 ^ ghash_shl(s1, 63) ^ ghash_shl(s1, 62) ^ ghash_shl(s1, 57)
  rt.mem_store(y, 0, y1, 8)
  rt.mem_store(y, 8, y0, 8)
}

/// The GHASH of the 128 bytes at d into the state at y with the eight
/// entries at hp (24 bytes each: p0, p1, p0 ^ p1): (S ^ C0) P0 ^ C1 P1 ^
/// ... ^ C7 P7, ghash4_soft's products and reduction over eight blocks
/// (aes_gcm8's).
pub fn ghash8_soft(y: Int, hp: Int, d: Int) {
  var a0 = 0
  var b0 = 0
  var a1 = 0
  var b1 = 0
  var c0 = 0
  var c1 = 0
  for j in 0..8 {
    var x1 = rt.mem_load(d, 16 * j, 8).swap_bytes()
    var x0 = rt.mem_load(d, 16 * j + 8, 8).swap_bytes()
    if j == 0 {
      x1 = x1 ^ rt.mem_load(y, 0, 8)
      x0 = x0 ^ rt.mem_load(y, 8, 8)
    }
    let p0 = rt.mem_load(hp, 24 * j, 8)
    let p1 = rt.mem_load(hp, 24 * j + 8, 8)
    let p2 = rt.mem_load(hp, 24 * j + 16, 8)
    a0 = a0 ^ clmul_lo(x0, p0)
    b0 = b0 ^ clmul_hi(x0, p0)
    a1 = a1 ^ clmul_lo(x1, p1)
    b1 = b1 ^ clmul_hi(x1, p1)
    let x2 = x0 ^ x1
    c0 = c0 ^ clmul_lo(x2, p2)
    c1 = c1 ^ clmul_hi(x2, p2)
  }
  let z2l = c0 ^ a0 ^ a1
  let z2h = c1 ^ b0 ^ b1
  let v1a = b0 ^ z2l
  let v2a = a1 ^ z2h
  let s3 = ghash_shl(b1, 1) | ghash_shr(v2a, 63)
  var s2 = ghash_shl(v2a, 1) | ghash_shr(v1a, 63)
  var s1 = ghash_shl(v1a, 1) | ghash_shr(a0, 63)
  let s0 = ghash_shl(a0, 1)
  s2 = s2 ^ s0 ^ ghash_shr(s0, 1) ^ ghash_shr(s0, 2) ^ ghash_shr(s0, 7)
  s1 = s1 ^ ghash_shl(s0, 63) ^ ghash_shl(s0, 62) ^ ghash_shl(s0, 57)
  let y1 = s3 ^ s1 ^ ghash_shr(s1, 1) ^ ghash_shr(s1, 2) ^ ghash_shr(s1, 7)
  let y0 = s2 ^ ghash_shl(s1, 63) ^ ghash_shl(s1, 62) ^ ghash_shl(s1, 57)
  rt.mem_store(y, 0, y1, 8)
  rt.mem_store(y, 8, y0, 8)
}

// ---------------------------------------------------------------------------
// ChaCha20 four blocks at a time (decision 0329)

/// dst = src xor four blocks of ChaCha20's key stream (RFC 8439 2.3):
/// 256 bytes each at dst and src (they may be the same), from the 80
/// bytes at st: the state (16 little endian 32 bit words: constants, key,
/// counter, nonce; word 12 unused) and then the four blocks' counters
/// (4 words). The arm64 emitter and LLVM compute the four blocks in
/// vector registers (four 32 bit lanes, one block each); this is the
/// portable body.
pub fn chacha_blocks4(dst: Int, src: Int, st: Int) { chacha_blocks4_soft(dst, src, st) }

/// chacha_blocks4 over n bytes (a multiple of 256) at dst and src, the
/// four counters at st advanced by 4 for each 256 (modulo 2^32). The
/// arm64 emitter and LLVM there run one NEON loop, which overlaps a
/// group's rounds with the next's (a call a group waits for its counter
/// stores); elsewhere a call a group.
pub fn chacha_stream4(dst: Int, src: Int, st: Int, n: Int) {
  var i = 0
  while i < n {
    chacha_blocks4(dst.wrapping_add(i), src.wrapping_add(i), st)
    for b in 0..4 {
      rt.mem_store(st, 64 + 4 * b, (rt.mem_load(st, 64 + 4 * b, 4) + 4) & 0xFFFFFFFF, 4)
    }
    i += 256
  }
}

/// chacha_stream4 with the portable block: an x86-64 CPU without SSSE3,
/// where the lowered chacha_stream4 cannot run.
pub fn chacha_stream4_soft(dst: Int, src: Int, st: Int, n: Int) {
  var i = 0
  while i < n {
    chacha_blocks4_soft(dst.wrapping_add(i), src.wrapping_add(i), st)
    for b in 0..4 {
      rt.mem_store(st, 64 + 4 * b, (rt.mem_load(st, 64 + 4 * b, 4) + 4) & 0xFFFFFFFF, 4)
    }
    i += 256
  }
}

/// chacha_blocks4's body.
pub fn chacha_blocks4_soft(dst: Int, src: Int, st: Int) {
  for b in 0..4 {
    chacha_block_xor(dst.wrapping_add(64 * b), src.wrapping_add(64 * b), st, b)
  }
}

/// One block of chacha_blocks4_soft: its counter is the b-th after the
/// state. The sixteen words are locals, not a List (two Lists a block,
/// indexed with bounds checks in every quarter round, made Xo's scalar
/// ChaCha20 5.2 times Go's scalar code on an i7-9750H, 2026-10-27).
fn chacha_block_xor(dst: Int, src: Int, st: Int, b: Int) {
  let w0 = rt.mem_load(st, 0, 4)
  let w1 = rt.mem_load(st, 4, 4)
  let w2 = rt.mem_load(st, 8, 4)
  let w3 = rt.mem_load(st, 12, 4)
  let w4 = rt.mem_load(st, 16, 4)
  let w5 = rt.mem_load(st, 20, 4)
  let w6 = rt.mem_load(st, 24, 4)
  let w7 = rt.mem_load(st, 28, 4)
  let w8 = rt.mem_load(st, 32, 4)
  let w9 = rt.mem_load(st, 36, 4)
  let w10 = rt.mem_load(st, 40, 4)
  let w11 = rt.mem_load(st, 44, 4)
  let w12 = rt.mem_load(st, 64 + 4 * b, 4)
  let w13 = rt.mem_load(st, 52, 4)
  let w14 = rt.mem_load(st, 56, 4)
  let w15 = rt.mem_load(st, 60, 4)
  var x0 = w0
  var x1 = w1
  var x2 = w2
  var x3 = w3
  var x4 = w4
  var x5 = w5
  var x6 = w6
  var x7 = w7
  var x8 = w8
  var x9 = w9
  var x10 = w10
  var x11 = w11
  var x12 = w12
  var x13 = w13
  var x14 = w14
  var x15 = w15
  for _ in 0..10 {
    let (q0_0, q0_4, q0_8, q0_12) = chacha_qr(x0, x4, x8, x12)
    x0 = q0_0
    x4 = q0_4
    x8 = q0_8
    x12 = q0_12
    let (q1_1, q1_5, q1_9, q1_13) = chacha_qr(x1, x5, x9, x13)
    x1 = q1_1
    x5 = q1_5
    x9 = q1_9
    x13 = q1_13
    let (q2_2, q2_6, q2_10, q2_14) = chacha_qr(x2, x6, x10, x14)
    x2 = q2_2
    x6 = q2_6
    x10 = q2_10
    x14 = q2_14
    let (q3_3, q3_7, q3_11, q3_15) = chacha_qr(x3, x7, x11, x15)
    x3 = q3_3
    x7 = q3_7
    x11 = q3_11
    x15 = q3_15
    let (q4_0, q4_5, q4_10, q4_15) = chacha_qr(x0, x5, x10, x15)
    x0 = q4_0
    x5 = q4_5
    x10 = q4_10
    x15 = q4_15
    let (q5_1, q5_6, q5_11, q5_12) = chacha_qr(x1, x6, x11, x12)
    x1 = q5_1
    x6 = q5_6
    x11 = q5_11
    x12 = q5_12
    let (q6_2, q6_7, q6_8, q6_13) = chacha_qr(x2, x7, x8, x13)
    x2 = q6_2
    x7 = q6_7
    x8 = q6_8
    x13 = q6_13
    let (q7_3, q7_4, q7_9, q7_14) = chacha_qr(x3, x4, x9, x14)
    x3 = q7_3
    x4 = q7_4
    x9 = q7_9
    x14 = q7_14
  }
  // the key stream two words at a time, xored into src's 8 byte words
  chacha_xor2(dst, src, 0, x0.wrapping_add(w0), x1.wrapping_add(w1))
  chacha_xor2(dst, src, 8, x2.wrapping_add(w2), x3.wrapping_add(w3))
  chacha_xor2(dst, src, 16, x4.wrapping_add(w4), x5.wrapping_add(w5))
  chacha_xor2(dst, src, 24, x6.wrapping_add(w6), x7.wrapping_add(w7))
  chacha_xor2(dst, src, 32, x8.wrapping_add(w8), x9.wrapping_add(w9))
  chacha_xor2(dst, src, 40, x10.wrapping_add(w10), x11.wrapping_add(w11))
  chacha_xor2(dst, src, 48, x12.wrapping_add(w12), x13.wrapping_add(w13))
  chacha_xor2(dst, src, 56, x14.wrapping_add(w14), x15.wrapping_add(w15))
}

/// The 8 bytes at dst + o: src's xor the key stream's words lo then hi
/// (each kept to 32 bits).
fn chacha_xor2(dst: Int, src: Int, o: Int, lo: Int, hi: Int) {
  let k = (lo & 0xFFFFFFFF) | (hi & 0xFFFFFFFF).wrapping_shl(32)
  rt.mem_store(dst, o, rt.mem_load(src, o, 8) ^ k, 8)
}

/// The quarter round on words a, b, c, d (RFC 8439 2.1), each 32 bits.
fn chacha_qr(a0: Int, b0: Int, c0: Int, d0: Int) -> (Int, Int, Int, Int) {
  let a1 = a0.wrapping_add(b0) & 0xFFFFFFFF
  let d1 = (d0 ^ a1).rotate_right32(16)
  let c1 = c0.wrapping_add(d1) & 0xFFFFFFFF
  let b1 = (b0 ^ c1).rotate_right32(20)
  let a2 = a1.wrapping_add(b1) & 0xFFFFFFFF
  let d2 = (d1 ^ a2).rotate_right32(24)
  let c2 = c1.wrapping_add(d2) & 0xFFFFFFFF
  let b2 = (b1 ^ c2).rotate_right32(25)
  (a2, b2, c2, d2)
}

// ---------------------------------------------------------------------------
// Poly1305 (RFC 8439 2.5) with 64 bit limbs, and ChaCha20-Poly1305's bulk

/// Poly1305's blocks: the n bytes at d (a multiple of 16), each with hb
/// (1 for a full block, 0 for a padded last one) added above its 128
/// bits, into the state at ps (words h0, h1, h2, r0, r1: h = h0 + h1
/// 2^64 + h2 2^128, h2 under 8 between blocks, and the clamped r):
/// h = (h + m) r mod 2^130 - 5 a block, as Go's
/// golang.org/x/crypto/internal/poly1305 sum_generic.go (BSD-style
/// license, Copyright The Go Authors) with mul_hi_unsigned and adc.
pub fn poly_blocks(ps: Int, d: Int, n: Int, hb: Int) {
  var h0 = rt.mem_load(ps, 0, 8)
  var h1 = rt.mem_load(ps, 8, 8)
  var h2 = rt.mem_load(ps, 16, 8)
  let r0 = rt.mem_load(ps, 24, 8)
  let r1 = rt.mem_load(ps, 32, 8)
  var o = 0
  while o < n {
    let w0 = rt.mem_load(d, o, 8)
    let w1 = rt.mem_load(d, o.wrapping_add(8), 8)
    // h += m
    let a0 = adc(h0, w0, 0)
    let c0 = adc_carry(h0, w0, 0)
    let a1 = adc(h1, w1, c0)
    let c1 = adc_carry(h1, w1, c0)
    let a2 = h2.wrapping_add(c1).wrapping_add(hb)
    // h *= r: a2 is under 8 and r's top four bits clear, so a2 r0 and
    // a2 r1 fit a word
    let l00 = a0.wrapping_mul(r0)
    let h00 = a0.mul_hi_unsigned(r0)
    let l10 = a1.wrapping_mul(r0)
    let h10 = a1.mul_hi_unsigned(r0)
    let l01 = a0.wrapping_mul(r1)
    let h01 = a0.mul_hi_unsigned(r1)
    let l11 = a1.wrapping_mul(r1)
    let h11 = a1.mul_hi_unsigned(r1)
    let l20 = a2.wrapping_mul(r0)
    let l21 = a2.wrapping_mul(r1)
    // m1 = a1 r0 + a0 r1, m2 = a2 r0 + a1 r1 (128 bits each)
    let m1l = adc(l10, l01, 0)
    let m1c = adc_carry(l10, l01, 0)
    let m1h = h10.wrapping_add(h01).wrapping_add(m1c)
    let m2l = adc(l20, l11, 0)
    let m2c = adc_carry(l20, l11, 0)
    let m2h = h11.wrapping_add(m2c)
    // t = m0 + m1 2^64 + m2 2^128 + m3 2^192
    let t0 = l00
    let t1 = adc(m1l, h00, 0)
    let e1 = adc_carry(m1l, h00, 0)
    let t2 = adc(m2l, m1h, e1)
    let e2 = adc_carry(m2l, m1h, e1)
    let t3 = l21.wrapping_add(m2h).wrapping_add(e2)
    // reduce: the bits from 130 up, cc, times 5 = cc 4 + cc, added back
    let cl = t2 & -4
    let g0 = adc(t0, cl, 0)
    let k0 = adc_carry(t0, cl, 0)
    let g1 = adc(t1, t3, k0)
    let k1 = adc_carry(t1, t3, k0)
    let g2 = (t2 & 3).wrapping_add(k1)
    let sl = cl.shr_logical(2) | t3.wrapping_shl(62)
    let sh = t3.shr_logical(2)
    h0 = adc(g0, sl, 0)
    let j0 = adc_carry(g0, sl, 0)
    h1 = adc(g1, sh, j0)
    let j1 = adc_carry(g1, sh, j0)
    h2 = g2.wrapping_add(j1)
    o = o.wrapping_add(16)
  }
  rt.mem_store(ps, 0, h0, 8)
  rt.mem_store(ps, 8, h1, 8)
  rt.mem_store(ps, 16, h2, 8)
}

/// ChaCha20-Poly1305's sealing bulk: chacha_stream4 over the n bytes (a
/// multiple of 256) and Poly1305's blocks of the ciphertext at dst into
/// the state at ps (poly_blocks'). amd64 runs both in one SSE loop, the
/// previous 256 bytes hashed during the next ones' rounds; elsewhere
/// the two one after the other.
pub fn chacha_poly_seal4(dst: Int, src: Int, st: Int, n: Int, ps: Int) { chacha_poly_seal4_soft(dst, src, st, n, ps) }

/// chacha_poly_seal4's body.
pub fn chacha_poly_seal4_soft(dst: Int, src: Int, st: Int, n: Int, ps: Int) {
  chacha_stream4(dst, src, st, n)
  poly_blocks(ps, dst, n, 1)
}

/// chacha_poly_seal4 with AVX2 (cpu.HW_AVX2), four blocks in one pass of
/// the rounds; st has 256 bytes of scratch after its 80 (chacha.xo).
pub fn chacha_poly_seal8(dst: Int, src: Int, st: Int, n: Int, ps: Int) { chacha_poly_seal4_soft(dst, src, st, n, ps) }

/// chacha_poly_open4 with AVX2 (cpu.HW_AVX2).
pub fn chacha_poly_open8(dst: Int, src: Int, st: Int, n: Int, ps: Int) { chacha_poly_open4_soft(dst, src, st, n, ps) }

/// The opening bulk: Poly1305's blocks of the ciphertext at src, then
/// chacha_stream4 into dst (which may be src).
pub fn chacha_poly_open4(dst: Int, src: Int, st: Int, n: Int, ps: Int) { chacha_poly_open4_soft(dst, src, st, n, ps) }

/// chacha_poly_open4's body.
pub fn chacha_poly_open4_soft(dst: Int, src: Int, st: Int, n: Int, ps: Int) {
  poly_blocks(ps, src, n, 1)
  chacha_stream4(dst, src, st, n)
}

// ---------------------------------------------------------------------------
// ML-KEM's NTT (SSE2 on x86-64)

/// ML-KEM's forward NTT (FIPS 203 Algorithm 9), in place, of the 256
/// coefficients at p (8 byte words, each below q = 3329), with the 128
/// zetas at zp (8 byte words); every result below q. The x86-64 emitters
/// compute two coefficients an xmm register (compiler/ssa x86mlkem.xo);
/// this is the portable body (arm64, LLVM's arm64, wasm).
pub fn mlkem_ntt(p: Int, zp: Int) { mlkem_ntt_soft(p, zp) }

/// x mod 3329 up to one extra 3329, for 0 <= x < 2^32 (a Barrett step
/// with floor(2^32 / 3329) = 1290167: mlkem.xo's bred).
fn mlkem_bred(x: Int) -> Int {
  x.wrapping_sub(x.wrapping_mul(1290167).shr_logical(32).wrapping_mul(3329))
}

/// mlkem_ntt's body: mlkem.xo's lazy layers (offsets in bytes: lb = 8
/// len, zo = 8 k), the last (len 2) with every output reduced below q.
pub fn mlkem_ntt_soft(p: Int, zp: Int) {
  var zo = 8
  var lb = 1024
  while lb >= 16 {
    var j0 = 0
    while j0 < 2048 {
      let z = rt.mem_load(zp, zo, 8)
      zo = zo.wrapping_add(8)
      var j = j0
      let end = j0.wrapping_add(lb)
      while j < end {
        let jl = j.wrapping_add(lb)
        let t = mlkem_bred(z.wrapping_mul(rt.mem_load(p, jl, 8)))
        let fj = rt.mem_load(p, j, 8)
        rt.mem_store(p, jl, fj.wrapping_sub(t).wrapping_add(6658), 8)
        rt.mem_store(p, j, fj.wrapping_add(t), 8)
        j = j.wrapping_add(8)
      }
      j0 = end.wrapping_add(lb)
    }
    lb = lb.shr_logical(1)
  }
  var o = 0
  while o < 2048 {
    let r = mlkem_bred(rt.mem_load(p, o, 8)).wrapping_sub(3329)
    rt.mem_store(p, o, r.wrapping_add(r.shr_logical(63).wrapping_mul(3329)), 8)
    o = o.wrapping_add(8)
  }
}

/// ML-KEM's inverse NTT (FIPS 203 Algorithm 10), in place, of the 256
/// coefficients at p (8 byte words, each below q) with the zetas at zp,
/// the scaling by 128^-1 folded into the last layer; every result below
/// q. SSE2 on x86-64 as mlkem_ntt.
pub fn mlkem_inverse_ntt(p: Int, zp: Int) { mlkem_inverse_ntt_soft(p, zp) }

/// x mod 3329, for 0 <= x < 2^32 (mlkem.xo's bfull).
fn mlkem_bfull(x: Int) -> Int {
  let r = mlkem_bred(x).wrapping_sub(3329)
  r.wrapping_add(r.shr_logical(63).wrapping_mul(3329))
}

/// mlkem_inverse_ntt's body: mlkem.xo's lazy layers, len 2 to 64 with
/// every coefficient below b entering a layer (b = q, 2q, ...), then len
/// 128 with 3303 = 128^-1 mod q folded in.
pub fn mlkem_inverse_ntt_soft(p: Int, zp: Int) {
  var zo = 8 * 127
  var lb = 16
  var b = 3329
  while lb <= 512 {
    var j0 = 0
    while j0 < 2048 {
      let z = rt.mem_load(zp, zo, 8)
      zo = zo.wrapping_sub(8)
      var j = j0
      let end = j0.wrapping_add(lb)
      while j < end {
        let jl = j.wrapping_add(lb)
        let t = rt.mem_load(p, j, 8)
        let u = rt.mem_load(p, jl, 8)
        rt.mem_store(p, j, t.wrapping_add(u), 8)
        rt.mem_store(p, jl, mlkem_bred(z.wrapping_mul(u.wrapping_sub(t).wrapping_add(b))), 8)
        j = j.wrapping_add(8)
      }
      j0 = end.wrapping_add(lb)
    }
    lb = lb.wrapping_add(lb)
    b = b.wrapping_add(b)
  }
  let z = mlkem_bfull(rt.mem_load(zp, 8, 8).wrapping_mul(3303))
  var j = 0
  while j < 1024 {
    let t = rt.mem_load(p, j, 8)
    let u = rt.mem_load(p, j.wrapping_add(1024), 8)
    rt.mem_store(p, j, mlkem_bfull(t.wrapping_add(u).wrapping_mul(3303)), 8)
    rt.mem_store(p, j.wrapping_add(1024), mlkem_bfull(z.wrapping_mul(u.wrapping_sub(t).wrapping_add(b))), 8)
    j = j.wrapping_add(8)
  }
}

/// h += f g in ML-KEM's NTT domain (FIPS 203 Algorithms 11 and 12, the
/// sums of products of K-PKE): 256 coefficients each at h, f and g (8
/// byte words, each below q), the 128 gammas at gp; every result below
/// q. SSE2 on x86-64 as mlkem_ntt.
pub fn mlkem_mul_acc(h: Int, f: Int, g: Int, gp: Int) { mlkem_mul_acc_soft(h, f, g, gp) }

/// mlkem_mul_acc's body: mlkem.xo's pairs, each sum below 2^26.
pub fn mlkem_mul_acc_soft(h: Int, f: Int, g: Int, gp: Int) {
  var o = 0
  var gi = 0
  while o < 2048 {
    let o1 = o.wrapping_add(8)
    let a0 = rt.mem_load(f, o, 8)
    let a1 = rt.mem_load(f, o1, 8)
    let b0 = rt.mem_load(g, o, 8)
    let b1 = rt.mem_load(g, o1, 8)
    let r = mlkem_bred(a1.wrapping_mul(b1))
    rt.mem_store(h, o, mlkem_bfull(a0.wrapping_mul(b0).wrapping_add(r.wrapping_mul(rt.mem_load(gp, gi, 8))).wrapping_add(rt.mem_load(h, o, 8))), 8)
    rt.mem_store(h, o1, mlkem_bfull(a0.wrapping_mul(b1).wrapping_add(a1.wrapping_mul(b0)).wrapping_add(rt.mem_load(h, o1, 8))), 8)
    o = o.wrapping_add(16)
    gi = gi.wrapping_add(8)
  }
}

/// A count of time for elapsed time thresholds (fiber run and wait
/// stamps): on arm64 the generic timer's virtual count (cntvct_el0, a
/// constant rate readable at EL0 on darwin, linux and windows; one
/// instruction where mono_ns is a libc call), elsewhere mono_ns. Not a
/// time of day, and not comparable across machines; ticks_ns converts a
/// difference. Not constant time, unlike the rest of this file.
pub fn ticks() -> Int {
  sysio.mono_ns()
}

/// ticks a second: cntfrq_el0 on arm64, else 1e9 (ticks are mono_ns).
pub fn ticks_hz() -> Int {
  1000000000
}

/// The nanoseconds of d ticks (a difference of two ticks()), without an
/// overflow for any d below about 2^63 / 1e9 seconds.
pub fn ticks_ns(d: Int) -> Int {
  let hz = ticks_hz()
  (d / hz) * 1000000000 + (d % hz) * 1000000000 / hz
}
