// The C ABI exports of the TLS and HTTP/2 server (decision 0244): the
// entries hconn.xo and hserve.xo call through the table srvtls.xo makes
// when a program configures TLS (http.Server.with_tls). Only srvtls.xo
// imports this module, so a program that never calls with_tls builds
// none of these (compiler/ssa build.xo importer_built) and links no TLS
// server and no HTTP/2: a plain HTTP server is about half the size
// (bench/results/binary-size-native-2026-10-16.md). Every top level
// function here is an export, xo_x_<name>; the arguments and results are
// Ints (rt.call_c2 and call_c4), and each takes exactly the 2 or 4 Ints
// its call passes and returns an Int: on wasm the call is a call_indirect,
// which traps on any other shape (decision 0447 R2d).
use native/llrt/cabi_h2
use native/llrt/h2srv
use native/llrt/hconn
use native/llrt/poll
use native/llrt/tlssrv

fn srvtls_srv_free(t: Int, _u: Int) -> Int {
  tlssrv.srv_free(t)
  0
}

fn srvtls_conn(t: Int, pd: Int) -> Int { tlssrv.conn(t, pd) }

fn srvtls_close_notify(t: Int, _u: Int) -> Int {
  tlssrv.close_notify(t)
  0
}

fn srvtls_free(t: Int, _u: Int) -> Int {
  tlssrv.free(t)
  0
}

fn srvtls_read(t: Int, p: Int, n: Int, _u: Int) -> Int { tlssrv.hc_read(t, p, n) }

fn srvtls_write(t: Int, p: Int, n: Int, _u: Int) -> Int { tlssrv.write(t, p, n) }

/// The deadline of t's reads and handshake (tlssrv.set_deadline, 0 none).
fn srvtls_set_deadline(t: Int, when: Int) -> Int {
  tlssrv.set_deadline(t, when)
  0
}

/// Whether t's last wait passed its deadline (tlssrv.timed_out).
fn srvtls_timed_out(t: Int, _u: Int) -> Int { if tlssrv.timed_out(t) { 1 } else { 0 } }

/// Whether t holds no plaintext and no partial record (tlssrv.idle_empty).
fn srvtls_idle_empty(t: Int, _u: Int) -> Int { if tlssrv.idle_empty(t) { 1 } else { 0 } }

/// Reads without waiting (tlssrv.nb_read: h2srv.xo's fiber waits itself).
fn srvtls_nb_read(t: Int, p: Int, n: Int, _u: Int) -> Int { tlssrv.nb_read(t, p, n) }

/// The Any record of t's tlsneg.Negotiated, 0 for none (tlssrv.neg_any).
fn srvtls_neg(t: Int, _u: Int) -> Int { tlssrv.neg_any(t) }

/// Finishes the TLS handshake of server connection hc (its TLS
/// connection t): when ALPN chose HTTP/2, the connection's HTTP/2 record
/// (h2srv.conn_new, freed with the connection), else 0: HTTP/1.1, or the
/// handshake failed (which http1.xo's reads find). Was hserve.xo hc_h2's
/// second half; hserve.xo marked the connection idle first.
fn srvtls_h2(hc: Int, t: Int) -> Int {
  // (poll.canceled reads a native context: on wasm the handshake's own
  // waits see a cancellation)
  let ok = (target.arch == TargetArch.Wasm32 || !poll.canceled()) && tlssrv.handshake(t)
  hconn.set_idle(hc, false)
  if !ok {
    return 0
  }
  if !tlssrv.alpn_h2(t) {
    let _refused = tlssrv.refuse_h1(t)
    return 0
  }
  // rejectConn: HTTP/2 needs TLS 1.2 with an AEAD suite at least
  let why = tlssrv.bad_cipher(t)
  let c = h2srv.conn_open(why, hconn.h2cfg_at(hc))
  cabi_h2.h2_attach(hc, c)
  c
}
