// The event loop's poller in Xo (the zero-C audit's work item B22,
// decision 0069's design): the timer heap, the readiness of the
// descriptors, the event loop's start, and the poller thread's loop over
// kqueue (macOS), epoll (Linux), and on Windows AFD polls through a
// completion port or the WSAPoll fallback. A timer is a record laid out
// here (T_*; was xo_rt.c struct xo_timer until 2026-10-15): its deadline
// in monotonic ns and its place in the heap (-1 when not in it); the heap
// is an array of timer addresses ordered by deadline (a binary heap),
// from the C runtime's malloc (rt.heap_large). The event loop's lock
// (EV_MU) is held around every call of the heap's. Nothing here
// allocates Xo values or faults.
use native/llrt/layout
use native/llrt/budget
use native/llrt/ctx
use native/llrt/heapos
use native/llrt/linux
use native/llrt/obj
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/rtstats
use native/llrt/sanhook
use native/llrt/sock
use native/llrt/stop
use native/llrt/sysio
use native/llrt/tracerec
use native/llrt/twflags
use native/rt
use native/sys_darwin
use native/sys_windows

/// A timer's words (xo_rt.c struct xo_timer).
const T_WHEN = 0
const T_IDX = 8

/// rt.static_word: the heap's array (the address after its prefix), its
/// length, and its capacity.
const W_HEAP = 40
const W_N = 41
const W_CAP = 42

fn addw(a: Int, b: Int) -> Int { a.wrapping_add(b) }

fn subw(a: Int, b: Int) -> Int { a.wrapping_sub(b) }

fn at(i: Int) -> Int { rt.mem_load(rt.mem_load(rt.static_word(W_HEAP), 0, 8), i.wrapping_shl(3), 8) }

fn set(i: Int, t: Int) {
  rt.mem_store(rt.mem_load(rt.static_word(W_HEAP), 0, 8), i.wrapping_shl(3), t, 8)
  rt.mem_store(t, T_IDX, i, 8)
}

fn dl(t: Int) -> Int { rt.mem_load(t, T_WHEN, 8) }

fn up(i0: Int) {
  var i = i0
  let t = at(i)
  while i > 0 {
    let p = subw(i, 1).shr_logical(1)
    if dl(at(p)) <= dl(t) {
      break
    }
    set(i, at(p))
    i = p
  }
  set(i, t)
}

fn down(i0: Int) {
  var i = i0
  let t = at(i)
  let n = rt.mem_load(rt.static_word(W_N), 0, 8)
  while true {
    var c = addw(i.wrapping_shl(1), 1)
    if c >= n {
      break
    }
    if addw(c, 1) < n && dl(at(addw(c, 1))) < dl(at(c)) {
      c = addw(c, 1)
    }
    if dl(t) <= dl(at(c)) {
      break
    }
    set(i, at(c))
    i = c
  }
  set(i, t)
}

/// Adds timer t (its deadline set): 1 when it is the first to fire now
/// (the poller must wake to wait less), else 0.
pub fn timer_push(t: Int) -> Int {
  let wn = rt.static_word(W_N)
  let wc = rt.static_word(W_CAP)
  let n = rt.mem_load(wn, 0, 8)
  let cap = rt.mem_load(wc, 0, 8)
  if n == cap {
    let ncap = if cap == 0 { 64 } else { addw(cap, cap) }
    let old = rt.mem_load(rt.static_word(W_HEAP), 0, 8)
    let nh = if old == 0 { rt.heap_large(ncap.wrapping_shl(3)) } else { rt.heap_large_resize(subw(old, 8), ncap.wrapping_shl(3)) }
    rt.mem_store(rt.static_word(W_HEAP), 0, nh, 8)
    rt.mem_store(wc, 0, ncap, 8)
  }
  rt.mem_store(wn, 0, addw(n, 1), 8)
  set(n, t)
  up(n)
  if rt.mem_load(t, T_IDX, 8) == 0 { 1 } else { 0 }
}

/// Takes timer t (in the heap) out of it; its place becomes -1.
pub fn timer_remove(t: Int) {
  let wn = rt.static_word(W_N)
  let i = rt.mem_load(t, T_IDX, 8)
  let n = subw(rt.mem_load(wn, 0, 8), 1)
  rt.mem_store(wn, 0, n, 8)
  let last = at(n)
  rt.mem_store(t, T_IDX, -1, 8)
  if last != t {
    set(i, last)
    down(i)
    up(rt.mem_load(last, T_IDX, 8))
  }
}

/// The timer that fires first, or 0 when none is armed.
pub fn timer_first() -> Int {
  if rt.mem_load(rt.static_word(W_N), 0, 8) == 0 {
    return 0
  }
  at(0)
}

// ---------------------------------------------------------------------------
// Descriptors (D_*, laid out here; was xo_rt.c xo_pd): a lock word,
// the socket (-1 once closed), whether close was called, the operations
// running, readiness that came while nobody waited (read, write), the
// parks waiting (read, write), and the link of the dead list.

const D_MU = layout.D_MU
const D_RREADY = layout.D_RREADY
const D_WREADY = layout.D_WREADY
const D_RWAIT = layout.D_RWAIT
const D_WWAIT = layout.D_WWAIT
const D_NEXT = layout.D_NEXT
const D_TIMERS = layout.D_TIMERS

/// A timer's park, C function, and fired flag (xo_rt.c struct xo_timer).
const T_PARK = 16
const T_FN = 24
const T_FIRED = 40
/// T_FIRED as a word index (the slot atomics).
const T_FIRED_W = 5

/// rt.sched_rt's statistics (xo_rt.c st: poll_return, poll_event,
/// poll_wake).
const ST_POLL_RETURN = 15
const ST_POLL_EVENT = 16
const ST_POLL_WAKE = 17

// slot atomics' orders (rt.xo)
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2
const SEQ_CST = 4

fn stat(k: Int) { rtstats.count(k) }

/// Takes and releases the lock word at l (xo_rt.c lk and unlk).
fn lk(l: Int) {
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    stat(pool.ST_LOCK_PD)
    pool.lock_slow(l)
  }
  pool.held(1)
}

fn unlk(l: Int) {
  pool.held(-1)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

/// Signals the park p (xo_rt.c park_signal until 2026-10-15): released
/// for ThreadSanitizer first, as tasks.xo park_signal does.
fn signal(p: Int) {
  sanhook.release(p)
  pool.park_signal(ctx.pool(), p)
}

/// Wakes the descriptor pd's waiters of mode (1 read, 2 write, 3 both)
/// without readiness, keeping nothing for a later wait: a waiter looks
/// again (a changed deadline, decision 0430) and waits on if nothing
/// came.
pub fn pd_kick(pd: Int, mode: Int) {
  lk(addw(pd, D_MU))
  if (mode & 1) != 0 {
    let w = rt.mem_load(pd, D_RWAIT, 8)
    if w != 0 {
      signal(w)
      rt.mem_store(pd, D_RWAIT, 0, 8)
    }
  }
  if (mode & 2) != 0 {
    let w = rt.mem_load(pd, D_WWAIT, 8)
    if w != 0 {
      signal(w)
      rt.mem_store(pd, D_WWAIT, 0, 8)
    }
  }
  unlk(addw(pd, D_MU))
}

/// Hands readiness mode (1 read, 2 write, 3 both) to the descriptor pd's
/// waiters, or keeps it for the next wait (xo_rt.c pd_ready).
pub fn pd_ready(pd: Int, mode: Int) {
  stat(ST_POLL_EVENT)
  lk(addw(pd, D_MU))
  if (mode & 1) != 0 {
    let w = rt.mem_load(pd, D_RWAIT, 8)
    if w != 0 {
      stat(ST_POLL_WAKE)
      stat(rtstats.SIG_READY)
      signal(w)
      rt.mem_store(pd, D_RWAIT, 0, 8)
    } else {
      rt.mem_store(pd, D_RREADY, 1, 4)
    }
  }
  if (mode & 2) != 0 {
    let w = rt.mem_load(pd, D_WWAIT, 8)
    if w != 0 {
      stat(ST_POLL_WAKE)
      stat(rtstats.SIG_READY)
      signal(w)
      rt.mem_store(pd, D_WWAIT, 0, 8)
    } else {
      rt.mem_store(pd, D_WREADY, 1, 4)
    }
  }
  unlk(addw(pd, D_MU))
}

// ---------------------------------------------------------------------------
// Waiting on a descriptor (was xo_rt.c pd_new, pd_begin, pd_end,
// pd_close, pd_free, pd_wait_until). A descriptor's record (D_ above, fd
// at 8, closed at 12, ops at 16, all under its lock word). The C's
// services record of earlier steps is gone (decision 0233 step 2,
// 2026-10-15): the wait is cabi.xo poll_park_wait through rt.fn_addr, a
// context's park ctx.xo C_PARK, the poller thread's start
// rt.fn_addr("poll_thread"); cancellation, park signals and the
// shutdown's steps are Xo calls; the event loop's record is this
// module's (W_EV).

/// rt.static_word: the event loop's record (EV_ below), made by poll_svc
/// (was xo_rt.c's static ev).
const W_EV = 43
/// Its size: the words below, Windows', then the network poll's of
/// decision 0324.
const EV_SIZE = 240

/// The event loop's record's words: the start's state
/// (0 not started, 1 starting, 2 running), the lock word, the self
/// pipe's read and write ends and the kqueue or epoll descriptor (C
/// ints), the list of descriptors to free, and the count of signals not
/// handled yet.
const EV_ONCE = 0
const EV_MU = 8
const EV_PIPE_R = 16
const EV_PIPE_W = 20
const EV_POLL = 24
const EV_DEAD = 32
const EV_SIGS = 40
/// Windows' words of the ev record: the completion port,
/// the AFD device (0: the WSAPoll fallback), the fallback's self pipe (a
/// loopback socket pair: the read end, the write end), and its
/// registered descriptors (the array's address, length, and capacity;
/// under the lock word).
const EV_IOCP = 48
const EV_AFD = 56
const EV_WR = 64
const EV_WW = 72
const EV_REGS = 80
const EV_NREG = 88
const EV_CREG = 96
/// SIGQUITs not yet handled (`xo dump`, decision 0251)
const EV_QUITS = 104
/// Decision 0324 (idle workers poll the network themselves): the poll
/// token (TOK_*: who polls now), the monotonic ns of the last poll, the
/// poller thread's sleep word (1: asleep until a blocking worker gives
/// the token back, 2: woken), the shared event buffer of the token's
/// holder, and whether workers poll (1: Linux and macOS, not the test
/// world's virtual clock, XO_NETPOLL not 0).
const EV_TOK = 112
const EV_LAST = 120
const EV_PSLEEP = 128
const EV_BUF = 136
const EV_ON = 144
/// Proc.notify (decision 0407): the mask of subscribed signals (bit i:
/// Signal i in the prelude's order: Hangup, Interrupt, Quit, Terminate,
/// User1, User2, WindowChange), each signal's count not yet delivered (7
/// words), and the subscription table's lock word (sigsub.xo's array
/// sits in the next two words: its address and length).
pub const EV_SUBS = 152
pub const EV_PENDN = 160
pub const EV_SUBMU = 216
pub const EV_SUBTAB = 224
pub const EV_SUBN = 232

/// The ev record's address (sigsub.xo).
pub fn ev_rec() -> Int { ev() }
const TOK_FREE = 0
const TOK_WORKER = 1
const TOK_BLOCKED = 2
const TOK_POLLER = 3
/// The poller thread's tick while workers poll (ns): NP_TICK_MIN after a
/// poll of its own found something, doubled up to NP_TICK_MAX while it
/// finds nothing to do (Go's sysmon, 20 us to 10 ms; a fixed 10 ms let
/// busy workers, which poll only when out of work, leave the listener
/// unpolled long enough for a burst of connections to overflow macOS's
/// accept queue of 128, 2026-10-21); and the ticks with no poll before
/// it waits in the poller itself (a quiet program).
const NP_TICK_MIN = 500000
const NP_TICK_MAX = 10000000
const NP_QUIET = 10

/// A descriptor record's size and fields: layout.xo's.
const D_SIZE = layout.D_SIZE
const D_FD = layout.D_FD
const D_CLOSED = layout.D_CLOSED
const D_OPS = layout.D_OPS

/// A timer record's size (its words end at 48).
const T_SIZE = 64

/// Whether timer t fired (a C int the poller stores after a release
/// fence).
fn fired(t: Int) -> Bool { rt.slot_load(t, T_FIRED_W, ACQUIRE) != 0 }

/// pd_wait's results (xo_rt.c PD_READY and the rest).
pub const READY = 0
pub const CANCELED = 1
pub const CLOSED = 2
pub const TIMEOUT = 3

/// Makes the event loop's record at start (before any descriptor),
/// zeroed and never freed: its address.
pub fn poll_svc() -> Int {
  let e = rt.heap_large(EV_SIZE)
  rt.mem_set(e, 0, EV_SIZE)
  rt.mem_store(rt.static_word(W_EV), 0, e, 8)
  e
}

/// The AFD device handle on Windows (0: none, the WSAPoll loop; always 0
/// elsewhere).
fn afd() -> Int { if windows() { rt.mem_load(ev(), EV_AFD, 8) } else { 0 } }

/// Registers descriptor fd with the poller (for reading, and writing when
/// write): its record, or minus the errno when the poller refuses it (a
/// regular file). Starts the event loop if it is not running.
pub fn pd_open(fd: Int, write: Bool) -> Int {
  if windows() {
    return open_win(fd)
  }
  ev_start()
  let pd = rt.heap_large(D_SIZE)
  rt.mem_set(pd, 0, D_SIZE)
  rt.mem_store(pd, D_FD, fd, 4)
  let r = register(fd, pd, write)
  if r < 0 {
    rt.heap_release(subw(pd, 8))
    return r
  }
  pd
}

/// Registers fd with the poller for pd, edge triggered, for reading
/// (and writing when write): 0, or minus the errno.
fn register(fd: Int, pd: Int, write: Bool) -> Int {
  let e = ev()
  let poll = s32(rt.mem_load(e, EV_POLL, 4))
  match target.os {
    TargetOs.Darwin => {
      // two struct kevent (32 bytes): ident, filter (EVFILT_READ -1,
      // EVFILT_WRITE -2), flags (EV_ADD 1 | EV_CLEAR 0x20), fflags, data,
      // udata
      let k = obj.scratch()
      rt.mem_set(k, 0, 64)
      rt.mem_store(k, 0, fd, 8)
      rt.mem_store(k, 8, 65535, 2)
      rt.mem_store(k, 10, 33, 2)
      rt.mem_store(k, 24, pd, 8)
      rt.mem_store(k, 32, fd, 8)
      rt.mem_store(k, 40, 65534, 2)
      rt.mem_store(k, 42, 33, 2)
      rt.mem_store(k, 56, pd, 8)
      // the release the poller's kevent wait acquires (wait_events): as
      // epoll's, the kernel orders a registration before its events, an
      // edge ThreadSanitizer does not see through a raw kevent
      // (gotchas/tsan-raw-epoll-no-edge.md)
      sanhook.release(ev())
      let r = Int(sys_darwin.kevent(poll, k, if write { 2 } else { 1 }, 0, 0, 0))
      if r < 0 { 0 - rt.mem_load(sys_darwin.__error(), 0, 4) } else { 0 }
    }
    TargetOs.Linux => {
      // EPOLLIN 1 | EPOLLRDHUP 0x2000 | EPOLLET 1 << 31, EPOLLOUT 4; the
      // registration publishes pd through the kernel, which the C
      // library's epoll interceptors tell ThreadSanitizer and these raw
      // calls do not (gotchas/tsan-raw-epoll-no-edge.md)
      epoll_add(poll, fd, 2147483648 | 8192 | 1 | (if write { 4 } else { 0 }), pd)
    }
    TargetOs.Windows | TargetOs.Wasi => -38
  }
}

/// epoll_ctl(EPOLL_CTL_ADD) of fd for events, its data pd: 0, or minus
/// the errno.
fn epoll_add(poll: Int, fd: Int, events: Int, pd: Int) -> Int {
  let e = obj.scratch()
  rt.mem_set(e, 0, 16)
  rt.mem_store(e, 0, events, 4)
  let off = match target.arch {
    TargetArch.Amd64 => 4
    TargetArch.Arm64 | TargetArch.Wasm32 => 8
  }
  rt.mem_store(e, off, pd, 8)
  sanhook.release(ev())
  sock.epoll_ctl(poll, 1, fd, e)
}

/// Closes the socket fd (xo_rt.c nx_close).
fn fd_close(fd: Int) { let _c = sock.close(fd) }

/// Shuts the socket fd down for both directions, unregistered first on
/// Linux: epoll keys a registration by the open file, not the
/// descriptor, so a close alone leaves it while a child process holds
/// the file, and its next event would name the record after the poller
/// freed it (2026-10-12, gotchas/linux-epoll-inherited-socket.md).
/// Windows drops the unread input first (the C's).
fn fd_shut(fd: Int) {
  match target.os {
    TargetOs.Darwin => {
      let _s = sock.shutdown(fd, 2)
    }
    TargetOs.Linux => {
      let _d = sock.epoll_ctl(s32(rt.mem_load(ev(), EV_POLL, 4)), 2, fd, 0)
      let _s = sock.shutdown(fd, 2)
    }
    TargetOs.Windows | TargetOs.Wasi => {
      // Windows resets a connection shut down for receiving while input
      // is unread, and the reset discards what the peer has not read of
      // ours yet (a 400 just written): drop the input first (the socket
      // is nonblocking)
      let b = obj.scratch()
      while Int(sys_windows.recv(fd, b, 256, 0)) > 0 {
      }
      let _s = sock.shutdown(fd, 2)
    }
  }
}

/// pd_open, with 0 for a refusal.
pub fn pd_new(fd: Int, write: Bool) -> Int {
  let pd = pd_open(fd, write)
  if pd < 0 { 0 } else { pd }
}

/// The test world's virtual clock (twflags.xo, an atomic word).
const TW_VNOW = twflags.TW_VNOW

/// The timers' clock now (xo_rt.c tnow): the test world's virtual one
/// while it runs, else the monotonic one.
pub fn now() -> Int {
  let tw = twflags.vclock()
  if tw != 0 {
    // TW_VNOW is a byte offset; a slot's index counts words
    return rt.slot_load(tw + TW_VNOW, 0, ACQUIRE)
  }
  sysio.mono_ns()
}

/// Clock.now's time while the test world's clock is virtual, else the
/// wall clock (xo_rt.c xo_clock_now, which generated code calls as
/// rt.clock_now through cabi.xo's clock_now).
pub fn wall_now() -> Int {
  let tw = twflags.vclock()
  if tw != 0 {
    return rt.slot_load(tw + TW_VNOW, 0, ACQUIRE)
  }
  sysio.real_ns()
}

/// The timers' time d ns from now, saturating (xo_rt.c deadline).
pub fn deadline(d: Int) -> Int {
  let n = now()
  if d > 0 && n > 9223372036854775807 - d {
    return 9223372036854775807
  }
  addw(n, d)
}

/// Starts an operation on pd: false when it is closed.
pub fn pd_begin(pd: Int) -> Bool {
  lk(addw(pd, D_MU))
  let ok = rt.mem_load(pd, D_CLOSED, 4) == 0
  if ok {
    rt.mem_store(pd, D_OPS, rt.mem_load(pd, D_OPS, 4) + 1, 4)
  }
  unlk(addw(pd, D_MU))
  ok
}

/// Forgets a readiness that the next read will cover: call it before a
/// read, so an edge that came before the read (its data is in the socket)
/// does not wake the next wait for a read that finds nothing (EAGAIN).
/// An edge after the call keeps the flag.
/// Invariant: the caller reads until EAGAIN before any wait (the poller
/// is edge triggered: a partial read leaves data that no new edge
/// announces, which a stale flag used to cover).
pub fn pd_clear_read(pd: Int) {
  lk(addw(pd, D_MU))
  rt.mem_store(pd, D_RREADY, 0, 4)
  unlk(addw(pd, D_MU))
}

/// The descriptor's fd now, unless taken to close it (-1).
fn take_fd(pd: Int) -> Int {
  let fd = rt.mem_load(pd, D_FD, 4)
  let f = if fd >= 2147483648 { fd - 4294967296 } else { fd }
  if f >= 0 {
    rt.mem_store(pd, D_FD, 4294967295, 4)
  }
  f
}

/// Ends an operation on pd: the last one after a close closes the fd.
pub fn pd_end(pd: Int) {
  lk(addw(pd, D_MU))
  let ops = rt.mem_load(pd, D_OPS, 4) - 1
  rt.mem_store(pd, D_OPS, ops, 4)
  var fd = -1
  if ops == 0 && rt.mem_load(pd, D_CLOSED, 4) != 0 {
    fd = take_fd(pd)
  }
  unlk(addw(pd, D_MU))
  if fd >= 0 {
    fd_close(fd)
  }
}

fn wake(pd: Int, k: Int) {
  let w = rt.mem_load(pd, k, 8)
  if w != 0 {
    signal(w)
    rt.mem_store(pd, k, 0, 8)
  }
}

/// Closes pd: its waiters return CLOSED, and the fd closes once no
/// operation runs.
pub fn pd_close(pd: Int) {
  lk(addw(pd, D_MU))
  if rt.mem_load(pd, D_CLOSED, 4) == 0 {
    rt.mem_store(pd, D_CLOSED, 1, 4)
    let fd = rt.mem_load(pd, D_FD, 4)
    if fd < 2147483648 {
      fd_shut(fd)
    }
    wake(pd, D_RWAIT)
    wake(pd, D_WWAIT)
  }
  var fd = -1
  if rt.mem_load(pd, D_OPS, 4) == 0 {
    fd = take_fd(pd)
  }
  unlk(addw(pd, D_MU))
  if fd >= 0 {
    fd_close(fd)
  }
}

/// Closes pd and hands its record to the poller thread to free.
pub fn pd_free(pd: Int) {
  if pd == 0 {
    return
  }
  pd_close(pd)
  let mu = addw(ev(), EV_MU)
  let dead = addw(ev(), EV_DEAD)
  lk(mu)
  rt.mem_store(pd, D_NEXT, rt.mem_load(dead, 0, 8), 8)
  rt.mem_store(dead, 0, pd, 8)
  unlk(mu)
}

/// Waits in the current task until pd is ready for reading (or writing),
/// the task is canceled, pd is closed, or (when deadline is not 0) the
/// monotonic time deadline (ns, rt.clock_now's clock) passes: READY,
/// CANCELED, CLOSED, or TIMEOUT.
pub fn pd_wait(pd: Int, write: Bool, deadline: Int) -> Int { pd_wait_ctx(pd, write, ctx.cur(), deadline) }

/// pd_wait for context c (xo_rt.c pd_wait_until).
pub fn pd_wait_ctx(pd: Int, write: Bool, c: Int, deadline: Int) -> Int {
  let slot = if write { D_WWAIT } else { D_RWAIT }
  let ready = if write { D_WREADY } else { D_RREADY }
  let park = addw(c, ctx.C_PARK)
  rt.mem_store(c, ctx.C_LOCKS, 0, 8)
  var t = 0
  var res = READY
  while true {
    if budget.canceled(c) {
      res = CANCELED
      break
    }
    lk(addw(pd, D_MU))
    if rt.mem_load(pd, D_CLOSED, 4) != 0 {
      unlk(addw(pd, D_MU))
      res = CLOSED
      break
    }
    if rt.mem_load(pd, ready, 4) != 0 {
      rt.mem_store(pd, ready, 0, 4)
      unlk(addw(pd, D_MU))
      res = READY
      break
    }
    pool.park_reset(park)
    rt.mem_store(pd, slot, park, 8)
    let win = windows()
    if win && afd() != 0 {
      // the poller watches what someone waits for
      pd_arm(pd)
    }
    unlk(addw(pd, D_MU))
    if win && afd() == 0 {
      poke()
    }
    if deadline != 0 && t == 0 {
      t = pd_timer(pd, write)
      timer_arm(t, deadline, park)
    }
    if !(t != 0 && fired(t)) {
      wait(c)
    }
    lk(addw(pd, D_MU))
    let mine = rt.mem_load(pd, slot, 8) == park
    if mine {
      rt.mem_store(pd, slot, 0, 8)
    }
    let closed = rt.mem_load(pd, D_CLOSED, 4) != 0
    unlk(addw(pd, D_MU))
    if closed {
      res = CLOSED
      break
    }
    if !mine {
      // the poller handed it readiness
      res = READY
      break
    }
    if t != 0 && fired(t) {
      res = TIMEOUT
      break
    }
  }
  if t != 0 {
    timer_disarm(t)
  }
  res
}

/// The deadline timer of pd's reads (or writes): made with its pair the
/// first time a wait has a deadline, and kept until pd is freed
/// (pd_timers_free), so a wait with the same deadline as the last does
/// not touch the heap, and one with a new deadline moves it (Go's
/// netpoll resets one timer per descriptor; a timer made, added, deleted
/// and freed per wait cost a deadline per read 1.13x Go, decision 0430).
/// Only one task waits on each side of pd at a time.
fn pd_timer(pd: Int, write: Bool) -> Int {
  lk(addw(pd, D_MU))
  var b = rt.mem_load(pd, D_TIMERS, 8)
  if b == 0 {
    b = rt.heap_large(T_SIZE * 2)
    rt.mem_set(b, 0, T_SIZE * 2)
    for i in 0..2 {
      let t = addw(b, T_SIZE * i)
      rt.mem_store(t, T_IDX, -1, 8)
      rt.mem_store(t, T_FN, FN_PD, 8)
    }
    rt.mem_store(pd, D_TIMERS, b, 8)
  }
  unlk(addw(pd, D_MU))
  if write { addw(b, T_SIZE) } else { b }
}

/// Points pd's timer t at the park p until deadline (timers' ns): it
/// stays where it is when it already waits for that deadline, moves when
/// the deadline changed, and is not added again when it fired for this
/// deadline (a passed deadline stays passed: fired(t) is the timeout).
fn timer_arm(t: Int, deadline: Int, p: Int) {
  let v = virt()
  if !v {
    ev_start()
  }
  let mu = ev_mu()
  lk(mu)
  rt.mem_store(t, T_PARK, p, 8)
  var first = 0
  let same = rt.mem_load(t, T_WHEN, 8) == deadline
  if rt.mem_load(t, T_IDX, 8) >= 0 {
    if !same {
      let later = deadline > rt.mem_load(t, T_WHEN, 8)
      timer_remove(t)
      rt.mem_store(t, T_WHEN, deadline, 8)
      first = timer_push(t)
      if later {
        // the poller waits for no later than the old deadline, then
        // looks again: moving a timer later never needs it woken (a
        // deadline set before every read woke the poller, and it a
        // worker, per read: 22,000 more wakes in 100,000 round trips)
        first = 0
      }
    }
  } else if !(same && fired(t)) {
    rt.slot_store(t, T_FIRED_W, 0, RELAXED)
    rt.mem_store(t, T_WHEN, deadline, 8)
    first = timer_push(t)
  }
  unlk(mu)
  if first != 0 && !v {
    poke()
  }
}

/// Ends a wait on pd's timer t: it signals nobody when it fires, and
/// stays in the heap for the next wait.
fn timer_disarm(t: Int) {
  let mu = ev_mu()
  lk(mu)
  rt.mem_store(t, T_PARK, 0, 8)
  unlk(mu)
}

/// Frees pd's deadline timers, out of the heap (the event loop's lock
/// held: the poller's free of the dead list).
fn pd_timers_free(pd: Int) {
  let b = rt.mem_load(pd, D_TIMERS, 8)
  if b == 0 {
    return
  }
  for i in 0..2 {
    let t = addw(b, T_SIZE * i)
    if rt.mem_load(t, T_IDX, 8) >= 0 {
      timer_remove(t)
    }
  }
  rt.mem_store(pd, D_TIMERS, 0, 8)
  rt.heap_release(subw(b, 8))
}

/// Whether the current task is canceled (and not shielded).
pub fn canceled() -> Bool { budget.canceled(ctx.cur()) }

/// A timer that signals the park p at deadline (ns, the timers' clock:
/// the virtual one in the test world, else rt.clock_now's monotonic
/// one), added to the heap; end it with timer_end.
pub fn timer_park(deadline: Int, p: Int) -> Int {
  let t = rt.heap_large(T_SIZE)
  rt.mem_set(t, 0, T_SIZE)
  rt.mem_store(t, T_WHEN, deadline, 8)
  rt.mem_store(t, T_IDX, -1, 8)
  rt.mem_store(t, T_PARK, p, 8)
  timer_add(t)
  t
}

/// The function word of the test world's FakeProc.signal_after timer
/// (twrun.xo signal_arm), which no C function has: firing it runs the
/// stop state's signal, then frees the timer.
pub const FN_SIGNAL = 1

/// The function words of the other timers whose firing is Xo's (the
/// timer's arg word the record): a select's `after` arm (xo_rt.c
/// xo_select: fired at 32, chosen at 40, the waiter's park at 64; the
/// first to claim fired wins, and chosen -2 tells the wait it timed
/// out), and task.with_timeout's deadline (xo_rt.c xo_scope: the body's
/// node at 16, timed_out, a C int, at 416).
pub const FN_SELECT = 2
pub const FN_SCOPE = 3
/// A descriptor's deadline timer (pd_timer) with no wait to signal: it
/// only records that it fired.
const FN_PD = 4
const T_ARG = 32
const SEL_FIRED = 32
const SEL_CHOSEN = 40
const SEL_PARK = 64
const SC_BODY = 16
const SC_TIMED_OUT = 416

/// Fires timer t, already off the heap, with the event loop's lock word
/// mu held (the poller's loops, and twrun.xo's move of the virtual
/// clock): signals its park or calls its C function. The signal timer's
/// signal runs with mu released (stop.xo takes its own lock, then may
/// add a timer).
pub fn fire(t: Int, mu: Int) {
  rt.slot_store(t, T_FIRED_W, 1, RELEASE)
  let p = rt.mem_load(t, T_PARK, 8)
  if p != 0 {
    signal(p)
    return
  }
  let f = rt.mem_load(t, T_FN, 8)
  if f == FN_PD {
    return
  }
  if f == FN_SIGNAL {
    unlk(mu)
    stop.signal()
    lk(mu)
    rt.heap_release(subw(t, 8))
    return
  }
  if f == FN_SELECT {
    let s = rt.mem_load(t, T_ARG, 8)
    if rt.slot_cas(addw(s, SEL_FIRED), 0, 0, 1, ACQ_REL) {
      rt.slot_store(addw(s, SEL_CHOSEN), 0, -2, RELEASE)
      signal(rt.mem_load(s, SEL_PARK, 8))
    }
    return
  }
  if f == FN_SCOPE {
    let s = rt.mem_load(t, T_ARG, 8)
    rt.fence(RELEASE)
    rt.mem_store(s, SC_TIMED_OUT, 1, 4)
    pool.node_cancel(ctx.pool(), addw(s, SC_BODY))
    return
  }
  let _c = rt.call_c2(f, t, 0)
}

/// A timer of function word f (FN_SELECT, FN_SCOPE) for the record arg,
/// due d ns from now, added to the heap; end it with timer_end.
pub fn timer_fn(d: Int, f: Int, arg: Int) -> Int {
  let t = rt.heap_large(T_SIZE)
  rt.mem_set(t, 0, T_SIZE)
  rt.mem_store(t, T_WHEN, deadline(d), 8)
  rt.mem_store(t, T_IDX, -1, 8)
  rt.mem_store(t, T_FN, f, 8)
  rt.mem_store(t, T_ARG, arg, 8)
  timer_add(t)
  t
}

/// Sleeps d ns in context c unless it is or becomes canceled (xo_rt.c
/// clock_wait, which records the test world's sleep first): whether
/// cancellation ended (or prevented) the sleep, without starting an
/// unwind.
pub fn clock_wait(c: Int, d: Int) -> Bool {
  if budget.canceled(c) {
    return true
  }
  if d <= 0 {
    return false
  }
  let park = park_of(c)
  pool.park_reset(park)
  let t = timer_park(deadline(d), park)
  while !fired(t) && !budget.canceled(c) {
    if tracerec.built() {
      rt.mem_store(c, ctx.C_WHY, tracerec.WHY_SLEEP, 8)
    }
    wait(c)
  }
  let f = fired(t)
  timer_end(t)
  !f && budget.canceled(c)
}

/// Adds timer t (its deadline, and its park or function, set; its place
/// -1) to the heap, starting the poller outside the virtual clock
/// (xo_rt.c timer_add).
pub fn timer_add(t: Int) {
  // the test world has no poller: its timers fire when the virtual clock
  // moves (twrun.xo kick)
  let v = virt()
  if !v {
    ev_start()
  }
  let mu = ev_mu()
  lk(mu)
  let first = timer_push(t)
  unlk(mu)
  if first != 0 && !v {
    poke()
  }
}

/// Takes timer t out of the heap (xo_rt.c timer_del): its function does
/// not run after this returns.
pub fn timer_del(t: Int) {
  let mu = ev_mu()
  lk(mu)
  if rt.mem_load(t, T_IDX, 8) >= 0 {
    timer_remove(t)
  }
  unlk(mu)
}

/// Whether the timers' clock is the test world's virtual one (xo_rt.c
/// tw.virt).
fn virt() -> Bool { twflags.vclock() != 0 }

/// Wakes the poller (a new first timer; xo_rt.c ev_poke): a byte in the
/// self pipe (a full pipe wakes it anyway); on Windows a completion
/// posted to the port, or a byte in the WSAPoll fallback's socket pair.
pub fn poke() {
  if windows() {
    let e = ev()
    if rt.mem_load(e, EV_AFD, 8) != 0 {
      let _p = sys_windows.PostQueuedCompletionStatus(rt.mem_load(e, EV_IOCP, 8), 0, 1, 0)
    } else {
      let b = obj.scratch()
      rt.mem_store(b, 0, 119, 1)
      let _s = sys_windows.send(rt.mem_load(e, EV_WW, 8), b, 1, 0)
    }
    return
  }
  let b = obj.scratch()
  rt.mem_store(b, 0, 119, 1)
  let w = s32(rt.mem_load(ev(), EV_PIPE_W, 4))
  let _w = match target.os {
    TargetOs.Darwin => sys_darwin.write(w, b, 1)
    TargetOs.Linux => linux.write_at(w, b, 1)
    TargetOs.Windows | TargetOs.Wasi => 0
  }
}

/// The event loop's record (poll_svc made it).
fn ev() -> Int { rt.mem_load(rt.static_word(W_EV), 0, 8) }

/// Parks context c until its park is signaled or it is canceled, not
/// counted as blocked (tasks.xo park_wait_n through cabi.xo poll_park_wait:
/// tasks.xo sits above this module in the imports).
fn wait(c: Int) {
  // a poller wait unless its caller named the reason (sleep_until, the
  // HTTP servers)
  if tracerec.built() && rt.mem_load(c, ctx.C_WHY, 8) == 0 {
    if tracerec.built() {
      rt.mem_store(c, ctx.C_WHY, tracerec.WHY_NET, 8)
    }
  }
  let _r = rt.call_c2(rt.fn_addr("poll_park_wait"), c, 0)
}

/// The SIGINT and SIGTERM handler (cabi.xo on_signal, which entry.xo
/// installs; was xo_rt.c's): counts the signal and wakes the poller
/// through the self pipe, whose thread runs the shutdown's step. Async
/// signal safe: no allocation, lock, or scratch buffer (the byte written
/// is a literal's), and errno kept (libSystem's write may set it; Linux's
/// is a system call).
pub fn on_signal(sig: Int) {
  let e = ev()
  let i = sig_index(sig)
  if i >= 0 && ((rt.slot_load(addw(e, EV_SUBS), 0, ACQUIRE) >> i) & 1) != 0 {
    // a subscription takes it (decision 0407): delivered by the poller
    let _p = rt.slot_add(addw(e, EV_PENDN + 8 * i), 0, 1, ACQ_REL)
  } else if i == SIG_QUIT {
    let _q = rt.slot_add(addw(e, EV_QUITS), 0, 1, ACQ_REL)
  } else {
    let _n = rt.slot_add(addw(e, EV_SIGS), 0, 1, ACQ_REL)
  }
  let b = "s"
  let w = s32(rt.mem_load(e, EV_PIPE_W, 4))
  match target.os {
    TargetOs.Darwin => {
      let ep = sys_darwin.__error()
      let saved = rt.mem_load(ep, 0, 4)
      let _w = sys_darwin.write(w, raw.data(b), 1)
      rt.mem_store(ep, 0, saved, 4)
    }
    TargetOs.Linux => {
      let _w = linux.write_at(w, raw.data(b), 1)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// Signal indexes (the prelude's Signal enum, decision 0407).
pub const SIG_HUP = 0
pub const SIG_INT = 1
pub const SIG_QUIT = 2
pub const SIG_TERM = 3
pub const SIG_USR1 = 4
pub const SIG_USR2 = 5
pub const SIG_WINCH = 6

/// The Signal index of the system's signal number sig, or -1.
pub fn sig_index(sig: Int) -> Int {
  let s = sig & 4294967295
  if s == 1 { return SIG_HUP }
  if s == 2 { return SIG_INT }
  if s == 3 { return SIG_QUIT }
  if s == 15 { return SIG_TERM }
  if s == 28 { return SIG_WINCH }
  match target.os {
    TargetOs.Darwin => {
      if s == 30 { return SIG_USR1 }
      if s == 31 { return SIG_USR2 }
    }
    _ => {
      if s == 10 { return SIG_USR1 }
      if s == 12 { return SIG_USR2 }
    }
  }
  -1
}

/// The system's signal number of Signal index i (sig_index's inverse).
pub fn sig_number(i: Int) -> Int {
  match i {
    0 => 1
    1 => 2
    2 => 3
    3 => 15
    4 => if target.os is TargetOs.Darwin { 30 } else { 10 }
    5 => if target.os is TargetOs.Darwin { 31 } else { 12 }
    _ => 28
  }
}

/// SIGQUIT's handler (cabi.xo on_quit, decision 0251): counts it and
/// wakes the poller, whose thread writes the task tree (`xo dump`); async
/// signal safe as on_signal.
pub fn on_quit() {
  let e = ev()
  if ((rt.slot_load(addw(e, EV_SUBS), 0, ACQUIRE) >> SIG_QUIT) & 1) != 0 {
    let _p = rt.slot_add(addw(e, EV_PENDN + 8 * SIG_QUIT), 0, 1, ACQ_REL)
  } else {
    let _n = rt.slot_add(addw(e, EV_QUITS), 0, 1, ACQ_REL)
  }
  let b = "q"
  let w = s32(rt.mem_load(e, EV_PIPE_W, 4))
  match target.os {
    TargetOs.Darwin => {
      let ep = sys_darwin.__error()
      let saved = rt.mem_load(ep, 0, 4)
      let _w = sys_darwin.write(w, raw.data(b), 1)
      rt.mem_store(ep, 0, saved, 4)
    }
    TargetOs.Linux => {
      let _w = linux.write_at(w, raw.data(b), 1)
    }
    TargetOs.Windows | TargetOs.Wasi => {}
  }
}

/// Hands each subscribed signal that arrived to sigsub.xo's subscribers
/// (decision 0407), on the poller's thread (cabi.xo sig_deliver: sigsub
/// sits above this module).
fn deliver_pending(e: Int) {
  for i in 0..7 {
    if rt.slot_swap(addw(e, EV_PENDN + 8 * i), 0, 0, ACQ_REL) > 0 {
      let _d = rt.call_c2(rt.fn_addr("sig_deliver"), i, 0)
    }
  }
}

/// Windows' console handler (cabi.xo on_console, which entry.xo installs
/// with SetConsoleCtrlHandler; was xo_rt.c's): Ctrl-C, Ctrl-Break,
/// closing the console, and shutdown (CTRL_C_EVENT 0, CTRL_BREAK_EVENT
/// 1, CTRL_CLOSE_EVENT 2, CTRL_SHUTDOWN_EVENT 6) are SIGINT and SIGTERM:
/// it counts the signal and wakes the poller, and returns 1 (handled);
/// 0 for any other event. It runs on a thread Windows starts, which has
/// no thread table: no scratch buffer (the byte sent is a literal's).
/// UNTESTED on windows (cross links only).
pub fn on_console(kind0: Int) -> Int {
  // a DWORD: the register's high half is not defined
  let kind = kind0 & 4294967295
  if kind != 0 && kind != 1 && kind != 2 && kind != 5 && kind != 6 {
    return 0
  }
  let e = ev()
  // Go's mapping (decision 0407): Ctrl-C and Ctrl-Break are Interrupt;
  // the console's close, a logoff (5) and a shutdown are Terminate
  let i = if kind <= 1 { SIG_INT } else { SIG_TERM }
  if ((rt.slot_load(addw(e, EV_SUBS), 0, ACQUIRE) >> i) & 1) != 0 {
    let _p = rt.slot_add(addw(e, EV_PENDN + 8 * i), 0, 1, ACQ_REL)
  } else {
    let _n = rt.slot_add(addw(e, EV_SIGS), 0, 1, ACQ_REL)
  }
  match target.os {
    TargetOs.Windows => {
      if rt.mem_load(e, EV_AFD, 8) != 0 {
        let _p = sys_windows.PostQueuedCompletionStatus(rt.mem_load(e, EV_IOCP, 8), 0, 1, 0)
      } else {
        let b = "w"
        let _s = sys_windows.send(rt.mem_load(e, EV_WW, 8), raw.data(b), 1, 0)
      }
    }
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi => {}
  }
  1
}

/// Starts the event loop once (xo_rt.c ev_start): the self pipe, the
/// kqueue or epoll descriptor, and the poller thread; a caller that
/// finds the start under way waits for it.
pub fn ev_start() {
  let once = addw(ev(), EV_ONCE)
  if rt.slot_load(once, 0, ACQUIRE) == 2 {
    return
  }
  if rt.slot_cas(once, 0, 0, 1, ACQ_REL) {
    if windows() {
      ev_init_win()
    } else {
      ev_init()
    }
    rt.slot_store(once, 0, 2, RELEASE)
    return
  }
  while rt.slot_load(once, 0, ACQUIRE) != 2 {
    rt.spin_hint()
  }
}

/// The start on Linux and macOS (xo_rt.c ev_init): out of memory when the
/// system refuses one of the parts, as the C's was.
fn ev_init() {
  let e = ev()
  let p = obj.scratch()
  // close-on-exec from birth on Linux (pipe2): with FD_CLOEXEC set just
  // after, a process spawned by another thread in between inherited it
  // and held it open for its life (2026-10-12, gotcha
  // linux-epoll-inherited-socket); macOS has no pipe2
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  let pr = if darwin { Int(sys_darwin.pipe(p)) } else { linux.pipe2(p, linux.O_CLOEXEC) }
  if pr < 0 {
    heapos.oom()
  }
  let r = s32(rt.mem_load(p, 0, 4))
  let w = s32(rt.mem_load(p, 4, 4))
  // sock.nonblock sets FD_CLOEXEC too (macOS's pipe)
  let _a = sock.nonblock(r)
  let _b = sock.nonblock(w)
  rt.mem_store(e, EV_PIPE_R, r, 4)
  rt.mem_store(e, EV_PIPE_W, w, 4)
  if darwin {
    let kq = Int(sys_darwin.kqueue())
    if kq < 0 {
      heapos.oom()
    }
    // F_SETFD 2, FD_CLOEXEC 1
    let _c = sock.fcntl(kq, 2, 1)
    rt.mem_store(e, EV_POLL, kq, 4)
    // the pipe's read end: EVFILT_READ, EV_ADD, no data (the self pipe)
    let k = obj.scratch()
    rt.mem_set(k, 0, 32)
    rt.mem_store(k, 0, r, 8)
    rt.mem_store(k, 8, 65535, 2)
    rt.mem_store(k, 10, 1, 2)
    if Int(sys_darwin.kevent(kq, k, 1, 0, 0, 0)) < 0 {
      heapos.oom()
    }
  } else {
    // EPOLL_CLOEXEC
    let ep = sock.epoll_create(524288)
    if ep < 0 {
      heapos.oom()
    }
    rt.mem_store(e, EV_POLL, ep, 4)
    // EPOLLIN, data 0 (the self pipe)
    if epoll_add(ep, r, 1, 0) < 0 {
      heapos.oom()
    }
  }
  // decision 0324: the token holder's event buffer (as poll_main's)
  rt.mem_store(e, EV_BUF, rt.heap_large(addw(NEVENTS.wrapping_mul(32), 16 + 64)), 8)
  rt.mem_store(e, EV_ON, if np_wanted() { 1 } else { 0 }, 8)
  if !pool.thread_start(rt.fn_addr("poll_thread"), 0) {
    heapos.oom()
  }
}

/// The poller thread's start (the export xo_x_poll_thread, which
/// pool.thread_start runs): the loop over kqueue or epoll, on Windows
/// over the completion port or WSAPoll.
pub fn poll_thread() {
  let e = ev()
  if windows() {
    if rt.mem_load(e, EV_AFD, 8) != 0 && rt.mem_load(e, EV_ON, 8) != 0 {
      poll_main(0, 0, addw(e, EV_MU), addw(e, EV_DEAD), addw(e, EV_SIGS))
    } else if rt.mem_load(e, EV_AFD, 8) != 0 {
      poll_main_win(rt.mem_load(e, EV_IOCP, 8), addw(e, EV_MU), addw(e, EV_DEAD), addw(e, EV_SIGS))
    } else {
      poll_main_wsa(e)
    }
    return
  }
  poll_main(s32(rt.mem_load(e, EV_POLL, 4)), s32(rt.mem_load(e, EV_PIPE_R, 4)), addw(e, EV_MU), addw(e, EV_DEAD), addw(e, EV_SIGS))
}

/// The event loop's lock word (EV_MU), and taking and releasing
/// it.
pub fn ev_mu() -> Int { addw(ev(), EV_MU) }

/// Whether timer t (of timer_park) fired.
pub fn timer_fired(t: Int) -> Bool { fired(t) }

/// Takes timer t (of timer_park) out of the heap and frees it.
pub fn timer_end(t: Int) {
  timer_del(t)
  rt.heap_release(t - 8)
}

/// The park of context c.
pub fn park_of(c: Int) -> Int { addw(c, ctx.C_PARK) }

/// Waits in the current task until the monotonic time deadline (ns,
/// rt.clock_now's clock) passes or the task is canceled: TIMEOUT or
/// CANCELED (xo_rt.c clock_wait, for std/native/llrt/proc.xo's wait for
/// a child's exit).
pub fn sleep_until(deadline: Int) -> Int {
  let c = ctx.cur()
  let park = park_of(c)
  pool.park_reset(park)
  let t = timer_park(deadline, park)
  var res = TIMEOUT
  while true {
    if budget.canceled(c) {
      res = CANCELED
      break
    }
    if fired(t) {
      break
    }
    if tracerec.built() {
      rt.mem_store(c, ctx.C_WHY, tracerec.WHY_SLEEP, 8)
    }
    wait(c)
  }
  timer_end(t)
  res
}

/// Signals the park p (xo_rt.c park_signal): its context's wait returns.
pub fn park_signal(p: Int) { signal(p) }

/// Waits in context c until its park is signaled (park_wait_n(c, 1, 0));
/// the caller reset the park and handed it out first.
pub fn park_wait(c: Int) {
  wait(c)
}

/// One wait of the HTTP/2 server connection's fiber (context c, its park
/// reset and handed to the stream tasks first; xo_h2.c's h2_wait until
/// B28 part 2): until pd has input, the park is signaled (a stream task
/// queued output), or the monotonic time deadline (0: none) passes.
/// False when the connection must end: pd closed, the deadline passed.
pub fn pd_wait_or_signal(pd: Int, c: Int, deadline: Int) -> Bool {
  let park = park_of(c)
  var ok = true
  lk(addw(pd, D_MU))
  if rt.mem_load(pd, D_CLOSED, 4) != 0 {
    ok = false
  } else if rt.mem_load(pd, D_RREADY, 4) != 0 {
    rt.mem_store(pd, D_RREADY, 0, 4)
  } else {
    rt.mem_store(pd, D_RWAIT, park, 8)
    let win = windows()
    if win && afd() != 0 {
      // the poller watches what someone waits for (pd_wait_until)
      pd_arm(pd)
    }
    unlk(addw(pd, D_MU))
    if win && afd() == 0 {
      poke()
    }
    var t = 0
    var due = false
    if deadline != 0 {
      if sysio.mono_ns() >= deadline {
        due = true
      } else {
        t = timer_park(deadline, park)
      }
    }
    if !due {
      wait(c)
    }
    if t != 0 {
      due = fired(t)
      timer_end(t)
    }
    if deadline != 0 && (due || sysio.mono_ns() >= deadline) {
      ok = false
    }
    lk(addw(pd, D_MU))
    if rt.mem_load(pd, D_RWAIT, 8) == park {
      rt.mem_store(pd, D_RWAIT, 0, 8)
    }
    if rt.mem_load(pd, D_CLOSED, 4) != 0 {
      ok = false
    }
  }
  unlk(addw(pd, D_MU))
  ok
}

// ---------------------------------------------------------------------------
// The poller thread (xo_rt.c poller_main)

/// The events one wait collects.
const NEVENTS = 64

/// The poller thread's loop, which never returns: poll is the kqueue or
/// epoll descriptor, pipe_r the self pipe's read end, mu the event loop's
/// lock word (ev.mu), dead the address of the list of descriptors to
/// free (each from rt.heap_large: pd_open), sigs the address of the
/// count of signals not handled yet (each a step of stop.xo's
/// shutdown); poll_round reads them from the record. With workers
/// polling (decision 0324) the thread is their fallback: asleep while a
/// worker waits in the poller, a tick (NP_TICK_MIN to NP_TICK_MAX) while they poll, a
/// poll without waiting when none did for a tick (every worker busy:
/// their events and timers go through the inject queue, as Go's sysmon's
/// poll), and after NP_QUIET such ticks it waits in the poller itself
/// until something happens (a quiet program costs no ticks).
pub fn poll_main(poll: Int, pipe_r: Int, mu: Int, dead: Int, sigs: Int) {
  // the events (struct kevent of 32 bytes, struct epoll_event of 16 or
  // 12), a struct timespec, and the pipe's drain buffer
  let evs = rt.heap_large(addw(NEVENTS.wrapping_mul(32), 16 + 64))
  let e = ev()
  if rt.mem_load(e, EV_ON, 8) == 0 {
    while true {
      let _n = poll_round(e, evs, -1, false)
    }
  }
  let tok = addw(e, EV_TOK)
  let sl = addw(e, EV_PSLEEP)
  var quiet = 0
  var tick = NP_TICK_MIN
  while true {
    if rt.slot_load(tok, 0, ACQUIRE) == TOK_BLOCKED {
      // a worker waits in the poller: sleep until it gives the token
      // back (np_poll wakes this thread then)
      rt.slot_store(sl, 0, 1, SEQ_CST)
      if rt.slot_load(tok, 0, SEQ_CST) == TOK_BLOCKED {
        while rt.slot_load(sl, 0, ACQUIRE) == 1 {
          pool.futex_wait(sl, 1)
        }
      }
      rt.slot_store(sl, 0, 0, RELAXED)
      quiet = 0
      tick = NP_TICK_MIN
      continue
    }
    pool.futex_wait_us(sl, 0, tick / 1000)
    if subw(sysio.mono_ns(), rt.slot_load(e, EV_LAST / 8, RELAXED)) < tick {
      // the workers poll
      quiet = 0
      tick = if tick < NP_TICK_MAX / 2 { tick.wrapping_shl(1) } else { NP_TICK_MAX }
      continue
    }
    if !rt.slot_cas(tok, 0, TOK_FREE, TOK_POLLER, ACQUIRE) {
      continue
    }
    quiet = addw(quiet, 1)
    let n = poll_round(e, evs, if quiet >= NP_QUIET && tick >= NP_TICK_MAX { -1 } else { 0 }, false)
    rt.slot_store(e, EV_LAST / 8, sysio.mono_ns(), RELAXED)
    rt.slot_store(tok, 0, TOK_FREE, RELEASE)
    if n > 0 {
      quiet = 0
      tick = NP_TICK_MIN
    } else {
      tick = if tick < NP_TICK_MAX / 2 { tick.wrapping_shl(1) } else { NP_TICK_MAX }
    }
  }
}

/// One round of the poller (its caller holds the token, or is the poller
/// thread with workers not polling): frees the closed descriptors, fires
/// the due timers, waits for events into evs (at most until the first
/// timer, and at most maxwait ns; -1 no limit, 0 no wait; no wait when a
/// timer fired on a worker), and hands each to its waiters, the self
/// pipe's to the signals' steps: the events and timers handled. worker:
/// a worker's poll, whose readied fibers go to its own ring with no wake
/// (pool.xo np_poll).
fn poll_round(e: Int, evs: Int, maxwait: Int, worker: Bool) -> Int {
  let win = windows()
  let poll = if win { rt.mem_load(e, EV_IOCP, 8) } else { s32(rt.mem_load(e, EV_POLL, 4)) }
  let pipe_r = if win { -1 } else { s32(rt.mem_load(e, EV_PIPE_R, 4)) }
  let mu = addw(e, EV_MU)
  let dead = addw(e, EV_DEAD)
  let sigs = addw(e, EV_SIGS)
  let ts = addw(evs, NEVENTS.wrapping_mul(32))
  let drain = addw(ts, 16)
  var fired = 0
  lk(mu)
  var pd = rt.mem_load(dead, 0, 8)
  while pd != 0 {
    let next = rt.mem_load(pd, D_NEXT, 8)
    pd_timers_free(pd)
    if win {
      dead_win(pd)
    } else {
      rt.heap_release(subw(pd, 8))
    }
    pd = next
  }
  rt.mem_store(dead, 0, 0, 8)
  let now = sysio.mono_ns()
  var t = timer_first()
  while t != 0 && dl(t) <= now {
    timer_remove(t)
    fire(t, mu)
    fired = addw(fired, 1)
    t = timer_first()
  }
  let first = timer_first()
  var wait = if first == 0 { -1 } else { subw(dl(first), now) }
  if maxwait >= 0 && (wait < 0 || wait > maxwait) {
    wait = maxwait
  }
  if fired > 0 && worker {
    // the fired timers' fibers wait on this worker's ring: a blocking
    // wait left them there with nothing to end it (a build's waitpid
    // sleep loop hung, 2026-10-21)
    wait = 0
  }
  unlk(mu)
  let n = wait_events(poll, evs, ts, wait)
  if tracerec.built() && tracerec.on() {
    tracerec.ev(tracerec.K_POLL, 0, n, 0)
  }
  stat(ST_POLL_RETURN)
  var i = 0
  while i < n {
    let (p, mode) = event(evs, i)
    if p != 0 && win {
      afd_done(p)
    } else if p != 0 {
      pd_ready(p, mode)
    } else {
      // the self pipe: drain it (on Windows the break is a completion
      // with no record), then the signals that wrote to it
      while !win && read_fd(pipe_r, drain, 64) > 0 {}
      var k = rt.slot_swap(sigs, 0, 0, ACQ_REL)
      while k > 0 {
        stop.signal()
        k = subw(k, 1)
      }
      deliver_pending(ev())
      // SIGQUIT: the task tree, on this thread (cabi.xo dump_now)
      if rt.slot_swap(addw(sigs, EV_QUITS - EV_SIGS), 0, 0, ACQ_REL) > 0 {
        let _d = rt.call_c2(rt.fn_addr("dump_now"), 0, 0)
      }
    }
    i = addw(i, 1)
  }
  addw(n, fired)
}

/// Whether workers poll the network themselves (decision 0324): Linux and
/// macOS, Windows with the AFD device (they dequeue the completion port),
/// not the test world's virtual clock (twrun moves its timers),
/// and XO_NETPOLL not 0.
fn np_wanted() -> Bool {
  let os_ok = match target.os {
    TargetOs.Darwin | TargetOs.Linux => true
    TargetOs.Windows => afd() != 0
    TargetOs.Wasi => false
  }
  if !os_ok || virt() {
    return false
  }
  let v = process.env_real("XO_NETPOLL")
  v.is_empty() || v[0] != "0"
}

/// A worker's poll (decision 0324, through cabi.xo np_poll): with the
/// token free, one round, waiting at most wait ns (-1 no limit, 0 none)
/// for the next event or timer, the fibers it readies pushed from the
/// calling worker (pool.xo np_poll): the events and timers handled, or -1
/// when it did not poll (workers do not poll here, the event loop is not
/// started, another thread holds the token).
pub fn np_poll(wait: Int, p: Int) -> Int {
  let e = ev()
  if e == 0 || rt.slot_load(addw(e, EV_ONCE), 0, ACQUIRE) != 2 || rt.mem_load(e, EV_ON, 8) == 0 {
    return -1
  }
  let tok = addw(e, EV_TOK)
  if rt.slot_load(tok, 0, RELAXED) != TOK_FREE || !rt.slot_cas(tok, 0, TOK_FREE, if wait != 0 { TOK_BLOCKED } else { TOK_WORKER }, ACQUIRE) {
    return -1
  }
  if wait != 0 && p != 0 && pool.np_pending(p) {
    // the token reads BLOCKED now, so a push from here on pokes; one
    // before it (np_break saw the token held) is found by this check
    rt.slot_store(tok, 0, TOK_FREE, SEQ_CST)
    return 0
  }
  let n = poll_round(e, rt.mem_load(e, EV_BUF, 8), wait, true)
  rt.slot_store(e, EV_LAST / 8, sysio.mono_ns(), RELAXED)
  rt.slot_store(tok, 0, TOK_FREE, SEQ_CST)
  let sl = addw(e, EV_PSLEEP)
  if rt.slot_load(sl, 0, SEQ_CST) == 1 && rt.slot_cas(sl, 0, 1, 2, ACQ_REL) {
    pool.futex_wake(sl)
  }
  n
}

/// Breaks a worker's wait in the poller (decision 0324, through cabi.xo
/// np_break: work was pushed while every other worker is busy): a byte in
/// the self pipe when a worker waits there, or may be about to: the
/// token still free while a worker counted in the poller's wait (pool.xo
/// DLK_NPBLK, which the caller checked) has looked for work and not yet
/// taken it; the byte then ends its wait at once. A worker or the poller
/// thread holding the token makes that worker wait on its futex instead,
/// where go_idle's own check after listing sees the push.
pub fn np_break() {
  let e = ev()
  if e != 0 {
    let t = rt.slot_load(addw(e, EV_TOK), 0, SEQ_CST)
    if t == TOK_BLOCKED || t == TOK_FREE {
      poke()
    }
  }
}

const ACQ_REL = 3

/// Waits for at most NEVENTS events into evs, at most wait ns (-1: no
/// limit): the count (0 on an error or a timeout).
fn wait_events(poll: Int, evs: Int, ts: Int, wait: Int) -> Int {
  match target.os {
    TargetOs.Darwin => {
      var tp = 0
      if wait >= 0 {
        rt.mem_store(ts, 0, wait / 1000000000, 8)
        rt.mem_store(ts, 8, wait % 1000000000, 8)
        tp = ts
      }
      let r = Int(sys_darwin.kevent(poll, 0, 0, evs, NEVENTS, tp))
      // the acquire of register's release (as epoll_wait's below)
      sanhook.acquire(ev())
      if r < 0 { 0 } else { r }
    }
    TargetOs.Linux => {
      var r = -38
      if wait > 0 && wait < 1000000 {
        // under a millisecond (an idle worker waiting out a run-next
        // grace, pool.xo np_block): epoll_wait would round it up to 1 ms
        rt.mem_store(ts, 0, 0, 8)
        rt.mem_store(ts, 8, wait, 8)
        r = sock.epoll_pwait2(poll, evs, NEVENTS, ts)
      }
      if r == -38 {
        var ms = -1
        if wait >= 0 {
          ms = if wait > 1099511627776 { 1073741824 } else { addw(wait, 999999) / 1000000 }
        }
        r = sock.epoll_wait(poll, evs, NEVENTS, ms)
      }
      // the acquire of epoll_add's release: the kernel orders a
      // registration before its events, which ThreadSanitizer sees only
      // through the C library's interceptors (gotchas/tsan-raw-epoll-no-edge.md)
      sanhook.acquire(ev())
      if r < 0 { 0 } else { r }
    }
    TargetOs.Windows => {
      // the completion port dequeues OVERLAPPED_ENTRY records (32 bytes,
      // the record at 8: event()), the count in ts; a wait under 1 ms
      // does not wait (the port's timeout follows the 15.6 ms tick)
      var ms = INFINITE
      if wait >= 0 {
        ms = if wait < 1000000 { 0 } else if wait > 1099511627776 { 1073741824 } else { addw(wait, 999999) / 1000000 }
      }
      rt.mem_store(ts, 0, 0, 8)
      if Int(sys_windows.GetQueuedCompletionStatusEx(poll, evs, NEVENTS, ts, ms, 0)) != 0 {
        rt.mem_load(ts, 0, 4)
      } else {
        0
      }
    }
    TargetOs.Wasi => 0
  }
}

/// Event i of evs: its descriptor (0: the self pipe) and its readiness (1
/// read, 2 write, 3 both).
fn event(evs: Int, i: Int) -> (Int, Int) {
  match target.os {
    TargetOs.Darwin => {
      // struct kevent: filter (int16) at 8, flags (uint16) at 10, udata
      // at 24; EVFILT_READ -1, EVFILT_WRITE -2, EV_ERROR 0x4000
      let e = addw(evs, i.wrapping_shl(5))
      let f = rt.mem_load(e, 8, 2)
      var mode = if f == 65535 { 1 } else if f == 65534 { 2 } else { 0 }
      if (rt.mem_load(e, 10, 2) & 16384) != 0 {
        mode = 3
      }
      (rt.mem_load(e, 24, 8), mode)
    }
    TargetOs.Linux => {
      // struct epoll_event: events (uint32) at 0, data at 8 (arm64) or 4
      // (x86_64, packed); EPOLLIN 1, EPOLLOUT 4, EPOLLERR 8, EPOLLHUP 16,
      // EPOLLRDHUP 0x2000
      let size = match target.arch {
        TargetArch.Amd64 => 12
        TargetArch.Arm64 | TargetArch.Wasm32 => 16
      }
      let e = addw(evs, i.wrapping_mul(size))
      let f = rt.mem_load(e, 0, 4)
      let data = rt.mem_load(e, subw(size, 8), 8)
      let r = if (f & (1 | 8192 | 16 | 8)) != 0 { 1 } else { 0 }
      let w = if (f & (4 | 16 | 8)) != 0 { 2 } else { 0 }
      (data, r | w)
    }
    TargetOs.Windows => (rt.mem_load(evs, addw(i.wrapping_mul(32), 8), 8), 0)
    TargetOs.Wasi => (0, 0)
  }
}

/// A closed descriptor's record (on the poller or a worker): freed, or,
/// with a poll in flight, marked to be freed by its cancelled poll's
/// completion (afd_done).
fn dead_win(pd: Int) {
  lk(addw(pd, D_MU))
  let armed = rt.mem_load(pd, D_ARMED, 4) != 0
  if armed {
    rt.mem_store(pd, D_DYING, 1, 4)
    let _c = sys_windows.CancelIoEx(afd(), addw(pd, D_IOSB))
  }
  unlk(addw(pd, D_MU))
  if !armed {
    rt.heap_release(subw(pd, 8))
  }
}

/// read(2) of at most n bytes into the address a.
fn read_fd(fd: Int, a: Int, n: Int) -> Int {
  match target.os {
    TargetOs.Darwin => sys_darwin.read(fd, a, n)
    TargetOs.Linux => sock.read(fd, a, n)
    TargetOs.Windows | TargetOs.Wasi => -1
  }
}

// ---------------------------------------------------------------------------
// Windows (B22 stage 4; xo_rt.c's XO_WINPOLL code, UNTESTED on windows):
// a waiter arms a one shot AFD poll of its socket (IOCTL_AFD_POLL on
// \Device\Afd, the driver under Winsock's select and WSAPoll, as wepoll
// and mio use it) for the directions waited in, and the poll's
// completion, read from the I/O completion port by poll_main_win, hands
// the readiness over. The C keeps opening the device and the port
// (ev_init), registering a descriptor (pd_new: its base socket), and the
// WSAPoll loop used when the device cannot be opened.

/// A descriptor record's Windows words (layout.xo DW_SIZE).
const D_IOSB = layout.DW_IOSB
const D_INFO = layout.DW_INFO
const D_BASE = layout.DW_BASE
const D_ARMED = layout.DW_ARMED
const D_REARM = layout.DW_REARM
const D_DYING = layout.DW_DYING

/// The AFD events of reading and writing (xo_rt.c XO_AFD_READ, WRITE:
/// receive, expedited, disconnect, abort, local close, accept, connect
/// failure; send, abort, local close, connect failure).
const AFD_READ = 443
const AFD_WRITE = 308
const IOCTL_AFD_POLL = 73764
const STATUS_PENDING = 259
const INFINITE = 4294967295

fn windows() -> Bool {
  match target.os {
    TargetOs.Windows => true
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi => false
  }
}

fn s32(v: Int) -> Int {
  let w = v & 4294967295
  if w >= 2147483648 { subw(w, 4294967296) } else { w }
}

/// Starts (the record's lock held) an AFD poll of pd's socket for the
/// directions someone waits in, unless one runs; a running poll that
/// lacks a direction now waited in is cancelled, and its completion
/// starts the wider one (xo_rt.c pd_arm).
pub fn pd_arm(pd: Int) {
  let dev = afd()
  if dev == 0 || rt.mem_load(pd, D_CLOSED, 4) != 0 || s32(rt.mem_load(pd, D_FD, 4)) < 0 || rt.mem_load(pd, D_DYING, 4) != 0 {
    return
  }
  let want = (if rt.mem_load(pd, D_RWAIT, 8) != 0 { AFD_READ } else { 0 }) | (if rt.mem_load(pd, D_WWAIT, 8) != 0 { AFD_WRITE } else { 0 })
  if want == 0 {
    return
  }
  let armed = rt.mem_load(pd, D_ARMED, 4)
  if armed != 0 {
    if (want & (armed ^ 4294967295)) != 0 && rt.mem_load(pd, D_REARM, 4) == 0 {
      rt.mem_store(pd, D_REARM, 1, 4)
      let _c = sys_windows.CancelIoEx(dev, addw(pd, D_IOSB))
    }
    return
  }
  // AFD_POLL_INFO: no timeout (INT64_MAX), one handle, not exclusive
  let info = addw(pd, D_INFO)
  rt.mem_store(info, 0, 9223372036854775807, 8)
  rt.mem_store(info, 8, 1, 4)
  rt.mem_store(info, 12, 0, 4)
  rt.mem_store(info, 16, rt.mem_load(pd, D_BASE, 8), 8)
  rt.mem_store(info, 24, want, 4)
  rt.mem_store(info, 28, 0, 4)
  rt.mem_store(pd, D_IOSB, STATUS_PENDING, 4)
  // the completion's OVERLAPPED pointer is the APC context: pd
  let st = s32(Int(sys_windows.NtDeviceIoControlFile(dev, 0, 0, pd, addw(pd, D_IOSB), IOCTL_AFD_POLL, info, 32, info, 32)))
  if st == 0 || st == STATUS_PENDING {
    // the completion comes through the port either way
    rt.mem_store(pd, D_ARMED, want, 4)
    return
  }
  // the poll was refused (a closed socket): the operations run and meet
  // the error
  wake(pd, D_RWAIT)
  wake(pd, D_WWAIT)
}

/// The completion of pd's poll (on the poller thread): the readiness to
/// its waiters, then a new poll while someone waits; a record pd_free
/// gave up is freed now that no poll runs (xo_rt.c afd_done).
fn afd_done(pd: Int) {
  lk(addw(pd, D_MU))
  rt.mem_store(pd, D_ARMED, 0, 4)
  rt.mem_store(pd, D_REARM, 0, 4)
  var mode = 0
  if s32(rt.mem_load(pd, D_IOSB, 4)) >= 0 && rt.mem_load(pd, addw(D_INFO, 8), 4) >= 1 {
    let e = rt.mem_load(pd, addw(D_INFO, 24), 4)
    mode = (if (e & AFD_READ) != 0 { 1 } else { 0 }) | (if (e & AFD_WRITE) != 0 { 2 } else { 0 })
  }
  let dying = rt.mem_load(pd, D_DYING, 4) != 0
  unlk(addw(pd, D_MU))
  if dying {
    rt.heap_release(subw(pd, 8))
    return
  }
  if mode != 0 {
    pd_ready(pd, mode)
  }
  lk(addw(pd, D_MU))
  pd_arm(pd)
  unlk(addw(pd, D_MU))
}

/// The poller thread's loop on Windows with the AFD device (never
/// returns; xo_rt.c poller_main's XO_WINPOLL loop): frees the dead
/// records (one with a poll in flight once its cancelled poll completes),
/// fires the timers that are due, waits on the completion port iocp, and
/// handles the completions and the signals (ev.sigs, which the console
/// handler counts and ev_poke wakes the port for).
pub fn poll_main_win(iocp: Int, mu: Int, dead: Int, sigs: Int) {
  let dev = afd()
  // 64 OVERLAPPED_ENTRY records of 32 bytes, then the count removed
  let es = rt.heap_large(64 * 32 + 16)
  let got = addw(es, 64 * 32)
  while true {
    lk(mu)
    var pd = rt.mem_load(dead, 0, 8)
    while pd != 0 {
      let next = rt.mem_load(pd, D_NEXT, 8)
      pd_timers_free(pd)
      lk(addw(pd, D_MU))
      let armed = rt.mem_load(pd, D_ARMED, 4) != 0
      if armed {
        // a poll in flight still names it: freed by its completion
        rt.mem_store(pd, D_DYING, 1, 4)
        let _c = sys_windows.CancelIoEx(dev, addw(pd, D_IOSB))
      }
      unlk(addw(pd, D_MU))
      if !armed {
        rt.heap_release(subw(pd, 8))
      }
      pd = next
    }
    rt.mem_store(dead, 0, 0, 8)
    let now = sysio.mono_ns()
    var t = timer_first()
    while t != 0 && dl(t) <= now {
      timer_remove(t)
      fire(t, mu)
      t = timer_first()
    }
    let first = timer_first()
    let wait = if first == 0 { -1 } else { subw(dl(first), now) }
    unlk(mu)
    var ms = if wait < 0 { INFINITE } else { addw(wait, 999999) / 1000000 }
    if wait > 1099511627776 {
      ms = 1073741824
    }
    rt.mem_store(got, 0, 0, 8)
    var n = 0
    if Int(sys_windows.GetQueuedCompletionStatusEx(iocp, es, 64, got, ms, 0)) != 0 {
      n = rt.mem_load(got, 0, 4)
    }
    stat(ST_POLL_RETURN)
    var i = 0
    while i < n {
      // OVERLAPPED_ENTRY: the key, then lpOverlapped (the record)
      let ov = rt.mem_load(es, addw(i.wrapping_mul(32), 8), 8)
      if ov != 0 {
        afd_done(ov)
      }
      i = addw(i, 1)
    }
    var k = rt.slot_swap(sigs, 0, 0, ACQ_REL)
    while k > 0 {
      stop.signal()
      k = subw(k, 1)
    }
  }
}

// ---------------------------------------------------------------------------
// Windows' start, registration, and WSAPoll fallback (decision 0197; the
// zero-C audit's B22 Windows pass, 2026-10-15: were xo_rt.c ev_init_win,
// afd_open, pd_new, and poller_main's WSAPoll loop). UNTESTED on windows.

/// A descriptor record's size on Windows: layout.xo's.
const D_SIZE_WIN = layout.DW_SIZE

/// SIO_BASE_HANDLE (_WSAIORW(IOC_WS2, 34)), SYNCHRONIZE, FILE_SHARE_READ
/// | FILE_SHARE_WRITE, FILE_OPEN, FILE_SKIP_SET_EVENT_ON_HANDLE.
const SIO_BASE_HANDLE = 3355443234
const SYNCHRONIZE = 1048576
const FILE_SHARE_RW = 3
const FILE_OPEN = 1
const SKIP_SET_EVENT = 2

/// WSAPoll's POLLRDNORM, POLLWRNORM, and the error bits (POLLERR,
/// POLLHUP, POLLNVAL), which wake both directions.
const POLLRDNORM = 256
const POLLWRNORM = 16
const POLL_ERRS = 7

/// The event loop's start on Windows (ev_start, once): the completion
/// port and the AFD device, or, when the device cannot be opened, the
/// WSAPoll fallback's socket pair; then the poller thread. Out of memory
/// when the system refuses a part, as the C's was.
fn ev_init_win() {
  let e = ev()
  let iocp = sys_windows.CreateIoCompletionPort(-1, 0, 0, 0)
  rt.mem_store(e, EV_IOCP, iocp, 8)
  let dev = if iocp != 0 { afd_open(iocp) } else { 0 }
  rt.mem_store(e, EV_AFD, dev, 8)
  // decision 0324: the token holder's event buffer and whether workers poll
  rt.mem_store(e, EV_BUF, rt.heap_large(addw(NEVENTS.wrapping_mul(32), 16 + 64)), 8)
  rt.mem_store(e, EV_ON, if np_wanted() { 1 } else { 0 }, 8)
  if dev == 0 {
    let (r, w) = sock.loopback_pair()
    if r < 0 {
      heapos.oom()
    }
    rt.mem_store(e, EV_WR, r, 8)
    rt.mem_store(e, EV_WW, w, 8)
  }
  if !pool.thread_start(rt.fn_addr("poll_thread"), 0) {
    heapos.oom()
  }
}

/// Opens the AFD device for polls (\Device\Afd\Xo, as wepoll and mio
/// do), its completions on iocp: the handle, or 0 when it cannot (the
/// poller uses WSAPoll then), and always 0 with XO_WINPOLL=wsapoll (to
/// compare the two).
fn afd_open(iocp: Int) -> Int {
  if env_is("XO_WINPOLL", "wsapoll") {
    return 0
  }
  sock.wsa_init()
  // one block: the name's UTF-16 units (15, 32 bytes with the NUL), its
  // UNICODE_STRING (16 bytes: the length and capacity in bytes, the
  // buffer), OBJECT_ATTRIBUTES (48 bytes: its size, no root, the name,
  // no attributes, no security), the IO_STATUS_BLOCK, and the handle
  let b = rt.heap_large(128)
  rt.mem_set(b, 0, 128)
  let name = "\\Device\\Afd\\Xo"
  var i = 0
  while i < name.len() {
    rt.mem_store(b, i * 2, rt.mem_load(raw.data(name), i, 1), 2)
    i = i + 1
  }
  let us = addw(b, 32)
  rt.mem_store(us, 0, name.len() * 2, 2)
  rt.mem_store(us, 2, name.len() * 2 + 2, 2)
  rt.mem_store(us, 8, b, 8)
  let oa = addw(b, 48)
  rt.mem_store(oa, 0, 48, 4)
  rt.mem_store(oa, 16, us, 8)
  let iosb = addw(b, 96)
  let hp = addw(b, 112)
  let st = s32(Int(sys_windows.NtCreateFile(hp, SYNCHRONIZE, oa, iosb, 0, 0, FILE_SHARE_RW, FILE_OPEN, 0, 0, 0)))
  let h = rt.mem_load(hp, 0, 8)
  rt.heap_release(subw(b, 8))
  if st != 0 {
    return 0
  }
  if sys_windows.CreateIoCompletionPort(h, iocp, 0, 0) == 0 {
    let _c = sys_windows.CloseHandle(h)
    return 0
  }
  let _m = sys_windows.SetFileCompletionNotificationModes(h, SKIP_SET_EVENT)
  h
}

/// Whether the environment variable name is set to v (GetEnvironmentVariableA).
fn env_is(name: Str, v: Str) -> Bool {
  let b = obj.scratch()
  rt.mem_copy(b, raw.data(name), name.len())
  rt.mem_store(b, name.len(), 0, 1)
  let out = addw(b, 64)
  let n = Int(sys_windows.GetEnvironmentVariableA(b, out, 32))
  if n != v.len() {
    return false
  }
  var i = 0
  while i < n {
    if rt.mem_load(out, i, 1) != rt.mem_load(raw.data(v), i, 1) {
      return false
    }
    i = i + 1
  }
  true
}

/// A descriptor's registration on Windows (pd_open; xo_rt.c pd_new): a
/// zeroed record for socket fd. With the AFD device its polls go to the
/// socket's base handle (below any layered service provider); with
/// WSAPoll, which is level triggered, it joins the registered list the
/// poller polls in the directions someone waits in.
fn open_win(fd: Int) -> Int {
  ev_start()
  let pd = rt.heap_large(D_SIZE_WIN)
  rt.mem_set(pd, 0, D_SIZE_WIN)
  rt.mem_store(pd, D_FD, fd, 4)
  let e = ev()
  if rt.mem_load(e, EV_AFD, 8) != 0 {
    let b = obj.scratch()
    rt.mem_store(b, 0, -1, 8)
    rt.mem_store(b, 8, 0, 4)
    var base = fd
    if Int(sys_windows.WSAIoctl(fd, SIO_BASE_HANDLE, 0, 0, b, 8, addw(b, 8), 0, 0)) == 0 && rt.mem_load(b, 0, 8) != -1 {
      base = rt.mem_load(b, 0, 8)
    }
    rt.mem_store(pd, D_BASE, base, 8)
    return pd
  }
  lk(addw(e, EV_MU))
  let n = rt.mem_load(e, EV_NREG, 8)
  var regs = rt.mem_load(e, EV_REGS, 8)
  let cap = rt.mem_load(e, EV_CREG, 8)
  if n == cap {
    let nc = if cap == 0 { 64 } else { cap * 2 }
    let nr = rt.heap_large(nc * 8)
    if regs != 0 {
      rt.mem_copy(nr, regs, n * 8)
      rt.heap_release(subw(regs, 8))
    }
    regs = nr
    rt.mem_store(e, EV_REGS, regs, 8)
    rt.mem_store(e, EV_CREG, nc, 8)
  }
  rt.mem_store(regs, n * 8, pd, 8)
  rt.mem_store(e, EV_NREG, addw(n, 1), 8)
  unlk(addw(e, EV_MU))
  pd
}

/// Takes pd off the WSAPoll fallback's registered list (ev's lock held).
fn unregister(e: Int, pd: Int) {
  let regs = rt.mem_load(e, EV_REGS, 8)
  let n = rt.mem_load(e, EV_NREG, 8)
  var i = 0
  while i < n {
    if rt.mem_load(regs, i * 8, 8) == pd {
      rt.mem_store(regs, i * 8, rt.mem_load(regs, subw(n, 1) * 8, 8), 8)
      rt.mem_store(e, EV_NREG, subw(n, 1), 8)
      return
    }
    i = i + 1
  }
}

/// The poller thread's loop on Windows without the AFD device (never
/// returns; was xo_rt.c poller_main's WSAPoll loop): frees the dead
/// records, fires the timers that are due, polls the self pipe and every
/// registered descriptor someone waits on (in the directions waited
/// for), hands the readiness over, drains the self pipe, and runs the
/// signals' shutdown steps.
fn poll_main_wsa(e: Int) {
  let mu = addw(e, EV_MU)
  let dead = addw(e, EV_DEAD)
  let wr = rt.mem_load(e, EV_WR, 8)
  // the WSAPOLLFD array (16 bytes each) and its owners, grown as needed
  var cap = 0
  var fds = 0
  var who = 0
  let drain = rt.heap_large(64)
  while true {
    lk(mu)
    var pd = rt.mem_load(dead, 0, 8)
    while pd != 0 {
      let next = rt.mem_load(pd, D_NEXT, 8)
      pd_timers_free(pd)
      unregister(e, pd)
      rt.heap_release(subw(pd, 8))
      pd = next
    }
    rt.mem_store(dead, 0, 0, 8)
    let now = sysio.mono_ns()
    var t = timer_first()
    while t != 0 && dl(t) <= now {
      timer_remove(t)
      fire(t, mu)
      t = timer_first()
    }
    let first = timer_first()
    let wait = if first == 0 { -1 } else { subw(dl(first), now) }
    var ms = if wait < 0 { -1 } else { addw(wait, 999999) / 1000000 }
    if wait > 1099511627776 {
      ms = 1073741824
    }
    let nreg = rt.mem_load(e, EV_NREG, 8)
    if cap < addw(nreg, 1) {
      if fds != 0 {
        rt.heap_release(subw(fds, 8))
        rt.heap_release(subw(who, 8))
      }
      cap = addw(nreg, 1) * 2
      fds = rt.heap_large(cap * 16)
      who = rt.heap_large(cap * 8)
    }
    rt.mem_store(fds, 0, wr, 8)
    rt.mem_store(fds, 8, POLLRDNORM, 2)
    rt.mem_store(fds, 10, 0, 2)
    rt.mem_store(who, 0, 0, 8)
    var nf = 1
    let regs = rt.mem_load(e, EV_REGS, 8)
    var i = 0
    while i < nreg {
      let p = rt.mem_load(regs, i * 8, 8)
      lk(addw(p, D_MU))
      var want = 0
      if rt.mem_load(p, D_CLOSED, 4) == 0 && s32(rt.mem_load(p, D_FD, 4)) >= 0 {
        want = (if rt.mem_load(p, D_RWAIT, 8) != 0 { POLLRDNORM } else { 0 }) | (if rt.mem_load(p, D_WWAIT, 8) != 0 { POLLWRNORM } else { 0 })
      }
      if want != 0 {
        let f = addw(fds, nf * 16)
        rt.mem_store(f, 0, s32(rt.mem_load(p, D_FD, 4)), 8)
        rt.mem_store(f, 8, want, 2)
        rt.mem_store(f, 10, 0, 2)
        rt.mem_store(who, nf * 8, p, 8)
        nf = addw(nf, 1)
      }
      unlk(addw(p, D_MU))
      i = addw(i, 1)
    }
    unlk(mu)
    let got = s32(Int(sys_windows.WSAPoll(fds, nf, ms)))
    stat(ST_POLL_RETURN)
    var k = 1
    while got > 0 && k < nf {
      let r = rt.mem_load(fds, addw(k * 16, 10), 2)
      if r != 0 {
        let mode = (if (r & (POLLRDNORM | POLL_ERRS)) != 0 { 1 } else { 0 }) | (if (r & (POLLWRNORM | POLL_ERRS)) != 0 { 2 } else { 0 })
        pd_ready(rt.mem_load(who, k * 8, 8), mode)
      }
      k = addw(k, 1)
    }
    if got > 0 && rt.mem_load(fds, 10, 2) != 0 {
      while Int(sys_windows.recv(wr, drain, 64, 0)) > 0 {
      }
    }
    var sg = rt.slot_swap(addw(e, EV_SIGS), 0, 0, ACQ_REL)
    while sg > 0 {
      stop.signal()
      sg = subw(sg, 1)
    }
    deliver_pending(e)
  }
}
