// The event loop's poller in Xo (the zero-C audit's work item B22,
// decision 0069's design): the timer heap, the readiness of the
// descriptors, and the poller thread's loop over kqueue (macOS) and epoll
// (Linux; Windows' loop stays C until stage 4). A timer is the C
// runtime's record (xo_rt.c struct xo_timer, its offsets asserted there):
// its deadline in monotonic ns and its place in the heap (-1 when not in
// it); the heap is an array of timer addresses ordered by deadline (a
// binary heap), from the C runtime's malloc (rt.heap_large). The C holds
// the event loop's mutex (ev.mu) around every call here. Nothing here
// allocates Xo values or faults.
use native/llrt/ctx
use native/llrt/pool
use native/llrt/sock
use native/llrt/sysio
use native/rt
use native/sys_darwin

/// A timer's words (xo_rt.c struct xo_timer).
const T_WHEN = 0
const T_IDX = 8

/// rt.static_word: the heap's array (the address after its prefix), its
/// length, and its capacity.
const W_HEAP = 40
const W_N = 41
const W_CAP = 42

fn addw(a: Int, b: Int) -> Int { rt.int_wrap(0, a, b) }

fn subw(a: Int, b: Int) -> Int { rt.int_wrap(1, a, b) }

fn at(i: Int) -> Int { rt.mem_load(rt.mem_load(rt.static_word(W_HEAP), 0, 8), rt.int_wrap(3, i, 3), 8) }

fn set(i: Int, t: Int) {
  rt.mem_store(rt.mem_load(rt.static_word(W_HEAP), 0, 8), rt.int_wrap(3, i, 3), t, 8)
  rt.mem_store(t, T_IDX, i, 8)
}

fn dl(t: Int) -> Int { rt.mem_load(t, T_WHEN, 8) }

fn up(i0: Int) {
  var i = i0
  let t = at(i)
  while i > 0 {
    let p = rt.int_wrap(4, subw(i, 1), 1)
    if dl(at(p)) <= dl(t) {
      break
    }
    set(i, at(p))
    i = p
  }
  set(i, t)
}

fn down(i0: Int) {
  var i = i0
  let t = at(i)
  let n = rt.mem_load(rt.static_word(W_N), 0, 8)
  while true {
    var c = addw(rt.int_wrap(3, i, 1), 1)
    if c >= n {
      break
    }
    if addw(c, 1) < n && dl(at(addw(c, 1))) < dl(at(c)) {
      c = addw(c, 1)
    }
    if dl(t) <= dl(at(c)) {
      break
    }
    set(i, at(c))
    i = c
  }
  set(i, t)
}

/// Adds timer t (its deadline set): 1 when it is the first to fire now
/// (the poller must wake to wait less), else 0.
pub fn timer_push(t: Int) -> Int {
  let wn = rt.static_word(W_N)
  let wc = rt.static_word(W_CAP)
  let n = rt.mem_load(wn, 0, 8)
  let cap = rt.mem_load(wc, 0, 8)
  if n == cap {
    let ncap = if cap == 0 { 64 } else { addw(cap, cap) }
    let old = rt.mem_load(rt.static_word(W_HEAP), 0, 8)
    let nh = if old == 0 { rt.heap_large(rt.int_wrap(3, ncap, 3)) } else { rt.heap_large_resize(subw(old, 8), rt.int_wrap(3, ncap, 3)) }
    rt.mem_store(rt.static_word(W_HEAP), 0, nh, 8)
    rt.mem_store(wc, 0, ncap, 8)
  }
  rt.mem_store(wn, 0, addw(n, 1), 8)
  set(n, t)
  up(n)
  if rt.mem_load(t, T_IDX, 8) == 0 { 1 } else { 0 }
}

/// Takes timer t (in the heap) out of it; its place becomes -1.
pub fn timer_remove(t: Int) {
  let wn = rt.static_word(W_N)
  let i = rt.mem_load(t, T_IDX, 8)
  let n = subw(rt.mem_load(wn, 0, 8), 1)
  rt.mem_store(wn, 0, n, 8)
  let last = at(n)
  rt.mem_store(t, T_IDX, -1, 8)
  if last != t {
    set(i, last)
    down(i)
    up(rt.mem_load(last, T_IDX, 8))
  }
}

/// The timer that fires first, or 0 when none is armed.
pub fn timer_first() -> Int {
  if rt.mem_load(rt.static_word(W_N), 0, 8) == 0 {
    return 0
  }
  at(0)
}

// ---------------------------------------------------------------------------
// Descriptors (xo_rt.c xo_pd, its offsets asserted there): a lock word,
// the socket (-1 once closed), whether close was called, the operations
// running, readiness that came while nobody waited (read, write), the
// parks waiting (read, write), and the link of the dead list.

const D_MU = 0
const D_RREADY = 20
const D_WREADY = 24
const D_RWAIT = 32
const D_WWAIT = 40
const D_NEXT = 48

/// A timer's park, C function, and fired flag (xo_rt.c struct xo_timer).
const T_PARK = 16
const T_FN = 24
const T_FIRED = 40

/// rt.static_word: the C's park_signal (called through rt.call_c2, which
/// keeps its ThreadSanitizer annotation), set by poll_main.
const W_SIGNAL = 43

/// rt.sched_rt's statistics (xo_rt.c st: poll_return, poll_event,
/// poll_wake).
const ST_POLL_RETURN = 15
const ST_POLL_EVENT = 16
const ST_POLL_WAKE = 17

// slot atomics' orders (rt.xo)
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2

fn stat(k: Int) {
  let _r = rt.sched_rt(0, k, 0)
}

/// Takes and releases the lock word at l (xo_rt.c lk and unlk).
fn lk(l: Int) {
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
}

fn unlk(l: Int) {
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

fn signal(p: Int) {
  let _r = rt.call_c2(rt.mem_load(rt.static_word(W_SIGNAL), 0, 8), p, 0)
}

/// Hands readiness mode (1 read, 2 write, 3 both) to the descriptor pd's
/// waiters, or keeps it for the next wait (xo_rt.c pd_ready).
pub fn pd_ready(pd: Int, mode: Int) {
  stat(ST_POLL_EVENT)
  lk(addw(pd, D_MU))
  if (mode & 1) != 0 {
    let w = rt.mem_load(pd, D_RWAIT, 8)
    if w != 0 {
      stat(ST_POLL_WAKE)
      signal(w)
      rt.mem_store(pd, D_RWAIT, 0, 8)
    } else {
      rt.mem_store(pd, D_RREADY, 1, 4)
    }
  }
  if (mode & 2) != 0 {
    let w = rt.mem_load(pd, D_WWAIT, 8)
    if w != 0 {
      stat(ST_POLL_WAKE)
      signal(w)
      rt.mem_store(pd, D_WWAIT, 0, 8)
    } else {
      rt.mem_store(pd, D_WREADY, 1, 4)
    }
  }
  unlk(addw(pd, D_MU))
}

// ---------------------------------------------------------------------------
// Waiting on a descriptor (xo_rt.c pd_new, pd_begin, pd_end, pd_close,
// pd_free, pd_wait_until on Linux and macOS; Windows keeps the C's until
// B22 stage 4). A descriptor's record is xo_rt.c struct xo_pd (D_ above,
// fd at 8, closed at 12, ops at 16, all under its lock word). The C's
// services record (set at start, poll_svc) holds the addresses of C
// functions called through rt.call_c2 and two of the event loop's words.

/// rt.static_word: the C's services record.
const W_SVC = 44

/// The services record's words: open (fd, write: a new registered
/// record, or 0), close (fd), shutdown (fd: unregistered and shut down),
/// canceled (c: whether the context is canceled and not shielded), wait
/// (c: park_wait_n(c, 1, 0)), timer_add (t), timer_del (t), signal (a
/// park), the address of ev.mu, of ev.dead, and the offset of a
/// context's park.
const S_OPEN = 0
const S_CLOSE = 8
const S_SHUT = 16
const S_CANCELED = 24
const S_WAIT = 32
const S_TADD = 40
const S_TDEL = 48
const S_SIGNAL = 56
const S_MU = 64
const S_DEAD = 72
const S_PARK = 80

const D_FD = 8
const D_CLOSED = 12
const D_OPS = 16

/// A timer record's size (xo_rt.c struct xo_timer, 48 bytes).
const T_SIZE = 64

/// Whether timer t fired (a C int the poller stores after a release
/// fence).
fn fired(t: Int) -> Bool {
  let f = rt.mem_load(t, T_FIRED, 4)
  rt.fence(ACQUIRE)
  f != 0
}

/// pd_wait's results (xo_rt.c PD_READY and the rest).
pub const READY = 0
pub const CANCELED = 1
pub const CLOSED = 2
pub const TIMEOUT = 3

/// Sets the C's services record (at start, before any descriptor).
pub fn poll_svc(rec: Int) { rt.mem_store(rt.static_word(W_SVC), 0, rec, 8) }

fn svc(k: Int, a: Int) -> Int {
  let rec = rt.mem_load(rt.static_word(W_SVC), 0, 8)
  rt.call_c2(rt.mem_load(rec, k, 8), a, 0)
}

fn svc_word(k: Int) -> Int { rt.mem_load(rt.mem_load(rt.static_word(W_SVC), 0, 8), k, 8) }

/// Registers descriptor fd with the poller (for reading, and writing when
/// write): its record, or 0 when the poller refuses it (a regular file).
/// Start the event loop if it is not running.
pub fn pd_new(fd: Int, write: Bool) -> Int { svc(S_OPEN, fd + (if write { 4294967296 } else { 0 })) }

/// Starts an operation on pd: false when it is closed.
pub fn pd_begin(pd: Int) -> Bool {
  lk(addw(pd, D_MU))
  let ok = rt.mem_load(pd, D_CLOSED, 4) == 0
  if ok {
    rt.mem_store(pd, D_OPS, rt.mem_load(pd, D_OPS, 4) + 1, 4)
  }
  unlk(addw(pd, D_MU))
  ok
}

/// The descriptor's fd now, unless taken to close it (-1).
fn take_fd(pd: Int) -> Int {
  let fd = rt.mem_load(pd, D_FD, 4)
  let f = if fd >= 2147483648 { fd - 4294967296 } else { fd }
  if f >= 0 {
    rt.mem_store(pd, D_FD, 4294967295, 4)
  }
  f
}

/// Ends an operation on pd: the last one after a close closes the fd.
pub fn pd_end(pd: Int) {
  lk(addw(pd, D_MU))
  let ops = rt.mem_load(pd, D_OPS, 4) - 1
  rt.mem_store(pd, D_OPS, ops, 4)
  var fd = -1
  if ops == 0 && rt.mem_load(pd, D_CLOSED, 4) != 0 {
    fd = take_fd(pd)
  }
  unlk(addw(pd, D_MU))
  if fd >= 0 {
    let _r = svc(S_CLOSE, fd)
  }
}

fn wake(pd: Int, k: Int) {
  let w = rt.mem_load(pd, k, 8)
  if w != 0 {
    signal(w)
    rt.mem_store(pd, k, 0, 8)
  }
}

/// Closes pd: its waiters return CLOSED, and the fd closes once no
/// operation runs.
pub fn pd_close(pd: Int) {
  lk(addw(pd, D_MU))
  if rt.mem_load(pd, D_CLOSED, 4) == 0 {
    rt.mem_store(pd, D_CLOSED, 1, 4)
    let fd = rt.mem_load(pd, D_FD, 4)
    if fd < 2147483648 {
      let _r = svc(S_SHUT, fd)
    }
    wake(pd, D_RWAIT)
    wake(pd, D_WWAIT)
  }
  var fd = -1
  if rt.mem_load(pd, D_OPS, 4) == 0 {
    fd = take_fd(pd)
  }
  unlk(addw(pd, D_MU))
  if fd >= 0 {
    let _r = svc(S_CLOSE, fd)
  }
}

/// Closes pd and hands its record to the poller thread to free.
pub fn pd_free(pd: Int) {
  if pd == 0 {
    return
  }
  pd_close(pd)
  let mu = svc_word(S_MU)
  let dead = svc_word(S_DEAD)
  lk(mu)
  rt.mem_store(pd, D_NEXT, rt.mem_load(dead, 0, 8), 8)
  rt.mem_store(dead, 0, pd, 8)
  unlk(mu)
}

/// Waits in the current task until pd is ready for reading (or writing),
/// the task is canceled, pd is closed, or (when deadline is not 0) the
/// monotonic time deadline (ns, rt.clock_now's clock) passes: READY,
/// CANCELED, CLOSED, or TIMEOUT.
pub fn pd_wait(pd: Int, write: Bool, deadline: Int) -> Int { pd_wait_ctx(pd, write, ctx.cur(), deadline) }

/// pd_wait for context c (xo_rt.c pd_wait_until).
pub fn pd_wait_ctx(pd: Int, write: Bool, c: Int, deadline: Int) -> Int {
  let slot = if write { D_WWAIT } else { D_RWAIT }
  let ready = if write { D_WREADY } else { D_RREADY }
  let park = addw(c, svc_word(S_PARK))
  var t = 0
  var res = READY
  while true {
    if svc(S_CANCELED, c) != 0 {
      res = CANCELED
      break
    }
    lk(addw(pd, D_MU))
    if rt.mem_load(pd, D_CLOSED, 4) != 0 {
      unlk(addw(pd, D_MU))
      res = CLOSED
      break
    }
    if rt.mem_load(pd, ready, 4) != 0 {
      rt.mem_store(pd, ready, 0, 4)
      unlk(addw(pd, D_MU))
      res = READY
      break
    }
    pool.park_reset(park)
    rt.mem_store(pd, slot, park, 8)
    unlk(addw(pd, D_MU))
    if deadline != 0 && t == 0 {
      t = rt.heap_large(T_SIZE)
      rt.mem_set(t, 0, T_SIZE)
      rt.mem_store(t, T_WHEN, deadline, 8)
      rt.mem_store(t, T_IDX, -1, 8)
      rt.mem_store(t, T_PARK, park, 8)
      let _r = svc(S_TADD, t)
    }
    if !(t != 0 && fired(t)) {
      let _r = svc(S_WAIT, c)
    }
    lk(addw(pd, D_MU))
    let mine = rt.mem_load(pd, slot, 8) == park
    if mine {
      rt.mem_store(pd, slot, 0, 8)
    }
    let closed = rt.mem_load(pd, D_CLOSED, 4) != 0
    unlk(addw(pd, D_MU))
    if closed {
      res = CLOSED
      break
    }
    if !mine {
      // the poller handed it readiness
      res = READY
      break
    }
    if t != 0 && fired(t) {
      res = TIMEOUT
      break
    }
  }
  if t != 0 {
    let _r = svc(S_TDEL, t)
    rt.heap_release(t - 8)
  }
  res
}

/// Whether the current task is canceled (and not shielded).
pub fn canceled() -> Bool { svc(S_CANCELED, ctx.cur()) != 0 }

/// A timer that signals the park p at deadline (ns, the timers' clock:
/// the virtual one in the test world, else rt.clock_now's monotonic
/// one), added to the heap; end it with timer_end.
pub fn timer_park(deadline: Int, p: Int) -> Int {
  let t = rt.heap_large(T_SIZE)
  rt.mem_set(t, 0, T_SIZE)
  rt.mem_store(t, T_WHEN, deadline, 8)
  rt.mem_store(t, T_IDX, -1, 8)
  rt.mem_store(t, T_PARK, p, 8)
  let _a = svc(S_TADD, t)
  t
}

/// Whether timer t (of timer_park) fired.
pub fn timer_fired(t: Int) -> Bool { fired(t) }

/// Takes timer t (of timer_park) out of the heap and frees it.
pub fn timer_end(t: Int) {
  let _d = svc(S_TDEL, t)
  rt.heap_release(t - 8)
}

/// The park of context c.
pub fn park_of(c: Int) -> Int { addw(c, svc_word(S_PARK)) }

/// Waits in the current task until the monotonic time deadline (ns,
/// rt.clock_now's clock) passes or the task is canceled: TIMEOUT or
/// CANCELED (xo_rt.c clock_wait, for std/native/llrt/proc.xo's wait for
/// a child's exit).
pub fn sleep_until(deadline: Int) -> Int {
  let c = ctx.cur()
  let park = park_of(c)
  pool.park_reset(park)
  let t = timer_park(deadline, park)
  var res = TIMEOUT
  while true {
    if svc(S_CANCELED, c) != 0 {
      res = CANCELED
      break
    }
    if fired(t) {
      break
    }
    let _w = svc(S_WAIT, c)
  }
  timer_end(t)
  res
}

// ---------------------------------------------------------------------------
// The poller thread (xo_rt.c poller_main)

/// The events one wait collects.
const NEVENTS = 64

/// The poller thread's loop, which never returns: poll is the kqueue or
/// epoll descriptor, pipe_r the self pipe's read end, mu the event loop's
/// lock word (ev.mu), dead the address of the list of descriptors to
/// free, sigs the address of the count of signals not handled yet (a C
/// int), and signal_fn, stop_fn, free_fn the C's park_signal, stop_signal,
/// and free of a descriptor (called through rt.call_c2).
pub fn poll_main(poll: Int, pipe_r: Int, mu: Int, dead: Int, sigs: Int, signal_fn: Int, stop_fn: Int, free_fn: Int) {
  rt.mem_store(rt.static_word(W_SIGNAL), 0, signal_fn, 8)
  // the events (struct kevent of 32 bytes, struct epoll_event of 16 or
  // 12), a struct timespec, and the pipe's drain buffer
  let evs = rt.heap_large(addw(rt.int_wrap(2, NEVENTS, 32), 16 + 64))
  let ts = addw(evs, rt.int_wrap(2, NEVENTS, 32))
  let drain = addw(ts, 16)
  while true {
    lk(mu)
    var pd = rt.mem_load(dead, 0, 8)
    while pd != 0 {
      let next = rt.mem_load(pd, D_NEXT, 8)
      let _f = rt.call_c2(free_fn, pd, 0)
      pd = next
    }
    rt.mem_store(dead, 0, 0, 8)
    let now = sysio.mono_ns()
    var t = timer_first()
    while t != 0 && dl(t) <= now {
      timer_remove(t)
      rt.fence(RELEASE)
      rt.mem_store(t, T_FIRED, 1, 4)
      let p = rt.mem_load(t, T_PARK, 8)
      if p != 0 {
        signal(p)
      } else {
        let _c = rt.call_c2(rt.mem_load(t, T_FN, 8), t, 0)
      }
      t = timer_first()
    }
    let first = timer_first()
    let wait = if first == 0 { -1 } else { subw(dl(first), now) }
    unlk(mu)
    let n = wait_events(poll, evs, ts, wait)
    stat(ST_POLL_RETURN)
    var i = 0
    while i < n {
      let (p, mode) = event(evs, i)
      if p != 0 {
        pd_ready(p, mode)
      } else {
        // the self pipe: drain it, then the signals that wrote to it
        while read_fd(pipe_r, drain, 64) > 0 {}
        var k = rt.slot_swap(sigs, 0, 0, ACQ_REL)
        while k > 0 {
          let _s = rt.call_c2(stop_fn, 0, 0)
          k = subw(k, 1)
        }
      }
      i = addw(i, 1)
    }
  }
}

const ACQ_REL = 3

/// Waits for at most NEVENTS events into evs, at most wait ns (-1: no
/// limit): the count (0 on an error or a timeout).
fn wait_events(poll: Int, evs: Int, ts: Int, wait: Int) -> Int {
  match target.os {
    TargetOs.Darwin => {
      var tp = 0
      if wait >= 0 {
        rt.mem_store(ts, 0, wait / 1000000000, 8)
        rt.mem_store(ts, 8, wait % 1000000000, 8)
        tp = ts
      }
      let r = Int(sys_darwin.kevent(poll, 0, 0, evs, NEVENTS, tp))
      if r < 0 { 0 } else { r }
    }
    TargetOs.Linux => {
      var ms = -1
      if wait >= 0 {
        ms = if wait > 1099511627776 { 1073741824 } else { addw(wait, 999999) / 1000000 }
      }
      let r = sock.epoll_wait(poll, evs, NEVENTS, ms)
      if r < 0 { 0 } else { r }
    }
    TargetOs.Windows | TargetOs.Wasi => 0
  }
}

/// Event i of evs: its descriptor (0: the self pipe) and its readiness (1
/// read, 2 write, 3 both).
fn event(evs: Int, i: Int) -> (Int, Int) {
  match target.os {
    TargetOs.Darwin => {
      // struct kevent: filter (int16) at 8, flags (uint16) at 10, udata
      // at 24; EVFILT_READ -1, EVFILT_WRITE -2, EV_ERROR 0x4000
      let e = addw(evs, rt.int_wrap(3, i, 5))
      let f = rt.mem_load(e, 8, 2)
      var mode = if f == 65535 { 1 } else if f == 65534 { 2 } else { 0 }
      if (rt.mem_load(e, 10, 2) & 16384) != 0 {
        mode = 3
      }
      (rt.mem_load(e, 24, 8), mode)
    }
    TargetOs.Linux => {
      // struct epoll_event: events (uint32) at 0, data at 8 (arm64) or 4
      // (x86_64, packed); EPOLLIN 1, EPOLLOUT 4, EPOLLERR 8, EPOLLHUP 16,
      // EPOLLRDHUP 0x2000
      let size = match target.arch {
        TargetArch.Amd64 => 12
        TargetArch.Arm64 | TargetArch.Wasm32 => 16
      }
      let e = addw(evs, rt.int_wrap(2, i, size))
      let f = rt.mem_load(e, 0, 4)
      let data = rt.mem_load(e, subw(size, 8), 8)
      let r = if (f & (1 | 8192 | 16 | 8)) != 0 { 1 } else { 0 }
      let w = if (f & (4 | 16 | 8)) != 0 { 2 } else { 0 }
      (data, r | w)
    }
    TargetOs.Windows | TargetOs.Wasi => (0, 0)
  }
}

/// read(2) of at most n bytes into the address a.
fn read_fd(fd: Int, a: Int, n: Int) -> Int {
  match target.os {
    TargetOs.Darwin => sys_darwin.read(fd, a, n)
    TargetOs.Linux => sock.read(fd, a, n)
    TargetOs.Windows | TargetOs.Wasi => -1
  }
}
