// Origin: pgx github.com/jackc/pgx/v5 v5.11.0 (pgconn)
// std/sql's Postgres driver (decision 0278, spec/std.md 10.8 and 10.9):
// a sql.Driver over the protocol of pgwire.xo, dialing through the Net
// it is given. Connection flow, authentication, the simple and extended
// query protocols, text format results decoded by type OID, and SQLSTATE
// mapping follow github.com/jackc/pgx/v5 v5.11.0 pgconn (MIT;
// THIRD_PARTY_NOTICES). TLS through std/tls (decision 0281): SSLRequest,
// then tls.client with the sslmode's verification. Not yet: CancelRequest (a cancelled wait drops the
// connection), LISTEN/NOTIFY, binary COPY.
use std/sql
use std/tls
use native/llrt/pgwire
use native/llrt/rand

/// Type OIDs (pg_type.dat).
const OID_BOOL: Int = 16
const OID_BYTEA: Int = 17
const OID_NAME: Int = 19
const OID_INT8: Int = 20
const OID_INT2: Int = 21
const OID_INT4: Int = 23
const OID_TEXT: Int = 25
const OID_OID: Int = 26
const OID_JSON: Int = 114
const OID_FLOAT4: Int = 700
const OID_FLOAT8: Int = 701
const OID_BPCHAR: Int = 1042
const OID_VARCHAR: Int = 1043
const OID_TIMESTAMP: Int = 1114
const OID_TIMESTAMPTZ: Int = 1184
const OID_JSONB: Int = 3802

/// The element type of an array type OID, or -1.
fn elem_of(oid: Int) -> Int {
  match oid {
    1000 => OID_BOOL
    1001 => OID_BYTEA
    1003 => OID_NAME
    1005 => OID_INT2
    1007 => OID_INT4
    1016 => OID_INT8
    1009 => OID_TEXT
    1014 => OID_BPCHAR
    1015 => OID_VARCHAR
    1021 => OID_FLOAT4
    1022 => OID_FLOAT8
    1028 => OID_OID
    199 => OID_JSON
    3807 => OID_JSONB
    1115 => OID_TIMESTAMP
    1185 => OID_TIMESTAMPTZ
    _ => -1
  }
}

// ---------------------------------------------------------------------------
// Configuration

/// A connection's settings, from the connection string (pgconn Config).
struct Config {
  hosts: List[Str]
  ports: List[Int]
  user: Str
  password: Str
  database: Str
  sslmode: Str
  /// Startup parameters: application_name, search_path, options, and any
  /// other key pgconn passes as a runtime parameter.
  params: List[(Str, Str)]
}

/// Keys that name files or services: configuration must come from the
/// string and open's arguments (capabilities, decision 0278).
fn file_key(k: Str) -> Bool {
  k is "sslrootcert" | "sslcert" | "sslkey" | "passfile" | "service" | "servicefile" | "sslpassword" | "sslcrl"
}

/// Keys the driver reads itself (pgconn's notRuntimeParams, less what it
/// does not support).
fn config_key(k: Str) -> Bool {
  k is "host" | "port" | "user" | "password" | "database" | "sslmode" | "connect_timeout" | "target_session_attrs" | "sslnegotiation" | "sslsni" | "channel_binding" | "min_read_buffer_size"
}

fn param_err(msg: Str) -> sql.SqlErr { sql.SqlErr.Param(msg: msg) }

pub fn config(dsn: Str) -> Config ! sql.SqlErr {
  let s = pgwire.parse_dsn(dsn).map_err(fn(e) { param_err("cannot parse the connection string: ${e}") })?
  for k in s.keys() {
    if file_key(k) {
      return Err(param_err("${k}: pass certificates with open's roots argument and secrets in the connection string; no file is read"))
    }
  }
  let user = s.get("user").or_err(param_err("user is required: no environment is read"))?
  var hosts: List[Str] = []
  for h in (s.get("host") ?? "localhost").split(",") {
    hosts.push(if h.is_empty() { "localhost" } else { h })
  }
  var ports: List[Int] = []
  for p in (s.get("port") ?? "").split(",") {
    if p.is_empty() {
      ports.push(5432)
    } else {
      let n = Int.parse(p).or_err(param_err("invalid port: ${p.quote()}"))?
      if n < 1 || n > 65535 {
        return Err(param_err("invalid port: ${p.quote()}"))
      }
      ports.push(n)
    }
  }
  if ports.len() != 1 && ports.len() != hosts.len() {
    return Err(param_err("could not match ${ports.len()} port numbers to ${hosts.len()} hosts"))
  }
  let sslmode = s.get("sslmode") ?? "verify-full"
  if !(sslmode is "disable" | "allow" | "prefer" | "require" | "verify-ca" | "verify-full") {
    return Err(param_err("sslmode is invalid: ${sslmode.quote()}"))
  }
  var params: List[(Str, Str)] = []
  for (k, v) in s.entries() {
    if !config_key(k) {
      params.push((k, v))
    }
  }
  Config{hosts: hosts, ports: ports, user: user, password: s.get("password") ?? "", database: s.get("database") ?? user, sslmode: sslmode, params: params}
}

// ---------------------------------------------------------------------------
// The driver

pub struct PgDriver {
  /// PEM roots for verify-ca and verify-full (open's roots argument).
  pub roots: Bytes
}

/// A connection to the server: plain, or upgraded to TLS after
/// SSLRequest.
enum Link {
  Plain(c: Conn)
  Tls(t: tls.TlsConn)
}

fn (l: Link) read(max: Int) -> Bytes? ! NetErr uses net.dial {
  match l {
    Plain(c) => c.read(max)
    Tls(t) => t.read(max)
  }
}

fn (l: Link) write(data: Bytes) -> () ! NetErr uses net.dial {
  match l {
    Plain(c) => c.write(data)
    Tls(t) => t.write(data)
  }
}

fn (l: Link) close() {
  match l {
    Plain(c) => c.close()
    Tls(t) => t.close()
  }
}

pub struct PgConn {
  c: Link
  /// Bytes read and not yet decoded.
  buf: Mutex[Bytes]
  broken: Atomic[Bool]
  /// BackendKeyData, for a CancelRequest.
  pid: Atomic[Int]
}

fn conn_err(msg: Str) -> sql.SqlErr { sql.SqlErr.Conn(msg: msg) }

fn (d: PgDriver) connect(net: Net, dsn: Str) -> sql.DriverConn ! sql.SqlErr uses net.dial {
  let cfg = config(dsn)?
  var last = conn_err("no host to connect to")
  for (i, h) in cfg.hosts.indexed() {
    let port = if cfg.ports.len() == 1 { cfg.ports[0] } else { cfg.ports[i] }
    match connect_one(net, cfg, d.roots, h, port) {
      Ok(c) => return Ok(c)
      Err(Canceled) => return Err(sql.SqlErr.Canceled)
      // an authentication or server error is final, as pgconn's
      Err(Server(code, msg)) => return Err(sql.SqlErr.Server(code: code, msg: msg))
      Err(e) => last = e
    }
  }
  Err(last)
}

fn net_err(e: NetErr) -> sql.SqlErr {
  match e {
    Canceled => sql.SqlErr.Canceled
    _ => conn_err("${e}")
  }
}

fn connect_one(net: Net, cfg: Config, roots: Bytes, host: Str, port: Int) -> PgConn ! sql.SqlErr uses net.dial {
  // a Unix socket never uses TLS (pgconn configTLS gives none for one)
  let unix = host.starts_with("/")
  let addr = if unix { "unix:${host}/.s.PGSQL.${port}" } else if host.contains(":") { "[${host}]:${port}" } else { "${host}:${port}" }
  let mode = if unix { "disable" } else { cfg.sslmode }
  if mode == "allow" {
    // pgconn's order for allow: plain first, then TLS without checks
    return match connect_link(net, cfg, roots, host, addr, "disable") {
      Ok(p) => Ok(p)
      Err(Server(code, msg)) => connect_link(net, cfg, roots, host, addr, "require").map_err(fn(_) { sql.SqlErr.Server(code: code, msg: msg) })
      Err(e) => Err(e)
    }
  }
  connect_link(net, cfg, roots, host, addr, mode)
}

/// Dials addr, upgrades to TLS as mode says (SSLRequest, then std/tls's
/// client: decision 0281), and runs the startup handshake.
fn connect_link(net: Net, cfg: Config, roots: Bytes, host: Str, addr: Str, mode: Str) -> PgConn ! sql.SqlErr uses net.dial {
  let c = net.dial(addr).map_err(fn(e) {
    match e {
      // the text std.md 10.9 gives for an attenuated Net
      Denied(_) => conn_err("dial ${addr}: denied by Net.only")
      _ => net_err(e)
    }
  })?
  var link = Link.Plain(c: c)
  if mode != "disable" {
    match c.write(pgwire.ssl_request()) {
      Ok(_) => ()
      Err(e) => {
        c.close()
        return Err(net_err(e))
      }
    }
    let answer = match c.read(1) {
      Ok(Some(b)) => b
      Ok(None) => b""
      Err(e) => {
        c.close()
        return Err(net_err(e))
      }
    }
    if answer == b"S" {
      // libpq's rule, which pgx follows: require with root certificates
      // given checks the chain, as verify-ca
      let verify = match mode {
        "verify-full" => tls.Verify.Full
        "verify-ca" => tls.Verify.ChainOnly
        "require" => if roots.is_empty() { tls.Verify.None } else { tls.Verify.ChainOnly }
        _ => tls.Verify.None
      }
      var rs: tls.Roots? = None
      if !roots.is_empty() {
        match tls.roots(roots) {
          Ok(r) => rs = Some(r)
          Err(e) => {
            c.close()
            return Err(sql.SqlErr.Param(msg: "roots: ${e}"))
          }
        }
      }
      let t = tls.client(c, host, roots: rs, verify: verify).map_err(net_err)?
      link = Link.Tls(t: t)
    } else if answer == b"N" {
      if mode != "prefer" {
        c.close()
        return Err(conn_err("server refused TLS connection"))
      }
    } else {
      c.close()
      return Err(conn_err("server responded to SSLRequest with ${answer.quote()}"))
    }
  }
  let p = PgConn{c: link, buf: Mutex.new(b""), broken: Atomic.new(false), pid: Atomic.new(0)}
  match handshake(p, cfg) {
    Ok(_) => p
    Err(e) => {
      p.c.close()
      Err(e)
    }
  }
}

fn (p: PgConn) send(data: Bytes) -> () ! sql.SqlErr uses net.dial {
  match p.c.write(data) {
    Ok(_) => Ok(())
    Err(e) => {
      p.broken.set(true)
      Err(net_err(e))
    }
  }
}

/// The next backend message; a failure breaks the connection.
fn (p: PgConn) recv() -> pgwire.Backend ! sql.SqlErr uses net.dial {
  while {
    let have = p.buf.with(fn(b) { b })
    match pgwire.frame_len(have) {
      Ok(Some(n)) => {
        p.buf.with(fn(var b) { b = b[n..] })
        return pgwire.decode(have[0..n]).map_err(fn(e) {
          p.broken.set(true)
          conn_err("${e}")
        })
      }
      Ok(None) => {}
      Err(e) => {
        p.broken.set(true)
        return Err(conn_err("${e}"))
      }
    }
    match p.c.read(65536) {
      Ok(Some(more)) => p.buf.with(fn(var b) { b = b + more })
      Ok(None) => {
        p.broken.set(true)
        return Err(conn_err("unexpected EOF"))
      }
      Err(e) => {
        p.broken.set(true)
        return Err(net_err(e))
      }
    }
  }
  fault("unreachable")
}

/// The nonce of a SCRAM exchange: 18 random bytes as base64, as pgconn's
/// clientNonceLen (the runtime's generator, seeded in tests; no Rand
/// capability is passed to a driver).
fn nonce() -> Str { rand.next_bytes(18).to_base64() }

fn handshake(p: PgConn, cfg: Config) -> () ! sql.SqlErr uses net.dial {
  var params = [("user", cfg.user), ("database", cfg.database), ("client_encoding", "UTF8"), ("TimeZone", "UTC"), ("DateStyle", "ISO")]
  for kv in cfg.params {
    params.push(kv)
  }
  p.send(pgwire.startup(params))?
  var scram: pgwire.Scram? = None
  while {
    match p.recv()? {
      AuthOk => {}
      AuthCleartext => p.send(pgwire.password(cfg.password))?
      AuthMd5(salt) => p.send(pgwire.password(pgwire.md5_password(cfg.user, cfg.password, salt)))?
      AuthSasl(mechs) => {
        if !mechs.contains("SCRAM-SHA-256") {
          return Err(conn_err("server offers no supported SASL mechanism (${mechs.join(", ")})"))
        }
        let (s, first) = pgwire.start("", cfg.password, nonce())
        scram = Some(s)
        p.send(pgwire.sasl_initial("SCRAM-SHA-256", first.bytes()))?
      }
      AuthSaslContinue(data) => {
        var s = scram.or_err(conn_err("unexpected SASL continue"))?
        let fin = s.answer(data.to_str() ?? "").map_err(fn(e) { conn_err("${e}") })?
        scram = Some(s)
        p.send(pgwire.sasl_response(fin.bytes()))?
      }
      AuthSaslFinal(data) => {
        let s = scram.or_err(conn_err("unexpected SASL final"))?
        s.finish(data.to_str() ?? "").map_err(fn(e) { conn_err("${e}") })?
      }
      AuthOther(code) => return Err(conn_err("unsupported authentication method ${code}"))
      KeyData(pid, _) => p.pid.set(pid)
      Error(f) => return Err(server_err(f))
      Ready(_) => return Ok(())
      _ => {}
    }
  }
  Ok(())
}

// ---------------------------------------------------------------------------
// Errors (pgconn PgError, mapped to SqlErr)

fn server_err(f: Map[Str, Str]) -> sql.SqlErr {
  let code = f.get("C") ?? ""
  var msg = f.get("M") ?? ""
  if let Some(d) = f.get("D") {
    msg = msg + "\n" + d
  }
  if code.starts_with("23") {
    return sql.SqlErr.Constraint(msg: msg, code: code, name: f.get("n") ?? "")
  }
  if code == "42601" {
    return sql.SqlErr.Syntax(msg: msg)
  }
  if code == "42P01" {
    // relation "x" does not exist
    let parts = (f.get("M") ?? "").split("\"")
    return sql.SqlErr.NoTable(name: if parts.len() >= 3 { parts[1] } else { msg })
  }
  if code == "08P01" {
    // bind message supplies 1 parameters, but prepared statement "" requires 2
    let m = f.get("M") ?? ""
    if m.starts_with("bind message supplies ") {
      let w = m.split(" ")
      if w.len() >= 9 {
        return sql.SqlErr.Param(msg: "statement has ${w[w.len() - 1]} placeholders but ${w[3]} arguments were given")
      }
    }
    // a protocol violation is a server error; the connection is still there
    return sql.SqlErr.Server(code: code, msg: msg)
  }
  if code == "42P02" {
    // there is no parameter $1 (a statement with placeholders and no arguments)
    return sql.SqlErr.Param(msg: msg)
  }
  if code.starts_with("08") || code == "57P01" {
    return sql.SqlErr.Conn(msg: msg)
  }
  if code == "57014" {
    return sql.SqlErr.Canceled
  }
  sql.SqlErr.Server(code: code, msg: msg)
}

// ---------------------------------------------------------------------------
// Values

/// A Float as Postgres reads it: NaN, Infinity, -Infinity, else its text.
fn float_text(f: Float) -> Str {
  let t = "${f}"
  match t {
    "+Inf" => "Infinity"
    "-Inf" => "-Infinity"
    _ => t
  }
}

/// An array element in an array literal: quoted unless a number or bool.
fn array_elem(v: sql.SqlValue) -> Str {
  match v {
    Null => "NULL"
    Integer(n) => "${n}"
    Real(f) => float_text(f)
    Flag(b) => if b { "t" } else { "f" }
    _ => {
      let t = text_param(v) ?? ""
      "\"" + t.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
    }
  }
}

/// A parameter's text (None: NULL).
fn text_param(v: sql.SqlValue) -> Str? {
  match v {
    Null => None
    Integer(n) => Some("${n}")
    Text(s) => Some(s)
    Real(f) => Some(float_text(f))
    Flag(b) => Some(if b { "true" } else { "false" })
    At(t) => Some(t.format_rfc3339())
    Blob(b) => Some("\\x" + b.to_hex())
    JsonText(s) => Some(s)
    Array(xs) => Some("{" + xs.map(array_elem).join(",") + "}")
  }
}

fn param_of(v: sql.SqlValue) -> pgwire.Param {
  match v {
    // bytea is sent in binary format: its bytes as they are
    Blob(b) => pgwire.Param{format: 1, data: Some(b)}
    _ => pgwire.Param{format: 0, data: text_param(v).map(fn(s) { s.bytes() })}
  }
}

/// A timestamp's text in ISO DateStyle ("2026-10-20 15:04:05.123456+00",
/// TimeZone UTC) as RFC 3339; utc adds Z to a timestamp without a zone.
fn iso_to_rfc3339(s: Str, utc: Bool) -> Str {
  var t = s.replace(" ", "T")
  if utc {
    return t + "Z"
  }
  // the offset: +HH, +HH:MM, or +HH:MM:SS after the time
  let b = t.bytes()
  var i = b.len() - 1
  while i > 10 && b[i] != 43 && b[i] != 45 {
    i -= 1
  }
  if i <= 10 {
    return t
  }
  let off = t[i..]
  let body = t[0..i]
  if off.len() == 3 {
    return body + off + ":00"
  }
  body + off
}

fn decode_text(oid: Int, s: Str) -> sql.SqlValue {
  match oid {
    16 => return sql.SqlValue.Flag(b: s == "t")
    20 => return int_or_text(s)
    21 => return int_or_text(s)
    23 => return int_or_text(s)
    26 => return int_or_text(s)
    700 => return float_or_text(s)
    701 => return float_or_text(s)
    17 => {
      if s.starts_with("\\x") {
        if let Some(b) = Bytes.from_hex(s[2..]) {
          return sql.SqlValue.Blob(b: b)
        }
      }
      return sql.SqlValue.Text(s: s)
    }
    114 => return sql.SqlValue.JsonText(s: s)
    3802 => return sql.SqlValue.JsonText(s: s)
    1184 => return time_or_text(s, false)
    1114 => return time_or_text(s, true)
    _ => {}
  }
  let e = elem_of(oid)
  if e >= 0 {
    if let Some(items) = parse_array(s, e) {
      return sql.SqlValue.Array(items: items)
    }
  }
  sql.SqlValue.Text(s: s)
}

fn int_or_text(s: Str) -> sql.SqlValue {
  match Int.parse(s) {
    Some(n) => sql.SqlValue.Integer(n: n)
    None => sql.SqlValue.Text(s: s)
  }
}

fn float_or_text(s: Str) -> sql.SqlValue {
  match Float.parse(s) {
    Some(f) => sql.SqlValue.Real(f: f)
    None => sql.SqlValue.Text(s: s)
  }
}

fn time_or_text(s: Str, utc: Bool) -> sql.SqlValue {
  match Time.parse_rfc3339(iso_to_rfc3339(s, utc)) {
    Some(t) => sql.SqlValue.At(t: t)
    // infinity, -infinity, years past Time's range
    None => sql.SqlValue.Text(s: s)
  }
}

/// A one dimensional array literal's elements ({1,2,NULL}, {"a b",c}),
/// each decoded as elem; None for another shape (several dimensions,
/// bounds), which then reads as Text.
fn parse_array(s: Str, elem: Int) -> List[sql.SqlValue]? {
  let b = s.bytes()
  if b.len() < 2 || b[0] != 123 || b[b.len() - 1] != 125 {
    return None
  }
  var out: List[sql.SqlValue] = []
  if b.len() == 2 {
    return Some(out)
  }
  var i = 1
  while i < b.len() - 1 {
    if b[i] == 123 {
      return None
    }
    var cur = BytesBuilder.new()
    var quoted = false
    if b[i] == 34 {
      quoted = true
      i += 1
      while i < b.len() - 1 && b[i] != 34 {
        if b[i] == 92 && i + 1 < b.len() {
          i += 1
        }
        cur.write_byte(b[i])
        i += 1
      }
      i += 1
    } else {
      while i < b.len() - 1 && b[i] != 44 {
        cur.write_byte(b[i])
        i += 1
      }
    }
    let t = cur.freeze().to_str() ?? ""
    out.push(if !quoted && t == "NULL" { sql.SqlValue.Null } else { decode_text(elem, t) })
    if i < b.len() - 1 && b[i] == 44 {
      i += 1
    }
  }
  Some(out)
}

// ---------------------------------------------------------------------------
// Queries

/// One statement's results, read to ReadyForQuery: the last row set's
/// columns and rows, the last command tag, and the first error.
struct Results {
  cols: List[Str]
  oids: List[Int]
  rows: List[List[sql.SqlValue]]
  tag: Str
  types: List[sql.ColumnType] = []
}

fn (p: PgConn) collect() -> Results ! sql.SqlErr uses net.dial {
  var res = Results{cols: [], oids: [], rows: [], tag: ""}
  var failed: sql.SqlErr? = None
  while {
    match p.recv()? {
      RowDesc(fs) => {
        res.cols = fs.map(fn(f) { f.name })
        res.oids = fs.map(fn(f) { f.type_oid })
        res.types = column_types(fs)
        res.rows = []
      }
      DataRow(vals) => {
        res.rows.push(decode_row(res.oids, vals))
      }
      CommandComplete(tag) => res.tag = tag
      Error(f) => {
        if failed.is_none() {
          failed = Some(server_err(f))
        }
      }
      Ready(_) => {
        if let Some(e) = failed {
          return Err(e)
        }
        return res
      }
      _ => {}
    }
  }
  res
}

fn (p: PgConn) run(q: Str, args: List[sql.SqlValue]) -> Results ! sql.SqlErr uses net.dial {
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  if args.is_empty() {
    // the simple query protocol: a ; separated script runs as one
    p.send(pgwire.query(q))?
  } else {
    let params = args.map(param_of)
    p.send(pgwire.parse("", q, []) + pgwire.bind("", "", params, [0]) + pgwire.describe("P", "") + pgwire.execute("", 0) + pgwire.sync())?
  }
  p.collect()
}

/// A row's values decoded by the column type oids.
fn decode_row(oids: List[Int], vals: List[Bytes?]) -> List[sql.SqlValue] {
  var row: List[sql.SqlValue] = List.with_capacity(vals.len())
  for (i, v) in vals.indexed() {
    let oid = if i < oids.len() { oids[i] } else { OID_TEXT }
    row.push(match v {
      Some(b) => decode_text(oid, b.to_str() ?? "")
      None => sql.SqlValue.Null
    })
  }
  row
}

/// The rest of one statement's result on the connection (decision 0479):
/// DataRows read off the socket as next asks, to ReadyForQuery.
pub struct PgCursor {
  p: PgConn
  oids: List[Int]
  st: Mutex[CursorState]
}

struct CursorState {
  done: Bool
  failed: sql.SqlErr? = None
}

/// The next row, None at ReadyForQuery (or the statement's error there).
fn (c: PgCursor) next() -> List[sql.SqlValue]? ! sql.SqlErr uses net.dial {
  if c.st.with(fn(s) { s.done }) {
    return None
  }
  while {
    match c.p.recv() {
      Ok(m) => {
        match m {
          DataRow(vals) => return Some(decode_row(c.oids, vals))
          Error(f) => c.note_failure(server_err(f))
          Ready(_) => {
            if let Some(e) = c.finish() {
              return Err(e)
            }
            return None
          }
          _ => {}
        }
      }
      Err(e) => {
        let _ = c.finish()
        return Err(e)
      }
    }
  }
  None
}

/// Marks the statement failed (the first error is kept).
fn (c: PgCursor) note_failure(e: sql.SqlErr) {
  c.st.with(fn(var s) {
    if s.failed.is_none() {
      s.failed = Some(e)
    }
  })
}

/// Marks the cursor done; the statement's error, if any.
fn (c: PgCursor) finish() -> sql.SqlErr? {
  c.st.with(fn(var s) -> sql.SqlErr? {
    s.done = true
    s.failed
  })
}

fn (c: PgCursor) rest() -> List[List[sql.SqlValue]] ! sql.SqlErr uses net.dial {
  var out: List[List[sql.SqlValue]] = []
  while {
    match c.next()? {
      Some(r) => out.push(r)
      None => break
    }
  }
  out
}

/// Reads and discards the rest, so the connection is idle again.
fn (c: PgCursor) close() uses net.dial {
  while {
    match c.next() {
      Ok(o) => {
        if o.is_none() {
          break
        }
      }
      Err(_) => break
    }
  }
}

fn (p: PgConn) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows ! sql.SqlErr uses net.dial {
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  // a ; separated script runs through the simple protocol, whole
  if args.is_empty() && q.contains(";") {
    let r = p.run(q, args)?
    return sql.DriverRows{columns: r.cols, rows: r.rows, column_types: r.types}
  }
  if args.is_empty() {
    // the simple query protocol, as run does (and as a server that only speaks it expects)
    p.send(pgwire.query(q))?
  } else {
    p.send(pgwire.parse("", q, []) + pgwire.bind("", "", args.map(param_of), [0]) + pgwire.describe("P", "") + pgwire.execute("", 0) + pgwire.sync())?
  }
  var failed: sql.SqlErr? = None
  while {
    match p.recv()? {
      RowDesc(fs) => {
        let cur = PgCursor{p: p, oids: fs.map(fn(f) { f.type_oid }), st: Mutex.new(CursorState{done: false})}
        return sql.DriverRows{columns: fs.map(fn(f) { f.name }), rows: [], cursor: Some(cur), column_types: column_types(fs)}
      }
      Error(f) => {
        if failed.is_none() {
          failed = Some(server_err(f))
        }
      }
      Ready(_) => {
        if let Some(e) = failed {
          return Err(e)
        }
        return sql.DriverRows{columns: [], rows: []}
      }
      _ => {}
    }
  }
  sql.DriverRows{columns: [], rows: []}
}

/// A value as one COPY text field: \N for NULL, backslash, tab, newline and
/// carriage return escaped.
fn copy_field(v: sql.SqlValue, var o: BytesBuilder) {
  match text_param(v) {
    None => o.write_str("\\N")
    Some(s) => {
      for c in s.bytes() {
        if c == 92 {
          o.write_str("\\\\")
        } else if c == 9 {
          o.write_str("\\t")
        } else if c == 10 {
          o.write_str("\\n")
        } else if c == 13 {
          o.write_str("\\r")
        } else {
          o.write_byte(c)
        }
      }
    }
  }
}

/// What the reader task of copy_from has seen: the server's first error,
/// a connection failure, the rows affected.
struct CopyState {
  failed: sql.SqlErr?
  n: Int
  io: sql.SqlErr?
}

/// COPY table (columns) FROM STDIN in the text format (decision 0479): rows
/// is called until None, each row sent in CopyData messages of about 64
/// KiB; an error from rows sends CopyFail (the server rolls the COPY back)
/// and is returned; an error the server raises while the rows are sent
/// stops the calls to rows and is returned. The result is the rows copied.
fn (p: PgConn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr) -> Int ! sql.SqlErr uses net.dial {
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  let cols = columns.map(sql.quote_ident).join(", ")
  let head = if columns.is_empty() { sql.quote_ident(table) } else { "${sql.quote_ident(table)} (${cols})" }
  p.send(pgwire.query("COPY ${head} FROM STDIN"))?
  var failed: sql.SqlErr? = None
  var ready = false
  while !ready {
    match p.recv()? {
      Other(kind, _) => {
        if kind == "G" {
          break
        }
      }
      Error(f) => {
        if failed.is_none() {
          failed = Some(server_err(f))
        }
      }
      Ready(_) => ready = true
      _ => {}
    }
  }
  if ready {
    // no CopyInResponse: the statement failed (or was not a COPY)
    return Err(failed ?? conn_err("COPY FROM STDIN: no CopyInResponse"))
  }
  // the server's messages are read by a task while the rows are sent, as
  // pgx's CopyFrom does: an error the server raises mid COPY (a bad row, a
  // constraint) sets `refused` and the row source stops being called (the
  // server discards the data up to CopyDone or CopyFail, then answers)
  let st = Mutex.new(CopyState{failed: failed, n: 0, io: None})
  let refused = Atomic.new(false)
  var err: sql.SqlErr? = None
  var send_err: sql.SqlErr? = None
  scope s {
    let reader = s.spawn(fn() {
      while true {
        match p.recv() {
          Ok(m) => {
            match m {
              CommandComplete(tag) => st.with(fn(var c) { c.n = pgwire.rows_affected(tag) })
              Error(f) => {
                st.with(fn(var c) {
                  if c.failed.is_none() {
                    c.failed = Some(server_err(f))
                  }
                })
                refused.set(true)
              }
              Ready(_) => break
              _ => {}
            }
          }
          Err(e) => {
            st.with(fn(var c) { c.io = Some(e) })
            refused.set(true)
            break
          }
        }
      }
    })
    // 65,504: the 64 KiB class's 65,528 less the header, sent at 64,480 so
    // a row of up to 1 KiB more still fits (65,536 + 1,024 took the 128 KiB
    // class, decision 0506)
    var buf = BytesBuilder.with_capacity(65504)
    while err.is_none() && send_err.is_none() && !refused.get() {
      match rows() {
        Ok(o) => {
          match o {
            Some(r) => {
              for (i, v) in r.indexed() {
                if i > 0 {
                  buf.write_byte(9)
                }
                copy_field(v, buf)
              }
              buf.write_byte(10)
              if buf.len() >= 64480 {
                match p.send(pgwire.copy_data(buf.freeze())) {
                  Ok(_) => {}
                  Err(e) => send_err = Some(e)
                }
                buf = BytesBuilder.with_capacity(65504)
              }
            }
            None => break
          }
        }
        Err(e) => err = Some(e)
      }
    }
    if send_err.is_none() {
      if let Some(e) = err {
        match p.send(pgwire.copy_fail("${e}")) {
          Ok(_) => {}
          Err(x) => send_err = Some(x)
        }
      } else {
        if buf.len() > 0 && !refused.get() {
          match p.send(pgwire.copy_data(buf.freeze())) {
            Ok(_) => {}
            Err(x) => send_err = Some(x)
          }
        }
        if send_err.is_none() {
          match p.send(pgwire.copy_done()) {
            Ok(_) => {}
            Err(x) => send_err = Some(x)
          }
        }
      }
    }
    if send_err.is_some() {
      // the connection is unusable: the reader's recv fails and ends
      p.broken.set(true)
    }
    reader.await
  }
  let res = st.with(fn(c) { c })
  if let Some(e) = err {
    // a CopyFail comes back as the server's error: the caller's error wins
    return Err(e)
  }
  if let Some(e) = send_err {
    return Err(e)
  }
  if let Some(e) = res.io {
    return Err(e)
  }
  if let Some(e) = res.failed {
    return Err(e)
  }
  res.n
}

fn (p: PgConn) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  let r = p.run(q, args)?
  sql.ExecResult{rows_affected: pgwire.rows_affected(r.tag), last_insert_id: 0}
}

fn (p: PgConn) begin() -> () ! sql.SqlErr uses net.dial {
  let _ = p.run("BEGIN", [])?
}

fn (p: PgConn) commit() -> () ! sql.SqlErr uses net.dial {
  let r = p.run("COMMIT", [])?
  if r.tag == "ROLLBACK" {
    // pgconn's ErrTxCommitRollback: the transaction had failed
    return Err(sql.SqlErr.Server(code: "25P02", msg: "commit unexpectedly resulted in rollback"))
  }
}

fn (p: PgConn) rollback() -> () ! sql.SqlErr uses net.dial {
  let _ = p.run("ROLLBACK", [])?
}

fn (p: PgConn) ping() -> () ! sql.SqlErr uses net.dial {
  let _ = p.run("-- ping", [])?
}

fn (p: PgConn) close() uses net.dial {
  let _ = p.c.write(pgwire.terminate()).is_ok()
  p.c.close()
}

fn (p: PgConn) is_broken() -> Bool { p.broken.get() }

// ---------------------------------------------------------------------------
// Column types (decision 0609): pgx's stdlib Rows.ColumnType* (v5.12.0)

/// The type OIDs pgx's default type map names (pgtype_default.go), sorted;
/// PG_TYPE_NAMES holds each one's name, upper case as
/// ColumnTypeDatabaseTypeName gives it.
const PG_TYPE_OIDS: List[Int] = [
  16, 17, 18, 19, 20, 21, 23, 25, 26, 27, 28, 29, 114, 142, 143, 199, 271, 600, 601, 602, 603, 604,
  628, 629, 650, 651, 700, 701, 705, 718, 719, 774, 829, 869, 1000, 1001, 1002, 1003, 1005, 1007,
  1009, 1010, 1011, 1012, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1022, 1027, 1028, 1033,
  1034, 1040, 1041, 1042, 1043, 1082, 1083, 1114, 1115, 1182, 1183, 1184, 1185, 1186, 1187, 1231,
  1560, 1561, 1562, 1563, 1700, 2249, 2287, 2950, 2951, 3614, 3643, 3802, 3807, 3904, 3905, 3906,
  3907, 3908, 3909, 3910, 3911, 3912, 3913, 3926, 3927, 4072, 4073, 4451, 4532, 4533, 4534, 4535,
  4536, 5069, 6437, 6442,
]

const PG_TYPE_NAMES: List[Str] = [
  "BOOL", "BYTEA", "CHAR", "NAME", "INT8", "INT2", "INT4", "TEXT", "OID", "TID", "XID", "CID",
  "JSON", "XML", "_XML", "_JSON", "_XID8", "POINT", "LSEG", "PATH", "BOX", "POLYGON", "LINE",
  "_LINE", "CIDR", "_CIDR", "FLOAT4", "FLOAT8", "UNKNOWN", "CIRCLE", "_CIRCLE", "MACADDR8",
  "MACADDR", "INET", "_BOOL", "_BYTEA", "_CHAR", "_NAME", "_INT2", "_INT4", "_TEXT", "_TID",
  "_XID", "_CID", "_BPCHAR", "_VARCHAR", "_INT8", "_POINT", "_LSEG", "_PATH", "_BOX", "_FLOAT4",
  "_FLOAT8", "_POLYGON", "_OID", "ACLITEM", "_ACLITEM", "_MACADDR", "_INET", "BPCHAR", "VARCHAR",
  "DATE", "TIME", "TIMESTAMP", "_TIMESTAMP", "_DATE", "_TIME", "TIMESTAMPTZ", "_TIMESTAMPTZ",
  "INTERVAL", "_INTERVAL", "_NUMERIC", "BIT", "_BIT", "VARBIT", "_VARBIT", "NUMERIC", "RECORD",
  "_RECORD", "UUID", "_UUID", "TSVECTOR", "_TSVECTOR", "JSONB", "_JSONB", "INT4RANGE",
  "_INT4RANGE", "NUMRANGE", "_NUMRANGE", "TSRANGE", "_TSRANGE", "TSTZRANGE", "_TSTZRANGE",
  "DATERANGE", "_DATERANGE", "INT8RANGE", "_INT8RANGE", "JSONPATH", "_JSONPATH", "INT4MULTIRANGE",
  "NUMMULTIRANGE", "TSMULTIRANGE", "TSTZMULTIRANGE", "DATEMULTIRANGE", "INT8MULTIRANGE", "XID8",
  "OID8", "_OID8",
]

/// pgx's ColumnTypeDatabaseTypeName: the registered name, else the OID in
/// decimal.
fn pg_type_name(oid: Int) -> Str {
  var lo = 0
  var hi = PG_TYPE_OIDS.len()
  while lo < hi {
    let m = (lo + hi) / 2
    if PG_TYPE_OIDS[m] < oid {
      lo = m + 1
    } else {
      hi = m
    }
  }
  if lo < PG_TYPE_OIDS.len() && PG_TYPE_OIDS[lo] == oid { PG_TYPE_NAMES[lo] } else { "${oid}" }
}

/// Each field's ColumnType: pgx's name, length (text and bytea
/// unbounded as Int.max; varchar and bpchar the modifier less 4; varbit
/// the modifier), precision and scale of numeric, nullable unknown (pgx
/// does not report it), and the SqlValue variant decode_text gives.
pub fn column_types(fs: List[pgwire.Field]) -> List[sql.ColumnType] {
  fs.map(fn(f) {
    let oid = f.type_oid
    let length: Int? = match oid {
      25 | 17 => Some(Int.max)
      1043 | 1042 => Some(f.modifier - 4)
      1562 => Some(f.modifier)
      _ => None
    }
    var precision: Int? = None
    var scale: Int? = None
    if oid == 1700 {
      let m = f.modifier - 4
      precision = Some((m >> 16) & 0xFFFF)
      scale = Some(m & 0xFFFF)
    }
    let kind = match oid {
      16 => "Flag"
      20 | 21 | 23 | 26 => "Integer"
      700 | 701 => "Real"
      17 => "Blob"
      114 | 3802 => "JsonText"
      1184 | 1114 => "At"
      _ => if elem_of(oid) >= 0 { "Array" } else { "Text" }
    }
    sql.ColumnType{name: f.name, database_type: pg_type_name(oid), length: length, precision: precision, scale: scale, kind: kind}
  })
}
