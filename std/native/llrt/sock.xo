// The socket system calls of the native runtime, written in Xo (decision
// 0206 stage 3; macOS through libSystem, the zero-C audit's B23): on
// Linux raw system calls through rt.sys6, as
// std/native/llrt/linux.xo makes the file ones. The C runtime's network
// (std/llrt/xo_rt.c: listen, dial, accept, reads and writes, the
// poller's epoll) calls them through the exports of cabi_net.xo and
// cabi.xo when the Xo path is on (net.xo), and the resolver (dns.xo)
// makes its queries with them. Addresses are Ints: the C's buffers, or
// raw.bytes_addr of a Bytes kept alive past the call. A call returns
// what the kernel returns: a result >= 0, or a negative errno.
//
// Linux, macOS, and Windows reach this module (net.raw); a darwin call
// returns minus darwin's errno, and a Windows one minus the C runtime's
// errno for its Winsock error (wsa_errno, as xo_win.c's xo_wsa_map), so
// the C runtime's tests of its errno constants hold. The Windows arms
// (B23 stage 2) are UNTESTED on windows: written on macOS and checked by
// the windows/amd64 cross build only.
use native/llrt/obj
use native/llrt/raw
use native/rt
use native/sys_darwin
use native/sys_windows

// Address families and socket types (the same on arm64 and x86_64).
pub const AF_UNIX: Int = 1
pub const AF_INET: Int = 2
pub const AF_INET6: Int = 10
pub const SOCK_STREAM: Int = 1
pub const SOCK_DGRAM: Int = 2
pub const SOCK_NONBLOCK: Int = 2048
pub const SOCK_CLOEXEC: Int = 524288

// errno values the callers test
pub const EINTR: Int = 4
pub const EAGAIN: Int = 11
pub const EINPROGRESS: Int = 115
pub const ECONNREFUSED: Int = 111

/// AF_INET6 of the target OS (10 on Linux, 30 on macOS, 23 on Windows).
pub fn af_inet6() -> Int {
  match target.os {
    TargetOs.Darwin => 30
    TargetOs.Windows => 23
    TargetOs.Linux | TargetOs.Wasi => 10
  }
}

/// Whether the target is macOS (its calls go through libSystem).
fn darwin() -> Bool {
  match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
}

/// r of a libSystem call: r, or minus errno when r is -1.
fn dret(r: Int) -> Int {
  if r == -1 {
    return 0 - rt.mem_load(sys_darwin.__error(), 0, 4)
  }
  r
}

/// Whether the target is Windows (its calls go through ws2_32).
pub fn windows() -> Bool {
  match target.os {
    TargetOs.Windows => true
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi => false
  }
}

/// rt.static_word: whether WSAStartup ran (sock.xo's).
const W_WSA = 62

/// Starts Winsock once (WSAStartup is counted, so a second call from a
/// racing thread is harmless).
pub fn wsa_init() {
  if rt.slot_load(rt.static_word(W_WSA), 0, 1) == 0 {
    // WSADATA: 408 bytes on 64 bit Windows
    let d = raw.bytes_buf(512)
    let _r = keep(d, Int(sys_windows.WSAStartup(514, raw.bytes_addr(d))))
    rt.slot_store(rt.static_word(W_WSA), 0, 1, 2)
  }
}

/// Two connected loopback TCP sockets, both nonblocking (stdin.xo's
/// pump, the Windows poller's self pipe; was xo_win.c xo_w_socketpair):
/// (the accepted one, the connecting one), or (-1, -1).
pub fn loopback_pair() -> (Int, Int) {
  // AF_INET 2, SOCK_STREAM 1, IPPROTO_TCP 6
  let l = socket(2, 1, 6)
  if l < 0 {
    return (-1, -1)
  }
  // a sockaddr_in for 127.0.0.1, port 0 (the system picks): family 2,
  // the port, the address in network order
  let sa = obj.scratch()
  rt.mem_set(sa, 0, 16)
  rt.mem_store(sa, 0, 2, 2)
  rt.mem_store(sa, 4, 16777343, 4)
  let lenp = rt.int_wrap(0, sa, 16)
  rt.mem_store(lenp, 0, 16, 4)
  var c = -1
  var s = -1
  if bind(l, sa, 16) == 0 && listen(l, 1) == 0 && sockname(l, sa, lenp) == 0 {
    c = socket(2, 1, 6)
    if c >= 0 && connect(c, sa, 16) == 0 {
      s = accept(l, 0)
    }
  }
  let _l = close(l)
  if s < 0 {
    if c >= 0 {
      let _c = close(c)
    }
    return (-1, -1)
  }
  let _n = nonblock(s)
  let _m = nonblock(c)
  (s, c)
}

/// The C runtime's errno (the Windows CRT's numbers, asserted in
/// xo_win.c) for Winsock error code e (xo_win.c xo_wsa_map).
fn wsa_errno(e: Int) -> Int {
  match e {
    10035 => 140 // WSAEWOULDBLOCK: EWOULDBLOCK
    10036 | 10037 => 112 // WSAEINPROGRESS, WSAEALREADY: EINPROGRESS
    10061 => 107 // WSAECONNREFUSED: ECONNREFUSED
    10054 => 108 // WSAECONNRESET: ECONNRESET
    10053 => 106 // WSAECONNABORTED: ECONNABORTED
    10058 => 32 // WSAESHUTDOWN: EPIPE
    10060 => 138 // WSAETIMEDOUT: ETIMEDOUT
    10048 => 100 // WSAEADDRINUSE: EADDRINUSE
    10049 => 101 // WSAEADDRNOTAVAIL: EADDRNOTAVAIL
    10013 => 13 // WSAEACCES: EACCES
    10022 => 22 // WSAEINVAL: EINVAL
    10004 => 4 // WSAEINTR: EINTR
    10038 => 128 // WSAENOTSOCK: ENOTSOCK
    10051 => 118 // WSAENETUNREACH: ENETUNREACH
    10065 => 110 // WSAEHOSTUNREACH: EHOSTUNREACH
    10057 => 126 // WSAENOTCONN: ENOTCONN
    10047 => 102 // WSAEAFNOSUPPORT: EAFNOSUPPORT
    _ => 5 // EIO
  }
}

/// r of a Winsock call: r, or minus the errno of WSAGetLastError when r
/// is SOCKET_ERROR or INVALID_SOCKET (-1).
fn wret(r: Int) -> Int {
  if r == -1 {
    return 0 - wsa_errno(Int(sys_windows.WSAGetLastError()))
  }
  r
}

/// The system call number of the target's architecture: arm64 (the
/// asm-generic table) or x86_64.
fn nr(arm64: Int, amd64: Int) -> Int {
  match target.arch {
    TargetArch.Arm64 => arm64
    TargetArch.Amd64 => amd64
    TargetArch.Wasm32 => -1
  }
}

/// socket(2).
pub fn socket(family: Int, ty: Int, proto: Int) -> Int {
  if windows() {
    wsa_init()
    // Linux's SOCK_NONBLOCK and SOCK_CLOEXEC are not Winsock's: not
    // inherited (WSA_FLAG_NO_HANDLE_INHERIT 0x80), overlapped (0x01)
    return wret(sys_windows.WSASocketW(family, ty & 255, proto, 0, 0, 129))
  }
  if darwin() {
    return dret(Int(sys_darwin.socket(family, ty, proto)))
  }
  rt.sys6(nr(198, 41), family, ty, proto, 0, 0, 0)
}

/// bind(2) of the n bytes of sockaddr at sa.
pub fn bind(fd: Int, sa: Int, n: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.bind(fd, sa, n)))
  }
  if darwin() {
    return dret(Int(sys_darwin.bind(fd, sa, n)))
  }
  rt.sys6(nr(200, 49), fd, sa, n, 0, 0, 0)
}

/// listen(2).
pub fn listen(fd: Int, backlog: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.listen(fd, backlog)))
  }
  if darwin() {
    return dret(Int(sys_darwin.listen(fd, backlog)))
  }
  rt.sys6(nr(201, 50), fd, backlog, 0, 0, 0, 0)
}

/// accept4(2) with no peer address wanted.
pub fn accept(fd: Int, flags: Int) -> Int {
  if windows() {
    return wret(sys_windows.accept(fd, 0, 0))
  }
  if darwin() {
    return dret(Int(sys_darwin.accept(fd, 0, 0)))
  }
  rt.sys6(nr(242, 288), fd, 0, 0, flags, 0, 0)
}

/// connect(2) to the n bytes of sockaddr at sa.
pub fn connect(fd: Int, sa: Int, n: Int) -> Int {
  if windows() {
    // a nonblocking connect in progress is WSAEWOULDBLOCK
    let r = wret(Int(sys_windows.connect(fd, sa, n)))
    return if r == -140 { -112 } else { r }
  }
  if darwin() {
    return dret(Int(sys_darwin.connect(fd, sa, n)))
  }
  rt.sys6(nr(203, 42), fd, sa, n, 0, 0, 0)
}

/// getsockname(2) into the buffer at sa, whose size is the 32 bit word
/// at lenp (updated to the address's length).
pub fn sockname(fd: Int, sa: Int, lenp: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.getsockname(fd, sa, lenp)))
  }
  if darwin() {
    return dret(Int(sys_darwin.getsockname(fd, sa, lenp)))
  }
  rt.sys6(nr(204, 51), fd, sa, lenp, 0, 0, 0)
}

/// getpeername(2), as sockname.
pub fn peername(fd: Int, sa: Int, lenp: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.getpeername(fd, sa, lenp)))
  }
  if darwin() {
    return dret(Int(sys_darwin.getpeername(fd, sa, lenp)))
  }
  rt.sys6(nr(205, 52), fd, sa, lenp, 0, 0, 0)
}

/// sendto(2) of n bytes at p with flags, to the connected peer.
pub fn send(fd: Int, p: Int, n: Int, flags: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.send(fd, p, n, 0)))
  }
  if darwin() {
    return dret(sys_darwin.send(fd, p, n, 0))
  }
  rt.sys6(nr(206, 44), fd, p, n, flags, 0, 0)
}

/// recvfrom(2) of at most n bytes into p, from the connected peer.
pub fn recv(fd: Int, p: Int, n: Int, flags: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.recv(fd, p, n, flags)))
  }
  if darwin() {
    return dret(sys_darwin.recv(fd, p, n, flags))
  }
  rt.sys6(nr(207, 45), fd, p, n, flags, 0, 0)
}

/// read(2) of at most n bytes into p.
pub fn read(fd: Int, p: Int, n: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.recv(fd, p, n, 0)))
  }
  if darwin() {
    return dret(sys_darwin.read(fd, p, n))
  }
  rt.sys6(nr(63, 0), fd, p, n, 0, 0, 0)
}

/// setsockopt(2) of the n bytes at v.
pub fn setsockopt(fd: Int, level: Int, opt: Int, v: Int, n: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.setsockopt(fd, level, opt, v, n)))
  }
  if darwin() {
    return dret(Int(sys_darwin.setsockopt(fd, level, opt, v, n)))
  }
  rt.sys6(nr(208, 54), fd, level, opt, v, n, 0)
}

/// getsockopt(2) into the buffer at v, whose size is the 32 bit word at
/// lenp.
pub fn getsockopt(fd: Int, level: Int, opt: Int, v: Int, lenp: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.getsockopt(fd, level, opt, v, lenp)))
  }
  if darwin() {
    return dret(Int(sys_darwin.getsockopt(fd, level, opt, v, lenp)))
  }
  rt.sys6(nr(209, 55), fd, level, opt, v, lenp, 0)
}

/// shutdown(2).
pub fn shutdown(fd: Int, how: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.shutdown(fd, how)))
  }
  if darwin() {
    return dret(Int(sys_darwin.shutdown(fd, how)))
  }
  rt.sys6(nr(210, 48), fd, how, 0, 0, 0, 0)
}

/// close(2).
pub fn close(fd: Int) -> Int {
  if windows() {
    return wret(Int(sys_windows.closesocket(fd)))
  }
  if darwin() {
    return dret(Int(sys_darwin.close(fd)))
  }
  rt.sys6(nr(57, 3), fd, 0, 0, 0, 0, 0)
}

/// fcntl(2) with an integer argument.
pub fn fcntl(fd: Int, cmd: Int, arg: Int) -> Int {
  if windows() {
    return -22
  }
  if darwin() {
    return dret(Int(sys_darwin.fcntl(fd, cmd, arg)))
  }
  rt.sys6(nr(25, 72), fd, cmd, arg, 0, 0, 0)
}

/// ioctl(2) with an address argument.
pub fn ioctl(fd: Int, req: Int, arg: Int) -> Int { rt.sys6(nr(29, 16), fd, req, arg, 0, 0, 0) }

/// epoll_create1(2).
pub fn epoll_create(flags: Int) -> Int { rt.sys6(nr(20, 291), flags, 0, 0, 0, 0, 0) }

/// epoll_ctl(2) with the struct epoll_event at ev (the C's layout).
pub fn epoll_ctl(ep: Int, op: Int, fd: Int, ev: Int) -> Int { rt.sys6(nr(21, 233), ep, op, fd, ev, 0, 0) }

/// epoll_pwait(2) with no signal mask (epoll_wait, which arm64 lacks).
pub fn epoll_wait(ep: Int, evs: Int, n: Int, ms: Int) -> Int { rt.sys6(nr(22, 281), ep, evs, n, ms, 0, 8) }

/// ppoll(2) of the n struct pollfd at fds, with the timespec at ts (0:
/// no limit) and no signal mask.
pub fn ppoll(fds: Int, n: Int, ts: Int) -> Int { rt.sys6(nr(73, 271), fds, n, ts, 0, 8, 0) }

/// Sets O_NONBLOCK on fd and FD_CLOEXEC (the C runtime's set_nonblock):
/// 0, or the negative errno.
pub fn nonblock(fd: Int) -> Int {
  if windows() {
    // ioctlsocket FIONBIO (0x8004667E) with a u_long 1; sockets are
    // created not inherited
    let a = obj.scratch()
    rt.mem_store(a, 0, 1, 4)
    return wret(Int(sys_windows.ioctlsocket(fd, 2147772030, a)))
  }
  // F_GETFL 3, F_SETFL 4, F_SETFD 2 (both OSes); O_NONBLOCK 2048 on
  // Linux, 4 on macOS; FD_CLOEXEC 1
  let fl = fcntl(fd, 3, 0)
  if fl < 0 {
    return fl
  }
  let r = fcntl(fd, 4, fl | (if darwin() { 4 } else { 2048 }))
  if r < 0 {
    return r
  }
  fcntl(fd, 2, 1)
}

/// The pending error of a socket (getsockopt SO_ERROR) as a negative
/// errno, 0 for none; the negative errno of getsockopt itself when it
/// fails.
pub fn sock_err(fd: Int) -> Int {
  let a = obj.scratch()
  rt.mem_store(a, 0, 0, 4)
  rt.mem_store(a, 8, 4, 4)
  // SOL_SOCKET 1, SO_ERROR 4 on Linux; 0xffff, 0x1007 on macOS and
  // Windows
  let r = if darwin() || windows() { getsockopt(fd, 65535, 4103, a, a + 8) } else { getsockopt(fd, 1, 4, a, a + 8) }
  if r < 0 {
    return r
  }
  let e = rt.mem_load(a, 0, 4)
  if windows() && e != 0 {
    // a Winsock error code
    return 0 - wsa_errno(e)
  }
  0 - e
}

/// setsockopt(2) of a C int value v: 0, or the negative errno.
pub fn set_int(fd: Int, level: Int, opt: Int, v: Int) -> Int {
  let a = obj.scratch()
  rt.mem_store(a, 0, v, 4)
  setsockopt(fd, level, opt, a, 4)
}

// ---------------------------------------------------------------------------
// Socket addresses as Bytes: struct sockaddr_in (16 bytes: the family,
// the port in network order, the address) and struct sockaddr_in6 (28
// bytes: the family, the port, the flow information, the address, the
// scope id).

/// A sockaddr of the 4 or 16 address bytes ip, the port, and (IPv6) the
/// zone (scope id).
pub fn sockaddr(ip: Bytes, port: Int, zone: Int) -> Bytes {
  let n = if ip.len() == 4 { 16 } else { 28 }
  var b = BytesBuilder.with_capacity(n)
  let fam = if ip.len() == 4 { AF_INET } else { AF_INET6 }
  b.write_byte(UInt8(fam & 255))
  b.write_byte(UInt8(fam >> 8))
  b.write_byte(UInt8((port >> 8) & 255))
  b.write_byte(UInt8(port & 255))
  if ip.len() == 4 {
    b.write(ip)
    for _ in 0..8 {
      b.write_byte(UInt8(0))
    }
  } else {
    for _ in 0..4 {
      b.write_byte(UInt8(0))
    }
    b.write(ip)
    for i in 0..4 {
      b.write_byte(UInt8((zone >> (8 * i)) & 255))
    }
  }
  b.freeze()
}

/// The address bytes of a sockaddr (4 for AF_INET, 16 for AF_INET6), or
/// empty for another family.
pub fn sockaddr_ip(sa: Bytes) -> Bytes {
  if sa.len() >= 8 && Int(sa[0]) + 256 * Int(sa[1]) == AF_INET {
    return sa[4..8]
  }
  if sa.len() >= 24 && Int(sa[0]) + 256 * Int(sa[1]) == AF_INET6 {
    return sa[8..24]
  }
  b""
}

/// The local address a connected socket fd has (getsockname), as a
/// sockaddr, or empty.
pub fn local_addr(fd: Int) -> Bytes {
  let buf = raw.bytes_buf(128)
  let a = raw.bytes_addr(buf)
  let lp = obj.scratch()
  rt.mem_store(lp, 0, 128, 4)
  let r = sockname(fd, a, lp)
  if r < 0 {
    return b""
  }
  var n = rt.mem_load(lp, 0, 4)
  if n > 128 {
    n = 128
  }
  raw.bytes_len(buf, n)
}

/// Sends the bytes of b on the connected socket fd: the count sent, or
/// the negative errno.
pub fn send_bytes(fd: Int, b: Bytes) -> Int {
  // MSG_NOSIGNAL 0x4000
  let r = send(fd, raw.bytes_addr(b), b.len(), 16384)
  keep(b, r)
}

/// connect(2) to the sockaddr sa.
pub fn connect_to(fd: Int, sa: Bytes) -> Int {
  let r = connect(fd, raw.bytes_addr(sa), sa.len())
  keep(sa, r)
}

/// r, after b (whose address a system call used) is known alive up to
/// here: reference counting releases a value after its last use.
pub fn keep(b: Bytes, r: Int) -> Int {
  if b.len() < 0 {
    return -1
  }
  r
}
