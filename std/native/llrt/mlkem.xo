// ML-KEM-768 and ML-KEM-1024 (FIPS 203) and TLS's hybrids
// (X25519MLKEM768, SecP256r1MLKEM768, SecP384r1MLKEM1024) for the native
// backends' TLS (the zero-C audit's B31, decision 0202), as Go's
// crypto/internal/fips140/mlkem (mlkem768.go, mlkem1024.go, field.go) and
// crypto/tls key_schedule.go's hybridKeyExchange: key generation from a
// 64 byte seed (d || z), encapsulation, decapsulation with the implicit
// rejection (the shared key of a ciphertext that does not re-encrypt is
// J(z || c), chosen in constant time). Field arithmetic is Go's: q =
// 3329, Barrett reduction, no branch or index on a secret; the
// rejection sampling of the matrix A reads only the public seed.
use native/llrt/asn1
use native/llrt/ct
use native/llrt/nistec
use native/llrt/rand
use native/llrt/sha3
use native/llrt/x25519
use native/rt

const N: Int = 256
const Q: Int = 3329

/// The sizes: an encapsulation key, a ciphertext (ML-KEM-768's, then
/// ML-KEM-1024's), a seed.
pub const EK_SIZE: Int = 1184
pub const CT_SIZE: Int = 1088
pub const EK_SIZE_1024: Int = 1568
pub const CT_SIZE_1024: Int = 1568
pub const SEED_SIZE: Int = 64

// The parameter sets' k (ML-KEM-768: 3, ML-KEM-1024: 4); du and dv,
// the ciphertext's compressions, follow from it (10 and 4, 11 and 5).
const K768: Int = 3
const K1024: Int = 4

fn du(k: Int) -> Int { if k == K1024 { 11 } else { 10 } }

fn dv(k: Int) -> Int { if k == K1024 { 5 } else { 4 } }

fn ek_size(k: Int) -> Int { 384 * k + 32 }

fn ct_size(k: Int) -> Int { 32 * (du(k) * k + dv(k)) }

/// TLS's hybrid groups (draft-ietf-tls-ecdhe-mlkem): X25519MLKEM768,
/// SecP256r1MLKEM768, SecP384r1MLKEM1024.
pub const GROUP_X25519_MLKEM768: Int = 0x11ec
pub const GROUP_SECP256R1_MLKEM768: Int = 0x11eb
pub const GROUP_SECP384R1_MLKEM1024: Int = 0x11ed

// ---------------------------------------------------------------------------
// The field and the ring

// The field's arithmetic wraps (rt.int_wrap: no overflow check): every
// value here is a field element below q (12 bits), a sum or difference
// of two below 2q, or a product of two below 2^24 (with a gamma or zeta
// factor, a sum of two such products below 2^25), so nothing comes near
// 2^63.

fn add(a: Int, b: Int) -> Int { rt.int_wrap(0, a, b) }

fn sub(a: Int, b: Int) -> Int { rt.int_wrap(1, a, b) }

fn mul(a: Int, b: Int) -> Int { rt.int_wrap(2, a, b) }

/// A polynomial's coefficients as raw memory, for the NTT's loops, whose
/// every index is below N by their bounds (the arm64 backend checked each
/// access; LLVM proved them): the address of the first of f's N words,
/// after f has been made this function's own (unique: a write first, so
/// the raw stores change no other list). f must have N elements.
fn coeffs(var f: List[Int]) -> Int {
  if f.len() != N {
    fault("mlkem: a polynomial of ${f.len()} coefficients")
  }
  f[0] = f[0]
  rt.int_wrap(0, rt.obj_addr(f), rt.layout(2))
}

/// The raw coefficients of f for reading only (f must have N elements).
fn coeffs_read(f: List[Int]) -> Int {
  if f.len() != N {
    fault("mlkem: a polynomial of ${f.len()} coefficients")
  }
  rt.int_wrap(0, rt.obj_addr(f), rt.layout(2))
}

/// The coefficient at byte offset o of the raw coefficients p (the loops
/// count in bytes: a load of a register offset, no index shift).
fn ldc(p: Int, o: Int) -> Int { rt.mem_load(p, o, 8) }

fn stc(p: Int, o: Int, v: Int) { rt.mem_store(p, o, v, 8) }

// The field operations are written on rt.int_wrap directly, calling no
// other Xo function: the arm64 inliner copies a callee's body as it was
// before its own calls were inlined, so a helper that calls a helper
// stays a call in the NTT's loop (2026-10-15).

/// a - q when a >= q, for a < 2q.
fn reduce_once(a: Int) -> Int {
  let x = rt.int_wrap(1, a, Q)
  rt.int_wrap(0, x, rt.int_wrap(2, rt.int_wrap(4, x, 63), Q))
}

fn fadd(a: Int, b: Int) -> Int {
  let x = rt.int_wrap(1, rt.int_wrap(0, a, b), Q)
  rt.int_wrap(0, x, rt.int_wrap(2, rt.int_wrap(4, x, 63), Q))
}

/// a - b + q, reduced once: a - b when it is not negative.
fn fsub(a: Int, b: Int) -> Int {
  let x = rt.int_wrap(1, a, b)
  rt.int_wrap(0, x, rt.int_wrap(2, rt.int_wrap(4, x, 63), Q))
}

/// Barrett reduction of a < 2^25 (Go's fieldReduce).
fn freduce(a: Int) -> Int {
  let quotient = rt.int_wrap(4, rt.int_wrap(2, a, 5039), 24)
  let x = rt.int_wrap(1, rt.int_wrap(1, a, rt.int_wrap(2, quotient, Q)), Q)
  rt.int_wrap(0, x, rt.int_wrap(2, rt.int_wrap(4, x, 63), Q))
}

/// freduce of a * b.
fn fmul(a: Int, b: Int) -> Int {
  let p = rt.int_wrap(2, a, b)
  let quotient = rt.int_wrap(4, rt.int_wrap(2, p, 5039), 24)
  let x = rt.int_wrap(1, rt.int_wrap(1, p, rt.int_wrap(2, quotient, Q)), Q)
  rt.int_wrap(0, x, rt.int_wrap(2, rt.int_wrap(4, x, 63), Q))
}

/// Go's compress: round(2^d x / q) mod 2^d.
fn compress(x: Int, d: Int) -> Int {
  let dividend = rt.int_wrap(3, x, d)
  var quotient = (dividend * 5039) >> 24
  let remainder = dividend - quotient * Q
  quotient += rt.int_wrap(4, Q / 2 - remainder, 63)
  quotient += rt.int_wrap(4, Q + Q / 2 - remainder, 63)
  quotient & (rt.int_wrap(3, 1, d) - 1)
}

/// Go's decompress: round(q y / 2^d).
fn decompress(y: Int, d: Int) -> Int {
  let dividend = y * Q
  (dividend >> d) + ((dividend >> (d - 1)) & 1)
}

fn zeros() -> List[Int] {
  var p: List[Int] = List.with_capacity(N)
  for _ in 0..N {
    p.push(0)
  }
  p
}

fn padd(a: List[Int], b: List[Int]) -> List[Int] {
  var s = a
  add_into(s, b)
  s
}

/// a += b, in place.
fn add_into(var a: List[Int], b: List[Int]) {
  for i in 0..N {
    a[i] = fadd(a[i], b[i])
  }
}

fn psub(a: List[Int], b: List[Int]) -> List[Int] {
  var s = a
  for i in 0..N {
    s[i] = fsub(s[i], b[i])
  }
  s
}

const ZETAS: List[Int] = [1, 1729, 2580, 3289, 2642, 630, 1897, 848, 1062, 1919, 193, 797, 2786, 3260, 569, 1746, 296, 2447, 1339, 1476, 3046, 56, 2240, 1333, 1426, 2094, 535, 2882, 2393, 2879, 1974, 821, 289, 331, 3253, 1756, 1197, 2304, 2277, 2055, 650, 1977, 2513, 632, 2865, 33, 1320, 1915, 2319, 1435, 807, 452, 1438, 2868, 1534, 2402, 2647, 2617, 1481, 648, 2474, 3110, 1227, 910, 17, 2761, 583, 2649, 1637, 723, 2288, 1100, 1409, 2662, 3281, 233, 756, 2156, 3015, 3050, 1703, 1651, 2789, 1789, 1847, 952, 1461, 2687, 939, 2308, 2437, 2388, 733, 2337, 268, 641, 1584, 2298, 2037, 3220, 375, 2549, 2090, 1645, 1063, 319, 2773, 757, 2099, 561, 2466, 2594, 2804, 1092, 403, 1026, 1143, 2150, 2775, 886, 1722, 1212, 1874, 1029, 2110, 2935, 885, 2154]


const GAMMAS: List[Int] = [17, 3312, 2761, 568, 583, 2746, 2649, 680, 1637, 1692, 723, 2606, 2288, 1041, 1100, 2229, 1409, 1920, 2662, 667, 3281, 48, 233, 3096, 756, 2573, 2156, 1173, 3015, 314, 3050, 279, 1703, 1626, 1651, 1678, 2789, 540, 1789, 1540, 1847, 1482, 952, 2377, 1461, 1868, 2687, 642, 939, 2390, 2308, 1021, 2437, 892, 2388, 941, 733, 2596, 2337, 992, 268, 3061, 641, 2688, 1584, 1745, 2298, 1031, 2037, 1292, 3220, 109, 375, 2954, 2549, 780, 2090, 1239, 1645, 1684, 1063, 2266, 319, 3010, 2773, 556, 757, 2572, 2099, 1230, 561, 2768, 2466, 863, 2594, 735, 2804, 525, 1092, 2237, 403, 2926, 1026, 2303, 1143, 2186, 2150, 1179, 2775, 554, 886, 2443, 1722, 1607, 1212, 2117, 1874, 1455, 1029, 2300, 2110, 1219, 2935, 394, 885, 2444, 2154, 1175]


/// The NTT (FIPS 203 Algorithm 9), in place.
fn ntt(f0: List[Int]) -> List[Int] {
  // the constant list once (a constant's every use reads it through
  // const_once)
  let zetas = ZETAS
  var f = f0
  let p = coeffs(f)
  var k = 1
  var len = 128
  while len >= 2 {
    var start = 0
    let lb = 8 * len
    while start < N {
      let z = zetas[k]
      k += 1
      // byte offsets
      var j = 8 * start
      let end = add(j, lb)
      while j < end {
        let jl = add(j, lb)
        let t = fmul(z, ldc(p, jl))
        let fj = ldc(p, j)
        stc(p, jl, fsub(fj, t))
        stc(p, j, fadd(fj, t))
        j = add(j, 8)
      }
      start = add(start, add(len, len))
    }
    len = len / 2
  }
  f
}

/// The inverse NTT (FIPS 203 Algorithm 10).
fn inverse_ntt(f0: List[Int]) -> List[Int] {
  let zetas = ZETAS
  var f = f0
  let p = coeffs(f)
  var k = 127
  var len = 2
  while len <= 128 {
    var start = 0
    let lb = 8 * len
    while start < N {
      let z = zetas[k]
      k -= 1
      // byte offsets
      var j = 8 * start
      let end = add(j, lb)
      while j < end {
        let jl = add(j, lb)
        let t = ldc(p, j)
        let u = ldc(p, jl)
        stc(p, j, fadd(t, u))
        stc(p, jl, freduce(mul(z, add(sub(u, t), Q))))
        j = add(j, 8)
      }
      start = add(start, add(len, len))
    }
    len = len * 2
  }
  var o = 0
  while o < 8 * N {
    stc(p, o, fmul(ldc(p, o), 3303))
    o = add(o, 8)
  }
  f
}

/// h += f * g in the NTT domain, in place (the sums of products of
/// K-PKE, without a product's own list).
fn ntt_mul_acc(var h: List[Int], f: List[Int], g: List[Int]) {
  let gammas = GAMMAS
  let ph = coeffs(h)
  let pf = coeffs_read(f)
  let pg = coeffs_read(g)
  // byte offsets: a pair of coefficients a step, gammas[o / 16]
  var o = 0
  var gi = 0
  while o < 8 * N {
    let o1 = add(o, 8)
    let a0 = ldc(pf, o)
    let a1 = ldc(pf, o1)
    let b0 = ldc(pg, o)
    let b1 = ldc(pg, o1)
    stc(ph, o, fadd(ldc(ph, o), freduce(add(mul(a0, b0), mul(fmul(a1, b1), gammas[gi])))))
    stc(ph, o1, fadd(ldc(ph, o1), freduce(add(mul(a0, b1), mul(a1, b0)))))
    o = add(o, 16)
    gi = add(gi, 1)
  }
}

// ---------------------------------------------------------------------------
// Sampling

/// The NTT coefficients of A[i][j] (FIPS 203 Algorithm 7): SHAKE128 of
/// rho || ii || jj, 12 bit candidates below q. The output is read a block
/// (SHAKE128's rate, 168 bytes, 56 candidate pairs) at a time: one read
/// SHAKE128's rate in bytes (FIPS 202): a multiple of 3.
const SHAKE128_RATE = 168

/// a block rather than seven of 24 bytes, the same stream.
fn sample_ntt(rho: Bytes, ii: Int, jj: Int) -> List[Int] {
  var s = sha3.new_shake128()
  sha3.write(s, asn1.cat([rho, byte(ii), byte(jj)]))
  var a: List[Int] = List.with_capacity(N)
  while a.len() < N {
    let b = sha3.read(s, SHAKE128_RATE)
    var off = 0
    while off < SHAKE128_RATE && a.len() < N {
      let d1 = Int(b[off]) | ((Int(b[off + 1]) & 15) << 8)
      let d2 = (Int(b[off + 1]) >> 4) | (Int(b[off + 2]) << 4)
      if d1 < Q {
        a.push(d1)
      }
      if d2 < Q && a.len() < N {
        a.push(d2)
      }
      off += 3
    }
  }
  a
}

/// A polynomial from the centered binomial distribution with eta 2
/// (FIPS 203 Algorithm 8): SHAKE256 of s || b, 128 bytes.
fn sample_cbd(s: Bytes, b: Int) -> List[Int] {
  let bs = sha3.shake256(asn1.cat([s, byte(b)]), 128)
  var f = zeros()
  for i in 0..N / 2 {
    let x = Int(bs[i])
    f[2 * i] = fsub((x & 1) + ((x >> 1) & 1), ((x >> 2) & 1) + ((x >> 3) & 1))
    f[2 * i + 1] = fsub(((x >> 4) & 1) + ((x >> 5) & 1), ((x >> 6) & 1) + ((x >> 7) & 1))
  }
  f
}

// ---------------------------------------------------------------------------
// Encodings

/// ByteEncode12.
fn encode12(f: List[Int]) -> Bytes {
  var out = rt.rs_with_cap(384)
  var i = 0
  while i < N {
    let x = f[i] | (f[i + 1] << 12)
    out = rt.rs_push_word(out, x, 3)
    i += 2
  }
  out.bytes()
}

/// ByteDecode12 with Go's check that every coefficient is below q.
fn decode12(b: Bytes) -> List[Int]? {
  var f = zeros()
  var bad = 0
  for i in 0..N / 2 {
    let d = Int(b[3 * i]) | (Int(b[3 * i + 1]) << 8) | (Int(b[3 * i + 2]) << 16)
    f[2 * i] = d & 4095
    f[2 * i + 1] = d >> 12
    bad = bad | ((Q - 1 - f[2 * i]) | (Q - 1 - f[2 * i + 1]))
  }
  // a negative difference sets the sign bit (the key is public)
  if bad < 0 {
    return None
  }
  Some(f)
}

/// Compress_d then ByteEncode_d (d bits per coefficient, little endian).
fn encode_d(f: List[Int], d: Int) -> Bytes {
  var out = rt.rs_with_cap(32 * d)
  var acc = 0
  var bits = 0
  for i in 0..N {
    acc = acc | rt.int_wrap(3, compress(f[i], d), bits)
    bits += d
    while bits >= 8 {
      out = rt.rs_push_byte(out, acc & 255)
      acc = acc >> 8
      bits -= 8
    }
  }
  out.bytes()
}

/// ByteDecode_d then Decompress_d.
fn decode_d(b: Bytes, d: Int) -> List[Int] {
  var f = zeros()
  var acc = 0
  var bits = 0
  var p = 0
  for i in 0..N {
    while bits < d {
      acc = acc | rt.int_wrap(3, Int(b[p]), bits)
      p += 1
      bits += 8
    }
    f[i] = decompress(acc & (rt.int_wrap(3, 1, d) - 1), d)
    acc = acc >> d
    bits -= d
  }
  f
}

fn byte(x: Int) -> Bytes { rt.rs_push_byte(rt.rs_with_cap(1), x & 255).bytes() }

// ---------------------------------------------------------------------------
// K-PKE and ML-KEM

/// A key expanded from its seed: the matrix A (A[i*k+j]), the secret s
/// and t (NTT domain), rho, H(ek), z, and the encapsulation key's bytes.
struct Key {
  a: List[List[Int]]
  s: List[List[Int]]
  t: List[List[Int]]
  rho: Bytes
  h: Bytes
  z: Bytes
  ek: Bytes
}

fn matrix(rho: Bytes, k: Int) -> List[List[Int]] {
  var a: List[List[Int]] = []
  for i in 0..k {
    for j in 0..k {
      a.push(sample_ntt(rho, j, i))
    }
  }
  a
}

/// ML-KEM.KeyGen_internal (FIPS 203 Algorithms 13 and 16) from d || z.
fn expand(seed: Bytes, k: Int) -> Key {
  let d = seed[0..32]
  let z = seed[32..64]
  let g = sha3.sha3_512(asn1.cat([d, byte(k)]))
  let rho = g[0..32]
  let sigma = g[32..64]
  let a = matrix(rho, k)
  var s: List[List[Int]] = []
  var e: List[List[Int]] = []
  for i in 0..k {
    s.push(ntt(sample_cbd(sigma, i)))
  }
  for i in 0..k {
    e.push(ntt(sample_cbd(sigma, k + i)))
  }
  var t: List[List[Int]] = []
  for i in 0..k {
    var ti = e[i]
    for j in 0..k {
      ntt_mul_acc(ti, a[i * k + j], s[j])
    }
    t.push(ti)
  }
  var parts: List[Bytes] = []
  for ti in t {
    parts.push(encode12(ti))
  }
  parts.push(rho)
  let ek = asn1.cat(parts)
  Key{a: a, s: s, t: t, rho: rho, h: sha3.sha3_256(ek), z: z, ek: ek}
}

/// The encapsulation key of a seed (1184 bytes).
pub fn public_key(seed: Bytes) -> Bytes { expand(seed, K768).ek }

/// The ML-KEM-1024 encapsulation key of a seed (1568 bytes).
pub fn public_key_1024(seed: Bytes) -> Bytes { expand(seed, K1024).ek }

/// A new seed from the system's generator.
pub fn generate() -> Bytes { rand.next_bytes(SEED_SIZE) }

/// K-PKE.Encrypt (FIPS 203 Algorithm 14).
fn pke_encrypt(a: List[List[Int]], t: List[List[Int]], m: Bytes, rnd: Bytes, k: Int) -> Bytes {
  var r: List[List[Int]] = []
  for i in 0..k {
    r.push(ntt(sample_cbd(rnd, i)))
  }
  var e1: List[List[Int]] = []
  for i in 0..k {
    e1.push(sample_cbd(rnd, k + i))
  }
  let e2 = sample_cbd(rnd, 2 * k)
  var parts: List[Bytes] = []
  for i in 0..k {
    var uh = zeros()
    for j in 0..k {
      ntt_mul_acc(uh, a[j * k + i], r[j])
    }
    parts.push(encode_d(padd(e1[i], inverse_ntt(uh)), du(k)))
  }
  let mu = decode_d(m, 1)
  var vh = zeros()
  for i in 0..k {
    ntt_mul_acc(vh, t[i], r[i])
  }
  parts.push(encode_d(padd(padd(inverse_ntt(vh), e2), mu), dv(k)))
  asn1.cat(parts)
}

/// K-PKE.Decrypt (FIPS 203 Algorithm 15).
fn pke_decrypt(s: List[List[Int]], c: Bytes, k: Int) -> Bytes {
  var mask = zeros()
  let ul = 32 * du(k)
  for i in 0..k {
    let u = decode_d(c[ul * i..ul * (i + 1)], du(k))
    ntt_mul_acc(mask, s[i], ntt(u))
  }
  let v = decode_d(c[ul * k..ct_size(k)], dv(k))
  encode_d(psub(v, inverse_ntt(mask)), 1)
}

/// ML-KEM.Encaps_internal with the 32 byte message m (FIPS 203
/// Algorithm 17): the shared key (32 bytes) and the ciphertext; none
/// when ek is not a valid encapsulation key (Go's
/// NewEncapsulationKey768: the length, every coefficient below q).
pub fn encapsulate(ek: Bytes, m: Bytes) -> (Bytes, Bytes)? { encaps_k(ek, m, K768) }

/// encapsulate for ML-KEM-1024 (a 1568 byte key and ciphertext).
pub fn encapsulate_1024(ek: Bytes, m: Bytes) -> (Bytes, Bytes)? { encaps_k(ek, m, K1024) }

fn encaps_k(ek: Bytes, m: Bytes, k: Int) -> (Bytes, Bytes)? {
  if ek.len() != ek_size(k) || m.len() != 32 {
    return None
  }
  var t: List[List[Int]] = []
  for i in 0..k {
    t.push(decode12(ek[384 * i..384 * (i + 1)])?)
  }
  let a = matrix(ek[384 * k..ek_size(k)], k)
  let g = sha3.sha3_512(asn1.cat([m, sha3.sha3_256(ek)]))
  Some((g[0..32], pke_encrypt(a, t, m, g[32..64], k)))
}

/// ML-KEM.Decaps_internal (FIPS 203 Algorithm 18) of a ciphertext by the
/// key of seed: the shared key, J(z || c) when c does not re-encrypt to
/// itself (chosen in constant time); none for a ciphertext of another
/// length.
pub fn decapsulate(seed: Bytes, c: Bytes) -> Bytes? { decaps_k(seed, c, K768) }

/// decapsulate for ML-KEM-1024.
pub fn decapsulate_1024(seed: Bytes, c: Bytes) -> Bytes? { decaps_k(seed, c, K1024) }

fn decaps_k(seed: Bytes, c: Bytes, k: Int) -> Bytes? {
  let n = ct_size(k)
  if seed.len() != SEED_SIZE || c.len() != n {
    return None
  }
  let key = expand(seed, k)
  let m = pke_decrypt(key.s, c, k)
  let g = sha3.sha3_512(asn1.cat([m, key.h]))
  let kprime = g[0..32]
  let kbar = sha3.shake256(asn1.cat([key.z, c]), 32)
  let c1 = pke_encrypt(key.a, key.t, m, g[32..64], k)
  var diff = 0
  for i in 0..n {
    diff = diff | (Int(c[i]) ^ Int(c1[i]))
  }
  let same = ct.mask_eq(diff, 0)
  var out = rt.rs_with_cap(32)
  for i in 0..32 {
    out = rt.rs_push_byte(out, ct.pick(same, Int(kprime[i]), Int(kbar[i])))
  }
  Some(out.bytes())
}

// ---------------------------------------------------------------------------
// The hybrids (Go's key_schedule.go hybridKeyExchange)
//
// A hybrid private key is the ML-KEM seed (64 bytes), then the ECDH
// private key (X25519's 32 bytes, P-256's 32, P-384's 48). The shares and
// the secret put ML-KEM first for X25519MLKEM768 and the ECDH part first
// for the other two (draft-ietf-tls-ecdhe-mlkem-02 section 4.1).

/// Whether the group is a hybrid.
pub fn is_hybrid(group: Int) -> Bool { group == GROUP_X25519_MLKEM768 || group == GROUP_SECP256R1_MLKEM768 || group == GROUP_SECP384R1_MLKEM1024 }

/// The ECDH group of a hybrid (X25519 29, P-256 23, P-384 24): the
/// second key share a client sends with it, from the same ECDH key.
pub fn hybrid_ecdh_group(group: Int) -> Int {
  if group == GROUP_SECP256R1_MLKEM768 {
    return 23
  }
  if group == GROUP_SECP384R1_MLKEM1024 {
    return 24
  }
  29
}

fn kem_k(group: Int) -> Int { if group == GROUP_SECP384R1_MLKEM1024 { K1024 } else { K768 } }

fn ecdh_pub_size(group: Int) -> Int {
  if group == GROUP_SECP256R1_MLKEM768 {
    return 65
  }
  if group == GROUP_SECP384R1_MLKEM1024 {
    return 97
  }
  32
}

/// The size of a hybrid private key of the group.
pub fn hybrid_priv_size(group: Int) -> Int { if group == GROUP_SECP384R1_MLKEM1024 { 112 } else { 96 } }

/// A new hybrid private key of the group.
pub fn hybrid_keygen_for(group: Int) -> Bytes {
  let e = if group == GROUP_SECP256R1_MLKEM768 {
    nistec.generate(nistec.P256)
  } else if group == GROUP_SECP384R1_MLKEM1024 {
    nistec.generate(nistec.P384)
  } else {
    rand.next_bytes(32)
  }
  asn1.cat([generate(), e])
}

/// The ECDH private key of a hybrid private key.
pub fn hybrid_ecdh_priv(priv: Bytes) -> Bytes { priv[SEED_SIZE..priv.len()] }

fn ecdh_public(group: Int, priv: Bytes) -> Bytes {
  if group == GROUP_SECP256R1_MLKEM768 {
    return nistec.public_key(nistec.P256, priv)
  }
  if group == GROUP_SECP384R1_MLKEM1024 {
    return nistec.public_key(nistec.P384, priv)
  }
  x25519.base(priv)
}

/// The ECDH secret; none for an invalid point or an all zero X25519
/// secret (crypto/ecdh's checks).
fn ecdh_secret(group: Int, priv: Bytes, peer: Bytes) -> Bytes? {
  if group == GROUP_SECP256R1_MLKEM768 {
    return nistec.ecdh(nistec.P256, priv, peer)
  }
  if group == GROUP_SECP384R1_MLKEM1024 {
    return nistec.ecdh(nistec.P384, priv, peer)
  }
  let x = x25519.scalar_mult(priv, peer)
  if all_zero(x) { None } else { Some(x) }
}

/// A client's hybrid key share of the group.
pub fn hybrid_share_for(group: Int, priv: Bytes) -> Bytes {
  let ek = expand(priv[0..SEED_SIZE], kem_k(group)).ek
  let e = ecdh_public(group, hybrid_ecdh_priv(priv))
  if group == GROUP_X25519_MLKEM768 { asn1.cat([ek, e]) } else { asn1.cat([e, ek]) }
}

/// The client's shared secret from the server's share of the group;
/// none on a share of another length, an invalid ECDH share, or a
/// ciphertext that does not decapsulate.
pub fn hybrid_client_shared_for(group: Int, priv: Bytes, share: Bytes) -> Bytes? {
  let k = kem_k(group)
  let ec = ecdh_pub_size(group)
  let cn = ct_size(k)
  if share.len() != cn + ec {
    return None
  }
  let x25519_first = group == GROUP_X25519_MLKEM768
  let e_share = if x25519_first { share[cn..cn + ec] } else { share[0..ec] }
  let c = if x25519_first { share[0..cn] } else { share[ec..ec + cn] }
  let x = ecdh_secret(group, hybrid_ecdh_priv(priv), e_share)?
  let key = decaps_k(priv[0..SEED_SIZE], c, k)?
  Some(if x25519_first { asn1.cat([key, x]) } else { asn1.cat([x, key]) })
}

/// The server's side for a client's hybrid share of the group, with its
/// ECDH private key and the 32 byte ML-KEM message: the shared secret and
/// its share; none on a share of another length, an invalid
/// encapsulation key, or an invalid ECDH share.
pub fn hybrid_server_for(group: Int, share: Bytes, e_priv: Bytes, m: Bytes) -> (Bytes, Bytes)? {
  let k = kem_k(group)
  let ec = ecdh_pub_size(group)
  let en = ek_size(k)
  if share.len() != en + ec {
    return None
  }
  let x25519_first = group == GROUP_X25519_MLKEM768
  let e_share = if x25519_first { share[en..en + ec] } else { share[0..ec] }
  let ek = if x25519_first { share[0..en] } else { share[ec..ec + en] }
  let x = ecdh_secret(group, e_priv, e_share)?
  let (key, c) = encaps_k(ek, m, k)?
  let e = ecdh_public(group, e_priv)
  if x25519_first {
    return Some((asn1.cat([key, x]), asn1.cat([c, e])))
  }
  Some((asn1.cat([x, key]), asn1.cat([e, c])))
}

// X25519MLKEM768's names (tls13srv.xo's, and the tests')

/// A hybrid private key: the ML-KEM seed (64 bytes), then the X25519
/// private key (32).
pub fn hybrid_keygen() -> Bytes { hybrid_keygen_for(GROUP_X25519_MLKEM768) }

/// The X25519 private key of a hybrid private key (for the plain X25519
/// share a client sends next to the hybrid one, as Go's).
pub fn hybrid_x25519_priv(priv: Bytes) -> Bytes { priv[64..96] }

/// A client's hybrid key share: the encapsulation key, then the X25519
/// public key (1216 bytes).
pub fn hybrid_share(priv: Bytes) -> Bytes { hybrid_share_for(GROUP_X25519_MLKEM768, priv) }

/// The client's shared secret from the server's share (the ciphertext,
/// then its X25519 public key): ML-KEM's key, then the X25519 secret;
/// none on a share of another length, a ciphertext that does not
/// decapsulate, or an all zero X25519 secret.
pub fn hybrid_client_shared(priv: Bytes, share: Bytes) -> Bytes? { hybrid_client_shared_for(GROUP_X25519_MLKEM768, priv, share) }

/// The server's side for a client's hybrid share, with its X25519
/// private key and the 32 byte ML-KEM message: the shared secret and its
/// share (the ciphertext, then its X25519 public key); none on a share of
/// another length, an invalid encapsulation key, or a low order X25519
/// point.
pub fn hybrid_server(share: Bytes, x_priv: Bytes, m: Bytes) -> (Bytes, Bytes)? { hybrid_server_for(GROUP_X25519_MLKEM768, share, x_priv, m) }

fn all_zero(b: Bytes) -> Bool {
  var acc = 0
  for v in b {
    acc = acc | Int(v)
  }
  acc == 0
}

// ---------------------------------------------------------------------------
// The tests' op

/// internal.crypto_op's mlkem ops (std/internal.xo): `public` the
/// encapsulation key of the seed a; `encaps` the shared key and the
/// ciphertext of the encapsulation key a and message b (empty for an
/// invalid key); `decaps` the shared key of the seed a and ciphertext b
/// (empty for a wrong length); `hybrid_share` of the private key a;
/// `hybrid_server` the secret and share for the client's share a, X25519
/// key b, message c; `hybrid_client` the secret of the private key a and
/// server share b; `accumulated` C2SP CCTV's accumulated test of a
/// (decimal) iterations (Go's crypto/mlkem TestAccumulated): the
/// SHAKE128 digest of every key, ciphertext and shared key; the same
/// with a `_1024` suffix for ML-KEM-1024 (public, encaps, decaps,
/// accumulated); `p256_hybrid_share`, `p256_hybrid_server`,
/// `p256_hybrid_client` and the `p384_` ones for SecP256r1MLKEM768 and
/// SecP384r1MLKEM1024 (as the X25519MLKEM768 ones). None for another what.
pub fn op(what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  if what.starts_with("p256_hybrid_") || what.starts_with("p384_hybrid_") {
    let g = if what.starts_with("p256") { GROUP_SECP256R1_MLKEM768 } else { GROUP_SECP384R1_MLKEM1024 }
    let w = what.trim_prefix("p256_").trim_prefix("p384_")
    return match w {
      "hybrid_share" => Some(hybrid_share_for(g, a))
      "hybrid_server" => match hybrid_server_for(g, a, b, c) {
        Some((k, sh)) => Some(asn1.cat([k, sh]))
        None => Some(b"")
      }
      "hybrid_client" => Some(hybrid_client_shared_for(g, a, b) ?? b"")
      _ => None
    }
  }
  match what {
    "public_1024" => Some(public_key_1024(a))
    "encaps_1024" => match encapsulate_1024(a, b) {
      Some((k, ct)) => Some(asn1.cat([k, ct]))
      None => Some(b"")
    }
    "decaps_1024" => Some(decapsulate_1024(a, b) ?? b"")
    "accumulated_1024" => Some(accumulated_k(Int.parse(a.to_str() ?? "") ?? 0, K1024))
    "public" => Some(public_key(a))
    "encaps" => match encapsulate(a, b) {
      Some((k, ct)) => Some(asn1.cat([k, ct]))
      None => Some(b"")
    }
    "decaps" => Some(decapsulate(a, b) ?? b"")
    "hybrid_share" => Some(hybrid_share(a))
    "hybrid_server" => match hybrid_server(a, b, c) {
      Some((k, s)) => Some(asn1.cat([k, s]))
      None => Some(b"")
    }
    "hybrid_client" => Some(hybrid_client_shared(a, b) ?? b"")
    "accumulated" => Some(accumulated_k(Int.parse(a.to_str() ?? "") ?? 0, K768))
    _ => None
  }
}

/// C2SP CCTV's accumulated ML-KEM-768 test: n times, a seed from a
/// SHAKE128 stream of the empty input, its encapsulation key, an
/// encapsulation of the next 32 bytes and its decapsulation (which must
/// agree), and the decapsulation of 1088 more bytes as a ciphertext
/// (the implicit rejection); every output into a SHAKE128 digest of 32
/// bytes. ML-KEM-1024's (k 4) the same with its sizes.
fn accumulated_k(n: Int, k: Int) -> Bytes {
  var s = sha3.new_shake128()
  var o = sha3.new_shake128()
  for _ in 0..n {
    let seed = sha3.read(s, SEED_SIZE)
    let ek = expand(seed, k).ek
    sha3.write(o, ek)
    let msg = sha3.read(s, 32)
    let (key, c) = encaps_k(ek, msg, k) ?? (b"", b"")
    sha3.write(o, c)
    sha3.write(o, key)
    if decaps_k(seed, c, k) != Some(key) {
      return b"decapsulation differs"
    }
    let c1 = sha3.read(s, ct_size(k))
    sha3.write(o, decaps_k(seed, c1, k) ?? b"")
  }
  sha3.read(o, 32)
}
