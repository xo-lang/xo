// Host facts (decision 0410): the host name. uname's nodename on Linux,
// gethostname(3) on macOS, GetComputerNameExW on Windows (decision
// 0426), sysctl kern.hostname on FreeBSD; "" under WASI, which has no such call.

use native/llrt/raw
use native/llrt/windows
use native/rt
use native/sys_darwin

/// Windows' local application data folder with / separators, or "" (on
/// other OSes too; Env.local_app_data, decision 0584).
pub fn local_app_data() -> Str {
  if target.os == TargetOs.Windows { windows.local_app_data() } else { "" }
}

/// The host's name, or "" when the system cannot say.
pub fn hostname() -> Str {
  match target.os {
    TargetOs.Darwin => {
      let buf = raw.bytes_buf(256)
      let a = raw.bytes_addr(buf)
      rt.mem_set(a, 0, 256)
      let r = sys_darwin.gethostname(a, 255)
      var n = 0
      if r == 0 {
        while n < 255 && rt.mem_load(a, n, 1) != 0 {
          n += 1
        }
      }
      let s = buf[0..n].to_str() ?? ""
      raw.alive(buf)
      s
    }
    TargetOs.Linux => {
      // uname (160 on arm64, 63 on x86_64): struct utsname's six fields
      // of 65 bytes, the node name second
      let buf = raw.bytes_buf(390)
      let a = raw.bytes_addr(buf)
      rt.mem_set(a, 0, 390)
      let nr = match target.arch {
        TargetArch.Arm64 | TargetArch.Riscv64 => 160
        TargetArch.Amd64 => 63
        TargetArch.Wasm32 => -1
      }
      var n = 0
      if rt.sys6(nr, a, 0, 0, 0, 0, 0) >= 0 {
        while n < 64 && rt.mem_load(a, 65 + n, 1) != 0 {
          n += 1
        }
      }
      let s = buf[65..65 + n].to_str() ?? ""
      raw.alive(buf)
      s
    }
    TargetOs.Windows => windows.hostname()
    TargetOs.FreeBSD => {
      // sysctl kern.hostname (__sysctl 202; CTL_KERN 1, KERN_HOSTNAME 10):
      // the name and its zero, at most 256 bytes
      let buf = raw.bytes_buf(256 + 16)
      let a = raw.bytes_addr(buf)
      rt.mem_set(a, 0, 272)
      let mib = a + 256
      rt.mem_store(mib, 0, 1, 4)
      rt.mem_store(mib, 4, 10, 4)
      let lenp = mib + 8
      rt.mem_store(lenp, 0, 256, 8)
      var n = 0
      if rt.sys6(202, mib, 2, a, lenp, 0, 0) >= 0 {
        while n < 255 && rt.mem_load(a, n, 1) != 0 {
          n += 1
        }
      }
      let s = buf[0..n].to_str() ?? ""
      raw.alive(buf)
      s
    }
    TargetOs.Wasi => ""
  }
}
