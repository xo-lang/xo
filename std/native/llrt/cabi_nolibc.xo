// The C ABI exports of programs linked with no C library (XO_NOLIBC=1,
// decision 0206 stage 2; decisions 0204 and 0207's export mechanism),
// as xo_x_<name>: the process start that std/llrt/xo_nolibc.c's _start
// calls. The SSA builders build this module only for an XO_NOLIBC build
// (its C is compiled only then). The C library itself is cabi_libc.xo's
// (bare C names); its work lives in plain modules (libc*.xo), since every
// top level function here is an export and an xo_x_ name must not repeat
// another cabi module's (cabi.xo's mutex_lock is Mutex[T]'s). None may
// fault or allocate: they run before the main thread has its thread
// pointer.
use native/llrt/libcio
use native/llrt/libcthr
use native/llrt/linux
use native/rt

// ---------------------------------------------------------------------------
// The process start (xo_nolibc.c's _start, before the main thread has its
// thread pointer; libcio.xo, the zero-C audit's B04)

/// Records the environment and the auxiliary vector of the initial stack
/// at sp and makes the standard streams, and sets the C library's data
/// symbols environ, stdin, stdout, and stderr, which the emitters define
/// (decision 0234): envp.
fn nl_start(sp: Int) -> Int {
  let env = libcio.start(sp)
  rt.mem_store(rt.sym_addr("environ"), 0, env, 8)
  rt.mem_store(rt.sym_addr("stdin"), 0, libcio.std_file(0), 8)
  rt.mem_store(rt.sym_addr("stdout"), 0, libcio.std_file(1), 8)
  rt.mem_store(rt.sym_addr("stderr"), 0, libcio.std_file(2), 8)
  env
}

/// The FILE record of standard stream i, for the C's stdin, stdout, and
/// stderr.
fn nl_std(i: Int) -> Int { libcio.std_file(i) }

/// Maps and lays out the main thread's TLS block: its thread pointer,
/// which x86_64 sets here (arch_prctl ARCH_SET_FS) and arm64 in the C
/// (msr tpidr_el0, a register no system call writes).
fn nl_main_tp() -> Int {
  // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
  let area = linux.mmap(0, libcthr.tls_size(), 3, 34, -1, 0)
  if area < 0 && area > -4096 {
    libcio.die("mmap of the TLS block failed")
  }
  let tp = libcthr.tls_init(area)
  match target.arch {
    TargetArch.Amd64 => {
      let _r = rt.sys6(158, 4098, tp, 0, 0, 0, 0)
    }
    TargetArch.Arm64 | TargetArch.Wasm32 => {}
  }
  tp
}

/// The top of a 1 GiB stack for the program's main (the runtime runs it
/// on a thread with one, and this thread waits for it), or 0.
fn nl_main_stack() -> Int {
  let gb = 1073741824
  // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE
  let st = linux.mmap(0, gb, 3, 16418, -1, 0)
  if st < 0 && st > -4096 {
    return 0
  }
  st + gb
}
