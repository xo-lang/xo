// Helpers over the raw memory intrinsics (decision 0207) for the runtime
// modules: text handed to and from the C runtime as an address and a
// length. Unchecked like the intrinsics: the C caller guarantees the
// sizes (a buffer large enough for what is written, n readable bytes).
use native/rt

/// The address of the first byte of s (its string object's data).
pub fn data(s: Str) -> Int { rt.int_wrap(0, rt.obj_addr(s), rt.layout(0)) }

/// The address of b's first byte (valid while b is alive; the kernel may
/// write there only when b is unique, as bytes_buf's are). Bytes and Str
/// are one type to the SSA builders, so rt.cast is no instruction.
pub fn bytes_addr(b: Bytes) -> Int { rt.obj_addr(rt.cast[Bytes, Str](b)) + rt.layout(0) }

/// n, after a fault when it is past the 4 GiB a Str or Bytes holds (its
/// length is 32 bits of its second word, decision 0330): rs_set_len
/// keeps the low 32 bits, so a longer result came out silently cut (a
/// 4.3 GB join lost its end; gotchas/str-over-4gib-truncated.md).
pub fn len_ok(n: Int) -> Int {
  if n > 4294967295 {
    fault("Str or Bytes longer than 4 GiB (4294967295 bytes)")
  }
  n
}

/// A unique Bytes of n bytes (none for n < 0) for a system call to fill
/// (not zeroed: what the call does not fill is cut off with bytes_len, or
/// written first).
pub fn bytes_buf(n: Int) -> Bytes {
  let k = if n < 0 { 0 } else { len_ok(n) }
  rt.cast[Str, Bytes](rt.rs_set_len(rt.rs_with_cap(k), k))
}

/// b with its length set to n, clamped to 0 and b's capacity, consuming
/// b: the bytes a read filled, without a copy. The capacity is read at
/// the width of a count (rt.layout(7)): wasm keeps an i32 capacity
/// before the bytes, and a word read there turned a TLS plaintext
/// starting with a byte of 128 or more into a negative capacity and the
/// record's data into nothing (the tls13 goldens on wasm, 2026-10-21).
pub fn bytes_len(b: Bytes, n: Int) -> Bytes {
  let s = rt.cast[Bytes, Str](b)
  let cap = rt.mem_load(rt.obj_addr(s), rt.layout(1), rt.layout(7))
  let k = if n < 0 { 0 } else if n > cap { cap } else { n }
  rt.cast[Str, Bytes](rt.rs_set_len(s, k))
}

/// Writes the bytes of s at address a, then a zero byte; the length of s.
pub fn put_cstr(a: Int, s: Str) -> Int {
  let n = s.len()
  rt.mem_copy(a, data(s), n)
  rt.mem_store(a, n, 0, 1)
  n
}

/// A new string of the n bytes at address a.
pub fn str_at(a: Int, n: Int) -> Str {
  let s = rt.rs_set_len(rt.rs_with_cap(len_ok(n)), n)
  rt.mem_copy(data(s), a, n)
  s
}

/// The string of the byte b (0 to 255).
pub fn byte_str(b: Int) -> Str {
  let s = rt.rs_set_len(rt.rs_with_cap(1), 1)
  rt.mem_store(data(s), 0, b, 1)
  s
}

/// A string of n copies of the byte b.
pub fn fill(b: Int, n: Int) -> Str {
  let s = rt.rs_set_len(rt.rs_with_cap(len_ok(n)), n)
  rt.mem_set(data(s), b, n)
  s
}

/// Whether the n bytes at a and at b are equal.
pub fn mem_eq(a: Int, b: Int, n: Int) -> Bool { n == 0 || rt.mem_cmp(a, b, n) == 0 }

/// The byte at address a + i (0 to 255).
pub fn byte_at(a: Int, i: Int) -> Int { rt.mem_load(a, i, 1) }

/// The length of the zero terminated bytes at address a (strlen).
pub fn cstr_len(a: Int) -> Int {
  var i = 0
  while rt.mem_load(a, i, 1) != 0 {
    i += 1
  }
  i
}

/// A list of n zeros in one allocation (decision 0207 stage 2): the
/// list of List.with_capacity(n), its elements set with one mem_set and
/// its length stored, instead of n pushes (calloc's role in the C).
/// n <= 0 is the empty list.
pub fn zero_ints(n: Int) -> List[Int] {
  if n <= 0 {
    return []
  }
  let xs = List[Int].with_capacity(n)
  let a = rt.obj_addr(xs)
  rt.mem_set(a + rt.layout(2), 0, n * 8)
  // the length word: 8 bytes on the native targets, 4 on wasm
  if rt.layout(6) == 8 {
    rt.mem_store(a, rt.layout(3), n, 8)
  } else {
    rt.mem_store(a, rt.layout(3), n, 4)
  }
  xs
}

/// The malloc'd block at b (0: none) that is used from its malloc'd
/// address (rt.heap_large(n) - 8, a block the C frees) grown to n bytes,
/// at its new malloc'd address: rt.heap_large_resize, with the first word
/// restored, which the resize overwrites with the large block prefix
/// (gotchas/heap-large-resize-overwrites-word-0.md).
pub fn c_resize(b: Int, n: Int) -> Int {
  if b == 0 {
    return rt.heap_large(n) - 8
  }
  let w = rt.mem_load(b, 0, 8)
  let a = rt.heap_large_resize(b, n) - 8
  rt.mem_store(a, 0, w, 8)
  a
}

// ---------------------------------------------------------------------------
// Strings (was std/llrt/xo_std.c and xo_bytes.c: the C behind rt.str_byte,
// str_slice, str_join, str_of_byte, bytes_decode)

/// utf8.DecodeRune of b from i (i < b.len()): the rune times 8 plus its
/// size; an invalid byte is U+FFFD of size 1.
pub fn decode(b: Bytes, i: Int) -> Int {
  let n = b.len()
  let c = Int(b[i])
  if c < 0x80 {
    return (c << 3) | 1
  }
  var k = 0
  var lo = 0x80
  var hi = 0xBF
  var r = 0
  if c >= 0xC2 && c <= 0xDF {
    k = 1
    r = c & 0x1F
  } else if c >= 0xE0 && c <= 0xEF {
    k = 2
    r = c & 0x0F
    if c == 0xE0 {
      lo = 0xA0
    } else if c == 0xED {
      hi = 0x9F
    }
  } else if c >= 0xF0 && c <= 0xF4 {
    k = 3
    r = c & 0x07
    if c == 0xF0 {
      lo = 0x90
    } else if c == 0xF4 {
      hi = 0x8F
    }
  } else {
    return (0xFFFD << 3) | 1
  }
  if i + k >= n {
    return (0xFFFD << 3) | 1
  }
  let c1 = Int(b[i + 1])
  if c1 < lo || c1 > hi {
    return (0xFFFD << 3) | 1
  }
  r = (r << 6) | (c1 & 0x3F)
  var j = 2
  while j <= k {
    let cj = Int(b[i + j])
    if cj < 0x80 || cj > 0xBF {
      return (0xFFFD << 3) | 1
    }
    r = (r << 6) | (cj & 0x3F)
    j += 1
  }
  (r << 3) | (k + 1)
}

/// utf8.DecodeRune of the bytes of b from i: the rune times 8 plus its
/// size (U+FFFD and 0 at the end).
pub fn bytes_decode(b: Bytes, i: Int) -> Int {
  if i >= b.len() {
    return 0xFFFD << 3
  }
  decode(b, i)
}

/// The byte i of s, or -1 out of range.
pub fn str_byte(s: Str, i: Int) -> Int {
  if i < 0 || i >= s.len() {
    return -1
  }
  rt.mem_load(data(s), i, 1)
}

/// The bytes lo..hi of s, the range clamped to s.
pub fn str_slice(s: Str, lo0: Int, hi0: Int) -> Str {
  let n = s.len()
  let lo = if lo0 < 0 { 0 } else { lo0 }
  var hi = if hi0 > n { n } else { hi0 }
  if hi < lo {
    hi = lo
  }
  // a view of s (decision 0330) when both ends are on UTF-8 boundaries, as
  // `s[lo..hi]` requires; a cut inside a sequence (callers slice bytes,
  // and a Str may hold an invalid one) still copies
  let d = data(s)
  if (lo < n && (rt.mem_load(d, lo, 1) & 0xC0) == 0x80) || (hi < n && (rt.mem_load(d, hi, 1) & 0xC0) == 0x80) {
    return str_at(d + lo, hi - lo)
  }
  s[lo..hi]
}

/// str_slice for a range the caller knows is 0 <= lo <= hi <= s.len():
/// no clamp and no second range check; a view when both ends are on
/// UTF-8 boundaries, else a copy (as str_slice).
pub fn str_cut(s: Str, lo: Int, hi: Int) -> Str {
  let n = s.len()
  let d = data(s)
  if (lo < n && (rt.mem_load(d, lo, 1) & 0xC0) == 0x80) || (hi < n && (rt.mem_load(d, hi, 1) & 0xC0) == 0x80) {
    return str_at(d + lo, hi - lo)
  }
  rt.str_view(s, lo, hi)
}

/// str_at for a range of an existing Str (n is under the 4 GiB a Str holds,
/// so no length check, and no fault: a caller stays inlinable).
fn str_copy(a: Int, n: Int) -> Str {
  let s = rt.rs_set_len(rt.rs_with_cap(n), n)
  rt.mem_copy(data(s), a, n)
  s
}

/// str_cut(s, lo, s.len()) for 0 <= lo <= s.len(): one boundary test (the
/// end is the string's end).
pub fn str_from(s: Str, lo: Int) -> Str {
  if lo < s.len() && (rt.mem_load(data(s), lo, 1) & 0xC0) == 0x80 {
    return str_copy(rt.int_wrap(0, data(s), lo), rt.int_wrap(1, s.len(), lo))
  }
  rt.str_view(s, lo, s.len())
}

/// str_cut(s, 0, hi) for 0 <= hi <= s.len(): one boundary test (the start
/// is the string's start).
pub fn str_upto(s: Str, hi: Int) -> Str {
  if hi < s.len() && (rt.mem_load(data(s), hi, 1) & 0xC0) == 0x80 {
    return str_copy(data(s), hi)
  }
  rt.str_view(s, 0, hi)
}

/// The elements of xs with sep between them.
pub fn str_join(xs: List[Str], sep: Str) -> Str {
  var total = 0
  for (i, x) in xs.indexed() {
    total += x.len() + (if i > 0 { sep.len() } else { 0 })
  }
  if total > 4294967295 {
    fault("strings: Join output over 4 GiB")
  }
  let s = rt.rs_set_len(rt.rs_with_cap(total), total)
  let d = data(s)
  var o = 0
  for (i, x) in xs.indexed() {
    if i > 0 {
      rt.mem_copy(d + o, data(sep), sep.len())
      o += sep.len()
    }
    rt.mem_copy(d + o, data(x), x.len())
    o += x.len()
  }
  s
}

/// n copies of s (strings.Repeat).
pub fn str_repeat(s: Str, k: Int) -> Str {
  let n = s.len()
  if k <= 0 || n == 0 {
    return ""
  }
  if n > 9223372036854775807 / k {
    fault("strings: Repeat output length overflow")
  }
  if n * k > 4294967295 {
    fault("strings: Repeat output over 4 GiB")
  }
  let out = rt.rs_set_len(rt.rs_with_cap(n * k), n * k)
  let d = data(out)
  for i in 0..k {
    rt.mem_copy(d + i * n, data(s), n)
  }
  out
}

/// s + the UTF-8 of r, U+FFFD when r is not a scalar value
/// (BytesBuilder.write_rune, utf8.AppendRune; xo_bytes.c's
/// xo_rs_push_rune before).
pub fn push_rune(s: Str, r0: Int) -> Str {
  var r = r0
  if r < 0 || r > 0x10FFFF || (r >= 0xD800 && r <= 0xDFFF) {
    r = 0xFFFD
  }
  if r < 0x80 {
    return rt.rs_push_byte(s, r)
  }
  if r < 0x800 {
    return rt.rs_push_word(s, (0xC0 | (r >> 6)) | ((0x80 | (r & 0x3F)) << 8), 2)
  }
  if r < 0x10000 {
    return rt.rs_push_word(s, (0xE0 | (r >> 12)) | ((0x80 | ((r >> 6) & 0x3F)) << 8) | ((0x80 | (r & 0x3F)) << 16), 3)
  }
  rt.rs_push_word(s, (0xF0 | (r >> 18)) | ((0x80 | ((r >> 12) & 0x3F)) << 8) | ((0x80 | ((r >> 6) & 0x3F)) << 16) | ((0x80 | (r & 0x3F)) << 24), 4)
}

/// Uses b so that a raw address into it (bytes_addr) stays valid up to
/// here: a value is released right after its last use, even inside the
/// arguments of the call that uses its address (gotchas
/// raw-address-outlives-bytes.md).
pub fn alive(b: Bytes) {
  if b.len() < 0 {
    return
  }
}

/// alive for a Str (data).
pub fn alive_str(s: Str) {
  if s.len() < 0 {
    return
  }
}

/// The bytes one read(2) or write(2) of n bytes may ask for: at most a
/// chunk (1 GiB; static word 47 when a test set it, std/internal
/// rt_probe "io_chunk"). macOS refuses a count above INT_MAX (EINVAL) and
/// Linux moves at most about 2 GiB a call, so a larger transfer goes in
/// chunks; every caller loops on short counts.
pub fn io_len(n: Int) -> Int {
  let set = rt.mem_load(rt.static_word(47), 0, 8)
  let c = if set > 0 { set } else { 1073741824 }
  if n > c { c } else { n }
}

/// Sets io_len's chunk size (a test's, std/internal rt_probe "io_chunk";
/// 0 restores 1 GiB).
pub fn set_io_chunk(c: Int) {
  rt.mem_store(rt.static_word(47), 0, c, 8)
}
