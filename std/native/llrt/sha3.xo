// SHA-3 (FIPS 202) for ML-KEM (the zero-C audit's B31, decision 0202):
// Keccak-f[1600] on 25 lanes of 64 bits, the sponge, SHA3-256 and
// SHA3-512, and the extendable output functions SHAKE128 and SHAKE256
// read in pieces (Go's crypto/internal/fips140/sha3). Nothing here
// branches on or indexes by the data.
use native/rt

/// A sponge: the 25 lanes, its rate in bytes, its domain separator
/// (0x06 SHA-3, 0x1f SHAKE), the bytes absorbed into the current block
/// (absorbing) or left to squeeze from it (squeezing).
pub struct Sponge {
  lanes: List[Int]
  rate: Int
  dsbyte: Int
  pos: Int
  squeezing: Bool
}

/// The round constants (FIPS 202 3.2.5), as signed 64 bit values.
const RCS: List[Int] = [1, 32898, -9223372036854742902, -9223372034707259392, 32907, 2147483649, -9223372034707259263, -9223372036854743031, 138, 136, 2147516425, 2147483658, 2147516555, -9223372036854775669, -9223372036854742903, -9223372036854743037, -9223372036854743038, -9223372036854775680, 32778, -9223372034707292150, -9223372034707259263, -9223372036854742912, 2147483649, -9223372034707259384]

