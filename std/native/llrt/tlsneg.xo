// What a TLS handshake negotiated, as a request's tls_state reads it
// (std/native/http.xo, Go's ConnectionState). A leaf module: tlssrv.xo
// fills one, and http.xo names only this type when it reads it through
// the TLS table (hconn.xo TO_NEG), so a plain server links no tlssrv
// (decision 0244, internal/llvm TestTLSLinkedOnlyWithTLS).

/// The version, the suite's name (Go's CipherSuiteName), the server name
/// the client asked for and whether a session resumed.
/// What a ClientHello offers (Go's ClientHelloInfo, decision 0644 T5):
/// its suites, server name, groups, point formats, signature schemes,
/// ALPN protocols, versions (from the legacy version when it sent none)
/// and extension types in order.
pub struct HelloInfo {
  pub suites: List[Int]
  pub server_name: Str
  pub curves: List[Int]
  pub points: List[Int]
  pub schemes: List[Int]
  pub protos: List[Str]
  pub versions: List[Int]
  pub exts: List[Int]
}

pub struct Negotiated {
  pub version: Str
  pub cipher: Str
  pub server_name: Str
  pub resumed: Bool
  /// a client's certificates (DER, the leaf first) and the chains that
  /// verified them (mTLS)
  pub peer: List[Bytes] = []
  pub verified: List[List[Bytes]] = []
  /// the key exchange group's name (Go's CurveID.String), the protocol
  /// ALPN chose ("" for none), and whether a HelloRetryRequest ran
  pub curve: Str = ""
  pub alpn: Str = ""
  pub hrr: Bool = false
  /// the numbers behind version, cipher and curve (Go's Version,
  /// CipherSuite and CurveID)
  pub vers: Int = 0
  pub suite: Int = 0
  pub group: Int = 0
  /// decision 0644 T9: TLS 1.3's exporter_master_secret, or TLS 1.2's
  /// master secret, randoms and Extended Master Secret; tls-unique (TLS
  /// 1.2's first Finished)
  pub exp: Bytes = b""
  pub master: Bytes = b""
  pub cr: Bytes = b""
  pub sr: Bytes = b""
  pub ems: Bool = false
  pub unique: Bytes = b""
  /// decision 0644 T10: the server's OCSP staple and SCTs
  pub ocsp: Bytes = b""
  pub scts: List[Bytes] = []
}

/// Go's tls.CipherSuiteName: every suite Go names (its secure and
/// insecure lists; Xo speaks the TLS 1.3 three and the ECDHE AEAD and
/// CBC-SHA ones), else `0x%04X`.
pub fn suite_name(s: Int) -> Str {
  match s {
    0x0005 => "TLS_RSA_WITH_RC4_128_SHA"
    0x000a => "TLS_RSA_WITH_3DES_EDE_CBC_SHA"
    0x002f => "TLS_RSA_WITH_AES_128_CBC_SHA"
    0x0035 => "TLS_RSA_WITH_AES_256_CBC_SHA"
    0x003c => "TLS_RSA_WITH_AES_128_CBC_SHA256"
    0x009c => "TLS_RSA_WITH_AES_128_GCM_SHA256"
    0x009d => "TLS_RSA_WITH_AES_256_GCM_SHA384"
    0x1301 => "TLS_AES_128_GCM_SHA256"
    0x1302 => "TLS_AES_256_GCM_SHA384"
    0x1303 => "TLS_CHACHA20_POLY1305_SHA256"
    0xc007 => "TLS_ECDHE_ECDSA_WITH_RC4_128_SHA"
    0xc009 => "TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA"
    0xc00a => "TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA"
    0xc011 => "TLS_ECDHE_RSA_WITH_RC4_128_SHA"
    0xc012 => "TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA"
    0xc013 => "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA"
    0xc014 => "TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA"
    0xc023 => "TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256"
    0xc027 => "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256"
    0xc02b => "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
    0xc02c => "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
    0xc02f => "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
    0xc030 => "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
    0xcca8 => "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256"
    0xcca9 => "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256"
    _ => "0x" + hex4(s)
  }
}

/// Go's CurveID.String: the groups Xo speaks, else `CurveID(N)`.
pub fn group_name(g: Int) -> Str {
  match g {
    23 => "CurveP256"
    24 => "CurveP384"
    25 => "CurveP521"
    29 => "X25519"
    0x11ec => "X25519MLKEM768"
    0x11eb => "SecP256r1MLKEM768"
    0x11ed => "SecP384r1MLKEM1024"
    _ => "CurveID(${g})"
  }
}

/// Go's tls.VersionName: SSLv3 to TLS 1.3, else `0x%04X`.
pub fn version_name(v: Int) -> Str {
  match v {
    0x0300 => "SSLv3"
    0x0301 => "TLS 1.0"
    0x0302 => "TLS 1.1"
    0x0303 => "TLS 1.2"
    0x0304 => "TLS 1.3"
    _ => "0x" + hex4(v)
  }
}

/// Four upper case hex digits (Go's %04X of a uint16).
fn hex4(x: Int) -> Str {
  let d = "0123456789ABCDEF"
  var s = ""
  var i = 12
  while i >= 0 {
    let k = (x >> i) & 15
    s = s + d[k..k + 1]
    i -= 4
  }
  s
}

/// all in its order, less what want leaves out (want empty: all; Go's
/// CipherSuites and CurvePreferences, whose orders it ignores).
pub fn only(all: List[Int], want: List[Int]) -> List[Int] {
  if want.is_empty() {
    return all
  }
  var out: List[Int] = []
  for x in all {
    for w in want {
      if w == x {
        out.push(x)
        break
      }
    }
  }
  out
}

/// Why a handshake or a record failed, for std/tls's typed errors
/// (decision 0644 T12): header, the record header (five bytes) of a
/// record layer failure (Go's RecordHeaderError); verify, a failed
/// verification of the peer's certificates (Go's
/// CertificateVerificationError), with x509verify's outcome code, its
/// hint, the host verified and the peer's certificates (DER, leaf first).
pub struct Failure {
  pub header: Bytes? = None
  pub verify: Bool = false
  pub code: Int = 0
  pub hint: Str = ""
  pub host: Str = ""
  pub certs: List[Bytes] = []
}

/// A record layer failure on the input rin (Go's newRecordHeaderError
/// copies the header from its raw input into a [5]byte: zeros past what
/// came).
pub fn header_fail(rin: Bytes) -> Failure {
  let n = if rin.len() < 5 { rin.len() } else { 5 }
  Failure{header: Some(rin[0..n] + b"\x00".repeat(5 - n))}
}

/// A failed verification of certs for host.
pub fn verify_fail(code: Int, hint: Str, host: Str, certs: List[Bytes]) -> Failure { Failure{verify: true, code: code, hint: hint, host: host, certs: certs} }

/// A certificate chain a server hook gives (decision 0644 T5, T10): the
/// DER chain (leaf first), the leaf's key, "" or the hook's error, and
/// Go's Certificate.OCSPStaple and SignedCertificateTimestamps.
pub struct Chain {
  pub certs: List[Bytes]
  pub key: Bytes
  pub err: Str = ""
  pub ocsp: Bytes = b""
  pub scts: List[Bytes] = []
}
