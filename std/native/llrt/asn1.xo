// DER (ITU-T X.690) for TLS (the zero-C audit's B31, decision 0202:
// Go's x/crypto/cryptobyte and encoding/asn1 designs in Xo, replacing
// Mbed TLS's asn1parse and asn1write): reading the elements of a
// certificate, a key, or a signature, and writing the few a TLS stack
// makes. Every input is public, and the reader branches on it.
//
// An element is a Tlv: its tag, its contents b[lo..hi], and the
// position of the element after it. Reading checks DER's rules: one
// tag byte (X.509 needs no high tag numbers), the shortest length form,
// and no length past the end; a failure is the Tlv of tag -1.
use native/llrt/raw
use native/rt

/// An element of b: tag (the identifier byte, -1 when the bytes are not
/// an element), contents lo..hi, the next element at next.
pub struct Tlv {
  pub tag: Int
  pub lo: Int
  pub hi: Int
  pub next: Int
}

// the universal tags
pub const BOOLEAN: Int = 0x01
pub const INTEGER: Int = 0x02
pub const BIT_STRING: Int = 0x03
pub const OCTET_STRING: Int = 0x04
pub const NULL: Int = 0x05
pub const OID: Int = 0x06
pub const UTF8_STRING: Int = 0x0c
pub const PRINTABLE_STRING: Int = 0x13
pub const T61_STRING: Int = 0x14
pub const IA5_STRING: Int = 0x16
pub const UTC_TIME: Int = 0x17
pub const GENERALIZED_TIME: Int = 0x18
pub const BMP_STRING: Int = 0x1e
pub const SEQUENCE: Int = 0x30
pub const SET: Int = 0x31

fn bad() -> Tlv { Tlv{tag: -1, lo: 0, hi: 0, next: 0} }

/// The element of b at pos, which must end by end.
pub fn read(b: Bytes, pos: Int, end: Int) -> Tlv {
  if pos < 0 || pos + 2 > end || end > b.len() {
    return bad()
  }
  let tag = Int(b[pos])
  if (tag & 0x1f) == 0x1f {
    return bad()
  }
  let l0 = Int(b[pos + 1])
  var len = l0
  var lo = pos + 2
  if l0 >= 128 {
    let k = l0 - 128
    // 0x80 (indefinite) is BER, and 4 length bytes are plenty
    if k == 0 || k > 4 || lo + k > end || b[lo] == 0 {
      return bad()
    }
    len = 0
    for i in 0..k {
      len = len * 256 + Int(b[lo + i])
    }
    lo += k
    if len < 128 {
      return bad()
    }
  }
  if len > end - lo {
    return bad()
  }
  Tlv{tag: tag, lo: lo, hi: lo + len, next: lo + len}
}

/// The element of b at pos with the tag; tag -1 when it has another.
pub fn expect(b: Bytes, pos: Int, end: Int, tag: Int) -> Tlv {
  let t = read(b, pos, end)
  if t.tag != tag {
    return bad()
  }
  t
}

/// The element that is all of b.
pub fn whole(b: Bytes, tag: Int) -> Tlv {
  let t = expect(b, 0, b.len(), tag)
  if t.tag >= 0 && t.next != b.len() {
    return bad()
  }
  t
}

/// The elements inside the constructed t; none and ok false when they do
/// not fill it.
pub fn children(b: Bytes, t: Tlv) -> List[Tlv] {
  var out: List[Tlv] = []
  var pos = t.lo
  while pos < t.hi {
    let e = read(b, pos, t.hi)
    if e.tag < 0 {
      return [bad()]
    }
    out.push(e)
    pos = e.next
  }
  out
}

/// Whether some element of xs is bad (children's failure).
pub fn any_bad(xs: List[Tlv]) -> Bool {
  for x in xs {
    if x.tag < 0 {
      return true
    }
  }
  false
}

/// The bytes of t's contents.
pub fn contents(b: Bytes, t: Tlv) -> Bytes { b[t.lo..t.hi] }

/// The bytes of all of t (its tag and length too), which starts at pos.
pub fn raw(b: Bytes, pos: Int, t: Tlv) -> Bytes { b[pos..t.next] }

/// Whether the INTEGER t is minimal (no needless leading 0x00 or 0xff).
fn minimal_int(b: Bytes, t: Tlv) -> Bool {
  if t.hi == t.lo {
    return false
  }
  if t.hi - t.lo > 1 {
    let a = Int(b[t.lo])
    let c = Int(b[t.lo + 1])
    if (a == 0 && c < 128) || (a == 255 && c >= 128) {
      return false
    }
  }
  true
}

/// The magnitude of the non negative INTEGER t (big endian, without the
/// sign's 0x00; one 0x00 for zero); none for a negative or non minimal
/// one.
pub fn uint_bytes(b: Bytes, t: Tlv) -> Bytes? {
  if t.tag != INTEGER || !minimal_int(b, t) || Int(b[t.lo]) >= 128 {
    return None
  }
  if t.hi - t.lo > 1 && b[t.lo] == 0 {
    return Some(b[t.lo + 1..t.hi])
  }
  Some(b[t.lo..t.hi])
}

/// The value of the INTEGER t when it fits 63 bits (signed).
pub fn small_int(b: Bytes, t: Tlv) -> Int? {
  if t.tag != INTEGER || !minimal_int(b, t) || t.hi - t.lo > 8 {
    return None
  }
  var v = if Int(b[t.lo]) >= 128 { -1 } else { 0 }
  for i in t.lo..t.hi {
    v = v.wrapping_shl(8) | Int(b[i])
  }
  Some(v)
}

/// The bytes of the BIT STRING t with no unused bits (keys and
/// signatures).
pub fn bits(b: Bytes, t: Tlv) -> Bytes? {
  if t.tag != BIT_STRING || t.hi == t.lo || b[t.lo] != 0 {
    return None
  }
  Some(b[t.lo + 1..t.hi])
}

/// The dotted text of the OBJECT IDENTIFIER t ("1.2.840.10045.2.1"); ""
/// when it is not one.
pub fn oid(b: Bytes, t: Tlv) -> Str {
  if t.tag != OID || t.hi == t.lo || Int(b[t.hi - 1]) >= 128 {
    return ""
  }
  var out = ""
  var v = 0
  var first = true
  for i in t.lo..t.hi {
    let x = Int(b[i])
    if v == 0 && x == 0x80 {
      return ""
    }
    if v > 0xffffffffffff {
      return ""
    }
    v = v * 128 + (x & 127)
    if x < 128 {
      if first {
        let a = if v < 40 { 0 } else if v < 80 { 1 } else { 2 }
        out = "${a}.${v - 40 * a}"
        first = false
      } else {
        out = "${out}.${v}"
      }
      v = 0
    }
  }
  out
}

/// The text of a directory string (UTF8String, PrintableString,
/// IA5String, T61String as Latin-1, BMPString as UTF-16); none for
/// another tag or a malformed one.
pub fn text(b: Bytes, t: Tlv) -> Str? {
  if t.tag == UTF8_STRING || t.tag == PRINTABLE_STRING || t.tag == IA5_STRING {
    return contents(b, t).to_str()
  }
  if t.tag == T61_STRING {
    var s = ""
    for i in t.lo..t.hi {
      s = raw.push_rune(s, Int(b[i]))
    }
    return Some(s)
  }
  if t.tag == BMP_STRING {
    if (t.hi - t.lo) % 2 != 0 {
      return None
    }
    var s = ""
    var i = t.lo
    while i < t.hi {
      let u = Int(b[i]) * 256 + Int(b[i + 1])
      if u >= 0xd800 && u < 0xe000 {
        return None
      }
      s = raw.push_rune(s, u)
      i += 2
    }
    return Some(s)
  }
  None
}

fn digits(b: Bytes, i: Int, n: Int) -> Int {
  var v = 0
  for k in 0..n {
    let x = Int(b[i + k])
    if x < 48 || x > 57 {
      return -1
    }
    v = v * 10 + x - 48
  }
  v
}

/// The days from 1970-01-01 to the date (the proleptic Gregorian
/// calendar; Howard Hinnant's days_from_civil).
pub fn days(y0: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { y0 - 1 } else { y0 }
  let era = (if y >= 0 { y } else { y - 399 }) / 400
  let yoe = y - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

fn month_days(y: Int, m: Int) -> Int {
  if m == 2 {
    if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  31
}

/// The Unix time in seconds of the UTCTime (YYMMDDHHMMSSZ, 1950 to 2049)
/// or GeneralizedTime (YYYYMMDDHHMMSSZ) t, as RFC 5280 4.1.2.5 allows
/// them.
pub fn time(b: Bytes, t: Tlv) -> Int? {
  let n = t.hi - t.lo
  var y = 0
  var i = t.lo
  if t.tag == UTC_TIME && n == 13 {
    y = digits(b, i, 2)
    if y < 0 {
      return None
    }
    y = if y < 50 { 2000 + y } else { 1900 + y }
    i += 2
  } else if t.tag == GENERALIZED_TIME && n == 15 {
    y = digits(b, i, 4)
    if y < 0 {
      return None
    }
    i += 4
  } else {
    return None
  }
  let mo = digits(b, i, 2)
  let d = digits(b, i + 2, 2)
  let h = digits(b, i + 4, 2)
  let mi = digits(b, i + 6, 2)
  let s = digits(b, i + 8, 2)
  if b[i + 10] != 0x5a || mo < 1 || mo > 12 || d < 1 || d > month_days(y, mo) || h < 0 || h > 23 || mi < 0 || mi > 59 || s < 0 || s > 59 {
    return None
  }
  Some(((days(y, mo, d) * 24 + h) * 60 + mi) * 60 + s)
}

// ---------------------------------------------------------------------------
// Writing

/// The element of the tag around the contents.
pub fn enc(tag: Int, body: Bytes) -> Bytes {
  let n = body.len()
  var s = rt.rs_with_cap(n + 6)
  s = rt.rs_push_byte(s, tag)
  if n < 128 {
    s = rt.rs_push_byte(s, n)
  } else if n < 256 {
    s = rt.rs_push_byte(s, 0x81)
    s = rt.rs_push_byte(s, n)
  } else if n < 65536 {
    s = rt.rs_push_byte(s, 0x82)
    s = rt.rs_push_byte(s, n / 256)
    s = rt.rs_push_byte(s, n % 256)
  } else {
    s = rt.rs_push_byte(s, 0x83)
    s = rt.rs_push_byte(s, n / 65536)
    s = rt.rs_push_byte(s, (n / 256) % 256)
    s = rt.rs_push_byte(s, n % 256)
  }
  rt.rs_append_bytes(s, body, 0, n, 0).bytes()
}

/// The INTEGER of the unsigned big endian magnitude m.
pub fn enc_uint(m: Bytes) -> Bytes {
  var a = 0
  while a < m.len() - 1 && m[a] == 0 {
    a += 1
  }
  var s = rt.rs_with_cap(m.len() - a + 1)
  if m.len() == 0 || Int(m[a]) >= 128 {
    s = rt.rs_push_byte(s, 0)
  }
  if m.len() > 0 {
    s = rt.rs_append_bytes(s, m, a, m.len(), 0)
  }
  enc(INTEGER, s.bytes())
}

/// The concatenation of the parts.
pub fn cat(parts: List[Bytes]) -> Bytes {
  var n = 0
  for p in parts {
    n += p.len()
  }
  var s = rt.rs_with_cap(n)
  for p in parts {
    s = rt.rs_append_bytes(s, p, 0, p.len(), 0)
  }
  s.bytes()
}

// Writing certificates and keys (std/x509's create functions; Go's
// cryptobyte.Builder and encoding/asn1 Marshal)

/// A SEQUENCE of parts, in order.
pub fn enc_seq(parts: List[Bytes]) -> Bytes { enc(SEQUENCE, cat(parts)) }

/// A SET OF parts: DER orders the encodings (X.690 11.6).
pub fn enc_set_of(parts: List[Bytes]) -> Bytes { enc(SET, cat(parts.sort())) }

/// [n] EXPLICIT around inner.
pub fn enc_explicit(n: Int, inner: Bytes) -> Bytes { enc(0xa0 | n, inner) }

/// [n] IMPLICIT of a primitive body.
pub fn enc_implicit(n: Int, body: Bytes) -> Bytes { enc(0x80 | n, body) }

/// [n] IMPLICIT of a constructed body (parts).
pub fn enc_implicit_seq(n: Int, parts: List[Bytes]) -> Bytes { enc(0xa0 | n, cat(parts)) }

pub fn enc_bool(v: Bool) -> Bytes { enc(BOOLEAN, if v { b"\xff" } else { b"\x00" }) }

pub fn enc_null() -> Bytes { b"\x05\x00" }

/// The INTEGER n (n >= 0).
pub fn enc_int(n: Int) -> Bytes {
  var b: List[Int] = []
  var m = n
  while m > 0 {
    b.push(m & 255)
    m = m >> 8
  }
  var out = BytesBuilder.with_capacity(b.len())
  var i = b.len() - 1
  while i >= 0 {
    out.write_byte(UInt8(b[i]))
    i -= 1
  }
  enc_uint(out.freeze())
}

/// The OBJECT IDENTIFIER of dotted ("2.5.4.3"); None when it is not one.
pub fn enc_oid(dotted: Str) -> Bytes? {
  let ps = dotted.split(".")
  if ps.len() < 2 {
    return None
  }
  var arcs: List[Int] = []
  for p in ps {
    // decimal digits only, at most 18 (an arc fits an Int)
    if p.is_empty() || p.len() > 18 {
      return None
    }
    var v = 0
    for x in p.bytes() {
      if Int(x) < 48 || Int(x) > 57 {
        return None
      }
      v = v * 10 + (Int(x) - 48)
    }
    arcs.push(v)
  }
  if arcs[0] > 2 || (arcs[0] < 2 && arcs[1] >= 40) {
    return None
  }
  var b = BytesBuilder.with_capacity(ps.len() * 2)
  base128(b, arcs[0] * 40 + arcs[1])
  for a in arcs[2..arcs.len()] {
    base128(b, a)
  }
  Some(enc(OID, b.freeze()))
}

fn base128(var b: BytesBuilder, v: Int) {
  var k = 0
  var m = v
  while m > 0 || k == 0 {
    k += 1
    m = m >> 7
  }
  var i = k - 1
  while i >= 0 {
    let x = (v >> (7 * i)) & 127
    b.write_byte(UInt8(if i > 0 { x | 128 } else { x }))
    i -= 1
  }
}

pub fn enc_octets(v: Bytes) -> Bytes { enc(OCTET_STRING, v) }

/// A BIT STRING of whole bytes.
pub fn enc_bits(v: Bytes) -> Bytes { enc(BIT_STRING, b"\x00" + v) }

/// A BIT STRING of flags (bit 0 first, as KeyUsage), DER's trailing zero
/// bits dropped.
pub fn enc_flag_bits(flags: Int) -> Bytes {
  if flags == 0 {
    return enc(BIT_STRING, b"\x00")
  }
  var top = 0
  for i in 0..16 {
    if (flags & (1 << i)) != 0 {
      top = i
    }
  }
  let n = top / 8 + 1
  var b = BytesBuilder.with_capacity(n + 1)
  b.write_byte(UInt8(7 - top % 8))
  for k in 0..n {
    var x = 0
    for j in 0..8 {
      if (flags & (1 << (k * 8 + j))) != 0 {
        x = x | (128 >> j)
      }
    }
    b.write_byte(UInt8(x))
  }
  enc(BIT_STRING, b.freeze())
}

/// encoding/asn1's choice for a Go string (Marshal rejects * and &): PrintableString when every
/// character is one, else UTF8String.
pub fn enc_string(s: Str) -> Bytes {
  // non-ASCII bytes are not printable, so bytes stand for runes
  for x in s.bytes() {
    let c = Int(x)
    if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || (c >= 39 && c <= 41) || (c >= 43 && c <= 47) || c == 32 || c == 58 || c == 61 || c == 63) {
      return enc(UTF8_STRING, s.bytes())
    }
  }
  enc(PRINTABLE_STRING, s.bytes())
}

pub fn enc_ia5(s: Str) -> Bytes { enc(IA5_STRING, s.bytes()) }

/// The civil date of days since 1970-01-01 (proleptic Gregorian).
fn civil(z0: Int) -> (Int, Int, Int) {
  let z = z0 + 719468
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  (y, m, d)
}

fn two(n: Int) -> Str { if n < 10 { "0${n}" } else { "${n}" } }

/// RFC 5280 4.1.2.5's time of Unix seconds: UTCTime through 2049,
/// GeneralizedTime from 2050 and before 1950.
pub fn enc_time(secs: Int) -> Bytes {
  let days = if secs >= 0 { secs / 86400 } else { (secs - 86399) / 86400 }
  let rest = secs - days * 86400
  let (y, m, d) = civil(days)
  let hms = "${two(m)}${two(d)}${two(rest / 3600)}${two(rest / 60 % 60)}${two(rest % 60)}Z"
  if y >= 1950 && y < 2050 {
    return enc(UTC_TIME, "${two(y % 100)}${hms}".bytes())
  }
  let ys = "${y}"
  enc(GENERALIZED_TIME, "${"0000"[0..4 - ys.len()]}${ys}${hms}".bytes())
}
