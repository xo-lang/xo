// BLAKE2b (RFC 7693) and BLAKE2Xb as golang.org/x/crypto v0.58.0's
// blake2b package computes them (blake2b.go, blake2x.go; Copyright 2016
// and 2017 The Go Authors, BSD-style license): a streaming digest of 1
// to 64 bytes with an optional key of up to 64 bytes, Go's
// MarshalBinary state, and the extendable output function. The
// compression is digest_tables.blake2b_compress, the one Argon2's
// one shot digest.blake2b uses. std/native/crypto.xo calls these.
use native/llrt/digest_tables
use native/rt

/// The block size and the largest digest size in bytes (Go's BlockSize
/// and Size).
pub const BLOCK: Int = 128
pub const SIZE: Int = 64

/// Go's OutputLengthUnknown magic: an XOF of this length reads up to
/// 2^32 blocks of 64 bytes.
pub const XOF_UNKNOWN: Int = 0xFFFFFFFF

/// A digest being computed, as Go's digest struct: the state words, the
/// bytes compressed so far (Go's counter c[0]; its high word c[1] stays 0
/// below 2^64 bytes), the 128 byte block (bytes past `offset` are what
/// the block held before, kept for MarshalBinary), the digest size, and
/// the key (empty for a plain hash).
pub struct State {
  h: List[Int]
  t: Int
  block: Bytes
  offset: Int
  out: Int
  key: Bytes
}

/// A block of zeros, the padding of a short block.
const ZEROS: Bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// b[lo..hi] zero padded to a block.
fn padded(b: Bytes, lo: Int, hi: Int) -> Bytes {
  var o = BytesBuilder.with_capacity(BLOCK)
  o.write(b[lo..hi])
  o.write(ZEROS[0..BLOCK - (hi - lo)])
  o.freeze()
}

/// The key zero padded to a block (an empty key: a block of zeros).
fn key_block(key: Bytes) -> Bytes { padded(key, 0, key.len()) }

/// The initial words for a digest of `size` bytes keyed with `klen` bytes
/// (Go's Reset: the parameter block's first word, fanout and depth 1).
fn init_words(size: Int, klen: Int) -> List[Int] {
  var h = digest_tables.blake2b_iv()
  h[0] = h[0] ^ (size | klen.wrapping_shl(8) | 0x01010000)
  h
}

/// A new digest (Go's New(size, key) after its checks: size 1 to 64, key
/// at most 64 bytes, which the caller checked). A keyed digest starts
/// with the key's block held, as Go's Reset.
pub fn new(size: Int, key: Bytes) -> State {
  let keyed = key.len() > 0
  State{h: init_words(size, key.len()), t: 0, block: key_block(key), offset: if keyed { BLOCK } else { 0 }, out: size, key: key}
}

/// The digest size in bytes.
pub fn (s: State) size() -> Int { s.out }

/// Whether the digest is keyed (a MAC).
pub fn (s: State) keyed() -> Bool { s.key.len() > 0 }

/// The message bytes written: the counter and the held bytes, less the
/// key's block for a keyed digest.
pub fn (s: State) written() -> Int {
  let n = s.t + s.offset
  if s.key.len() > 0 { n - BLOCK } else { n }
}

/// The block with b[lo..hi] copied in at `at` (Go's copy into d.block).
/// A keyed digest's held block may be shorter than BLOCK (a view of the
/// last write's tail, see write); what it lacks reads as zeros.
fn put_block(blk: Bytes, at: Int, b: Bytes, lo: Int, hi: Int) -> Bytes {
  var o = BytesBuilder.with_capacity(BLOCK)
  o.write(blk[0..at])
  o.write(b[lo..hi])
  let e = at + hi - lo
  if e < blk.len() {
    o.write(blk[e..blk.len()])
  }
  let k = o.len()
  if k < BLOCK {
    o.write(ZEROS[0..BLOCK - k])
  }
  o.freeze()
}

/// Hashes p after what was written (Go's digest.Write): a full block is
/// held, not compressed, until more data follows it, since the last block
/// is compressed with the final flag.
pub fn (var s: State) write(p: Bytes) {
  var h = s.h
  var i = 0
  let n = p.len()
  if s.offset > 0 {
    let remaining = BLOCK - s.offset
    if n <= remaining {
      s.block = put_block(s.block, s.offset, p, 0, n)
      s.offset += n
      return
    }
    // a full block (a keyed digest's key block, the usual case) takes no
    // copy: a 128 byte allocation per keyed message (bench/perf/blake2b
    // keyed 1.177 of Go, 2026-11-16)
    if remaining > 0 {
      s.block = put_block(s.block, s.offset, p, 0, remaining)
    }
    s.t = s.t.wrapping_add(BLOCK)
    digest_tables.blake2b_compress(h, s.block, 0, s.t, false)
    s.offset = 0
    i = remaining
  }
  let left = n - i
  if left > BLOCK {
    var nn = left & -BLOCK
    if left == nn {
      nn -= BLOCK
    }
    let end = i + nn
    while i < end {
      s.t = s.t.wrapping_add(BLOCK)
      digest_tables.blake2b_compress(h, p, i, s.t, false)
      i += BLOCK
    }
  }
  if i < n {
    // a keyed digest holds the tail as a view of p: it has no binary
    // state (Go's "cannot marshal MACs"), so the bytes past offset that
    // Go keeps are never seen, and a keyed message of one block takes no
    // copy (bench/perf/blake2b keyed, 2026-11-16)
    s.block = if s.key.len() > 0 { p[i..n] } else { put_block(s.block, 0, p, i, n) }
    s.offset += n - i
  }
  s.h = h
}

/// The 8 words of a final compression of the held bytes (Go's finalize):
/// the state is not changed, so more can be written.
fn final_words(s: State) -> List[Int] {
  var h = s.h
  // a copy: the compression's index stores copy the shared words
  h[0] = h[0]
  digest_tables.blake2b_compress_n(h, s.block, 0, s.offset, s.t.wrapping_add(s.offset), true)
  h
}

/// The first n bytes of the words, little endian.
fn le_out(h: List[Int], n: Int) -> Bytes {
  // the n bytes alone, four words a call, into one string of n bytes (a
  // BytesBuilder wrote all 64 and sliced; bench/perf/blake2b small,
  // 2026-11-19)
  if n & 7 == 0 {
    // whole words (BLAKE2b-256, -384, -512): inline stores, no call
    // (task #448: rs_push_words was about a twentieth of a short hash,
    // callgrind, 2026-11-19)
    var t = rt.rs_with_cap(n)
    for i in 0..n >> 3 {
      t = rt.rs_put_word(t, 8 * i, h[i])
    }
    return rt.rs_set_len(t, n).bytes()
  }
  var s = rt.rs_with_cap(n)
  var k = 0
  while k * 8 < n {
    var lens = 0
    for j in 0..4 {
      let r = n - (k + j) * 8
      let l = if r >= 8 { 8 } else if r > 0 { r } else { 0 }
      lens = lens | l.wrapping_shl(4 * j)
    }
    s = rt.rs_push_words(s, h[k], h[k + 1], h[k + 2], h[k + 3], lens)
    k += 4
  }
  s.bytes()
}

/// The digest of what was written (Go's Sum); writing may continue.
pub fn (s: State) sum() -> Bytes { le_out(final_words(s), s.out) }

/// The digest of data, size bytes, unkeyed (Go's Sum256, Sum384, Sum512
/// and checkSum).
/// One shot, with no State: the blocks are compressed where they lie in
/// data and only a short last block is copied, padded (Go's checkSum
/// keeps its digest on the stack; the State's block copies cost a short
/// message twice Go's time, bench/perf/blake2b small, 2026-11-15).
pub fn sum(data: Bytes, size: Int) -> Bytes {
  var h = init_words(size, 0)
  let n = data.len()
  var i = 0
  // every block but the last, which takes the final flag
  while n - i > BLOCK {
    digest_tables.blake2b_compress(h, data, i, i + BLOCK, false)
    i += BLOCK
  }
  if n - i == BLOCK {
    digest_tables.blake2b_compress(h, data, i, n, true)
  } else {
    digest_tables.blake2b_compress_n(h, data, i, n - i, n, true)
  }
  le_out(h, size)
}

// ---------------------------------------------------------------------------
// Go's MarshalBinary: "b2b", the 8 words, the counter's two words (all big
// endian), the size byte, the 128 byte block, the offset byte.

const MAGIC: Bytes = b"b2b"
pub const MARSHALED_SIZE: Int = 3 + 64 + 16 + 1 + BLOCK + 1

/// The state in Go's format (the caller refuses a keyed digest, as Go:
/// `crypto/blake2b: cannot marshal MACs`).
pub fn marshal(s: State) -> Bytes {
  var b = BytesBuilder.with_capacity(MARSHALED_SIZE)
  b.write(MAGIC)
  for w in s.h {
    b.write_be(w, 8)
  }
  b.write_be(s.t, 8)
  b.write_be(0, 8)
  b.write_byte(UInt8(s.out))
  b.write(s.block)
  b.write_byte(UInt8(s.offset))
  b.freeze()
}

fn be64(b: Bytes, i: Int) -> Int {
  var v = 0
  for j in 0..8 {
    v = v.wrapping_shl(8) | Int(b[i + j])
  }
  v
}

/// Go's UnmarshalBinary into s (its key kept, as Go's keeps keyLen and
/// key): the state, or Go's error. A size outside 1 to 64 or an offset
/// past the block, which Go accepts and then panics on, are the size
/// error here; a counter high word other than 0 (2^64 bytes) is dropped.
pub fn unmarshal(s: State, b: Bytes) -> State ! Str {
  if b.len() < 3 || b[0..3] != MAGIC {
    return Err("crypto/blake2b: invalid hash state identifier")
  }
  if b.len() != MARSHALED_SIZE {
    return Err("crypto/blake2b: invalid hash state size")
  }
  var h: List[Int] = []
  for i in 0..8 {
    h.push(be64(b, 3 + 8 * i))
  }
  let t = be64(b, 67)
  let size = Int(b[83])
  let offset = Int(b[84 + BLOCK])
  if size < 1 || size > SIZE || offset > BLOCK {
    return Err("crypto/blake2b: invalid hash state size")
  }
  Ok(State{h: h, t: t, block: b[84..84 + BLOCK], offset: offset, out: size, key: s.key})
}

// ---------------------------------------------------------------------------
// BLAKE2Xb (Go's blake2x.go): the root digest of 64 bytes with the XOF
// length in its parameter block, then each 64 byte output block a BLAKE2b
// of the root under a parameter block naming the node.

/// An extendable output (Go's xof): the root digest, the output length
/// (XOF_UNKNOWN for an unknown one), the bytes left to read, the root's
/// digest, the last output block and how much of it was read, the next
/// node, and whether reading began.
pub struct Xof {
  d: State
  length: Int
  remaining: Int
  root: Bytes
  block: Bytes
  offset: Int
  node: Int
  read_mode: Bool
}

/// The root digest of an XOF of `length` (Go's xof.Reset).
fn xof_root(length: Int, key: Bytes) -> State {
  var d = new(SIZE, key)
  var h = d.h
  h[1] = h[1] ^ length.wrapping_shl(32)
  d.h = h
  d
}

/// The bytes an XOF of `length` reads.
fn xof_total(length: Int) -> Int { if length == XOF_UNKNOWN { 0x4000000000 } else { length } }

/// A new XOF (Go's NewXOF after its checks: the caller checked the key
/// and the length, and maps Go's OutputLengthUnknown (0) to XOF_UNKNOWN).
pub fn new_xof(length: Int, key: Bytes) -> Xof {
  Xof{d: xof_root(length, key), length: length, remaining: xof_total(length), root: b"", block: b"", offset: 0, node: 0, read_mode: false}
}

/// Back to the state before any write (Go's Reset; the key kept).
pub fn (var x: Xof) reset() {
  x.d = xof_root(x.length, x.d.key)
  x.remaining = xof_total(x.length)
  x.root = b""
  x.block = b""
  x.offset = 0
  x.node = 0
  x.read_mode = false
}

/// Whether reading began (Go panics on a write after it).
pub fn (x: Xof) reading() -> Bool { x.read_mode }

/// Absorbs p (the caller faults once reading began).
pub fn (var x: Xof) write(p: Bytes) {
  var d = x.d
  d.write(p)
  x.d = d
}

/// The output block of node `node`, `size` bytes of digest asked of it
/// (Go's initConfig of the parameter block, then the root hashed).
fn out_block(root: Bytes, length: Int, node: Int, size: Int) -> Bytes {
  var h = digest_tables.blake2b_iv()
  h[0] = h[0] ^ (size | SIZE.wrapping_shl(32))
  h[1] = h[1] ^ (node | length.wrapping_shl(32))
  h[2] = h[2] ^ SIZE.wrapping_shl(8)
  var blk = BytesBuilder.with_capacity(BLOCK)
  blk.write(root)
  for _ in SIZE..BLOCK {
    blk.write_byte(0)
  }
  digest_tables.blake2b_compress(h, blk.freeze(), 0, SIZE, true)
  le_out(h, SIZE)
}

/// The next min(n, remaining) bytes of output (Go's Read); None once
/// every byte was read (Go's io.EOF).
pub fn (var x: Xof) read(n: Int) -> Bytes? {
  if !x.read_mode {
    x.root = le_out(final_words(x.d), SIZE)
    x.read_mode = true
  }
  if x.remaining == 0 {
    return None
  }
  let want = if n > x.remaining { x.remaining } else { n }
  var out = BytesBuilder.with_capacity(want)
  var left = want
  if x.offset > 0 {
    let block_left = SIZE - x.offset
    if left < block_left {
      out.write(x.block[x.offset..x.offset + left])
      x.offset += left
      x.remaining -= left
      return Some(out.freeze())
    }
    out.write(x.block[x.offset..SIZE])
    left -= block_left
    x.offset = 0
    x.remaining -= block_left
  }
  while left >= SIZE {
    x.block = out_block(x.root, x.length, x.node, SIZE)
    x.node += 1
    out.write(x.block)
    left -= SIZE
    x.remaining -= SIZE
  }
  if left > 0 {
    let size = if x.remaining < SIZE { x.remaining } else { SIZE }
    x.block = out_block(x.root, x.length, x.node, size)
    x.node += 1
    out.write(x.block[0..left])
    x.offset = left
    x.remaining -= left
  }
  Some(out.freeze())
}
