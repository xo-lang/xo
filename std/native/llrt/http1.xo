// The request parsing of the native HTTP/1.1 server, written in Xo
// (decision 0193 step 6): the request line and the MIME header with
// continuation lines and Go's checks (net/http's readRequest and
// conn.readRequest, textproto), the request target (net/url's
// ParseRequestURI) and its query (ParseQuery), chunked bodies with their
// trailers (chunkedReader), and the text helpers of std/http (url.Parse's
// parts and error, url.PathUnescape, url.QueryEscape, strconv.Quote,
// CanonicalMIMEHeaderKey, EqualFold). They were C (std/llrt/xo_http.c;
// decision 0198 deleted the C path, `XO_LLRT_C=http1`); the semantics
// are the same, so a client observes what net/http answers. Since audit
// item B10 (2026-10-14) the client is here too (client_do: the URL, the
// redirects, the reading of a response, parse_response), and so is the
// parse of an HTTP/2 request's :path (h2_target). The client's HTTP/2
// header blocks pass through here to hpack.xo (h2_exchange, since audit
// item B11); the HTTP/2 server is h2srv.xo (B28 part 2).
//
// The server's HTTP/1.1 connection is here too since audit item B28
// (Reader, respond, emit): the connection's task (std/native/http.xo,
// serve_conn) reads, parses, answers errors, and writes the response in
// Xo; the C keeps the socket and TLS reads and writes and the server's
// registration. An HTTP/2 stream's response header is here too (hdr_*,
// for h2srv.xo).
use std/archive
use native/llrt/hclient
use native/llrt/hpack
use native/llrt/http1_tables
use native/llrt/http1w
use native/llrt/netpolicy
use native/llrt/neturl
use native/llrt/process
use native/llrt/raw
use native/llrt/scan
use native/llrt/hconn
use native/rt
use native/rthttp
use native/llrt/raw as rawb

/// net/http's DefaultMaxHeaderBytes plus the 4096 bytes of slack its
/// server reads; a longer head is 431.
const MAX_HEAD: Int = 1052672

/// Header fields per request (Go has no count limit: its bytes limit
/// bounds them); more is 431.
const MAX_FIELDS: Int = 10000

const MAX_INT: Int = 9223372036854775807

// The results of a head's parse (xo_http.c's HP_*).
const NEED: Int = 0
const OK: Int = 1
const EOF: Int = 2
const BAD: Int = 3
const STATUS: Int = 4
const TOO_LARGE: Int = 5
const BAD_TE: Int = 6
/// A body over with_max_body (413, std.md 4.4).
const BODY_TOO_BIG: Int = 8

// The byte classes (http1_tables.CLASS).
const TCHAR: Int = 1
/// "HTTP/1.1" as a little-endian word (parse_head's version check).
const HTTP11: Int = 3543824036068086856
const HOSTB: Int = 4
const HEX: Int = 8
const USERINFO: Int = 16
const HOSTHDR: Int = 32
const QKEEP: Int = 64
const PKEEP: Int = 128

fn cls(c: Int) -> Int { Int(http1_tables.CLASS[c & 255]) }

fn unhex(c: Int) -> Int { if c <= 57 { c - 48 } else { (c | 32) - 87 } }

fn lower(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// The index of the first byte c of s in [from, to), or -1 (from and to
/// clamped to s): one scan of the range, where rt.str_find searched on
/// to the end of the string.
fn find(s: Str, c: Int, from: Int, to: Int) -> Int {
  let b = s.bytes()
  let f = if from < 0 { 0 } else { from }
  let t = if to > b.len() { b.len() } else { to }
  if f >= t {
    return -1
  }
  scan.find_byte(b, f, t, c)
}

/// The index of the first byte c of b in [from, to), or -1: a short
/// range (scan.find would search on to the end of the string).
fn bfind(b: Bytes, c: Int, from: Int, to: Int) -> Int {
  var i = from
  while i < to {
    if Int(b[i]) == c {
      return i
    }
    i += 1
  }
  -1
}

/// The index of the last byte c of b in [0, to), or -1.
fn rfind(b: Bytes, c: Int, to: Int) -> Int {
  var i = to - 1
  while i >= 0 {
    if Int(b[i]) == c {
      return i
    }
    i -= 1
  }
  -1
}

fn is_sp(c: Int) -> Bool { c == 32 || c == 9 }

// ---------------------------------------------------------------------------
// Request targets (net/url) and queries

/// The `"%s"` of a C format: the text in quotes as it is (xo_http.c's
/// snprintf; the bytes are printable here: control bytes failed first).
fn go_quote_c(s: Str) -> Str { "\"" + s + "\"" }

/// url.ParseRequestURI of a request target; a CONNECT target that is not
/// a path is an authority.
fn parse_target(raw: Str, connect: Bool) -> neturl.Url {
  if connect && !raw.starts_with("/") {
    let u = neturl.url_parse("http://" + raw, true)
    if u.ok {
      return neturl.Url{ok: true, err: "", scheme: "", host: u.host, path: u.path, rawquery: u.rawquery}
    }
    return u
  }
  neturl.url_parse(raw, true)
}

/// std/rt's urlOf over url.ParseQuery: each key once with its first
/// value, the keys sorted: [k1, v1, k2, v2, ...].
pub fn query_parts(q: Str) -> List[Str] {
  let b = q.bytes()
  let n = b.len()
  var amps = 0
  var i = scan.find_byte(b, 0, n, 38)
  while i >= 0 {
    amps += 1
    i = scan.find_byte(b, i + 1, n, 38)
  }
  if amps + 1 > 10000 {
    return [] // number of URL query parameters exceeded limit
  }
  // no escape, no plus and valid UTF-8: every key and value is a view of
  // q (a split at & or = keeps UTF-8 whole), no unescape or copy
  let plain = scan.find_byte(b, 0, n, 37) < 0 && scan.find_byte(b, 0, n, 43) < 0 && scan.utf8_valid(b)
  let semi = scan.find_byte(b, 0, n, 59) >= 0
  // the keys kept sorted as they come (a key seen before keeps its first
  // value): [k1, v1, k2, v2, ...]
  var out: List[Str] = []
  i = 0
  while i < n {
    var j = scan.find_byte(b, i, n, 38)
    if j < 0 {
      j = n
    }
    let lo = i
    i = j + 1
    if j == lo || (semi && find(q, 59, lo, j) >= 0) {
      continue
    }
    let eq = find(q, 61, lo, j)
    let ke = if eq < 0 { j } else { eq }
    var k = ""
    var v = ""
    if plain {
      k = rawb.str_cut(q, lo, ke)
      if eq >= 0 {
        v = rawb.str_cut(q, eq + 1, j)
      }
    } else {
      let (kok, kk) = neturl.unescape(b, q, lo, ke, neturl.U_QUERY)
      if !kok {
        continue
      }
      k = kk
      if eq >= 0 {
        let (vok, vv) = neturl.unescape(b, q, eq + 1, j, neturl.U_QUERY)
        if !vok {
          continue
        }
        v = vv
      }
    }
    // binary search for k among the keys
    var a = 0
    var z = out.len() / 2
    var found = false
    while a < z {
      let m = (a + z) / 2
      let km = out[2 * m]
      if km == k {
        found = true
        break
      }
      if km < k {
        a = m + 1
      } else {
        z = m
      }
    }
    if found {
      continue
    }
    out.push(k)
    out.push(v)
    var e = out.len() - 2
    while e > 2 * a {
      out[e] = out[e - 2]
      out[e + 1] = out[e - 1]
      e -= 2
    }
    out[2 * a] = k
    out[2 * a + 1] = v
  }
  out
}

/// url's splitHostPort: the hostname (brackets removed) and the port
/// when it is valid.
fn split_hostport(host: Str) -> (Str, Str) {
  let b = host.bytes()
  let n = b.len()
  var hn = n
  var port = ""
  let i = rfind(b, 58, n)
  if i >= 0 && neturl.valid_port(b, i, n) {
    port = rawb.str_slice(host, i + 1, n)
    hn = i
  }
  if hn >= 2 && b[0] == 91 && b[hn - 1] == 93 {
    return (rawb.str_slice(host, 1, hn - 1), port)
  }
  (rawb.str_slice(host, 0, hn), port)
}

/// Request.url.host of a server's request: the Host without its port
/// (net.SplitHostPort), or all of it when it has none or does not split.
pub fn host_name(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var colon = n - 1
  while colon >= 0 && b[colon] != 58 {
    colon -= 1
  }
  if colon < 0 {
    return s
  }
  var lo = 0
  var hi = colon
  var j = 0 // no '[' from j, no ']' from k
  var k = 0
  if n > 0 && b[0] == 91 {
    let end = scan.find_byte(b, 0, n, 93)
    if end < 0 || end + 1 != colon {
      return s
    }
    lo = 1
    hi = end
    j = 1
    k = end + 1
  } else if scan.find_byte(b, 0, colon, 58) >= 0 {
    return s
  }
  if scan.find_byte(b, j, n, 91) >= 0 || scan.find_byte(b, k, n, 93) >= 0 {
    return s
  }
  rawb.str_cut(s, lo, hi)
}

/// The port of an absolute request target's host (url.host), or -1: none,
/// not ":" and digits, empty, or over the largest Int.
pub fn host_port(h: Str) -> Int {
  let b = h.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 58 {
    i -= 1
  }
  if i < 0 || i + 1 == b.len() || !neturl.valid_port(b, i, b.len()) {
    return -1
  }
  var v = 0
  var j = i + 1
  while j < b.len() {
    let d = Int(b[j]) - 48
    if v > (9223372036854775807 - d) / 10 {
      return -1
    }
    v = v * 10 + d
    j += 1
  }
  v
}

/// url.Parse (the fragment cut) or ParseRequestURI (request): [] when it
/// fails, else [scheme, hostname, port, path, raw query, host].
pub fn url_parts(s: Str, request: Bool) -> List[Str] {
  var t = s
  if !request {
    let h = scan.find(s, "#", 0)
    if h >= 0 {
      t = rawb.str_cut(s, 0, h)
    }
  }
  let u = neturl.url_parse(t, request)
  if !u.ok || frag_error(s, t) != "" {
    return []
  }
  let (name, port) = split_hostport(u.host)
  [u.scheme, name, port, u.path, u.rawquery, u.host]
}

/// The text of url.Parse's error: parse "url": reason; "" when it parses.
pub fn url_error(s: Str) -> Str {
  var t = s
  let h = scan.find(s, "#", 0)
  if h >= 0 {
    t = rawb.str_cut(s, 0, h)
  }
  let u = neturl.url_parse(t, false)
  if !u.ok {
    return "parse " + go_quote(t) + ": " + u.err
  }
  let fe = frag_error(s, t)
  if fe.is_empty() { "" } else { "parse " + go_quote(s) + ": " + fe }
}

/// Go's setFragment error for the fragment of s after t (t is s before
/// its first #), "" when there is none or it unescapes.
fn frag_error(s: Str, t: Str) -> Str {
  if t.len() == s.len() {
    return ""
  }
  let (_, e) = neturl.go_unescape(rawb.str_slice(s, t.len() + 1, s.len()), neturl.U_FRAG)
  e
}

/// url.PathUnescape, "" when an escape is invalid.
pub fn path_unescape(s: Str) -> Str {
  if scan.find(s, "%", 0) < 0 {
    return s
  }
  let b = s.bytes()
  let (ok, out) = neturl.unescape(b, s, 0, b.len(), neturl.U_PATH)
  if ok { out } else { "" }
}

/// url.QueryEscape.
pub fn query_escape(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && (cls(Int(b[i])) & QKEEP) != 0 {
    i += 1
  }
  if i == n {
    return s
  }
  let hex = b"0123456789ABCDEF"
  var out = rt.rs_append_bytes("", b, 0, i, 0)
  while i < n {
    let c = Int(b[i])
    if (cls(c) & QKEEP) != 0 {
      out = rt.rs_push_byte(out, c)
    } else if c == 32 {
      out = rt.rs_push_byte(out, 43)
    } else {
      out = rt.rs_push_word(out, 37 | (Int(hex[c >> 4]) << 8) | (Int(hex[c & 15]) << 16), 3)
    }
    i += 1
  }
  out
}

/// strconv.Quote (neturl.xo's go_quote).
pub fn go_quote(s: Str) -> Str { neturl.go_quote(s) }

/// Go's badTrailer (golang.org/x/net/http/httpguts): the fields a
/// trailer may not carry (decision 0433); dropped when set and received.
pub const BAD_TRAILER = #{"Authorization", "Cache-Control", "Connection", "Content-Encoding", "Content-Length", "Content-Range", "Content-Type", "Expect", "Host", "Keep-Alive", "Max-Forwards", "Pragma", "Proxy-Authenticate", "Proxy-Authorization", "Proxy-Connection", "Range", "Realm", "Te", "Trailer", "Transfer-Encoding", "Www-Authenticate"}
/// The most bytes and fields of a received trailer section (decision
/// 0433), shared by the HTTP/1.1 and HTTP/2 readers.
pub const MAX_TRAILER_BYTES = 8192
pub const MAX_TRAILER_COUNT = 64

/// name made canonical, None for a name a trailer may not carry.
pub fn trailer_key(name: Str) -> Str? {
  let k = canonical_key(name)
  if k == "" || BAD_TRAILER.contains(k) { None } else { Some(k) }
}

/// textproto.CanonicalMIMEHeaderKey: unchanged when a byte is not a token
/// byte.
pub fn canonical_key(s: Str) -> Str {
  let c = common_name(raw.data(s), s.len())
  if !c.is_empty() {
    return c
  }
  let b = s.bytes()
  let n = b.len()
  var i = 0
  var upper = true
  var same = true
  while i < n {
    let c = Int(b[i])
    if (cls(c) & TCHAR) == 0 {
      return s
    }
    if (upper && c >= 97 && c <= 122) || (!upper && c >= 65 && c <= 90) {
      same = false
    }
    upper = c == 45
    i += 1
  }
  if same {
    return s
  }
  var out = rt.rs_with_cap(n)
  upper = true
  i = 0
  while i < n {
    var c = Int(b[i])
    if upper && c >= 97 && c <= 122 {
      c -= 32
    } else if !upper && c >= 65 && c <= 90 {
      c += 32
    }
    out = rt.rs_push_byte(out, c)
    upper = c == 45
    i += 1
  }
  out
}

/// canonical_key of the n bytes at p, read in place: a common name
/// (common_name) costs no copy, another one is copied out once.
pub fn canonical_at(p: Int, n: Int) -> Str {
  let c = common_name(p, n)
  if !c.is_empty() {
    return c
  }
  canonical_key(raw.str_at(p, n))
}

/// The canonical form, a constant, of the n bytes at p when they are a
/// common header name in its canonical or its lower case form (HTTP/2
/// sends lower case), else "": a request's names are almost always these
/// (each canonical_key was a copy and a loop over its bytes, about 9 a
/// plain HTTP/1.1 request; 2026-10-18).
fn common_name(p: Int, n: Int) -> Str {
  match n {
    4 => one_of(p, n, "Host", "host")
    6 => {
      let a = one_of(p, n, "Accept", "accept")
      if !a.is_empty() { a } else { one_of(p, n, "Cookie", "cookie") }
    }
    10 => {
      let a = one_of(p, n, "User-Agent", "user-agent")
      if !a.is_empty() { a } else { one_of(p, n, "Connection", "connection") }
    }
    12 => one_of(p, n, "Content-Type", "content-type")
    13 => one_of(p, n, "Authorization", "authorization")
    14 => one_of(p, n, "Content-Length", "content-length")
    15 => {
      let a = one_of(p, n, "Accept-Encoding", "accept-encoding")
      if !a.is_empty() { a } else { one_of(p, n, "Accept-Language", "accept-language") }
    }
    _ => ""
  }
}

/// HTTP/2 header names h2srv's fragment keeps as constants: the index
/// of the n bytes at p in H2_NAMES when they are one (lower case, as
/// HTTP/2 sends them), else -1. fragment copied each name and value it
/// kept out of the decoded block, about 8 copies an HTTP/2 request
/// (2026-10-19).
const H2_NAMES: List[Str] = [":path", ":method", ":scheme", ":authority", "accept-encoding", "host", "accept", "cookie", "user-agent", "content-type", "authorization", "content-length", "accept-language"]
pub const H2_PATH = 0
const H2_METHOD = 1
const H2_SCHEME = 2
const H2_ACCEPT_ENCODING = 4

pub fn h2_name_at(p: Int, n: Int) -> Int {
  match n {
    4 => is_at(p, n, "host", 5)
    5 => is_at(p, n, ":path", H2_PATH)
    6 => {
      let a = is_at(p, n, "accept", 6)
      if a >= 0 { a } else { is_at(p, n, "cookie", 7) }
    }
    7 => {
      let a = is_at(p, n, ":method", H2_METHOD)
      if a >= 0 { a } else { is_at(p, n, ":scheme", H2_SCHEME) }
    }
    10 => {
      let a = is_at(p, n, ":authority", 3)
      if a >= 0 { a } else { is_at(p, n, "user-agent", 8) }
    }
    12 => is_at(p, n, "content-type", 9)
    13 => is_at(p, n, "authorization", 10)
    14 => is_at(p, n, "content-length", 11)
    15 => {
      let a = is_at(p, n, "accept-encoding", H2_ACCEPT_ENCODING)
      if a >= 0 { a } else { is_at(p, n, "accept-language", 12) }
    }
    _ => -1
  }
}

/// The n bytes at p as a constant when they are a common value of the
/// header H2_NAMES[k] (:method, :scheme, accept-encoding), else "".
pub fn h2_value_at(k: Int, p: Int, n: Int) -> Str {
  if k == H2_METHOD {
    return match n {
      3 => {
        let a = lit_at(p, n, "GET")
        if !a.is_empty() { a } else { lit_at(p, n, "PUT") }
      }
      4 => {
        let a = lit_at(p, n, "POST")
        if !a.is_empty() { a } else { lit_at(p, n, "HEAD") }
      }
      5 => lit_at(p, n, "PATCH")
      6 => lit_at(p, n, "DELETE")
      _ => ""
    }
  }
  if k == H2_SCHEME {
    return if n == 5 { lit_at(p, n, "https") } else if n == 4 { lit_at(p, n, "http") } else { "" }
  }
  if k == H2_ACCEPT_ENCODING && n == 4 {
    return lit_at(p, n, "gzip")
  }
  ""
}

/// H2_NAMES[k] (a qualified `http1.H2_NAMES[k]` reads as type
/// arguments).
pub fn h2_name(k: Int) -> Str { H2_NAMES[k] }

/// k when the n bytes at p are s (n is its length), else -1.
fn is_at(p: Int, n: Int, s: Str, k: Int) -> Int {
  if eq_at(p, raw.data(s), n) { k } else { -1 }
}

/// s when the n bytes at p are s (n is its length), else "".
fn lit_at(p: Int, n: Int, s: Str) -> Str {
  if eq_at(p, raw.data(s), n) { s } else { "" }
}

/// canon when the n bytes at p are canon or lower (its lower case form),
/// else "".
fn one_of(p: Int, n: Int, canon: Str, lower: Str) -> Str {
  if eq_at(p, raw.data(canon), n) || eq_at(p, raw.data(lower), n) {
    return canon
  }
  ""
}

/// Whether the n bytes at p and q are equal: in words, the last one
/// overlapping, every load inside the n bytes (a header name: 4 to 15
/// bytes, where a C memcmp call cost more than the compare).
fn eq_at(p: Int, q: Int, n: Int) -> Bool {
  if n >= 8 {
    var i = 0
    while i + 8 <= n {
      if rt.mem_load(p, i, 8) != rt.mem_load(q, i, 8) {
        return false
      }
      i += 8
    }
    return i == n || rt.mem_load(p, n - 8, 8) == rt.mem_load(q, n - 8, 8)
  }
  if n >= 4 {
    return rt.mem_load(p, 0, 4) == rt.mem_load(q, 0, 4) && rt.mem_load(p, n - 4, 4) == rt.mem_load(q, n - 4, 4)
  }
  var i = 0
  while i < n {
    if rt.mem_load(p, i, 1) != rt.mem_load(q, i, 1) {
      return false
    }
    i += 1
  }
  true
}

/// strings.EqualFold of ASCII letters.
pub fn equal_fold(a: Str, b: Str) -> Bool {
  let x = a.bytes()
  let y = b.bytes()
  let n = x.len()
  if n != y.len() {
    return false
  }
  var i = 0
  while i < n {
    if lower(Int(x[i])) != lower(Int(y[i])) {
      return false
    }
    i += 1
  }
  true
}

// ---------------------------------------------------------------------------
// Reading a request (xo_http.c's hp_head)

/// A request head: what std/rt's serve hands to Xo code, and what the C
/// needs to read the body and answer.
pub struct Head {
  method: Str
  target: Str
  major: Int
  minor: Int
  /// The header: canonical names and their values joined with ", ", in
  /// the order of first appearance: [name, value, ...].
  headers: List[Str]
  /// req.Host.
  host: Str
  url: neturl.Url
  /// The URL's query: [key, first value, ...], keys sorted.
  query: List[Str]
  /// ContentLength (-1 chunked).
  clen: Int
  chunked: Bool
  close: Bool
  wants10ka: Bool
  wantsclose: Bool
  expect100: Bool
  expect_other: Bool
  /// "PRI * HTTP/2.0" (closed after the answer).
  h2up: Bool
  /// [name, value, ...] of every field when a name repeats (decision
  /// 0288: Request.header_values), else []
  fields: List[Str] = []
}

fn no_head() -> Head {
  Head{method: "", target: "", major: 0, minor: 0, headers: [], host: "", url: neturl.url_fail(""), query: [], clen: 0, chunked: false, close: false, wants10ka: false, wantsclose: false, expect100: false, expect_other: false, h2up: false}
}

/// The result of a head's parse: res (NEED, OK, ...), the head's length
/// (OK), the head, and for STATUS its code and text.
pub struct Parse {
  res: Int
  used: Int
  head: Head
  status: Int
  reason: Str
}

/// The method s[0..n]: a constant for the usual ones (no string a
/// request), else a slice of s.
fn method_of(s: Str, b: Bytes, n: Int) -> Str {
  if n == 3 && b[0] == 71 && b[1] == 69 && b[2] == 84 {
    return "GET"
  }
  if n == 4 && b[0] == 80 && b[1] == 79 && b[2] == 83 && b[3] == 84 {
    return "POST"
  }
  if n == 3 && b[0] == 80 && b[1] == 85 && b[2] == 84 {
    return "PUT"
  }
  if n == 4 && b[0] == 72 && b[1] == 69 && b[2] == 65 && b[3] == 68 {
    return "HEAD"
  }
  if n == 6 && b[0] == 68 && b[1] == 69 && b[2] == 76 && b[3] == 69 && b[4] == 84 && b[5] == 69 {
    return "DELETE"
  }
  if n == 5 && b[0] == 80 && b[1] == 65 && b[2] == 84 && b[3] == 67 && b[4] == 72 {
    return "PATCH"
  }
  if n == 7 && b[0] == 79 && b[1] == 80 && b[2] == 84 && b[3] == 73 && b[4] == 79 && b[5] == 78 && b[6] == 83 {
    return "OPTIONS"
  }
  rawb.str_slice(s, 0, n)
}

fn fail(res: Int) -> Parse { Parse{res: res, used: 0, head: no_head(), status: 0, reason: ""} }

fn fail_status(code: Int, reason: Str, used: Int) -> Parse { Parse{res: STATUS, used: used, head: no_head(), status: code, reason: reason} }

/// The line at b[i..n]: (found, its end without \n and the \r before it,
/// the start of the next). Not found when there is no \n yet (at eof the
/// rest is the line, bufio's ReadLine).
fn line_at(s: Str, b: Bytes, i: Int, n: Int, eof: Bool) -> (Bool, Int, Int) {
  let nl = if i < n { scan.find_byte(s.bytes(), i, s.len(), 10) } else { -1 }
  if nl < 0 {
    if eof && i < n {
      return (true, n, n)
    }
    return (false, 0, 0)
  }
  if nl > i && b[nl - 1] == 13 {
    return (true, nl - 1, nl + 1)
  }
  (true, nl, nl + 1)
}

/// The result when more input may complete the head.
fn need(n: Int) -> Parse { need_cap(n, MAX_HEAD) }
fn need_cap(n: Int, cap: Int) -> Parse { fail(if n > cap { TOO_LARGE } else { NEED }) }

/// net/http's hasToken: tok anywhere in v between space, comma, or tab
/// boundaries, ASCII case insensitive (tok lower case).
fn server_token(v: Str, tok: Str) -> Bool {
  let b = v.bytes()
  let t = tok.bytes()
  let n = b.len()
  let tl = t.len()
  if tl > n || tl == 0 {
    return false
  }
  let t0 = Int(t[0])
  var sp = 0
  while sp + tl <= n {
    let c = Int(b[sp])
    if c == t0 || (c | 32) == t0 {
      let before = sp == 0 || b[sp - 1] == 32 || b[sp - 1] == 44 || b[sp - 1] == 9
      let e = sp + tl
      let after = e == n || b[e] == 32 || b[e] == 44 || b[e] == 9
      if before && after {
        var k = 0
        var eq = true
        while k < tl {
          if lower(Int(b[sp + k])) != lower(Int(t[k])) {
            eq = false
            break
          }
          k += 1
        }
        if eq {
          return true
        }
      }
    }
    sp += 1
  }
  false
}

/// httpguts.headerValueContainsToken (shouldClose): tok (lower case) is
/// one of the comma separated elements of v.
pub fn has_token(v: Str, tok: Str) -> Bool {
  let b = v.bytes()
  let t = tok.bytes()
  let n = b.len()
  let tl = t.len()
  var i = 0
  while i <= n {
    var j = i
    while j < n && b[j] != 44 {
      j += 1
    }
    var a = i
    var z = j
    while a < z && is_sp(Int(b[a])) {
      a += 1
    }
    while z > a && is_sp(Int(b[z - 1])) {
      z -= 1
    }
    if z - a == tl {
      var k = 0
      var eq = true
      while k < tl {
        let c = Int(b[a + k])
        if c >= 128 || lower(c) != Int(t[k]) {
          eq = false
          break
        }
        k += 1
      }
      if eq {
        return true
      }
    }
    i = j + 1
  }
  false
}

/// textproto.TrimString (ASCII space, tab, CR, LF).
fn trim_ws(s: Str) -> Str {
  let b = s.bytes()
  var a = 0
  var z = b.len()
  while a < z && (b[a] == 32 || b[a] == 9 || b[a] == 13 || b[a] == 10) {
    a += 1
  }
  while z > a && (b[z - 1] == 32 || b[z - 1] == 9 || b[z - 1] == 13 || b[z - 1] == 10) {
    z -= 1
  }
  if a == 0 && z == b.len() { s } else { rawb.str_cut(s, a, z) }
}

/// The start and end of b[a..z] without spaces and tabs at either end.
fn trim_sp(b: Bytes, a0: Int, z0: Int) -> (Int, Int) {
  var a = a0
  var z = z0
  while a < z && is_sp(Int(b[a])) {
    a += 1
  }
  while z > a && is_sp(Int(b[z - 1])) {
    z -= 1
  }
  (a, z)
}

/// Reads the request line and the header at the start of s (eof: no
/// more will come), as net/http's readRequest and the checks of
/// conn.readRequest.
pub fn parse_head(s: Str, eof: Bool) -> Parse {
  let b = s.bytes()
  let n = b.len()
  if n == 0 {
    return fail(if eof { EOF } else { NEED })
  }
  let (found, le, next0) = line_at(s, b, 0, n, eof)
  if !found {
    return need(n)
  }
  if eof && next0 == n && le == n && n % 4096 == 0 {
    // a request line cut by the end of the stream that fills net/http's
    // 4096 byte reader exactly: its last read finds no byte, so the line
    // reads as io.EOF and the connection closes quietly
    return fail(EOF)
  }
  if next0 > MAX_HEAD {
    return fail(TOO_LARGE)
  }
  // METHOD SP target SP proto (strings.Cut on single spaces)
  let sp1 = find(s, 32, 0, le)
  if sp1 < 0 {
    return fail(BAD)
  }
  let sp2 = find(s, 32, sp1 + 1, le)
  if sp2 < 0 || sp1 == 0 {
    return fail(BAD)
  }
  var k = 0
  while k < sp1 {
    if (cls(Int(b[k])) & TCHAR) == 0 {
      return fail(BAD) // invalid method
    }
    k += 1
  }
  let pn = le - sp2 - 1
  let p0 = sp2 + 1
  var major = 0
  var minor = 0
  if pn == 8 && rt.bytes_word(b, p0) == HTTP11 {
    // the usual version in one compare
    major = 1
    minor = 1
  } else if pn == 8 && b[p0] == 72 && b[p0 + 1] == 84 && b[p0 + 2] == 84 && b[p0 + 3] == 80 && b[p0 + 4] == 47 && b[p0 + 6] == 46 && b[p0 + 5] >= 48 && b[p0 + 5] <= 57 && b[p0 + 7] >= 48 && b[p0 + 7] <= 57 {
    major = Int(b[p0 + 5]) - 48
    minor = Int(b[p0 + 7]) - 48
  } else {
    return fail(BAD) // malformed HTTP version
  }
  let method = method_of(s, b, sp1)
  // outside bytes: an invalid byte stays a percent escape (decision 0259)
  let target = scan.url_text_at(rawb.data(s) + sp1 + 1, sp2 - sp1 - 1)
  let connect = method == "CONNECT"
  let url = parse_target(target, connect)
  if !url.ok {
    return fail(BAD)
  }
  let query = if url.rawquery.is_empty() { [] } else { query_parts(url.rawquery) }
  // the header: lines up to an empty one
  var i = next0
  // room for a usual request's fields: no growth (a copy) at the fifth
  var keys: List[Str] = List.with_capacity(8)
  // a name held a space (head_of answers 400 for it)
  var spaced = false
  var vals: List[Str] = List.with_capacity(8)
  if i < n && is_sp(Int(b[i])) {
    // malformed MIME header initial line (needs the line to say so)
    let (f2, _, _) = line_at(s, b, i, n, eof)
    if !f2 {
      return fail(if eof { BAD } else { NEED })
    }
    return fail(BAD)
  }
  while true {
    if i > MAX_HEAD {
      return fail(TOO_LARGE)
    }
    let (f, e, nx) = line_at(s, b, i, n, eof)
    if !f {
      if eof {
        return fail(BAD)
      }
      return need(n)
    }
    if e == i {
      // the empty line ends the header
      i = nx
      break
    }
    // a field line: it must have a colon
    if find(s, 58, i, e) < 0 {
      return fail(BAD)
    }
    // trim (spaces and tabs) and join continuation lines; the field is
    // read from s itself unless a continuation line joins it (cont), so
    // its key and value are the only copies
    let (a, z) = trim_sp(b, i, e)
    var cont = ""
    var joined = false
    i = nx
    while true {
      if i >= n {
        if !eof {
          return need(n)
        }
        break
      }
      if !is_sp(Int(b[i])) {
        break
      }
      // a continuation line: skip its leading spaces and tabs
      var c = i
      while c < n && is_sp(Int(b[c])) {
        c += 1
      }
      if c >= n && !eof {
        return need(n)
      }
      if !joined {
        cont = rawb.str_slice(s, a, z)
        joined = true
      }
      cont = rt.rs_push_byte(cont, 32)
      let (f3, e3, nx3) = line_at(s, b, c, n, eof)
      if !f3 {
        if !eof {
          return need(n)
        }
        // at the end: nothing more (readLineSlice failed)
        i = n
        break
      }
      let (a3, z3) = trim_sp(b, c, e3)
      cont = rt.rs_append_bytes(cont, b, a3, z3, 0)
      i = nx3
    }
    // key: up to the first colon; token bytes, or spaces (kept as is);
    // the field is src's bytes p0 to cn
    let src = if joined { cont } else { s }
    let p0 = if joined { 0 } else { a }
    let cn = if joined { cont.len() } else { z }
    let cb = src.bytes()
    let colon = scan.find(src, ":", p0)
    if colon <= p0 || colon >= cn {
      return fail(BAD)
    }
    // a common name (common_name: its exact bytes, all token bytes) needs
    // no check of each byte, and is its own canonical form
    let common = common_name(rawb.data(src) + p0, colon - p0)
    var x = if common.is_empty() { p0 } else { colon }
    while x < colon {
      let ch = Int(cb[x])
      if (cls(ch) & TCHAR) == 0 {
        if ch != 32 {
          return fail(BAD)
        }
        // kept, for head_of's 400 "invalid header name"
        spaced = true
      }
      x += 1
    }
    // the value's bytes: no control byte but a tab (the table's
    // VBYTE class), eight a
    // step
    x = colon + 1
    while x < cn {
      let j = scan.ctl_at(cb, x, cn)
      if j >= cn {
        break
      }
      if cb[j] != 9 {
        return fail(BAD)
      }
      x = j + 1
    }
    var v0 = colon + 1
    while v0 < cn && is_sp(Int(cb[v0])) {
      v0 += 1
    }
    if keys.len() == MAX_FIELDS {
      return fail(TOO_LARGE)
    }
    keys.push(if common.is_empty() { canonical_key(raw.str_at(rawb.data(src) + p0, colon - p0)) } else { common })
    // a value may hold obs-text (RFC 9110): valid UTF-8 or U+FFFD
    // (decision 0259)
    vals.push(scan.text_at(rawb.data(src) + v0, cn - v0))
    // src (a joined field's cont) is released after its last use, which
    // would be inside the arguments above: its freed block's first word
    // was the value's first bytes on Linux (gotchas/raw-address-outlives-bytes.md)
    raw.alive_str(src)
  }
  if i > MAX_HEAD {
    return fail(TOO_LARGE)
  }
  head_of(method, target, major, minor, url, query, keys, vals, i, connect, spaced)
}

/// The checks and merging of a head whose fields were read (the rest of
/// hp_head): Go's Header, readTransfer, shouldClose, conn.readRequest.
// The header names head_of looks for, by key_kind.
const K_OTHER = 0
const K_HOST = 1
const K_TE = 2
const K_CL = 3
const K_TRAILER = 4
const K_PRAGMA = 5
const K_CC = 6
const K_CONN = 7
const K_EXPECT = 8

/// The kind of a canonical header name: its length first, so most names
/// are told apart without comparing their bytes.
fn key_kind(key: Str) -> Int {
  match key.len() {
    4 => if key == "Host" { K_HOST } else { K_OTHER }
    6 => if key == "Pragma" { K_PRAGMA } else if key == "Expect" { K_EXPECT } else { K_OTHER }
    7 => if key == "Trailer" { K_TRAILER } else { K_OTHER }
    10 => if key == "Connection" { K_CONN } else { K_OTHER }
    13 => if key == "Cache-Control" { K_CC } else { K_OTHER }
    14 => if key == "Content-Length" { K_CL } else { K_OTHER }
    17 => if key == "Transfer-Encoding" { K_TE } else { K_OTHER }
    _ => K_OTHER
  }
}

fn head_of(method: Str, target: Str, major: Int, minor: Int, url: neturl.Url, query: List[Str], keys: List[Str], vals: List[Str], used: Int, connect: Bool, spaced: Bool) -> Parse {
  let nraw = keys.len()
  // each key's kind (key_kind), found once for the passes below
  var kinds: List[Int] = List.with_capacity(nraw)
  for key in keys {
    kinds.push(key_kind(key))
  }
  // counts per key, for Host and Content-Length checks
  var hosts = 0
  var tes = 0
  var cls_n = 0
  var first_cl = ""
  var cl_conflict = false
  var host = ""
  var k = 0
  while k < nraw {
    let kk = kinds[k]
    if kk == K_HOST {
      hosts += 1
      host = vals[k]
    } else if kk == K_TE {
      tes += 1
    } else if kk == K_CL {
      let v = trim_ws(vals[k])
      if cls_n == 0 {
        first_cl = v
      } else if v != first_cl {
        cl_conflict = true
      }
      cls_n += 1
    }
    k += 1
  }
  if hosts > 1 {
    return fail(BAD) // too many Host headers
  }
  // readTransfer: Transfer-Encoding (removed from the header); it takes
  // HTTP/0.0 for HTTP/1.1
  var chunked = false
  let t11 = (major == 0 && minor == 0) || major > 1 || (major == 1 && minor >= 1)
  if tes > 0 && t11 {
    if tes != 1 {
      return fail(BAD_TE)
    }
    k = 0
    while k < nraw {
      if kinds[k] == K_TE && !equal_fold(vals[k], "chunked") {
        return fail(BAD_TE)
      }
      k += 1
    }
    chunked = true
  }
  // Content-Length (several must agree)
  if cl_conflict {
    return fail(BAD)
  }
  var clen = 0
  if cls_n > 0 {
    let cb = first_cl.bytes()
    if cb.len() == 0 {
      return fail(BAD) // invalid empty Content-Length
    }
    var v = 0
    var x = 0
    while x < cb.len() {
      let d = Int(cb[x]) - 48
      if d < 0 || d > 9 || v > (MAX_INT - d) / 10 {
        return fail(BAD) // bad Content-Length
      }
      v = v * 10 + d
      x += 1
    }
    clen = v
  }
  if chunked {
    clen = -1
  }
  // the merged header, without the fields Go removes, as Head.headers'
  // name and value pairs (built here, not copied from two lists after);
  // room for every field and Cache-Control: no growth
  var headers: List[Str] = List.with_capacity(2 * nraw + 2)
  var pragma = -1
  var have_cc = false
  var repeated = false
  k = 0
  while k < nraw {
    let key = keys[k]
    let kk = kinds[k]
    k += 1
    if kk == K_HOST || kk == K_TE {
      continue
    }
    if chunked && (kk == K_CL || kk == K_TRAILER) {
      continue
    }
    // e: the pair index of the name, -1 when new
    var e = -1
    var y = 0
    while y < headers.len() {
      if headers[y] == key {
        e = y
        break
      }
      y += 2
    }
    if kk == K_CL && e >= 0 {
      continue // deduplicated; its value as written first
    }
    if e >= 0 {
      // the Map view joins a repeated name, but Set-Cookie keeps its
      // first value (decision 0288, std/rt's fieldView)
      if key != "Set-Cookie" {
        headers[e + 1] = headers[e + 1] + ", " + vals[k - 1]
      }
      repeated = true
    } else {
      headers.push(key)
      headers.push(vals[k - 1])
    }
    if kk == K_PRAGMA && pragma < 0 {
      pragma = k - 1
    }
    if kk == K_CC {
      have_cc = true
    }
  }
  // a name with several fields: each, as received (Go's Header keeps
  // them; decision 0288), without those dropped above
  var fields: List[Str] = []
  if repeated {
    k = 0
    while k < nraw {
      let kk = kinds[k]
      if !(kk == K_HOST || kk == K_TE || (chunked && (kk == K_CL || kk == K_TRAILER))) {
        fields.push(keys[k])
        fields.push(vals[k])
      }
      k += 1
    }
  }
  // fixPragmaCacheControl: Pragma: no-cache without Cache-Control
  if pragma >= 0 && !have_cc && vals[pragma] == "no-cache" {
    headers.push("Cache-Control")
    headers.push("no-cache")
  }
  // req.Host: the URL's host, else the Host header
  let rhost = if url.host.is_empty() { host } else { url.host }
  // shouldClose (Connection tokens of every Connection field)
  var has_close = false
  var has_ka = false
  var cv = ""
  var have_cv = false
  var ev = ""
  var have_ev = false
  k = 0
  while k < nraw {
    if kinds[k] == K_CONN {
      has_close = has_close || has_token(vals[k], "close")
      has_ka = has_ka || has_token(vals[k], "keep-alive")
      if !have_cv {
        cv = vals[k]
        have_cv = true
      }
    } else if kinds[k] == K_EXPECT && !have_ev {
      ev = vals[k]
      have_ev = true
    }
    k += 1
  }
  var close = has_close
  if major < 1 {
    close = true
  } else if major == 1 && minor == 0 {
    close = has_close || !has_ka
  }
  // conn.readRequest's checks
  if !(major == 1 || (major == 2 && minor == 0 && method == "PRI" && target == "*")) {
    return fail_status(505, "unsupported protocol version", used)
  }
  let h2up = method == "PRI" && nraw == 0 && url.path == "*" && major == 2 && minor == 0
  let is11 = major > 1 || (major == 1 && minor >= 1)
  if is11 && hosts == 0 && !h2up && !connect {
    return fail_status(400, "missing required Host header", used)
  }
  if hosts == 1 {
    let hb = host.bytes()
    var x = 0
    while x < hb.len() {
      if (cls(Int(hb[x])) & HOSTHDR) == 0 {
        return fail_status(400, "malformed Host header", used)
      }
      x += 1
    }
  }
  // parse_head let only token bytes and spaces into a name
  if spaced {
    return fail_status(400, "invalid header name", used)
  }
  // Connection close / keep-alive wishes (Header.get: the first value)
  let wants10ka = major == 1 && minor == 0 && server_token(cv, "keep-alive")
  var wantsclose = close || server_token(cv, "close")
  if h2up {
    clen = 0 // its Body is NoBody (std/rt reads none)
    close = true
    wantsclose = true
  }
  var expect100 = false
  var expect_other = false
  if have_ev && server_token(ev, "100-continue") {
    expect100 = is11 && clen != 0
  } else if have_ev && !ev.is_empty() {
    expect_other = true
  }
  let head = Head{method: method, target: target, major: major, minor: minor, headers: headers, host: rhost, url: url, query: query, clen: clen, chunked: chunked, close: close, wants10ka: wants10ka, wantsclose: wantsclose, expect100: expect100, expect_other: expect_other, h2up: h2up, fields: fields}
  Parse{res: OK, used: used, head: head, status: 0, reason: ""}
}

// ---------------------------------------------------------------------------
// Chunked bodies (xo_http.c's hb_chunked)

// The results of a chunked body's decoding (HB_*).
const HB_NEED: Int = 0
const HB_OK: Int = 1
const HB_ERR: Int = 2

/// A chunked body decoded: res, its length in the input (HB_OK), and the
/// data (what was decoded before an error or the end of the input too).
pub struct Chunked {
  res: Int
  used: Int
  body: Str
  /// HB_ERR's text: net/http's chunkedReader or readTrailer error
  why: Str = ""
}

/// A chunk's size line decoded (HB_OK: its size, the offset after it,
/// the non-data count carried to the next line; else why).
struct ChunkLine {
  res: Int
  size: Int
  next: Int
  excess: Int
  why: Str = ""
}

/// The chunk size line at offset i of s (b its bytes; eof: no more will
/// come), with excess the non-data count of the lines before it
/// (net/http's chunkedReader.beginChunk).
fn chunk_line(s: Str, b: Bytes, i: Int, eof: Bool, excess0: Int) -> ChunkLine {
  let n = b.len()
  var excess = excess0
  let nl = if i < n { scan.find_byte(s.bytes(), i, s.len(), 10) } else { -1 }
  if nl < 0 {
    if n - i >= 4096 {
      return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "header line too long"}
    }
    return ChunkLine{res: if eof { HB_ERR } else { HB_NEED }, size: 0, next: i, excess: excess, why: "unexpected EOF"}
  }
  let e = nl
  // CRLF required, no other CR
  let cr = bfind(b, 13, i, e + 1)
  if cr < 0 {
    return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "chunked line ends with bare LF"}
  }
  if cr != e - 1 {
    return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "invalid CR in chunked line"}
  }
  let ll = e - 1 - i
  if ll >= 4096 {
    return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "header line too long"}
  }
  excess += ll + 2
  var z = i + ll
  while z > i && is_sp(Int(b[z - 1])) {
    z -= 1
  }
  let semi = bfind(b, 59, i, z)
  if semi >= 0 {
    z = semi
  }
  if z == i {
    return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "empty hex number for chunk length"}
  }
  // the size as a UInt64 (a negative Int is at least 2^63)
  var size = 0
  var k = i
  while k < z {
    let c = Int(b[k])
    if (cls(c) & HEX) == 0 {
      return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "invalid byte in chunk length"}
    }
    if k - i == 16 {
      return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "http chunk length too large"}
    }
    size = size.wrapping_shl(4) | unhex(c)
    k += 1
  }
  let capped = if size < 0 || size > MAX_INT / 4 { MAX_INT / 4 } else { size }
  excess -= 16 + 2 * capped
  if excess < 0 {
    excess = 0
  }
  if excess > 16 * 1024 {
    return ChunkLine{res: HB_ERR, size: 0, next: i, excess: excess, why: "chunked encoding contains too much non-data"}
  }
  ChunkLine{res: HB_OK, size: size, next: e + 1, excess: excess}
}

/// Decodes the chunked body at the start of s (eof: no more will come),
/// as net/http's chunkedReader and the trailer reading of
/// body.readTrailer.
pub fn chunked(s: Str, eof: Bool) -> Chunked {
  let b = s.bytes()
  let n = b.len()
  var out = ""
  var i = 0
  var excess = 0
  while true {
    let l = chunk_line(s, b, i, eof, excess)
    if l.res != HB_OK {
      return Chunked{res: l.res, used: 0, body: out, why: l.why}
    }
    excess = l.excess
    let size = l.size
    i = l.next
    if size == 0 {
      // the trailer: CRLF, or a MIME header up to an empty line
      if n - i < 2 {
        return Chunked{res: if eof { HB_ERR } else { HB_NEED }, used: 0, body: out, why: "http: unexpected EOF reading trailer"}
      }
      if b[i] == 13 && b[i + 1] == 10 {
        return Chunked{res: HB_OK, used: i + 2, body: out}
      }
      // up to a double CRLF within 4096 bytes
      let lim = if n - i < 4096 { n - i } else { 4096 }
      var end = -1
      var q = 3
      while q < lim {
        if b[i + q - 3] == 13 && b[i + q - 2] == 10 && b[i + q - 1] == 13 && b[i + q] == 10 {
          end = i + q + 1
          break
        }
        q += 1
      }
      if end < 0 {
        if n - i >= 4096 || eof {
          return Chunked{res: HB_ERR, used: 0, body: out, why: "http: suspiciously long trailer after chunked body"}
        }
        return Chunked{res: HB_NEED, used: 0, body: out}
      }
      // the trailer is a MIME header up to its first empty line (a bare
      // LF ends it too)
      // (up to the empty line found: the rest does not change the parse)
      let t = parse_head("GET / HTTP/1.0\r\n" + rawb.str_slice(s, i, end), eof)
      if t.res == NEED {
        return Chunked{res: HB_NEED, used: 0, body: out}
      }
      if t.res != OK && t.res != STATUS {
        let (_, _, tw) = mime_header(s, b, i, end)
        return Chunked{res: HB_ERR, used: 0, body: out, why: if tw.is_empty() { "malformed trailer" } else { tw }}
      }
      return Chunked{res: HB_OK, used: i + t.used - 16, body: out}
    }
    if size < 0 || size > n - i || (n - i) - size < 2 {
      // copy what is there: an error later still delivers it
      let have = if size >= 0 && size < n - i { size } else { n - i }
      out = rt.rs_append_bytes(out, b, i, i + have, 0)
      return Chunked{res: if eof { HB_ERR } else { HB_NEED }, used: 0, body: out, why: "unexpected EOF"}
    }
    out = rt.rs_append_bytes(out, b, i, i + size, 0)
    i += size
    if b[i] != 13 || b[i + 1] != 10 {
      return Chunked{res: HB_ERR, used: 0, body: out, why: "malformed chunked encoding"}
    }
    i += 2
  }
  Chunked{res: HB_ERR, used: 0, body: out}
}

// ---------------------------------------------------------------------------
// The server's HTTP/1.1 connections (xo_http.c's hc_read_one, the
// response, and a stream's writes; the zero-C audit's B28): the input
// buffer, the request's body, the response header, and the flags the
// writer (http1w.xo) answers with are a record of this module, X1, whose
// address the C's connection keeps (xo_hc_set_x1) and frees with it
// (cabi_http.xo h1_free). The C keeps the socket and TLS reads and
// writes (hconn.recv, hc_send), the server's registration, and
// HTTP/2.

/// The X1 record's words: the input (a malloc'd block, its length, its
/// capacity, the unread input's start), the end of the stream seen,
/// whether the last request was a POST, whether a response was written,
/// the writer's request flags (http1w.F_*), the response header (a
/// vector of http1w.xo's 32 byte fields, each name and value a malloc'd
/// block: the address, the count, the capacity), the request's body (a
/// malloc'd block, its length, its capacity), and the largest body read.
const X_BUF = 0
const X_N = 8
const X_CAP = 16
const X_OFF = 24
const X_EOF = 32
const X_LAST_POST = 40
const X_SERVED = 48
const X_FLAGS = 56
const X_HDR = 64
const X_HN = 72
const X_HCAP = 80
const X_BODY = 88
const X_BODY_N = 96
const X_BODY_CAP = 104
const X_MAX = 112
/// A streamed body (decision 0310, body_next): its mode (S_*), the bytes
/// left of its Content-Length or of the current chunk, the chunk lines'
/// non-data count, whether a chunk's CRLF is due, whether 100 Continue
/// is due, and the request's number (a reader kept past its request
/// reads nothing).
const X_SMODE = 120
const X_SLEFT = 128
const X_SEXCESS = 136
const X_SCRLF = 144
const X_S100 = 152
const X_SSEQ = 160
/// The server's limits (std.md 4.4, set_limits): the head bytes cap
/// (MAX_HEAD when 0), the body cap (max_body() when 0), the idle, head
/// and read timeouts in ns (0 none), and the absolute deadline of the
/// request being read (0 none; set at its first byte).
const X_MAX_HEAD = 168
const X_MAX_BODY = 176
const X_IDLE_NS = 184
const X_HEAD_NS = 192
const X_READ_NS = 200
const X_DEADLINE = 208
const X_HDR_DEADLINE = 216
const X_SIZE = 224

/// The modes of a streamed body: none (read before the handler), a
/// Content-Length body, a chunked one, read to its end, failed, closed
/// (the handler returned).
const S_NONE = 0
const S_CLEN = 1
const S_CHUNKED = 2
const S_END = 3
const S_ERR = 4
const S_CLOSED = 5

/// A request body longer than this is cut short like a body whose client
/// went away (the handler gets what was read, the connection closes); Go
/// has no limit; XO_HTTP_MAX_BODY overrides (bytes).
const HTTP_MAX_BODY: Int = 67108864

fn xl(x: Int, k: Int) -> Int { rt.mem_load(x, k, 8) }

fn xs(x: Int, k: Int, v: Int) { rt.mem_store(x, k, v, 8) }

/// Room for n more bytes in the block at x+k (address, length, capacity
/// at k, k+8, k+16).
fn x_room(x: Int, k: Int, n: Int) {
  let len = xl(x, k + 8)
  let cap = xl(x, k + 16)
  if len + n <= cap {
    return
  }
  var c = if cap == 0 { 8192 } else { 2 * cap }
  while c < len + n {
    c = 2 * c
  }
  // a block used from its malloc'd address: raw.c_resize keeps word 0
  // (gotchas/heap-large-resize-overwrites-word-0.md)
  xs(x, k, raw.c_resize(xl(x, k), c))
  xs(x, k + 16, c)
}

/// Appends the n bytes at p to the block at x+k.
fn x_put(x: Int, k: Int, p: Int, n: Int) {
  if n <= 0 {
    return
  }
  x_room(x, k, n)
  rt.mem_copy(xl(x, k) + xl(x, k + 8), p, n)
  xs(x, k + 8, xl(x, k + 8) + n)
}

fn x_free(p: Int) {
  if p != 0 {
    rt.heap_release(p)
  }
}

/// The largest body (XO_HTTP_MAX_BODY, else HTTP_MAX_BODY).
pub fn max_body() -> Int {
  let e = process.real_env_get("XO_HTTP_MAX_BODY")
  if e.is_empty() {
    return HTTP_MAX_BODY
  }
  // atoll: the leading digits
  var v = 0
  for c in e[0].bytes() {
    if c < 48 || c > 57 {
      break
    }
    v = v * 10 + Int(c) - 48
  }
  if v > 0 { v } else { HTTP_MAX_BODY }
}

/// The X1 record of connection h, made on first use.
fn x1_of(h: rthttp.HConn) -> Int {
  var x = hconn.x1(h)
  if x == 0 {
    x = rt.heap_large(X_SIZE)
    rt.mem_set(x, 0, X_SIZE)
    xs(x, X_MAX, max_body())
    hconn.set_x1(h, x)
  }
  x
}

/// Frees an X1 record (the C's connection is freed).
pub fn x1_free(x: Int) {
  x_free(xl(x, X_BUF))
  x_free(xl(x, X_BODY))
  hdr_clear(x)
  x_free(xl(x, X_HDR))
  rt.heap_release(x - 8)
}

/// Empties the response header.
fn hdr_clear(x: Int) {
  let a = xl(x, X_HDR)
  for i in 0..xl(x, X_HN) {
    x_free(rt.mem_load(a, 32 * i, 8))
    x_free(rt.mem_load(a, 32 * i + 16, 8))
  }
  xs(x, X_HN, 0)
}

/// A malloc'd copy of s (its address; 0 for "").
fn blk_of(s: Str) -> Int {
  if s.is_empty() {
    return 0
  }
  let b = rt.heap_large(s.len()) - 8
  rt.mem_copy(b, raw.data(s), s.len())
  b
}

/// Header.Set of the response: the name canonical, a later value
/// replaces an earlier one (xo_hc_header).
pub fn header_set(h: rthttp.HConn, name: Str, value: Str) { hdr_set(x1_of(h), canonical_key(name), value) }

/// One more field of name (decision 0288: a response's repeated fields,
/// such as Set-Cookie), after any of the same name.
pub fn header_add(h: rthttp.HConn, name: Str, value: Str) { hdr_append(x1_of(h), canonical_key(name), value) }

fn hdr_set(x: Int, k: Str, v: Str) {
  let a = xl(x, X_HDR)
  let n = xl(x, X_HN)
  for i in 0..n {
    let e = a + 32 * i
    if http1w.mem_is(rt.mem_load(e, 0, 8), rt.mem_load(e, 8, 8), k) {
      x_free(rt.mem_load(e, 16, 8))
      rt.mem_store(e, 16, blk_of(v), 8)
      rt.mem_store(e, 24, v.len(), 8)
      return
    }
  }
  hdr_append(x, k, v)
}

fn hdr_append(x: Int, k: Str, v: Str) {
  let n = xl(x, X_HN)
  if n == xl(x, X_HCAP) {
    let c = if n == 0 { 8 } else { 2 * n }
    xs(x, X_HDR, raw.c_resize(xl(x, X_HDR), 32 * c))
    xs(x, X_HCAP, c)
  }
  let e = xl(x, X_HDR) + 32 * n
  rt.mem_store(e, 0, blk_of(k), 8)
  rt.mem_store(e, 8, k.len(), 8)
  rt.mem_store(e, 16, blk_of(v), 8)
  rt.mem_store(e, 24, v.len(), 8)
  xs(x, X_HN, n + 1)
}

/// The response header of h (an HTTP/2 stream's too, h2srv.xo): its
/// fields (http1w.xo's 32 byte form) and their count; whether it has
/// field k (canonical); setting k (canonical) to v; emptying it.
pub fn hdr_addr(h: rthttp.HConn) -> Int { xl(x1_of(h), X_HDR) }

pub fn hdr_len(h: rthttp.HConn) -> Int { xl(x1_of(h), X_HN) }

pub fn hdr_has(h: rthttp.HConn, k: Str) -> Bool { http1w.find(hdr_addr(h), hdr_len(h), k) >= 0 }

pub fn hdr_put(h: rthttp.HConn, k: Str, v: Str) { hdr_set(x1_of(h), k, v) }

pub fn hdr_reset(h: rthttp.HConn) { hdr_clear(x1_of(h)) }

/// Sends the n bytes at p on h: false when the connection broke.
fn send(h: rthttp.HConn, p: Int, n: Int) -> Bool { hconn.send_at(h, p, n) }

fn send_str(h: rthttp.HConn, s: Str) -> Bool { send(h, raw.data(s), s.len()) }

/// Reads more input into x: the bytes read, 0 at the end of the stream,
/// -1 when the connection was closed, the task canceled, or (idle: no
/// part of a request came yet) the server stopping.
fn fill(h: rthttp.HConn, x: Int) -> Int {
  if xl(x, X_OFF) > 0 && xl(x, X_OFF) == xl(x, X_N) {
    xs(x, X_OFF, 0)
    xs(x, X_N, 0)
  }
  if xl(x, X_CAP) - xl(x, X_N) < 4096 {
    let off = xl(x, X_OFF)
    if off > 0 {
      rt.mem_move(xl(x, X_BUF), xl(x, X_BUF) + off, xl(x, X_N) - off)
      xs(x, X_N, xl(x, X_N) - off)
      xs(x, X_OFF, 0)
    }
    x_room(x, X_BUF, 4096)
  }
  let idle = xl(x, X_OFF) == xl(x, X_N)
  let r = hconn.recv_until(h, xl(x, X_BUF) + xl(x, X_N), xl(x, X_CAP) - xl(x, X_N), idle, read_deadline(x, idle))
  if r > 0 {
    xs(x, X_N, xl(x, X_N) + r)
  }
  r
}

/// The deadline of a read (std.md 4.4): waiting for a request's first
/// byte, the idle timeout (else the read timeout); after it, the sooner
/// of the request's read deadline and its head deadline (0: none). The
/// request's deadline starts at its first byte (X_DEADLINE, cleared by
/// read_one when the head is complete and set again for the body).
fn read_deadline(x: Int, idle: Bool) -> Int {
  if idle {
    xs(x, X_DEADLINE, 0)
    let d = if xl(x, X_IDLE_NS) > 0 { xl(x, X_IDLE_NS) } else { xl(x, X_READ_NS) }
    return if d > 0 { hconn.deadline(d) } else { 0 }
  }
  var dl = xl(x, X_DEADLINE)
  if dl == 0 && xl(x, X_READ_NS) > 0 {
    dl = hconn.deadline(xl(x, X_READ_NS))
    xs(x, X_DEADLINE, dl)
  }
  let hn = xl(x, X_HEAD_NS)
  if hn > 0 && xl(x, X_HDR_DEADLINE) == 0 {
    xs(x, X_HDR_DEADLINE, hconn.deadline(hn))
  }
  let hd = xl(x, X_HDR_DEADLINE)
  if hd > 0 && (dl == 0 || hd < dl) { hd } else { dl }
}

/// The unread input up to n bytes of it.
fn input(x: Int, n: Int) -> Str { if n <= 0 { "" } else { raw.str_at(xl(x, X_BUF) + xl(x, X_OFF), n) } }

/// The length of the unread input up to the end of its first head (the
/// first empty line: \n\n or \n\r\n), or all of it when it has none yet:
/// a pipelined request's parse is the whole input's.
fn head_len(x: Int) -> Int {
  let p = xl(x, X_BUF) + xl(x, X_OFF)
  let n = xl(x, X_N) - xl(x, X_OFF)
  // from one \n to the next, eight bytes a step (a byte at a time was
  // the largest cost of read_one)
  var i = 0
  while true {
    let nl = scan.mem_byte(p, i, n, 10)
    if nl < 0 {
      return n
    }
    let e = nl + 1
    if e < n && rt.mem_load(p, e, 1) == 10 {
      return e + 1
    }
    if e + 1 < n && rt.mem_load(p, e, 1) == 13 && rt.mem_load(p, e + 1, 1) == 10 {
      return e + 2
    }
    i = e
  }
  n
}

/// The HTTP/1.1 requests of a server connection.
pub struct Reader {
  h: rthttp.HConn
  x: Int
  /// The head of the request being read.
  head: Head
  /// Whether a request's route reads its body itself (decision 0310):
  /// given its method and path; none: every body is read first.
  streams: List[fn(Str, Str) -> Bool] = []
}

/// A server's limits (std.md 4.4): 0 is the default of each.
pub struct Limits {
  pub read_ns: Int = 0
  pub head_ns: Int = 0
  pub idle_ns: Int = 0
  pub max_head: Int = 0
  pub max_body: Int = 0
}

/// Stores the server's limits on the connection's record.
pub fn set_limits(h: rthttp.HConn, lim: Limits) {
  let x = x1_of(h)
  xs(x, X_MAX_HEAD, lim.max_head)
  xs(x, X_MAX_BODY, lim.max_body)
  xs(x, X_IDLE_NS, lim.idle_ns)
  xs(x, X_HEAD_NS, lim.head_ns)
  xs(x, X_READ_NS, lim.read_ns)
}

/// The head bytes cap of the connection: with_max_header_bytes plus
/// net/http's 4096 bytes of bufio slop (initialReadLimitSize), MAX_HEAD
/// when the server set none.
fn head_cap(x: Int) -> Int { let m = xl(x, X_MAX_HEAD); if m > 0 { m + 4096 } else { MAX_HEAD } }

/// The reader of the connection.
pub fn reader(h: rthttp.HConn) -> Reader { Reader{h: h, x: x1_of(h), head: no_head()} }

/// The reader of the connection that leaves the body of a request for
/// which streams(method, path) holds to the handler (body_next).
pub fn reader_streaming(h: rthttp.HConn, streams: fn(Str, Str) -> Bool) -> Reader { Reader{h: h, x: x1_of(h), head: no_head(), streams: [streams]} }

/// The number of the request read last when its body is streamed, else
/// 0.
pub fn (r: Reader) streamed() -> Int { if xl(r.x, X_SMODE) == S_NONE { 0 } else { xl(r.x, X_SSEQ) } }

/// The request std/rt's serve hands to Xo code (Request's parts).
pub struct Req {
  pub method: Str
  /// The URL's path (unescaped; Request.path).
  pub path: Str
  pub scheme: Str
  /// Request.url.host: the Host without a port, or all of it when it has
  /// none.
  pub host: Str
  /// The port of an absolute request target, or -1.
  pub port: Int
  /// [name, value, ...]
  pub headers: List[Str]
  /// [key, value, ...]
  pub query: List[Str]
  /// The URL's raw query, for Request.query_all (decision 0279).
  pub rawquery: Str
  /// Head.fields (decision 0288)
  pub fields: List[Str] = []
  /// The request target as sent (Request.escaped_path).
  pub target: Str = ""
  /// The Host header as sent (Request.host).
  pub rawhost: Str = ""
}

/// The next request (its body read: body), or None when the connection
/// is done (the end of the stream, an error answered, the server
/// stopping, the task canceled).
pub fn (var r: Reader) read() -> Req? {
  while true {
    let k = r.read_one()
    if k == 1 {
      let q = req_of(r.head)
      fault_probe(q.path, "conn")
      return Some(q)
    }
    if k != 2 {
      return None
    }
  }
  None
}

/// The connection.
pub fn (r: Reader) conn() -> rthttp.HConn { r.h }

/// The input read past the last request (a connection handed over,
/// decision 0313), taken: the reader has none left.
pub fn take_rest(h: rthttp.HConn) -> Bytes {
  let x = x1_of(h)
  let n = xl(x, X_N) - xl(x, X_OFF)
  let out = input(x, n).bytes()
  xs(x, X_OFF, xl(x, X_N))
  out
}

/// The servers' fault probe, a test hook (internal/llvm golden
/// http_conn_fault): with XO_HTTP_FAULT_PROBE=1, a request for
/// /xo-fault-probe/<at> faults where this is called (at: "conn", in the
/// HTTP/1.1 reader; "frame", in h2srv.xo's frame handling; "stream", in
/// an HTTP/2 stream's request), outside a handler's isolation. A string
/// compare a request otherwise; std/rt's serve has the same probe.
pub fn fault_probe(path: Str, at: Str) {
  if path.len() == 16 + at.len() && path.starts_with("/xo-fault-probe/") && path.ends_with(at) {
    if (process.real_env_get("XO_HTTP_FAULT_PROBE").get(0) ?? "") == "1" {
      fault("http fault probe: ${at}")
    }
  }
}

/// The body of the request read last.
pub fn (r: Reader) body() -> Bytes {
  let n = xl(r.x, X_BODY_N)
  if n == 0 { b"" } else { raw.str_at(xl(r.x, X_BODY), n).bytes() }
}

/// Reads a request (xo_http.c hc_read_one): 1 when it is ready for the
/// handler, 2 when it was answered here (OPTIONS *), 0 when the
/// connection is done.
fn (var r: Reader) read_one() -> Int {
  let h = r.h
  let x = r.x
  xs(x, X_BODY_N, 0)
  xs(x, X_FLAGS, 0)
  hdr_clear(x)
  // after a POST, up to 4 CR or LF bytes before the next request
  // (conn.readRequest's tolerance for old clients)
  var skip = xl(x, X_LAST_POST) != 0
  // after a response, conn.serve peeks 4 bytes before it reads the next
  // request: fewer at the end of the stream close the connection
  var peek = xl(x, X_SERVED) != 0
  var p = fail(NEED)
  while true {
    let have = xl(x, X_N) - xl(x, X_OFF)
    let eof = xl(x, X_EOF) != 0
    if peek {
      if have >= 4 {
        peek = false
      } else if eof {
        return 0
      }
    }
    if !peek && skip && (have >= 4 || eof) {
      var k = 0
      while k < 4 && xl(x, X_OFF) < xl(x, X_N) {
        let c = rt.mem_load(xl(x, X_BUF), xl(x, X_OFF), 1)
        if c != 13 && c != 10 {
          break
        }
        xs(x, X_OFF, xl(x, X_OFF) + 1)
        k += 1
      }
      skip = false
    }
    var res = NEED
    if !peek && !skip {
      let hl = head_len(x)
      if hl > head_cap(x) {
        // over with_max_header_bytes (std.md 4.4): 431, as MAX_HEAD's
        p = fail(TOO_LARGE)
        res = TOO_LARGE
      } else {
        p = parse_head(input(x, hl), eof)
        res = p.res
      }
    }
    if res == NEED {
      if eof {
        skip = false
        continue
      }
      // wait for more; idle when nothing of a request came yet
      let got = fill(h, x)
      if got < 0 {
        // -2: the read or head timeout passed while the head was read;
        // net/http closes without a reply (a timeout is a common net
        // read error to conn.serve)
        return 0
      }
      if got == 0 {
        xs(x, X_EOF, 1)
      }
      continue
    }
    if res == EOF {
      return 0
    }
    if res != OK {
      let d = rt.heap_large(256)
      let n = http1w.error_answer(d, res, p.status, if res == STATUS { p.reason } else { "" })
      let _s = send(h, d, n)
      rt.heap_release(d - 8)
      if res == TOO_LARGE {
        hconn.shut_wr(h)
      }
      return 0
    }
    xs(x, X_OFF, xl(x, X_OFF) + p.used)
    break
  }
  // the head is complete: the head deadline is done, the request's stays
  // for the body
  xs(x, X_HDR_DEADLINE, 0)
  let q = p.head
  r.head = q
  xs(x, X_LAST_POST, if q.method == "POST" { 1 } else { 0 })
  var f = 0
  if q.major > 1 || (q.major == 1 && q.minor >= 1) {
    f = f | http1w.F_HTTP11
  }
  if q.method == "HEAD" {
    f = f | http1w.F_HEAD
  }
  if q.h2up {
    f = f | http1w.F_H2UP
  }
  if q.wants10ka {
    f = f | http1w.F_WANTS10KA
  }
  if q.wantsclose {
    f = f | http1w.F_WANTSCLOSE
  }
  if q.clen != 0 {
    f = f | http1w.F_HAS_BODY
  }
  xs(x, X_FLAGS, f)
  if q.expect_other {
    // sendExpectationFailed
    hdr_set(x, "Connection", "close")
    let _k = write(h, x, 417, 0, 0, 0)
    hdr_clear(x)
    return 0
  }
  xs(x, X_SMODE, S_NONE)
  if !r.streams.is_empty() && !(q.method == "OPTIONS" && q.target == "*") && r.streams[0](q.method, q.url.path) {
    // the handler reads the body (body_next); 100 Continue on its first
    // read, as net/http's expectContinueReader
    xs(x, X_SSEQ, xl(x, X_SSEQ) + 1)
    xs(x, X_SLEFT, 0)
    xs(x, X_SEXCESS, 0)
    xs(x, X_SCRLF, 0)
    // 1: 100 Continue due on the first read; 2: sent
    xs(x, X_S100, if q.expect100 { 1 } else { 0 })
    if q.clen == 0 {
      xs(x, X_SMODE, S_END)
    } else if q.chunked {
      xs(x, X_SMODE, S_CHUNKED)
    } else {
      xs(x, X_SMODE, S_CLEN)
      xs(x, X_SLEFT, q.clen)
    }
    return 1
  }
  if q.clen != 0 {
    if q.expect100 {
      let _c = send_str(h, "HTTP/1.1 100 Continue\r\n\r\n")
    }
    let max = if xl(x, X_MAX_BODY) > 0 { xl(x, X_MAX_BODY) } else { xl(x, X_MAX) }
    var short_body = false
    while true {
      let have = xl(x, X_N) - xl(x, X_OFF)
      let eof = xl(x, X_EOF) != 0
      if q.chunked {
        // the first 4 KiB, then (when they end before the body does) all
        let win = if have > 4096 { 4096 } else { have }
        let cut = win < have
        var c = chunked(input(x, win), eof && !cut)
        // (an error too: a line cut by the window's end looks too long)
        if c.res != HB_OK && cut {
          c = chunked(input(x, have), eof)
        }
        xs(x, X_BODY_N, 0)
        x_put(x, X_BODY, raw.data(c.body), c.body.len())
        if c.res == HB_OK {
          xs(x, X_OFF, xl(x, X_OFF) + c.used)
          break
        }
        if c.res == HB_ERR || xl(x, X_BODY_N) > max {
          // a sticky error of the chunked reader: net/http closes the
          // connection after the response
          xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_BODY_BAD)
          xs(x, X_OFF, xl(x, X_N))
          break
        }
      } else {
        let want = if q.clen < max { q.clen } else { max }
        if have >= want {
          x_put(x, X_BODY, xl(x, X_BUF) + xl(x, X_OFF), want)
          xs(x, X_OFF, xl(x, X_OFF) + want)
          if q.clen > max {
            xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_TOO_BIG)
          }
          break
        }
        if eof {
          // the client ended the body early: the handler gets what came
          // (std/rt ignores the error)
          x_put(x, X_BODY, xl(x, X_BUF) + xl(x, X_OFF), have)
          xs(x, X_OFF, xl(x, X_N))
          short_body = true
          if q.clen - have >= 262144 {
            xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_TOO_BIG)
          }
          break
        }
      }
      let got = fill(h, x)
      if got < 0 {
        return 0
      }
      if got == 0 {
        xs(x, X_EOF, 1)
      }
    }
    // the 100-continue reader saw no end of the body: net/http closes
    // after the response
    if q.expect100 && (short_body || (xl(x, X_FLAGS) & http1w.F_BODY_BAD) != 0) {
      xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_EXPECT_UNREAD)
    }
    if xl(x, X_MAX_BODY) > 0 && (xl(x, X_FLAGS) & http1w.F_TOO_BIG) != 0 {
      // over with_max_body (std.md 4.4): 413 with MaxBytesReader's text,
      // the connection closed (the rest of the body is never read)
      let d = rt.heap_large(256)
      let n = http1w.error_answer(d, BODY_TOO_BIG, 413, "")
      let _s = send(h, d, n)
      rt.heap_release(d - 8)
      hconn.shut_wr(h)
      return 0
    }
  }
  if q.method == "OPTIONS" && q.target == "*" {
    // net/http answers it itself (globalOptionsHandler), reading at most
    // 4 KiB of its body
    hdr_set(x, "Content-Length", "0")
    if xl(x, X_BODY_N) > 4096 {
      // MaxBytesReader: requestTooLarge sets the handler's header
      hdr_set(x, "Connection", "close")
    }
    let k = write(h, x, 200, 0, 0, 0)
    hdr_clear(x)
    xs(x, X_SERVED, 1)
    return if (k & 4) == 0 && (k & http1w.R_KEEP) != 0 { 2 } else { 0 }
  }
  1
}

// ---------------------------------------------------------------------------
// Streamed request bodies (decision 0310)

/// A read of a streamed body: data, or the end, or an error's text.
pub struct BodyPart {
  pub data: Str
  pub end: Bool
  pub err: Str
}

fn part_err(x: Int, why: Str) -> BodyPart {
  xs(x, X_SMODE, S_ERR)
  BodyPart{data: "", end: false, err: why}
}

/// The next bytes of the body of request seq on h (at most max, at
/// least one), its end, or an error (net/http's body.Read: a body cut
/// short is "unexpected EOF"; a chunked body's errors are its
/// chunkedReader's). An error sticks.
pub fn body_next(h: rthttp.HConn, seq: Int, max: Int) -> BodyPart {
  let x = x1_of(h)
  let mode = xl(x, X_SMODE)
  if xl(x, X_SSEQ) != seq || mode == S_CLOSED || mode == S_NONE {
    return BodyPart{data: "", end: false, err: "http: invalid Read on closed Body"}
  }
  if mode == S_END {
    return BodyPart{data: "", end: true, err: ""}
  }
  if mode == S_ERR {
    return BodyPart{data: "", end: false, err: "http: read on a failed body"}
  }
  if xl(x, X_S100) == 1 {
    // (2: sent; body_finish asks whether one was expected)
    xs(x, X_S100, 2)
    let _c = send_str(h, "HTTP/1.1 100 Continue\r\n\r\n")
  }
  while true {
    let have = xl(x, X_N) - xl(x, X_OFF)
    let eof = xl(x, X_EOF) != 0
    let left = xl(x, X_SLEFT)
    if left > 0 && have > 0 {
      // data: of the Content-Length, or of the current chunk
      var n = if have < left { have } else { left }
      if n > max {
        n = max
      }
      let out = raw.str_at(xl(x, X_BUF) + xl(x, X_OFF), n)
      xs(x, X_OFF, xl(x, X_OFF) + n)
      xs(x, X_SLEFT, left - n)
      if mode == S_CLEN && left == n {
        xs(x, X_SMODE, S_END)
      }
      if mode == S_CHUNKED && left == n {
        xs(x, X_SCRLF, 1)
      }
      return BodyPart{data: out, end: false, err: ""}
    }
    if mode == S_CHUNKED && left == 0 {
      if xl(x, X_SCRLF) != 0 && have >= 2 {
        let p = xl(x, X_BUF) + xl(x, X_OFF)
        if rt.mem_load(p, 0, 1) != 13 || rt.mem_load(p, 1, 1) != 10 {
          return part_err(x, "malformed chunked encoding")
        }
        xs(x, X_OFF, xl(x, X_OFF) + 2)
        xs(x, X_SCRLF, 0)
        continue
      }
      if xl(x, X_SCRLF) == 0 {
        // a line, or the last one and its trailer, fit in 8 KiB: more
        // of the input is not copied
        let win = if have > 8448 { 8448 } else { have }
        let s = input(x, win)
        let weof = eof && win == have
        let l = chunk_line(s, s.bytes(), 0, weof, xl(x, X_SEXCESS))
        if l.res == HB_ERR {
          return part_err(x, l.why)
        }
        if l.res == HB_OK && l.size != 0 {
          xs(x, X_SEXCESS, l.excess)
          xs(x, X_SLEFT, l.size)
          xs(x, X_OFF, xl(x, X_OFF) + l.next)
          continue
        }
        if l.res == HB_OK {
          // the last chunk and the trailer, as the whole body's reader
          let c = chunked(s, weof)
          if c.res == HB_ERR {
            return part_err(x, c.why)
          }
          if c.res == HB_OK {
            xs(x, X_OFF, xl(x, X_OFF) + c.used)
            xs(x, X_SMODE, S_END)
            return BodyPart{data: "", end: true, err: ""}
          }
        }
      }
    }
    if eof {
      return part_err(x, "unexpected EOF")
    }
    let got = fill(h, x)
    if got < 0 {
      return part_err(x, "unexpected EOF")
    }
    if got == 0 {
      xs(x, X_EOF, 1)
    }
  }
  BodyPart{data: "", end: true, err: ""}
}

/// After the handler of request seq with a streamed body, as net/http's
/// chunkWriter.writeHeader: an Expect: 100-continue body not read to its
/// end closes the connection; else the rest is discarded when it is less
/// than 256 KiB (a Content-Length body with that much left, or more read
/// here, sends Connection: close and closes; a failed read closes).
/// Reads of the body fail from then on.
pub fn body_finish(h: rthttp.HConn, seq: Int) {
  let x = x1_of(h)
  if xl(x, X_SSEQ) != seq {
    return
  }
  let mode = xl(x, X_SMODE)
  if mode == S_NONE || mode == S_CLOSED {
    return
  }
  let expect = xl(x, X_S100) != 0
  if expect && mode != S_END {
    xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_EXPECT_UNREAD)
  } else if mode == S_ERR {
    xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_BODY_BAD)
  } else if mode == S_CLEN && xl(x, X_SLEFT) >= MAX_POST_HANDLER_READ {
    xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_TOO_BIG)
  } else if mode != S_END {
    // io.CopyN(io.Discard, body, 256 KiB + 1)
    var n = 0
    while true {
      let p = body_next(h, seq, MAX_POST_HANDLER_READ + 1 - n)
      if !p.err.is_empty() {
        xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_BODY_BAD)
        break
      }
      if p.end {
        break
      }
      n += p.data.len()
      if n > MAX_POST_HANDLER_READ {
        xs(x, X_FLAGS, xl(x, X_FLAGS) | http1w.F_TOO_BIG)
        break
      }
    }
  }
  xs(x, X_SMODE, S_CLOSED)
}

/// net/http's maxPostHandlerReadBytes.
const MAX_POST_HANDLER_READ = 262144

/// Writes the response of status with the bn bytes at body as net/http
/// does (http1w.response; stream: the head of a stream with its first
/// write) and sends it: http1w.R_* of the writer, with 4 when the send
/// failed.
fn write(h: rthttp.HConn, x: Int, status: Int, body: Int, bn: Int, stream: Int) -> Int {
  var room = 640 + bn + 24 * (bn / 2048 + 2)
  let a = xl(x, X_HDR)
  for i in 0..xl(x, X_HN) {
    room += 2 * (rt.mem_load(a, 32 * i + 8, 8) + rt.mem_load(a, 32 * i + 24, 8) + 4)
  }
  let d = rt.heap_large(room + 8)
  let res = d + room
  rt.mem_store(res, 0, 0, 8)
  let f = xl(x, X_FLAGS) | (if stream != 0 { http1w.F_STREAM } else { 0 })
  let n = http1w.response(d, a, xl(x, X_HN), status, body, bn, f, res)
  var r = rt.mem_load(res, 0, 8)
  if !send(h, d, n) {
    r = r | 4
  }
  rt.heap_release(d - 8)
  r
}

/// The response on h (xo_hc_respond for HTTP/1.1): whether the
/// connection stays open for another request.
pub fn respond(h: rthttp.HConn, status: Int, body: Bytes) -> Bool {
  let x = x1_of(h)
  let bn = body.len()
  if bn > 2048 && http1w.body_allowed(status) && http1w.find(xl(x, X_HDR), xl(x, X_HN), "Content-Length") < 0 {
    // std/rt sets Content-Length on a whole body net/http would
    // otherwise chunk (above its 2048 byte buffer); match it
    hdr_set(x, "Content-Length", "${bn}")
  }
  let k = write(h, x, status, raw.bytes_addr(body), bn, 0)
  let _keep = body.len()
  hdr_clear(x)
  xs(x, X_SERVED, 1)
  if (k & 4) != 0 || (k & http1w.R_KEEP) == 0 {
    return false
  }
  !hconn.stopping(h)
}

/// A stream's sink state bits (xo_http.c xo_sink): the head went out,
/// the body is chunked, the body goes raw, the connection stays open, a
/// send failed.
const SK_STARTED = 1
const SK_CHUNKING = 2
const SK_RAW = 4
const SK_KEEP = 8
const SK_FAILED = 16

/// Writes the n bytes at p of a stream on HTTP/1.1 connection h (status
/// its status; state the sink's SK_* bits) as net/http's chunkWriter
/// does: the head with the first data, then a chunk per write. The new
/// state.
pub fn emit(h: rthttp.HConn, status: Int, state: Int, p: Int, n: Int) -> Int {
  if (state & SK_FAILED) != 0 {
    return state
  }
  let x = x1_of(h)
  var s = state
  if (s & SK_STARTED) == 0 {
    s = s | SK_STARTED
    let k = write(h, x, status, p, n, 1)
    if (k & http1w.R_CHUNKED) != 0 {
      s = s | SK_CHUNKING
    } else if (xl(x, X_FLAGS) & http1w.F_HEAD) == 0 && http1w.body_allowed(status) {
      s = s | SK_RAW
    }
    if (k & http1w.R_KEEP) != 0 {
      s = s | SK_KEEP
    }
    if (k & 4) != 0 {
      s = s | SK_FAILED
    }
    hdr_clear(x)
    return s
  }
  if n > 0 && (s & SK_CHUNKING) != 0 {
    if !send_str(h, "${hex(n)}\r\n") || !send(h, p, n) || !send_str(h, "\r\n") {
      s = s | SK_FAILED
    }
  } else if n > 0 && (s & SK_RAW) != 0 {
    if !send(h, p, n) {
      s = s | SK_FAILED
    }
  }
  s
}

/// n in lower case hexadecimal.
fn hex(n: Int) -> Str {
  if n == 0 {
    return "0"
  }
  let digits = "0123456789abcdef".bytes()
  var out: List[Str] = []
  var v = n
  while v > 0 {
    out.push(rawb.byte_str(Int(digits[v % 16])))
    v = v / 16
  }
  var s = ""
  var i = out.len() - 1
  while i >= 0 {
    s = s + out[i]
    i -= 1
  }
  s
}

/// Ends a stream on HTTP/1.1 connection h whose head went out (state its
/// sink's bits, the n bytes at p still buffered): whether the
/// connection stays open for another request.
pub fn stream_end(h: rthttp.HConn, status: Int, state: Int, p: Int, n: Int) -> Bool {
  var s = state
  if n > 0 {
    s = emit(h, status, s, p, n)
  }
  if (s & SK_CHUNKING) != 0 && (s & SK_FAILED) == 0 && !send_str(h, "0\r\n\r\n") {
    s = s | SK_FAILED
  }
  xs(x1_of(h), X_SERVED, 1)
  if (s & SK_FAILED) != 0 || (s & SK_KEEP) == 0 {
    return false
  }
  !hconn.stopping(h)
}

/// The parts of the Request of a head (xo_http.c's hc_* accessors).
fn req_of(h: Head) -> Req {
  // Request.url.host: net.SplitHostPort of req.Host, else all of it
  let hb = h.host.bytes()
  let n = hb.len()
  var host = h.host
  let colon = rfind(hb, 58, n)
  if colon >= 0 {
    var lo = 0
    var hi = colon
    var ok = true
    var j = 0
    var k = 0
    if n > 0 && hb[0] == 91 {
      let end = scan.find(h.host, "]", 0)
      if end < 0 || end + 1 != colon {
        ok = false
      } else {
        lo = 1
        hi = end
        j = 1
        k = end + 1
      }
    } else if find(h.host, 58, 0, colon) >= 0 {
      ok = false
    }
    if ok && (scan.find(h.host, "[", j) >= 0 || scan.find(h.host, "]", k) >= 0) {
      ok = false
    }
    if ok {
      host = rawb.str_slice(h.host, lo, hi)
    }
  }
  // the port of the URL's host
  var port = -1
  let ub = h.url.host.bytes()
  let uc = rfind(ub, 58, ub.len())
  if uc >= 0 && uc + 1 < ub.len() && neturl.valid_port(ub, uc, ub.len()) {
    var v = 0
    var x = uc + 1
    var fits = true
    while x < ub.len() {
      let d = Int(ub[x]) - 48
      if v > (MAX_INT - d) / 10 {
        fits = false
        break
      }
      v = v * 10 + d
      x += 1
    }
    if fits {
      port = v
    }
  }
  Req{method: h.method, path: h.url.path, scheme: h.url.scheme, host: host, port: port, headers: h.headers, query: h.query, rawquery: h.url.rawquery, fields: h.fields, target: h.target, rawhost: h.host}
}

// ---------------------------------------------------------------------------
// HTTP/2 request targets (xo_h2.c's h2_request)

/// The parse of the first :path field of an HTTP/2 header block fragment
/// (data and lens as hpack.Fields'): [] when it has none, else [the
/// path, "1" when it parses (url.ParseRequestURI) or "", the URL's
/// scheme, host, path, and raw query, then the query's keys and first
/// values, the keys sorted] (rthttp.h2_fields, for h2_request).
pub fn h2_target(data: Str, lens: List[Int]) -> List[Str] {
  let b = data.bytes()
  let n = b.len()
  var off = 0
  for l in lens {
    let nn = l & 0xffffffff
    let vn = l >> 32
    if off + nn + vn > n {
      break
    }
    if nn == 5 && b[off] == 58 && b[off + 1] == 112 && b[off + 2] == 97 && b[off + 3] == 116 && b[off + 4] == 104 {
      let v = rawb.str_slice(data, off + 5, off + 5 + vn)
      let u = neturl.url_parse(v, true)
      if !u.ok {
        return [v, "", "", "", "", ""]
      }
      var out = [v, "1", u.scheme, u.host, u.path, u.rawquery]
      if !u.rawquery.is_empty() {
        for x in query_parts(u.rawquery) {
          out.push(x)
        }
      }
      return out
    }
    off += nn + vn
  }
  []
}

// ---------------------------------------------------------------------------
// The HTTP/2 client (xo_h2.c's hp_encode and hp_decode until audit item
// B11, its exchange until B29, 2026-10-14)
//
// hclient.cl_start sets an HTTP/2 exchange up (a pooled connection, or a
// new one whose ALPN chose h2, its preface and SETTINGS queued) and
// returns before the request: Xo makes the exchange of http2
// Transport.RoundTrip (h2_exchange): the request's HEADERS (its fields
// as httpcommon.EncodeHeaders lists them, the connection's encoder) and
// DATA within the server's windows, then the server's frames (SETTINGS,
// PING, WINDOW_UPDATE, GOAWAY, RST_STREAM, HEADERS and CONTINUATION,
// DATA) until the response ends, with Go's error texts. hclient.xo keeps
// the connection's reads and writes (h2_write, h2_read), the pool of
// connections, and the end (h2_end: the retry on a new connection, the
// failure's text); the C makes the connection (the dial, TLS). The
// connection's state between requests (HPACK, the windows, the server's
// settings, the next stream) is an H2State kept with the connection.

/// The state of a client HTTP/2 connection between requests.
struct H2State {
  dec: hpack.Dec
  enc: hpack.Enc
  // the server's SETTINGS_HEADER_TABLE_SIZE values the encoder has not
  // applied (4 bytes little endian each)
  sizes: Str
  peer_frame: Int
  // the server's initial stream window and its connection window
  peer_win: Int
  win: Int
  // our connection window (http2inflow)
  in_avail: Int
  in_unsent: Int
  next_id: Int
}

/// A new connection's state (h2cc_new's settings: the server's defaults,
/// our 1 GiB connection window).
fn h2_state() -> H2State {
  H2State{dec: hpack.decoder(hpack.TABLE), enc: hpack.encoder(), sizes: "", peer_frame: 16384, peer_win: 65535, win: 65535, in_avail: 1073741824, in_unsent: 0, next_id: 1}
}

/// The largest response header block (and string) the client decodes:
/// the 10 MiB of its SETTINGS_MAX_HEADER_LIST_SIZE.
const H2_MAX_RESP: Int = 10485760

/// checkConnHeaders: why HTTP/2 refuses the request's header (names
/// canonical, each once), "" when it does not.
fn h2_check(names: List[Str], values: List[Str]) -> Str {
  var i = 0
  while i < names.len() && i < values.len() {
    let k = names[i]
    let v = values[i]
    let bad = if k == "Upgrade" || k == "Transfer-Encoding" {
      !v.is_empty() && v != "chunked"
    } else if k == "Connection" {
      !v.is_empty() && v != "close" && v != "keep-alive"
    } else {
      false
    }
    if bad {
      return "http2: invalid " + k + " request header: [" + go_quote(v) + "]"
    }
    i += 1
  }
  ""
}

/// The value of the header's field k, and whether it has one.
fn h2_field(names: List[Str], values: List[Str], k: Str) -> (Str, Bool) {
  var i = 0
  while i < names.len() && i < values.len() {
    if names[i] == k {
      return (values[i], true)
    }
    i += 1
  }
  ("", false)
}

/// The ASCII lower case of s.
fn ascii_lower(s: Str) -> Str {
  let b = s.bytes()
  var i = 0
  while i < b.len() {
    if Int(b[i]) >= 65 && Int(b[i]) <= 90 {
      break
    }
    i += 1
  }
  if i == b.len() {
    return s
  }
  var out = rawb.str_slice(s, 0, i)
  while i < b.len() {
    out = rt.rs_push_word(out, lower(Int(b[i])), 1)
    i += 1
  }
  out
}

/// The header block of the request (httpcommon.EncodeHeaders): the
/// pseudo fields, the header's fields in lower case but the hop by hop
/// ones, a cookie field per pair (RFC 9113 8.2.3), content-length,
/// accept-encoding, and user-agent.
fn (var st: H2State) block(method: Str, target: Str, host: Str, names: List[Str], values: List[Str], bn: Int) -> Str {
  var blk = st.enc.field("", ":authority", host)
  blk = st.enc.field(blk, ":method", method)
  blk = st.enc.field(blk, ":path", target)
  blk = st.enc.field(blk, ":scheme", "https")
  var did_ua = false
  var i = 0
  while i < names.len() && i < values.len() {
    let k = names[i]
    let v = values[i]
    i += 1
    if k == "Host" || k == "Content-Length" || k == "Connection" || k == "Proxy-Connection" || k == "Transfer-Encoding" || k == "Upgrade" || k == "Keep-Alive" {
      continue
    }
    if k == "User-Agent" {
      did_ua = true
      if !v.is_empty() {
        blk = st.enc.field(blk, "user-agent", v)
      }
    } else if k == "Cookie" {
      let b = v.bytes()
      let n = b.len()
      var s = 0
      while true {
        let semi = bfind(b, 59, s, n)
        if semi < 0 {
          break
        }
        blk = st.enc.field(blk, "cookie", rawb.str_slice(v, s, semi))
        s = semi + 1
        while s < n && b[s] == 32 {
          s += 1
        }
      }
      if s < n {
        blk = st.enc.field(blk, "cookie", rawb.str_slice(v, s, n))
      }
    } else {
      blk = st.enc.field(blk, ascii_lower(k), v)
    }
  }
  if bn > 0 || method == "POST" || method == "PUT" || method == "PATCH" {
    blk = st.enc.field(blk, "content-length", "${bn}")
  }
  let (_, has_ae) = h2_field(names, values, "Accept-Encoding")
  let (_, has_range) = h2_field(names, values, "Range")
  if !has_ae && !has_range && method != "HEAD" {
    blk = st.enc.field(blk, "accept-encoding", "gzip")
  }
  if !did_ua {
    blk = st.enc.field(blk, "user-agent", "Go-http-client/2.0")
  }
  blk
}

/// cl_h2_read's result for a frame over our 16 KiB SETTINGS_MAX_FRAME_SIZE.
const CC_TOO_LARGE: Int = 104

// The frame types and flags the client reads and writes (RFC 9113 6).
const H2T_DATA: Int = 0
const H2T_HEADERS: Int = 1
const H2T_RST: Int = 3
const H2T_SETTINGS: Int = 4
const H2T_PING: Int = 6
const H2T_GOAWAY: Int = 7
const H2T_WINUP: Int = 8
const H2T_CONT: Int = 9
const H2F_END_STREAM: Int = 1
const H2F_ACK: Int = 1
const H2F_END_HEADERS: Int = 4
const H2F_PADDED: Int = 8
const H2F_PRIORITY: Int = 0x20

// cl_h2_end's flags.
const XF_BROKEN: Int = 1
const XF_REFUSED: Int = 2
const XF_SEEN: Int = 4
const XF_HEADERS: Int = 8
const XF_UNSENT: Int = 16
const XF_GOAWAY: Int = 32
/// the connection's stream ids ran out: not pooled
const XF_SPENT: Int = 64

/// http2ErrCode.String.
fn h2_err_name(c: Int) -> Str {
  let names = ["NO_ERROR", "PROTOCOL_ERROR", "INTERNAL_ERROR", "FLOW_CONTROL_ERROR", "SETTINGS_TIMEOUT", "STREAM_CLOSED", "FRAME_SIZE_ERROR", "REFUSED_STREAM", "CANCEL", "COMPRESSION_ERROR", "CONNECT_ERROR", "ENHANCE_YOUR_CALM", "INADEQUATE_SECURITY", "HTTP_1_1_REQUIRED"]
  if c >= 0 && c < names.len() {
    return names[c]
  }
  "unknown error code 0x" + hex_text(c)
}

/// The lower case hexadecimal text of v (at least one digit).
fn hex_text(v: Int) -> Str {
  let hex = b"0123456789abcdef"
  var out = ""
  var x = v
  while true {
    out = rt.rs_push_byte("", Int(hex[x & 15])) + out
    x = x >> 4
    if x == 0 {
      break
    }
  }
  out
}

fn be32_at(b: Bytes, i: Int) -> Int { (Int(b[i]) << 24) | (Int(b[i + 1]) << 16) | (Int(b[i + 2]) << 8) | Int(b[i + 3]) }

fn push_be32(s: Str, v: Int) -> Str {
  rt.rs_push_word(s, ((v >> 24) & 255) | (((v >> 16) & 255) << 8) | (((v >> 8) & 255) << 16) | ((v & 255) << 24), 4)
}

/// s with the 9 byte header of a frame.
fn push_frame(s: Str, len: Int, ty: Int, flags: Int, sid: Int) -> Str {
  let a = rt.rs_push_word(s, ((len >> 16) & 255) | (((len >> 8) & 255) << 8) | ((len & 255) << 16), 3)
  push_be32(rt.rs_push_word(a, ty | (flags << 8), 2), sid & 0x7FFFFFFF)
}

/// http2inflow.add: n more bytes received in a window of avail with
/// unsent owed; the new avail and unsent and the WINDOW_UPDATE to send (0:
/// none yet).
fn inflow_add(avail: Int, unsent: Int, n: Int) -> (Int, Int, Int) {
  let u = unsent + n
  if u < 4096 && u < avail {
    return (avail, u, 0)
  }
  (avail + u, 0, u)
}

/// One HTTP/2 exchange (xo_h2.c's h2x and h2rq until audit item B29).
/// An HTTP/2 exchange's state (h2_begin, h2_pump, h2_done); a stream
/// keeps it between reads (decision 0404 stage B2).
pub struct H2X {
  st: H2State
  method: Str
  body: Str
  off: Int
  close: Bool
  /// the frames to send next
  out: Str
  res: Int
  why: Str
  /// the connection is not to be used again, the server sent GOAWAY
  broken: Bool
  goaway: Bool
  goaway_last: Int
  goaway_code: Int
  goaway_debug: Str
  // the request's stream
  id: Int
  swin: Int
  sin_avail: Int
  sin_unsent: Int
  headers: Bool
  ended: Bool
  seen: Bool
  refused: Bool
  hb: Str
  hb_on: Bool
  hb_flags: Int
  hb_sid: Int
  dec: Bool
  // the response
  status: Int
  /// a streamed request body (decision 0404 stage C): its source, and
  /// whether it ended
  src: List[fn(Int) -> BodyPart] = []
  src_end: Bool = false
}

/// Whether the request body has bytes left to send (x.body past x.off,
/// or a source not yet ended).
fn (x: H2X) pending() -> Bool { x.off < x.body.len() || (!x.src.is_empty() && !x.src_end) }

/// Sends x.out; false when the write failed (x.res).
fn (var x: H2X) flush(r: rthttp.CResp) -> Bool {
  if x.out.is_empty() {
    return true
  }
  x.res = hclient.h2_write(r, x.out)
  x.out = ""
  x.res == CC_OK
}

/// Fails the request with why (with a body read failure's mark once the
/// response header came, as net/http reports it from the body's Read).
fn (var x: H2X) fail(had: Bool, why: Str) {
  x.why = (if had { "\u{1}" } else { "" }) + why
  x.res = CC_ERR
}

/// The server's frame f (header and payload; h2cc_process): false when
/// the request failed (its text in why, the caller marks it).
fn (var x: H2X) frame(r: rthttp.CResp, f: Str) -> (Bool, Str) {
  let b = f.bytes()
  let len = (Int(b[0]) << 16) | (Int(b[1]) << 8) | Int(b[2])
  let ty = Int(b[3])
  let flags = Int(b[4])
  let sid = be32_at(b, 5) & 0x7FFFFFFF
  if sid == x.id && sid != 0 {
    x.seen = true
  }
  if x.hb_on && (ty != H2T_CONT || sid != x.hb_sid) {
    x.broken = true
    return (false, "connection error: PROTOCOL_ERROR")
  }
  if ty == H2T_SETTINGS {
    if (flags & H2F_ACK) == 0 {
      var i = 0
      while i + 6 <= len {
        let id = (Int(b[9 + i]) << 8) | Int(b[10 + i])
        let v = be32_at(b, 11 + i)
        if id == 4 && v <= 0x7FFFFFFF {
          x.swin += v - x.st.peer_win
          x.st.peer_win = v
        } else if id == 5 && v >= 16384 && v < 16777216 {
          x.st.peer_frame = v
        } else if id == 1 {
          // for the encoder, before the next request's block
          x.st.sizes = rt.rs_push_word(x.st.sizes, v, 4)
        }
        i += 6
      }
      x.out = push_frame(x.out, 0, H2T_SETTINGS, H2F_ACK, 0)
    }
  } else if ty == H2T_PING {
    if (flags & H2F_ACK) == 0 && len == 8 {
      x.out = push_frame(x.out, 8, H2T_PING, H2F_ACK, 0) + rawb.str_slice(f, 9, 17)
    }
  } else if ty == H2T_WINUP {
    if len == 4 {
      let inc = be32_at(b, 9) & 0x7FFFFFFF
      if sid == 0 {
        x.st.win += inc
      } else if sid == x.id {
        x.swin += inc
      }
    }
  } else if ty == H2T_GOAWAY {
    if len >= 8 {
      x.goaway = true
      x.goaway_last = be32_at(b, 9) & 0x7FFFFFFF
      x.goaway_code = be32_at(b, 13)
      // the debug data as a C string (to its first zero byte)
      var e = 17
      while e < 9 + len && b[e] != 0 {
        e += 1
      }
      x.goaway_debug = rawb.str_slice(f, 17, e)
      if x.goaway_last < x.id && !x.seen {
        // the server will not answer this stream: another connection will
        x.refused = true
        return (false, "http2: server sent GOAWAY")
      }
    }
  } else if ty == H2T_RST {
    if sid == x.id && len == 4 {
      let code = be32_at(b, 9)
      if code == 7 && !x.headers {
        x.refused = true
      }
      if code == 1 {
        x.broken = true
      }
      return (false, "stream error: stream ID ${x.id}; ${h2_err_name(code)}; received from peer")
    }
  } else if ty == H2T_HEADERS || ty == H2T_CONT {
    var d = 9
    var dn = len
    if ty == H2T_HEADERS {
      if (flags & H2F_PADDED) != 0 {
        if dn < 1 || Int(b[9]) > dn - 1 {
          x.broken = true
          return (false, "connection error: PROTOCOL_ERROR")
        }
        dn -= 1 + Int(b[9])
        d += 1
      }
      if (flags & H2F_PRIORITY) != 0 {
        if dn < 5 {
          x.broken = true
          return (false, "connection error: PROTOCOL_ERROR")
        }
        d += 5
        dn -= 5
      }
      x.hb = ""
      x.hb_flags = flags
      x.hb_sid = sid
    }
    x.hb = x.hb + rawb.str_slice(f, d, d + dn)
    if x.hb.len() > H2_MAX_RESP {
      x.broken = true
      return (false, "http2: response header list larger than advertised limit")
    }
    if (flags & H2F_END_HEADERS) == 0 {
      x.hb_on = true
    } else {
      x.hb_on = false
      x.dec = true
    }
  } else if ty == H2T_DATA {
    var d = 9
    var dn = len
    if (flags & H2F_PADDED) != 0 {
      if dn < 1 || Int(b[9]) > dn - 1 {
        x.broken = true
        return (false, "connection error: PROTOCOL_ERROR")
      }
      dn -= 1 + Int(b[9])
      d += 1
    }
    if len > 0 {
      let (a, un, u) = inflow_add(x.st.in_avail - len, x.st.in_unsent, len)
      x.st.in_avail = a
      x.st.in_unsent = un
      if u > 0 {
        x.out = push_be32(push_frame(x.out, 4, H2T_WINUP, 0, 0), u)
      }
    }
    if sid != x.id {
      return (true, "") // an old stream's
    }
    if !x.headers {
      x.broken = true
      return (false, "protocol error: received DATA before a HEADERS frame")
    }
    if x.method != "HEAD" && dn > 0 {
      hclient.h2_data(r, rawb.str_slice(f, d, d + dn))
    }
    if len > 0 && (flags & H2F_END_STREAM) == 0 {
      let (a, un, u) = inflow_add(x.sin_avail - len, x.sin_unsent, len)
      x.sin_avail = a
      x.sin_unsent = un
      if u > 0 {
        x.out = push_be32(push_frame(x.out, 4, H2T_WINUP, 0, x.id), u)
      }
    }
    if (flags & H2F_END_STREAM) != 0 {
      x.ended = true
    }
  }
  (true, "")
}

/// The response header block in x.hb, decoded (h2rq_headers): false
/// when it is malformed (why says how).
fn (var x: H2X) block_done(r: rthttp.CResp) -> (Bool, Str) {
  x.dec = false
  let f = x.st.dec.decode_part(x.hb, true, H2_MAX_RESP)
  let end = (x.hb_flags & H2F_END_STREAM) != 0
  if f.ok != 1 || f.used != x.hb.len() {
    x.broken = true
    return (false, "connection error: COMPRESSION_ERROR")
  }
  if x.hb_sid != x.id {
    return (true, "") // another stream's (an old one's trailers): only the table counts
  }
  if x.headers {
    // trailers: dropped (std/rt does not read them)
    if end {
      x.ended = true
    }
    return (true, "")
  }
  // the fields: names and values one after the other in f.data
  var names: List[Str] = []
  var values: List[Str] = []
  var off = 0
  for l in f.lens {
    let nn = l & 0xFFFFFFFF
    let vn = l >> 32
    if off + nn + vn > f.data.len() {
      break
    }
    // outside bytes (decision 0259)
    names.push(scan.text_at(rawb.data(f.data) + off, nn))
    values.push(scan.text_at(rawb.data(f.data) + off + nn, vn))
    off += nn + vn
  }
  var si = -1
  var i = 0
  while i < names.len() {
    if names[i] == ":status" {
      si = i
      break
    }
    i += 1
  }
  if si < 0 {
    return (false, "malformed response from server: missing status pseudo header")
  }
  let sb = values[si].bytes()
  if sb.len() == 0 || sb.len() > 9 {
    return (false, "malformed response from server: malformed non-numeric status pseudo header")
  }
  var code = 0
  for c in sb {
    if Int(c) < 48 || Int(c) > 57 {
      return (false, "malformed response from server: malformed non-numeric status pseudo header")
    }
    code = code * 10 + Int(c) - 48
  }
  if code >= 100 && code <= 199 && !end {
    return (true, "") // informational: the response follows
  }
  x.headers = true
  x.status = code
  // the header: canonical names, each field as received (decision
  // 0288: std/native/http.xo fields_in makes the Map view)
  var hk: List[Str] = []
  var hv: List[Str] = []
  i = 0
  while i < names.len() {
    let k = names[i]
    if !k.is_empty() && k.bytes()[0] == 58 {
      i += 1
      continue
    }
    hk.push(canonical_key(k))
    hv.push(values[i])
    i += 1
  }
  hclient.h2_response(r, code, hk, hv)
  if end {
    x.ended = true
  }
  (true, "")
}

/// Makes the HTTP/2 request hclient.cl_start set up on r (http2
/// Transport.RoundTrip on one stream), then hands the connection and its
/// state back to the pool (hclient.h2_end). hclient.retry tells whether
/// the request goes again on a new connection.
fn h2_exchange(r: rthttp.CResp, method: Str, target: Str, host: Str, names: List[Str], values: List[Str], bn: Int, src: List[fn(Int) -> BodyPart] = []) {
  var x = h2_begin(r, method, target, host, names, values, bn, src)
  h2_pump(r, x, H2_TO_END)
  h2_done(r, x)
}

/// An HTTP/2 exchange on r: whole (h2_exchange), or for a stream up to
/// the response's head, kept open (Some) unless it failed or ended there.
fn h2_run(r: rthttp.CResp, stream: Bool, method: Str, target: Str, host: Str, names: List[Str], values: List[Str], bn: Int, src: List[fn(Int) -> BodyPart] = []) -> H2X? {
  if !stream {
    h2_exchange(r, method, target, host, names, values, bn, src)
    return None
  }
  var x = h2_begin(r, method, target, host, names, values, bn, src)
  h2_pump(r, x, H2_TO_HEAD)
  if x.res != CC_OK || x.ended {
    h2_done(r, x)
    return None
  }
  Some(x)
}

/// h2_pump's stops: the exchange's end, the response's header, the next
/// DATA payload (hclient.h2_body_n > 0) or the end.
pub const H2_TO_END: Int = 0
pub const H2_TO_HEAD: Int = 1
pub const H2_TO_DATA: Int = 2

/// h2_exchange's start: the connection's state taken from the pool and
/// the request's header frames sent.
pub fn h2_begin(r: rthttp.CResp, method: Str, target: Str, host: Str, names: List[Str], values: List[Str], bn: Int, src: List[fn(Int) -> BodyPart] = []) -> H2X {
  var st = h2_state()
  let kept = hclient.h2_take(r)
  if let Some(a) = kept.get(0) {
    if let Some(s) = rt.any_get[H2State](a) {
      st = s
    }
  }
  let (cv, has_c) = h2_field(names, values, "Connection")
  var x = H2X{st: st, method: method, body: hclient.h2_body(r), off: 0, close: has_c && cv == "close", out: "", res: CC_OK, why: "", broken: false, goaway: false, goaway_last: 0, goaway_code: 0, goaway_debug: "", id: 0, swin: 0, sin_avail: 0, sin_unsent: 0, headers: false, ended: false, seen: false, refused: false, hb: "", hb_on: false, hb_flags: 0, hb_sid: 0, dec: false, status: 0}
  x.st.enc.set_sizes(x.st.sizes)
  x.st.sizes = ""
  x.src = src
  let why = h2_check(names, values)
  if !why.is_empty() {
    x.why = why
    x.res = CC_ERR
  } else {
    if x.close {
      x.broken = true // not reused after this request
    }
    x.id = x.st.next_id
    x.st.next_id += 2
    x.swin = x.st.peer_win
    x.sin_avail = 4194304
    let blk = x.st.block(method, target, host, names, values, x.body.len())
    // HEADERS and CONTINUATION frames of at most the server's frame size
    var off = 0
    var first = true
    while first || off < blk.len() {
      let k = if blk.len() - off > x.st.peer_frame { x.st.peer_frame } else { blk.len() - off }
      var fl = 0
      if off + k == blk.len() {
        fl = fl | H2F_END_HEADERS
      }
      if first && x.body.is_empty() && x.src.is_empty() {
        fl = fl | H2F_END_STREAM
      }
      x.out = push_frame(x.out, k, if first { H2T_HEADERS } else { H2T_CONT }, fl, x.id) + rawb.str_slice(blk, off, off + k)
      off += k
      first = false
    }
    let _ok = x.flush(r)
  }
  x
}

/// Runs the exchange x on r until stop (H2_TO_*), a failure, or its end.
pub fn h2_pump(r: rthttp.CResp, var x: H2X, stop: Int) {
  while x.res == CC_OK && !x.ended {
    if stop == H2_TO_HEAD && x.headers && !x.dec {
      break
    }
    if stop == H2_TO_DATA && hclient.h2_body_n(r) > 0 {
      break
    }
    // the body, as the windows allow
    while !x.ended {
      if x.off >= x.body.len() && !x.src.is_empty() && !x.src_end {
        // the source's next piece (decision 0404 stage C)
        let p = x.src[0](32768)
        if !p.err.is_empty() {
          // the stream is reset; the connection stays usable
          x.out = push_be32(push_frame(x.out, 4, H2T_RST, 0, x.id), 8)
          let _ok = x.flush(r)
          x.fail(false, p.err)
          x.ended = true
          break
        }
        x.body = p.data
        x.off = 0
        x.src_end = p.end
        if x.body.is_empty() {
          if x.src_end {
            x.out = push_frame(x.out, 0, H2T_DATA, H2F_END_STREAM, x.id)
          }
          continue
        }
      }
      let bn2 = x.body.len()
      if x.off >= bn2 {
        break
      }
      var k = bn2 - x.off
      if k > x.st.peer_frame {
        k = x.st.peer_frame
      }
      if k > x.swin {
        k = x.swin
      }
      if k > x.st.win {
        k = x.st.win
      }
      if k <= 0 {
        break
      }
      x.out = push_frame(x.out, k, H2T_DATA, if x.off + k == bn2 && (x.src.is_empty() || x.src_end) { H2F_END_STREAM } else { 0 }, x.id) + rawb.str_slice(x.body, x.off, x.off + k)
      x.off += k
      x.swin -= k
      x.st.win -= k
      if x.out.len() >= 65536 {
        break
      }
    }
    if !x.out.is_empty() {
      if !x.flush(r) {
        break
      }
      if x.pending() && x.swin > 0 && x.st.win > 0 {
        continue
      }
    }
    let f = hclient.h2_read(r)
    if f.is_empty() {
      let c = hclient.h2_rres(r)
      if c == CC_EOF {
        x.broken = true
        if x.goaway {
          x.fail(x.headers, "http2: server sent GOAWAY and closed the connection; LastStreamID=${x.goaway_last}, ErrCode=${h2_err_name(x.goaway_code)}, debug=${go_quote(x.goaway_debug)}")
        } else {
          x.fail(x.headers, "unexpected EOF")
        }
      } else if c == CC_TOO_LARGE {
        x.broken = true
        x.fail(x.headers, "http2: frame too large")
      } else {
        x.res = c
      }
      break
    }
    let had = x.headers
    let (ok, m) = x.frame(r, f)
    if !ok {
      x.fail(had, m)
      break
    }
    if x.dec {
      let had2 = x.headers
      let (ok2, m2) = x.block_done(r)
      if !ok2 {
        x.fail(had2, m2)
      }
      continue
    }
    let _ok = x.flush(r)
  }
}

/// A stream given up before its end (decision 0404): RST_STREAM CANCEL,
/// the connection staying usable.
pub fn h2_cancel(r: rthttp.CResp, var x: H2X) {
  if x.res == CC_OK && !x.ended && x.id != 0 {
    x.out = push_be32(push_frame(x.out, 4, H2T_RST, 0, x.id), 8)
    let _ok = x.flush(r)
    x.ended = true
  }
}

/// h2_exchange's end: the connection and its state back to the pool
/// (hclient.h2_end).
pub fn h2_done(r: rthttp.CResp, var x: H2X) {
  var fl = 0
  if x.broken {
    fl = fl | XF_BROKEN
  }
  if x.st.next_id > 0x7FFFFFF0 {
    fl = fl | XF_SPENT
  }
  if x.refused {
    fl = fl | XF_REFUSED
  }
  if x.seen {
    fl = fl | XF_SEEN
  }
  if x.headers {
    fl = fl | XF_HEADERS
  }
  if x.pending() {
    fl = fl | XF_UNSENT
  }
  if x.goaway {
    fl = fl | XF_GOAWAY
  }
  hclient.h2_end(r, rt.any_of(x.st), x.res, x.why, fl)
}

// ---------------------------------------------------------------------------
// The client (xo_http.c's xo_cl_do and cl_read_response until audit item
// B10, 2026-10-14): the URL and the redirects of net/http's Client, and
// the reading of an HTTP/1.1 response (ReadResponse, readTransfer). The
// C keeps the dial, TLS, and HTTP/2's connections (its header blocks
// are h2_exchange's); an HTTP/1.1 exchange returns from hclient.cl_start
// connected, and hclient.xo sends the request, reads the response
// (hclient.input, more, take), and ends it (hclient.end).

// The results of the C client's reads (xo_http.c's CC_*).
const CC_OK: Int = 0
const CC_EOF: Int = 1
const CC_ERR: Int = 4

/// url.escape(s, encodePath) (url.URL.EscapedPath without a RawPath).
pub fn escape_path(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && (cls(Int(b[i])) & PKEEP) != 0 {
    i += 1
  }
  if i == n {
    return s
  }
  let hex = b"0123456789ABCDEF"
  var out = rt.rs_append_bytes(rt.rs_with_cap(n + 8), b, 0, i, 0)
  while i < n {
    let c = Int(b[i])
    if (cls(c) & PKEEP) != 0 {
      out = rt.rs_push_byte(out, c)
    } else {
      out = rt.rs_push_word(out, 37 | (Int(hex[c >> 4]) << 8) | (Int(hex[c & 15]) << 16), 3)
    }
    i += 1
  }
  out
}

/// A response head: res (NEED, OK, BAD, TOO_LARGE), its length (OK), the
/// status code, the header ([name, value, ...] in the order received:
/// net/http's names, Transfer-Encoding, a chunked body's Content-Length
/// and Trailer, and a closing HTTP/1.1 response's Connection left out),
/// whether the body is chunked, its length (readTransfer's realLength:
/// -1 up to the end of the stream or chunked), and BAD's text (Go's
/// error, without Transport's prefix).
pub struct RespHead {
  res: Int
  used: Int
  status: Int
  headers: List[Str]
  chunked: Bool
  clen: Int
  why: Str
  /// whether the connection closes after this response (net/http's
  /// shouldClose: HTTP/1.1 with Connection: close, HTTP/1.0 without
  /// Connection: keep-alive, HTTP/0.x; decision 0303)
  close: Bool
}

fn resp_fail(res: Int, why: Str) -> RespHead { RespHead{res: res, used: 0, status: 0, headers: [], chunked: false, clen: -1, why: why, close: true} }

/// The text of b[a..z] (outside bytes: U+FFFD, decision 0259).
fn text_of(s: Str, a: Int, z: Int) -> Str { scan.text_at(rawb.data(s) + a, z - a) }

/// %q of a list of strings, as fmt prints a []string.
fn quote_list(l: List[Str]) -> Str {
  var parts: List[Str] = []
  for x in l {
    parts.push(go_quote(x))
  }
  "[" + parts.join(" ") + "]"
}

/// textproto.TrimString: without leading and trailing ASCII space.
fn trim_ascii(v: Str) -> Str {
  let b = v.bytes()
  var a = 0
  var z = b.len()
  while a < z && (b[a] == 32 || b[a] == 9 || b[a] == 10 || b[a] == 13) {
    a += 1
  }
  while z > a && (b[z - 1] == 32 || b[z - 1] == 9 || b[z - 1] == 10 || b[z - 1] == 13) {
    z -= 1
  }
  rawb.str_cut(v, a, z)
}

/// textproto's readMIMEHeader of the lines of s from i to end (end: just
/// after the empty line, or the end of the input at its end): the
/// fields as received, and "" or Go's error.
fn mime_header(s: Str, b: Bytes, i0: Int, end: Int) -> (List[Str], List[Str], Str) {
  var keys: List[Str] = []
  var vals: List[Str] = []
  var i = i0
  if i < end && is_sp(Int(b[i])) {
    let (_, e0, _) = line_at(s, b, i, end, true)
    return (keys, vals, "malformed MIME header initial line: " + text_of(s, i, e0))
  }
  while true {
    if i >= end {
      return (keys, vals, "unexpected EOF")
    }
    let (_, e, nx) = line_at(s, b, i, end, true)
    if e == i {
      return (keys, vals, "")
    }
    if find(s, 58, i, e) < 0 {
      return (keys, vals, "malformed MIME header: missing colon: " + go_quote(rawb.str_slice(s, i, e)))
    }
    // readContinuedLineSlice: the line trimmed, and each line that starts
    // with a space or tab after one space, trimmed
    let (a, z) = trim_sp(b, i, e)
    var kv = rawb.str_slice(s, a, z)
    i = nx
    while i < end && is_sp(Int(b[i])) {
      var c = i
      while c < end && is_sp(Int(b[c])) {
        c += 1
      }
      kv = kv + " "
      if c >= end {
        i = c
        break
      }
      let (_, e3, nx3) = line_at(s, b, c, end, true)
      let (a3, z3) = trim_sp(b, c, e3)
      kv = kv + rawb.str_slice(s, a3, z3)
      i = nx3
    }
    let kb = kv.bytes()
    let colon = bfind(kb, 58, 0, kb.len())
    // canonicalMIMEHeaderKey: token bytes, or spaces (the name kept as
    // is); the value: no control byte but a tab
    var ok = colon > 0
    var spaced = false
    var x = 0
    while ok && x < colon {
      let ch = Int(kb[x])
      if (cls(ch) & TCHAR) == 0 {
        if ch == 32 {
          spaced = true
        } else {
          ok = false
        }
      }
      x += 1
    }
    if !ok {
      return (keys, vals, "malformed MIME header line: " + text_of(kv, 0, kb.len()))
    }
    x = colon + 1
    while x < kb.len() {
      let ch = Int(kb[x])
      if (ch < 32 && ch != 9) || ch == 127 {
        // canonicalMIMEHeaderKey rewrote the name in the line already
        let shown = if spaced { text_of(kv, 0, colon) } else { canonical_key(rawb.str_slice(kv, 0, colon)) }
        return (keys, vals, "malformed MIME header line: " + shown + text_of(kv, colon, kb.len()))
      }
      x += 1
    }
    var v0 = colon + 1
    while v0 < kb.len() && is_sp(Int(kb[v0])) {
      v0 += 1
    }
    let name = rawb.str_slice(kv, 0, colon)
    keys.push(if spaced { text_of(kv, 0, colon) } else { canonical_key(name) })
    vals.push(text_of(kv, v0, kb.len()))
  }
  (keys, vals, "")
}

/// The values of field k in keys and vals.
fn values_in(keys: List[Str], vals: List[Str], k: Str) -> List[Str] {
  var out: List[Str] = []
  for (j, key) in keys.indexed() {
    if key == k {
      out.push(vals[j])
    }
  }
  out
}

/// Reads the status line and the header at the start of s, up to the
/// first empty line, as net/http's ReadResponse for a request of method
/// (textproto.ReadMIMEHeader, then readTransfer: the transfer encoding,
/// fixLength, fixTrailer, shouldClose, and fixPragmaCacheControl); at
/// eof a head without its empty line is read as far as it goes.
pub fn parse_response(s: Str, eof: Bool, method: Str) -> RespHead {
  let b = s.bytes()
  let n = b.len()
  // the end of the head: \n\n or \n\r\n
  var end = -1
  var nl = scan.find(s, "\n", 0)
  while nl >= 0 && nl + 1 < n {
    if b[nl + 1] == 10 {
      end = nl + 2
      break
    }
    if b[nl + 1] == 13 && nl + 2 < n && b[nl + 2] == 10 {
      end = nl + 3
      break
    }
    nl = scan.find(s, "\n", nl + 1)
  }
  if end < 0 {
    if n > MAX_HEAD {
      return resp_fail(TOO_LARGE, "")
    }
    if !eof {
      return resp_fail(NEED, "")
    }
    end = n
  }
  // the status line: proto SP code [SP reason]
  let (_, ll, nx) = line_at(s, b, 0, end, true)
  let sp = find(s, 32, 0, ll)
  if sp < 0 {
    // %q of the bytes as received (an invalid byte is \xff, as Go's)
    return resp_fail(BAD, "malformed HTTP response " + go_quote(rawb.str_slice(s, 0, ll)))
  }
  var c0 = sp + 1
  while c0 < ll && b[c0] == 32 {
    c0 += 1
  }
  var c1 = find(s, 32, c0, ll)
  if c1 < 0 {
    c1 = ll
  }
  let code_text = rawb.str_slice(s, c0, c1)
  // strconv.Atoi of three bytes: a sign, then digits; not negative
  var code = 0
  var good = c1 - c0 == 3
  var k = c0
  if good && (b[k] == 43 || b[k] == 45) {
    good = b[k] == 43
    k += 1
  }
  while good && k < c1 {
    if b[k] < 48 || b[k] > 57 {
      good = false
    } else {
      code = code * 10 + Int(b[k]) - 48
    }
    k += 1
  }
  if !good {
    return resp_fail(BAD, "malformed HTTP status code " + go_quote(code_text))
  }
  // ParseHTTPVersion: HTTP/X.Y
  let proto = rawb.str_slice(s, 0, sp)
  let pb = proto.bytes()
  if pb.len() != 8 || !proto.starts_with("HTTP/") || pb[6] != 46 || pb[5] < 48 || pb[5] > 57 || pb[7] < 48 || pb[7] > 57 {
    return resp_fail(BAD, "malformed HTTP version " + go_quote(rawb.str_slice(s, 0, sp)))
  }
  let major = Int(pb[5]) - 48
  let minor = Int(pb[7]) - 48
  let (keys0, vals0, why) = mime_header(s, b, nx, end)
  if !why.is_empty() {
    return resp_fail(BAD, why)
  }
  var keys = keys0
  var vals = vals0
  // fixPragmaCacheControl
  let pragma = values_in(keys, vals, "Pragma")
  if !pragma.is_empty() && pragma[0] == "no-cache" && values_in(keys, vals, "Cache-Control").is_empty() {
    keys.push("Cache-Control")
    vals.push("no-cache")
  }
  // shouldClose: an HTTP/1.1 (or later) response that closes loses its
  // Connection field
  let at11 = major > 1 || (major == 1 && minor >= 1)
  var closing = false
  for v in values_in(keys, vals, "Connection") {
    if has_token(v, "close") {
      closing = true
    }
  }
  var keep_alive = false
  if major == 1 && minor == 0 {
    for v in values_in(keys, vals, "Connection") {
      if has_token(v, "keep-alive") {
        keep_alive = true
      }
    }
  }
  let close = major < 1 || closing || (major == 1 && minor == 0 && !keep_alive)
  var drop: List[Str] = []
  if closing && at11 {
    drop.push("Connection")
  }
  // parseTransferEncoding (HTTP/0.0 reads as 1.1 here)
  let te = values_in(keys, vals, "Transfer-Encoding")
  var chunked = false
  if !te.is_empty() {
    drop.push("Transfer-Encoding")
    if at11 || (major == 0 && minor == 0) {
      if te.len() != 1 {
        return resp_fail(BAD, "too many transfer encodings: " + quote_list(te))
      }
      if !equal_fold(te[0], "chunked") {
        return resp_fail(BAD, "unsupported transfer encoding: " + go_quote(te[0]))
      }
      chunked = true
    }
  }
  // fixLength: one Content-Length, or several equal ones (kept once)
  let cl = values_in(keys, vals, "Content-Length")
  var clen = -1
  if !cl.is_empty() {
    let first = trim_ascii(cl[0])
    for v in cl {
      if trim_ascii(v) != first {
        return resp_fail(BAD, "http: message cannot contain multiple Content-Length headers; got " + quote_list(cl))
      }
    }
    if first.is_empty() {
      return resp_fail(BAD, "invalid empty Content-Length " + go_quote(first))
    }
    let fb = first.bytes()
    var v = 0
    for d in fb {
      if d < 48 || d > 57 || v > (MAX_INT - (Int(d) - 48)) / 10 {
        return resp_fail(BAD, "bad Content-Length " + go_quote(first))
      }
      v = v * 10 + Int(d) - 48
    }
    clen = v
  }
  var length = clen
  if method == "HEAD" || code / 100 == 1 || code == 204 || code == 304 {
    length = 0
  } else if chunked {
    length = -1
    drop.push("Content-Length")
  }
  // fixTrailer
  if chunked {
    let tr = values_in(keys, vals, "Trailer")
    if !tr.is_empty() {
      drop.push("Trailer")
      for v in tr {
        for part in v.split(",") {
          let key = canonical_key(trim_ascii(part))
          if key == "Transfer-Encoding" || key == "Trailer" || key == "Content-Length" {
            return resp_fail(BAD, "bad trailer key " + go_quote(key))
          }
        }
      }
    }
  }
  var headers: List[Str] = []
  var seen_cl = false
  for (j, key) in keys.indexed() {
    if drop.contains(key) {
      continue
    }
    if key == "Content-Length" {
      if seen_cl {
        continue
      }
      seen_cl = true
      headers.push(key)
      headers.push(trim_ascii(vals[j]))
      continue
    }
    headers.push(key)
    headers.push(vals[j])
  }
  RespHead{res: OK, used: end, status: code, headers: headers, chunked: chunked, clen: length, why: "", close: close}
}

/// The end of one exchange: s (CC_*), the failure's text, and the
/// response.
struct Exchange {
  s: Int
  why: Str
  status: Int
  headers: List[Str]
  body: Bytes
  /// the connection may serve another request (decision 0303): the body
  /// was framed and read in full, nothing followed it, and the response
  /// did not close
  keep: Bool
  /// no byte of a response came (a pooled connection's failure is then
  /// replayed on a new one)
  none: Bool
}

fn ex_fail(s: Int, why: Str) -> Exchange { Exchange{s: s, why: why, status: 0, headers: [], body: b"", keep: false, none: false} }

/// ex_fail before any byte of the response.
fn ex_none(s: Int, why: Str) -> Exchange { Exchange{s: s, why: why, status: 0, headers: [], body: b"", keep: false, none: true} }

/// The index of the name k in a header ([name, value, ...]), or -1.
fn has_key(keys: List[Str], k: Str) -> Bool {
  for x in keys {
    if x == k {
      return true
    }
  }
  false
}

/// The fields of h (name, value pairs) less every one named a or b.
fn without_fields(h: List[Str], a: Str, b: Str) -> List[Str] {
  var out: List[Str] = []
  var i = 0
  while i + 1 < h.len() {
    if h[i] != a && h[i] != b {
      out.push(h[i])
      out.push(h[i + 1])
    }
    i += 2
  }
  out
}

fn field_at(h: List[Str], k: Str) -> Int {
  var i = 0
  while i + 1 < h.len() {
    if h[i] == k {
      return i
    }
    i += 2
  }
  -1
}

/// Reads the response to a request of method on r (net/http's
/// ReadResponse and readTransfer): informational responses but 101 are
/// skipped; a chunked body is decoded and its Content-Length dropped; a
/// body ends at its Content-Length or, without one, at the end of the
/// stream; HEAD, 1xx, 204, and 304 responses have none.
fn read_response(r: rthttp.CResp, method: Str) -> Exchange {
  // ReadResponse's errors come after Transport's prefix; the body's, as
  // io.ReadAll returns them, without the request (the "\u{1}" mark)
  let broken = "net/http: HTTP/1.x transport connection broken: "
  // no byte of a response yet
  var first = true
  while true {
    var h = parse_response(hclient.input(r, 0), false, method)
    while h.res == NEED || h.res == TOO_LARGE {
      if h.res == TOO_LARGE {
        return ex_fail(CC_ERR, "net/http: server response headers exceeded 1048576 bytes; aborted")
      }
      let avail = hclient.avail(r)
      let f = hclient.more(r)
      if f == CC_EOF {
        if avail == 0 {
          return if first { ex_none(CC_ERR, "EOF") } else { ex_fail(CC_ERR, "EOF") }
        }
        h = parse_response(hclient.input(r, 0), true, method)
        break
      }
      if f != CC_OK {
        return if first && avail == 0 && f != hclient.CC_TIMEOUT && f != hclient.CC_CANCELED { ex_none(f, "") } else { ex_fail(f, "") }
      }
      h = parse_response(hclient.input(r, 0), false, method)
    }
    if h.res != OK {
      return ex_fail(CC_ERR, broken + h.why)
    }
    hclient.skip(r, h.used)
    first = false
    let code = h.status
    // the connection may serve another request (decision 0303)
    let open = !h.close && code != 101
    if code >= 100 && code <= 199 && code != 101 {
      // an informational response: the real one follows
      continue
    }
    let headers = h.headers
    if h.chunked && h.clen != 0 {
      while true {
        let eof = hclient.eof(r)
        let c = chunked(hclient.input(r, 2), eof)
        if c.res == HB_OK {
          hclient.skip(r, c.used)
          return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: c.body.bytes(), keep: open && hclient.avail(r) == 0, none: false}
        }
        if c.res == HB_ERR || eof {
          return ex_fail(CC_ERR, "\u{1}" + (if c.why.is_empty() { "unexpected EOF" } else { c.why }))
        }
        let f = hclient.more(r)
        if f != CC_OK && f != CC_EOF {
          return ex_fail(f, "")
        }
      }
    }
    while true {
      let have = hclient.avail(r)
      if h.clen >= 0 && have >= h.clen {
        let b = hclient.take(r, h.clen)
        return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: b, keep: open && hclient.avail(r) == 0, none: false}
      }
      if hclient.eof(r) {
        if h.clen >= 0 {
          return ex_fail(CC_ERR, "\u{1}unexpected EOF")
        }
        // a body that ends at EOF: the connection is done
        return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: hclient.take(r, have), keep: false, none: false}
      }
      let f = hclient.more(r)
      if f != CC_OK && f != CC_EOF {
        return ex_fail(f, "")
      }
    }
  }
  ex_fail(CC_ERR, "")
}

/// An HTTP/1.1 exchange on r: the request, its response read in full,
/// and the connection to the pool when it may serve another request
/// (decision 0303: the response did not close it; a Connection field in
/// the request's header does not count, as Transport looks only at
/// Request.Close), else closed. A request
/// that could not be written is an exchange with no response byte.
fn h1_round(r: rthttp.CResp, method: Str, target: Str, host: Str, hk: List[Str], hv: List[Str], body: Bytes, https: Bool, addr: Str, name: Str, roots: rthttp.Roots, src: List[fn(Int) -> BodyPart] = []) -> Exchange {
  hclient.request(r, method, target, host, hk, hv, body, !src.is_empty())
  if hclient.err(r) != 0 {
    return ex_none(CC_ERR, "")
  }
  let sx = send_src(r, src, hk)
  if sx.s != CC_OK {
    hclient.end_keep(r, false, https, addr, name, roots, sx.s, sx.why)
    return sx
  }
  let x = read_response(r, method)
  hclient.end_keep(r, x.keep, https, addr, name, roots, x.s, x.why)
  x
}

// ---------------------------------------------------------------------------
// A streamed response body (decision 0404 stage B1): the head as
// read_response reads it, then the body as it arrives (cbody_next).

/// How a streamed HTTP/1.1 body is read: mode 0 none, 1 a Content-Length
/// (left: the bytes to come), 2 chunked (left: the rest of the current
/// chunk; crlf: the CRLF ending a chunk comes next; excess: chunk_line's
/// count of non-data), 3 up to the connection's end; done when the body
/// ended; keep: the connection may serve another request then.
pub struct BodyRead {
  pub mode: Int
  pub left: Int = 0
  pub crlf: Bool = false
  pub excess: Int = 0
  pub done: Bool = false
  pub keep: Bool = false
}

/// read_head's result: the head (an Exchange with no body, or its
/// failure) and how its body is read.
pub struct HeadRead {
  pub x: Exchange
  pub b: BodyRead
}

/// The head of the response on r, as read_response reads it (an
/// informational one skipped), and how its body follows.
pub fn read_head(r: rthttp.CResp, method: Str) -> HeadRead {
  let broken = "net/http: HTTP/1.x transport connection broken: "
  let nob = BodyRead{mode: 0, done: true}
  var first = true
  while true {
    var h = parse_response(hclient.input(r, 0), false, method)
    while h.res == NEED || h.res == TOO_LARGE {
      if h.res == TOO_LARGE {
        return HeadRead{x: ex_fail(CC_ERR, "net/http: server response headers exceeded 1048576 bytes; aborted"), b: nob}
      }
      let avail = hclient.avail(r)
      let f = hclient.more(r)
      if f == CC_EOF {
        if avail == 0 {
          return HeadRead{x: if first { ex_none(CC_ERR, "EOF") } else { ex_fail(CC_ERR, "EOF") }, b: nob}
        }
        h = parse_response(hclient.input(r, 0), true, method)
        break
      }
      if f != CC_OK {
        return HeadRead{x: if first && avail == 0 && f != hclient.CC_TIMEOUT && f != hclient.CC_CANCELED { ex_none(f, "") } else { ex_fail(f, "") }, b: nob}
      }
      h = parse_response(hclient.input(r, 0), false, method)
    }
    if h.res != OK {
      return HeadRead{x: ex_fail(CC_ERR, broken + h.why), b: nob}
    }
    hclient.skip(r, h.used)
    first = false
    let code = h.status
    if code >= 100 && code <= 199 && code != 101 {
      continue
    }
    let open = !h.close && code != 101
    let x = Exchange{s: CC_OK, why: "", status: code, headers: h.headers, body: b"", keep: open, none: false}
    if code == 101 {
      // switched protocols (decision 0404 stage E): the connection's
      // bytes from here on, both ways, until it closes
      return HeadRead{x: x, b: BodyRead{mode: 3, keep: false}}
    }
    if h.chunked && h.clen != 0 {
      return HeadRead{x: x, b: BodyRead{mode: 2, keep: open}}
    }
    if h.clen == 0 {
      return HeadRead{x: x, b: BodyRead{mode: 0, done: true, keep: open && hclient.avail(r) == 0}}
    }
    if h.clen > 0 {
      return HeadRead{x: x, b: BodyRead{mode: 1, left: h.clen, keep: open}}
    }
    return HeadRead{x: x, b: BodyRead{mode: 3, keep: false}}
  }
  HeadRead{x: ex_fail(CC_ERR, ""), b: nob}
}

/// One step of a streamed body: s CC_OK with the next bytes (none once
/// b.done), or the failure s with its text (net/http's body errors:
/// "unexpected EOF", the chunked reader's).
pub struct BodyStep {
  pub s: Int
  pub why: Str
  pub data: Bytes
}

fn bstep(s: Int, why: Str) -> BodyStep { BodyStep{s: s, why: why, data: b""} }

/// The next bytes of the body b reads from r, at most max: empty data
/// with b.done at the body's end. A body cut short is "unexpected EOF"
/// (io.ErrUnexpectedEOF), never an end.
/// The smallest read cbody_next makes straight into a piece's own bytes
/// (smaller reads go through the connection's buffer).
const DIRECT_MIN = 16384

pub fn cbody_next(r: rthttp.CResp, var b: BodyRead, max: Int) -> BodyStep {
  let lim = if max > 0 { max } else { 32768 }
  while !b.done {
    if b.mode == 1 || (b.mode == 2 && b.left > 0) {
      let have = hclient.avail(r)
      if have == 0 && lim >= DIRECT_MIN && !hclient.eof(r) {
        // nothing buffered: read the piece straight into its own bytes
        // (one system call, no copy out of the connection's buffer)
        let k = if b.left < lim { b.left } else { lim }
        let buf = raw.bytes_buf(k)
        let n = hclient.read_direct(r, raw.bytes_addr(buf), k)
        if n < 0 {
          return bstep(0 - n, "")
        }
        if n == 0 {
          return bstep(CC_ERR, "unexpected EOF")
        }
        b.left -= n
        if b.left == 0 {
          if b.mode == 1 {
            b.done = true
            b.keep = b.keep && hclient.avail(r) == 0
          } else {
            b.crlf = true
          }
        }
        return BodyStep{s: CC_OK, why: "", data: raw.bytes_len(buf, n)}
      }
      if have > 0 {
        var k = if have < b.left { have } else { b.left }
        if k > lim {
          k = lim
        }
        let d = hclient.take(r, k)
        b.left -= k
        if b.left == 0 {
          if b.mode == 1 {
            b.done = true
            b.keep = b.keep && hclient.avail(r) == 0
          } else {
            b.crlf = true
          }
        }
        return BodyStep{s: CC_OK, why: "", data: d}
      }
      if hclient.eof(r) {
        return bstep(CC_ERR, "unexpected EOF")
      }
    } else if b.mode == 3 {
      let have = hclient.avail(r)
      if have == 0 && lim >= DIRECT_MIN && !hclient.eof(r) {
        let buf = raw.bytes_buf(lim)
        let n = hclient.read_direct(r, raw.bytes_addr(buf), lim)
        if n < 0 {
          return bstep(0 - n, "")
        }
        if n == 0 {
          b.done = true
          return bstep(CC_OK, "")
        }
        return BodyStep{s: CC_OK, why: "", data: raw.bytes_len(buf, n)}
      }
      if have > 0 {
        return BodyStep{s: CC_OK, why: "", data: hclient.take(r, if have < lim { have } else { lim })}
      }
      if hclient.eof(r) {
        b.done = true
        return bstep(CC_OK, "")
      }
    } else if b.mode == 2 && b.crlf {
      let s = hclient.input(r, 2)
      if s.len() >= 2 {
        let bs = s.bytes()
        if bs[0] != 13 || bs[1] != 10 {
          return bstep(CC_ERR, "malformed chunked encoding")
        }
        hclient.skip(r, 2)
        b.crlf = false
        continue
      }
      if hclient.eof(r) {
        return bstep(CC_ERR, "unexpected EOF")
      }
    } else if b.mode == 2 {
      // a chunk's size line; the last chunk's trailer through chunked
      let s = hclient.input(r, 2)
      let eof = hclient.eof(r)
      let l = chunk_line(s, s.bytes(), 0, eof, b.excess)
      if l.res == HB_ERR {
        return bstep(CC_ERR, l.why)
      }
      if l.res == HB_OK {
        b.excess = l.excess
        if l.size == 0 {
          let c = chunked(s, eof)
          if c.res == HB_OK {
            hclient.skip(r, c.used)
            b.done = true
            b.keep = b.keep && hclient.avail(r) == 0
            return bstep(CC_OK, "")
          }
          if c.res == HB_ERR || eof {
            return bstep(CC_ERR, if c.why.is_empty() { "unexpected EOF" } else { c.why })
          }
        } else {
          hclient.skip(r, l.next)
          b.left = l.size
          continue
        }
      } else if eof {
        return bstep(CC_ERR, "unexpected EOF")
      }
    } else {
      b.done = true
      return bstep(CC_OK, "")
    }
    let f = hclient.more(r)
    if f != CC_OK && f != CC_EOF {
      return bstep(f, "")
    }
  }
  bstep(CC_OK, "")
}

/// h1_round up to the response's head (decision 0404): the connection
/// stays r's for the body (cbody_next), or is closed on a failure.
fn h1_head_round(r: rthttp.CResp, method: Str, target: Str, host: Str, hk: List[Str], hv: List[Str], body: Bytes, https: Bool, addr: Str, name: Str, roots: rthttp.Roots, src: List[fn(Int) -> BodyPart] = []) -> HeadRead {
  hclient.request(r, method, target, host, hk, hv, body, !src.is_empty())
  if hclient.err(r) != 0 {
    return HeadRead{x: ex_none(CC_ERR, ""), b: BodyRead{mode: 0, done: true}}
  }
  let sx = send_src(r, src, hk)
  if sx.s != CC_OK {
    hclient.end_keep(r, false, https, addr, name, roots, sx.s, sx.why)
    return HeadRead{x: sx, b: BodyRead{mode: 0, done: true}}
  }
  let hr = read_head(r, method)
  if hr.x.s != CC_OK {
    hclient.end_keep(r, false, https, addr, name, roots, hr.x.s, hr.x.why)
  }
  hr
}

/// Sends a streamed request body (decision 0404 stage C) after its head:
/// chunked unless the request gave its Content-Length. A source's error
/// fails the request with its text (Go's Client: the body's Read error).
fn send_src(r: rthttp.CResp, src: List[fn(Int) -> BodyPart], hk: List[Str]) -> Exchange {
  let f = match src.get(0) {
    Some(g) => g
    None => return Exchange{s: CC_OK, why: "", status: 0, headers: [], body: b"", keep: false, none: false}
  }
  let chunked = !has_key(hk, "Content-Length")
  while true {
    let p = f(32768)
    if !p.err.is_empty() {
      return ex_fail(CC_ERR, p.err)
    }
    let s = hclient.send_chunk(r, p.data.bytes(), chunked, p.end)
    if s != CC_OK {
      return ex_fail(s, "")
    }
    if p.end {
      break
    }
  }
  Exchange{s: CC_OK, why: "", status: 0, headers: [], body: b"", keep: false, none: false}
}

/// Whether a request may be sent again after its pooled connection
/// failed before any byte of the response (net/http's isReplayable: the
/// body is in memory, as GetBody makes it; a safe method, or an
/// Idempotency-Key).
fn replayable(method: Str, hk: List[Str]) -> Bool {
  if method == "GET" || method == "HEAD" || method == "OPTIONS" || method == "TRACE" {
    return true
  }
  has_key(hk, "Idempotency-Key") || has_key(hk, "X-Idempotency-Key")
}

/// What std/http's client.send gets: err (0, or the ClientErr tag: 1
/// InvalidUrl, 2 Connect, 3 Timeout, 4 Protocol, 5 Canceled) and its
/// text, or the response.
pub struct CResult {
  pub err: Int
  pub msg: Str
  pub status: Int
  /// [name, value, ...]
  pub headers: List[Str]
  pub body: Bytes
  /// a streamed response (client_do's stream, decision 0404): the
  /// connection its body is read from (cbody_next with read), what
  /// end_keep needs at the body's end, and whether the body is gzip the
  /// client decodes; not open: body holds it all (an HTTP/2 response
  /// until stage B2)
  pub open: Bool = false
  pub conn: rthttp.CResp? = None
  pub read: BodyRead = BodyRead{mode: 0, done: true}
  pub https: Bool = false
  pub addr: Str = ""
  pub name: Str = ""
  pub gz: Bool = false
  /// an HTTP/2 stream's exchange (h2_pump with H2_TO_DATA reads on)
  pub h2: H2X? = None
}

fn cfail(err: Int, msg: Str) -> CResult { CResult{err: err, msg: msg, status: 0, headers: [], body: b""} }

/// net/http's urlErrorOp: the method with its first byte kept and the
/// rest lowered, at most 30 bytes ("Get").
fn url_op(m: Str) -> Str {
  let b = m.bytes()
  let k = if b.len() < 30 { b.len() } else { 30 }
  if k == 0 {
    return ""
  }
  rt.rs_append_bytes(rt.rs_append_bytes(rt.rs_with_cap(k), b, 0, 1, 0), b, 1, k, 1)
}

/// A method is a token.
fn valid_method(m: Str) -> Bool {
  let b = m.bytes()
  if b.len() == 0 {
    return false
  }
  var i = 0
  while i < b.len() {
    if (cls(Int(b[i])) & TCHAR) == 0 {
      return false
    }
    i += 1
  }
  true
}

/// `client.send(req)` over the network: method to url (the text of the
/// request's Url) with the header of names and values, the body, the
/// client's timeout (ns, 0: none), the roots https verifies against, and
/// the attenuation lists of the client's Net (decision 0175), following
/// redirects as net/http's Client does (redirectBehavior,
/// defaultCheckRedirect, the headers a redirect drops, refererForURL).
pub fn client_do(m: Str, url: Str, names: List[Str], values: List[Str], body0: Bytes, timeout: Int, roots: rthttp.Roots, lists: Str, max_redirects: Int = 10, stream: Bool = false, src0: List[fn(Int) -> BodyPart] = []) -> CResult {
  if !valid_method(m) {
    return cfail(1, "net/http: invalid method " + go_quote(m))
  }
  // the initial request's header: canonical names, a repeated name's
  // fields each (Header.Add; std/native/http.xo repeats a name only for
  // a Request's several fields, decision 0288)
  var ik: List[Str] = []
  var iv: List[Str] = []
  var n = 0
  while n < names.len() && n < values.len() {
    ik.push(canonical_key(names[n]))
    iv.push(values[n])
    n += 1
  }
  let when = if timeout > 0 { hclient.cl_deadline(timeout) } else { 0 }
  let op = url_op(m)
  var method = m
  var raw = url
  var body = body0
  var include_body = true
  // a streamed request body (decision 0404 stage C): read once, so never
  // replayed or sent again by a 307 or 308
  var src = src0
  var strip_sensitive = false
  var ihost = "" // the initial request's host
  var has_ihost = false
  var referer = "" // the URL of the previous request
  var has_referer = false
  var last_loc = "" // the Location being followed
  var redirects = 0
  while true {
    var cut = raw
    let hash = scan.find(raw, "#", 0)
    if hash >= 0 {
      cut = rawb.str_slice(raw, 0, hash)
    }
    let u = neturl.url_parse(cut, false)
    if !u.ok {
      return cfail(if redirects == 0 { 1 } else { 4 }, "parse " + go_quote(raw) + ": " + u.err)
    }
    let (name, uport) = split_hostport(u.host)
    let https = u.scheme == "https"
    let port = if !uport.is_empty() { uport } else if https { "443" } else { "80" }
    if redirects > 0 && !lists.is_empty() {
      // a redirect must stay within the client's attenuated Net (Net.only,
      // decision 0175): std/rt's CheckRedirect, whose error names the
      // Location
      if !netpolicy.admits(lists, name, port) {
        let hn = if scan.find(name, ":", 0) >= 0 { "[" + name + "]" } else { name }
        return cfail(4, op + " " + go_quote(last_loc) + ": denied by Net.only: redirect to " + hn + ":" + port)
      }
    }
    let q = go_quote(raw)
    if u.scheme != "http" && !https {
      return cfail(4, op + " " + q + ": unsupported protocol scheme " + go_quote(u.scheme))
    }
    if u.host.is_empty() {
      return cfail(4, op + " " + q + ": http: no Host in request URL")
    }
    if !has_ihost {
      ihost = u.host
      has_ihost = true
    } else if ihost != u.host {
      // another host: Authorization and cookies are not sent there
      strip_sensitive = true
    }
    // this hop's header: the initial one, less what a redirect drops
    var hk: List[Str] = []
    var hv: List[Str] = []
    var j = 0
    while j < ik.len() {
      let k = ik[j]
      let sensitive = k == "Authorization" || k == "Www-Authenticate" || k == "Cookie" || k == "Cookie2" || k == "Proxy-Authorization" || k == "Proxy-Authenticate"
      let bodyh = k == "Content-Encoding" || k == "Content-Language" || k == "Content-Location" || k == "Content-Type"
      if !(redirects > 0 && ((sensitive && strip_sensitive) || (bodyh && !include_body))) {
        hk.push(k)
        hv.push(iv[j])
      }
      j += 1
    }
    // refererForURL: no Referer from an https URL to an http one
    if redirects > 0 && has_referer && referer.starts_with("https://") && u.scheme == "http" {
      has_referer = false
    }
    if redirects > 0 && has_referer {
      var seen = false
      for k in hk {
        if k == "Referer" {
          seen = true
        }
      }
      if !seen {
        hk.push("Referer")
        hv.push(referer)
      }
    }
    // the request: the address (host:port, 80 or 443 by default), the
    // target (the escaped path and the query)
    let addr = if scan.find(name, ":", 0) >= 0 { "[" + name + "]:" + port } else { name + ":" + port }
    var target = if u.path == "*" { "*" } else if u.path.is_empty() { "/" } else { escape_path(u.path) }
    if !u.rawquery.is_empty() {
      target = target + "?" + u.rawquery
    }
    let prefix = url_op(method) + " " + q
    var r = hclient.cl_start(https, addr, name, body, when, roots, prefix, true)
    // stream over HTTP/2 (decision 0404 stage B2): the exchange kept open
    // after the head
    var h2x: H2X? = None
    if hclient.h2(r) {
      h2x = h2_run(r, stream, method, target, u.host, hk, hv, body.len(), src)
      if hclient.retry(r) && !src.is_empty() {
        // a streamed body cannot be sent again (Go's error without
        // Request.GetBody)
        return cfail(4, op + " " + go_quote(raw) + ": http2: Transport: cannot retry err after Request.Body was written; define Request.GetBody to avoid this error")
      }
      if hclient.retry(r) {
        // the server did not take the request on the pooled connection:
        // it goes on a new one, as Transport retries it
        r = hclient.cl_start(https, addr, name, body, when, roots, prefix, false)
        if hclient.h2(r) {
          h2x = h2_run(r, stream, method, target, u.host, hk, hv, body.len(), src)
        }
      }
    }
    var status = 0
    var headers: List[Str] = []
    var rbody = b""
    var h1 = hclient.reading(r)
    // stream (decision 0404): the head only; the body follows on r
    var hb = BodyRead{mode: 0, done: true}
    if h1 {
      var x = if stream {
        let hr = h1_head_round(r, method, target, u.host, hk, hv, body, https, addr, name, roots, src)
        hb = hr.b
        hr.x
      } else {
        h1_round(r, method, target, u.host, hk, hv, body, https, addr, name, roots, src)
      }
      if x.none && hclient.reused(r) && replayable(method, hk) && src.is_empty() {
        // the pooled connection was dead (the server closed it): the
        // request goes once more on a new one, as Transport retries it
        // (decision 0303)
        r = hclient.cl_start(https, addr, name, body, when, roots, prefix, false)
        h1 = hclient.reading(r)
        if hclient.h2(r) {
          h2x = h2_run(r, stream, method, target, u.host, hk, hv, body.len(), src)
        } else if h1 && stream {
          let hr = h1_head_round(r, method, target, u.host, hk, hv, body, https, addr, name, roots, src)
          hb = hr.b
          x = hr.x
        } else if h1 {
          x = h1_round(r, method, target, u.host, hk, hv, body, https, addr, name, roots, src)
        }
      }
      if h1 && hclient.err(r) == 0 {
        status = x.status
        headers = x.headers
        rbody = x.body
      }
    }
    if !h1 && hclient.err(r) == 0 {
      // an HTTP/2 response
      status = hclient.status(r)
      headers = hclient.headers(r)
      rbody = hclient.body(r)
    }
    let err = hclient.err(r)
    if err != 0 {
      return cfail(err, hclient.msg(r))
    }
    if stream && (h1 || h2x is Some(_)) {
      let li0 = field_at(headers, "Location")
      let hop = max_redirects > 0 && (status == 301 || status == 302 || status == 303 || (src.is_empty() && (status == 307 || status == 308))) && li0 >= 0 && !headers[li0 + 1].is_empty()
      if !hop {
        // the last response: its body is read as it arrives, a gzip one
        // decoded by the client on send's terms
        var gz = false
        if method != "HEAD" && !has_key(hk, "Accept-Encoding") && !has_key(hk, "Range") {
          let ce = field_at(headers, "Content-Encoding")
          if ce >= 0 && ascii_lower(headers[ce + 1]) == "gzip" {
            gz = true
            headers = without_fields(headers, "Content-Encoding", "Content-Length")
          }
        }
        return CResult{err: 0, msg: "", status: status, headers: headers, body: b"", open: true, conn: Some(r), read: hb, https: https, addr: addr, name: name, gz: gz, h2: h2x}
      }
      // a redirect: its body read and dropped, its connection pooled
      // before the next hop
      if let Some(x0) = h2x {
        var x = x0
        h2_pump(r, x, H2_TO_END)
        h2_done(r, x)
        if hclient.err(r) != 0 {
          return cfail(hclient.err(r), hclient.msg(r))
        }
      }
      while !hb.done {
        let st = cbody_next(r, hb, 65536)
        if st.s != CC_OK {
          hclient.end_keep(r, false, https, addr, name, roots, st.s, if st.why.is_empty() { "" } else { "\u{1}" + st.why })
          return cfail(hclient.err(r), hclient.msg(r))
        }
      }
      hclient.end_keep(r, hb.keep, https, addr, name, roots, CC_OK, "")
    }
    // a gzip body the request asked for (hclient.request and h2_exchange
    // add Accept-Encoding: gzip on the same terms) is decoded, without
    // Content-Encoding and Content-Length, as Transport does; a caller's
    // own Accept-Encoding or Range gets the body as sent
    if !rbody.is_empty() && method != "HEAD" && !has_key(hk, "Accept-Encoding") && !has_key(hk, "Range") {
      let ce = field_at(headers, "Content-Encoding")
      if ce >= 0 && ascii_lower(headers[ce + 1]) == "gzip" {
        match archive.gunzip(rbody) {
          Ok(d) => rbody = d
          // gzip.Reader's error, as io.ReadAll returns it ("gzip:
          // invalid header", "unexpected EOF", ...)
          Err(e) => return cfail(4, e.msg.trim_prefix("gunzip: "))
        }
        headers = without_fields(headers, "Content-Encoding", "Content-Length")
      }
    }
    // redirects (Client.Do's redirectBehavior)
    let li = field_at(headers, "Location")
    let follow = (status == 301 || status == 302 || status == 303 || (src.is_empty() && (status == 307 || status == 308))) && li >= 0 && !headers[li + 1].is_empty()
    if !follow || max_redirects <= 0 {
      // (max_redirects 0: CheckRedirect's ErrUseLastResponse, the 3xx
      // with its Location as sent; decision 0404)
      return CResult{err: 0, msg: "", status: status, headers: headers, body: rbody}
    }
    last_loc = headers[li + 1]
    if redirects >= max_redirects {
      // max_redirects followed (the spec's "up to 10"; Go's
      // defaultCheckRedirect counts requests, so it follows 9): the error
      // names the Location
      return cfail(4, op + " " + go_quote(last_loc) + ": stopped after ${max_redirects} redirects")
    }
    // the Referer: this request's URL (url.URL.String)
    referer = u.scheme + "://" + u.host + escape_path(u.path)
    if !u.rawquery.is_empty() {
      referer = referer + "?" + u.rawquery
    }
    has_referer = true
    // the new URL: the Location resolved against this one; a Location
    // url.Parse rejects is Client.Do's error naming this request
    let loc = last_loc
    let lhash = scan.find(loc, "#", 0)
    let lu = neturl.url_parse(if lhash >= 0 { rawb.str_slice(loc, 0, lhash) } else { loc }, false)
    if !lu.ok {
      return cfail(4, op + " " + go_quote(raw) + ": failed to parse Location header " + go_quote(loc) + ": parse " + go_quote(loc) + ": " + lu.err)
    }
    if scan.find(loc, ":", 0) >= 0 && !loc.starts_with("/") {
      raw = loc
    } else if loc.starts_with("//") {
      raw = u.scheme + ":" + loc
    } else if loc.starts_with("/") {
      raw = u.scheme + "://" + u.host + loc
    } else {
      // relative to the current path's directory
      let slash = rfind(u.path.bytes(), 47, u.path.len())
      let dir = if slash >= 0 { escape_path(rawb.str_slice(u.path, 0, slash + 1)) } else { "/" }
      raw = u.scheme + "://" + u.host + dir + loc
    }
    if status == 301 || status == 302 || status == 303 {
      if method != "GET" && method != "HEAD" {
        method = "GET"
      }
      // once a hop drops the body, it is never sent again
      include_body = false
      src = []
    }
    if !include_body {
      body = b""
    }
    redirects += 1
  }
  cfail(4, "")
}
