// The request parsing of the native HTTP/1.1 server, written in Xo
// (decision 0193 step 6): the request line and the MIME header with
// continuation lines and Go's checks (net/http's readRequest and
// conn.readRequest, textproto), the request target (net/url's
// ParseRequestURI) and its query (ParseQuery), chunked bodies with their
// trailers (chunkedReader), and the text helpers of std/http (url.Parse's
// parts and error, url.PathUnescape, url.QueryEscape, strconv.Quote,
// CanonicalMIMEHeaderKey, EqualFold). They were C (std/llrt/xo_http.c;
// decision 0198 deleted the C path, `XO_LLRT_C=http1`); the semantics
// are the same, so a client observes what net/http answers. Since audit
// item B10 (2026-10-14) the client is here too (client_do: the URL, the
// redirects, the reading of a response, parse_response), and so is the
// parse of an HTTP/2 request's :path (h2_target); xo_http.c's C parser
// is test data only (std/llrt/testdata/http_ref.c). The header blocks of
// HTTP/2 pass through here to hpack.xo: the server's (H2Conn) and, since
// audit item B11, the client's (h2_exchange).
//
// C never calls compiled Xo (decision 0180), so the connection's task
// (std/native/http.xo, serve_conn) calls the C reader (rthttp.hc_read)
// until it stops at a parse: 3, a request head at the unread input
// (rthttp.hc_input, rthttp.hc_eof; the result to rthttp.hc_head); 4, a
// chunked body (the result to rthttp.hc_chunked). The C keeps the socket,
// the buffer, the body reading, and the error answers; the parsed head
// stays here and becomes the Request.
use native/llrt/hpack
use native/llrt/http1_tables
use native/llrt/netpolicy
use native/llrt/scan
use native/rt
use native/rthttp

/// net/http's DefaultMaxHeaderBytes plus the 4096 bytes of slack its
/// server reads; a longer head is 431.
const MAX_HEAD: Int = 1052672

/// Header fields per request (Go has no count limit: its bytes limit
/// bounds them); more is 431.
const MAX_FIELDS: Int = 10000

const MAX_INT: Int = 9223372036854775807

// The results of a head's parse (xo_http.c's HP_*).
const NEED: Int = 0
const OK: Int = 1
const EOF: Int = 2
const BAD: Int = 3
const STATUS: Int = 4
const TOO_LARGE: Int = 5
const BAD_TE: Int = 6

// The byte classes (http1_tables.CLASS).
const TCHAR: Int = 1
const VBYTE: Int = 2
const HOSTB: Int = 4
const HEX: Int = 8
const USERINFO: Int = 16
const HOSTHDR: Int = 32
const QKEEP: Int = 64
const PKEEP: Int = 128

fn cls(c: Int) -> Int { Int(http1_tables.CLASS[c & 255]) }

fn unhex(c: Int) -> Int { if c <= 57 { c - 48 } else { (c | 32) - 87 } }

fn lower(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// The index of the first byte c of s in [from, to), or -1 (from and to
/// clamped to s): one scan of the range, where rt.str_find searched on
/// to the end of the string.
fn find(s: Str, c: Int, from: Int, to: Int) -> Int {
  let b = s.bytes()
  let f = if from < 0 { 0 } else { from }
  let t = if to > b.len() { b.len() } else { to }
  if f >= t {
    return -1
  }
  scan.find_byte(b, f, t, c)
}

/// The index of the first byte c of b in [from, to), or -1: a short
/// range (scan.find would search on to the end of the string).
fn bfind(b: Bytes, c: Int, from: Int, to: Int) -> Int {
  var i = from
  while i < to {
    if Int(b[i]) == c {
      return i
    }
    i += 1
  }
  -1
}

/// The index of the last byte c of b in [0, to), or -1.
fn rfind(b: Bytes, c: Int, to: Int) -> Int {
  var i = to - 1
  while i >= 0 {
    if Int(b[i]) == c {
      return i
    }
    i -= 1
  }
  -1
}

fn is_sp(c: Int) -> Bool { c == 32 || c == 9 }

// ---------------------------------------------------------------------------
// Request targets (net/url) and queries

// h_unescape's modes
const U_PATH: Int = 0
const U_QUERY: Int = 1
const U_HOST: Int = 2

/// The end of the bytes of b from lo that unescape keeps as they are.
fn plain_end(b: Bytes, lo: Int, hi: Int, mode: Int) -> Int {
  var i = lo
  while i < hi {
    let c = Int(b[i])
    if c == 37 || (c == 43 && mode == U_QUERY) || (mode == U_HOST && c < 128 && (cls(c) & HOSTB) == 0) {
      return i
    }
    i += 1
  }
  hi
}

/// url.unescape of b[lo..hi] for a path, a query component, or a host:
/// (false, _) on an invalid escape.
fn unescape(b: Bytes, s: Str, lo: Int, hi: Int, mode: Int) -> (Bool, Str) {
  // the common case: nothing to change
  var i = plain_end(b, lo, hi, mode)
  if i == hi {
    return (true, rt.str_slice(s, lo, hi))
  }
  // runs of 8 bytes or more go over at once, other bytes seven at a time
  // in a word (a C call each)
  var out = rt.rs_append_bytes(rt.rs_with_cap(hi - lo), b, lo, i, 0)
  var w = 0
  var wk = 0
  while i < hi {
    let c = Int(b[i])
    var x = c
    if c == 37 {
      if i + 2 >= hi || (cls(Int(b[i + 1])) & HEX) == 0 || (cls(Int(b[i + 2])) & HEX) == 0 {
        return (false, "")
      }
      let h = unhex(Int(b[i + 1]))
      // %25 is the one escape of an ASCII byte a host may have
      let pct = b[i + 1] == 50 && b[i + 2] == 53
      if mode == U_HOST && h < 8 && !pct {
        return (false, "")
      }
      x = (h << 4) | unhex(Int(b[i + 2]))
      i += 3
    } else if c == 43 && mode == U_QUERY {
      x = 32
      i += 1
    } else if mode == U_HOST && c < 128 && (cls(c) & HOSTB) == 0 {
      return (false, "")
    } else {
      let j = plain_end(b, i, hi, mode)
      if j - i >= 8 {
        if wk > 0 {
          out = rt.rs_push_word(out, w, wk)
          w = 0
          wk = 0
        }
        out = rt.rs_append_bytes(out, b, i, j, 0)
        i = j
        continue
      }
      i += 1
    }
    w = w | ((x & 255) << ((8 * wk) & 63))
    wk += 1
    if wk == 7 {
      out = rt.rs_push_word(out, w, 7)
      w = 0
      wk = 0
    }
  }
  if wk > 0 {
    out = rt.rs_push_word(out, w, wk)
  }
  (true, out)
}

/// Whether b[lo..hi] is empty or `:` and digits.
fn valid_port(b: Bytes, lo: Int, hi: Int) -> Bool {
  if lo >= hi {
    return true
  }
  if b[lo] != 58 {
    return false
  }
  var i = lo + 1
  while i < hi {
    if b[i] < 48 || b[i] > 57 {
      return false
    }
    i += 1
  }
  true
}

/// inet_pton(AF_INET, ...) of b[lo..hi] (BIND's inet_pton4: four
/// decimal octets without leading zeros).
fn ipv4_ok(b: Bytes, lo: Int, hi: Int) -> Bool {
  var saw = false
  var octets = 0
  var cur = 0
  var i = lo
  while i < hi {
    let c = Int(b[i])
    if c >= 48 && c <= 57 {
      let v = cur * 10 + (c - 48)
      if saw && cur == 0 {
        return false
      }
      if v > 255 {
        return false
      }
      cur = v
      if !saw {
        octets += 1
        if octets > 4 {
          return false
        }
        saw = true
      }
    } else if c == 46 && saw {
      if octets == 4 {
        return false
      }
      cur = 0
      saw = false
    } else {
      return false
    }
    i += 1
  }
  octets >= 4
}

/// inet_pton(AF_INET6, ...) of b[lo..hi] (BIND's inet_pton6, which
/// xo_http.c called): hex groups of at most 4 digits, one `::`, a dotted
/// IPv4 address at the end.
fn ipv6_ok(b: Bytes, lo0: Int, hi: Int) -> Bool {
  var lo = lo0
  if lo < hi && b[lo] == 58 {
    lo += 1
    if lo >= hi || b[lo] != 58 {
      return false
    }
  }
  var tp = 0
  var colon = -1
  var cur = lo
  var digits = 0
  var i = lo
  while i < hi {
    let c = lower(Int(b[i]))
    i += 1
    if (c >= 48 && c <= 57) || (c >= 97 && c <= 102) {
      digits += 1
      if digits > 4 {
        return false
      }
      continue
    }
    if c == 58 {
      cur = i
      if digits == 0 {
        if colon >= 0 {
          return false
        }
        colon = tp
        continue
      } else if i >= hi {
        return false
      }
      if tp + 2 > 16 {
        return false
      }
      tp += 2
      digits = 0
      continue
    }
    if c == 46 && tp + 4 <= 16 && ipv4_ok(b, cur, hi) {
      tp += 4
      digits = 0
      i = hi
      break
    }
    return false
  }
  if digits > 0 {
    if tp + 2 > 16 {
      return false
    }
    tp += 2
  }
  if colon >= 0 {
    if tp == 16 {
      return false
    }
    tp = 16
  }
  tp == 16
}

/// url.parseHost of b[lo..hi]: the host unescaped, or (false, _).
fn parse_host(b: Bytes, s: Str, lo: Int, hi: Int) -> (Bool, Str) {
  var ob = -1
  var i = hi - 1
  while i >= lo {
    if b[i] == 91 {
      ob = i
      break
    }
    i -= 1
  }
  if ob > lo {
    return (false, "")
  }
  if ob == lo {
    var cb = -1
    var j = hi - 1
    while j >= lo {
      if b[j] == 93 {
        cb = j
        break
      }
      j -= 1
    }
    if cb < 0 || !valid_port(b, cb + 1, hi) {
      return (false, "")
    }
    let (ok, inner) = unescape(b, s, lo + 1, cb, U_HOST)
    if !ok {
      return (false, "")
    }
    let ib = inner.bytes()
    // the zone goes; inet_pton reads to the first NUL byte
    var zn = 0
    while zn < ib.len() && ib[zn] != 37 && ib[zn] != 0 {
      zn += 1
    }
    if !ipv6_ok(ib, 0, zn) {
      return (false, "")
    }
    return unescape(b, s, lo, hi, U_HOST)
  }
  let colon = find(s, 58, lo, hi)
  if colon >= 0 {
    if rfind(b, 58, hi) != colon {
      // strict colons (Go 1.26): only one colon outside brackets
      return (false, "")
    }
    if !valid_port(b, colon, hi) {
      return (false, "")
    }
  }
  unescape(b, s, lo, hi, U_HOST)
}

/// The error text of a bad escape in b[lo..hi] (url.EscapeError).
fn escape_error(b: Bytes, s: Str, lo: Int, hi: Int) -> Str {
  var i = lo
  while i < hi {
    if b[i] == 37 {
      let left = hi - i
      if left < 3 || (cls(Int(b[i + 1])) & HEX) == 0 || (cls(Int(b[i + 2])) & HEX) == 0 {
        let k = if left < 3 { left } else { 3 }
        return "invalid URL escape " + go_quote(rt.str_slice(s, i, i + k))
      }
      i += 3
      continue
    }
    i += 1
  }
  "invalid URL"
}

/// A parsed URL (xo_http.c's hurl).
pub struct Url {
  ok: Bool
  /// Go's reason when it failed (without `parse "url": `).
  err: Str
  scheme: Str
  host: Str
  path: Str
  rawquery: Str
}

fn url_fail(err: Str) -> Url { Url{ok: false, err: err, scheme: "", host: "", path: "", rawquery: ""} }

/// net/url's parse of s: ParseRequestURI when via_request, else Parse
/// (the fragment already cut).
fn url_parse(s: Str, via_request: Bool) -> Url {
  let b = s.bytes()
  let sn = b.len()
  var i = 0
  while i < sn {
    let c = Int(b[i])
    if c < 32 || c == 127 {
      return url_fail("net/url: invalid control character in URL")
    }
    i += 1
  }
  if sn == 0 && via_request {
    return url_fail("empty url")
  }
  if sn == 1 && b[0] == 42 {
    return Url{ok: true, err: "", scheme: "", host: "", path: "*", rawquery: ""}
  }
  // getScheme
  var rest = 0
  var scheme = ""
  i = 0
  while i < sn {
    let c = Int(b[i])
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
      i += 1
      continue
    }
    if (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46 {
      if i == 0 {
        break
      }
      i += 1
      continue
    }
    if c == 58 {
      if i == 0 {
        return url_fail("missing protocol scheme")
      }
      scheme = rt.rs_append_bytes("", b, 0, i, 1)
      rest = i + 1
    }
    break
  }
  // the query: a single trailing ? is ForceQuery with no RawQuery
  var rn = sn
  var q = -1
  var qcount = 0
  i = rest
  while i < sn {
    if b[i] == 63 {
      if q < 0 {
        q = i
      }
      qcount += 1
    }
    i += 1
  }
  var rawquery = ""
  if rn > rest && b[rn - 1] == 63 && qcount == 1 {
    rn -= 1
  } else if q >= 0 {
    rawquery = rt.str_slice(s, q + 1, rn)
    rn = q
  }
  if !(rn > rest && b[rest] == 47) {
    if !scheme.is_empty() {
      // opaque: no host, no path
      return Url{ok: true, err: "", scheme: scheme, host: "", path: "", rawquery: rawquery}
    }
    if via_request {
      return url_fail("invalid URI for request")
    }
    let sl = find(s, 47, rest, rn)
    let segn = if sl < 0 { rn } else { sl }
    if find(s, 58, rest, segn) >= 0 {
      return url_fail("first path segment in URL cannot contain colon")
    }
  }
  var host = ""
  var p = rest
  let authority = rn - rest >= 2 && b[rest] == 47 && b[rest + 1] == 47 && (!scheme.is_empty() || (!via_request && !(rn - rest >= 3 && b[rest + 2] == 47)))
  if authority {
    let a = rest + 2
    let slash = find(s, 47, a, rn)
    let ae = if slash < 0 { rn } else { slash }
    p = ae
    var at = -1
    var k = ae - 1
    while k >= a {
      if b[k] == 64 {
        at = k
        break
      }
      k -= 1
    }
    let hlo = if at >= 0 { at + 1 } else { a }
    let (hok, h) = parse_host(b, s, hlo, ae)
    if !hok {
      let shown = if ae - hlo > 120 { hlo + 120 } else { ae }
      return url_fail("invalid host " + go_quote_c(rt.str_slice(s, hlo, shown)))
    }
    host = h
    if at >= 0 {
      var u = a
      while u < at {
        if (cls(Int(b[u])) & USERINFO) == 0 {
          return url_fail("net/url: invalid userinfo")
        }
        u += 1
      }
      u = a
      while u < at {
        if b[u] == 37 {
          let left = at - u
          if left < 3 || (cls(Int(b[u + 1])) & HEX) == 0 || (cls(Int(b[u + 2])) & HEX) == 0 {
            let kk = if left < 3 { left } else { 3 }
            return url_fail("invalid URL escape " + go_quote_c(rt.str_slice(s, u, u + kk)))
          }
          u += 2
        }
        u += 1
      }
    }
  }
  let (pok, path) = unescape(b, s, p, rn, U_PATH)
  if !pok {
    return url_fail(escape_error(b, s, p, rn))
  }
  Url{ok: true, err: "", scheme: scheme, host: host, path: path, rawquery: rawquery}
}

/// The `"%s"` of a C format: the text in quotes as it is (xo_http.c's
/// snprintf; the bytes are printable here: control bytes failed first).
fn go_quote_c(s: Str) -> Str { "\"" + s + "\"" }

/// url.ParseRequestURI of a request target; a CONNECT target that is not
/// a path is an authority.
fn parse_target(raw: Str, connect: Bool) -> Url {
  if connect && !raw.starts_with("/") {
    let u = url_parse("http://" + raw, true)
    if u.ok {
      return Url{ok: true, err: "", scheme: "", host: u.host, path: u.path, rawquery: u.rawquery}
    }
    return u
  }
  url_parse(raw, true)
}

/// std/rt's urlOf over url.ParseQuery: each key once with its first
/// value, the keys sorted: [k1, v1, k2, v2, ...].
pub fn query_parts(q: Str) -> List[Str] {
  let b = q.bytes()
  let n = b.len()
  var amps = 0
  var i = 0
  while i < n {
    if b[i] == 38 {
      amps += 1
    }
    i += 1
  }
  if amps + 1 > 10000 {
    return [] // number of URL query parameters exceeded limit
  }
  // the keys kept sorted as they come (a key seen before keeps its first
  // value): [k1, v1, k2, v2, ...]
  var out: List[Str] = []
  i = 0
  while i < n {
    var j = scan.find(q, "&", i)
    if j < 0 {
      j = n
    }
    let lo = i
    i = j + 1
    if j == lo || find(q, 59, lo, j) >= 0 {
      continue
    }
    let eq = find(q, 61, lo, j)
    let ke = if eq < 0 { j } else { eq }
    let (kok, k) = unescape(b, q, lo, ke, U_QUERY)
    if !kok {
      continue
    }
    var v = ""
    if eq >= 0 {
      let (vok, vv) = unescape(b, q, eq + 1, j, U_QUERY)
      if !vok {
        continue
      }
      v = vv
    }
    // binary search for k among the keys
    var a = 0
    var z = out.len() / 2
    var found = false
    while a < z {
      let m = (a + z) / 2
      let km = out[2 * m]
      if km == k {
        found = true
        break
      }
      if km < k {
        a = m + 1
      } else {
        z = m
      }
    }
    if found {
      continue
    }
    out.push(k)
    out.push(v)
    var e = out.len() - 2
    while e > 2 * a {
      out[e] = out[e - 2]
      out[e + 1] = out[e - 1]
      e -= 2
    }
    out[2 * a] = k
    out[2 * a + 1] = v
  }
  out
}

/// url's splitHostPort: the hostname (brackets removed) and the port
/// when it is valid.
fn split_hostport(host: Str) -> (Str, Str) {
  let b = host.bytes()
  let n = b.len()
  var hn = n
  var port = ""
  let i = rfind(b, 58, n)
  if i >= 0 && valid_port(b, i, n) {
    port = rt.str_slice(host, i + 1, n)
    hn = i
  }
  if hn >= 2 && b[0] == 91 && b[hn - 1] == 93 {
    return (rt.str_slice(host, 1, hn - 1), port)
  }
  (rt.str_slice(host, 0, hn), port)
}

/// Request.url.host of a server's request: the Host without its port
/// (net.SplitHostPort), or all of it when it has none or does not split.
pub fn host_name(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var colon = n - 1
  while colon >= 0 && b[colon] != 58 {
    colon -= 1
  }
  if colon < 0 {
    return s
  }
  var lo = 0
  var hi = colon
  var j = 0 // no '[' from j, no ']' from k
  var k = 0
  if n > 0 && b[0] == 91 {
    let end = scan.find_byte(b, 0, n, 93)
    if end < 0 || end + 1 != colon {
      return s
    }
    lo = 1
    hi = end
    j = 1
    k = end + 1
  } else if scan.find_byte(b, 0, colon, 58) >= 0 {
    return s
  }
  if scan.find_byte(b, j, n, 91) >= 0 || scan.find_byte(b, k, n, 93) >= 0 {
    return s
  }
  rt.str_slice(s, lo, hi)
}

/// The port of an absolute request target's host (url.host), or -1: none,
/// not ":" and digits, empty, or over the largest Int.
pub fn host_port(h: Str) -> Int {
  let b = h.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 58 {
    i -= 1
  }
  if i < 0 || i + 1 == b.len() || !valid_port(b, i, b.len()) {
    return -1
  }
  var v = 0
  var j = i + 1
  while j < b.len() {
    let d = Int(b[j]) - 48
    if v > (9223372036854775807 - d) / 10 {
      return -1
    }
    v = v * 10 + d
    j += 1
  }
  v
}

/// url.Parse (the fragment cut) or ParseRequestURI (request): [] when it
/// fails, else [scheme, hostname, port, path, raw query, host].
pub fn url_parts(s: Str, request: Bool) -> List[Str] {
  var t = s
  if !request {
    let h = scan.find(s, "#", 0)
    if h >= 0 {
      t = rt.str_slice(s, 0, h)
    }
  }
  let u = url_parse(t, request)
  if !u.ok {
    return []
  }
  let (name, port) = split_hostport(u.host)
  [u.scheme, name, port, u.path, u.rawquery, u.host]
}

/// The text of url.Parse's error: parse "url": reason; "" when it parses.
pub fn url_error(s: Str) -> Str {
  var t = s
  let h = scan.find(s, "#", 0)
  if h >= 0 {
    t = rt.str_slice(s, 0, h)
  }
  let u = url_parse(t, false)
  if u.ok {
    return ""
  }
  "parse " + go_quote(t) + ": " + u.err
}

/// url.PathUnescape, "" when an escape is invalid.
pub fn path_unescape(s: Str) -> Str {
  if scan.find(s, "%", 0) < 0 {
    return s
  }
  let b = s.bytes()
  let (ok, out) = unescape(b, s, 0, b.len(), U_PATH)
  if ok { out } else { "" }
}

/// url.QueryEscape.
pub fn query_escape(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && (cls(Int(b[i])) & QKEEP) != 0 {
    i += 1
  }
  if i == n {
    return s
  }
  let hex = b"0123456789ABCDEF"
  var out = rt.rs_append_bytes("", b, 0, i, 0)
  while i < n {
    let c = Int(b[i])
    if (cls(c) & QKEEP) != 0 {
      out = rt.rs_push_byte(out, c)
    } else if c == 32 {
      out = rt.rs_push_byte(out, 43)
    } else {
      out = rt.rs_push_word(out, 37 | (Int(hex[c >> 4]) << 8) | (Int(hex[c & 15]) << 16), 3)
    }
    i += 1
  }
  out
}

/// strconv.Quote (printable: ASCII graphic and every rune from U+00A1
/// but U+00AD, U+2028, U+2029; xo_http.c's approximation of IsPrint).
pub fn go_quote(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  let hex = b"0123456789abcdef"
  var out = rt.rs_push_byte(rt.rs_with_cap(n + 2), 34)
  var i = 0
  while i < n {
    let c = Int(b[i])
    if c >= 32 && c < 127 && c != 34 && c != 92 {
      // a run of plain ASCII
      var j = i + 1
      while j < n {
        let d = Int(b[j])
        if d < 32 || d >= 127 || d == 34 || d == 92 {
          break
        }
        j += 1
      }
      out = rt.rs_append_bytes(out, b, i, j, 0)
      i = j
      continue
    }
    let x = rt.bytes_decode(b, i)
    let r = x >> 3
    let size = x & 7
    if r == 0xFFFD && size == 1 {
      out = rt.rs_push_word(out, 92 | (120 << 8) | (Int(hex[c >> 4]) << 16) | (Int(hex[c & 15]) << 24), 4)
    } else if r == 34 || r == 92 {
      out = rt.rs_push_word(out, 92 | (r << 8), 2)
    } else if r >= 0xA1 && r != 0xAD && r != 0x2028 && r != 0x2029 {
      out = rt.rs_append_bytes(out, b, i, i + size, 0)
    } else if r == 7 {
      out = rt.rs_push_word(out, 92 | (97 << 8), 2)
    } else if r == 8 {
      out = rt.rs_push_word(out, 92 | (98 << 8), 2)
    } else if r == 12 {
      out = rt.rs_push_word(out, 92 | (102 << 8), 2)
    } else if r == 10 {
      out = rt.rs_push_word(out, 92 | (110 << 8), 2)
    } else if r == 13 {
      out = rt.rs_push_word(out, 92 | (114 << 8), 2)
    } else if r == 9 {
      out = rt.rs_push_word(out, 92 | (116 << 8), 2)
    } else if r == 11 {
      out = rt.rs_push_word(out, 92 | (118 << 8), 2)
    } else if r < 32 || r == 127 {
      out = rt.rs_push_word(out, 92 | (120 << 8) | (Int(hex[r >> 4]) << 16) | (Int(hex[r & 15]) << 24), 4)
    } else {
      let k = if r < 0x10000 { 4 } else { 8 }
      out = rt.rs_push_word(out, 92 | ((if k == 4 { 117 } else { 85 }) << 8), 2)
      var sh = 4 * (k - 1)
      while sh >= 0 {
        out = rt.rs_push_byte(out, Int(hex[(r >> sh) & 15]))
        sh -= 4
      }
    }
    i += size
  }
  rt.rs_push_byte(out, 34)
}

/// textproto.CanonicalMIMEHeaderKey: unchanged when a byte is not a token
/// byte.
pub fn canonical_key(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  var upper = true
  var same = true
  while i < n {
    let c = Int(b[i])
    if (cls(c) & TCHAR) == 0 {
      return s
    }
    if (upper && c >= 97 && c <= 122) || (!upper && c >= 65 && c <= 90) {
      same = false
    }
    upper = c == 45
    i += 1
  }
  if same {
    return s
  }
  var out = rt.rs_with_cap(n)
  upper = true
  i = 0
  while i < n {
    var c = Int(b[i])
    if upper && c >= 97 && c <= 122 {
      c -= 32
    } else if !upper && c >= 65 && c <= 90 {
      c += 32
    }
    out = rt.rs_push_byte(out, c)
    upper = c == 45
    i += 1
  }
  out
}

/// strings.EqualFold of ASCII letters.
pub fn equal_fold(a: Str, b: Str) -> Bool {
  let x = a.bytes()
  let y = b.bytes()
  let n = x.len()
  if n != y.len() {
    return false
  }
  var i = 0
  while i < n {
    if lower(Int(x[i])) != lower(Int(y[i])) {
      return false
    }
    i += 1
  }
  true
}

// ---------------------------------------------------------------------------
// Reading a request (xo_http.c's hp_head)

/// A request head: what std/rt's serve hands to Xo code, and what the C
/// needs to read the body and answer.
pub struct Head {
  method: Str
  target: Str
  major: Int
  minor: Int
  /// The header: canonical names and their values joined with ", ", in
  /// the order of first appearance: [name, value, ...].
  headers: List[Str]
  /// req.Host.
  host: Str
  url: Url
  /// The URL's query: [key, first value, ...], keys sorted.
  query: List[Str]
  /// ContentLength (-1 chunked).
  clen: Int
  chunked: Bool
  close: Bool
  wants10ka: Bool
  wantsclose: Bool
  expect100: Bool
  expect_other: Bool
  /// "PRI * HTTP/2.0" (closed after the answer).
  h2up: Bool
}

fn no_head() -> Head {
  Head{method: "", target: "", major: 0, minor: 0, headers: [], host: "", url: url_fail(""), query: [], clen: 0, chunked: false, close: false, wants10ka: false, wantsclose: false, expect100: false, expect_other: false, h2up: false}
}

/// The result of a head's parse: res (NEED, OK, ...), the head's length
/// (OK), the head, and for STATUS its code and text.
pub struct Parse {
  res: Int
  used: Int
  head: Head
  status: Int
  reason: Str
}

fn fail(res: Int) -> Parse { Parse{res: res, used: 0, head: no_head(), status: 0, reason: ""} }

fn fail_status(code: Int, reason: Str, used: Int) -> Parse { Parse{res: STATUS, used: used, head: no_head(), status: code, reason: reason} }

/// The line at b[i..n]: (found, its end without \n and the \r before it,
/// the start of the next). Not found when there is no \n yet (at eof the
/// rest is the line, bufio's ReadLine).
fn line_at(s: Str, b: Bytes, i: Int, n: Int, eof: Bool) -> (Bool, Int, Int) {
  let nl = if i < n { scan.find_byte(s.bytes(), i, s.len(), 10) } else { -1 }
  if nl < 0 {
    if eof && i < n {
      return (true, n, n)
    }
    return (false, 0, 0)
  }
  if nl > i && b[nl - 1] == 13 {
    return (true, nl - 1, nl + 1)
  }
  (true, nl, nl + 1)
}

/// The result when more input may complete the head.
fn need(n: Int) -> Parse { fail(if n > MAX_HEAD { TOO_LARGE } else { NEED }) }

/// net/http's hasToken: tok anywhere in v between space, comma, or tab
/// boundaries, ASCII case insensitive (tok lower case).
fn server_token(v: Str, tok: Str) -> Bool {
  let b = v.bytes()
  let t = tok.bytes()
  let n = b.len()
  let tl = t.len()
  if tl > n || tl == 0 {
    return false
  }
  let t0 = Int(t[0])
  var sp = 0
  while sp + tl <= n {
    let c = Int(b[sp])
    if c == t0 || (c | 32) == t0 {
      let before = sp == 0 || b[sp - 1] == 32 || b[sp - 1] == 44 || b[sp - 1] == 9
      let e = sp + tl
      let after = e == n || b[e] == 32 || b[e] == 44 || b[e] == 9
      if before && after {
        var k = 0
        var eq = true
        while k < tl {
          if lower(Int(b[sp + k])) != lower(Int(t[k])) {
            eq = false
            break
          }
          k += 1
        }
        if eq {
          return true
        }
      }
    }
    sp += 1
  }
  false
}

/// httpguts.headerValueContainsToken (shouldClose): tok (lower case) is
/// one of the comma separated elements of v.
fn has_token(v: Str, tok: Str) -> Bool {
  let b = v.bytes()
  let t = tok.bytes()
  let n = b.len()
  let tl = t.len()
  var i = 0
  while i <= n {
    var j = i
    while j < n && b[j] != 44 {
      j += 1
    }
    var a = i
    var z = j
    while a < z && is_sp(Int(b[a])) {
      a += 1
    }
    while z > a && is_sp(Int(b[z - 1])) {
      z -= 1
    }
    if z - a == tl {
      var k = 0
      var eq = true
      while k < tl {
        let c = Int(b[a + k])
        if c >= 128 || lower(c) != Int(t[k]) {
          eq = false
          break
        }
        k += 1
      }
      if eq {
        return true
      }
    }
    i = j + 1
  }
  false
}

/// textproto.TrimString (ASCII space, tab, CR, LF).
fn trim_ws(s: Str) -> Str {
  let b = s.bytes()
  var a = 0
  var z = b.len()
  while a < z && (b[a] == 32 || b[a] == 9 || b[a] == 13 || b[a] == 10) {
    a += 1
  }
  while z > a && (b[z - 1] == 32 || b[z - 1] == 9 || b[z - 1] == 13 || b[z - 1] == 10) {
    z -= 1
  }
  if a == 0 && z == b.len() { s } else { rt.str_slice(s, a, z) }
}

/// The start and end of b[a..z] without spaces and tabs at either end.
fn trim_sp(b: Bytes, a0: Int, z0: Int) -> (Int, Int) {
  var a = a0
  var z = z0
  while a < z && is_sp(Int(b[a])) {
    a += 1
  }
  while z > a && is_sp(Int(b[z - 1])) {
    z -= 1
  }
  (a, z)
}

/// Reads the request line and the header at the start of s (eof: no
/// more will come), as net/http's readRequest and the checks of
/// conn.readRequest.
pub fn parse_head(s: Str, eof: Bool) -> Parse {
  let b = s.bytes()
  let n = b.len()
  if n == 0 {
    return fail(if eof { EOF } else { NEED })
  }
  let (found, le, next0) = line_at(s, b, 0, n, eof)
  if !found {
    return need(n)
  }
  if eof && next0 == n && le == n && n % 4096 == 0 {
    // a request line cut by the end of the stream that fills net/http's
    // 4096 byte reader exactly: its last read finds no byte, so the line
    // reads as io.EOF and the connection closes quietly
    return fail(EOF)
  }
  if next0 > MAX_HEAD {
    return fail(TOO_LARGE)
  }
  // METHOD SP target SP proto (strings.Cut on single spaces)
  let sp1 = find(s, 32, 0, le)
  if sp1 < 0 {
    return fail(BAD)
  }
  let sp2 = find(s, 32, sp1 + 1, le)
  if sp2 < 0 || sp1 == 0 {
    return fail(BAD)
  }
  var k = 0
  while k < sp1 {
    if (cls(Int(b[k])) & TCHAR) == 0 {
      return fail(BAD) // invalid method
    }
    k += 1
  }
  let pn = le - sp2 - 1
  let p0 = sp2 + 1
  var major = 0
  var minor = 0
  if pn == 8 && b[p0] == 72 && b[p0 + 1] == 84 && b[p0 + 2] == 84 && b[p0 + 3] == 80 && b[p0 + 4] == 47 && b[p0 + 6] == 46 && b[p0 + 5] >= 48 && b[p0 + 5] <= 57 && b[p0 + 7] >= 48 && b[p0 + 7] <= 57 {
    major = Int(b[p0 + 5]) - 48
    minor = Int(b[p0 + 7]) - 48
  } else {
    return fail(BAD) // malformed HTTP version
  }
  let method = rt.str_slice(s, 0, sp1)
  let target = rt.str_slice(s, sp1 + 1, sp2)
  let connect = method == "CONNECT"
  let url = parse_target(target, connect)
  if !url.ok {
    return fail(BAD)
  }
  let query = if url.rawquery.is_empty() { [] } else { query_parts(url.rawquery) }
  // the header: lines up to an empty one
  var i = next0
  var keys: List[Str] = []
  var vals: List[Str] = []
  if i < n && is_sp(Int(b[i])) {
    // malformed MIME header initial line (needs the line to say so)
    let (f2, _, _) = line_at(s, b, i, n, eof)
    if !f2 {
      return fail(if eof { BAD } else { NEED })
    }
    return fail(BAD)
  }
  while true {
    if i > MAX_HEAD {
      return fail(TOO_LARGE)
    }
    let (f, e, nx) = line_at(s, b, i, n, eof)
    if !f {
      if eof {
        return fail(BAD)
      }
      return need(n)
    }
    if e == i {
      // the empty line ends the header
      i = nx
      break
    }
    // a field line: it must have a colon
    if find(s, 58, i, e) < 0 {
      return fail(BAD)
    }
    // trim (spaces and tabs) and join continuation lines
    let (a, z) = trim_sp(b, i, e)
    var cont = rt.str_slice(s, a, z)
    i = nx
    while true {
      if i >= n {
        if !eof {
          return need(n)
        }
        break
      }
      if !is_sp(Int(b[i])) {
        break
      }
      // a continuation line: skip its leading spaces and tabs
      var c = i
      while c < n && is_sp(Int(b[c])) {
        c += 1
      }
      if c >= n && !eof {
        return need(n)
      }
      cont = rt.rs_push_byte(cont, 32)
      let (f3, e3, nx3) = line_at(s, b, c, n, eof)
      if !f3 {
        if !eof {
          return need(n)
        }
        // at the end: nothing more (readLineSlice failed)
        i = n
        break
      }
      let (a3, z3) = trim_sp(b, c, e3)
      cont = rt.rs_append_bytes(cont, b, a3, z3, 0)
      i = nx3
    }
    // key: up to the first colon; token bytes, or spaces (kept as is)
    let cb = cont.bytes()
    let cn = cb.len()
    let colon = scan.find(cont, ":", 0)
    if colon <= 0 {
      return fail(BAD)
    }
    var x = 0
    while x < colon {
      let ch = Int(cb[x])
      if (cls(ch) & TCHAR) == 0 && ch != 32 {
        return fail(BAD)
      }
      x += 1
    }
    x = colon + 1
    while x < cn {
      if (cls(Int(cb[x])) & VBYTE) == 0 {
        return fail(BAD)
      }
      x += 1
    }
    var v0 = colon + 1
    while v0 < cn && is_sp(Int(cb[v0])) {
      v0 += 1
    }
    if keys.len() == MAX_FIELDS {
      return fail(TOO_LARGE)
    }
    keys.push(canonical_key(rt.str_slice(cont, 0, colon)))
    vals.push(rt.str_slice(cont, v0, cn))
  }
  if i > MAX_HEAD {
    return fail(TOO_LARGE)
  }
  head_of(method, target, major, minor, url, query, keys, vals, i, connect)
}

/// The checks and merging of a head whose fields were read (the rest of
/// hp_head): Go's Header, readTransfer, shouldClose, conn.readRequest.
fn head_of(method: Str, target: Str, major: Int, minor: Int, url: Url, query: List[Str], keys: List[Str], vals: List[Str], used: Int, connect: Bool) -> Parse {
  let nraw = keys.len()
  // counts per key, for Host and Content-Length checks
  var hosts = 0
  var tes = 0
  var cls_n = 0
  var first_cl = ""
  var cl_conflict = false
  var host = ""
  var k = 0
  while k < nraw {
    let key = keys[k]
    if key == "Host" {
      hosts += 1
      host = vals[k]
    } else if key == "Transfer-Encoding" {
      tes += 1
    } else if key == "Content-Length" {
      let v = trim_ws(vals[k])
      if cls_n == 0 {
        first_cl = v
      } else if v != first_cl {
        cl_conflict = true
      }
      cls_n += 1
    }
    k += 1
  }
  if hosts > 1 {
    return fail(BAD) // too many Host headers
  }
  // readTransfer: Transfer-Encoding (removed from the header); it takes
  // HTTP/0.0 for HTTP/1.1
  var chunked = false
  let t11 = (major == 0 && minor == 0) || major > 1 || (major == 1 && minor >= 1)
  if tes > 0 && t11 {
    if tes != 1 {
      return fail(BAD_TE)
    }
    k = 0
    while k < nraw {
      if keys[k] == "Transfer-Encoding" && !equal_fold(vals[k], "chunked") {
        return fail(BAD_TE)
      }
      k += 1
    }
    chunked = true
  }
  // Content-Length (several must agree)
  if cl_conflict {
    return fail(BAD)
  }
  var clen = 0
  if cls_n > 0 {
    let cb = first_cl.bytes()
    if cb.len() == 0 {
      return fail(BAD) // invalid empty Content-Length
    }
    var v = 0
    var x = 0
    while x < cb.len() {
      let d = Int(cb[x]) - 48
      if d < 0 || d > 9 || v > (MAX_INT - d) / 10 {
        return fail(BAD) // bad Content-Length
      }
      v = v * 10 + d
      x += 1
    }
    clen = v
  }
  if chunked {
    clen = -1
  }
  // the merged header, without the fields Go removes
  var hn: List[Str] = []
  var hv: List[Str] = []
  var pragma = -1
  var have_cc = false
  k = 0
  while k < nraw {
    let key = keys[k]
    k += 1
    if key == "Host" || key == "Transfer-Encoding" {
      continue
    }
    if chunked && (key == "Content-Length" || key == "Trailer") {
      continue
    }
    var e = -1
    var y = 0
    while y < hn.len() {
      if hn[y] == key {
        e = y
        break
      }
      y += 1
    }
    if key == "Content-Length" && e >= 0 {
      continue // deduplicated; its value as written first
    }
    if e >= 0 {
      hv[e] = hv[e] + ", " + vals[k - 1]
    } else {
      hn.push(key)
      hv.push(vals[k - 1])
    }
    if key == "Pragma" && pragma < 0 {
      pragma = k - 1
    }
    if key == "Cache-Control" {
      have_cc = true
    }
  }
  // fixPragmaCacheControl: Pragma: no-cache without Cache-Control
  if pragma >= 0 && !have_cc && vals[pragma] == "no-cache" {
    hn.push("Cache-Control")
    hv.push("no-cache")
  }
  // req.Host: the URL's host, else the Host header
  let rhost = if url.host.is_empty() { host } else { url.host }
  // shouldClose (Connection tokens of every Connection field)
  var has_close = false
  var has_ka = false
  var cv = ""
  var have_cv = false
  var ev = ""
  var have_ev = false
  k = 0
  while k < nraw {
    if keys[k] == "Connection" {
      has_close = has_close || has_token(vals[k], "close")
      has_ka = has_ka || has_token(vals[k], "keep-alive")
      if !have_cv {
        cv = vals[k]
        have_cv = true
      }
    } else if keys[k] == "Expect" && !have_ev {
      ev = vals[k]
      have_ev = true
    }
    k += 1
  }
  var close = has_close
  if major < 1 {
    close = true
  } else if major == 1 && minor == 0 {
    close = has_close || !has_ka
  }
  // conn.readRequest's checks
  if !(major == 1 || (major == 2 && minor == 0 && method == "PRI" && target == "*")) {
    return fail_status(505, "unsupported protocol version", used)
  }
  let h2up = method == "PRI" && nraw == 0 && url.path == "*" && major == 2 && minor == 0
  let is11 = major > 1 || (major == 1 && minor >= 1)
  if is11 && hosts == 0 && !h2up && !connect {
    return fail_status(400, "missing required Host header", used)
  }
  if hosts == 1 {
    let hb = host.bytes()
    var x = 0
    while x < hb.len() {
      if (cls(Int(hb[x])) & HOSTHDR) == 0 {
        return fail_status(400, "malformed Host header", used)
      }
      x += 1
    }
  }
  k = 0
  while k < nraw {
    let kb = keys[k].bytes()
    var x = 0
    while x < kb.len() {
      if (cls(Int(kb[x])) & TCHAR) == 0 {
        return fail_status(400, "invalid header name", used)
      }
      x += 1
    }
    k += 1
  }
  // Connection close / keep-alive wishes (Header.get: the first value)
  let wants10ka = major == 1 && minor == 0 && server_token(cv, "keep-alive")
  var wantsclose = close || server_token(cv, "close")
  if h2up {
    clen = 0 // its Body is NoBody (std/rt reads none)
    close = true
    wantsclose = true
  }
  var expect100 = false
  var expect_other = false
  if have_ev && server_token(ev, "100-continue") {
    expect100 = is11 && clen != 0
  } else if have_ev && !ev.is_empty() {
    expect_other = true
  }
  var headers: List[Str] = []
  var y = 0
  while y < hn.len() {
    headers.push(hn[y])
    headers.push(hv[y])
    y += 1
  }
  let head = Head{method: method, target: target, major: major, minor: minor, headers: headers, host: rhost, url: url, query: query, clen: clen, chunked: chunked, close: close, wants10ka: wants10ka, wantsclose: wantsclose, expect100: expect100, expect_other: expect_other, h2up: h2up}
  Parse{res: OK, used: used, head: head, status: 0, reason: ""}
}

// ---------------------------------------------------------------------------
// Chunked bodies (xo_http.c's hb_chunked)

// The results of a chunked body's decoding (HB_*).
const HB_NEED: Int = 0
const HB_OK: Int = 1
const HB_ERR: Int = 2

/// A chunked body decoded: res, its length in the input (HB_OK), and the
/// data (what was decoded before an error or the end of the input too).
pub struct Chunked {
  res: Int
  used: Int
  body: Str
}

/// Decodes the chunked body at the start of s (eof: no more will come),
/// as net/http's chunkedReader and the trailer reading of
/// body.readTrailer.
pub fn chunked(s: Str, eof: Bool) -> Chunked {
  let b = s.bytes()
  let n = b.len()
  var out = ""
  var i = 0
  var excess = 0
  while true {
    let nl = if i < n { scan.find_byte(s.bytes(), i, s.len(), 10) } else { -1 }
    if nl < 0 {
      if n - i >= 4096 {
        return Chunked{res: HB_ERR, used: 0, body: out} // header line too long
      }
      return Chunked{res: if eof { HB_ERR } else { HB_NEED }, used: 0, body: out}
    }
    let e = nl
    // CRLF required, no other CR
    let cr = bfind(b, 13, i, e + 1)
    if cr < 0 || cr != e - 1 {
      return Chunked{res: HB_ERR, used: 0, body: out}
    }
    let ll = e - 1 - i
    if ll >= 4096 {
      return Chunked{res: HB_ERR, used: 0, body: out}
    }
    excess += ll + 2
    var z = i + ll
    while z > i && is_sp(Int(b[z - 1])) {
      z -= 1
    }
    let semi = bfind(b, 59, i, z)
    if semi >= 0 {
      z = semi
    }
    if z == i {
      return Chunked{res: HB_ERR, used: 0, body: out} // empty hex number
    }
    // the size as a UInt64 (a negative Int is at least 2^63)
    var size = 0
    var k = i
    while k < z {
      let c = Int(b[k])
      if (cls(c) & HEX) == 0 || k - i == 16 {
        return Chunked{res: HB_ERR, used: 0, body: out}
      }
      size = rt.int_wrap(3, size, 4) | unhex(c)
      k += 1
    }
    let capped = if size < 0 || size > MAX_INT / 4 { MAX_INT / 4 } else { size }
    excess -= 16 + 2 * capped
    if excess < 0 {
      excess = 0
    }
    if excess > 16 * 1024 {
      return Chunked{res: HB_ERR, used: 0, body: out} // too much non-data
    }
    i = e + 1
    if size == 0 {
      // the trailer: CRLF, or a MIME header up to an empty line
      if n - i < 2 {
        return Chunked{res: if eof { HB_ERR } else { HB_NEED }, used: 0, body: out}
      }
      if b[i] == 13 && b[i + 1] == 10 {
        return Chunked{res: HB_OK, used: i + 2, body: out}
      }
      // up to a double CRLF within 4096 bytes
      let lim = if n - i < 4096 { n - i } else { 4096 }
      var end = -1
      var q = 3
      while q < lim {
        if b[i + q - 3] == 13 && b[i + q - 2] == 10 && b[i + q - 1] == 13 && b[i + q] == 10 {
          end = i + q + 1
          break
        }
        q += 1
      }
      if end < 0 {
        if n - i >= 4096 || eof {
          return Chunked{res: HB_ERR, used: 0, body: out}
        }
        return Chunked{res: HB_NEED, used: 0, body: out}
      }
      // the trailer is a MIME header up to its first empty line (a bare
      // LF ends it too)
      // (up to the empty line found: the rest does not change the parse)
      let t = parse_head("GET / HTTP/1.0\r\n" + rt.str_slice(s, i, end), eof)
      if t.res == NEED {
        return Chunked{res: HB_NEED, used: 0, body: out}
      }
      if t.res != OK && t.res != STATUS {
        return Chunked{res: HB_ERR, used: 0, body: out}
      }
      return Chunked{res: HB_OK, used: i + t.used - 16, body: out}
    }
    if size < 0 || size > n - i || (n - i) - size < 2 {
      // copy what is there: an error later still delivers it
      let have = if size >= 0 && size < n - i { size } else { n - i }
      out = rt.rs_append_bytes(out, b, i, i + have, 0)
      return Chunked{res: if eof { HB_ERR } else { HB_NEED }, used: 0, body: out}
    }
    out = rt.rs_append_bytes(out, b, i, i + size, 0)
    i += size
    if b[i] != 13 || b[i + 1] != 10 {
      return Chunked{res: HB_ERR, used: 0, body: out} // malformed chunked encoding
    }
    i += 2
  }
  Chunked{res: HB_ERR, used: 0, body: out}
}

// ---------------------------------------------------------------------------
// The connection's reader

/// The HTTP/1.1 requests of a server connection.
pub struct Reader {
  h: rthttp.HConn
  /// The head of the request being read.
  head: Head
}

/// The reader of the connection, whose request heads and chunked bodies
/// parse in Xo.
pub fn reader(h: rthttp.HConn) -> Reader {
  Reader{h: h, head: no_head()}
}

/// The request std/rt's serve hands to Xo code (Request's parts).
pub struct Req {
  pub method: Str
  /// The URL's path (unescaped; Request.path).
  pub path: Str
  pub scheme: Str
  /// Request.url.host: the Host without a port, or all of it when it has
  /// none.
  pub host: Str
  /// The port of an absolute request target, or -1.
  pub port: Int
  /// [name, value, ...]
  pub headers: List[Str]
  /// [key, value, ...]
  pub query: List[Str]
}

/// The next request (its body read; rthttp.hc_body), or None when the
/// connection is done.
pub fn (var r: Reader) read() -> Req? {
  while true {
    let k = rthttp.hc_read(r.h)
    if k == 3 {
      // up to the end of the head (the rest does not change the parse)
      let p = parse_head(rthttp.hc_input(r.h, 0), rthttp.hc_eof(r.h))
      let hd = p.head
      var flags = hd.major | (hd.minor << 4)
      if hd.chunked {
        flags = flags | 0x100
      }
      if hd.close {
        flags = flags | 0x200
      }
      if hd.wants10ka {
        flags = flags | 0x400
      }
      if hd.wantsclose {
        flags = flags | 0x800
      }
      if hd.expect100 {
        flags = flags | 0x1000
      }
      if hd.expect_other {
        flags = flags | 0x2000
      }
      if hd.h2up {
        flags = flags | 0x4000
      }
      if hd.target == "*" {
        flags = flags | 0x8000
      }
      rthttp.hc_head(r.h, p.res, p.used, hd.method, flags, hd.clen, p.status, p.reason)
      r.head = hd
    } else if k == 4 {
      // the first 4 KiB, then (when they end before the body does) all
      let s = rthttp.hc_input(r.h, 1)
      let cut = s.len() < rthttp.hc_avail(r.h)
      var c = chunked(s, rthttp.hc_eof(r.h) && !cut)
      // (an error too: a line cut by the window's end looks too long)
      if c.res != HB_OK && cut {
        c = chunked(rthttp.hc_input(r.h, 2), rthttp.hc_eof(r.h))
      }
      rthttp.hc_chunked(r.h, c.res, c.used, c.body)
    } else if k == 1 {
      return Some(req_of(r.head))
    } else {
      return None
    }
  }
  None
}

/// The parts of the Request of a head (xo_http.c's hc_* accessors).
fn req_of(h: Head) -> Req {
  // Request.url.host: net.SplitHostPort of req.Host, else all of it
  let hb = h.host.bytes()
  let n = hb.len()
  var host = h.host
  let colon = rfind(hb, 58, n)
  if colon >= 0 {
    var lo = 0
    var hi = colon
    var ok = true
    var j = 0
    var k = 0
    if n > 0 && hb[0] == 91 {
      let end = scan.find(h.host, "]", 0)
      if end < 0 || end + 1 != colon {
        ok = false
      } else {
        lo = 1
        hi = end
        j = 1
        k = end + 1
      }
    } else if find(h.host, 58, 0, colon) >= 0 {
      ok = false
    }
    if ok && (scan.find(h.host, "[", j) >= 0 || scan.find(h.host, "]", k) >= 0) {
      ok = false
    }
    if ok {
      host = rt.str_slice(h.host, lo, hi)
    }
  }
  // the port of the URL's host
  var port = -1
  let ub = h.url.host.bytes()
  let uc = rfind(ub, 58, ub.len())
  if uc >= 0 && uc + 1 < ub.len() && valid_port(ub, uc, ub.len()) {
    var v = 0
    var x = uc + 1
    var fits = true
    while x < ub.len() {
      let d = Int(ub[x]) - 48
      if v > (MAX_INT - d) / 10 {
        fits = false
        break
      }
      v = v * 10 + d
      x += 1
    }
    if fits {
      port = v
    }
  }
  Req{method: h.method, path: h.url.path, scheme: h.url.scheme, host: host, port: port, headers: h.headers, query: h.query}
}

// ---------------------------------------------------------------------------
// HTTP/2 request targets (xo_h2.c's h2_request)

/// The parse of the first :path field of an HTTP/2 header block fragment
/// (data and lens as hpack.Fields'): [] when it has none, else [the
/// path, "1" when it parses (url.ParseRequestURI) or "", the URL's
/// scheme, host, path, and raw query, then the query's keys and first
/// values, the keys sorted] (rthttp.h2_fields, for h2_request).
pub fn h2_target(data: Str, lens: List[Int]) -> List[Str] {
  let b = data.bytes()
  let n = b.len()
  var off = 0
  for l in lens {
    let nn = l & 0xffffffff
    let vn = l >> 32
    if off + nn + vn > n {
      break
    }
    if nn == 5 && b[off] == 58 && b[off + 1] == 112 && b[off + 2] == 97 && b[off + 3] == 116 && b[off + 4] == 104 {
      let v = rt.str_slice(data, off + 5, off + 5 + vn)
      let u = url_parse(v, true)
      if !u.ok {
        return [v, "", "", "", "", ""]
      }
      var out = [v, "1", u.scheme, u.host, u.path, u.rawquery]
      if !u.rawquery.is_empty() {
        for x in query_parts(u.rawquery) {
          out.push(x)
        }
      }
      return out
    }
    off += nn + vn
  }
  []
}

// ---------------------------------------------------------------------------
// The HTTP/2 server's header blocks (xo_h2.c, decision 0193 step 6)
//
// The connection's frames are read and written by C under the
// connection's lock, which stream tasks share. So the HTTP/2
// connection's fiber (std/native/http.xo, serve_conn) calls the C
// (rthttp.h2_next) until it stops at a header block: 2, a block fragment
// to decode (rthttp.h2_block gives it, rthttp.h2_fields takes the
// fields, with the parse of their :path by h2_target); 3, response heads
// to encode in the order they go out (rthttp.h2_enc_job,
// rthttp.h2_encoded; the C holds the connection's lock until they are
// in, so the order and the table stay the peer's). A 100 Continue is
// encoded the same way when rthttp.h2_fields asks for one.

/// The HPACK state of an HTTP/2 server connection.
pub struct H2Conn {
  h: rthttp.HConn
  dec: hpack.Dec
  enc: hpack.Enc
}

/// The HPACK state of the connection, whose header blocks pass through
/// Xo.
pub fn h2_conn(h: rthttp.HConn) -> H2Conn {
  H2Conn{h: h, dec: hpack.decoder(hpack.TABLE), enc: hpack.encoder()}
}

/// The largest header list (and string) the server takes (H2_MAX_HLIST:
/// DefaultMaxHeaderBytes plus 10 times 32).
const H2_MAX_HLIST: Int = 1048896

/// Runs the HTTP/2 connection until a request is ready for a handler
/// (true; rthttp.h2_take hands it out) or the connection is done.
pub fn (var c: H2Conn) next() -> Bool {
  while true {
    let r = rthttp.h2_next(c.h)
    if r == 2 {
      let f = c.dec.decode_part(rthttp.h2_block(c.h), rthttp.h2_block_first(c.h), H2_MAX_HLIST)
      if rthttp.h2_fields(c.h, f.ok, f.used, f.data, f.lens, f.first, h2_target(f.data, f.lens)) {
        // a 100 Continue goes out after the request's HEADERS
        rthttp.h2_encoded(c.h, c.enc.encode_job(rthttp.h2_enc_job(c.h)))
      }
    } else if r == 3 {
      rthttp.h2_encoded(c.h, c.enc.encode_job(rthttp.h2_enc_job(c.h)))
    } else {
      return r == 1
    }
  }
  false
}

// ---------------------------------------------------------------------------
// The HTTP/2 client (xo_h2.c's hp_encode and hp_decode until audit item
// B11, its exchange until B29, 2026-10-14)
//
// rthttp.cl_start sets an HTTP/2 exchange up (a pooled connection, or a
// new one whose ALPN chose h2, its preface and SETTINGS queued) and
// returns before the request: Xo makes the exchange of http2
// Transport.RoundTrip (h2_exchange): the request's HEADERS (its fields
// as httpcommon.EncodeHeaders lists them, the connection's encoder) and
// DATA within the server's windows, then the server's frames (SETTINGS,
// PING, WINDOW_UPDATE, GOAWAY, RST_STREAM, HEADERS and CONTINUATION,
// DATA) until the response ends, with Go's error texts. The C keeps the
// socket and TLS (rthttp.cl_h2_write, cl_h2_read), the pool of
// connections, and the end (rthttp.cl_h2_end: the retry on a new
// connection, the failure's text). The connection's state between
// requests (HPACK, the windows, the server's settings, the next stream)
// is an H2State the C keeps with the connection.

/// The state of a client HTTP/2 connection between requests.
struct H2State {
  dec: hpack.Dec
  enc: hpack.Enc
  // the server's SETTINGS_HEADER_TABLE_SIZE values the encoder has not
  // applied (4 bytes little endian each)
  sizes: Str
  peer_frame: Int
  // the server's initial stream window and its connection window
  peer_win: Int
  win: Int
  // our connection window (http2inflow)
  in_avail: Int
  in_unsent: Int
  next_id: Int
}

/// A new connection's state (h2cc_new's settings: the server's defaults,
/// our 1 GiB connection window).
fn h2_state() -> H2State {
  H2State{dec: hpack.decoder(hpack.TABLE), enc: hpack.encoder(), sizes: "", peer_frame: 16384, peer_win: 65535, win: 65535, in_avail: 1073741824, in_unsent: 0, next_id: 1}
}

/// The largest response header block (and string) the client decodes:
/// the 10 MiB of its SETTINGS_MAX_HEADER_LIST_SIZE.
const H2_MAX_RESP: Int = 10485760

/// checkConnHeaders: why HTTP/2 refuses the request's header (names
/// canonical, each once), "" when it does not.
fn h2_check(names: List[Str], values: List[Str]) -> Str {
  var i = 0
  while i < names.len() && i < values.len() {
    let k = names[i]
    let v = values[i]
    let bad = if k == "Upgrade" || k == "Transfer-Encoding" {
      !v.is_empty() && v != "chunked"
    } else if k == "Connection" {
      !v.is_empty() && v != "close" && v != "keep-alive"
    } else {
      false
    }
    if bad {
      return "http2: invalid " + k + " request header: [" + go_quote(v) + "]"
    }
    i += 1
  }
  ""
}

/// The value of the header's field k, and whether it has one.
fn h2_field(names: List[Str], values: List[Str], k: Str) -> (Str, Bool) {
  var i = 0
  while i < names.len() && i < values.len() {
    if names[i] == k {
      return (values[i], true)
    }
    i += 1
  }
  ("", false)
}

/// The ASCII lower case of s.
fn ascii_lower(s: Str) -> Str {
  let b = s.bytes()
  var i = 0
  while i < b.len() {
    if Int(b[i]) >= 65 && Int(b[i]) <= 90 {
      break
    }
    i += 1
  }
  if i == b.len() {
    return s
  }
  var out = rt.str_slice(s, 0, i)
  while i < b.len() {
    out = rt.rs_push_word(out, lower(Int(b[i])), 1)
    i += 1
  }
  out
}

/// The header block of the request (httpcommon.EncodeHeaders): the
/// pseudo fields, the header's fields in lower case but the hop by hop
/// ones, a cookie field per pair (RFC 9113 8.2.3), content-length,
/// accept-encoding, and user-agent.
fn (var st: H2State) block(method: Str, target: Str, host: Str, names: List[Str], values: List[Str], bn: Int) -> Str {
  var blk = st.enc.field("", ":authority", host)
  blk = st.enc.field(blk, ":method", method)
  blk = st.enc.field(blk, ":path", target)
  blk = st.enc.field(blk, ":scheme", "https")
  var did_ua = false
  var i = 0
  while i < names.len() && i < values.len() {
    let k = names[i]
    let v = values[i]
    i += 1
    if k == "Host" || k == "Content-Length" || k == "Connection" || k == "Proxy-Connection" || k == "Transfer-Encoding" || k == "Upgrade" || k == "Keep-Alive" {
      continue
    }
    if k == "User-Agent" {
      did_ua = true
      if !v.is_empty() {
        blk = st.enc.field(blk, "user-agent", v)
      }
    } else if k == "Cookie" {
      let b = v.bytes()
      let n = b.len()
      var s = 0
      while true {
        let semi = bfind(b, 59, s, n)
        if semi < 0 {
          break
        }
        blk = st.enc.field(blk, "cookie", rt.str_slice(v, s, semi))
        s = semi + 1
        while s < n && b[s] == 32 {
          s += 1
        }
      }
      if s < n {
        blk = st.enc.field(blk, "cookie", rt.str_slice(v, s, n))
      }
    } else {
      blk = st.enc.field(blk, ascii_lower(k), v)
    }
  }
  if bn > 0 || method == "POST" || method == "PUT" || method == "PATCH" {
    blk = st.enc.field(blk, "content-length", "${bn}")
  }
  let (_, has_ae) = h2_field(names, values, "Accept-Encoding")
  let (_, has_range) = h2_field(names, values, "Range")
  if !has_ae && !has_range && method != "HEAD" {
    blk = st.enc.field(blk, "accept-encoding", "gzip")
  }
  if !did_ua {
    blk = st.enc.field(blk, "user-agent", "Go-http-client/2.0")
  }
  blk
}

/// cl_h2_read's result for a frame over our 16 KiB SETTINGS_MAX_FRAME_SIZE.
const CC_TOO_LARGE: Int = 104

// The frame types and flags the client reads and writes (RFC 9113 6).
const H2T_DATA: Int = 0
const H2T_HEADERS: Int = 1
const H2T_RST: Int = 3
const H2T_SETTINGS: Int = 4
const H2T_PING: Int = 6
const H2T_GOAWAY: Int = 7
const H2T_WINUP: Int = 8
const H2T_CONT: Int = 9
const H2F_END_STREAM: Int = 1
const H2F_ACK: Int = 1
const H2F_END_HEADERS: Int = 4
const H2F_PADDED: Int = 8
const H2F_PRIORITY: Int = 0x20

// cl_h2_end's flags.
const XF_BROKEN: Int = 1
const XF_REFUSED: Int = 2
const XF_SEEN: Int = 4
const XF_HEADERS: Int = 8
const XF_UNSENT: Int = 16
const XF_GOAWAY: Int = 32
/// the connection's stream ids ran out: not pooled
const XF_SPENT: Int = 64

/// http2ErrCode.String.
fn h2_err_name(c: Int) -> Str {
  let names = ["NO_ERROR", "PROTOCOL_ERROR", "INTERNAL_ERROR", "FLOW_CONTROL_ERROR", "SETTINGS_TIMEOUT", "STREAM_CLOSED", "FRAME_SIZE_ERROR", "REFUSED_STREAM", "CANCEL", "COMPRESSION_ERROR", "CONNECT_ERROR", "ENHANCE_YOUR_CALM", "INADEQUATE_SECURITY", "HTTP_1_1_REQUIRED"]
  if c >= 0 && c < names.len() {
    return names[c]
  }
  "unknown error code 0x" + hex_text(c)
}

/// The lower case hexadecimal text of v (at least one digit).
fn hex_text(v: Int) -> Str {
  let hex = b"0123456789abcdef"
  var out = ""
  var x = v
  while true {
    out = rt.rs_push_byte("", Int(hex[x & 15])) + out
    x = x >> 4
    if x == 0 {
      break
    }
  }
  out
}

fn be32_at(b: Bytes, i: Int) -> Int { (Int(b[i]) << 24) | (Int(b[i + 1]) << 16) | (Int(b[i + 2]) << 8) | Int(b[i + 3]) }

fn push_be32(s: Str, v: Int) -> Str {
  rt.rs_push_word(s, ((v >> 24) & 255) | (((v >> 16) & 255) << 8) | (((v >> 8) & 255) << 16) | ((v & 255) << 24), 4)
}

/// s with the 9 byte header of a frame.
fn push_frame(s: Str, len: Int, ty: Int, flags: Int, sid: Int) -> Str {
  let a = rt.rs_push_word(s, ((len >> 16) & 255) | (((len >> 8) & 255) << 8) | ((len & 255) << 16), 3)
  push_be32(rt.rs_push_word(a, ty | (flags << 8), 2), sid & 0x7FFFFFFF)
}

/// http2inflow.add: n more bytes received in a window of avail with
/// unsent owed; the new avail and unsent and the WINDOW_UPDATE to send (0:
/// none yet).
fn inflow_add(avail: Int, unsent: Int, n: Int) -> (Int, Int, Int) {
  let u = unsent + n
  if u < 4096 && u < avail {
    return (avail, u, 0)
  }
  (avail + u, 0, u)
}

/// One HTTP/2 exchange (xo_h2.c's h2x and h2rq until audit item B29).
struct H2X {
  st: H2State
  method: Str
  body: Str
  off: Int
  close: Bool
  /// the frames to send next
  out: Str
  res: Int
  why: Str
  /// the connection is not to be used again, the server sent GOAWAY
  broken: Bool
  goaway: Bool
  goaway_last: Int
  goaway_code: Int
  goaway_debug: Str
  // the request's stream
  id: Int
  swin: Int
  sin_avail: Int
  sin_unsent: Int
  headers: Bool
  ended: Bool
  seen: Bool
  refused: Bool
  hb: Str
  hb_on: Bool
  hb_flags: Int
  hb_sid: Int
  dec: Bool
  // the response
  status: Int
}

/// Sends x.out; false when the write failed (x.res).
fn (var x: H2X) flush(r: rthttp.CResp) -> Bool {
  if x.out.is_empty() {
    return true
  }
  x.res = rthttp.cl_h2_write(r, x.out)
  x.out = ""
  x.res == CC_OK
}

/// Fails the request with why (with a body read failure's mark once the
/// response header came, as net/http reports it from the body's Read).
fn (var x: H2X) fail(had: Bool, why: Str) {
  x.why = (if had { "\u{1}" } else { "" }) + why
  x.res = CC_ERR
}

/// The server's frame f (header and payload; h2cc_process): false when
/// the request failed (its text in why, the caller marks it).
fn (var x: H2X) frame(r: rthttp.CResp, f: Str) -> (Bool, Str) {
  let b = f.bytes()
  let len = (Int(b[0]) << 16) | (Int(b[1]) << 8) | Int(b[2])
  let ty = Int(b[3])
  let flags = Int(b[4])
  let sid = be32_at(b, 5) & 0x7FFFFFFF
  if sid == x.id && sid != 0 {
    x.seen = true
  }
  if x.hb_on && (ty != H2T_CONT || sid != x.hb_sid) {
    x.broken = true
    return (false, "connection error: PROTOCOL_ERROR")
  }
  if ty == H2T_SETTINGS {
    if (flags & H2F_ACK) == 0 {
      var i = 0
      while i + 6 <= len {
        let id = (Int(b[9 + i]) << 8) | Int(b[10 + i])
        let v = be32_at(b, 11 + i)
        if id == 4 && v <= 0x7FFFFFFF {
          x.swin += v - x.st.peer_win
          x.st.peer_win = v
        } else if id == 5 && v >= 16384 && v < 16777216 {
          x.st.peer_frame = v
        } else if id == 1 {
          // for the encoder, before the next request's block
          x.st.sizes = rt.rs_push_word(x.st.sizes, v, 4)
        }
        i += 6
      }
      x.out = push_frame(x.out, 0, H2T_SETTINGS, H2F_ACK, 0)
    }
  } else if ty == H2T_PING {
    if (flags & H2F_ACK) == 0 && len == 8 {
      x.out = push_frame(x.out, 8, H2T_PING, H2F_ACK, 0) + rt.str_slice(f, 9, 17)
    }
  } else if ty == H2T_WINUP {
    if len == 4 {
      let inc = be32_at(b, 9) & 0x7FFFFFFF
      if sid == 0 {
        x.st.win += inc
      } else if sid == x.id {
        x.swin += inc
      }
    }
  } else if ty == H2T_GOAWAY {
    if len >= 8 {
      x.goaway = true
      x.goaway_last = be32_at(b, 9) & 0x7FFFFFFF
      x.goaway_code = be32_at(b, 13)
      // the debug data as a C string (to its first zero byte)
      var e = 17
      while e < 9 + len && b[e] != 0 {
        e += 1
      }
      x.goaway_debug = rt.str_slice(f, 17, e)
      if x.goaway_last < x.id && !x.seen {
        // the server will not answer this stream: another connection will
        x.refused = true
        return (false, "http2: server sent GOAWAY")
      }
    }
  } else if ty == H2T_RST {
    if sid == x.id && len == 4 {
      let code = be32_at(b, 9)
      if code == 7 && !x.headers {
        x.refused = true
      }
      if code == 1 {
        x.broken = true
      }
      return (false, "stream error: stream ID ${x.id}; ${h2_err_name(code)}; received from peer")
    }
  } else if ty == H2T_HEADERS || ty == H2T_CONT {
    var d = 9
    var dn = len
    if ty == H2T_HEADERS {
      if (flags & H2F_PADDED) != 0 {
        if dn < 1 || Int(b[9]) > dn - 1 {
          x.broken = true
          return (false, "connection error: PROTOCOL_ERROR")
        }
        dn -= 1 + Int(b[9])
        d += 1
      }
      if (flags & H2F_PRIORITY) != 0 {
        if dn < 5 {
          x.broken = true
          return (false, "connection error: PROTOCOL_ERROR")
        }
        d += 5
        dn -= 5
      }
      x.hb = ""
      x.hb_flags = flags
      x.hb_sid = sid
    }
    x.hb = x.hb + rt.str_slice(f, d, d + dn)
    if x.hb.len() > H2_MAX_RESP {
      x.broken = true
      return (false, "http2: response header list larger than advertised limit")
    }
    if (flags & H2F_END_HEADERS) == 0 {
      x.hb_on = true
    } else {
      x.hb_on = false
      x.dec = true
    }
  } else if ty == H2T_DATA {
    var d = 9
    var dn = len
    if (flags & H2F_PADDED) != 0 {
      if dn < 1 || Int(b[9]) > dn - 1 {
        x.broken = true
        return (false, "connection error: PROTOCOL_ERROR")
      }
      dn -= 1 + Int(b[9])
      d += 1
    }
    if len > 0 {
      let (a, un, u) = inflow_add(x.st.in_avail - len, x.st.in_unsent, len)
      x.st.in_avail = a
      x.st.in_unsent = un
      if u > 0 {
        x.out = push_be32(push_frame(x.out, 4, H2T_WINUP, 0, 0), u)
      }
    }
    if sid != x.id {
      return (true, "") // an old stream's
    }
    if !x.headers {
      x.broken = true
      return (false, "protocol error: received DATA before a HEADERS frame")
    }
    if x.method != "HEAD" && dn > 0 {
      rthttp.cl_h2_data(r, rt.str_slice(f, d, d + dn))
    }
    if len > 0 && (flags & H2F_END_STREAM) == 0 {
      let (a, un, u) = inflow_add(x.sin_avail - len, x.sin_unsent, len)
      x.sin_avail = a
      x.sin_unsent = un
      if u > 0 {
        x.out = push_be32(push_frame(x.out, 4, H2T_WINUP, 0, x.id), u)
      }
    }
    if (flags & H2F_END_STREAM) != 0 {
      x.ended = true
    }
  }
  (true, "")
}

/// The response header block in x.hb, decoded (h2rq_headers): false
/// when it is malformed (why says how).
fn (var x: H2X) block_done(r: rthttp.CResp) -> (Bool, Str) {
  x.dec = false
  let f = x.st.dec.decode_part(x.hb, true, H2_MAX_RESP)
  let end = (x.hb_flags & H2F_END_STREAM) != 0
  if f.ok != 1 || f.used != x.hb.len() {
    x.broken = true
    return (false, "connection error: COMPRESSION_ERROR")
  }
  if x.hb_sid != x.id {
    return (true, "") // another stream's (an old one's trailers): only the table counts
  }
  if x.headers {
    // trailers: dropped (std/rt does not read them)
    if end {
      x.ended = true
    }
    return (true, "")
  }
  // the fields: names and values one after the other in f.data
  var names: List[Str] = []
  var values: List[Str] = []
  var off = 0
  for l in f.lens {
    let nn = l & 0xFFFFFFFF
    let vn = l >> 32
    if off + nn + vn > f.data.len() {
      break
    }
    names.push(rt.str_slice(f.data, off, off + nn))
    values.push(rt.str_slice(f.data, off + nn, off + nn + vn))
    off += nn + vn
  }
  var si = -1
  var i = 0
  while i < names.len() {
    if names[i] == ":status" {
      si = i
      break
    }
    i += 1
  }
  if si < 0 {
    return (false, "malformed response from server: missing status pseudo header")
  }
  let sb = values[si].bytes()
  if sb.len() == 0 || sb.len() > 9 {
    return (false, "malformed response from server: malformed non-numeric status pseudo header")
  }
  var code = 0
  for c in sb {
    if Int(c) < 48 || Int(c) > 57 {
      return (false, "malformed response from server: malformed non-numeric status pseudo header")
    }
    code = code * 10 + Int(c) - 48
  }
  if code >= 100 && code <= 199 && !end {
    return (true, "") // informational: the response follows
  }
  x.headers = true
  x.status = code
  // the header: canonical names, each once, values joined
  var hk: List[Str] = []
  var hv: List[Str] = []
  i = 0
  while i < names.len() {
    let k = names[i]
    if !k.is_empty() && k.bytes()[0] == 58 {
      i += 1
      continue
    }
    let ck = canonical_key(k)
    var j = 0
    while j < hk.len() && hk[j] != ck {
      j += 1
    }
    if j < hk.len() {
      hv[j] = hv[j] + (if ck == "Cookie" { "; " } else { ", " }) + values[i]
    } else {
      hk.push(ck)
      hv.push(values[i])
    }
    i += 1
  }
  rthttp.cl_h2_response(r, code, hk, hv)
  if end {
    x.ended = true
  }
  (true, "")
}

/// Makes the HTTP/2 request rthttp.cl_start set up on r (http2
/// Transport.RoundTrip on one stream), then hands the connection and its
/// state back to the C (rthttp.cl_h2_end). rthttp.cl_retry tells whether
/// the request goes again on a new connection.
fn h2_exchange(r: rthttp.CResp, method: Str, target: Str, host: Str, names: List[Str], values: List[Str], bn: Int) {
  var st = h2_state()
  let kept = rthttp.cl_h2_take(r)
  if let Some(a) = kept.get(0) {
    if let Some(s) = rt.any_get[H2State](a) {
      st = s
    }
  }
  let (cv, has_c) = h2_field(names, values, "Connection")
  var x = H2X{st: st, method: method, body: rthttp.cl_h2_body(r), off: 0, close: has_c && cv == "close", out: "", res: CC_OK, why: "", broken: false, goaway: false, goaway_last: 0, goaway_code: 0, goaway_debug: "", id: 0, swin: 0, sin_avail: 0, sin_unsent: 0, headers: false, ended: false, seen: false, refused: false, hb: "", hb_on: false, hb_flags: 0, hb_sid: 0, dec: false, status: 0}
  x.st.enc.set_sizes(x.st.sizes)
  x.st.sizes = ""
  let why = h2_check(names, values)
  if !why.is_empty() {
    x.why = why
    x.res = CC_ERR
  } else {
    if x.close {
      x.broken = true // not reused after this request
    }
    x.id = x.st.next_id
    x.st.next_id += 2
    x.swin = x.st.peer_win
    x.sin_avail = 4194304
    let blk = x.st.block(method, target, host, names, values, x.body.len())
    // HEADERS and CONTINUATION frames of at most the server's frame size
    var off = 0
    var first = true
    while first || off < blk.len() {
      let k = if blk.len() - off > x.st.peer_frame { x.st.peer_frame } else { blk.len() - off }
      var fl = 0
      if off + k == blk.len() {
        fl = fl | H2F_END_HEADERS
      }
      if first && x.body.is_empty() {
        fl = fl | H2F_END_STREAM
      }
      x.out = push_frame(x.out, k, if first { H2T_HEADERS } else { H2T_CONT }, fl, x.id) + rt.str_slice(blk, off, off + k)
      off += k
      first = false
    }
    let _ok = x.flush(r)
  }
  let bn2 = x.body.len()
  while x.res == CC_OK && !x.ended {
    // the body, as the windows allow
    while x.off < bn2 && !x.ended {
      var k = bn2 - x.off
      if k > x.st.peer_frame {
        k = x.st.peer_frame
      }
      if k > x.swin {
        k = x.swin
      }
      if k > x.st.win {
        k = x.st.win
      }
      if k <= 0 {
        break
      }
      x.out = push_frame(x.out, k, H2T_DATA, if x.off + k == bn2 { H2F_END_STREAM } else { 0 }, x.id) + rt.str_slice(x.body, x.off, x.off + k)
      x.off += k
      x.swin -= k
      x.st.win -= k
      if x.out.len() >= 65536 {
        break
      }
    }
    if !x.out.is_empty() {
      if !x.flush(r) {
        break
      }
      if x.off < bn2 && x.swin > 0 && x.st.win > 0 {
        continue
      }
    }
    let f = rthttp.cl_h2_read(r)
    if f.is_empty() {
      let c = rthttp.cl_h2_rres(r)
      if c == CC_EOF {
        x.broken = true
        if x.goaway {
          x.fail(x.headers, "http2: server sent GOAWAY and closed the connection; LastStreamID=${x.goaway_last}, ErrCode=${h2_err_name(x.goaway_code)}, debug=${go_quote(x.goaway_debug)}")
        } else {
          x.fail(x.headers, "unexpected EOF")
        }
      } else if c == CC_TOO_LARGE {
        x.broken = true
        x.fail(x.headers, "http2: frame too large")
      } else {
        x.res = c
      }
      break
    }
    let had = x.headers
    let (ok, m) = x.frame(r, f)
    if !ok {
      x.fail(had, m)
      break
    }
    if x.dec {
      let had2 = x.headers
      let (ok2, m2) = x.block_done(r)
      if !ok2 {
        x.fail(had2, m2)
      }
      continue
    }
    let _ok = x.flush(r)
  }
  var fl = 0
  if x.broken {
    fl = fl | XF_BROKEN
  }
  if x.st.next_id > 0x7FFFFFF0 {
    fl = fl | XF_SPENT
  }
  if x.refused {
    fl = fl | XF_REFUSED
  }
  if x.seen {
    fl = fl | XF_SEEN
  }
  if x.headers {
    fl = fl | XF_HEADERS
  }
  if x.off < bn2 {
    fl = fl | XF_UNSENT
  }
  if x.goaway {
    fl = fl | XF_GOAWAY
  }
  rthttp.cl_h2_end(r, rt.any_of(x.st), x.res, x.why, fl)
}

// ---------------------------------------------------------------------------
// The client (xo_http.c's xo_cl_do and cl_read_response until audit item
// B10, 2026-10-14): the URL and the redirects of net/http's Client, and
// the reading of an HTTP/1.1 response (ReadResponse, readTransfer). The
// C keeps the connection, TLS, HTTP/2's frames (its header blocks are
// h2_exchange's), and the writing of the request (rthttp.cl_start); C never calls compiled Xo (decision 0180), so an
// HTTP/1.1 exchange returns with the request sent and Xo reads the
// response through rthttp.cl_input, cl_fill, and cl_take, then ends it
// with rthttp.cl_end.

// The results of the C client's reads (xo_http.c's CC_*).
const CC_OK: Int = 0
const CC_EOF: Int = 1
const CC_ERR: Int = 4

/// url.escape(s, encodePath) (url.URL.EscapedPath without a RawPath).
pub fn escape_path(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && (cls(Int(b[i])) & PKEEP) != 0 {
    i += 1
  }
  if i == n {
    return s
  }
  let hex = b"0123456789ABCDEF"
  var out = rt.rs_append_bytes(rt.rs_with_cap(n + 8), b, 0, i, 0)
  while i < n {
    let c = Int(b[i])
    if (cls(c) & PKEEP) != 0 {
      out = rt.rs_push_byte(out, c)
    } else {
      out = rt.rs_push_word(out, 37 | (Int(hex[c >> 4]) << 8) | (Int(hex[c & 15]) << 16), 3)
    }
    i += 1
  }
  out
}

/// A response head: res (NEED, OK, BAD, TOO_LARGE), its length (OK), the
/// status code, the header ([name, value, ...]: canonical names, the
/// values of a name joined with ", ", Transfer-Encoding left out),
/// whether the body is chunked, the Content-Length (-1 when there is
/// none), and BAD's text.
pub struct RespHead {
  res: Int
  used: Int
  status: Int
  headers: List[Str]
  chunked: Bool
  clen: Int
  why: Str
}

fn resp_fail(res: Int, why: Str) -> RespHead { RespHead{res: res, used: 0, status: 0, headers: [], chunked: false, clen: -1, why: why} }

/// Reads the status line and the header at the start of s, up to the
/// first empty line (the native client's reading, lenient where net/http
/// is strict: a field line without a colon is skipped, the status line
/// needs only "HTTP/", a space at 8 or later, and a code of 3 digits).
pub fn parse_response(s: Str) -> RespHead {
  let b = s.bytes()
  let n = b.len()
  // the end of the head: \n\n or \n\r\n
  var end = -1
  var nl = scan.find(s, "\n", 0)
  while nl >= 0 && nl + 1 < n {
    if b[nl + 1] == 10 {
      end = nl + 2
      break
    }
    if b[nl + 1] == 13 && nl + 2 < n && b[nl + 2] == 10 {
      end = nl + 3
      break
    }
    nl = scan.find(s, "\n", nl + 1)
  }
  if end < 0 {
    return resp_fail(if n > MAX_HEAD { TOO_LARGE } else { NEED }, "")
  }
  // the status line: HTTP/x.y code reason
  let nl0 = scan.find(s, "\n", 0)
  var ll = nl0
  if ll > 0 && b[ll - 1] == 13 {
    ll -= 1
  }
  let sp = find(s, 32, 0, ll)
  if sp < 8 || !s.starts_with("HTTP/") {
    // at most 80 bytes of the line, up to a NUL (C's %.*s)
    var k = 0
    while k < ll && k < 80 && b[k] != 0 {
      k += 1
    }
    return resp_fail(BAD, "net/http: HTTP/1.x transport connection broken: malformed HTTP response " + rt.str_slice(s, 0, k))
  }
  var cs = sp + 1
  var code = 0
  var digits = 0
  while cs < ll && b[cs] >= 48 && b[cs] <= 57 && digits < 4 {
    code = code * 10 + Int(b[cs]) - 48
    cs += 1
    digits += 1
  }
  if digits != 3 {
    return resp_fail(BAD, "net/http: HTTP/1.x transport connection broken: malformed HTTP status code")
  }
  // the header fields
  var keys: List[Str] = []
  var vals: List[Str] = []
  var chunked = false
  var clen = -1
  var i = nl0 + 1
  while i < end {
    let e = scan.find_byte(s.bytes(), i, s.len(), 10)
    var le = e
    if e > i && b[e - 1] == 13 {
      le = e - 1
    }
    if le == i {
      break
    }
    let colon = find(s, 58, i, le)
    if colon >= 0 {
      let k = canonical_key(rt.str_slice(s, i, colon))
      let (a, z) = trim_sp(b, colon + 1, le)
      let v = rt.str_slice(s, a, z)
      if k == "Transfer-Encoding" {
        chunked = z - a == 7 && equal_fold(v, "chunked")
      } else {
        if k == "Content-Length" {
          if let Some(x) = Int.parse(v) {
            clen = x
          }
        }
        var at = -1
        var q = 0
        while q < keys.len() {
          if keys[q] == k {
            at = q
            break
          }
          q += 1
        }
        if at >= 0 {
          vals[at] = vals[at] + ", " + v
        } else {
          keys.push(k)
          vals.push(v)
        }
      }
    }
    i = e + 1
  }
  var headers: List[Str] = []
  var j = 0
  while j < keys.len() {
    headers.push(keys[j])
    headers.push(vals[j])
    j += 1
  }
  RespHead{res: OK, used: end, status: code, headers: headers, chunked: chunked, clen: clen, why: ""}
}

/// The end of one exchange: s (CC_*), the failure's text, and the
/// response.
struct Exchange {
  s: Int
  why: Str
  status: Int
  headers: List[Str]
  body: Bytes
}

fn ex_fail(s: Int, why: Str) -> Exchange { Exchange{s: s, why: why, status: 0, headers: [], body: b""} }

/// The index of the name k in a header ([name, value, ...]), or -1.
fn field_at(h: List[Str], k: Str) -> Int {
  var i = 0
  while i + 1 < h.len() {
    if h[i] == k {
      return i
    }
    i += 2
  }
  -1
}

/// Reads the response to a request of method on r (net/http's
/// ReadResponse and readTransfer): informational responses but 101 are
/// skipped; a chunked body is decoded and its Content-Length dropped; a
/// body ends at its Content-Length or, without one, at the end of the
/// stream; HEAD, 1xx, 204, and 304 responses have none.
fn read_response(r: rthttp.CResp, method: Str) -> Exchange {
  while true {
    var h = parse_response(rthttp.cl_input(r, 0))
    while h.res == NEED || h.res == TOO_LARGE {
      if h.res == TOO_LARGE {
        return ex_fail(CC_ERR, "net/http: server response headers exceeded 1048576 bytes; aborted")
      }
      let avail = rthttp.cl_avail(r)
      let f = rthttp.cl_fill(r)
      if f == CC_EOF {
        return ex_fail(CC_ERR, if avail == 0 { "EOF" } else { "unexpected EOF" })
      }
      if f != CC_OK {
        return ex_fail(f, "")
      }
      h = parse_response(rthttp.cl_input(r, 0))
    }
    if h.res != OK {
      return ex_fail(CC_ERR, h.why)
    }
    rthttp.cl_skip(r, h.used)
    let code = h.status
    if code >= 100 && code <= 199 && code != 101 {
      // an informational response: the real one follows
      continue
    }
    var headers = h.headers
    if h.chunked {
      let at = field_at(headers, "Content-Length")
      if at >= 0 {
        headers.remove_at(at)
        headers.remove_at(at)
      }
    }
    if method == "HEAD" || code == 204 || code == 304 || (code >= 100 && code <= 199) {
      return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: b""}
    }
    if h.chunked {
      while true {
        let eof = rthttp.cl_eof(r)
        let c = chunked(rthttp.cl_input(r, 2), eof)
        if c.res == HB_OK {
          rthttp.cl_skip(r, c.used)
          return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: c.body.bytes()}
        }
        if c.res == HB_ERR || eof {
          return ex_fail(CC_ERR, if eof { "unexpected EOF" } else { "malformed chunked encoding" })
        }
        let f = rthttp.cl_fill(r)
        if f != CC_OK && f != CC_EOF {
          return ex_fail(f, "")
        }
      }
    }
    while true {
      let have = rthttp.cl_avail(r)
      if h.clen >= 0 && have >= h.clen {
        return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: rthttp.cl_take(r, h.clen)}
      }
      if rthttp.cl_eof(r) {
        if h.clen >= 0 {
          return ex_fail(CC_ERR, "unexpected EOF")
        }
        return Exchange{s: CC_OK, why: "", status: code, headers: headers, body: rthttp.cl_take(r, have)}
      }
      let f = rthttp.cl_fill(r)
      if f != CC_OK && f != CC_EOF {
        return ex_fail(f, "")
      }
    }
  }
  ex_fail(CC_ERR, "")
}

/// What std/http's client.send gets: err (0, or the ClientErr tag: 1
/// InvalidUrl, 2 Connect, 3 Timeout, 4 Protocol, 5 Canceled) and its
/// text, or the response.
pub struct CResult {
  pub err: Int
  pub msg: Str
  pub status: Int
  /// [name, value, ...]
  pub headers: List[Str]
  pub body: Bytes
}

fn cfail(err: Int, msg: Str) -> CResult { CResult{err: err, msg: msg, status: 0, headers: [], body: b""} }

/// net/http's urlErrorOp: the method with its first byte kept and the
/// rest lowered, at most 30 bytes ("Get").
fn url_op(m: Str) -> Str {
  let b = m.bytes()
  let k = if b.len() < 30 { b.len() } else { 30 }
  if k == 0 {
    return ""
  }
  rt.rs_append_bytes(rt.rs_append_bytes(rt.rs_with_cap(k), b, 0, 1, 0), b, 1, k, 1)
}

/// A method is a token.
fn valid_method(m: Str) -> Bool {
  let b = m.bytes()
  if b.len() == 0 {
    return false
  }
  var i = 0
  while i < b.len() {
    if (cls(Int(b[i])) & TCHAR) == 0 {
      return false
    }
    i += 1
  }
  true
}

/// `client.send(req)` over the network: method to url (the text of the
/// request's Url) with the header of names and values, the body, the
/// client's timeout (ns, 0: none), the roots https verifies against, and
/// the attenuation lists of the client's Net (decision 0175), following
/// redirects as net/http's Client does (redirectBehavior,
/// defaultCheckRedirect, the headers a redirect drops, refererForURL).
pub fn client_do(m: Str, url: Str, names: List[Str], values: List[Str], body0: Bytes, timeout: Int, roots: rthttp.Roots, lists: Str) -> CResult {
  if !valid_method(m) {
    return cfail(1, "net/http: invalid method " + go_quote(m))
  }
  // the initial request's header (Header.Set: canonical names, the last
  // value of a name)
  var ik: List[Str] = []
  var iv: List[Str] = []
  var n = 0
  while n < names.len() && n < values.len() {
    let k = canonical_key(names[n])
    var at = -1
    var q = 0
    while q < ik.len() {
      if ik[q] == k {
        at = q
        break
      }
      q += 1
    }
    if at >= 0 {
      iv[at] = values[n]
    } else {
      ik.push(k)
      iv.push(values[n])
    }
    n += 1
  }
  let when = if timeout > 0 { rthttp.cl_deadline(timeout) } else { 0 }
  let op = url_op(m)
  var method = m
  var raw = url
  var body = body0
  var include_body = true
  var strip_sensitive = false
  var ihost = "" // the initial request's host
  var has_ihost = false
  var referer = "" // the URL of the previous request
  var has_referer = false
  var last_loc = "" // the Location being followed
  var redirects = 0
  while true {
    var cut = raw
    let hash = scan.find(raw, "#", 0)
    if hash >= 0 {
      cut = rt.str_slice(raw, 0, hash)
    }
    let u = url_parse(cut, false)
    if !u.ok {
      return cfail(if redirects == 0 { 1 } else { 4 }, "parse " + go_quote(raw) + ": " + u.err)
    }
    let (name, uport) = split_hostport(u.host)
    let https = u.scheme == "https"
    let port = if !uport.is_empty() { uport } else if https { "443" } else { "80" }
    if redirects > 0 && !lists.is_empty() {
      // a redirect must stay within the client's attenuated Net (Net.only,
      // decision 0175): std/rt's CheckRedirect, whose error names the
      // Location
      if !netpolicy.admits(lists, name, port) {
        let hn = if scan.find(name, ":", 0) >= 0 { "[" + name + "]" } else { name }
        return cfail(4, op + " " + go_quote(last_loc) + ": denied by Net.only: redirect to " + hn + ":" + port)
      }
    }
    let q = go_quote(raw)
    if u.scheme != "http" && !https {
      return cfail(4, op + " " + q + ": unsupported protocol scheme " + go_quote(u.scheme))
    }
    if u.host.is_empty() {
      return cfail(4, op + " " + q + ": http: no Host in request URL")
    }
    if !has_ihost {
      ihost = u.host
      has_ihost = true
    } else if ihost != u.host {
      // another host: Authorization and cookies are not sent there
      strip_sensitive = true
    }
    // this hop's header: the initial one, less what a redirect drops
    var hk: List[Str] = []
    var hv: List[Str] = []
    var j = 0
    while j < ik.len() {
      let k = ik[j]
      let sensitive = k == "Authorization" || k == "Www-Authenticate" || k == "Cookie" || k == "Cookie2" || k == "Proxy-Authorization" || k == "Proxy-Authenticate"
      let bodyh = k == "Content-Encoding" || k == "Content-Language" || k == "Content-Location" || k == "Content-Type"
      if !(redirects > 0 && ((sensitive && strip_sensitive) || (bodyh && !include_body))) {
        hk.push(k)
        hv.push(iv[j])
      }
      j += 1
    }
    // refererForURL: no Referer from an https URL to an http one
    if redirects > 0 && has_referer && referer.starts_with("https://") && u.scheme == "http" {
      has_referer = false
    }
    if redirects > 0 && has_referer {
      var seen = false
      for k in hk {
        if k == "Referer" {
          seen = true
        }
      }
      if !seen {
        hk.push("Referer")
        hv.push(referer)
      }
    }
    // the request: the address (host:port, 80 or 443 by default), the
    // target (the escaped path and the query)
    let addr = if scan.find(name, ":", 0) >= 0 { "[" + name + "]:" + port } else { name + ":" + port }
    var target = if u.path == "*" { "*" } else if u.path.is_empty() { "/" } else { escape_path(u.path) }
    if !u.rawquery.is_empty() {
      target = target + "?" + u.rawquery
    }
    let prefix = url_op(method) + " " + q
    var r = rthttp.cl_start(method, https, addr, name, target, u.host, hk, hv, body, when, roots, prefix, true)
    if rthttp.cl_h2(r) {
      h2_exchange(r, method, target, u.host, hk, hv, body.len())
      if rthttp.cl_retry(r) {
        // the server did not take the request on the pooled connection:
        // it goes on a new one, as Transport retries it
        r = rthttp.cl_start(method, https, addr, name, target, u.host, hk, hv, body, when, roots, prefix, false)
        if rthttp.cl_h2(r) {
          h2_exchange(r, method, target, u.host, hk, hv, body.len())
        }
      }
    }
    var status = 0
    var headers: List[Str] = []
    var rbody = b""
    if rthttp.cl_reading(r) {
      let x = read_response(r, method)
      rthttp.cl_end(r, x.s, x.why)
      status = x.status
      headers = x.headers
      rbody = x.body
    } else if rthttp.cr_err(r) == 0 {
      // an HTTP/2 response
      status = rthttp.cr_status(r)
      for i in 0..rthttp.cr_nheaders(r) {
        headers.push(rthttp.cr_hname(r, i))
        headers.push(rthttp.cr_hval(r, i))
      }
      rbody = rthttp.cr_body(r)
    }
    let err = rthttp.cr_err(r)
    if err != 0 {
      return cfail(err, rthttp.cr_msg(r))
    }
    // redirects (Client.Do's redirectBehavior)
    let li = field_at(headers, "Location")
    let follow = (status == 301 || status == 302 || status == 303 || status == 307 || status == 308) && li >= 0 && !headers[li + 1].is_empty()
    if !follow {
      return CResult{err: 0, msg: "", status: status, headers: headers, body: rbody}
    }
    last_loc = headers[li + 1]
    if redirects == 9 {
      // defaultCheckRedirect: the error names the Location
      return cfail(4, op + " " + go_quote(last_loc) + ": stopped after 10 redirects")
    }
    // the Referer: this request's URL (url.URL.String)
    referer = u.scheme + "://" + u.host + escape_path(u.path)
    if !u.rawquery.is_empty() {
      referer = referer + "?" + u.rawquery
    }
    has_referer = true
    // the new URL: the Location resolved against this one
    let loc = last_loc
    if scan.find(loc, ":", 0) >= 0 && !loc.starts_with("/") {
      raw = loc
    } else if loc.starts_with("//") {
      raw = u.scheme + ":" + loc
    } else if loc.starts_with("/") {
      raw = u.scheme + "://" + u.host + loc
    } else {
      // relative to the current path's directory
      let slash = rfind(u.path.bytes(), 47, u.path.len())
      let dir = if slash >= 0 { escape_path(rt.str_slice(u.path, 0, slash + 1)) } else { "/" }
      raw = u.scheme + "://" + u.host + dir + loc
    }
    if status == 301 || status == 302 || status == 303 {
      if method != "GET" && method != "HEAD" {
        method = "GET"
      }
      // once a hop drops the body, it is never sent again
      include_body = false
    }
    if !include_body {
      body = b""
    }
    redirects += 1
  }
  cfail(4, "")
}
