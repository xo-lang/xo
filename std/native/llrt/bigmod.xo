// Integers modulo an odd modulus of any size in constant time, for RSA
// (the zero-C audit's B31, decision 0202: Go's
// crypto/internal/fips140/bigmod design in Xo, replacing Mbed TLS's
// bignum). A number is a List[Int] of 64 bit limbs, the lowest first;
// every number of one modulus has its limb count. Values in a modulus's
// arithmetic are in the Montgomery domain (x R mod m, R = 2^(64 L)), and
// the operations follow ct.xo's rules for secret values: wrapping
// arithmetic, rt.u64_mul_hi, masks, no branch or index on a secret; the
// sizes (limb counts, an exponent's length) are public. exp_public is
// the one variable time operation, for public exponents.
use native/llrt/cpu
use native/llrt/ct
use native/llrt/raw
use native/rt

/// An odd modulus m > 1 of n limbs and its constants: the words of w are
/// -m^-1 mod 2^64, m, R^2 mod m, R mod m, then the product's scratch (2 n
/// + 2 words: a double width product and its reduction) and a
/// difference's (n words).
pub struct Mod {
  pub n: Int
  pub bits: Int
  w: List[Int]
}

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// The address of the first limb of xs (valid while xs is alive and not
/// resized).
pub fn addr(xs: List[Int]) -> Int { rt.obj_addr(xs).wrapping_add(rt.layout(2)) }

fn wbase(md: Mod) -> Int { addr(md.w) }

fn m_at(md: Mod) -> Int { wbase(md).wrapping_add(8) }

fn rr_at(md: Mod) -> Int { wbase(md).wrapping_add(8 + 8 * md.n) }

fn one_at(md: Mod) -> Int { wbase(md).wrapping_add(8 + 16 * md.n) }

fn t_at(md: Mod) -> Int { wbase(md).wrapping_add(8 + 24 * md.n) }

fn d_at(md: Mod) -> Int { wbase(md).wrapping_add(24 + 40 * md.n) }

/// A use of xs after its last raw access (nistec.xo's keep).
pub fn keep(xs: List[Int]) {
  if xs.len() < 0 {
    return
  }
}

// ---------------------------------------------------------------------------
// Words (nistec.xo's)

fn adc(h: Int, off: Int, x: Int, y: Int, cin: Int) -> Int {
  let s1 = x.wrapping_add(y)
  let s = s1.wrapping_add(cin)
  st(h, off, s)
  cpu.carry(x, y) | cpu.carry(s1, cin)
}

fn sbb(h: Int, off: Int, x: Int, y: Int, bin: Int) -> Int {
  let d1 = x.wrapping_sub(y)
  let d = d1.wrapping_sub(bin)
  st(h, off, d)
  cpu.borrow(x, y) | cpu.borrow(d1, bin)
}

fn mac(t: Int, off: Int, a: Int, b: Int, cin: Int) -> Int {
  let lo = a.wrapping_mul(b)
  let hi = a.mul_hi_unsigned(b)
  let x = ld(t, off)
  let s1 = lo.wrapping_add(x)
  let s2 = s1.wrapping_add(cin)
  st(t, off, s2)
  hi.wrapping_add(cpu.carry(lo, x) + cpu.carry(s1, cin))
}

// ---------------------------------------------------------------------------
// Numbers

/// n zero limbs.
pub fn zero(n: Int) -> List[Int] { raw.zero_ints(n) }

/// The big endian bytes b as n limbs; none when the value needs more.
pub fn from_bytes(b: Bytes, n: Int) -> List[Int]? {
  var xs = zero(n)
  for i in 0..b.len() {
    let x = Int(b[i])
    let k = b.len() - 1 - i
    if k / 8 >= n {
      if x != 0 {
        return None
      }
    } else {
      xs[k / 8] = xs[k / 8] | x.wrapping_shl(8 * (k % 8))
    }
  }
  Some(xs)
}

/// The value of xs as len big endian bytes (the higher bytes dropped).
pub fn to_bytes(xs: List[Int], len: Int) -> Bytes {
  var s = rt.rs_with_cap(len)
  var k = len - 1
  while k >= 0 {
    let v = if k / 8 < xs.len() { xs[k / 8].shr_logical(8 * (k % 8)) & 255 } else { 0 }
    s = rt.rs_push_byte(s, v)
    k -= 1
  }
  s.bytes()
}

/// The bit length of xs (public values only: it branches).
pub fn bit_len(xs: List[Int]) -> Int {
  var i = xs.len() - 1
  while i >= 0 {
    if xs[i] != 0 {
      return 64 * i + 64 - rt.clz(xs[i])
    }
    i -= 1
  }
  0
}

/// Whether a and b hold the same value (the limb counts are public).
pub fn equal(a: List[Int], b: List[Int]) -> Bool {
  var d = 0
  let n = if a.len() > b.len() { a.len() } else { b.len() }
  for i in 0..n {
    let x = if i < a.len() { a[i] } else { 0 }
    let y = if i < b.len() { b[i] } else { 0 }
    d = rt.ct_barrier(d | (x ^ y))
  }
  ct.mask_nonzero(d) == 0
}

/// Whether x < m (x of m's limb count; a mask).
fn below_at(md: Mod, x: Int) -> Int {
  let d = d_at(md)
  let m = m_at(md)
  var b = 0
  let oend = md.n.wrapping_shl(3)
  var o = 0
  while o < oend {
    b = sbb(d, o, ld(x, o), ld(m, o), b)
    o = o.wrapping_add(8)
  }
  ct.mask_bit(b)
}

/// Whether xs (of m's limb count) is below m.
pub fn below(md: Mod, xs: List[Int]) -> Bool {
  let r = below_at(md, addr(xs)) != 0
  keep(xs)
  keep(md.w)
  r
}

/// The product a b (a.len() + b.len() limbs; constant time).
pub fn mul_plain(a: List[Int], b: List[Int]) -> List[Int] {
  let out = zero(a.len() + b.len())
  let o = addr(out)
  let pa = addr(a)
  let pb = addr(b)
  for i in 0..b.len() {
    let bi = ld(pb, 8 * i)
    var cy = 0
    for j in 0..a.len() {
      cy = mac(o, 8 * (i + j), ld(pa, 8 * j), bi, cy)
    }
    st(o, 8 * (i + a.len()), cy)
  }
  keep(a)
  keep(b)
  out
}

/// a + b, a.len() limbs (b no longer; the carry out of the top dropped).
pub fn add_plain(a: List[Int], b: List[Int]) -> List[Int] {
  let out = zero(a.len())
  let o = addr(out)
  var cy = 0
  for i in 0..a.len() {
    let y = if i < b.len() { b[i] } else { 0 }
    cy = adc(o, 8 * i, a[i], y, cy)
  }
  out
}

// ---------------------------------------------------------------------------
// The modulus

/// The modulus of the limbs m (odd, above 1, its top limb not 0; the
/// caller checks).
pub fn modulus(m: List[Int]) -> Mod {
  let n = m.len()
  let md = Mod{n: n, bits: bit_len(m), w: zero(3 + 6 * n)}
  let w = wbase(md)
  rt.mem_copy(m_at(md), addr(m), 8 * n)
  let m0 = m[0]
  var y = 1
  for _ in 0..6 {
    y = y.wrapping_mul((2).wrapping_sub(m0.wrapping_mul(y)))
  }
  st(w, 0, (0).wrapping_sub(y))
  // R mod m: from 2^(bits-1), below m (m is odd, so above it), doubled
  // up to 2^(64 n) (as Go's rr; the modulus is public)
  let one = one_at(md)
  let top = md.bits - 1
  st(one, 8 * (top / 64), (1).wrapping_shl(top % 64))
  var k = top
  while k < 64 * n {
    add_at(md, one, one, one)
    k += 1
  }
  // R^2 mod m, the Montgomery form of R = 2^(64 n): from the form of 1,
  // square and double over the bits of 64 n (each square doubles the
  // exponent, each doubling adds one)
  let rr = rr_at(md)
  rt.mem_copy(rr, one, 8 * n)
  let e = 64 * n
  var i = 63 - rt.clz(e)
  while i >= 0 {
    mul_at(md, rr, rr, rr)
    if (e.shr_logical(i) & 1) == 1 {
      add_at(md, rr, rr, rr)
    }
    i -= 1
  }
  keep(m)
  md
}

/// The limbs of m.
pub fn limbs(md: Mod) -> List[Int] {
  let out = zero(md.n)
  rt.mem_copy(addr(out), m_at(md), 8 * md.n)
  keep(md.w)
  out
}

/// h = t - m when t + top 2^(64 n) >= m, else t.
fn final_sub(md: Mod, h: Int, t: Int, top: Int) {
  let n = md.n
  let d = d_at(md)
  let m = m_at(md)
  var b = 0
  let oend = n.wrapping_shl(3)
  var o = 0
  while o < oend {
    b = sbb(d, o, ld(t, o), ld(m, o), b)
    o = o.wrapping_add(8)
  }
  let keepm = ct.mask_bit(b & (top ^ 1))
  o = 0
  while o < oend {
    st(h, o, ct.pick(keepm, ld(t, o), ld(d, o)))
    o = o.wrapping_add(8)
  }
}

/// dst[j] += src[j] k plus the carry word for j below len, one pass:
/// each word's low half added with cpu.adc (decision 0231's addendum)
/// and the next carry word its high half plus the two carries (it
/// cannot overflow), each added right after the add that makes it
/// (`adcq $0` from CF on amd64: saved with setb and movzbl for a
/// three-input adc later, the 4-word round was 130 instructions to 115;
/// arm64 106 to 104, 2026-10-21), unrolled by 4 with wrapping offsets;
/// the carry word out.
pub fn mac_row(dst: Int, src: Int, k: Int, len: Int) -> Int {
  var cw = 0
  var o = 0
  // len is not negative: the byte offsets by shifts and a mask, not a
  // checked multiply and a signed remainder per call
  let end = len.wrapping_shl(3)
  let end4 = end & -32
  while o < end4 {
    let o1 = o.wrapping_add(8)
    let o2 = o.wrapping_add(16)
    let o3 = o.wrapping_add(24)
    let a0 = ld(src, o)
    let a1 = ld(src, o1)
    let a2 = ld(src, o2)
    let a3 = ld(src, o3)
    let x0 = ld(dst, o)
    let x1 = ld(dst, o1)
    let x2 = ld(dst, o2)
    let x3 = ld(dst, o3)
    let l0 = a0.wrapping_mul(k)
    let h0 = a0.mul_hi_unsigned(k)
    let s0 = cpu.adc(x0, l0, 0)
    let k0 = cpu.adc_carry(x0, l0, 0)
    let g0 = cpu.adc(h0, 0, k0)
    let t0 = cpu.adc(s0, cw, 0)
    let q0 = cpu.adc_carry(s0, cw, 0)
    let c0 = cpu.adc(g0, 0, q0)
    st(dst, o, t0)
    let l1 = a1.wrapping_mul(k)
    let h1 = a1.mul_hi_unsigned(k)
    let s1 = cpu.adc(x1, l1, 0)
    let k1 = cpu.adc_carry(x1, l1, 0)
    let g1 = cpu.adc(h1, 0, k1)
    let t1 = cpu.adc(s1, c0, 0)
    let q1 = cpu.adc_carry(s1, c0, 0)
    let c1 = cpu.adc(g1, 0, q1)
    st(dst, o1, t1)
    let l2 = a2.wrapping_mul(k)
    let h2 = a2.mul_hi_unsigned(k)
    let s2 = cpu.adc(x2, l2, 0)
    let k2 = cpu.adc_carry(x2, l2, 0)
    let g2 = cpu.adc(h2, 0, k2)
    let t2 = cpu.adc(s2, c1, 0)
    let q2 = cpu.adc_carry(s2, c1, 0)
    let c2 = cpu.adc(g2, 0, q2)
    st(dst, o2, t2)
    let l3 = a3.wrapping_mul(k)
    let h3 = a3.mul_hi_unsigned(k)
    let s3 = cpu.adc(x3, l3, 0)
    let k3 = cpu.adc_carry(x3, l3, 0)
    let g3 = cpu.adc(h3, 0, k3)
    let t3 = cpu.adc(s3, c2, 0)
    let q3 = cpu.adc_carry(s3, c2, 0)
    cw = cpu.adc(g3, 0, q3)
    st(dst, o3, t3)
    o = o.wrapping_add(32)
  }
  while o < end {
    let a = ld(src, o)
    let x = ld(dst, o)
    let l = a.wrapping_mul(k)
    let h = a.mul_hi_unsigned(k)
    let s = cpu.adc(x, l, 0)
    let c = cpu.adc_carry(x, l, 0)
    let g = cpu.adc(h, 0, c)
    let t = cpu.adc(s, cw, 0)
    let q = cpu.adc_carry(s, cw, 0)
    cw = cpu.adc(g, 0, q)
    st(dst, o, t)
    o = o.wrapping_add(8)
  }
  cw
}

/// The 2 n words at t (and 2 more, zeroed) = f g, schoolbook: per word
/// i of g a mac_row at word i, its carry word at word i + n (still 0).
fn prod_at(n: Int, t: Int, f: Int, g: Int) {
  rt.mem_set(t, 0, 8 * (2 * n + 2))
  // byte offsets carried, not 8 i per row (n is not negative)
  let n8 = n.wrapping_shl(3)
  var o = 0
  while o < n8 {
    let ti = t.wrapping_add(o)
    st(ti, n8, mac_row(ti, f, ld(g, o), n))
    o = o.wrapping_add(8)
  }
}

/// The 2 n words at t (and 2 more, zeroed) = f f: the cross products f_i
/// f_j (i < j) once, a mac_row of f_i and f_(i+1).. at word 2 i + 1 each
/// (its carry word at word i + n, still 0), doubled with one chain, then
/// the squares f_i f_i added with one chain (n (n + 1) / 2 products where
/// prod_at makes n n).
fn square_at(n: Int, t: Int, f: Int) {
  rt.mem_set(t, 0, 8 * (2 * n + 2))
  // row i at word 2 i + 1 of t, f from word i + 1, its carry at word
  // i + n: byte offsets carried (n is not negative)
  var i = 0
  var ti = t.wrapping_add(8)
  var fi = f
  var ci = t.wrapping_add(n.wrapping_shl(3))
  while i < n - 1 {
    st(ci, 0, mac_row(ti, fi.wrapping_add(8), ld(fi, 0), n - 1 - i))
    ti = ti.wrapping_add(16)
    fi = fi.wrapping_add(8)
    ci = ci.wrapping_add(8)
    i += 1
  }
  // doubled: the cross sum is below 2^(128 n - 1), so no carry out;
  // four words a step, one chain of cpu.adc (adcs on arm64)
  var c = 0
  var o = 0
  let end = 16 * n
  let end4 = end - end % 32
  while o < end4 {
    let o1 = o.wrapping_add(8)
    let o2 = o.wrapping_add(16)
    let o3 = o.wrapping_add(24)
    let x0 = ld(t, o)
    let x1 = ld(t, o1)
    let x2 = ld(t, o2)
    let x3 = ld(t, o3)
    let d0 = cpu.adc(x0, x0, c)
    let e0 = cpu.adc_carry(x0, x0, c)
    let d1 = cpu.adc(x1, x1, e0)
    let e1 = cpu.adc_carry(x1, x1, e0)
    let d2 = cpu.adc(x2, x2, e1)
    let e2 = cpu.adc_carry(x2, x2, e1)
    let d3 = cpu.adc(x3, x3, e2)
    c = cpu.adc_carry(x3, x3, e2)
    st(t, o, d0)
    st(t, o1, d1)
    st(t, o2, d2)
    st(t, o3, d3)
    o = o.wrapping_add(32)
  }
  while o < end {
    let x = ld(t, o)
    st(t, o, cpu.adc(x, x, c))
    c = cpu.adc_carry(x, x, c)
    o = o.wrapping_add(8)
  }
  // the squares at words 2 i and 2 i + 1: the square is below 2^(128 n);
  // two limbs a step, one chain of four pairs
  c = 0
  var fo = 0
  let fend = 8 * n
  let fend2 = fend - fend % 16
  while fo < fend2 {
    let to = fo.wrapping_add(fo)
    let fa = ld(f, fo)
    let fb = ld(f, fo.wrapping_add(8))
    let la = fa.wrapping_mul(fa)
    let ha = fa.mul_hi_unsigned(fa)
    let lb = fb.wrapping_mul(fb)
    let hb = fb.mul_hi_unsigned(fb)
    let x0 = ld(t, to)
    let x1 = ld(t, to.wrapping_add(8))
    let x2 = ld(t, to.wrapping_add(16))
    let x3 = ld(t, to.wrapping_add(24))
    let s0 = cpu.adc(x0, la, c)
    let c0 = cpu.adc_carry(x0, la, c)
    let s1 = cpu.adc(x1, ha, c0)
    let c1 = cpu.adc_carry(x1, ha, c0)
    let s2 = cpu.adc(x2, lb, c1)
    let c2 = cpu.adc_carry(x2, lb, c1)
    let s3 = cpu.adc(x3, hb, c2)
    c = cpu.adc_carry(x3, hb, c2)
    st(t, to, s0)
    st(t, to.wrapping_add(8), s1)
    st(t, to.wrapping_add(16), s2)
    st(t, to.wrapping_add(24), s3)
    fo = fo.wrapping_add(16)
  }
  while fo < fend {
    let to = fo.wrapping_add(fo)
    let fi = ld(f, fo)
    let lo = fi.wrapping_mul(fi)
    let hi = fi.mul_hi_unsigned(fi)
    let x0 = ld(t, to)
    let x1 = ld(t, to.wrapping_add(8))
    let s0 = cpu.adc(x0, lo, c)
    let c0 = cpu.adc_carry(x0, lo, c)
    st(t, to, s0)
    st(t, to.wrapping_add(8), cpu.adc(x1, hi, c0))
    c = cpu.adc_carry(x1, hi, c0)
    fo = fo.wrapping_add(8)
  }
}

/// h = T / R mod m for the 2 n word T at t below m R (Montgomery's
/// reduction): per word i, q = T_i (-1/m) mod 2^64 and a mac_row of q m
/// at word i (which zeroes it), its carry word added at word i + n with
/// the carry passed from the last word (0 or 1).
fn redc_at(md: Mod, h: Int, t: Int) {
  let n = md.n
  let m = m_at(md)
  let inv = ld(wbase(md), 0)
  let tn = 8 * n
  let end = t.wrapping_add(tn)
  var ext = 0
  var ti = t
  while ti != end {
    let cw = mac_row(ti, m, ld(ti, 0).wrapping_mul(inv), n)
    let x = ld(ti, tn)
    // the sum and its carry before the store: one adcs and a cset
    let y = cpu.adc(x, cw, ext)
    ext = cpu.adc_carry(x, cw, ext)
    st(ti, tn, y)
    ti = ti.wrapping_add(8)
  }
  final_sub(md, h, end, ext)
}

/// h = f g / R mod m (f g < m R): the product, then the reduction.
fn mul_at(md: Mod, h: Int, f: Int, g: Int) {
  if f == g {
    sqr_at(md, h, f)
    return
  }
  let t = t_at(md)
  prod_at(md.n, t, f, g)
  redc_at(md, h, t)
}

/// h = f f / R mod m (f < m): the square, then the reduction.
fn sqr_at(md: Mod, h: Int, f: Int) {
  let t = t_at(md)
  square_at(md.n, t, f)
  redc_at(md, h, t)
}

/// h = f + g mod m.
fn add_at(md: Mod, h: Int, f: Int, g: Int) {
  let t = t_at(md)
  var cy = 0
  let oend = md.n.wrapping_shl(3)
  var o = 0
  while o < oend {
    cy = adc(t, o, ld(f, o), ld(g, o), cy)
    o = o.wrapping_add(8)
  }
  final_sub(md, h, t, cy)
}

/// h = f - g mod m.
fn sub_at(md: Mod, h: Int, f: Int, g: Int) {
  let t = t_at(md)
  let m = m_at(md)
  var b = 0
  let oend = md.n.wrapping_shl(3)
  var o = 0
  while o < oend {
    b = sbb(t, o, ld(f, o), ld(g, o), b)
    o = o.wrapping_add(8)
  }
  let mask = ct.mask_bit(b)
  var cy = 0
  o = 0
  while o < oend {
    cy = adc(h, o, ld(t, o), ld(m, o) & mask, cy)
    o = o.wrapping_add(8)
  }
}

/// a b (Montgomery).
pub fn mul(md: Mod, a: List[Int], b: List[Int]) -> List[Int] {
  let out = zero(md.n)
  mul_at(md, addr(out), addr(a), addr(b))
  keep(a)
  keep(b)
  keep(md.w)
  out
}

/// a - b mod m.
pub fn sub(md: Mod, a: List[Int], b: List[Int]) -> List[Int] {
  let out = zero(md.n)
  sub_at(md, addr(out), addr(a), addr(b))
  keep(a)
  keep(b)
  keep(md.w)
  out
}

/// x R mod m (the Montgomery form of x mod m) of x of any limb count:
/// Horner's rule over x's chunks of n limbs, each chunk c turned into c R
/// by a product with R^2 (c < R and R^2 mod m < m, so c R^2 < m R).
pub fn reduce(md: Mod, x: List[Int]) -> List[Int] {
  let n = md.n
  let k = (x.len() + n - 1) / n
  let acc = zero(n)
  let c = zero(n)
  let pa = addr(acc)
  let pc = addr(c)
  let rr = rr_at(md)
  var i = k - 1
  while i >= 0 {
    // acc = acc R (as a value: acc R^2 / R)
    mul_at(md, pa, pa, rr)
    for j in 0..n {
      st(pc, 8 * j, if i * n + j < x.len() { x[i * n + j] } else { 0 })
    }
    mul_at(md, pc, pc, rr)
    add_at(md, pa, pa, pc)
    i -= 1
  }
  keep(c)
  keep(md.w)
  acc
}

/// x / R mod m: the plain value of the Montgomery form x.
pub fn from_mont(md: Mod, x: List[Int]) -> List[Int] {
  var one = zero(md.n)
  one[0] = 1
  mul(md, x, one)
}

/// x^e (Montgomery in and out), e the limbs of a secret exponent: a
/// fixed window of 4 bits over all of e's limbs (their count is public),
/// each step 4 squarings and a product with a table entry chosen under a
/// mask from all 16 (exp_into).
pub fn exp(md: Mod, x: List[Int], e: List[Int]) -> List[Int] {
  let n = md.n
  let acc = zero(n)
  exp_into(md, x, e, zero(16 * n), acc, zero(n))
  acc
}

/// exp's work in the table tab (16 n limbs), acc (n, the result) and sel
/// (n, the entry chosen), split out of exp as mlkem.implicit_reject is
/// out of decaps_key: the lists' allocation, inlined, has a select on
/// their public length (rl_new_n's capacity of at least 4), which the
/// constant time checks (test/codegen/consttime, TestConstantTimeLLVM)
/// cannot tell from a select on the secret; here every word is read and
/// written by address.
fn exp_into(md: Mod, x: List[Int], e: List[Int], tab: List[Int], acc: List[Int], sel: List[Int]) {
  let n = md.n
  let pt = addr(tab)
  let px = addr(x)
  rt.mem_copy(pt, one_at(md), 8 * n)
  for i in 1..16 {
    mul_at(md, pt + 8 * n * i, pt + 8 * n * (i - 1), px)
  }
  let stride = 8 * n
  let pa = addr(acc)
  let ps = addr(sel)
  rt.mem_copy(pa, one_at(md), 8 * n)
  var w = 16 * e.len() - 1
  while w >= 0 {
    for _ in 0..4 {
      mul_at(md, pa, pa, pa)
    }
    let digit = e[w / 16].shr_logical(4 * (w % 16)) & 15
    // the entry of digit under a mask from all 16: each word the OR of
    // the 16 entries' words under their masks, in registers, one store
    let m0 = ct.mask_eq(0, digit)
    let m1 = ct.mask_eq(1, digit)
    let m2 = ct.mask_eq(2, digit)
    let m3 = ct.mask_eq(3, digit)
    let m4 = ct.mask_eq(4, digit)
    let m5 = ct.mask_eq(5, digit)
    let m6 = ct.mask_eq(6, digit)
    let m7 = ct.mask_eq(7, digit)
    let m8 = ct.mask_eq(8, digit)
    let m9 = ct.mask_eq(9, digit)
    let m10 = ct.mask_eq(10, digit)
    let m11 = ct.mask_eq(11, digit)
    let m12 = ct.mask_eq(12, digit)
    let m13 = ct.mask_eq(13, digit)
    let m14 = ct.mask_eq(14, digit)
    let m15 = ct.mask_eq(15, digit)
    var o = 0
    while o < stride {
      let ent = pt.wrapping_add(o)
      st(ps, o, (ld(ent, 0) & m0) | (ld(ent, stride.wrapping_mul(1)) & m1) | (ld(ent, stride.wrapping_mul(2)) & m2) | (ld(ent, stride.wrapping_mul(3)) & m3) | (ld(ent, stride.wrapping_mul(4)) & m4) | (ld(ent, stride.wrapping_mul(5)) & m5) | (ld(ent, stride.wrapping_mul(6)) & m6) | (ld(ent, stride.wrapping_mul(7)) & m7) | (ld(ent, stride.wrapping_mul(8)) & m8) | (ld(ent, stride.wrapping_mul(9)) & m9) | (ld(ent, stride.wrapping_mul(10)) & m10) | (ld(ent, stride.wrapping_mul(11)) & m11) | (ld(ent, stride.wrapping_mul(12)) & m12) | (ld(ent, stride.wrapping_mul(13)) & m13) | (ld(ent, stride.wrapping_mul(14)) & m14) | (ld(ent, stride.wrapping_mul(15)) & m15))
      o = o.wrapping_add(8)
    }
    mul_at(md, pa, pa, ps)
    w -= 1
  }
  keep(tab)
  keep(sel)
  keep(acc)
  keep(x)
  keep(md.w)
}

/// x^e (Montgomery in and out) for a public exponent e > 0: square and
/// multiply, variable time in e only.
pub fn exp_public(md: Mod, x: List[Int], e: Int) -> List[Int] {
  let acc = zero(md.n)
  let pa = addr(acc)
  let px = addr(x)
  rt.mem_copy(pa, px, 8 * md.n)
  var i = 62 - rt.clz(e)
  while i >= 0 {
    mul_at(md, pa, pa, pa)
    if (e.shr_logical(i) & 1) == 1 {
      mul_at(md, pa, pa, px)
    }
    i -= 1
  }
  keep(x)
  keep(md.w)
  acc
}

// ---------------------------------------------------------------------------
// Any modulus (decision 0285: an RSA key's checks modulo p - 1, which is
// even, as Go's bigmod does for even moduli), in constant time: one
// shift and one masked subtraction per bit of x.

/// x mod m (m.len() limbs; m above 0, its limb count public).
pub fn mod_any(x: List[Int], m: List[Int]) -> List[Int] {
  let n = m.len()
  var r = zero(n + 1)
  var i = 64 * x.len() - 1
  while i >= 0 {
    let bit = x[i / 64].shr_logical(i % 64) & 1
    // r = 2 r + bit
    var cy = bit
    for k in 0..n + 1 {
      let v = r[k]
      r[k] = v.wrapping_shl(1) | cy
      cy = v.shr_logical(63)
    }
    // r = r - m when r >= m
    var d = zero(n + 1)
    var b = 0
    for k in 0..n + 1 {
      let y = if k < n { m[k] } else { 0 }
      let d1 = r[k].wrapping_sub(y)
      let dk = d1.wrapping_sub(b)
      b = cpu.borrow(r[k], y) | cpu.borrow(d1, b)
      d[k] = dk
    }
    let keep_r = ct.mask_bit(b)
    for k in 0..n + 1 {
      r[k] = (r[k] & keep_r) | (d[k] & ~keep_r)
    }
    i -= 1
  }
  var out = zero(n)
  for k in 0..n {
    out[k] = r[k]
  }
  out
}

/// (a b) mod m.
pub fn mul_mod_any(a: List[Int], b: List[Int], m: List[Int]) -> List[Int] { mod_any(mul_plain(a, b), m) }

/// x - 1 (x above 0).
pub fn sub_one(x: List[Int]) -> List[Int] {
  var out = zero(x.len())
  var b = 1
  for k in 0..x.len() {
    let d = x[k].wrapping_sub(b)
    b = cpu.borrow(x[k], b)
    out[k] = d
  }
  out
}

/// Whether x is 1.
pub fn is_one(x: List[Int]) -> Bool {
  var d = if x.len() > 0 { x[0] ^ 1 } else { 1 }
  for k in 1..x.len() {
    d = rt.ct_barrier(d | x[k])
  }
  ct.mask_nonzero(d) == 0
}

/// Whether a < b, as numbers of any limb counts (a mask's truth).
pub fn less(a: List[Int], b: List[Int]) -> Bool {
  let n = if a.len() > b.len() { a.len() } else { b.len() }
  var bw = 0
  for k in 0..n {
    let x = if k < a.len() { a[k] } else { 0 }
    let y = if k < b.len() { b[k] } else { 0 }
    let d1 = x.wrapping_sub(y)
    bw = cpu.borrow(x, y) | cpu.borrow(d1, bw)
  }
  bw == 1
}

/// a - b (a >= b), a.len() limbs.
pub fn sub_plain(a: List[Int], b: List[Int]) -> List[Int] {
  var out = zero(a.len())
  var bw = 0
  for k in 0..a.len() {
    let y = if k < b.len() { b[k] } else { 0 }
    let d1 = a[k].wrapping_sub(y)
    out[k] = d1.wrapping_sub(bw)
    bw = cpu.borrow(a[k], y) | cpu.borrow(d1, bw)
  }
  out
}

/// Whether x is 0.
pub fn is_zero_any(x: List[Int]) -> Bool {
  var d = 0
  for k in 0..x.len() {
    d = rt.ct_barrier(d | x[k])
  }
  ct.mask_nonzero(d) == 0
}

/// x without its zero top limbs (at least one limb; the length is public).
pub fn trim(x: List[Int]) -> List[Int] {
  var n = x.len()
  while n > 1 && x[n - 1] == 0 {
    n -= 1
  }
  var out = zero(n)
  for k in 0..n {
    out[k] = x[k]
  }
  out
}
