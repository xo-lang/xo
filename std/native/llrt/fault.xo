// The fault record of a context (core 8, decision 0085; the zero-C
// audit's item B06): the message, location, and detail line of the fault
// unwinding a context, and the report of a fault nothing caught. The
// record lives in the C runtime's xo_ctx (std/llrt/xo_rt.c asserts the
// offsets below): `faulting`, and three zero terminated strings in
// malloc'd blocks (rt.heap_large), which the C scheduler hands from a
// faulted task to the scope that joins it. The C calls these through
// cabi.xo (fault_record_*).
//
// The fault entry points of generated code (decision 0228): the checked
// operations, `fault(msg)`, a failed contract, the landing pads' hand on,
// and task.isolate's catch call cabi.xo's fault_* exports directly, which
// write the message here and raise it through the C's fault_raise_msg
// (its address in rt.static_word RAISE; the unwind itself stays in
// xo_rt.c fault_raise and unwind.xo).
//
// Nothing here faults.
use native/llrt/layout
use native/llrt/num
use native/llrt/obj
use native/llrt/process
use native/llrt/raw
use native/llrt/stdio
use native/llrt/unwind
use native/rt

/// rt.static_word: the address of cabi.xo fault_raise_msg (a C ABI
/// export of a zero terminated message and location that records the
/// fault in the current context and raises it, or with a null message
/// raises the fault already recorded; never returns), set by init.
const RAISE = 64

/// rt.static_word: the address of cabi.xo fault_raise_pos, the raise of
/// a generated code position (a file name, line, and column rather than
/// a "file:line:col" string: the checked operations of every native
/// build pass those three words, and the file name is shared by all the
/// sites of the file), set by init_pos. Word 66, next to RAISE and TB,
/// so this file owns one range (90 until 2026-10-25).
const RAISE_POS = 66

/// xo_ctx's fields: `unwinding` and `faulting` (C ints), the message,
/// location, and detail (char pointers, NULL when unset).
const C_UNWINDING = layout.C_UNWINDING
const C_FAULTING = layout.C_FAULTING
const C_FAULT_MSG = layout.C_FAULT_MSG
const C_LOC = 96
const C_DETAIL = 104
/// ctx.xo C_FAULT_TRACE
const C_FAULT_TRACE = layout.C_FAULT_TRACE
/// rt.static_word: XO_TRACEBACK (the fault report's traceback, decision
/// 0239): 0 not looked up yet, 1 off, else the address of the function
/// that prints it, plus 1 for XO_TRACEBACK=locals (decision 0268: each
/// frame's registers are kept for its variables; a function's address
/// is even) (cabi.xo fault_traceback, called through a pointer:
/// called directly, prof.xo's code in exit's reach grew the raise's
/// frame and every fault in a task overflowed its stack).
const TB = 65
/// The frames a traceback keeps.
const TB_DEPTH = 64
/// The registers kept per frame for XO_TRACEBACK=locals: the unwinder's
/// whole state (unwind.xo NREG, by DWARF number: x0 to sp, then the
/// vector registers from 64, d8 at 72, on arm64).
const TB_REGS = 96
/// A trace block's header: the frame count, the words a frame, and the
/// report's text made at the fault (its address and length; 0 for none:
/// XO_TRACEBACK=locals makes it there, cabi.xo fault_traceback).
const TB_HDR = 32

/// A zero terminated copy of the n bytes at p in a block from malloc,
/// at the block's own address (rt.heap_large returns the address after
/// its 8 byte prefix; the C frees these strings with free, so the string
/// starts where the prefix was).
fn dup(p: Int, n: Int) -> Int {
  let b = rt.heap_large(n + 1) - 8
  rt.mem_copy(b, p, n)
  rt.mem_store(b, n, 0, 1)
  b
}

/// Frees the string in the field at off of the context c and clears it.
fn drop(c: Int, off: Int) {
  let b = rt.mem_load(c, off, 8)
  if b != 0 {
    rt.heap_release(b)
    rt.mem_store(c, off, 0, 8)
  }
}

/// Records the fault of the context c: the mn bytes at mp its message,
/// the ln bytes at lp its location (a fault raised while one unwinds
/// replaces it, as a panic in Go's deferred code does). The detail line,
/// set just before by detail, stays.
pub fn set(c: Int, mp: Int, mn: Int, lp: Int, ln: Int) {
  let m = dup(mp, mn)
  let l = dup(lp, ln)
  drop(c, C_FAULT_MSG)
  drop(c, C_LOC)
  rt.mem_store(c, C_FAULT_MSG, m, 8)
  rt.mem_store(c, C_LOC, l, 8)
  if traceback_on() {
    trace(c)
  }
}

/// Records the fault of the context c at the position (the zero
/// terminated file name at file, and line, col): as set, but the location
/// is made here, one block (pos_text) rather than a copy of a "file:line:
/// col" string the compiler emitted per checked operation.
pub fn set_pos(c: Int, mp: Int, mn: Int, file: Int, line: Int, col: Int) {
  let m = dup(mp, mn)
  let l = pos_text(file, line, col)
  drop(c, C_FAULT_MSG)
  drop(c, C_LOC)
  rt.mem_store(c, C_FAULT_MSG, m, 8)
  rt.mem_store(c, C_LOC, l, 8)
  if traceback_on() {
    trace(c)
  }
}

/// Whether XO_TRACEBACK is set (init_traceback looked it up at start: a fault in
/// a task runs on the task's small stack, where the environment's lookup
/// overflowed it).
fn traceback_on() -> Bool { rt.mem_load(rt.static_word(TB), 0, 8) > 2 }

/// Records in the context c the return addresses of the frames this
/// fault is raised in (unwind.xo trace: the unwind tables' walk, on
/// every backend).
fn trace(c: Int) {
  let old = rt.mem_load(c, C_FAULT_TRACE, 8)
  if old != 0 && rt.mem_load(old, 16, 8) == -1 {
    // a fault while the report's locals are made (below): not again, so
    // it cannot recurse; that fault reports itself
    return
  }
  drop_trace(c)
  // the block: the frame count, the words a frame, then the frames (a
  // return address, and its registers for XO_TRACEBACK=locals)
  let f = rt.mem_load(rt.static_word(TB), 0, 8)
  // (windows/amd64's from the RtlVirtualUnwind walk's CONTEXT, unwind.xo
  // win_walk_regs)
  let regs = (f & 1) == 1
  let rw = if regs { TB_REGS } else { 0 }
  let b = rt.heap_large(TB_HDR + 8 * (1 + rw) * TB_DEPTH)
  let n = unwind.trace_frames(b + TB_HDR, TB_DEPTH, rw)
  rt.mem_store(b, 0, n, 8)
  rt.mem_store(b, 8, 1 + rw, 8)
  rt.mem_store(b, 16, 0, 8)
  rt.mem_store(b, 24, 0, 8)
  rt.mem_store(c, C_FAULT_TRACE, b, 8)
  if rw > 0 {
    // the report's text now, while the frames' values are alive (the
    // unwinding before the report releases them); through the printer's
    // address, as exit calls it, so the raise's frame stays small. -1
    // while it runs (trace above)
    rt.mem_store(b, 16, -1, 8)
    let _r = rt.call_c2(f - 1, b, 1)
    if rt.mem_load(b, 16, 8) == -1 {
      rt.mem_store(b, 16, 0, 8)
    }
  }
}

/// Sets the line printed under the next fault of the context c (the
/// values of a failed contract, core 9.1): the n bytes at p.
pub fn detail(c: Int, p: Int, n: Int) {
  let d = dup(p, n)
  drop(c, C_DETAIL)
  rt.mem_store(c, C_DETAIL, d, 8)
}

/// Clears the record of the context c.
pub fn clear(c: Int) {
  rt.mem_store(c, C_FAULTING, 0, 4)
  drop(c, C_FAULT_MSG)
  drop(c, C_LOC)
  drop(c, C_DETAIL)
  drop_trace(c)
}

/// Frees the context c's trace block and the report text it holds: both
/// from rt.heap_large, which heap_release takes by its prefix (b - 8).
/// drop's heap_release(b) freed nothing, so each fault caught under
/// XO_TRACEBACK kept its block (200,000 task.isolate faults: 203 MB
/// against 2.8 MB without, 2026-10-22).
fn drop_trace(c: Int) {
  let b = rt.mem_load(c, C_FAULT_TRACE, 8)
  if b == 0 {
    return
  }
  if rt.mem_load(b, 16, 8) > 0 {
    rt.heap_release(rt.mem_load(b, 16, 8) - 8)
    rt.mem_store(b, 16, 0, 8)
  }
  rt.heap_release(b - 8)
  rt.mem_store(c, C_FAULT_TRACE, 0, 8)
}

/// Catches the fault unwinding the context c (task.isolate): 1 and the
/// context goes on normally, the record kept for the message and the
/// location; 0 when it is not a fault (cancellation, which goes on
/// unwinding).
pub fn take(c: Int) -> Int {
  if rt.mem_load(c, C_FAULTING, 4) == 0 {
    return 0
  }
  rt.mem_store(c, C_FAULTING, 0, 4)
  rt.mem_store(c, C_UNWINDING, 0, 4)
  1
}

/// Moves the message and the location of the fault take caught in the
/// context c to the words at mp and lp (zero terminated blocks the caller
/// frees with rt.heap_release; 0 when unset) and clears the rest of the
/// record: a lazy constant's stored fault (decision 0332).
pub fn move_out(c: Int, mp: Int, lp: Int) {
  rt.mem_store(mp, 0, rt.mem_load(c, C_FAULT_MSG, 8), 8)
  rt.mem_store(lp, 0, rt.mem_load(c, C_LOC, 8), 8)
  rt.mem_store(c, C_FAULT_MSG, 0, 8)
  rt.mem_store(c, C_LOC, 0, 8)
  clear(c)
}

/// A new string object holding the zero terminated string at p (empty
/// when p is 0), its length stored at lenp.
fn str_of(p: Int, lenp: Int) -> Int {
  let n = if p == 0 { 0 } else { raw.cstr_len(p) }
  rt.mem_store(lenp, 0, n, 8)
  obj.rs_append(obj.rs_with_cap(n), 0, p, n)
}

/// The message of the fault take caught in the context c (xo_fault_msg),
/// its length stored at lenp.
pub fn msg(c: Int, lenp: Int) -> Int { str_of(rt.mem_load(c, C_FAULT_MSG, 8), lenp) }

/// Its location (xo_fault_loc), its length stored at lenp; the record is
/// cleared after it.
pub fn loc(c: Int, lenp: Int) -> Int {
  let r = str_of(rt.mem_load(c, C_LOC, 8), lenp)
  clear(c)
  r
}

/// Reports the fault of the context c that nothing caught and ends the
/// process with status 70: standard output flushed, then "fault: MSG at
/// LOC" and the detail line, if any, on standard error in one write.
pub fn exit(c: Int) {
  stdio.flush()
  let m = rt.mem_load(c, C_FAULT_MSG, 8)
  let l = rt.mem_load(c, C_LOC, 8)
  let d = rt.mem_load(c, C_DETAIL, 8)
  let mn = if m == 0 { 5 } else { raw.cstr_len(m) }
  let ln = if l == 0 { 1 } else { raw.cstr_len(l) }
  let dn = if d == 0 { 0 } else { raw.cstr_len(d) }
  let n = 7 + mn + 4 + ln + 1 + dn + (if dn > 0 { 1 } else { 0 })
  let b = rt.heap_large(n)
  var o = put(b, 0, "fault: ")
  o = if m == 0 { put(b, o, "fault") } else { put_at(b, o, m, mn) }
  o = put(b, o, " at ")
  o = if l == 0 { put(b, o, "?") } else { put_at(b, o, l, ln) }
  o = put(b, o, "\n")
  if dn > 0 {
    o = put_at(b, o, d, dn)
    o = put(b, o, "\n")
  }
  stdio.write_all(2, b, o)
  // XO_TRACEBACK: the frames the fault was raised in, by function and
  // .xo line (cabi.xo fault_traceback, through its address)
  let f = rt.mem_load(rt.static_word(TB), 0, 8)
  let t = rt.mem_load(c, C_FAULT_TRACE, 8)
  if f > 2 && t != 0 {
    // taken out of the context first: a fault while printing it ends the
    // process with that fault's report, not this one's printing again;
    // and the context no longer unwinds (the process ends after), so the
    // printer's code does not hand this fault on at its first check
    rt.mem_store(c, C_FAULT_TRACE, 0, 8)
    rt.mem_store(c, C_UNWINDING, 0, 4)
    rt.mem_store(c, C_FAULTING, 0, 4)
    let _r = rt.call_c2(f - (f & 1), t, 0)
  }
  process.os_exit(70)
}

/// Copies s to b + o: the offset after it.
fn put(b: Int, o: Int, s: Str) -> Int { put_at(b, o, raw.data(s), s.len()) }

/// Copies the n bytes at p to b + o: the offset after them.
fn put_at(b: Int, o: Int, p: Int, n: Int) -> Int {
  rt.mem_copy(b + o, p, n)
  o + n
}

// ---------------------------------------------------------------------------
// Raising (decision 0228)

/// Sets the address of the C's fault_raise_msg (at start, before the
/// program runs).
pub fn init(raise_msg: Int) { rt.mem_store(rt.static_word(RAISE), 0, raise_msg, 8) }

/// Sets the address of cabi.xo fault_raise_pos, the raise of a generated
/// code position (at start, beside init).
pub fn init_pos(raise_pos: Int) { rt.mem_store(rt.static_word(RAISE_POS), 0, raise_pos, 8) }

/// Looks up XO_TRACEBACK (not empty or 0) once, at start after the
/// environment is kept (entry.xo, beside prof.start); print is the
/// address of the function that prints a traceback.
pub fn init_traceback(print: Int) {
  let e = process.env_real("XO_TRACEBACK")
  // on unless XO_TRACEBACK=0 (owner, 2026-10-22: frames by default, as
  // a hardware fault's report has them, decision 0343; a caught fault
  // pays about 0.5 us for its trace, bench/results/fault-frames-default-2026-10-22.md)
  var w = print
  if !e.is_empty() && e[0] == "0" {
    w = 1
  } else if !e.is_empty() && e[0] == "locals" {
    w = print + 1
  }
  rt.mem_store(rt.static_word(TB), 0, w, 8)
}

/// The return addresses in the trace block t (trace: the count, then
/// the addresses; 0 for none).
pub fn trace_pcs(t: Int) -> List[Int] {
  var pcs: List[Int] = []
  if t != 0 {
    let w = rt.mem_load(t, 8, 8)
    for i in 0..rt.mem_load(t, 0, 8) {
      pcs.push(rt.mem_load(t, TB_HDR + 8 * w * i, 8))
    }
  }
  pcs
}

/// The addresses of the frames' registers in the trace block t (each
/// TB_REGS words, by DWARF number), or none when the block has none
/// (XO_TRACEBACK=locals was not set).
pub fn trace_regs(t: Int) -> List[Int] {
  var out: List[Int] = []
  if t != 0 && rt.mem_load(t, 8, 8) > 1 {
    let w = rt.mem_load(t, 8, 8)
    for i in 0..rt.mem_load(t, 0, 8) {
      out.push(t + TB_HDR + 8 * w * i + 8)
    }
  }
  out
}

/// Raises the fault whose zero terminated message is at m, at the zero
/// terminated location loc: never returns.
fn fire(m: Int, loc: Int) {
  let _r = rt.call_c2(rt.mem_load(rt.static_word(RAISE), 0, 8), m, loc)
}

/// Raises the fault whose zero terminated message is at m at the
/// position (the zero terminated file name at file, line, col): never
/// returns. The location is made ("file:line:col") where the fault is
/// recorded, so the file name is stored once per file rather than once
/// per checked operation (cabi.xo fault_raise_pos, set_pos).
fn fire_pos(m: Int, file: Int, line: Int, col: Int) {
  let _r = rt.call_c4(rt.mem_load(rt.static_word(RAISE_POS), 0, 8), m, file, line, col)
}

/// The thread's message buffer holding s: s copied there, zero
/// terminated (a message longer than the buffer goes to a malloc'd block,
/// never freed, as the raise does not return).
fn text(s: Str) -> Int { at(raw.data(s), s.len()) }

/// The thread's message buffer holding the n bytes at p, zero terminated.
fn at(p: Int, n: Int) -> Int {
  var b = unwind.msg_buf()
  if b == 0 || n >= unwind.MSG_BYTES {
    b = rt.heap_large(n + 1)
  }
  rt.mem_copy(b, p, n)
  rt.mem_store(b, n, 0, 1)
  b
}

/// `fault(msg)` (xo_fault): the n bytes at p, at the position (file,
/// line, col).
pub fn raise_text(p: Int, n: Int, file: Int, line: Int, col: Int) { fire_pos(at(p, n), file, line, col) }

pub fn raise_overflow(a: Int, op: Int, b: Int, file: Int, line: Int, col: Int) { fire_pos(text("integer overflow: ${a} ${raw.byte_str(op)} ${b} does not fit Int"), file, line, col) }

pub fn raise_shl(a: Int, b: Int, file: Int, line: Int, col: Int) { fire_pos(text("integer overflow: ${a} << ${b} does not fit Int"), file, line, col) }

pub fn raise_shift(n: Int, file: Int, line: Int, col: Int) { fire_pos(text("shift amount ${n} out of range for Int"), file, line, col) }

pub fn raise_divzero(a: Int, op: Int, file: Int, line: Int, col: Int) { fire_pos(text("division by zero: ${a} ${raw.byte_str(op)} 0"), file, line, col) }

pub fn raise_neg(a: Int, file: Int, line: Int, col: Int) { fire_pos(text("integer overflow: -(${a}) does not fit Int"), file, line, col) }

pub fn raise_abs(a: Int, file: Int, line: Int, col: Int) { fire_pos(text("integer overflow: abs(${a}) does not fit Int"), file, line, col) }

pub fn raise_index(i: Int, n: Int, file: Int, line: Int, col: Int) { fire_pos(text("index ${i} out of range for List of length ${n}"), file, line, col) }

/// `b[i]` out of range on Bytes (std/rt BytesAt).
pub fn raise_bytes_index(i: Int, n: Int, file: Int, line: Int, col: Int) { fire_pos(text("index ${i} out of range for Bytes of length ${n}"), file, line, col) }

pub fn raise_float_int(f: Float, file: Int, line: Int, col: Int) {
  if f != f {
    fire_pos(text("cannot convert NaN to Int"), file, line, col)
    return
  }
  fire_pos(text("${num.go_g_text(f)} is out of range for Int"), file, line, col)
}

/// A zero terminated copy of the n bytes at p (a location that is not
/// zero terminated; never freed, as the raise does not return).
fn zcopy(p: Int, n: Int) -> Int {
  let l = rt.heap_large(n + 1)
  rt.mem_copy(l, p, n)
  rt.mem_store(l, n, 0, 1)
  l
}

/// The location "file:line:col" of a fault raised with a position: the
/// zero terminated file name at file, then the line and the column. line
/// 0 means the position was not of that shape: the file name is the whole
/// location. The block is dup's shape (its first byte where heap_large's
/// prefix is; the raise's set_pos stores it as the record's location).
fn pos_text(file: Int, line: Int, col: Int) -> Int {
  let n = raw.cstr_len(file)
  if line == 0 {
    let b = rt.heap_large(n + 1) - 8
    rt.mem_copy(b, file, n)
    rt.mem_store(b, n, 0, 1)
    return b
  }
  // two colons and two decimals of at most 20 digits
  let b = rt.heap_large(n + 42) - 8
  rt.mem_copy(b, file, n)
  var o = n
  rt.mem_store(b, o, 58, 1)
  o = o + 1 + put_uint(b, o + 1, line)
  rt.mem_store(b, o, 58, 1)
  o = o + 1 + put_uint(b, o + 1, col)
  rt.mem_store(b, o, 0, 1)
  b
}

/// The decimal of n (0 or more) at b + o; its digit count.
fn put_uint(b: Int, o: Int, n: Int) -> Int {
  var d = 1
  var t = n
  while t >= 10 {
    t = t / 10
    d += 1
  }
  var i = d
  var v = n
  while i > 0 {
    rt.mem_store(b, o + i - 1, 48 + v % 10, 1)
    v = v / 10
    i -= 1
  }
  d
}

/// Raises the fault m at the ln bytes at lp.
pub fn raise_str_at(m: Str, lp: Int, ln: Int) { fire(text(m), zcopy(lp, ln)) }

/// `fault(msg)` and a failed contract (xo_fault_raise): the n bytes at p
/// at the ln bytes at lp.
pub fn raise(p: Int, n: Int, lp: Int, ln: Int) { fire(at(p, n), zcopy(lp, ln)) }

/// The unwind exit of a function (xo_fault_continue): when the context c
/// (0 on a thread with none) unwinds a fault, raises it again from here,
/// on to the caller; otherwise (cancellation) returns.
pub fn cont(c: Int) {
  if c != 0 && rt.mem_load(c, C_FAULTING, 4) != 0 {
    fire(0, 0)
  }
}

/// Raises the fault whose zero terminated message is at m, at the zero
/// terminated location loc (C strings the record copies): never returns.
pub fn raise_cstrs(m: Int, loc: Int) { fire(m, loc) }
