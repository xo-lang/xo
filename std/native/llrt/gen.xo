// The scalar values of property tests and testing.gen (decision 0120) on
// the native backends, written in Xo (decisions 0193 and 0195; they were
// std/llrt/xo_testing.c xo_gen_int and friends): std/rt's genInt,
// genFloat, genStr, the sized integers, Rune, Duration, and Time, over
// the generator's draws (the C runtime's xo_gen: Go's PCG, the record of
// every choice, the replay while shrinking, which stay C with the
// generator's state). The same draws in the same order as std/rt's Gen,
// so a seed gives the Go backend's values. The SSA builders call these
// for a generated value's scalars (internal/ssa build_gen.go,
// selfhost/ssa testmode.xo). The C path stays selectable
// (`XO_LLRT_C=gen` loads gen_c.xo, and the Go SSA builder calls the C
// runtime's rt.gen_any_int and friends).
use native/rt
use native/rttest

const MAX_INT: Int = 9223372036854775807
const MIN_INT: Int = -9223372036854775807 - 1

/// The runes of generated strings (std/rt's alphabet), 4 bytes each,
/// little endian, then 4 bytes so that the last one reads as a word.
const ALPHA: Bytes = b"a\x00\x00\x00b\x00\x00\x00c\x00\x00\x00x\x00\x00\x00y\x00\x00\x00z\x00\x00\x00A\x00\x00\x00B\x00\x00\x00C\x00\x00\x000\x00\x00\x001\x00\x00\x009\x00\x00\x00 \x00\x00\x00_\x00\x00\x00-\x00\x00\x00\xe9\x00\x00\x00\xbb\x03\x00\x00\x00\xf6\x01\x00\x00\x00\x00\x00"

/// The k-th rune of the alphabet (0 <= k < 18).
fn alpha(k: Int) -> Int { rt.bytes_word(ALPHA, 4 * (k & 31)) & 0xFFFFFFFF }

/// A choice in 0..n (n > 1; 0 when n <= 1, no choice), as GenRand.Intn.
fn intn(g: Int, n: Int) -> Int { rttest.gen_intn(g, n) }

/// The zigzag decoding of the UInt64 v (0, -1, 1, -2, ...).
fn zigzag(v: Int) -> Int { rt.int_wrap(4, v, 1) ^ (0 - (v & 1)) }

/// A collection's length: small, shrinking with depth (GenRand.Size).
pub fn size(g: Int) -> Int {
  let d = rttest.gen_depth(g)
  if d >= 4 {
    return 0
  }
  intn(g, 6 - d)
}

/// std/rt's genInt: small values and edges preferred (contract
/// fuzzing's small numbers are not used natively).
pub fn any_int(g: Int) -> Int {
  let c = rttest.gen_draw(g, 10)
  if c < 7 {
    return zigzag(rttest.gen_draw(g, 201))
  }
  if c == 7 {
    let k = intn(g, 5)
    return if k == 0 { 0 } else if k == 1 { 1 } else if k == 2 { -1 } else if k == 3 { MAX_INT } else { MIN_INT }
  }
  zigzag(rttest.gen_draw(g, 0))
}

/// |n|, the maximum for the minimum.
fn abs_sat(n: Int) -> Int {
  if n >= 0 {
    return n
  }
  if n == MIN_INT { MAX_INT } else { 0 - n }
}

/// A sized integer (std/rt's Gen): kind 1 Int32, 2 Int16, 3 Int8, 4
/// UInt64, 5 UInt32, 6 UInt16, 7 UInt8, in the Int word.
pub fn sized(g: Int, kind: Int) -> Int {
  let v = any_int(g)
  if kind == 1 {
    return v % 2147483648
  }
  if kind == 2 {
    return v % 32768
  }
  if kind == 3 {
    return v % 128
  }
  let a = abs_sat(v)
  if kind == 4 {
    return a
  }
  if kind == 5 {
    return a & 0xFFFFFFFF
  }
  if kind == 6 {
    return a & 0xFFFF
  }
  a & 0xFF
}

/// std/rt's genFloat: small values preferred.
pub fn float(g: Int) -> Float {
  let c = rttest.gen_draw(g, 8)
  if c < 6 {
    return Float(zigzag(rttest.gen_draw(g, 2001))) / 8.0
  }
  if c == 6 {
    let k = intn(g, 5)
    return if k == 0 { 0.0 } else if k == 1 { -0.5 } else if k == 2 { 1.0 } else if k == 3 { 1e300 } else { -1e-300 }
  }
  (Float(rttest.gen_draw(g, 9007199254740992)) / 9007199254740992.0 - 0.5) * 1000.0
}

/// A rune of the alphabet.
pub fn rune(g: Int) -> Int { alpha(intn(g, 18)) }

/// std/rt's genStr: up to 8 runes of the alphabet (Bytes are its UTF-8).
pub fn str(g: Int) -> Str {
  let n = intn(g, 9)
  var out = ""
  for _ in 0..n {
    out = rt.rs_push_rune(out, alpha(intn(g, 18)))
  }
  out
}

/// std/rt's Duration: milliseconds of genInt (wrapping as Go's int64).
pub fn duration(g: Int) -> Int { rt.int_wrap(2, any_int(g), 1000000) }

/// std/rt's Time: seconds of genInt from 2026-01-01 (wrapping).
pub fn time(g: Int) -> Int { rt.int_wrap(0, 1767225600000000000, rt.int_wrap(2, any_int(g), 1000000000)) }
