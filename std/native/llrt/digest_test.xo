
test "hmac_sha256 is RFC 2104's HMAC built byte by byte, for keys of 0 to 130 bytes" {
  // the pads read the key's words in place (key_word, zeros past its
  // end): each key length from 0 to 130 (longer than a block: hashed
  // first) against pads built a byte at a time
  var kb = BytesBuilder.with_capacity(130)
  for i in 0..130 {
    kb.write_byte(UInt8((i * 37 + 11) & 255))
  }
  let keys = kb.freeze()
  for n in 0..131 {
    let key0 = keys[0..n]
    let key = if n > 64 { sha256(key0) } else { key0 }
    var ip = BytesBuilder.with_capacity(64 + 8)
    var op = BytesBuilder.with_capacity(64 + 32)
    for i in 0..64 {
      let b = if i < key.len() { Int(key[i]) } else { 0 }
      ip.write_byte(UInt8(b ^ 0x36))
      op.write_byte(UInt8(b ^ 0x5c))
    }
    ip.write(b"message!")
    op.write(sha256(ip.freeze()))
    expect(hmac_sha256(key0, b"message!")) == sha256(op.freeze())
  }
}
