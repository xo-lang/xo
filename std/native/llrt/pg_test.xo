// std/sql's Postgres driver (decision 0278): connection strings, TLS modes,
// text values, and conversations with fake servers on FakeNet's raw
// connections (decision 0292): startup, trust and cleartext logins,
// queries, errors by SQLSTATE, and a server that goes away. The fakes
// answer with the backend messages a PostgreSQL 17 sends (recorded with
// pgx against a server in Docker; scripts/pg-diff.sh checks the driver
// against pgx itself).
use std/sql
use native/llrt/pgwire
use std/task

test "connection strings: what is refused" {
  expect(config("host=x sslmode=disable").err()) == Some(sql.SqlErr.Param(msg: "user is required: no environment is read"))
  expect(config("user=a sslrootcert=/x").is_err()) == true
  expect(config("user=a sslmode=sometimes").err()) == Some(sql.SqlErr.Param(msg: "sslmode is invalid: \"sometimes\""))
  expect(config("postgres://a@h1:1,h2:2/db?statement_timeout=5s").map(fn(c) { (c.hosts, c.ports, c.database, c.sslmode, c.params) })) ==
    Ok((["h1", "h2"], [1, 2], "db", "verify-full", [("statement_timeout", "5s")]))
}

test "a refused connection is a Conn error in every TLS mode" {
  for mode in ["disable", "prefer", "require", "verify-full"] {
    let r = sql.open(os.net, "postgres", "postgres://a@127.0.0.1:1/db?sslmode=${mode}")
    expect(r.err().map(fn(e) { e is Conn(..) })) == Some(true)
  }
}

test "an attenuated Net: an address outside its list is Conn with the spec's text" {
  let r = sql.open(os.net.only(["other.test"]), "postgres", "postgres://a@db.test:5432/db?sslmode=disable")
  expect(r.err()) == Some(sql.SqlErr.Conn(msg: "dial db.test:5432: denied by Net.only"))
}

test "values: arrays, bytea, json, floats, timestamps" {
  expect(decode_text(1007, "{1,NULL,3}")) == sql.SqlValue.Array(items: [sql.SqlValue.Integer(n: 1), sql.SqlValue.Null, sql.SqlValue.Integer(n: 3)])
  expect(decode_text(1009, "{\"a b\",\"c\\\"d\",x}")) == sql.SqlValue.Array(items: [sql.SqlValue.Text(s: "a b"), sql.SqlValue.Text(s: "c\"d"), sql.SqlValue.Text(s: "x")])
  expect(decode_text(1007, "{{1,2},{3,4}}")) == sql.SqlValue.Text(s: "{{1,2},{3,4}}")
  expect(decode_text(17, "\\x00ff")) == sql.SqlValue.Blob(b: b"\x00\xff")
  expect(decode_text(3802, "{\"k\": 1}")) == sql.SqlValue.JsonText(s: "{\"k\": 1}")
  expect(decode_text(701, "Infinity")) == sql.SqlValue.Real(f: Float.parse("inf") ?? 0.0)
  expect(decode_text(1184, "infinity")) == sql.SqlValue.Text(s: "infinity")
  expect(decode_text(1114, "2026-10-20 01:02:03")) == sql.SqlValue.At(t: Time.parse_rfc3339("2026-10-20T01:02:03Z") ?? Time.UNIX_EPOCH)
  expect(decode_text(1184, "2026-10-20 01:02:03+05:30")) == sql.SqlValue.At(t: Time.parse_rfc3339("2026-10-19T19:32:03Z") ?? Time.UNIX_EPOCH)
  expect(text_param(sql.SqlValue.Array(items: [sql.SqlValue.Text(s: "a\"b"), sql.SqlValue.Null, sql.SqlValue.Integer(n: 2)]))) == Some("{\"a\\\"b\",NULL,2}")
  expect(text_param(sql.SqlValue.Real(f: Float.parse("-inf") ?? 0.0))) == Some("-Infinity")
  expect(param_of(sql.SqlValue.Blob(b: b"\x01")).format) == 1
}

test "a fake server: rows decoded by type, and an exec's count" {
  let l = os.net.listen("db.test:5432")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_hello_trust(), fk_query_server).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"))?
    let rows = db.query("SELECT id, name, ok, at FROM t")?
    expect(rows.len()) == 2
    expect(rows[0].int("id")) == Ok(1)
    expect(rows[0].str("name")) == Ok("a")
    expect(rows[0].bool("ok")) == Ok(true)
    expect(rows[0].time("at").map(fn(t) { t.unix_millis() })) == Ok(1792499696500)
    expect(rows[1].str_opt("name")) == Ok(None)
    expect(db.exec("UPDATE t SET x = 1").map(fn(r) { r.rows_affected })) == Ok(3)
    s.cancel()
  }
}

test "server errors: a wrong parameter count is Param, other protocol violations are Server" {
  let bind: Map[Str, Str] = {"C": "08P01", "M": "bind message supplies 1 parameters, but prepared statement \"\" requires 2"}
  expect(server_err(bind)) == sql.SqlErr.Param(msg: "statement has 2 placeholders but 1 arguments were given")
  let other: Map[Str, Str] = {"C": "08P01", "M": "invalid message format"}
  expect(server_err(other)) == sql.SqlErr.Server(code: "08P01", msg: "invalid message format")
  let none: Map[Str, Str] = {"C": "42P02", "M": "there is no parameter $1"}
  expect(server_err(none)) == sql.SqlErr.Param(msg: "there is no parameter $1")
  let lost: Map[Str, Str] = {"C": "08006", "M": "connection failure"}
  expect(server_err(lost)) == sql.SqlErr.Conn(msg: "connection failure")
}

test "a fake server: errors by SQLSTATE" {
  let l = os.net.listen("db.test:5432")?
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_hello_trust(), fk_error_server).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"))?
    expect(db.exec("dup").err()) == Some(sql.SqlErr.Constraint(msg: "duplicate key value violates unique constraint \"t_name_key\"", code: "23505", name: "t_name_key"))
    expect(db.exec("syntax").err()) == Some(sql.SqlErr.Syntax(msg: "syntax error at or near \"SELEC\""))
    expect(db.exec("table").err()) == Some(sql.SqlErr.NoTable(name: "nope"))
    expect(db.exec("zero").err()) == Some(sql.SqlErr.Server(code: "22012", msg: "division by zero"))
    expect(db.exec("other").map(fn(r) { r.rows_affected })) == Ok(0)
    s.cancel()
  }
}

test "a fake server: a cleartext password from a keyword connection string" {
  let l = os.net.listen("db.test:5432")?
  let got: Mutex[List[Str]] = Mutex.new([])
  scope s {
    s.spawn_background(fn() {
      fk_serve(l, fk_auth_cleartext(), fn(kind, body) {
        if kind == "p" {
          got.with(fn(var xs) { xs.push(body[0..body.len() - 1].to_str() ?? "?") })
          return fk_auth_ok() + fk_ready()
        }
        fk_complete("") + fk_ready()
      }).ignore_err("the server stops when the test ends")
    })
    let db = sql.open(os.net, "postgres", "host=db.test port=5432 user=app password='p w' sslmode=disable")?
    expect(db.ping().is_ok()) == true
    expect(got.with(fn(xs) { xs })) == ["p w"]
    s.cancel()
  }
}

test "a fake server that goes away: the pool reconnects" {
  let l = os.net.listen("db.test:5432")?
  let calls = Atomic.new(0)
  scope s {
    s.spawn_background(fn() {
      let r = fn() -> () ! NetErr {
        while let Ok(c) = l.accept() {
          var buf = b""
          let (_, _, rest) = fk_read_msg(c, buf, true)?
          buf = rest
          c.write(fk_hello_trust())?
          while {
            let (kind, _, rest2) = fk_read_msg(c, buf, false)?
            buf = rest2
            if kind.is_empty() || kind == "X" {
              break
            }
            // the second statement: the server closes the connection
            if kind == "Q" && calls.add(1) == 2 {
              break
            }
            c.write(fk_complete("SELECT 0") + fk_ready())?
          }
          c.close()
        }
      }
      r().ignore_err("the server stops when the test ends")
    })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1)?
    expect(db.exec("x").err()) == Some(sql.SqlErr.Conn(msg: "unexpected EOF"))
    expect(db.exec("y").is_ok()) == true
    s.cancel()
  }
}

// ---- a fake backend (fk_: the messages a PostgreSQL 17 sends) ----

fn fk_be32(n: Int) -> Bytes {
  var b = BytesBuilder.with_capacity(4)
  for k in 0..4 {
    b.write_byte(UInt8((n >> (24 - 8 * k)) & 255))
  }
  b.freeze()
}

fn fk_be16(n: Int) -> Bytes { fk_be32(n)[2..] }

fn fk_get32(b: Bytes, at: Int) -> Int {
  var n = 0
  for k in 0..4 {
    n = n * 256 + Int(b[at + k])
  }
  n
}

fn fk_m(kind: Str, body: Bytes) -> Bytes { kind.bytes() + fk_be32(body.len() + 4) + body }

fn fk_cs(s: Str) -> Bytes { s.bytes() + b"\x00" }

fn fk_auth_ok() -> Bytes { fk_m("R", fk_be32(0)) }
fn fk_auth_cleartext() -> Bytes { fk_m("R", fk_be32(3)) }
fn fk_ready() -> Bytes { fk_m("Z", b"I") }
fn fk_key_data() -> Bytes { fk_m("K", fk_be32(77) + fk_be32(1234)) }
fn fk_complete(tag: Str) -> Bytes { fk_m("C", fk_cs(tag)) }

/// RowDescription with each column's name and type OID.
fn fk_row_desc(cols: List[(Str, Int)]) -> Bytes {
  var b = fk_be16(cols.len())
  for (name, oid) in cols {
    b = b + fk_cs(name) + fk_be32(0) + fk_be16(0) + fk_be32(oid) + fk_be16(-1) + fk_be32(-1) + fk_be16(0)
  }
  fk_m("T", b)
}

fn fk_data_row(vals: List[Str?]) -> Bytes {
  var b = fk_be16(vals.len())
  for v in vals {
    b = b + match v {
      Some(s) => fk_be32(s.len()) + s.bytes()
      None => fk_be32(-1)
    }
  }
  fk_m("D", b)
}

fn fk_error_resp(code: Str, msg: Str, constraint: Str) -> Bytes {
  var b = fk_cs("SERROR") + fk_cs("C" + code) + fk_cs("M" + msg)
  if !constraint.is_empty() {
    b = b + fk_cs("n" + constraint)
  }
  fk_m("E", b + b"\x00")
}

/// Reads one frontend message (or the startup packet when untyped) from c.
fn fk_read_msg(c: ServerConn, var buf: Bytes, untyped: Bool) -> (Str, Bytes, Bytes) ! NetErr {
  while {
    let need = if untyped { 4 } else { 5 }
    if buf.len() >= need {
      let n = if untyped { fk_get32(buf, 0) } else { 1 + fk_get32(buf, 1) }
      if buf.len() >= n {
        let kind = if untyped { "" } else { buf[0..1].to_str() ?? "?" }
        let body = if untyped { buf[4..n] } else { buf[5..n] }
        return (kind, body, buf[n..])
      }
    }
    match c.read(4096)? {
      Some(b) => buf = buf + b
      None => return ("", b"", b"")
    }
  }
  ("", b"", b"")
}

/// A fake server: after startup, answer(kind, body) gives the bytes for
/// each message; the conversation ends at Terminate or end of stream.
fn fk_serve(l: Listener, hello: Bytes, answer: fn(Str, Bytes) -> Bytes) -> () ! NetErr {
  while let Ok(c) = l.accept() {
    var buf = b""
    let (_, _, rest) = fk_read_msg(c, buf, true)?
    buf = rest
    c.write(hello)?
    while {
      let (kind, body, rest2) = fk_read_msg(c, buf, false)?
      buf = rest2
      if kind.is_empty() || kind == "X" {
        break
      }
      let out = answer(kind, body)
      if out.is_empty() {
        continue
      }
      c.write(out)?
    }
    c.close()
  }
}

fn fk_hello_trust() -> Bytes { fk_auth_ok() + fk_key_data() + fk_ready() }

fn fk_dsn(addr: Str) -> Str { "postgres://app@${addr}/app?sslmode=disable" }

fn fk_query_server(kind: Str, body: Bytes) -> Bytes {
  if kind != "Q" {
    return b""
  }
  let q = body[0..body.len() - 1].to_str() ?? ""
  if q.starts_with("SELECT") {
    return fk_row_desc([("id", 23), ("name", 25), ("ok", 16), ("at", 1184)]) +
      fk_data_row([Some("1"), Some("a"), Some("t"), Some("2026-10-20 12:34:56.5+00")]) +
      fk_data_row([Some("2"), None, Some("f"), None]) + fk_complete("SELECT 2") + fk_ready()
  }
  fk_complete("UPDATE 3") + fk_ready()
}

fn fk_error_server(kind: Str, body: Bytes) -> Bytes {
  if kind != "Q" {
    return b""
  }
  let q = body[0..body.len() - 1].to_str() ?? ""
  match q {
    "-- ping" => fk_complete("") + fk_ready()
    "dup" => fk_error_resp("23505", "duplicate key value violates unique constraint \"t_name_key\"", "t_name_key") + fk_ready()
    "syntax" => fk_error_resp("42601", "syntax error at or near \"SELEC\"", "") + fk_ready()
    "table" => fk_error_resp("42P01", "relation \"nope\" does not exist", "") + fk_ready()
    "zero" => fk_error_resp("22012", "division by zero", "") + fk_ready()
    _ => fk_complete("SELECT 0") + fk_ready()
  }
}

/// A server that takes a COPY, refuses its first CopyData with an error and
/// discards the rest up to CopyDone, as PostgreSQL does for a bad row.
fn fk_copy_refuse(seen: Atomic[Int]) -> fn(Str, Bytes) -> Bytes {
  fn(kind: Str, body: Bytes) -> Bytes {
    if kind == "Q" {
      if (body.to_str() ?? "").starts_with("COPY") {
        return fk_m("G", b"\x00" + fk_be16(0))
      }
      return fk_complete("") + fk_ready()
    }
    if kind == "d" {
      if seen.add(1) == 1 {
        return fk_error_resp("22P04", "extra data after last expected column", "")
      }
      return b""
    }
    if kind == "c" || kind == "f" {
      return fk_ready()
    }
    b""
  }
}

test "copy_from stops calling rows once the server refuses the COPY, and returns the server's error (b: pg COPY refusal)" {
  let l = os.net.listen("db.test:5432")?
  let seen = Atomic.new(0)
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_hello_trust(), fk_copy_refuse(seen)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"))?
    let calls = Atomic.new(0)
    let total = 400000
    let r = db.copy_from("t", ["a", "b"], fn() {
      let i = calls.add(1)
      if i >= total {
        return Ok(None)
      }
      Ok(Some([sql.int(i), sql.str("some text for row ${i}")]))
    })
    match r {
      Err(e) => {
        if !"${e}".contains("extra data after last expected column") {
          fault("expected the server's error, got ${e}")
        }
      }
      Ok(n) => fault("expected an error, copied ${n}")
    }
    if calls.get() >= total {
      fault("rows was called for every row after the server refused")
    }
    s.cancel()
  }
}

test "column_types is pgx stdlib's ColumnType* from each field's OID and modifier (decision 0609)" {
  let f = fn(name: Str, oid: Int, m: Int) -> pgwire.Field { pgwire.Field{name: name, table_oid: 0, column: 0, type_oid: oid, size: -1, modifier: m, format: 0} }
  let ts = column_types([f("v", 1043, 24), f("c", 1042, 9), f("n", 1700, (10 << 16 | 2) + 4), f("t", 25, -1), f("i", 23, -1), f("a", 1007, -1), f("x", 99999, -1), f("vb", 1562, 8), f("u", 1043, -1)])
  expect(ts.map(fn(t) { t.database_type })) == ["VARCHAR", "BPCHAR", "NUMERIC", "TEXT", "INT4", "_INT4", "99999", "VARBIT", "VARCHAR"]
  expect(ts.map(fn(t) { t.length })) == [Some(20), Some(5), None, Some(Int.max), None, None, None, Some(8), Some(-5)]
  expect((ts[2].precision, ts[2].scale)) == (Some(10), Some(2))
  expect(ts.map(fn(t) { t.kind })) == ["Text", "Text", "Text", "Text", "Integer", "Array", "Text", "Text", "Text"]
  expect(ts.all(fn(t) { t.nullable is None })) == true
}

/// The cstr of b at `at`, and where it ends.
fn fk_cstr_at(b: Bytes, at: Int) -> (Str, Int) {
  var i = at
  while i < b.len() && b[i] != 0 {
    i += 1
  }
  (b[at..i].to_str() ?? "", i + 1)
}

/// The extended protocol of a named statement (decision 0648 stage D), each
/// message logged, and a ; separated script on the simple protocol giving
/// two result sets around an UPDATE.
fn fk_stmt_server(log: Mutex[List[Str]]) -> fn(Str, Bytes) -> Bytes {
  fn(kind, body) {
    match kind {
      "P" => {
        let (name, at) = fk_cstr_at(body, 0)
        let (q, _) = fk_cstr_at(body, at)
        log.with(fn(var xs) { xs.push("parse ${name} ${q}") })
        if q.starts_with("BAD") {
          return fk_error_resp("42601", "syntax error at or near \"BAD\"", "")
        }
        fk_m("1", b"")
      }
      "D" => {
        let (name, _) = fk_cstr_at(body, 1)
        if body[0..1] == b"S" {
          // one int8 parameter, one text column
          return fk_m("t", fk_be16(1) + fk_be32(20)) + fk_row_desc([("name", 25)])
        }
        let _ = name
        fk_row_desc([("name", 25)])
      }
      "B" => {
        let (portal, at) = fk_cstr_at(body, 0)
        let (st, at2) = fk_cstr_at(body, at)
        let nf = fk_get32(b"\x00\x00" + body[at2..at2 + 2], 0)
        let at3 = at2 + 2 + 2 * nf
        let np = fk_get32(b"\x00\x00" + body[at3..at3 + 2], 0)
        log.with(fn(var xs) { xs.push("bind '${portal}' ${st} ${np} params") })
        fk_m("2", b"")
      }
      "E" => fk_data_row([Some("a")]) + fk_complete("SELECT 1")
      "C" => {
        let (name, _) = fk_cstr_at(body, 1)
        log.with(fn(var xs) { xs.push("close ${body[0..1].to_str() ?? "?"} ${name}") })
        fk_m("3", b"")
      }
      "S" => fk_ready()
      "Q" => {
        let q = body[0..body.len() - 1].to_str() ?? ""
        log.with(fn(var xs) { xs.push("query ${q}") })
        fk_row_desc([("a", 23)]) + fk_data_row([Some("1")]) + fk_complete("SELECT 1") + fk_complete("UPDATE 3") +
          fk_row_desc([("b", 25)]) + fk_data_row([Some("x")]) + fk_data_row([Some("y")]) + fk_complete("SELECT 2") + fk_ready()
      }
      _ => b""
    }
  }
}

test "a fake server: a named statement is parsed once, bound per run, and closed; a script's first set, and query_all's every set" {
  let l = os.net.listen("db.test:5432")?
  let log: Mutex[List[Str]] = Mutex.new([])
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_hello_trust(), fk_stmt_server(log)).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1)?
    let st = db.prepare("SELECT name FROM t WHERE id = $1")?
    expect(st.query_one([sql.int(1)])?.str("name")) == Ok("a")
    expect(st.exec([sql.int(2)])?.rows_affected) == 1
    expect(st.query([]).err()) == Some(sql.SqlErr.Param(msg: "the statement has 1 placeholders and 0 arguments"))
    st.close()
    expect(db.prepare("BAD").err()) == Some(sql.SqlErr.Syntax(msg: "syntax error at or near \"BAD\""))
    let q = "SELECT 1 AS a; UPDATE t SET n = 1; SELECT b FROM t"
    let rows = db.query(q)?
    expect(rows.len()) == 1
    expect(rows[0].int("a")) == Ok(1)
    let sets = db.query_all(q)?
    expect(sets.map(fn(x) { x.columns() })) == [["a"], ["b"]]
    expect(sets[1].rows().map(fn(r) { r.str("b").or_fault("b") })) == ["x", "y"]
    expect(log.with_read(fn(xs) { xs })) == ["query -- ping", "parse xo_s1 SELECT name FROM t WHERE id = $1", "bind '' xo_s1 1 params", "bind '' xo_s1 1 params", "close S xo_s1", "parse xo_s2 BAD", "query ${q}", "query ${q}"]
    s.cancel()
  }
}

/// One connection of fk_cancel_serve: a CancelRequest's pid and secret
/// go to seen as "cancel PID SECRET"; a query's text goes to seen, and a
/// pg_sleep gets no answer (the server is busy until the client goes).
fn fk_cancel_conn(c: ServerConn, seen: Chan[Str]) -> () ! NetErr {
  var buf = b""
  let (_, start, rest) = fk_read_msg(c, buf, true)?
  if start.len() >= 12 && fk_get32(start, 0) == 80877102 {
    seen.send("cancel ${fk_get32(start, 4)} ${fk_get32(start, 8)}")
    c.close()
    return Ok(())
  }
  buf = rest
  c.write(fk_hello_trust())?
  while {
    let (kind, body, rest2) = fk_read_msg(c, buf, false)?
    buf = rest2
    if kind.is_empty() || kind == "X" {
      break
    }
    if kind == "Q" {
      let q = body[0..body.len() - 1].to_str() ?? ""
      seen.send(q)
      if q.starts_with("SELECT pg_sleep") {
        continue
      }
    }
    c.write(fk_complete("SELECT 0") + fk_ready())?
  }
  c.close()
  Ok(())
}

fn fk_cancel_serve(l: Listener, seen: Chan[Str]) -> () ! NetErr {
  scope s {
    while let Ok(c) = l.accept() {
      s.spawn_background(fn() { fk_cancel_conn(c, seen).ignore_err("a connection ends with the test") })
    }
  }
  Ok(())
}

test "a cancelled query: a CancelRequest with the connection's key on a second connection" {
  let l = os.net.listen("db.test:5432")?
  let seen = Chan[Str].new(8)
  scope s {
    s.spawn_background(fn() { fk_cancel_serve(l, seen).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"))?
    scope q {
      q.spawn(fn() { db.exec("SELECT pg_sleep(60)") })
      // the pool's ping of a new connection comes first
      expect(seen.recv()) == Some("-- ping")
      expect(seen.recv()) == Some("SELECT pg_sleep(60)")
      q.cancel()
    }
    // fk_key_data: pid 77, secret 1234
    expect(seen.recv()) == Some("cancel 77 1234")
    s.cancel()
  }
}

// ---- LISTEN/NOTIFY and notices (decision 0648 item 14): pgx v5.12.0's
// conn_test.go TestListenNotify and TestListenNotifySelfNotification,
// pgconn_test.go TestConnOnNotice and TestConnWaitForNotificationTimeout,
// against fake servers that send NotificationResponse and NoticeResponse
// where a PostgreSQL 17 does: inside a result, after ReadyForQuery, and
// on an idle connection.

fn fk_notification(pid: Int, channel: Str, payload: Str) -> Bytes { fk_m("A", fk_be32(pid) + fk_cs(channel) + fk_cs(payload)) }

fn fk_notice(severity: Str, msg: Str) -> Bytes {
  fk_m("N", fk_cs("S" + severity) + fk_cs("V" + severity) + fk_cs("C00000") + fk_cs("M" + msg) + fk_cs("Hsee the log") + b"\x00")
}

fn fk_notify_server(kind: Str, body: Bytes) -> Bytes {
  if kind != "Q" {
    return b""
  }
  let q = body[0..body.len() - 1].to_str() ?? ""
  if q.starts_with("LISTEN") || q.starts_with("UNLISTEN") {
    return fk_complete(q.split(" ")[0]) + fk_ready()
  }
  if q == "do $$ begin raise notice 'hello, world'; end$$" {
    // a notification of another backend arrives in the middle of a result
    return fk_notification(99, "chat", "early") + fk_notice("NOTICE", "hello, world") + fk_complete("DO") + fk_ready()
  }
  if q == "notify self" {
    // the server sends a backend's own notification after ReadyForQuery
    return fk_complete("NOTIFY") + fk_ready() + fk_notification(77, "self", "")
  }
  fk_complete("SELECT 0") + fk_ready()
}

test "pgx TestListenNotifySelfNotification and TestConnOnNotice: a notification read during another call is kept, one after ReadyForQuery too, and notices reach on_notice in order" {
  let l = os.net.listen("db.test:5432")?
  let got: Mutex[List[sql.Notice]] = Mutex.new([])
  scope s {
    s.spawn_background(fn() { fk_serve(l, fk_hello_trust(), fk_notify_server).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1, on_notice: Some(fn(n: sql.Notice) { got.with(fn(var xs) { xs.push(n) }) }))?
    let c = db.conn()?
    c.listen("chat")?
    c.exec("do $$ begin raise notice 'hello, world'; end$$")?
    expect(got.with_read(fn(xs) { xs })) == [sql.Notice{severity: "NOTICE", code: "00000", message: "hello, world", hint: "see the log"}]
    expect(c.wait_notification()?) == sql.Notification{pid: 99, channel: "chat", payload: "early"}
    c.listen("self")?
    c.exec("notify self")?
    expect(c.wait_notification()?) == sql.Notification{pid: 77, channel: "self", payload: ""}
    c.close()
    // UNLISTEN * at close, and the connection is the pool's again
    db.exec("SELECT 1")?
    s.cancel()
  }
}

/// fk_serve with a second writer: each Bytes sent on push goes to the
/// client as it comes, between answers (a NOTIFY of another backend).
fn fk_push_serve(l: Listener, push: Chan[Bytes]) -> () ! NetErr {
  while let Ok(c) = l.accept() {
    var buf = b""
    let (_, _, rest) = fk_read_msg(c, buf, true)?
    buf = rest
    c.write(fk_hello_trust())?
    scope w {
      w.spawn_background(fn() {
        while let Some(b) = push.recv() {
          if c.write(b).is_err() {
            break
          }
        }
      })
      while {
        let (kind, body, rest2) = fk_read_msg(c, buf, false)?
        buf = rest2
        if kind.is_empty() || kind == "X" {
          break
        }
        let out = fk_notify_server(kind, body)
        if !out.is_empty() {
          c.write(out)?
        }
      }
      w.cancel()
    }
    c.close()
  }
}

test "pgx TestListenNotify and TestConnWaitForNotificationTimeout: a timed out wait leaves the connection usable, and the next wait reads the server's notification" {
  let l = os.net.listen("db.test:5432")?
  let push = Chan[Bytes].new(4)
  scope s {
    s.spawn_background(fn() { fk_push_serve(l, push).ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1)?
    let c = db.conn()?
    c.listen("chat")?
    let r = task.with_timeout(os.clock, 20ms, fn() { c.wait_notification() })
    expect(r.err().map(fn(e) { e is TimedOut })) == Some(true)
    c.exec("SELECT 1")?
    push.send(fk_notification(5, "chat", "after"))
    expect(c.wait_notification()?) == sql.Notification{pid: 5, channel: "chat", payload: "after"}
    c.close()
    s.cancel()
  }
}

/// A pipeline's server (decision 0648 item 15), each message logged by
/// kind: Parse (with its query), Bind, Describe, Execute, Sync and Flush.
/// It answers as PostgreSQL does in the extended protocol: after an
/// ErrorResponse it skips every message until Sync. A query "BAD..." fails
/// at Parse; "DEFER..." fails at its batch's Sync, as a deferred
/// constraint fails at the implicit commit; a SELECT gives one int4 row
/// of 7, an INSERT "INSERT 0 1".
fn fk_pipe_server(log: Mutex[List[Str]], skipping: Atomic[Bool], last: Mutex[Str], deferred: Atomic[Bool]) -> fn(Str, Bytes) -> Bytes {
  fn(kind, body) {
    let q = last.with_read(fn(s) { s })
    match kind {
      "Q" => {
        log.with(fn(var xs) { xs.push("Q") })
        fk_complete("SELECT 0") + fk_ready()
      }
      "S" => {
        log.with(fn(var xs) { xs.push("S") })
        skipping.set(false)
        if deferred.get() {
          deferred.set(false)
          return fk_error_resp("23505", "duplicate key value violates unique constraint \"t_pkey\"", "t_pkey") + fk_ready()
        }
        fk_ready()
      }
      "H" => {
        log.with(fn(var xs) { xs.push("H") })
        b""
      }
      _ => {
        if skipping.get() {
          log.with(fn(var xs) { xs.push("skip ${kind}") })
          return b""
        }
        match kind {
          "P" => {
            let (_, at) = fk_cstr_at(body, 0)
            let (text, _) = fk_cstr_at(body, at)
            last.with(fn(var s) { s = text })
            log.with(fn(var xs) { xs.push("P ${text}") })
            if text.starts_with("BAD") {
              skipping.set(true)
              return fk_error_resp("42601", "syntax error at or near \"BAD\"", "")
            }
            if text.starts_with("DEFER") {
              deferred.set(true)
            }
            fk_m("1", b"")
          }
          "B" => {
            log.with(fn(var xs) { xs.push("B") })
            fk_m("2", b"")
          }
          "D" => {
            log.with(fn(var xs) { xs.push("D") })
            let shape = if q.starts_with("SELECT") { fk_row_desc([("n", 23)]) } else { fk_m("n", b"") }
            if body.len() > 0 && body[0] == 83 {
              // Describe Statement: its parameters (int4 each) first
              let n = q.split("$").len() - 1
              var ps = fk_be16(n)
              for _ in 0..n {
                ps = ps + fk_be32(23)
              }
              return fk_m("t", ps) + shape
            }
            shape
          }
          "E" => {
            log.with(fn(var xs) { xs.push("E") })
            if q.starts_with("SELECT") { fk_data_row([Some("7")]) + fk_complete("SELECT 1") } else { fk_complete("INSERT 0 1") }
          }
          _ => b""
        }
      }
    }
  }
}

fn fk_pipe_db(l: Listener, log: Mutex[List[Str]]) -> fn() -> () ! NetErr uses net.listen {
  let skipping = Atomic.new(false)
  let last: Mutex[Str] = Mutex.new("")
  let deferred = Atomic.new(false)
  fn() { fk_serve(l, fk_hello_trust(), fk_pipe_server(log, skipping, last, deferred)) }
}

fn fk_take_log(log: Mutex[List[Str]]) -> List[Str] {
  log.with(fn(var xs) {
    let all = xs
    xs = []
    all
  })
}

test "pgx TestConnSendBatch on a fake server: every query's Parse, Bind, Describe and Execute, one Sync, and a set per query with its rows and count" {
  let log: Mutex[List[Str]] = Mutex.new([])
  let serve = fk_pipe_db(os.net.listen("db.test:5432")?, log)
  scope s {
    s.spawn_background(fn() { serve().ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1)?
    let _ = fk_take_log(log)
    let sets = db.batch([
      sql.BatchQuery{query: "INSERT INTO t (n) VALUES ($1)", args: [sql.int(1)]},
      sql.BatchQuery{query: "SELECT n FROM t"},
      sql.BatchQuery{query: "INSERT INTO t (n) VALUES ($1)", args: [sql.str("2")]},
    ])?
    expect(sets.map(fn(x) { x.rows_affected() })) == [1, 1, 1]
    expect(sets[1].columns()) == ["n"]
    expect(sets[1].rows()[0].int("n")) == Ok(7)
    expect(sets[0].columns()) == []
    expect(fk_take_log(log)) == ["P INSERT INTO t (n) VALUES ($1)", "B", "D", "E", "P SELECT n FROM t", "B", "D", "E", "P INSERT INTO t (n) VALUES ($1)", "B", "D", "E", "S"]
    // an empty batch sends nothing
    expect(db.batch([])?.len()) == 0
    expect(fk_take_log(log)) == []
    s.cancel()
  }
}

test "pgconn Pipeline on a fake server: a Sync per batch, an error skips the rest of its batch only, and an error at the Sync fails its batch" {
  let log: Mutex[List[Str]] = Mutex.new([])
  let serve = fk_pipe_db(os.net.listen("db.test:5432")?, log)
  scope s {
    s.spawn_background(fn() { serve().ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1)?
    let _ = fk_take_log(log)
    let outs = db.pipeline([
      [sql.BatchQuery{query: "INSERT a"}],
      [sql.BatchQuery{query: "BAD"}, sql.BatchQuery{query: "INSERT b"}],
      [sql.BatchQuery{query: "DEFER c"}],
      [sql.BatchQuery{query: "SELECT d"}],
    ])?
    expect(outs.len()) == 4
    expect(outs[0].map(fn(xs) { xs.len() })) == Ok(1)
    expect(outs[1].err()) == Some(sql.SqlErr.Syntax(msg: "syntax error at or near \"BAD\""))
    expect(outs[2].err()) == Some(sql.SqlErr.Constraint(msg: "duplicate key value violates unique constraint \"t_pkey\"", code: "23505", name: "t_pkey"))
    expect(outs[3].map(fn(xs) { xs[0].rows()[0].int("n").or_fault("n") })) == Ok(7)
    expect(fk_take_log(log)) == ["P INSERT a", "B", "D", "E", "S", "P BAD", "skip B", "skip D", "skip E", "skip P", "skip B", "skip D", "skip E", "S", "P DEFER c", "B", "D", "E", "S", "P SELECT d", "B", "D", "E", "S"]
    // the connection is in step: the next call works
    expect(db.batch([sql.BatchQuery{query: "SELECT e"}])?.len()) == 1
    s.cancel()
  }
}

test "a pipeline larger than a window: windows end with a Flush, every result comes back, and an error read in one window leaves the batch's later queries unsent" {
  let log: Mutex[List[Str]] = Mutex.new([])
  let serve = fk_pipe_db(os.net.listen("db.test:5432")?, log)
  let pad = "x".repeat(200)
  var big: List[sql.BatchQuery] = []
  for i in 0..400 {
    big.push(sql.BatchQuery{query: "INSERT INTO t (n, pad) VALUES ($1, $2)", args: [sql.int(i), sql.str(pad)]})
  }
  scope s {
    s.spawn_background(fn() { serve().ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1)?
    let _ = fk_take_log(log)
    let sets = db.batch(big)?
    expect(sets.len()) == 400
    let l1 = fk_take_log(log)
    expect(l1.filter(fn(x) { x == "H" }).len() >= 2) == true
    expect(l1.filter(fn(x) { x.starts_with("P ") }).len()) == 400
    expect(l1.last()) == Some("S")
    var bad = [sql.BatchQuery{query: "BAD"}]
    for x in big {
      bad.push(x)
    }
    let outs = db.pipeline([bad, [sql.BatchQuery{query: "SELECT after"}]])?
    expect(outs[0].err()) == Some(sql.SqlErr.Syntax(msg: "syntax error at or near \"BAD\""))
    expect(outs[1].map(fn(xs) { xs.len() })) == Ok(1)
    let l2 = fk_take_log(log)
    // the first window's queries after BAD reach the server, which skips
    // them; the later windows send only the batch's Sync
    let skipped = l2.filter(fn(x) { x == "skip P" }).len()
    expect(skipped > 0 && skipped < 400) == true
    expect(l2.filter(fn(x) { x == "S" }).len()) == 2
    s.cancel()
  }
}

fn fk_trace_line(r: sql.TraceRecord) -> Str {
  let op = match r.op {
    sql.TraceOp.Connect => "Connect"
    sql.TraceOp.Acquire => "Acquire"
    sql.TraceOp.Release => "Release"
    sql.TraceOp.Query => "Query"
    sql.TraceOp.Exec => "Exec"
    sql.TraceOp.Prepare => "Prepare"
    sql.TraceOp.BatchQuery => "BatchQuery"
    sql.TraceOp.Batch => "Batch"
    sql.TraceOp.CopyFrom => "CopyFrom"
  }
  let q = if r.query == "" { "" } else { " ${r.query}" }
  let e = if r.err.is_some() { " err" } else { "" }
  "${op}${q} n=${r.rows_affected}${e}"
}

test "pgx's QueryTracer, BatchTracer and PrepareTracer and pgxpool's AcquireTracer on a fake server: a record as each operation ends, a cursor's at its end, and Db.stats" {
  let log: Mutex[List[Str]] = Mutex.new([])
  let got: Mutex[List[Str]] = Mutex.new([])
  let serve = fk_pipe_db(os.net.listen("db.test:5432")?, log)
  scope s {
    s.spawn_background(fn() { serve().ignore_err("the server stops when the test ends") })
    let db = sql.open(os.net, "postgres", fk_dsn("db.test:5432"), max_open: 1, on_trace: Some(fn(r: sql.TraceRecord) { got.with(fn(var xs) { xs.push(fk_trace_line(r)) }) }))?
    expect(fk_take_log(got)) == ["Connect n=0", "Acquire n=0", "Release n=0"]
    expect(db.query("SELECT n FROM t WHERE n = $1", [sql.int(7)])?.len()) == 1
    expect(fk_take_log(got)) == ["Acquire n=0", "Query SELECT n FROM t WHERE n = $1 n=1", "Release n=0"]
    expect(db.exec("INSERT INTO t (n) VALUES ($1)", [sql.int(1)])?.rows_affected) == 1
    expect(fk_take_log(got)) == ["Acquire n=0", "Exec INSERT INTO t (n) VALUES ($1) n=1", "Release n=0"]
    // a cursor's record comes at its end, with the rows read
    let rows = db.rows("SELECT n FROM t WHERE n > $1", [sql.int(0)])?
    expect(rows.next()?.is_some()) == true
    expect(rows.next()?.is_some()) == false
    rows.close()
    expect(fk_take_log(got).filter(fn(x) { x.starts_with("Query") })) == ["Query SELECT n FROM t WHERE n > $1 n=1"]
    let st = db.prepare("SELECT n FROM t WHERE n = $1")?
    expect(st.query([sql.int(7)])?.len()) == 1
    st.close()
    expect(fk_take_log(got).filter(fn(x) { !x.starts_with("Acquire") && !x.starts_with("Release") })) == ["Prepare SELECT n FROM t WHERE n = $1 n=0", "Query SELECT n FROM t WHERE n = $1 n=1"]
    let outs = db.pipeline([[sql.BatchQuery{query: "INSERT a"}, sql.BatchQuery{query: "SELECT b"}], [sql.BatchQuery{query: "BAD"}]])?
    expect(outs.len()) == 2
    expect(fk_take_log(got)) == ["Acquire n=0", "BatchQuery INSERT a n=1", "BatchQuery SELECT b n=1", "Batch n=2 err", "Release n=0"]
    let ps = db.stats()
    expect((ps.max_open, ps.open, ps.idle, ps.in_use, ps.new_conns)) == (1, 1, 1, 0, 1)
    expect(ps.acquire_count >= 6) == true
    s.cancel()
  }
}
