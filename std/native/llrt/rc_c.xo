// The C path of the reference counts (decision 0207 stage 2): the API of
// rc.xo over the C runtime's copies (std/llrt/xo_rt.c rc_inc and
// friends, compiled with -DXO_RC_C, which also makes the C call its own
// copies instead of the exports). Loaded in place of rc.xo when
// XO_LLRT_C names `rc`.
use native/rt

pub fn inc(p: Int) { rt.rc_inc_c(p) }

pub fn dec_shared(p: Int) -> Int { rt.rc_dec_shared_c(p) }

pub fn dec(p: Int) -> Int { rt.rc_dec_c(p) }

pub fn claim(p: Int) -> Int { rt.rc_claim_c(p) }

pub fn mark(p: Int) -> Int { rt.rc_mark_c(p) }
