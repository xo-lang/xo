// std/native/llrt/mysqlauth.xo's tests: the scrambles of MySQL's
// documented formulas, with vectors from Python's hashlib (an independent
// implementation; decision 0648). The conformance run logs in to a real
// server with each plugin.

const NONCE: Bytes = b"abcdefghijklmnopqrst"

test "mysql_native_password's scramble" {
  expect(native_scramble(b"secret", NONCE).to_hex()) == "8817c50fa779daef010ee7577825b0847df9842e"
  expect(native_scramble(b"", NONCE)) == b""
}

test "caching_sha2_password's scramble" {
  expect(sha2_scramble(b"secret", NONCE).to_hex()) == "c76e2898612a4cf042c77fa8c4702c4c64c0c2c557c53c4d75595aaa6abae809"
  expect(sha2_scramble(b"", NONCE)) == b""
}

test "the RSA plaintext and the first responses" {
  expect(rsa_plain(b"secret", NONCE).to_hex()) == "12070016001267"
  expect(first_response("caching_sha2_password", b"secret", NONCE, false)) == Some(sha2_scramble(b"secret", NONCE))
  expect(first_response("mysql_native_password", b"secret", NONCE, false)) == Some(native_scramble(b"secret", NONCE))
  expect(first_response("mysql_clear_password", b"secret", NONCE, false)) == Some(b"secret\x00")
  expect(first_response("sha256_password", b"secret", NONCE, true)) == Some(b"secret\x00")
  expect(first_response("sha256_password", b"secret", NONCE, false)) == Some(b"\x01")
  expect(first_response("mysql_old_password", b"secret", NONCE, false)) == None
}

// A 2048 bit key made with openssl for these tests (no secret: only its
// public half is here), as SubjectPublicKeyInfo and as PKCS #1.
const TEST_PUB: Str = "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAzHAfUq9Zk7ARuV0WMBlW\nmOTGHjn9AtiNrKYEZ1QxSyenr548P4E+GRcZa+QR2bCK23+ynyxpt8yAdUjFbWBb\nxWgFOrBBYNpBR5jQxBRMbVreqnUUCe5nsHSAxulHaJDmjFV8d+VqMKEPak2jeXP1\nhc6zWSRdRFNwTnujXe3A77ANMJ6YG4BlLiQJ1ShyIwSN+DLXI2PMZAlgz8AvnoLr\nPH6R17YTwiPj525pDACUPV//JnUodBijLHAITnkkidnunezvjGakMpKzfJBRX8Qm\nqCGyteyKaEp+HBz9dwobGTBg/gZywmh2ibba6Lpf3zN0lfkc3vEJq5tIf/dITh2i\nGwIDAQAB\n-----END PUBLIC KEY-----"
const TEST_PUB1: Str = "-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEAzHAfUq9Zk7ARuV0WMBlWmOTGHjn9AtiNrKYEZ1QxSyenr548P4E+\nGRcZa+QR2bCK23+ynyxpt8yAdUjFbWBbxWgFOrBBYNpBR5jQxBRMbVreqnUUCe5n\nsHSAxulHaJDmjFV8d+VqMKEPak2jeXP1hc6zWSRdRFNwTnujXe3A77ANMJ6YG4Bl\nLiQJ1ShyIwSN+DLXI2PMZAlgz8AvnoLrPH6R17YTwiPj525pDACUPV//JnUodBij\nLHAITnkkidnunezvjGakMpKzfJBRX8QmqCGyteyKaEp+HBz9dwobGTBg/gZywmh2\nibba6Lpf3zN0lfkc3vEJq5tIf/dITh2iGwIDAQAB\n-----END RSA PUBLIC KEY-----"

test "RSA full authentication: the server's PEM key, OAEP with SHA-1" {
  let k = pem_public_key(TEST_PUB.bytes()) ?? fault("SPKI key")
  let k1 = pem_public_key(TEST_PUB1.bytes()) ?? fault("PKCS #1 key")
  expect(k.n == k1.n && k.e == k1.e) == true
  expect(k.n.len()) == 256
  // Go 1.26's rsa.EncryptOAEP(sha1, seed 0x5a x 20) of rsa_plain("secret",
  // "abcdefghijklmnopqrst"); openssl pkeyutl decrypts it with the private key
  let want = Bytes.from_hex("") ?? b""
  expect(rsa_password_seeded(b"secret", b"abcdefghijklmnopqrst", k, b"Z".repeat(20))) == Some(want)
  // a fresh seed each time: another ciphertext of the same length
  let a = rsa_password(b"secret", b"abcdefghijklmnopqrst", k) ?? b""
  expect(a.len()) == 256
  expect(a != want) == true
  expect(pem_public_key(b"-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n")) == None
  expect(pem_public_key(b"no pem here")) == None
  expect(pem_public_key(b"-----BEGIN PUBLIC KEY-----\n!!!\n-----END PUBLIC KEY-----\n")) == None
}
