// Tests of flate.xo's CRC-32 (`xo test --std-module=native/llrt/flate`,
// run by internal/stdtest): hash/crc32's IEEE values (computed with zlib's
// crc32, the same polynomial), through the word path a CPU with crc32x
// takes (decision 0231 addendum) and the slicing path, whole and in pieces.


const CRC_CASES: List[(Str, Int)] = [
  ("", 0),
  ("a", 3904355907),
  ("ab", 2659403885),
  ("abc", 891568578),
  ("abcdefg", 824863398),
  ("abcdefgh", 2934909520),
  ("abcdefghi", 2376698031),
  ("123456789", 3421780262),
  ("Discard medicine more than two years old.", 1805443047),
  ("He who has a shady past knows that nice guys finish last.", 3373201215),
  ("The quick brown fox jumps over the lazy dog, then the lazy dog sleeps for a long, long time.", 3738247350),
]

test "crc32 is hash/crc32's IEEE CRC, whole and continued" {
  let t = crc_table()
  for (s, want) in CRC_CASES {
    expect(crc32(t, 0, s.bytes())) == want
    // continued from a split at every offset, as gzip's writer does
    let b = s.bytes()
    for k in 0..b.len() + 1 {
      expect(crc32(t, crc32(t, 0, b[0..k]), b[k..b.len()])) == want
    }
  }
}

test "crc32 over every byte value, and crc32_list agrees" {
  let t = crc_table()
  var bb = BytesBuilder.new()
  var l: List[UInt8] = []
  for _ in 0..5 {
    for v in 0..256 {
      bb.write_byte(UInt8(v))
      l.push(UInt8(v))
    }
  }
  let b = bb.freeze()
  expect(crc32(t, 0, b)) == 511339812
  expect(crc32_list(t, 0, l, 0, l.len())) == 511339812
  expect(crc32_list(t, crc32_list(t, 0, l, 0, 7), l, 7, l.len())) == 511339812
}

test "CRC_TABLE is hash/crc32's slicing-by-8 table of 0xedb88320" {
  var t: List[Int] = []
  for i in 0..256 {
    var c = i
    for _ in 0..8 {
      c = if (c & 1) == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 }
    }
    t.push(c)
  }
  for i in 256..2048 {
    let p = t[i - 256]
    t.push((p >> 8) ^ t[p & 255])
  }
  expect(crc_table()) == t
}

test "the constant fixed decoder is what hdec_init builds" {
  let a = fixed_decoder()
  let b = fixed_decoder_built()
  expect(a.min) == b.min
  expect(a.chunks) == b.chunks
  expect(a.links.len()) == b.links.len()
  expect(a.link_mask) == b.link_mask
}

/// A gzip member of body with a name of n bytes, from flate's own writer.
fn gz_named(n: Int, body: Bytes) -> Bytes {
  var g = BytesBuilder.new()
  g.write(b"\x1f\x8b\x08\x08\x00\x00\x00\x00\x00\xff")
  for _ in 0..n {
    g.write_byte(0x6e)
  }
  g.write_byte(0)
  g.write(deflate_level(body, -1))
  let c = crc32(crc_table(), 0, body)
  for k in 0..4 {
    g.write_byte(UInt8((c >> (8 * k)) & 255))
  }
  for k in 0..4 {
    g.write_byte(UInt8((body.len() >> (8 * k)) & 255))
  }
  g.freeze()
}

test "a stream cut across pushes gives its output as soon as the input holds it" {
  // std/compress review sign-off item 1 (2026-11-14): a header cut short
  // waited for the input to double, holding back a complete stream
  let g = gz_named(300, b"hello")
  var s = new_instream(1, -1)
  expect(s.push(g[0..200], false).ok() ?? b"x") == b""
  expect(s.push(g[200..g.len()], false).ok() ?? b"x") == b"hello"
  expect(s.push(b"", true).ok() ?? b"x") == b""
  // a byte at a time: the body comes out before finish
  var t = new_instream(1, -1)
  var got = BytesBuilder.new()
  for i in 0..g.len() {
    got.write(t.push(g[i..i + 1], false).ok() ?? b"x")
  }
  expect(got.freeze()) == b"hello"
  // a dynamic block (Go's level 9 on varied text) cut inside its header:
  // all the output by the end of the second push
  var tb = BytesBuilder.new()
  for i in 0..4000 {
    tb.write_str("${i * 7919 % 1000} ")
  }
  let text = tb.freeze()
  let d = deflate_level(text, 9)
  expect((Int(d[0]) >> 1) & 3) == 2
  var u = new_instream(0, -1)
  let first = u.push(d[0..3], false).ok() ?? b"x"
  expect(first) == b""
  let second = u.push(d[3..d.len()], false).ok() ?? b"x"
  expect(second) == text
}

test "input after the end of a stream is neither read nor kept" {
  // sign-off item 3: it was joined to the input and held
  let d = deflate_level(b"hi", -1)
  var s = new_instream(0, -1)
  expect(s.push(d, false).ok() ?? b"x") == b"hi"
  var junk = BytesBuilder.new()
  for _ in 0..100000 {
    junk.write_byte(0x5a)
  }
  let j = junk.freeze()
  for _ in 0..10 {
    expect(s.push(j, false).ok() ?? b"x") == b""
  }
  expect(s.npend) == 0
  expect(s.f.data.len() < 1000) == true
  expect(s.push(b"", true).ok() ?? b"x") == b""
}

/// Text that deflates with matches and literals, seeded by k.
fn reset_text(k: Int) -> Bytes {
  var b = BytesBuilder.new()
  for i in 0..3000 {
    b.write_str("${(i * 7919 + k) % 1000} ")
  }
  b.freeze()
}

test "a reset stream writes what a new stream writes" {
  // ZipWriter resets one Stream per file (Go's flate Writer.Reset); a
  // reset that kept window, hash or bit state wrote a different stream
  for level in [0, 1, 5, 9] {
    var s = new_stream(level)
    s.write(reset_text(1))
    s.close()
    let first = s.take()
    expect(first.len() > 0) == true
    s.reset()
    s.write(reset_text(2))
    s.close()
    let again = s.take()
    var f = new_stream(level)
    f.write(reset_text(2))
    f.close()
    expect(again) == f.take()
    // a reset in the middle of a stream drops what was not closed
    s.reset()
    s.write(reset_text(3))
    s.flush()
    s.reset()
    s.write(reset_text(2))
    s.close()
    expect(s.take()) == again
  }
}
