// Ed25519 (RFC 8032, decision 0189) on the native backends, as Go's
// crypto/ed25519, in constant time Xo (decision 0222; the zero-C audit's
// B09 step 3; it was std/llrt/xo_crypto.c): a 32 byte seed is the
// private key; verification rejects a non canonical S, accepts the
// encodings of A that Go's edwards25519 accepts (y not reduced, x = 0
// with the sign bit), and compares the encoding of [S]B - [k]A with R
// byte for byte. The group operations are Go's edwards25519's, on
// x25519.xo's field of four 64 bit limbs: [k]B for the public key and
// the nonce point is ScalarBaseMult (signed radix 16 digits over the
// fixed table x25519_btab.BTAB, constant time; x25519.ed_base), and
// verification is VarTimeDoubleScalarBaseMult (width 5 and 8
// non-adjacent forms, one chain of doublings; x25519.ed_check). This
// file keeps the scalar arithmetic and decoding A, whose field elements
// are five 51 bit limbs modulo p = 2^255 - 19. The rules of ct.xo hold
// for every secret value: wrapping arithmetic (rt.int_wrap: 0 add, 1 subtract, 2 multiply, 3
// shift left, 4 shift right logical), no branch or index on a secret.
// Verification's inputs are public, and it branches on them.
//
// The field elements and points of one operation live in one List[Int],
// the workspace, reached through raw memory (decision 0207): `m` is the
// address of its first element, an element is 5 words (40 bytes) at an
// address, a point 4 elements (X, Y, Z, T at +0, +40, +80, +120). The
// workspace is unique and alive for the whole operation (sign, verify,
// public_key hold it), and every offset is a constant below WSIZE.
use native/llrt/ct
use native/llrt/digest
use native/llrt/raw
use native/llrt/x25519
use native/rt

const M51: Int = 0x7FFFFFFFFFFFF

// byte offsets in the workspace: the constants, then the temporaries
const D: Int = 0
const D2: Int = 40
const SQRTM1: Int = 80
const BASE: Int = 120
// ge_add's a, b, c, d, e, f, g, h, t
const TA: Int = 280
// ge_mul's accumulator and the point it selects
const ACC: Int = 640
const SEL: Int = 800
// fe_pow250's z2, z9, t, a, b, c and its results z250, z11; fe_inv's t
const PZ2: Int = 960
const PZ9: Int = 1000
const PT: Int = 1040
const PA: Int = 1080
const PB: Int = 1120
const PC: Int = 1160
const Z250: Int = 1200
const Z11: Int = 1240
const IT: Int = 1280
// ge_bytes's 1/z, x, y
const BZ: Int = 1320
const BX: Int = 1360
const BY: Int = 1400
// ge_from_words's y, u, v, v3, v7, x, t, chk, one
const FY: Int = 1440
const FU: Int = 1480
const FV: Int = 1520
const FV3: Int = 1560
const FV7: Int = 1600
const FX: Int = 1640
const FT: Int = 1680
const FCHK: Int = 1720
const FONE: Int = 1760
// the points of sign and verify
const P1: Int = 1800
const P2: Int = 1960
const P3: Int = 2120
const P4: Int = 2280
// fe_bytes's copy, then the four words of a 32 byte encoding
const FB: Int = 2440
const BW: Int = 2480
// ge_mul's table of [0]p to [15]p
const TABLE: Int = 2512
// the workspace in words
const WSIZE: Int = 634

/// The byte offset past this file's slots in a workspace from
/// field_workspace (8 * WSIZE): x25519.xo's elements start there.
pub const SPARE: Int = 5072

/// A zeroed workspace for the field operations alone (fe_inv's
/// temporaries) and extra words more from SPARE, without the curve's
/// constants (x25519.xo).
pub fn field_workspace(extra: Int) -> List[Int] { raw.zero_ints(WSIZE + extra) }

fn at(m: Int, off: Int) -> Int { m.wrapping_add(off) }

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// A new workspace with the curve's constants: d = -121665/121666, 2d,
/// sqrt(-1) = 2^((p-1)/4), and the base point (y = 4/5, x even, Z = 1, T
/// = xy), each reduced.
fn workspace() -> List[Int] {
  let w = raw.zero_ints(WSIZE)
  let m = base(w)
  set5(at(m, D), 0x34dca135978a3, 0x1a8283b156ebd, 0x5e7a26001c029, 0x739c663a03cbb, 0x52036cee2b6ff)
  set5(at(m, D2), 0x69b9426b2f159, 0x35050762add7a, 0x3cf44c0038052, 0x6738cc7407977, 0x2406d9dc56dff)
  set5(at(m, SQRTM1), 0x61b274a0ea0b0, 0xd5a5fc8f189d, 0x7ef5e9cbd0c60, 0x78595a6804c9e, 0x2b8324804fc1d)
  set5(at(m, BASE), 0x62d608f25d51a, 0x412a4b4f6592a, 0x75b7171a4b31d, 0x1ff60527118fe, 0x216936d3cd6e5)
  set5(at(m, BASE + 40), 0x6666666666658, 0x4cccccccccccc, 0x1999999999999, 0x3333333333333, 0x6666666666666)
  set5(at(m, BASE + 80), 1, 0, 0, 0, 0)
  set5(at(m, BASE + 120), 0x68ab3a5b7dda3, 0xeea2a5eadbb, 0x2af8df483c27e, 0x332b375274732, 0x67875f0fd78b7)
  w
}

/// The address of the workspace's first word.
pub fn base(w: List[Int]) -> Int { rt.obj_addr(w).wrapping_add(rt.layout(2)) }

fn set5(h: Int, a: Int, b: Int, c: Int, d: Int, e: Int) {
  st(h, 0, a)
  st(h, 8, b)
  st(h, 16, c)
  st(h, 24, d)
  st(h, 32, e)
}

/// Copies n words from f to h.
fn copy(h: Int, f: Int, n: Int) { rt.mem_copy(h, f, 8 * n) }

// ---------------------------------------------------------------------------
// Field elements (each argument the address of one)

/// Stores v0 to v4 at h with each limb carried below 2^51 but limb 1, a
/// little above (the carry out of the top wraps times 19).
fn carry_store(h: Int, a0: Int, a1: Int, a2: Int, a3: Int, a4: Int) {
  let v1 = a1.wrapping_add(a0.shr_logical(51))
  let v2 = a2.wrapping_add(v1.shr_logical(51))
  let v3 = a3.wrapping_add(v2.shr_logical(51))
  let v4 = a4.wrapping_add(v3.shr_logical(51))
  let v0 = (a0 & M51).wrapping_add(v4.shr_logical(51).wrapping_mul(19))
  st(h, 0, v0 & M51)
  st(h, 8, (v1 & M51).wrapping_add(v0.shr_logical(51)))
  st(h, 16, v2 & M51)
  st(h, 24, v3 & M51)
  st(h, 32, v4 & M51)
}

pub fn fe_set(h: Int, x: Int) { set5(h, x, 0, 0, 0, 0) }

/// h = f + g, carried.
pub fn fe_add(h: Int, f: Int, g: Int) {
  let a0 = ld(f, 0).wrapping_add(ld(g, 0))
  let a1 = ld(f, 8).wrapping_add(ld(g, 8))
  let a2 = ld(f, 16).wrapping_add(ld(g, 16))
  let a3 = ld(f, 24).wrapping_add(ld(g, 24))
  let a4 = ld(f, 32).wrapping_add(ld(g, 32))
  let v1 = a1.wrapping_add(a0.shr_logical(51))
  let v2 = a2.wrapping_add(v1.shr_logical(51))
  let v3 = a3.wrapping_add(v2.shr_logical(51))
  let v4 = a4.wrapping_add(v3.shr_logical(51))
  let v0 = (a0 & M51).wrapping_add(v4.shr_logical(51).wrapping_mul(19))
  st(h, 0, v0 & M51)
  st(h, 8, (v1 & M51).wrapping_add(v0.shr_logical(51)))
  st(h, 16, v2 & M51)
  st(h, 24, v3 & M51)
  st(h, 32, v4 & M51)
}

/// h = f - g, carried: f + 4p - g limb by limb, so that no limb goes
/// below zero (g carried).
pub fn fe_sub(h: Int, f: Int, g: Int) {
  let a0 = ld(f, 0).wrapping_add(0x1FFFFFFFFFFFB4).wrapping_sub(ld(g, 0))
  let a1 = ld(f, 8).wrapping_add(0x1FFFFFFFFFFFFC).wrapping_sub(ld(g, 8))
  let a2 = ld(f, 16).wrapping_add(0x1FFFFFFFFFFFFC).wrapping_sub(ld(g, 16))
  let a3 = ld(f, 24).wrapping_add(0x1FFFFFFFFFFFFC).wrapping_sub(ld(g, 24))
  let a4 = ld(f, 32).wrapping_add(0x1FFFFFFFFFFFFC).wrapping_sub(ld(g, 32))
  let v1 = a1.wrapping_add(a0.shr_logical(51))
  let v2 = a2.wrapping_add(v1.shr_logical(51))
  let v3 = a3.wrapping_add(v2.shr_logical(51))
  let v4 = a4.wrapping_add(v3.shr_logical(51))
  let v0 = (a0 & M51).wrapping_add(v4.shr_logical(51).wrapping_mul(19))
  st(h, 0, v0 & M51)
  st(h, 8, (v1 & M51).wrapping_add(v0.shr_logical(51)))
  st(h, 16, v2 & M51)
  st(h, 24, v3 & M51)
  st(h, 32, v4 & M51)
}

/// h = -f (z, a zero element, is the workspace's).
fn fe_neg(h: Int, f: Int, z: Int) {
  fe_set(z, 0)
  fe_sub(h, z, f)
}

/// h = f * g (h may be f or g). Limbs of f are below 2^51 but limb 1,
/// below 2^52; of g below 2^52 (every stored element is so). A product p of limb i of f and a limb of
/// g (times 19 where it wraps past 2^255) is taken as (f << 13) * g,
/// whose high word is p >> 51 and whose low word shifted right 13 is p
/// mod 2^51 (limb 1: shifts of 12, then p >> 52 counts twice); the low
/// parts add to their column, the high parts to the next, and the top
/// column's wrap to limbs 0 and 1 times 19.
pub fn fe_mul(h: Int, f: Int, g: Int) {
  let e0 = ld(f, 0).wrapping_shl(13)
  let e1 = ld(f, 8).wrapping_shl(12)
  let e2 = ld(f, 16).wrapping_shl(13)
  let e3 = ld(f, 24).wrapping_shl(13)
  let e4 = ld(f, 32).wrapping_shl(13)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let g4 = ld(g, 32)
  let g1_19 = g1.wrapping_mul(19)
  let g2_19 = g2.wrapping_mul(19)
  let g3_19 = g3.wrapping_mul(19)
  let g4_19 = g4.wrapping_mul(19)
  var l0 = e0.wrapping_mul(g0).shr_logical(13)
  var h0 = e0.mul_hi_unsigned(g0)
  l0 = l0.wrapping_add(e1.wrapping_mul(g4_19).shr_logical(12))
  h0 = h0.wrapping_add(e1.mul_hi_unsigned(g4_19).wrapping_shl(1))
  l0 = l0.wrapping_add(e2.wrapping_mul(g3_19).shr_logical(13))
  h0 = h0.wrapping_add(e2.mul_hi_unsigned(g3_19))
  l0 = l0.wrapping_add(e3.wrapping_mul(g2_19).shr_logical(13))
  h0 = h0.wrapping_add(e3.mul_hi_unsigned(g2_19))
  l0 = l0.wrapping_add(e4.wrapping_mul(g1_19).shr_logical(13))
  h0 = h0.wrapping_add(e4.mul_hi_unsigned(g1_19))
  var l1 = e0.wrapping_mul(g1).shr_logical(13)
  var h1 = e0.mul_hi_unsigned(g1)
  l1 = l1.wrapping_add(e1.wrapping_mul(g0).shr_logical(12))
  h1 = h1.wrapping_add(e1.mul_hi_unsigned(g0).wrapping_shl(1))
  l1 = l1.wrapping_add(e2.wrapping_mul(g4_19).shr_logical(13))
  h1 = h1.wrapping_add(e2.mul_hi_unsigned(g4_19))
  l1 = l1.wrapping_add(e3.wrapping_mul(g3_19).shr_logical(13))
  h1 = h1.wrapping_add(e3.mul_hi_unsigned(g3_19))
  l1 = l1.wrapping_add(e4.wrapping_mul(g2_19).shr_logical(13))
  h1 = h1.wrapping_add(e4.mul_hi_unsigned(g2_19))
  var l2 = e0.wrapping_mul(g2).shr_logical(13)
  var h2 = e0.mul_hi_unsigned(g2)
  l2 = l2.wrapping_add(e1.wrapping_mul(g1).shr_logical(12))
  h2 = h2.wrapping_add(e1.mul_hi_unsigned(g1).wrapping_shl(1))
  l2 = l2.wrapping_add(e2.wrapping_mul(g0).shr_logical(13))
  h2 = h2.wrapping_add(e2.mul_hi_unsigned(g0))
  l2 = l2.wrapping_add(e3.wrapping_mul(g4_19).shr_logical(13))
  h2 = h2.wrapping_add(e3.mul_hi_unsigned(g4_19))
  l2 = l2.wrapping_add(e4.wrapping_mul(g3_19).shr_logical(13))
  h2 = h2.wrapping_add(e4.mul_hi_unsigned(g3_19))
  var l3 = e0.wrapping_mul(g3).shr_logical(13)
  var h3 = e0.mul_hi_unsigned(g3)
  l3 = l3.wrapping_add(e1.wrapping_mul(g2).shr_logical(12))
  h3 = h3.wrapping_add(e1.mul_hi_unsigned(g2).wrapping_shl(1))
  l3 = l3.wrapping_add(e2.wrapping_mul(g1).shr_logical(13))
  h3 = h3.wrapping_add(e2.mul_hi_unsigned(g1))
  l3 = l3.wrapping_add(e3.wrapping_mul(g0).shr_logical(13))
  h3 = h3.wrapping_add(e3.mul_hi_unsigned(g0))
  l3 = l3.wrapping_add(e4.wrapping_mul(g4_19).shr_logical(13))
  h3 = h3.wrapping_add(e4.mul_hi_unsigned(g4_19))
  var l4 = e0.wrapping_mul(g4).shr_logical(13)
  var h4 = e0.mul_hi_unsigned(g4)
  l4 = l4.wrapping_add(e1.wrapping_mul(g3).shr_logical(12))
  h4 = h4.wrapping_add(e1.mul_hi_unsigned(g3).wrapping_shl(1))
  l4 = l4.wrapping_add(e2.wrapping_mul(g2).shr_logical(13))
  h4 = h4.wrapping_add(e2.mul_hi_unsigned(g2))
  l4 = l4.wrapping_add(e3.wrapping_mul(g1).shr_logical(13))
  h4 = h4.wrapping_add(e3.mul_hi_unsigned(g1))
  l4 = l4.wrapping_add(e4.wrapping_mul(g0).shr_logical(13))
  h4 = h4.wrapping_add(e4.mul_hi_unsigned(g0))
  // the columns' values below 2^60, carried
  let v1 = l1.wrapping_add(h0).wrapping_add(l0.shr_logical(51))
  let v2 = l2.wrapping_add(h1).wrapping_add(v1.shr_logical(51))
  let v3 = l3.wrapping_add(h2).wrapping_add(v2.shr_logical(51))
  let v4 = l4.wrapping_add(h3).wrapping_add(v3.shr_logical(51))
  let top = h4.wrapping_add(v4.shr_logical(51))
  let w0 = (l0 & M51).wrapping_add((top & M51).wrapping_mul(19))
  let w1 = (v1 & M51).wrapping_add(top.shr_logical(51).wrapping_mul(19))
  st(h, 0, w0 & M51)
  st(h, 8, w1.wrapping_add(w0.shr_logical(51)))
  st(h, 16, v2 & M51)
  st(h, 24, v3 & M51)
  st(h, 32, v4 & M51)
}

/// h = f * f (h may be f; limbs as fe_mul's f): fe_mul's products, each
/// pair once and doubled.
pub fn fe_sq(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let f4 = ld(f, 32)
  let e0 = f0.wrapping_shl(13)
  let e1 = f1.wrapping_shl(12)
  let e2 = f2.wrapping_shl(13)
  let e3 = f3.wrapping_shl(13)
  let e4 = f4.wrapping_shl(13)
  let f1_2 = f1.wrapping_shl(1)
  let f2_2 = f2.wrapping_shl(1)
  let f3_2 = f3.wrapping_shl(1)
  let f4_2 = f4.wrapping_shl(1)
  let f3_19 = f3.wrapping_mul(19)
  let f4_19 = f4.wrapping_mul(19)
  let f3_38 = f3_19.wrapping_shl(1)
  let f4_38 = f4_19.wrapping_shl(1)
  var l0 = e0.wrapping_mul(f0).shr_logical(13)
  var h0 = e0.mul_hi_unsigned(f0)
  l0 = l0.wrapping_add(e1.wrapping_mul(f4_38).shr_logical(12))
  h0 = h0.wrapping_add(e1.mul_hi_unsigned(f4_38).wrapping_shl(1))
  l0 = l0.wrapping_add(e2.wrapping_mul(f3_38).shr_logical(13))
  h0 = h0.wrapping_add(e2.mul_hi_unsigned(f3_38))
  var l1 = e0.wrapping_mul(f1_2).shr_logical(13)
  var h1 = e0.mul_hi_unsigned(f1_2)
  l1 = l1.wrapping_add(e2.wrapping_mul(f4_38).shr_logical(13))
  h1 = h1.wrapping_add(e2.mul_hi_unsigned(f4_38))
  l1 = l1.wrapping_add(e3.wrapping_mul(f3_19).shr_logical(13))
  h1 = h1.wrapping_add(e3.mul_hi_unsigned(f3_19))
  var l2 = e0.wrapping_mul(f2_2).shr_logical(13)
  var h2 = e0.mul_hi_unsigned(f2_2)
  l2 = l2.wrapping_add(e1.wrapping_mul(f1).shr_logical(12))
  h2 = h2.wrapping_add(e1.mul_hi_unsigned(f1).wrapping_shl(1))
  l2 = l2.wrapping_add(e3.wrapping_mul(f4_38).shr_logical(13))
  h2 = h2.wrapping_add(e3.mul_hi_unsigned(f4_38))
  var l3 = e0.wrapping_mul(f3_2).shr_logical(13)
  var h3 = e0.mul_hi_unsigned(f3_2)
  l3 = l3.wrapping_add(e1.wrapping_mul(f2_2).shr_logical(12))
  h3 = h3.wrapping_add(e1.mul_hi_unsigned(f2_2).wrapping_shl(1))
  l3 = l3.wrapping_add(e4.wrapping_mul(f4_19).shr_logical(13))
  h3 = h3.wrapping_add(e4.mul_hi_unsigned(f4_19))
  var l4 = e0.wrapping_mul(f4_2).shr_logical(13)
  var h4 = e0.mul_hi_unsigned(f4_2)
  l4 = l4.wrapping_add(e1.wrapping_mul(f3_2).shr_logical(12))
  h4 = h4.wrapping_add(e1.mul_hi_unsigned(f3_2).wrapping_shl(1))
  l4 = l4.wrapping_add(e2.wrapping_mul(f2).shr_logical(13))
  h4 = h4.wrapping_add(e2.mul_hi_unsigned(f2))
  // the columns' values below 2^60, carried
  let v1 = l1.wrapping_add(h0).wrapping_add(l0.shr_logical(51))
  let v2 = l2.wrapping_add(h1).wrapping_add(v1.shr_logical(51))
  let v3 = l3.wrapping_add(h2).wrapping_add(v2.shr_logical(51))
  let v4 = l4.wrapping_add(h3).wrapping_add(v3.shr_logical(51))
  let top = h4.wrapping_add(v4.shr_logical(51))
  let w0 = (l0 & M51).wrapping_add((top & M51).wrapping_mul(19))
  let w1 = (v1 & M51).wrapping_add(top.shr_logical(51).wrapping_mul(19))
  st(h, 0, w0 & M51)
  st(h, 8, w1.wrapping_add(w0.shr_logical(51)))
  st(h, 16, v2 & M51)
  st(h, 24, v3 & M51)
  st(h, 32, v4 & M51)
}

/// h = f^(2^k), k >= 1.
fn fe_sqn(h: Int, f: Int, k: Int) {
  fe_sq(h, f)
  for _ in 1..k {
    fe_sq(h, h)
  }
}

/// Z250 = z^(2^250 - 1) and Z11 = z^11 (ref10's chain), shared by
/// inversion and the square root exponent.
fn fe_pow250(m: Int, z: Int) {
  let z2 = at(m, PZ2)
  let z9 = at(m, PZ9)
  let t = at(m, PT)
  let a = at(m, PA)
  let b = at(m, PB)
  let c = at(m, PC)
  let z11 = at(m, Z11)
  fe_sq(z2, z)
  fe_sqn(t, z2, 2)
  fe_mul(z9, t, z)
  fe_mul(z11, z9, z2)
  fe_sq(t, z11)
  fe_mul(a, t, z9) // 2^5 - 1
  fe_sqn(t, a, 5)
  fe_mul(b, t, a) // 2^10 - 1
  fe_sqn(t, b, 10)
  fe_mul(c, t, b) // 2^20 - 1
  fe_sqn(t, c, 20)
  fe_mul(t, t, c) // 2^40 - 1
  fe_sqn(t, t, 10)
  fe_mul(a, t, b) // 2^50 - 1
  fe_sqn(t, a, 50)
  fe_mul(b, t, a) // 2^100 - 1
  fe_sqn(t, b, 100)
  fe_mul(t, t, b) // 2^200 - 1
  fe_sqn(t, t, 50)
  fe_mul(at(m, Z250), t, a) // 2^250 - 1
}

/// h = z^(p - 2) = 1/z.
pub fn fe_inv(m: Int, h: Int, z: Int) {
  fe_pow250(m, z)
  fe_sqn(at(m, IT), at(m, Z250), 5)
  fe_mul(h, at(m, IT), at(m, Z11))
}

/// h = z^((p - 5) / 8) = z^(2^252 - 3).
fn fe_pow22523(m: Int, h: Int, z: Int) {
  fe_pow250(m, z)
  fe_sqn(at(m, IT), at(m, Z250), 2)
  fe_mul(h, at(m, IT), z)
}

/// The canonical encoding of f (reduced below p) as four little endian
/// words at BW.
pub fn fe_bytes(m: Int, f: Int) {
  let c = at(m, FB)
  copy(c, f, 5)
  carry_store(c, ld(c, 0), ld(c, 8), ld(c, 16), ld(c, 24), ld(c, 32))
  carry_store(c, ld(c, 0), ld(c, 8), ld(c, 16), ld(c, 24), ld(c, 32))
  var v0 = ld(c, 0)
  var v1 = ld(c, 8)
  var v2 = ld(c, 16)
  var v3 = ld(c, 24)
  var v4 = ld(c, 32)
  // q = 1 when f >= p (f + 19 carries out of bit 255)
  var q = v0.wrapping_add(19).shr_logical(51)
  q = v1.wrapping_add(q).shr_logical(51)
  q = v2.wrapping_add(q).shr_logical(51)
  q = v3.wrapping_add(q).shr_logical(51)
  q = v4.wrapping_add(q).shr_logical(51)
  v0 = v0.wrapping_add((19).wrapping_mul(q))
  v1 = v1.wrapping_add(v0.shr_logical(51))
  v0 = v0 & M51
  v2 = v2.wrapping_add(v1.shr_logical(51))
  v1 = v1 & M51
  v3 = v3.wrapping_add(v2.shr_logical(51))
  v2 = v2 & M51
  v4 = v4.wrapping_add(v3.shr_logical(51))
  v3 = v3 & M51
  v4 = v4 & M51
  let o = at(m, BW)
  st(o, 0, v0 | v1.wrapping_shl(51))
  st(o, 8, v1.shr_logical(13) | v2.wrapping_shl(38))
  st(o, 16, v2.shr_logical(26) | v3.wrapping_shl(25))
  st(o, 24, v3.shr_logical(39) | v4.wrapping_shl(12))
}

/// The four words at BW.
pub fn bw(m: Int) -> List[Int] {
  let o = at(m, BW)
  [ld(o, 0), ld(o, 8), ld(o, 16), ld(o, 24)]
}

/// h = the 255 low bits of the little endian words s (not reduced: a
/// value of p or more is kept, as edwards25519's SetBytes).
pub fn fe_from_words(h: Int, s: List[Int]) {
  st(h, 0, s[0] & M51)
  st(h, 8, (s[0].shr_logical(51) | s[1].wrapping_shl(13)) & M51)
  st(h, 16, (s[1].shr_logical(38) | s[2].wrapping_shl(26)) & M51)
  st(h, 24, (s[2].shr_logical(25) | s[3].wrapping_shl(39)) & M51)
  st(h, 32, s[3].shr_logical(12) & M51)
}

/// -1 when f is 0 modulo p, else 0.
fn fe_zero_mask(m: Int, f: Int) -> Int {
  fe_bytes(m, f)
  let o = at(m, BW)
  ct.mask_eq(ld(o, 0) | ld(o, 8) | ld(o, 16) | ld(o, 24), 0)
}

/// The low bit of f's canonical encoding (its sign).
fn fe_odd(m: Int, f: Int) -> Int {
  fe_bytes(m, f)
  ld(at(m, BW), 0) & 1
}

// ---------------------------------------------------------------------------
// Points (each argument the address of one)

/// p = the point encoded by the words s; false when they encode no point
/// of the curve (public input: this branches).
fn ge_from_words(m: Int, p: Int, s: List[Int]) -> Bool {
  let one = at(m, FONE)
  let y = at(m, FY)
  let u = at(m, FU)
  let v = at(m, FV)
  let v3 = at(m, FV3)
  let v7 = at(m, FV7)
  let x = at(m, FX)
  let t = at(m, FT)
  let chk = at(m, FCHK)
  fe_set(one, 1)
  fe_from_words(y, s)
  fe_mul(u, y, y)
  fe_mul(v, u, at(m, D))
  fe_sub(u, u, one)
  fe_add(v, v, one)
  fe_mul(v3, v, v)
  fe_mul(v3, v3, v)
  fe_mul(v7, v3, v3)
  fe_mul(v7, v7, v)
  fe_mul(t, u, v7)
  fe_pow22523(m, t, t)
  fe_mul(x, u, v3)
  fe_mul(x, x, t)
  fe_mul(chk, x, x)
  fe_mul(chk, chk, v)
  fe_sub(t, chk, u)
  if fe_zero_mask(m, t) == 0 {
    fe_add(t, chk, u)
    if fe_zero_mask(m, t) == 0 {
      return false
    }
    fe_mul(x, x, at(m, SQRTM1))
  }
  if fe_odd(m, x) != s[3].shr_logical(63) {
    fe_neg(x, x, t)
  }
  copy(p, x, 5)
  carry_store(at(p, 40), ld(y, 0), ld(y, 8), ld(y, 16), ld(y, 24), ld(y, 32))
  fe_set(at(p, 80), 1)
  fe_mul(at(p, 120), x, at(p, 40))
  true
}

// ---------------------------------------------------------------------------
// Scalars modulo the group order L = 2^252 +
// 27742317777372353535851937790883648493, as little endian words

const L0: Int = 0x5812631a5cf5d3ed
const L1: Int = 0x14def9dea2f79cd6
const L3: Int = 0x1000000000000000

/// x + y + c and the carry out (0 or 1), as Go's bits.Add64.
fn add64(x: Int, y: Int, c: Int) -> (Int, Int) {
  let s = x.wrapping_add(y).wrapping_add(c)
  (s, ((x & y) | ((x | y) & ~s)).shr_logical(63))
}

/// -L^-1 modulo 2^64, R^2 and R^3 modulo L (R = 2^256; words past
/// 2^63 written negative, the unsigned value after //): the Montgomery
/// constants of Go's fiat-crypto scalar field (scalar_fiat.go,
/// SetUniformBytes).
const MINV: Int = -0x2d4ae25cedab81e5 // 0xd2b51da312547e1b
const R2_0: Int = -0x5bf9ee1cbb63f0ff // 0xa40611e3449c0f01
const R2_1: Int = -0x2ff1e458977a6cb9 // 0xd00e1ba768859347
const R2_2: Int = -0x31138c2de80a419b // 0xceec73d217f5be65
const R2_3: Int = 0x0399411b7c309a3d
const R3_0: Int = 0x2a9e49687b83a2db
const R3_1: Int = 0x278324e6aef7f3ec
const R3_2: Int = -0x7f9a2393fb13a49b // 0x8065dc6c04ec5b65
const R3_3: Int = 0x0e530b773599cec7

/// x - y - b and its borrow (Go's bits.Sub64).
fn sub64(x: Int, y: Int, b: Int) -> (Int, Int) {
  let d = x.wrapping_sub(y).wrapping_sub(b)
  (d, ((~x & y) | (~(x ^ y) & d)).shr_logical(63))
}

/// The low and high words of a * b + c + d (never past 128 bits).
fn mac(a: Int, b: Int, c: Int, d: Int) -> (Int, Int) {
  let (s1, c1) = add64(a.wrapping_mul(b), c, 0)
  let (s2, c2) = add64(s1, d, 0)
  (s2, a.mul_hi_unsigned(b).wrapping_add(c1).wrapping_add(c2))
}

/// t0..t4 minus L when that does not borrow (constant time): t < 2L to
/// below L.
fn sc_sub_l(t0: Int, t1: Int, t2: Int, t3: Int, t4: Int) -> List[Int] {
  let (s0, b0) = sub64(t0, L0, 0)
  let (s1, b1) = sub64(t1, L1, b0)
  let (s2, b2) = sub64(t2, 0, b1)
  let (s3, b3) = sub64(t3, L3, b2)
  let (_, b4) = sub64(t4, 0, b3)
  // all ones when t >= L
  let mask = ct.mask_bit((1).wrapping_sub(b4))
  [ct.pick(mask, s0, t0), ct.pick(mask, s1, t1), ct.pick(mask, s2, t2), ct.pick(mask, s3, t3)]
}

/// One word of a Montgomery product (CIOS): t + a * bi, then plus m * L
/// with m chosen so the low word is zero, shifted down a word.
fn mont_row(t: (Int, Int, Int, Int, Int), a: List[Int], bi: Int) -> (Int, Int, Int, Int, Int) {
  let (t0, t1, t2, t3, t4) = t
  let (u0, c0) = mac(a[0], bi, t0, 0)
  let (u1, c1) = mac(a[1], bi, t1, c0)
  let (u2, c2) = mac(a[2], bi, t2, c1)
  let (u3, c3) = mac(a[3], bi, t3, c2)
  let (u4, u5) = add64(t4, c3, 0)
  let m = u0.wrapping_mul(MINV)
  let (_, d0) = mac(m, L0, u0, 0)
  let (v0, d1) = mac(m, L1, u1, d0)
  let (v1, d2) = add64(u2, d1, 0)
  let (v2, d3) = mac(m, L3, u3, d2)
  let (v3, d4) = add64(u4, d3, 0)
  (v0, v1, v2, v3, u5.wrapping_add(d4))
}

/// a * b / R modulo L, below L, for a * b < L * R (constant time).
fn sc_mont(a: List[Int], b0: Int, b1: Int, b2: Int, b3: Int) -> List[Int] {
  var t = mont_row((0, 0, 0, 0, 0), a, b0)
  t = mont_row(t, a, b1)
  t = mont_row(t, a, b2)
  t = mont_row(t, a, b3)
  let (t0, t1, t2, t3, t4) = t
  sc_sub_l(t0, t1, t2, t3, t4)
}

/// (a + b) modulo L for a and b below L.
fn sc_add(a: List[Int], b: List[Int]) -> List[Int] {
  let (s0, c0) = add64(a[0], b[0], 0)
  let (s1, c1) = add64(a[1], b[1], c0)
  let (s2, c2) = add64(a[2], b[2], c1)
  let (s3, c3) = add64(a[3], b[3], c2)
  sc_sub_l(s0, s1, s2, s3, c3)
}

/// The eight little endian words of x modulo L (constant time), as Go's
/// SetUniformBytes reduces with Montgomery products: lo * R^2 / R plus
/// hi * R^3 / R is x * R, and a product with 1 divides out R.
fn sc_reduce(x: List[Int]) -> List[Int] {
  let lo = sc_mont([x[0], x[1], x[2], x[3]], R2_0, R2_1, R2_2, R2_3)
  let hi = sc_mont([x[4], x[5], x[6], x[7]], R3_0, R3_1, R3_2, R3_3)
  sc_mont(sc_add(lo, hi), 1, 0, 0, 0)
}

/// (r + k * a) modulo L: k * a / R, times R^2 / R, is k * a.
fn sc_muladd(k: List[Int], a: List[Int], r: List[Int]) -> List[Int] {
  let t = sc_mont(k, a[0], a[1], a[2], a[3])
  sc_add(sc_mont(t, R2_0, R2_1, R2_2, R2_3), r)
}

/// Whether the scalar s (public) is below L.
fn sc_canonical(s: List[Int]) -> Bool {
  let l = [L0, L1, 0, L3]
  let top = (1).wrapping_shl(63)
  var i = 3
  while i >= 0 {
    if s[i] != l[i] {
      // unsigned: compare with the top bits flipped
      return (s[i] ^ top) < (l[i] ^ top)
    }
    i -= 1
  }
  false
}

// ---------------------------------------------------------------------------
// Bytes

fn words(b: Bytes, from: Int) -> List[Int] { [rt.bytes_word(b, from), rt.bytes_word(b, from + 8), rt.bytes_word(b, from + 16), rt.bytes_word(b, from + 24)] }

fn words_bytes(ws: List[Int]) -> Bytes {
  var s = rt.rs_with_cap(8 * ws.len())
  for x in ws {
    s = rt.rs_push_word(s, x, 8)
  }
  s.bytes()
}

/// The secret scalar (clamped) and the nonce prefix (four words each) of
/// a 32 byte seed.
fn expand(seed: Bytes) -> (List[Int], List[Int]) {
  let h = digest.sha512_le(seed, b"", b"")
  let top = (1).wrapping_shl(63)
  ([h[0] & ~7, h[1], h[2], (h[3] & ~top) | (1).wrapping_shl(62)], [h[4], h[5], h[6], h[7]])
}

/// crypto.ed25519_public_key: seed is 32 bytes (crypto.xo checks it).
pub fn public_key(seed: Bytes) -> Bytes {
  let (a, _) = expand(seed)
  words_bytes(x25519.ed_base(a))
}

/// crypto.ed25519_sign: key is the 32 byte seed, or Go's 64 byte private
/// key (the seed, then its public key, used as stored, as Go's Sign
/// does, which saves a base multiplication); crypto.xo checks the length.
pub fn sign(key: Bytes, msg: Bytes) -> Bytes {
  let stored = key.len() == 64
  let (a, prefix) = expand(if stored { key[0..32] } else { key })
  let pk = if stored { words(key, 32) } else { x25519.ed_base(a) }
  let r = sc_reduce(digest.sha512_le(words_bytes(prefix), msg, b""))
  var sig = x25519.ed_base(r)
  let k = sc_reduce(digest.sha512_le(words_bytes(sig), words_bytes(pk), msg))
  for x in sc_muladd(k, a, r) {
    sig.push(x)
  }
  words_bytes(sig)
}

/// crypto.ed25519_verify: false for a key or signature of the wrong
/// length. Every input is public.
pub fn verify(pk: Bytes, msg: Bytes, sig: Bytes) -> Bool {
  if pk.len() != 32 || sig.len() != 64 {
    return false
  }
  let s = words(sig, 32)
  if !sc_canonical(s) {
    return false
  }
  let w = workspace()
  let m = base(w)
  let p1 = at(m, P1)
  if !ge_from_words(m, p1, words(pk, 0)) {
    keep(w)
    return false
  }
  fe_bytes(m, p1)
  let ax = bw(m)
  fe_bytes(m, at(p1, 40))
  let ay = bw(m)
  keep(w)
  let k = sc_reduce(digest.sha512_le(sig[0..32], pk, msg))
  let got = x25519.ed_check(ax, ay, k, s)
  let r = words(sig, 0)
  got[0] == r[0] && got[1] == r[1] && got[2] == r[2] && got[3] == r[3]
}

/// A use of the workspace after its last raw access, so that reference
/// counting keeps it alive until there (digest.xo's sha512_state keeps
/// its buffer so).
fn keep(w: List[Int]) {
  if w.len() < 0 {
    return
  }
}
