// Ed25519 (RFC 8032, decision 0189) on the native backends, as Go's
// crypto/ed25519, in constant time Xo (decision 0222; the zero-C audit's
// B09 step 3; it was std/llrt/xo_crypto.c): a 32 byte seed is the
// private key; verification rejects a non canonical S, accepts the
// encodings of A that Go's edwards25519 accepts (y not reduced, x = 0
// with the sign bit), and compares the encoding of [S]B - [k]A with R
// byte for byte. Field elements are five 51 bit limbs modulo p = 2^255 -
// 19; points are extended twisted Edwards coordinates (X:Y:Z:T) with the
// complete addition law (it doubles too); scalar multiplication is a
// double and always add ladder with masked selection (ct.pick), constant
// time in the scalar. The rules of ct.xo hold for every secret value:
// wrapping arithmetic (rt.int_wrap: 0 add, 1 subtract, 2 multiply, 3
// shift left, 4 shift right logical), no branch or index on a secret.
// Verification's inputs are public, and it branches on them.
//
// The field elements and points of one operation live in one List[Int]
// (a workspace, `w`) at fixed offsets: an element is 5 limbs, a point 4
// elements. No function allocates but the workspace and the scalars.
use native/llrt/ct
use native/llrt/digest
use native/llrt/raw
use native/rt

const M51: Int = 0x7FFFFFFFFFFFF

// workspace offsets: constants, then the temporaries of each function
const D: Int = 0
const D2: Int = 5
const SQRTM1: Int = 10
const BASE: Int = 15
// ge_add's a, b, c, d, e, f, g, h, t
const TA: Int = 35
// ge_mul's accumulator and sum
const ACC: Int = 80
const SUM: Int = 100
// fe_pow250's z2, z9, t, a, b, c and its results z250, z11; fe_inv's t
const PZ2: Int = 120
const PZ9: Int = 125
const PT: Int = 130
const PA: Int = 135
const PB: Int = 140
const PC: Int = 145
const Z250: Int = 150
const Z11: Int = 155
const IT: Int = 160
// ge_bytes's 1/z, x, y
const BZ: Int = 165
const BX: Int = 170
const BY: Int = 175
// ge_from_bytes's y, u, v, v3, v7, x, t, chk, one
const FY: Int = 180
const FU: Int = 185
const FV: Int = 190
const FV3: Int = 195
const FV7: Int = 200
const FX: Int = 205
const FT: Int = 210
const FCHK: Int = 215
const FONE: Int = 220
// the points of sign and verify
const P1: Int = 225
const P2: Int = 245
const P3: Int = 265
const P4: Int = 285
// fe_bytes's copy, then the four words of a 32 byte encoding
const FB: Int = 305
const BW: Int = 310
const WSIZE: Int = 314

/// A workspace with the curve's constants: d = -121665/121666, 2d,
/// sqrt(-1) = 2^((p-1)/4), and the base point (y = 4/5, x even, Z = 1, T
/// = xy), each reduced.
fn workspace() -> List[Int] {
  var w = raw.zero_ints(WSIZE)
  set5(w, D, 0x34dca135978a3, 0x1a8283b156ebd, 0x5e7a26001c029, 0x739c663a03cbb, 0x52036cee2b6ff)
  set5(w, D2, 0x69b9426b2f159, 0x35050762add7a, 0x3cf44c0038052, 0x6738cc7407977, 0x2406d9dc56dff)
  set5(w, SQRTM1, 0x61b274a0ea0b0, 0xd5a5fc8f189d, 0x7ef5e9cbd0c60, 0x78595a6804c9e, 0x2b8324804fc1d)
  set5(w, BASE, 0x62d608f25d51a, 0x412a4b4f6592a, 0x75b7171a4b31d, 0x1ff60527118fe, 0x216936d3cd6e5)
  set5(w, BASE + 5, 0x6666666666658, 0x4cccccccccccc, 0x1999999999999, 0x3333333333333, 0x6666666666666)
  set5(w, BASE + 10, 1, 0, 0, 0, 0)
  set5(w, BASE + 15, 0x68ab3a5b7dda3, 0xeea2a5eadbb, 0x2af8df483c27e, 0x332b375274732, 0x67875f0fd78b7)
  w
}

fn set5(var w: List[Int], h: Int, a: Int, b: Int, c: Int, d: Int, e: Int) {
  w[h] = a
  w[h + 1] = b
  w[h + 2] = c
  w[h + 3] = d
  w[h + 4] = e
}

fn copy(var w: List[Int], h: Int, f: Int, n: Int) {
  for i in 0..n {
    w[h + i] = w[f + i]
  }
}

// ---------------------------------------------------------------------------
// Field elements

/// Carries h's limbs below 2^51 (the carry out of the top wraps times
/// 19), limb 1 a little above.
fn fe_carry(var w: List[Int], h: Int) {
  var v0 = w[h]
  var v1 = w[h + 1]
  var v2 = w[h + 2]
  var v3 = w[h + 3]
  var v4 = w[h + 4]
  v1 = rt.int_wrap(0, v1, rt.int_wrap(4, v0, 51))
  v0 = v0 & M51
  v2 = rt.int_wrap(0, v2, rt.int_wrap(4, v1, 51))
  v1 = v1 & M51
  v3 = rt.int_wrap(0, v3, rt.int_wrap(4, v2, 51))
  v2 = v2 & M51
  v4 = rt.int_wrap(0, v4, rt.int_wrap(4, v3, 51))
  v3 = v3 & M51
  v0 = rt.int_wrap(0, v0, rt.int_wrap(2, rt.int_wrap(4, v4, 51), 19))
  v4 = v4 & M51
  v1 = rt.int_wrap(0, v1, rt.int_wrap(4, v0, 51))
  v0 = v0 & M51
  set5(w, h, v0, v1, v2, v3, v4)
}

fn fe_set(var w: List[Int], h: Int, x: Int) { set5(w, h, x, 0, 0, 0, 0) }

/// h = f + g.
fn fe_add(var w: List[Int], h: Int, f: Int, g: Int) {
  for i in 0..5 {
    w[h + i] = rt.int_wrap(0, w[f + i], w[g + i])
  }
  fe_carry(w, h)
}

/// h = f - g, adding 4p so that no limb goes below zero (inputs carried).
fn fe_sub(var w: List[Int], h: Int, f: Int, g: Int) {
  w[h] = rt.int_wrap(1, rt.int_wrap(0, w[f], 0x1FFFFFFFFFFFB4), w[g])
  for i in 1..5 {
    w[h + i] = rt.int_wrap(1, rt.int_wrap(0, w[f + i], 0x1FFFFFFFFFFFFC), w[g + i])
  }
  fe_carry(w, h)
}

/// h = -f.
fn fe_neg(var w: List[Int], h: Int, f: Int) {
  for i in 0..5 {
    let c = if i == 0 { 0x1FFFFFFFFFFFB4 } else { 0x1FFFFFFFFFFFFC }
    w[h + i] = rt.int_wrap(1, c, w[f + i])
  }
  fe_carry(w, h)
}

/// h = f * g (h may be f or g). Each product of 51 bit limbs (a limb of
/// g times 19 where it wraps past 2^255) is split at bit 51: the low part
/// adds to its column, the high part to the next; the high parts of the
/// top column wrap to limbs 0 and 1 times 19.
fn fe_mul(var w: List[Int], h: Int, f: Int, g: Int) {
  let f0 = w[f + 0]
  let f1 = w[f + 1]
  let f2 = w[f + 2]
  let f3 = w[f + 3]
  let f4 = w[f + 4]
  let g0 = w[g + 0]
  let g1 = w[g + 1]
  let g2 = w[g + 2]
  let g3 = w[g + 3]
  let g4 = w[g + 4]
  let g1_19 = rt.int_wrap(2, g1, 19)
  let g2_19 = rt.int_wrap(2, g2, 19)
  let g3_19 = rt.int_wrap(2, g3, 19)
  let g4_19 = rt.int_wrap(2, g4, 19)
  var p = 0
  var q = 0
  p = rt.int_wrap(2, f0, g0)
  q = rt.u64_mul_hi(f0, g0)
  var l0 = p & M51
  var h0 = rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51)
  p = rt.int_wrap(2, f1, g4_19)
  q = rt.u64_mul_hi(f1, g4_19)
  l0 = rt.int_wrap(0, l0, p & M51)
  h0 = rt.int_wrap(0, h0, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f2, g3_19)
  q = rt.u64_mul_hi(f2, g3_19)
  l0 = rt.int_wrap(0, l0, p & M51)
  h0 = rt.int_wrap(0, h0, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f3, g2_19)
  q = rt.u64_mul_hi(f3, g2_19)
  l0 = rt.int_wrap(0, l0, p & M51)
  h0 = rt.int_wrap(0, h0, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f4, g1_19)
  q = rt.u64_mul_hi(f4, g1_19)
  l0 = rt.int_wrap(0, l0, p & M51)
  h0 = rt.int_wrap(0, h0, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f0, g1)
  q = rt.u64_mul_hi(f0, g1)
  var l1 = p & M51
  var h1 = rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51)
  p = rt.int_wrap(2, f1, g0)
  q = rt.u64_mul_hi(f1, g0)
  l1 = rt.int_wrap(0, l1, p & M51)
  h1 = rt.int_wrap(0, h1, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f2, g4_19)
  q = rt.u64_mul_hi(f2, g4_19)
  l1 = rt.int_wrap(0, l1, p & M51)
  h1 = rt.int_wrap(0, h1, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f3, g3_19)
  q = rt.u64_mul_hi(f3, g3_19)
  l1 = rt.int_wrap(0, l1, p & M51)
  h1 = rt.int_wrap(0, h1, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f4, g2_19)
  q = rt.u64_mul_hi(f4, g2_19)
  l1 = rt.int_wrap(0, l1, p & M51)
  h1 = rt.int_wrap(0, h1, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f0, g2)
  q = rt.u64_mul_hi(f0, g2)
  var l2 = p & M51
  var h2 = rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51)
  p = rt.int_wrap(2, f1, g1)
  q = rt.u64_mul_hi(f1, g1)
  l2 = rt.int_wrap(0, l2, p & M51)
  h2 = rt.int_wrap(0, h2, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f2, g0)
  q = rt.u64_mul_hi(f2, g0)
  l2 = rt.int_wrap(0, l2, p & M51)
  h2 = rt.int_wrap(0, h2, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f3, g4_19)
  q = rt.u64_mul_hi(f3, g4_19)
  l2 = rt.int_wrap(0, l2, p & M51)
  h2 = rt.int_wrap(0, h2, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f4, g3_19)
  q = rt.u64_mul_hi(f4, g3_19)
  l2 = rt.int_wrap(0, l2, p & M51)
  h2 = rt.int_wrap(0, h2, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f0, g3)
  q = rt.u64_mul_hi(f0, g3)
  var l3 = p & M51
  var h3 = rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51)
  p = rt.int_wrap(2, f1, g2)
  q = rt.u64_mul_hi(f1, g2)
  l3 = rt.int_wrap(0, l3, p & M51)
  h3 = rt.int_wrap(0, h3, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f2, g1)
  q = rt.u64_mul_hi(f2, g1)
  l3 = rt.int_wrap(0, l3, p & M51)
  h3 = rt.int_wrap(0, h3, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f3, g0)
  q = rt.u64_mul_hi(f3, g0)
  l3 = rt.int_wrap(0, l3, p & M51)
  h3 = rt.int_wrap(0, h3, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f4, g4_19)
  q = rt.u64_mul_hi(f4, g4_19)
  l3 = rt.int_wrap(0, l3, p & M51)
  h3 = rt.int_wrap(0, h3, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f0, g4)
  q = rt.u64_mul_hi(f0, g4)
  var l4 = p & M51
  var h4 = rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51)
  p = rt.int_wrap(2, f1, g3)
  q = rt.u64_mul_hi(f1, g3)
  l4 = rt.int_wrap(0, l4, p & M51)
  h4 = rt.int_wrap(0, h4, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f2, g2)
  q = rt.u64_mul_hi(f2, g2)
  l4 = rt.int_wrap(0, l4, p & M51)
  h4 = rt.int_wrap(0, h4, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f3, g1)
  q = rt.u64_mul_hi(f3, g1)
  l4 = rt.int_wrap(0, l4, p & M51)
  h4 = rt.int_wrap(0, h4, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  p = rt.int_wrap(2, f4, g0)
  q = rt.u64_mul_hi(f4, g0)
  l4 = rt.int_wrap(0, l4, p & M51)
  h4 = rt.int_wrap(0, h4, rt.int_wrap(3, q, 13) | rt.int_wrap(4, p, 51))
  var v1 = rt.int_wrap(0, l1, h0)
  var v2 = rt.int_wrap(0, l2, h1)
  var v3 = rt.int_wrap(0, l3, h2)
  var v4 = rt.int_wrap(0, l4, h3)
  var c = rt.int_wrap(4, l0, 51)
  var v0 = l0 & M51
  v1 = rt.int_wrap(0, v1, c)
  c = rt.int_wrap(4, v1, 51)
  v1 = v1 & M51
  v2 = rt.int_wrap(0, v2, c)
  c = rt.int_wrap(4, v2, 51)
  v2 = v2 & M51
  v3 = rt.int_wrap(0, v3, c)
  c = rt.int_wrap(4, v3, 51)
  v3 = v3 & M51
  v4 = rt.int_wrap(0, v4, c)
  c = rt.int_wrap(4, v4, 51)
  v4 = v4 & M51
  let top = rt.int_wrap(0, h4, c)
  v0 = rt.int_wrap(0, v0, rt.int_wrap(2, top & M51, 19))
  v1 = rt.int_wrap(0, v1, rt.int_wrap(2, rt.int_wrap(4, top, 51), 19))
  c = rt.int_wrap(4, v0, 51)
  w[h] = v0 & M51
  w[h + 1] = rt.int_wrap(0, v1, c)
  w[h + 2] = v2
  w[h + 3] = v3
  w[h + 4] = v4
}

/// h = f^(2^k), k >= 1.
fn fe_sqn(var w: List[Int], h: Int, f: Int, k: Int) {
  fe_mul(w, h, f, f)
  for _ in 1..k {
    fe_mul(w, h, h, h)
  }
}

/// Z250 = z^(2^250 - 1) and Z11 = z^11 (ref10's chain), shared by
/// inversion and the square root exponent.
fn fe_pow250(var w: List[Int], z: Int) {
  fe_mul(w, PZ2, z, z)
  fe_sqn(w, PT, PZ2, 2)
  fe_mul(w, PZ9, PT, z)
  fe_mul(w, Z11, PZ9, PZ2)
  fe_mul(w, PT, Z11, Z11)
  fe_mul(w, PA, PT, PZ9) // 2^5 - 1
  fe_sqn(w, PT, PA, 5)
  fe_mul(w, PB, PT, PA) // 2^10 - 1
  fe_sqn(w, PT, PB, 10)
  fe_mul(w, PC, PT, PB) // 2^20 - 1
  fe_sqn(w, PT, PC, 20)
  fe_mul(w, PT, PT, PC) // 2^40 - 1
  fe_sqn(w, PT, PT, 10)
  fe_mul(w, PA, PT, PB) // 2^50 - 1
  fe_sqn(w, PT, PA, 50)
  fe_mul(w, PB, PT, PA) // 2^100 - 1
  fe_sqn(w, PT, PB, 100)
  fe_mul(w, PT, PT, PB) // 2^200 - 1
  fe_sqn(w, PT, PT, 50)
  fe_mul(w, Z250, PT, PA) // 2^250 - 1
}

/// h = z^(p - 2) = 1/z.
fn fe_inv(var w: List[Int], h: Int, z: Int) {
  fe_pow250(w, z)
  fe_sqn(w, IT, Z250, 5)
  fe_mul(w, h, IT, Z11)
}

/// h = z^((p - 5) / 8) = z^(2^252 - 3).
fn fe_pow22523(var w: List[Int], h: Int, z: Int) {
  fe_pow250(w, z)
  fe_sqn(w, IT, Z250, 2)
  fe_mul(w, h, IT, z)
}

/// The canonical encoding of f (reduced below p) as four little endian
/// words at BW.
fn fe_bytes(var w: List[Int], f: Int) {
  copy(w, FB, f, 5)
  fe_carry(w, FB)
  fe_carry(w, FB)
  // (the words are Ints, not elements to write back)
  var v0 = w[FB] | 0
  var v1 = w[FB + 1] | 0
  var v2 = w[FB + 2] | 0
  var v3 = w[FB + 3] | 0
  var v4 = w[FB + 4] | 0
  // q = 1 when f >= p (f + 19 carries out of bit 255)
  var q = rt.int_wrap(4, rt.int_wrap(0, v0, 19), 51)
  q = rt.int_wrap(4, rt.int_wrap(0, v1, q), 51)
  q = rt.int_wrap(4, rt.int_wrap(0, v2, q), 51)
  q = rt.int_wrap(4, rt.int_wrap(0, v3, q), 51)
  q = rt.int_wrap(4, rt.int_wrap(0, v4, q), 51)
  v0 = rt.int_wrap(0, v0, rt.int_wrap(2, 19, q))
  v1 = rt.int_wrap(0, v1, rt.int_wrap(4, v0, 51))
  v0 = v0 & M51
  v2 = rt.int_wrap(0, v2, rt.int_wrap(4, v1, 51))
  v1 = v1 & M51
  v3 = rt.int_wrap(0, v3, rt.int_wrap(4, v2, 51))
  v2 = v2 & M51
  v4 = rt.int_wrap(0, v4, rt.int_wrap(4, v3, 51))
  v3 = v3 & M51
  v4 = v4 & M51
  w[BW] = v0 | rt.int_wrap(3, v1, 51)
  w[BW + 1] = rt.int_wrap(4, v1, 13) | rt.int_wrap(3, v2, 38)
  w[BW + 2] = rt.int_wrap(4, v2, 26) | rt.int_wrap(3, v3, 25)
  w[BW + 3] = rt.int_wrap(4, v3, 39) | rt.int_wrap(3, v4, 12)
}

/// h = the 255 low bits of the little endian words s0 to s3 (not
/// reduced: a value of p or more is kept, as edwards25519's SetBytes).
fn fe_from_words(var w: List[Int], h: Int, s0: Int, s1: Int, s2: Int, s3: Int) {
  w[h] = s0 & M51
  w[h + 1] = (rt.int_wrap(4, s0, 51) | rt.int_wrap(3, s1, 13)) & M51
  w[h + 2] = (rt.int_wrap(4, s1, 38) | rt.int_wrap(3, s2, 26)) & M51
  w[h + 3] = (rt.int_wrap(4, s2, 25) | rt.int_wrap(3, s3, 39)) & M51
  w[h + 4] = rt.int_wrap(4, s3, 12) & M51
}

/// -1 when f is 0 modulo p, else 0.
fn fe_zero_mask(var w: List[Int], f: Int) -> Int {
  fe_bytes(w, f)
  ct.mask_eq(w[BW] | w[BW + 1] | w[BW + 2] | w[BW + 3], 0)
}

/// The low bit of f's canonical encoding (its sign).
fn fe_odd(var w: List[Int], f: Int) -> Int {
  fe_bytes(w, f)
  w[BW] & 1
}

// ---------------------------------------------------------------------------
// Points

fn ge_identity(var w: List[Int], p: Int) {
  fe_set(w, p, 0)
  fe_set(w, p + 5, 1)
  fe_set(w, p + 10, 1)
  fe_set(w, p + 15, 0)
}

/// r = p + q (add-2008-hwcd-3; complete for a = -1, so it also doubles;
/// r may be p or q).
fn ge_add(var w: List[Int], r: Int, p: Int, q: Int) {
  let a = TA
  let b = TA + 5
  let c = TA + 10
  let d = TA + 15
  let e = TA + 20
  let f = TA + 25
  let g = TA + 30
  let h = TA + 35
  let t = TA + 40
  fe_sub(w, a, p + 5, p)
  fe_sub(w, t, q + 5, q)
  fe_mul(w, a, a, t)
  fe_add(w, b, p + 5, p)
  fe_add(w, t, q + 5, q)
  fe_mul(w, b, b, t)
  fe_mul(w, c, p + 15, q + 15)
  fe_mul(w, c, c, D2)
  fe_mul(w, d, p + 10, q + 10)
  fe_add(w, d, d, d)
  fe_sub(w, e, b, a)
  fe_sub(w, f, d, c)
  fe_add(w, g, d, c)
  fe_add(w, h, b, a)
  fe_mul(w, r, e, f)
  fe_mul(w, r + 5, g, h)
  fe_mul(w, r + 15, e, h)
  fe_mul(w, r + 10, f, g)
}

/// p = q when m is -1, unchanged when 0, without a branch on m.
fn ge_cmov(var w: List[Int], p: Int, q: Int, m: Int) {
  for i in 0..20 {
    w[p + i] = ct.pick(m, w[q + i], w[p + i])
  }
}

/// r = [k]p for the 256 bit scalar k (four little endian words); p is
/// neither ACC nor SUM.
fn ge_mul(var w: List[Int], r: Int, k: List[Int], p: Int) {
  ge_identity(w, ACC)
  var i = 255
  while i >= 0 {
    ge_add(w, ACC, ACC, ACC)
    ge_add(w, SUM, ACC, p)
    ge_cmov(w, ACC, SUM, ct.mask_bit(rt.int_wrap(4, k[i / 64], i % 64)))
    i -= 1
  }
  copy(w, r, ACC, 20)
}

/// The encoding of p as four words at BW.
fn ge_bytes(var w: List[Int], p: Int) {
  fe_inv(w, BZ, p + 10)
  fe_mul(w, BX, p, BZ)
  fe_mul(w, BY, p + 5, BZ)
  let odd = fe_odd(w, BX)
  fe_bytes(w, BY)
  w[BW + 3] = w[BW + 3] ^ rt.int_wrap(3, odd, 63)
}

/// p = the point encoded by the words s0 to s3; false when they encode no
/// point of the curve (public input: this branches).
fn ge_from_words(var w: List[Int], p: Int, s0: Int, s1: Int, s2: Int, s3: Int) -> Bool {
  fe_set(w, FONE, 1)
  fe_from_words(w, FY, s0, s1, s2, s3)
  fe_mul(w, FU, FY, FY)
  fe_mul(w, FV, FU, D)
  fe_sub(w, FU, FU, FONE)
  fe_add(w, FV, FV, FONE)
  fe_mul(w, FV3, FV, FV)
  fe_mul(w, FV3, FV3, FV)
  fe_mul(w, FV7, FV3, FV3)
  fe_mul(w, FV7, FV7, FV)
  fe_mul(w, FT, FU, FV7)
  fe_pow22523(w, FT, FT)
  fe_mul(w, FX, FU, FV3)
  fe_mul(w, FX, FX, FT)
  fe_mul(w, FCHK, FX, FX)
  fe_mul(w, FCHK, FCHK, FV)
  fe_sub(w, FT, FCHK, FU)
  if fe_zero_mask(w, FT) == 0 {
    fe_add(w, FT, FCHK, FU)
    if fe_zero_mask(w, FT) == 0 {
      return false
    }
    fe_mul(w, FX, FX, SQRTM1)
  }
  if fe_odd(w, FX) != rt.int_wrap(4, s3, 63) {
    fe_neg(w, FX, FX)
  }
  copy(w, p, FX, 5)
  copy(w, p + 5, FY, 5)
  fe_carry(w, p + 5)
  fe_set(w, p + 10, 1)
  fe_mul(w, p + 15, FX, p + 5)
  true
}

// ---------------------------------------------------------------------------
// Scalars modulo the group order L = 2^252 +
// 27742317777372353535851937790883648493, as little endian words

const L0: Int = 0x5812631a5cf5d3ed
const L1: Int = 0x14def9dea2f79cd6
const L3: Int = 0x1000000000000000

/// x - y - b and the borrow out (0 or 1), as Go's bits.Sub64.
fn sub64(x: Int, y: Int, b: Int) -> (Int, Int) {
  let d = rt.int_wrap(1, rt.int_wrap(1, x, y), b)
  (d, rt.int_wrap(4, (~x & y) | (~(x ^ y) & d), 63))
}

/// x + y + c and the carry out (0 or 1), as Go's bits.Add64.
fn add64(x: Int, y: Int, c: Int) -> (Int, Int) {
  let s = rt.int_wrap(0, rt.int_wrap(0, x, y), c)
  (s, rt.int_wrap(4, (x & y) | ((x | y) & ~s), 63))
}

/// The n little endian words of x modulo L, bit by bit (constant time
/// in x): four words.
fn sc_reduce(x: List[Int]) -> List[Int] {
  var r0 = 0
  var r1 = 0
  var r2 = 0
  var r3 = 0
  var r4 = 0
  var i = 64 * x.len() - 1
  while i >= 0 {
    let bit = rt.int_wrap(4, x[i / 64], i % 64) & 1
    r4 = rt.int_wrap(3, r4, 1) | rt.int_wrap(4, r3, 63)
    r3 = rt.int_wrap(3, r3, 1) | rt.int_wrap(4, r2, 63)
    r2 = rt.int_wrap(3, r2, 1) | rt.int_wrap(4, r1, 63)
    r1 = rt.int_wrap(3, r1, 1) | rt.int_wrap(4, r0, 63)
    r0 = rt.int_wrap(3, r0, 1) | bit
    let (t0, b0) = sub64(r0, L0, 0)
    let (t1, b1) = sub64(r1, L1, b0)
    let (t2, b2) = sub64(r2, 0, b1)
    let (t3, b3) = sub64(r3, L3, b2)
    let (t4, b4) = sub64(r4, 0, b3)
    // all ones when r >= L (no borrow)
    let m = ct.mask_bit(rt.int_wrap(1, 1, b4))
    r0 = ct.pick(m, t0, r0)
    r1 = ct.pick(m, t1, r1)
    r2 = ct.pick(m, t2, r2)
    r3 = ct.pick(m, t3, r3)
    r4 = ct.pick(m, t4, r4)
    i -= 1
  }
  [r0, r1, r2, r3]
}

/// (r + k * a) modulo L.
fn sc_muladd(k: List[Int], a: List[Int], r: List[Int]) -> List[Int] {
  var x = raw.zero_ints(9)
  for i in 0..4 {
    var carry = 0
    for j in 0..4 {
      let lo = rt.int_wrap(2, k[i], a[j])
      let hi = rt.u64_mul_hi(k[i], a[j])
      let (s1, c1) = add64(lo, x[i + j], 0)
      let (s2, c2) = add64(s1, carry, 0)
      x[i + j] = s2
      carry = rt.int_wrap(0, rt.int_wrap(0, hi, c1), c2)
    }
    x[i + 4] = carry
  }
  var c = 0
  for i in 0..9 {
    let (s, co) = add64(x[i], if i < 4 { r[i] } else { 0 }, c)
    x[i] = s
    c = co
  }
  sc_reduce(x)
}

/// Whether the scalar s (public) is below L.
fn sc_canonical(s: List[Int]) -> Bool {
  let l = [L0, L1, 0, L3]
  var i = 3
  while i >= 0 {
    if s[i] != l[i] {
      // unsigned compare: flip the top bits
      return (s[i] ^ rt.int_wrap(3, 1, 63)) < (l[i] ^ rt.int_wrap(3, 1, 63))
    }
    i -= 1
  }
  false
}

// ---------------------------------------------------------------------------
// Bytes

fn words(b: Bytes, at: Int, n: Int) -> List[Int] {
  var out: List[Int] = []
  for i in 0..n {
    out.push(rt.bytes_word(b, at + 8 * i))
  }
  out
}

fn words_bytes(ws: List[Int]) -> Bytes {
  var s = rt.rs_with_cap(8 * ws.len())
  for x in ws {
    s = rt.rs_push_word(s, x, 8)
  }
  s.bytes()
}

/// The secret scalar (clamped), the nonce prefix, and the public key (four
/// words each) of a 32 byte seed.
fn expand(var w: List[Int], seed: Bytes) -> (List[Int], List[Int], List[Int]) {
  let h = digest.sha512_le(seed, b"", b"")
  let top = rt.int_wrap(3, 1, 63)
  let a = [h[0] & ~7, h[1], h[2], (h[3] & ~top) | rt.int_wrap(3, 1, 62)]
  ge_mul(w, P1, a, BASE)
  ge_bytes(w, P1)
  (a, [h[4], h[5], h[6], h[7]], [w[BW], w[BW + 1], w[BW + 2], w[BW + 3]])
}

/// crypto.ed25519_public_key: seed is 32 bytes (crypto.xo checks it).
pub fn public_key(seed: Bytes) -> Bytes {
  var w = workspace()
  let (_, _, pk) = expand(w, seed)
  words_bytes(pk)
}

/// crypto.ed25519_sign: seed is 32 bytes (crypto.xo checks it).
pub fn sign(seed: Bytes, msg: Bytes) -> Bytes {
  var w = workspace()
  let (a, prefix, pk) = expand(w, seed)
  let r = sc_reduce(digest.sha512_le(words_bytes(prefix), msg, b""))
  ge_mul(w, P1, r, BASE)
  ge_bytes(w, P1)
  let rb = [w[BW], w[BW + 1], w[BW + 2], w[BW + 3]]
  let k = sc_reduce(digest.sha512_le(words_bytes(rb), words_bytes(pk), msg))
  var sig = rb
  for x in sc_muladd(k, a, r) {
    sig.push(x)
  }
  words_bytes(sig)
}

/// crypto.ed25519_verify: false for a key or signature of the wrong
/// length. Every input is public.
pub fn verify(pk: Bytes, msg: Bytes, sig: Bytes) -> Bool {
  if pk.len() != 32 || sig.len() != 64 {
    return false
  }
  let s = words(sig, 32, 4)
  if !sc_canonical(s) {
    return false
  }
  var w = workspace()
  let a = words(pk, 0, 4)
  if !ge_from_words(w, P1, a[0], a[1], a[2], a[3]) {
    return false
  }
  // P2 = -A
  fe_neg(w, P2, P1)
  copy(w, P2 + 5, P1 + 5, 10)
  fe_neg(w, P2 + 15, P1 + 15)
  let k = sc_reduce(digest.sha512_le(sig[0..32], pk, msg))
  ge_mul(w, P3, s, BASE)
  ge_mul(w, P4, k, P2)
  ge_add(w, P3, P3, P4)
  ge_bytes(w, P3)
  let r = words(sig, 0, 4)
  w[BW] == r[0] && w[BW + 1] == r[1] && w[BW + 2] == r[2] && w[BW + 3] == r[3]
}
