// The C path of the integer operations of generated code (decisions 0193
// and 0195): the API of ints.xo over the C runtime's functions
// (std/llrt/xo_bytes.c, xo_rt.c). Loaded in place of ints.xo when
// XO_LLRT_C names `ints`, to compare the two and to fall back while the
// Xo path misses decision 0180's bar; the Go SSA builder then calls the
// C runtime (rt.int_op, rt.int_conv, rt.rune_of, rt.floor_div,
// rt.str_hash) directly, as before the port. The self hosted compiler
// always uses ints.xo.
use native/rt

pub fn op_fault(op: Int, a: Int, b: Int, bits: Int, uns: Int, at: Str) -> Never {
  // the operands failed the check, so the C faults with its message
  rt.int_op(op, a, b, bits, uns, at)
  rt.fault_raise("unreachable", at)
}

pub fn conv_fault(v: Int, fbits: Int, funs: Int, tbits: Int, tuns: Int, at: Str) -> Never {
  if tbits == 0 {
    rt.rune_of(v, fbits, funs, at)
  } else {
    rt.int_conv(v, fbits, funs, tbits, tuns, at)
  }
  rt.fault_raise("unreachable", at)
}

pub fn u64_div(a: Int, b: Int) -> Int { rt.int_op(3, a, b, 64, 1, "") }

pub fn u64_rem(a: Int, b: Int) -> Int { rt.int_op(4, a, b, 64, 1, "") }

pub fn floor_div(a: Int, b: Int) -> Int { rt.floor_div(a, b) }

pub fn str_hash(s: Str) -> Int { rt.str_hash(s) }
