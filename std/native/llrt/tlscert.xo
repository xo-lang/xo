// The TLS runtime's certificate work in Xo (the zero-C audit's work
// item B30; decision 0202): the system's roots (Linux: crypto/x509's
// bundle files and directories; Windows: the ROOT store through
// crypt32), the expiry texts with time.RFC3339, and macOS's chain
// verification through the Security framework (crypto/x509's
// systemVerify), called directly (sys_darwin.xo).
use native/llrt/fsops
use native/llrt/linux
use native/llrt/process
use native/llrt/raw
use native/llrt/sysio
use native/llrt/tlsname
use native/rt
use native/sys_darwin
use native/sys_windows

/// A block of n bytes (at least 1) from malloc, for C to read; freed
/// with release.
fn block(n: Int) -> Int { rt.heap_large(if n > 0 { n } else { 1 }) }

fn release(b: Int) { rt.heap_release(b - 8) }

/// The certificates (DER) of the system's ROOT store.
fn windows_ders() -> List[Bytes] {
  var out: List[Bytes] = []
  // L"ROOT"
  var w = BytesBuilder.with_capacity(10)
  for ch in [82, 79, 79, 84, 0] {
    w.write_byte(UInt8(ch))
    w.write_byte(UInt8(0))
  }
  let st = sys_windows.CertOpenSystemStoreW(0, w.freeze())
  if st == 0 {
    return out
  }
  var c = 0
  while true {
    c = sys_windows.CertEnumCertificatesInStore(st, c)
    if c == 0 {
      break
    }
    // CERT_CONTEXT: the encoding type, pbCertEncoded, cbCertEncoded
    out.push(raw.str_at(rt.mem_load(c, 8, 8), rt.mem_load(c, 16, 4)).bytes())
  }
  let _c = sys_windows.CertCloseStore(st, 0)
  out
}

/// The system's root certificates (DER) for the Xo client off macOS
/// (where the Security framework verifies): Linux's files as
/// crypto/x509's root_unix.go reads them, Windows's ROOT store (Go asks
/// CertGetCertificateChain there: a later stage). UNTESTED on linux and
/// windows.
pub fn system_ders() -> List[Bytes] {
  match target.os {
    TargetOs.Linux => {
      var out: List[Bytes] = []
      for b in unix_pems() {
        for d in pem_certs(b) {
          out.push(d)
        }
      }
      out
    }
    TargetOs.Windows => windows_ders()
    TargetOs.Darwin | TargetOs.Wasi => []
  }
}

/// The roots a client checks servers against, as DER (std/x509's
/// system_roots): system_ders on Linux and Windows; on macOS, where TLS
/// asks the Security framework to evaluate trust and reads no list, the
/// framework's anchor certificates (SecTrustCopyAnchorCertificates: the
/// roots it trusts by default, without user or admin trust settings).
pub fn root_ders() -> List[Bytes] {
  if target.os == TargetOs.Darwin {
    return anchor_ders()
  }
  system_ders()
}

fn anchor_ders() -> List[Bytes] {
  let cf_release = fw("CFRelease")
  let copy = fw("SecTrustCopyAnchorCertificates")
  if cf_release == 0 || copy == 0 {
    return []
  }
  let out = block(8)
  rt.mem_store(out, 0, 0, 8)
  // an OSStatus: the low 32 bits
  let st = rt.call_c2(copy, out, 0) & 4294967295
  let arr = rt.mem_load(out, 0, 8)
  release(out)
  if st != 0 || arr == 0 {
    return []
  }
  let count = rt.call_c2(fw("CFArrayGetCount"), arr, 0)
  let at = fw("CFArrayGetValueAtIndex")
  let copy_data = fw("SecCertificateCopyData")
  let length = fw("CFDataGetLength")
  let ptr = fw("CFDataGetBytePtr")
  var ders: List[Bytes] = []
  for i in 0..count {
    let cert = rt.call_c2(at, arr, i)
    let d = if cert != 0 { rt.call_c2(copy_data, cert, 0) } else { 0 }
    if d == 0 {
      continue
    }
    let n = rt.call_c2(length, d, 0)
    let p = rt.call_c2(ptr, d, 0)
    if n > 0 && p != 0 {
      ders.push(raw.str_at(p, n).bytes())
    }
    let _r = rt.call_c2(cf_release, d, 0)
  }
  let _r = rt.call_c2(cf_release, arr, 0)
  ders
}

/// The DER of each CERTIFICATE block of a PEM text.
pub fn pem_certs(pem: Bytes) -> List[Bytes] {
  var out: List[Bytes] = []
  let n = pem.len()
  let der = block(n + 1)
  var pos = 0
  while true {
    let (np, ty, k) = tlsname.pem_next(raw.bytes_addr(pem), n, pos, der)
    pos = np
    if k < 0 {
      break
    }
    if ty == "CERTIFICATE" {
      out.push(raw.str_at(der, k).bytes())
    }
  }
  release(der)
  out
}

/// The bundle files of crypto/x509's root_linux.go, in its order.
fn cert_files() -> List[Str] {
  ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/ca-bundle.pem", "/etc/pki/tls/cacert.pem", "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem", "/etc/ssl/cert.pem"]
}

/// The files crypto/x509's root_unix.go reads: the first of
/// $SSL_CERT_FILE or the distribution's bundles that reads, then each
/// regular file of $SSL_CERT_DIR or the default directories (symbolic
/// links to a name in the same directory skipped).
fn unix_pems() -> List[Bytes] {
  var out: List[Bytes] = []
  let fenv = process.env_real("SSL_CERT_FILE")
  let files = if !fenv.is_empty() && !fenv[0].is_empty() { [fenv[0]] } else { cert_files() }
  for f in files {
    let (b, e) = sysio.read_whole(f)
    if e == 0 {
      out.push(b)
      break
    }
  }
  let denv = process.env_real("SSL_CERT_DIR")
  let dirs = if !denv.is_empty() && !denv[0].is_empty() { denv[0] } else { "/etc/ssl/certs:/etc/pki/tls/certs" }
  for d in dirs.split(":") {
    if d.is_empty() {
      continue
    }
    let (names, de) = fsops.raw_names(d)
    if de != 0 {
      continue
    }
    for name in names {
      if name.starts_with(".") {
        continue
      }
      let path = "${d}/${name}"
      let (target, le) = linux.readlink(path)
      if le == 0 && !target.contains("/") {
        continue
      }
      if fsops.raw_kind(path, true) != 0 {
        continue
      }
      let (b, e) = sysio.read_whole(path)
      if e == 0 {
        out.push(b)
      }
    }
  }
  out
}

// ---------------------------------------------------------------------------
// The client's verification texts

/// The days from 1970-01-01 to the civil date y-m-d (proleptic
/// Gregorian).
fn days_from_civil(y0: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { y0 - 1 } else { y0 }
  let era = (if y >= 0 { y } else { y - 399 }) / 400
  let yoe = y - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

/// Two decimal digits of v.
fn two(v: Int) -> Str { if v < 10 { "0${v}" } else { "${v}" } }

/// Go's time.Format(time.RFC3339) of the Unix time t in the zone off
/// seconds east of UTC (Z for UTC).
pub fn rfc3339(t: Int, off: Int) -> Str {
  let s = t + off
  var days = s / 86400
  var secs = s % 86400
  if secs < 0 {
    secs += 86400
    days -= 1
  }
  // civil_from_days
  let z = days + 719468
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  var ys = "${y}"
  while ys.len() < 4 {
    ys = "0${ys}"
  }
  let base = "${ys}-${two(m)}-${two(d)}T${two(secs / 3600)}:${two(secs / 60 % 60)}:${two(secs % 60)}"
  if off == 0 {
    return "${base}Z"
  }
  let sign = if off < 0 { "-" } else { "+" }
  let a = if off < 0 { 0 - off } else { off }
  "${base}${sign}${two(a / 3600)}:${two(a / 60 % 60)}"
}

// ---------------------------------------------------------------------------
// macOS: the chain's verification by the Security framework

/// kCFStringEncodingUTF8, and the Security framework's errors
/// errSecCertificateExpired, errSecHostNameMismatch, errSecNotTrusted.
const CF_UTF8 = 134217984

const ERR_EXPIRED = -67818

const ERR_HOST = -67602

const ERR_NOT_TRUSTED = -67843

/// crypto/x509's systemVerify (root_darwin.go): the Security framework
/// evaluates the presented chain crt for an SSL server with the host
/// name (the C string at hp, hn bytes), then Go checks the host name
/// itself. 0 when the chain is trusted, else 1 and Go's text zero
/// terminated in the buffer of mn bytes at msg.
/// apple_verify's outcome for the Xo client (tls13.xo): x509verify.xo's
/// codes (0 trusted, 1 unknown authority, 2 expired, 7 the host name, 10
/// another error) and Go's text for 2 and 10.
pub struct AppleRes {
  pub code: Int
  pub msg: Str
}

/// Go's systemVerify on macOS for the chain of DERs (leaf first) and the
/// host ("" none), as apple_verify: the framework evaluates the chain for
/// an SSL server, then Go checks the host name itself (the caller, with
/// the leaf: code 7). The framework is called directly (sys_darwin.xo;
/// the build links it when a program calls it); svc is unused (kept for
/// the callers' signatures, nonzero meaning the framework decides).
pub fn apple_trust(_svc: Int, ders: List[Bytes], host: Str) -> AppleRes {
  match target.os {
    TargetOs.Darwin => apple_trust_darwin(ders, host)
    _ => AppleRes{code: 10, msg: "x509: no Security framework off macOS"}
  }
}

/// A function of the Security or CoreFoundation framework, found at run
/// time: the frameworks are loaded at the first verification (dlopen of
/// Security, which loads CoreFoundation), not linked, so a program that
/// verifies nothing does not load them at start (about 14M instructions
/// of its launch, bench/results/zero-c-perf-sweep-2026-10-15.md).
fn fw(name: Str) -> Int {
  let h = security()
  if h == 0 {
    return 0
  }
  sys_darwin.dlsym(h, "${name}\x00".bytes())
}

/// The Security framework's handle, opened once a process (static word
/// 14; 0 when it did not load). Its symbols, and CoreFoundation's it
/// depends on, are looked up through it: dlsym(RTLD_DEFAULT) searches
/// every image, 40 to 51 us a symbol against about 0.5 us through the
/// handle (2026-10-21, Mac), and a handshake looks up a dozen. Two first
/// calls at once both open it, which dlopen counts.
fn security() -> Int {
  let w = rt.static_word(14)
  var h = rt.slot_load(w, 0, 1)
  if h == 0 {
    h = sys_darwin.dlopen("/System/Library/Frameworks/Security.framework/Security\x00".bytes(), 9)
    rt.slot_store(w, 0, if h == 0 { -1 } else { h }, 2)
  }
  if h == -1 { 0 } else { h }
}

fn apple_trust_darwin(ders: List[Bytes], host: Str) -> AppleRes {
  let cf_release = fw("CFRelease")
  let callbacks = fw("kCFTypeArrayCallBacks")
  if cf_release == 0 || callbacks == 0 {
    return AppleRes{code: 10, msg: "x509: the Security framework did not load"}
  }
  let certs = rt.call_c4(fw("CFArrayCreateMutable"), 0, 0, callbacks, 0)
  let data_create = fw("CFDataCreate")
  let cert_create = fw("SecCertificateCreateWithData")
  let append = fw("CFArrayAppendValue")
  for (i, der) in ders.indexed() {
    let d = rt.call_c4(data_create, 0, raw.bytes_addr(der), der.len(), 0)
    let sc = if d != 0 { rt.call_c2(cert_create, 0, d) } else { 0 }
    if d != 0 {
      let _r = rt.call_c2(cf_release, d, 0)
    }
    if sc == 0 {
      let _r = rt.call_c2(cf_release, certs, 0)
      return AppleRes{code: 10, msg: if i == 0 { "invalid leaf certificate" } else { "x509: malformed certificate" }}
    }
    let _a = rt.call_c2(append, certs, sc)
    let _r = rt.call_c2(cf_release, sc, 0)
  }
  let host_c = "${host}\x00".bytes()
  let name = if host.len() > 0 { rt.call_c4(fw("CFStringCreateWithCString"), 0, raw.bytes_addr(host_c), CF_UTF8, 0) } else { 0 }
  let pol = rt.call_c2(fw("SecPolicyCreateSSL"), 1, name)
  if name != 0 {
    let _r = rt.call_c2(cf_release, name, 0)
  }
  let out = block(8)
  rt.mem_store(out, 0, 0, 8)
  // an OSStatus: the low 32 bits
  let st = rt.call_c4(fw("SecTrustCreateWithCertificates"), certs, pol, out, 0) & 4294967295
  let _rc = rt.call_c2(cf_release, certs, 0)
  if pol != 0 {
    let _r = rt.call_c2(cf_release, pol, 0)
  }
  let trust = rt.mem_load(out, 0, 8)
  if st != 0 || trust == 0 {
    release(out)
    return AppleRes{code: 10, msg: "SecTrustCreateWithCertificates error: ${if st >= 2147483648 { st - 4294967296 } else { st }}"}
  }
  rt.mem_store(out, 0, 0, 8)
  var res = AppleRes{code: 0, msg: ""}
  // a C bool: only the low byte is the result
  if rt.call_c2(fw("SecTrustEvaluateWithError"), trust, out) & 255 == 0 {
    let err = rt.mem_load(out, 0, 8)
    let code = if err != 0 { rt.call_c2(fw("CFErrorGetCode"), err, 0) } else { 0 }
    var desc = ""
    if err != 0 {
      let ds = rt.call_c2(fw("CFErrorCopyDescription"), err, 0)
      if ds != 0 {
        let buf = block(600)
        if rt.call_c4(fw("CFStringGetCString"), ds, buf, 600, CF_UTF8) & 255 != 0 {
          desc = raw.str_at(buf, raw.cstr_len(buf))
        }
        release(buf)
        let _r = rt.call_c2(cf_release, ds, 0)
      }
      let _r = rt.call_c2(cf_release, err, 0)
    }
    res = if code == ERR_EXPIRED {
      AppleRes{code: 2, msg: "x509: certificate has expired or is not yet valid: ${desc}"}
    } else if code == ERR_HOST {
      AppleRes{code: 7, msg: ""}
    } else if code == ERR_NOT_TRUSTED {
      AppleRes{code: 1, msg: ""}
    } else {
      AppleRes{code: 10, msg: "x509: ${desc}"}
    }
  }
  release(out)
  let _rt = rt.call_c2(cf_release, trust, 0)
  res
}
