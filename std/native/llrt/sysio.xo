// Files and the clock over the system layer of each OS (decisions 0206
// and 0213, decision 0193's mechanism): os.fs.read, write, and stat make
// their calls from Xo, with the C runtime's semantics
// (std/llrt/xo_bytes.c xo_fs_read, xo_fs.c xo_fs_write and xo_fs_stat)
// and the same messages. This module is the portable policy (Go's
// os.ReadFile and os.WriteFile loops, the FsErr status and message
// recorded through rt.fs_set_err); the layer below it is per OS: raw
// system calls on Linux (linux.xo), libSystem on macOS (darwin.xo),
// kernel32 on Windows (windows.xo). In a wasm module, on darwin/amd64,
// and where a test binary's world fakes the capability, they call the C
// runtime; Clock.now calls it everywhere for now. `XO_LLRT_C=sysio`
// loads sysio_c.xo instead (the C runtime everywhere).
use native/llrt/darwin
use native/llrt/linux
use native/llrt/windows
use native/rt

/// The facts of fs_stat: the status (0, or FsErr's tag plus one), and on
/// success whether it is a directory, its size, and its modification time
/// (Unix nanoseconds).
pub struct Info {
  pub st: Int
  pub is_dir: Bool = false
  pub size: Int = 0
  pub modified: Int = 0
}

/// The OS layer the build calls from Xo: 1 Linux system calls (a Linux
/// target that is not a WASI module: a wasm build keeps the host's
/// `target.os`, gotchas/wasm-target-os-is-the-host.md), 2 libSystem
/// (macOS on arm64; on x86_64 the stat symbols are the `$INODE64` ones,
/// not declared, gotchas/darwin-amd64-stat-inode64.md), 3 kernel32
/// (Windows), 0 the C runtime. The SSA passes do not fold a `match` on
/// `target`, so every arm is lowered; the builders make the platform
/// calls of another OS faults, and a native backend's optimizer or a
/// dead branch leaves the other arms unused.
fn layer() -> Int {
  match target.arch {
    TargetArch.Wasm32 => 0
    TargetArch.Arm64 => {
      match target.os {
        TargetOs.Linux => 1
        TargetOs.Darwin => 2
        TargetOs.Windows => 3
        TargetOs.Wasi => 0
      }
    }
    TargetArch.Amd64 => {
      match target.os {
        TargetOs.Linux => 1
        TargetOs.Windows => 3
        TargetOs.Darwin | TargetOs.Wasi => 0
      }
    }
  }
}

/// os.ReadFile(op): the contents in a list of one, or the empty list
/// with the status set (the error names the OS path, as xo_fs_read's).
pub fn fs_read(op: Str) -> List[Bytes] {
  let l = layer()
  if l == 0 || rt.tw_fake(1) {
    return rt.fs_read(op)
  }
  let (b, e) = read_file(l, op)
  if e != 0 {
    rt.fs_set_err(fs_status(l, e), op, err_msg(l, e))
    return []
  }
  rt.fs_set_err(0, "", "")
  [b]
}

/// os.WriteFile(op, data, 0644): the status, an error naming the Xo path
/// x.
pub fn fs_write(op: Str, data: Bytes, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_write(op, data, x)
  }
  let e = write_file(l, op, data)
  if e != 0 {
    let st = fs_status(l, e)
    rt.fs_set_err(st, x, err_msg(l, e))
    return st
  }
  rt.fs_set_err(0, "", "")
  0
}

/// os.Stat(op) (os.Lstat unless follow): the facts, an error naming the
/// Xo path x.
pub fn fs_stat(op: Str, follow: Bool, x: Str) -> Info {
  let l = layer()
  if l == 0 {
    let st = rt.fs_stat(op, follow, x)
    if st != 0 {
      return Info{st: st}
    }
    return Info{st: 0, is_dir: rt.fs_info(0) == 1, size: rt.fs_info(1), modified: rt.fs_info(2)}
  }
  let (i, e) = stat(l, op, follow)
  if e != 0 {
    let st = fs_status(l, e)
    rt.fs_set_err(st, x, err_msg(l, e))
    return Info{st: st}
  }
  rt.fs_set_err(0, "", "")
  i
}

/// Clock.now: Unix nanoseconds of the wall clock, or the test world's
/// virtual clock. The C runtime's on every OS for now. On macOS the Xo
/// path (the virtual clock test, then darwin.realtime_ns:
/// clock_gettime_nsec_np) took 0.934 times the C path's instructions on
/// LLVM but 1.042 times on arm64, whose emitter does not fold the
/// `match` on `target` that picks the layer (each Clock.now paid for the
/// compares), so it misses decision 0180's bar
/// (bench/results/platform-calls-2026-10-13.md); Windows's
/// windows.clock_ns waits with it. On Linux the clock_gettime system
/// call linux.clock_ns makes cost 4.3 times the vDSO's time per call on
/// Graviton (bench/results/linux-syscalls-2026-10-13.md); Xo reaches the
/// vDSO once it can call a C ABI address (decision 0206, next steps).
pub fn clock_now() -> Int { rt.clock_now() }

// ---------------------------------------------------------------------------
// The OS layers behind one interface: a call's result >= 0, or a
// negative errno (EINTR is 4 on Linux and macOS; Windows never reports
// it). A Windows descriptor is a HANDLE.

/// A descriptor of op opened for reading (O_RDONLY | O_CLOEXEC).
fn open_read(l: Int, op: Str) -> Int {
  if l == 3 {
    return windows.open_read(op)
  }
  if l == 2 {
    return darwin.open(op, darwin.O_RDONLY | darwin.O_CLOEXEC, 0)
  }
  linux.open(op, linux.O_RDONLY | linux.O_CLOEXEC, 0)
}

/// A descriptor of op created or truncated for writing, mode 0644.
fn open_write(l: Int, op: Str) -> Int {
  if l == 3 {
    return windows.open_write(op)
  }
  if l == 2 {
    return darwin.open(op, darwin.O_WRONLY | darwin.O_CREAT | darwin.O_TRUNC | darwin.O_CLOEXEC, 420)
  }
  linux.open(op, linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC | linux.O_CLOEXEC, 420)
}

fn read(l: Int, fd: Int, buf: Bytes, off: Int, n: Int) -> Int {
  if l == 3 {
    return windows.read(fd, buf, off, n)
  }
  if l == 2 {
    return darwin.read(fd, buf, off, n)
  }
  linux.read(fd, buf, off, n)
}

/// 0, or the errno of the first failed write.
fn write_all(l: Int, fd: Int, b: Bytes) -> Int {
  if l == 3 {
    return windows.write_all(fd, b)
  }
  if l == 2 {
    return darwin.write_all(fd, b)
  }
  linux.write_all(fd, b)
}

fn close(l: Int, fd: Int) -> Int {
  if l == 3 {
    return windows.close(fd)
  }
  if l == 2 {
    return darwin.close(fd)
  }
  linux.close(fd)
}

/// The size of the open file fd, or -1 when it is not known.
fn file_size(l: Int, fd: Int) -> Int {
  if l == 3 {
    return windows.file_size(fd)
  }
  if l == 2 {
    let (s, e) = darwin.fstat(fd)
    return if e == 0 { s.size } else { -1 }
  }
  let (s, e) = linux.fstat(fd)
  if e == 0 { s.size } else { -1 }
}

/// The facts of op (and 0), or the errno.
fn stat(l: Int, op: Str, follow: Bool) -> (Info, Int) {
  if l == 3 {
    let (s, e) = windows.stat(op, follow)
    return (Info{st: 0, is_dir: s.is_dir, size: s.size, modified: s.mtime}, e)
  }
  if l == 2 {
    let (s, e) = darwin.stat(op, follow)
    return (Info{st: 0, is_dir: darwin.is_dir(s), size: s.size, modified: s.mtime}, e)
  }
  let (s, e) = linux.stat(op, follow)
  (Info{st: 0, is_dir: linux.is_dir(s), size: s.size, modified: s.mtime}, e)
}

/// The C runtime's message of errno e (strerror, first letter lowered).
fn err_msg(l: Int, e: Int) -> Str {
  if l == 3 {
    return windows.err_msg(e)
  }
  if l == 2 {
    return darwin.err_msg(e)
  }
  linux.err_msg(e)
}

/// The FsErr tag plus one of errno e.
fn fs_status(l: Int, e: Int) -> Int {
  if l == 3 {
    return windows.fs_status(e)
  }
  if l == 2 {
    return darwin.fs_status(e)
  }
  linux.fs_status(e)
}

// ---------------------------------------------------------------------------
// The portable policy

/// The contents of the file op: os.ReadFile's loop (a buffer of the size
/// fstat gives plus one byte, at least 512, grown while the file has
/// more) and 0, or the errno.
fn read_file(l: Int, op: Str) -> (Bytes, Int) {
  var fd = open_read(l, op)
  while fd == -linux.EINTR {
    fd = open_read(l, op)
  }
  if fd < 0 {
    return (b"", -fd)
  }
  let size = file_size(l, fd)
  var cap = 512
  if size >= 512 {
    cap = size + 1
  }
  var buf = rt.bytes_buf(cap)
  var n = 0
  while true {
    let r = read(l, fd, buf, n, cap - n)
    if r < 0 {
      if -r == linux.EINTR {
        continue
      }
      close(l, fd)
      return (b"", -r)
    }
    if r == 0 {
      break
    }
    n += r
    if n == cap {
      // the file has more: a buffer twice as large, the bytes so far
      // copied once
      cap *= 2
      var g = BytesBuilder.with_capacity(cap)
      g.write(buf)
      buf = rt.rs_bytes_len(g.freeze(), cap)
    }
  }
  close(l, fd)
  (rt.rs_bytes_len(buf, n), 0)
}

/// os.WriteFile's calls: 0, or the errno (of the open, the first failed
/// write, or the close).
fn write_file(l: Int, op: Str, data: Bytes) -> Int {
  var fd = open_write(l, op)
  while fd == -linux.EINTR {
    fd = open_write(l, op)
  }
  if fd < 0 {
    return -fd
  }
  let e = write_all(l, fd, data)
  let c = close(l, fd)
  if e != 0 {
    return e
  }
  if c < 0 {
    return -c
  }
  0
}
