// Files and the clock over the system layer of each OS (decisions 0206
// and 0213, decision 0193's mechanism): os.fs.read, write, and stat make
// their calls from Xo, with the C runtime's semantics
// (std/llrt/xo_bytes.c xo_fs_read, xo_fs.c xo_fs_write and xo_fs_stat)
// and the same messages. This module is the portable policy (Go's
// os.ReadFile and os.WriteFile loops, the FsErr status and message
// recorded through set_err); the layer below it is per OS: raw
// system calls on Linux (linux.xo), libSystem on macOS (darwin.xo),
// kernel32 on Windows (windows.xo). In a wasm module, on darwin/amd64,
// and where a test binary's world fakes the capability, they call the C
// runtime; Clock.now calls it only for the test world's virtual clock
// (and in a wasm module, whose runtime has its own). Decision 0198
// deleted the selectable C path (`XO_LLRT_C=sysio`); the C functions stay
// for those cases.
use native/llrt/darwin
use native/llrt/linux
use native/llrt/obj
use native/llrt/raw
use native/llrt/sanhook
use native/llrt/twflags
use native/llrt/windows
use native/rt
use native/sys_darwin

/// The facts of fs_stat: the status (0, or FsErr's tag plus one), and on
/// success whether it is a directory, its size, and its modification time
/// (Unix nanoseconds).
pub struct Info {
  pub st: Int
  pub is_dir: Bool = false
  /// a symbolic link itself (only when not followed)
  pub is_link: Bool = false
  pub size: Int = 0
  pub modified: Int = 0
}

/// The OS layer the build calls from Xo: 1 Linux system calls (a Linux
/// target that is not a WASI module: a wasm build keeps the host's
/// `target.os`, gotchas/wasm-target-os-is-the-host.md), 2 libSystem
/// (macOS, arm64 and x86_64: the stat and directory calls are the 64 bit
/// inode ones under plain names, gotchas/darwin-amd64-stat-inode64.md),
/// 3 kernel32 (Windows), 0 the wasm runtime. The SSA builders fold a call
/// of layer() compared with a literal (`layer() == 2`), as they fold
/// `target` tests (decision 0246; compiler/ssa expr.xo layer_call keeps
/// these numbers): the helpers below test `target.os` so another OS's
/// calls are never built.
pub fn layer() -> Int {
  match target.arch {
    TargetArch.Wasm32 => 0
    TargetArch.Arm64 | TargetArch.Amd64 => {
      match target.os {
        TargetOs.Linux => 1
        TargetOs.Darwin => 2
        TargetOs.Windows => 3
        TargetOs.Wasi => 0
      }
    }
  }
}

/// os.ReadFile(op): the contents in a list of one, or the empty list
/// with the status set (the error names the OS path, as xo_fs_read's).
pub fn fs_read(op: Str) -> List[Bytes] {
  let l = layer()
  if l == 0 {
    return rt.fs_read(op)
  }
  if twflags.fake(1) {
    // a test's MemFs starts empty (std.md 8.3): ENOENT on every layer
    set_err(fs_status(l, 2), op, err_msg(l, 2))
    return []
  }
  let (b, e) = read_file(l, op)
  if e != 0 {
    set_err(fs_status(l, e), op, err_msg(l, e))
    return []
  }
  set_err(0, "", "")
  [b]
}

// heapos.xo release's mapped files (decision 0402): its MAPPED_PREFIX and
// MAPPED_MAGIC, kept in step (heapos imports pool, which imports this
// module, so the mapping is made here)
const MAPPED_PREFIX: Int = -9223372036854775807 - 1
const MAPPED_MAGIC = 6372397078646121828

/// The bytes before the file: room for the object's words, and a multiple
/// of every page size (4, 16 and 64 KiB).
const MAP_LEAD = 65536

/// The file fd of size bytes (1 to 4 GiB less one) mapped read only as a
/// string object whose bytes start 8 past its header: the object, or 0
/// when it cannot be mapped (another OS, a sanitizer's or --race heap, a
/// file mmap refuses: read it instead).
fn map_file(fd: Int, size: Int) -> Int {
  if sanhook.sanitized() || sanhook.user_mode() || sanhook.gorace() {
    return 0
  }
  let n = MAP_LEAD + (size + MAP_LEAD - 1) / MAP_LEAD * MAP_LEAD
  let at = match target.os {
    // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON(YMOUS)
    TargetOs.Linux => linux.mmap(0, n, 3, 34, -1, 0)
    TargetOs.Darwin => sys_darwin.mmap(0, n, 3, 4098, -1, 0)
    _ => -1
  }
  // 0, or -1 (darwin) and -errno (linux) for a failure
  if at <= 0 && at > -4096 {
    return 0
  }
  let want = at + MAP_LEAD
  var f = 0
  match target.os {
    TargetOs.Linux => {
      // PROT_READ, MAP_PRIVATE | MAP_FIXED
      f = linux.mmap(want, size, 1, 18, fd, 0)
    }
    TargetOs.Darwin => {
      f = sys_darwin.mmap(want, size, 1, 18, fd, 0)
    }
    _ => {}
  }
  if f != want {
    unmap(at, n)
    return 0
  }
  let o = want - 24
  // the count, then the capacity: the bytes past the header
  rt.mem_store(o, 0, 1, 8)
  rt.mem_store(o, 8, size + 8, 8)
  let b = o - 8
  rt.mem_store(b, 0, MAPPED_PREFIX, 8)
  rt.mem_store(b - 8, 0, MAPPED_MAGIC, 8)
  rt.mem_store(b - 16, 0, at, 8)
  rt.mem_store(b - 24, 0, n, 8)
  o
}

fn unmap(at: Int, n: Int) {
  if target.os == TargetOs.Darwin {
    let _d = sys_darwin.munmap(at, n)
  } else {
    let _l = linux.munmap(at, n)
  }
}

/// fs_read mapping the file read only (decision 0402, Fs.read_mapped): a
/// view at offset 8 of map_file's object, so nothing writes it in
/// place; as fs_read where it cannot map (wasm, Windows, a test's MemFs,
/// an empty file or one of 4 GiB or more, a pipe, mmap failing).
pub fn fs_read_mapped(op: Str) -> List[Bytes] {
  let l = layer()
  if (l == 1 || l == 2) && !twflags.fake(1) {
    var fd = open_read(l, op)
    while fd == -linux.EINTR {
      fd = open_read(l, op)
    }
    if fd >= 0 {
      let size = file_size(l, fd)
      let o = if size > 0 && size < 4294967296 { map_file(fd, size) } else { 0 }
      let _c = close(l, fd)
      if o != 0 {
        obj.count_outside()
        set_err(0, "", "")
        return [rt.str_at(o, size | 34359738368).bytes()]
      }
    }
  }
  fs_read(op)
}

/// os.WriteFile(op, data, 0644): the status, an error naming the Xo path
/// x.
pub fn fs_write(op: Str, data: Bytes, x: Str) -> Int {
  let l = layer()
  if l == 0 {
    return rt.fs_write(op, data, x)
  }
  let e = write_file(l, op, data)
  if e != 0 {
    let st = fs_status(l, e)
    set_err(st, x, err_msg(l, e))
    return st
  }
  set_err(0, "", "")
  0
}

/// os.Stat(op) (os.Lstat unless follow): the facts, an error naming the
/// Xo path x.
pub fn fs_stat(op: Str, follow: Bool, x: Str) -> Info {
  let l = layer()
  if l == 0 {
    let st = rt.fs_stat(op, follow, x)
    if st != 0 {
      return Info{st: st}
    }
    return Info{st: 0, is_dir: rt.fs_info(0) == 1, is_link: rt.fs_info(3) == 1, size: rt.fs_info(1), modified: rt.fs_info(2)}
  }
  let (i, e) = stat(l, op, follow)
  if e != 0 {
    let st = fs_status(l, e)
    set_err(st, x, err_msg(l, e))
    return Info{st: st}
  }
  set_err(0, "", "")
  i
}

// ---------------------------------------------------------------------------
// The clocks (decision 0206 stage 2 on Linux; work item B01 of
// bench/results/zero-c-audit-refresh-2026-10-13.md off Linux): the wall
// clock of Clock.now and the monotonic clock of the scheduler, the
// timers, and the budgets, read from Xo on every OS. The C runtime reads
// them through cabi.xo's real_ns and mono_ns.
//
// The clock of the build is chosen once into word 0 of rt.sys_words, so
// the hot paths test no `target` (the arm64 emitter does not fold a
// `match` on it, gotchas/arm64-match-target-not-folded.md): on Linux the
// address of the vDSO's clock_gettime (> 0) or CLOCK_SYSCALL, on macOS
// CLOCK_LIBSYSTEM, on Windows CLOCK_KERNEL32; 0 until the first read.

/// Word 0 of rt.sys_words on Linux without a vDSO: the system call
/// (linux.vdso_clock's -1).
const CLOCK_SYSCALL = -1
/// Word 0 of rt.sys_words on macOS: clock_gettime_nsec_np.
const CLOCK_LIBSYSTEM = -2
/// Word 0 of rt.sys_words on Windows: GetSystemTimePreciseAsFileTime and
/// QueryPerformanceCounter.
const CLOCK_KERNEL32 = -3

/// The byte offset of words 5 and 6 of the thread local table
/// (rt.tlocal_addr, sched.xo TLS_*): the monotonic clock's timespec or
/// counter.
const TLS_CLOCK_AT = 40

/// Clock.now: Unix nanoseconds of the wall clock, or the test world's
/// virtual clock (the C runtime's, while it runs). On Linux the vDSO's
/// clock_gettime called from Xo (decision 0206 stage 2: the system call
/// it replaced cost 4.3 times the time per call,
/// bench/results/linux-syscalls-2026-10-13.md), on macOS
/// clock_gettime_nsec_np, on Windows GetSystemTimePreciseAsFileTime
/// (bench/results/clocks-2026-10-14.md). This is the clock's hot path,
/// written for the arm64 emitter, which neither folds `target` nor
/// inlines across modules: clock_buf answers 0 while the virtual clock
/// runs and in a WASI module, and the Linux and macOS calls are inline.
pub fn clock_now() -> Int {
  // macOS first: no layer call, scratch or chosen clock to load
  // (bench/results/zero-c-perf-sweep-2026-10-15.md)
  // (a constant: the SSA folds `==` on the target's variants,
  // gotchas/arm64-target-enum-eq-not-folded.md)
  if target.os == TargetOs.Darwin && target.arch != TargetArch.Wasm32 {
    if twflags.virt() {
      return rt.clock_now()
    }
    return sys_darwin.clock_gettime_nsec_np(darwin.CLOCK_REALTIME)
  }
  let a = clock_buf()
  if a == 0 {
    return rt.clock_now()
  }
  let f = rt.slot_load[Int](rt.sys_words(), 0, 0)
  if f > 0 {
    let r = rt.call_c2(f, linux.CLOCK_REALTIME, a)
    if r < 0 {
      return r
    }
    // a timespec of the wall clock never overflows: wrapping, as C's
    return rt.mem_load(a, 0, 8).wrapping_mul(1000000000).wrapping_add(rt.mem_load(a, 8, 8))
  }
  if f == CLOCK_LIBSYSTEM {
    return sys_darwin.clock_gettime_nsec_np(darwin.CLOCK_REALTIME)
  }
  clock_read(true, a)
}

/// The wall clock in Unix nanoseconds, never the virtual clock (the C
/// runtime's xo_clock_now and xo_tz_now through cabi.xo's real_ns).
pub fn real_ns() -> Int {
  if layer() == 0 {
    // WebAssembly: WASI's clock_time_get (the wasm runtime's clock_now)
    return rt.clock_now()
  }
  clock_read(true, obj.scratch())
}

/// The monotonic clock in nanoseconds (the time of the scheduler, the
/// timers, and the budgets; the C runtime's mono_ns through cabi.xo):
/// CLOCK_MONOTONIC on Linux, CLOCK_UPTIME_RAW on macOS, QueryPerformanceCounter on
/// Windows.
pub fn mono_ns() -> Int {
  let f = rt.slot_load[Int](rt.sys_words(), 0, 0)
  if f > 0 {
    // the timespec in words 5 and 6 of the thread's runtime table (an
    // address without a call, unlike obj.scratch's)
    let a = rt.tlocal_addr().wrapping_add(TLS_CLOCK_AT)
    let r = rt.call_c2(f, linux.CLOCK_MONOTONIC, a)
    if r < 0 {
      return r
    }
    return rt.mem_load(a, 0, 8).wrapping_mul(1000000000).wrapping_add(rt.mem_load(a, 8, 8))
  }
  if f == CLOCK_LIBSYSTEM {
    return sys_darwin.clock_gettime_nsec_np(darwin.CLOCK_UPTIME_RAW)
  }
  clock_read(false, rt.tlocal_addr().wrapping_add(TLS_CLOCK_AT))
}

/// The wall clock (real) or the monotonic clock in nanoseconds, with 16
/// bytes of scratch at a for the timespec or the counter, or a negative
/// errno from Linux's clock_gettime; chooses the clock of the build at
/// the first call.
fn clock_read(real: Bool, a: Int) -> Int {
  var f = rt.slot_load[Int](rt.sys_words(), 0, 0)
  if f == 0 {
    f = clock_choose()
  }
  // the word says which; the target tests keep the other OSes' clocks
  // out of the build (decision 0246)
  if target.os == TargetOs.Darwin && f == CLOCK_LIBSYSTEM {
    return sys_darwin.clock_gettime_nsec_np(if real { darwin.CLOCK_REALTIME } else { darwin.CLOCK_UPTIME_RAW })
  }
  if target.os == TargetOs.Windows && f == CLOCK_KERNEL32 {
    return if real { windows.clock_ns(a) } else { windows.mono_ns(a) }
  }
  if target.os == TargetOs.Darwin || target.os == TargetOs.Windows {
    fault("the clock chosen is not this OS's")
  }
  linux.clock_ns(if real { linux.CLOCK_REALTIME } else { linux.CLOCK_MONOTONIC }, a)
}

/// Chooses the clock of the build into word 0 of rt.sys_words (on Linux
/// linux.vdso_clock's lookup stores it) and answers it. A choice racing
/// another stores the same word.
fn clock_choose() -> Int {
  if target.os == TargetOs.Linux || target.os == TargetOs.Wasi {
    return linux.vdso_clock()
  }
  let l = if target.os == TargetOs.Darwin { CLOCK_LIBSYSTEM } else { CLOCK_KERNEL32 }
  rt.slot_store[Int](rt.sys_words(), 0, l, 0)
  l
}

// ---------------------------------------------------------------------------
// The OS layers behind one interface: a call's result >= 0, or a
// negative errno (EINTR is 4 on Linux and macOS; Windows never reports
// it). A Windows descriptor is a HANDLE.

/// A descriptor of op opened for reading (O_RDONLY | O_CLOEXEC).
fn open_read(l: Int, op: Str) -> Int {
  if target.os == TargetOs.Windows {
    return windows.open_read(op)
  }
  if target.os == TargetOs.Darwin {
    return darwin.open(op, darwin.O_RDONLY | darwin.O_CLOEXEC, 0)
  }
  linux.open(op, linux.O_RDONLY | linux.O_CLOEXEC, 0)
}

/// A descriptor of op created or truncated for writing, mode 0644.
fn open_write(l: Int, op: Str) -> Int {
  if target.os == TargetOs.Windows {
    return windows.open_write(op)
  }
  if target.os == TargetOs.Darwin {
    return darwin.open(op, darwin.O_WRONLY | darwin.O_CREAT | darwin.O_TRUNC | darwin.O_CLOEXEC, 420)
  }
  linux.open(op, linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC | linux.O_CLOEXEC, 420)
}

fn read(l: Int, fd: Int, buf: Bytes, off: Int, n: Int) -> Int {
  if target.os == TargetOs.Windows {
    return windows.read(fd, buf, off, n)
  }
  if target.os == TargetOs.Darwin {
    return darwin.read(fd, buf, off, n)
  }
  linux.read(fd, buf, off, n)
}

/// 0, or the errno of the first failed write.
fn write_all(l: Int, fd: Int, b: Bytes) -> Int {
  if target.os == TargetOs.Windows {
    return windows.write_all(fd, b)
  }
  if target.os == TargetOs.Darwin {
    return darwin.write_all(fd, b)
  }
  linux.write_all(fd, b)
}

fn close(l: Int, fd: Int) -> Int {
  if target.os == TargetOs.Windows {
    return windows.close(fd)
  }
  if target.os == TargetOs.Darwin {
    return darwin.close(fd)
  }
  linux.close(fd)
}

/// The size of the open file fd, or -1 when it is not known.
fn file_size(l: Int, fd: Int) -> Int {
  if target.os == TargetOs.Windows {
    return windows.file_size(fd)
  }
  if target.os == TargetOs.Darwin {
    let (s, e) = darwin.fstat(fd)
    return if e == 0 { s.size } else { -1 }
  }
  let (s, e) = linux.fstat(fd)
  if e == 0 { s.size } else { -1 }
}

/// The facts of op (and 0), or the errno.
fn stat(l: Int, op: Str, follow: Bool) -> (Info, Int) {
  if target.os == TargetOs.Windows {
    let (s, e) = windows.stat(op, follow)
    return (Info{st: 0, is_dir: s.is_dir, is_link: windows.is_link(s), size: s.size, modified: s.mtime}, e)
  }
  if target.os == TargetOs.Darwin {
    let (s, e) = darwin.stat(op, follow)
    return (Info{st: 0, is_dir: darwin.is_dir(s), is_link: darwin.is_link(s), size: s.size, modified: s.mtime}, e)
  }
  let (s, e) = linux.stat(op, follow)
  (Info{st: 0, is_dir: linux.is_dir(s), is_link: linux.is_link(s), size: s.size, modified: s.mtime}, e)
}

/// The C runtime's message of errno e (strerror, first letter lowered).
pub fn err_msg(l: Int, e: Int) -> Str {
  if target.os == TargetOs.Windows {
    return windows.err_msg(e)
  }
  if target.os == TargetOs.Darwin {
    return darwin.err_msg(e)
  }
  linux.err_msg(e)
}

/// The FsErr tag plus one of errno e.
pub fn fs_status(l: Int, e: Int) -> Int {
  if target.os == TargetOs.Windows {
    return windows.fs_status(e)
  }
  if target.os == TargetOs.Darwin {
    return darwin.fs_status(e)
  }
  linux.fs_status(e)
}

// ---------------------------------------------------------------------------
// The portable policy

/// The contents of the file at path and 0, or the errno, without the
/// status fs_read sets and without the test world's fakes (the host's
/// zone files, std/native/llrt/tzhost.xo); the errno 1 on wasm.
pub fn read_whole(path: Str) -> (Bytes, Int) {
  let l = layer()
  if l == 0 {
    return (b"", 1)
  }
  read_file(l, path)
}

/// The contents of the file op: os.ReadFile's loop (a buffer of the size
/// fstat gives plus one byte, at least 512, grown while the file has
/// more) and 0, or the errno.
fn read_file(l: Int, op: Str) -> (Bytes, Int) {
  var fd = open_read(l, op)
  while fd == -linux.EINTR {
    fd = open_read(l, op)
  }
  if fd < 0 {
    return (b"", -fd)
  }
  let size = file_size(l, fd)
  var cap = 512
  if size >= 512 {
    cap = size + 1
  }
  var buf = raw.bytes_buf(cap)
  var n = 0
  while true {
    let r = read(l, fd, buf, n, cap - n)
    if r < 0 {
      if -r == linux.EINTR {
        continue
      }
      close(l, fd)
      return (b"", -r)
    }
    if r == 0 {
      break
    }
    n += r
    if n == cap {
      // the file has more: a buffer twice as large, the bytes so far
      // copied once
      cap *= 2
      var g = BytesBuilder.with_capacity(cap)
      g.write(buf)
      buf = raw.bytes_len(g.freeze(), cap)
    }
  }
  close(l, fd)
  (raw.bytes_len(buf, n), 0)
}

/// os.WriteFile's calls: 0, or the errno (of the open, the first failed
/// write, or the close).
fn write_file(l: Int, op: Str, data: Bytes) -> Int {
  var fd = open_write(l, op)
  while fd == -linux.EINTR {
    fd = open_write(l, op)
  }
  if fd < 0 {
    return -fd
  }
  let e = write_all(l, fd, data)
  let c = close(l, fd)
  if e != 0 {
    return e
  }
  if c < 0 {
    return -c
  }
  0
}

/// The address of the calling thread's scratch for Clock.now's timespec
/// (the vDSO writes it), 1 on macOS (clock_gettime_nsec_np takes none),
/// or 0 while the test world's virtual clock runs and in a wasm module
/// (the runtime's clock: rt.clock_now). Was xo_sys.c xo_sys_clock_buf.
fn clock_buf() -> Int {
  let l = layer()
  if l == 0 || twflags.virt() {
    return 0
  }
  if l == 2 { 1 } else { obj.scratch() }
}

// ---------------------------------------------------------------------------
// The outcome of the last file operation of this thread (fs.read blocks
// the thread, and its status is read before the task can move): FsErr's
// tag plus one (0 for success), and the error's path and message. Thread
// local words 11 (the status) and 12 (a heap_large block of the path's
// length and bytes, then the message's; reused while it fits) of
// rt.tlocal_get (sched.xo's table). A wasm module's runtime keeps its own
// (rt.fs_set_err, rt.fs_status, rt.fs_msg; on the native targets the SSA
// builders lower them to a fault).

const TL_FS_STATUS = 11
const TL_FS_MSG = 12

/// Records the outcome st (0 success, else FsErr's tag plus one) with the
/// error's path p and message m.
pub fn set_err(st: Int, p: Str, m: Str) {
  if layer() == 0 {
    rt.fs_set_err(st, p, m)
    return
  }
  rt.tlocal_set(TL_FS_STATUS, st)
  if st == 0 {
    return
  }
  let need = 16 + p.len() + m.len()
  var b = rt.tlocal_get(TL_FS_MSG)
  if b == 0 || rt.mem_load(b, 0, 8) < need {
    if b != 0 {
      rt.heap_release(b - 8)
    }
    let c = if need < 240 { 240 } else { need }
    b = rt.heap_large(c + 8)
    rt.mem_store(b, 0, c, 8)
    rt.tlocal_set(TL_FS_MSG, b)
  }
  rt.mem_store(b, 8, p.len(), 8)
  rt.mem_copy(b + 16, raw.data(p), p.len())
  rt.mem_store(b, 16 + p.len(), m.len(), 8)
  rt.mem_copy(b + 24 + p.len(), raw.data(m), m.len())
}

/// The status of the last operation: 0, or FsErr's tag plus one.
pub fn status() -> Int {
  if layer() == 0 {
    return rt.fs_status()
  }
  rt.tlocal_get(TL_FS_STATUS)
}

/// The path and the message of the last error.
pub fn msg() -> List[Str] {
  if layer() == 0 {
    return rt.fs_msg()
  }
  let b = rt.tlocal_get(TL_FS_MSG)
  if b == 0 {
    return ["", ""]
  }
  let pn = rt.mem_load(b, 8, 8)
  let mn = rt.mem_load(b, 16 + pn, 8)
  [raw.str_at(b + 16, pn), raw.str_at(b + 24 + pn, mn)]
}
