/// The deadlock check, pool p's lock held (twrun.xo kick).
fn dl_check(p: Int) { pool.dl_check(p) }

/// The deadlock fault (XO-F001, decision 0077): standard output flushed,
/// the message on standard error, status 70.
/// A park's lock taken with the pool's held (pool.xo klock, XO_LOCKCHECK=1):
/// the scheduler's lock order broken, a deadlock waiting to happen.
/// A fiber switched away holding a runtime lock (pool.xo held, under
/// XO_LOCKCHECK=1): the lock count preemption trusts is off.
fn lock_held_switch() {
  stdio.flush()
  let m = "xo: lock held: a fiber switched away holding a runtime lock (std/native/llrt/pool.xo held)\n"
  stdio.write_all(2, raw.data(m), m.len())
  process.os_exit(70)
}

fn lock_order() {
  stdio.flush()
  let m = "xo: lock order: a park's lock taken while holding the pool's (std/native/llrt/pool.xo)\n"
  stdio.write_all(2, raw.data(m), m.len())
  process.os_exit(70)
}

/// A run queue ring's owner-only operation from another thread (pool.xo
/// owner_check, XO_LOCKCHECK=1): a worker record kept across a park.
fn ring_owner() {
  stdio.flush()
  let m = "xo: ring owner: a worker's ring used from another thread (a record kept across a park; std/native/llrt/pool.xo)\n"
  stdio.write_all(2, raw.data(m), m.len())
  process.os_exit(70)
}

/// A `var` List parameter decision 0322 proved unique at every call
/// (compiler/ssa uniqvar.xo) held a shared list: under XO_RC_CHECK=1 its
/// copy-on-write check stays and reports instead of copying.
fn obj_rl_not_unique(l: Int) {
  // the shared empty list (list.new without a size) is unique enough:
  // every update allocates or faults before it writes
  if obj.is_immortal(l) && rt.mem_load(l, 8, 8) == 0 {
    return
  }
  stdio.flush()
  let m = "xo: internal: a var List parameter proved unique (decision 0322) holds a shared list (count ${rt.mem_load(l, 0, 8)})\n"
  stdio.write_all(2, raw.data(m), m.len())
  process.os_exit(70)
}

fn deadlock() {
  stdio.flush()
  // straight to the descriptor, as the C did (not the test world's fake)
  let m = "fault: XO-F001: deadlock: every task is blocked\n"
  stdio.write_all(2, raw.data(m), m.len())
  process.os_exit(70)
}

