// The C ABI exports of the runtime (decisions 0204, 0207): every top
// level function of this module is called by the C runtime (std/llrt) as
// xo_x_<name>, with the C calling convention, so the C keeps no copy of
// what Xo already does. The module is the marker: the SSA builders build
// every function here in every native program (the native prelude
// imports it), and the emitters give each a global C symbol; the
// modules cabi_<feature>.xo are markers too, for exports only the C of a
// feature calls (cabi_tls.xo, cabi_time.xo), imported by that feature's
// implementation module so only its programs carry them. Parameters
// are Int (an address is an Int) or Float; the result is an Int, a
// Float, nothing, or a Str (returned as its string object, its length
// stored through a pointer the C caller passes after the parameters).
// Nothing here may fault: a fault would unwind through the C caller.
// Helpers live in other runtime modules (raw.xo for memory).
use native/llrt/alloc
use native/llrt/budget
use native/llrt/ctx
use native/llrt/fault
use native/llrt/heapos
use native/llrt/netpolicy
use native/llrt/num
use native/llrt/obj
use native/llrt/poll
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/rc
use native/llrt/sched
use native/llrt/tasks
use native/llrt/stdio
use native/llrt/sysio
use native/llrt/text
use native/llrt/unicode
use native/llrt/unwind
use native/rt

// ---------------------------------------------------------------------------
// Number text (std/llrt xo_rt.c fmt_int, fmt_float, fmt_go_g)

/// Writes the decimal text of v and a zero byte at buf (at least 32
/// bytes); its length.
fn fmt_int(buf: Int, v: Int) -> Int {
  // the digits from the end of the first 24 bytes, then moved to buf
  var i = 24
  var x = v
  while true {
    var d = x % 10
    if d < 0 {
      d = 0 - d
    }
    i -= 1
    rt.mem_store(buf, i, 48 + d, 1)
    x = x / 10
    if x == 0 {
      break
    }
  }
  if v < 0 {
    i -= 1
    rt.mem_store(buf, i, 45, 1)
  }
  let n = 24 - i
  rt.mem_move(buf, buf + i, n)
  rt.mem_store(buf, n, 0, 1)
  n
}

/// Writes the text of f as the Go backend prints a Float (FloatStr) and
/// a zero byte at buf (at least 48 bytes); its length.
fn fmt_float(buf: Int, f: Float) -> Int { raw.put_cstr(buf, num.float_text(f)) }

// ---------------------------------------------------------------------------
// Standard output (stdio.xo, the zero-C audit's work item B03): the C
// runtime flushes it with flush before a wait, at exit, and before a
// fault's message, and with flush_try in Windows' stack overflow handler;
// xo_rt_threads_begin calls stdio_threads before a second thread runs Xo
// code.

fn flush() { stdio.flush() }

fn flush_try() { stdio.flush_try() }

fn stdio_threads() { stdio.threads() }

/// The program's arguments and environment (C main, before the program
/// runs; process.xo).
fn proc_start(argc: Int, argv: Int, envp: Int) { process.start(argc, argv, envp) }

// ---------------------------------------------------------------------------
// The fault entry points of generated code (decision 0228; fault.xo
// raise_*): the arm64 and LLVM emitters call these exports directly
// (loc is the zero terminated location); xo_rt.c's xo_fault_* forward
// to them for code from an xo whose emitters named those. None returns.

fn fault_raise_text(p: Int, n: Int, loc: Int) { fault.raise_text(p, n, loc) }

fn fault_raise_overflow(a: Int, op: Int, b: Int, loc: Int) { fault.raise_overflow(a, op, b, loc) }

fn fault_raise_shl(a: Int, b: Int, loc: Int) { fault.raise_shl(a, b, loc) }

fn fault_raise_shift(n: Int, loc: Int) { fault.raise_shift(n, loc) }

fn fault_raise_divzero(a: Int, op: Int, loc: Int) { fault.raise_divzero(a, op, loc) }

fn fault_raise_neg(a: Int, loc: Int) { fault.raise_neg(a, loc) }

fn fault_raise_abs(a: Int, loc: Int) { fault.raise_abs(a, loc) }

fn fault_raise_index(i: Int, n: Int, loc: Int) { fault.raise_index(i, n, loc) }

fn fault_raise_bytes_index(i: Int, n: Int, loc: Int) { fault.raise_bytes_index(i, n, loc) }

fn fault_raise_float_int(f: Float, loc: Int) { fault.raise_float_int(f, loc) }

/// The address of xo_rt.c fault_raise_msg, at start (fault.xo init).
fn fault_init(raise_msg: Int) { fault.init(raise_msg) }

// ---------------------------------------------------------------------------
// UTF-8 (xo_std.c n_utf8_decode, n_utf8_encode, n_is_space)

/// utf8.DecodeRune of the n bytes at p (n > 0): the rune times 8 plus its
/// size; an invalid or short sequence is U+FFFD of size 1.
fn utf8_decode(p: Int, n: Int) -> Int {
  let c = raw.byte_at(p, 0)
  if c < 0x80 {
    return (c << 3) | 1
  }
  var k = 0
  var lo = 0x80
  var hi = 0xBF
  var r = 0
  if c >= 0xC2 && c <= 0xDF {
    k = 1
    r = c & 0x1F
  } else if c >= 0xE0 && c <= 0xEF {
    k = 2
    r = c & 0x0F
    if c == 0xE0 {
      lo = 0xA0
    } else if c == 0xED {
      hi = 0x9F
    }
  } else if c >= 0xF0 && c <= 0xF4 {
    k = 3
    r = c & 0x07
    if c == 0xF0 {
      lo = 0x90
    } else if c == 0xF4 {
      hi = 0x8F
    }
  } else {
    return (0xFFFD << 3) | 1
  }
  if n < k + 1 {
    return (0xFFFD << 3) | 1
  }
  let c1 = raw.byte_at(p, 1)
  if c1 < lo || c1 > hi {
    return (0xFFFD << 3) | 1
  }
  r = (r << 6) | (c1 & 0x3F)
  var j = 2
  while j <= k {
    let cj = raw.byte_at(p, j)
    if cj < 0x80 || cj > 0xBF {
      return (0xFFFD << 3) | 1
    }
    r = (r << 6) | (cj & 0x3F)
    j += 1
  }
  (r << 3) | (k + 1)
}

/// Writes the UTF-8 of the scalar value r at p; its size.
fn utf8_encode(p: Int, r: Int) -> Int {
  if r < 0x80 {
    rt.mem_store(p, 0, r, 1)
    return 1
  }
  if r < 0x800 {
    rt.mem_store(p, 0, (0xC0 | (r >> 6)) | ((0x80 | (r & 0x3F)) << 8), 2)
    return 2
  }
  if r < 0x10000 {
    rt.mem_store(p, 0, (0xE0 | (r >> 12)) | ((0x80 | ((r >> 6) & 0x3F)) << 8), 2)
    rt.mem_store(p, 2, 0x80 | (r & 0x3F), 1)
    return 3
  }
  rt.mem_store(p, 0, (0xF0 | (r >> 18)) | ((0x80 | ((r >> 12) & 0x3F)) << 8) | ((0x80 | ((r >> 6) & 0x3F)) << 16) | ((0x80 | (r & 0x3F)) << 24), 4)
  4
}

/// 1 when r is white space (unicode.IsSpace), else 0.
fn is_space(r: Int) -> Int {
  if unicode.is_space(r) {
    return 1
  }
  0
}

// ---------------------------------------------------------------------------
// Number and time text of the C callers (xo_std.c n_parse_int,
// n_fmt_duration, n_fmt_time, b64_val, n_days_from_civil)

/// strconv.ParseInt of the n bytes at p, base 10: 1 with the value
/// stored at out, or 0 (out unchanged).
fn parse_int(p: Int, n: Int, out: Int) -> Int {
  if n == 0 {
    return 0
  }
  var i = 0
  var neg = false
  let c0 = raw.byte_at(p, 0)
  if c0 == 43 || c0 == 45 {
    neg = c0 == 45
    i = 1
    if n == 1 {
      return 0
    }
  }
  var v = 0
  while i < n {
    let c = raw.byte_at(p, i) - 48
    if c < 0 || c > 9 {
      return 0
    }
    if v >= 922337203685477580 {
      if v > 922337203685477580 || c > 8 || (c == 8 && !neg) {
        return 0
      }
      if c == 8 {
        // -9223372036854775808, if nothing follows
        if i + 1 != n {
          return 0
        }
        rt.mem_store(out, 0, -9223372036854775807 - 1, 8)
        return 1
      }
    }
    v = v * 10 + c
    i += 1
  }
  if neg {
    v = 0 - v
  }
  rt.mem_store(out, 0, v, 8)
  1
}

/// Writes the text of a Duration of d nanoseconds (time.Duration.String)
/// and a zero byte at buf (at least 32 bytes); its length.
fn fmt_duration(buf: Int, d: Int) -> Int { raw.put_cstr(buf, text.append_duration("", d)) }

/// Writes a Time of t nanoseconds since the Unix epoch as RFC 3339 in UTC
/// (time.RFC3339Nano) and a zero byte at buf (at least 48 bytes); its
/// length.
fn fmt_time(buf: Int, t: Int) -> Int { raw.put_cstr(buf, text.append_time("", t)) }

/// The value of a base64 digit (the standard alphabet), or -1.
fn b64_val(c: Int) -> Int {
  if c >= 65 && c <= 90 {
    return c - 65
  }
  if c >= 97 && c <= 122 {
    return c - 71
  }
  if c >= 48 && c <= 57 {
    return c + 4
  }
  if c == 43 {
    return 62
  }
  if c == 47 {
    return 63
  }
  -1
}

// ---------------------------------------------------------------------------
// The address policy of Net.only (xo_rt.c's, now netpolicy.xo): the
// lists, hosts, ports, and addresses are bytes at an address and a length,
// or zero terminated where the C keeps them so.

/// 1 when the lists admit the dial or listen address of the n bytes at a
/// (onlyNet.admitsAddr), else 0.
fn net_admits_addr(lp: Int, ln: Int, a: Int, n: Int) -> Int {
  if netpolicy.admits_addr(raw.str_at(lp, ln), raw.str_at(a, n)) {
    return 1
  }
  0
}

/// Splits the zero terminated address at a into its host (brackets
/// removed) and port, written zero terminated into the buffers of hn and
/// pn bytes: 0, or -1 without a colon or when one does not fit.
fn split_hostport(a: Int, host: Int, hn: Int, port: Int, pn: Int) -> Int {
  let (ok, h, p) = netpolicy.split_hostport(raw.str_at(a, raw.cstr_len(a)))
  if !ok || h.len() >= hn || p.len() >= pn {
    return -1
  }
  let _h = raw.put_cstr(host, h)
  let _p = raw.put_cstr(port, p)
  0
}

/// 1 when the zero terminated port at p is a number above 65535, else 0.
fn port_out_of_range(p: Int) -> Int {
  if netpolicy.port_out_of_range(raw.str_at(p, raw.cstr_len(p))) {
    return 1
  }
  0
}

/// The days since 1970-01-01 of a date (H. Hinnant's days_from_civil).
fn days_from_civil(year: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { year - 1 } else { year }
  let era = (if y >= 0 { y } else { y - 399 }) / 400
  let yoe = y - era * 400
  let doy = (153 * (if m > 2 { m - 3 } else { m + 9 }) + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

// ---------------------------------------------------------------------------
// The clocks (work item B01): xo_rt.c mono_ns, the real time of
// xo_clock_now, and xo_time.c xo_tz_now read them here, through sysio.xo
// (vDSO, libSystem, or kernel32 calls).

/// The wall clock in Unix nanoseconds (never the test world's virtual
/// clock, which the C serves itself).
fn real_ns() -> Int { sysio.real_ns() }

/// The monotonic clock in nanoseconds.
fn mono_ns() -> Int { sysio.mono_ns() }

// ---------------------------------------------------------------------------
// Reference counts (decision 0207 stage 2): xo_rt.c rc_inc, rc_dec,
// rc_dec_shared, rc_claim, and xo_rc_mark, in rc.xo (rc_c.xo with
// XO_LLRT_C=rc, whose C then calls its own copies). p is the address of
// a counted object; nothing here allocates or counts.

fn rc_inc(p: Int) { rc.inc(p) }

fn rc_dec(p: Int) -> Int { rc.dec(p) }

fn rc_dec_shared(p: Int) -> Int { rc.dec_shared(p) }

fn rc_claim(p: Int) -> Int { rc.claim(p) }

fn rc_mark(p: Int) -> Int { rc.mark(p) }

// ---------------------------------------------------------------------------
// The heap (decision 0207 stage 3): xo_rt.c alloc_in, free_in, alloc_mt's
// and free_mt's magazines, and xo_resize, in alloc.xo (alloc_c.xo with
// XO_LLRT_C=alloc, whose C then calls its own copies). h is the calling
// thread's heap record (the C finds it), p a block; heap_alloc and
// heap_free take h last, so xo_alloc and xo_free pass their argument on
// in place. Nothing here allocates or counts.

fn heap_alloc(n: Int, h: Int) -> Int { alloc.alloc(h, n) }

fn heap_free(p: Int, h: Int) { alloc.free(h, p) }

fn heap_refill(h: Int, n: Int) { alloc.refill(h, n) }

fn heap_free_mt(h: Int, p: Int) { alloc.free_mt(h, p) }

fn heap_resize(h: Int, p: Int, old: Int, n: Int, mt: Int) -> Int { alloc.resize(h, p, old, n, mt) }

// The heap's platform calls (zero-C audit B21, heapos.xo): the C's
// xo_heap_big, xo_heap_big_resize, xo_heap_big_release, xo_heap_grow,
// xo_heap_lock, and xo_heap_unlock forward to these (alloc.xo calls
// those as rt.heap_*). b is a big block's prefix address.

fn heap_big(n: Int) -> Int { heapos.large(n) }

fn heap_big_resize(b: Int, n: Int) -> Int { heapos.large_resize(b, n) }

fn heap_big_release(b: Int) { heapos.release(b) }

/// Gives heap h a new chunk and allocates n bytes again.
fn heap_grow(h: Int, n: Int) -> Int {
  heapos.chunk(h)
  alloc.alloc(h, n)
}

fn heap_lock() { heapos.lock() }

fn heap_unlock() { heapos.unlock() }

/// The chunks mapped so far (the heap statistics and tests).
fn heap_chunks() -> Int { heapos.chunks() }

// ---------------------------------------------------------------------------
// Lists (zero-C audit B13): xo_rt.c xo_rl_new, xo_rl_copy, xo_rl_share, xo_rl_grow, xo_rl_free's work, and
// xo_rc_defer's worklist, in obj.xo. hw is the calling thread's heap
// word (the C finds it: the heap record, plus 1 when other threads run),
// h a heap record, a and l objects, p bytes, the callbacks C functions
// of generated code. Nothing here allocates Xo values, counts, or faults.

fn obj_rl_new(hw: Int, cap: Int, esize: Int) -> Int { obj.rl_new(hw, cap, esize) }

// arm64 generated code calls these directly, with no C level: obj.xo
// finds the heap itself (no hw).
fn obj_rl_new_n(n: Int, esize: Int) -> Int { obj.rl_new_n(n, esize) }

fn obj_rl_grow_n(l: Int, esize: Int) -> Int { obj.rl_grow_n(l, esize) }

fn obj_rl_free_n(l: Int, esize: Int, drop: Int) { obj.rl_free_n(l, esize, drop) }

fn obj_rl_copy_n(l: Int, esize: Int, dup: Int, drop: Int) -> Int { obj.rl_copy_n(l, esize, dup, drop) }

fn obj_rc_defer_n(o: Int, drop: Int) { obj.rc_defer_n(o, drop) }

fn obj_heap_init(h: Int, slow: Int, rl_free_rt: Int, rc_defer_rt: Int, libc: Int, hsize: Int) {
  obj.heap_init(h, slow, rl_free_rt, rc_defer_rt)
  heapos.set_libc(libc)
  if h != 0 {
    heapos.records_init(h, hsize)
  }
}

/// The calling thread's heap record (xo_rt.c heap_slow after its thread
/// local was empty); the leak check's sums at lp and tp; class c's free
/// blocks over every record (heap statistics).
fn heap_thread() -> Int { heapos.thread_heap() }

fn heap_live(lp: Int, tp: Int) { heapos.live(lp, tp) }

fn heap_nfree(c: Int) -> Int { heapos.nfree(c) }

fn obj_rl_share(l: Int, esize: Int, share: Int) { obj.rl_share(l, esize, share) }

fn obj_rl_free(hw: Int, l: Int, esize: Int, drop: Int) { obj.rl_free(hw, l, esize, drop) }

fn obj_rc_defer(h: Int, o: Int, drop: Int) { obj.rc_defer(h, o, drop) }

// Strings (zero-C audit B13): xo_rt.c xo_rs_concat and xo_rs_append,
// xo_bytes.c's builders, in obj.xo, called by arm64 generated code
// directly and by the C entries (for LLVM and the seed). a and b are
// string (or Bytes) objects, an and bn their lengths; the result is the
// string object, its length stored at lenp (a Str result's convention).

/// a + the n bytes at p: the C runtime's rs_append.
fn obj_rs_append_at(a: Int, an: Int, p: Int, n: Int) -> Int { obj.rs_append(a, an, p, n) }

fn obj_rs_concat(a: Int, an: Int, b: Int, bn: Int) -> Int { obj.rs_append(a, an, rt.int_wrap(0, b, 16), bn) }

fn obj_rs_append(a: Int, an: Int, b: Int, bn: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, bn), 8)
  obj.rs_append(a, an, rt.int_wrap(0, b, 16), bn)
}

fn obj_rs_push_byte(a: Int, an: Int, x: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, 1), 8)
  obj.rs_push_byte(a, an, x)
}

fn obj_rs_push_word(a: Int, an: Int, w: Int, n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, n), 8)
  obj.rs_push_word(a, an, w)
}

fn obj_rs_push_words(a: Int, an: Int, w0: Int, w1: Int, w2: Int, w3: Int, lens: Int, lenp: Int) -> Int {
  let k = rt.int_wrap(0, rt.int_wrap(0, lens & 15, (lens >> 4) & 15), rt.int_wrap(0, (lens >> 8) & 15, (lens >> 12) & 15))
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, k), 8)
  obj.rs_push_words(a, an, w0, w1, w2, w3, lens)
}

fn obj_rs_append_bytes(a: Int, an: Int, b: Int, bn: Int, lo: Int, hi: Int, mode: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, rt.int_wrap(1, hi, lo)), 8)
  obj.rs_append_bytes(a, an, b, lo, hi, mode)
}

fn obj_rs_with_cap(n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, 0, 8)
  obj.rs_with_cap(n)
}

// ---------------------------------------------------------------------------
// The event loop's timer heap (zero-C audit B22 stage 1, poll.xo): t is a
