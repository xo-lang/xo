fn fiber_main(f: Int) { sched.fiber_main(f) }

fn task_claim(t: Int) -> Int { sched.task_claim(t) }

fn scope_units_done(s: Int, units: Int) -> Int { sched.scope_units_done(s, units) }

fn task_dequeued(t: Int, s: Int) -> Int { sched.task_dequeued(t, s) }

fn lock_slow(l: Int) { pool.lock_slow(l) }

fn futex_wake(a: Int) { pool.futex_wake(a) }

fn any_work(p: Int) -> Int { pool.any_work(p) }

fn register_worker(p: Int, w: Int) { pool.register_worker(p, w) }

fn worker_main(w: Int) -> Int { pool.worker_main(w) }

fn park_reset(p: Int) { pool.park_reset(p) }

fn park_signal(pl: Int, p: Int) { pool.park_signal(pl, p) }

fn park_wait(pl: Int, c: Int, cancelable: Int, counted: Int, f: Int, rw: Int) { pool.park_wait(pl, c, cancelable, counted, f, rw) }

fn node_link(n: Int, parent: Int) { pool.node_link(n, parent) }

fn node_unlink(n: Int) { pool.node_unlink(n) }

fn node_cancel(pl: Int, n: Int) { pool.node_cancel(pl, n) }

fn scope_add(pl: Int, s: Int, t: Int, w: Int) -> Int { pool.scope_add(pl, s, t, w) }

fn scope_join(pl: Int, s: Int, c: Int, f: Int, rw: Int) { pool.scope_join(pl, s, c, f, rw) }

// ---------------------------------------------------------------------------
// Fault unwinding (decision 0221): xo_rt.c's fault_raise calls
// unwind_fault on arm64 Linux and macOS. The unwind tables of generated
// code name personality's export (xo_x_personality; its C forwarder
// xo_personality in code from an older xo). With no C library the link
// defines xo_personality as the export (selfhost/xo link.xo
// sys_link_args).

/// The forced unwind of a fault (std/native/llrt/unwind.xo
/// raise): runs the first landing pad below the boundary in a frame whose
/// personality routine is pers (xo_x_personality's address) or pers_old
/// (xo_personality's, the name an older xo's emitters write) and never
/// returns then; 0 when nothing catches the fault. wcx: on Windows, the
/// caller's CONTEXT, where the walk starts.
fn unwind_fault(exc: Int, boundary: Int, pers: Int, pers_old: Int, wcx: Int) -> Int { unwind.raise(exc, boundary, pers, pers_old, wcx) }

/// The personality routine of generated code (unwind.xo
/// export_personality: unwind_fault reads the call site tables itself,
/// and this tells any other unwinder to go on).
fn personality(version: Int, actions: Int, cls: Int, exc: Int, uc: Int) -> Int { unwind.export_personality(version, actions, cls, exc, uc) }

// ---------------------------------------------------------------------------
// The fault record (std/native/llrt/fault.xo, the zero-C audit's B06):
// c is the context (xo_ctx *).

fn fault_record_set(c: Int, mp: Int, mn: Int, lp: Int, ln: Int) { fault.set(c, mp, mn, lp, ln) }

fn fault_record_detail(c: Int, p: Int, n: Int) { fault.detail(c, p, n) }

fn fault_record_clear(c: Int) { fault.clear(c) }

fn fault_record_take(c: Int) -> Int { fault.take(c) }

/// Reports the fault of c and ends the process with status 70.
fn fault_record_exit(c: Int) { fault.exit(c) }

// ---------------------------------------------------------------------------
// Contexts (std/native/llrt/ctx.xo, decision 0229; the zero-C audit's
// B17): arm64 generated code calls the shields directly; xo_rt.c's
// xo_shield_* forward to them.

fn ctx_shield_begin() -> Int { ctx.shield_begin() }

fn ctx_shield_end(tok: Int, lp: Int, ln: Int) { ctx.shield_end(tok, lp, ln) }

fn ctx_shield_abort(tok: Int) { ctx.shield_abort(tok) }

fn ctx_unwinding() -> Int { ctx.unwinding() }

/// The addresses of xo_rt.c ctx_root and its services record, at start
/// (ctx.xo init).
fn ctx_init(root: Int, svc: Int) { ctx.init(root, svc) }

// Budgets (std/native/llrt/budget.xo): arm64 generated code calls tick,
// open, and end directly; xo_rt.c's xo_tick and xo_budget_* forward, and
// its scheduler calls the rest (c a context, b a budget record).

fn budget_tick() { budget.tick() }

fn budget_open(s: Int, cpu: Int, alloc: Int, steps: Int, lp: Int, ln: Int) { budget.open(s, cpu, alloc, steps, lp, ln) }

fn budget_end(s: Int) -> Int { budget.end(s) }

fn budget_retain(b: Int) { budget.retain(b) }

fn budget_release(b: Int) { budget.release(b) }

fn budget_mark(c: Int) { budget.mark(c) }

fn budget_charge(c: Int, check: Int) { budget.charge(c, check != 0) }

fn budget_pause(c: Int) { budget.pause(c) }

fn budget_resume(c: Int) { budget.resume(c) }

// ---------------------------------------------------------------------------
// Tasks and scopes (std/native/llrt/tasks.xo, the zero-C audit's B18):
// generated code calls these directly; xo_rt.c's entry points forward.
// Addresses (t a task, s a scope, rl a list) are Ints.

fn task_done(t: Int, rl: Int, failed: Int) { tasks.task_done(t, rl, failed) }

fn task_unwound(t: Int) { tasks.task_unwound(t) }

fn task_await(t: Int, lp: Int, ln: Int) -> Int { tasks.task_await(t, lp, ln) }

fn task_result(t: Int) -> Int { tasks.task_result(t) }

fn scope_fail_task(s: Int) -> Int { tasks.scope_fail_task(s) }

fn scope_fail_site(s: Int) -> Int { tasks.scope_fail_site(s) }

fn scope_group(s: Int) -> Int { tasks.scope_group(s) }

fn fault_rethrow(s: Int) { tasks.fault_rethrow(s) }

fn scope_cancel(s: Int) { tasks.scope_cancel(s) }

fn prog_group_set(s: Int) { tasks.prog_group_set(s) }

fn prog_group_clear() { tasks.prog_group_set(0) }

fn prog_group() -> Int { tasks.prog_group() }

fn task_spawn(s: Int, fl: Int, run: Int, drop: Int, fdrop: Int, flags: Int, site: Int, lp: Int, ln: Int) -> Int { tasks.task_spawn(s, fl, run, drop, fdrop, flags, site, lp, ln) }

fn scope_open() -> Int { tasks.scope_open() }

fn scope_close(s: Int, mode: Int) -> Int { tasks.scope_close(s, mode) }
