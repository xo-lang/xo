// ---------------------------------------------------------------------------
// Fault unwinding (decision 0221): fault_raise_cur below walks the frames
// with unwind.xo raise. The unwind tables of generated code name
// personality's export, xo_x_personality, on every target.

/// The personality routine of generated code (unwind.xo
/// export_personality: unwind.xo raise reads the call site tables itself,
/// and this tells any other unwinder to go on).
fn personality(version: Int, actions: Int, cls: Int, exc: Int, uc: Int) -> Int { unwind.export_personality(version, actions, cls, exc, uc) }

// ---------------------------------------------------------------------------
// The fault record (std/native/llrt/fault.xo, the zero-C audit's B06):
// c is the context (xo_ctx *).

/// XO_TRACEBACK: prints the frames of the trace block t (fault.xo exit
/// calls it through its address, decision 0239), with each frame's
/// variables under XO_TRACEBACK=locals (decision 0268): then fault.xo
/// trace calls it at the fault (now 1), while the values are alive, and
/// the report prints the text made there.
fn fault_traceback(t: Int, now: Int) -> Int {
  if now == 1 {
    // at the fault (XO_TRACEBACK=locals): the text, kept in the block
    // (words 2 and 3) for the report
    let s = prof.trace_text_at(fault.trace_pcs(t), fault.trace_regs(t))
    let b = rt.heap_large(s.len() + 1)
    rt.mem_copy(b, raw.data(s), s.len())
    rt.mem_store(t, 16, b, 8)
    rt.mem_store(t, 24, s.len(), 8)
    return 0
  }
  if rt.mem_load(t, 16, 8) > 0 {
    stdio.write_all(2, rt.mem_load(t, 16, 8), rt.mem_load(t, 24, 8))
    return 0
  }
  let s = prof.trace_text_at(fault.trace_pcs(t), fault.trace_regs(t))
  stdio.write_all(2, raw.data(s), s.len())
  0
}

/// Raises a fault in the current context (xo_rt.c fault_raise_msg, the
/// address fault.xo's raisers call): with a message m it records it
/// first, at the zero terminated location loc (file 0) or at the position
/// (file, line, col); m 0 hands on the fault already recorded (fault.xo
/// cont). The context's real-time sections end, it is marked faulting and
/// unwinding, and unwind.xo walks from here with its exception object
/// (ctx.xo C_FAULT_EXC, at the area's first 16 byte aligned address) up
/// to its boundary, the frames of generated code named by pers (the
/// personality's address); nothing caught reports it and ends the
/// program (fault.xo exit). Never returns. Was xo_rt.c's fault_raise
/// and fault_set over the C's xo_ctx (the zero-C inventory's rank 13).
fn fault_raise_cur(m: Int, loc: Int, file: Int, line: Int, col: Int, pers: Int) {
  let c = ctx.cur()
  if m != 0 {
    if file != 0 {
      fault.set_pos(c, m, raw.cstr_len(m), file, line, col)
    } else {
      fault.set(c, m, raw.cstr_len(m), loc, raw.cstr_len(loc))
    }
  }
  rtsec.fault_leave()
  rt.mem_store(c, ctx.C_FAULTING, 1, 4)
  rt.mem_store(c, ctx.C_UNWINDING, 1, 4)
  let exc = c.wrapping_add(ctx.C_FAULT_EXC + 15) & -16
  let _r = unwind.raise(exc, rt.mem_load(c, ctx.C_BOUNDARY, 8), pers, 0)
  fault.exit(c)
}

