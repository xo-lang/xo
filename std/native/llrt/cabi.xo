// The C ABI exports of the runtime (decisions 0204, 0207): every top
// level function of this module is a global symbol xo_x_<name> with the
// C calling convention, which generated code calls (the emitters' runtime
// calls, compiler/ssa exports.xo), the runtime names by address
// (rt.fn_addr), or a `use c` binding calls back (cffi_str). The module is the
// marker: the SSA builders build every function here in every native
// program (the native prelude imports it); the modules cabi_<feature>.xo
// are markers too, imported by that feature's implementation module so
// only its programs carry them. An export none of those calls is dead
// weight in every program: since 0.17.0 none is kept for an older
// compiler's code. Parameters
// are Int (an address is an Int) or Float; the result is an Int, a
// Float, nothing, or a Str (returned as its string object, its length
// stored through a pointer the C caller passes after the parameters).
// Nothing here may fault: a fault would unwind through the C caller.
// Helpers live in other runtime modules (raw.xo for memory).
use native/llrt/alloc
use native/llrt/anyval
use native/llrt/budget
use native/llrt/dump
use native/llrt/chan
use native/llrt/consts
use native/llrt/crash
use native/llrt/ctx
use native/llrt/entry
use native/llrt/fault
use native/llrt/fsops
use native/llrt/heapos
use native/llrt/heapprof
use native/llrt/libcmem
use native/llrt/mutex
use native/llrt/num
use native/llrt/inlstr
use native/llrt/obj
use native/llrt/poll
use native/llrt/sigsub
use native/llrt/prof
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/rtsec
use native/llrt/rtstats
use native/llrt/sanhook
use native/llrt/sched
use native/llrt/selects
use native/llrt/stdin
use native/llrt/stdio
use native/llrt/stop
use native/llrt/sysio
use native/llrt/tasks
use native/llrt/trace
use native/llrt/tracerec
use native/llrt/twflags
use native/llrt/twrun
use native/llrt/unwind
use native/rt

// ---------------------------------------------------------------------------
// Number text (std/llrt xo_rt.c fmt_int, fmt_float, fmt_go_g)

/// Writes the decimal text of v and a zero byte at buf (at least 32
/// bytes); its length.
fn fmt_int(buf: Int, v: Int) -> Int {
  // the digits from the end of the first 24 bytes, then moved to buf
  var i = 24
  var x = v
  while true {
    var d = x % 10
    if d < 0 {
      d = 0 - d
    }
    i -= 1
    rt.mem_store(buf, i, 48 + d, 1)
    x = x / 10
    if x == 0 {
      break
    }
  }
  if v < 0 {
    i -= 1
    rt.mem_store(buf, i, 45, 1)
  }
  let n = 24 - i
  rt.mem_move(buf, buf + i, n)
  rt.mem_store(buf, n, 0, 1)
  n
}

// ---------------------------------------------------------------------------
// Standard output (stdio.xo, the zero-C audit's work item B03): the C
// runtime flushes it with flush before a wait, at exit, and before a
// fault's message, and with flush_try in Windows' stack overflow handler;
// xo_rt_threads_begin calls stdio_threads before a second thread runs Xo
// code.

fn flush() { stdio.flush() }

fn flush_try() { stdio.flush_try() }

/// Windows' stack overflow handler (entry.xo on_overflow, a vectored
/// exception handler; the EXCEPTION_POINTERS, EXCEPTION_CONTINUE_SEARCH
/// unless it ends the program).
fn on_overflow(e: Int) -> Int { entry.on_overflow(e) }

// ---------------------------------------------------------------------------
// The fault entry points of generated code (decision 0228; fault.xo
// raise_*): the arm64 and LLVM emitters call these exports directly. A
// checked operation passes its position as the zero terminated file name
// and the line and column, which the runtime makes into "file:line:col"
// when the fault is recorded (fault.xo set_pos); `fault(msg)` and the
// contracts pass the location's bytes (fault_raise). The raisers never
// return; continue returns on a cancellation.

fn fault_raise_text(p: Int, n: Int, file: Int, line: Int, col: Int) { fault.raise_text(p, n, file, line, col) }

fn fault_raise_overflow(a: Int, op: Int, b: Int, file: Int, line: Int, col: Int) { fault.raise_overflow(a, op, b, file, line, col) }

fn fault_raise_shl(a: Int, b: Int, file: Int, line: Int, col: Int) { fault.raise_shl(a, b, file, line, col) }

fn fault_raise_shift(n: Int, file: Int, line: Int, col: Int) { fault.raise_shift(n, file, line, col) }

fn fault_raise_divzero(a: Int, op: Int, file: Int, line: Int, col: Int) { fault.raise_divzero(a, op, file, line, col) }

fn fault_raise_neg(a: Int, file: Int, line: Int, col: Int) { fault.raise_neg(a, file, line, col) }

fn fault_raise_abs(a: Int, file: Int, line: Int, col: Int) { fault.raise_abs(a, file, line, col) }

fn fault_raise_index(i: Int, n: Int, file: Int, line: Int, col: Int) { fault.raise_index(i, n, file, line, col) }

fn fault_raise_bytes_index(i: Int, n: Int, file: Int, line: Int, col: Int) { fault.raise_bytes_index(i, n, file, line, col) }

fn fault_raise_float_int(f: Float, file: Int, line: Int, col: Int) { fault.raise_float_int(f, file, line, col) }

/// `fault(msg)` and a failed contract: the n bytes of the message at p,
/// the ln bytes of the location at lp (xo_fault_raise). Never returns.
fn fault_raise(p: Int, n: Int, lp: Int, ln: Int) { fault.raise(p, n, lp, ln) }

/// The unwind exit of a function: a fault goes on to the caller;
/// otherwise (cancellation) it returns (xo_fault_continue).
fn fault_continue() { fault.cont(rt.tlocal_get(0)) }

/// task.isolate's catch of the fault unwinding the current context: 1,
/// or 0 when it is a cancellation (xo_fault_take).
fn fault_take() -> Int { fault.take(ctx.cur()) }

/// The caught fault's message and location as string objects, the
/// length stored at lenp (xo_fault_msg, xo_fault_loc; the location
/// clears the record).
fn fault_msg(lenp: Int) -> Int { fault.msg(ctx.cur(), lenp) }

fn fault_loc(lenp: Int) -> Int { fault.loc(ctx.cur(), lenp) }

/// The line printed under the next fault: the n bytes at p (xo_fault_detail).
fn fault_detail(p: Int, n: Int) { fault.detail(ctx.cur(), p, n) }

/// Records the fault msg at loc (zero terminated) in the current context
/// and raises it; with msg 0 raises the fault already recorded (fault.xo
/// fire, cont): never returns (was xo_rt.c fault_raise_msg).
fn fault_raise_msg(m: Int, loc: Int) {
  fault_raise_cur(m, loc, 0, 0, 0, rt.fn_addr("personality"))
}

/// Raises a fault at the position (file, line, col) (fault.xo fire_pos,
/// the second raise entry the checked operations of generated code call):
/// with a message m the record's location is made from the position
/// (fault.xo set_pos); m 0 hands on the fault already recorded. Never
/// returns.
fn fault_raise_pos(m: Int, file: Int, line: Int, col: Int) {
  fault_raise_cur(m, 0, file, line, col, rt.fn_addr("personality"))
}

/// Standard input's pump thread on Windows (stdin.xo pump_main): its
/// address is the services record's (ctx.xo SV_STDIN_PUMP), a
/// CreateThread entry taking the pump's record.
fn stdin_pump_main(rec: Int) -> Int {
  crash.thread_init()
  stdin.pump_main(rec)
}

/// The hooks around a fiber switch (sanhook.xo hook, decision 0232):
/// rt.sched_hook of sched.xo calls this export.
fn sched_hook(kind: Int, w: Int, f: Int) { sanhook.hook(kind, w, f) }

// ---------------------------------------------------------------------------
// The clocks (work item B01): xo_rt.c mono_ns, the real time of
// xo_clock_now, and xo_time.c xo_tz_now read them here, through sysio.xo
// (vDSO, libSystem, or kernel32 calls).

/// The wall clock in Unix nanoseconds (never the test world's virtual
/// clock, which the C serves itself).
fn real_ns() -> Int { sysio.real_ns() }

/// The monotonic clock in nanoseconds.
fn mono_ns() -> Int { sysio.mono_ns() }

// ---------------------------------------------------------------------------
// Reference counts (decision 0207 stage 2): xo_rt.c rc_inc, rc_dec,
// rc_dec_shared, rc_claim, and xo_rc_mark, in rc.xo (rc_c.xo with
// XO_LLRT_C=rc, whose C then calls its own copies). p is the address of
// a counted object; nothing here allocates or counts.

// ---------------------------------------------------------------------------
// The heap (decision 0207 stage 3): xo_rt.c alloc_in, free_in, alloc_mt's
// and free_mt's magazines, and xo_resize, in alloc.xo (alloc_c.xo with
// XO_LLRT_C=alloc, whose C then calls its own copies). h is the calling
// thread's heap record (the C finds it), p a block; heap_alloc and
// heap_free take h last, so xo_alloc and xo_free pass their argument on
// in place. Nothing here allocates or counts.

// The heap's platform calls (zero-C audit B21, heapos.xo): the C's
// xo_heap_big, xo_heap_big_resize, xo_heap_big_release, xo_heap_grow,
// xo_heap_lock, and xo_heap_unlock forward to these (alloc.xo calls
// those as rt.heap_*). b is a big block's prefix address.

fn heap_big(n: Int) -> Int {
  let a = heapos.large(n)
  if prof.supported() && heapprof.record() != 0 {
    heapprof.big_alloc(obj.heap(), a, n)
  }
  a
}

fn heap_big_resize(b: Int, n: Int) -> Int {
  let a = heapos.large_resize(b, n)
  if prof.supported() && a != b + 8 && heapprof.record() != 0 {
    heapprof.moved(b + 8, a)
  }
  a
}

/// A big block's release, or (a header from -1 to -72: minus a size
/// class) the free of a block the heap profile sampled (alloc.xo free
/// and free_mt send it here, as a negative header): forgotten, its class
/// back, then freed by the ordinary path (which counts the free alloc.xo
/// counted already: one taken off).
fn heap_big_release(b: Int) {
  let c = rt.mem_load(b, 0, 8)
  // (in a --race build every block is big: minus a small size
  // is its prefix, not a sampled block's class; windows --race's too,
  // whose small blocks were pushed on a class's free list as sampled
  // ones, the race heap's memory in the program's heap, 2026-10-22)
  if prof.supported() && c < 0 && c > -128 && !sanhook.user_mode() && !sanhook.gorace() {
    heapprof.freed(b + 8)
    rt.mem_store(b, 0, 0 - c, 8)
    let h = obj.heap()
    rt.mem_store(h, 8, rt.mem_load(h, 8, 8) - 1, 8)
    obj.free_obj(b + 8)
    return
  }
  if prof.supported() && heapprof.record() != 0 {
    heapprof.freed(b + 8)
  }
  heapos.release(b)
}

/// The runtime's records (rt.heap_large, its resize, rt.heap_release;
/// the zero-C inventory's rank 10, 2026-10-15): libcmem.xo's allocator,
/// which the native emitters call for those (compiler/ssa exports.xo);
/// xo_rt.c's xo_heap_large and the rest forward here for code of
/// earlier compilers.
fn heap_large(n: Int) -> Int { libcmem.heap_large(n) }

fn heap_large_resize(b: Int, n: Int) -> Int { libcmem.heap_large_resize(b, n) }

fn heap_release(b: Int) { libcmem.heap_release(b) }

/// Gives heap h a new chunk and allocates n bytes again; or, with the
/// heap profile's SAMPLE added to n (alloc.xo), samples the block the
/// heap just allocated (kept in the record's PSAMPLE) and returns it.
fn heap_grow(h: Int, n: Int) -> Int {
  // alloc.xo free_mt's scavenge (decision 0383): h is a magazine of class
  // n - SCAVENGE, given back its inner pages. A seed workaround, not a new
  // rt.* name (the seed that builds this runtime knows rt.heap_grow only):
  // replace it with a named intrinsic after the next seed cut.
  if n >= SCAVENGE && n < SAMPLE {
    heapos.scavenge(h, n - SCAVENGE)
    return 0
  }
  // the per class locks of the central lists (alloc.xo clock, cunlock): h is
  // the heap, the class is added to the flag
  if n >= LOCK_SLOW && n < SCAVENGE {
    heapos.clock_slow(h, n - LOCK_SLOW)
    return 0
  }
  if n >= LOCK_WAKE && n < LOCK_SLOW {
    heapos.clock_wake(h, n - LOCK_WAKE)
    return 0
  }
  if n >= PFREED && n < LOCK_WAKE {
    // a sampled page block h freed (alloc.xo page_class): the profile
    // forgets it (as heap_big_release does for a prefixed block)
    if prof.supported() {
      heapprof.freed(h)
    }
    return 0
  }
  if prof.supported() && n >= SAMPLE {
    return heapprof.sampled(h, rt.mem_load(h, PSAMPLE, 8), n - SAMPLE)
  }
  // a page block's class (decision 0425): a new page chunk
  if alloc.page_size(n) && heapos.pages_on() {
    heapos.pchunk(h)
    return alloc.alloc(h, n)
  }
  // decision 0383 (a): a cut of the central magazines of a larger class
  // before a new chunk
  if heapos.cut_for(h, n) {
    return alloc.alloc(h, n)
  }
  heapos.chunk(h)
  alloc.alloc(h, n)
}

/// alloc.xo's SAMPLE and PSAMPLE (the heap profile's request).
const SAMPLE = 4611686018427387904
/// alloc.xo's SCAVENGE: a request to scavenge the magazine passed as h.
const SCAVENGE = 2305843009213693952
/// alloc.xo's LOCK_SLOW and LOCK_WAKE.
const LOCK_SLOW = 1152921504606846976
const LOCK_WAKE = 576460752303423488
/// rt.heap_grow(p, PFREED): page block p, sampled, is freed (alloc.xo).
const PFREED = 288230376151711744
const PSAMPLE = 10360

fn heap_lock() { heapos.lock() }

fn heap_unlock() { heapos.unlock() }

// ---------------------------------------------------------------------------
// Lists (zero-C audit B13): xo_rt.c xo_rl_new, xo_rl_copy, xo_rl_share, xo_rl_grow, xo_rl_free's work, and
// xo_rc_defer's worklist, in obj.xo. hw is the calling thread's heap
// word (the C finds it: the heap record, plus 1 when other threads run),
// h a heap record, a and l objects, p bytes, the callbacks C functions
// of generated code. Nothing here allocates Xo values, counts, or faults.

// arm64 generated code calls these directly, with no C level: obj.xo
// finds the heap itself (no hw).
fn obj_rl_new_n(n: Int, esize: Int) -> Int { obj.rl_new_n(n, esize) }

fn obj_rl_grow_n(l: Int, esize: Int) -> Int { obj.rl_grow_n(l, esize) }

fn obj_rl_free_n(l: Int, esize: Int, drop: Int) { obj.rl_free_n(l, esize, drop) }

fn obj_rl_copy_n(l: Int, esize: Int, dup: Int, drop: Int) -> Int { obj.rl_copy_n(l, esize, dup, drop) }

fn obj_rc_defer_n(o: Int, drop: Int) { obj.rc_defer_n(o, drop) }

/// A string, box, or closure environment object's block and its free at
/// zero, and a handle's free at zero, for generated code (xo_rc_alloc,
/// xo_rc_free, xo_h_free stay for code of earlier compilers).
fn obj_rc_alloc(n: Int) -> Int { obj.alloc_obj(n) }

fn obj_rc_free(p: Int) { obj.rc_free_n(p) }

fn obj_h_free(p: Int) { obj.h_free_n(p) }

/// The switch to one heap record per thread, before a second thread runs
/// Xo code (pool.xo's setup; xo_rt_threads_begin): the calling thread
/// keeps the main record, every other thread makes its own on first use
/// (heap_thread), and standard output takes its lock from now on.
fn heap_threads() {
  let h = obj.solo_heap()
  if h == 0 {
    return
  }
  heapos.set_thread_heap(h)
  obj.heap_init(0, rt.fn_addr("heap_thread"))
  stdio.threads()
}

/// The calling thread's heap record (xo_rt.c heap_slow after its thread
/// local was empty); the leak check's sums at lp and tp; class c's free
/// blocks over every record (heap statistics).
fn heap_thread() -> Int { heapos.thread_heap() }

fn obj_rl_share(l: Int, esize: Int, share: Int) { obj.rl_share(l, esize, share) }

/// Real-time sections (rtsec.xo): xo_realtime_enter, xo_realtime_exit
/// (the function's name and the call's location, as bytes), and a
/// fault's leaving of the thread's sections.
fn rt_enter() {
  // a real-time section turns deferred wakes off (decision 0077's
  // addendum), in case the program's start did not (rt_program)
  pool.defer_off(ctx.pool())
  rtsec.enter()
}

/// The start of main of a program with `uses realtime` functions (the
/// SSA builder emits rt.realtime_program there): deferred wakes off from
/// the start (decision 0077's addendum).
fn rt_program() { pool.defer_off(ctx.pool()) }

fn rt_exit(np: Int, n: Int, lp: Int, ln: Int) { rtsec.exit(np, n, lp, ln) }

// Strings (zero-C audit B13): xo_rt.c xo_rs_concat and xo_rs_append,
// xo_bytes.c's builders, in obj.xo, called by arm64 generated code
// directly and by the C entries (for LLVM and the seed). a and b are
// string (or Bytes) objects, an and bn their lengths; the result is the
// string object, its length stored at lenp (a Str result's convention).

// Decision 0330: the length words an and bn of a Str or Bytes are
// len | (off << 32); a is consumed whole (a view of it is copied), and b's
// bytes start off bytes into the object's bytes. off is unsigned: a view
// 2 GiB or more into its string has the word's sign bit set, and `>>`
// (arithmetic) made its bytes start 4 GiB early (gotchas/str-view-offset-sign.md).
fn view_data(b: Int, bn: Int) -> Int { b.wrapping_add(16).wrapping_add(bn.shr_logical(32)) }

/// The fault for a length over the 4 GiB a Str or Bytes may hold (the
/// length is 32 bits of the second word, decision 0330). Callers test the
/// bound themselves, in line: a call to a checking function cost 6% of
/// Layout.format (one per pushed byte).
fn len_over() {
  fault.raise_str_at("Str or Bytes longer than 4 GiB (4294967295 bytes)", 0, 0)
}

fn obj_rs_concat(a: Int, an: Int, b: Int, bn: Int) -> Int {
  if (an & 4294967295).wrapping_add(bn & 4294967295) > 4294967295 {
    len_over()
  }
  if inlstr.built() && inlstr.is_inline(b) {
    return obj.rs_append_inline(a, an, b, bn)
  }
  obj.rs_append(a, an, view_data(b, bn), bn & 4294967295)
}

fn obj_rs_append(a: Int, an: Int, b: Int, bn: Int, lenp: Int) -> Int {
  let n = (an & 4294967295).wrapping_add(bn & 4294967295)
  if n > 4294967295 {
    len_over()
  }
  rt.mem_store(lenp, 0, n, 8)
  if inlstr.built() && inlstr.is_inline(b) {
    return obj.rs_append_inline(a, an, b, bn)
  }
  obj.rs_append(a, an, view_data(b, bn), bn & 4294967295)
}

fn obj_rs_push_byte(a: Int, an: Int, x: Int, lenp: Int) -> Int {
  let n = (an & 4294967295).wrapping_add(1)
  if n > 4294967295 {
    len_over()
  }
  rt.mem_store(lenp, 0, n, 8)
  obj.rs_push_byte(a, an, x)
}

fn obj_rs_push_word(a: Int, an: Int, w: Int, n: Int, lenp: Int) -> Int {
  let t = (an & 4294967295).wrapping_add(n)
  if t > 4294967295 {
    len_over()
  }
  if inlstr.built() && t <= inlstr.MAX && !obj.keep_object(a) {
    return obj.inline_push(a, an, w, n, lenp)
  }
  rt.mem_store(lenp, 0, t, 8)
  obj.rs_push_word(a, an, w)
}

fn obj_rs_push_words(a: Int, an: Int, w0: Int, w1: Int, w2: Int, w3: Int, lens: Int, lenp: Int) -> Int {
  let k = ((lens & 15).wrapping_add((lens >> 4) & 15)).wrapping_add(((lens >> 8) & 15).wrapping_add((lens >> 12) & 15))
  let t = (an & 4294967295).wrapping_add(k)
  if t > 4294967295 {
    len_over()
  }
  if inlstr.built() && t <= inlstr.MAX && !obj.keep_object(a) {
    return obj.inline_push_words(a, an, w0, w1, w2, w3, lens, lenp)
  }
  rt.mem_store(lenp, 0, t, 8)
  obj.rs_push_words(a, an, w0, w1, w2, w3, lens)
}

fn obj_rs_append_bytes(a: Int, an: Int, b: Int, bn: Int, lo: Int, hi: Int, mode: Int, lenp: Int) -> Int {
  let n = (an & 4294967295).wrapping_add(hi.wrapping_sub(lo))
  if n > 4294967295 || n < 0 {
    len_over()
  }
  rt.mem_store(lenp, 0, n, 8)
  if inlstr.built() && inlstr.is_inline(b) {
    return obj.rs_append_bytes_inline(a, an, b, bn, lo, hi, mode)
  }
  if inlstr.built() && mode == 0 && n <= inlstr.MAX && n > 0 && !obj.keep_object(a) {
    // a short result keeps its text in its words (decision 0370)
    return obj.inline_append(a, an, b.wrapping_add(bn.shr_logical(32)).wrapping_add(16 + lo), hi.wrapping_sub(lo), lenp)
  }
  obj.rs_append_bytes(a, an, b.wrapping_add(bn.shr_logical(32)), lo, hi, mode)
}

fn obj_rs_with_cap(n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, 0, 8)
  obj.rs_with_cap(n)
}

/// The Str results of the C adapters of `use c` (compiler/cli/bind
/// gen.xo, decision 0116; was xo_std.c xo_cffi_str): a new string of the
/// n bytes at p, its length stored at lenp.
fn cffi_str(p: Int, n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, n, 8)
  obj.rs_append(obj.rs_with_cap(n), 0, p, n)
}

// ---------------------------------------------------------------------------
// The event loop's timer heap (zero-C audit B22 stage 1, poll.xo): t is a
// timer record (poll.xo T_*); the event loop's lock is held.

/// Where the poller thread starts (pool.thread_start of its address, from
/// the services record; never returns).
fn poll_thread(a: Int) -> Int {
  crash.thread_init()
  poll.poll_thread()
  a
}

/// The event loop's start, a descriptor's registration (the record, or
/// minus the errno), and timers (xo_rt.c's ev_start, pd_new, timer_add,
/// timer_del forward here).
fn poll_ev_start() { poll.ev_start() }

fn poll_timer_add(t: Int) { poll.timer_add(t) }

fn poll_timer_del(t: Int) { poll.timer_del(t) }

/// A wait of poll.xo's (through rt.fn_addr): park context c until its
/// park is signaled or it is canceled, not counted as blocked.
fn poll_park_wait(c: Int) { tasks.park_wait_n(c, true, false) }

/// A worker's poll of the network (decision 0324, pool.xo np_poll):
/// waits at most wait ns (-1 no limit) for the next event or timer; the
/// events handled, or -1 when it did not poll.
fn np_poll(wait: Int, a: Int) -> Int { poll.np_poll(wait, a) }

/// Breaks a worker's wait in the network poller (decision 0324, pool.xo
/// np_break).
fn np_break(a: Int, b: Int) -> Int {
  poll.np_break()
  a
}

// The clock and cancellation checks of generated code (compiler/ssa
// exports.xo; xo_rt.c's xo_clock_now and the rest stay for code of
// compilers up to 0.12.0).

/// rt.clock_now: the virtual clock in the test world, else the wall
/// clock.
fn clock_now() -> Int { poll.wall_now() }

/// `clock.sleep(d)`: a cancellation point that unwinds, also while it
/// waits (core 7.2). The test world records the sleep first
/// (FakeClock.sleeps()).
fn clock_sleep(d: Int) {
  let c = ctx.cur()
  if twflags.on() && !budget.canceled(c) {
    twrun.sleep_record(d)
  }
  if poll.clock_wait(c, d) {
    let _u = tasks.canceled(c)
  }
}

/// `clock.sleep_or_cancel(d)` (decision 0088): 1 when the task was
/// canceled before or during the sleep.
fn clock_sleep_or_cancel(d: Int) -> Int {
  let c = ctx.cur()
  if twflags.on() && !budget.canceled(c) {
    twrun.sleep_record(d)
  }
  if poll.clock_wait(c, d) { 1 } else { 0 }
}

/// A select's `after d` arm.
fn select_after(s: Int, d: Int) { selects.after(s, d) }

/// `task.is_canceled()`.
