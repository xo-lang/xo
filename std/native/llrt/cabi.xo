  let pc = if sanhook.gorace() || sanhook.user_mode() { rt.mem_load(rt.frame_addr(), 8, 8) } else { 0 }
  tasks.task_spawn_fn(s, code, env, run, drop, fdrop, flags, site, lp, ln, pc)
}

