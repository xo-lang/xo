fn poll_timer_push(t: Int) -> Int { poll.timer_push(t) }

fn poll_timer_remove(t: Int) { poll.timer_remove(t) }

fn poll_timer_first() -> Int { poll.timer_first() }

// ---------------------------------------------------------------------------
// The scheduler core (decision 0212): xo_rt.c's fiber code and task
// states, in sched.xo, and the worker pool, the locks' slow paths, and
