// The C ABI exports of the runtime (decisions 0204, 0207): every top
// level function of this module is a global symbol xo_x_<name> with the
// C calling convention, which generated code calls (the emitters' runtime
// calls, selfhost/ssa exports.xo), the runtime names by address
// (rt.fn_addr), or a `use c` binding calls back (cffi_str). The module is the
// marker: the SSA builders build every function here in every native
// program (the native prelude imports it); the modules cabi_<feature>.xo
// are markers too, imported by that feature's implementation module so
// only its programs carry them. An export none of those calls is dead
// weight in every program: since 0.17.0 none is kept for an older
// compiler's code. Parameters
// are Int (an address is an Int) or Float; the result is an Int, a
// Float, nothing, or a Str (returned as its string object, its length
// stored through a pointer the C caller passes after the parameters).
// Nothing here may fault: a fault would unwind through the C caller.
// Helpers live in other runtime modules (raw.xo for memory).
use native/llrt/alloc
use native/llrt/anyval
use native/llrt/budget
use native/llrt/chan
use native/llrt/consts
use native/llrt/ctx
use native/llrt/entry
use native/llrt/fault
use native/llrt/fsops
use native/llrt/heapos
use native/llrt/heapprof
use native/llrt/libcmem
use native/llrt/mutex
use native/llrt/num
use native/llrt/obj
use native/llrt/poll
use native/llrt/prof
use native/llrt/pool
use native/llrt/process
use native/llrt/raw
use native/llrt/rtsec
use native/llrt/rtstats
use native/llrt/sanhook
use native/llrt/sched
use native/llrt/selects
use native/llrt/stdin
use native/llrt/stdio
use native/llrt/stop
use native/llrt/sysio
use native/llrt/tasks
use native/llrt/twflags
use native/llrt/twrun
use native/llrt/unwind
use native/rt

// ---------------------------------------------------------------------------
// Number text (std/llrt xo_rt.c fmt_int, fmt_float, fmt_go_g)

/// Writes the decimal text of v and a zero byte at buf (at least 32
/// bytes); its length.
fn fmt_int(buf: Int, v: Int) -> Int {
  // the digits from the end of the first 24 bytes, then moved to buf
  var i = 24
  var x = v
  while true {
    var d = x % 10
    if d < 0 {
      d = 0 - d
    }
    i -= 1
    rt.mem_store(buf, i, 48 + d, 1)
    x = x / 10
    if x == 0 {
      break
    }
  }
  if v < 0 {
    i -= 1
    rt.mem_store(buf, i, 45, 1)
  }
  let n = 24 - i
  rt.mem_move(buf, buf + i, n)
  rt.mem_store(buf, n, 0, 1)
  n
}

// ---------------------------------------------------------------------------
// Standard output (stdio.xo, the zero-C audit's work item B03): the C
// runtime flushes it with flush before a wait, at exit, and before a
// fault's message, and with flush_try in Windows' stack overflow handler;
// xo_rt_threads_begin calls stdio_threads before a second thread runs Xo
// code.

fn flush() { stdio.flush() }

fn flush_try() { stdio.flush_try() }

/// Windows' stack overflow handler (entry.xo on_overflow, a vectored
/// exception handler; the EXCEPTION_POINTERS, EXCEPTION_CONTINUE_SEARCH
/// unless it ends the program).
fn on_overflow(e: Int) -> Int { entry.on_overflow(e) }

// ---------------------------------------------------------------------------
// The fault entry points of generated code (decision 0228; fault.xo
// raise_*): the arm64 and LLVM emitters call these exports directly
// (loc is the zero terminated location); xo_rt.c's xo_fault_* forward
// to them for code from an xo whose emitters named those. The raisers
// never return; continue returns on a cancellation.

fn fault_raise_text(p: Int, n: Int, loc: Int) { fault.raise_text(p, n, loc) }

fn fault_raise_overflow(a: Int, op: Int, b: Int, loc: Int) { fault.raise_overflow(a, op, b, loc) }

fn fault_raise_shl(a: Int, b: Int, loc: Int) { fault.raise_shl(a, b, loc) }

fn fault_raise_shift(n: Int, loc: Int) { fault.raise_shift(n, loc) }

fn fault_raise_divzero(a: Int, op: Int, loc: Int) { fault.raise_divzero(a, op, loc) }

fn fault_raise_neg(a: Int, loc: Int) { fault.raise_neg(a, loc) }

fn fault_raise_abs(a: Int, loc: Int) { fault.raise_abs(a, loc) }

fn fault_raise_index(i: Int, n: Int, loc: Int) { fault.raise_index(i, n, loc) }

fn fault_raise_bytes_index(i: Int, n: Int, loc: Int) { fault.raise_bytes_index(i, n, loc) }

fn fault_raise_float_int(f: Float, loc: Int) { fault.raise_float_int(f, loc) }

/// `fault(msg)` and a failed contract: the n bytes of the message at p,
/// the ln bytes of the location at lp (xo_fault_raise). Never returns.
fn fault_raise(p: Int, n: Int, lp: Int, ln: Int) { fault.raise(p, n, lp, ln) }

/// The unwind exit of a function: a fault goes on to the caller;
/// otherwise (cancellation) it returns (xo_fault_continue).
fn fault_continue() { fault.cont(rt.tlocal_get(0)) }

/// task.isolate's catch of the fault unwinding the current context: 1,
/// or 0 when it is a cancellation (xo_fault_take).
fn fault_take() -> Int { fault.take(ctx.cur()) }

/// The caught fault's message and location as string objects, the
/// length stored at lenp (xo_fault_msg, xo_fault_loc; the location
/// clears the record).
fn fault_msg(lenp: Int) -> Int { fault.msg(ctx.cur(), lenp) }

fn fault_loc(lenp: Int) -> Int { fault.loc(ctx.cur(), lenp) }

/// The line printed under the next fault: the n bytes at p (xo_fault_detail).
fn fault_detail(p: Int, n: Int) { fault.detail(ctx.cur(), p, n) }

/// Records the fault msg at loc (zero terminated) in the current context
/// and raises it; with msg 0 raises the fault already recorded (fault.xo
/// fire, cont): never returns (was xo_rt.c fault_raise_msg).
fn fault_raise_msg(m: Int, loc: Int) {
  fault_raise_cur(m, loc, rt.fn_addr("personality"))
}

/// Standard input's pump thread on Windows (stdin.xo pump_main): its
/// address is the services record's (ctx.xo SV_STDIN_PUMP), a
/// CreateThread entry taking the pump's record.
fn stdin_pump_main(rec: Int) -> Int { stdin.pump_main(rec) }

/// The hooks around a fiber switch (sanhook.xo hook, decision 0232):
/// rt.sched_hook of sched.xo calls this export.
fn sched_hook(kind: Int, w: Int, f: Int) { sanhook.hook(kind, w, f) }

// ---------------------------------------------------------------------------
// The clocks (work item B01): xo_rt.c mono_ns, the real time of
// xo_clock_now, and xo_time.c xo_tz_now read them here, through sysio.xo
// (vDSO, libSystem, or kernel32 calls).

/// The wall clock in Unix nanoseconds (never the test world's virtual
/// clock, which the C serves itself).
fn real_ns() -> Int { sysio.real_ns() }

/// The monotonic clock in nanoseconds.
fn mono_ns() -> Int { sysio.mono_ns() }

// ---------------------------------------------------------------------------
// Reference counts (decision 0207 stage 2): xo_rt.c rc_inc, rc_dec,
// rc_dec_shared, rc_claim, and xo_rc_mark, in rc.xo (rc_c.xo with
// XO_LLRT_C=rc, whose C then calls its own copies). p is the address of
// a counted object; nothing here allocates or counts.

// ---------------------------------------------------------------------------
// The heap (decision 0207 stage 3): xo_rt.c alloc_in, free_in, alloc_mt's
// and free_mt's magazines, and xo_resize, in alloc.xo (alloc_c.xo with
// XO_LLRT_C=alloc, whose C then calls its own copies). h is the calling
// thread's heap record (the C finds it), p a block; heap_alloc and
// heap_free take h last, so xo_alloc and xo_free pass their argument on
// in place. Nothing here allocates or counts.

// The heap's platform calls (zero-C audit B21, heapos.xo): the C's
// xo_heap_big, xo_heap_big_resize, xo_heap_big_release, xo_heap_grow,
// xo_heap_lock, and xo_heap_unlock forward to these (alloc.xo calls
// those as rt.heap_*). b is a big block's prefix address.

fn heap_big(n: Int) -> Int {
  let a = heapos.large(n)
  if heapprof.record() != 0 {
    heapprof.big_alloc(obj.heap(), a, n)
  }
  a
}

fn heap_big_resize(b: Int, n: Int) -> Int {
  let a = heapos.large_resize(b, n)
  if a != b + 8 && heapprof.record() != 0 {
    heapprof.moved(b + 8, a)
  }
  a
}

/// A big block's release, or (a header from -1 to -72: minus a size
/// class) the free of a block the heap profile sampled (alloc.xo free
/// and free_mt send it here, as a negative header): forgotten, its class
/// back, then freed by the ordinary path (which counts the free alloc.xo
/// counted already: one taken off).
fn heap_big_release(b: Int) {
  let c = rt.mem_load(b, 0, 8)
  if c < 0 && c > -128 {
    heapprof.freed(b + 8)
    rt.mem_store(b, 0, 0 - c, 8)
    let h = obj.heap()
    rt.mem_store(h, 8, rt.mem_load(h, 8, 8) - 1, 8)
    obj.free_obj(b + 8)
    return
  }
  if heapprof.record() != 0 {
    heapprof.freed(b + 8)
  }
  heapos.release(b)
}

/// The runtime's records (rt.heap_large, its resize, rt.heap_release;
/// the zero-C inventory's rank 10, 2026-10-15): libcmem.xo's allocator,
/// which the native emitters call for those (selfhost/ssa exports.xo);
/// xo_rt.c's xo_heap_large and the rest forward here for code of
/// earlier compilers.
fn heap_large(n: Int) -> Int { libcmem.heap_large(n) }

fn heap_large_resize(b: Int, n: Int) -> Int { libcmem.heap_large_resize(b, n) }

fn heap_release(b: Int) { libcmem.heap_release(b) }

/// Gives heap h a new chunk and allocates n bytes again; or, with the
/// heap profile's SAMPLE added to n (alloc.xo), samples the block the
/// heap just allocated (kept in the record's PSAMPLE) and returns it.
fn heap_grow(h: Int, n: Int) -> Int {
  if n >= SAMPLE {
    return heapprof.sampled(h, rt.mem_load(h, PSAMPLE, 8), n - SAMPLE)
  }
  heapos.chunk(h)
  alloc.alloc(h, n)
}

/// alloc.xo's SAMPLE and PSAMPLE (the heap profile's request).
const SAMPLE = 4611686018427387904
const PSAMPLE = 10360

fn heap_lock() { heapos.lock() }

fn heap_unlock() { heapos.unlock() }

// ---------------------------------------------------------------------------
// Lists (zero-C audit B13): xo_rt.c xo_rl_new, xo_rl_copy, xo_rl_share, xo_rl_grow, xo_rl_free's work, and
// xo_rc_defer's worklist, in obj.xo. hw is the calling thread's heap
// word (the C finds it: the heap record, plus 1 when other threads run),
// h a heap record, a and l objects, p bytes, the callbacks C functions
// of generated code. Nothing here allocates Xo values, counts, or faults.

// arm64 generated code calls these directly, with no C level: obj.xo
// finds the heap itself (no hw).
fn obj_rl_new_n(n: Int, esize: Int) -> Int { obj.rl_new_n(n, esize) }

fn obj_rl_grow_n(l: Int, esize: Int) -> Int { obj.rl_grow_n(l, esize) }

fn obj_rl_free_n(l: Int, esize: Int, drop: Int) { obj.rl_free_n(l, esize, drop) }

fn obj_rl_copy_n(l: Int, esize: Int, dup: Int, drop: Int) -> Int { obj.rl_copy_n(l, esize, dup, drop) }

fn obj_rc_defer_n(o: Int, drop: Int) { obj.rc_defer_n(o, drop) }

/// A string, box, or closure environment object's block and its free at
/// zero, and a handle's free at zero, for generated code (xo_rc_alloc,
/// xo_rc_free, xo_h_free stay for code of earlier compilers).
fn obj_rc_alloc(n: Int) -> Int { obj.alloc_obj(n) }

fn obj_rc_free(p: Int) { obj.rc_free_n(p) }

fn obj_h_free(p: Int) { obj.h_free_n(p) }

/// The switch to one heap record per thread, before a second thread runs
/// Xo code (pool.xo's setup; xo_rt_threads_begin): the calling thread
/// keeps the main record, every other thread makes its own on first use
/// (heap_thread), and standard output takes its lock from now on.
fn heap_threads() {
  let h = obj.solo_heap()
  if h == 0 {
    return
  }
  heapos.set_thread_heap(h)
  obj.heap_init(0, rt.fn_addr("heap_thread"))
  stdio.threads()
}

/// The calling thread's heap record (xo_rt.c heap_slow after its thread
/// local was empty); the leak check's sums at lp and tp; class c's free
/// blocks over every record (heap statistics).
fn heap_thread() -> Int { heapos.thread_heap() }

fn obj_rl_share(l: Int, esize: Int, share: Int) { obj.rl_share(l, esize, share) }

/// Real-time sections (rtsec.xo): xo_realtime_enter, xo_realtime_exit
/// (the function's name and the call's location, as bytes), and a
/// fault's leaving of the thread's sections.
fn rt_enter() {
  // a real-time section turns deferred wakes off (decision 0077's
  // addendum), in case the program's start did not (rt_program)
  pool.defer_off(ctx.pool())
  rtsec.enter()
}

/// The start of main of a program with `uses realtime` functions (the
/// SSA builder emits rt.realtime_program there): deferred wakes off from
/// the start (decision 0077's addendum).
fn rt_program() { pool.defer_off(ctx.pool()) }

fn rt_exit(np: Int, n: Int, lp: Int, ln: Int) { rtsec.exit(np, n, lp, ln) }

// Strings (zero-C audit B13): xo_rt.c xo_rs_concat and xo_rs_append,
// xo_bytes.c's builders, in obj.xo, called by arm64 generated code
// directly and by the C entries (for LLVM and the seed). a and b are
// string (or Bytes) objects, an and bn their lengths; the result is the
// string object, its length stored at lenp (a Str result's convention).

fn obj_rs_concat(a: Int, an: Int, b: Int, bn: Int) -> Int { obj.rs_append(a, an, rt.int_wrap(0, b, 16), bn) }

fn obj_rs_append(a: Int, an: Int, b: Int, bn: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, bn), 8)
  obj.rs_append(a, an, rt.int_wrap(0, b, 16), bn)
}

fn obj_rs_push_byte(a: Int, an: Int, x: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, 1), 8)
  obj.rs_push_byte(a, an, x)
}

fn obj_rs_push_word(a: Int, an: Int, w: Int, n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, n), 8)
  obj.rs_push_word(a, an, w)
}

fn obj_rs_push_words(a: Int, an: Int, w0: Int, w1: Int, w2: Int, w3: Int, lens: Int, lenp: Int) -> Int {
  let k = rt.int_wrap(0, rt.int_wrap(0, lens & 15, (lens >> 4) & 15), rt.int_wrap(0, (lens >> 8) & 15, (lens >> 12) & 15))
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, k), 8)
  obj.rs_push_words(a, an, w0, w1, w2, w3, lens)
}

fn obj_rs_append_bytes(a: Int, an: Int, b: Int, bn: Int, lo: Int, hi: Int, mode: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, rt.int_wrap(1, hi, lo)), 8)
  obj.rs_append_bytes(a, an, b, lo, hi, mode)
}

fn obj_rs_with_cap(n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, 0, 8)
  obj.rs_with_cap(n)
}

/// The Str results of the C adapters of `use c` (selfhost/cli/bind
/// gen.xo, decision 0116; was xo_std.c xo_cffi_str): a new string of the
/// n bytes at p, its length stored at lenp.
fn cffi_str(p: Int, n: Int, lenp: Int) -> Int {
  rt.mem_store(lenp, 0, n, 8)
  obj.rs_append(obj.rs_with_cap(n), 0, p, n)
}

// ---------------------------------------------------------------------------
// The event loop's timer heap (zero-C audit B22 stage 1, poll.xo): t is a
// timer record (poll.xo T_*); the event loop's lock is held.

/// Where the poller thread starts (pool.thread_start of its address, from
/// the services record; never returns).
fn poll_thread(a: Int) -> Int {
  poll.poll_thread()
  a
}

/// The event loop's start, a descriptor's registration (the record, or
/// minus the errno), and timers (xo_rt.c's ev_start, pd_new, timer_add,
/// timer_del forward here).
fn poll_ev_start() { poll.ev_start() }

fn poll_timer_add(t: Int) { poll.timer_add(t) }

fn poll_timer_del(t: Int) { poll.timer_del(t) }

/// A wait of poll.xo's (through rt.fn_addr): park context c until its
/// park is signaled or it is canceled, not counted as blocked.
fn poll_park_wait(c: Int) { tasks.park_wait_n(c, true, false) }

// The clock and cancellation checks of generated code (selfhost/ssa
// exports.xo; xo_rt.c's xo_clock_now and the rest stay for code of
// compilers up to 0.12.0).

/// rt.clock_now: the virtual clock in the test world, else the wall
/// clock.
fn clock_now() -> Int { poll.wall_now() }

/// `clock.sleep(d)`: a cancellation point that unwinds, also while it
/// waits (core 7.2). The test world records the sleep first
/// (FakeClock.sleeps()).
fn clock_sleep(d: Int) {
  let c = ctx.cur()
  if twflags.on() && !budget.canceled(c) {
    twrun.sleep_record(d)
  }
  if poll.clock_wait(c, d) {
    let _u = tasks.canceled(c)
  }
}

/// `clock.sleep_or_cancel(d)` (decision 0088): 1 when the task was
/// canceled before or during the sleep.
fn clock_sleep_or_cancel(d: Int) -> Int {
  let c = ctx.cur()
  if twflags.on() && !budget.canceled(c) {
    twrun.sleep_record(d)
  }
  if poll.clock_wait(c, d) { 1 } else { 0 }
}

/// A select's `after d` arm.
fn select_after(s: Int, d: Int) { selects.after(s, d) }

/// `task.is_canceled()`.
fn is_canceled() -> Int { if tasks.is_canceled() { 1 } else { 0 } }

/// task.with_timeout (tasks.xo): the scope's deadline, and whether it
/// ended the body.
fn scope_deadline(s: Int, d: Int) { tasks.scope_deadline(s, d) }

fn scope_timed_out(s: Int) -> Int { if tasks.scope_timed_out(s) { 1 } else { 0 } }

/// The SIGINT and SIGTERM handler that entry.xo installs (sigaction's
/// handler: the signal number, unused).
fn on_signal(sig: Int) { poll.on_signal() }

/// SIGPROF's handler that prof.xo installs (SA_SIGINFO: the signal, its
/// siginfo, the interrupted thread's ucontext).
fn on_prof(sig: Int, info: Int, uc: Int) { prof.on_signal(uc) }

/// Writes the sampling profile now (process.xo exit: os.proc.exit does
/// not return to entry.xo main's end).
fn prof_finish() { prof.finish() }

/// Windows' console handler that entry.xo installs (SetConsoleCtrlHandler:
/// the event, a DWORD; 1 when handled).
fn on_console(kind: Int) -> Int { poll.on_console(kind) }

fn stop_cancel() { stop.cancel() }

fn stop_requested() -> Int { if stop.requested() { 1 } else { 0 } }

fn stop_stopping(drop: Int) -> Int { stop.stopping(drop) }

/// task.stopping's channel (stop.xo calls it through rt.fn_addr: chan.xo
/// sits above stop.xo in the imports): unbuffered, closed from outside
/// the program's tasks (CH_EXT, so waiting for it does not count as
/// blocked), its faults located at "task.stopping".
fn stop_chan_new(drop: Int) -> Int {
  let loc = "task.stopping"
  let ch = chan.new(0, drop, raw.data(loc), loc.len())
  rt.mem_store(ch, chan.CH_EXT, 1, 4)
  ch
}

fn stop_set_grace(d: Int) { stop.set_grace(d) }


/// The C function main's threads run (entry.xo run_main, the fault
/// boundary), with xo_entry's address.
fn run_main(entry_fn: Int) -> Int {
  entry.run_main(entry_fn)
  0
}

// ---------------------------------------------------------------------------
// The scheduler core (decision 0212): xo_rt.c's fiber code and task
// states, in sched.xo, and the worker pool, the locks' slow paths, and
// the fiber stacks, in pool.xo (stage 2; their C path, XO_LLRT_C=sched,
// was deleted on 2026-10-14). Addresses are of the C runtime's
// records; nothing here allocates Xo values, counts, or faults.
// fiber_main's and worker_main's addresses are where a fiber and a
// worker thread start.

fn fiber_main(f: Int) { sched.fiber_main(f) }

fn scope_units_done(s: Int, units: Int) -> Int { sched.scope_units_done(s, units) }

fn lock_slow(l: Int) { pool.lock_slow(l) }

fn futex_wake(a: Int) { pool.futex_wake(a) }

fn worker_main(w: Int) -> Int { pool.worker_main(w) }

/// The deferred wakes' monitor thread (pool.xo mon_main, decision 0077's
/// addendum).
fn mon_main(p: Int) -> Int { pool.mon_main(p) }

fn park_reset(p: Int) { pool.park_reset(p) }



fn node_link(n: Int, parent: Int) { pool.node_link(n, parent) }

fn node_unlink(n: Int) { pool.node_unlink(n) }


fn scope_add(pl: Int, s: Int, t: Int, w: Int) -> Int { pool.scope_add(pl, s, t, w) }

fn scope_join(pl: Int, s: Int, c: Int, f: Int, rw: Int) { pool.scope_join(pl, s, c, f, rw) }

// ---------------------------------------------------------------------------
// Fault unwinding (decision 0221): fault_raise_cur below walks the frames
// with unwind.xo raise. The unwind tables of generated code name
// personality's export, xo_x_personality, on every target.

/// The personality routine of generated code (unwind.xo
/// export_personality: unwind.xo raise reads the call site tables itself,
/// and this tells any other unwinder to go on).
fn personality(version: Int, actions: Int, cls: Int, exc: Int, uc: Int) -> Int { unwind.export_personality(version, actions, cls, exc, uc) }

// ---------------------------------------------------------------------------
// The fault record (std/native/llrt/fault.xo, the zero-C audit's B06):
// c is the context (xo_ctx *).

/// XO_TRACEBACK: prints the frames of the trace block t (fault.xo exit
/// calls it through its address, decision 0239).
fn fault_traceback(t: Int, _u: Int) -> Int {
  let s = prof.trace_text(fault.trace_pcs(t))
  stdio.write_all(2, raw.data(s), s.len())
  0
}

/// Raises a fault in the current context (xo_rt.c fault_raise_msg, the
/// address fault.xo's raisers call): with a message m (zero terminated,
/// at the zero terminated location loc) it records it first; m 0 hands
/// on the fault already recorded (fault.xo cont). The context's real-time
/// sections end, it is marked faulting and unwinding, and unwind.xo
/// walks from here with its exception object (ctx.xo C_FAULT_EXC, at the
/// area's first 16 byte aligned address) up to its boundary, the frames
/// of generated code named by pers (the personality's address);
/// nothing caught reports it and ends the
/// program (fault.xo exit). Never returns. Was xo_rt.c's fault_raise
/// and fault_set over the C's xo_ctx (the zero-C inventory's rank 13).
fn fault_raise_cur(m: Int, loc: Int, pers: Int) {
  let c = ctx.cur()
  if m != 0 {
    fault.set(c, m, raw.cstr_len(m), loc, raw.cstr_len(loc))
  }
  rtsec.fault_leave()
  rt.mem_store(c, ctx.C_FAULTING, 1, 4)
  rt.mem_store(c, ctx.C_UNWINDING, 1, 4)
  let exc = rt.int_wrap(0, c, ctx.C_FAULT_EXC + 15) & -16
  let _r = unwind.raise(exc, rt.mem_load(c, ctx.C_BOUNDARY, 8), pers, 0)
  fault.exit(c)
}

// ---------------------------------------------------------------------------
// Contexts (std/native/llrt/ctx.xo, decision 0229; the zero-C audit's
// B17): arm64 generated code calls the shields directly; xo_rt.c's
// xo_shield_* forward to them.

fn ctx_shield_begin() -> Int { ctx.shield_begin() }

fn ctx_shield_end(tok: Int, lp: Int, ln: Int) { ctx.shield_end(tok, lp, ln) }

fn ctx_shield_abort(tok: Int) { ctx.shield_abort(tok) }

fn ctx_unwinding() -> Int { ctx.unwinding() }

/// The statistics' switch and counts (rtstats.xo), for stop.xo's
/// services record (entry.xo rt_stats).
fn rtstats_switch() -> Int { rtstats.rec() }

fn rtstats_counts() -> Int { rtstats.counts() }

/// Runs the task of fiber f, which just started (sched.xo fiber_main;
/// xo_rt.c xo_sched_run_task): it came from a queue, so its entry and its
/// run end here; its spawn released it.
fn fiber_run_task(f: Int) {
  let t = rt.mem_load(f, 24, 8)
  sanhook.acquire(t)
  tasks.run_claimed(t, 4)
}

/// "fault: out of memory" and the end of the process (pool.xo).
fn oom() { heapos.oom() }

/// A fiber stack's mapping failed with errno en (0: unknown): out of
/// address space more often than of memory (stacks are reserved, not
/// committed), so it says how much the stacks took
/// (gotchas/linux-tsan-fiber-stacks.md), then out of memory (pool.xo;
/// xo_rt.c fiber_map_failed).
fn fiber_map_failed(en: Int) {
  let fs = rt.mem_load(ctx.svc(), ctx.SV_FIBERS, 8)
  let mib = rt.mem_load(fs, 24, 8) / 1048576
  let m = "xo: fiber stack mmap failed (${sysio.err_msg(sysio.layer(), en)}) with ${rtstats.fibers_live()} stacks of ${mib} MiB mapped\n"
  stdio.write_all(2, raw.data(m), m.len())
  heapos.oom()
}

// Budgets (std/native/llrt/budget.xo): arm64 generated code calls tick,
// open, and end directly; xo_rt.c's xo_tick and xo_budget_* forward, and
// its scheduler calls the rest (c a context, b a budget record).

fn budget_tick() { budget.tick() }

fn budget_open(s: Int, cpu: Int, alloc: Int, steps: Int, lp: Int, ln: Int) { budget.open(s, cpu, alloc, steps, lp, ln) }

fn budget_end(s: Int) -> Int { budget.end(s) }

// ---------------------------------------------------------------------------
// Tasks and scopes (std/native/llrt/tasks.xo, the zero-C audit's B18):
// generated code calls these directly; xo_rt.c's entry points forward.
// Addresses (t a task, s a scope, rl a list) are Ints.

fn task_done(t: Int, rl: Int, failed: Int) { tasks.task_done(t, rl, failed) }

fn task_unwound(t: Int) { tasks.task_unwound(t) }

fn task_await(t: Int, lp: Int, ln: Int) -> Int { tasks.task_await(t, lp, ln) }

fn task_result(t: Int) -> Int { tasks.task_result(t) }

fn scope_fail_task(s: Int) -> Int { tasks.scope_fail_task(s) }

fn scope_fail_site(s: Int) -> Int { tasks.scope_fail_site(s) }

fn scope_group(s: Int) -> Int { tasks.scope_group(s) }

fn fault_rethrow(s: Int) { tasks.fault_rethrow(s) }

fn scope_cancel(s: Int) { tasks.scope_cancel(s) }

fn prog_group_set(s: Int) { tasks.prog_group_set(s) }

fn prog_group_clear() { tasks.prog_group_set(0) }

fn prog_group() -> Int { tasks.prog_group() }

fn task_spawn(s: Int, fl: Int, run: Int, drop: Int, fdrop: Int, flags: Int, site: Int, lp: Int, ln: Int) -> Int { tasks.task_spawn(s, fl, run, drop, fdrop, flags, site, lp, ln) }

fn scope_open() -> Int { tasks.scope_open() }

fn scope_close(s: Int, mode: Int) -> Int { tasks.scope_close(s, mode) }

// Mutex[T] (std/native/llrt/mutex.xo, B19): generated code calls these
// directly; xo_rt.c's entry points forward. m a Mutex, l its value list.

fn mutex_new(l: Int, drop: Int) -> Int { mutex.new(l, drop) }

fn mutex_lock(m: Int, lp: Int, ln: Int) -> Int { mutex.lock(m, lp, ln) }

fn mutex_unlock(m: Int, l: Int) { mutex.unlock(m, l) }

fn mutex_rlock(m: Int, lp: Int, ln: Int) -> Int { mutex.rlock(m, lp, ln) }

fn mutex_runlock(m: Int, l: Int) { mutex.runlock(m, l) }

// Channels (std/native/llrt/chan.xo, B19): generated code calls these
// directly; xo_rt.c's entry points forward. c a channel, l a value list.

fn chan_new(cap: Int, drop: Int, lp: Int, ln: Int) -> Int { chan.new(cap, drop, lp, ln) }

fn chan_send(c: Int, l: Int, lp: Int, ln: Int) { chan.send(c, l, lp, ln) }

fn chan_recv(c: Int) -> Int { chan.recv(c) }

fn chan_try_send(c: Int, l: Int) -> Int { chan.try_send(c, l) }

fn chan_try_recv(c: Int) -> Int { chan.try_recv(c) }

fn chan_close(c: Int) { chan.close(c) }

fn chan_len(c: Int) -> Int { chan.len(c) }

// select (std/native/llrt/selects.xo, B19): generated code calls these
// directly; xo_rt.c's entry points forward. s a select, c a channel.

fn select_new() -> Int { selects.new() }

fn select_recv(s: Int, c: Int) { selects.recv(s, c) }

fn select_send(s: Int, c: Int, l: Int) { selects.send(s, c, l) }

fn select_wait(s: Int, lp: Int, ln: Int) -> Int { selects.wait(s, lp, ln) }

fn select_take(s: Int, i: Int) -> Int { selects.take(s, i) }

/// `Atomic.new(v)` (tasks.xo atomic_new): generated code calls it
/// directly; xo_rt.c's xo_atomic_new forwards.
fn atomic_new(v: Int) -> Int { tasks.atomic_new(v) }

// The handles' free functions (B18): xo_rt.c puts these exports'
// addresses in the services record (ctx.xo SV_*_FREE), and the objects'
// headers name them; xo_h_free calls them.

fn task_free(t: Int) { tasks.task_free(t) }

fn scope_free(s: Int) { tasks.scope_free(s) }

fn atomic_free(a: Int) { tasks.atomic_free(a) }

// ---------------------------------------------------------------------------
// Values of any type (rt.Any, anyval.xo; the C's xo_any_new and
// xo_any_get forward here) and a std function's fault at its caller

fn any_new(l: Int, drop: Int, tag: Int, tn: Int) -> Int { anyval.new(l, drop, tag, tn) }

fn any_get(a: Int, tag: Int, tn: Int) -> Int { anyval.get(a, tag, tn) }

fn any_free(a: Int) { anyval.free(a) }

/// Faults with the n bytes of msg at p at the ln bytes of location at lp
/// (xo_fault_at).
fn fault_at(p: Int, n: Int, lp: Int, ln: Int) { fault.raise_str_at(raw.str_at(p, n), lp, ln) }

/// A claimed task's run (xo_rt.c run_claimed, B18).
fn run_claimed(t: Int, units: Int) { tasks.run_claimed(t, units) }

fn mutex_free(m: Int) { mutex.free(m) }

fn chan_free(c: Int) { chan.free(c) }

fn select_free(s: Int) { selects.free(s) }

/// The deadlock check, pool p's lock held (twrun.xo kick).
fn dl_check(p: Int) { pool.dl_check(p) }

/// The deadlock fault (XO-F001, decision 0077): standard output flushed,
/// the message on standard error, status 70.
fn deadlock() {
  stdio.flush()
  // straight to the descriptor, as the C did (not the test world's fake)
  let m = "fault: XO-F001: deadlock: every task is blocked\n"
  stdio.write_all(2, raw.data(m), m.len())
  process.os_exit(70)
}

// ---------------------------------------------------------------------------
// fsops.xo's handles and consts.xo's constants (the zero-C audit's small
// files batch: the handles fsops.xo makes with these free functions;
// xo_bytes.c's xo_const_once and xo_consts_free forward here)

fn fs_file_free(p: Int) { fsops.file_free(p) }

fn fs_lock_free(p: Int) { fsops.lock_free(p) }

fn const_once(f: Int, drop: Int, id: Int) -> Int { consts.once(f, drop, id) }

fn consts_free() { consts.free_all() }

/// String equality and order for generated code (obj.xo; xo_str_eq and
/// xo_str_cmp stay for code of earlier compilers).
fn obj_str_eq(a: Int, an: Int, b: Int, bn: Int) -> Int { obj.str_eq(a, an, b, bn) }

fn obj_str_cmp(a: Int, an: Int, b: Int, bn: Int) -> Int { obj.str_cmp(a, an, b, bn) }

/// Number text for generated code (xo_rs_concat_int, rs_concat_float,
/// rs_of_int, rs_of_float stay for code of earlier compilers): the string
/// object, its length stored at lenp.
fn obj_rs_concat_int(a: Int, an: Int, v: Int, lenp: Int) -> Int { obj.rs_concat_int(a, an, v, lenp) }

fn obj_rs_of_int(v: Int, lenp: Int) -> Int { obj.rs_of_int(v, lenp) }

fn obj_rs_concat_float(a: Int, an: Int, f: Float, lenp: Int) -> Int {
  let t = num.float_text(f)
  let n = t.len()
  rt.mem_store(lenp, 0, rt.int_wrap(0, an, n), 8)
  let s = obj.rs_append(a, an, raw.data(t), n)
  // t is used after the copy, so it is released only then
  let _k = t.len()
  s
}

fn obj_rs_of_float(f: Float, lenp: Int) -> Int {
  let t = num.float_text(f)
  let n = t.len()
  rt.mem_store(lenp, 0, n, 8)
  let s = obj.rs_append(obj.rs_with_cap(n), 0, raw.data(t), n)
  let _k = t.len()
  s
}
