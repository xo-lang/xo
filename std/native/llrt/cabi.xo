/// task.stopping's channel (stop.xo calls it through rt.fn_addr: chan.xo
/// sits above stop.xo in the imports): unbuffered, closed from outside
/// the program's tasks (CH_EXT, so waiting for it does not count as
/// blocked), its faults located at "task.stopping".
fn stop_chan_new(drop: Int) -> Int {
  let loc = "task.stopping"
  let ch = chan.new(0, drop, raw.data(loc), loc.len())
  rt.mem_store(ch, chan.CH_EXT, 1, 4)
  ch
}

