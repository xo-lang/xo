// The fault unwinder of the native runtime on Linux and macOS (decision
// 0221; the zero-C audit's item B05): what libgcc's (and libunwind's)
// _Unwind_ForcedUnwind, a stop function at the context's boundary, and a
// personality routine do for a fault, in Xo over raw memory, for
// programs linked with glibc and on macOS (stage 3) and with no C
// library (XO_NOLIBC=1, stage 1). cabi.xo's fault_raise_cur calls raise
// with the context's exception object, boundary, and the personality's
// address; raise
// walks the frames from its own up through the .eh_frame_hdr tables of
// the program and of the shared objects it loaded (ld.so's link_map) and
// the DWARF call frame information of .eh_frame (on macOS the compact
// unwind of __unwind_info, dframe and cstep, and the FDEs of __eh_frame
// it points to), and at the first frame
// of generated code (its CIE names xo_x_personality) whose call site has a
// landing pad it restores that frame's registers and jumps there
// (rt.unwind_resume), with the exception in x0 (rax on x86_64) as the
// personality routine's protocol sets it. Frames with another personality (C
// cleanups, C++) are passed over: their cleanups do not run, as with C's
// longjmp (`use c` cannot call back into Xo, so only the runtime's own C
// sits between a fault and its catch). The landing pad runs the cleanups and calls
// xo_fault_continue, which raises again from there. raise returns 0 when
// nothing catches the fault: past the boundary (the runtime's frames),
// at the end of the stack, or on unwind information it does not read
// (a DWARF expression, an unknown instruction); fault_raise then reports
// it and ends the program, as before this module.
//
// arm64 and x86_64 (stage 2, 2026-10-15: glibc linux/amd64 and
// darwin/amd64 left libgcc's and libunwind's forced unwind and the C
// personality; UNTESTED on linux/amd64 and darwin/amd64): the register
// sets are DWARF's numbering of the target (sp_off, ra_off), the
// trampolines the emitters' (compiler/llvm sched.xo unwind_fns), and a
// macOS compact encoding is arm64's (cstep_a64) or x86_64's (cstep_x64).
//
// Nothing here allocates, faults, or keeps a counted value: the scratch
// record is one mapping per thread, kept in thread local word UNW_TLS;
// arithmetic that could overflow on bad tables wraps (rt.int_wrap).
use native/llrt/linux
use native/rt
use native/sys_darwin
use native/sys_windows

/// The thread local word holding the thread's scratch record
/// (std/native/llrt/sched.xo lists the table's words).
const UNW_TLS = 7
/// The record's bytes (one mapping): FC_ENTRIES of the frame cache after
/// the 20480 of the rest.
const SCRATCH = 20480 + FC_ENTRIES * FC_BYTES
/// The frame cache (lookup_frame): FC_ENTRIES entries of FC_BYTES, two
/// ways in each of FC_ENTRIES / 2 sets, keyed by pc: the header words a frame's lookup sets (begin,
/// end, LSDA, personality, compact encoding, return address register,
/// args size) and its rule set (the CFA's rule and bits, then the rules
/// of the registers whose bit is set, in bit order, at most FC_REGS).
const FC = 20480
const FC_ENTRIES = 256
const FC_BYTES = 512
const FC_RULES = 112
const FC_REGS = 25

// The record (byte offsets): a header, two register sets, the rule set
// of the frame being read, the rules after the CIE's instructions (for
// DW_CFA_restore), and the stack of DW_CFA_remember_state.
/// The frame's function: its first address and the end of its range.
const H_BEGIN = 0
const H_END = 8
/// Its language specific data area (the call site table), or 0.
const H_LSDA = 16
/// The CIE's return address register, alignment factors, and the FDE's
/// pointer encoding.
const H_RAREG = 24
const H_CALIGN = 32
const H_DALIGN = 40
const H_FENC = 48
/// The CIE's LSDA encoding and whether it has augmentation data ('z').
const H_LENC = 56
const H_AUGZ = 64
/// The CIE's and the FDE's instructions (start and end).
const H_CIE = 72
const H_CIE_END = 80
const H_FDE = 88
const H_FDE_END = 96
/// The .eh_frame_hdr section's address.
const H_HDR = 104
/// The register set of the frame being read (the personality's view).
const H_CUR = 112
/// The depth of the remember_state stack.
const H_DEPTH = 120
/// The CIE's personality routine (its 'P' augmentation), or 0.
const H_PERS = 128
/// The CIE whose fields are in the header and whose rules are ST_INIT
/// (unwind tables do not change while a program runs), or 0.
const H_CIE_ADDR = 136
/// macOS: the frame's compact unwind encoding (0: its rules are DWARF's,
/// in ST_CUR), and the program's image, read at the thread's first
/// fault: its Mach-O header, __unwind_info, __eh_frame, and __TEXT
/// range.
const H_ENC = 144
const H_MH = 152
const H_UI = 160
const H_EHF = 168
const H_TLO = 176
const H_THI = 184
/// The cached CIE's personality routine (H_PERS is the frame's: a
/// compact frame on macOS sets it without reading a CIE).
const H_CIE_PERS = 192
/// The frame's DW_CFA_GNU_args_size at its pc: the bytes of arguments
/// pushed for the call (x86_64 LLVM pushes the stack arguments of a call
/// of more than six), which a landing pad expects popped (libgcc adds
/// them to the stack pointer it installs; without that, a cleanup's
/// return went to an address in data: cli_decl_fault and the http fault
/// goldens on linux/amd64, 2026-10-15). arm64 code has none.
const H_ARGS = 200
/// The CIE's return address register (H_RAREG is the frame's: the frame
/// cache restores it with each frame, a compact frame's too, so a CIE
/// still in H_CIE_ADDR sets it again from here in read_fde).
const H_CIE_RAREG = 208
/// The register set: word n is DWARF register n (arm64: x0 to x30, sp
/// 31, v0 to v31 at 64 to 95; x86_64: rax, rdx, rcx, rbx, rsi, rdi, rbp,
/// rsp 7, r8 to r15, the return address 16, xmm0 to xmm15 at 17 to 32),
/// word 96 the frame's pc (its return address). step updates it in
/// place to the caller's.
const REGS_A = 256
const PC = 768
const SP = 248
const NREG = 96

/// Whether the target is x86_64.
fn x64() -> Bool {
  match target.arch {
    TargetArch.Amd64 => true
    TargetArch.Arm64 | TargetArch.Wasm32 => false
  }
}

/// The stack pointer's word in the register set (DWARF 31 on arm64, 7
/// on x86_64).
fn sp_off() -> Int { if x64() { 56 } else { SP } }

/// The word of the frame pointer (x29 on arm64, rbp, DWARF register 6,
/// on x86_64).
fn fp_off() -> Int { if x64() { 48 } else { 232 } }

/// The frames outside the program a profile walk follows by their frame
/// records past the leaf (walk_regs).
const OUTSIDE_MAX = 4

/// The word where rt.unwind_save leaves its return address (x30 on
/// arm64, the return address column 16 on x86_64).
fn ra_off() -> Int { if x64() { 128 } else { 240 } }
/// The rule sets: the rule kind of register n at word n, its operand at
/// S_VAL + 8 * n, then the CFA's register and offset, whether the return
/// address is signed (DW_CFA_AARCH64_negate_ra_state), whether the CFA
/// is an expression (not read), and two words of bits, register n's bit
/// n of the first (n < 64) or n - 64 of the second: only the registers
/// whose bit is set have a rule (the kind and operand of the others are
/// stale; no rule is R_SAME). A frame's rules touch a few registers, so
/// reset, copy, and step go by the bits, not over all NREG.
const ST_CUR = 1808
const ST_INIT = 3392
const ST_STACK = 4976
const ST_BYTES = 1584
/// step's new values, by register number (NREG words).
const TMP = 17664
/// The message of a fault being raised (fault.xo msg_buf; MSG_BYTES
/// bytes): written before raise runs, copied into the context's record
/// first.
const MSG = 19456
pub const MSG_BYTES = 1024
const ST_DEPTH_MAX = 8
const S_VAL = 768
const S_CFA_REG = 1536
const S_CFA_OFF = 1544
const S_RA_SIGNED = 1552
const S_CFA_EXPR = 1560
const S_MASK0 = 1568
const S_MASK1 = 1576

// Rule kinds: the register keeps its value (same value, or no rule), is
// saved at CFA + operand, is CFA + operand, is in register operand, is
// undefined, or is a DWARF expression (not read).
const R_SAME = 0
const R_OFFSET = 1
const R_VAL_OFFSET = 2
const R_REG = 3
const R_UNDEF = 4
const R_EXPR = 5

// The personality protocol (unwind.h): _URC_FATAL_PHASE1_ERROR,
// _URC_INSTALL_CONTEXT, _URC_CONTINUE_UNWIND; _UA_CLEANUP_PHASE,
// _UA_FORCE_UNWIND.
const URC_FATAL_PHASE1_ERROR = 3
const URC_INSTALL_CONTEXT = 7
const URC_CONTINUE_UNWIND = 8
const UA_CLEANUP_PHASE = 2
const UA_FORCE_UNWIND = 8
/// xo_rt.c XO_EXC_CLASS ("XO\0\0FAUL").
const EXC_CLASS = 6363304799676486988

/// Unwinds the calling thread's frames for the fault whose exception
/// object is at exc, running the first landing pad it finds below the
/// boundary (a stack address; 0: none) in a frame whose personality
/// routine is pers (xo_x_personality's address, the name every
/// emitter writes): never returns then. 0 when nothing catches the
/// fault. wcx: on Windows, a captured CONTEXT where the walk starts (0:
/// this function's own), unused elsewhere.
pub fn raise(exc: Int, boundary: Int, pers: Int, wcx: Int) -> Int {
  match target.os {
    TargetOs.Windows => return win_raise(exc, boundary, pers, wcx)
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi => {}
  }
  match target.arch {
    TargetArch.Arm64 | TargetArch.Amd64 => {}
    TargetArch.Wasm32 => return 0
  }
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  let s = scratch()
  if s == 0 {
    return 0
  }
  // the program's table, found at the thread's first fault
  if darwin {
    if rt.mem_load(s, H_MH, 8) == 0 && !image(s, sys_darwin._dyld_get_image_header(0), s + H_MH) {
      return 0
    }
  } else if rt.mem_load(s, H_HDR, 8) == 0 {
    let hdr = eh_frame_hdr()
    if hdr == 0 {
      return 0
    }
    rt.mem_store(s, H_HDR, hdr, 8)
  }
  let cur = s + REGS_A
  rt.mem_set(cur, 0, PC + 8)
  rt.unwind_save(cur)
  // this function's frame first: its pc is the save's return address
  rt.mem_store(cur, PC, rt.mem_load(cur, ra_off(), 8), 8)
  var first = true
  while true {
    let pc = rt.mem_load(cur, PC, 8)
    rt.mem_store(s, H_ARGS, 0, 8)
    if pc == 0 || !lookup_frame(s, pc, darwin) {
      // the end of the stack (_UA_END_OF_STACK: fault_stop reports)
      return 0
    }
    if !first {
      // fault_stop: the frames past the boundary are the runtime's,
      // where nothing catches a fault (_Unwind_GetCFA is the frame's
      // stack pointer at its call)
      if boundary != 0 && rt.mem_load(cur, sp_off(), 8) > boundary {
        return 0
      }
      // a frame of generated code with a call site table; another
      // personality's frame is passed over
      let fp = rt.mem_load(s, H_PERS, 8)
      if rt.mem_load(s, H_LSDA, 8) != 0 && fp != 0 && fp == pers {
        rt.mem_store(s, H_CUR, cur, 8)
        if personality(1, UA_CLEANUP_PHASE | UA_FORCE_UNWIND, EXC_CLASS, exc, s) == URC_INSTALL_CONTEXT {
          rt.unwind_resume(cur)
          return 0
        }
      }
    }
    first = false
    let enc = rt.mem_load(s, H_ENC, 8)
    if !(if darwin && enc != 0 { cstep(s, cur, enc) } else { step(s, cur) }) {
      return 0
    }
  }
  0
}

/// The return addresses of the calling thread's frames, from its caller
/// out, by the same tables raise walks (decision 0239: a fault's
/// traceback, fault.xo trace; any backend, no frame pointers needed):
/// stored at out, at most max; their count. Nothing is run or changed
/// but the thread's unwind scratch (raise sets it up again).
pub fn trace(out: Int, max: Int) -> Int { trace_frames(out, max, 0) }

/// trace with each frame's registers: per frame its return address, then
/// the first rw words of the walk's register state there (by DWARF
/// register number: what the unwind tables restored for that frame),
/// so the record is 1 + rw words a frame (decision 0268's locals). The
/// state's callee saved registers, frame pointer, and sp are the frame's;
/// the others are left over from frames below it.
pub fn trace_frames(out: Int, max: Int, rw: Int) -> Int {
  match target.os {
    TargetOs.Linux | TargetOs.Darwin => {}
    TargetOs.Windows => match target.arch {
      TargetArch.Amd64 => {
        // the profiler's walk (win_walk) from this frame, the image found
        // once per thread; before any raise, which reuses the CONTEXT
        let s = scratch()
        if s == 0 || (rt.mem_load(s, W_PDATA_N, 8) == 0 && !win_image(s)) {
          return 0
        }
        sys_windows.RtlCaptureContext(s + W_CX)
        if rw > 0 {
          return win_walk_regs(s, out, max, rw)
        }
        return win_walk(s, out, max, false)
      }
      TargetArch.Arm64 | TargetArch.Wasm32 => return 0
    }
    TargetOs.Wasi => return 0
  }
  match target.arch {
    TargetArch.Arm64 | TargetArch.Amd64 => {}
    TargetArch.Wasm32 => return 0
  }
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  let s = scratch()
  if s == 0 {
    return 0
  }
  if darwin {
    if rt.mem_load(s, H_MH, 8) == 0 && !image(s, sys_darwin._dyld_get_image_header(0), s + H_MH) {
      return 0
    }
  } else if rt.mem_load(s, H_HDR, 8) == 0 {
    let hdr = eh_frame_hdr()
    if hdr == 0 {
      return 0
    }
    rt.mem_store(s, H_HDR, hdr, 8)
  }
  let cur = s + REGS_A
  rt.mem_set(cur, 0, PC + 8)
  rt.unwind_save(cur)
  rt.mem_store(cur, PC, rt.mem_load(cur, ra_off(), 8), 8)
  var n = 0
  while n < max {
    let pc = rt.mem_load(cur, PC, 8)
    rt.mem_store(s, H_ARGS, 0, 8)
    if pc == 0 || !lookup_frame(s, pc, darwin) {
      break
    }
    let rec = out + 8 * (1 + rw) * n
    rt.mem_store(rec, 0, pc, 8)
    if rw > 0 {
      rt.mem_copy(rec + 8, cur, 8 * rw)
    }
    n += 1
    let enc = rt.mem_load(s, H_ENC, 8)
    if !(if darwin && enc != 0 { cstep(s, cur, enc) } else { step(s, cur) }) {
      break
    }
  }
  n
}

/// The return addresses of the calling thread's frames, as trace, walked
/// in profiler record s (prof_init made it ready) instead of the thread's
/// unwind scratch: the heap profile's (heapprof.xo), which samples inside
/// an allocation, so possibly while a raise holds the scratch. The first
/// is a pc in prof_trace itself. No allocation, no lock.
pub fn prof_trace(s: Int, out: Int, max: Int) -> Int {
  match target.os {
    TargetOs.Linux | TargetOs.Darwin => {}
    TargetOs.Windows => {
      // from this frame's own context; its pc is a return address in
      // prof_trace
      sys_windows.RtlCaptureContext(s + W_CX)
      return win_walk(s, out, max, false)
    }
    TargetOs.Wasi => return 0
  }
  match target.arch {
    TargetArch.Arm64 | TargetArch.Amd64 => {}
    TargetArch.Wasm32 => return 0
  }
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  let cur = s + REGS_A
  rt.mem_set(cur, 0, PC + 8)
  rt.unwind_save(cur)
  rt.mem_store(cur, PC, rt.mem_load(cur, ra_off(), 8), 8)
  var n = 0
  while n < max {
    let pc = rt.mem_load(cur, PC, 8)
    rt.mem_store(s, H_ARGS, 0, 8)
    if pc == 0 || !lookup_frame(s, pc, darwin) {
      break
    }
    rt.mem_store(out, 8 * n, pc, 8)
    n += 1
    let enc = rt.mem_load(s, H_ENC, 8)
    if !(if darwin && enc != 0 { cstep(s, cur, enc) } else { step(s, cur) }) {
      break
    }
  }
  n
}

/// Reads the frame cache's entry e into s (lookup_frame's hit).
fn fc_restore(s: Int, e: Int) {
  rt.mem_store(s, H_BEGIN, rt.mem_load(e, 8, 8), 8)
  rt.mem_store(s, H_END, rt.mem_load(e, 16, 8), 8)
  rt.mem_store(s, H_LSDA, rt.mem_load(e, 24, 8), 8)
  rt.mem_store(s, H_PERS, rt.mem_load(e, 32, 8), 8)
  rt.mem_store(s, H_ENC, rt.mem_load(e, 40, 8), 8)
  rt.mem_store(s, H_RAREG, rt.mem_load(e, 48, 8), 8)
  rt.mem_store(s, H_ARGS, rt.mem_load(e, 56, 8), 8)
  let st = s + ST_CUR
  rt.mem_store(st, S_CFA_REG, rt.mem_load(e, 64, 8), 8)
  rt.mem_store(st, S_CFA_OFF, rt.mem_load(e, 72, 8), 8)
  rt.mem_store(st, S_RA_SIGNED, rt.mem_load(e, 80, 8), 8)
  rt.mem_store(st, S_CFA_EXPR, rt.mem_load(e, 88, 8), 8)
  var q = e + FC_RULES
  var w = 0
  while w < 2 {
    var m = rt.mem_load(e, 96 + 8 * w, 8)
    rt.mem_store(st, S_MASK0 + 8 * w, m, 8)
    while m != 0 {
      let o = 8 * (64 * w + rt.ctz(m))
      m = m & m.wrapping_sub(1)
      rt.mem_store(st, o, rt.mem_load(q, 0, 8), 8)
      rt.mem_store(st, S_VAL + o, rt.mem_load(q, 8, 8), 8)
      q = q + 16
    }
    w += 1
  }
}

/// Reads the frame of pc into s, from the frame cache when it holds pc
/// (a fault unwinds through the same frames again and again: reading
/// the FDE and running its CFA program was most of a raise's time,
/// 2026-10-15, bench/perf fault defer), else by dframe or frame, whose
/// result goes into the cache. A cached frame stays valid while its code
/// is mapped (nothing unloads code a fault is raised through).
fn lookup_frame(s: Int, pc: Int, darwin: Bool) -> Bool {
  // two ways a set: the hot frames of a walk that share a set do not
  // evict each other (direct mapped, two of fault isolate's frames
  // collided in one layout and each lookup missed: 1.14x, 2026-10-16).
  // The set is a multiplicative (Fibonacci) hash of pc over 128 sets,
  // not its low bits: three frames in one set thrashed after unrelated
  // code moved (macOS 1.42x, then Linux 1.68x, 2026-10-17); a dozen hot
  // frames meet three in a set about 1% of layouts now
  // (gotchas/unwind-frame-cache-collisions.md)
  let set = s + FC + 2 * FC_BYTES * (((pc >> 2).wrapping_mul(-7046029254386353131) >> 57) & (FC_ENTRIES / 2 - 1))
  if rt.mem_load(set, 0, 8) == pc {
    fc_restore(s, set)
    return true
  }
  if rt.mem_load(set, FC_BYTES, 8) == pc {
    fc_restore(s, set + FC_BYTES)
    return true
  }
  // the first way's entry moves to the second, the new one goes first
  rt.mem_copy(set + FC_BYTES, set, FC_BYTES)
  rt.mem_store(set, 0, 0, 8)
  let e = set
  rt.mem_store(s, H_ENC, 0, 8)
  if !(if darwin { dframe(s, pc) } else { frame(s, pc) }) {
    return false
  }
  let st = s + ST_CUR
  let m0 = rt.mem_load(st, S_MASK0, 8)
  let m1 = rt.mem_load(st, S_MASK1, 8)
  if rt.popcount(m0) + rt.popcount(m1) > FC_REGS {
    return true
  }
  rt.mem_store(e, 8, rt.mem_load(s, H_BEGIN, 8), 8)
  rt.mem_store(e, 16, rt.mem_load(s, H_END, 8), 8)
  rt.mem_store(e, 24, rt.mem_load(s, H_LSDA, 8), 8)
  rt.mem_store(e, 32, rt.mem_load(s, H_PERS, 8), 8)
  rt.mem_store(e, 40, rt.mem_load(s, H_ENC, 8), 8)
  rt.mem_store(e, 48, rt.mem_load(s, H_RAREG, 8), 8)
  rt.mem_store(e, 56, rt.mem_load(s, H_ARGS, 8), 8)
  rt.mem_store(e, 64, rt.mem_load(st, S_CFA_REG, 8), 8)
  rt.mem_store(e, 72, rt.mem_load(st, S_CFA_OFF, 8), 8)
  rt.mem_store(e, 80, rt.mem_load(st, S_RA_SIGNED, 8), 8)
  rt.mem_store(e, 88, rt.mem_load(st, S_CFA_EXPR, 8), 8)
  rt.mem_store(e, 96, m0, 8)
  rt.mem_store(e, 104, m1, 8)
  var q = e + FC_RULES
  var w = 0
  while w < 2 {
    var m = if w == 0 { m0 } else { m1 }
    while m != 0 {
      let o = 8 * (64 * w + rt.ctz(m))
      m = m & m.wrapping_sub(1)
      rt.mem_store(q, 0, rt.mem_load(st, o, 8), 8)
      rt.mem_store(q, 8, rt.mem_load(st, S_VAL + o, 8), 8)
      q = q + 16
    }
    w += 1
  }
  rt.mem_store(e, 0, pc, 8)
  true
}

/// The personality routine of generated code over raise's record ctx:
/// every landing pad is a cleanup, entered on the second phase. At a
/// landing pad the frame's registers get the exception in x0, 0 in x1
/// (rax and rdx on x86_64: DWARF 0 and 1 on both), and the pad as the pc
/// (_URC_INSTALL_CONTEXT).
fn personality(version: Int, actions: Int, cls: Int, exc: Int, ctx: Int) -> Int {
  if (version & 4294967295) != 1 {
    return URC_FATAL_PHASE1_ERROR
  }
  if (actions & UA_CLEANUP_PHASE) == 0 {
    return URC_CONTINUE_UNWIND
  }
  let lsda = rt.mem_load(ctx, H_LSDA, 8)
  if lsda == 0 {
    return URC_CONTINUE_UNWIND
  }
  let regs = rt.mem_load(ctx, H_CUR, 8)
  let func = rt.mem_load(ctx, H_BEGIN, 8)
  let lp = landing(lsda, func, rt.mem_load(regs, PC, 8) - 1)
  if lp == 0 {
    return URC_CONTINUE_UNWIND
  }
  rt.mem_store(regs, 0, exc, 8)
  rt.mem_store(regs, 8, 0, 8)
  rt.mem_store(regs, PC, lp, 8)
  let args = rt.mem_load(ctx, H_ARGS, 8)
  if args != 0 {
    rt.mem_store(regs, sp_off(), rt.mem_load(regs, sp_off(), 8).wrapping_add(args), 8)
  }
  URC_INSTALL_CONTEXT
}

/// The landing pad of the call site holding ip in the language specific
/// data at lsda of the function starting at func, or 0. The data is
/// GCC's: an LPStart and a TType encoding (omitted), the call site
/// encoding, and the call sites (start, length, landing pad, action),
/// offsets from the function's start.
fn landing(lsda: Int, func: Int, ip: Int) -> Int {
  var p = lsda
  let lpenc = rt.mem_load(p, 0, 1)
  p += 1
  if lpenc != 255 {
    let (_, q) = read_val(p, lpenc)
    p = q
  }
  let ttenc = rt.mem_load(p, 0, 1)
  p += 1
  if ttenc != 255 {
    let (_, q) = uleb(p)
    p = q
  }
  let csenc = rt.mem_load(p, 0, 1)
  let (cslen, p1) = uleb(p + 1)
  let end = p1 + cslen
  p = p1
  while p < end {
    let (start, p2) = read_val(p, csenc)
    let (len, p3) = read_val(p2, csenc)
    let (lp, p4) = read_val(p3, csenc)
    let (_, p5) = uleb(p4)
    p = p5
    if ip < func + start {
      return 0
    }
    if ip < func + start + len {
      if lp == 0 {
        return 0
      }
      return func + lp
    }
  }
  0
}

/// The personality routine export of generated code (cabi.xo
/// personality, xo_x_personality, which the unwind tables name). raise
/// does not call it: it compares a frame's personality with its address
/// and reads the call site table itself. A foreign unwinder calling it
/// (a C++ exception through Xo frames, which nothing raises) is told to
/// go on: on Windows, where the system's exception dispatcher calls it as
/// the language handler of frames of generated code (rec, frame, cx,
/// disp), ExceptionContinueSearch (1).
pub fn export_personality(version: Int, actions: Int, cls: Int, exc: Int, uc: Int) -> Int {
  match target.os {
    TargetOs.Windows => 1
    TargetOs.Linux | TargetOs.Darwin | TargetOs.Wasi => URC_CONTINUE_UNWIND
  }
}

/// The calling thread's buffer for a fault's message (MSG_BYTES bytes in
/// its scratch record), or 0 when the record cannot be mapped.
pub fn msg_buf() -> Int {
  let s = scratch()
  if s == 0 {
    return 0
  }
  s + MSG
}

/// The calling thread's scratch record, mapped at its first use; 0 when
/// it cannot be.
fn scratch() -> Int {
  let s = rt.tlocal_get(UNW_TLS)
  if s != 0 {
    return s
  }
  // PROT_READ | PROT_WRITE; MAP_PRIVATE | MAP_ANONYMOUS (0x20 on
  // Linux, 0x1000 on macOS)
  let m = match target.os {
    TargetOs.Darwin => sys_darwin.mmap(0, SCRATCH, 3, 2 | 4096, -1, 0)
    // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE; 0 on failure (decision
    // 0228's message buffer is here on every OS)
    TargetOs.Windows => sys_windows.VirtualAlloc(0, SCRATCH, 12288, 4)
    TargetOs.Linux | TargetOs.Wasi => linux.mmap(0, SCRATCH, 3, 2 | 32, -1, 0)
  }
  if m == 0 || (m < 0 && m > -4096) {
    return 0
  }
  rt.tlocal_set(UNW_TLS, m)
  m
}

/// The address of the program's .eh_frame_hdr (its PT_GNU_EH_FRAME
/// segment, through AT_PHDR; the load bias from PT_PHDR when there is
/// one), or 0.
fn eh_frame_hdr() -> Int {
  let ph = linux.auxval(linux.AT_PHDR)
  let n = linux.auxval(linux.AT_PHNUM)
  if ph == 0 {
    return 0
  }
  var bias = 0
  var hdr = 0
  for i in 0..n {
    // Elf64_Phdr, 56 bytes: p_type at 0, p_vaddr at 16; PT_PHDR 6,
    // PT_GNU_EH_FRAME 0x6474e550
    let p = ph + 56 * i
    let t = rt.mem_load(p, 0, 4)
    if t == 6 {
      bias = ph - rt.mem_load(p, 16, 8)
    } else if t == 1685382480 {
      hdr = rt.mem_load(p, 16, 8)
    }
  }
  if hdr == 0 {
    return 0
  }
  hdr + bias
}

/// The .eh_frame_hdr of the shared object holding pc, or 0: the objects
/// are ld.so's link_map list (the program's PT_DYNAMIC, its DT_DEBUG
/// entry, r_debug's r_map), each one's program headers read from its ELF
/// header at its base (l_addr; a shared object is linked at 0). Not
/// _dl_find_object (glibc 2.35, past the 2.31 builds support) nor
/// dl_iterate_phdr (a callback); the list is read without ld.so's lock,
/// so a dlopen racing a fault could be missed (the walk then ends and the
/// fault is reported). 0 with no dynamic linker (a static program).
fn object_hdr(pc: Int) -> Int {
  let ph = linux.auxval(linux.AT_PHDR)
  let n = linux.auxval(linux.AT_PHNUM)
  if ph == 0 {
    return 0
  }
  var bias = 0
  var dynv = 0
  for i in 0..n {
    // PT_PHDR 6, PT_DYNAMIC 2
    let p = ph + 56 * i
    let t = rt.mem_load(p, 0, 4)
    if t == 6 {
      bias = ph - rt.mem_load(p, 16, 8)
    } else if t == 2 {
      dynv = rt.mem_load(p, 16, 8)
    }
  }
  if dynv == 0 {
    return 0
  }
  // Elf64_Dyn: d_tag, d_val; DT_NULL 0, DT_DEBUG 21
  var d = dynv + bias
  var dbg = 0
  while rt.mem_load(d, 0, 8) != 0 {
    if rt.mem_load(d, 0, 8) == 21 {
      dbg = rt.mem_load(d, 8, 8)
    }
    d += 16
  }
  if dbg == 0 {
    return 0
  }
  // struct r_debug: r_version, then r_map; struct link_map: l_addr,
  // l_name, l_ld, l_next
  var lm = rt.mem_load(dbg, 8, 8)
  var left = 4096
  while lm != 0 && left > 0 {
    left -= 1
    let base = rt.mem_load(lm, 0, 8)
    // l_addr 0: a program not built position independent (the program
    // is read through AT_PHDR); "\x7fELF"
    if base != 0 && rt.mem_load(base, 0, 4) == 1179403647 {
      let h = object_hdr_of(base, pc)
      if h != 0 {
        return h
      }
    }
    lm = rt.mem_load(lm, 24, 8)
  }
  0
}

/// The .eh_frame_hdr of the object loaded at base when one of its PT_LOAD
/// segments holds pc, else 0.
fn object_hdr_of(base: Int, pc: Int) -> Int {
  // Elf64_Ehdr: e_phoff at 32, e_phnum at 56
  let ph = base + rt.mem_load(base, 32, 8)
  let n = rt.mem_load(base, 56, 2)
  var holds = false
  var hdr = 0
  for i in 0..n {
    // Elf64_Phdr: p_type 0, p_vaddr 16, p_memsz 40; PT_LOAD 1
    let p = ph + 56 * i
    let t = rt.mem_load(p, 0, 4)
    let at = base + rt.mem_load(p, 16, 8)
    if t == 1 && pc >= at && pc < at + rt.mem_load(p, 40, 8) {
      holds = true
    } else if t == 1685382480 {
      hdr = at
    }
  }
  if !holds {
    return 0
  }
  hdr
}

// macOS: the compact unwind of __unwind_info (mach-o/compact_unwind_
// encoding.h), as libunwind reads it; a function whose encoding is DWARF
// goes to the FDE in __eh_frame it names.

/// Reads the Mach-O image whose header is at mh into the five words at
/// out: mh, its __unwind_info and __eh_frame (0 when it has none), and
/// its __TEXT range. Whether it has __unwind_info.
fn image(s: Int, mh: Int, out: Int) -> Bool {
  // mach_header_64: magic 0xfeedfacf, ncmds at 16; load commands from 32
  if mh == 0 || rt.mem_load(mh, 0, 4) != 4277009103 {
    return false
  }
  let n = rt.mem_load(mh, 16, 4)
  var lc = mh + 32
  var slide = 0
  var text = 0
  var text_size = 0
  var ui = 0
  var ehf = 0
  for _ in 0..n {
    // LC_SEGMENT_64 (0x19): segname at 8, vmaddr 24, vmsize 32, nsects
    // 64, sections (section_64, 80 bytes: sectname 0, addr 32) from 72
    if rt.mem_load(lc, 0, 4) == 25 && rt.mem_load(lc, 8, 8) == 92738097012575 && rt.mem_load(lc, 16, 8) == 0 {
      // "__TEXT"
      text = rt.mem_load(lc, 24, 8)
      text_size = rt.mem_load(lc, 32, 8)
      slide = mh - text
      let ns = rt.mem_load(lc, 64, 4)
      for i in 0..ns {
        let sec = lc + 72 + 80 * i
        let a = rt.mem_load(sec, 0, 8)
        let b = rt.mem_load(sec, 8, 8)
        // "__unwind_info", "__eh_frame"
        if a == 7236837612906176351 && b == 478459881823 {
          ui = rt.mem_load(sec, 32, 8)
        } else if a == 7021787328983424863 && b == 25965 {
          ehf = rt.mem_load(sec, 32, 8)
        }
      }
    }
    lc += rt.mem_load(lc, 4, 4)
  }
  if ui == 0 {
    return false
  }
  rt.mem_store(out, 0, mh, 8)
  rt.mem_store(out, 8, ui + slide, 8)
  rt.mem_store(out, 16, if ehf == 0 { 0 } else { ehf + slide }, 8)
  rt.mem_store(out, 24, text + slide, 8)
  rt.mem_store(out, 32, text + slide + text_size, 8)
  true
}

/// Reads the unwind information of the frame whose return address is pc
/// on macOS into s: the function's start, LSDA, and personality, and its
/// compact encoding (H_ENC), or for a DWARF encoding the FDE's rules (as
/// frame does) and H_ENC 0. A pc outside the program is looked up in its
/// image (dladdr). Whether there is one.
fn dframe(s: Int, pc: Int) -> Bool {
  var img = s + H_MH
  if pc - 1 < rt.mem_load(s, H_TLO, 8) || pc - 1 >= rt.mem_load(s, H_THI, 8) {
    // Dl_info: dli_fname, dli_fbase (the image's header), ...; read
    // into TMP, the image into TMP + 32
    let info = s + TMP
    if sys_darwin.dladdr(pc - 1, info) == 0 || !image(s, rt.mem_load(info, 8, 8), info + 32) {
      return false
    }
    img = info + 32
  }
  let mh = rt.mem_load(img, 0, 8)
  let ui = rt.mem_load(img, 8, 8)
  let off = pc - 1 - mh
  // unwind_info_section_header: version, common encodings (offset,
  // count), personalities (offset, count), index (offset, count)
  if rt.mem_load(ui, 0, 4) != 1 {
    return false
  }
  let common = ui + rt.mem_load(ui, 4, 4)
  let ncommon = rt.mem_load(ui, 8, 4)
  let idx = ui + rt.mem_load(ui, 20, 4)
  let nidx = rt.mem_load(ui, 24, 4)
  // the first level: the last entry (12 bytes: function offset, second
  // level page, LSDA index) whose function offset is at most off; the
  // last entry is a sentinel
  var lo = 0
  var hi = nidx - 1
  if hi < 1 || rt.mem_load(idx, 0, 4) > off || rt.mem_load(idx, 12 * hi, 4) <= off {
    return false
  }
  while hi - lo > 1 {
    let mid = lo + (hi - lo) / 2
    if rt.mem_load(idx, 12 * mid, 4) <= off {
      lo = mid
    } else {
      hi = mid
    }
  }
  let e = idx + 12 * lo
  let page = rt.mem_load(e, 4, 4)
  if page == 0 {
    return false
  }
  let p = ui + page
  var fstart = 0
  var enc = 0
  let kind = rt.mem_load(p, 0, 4)
  if kind == 2 {
    // regular: entries (function offset, encoding) from entryPageOffset
    let ents = p + rt.mem_load(p, 4, 2)
    let n = rt.mem_load(p, 6, 2)
    let i = last_le(ents, n, 8, off, 0)
    if i < 0 {
      return false
    }
    fstart = rt.mem_load(ents, 8 * i, 4)
    enc = rt.mem_load(ents, 8 * i + 4, 4)
  } else if kind == 3 {
    // compressed: 32 bit entries, the function offset from the first
    // level's in the low 24 bits, the encoding's index in the high 8
    let ents = p + rt.mem_load(p, 4, 2)
    let n = rt.mem_load(p, 6, 2)
    let base = rt.mem_load(e, 0, 4)
    let i = last_le(ents, n, 4, off - base, 16777215)
    if i < 0 {
      return false
    }
    let w = rt.mem_load(ents, 4 * i, 4)
    fstart = base + (w & 16777215)
    let ei = w / 16777216
    if ei < ncommon {
      enc = rt.mem_load(common, 4 * ei, 4)
    } else {
      enc = rt.mem_load(p + rt.mem_load(p, 8, 2), 4 * (ei - ncommon), 4)
    }
  } else {
    return false
  }
  if enc == 0 {
    // no unwind information
    return false
  }
  if (enc & 251658240) == (if x64() { 67108864 } else { 50331648 }) {
    // UNWIND_ARM64_MODE_DWARF (UNWIND_X86_64_MODE_DWARF): the FDE at the
    // low 24 bits' offset in __eh_frame
    let ehf = rt.mem_load(img, 16, 8)
    if ehf == 0 || !read_fde(s, ehf + (enc & 16777215), pc - 1) {
      return false
    }
    rt.mem_store(s, H_ENC, 0, 8)
    copy_rules(s + ST_CUR, s + ST_INIT)
    rt.mem_store(s, H_DEPTH, 0, 8)
    return exec(s, rt.mem_load(s, H_FDE, 8), rt.mem_load(s, H_FDE_END, 8), pc, false)
  }
  rt.mem_store(s, H_ENC, enc, 8)
  rt.mem_store(s, H_BEGIN, mh + fstart, 8)
  // the personality: its index (UNWIND_PERSONALITY_MASK) into the
  // personality array, offsets of pointers to it
  var pers = 0
  let pi = (enc / 268435456) & 3
  if pi != 0 && pi <= rt.mem_load(ui, 16, 4) {
    pers = rt.mem_load(mh + rt.mem_load(ui + rt.mem_load(ui, 12, 4), 4 * (pi - 1), 4), 0, 8)
  }
  rt.mem_store(s, H_PERS, pers, 8)
  // the LSDA (UNWIND_HAS_LSDA): the first level entry's LSDA index
  // (function offset, LSDA offset), up to the next entry's
  var lsda = 0
  if (enc & 1073741824) != 0 {
    let la = ui + rt.mem_load(e, 8, 4)
    let ln = (rt.mem_load(e, 20, 4) - rt.mem_load(e, 8, 4)) / 8
    let i = last_le(la, ln, 8, fstart, 0)
    if i >= 0 && rt.mem_load(la, 8 * i, 4) == fstart {
      lsda = mh + rt.mem_load(la, 8 * i + 4, 4)
    }
  }
  rt.mem_store(s, H_LSDA, lsda, 8)
  true
}

/// The index of the last of the n entries of size bytes at a whose
/// first 32 bit word (masked with mask, when it is not 0) is at most v,
/// or -1.
fn last_le(a: Int, n: Int, size: Int, v: Int, mask: Int) -> Int {
  var lo = 0
  var hi = n
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    var w = rt.mem_load(a, size * mid, 4)
    if mask != 0 {
      w = w & mask
    }
    if w <= v {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo - 1
}

/// The registers of the caller of the frame whose registers are at regs,
/// in place, by its compact encoding enc (the frame's function starts at
/// s's H_BEGIN): arm64's or x86_64's. Whether enc is one cstep reads.
fn cstep(s: Int, regs: Int, enc: Int) -> Bool {
  if x64() { cstep_x64(s, regs, enc) } else { cstep_a64(regs, enc) }
}

/// The registers of the caller of the frame whose registers are at regs,
/// in place, by its arm64 compact encoding enc (libunwind's
/// CompactUnwinder_arm64): a frame (UNWIND_ARM64_MODE_FRAME, and
/// FRAME_PAUTH_LR) has the frame record at x29 and the saved pairs right
/// below it; a frameless leaf (MODE_FRAMELESS) has its pairs right below
/// sp plus its stack size and the return address in x30. Whether enc is
/// one of those.
fn cstep_a64(regs: Int, enc: Int) -> Bool {
  let mode = enc & 251658240
  if mode == 67108864 || mode == 83886080 {
    let fp = rt.mem_load(regs, 8 * 29, 8)
    restore_pairs(regs, enc, fp)
    rt.mem_store(regs, 8 * 29, rt.mem_load(fp, 0, 8), 8)
    rt.mem_store(regs, SP, fp + 16, 8)
    // the return address's address bits (an arm64e signed one)
    rt.mem_store(regs, PC, rt.mem_load(fp, 8, 8) & 281474976710655, 8)
    return true
  }
  if mode == 33554432 {
    let top = rt.mem_load(regs, SP, 8) + 16 * ((enc / 4096) & 4095)
    restore_pairs(regs, enc, top)
    rt.mem_store(regs, SP, top, 8)
    rt.mem_store(regs, PC, rt.mem_load(regs, 8 * 30, 8) & 281474976710655, 8)
    return true
  }
  false
}

/// Loads the callee saved pairs enc names (x19 and x20 to x27 and x28,
/// then d8 and d9 to d14 and d15, in that order) from the words below
/// top, the first of each pair the higher.
fn restore_pairs(regs: Int, enc: Int, top: Int) {
  var loc = top
  for k in 0..9 {
    // bits 0 to 4 the x pairs, 8 to 11 the d pairs (DWARF 72 is d8)
    let bit = if k < 5 { k } else { k + 3 }
    if (enc & (1).wrapping_shl(bit)) != 0 {
      let r = if k < 5 { 19 + 2 * k } else { 72 + 2 * (k - 5) }
      loc -= 8
      rt.mem_store(regs, 8 * r, rt.mem_load(loc, 0, 8), 8)
      loc -= 8
      rt.mem_store(regs, 8 * (r + 1), rt.mem_load(loc, 0, 8), 8)
    }
  }
}

/// The registers of the caller of the frame whose registers are at regs,
/// in place, by its x86_64 compact encoding enc (libunwind's
/// CompactUnwinder_x86_64): an rbp frame (UNWIND_X86_64_MODE_RBP_FRAME)
/// has its saved registers at rbp minus the encoded offset, then rbp's
/// caller's value at rbp, the return address above it; a frameless one
/// (MODE_STACK_IMMD, or MODE_STACK_IND with the size read from the
/// function's sub instruction) has its saved registers, in the encoded
/// permutation, right below the return address at sp plus its size.
/// Whether enc is one of those.
fn cstep_x64(s: Int, regs: Int, enc: Int) -> Bool {
  let mode = enc & 251658240
  if mode == 16777216 {
    let rbp = rt.mem_load(regs, 48, 8)
    var at = rbp - 8 * ((enc / 65536) & 255)
    var locs = enc & 32767
    for _ in 0..5 {
      let r = x64_reg(locs & 7)
      if r < 0 {
        return false
      }
      if r > 0 {
        rt.mem_store(regs, 8 * r, rt.mem_load(at, 0, 8), 8)
      }
      at += 8
      locs = locs / 8
    }
    rt.mem_store(regs, 48, rt.mem_load(rbp, 0, 8), 8)
    rt.mem_store(regs, 56, rbp + 16, 8)
    rt.mem_store(regs, PC, rt.mem_load(rbp, 8, 8), 8)
    return true
  }
  if mode != 33554432 && mode != 50331648 {
    return false
  }
  var size = 8 * ((enc / 65536) & 255)
  if mode == 50331648 {
    // the 32 bit immediate of the function's sub at the encoded offset,
    // plus the adjustment's words
    size = rt.mem_load(rt.mem_load(s, H_BEGIN, 8) + ((enc / 65536) & 255), 0, 4) + 8 * ((enc / 8192) & 7)
  }
  let count = (enc / 1024) & 7
  var perm = enc & 1023
  if count > 6 {
    return false
  }
  // the permutation's digits (libunwind's permunreg), then each digit as
  // the index among the registers not taken yet (1 rbx to 6 rbp)
  let digits = s + TMP
  for i in 0..count {
    let r = radix(count, i)
    let d = perm / r
    perm -= d * r
    rt.mem_store(digits, 8 * i, d, 8)
  }
  let sp = rt.mem_load(regs, 56, 8)
  var at = sp + size - 8 - 8 * count
  var used = 0
  for i in 0..count {
    var renum = 0
    var u = 1
    var reg = 0
    while u < 7 && reg == 0 {
      if (used & (1).wrapping_shl(u)) == 0 {
        if renum == rt.mem_load(digits, 8 * i, 8) {
          reg = u
          used = used | (1).wrapping_shl(u)
        }
        renum += 1
      }
      u += 1
    }
    let r = x64_reg(reg)
    if r <= 0 {
      return false
    }
    rt.mem_store(regs, 8 * r, rt.mem_load(at, 0, 8), 8)
    at += 8
  }
  rt.mem_store(regs, PC, rt.mem_load(sp + size - 8, 0, 8), 8)
  rt.mem_store(regs, 56, sp + size, 8)
  true
}

/// The place value of digit i of a frameless x86_64 encoding's
/// permutation of count saved registers (libunwind's permunreg: a
/// factorial number system; six registers' last digit is 0).
fn radix(count: Int, i: Int) -> Int {
  if count >= 5 {
    return match i {
      0 => 120
      1 => 24
      2 => 6
      3 => 2
      4 => 1
      _ => 1000000
    }
  }
  if count == 4 {
    return match i {
      0 => 60
      1 => 12
      2 => 3
      _ => 1
    }
  }
  if count == 3 {
    return match i {
      0 => 20
      1 => 4
      _ => 1
    }
  }
  if count == 2 && i == 0 {
    return 5
  }
  1
}

/// The DWARF number of compact unwind's x86_64 register r (0 none, 1
/// rbx, 2 to 5 r12 to r15, 6 rbp), 0 for none, -1 for another value.
fn x64_reg(r: Int) -> Int {
  match r {
    0 => 0
    1 => 3
    2 => 12
    3 => 13
    4 => 14
    5 => 15
    6 => 6
    _ => -1
  }
}

// Windows (decision 0197): the system's unwinder walks the frames (the
// .pdata and .xdata every function has; LLVM writes the GCC call site
// table as the handler data of a function whose handler is
// xo_x_personality).

/// The Windows CONTEXT records of win_raise in the scratch record (16
/// byte aligned, where the DWARF walk's rule sets are on other OSes):
/// the frame being unwound and a copy from before its unwind, then the
/// image base, handler data, and establisher frame words.
const W_CX = 1808
const W_HERE = 3040
const W_BASE = 4288
const W_DATA = 4296
const W_EST = 4304
/// A profiler record's image (prof_init on Windows): the program's base,
/// its .pdata (RUNTIME_FUNCTIONs of 12 bytes, sorted) and their count,
/// and its executable sections' start and end.
const W_PBASE = 4312
const W_PDATA = 4320
const W_PDATA_N = 4328
const W_PLO = 4336
const W_PHI = 4344
/// A cache of RtlLookupFunctionEntry by pc (every raise of a fault walks
/// the same frames again): W_CACHE_N entries of three words (the pc,
/// its RUNTIME_FUNCTION, its image base), direct mapped by pc.
const W_CACHE = 4352
const W_CACHE_N = 256
/// sizeof(CONTEXT) on x86_64 (1232) and arm64 (912), and the offsets of
/// its pc, stack pointer, and the two registers a landing pad receives
/// (Rip, Rsp, Rax, Rdx; Pc, Sp, X0, X1).
const WX_SIZE = 1232
const WX_PC = 248
const WX_SP = 152
const WX_R0 = 120
const WX_R1 = 136
const WA_SIZE = 912
const WA_PC = 264
const WA_SP = 256
const WA_R0 = 8
const WA_R1 = 16

/// raise on Windows: from the caller's context (RtlCaptureContext), each
/// frame's function (RtlLookupFunctionEntry) is unwound
/// (RtlVirtualUnwind with UNW_FLAG_UHANDLER, which returns its handler
/// and handler data); a frame of generated code (handler pers) whose
/// call site has a landing pad is resumed there with the
/// exception in the first register (RtlRestoreContext, which does not
/// return). 0 when nothing catches the fault: past the boundary, or a
/// frame with no unwind data (the end of the stack).
fn win_raise(exc: Int, boundary: Int, pers: Int, wcx: Int) -> Int {
  let s = scratch()
  if s == 0 {
    return 0
  }
  let arm = match target.arch {
    TargetArch.Arm64 => true
    TargetArch.Amd64 | TargetArch.Wasm32 => false
  }
  let size = if arm { WA_SIZE } else { WX_SIZE }
  let o_pc = if arm { WA_PC } else { WX_PC }
  let o_sp = if arm { WA_SP } else { WX_SP }
  let cx = s + W_CX
  let here = s + W_HERE
  // the walk starts here (wcx 0; xo_rt.c's fault_raise captured its own
  // CONTEXT and passed it until 2026-10-15): the unwinder's frames (this,
  // raise, the export, the C fault_raise) are unwound first, three
  // RtlVirtualUnwind steps more per raise
  if wcx != 0 {
    rt.mem_copy(cx, wcx, size)
  } else {
    sys_windows.RtlCaptureContext(cx)
  }
  while true {
    let pc = rt.mem_load(cx, o_pc, 8)
    if pc == 0 {
      return 0
    }
    let f = lookup(s, pc)
    if f == 0 {
      return 0
    }
    rt.mem_copy(here, cx, size)
    rt.mem_store(s, W_DATA, 0, 8)
    let base = rt.mem_load(s, W_BASE, 8)
    // UNW_FLAG_UHANDLER
    let h = sys_windows.RtlVirtualUnwind(2, base, pc, f, cx, s + W_DATA, s + W_EST, 0)
    // the frame's own stack pointer (here: before the unwind), as raise
    // compares; cx is its caller's after RtlVirtualUnwind, which passed
    // the boundary at the frame of main or a task's body and dropped its
    // cleanups and catches (2026-10-16, Wine under Box64: fault_unwind,
    // fault_tasks, task_native and seven more goldens on windows/amd64)
    if boundary != 0 && rt.mem_load(here, o_sp, 8) > boundary {
      return 0
    }
    let data = rt.mem_load(s, W_DATA, 8)
    if h != 0 && data != 0 && h == pers {
      // RUNTIME_FUNCTION's BeginAddress: the function's offset from the
      // image base
      let lp = landing(data, base + rt.mem_load(f, 0, 4), pc - 1)
      if lp != 0 {
        rt.mem_store(here, o_pc, lp, 8)
        rt.mem_store(here, if arm { WA_R0 } else { WX_R0 }, exc, 8)
        rt.mem_store(here, if arm { WA_R1 } else { WX_R1 }, 0, 8)
        sys_windows.RtlRestoreContext(here, 0)
        return 0
      }
    }
  }
  0
}

/// The RUNTIME_FUNCTION of pc, its image base stored at s + W_BASE (0:
/// none), through the cache of the scratch record s.
fn lookup(s: Int, pc: Int) -> Int {
  let e = s + W_CACHE + 24 * ((pc / 4) & (W_CACHE_N - 1))
  if rt.mem_load(e, 0, 8) == pc {
    rt.mem_store(s, W_BASE, rt.mem_load(e, 16, 8), 8)
    return rt.mem_load(e, 8, 8)
  }
  let f = sys_windows.RtlLookupFunctionEntry(pc, s + W_BASE, 0)
  if f != 0 {
    rt.mem_store(e, 0, pc, 8)
    rt.mem_store(e, 8, f, 8)
    rt.mem_store(e, 16, rt.mem_load(s, W_BASE, 8), 8)
  }
  f
}

/// v, the low bits bits of a two's complement number, sign extended.
fn sx(v: Int, bits: Int) -> Int {
  let half = (1).wrapping_shl(bits - 1)
  if v >= half {
    return v - half - half
  }
  v
}

/// The unsigned LEB128 number at p, and the address after it.
fn uleb(p: Int) -> (Int, Int) {
  var v = 0
  var q = p
  var shift = 0
  var b = 128
  while b >= 128 {
    b = rt.mem_load(q, 0, 1)
    q += 1
    if shift < 64 {
      v = v | (b & 127).wrapping_shl(shift)
    }
    shift += 7
  }
  (v, q)
}

/// The signed LEB128 number at p, and the address after it.
fn sleb(p: Int) -> (Int, Int) {
  var v = 0
  var q = p
  var shift = 0
  var b = 128
  while b >= 128 {
    b = rt.mem_load(q, 0, 1)
    q += 1
    if shift < 64 {
      v = v | (b & 127).wrapping_shl(shift)
    }
    shift += 7
  }
  if shift < 64 && (b & 64) != 0 {
    v = v | (-1).wrapping_shl(shift)
  }
  (v, q)
}

/// The value at p in the format of pointer encoding enc (DW_EH_PE_*,
/// its low four bits; xo_rt.c lsda_read), and the address after it.
fn read_val(p: Int, enc: Int) -> (Int, Int) {
  let f = enc & 15
  if f == 1 {
    return uleb(p)
  }
  if f == 9 {
    return sleb(p)
  }
  if f == 2 {
    return (rt.mem_load(p, 0, 2), p + 2)
  }
  if f == 10 {
    return (sx(rt.mem_load(p, 0, 2), 16), p + 2)
  }
  if f == 3 {
    return (rt.mem_load(p, 0, 4), p + 4)
  }
  if f == 11 {
    return (sx(rt.mem_load(p, 0, 4), 32), p + 4)
  }
  // absptr, udata8, sdata8
  (rt.mem_load(p, 0, 8), p + 8)
}

/// The pointer encoded with enc at p (applied: pc relative to p, data
/// relative to data; indirect through the word it names), and the
/// address after it. DW_EH_PE_omit reads nothing.
fn read_ptr(p: Int, enc: Int, data: Int) -> (Int, Int) {
  if enc == 255 {
    return (0, p)
  }
  let (v0, q) = read_val(p, enc)
  var v = v0
  if v != 0 {
    let app = enc & 112
    if app == 16 {
      v = v.wrapping_add(p)
    } else if app == 48 {
      v = v.wrapping_add(data)
    }
    if (enc & 128) != 0 {
      v = rt.mem_load(v, 0, 8)
    }
  }
  (v, q)
}

/// Reads the unwind information of the frame whose return address is pc
/// into s: its FDE (through .eh_frame_hdr's sorted table) and CIE, and
/// the rules of the row that holds at pc - 1. Whether there is one.
fn frame(s: Int, pc: Int) -> Bool {
  let hdr = rt.mem_load(s, H_HDR, 8)
  let fde = find_fde(hdr, pc - 1)
  if fde == 0 || !read_fde(s, fde, pc - 1) {
    // not the program's: a shared object's
    let h2 = object_hdr(pc - 1)
    if h2 == 0 || h2 == hdr {
      return false
    }
    let f2 = find_fde(h2, pc - 1)
    if f2 == 0 || !read_fde(s, f2, pc - 1) {
      return false
    }
  }
  copy_rules(s + ST_CUR, s + ST_INIT)
  rt.mem_store(s, H_DEPTH, 0, 8)
  rt.mem_store(s, H_ARGS, 0, 8)
  exec(s, rt.mem_load(s, H_FDE, 8), rt.mem_load(s, H_FDE_END, 8), pc, false)
}

/// Clears the rule set at st: no register has a rule, the CFA none.
fn reset(st: Int) {
  rt.mem_store(st, S_CFA_REG, 0, 8)
  rt.mem_store(st, S_CFA_OFF, 0, 8)
  rt.mem_store(st, S_RA_SIGNED, 0, 8)
  rt.mem_store(st, S_CFA_EXPR, 0, 8)
  rt.mem_store(st, S_MASK0, 0, 8)
  rt.mem_store(st, S_MASK1, 0, 8)
}

/// Copies the rule set at src to dst: the CFA's rule, the bits, and the
/// rules of the registers whose bit is set.
fn copy_rules(dst: Int, src: Int) {
  rt.mem_store(dst, S_CFA_REG, rt.mem_load(src, S_CFA_REG, 8), 8)
  rt.mem_store(dst, S_CFA_OFF, rt.mem_load(src, S_CFA_OFF, 8), 8)
  rt.mem_store(dst, S_RA_SIGNED, rt.mem_load(src, S_RA_SIGNED, 8), 8)
  rt.mem_store(dst, S_CFA_EXPR, rt.mem_load(src, S_CFA_EXPR, 8), 8)
  var w = 0
  while w < 2 {
    var m = rt.mem_load(src, S_MASK0 + 8 * w, 8)
    rt.mem_store(dst, S_MASK0 + 8 * w, m, 8)
    while m != 0 {
      let o = 8 * (64 * w + rt.ctz(m))
      m = m & m.wrapping_sub(1)
      rt.mem_store(dst, o, rt.mem_load(src, o, 8), 8)
      rt.mem_store(dst, S_VAL + o, rt.mem_load(src, S_VAL + o, 8), 8)
    }
    w += 1
  }
}

/// The FDE of the function holding pc in the sorted table of the
/// .eh_frame_hdr at hdr (version 1, the table's entries datarel sdata4
/// pairs, as GNU ld and lld write it), or 0.
fn find_fde(hdr: Int, pc: Int) -> Int {
  if rt.mem_load(hdr, 0, 1) != 1 || rt.mem_load(hdr, 3, 1) != 59 {
    return 0
  }
  let (_, p1) = read_ptr(hdr + 4, rt.mem_load(hdr, 1, 1), hdr)
  let (count, table) = read_ptr(p1, rt.mem_load(hdr, 2, 1), hdr)
  if count <= 0 {
    return 0
  }
  // the last entry whose start is at most pc
  var lo = 0
  var hi = count
  while hi - lo > 1 {
    let mid = lo + (hi - lo) / 2
    if hdr + sx(rt.mem_load(table, 8 * mid, 4), 32) <= pc {
      lo = mid
    } else {
      hi = mid
    }
  }
  if hdr + sx(rt.mem_load(table, 8 * lo, 4), 32) > pc {
    return 0
  }
  hdr + sx(rt.mem_load(table, 8 * lo + 4, 4), 32)
}

/// The length of the CIE or FDE at p (a 32 bit length, or 0xffffffff
/// and a 64 bit one) and the address of its body.
fn entry_len(p: Int) -> (Int, Int) {
  let n = rt.mem_load(p, 0, 4)
  if n == 4294967295 {
    return (rt.mem_load(p, 4, 8), p + 12)
  }
  (n, p + 4)
}

/// Reads the FDE at fde and its CIE into s: whether it covers pc.
fn read_fde(s: Int, fde: Int, pc: Int) -> Bool {
  let (n, body) = entry_len(fde)
  if n == 0 {
    return false
  }
  let end = body + n
  // the CIE pointer: the distance back from this field to the CIE
  let cie = body - rt.mem_load(body, 0, 4)
  if cie != rt.mem_load(s, H_CIE_ADDR, 8) {
    // a CIE other than the last one: its fields, and the rules after
    // its instructions (ST_INIT, the start of every frame's)
    rt.mem_store(s, H_CIE_ADDR, 0, 8)
    if !read_cie(s, cie) {
      return false
    }
    reset(s + ST_CUR)
    rt.mem_store(s, H_DEPTH, 0, 8)
    if !exec(s, rt.mem_load(s, H_CIE, 8), rt.mem_load(s, H_CIE_END, 8), 0, true) {
      return false
    }
    copy_rules(s + ST_INIT, s + ST_CUR)
    rt.mem_store(s, H_CIE_ADDR, cie, 8)
  }
  let fenc = rt.mem_load(s, H_FENC, 8)
  let (begin, p1) = read_ptr(body + 4, fenc, 0)
  let (range, p2) = read_val(p1, fenc)
  rt.mem_store(s, H_BEGIN, begin, 8)
  rt.mem_store(s, H_END, begin.wrapping_add(range), 8)
  if pc < begin || pc >= begin.wrapping_add(range) {
    return false
  }
  var p = p2
  var lsda = 0
  if rt.mem_load(s, H_AUGZ, 8) != 0 {
    let (alen, p3) = uleb(p2)
    let (l, _) = read_ptr(p3, rt.mem_load(s, H_LENC, 8), 0)
    lsda = l
    p = p3 + alen
  }
  rt.mem_store(s, H_LSDA, lsda, 8)
  rt.mem_store(s, H_PERS, rt.mem_load(s, H_CIE_PERS, 8), 8)
  // the CIE's, not the last cached frame's (a compact frame cached
  // before any CIE was read left 0, rax on x86_64, and the next DWARF
  // step returned to 0: every fault isolated past such a frame went
  // uncaught on darwin/amd64, gotchas/unwind-rareg-from-frame-cache.md)
  rt.mem_store(s, H_RAREG, rt.mem_load(s, H_CIE_RAREG, 8), 8)
  rt.mem_store(s, H_FDE, p, 8)
  rt.mem_store(s, H_FDE_END, end, 8)
  true
}

/// Reads the CIE at cie into s (its alignment factors, return address
/// register, augmentation, and instructions): whether it is one this
/// unwinder reads.
fn read_cie(s: Int, cie: Int) -> Bool {
  let (n, body) = entry_len(cie)
  if n == 0 || rt.mem_load(body, 0, 4) != 0 {
    return false
  }
  let end = body + n
  let ver = rt.mem_load(body, 4, 1)
  let aug = body + 5
  var p = aug
  while rt.mem_load(p, 0, 1) != 0 {
    p += 1
  }
  p += 1
  // 'e', 'h': an old GCC's pointer before the factors
  if rt.mem_load(aug, 0, 1) == 101 && rt.mem_load(aug, 1, 1) == 104 {
    p += 8
  }
  let (ca, p1) = uleb(p)
  let (da, p2) = sleb(p1)
  var ra = 0
  p = p2
  if ver == 1 {
    ra = rt.mem_load(p, 0, 1)
    p += 1
  } else {
    let (r, q) = uleb(p)
    ra = r
    p = q
  }
  var fenc = 0
  var lenc = 255
  var augz = 0
  var pers = 0
  if rt.mem_load(aug, 0, 1) == 122 {
    // 'z': the augmentation data's length, then a field per letter
    augz = 1
    let (alen, q) = uleb(p)
    let data_end = q + alen
    p = q
    var a = aug + 1
    var c = rt.mem_load(a, 0, 1)
    while c != 0 {
      if c == 76 {
        // 'L': the LSDA's encoding
        lenc = rt.mem_load(p, 0, 1)
        p += 1
      } else if c == 82 {
        // 'R': the FDE's pointer encoding
        fenc = rt.mem_load(p, 0, 1)
        p += 1
      } else if c == 80 {
        // 'P': the personality routine (raise compares it with
        // xo_x_personality's address and does not call it)
        let (pv, q2) = read_ptr(p + 1, rt.mem_load(p, 0, 1), 0)
        pers = pv
        p = q2
      } else if c != 83 && c != 66 && c != 71 {
        // not 'S' (a signal frame), 'B' or 'G' (arm64's pointer
        // authentication key and memory tags): unknown, the data
        // length skips it and the rest
        break
      }
      a += 1
      c = rt.mem_load(a, 0, 1)
    }
    p = data_end
  }
  rt.mem_store(s, H_CALIGN, ca, 8)
  rt.mem_store(s, H_DALIGN, da, 8)
  rt.mem_store(s, H_RAREG, ra, 8)
  rt.mem_store(s, H_CIE_RAREG, ra, 8)
  rt.mem_store(s, H_FENC, fenc, 8)
  rt.mem_store(s, H_LENC, lenc, 8)
  rt.mem_store(s, H_AUGZ, augz, 8)
  rt.mem_store(s, H_CIE_PERS, pers, 8)
  rt.mem_store(s, H_CIE, p, 8)
  rt.mem_store(s, H_CIE_END, end, 8)
  true
}

/// Sets the rule of register r in the rule set at st (registers past
/// the ones the record keeps are ignored).
fn set_rule(st: Int, r: Int, kind: Int, val: Int) {
  if r >= 0 && r < NREG {
    rt.mem_store(st, 8 * r, kind, 8)
    rt.mem_store(st, S_VAL + 8 * r, val, 8)
    let w = S_MASK0 + 8 * (r / 64)
    rt.mem_store(st, w, rt.mem_load(st, w, 8) | (1).wrapping_shl(r % 64), 8)
  }
}

/// Whether register r has a rule in the rule set at st.
fn has_rule(st: Int, r: Int) -> Bool { (rt.mem_load(st, S_MASK0 + 8 * (r / 64), 8) & (1).wrapping_shl(r % 64)) != 0 }

/// Runs the call frame instructions from p to end on s's rule set
/// (libgcc's execute_cfa_program): all of them for the CIE, else the
/// ones whose row starts before ra (the frame's return address).
/// Whether they were all ones this unwinder reads.
fn exec(s: Int, p0: Int, end: Int, ra: Int, cie: Bool) -> Bool {
  let st = s + ST_CUR
  let ca = rt.mem_load(s, H_CALIGN, 8)
  let da = rt.mem_load(s, H_DALIGN, 8)
  var loc = rt.mem_load(s, H_BEGIN, 8)
  var p = p0
  while p < end {
    if !cie && loc >= ra {
      break
    }
    let op = rt.mem_load(p, 0, 1)
    p += 1
    let hi = op & 192
    let lo = op & 63
    if hi == 64 {
      // DW_CFA_advance_loc
      loc = loc.wrapping_add(lo.wrapping_mul(ca))
    } else if hi == 128 {
      // DW_CFA_offset
      let (o, q) = uleb(p)
      p = q
      set_rule(st, lo, R_OFFSET, o.wrapping_mul(da))
    } else if hi == 192 {
      // DW_CFA_restore
      restore(s, lo)
    } else if op == 0 {
      // DW_CFA_nop
    } else if op == 1 {
      // DW_CFA_set_loc
      let (l, q) = read_ptr(p, rt.mem_load(s, H_FENC, 8), 0)
      loc = l
      p = q
    } else if op == 2 {
      // DW_CFA_advance_loc1, 2, 4
      loc = loc.wrapping_add(rt.mem_load(p, 0, 1).wrapping_mul(ca))
      p += 1
    } else if op == 3 {
      loc = loc.wrapping_add(rt.mem_load(p, 0, 2).wrapping_mul(ca))
      p += 2
    } else if op == 4 {
      loc = loc.wrapping_add(rt.mem_load(p, 0, 4).wrapping_mul(ca))
      p += 4
    } else if op == 5 || op == 20 || op == 47 {
      // DW_CFA_offset_extended, val_offset, GNU_negative_offset_extended
      let (r, q) = uleb(p)
      let (o, q2) = uleb(q)
      p = q2
      if op == 5 {
        set_rule(st, r, R_OFFSET, o.wrapping_mul(da))
      } else if op == 20 {
        set_rule(st, r, R_VAL_OFFSET, o.wrapping_mul(da))
      } else {
        set_rule(st, r, R_OFFSET, (0).wrapping_sub(o.wrapping_mul(da)))
      }
    } else if op == 6 || op == 7 || op == 8 {
      // DW_CFA_restore_extended, undefined, same_value
      let (r, q) = uleb(p)
      p = q
      if op == 6 {
        restore(s, r)
      } else if op == 7 {
        set_rule(st, r, R_UNDEF, 0)
      } else {
        set_rule(st, r, R_SAME, 0)
      }
    } else if op == 9 {
      // DW_CFA_register
      let (r, q) = uleb(p)
      let (r2, q2) = uleb(q)
      p = q2
      set_rule(st, r, R_REG, r2)
    } else if op == 10 {
      // DW_CFA_remember_state: the whole row, the CFA rule included
      let d = rt.mem_load(s, H_DEPTH, 8)
      if d >= ST_DEPTH_MAX {
        return false
      }
      copy_rules(s + ST_STACK + d * ST_BYTES, st)
      rt.mem_store(s, H_DEPTH, d + 1, 8)
    } else if op == 11 {
      // DW_CFA_restore_state
      let d = rt.mem_load(s, H_DEPTH, 8)
      if d == 0 {
        return false
      }
      copy_rules(st, s + ST_STACK + (d - 1) * ST_BYTES)
      rt.mem_store(s, H_DEPTH, d - 1, 8)
    } else if op == 12 {
      // DW_CFA_def_cfa
      let (r, q) = uleb(p)
      let (o, q2) = uleb(q)
      p = q2
      rt.mem_store(st, S_CFA_REG, r, 8)
      rt.mem_store(st, S_CFA_OFF, o, 8)
      rt.mem_store(st, S_CFA_EXPR, 0, 8)
    } else if op == 13 {
      // DW_CFA_def_cfa_register
      let (r, q) = uleb(p)
      p = q
      rt.mem_store(st, S_CFA_REG, r, 8)
      rt.mem_store(st, S_CFA_EXPR, 0, 8)
    } else if op == 14 {
      // DW_CFA_def_cfa_offset
      let (o, q) = uleb(p)
      p = q
      rt.mem_store(st, S_CFA_OFF, o, 8)
    } else if op == 15 {
      // DW_CFA_def_cfa_expression (not read)
      let (n, q) = uleb(p)
      p = q + n
      rt.mem_store(st, S_CFA_EXPR, 1, 8)
    } else if op == 16 || op == 22 {
      // DW_CFA_expression, val_expression (not read)
      let (r, q) = uleb(p)
      let (n, q2) = uleb(q)
      p = q2 + n
      set_rule(st, r, R_EXPR, 0)
    } else if op == 17 || op == 21 {
      // DW_CFA_offset_extended_sf, val_offset_sf
      let (r, q) = uleb(p)
      let (o, q2) = sleb(q)
      p = q2
      set_rule(st, r, if op == 17 { R_OFFSET } else { R_VAL_OFFSET }, o.wrapping_mul(da))
    } else if op == 18 {
      // DW_CFA_def_cfa_sf
      let (r, q) = uleb(p)
      let (o, q2) = sleb(q)
      p = q2
      rt.mem_store(st, S_CFA_REG, r, 8)
      rt.mem_store(st, S_CFA_OFF, o.wrapping_mul(da), 8)
      rt.mem_store(st, S_CFA_EXPR, 0, 8)
    } else if op == 19 {
      // DW_CFA_def_cfa_offset_sf
      let (o, q) = sleb(p)
      p = q
      rt.mem_store(st, S_CFA_OFF, o.wrapping_mul(da), 8)
    } else if op == 45 {
      // DW_CFA_AARCH64_negate_ra_state: the return address is signed
      rt.mem_store(st, S_RA_SIGNED, 1 - rt.mem_load(st, S_RA_SIGNED, 8), 8)
    } else if op == 46 {
      // DW_CFA_GNU_args_size
      let (n, q) = uleb(p)
      p = q
      rt.mem_store(s, H_ARGS, n, 8)
    } else {
      return false
    }
  }
  true
}

/// DW_CFA_restore of register r: its rule after the CIE's instructions.
fn restore(s: Int, r: Int) {
  if r >= 0 && r < NREG {
    let init = s + ST_INIT
    if has_rule(init, r) {
      set_rule(s + ST_CUR, r, rt.mem_load(init, 8 * r, 8), rt.mem_load(init, S_VAL + 8 * r, 8))
    } else {
      set_rule(s + ST_CUR, r, R_SAME, 0)
    }
  }
}

/// The registers of the caller of the frame whose registers are at regs,
/// by s's rule set, in place (libgcc's uw_update_context): its stack
/// pointer is the frame's CFA, its pc the return address. The new values
/// of the registers with rules are computed from the old ones first
/// (TMP), then stored. Whether the rules could be applied.
fn step(s: Int, regs: Int) -> Bool {
  let st = s + ST_CUR
  let cr = rt.mem_load(st, S_CFA_REG, 8)
  if rt.mem_load(st, S_CFA_EXPR, 8) != 0 || cr < 0 || cr >= NREG {
    return false
  }
  let cfa = rt.mem_load(regs, 8 * cr, 8).wrapping_add(rt.mem_load(st, S_CFA_OFF, 8))
  let tmp = s + TMP
  var w = 0
  while w < 2 {
    var m = rt.mem_load(st, S_MASK0 + 8 * w, 8)
    while m != 0 {
      let o = 8 * (64 * w + rt.ctz(m))
      m = m & m.wrapping_sub(1)
      let k = rt.mem_load(st, o, 8)
      let v = rt.mem_load(st, S_VAL + o, 8)
      var x = rt.mem_load(regs, o, 8)
      if k == R_OFFSET {
        x = rt.mem_load(cfa.wrapping_add(v), 0, 8)
      } else if k == R_VAL_OFFSET {
        x = cfa.wrapping_add(v)
      } else if k == R_REG {
        if v < 0 || v >= NREG {
          return false
        }
        x = rt.mem_load(regs, 8 * v, 8)
      } else if k == R_UNDEF {
        x = 0
      } else if k == R_EXPR {
        return false
      }
      rt.mem_store(tmp, o, x, 8)
    }
    w += 1
  }
  w = 0
  while w < 2 {
    var m = rt.mem_load(st, S_MASK0 + 8 * w, 8)
    while m != 0 {
      let o = 8 * (64 * w + rt.ctz(m))
      m = m & m.wrapping_sub(1)
      rt.mem_store(regs, o, rt.mem_load(tmp, o, 8), 8)
    }
    w += 1
  }
  let sp = sp_off()
  if !has_rule(st, sp / 8) || rt.mem_load(st, sp, 8) == R_SAME {
    rt.mem_store(regs, sp, cfa, 8)
  }
  let rar = rt.mem_load(s, H_RAREG, 8)
  if rar < 0 || rar >= NREG {
    return false
  }
  var ra = rt.mem_load(regs, 8 * rar, 8)
  if rt.mem_load(st, S_RA_SIGNED, 8) != 0 {
    // a return address signed with pointer authentication: its address
    // bits (user addresses are below 2^48)
    ra = ra & 281474976710655
  }
  rt.mem_store(regs, PC, ra, 8)
  true
}

// ---------------------------------------------------------------------------
// The sampling profiler's stack walk (prof.xo, decision 0238): the
// frames of a thread a SIGPROF interrupted, from the signal's ucontext,
// with the fault unwinder's tables and frame cache, in a record of the
// profiler's own (never the thread's fault record, which a fault in
// progress may hold). Async signal safe: no allocation, no lock, no
// call into the C library; a frame whose stack pointer does not move up
// within PROF_SPAN, or whose pc leaves the program's text, ends the walk
// instead of reading a wild address.

/// The bytes of a profiler record (the same layout as a thread's fault
/// record).
pub const PROF_RECORD = SCRATCH

/// The farthest a caller's stack pointer may be above its callee's.
const PROF_SPAN = 67108864

/// Makes the profiler record s ready before the timer is armed: the
/// program's .eh_frame_hdr (Linux) or its image (macOS), so the handler
/// never looks them up. Whether the program's tables were found.
pub fn prof_init(s: Int) -> Bool {
  match target.os {
    TargetOs.Darwin => image(s, sys_darwin._dyld_get_image_header(0), s + H_MH)
    TargetOs.Linux => {
      let hdr = eh_frame_hdr()
      rt.mem_store(s, H_HDR, hdr, 8)
      hdr != 0
    }
    TargetOs.Windows => match target.arch {
      TargetArch.Amd64 => win_image(s)
      TargetArch.Arm64 | TargetArch.Wasm32 => false
    }
    TargetOs.Wasi => false
  }
}

/// The program's text, (start, end): macOS __TEXT, Linux the executable
/// PT_LOAD segments (from the lowest start to the highest end), (0, 0)
/// when not found. s is a record prof_init made ready.
pub fn prof_text(s: Int) -> (Int, Int) {
  match target.os {
    TargetOs.Darwin => (rt.mem_load(s, H_TLO, 8), rt.mem_load(s, H_THI, 8))
    TargetOs.Linux => {
      let ph = linux.auxval(linux.AT_PHDR)
      let n = linux.auxval(linux.AT_PHNUM)
      if ph == 0 {
        return (0, 0)
      }
      var bias = 0
      for i in 0..n {
        let p = ph + 56 * i
        if rt.mem_load(p, 0, 4) == 6 {
          bias = ph - rt.mem_load(p, 16, 8)
        }
      }
      var lo = 0
      var hi = 0
      for i in 0..n {
        // PT_LOAD 1 with PF_X (p_flags at 4, bit 0): p_vaddr 16, p_memsz 40
        let p = ph + 56 * i
        if rt.mem_load(p, 0, 4) == 1 && (rt.mem_load(p, 4, 4) & 1) != 0 {
          let a = rt.mem_load(p, 16, 8) + bias
          let b = a + rt.mem_load(p, 40, 8)
          if lo == 0 || a < lo {
            lo = a
          }
          if b > hi {
            hi = b
          }
        }
      }
      (lo, hi)
    }
    TargetOs.Windows => (rt.mem_load(s, W_PLO, 8), rt.mem_load(s, W_PHI, 8))
    TargetOs.Wasi => (0, 0)
  }
}

/// The pcs of the frames a signal interrupted, the innermost first, into
/// the words at out (at most max): their count. uc is the signal's
/// ucontext; s the thread's profiler record; [lo, hi) the program's text.
/// A pc outside the text (a C library function) is followed by its
/// caller from the link register (arm64) or the word at the stack
/// pointer (x86_64) once, as a leaf; then the walk ends.
pub fn prof_walk(s: Int, uc: Int, out: Int, max: Int, lo: Int, hi: Int) -> Int {
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  let cur = s + REGS_A
  rt.mem_set(cur, 0, PC + 8)
  if !prof_regs(uc, cur, darwin) {
    return 0
  }
  walk_regs(s, out, max, lo, hi, darwin, true)
}

/// The pcs of a parked fiber's frames, innermost first, into out (at most
/// max): their count (`xo dump`, decision 0251). saved is the fiber's
/// saved stack pointer: the switch's frame (compiler/arm64 sched.xo
/// stack_switch_body: x19 to x28, x29, x30 at saved + 0 to 88, the
/// caller's stack at saved + 160), so the first pc is the switch's
/// return address. s is a profiler record (prof_init). arm64 only (0 on
/// x86_64).
pub fn fiber_walk(s: Int, saved: Int, out: Int, max: Int, lo: Int, hi: Int) -> Int {
  if x64() || saved == 0 {
    return 0
  }
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  let cur = s + REGS_A
  rt.mem_set(cur, 0, PC + 8)
  for k in 0..12 {
    rt.mem_store(cur, 8 * (19 + k), rt.mem_load(saved, 8 * k, 8), 8)
  }
  rt.mem_store(cur, SP, saved + 160, 8)
  rt.mem_store(cur, PC, rt.mem_load(saved, 88, 8) & 281474976710655, 8)
  walk_regs(s, out, max, lo, hi, darwin, false)
}

/// prof_walk's walk from the registers at s + REGS_A; leaf: the pc is an
/// interrupted instruction's (a signal's), else a return address.
fn walk_regs(s: Int, out: Int, max: Int, lo: Int, hi: Int, darwin: Bool, leaf: Bool) -> Int {
  let cur = s + REGS_A
  let spo = sp_off()
  var n = 0
  var first = leaf
  var outside = 0
  while n < max {
    var pc = rt.mem_load(cur, PC, 8)
    if pc == 0 {
      break
    }
    rt.mem_store(out, 8 * n, pc, 8)
    n += 1
    let sp = rt.mem_load(cur, spo, 8)
    if pc < lo || pc >= hi {
      if !first {
        // a frame outside the program past the leaf (libc's open below a
        // syscall stub): its frame record, while it lies on this stack,
        // for a few frames, so the samples in libc keep their Xo
        // callers (they showed `_open` alone, 2026-10-23)
        outside += 1
        let fp = rt.mem_load(cur, fp_off(), 8)
        if outside > OUTSIDE_MAX || fp < sp || fp - sp > PROF_SPAN || (fp & 7) != 0 {
          break
        }
        rt.mem_store(cur, PC, rt.mem_load(fp, 8, 8) & 281474976710655, 8)
        rt.mem_store(cur, fp_off(), rt.mem_load(fp, 0, 8), 8)
        rt.mem_store(cur, spo, fp + 16, 8)
        continue
      }
      // a leaf outside the program: its return address
      first = false
      if x64() {
        if sp == 0 {
          break
        }
        rt.mem_store(cur, PC, rt.mem_load(sp, 0, 8), 8)
        rt.mem_store(cur, spo, sp + 8, 8)
      } else {
        rt.mem_store(cur, PC, rt.mem_load(cur, 8 * 30, 8) & 281474976710655, 8)
      }
      continue
    }
    // the interrupted pc is an instruction's own address: lookup_frame
    // and frame look up pc - 1 (a return address's call)
    let key = if first { pc + 1 } else { pc }
    rt.mem_store(s, H_ARGS, 0, 8)
    if !lookup_frame(s, key, darwin) {
      break
    }
    let enc = rt.mem_load(s, H_ENC, 8)
    if darwin && enc != 0 {
      // a compact frame record at x29 must lie on this stack
      let fp = rt.mem_load(cur, 8 * 29, 8)
      if !x64() && (enc & 251658240) != 33554432 && (fp < sp || fp - sp > PROF_SPAN) {
        break
      }
      if x64() && (fp < sp || fp - sp > PROF_SPAN) {
        break
      }
      if !cstep(s, cur, enc) {
        break
      }
    } else {
      let st = s + ST_CUR
      let cr = rt.mem_load(st, S_CFA_REG, 8)
      if rt.mem_load(st, S_CFA_EXPR, 8) != 0 || cr < 0 || cr >= NREG {
        break
      }
      let cfa = rt.mem_load(cur, 8 * cr, 8) + rt.mem_load(st, S_CFA_OFF, 8)
      if cfa < sp || cfa - sp > PROF_SPAN {
        break
      }
      if !step(s, cur) {
        break
      }
    }
    let nsp = rt.mem_load(cur, spo, 8)
    if nsp < sp || nsp - sp > PROF_SPAN || (nsp == sp && !first) {
      break
    }
    first = false
  }
  n
}

/// The offset of the pc in a register set (crash.xo).
pub const PC_AT = PC

/// The registers of the context a fault signal interrupted, from its
/// ucontext uc into regs (DWARF numbering, the pc at PC_AT; crash.xo,
/// decision 0343). Async signal safe. Whether this target has a layout.
pub fn crash_regs(uc: Int, regs: Int) -> Bool {
  let darwin = match target.os {
    TargetOs.Darwin => true
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => false
  }
  prof_regs(uc, regs, darwin)
}

/// Copies the interrupted registers from ucontext uc into the register
/// set regs (DWARF numbering, the pc at PC). Whether this target has a
/// layout here.
fn prof_regs(uc: Int, regs: Int, darwin: Bool) -> Bool {
  if !x64() {
    if darwin {
      // ucontext: uc_mcontext (a pointer) at 48; arm_thread_state64 at
      // 16 in it: x0 to x28, fp, lr, sp, pc
      let ss = rt.mem_load(uc, 48, 8) + 16
      for r in 0..29 {
        rt.mem_store(regs, 8 * r, rt.mem_load(ss, 8 * r, 8), 8)
      }
      rt.mem_store(regs, 8 * 29, rt.mem_load(ss, 232, 8), 8)
      rt.mem_store(regs, 8 * 30, rt.mem_load(ss, 240, 8), 8)
      rt.mem_store(regs, SP, rt.mem_load(ss, 248, 8), 8)
      rt.mem_store(regs, PC, rt.mem_load(ss, 256, 8) & 281474976710655, 8)
      return true
    }
    // the kernel's ucontext: struct sigcontext at 176: fault_address,
    // regs[31], sp, pc
    for r in 0..31 {
      rt.mem_store(regs, 8 * r, rt.mem_load(uc, 184 + 8 * r, 8), 8)
    }
    rt.mem_store(regs, SP, rt.mem_load(uc, 432, 8), 8)
    rt.mem_store(regs, PC, rt.mem_load(uc, 440, 8), 8)
    return true
  }
  // x86_64, DWARF order: rax rdx rcx rbx rsi rdi rbp rsp r8..r15
  if darwin {
    // x86_thread_state64 at 16 in uc_mcontext (at 48): rax rbx rcx rdx
    // rdi rsi rbp rsp r8..r15 rip
    let ss = rt.mem_load(uc, 48, 8) + 16
    for i in 0..16 {
      rt.mem_store(regs, 8 * x64_darwin_reg(i), rt.mem_load(ss, 8 * i, 8), 8)
    }
    rt.mem_store(regs, PC, rt.mem_load(ss, 128, 8), 8)
    return true
  }
  // Linux: gregs at 40: r8..r15, rdi rsi rbp rbx rdx rax rcx rsp rip
  let g = uc + 40
  for i in 0..16 {
    rt.mem_store(regs, 8 * x64_linux_reg(i), rt.mem_load(g, 8 * i, 8), 8)
  }
  rt.mem_store(regs, PC, rt.mem_load(g, 128, 8), 8)
  true
}

/// The DWARF number of word i of macOS's x86_thread_state64 (rax rbx rcx
/// rdx rdi rsi rbp rsp r8..r15); no list (the signal handler allocates
/// nothing).
fn x64_darwin_reg(i: Int) -> Int {
  match i {
    1 => 3
    2 => 2
    3 => 1
    4 => 5
    5 => 4
    _ => i
  }
}

/// The DWARF number of word i of Linux's gregs (r8..r15 rdi rsi rbp rbx
/// rdx rax rcx rsp).
fn x64_linux_reg(i: Int) -> Int {
  match i {
    8 => 5
    9 => 4
    10 => 6
    11 => 3
    12 => 1
    13 => 0
    14 => 2
    15 => 7
    _ => i + 8
  }
}

// Windows profiles (decision 0238): the walk reads only the image (its
// .pdata, searched here, not with RtlLookupFunctionEntry, which takes
// the loader's lock a thread the sampler suspended may hold) and the
// stack (RtlVirtualUnwind), and allocates nothing.

/// The program's image into the profiler record s: its base, .pdata, and
/// executable sections (x86_64, PE32+). Whether its .pdata was found.
fn win_image(s: Int) -> Bool {
  let base = sys_windows.GetModuleHandleW(0)
  if base == 0 {
    return false
  }
  let pe = base + rt.mem_load(base, 60, 4)
  let nsec = rt.mem_load(pe, 6, 2)
  let opt = pe + 24
  // the data directories at 112; the exception directory is the fourth
  rt.mem_store(s, W_PBASE, base, 8)
  rt.mem_store(s, W_PDATA, base + rt.mem_load(opt, 136, 4), 8)
  rt.mem_store(s, W_PDATA_N, rt.mem_load(opt, 140, 4) / 12, 8)
  let sec = opt + rt.mem_load(pe, 20, 2)
  var lo = 0
  var hi = 0
  for i in 0..nsec {
    let h = sec + 40 * i
    // IMAGE_SCN_MEM_EXECUTE
    if (rt.mem_load(h, 36, 4) & 536870912) != 0 {
      let a = base + rt.mem_load(h, 12, 4)
      let b = a + rt.mem_load(h, 8, 4)
      if lo == 0 || a < lo {
        lo = a
      }
      if b > hi {
        hi = b
      }
    }
  }
  rt.mem_store(s, W_PLO, lo, 8)
  rt.mem_store(s, W_PHI, hi, 8)
  lo != 0 && rt.mem_load(s, W_PDATA_N, 8) != 0
}

/// The CONTEXT of the profiler record s (16 byte aligned), its
/// ContextFlags set for GetThreadContext: CONTEXT_AMD64 | CONTEXT_CONTROL
/// | CONTEXT_INTEGER.
pub fn win_context(s: Int) -> Int {
  let cx = s + W_CX
  rt.mem_store(cx, 48, 1048579, 4)
  cx
}

/// The pcs of the frames from the CONTEXT of record s (the innermost
/// first) into the words at out, at most max: their count. first: the
/// context's pc is an interrupted instruction (a suspended thread's),
/// else a return address. A frame of the program is unwound by its
/// .pdata entry; a leaf without one, or a first frame outside the program
/// (a system DLL's: its return address taken at Rsp once), returns to the
/// word at Rsp. Each return address must follow a call in the program's
/// text and the stack pointer must rise, or the walk ends.
pub fn win_walk(s: Int, out: Int, max: Int, first0: Bool) -> Int {
  let cx = s + W_CX
  let lo = rt.mem_load(s, W_PLO, 8)
  let hi = rt.mem_load(s, W_PHI, 8)
  var n = 0
  var first = first0
  while n < max {
    let pc = rt.mem_load(cx, WX_PC, 8)
    let sp = rt.mem_load(cx, WX_SP, 8)
    if pc == 0 || sp == 0 {
      break
    }
    if !first && !after_call(pc, lo, hi) {
      break
    }
    rt.mem_store(out, 8 * n, pc, 8)
    n += 1
    let f = if pc >= lo && pc < hi { pdata_find(s, if first { pc } else { pc - 1 }) } else { 0 }
    if f == 0 {
      if !first && (pc < lo || pc >= hi) {
        break
      }
      rt.mem_store(cx, WX_PC, rt.mem_load(sp, 0, 8), 8)
      rt.mem_store(cx, WX_SP, sp + 8, 8)
    } else {
      // UNW_FLAG_NHANDLER
      let _h = sys_windows.RtlVirtualUnwind(0, rt.mem_load(s, W_PBASE, 8), pc, f, cx, s + W_DATA, s + W_EST, 0)
      let nsp = rt.mem_load(cx, WX_SP, 8)
      if nsp <= sp || nsp - sp > PROF_SPAN {
        break
      }
    }
    first = false
  }
  n
}

/// The CONTEXT offsets of the x86_64 DWARF registers 0 to 15 (rax, rdx,
/// rcx, rbx, rsi, rdi, rbp, rsp, r8 to r15).
fn wx_dwarf(r: Int) -> Int {
  match r {
    0 => 120
    1 => 136
    2 => 128
    3 => 144
    4 => 168
    5 => 176
    6 => 160
    7 => 152
    _ => 184 + 8 * (r - 8)
  }
}

/// win_walk keeping each frame's registers (trace_frames' record: the
/// return address, then rw words by DWARF register number, those past 15
/// zero), taken from the CONTEXT before the frame is unwound: the
/// nonvolatile ones (rbx, rbp, rdi, rsi, r12 to r15) and rsp are the
/// frame's, as RtlVirtualUnwind restored them; the others are left over
/// from frames below it (decision 0268's locals on Windows). From a
/// captured context (its pc a return address), so the first frame too
/// takes its .pdata entry at pc - 1.
fn win_walk_regs(s: Int, out: Int, max: Int, rw: Int) -> Int {
  let cx = s + W_CX
  let lo = rt.mem_load(s, W_PLO, 8)
  let hi = rt.mem_load(s, W_PHI, 8)
  var n = 0
  while n < max {
    let pc = rt.mem_load(cx, WX_PC, 8)
    let sp = rt.mem_load(cx, WX_SP, 8)
    if pc == 0 || sp == 0 || !after_call(pc, lo, hi) {
      break
    }
    let rec = out + 8 * (1 + rw) * n
    rt.mem_store(rec, 0, pc, 8)
    rt.mem_set(rec + 8, 0, 8 * rw)
    var r = 0
    while r < 16 && r < rw {
      rt.mem_store(rec + 8, 8 * r, rt.mem_load(cx, wx_dwarf(r), 8), 8)
      r += 1
    }
    n += 1
    let f = if pc >= lo && pc < hi { pdata_find(s, pc - 1) } else { 0 }
    if f == 0 {
      if pc < lo || pc >= hi {
        break
      }
      rt.mem_store(cx, WX_PC, rt.mem_load(sp, 0, 8), 8)
      rt.mem_store(cx, WX_SP, sp + 8, 8)
    } else {
      // UNW_FLAG_NHANDLER
      let _h = sys_windows.RtlVirtualUnwind(0, rt.mem_load(s, W_PBASE, 8), pc, f, cx, s + W_DATA, s + W_EST, 0)
      let nsp = rt.mem_load(cx, WX_SP, 8)
      if nsp <= sp || nsp - sp > PROF_SPAN {
        break
      }
    }
  }
  n
}

/// Whether nothing would handle the exception whose CONTEXT is record
/// s's (win_context; walked and changed here) but the end of the stack
/// (crash.xo's vectored handler): every frame from the faulting pc down
/// is the program's, none has an exception handler but Xo's personality
/// (pers, which takes no hardware exception), and the walk ends in the
/// program (a fiber's or thread's first frame, a zero or wild return
/// address). False for a fault outside the program, a handler of C code
/// (__try), or a caller in another module (a DLL that called back into
/// the program, a thread's start in kernel32): their handlers decide,
/// and the unhandled exception filter sees what they leave.
pub fn win_unhandled(s: Int, pers: Int) -> Bool {
  let cx = s + W_CX
  let lo = rt.mem_load(s, W_PLO, 8)
  let hi = rt.mem_load(s, W_PHI, 8)
  var first = true
  for _ in 0..4096 {
    let pc = rt.mem_load(cx, WX_PC, 8)
    let sp = rt.mem_load(cx, WX_SP, 8)
    if pc == 0 || sp == 0 {
      return true
    }
    if pc < lo || pc >= hi {
      return false
    }
    if !first && !after_call(pc, lo, hi) {
      return true
    }
    let f = pdata_find(s, if first { pc } else { pc - 1 })
    if f == 0 {
      rt.mem_store(cx, WX_PC, rt.mem_load(sp, 0, 8), 8)
      rt.mem_store(cx, WX_SP, sp + 8, 8)
    } else {
      // UNW_FLAG_EHANDLER: the frame's exception handler, or 0
      let h = sys_windows.RtlVirtualUnwind(1, rt.mem_load(s, W_PBASE, 8), pc, f, cx, s + W_DATA, s + W_EST, 0)
      if h != 0 && h != pers {
        return false
      }
      let nsp = rt.mem_load(cx, WX_SP, 8)
      if nsp <= sp || nsp - sp > PROF_SPAN {
        return true
      }
    }
    first = false
  }
  true
}

/// Whether ra is a return address in the program's text: it follows a
/// call (E8 rel32, or FF /2 with a register, a memory operand, or a
/// displacement).
fn after_call(ra: Int, lo: Int, hi: Int) -> Bool {
  if ra < lo + 7 || ra >= hi {
    return false
  }
  if rt.mem_load(ra, -5, 1) == 232 {
    return true
  }
  call_ff(ra, 2) || call_ff(ra, 3) || call_ff(ra, 6) || call_ff(ra, 7)
}

/// Whether the k bytes before ra are an FF /2 call.
fn call_ff(ra: Int, k: Int) -> Bool { rt.mem_load(ra, 0 - k, 1) == 255 && (rt.mem_load(ra, 1 - k, 1) & 56) == 16 }

/// The RUNTIME_FUNCTION of record s's image whose range holds pc (a
/// binary search of its .pdata), or 0.
fn pdata_find(s: Int, pc: Int) -> Int {
  let rva = pc - rt.mem_load(s, W_PBASE, 8)
  let t = rt.mem_load(s, W_PDATA, 8)
  var a = 0
  var b = rt.mem_load(s, W_PDATA_N, 8)
  while a < b {
    let m = (a + b) / 2
    let f = t + 12 * m
    if rt.mem_load(f, 0, 4) > rva {
      b = m
    } else if rt.mem_load(f, 4, 4) <= rva {
      a = m + 1
    } else {
      return f
    }
  }
  0
}
