// Go's compress/flate in Xo for the native backends (decision 0172, moved
// out of std/native/archive.xo for std/compress, decision 0305): the
// bit writer and Huffman encoders of huffman_bit_writer.go and
// huffman_code.go, the compressor of deflate.go, the decompressor of
// inflate.go, and hash/crc32's IEEE table. std/native/archive.xo and
// std/native/compress.xo use it.
use native/llrt/raw
use native/llrt/cpu
use native/rt
// ---------------------------------------------------------------------------
// Bytes

fn byte_of(b: Bytes, i: Int) -> Int { Int(b[i]) }

fn bytes_of(l: List[Int]) -> Bytes {
  var b = BytesBuilder.with_capacity(l.len())
  for x in l {
    b.write_byte(UInt8(x & 255))
  }
  b.freeze()
}

fn sub(b: Bytes, lo: Int, hi: Int) -> Bytes { b[lo..hi] }

fn put_u16(var b: BytesBuilder, v: Int) {
  b.write_byte(UInt8(v & 255))
  b.write_byte(UInt8((v >> 8) & 255))
}

fn put_u32(var b: BytesBuilder, v: Int) {
  put_u16(b, v & 65535)
  put_u16(b, (v >> 16) & 65535)
}

fn get_u16(b: Bytes, i: Int) -> Int { byte_of(b, i) | (byte_of(b, i + 1) << 8) }

fn get_u32(b: Bytes, i: Int) -> Int { get_u16(b, i) | (get_u16(b, i + 2) << 16) }

/// A little endian uint64 (one at or above 2^63 is negative: callers
/// refuse it, as Go's checks against maxInt64 do).
fn get_u64(b: Bytes, i: Int) -> Int { get_u32(b, i) | (get_u32(b, i + 4) << 32) }

/// A list of n zeros in one allocation (decision 0207 stage 2).
fn zeros(n: Int) -> List[Int] { raw.zero_ints(n) }

// ---------------------------------------------------------------------------
// CRC-32 (IEEE), hash/crc32

