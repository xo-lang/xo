/// entry k*256+i is the CRC of byte i followed by k zero bytes. A
/// constant, as Go's is computed once: building it took 2048 stores for
/// each gzip write and each inflate stream (2026-10-28; generated by
/// polynomial 0xedb88320, flate_test.xo checks it against the loop).
pub fn crc_table() -> List[Int] { CRC_TABLE }

