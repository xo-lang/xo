// The HTTP server's registration, streamed bodies, and the table of
// streamed responses, in Xo (the zero-C audit's B28 part 3; xo_http.c
// until 2026-10-14).
//
// A server (rthttp.Srv, hconn.xo SR_*) keeps its live connections and a
// scope of its own for their tasks, linked under main's root: canceling
// the serving task does not cancel requests in flight (std/rt's
// reqRoot); ending main (the grace period, a second signal) does. A
// connection (rthttp.HConn, hconn.xo HC_*) owns http1.xo's X1 record or,
// over HTTP/2, h2srv.xo's connection record; a stream's connection
// (hconn.stream) holds a stream record and its own X1 record (the
// response header).
//
// A sink takes the writes of a stream's body (http.stream, decision
// 0083): into a buffer (a response dispatched in process, collected), or
// to a connection as net/http's response writer sends them: through a
// 2048 byte buffer (std/rt writes strings, and bufio.Writer.WriteString
// fills and flushes the buffer in turn; HTTP/2's is 4 KiB,
// handlerChunkWriteSize), the head going out with the first data that
// leaves the buffer (or the first flush) while the handler is not done,
// so chunked on HTTP/1.1; a stream that never leaves the buffer is an
// ordinary response when it ends.
//
// The Windows arms are UNTESTED on windows: written on macOS and checked
// by the cross build only.
use native/llrt/layout
use std/task
use native/llrt/atexit
use native/llrt/ctx
use native/llrt/hclient
use native/llrt/hconn
use native/llrt/http1
use native/llrt/obj
use native/llrt/poll
use native/llrt/pool
use native/llrt/raw
use native/llrt/rc
use native/llrt/sanhook
use native/llrt/sysio
use native/llrt/stop
use native/llrt/tasks
use native/llrt/tlssrv
use native/llrt/tracerec
use native/llrt/x509cert as x509
use native/rt
use native/rthttp

/// A sink's record (byte offsets): the header; whether it sends to a
/// connection; its buffer (malloc'd), count, and capacity; the
/// connection (a reference) and the response's status; whether the head
/// went out and whether the connection failed; HTTP/1.1's state
/// (http1.xo's SK_* bits).
const SK_CONN = 16
const SK_BUF = 24
const SK_N = 32
const SK_CAP = 40
const SK_HC = 48
const SK_STATUS = 56
const SK_STARTED = 64
const SK_FAILED = 72
const SK_STATE = 80
/// The trailers set after the body (decision 0433): a block of
/// "name\nvalue\n" pairs: a block of its length (a word), then the bytes, 0
/// for none (h2srv.xo trailer_fields reads the same block).
const SK_TRL = 88
/// whether the response head declared a Trailer (a trailer after no body
/// still needs the chunked end then)
const SK_DECL = 96
const SK_SIZE = 104

/// The table of streamed responses (in the services record, ctx.xo
/// SV_STREAMS): a lock word, the array of functions (malloc'd; an Any's
/// object each, counted, or 0 once taken), the count.
const ST_MU = 0
const ST_FS = 8
const ST_N = 16

/// 30 s in ns (net/http's Shutdown in std/rt).
const WAIT_NS = 30000000000

/// The wait list entry of a context (tasks.xo E_*): the park, the links,
/// the writer flag.
const E_PARK = layout.E_PARK
const E_WRITER = layout.E_WRITER
fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

fn srec(s: rthttp.Srv) -> Int { rt.obj_addr(s) }

// ---------------------------------------------------------------------------
// The server

/// A new server, with the scope of its connections open.
pub fn srv_new() -> rthttp.Srv {
  let s = tasks.new_handle(hconn.SR_SIZE, rt.fn_addr("srv_free"))
  poll.set_cont_fire(rt.fn_addr("pd_cont_fire"))
  let root = stop.root()
  st(s, hconn.SR_SCOPE, tasks.scope_detached(if root != 0 { root } else { ld(ctx.cur(), ctx.C_NODE) }))
  let h = rt.obj_at[rthttp.Srv](s)
  tasks.h_release(s)
  h
}

/// The scope of the connection tasks as a task.Group.
pub fn srv_group(s: rthttp.Srv) -> task.Group {
  let g = tasks.scope_group(ld(srec(s), hconn.SR_SCOPE))
  let h = rt.obj_at[task.Group](g)
  tasks.h_release(g)
  h
}

// ---------------------------------------------------------------------------
// Parked idle connections (decision 0449)

/// A continuation record (byte offsets): the server, the resume
/// function's id in the stream table, the next record of the ready list,
/// the connection's poll descriptor, its idle deadline (monotonic ns, 0
/// none), and the links of the server's parked list.
const PC_SIZE = 56
const PC_SRV = 0
const PC_ID = 8
const PC_NEXT = 16
const PC_PD = 24
const PC_DL = 32
const PC_PREV = 40
const PC_PLINK = 48

/// Whether h is a busy keep-alive connection (hconn.quick).
pub fn hc_quick(h: rthttp.HConn) -> Bool { hconn.quick(h) }

/// hconn.note_request.
pub fn hc_note_request(h: rthttp.HConn) { hconn.note_request(h) }

/// hconn.note_done.
pub fn hc_note_done(h: rthttp.HConn) { hconn.note_done(h) }

/// Parks idle connection h (its task is about to end): resume is run in a
/// task of the server's scope when the connection becomes readable or is
/// closed, or when idle_ns (the server's idle timeout, 0 none) passes
/// without a request (the connection then closes). False when it did not
/// park (the caller reads on).
pub fn hc_park(h: rthttp.HConn, resume: fn() -> (), idle_ns: Int) -> Bool {
  if !hconn.park_ready(h) {
    return false
  }
  let hc = hconn.rec(h)
  let srv = ld(hc, hconn.HC_SRV)
  let pd = hconn.conn_pd(hc)
  let id = stream_put(rt.any_of(resume))
  let pc = obj.alloc_obj(PC_SIZE)
  st(pc, PC_SRV, srv)
  st(pc, PC_ID, id)
  st(pc, PC_NEXT, 0)
  st(pc, PC_PD, pd)
  st(pc, PC_DL, if idle_ns > 0 { hconn.deadline(idle_ns) } else { 0 })
  hconn.rlock(srv)
  parked_add(srv, pc)
  hconn.runlock(srv)
  if poll.pd_park(pd, pc) {
    if idle_ns > 0 {
      kick_resumer(srv)
    }
    return true
  }
  // readiness came meanwhile: not parked after all
  hconn.rlock(srv)
  parked_del(srv, pc)
  hconn.runlock(srv)
  let _f = stream_get(id, true)
  obj.free_obj(pc)
  hconn.set_idle(hc, false)
  false
}

/// Links pc into the server's parked list and counts it (RLOCK held).
fn parked_add(srv: Int, pc: Int) {
  let head = ld(srv, hconn.SR_PARKLIST)
  st(pc, PC_PREV, 0)
  st(pc, PC_PLINK, head)
  if head != 0 {
    st(head, PC_PREV, pc)
  }
  st(srv, hconn.SR_PARKLIST, pc)
  st(srv, hconn.SR_PARKED, ld(srv, hconn.SR_PARKED) + 1)
}

/// Unlinks pc from the parked list and uncounts it (RLOCK held).
fn parked_del(srv: Int, pc: Int) {
  let prev = ld(pc, PC_PREV)
  let next = ld(pc, PC_PLINK)
  if prev != 0 {
    st(prev, PC_PLINK, next)
  } else {
    st(srv, hconn.SR_PARKLIST, next)
  }
  if next != 0 {
    st(next, PC_PREV, prev)
  }
  st(srv, hconn.SR_PARKED, ld(srv, hconn.SR_PARKED) - 1)
}

/// The poller's (or a closer's) hand-off of a fired continuation pc to its
/// server's ready list, waking the resumer (cabi_http.xo pd_cont_fire).
pub fn cont_fire(pc: Int) {
  let srv = ld(pc, PC_SRV)
  hconn.rlock(srv)
  parked_del(srv, pc)
  st(pc, PC_NEXT, ld(srv, hconn.SR_READY))
  st(srv, hconn.SR_READY, pc)
  let w = ld(srv, hconn.SR_RESUMER)
  hconn.runlock(srv)
  if w != 0 {
    wake_resumer(w)
  }
}

fn wake_resumer(w: Int) {
  sanhook.release(w)
  pool.park_signal(ctx.pool(), w)
}

/// Wakes the resumer to look at the deadlines again.
fn kick_resumer(srv: Int) {
  hconn.rlock(srv)
  let w = ld(srv, hconn.SR_RESUMER)
  hconn.runlock(srv)
  if w != 0 {
    wake_resumer(w)
  }
}

/// Closes the parked connections whose idle deadline passed: each is
/// taken back from its descriptor (pd_unpark), so the poller no longer
/// owns it, closed, and handed to the ready list to resume and end.
/// Returns the earliest deadline left (0 none).
fn sweep_idle(srv: Int) -> Int {
  let now = sysio.mono_ns()
  var next = 0
  var expired: List[Int] = []
  hconn.rlock(srv)
  var pc = ld(srv, hconn.SR_PARKLIST)
  while pc != 0 {
    let dl = ld(pc, PC_DL)
    if dl != 0 {
      if dl <= now {
        expired.push(pc)
      } else if next == 0 || dl < next {
        next = dl
      }
    }
    pc = ld(pc, PC_PLINK)
  }
  hconn.runlock(srv)
  for pc in expired {
    // the poller may have fired it meanwhile: then it is not ours
    if poll.pd_unpark(ld(pc, PC_PD), pc) {
      poll.pd_close(ld(pc, PC_PD))
      cont_fire(pc)
    }
  }
  next
}

/// The next connection to resume, as the function to run (a resume
/// function from hc_park), waiting for one (and closing parked
/// connections that stay idle past the server's idle timeout); None when
/// the server is stopping and nothing is parked or ready.
pub fn resume_next(s: rthttp.Srv) -> (fn() -> ())? {
  let a = srec(s)
  let c = ctx.cur()
  let park = c + ctx.C_PARK
  while true {
    let next = sweep_idle(a)
    hconn.rlock(a)
    let pc = ld(a, hconn.SR_READY)
    if pc != 0 {
      st(a, hconn.SR_READY, ld(pc, PC_NEXT))
      hconn.runlock(a)
      let id = ld(pc, PC_ID)
      obj.free_obj(pc)
      let fs = stream_get(id, true)
      if !fs.is_empty() {
        if let Some(f) = rt.any_get[fn() -> ()](fs[0]) {
          return Some(f)
        }
      }
      continue
    }
    if hconn.stopping_at(a) && ld(a, hconn.SR_PARKED) == 0 {
      hconn.runlock(a)
      return None
    }
    pool.park_reset(park)
    st(a, hconn.SR_RESUMER, park)
    hconn.runlock(a)
    var t = 0
    if next != 0 {
      t = poll.timer_park(next, park)
    }
    tasks.park_wait_n(c, true, false)
    if t != 0 {
      poll.timer_end(t)
    }
    hconn.rlock(a)
    st(a, hconn.SR_RESUMER, 0)
    hconn.runlock(a)
    if poll.canceled() {
      drain(a)
      return None
    }
  }
  None
}

/// The resumer ends (its scope canceled it) with connections still parked
/// or fired and not yet resumed: each parked one is taken back and closed,
/// and every fired record is freed with its resume function (which
/// releases the connection), so no continuation record outlives the server
/// (the arm64 goldens' "1 allocations still live at exit", 2026-10-31).
fn drain(a: Int) {
  var parked: List[Int] = []
  hconn.rlock(a)
  var pc = ld(a, hconn.SR_PARKLIST)
  while pc != 0 {
    parked.push(pc)
    pc = ld(pc, PC_PLINK)
  }
  hconn.runlock(a)
  for pc in parked {
    if poll.pd_unpark(ld(pc, PC_PD), pc) {
      poll.pd_close(ld(pc, PC_PD))
      cont_fire(pc)
    }
  }
  hconn.rlock(a)
  var r = ld(a, hconn.SR_READY)
  st(a, hconn.SR_READY, 0)
  hconn.runlock(a)
  while r != 0 {
    let next = ld(r, PC_NEXT)
    let id = ld(r, PC_ID)
    obj.free_obj(r)
    let _f = stream_get(id, true)
    r = next
  }
}

/// Stops the server: connections close after their current request, and
/// idle ones now.
pub fn srv_stop(s: rthttp.Srv) { stop_at(srec(s)) }

fn stop_at(a: Int) {
  hconn.lock(a)
  // stopping first, then each connection's mark (hconn.stopping_at)
  hconn.set_stopping(a)
  var hc = ld(a, hconn.SR_CONNS)
  while hc != 0 {
    let h2 = ld(hc, hconn.HC_H2)
    if h2 != 0 {
      // GOAWAY, then the streams in flight finish
      let _s = rt.call_c2(hconn.tls_op(hconn.TO_H2_STOP), h2, 0)
    } else if hconn.idle_at(hc) {
      poll.pd_close(hconn.conn_pd(hc))
    }
    hc = ld(hc, hconn.HC_NEXT)
  }
  hconn.unlock(a)
  // the resumer looks again: nothing parked ends it
  hconn.rlock(a)
  let w = ld(a, hconn.SR_RESUMER)
  hconn.runlock(a)
  if w != 0 {
    wake_resumer(w)
  }
}

/// Waits for the connections to end: after a stop request (core 7.5)
/// until they do or the serving task is canceled (the grace period
/// ended); else (serve's task was canceled) at most 30 s, as net/http's
/// Shutdown in std/rt.
pub fn srv_wait(s: rthttp.Srv) {
  let a = srec(s)
  let c = ctx.cur()
  let stopping = stop.requested()
  let until = if stopping { 0 } else { hconn.deadline(WAIT_NS) }
  let park = c + ctx.C_PARK
  let e = c + ctx.C_WENT
  var t = 0
  hconn.lock(a)
  while ld(a, hconn.SR_N) > 0 {
    if stopping && poll.canceled() {
      break
    }
    if t != 0 && poll.timer_fired(t) {
      break
    }
    st(e, E_PARK, park)
    st(e, E_WRITER, 0)
    pool.park_reset(park)
    tasks.wl_add(a + hconn.SR_IDLE, e)
    hconn.unlock(a)
    if until != 0 && t == 0 {
      t = poll.timer_park(until, park)
    }
    if tracerec.built() {
      rt.mem_store(c, ctx.C_WHY, tracerec.WHY_HTTP, 8)
    }
    tasks.park_wait_n(c, stopping, false)
    hconn.lock(a)
    tasks.wl_del(a + hconn.SR_IDLE, e)
  }
  hconn.unlock(a)
  if t != 0 {
    poll.timer_end(t)
  }
}

/// Cancels the connections left and waits for their tasks.
pub fn srv_close(s: rthttp.Srv) {
  let a = srec(s)
  if ld(a, hconn.SR_CLOSED) != 0 {
    return
  }
  st(a, hconn.SR_CLOSED, 1)
  stop_at(a)
  hconn.lock(a)
  var hc = ld(a, hconn.SR_CONNS)
  while hc != 0 {
    poll.pd_close(hconn.conn_pd(hc))
    hc = ld(hc, hconn.HC_NEXT)
  }
  hconn.unlock(a)
  let c = ctx.cur()
  let saved = ld(c, ctx.C_NODE)
  let u = rt.mem_load(c, ctx.C_UNWINDING, 4)
  rt.mem_store(c, ctx.C_UNWINDING, 0, 4)
  let sc = ld(a, hconn.SR_SCOPE)
  let _r = tasks.scope_close(sc, 1)
  tasks.h_release(sc)
  st(c, ctx.C_NODE, saved)
  rt.mem_store(c, ctx.C_UNWINDING, u, 4)
}

/// Adds certificate c to server s (http.Server.with_tls); the first
/// turns TLS on.
pub fn srv_tls(s: rthttp.Srv, c: tlssrv.Cert) { tlssrv.srv_add(s, srec(s), hconn.SR_TLS, c) }

/// Sets server s's client certificate mode (tls13srv's AUTH_* number) and
/// the roots that verify them (http.Server.with_client_auth).
pub fn srv_client_auth(s: rthttp.Srv, mode: Int, roots: List[x509.Cert]) { tlssrv.srv_client_auth(srec(s), hconn.SR_TLS, mode, roots) }

/// Sets the ALPN protocols server s's TLS offers (with_protocols).
pub fn srv_alpn(s: rthttp.Srv, alpn: List[Str]) { tlssrv.srv_alpn(srec(s), hconn.SR_TLS, alpn) }

/// Sets server s's HTTP/2 settings block (http.Server.with_h2_config; 0
/// is each one's default, an out of range one is clamped as Go's
/// configFromServer does): max concurrent streams, max read frame size,
/// the connection's and each stream's receive window, the HPACK table
/// the peer may use.
pub fn srv_h2cfg(s: rthttp.Srv, streams: Int, frame: Int, conn_win: Int, stream_win: Int, table: Int, ping_idle: Int = 0, ping_wait: Int = 0, write_to: Int = 0, enc_table: Int = 0) {
  let a = srec(s)
  var blk = ld(a, hconn.SR_H2CFG)
  if blk == 0 {
    blk = rt.heap_large(72)
    st(a, hconn.SR_H2CFG, blk)
  }
  st(blk, 0, if streams > 0 { streams } else { 250 })
  st(blk, 8, if frame >= 16384 && frame <= 16777215 { frame } else { 1048576 })
  st(blk, 16, if conn_win >= 65535 { conn_win } else { 1048576 })
  st(blk, 24, if stream_win >= 1 { stream_win } else { 1048576 })
  st(blk, 32, if table > 0 { table } else { 4096 })
  st(blk, 40, if ping_idle > 0 { ping_idle } else { 0 })
  st(blk, 48, if ping_wait > 0 { ping_wait } else { 0 })
  st(blk, 56, if write_to > 0 { write_to } else { 0 })
  st(blk, 64, if enc_table > 0 { enc_table } else { 0 })
}

/// Frees server record a (its last reference went; cabi_http.xo
/// srv_free).
pub fn srv_free(a: Int) {
  let sc = ld(a, hconn.SR_SCOPE)
  if sc != 0 && ld(a, hconn.SR_CLOSED) == 0 {
    // never closed (serve did not get to its end): its tasks hold the
    // server, so none is left
    tasks.h_release(sc)
  }
  let cfg = ld(a, hconn.SR_H2CFG)
  if cfg != 0 {
    rt.heap_release(cfg)
  }
  let tls = ld(a, hconn.SR_TLS)
  if tls != 0 {
    let _f = rt.call_c2(hconn.tls_op(hconn.TO_SRV_FREE), tls, 0)
  }
  obj.free_obj(a)
}

// ---------------------------------------------------------------------------
// Connections

/// Registers connection c (accepted by the listener) with server s.
pub fn hc_new(s: rthttp.Srv, c: ServerConn) -> rthttp.HConn {
  let a = srec(s)
  let cn = rt.obj_addr(c)
  let hc = tasks.new_handle(hconn.HC_SIZE, rt.fn_addr("hc_free"))
  rc.inc(a)
  rc.inc(cn)
  st(hc, hconn.HC_SRV, a)
  st(hc, hconn.HC_CONN, cn)
  let pd = hconn.conn_pd(hc)
  hconn.set_ip(hc, hconn.peer_ip(rt.mem_load(pd, 8, 4)))
  hconn.lock(a)
  let first = ld(a, hconn.SR_CONNS)
  st(hc, hconn.HC_NEXT, first)
  if first != 0 {
    st(first, hconn.HC_PREV, hc)
  }
  st(a, hconn.SR_CONNS, hc)
  st(a, hconn.SR_N, ld(a, hconn.SR_N) + 1)
  st(hc, hconn.HC_REG, 1)
  let tls = ld(a, hconn.SR_TLS)
  if tls != 0 {
    st(hc, hconn.HC_TLS, rt.call_c2(hconn.tls_op(hconn.TO_CONN), tls, pd))
  }
  if hconn.stopping_at(a) {
    poll.pd_close(pd)
  }
  hconn.unlock(a)
  hconn.take(hc)
}

/// Finishes the TLS handshake of a server connection; when ALPN chose
/// HTTP/2, the connection's record (h2srv.conn_new, freed with the
/// connection; its requests come from h2srv's H2Conn), else 0: HTTP/1.1
/// (or the handshake failed, which http1.xo's reads find). The
/// handshake's waits end at `when` (monotonic ns, 0 none: net/http's
/// handshake deadline, the smaller of the read and head timeouts), after
/// which the handshake fails and the connection closes without a reply;
/// the handshake runs before the connection's limits are stored, so a
/// silent client held a TLS connection's task for ever (2026-10-30).
/// The deadline of TLS connection tls's handshake and reads, through
/// the TLS table (decision 0244: a direct tlssrv call here linked the
/// TLS server into a plain one, gotchas/tls-table-direct-call-links-tlssrv.md).
fn tls_deadline(tls: Int, when: Int) {
  let _d = rt.call_c2(hconn.tls_op(hconn.TO_SET_DEADLINE), tls, when)
}

pub fn hc_h2(h: rthttp.HConn, when: Int) -> Int {
  let hc = hconn.rec(h)
  let tls = ld(hc, hconn.HC_TLS)
  if tls == 0 || ld(hc, hconn.HC_CONN) == 0 {
    return 0
  }
  tls_deadline(tls, when)
  defer tls_deadline(tls, 0)
  let s = ld(hc, hconn.HC_SRV)
  if s != 0 {
    // the mark first, then stopping (hconn.stopping_at)
    hconn.set_idle(hc, true)
    if hconn.stopping_at(s) {
      return 0
    }
  }
  // the handshake and HTTP/2's setup (cabi_tls.xo srvtls_h2)
  rt.call_c2(hconn.tls_op(hconn.TO_H2), hc, tls)
}

/// Marks server s as taking HTTP/2 with prior knowledge on plain
/// connections (h2c, decision 0434; http.Server.with_protocols).
pub fn srv_h2c(s: rthttp.Srv, only: Bool = false) {
  rt.mem_store(srec(s), hconn.SR_H2C, if only { 2 } else { 1 }, 8)
}

/// The HTTP/2 record of plain connection h when its client opens with the
/// HTTP/2 preface and its server takes h2c (srv_h2c), else 0: the bytes
/// read stay for HTTP/1.1. The sniff waits under when (the read header
/// timeout, monotonic ns, 0 none).
pub fn hc_h2c(h: rthttp.HConn, when: Int) -> Int {
  let hc = hconn.rec(h)
  let s = ld(hc, hconn.HC_SRV)
  if s == 0 || ld(s, hconn.SR_H2C) == 0 || ld(hc, hconn.HC_TLS) != 0 || ld(hc, hconn.HC_CONN) == 0 {
    return 0
  }
  if hconn.stopping_at(s) {
    return 0
  }
  if hconn.sniff_h2c(h, when) != 1 {
    if ld(s, hconn.SR_H2C) == 2 {
      // a server without HTTP/1.1 closes such a connection
      poll.pd_close(hconn.conn_pd(hc))
    }
    return 0
  }
  rt.call_c2(hconn.tls_op(hconn.TO_H2C), hc, 0)
}

/// Closes the connection and ends its registration.
pub fn hc_close(h: rthttp.HConn) {
  let hc = hconn.rec(h)
  let tls = ld(hc, hconn.HC_TLS)
  if tls != 0 {
    let _c = rt.call_c2(hconn.tls_op(hconn.TO_CLOSE_NOTIFY), tls, 0)
  }
  poll.pd_close(hconn.conn_pd(hc))
  hconn.unregister(hc)
}

/// Frees connection record hc (its last reference went; cabi_http.xo
/// hc_free).
pub fn hc_free(hc: Int) {
  let x1 = ld(hc, hconn.HC_X1)
  let pk = ld(hc, hconn.HC_PEEK)
  if pk != 0 {
    obj.free_obj(pk)
  }
  let owner = ld(hc, hconn.HC_OWNER)
  if owner != 0 {
    // an HTTP/2 stream's connection
    let sr = ld(hc, hconn.HC_H2S)
    if sr != 0 {
      let _r = rt.call_c2(hconn.tls_op(hconn.TO_H2_STREAM_RELEASE), sr, 0)
    }
    if x1 != 0 {
      http1.x1_free(x1)
    }
    obj.free_obj(hc)
    tasks.h_release(owner)
    return
  }
  hconn.unregister(hc)
  let h2 = ld(hc, hconn.HC_H2)
  if h2 != 0 {
    let _f = rt.call_c2(hconn.tls_op(hconn.TO_H2_FREE), h2, 0)
  }
  let cn = ld(hc, hconn.HC_CONN)
  poll.pd_close(hconn.conn_pd(hc))
  tasks.h_release(cn)
  tasks.h_release(ld(hc, hconn.HC_SRV))
  if x1 != 0 {
    http1.x1_free(x1)
  }
  let tls = ld(hc, hconn.HC_TLS)
  if tls != 0 {
    let _f = rt.call_c2(hconn.tls_op(hconn.TO_FREE), tls, 0)
  }
  obj.free_obj(hc)
}

// ---------------------------------------------------------------------------
// Streamed bodies (http.stream, decision 0083)

fn sink_new() -> Int { tasks.new_handle(SK_SIZE, rt.fn_addr("sink_free")) }

fn sink_take_handle(k: Int) -> rthttp.Sink {
  let h = rt.obj_at[rthttp.Sink](k)
  tasks.h_release(k)
  h
}

/// A sink into a buffer.
pub fn sink_buf() -> rthttp.Sink { sink_take_handle(sink_new()) }

/// A sink that sends the response of status on h (its header set with
/// http1.header_set).
pub fn sink_conn(h: rthttp.HConn, status: Int, declared: Bool = false) -> rthttp.Sink {
  let k = sink_new()
  st(k, SK_DECL, if declared { 1 } else { 0 })
  let hc = hconn.rec(h)
  rc.inc(hc)
  st(k, SK_CONN, 1)
  st(k, SK_HC, hc)
  st(k, SK_STATUS, status)
  sink_take_handle(k)
}

/// Appends the n bytes at p to sink k's buffer.
fn put(k: Int, p: Int, n: Int) {
  let have = ld(k, SK_N)
  var cap = ld(k, SK_CAP)
  if have + n > cap {
    if cap == 0 {
      cap = 64
    }
    while have + n > cap {
      cap = cap * 2
    }
    st(k, SK_BUF, raw.c_resize(ld(k, SK_BUF), cap))
    st(k, SK_CAP, cap)
  }
  if n > 0 {
    rt.mem_copy(ld(k, SK_BUF) + have, p, n)
  }
  st(k, SK_N, have + n)
}

/// Writes the n bytes at p as net/http's chunkWriter does: the head with
/// the first data, then a chunk per write (HTTP/1.1: http1.xo emit;
/// HTTP/2: h2srv.xo emit).
fn emit(k: Int, p: Int, n: Int) {
  if ld(k, SK_FAILED) != 0 {
    return
  }
  let hc = ld(k, SK_HC)
  let h = hconn.handle(hc)
  if ld(hc, hconn.HC_H2S) != 0 {
    let r = rt.call_c4(hconn.tls_op(hconn.TO_H2_EMIT), hc, 2 * ld(k, SK_STATUS) + (if ld(k, SK_STARTED) != 0 { 1 } else { 0 }), p, n)
    st(k, SK_STARTED, r & 1)
    st(k, SK_FAILED, if (r & 2) == 0 { 1 } else { 0 })
    return
  }
  let state = http1.emit(h, ld(k, SK_STATUS), ld(k, SK_STATE), p, n)
  st(k, SK_STATE, state)
  st(k, SK_STARTED, state & 1)
  st(k, SK_FAILED, if (state & 16) != 0 { 1 } else { 0 })
}

/// BodyWriter.write: false when the connection failed.
pub fn sink_write(s: rthttp.Sink, data: Bytes) -> Bool {
  let k = rt.obj_addr(s)
  var p = raw.bytes_addr(data)
  var n = data.len()
  if ld(k, SK_CONN) == 0 {
    put(k, p, n)
    return data.len() >= 0
  }
  // bufio.Writer.Write (the response's Write of a []byte): a write
  // larger than the buffer's room goes around an empty buffer as one
  // chunk (or DATA frames), as net/http does; before 2026-10-21 it was
  // WriteString's, which fills the buffer and emits 2 KiB chunks (10x
  // slower for a streamed body of 64 KiB writes)
  let size = if ld(ld(k, SK_HC), hconn.HC_H2S) != 0 { 4096 } else { 2048 }
  while n > size - ld(k, SK_N) {
    if ld(k, SK_N) == 0 {
      emit(k, p, n)
      n = 0
      break
    }
    let m = size - ld(k, SK_N)
    put(k, p, m)
    p += m
    n -= m
    emit(k, ld(k, SK_BUF), ld(k, SK_N))
    st(k, SK_N, 0)
  }
  if n > 0 {
    put(k, p, n)
  }
  // data stays alive up to here (its bytes were read through p)
  ld(k, SK_FAILED) == 0 && data.len() >= 0
}

/// BodyWriter.flush: what is buffered goes out (the head at the latest).
pub fn sink_flush(s: rthttp.Sink) -> Bool {
  let k = rt.obj_addr(s)
  if ld(k, SK_CONN) == 0 {
    return true
  }
  if ld(k, SK_N) > 0 {
    emit(k, ld(k, SK_BUF), ld(k, SK_N))
    st(k, SK_N, 0)
  } else if ld(k, SK_STARTED) == 0 {
    emit(k, 0, 0)
  }
  ld(k, SK_FAILED) == 0
}

/// Ends the stream on its connection: whether it stays open for another
/// request.
pub fn sink_end(s: rthttp.Sink) -> Bool {
  let k = rt.obj_addr(s)
  let hc = ld(k, SK_HC)
  let h = hconn.handle(hc)
  let h2 = ld(hc, hconn.HC_H2S) != 0
  let p = ld(k, SK_BUF)
  var n = ld(k, SK_N)
  let trl = trailer_lines(k)
  if ld(k, SK_STARTED) == 0 && ld(k, SK_TRL) != 0 && ld(k, SK_FAILED) == 0 && (h2 || n > 0 || ld(k, SK_DECL) != 0) {
    // trailers need a chunked body (net/http sets no Content-Length when
    // a trailer is declared): start the stream with what is buffered
    emit(k, p, n)
    st(k, SK_N, 0)
    n = 0
  }
  if ld(k, SK_STARTED) == 0 {
    if h2 {
      let _r = rt.call_c4(hconn.tls_op(hconn.TO_H2_RESPOND_AT), hc, ld(k, SK_STATUS), p, n)
      return false
    }
    return http1.respond(h, ld(k, SK_STATUS), raw.str_at(p, n).bytes())
  }
  st(k, SK_N, 0)
  if h2 {
    // the rest with the end of the stream (h2srv.xo finish)
    let _ok = rt.call_c4(hconn.tls_op(hconn.TO_H2_FINISH), hc, p, n, ld(k, SK_TRL))
    return false
  }
  // HTTP/1.1 (http1.xo stream_end): the rest, the last chunk
  http1.stream_end(h, ld(k, SK_STATUS), ld(k, SK_STATE), p, n, trl)
}

/// Adds trailer name: value to stream sink s (decision 0433), sent after
/// the body when the response is chunked (HTTP/1.1) or on HTTP/2; name
/// is canonical (http1.trailer_key) and value has no line break.
pub fn sink_set_trailer(s: rthttp.Sink, name: Str, value: Str) {
  let k = rt.obj_addr(s)
  if value.contains("\n") || value.contains("\r") {
    return
  }
  let line = name + "\n" + value + "\n"
  let blk = ld(k, SK_TRL)
  let old = if blk == 0 { 0 } else { ld(blk, 0) }
  if old + line.len() > http1.MAX_TRAILER_BYTES {
    return
  }
  let nb = rt.heap_large(8 + old + line.len())
  if old > 0 {
    rt.mem_copy(nb + 8, blk + 8, old)
  }
  if blk != 0 {
    rt.heap_release(blk)
  }
  rt.mem_copy(nb + 8 + old, raw.data(line), line.len())
  st(nb, 0, old + line.len())
  st(k, SK_TRL, nb)
}

/// The trailers of sink k as "Name: value\r\n" lines sorted by name (net/http
/// sorts them), "" for none.
fn trailer_lines(k: Int) -> Str {
  if ld(k, SK_TRL) == 0 {
    return ""
  }
  let parts = raw.str_at(ld(k, SK_TRL) + 8, ld(ld(k, SK_TRL), 0)).split("\n")
  var names: List[Str] = []
  var m: Map[Str, Str] = {}
  var i = 0
  while i + 1 < parts.len() {
    let n = parts[i]
    match m.get(n) {
      Some(old) => m[n] = old + ", " + parts[i + 1]
      None => {
        m[n] = parts[i + 1]
        names.push(n)
      }
    }
    i += 2
  }
  names = names.sort()
  var out = ""
  for n in names {
    out += n + ": " + (m.get(n) ?? "") + "\r\n"
  }
  out
}

/// The body a buffer sink collected.
pub fn sink_take(s: rthttp.Sink) -> Bytes {
  let k = rt.obj_addr(s)
  raw.str_at(ld(k, SK_BUF), ld(k, SK_N)).bytes()
}

/// Frees sink record k (cabi_http.xo sink_free).
pub fn sink_free(k: Int) {
  let b = ld(k, SK_BUF)
  if b != 0 {
    rt.heap_release(b)
  }
  if ld(k, SK_TRL) != 0 {
    rt.heap_release(ld(k, SK_TRL))
  }
  let hc = ld(k, SK_HC)
  if hc != 0 {
    tasks.h_release(hc)
  }
  obj.free_obj(k)
}

// ---------------------------------------------------------------------------
// The functions of streamed responses: a Response carries the number of
// its function here (0: no stream). Sending a response takes its
// function; a response dispatched in process keeps it, since a copy may
// be collected again (as on the Go backend); streams_free empties the
// table at exit (leak check).

fn table() -> Int { ctx.svc() + ctx.SV_STREAMS }

/// Keeps f (an Any of the stream's function): its number.
pub fn stream_put(f: rt.Any) -> Int {
  // the table is freed at exit (entry.xo, decision 0233)
  atexit.set_streams(rt.fn_addr("streams_free"))
  let a = rt.obj_addr(f)
  rc.inc(a)
  let t = table()
  pool.lock_k(t + ST_MU, pool.ST_LOCK_HTTP)
  let n = ld(t, ST_N)
  if n == 0 || (n >= 4 && (n & (n - 1)) == 0) {
    st(t, ST_FS, raw.c_resize(ld(t, ST_FS), 8 * (if n == 0 { 4 } else { 2 * n })))
  }
  st(ld(t, ST_FS), 8 * n, a)
  st(t, ST_N, n + 1)
  pool.unlock(t + ST_MU)
  n + 1
}

/// The function of stream id in a list of one (empty when it was taken);
/// take removes it from the table.
pub fn stream_get(id: Int, take: Bool) -> List[rt.Any] {
  let t = table()
  pool.lock_k(t + ST_MU, pool.ST_LOCK_HTTP)
  var f = 0
  if id >= 1 && id <= ld(t, ST_N) {
    let fs = ld(t, ST_FS)
    f = ld(fs, 8 * (id - 1))
    if f != 0 {
      if take {
        st(fs, 8 * (id - 1), 0)
      } else {
        rc.inc(f)
      }
    }
  }
  pool.unlock(t + ST_MU)
  if f == 0 {
    return []
  }
  let a = rt.obj_at[rt.Any](f)
  tasks.h_release(f)
  [a]
}

/// Empties the table at exit, and closes the client's idle HTTP/2
/// connections (hclient.xo; the leak check).
pub fn streams_free() {
  let t = table()
  pool.lock_k(t + ST_MU, pool.ST_LOCK_HTTP)
  let fs = ld(t, ST_FS)
  let n = ld(t, ST_N)
  st(t, ST_FS, 0)
  st(t, ST_N, 0)
  pool.unlock(t + ST_MU)
  for i in 0..n {
    let f = ld(fs, 8 * i)
    if f != 0 {
      tasks.h_release(f)
    }
  }
  if fs != 0 {
    rt.heap_release(fs)
  }
  hclient.pool_free()
}
