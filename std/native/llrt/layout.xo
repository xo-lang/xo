// Runtime record layouts that more than one module uses (decision
// 0341): declared once here, a leaf module that imports nothing, so any
// module can use them without the import cycle that made copies of them.
// A record's fields are NAME_* below its NAME_SIZE; a word index for the
// slot atomics is the field's name with _W. TestRuntimeLayoutCopies
// (internal/repotest) checks the sizes, that this module imports
// nothing, and that a copy left elsewhere has its source's value.
//
// Records here: the context (ctx.xo, decision 0229), the deadlock counts
// (pool.xo, ctx.xo), the pool and worker records (pool.xo), the cancellation node (pool.xo), the wait list and its entry (tasks.xo), the park record (pool.xo), the poll descriptor (poll.xo).

/// The context record (ctx.xo; xo_ctx in the C runtime it came from; 384 bytes, 16 aligned; the owner of each field in decision 0229):
/// the innermost cancellation node (a scope body or the task's node).
pub const C_NODE = 0
/// unwinding: the context unwinds (cancellation or a fault; a C int).
pub const C_UNWINDING = 8
/// shield: the depth of deferred code running (a C int).
pub const C_SHIELD = 12
/// park: the context's parking record (pool.xo PK_*, 32 bytes).
pub const C_PARK = 16
/// held, nheld, capheld: the Mutexes the context holds (24 byte entries:
/// the mutex, the location and its length; C ints for the counts).
pub const C_HELD = 48
pub const C_NHELD = 56
pub const C_CAPHELD = 60
/// net_status, net_msg: the outcome of the last network operation.
pub const C_NET_STATUS = 64
pub const C_NET_MSG = 72
/// faulting and the fault record (fault.xo C_*).
pub const C_FAULTING = 80
pub const C_FAULT_MSG = 88
pub const C_FAULT_LOC = 96
pub const C_FAULT_DETAIL = 104
/// boundary: the stack address the unwinding never passes.
pub const C_BOUNDARY = 112
/// fault_exc: the area holding the exception object (32 bytes) at its
/// first 16 byte aligned address (xo_rt.c ctx_exc): 40 bytes, since a
/// context from the Xo heap is 8 aligned.
pub const C_FAULT_EXC = 120
/// The budget (decision 0175): its record (a reference) or 0, the polls
/// left and the quantum, the charged stretch's start, allocation mark,
/// and heap, and the pause depth (a C int).
pub const C_BUD = 160
pub const C_BUD_LEFT = 168
pub const C_BUD_Q = 176
pub const C_BUD_RUN = 184
pub const C_BUD_AMARK = 192
pub const C_BUD_HEAP = 200
pub const C_BUD_PAUSED = 208
/// went: the context's wait list entry (xo_went, 32 bytes: tasks.xo E_*;
/// a context waits on one list at a time, decision 0212 stage 3).
pub const C_WENT = 216
/// cent and fired: the context's channel queue entry (xo_cent, 64 bytes,
/// chan.xo E_*) and the word its waker claims (a context waits on one
/// channel at a time; a select's arms are the select's).
pub const C_CENT = 248
pub const C_FIRED = 312
/// fault_trace: the return addresses of the frames a fault was raised
/// in (fault.xo trace; a block from rt.heap_large: the count, then the
/// addresses), with XO_TRACEBACK only, else 0.
pub const C_FAULT_TRACE = 320
/// why: the reason of the context's next park for the execution trace
/// (trace.xo WHY_*, decision 0240), set by the park's caller and cleared
/// by tasks.xo park_wait_n
pub const C_WHY = 336
/// trace: 1 when the execution trace records this context's events
/// (decision 0240): set where a context is made while tracing
/// (tasks.xo run_claimed, root, trace.xo start), so the scheduler's hot
/// hooks test a word of a context they hold, not the static switch
pub const C_TRACE = 344
/// The frame pointer of the current park's caller, 0 when not parked:
/// where a wait is when no fiber holds it (a root thread's, or a task run
/// inline on one), for `xo dump` (decision 0251)
pub const C_PARK_FP = 352
/// --race: the instrumented calls this context is in (cabi_racefn.xo:
/// each function's entry adds one, its exit takes one off), so the catch
/// of a fault (task.isolate) gives ThreadSanitizer the exits of the
/// frames the fault unwound
pub const C_RACE_DEPTH = 360
/// the Mutex takes since this context last waited on I/O (mutex.xo,
/// poll.xo pd_wait_ctx): a Mutex release yields to the writer it woke
/// only for a context that took few (decision 0118's 2026-10-22
/// addendum: a lock bound loop paid a switch per write)
pub const C_LOCKS = 368
/// the nearest task.with_timeout deadline in force (decision 0430): the
/// timers' ns (poll.now), 0 for none; a scope with a deadline lowers it
/// and its close restores it, and a task starts with its spawner's
pub const C_TASK_DL = 376
pub const C_SIZE = 384

/// The deadlock counts record (the pool record's P_DLK word; pool.xo, ctx.xo
/// init makes it and never frees it; xo_rt.c's static `dlk` before): word
/// indices for the slot atomics. The roots made, the roots asleep in a
/// counted wait, and the contexts in a wait a timer, the network, or a
/// signal can end.
pub const DLK_ROOTS = 0
pub const DLK_BLOCKED = 1
pub const DLK_UNCOUNTED = 2
/// The roots in their loop (root_main, decision 0286 step 1): counted
/// alive and idle as workers, for the deadlock check, but not against the
/// worker threads' limit (workers).
pub const DLK_LOOPS = 3
/// XO_LOCKCHECK=1 (poolsetup.xo setup): plock and klock check the lock
/// order.
pub const DLK_LOCKCHECK = 4
/// Whether the first spawn switched the heap to a record per thread
/// (scope_add_at).
pub const DLK_THREADED = 5
/// Main's fiber while it runs on one (decision 0286 step 1), else 0: every
/// thread going idle counts its counted wait blocked (count_main).
pub const DLK_MAINF = 6
/// XO_PREEMPT=0 (poolsetup.xo setup): the monitor asks no worker to yield.
pub const DLK_NOPREEMPT = 7
/// The workers waiting in the network poller (decision 0324): counted
/// idle by the deadlock check, and wakep breaks their wait when no other
/// worker can take the work (DLK_SIZE).
pub const DLK_NPBLK = 8
/// XO_MUTEX_YIELD (poolsetup.xo setup): 0 by default (a release yields
/// to the writer it woke when the releaser does I/O between its locks,
/// mutex.xo wake), 1 under XO_MUTEX_YIELD=0 (never), 2 under
/// XO_MUTEX_YIELD=1 (always).
pub const DLK_MNOYIELD = 9
/// the record's bytes (ten words)
/// 1 when XO_DIRECT=0: a park goes through the scheduler (decision 0394).
pub const DLK_NODIRECT = 10
pub const DLK_SIZE = 88

/// The pool record (pool.xo; made by ctx.xo init; word indexes for the slot atomics and
/// byte offsets for loads): its lock (pool.mu: the idle list,
/// starting workers), the CPUs, the spin rounds, the records used, the
/// worker threads alive, idle, and spinning, the idle list, the inject
/// queue's lock, buffer, head, length, and capacity, the fiber cache's
/// record, the address of xo_x_worker_main, and the records from word 16.
pub const P_MU = 0
pub const P_NCPU = 8
pub const P_SPIN_ROUNDS = 16
pub const P_NW = 3
pub const P_ALIVE = 4
pub const P_NIDLE = 5
pub const P_SPINNING = 6
pub const P_IDLE = 56
pub const P_IMU = 64
pub const P_IBUF = 72
pub const P_IHEAD = 80
pub const P_ILEN = 11
pub const P_ILEN_AT = 88
pub const P_ICAP = 96
pub const P_FIBERS = 104
pub const P_WORKER_MAIN = 112
pub const P_DLK = 120
pub const P_WS = 160
/// The awake worker count (decision 0377): the cap (pool.xo wakep keeps the
/// workers awake, running or spinning, at or below it; from 2 up to the
/// CPUs, starting at the CPUs), the mode (0 follows the load, 1 fixed by
/// XO_CAP), and the shrink window's wakes and the wakes that found nothing.
/// Word indexes; the worker records start after them (P_WS).
pub const P_CAP = 16
pub const P_CAP_MODE = 17
pub const P_CAP_WAKES = 18
pub const P_CAP_NONE = 19

/// xo_worker (byte offsets): the ring (sched.xo), next and when it was
/// put there, live, the hooks word, the idle futex word (word 279), the
/// idle list's link, the steal rounds' random state, nonext, the fiber
/// cache and its count, the pool, and a scratch batch of RUNQ / 2 + 1
/// words (a steal's, the inject queue's share, a full ring's half).
pub const W_NEXT = 2184
pub const W_NEXT_I = 273
pub const W_NEXT_AT = 2192
pub const W_LIVE = 2200
pub const W_HOOKS = 2216
pub const W_WAKEW = 2232
pub const W_WAKEW_I = 279
pub const W_IDLE_NEXT = 2240
pub const W_RNG = 2248
pub const W_NONEXT = 2256
pub const W_FCACHE = 2264
pub const W_NFCACHE = 2328
pub const W_POOL = 2360
pub const W_BATCH = 2368
/// When this worker took a deferred wake (defer_wake), 0 for none.
pub const W_DEFER_AT = 3400
/// A root's record (poolsetup.xo W_ROOT: main's thread, not a worker).
pub const W_ROOT = 2204
/// W_DEFER_AT as a word index (the slot atomics; a constant: `W_DEFER_AT
/// / 8` was divided at run time, 2026-10-16).
pub const W_DEFER_AT_W = 425
/// The waker's runtime calls since (defer_check reads the clock every
/// 16th).
pub const W_DEFER_N = 3408
/// The execution trace's current chunk of this worker (trace.xo
/// W_CHUNK, decision 0240), 0 when off.
pub const W_TRACE = 3416
/// When this worker last granted readers a RWMutex (mutex.xo
/// grant_readers; ns): a thief leaves its ring alone for GRACE_NS after
/// (steal_round), so the granted readers run here, with the lock's cache
/// lines and the value, when this worker gets to them in time.
pub const W_GRACE_AT = 3424
pub const W_GRACE_AT_W = 428
/// The least time a steal round of this worker found left on another's
/// grace (ns, 0 when none): find_work waits it out once, the bound on how
/// long a grant can wait for a worker that keeps computing.
pub const W_GRACE_WAIT = 3432
/// Whether this worker's thread holds the pool's lock (plock, checked by
/// klock when XO_LOCKCHECK=1).
pub const W_POOLHELD = 3440
/// When this worker started running its current fiber (mono ns, 0 between
/// items; slot word 431), and when the monitor asked it to yield (mono
/// ns, 0 for not asked; slot word 432): preemption (decision 0286 step 3,
/// mon_scan, preempt).
pub const W_RUN_AT_I = 431
pub const W_PREEMPT_I = 432
/// How many runtime locks this worker's thread holds (held): preempt
/// yields only at none (decision 0286 step 3: std's loops poll, and the
/// runtime calls std with its spin locks held).
pub const W_LOCKS = 3464
/// Asynchronous preemption (decision 0318): the fibers this worker
/// preempted with SIGURG (head and tail, linked by F_NEXT), which only it
/// resumes; its thread (darwin's pthread_t, Linux's thread id) for the
/// monitor's signal; 1 while its run loop runs fibers (worker_main,
/// root_main); 1 between the handler's yield and run_fiber's requeue;
/// SIGURG's bit in a signal set (the handler's unblock).
pub const W_PIN = 3472
pub const W_PIN_TAIL = 3480
pub const W_THREAD = 3488
pub const W_APOK = 3496
pub const W_ASYNC = 3504
pub const W_URGSET = 3512
/// The fiber this worker runs (run_fiber; 0 between fibers): Windows'
/// preemption reads it from the monitor's thread (decision 0318).
pub const W_RUNF = 3520
/// The record's size; poolsetup.xo's W_SIZE (the root's record) must match
/// (XO_HEAP_GUARD found it 8 bytes short, 2026-10-20).
/// The worker's index among the worker threads in start order (roots 0):
/// a worker at or over the cap (decision 0377) is not woken or started.
pub const W_IDX = 3528
/// The fiber that switched away straight to another one (decision 0394):
/// the fiber it resumed finishes its park (PARKING to PARKED) when it runs.
pub const W_PREV = 3536
/// The fiber that switched back to the scheduler last (fiber_run: a chain of
/// direct switches may end on another than the one it started).
pub const W_LASTF = 3544
/// The direct switches since the scheduler last ran this worker's fiber
/// (the clock is read every 64th, for the slice).
pub const W_DCOUNT = 3552
/// find_work's calls (every 64th looks at the clock for the fairness step).
pub const W_TICK = 3560
/// When find_work last took from the ring, the inject queue and the poller
/// before the run-next slot (once a slice at most).
pub const W_FAIR_AT = 3568
pub const W_SIZE = 3576
/// The pool record's size (pool.xo P_*: 16 words, then the 4096 worker
/// records' addresses; ctx.xo makes it).
/// The spawn sites' average run times (pool.xo site_note): 256 words after
/// the worker records' addresses (decision 0359).
pub const P_SITES = 32928
pub const P_SIZE = 34976

/// xo_node, a cancellation node (pool.xo; xo_rt.c before; ctx.xo makes the
/// context's, twrun.xo and pool.xo the others): its parent, first child,
/// previous and next sibling, the canceled word, the waiter's park, and
/// its lock.
pub const N_PARENT = 0
pub const N_CHILD = 8
pub const N_PREV = 16
pub const N_NEXT = 24
pub const N_CANCELED = 32
/// N_CANCELED as a word index (the slot atomics).
pub const N_CANCELED_W = 4
pub const N_WAITER = 40
pub const N_MU = 48
/// the record's bytes
pub const N_SIZE = 56

/// A wait list (xo_wl; tasks.xo, mutex.xo): its first and last entry.
pub const WL_FIRST = 0
pub const WL_LAST = 8
pub const WL_SIZE = 16
/// A wait list entry (xo_went, 32 bytes; the context's own, C_WENT: a
/// context waits on one list at a time; tasks.xo, mutex.xo, hserve.xo): the
/// park, the previous and next entry, writer and granted (C ints, the
/// Mutex's).
pub const E_PARK = 0
pub const E_PREV = 8
pub const E_NEXT = 16
pub const E_WRITER = 24
/// E_WRITER as a word index (the slot atomics).
pub const E_WRITER_W = 3
pub const E_GRANTED = 28
pub const E_SIZE = 32

/// xo_park, a park record (pool.xo; 32 bytes; byte offsets, PK_SIGNALED is
/// the word index of PK_SIGNALED_AT): its lock, signaled, a
/// thread sleeps on it (a C int), a root asleep here counts in the
/// blocked roots (a C int), the fiber parked here.
pub const PK_SIGNALED = 1
pub const PK_SIGNALED_AT = 8
pub const PK_SLEEPING = 16
pub const PK_COUNTED = 20
pub const PK_FIBER = 24
/// the record's bytes
pub const PK_SIZE = 32

/// A poll descriptor (xo_pd, poll.xo; hconn.xo reads its fd): a lock word,
/// the socket (-1 once closed), whether close was called, the operations
/// running, readiness that came while nobody waited (read, write), the
/// parks waiting (read, write), the link of the dead list, and the
/// read and write deadline timers (poll.xo pd_timers: one block of two
/// timer records, made by the first wait with a deadline, 0 before).
pub const D_MU = 0
pub const D_RREADY = 20
pub const D_WREADY = 24
pub const D_RWAIT = 32
pub const D_WWAIT = 40
pub const D_NEXT = 48
pub const D_TIMERS = 56

/// the record's bytes off Windows (without the AFD words of D_SIZE_WIN)
pub const D_SIZE = 64

pub const D_FD = 8
pub const D_CLOSED = 12
pub const D_OPS = 16

/// The record's Windows words (DW_*, past D_SIZE; poll.xo names them D_*): the poll's IO_STATUS_BLOCK (its
/// status a 32 bit NTSTATUS), the poll's buffer (AFD_POLL_INFO: the timeout,
/// the count, exclusive, then one handle, its events, and its status), the
/// socket's base handle, the events of the poll in flight (0 none), whether
/// to poll again once it ends, and whether its completion frees the record
/// (pd_free ran).
pub const DW_IOSB = 64
pub const DW_INFO = 80
pub const DW_BASE = 112
pub const DW_ARMED = 120
pub const DW_REARM = 124
pub const DW_DYING = 128
/// the record's bytes on Windows (xo_pd with its AFD words, DW_IOSB to DW_DYING)
pub const DW_SIZE = 136
