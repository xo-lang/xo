// Tests of scan.xo's private helpers (decision 0262): `xo test
// --std-module=native/llrt/scan`, run by internal/stdtest.

use native/llrt/raw
use native/rt

fn hex(s: Str) -> Bytes { Bytes.from_hex(s) ?? "".bytes() }

/// The bytes of xs, each taken mod 256.
fn bytes_of(xs: List[Int]) -> Bytes {
  var b = BytesBuilder.new()
  for x in xs {
    b.write_byte(UInt8(x & 255))
  }
  b.freeze()
}

test "seq_len follows utf8.DecodeRune" {
  expect(seq_len(hex("c3a9"), 0, 2) == 2)
  // the 2-byte case at both ends of its range (C2 82 is the smallest)
  expect(seq_len(hex("c282"), 0, 2) == 2)
  expect(seq_len(hex("dfbf"), 0, 2) == 2)
  // an overlong form, a surrogate, and a rune above U+10FFFF
  expect(seq_len(hex("c0af"), 0, 2) == 1)
  expect(seq_len(hex("eda080"), 0, 3) == 1)
  expect(seq_len(hex("f4908080"), 0, 4) == 1)
  // every overlong 2-byte lead, a bad continuation byte, and a lone
  // continuation byte
  expect(seq_len(hex("c080"), 0, 2) == 1)
  expect(seq_len(hex("c1bf"), 0, 2) == 1)
  expect(seq_len(hex("c341"), 0, 2) == 1)
  expect(seq_len(hex("c3c3"), 0, 2) == 1)
  expect(seq_len(hex("80"), 0, 1) == 1)
  expect(seq_len(hex("bf"), 0, 1) == 1)
  // the surrogate range at both of its ends
  expect(seq_len(hex("ed9fbf"), 0, 3) == 3)
  expect(seq_len(hex("edbfbf"), 0, 3) == 1)
  // a sequence cut by the end of the range, 2, 3 and 4 bytes long
  expect(seq_len(hex("c3"), 0, 1) == 1)
  expect(seq_len(hex("e282ac"), 0, 2) == 1)
  expect(seq_len(hex("e282ac"), 0, 3) == 3)
  expect(seq_len(hex("f09f9880"), 0, 3) == 1)
  expect(seq_len(hex("f09f9880"), 0, 4) == 4)
}

test "utf8_valid rejects each malformed sequence" {
  expect(utf8_valid(hex("41c2a241")))
  expect(utf8_valid(hex("41e282ac41")))
  expect(utf8_valid(hex("41f09f988041")))
  // overlong C0 and C1 leads
  expect(!utf8_valid(hex("41c0af")))
  expect(!utf8_valid(hex("41c1bf")))
  // a lone continuation byte, and one inside a run of text
  expect(!utf8_valid(hex("80")))
  expect(!utf8_valid(hex("418041")))
  // a lead cut by the end of the value, 2, 3 and 4 bytes long
  expect(!utf8_valid(hex("41c3")))
  expect(!utf8_valid(hex("41e282")))
  expect(!utf8_valid(hex("41f09f98")))
  // the surrogate range ED A0 80 to ED BF BF
  expect(!utf8_valid(hex("41eda08041")))
  expect(!utf8_valid(hex("41edbfbf41")))
}

test "utf8_valid finds a sequence at any place of an 8 byte word" {
  // each sample after 0 to 40 ASCII bytes and before 0 to 9: the word
  // test, span and the byte loop each meet it
  // the first 4 are valid
  let all = ["c2a2", "e282ac", "f09f9880", "c3a9e697a5", "c0af", "80", "c3", "e282", "f09f98", "eda080", "ff"]
  for pre in 0..41 {
    for post in 0..10 {
      for (k, h) in all.indexed() {
        var bb = BytesBuilder.new()
        for _ in 0..pre {
          bb.write_byte(UInt8(97))
        }
        bb.write(hex(h))
        for _ in 0..post {
          bb.write_byte(UInt8(98))
        }
        let b = bb.freeze()
        expect(utf8_valid(b) == (k < 4))
      }
    }
  }
}

test "fix_utf8 replaces each invalid byte" {
  expect(fix_utf8(hex("61ff62"), false) == "a\u{FFFD}b")
  expect(fix_utf8(hex("61ff62"), true) == "a%FFb")
  // a continuation byte at the end of the value
  expect(fix_utf8(hex("6180"), false) == "a\u{FFFD}")
  expect(fix_utf8(hex("e282"), true) == "%E2%82")
}

test "text keeps valid UTF-8" {
  expect(text("h\u{e9}llo \u{1F600}") == "h\u{e9}llo \u{1F600}")
  expect(utf8_valid("".bytes()))
  expect(!utf8_valid(hex("80")))
}

test "fix_utf8 output is valid and keeps valid input" for xs: List[Int] {
  let b = bytes_of(xs)
  let s = fix_utf8(b, false)
  expect(utf8_valid(s.bytes()))
  if utf8_valid(b) {
    expect(s.bytes() == b)
  }
  expect(utf8_valid(fix_utf8(b, true).bytes()))
}

test "find_byte matches a byte loop" for xs: List[Int], c: Int {
  let b = bytes_of(xs)
  let want_c = c & 255
  var want = -1
  var i = 0
  while i < b.len() {
    if Int(b[i]) == want_c {
      want = i
      break
    }
    i += 1
  }
  expect(find_byte(b, 0, b.len(), want_c) == want)
}

/// The first start at or after from where sub occurs in b, by a byte loop.
fn find_naive(b: Bytes, sub: Bytes, from: Int) -> Int {
  var i = from
  while i + sub.len() <= b.len() {
    var k = 0
    while k < sub.len() && b[i + k] == sub[k] {
      k += 1
    }
    if k == sub.len() {
      return i
    }
    i += 1
  }
  -1
}

test "find_bytes matches a byte loop with near matches everywhere" {
  // a two letter text, so first and last byte candidates are dense
  for n in [0, 15, 17, 31, 33, 47, 64, 100, 300, 1000] {
    var xs: List[Int] = []
    var x = n + 7
    for _ in 0..n {
      x = (x * 1103515245 + 12345) % 2147483648
      xs.push(97 + (x >> 16) % 2)
    }
    let b = bytes_of(xs)
    for sub in ["ab", "ba", "aab", "abba", "bbbbb", "abababab", "aaaaaaaaaaaaaaaaab", "c", "ac"] {
      let sb = sub.bytes()
      for from in [0, 1, 5, 16] {
        expect(find_bytes(b, sb, from)) == if from > n { -1 } else { find_naive(b, sb, from) }
      }
    }
  }
}

test "count_cont counts continuation bytes in any range" for xs: List[Int], from: Int {
  let b = bytes_of(xs)
  let n = b.len()
  let f = if n == 0 { 0 } else { (from & 1023) % (n + 1) }
  var want = 0
  var i = f
  while i < n {
    if (Int(b[i]) & 0xC0) == 0x80 {
      want += 1
    }
    i += 1
  }
  expect(count_cont(b, f, n) == want)
}

test "ctl_at finds the first control byte" for xs: List[Int], from: Int, to: Int {
  let b = bytes_of(xs)
  let n = b.len()
  let f = if n == 0 { 0 } else { (from & 1023) % (n + 1) }
  let t = if n == 0 { 0 } else { f + (to & 1023) % (n - f + 1) }
  var want = t
  var i = f
  while i < t {
    let c = Int(b[i])
    if c < 0x20 || c == 0x7F {
      want = i
      break
    }
    i += 1
  }
  expect(ctl_at(b, f, t) == want)
}

test "mem_byte finds the first byte c" for xs: List[Int], from: Int, to: Int, c: Int {
  let b = bytes_of(xs)
  let n = b.len()
  let f = if n == 0 { 0 } else { (from & 1023) % (n + 1) }
  let t = if n == 0 { 0 } else { f + (to & 1023) % (n - f + 1) }
  let k = c & 255
  var want = -1
  var i = f
  while i < t {
    if Int(b[i]) == k {
      want = i
      break
    }
    i += 1
  }
  expect(mem_byte(raw.bytes_addr(b), f, t, k) == want)
  raw.alive(b)
}

test "mem_byte in a request head" {
  let b = "GET / HTTP/1.1\r\nHost: x\r\n\r\n".bytes()
  let p = raw.bytes_addr(b)
  expect(mem_byte(p, 0, b.len(), 10) == 15)
  expect(mem_byte(p, 16, b.len(), 10) == 24)
  expect(mem_byte(p, 0, 15, 10) == -1)
  expect(mem_byte(p, 0, b.len(), 0x80) == -1)
  raw.alive(b)
}

test "ctl_at on header values" {
  expect(ctl_at("Go-http-client/1.1".bytes(), 0, 18) == 18)
  expect(ctl_at("a\tb".bytes(), 0, 3) == 1)
  expect(ctl_at(hex("41424344454647487f"), 0, 9) == 8)
  expect(ctl_at(hex("80ff9f20"), 0, 4) == 4)
}

/// bytes_eq16_bits' and bytes_high16_bits' masks of the 16 bytes of b
/// from i, by a byte loop.
fn bits_want(b: Bytes, i: Int, c: Int) -> (Int, Int) {
  var we = 0
  var wh = 0
  for k in 0..16 {
    if Int(b[i + k]) == c {
      we = we | (1 << k)
    }
    if Int(b[i + k]) >= 128 {
      wh = wh | (1 << k)
    }
  }
  (we, wh)
}

test "bytes_eq16_bits and bytes_high16_bits give one bit a byte" {
  let b = hex("0a41ff0a800a0a7f00010a0aff0a410a0a")
  let (we, wh) = bits_want(b, 1, 10)
  expect(rt.bytes_eq16_bits(b, 1, 10)) == we
  expect(rt.bytes_high16_bits(b, 1)) == wh
  expect(we != 0 && wh != 0)
}

test "bytes_eq16_bits matches a byte loop" for xs: List[Int], c: Int {
  var ys = xs
  while ys.len() < 20 {
    ys.push(ys.len() * 37 + (c & 255))
  }
  let b = bytes_of(ys)
  let cc = c & 255
  for i in 0..b.len() - 15 {
    let (we, wh) = bits_want(b, i, cc)
    expect(rt.bytes_eq16_bits(b, i, cc) == we)
    expect(rt.bytes_high16_bits(b, i) == wh)
  }
}

test "find_byte and span find a byte at each place of 0 to 100" {
  for n in 0..101 {
    for p in 0..n {
      var xs: List[Int] = []
      for i in 0..n {
        xs.push(if i == p { 0xC3 } else { 97 + i % 26 })
      }
      let b = bytes_of(xs)
      for from in [0, 1, 15, 31, 33] {
        if from <= n {
          let want = if p >= from { p } else { -1 }
          expect(find_byte(b, from, n, 0xC3)) == want
          expect(span(b, from, 0)) == (if p >= from { p } else { n })
        }
      }
    }
  }
}

test "span class 1 stops at each kind of byte at each place of 0 to 100" {
  // `"`, `\`, controls, DEL and 0x80 and above stop it; a space and `~`
  // do not
  for c in [34, 92, 0, 31, 127, 128, 255, 32, 126] {
    let stops = c != 32 && c != 126
    for n in [0, 1, 31, 32, 33, 63, 64, 65, 100] {
      for p in 0..n {
        var xs: List[Int] = []
        for i in 0..n {
          xs.push(if i == p { c } else { 97 + i % 26 })
        }
        let b = bytes_of(xs)
        for from in [0, 1, 31, 33] {
          if from <= n {
            expect(span(b, from, 1)) == (if stops && p >= from { p } else { n })
          }
        }
      }
    }
  }
}

test "bytes_any_eq32 and bytes_any_high32 see each of the 32 bytes" {
  for p in 0..40 {
    var xs: List[Int] = []
    for i in 0..72 {
      xs.push(if i == p { 0xC3 } else { 97 + i % 26 })
    }
    let b = bytes_of(xs)
    for i in [0, 1, 7, 8, 31, 40] {
      let hit = p >= i && p < i + 32
      expect(rt.bytes_any_eq32(b, i, 0xC3) != 0) == hit
      expect(rt.bytes_any_high32(b, i) != 0) == hit
      // a byte c that varies at run time, and one that is absent
      let c = Int(b[p])
      expect(rt.bytes_any_eq32(b, i, c) != 0) == hit
      expect(rt.bytes_any_eq32(b, i, 0x7F)) == 0
    }
  }
}

test "mem_any_eq32 sees each of the 32 bytes at an address" {
  for p in 0..40 {
    var xs: List[Int] = []
    for i in 0..72 {
      xs.push(if i == p { 10 } else { 97 + i % 26 })
    }
    let b = bytes_of(xs)
    let a = raw.bytes_addr(b)
    for i in [0, 1, 7, 8, 31, 40] {
      let hit = p >= i && p < i + 32
      expect(rt.mem_any_eq32(a, i, 10) != 0) == hit
      // a byte c that varies at run time, and one that is absent
      let c = Int(b[p])
      expect(rt.mem_any_eq32(a, i, c) != 0) == hit
      expect(rt.mem_any_eq32(a, i, 0x7F)) == 0
    }
  }
}

test "bytes_count_below32 matches a byte loop, from none to all 32 bytes" {
  // every density of bytes on each side of lo -64 (0xBF and 0xC0) and lo
  // 0 (0x7F and 0x80), at offsets that cross the 16 byte lanes
  for (lo_hit, lo_miss) in [(0x80, 0xC0), (0xBF, 0x7F), (0x80, 0x7F)] {
    for step in [1, 2, 3, 5, 16, 17, 31, 99] {
      var xs: List[Int] = []
      for k in 0..72 {
        xs.push(if k % step == 0 { lo_hit } else { if k % 3 == 0 { lo_miss } else { 97 + k % 26 } })
      }
      let b = bytes_of(xs)
      for i in [0, 1, 7, 8, 15, 31, 40] {
        var cont = 0
        var high = 0
        for k in i..i + 32 {
          let x = Int(b[k])
          if (x & 0xC0) == 0x80 {
            cont += 1
          }
          if x >= 0x80 {
            high += 1
          }
        }
        expect(rt.bytes_count_below32(b, i, -64)) == cont
        expect(rt.bytes_count_below32(b, i, 0)) == high
      }
    }
  }
}

test "bytes_count_eq32 matches a byte loop, from none to all 32 bytes" {
  // every density: byte k is c when k % step == 0 (step 1 is all of
  // them, step 99 one or none), at offsets that cross the 16 byte lanes
  for c in [0, 44, 0x80, 0xFF] {
    for step in [1, 2, 3, 5, 16, 17, 31, 99] {
      var xs: List[Int] = []
      for k in 0..72 {
        xs.push(if k % step == 0 { c } else { (c + 1 + k % 7) & 255 })
      }
      let b = bytes_of(xs)
      for i in [0, 1, 7, 8, 15, 31, 40] {
        var want = 0
        for k in i..i + 32 {
          if Int(b[k]) == c {
            want += 1
          }
        }
        // c varies at run time, as does b[0]; 44 is a constant
        let cr = Int(b[0])
        var wr = 0
        for k in i..i + 32 {
          if Int(b[k]) == cr {
            wr += 1
          }
        }
        expect(rt.bytes_count_eq32(b, i, c)) == want
        expect(rt.bytes_count_eq32(b, i, cr)) == wr
        if c == 44 {
          expect(rt.bytes_count_eq32(b, i, 44)) == want
        }
      }
    }
  }
  var cs: List[Int] = []
  for _ in 0..32 {
    cs.push(0x2C)
  }
  let all = bytes_of(cs)
  expect(rt.bytes_count_eq32(all, 0, 0x2C)) == 32
  expect(rt.bytes_count_eq32(all, 0, 0x2D)) == 0
}

test "bytes_any_stop32 sees c1, c2 and the bytes below lo at each of the 32 bytes" {
  // each kind of stop at each place: a quote, a backslash, a control
  // byte, 0x80 and above; 0x20 and 0x7F are plain
  for stop in [34, 92, 0, 31, 0x80, 0xFF] {
    for p in 0..40 {
      var xs: List[Int] = []
      for i in 0..72 {
        xs.push(if i == p { stop } else { 32 + i % 2 * 95 })
      }
      let b = bytes_of(xs)
      for i in [0, 1, 7, 8, 31, 40] {
        let hit = p >= i && p < i + 32
        expect(rt.bytes_any_stop32(b, i, 34, 92, 32) != 0) == hit
        // lo 0 stops only at 0x80 and above
        expect(rt.bytes_any_stop32(b, i, 1, 2, 0) != 0) == (hit && stop >= 0x80)
      }
    }
  }
}

/// The ASCII byte c with a capital lowered.
fn low1(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// fold_eq_words by bytes: the first word with a byte 0x80 or above or a
/// pair unequal lowered.
fn fold_eq_ref(x: List[Int], y: List[Int], k: Int) -> Int {
  var i = 0
  while k - i >= 8 {
    for j in i..i + 8 {
      if x[j] >= 0x80 || y[j] >= 0x80 || low1(x[j]) != low1(y[j]) {
        return i
      }
    }
    i += 8
  }
  i
}

test "fold_eq_words and case_run match a byte loop at each byte" {
  // x mixed case letters and punctuation, y the same with the case of
  // each letter swapped
  var x0: List[Int] = []
  var y0: List[Int] = []
  for j in 0..20 {
    let c = if j % 5 == 4 { 33 + j } else { 65 + j + (j % 2) * 32 }
    x0.push(c)
    y0.push(if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { c ^ 32 } else { c })
  }
  for k in [0, 7, 8, 13, 19] {
    for p in 0..256 {
      for q in [p, p ^ 32, (p + 1) % 256, 0x40, 0x41, 0x5A, 0x5B, 0x60, 0x61, 0x7A, 0x7B, 0xC1, 0xE1] {
        var x = x0
        var y = y0
        x[k] = p
        y[k] = q
        let bx = bytes_of(x)
        let by = bytes_of(y)
        for n in [8, 16, 19, 20] {
          expect(fold_eq_words(bx, by, n)) == fold_eq_ref(x, y, n)
        }
      }
      var x = x0
      x[k] = p
      for (lo, hi) in [(65, 90), (97, 122)] {
        var want = 0
        while 20 - want >= 8 {
          var stop = false
          for j in want..want + 8 {
            stop = stop || x[j] >= 0x80 || (x[j] >= lo && x[j] <= hi)
          }
          if stop {
            break
          }
          want += 8
        }
        expect(case_run(bytes_of(x), lo, hi)) == want
      }
    }
  }
}

test "bytes_skip32 stops at the first 32 byte step holding c, or near to" {
  // c at each place of a 200 byte buffer (and absent), every start and
  // bound around the steps, c a constant and a variable byte
  for at in [-1, 0, 1, 15, 16, 31, 32, 33, 63, 64, 100, 130, 167, 168, 199] {
    var xs: List[Int] = []
    for k in 0..200 {
      xs.push(if k == at { 0x23 } else { 97 + k % 26 })
    }
    let b = bytes_of(xs)
    var cv = 0x22
    cv += 1
    for i in [0, 1, 7, 31, 32, 40, 100, 168, 169, 200] {
      for to in [i, i + 31, i + 32, i + 33, i + 64, i + 95, 200] {
        if to > 200 {
          continue
        }
        var want = i
        while to - want >= 32 && rt.bytes_any_eq32(b, want, cv) == 0 {
          want += 32
        }
        expect(rt.bytes_skip32(b, i, to, 0x23)) == want
        expect(rt.bytes_skip32(b, i, to, cv)) == want
      }
    }
  }
}
