// The process on the native backends, written in Xo (the zero-C audit's
// work item B03): its arguments and environment (this was xo_rt.c's
// xo_env_get and xo_env_vars and xo_bytes.c's xo_env_args and
// xo_env_program) and its end (xo_std.c's xo_exit). The C entry (main)
// hands argc, argv, and the environment's NAME=VALUE array (`environ`;
// on Windows the C runtime's UTF-8 copy of GetEnvironmentStringsW,
// xo_win.c) to cabi.xo's `proc_start` before the program runs; they
// are kept in process globals (rt.static_word words 7 to 9). The entry
// in Xo (work item B26) will take them from the entry stack. A test
// binary whose world fakes env (decision 0120) asks the C runtime's
// test world instead (testworld.xo). The
// SSA builders call the native prelude's llrt_exit for os.proc.exit and
// for the end of a program whose main returned an error (after its
// message); the C runtime's xo_exit, which compilers before B03 call,
// forwards to cabi.xo's `exit`. In a test binary the test world records
// the code instead (FakeProc.exit_code, twrun.xo exit), and in
// testing.run_main the call returns with the context unwinding (decision
// 0108).
use native/llrt/linux
use native/llrt/raw
use native/llrt/stdio
use native/rt
use native/llrt/testworld
use native/sys_darwin
use native/sys_windows

/// Ends the process with status code, standard output flushed: exit_group
/// on Linux (no C library's exit: nothing registers atexit handlers),
/// libSystem's exit on macOS, ExitProcess on Windows. A test binary's
/// os.proc.exit goes to twrun.xo exit instead (the prelude's llrt_exit).
pub fn exit(code: Int) {
  stdio.flush()
  // the sampling profile (prof.xo, through cabi.xo: it imports this module)
  let _p = rt.call_c2(rt.fn_addr("prof_finish"), 0, 0)
  if !env_get("XO_LEAKCHECK").is_empty() {
    // the leak report runs only when main returns (the C runtime's end
    // of main): here live frames still hold values, so say it was
    // skipped rather than print nothing (gotchas/leakcheck-skipped-at-exit.md)
    stdio.eprint("xo leakcheck: skipped (os.proc.exit)", true)
  }
  os_exit(code)
}

/// Ends the process with status code at once (no flush, no test world):
/// exit_group on Linux, libSystem's exit on macOS, ExitProcess on
/// Windows.
pub fn os_exit(code: Int) {
  match target.os {
    TargetOs.Linux => {
      let _r = linux.exit_group(code)
    }
    TargetOs.Darwin => sys_darwin.exit(code)
    TargetOs.Windows => sys_windows.ExitProcess(code)
    TargetOs.Wasi => {}
  }
}

/// rt.static_word: the first of the three process words (rt.xo's table):
/// argc, the address of argv, and the address of the environment's
/// NULL ended array of NAME=VALUE strings (0 until proc_start).
const WORDS = 7
const ARGC = 0
const ARGV = 8
const ENVP = 16

/// The test world's capability bit of env (xo_testing.c TW_REAL_ENV).
const TW_ENV = 16

/// Keeps the arguments and the environment (C main, before the program
/// runs).
pub fn start(argc: Int, argv: Int, envp: Int) {
  let w = rt.static_word(WORDS)
  rt.mem_store(w, ARGC, argc, 8)
  rt.mem_store(w, ARGV, argv, 8)
  let e = match target.os {
    // the C runtime's environ is in the ANSI code page (a value outside
    // it comes out as '?'): the environment from Windows in UTF-8
    TargetOs.Windows => win_env()
    _ => envp
  }
  rt.mem_store(w, ENVP, e, 8)
  // the initial stack's layout (argv's NULL ended array, then envp's,
  // then the auxiliary vector): not an environ a setenv moved
  if target.os == TargetOs.Linux && argv != 0 && envp == rt.int_wrap(0, argv, rt.int_wrap(3, argc + 1, 3)) {
    linux.auxv_init(envp)
  }
}

/// The environment as an environ array in UTF-8 (was xo_win.c
/// xo_w_environ): GetEnvironmentStringsW's NAME=VALUE strings converted,
/// the per drive directories (`=C:=C:\...`) left out, in malloc'd strings
/// and an array ending in 0, kept for the program's life (Xo programs do
/// not set variables). UNTESTED on windows.
fn win_env() -> Int {
  let blk = sys_windows.GetEnvironmentStringsW()
  var n = 0
  var p = blk
  while p != 0 && rt.mem_load(p, 0, 2) != 0 {
    n += 1
    p = next_wstr(p)
  }
  let arr = rt.heap_large(8 * (n + 1))
  var k = 0
  p = blk
  while p != 0 && rt.mem_load(p, 0, 2) != 0 {
    if rt.mem_load(p, 0, 2) != 61 {
      // CP_UTF8, the terminating 0 converted too
      let u = Int(sys_windows.WideCharToMultiByte(65001, 0, p, -1, 0, 0, 0, 0))
      if u > 0 {
        let s = rt.heap_large(u)
        let _c = sys_windows.WideCharToMultiByte(65001, 0, p, -1, s, u, 0, 0)
        rt.mem_store(arr, 8 * k, s, 8)
        k += 1
      }
    }
    p = next_wstr(p)
  }
  rt.mem_store(arr, 8 * k, 0, 8)
  if blk != 0 {
    let _f = sys_windows.FreeEnvironmentStringsW(blk)
  }
  arr
}

/// The address after the 0 unit that ends the UTF-16 string at p.
fn next_wstr(p0: Int) -> Int {
  var p = p0
  while rt.mem_load(p, 0, 2) != 0 {
    p += 2
  }
  p + 2
}

/// The zero terminated string at address a.
fn cstr(a: Int) -> Str { raw.str_at(a, raw.cstr_len(a)) }

/// The program's environment as exec passes it on, NAME=VALUE in the
/// order of environ (std/native/llrt/procspec.xo builds a child's from
/// it; not the test world's fake: xo_proc.c's xo_proc_environ read the
/// real one).
pub fn environ() -> List[Str] {
  let envp = rt.mem_load(rt.static_word(WORDS), ENVP, 8)
  var out: List[Str] = []
  if envp == 0 {
    return out
  }
  var k = 0
  while true {
    let e = rt.mem_load(envp, 8 * k, 8)
    if e == 0 {
      break
    }
    out.push(cstr(e))
    k += 1
  }
  out
}

/// The address of the program's environment array (environ).
pub fn environ_addr() -> Int { rt.mem_load(rt.static_word(WORDS), ENVP, 8) }

/// getenv(name) of the real environment (not a test's fake): the value in
/// a list of one, or the empty list.
pub fn real_env_get(name: Str) -> List[Str] {
  let envp = environ_addr()
  if envp == 0 {
    return []
  }
  let p = raw.data(name)
  let n = name.len()
  var k = 0
  while true {
    let e = rt.mem_load(envp, 8 * k, 8)
    if e == 0 {
      break
    }
    if entry_is(e, p, n, fold_case()) {
      return [cstr(rt.int_wrap(0, e, rt.int_wrap(0, n, 1)))]
    }
    k = rt.int_wrap(0, k, 1)
  }
  []
}

/// argv[i] (0 <= i < argc).
fn arg(i: Int) -> Str { cstr(rt.mem_load(rt.mem_load(rt.static_word(WORDS), ARGV, 8), 8 * i, 8)) }

/// env.args(): the arguments after the program name.
pub fn args() -> List[Str] {
  if testworld.fake(TW_ENV) {
    return testworld.args()
  }
  let n = rt.mem_load(rt.static_word(WORDS), ARGC, 8)
  var out: List[Str] = []
  for i in 1..n {
    out.push(arg(i))
  }
  out
}

/// env.program(): the program's name as it was run (argv[0], os.Args[0]
/// on the Go backend), with / separators on Windows (std.md 3.1, 3.5);
/// "test" in a test whose world fakes env.
pub fn program() -> Str {
  if testworld.fake(TW_ENV) {
    return "test"
  }
  if rt.mem_load(rt.static_word(WORDS), ARGC, 8) <= 0 {
    return ""
  }
  let p = arg(0)
  match target.os {
    TargetOs.Windows => p.replace("\\", "/")
    _ => p
  }
}

/// Whether the entry at address e is NAME=... for name (the n bytes at
/// p): byte for byte, or without ASCII case on Windows, as its getenv.
fn entry_is(e: Int, p: Int, n: Int, fold: Bool) -> Bool {
  var i = 0
  while i < n {
    var a = rt.mem_load(e, i, 1)
    var b = rt.mem_load(p, i, 1)
    if a == 0 {
      return false
    }
    if fold {
      if a >= 65 && a <= 90 {
        a = rt.int_wrap(0, a, 32)
      }
      if b >= 65 && b <= 90 {
        b = rt.int_wrap(0, b, 32)
      }
    }
    if a != b {
      return false
    }
    i = rt.int_wrap(0, i, 1)
  }
  rt.mem_load(e, n, 1) == 61
}

/// Whether names compare without case (Windows).
fn fold_case() -> Bool {
  match target.os {
    TargetOs.Windows => true
    _ => false
  }
}

/// env.get(name): the value in a list of one, or the empty list when it
/// is not set.
pub fn env_get(name: Str) -> List[Str] {
  if testworld.fake(TW_ENV) {
    return testworld.env_get_raw(raw.data(name), name.len())
  }
  env_real(name)
}

/// The process's own environment variable name, as env_get, never the
/// test world's FakeEnv (the runtime's settings: XO_THREADS, XO_RTSTATS,
/// as the C's getenv read them).
pub fn env_real(name: Str) -> List[Str] {
  let v = env_real_at(name)
  if v == 0 {
    return []
  }
  [cstr(v)]
}

/// The address of the zero terminated value of the process's own
/// environment variable name, or 0 when it is not set: env_real with no
/// allocation (the C entry's leak check reads XO_LEAKCHECK after the
/// count would see a new block).
pub fn env_real_at(name: Str) -> Int {
  let envp = rt.mem_load(rt.static_word(WORDS), ENVP, 8)
  if envp == 0 {
    return 0
  }
  let fold = fold_case()
  let p = raw.data(name)
  let n = name.len()
  var k = 0
  while true {
    let e = rt.mem_load(envp, 8 * k, 8)
    if e == 0 {
      break
    }
    if entry_is(e, p, n, fold) {
      return rt.int_wrap(0, e, rt.int_wrap(0, n, 1))
    }
    k = rt.int_wrap(0, k, 1)
  }
  0
}

/// env.vars(): the NAME=VALUE entries of the environment, sorted as
/// std/rt's realEnv.vars sorts os.Environ() (decision 0172); a test's
/// FakeEnv in the order of its variables.
pub fn env_vars() -> List[Str] {
  if testworld.fake(TW_ENV) {
    return testworld.env_vars()
  }
  let envp = rt.mem_load(rt.static_word(WORDS), ENVP, 8)
  var out: List[Str] = []
  if envp == 0 {
    return out
  }
  var k = 0
  while true {
    let e = rt.mem_load(envp, 8 * k, 8)
    if e == 0 {
      break
    }
    out.push(cstr(e))
    k = rt.int_wrap(0, k, 1)
  }
  out.sort()
}
