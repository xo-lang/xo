// The Unicode operations of the native runtime, written in Xo (decision
// 0180, the runtime pilot): the case mapping of Str and Rune (lower,
// upper, title), the Rune classes (is_letter, is_digit, is_space,
// is_upper, is_lower, is_title, is_punct, is_control, is_graphic,
// is_mark, is_symbol, is_number, is_print and utf8_len), strconv's
// quoting, and the class ranges of std/regexp's \pL and \p{Nd}. They were
// C (std/llrt's xo_unicode.c tables and their users, deleted by decision
// 0198); the semantics are still Go's (unicode, strings, strconv), so the
// native backends print what the Go backend prints.
//
// A runtime module (std/native/llrt/<name>.xo, imported as
// `use native/llrt/<name>`) is compiled with the program like the
// implementation modules; only those and other runtime modules may
// import it. The tables are generated (unicode_tables.xo).
use native/llrt/raw
use native/llrt/scan
use native/llrt/unicode_tables
use native/rt

/// The 24 bit value at byte i of t: one load and a mask, the tables being
/// little endian with eight zero bytes of pad (internal/llvm
/// TestUnicodeTables). The three checked index reads it replaces were 34
/// percent of the mixed case mapping profile (2026-10-24).
fn u24(t: Bytes, i: Int) -> Int {
  rt.bytes_word(t, i) & 0xffffff
}

/// The 24 bit two's complement value at byte i of t.
fn s24(t: Bytes, i: Int) -> Int {
  let v = u24(t, i)
  if v >= 0x800000 {
    return v - 0x1000000
  }
  v
}

/// Whether r is in one of the n sorted inclusive ranges of t (6 bytes
/// each, lo and hi).
fn in_ranges(t: Bytes, n: Int, r: Int) -> Bool {
  var lo = 0
  var hi = n
  while lo < hi {
    // 0 <= lo <= hi <= n, so no step needs a check: shr_logical for the
    // midpoint (a signed `/ 2` is add, asr and an overflow branch), the
    // products and sums wrapping (2026-10-24: the checks were 4 of the
    // loop's 17 instructions an iteration)
    let m = lo.wrapping_add(hi).shr_logical(1)
    let k = m.wrapping_mul(6)
    if r < u24(t, k) {
      hi = m
    } else if r > u24(t, k.wrapping_add(3)) {
      lo = m.wrapping_add(1)
    } else {
      return true
    }
  }
  false
}

/// Bit r of a class bitmap of the runes U+0080 to U+07FF.
fn has_bit(t: Bytes, r: Int) -> Bool {
  ((Int(t[(r - 0x80) >> 3]) >> (r & 7)) & 1) != 0
}

/// unicode.IsLetter.
pub fn is_letter(r: Int) -> Bool {
  if r >= 0x80 {
    if r < 0x800 {
      return has_bit(unicode_tables.LETTER_BITS, r)
    }
    return in_ranges(unicode_tables.LETTER, unicode_tables.LETTER_N, r)
  }
  // A, Z, a and z differ only in bit 5, so `r | 32` tests both cases with
  // one unsigned range compare (2026-10-24: the two ASCII range tests were
  // two compares and a branch)
  let x = r | 32
  x >= 97 && x <= 122
}

/// unicode.IsDigit.
pub fn is_digit(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 48 && r <= 57
  }
  if r < 0x800 {
    return has_bit(unicode_tables.DIGIT_BITS, r)
  }
  in_ranges(unicode_tables.DIGIT, unicode_tables.DIGIT_N, r)
}

/// strconv.IsPrint.
pub fn is_print(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 0x20 && r < 0x7F
  }
  if r < 0x800 {
    return has_bit(unicode_tables.PRINT_BITS, r)
  }
  in_ranges(unicode_tables.PRINT, unicode_tables.PRINT_N, r)
}

// The Rune classes below, like is_letter above: ASCII tested directly, the
// runes U+0080 to U+07FF from a bitmap of this class, and the rest by the
// binary search over its merged ranges (Decision 0180's shape; Go's
// Latin-1 properties table covers only U+0000 to U+00FF, the bitmap one
// byte further).

/// unicode.IsUpper.
pub fn is_upper(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 65 && r <= 90
  }
  if r < 0x800 {
    return has_bit(unicode_tables.UPPER_BITS, r)
  }
  in_ranges(unicode_tables.UPPER, unicode_tables.UPPER_N, r)
}

/// unicode.IsLower.
pub fn is_lower(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 97 && r <= 122
  }
  if r < 0x800 {
    return has_bit(unicode_tables.LOWER_BITS, r)
  }
  in_ranges(unicode_tables.LOWER, unicode_tables.LOWER_N, r)
}

/// unicode.IsTitle (no title case rune is below U+0080).
pub fn is_title(r: Int) -> Bool {
  if r < 0x80 {
    return false
  }
  if r < 0x800 {
    return has_bit(unicode_tables.TITLE_BITS, r)
  }
  in_ranges(unicode_tables.TITLE, unicode_tables.TITLE_N, r)
}

/// unicode.IsPunct (in ASCII, the nine symbol characters are is_symbol,
/// not is_punct).
pub fn is_punct(r: Int) -> Bool {
  if r < 0x80 {
    return (r >= 33 && r <= 47 && r != 36 && r != 43) || (r >= 58 && r <= 64 && r != 60 && r != 61 && r != 62) || (r >= 91 && r <= 96 && r != 94 && r != 96) || (r >= 123 && r <= 126 && r != 124 && r != 126)
  }
  if r < 0x800 {
    return has_bit(unicode_tables.PUNCT_BITS, r)
  }
  in_ranges(unicode_tables.PUNCT, unicode_tables.PUNCT_N, r)
}

/// unicode.IsControl.
pub fn is_control(r: Int) -> Bool {
  if r < 0x80 {
    return r < 32 || r == 127
  }
  if r < 0x800 {
    return has_bit(unicode_tables.CONTROL_BITS, r)
  }
  in_ranges(unicode_tables.CONTROL, unicode_tables.CONTROL_N, r)
}

/// unicode.IsGraphic (letters, marks, numbers, punctuation, symbols and
/// the space separators; no control, format or line separator).
pub fn is_graphic(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 32 && r <= 126
  }
  if r < 0x800 {
    return has_bit(unicode_tables.GRAPHIC_BITS, r)
  }
  in_ranges(unicode_tables.GRAPHIC, unicode_tables.GRAPHIC_N, r)
}

/// unicode.IsMark (no mark is below U+0080).
pub fn is_mark(r: Int) -> Bool {
  if r < 0x80 {
    return false
  }
  if r < 0x800 {
    return has_bit(unicode_tables.MARK_BITS, r)
  }
  in_ranges(unicode_tables.MARK, unicode_tables.MARK_N, r)
}

/// unicode.IsSymbol.
pub fn is_symbol(r: Int) -> Bool {
  if r < 0x80 {
    return r == 36 || r == 43 || (r >= 60 && r <= 62) || r == 94 || r == 96 || r == 124 || r == 126
  }
  if r < 0x800 {
    return has_bit(unicode_tables.SYMBOL_BITS, r)
  }
  in_ranges(unicode_tables.SYMBOL, unicode_tables.SYMBOL_N, r)
}

/// unicode.IsNumber.
pub fn is_number(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 48 && r <= 57
  }
  if r < 0x800 {
    return has_bit(unicode_tables.NUMBER_BITS, r)
  }
  in_ranges(unicode_tables.NUMBER, unicode_tables.NUMBER_N, r)
}

/// unicode.ToLower (lower) or unicode.ToUpper of the scalar value r.
pub fn to_case(r: Int, lower: Bool) -> Int {
  if r < 0x80 {
    if lower {
      if r >= 65 && r <= 90 {
        return r + 32
      }
    } else if r >= 97 && r <= 122 {
      return r - 32
    }
    return r
  }
  if r < 0x800 {
    // two byte UTF-8 (Latin, Greek, Cyrillic, ...): a direct table
    if lower {
      return u24(unicode_tables.LOWER2, (r - 0x80) * 3)
    }
    return u24(unicode_tables.UPPER2, (r - 0x80) * 3)
  }
  case_map(r, if lower { 1 } else { 0 })
}

/// unicode.ToTitle of the rune r (title case is upper case in ASCII).
pub fn to_title(r: Int) -> Int {
  if r < 0x80 {
    if r >= 97 && r <= 122 {
      return r - 32
    }
    return r
  }
  if r < 0x800 {
    return u24(unicode_tables.TITLE2, (r - 0x80) * 3)
  }
  case_map(r, 2)
}

/// Go's lookupCaseRange and convertCase above U+07FF: kind is Go's
/// UpperCase (0), LowerCase (1) or TitleCase (2).
fn case_map(r: Int, kind: Int) -> Int {
  let t = unicode_tables.CASE
  var lo = 0
  var hi = unicode_tables.CASE_N
  while lo < hi {
    let m = lo + (hi - lo) / 2
    let k = m * 15
    let first = u24(t, k)
    if r < first {
      hi = m
    } else if r > u24(t, k + 3) {
      lo = m + 1
    } else {
      let d = s24(t, k + 6 + kind * 3)
      if d == unicode_tables.UPPER_LOWER {
        // alternating upper and lower pairs, from an upper case one: the
        // upper (and title) case at an even offset from first, the lower
        // at an odd one
        let even = first + (r - first) / 2 * 2
        return if kind == 1 { even + 1 } else { even }
      }
      return r + d
    }
  }
  r
}

/// utf8.RuneLen of the rune r: the 1, 2, 3 or 4 bytes it takes in UTF-8.
/// A Rune is always a scalar value, so Go's -1 for an invalid rune cannot
/// happen here; `Rune.try(n)` is that check on an Int (core 2.4,
/// decision 0079).
pub fn utf8_len(r: Int) -> Int {
  if r < 0x80 {
    return 1
  }
  if r < 0x800 {
    return 2
  }
  if r < 0x10000 {
    return 3
  }
  4
}

/// The bytes 0 to 255, so `BYTE[x]` is x as a UInt8 for x in that range
/// (no checked conversion).
const BYTE: Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\x22#\x24%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\x5c]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

/// x (0 to 255) as a UInt8.
pub fn byte(x: Int) -> UInt8 { BYTE[x] }

/// Whether r is white space (unicode.IsSpace).
pub fn is_space(r: Int) -> Bool {
  if r < 0x80 {
    return r == 32 || (r >= 9 && r <= 13)
  }
  if r >= 0x2000 {
    if r <= 0x200A {
      return true
    }
    if r > 0x205F {
      return r == 0x3000
    }
    return r == 0x2028 || r == 0x2029 || r == 0x202F || r == 0x205F
  }
  r == 0x85 || r == 0xA0 || r == 0x1680
}

/// utf8.DecodeRune of b from i (i < b.len()): the rune times 8 plus its
/// size; an invalid byte is U+FFFD of size 1 (raw.xo's).
pub fn decode(b: Bytes, i: Int) -> Int { raw.decode(b, i) }

// The text operations build their result in a Str, appended in place
// through the runtime's rs_* intrinsics (the result is unique): the bytes
// that stay as they are go over in runs (rt.rs_append_bytes, which also
// maps ASCII letters), so the C runtime keeps only the bulk byte moves.

/// The mode of rt.rs_append_bytes that maps ASCII letters like to_case.
fn ascii_mode(lower: Bool) -> Int {
  if lower {
    return 1
  }
  2
}

/// strings.ToLower (lower) or strings.ToUpper of the bytes from i of b
/// appended to out (strings.Map: an invalid byte becomes U+FFFD). Runs of
/// ASCII bytes (found by scan.span) and of runes that do not change
/// are appended at once.
fn case_append(out: Str, b: Bytes, from: Int, lower: Bool) -> Str {
  let n = b.len()
  let mode = ascii_mode(lower)
  var o = out
  var run = from
  var i = scan.span(b, from, 0)
  while i < n {
    // The loop re-enters only at a non-ASCII byte (scan.span returns the
    // end of an ASCII run), so the two byte runes of Latin, Greek and
    // Cyrillic, the bulk of mixed text, are decoded here rather than in
    // raw.decode's general path. The malformed cases are the same: a
    // lead of 0x80 to 0xC1, a truncated sequence or a bad continuation
    // byte is U+FFFD of size one.
    var r = 0
    var size = 1
    let c0 = Int(b[i])
    if c0 < 0x80 {
      r = c0
    } else if c0 < 0xE0 {
      if c0 >= 0xC2 && i + 1 < n {
        let c1 = Int(b[i + 1])
        if c1 >= 0x80 && c1 <= 0xBF {
          r = ((c0 & 0x1F) << 6) | (c1 & 0x3F)
          size = 2
        } else {
          r = 0xFFFD
        }
      } else {
        r = 0xFFFD
      }
    } else {
      let p = decode(b, i)
      r = p >> 3
      size = p & 7
    }
    let x = to_case(r, lower)
    if x != r || (r == 0xFFFD && size == 1) {
      if run < i {
        o = rt.rs_append_bytes(o, b, run, i, mode)
      }
      // raw.push_rune's encoding without its call and its scalar value
      // check: x is a rune the decoder produced or a table value, so it is
      // a scalar value already.
      if x < 0x80 {
        o = rt.rs_push_byte(o, x)
      } else if x < 0x800 {
        o = rt.rs_push_word(o, (0xC0 | (x >> 6)) | ((0x80 | (x & 0x3F)) << 8), 2)
      } else if x < 0x10000 {
        o = rt.rs_push_word(o, (0xE0 | (x >> 12)) | ((0x80 | ((x >> 6) & 0x3F)) << 8) | ((0x80 | (x & 0x3F)) << 16), 3)
      } else {
        o = rt.rs_push_word(o, (0xF0 | (x >> 18)) | ((0x80 | ((x >> 12) & 0x3F)) << 8) | ((0x80 | ((x >> 6) & 0x3F)) << 16) | ((0x80 | (x & 0x3F)) << 24), 4)
      }
      run = i + size
    }
    i += size
    if i < n && b[i] < 0x80 {
      i = scan.span(b, i, 0)
    }
  }
  if run < n {
    o = rt.rs_append_bytes(o, b, run, n, mode)
  }
  o
}

/// Whether every byte of b is ASCII and already in the case (lower): the
/// fast path of map_case and map_case_bytes.
fn case_done(b: Bytes, lower: Bool) -> Bool {
  let lo = if lower { 65 } else { 97 }
  let hi = if lower { 90 } else { 122 }
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c >= 0x80 || (c >= lo && c <= hi) {
      return false
    }
    i += 1
  }
  true
}

/// strings.ToLower (lower) or strings.ToUpper.
pub fn map_case(s: Str, lower: Bool) -> Str {
  let b = s.bytes()
  // ASCII already in the case: s itself, no copy (`req.method.to_upper()`
  // of every HTTP request)
  if case_done(b, lower) {
    return s
  }
  case_append(rt.rs_with_cap(b.len()), b, 0, lower)
}

/// bytes.ToLower (lower) or bytes.ToUpper: map_case's mapping, the buffer
/// (a runtime Str) relabelled as Bytes. ASCII already in the case: b
/// itself, no copy.
pub fn map_case_bytes(b: Bytes, lower: Bool) -> Bytes {
  if case_done(b, lower) {
    return b
  }
  rt.cast[Str, Bytes](case_append(rt.rs_with_cap(b.len()), b, 0, lower))
}

/// `a.to_lower() == b.to_lower()` without making the lowered strings:
/// ASCII bytes compare lowered in place; from the first non-ASCII byte of
/// either (a rune boundary of both, since everything before is ASCII) the
/// rests are lowered and compared (std/rt's Str_eq_lower on the Go
/// backend).
pub fn eq_lower(a: Str, b: Str) -> Bool {
  let x = a.bytes()
  let y = b.bytes()
  let n = x.len()
  let m = y.len()
  var i = 0
  while i < n && i < m {
    let p = Int(x[i])
    let q = Int(y[i])
    if p >= 0x80 || q >= 0x80 {
      break
    }
    // ASCII: equal bytes match, else they must be one letter's two cases
    // (Go's fast loop, which returns at the first difference; the lowered
    // comparison of eq_lower is the same test)
    if p != q {
      let lo = if p < q { p } else { q }
      let hi = if p < q { q } else { p }
      if !(lo >= 65 && lo <= 90 && hi == lo + 32) {
        return false
      }
    }
    i += 1
  }
  if i == n && i == m {
    return true
  }
  if i == n || i == m {
    // a nonempty rest never lowers to nothing
    return false
  }
  case_append(rt.rs_with_cap(n - i), x, i, true) == case_append(rt.rs_with_cap(m - i), y, i, true)
}

/// The Unicode maximum code point (std/regexp keeps its own copy).
const MAX_RUNE: Int = 0x10ffff

/// unicode.SimpleFold: the next rune of r's simple case folding orbit
/// (the smallest rune after the largest wraps around to the smallest).
/// It is ToLower when that changes r, else ToUpper, except for the runes
/// whose orbit is longer than a pair or has no lower case, listed here.
/// The caller walks the orbit; std/regexp's case insensitive matching
/// uses it (moved here from std/native/regexp.xo, which had the only
/// copy).
pub fn simple_fold(r: Int) -> Int {
  if r < 0 || r > MAX_RUNE {
    return r
  }
  // The runes are sparse (0x6b to 0xa64b), so a single match is a compare
  // chain 38 tests long and a miss walks all of them (a jump table needs a
  // dense range: compiler/arm64/jumptab.xo). The five buckets make a miss
  // cheap: most runes below 0x3a3 are not in the table at all.
  let odd = if r < 0x200 {
    match r {
      0x6b => 0x212a
      0x73 => 0x17f
      0xdf => 0x1e9e
      0xe5 => 0x212b
      0x130 => 0x130
      0x131 => 0x131
      0x1c4 => 0x1c5
      0x1c7 => 0x1c8
      0x1ca => 0x1cb
      0x1f1 => 0x1f2
      _ => -1
    }
  } else if r < 0x3a3 {
    -1
  } else if r < 0x400 {
    match r {
      0x3a3 => 0x3c2
      0x3b2 => 0x3d0
      0x3b5 => 0x3f5
      0x3b8 => 0x3d1
      0x3b9 => 0x1fbe
      0x3ba => 0x3f0
      0x3bc => 0xb5
      0x3c0 => 0x3d6
      0x3c1 => 0x3f1
      0x3c2 => 0x3c3
      0x3c6 => 0x3d5
      0x3c9 => 0x2126
      0x3d1 => 0x3f4
      0x3f4 => 0x398
      _ => -1
    }
  } else if r < 0x500 {
    match r {
      0x432 => 0x1c80
      0x434 => 0x1c81
      0x43e => 0x1c82
      0x441 => 0x1c83
      0x442 => 0x1c84
      0x44a => 0x1c86
      0x463 => 0x1c87
      _ => -1
    }
  } else {
    match r {
      0x1c84 => 0x1c85
      0x1e61 => 0x1e9b
      0x1fbe => 0x345
      0x2126 => 0x3a9
      0x212a => 0x4b
      0x212b => 0xc5
      0xa64b => 0x1c88
      _ => -1
    }
  }
  if odd >= 0 {
    return odd
  }
  let l = to_case(r, true)
  if l != r {
    return l
  }
  to_case(r, false)
}

/// strings.EqualFold: whether a and b are equal under Unicode simple case
/// folding (not only ASCII case). An ASCII prefix compares as bytes, as
/// Go's fast path does; from the first non-ASCII byte of either, which is
/// a rune boundary of both, the rests compare rune by rune, an equal rune
/// or an ASCII upper and lower case of one letter matching directly and
/// any other pair by walking the SimpleFold orbit of the smaller rune.
pub fn equal_fold(a: Str, b: Str) -> Bool {
  equal_fold_bytes(a.bytes(), b.bytes())
}

/// bytes.EqualFold: equal_fold's comparison of two byte slices, which is
/// what a Str's bytes are (two different bytes of invalid sequences
/// compare equal, as both decode to U+FFFD, which is Go's rule).
pub fn equal_fold_bytes(x: Bytes, y: Bytes) -> Bool {
  let n = x.len()
  let m = y.len()
  var i = 0
  while i < n && i < m {
    let p = Int(x[i])
    let q = Int(y[i])
    if p >= 0x80 || q >= 0x80 {
      break
    }
    // ASCII: equal bytes match, else they must be one letter's two cases
    // (Go's fast loop, which returns at the first difference; the lowered
    // comparison of eq_lower is the same test)
    if p != q {
      let lo = if p < q { p } else { q }
      let hi = if p < q { q } else { p }
      if !(lo >= 65 && lo <= 90 && hi == lo + 32) {
        return false
      }
    }
    i += 1
  }
  if i == n && i == m {
    return true
  }
  if i == n || i == m {
    // one is a prefix of the other, but not equal
    return false
  }
  var j = i
  while i < n && j < m {
    let dp = raw.decode(x, i)
    let dq = raw.decode(y, j)
    let sr = dp >> 3
    let tr = dq >> 3
    i += dp & 7
    j += dq & 7
    if tr == sr {
      continue
    }
    let lo = if tr < sr { tr } else { sr }
    let hi = if tr < sr { sr } else { tr }
    if hi < 0x80 {
      // ASCII only: hi must be the lower case of lo
      if lo >= 65 && lo <= 90 && hi == lo + 32 {
        continue
      }
      return false
    }
    var f = simple_fold(lo)
    while f != lo && f < hi {
      f = simple_fold(f)
    }
    if f != hi {
      return false
    }
  }
  i == n && j == m
}

const HEX: Bytes = b"0123456789abcdef"

/// The letter of the escape \<letter> of strconv for the control rune r,
/// or 0.
fn escape_letter(r: Int) -> Int {
  match r {
    7 => 97
    8 => 98
    12 => 102
    10 => 110
    13 => 114
    9 => 116
    11 => 118
    _ => 0
  }
}

/// out + r (a scalar value) as Go's strconv quotes it inside the quote
/// character quote.
fn quote_rune_append(out: Str, r: Int, quote: Int) -> Str {
  var o = out
  if r == quote || r == 92 {
    o = rt.rs_push_byte(o, 92)
    return rt.rs_push_byte(o, r)
  }
  if is_print(r) {
    return raw.push_rune(o, r)
  }
  o = rt.rs_push_byte(o, 92)
  let e = escape_letter(r)
  if e != 0 {
    return rt.rs_push_byte(o, e)
  }
  var digits = 8
  if r < 32 || r == 0x7F {
    digits = 2
    o = rt.rs_push_byte(o, 120)
  } else if r < 0x10000 {
    digits = 4
    o = rt.rs_push_byte(o, 117)
  } else {
    o = rt.rs_push_byte(o, 85)
  }
  var i = 0
  while i < digits {
    o = rt.rs_push_byte(o, Int(HEX[(r >> (4 * (digits - 1 - i))) & 15]))
    i += 1
  }
  o
}

/// strconv.QuoteRune of the scalar value r.
pub fn quote_rune(r: Int) -> Str {
  var o = rt.rs_push_byte(rt.rs_with_cap(8), 39)
  o = quote_rune_append(o, r, 39)
  rt.rs_push_byte(o, 39)
}

/// strconv.Quote of the bytes of a Str or Bytes: a byte of an invalid
/// sequence is \x of the byte. Runs of printable runes other than `"`
/// and `\` are appended at once.
pub fn quote(b: Bytes) -> Str {
  let n = b.len()
  var o = rt.rs_push_byte(rt.rs_with_cap(n + 2), 34)
  var run = 0
  var i = 0
  while i < n {
    i = scan.span(b, i, 1)
    if i >= n {
      break
    }
    let c = b[i]
    let p = decode(b, i)
    let r = p >> 3
    let size = p & 7
    if r != 0xFFFD && is_print(r) && c >= 0x80 {
      i += size
      continue
    }
    if run < i {
      o = rt.rs_append_bytes(o, b, run, i, 0)
    }
    if r == 0xFFFD && size == 1 {
      o = rt.rs_push_byte(o, 92)
      o = rt.rs_push_byte(o, 120)
      o = rt.rs_push_byte(o, Int(HEX[Int(c) >> 4]))
      o = rt.rs_push_byte(o, Int(HEX[Int(c) & 15]))
    } else {
      o = quote_rune_append(o, r, 34)
    }
    i += size
    run = i
  }
  if run < n {
    o = rt.rs_append_bytes(o, b, run, n, 0)
  }
  rt.rs_push_byte(o, 34)
}
