// The Unicode operations of the native runtime, written in Xo (decision
// 0180, the runtime pilot): the case mapping of Str and Rune, the Rune
// classes is_letter, is_digit, and is_print, strconv's quoting, and the
// class ranges of std/regexp's \pL and \p{Nd}. They were C (std/llrt's
// xo_unicode.c tables and their users in xo_std.c and xo_bytes.c); the
// semantics are still Go's (unicode, strings, strconv), so the native
// backends print what the Go backend prints.
//
// A runtime module (std/native/llrt/<name>.xo, imported as
// `use native/llrt/<name>`) is compiled with the program like the
// implementation modules; only those and other runtime modules may
// import it. The tables are generated (unicode_tables.xo).
use native/llrt/unicode_tables
use native/rt

/// The 24 bit big endian value at byte i of t.
fn u24(t: Bytes, i: Int) -> Int {
  (Int(t[i]) << 16) | (Int(t[i + 1]) << 8) | Int(t[i + 2])
}

/// The 24 bit two's complement value at byte i of t.
fn s24(t: Bytes, i: Int) -> Int {
  let v = u24(t, i)
  if v >= 0x800000 {
    return v - 0x1000000
  }
  v
}

/// Whether r is in one of the n sorted inclusive ranges of t (6 bytes
/// each, lo and hi).
fn in_ranges(t: Bytes, n: Int, r: Int) -> Bool {
  var lo = 0
  var hi = n
  while lo < hi {
    let m = lo + (hi - lo) / 2
    let k = m * 6
    if r < u24(t, k) {
      hi = m
    } else if r > u24(t, k + 3) {
      lo = m + 1
    } else {
      return true
    }
  }
  false
}

/// unicode.IsLetter.
pub fn is_letter(r: Int) -> Bool {
  if r < 0x80 {
    return (r >= 97 && r <= 122) || (r >= 65 && r <= 90)
  }
  in_ranges(unicode_tables.LETTER, unicode_tables.LETTER_N, r)
}

/// unicode.IsDigit.
pub fn is_digit(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 48 && r <= 57
  }
  in_ranges(unicode_tables.DIGIT, unicode_tables.DIGIT_N, r)
}

/// strconv.IsPrint.
pub fn is_print(r: Int) -> Bool {
  if r < 0x80 {
    return r >= 0x20 && r < 0x7F
  }
  in_ranges(unicode_tables.PRINT, unicode_tables.PRINT_N, r)
}

/// unicode.ToLower (lower) or unicode.ToUpper of the scalar value r.
pub fn to_case(r: Int, lower: Bool) -> Int {
  if r < 0x80 {
    if lower {
      if r >= 65 && r <= 90 {
        return r + 32
      }
    } else if r >= 97 && r <= 122 {
      return r - 32
    }
    return r
  }
  let t = unicode_tables.CASE
  var lo = 0
  var hi = unicode_tables.CASE_N
  while lo < hi {
    let m = lo + (hi - lo) / 2
    let k = m * 12
    let first = u24(t, k)
    if r < first {
      hi = m
    } else if r > u24(t, k + 3) {
      lo = m + 1
    } else {
      let d = if lower { s24(t, k + 9) } else { s24(t, k + 6) }
      if d == unicode_tables.UPPER_LOWER {
        // alternating pairs: the upper case at an even offset from first
        let even = first + (r - first) / 2 * 2
        return if lower { even + 1 } else { even }
      }
      return r + d
    }
  }
  r
}

/// The bytes 0 to 255, so `BYTE[x]` is x as a UInt8 for x in that range
/// (no checked conversion).
const BYTE: Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\x22#\x24%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\x5c]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

/// x (0 to 255) as a UInt8.
pub fn byte(x: Int) -> UInt8 { BYTE[x] }

/// utf8.DecodeRune of b from i (i < b.len()): the rune times 8 plus its
/// size; an invalid byte is U+FFFD of size 1.
pub fn decode(b: Bytes, i: Int) -> Int {
  let n = b.len()
  let c = Int(b[i])
  if c < 0x80 {
    return (c << 3) | 1
  }
  var k = 0
  var lo = 0x80
  var hi = 0xBF
  var r = 0
  if c >= 0xC2 && c <= 0xDF {
    k = 1
    r = c & 0x1F
  } else if c >= 0xE0 && c <= 0xEF {
    k = 2
    r = c & 0x0F
    if c == 0xE0 {
      lo = 0xA0
    } else if c == 0xED {
      hi = 0x9F
    }
  } else if c >= 0xF0 && c <= 0xF4 {
    k = 3
    r = c & 0x07
    if c == 0xF0 {
      lo = 0x90
    } else if c == 0xF4 {
      hi = 0x8F
    }
  } else {
    return (0xFFFD << 3) | 1
  }
  if i + k >= n {
    return (0xFFFD << 3) | 1
  }
  let c1 = Int(b[i + 1])
  if c1 < lo || c1 > hi {
    return (0xFFFD << 3) | 1
  }
  r = (r << 6) | (c1 & 0x3F)
  var j = 2
  while j <= k {
    let cj = Int(b[i + j])
    if cj < 0x80 || cj > 0xBF {
      return (0xFFFD << 3) | 1
    }
    r = (r << 6) | (cj & 0x3F)
    j += 1
  }
  (r << 3) | (k + 1)
}

/// Appends the UTF-8 encoding of the scalar value r to out.
pub fn encode(var out: BytesBuilder, r: Int) {
  if r < 0x80 {
    out.write_byte(BYTE[r])
  } else if r < 0x800 {
    out.write_byte(BYTE[0xC0 | (r >> 6)])
    out.write_byte(BYTE[0x80 | (r & 0x3F)])
  } else if r < 0x10000 {
    out.write_byte(BYTE[0xE0 | (r >> 12)])
    out.write_byte(BYTE[0x80 | ((r >> 6) & 0x3F)])
    out.write_byte(BYTE[0x80 | (r & 0x3F)])
  } else {
    out.write_byte(BYTE[0xF0 | (r >> 18)])
    out.write_byte(BYTE[0x80 | ((r >> 12) & 0x3F)])
    out.write_byte(BYTE[0x80 | ((r >> 6) & 0x3F)])
    out.write_byte(BYTE[0x80 | (r & 0x3F)])
  }
}

/// Whether lowering (lower) or raising the ASCII byte c changes it.
fn ascii_changes(c: Int, lower: Bool) -> Bool {
  if lower {
    return c >= 65 && c <= 90
  }
  c >= 97 && c <= 122
}

/// strings.ToLower (lower) or strings.ToUpper of the bytes from i of b
/// appended to out (strings.Map: an invalid byte becomes U+FFFD).
fn case_into(var out: BytesBuilder, b: Bytes, from: Int, lower: Bool) {
  let n = b.len()
  var i = from
  while i < n {
    let c = Int(b[i])
    if c < 0x80 {
      if ascii_changes(c, lower) {
        out.write_byte(BYTE[if lower { c + 32 } else { c - 32 }])
      } else {
        out.write_byte(b[i])
      }
      i += 1
    } else {
      let p = decode(b, i)
      encode(out, to_case(p >> 3, lower))
      i += p & 7
    }
  }
}

/// strings.ToLower (lower) or strings.ToUpper.
pub fn map_case(s: Str, lower: Bool) -> Str {
  let b = s.bytes()
  let n = b.len()
  // as Go's strings.ToLower: an ASCII string that does not change is s
  var i = 0
  var changes = false
  while i < n {
    let c = Int(b[i])
    if c >= 0x80 {
      break
    }
    if ascii_changes(c, lower) {
      changes = true
    }
    i += 1
  }
  if i == n && !changes {
    return s
  }
  var out = BytesBuilder.with_capacity(n)
  case_into(out, b, 0, lower)
  rt.cast[Bytes, Str](out.freeze())
}

/// `a.to_lower() == b.to_lower()` without making the lowered strings:
/// ASCII bytes compare lowered in place; from the first non-ASCII byte of
/// either (a rune boundary of both, since everything before is ASCII) the
/// rests are lowered and compared (std/rt's Str_eq_lower on the Go
/// backend).
pub fn eq_lower(a: Str, b: Str) -> Bool {
  let x = a.bytes()
  let y = b.bytes()
  let n = x.len()
  let m = y.len()
  var i = 0
  while i < n && i < m {
    var p = Int(x[i])
    var q = Int(y[i])
    if p >= 0x80 || q >= 0x80 {
      break
    }
    if p >= 65 && p <= 90 {
      p += 32
    }
    if q >= 65 && q <= 90 {
      q += 32
    }
    if p != q {
      return false
    }
    i += 1
  }
  if i == n && i == m {
    return true
  }
  if i == n || i == m {
    // a nonempty rest never lowers to nothing
    return false
  }
  var u = BytesBuilder.with_capacity(n - i)
  case_into(u, x, i, true)
  var v = BytesBuilder.with_capacity(m - i)
  case_into(v, y, i, true)
  u.freeze() == v.freeze()
}

const HEX: Bytes = b"0123456789abcdef"

/// Appends r (a scalar value) to out as Go's strconv quotes it inside the
/// quote character quote.
fn quote_rune_into(var out: BytesBuilder, r: Int, quote: Int) {
  if r == quote || r == 92 {
    out.write_byte(92)
    out.write_byte(BYTE[r])
    return
  }
  if is_print(r) {
    encode(out, r)
    return
  }
  let e = match r {
    7 => 97
    8 => 98
    12 => 102
    10 => 110
    13 => 114
    9 => 116
    11 => 118
    _ => 0
  }
  if e != 0 {
    out.write_byte(92)
    out.write_byte(BYTE[e])
    return
  }
  out.write_byte(92)
  var digits = 8
  if r < 32 || r == 0x7F {
    digits = 2
    out.write_byte(120)
  } else if r < 0x10000 {
    digits = 4
    out.write_byte(117)
  } else {
    out.write_byte(85)
  }
  var i = 0
  while i < digits {
    out.write_byte(HEX[(r >> (4 * (digits - 1 - i))) & 15])
    i += 1
  }
}

/// strconv.QuoteRune of the scalar value r.
pub fn quote_rune(r: Int) -> Str {
  var out = BytesBuilder.with_capacity(8)
  out.write_byte(39)
  quote_rune_into(out, r, 39)
  out.write_byte(39)
  rt.cast[Bytes, Str](out.freeze())
}

/// strconv.Quote of the bytes of a Str or Bytes: a byte of an invalid
/// sequence is \x of the byte.
pub fn quote(b: Bytes) -> Str {
  let n = b.len()
  var out = BytesBuilder.with_capacity(n + 2)
  out.write_byte(34)
  var i = 0
  while i < n {
    let p = decode(b, i)
    let r = p >> 3
    if r == 0xFFFD && (p & 7) == 1 {
      let c = Int(b[i])
      out.write_byte(92)
      out.write_byte(120)
      out.write_byte(HEX[c >> 4])
      out.write_byte(HEX[c & 15])
    } else {
      quote_rune_into(out, r, 34)
    }
    i += p & 7
  }
  out.write_byte(34)
  rt.cast[Bytes, Str](out.freeze())
}

/// The ranges of a Unicode class as lo, hi pairs, sorted (std/regexp's
/// \pL and \p{Nd}, decision 0172): 0 the letters (unicode.L), 1 the
/// decimal digits (unicode.Nd).
pub fn ranges(which: Int) -> List[Int] {
  var out: List[Int] = []
  var t = unicode_tables.DIGIT
  var n = unicode_tables.DIGIT_N
  if which == 0 {
    t = unicode_tables.LETTER
    n = unicode_tables.LETTER_N
    out.push(65)
    out.push(90)
    out.push(97)
    out.push(122)
  } else {
    out.push(48)
    out.push(57)
  }
  var i = 0
  while i < n {
    out.push(u24(t, 6 * i))
    out.push(u24(t, 6 * i + 3))
    i += 1
  }
  out
}
