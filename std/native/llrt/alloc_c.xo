// The C path of the native heap (decision 0207 stage 3): the API of
// alloc.xo over the C runtime's copies (std/llrt/xo_rt.c alloc_in and
// friends, compiled with -DXO_ALLOC_C, which also makes the C call its
// own copies instead of the exports). Loaded in place of alloc.xo when
// XO_LLRT_C names `alloc`.
use native/rt

pub fn alloc(h: Int, n: Int) -> Int { rt.alloc_new_c(h, n) }

pub fn free(h: Int, p: Int) { rt.alloc_free_c(h, p) }

pub fn refill(h: Int, n: Int) { rt.alloc_refill_c(h, n) }

pub fn free_mt(h: Int, p: Int) { rt.alloc_free_mt_c(h, p) }

pub fn resize(h: Int, p: Int, old: Int, n: Int, _mt: Int) -> Int { rt.alloc_resize_c(h, p, old, n) }
