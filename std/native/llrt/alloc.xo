// The native heap in Xo (decision 0207 stage 3): the size classes, the
// free lists, the bump chunk, the leak and budget counters, and the
// magazines that move free lists between threads through the central
// lists (decision 0118), over the raw memory intrinsics and the slot
// atomics (decision 0200) at an address. The C runtime keeps its entry
// points (xo_alloc, xo_free, xo_resize in std/llrt/xo_rt.c) and
// calls these through cabi.xo's `heap_*` exports with the calling
// thread's heap record; finding that record (a thread local, decision
// 0195 prerequisite (6)) stays C until `rt.tls_get` exists (ADR 0207,
// stage 3). Decision 0198 deleted the C path (`XO_LLRT_C=alloc`).
//
// Every block has an 8 byte prefix before the address handed out: its
// size class (1 to 72) or, for a big block, minus its size.
// Classes 1 to 64 are 16 to 1,024 bytes by 16, classes 65 to 72 are
// 2 KiB to 256 KiB by powers of two; blocks above the heap's mid_max
// (at most 256 KiB, lowered by XO_HEAP_MID_MAX) are big blocks, mapped
// from the system by heapos.xo (work item B21). A free
// block of a class is on that class's free list (the next address is
// its first word); new blocks are carved from 4 MiB chunks.
//
// The no allocation, no counting rule (decision 0207, design 3), as for
// rc.xo: every function here takes and returns Int words only, uses no
// Str, List, Map, closure, or interpolation, no arithmetic that can
// fault (rt.int_wrap: op 0 add, 1 subtract, 2 multiply, 3 shift left, 4
// shift right), and calls only inline intrinsics and the platform calls
// rt.heap_* (heapos.xo's big blocks, a new chunk, the central lists'
// mutex); compiler/ssa contract.xo check_no_alloc checks it on every
// function here. The single threaded paths (alloc, free) make
// their calls last, with nothing live after them, so the arm64 code
// keeps no register across a call.
use native/rt

// The heap record (xo_rt.c struct xo_heap, whose first words these are;
// a _Static_assert there checks the offsets): blocks allocated and
// freed by its thread (the leak check), bytes allocated (resource
// budgets, decision 0175), the bump chunk's next and end addresses, the
// real-time section depth and its allocations (decision 0133), the
// largest block the classes serve, the address of the central lists
// (one word per class), the usable bytes of the block alloc or resize
// returned last (its class's size, or n for a big block: the C reads it for
// a string's capacity, where it called usable before), then per class
// (at h + 8 * c) the free list's head, its length (about: a magazine
// taken counts as full), and the spare full magazine.
const ALLOCS = 0
const FREES = 8
const ABYTES = 16
const BUMP_CUR = 24
const BUMP_END = 32
const RT_DEPTH = 40
const RT_ALLOCS = 48
const MID_MAX = 56
const CENTRAL = 64
const LAST = 72
const FREE_LISTS = 80
const NFREE = 664
/// The classes' words: (NFREE - FREE_LISTS) / 8.
const CLASSES = 73
const MAG = 1248
/// Each class's magazine size (at h + MAG_CAP + 8 * c): the blocks of
/// MAG_BYTES, at least 8 (heapos.xo mag_caps writes them when it makes
/// the record).
const MAG_CAP = 10368
/// Whether the heap counts its allocations and their bytes (ALLOCS,
/// ABYTES): from the record's start, off at the program's start unless
/// XO_LEAKCHECK, XO_HEAPSTATS, or XO_RTSTATS is set (their reports read
/// them) and on again for every record at a budget's first stretch
/// (budget.xo reads ABYTES): heapos.xo counting_off, counting_on
/// (2026-10-16: about 6 instructions an allocation; alloc small 0.979,
/// text split 0.986). FREES is counted under the same switch (2026-10-21:
/// its update was a load and store chain through the heap record on every
/// free, 18% of a 4-byte allocation loop's cycles with NFREE's; on
/// 2026-10-16 guarding it moved the inliner's choices and made maps and
/// mixed slower: measured again across bench/perf).
const COUNT = 1864
/// The heap profile (heapprof.xo, decision 0238): sampled while counting
/// (COUNT) once ABYTES reaches SAMPLE_AT (the largest Int when not
/// profiling), the sampled block kept in PSAMPLE for the hook, which
/// rt.heap_grow calls with SAMPLE added to the size (cabi.xo heap_grow:
/// alloc.xo makes no other platform call). A sampled block of a class has minus
/// its class in its header, so its free goes the way of a big block's
/// (rt.heap_big_release, which tells the two apart).
const SAMPLE_AT = 10344
const PSAMPLE = 10360
const SAMPLE = 4611686018427387904
/// rt.heap_grow's request to scavenge the magazine passed as its heap (cabi.xo
/// heap_grow, decision 0383), the class added. A seed workaround: the seed
/// that builds this runtime knows rt.heap_grow, not a new rt name (a seed
/// bump needs the owner). Replace it with a named intrinsic (rt.heap_scavenge,
/// lowered on the native backends and in wasm's rt2.xo) after the next seed
/// cut, so this flag does not become permanent by accident.
const SCAVENGE = 2305843009213693952

const SMALL_MAX = 1024

/// The lock of each size class's central list (decision 0383): a word of
/// its own, 64 bytes apart (a cache line each), in the central table page
/// from CLOCK, taken as pool.lock takes a word (0 free, 1 held, 2 held and
/// a waiter sleeps); the slow path and the wake ride on rt.heap_grow like
/// SCAVENGE (cabi.xo heap_grow, heapos.xo clock_slow, clock_wake).
const CLOCK = 2048
const LOCK_SLOW = 1152921504606846976
const LOCK_WAKE = 576460752303423488
/// sched.xo TLS_W and layout.xo W_LOCKS: the worker's count of runtime locks
/// held (pool.held), which keeps the preemption from yielding inside one.
const TLS_W = 2
const W_LOCKS = 3464

/// The payload of the first class of the power of two blocks (class 65): a
/// block of these classes is 2^k bytes with its 8 byte class word, so
/// the blocks of a larger class are an exact number of the smaller class's
/// (decision 0383, (a): a magazine can be cut into blocks of a smaller class
/// with nothing left over). Each next class's payload is twice that plus 8.
const BIG_FIRST = 2040
/// The first class (32 KiB) whose blocks on the central lists give their
/// inner pages back to the system (heapos.xo scavenge, decision 0383).
const SCAVENGE_FROM = 69
/// (The 16 KiB class, 68, is a page block class too (decision 0425), so
/// its free blocks could be scavenged whole; scavenging them cost 0.8% of
/// the self build's wall for 0.8 GB of its footprint, 6816 to 6025 MB,
/// 2026-10-30, and the owner's 7 GB goal holds without it.)

/// Magazines a class keeps on the central list with their pages in place.
const SCAVENGE_KEEP = 4
/// The bytes of blocks in a magazine (at least 8 blocks).
const MAG_BYTES = 65536
/// Page blocks (decision 0425): a block of class PAGE_CLASS (16 KiB) or
/// larger is page aligned, carved from a page chunk (heapos.xo pchunk: 4
/// MiB, aligned to its size) with no prefix: its class and its two list
/// links are words of the chunk's table in its first page (PT_CLASS,
/// PT_LINK, PT_CLINK: one word per 16 KiB page of the chunk, indexed by
/// the block's first page), so every page of a free block is given back
/// by heapos.xo scavenge (a prefixed 16 KiB block held one resident page
/// for its 8 byte prefix and its links: 1.7 GB of the self build's
/// footprint, 2026-10-29). A page block's address is a multiple of PAGE
/// and its chunk's first word is PAGE_MAGIC; a big block's address is 16
/// past a page; a prefixed block's is 8 aligned (its stride is size + 8),
/// so one in 2048 of them is page aligned too, and is_page tells it from
/// a page block by its chunk's first word, which holds the first block's
/// class: every chunk is CHUNK aligned (heapos.xo map_aligned) so that
/// word is found from any block (2026-10-30: the address alone crashed
/// the self build). The heap record's PCUR and PEND are its page chunk's
/// bump words, and its
/// PAGES word is nonzero when page blocks are on (heapos.xo pages_on: off
/// in a sanitizer or --race build, whose big blocks come from the C
/// library's malloc and so can be page aligned themselves).
const PAGE = 16384
const PCHUNK = 4194304
const PAGE_CLASS = 68
const PT_CLASS = 0
const PT_LINK = 2048
const PT_CLINK = 4096
/// The first word of a page chunk (its table's unused slot 0); never a
/// block's prefix (a class, minus a class, or a big block's size).
const PAGE_MAGIC = 5784094464206446155
/// A sampled page block's class word carries this bit (heapprof.xo).
const PSAMPLED = 128
const PCUR = 10952
const PEND = 10960
const PAGES = 10968
/// rt.heap_grow(p, PFREED): the heap profile forgets page block p (cabi.xo
/// heap_grow; a prefixed block's sampled free goes through heap_big_release).
const PFREED = 288230376151711744

/// The slot atomics' relaxed order.
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2

/// Takes the lock of class c's central list (the table page cen of heap h).
/// Whether the page aligned p is a page block of heap h: page blocks on and
/// its chunk a page chunk (a prefixed block is page aligned one time in
/// 2048; its chunk's first word is a class). The callers test the
/// alignment inline first, so a prefixed block's free makes no call.
fn is_page(h: Int, p: Int) -> Bool {
  rt.mem_load(h, PAGES, 8) != 0 && rt.mem_load(p & (0).wrapping_sub(PCHUNK), 0, 8) == PAGE_MAGIC
}

/// is_page for the heap profile (heapprof.xo sample), which has the
/// address alone; only with page blocks on (heapos.pages_on).
pub fn page_block(p: Int) -> Bool { (p & 16383) == 0 && rt.mem_load(pbase(p), 0, 8) == PAGE_MAGIC }


fn pbase(p: Int) -> Int { p & (0).wrapping_sub(PCHUNK) }

/// The table word of page block p: its class (PT_CLASS), its free list
/// link (PT_LINK) or its magazine link (PT_CLINK).
fn pword(p: Int, t: Int) -> Int {
  pbase(p).wrapping_add(t).wrapping_add(p.wrapping_sub(pbase(p)).shr_logical(14).wrapping_shl(3))
}

/// The class of page block p, forgetting it in the heap profile when it
/// was sampled.
fn page_class(p: Int) -> Int {
  let w = pword(p, PT_CLASS)
  let c = rt.mem_load(w, 0, 8)
  if c & PSAMPLED != 0 {
    rt.mem_store(w, 0, c & 127, 8)
    let _f = rt.heap_grow(p, PFREED)
  }
  c & 127
}

/// Marks page block p as sampled (heapprof.xo sample).
pub fn page_sample(p: Int) {
  let w = pword(p, PT_CLASS)
  rt.mem_store(w, 0, rt.mem_load(w, 0, 8) | PSAMPLED, 8)
}

/// Whether blocks of n bytes are page blocks (at most the heap's mid_max).
pub fn page_size(n: Int) -> Bool { n > (2048).wrapping_shl(PAGE_CLASS - 66) - 8 }

/// A magazine's link to the next magazine (its first block's second word,
/// or the table's PT_CLINK word for page blocks; heapos.xo nfree).
pub fn cnext(pg: Bool, m: Int) -> Int {
  if pg { rt.mem_load(pword(m, PT_CLINK), 0, 8) } else { rt.mem_load(m, 8, 8) }
}

fn clock(h: Int, cen: Int, c: Int) {
  let l = cen.wrapping_add(CLOCK).wrapping_add(c.wrapping_shl(6))
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    let _s = rt.heap_grow(h, LOCK_SLOW.wrapping_add(c))
  }
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    rt.mem_store(w, W_LOCKS, rt.mem_load(w, W_LOCKS, 8).wrapping_add(1), 8)
  }
}

/// Gives it back, waking a thread that sleeps on it.
fn cunlock(h: Int, cen: Int, c: Int) {
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    rt.mem_store(w, W_LOCKS, rt.mem_load(w, W_LOCKS, 8).wrapping_sub(1), 8)
  }
  let l = cen.wrapping_add(CLOCK).wrapping_add(c.wrapping_shl(6))
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    let _s = rt.heap_grow(h, LOCK_WAKE.wrapping_add(c))
  }
}

/// Counts an allocation made outside the heap (a mapped file, heapos
/// map_file), so XO_LEAKCHECK's allocations match the free that drops it.
pub fn count_outside(h: Int) {
  if rt.mem_load(h, COUNT, 8) != 0 {
    rt.mem_store(h, ALLOCS, rt.mem_load(h, ALLOCS, 8).wrapping_add(1), 8)
  }
}

/// A block of n bytes from heap h (xo_rt.c alloc_in): the head of its
/// class's free list, else carved from the chunk, or a big block above
/// the classes. Counts the allocation, its bytes, and an allocation in a
/// real-time section. A chunk that runs out is replaced by rt.heap_grow,
/// which calls this again.
pub fn alloc(h: Int, n: Int) -> Int {
  if n > rt.mem_load(h, MID_MAX, 8) {
    if rt.mem_load(h, COUNT, 8) != 0 {
      rt.mem_store(h, ALLOCS, rt.mem_load(h, ALLOCS, 8).wrapping_add(1), 8)
      rt.mem_store(h, ABYTES, rt.mem_load(h, ABYTES, 8).wrapping_add(n), 8)
    }
    if rt.mem_load(h, RT_DEPTH, 8) != 0 {
      rt.mem_store(h, RT_ALLOCS, rt.mem_load(h, RT_ALLOCS, 8).wrapping_add(1), 8)
    }
    rt.mem_store(h, LAST, n, 8)
    return rt.heap_big(n)
  }
  // the size class (size_class)
  var c = 65
  var size = BIG_FIRST
  if n <= SMALL_MAX {
    c = n.wrapping_add(15).shr_logical(4)
    if c == 0 {
      c = 1
    }
    size = c.wrapping_shl(4)
  } else {
    while size < n {
      size = size.wrapping_shl(1).wrapping_add(8)
      c = c.wrapping_add(1)
    }
  }
  // the class's words are at fl + FREE_LISTS, fl + NFREE, fl + MAG
  let fl = h.wrapping_add(c.wrapping_shl(3))
  var r = rt.mem_load(fl, FREE_LISTS, 8)
  if r == 0 && rt.mem_load(h, CENTRAL, 8) != 0 {
    // the class's list is empty: a magazine of blocks other threads freed
    // first, when the heap's spare or the central list has one (read
    // without the lock), taken out of line and the allocation done again
    // (refill_alloc, a call in tail position: decision 0207's amendment);
    // else the bump below. One size class computation an allocation on
    // these paths, and no refill call while the list has blocks
    // (2026-10-17: halloc called refill before every allocation)
    if rt.mem_load(fl, MAG, 8) != 0 || rt.slot_load(rt.mem_load(h, CENTRAL, 8), c, RELAXED) != 0 {
      return refill_alloc(h, n, c, size)
    }
  }
  if r != 0 {
    var next = rt.mem_load(r, 0, 8)
    if c >= PAGE_CLASS && rt.mem_load(h, PAGES, 8) != 0 {
      // a page block's link is in its chunk's table (pword written out)
      let base = r & (0).wrapping_sub(PCHUNK)
      next = rt.mem_load(base.wrapping_add(PT_LINK).wrapping_add(r.wrapping_sub(base).shr_logical(14).wrapping_shl(3)), 0, 8)
    }
    rt.mem_store(fl, FREE_LISTS, next, 8)
    rt.mem_store(fl, NFREE, rt.mem_load(fl, NFREE, 8).wrapping_sub(1), 8)
    // the next pop reads the new head's link: start loading it now, so a
    // list freed long ago (cold) costs overlapped misses rather than one
    // stall per allocation (bench/results/xo1-speed-2026-10-13.md)
    rt.prefetch(next)
  } else if c >= PAGE_CLASS && rt.mem_load(h, PAGES, 8) != 0 {
    // a page block from the heap's page chunk (size + 8 is a power of two
    // of whole pages); the table word of its first page is its class
    let need = size.wrapping_add(8)
    let cur = rt.mem_load(h, PCUR, 8)
    if rt.mem_load(h, PEND, 8).wrapping_sub(cur) < need {
      return rt.heap_grow(h, n)
    }
    rt.mem_store(h, PCUR, cur.wrapping_add(need), 8)
    let base = cur & (0).wrapping_sub(PCHUNK)
    rt.mem_store(base.wrapping_add(cur.wrapping_sub(base).shr_logical(14).wrapping_shl(3)), 0, c, 8)
    r = cur
  } else {
    let need = size.wrapping_add(8)
    let cur = rt.mem_load(h, BUMP_CUR, 8)
    if rt.mem_load(h, BUMP_END, 8).wrapping_sub(cur) < need {
      return rt.heap_grow(h, n)
    }
    rt.mem_store(h, BUMP_CUR, cur.wrapping_add(need), 8)
    rt.mem_store(cur, 0, c, 8)
    r = cur.wrapping_add(8)
  }
  rt.mem_store(h, LAST, size, 8)
  if rt.mem_load(h, RT_DEPTH, 8) != 0 {
    rt.mem_store(h, RT_ALLOCS, rt.mem_load(h, RT_ALLOCS, 8).wrapping_add(1), 8)
  }
  if rt.mem_load(h, COUNT, 8) != 0 {
    rt.mem_store(h, ALLOCS, rt.mem_load(h, ALLOCS, 8).wrapping_add(1), 8)
    let ab = rt.mem_load(h, ABYTES, 8).wrapping_add(n)
    rt.mem_store(h, ABYTES, ab, 8)
    if ab >= rt.mem_load(h, SAMPLE_AT, 8) {
      // the heap profile's next sample (heapprof.xo, cabi.xo heap_grow)
      rt.mem_store(h, PSAMPLE, r, 8)
      return rt.heap_grow(h, n.wrapping_add(SAMPLE))
    }
  }
  r
}

/// alloc's magazine take (decision 0207's amendment: a function of this
/// module may call another, which keeps the same rule): the heap's spare
/// magazine for class c (blocks of size bytes), else one from the central
/// list, becomes the class's free list, and the allocation of n bytes is
/// done again. Out of line so alloc's fast paths keep
/// their registers (x86-64 has 8 caller saved ones to arm64's 18).
fn refill_alloc(h: Int, n: Int, c: Int, size: Int) -> Int {
  let fl = h.wrapping_add(c.wrapping_shl(3))
  var m = rt.mem_load(fl, MAG, 8)
  if m != 0 {
    rt.mem_store(fl, MAG, 0, 8)
  } else {
    // central_take: a magazine is linked by its first block's second word
    let cen = rt.mem_load(h, CENTRAL, 8)
    clock(h, cen, c)
    m = rt.slot_load(cen, c, RELAXED)
    if m != 0 {
      rt.slot_store(cen, c, if c >= PAGE_CLASS && rt.mem_load(h, PAGES, 8) != 0 { rt.mem_load(pword(m, PT_CLINK), 0, 8) } else { rt.mem_load(m, 8, 8) }, RELAXED)
    }
    cunlock(h, cen, c)
  }
  if m != 0 {
    rt.mem_store(fl, FREE_LISTS, m, 8)
    rt.mem_store(fl, NFREE, mag_count(size), 8)
  }
  // again: from the magazine, or, when another thread took the central
  // one first (the slot read 0 under the lock), from the bump
  alloc(h, n)
}

/// alloc's common case with one thread: a block of n bytes (at most
/// SMALL_MAX) popped from its class's free list; else 0, and the caller
/// calls alloc (the chunk's bump, a new chunk, a magazine, a real-time
/// section, counting, the heap profile's next sample). It makes no call
/// and reads no counter, so it is a leaf of under 40 instructions that
/// the inliner takes at every call site, and a caller keeps its values
/// in registers with no frame on this path (obj.xo try_new,
/// bench/results/string-list-objects-2026-10-14.md). 2026-10-21: with
/// the bump and the counting in it, it was 76 instructions and a call
/// from obj.try_new, rl_new_n and rs_new_n on every allocation. The
/// single threaded heap's (obj.xo HEAP): alloc_pop without the list's
/// length, which only the magazines of a program with threads read
/// (free_push, free_mt); recount sets it when threads start; and without
/// LAST, whose reload right after was a store to load wait: a caller that
/// needs the block's size computes it (obj.xo class_size) (2026-10-21:
/// its update was a load and store chain through the heap record on every
/// allocation and free, with FREES 18% of a 4-byte allocation loop's
/// cycles).
pub fn alloc_fast(h: Int, n: Int) -> Int {
  if (rt.mem_load(h, RT_DEPTH, 8) | rt.mem_load(h, COUNT, 8)) != 0 {
    return 0
  }
  var c = n.wrapping_add(15).shr_logical(4)
  if c == 0 {
    c = 1
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  let r = rt.mem_load(fl, FREE_LISTS, 8)
  if r == 0 {
    return 0
  }
  let next = rt.mem_load(r, 0, 8)
  rt.mem_store(fl, FREE_LISTS, next, 8)
  rt.prefetch(next)
  r
}

/// A block of n bytes (at most SMALL_MAX) popped from its class's free
/// list on heap h (the calling thread's when others run: 2026-10-19, the
/// plain HTTP server, which has threads, took obj.halloc and alloc for
/// all 34 allocations a request); else 0, and the caller calls alloc,
/// which takes back a magazine of blocks other threads freed before
/// carving from the chunk, and counts (alloc_fast).
pub fn alloc_pop(h: Int, n: Int) -> Int {
  // a real-time section or counting: 0, for the caller's alloc
  // (alloc_fast; at 61 instructions it was a call from obj.try_pop,
  // rs_new_mt, and tlssrv.send)
  if (rt.mem_load(h, RT_DEPTH, 8) | rt.mem_load(h, COUNT, 8)) != 0 {
    return 0
  }
  var c = n.wrapping_add(15).shr_logical(4)
  if c == 0 {
    c = 1
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  let r = rt.mem_load(fl, FREE_LISTS, 8)
  if r == 0 {
    return 0
  }
  let next = rt.mem_load(r, 0, 8)
  rt.mem_store(fl, FREE_LISTS, next, 8)
  rt.mem_store(fl, NFREE, rt.mem_load(fl, NFREE, 8).wrapping_sub(1), 8)
  rt.prefetch(next)
  rt.mem_store(h, LAST, c.wrapping_shl(4), 8)
  r
}

/// Gives back block p to the single threaded heap h (xo_rt.c free_in):
/// onto its class's free list, or to heapos.xo for a big block. Counts the
/// free when counting; leaves the list's length (alloc_fast, recount).
pub fn free(h: Int, p: Int) {
  if rt.mem_load(h, COUNT, 8) != 0 {
    rt.mem_store(h, FREES, rt.mem_load(h, FREES, 8).wrapping_add(1), 8)
  }
  if (p & 16383) == 0 {
    // a page block, or a prefixed block that is page aligned (one in
    // 2048): out of line, a tail call, so this function stays a leaf
    return free_aligned(h, p)
  }
  let b = p.wrapping_sub(8)
  let c = rt.mem_load(b, 0, 8)
  if c < 0 {
    rt.heap_big_release(b)
    return
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  rt.mem_store(p, 0, rt.mem_load(fl, FREE_LISTS, 8), 8)
  rt.mem_store(fl, FREE_LISTS, p, 8)
}

/// free of a page aligned block: a page block (decision 0425: its class
/// and link in its chunk's table), else free's prefixed path.
fn free_aligned(h: Int, p: Int) {
  if is_page(h, p) {
    let c = page_class(p)
    let fl = h.wrapping_add(c.wrapping_shl(3))
    rt.mem_store(pword(p, PT_LINK), 0, rt.mem_load(fl, FREE_LISTS, 8), 8)
    rt.mem_store(fl, FREE_LISTS, p, 8)
    return
  }
  let b = p.wrapping_sub(8)
  let c = rt.mem_load(b, 0, 8)
  if c < 0 {
    rt.heap_big_release(b)
    return
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  rt.mem_store(p, 0, rt.mem_load(fl, FREE_LISTS, 8), 8)
  rt.mem_store(fl, FREE_LISTS, p, 8)
}

/// Sets each class's list length of heap h from its list (the single
/// threaded heap's, which alloc_fast and free leave, when threads start:
/// obj.xo heap_init), once.
pub fn recount(h: Int) {
  var c = 1
  while c < CLASSES {
    let fl = h.wrapping_add(c.wrapping_shl(3))
    var n = 0
    var p = rt.mem_load(fl, FREE_LISTS, 8)
    while p != 0 {
      n = n.wrapping_add(1)
      p = if c >= PAGE_CLASS && rt.mem_load(h, PAGES, 8) != 0 { rt.mem_load(pword(p, PT_LINK), 0, 8) } else { rt.mem_load(p, 0, 8) }
    }
    rt.mem_store(fl, NFREE, n, 8)
    c = c.wrapping_add(1)
  }
}

/// Before an allocation of n bytes on a heap of a program with threads
/// (xo_rt.c alloc_mt): when the class's free list is empty, it takes the
/// heap's spare magazine, else one from the central list, so blocks
/// other threads freed come back (decision 0118).
pub fn refill(h: Int, n: Int) {
  if n > rt.mem_load(h, MID_MAX, 8) {
    return
  }
  var c = 65
  var size = BIG_FIRST
  if n <= SMALL_MAX {
    c = n.wrapping_add(15).shr_logical(4)
    if c == 0 {
      c = 1
    }
    size = c.wrapping_shl(4)
  } else {
    while size < n {
      size = size.wrapping_shl(1).wrapping_add(8)
      c = c.wrapping_add(1)
    }
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  if rt.mem_load(fl, FREE_LISTS, 8) != 0 {
    return
  }
  var m = rt.mem_load(fl, MAG, 8)
  if m != 0 {
    rt.mem_store(fl, MAG, 0, 8)
  } else {
    // central_take: a magazine is linked by its first block's second word
    let cen = rt.mem_load(h, CENTRAL, 8)
    if rt.slot_load(cen, c, RELAXED) == 0 {
      return
    }
    clock(h, cen, c)
    m = rt.slot_load(cen, c, RELAXED)
    if m != 0 {
      rt.slot_store(cen, c, if c >= PAGE_CLASS && rt.mem_load(h, PAGES, 8) != 0 { rt.mem_load(pword(m, PT_CLINK), 0, 8) } else { rt.mem_load(m, 8, 8) }, RELAXED)
    }
    cunlock(h, cen, c)
    if m == 0 {
      return
    }
  }
  rt.mem_store(fl, FREE_LISTS, m, 8)
  rt.mem_store(fl, NFREE, mag_count(size), 8)
}

/// The blocks of a full magazine of size byte blocks: MAG_BYTES / size,
/// at least 8 (by long division: no `/`, which can fault). A call
/// (ssa.cold_fn): inlined into alloc through refill_alloc, LLVM's -O3
/// hoisted its 13 unrolled steps above the free list test, about 80
/// instructions on every allocation (strings +15%, 2026-10-21).
fn mag_count(size: Int) -> Int {
  var q = 0
  var rem = MAG_BYTES
  var k = 12
  while k >= 0 {
    let d = size.wrapping_shl(k)
    if d <= rem {
      rem = rem.wrapping_sub(d)
      q = q | (1).wrapping_shl(k)
    }
    k = k.wrapping_sub(1)
  }
  if q < 8 {
    q = 8
  }
  q
}

/// free_mt's common case, a leaf small enough for the inliner at every
/// call site: block p of a class onto its class's list on heap h when
/// the list stays under a magazine's worth, counted; true when done.
/// Else false, having done nothing, and the caller calls free_mt (a big
/// block, a page aligned one, a list that fills a magazine). 2026-10-21: free_mt, at 58
/// instructions with its calls, was a call on every free in a program
/// with threads.
pub fn free_push(h: Int, p: Int) -> Bool {
  // a page aligned block (a page block, decision 0425, or the one
  // prefixed block in 2048 that is) and a big block (a negative header;
  // only a block with a prefix has its header read) take free_mt, which
  // tells them apart: a call out of this function to a page block path
  // put it over the inliner's limits (42 instructions, 13 blocks of 40
  // and 12) and left it a call in obj.rl_free_n_slow, 14 instructions a
  // free in the alloc bench's tasks (2026-10-30)
  if (p & 16383) == 0 || rt.mem_load(p.wrapping_sub(8), 0, 8) < 0 {
    return false
  }
  let c = rt.mem_load(p.wrapping_sub(8), 0, 8)
  let fl = h.wrapping_add(c.wrapping_shl(3))
  let nf = rt.mem_load(fl, NFREE, 8).wrapping_add(1)
  if nf >= rt.mem_load(fl, MAG_CAP, 8) {
    return false
  }
  // counted when counting: COUNT is 0 or 1 (heapos.xo), added without a
  // branch, which keeps this function within the inliner's 12 blocks
  // (every `if` is three blocks; a fourth put it at 13)
  rt.mem_store(h, FREES, rt.mem_load(h, FREES, 8).wrapping_add(rt.mem_load(h, COUNT, 8)), 8)
  rt.mem_store(p, 0, rt.mem_load(fl, FREE_LISTS, 8), 8)
  rt.mem_store(fl, FREE_LISTS, p, 8)
  rt.mem_store(fl, NFREE, nf, 8)
  true
}

/// Gives back block p to heap h in a program with threads (xo_rt.c
/// free_mt): as free, then a class's list that reached a magazine's
/// size becomes the heap's spare magazine, and the spare it replaces
/// goes to the central list.
pub fn free_mt(h: Int, p: Int) {
  if rt.mem_load(h, COUNT, 8) != 0 {
    rt.mem_store(h, FREES, rt.mem_load(h, FREES, 8).wrapping_add(1), 8)
  }
  var c = 0
  var pg = false
  if (p & 16383) == 0 && is_page(h, p) {
    // a page block (decision 0425): its class and links in its chunk's table
    pg = true
    c = page_class(p)
  } else {
    let b = p.wrapping_sub(8)
    c = rt.mem_load(b, 0, 8)
    if c < 0 {
      rt.heap_big_release(b)
      return
    }
  }
  let fl = h.wrapping_add(c.wrapping_shl(3))
  if pg {
    rt.mem_store(pword(p, PT_LINK), 0, rt.mem_load(fl, FREE_LISTS, 8), 8)
  } else {
    rt.mem_store(p, 0, rt.mem_load(fl, FREE_LISTS, 8), 8)
  }
  rt.mem_store(fl, FREE_LISTS, p, 8)
  let nf = rt.mem_load(fl, NFREE, 8).wrapping_add(1)
  rt.mem_store(fl, NFREE, nf, 8)
  // a magazine's worth (max(MAG_BYTES / size, 8), MAG_CAP)
  if nf < rt.mem_load(fl, MAG_CAP, 8) {
    return
  }
  let old = rt.mem_load(fl, MAG, 8)
  if old != 0 {
    // blocks of 32 KiB and over give their inner pages back before they
    // wait on the central list (decision 0383)
    // central_put
    let cen = rt.mem_load(h, CENTRAL, 8)
    // only once the class's central list already holds SCAVENGE_KEEP
    // magazines, counted under the lock (another thread may take a
    // magazine and reuse its first block, so the links are read only
    // while it is held), so a short program that frees a few big blocks
    // never pays the system calls; the scavenge itself runs outside the
    // lock and before old is linked, while this thread alone holds it
    if c >= SCAVENGE_FROM {
      var k = 0
      clock(h, cen, c)
      var w = rt.slot_load(cen, c, RELAXED)
      while w != 0 && k < SCAVENGE_KEEP {
        w = rt.mem_load(pword(w, PT_CLINK), 0, 8)
        k = k.wrapping_add(1)
      }
      cunlock(h, cen, c)
      if k >= SCAVENGE_KEEP {
        let _g = rt.heap_grow(old, SCAVENGE.wrapping_add(c))
      }
    }
    clock(h, cen, c)
    if pg {
      rt.mem_store(pword(old, PT_CLINK), 0, rt.slot_load(cen, c, RELAXED), 8)
    } else {
      rt.mem_store(old, 8, rt.slot_load(cen, c, RELAXED), 8)
    }
    rt.slot_store(cen, c, old, RELAXED)
    cunlock(h, cen, c)
  }
  rt.mem_store(fl, MAG, rt.mem_load(fl, FREE_LISTS, 8), 8)
  rt.mem_store(fl, FREE_LISTS, 0, 8)
  rt.mem_store(fl, NFREE, 0, 8)
}

/// Resizes block p of old bytes to n bytes (xo_rt.c xo_resize): a block
/// that stays big is resized by heapos.xo (its growth
/// counted for budgets), a block whose class also serves n is kept, and
/// a block of a class moves to one of n's class when that class has a
/// free block or the chunk has room (copied, then p freed: alloc's and
/// free's single threaded paths, written out here because this module
/// calls no functions). The new address, or 0 when the caller must move
/// it (xo_alloc, copy, xo_free: a program with threads, mt not 0, or a
/// block from or to a big one, or a chunk to replace). A block it returns
/// sets LAST.
pub fn resize(h: Int, p: Int, old: Int, n: Int, mt: Int) -> Int {
  if (p & 16383) == 0 {
    // a page block, or a prefixed block that is page aligned: out of
    // line, a tail call, so this function stays a leaf and inlines into
    // obj.hresize as before (decision 0425)
    return resize_aligned(h, p, old, n, mt)
  }
  let mid = rt.mem_load(h, MID_MAX, 8)
  let b = p.wrapping_sub(8)
  let hdr = rt.mem_load(b, 0, 8)
  // a big block (minus its size, at least the classes' limit); a size
  // class's sampled block (minus its class, heapprof.xo) moves
  if hdr < -128 && n > mid {
    if n > old {
      if rt.mem_load(h, COUNT, 8) != 0 {
        rt.mem_store(h, ABYTES, rt.mem_load(h, ABYTES, 8).wrapping_add(n.wrapping_sub(old)), 8)
      }
    }
    rt.mem_store(h, LAST, n, 8)
    return rt.heap_big_resize(b, n)
  }
  if hdr <= 0 || n > mid {
    return 0
  }
  var c = 65
  var size = BIG_FIRST
  if n <= SMALL_MAX {
    c = n.wrapping_add(15).shr_logical(4)
    if c == 0 {
      c = 1
    }
    size = c.wrapping_shl(4)
  } else {
    while size < n {
      size = size.wrapping_shl(1).wrapping_add(8)
      c = c.wrapping_add(1)
    }
  }
  if c == hdr {
    rt.mem_store(h, LAST, size, 8)
    return p
  }
  if mt != 0 {
    return 0
  }
  if c >= PAGE_CLASS && rt.mem_load(h, PAGES, 8) != 0 {
    // into a page class: the caller moves it (a page block must be page aligned)
    return 0
  }
  // alloc's pop or carve
  let fl = h.wrapping_add(c.wrapping_shl(3))
  var q = rt.mem_load(fl, FREE_LISTS, 8)
  if q != 0 {
    let next = rt.mem_load(q, 0, 8)
    rt.mem_store(fl, FREE_LISTS, next, 8)
    rt.mem_store(fl, NFREE, rt.mem_load(fl, NFREE, 8).wrapping_sub(1), 8)
    rt.prefetch(next)
  } else {
    let need = size.wrapping_add(8)
    let cur = rt.mem_load(h, BUMP_CUR, 8)
    if rt.mem_load(h, BUMP_END, 8).wrapping_sub(cur) < need {
      return 0
    }
    rt.mem_store(h, BUMP_CUR, cur.wrapping_add(need), 8)
    rt.mem_store(cur, 0, c, 8)
    q = cur.wrapping_add(8)
  }
  var due = false
  if rt.mem_load(h, COUNT, 8) != 0 {
    rt.mem_store(h, ALLOCS, rt.mem_load(h, ALLOCS, 8).wrapping_add(1), 8)
    let ab = rt.mem_load(h, ABYTES, 8).wrapping_add(n)
    rt.mem_store(h, ABYTES, ab, 8)
    due = ab >= rt.mem_load(h, SAMPLE_AT, 8)
  }
  if rt.mem_load(h, RT_DEPTH, 8) != 0 {
    rt.mem_store(h, RT_ALLOCS, rt.mem_load(h, RT_ALLOCS, 8).wrapping_add(1), 8)
  }
  rt.mem_store(h, LAST, size, 8)
  rt.mem_copy(q, p, if old < n { old } else { n })
  // free's push of p
  if rt.mem_load(h, COUNT, 8) != 0 {
    rt.mem_store(h, FREES, rt.mem_load(h, FREES, 8).wrapping_add(1), 8)
  }
  let pl = h.wrapping_add(hdr.wrapping_shl(3))
  rt.mem_store(p, 0, rt.mem_load(pl, FREE_LISTS, 8), 8)
  rt.mem_store(pl, FREE_LISTS, p, 8)
  rt.mem_store(pl, NFREE, rt.mem_load(pl, NFREE, 8).wrapping_add(1), 8)
  if due {
    rt.mem_store(h, PSAMPLE, q, 8)
    return rt.heap_grow(h, n.wrapping_add(SAMPLE))
  }
  q
}

/// resize of a page aligned block (resize's tail call): a page block (no
/// prefix) is kept when its class serves n, else moved by the caller. A
/// prefixed block that is page aligned (one in 2048) is moved by the
/// caller too, so resize's prefixed path has one site and inlines.
fn resize_aligned(h: Int, p: Int, old: Int, n: Int, mt: Int) -> Int {
  if !is_page(h, p) {
    return 0
  }
  if n > rt.mem_load(h, MID_MAX, 8) {
    return 0
  }
  var pc = 65
  var psize = BIG_FIRST
  while psize < n {
    psize = psize.wrapping_shl(1).wrapping_add(8)
    pc = pc.wrapping_add(1)
  }
  if pc == (rt.mem_load(pword(p, PT_CLASS), 0, 8) & 127) {
    rt.mem_store(h, LAST, psize, 8)
    return p
  }
  0
}
