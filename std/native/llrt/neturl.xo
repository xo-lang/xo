// net/url's parsing in Xo (the URL parser of std/http's server and
// client, moved out of http1.xo on 2026-10-15 so x509.xo can parse a
// certificate's URI names as Go's url.Parse without importing the HTTP
// stack): unescaping, ports, IPv4 and IPv6 literals, hosts, and Parse
// and ParseRequestURI with Go's error texts.
use native/llrt/http1_tables
use native/llrt/raw as rawb
use native/llrt/scan
use native/rt

// The byte classes (http1_tables.CLASS) this file reads.
const HOSTB: Int = 4
const HEX: Int = 8
const USERINFO: Int = 16

fn cls(c: Int) -> Int { Int(http1_tables.CLASS[c & 255]) }

fn unhex(c: Int) -> Int { if c <= 57 { c - 48 } else { (c | 32) - 87 } }

fn lower(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// The index of the first byte c of s in [from, to), or -1 (from and to
/// clamped to s): one scan of the range, where rt.str_find searched on
/// to the end of the string.
fn find(s: Str, c: Int, from: Int, to: Int) -> Int {
  let b = s.bytes()
  let f = if from < 0 { 0 } else { from }
  let t = if to > b.len() { b.len() } else { to }
  if f >= t {
    return -1
  }
  scan.find_byte(b, f, t, c)
}

/// The index of the last byte c of b in [0, to), or -1.
fn rfind(b: Bytes, c: Int, to: Int) -> Int {
  var i = to - 1
  while i >= 0 {
    if Int(b[i]) == c {
      return i
    }
    i -= 1
  }
  -1
}

/// The `"%s"` of a C format: the text in quotes as it is (xo_http.c's
/// snprintf; the bytes are printable here: control bytes failed first).
fn go_quote_c(s: Str) -> Str { "\"" + s + "\"" }

// h_unescape's modes
pub const U_PATH: Int = 0
pub const U_QUERY: Int = 1
pub const U_HOST: Int = 2

/// The end of the bytes of b from lo that unescape keeps as they are.
fn plain_end(b: Bytes, lo: Int, hi: Int, mode: Int) -> Int {
  var i = lo
  while i < hi {
    let c = Int(b[i])
    if c == 37 || (c == 43 && mode == U_QUERY) || (mode == U_HOST && c < 128 && (cls(c) & HOSTB) == 0) {
      return i
    }
    i += 1
  }
  hi
}

/// url.unescape of b[lo..hi] for a path, a query component, or a host:
/// (false, _) on an invalid escape.
pub fn unescape(b: Bytes, s: Str, lo: Int, hi: Int, mode: Int) -> (Bool, Str) {
  // the common case: nothing to change
  var i = plain_end(b, lo, hi, mode)
  if i == hi {
    return (true, rawb.str_slice(s, lo, hi))
  }
  // runs of 8 bytes or more go over at once, other bytes seven at a time
  // in a word (a C call each)
  var out = rt.rs_append_bytes(rt.rs_with_cap(hi - lo), b, lo, i, 0)
  var w = 0
  var wk = 0
  while i < hi {
    let c = Int(b[i])
    var x = c
    if c == 37 {
      if i + 2 >= hi || (cls(Int(b[i + 1])) & HEX) == 0 || (cls(Int(b[i + 2])) & HEX) == 0 {
        return (false, "")
      }
      let h = unhex(Int(b[i + 1]))
      // %25 is the one escape of an ASCII byte a host may have
      let pct = b[i + 1] == 50 && b[i + 2] == 53
      if mode == U_HOST && h < 8 && !pct {
        return (false, "")
      }
      x = (h << 4) | unhex(Int(b[i + 2]))
      i += 3
    } else if c == 43 && mode == U_QUERY {
      x = 32
      i += 1
    } else if mode == U_HOST && c < 128 && (cls(c) & HOSTB) == 0 {
      return (false, "")
    } else {
      let j = plain_end(b, i, hi, mode)
      if j - i >= 8 {
        if wk > 0 {
          out = rt.rs_push_word(out, w, wk)
          w = 0
          wk = 0
        }
        out = rt.rs_append_bytes(out, b, i, j, 0)
        i = j
        continue
      }
      i += 1
    }
    w = w | ((x & 255) << ((8 * wk) & 63))
    wk += 1
    if wk == 7 {
      out = rt.rs_push_word(out, w, 7)
      w = 0
      wk = 0
    }
  }
  if wk > 0 {
    out = rt.rs_push_word(out, w, wk)
  }
  (true, out)
}

/// Whether b[lo..hi] is empty or `:` and digits.
pub fn valid_port(b: Bytes, lo: Int, hi: Int) -> Bool {
  if lo >= hi {
    return true
  }
  if b[lo] != 58 {
    return false
  }
  var i = lo + 1
  while i < hi {
    if b[i] < 48 || b[i] > 57 {
      return false
    }
    i += 1
  }
  true
}

/// inet_pton(AF_INET, ...) of b[lo..hi] (BIND's inet_pton4: four
/// decimal octets without leading zeros).
fn ipv4_ok(b: Bytes, lo: Int, hi: Int) -> Bool {
  var saw = false
  var octets = 0
  var cur = 0
  var i = lo
  while i < hi {
    let c = Int(b[i])
    if c >= 48 && c <= 57 {
      let v = cur * 10 + (c - 48)
      if saw && cur == 0 {
        return false
      }
      if v > 255 {
        return false
      }
      cur = v
      if !saw {
        octets += 1
        if octets > 4 {
          return false
        }
        saw = true
      }
    } else if c == 46 && saw {
      if octets == 4 {
        return false
      }
      cur = 0
      saw = false
    } else {
      return false
    }
    i += 1
  }
  octets >= 4
}

/// inet_pton(AF_INET6, ...) of b[lo..hi] (BIND's inet_pton6, which
/// xo_http.c called): hex groups of at most 4 digits, one `::`, a dotted
/// IPv4 address at the end.
fn ipv6_ok(b: Bytes, lo0: Int, hi: Int) -> Bool {
  var lo = lo0
  if lo < hi && b[lo] == 58 {
    lo += 1
    if lo >= hi || b[lo] != 58 {
      return false
    }
  }
  var tp = 0
  var colon = -1
  var cur = lo
  var digits = 0
  var i = lo
  while i < hi {
    let c = lower(Int(b[i]))
    i += 1
    if (c >= 48 && c <= 57) || (c >= 97 && c <= 102) {
      digits += 1
      if digits > 4 {
        return false
      }
      continue
    }
    if c == 58 {
      cur = i
      if digits == 0 {
        if colon >= 0 {
          return false
        }
        colon = tp
        continue
      } else if i >= hi {
        return false
      }
      if tp + 2 > 16 {
        return false
      }
      tp += 2
      digits = 0
      continue
    }
    if c == 46 && tp + 4 <= 16 && ipv4_ok(b, cur, hi) {
      tp += 4
      digits = 0
      i = hi
      break
    }
    return false
  }
  if digits > 0 {
    if tp + 2 > 16 {
      return false
    }
    tp += 2
  }
  if colon >= 0 {
    if tp == 16 {
      return false
    }
    tp = 16
  }
  tp == 16
}

/// url.parseHost of b[lo..hi]: the host unescaped, or (false, _).
fn parse_host(b: Bytes, s: Str, lo: Int, hi: Int) -> (Bool, Str) {
  var ob = -1
  var i = hi - 1
  while i >= lo {
    if b[i] == 91 {
      ob = i
      break
    }
    i -= 1
  }
  if ob > lo {
    return (false, "")
  }
  if ob == lo {
    var cb = -1
    var j = hi - 1
    while j >= lo {
      if b[j] == 93 {
        cb = j
        break
      }
      j -= 1
    }
    if cb < 0 || !valid_port(b, cb + 1, hi) {
      return (false, "")
    }
    let (ok, inner) = unescape(b, s, lo + 1, cb, U_HOST)
    if !ok {
      return (false, "")
    }
    let ib = inner.bytes()
    // the zone goes; inet_pton reads to the first NUL byte
    var zn = 0
    while zn < ib.len() && ib[zn] != 37 && ib[zn] != 0 {
      zn += 1
    }
    if !ipv6_ok(ib, 0, zn) {
      return (false, "")
    }
    return unescape(b, s, lo, hi, U_HOST)
  }
  let colon = find(s, 58, lo, hi)
  if colon >= 0 {
    if rfind(b, 58, hi) != colon {
      // strict colons (Go 1.26): only one colon outside brackets
      return (false, "")
    }
    if !valid_port(b, colon, hi) {
      return (false, "")
    }
  }
  unescape(b, s, lo, hi, U_HOST)
}

/// The error text of a bad escape in b[lo..hi] (url.EscapeError).
pub fn escape_error(b: Bytes, s: Str, lo: Int, hi: Int) -> Str {
  var i = lo
  while i < hi {
    if b[i] == 37 {
      let left = hi - i
      if left < 3 || (cls(Int(b[i + 1])) & HEX) == 0 || (cls(Int(b[i + 2])) & HEX) == 0 {
        let k = if left < 3 { left } else { 3 }
        return "invalid URL escape " + go_quote(rawb.str_slice(s, i, i + k))
      }
      i += 3
      continue
    }
    i += 1
  }
  "invalid URL"
}

/// A parsed URL (xo_http.c's hurl).
pub struct Url {
  pub ok: Bool
  /// Go's reason when it failed (without `parse "url": `).
  pub err: Str
  pub scheme: Str
  pub host: Str
  pub path: Str
  pub rawquery: Str
}

pub fn url_fail(err: Str) -> Url { Url{ok: false, err: err, scheme: "", host: "", path: "", rawquery: ""} }

/// net/url's parse of s: ParseRequestURI when via_request, else Parse
/// (the fragment already cut).
pub fn url_parse(s: Str, via_request: Bool) -> Url {
  let b = s.bytes()
  let sn = b.len()
  var i = 0
  while i < sn {
    let c = Int(b[i])
    if c < 32 || c == 127 {
      return url_fail("net/url: invalid control character in URL")
    }
    i += 1
  }
  if sn == 0 && via_request {
    return url_fail("empty url")
  }
  if sn == 1 && b[0] == 42 {
    return Url{ok: true, err: "", scheme: "", host: "", path: "*", rawquery: ""}
  }
  // getScheme
  var rest = 0
  var scheme = ""
  i = 0
  while i < sn {
    let c = Int(b[i])
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
      i += 1
      continue
    }
    if (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46 {
      if i == 0 {
        break
      }
      i += 1
      continue
    }
    if c == 58 {
      if i == 0 {
        return url_fail("missing protocol scheme")
      }
      scheme = rt.rs_append_bytes("", b, 0, i, 1)
      rest = i + 1
    }
    break
  }
  // the query: a single trailing ? is ForceQuery with no RawQuery
  var rn = sn
  var q = -1
  var qcount = 0
  i = rest
  while i < sn {
    if b[i] == 63 {
      if q < 0 {
        q = i
      }
      qcount += 1
    }
    i += 1
  }
  var rawquery = ""
  if rn > rest && b[rn - 1] == 63 && qcount == 1 {
    rn -= 1
  } else if q >= 0 {
    rawquery = rawb.str_slice(s, q + 1, rn)
    rn = q
  }
  if !(rn > rest && b[rest] == 47) {
    if !scheme.is_empty() {
      // opaque: no host, no path
      return Url{ok: true, err: "", scheme: scheme, host: "", path: "", rawquery: rawquery}
    }
    if via_request {
      return url_fail("invalid URI for request")
    }
    let sl = find(s, 47, rest, rn)
    let segn = if sl < 0 { rn } else { sl }
    if find(s, 58, rest, segn) >= 0 {
      return url_fail("first path segment in URL cannot contain colon")
    }
  }
  var host = ""
  var p = rest
  let authority = rn - rest >= 2 && b[rest] == 47 && b[rest + 1] == 47 && (!scheme.is_empty() || (!via_request && !(rn - rest >= 3 && b[rest + 2] == 47)))
  if authority {
    let a = rest + 2
    let slash = find(s, 47, a, rn)
    let ae = if slash < 0 { rn } else { slash }
    p = ae
    var at = -1
    var k = ae - 1
    while k >= a {
      if b[k] == 64 {
        at = k
        break
      }
      k -= 1
    }
    let hlo = if at >= 0 { at + 1 } else { a }
    let (hok, h) = parse_host(b, s, hlo, ae)
    if !hok {
      let shown = if ae - hlo > 120 { hlo + 120 } else { ae }
      return url_fail("invalid host " + go_quote_c(rawb.str_slice(s, hlo, shown)))
    }
    host = h
    if at >= 0 {
      var u = a
      while u < at {
        if (cls(Int(b[u])) & USERINFO) == 0 {
          return url_fail("net/url: invalid userinfo")
        }
        u += 1
      }
      u = a
      while u < at {
        if b[u] == 37 {
          let left = at - u
          if left < 3 || (cls(Int(b[u + 1])) & HEX) == 0 || (cls(Int(b[u + 2])) & HEX) == 0 {
            let kk = if left < 3 { left } else { 3 }
            return url_fail("invalid URL escape " + go_quote_c(rawb.str_slice(s, u, u + kk)))
          }
          u += 2
        }
        u += 1
      }
    }
  }
  let (pok, path) = unescape(b, s, p, rn, U_PATH)
  if !pok {
    return url_fail(escape_error(b, s, p, rn))
  }
  Url{ok: true, err: "", scheme: scheme, host: host, path: path, rawquery: rawquery}
}

/// strconv.Quote (printable: ASCII graphic and every rune from U+00A1
/// but U+00AD, U+2028, U+2029; xo_http.c's approximation of IsPrint).
pub fn go_quote(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  let hex = b"0123456789abcdef"
  var out = rt.rs_push_byte(rt.rs_with_cap(n + 2), 34)
  var i = 0
  while i < n {
    let c = Int(b[i])
    if c >= 32 && c < 127 && c != 34 && c != 92 {
      // a run of plain ASCII
      var j = i + 1
      while j < n {
        let d = Int(b[j])
        if d < 32 || d >= 127 || d == 34 || d == 92 {
          break
        }
        j += 1
      }
      out = rt.rs_append_bytes(out, b, i, j, 0)
      i = j
      continue
    }
    let x = rawb.bytes_decode(b, i)
    let r = x >> 3
    let size = x & 7
    if r == 0xFFFD && size == 1 {
      out = rt.rs_push_word(out, 92 | (120 << 8) | (Int(hex[c >> 4]) << 16) | (Int(hex[c & 15]) << 24), 4)
    } else if r == 34 || r == 92 {
      out = rt.rs_push_word(out, 92 | (r << 8), 2)
    } else if r >= 0xA1 && r != 0xAD && r != 0x2028 && r != 0x2029 {
      out = rt.rs_append_bytes(out, b, i, i + size, 0)
    } else if r == 7 {
      out = rt.rs_push_word(out, 92 | (97 << 8), 2)
    } else if r == 8 {
      out = rt.rs_push_word(out, 92 | (98 << 8), 2)
    } else if r == 12 {
      out = rt.rs_push_word(out, 92 | (102 << 8), 2)
    } else if r == 10 {
      out = rt.rs_push_word(out, 92 | (110 << 8), 2)
    } else if r == 13 {
      out = rt.rs_push_word(out, 92 | (114 << 8), 2)
    } else if r == 9 {
      out = rt.rs_push_word(out, 92 | (116 << 8), 2)
    } else if r == 11 {
      out = rt.rs_push_word(out, 92 | (118 << 8), 2)
    } else if r < 32 || r == 127 {
      out = rt.rs_push_word(out, 92 | (120 << 8) | (Int(hex[r >> 4]) << 16) | (Int(hex[r & 15]) << 24), 4)
    } else {
      let k = if r < 0x10000 { 4 } else { 8 }
      out = rt.rs_push_word(out, 92 | ((if k == 4 { 117 } else { 85 }) << 8), 2)
      var sh = 4 * (k - 1)
      while sh >= 0 {
        out = rt.rs_push_byte(out, Int(hex[(r >> sh) & 15]))
        sh -= 4
      }
    }
    i += size
  }
  rt.rs_push_byte(out, 34)
}

/// Go's shouldEscape(c, encodeHost) for an ASCII byte.
fn host_escapes(c: Int) -> Bool {
  if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
    return false
  }
  // unreserved, and the sub-delims, ':', brackets, '<', '>', '"' Go keeps
  !(c == 45 || c == 95 || c == 46 || c == 126 || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 91 || c == 93 || c == 60 || c == 62 || c == 34)
}

fn is_hex(c: Int) -> Bool { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

/// Go's unescape(s, encodeHost) error text, "" when it is fine.
fn host_unescape_error(s: Str) -> Str {
  let b = s.bytes()
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c == 37 {
      if i + 2 >= b.len() || !is_hex(Int(b[i + 1])) || !is_hex(Int(b[i + 2])) {
        let end = if i + 3 < b.len() { i + 3 } else { b.len() }
        return "invalid URL escape " + go_quote(rawb.str_slice(s, i, end))
      }
      if unhex(Int(b[i + 1])) < 8 && rawb.str_slice(s, i, i + 3) != "%25" {
        return "invalid URL escape " + go_quote(rawb.str_slice(s, i, i + 3))
      }
      i += 3
    } else {
      if c < 128 && host_escapes(c) {
        return "invalid character " + go_quote(rawb.str_slice(s, i, i + 1)) + " in host name"
      }
      i += 1
    }
  }
  ""
}

/// Go's validOptionalPort.
fn optional_port(p: Str) -> Bool {
  let b = p.bytes()
  if b.len() == 0 {
    return true
  }
  if b[0] != 58 {
    return false
  }
  for k in 1..b.len() {
    if Int(b[k]) < 48 || Int(b[k]) > 57 {
      return false
    }
  }
  true
}

/// Go 1.26's url.parseHost error text for host (not postgres, strict
/// colons): "" when Go takes it. An IPv6 literal netip refuses gives
/// "invalid host" without netip's own text.
pub fn go_host_error(host: Str) -> Str {
  let b = host.bytes()
  let ob = rfind(b, 91, b.len())
  if ob > 0 {
    return "invalid IP-literal"
  }
  if ob == 0 {
    let cb = rfind(b, 93, b.len())
    if cb < 0 {
      return "missing ']' in host"
    }
    let port = rawb.str_slice(host, cb + 1, b.len())
    if !optional_port(port) {
      return "invalid port " + go_quote(port) + " after host"
    }
    let e = host_unescape_error(rawb.str_slice(host, 1, cb))
    if e != "" {
      return e
    }
    return "invalid host"
  }
  let first = find(host, 58, 0, b.len())
  if first >= 0 {
    let port = rawb.str_slice(host, first, b.len())
    if !optional_port(port) {
      return "invalid port " + go_quote(port) + " after host"
    }
  }
  host_unescape_error(host)
}
