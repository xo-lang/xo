// Process IDs (decision 0410): Proc.pid and Proc.ppid. Windows finds the
// parent in a process snapshot, as Go's os.Getppid does; WASI answers 0
// for both (no process model).

use native/llrt/linux
use native/llrt/raw
use native/llrt/windows
use native/rt
use native/sys_darwin
use native/sys_windows

/// This process's ID.
pub fn pid() -> Int {
  match target.os {
    TargetOs.Darwin => Int(sys_darwin.getpid())
    TargetOs.Linux => linux.getpid()
    TargetOs.Windows => Int(sys_windows.GetCurrentProcessId())
    TargetOs.Wasi => 0
  }
}

/// Proc.usage and Proc.children_usage (decision 0426): user and system
/// CPU time in nanoseconds and the peak resident set in bytes, of this
/// process or of its waited children (getrusage's RUSAGE_SELF and
/// RUSAGE_CHILDREN; on Windows GetProcessTimes and the peak working set,
/// the children's totals kept by windows.reap); zeros under WASI.
pub fn usage(children: Bool) -> List[Int] {
  match target.os {
    TargetOs.Darwin | TargetOs.Linux => {
      let b = raw.bytes_buf(144)
      let a = raw.bytes_addr(b)
      rt.mem_set(a, 0, 144)
      let who = if children { -1 } else { 0 }
      let r = if target.os == TargetOs.Darwin { Int(sys_darwin.getrusage(who, a)) } else { linux.getrusage(who, a) }
      // struct rusage: ru_utime and ru_stime timevals (seconds and
      // microseconds) at 0 and 16, ru_maxrss at 32 (KiB on Linux, bytes
      // on macOS)
      var out = [0, 0, 0]
      if r == 0 {
        out[0] = rt.mem_load(a, 0, 8) * 1000000000 + rt.mem_load(a, 8, 8) * 1000
        out[1] = rt.mem_load(a, 16, 8) * 1000000000 + rt.mem_load(a, 24, 8) * 1000
        let rss = rt.mem_load(a, 32, 8)
        out[2] = if target.os == TargetOs.Darwin { rss } else { rss * 1024 }
      }
      keep_bytes(b)
      out
    }
    TargetOs.Windows => {
      let u = if children { windows.children_usage() } else { windows.proc_usage(Int(sys_windows.GetCurrentProcess())) }
      [u[0] * 100, u[1] * 100, u[2]]
    }
    TargetOs.Wasi => [0, 0, 0]
  }
}

/// The parent process's ID, or 0 where the system cannot say.
pub fn ppid() -> Int {
  match target.os {
    TargetOs.Darwin => Int(sys_darwin.getppid())
    TargetOs.Linux => linux.getppid()
    TargetOs.Windows => windows_ppid()
    TargetOs.Wasi => 0
  }
}

/// The parent's ID on Windows: this process's PROCESSENTRY32W's
/// th32ParentProcessID in a snapshot of every process (Go's
/// syscall.Getppid), 0 when there is no snapshot or no entry.
fn windows_ppid() -> Int {
  let snap = sys_windows.CreateToolhelp32Snapshot(2, 0)
  if snap == -1 || snap == 0 {
    return 0
  }
  let me = Int(sys_windows.GetCurrentProcessId())
  // PROCESSENTRY32W on x64: dwSize at 0, th32ProcessID at 8,
  // th32ParentProcessID at 32, szExeFile's 260 UTF-16 units from 44;
  // 568 bytes
  let buf = raw.bytes_buf(568)
  let e = raw.bytes_addr(buf)
  rt.mem_set(e, 0, 568)
  rt.mem_store(e, 0, 568, 4)
  var parent = 0
  var ok = Int(sys_windows.Process32FirstW(snap, e)) != 0
  while ok {
    if (rt.mem_load(e, 8, 4) & 4294967295) == me {
      parent = rt.mem_load(e, 32, 4) & 4294967295
      break
    }
    ok = Int(sys_windows.Process32NextW(snap, e)) != 0
  }
  sys_windows.CloseHandle(snap)
  keep_bytes(buf)
  parent
}

/// A use of b after its last raw access.
fn keep_bytes(b: Bytes) {
  if b.len() < 0 {
    return
  }
}
