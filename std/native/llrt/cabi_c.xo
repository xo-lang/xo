// The C ABI exports under their exact C names (decision 0234): every top
// level function of this module is the C symbol of its name, not
// xo_x_<name>, in every native program (the native prelude imports it;
// compiler/ssa declare_exports), with the C calling convention and the
// parameters and results of cabi.xo's exports. Nothing here may fault.
use native/llrt/clibh
use native/llrt/entry
use native/llrt/heapos
use native/llrt/obj
use native/llrt/process
use native/llrt/stdio
use native/rt
use native/sys_c

/// The program's C entry, which the C library's start calls (was
/// xo_rt.c's main): the runtime's setup, then the program (entry.xo
/// main) with the generated xo_entry. argc is a C int (the low 32 bits
/// of its word), argv and envp the C arrays; on Windows process.xo reads
/// Windows' own environment, so envp is not used. The exit status.
fn main(argc: Int, argv: Int, envp: Int) -> Int {
  entry.init()
  let env = match target.os {
    TargetOs.Windows => 0
    _ => envp
  }
  entry.main(argc & 4294967295, argv, env, rt.sym_addr("xo_entry"), 1)
}

/// A C library's start (decision 0574, `xo build --lib`), in place of
/// main: the runtime's setup and the process's start (arguments,
/// environment, signals) with no program to run. The host calls it once,
/// before any export; the status (0).
fn xo_init(argc: Int, argv: Int, envp: Int) -> Int {
  // the library's constructor ran it (the loader calls it with the
  // process's arguments, as main's): a second call does nothing
  if obj.heap_started() {
    // started early (xo_start_early): the process's arguments and
    // environment now
    if argv != 0 && !process.has_args() {
      process.start(argc & 4294967295, argv, envp)
    }
    return 0
  }
  entry.init()
  entry.start(argc & 4294967295, argv, envp)
  // C may call the exports from threads Xo did not start, at once: one
  // heap record per thread from here (cabi.xo heap_threads), each made on
  // the thread's first allocation (heap_thread); the single threaded
  // record is not safe for two callers
  let h = obj.solo_heap()
  if h != 0 {
    heapos.set_thread_heap(h)
    // a C thread's record goes back for reuse when the thread exits: a
    // pthread key's destructor (xo_thread_exit), set on the record's
    // first use (xo_heap_attach); 32 KB a thread kept otherwise
    if Int(sys_c.pthread_key_create(h + heapos.H_TKEY, rt.sym_addr("xo_thread_exit"))) == 0 {
      // the key (a C int on linux, a long on darwin) plus 1
      let k = match target.os {
        TargetOs.Linux => rt.mem_load(h + heapos.H_TKEY, 0, 4)
        _ => rt.mem_load(h + heapos.H_TKEY, 0, 8)
      }
      rt.mem_store(h + heapos.H_TKEY, 0, k + 1, 8)
      obj.heap_init(0, rt.sym_addr("xo_heap_attach"))
    } else {
      rt.mem_store(h + heapos.H_TKEY, 0, 0, 8)
      obj.heap_init(0, rt.fn_addr("heap_thread"))
    }
    stdio.threads()
  }
  0
}

/// A C library's heap slow path (decision 0574): the calling thread's
/// record (heapos.thread_heap), registered with the thread exit key.
fn xo_heap_attach(a: Int, b: Int) -> Int {
  let h = heapos.thread_heap()
  let k = rt.mem_load(h + heapos.H_TKEY, 0, 8)
  if k != 0 {
    let _r = sys_c.pthread_setspecific(k - 1, h)
  }
  h
}

/// The thread exit key's destructor: the exiting C thread's record h
/// goes back for the next new thread.
fn xo_thread_exit(h: Int) {
  heapos.orphan(h)
}

/// A C library's last error text on the calling thread (decision 0574):
/// the zero terminated message of the last export that returned an
/// error there, which the thread's next error replaces, or NULL.
fn xo_last_error() -> Int { heapos.c_last_error() }

/// The runtime's start for an export called before the library's
/// constructor (decision 0574): another constructor called it first, as
/// a static library's constructor runs in the program's link order. No
/// arguments and no environment until the constructor's xo_init adds
/// them.
fn xo_start_early() {
  let _r = xo_init(0, 0, 0)
}

/// Drops a handle a C library's export returned (decision 0574): the
/// value goes when nothing else holds it; 0 does nothing; a handle that
/// was already released faults.
fn xo_release(h: Int) { clibh.release(h) }

/// Frees the bytes of a C library export's Bytes or Str result (decision
/// 0574): C's malloc made them (heapos.c_bytes_out); 0 does nothing.
fn xo_free(p: Int) {
  if p != 0 {
    sys_c.weak_free(p)
  }
}
