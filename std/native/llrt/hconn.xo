// The HTTP server's connection records and their socket and TLS input
// and output, in Xo (the zero-C audit's B28 part 3; xo_http.c's xo_srv
// and xo_hconn until 2026-10-14). A server (rthttp.Srv) and a
// connection (rthttp.HConn) are handles whose records are laid out
// below; hserve.xo makes them and keeps the server's list, scope, and
// stop, and cabi_http.xo's srv_free and hc_free free them. This module
// is what the connection's readers and writers need (http1.xo's HTTP/1.1
// connection, h2srv.xo's HTTP/2 one) and imports neither, so both can
// use it.
//
// The server's TLS connections are tlssrv.xo's (decision 0202). The
// Windows arms are UNTESTED on
// windows: written on macOS and checked by the cross build only.
use native/llrt/layout
use native/llrt/dns
use native/llrt/obj
use native/llrt/poll
use native/llrt/pool
use native/llrt/raw
use native/llrt/rc
use native/llrt/sock
use native/llrt/sysio
use native/llrt/tasks
use native/llrt/twflags
use native/llrt/twrun
use native/rt
use native/rthttp

/// A server's record (byte offsets): the header (count, free function);
/// its TLS configuration (tlssrv.xo's, 0 for plain HTTP); the lock word of
/// the rest; the live connections (a list through HC_PREV and HC_NEXT)
/// and their count; whether it stops; the wait list of srv_wait (tasks.xo
/// WL_*, two words); the scope of the connection tasks (a reference);
/// whether srv_close ran.
/// The slot atomics' sequentially consistent order (rt.xo).
const SEQ_CST = 4

pub const SR_TLS = 16
pub const SR_MU = 24
pub const SR_CONNS = 32
pub const SR_N = 40
pub const SR_STOPPING = 48
pub const SR_IDLE = 56
pub const SR_SCOPE = 72
pub const SR_CLOSED = 80
/// Whether plain connections may start HTTP/2 with prior knowledge
/// (h2c, decision 0434: srv_h2c).
pub const SR_H2C = 88
/// the HTTP/2 settings block (hserve.srv_h2cfg): 5 words, 0 none
pub const SR_H2CFG = 96
/// Parked idle connections (decision 0449, hserve.xo hc_park): the lock
/// word of the ready list (not SR_MU: srv_stop closes descriptors under
/// SR_MU, and a close fires a continuation), the list of the continuation
/// records the poller fired (cont_fire; each: server, resume id, next),
/// the park of the resumer task waiting for one (0 when none), and the
/// number of connections parked and not yet fired.
pub const SR_RLOCK = 104
pub const SR_READY = 112
pub const SR_RESUMER = 120
pub const SR_PARKED = 128
/// the list of parked connections' records (hserve.xo, each with a
/// deadline: the server's idle timeout), under SR_RLOCK
pub const SR_PARKLIST = 136
pub const SR_SIZE = 144

/// A connection's record (byte offsets): the header; its server (a
/// reference; 0 for a stream's connection); the net.Conn (a reference);
/// the links in the server's list and whether it is in it; whether it
/// waits for the first byte of a request (a stop closes it then);
/// http1.xo's X1 record (freed with it); the TLS connection (tlssrv.xo,
/// 0: plain); HTTP/2: the connection's h2srv.xo record, or for a stream's
/// connection its stream record and the connection it belongs to (a
/// reference); the peer's address (its length, then the text).
pub const HC_SRV = 16
pub const HC_CONN = 24
pub const HC_PREV = 32
pub const HC_NEXT = 40
pub const HC_REG = 48
pub const HC_IDLE = 56
pub const HC_X1 = 64
pub const HC_TLS = 72
pub const HC_H2 = 80
pub const HC_H2S = 88
pub const HC_OWNER = 96
pub const HC_IPN = 104
pub const HC_IP = 112
/// Input read ahead by sniff_h2c and not yet taken (a block: its length, then
/// up to 24 bytes), 0 for none.
pub const HC_PEEK = 160
/// When the last response ended (monotonic ns, 0 before the first), and
/// whether the gap before the last request was under QUICK_GAP_NS (1): a
/// busy keep-alive connection does not park (note_request, note_done).
pub const HC_TEND = 168
pub const HC_QUICK = 176
pub const HC_SIZE = 184

/// The longest address text kept (INET6_ADDRSTRLEN less its zero byte).
const IP_MAX = 45

/// The xo_conn record's poll descriptor (xo_rt.c, asserted), and the
/// descriptor's fd (poll.xo D_FD, a C int).
const CN_PD = 16
const D_FD = layout.D_FD
/// MSG_NOSIGNAL of Linux's send (sock.send ignores it elsewhere).
const NOSIGNAL = 16384

/// shutdown(2)'s SHUT_WR (SD_SEND on Windows).
const SHUT_WR = 1

pub fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

pub fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// The record of h.
pub fn rec(h: rthttp.HConn) -> Int { rt.obj_addr(h) }

// The TLS and HTTP/2 server's table (decision 0244, srvtls.xo install,
// at the first http.Server.with_tls): the addresses of cabi_tls.xo's
// exports, by index; a connection with TLS (HC_TLS) or HTTP/2 (HC_H2)
// exists only after it, so these calls never find the word 0.

/// rt.static_word: the table, 0 before with_tls.
pub const W_TLS_OPS = 68
pub const TO_SRV_FREE = 0
pub const TO_CONN = 1
pub const TO_CLOSE_NOTIFY = 2
pub const TO_FREE = 3
pub const TO_READ = 4
pub const TO_WRITE = 5
pub const TO_H2_STOP = 6
pub const TO_H2_FREE = 7
pub const TO_H2_STREAM_RELEASE = 8
pub const TO_H2_EMIT = 9
pub const TO_H2_RESPOND_AT = 10
pub const TO_H2_FINISH = 11
pub const TO_H2 = 12
pub const TO_SET_DEADLINE = 13
pub const TO_TIMED_OUT = 14
pub const TO_NEG = 15
pub const TO_H2C = 16
pub const TO_NB_READ = 17
/// the fill guards of the two installers (srvh2c.xo begin_fill): 0 not
/// started, 1 being filled, 2 filled
pub const TO_ONCE_H2 = 18
pub const TO_ONCE_TLS = 19
/// whether the engine holds nothing: no decrypted bytes, no partial record
/// (1 yes), so a raw socket with nothing to read is an idle connection
pub const TO_IDLE_EMPTY = 20

/// The number of entries of the table.
pub const TO_COUNT = 21

/// The table, made on first use by an installer (srvtls.xo install,
/// srvh2c.xo install_h2c), each storing its own entries; 0 for none.
pub fn tls_ops_table() -> Int { rt.slot_load[Int](rt.static_word(W_TLS_OPS), 0, 1) }

/// Publishes the table t (srvtls.xo install) unless another thread did
/// first: the table in use, whose entries the caller then stores.
pub fn tls_ops_set(t: Int) -> Int {
  if rt.slot_cas[Int](rt.static_word(W_TLS_OPS), 0, 0, t, 3) { t } else { rt.mem_load(rt.static_word(W_TLS_OPS), 0, 8) }
}

/// The address of the table's entry k (TO_*).
pub fn tls_op(k: Int) -> Int { rt.mem_load(rt.mem_load(rt.static_word(W_TLS_OPS), 0, 8), 8 * k, 8) }

/// The connection handle of record hc (counted once more; the record's
/// count is unchanged once the value is dead).
pub fn handle(hc: Int) -> rthttp.HConn { rt.obj_at[rthttp.HConn](hc) }

/// The handle of the new record hc, taking over its reference.
pub fn take(hc: Int) -> rthttp.HConn {
  let h = rt.obj_at[rthttp.HConn](hc)
  tasks.h_release(hc)
  h
}

/// The poll descriptor of record hc's net.Conn.
pub fn conn_pd(hc: Int) -> Int { ld(ld(hc, HC_CONN), CN_PD) }

/// The fd of poll descriptor pd.
fn pd_fd(pd: Int) -> Int {
  let fd = rt.mem_load(pd, D_FD, 4)
  if fd >= 2147483648 { fd - 4294967296 } else { fd }
}

/// Whether the negative errno -e of a read or write says it would block
/// (EAGAIN or EWOULDBLOCK: 11 on Linux, 35 on macOS, the Windows CRT's
/// 140 that sock.xo maps WSAEWOULDBLOCK to).
fn would_block(e: Int) -> Bool {
  match target.os {
    TargetOs.Darwin => e == -35
    TargetOs.Windows => e == -140 || e == -11
    TargetOs.Linux | TargetOs.Wasi => e == -11
  }
}

/// The timers' deadline d from now (xo_rt.c deadline: the virtual clock
/// in a test binary, else the monotonic one; at most the largest Int).
pub fn deadline(d: Int) -> Int {
  if twflags.on() {
    return twrun.deadline(d)
  }
  let now = sysio.mono_ns()
  if d > 0 && now > 9223372036854775807 - d { 9223372036854775807 } else { now + d }
}

pub fn lock(s: Int) { pool.lock_k(s + SR_MU, pool.ST_LOCK_HTTP) }

pub fn unlock(s: Int) { pool.unlock(s + SR_MU) }

/// The ready list's lock (SR_RLOCK, decision 0449).
pub fn rlock(s: Int) { pool.lock_k(s + SR_RLOCK, pool.ST_LOCK_HTTP) }

pub fn runlock(s: Int) { pool.unlock(s + SR_RLOCK) }

/// The text of the peer address of socket fd (inet_ntop's), or "".
pub fn peer_ip(fd: Int) -> Str {
  let buf = raw.bytes_buf(128)
  let ip = peer_ip_at(fd, raw.bytes_addr(buf))
  raw.alive(buf)
  ip
}

/// peer_ip with the sockaddr buffer at sa (128 bytes).
fn peer_ip_at(fd: Int, sa: Int) -> Str {
  let lp = obj.scratch()
  rt.mem_store(lp, 0, 128, 4)
  if sock.peername(fd, sa, lp) < 0 {
    return ""
  }
  let n = rt.mem_load(lp, 0, 4)
  // macOS's sockaddr starts with its length, then a byte of family
  let fam = match target.os {
    TargetOs.Darwin => rt.mem_load(sa, 1, 1)
    TargetOs.Linux | TargetOs.Windows | TargetOs.Wasi => rt.mem_load(sa, 0, 2)
  }
  if fam == sock.AF_INET && n >= 8 {
    return dns.ntop(raw.str_at(sa + 4, 4).bytes())
  }
  if fam == sock.af_inet6() && n >= 24 {
    return dns.ntop(raw.str_at(sa + 8, 16).bytes())
  }
  ""
}

/// Sets record hc's peer address to ip.
pub fn set_ip(hc: Int, ip: Str) {
  let n = if ip.len() > IP_MAX { IP_MAX } else { ip.len() }
  rt.mem_copy(hc + HC_IP, raw.data(ip), n)
  st(hc, HC_IPN, n)
}

/// Takes record hc out of its server's list (srv_wait's waiters wake
/// when the last goes).
pub fn unregister(hc: Int) {
  let s = ld(hc, HC_SRV)
  if s == 0 {
    return
  }
  lock(s)
  if ld(hc, HC_REG) != 0 {
    st(hc, HC_REG, 0)
    let prev = ld(hc, HC_PREV)
    let next = ld(hc, HC_NEXT)
    if prev != 0 {
      st(prev, HC_NEXT, next)
    } else {
      st(s, SR_CONNS, next)
    }
    if next != 0 {
      st(next, HC_PREV, prev)
    }
    let n = ld(s, SR_N) - 1
    st(s, SR_N, n)
    if n == 0 {
      tasks.wl_wake(s + SR_IDLE)
    }
  }
  unlock(s)
}

/// Whether server record s is stopping. Stopping and a connection's idle
/// mark are sequentially consistent atomics, not under the server's lock
/// (2026-10-21: recv took that lock twice a request, every connection's
/// on one lock: a slow path in 2.4% of requests at 32 connections, and
/// the line moved between cores on every request). A reader marks
/// itself idle and then reads stopping; srv_stop stores stopping and then
/// reads each connection's mark: at least one of them sees the other's
/// store, so an idle connection is never missed by a stop (both may see
/// both: the reader gives up and the stop closes its descriptor, which
/// pd_close does once).
pub fn stopping_at(s: Int) -> Bool { rt.slot_load(s, SR_STOPPING / 8, SEQ_CST) != 0 }

/// Marks server record s stopping (srv_stop, its lock held).
pub fn set_stopping(s: Int) { rt.slot_store(s, SR_STOPPING / 8, 1, SEQ_CST) }

/// Whether connection record hc waits for a request's first byte.
pub fn idle_at(hc: Int) -> Bool { rt.slot_load(hc, HC_IDLE / 8, SEQ_CST) != 0 }

/// Marks record hc as waiting for a request's first byte (idle) or not.
pub fn set_idle(hc: Int, idle: Bool) {
  if ld(hc, HC_SRV) == 0 {
    return
  }
  rt.slot_store(hc, HC_IDLE / 8, if idle { 1 } else { 0 }, SEQ_CST)
}

/// Reads at most cap bytes to the address p (http1.xo fill): the count,
/// 0 at the end of the stream, -1 when the connection was closed or the
/// task canceled, or (idle: nothing of a request came yet, so a stop
/// closes it) the server is stopping.
pub fn recv(h: rthttp.HConn, p: Int, cap: Int, idle: Bool) -> Int { recv_until(h, p, cap, idle, 0) }

/// recv with a deadline (monotonic ns, 0 none; std.md 4.4): -2 when it
/// passed before a byte came, on a plain and on a TLS connection (the
/// handshake's waits included).
pub fn recv_until(h: rthttp.HConn, p: Int, cap: Int, idle: Bool, deadline: Int) -> Int {
  let hc = rec(h)
  if ld(hc, HC_PEEK) != 0 {
    let k = take_peek(hc, p, cap)
    if k > 0 {
      return k
    }
  }
  return recv_raw(hc, p, cap, idle, deadline)
}

/// The input sniff_h2c read ahead, up to cap bytes of it, at p.
fn take_peek(hc: Int, p: Int, cap: Int) -> Int {
  let pk = ld(hc, HC_PEEK)
  let n = ld(pk, 0)
  let k = if cap < n { cap } else { n }
  rt.mem_copy(p, pk + 8, k)
  if k == n {
    st(hc, HC_PEEK, 0)
    obj.free_obj(pk)
  } else {
    rt.mem_move(pk + 8, pk + 8 + k, n - k)
    st(pk, 0, n - k)
  }
  k
}

/// Whether idle connection h can park (decision 0449): a plain TCP
/// connection of a running server with nothing to read now (a peek finds
/// the socket empty and open). It marks the connection idle, so a stop
/// closes it while parked; the caller then parks it or, if it does not,
/// clears the mark by reading.
pub fn park_ready(h: rthttp.HConn, h2: Bool = false) -> Bool {
  let hc = rec(h)
  let s = ld(hc, HC_SRV)
  if s == 0 || (ld(hc, HC_H2) != 0 && !h2) || ld(hc, HC_PEEK) != 0 || stopping_at(s) || poll.canceled() {
    return false
  }
  let tls = ld(hc, HC_TLS)
  if tls != 0 && rt.call_c2(tls_op(TO_IDLE_EMPTY), tls, 0) != 1 {
    return false
  }
  let pd = conn_pd(hc)
  if !poll.pd_begin(pd) {
    return false
  }
  // the readiness the last read left (edge triggered: it stays set until
  // a wait takes it) would make pd_park refuse; an edge after this call
  // keeps the flag, and the peek sees what came before
  poll.pd_clear_read(pd)
  let b = obj.alloc_obj(8)
  // MSG_PEEK: the byte stays for the read
  let r = sock.recv(pd_fd(pd), b, 1, 2)
  obj.free_obj(b)
  if !would_block(r) {
    poll.pd_end(pd)
    return false
  }
  // a plain HTTP/1.1 connection lingers on its stack first: it parks only
  // when no byte comes for LINGER_NS (a timer, not the gap note_request
  // saw: under load, readiness reaches the connection a poll later, so a
  // busy connection's gap looked idle and it parked on most requests,
  // /alloc 0.66 to 0.78 of v0.35.0's req/s on linux/arm64, 2026-11-02)
  if tls == 0 && !h2 {
    let w = poll.pd_wait(pd, false, poll.deadline(LINGER_NS))
    if w != poll.TIMEOUT {
      poll.pd_end(pd)
      return false
    }
  }
  poll.pd_end(pd)
  set_idle(hc, true)
  true
}

/// How long an idle plain HTTP/1.1 connection waits on its stack before it
/// parks (park_ready).
const LINGER_NS = 20000000

/// A gap between two requests shorter than this marks the connection busy:
/// it keeps its fiber and waits there, since parking and resuming a busy
/// connection costs more than the stack it holds (the CRUD server, 32 busy
/// connections: 187k to 168k req/s when every request parked, 2026-10-31).
const QUICK_GAP_NS = 2000000

/// Whether the last gap between requests on h was short (park_ready is
/// not asked then).
pub fn quick(h: rthttp.HConn) -> Bool { ld(rec(h), HC_QUICK) != 0 }

/// A request head arrived on h: the gap since the last response decides
/// quick.
pub fn note_request(h: rthttp.HConn) {
  let hc = rec(h)
  let e = ld(hc, HC_TEND)
  if e != 0 {
    st(hc, HC_QUICK, if sysio.mono_ns() - e < QUICK_GAP_NS { 1 } else { 0 })
  }
}

/// A response on h ended.
pub fn note_done(h: rthttp.HConn) { st(rec(h), HC_TEND, sysio.mono_ns()) }

/// Reads from the connection itself (recv_until after the read ahead).
fn recv_raw(hc: Int, p: Int, cap: Int, idle: Bool, deadline: Int) -> Int {
  let s = ld(hc, HC_SRV)
  if s != 0 {
    // the mark first, then stopping (stopping_at)
    set_idle(hc, idle)
    if idle && stopping_at(s) {
      return -1
    }
  }
  var r = -1
  let tls = ld(hc, HC_TLS)
  if poll.canceled() {
    r = -1
  } else if tls != 0 {
    // the handshake first, then decrypted bytes; both wait with the
    // deadline (std.md 4.4), so a slow client cannot hold a TLS
    // connection past the read or head timeout
    let _d = rt.call_c2(tls_op(TO_SET_DEADLINE), tls, deadline)
    r = rt.call_c4(tls_op(TO_READ), tls, p, cap, 0)
    if r < 0 && deadline != 0 && rt.call_c2(tls_op(TO_TIMED_OUT), tls, 0) != 0 {
      r = -2
    }
    let _c = rt.call_c2(tls_op(TO_SET_DEADLINE), tls, 0)
  } else {
    let pd = conn_pd(hc)
    if poll.pd_begin(pd) {
      let fd = pd_fd(pd)
      while true {
        r = sock.read(fd, p, cap)
        if r >= 0 {
          break
        }
        if r == -sock.EINTR {
          continue
        }
        if would_block(r) {
          let w = poll.pd_wait(pd, false, deadline)
          if w == poll.READY {
            continue
          }
          r = if w == poll.TIMEOUT { -2 } else { -1 }
          break
        }
        r = -1
        break
      }
      poll.pd_end(pd)
    }
  }
  set_idle(hc, false)
  if r == -2 { -2 } else if r < 0 { -1 } else { r }
}

/// Sends the n bytes at p: false when the connection broke.
pub fn send_at(h: rthttp.HConn, p: Int, n: Int) -> Bool {
  let hc = rec(h)
  let tls = ld(hc, HC_TLS)
  if tls != 0 {
    return rt.call_c4(tls_op(TO_WRITE), tls, p, n, 0) == 0
  }
  let pd = conn_pd(hc)
  if !poll.pd_begin(pd) {
    return false
  }
  let fd = pd_fd(pd)
  var off = 0
  var ok = true
  while off < n {
    let w = sock.send(fd, p + off, n - off, NOSIGNAL)
    if w >= 0 {
      off += w
      continue
    }
    if w == -sock.EINTR {
      continue
    }
    if would_block(w) && poll.pd_wait(pd, true, 0) == poll.READY {
      continue
    }
    ok = false
    break
  }
  poll.pd_end(pd)
  ok
}

/// send_at with a deadline (monotonic ns, 0 none; decision 0430, a
/// WebSocket's write deadline after the hand-over): 0 when every byte
/// went, -2 when the deadline passed first, -1 when the connection broke
/// or the task was canceled. On TLS the record flush waits with it
/// (TO_SET_DEADLINE, as recv_until).
pub fn send_until(h: rthttp.HConn, p: Int, n: Int, deadline: Int) -> Int {
  if poll.canceled() {
    return -1
  }
  let hc = rec(h)
  let tls = ld(hc, HC_TLS)
  if tls != 0 {
    let _d = rt.call_c2(tls_op(TO_SET_DEADLINE), tls, deadline)
    var r = if rt.call_c4(tls_op(TO_WRITE), tls, p, n, 0) == 0 { 0 } else { -1 }
    if r < 0 && deadline != 0 && rt.call_c2(tls_op(TO_TIMED_OUT), tls, 0) != 0 {
      r = -2
    }
    let _c = rt.call_c2(tls_op(TO_SET_DEADLINE), tls, 0)
    return r
  }
  let pd = conn_pd(hc)
  if !poll.pd_begin(pd) {
    return -1
  }
  let fd = pd_fd(pd)
  var off = 0
  var r = 0
  while off < n {
    let w = sock.send(fd, p + off, n - off, NOSIGNAL)
    if w >= 0 {
      off += w
      continue
    }
    if w == -sock.EINTR {
      continue
    }
    if would_block(w) {
      let k = poll.pd_wait(pd, true, deadline)
      if k == poll.READY {
        continue
      }
      r = if k == poll.TIMEOUT { -2 } else { -1 }
      break
    }
    r = -1
    break
  }
  poll.pd_end(pd)
  r
}

/// Whether h's server is stopping (no other request on the connection).
/// Whether connection h speaks TLS (Request.tls, std.md 4.3).
pub fn is_tls(h: rthttp.HConn) -> Bool { ld(rec(h), HC_TLS) != 0 }
/// The connection's TLS connection (tlssrv), 0 for plain; for an HTTP/2
/// stream's handle (stream), its connection's (the stream record copies
/// the peer address only).
pub fn tls_of(h: rthttp.HConn) -> Int {
  let hc = rec(h)
  let o = ld(hc, HC_OWNER)
  ld(if o != 0 { o } else { hc }, HC_TLS)
}

pub fn stopping(h: rthttp.HConn) -> Bool {
  let s = ld(rec(h), HC_SRV)
  if s == 0 {
    return false
  }
  stopping_at(s)
}

/// Shuts down the sending side (after a 431 answer).
pub fn shut_wr(h: rthttp.HConn) {
  let hc = rec(h)
  if ld(hc, HC_CONN) != 0 {
    let _r = sock.shutdown(pd_fd(conn_pd(hc)), SHUT_WR)
  }
}

/// Shuts down the sending side and reads what the peer still sends, for
/// at most 500 ms or until it closes (net/http's closeWriteAndWait): a
/// close with unread request bytes sends a RST on Linux, which can cost
/// the client the 431 or 413 reply it has not read yet.
pub fn linger_close(h: rthttp.HConn) {
  shut_wr(h)
  let buf = rt.heap_large(4096)
  let until = deadline(500000000)
  var total = 0
  while total < 1048576 {
    let n = recv_until(h, buf, 4096, false, until)
    if n <= 0 {
      break
    }
    total += n
  }
  rt.heap_release(buf - 8)
}

/// http1.xo's X1 record of the connection (0: none yet), and setting it.
pub fn x1(h: rthttp.HConn) -> Int { ld(rec(h), HC_X1) }

pub fn set_x1(h: rthttp.HConn, x: Int) { st(rec(h), HC_X1, x) }

/// The peer's address (Request.remote_addr's host).
pub fn remote_ip(h: rthttp.HConn) -> Str {
  let hc = rec(h)
  raw.str_at(hc + HC_IP, ld(hc, HC_IPN))
}

/// Reads what the TLS connection has into the cap bytes at p, without
/// waiting (h2srv.xo's fiber waits itself): the count, 0 at the end of
/// the stream, -1 on an error, -2 when nothing is there.
pub fn h2_read(h: rthttp.HConn, p: Int, cap: Int) -> Int {
  let hc = rec(h)
  if ld(hc, HC_PEEK) != 0 {
    let k = take_peek(hc, p, cap)
    if k > 0 {
      return k
    }
  }
  let tls = ld(hc, HC_TLS)
  if tls != 0 {
    return rt.call_c4(tls_op(TO_NB_READ), tls, p, cap, 0)
  }
  // plain (h2c): -2 when nothing is there
  let pd = conn_pd(hc)
  var r = -1
  if poll.pd_begin(pd) {
    while true {
      r = sock.read(pd_fd(pd), p, cap)
      if r == -sock.EINTR {
        continue
      }
      break
    }
    poll.pd_end(pd)
  }
  if r >= 0 { r } else if would_block(r) { -2 } else { -1 }
}

/// Reads the first bytes of plain connection h while they are a prefix
/// of the HTTP/2 client preface (h2c, decision 0434): 1 when all 24
/// came, 0 when a byte differs (HTTP/1.1: the bytes stay for the next
/// read), -1 when the connection closed, -2 when the deadline passed.
/// The bytes are kept for recv_until and h2_read, which hand them on.
pub fn sniff_h2c(h: rthttp.HConn, deadline: Int) -> Int {
  let hc = rec(h)
  let pre = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".bytes()
  var pk = ld(hc, HC_PEEK)
  if pk == 0 {
    pk = obj.alloc_obj(8 + 24)
    st(pk, 0, 0)
    st(hc, HC_PEEK, pk)
  }
  while true {
    let n = ld(pk, 0)
    for i in 0..n {
      if rt.mem_load(pk, 8 + i, 1) != Int(pre[i]) {
        return 0
      }
    }
    if n == 24 {
      return 1
    }
    let r = recv_raw(hc, pk + 8 + n, 24 - n, n == 0, deadline)
    if r <= 0 {
      return if r == -2 { -2 } else { -1 }
    }
    st(pk, 0, n + r)
  }
  0
}

/// The connection's poll descriptor.
pub fn pd(h: rthttp.HConn) -> Int { conn_pd(rec(h)) }

/// A stream's connection for its handler (h2srv.xo next): answered as a
/// connection is (http1.header_set, h2srv.respond, a sink); it takes
/// over a reference to the stream record st (dropped when it is freed)
/// and holds h.
pub fn stream(h: rthttp.HConn, sr: Int) -> rthttp.HConn {
  let hc = rec(h)
  let t = tasks.new_handle(HC_SIZE, rt.fn_addr("hc_free"))
  rc.inc(hc)
  st(t, HC_OWNER, hc)
  st(t, HC_H2S, sr)
  rt.mem_copy(t + HC_IPN, hc + HC_IPN, 8 + IP_MAX)
  take(t)
}

/// The stream record of a stream's connection (0: not a stream).
pub fn h2s(h: rthttp.HConn) -> Int { ld(rec(h), HC_H2S) }

/// The HTTP/2 settings block of connection hc's server (SR_H2CFG), 0 for
/// the defaults.
pub fn h2cfg_at(hc: Int) -> Int { rt.mem_load(rt.mem_load(hc, HC_SRV, 8), SR_H2CFG, 8) }
