// Two phase shutdown in Xo (core 7.5, decision 0042; the zero-C audit's
// work item B26, part 1): the first SIGINT or SIGTERM requests a stop
// (task.stop_requested, task.stopping's channel closes, the grace timer
// starts), the grace period's end or a second signal cancels main's root
// context, and a third exits with status 130 (in a test binary,
// testing.run_main returns 130 instead). The signal handlers (on_signal,
// on_console) and the entry stay C (xo_rt.c): a handler only counts the
// signal and wakes the poller, whose thread calls signal here (their
// installation and the entry's work around main are entry.xo's).
//
// The state is a record from the C runtime's malloc (rt.heap_large),
// made at start (init) and kept for the program's life, under its lock
// word. The cancellation of main's root, the clock, and the exit are Xo
// (pool.xo, the timers' clock as poll.xo now reads it, stdio.xo and
// process.xo), and the stopping channel's references (rc.xo and obj.xo);
// the timers and the channel, which sit above this module in the
// imports, are cabi.xo exports called through rt.fn_addr (decision
// 0233).
use native/llrt/ctx
use native/llrt/obj
use native/llrt/pool
use native/llrt/process
use native/llrt/rc
use native/llrt/stdio
use native/llrt/sysio
use native/llrt/twflags
use native/rt

/// rt.static_word: the state record, the C's services record.
const W_REC = 60
const W_SVC = 61

/// The state record's words: the lock word, the signals so far, whether
/// a stop was requested and main's root canceled (words read with
/// acquire), whether a third signal ended a test's main, when the stop
/// was requested (monotonic ns), the grace period, the next run_main's
/// grace period and whether one was set, the grace timer (a C xo_timer,
/// 64 bytes, from heap_large), task.stopping's channel (or 0), and main's
/// root node (or 0).
const R_MU = 0
const R_SIGNALS = 8
const R_REQUESTED = 16
const R_CANCELED = 24
const R_EXITED = 32
const R_STOP_AT = 40
const R_GRACE = 48
const R_HAS_NEXT = 56
const R_NEXT_GRACE = 64
const R_TIMER = 72
const R_STOPPING = 80
const R_ROOT = 88
const R_SIZE = 96

/// The C's services record: words 88 on are the entry's (entry.xo).
/// Words 0 to 80 are unused since decision 0233 step 2 (2026-10-15):
/// the timers, task.stopping's channel and its close, and the grace
/// timer's function are cabi.xo exports called through rt.fn_addr
/// (poll.xo, chan.xo and the exports sit above this module in the
/// imports); the cancellation, the clock, the exit and the channel's
/// references are Xo calls.

/// A timer's words (xo_rt.c struct xo_timer).
const T_WHEN = 0
const T_IDX = 8
const T_PARK = 16
const T_FN = 24
const T_SIZE = 64

/// The grace period by default: 30 s.
pub const DEFAULT_GRACE = 30000000000

/// The test world's real process effect (xo_rt.c TW_REAL_PROC).
const REAL_PROC = 64

const ACQUIRE = 1
const RELEASE = 2
const ACQ_REL = 3

fn rec() -> Int { rt.mem_load(rt.static_word(W_REC), 0, 8) }

/// Word k of the C's services record (entry.xo reads its own).
pub fn svc_word(k: Int) -> Int { rt.mem_load(rt.mem_load(rt.static_word(W_SVC), 0, 8), k, 8) }

fn lk() {
  let l = rec()
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
}

fn unlk() {
  let l = rec()
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

fn get(k: Int) -> Int { rt.mem_load(rec(), k, 8) }

fn put(k: Int, v: Int) { rt.mem_store(rec(), k, v, 8) }

/// Makes the state record and sets the C's services record (at start,
/// before any thread but main's).
pub fn init(svc_rec: Int) {
  rt.mem_store(rt.static_word(W_SVC), 0, svc_rec, 8)
  let r = rt.heap_large(R_SIZE)
  rt.mem_set(r, 0, R_SIZE)
  rt.mem_store(r, R_GRACE, DEFAULT_GRACE, 8)
  let t = rt.heap_large(T_SIZE)
  rt.mem_set(t, 0, T_SIZE)
  rt.mem_store(t, T_IDX, -1, 8)
  rt.mem_store(r, R_TIMER, t, 8)
  rt.mem_store(rt.static_word(W_REC), 0, r, 8)
}

/// Whether a stop was requested (task.stop_requested).
pub fn requested() -> Bool { rt.slot_load(rec(), R_REQUESTED / 8, ACQUIRE) != 0 }

/// Whether the stop canceled main's root context.
pub fn canceled() -> Bool { rt.slot_load(rec(), R_CANCELED / 8, ACQUIRE) != 0 }

/// Main's root context (a node), or 0.
pub fn root() -> Int { rt.slot_load(rec(), R_ROOT / 8, ACQUIRE) }

/// Sets main's root context to n unless one is set (run_main's start).
pub fn set_root(n: Int) {
  let _ok = rt.slot_cas(rec(), R_ROOT / 8, 0, n, ACQ_REL)
}

/// Enters phase 2: main's root context is canceled (once).
pub fn cancel() {
  let n = root()
  if n != 0 && rt.slot_cas(rec(), R_CANCELED / 8, 0, 1, ACQ_REL) {
    pool.node_cancel(ctx.pool(), n)
  }
}

/// The timers' clock (poll.xo now, which this module sits below): the
/// test world's virtual one while it runs, else the monotonic one.
fn now() -> Int {
  let tw = twflags.vclock()
  if tw != 0 {
    // TW_VNOW is a byte offset; a slot's index counts words
    return rt.slot_load(tw + twflags.TW_VNOW, 0, ACQUIRE)
  }
  sysio.mono_ns()
}

/// The monotonic time d from now (saturating).
fn deadline(d: Int) -> Int {
  let now = now()
  if d > 0 && now > 9223372036854775807 - d {
    return 9223372036854775807
  }
  now + d
}

/// Arms the grace timer for the time left (the lock held).
fn arm_grace() {
  let t = get(R_TIMER)
  let _d = rt.call_c2(rt.fn_addr("poll_timer_del"), t, 0)
  if canceled() {
    return
  }
  let left = get(R_GRACE) - (now() - get(R_STOP_AT))
  if left <= 0 {
    cancel()
    return
  }
  rt.mem_store(t, T_WHEN, deadline(left), 8)
  rt.mem_store(t, T_FN, rt.fn_addr("stop_cancel"), 8)
  rt.mem_store(t, T_PARK, 0, 8)
  let _a = rt.call_c2(rt.fn_addr("poll_timer_add"), t, 0)
}

/// Handles SIGINT or SIGTERM (on the poller thread, or a test's
/// FakeProc.signal_after timer).
pub fn signal() {
  lk()
  let n = get(R_SIGNALS) + 1
  put(R_SIGNALS, n)
  if n == 1 {
    put(R_STOP_AT, now())
    rt.slot_store(rec(), R_REQUESTED / 8, 1, RELEASE)
    let ch = get(R_STOPPING)
    if ch != 0 {
      let _c = rt.call_c2(rt.fn_addr("chan_close"), ch, 0)
    }
    arm_grace()
  } else if n == 2 {
    cancel()
  } else if twflags.fake(REAL_PROC) {
    // a test's run_main returns 130 once main has unwound
    // (FakeProc.exit_code is Some(130))
    put(R_EXITED, 1)
    cancel()
  } else {
    unlk()
    cancel()
    // the third signal: status 130 at once, the output flushed
    stdio.flush()
    process.os_exit(130)
    return
  }
  unlk()
}

/// task.stopping(): the channel closed when a stop is requested, made on
/// first use (drop releases values someone sends on it); a new reference.
pub fn stopping(drop: Int) -> Int {
  lk()
  var ch = get(R_STOPPING)
  if ch == 0 {
    ch = rt.call_c2(rt.fn_addr("stop_chan_new"), drop, 0)
    put(R_STOPPING, ch)
    if requested() {
      let _c = rt.call_c2(rt.fn_addr("chan_close"), ch, 0)
    }
  }
  rc.inc(ch)
  unlk()
  ch
}

/// proc.set_grace(d): after a stop request the deadline moves to the stop
/// time plus d; in a test binary before testing.run_main, the grace
/// period of the next run.
pub fn set_grace(d0: Int) {
  let d = if d0 < 0 { 0 } else { d0 }
  lk()
  if twflags.fake(REAL_PROC) && !twflags.in_main() {
    put(R_HAS_NEXT, 1)
    put(R_NEXT_GRACE, d)
    unlk()
    return
  }
  put(R_GRACE, d)
  if requested() {
    arm_grace()
  }
  unlk()
}

/// Releases task.stopping's channel (at exit).
pub fn end() {
  lk()
  let ch = get(R_STOPPING)
  put(R_STOPPING, 0)
  unlk()
  if ch != 0 {
    h_release(ch)
  }
}

/// testing.run_main's start: a fresh state with root n.
pub fn reset(n: Int) {
  lk()
  put(R_SIGNALS, 0)
  rt.slot_store(rec(), R_REQUESTED / 8, 0, RELEASE)
  rt.slot_store(rec(), R_CANCELED / 8, 0, RELEASE)
  put(R_EXITED, 0)
  put(R_GRACE, if get(R_HAS_NEXT) != 0 { get(R_NEXT_GRACE) } else { DEFAULT_GRACE })
  rt.slot_store(rec(), R_ROOT / 8, n, RELEASE)
  let ch = get(R_STOPPING)
  put(R_STOPPING, 0)
  unlk()
  if ch != 0 {
    h_release(ch)
  }
}

/// testing.run_main's end: root n is gone and the grace timer disarmed;
/// whether a third signal ended main (1 or 0).
pub fn unroot(n: Int) -> Int {
  lk()
  if root() == n {
    rt.slot_store(rec(), R_ROOT / 8, 0, RELEASE)
  }
  let e = get(R_EXITED)
  put(R_EXITED, 0)
  let _d = rt.call_c2(rt.fn_addr("poll_timer_del"), get(R_TIMER), 0)
  unlk()
  e
}

/// Drops a reference to the stopping channel ch (tasks.xo h_release,
/// which sits above this module): the last one frees it.
fn h_release(ch: Int) {
  if rc.dec(ch) != 0 {
    obj.h_free_n(ch)
  }
}
