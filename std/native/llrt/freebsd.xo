pub const EVFILT_WRITE: Int = -2
pub const EVFILT_USER: Int = -11
pub const EV_ADD: Int = 1
pub const EV_DELETE: Int = 2
pub const EV_ENABLE: Int = 4
pub const EV_DISABLE: Int = 8
pub const EV_ONESHOT: Int = 16
pub const EV_CLEAR: Int = 32
pub const EV_EOF: Int = 32768
pub const EV_ERROR: Int = 16384
pub const NOTE_TRIGGER: Int = 16777216

// struct sigaction and stack_t (sys/signal.h)
pub const SA_HANDLER: Int = 0
pub const SA_FLAGS_AT: Int = 8
pub const SA_MASK: Int = 12
pub const SA_SIZE: Int = 32
pub const SA_ONSTACK: Int = 1
pub const SA_RESTART: Int = 2
pub const SA_SIGINFO: Int = 64
pub const SIGBUS: Int = 10
