pub const SIGPIPE: Int = 13
pub const SIGURG: Int = 16
pub const SIGCHLD: Int = 20
pub const SIGPROF: Int = 27
pub const SIG_BLOCK: Int = 1
pub const SIG_SETMASK: Int = 3
pub const SS_SIZE_AT: Int = 8
