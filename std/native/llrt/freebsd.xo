// The FreeBSD system call layer of the native runtime, written in Xo
// (decision 0573): raw system calls through rt.sys6, as linux.xo's. The
// emitters turn FreeBSD's error convention (the carry flag set and a
// positive errno) into Linux's, so a call returns a result >= 0 or a
// negative errno. FreeBSD has one system call table for amd64 and arm64
// (sys/kern/syscalls.master), so no number depends on the architecture.
//
// Stage 1 of decision 0573 (hello world): write, exit, the memory
// mappings and the main thread's TLS. Only the FreeBSD arms of llrt call
// this module, so it is code generated only for FreeBSD targets (core
// 12.2).
use native/llrt/obj
use native/llrt/raw
use native/rt

pub const EINTR: Int = 4
pub const EAGAIN: Int = 35

// mmap flags (sys/mman.h): MAP_PRIVATE, MAP_ANON; FreeBSD has no
// MAP_NORESERVE (it never reserves swap for an anonymous mapping)
pub const MAP_PRIVATE: Int = 2
pub const MAP_ANON: Int = 4096

/// write(2) of the n bytes at a: the bytes written, or the negative
/// errno.
pub fn write_at(fd: Int, a: Int, n: Int) -> Int { rt.sys6(4, fd, a, n, 0, 0, 0) }

/// exit(2): ends the process with status code (every thread).
pub fn exit(code: Int) -> Int { rt.sys6(1, code, 0, 0, 0, 0, 0) }

/// mmap(2): the address, or the negative errno.
pub fn mmap(addr: Int, len: Int, prot: Int, flags: Int, fd: Int, off: Int) -> Int {
  rt.sys6(477, addr, len, prot, flags, fd, off)
}

/// munmap(2).
pub fn munmap(addr: Int, len: Int) -> Int { rt.sys6(73, addr, len, 0, 0, 0, 0) }

/// mprotect(2).
pub fn mprotect(addr: Int, len: Int, prot: Int) -> Int { rt.sys6(74, addr, len, prot, 0, 0, 0) }

/// madvise(2) (MADV_DONTNEED 4, MADV_FREE 5).
pub fn madvise(addr: Int, len: Int, advice: Int) -> Int { rt.sys6(75, addr, len, advice, 0, 0, 0) }

/// getpid(2).
pub fn getpid() -> Int { rt.sys6(20, 0, 0, 0, 0, 0, 0) }

/// The amd64 thread pointer (the fs base) of the calling thread:
/// sysarch(AMD64_SET_FSBASE, &tp), which reads the base from memory, so
/// tp is stored in the 8 bytes at scratch first; 0 or the negative errno.
/// (arm64's tpidr_el0 is a register user code writes.)
pub fn set_fsbase(tp: Int, scratch: Int) -> Int {
  rt.mem_store(scratch, 0, tp, 8)
  rt.sys6(165, 129, scratch, 0, 0, 0, 0)
}

// ---------------------------------------------------------------------------
// Stage 2 of decision 0573: threads, the futex, time

pub const CLOCK_REALTIME: Int = 0
pub const CLOCK_MONOTONIC: Int = 4

// _umtx_op's operations on a private 32 bit word (sys/umtx.h)
pub const UMTX_OP_WAIT_UINT_PRIVATE: Int = 15
pub const UMTX_OP_WAKE_PRIVATE: Int = 16

/// clock_gettime(2) into the timespec at ts.
pub fn clock_gettime(id: Int, ts: Int) -> Int { rt.sys6(232, id, ts, 0, 0, 0, 0) }

/// nanosleep(2) of the timespec at ts.
pub fn nanosleep_at(ts: Int) -> Int { rt.sys6(240, ts, 0, 0, 0, 0, 0) }

/// _umtx_op(2) on the 32 bit word at addr: op, val, and uaddr/uaddr2
/// (for a wait with a timeout: uaddr the size of the timespec as an
/// address, uaddr2 the timespec's address; 0 and 0 for none).
pub fn umtx_op(addr: Int, op: Int, val: Int, uaddr: Int, uaddr2: Int) -> Int {
  rt.sys6(454, addr, op, val, uaddr, uaddr2, 0)
}

/// Waits while the 32 bit word at addr holds val (the futex's
/// FUTEX_WAIT), with the relative timespec at ts or none for 0.
pub fn futex_wait(addr: Int, val: Int, ts: Int) -> Int {
  umtx_op(addr, UMTX_OP_WAIT_UINT_PRIVATE, val, if ts == 0 { 0 } else { 16 }, ts)
}

/// Wakes up to n waiters of the word at addr (FUTEX_WAKE).
pub fn futex_wake(addr: Int, n: Int) -> Int { umtx_op(addr, UMTX_OP_WAKE_PRIVATE, n, 0, 0) }

// struct thr_param (sys/thr.h), the same on amd64 and arm64
pub const TP_START_FUNC: Int = 0
pub const TP_ARG: Int = 8
pub const TP_STACK_BASE: Int = 16
pub const TP_STACK_SIZE: Int = 24
pub const TP_TLS_BASE: Int = 32
pub const TP_TLS_SIZE: Int = 40
pub const TP_CHILD_TID: Int = 48
pub const TP_PARENT_TID: Int = 56
pub const TP_FLAGS: Int = 64
pub const TP_RTP: Int = 72
pub const TP_SIZE: Int = 104

/// thr_new(2) with the struct thr_param at p (TP_*): 0 or the negative
/// errno.
pub fn thr_new(p: Int) -> Int { rt.sys6(455, p, TP_SIZE, 0, 0, 0, 0) }

/// thr_self(2): stores the calling thread's id at the 8 bytes at a.
pub fn thr_self(a: Int) -> Int { rt.sys6(432, a, 0, 0, 0, 0, 0) }

/// thr_exit(2): ends the calling thread, storing 1 to the long at state
/// and waking its waiters (a shared wake; 0 for none).
pub fn thr_exit(state: Int) -> Int { rt.sys6(431, state, 0, 0, 0, 0, 0) }

/// thr_kill(2): sends sig to the thread id.
pub fn thr_kill(id: Int, sig: Int) -> Int { rt.sys6(433, id, sig, 0, 0, 0, 0) }

/// Clock id's time in nanoseconds, with the 16 bytes at a for the
/// timespec, or the negative errno.
pub fn clock_ns(id: Int, a: Int) -> Int {
  let r = clock_gettime(id, a)
  if r < 0 {
    return r
  }
  rt.mem_load(a, 0, 8).wrapping_mul(1000000000).wrapping_add(rt.mem_load(a, 8, 8))
}

// ---------------------------------------------------------------------------
// Files (stage 2 of decision 0573): the *at calls relative to the working
// directory, as linux.xo's. errno values below 35 are Linux's; the
// messages and the FsErr mapping are the BSDs' (darwin.err_msg and
// darwin.fs_status, pure tables).

/// getrandom(2) (563) of 8 bytes at addr: true when it gave them.
pub fn random_at(addr: Int) -> Bool { rt.sys6(563, addr, 8, 0, 0, 0, 0) == 8 }

/// getrandom(2) of n bytes: the bytes and 0, or the errno.
pub fn random(n: Int) -> (Bytes, Int) {
  let buf = raw.bytes_buf(n)
  var off = 0
  while off < n {
    let r = rt.sys6(563, raw.bytes_addr(buf) + off, n - off, 0, 0, 0, 0)
    if r < 0 {
      if -r == 4 {
        continue
      }
      return (b"", -r)
    }
    off += r
  }
  (buf, 0)
}

/// __getcwd(2) (326): the working directory, "." when the system gives
/// none. It returns 0 (not the length, as Linux's does) and ends the
/// path with a zero byte.
pub fn getcwd() -> Str {
  let buf = raw.bytes_buf(4096)
  let a = raw.bytes_addr(buf)
  if rt.sys6(326, a, 4096, 0, 0, 0, 0) != 0 || rt.mem_load(a, 0, 1) != 47 {
    let _k = keep(buf, 0)
    return "."
  }
  var n = 0
  while n < 4096 && rt.mem_load(a, n, 1) != 0 {
    n += 1
  }
  let w = raw.str_at(a, n)
  let _k = keep(buf, 0)
  w
}

pub const AT_FDCWD: Int = -100
const AT_SYMLINK_NOFOLLOW: Int = 512

// open flags (sys/fcntl.h)
pub const O_RDONLY: Int = 0
pub const O_WRONLY: Int = 1
pub const O_RDWR: Int = 2
pub const O_APPEND: Int = 8
pub const O_CREAT: Int = 512
pub const O_TRUNC: Int = 1024
pub const O_EXCL: Int = 2048
pub const O_CLOEXEC: Int = 1048576
pub const O_NONBLOCK: Int = 4

// fcntl(2) commands and descriptor flags (sys/fcntl.h)
pub const F_SETFD: Int = 2
pub const F_GETFL: Int = 3
pub const F_SETFL: Int = 4
pub const FD_CLOEXEC: Int = 1

/// The facts of a stat: the kind and permission bits, the size, and the
/// modification time in Unix nanoseconds (linux.Stat's).
pub struct Stat {
  pub mode: Int
  pub size: Int
  pub mtime: Int
}

/// Whether st is a directory (S_IFDIR).
pub fn is_dir(st: Stat) -> Bool { (st.mode & 61440) == 16384 }

/// Whether st is a symbolic link (S_IFLNK).
pub fn is_link(st: Stat) -> Bool { (st.mode & 61440) == 40960 }

fn cpath(path: Str) -> Bytes {
  let p = if path.is_empty() { "." } else { path }
  var s = BytesBuilder.with_capacity(p.len() + 1)
  s.write(p.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// r, after b's last use (the buffer stays alive across the call).
fn keep(b: Bytes, r: Int) -> Int {
  if b.len() < 0 {
    return -1
  }
  r
}

/// read(2) into the bytes of buf from off on (at most n of them).
pub fn read(fd: Int, buf: Bytes, off: Int, n: Int) -> Int {
  let r = rt.sys6(3, fd, raw.bytes_addr(buf) + off, raw.io_len(n), 0, 0, 0)
  keep(buf, r)
}

/// read(2) of at most n bytes to the address a.
pub fn read_at(fd: Int, a: Int, n: Int) -> Int { rt.sys6(3, fd, a, raw.io_len(n), 0, 0, 0) }

/// write(2) of the bytes lo..hi of b.
pub fn write(fd: Int, b: Bytes, lo: Int, hi: Int) -> Int {
  let r = rt.sys6(4, fd, raw.bytes_addr(b) + lo, raw.io_len(hi - lo), 0, 0, 0)
  keep(b, r)
}

/// Writes all of b (retrying after EINTR and short writes): 0, or the
/// errno.
pub fn write_all(fd: Int, b: Bytes) -> Int {
  var off = 0
  let n = b.len()
  while off < n {
    let w = write(fd, b, off, n)
    if w < 0 {
      if -w == EINTR {
        continue
      }
      return -w
    }
    off += w
  }
  0
}

/// openat(2) of path: the descriptor, or the negative errno.
pub fn open(path: Str, flags: Int, mode: Int) -> Int {
  let z = cpath(path)
  let r = rt.sys6(499, AT_FDCWD, raw.bytes_addr(z), flags, mode, 0, 0)
  keep(z, r)
}

/// close(2).
pub fn close(fd: Int) -> Int { rt.sys6(6, fd, 0, 0, 0, 0, 0) }

/// fcntl(2) of fd: cmd's result, or the negative errno.
pub fn fcntl(fd: Int, cmd: Int, arg: Int) -> Int { rt.sys6(92, fd, cmd, arg, 0, 0, 0) }

/// pipe2(2): the two 32 bit descriptors at p (read end first) with flags
/// (O_CLOEXEC, O_NONBLOCK); 0 or the negative errno.
pub fn pipe2(p: Int, flags: Int) -> Int { rt.sys6(542, p, flags, 0, 0, 0, 0) }

/// kqueue(2): the descriptor, or the negative errno.
pub fn kqueue() -> Int { rt.sys6(362, 0, 0, 0, 0, 0, 0) }

/// kevent(2) with nch changes at ch and room for nev events at evs (struct
/// kevent, KEV_SIZE bytes each), waiting at most the timespec at ts (0:
/// no limit): the events' count, or the negative errno.
pub fn kevent(kq: Int, ch: Int, nch: Int, evs: Int, nev: Int, ts: Int) -> Int {
  rt.sys6(560, kq, ch, nch, evs, nev, ts)
}

/// fsync(2).
pub fn fsync(fd: Int) -> Int { rt.sys6(95, fd, 0, 0, 0, 0, 0) }

/// fstatat(2) of path (following a final symbolic link when follow): the
/// facts and 0, or the errno.
pub fn stat(path: Str, follow: Bool) -> (Stat, Int) {
  let z = cpath(path)
  let buf = obj.scratch()
  let r = rt.sys6(552, AT_FDCWD, raw.bytes_addr(z), buf, if follow { 0 } else { AT_SYMLINK_NOFOLLOW }, 0, 0)
  keep(z, 0)
  stat_of(buf, r)
}

/// fstat(2) of the open descriptor fd.
pub fn fstat(fd: Int) -> (Stat, Int) {
  let buf = obj.scratch()
  stat_of(buf, rt.sys6(551, fd, buf, 0, 0, 0, 0))
}

// struct stat (sys/stat.h, FreeBSD 12 and later), the same on amd64 and
// arm64: st_mode is 16 bits, st_mtim a timespec
pub const ST_MODE: Int = 24
pub const ST_MTIM: Int = 64
pub const ST_SIZE: Int = 112
pub const ST_SIZEOF: Int = 224

/// The facts of the struct stat at buf, or the errno of r < 0.
fn stat_of(buf: Int, r: Int) -> (Stat, Int) {
  if r < 0 {
    return (Stat{mode: 0, size: 0, mtime: 0}, -r)
  }
  let mode = rt.mem_load(buf, ST_MODE, 2)
  let sec = rt.mem_load(buf, ST_MTIM, 8)
  let nsec = rt.mem_load(buf, ST_MTIM + 8, 8)
  (Stat{mode: mode, size: rt.mem_load(buf, ST_SIZE, 8), mtime: sec * 1000000000 + nsec}, 0)
}

// ---------------------------------------------------------------------------
// Layouts for the poller and signals (stage 2 of decision 0573, parked
// for the VM lane: nothing uses them yet). TestFreeBSDABI checks them
// against FreeBSD's headers.

// struct kevent (sys/event.h, FreeBSD 12 and later)
pub const KEV_IDENT: Int = 0
pub const KEV_FILTER: Int = 8
pub const KEV_FLAGS: Int = 10
pub const KEV_FFLAGS: Int = 12
pub const KEV_DATA: Int = 16
pub const KEV_UDATA: Int = 24
pub const KEV_SIZE: Int = 64
pub const EVFILT_READ: Int = -1
pub const EVFILT_WRITE: Int = -2
pub const EVFILT_USER: Int = -11
pub const EV_ADD: Int = 1
pub const EV_DELETE: Int = 2
pub const EV_ENABLE: Int = 4
pub const EV_DISABLE: Int = 8
pub const EV_ONESHOT: Int = 16
pub const EV_CLEAR: Int = 32
pub const EV_EOF: Int = 32768
pub const EV_ERROR: Int = 16384
pub const NOTE_TRIGGER: Int = 16777216

/// sigaction(2) with the struct sigaction at act (SA_*; 0 to read only)
/// and the old one stored at old (0 for none). FreeBSD's kernel supplies
/// the return trampoline (no SA_RESTORER).
pub fn sigaction(sig: Int, act: Int, old: Int) -> Int { rt.sys6(416, sig, act, old, 0, 0, 0) }

/// sigprocmask(2) 340: how (SIG_BLOCK 1, SIG_UNBLOCK 2, SIG_SETMASK 3),
/// the 16-byte sigset at set, the old one at old (or 0).
pub fn sigprocmask(how: Int, set: Int, old: Int) -> Int { rt.sys6(340, how, set, old, 0, 0, 0) }

// struct sigaction and stack_t (sys/signal.h)
pub const SA_HANDLER: Int = 0
pub const SA_FLAGS_AT: Int = 8
pub const SA_MASK: Int = 12
pub const SA_SIZE: Int = 32
pub const SA_ONSTACK: Int = 1
pub const SA_RESTART: Int = 2
pub const SA_SIGINFO: Int = 64
pub const SIGBUS: Int = 10
pub const SIGSEGV: Int = 11
pub const SIGPIPE: Int = 13
pub const SIGURG: Int = 16
pub const SIGCHLD: Int = 20
pub const SIGPROF: Int = 27
pub const SIG_BLOCK: Int = 1
pub const SIG_SETMASK: Int = 3
pub const SS_SIZE_AT: Int = 8
pub const SS_FLAGS_AT: Int = 16
pub const SS_SIZEOF: Int = 24
pub const UC_MCONTEXT: Int = 16

// ---------------------------------------------------------------------------
// File system calls for fsops (layer 4). FreeBSD's syscall numbers are the
// same on amd64 and arm64.

pub const O_DIRECTORY: Int = 131072
const AT_REMOVEDIR: Int = 2048

/// mkdirat(2) of path with mode: 0, or -errno.
pub fn mkdir(path: Str, mode: Int) -> Int {
  let z = cpath(path)
  keep(z, rt.sys6(496, AT_FDCWD, raw.bytes_addr(z), mode, 0, 0, 0))
}

/// unlinkat(2) of path (AT_REMOVEDIR for a directory): 0, or -errno.
pub fn unlink(path: Str, dir: Bool) -> Int {
  let z = cpath(path)
  keep(z, rt.sys6(503, AT_FDCWD, raw.bytes_addr(z), if dir { AT_REMOVEDIR } else { 0 }, 0, 0, 0))
}

/// renameat(2) of a to b (as written: "" is no file).
pub fn rename(a: Str, b: Str) -> Int {
  let za = zpath(a)
  let zb = zpath(b)
  let r = rt.sys6(501, AT_FDCWD, raw.bytes_addr(za), AT_FDCWD, raw.bytes_addr(zb), 0, 0)
  keep(za, keep(zb, r))
}

/// symlinkat(2): a link at path to target.
pub fn symlink(target: Str, path: Str) -> Int {
  let zt = zpath(target)
  let zp = zpath(path)
  let r = rt.sys6(502, raw.bytes_addr(zt), AT_FDCWD, raw.bytes_addr(zp), 0, 0, 0)
  keep(zt, keep(zp, r))
}

/// readlinkat(2) of path: the target and 0, or "" and the errno.
pub fn readlink(path: Str) -> (Str, Int) {
  let z = zpath(path)
  let buf = raw.bytes_buf(4096)
  let r = rt.sys6(500, AT_FDCWD, raw.bytes_addr(z), raw.bytes_addr(buf), 4096, 0, 0)
  if keep(z, r) < 0 {
    return ("", -r)
  }
  let t = raw.str_at(raw.bytes_addr(buf), r)
  let _k = keep(buf, 0)
  (t, 0)
}

/// fchmodat(2) of path to mode.
pub fn chmod(path: Str, mode: Int) -> Int {
  let z = cpath(path)
  keep(z, rt.sys6(490, AT_FDCWD, raw.bytes_addr(z), mode, 0, 0, 0))
}

/// utimensat(2): path's access and modification times both sec, nsec.
pub fn utimens(path: Str, sec: Int, nsec: Int) -> Int {
  let z = cpath(path)
  let ts = raw.bytes_buf(32)
  let a = raw.bytes_addr(ts)
  rt.mem_store(a, 0, sec, 8)
  rt.mem_store(a, 8, nsec, 8)
  rt.mem_store(a, 16, sec, 8)
  rt.mem_store(a, 24, nsec, 8)
  let r = rt.sys6(547, AT_FDCWD, raw.bytes_addr(z), a, 0, 0, 0)
  keep(ts, keep(z, r))
}

/// pread(2) of at most n bytes into the address a from offset off.
pub fn pread_at(fd: Int, a: Int, n: Int, off: Int) -> Int { rt.sys6(475, fd, a, raw.io_len(n), off, 0, 0) }

/// pwrite(2) of at most n bytes from the address a at offset off.
pub fn pwrite_at(fd: Int, a: Int, n: Int, off: Int) -> Int { rt.sys6(476, fd, a, raw.io_len(n), off, 0, 0) }

/// ftruncate(2) of fd to size bytes.
pub fn ftruncate(fd: Int, size: Int) -> Int { rt.sys6(480, fd, size, 0, 0, 0, 0) }

/// flock(2) of fd.
pub fn flock(fd: Int, op: Int) -> Int { rt.sys6(131, fd, op, 0, 0, 0, 0) }

/// The entries of the directory path (not `.` and `..`), each with its
/// type's byte first when typed (linux.entries' `d`, `l`, `f`, `?`), and
/// 0, or the errno. getdirentries(2); struct dirent (FreeBSD 12 and
/// later): d_reclen (u16) at 16, d_type at 18, d_namlen (u16) at 20,
/// d_name at 24.
pub fn dir_list(path: Str, typed: Bool) -> (List[Str], Int) {
  var fd = open(path, O_RDONLY | O_CLOEXEC | O_DIRECTORY, 0)
  while fd == -EINTR {
    fd = open(path, O_RDONLY | O_CLOEXEC | O_DIRECTORY, 0)
  }
  if fd < 0 {
    return ([], -fd)
  }
  var out: List[Str] = []
  let buf = raw.bytes_buf(16352)
  let a = raw.bytes_addr(buf)
  while true {
    let n = rt.sys6(554, fd, a, 16352, 0, 0, 0)
    if n == -EINTR {
      continue
    }
    if n < 0 {
      let _k = keep(buf, 0)
      let _c = close(fd)
      return ([], -n)
    }
    if n == 0 {
      break
    }
    var off = 0
    while off < n {
      let rl = rt.mem_load(a + off, 16, 2)
      if rl == 0 {
        break
      }
      let k = rt.mem_load(a + off, 20, 2)
      let name = a + off + 24
      let dot = (k == 1 && rt.mem_load(name, 0, 1) == 46) || (k == 2 && rt.mem_load(name, 0, 1) == 46 && rt.mem_load(name, 1, 1) == 46)
      if !dot {
        let s = raw.str_at(name, k)
        if typed {
          let t = rt.mem_load(a + off, 18, 1)
          let p = if t == 4 { "d" } else if t == 10 { "l" } else if t == 0 { "?" } else { "f" }
          out.push(p + s)
        } else {
          out.push(s)
        }
      }
      off += rl
    }
  }
  let _k = keep(buf, 0)
  let _c = close(fd)
  (out, 0)
}

fn zpath(path: Str) -> Bytes {
  var s = BytesBuilder.with_capacity(path.len() + 1)
  s.write(path.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}
