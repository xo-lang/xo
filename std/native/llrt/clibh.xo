// C library handles (decision 0574 stage 2): a value of a type C cannot
// hold (a struct, an enum, a List, ...) crosses to C as an XoHandle, a
// slot of one table per library that keeps the value as an rt.Any with
// one count of its own. The handle is the slot plus one in its low 32
// bits and the slot's generation in its high bits, so a handle used
// after xo_release (or never made) faults instead of reading another
// value. The table is C memory (malloc: a library links the C library)
// in chunks that never move or go; hput and release take its lock, and a
// read takes none: the generated wrapper (compiler/ssa declare_c_export)
// starts a read (read_begin: the thread's heap record shows the table's
// epoch), takes a handle parameter's value in place (addr,
// anyval.clib_peek, rt.obj_peek: no count unless the function keeps it),
// and ends the read after the call; a released value waits on a list
// until no read began before its release. Results go through hput.
use native/llrt/heapos
use native/llrt/pool
use native/llrt/raw
use native/llrt/rc
use native/llrt/scan
use native/llrt/tasks
use native/rt
use native/sys_c

/// The table's address (0 until the first handle), its lock, its epoch
/// (1 at first; each release adds 1) and the released values' list
/// (static words, rt.xo's table).
const W_TAB = 101
const W_LOCK = 102
const W_EPOCH = 103
const W_RETIRED = 104
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2
const SEQ_CST = 4
/// The table: the slots used so far, the first free slot plus one (0
/// none), then CHUNKS chunk addresses (0 not made yet), each of CHUNK
/// slots of two words: the Any's address (a free slot: the next free
/// slot plus one, shifted left once, with bit 0 set) and the slot's
/// generation. Chunks are never freed, so a read needs no lock to reach
/// a slot.
const T_LEN = 0
const T_FREE = 8
const T_CHUNKS = 16
const CHUNKS = 4096
const CHUNK = 1024
/// The released values' list: its capacity, its length, then pairs of a
/// value's address and the epoch it was released at.
const R_CAP = 0
const R_LEN = 8
const R_PAIRS = 16

fn lock() {
  let l = rt.static_word(W_LOCK)
  if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
    pool.lock_slow(l)
  }
  pool.held(1)
}

fn unlock() {
  let l = rt.static_word(W_LOCK)
  pool.held(-1)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    pool.futex_wake(l)
  }
}

/// v as a handle: the table keeps it (the caller shared it first, since
/// any C thread may use the handle).
pub fn hput[T](v: T) -> Int { put(rt.any_of(v)) }

/// The address of slot s's first word in table t (its chunk made).
fn slot(t: Int, s: Int) -> Int {
  rt.mem_load(t, T_CHUNKS + 8 * (s / CHUNK), 8) + 16 * (s % CHUNK)
}

/// a as a handle: the table holds one count of it.
pub fn put(a: rt.Any) -> Int {
  let p = rt.obj_addr(a)
  rc.inc(p)
  lock()
  var t = rt.mem_load(rt.static_word(W_TAB), 0, 8)
  if t == 0 {
    t = make_table()
  }
  var s = -1
  if rt.mem_load(t, T_FREE, 8) != 0 {
    s = rt.mem_load(t, T_FREE, 8) - 1
    rt.mem_store(t, T_FREE, rt.mem_load(slot(t, s), 0, 8).shr_logical(1), 8)
  } else {
    s = rt.mem_load(t, T_LEN, 8)
    if s % CHUNK == 0 {
      make_chunk(t, s / CHUNK)
    }
    // a slot's words before the length that shows it (release)
    rt.slot_store(t + T_LEN, 0, s + 1, RELEASE)
  }
  let w = slot(t, s)
  rt.slot_store(w, 0, p, RELEASE)
  let g = rt.mem_load(w, 8, 8)
  unlock()
  g.wrapping_shl(32) | (s + 1)
}

/// Starts a C export's read of its handle parameters (the generated
/// wrapper, compiler/ssa declare_c_export): a value released from now
/// on stays until read_end. Returns what read_end takes.
pub fn read_begin() -> Int {
  heapos.c_read_begin(rt.slot_load(rt.static_word(W_EPOCH), 0, ACQUIRE))
}

/// Ends the read read_begin started (old: what it returned).
pub fn read_end(old: Int) { heapos.c_read_end(old) }

/// The Any address of handle h, inside a read (read_begin); a fault for
/// a handle that is not live.
pub fn addr(h: Int) -> Int {
  let p = live(h)
  if p == 0 {
    rt.fault_raise("XoHandle ${h} is not live (released, or never made)", "")
  }
  p
}

/// The fault for handle h holding a value of another type than the
/// parameter's.
pub fn wrong_type(h: Int) {
  rt.fault_raise("XoHandle ${h} holds a value of another type", "")
}

/// Drops handle h (xo_release): its slot goes back, and the value goes
/// when nothing else holds it and no read that began before this one
/// ended. 0 does nothing; a handle that is not live faults.
pub fn release(h: Int) {
  if h == 0 {
    return
  }
  lock()
  let p = live(h)
  if p == 0 {
    unlock()
    rt.fault_raise("XoHandle ${h} is not live (released twice, or never made)", "")
  }
  let t = rt.mem_load(rt.static_word(W_TAB), 0, 8)
  let s = (h & 4294967295) - 1
  let w = slot(t, s)
  rt.slot_store(w, 0, rt.mem_load(t, T_FREE, 8).wrapping_shl(1) | 1, RELEASE)
  rt.slot_store(w, 1, (h.shr_logical(32) + 1) & 2147483647, RELEASE)
  rt.mem_store(t, T_FREE, s + 1, 8)
  let ew = rt.static_word(W_EPOCH)
  let e = rt.slot_load(ew, 0, RELAXED)
  // a read that saw the new epoch sees the slot freed (release); then
  // the full fence orders this store before the records' epochs are read
  rt.slot_store(ew, 0, e + 1, RELEASE)
  rt.fence(SEQ_CST)
  let m = heapos.c_read_min(e + 1)
  let r = rt.mem_load(rt.static_word(W_RETIRED), 0, 8)
  if m > e && (r == 0 || rt.mem_load(r, R_LEN, 8) == 0) {
    // no read began before this release and nothing waits: drop it now
    unlock()
    tasks.h_release(p)
    return
  }
  retire(p, e)
  let done = reclaim(m)
  unlock()
  for q in done {
    tasks.h_release(q)
  }
}

/// The Any address of live handle h, else 0 (acquire loads: a read
/// without the lock sees a slot's words as put or release wrote them).
fn live(h: Int) -> Int {
  let t = rt.slot_load(rt.static_word(W_TAB), 0, ACQUIRE)
  let s = (h & 4294967295) - 1
  if t == 0 || s < 0 || s >= rt.slot_load(t + T_LEN, 0, ACQUIRE) {
    return 0
  }
  let w = slot(t, s)
  let p = rt.slot_load(w, 0, ACQUIRE)
  if p & 1 != 0 || rt.slot_load(w, 1, ACQUIRE) != h.shr_logical(32) {
    return 0
  }
  p
}

/// A new table, published (the lock held).
fn make_table() -> Int {
  let n = sys_c.weak_malloc(T_CHUNKS + 8 * CHUNKS)
  if n == 0 {
    unlock()
    rt.fault_raise("no memory for the XoHandle table", "")
  }
  rt.mem_set(n, 0, T_CHUNKS + 8 * CHUNKS)
  rt.slot_store(rt.static_word(W_EPOCH), 0, 1, RELEASE)
  rt.slot_store(rt.static_word(W_TAB), 0, n, RELEASE)
  n
}

/// Chunk k of table t, made and published (the lock held).
fn make_chunk(t: Int, k: Int) {
  if k >= CHUNKS {
    unlock()
    rt.fault_raise("too many live XoHandles (${CHUNKS * CHUNK})", "")
  }
  let c = sys_c.weak_malloc(16 * CHUNK)
  if c == 0 {
    unlock()
    rt.fault_raise("no memory for the XoHandle table", "")
  }
  rt.mem_set(c, 0, 16 * CHUNK)
  rt.slot_store(t + T_CHUNKS + 8 * k, 0, c, RELEASE)
}

/// Adds value p, released at epoch e, to the released list (the lock
/// held).
fn retire(p: Int, e: Int) {
  let rw = rt.static_word(W_RETIRED)
  var r = rt.mem_load(rw, 0, 8)
  if r == 0 || rt.mem_load(r, R_LEN, 8) == rt.mem_load(r, R_CAP, 8) {
    let cap = if r == 0 { 64 } else { 2 * rt.mem_load(r, R_CAP, 8) }
    let n = sys_c.weak_malloc(R_PAIRS + 16 * cap)
    if n == 0 {
      unlock()
      rt.fault_raise("no memory for the XoHandle table", "")
    }
    rt.mem_store(n, R_CAP, cap, 8)
    rt.mem_store(n, R_LEN, 0, 8)
    if r != 0 {
      rt.mem_copy(n.wrapping_add(R_LEN), r.wrapping_add(R_LEN), 8 + 16 * rt.mem_load(r, R_LEN, 8))
      sys_c.weak_free(r)
    }
    rt.mem_store(rw, 0, n, 8)
    r = n
  }
  let k = rt.mem_load(r, R_LEN, 8)
  rt.mem_store(r, R_PAIRS + 16 * k, p, 8)
  rt.mem_store(r, R_PAIRS + 16 * k + 8, e, 8)
  rt.mem_store(r, R_LEN, k + 1, 8)
}

/// Takes the released values whose epoch is below m (no read that began
/// at or before it is running) off the list and returns them, to drop
/// after the lock is given (the lock held).
fn reclaim(m: Int) -> List[Int] {
  var out: List[Int] = []
  let r = rt.mem_load(rt.static_word(W_RETIRED), 0, 8)
  let n = rt.mem_load(r, R_LEN, 8)
  var keep = 0
  var i = 0
  while i < n {
    let p = rt.mem_load(r, R_PAIRS + 16 * i, 8)
    let e = rt.mem_load(r, R_PAIRS + 16 * i + 8, 8)
    if e >= m {
      rt.mem_store(r, R_PAIRS + 16 * keep, p, 8)
      rt.mem_store(r, R_PAIRS + 16 * keep + 8, e, 8)
      keep += 1
    } else {
      out.push(p)
    }
    i += 1
  }
  rt.mem_store(r, R_LEN, keep, 8)
  out
}

/// The largest buffer bytes_back keeps for the next call: a larger one
/// is freed, so one large argument does not stay with its thread.
const BUF_KEEP = 65536

/// The calling thread's buffer table for C exports' Bytes and Str
/// parameters (heapos.c_bufs), which the wrapper reads once a call and
/// passes to bytes_in, text_in and bytes_back; 0 when there is none.
pub fn bufs() -> Int { heapos.c_bufs() }

/// Word i (0 or 1) of a 16 byte struct at a: on windows/amd64 a C
/// export's XoBytes or XoStr parameter arrives as a pointer to the
/// caller's copy (Win64 passes a struct of other than 1, 2, 4 or 8 bytes
/// by reference; decision 0574).
pub fn w64_word(a: Int, i: Int) -> Int { rt.mem_load(a, 8 * i, 8) }

/// A C export's XoBytes or XoStr result (p, n) on windows/amd64: stored
/// through the hidden pointer r the caller passed first (Win64 returns a
/// 16 byte struct so), which the export returns (decision 0574).
pub fn w64_sret(r: Int, p: Int, n: Int) -> Int {
  rt.mem_store(r, 0, p, 8)
  rt.mem_store(r, 8, n, 8)
  r
}

/// A C export's Bytes parameter k (decision 0574; k < heapos.C_BUFS) in
/// thread buffer table t (bufs):
/// the n bytes at a copied into the calling thread's buffer for k when
/// it has room (no allocation: the buffer bytes_back kept after the last
/// call), else into a new Str.
pub fn bytes_in(t: Int, k: Int, a: Int, n: Int) -> Str {
  if t != 0 {
    let p = rt.mem_load(t, 8 * k, 8)
    if p != 0 && rt.mem_load(p, 8, 8) >= n {
      // taken: a call from inside the function (a C callback into
      // another export) finds no buffer and copies
      rt.mem_store(t, 8 * k, 0, 8)
      rt.mem_copy(p + rt.layout(0), a, n)
      // the table's reference, handed over
      return rt.str_at(p, n)
    }
  }
  raw.str_at(a, n)
}

/// A C export's Str parameter k: bytes_in's, valid UTF-8 (each byte of
/// an invalid sequence U+FFFD, decision 0259; a new Str then).
pub fn text_in(t: Int, k: Int, a: Int, n: Int) -> Str {
  if ascii(a, n) {
    // all ASCII, so valid UTF-8: no scan of the copy
    return bytes_in(t, k, a, n)
  }
  scan.text(bytes_in(t, k, a, n))
}

/// Whether the n bytes at a are all ASCII: 8 at a time (unaligned
/// loads), then the rest.
fn ascii(a: Int, n: Int) -> Bool {
  var i = 0
  var or = 0
  while i + 8 <= n {
    or = or | rt.mem_load(a + i, 0, 8)
    i += 8
  }
  while i < n {
    or = or | rt.mem_load(a + i, 0, 1)
    i += 1
  }
  or & HIGH_BITS == 0
}

/// The high bit of each byte of a word.
const HIGH_BITS = -9187201950435737472

/// After the call: s, parameter k's Str, kept as the thread's buffer for
/// k when nothing else holds it (the function kept no reference, its
/// count is the wrapper's 1), the slot is empty and it is at most
/// BUF_KEEP bytes; otherwise the wrapper's release frees it as usual.
pub fn bytes_back(t: Int, k: Int, s: Str) {
  let p = rt.obj_addr(s)
  if rt.mem_load(p, 0, 8) != 1 || rt.mem_load(p, 8, 8) > BUF_KEEP {
    return
  }
  if t == 0 || rt.mem_load(t, 8 * k, 8) != 0 {
    return
  }
  // the table's reference; the wrapper then drops its own
  rc.inc(p)
  rt.mem_store(t, 8 * k, p, 8)
}
