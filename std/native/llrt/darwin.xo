// The macOS layer of the native runtime, written in Xo (decision 0213,
// decision 0195 prerequisite 3): libSystem's functions called with the C
// ABI through std/native/sys_darwin.xo (the kernel interface of macOS is
// not stable; Go calls libSystem too). Its API is linux.xo's: a call
// returns its result (>= 0), or a negative errno (read from __error()
// right after the call, on the same thread). Structures are Bytes
// buffers (raw.bytes_buf, the scratch of obj.scratch) read by word.
//
// Only the macOS arms of std/native/llrt/sysio.xo call this module; the
// SSA builders make its platform calls faults on another OS.
use native/llrt/obj
use native/llrt/raw
use native/rt
use native/sys_darwin

// errno values (sys/errno.h)
pub const EINTR: Int = 4
pub const ENOENT: Int = 2
pub const EEXIST: Int = 17
pub const ENOTDIR: Int = 20
pub const EISDIR: Int = 21
pub const EACCES: Int = 13
pub const EPERM: Int = 1
pub const ENOTEMPTY: Int = 66

// open flags (sys/fcntl.h)
pub const O_RDONLY: Int = 0
pub const O_WRONLY: Int = 1
pub const O_CREAT: Int = 512
pub const O_TRUNC: Int = 1024
pub const O_CLOEXEC: Int = 16777216

pub const CLOCK_REALTIME: Int = 0
pub const CLOCK_MONOTONIC: Int = 6

/// The calling thread's errno.
fn errno() -> Int { rt.mem_load(sys_darwin.__error(), 0, 4) }

/// r, or the negative errno when r is -1 (a failed call).
fn ret(r: Int) -> Int {
  if r == -1 {
    return -errno()
  }
  r
}

/// ret(r) with b (an argument of the call) kept alive until errno is
/// read: reference counting releases a value after its last use, and a
/// release between the call and __error() would run the allocator,
/// which may change errno.
fn ret_keep(b: Bytes, r: Int) -> Int { keep(b, ret(r)) }

/// read(2) into the bytes of buf from off on (at most n of them).
pub fn read(fd: Int, buf: Bytes, off: Int, n: Int) -> Int {
  let r = ret(sys_darwin.read(fd, raw.bytes_addr(buf) + off, raw.io_len(n)))
  keep(buf, r)
}

/// write(2) of the bytes lo..hi of b.
pub fn write(fd: Int, b: Bytes, lo: Int, hi: Int) -> Int {
  let r = ret(sys_darwin.write(fd, raw.bytes_addr(b) + lo, raw.io_len(hi - lo)))
  keep(b, r)
}

/// write(2) of the n bytes at the address a (std/native/llrt/stdio.xo).
pub fn write_at(fd: Int, a: Int, n: Int) -> Int { ret(sys_darwin.write(fd, a, raw.io_len(n))) }

/// Writes all of b (retrying after EINTR and short writes): 0, or the
/// errno.
pub fn write_all(fd: Int, b: Bytes) -> Int {
  var off = 0
  let n = b.len()
  while off < n {
    let w = write(fd, b, off, n)
    if w < 0 {
      if -w == EINTR {
        continue
      }
      return -w
    }
    off += w
  }
  0
}

/// open(2) of path: the descriptor, or the negative errno. An empty path
/// is ".", as the C runtime opens it.
pub fn open(path: Str, flags: Int, mode: Int) -> Int {
  let z = cpath(path)
  ret_keep(z, Int(sys_darwin.open(z, flags, mode)))
}

/// close(2): 0, or the negative errno.
pub fn close(fd: Int) -> Int { ret(Int(sys_darwin.close(fd))) }

/// The facts of a stat(2): the kind and permission bits (st_mode), the
/// size, and the modification time in Unix nanoseconds.
pub struct Stat {
  pub mode: Int
  pub size: Int
  pub mtime: Int
  pub dev: Int
  pub ino: Int
}

/// Whether st is a directory (S_IFDIR).
pub fn is_dir(st: Stat) -> Bool { (st.mode & 61440) == 16384 }

/// stat(2) of path (lstat(2) unless follow): the facts and 0, or the
/// errno.
pub fn stat(path: Str, follow: Bool) -> (Stat, Int) {
  let buf = obj.scratch()
  let z = cpath(path)
  let r = if follow { sys_darwin.stat64(z, buf) } else { sys_darwin.lstat64(z, buf) }
  facts(buf, ret_keep(z, Int(r)))
}

/// fstat(2) of the open descriptor fd.
pub fn fstat(fd: Int) -> (Stat, Int) {
  let buf = obj.scratch()
  facts(buf, ret(Int(sys_darwin.fstat64(fd, buf))))
}

/// The facts of the struct stat at address buf (st_dev a 32 bit field at 0,
/// st_mode a 16 bit field at 4, st_ino at 8, st_mtimespec at 48, st_size at
/// 96), or the errno of r < 0.
fn facts(buf: Int, r: Int) -> (Stat, Int) {
  if r < 0 {
    return (Stat{mode: 0, size: 0, mtime: 0, dev: 0, ino: 0}, -r)
  }
  let mode = (rt.mem_load(buf, 0, 8) >> 32) & 65535
  let size = rt.mem_load(buf, 96, 8)
  let sec = rt.mem_load(buf, 48, 8)
  let nsec = rt.mem_load(buf, 56, 8)
  let dev = rt.mem_load(buf, 0, 8) & 4294967295
  let ino = rt.mem_load(buf, 8, 8)
  (Stat{mode: mode, size: size, mtime: sec * 1000000000 + nsec, dev: dev, ino: ino}, 0)
}

// ---------------------------------------------------------------------------
// The calls of std/native/llrt/fsops.xo (work item B16 of
// bench/results/zero-c-audit-refresh-2026-10-13.md): the libSystem calls
// of the C runtime's xo_fs.c.

pub const EAGAIN: Int = 35
pub const O_RDWR: Int = 2
pub const O_APPEND: Int = 8
pub const O_EXCL: Int = 2048
pub const O_DIRECTORY: Int = 1048576

/// The record buffer of names (readdir(3)'s is 4096 bytes on macOS; a
/// larger one makes fewer calls).
const DIRENT_BUF = 16384

/// utimensat's directory for paths relative to the working directory.
const AT_FDCWD: Int = -2

/// read(2) of at most n bytes to the address a.
pub fn read_at(fd: Int, a: Int, n: Int) -> Int { ret(sys_darwin.read(fd, a, raw.io_len(n))) }

/// rename(2) of a to b (as written: "" is no file).
pub fn rename(a: Str, b: Str) -> Int {
  let za = zpath(a)
  let zb = zpath(b)
  let r = Int(sys_darwin.rename(za, zb))
  keep(za, ret_keep(zb, r))
}

/// unlink(2) of path, or rmdir(2) when dir.
pub fn unlink(path: Str, dir: Bool) -> Int {
  let z = cpath(path)
  let r = if dir { sys_darwin.rmdir(z) } else { sys_darwin.unlink(z) }
  ret_keep(z, Int(r))
}

/// mkdir(2) of path with mode.
pub fn mkdir(path: Str, mode: Int) -> Int {
  let z = cpath(path)
  ret_keep(z, Int(sys_darwin.mkdir(z, mode)))
}

/// utimensat(2) of path: both times set to sec and nsec.
pub fn utimens(path: Str, sec: Int, nsec: Int) -> Int {
  let z = cpath(path)
  let ts = raw.bytes_buf(32)
  let a = raw.bytes_addr(ts)
  rt.mem_store(a, 0, sec, 8)
  rt.mem_store(a, 8, nsec, 8)
  rt.mem_store(a, 16, sec, 8)
  rt.mem_store(a, 24, nsec, 8)
  let r = Int(sys_darwin.utimensat(AT_FDCWD, z, a, 0))
  keep(ts, ret_keep(z, r))
}

/// chmod(2) of path to mode.
pub fn chmod(path: Str, mode: Int) -> Int {
  let z = cpath(path)
  ret_keep(z, Int(sys_darwin.chmod(z, mode)))
}

/// symlink(2): a link at path to target (both as written).
pub fn symlink(target: Str, path: Str) -> Int {
  let zt = zpath(target)
  let zp = zpath(path)
  let r = Int(sys_darwin.symlink(zt, zp))
  keep(zt, ret_keep(zp, r))
}

/// readlink(2) of path (as written), at most 4096 bytes: the target and
/// 0, or the errno.
pub fn readlink(path: Str) -> (Str, Int) {
  let z = zpath(path)
  let buf = raw.bytes_buf(4096)
  let r = ret_keep(z, sys_darwin.readlink(z, raw.bytes_addr(buf), 4096))
  if r < 0 {
    return ("", -r)
  }
  let t = raw.str_at(raw.bytes_addr(buf), r)
  keep(buf, 0)
  (t, 0)
}

/// getcwd(3): the working directory, "." when the system has none to
/// give (as the C runtime's). $PWD when it names the same directory as "."
/// (os.Getwd: two stat calls), because libc's getcwd opens "." and asks
/// the kernel for its path, 6 times the cost.
pub fn getcwd() -> Str {
  let pwd = rt.env_get("PWD").get(0) ?? ""
  if pwd.starts_with("/") {
    let (a, ea) = stat(".", true)
    let (b, eb) = stat(pwd, true)
    if ea == 0 && eb == 0 && a.ino == b.ino && a.dev == b.dev {
      return pwd
    }
  }
  let buf = raw.bytes_buf(4096)
  let a = raw.bytes_addr(buf)
  if sys_darwin.getcwd(a, 4096) == 0 {
    keep(buf, 0)
    return "."
  }
  let w = raw.str_at(a, raw.cstr_len(a))
  keep(buf, 0)
  w
}

/// flock(2) of fd with op (linux.LOCK_*).
pub fn flock(fd: Int, op: Int) -> Int { ret(Int(sys_darwin.flock(fd, op))) }

/// The entries of the directory path (not `.` and `..`, in readdir's
/// order) and 0, or the errno of its open or of a failed read
/// (os.File.ReadDir: EINTR retried, any other error reported, not a
/// list cut short).
pub fn names(path: Str) -> (List[Str], Int) {
  // opendir(3)'s open: a file is ENOTDIR
  var fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0)
  while fd == -EINTR {
    fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0)
  }
  if fd < 0 {
    return ([], -fd)
  }
  var out: List[Str] = []
  let buf = raw.bytes_buf(DIRENT_BUF + 8)
  let a = raw.bytes_addr(buf)
  // the position, after the records
  rt.mem_store(a, DIRENT_BUF, 0, 8)
  while true {
    let n = ret(Int(sys_darwin.__getdirentries64(fd, a, DIRENT_BUF, a + DIRENT_BUF)))
    if n == -EINTR {
      continue
    }
    if n < 0 {
      let _e = sys_darwin.close(fd)
      return ([], keep(buf, -n))
    }
    if n == 0 {
      break
    }
    var off = 0
    while off < n {
      // struct dirent (64 bit inodes): d_reclen at 16, d_namlen at 18,
      // d_name at 21
      let e = a + off
      let k = rt.mem_load(e, 18, 2)
      let name = e + 21
      if !(k == 1 && rt.mem_load(name, 0, 1) == 46) && !(k == 2 && rt.mem_load(name, 0, 2) == 11822) {
        out.push(raw.str_at(name, k))
      }
      off += rt.mem_load(e, 16, 2)
    }
  }
  let _c = sys_darwin.close(fd)
  (out, keep(buf, 0))
}

/// path and a NUL byte as written ("" stays empty).
fn zpath(path: Str) -> Bytes {
  var s = BytesBuilder.with_capacity(path.len() + 1)
  s.write(path.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// clock_gettime(3) of clock id: nanoseconds (Unix time for
/// CLOCK_REALTIME), or the negative errno.
pub fn clock_ns(id: Int) -> Int {
  let buf = obj.scratch()
  let r = ret(Int(sys_darwin.clock_gettime(id, buf)))
  if r < 0 {
    return r
  }
  rt.mem_load(buf, 0, 8) * 1000000000 + rt.mem_load(buf, 8, 8)
}

/// getentropy(2) of n bytes, 256 at a time (as the C runtime's
/// cr_entropy did): the bytes and 0, or the errno.
pub fn random(n: Int) -> (Bytes, Int) {
  let buf = raw.bytes_buf(n)
  var off = 0
  while off < n {
    let k = if n - off > 256 { 256 } else { n - off }
    let r = ret(Int(sys_darwin.getentropy(raw.bytes_addr(buf) + off, k)))
    if r < 0 {
      return (b"", -r)
    }
    off += k
  }
  (buf, 0)
}

/// path and a NUL byte, as libSystem takes a path ("." for "").
fn cpath(path: Str) -> Bytes {
  let p = if path.is_empty() { "." } else { path }
  var s = BytesBuilder.with_capacity(p.len() + 1)
  s.write(p.bytes())
  s.write_byte(UInt8(0))
  s.freeze()
}

/// r, after b (whose address a call used) is known alive up to here:
/// reference counting releases a value after its last use.
fn keep(b: Bytes, r: Int) -> Int {
  if b.len() < 0 {
    return -1
  }
  r
}

/// libSystem's strerror text of errno e (macOS 26, ELAST 107; the C
/// runtime's messages on macOS), "Unknown error: N" past the table.
pub fn strerror(e: Int) -> Str {
  match e {
    0 => "Undefined error: 0"
    1 => "Operation not permitted"
    2 => "No such file or directory"
    3 => "No such process"
    4 => "Interrupted system call"
    5 => "Input/output error"
    6 => "Device not configured"
    7 => "Argument list too long"
    8 => "Exec format error"
    9 => "Bad file descriptor"
    10 => "No child processes"
    11 => "Resource deadlock avoided"
    12 => "Cannot allocate memory"
    13 => "Permission denied"
    14 => "Bad address"
    15 => "Block device required"
    16 => "Resource busy"
    17 => "File exists"
    18 => "Cross-device link"
    19 => "Operation not supported by device"
    20 => "Not a directory"
    21 => "Is a directory"
    22 => "Invalid argument"
    23 => "Too many open files in system"
    24 => "Too many open files"
    25 => "Inappropriate ioctl for device"
    26 => "Text file busy"
    27 => "File too large"
    28 => "No space left on device"
    29 => "Illegal seek"
    30 => "Read-only file system"
    31 => "Too many links"
    32 => "Broken pipe"
    33 => "Numerical argument out of domain"
    34 => "Result too large"
    35 => "Resource temporarily unavailable"
    36 => "Operation now in progress"
    37 => "Operation already in progress"
    38 => "Socket operation on non-socket"
    39 => "Destination address required"
    40 => "Message too long"
    41 => "Protocol wrong type for socket"
    42 => "Protocol not available"
    43 => "Protocol not supported"
    44 => "Socket type not supported"
    45 => "Operation not supported"
    46 => "Protocol family not supported"
    47 => "Address family not supported by protocol family"
    48 => "Address already in use"
    49 => "Can't assign requested address"
    50 => "Network is down"
    51 => "Network is unreachable"
    52 => "Network dropped connection on reset"
    53 => "Software caused connection abort"
    54 => "Connection reset by peer"
    55 => "No buffer space available"
    56 => "Socket is already connected"
    57 => "Socket is not connected"
    58 => "Can't send after socket shutdown"
    59 => "Too many references: can't splice"
    60 => "Operation timed out"
    61 => "Connection refused"
    62 => "Too many levels of symbolic links"
    63 => "File name too long"
    64 => "Host is down"
    65 => "No route to host"
    66 => "Directory not empty"
    67 => "Too many processes"
    68 => "Too many users"
    69 => "Disc quota exceeded"
    70 => "Stale NFS file handle"
    71 => "Too many levels of remote in path"
    72 => "RPC struct is bad"
    73 => "RPC version wrong"
    74 => "RPC prog. not avail"
    75 => "Program version wrong"
    76 => "Bad procedure for program"
    77 => "No locks available"
    78 => "Function not implemented"
    79 => "Inappropriate file type or format"
    80 => "Authentication error"
    81 => "Need authenticator"
    82 => "Device power is off"
    83 => "Device error"
    84 => "Value too large to be stored in data type"
    85 => "Bad executable (or shared library)"
    86 => "Bad CPU type in executable"
    87 => "Shared library version mismatch"
    88 => "Malformed Mach-o file"
    89 => "Operation canceled"
    90 => "Identifier removed"
    91 => "No message of desired type"
    92 => "Illegal byte sequence"
    93 => "Attribute not found"
    94 => "Bad message"
    95 => "EMULTIHOP (Reserved)"
    96 => "No message available on STREAM"
    97 => "ENOLINK (Reserved)"
    98 => "No STREAM resources"
    99 => "Not a STREAM"
    100 => "Protocol error"
    101 => "STREAM ioctl timeout"
    102 => "Operation not supported on socket"
    103 => "Policy not found"
    104 => "State not recoverable"
    105 => "Previous owner died"
    106 => "Interface output queue is full"
    107 => "Capabilities insufficient"
    _ => "Unknown error: ${e}"
  }
}

/// The message of errno e as the C runtime records a file error: the
/// strerror text with its first letter lowered.
/// kill(2) of signal sig to pid: 0, or the negative errno.
pub fn kill(pid: Int, sig: Int) -> Int { ret(Int(sys_darwin.kill(pid, sig))) }

/// pipe(2) into the two 4 byte words at a: 0, or the negative errno.
pub fn pipe_at(a: Int) -> Int { ret(Int(sys_darwin.pipe(a))) }

/// waitpid(2) of pid with its status in the 4 byte word at st, blocking
/// (options 0) or WNOHANG (1): the pid, 0, or the negative errno.
pub fn waitpid_at(pid: Int, st: Int, options: Int) -> Int { ret(Int(sys_darwin.waitpid(pid, st, options))) }

pub fn err_msg(e: Int) -> Str {
  let s = strerror(e)
  let b = s.bytes()
  if b.len() > 0 && b[0] >= 65 && b[0] <= 90 {
    return raw.byte_str(Int(b[0]) + 32) + raw.str_slice(s, 1, s.len())
  }
  s
}

/// The FsErr tag plus one of errno e (std/rt's mapFsErr): 1 NotFound, 2
/// Exists, 3 NotEmpty, 4 NotDir, 5 IsDir, 6 Permission, 7 Io.
pub fn fs_status(e: Int) -> Int {
  match e {
    2 => 1
    17 => 2
    66 => 3
    20 => 4
    21 => 5
    13 | 1 => 6
    _ => 7
  }
}
