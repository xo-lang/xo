fn run2(name: Str, x: Float, y: Float) -> Int {
  let f = match name {
    "signbit" => return if signbit(x) { 1 } else { 0 }
    "lgamma_sign" => return lgamma(x).1
    "modf_int" => modf(x).0
    "modf_frac" => modf(x).1
    "round_to_even" => round_to_even(x)
    "acosh" => acosh(x)
    "asinh" => asinh(x)
    "atanh" => atanh(x)
    "erf" => erf(x)
    "erfc" => erfc(x)
    "erfinv" => erfinv(x)
    "erfcinv" => erfcinv(x)
    "gamma" => gamma(x)
    "lgamma" => lgamma(x).0
    "next_after" => next_after(x, y)
    _ => remainder(x, y)
  }
  rt.float_bits(f)
}

test "go math, second set (task #383): every function's bits on special and random inputs" {
  var bad: List[Str] = []
  var by: Map[Str, Int] = {}
  for (name, xb, yb, want) in MATH2 {
    let got = run2(name, rt.float_from_bits(xb), rt.float_from_bits(yb))
    let nan = name != "signbit" && name != "lgamma_sign" && is_nan(rt.float_from_bits(got)) && is_nan(rt.float_from_bits(want))
    if got != want && !nan {
      by.put(name, (by.get(name) ?? 0) + 1)
      if bad.len() < 12 {
        bad.push("${name}(${rt.float_from_bits(xb)}, ${rt.float_from_bits(yb)}) = ${rt.float_from_bits(got)} (${got}), want ${rt.float_from_bits(want)} (${want})")
      }
    }
  }
  expect((by, bad)) == ({}, [])
}

test "trunc and modf: Go's trunc.go bits (signed zeros, halves, 2^52 and up, NaN, infinities)" {
  // (x, Go's math.Trunc(x) bits): trunc is Float.trunc's one instruction
  // (task #406); these are trunc.go's answers
  let cases: List[(Float, Int)] = [
    (0.5, 0), (-0.5, -9223372036854775807 - 1), (-0.0, -9223372036854775807 - 1),
    (1.0, 4607182418800017408), (-3.7, -4609434218613702656),
    (4503599627370495.5, 4841369599423283198), (4503599627370497.0, 4841369599423283201),
    (1.0e300, 9094988921128908188), (inf(1), 9218868437227405312),
    (inf(-1), -4503599627370496),
  ]
  var bad: List[Str] = []
  for (x, want) in cases {
    if rt.float_bits(trunc(x)) != want {
      bad.push("trunc(${x}) bits ${rt.float_bits(trunc(x))}, want ${want}")
    }
  }
  expect(bad) == []
  expect(is_nan(trunc(nan()))) == true
  let (i0, f0) = modf(-0.75)
  expect((rt.float_bits(i0), f0)) == (-9223372036854775807 - 1, -0.75)
  expect(modf(-2.25)) == (-2.0, -0.25)
}
