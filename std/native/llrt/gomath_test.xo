fn run(name: Str, x: Float, y: Float) -> Float {
  match name {
    "exp" => exp(x)
    "exp2" => exp2(x)
    "expm1" => expm1(x)
    "log" => log(x)
    "log2" => log2(x)
    "log10" => log10(x)
    "log1p" => log1p(x)
    "sin" => sin(x)
    "cos" => cos(x)
    "tan" => tan(x)
    "asin" => asin(x)
    "acos" => acos(x)
    "atan" => atan(x)
    "sinh" => sinh(x)
    "cosh" => cosh(x)
    "tanh" => tanh(x)
    "cbrt" => cbrt(x)
    "pow" => pow(x, y)
    "atan2" => atan2(x, y)
    "hypot" => hypot(x, y)
    _ => mod(x, y)
  }
}

test "go math: every function's bits on special and random inputs" {
  var bad: List[Str] = []
  var by: Map[Str, Int] = {}
  for (name, xb, yb, want) in MATH {
    let got = run(name, rt.float_from_bits(xb), rt.float_from_bits(yb))
    let w = rt.float_from_bits(want)
    let same = rt.float_bits(got) == want || (is_nan(got) && is_nan(w))
    if !same {
      by.put(name, (by.get(name) ?? 0) + 1)
      if bad.len() < 12 {
        bad.push("${name}(${rt.float_from_bits(xb)}, ${rt.float_from_bits(yb)}) = ${got}, want ${w}")
      }
    }
  }
  expect((by, bad)) == ({}, [])
}
