// The network's system calls and name resolution on Linux and macOS
// (decision 0206 stage 3, decision 0193's mechanism; macOS through
// libSystem and its getaddrinfo, the zero-C audit's B23): when raw()
// holds, the C
// runtime's listen, dial, accept, reads, writes, and poller make their
// system calls from Xo (sock.xo) and resolve names with dns.xo, through
// the exports of cabi_net.xo; elsewhere, and with `XO_LLRT_C=net`
// (net_c.xo), they call the C library (socket, getaddrinfo, epoll) as
// before.

/// Whether the network goes through Xo: a Linux or macOS target that is
/// not a WASI module (a wasm build keeps the host's `target.os`,
/// gotchas/wasm-target-os-is-the-host.md).
pub fn raw() -> Bool {
  match target.os {
    TargetOs.Linux => {
      match target.arch {
        TargetArch.Wasm32 => false
        TargetArch.Arm64 | TargetArch.Amd64 => true
      }
    }
    TargetOs.Darwin => {
      // libSystem's socket calls (sock.xo's darwin arms, B23)
      match target.arch {
        TargetArch.Wasm32 => false
        TargetArch.Arm64 | TargetArch.Amd64 => true
      }
    }
    TargetOs.Windows | TargetOs.Wasi => false
  }
}
