// std/native/llrt/mysqlwire.xo's tests: the encodings and packets of
// MySQL's protocol documentation (decision 0648), built here byte by byte
// from the documented layouts; the conformance run against a real server
// (decision 0648 item 12) checks them against MySQL itself.

fn hex(x: Str) -> Bytes { Bytes.from_hex(x) ?? b"" }

test "length encoded integers at each width's edges" {
  expect(lenenc_int(0).to_hex()) == "00"
  expect(lenenc_int(250).to_hex()) == "fa"
  expect(lenenc_int(251).to_hex()) == "fcfb00"
  expect(lenenc_int(65535).to_hex()) == "fcffff"
  expect(lenenc_int(65536).to_hex()) == "fd000001"
  expect(lenenc_int(16777215).to_hex()) == "fdffffff"
  expect(lenenc_int(16777216).to_hex()) == "fe0000000100000000"
  for n in [0, 1, 250, 251, 252, 65535, 65536, 16777215, 16777216, 4294967296, 9223372036854775807] {
    var r = reader(lenenc_int(n))
    expect(r.lenenc()) == Ok(Some(n))
    expect(r.left()) == 0
  }
  var nul = reader(b"\xfb")
  expect(nul.lenenc()) == Ok(None)
  var cut = reader(b"\xfc\x01")
  expect(cut.lenenc().is_err()) == true
  var ff = reader(b"\xff")
  expect(ff.lenenc().is_err()) == true
}

test "packets: framing, sequence ids, and a payload of 2^24 - 1 bytes" {
  let (one, next) = frame(0, b"\x0e")
  expect(one.to_hex()) == "010000000e"
  expect(next) == 1
  let (wrap, n2) = frame(255, b"ab")
  expect(wrap.to_hex()) == "020000ff6162"
  expect(n2) == 0
  // exactly MAX_PAYLOAD: a full packet, then an empty one
  let big = b"x".repeat(MAX_PAYLOAD)
  let (f, n3) = frame(3, big)
  expect(f.len()) == MAX_PAYLOAD + 8
  expect(f[0..4].to_hex()) == "ffffff03"
  expect(f[f.len() - 4..f.len()].to_hex()) == "00000004"
  expect(n3) == 5
  expect(join(f).map(fn(x) { (x.0.len(), x.1, x.2, x.3) })) == Some((MAX_PAYLOAD, 3, 4, f.len()))
  expect(join(f[0..f.len() - 1])) == None
  expect(packet(b"\x02\x00\x00")) == None
  expect(packet(b"\x02\x00\x00\x07a")) == None
  expect(packet(b"\x02\x00\x00\x07abz")) == Some((b"ab", 7, 6))
}

/// A HandshakeV10 laid out as page_protocol_connection_phase_packets
/// gives it.
fn handshake_bytes(version: Str, plugin: Str, caps: Int, part2: Bytes) -> Bytes {
  var b = BytesBuilder.new()
  b.write_byte(10)
  b.write(version.bytes() + b"\x00")
  b.write_le(4660, 4)
  b.write(b"abcdefgh")
  b.write_byte(0)
  b.write_le(caps & 65535, 2)
  b.write_byte(255)
  b.write_le(2, 2)
  b.write_le(caps >> 16, 2)
  b.write_byte(UInt8(8 + part2.len()))
  b.write(b"\x00".repeat(10))
  b.write(part2)
  b.write(plugin.bytes() + b"\x00")
  b.freeze()
}

test "the server's handshake: version, nonce, capabilities, plugin" {
  let caps = CLIENT_PROTOCOL_41 | CLIENT_SECURE_CONNECTION | CLIENT_PLUGIN_AUTH | CLIENT_SSL | CLIENT_DEPRECATE_EOF
  let h = parse_handshake(handshake_bytes("8.4.3", "caching_sha2_password", caps, b"ijklmnopqrst\x00")) ?? e => fault(e.msg)
  expect(h.version) == "8.4.3"
  expect(h.thread_id) == 4660
  expect(h.nonce) == b"abcdefghijklmnopqrst"
  expect(h.caps) == caps
  expect(h.charset) == 255
  expect(h.status) == 2
  expect(h.plugin) == "caching_sha2_password"
  // a server whose plugin name has no 0 byte at the end
  let raw = handshake_bytes("5.7.44", "mysql_native_password", caps, b"ijklmnopqrst\x00")
  let h2 = parse_handshake(raw[0..raw.len() - 1]) ?? e => fault(e.msg)
  expect(h2.plugin) == "mysql_native_password"
  expect(parse_handshake(b"\x09x\x00").is_err()) == true
  expect(parse_handshake(b"\x0a8.0").is_err()) == true
  // an ERR in place of the handshake (too many connections)
  let refused = parse_handshake(b"\xff\x10\x04Too many connections")
  expect(refused.err().map(fn(e) { e.msg })) == Some("the server refused the connection: Too many connections")
}

test "HandshakeResponse41 and SSLRequest" {
  let caps = CLIENT_PROTOCOL_41 | CLIENT_SECURE_CONNECTION | CLIENT_PLUGIN_AUTH | CLIENT_PLUGIN_AUTH_LENENC_CLIENT_DATA | CLIENT_CONNECT_WITH_DB
  let r = handshake_response(caps, 16777216, 45, "app", b"\x01\x02", "shop", "caching_sha2_password", [])
  var want = BytesBuilder.new()
  want.write_le(caps, 4)
  want.write_le(16777216, 4)
  want.write_byte(45)
  want.write(b"\x00".repeat(23))
  want.write(b"app\x00\x02\x01\x02shop\x00caching_sha2_password\x00")
  expect(r) == want.freeze()
  let s = ssl_request(caps, 16777216, 45)
  expect(s.len()) == 32
  expect(le(s, 0, 4)) == caps | CLIENT_SSL
  expect(r[0..4] != s[0..4]) == true
  expect(r[4..32]) == s[4..32]
  // without the length encoded form: one length byte; with attributes
  let caps2 = CLIENT_PROTOCOL_41 | CLIENT_SECURE_CONNECTION | CLIENT_PLUGIN_AUTH | CLIENT_CONNECT_ATTRS
  let r2 = handshake_response(caps2, 1, 33, "u", b"pw", "ignored", "mysql_native_password", [("_client_name", "xo")])
  expect(r2[32..r2.len()]) == b"u\x00\x02pwmysql_native_password\x00\x10\x0c_client_name\x02xo"
}

test "OK, ERR, EOF and the auth phase's packets" {
  let ok = ok_packet(hex("00fc10270502000100"), CLIENT_PROTOCOL_41) ?? e => fault(e.msg)
  expect((ok.affected, ok.insert_id, ok.status, ok.warnings)) == (10000, 5, 2, 1)
  let info = ok_packet(b"\x00\x01\x00\x02\x00\x00\x00Rows matched: 1", CLIENT_PROTOCOL_41) ?? e => fault(e.msg)
  expect(info.info) == "Rows matched: 1"
  let e = err_packet(b"\xff\x26\x04#23000Duplicate entry '1' for key 't.PRIMARY'", true) ?? x => fault(x.msg)
  expect((e.code, e.state, e.msg)) == (1062, "23000", "Duplicate entry '1' for key 't.PRIMARY'")
  let e2 = err_packet(b"\xff\x15\x04Access denied", true) ?? x => fault(x.msg)
  expect((e2.code, e2.state)) == (1045, "HY000")
  expect(is_end(b"\xfe\x00\x00\x02\x00")) == true
  expect(is_end(b"\x03abc")) == false
  expect(end_status(b"\xfe\x00\x00\x0a\x00", CLIENT_PROTOCOL_41)) == Ok(10)
  expect(end_status(b"\xfe\x00\x00\x0a\x00\x00\x00", CLIENT_PROTOCOL_41 | CLIENT_DEPRECATE_EOF)) == Ok(10)
  expect(parse_auth(b"\xfecaching_sha2_password\x00abcdefghijklmnopqrst\x00", CLIENT_PROTOCOL_41)) == Ok(Auth.Switch(plugin: "caching_sha2_password", data: b"abcdefghijklmnopqrst"))
  expect(parse_auth(b"\x01\x04", CLIENT_PROTOCOL_41)) == Ok(Auth.More(data: b"\x04"))
  expect(parse_auth(b"\xfe", CLIENT_PROTOCOL_41)) == Ok(Auth.Switch(plugin: "mysql_old_password", data: b""))
  expect(parse_auth(b"\x07", CLIENT_PROTOCOL_41).is_err()) == true
}

test "column definitions and text rows" {
  var b = BytesBuilder.new()
  for s in ["def", "shop", "o", "orders", "id", "id"] {
    b.write(lenenc_str(s.bytes()))
  }
  b.write(b"\x0c")
  b.write_le(63, 2)
  b.write_le(20, 4)
  b.write_byte(8)
  b.write_le(FLAG_NOT_NULL | FLAG_UNSIGNED, 2)
  b.write_byte(0)
  b.write(b"\x00\x00")
  let def = b.freeze()
  let c = parse_column(def) ?? e => fault(e.msg)
  expect((c.schema, c.table, c.org_table, c.name, c.charset, c.length, c.kind, c.flags)) == ("shop", "o", "orders", "id", 63, 20, TYPE_LONGLONG, 33)
  // the fixed fields' length is 12: 0xfc there (TestMysqlFuzz seed 10,
  // case 606) read as a 2 byte length shifted every field after it
  let n = def.len() - 13
  expect(parse_column(def[0..n] + b"\xfc" + def[n + 1..def.len()]).is_err()) == true
  expect(parse_text_row(b"\x011\xfb\x03abc", 3)) == Ok([Some(b"1"), None, Some(b"abc")])
  expect(parse_text_row(b"\x011", 2).is_err()) == true
  // bytes after the last value are refused, as go-sql-driver master's
  // readRow (96884ae, #1816; v1.10.1 ignored them)
  expect(parse_text_row(b"\x011x", 1).is_err()) == true
  expect(command(COM_QUERY, b"SELECT 1")) == b"\x03SELECT 1"
}

fn bcol(kind: Int, flags: Int, decimals: Int) -> Column {
  Column{schema: "", table: "", org_table: "", name: "c", org_name: "c", charset: 63, length: 0, kind: kind, flags: flags, decimals: decimals}
}

test "COM_STMT_PREPARE_OK, COM_STMT_EXECUTE and COM_STMT_CLOSE" {
  let ok = prepare_ok(hex("000700000002000300000100")) ?? e => fault(e.msg)
  expect((ok.id, ok.columns, ok.params, ok.warnings)) == (7, 2, 3, 1)
  expect(prepare_ok(hex("ff")).is_err()) == true
  // no parameters: id, flags, iteration count only
  expect(stmt_execute(7, []).to_hex()) == "17070000000001000000"
  // 9 parameters, the 1st and 9th NULL: a 2 byte bitmap
  var ps: List[BinParam] = [BinParam{kind: TYPE_NULL, unsigned: false, null: true, value: b""}]
  for _ in 0..7 {
    ps.push(BinParam{kind: TYPE_TINY, unsigned: false, null: false, value: b"\x01"})
  }
  ps.push(BinParam{kind: TYPE_NULL, unsigned: false, null: true, value: b""})
  let x = stmt_execute(1, ps)
  expect(x[10..13].to_hex()) == "010101"
  expect(x[13..31].to_hex()) == "0600" + "0100".repeat(7) + "0600"
  expect(x[31..x.len()].to_hex()) == "01".repeat(7)
  let u = stmt_execute(2, [BinParam{kind: TYPE_LONGLONG, unsigned: true, null: false, value: le_bytes(-1, 8)}])
  expect(u[10..u.len()].to_hex()) == "00010880ffffffffffffffff"
  expect(stmt_close(258).to_hex()) == "1902010000"
}

test "binary rows: each type as the text protocol's text" {
  let cols = [bcol(TYPE_TINY, 0, 0), bcol(TYPE_TINY, FLAG_UNSIGNED, 0), bcol(TYPE_SHORT, 0, 0), bcol(TYPE_LONG, 0, 0), bcol(TYPE_LONGLONG, 0, 0), bcol(TYPE_LONGLONG, FLAG_UNSIGNED, 0), bcol(TYPE_YEAR, FLAG_UNSIGNED, 0), bcol(TYPE_INT24, 0, 0), bcol(TYPE_VAR_STRING, 0, 0), bcol(TYPE_NULL, 0, 0)]
  var b = BytesBuilder.new()
  b.write_byte(0)
  // 10 columns: (10 + 7 + 2) / 8 = 2 bitmap bytes; the last column (bit 11) NULL
  b.write(hex("0008"))
  b.write(hex("ff"))
  b.write(hex("ff"))
  b.write(hex("0080"))
  b.write(hex("ffffffff"))
  b.write(hex("0000000000000080"))
  b.write(hex("ffffffffffffffff"))
  b.write(hex("ea07"))
  b.write(hex("feffffff"))
  b.write(lenenc_str(b"hé"))
  let row = parse_binary_row(b.freeze(), cols) ?? e => fault(e.msg)
  expect(row) == [Some(b"-1"), Some(b"255"), Some(b"-32768"), Some(b"-1"), Some(b"-9223372036854775808"), Some(b"18446744073709551615"), Some(b"2026"), Some(b"-2"), Some("hé".bytes()), None]
  // floats: the shortest text of the value
  let fcols = [bcol(TYPE_FLOAT, 0, 31), bcol(TYPE_DOUBLE, 0, 31)]
  var f = BytesBuilder.new()
  f.write(hex("0000"))
  // 2 columns: one bitmap byte
  f.write_le(Int(Float32(0.1).to_bits()), 4)
  f.write_le(Float(2.5).to_bits(), 8)
  expect(parse_binary_row(f.freeze(), fcols)) == Ok([Some(b"0.1"), Some(b"2.5")])
  for (v, want) in [(0.1, "0.1"), (1.2345678, "1.2345678"), (3.4028235e38, "3.4028235e+38"), (1e-45, "1e-45"), (0.0, "0"), (-2.0, "-2"), (16777216.0, "16777216")] {
    expect(float32_text(Float32(v))) == want
  }
  // dates and times at each length, the fraction by the column's decimals
  let tcols = [bcol(TYPE_DATETIME, 0, 0), bcol(TYPE_DATETIME, 0, 6), bcol(TYPE_DATETIME, 0, 3), bcol(TYPE_DATE, 0, 0), bcol(TYPE_TIMESTAMP, 0, 0), bcol(TYPE_TIME, 0, 0), bcol(TYPE_TIME, 0, 6), bcol(TYPE_TIME, 0, 0)]
  var t = BytesBuilder.new()
  t.write(hex("000000"))
  t.write(hex("00"))
  t.write(hex("0b") + le_bytes(2026, 2) + hex("0a14010203") + le_bytes(123456, 4))
  t.write(hex("07") + le_bytes(2026, 2) + hex("0a14010203"))
  t.write(hex("04") + le_bytes(999, 2) + hex("0101"))
  t.write(hex("07") + le_bytes(2038, 2) + hex("0113030e07"))
  t.write(hex("08") + hex("01") + le_bytes(34, 4) + hex("163b3b"))
  t.write(hex("0c") + hex("00") + le_bytes(0, 4) + hex("0c1e00") + le_bytes(5, 4))
  t.write(hex("00"))
  let tr = parse_binary_row(t.freeze(), tcols) ?? e => fault(e.msg)
  expect(tr) == [Some(b"0000-00-00 00:00:00"), Some(b"2026-10-20 01:02:03.123456"), Some(b"2026-10-20 01:02:03.000"), Some(b"0999-01-01"), Some(b"2038-01-19 03:14:07"), Some(b"-838:59:59"), Some(b"12:30:00.000005"), Some(b"00:00:00")]
  // broken rows
  expect(parse_binary_row(hex("0100"), [bcol(TYPE_TINY, 0, 0)]).is_err()) == true
  expect(parse_binary_row(hex("0000"), [bcol(TYPE_LONG, 0, 0)]).is_err()) == true
  expect(parse_binary_row(hex("000001ff"), [bcol(TYPE_TINY, 0, 0)]).is_err()) == true
}

test "read_size: what the next packet lacks, 4096 to 1 MiB" {
  expect(read_size(b"")) == 4096
  expect(read_size(b"\x05\x00\x00")) == 4096
  // a 300 byte packet with 10 bytes in hand: the floor
  expect(read_size(b"\x2c\x01\x00\x00" + b"x".repeat(6))) == 4096
  // a 100,000 byte packet with 4 in hand: the rest
  expect(read_size(b"\xa0\x86\x01\x00")) == 100000
  // the largest packet: capped
  expect(read_size(b"\xff\xff\xff\x00")) == 1048576
}
